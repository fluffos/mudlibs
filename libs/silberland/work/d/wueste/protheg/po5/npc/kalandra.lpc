
inherit "std/npc";
inherit "/std/player/moneyhandler";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Kalandra, die Druidenmeisterin");
  SetProp(P_LONG,
	  "Kalandra ist eine der schoensten Frauen aus dem Silberland, "+
	  "doch das macht sie nicht minder gefaehrlich, also reize sie "+
	  "nicht, denn sie ist fuer ihre Zauber bekannt!\n");
  SetProp(P_NAME, "Kalandra");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"kalandra","\npo5member","druide","NOWIMPY"}));

  create_default_npc(35);
  SetProp(P_HANDS, ({" mit ihren flammenden Haenden",
		       QueryProp(P_HANDS)[1]+100,DT_FIRE}));
  SetProp(P_BODY, 110);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 1650);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,250);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_RESISTANCE, ({DT_FIRE,DT_COLD,DT_STONE,DT_WATER,DT_AIR}));
  SetProp(P_VULNERABILITY, ({DT_TERROR}));
  SetProp(P_NOMAGIC,60);

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint aus dem Nichts!");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " stoehnt erschoepft auf und stirbt.\n");
  SetProp(P_MURDER_MSG, "Freunde! Raecht mich!\n");
  SetProp(P_KILL_NAME, "Die Bruederschaft der Fuenf");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal!");
  
  AddInfo(DEFAULT_INFO, "sagt: Mit Dir rede ich nicht!\n");
  AddInfo(({"bruderschaft","fuenf","bruderschaft der fuenf","mitglied"}),
	  "Ich bin Kalandra, die Meisterdruidin und Mitglied in der "+
	  "Bruderschaft der Fuenf!\n","verkuendet stolz: ");
  AddInfo("kalandra",
	  "Wer bist Du, dass Du dies wissen willst?\n","fragt entruestet: ");
  AddInfo(({"anvar","druidin","meisterdruidin"}),
	  "Anvar ist ein Schwaechling gegen mich!\n","meint gehaessig: ");
  AddInfo("schwaechling",
	  "Redest Du von Dir?\n","fragt Dich: ");
  AddInfo(({"schueler","druidenschueler","mantar"}),
	  "Mantar ist mein Druidenschueler.\n","meint stolz: ");
  AddInfo("hobbit",
	  "Ist er nicht suess!?\n","jauchzt: ");
  AddInfo(({"grub","ugh"}),
	  "Duemmere als die beiden gibt es wohl nicht!\n","grummelt: ");
  AddInfo("schranken",
	  "Der Schranken hilft uns, die Wegsteuer einzutreiben.\n","antwortet "+
	  "grinsend: ");
  AddInfo(({"steuer","wegsteuer"}),
	  "Na? Hast Du schon bezahlt?\n","fragt: ");
  AddInfo("anvar",
	  "Anvar wird es Dir nie verraten, aber wir beide standen uns einmal "+
	  "sehr nahe...\n","fluestert: ");
  
  SetProp(P_REJECT,({REJECT_KEEP,"Kalandra zwinkert Dir zu!\n"}));
  
  SetProp(P_GUILD, "druidenzirkel");
  SetProp(P_GUILD_LEVEL, 15);
  
  
  ModifySkill("laehme",          10000);
  ModifySkill("laehme",          ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("feuerball",       10000);
  ModifySkill("feuerball",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("froststrahl",     10000);
  ModifySkill("froststrahl",     ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("wasserstrahl",    10000);
  ModifySkill("wasserstrahl",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("erzstrahl",       10000);
  ModifySkill("erzstrahl",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("windstoss",       10000);
  ModifySkill("windstoss",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));

  SetProp(P_SPELLRATE,60);
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dspells");   
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dbeh");   
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dla");   
  AddSpell(1,1,
	   "Kalandra konzentriert sich...\n"+
	   "Ploetzlich wird alles in ein gleissendes Licht getaucht!\n",
	   "Kalandra konzentriert sich...\n"+
	   "Ploetzlich wird alles in ein gleissendes Licht getaucht!\n",
	   DT_LIGHT, "flash");
  AddSpell(1,700,
	   "Kalandra huellt die Bruderschaft in eine Windhose, die Dich "+
	   "umherwirbelt.\n",
	   "Kalandra huellt die Bruderschaft in eine Windhose, die Dich "+
	   "umherwirbelt.\n",
	   DT_AIR, "wirbel");
  AddSpell(1,1,
	   "Kalandra konzentriert sich auf Dich und Dir wird ploetzlich warm...\n",
	   "Kalandra konzentriert sich und ploetzlich beginnt @WER zu brennen!\n",
	   DT_FIRE, "burn");
  SetChats(1, 
	   ({"Kalandra zwinkert Dir zu.\n",
	       "Kalandra prueft den Sitz ihrer Ruestung.\n",
	       "Kalandra faehrt sich mit einer Hand durch ihre langen Haare.\n"}));
  SetAttackChats(5, 
		 ({"Kalandra stuermt erbarmungslos auf Dich zu.\n",
		     "Kalandra wuergt Dich bis Du blau anlaeufst.\n"}));
  enable_commands();
  
  PO5->AddMember("kalandra");
  
  SUID;
  CLONEME("/gilden/druidenzirkel/armour/d_amulett");
  CLONEME("/gilden/druidenzirkel/armour/e_panzer");
  command("trage alles");
}

void flash(object enemy,int damage, mixed dam_type)
{
  object *feinde;
  int i;
  
  feinde=PresentEnemies();
  if(feinde && sizeof(feinde))
    for(i=sizeof(feinde)-1;i>=0;i--)
      if(random(5))
        feinde[i]->SetProp(P_BLIND, ([BLIND_TIME:5+random(20),
	BLIND_MSG:"Du siehst lauter Sternchen.\n"]));
}

void burn(object enemy,int damage, mixed dam_type)
{
  object w;
  object *armours;
  
  if(sizeof(armours=enemy->QueryProp(P_ARMOURS)))
    if((w=armours[random(sizeof(armours))])->QueryProp(P_AC))
      {
	w->Damage(w->QueryProp(P_AC));
	tell_object(enemy, w->Name(WER,1)+
		    (w->IsPlural()?" fangen Feuer und werden":
		     " faengt Feuer und wird")+" zerstoert.\n");
	if(!w->QueryProp(P_AUTOLOADOBJ))
	  if(w->QueryMaterialGroup(MATGROUP_INFLAMMABLE))
	    ob->remove();
      }
}

void wirbel(object enemy,int damage, mixed dam_type)
{
  object *feinde;
  int i;
  
  feinde=PresentEnemies();
  if(feinde && sizeof(feinde))
    for(i=sizeof(feinde)-1;i>=0;i--)
      feinde[i]->Defend(random(damage), dam_type,
			([SP_SHOW_DAMAGE:1,SP_NAME:"hausiealle"]), this_object());
}

void dla(object enemy,int damage, mixed dam_type)
{
  command_me("laehme "+enemy->name(WER,1));
}

void dbeh(object enemy,int damage, mixed dam_type)
{
  string rnd;
  object who;
  
  rnd=({"ugh","grub","hobbit","mantar"})[random(4)];
  if(who=present(rnd, MENV))
    {
      say("Kalandra heilt "+CAP(rnd)+".\n");
      who->AddHp(40+random(40));
    }
  else
    {
      say("Kalandra heilt sich.\n");
      ME->AddHp(40+random(40));
    }
  return;
}

void dspells(object enemy,int damage, mixed dam_type)
{
  string *vuln;
  
  /* des geht net im kampf :((((((
    if(!present("\ne_panzer",ME))
    {
    command_me("elementarpanzer");
    return;
    }
  */
  vuln=enemy->QueryProp(P_VULNERABILITY);
  if(member(vuln, DT_FIRE)>-1)
    {
      command_me("feuerball");
      return;
    }
  if(member(vuln, DT_COLD)>-1)
    {
      command_me("froststrahl");
      return;
    }
  if(member(vuln, DT_WATER)>-1)
    {
      command_me("wasserstrahl");
      return;
    }
  if(member(vuln, DT_AIR)>-1)
    {
      command_me("windstoss");
      return;
    }
  if(member(vuln, DT_STONE)>-1)
    {
      command_me("erzstrahl");
      return;
    }
  
  switch(random(5))
    {
    case 0: command_me("erzstrahl"); return;
    case 1: command_me("froststrahl"); return;
    case 2: command_me("windstoss"); return;
    case 3: command_me("wasserstrahl"); return;
    case 4: command_me("feuerball"); return;
    }
  return;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt Kalandra.\n");
  PO5->DelMember("kalandra");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  object me,pu;
  int geld;
  
  me=this_object();
  if(killer==me)
    {
      write_file(LOG "npc.deads",
		 ctime()+": "+me->name(WER,1)+" killt "+CAP(getuid(player))+".\n");
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      geld=me->QueryMoney();
      PO5->Payin(geld);
      me->AddMoney(-geld);
      if(pu=present("geldboerse",me))
	pu->remove();
      DB("*** PO5 !! Kalandra nimmt "+geld+" Muenzen.\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object tp;

  if (find_call_out("reaction") != -1) return;
  tp=TP;
  switch (gruppe) 
    {
    case "fies":
      if(tp->QueryProp(P_GENDER)==FEMALE)
	call_out("reaction", 0, tp,
		 "kreischt: Hau bloss ab Du Schlampe!\n",
		 "kreischt "+tp->name(WEN,1)+" an.\n");
      else
	call_out("reaction", 0, tp,
		 "meint: Du stehst wohl auf solche Sachen, oder?\n",
		 "ist sichtlich angetan von "+tp->name(WESSEN,1)+
		 " Brutalitaet.\n");
      break;
    case "frech":
      call_out("reaction", 0, tp,
	       "verpasst Dir eine schallende Ohrfeige.\n",
	       "verpasst "+tp->name(WEM,1)+" eine schallende Ohrfeige.\n");
      break;
    case "intim":
      if(tp->QueryProp(P_GENDER)==FEMALE)
	call_out("reaction", 0, tp,
		 "pruegelt Dich windelweich!!\n",
		 "pruegelt "+tp->name(WEN,1)+" windelweich.\n",1);
      else
	call_out("reaction", 0, tp,
		 "faellt Dir um den Hals und kuesst Dich leidenschaftlich.\n",
		 "faellt "+tp->name(WEM,1)+" um den Hals.\n");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere,int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-20-random(30));
    }
}

init()
{
  ::init();
  if (TP && TP->id("\npo5member")) AddDefender(TP);
}

InformDefend(object enemy)
{
  if(!ME->InFight())
    say("Kalandra erwacht aus ihrer Konzentration und ihre Augen blitzen auf.\n");
  Kill(enemy);
  PO5->DefendMe(enemy);  
}
