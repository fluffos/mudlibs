/*
  Master fuer die Party of 5 

  Verwaltung von Geldreserven fuers Tanken
  Soeldnertypische Aufgaben, wie Ausrauben usw...

*/

#define PLAETZE ([0: "/d/ebene/Midas/room/room_f5";                     \
		  ({"teleportiere","teleportier"}),                     \
                  1: "/d/gebirge/dusty/weg/l23";                        \
		  ({"norden"}),                                         \
                  2: "/d/dschungel/feyaria/tijara/room/platz_d4";       \
		  ({"osten"}),                                          \
                  3: "/d/kristallwald/sargola/dorf/room/1_0714";        \
		  ({"teleportiere","teleportier"}),                     \
                  4: "/d/huegelland/feyaria/weg/room/0815";             \
		  ({"westoben","westen"}),                              \
                  5: "/d/unterwelt/amazora/dimension/room/stadt";       \
		  ({"norden"}),                                         \
                  6: "/d/ebene/lamuerte/burg/weg/17x6y";                \
                  ({"norden"}),                                         \
                  7: "/d/dschungel/dante/weg/room/weg6";                \
                  ({"suedosten"}),                                      \
		  8: "/d/gebirge/impulz/paladinweg/room/weg_6";         \
		  ({"nordoben","norden"}),                              \
		  9: "/d/ebene/creative/feldlager/room/b5_a6";          \
		  ({"norden"}),                                         \
		  10:"/d/huegelland/raballion/hobbits/room/baum";       \
                  ({"teleportiere","teleportier"}),                     \
                  11:"/d/ebene/Midas/room/room_b5";                     \
                  ({"norden"}),                                         \
		  12:"/d/polar/thor/xandim/room/hauptplatz1";           \
                  ({"teleportiere","teleportier"}),                     \
		  99:"/d/wueste/protheg/bazar/room/po5";                \
                  ({})])

#define HAUS 99
#define REMOVE 1
#define ADD 2
#define SCHRANKEN "\npo5_schranken"

#include "../def.h"

int money,pos;
mapping members;

create()
{
  if(is_clone(this_object())) return 0;
  members=(["hobbit":0,
	   "mantar":0,
	   "kalandra":0,
	   "ugh":0,
	   "grub":0]);
  money=10000;
  pos=HAUS;
  //create_party();
  //move_party(pos);
  //call_out("go", 900);
}

DelMember(string who)
{
  if(!members[who]) 
    {
      DB("*** PO5-BUG !! There is no "+who+".\n");
      return;
    }
  if(!previous_object()->id("\npo5member")) 
    {
      DB("*** PO5-BUG !! Deleting NonPo5Member: "+who+".\n");
      return;
    }
  DB("*** PO5 !! Deleting "+who+".\n");
  members[who]=0;
  if(NoMoreMembers())
    schranken(REMOVE);
}

AddMember(string who)
{
  if(members[who]) 
    {
      DB("*** PO5-BUG !! Already have "+who+".\n");
      return;
    }
  if(!previous_object()->id("\npo5member")) 
    {
      DB("*** PO5-BUG !! Adding NonPo5Member: "+who+".\n");
      return;
    }
  DB("*** PO5 !! Adding "+who+".\n");
  members[who]=previous_object();
}

create_party()
{
  if(!members["mantar"])
    members["mantar"]=clone_object(NPC "mantar");
  if(!members["ugh"])
    members["ugh"]=clone_object(NPC "ugh");
  if(!members["kalandra"])
    members["kalandra"]=clone_object(NPC "kalandra");
  if(!members["grub"])
    members["grub"]=clone_object(NPC "grub");
  if(!members["hobbit"])
    members["hobbit"]=clone_object(NPC "hobbit");
  members["mantar"]->heal_self(5000);
  members["ugh"]->heal_self(5000);
  members["kalandra"]->heal_self(5000);
  members["grub"]->heal_self(5000);
  members["hobbit"]->heal_self(5000);
}

reset()
{
  //  create_party();
  //  move_party(pos);
}

Payin(int i)
{
  money+=i;
}

QueryMoney()
{
  return money;
}

go()
{
  int new;
  
  DB("*** Starting Po5 moving\n");
  if(random(100)>60)
    {
      if(pos<HAUS)
	{
	  new=HAUS;
	  move_party(new);
	  schranken(REMOVE);
	  pos=new;
	}      
    }
  else
    {
      new=random(13);
      //      new=10;
      schranken(REMOVE);
      move_party(new);
      pos=new;
      schranken(ADD);
    }
  
  //call_out("go", 900);
}

move_party(int where)
{
  object tmp;
  
  DB("*** Po5: Moving Party to \""+PLAETZE[where]+"\"\n");

  if(tmp=members["mantar"])
    tmp->move(PLAETZE[where],M_NOCHECK);
  if(tmp=members["ugh"])
    tmp->move(PLAETZE[where],M_NOCHECK);
  if(tmp=members["kalandra"])
    tmp->move(PLAETZE[where],M_NOCHECK);
  if(tmp=members["grub"])
    tmp->move(PLAETZE[where],M_NOCHECK);
  if(tmp=members["hobbit"])
    tmp->move(PLAETZE[where],M_NOCHECK);
}

schranken(int flag)
{
  object sch;
  
  switch(flag)
    {
    case REMOVE: 
      catch(call_other(PLAETZE[pos],"???",0));
      if(!sch=present(SCHRANKEN, find_object(PLAETZE[pos])))
	{
	  DB("*** Po5: No Schranken found at \""+PLAETZE[pos]+"\"\n");
	  return 1;
	}
      else
	{
	  sch->UnBlock();
	  DB("*** Po5: Removing Schranken at \""+PLAETZE[pos]+"\"\n");
	}
      break;
    case ADD: 
      DB("*** Po5: Adding Schranken at \""+PLAETZE[pos]+"\"\n");
      sch=clone_object(OBJ "schranken");
      sch->AddId(SCHRANKEN);
      sch->move(PLAETZE[pos], M_NOCHECK);
      sch->Block(PLAETZE[pos,1]);
      break;
    }
}

QueryPosition()
{
  return PLAETZE[pos];
}

GetName()
{
  if(members["mantar"])
    return "Mantar";
  if(members["ugh"])
    return "Ugh";
  if(members["kalandra"])
    return "Kalandra";
  if(members["grub"])
    return "Grub";
  if(members["hobbit"])
    return "Der kleine Hobbit";  
  return "Jemand";
}

NoMoreMembers()
{
  if((!members["mantar"]) && (!members["ugh"]) && (!members["grub"]) && 
     (!members["kalandra"]) && (!members["hobbit"]))
    return 1;
  return 0;
}

Punish(string who,string punisher)
{
  object w;
  
  if(w=find_player(who))
    ROOM "versteck"->Insert(w,punisher);
}

Assasinate(string who,string punisher)
{
  object w;
  
  if(w=find_player(who))
    ROOM "killhim"->Insert(w,punisher);
}
