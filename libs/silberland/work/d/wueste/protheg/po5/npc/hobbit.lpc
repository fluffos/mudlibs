
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleiner Hobbit");
  SetProp(P_LONG,
	  "Ein kleiner, flinker Hobbit wuselt vor Deinen Fuessen herum. "+
	  "Er traegt einen kleinen gruengrauen Mantel, der ihn recht "+
	  "gut versteckt und einen, tief ins Gesicht gezogenen Hut.\n");
  SetProp(P_NAME, "Hobbit");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"hobbit", "\npo5member", "dieb"}));
  
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen kleinen Faeusten"
		       ,QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY, 150);
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,200);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({DT_BLUDGEON,DT_SLASH}));
  SetProp(P_VULNERABILITY, ({DT_MAGIC}));
  SetProp(P_NOMAGIC,100);

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "kommt aus seinem Versteck hervorgekrochen");
  SetProp(P_MMSGOUT, "verschwindet in einem Versteck");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Freunde! Raecht mich!\n");
  SetProp(P_KILL_NAME, "Die Bruederschaft der Fuenf");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal!");

  AddInfo(DEFAULT_INFO, "ruempft nur die Nase.\n");
  AddInfo(({"bruderschaft","fuenf","bruderschaft der fuenf","mitglied"}),
	  "Ich bin der namenlose Hobbit und als Meisterdieb Mitglied in der "+
	  "Bruderschaft der Fuenf!\n","meint stolz: ");
  AddInfo("hobbit",
	  "Mein frueherer Name hat mir nicht gefallen, deshalbt habe ich ihn "+
	  "ihn abgelegt.\n","erklaert: ");
  AddInfo("name",
	  "Der geht Dich gar nichts an!\n","meint: ");
  AddInfo(({"dieb","meisterdieb"}),
	  "Oh, ja ich bin der Meisterdieb!\n","grinst verstohlen: ");
  AddInfo("kalandra",
	  "Sie findet mich soo suess *schmacht*.\n","seufzt: ");
  AddInfo(({"kauz","mantar"}),
	  "Ein komischer alter Kauz, der dauernd nur meditiert.\n","meint: ");
  AddInfo(({"kleiner bruder","grub"}),
	  "Grub ist Ughs kleiner Bruder, doch das macht ihn nicht weniger "+
	  "gefaehrlich!\n","erzaehlt: ");
  AddInfo(({"grosser bruder","ugh"}),
	  "Ugh, Grubs grosser Bruder ist einer der besten Berserker, den ich "+
	  "kenne.\n","meint: ");
  AddInfo("schranken",
	  "An dem kommt keiner vorbei, wenn nicht bezahlt wurde!\n",
	  "meint grinsend: ");

  SetProp(P_REJECT,({REJECT_KEEP,"Der Hobbit bedankt sich bei Dir.\n" }) );
  SetProp(P_SPELLRATE,50);
  AddSpell(1,20,
	   "Der kleine Hobbit krabbelt an Dir hoch und durchwuehlt Deine "+
	   "Sachen.\n",
	   "Der kleine Hobbit krabbelt an @WEM hoch.\n",
	   DT_BLUDGEON,"fladder");

  SetChats(1, 
	   ({"Der Hobbit wuselt um Dich herum.\n",
	       "Der Hobbit sieht sich um.\n",
	       "Der Hobbit mustert Dich.\n"}));
  SetAttackChats(5, 
		 ({"Der Hobbit wirft sich auf Dich und wuergt Dich.\n",
		     "Der Hobbit tritt Dir gegen das Schienbein.\n"}));
  PO5->AddMember("hobbit");
  SUID;
  CLONEME( "/p/armour/umhang");
  CLONEME( "/p/armour/hut");
  command("trage alles");
}

fladder(object enemy, int damage, mixed dam_type)
{
  int da;
  da=damage*10;
  if(enemy->QueryMoney()>da)
    {
      DB("*** Hobbit stiehlt "+enemy->name(WEM,1)+" "+da+" Muenzen.\n");
      enemy->AddMoney(-da);
      PO5->Payin(da);
    }
}

void die(int poisondeath) 
{
  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt den Hobbit.\n");
  PO5->DelMember("hobbit");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  object me,pu;
  int geld;
  
  me=this_object();
  if(killer==me)
    {
      write_file(LOG "npc.deads",
		 ctime()+": "+me->name(WER,1)+" killt "+CAP(getuid(player))+".\n");
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      geld=me->QueryMoney();
      PO5->Payin(geld);
      me->AddMoney(-geld);
      if(pu=present("geldboerse",me))
	pu->remove();
      DB("*** PO5 !! Hobbit nimmt "+geld+" Muenzen.\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object tp;

  if (find_call_out("reaction") != -1) return;
  tp=TP;
  switch (gruppe) 
    {
    case "aergerlich":
      call_out("reaction", 0, tp,
	       "beisst Dich.",
	       "beisst "+tp->name(WEN,1)+".");
      break;
    case "albern":
      call_out("reaction", 0, tp,
	       "lacht ueber Dich.",
	       "lacht ueber "+tp->name(WEN,1)+".");
      break;
    case "fies":
      call_out("reaction", 0, tp,
	       "tritt Dich.",
	       "tritt "+tp->name(WEN,1)+".");
      break;
    case "frech":
      call_out("reaction", 0, tp,
	       "grinst Dich an.",
	       "grinst "+tp->name(WEN,1)+" an.");
      break;
    case "intim":
      call_out("reaction", 0, tp,
	       "tritt Dich extrem hart.",
	       "tritt "+tp->name(WEN,1)+" extrem hart.");
      break;
    case "nett":
      call_out("reaction", 0, tp,
	       "blickt Dich schief an.",
	       "blickt "+tp->name(WEN,1)+" schief an.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

init()
{
  ::init();
  if (TP && TP->id("\npo5member")) AddDefender(TP);
}

InformDefend(object enemy)
{
  if(!ME->InFight())
    say("Der kleine Hobbit stuerzt sich ins Gefecht.\n");
  Kill(enemy);
}
