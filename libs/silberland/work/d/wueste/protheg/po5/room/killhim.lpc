#include "../def.h"

inherit MOST "std_room";

#include <properties.h>
#include <language.h>

#define SCHLUSS 11

mapping victims;
int da;

create() {
  ::create();

  SetProp(P_INT_SHORT, "In den Faengen der Bruderschaft");
  SetProp(P_INT_LONG,
	  "Du wirst gerade von der Bruderschaft der Fuenf auseinander"+
	  "genommen...\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_ROAD]));

  AddCmd("","haltstill",1);
  victims=([]);
  da=0;
}

haltstill(string str)
{
  if(!IS_WIZARD(TP))
    return write("Ugh haelt Dich fest und Du kannst Dich nicht bewegen.\n"),1;
}

Insert(object vic,string pun)
{
  tell_object(vic,
	      "Ugh stampft herein.\n"+
	      "Mantar wandert herein.\n"+
	      "Kalandra schreitet herein.\n"+
	      "Ein kleiner Hobbit wuselt herein.\n"+
	      "Grub stampft herein.\n\n");
  
  vic->move(ME,M_NOCHECK|M_SILENT|M_NO_SHOW);
  if(member(victims,getuid(vic)))
    {
      victims[getuid(vic)]=0;
      victims[getuid(vic),1]=vic->QueryProp(P_LAST_COMMAND_ENV);
      victims[getuid(vic),2]=pun;
    }
  else
    victims+=([getuid(vic):0;vic->QueryProp(P_LAST_COMMAND_ENV);pun]);
  call_out("seq",3,vic);
  DB("*** PO5: Player "+CAP(getuid(vic))+" gets assasinated, from \'"+CAP(pun)+"\'\n");
}

seq(object who)
{
  string text;
  int time,mo;

  if(!who) return;
  switch(victims[getuid(who)])
    {
    case 0: 
      text="Ugh packt Dich mit seinen gewaltigen Haenden, hebt Dich "+
	"ein gutes Stueck in die Hoehe und blickt Dir finster ins Gesicht...\n"+
	"Die anderen umringen Dich und kommen Dir dabei gefaehrlich nahe!\n\n";
      time=10;
      break;
    case 1: 
      mo=who->QueryMoney();
      text="Der kleine Hobbit tritt naeher an Dich heran und beginnt Deine "+
        "Taschen zu durchsuchen...\n\n";
      if(mo)
       text+="Er schnappt sich Dein restliches Geld und steckt es "+
	 "grinsend ein.\n";
      else
        text+="Enttaeuscht, da Du offenbar voellig pleite bist laesst er von Dir "+
          "ab und murmelt etwas unverstaendliches in seinen Bart.\n";
      text+="\nKalandra raeuspert sich...\n\n";
      who->AddMoney(-mo);
      time=15;
      break;
    case 2:
      text="Kalandra meint: "+who->name(WER,1)+", wir sollen Dir von "+
        capitalize(victims[getuid(who),2])+" etwas ausrichten.\n\n";
      time=6;
      break;
    case 4:
      text="Mantar meint: Anscheinend hast Du "+capitalize(victims[getuid(who),2])+
	" ziemlich veraergert, denn wir sollen Dich nun kraeftig durch die Mangel "+
	"nehmen und anschliessend toeten!\n\n"+
	"Du schluckst trocken.\n\n";
      time=10;
      break;
    case 5:
      text="Grub huepft auf und ab und meint: Ich wollen! Ich wollen!\n"+
	"Grub zueckt seine Axt.\n\n"+
	"Dann springt er hoch und spaltet Dir mit einem Schlag das Knie!\n"+
	"Du bruellst auf vor Schmerz!!\n\n"+
	"Jemand kichert hinter Deinem Ruecken.\n\n";
      da=40+random(30);
      time=10;
      break;
    case 6:
      text="Ugh tritt an Dich heran.\n\n"+
	"Ein haemisches Grinsen macht sich auf seinem Gesicht breit.\n\n"+
	"Du ueberlegst, was Ugh wohl gerade denkt, als ploetzlich sein\n"+
	"Gesicht auf Deines zurast!! Du spuerst ein Knacken, als Deine\n"+
	"Nase bricht und alles wird kurz dunkel...\n\n";
      da=20+random(30);
      time=8;
      break;
    case 7:
      text="Du oeffnest Deine Augen.\n\n";
      time=3;
      break;
    case 8:
      text="Ein Schwall roten Blutes rinnt Dir aus der Nase, ueber die Lippen\n"+
	"das Kinn hinab und tropft auf den Boden...\n\n"+
	"Du willst Dich gerade aufrichten, um nach einer Fluchtmoeglichkeit\n"+
	"zu suchen, als Dir ploetzlich eine gewaltige Faust entgegenfaehrt\n"+
	"und laut krachend mindestens zwei Rippen bricht...\n\n";
      da=20+random(30);
      time=1;
      break;
    case 9:
      text="Du stoehnst laut auf, gibst Dich jedoch noch nicht geschlagen!\n\n";
      time=5;
      break;
    case 10:
      text="Leise roechelnd kriechst Du in irgendeine Richtung.\n"+
	"Du denkst . o O (Bloss weg hier!)\n\n"+
	"Ploetzlich wird Dir schwarz vor Augen, als ein massiver Ellenbogen\n"+
	"von oben auf Deinen Ruecken auftrifft und mit einem lauten\n"+
	"*KRRRRRCKS* Dein Rueckgrat bricht...\n\n";
      da=50+random(20);
      time=10;
      break;
    case 11:
      text="Muehsam oeffnest Du Deine Augen...\n\n"+
	"Kalandra tritt an Dich heran und meint: So, mein"+
	(who->QueryProp(P_GENDER)==FEMALE ? "e Kleine":" Kleiner")+"!\n"+
	"Kalandra sagt: Dein letztes Stuendlein hat geschlagen!\n\n"+
	"\nKalandra faehrt fort: Deine Sachen werden wir Dir ausnahmsweise\n"+
	"Kalandra faehrt fort: lassen. Dein Tod ist Strafe genug!\n\n";
      time=10;
      break;
    } 

  tell_object(who,break_string(text,78,"",BS_LEAVE_MY_LFS));
  if(da)
    {
      who->AddHp(-da);
      da=0;
    }
  victims[getuid(who)]+=1;
  if(victims[getuid(who)]==SCHLUSS)
    call_out("schluss",time,who);
  else
    call_out("seq",time,who);
}

schluss(object who)
{
  tell_object(who,
	      "Mit diesen Worten breitet Kalandra ihre Arme aus und ein\n"+
	      "gewaltiger Feuerball bildet sich, der auf Dich zurast.\n");
  who->move(victims[getuid(who),1],M_NOCHECK|M_SILENT|M_NO_SHOW);
  SetProp(P_KILL_NAME, "Die Bruderschaft der Fuenf");
  who->die();
}
