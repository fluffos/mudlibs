/* 
   Baher Saeed Sharaf Badr
*/

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"

inherit MOST "mynpc";

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Baher Saeed Sharaf Badr, vom Sandwichstand");
  SetProp(P_LONG, 
	  "Baher ist ein von oben bis unten in Leintuecher gekleideter alter Mann, "+
	  "der seine besten Jahre schon hinter sich hat. Auf dem Kopf sitzt ihm "+
	  "ein etwas zu gross geratener Turban, sodass Baher andauernd den Kopf "+
	  "schiefgelegt hat. Dazu seinen alten Spazierstock und Du koenntest ihn "+
	  "fast fuer einen alten Bettler halten, doch dem ist nicht so...\n");
  create_default_npc(20);
  AddId(({"baher","saeed","sharaf","badr","verkaeufer"}));
  SetProp(P_ALIGN, -50);
  SetProp(P_HANDS, ({" mit seinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Baher Saeed Sharaf Badr");
  SetProp(P_ARTICLE,0);
  SetProp(P_DEAF, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:60]));
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([ 
	    DT_FIRE:     0.0, DT_COLD:        0.2, DT_WATER:      0.1, 
	    DT_AIR:      0.0, DT_LIGHTNING:   0.3, DT_EXPLOSION:  0.1, 
	    DT_SOUND:    0.1, DT_LIGHT:       0.0, DT_ELECTRIC:   0.1, 
	    DT_ACID:     0.3, DT_POISON:      0.1, DT_TERROR:     0.2,
	    DT_HOLY:    -0.1, DT_UNHOLY:      0.1, DT_MAGIC:      0.1 ]));
  
  
  SetProp(P_REJECT, ({REJECT_GIVE, "Baher Saeed Sharaf Badr braucht das nicht!\n"}));

  AddInfo(DEFAULT_INFO,
	  ({"blickt Dich schief an!\n",
	      "scheint Dich nicht verstanden zu haben.\n",
	      "hebt sein Hoehrrohr und lauscht, laesst es aber sinken und seufzt.\n",
	      "wedelt mit seinem Hoehrrohr.\n"}));

  AddSpell(1,300,
	   "Baher Saeed Sharaf Badr zieht Dir eine mit seinem Stock ueber.\n",
	   "Baher Saeed Sharaf Badr zieht @WEM eine mit seinem Stock ueber.\n",
	   ({DT_BLUDGEON,DT_SLASH}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,150,
	   "Baher Saeed Sharaf Badr sticht Dich mit seinem Stock in den Bauch!\n",
	   "Baher Saeed Sharaf Badr sticht @WEN mit seinem Stock in den Bauch!\n",
	   ({DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
}

