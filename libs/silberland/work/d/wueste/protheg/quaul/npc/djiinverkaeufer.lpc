/*
  Der Djiinverkaeufer
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <guard.h>
#include "../def.h"

#define AI(x,y) AddInf(x,y,"sagt: ")

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Uhag der aufstaendische Djiin");
  SetProp(P_LONG,
          BS("Uhag der Djiin ist beinahe drei Meter gross. Er ist vollkommen "+
	     "durchsichtig, doch das macht ihn nicht minder gefaehrlich. "+
	     "Andauernd faselt er etwas von seiner Gefangenschaft und einer "+
	     "Unterdrueckung..."));
  SetProp(P_NAME, "Uhag der Djiin");
  SetProp(P_NAME_ADJ, "durchsichtig");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:70]));
  AddId(({"uhag","geist", "djiin", "\ndjiin", "NODESTRUCT","NOWIMPY","NOCONTROL"}));
  
  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen magischen Haenden",QueryProp(P_HANDS)[1],
		       DT_MAGIC}));
  
  SetProp(P_RACE, "Djiin");
  SetProp(P_SIZE, 290);
  SetProp(P_BODY, 500);
  SetProp(P_ALIGN, -99);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:      -0.1, DT_WATER:  -0.4, DT_AIR:    -0.2, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.1, DT_SOUND:  -0.6, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: -0.3,
      DT_HOLY:      -0.4, DT_UNHOLY:    -0.3, DT_MAGIC:  -1.0 ]) );
  
  SetProp(P_NOMAGIC,10);
  
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  
  SetProp(P_NOCORPSE, 1);

  SetProp(P_SPELLRATE, 50);

  AddSpell(2,400,
	   "Uhag laesst Dich in einer Windhose herumwirbeln.\n",
	   "Uhag laesst @WEN in einer Windhose herumwirbeln.\n",
	   DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,350,
	   "Uhag reisst Dich mit seinen Klauen auf.\n",
	   "Uhag reisst @WEN mit seinen Klauen auf.\n",
	   DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,600,
	   "Uhag blaest Dich mit einem gewaltigen Windstoss um.\n",
	   "Uhag blaest @WEN mit einem gewaltigen Windstoss um.\n",
	   DT_AIR,([SP_SHOW_DAMAGE:1]));
  
  
  AddInfo(DEFAULT_INFO, 
	  ({"bruellt: Lasst Euch nicht unterdruecken!\n",
	      "groehlt: Freiheit fuer die Geknechteten!\n",
	      "taenzelt um Dich herum.\n",
	      "fragt: Bist Du ein Freund der Djiin?\n",
	      "sagt: Ich habe die Knechtschaft ueberwunden!\n",
	      "bruellt: Freiheit fuer alle Djiin!\n"}));
  
  SetProp(P_LOG_INFO, "djiin_dontknow");

  AI(({"djin"}),
     "");

  SetProp(P_REJECT, ({REJECT_DROP, "Uhag will Deine Sachen nicht tragen.\n"}));
  
  SetChats(3, 
    ({"Uhag schwebt ein wenig nach oben.\n",
	"Uhag schwebt ein wenig nach unten.\n",
	"Uhag schwebt ein wenig nach vorne.\n",
	"Uhag schwebt ein wenig nach hinten.\n",
	"Uhag schwebt ein wenig nach links.\n",
	"Uhag schwebt ein wenig nach rechts.\n",
	"Uhag schwebt durch Dich hindurch und ist nun hinter Dir.\n",
	"Uhag schwebt einmal im Kreis herum.\n",
	"Uhag scheint auf jemanden zu warten.\n",
	"Uhag zeigt Dir ein paar seiner Waren.\n",
	"Was der Djiin hier wohl macht?\n"}));
  
  SUID;
}

Defend(int dam, mixed dtype, int spell, object enemy)    
{
  if(!pointerp(dtype))
    dtype=({dtype});
  
  if(sizeof(dtype&({DT_SLASH,DT_BLUDGEON,DT_PIERCE,DT_SQUEEZE,DT_WHIP,DT_RIP})))
    {
      tell_object(enemy,
		  BS("Dein Schlag geht hindernisslos durch Uhag hindurch."));
      tell_room(ENV(ME),
		BS(enemy->Name(WESSEN)+" Schlag geht hindernisslos durch Uhag "
		   "hindurch."),({enemy}));
      
      return ::Defend(15, dtype, spell, enemy);
    }
  
  if(!random(5))
    {
      tell_object(enemy,
		  BS("Uhag weicht Deiner Attacke blitzschnell aus."));
      tell_room(ENV(ME),
		BS("Uhag kann "+enemy->Name(WESSEN)+" Attacke blitzschnell "
		   "ausweichen."),({enemy}));
      
      return ::Defend(0, dtype, spell, enemy);
    }
  
  return ::Defend(dam, dtype, spell, enemy);
}

void die(int poisondeath) 
{
  object tp,fl;

  if(deep_present("\ndjiinflasche",tp=TP))
    write_file(LOG "kills",
	       ctime()+": "+CAP(getuid(TP))+" killt den Djiin [0].\n");
  else
    {
      fl=clone_object(OBJ "djiinflasche");
      if(fl)
	{
	  fl->move(tp, M_NOCHECK);
	  tell_room(ENV(ME), 
		    BS("Der Djiin beginnt sich aufzuloesen, als sich ploetzlich "
		       "eine kleine Flasche bildet und den Djiin aufsaugt... "
		       "Schnell schnappst Du Dir die Flasche."));
	  write_file(LOG "kills",
		     ctime()+": "+CAP(getuid(TP))+" killt den Djiin [1].\n");
	}
      write_file(LOG "kills",
		 ctime()+": "+CAP(getuid(TP))+" killt den Djiin [BUG].\n");
    }
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    write_file(LOG "playerdeath",
      ctime()+": Der DJIIN killt "+CAP(getuid(player))+" \("+lxp+"\) !!!\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
    if(touch)  
      call_out("reaction", 0, TP,
        "Uhag zeigt sich unbeeindruckt, als Deine Bewegung durch ihn durchgeht.",
        TP->Name(WESSEN)+" Bewegung geht einfach durch Uhag durch.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(macher));
    tell_room(ENV(TO), BS(andere), ({ob}));
  }
}

