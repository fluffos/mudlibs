/*
  Helfgrimm der Zwergen-Goldschmied
  */

#include <properties.h>
#include <language.h>
#include <npc.h>
#include <combat.h>
#include "../def.h"

inherit "std/npc";

#include ROOM "gschmiede.h"

#define S "Helfgrimm "
#define SS S "sagt: "
#define SCHMIEDE ROOM "quaul_2_1_1"


string *allowed=({"amethyst","aquamarin","bergkristall","bernstein","diamant",
		  "granat","lapislazuli","onyx","opal","rubin","saphir",
		  "smaragd","topas","turmalin","zirkon","perle"});
mapping orders;

auftragcheck();

create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Helfgrimm der Zwergenschmied");
  SetProp(P_LONG, 
	  "Du siehst einen aelteren Zwerg an dem die Jahre nicht ganz ungesehen voruebergegangen "+
	  "sind. Das Holzbein und die Augenbinde zeugen von einem ereignissreichen Leben. Doch "+
	  "nun scheinen die Zeiten des Krieges vorbei zu sein und Helfgrimm arbeitet hier in "+
	  "seiner kleinen Schmiede um etwas Geld zu verdienen und um dem weiblichen Geschlecht "+
	  "schoene Gegenstaende herstellen zu koennen.\n");
  SetProp(P_NAME, "Helfgrimm");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:65]));
  AddId(({"helfgrimm","schmied","zwergenschmied"}));
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen kleinen Haenden", 120, DT_BLUDGEON}));
  SetProp(P_ALIGN, 100);
  SetProp(P_ARTICLE,0);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([
	    DT_FIRE:     -0.3, DT_COLD:      0.1, DT_WATER:  0.1, DT_AIR:    0.0, 
	    DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.1, DT_SOUND: -0.2, DT_LIGHT:  0.0,
	    DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
	    DT_HOLY:      0.0, DT_UNHOLY:    0.1, DT_MAGIC:  0.0 ]));

  orders=([ ]);

  AddInfo(({"holzbein","bein"}),
	  "erinnert sich: Das hat mir ein Oger abgebissen, kurz bevor ich ihm den\n"+
	  "  Schaedel gespalten habe!\n");
  AddInfo(({"ogerschaedel","oger","schaedel"}),
	  "seufzt: Ach was waren das noch fuer Zeiten, als ich mit meiner Axt noch\n"+
	  "  Ogerschaedel gespalten habe.\n");
  AddInfo(({"auge","augenbinde","augenlicht"}),
	  "erinnert sich: Das Feuer eines roten Drachen nahm mir damals mein\n"+
	  "  Augenlicht! Seitdem trage ich diese Augenbinde hier.\n");
  AddInfo(({"feuer","feuerdrache","drachen"}),
	  "seufzt: Alles schon soo lang her.\n");
  AddInfo(({"goldschmiede","schmiede","schmiederei","goldschmiederei","beschaeftigung",
	      "zweitliebste beschaeftigung"}),
	  "sagt: Meine Kriegerzeiten sind vorbei, nun beschaeftige ich mich hier \n"+
	  "  mit meiner zweitliebsten Beschaeftigung: Der Goldschmiederei.\n");
  AddInfo("liebste beschaeftigung",
	  "blickt Dich an und seine Augen beginnen zu funkeln, als er sich an die\n"+
	  "alten Zeiten erinnert.\n");
  AddInfo(({"zeiten","kriegerzeiten","krieg","toeten"}),
	  "meint: Dafuer bin ich jetzt schon zu alt.\n");
  AddInfo("alter",
	  "grinst und meint: Sag ich nicht!\n");
  AddInfo("axt",
	  "traeumt vor sich hin...\n");
  AddInfo("hilfe",
	  "sagt: Wenn Ihr wollt, das ich fuer Euch etwas anfertige, dann sagt:\n"+
	  "  \"Helfgrimm fertige mir <schmuckstueck> aus <edelstein> an\"\n"+
	  "  Wollt Ihr Euren Auftrag stornieren, so sagt:\n"+
	  "  \"Helfgrimm storniere Auftrag\"\n"+
	  "  Ihr koennt mich auch aus der Ferne fragen ob ich mit meiner Arbeit\n"+
	  "  fertig bin. Um dies zu tun, teilt mir mit:\n"+
	  "  \"Wie lange noch\"\n"+
	  "  Die Edelsteine, Geld und das Gold *lechz* gebt Ihr einfach an mich.\n");
  AddInfo("fusskettchen",
	  "sagt: Wenn Ihr ein Fusskettchen wollt, dann braucht ihr nur zu sagen:\n"+
	  "  \"Helfgrimm fertige mir Fusskettchen an\"\n");
  AddInfo(({"angebot","angebote","amulett","amulette","diadem","diademe","armreifen",
	      "ring","ringe","halsband","halsbaender","collier","colliers","krone","kronen"}),
	  "sagt: Ich kann fuer Euch folgende Schmuckstuecke anfertigen:\n"+
	  "  Vergoldete Amulette, Diademe, Armreifen, Ringe, Halsbaender,\n"+
	  "  Colliers und Kronen. Ich habe jedoch auch ein paar Extras im Angebot.\n"+
	  "  Alles weitere steht hier auf der Tafel.\n");
  AddInfo("extras",
	  "sagt: Ich habe auch Extras im Angebot. Im Moment habe ich:\n"+
	  "  Eine Perlenkette und ein speziell graviertes Fusskettchen.\n");
  AddInfo(({"kette","perlenkette"}),
	  "sagt: Eine meiner edelsten Arbeiten, ist eine Perlenkette aus den\n"+
	  "  schoensten Perlen des Silberlandes.\n");
  AddInfo(({"perle","perlen","edelsteine","amethyst","aquamarin","bergkristall",
	      "bernstein","diamant","granat","lapislazuli","onyx","opal","rubin",
	      "saphir","smaragd","topas","turmalin","zirkon"}),
	  "seufzt: Hach! Edelsteine, Perlen und Gold sind mein Leben.\n");
  AddInfo(({"geld","gold"}),
	  "beginnt unkontrolliert zu sabbern.\n");
  AddInfo(({"schmied","goldschmied","arbeit","silberland","leben"}),
	  "verkuendet stolz: Ich bin ein Goldschmied und meine Arbeit ist\n"+
	  "im ganzen Silberland bekannt!\n");
  AddInfo("helfgrimm",
	  "laechelt und meint: Das bin ich.\n");
  AddInfo("tafel",
	  "sagt: Seht sie Euch an, sie haengt hier an der Wand.\n");
  AddInfo(({"schmuck","schmuckstuecke","schmuckstueck"}),
	  "meint: Seht Euch doch die Tafel an, da steht alles drauf!\n");
  AddInfo(({"heimat","alte heimat","felonia"}),
	  "seufzt: Aachja, Felonia, meine alte Heimat, dort war ich schon seit "+
	  "Jahren nicht mehr.\n");
  AddInfo("auftrag", CLOSURE(auftragcheck));
}

auftragcheck()
{
  string n;

  n=TP->query_real_name();

  if(!orders[n])
    return "sagt: Wollt Ihr mir nicht etwas in Auftrag geben?\n";
  return "sagt: Fuer "+ARTIKEL(orders[n][0])+" "+CAP(orders[n][0])+" habe ich von Euch\n"+

    SS+(orders[n][0]=="fusskettchen" ? "": (orders[n][2]==0 ? "noch keine"+
    (orders[n][2]==1 ? "n":""): orders[n][2])+" Edelstein"+(orders[n][2]==1 ? ", ":"e, "))+
    (orders[n][3]==0 ? "noch kein":"etwas")+" Gold und "+
    (orders[n][4]==0 ? "noch keine":orders[n][4])+" Muenzen.\n";
}

give_notify(object ob)
{
  string n, what;
  int amount,mat;
  
  if(ob->id("fusskettchen"))
    {
      tell_object(TP,
		  SS+"Ihr wollt das Fusskettchen umgravieren?\n"+
		  S+"fragt: Was wollt Ihr denn gravieren:");
      input_to("kettchenfertig",0,TP,ob);
      return;
    }
  
  n=TP->query_real_name();
  what=explode(explode(file_name(ob),"/")[<1],"#")[0];
  amount=ob->QueryProp(P_GIVEN_AMOUNT);
  mat=ob->QueryMaterial(MAT_GOLD);
  //DB("Amount: "+amount+" "+what+"\n");
 
  if(!orders[n])
    {
      say(SS+"Ohne Auftrag mache ich nichts!\n");
      give_obj(ob,TP);
      return;
    }
  
  if(member(allowed, what)!=-1)
    if(orders[n][1]==what)
      if(orders[n][2]<NEED(orders[n][0]))
	if(amount>NEED(orders[n][0]))
	  {
	    amount=amount-NEED(orders[n][0]);
	    ob->SetProp(P_AMOUNT,amount);
	    orders[n][2]+=NEED(orders[n][0]);
	    say(SS+"Das sind ja "+amount+" zuviele.\n");
	    give_obj(ob,TP);
	    say(SS+"Jetzt habe ich genug.\n");
	    hast_alles(n);
	  }
	else
	  {
	    ob->remove();
	    orders[n][2]+=amount;
	    if(orders[n][2]==NEED(orders[n][0]))
	      if(orders[n][0]=="perlenkette")
		say(SS+"Jetzt habe ich genug Perlen.\n");
	      else
		say(SS+"Jetzt habe ich genug Edelsteine.\n");
	    hast_alles(n);
	  }
      else
	{
	  if(orders[n][0]=="perlenkette")
	    say(SS+"Ich habe bereits genug Perlen, danke.\n");
	  else
	    say(SS+"Ich habe schon genug Edelsteine, danke.\n");
	  give_obj(ob,TP);
	  return;
	}
    else
      {
	if(orders[n][0]=="fusskettchen")
	  say(SS+"Fuer ein Fusskettchen brauche ich keine Edelsteine!\n"+
	      SS+"Nur etwas Gold.\n!");
	else
	  say(SS+"Ihr wolltet doch "+ARTIKEL(orders[n][0])+" "
	      +CAP(orders[n][0])+" aus "+CAP(orders[n][1])+"!\n"+
	      SS+"Warum bringt Ihr mir dann das hier?\n");
	give_obj(ob,TP);
      }

  if(what=="money")
    {
      if(orders[n][4]<PREIS(orders[n][0]))
	if(amount>PREIS(orders[n][0]))
	  {
	    orders[n][4]+=PREIS(orders[n][0]);
	    amount=amount-PREIS(orders[n][0]);
	    ob->SetProp(P_AMOUNT,amount);
	    say(SS+"Das sind ja "+amount+" Muenzen zuviel.\n");
	    give_obj(ob,TP);
	    say(SS+"Jetzt habe ich genug Geld.\n");
	    hast_alles(n);
	  }
	else
	  {
	    ob->remove();
	    orders[n][4]+=amount;
	    if(orders[n][4]==PREIS(orders[n][0]))
	      say(SS+"Jetzt habe ich genug Geld.\n");
	    hast_alles(n);
	  }
      else
	{
	  say(SS+"Ich habe schon genug, danke.\n");
	  give_obj(ob,TP);
	  return;
	}
    }
  
  if((mat<80)&&(what!="money"))
    {
      say(SS+"Dieses Gold ist nicht rein genug!\n");
      give_obj(ob,TP);
      return;
    }
  
  if((mat>=80)&&(what!="money"))
    if(orders[n][3])
      return say(SS+"Ich habe schon genug Gold.\n");
    else  
      {
	if(ob->QueryProp(P_AUTOLOADOBJ)||ob->QueryProp(P_NODROP)||
	   ob->QueryProp(P_NEVERDROP)||ob->QueryProp(P_CURSED))
	  {
	    say(SS+({"Ueberlegt Euch das noch einmal!\n",
		       "Nein, das mag ich nicht!\n",
		       "So etwas nehme ich nicht an!\n",
		       "Wollt Ihr mich aergern?\n"})[random(4)]);
	    give_obj(ob,TP);
	    return;
	  }
	orders[n][3]=1;
	say(S+"lechzt: Gold!! Gold!!\n");
	ob->remove();
	hast_alles(n);
      }
  if(ob)
    give_obj(ob,TP);
}

ketterl(string who)
{
  object spieler;
  object kette;
  
  kette=clone_object(ARMOUR "fusskettchen");
  
  spieler=find_player(who);
  tell_object(spieler,
	      SS+"Ich bin gleich wieder da!\n"+
	      "Mit diesen Worten verschwindet er kurz, um Dir gleich darauf\n"+
	      "ein kleines Fusskettchen zu ueberreichen.\n"+
	      SS+"Jetzt muesst Ihr Euch nur noch eine Gravur ausdenken.\n");
  say(S+"uebergibt "+spieler->Name()+" ein kleines Fusskettchen.\n",({spieler}));
  tell_object(spieler,
	      "Was wollt Ihr denn gravieren:");
  input_to("kettchenfertig",0,spieler,kette);
}

kettchenfertig(string str, object who, object kette)
{
  kette->gravieren(str);
  kette->move(who, M_NOCHECK);
  tell_object(who,
	      S+"nimmt Dir das Fusskettchen ab und graviert Deine Worte ein.\n"+
	      "Danach gibt er Dir das Fusskettchen wieder zurueck.\n");
}

hast_alles(string n)
{
  if((orders[n][4]==PREIS(orders[n][0]))&&(orders[n][3])&&
     (orders[n][2]==NEED(orders[n][0])))
    {
      if(orders[n][0]=="fusskettchen")
	call_out("ketterl",1,n);
      else
	{
	  SCHMIEDE->bestelle(orders[n][0], orders[n][1], n);
	  say(SS+"Ich mache mich sofort an die Arbeit, in "+(BAUZEIT/60)+" Minuten\n"+
	      SS+"koennt Ihr wiederkommen, dann werde ich fertig sein.\n"+
	      SS+"Ihr koennt mich auch aus der Ferne fragen!\n"+
	      SS+"Teilt mir einfach mit 'wie lange noch'\n");
	}
      orders-=([n]);
    }
  else
    say(SS+"Fuer "+ARTIKEL(orders[n][0])+" "+CAP(orders[n][0])+" habe ich von Euch\n"+
	SS+(orders[n][0]=="fusskettchen" ? "": (orders[n][2]==0 ? "noch keine"+
        (orders[n][2]==1 ? "n":""): orders[n][2])+" Edelstein"+(orders[n][2]==1 ? ", ":"e, "))+
	(orders[n][3]==0 ? "noch kein":"etwas")+" Gold und "+
	(orders[n][4]==0 ? "noch keine":orders[n][4])+" Muenzen.\n");
}

catch_tell(string str)
{
  string what,who,foo,mat;
  object ob,perl,w;
  
  if(ME->InFight()) return;

  str=lower_case(str);

  if(sscanf(str, "%s teilt dir mit: wie lange noch",who)==1)
    if(w=find_player(who))
      w->Message("Helfgrimm teilt Dir mit: "+SCHMIEDE->anfrage(who), MSGFLAG_TELL);
  
  if(sscanf(str, "%s sagt: helfgrimm storniere auftrag",who)==1)
    {      
      if(!find_player(who)) return;
      
      if(orders[who])
	{
	  if(orders[who][2])
	    {
	      ob=clone_object("/obj/gems/"+orders[who][1]+".lpc");
	      ob->SetProp(P_AMOUNT,orders[who][2]);
	      if((ob->move(find_player(who)))==ME_TOO_HEAVY)
		{
		  ob->move(MENV,M_NOCHECK);
		  say(SS+"Das ist Euch viel zu schwer\n"+
		      S+"legt ein paar Edelsteine ab.\n");
		}
	      else
		write(S+"gibt Dir ein paar Edelsteine zurueck.\n");
	    }

	  if(orders[who][3])
	    say(SS+"Das Gold behalte ich aber.\n");

	  if(orders[who][4])
	    {
	      ob=clone_object("/obj/money.lpc");
	      ob->SetProp(P_AMOUNT,orders[who][4]);
	      if((ob->move(find_player(who)))==ME_TOO_HEAVY)
		{
		  ob->move(MENV,M_NOCHECK);
		  say(SS+"Das ist Dir viel zu schwer\n"+
		      S+"legt etwas Geld ab.\n");
		}
	      else
		write(S+"gibt Dir etwas Geld zurueck.\n");
	    }

	  orders-=([who]);
	  say(SS+"Ok, Euer Auftrag wurde storniert.\n");
	}
      else
	say(S+"fragt: Welchen Auftrag denn?\n");
    }
  
  if(sscanf(str, "%s sagt: %s fertige mir perlenkette an",who,foo)==2)
    {
      if(!find_player(who)) return;
      if(lower_case(foo)!="helfgrimm") return;
      
      if(orders[who]) 
	return say(SS+"Aber Ihr habt mir doch bereits einen Auftrag gegeben!\n"+
		   SS+"wartet bis ich mit dem ersten fertig bin!\n");
      else
	{
	  orders[who]=({"perlenkette","perle",0,0,0});
	  say(SS+"Ihr wollt also eine Perlenkette, dafuer brauche ich\n"+
	      SS+"noch 20 Perlen und etwas aus reinem Gold von Euch.\n");
	}
    }
  
  if(sscanf(str, "%s sagt: %s fertige mir fusskettchen an",who,foo)==2)
    {
      if(!find_player(who)) return;
      if(lower_case(foo)!="helfgrimm") return;
      if(orders[who]) 
	return say(SS+"Aber Ihr habt mir doch bereits einen Auftrag gegeben!\n"+
		   SS+"wartet bis ich mit dem ersten fertig bin!\n");
      else
	{
	  orders[who]=({"fusskettchen","balblablbla",0,0,0});
	  say(SS+"Ihr wollt also eine Fusskettchen, dafuer brauche ich\n"+
	      SS+"etwas aus reinem Gold von Euch.\n");
	}
    }
  
  if(sscanf(str, "%s sagt: %s fertige mir %s aus %s an",who,foo,what,mat)!=4) return;
  if(!find_player(who)) return;
  if(lower_case(foo)!="helfgrimm") return;
  if(orders[who]) 
    return say(SS+"Aber Ihr habt mir doch bereits einen Auftrag gegeben!\n"+
	       SS+"wartet bis ich mit dem ersten fertig bin!\n");
  else
    {
      if(!angebote[what]) 
	return say(SS+"Aber das habe ich doch gar nicht im Angebot!\n");
      if(what=="fusskettchen"||what=="perlenkette")
	return say(SS+"Extras werden anders bestellt!\n");
      if(member(allowed, mat)==-1)
	return say(SS+"Woraus soll ich das machen?\n");
      orders[who]=({what, mat, 0,0,0});
      say(SS+"Ihr wollt also "+ARTIKEL(what)+" "+CAP(what)+" aus "+CAP(mat)+
	    ".\n"+SS+"Dafuer brauche ich etwas aus reinem Gold und "+
	  NEED(what)+" Edelstein"+(NEED(what)==1 ? "":"e")+".\n");
    }
}

string _query_noattack()
{
  if(sizeof(orders)) return "sagt: Nicht jetzt! Ich habe Kunden!";
}

QueryOrders()
{
  return orders;
}
