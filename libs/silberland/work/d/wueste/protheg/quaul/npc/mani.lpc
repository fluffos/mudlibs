// Mani Raffzahn by PROtheG

#include <properties.h>
#include <language.h>
#include <npc.h>
#include <combat.h>
#include "../def.h"

inherit MOST "mynpc" ;

create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  create_default_nftah(2,"Mani");
  SetProp(P_SHORT, "Mani Raffzahn");
  SetProp(P_LONG, "Mani Raffzahn ist in Quaul fuer das Geld zustaendig, "+
	  "also falls Du Geld brauchst (wer braucht das nicht?), kannst Du "+
	  "Dich ja an ihn wenden.");
  AddId(({"wicht","kreditwicht","raffzahn"}));
}

string _query_noattack()
{
  return "schaut Dich nur entruestet an und sagt: Lass das!\n";
}

