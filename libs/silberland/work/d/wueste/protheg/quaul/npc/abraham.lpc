/*
  Abraham der Troedler
  by PROtheG
*/

#include <properties.h>
#include <language.h>
#include <npc.h>
#include <combat.h>
#include "../def.h"

inherit MOST "mynpc";

create()
{
  if(!is_clone(TO)) return;
  ::create();

  create_default_quaul(2,"Abraham");

  SetProp(P_SHORT, "Abraham der Haendler");
  SetProp(P_LONG, 
	  "Abraham ist der Besitzer des Troedlerladens, einem nicht sonderlich oft besuchten, "+
	  "weil etwas teurerem, Laden. Da er nicht viel zu tun hat, arbeitet er fast nur an "+
	  "seinem Laden, der mittlerweile einer der schoensten Laeden in ganz Quaul ist, herum.\n");
  AddId("haendler");
  AddInfo(DEFAULT_INFO, 
	  ({"schaut Dich nur unwissend an.",
	      "hat keine Ahnung wovon Du redest.",
	      "fragt: hat Deine Frage ueberhaupt einen Sinn?"}));
  AddInfo(({"troedlerladen","laden"}),
	  "Das hier ist mein kleiner, aber feiner Laden. Such Dir was aus und lass es mich "+
	  "wissen.\n",
	  "meint: ");
}

init()
{
  ::init();
  call_out("ww",1);
}

ww()
{
  if(!random(5)&&present(TP))
    write("Abraham sagt: Womit kann ich Ihnen dienen mein"+
	  (TP->QueryProp(P_GENDER)==FEMALE ? "e Dame?\n" : " Herr?\n"));
}

void die(int poisondeath)
{
  write_file(LOG "abraham.kills",
	     dtime(time())+": "+CAP(getuid(TP))+" killt Abraham.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "player.deaths",
	     dtime(time())+": "+CAP(getuid(player))+" wird von Abraham "+
	     "gekillt.\n");
}
