// Ali der Typ vom Steh-Buffetby PROtheG

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ali vom Kamel-Buffet");
  SetProp(P_LONG, 
	  "Ali ist ein friedlicher kleiner Gastarbeiter aus einem fernen Land, der sich auf "+
	  "das Kamel und dessen Zubereitung spezialisiert hat. Wenn man ihn laengere Zeit "+
	  "betrachtet, koennte man meinen, dass sein Laecheln ein Geburtsfehler ist, denn er "+
	  "hoert nie damit auf. Aber sonst ist er ein sehr friedlicher Kollege.\n");
  create_default_npc(15);
  AddId(({"ali","verkaeufer"}));
  SetProp(P_ALIGN, 123);
  SetProp(P_HANDS, ({" mit seinem Topflappen", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Ali");
  SetProp(P_ARTICLE,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:60]));
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([ 
	    DT_FIRE:     0.0, DT_COLD:        0.2, DT_WATER:      0.1, 
	    DT_AIR:      0.0, DT_LIGHTNING:   0.3, DT_EXPLOSION:  0.1, 
	    DT_SOUND:    0.1, DT_LIGHT:       0.0, DT_ELECTRIC:   0.1, 
	    DT_ACID:     0.3, DT_POISON:      0.1, DT_TERROR:     0.2,
	    DT_HOLY:    -0.2, DT_UNHOLY:      0.2, DT_MAGIC:      0.1 ]));
  
  
  SetProp(P_REJECT, ({REJECT_GIVE, "Ali fragt: Kann man @WEN essen?\n"}));

  SetProp(P_MURDER_MSG, "Du boese! Du nix Kollega!");
  
  AddInfo(({"name","ali"}),
	  "deutet auf sich und meint: Das ich sein, Ali!\n");
  AddInfo(({"wuerstel", "kamelwuerstel"}), 
	  "Frueher ich haben Kamelfleischerei, doch mein boeser Bruder sie mir hat "+
	  "weggenimmt, jetzt muss ich zu Billah gehen um kaufen Wuerstel fuer Buffet.\n",
	  "jammert: ");
  AddInfo(({"fleischerei","kamelfleischerei"}),
	  "Ach, groesstes Kamelfleischerei wo gibt! Alles was kannste machen aus Kamel Du "+
	  "kriegste dort! Aber boeser Bruder sie mir hat weggenimmt und jetzt ich hier "+
	  "und jetzt ich arbeiten hier bei dieses mikrige Buffet.",
	  "meint seufzend: ");
  AddInfo(({"tieren","tiere","kamel"}),
	  "Kamele sind so wunderbar Tieren, Du Dir garnicht koennen denken auf wieviele "+
	  "Arten man dem zubereiten kann.\n",
	  "ruft: ");
  AddInfo("arten", 
	  "Aeh Moment, raeuchern, grillen, braten, backen, als Vorspeise, als Beilage, "+
	  "als Nachtisch mit Preiselbeeren, es gibt soooo viele verschiedene Arten.\n",
	  "gruebelt: ");
  AddInfo(({"honig","kamelaugen","augen","nachtisch","pudding","fleisch","kamelfleisch"}),
	  "Hmm, getrocknetes Kamelfleisch mit Pudding! Kamelaugen in Honig!\n",
	  "sabbert: ");
  AddInfo(({"roellchen","ohrroellchen","kamelohrroellchen","kren","senf","vorspeise"}),
	  "Hmm, kleine Kamelohrroellchen mit Kren! Kamelwuerstel mit Senf!\n",
	  "sabbert: ");
  AddInfo(({"kamelohren","beilage","ohren","lippen","kamellippen"}),
	  "Hmm, getrocknete Kamelohren, oder vielleicht getrocknete Kamellippen!\n",
	  "meint: ");
  AddInfo("billah",
	  "Mein boeser Bruder mir nix wollen verkaufen Kamelfleisch, ich mussen gehen immer "+
	  "in Billah und kaufen!\n",
	  "seufzt: ");
  AddInfo("bruder",
	  "Mein Bruder ist boese und ich erwuergta ihm, wenn ich weissta wo er jetzt wohnen.\n",
	  "droht: ");
  AddInfo("preiselbeeren",
	  "reibt sich den Magen.\nAli meint: Kamel mit Preiselbeeren sein das besste wo gibt!\n");
  AddInfo("buffet",
	  "blickt Dich traurig an und seufzt dann resignierend.\n");
  AddInfo(({"quaul","stadt"}),
	  "Quaul sein krasse Stadt, aber ich mir nix auskennt!\n",
	  "meint: ");
  AddInfo("krater",
	  "Stadt liegt in Krater, hier unten nix so heiss wie oben in offene Wueste!\n",
	  "meint: ");
  AddInfo("wueste",
	  "Kollege sein in Wueste, jupp.\n",
	  "meint grinsend: ");
  AddInfo("kollege",
	  "Du nix Kollege?\n",
	  "fragt: ");
  

  AddInfo(DEFAULT_INFO,
	  ({"meint: Ich nix verstehen!\n",
	      "scheint Dich nicht verstanden zu haben.\n",
	      "laechelt Dich schief an.\n"}));


  AddSpell(1,300,
	   "Ali vermoebelt Dich mit einem Kochloeffel.\n",
	   "Ali vermoebelt @WEN mit einem Kochloeffel.\n",
	   ({DT_BLUDGEON,DT_SLASH}));
  AddSpell(2,150,
	   "Ali bearbeitet Dich mit seinem Grillbesteck.\n",
	   "Ali bearbeitet @WEN mit seinem Grillbesteck.\n",
	   ({DT_BLUDGEON,DT_PIERCE,DT_RIP,DT_SLASH}));
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;                                 

  switch (gruppe) 
    {
    case "fies":
      call_out("reaction", 0, TP,
	       "sagt: Du sein gemein "+TPN+"!",
	       "schnieft: "+TPN+" sein soo gemein");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "sagt entruestet: Ich schon haben Frau!",
	       "sagt entruestet: Ich schon sein verheiratet!");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "sagt: Nix sein traurig, Kollege!",
	       "troestet "+TPN+".");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
