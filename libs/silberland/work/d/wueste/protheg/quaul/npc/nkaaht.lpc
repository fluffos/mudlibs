#include "../def.h"

inherit MOST "mynpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#define MAXDRIDER 5

int drider=MAXDRIDER;

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Nkaaht Okh Chak´ar");
  SetProp(P_LONG,
	  BS("Ein gewaltiger Dunkelelf, der selbst fuer seine Rasse ein Gigant ist "+
	     "blickt Dich mit rotfunkelnden Augen an. Eine maechtige Aura des "+
	     "boesen scheint ihn zu umgeben, denn Du kannst seine Umrisse nicht "+
	     "genau definieren und das scheint ihn noch gefaehrlicher zu machen, "+
	     "als er es bereits ist. Huete Dich davor, ihn zu beleidigen, oder "+
	     "auch nur schlecht anzusehen, denn die Konsequencen koennten toedlich "+
	     "sein!\n"));
  SetProp(P_NAME, "Nkaaht Okh Chak´ar");
  SetProp(P_GENDER, MALE);
  AddId(({"nkaaht", "\ndunkelelfverkaeufer", "nkaaht okh chak´ar","NOWIMPY"}));
  set_living_name("Nkaaht Okh Chak´ar");

  create_default_npc(38);

  SetProp(P_HANDS, ({" mit seinen spitzen Fingern", QueryProp(P_HANDS)[1]+50,
		       DT_PIERCE}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 235);
  SetProp(P_ALIGN, -1000);
  SetProp(P_AGGRESSIVE,
	  ([P_GUILD:(["Paladine":0.3]),
	    P_RACE:(["Dunkelelf":0.0, 0:0.02])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));

  SetProp(P_RESISTANCE_STRENGTHS, 
	  ([
	    DT_FIRE:   -0.1, DT_COLD:       0.0, DT_WATER:      0.0,
	    DT_AIR:     0.0, DT_LIGHTNING:  0.1, DT_EXPLOSION:  0.1, 
	    DT_SOUND:   0.1, DT_LIGHT:      0.2, DT_ELECTRIC:   0.0, 
	    DT_ACID:    0.0, DT_POISON:    -0.2, DT_TERROR:    -1.0,
	    DT_HOLY:    0.2, DT_UNHOLY:    -1.0, DT_MAGIC:     -0.4 ]) );

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 40);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "tritt aus dem Schatten hervor");
  SetProp(P_MMSGOUT, "verschwindet in einem Schatten");

  SetProp(P_DIE_MSG,  " bricht tot zusammen.\n");
  SetProp(P_MURDER_MSG, "Moege Lloth Dich zerstoeren!");
  SetProp(P_KILL_MSG, "Eines Tages gehoert Diese Welt uns!");
  SetProp(P_SPELLRATE, 80);

  SetProp(P_GUILD, "dunkelelfen");
  SetProp(P_GUILD_LEVEL, 38);
  
  ModifySkill("ausweichen", 10000);
  ModifySkill("ausweichen", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]));
  ModifySkill("dunkellanze", 10000);
  ModifySkill("dunkellanze", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                               SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("schnell", 10000);
  ModifySkill("schnell", ([SI_PREPARE_TIME:0, SI_SPELLCOST:10]));
    
  AddInfo(DEFAULT_INFO, 
	  ({"droht: Lass mich in Ruh!",
	      "droht: Moege Lloth Dich ewig foltern!",
	      "meint: Geh einem anderen auf die Nerven damit!"}));
  
  AddInfo(({"lloth","goettin"}),
	  "Sprich nicht so herabwuerdigend ueber Lloth, meine Goettin, oder ich "+
	  "werde Dich vernichten!\n",
	  "droht: ");
  AddInfo(({"elfen","zwerge","feen","feenwesen","feinde"}),
	  "Pah! Elfen, Feenwesen und Zwerge sind keine echten Feinde! Nicht fuer "+
	  "den grossen Nkaaht Okh Chak'ar!\n",
	  "prahlt: ");
  AddInfo("dunkelelfen",
	  "Wir sind die besten!\n",
	  "meint: ");
  AddInfo(({"dunkeltrollumhang","umhang","dunkelumhang"}),
	  "Ich besuche den Dunkeltroll westlich von Midas recht oft. Er gibt mir "+
	  "immer freiwillig seinen Dunkeltrollumhang fuer meinen Laden.\n");
  
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP,ME->name(WER)+" will Deine Sachen nicht tragen.\n"}));

  AddSpell(9,1,"","", DT_BLUDGEON, "haudruff");
  AddSpell(1,1,"","", DT_BLUDGEON, "drid");
  AddSpell(1,1,"","", DT_BLUDGEON, "schn");
  AddSpell(1,1,"","", DT_BLUDGEON, "ausw");

  SetAttackChats(10, 
		 ({"Nkaaht Okh Chak'ar bruellt: Ich werde Dich zerquetschen "+
		     "wie einen Wurm!\n",
		     "Nkaaht Okh Chak'ars Augen flammen blutruenstig auf!\n"+
		     "Du schluckst.\n",
		     "Nkaaht Okh Chak'ar taenzelt um Dich herum.\n",
		     "Nkaaht Okh Chak'ar verwirrt Dich durch sein Herumgehuepfe!\n",
		     "Nkaaht Okh Chak'ar fuchtelt wild mit seiner Peitsche.\n"}));
  
  SUID;
  CLONEME(WEAPON "bastard");
  command("zuecke peitsche");
}

void die(int poisondeath) 
{
  object ob;
  
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt "+ME->name(WER)+".\n");
  if(ob=present("muellschlucker",MENV))
    {
      write("Der Muellschlucker stuerzt sich auf Dich, um sein Herrchen zu raechen.\n");
      ob->Kill(PL);
      ob->SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelfen":0.0,0:1])]));
    }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "playerdeath",
	       ctime()+": "+ME->name(WER)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command("nimm alles aus leiche");
}

reset()
{
  ::reset();
  drider=MAXDRIDER;
}

void haudruff(object enemy,int damage, mixed dam_type)
{
  command_me("dunkellanze");
}
	
void drid(object enemy,int damage, mixed dam_type)
{
  object drid;
  if(enemy) 
    if(drider-- > 0) 
      {
	tell_room(MENV, ME->name(WER)+" beschwoert einen kleinen Drider hervor.\n" );
	drid=clone_object(NPC "minidrider");
	drid->move(MENV,M_GO|M_NOCHECK);
	drid->Kill(enemy);
      }
}

void schn(object enemy,int damage, mixed dam_type)
{
  command_me("schnell");
}

void ausw(object enemy,int damage, mixed dam_type)
{
  command_me("ausweichen");
}
