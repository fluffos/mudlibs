#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

string gravur;

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleines Fusskettchen");
  SetProp(P_NAME, "Fusskettchen");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schmuckstueck", "schmuck","kettchen","fusskettchen"}));
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  gravur="";

  AddSpecialDetail("gravur","gravurdet");
}

gravurdet()
{
  if(strlen(gravur)) 
    return "Auf dem Kettchen steht: "+gravur+"\n";
  else
    return "Auf dem Kettchen ist nichts eingraviert.\n";
}

long()
{
  SetProp(P_LONG, 
	  "Ein kleines, meisterhaft gearbeitetes Fusskettchen aus reinem Gold.\n"+
	  (strlen(gravur) ? "Die Gravur besagt: "+gravur+".\n":"Es sieht recht "+
	   "leer aus, ob man da vielleicht etwas eingravieren lassen koennte?\n"));
  return ::long();
}

extra_look()
{
  object en;
  
  if(en=environment(this_object()))
    if(query_once_interactive(en))
      if(this_object()->QueryProp(P_WORN))
	return en->Name()+" traegt ein kleines "+(strlen(gravur) ? "graviertes ":"")+
	  "Fusskettchen um das Fussgelenk.\n";
}

gravieren(string str)
{
  gravur=str;
  SetProp(P_AUTOLOADOBJ, gravur);
}

getgravur()
{
  return gravur;
}

_set_autoloadobj(string gr)
{
  gravur=gr;
  return gravur;
}

_query_autoloadobj()
{
  return gravur;
}
