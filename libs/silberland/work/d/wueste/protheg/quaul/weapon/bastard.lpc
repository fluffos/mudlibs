/*
  Nkaahts Bastardschwert
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosses Bastardschwert");
  SetProp(P_LONG,
	  BS("Das grosse Bastardschwert ist nicht nur ein hervorragendes Schwert, "
	     "sondern jagt es dem Gegner auch durch seine gewaltige Groesse allein "
	     "einen Schrecken ein. Die lange Klinge ist sehr scharf und laeuft in "
	     "eine gefaehrliche Spitze aus. Der Griff laeuft in einen besonders "
	     "geformten Knauf aus, den man mit der zweiten Hand umklammert, wenn "
	     "man das Schwert beidhaendig fuehrt."));
  SetProp(P_INFO,
	  BS("Das Bastardschwert hat seinen Namen von den zwei Arten, mit denen man "
	     "es fuehren kann. Normalerweise verwendet man beide Haende, um das "
	     "Bastardschwert zu fuehren, aber wenn man genuegend Kraft mitbringt, "
	     "kann man es auch problemlos in eine Hand nehmen."));
  SetProp(P_NAME, "Bastardschwert");
  SetProp(P_NAME_ADJ, "gross");
  SetProp(P_GENDER, NEUTER);
  AddId(({"bastardschwert", "schwert", "waffe"}));

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS, (["nkaaht":200]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:84,MAT_GOLD:15,MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 125);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:12])); 
  
  AddDetail(({"klinge", "spitze"}),
	    "Die lange Klinge ist sehr scharf und laeuft in eine gefaehrliche "
	    "Spitze aus.");
  AddDetail(({"griff", "knauf"}),
	    "Der Griff laeuft in einen besonders geformten Knauf aus, den man mit "
	    "der zweiten Hand umklammert, wenn man das Schwert beidhaendig fuehrt.");
}

int _query_nr_hands()
{
  if(environment() && environment()->QueryAttribute(A_STR)>20 )
    return 1;
  else
    return 2;
}
