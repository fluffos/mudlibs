/*
  Kreatersee oestlicher Teil
*/

#include <properties.h>
#include "../def.h"

inherit MOST "std_room";
inherit ROOM "see";

create()
{
  ::create();

  SetProp(P_INT_SHORT,"An einem glitzernden Kratersee");
  SetProp(P_INT_LONG, 
	  "Quauls Kratersee! Ist er nicht herrlich? Du brauchst nur ein Weilchen "+
	  "in das Wasser zu blicken und fuehlst Dich total entspannt. Scheinbar "+
	  "haben das auch andere Leute vor Dir entdeckt und so wimmelt es hier "+
	  "vor Leuten die sich hier entspannen wollen, oder zu ihren Goettern "+
	  "beten.\n"+
	  "Nach Nordwesten, oder nach Suedwesten kannst du am Ufer entlangspazieren."+
	  "\nDen Hang hinauf kommst Du zurueck in den Stadtteil.\n");

  AddDetail(({"sand","wuestensand","boden"}),
	    "Der Sand ist ueber und ueber mit Decken verdeckt, die von den "+
	    "betenden Leuten "+
	    "ausgebreitet wurden, damit sie sich nicht die Fuesse verbrennen.\n");
  AddDetail(({"fuss","fuesse"}),
	    "Verbrenn Dir bloss nicht die Fuesse im heissen Sand!\n");
  AddDetail(({"himmel","rand","krater"}),
	    "Hoch ueber Dir engt der Kraterrand den Himmel bis auf eine kleine, "+
	    "blaue Scheibe ein.\n");
  AddDetail("scheibe",
	    "Die kleine, blaue Scheibe ueber Dir ist der Himmel.\n");
  AddDetail(({"kraterrand","rand"}),
	    "Hoch ueber Dir erkennst Du den kreisrunden Kraterrand von Quaul.\n");
  AddDetail(({"westen","hang"}),
	    "Nach Norden fuehrt der Hang hinauf zurueck in den belebten Stadtteil.\n");
  AddDetail(({"see","kratersee"}),
	    "Ein wunderschoener, kleiner Kratersee breitet sich nach Sueden hin aus.\n");
  AddDetail(({"sueden","mitte","seemitte","kraterseemitte"}),
	    "Im Sueden, schon fast in der Seemitte kannst Du eine Statue erkennen.\n");
  AddDetail("stadtteil",
	    "Weiter oben, den Hang hinauf fuehrt der Weg zurueck in den belebteren "+
	    "Stadtteil von Quaul.\n");
  AddDetail(({"stimmung","weilchen"}),
	    "Verweile doch ein Weilchen und lass Dich von der angenehmen Stimmung "+
	    "hier verwoehnen...\n");
  AddDetail(({"seewasser","wasser"}),
	    "Kristallklares Seewasser fuellt diesen Kratersee. Das Licht, das sich "+
	    "in seinen kleinen Wellen spiegelt, uebt eine beruhigende, fast schon "+
	    "magische Wirkung auf Dich aus. Scheinbar nicht nur auf Dich, denn "+
	    "rund um Dich herum befinden sich viele Lebewesen aus nahen und fernen "+
	    "Laendern um hier zu ihren Goettern zu beten.\n");
  AddDetail(({"licht","sonnenlicht"}),
	    "Das Sonnenlicht spiegelt sich in den kleinen Wellen des Seewassers "+
	    "und glitzert vor sich hin.\n");
  AddDetail(({"wirkung","wellen"}),
	    "Du laesst die Wellen auf Dich wirken...\n"+
	    "Du fuehlst Dich ploetzlich viel entspannter.\n");
  AddDetail(({"suedwesten","suedosten"}),
	    "Nach Suedwesten, oder nach Suedosten breitet sich das Ufer des "+
	    "Kratersees aus.\n");
  AddDetail(({"weg","ufer"}),
	    "Ein schmaler Weg fuehrt das Ufer entlang zwischen den beetenden "+
	    "Leuten hindurch.\n");
  AddDetail(({"stadt","quaul"}),
	    "Du stehst hier mitten in der Stadt Quaul!\n");
  AddDetail(({"lebewesen","leute","wesen","pilger","voelker"}),
	    "Ueberall rund um Dich herum haben sich Pilger aus allerlei Laendern "+
	    "auf ihren Decken versammelt, um zu meditieren, oder zu ihren Goettern "+
	    "zu beten.\n");
  AddDetail("laender",
	    "Aus allen Laendern reisen die Leute an, um hier zu beten.\n");
  AddDetail("decken",
	    "Das gesamte Ufer ist mit Decken zugepflastert. Alle sind voll mit "+
	    "allerlei Leuten die hier beten.\n");
  AddDetail("decke",
	    "NEIN! Es ist keine Decke mehr frei fuer Dich!\n");
  AddDetail("goetter",
	    "Viele Goetter gibt es hier im Silberland! Doch nur zwei von ihnen "+
	    "duerfen herrschen: Woody und Dusty!\n");
  AddDetail(({"woody","dusty","silberland"}),
	    "Woody und Dusty sind die zwei Goetter, die hier im Silberland herrschen!\n");
  AddDetail("statue",
	    "Mitten im See steht eine Statue. Es scheint ein Springbrunnen zu "+
	    "sein, doch mehr kannst Du von hier aus leider nicht erkennen.\n");
  AddDetail(({"brunnen","springbrunnen"}),
	    "In der Mitte des Kratersees befindet sich eine Statue, die als "+
	    "Springbrunnen dient. Aus den Haenden der Statue sprudelt scheinbar "+
	    "rotes Wasser (oder war es Blut?) in den See hinein...\n");
  AddDetail(({"rotes wasser","blut"}),
	    "Ist das wirklich Blut, oder doch nur rotes Wasser?!\n");
  AddDetail(({"hand","haende"}),
	    "Aus den Haenden scheint rotes Wasser zu sprudeln...\n");
    
  AddSound(DEFAULT_SOUND, 
	   "Das Murmeln der Gebete wird nur noch vom Plaetschern des "+
           "Springbrunnens in der Seemitte uebertroffen.\n");
  AddSound(({"gebete","gebet"}),
           "Unterstehe Dich, fremden Gebeten zuzuhoeren!\n");
  AddSound("plaetschern",
           "*plaetscher* *plaetscher*\n");
  AddSound("murmeln",
           "Die Leute hier meditieren und beten zu ihren Goettern. Doch bei "+
	   "sovielen Leuten vermischt sich alles zu einem einheitlichen Murmeln.\n");

  AddSmell(({DEFAULT_SMELL,"wuestensand","sand"}),
           "Es riecht nach heissem Wuestensand.\n");
  AddSmell(({"sand","wuestensand"}),
           "Es riecht nach heissem Wuestensand!\n");

  set_light("hell");
  set_temp("heiss");
  set_exits("quaul",
	    ({"suedwesten#das Ufer entlang nach Suedwesten",
		"nordwesten#das Ufer entlang nach Nordwesten"}),1);
  see_commands();
}
