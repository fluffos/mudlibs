// Steh-Buffet by PROtheG

#include <properties.h>
#include <pub.h>
#include "../def.h"

inherit "std/pub";
inherit MOST "std_room";

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Steh-Buffet zum durstigen Kamel");
  SetProp(P_INT_LONG,
	  "Du befindest Dich im Steh-Buffet \"Zum durstigen Kamel\".\nAm Tag "+
	  "ist hier normalerweise nicht viel los, bis auf ein paar metzelwuetige"+
	  " Spieler die hierher tanken kommen. Der freundliche Buffetbesitzer "+
	  "Ali mustert Dich, da er aber nichts bedrohliches an Dir findet "+
	  "laechelt er und bietet Dir ein paar seiner koestlichen, wenn auch "+
	  "etwas seltsam aussehenden Speisen von seinem Grill an.");

  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, 
          ([ENV_TEMPERATURE:25,ENV_TERRAIN:TT_TOWN]));

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "ali");
  SetProp(P_PUBKEEPER_NAME, "Ali");
  SetProp(P_PUBMSG_NOKEEPER,                                                   
	  "Ali scheint nicht hier zu sein, Du musst wohl auf ihn warten?\n");
  SetProp(P_PUBMSG_NOENEMY, 
	  "Ali funkelt Dich an und bruellt 'Du nix mehr kriegen!'\n");
  SetProp(P_PUBMSG_NOINVITE,
	  "Ali wird seinen Feinen sicher nichts spendieren!\n");
  SetProp(P_PUBMSG_FIGHTING, 
	  "Ali meint 'Jetzt nix Zeit Kollege. Kommen spaeter wieder!'\n");

  AddSound(({DEFAULT_SOUND,"murmeln","bazarbesucher"}),
           "Du hoerst nur das Murmeln von Bazarbesuchern.");

  AddDetail("ali",
	    "Wo ist er denn hin?\n");
  AddDetail(({"besitzer","buffetbesitzer"}),
	    "Dieses Buffet gehoert Ali.\n");
  AddDetail(({"stehbuffet","steh-buffet","buffet"}),
	    TO->QueryProp(P_INT_LONG));
  AddDetail("grill",
	    "Ein ziemlich grosser Grill steht hier voll mit duftenden, vorsichhinbruzelnden "+
	    "Wuerstchen.\n");
  AddDetail(({"wuerstel","wuerstchen"}),
	    "Du bekommst ein ploetzliches Hungergefuehl...\n");
  AddDetail(({"hunger","hungergefuehl"}),
	    "Dem solltest Du nachgeben... Kauf Dir etwas...\n");
  AddDetail("spieler",
	    "Na wer wird damit wohl gemeint sein?\n");
  AddDetail("kamel",
	    "Wahrscheinlich heisst das Buffet so, weil es hier hauptsaechlich Kamelfleisch "+
	    "gibt.\n");
  AddDetail("kamelfleisch",
	    "Kamelfleisch wird in der Wueste sehr geschaetzt, wegen dem Naehrwert und dem "+
	    "reichlichen Vorhandensein.\n");
  AddDetail("vorhandensein",
	    "Es gibt sehr viele Kamele in der Wueste.\n");
  AddDetail("himmel",
	    "Ein strahldenblauer, wolkenloser Himmel.\n");
  AddDetail("boden",
	    "Der Boden ist ueber und ueber mit Sand bedeckt.\n");
  AddDetail("sand",
	    "Wo gibt es denn den nicht in der Wueste?\n");
  AddDetail("wueste",
	    "Wo glaubst Du denn, dass Du Dich hier befindest?\n");
  AddDetail("speisen",
	    "Mit <menue> kommst Du hier sicher weiter.\n");
  AddDrink("Kokosmilch", ({"kokosmilch"}),
	   99, 5, 0, 3,
	   ({"\nAli laechelt Dich an und holt hinter der Bar eine riesige Streitaxt hervor... \n"+
	       "Er holt aus ... und ... laesst die Axt niedersausen.\nErschrocken schliesst Du "+
	       "die Augen und wartest auf den Schmerz, doch als nichts passiert oeffnest Du die "+
	       "Augen wieder und Ali ueberreicht Dir eine koestlich aussehende, frisch "+
	       "gespaltene Kokosnuss.\nSichtlich erleichtert schluerfst Du die Kokosmilch aus.\n",
	       "\nAli holt eine riesige Streitaxt hervor und spaltet damit eine Kokosnuss. && "+
	       "zuckt ordentlich zusammen als die Axt niederfaehrt, doch dann setzt sich && "+
	       "hastig wieder auf und schluerft seine Kokosmilch.\n"}));
  
  AddDrink("Kamelmilch", ({"kamelmilch"}),
	   149, 30, 0, 15,
	   ({"\nAls sich Ali deine Bestellung aufschreibt geht er nach hinten ins Kammerl und "+
	       "bleibt dort fuer etwa 5 Minuten...\nPloetzlich hoerst Du ein Gekreische und "+
	       "Getoese aus Ali's Richtung. Das Gegroele erinnert Dich an die Kamele mit denen "+
	       "du hergekommen bist...\nDoch da kommt auch schon Ali und uebergibt Dir ein Glas "+
	       "frische Kamelmilch, die Du natuerlich sofort herunterschluckst.\n",
	       "\nAli nimmt && 's Bestellung auf und geht ins Hinterkammerl. Schon nach kurzer "+
	       "Zeit hoerst Du ein Gegroele, welches Dich an die Kamele erinnert mit denen Du "+
	       "hergekommen bist. Als es wieder ruhig ist, kommt Ali mit einem Glas voll "+
	       "weissem Zeug an, welches && sofort herunterschluckt.\n"}));
  
  AddDrink("Palmenwedelschnaps", ({"schnaps", "palmenwedelschnaps"}),
	   299, 30, 20, 20,
	   ({"\nAli holt eine kleine gruene Flasche aus dem Regal und giesst Dir daraus einen "+
	       "Tropfen ein. Als Du ihm signalisierst mehr einzufuellen, schaut er Dich etwas "+
	       "komisch an murmelt etwas von \"selber schuld\" und \"betrunken bis zum "+
	       "gehtnichtmehr\" und giesst noch etwas von dem Zeug hinzu. Etwas mistrauisch "+
	       "geworden zoegerst Du, doch dann kippst du den 80%igen Alkohol aufeinmal "+
	       "hinunter. Wirst schon sehen was Du davon hast.\n",
	       "\nAli versucht && zu warnen, doch dieser saeuft den 80%igen Schnaps auf ex "+
	       "hinunter und beginnt etwas zu torkeln.\n"}));
  
  AddDrink("Kokosnuss a la Zombie", ({"nuss","kokosnuss","zombienuss","zombiekokosnuss"}),
	   150, ({15,10,0}), 13, 10,
	   ({"\nAli koepft gekonnt eine Kokosnuss mit einer Streitaxt, leert die Kokosmilch in "+
	       "ein Glaeschen und leert dann etwas aus jeder seiner Flaschen in die Kokosnuss. "+
	       "Danach wird die Kokosnuss mit einem Strohhalm und ein paar Fruechten garniert "+
	       "und schwupps hast Du sie schon ausgetrunken. Die Reste brichst Du auseinander "+
	       "und stopfst Dir noch die koestlichen Kokosstuecke rein...\n",
	       "\nAli koepft gekonnt eine Kokosnuss mit einer Streitaxt, ersetzt die Kokosmilch "+
	       "mit allerlei Zeugs aus herumstehenden Flaschen und garniert das Ganze mit einem "+
	       "Strohhalm und ein paar Fruechten und reicht es dann && und mit einem Schluck "+
	       "ist das alles sofort ausgetrunken...\n"}));
  
  AddFood("Kamelwuerstel", ({ "wuerstel", "kamelwuerstel" }),
	  249, 35, 12,
	  ({"\nAli streckt sich und schneidet ueber deinem Kopf zwei Wuerstel ab. Er packt "+
	      "sie aus und wirft die Verpackung weg, doch Du kannst einen kurzen Blick auf "+
	      "die Verpackung erhaschen...\n...aeh Billah?...\nVielleicht solltest Du ihn zur "+
	      "Rede stellen!?\nNah, du futterst sie trotzdem.\n",
	      "\nAli ueberreicht && ein paar Wuerstel. && zoegert ein wenig als er die "+
	      "Verpacknung sieht, mampft sie aber trotzdem."}));
  
  AddFood("Kamelkeule", ({ "keule", "lamm", "keule" }),
	  399, 55, 25, 
	  ({"\nAli dreht sich um und holt eine riesige Kamelkeule aus dem Ofen. Als Du sie in "+
	      "deinen Haenden haelst, schaetzt Du sie auf ca. 4 kg ein. Doch davon "+
	      "unbeeindruckt verspachtelst Du sie innerhalb kuerzester Zeit.\nNach Deinem "+
	      "vorzueglichen Mahl musst Du ploetzlich schlucken\n"+
	      "...und...\n"+
	      "RRRRRRRRUUUEEELLPPSSSSS!!!!! hallt es durch das ganze Buffet.\n"+
	      "Als sich alle im Buffet nach dir umdrehen, tritt Ali an Dich heran und bittet "+
	      "Dich das Buffet zu verlassen.\n",
	      "\n&& stuerzt sich ueber eine frische Kamelkeule und verputzt diese innerhalb "+
	      "kuerzester Zeit. Du wunderst Dich nicht, dass && gleich dannach bloed aus der "+
	      "Waesche guckt, als ein lauter Ruelpser durch das Buffet hallt und Ali &4 bittet "+
	      "das Buffet zu verlassen."})); 
  
  AddFood("Spankamelhaxe", ({ "spankamelhaxe", "spankamel", "haxe" }),
	  369, 40, 20,
	  ({"\nAli zieht sich zwei uebergrosse Topflappen ueber und verschwindet zur Haelfte "+
	      "in seinem Grill. Als er nach 5 Minuten nicht wieder herauskommt, beschliesst "+
	      "Du ihm zu helfen.\nZum Vorschein kommt ein etwas verkohlter Ali mit einer "+
	      "ziemlich grossen Haxe, die Du Dir sofort einverleibst.\n",
	      "\nAli klettert, mit zwei uebergrossen Topflappen bewaffnet in seinen Grill. Als "+
	      "er nach 5 Minuten noch nicht herauskommt, zieht ihn && heraus. Ali, der etwas "+
	      "angebrannt aussieht uebergibt &3 daraufhin eine riesige Spankamelhaxe.\n"}));
  
  set_light("hell");
  set_temp("heiss");
  set_exits("quaul");

  AddItem(NPC "ali", REFRESH_DESTRUCT);
}
