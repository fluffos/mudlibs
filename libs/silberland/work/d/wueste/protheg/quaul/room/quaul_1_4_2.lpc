/* 
   Kreditinstitut von PROtheG
   
   Variablen
   data[id]   ... Startkapital
   data[id,1] ... noch zu zahlendes Kapital
   data[id,2] ... Gesamtzinsen
   data[id,3] ... Zinssatz
   data[id,4] ... Alter des Spielers
   data[id,5] ... Dauer das laufenden Kredits
   data[id,6] ... Wann wurde das letzte Mal eingezahlt?
   data[id,7] ... gewarnt?
   Ein %ueller Teil vom geborgten Kapital sind Zinsen und werden dazuaddiert
*/

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <mail.h>
#include "../def.h"

inherit MOST "std_room" ;

#define GID (getuid(this_player()))
#define STDLISTE LOG "kredite"
#define ZINSEN 6
#define MAX_GELD (this_player()->QueryProp(P_LEVEL)*750)
#define ALTER (this_player()->QueryProp(P_AGE))
#define EIN_TAG 43200
#define D_REST 1
#define D_GZINS 2
#define D_ZINSS 3
#define D_ALTER 4
#define D_DAUER 5
#define D_LAST 6
#define D_MAIL 7
#define HALBTAG 43200
#define SPA(x) duplicate(" ",x)
#define M "Mani "
#define MS "Mani sagt: "
#define MF "Mani fragt: "
#define SCHULDSCHEIN "\nmaniraffzahnschuldschein"
#define ARBEITSLAGER "gugu"

mapping data=([]);

create()
{
  ::create();
  SetProp(P_INT_SHORT, "In Manis Kreditinstitut");
  SetProp(P_INT_LONG, 
	  "Du stehst hier vor einem kleinen unscheinbaren Laden, waere da nicht dieses "+
	  "auffallend grosse Schild mit der Aufschrift: \"KREDITINSTITUT\". Bis auf die "+
	  "Tatsache, dass keine Tuer vorhanden ist und fast 5 cm dicke Staebe die Fenster "+
	  "schuetzen, sieht der Laden ziemlich normal aus.\n");
  AddDetail("himmel",
	    "Der Himmel wird von der Sonne beherrscht und es ist keine Wolke zu sehen.");
  AddDetail("sonne",
	    "Die Sonne laechelt Dir von oben zu.");
  AddDetail(({"wolke","wolken"}),
	    "Es sind keine zu sehen");
  AddDetail("boden",
	    "Man kann nur noch erkennen, dass da einmal eine Strasse gewesen ist");
  AddDetail("strasse",
	    "Man kann davon nur noch Bruchstuecke erkennen.");
  AddDetail(({"stuecke","bruchstuecke"}),
	    "Ab und zu sieht man noch ein paar Stuecke einer Strasse in Form von "+
	    "Pflastersteinen, die verstreut im Sand liegen.");
  AddDetail(({"laden","institut","kreditinstitut","behausung","haus"}),
	    "Sieht von aussen eigentlich ganz normal aus." );
  AddDetail(({"schild","aufschrift"}),
	    "Du betrachtest das Schild kannst aber nichts interessantes entdecken, vielleicht "+
	    "erfaehrst Du mehr darueber, wenn Du es liest!");
  AddReadDetail("schild",
		"Auf dem Schild steht gross:\"Kreditinstitut\"");
  AddDetail(({"tuer","eingang"}),
	    "Irgendeinen muss es ja geben, aber Du kannst ihn nicht sehen. Vielleicht gibt es "+
	    "ja einen Hintereingang.");
  AddDetail("hintereingang",
	    "Der ist ziemlich gut versteckt, denn Du kannst ihn beim besten Willen nicht finden.");
  AddDetail(({"willen","untersuchen"}),
	    "Den Willen zum Untersuchen hast Du jedenfalls.");
  AddDetail("fenster",
	    "Die sind recht klein gehalten, aber dafuer mit ziemlich dicken Staeben gegen "+
	    "gewaltsames Eindringen geschuetzt. Im inneren des Raumes siehst Du einen "+
	    "recht grossen Tresor, aber sonst ist da nichts, weder Moebel noch andere Sachen, "+
	    "die man normalerweise bei einer Behausung, wie dieser erwartet.");
  AddDetail(({"staebe","staeben","gitter","gefaengniss"}),
	    "Fast koennte man meinen, dass das ein Gefaengniss sei, "+
	    "aber wahrscheinlich ist das nur zum Schutz vor "+
	    "Dieben, Raeubern und anderem Gesindel.");
  AddDetail("schutz",
	    "Nicht einmal Du koenntest da eindringen!");
  AddDetail(({"diebe","raeuber","gesindel"}),
	    "Hoffentlich gehoerst Du nicht zu dieser Sorte!");
  AddDetail("sorte",
	    "Na die Sorte von Lebewesen, die anderen Leuten boese Sachen antun, um sich dadurch "+
	    "Vorteile zu erschaffen.");
  AddDetail(({"vorteile","gold","schaetze"}),
	    "Soetwas wie Gold und andere Schaetze.");
  AddDetail(({"gold","schaetze"}), 
	    "Weisst Du etwa nicht was das ist?");
  AddDetail(({"sachen","rauben","morden","meucheln","brandschatzen"}),
	    "Naja, so Sachen wie Rauben, Morden, Meucheln und Brandschatzen eben");
  AddDetail("sand",
	    "Viele, viele, viele kleine Kruemelchen und Koernchen!");
  AddDetail(({"kruemel","kruemelchen","koerner","koernchen"}),
	    "Viel davon ergibt Sand!");
  AddDetail("eindringen",
	    "Daran solltest Du gar nicht einmal denken!");
  AddDetail(({"wesen","lebewesen"}),
	    "Jaja, die sind ganz boese!");
  AddDetail(({"leute","opfer"}),
	    "Die sind meistens die Opfer.");
  AddDetail(({"pflasterstein","pflastersteine","steine"}),
	    "Du musst aufpassen, dass du nicht ueber einen stolperst!");
  AddDetail("form",
	    "Ein Pflasterstein ist normalerweise wie ein Wuerfel geformt.");
  AddDetail(({"wuerfel","wuerfeln"}),
	    "Zum Wuerfeln sind die Steine zu schwer.");
  AddDetail("raum",
	    "Der Raum ist aeusserst duerftig eingerichtet, gerade einmal ein Tresor und ein "+
	    "Sessel stehen da drinnen.");
  AddDetail("tresor",
	    "Was da wohl drinnen ist?");
  AddDetail(({"sessel","moebel"}),
	    "In dem Raum steht nur ein einziger Sessel, auf dem Mani ab und zu sitzt.");
  AddDetail(({"taefelchen","holztaefelchen"}),
	    "Ein kleines Holztaefelchen, vielleicht kann man ja lesen ob etwas draufsteht!");
  AddReadDetail(({"taefelchen","holztaefelchen"}),
		make_dokument(break_string(
		 "          Mani Raffzahns serioeses Kreditverleihunternehmen\n"+
	         "        =====================================================\n \n"+
		 "Wenn Ihr kreditwuerdig seid, dann duerft Ihr Euch hier bei mir "+
