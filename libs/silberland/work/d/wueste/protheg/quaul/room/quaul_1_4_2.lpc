}

isseada()
{
  if(present("mani"))
    return 1;
  else 
    return 0;
}

zeigerest(string str)
{
  string gid;

  if(!str) return 0;
  if(!isseada()) return write("Wo ist denn Mani bloss hin?\n"),1;
  if(str=="uebersicht"||str=="rest")
    {
      gid=GID;
      if(!member(data, gid))
	return write(M+"Raffzahn mustert Dich eingehend und sagt dann:"+
		     "\nAlso mit Ihrer Stufe koennte ich Ihnen nur maximal "+
		     MAX_GELD+" Muenzen geben.\nVergesst aber nicht, dass ich"+
		     " Euch "+ZINSEN+" % Zinsen verrechnen muss!\n"),1;

      addiere_zinsen(gid);

      TP->More(M+"holt einen Zettel hervor und haelt ihn Dir unter die Nase.\n"
	       "Auf dem Zettel kannst Du erkennen:\n"+
	       make_dokument(
			     "Schuldnerverfahren "+(random(10000)+10000)+", "+
			     CAP(gid)+"\n \n"+
			     "Laufzeit: "+t2s(data[gid,D_DAUER])+" Onlinezeit.\n"+
			     "Letzte Einzahlung erfolgte: "+
			     (data[gid,D_LAST] ? dtime(data[gid,D_LAST]) : "Noch nie.")+
			     "\n \n"+
			     sprintf("%40-s : %6d Muenzen\n",
				     "Urspruenglich geliehener Betrag",
				     data[gid])+
			     sprintf("%40-s : %6d Muenzen\n",
				     "Restbetrag (Stand vom "+dtime(time())[5..16]+")",
				     data[gid,D_REST])+
			     sprintf("%40-s : %6d %%\n",
				     "Urspruenglicher Zinssatz",
				     ZINSEN)+
			     sprintf("%40-s : %6d %%\n",
				     "Aktueller Zinssatz",
				     data[gid,D_ZINSS])+
			     sprintf("%40-s : %6d Muenzen\n",
				     "Betrag der anfallenden Gesamtzinsen",
				     data[gid,D_GZINS])+"\n \n"+
			     "Eine detaillierte Auflistung der Einzahlungen ist auf Ihrem\n"+
			     "Schuldschein (Rueckseite) festgehalten!\n"));
      return 1;
    }
  return 0;
}

nimmgeld(string str)
{
  int menge;
  object ss,tp;
  
  if(!isseada()) return write("Wo ist denn Mani bloss hin?\n"),1;
  notify_fail(MF+"Wieviel willst Du Dir denn ausleihen?\n");
  if(!str) return 0;
  /*
    if(IS_WIZARD(TP) || TP->QueryProp(P_TESTPLAYER))
    return write(MS+" Magier und Testies kriegen nichts!\n"),1;
  */
  
  if(sscanf(str,"%d muenzen aus",menge)==1)
    {
      if(member(data, GID))
	write(M+"schimpft: WAS!! Ih habt Euch doch schon Geld ausgeborgt!\n"+
	      MS+"Ihr kriegt erst wieder was, wenn Ihr alles abbezahlt habt.\n");
      else
	{
	  if(menge<100) 
	    return write(M+"schimpft: Wollt Ihr mich aergern? Unter 100 Muenzen spielt "+
			 "sich nichts ab!\n"),1;
	  if(menge> MAX_GELD)
	    return write(MS+"Habe ich bereits erwaehnt, dass sich Spieler mit Eurem Level "+
			 "nur maximal "+MAX_GELD+" ausleihen duerfen?\n"),1;
	  else
	    {
	      write(M+"sieht Dich an und sagt: Also Ihr wollt "+menge+" Muenzen haben?\n"+
		    MS+"Gut aber dafuer muss ich Euch aber Zinsen verrechnen.\n\n");

	      data+=([GID:menge;menge;0;ZINSEN;ALTER;0;0;0]);

	      save_object(STDLISTE);

	      write(M+"ueberreicht Dir wiederwillig "+menge+" Muenzen.\n\n"+
		    MS+"Eine Warnung noch! Wenn Ihr Eure Schulden nicht regelmaessig\n"+
		    MS+"abbezahlt, dann huetet Euch vor den Konsequenzen!!\n"+
		    M+"gibt Dir einen ausgefuellten Schuldschein.\n");
	      ss=clone_object(OBJ "schuldschein");
	      tp=TP;
	      ss->SetProp(P_AUTOLOADOBJ, 
			  (["gesamt":menge,"angefangen":time(),"alter":(ALTER*2)]));
	      ss->move(tp, M_NOCHECK);
	      tp->AddMoney(menge);
	    }
	}
      return 1;
    }
  return 0;
}

gibgeld(string str)
{
  int menge,ret;
  string dummy,id;
  object ob,tp;
  
  if(!isseada()) return write("Wo ist denn Mani bloss hin?\n"),1;
  notify_fail("Mani fragt: Wieviel willst Du denn zurueckzahlen?\n");
  if(!str) return 0;

  if(sscanf(str,"%d muenze%s zurueck",menge,dummy)!=0)
    {
      tp=TP;
      id=getuid(tp);

      if(!member(data, id))
	write(MS+"Ihr habt Euch doch noch nichts ausgeborgt!\n"+
	      (menge>(tp->QueryMoney()) ? MS+"Ausserdem fuehrt Ihr sowieso "+
	       "nicht genug Geld mit Euch!\n" : ""));
      else
	{
	  if(!menge)
	    return write(M+" funkelt Dich boese an.\n"+
			 MF+"Wegen dem stoert Ihr meine Geschaefte?\n"+
			 MS+"Kommt wieder, wenn Ihr vernuenftiger seid, oder gar nicht!\n"+
			 MS+"Was natuerlich nicht heisst, dass Ihr fuer immer wegbleiben sollt,\n"+
			 MS+"schliesslich muesst Ihr ja Euren Kredit noch abbezahlen!\n"),1;

	  if(menge>data[id,D_REST])
	    return write(MS+"Das ist ja viel zu viel! Soviel brauch ich ja gar nicht!\n"),1;

	  if (menge>(tp->QueryMoney()))
	    return write(M+"faucht Dich an: Koennt Ihr nicht zaehlen?\n"+
			 M+"meint: Soviele Muenzen fuehrt Ihr ja gar nicht mit Euch.\n"),1;

	  if(ob=present(SCHULDSCHEIN, tp))
	    ob->Zahlung(menge);
	  
	  ret=pay_in(tp, menge);

	  if(ret==-1)
	    {
	      write(M+"gratuliert Dir zu Ihrem abbezahlten Kredit.\n"+
		    MS+"Hoffentlich beehrst Du mich bald wieder.\n");
	      if(ob) ob->fertigmacht();
	    }
	  else
	    {
	      write(M+"bedankt sich und steckt das Geld sofort in seinen Tresor.\n");

	      zeigerest("uebersicht");

	      if(ret>0)
		{
		  write(MS+"Aufgrund der langen Dauer Ihres Kredites, sehe ich\n"+
			MS+"mich gewzungen, Ihren Zinssatz von "+(data[id,D_ZINSS]-ret)+" % auf\n"+
			MS+"nunmehr "+data[id,D_ZINSS]+" % zu erhoehen.\n");
		}
	    }
	  tp->AddMoney(-menge);
	}
      return 1;
    }
  return 0;
}

addiere_zinsen(string id)
{
  int zinsen,zsatz;
  zsatz=data[id,D_ZINSS];
  zinsen =(int)(data[id,D_REST] * (exp((ALTER - data[id,4]) * ((float)zsatz/100) / HALBTAG) - 1));
  // 43200 = Sekunden pro Tag / 2, da Alter in 2sec Einheiten gerechnet wird
  
  if(zinsen<0)
    zinsen = 0;
  data[id,D_REST] += zinsen;
  data[id,D_GZINS] += zinsen;
  //  data[id,D_LAST] = ALTER-data[id,D_ALTER];
  data[id,D_DAUER] += ALTER-data[id,D_ALTER];
  data[id,D_ALTER] = ALTER;
}

pay_in(object who, int geld)
{
  string id;
  int r;

  id=getuid(who);
  
  if(!member(data, id)) return 0;

  data[id,D_REST]-=geld;

  addiere_zinsen(id);

  if(data[id,D_REST]<=0) 
    {
      data-=([id]);
      r=-1;
    }
  else
    if(data[id,D_DAUER]>=((data[id,D_ZINSS]-5)*EIN_TAG))
      {
	data[id,D_ZINSS]=((data[id,D_DAUER]/EIN_TAG)+6);
	r=data[id,D_ZINSS]-ZINSEN;
      }
  
  data[id,D_LAST]=time();

  save_object(STDLISTE);
  return r;
}

LoescheEintrag(string str)
{
  if(!member(data, str)) return -1;

  data-=([str]);
}

CheckSchuldner(object wer)
{
  int i;
  string g;

  if(!member(data, g=getuid(wer))) return -1;

  i=data[g,D_LAST];
  
  //  DB("*** "+CAP(g)+" checking Kredit (last check: "+time2string("%d %D %h %H %m %M",i)+")\n");
  DB("*** "+CAP(g)+" checking Kredit (last check: "+(i? t2s(i) : "Never")+")\n");
  
  if((data[g,D_MAIL]) && i>(HALBTAG*2))
    DoKonsequenz(g);
  else
    if(i>HALBTAG)
      DoKonsequenz(g);
}

DoKonsequenz(string who)
{
  string kons;
  
  if(!data[who,D_MAIL])
    {
      SendMail(who);
      data[who,D_MAIL]=1;
      return;
    }

  if(find_player(who) && !random(3))
    {
      if(random(3))
	{
	  PO5MASTER->Punish(who,"mani");
	  kons="Arm-Beinbrechen!\n";
	}
      else
	if(random(3))
	  {
	    ARBEITSLAGER->InsertHackler(who,"mani");
	    kons="Arbeitslager!\n";
	  }
	else
	  {
	    PO5MASTER->Assasinate(who,"mani");
	    kons="Hinrichtung!\n";
	  }
    }
  write_file(LOG "konsequenzen", dtime(time())+": Starte Konsequenz fuer"+CAP(who)+": "+kons);
  DB("*** Spieler: "+CAP(who)+" Konsequenz: "+kons+"\n");
}

t2s(int time)
{
  int d, h, m;
  string ret;
  ret="";
  d = time/86400;
  time%=86400;
  h = time/3600;
  time%=3600;
  m = time/60;                                                                 
  if(d) ret+=time2string("%d %D ", d*86400);
  if(h) ret+=time2string("%h %H ", h*3600);
  if(m) ret+=time2string("%m %M", m*60);
  return ret;
}

SendMail(string player)
{
  mixed* mail;
  string text;
  int wann;
  
  if(!member(data, player))
    wann="langer Zeit";
  else
    wann=dtime(data[player,D_LAST]);

  
  text=SPA(15)+"*-=-*-=-* M A H N U N G *-=-*-=-*\n\n\n"+
    SPA(15)+"Sehr geehrte(r) Herr/Frau "+CAP(player)+"!\n\n"+
    "Es tut mir leid Ihnen mitteilen zu muessen, dass Sie mit Ihren\n"+
    "Kreditrueckzahlungen im Rueckstand sind. Ihre letzte Einzahlung\n"+
    "erfolgte am "+wann+".\n\n"+
    "Ich bitte um baldige Kontaktaufnahme zwecks Abbezahlung eines\n"+
    "weiteren Betrages.\n\n"+
    "Dies ist die erste und letzte Mahnung! Sollte Sie nicht beachtet\n"+
    "werden, sehe ich mich leider gezwungen, weitere Konsequenzen\n"+
    "einleiten zu muessen.\n\n"+
    SPA(40)+"Mani Raffzahn\n";
  
  text=make_dokument(text);
  mail = allocate(9);
  mail[MSG_FROM] = "Mani Raffzahn";
  mail[MSG_SENDER] = MUDNAME;
  mail[MSG_RECIPIENT] = player;
  mail[MSG_CC]=0;
  mail[MSG_BCC]=0;
  mail[MSG_SUBJECT]="Mahnung"; 
  mail[MSG_DATE]=dtime(time());
  mail[MSG_ID]=MUDNAME+":"+time();
  mail[MSG_BODY]=text;

  return "/secure/mailer"->DeliverMail(mail,1);
}   

bu()
{
  return data;
}
