#include "../def.h"

inherit "std/store";

#include <properties.h>
#include <language.h>

create() 
{
  ::create();
  
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/schaufel", REFRESH_REMOVE);
  AddItem("/obj/seil", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/schaufel", REFRESH_REMOVE);
  AddItem("/obj/seil", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/schaufel", REFRESH_REMOVE);
  AddItem("/obj/seil", REFRESH_REMOVE);

}

PreventInsert(object ob)
{
  if(ob->id("geld"))
    return ob->remove();
  if(ob->QueryProp(P_NOBUY))
    return ob->remove();
  return ::PreventInsert(ob);
}
