/*
  Nkaahts Delfenstore by PROtheG
*/

#include <laden.h>
#include <properties.h>
#include "../def.h"

inherit "std/laden";
inherit MOST "std_room";

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem dunklen Zelt");
  SetProp(P_INT_LONG,
	  "Du stehst hier in einem absolut dunklen Zelt. Ueberall stehen Staender mit "+
	  "Hoellenfeuer herum. Ein kleiner, mit Waren beladener Tisch steht an einer "+
	  "Zeltwand, gleich neben einem grossen Schrank aus dunklem Ebenholz und einer "+
	  "mittleren Holztruhe, an dem ein grosses Schloss haengt.");
  SetProp(P_LIGHT,-10);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]));

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER |  SHOP_NEEDSKEEPER); 
  SetProp(P_SHOPKEEPER_ID, "\ndunkelelfverkaeufer");
  SetProp(P_SHOPKEEPER_NAME, "Nkaaht Okh Chak´ar");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  
  AddDetail(({"boden","teppiche"}),
	    "Der Boden ist mit kostbaren, glaenzenden Teppichen ausgelegt, "+
	    "um vor dem heissen Sand zu schuetzen.");
  AddDetail("decke",
	    "An der Decke haengen ein paar Spinnweben, das Zelt ist doch "+
	    "noch gar nicht so lange hier?!\n");
  AddDetail(({"zelt","raum"}),
	    ME->QueryProp(P_INT_LONG));
  AddDetail(({"hoellenfeuerstaender","staender"}),
	    "Das sind kleine Dreibeine mit aufgesteckten "+
	    "Hoellenfeuerfackeln.\n");
  AddDetail("dreibeine",
	    "Die Dreibeine sehen aeusserst stabil aus, aber eines faellt Dir "+
	    "auf.\n");
  AddDetail("dreibein",
	    "Dieses Dreibein ist von einer dicken Schicht Spinnweben "+
	    "umgeben.\n");
  AddDetail(({"feuer","hoellenfeuer","hoellenfeuerfackel"}),
	    "Hoellenfeuer ist ein ganz spezielles Feuer aus den dunkelsten "+
	    "Ecken der Hoelle. Es ist deswegen speziell, denn es bringt kein "+
	    "Licht, es nimmt es viel mehr.\n");
  AddDetail(({"hoelle","ecken"}),
	    "Die Hoelle hat viele unbekannte Ecken.\n");
  AddDetail(({"licht","umgebung"}),
	    "Das Hoellenfeuer nimmt der Umgebung das Licht und es wird "+
	    "dadurch duenkler.\n");
  AddDetail("waren",
	    "Tippe doch einmal ´zeige´ !\n");
  AddDetail("tisch",
	    "Ein Tisch aus dunklem Ebenholz steht hier. Er ist vollbeladen "+
	    "mit allerlei Waren, sogar die Schubladen sind voll. Der "+
	    "Ladenhueter duerfte kein sehr ordentliches Wesen sein.\n");
  AddDetail(({"ladenhueter","wesen","dunkelelf","spinnenfreund"}),
	    "Der Ladenhueter heisst Nkaaht Okh Chak´ar und ist ein "+
	    "Dunkelelf.\n");
  AddDetail(({"holz","ebenholz","holzart"}),
	    "Diese kostbare Holzart stammt aus weiter Ferne von einem "+
	    "speziellen Baum, welcher nur in der Dunkelheit gedeihen kann.\n");
  AddDetail(({"ferne","gebiete"}),
	    "Dir noch unbekannte Gebieten.\n");
  AddDetail("baum",
	    "Du hast noch nie einen Baum gesehen, der aus diesem Holz "+
	    "besteht.\n");
  AddDetail("dunkelheit",
	    "Der Baum kann nur in der Dunkelheit wachsen.\n");
  AddDetail("schubladen",
	    "Du spaehst vorsichtig in eine der Schubladen und erblickst "+
	    "eine kleine Spinne, die Dich ansieht.\n");
  AddDetail("spinne",
	    "Daneben sitz noch eine, dahinter noch eine, davor auch noch "+
	    "eine...\n");
  AddDetail(({"waende","zeltwaende"}),
	    "Die Zeltwaende bestehen aus einem Dir unbekannten, dunkel "+
	    "glaenzenden Material.\n");
  AddDetail("material",
	    "Du hast noch nie so ein Material gesehen.\n");
  AddDetail(({"wand","zeltwand"}),
	    "An einer Zeltwand steht ein kleiner Tisch.\n");
  AddDetail("schrank",
	    "Der Schrank besteht aus dunklem kostbaren Ebenholz. Er sieht "+
	    "schon recht abgenutzt aus. Eine Tuer scheint offen zu sein.\n");
  AddDetail(({"tuer","tuere","tuerspalt","spalt"}),
	    "Du lugst vorsichtig in den Tuerspalt, doch das Innere des "+
	    "Schrankes ist leer.\n");
  AddDetail(({"innere","inneres"}),
	    "Das ist leider leer.\n");
  AddDetail(({"truhe","holztruhe"}),
	    "Eine massive mittelgrosse Holztruhe aus dunklem Ebenholz. "+
	    "Sie ist mit einem Schloss gesichert.\n");
  AddDetail("schloss",
	    "Ein staehlernes, stabil aussehendes Schloss ist an der "+
	    "Holztruhe befestigt.\n");
  AddDetail("spinnweben",
	    "Der Ladenhueter scheint ein grosser Spinnenfreund zu sein.\n");
  AddDetail("sand",
	    "Der Sand ist in der Wueste allgegenwaertig!\n");
  AddDetail("wueste",
	    "Genau in der befindest Du Dich jetzt.\n");

  SetStorageRoom(ROOM "dzelt_storage");
  RemoveItem("/obj/entsorg");

  AddItem(NPC "entsorg2",REFRESH_DESTRUCT);
  AddItem(NPC "nkaaht", REFRESH_DESTRUCT);


  set_light("hell");
  set_temp("heiss");
  set_exits("quaul");
}

do_sell(object ob, int force, no_reg, string prefix) 
{
  if(!present("\ndunkelelfverkaeufer")) return 1;
  if(TP->QueryProp(P_RACE) != "Dunkelelf") 
    return write("Nkaath sagt: Ich mache nur mit Dunkelelfen Geschaefte!\n"),1;
  return ::do_sell(ob, force, no_reg, prefix);
}

