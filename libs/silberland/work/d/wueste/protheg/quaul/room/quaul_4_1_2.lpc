/*
  Ein selbstaendig gemachter Djiin verkauft hier ein paar Sachen
*/

#include <properties.h>
#include "../def.h"

inherit "std/laden";
inherit MOST "std_room";

create()
{
  ::create();
  
  SetProp(P_INT_SHORT,"In einem riesig wirkenden Zelt");
  SetProp(P_INT_LONG, 
	  BS("Du findest Dich ploetzlich in einem riesig wirkenden Zelt wieder. "
	     "Das hat doch von aussen nicht so gross ausgesehen *gruebel*. "
	     ""));
  SetProp(P_INDOORS,1);
  
  
  set_light("hell");
  set_temp("warm");
  set_exits("quaul");

  AddItem(NPC "djiinverkaeufer", REFRESH_DESTRUCT);
}
