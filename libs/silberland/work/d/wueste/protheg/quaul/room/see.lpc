#include "../def.h"

string *pause=({});

see_commands()
{
  AddCmd(({"bade","bad","schwimme","schwimm"}), "baden");
  AddCmd(({"bete","bet"}), "beten");
}

baden(string str)
{
  notify_fail("Wo willst Du denn baden?\n");
  if(!str) return 0;

  if(str=="in see"||str=="in kratersee"||str=="in wasser")
    return write("Du naeherst Dich dem Kratersee und willst gerade hineinschluepfen, "+
		 "als Dich die empoerten Rufe der Menge zurueckhalten.\n"),1;
  return 0;
}

beten(string str)
{
  string who;
  object tp;

  notify_fail("Zu welcher Gottheit willst Du denn beten?\n");
  if(!str) return 0;

  if(sscanf(str, "zu %s",who)==1)
    {
      tp=this_player();
      if(member(pause, getuid(tp))>-1)
	return write("Das hat jetzt erstmal gereicht...\n"),1;

      write_file(LOG "gottheiten",
		 dtime(time())+" : "+CAP(getuid(this_player())+" betet zu "+CAP(who)+"\n"));
      
      pause+=({getuid(tp)});

      call_out("geht_wieda", 10, getuid(tp));

      if(lower_case(tp->QueryProp("race"))=="dunkelelf")
	if(strstr(who, "lloth")==-1)
	  {
	    write("Eine Stimme ertoent in Deinem Kopf: Was ist mit Lloth, Du "+
		  "Frevler"+(tp->QueryProp("gender")==2 ? "in":"")+"!\n"+
		  "Da durchfaehrt Dich ein stechender Schmerz!\n");
	    tp->AddHp(-5-random(5));
	    return 1;
	  }

      if(lower_case(tp->QueryProp("guild"))=="paladine")
	if(strstr(who, "dusty")==-1)
	  {
	    write("Dusty laesst einen warnenden Blitz auf Dich herab, Paladin!\n");
	    tp->AddHp(-5-random(5));
	    return 1;
	  }

      write("\nDu kniest im heissen Wuestensand nieder und faltest Deine Haende.\n\n"+
	    "Die Gedanken in Deinem Kopf verschwimmen, nur noch ein einziger\n"+
	    "Gedanke bleibt und zwar: \n"+
	    sprintf("%65|s", "\""+capitalize(who)+"\"")+"\n\n"+
	    "Mit gereinigtem Geist stehst Du auf und fuehlst Dich viel besser.\n");
      return 1;
    }
  
  return 0;
}

geht_wieda(string who)
{
  pause-=({who});
}
