/* 
   Sandwichstand by PROtheG
*/

#include <properties.h>
#include <language.h>
#include <food.h>
#include "../def.h"

inherit MOST "std_room";

#define MAXIMUM(x) sandwiches[x,3]
#define AKTUELL(x) sandwiches[x,2]

nosave mapping sandwiches, fleisch, kaese, gemuese, anderes, extra, alles, zutaten;
nosave mapping vorrat;
nosave string *thunfisch, *eiersalat, *huehnchen, *kamelschinken, *sandwich_normal;
nosave string *kinder, *seicherl, *spezial, *megaspezial;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Baher Saeed Sharaf Badr's Sandwichstand");
  SetProp(P_INT_LONG,
	  "Du stehst hier im beruemten Sandwichstand von Baher Saeed Sharaf Badr. "+
	  "Vor Dir erstreckt sich ein riesiges Tablett mit allerlei Essbarem und "+
	  "Zeugs, welches aussieht als ob es essbar waere. Dahinter steht eine "+
	  "kleine Bude, in der fuer maximal eine Person Platz zu sein scheint.\n");
  AddDetail("boden",
	    "Am Boden liegen ein paar Salatblaetter, Wurstscheiben und sonstige, "+
	    "vom Tablett gefallene Sandwichzutaten verstreut.\n");
  AddDetail(({"salatblaetter","wurstscheiben","hundefutter"}),
	    "Ab und zu faellt etwas vom grossen Tablett herunter und das endet "+
	    "dann als Hundefutter.\n");
  AddDetail(({"stand","sandwichstand"}),
	    TO->QueryProp(P_INT_LONG));
  AddDetail("himmel",
	    "Den kannst Du nicht sehen, weil der Himmel von einer Zeltplane "+
	    "verdeckt wird.\n");
  AddDetail(({"plane","zeltplane"}),
	    "Ueber dem Stand ist eine schattenspendende Zeltplane aufgespannt "+
	    "worden.\n");
  AddDetail("person",
	    "Das wird wohl der sein, der hier die Sandwiches zubereitet.\n");
  AddDetail("tablett",
	    "Vor der Bude ist ein riesiges Tablett, welches mit den allerfeinsten "+
	    "Sandwichzutaten belegt ist, aufgestellt.\n");
  AddDetail(({"bude","holzbude"}),
	    "Eine kleine, auf Raedern stehende, Holzbude ist hinter einem riesigen "+
	    "Tablett aufgestellt und traegt eine Zeltplane, die vor der Sonne "+
	    "schuetzen soll. Ein kleines Schild ist an der Front befestigt.\n");
  AddDetail(({"front","budenfront"}),
	    "An der Budenfront haengt ein kleines Schild.\n");
  AddDetail("raeder",
	    "Die Raeder helfen dabei, die Bude transportieren zu koennen.\n");
  AddDetail("sonne",
	    "Die kannst Du von hier unten aus nicht sehen.\n");
  AddDetail(({"sandwichzutaten","essbares","sandwich","essbarem"}),
	    "Lauter, Dir bekannte, Sandwichzutaten sind hier auf diesem Tablett "+
	    "vorbereitet... Du bekommst ploetzlich Lust auf ein Sandwich.\n");
  AddDetail("platz",
	    "Viel mehr, als eine Person, hat in dieser winzigen Bude keinen "+
	    "Platz.\n");
  AddDetail(({"zeugs","zeug"}),
	    "Einiges von diesem Zeugs sieht aus, als ob es noch leben wuerde, oder "+
	    "gerade aus der Kanalisation gefischt wurde.\n");
  AddDetail("kanalisation",
	    "Du moechtest lieber nicht wissen, was es da unten alles gibt.\n");
  AddDetail("schild",
	    "Da steht ja sogar was drauf! Versuchs doch mal mit lesen!\n");

  sandwiches=([ 
	       "thunfisch":400;1;15;15,	       "eiersalat":410;1;15;15,
	       "huehnchen":400;1;15;15,        "kamelschinken":395;1;15;15,
	       "kinder":340;1;16;16,	       "seicherl":450;3;14;14,
	       "spezial":600;5;12;12,	       "megaspezial":999;7;10;10 ]);

  sandwich_normal=({"thunfisch","eiersalat","huehnchen","kamelschinken"});

  fleisch=([
	    "pfeffersalami":2;4,        "kamelsalami":3;5, 
	    "haussalami":1;3, 	        "feuersalami":1;4, 
	    "beinschinken":2;4,         "kamelschinken":3;6, 
	    "raeucherschinken":2;5,     "saunaschinken":3;5, 
	    "thunfisch":3;6, 	        "huehnchen":-1;4, 
	    "leberwurst":2;3 ]);
  kaese=([ 
	    "gouda":2;3, 	        "ementaler":2;4, 
	    "bierkaese":1;3,            "ziegenkaese":3;4, 
	    "edamer":2;3,               "huettenkaese":3;4, 
	    "gorgonzola":1;4,           "brie":2;5 ]);
  gemuese=([ 
	    "feigenblaetter":3;-2,      "vogerlsalat":2;-1,
	    "grnagkraeuter":5;-3,       "blattsalat":3;-2, 
	    "tomaten":2;-1, 	        "gurken":2;-1, 
	    "pfefferoni":1;0 ]);
  anderes=([ 
	    "eier":1;3, 	        "eiersalat":3;6, 
	    "majonaisesalat":3;6, 	"thunfischaufstrich":4;5, 
	    "huehneraufstrich":4;6 ]);
  extra=([
	    "zwiebel":1;2, 	        "knoblauch":2;1, 
	    "senf":1;2, 	        "ketchup":1;2, 
	    "majonaise":1;4 ]);
  alles=fleisch+kaese+gemuese+anderes+extra;
  zutaten=fleisch+kaese+gemuese+anderes;
  thunfisch= ({"Thunfischsandwich", 
	       "Du haelst ein grosses randvoll mit Thunfisch gefuelltes "+ 
	       "Sandwich in Deinen Haenden und freust Dich schon "+ 
	       "darauf, es verspeisen zu koennen.\n", 20, 10});
  
  eiersalat= ({"Eiersalatsandwich", 
	       "Du haelst ein grosses Eiersalatsandwich in Deinen "+ 
	       "Haenden, noch riecht es gut, Du solltest es bald essen...\n", 
	       22,15});
  
  huehnchen=({"Huehnchensandwich", 
	      "Du haelst ein grosses Sandwich mit saftigem Huehnerfleisch "+ 
	      "in Deinen Haenden und Du kannst es kaum erwarten, es "+ 
	      "aufzuessen", 20,10});
  
  kamelschinken=({"Kamelschinkensandwich", 
		  "In Deinen Haenden befindet sich ein Sandwich, voll mit "+ 
		  "duftendem Kamelschinken. Du musst Dich zurueckhalten, "+
		  "um es nicht auf der Stelle zu verspeisen", 24,12});
  
  kinder=({"Kindersandwich", 
	   "In Deinen Haenden haelst Du ein kleines Kindersandwich. ", 
	   20,8});
  
  seicherl=({"Seicherlsandwich", 
	     "In Deinen Haenden haelst Du ein mittleres Seicherlsandwich. ",
	     25,10});
  
  spezial=({"Spezialsandwich", 
	    "In Deinen Haenden haelst Du ein grosses Spezialsandwich. ", 
	    30,14});

  megaspezial=({"Megaspezialsandwich", 
		"In Deinen Haenden haelst Du ein riesiges "+
		"Megaspezialsandwich. ", 35,17});
  
  AddCmd(({"kaufe","kauf"}),"kaufen");
  AddCmd(({"zutaten","zutat"}), "zutatenliste");
  AddCmd(({"liste","lies"}), "schild");

  set_light("hell");
  set_temp("heiss");
  set_exits("quaul");

  init_anzahl();
  AddItem(NPC "badr", REFRESH_DESTRUCT);
}

reset()
{
  ::reset();
  init_anzahl();
}

init_anzahl()
{
  string *ind;
  int i;

  ind=m_indices(sandwiches);

  for(i=sizeof(ind)-1;i>=0;i--)
    AKTUELL(ind[i])=MAXIMUM(ind[i]);
}

schild(str)
{
  string ret;
  if ((!str) && (query_verb()=="lies")) return 0;
  if(str=="schild" || query_verb()=="liste")
    {
      ret="\n      Baher Saeed Sharaf Badr's Sandwichstand:\n"+
	duplicate("=",70)+"\n"+
	"\n Sandwiches                                Preise\n"+
	duplicate("-",70)+"\n"+
	" Thunfischsandwich ........................  "+
	sandwiches["thunfisch",0]+"\n"+
	" Eiersalatsandwich ........................  "+
	sandwiches["eiersalat",0]+"\n"+
	" Huehnchensandwich ........................  "+
	sandwiches["huehnchen",0]+"\n"+
	" Kamelschinkensandwich ....................  "+
	sandwiches["kamelschinken",0]+"\n\n"+
	" Unser Spezialangebot:\n"+
	duplicate("-",35)+"\n"+
	" Kindersandwich ............ "+sandwiches["kinder",1]+
	" Zutat ......  "+sandwiches["kinder",0]+"\n"+
	" Seicherlsandwich .......... "+sandwiches["seicherl",1]+
	" Zutaten ....  "+sandwiches["seicherl",0]+"\n"+
	" Spezialsandwich ........... "+sandwiches["spezial",1]+
	" Zutaten ....  "+sandwiches["spezial",0]+"\n"+
	" Megaspezialsandwich ....... "+sandwiches["megaspezial",1]+
	" Zutaten ....  "+sandwiches["megaspezial",0]+"\n\n"+
	" Extra:\n"+
	duplicate("-",35)+"\n"+
	" Zwiebeln, Knoblauch ......................   20\n"+
	" Senf, Ketchup, Majonaise .................   20\n"+
	duplicate("-",70)+"\n"+
	"\nSyntax:\n"+
	" zutaten - fuer eine Liste der Zutaten\n"+
	" kaufe <Sandwich> mit <zutat> und <zutat> und ...\n"+
	" z.B.: kaufe Thunfischsandwich (mit Zwiebeln)\n"+
	"       kaufe Kindersandwich mit Salami (und Knoblauch)\n\n";
      TP->More(ret);
      return 1;
    }
  return 0;
}  

valid(string str)
{
  if(member(m_indices(alles),str)==-1) return 0;
  return 1;
}

kaufen(string str)
{
  object sandwich;
  string was;
  string *tmp, *args, *data;
  int i;

    notify_fail("Was willst Du denn kaufen?\n");
  if(!str) return 0;
  if(!present("badr",TO))
    return write("Der Verkaeufer scheint nicht da zu sein...\n"),1;
  tmp=regexplode(str,"(und|mit| )")-({""," ","mit","und"});
  if(tmp[0]=="sandwich") 
    return write("Baher sagt: Ich habe viele verschiedene Sandwiches!\n"+
		 "Baher deutet auf ein Schild.\n"),1;
  was=to_string(explode(tmp[0],"sandwich")[0]);

  if(!AKTUELL(was)) 
    return write("Baher sagt: Davon habe ich leider nichts mehr!\n"),1;

  if(sizeof(tmp)>=2)
    args=tmp[1..];

  for(i=sizeof(args)-1;i>=0;i--)
    if(!valid(args[i])) 
      return write("Baher sagt: Die Zutat "+CAP(args[i])+" habe ich nicht!\n"),1;

  if(member(sandwiches,was)>0)
    {
      switch(was)
	{
	case "thunfisch":     data=thunfisch;     break;
	case "eiersalat":     data=eiersalat;     break;
	case "huehnchen":     data=huehnchen;     break;
	case "kamelschinken": data=kamelschinken; break;
	case "kinder":        data=kinder;        break;
	case "seicherl":      data=seicherl;      break;
	case "spezial":       data=spezial;       break;
	case "megaspezial":   data=megaspezial;   break;
	}
      do_sandwich(data, args);
      AKTUELL(was)--;
      if(!AKTUELL(was)) 
	write("Baher sagt: Du hast den letzten "+CAP(was)+"sandwich gekauft!\n");
      return 1;
    }      
  return write("Baher sagt: So ein Sandwich habe ich nicht.\n"),1;
}

do_sandwich(mixed data, mixed args)
{
  object sandwich,tp;
  string was,wask,lang;
  string *doppelt;
  int heal,soak,i,preis;
  
  was=data[0];
  lang=data[1];
  heal=data[2];
  soak=data[3];

  wask=lower_case(to_string(explode(was,"sandwich")[0]));
  
  doppelt=({});

  for(i=0;i<sizeof(args);i++)
    {
      if(member(doppelt,args[i])>-1)
	return write("Du kannst die Zutaten nur jeweils einmal einsetzen!\n"),1;
      doppelt+=({args[i]});
    }

  if((!args)&&(member(sandwich_normal,wask)==-1))
    return write("Baher sagt: "+CAP(was)+" gibts nur mit Zutaten!\n"),1;

  if(args)
    {
      if(member(sandwich_normal,wask)>-1) 
	{
	  for(i=0;i<sizeof(args);i++)
	    if(!member(extra,args[i]))
	      return write("Baher sagt: Bei einem "+was+
			   " gibt es ausser Extra nichts dazu!\n"),1;
	  if(sizeof(args)>sandwiches[wask,1])
	    return write("Baher sagt: Das sind zu viele Extras.\n");
	}
      else
	{
	  if(sizeof(args)>sandwiches[wask,1])
	    return write("Baher sagt: Das sind zu viele Zutaten.\n");
	  if(sizeof(args)<sandwiches[wask,1])
	    return write("Baher sagt: Das sind zu wenig Zutaten.\n");
	}
      for(i=sizeof(args)-1;i>=0;i--)
	{
	  heal+=alles[args[i]];
	  soak+=alles[args[i],1];
	}
      lang+="\nDas Sandwich ist gefuellt mit "+
	implode(map_array(args,CLOSURE(capitalize)),", ")+
	" und ein paar Gewuerzen.\n";
    }

  //if(soak<=1) soak=2; nix unter null
  if(soak*3<heal) soak=heal/3; //besser 
  sandwich=clone_object(OBJ "sandwich");
  sandwich->SetProp(P_NAME, was);
  sandwich->AddId(lower_case(was));
  sandwich->AddId("sandwich");
  sandwich->SetProp(P_SHORT, "Ein "+was);
  sandwich->SetProp(P_FOOD_INFO, ([F_HEAL:({heal,0}), F_SOAK:soak]));
  sandwich->SetProp(P_LONG, lang);
  preis=sandwiches[wask];
  tp=TP;
  tp->AddMoney(-preis); 
  sandwich->move(tp, M_GIVE);
  write("Baher gibt Dir das bestellte "+CAP(sandwich->name(RAW))+".\n"+
	"Du gibst ihm die "+preis+" Muenzen.\n");
  say(tp->Name(WER)+"kauft sich ein Sandwich.\n",({tp}));
  DB("*** Who: "+CAP(getuid(tp))+"\n"+
     "*** What: "+was+"\n"+
     "*** Lang: "+lang+
     "*** Heal: "+heal+" Soak: "+soak+"\n");
  write_file(LOG"sandwiches",
	     dtime(time())+":\n"+
	     "*** "+CAP(getuid(tp))+" kauft ein "+was+
	     " mit Heal: "+heal+" Soak: "+soak+"\n"+
	     (args ? "*** Zutaten: "+implode(args,", ") : "")+"\n");
}

zutatenliste(string str)
{
  string *was,ret,tmp;
  int i;
  
  if(!str) was=m_indices(alles);
  switch(str)
    {
    case "fleisch":was=m_indices(fleisch);break;
    case "kaese":was=m_indices(kaese);break;
    case "gemuese":was=m_indices(gemuese);break;
    case "extra":was=m_indices(extra);break;
    case "alles":was=m_indices(alles);break;
    case "anderes":was=m_indices(anderes);break;
    default :was=m_indices(alles);
    }
  tmp="";
  ret=duplicate(" ",28)+"Zutatenliste\n"+
    duplicate(" ",26)+duplicate("=",16)+"\n\n";
  for(i=sizeof(was)-1;i>=0;i--)
    tmp+=sprintf("%s",CAP(was[i]))+(!i ?". ":", ");
  ret+=break_string(tmp,60);
  ret+="\nSyntax: zutaten [fleisch|kaese|gemuese|anderes|extra|alles]\n";
  TP->More(make_dokument(ret));
  return 1;
}

