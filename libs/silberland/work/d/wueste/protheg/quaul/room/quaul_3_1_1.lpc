waage()
{
  int i;
  string ret,ret2;
  
  ret="Auf der Waage liegt:\n";
  ret2="  ";
  for(i=m_sizeof(given)-1;i>=0;i--)
    if(given[valid_gems[i]]) ret2+=" "+CAP(valid_gems[i])+": "+
			       given[valid_gems[i]]+", ";
  if(ret2=="  ") ret2+="Nichts  ";
  return ret+ret2+"\b\b.\n";
}

makeitem(object ob, string str, string mat)
{
  string kurz,lang,*ids,typ;
  int ac,value,gen;
  mapping material;

  ob=clone_object(ARMOUR "schmuckstueck");
  str="perlenkette";
  mat="perle";

  value=PREIS(str)-(100+random(100));
  switch(str)
    {
    case "amulett": 
      kurz="Ein "+CAP(mat)+"amulett";
      lang="In Deinen Haenden haelst Du ein wunderschoenes "+CAP(mat)+
	"amulett. Helfgrimm der Schmied hat es fuer Dich angefertigt. "+
	"Es besteht aus einem goldenen Strang, in dem einige Edelsteine "+
	"kunstvoll eingefasst sind.\n";
      ids=({"amulett",mat+"amulett"});
      typ=AT_AMULET;
      gen=NEUTER;
      break;
    case "diadem":
      kurz="Ein "+CAP(mat)+"Diadem";
      lang="In Deinen Haenden haelst Du ein prachtvolles "+CAP(mat)+
	"diadem. Eine wahrlich meisterhafte Arbeit, die Helfgrimm da geleistet "+
	"hat. Es besteht aus einem feinen Goldgeflecht als Stuetzgeruest fuer "+
	"die zahlreichen kleinen Edelsteine. Du kannst es nicht erwarten, es "+
	"aufzusetzen.\n";
      ids=({"diadem",mat+"diadem"});
      typ=AT_HELMET;
      gen=NEUTER;
      break;
    case "armreifen":
      kurz="Zwei "+CAP(mat)+"armreifen";
      lang="In Deinem Besitz befindet sich ein wunderschoener, "+
	"handgefertigter "+CAP(mat)+"armreifen. Er ist aus massivem Gold "+
	"gefestigt und mit einigen funkelnden Edelsteinen besetzt. Ob er wohl "+
	"auf Deinen Arm passt?\n";
      ids=({"armreif","armreifen",mat+"armreifen"});
      typ=AT_BRACERS;
      gen=MALE;
      break;
    case "ring":
      kurz="Ein "+CAP(mat)+"ring";
      lang="In Deiner Hand liegt ein kleiner, aber sehr wertvoll aussehender "+
	CAP(mat)+"ring. Er besteht aus purem Gold mit einem aufgesetzten "+
	CAP(mat)+". Die Verzierungen an den Seiten lassen ihn geheimnissvoll "+
	"aussehen. Ob er an Deinen Finger passt?\n";
      ids=({"ring",mat+"ring"});
      typ=AT_RING;
      gen=MALE;
      break;
    case "halsband":
      kurz="Ein "+CAP(mat)+"halsband";
      lang="Du bewunderst ein prachtvolles, handgefertigtes "+CAP(mat)+
	"halsband. Viele kleine Edelsteine wurden kunstvoll, wie in einem "+
	"Mosaik in ein Band aus goldenen Faeden eingebettet Die anderen "+
	"werden Dich sicher ob seiner Schoenheit beneiden.\n";
      ids=({"halsband",mat+"halsband"});
      typ=AT_AMULET;
      gen=NEUTER;
      break;
    case "collier":
      kurz="Ein "+CAP(mat)+"collier";
      lang="Ein mit Edelsteinen besetztes Collier funkelt Dir entgegen. "+
	"Eine wahrlich meisterhafte Arbeit, die Du da besitzt! Viele kleine "+
	"Edelsteine liefern sich einen regelrechten Streit darum, wer von ihnen "+
	"am hellsten funkelt. Helfgrim der Schmied hat es angefertigt. So etwas "+
	"kostbares sieht man nicht alle Tage.\n";
      ids=({"collier",mat+"collier"});
      typ=AT_AMULET;
      gen=NEUTER;
      break;
    case "krone":
      kurz="Eine "+CAP(mat)+"krone";
      lang="In Deinen Haenden haelst Du eine "+CAP(mat)+"besetzte Krone, "+
	"die fuer Koenige gemacht zu sein scheint. Ein verstaerktes Geruest "+
	"aus purem Gold traegt eine Menge Edelsteine, die im Licht glitzen "+
	"und funkeln.\n";
      ids=({"krone",mat+"krone"});
      typ=AT_HELMET;
      gen=FEMALE;
      break;
    case "perlenkette":
      kurz="Eine Perlenkette";
      lang="Eine Perlenkette aus den wohl schoensten Perlen, die es im Silberland "+
	"zu finden gibt. Die Perlen wurden einzeln durchbohrt und auf eine feine, "+
	"goldene Schnur aufgefaedelt. Weiters wird die Kette von einem kleinen, "+
	"goldenen Schloesschen zusammengehalten.\n";
      ids=({"kette","perlenkette"});
      typ=AT_AMULET;
      gen=FEMALE;
    }
  
  material=MATERIALDB->String2Material(mat);
  ob->SetProp(P_ARMOUR_TYPE, typ);
  ob->SetProp(P_SHORT, kurz);
  ob->SetProp(P_LONG, lang);
  if(str=="perlenkette") ob->SetProp(P_NAME, CAP(str));
  else ob->SetProp(P_NAME, CAP(mat)+str);
  ob->SetProp(P_GENDER, gen);
  ob->AddId(ids);
  ob->SetProp(P_MATERIAL, ([ MAT_GOLD:60, material:40]));
  ob->SetProp(P_VALUE, value);
  if((ac=STD_AC(str)+GEM_AC(mat)+random(2))>VALID_ARMOUR_CLASS[typ])
    ac=VALID_ARMOUR_CLASS[typ];
  ob->SetProp(P_AC,ac);
  return ob;
}

abholen(string str)
{
  int i;
  object what;
  string n,auftrag;
  
  NIXSCHMIED;
  notify_fail("Was willst Du denn abholen?\n");
  if(!str) return 0;
  n=this_player()->query_real_name();
  if(!member(data,n))
    return write(SCHMIED+
		 " sagt: Ich habe von Dir keinen Auftrag bekommen!\n"),1;
  if(!member(angebote,explode(str," ")[0]))
    return write(SCHMIED+" sagt: So etwas fertige ich nicht an!\n"),1;
  notify_fail("Was willst Du denn abholen?\n");
  auftrag=data[n];
  if(auftrag[1]<=time())
    {
      what=clone_object(ARMOUR "schmuckstueck");
      what=makeitem(what, explode(str," ")[0], auftrag[2]);
      if((what->move(TP))==ME_TOO_HEAVY)
	what->move(MENV,M_NOCHECK);
      data-=([n]);
      save_object(SAVEFILE);
      return write(SCHMIED+" ueberreicht Dir feierlich Dein neues Schmuckstueck.\n"),1;
    }
  else 
    return write(SCHMIED+" sagt: Das ist noch nicht fertig.\n"),1;
  return 0;
}

t2s(int time)
{
  int d, h, m;
  string ret;

  ret="";
  d = time/86400;
  time%=86400;
  h = time/3600;
  time%=3600;
  m = time/60;
  if(d) ret+=time2string("%d %D ", d*86400);
  if(h) ret+=time2string("%h %H ", h*3600);
  if(m) ret+=time2string("%m %M", m*60);
  return ret;
}

bestellungen()
{
  int i,j;
  string ret,t;
  string *alle;
  mixed *what;
  
  NIXSCHMIED;
  alle=sort_array(m_indices(data),CLOSURE(<));
  ret="\n"+duplicate(" ",20)+"Derzeitige Bestellungen\n"+
    duplicate(" ",18)+duplicate("=",28)+"\n\n"+
    duplicate("-",70)+"\n";
  for(i=sizeof(alle)-1;i>=0;i--)
    {
      ret+=sprintf("%11s: ",CAP(alle[j]));
      what=data[alle[i]];
      t=what[1]<=time() ? "ab sofort" : "in "+t2s(what[1]-time());
      ret+=sprintf( "%"+(i==0?"":"13")+"s- %s, abzuholen %s\n", "",
		    CAP(what[0]),t);
      
    }
  ret+=duplicate("-",70)+"\n";
  return write(ret),1;
}

anfrage(string n)
{
  string ret;
  
  if(!data[n]) ret="Du hast ja gar keinen Auftrag bei mir!\n";
  else
    ret="D"+ARTIKEL(data[n][0])+" "+CAP(data[n][0])+" ist "+
      (data[n][1]<=time() ? "ab sofort" : "in "+ t2s(data[n][1]-time()))+
      " abzuholen.\n";
  return ret;
}
	     
input(string str)
{
  string what,edelstein;
  
  notify_fail("Syntax: lege <edelstein> auf Waage.\n");
  if(!str) return 0;
  if((sscanf(str,"%s auf waage",what)!=0)||
     (sscanf(str,"%s in waage",what)!=0))
    {
      if(member(valid_gems,what)==-1)
	return write("Das ist doch kein Edelstein!\n"),1;

      if(edelstein=present(what,TP))
	{
	  given[what]++;
	  edelstein->SetProp(P_AMOUNT, edelstein->QueryProp(P_AMOUNT)-1);
	  write("Du legst den "+CAP(what)+" auf die Waage.\n");
	  say(CAP(TPN)+" legt einen Edelstein auf eine Waage.\n");
	  return 1;
	}
      else
	return write("Aber das hast du doch gar nicht bei Dir!\n"),1;
    }
  return 0;
}

take_back(string str)
{
  string what,edelstein;
  
  notify_fail("Was willst Du denn nehmen?\n");
  if(!str) return 0;
  if((sscanf(str,"%s aus waage",what)!=0)||
     (sscanf(str,"%s von waage",what)!=0))
    {
      if(member(valid_gems,what)==-1)
	return write("Das ist doch kein Edelstein!\n"),1;

      if(given[what])
	{
	  given[what]--;
	  edelstein=clone_object("/obj/gems/"+what);
	  if((edelstein->move(TP))==ME_TOO_HEAVY)
	    {
	      edelstein->move(ME,M_NOCHECK);
	      return write("Der "+CAP(what)+" ist Dir zu schwer und faellt auf den Boden.\n"),1;
	    }
	  else
	    {
	      write("Du nimmst einen "+CAP(what)+" von der Waage.\n");
	      say(CAP(TPN)+" nimmt einen Edelstein von einer Waage.\n",TP);
	    }
	  return 1;
	}
      else
	return write("Aber das liegt doch gar nicht auf der Waage!\n"),1;
    }
  return 0;
}

bestelle(string what, string mat, string n)
{
  NIXSCHMIED;
  if(member(allowed,previous_object()->QueryProp(P_NAME))!=-1)
    data+=([n:({what, time()+BAUZEIT,mat})]);
  else 
    return 0;
  save_object(SAVEFILE);
  return 1;
}

reset()
{
  ::reset();
  call_out("checktisch",0);
}

checktisch()
{
  if(offen)
    say("Helgrimm sperrt seinen Verkaufstisch ab.\n");
  money=1000+random(2000);
  offen=0;
  leer=0;
}

oeffnen(string str)
{
  object wache,geld;
  notify_fail("Was willst Du denn oeffnen?\n");
  if(!str) return 0;
  if(str=="tisch"||str=="verkaufstisch")
    {
      if(leer) return write("Der Tisch ist schon geoffnet worden, da war wohl "+
			    "jemand schneller als Du!\n"),1;
      if(!offen) return write("Der Tisch scheint verschlossen zu sein, ob man den "+
			      "irgendwie aufsperren kann?\n"),1;
      write("RRRRRRRRIIIIIIIIIIINNNNNNNNNGGGGGGGGGGGG!!!!!!!!!!!!!!\n"+
	    "RRRRRRRRIIIIIIIIIIINNNNNNNNNGGGGGGGGGGGG!!!!!!!!!!!!!!\n"+
	    "RRRRRRRRIIIIIIIIIIINNNNNNNNNGGGGGGGGGGGG!!!!!!!!!!!!!!\n"+
	    "Die Alarmanlage rasselt los...\n");
      domainshout("Helfgrimm ruft: Zu Hilfe !!! "+CAP(TPN)+" raubt mich aus!!\n");
      if(present("helfgrimm"))
	{
	  write("Helfgrimm tritt energisch zwischen Dich und den Verkaufstisch. "+
		"Er fuchtelt wild mit seinen Faeusten vor Deiner Nase herum "+
		"und murmelt unverstaendliches. Danach dreht er sich um "+
		"und verschliest den Tisch wieder.\n"+
		"Du stehst noch immer wie angewurzelt da. Dein Herz pocht "+
		"wie wild und der Angstschweiss steht Dir auf der Stirn.\n");
	  offen=0;
	}
      else
	if(wache=present("\nwache"))
	  {
	    write("Die Wache hat Dich bei einem versuchten Diebstahl erwischt!!!\n");
	    wache->Kill(TP);
	    // oder abfuehren ins jail!
	  }
	else
	  {
	    write("Du oeffnest den Verkaufstisch und findest einige Muenzen...\n"+
		  "Als Du danach greifen willst, faellt die Schublade heraus "+
		  "und das Geld liegt auf dem Boden...\n");
	    geld=clone_object("/obj/money");
	    geld->SetProp(P_AMOUNT, money);
	    geld->move(ME,M_NOCHECK);
	    leer=1;
	  }
      return 1;
    }
  return 0;
}

drehen(string str)
{
  if(str=="schluessel"||str=="schluessel um")
    {
      if(offen) return write("Der Tisch ist bereits offen!\n"),1;
      write("Ein leises Klicken ertoent, ob man den Verkaufstisch nun oeffnen "+
	    "kann?\n");
      offen=1;
      return 1;
    }
  return 0;
}      

schieben(string str)
{
  notify_fail("Was willst du denn beiseiteschieben?\n");
  if(!str) return 0;
  if(str=="vorhang weg"||str=="vorhang beiseite")
    {
      write("Du schiebst den Vorhang etwas beiseite und ein heisser Luftschwall "+
	    "schlaegt Dir ins Gesicht. Hier ist die Schmiede. Sie ist dunkel und "+
	    "heiss, daher beschliesst Du lieber im kuehleren Verkaufsraum zu "+
	    "bleiben...\n");
      say(CAP(TPN)+" will durch einen Vorhang gehen, laesst es dann aber.\n");
      return 1;
    }
  return 0;
}

fuehlen(string str)
{
  notify_fail("Was willst Du denn fuehlen?\n");
  if(!str) return 0;
  if(str=="waerme")
    {
      write("Du denkst . o O (Ist ganz schoen warm!)\n"+
	    "Deine Haare beginnen sich zu kraeuseln und kleine "+
	    "Dampfwoelkchen steigen auf.\n");
      say(CAP(TP->name(WESSEN,0))+" Haare beginnen sich ploetzlich zu "+
	  "kraeuseln und kleine Dampfwoelckchen steigen auf.\n", TP);
      TP->reduce_hit_point(5);
      return 1;
    }
  return 0;
}
