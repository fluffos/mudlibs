#include "../def.h"
inherit MOST "std_room";

#include <properties.h>
#include <armour.h>
#include ROOM "gschmiede.h"

#define SAVEFILE LOG "schmied_save"
#define SCHMIED "Helfgrimm" 
#define GEM_AC(x) gems[x,0]
#define NIXSCHMIED if(!present(lower_case(SCHMIED))) \
                   return write(SCHMIED+" scheint nicht da zu sein!\n"),1

nosave int leer,offen,money;
nosave string *allowed=({SCHMIED});

mapping data;

nosave mapping gems=([
		      "amethyst":1, "aquamarin":2, "bergkristall":1, "bernstein":2,
		      "diamant":5, "granat":1, "lapislazuli":2, "onyx":2, "opal":2, 
		      "rubin":4, "saphir":4, "smaragd":4, "topas":2, "turmalin":2,
		      "zirkon":3 ]);

nosave string *valid_gems=m_indices(gems);

nosave mapping given=([
		       "amethyst":0, "aquamarin":0, "bergkristall":0, "bernstein":0,
		       "diamant":0, "granat":0, "lapislazuli":0, "onyx":0, "opal":0,
		       "rubin":0, "saphir":0, "smaragd":0, "topas":0, "turmalin":0,
		       "zirkon":0 ]);

