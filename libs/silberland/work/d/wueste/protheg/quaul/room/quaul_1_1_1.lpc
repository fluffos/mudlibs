/*
  Billah by PROtheG
  Unbenannt in "Troedler Abraham"
  */

#include <properties.h>
#include <laden.h>
#include "../def.h"

inherit "std/laden";
inherit MOST "std_room";

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Beim Troedler Abraham");
  SetProp(P_INT_LONG, 
	  "Du stehst in einem recht kleinen, sterilen Kramladen, der irgendwie anders aussieht, "+
	  "als die, die Du bisher gesehn hast. Nirgends kannst Du auch nur das kleinste "+
	  "Staubkoernchen entdecken, so sauber ist es hier. Anscheinend hat der Haendler "+
	  "nicht sonderlich viel zu tun und arbeitet daher ausschliesslich an seinem Laden.\n");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER |  SHOP_NEEDSKEEPER); 
  SetProp(P_SHOPKEEPER_ID, "abraham");
  SetProp(P_SHOPKEEPER_NAME, "Abraham");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail(({"kramladen","laden"}), 
	    "Ein kleiner suesser Laden mit allerlei mehr, oder minder nuetzlichem Zeugs, "+
	    "einer grossen Registrierkasse und jede Menge Regalen an den Waenden.\n");
  AddDetail(({"sachen","zeug","zeugs","menge"}), 
	    "Mit <zeige> wird Dir Abraham sicher alles zeigen.\n"); 
  AddDetail(({"regal", "regale"}),
	    "Die Regale sind ziemlich voll mit allerlei undefinierbarem Zeugs.\n");
  AddDetail(({"kasse","registrierkasse"}),
	    "Eine grosse, alte Registrierkasse steht hier herum.\n");
  AddDetail("wand", 
	    "An einer Wand haengt ein Schild.\n");
  AddDetail("schild", 
	    "Du kannst es lesen.\n");
  AddDetail("tafel", 
	    "Du kannst sie lesen.\n");
  AddDetail("lampen",
	    "Hier stehen 6 Lampen herum, die den Laden ausleuchten sollen.");
  AddDetail("waende",
	    "Die Waende sind voll von Regalen, die bis obenhin vollgestopft "+
	    "sind. An einer Wand faellt Dir etwas auf.");
  AddDetail("boden",
	    "Der Boden ist mit ganz normalen Holzdielen ausgelegt, die beim Gehen knarren.\n");
  AddDetail("decke",
	    "Die Decke ist leicht angeschwaerzt von den vielen herumstehenden Lampen.");
  AddDetail("gehen",
	    "KNARR!! IIEK!! KNARR!! IIEK!!");
  AddDetail(({"dielen","holzdielen"}),
	    "Das wird wahrscheinlich das naechste sein, was Abraham reparieren wird.");
  AddDetail(({"koernchen","staubkoernchen"}),
	    "Die einzigen Staubkoernchen, sind die, die Du von Draussen mitgebracht hast!");
  AddDetail("draussen",
	    "Draussen ist es Dir zu hektisch, Du beschliesst noch eine Weile hier zu bleiben.");
  AddDetail("weile",
	    "Na einen bestimmten Zeitabschnitt!");
  AddDetail(({"zeitabschnitt","abschnitt"}),
	    "Je laenger du wartest, desto laenger wird er!");
  AddReadDetail("schild", 
		"Auf dem Schild steht: Bitte nichts aus den Regalen nehmen! Einsturzgefahr!\n");
  AddReadDetail("tafel",
		"\nAlles auf einen Blick:\n\n"+
		"<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
		"<unt> nummer      Gibt eine Beschreibung eines Gegenstands "+
		"der Liste aus\n"+
		"<kaufe> nummer    oder\n"+
		"<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
		"<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei"+
		" Dir hast.\n"+
		"<versetze> etwas  Du verkaufst einen Gegenstand, egal "+
		"wieviel der\n                  Haendler dafuer bezahlt.\n"+
		"<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm dein "+
		"Gegenstand\n                  wert waere, wenn Du ihn verkaufen "+
		"wuerdest.\n\n");
  
  set_light("hell");
  set_temp("heiss");
  set_exits("quaul");

  SetStorageRoom(ROOM "tlager");
  AddItem(NPC "abraham" ,REFRESH_DESTRUCT);
  RemoveItem("/obj/entsorg");
}
