/*
  Kreatersee suedlicher Teil
*/

#include <properties.h>
#include "../def.h"

#define TRINKEN 10

inherit MOST "std_room";
inherit ROOM "see";

int kuebel_voll, kuebel_hinauf, kuebel_hinab, kuebel_unten, wasser;

create()
{
  ::create();
  SetProp(P_INT_SHORT,"An einem glitzernden Kratersee");
  SetProp(P_INT_LONG, 
	  "Quauls Kratersee! Ist er nicht herrlich? Du brauchst nur ein Weilchen in das "+
	  "Wasser zu blicken und fuehlst Dich total entspannt. Scheinbar haben das auch "+
	  "andere Leute vor Dir entdeckt und so wimmelt es hier vor Leuten die sich hier "+
	  "entspannen wollen, oder zu ihren Goettern beten.\n"+
	  "Ein kleiner Steinbrunnen scheint sich inmitten der Leute zu befinden.\n"+
	  "Nach Nordwesten, oder nach Nordosten kannst du am Ufer entlangspazieren.\n"+
	  "Den Hang hinauf kommst Du zurueck in den Stadtteil.\n");

  AddDetail(({"sand","wuestensand","boden"}),
	    "Der Sand ist ueber und ueber mit Decken verdeckt, die von den betenden Leuten "+
	    "ausgebreitet wurden, damit sie sich nicht die Fuesse verbrennen.\n");
  AddDetail(({"fuss","fuesse"}),
	    "Verbrenn Dir bloss nicht die Fuesse im heissen Sand!\n");
  AddDetail(({"himmel","rand","krater"}),
	    "Hoch ueber Dir engt der Kraterrand den Himmel bis auf eine kleine, blaue "+
	    "Scheibe ein.\n");
  AddDetail("scheibe",
	    "Die kleine, blaue Scheibe ueber Dir ist der Himmel.\n");
  AddDetail(({"kraterrand","rand"}),
	    "Hoch ueber Dir erkennst Du den kreisrunden Kraterrand von Quaul.\n");
  AddDetail(({"sueden","hang"}),
	    "Nach Sueden fuehrt der Hang hinauf zurueck in den belebten Stadtteil.\n");
  AddDetail(({"see","kratersee"}),
	    "Ein wunderschoener, kleiner Kratersee breitet sich nach Norden hin aus.\n");
  AddDetail(({"norden","mitte","seemitte","kraterseemitte"}),
	    "Im Norden, schon fast in der Seemitte kannst Du eine Statue erkennen.\n");
  AddDetail("stadtteil",
	    "Weiter oben, den Hang hinauf fuehrt der Weg zurueck in den belebteren "+
	    "Stadtteil von Quaul.\n");
  AddDetail(({"stimmung","weilchen"}),
	    "Verweile doch ein Weilchen und lass Dich von der angenehmen Stimmung hier "+
	    "verwoehnen...\n");
  AddDetail(({"seewasser","wasser"}),
	    "Kristallklares Seewasser fuellt diesen Kratersee. Das Licht, das sich in "+
	    "seinen kleinen Wellen spiegelt, uebt eine beruhigende, fast schon magische "+
	    "Wirkung auf Dich aus. Scheinbar nicht nur auf Dich, denn rund um Dich herum "+
	    "befinden sich viele Lebewesen aus nahen und fernen Laendern um hier zu ihren "+
	    "Goettern zu beten.\n");
  AddDetail(({"licht","sonnenlicht"}),
	    "Das Sonnenlicht spiegelt sich in den kleinen Wellen des Seewassers und glitzert "+
	    "vor sich hin.\n");
  AddDetail(({"wirkung","wellen"}),
	    "Du laesst die Wellen auf Dich wirken...\n"+
	    "Du fuehlst Dich ploetzlich viel entspannter.\n");
  AddDetail(({"nordosten","nordwesten"}),
	    "Nach Nordwesten, oder nach Nordosten breitet sich das Ufer des Kratersees aus.\n");
  AddDetail(({"weg","ufer"}),
	    "Ein schmaler Weg fuehrt das Ufer entlang zwischen den beetenden Leuten hindurch.\n");
  AddDetail(({"stadt","quaul"}),
	    "Du stehst hier mitten in der Stadt Quaul!\n");
  AddDetail(({"lebewesen","leute","wesen","pilger"}),
	    "Ueberall rund um Dich herum haben sich Pilger aus allerlei Laendern auf ihren "+
	    "Decken versammelt, um zu meditieren, oder zu ihren Goettern zu beten.\n");
  AddDetail("laender",
	    "Aus allen Laendern reisen die Leute an, um hier zu beten.\n");
  AddDetail("decken",
	    "Das gesamte Ufer ist mit Decken zugepflastert. Alle sind voll mit allerlei Leuten "+
	    "die hier beten.\n");
  AddDetail("decke",
	    "NEIN! Es ist keine Decke mehr frei fuer Dich!\n");
  AddDetail("goetter",
	    "Viele Goetter gibt es hier im Silberland! Doch nur zwei von ihnen duerfen "+
	    "herrschen: Woody und Dusty!\n");
  AddDetail(({"woody","dusty","silberland"}),
	    "Woody und Dusty sind die zwei Goetter, die hier im Silberland herrschen!\n");
  AddDetail("statue",
	    "Mitten im See steht eine Statue. Es scheint ein Springbrunnen zu sein, doch mehr "+
	    "kannst Du von hier aus leider nicht erkennen.\n");
  AddDetail(({"springbrunnen"}),
	    "In der Mitte des Kratersees befindet sich eine Statue, die als Springbrunnen dient. "+
	    "Aus den Haenden der Statue sprudelt scheinbar rotes Wasser (oder war es Blut?) in "+
	    "den See hinein...\n");
  AddDetail(({"rotes wasser","blut"}),
	    "Ist das wirklich Blut, oder doch nur rotes Wasser?!\n");
  AddDetail(({"hand","haende"}),
	    "Aus den Haenden scheint rotes Wasser zu sprudeln...\n");
  AddDetail("brunnen",
	    "Welchen Brunnen meinst Du denn?\n");
  AddDetail("steinbrunnen",
	    "Inmitten der Pilger entdeckst Du einen kleinen, alten Brunnen aus Steinen mit "+
	    "einem hoelzernen Aufbau.\n");
  AddDetail(({"quader","granitquader","stein","steine"}),
	    "Lauter kleine Granitquader wurden fuer diesen Steinbrunnen verwendet.\n");
  AddDetail(({"aufbau","holzaufbau"}),
	    "Der hoelzerne Aufbau haelt den Kuebel, der an einem Seil haengt. An der Seite "+
	    "ist eine Kurbel befestigt, mit der man den Kuebel hinablassen und wieder "+
	    "hinaufziehen kann.\n");
  AddDetail("seite",
	    "An der Seite des hoelzernen Aufbaus ist eine Kurbel angebracht.\n");
  AddDetail("seil",
	    "Das Seil ist teilweise auf der Kurbel aufgerollt, oder haengt in den Brunnen "+
	    "hinab, wo der Kuebel befestigt ist.\n");
  AddDetail("kurbel",
	    "Mit ihr kann man den Kuebel hinablassen und wieder hinaufziehen.\n");

  AddSound(DEFAULT_SOUND, "Das Murmeln der Gebete wird nur noch vom Plaetschern des "+
	   "Springbrunnens in der Seemitte uebertroffen.\n");
  AddSound(({"gebete","gebet"}),
	   "Unterstehe Dich, fremden Gebeten zuzuhoeren!\n");
  AddSound("plaetschern",
	   "*plaetscher* *plaetscher*\n");
  AddSound("murmeln",
	   "Die Leute hier meditieren und beten zu ihren Goettern. Doch bei sovielen "+
	   "Leuten vermischt sich alles zu einem einheitlichen Murmeln.\n");

  AddSmell(({DEFAULT_SMELL,"sand","wuestensand"}),
	   "Es riecht nach heissem Wuestensand!\n");

  AddSpecialDetail("kuebel","kuebel");

  AddExit("nordwesten", "das Ufer entlang nach Nordwesten#"+ROOM "quaul_2_1_0");
  AddExit("nordosten", "das Ufer entlang nach Nordosten#"+ROOM "quaul_2_3_0");

  set_light("hell");
  set_temp("heiss");
  set_exits("quaul");

  see_commands();

  AddCmd(({"lasse","lass"}), "hinablassen");
  AddCmd(({"ziehe","zieh"}), "hinaufziehen");
  AddCmd(({"trinke","trink"}), "trinken");
}

/*
  reset()
  {
  ::reset();
  SetWasser(2+random(5));
  }
*/

kuebel()
{
  if(kuebel_hinab)
    return "Der Kuebel wird gerade hinabgelassen.\n";
  if(kuebel_hinauf)
    return "Der Kuebel wird gerade hinaufgezogen.\n";
  if(kuebel_voll)
    return "Der Kuebel ist mit Wasser gefuellt. Ob man es trinken kann?\n";
  
  return "Ein leerer Kuebel baumelt am Seil.\n";
}

hinablassen(string str)
{
  notify_fail("Was willst Du denn hinablassen?\n");
  if(!str) return 0;

  if(str=="kuebel hinab"||str=="wasserkuebel hinab"||str=="leeren kuebel hinab"||
     str=="leeren wasserkuebel hinab")
    {
      if(kuebel_hinab)
	return write("Aber der Kuebel wird doch bereits hinabgelassen!\n"),1;
      if(kuebel_hinauf)
	return write("Aber der Kuebel wird doch gerade hinaufgezogen!\n"),1;
      if(kuebel_unten)
	return write("Aber der Kuebel ist doch schon unten!\n"),1;

      write("Du drehst an der Kurbel und laesst den Kuebel hinab.\n");
      say(CAP(getuid(TP))+" dreht an der Kurbel und laesst somit den Kuebel hinab.\n", ({TP}));
      call_out("unten", 6);
      kuebel_hinab=1;
      kuebel_unten=kuebel_hinauf=kuebel_voll=0;
      return 1;
    }
  return 0;
}

unten()
{
  if(wasser)
    {
      tell_room(TO, "Der Kuebel platscht unten ins Wasser und fuellt sich.\n");
      kuebel_unten=kuebel_voll=1;
      kuebel_hinab=kuebel_hinauf=0;
      wasser--;
    }
  else
    {
      tell_room(TO, "* KLONK *\nDer Kuebel schlaegt unten hart auf!\n");
      kuebel_unten=0;
      kuebel_hinab=kuebel_hinauf=kuebel_voll=0;
    }
}

hinaufziehen(string str)
{
  notify_fail("Was willst Du denn hinaufziehen?\n");
  if(!str) return 0;

  if(str=="kuebel hinauf"||str=="wasserkuebel hinauf"||str=="vollen kuebel hinauf"||
     str=="vollen wasserkuebel hinauf")
    {
      if(kuebel_hinab)
	return write("Aber der Kuebel wird doch gerade hinabgelassen!\n"),1;
      if(kuebel_hinauf)
	return write("Aber der Kuebel wird doch bereits hinaufgezogen!\n"),1;
      if(!kuebel_unten)
	return write("Aber der Kuebel ist doch gar nicht unten!\n"),1;

      write("Du drehst an der Kurbel und ziehst somit den Kuebel hinauf.\n");
      say(CAP(getuid(TP))+" dreht an der Kurbel und zieht somit den Kuebel hinauf.\n", ({TP}));
      call_out("oben", 8);
      kuebel_hinauf=1;
      kuebel_unten=kuebel_hinab=0;
      return 1;
    }

  return 0;
}

oben()
{
  tell_room(TO, "Der Kuebel ist jetzt oben und die Kurbel rastet ein.\n");
  kuebel_hinab=kuebel_hinauf=kuebel_unten=0;
}

trinken(string str)
{
  object tp;

  notify_fail("Woraus willst Du denn trinken?\n");
  if(!str) return 0;

  if(str=="aus kuebel"||str=="aus wasserkuebel"||str=="kuebel"||str=="wasserkuebel"||
     str=="aus vollem kuebel"||str=="aus vollem wasserkuebel"||str=="vollen kuebel"||
     str=="vollen wasserkuebel")
    {
      if(kuebel_hinab)
	return write("Aber der Kuebel wird doch gerade hinabgelassen.\nGedulde Dich!\n"),1;
      if(kuebel_hinauf)
	return write("Aber der Kuebel wird doch gerade hinaufgezogen.\nGedulde Dich!\n"),1;
      if(kuebel_unten)
	return write("Aber der Kuebel ist doch gerade unten im Brunnen.\nGedulde Dich!\n"),1;
      if(!kuebel_voll)
	return notify_fail("Aber da ist doch gar kein Wasser im Kuebel! Was willst Du denn da trinken?\n");
      tp=TP;
      if((tp->QueryProp(P_DRINK)+TRINKEN)> tp->QueryProp(P_MAX_DRINK))
	return write("Du bist schon fast voll, deswegen laesst das Wasser lieber fuer Andere.\n"),1;
      write("Du nimmst einen kraeftigen Schluck von dem Wasser und fuehlst Dich viel besser!\n");
      say(CAP(getuid(tp))+" nimmt einen kraeftigen Schluck aus dem Kuebel.\n", ({tp}));
      tp->heal_self(30+random(10));
      tp->SetProp(P_DRINK, tp->QueryProp(P_DRINK)+TRINKEN);
      kuebel_hinab=kuebel_hinauf=kuebel_unten=kuebel_voll=0;
      return 1;
    }
  return 0;
}

SetWasser(int i)
{
  wasser=i;
}

QueryWasser(int i)
{
  return wasser;
}
