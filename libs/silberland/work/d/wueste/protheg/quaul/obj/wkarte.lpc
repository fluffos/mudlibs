/*

  Die grosse Wuestenkarte ist in 4 Teilgebiete aufgeteilt

  Man sieht jeweils nur den definierten Teil 

*/

#include "../def.h"
#include "../karten.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define SICHTBAR 1

nosave int last;

nosave where()
{
  switch(SICHTBAR)
    {
    case 1: return "Du befindest dich im nordwestlichen Teil der Wueste.\n";
      break;
    case 2: return "Du befindest dich im suedwestlichen Teil der Wueste.\n";
      break;
    case 3: return "Du befindest dich im nordoestlichen Teil der Wueste.\n";
      break;
    case 4: return "Du befindest dich im suedoestlichen Teil der Wueste.\n";
      break;
    }
  return "";
}

nosave get_ausschnitt()
{
  string ret;

  if(!TP) return "";
  
  if(last>time())
    return BS("Du versuchst die Karte auf der Tafel zu lesen, doch sie scheint sich gerade "+
	      "zu veraendern.");
  last=time()+4;

  ret="Du liest die Karte auf der Tafel:\n"+KARTENMASTER->Ausschnitt(SICHTBAR, getuid(TP))+"\n";
  TP->More(ret);
  return "";
}

create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine grosse Holztafel");
  SetProp(P_LONG,
	  BS("Eine grosse, hoelzerne Tafel wurde hier aufgestellt. Sie stellt "
	     "einen Teil der Wueste dar. Meisst den Teil, indem Du Dich gerade "
	     "befindest."));
  SetProp(P_NAME, "Holztafel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"holztafel","tafel"}));
  
  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_WEIGHT, 9010);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Die Tafel ist fest im Boden verankert!\n");
  
  AddDetail(({"wueste","teil"}), CLOSURE(where));
  
  AddDetail("karte",
	    "Sie stellt den Teil der Wueste dar, indem Du Dich befindest.\n");
  AddReadDetail(({"tafel","karte"}), CLOSURE(get_ausschnitt));
}
