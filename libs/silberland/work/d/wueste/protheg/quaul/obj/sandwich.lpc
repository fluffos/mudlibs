inherit "/std/food";

#include "../def.h"
#include <properties.h>
#include <food.h>
#define MAX_FRESHNESS 4

int freshness;

create()
{
  if(!is_clone(ME)) return;

  ::create();

  SetProp(P_SHORT, "Ein Sandwich");
  SetProp(P_LONG, "Ein herzhaftes Sandwich, du moechtest am "+
	  "liebsten gleich hineinbeissen...\n");
  SetProp(P_NAME, "Sandwich");
  AddId("sandwich");
  SetProp(P_INFO, "Es ist noch ganz frisch!\n");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 200);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MATERIAL, ({MAT_MISC_FOOD}));
  freshness=MAX_FRESHNESS;
  SetProp (P_FOOD_INFO, 
	   ([ 
	     F_HEAL     : ({10,0}),
	     F_SOAK     : 10,
	     F_MSG      : "Mit einem grossen Biss mampfst Du das Sandwich in "+
	     "Dich hinein...",
	     F_MSG_ROOM : "verschlingt ein Sandwich in einem Bissen."]));
}

reset()
{
  ::reset();
  if(freshness) 
    check_freshness();
}

check_freshness()
{
  int heal,soak;

  freshness--;
  heal=QueryProp(P_FOOD_INFO)[F_HEAL][0];
  soak=QueryProp(P_FOOD_INFO)[F_SOAK];
  switch(freshness)
    {
      case 1: SetProp(P_FOOD_INFO,
		      ([ 
			F_HEAL: ({0,0}),
			F_SOAK: soak+soak/3,
			F_MSG : "Mit einem grossen Biss mampfst Du das "+
			"Sandwich in Dich hinein, aber es war wohl nicht "+
			"mehr so frisch...",
			F_MSG_ROOM: "verschlingt ein altes Sandwich in einem "+
			"Bissen."]));
      SetProp(P_INFO,"Es ist nicht mehr frisch!!\n");
      break;
      default: SetProp(P_FOOD_INFO,
		       ([ 
			 F_HEAL: ({heal-heal/3,0}),
			 F_SOAK: soak+soak/3,
			 F_MSG : "Mit einem grossen Biss mampfst Du das "+
			 "Sandwich in Dich hinein...",
			 F_MSG_ROOM: "verschlingt ein Sandwich in einem "+
			 "Bissen."]));
      SetProp(P_INFO,"Es ist nichtmehr ganz frisch.\n");
    }
}





