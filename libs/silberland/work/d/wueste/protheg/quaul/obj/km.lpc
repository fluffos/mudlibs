/*
  Die grosse Wuestenkarte
  Ist in 4 Teilgebiete aufgeteilt
  Master, zustaendig fuer die Karte
  +---+---+
  | 1 | 3 |
  +---+---+
  | 2 | 4 |
  +---+---+
  
*/

#include "../def.h"
#include "../karten.h"

inherit MOST "std_things";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#define MASTERLOG LOG "karten_master/"

#define ERGWEG      "ergweg"
#define EFRIEDHOF   "efriedhof"
#define KARAVANEN_1 "karavanen1"
#define KARAVANEN_2 "karavanen2"
#define KARAVANEN_3 "karavanen3"
#define KRATER      "krater"
#define ARRAKEEN    "arrakeen"
#define FLUSSBETT   "flussbett"
#define HAFENWEG    "hafenweg"
#define HAFEN       "hafen"
#define SANDBURGWEG "sandburgweg"
#define SANDBURG    "sandburg"
#define NOMADEN     "nomaden"
#define LTURM       "lturm"

#define ALLES ({ERGWEG,EFRIEDHOF,KARAVANEN_1,KARAVANEN_2,KARAVANEN_3, \
                KRATER,ARRAKEEN,FLUSSBETT,HAFENWEG,HAFEN,SANDBURGWEG, \
                SANDBURG,NOMADEN,LTURM})

nosave string *karte;
nosave string lastp,lastk,lasta;
string *places;

create() 
{
  if(is_clone(TO)) return;

  SUID;

  karte=explode(read_file(OBJ "wuesteleer"), "\n");
}

PlaceFound(string who, string what)
{
  object pl;

  who=lower_case(who);
  what=lower_case(what);

  places=({});

  if(PO && pl=find_player(who))
    if(ENV(pl) && ENV(pl)==PO)
      if(strstr(file_name(PO), "/d/wueste/", 0)>=0)
	{
	  if(IS_WIZARD(pl)) return 0;
	  
	  if(member(ALLES, what)==-1) return -2; //ham wer ueberhaupt net;

	  restore_object(MASTERLOG + who);

	  if(member(places, what)>=0) return 2; //ham wer schon;
	  
	  places+=({what});
	  
	  save_object(MASTERLOG + who);
	  
	  places=({});
	  
	  return 1;
	}
      else 
	return -1; // gibts net, mag ma net
}

nosave format_karte(string *k)
{
  int i;

  for(i=sizeof(k)-1;i>=0;i--) k[i]="|"+k[i]+"|";

  k=({"+"+duplicate("-",70)+"+"})+k+({"+"+duplicate("-",70)+"+"});
  
  return implode(k, "\n");
}

varargs Ausschnitt(int teil, string player)
{
  object pl;
  string *as;
  int i;

  as=({});

  places=({});
  
  //  player="protheg";

  if(!stringp(player)) return -1;

  if((player==lastp) && (teil==lasta))
    return lastk;
  
  if(pl=find_player(player))
    if(IS_WIZARD(pl))
      places=ALLES;
    else
      restore_object(MASTERLOG + player);

  switch(teil)
    {
    case 1:  
      for(i=0;i<=24;i++)  as+=({karte[i][ 0 ..  69]}); 
      
      if(member(places, EFRIEDHOF)>-1)
	{
	  as[8][18..18]="E";
	}
      
      if(member(places, ERGWEG)>-1)
	{
	  as[10][ 9.. 9]="w"; as[11][ 8.. 8]="w"; as[12][ 9.. 9]="w"; as[12][10..10]="w";
	  as[13][11..11]="w";
	} 

      if(member(places, KARAVANEN_1)>-1)
	{
	  as[14][12..12]="k"; as[15][11..11]="k"; as[16][12..12]="k"; as[17][13..13]="k";
	  as[18][14..14]="k"; as[19][14..14]="k"; as[20][15..15]="k"; as[21][16..16]="k";
	  as[22][16..16]="k"; as[23][17..17]="k"; as[24][17..17]="k";	  
	} 

      if(member(places, KARAVANEN_3)>-1)
	{
	  as[14][12..13]="kk";        as[15][14..14]="k";     as[16][15..18]="kkkk";
	  as[15][19..21]="kkk";       as[14][22..25]="kkkk";  as[15][26..29]="kkkk"; 
	  as[14][30..38]="kkkkkkkkk"; as[15][39..39]="k";     as[15][40..45]="kkkkkk"; 
	  as[14][46..46]="k";         as[13][47..48]="kk";    as[14][49..50]="kk"; 
	  as[15][51..54]="kkkk";      as[16][55..59]="kkkkk"; as[15][60..64]="kkkkk";
	  as[16][65..69]="kkkkk"; 
	} 
      
      break;

    case 2:  for(i=25;i<=49;i++) as+=({karte[i][ 0 ..  69]}); 

      if(member(places, KARAVANEN_1)>-1)
	{
	  as[ 0][18..19]="kk";    as[ 1][20..22]="kkk";  as[ 2][23..25]="kkk"; 
	  as[ 3][26..26]="k";     as[ 4][27..28]="kk";   as[ 3][29..30]="kk";
	  as[ 4][31..33]="kkk";   as[ 5][34..36]="kkk";  as[ 6][37..40]="kkkk"; 
	  as[ 7][41..45]="kkkkk"; as[ 8][46..49]="kkkk"; as[ 9][50..50]="k"; 
	  as[10][50..50]="k";     as[11][51..51]="k";    as[12][51..51]="k"; 
	  as[13][52..54]="kkk";   as[12][55..57]="kkk";  as[11][58..59]="kk";
	  as[12][60..62]="kkk";   as[11][63..64]="kk";   as[10][65..65]="k";
	}

      if(member(places, KARAVANEN_2)>-1)
	{
	  as[10][65..65]="k";   as[ 9][64..64]="k"; as[ 8][63..63]="k";
	  as[ 7][63..63]="k";   as[ 6][64..64]="k"; as[ 5][65..66]="kk";
	  as[ 4][67..69]="kkk"; 
	}

      if(member(places, HAFENWEG)>-1)
	{
	  as[12][65..65]="w"; as[13][64..64]="w"; as[14][63..63]="w"; 
	  as[15][63..63]="w"; as[16][63..63]="w"; as[17][64..66]="www";
	  as[18][67..67]="w"; as[19][67..67]="w"; as[20][68..68]="w";
	  as[21][68..68]="w";
	}

      if(member(places, HAFEN)>-1)
	{
	  as[22][68..68]="H"; as[23][68..68]="S";
	}

      if(member(places, KRATER)>-1)
	{
	  as[ 8][66..68]="###";  as[ 9][65..69]="#####";
	  as[10][66..69]="####"; as[11][65..69]="#####";
	  as[12][66..68]="###";
	}

      break;

    case 3:  for(i=0;i<=24;i++)  as+=({karte[i][70 .. 139]}); 

      if(member(places, KARAVANEN_3)>-1)
	{
	  as[18][ 0.. 3]="kkkk"; as[17][ 4.. 4]="k"; as[16][ 4.. 4]="k"; 
	  as[15][ 5.. 7]="kkk"; as[14][ 8..11]="kkkk"; as[15][12..12]="k"; 
	  as[16][12..12]="k"; as[17][13..13]="k"; as[18][14..14]="k"; 	  
	}      

      if(member(places, KARAVANEN_2)>-1)
	{
	  as[18][14..14]="k"; as[19][11..13]="kkk"; as[18][ 9..10]="kk"; 
	  as[19][ 8.. 8]="k"; as[20][ 8.. 8]="k";   as[21][ 7.. 7]="k"; 
	  as[22][ 6.. 6]="k"; as[23][ 6.. 6]="k";   as[24][ 6.. 6]="k";
	}      

      if(member(places, ARRAKEEN)>-1)
	{
	  as[15][16..23]="########"; as[16][16..23]="########";
	  as[17][16..23]="########"; as[18][15..23]="#########";
	  as[19][16..23]="########"; as[20][16..23]="########";
	  as[21][16..23]="########";	  
	}

      if(member(places, FLUSSBETT)>-1)
	{
	  as[18][11..13]="www"; as[19][10..10]="w"; as[20][11..11]="w";
	  as[21][11..11]="w";   as[22][11..11]="w"; as[23][12..12]="w";
	  as[24][13..13]="w";
	}

      break;

    case 4:  for(i=25;i<=49;i++) as+=({karte[i][70 .. 139]}); 

      if(member(places, FLUSSBETT)>-1)
	{
	  as[0][14..14]="w"; as[1][14..14]="w";
	}

      if(member(places, KARAVANEN_2)>-1)
	{
	  as[0][ 5.. 5]="k"; as[1][ 4.. 4]="k"; as[2][ 1.. 3]="kkk"; 
	  as[3][ 0.. 0]="k"; as[4][ 0.. 0]="k";
	}

      if(member(places, SANDBURG)>-1)
	{
	  as[12][51..57]="#######"; as[13][51..57]="#######";
	  as[14][51..57]="#######"; as[15][51..57]="#######";
	  as[16][51..57]="#######"; as[17][51..57]="#######";
	  as[18][51..57]="#######"; 
	}

      if(member(places, SANDBURGWEG)>-1)
	{
	  as[11][54..54]="w";  as[10][54..54]="w";
	  as[ 9][52..53]="ww"; as[ 8][51..51]="w";
	  as[ 7][51..51]="w";
	}
      
      if(member(places, LTURM)>-1)
	{
	  as[22][62..62]="L"; as[23][62..62]="S";	  
	}

    }

  places=({});

  lastp=player;
  lasta=teil;
  lastk=format_karte(as);
		  
  return lastk;
}

