/*
  Die Flasche eines Djiins Beim Tod entsteht ein NPC der einen Teil 
  der Ausruestung des Spielers hat
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

nosave string player,col;

#define STANDARDCORPSE "/std/corpse"
#define DJIIN NPC "djiin"

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  col=({"rot","blau","gruen","gelb"})[random(4)];

  SetProp(P_SHORT, "Die "+col+"e Flasche eines Djiins");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du die "+col+"e Flasche eines Djiin. "+
	     "Sie ist fest mit einem Korken versperrt, sodass der Geist darin "+
	     "nicht entfliehen kann."));
  SetProp(P_INFO, 
	  BS("Diese Flasche ist das Haus fuer einen maechtigen Djiin, "+
	     "der Dir nach einem Tod ein paar Deiner Gegenstaende "+
	     "retten kann."));
  SetProp(P_NAME, "Flasche");
  SetProp(P_NAME_ADJ, col);
  SetProp(P_GENDER, FEMALE);
  AddId(({"djiinflasche","flasche","\ndjiinflasche"}));

  SetProp(P_MATERIAL, ([MAT_GLASS:90, MAT_MISC_MAGIC:10]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 90);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Die Flasche ist viel zu wichtig!\n");
  SetProp(P_NEVERDROP, 1);
  player="";
}

NotifyPlayerDeath(object v, object k, int lxp)
{
  if(getuid(v)==player)
    call_out("remove",1);
}

init()
{
  object pl;
  
  ::init();
  
  if(pl=ENV(ME))
    if(interactive(pl))
      if(!strlen(player) || player==getuid(pl))
        {
          player=getuid(pl);
          if(pl->QueryProp(P_CORPSE)==STANDARDCORPSE);
          pl->SetProp(P_CORPSE, DJIIN); 
        }
}

destruct()
{
  return remove();
}

remove()
{
  object pl;
  
  if(pl=find_player(player))
    if(pl->QueryProp(P_CORPSE)==DJIIN)
      {
	write_file(LOG "djiin", ctime()+" : "+CAP(player)+
		   " hat noch immer Djiincorpse!\n");
	pl->SetProp(P_CORPSE, STANDARDCORPSE);
      }
  return ::remove();
}

