inherit "/std/npc";

#include <properties.h>
#include <moving.h>
#include <npc.h>
#include "/sys/living/combat.h"
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein riesiger, steinalter Kaldaran");
  SetProp(P_LONG,
          "Der Kaldaran ist ein uralter Verwandter von den Ki'chta Khar, "+
          "den frueheren Beherrschern der Wueste. Er ist beinahe so gross "+
          "wie ein Haus und sein Koerper mindestens genauso gefaehrlich wie "+
          "eine Geroellawine. Am Kopfende ragen mehrere Tentakel aus einer "+
          "Mundaehnlichen Oeffnung. Sie scheinen in Deine Richtung zu deuten...\n");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_NAME,"Kaldaran");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE,"Lindwurm");
  SetProp(P_NOMAGIC, 30+random(40));
  SetProp(P_SIZE, 1999);
  SetProp(P_WEIGHT, 26841941);
  AddId(({"lindwurm","kaldaran"}));
  create_default_npc(50);
  SetProp(P_BODY,ME->QueryProp(P_BODY)+100);
  SetProp(P_ATTRIBUTES, ([A_INT:25,A_STR:80,A_CON:70,A_DEX:20]));  
  SetProp(P_HANDS,({" mit seinem gigantischen Koerper",
                    ME->QueryProp(P_HANDS)[1],DT_SQUEEZE}));
  SetProp(P_ALIGN, 0);
  seteuid(getuid(this_object()));
  SetProp(P_DEFAULT_INFO,"summt etwas in einer uralten Sprache.\n");
  SetProp(P_MSGIN,"ueberrollt Dich mit seinem riesigen Koerper beinahe");
  SetProp(P_MSGOUT,"waelzt seinen Koerper");
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_BLUDGEON:-0.9,     DT_SLASH:-0.8,    DT_RIP:-1.0,
      DT_PIERCE:-0.9,       DT_SQUEEZE:-2.0,  DT_WHIP:-1.0,
      DT_HOLY:-0.7,         DT_UNHOLY:-0.7,   DT_FIRE:-0.4,
      DT_COLD:-0.5,         DT_WATER:-0.8,    DT_AIR:-0.8,
      DT_LIGHTNING:0.4,     DT_EXPLOSION:0,   DT_SOUND:-0.9,
      DT_LIGHT:0.4,         DT_ELECTRIC:0.2,  DT_ACID:0.3,
      DT_POISON:-0.8,       DT_TERROR:-0.2,   DT_MAGIC:-0.1]));

  AddInfo(({"ki'chta khar","kichta","ki'chta","khar"}),
    "Wuaaa kraaa chma goe nka ri ki'chta khar chmooo.\n","bruellt: ");
}

reset()
{
  ::reset();
  
  say("Die Augen des Kaldaran beginnen ploetzlich zu leuchten und eine "+
      "blaue Aura bildet sich kurz um ihn.\n");
  heal_self(500+random(100));
  command("nimm alles");
}

