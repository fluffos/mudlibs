// Der urspruengliche Muellschlucker tat mir leid...
// Jetzt haben sie eine eigene Hoehle wo sie sich wehren koennen...

inherit "/std/npc";

#include <properties.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  int rnd;
  string *kurz;

  if (!is_clone(this_object())) return;
  ::create();

  kurz=({"winzig","klein","gross","riesig"});
  rnd=random(4);

  SetProp(P_SHORT,"Ein "+kurz[rnd]+"er Muellschlucker");
  SetProp(P_LONG,
    "Der "+kurz[rnd]+"e Muellschlucker gehoert zu Familie der Kleinsaurier "+
    "und zeichnet sich durch ein sehr grosses Maul und nahezu unbegrenzten "+
    "Appetit aus. Das einzige, was er nicht mag, sind Dinge, die materiellen "+
    "Wert haben. Alles andere kann man ihm mit 'fuettere muellschlucker mit "+
    "<name>' in den Rachen stopfen.");
  SetProp(P_INFO,
    "Dieser Muellschlucker verschlingt auch lose herumliegende Dinge. Also "+
    "pass auf, was Du wegwirfst.");
  SetProp(P_NAME_ADJ, kurz[rnd]);
  SetProp(P_NAME,"Muellschlucker");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE,"saurier");
  SetProp(P_ARTICLE,1);
  SetProp(P_NOMAGIC, 30+rnd*10);
  AddId(({"muellschlucker","schlucker","kleinsaurier","saurier"}));
  create_default_npc( (rnd+1)*5 );
  SetProp(P_BODY,200+rnd*30);
  SetProp(P_HANDS,
	  ({" mit dem alles verschlingenden Gebiss",200+rnd*30,DT_RIP}));
  SetProp(P_ALIGN, -100*(rnd+1));
  seteuid(getuid(this_object()));
  SetProp(P_DEFAULT_INFO,"grunzt nur vor sich hin.\n");
  SetProp(P_MSGIN,"rollt herein");
  SetProp(P_MSGOUT,"rollt");
  SetProp(P_DIE_MSG,  " grunzt ein letztes Mal und faellt dann tot um.\n");
  SetProp(P_MURDER_MSG, "Nyak moch mt`patak nkmalha!");
  SetProp(P_KILL_NAME, "Die Rache der Muellschlucker");
  SetProp(P_KILL_MSG, "Wir lassen uns nicht laenger unterdruecken!");
  SetProp(P_RESISTANCE_STRENGTHS ,
          ([
            DT_FIRE:  -0.3, DT_COLD:      0.1, DT_WATER:    -0.1,
            DT_AIR:   -0.3, DT_LIGHTNING:-0.1, DT_EXPLOSION: 0.1,
            DT_SOUND:  0.1, DT_LIGHT:     0.3, DT_ELECTRIC:  0.0,
            DT_ACID:   0.2, DT_POISON:    0.1, DT_TERROR:   -0.3,
            DT_HOLY:   0.2, DT_UNHOLY:   -0.4, DT_MAGIC:    -0.3]));
  AddCmd(({"fuetter","fuettere"}),"haps");
  enable_commands();
}

haps(string str)
{
  string foo,bar;
  object tp;

  notify_fail("Syntax: fuettere muellschlucker mit <name>\n");
  if(!str) return 0;
  if(sscanf(str,"%s mit %s",foo,bar)!=2) return 0;
  if(!id(foo)) return 0;
  notify_fail("So etwas hast Du nicht.\n");
  tp=TP;
  if((!present(bar,tp)) &&
     (!present(bar,environment()))) return 0;
  write("Der Muellschlucker bruellt Dich an: VERRAETER!!!\n");
  say("Ploetzlich bruellt der Muellschlucker "+tp->name(WEN)+" an.\n",tp);
  Kill(tp);
  return 1;
}

reset()
{
  int i;
  object *inv;
  ::reset();
  
  inv=all_inventory(this_object());
  if(inv && sizeof(inv))
    for(i=sizeof(inv)-1;i>=0;i--)
      destruct(inv[i]);
  command("nimm alles");
}
