#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/room";
inherit MOST "std_room";

create()
{
	::create();

  SetProp(P_INT_SHORT,"In einer verborgenen Kaldaranhoehle");
  SetProp(P_INT_LONG,
          "Du wanderst durch die kuehlen Hallen der Kaldaran und so sehr Du "+
	  "Dich auch anstrengst, alles was Du siehst scheint verschwommen "+
	  "und Du kannst nichts besonderes erkennen.");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE]));
  AddDetail(({"boden","decke","waende","wand"}), 
	    "Alles ist in einem verschwommenen violett gehalten, Du kannst "+
	    "leider nichts besonderes erkennen.n");
  set_light("duester");
  set_temp("kuehl");
  set_exits("k",({"sueden"}));
}
