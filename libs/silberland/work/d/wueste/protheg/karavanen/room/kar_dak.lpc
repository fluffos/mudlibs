/* 
   Kamel-Karavane Gwenshara (Original by PROtheG )

   Route Echsendorf - Arrakeen - Kueste
   
*/

#include "../def.h"

inherit "std/transport";

nosave int dir;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Kamel" );
  SetProp(P_INT_LONG, 
	  BS("Du sitzt hier oben auf einem der fuenf Kamele dieser "
	     "Reisekaravane. Du freust Dich richtig darauf mit dieser "
	     "Karavane durch die Wueste zu ziehen. Am vordersten Kamel "
	     "kannst Du den Karavanenfuehrer erkennen."));
  
  SetProp(P_SHORT, "Eine Reisekaravane" );
  SetProp(P_LONG, 
	  BS("Du siehst eine Gruppe von fuenf Kamelen, wobei das erste von "
	     "ihnen dem Karavananfuehrer als Reittier dient. Du hoffst, "
	     "dass Du auch noch ein Kamel ergattern kannst, um mit der "
	     "Reisekaravane mitziehen zu koennen.")+
	  BS("Die Karavane pendelt zwischen: Echsendorf - Arrakeen - Kueste"));

  SetProp(P_NAME, "Reisekaravane" );
  AddId(({"karavane","reisekaravane"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_DESERT,ENV_TEMPERATURE:40]));

  AddDetail(({"karavane", "kamel"}),
	    QueryProp(P_INT_LONG) );
  AddDetail(({"sandsturm", "sturm"}),
	    "Sei froh, dass hier keiner ist, sonst wuerde es Dir schlecht "
	    "gehen.");
  AddDetail("himmel", 
	    "Noch ist er blau, aber das kann sich schnell aendern, dann "
	    "ist er braun vor Sand.");
  AddDetail("boden", 
	    "Gottseidank musst Du nicht auf diesem gluehend heissen Sand "
	    "herumlaufen.");
  AddDetail("sand", 
	    "Den gibts hier wirklich ueberall im Ueberfluss.");
  AddDetail("karavanenfuehrer",
	    "Der Typ ist von der Hitze so ausgedoerrt, dass Du ihn in "
	    "seinem Gewand ueberhaupt nicht sehen kannst.");
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst den Wind durch die Wueste pfeifen." );
  AddSmell(DEFAULT_SMELL, 
	   "Du riechst nur den durchdringenden Geruch Deines Kamels." );

  SetProp(P_DEPARTMSG, 
	  ({ "Die Reisekaravane zieht los.\n", 
	      "Eine Reisekaravane setzt sich in Bewegung und zieht davon.\n"}));
  SetProp(P_ARRIVEMSG, 
	  ({ "Die Reisekaravane haelt @@QueryArrived@@ an.\n",
	      "Eine Reisekaravane kommt angetrabt.\n"}));
  SetProp(P_ENTERMSG, 
	  ({ "klettert auf ein Kamel",
	       "klettert auf ein Kamel"}));
  SetProp(P_ENTERFAIL, 
	  "Der Karavanenfuehrer sagt: Wir haben nur 4 Kamele." );
  SetProp(P_MAX_PASSENGERS, 4);
  SetProp(P_LEAVEMSG, 
	  ({ "klettert von einem Kamel",
	       "klettert von dem Kamel herunter"}));
  SetProp(P_LEAVEFAIL, 
	  ({ "Jetzt kannst Du nicht runter!",
	       "wollte den Schutz der Kamele wirklich verlassen"}));

  AddCmd(({"steig", "steige"}), "steig_kamel");
  AddCmd(({"reite"}), "reite_kamel");

  dir=0;

  //1. Echsendorf
  AddRoute(ECHSENDORF, 30, 5, "bei einem Talkessel",
	   ({"kessel","talkessel","dorf","echsendorf"}),"zu einem Talkessel");
  
  AddMsg("\n"+BS("Der Karavanenfuehrer gibt den Befehl zum Aufbruch."), 4);
  AddFun("dira",1);
  AddMsg("\n"+BS("Und schon beginnt die Reise."), 6);
  AddMsg("\n"+BS("Die Kamele wenden sich nach Osten."), 10);
  AddMsg("\n"+BS("Dein Kamel folgt den anderen."), 20);
  AddMsg("\n"+BS("Du korrigierst den Kurs Deines Kamels ein bisschen."), 10);
  AddMsg("\n"+BS("Die Karavane wendet sich nach Suedosten."), 9);
  AddMsg("\n"+BS("Am Horizont kannst Du bereits die Umrisse der Stadt Arrakeen erkennen."), 10);
  AddMsg("\n"+BS("Arrakeen kommt immer naeher."), 10);
  AddFun("kontrolle",5);
  AddMsg("\n"+BS("Endlich ist die Karavane angekommen."), 1);

  //2. Arrakeen
  AddRoute(ARRAKEEN, 30, 5, "an einem kleinen See in der Naehe von Arrakeen",
	   ({"see","arakeen","arrakeen","oase"}),"nach Arrakeen");  

  AddMsg("\n"+BS("Der Karavanenfuehrer sieht nach dem Rechten und winkt dann "
		 "zum Aufbruch."),3);
  AddFun("dirk",10);
  AddMsg("\n"+BS("Die Kamele wenden sich suedlich."), 5);
  AddMsg("\n"+BS("Dein Kamel tanzt aus der Reihe!"), 4);
  AddMsg("\n"+BS("Zum Glueck hast Du Dein Kamel wieder unter Kontrolle."),10);
  AddMsg("\n"+BS("Die Sonne brennt vom Himmel."), 5);
  AddFun("kontrolle",2);
  AddMsg("\n"+BS("Gemuetlich wenden sich die Kamele nach Suedwesten."),20);
  AddMsg("\n"+BS("Langsam kommt die Kueste in Sicht."), 10);
  AddMsg("\n"+BS("Die Karavane zieht nun die Kueste entlang."), 2);
  AddMsg("\n"+BS("In weiter Ferne faehrt ein Schiff uebers Meer."), 15);
  AddMsg("\n"+BS("Im Westen kannst Du einen Hafen erkennen."), 4);
  AddMsg("\n"+BS("Die Kamele werden langsamer."), 2);
  AddMsg("\n"+BS("Die Kamele bleiben stehen."), 4);

  //3. Kueste
  AddRoute(KUESTE, 30, 5, "an der Kueste",
	   ({"kueste","hafen","meer"}),"an die Kueste");

  AddMsg("\n"+BS("Der Karavanenfuehrer gibt den Befehl zum Aufbruch."), 4);
  AddFun("dira2",1);
  AddMsg("\n"+BS("Und schon beginnt die Reise."), 6);
  AddMsg("\n"+BS("Die Kamele wenden sich nach Norden."), 10);
  AddMsg("\n"+BS("Dein Kamel folgt den anderen."), 20);
  AddMsg("\n"+BS("Du korrigierst den Kurs Deines Kamels ein bisschen."), 10);
  AddMsg("\n"+BS("Die Karavane wendet sich nach Nordosten."), 9);
  AddMsg("\n"+BS("Am Horizont kannst Du bereits die Umrisse der Stadt Arrakeen erkennen."), 10);
  AddMsg("\n"+BS("Arrakeen kommt immer naeher."), 10);
  AddFun("kontrolle",5);
  AddMsg("\n"+BS("Endlich ist die Karavane angekommen."), 1);

  //4. Arrakeen
  AddRoute(ARRAKEEN, 30, 5, "an einem kleinen See in der Naehe von Arrakeen",
	   ({"see","arakeen","arrakeen","oase"}),"nach Arrakeen");  

  AddMsg("\n"+BS("Der Karavanenfuehrer treibt die Kamele an und der Ritt geht "
    "los."),3);
  AddFun("dire",1);
  AddMsg("\n"+BS("Die Karavane richtet sich gerade Wegs nach Norden."),10);
  AddMsg("\n"+BS("Die Karavane haelt einen Nordwestkurs."),3);
  AddMsg("\n"+BS("Langsam bekommst Du Durst."),10);
  AddMsg("\n"+BS("Die Karavane kreuzt eine andere Karavanenroute."),5);
  AddMsg("\n"+BS("Ihr lasst Die Kreuzung hinter euch."),10);
  AddMsg("\n"+BS("Die Karavane haelt kurz an."),20);
  AddMsg("\n"+BS("Ploetzlich geht es weiter."),5);
  AddMsg("\n"+BS("Ein einsamer Reiter reitet auf die Karavane zu."),2);
  AddFun("kontrolle",2);
  AddMsg("\n"+BS("Der Reiter reitet wieder weg."),10);
  AddMsg("\n"+BS("Am Himmel ziehen ein paar Geier ihre Kreise."),5);
  AddMsg("\n"+BS("Die Karavane naehert sich einem Talkessel."),10);
  AddMsg("\n"+BS("Die Karavane muss noch eine Duene umgehen."),5);
  AddMsg("\n"+BS("Fast seid ihr angekommen."), 10);
  AddMsg("\n"+BS("Die Karavane haelt an."),10);

  Start();
}

void dira() { dir=1; }
void dirk() { dir=2; }
void dira2() { dir=3; }
void dire() { dir=4; }

void init()
{
  ::init();

  if(interactive(this_player()))
    {
      catch(call_other(ECHSENDORF, "???"));
      catch(call_other(ARRAKEEN, "???"));
      catch(call_other(KUESTE, "???"));
    }
}

nosave int reite_kamel(string str)
{
  notify_fail(BS("Worauf willst Du denn reiten?"));

  if(str=="auf kamel"||str=="mit kamel"||str=="kamel")
    return Enter(TP);

  if(str=="karavane"||str=="reisekaravane"||str=="reisekaravane")
    return notify_fail("Deine Rechtschreibung laesst aber zu wuenschen uebrig.\n"),0;
  
  if(str=="auf karavane"||str=="auf reisekaravane")
    return notify_fail(BS("Vielleicht solltest es zuerst mit nur einem Kamel "
			  "versuchen, und nicht gleich mit der ganzen "
			  "Reisekaravane.")),0;
  return 0;
}

nosave int steig_kamel(string str)
{
  object fs;
  
  notify_fail(BS("Du steigst in einen Haufen Kameldreck."));

  if(str=="von kamel"||str=="vom kamel"||str=="von kamel ab"||
     str=="vom kamel ab" ||str=="ab")
    {
      if(fs=present(FAHRSCHEIN,TP))
	{
	  write("Ein kleiner Gnom meint: 'Den brauchst Du jetzt nicht mehr!'\n"
		"Mit diesen Worten nimmt er Dir den Fahrschein weg und "
		"verschwindet.\n");
	  fs->remove();
	}
      return Leave(TP);
    }
  
  if(str=="von reisekaravane"||str=="von karavane"||
     str=="von reisekaravane ab"||str=="von karavane ab"||str=="von reisekaravane"||
     str=="von reisekaravane ab")
    if(present(TP, ME))
      return notify_fail("Aber Du sitzt doch nur auf einem Kamel.\n"),0;
    else
      return notify_fail("Aber Du sitzt doch gar nicht auf einem Kamel.\n"),0;

  if(str=="kamel"||str=="karavane"||str=="reisekaravane"||str=="reisekaravane")
    return notify_fail("Deine Rechtschreibung laesst aber zu wuenschen uebrig.\n"),0;

  if(str=="auf kamel")
    return Enter(TP);

  if(str=="auf karavane"||str=="auf reisekaravane"||str=="auf reisekaravane")
    return notify_fail(BS("Vielleicht solltest es zuerst mit nur einem Kamel "
			  "versuchen, und nicht gleich mit der ganzen "
			  "Reisekaravane.")),0;
  return 0;
}

varargs int Leave(object who)
{
  object fs;
        
  if(fs=deep_present(FAHRSCHEIN,who||TP))
    {
      tell_object(who||TP,
		  "Ein kleiner Gnom meint: 'Den brauchst Du jetzt nicht mehr!'\n"
		  "Mit diesen Worten nimmt er Dir den Fahrschein weg und "
		  "verschwindet.\n");
      fs->remove();
    }
  return ::Leave(who);
}

void kontrolle()
{
  string str;
  object *leut; 
  int x,geld,siz;
  
  if(random(3)) return;
  
  Halt();
  
  tell_room(TO, 
	    "\nPloetzlich wird die Karavane von einem riesigen Koloss "
	    "angehalten.\n"
	    "Du vernimmst seine durchdringende Stimme: "+(({"FAHRSCHEINE BITTE!",
	    "FAHRSCHEINKONTROLLE!","TICKETS PLEASE!"})[random(3)])+"\n\n");
  
  leut = filter_array(all_inventory(), CLOSURE(interactive));
  
  if(siz=sizeof(leut))
    for(leut[x]; x < siz; x++)
      {
       	if(present(FAHRSCHEIN, leut[x]))
	  tell_object(leut[x],
			BK("Der Kontrolleur sieht sich Deinen Fahrschein an, "
			   "nickt freundlich und gibt ihn Dir wieder zurueck.\n"));
      	else
	  {
      	    tell_object(leut[x],
      			BK("Deine um Gnade flehende Miene beantwortet der "
			   "Riese nur mit einem eiskalten Blick und den "
			   "Worten: \"Das macht fuenfhundert Muenzen "
			   "Strafe\".\n"));
	    if(leut[x]->QueryMoney() < 500) 
	      {
		tell_object(leut[x],
			    BK("\"Du kannst also nicht bezahlen,\" "
			       "schreit der Riese und spricht eine magische "
			       "Formel. Dir wird irgendwie komisch, doch du "
			       "kannst nicht genau erkennen woher.\n\n"));
		if(leut[x]->QueryProp(P_GENDER) == FEMALE)
		  leut[x]->SetProp(P_TITLE,"die Schwarzfahrerin");
		else
		  leut[x]->SetProp(P_TITLE,"der Schwarzfahrer");
		geld = leut[x]->QueryMoney();
		leut[x]->AddMoney(-geld);
		
		if(!random(3))
		  {
		    tell_object(leut[x],
				BK("Der Herdenfuehrer fuehlt sich beschaemt, dass "
				   "er Dich mitgenommen hat, dass er Dich prompt "
				   "aussteigen laesst...\n"));
		    tell_room(TO,
			      BK(leut[x]->Name(WER)+" muss die Karavane verlassen.\n"),
			      ({leut[x]}));
		    switch(dir)
		      {
		      case 1:  leut[x]->move(ODZ ":84:24",M_NOCHECK|M_NO_SHOW); 
			break;
		      case 2:  leut[x]->move(ODZ ":79:42",M_NOCHECK|M_NO_SHOW); 
			break;
		      case 3:  leut[x]->move(ODZ ":63:30",M_NOCHECK|M_NO_SHOW);
			break;
		      default: leut[x]->move(ODZ ":54:22",M_NOCHECK|M_NO_SHOW);
		      }
		  } 
	      } 
	    else
	      {
		tell_object(leut[x],
			    "Der Kontrolleur nimmt Dir 500 Muenzen als "
			    "Strafe weg.\n");
		leut[x]->AddMoney(-500);
	      }
	  }
      }
  
  tell_room(TO, "\n"+
	    BS("Der Kontrolleur verlaesst die Karavane und der Herdenfuehrer "
	       "treibt die Kamele weiter an."));
  switch(dir)
    {
    case 1:  Start(11); break;
    case 2:  Start(20); break;
    case 3:  Start(38); break;
    case 4:  Start(51); break;
    default: Start(11);
    }
}

varargs string GetExits(object viewer) 
{ 
  return "";
}

