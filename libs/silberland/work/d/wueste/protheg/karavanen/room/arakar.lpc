/*
**  Arakeen Station der Karavane
**
**
**  2002-03-10  PROtheG  trinken-syntax erweitert.
*/

#include "../def.h"

inherit MOST "std_room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#define MAXHEILEN 5
#define TRINK 8

#define DESERT "/d/wueste/zordan/desert/room/desert"
#define ARAKEEN_ANSCHLUSS "/d/wueste/protheg/arrakeen/room/ara_3_0_0"

nosave int heilen;

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine kleine Oase mitten in der Wueste");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich hier irgendwo in der trostlosen Wueste, doch "
	     "das ist Dir egal, denn vor Dir befindet sich eine wunderschoene "
	     "kleine Oase mit Allem was dazugehoert: Palmen, Straeucher, ein "
	     "Zelt und natuerlich einen kleinen See mit kristallklarem "
	     "Wasser..."));
  
  AddDetail("oase",
	    QueryProp(P_INT_LONG));

  AddDetail(({"sand","boden"}),
	    "Sand! Sand! Sand! Sand!");

  AddDetail("himmel",
	    "Strahlendblau und wolkenlos wie immer.");

  AddDetail("zelt",
	    "Ein kleines Zelt steht hier herum, dort erholen sich wohl die "
	    "Karavanenfuehrer, von ihren langen Reisen.");

  AddDetail("wueste",
	    "Du befindest Dich hier irgendwo mitten in der Wueste bei einer "
	    "kleinen Oase.");

  AddDetail(({"see","wasser"}),
	    "Kristallklares Wasser, man kann sogar bis auf den Grund sehen.");

  AddDetail("grund",
	    "Der Grund des kleinen Sees besteht aus vielen, kleinen "
	    "Steinchen.");

  AddDetail("steinchen",
	    "Am Grund des Sees funkeln lauter kleine Steinchen.");

  AddDetail("alles",
	    "Hehe, wuerdest Du wohl gerne!");

  AddDetail("straeucher",
	    "Ein paar kleine Straeucher saeumen den See. Bis auf ihre gelbe "
	    "Farbe scheinen sie nichts besonderes zu sein.");

  AddDetail("farbe",
	    "Die Farbe koennte Gift andeuten.");

  AddDetail("gift",
	    "Die Straeucher koennten giftig sein!");

  AddDetail("reisen",
	    "Die Karavanenfuehrer machen oft lange Reisen mit ihrer "
	    "Karavane.");

  AddDetail(({"kokospalmen","palmen"}),
	    "Einige Kokospalmen stehen hier herum und bewegen sich im Wind.");

  AddDetail(({"blaetter","palmenblaetter"}),
	    "Die Palmenblaetter rascheln leise im Wind...");

  AddDetail(({"nuesse","kokosnuesse"}),
	    "Saftige Kokosnuesse, aber sie haengen zu weit oben!");

  AddDetail("karavane",
	    "Scheint wohl keine da zu sein.");

  AddDetail(({"fuehrer","karavanenfuehrer"}),
	    "Die sitzen meisstens im Zelt und erholen sich.");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst wie die Palmen im Wind leise rascheln.");

  AddSound(({"rascheln","wind"}),
	   "Der Wind bringt die Palmenblaetter zum rascheln.");

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht irgendwie nach Kokosnuessen...");

  AddCmd(({"betrete","betritt"}), "noenter");
  AddCmd(({"kletter","klettere"}), "kfake");
  AddCmd(({"trinke","trink"}), "trinken");
  AddCmd(({"schubse","schubs","stoss","stosse"}), "sfake");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  heilen=MAXHEILEN;

  AddExit("nordwesten", DESERT ":83:16");
  AddExit("westen",     DESERT ":83:17");
  AddExit("suedwesten", DESERT ":83:18");
                         
  AddExit("osten", ARAKEEN_ANSCHLUSS);

  AddItem(OBJ "fsauto", REFRESH_DESTRUCT);
  AddItem(ROOM "kar_dak", REFRESH_DESTRUCT, 1);
}

void init()
{
  ::init();
  
  catch(call_other(ERG, "???"));

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}

void reset()
{
  ::reset();

  heilen=MAXHEILEN;
}

nosave int kfake(string str)
{
  notify_fail(BS("Wohin willst Du denn klettern?"));
  if(!str) return 0;

  if(str=="auf palme"||str=="auf kokospalme")
    return write(BS("Du beginnst Die Palme hochzuklettern, rutschst aber "
		    "bereits nach ein paar Metern ab und landest auf dem "
		    "Hintern.")), 1;

  return 0;
}

nosave int sfake(string str)
{
  notify_fail(BS("Was willst Du denn stossen?"));
  if(!str) return 0;

  if(str=="palme"||str=="kokospalme")
    return write(BS("Du stoesst die Kokospalme einmal kraeftig, in der "
		    "Hoffnung, dass eine Kokosnuss herabfaellt, doch die "
		    "Palme gibt ihre Fruechte nicht so schnell her!")), 1;

  return 0;
}

nosave int noenter(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;

  if(str=="zelt")
    return write(BS("Aus dem Zelt ertoent eine Stimme: 'Kein Zutritt fuer "
		    "Dich!'")), 1;

  return 0;
}

nosave int trinken(string str)
{
  int h;
  
  notify_fail(BS("Woraus willst Du denn trinken?"));
  if(!str) return 0;

  if(str=="wasser")
    return notify_fail(BS("Welches Wasser willst Du trinken?")), 0;

  if(str=="aus see"||str=="wasser aus see"||str=="aus dem see"||
     str=="wasser aus dem see")
    {
      if(!TP->drink_soft(TRINK)) return 1;

      if(heilen)
	{
          heilen--;
          write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst Dich "
		   "total erfrischt!"));

          say(BS(TP->Name(WER)+" trinkt etwas Wasser aus dem See."));

	  h=40+random(40);

          TP->AddHp(h);

	  write_file(LOG "tanken",
		     dtime(time())+": "+CAP(getuid(TP))+" trinkt nen Schluck ("+h+").\n");
	}
      else
        {
          write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst Dich "
		   "etwas besser."));

          say(BS(TP->name(WER)+" trinkt etwas Wasser aus dem See."));
        }
      return 1;
    }

  return 0;
}
