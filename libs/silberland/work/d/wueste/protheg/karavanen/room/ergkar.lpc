#include "../def.h"

inherit MOST "std_room";

#define DESERT "/d/wueste/zordan/desert/room/desert"

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Am Rand der grossen weiten Wueste");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich hier nun am Rand der Wueste. Nach Nordwesten "
	     "fuehrt ein schmaler Weg in die Berge, ansonsten erstreckt sich "
	     "nach Osten hin die offene Wueste. Eine kleine Holzhuette steht "
	     "hier herum."));
  
  AddDetail("boden",
	    "Der sandige Wuestenboden und der felsige Boden der Berge vermischen sich "
	    "hier zusehends.");

  AddDetail("himmel",
	    "Im Nordwesten wird der Himmel durch ein hohes Gebirge abgegrenzt.");

  AddDetail(({"gebirge","berge","berg"}),
	    "Vielleicht erfaehrst Du weiter im Nordwesten mehr ueber die Berge.");

  AddDetail("wuestenboden",
	    "Ueberall wohin Du auch siehst, nur der heisse Wuestenboden... Nur im "
	    "Nordwesten geht es in die Berge.");

  AddDetail("wueste",
	    "Du befindest Dich hier am Rand der Wueste.");

  AddDetail("rand",
	    "Hier wird die grosse Wueste von einem Gebirge abgeloest, oder umgekehrt. ;)");

  AddDetail("weg",
	    "Ein schmaler Weg fuehrt hier in die Berge.");

  AddDetail(({"huette","holzhuette"}),
	    "Eine kleine Holzhuette steht hier einfach so rum. Einige Spuren vor der Huette "
	    "deuten jedoch auf regen Verkehr hin!");

  AddDetail(({"kamelspuren","spuren"}),
	    "Das sind hauptsaechlich Kamelspuren, woher die wohl stammen?");

  AddDetail("verkehr",
	    "Anscheinend herrscht hier oft ein reger Verkehr, ob das die beruehmten "
	    "Kamelkaravanen sind?");

  AddDetail(({"karavanen","kamelkaravanen","karavane","kamelkaravane"}),
	    "Im Moment ist wohl keine da, aber die naechste kommt sicher bald!");

  AddDetail("moment",
	    "Gedulde Dich, dann wird bestimmt bald eine Kamelkaravane auftauchen!");

  AddDetail("tuer",
	    "Durch die Tuer gelangt man wohl in die Holzhuette, ein kleines Tuerschild ist an ihr "
	    "befestigt.");

  AddDetail(({"tuerschild","schild"}),
	    "Ein hastig aufgehaengtes Schild.");

  AddReadDetail(({"tuerschild","schild"}),
		"Auf dem Schild steht: 'Bin kurz weg!'");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst nur das Rauschen des Wuestenwindes.");

  AddSound(({"rauschen","wind","wuestenwind"}),
	   "Der Wuestenwind rauscht in der Ferne.");

  AddSound("ferne",
	   "Was Dich dort wohl erwartet?");

  AddSmell(({DEFAULT_SMELL,"kameldung","dung"}),
	   "Es riecht irgendwie nach Kameldung...");

  AddCmd(({"betrete","betritt"}), "noenter");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  AddExit("nordwesten", "/d/wueste/zordan/anschluss/room/erg5");

  AddExit("sueden",     DESERT ":12:15");
  AddExit("osten",      DESERT ":13:14");
  AddExit("suedosten",  DESERT ":13:15");
  AddExit("suedwesten", DESERT ":11:15");    

  AddItem(OBJ "fsauto", REFRESH_DESTRUCT);
  AddItem(ROOM "kar_eqa", REFRESH_DESTRUCT, 1);
}

nosave int noenter(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="huette"||str=="holzhuette"||str=="station")
    return write(BS("Du willst die Holzhuette betreten, doch sie ist "
		    "abgesperrt, aber Dir faellt ein kleines Tuerschild "
		    "auf!")),1;
  return 0;
}

void init()
{
  ::init();
  
  catch(call_other(ARRAKEEN, "???"));
}
