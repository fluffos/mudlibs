{
  write_file(LOG "karavane",
    dtime(time())+": "+CAP(getuid(who||TP))+" reist mit der Karavane.\n");
  return ::Enter(who);
}
*/

varargs int Leave(object who)
{
  object fs;
        
  if(fs=deep_present(FAHRSCHEIN,who||TP))
    {
      tell_object(who||TP,
		  "Ein kleiner Gnom meint: 'Den brauchst Du jetzt nicht mehr!'\n"
		  "Mit diesen Worten nimmt er Dir den Fahrschein weg und "
		  "verschwindet.\n");
      fs->remove();
    }
  return ::Leave(who);
}

void sandsturm()
{
  if(random(13)!=1) return;
  tell_room(TO, 
	    "\n"+BS("Die Karavane wird von einem fuerchterlichen Sandsturm "+
		    "ueberrascht und am Weiterkommen gehindert."));
  Halt();
  call_out("sturm",5+random(15));
}

void kontrolle()
{
  string str;
  object *leut; 
  int x,geld,siz;

  if(random(3)) return;

  Halt();

  tell_room(TO, 
	    "\nPloetzlich wird die Karavane von einem riesigen Koloss "+
	    "angehalten.\n"+
	    "Du vernimmst seine durchdringende Stimme: "+(({"FAHRSCHEINE BITTE!",
	    "FAHRSCHEINKONTROLLE!","TICKETS PLEASE!"})[random(3)])+"\n\n");
    
  leut = filter_array(all_inventory(), CLOSURE(interactive));

  if(siz=sizeof(leut))
    for(leut[x]; x < siz; x++)
      {
       	if(present(FAHRSCHEIN, leut[x]))
  	    tell_object(leut[x],
			BK("Der Kontrolleur sieht sich Deinen Fahrschein an, "+
			   "nickt freundlich und gibt ihn Dir wieder zurueck.\n"));
      	else
	  {
      	    tell_object(leut[x],
      			BK("Deine um Gnade flehende Miene beantwortet der "+
			   "Riese nur mit einem eiskalten Blick und den "+
			   "Worten: \"Das macht fuenfhundert Muenzen "+
			   "Strafe\".\n"));
	    if(leut[x]->QueryMoney() < 500) 
	      {
		tell_object(leut[x],
			    BK("\"Du kannst also nicht bezahlen,\" "+
			       "schreit der Riese und spricht eine magische "+
			       "Formel. Dir wird irgendwie komisch, doch du "+
			       "kannst nicht genau erkennen woher.\n\n"));
		if(leut[x]->QueryProp(P_GENDER) == FEMALE)
		  leut[x]->SetProp(P_TITLE,"die Schwarzfahrerin");
		else
		  leut[x]->SetProp(P_TITLE,"der Schwarzfahrer");
		geld = leut[x]->QueryMoney();
		leut[x]->AddMoney(-geld);
		
		if(!random(3))
		  {
		    tell_object(leut[x],
				BK("Der Herdenfuehrer fuehlt sich beschaemt, dass "+
				   "er Dich mitgenommen hat, dass er Dich prompt "+
				   "aussteigen laesst...\n"));
		    tell_room(TO,
			      BK(leut[x]->Name(WER)+" muss die Karavane verlassen.\n"),
			      ({leut[x]}));
		    switch(dir)
		      {
		      case 1:  leut[x]->move(ODZ ":30:30",M_NOCHECK|M_NO_SHOW); 
			break;
		      case 2:  leut[x]->move(ODZ ":70:25",M_NOCHECK|M_NO_SHOW); 
			break;
		      case 3:  leut[x]->move(ODZ ":50:16",M_NOCHECK|M_NO_SHOW);
			break;
		      default: leut[x]->move(ODZ ":40:25",M_NOCHECK|M_NO_SHOW);
		      }
		  } 
	      } 
	    else
	      {
		tell_object(leut[x],
			    "Der Kontrolleur nimmt Dir 500 Muenzen als "+
			    "Strafe weg.\n");
		leut[x]->AddMoney(-500);
	      }
	  }
      }
  
  tell_room(TO, "\n"+
	    BS("Der Kontrolleur verlaesst die Karavane und der Herdenfuehrer "+
	       "treibt die Kamele weiter an."));
  switch(dir)
    {
    case 1:  Start(16); break;
    case 2:  Start(28); break;
    case 3:  Start(51); break;
    default: Start(16);
    }
}

void fata_morgana()
{
  string str;
  switch( random(6) )
    {
    case 0: str="\n"+BS("Du glaubst es kaum, aber da steht ein McDagoberts!");
      break;
    case 1: str="\n"+BS("Ist das nur Einbildung, oder steht da wirklich "
                "ein Kuehlschrank mit der Aufschrift \"Bier\"?");
    break;
    case 2: str="\n"+BS("Hey, da steht ja ein Eisverkaeufer!");
      break;
    case 3: str="\n"+BS("Irgendetwas stimmt da nicht. "
                "Da steht ja ein Maroniverkaeufer!");
    break;
    case 4: str="\n"+BS("Da ist ein riesiges Freibad!");
      break;
    case 5: str="\n"+BS("Da steht ein Pinguin auf einem riesigen Eisberg!");
    }
  tell_room(TO, str);
}

void sturm()
{
  string str;

  if(!random(10))
    {
      tell_room(TO, 
		"\n"+
		BS("Der Himmel beginnt sich zu beruhigen und der Sandsturm "
		   "scheint sich zu legen."));
      switch(dir) {
        case 1:  Start(10); break;
        case 3:  Start(57); break;
        default: Start(10);
      }
    }
  else
    {
      switch( random(10) )
	{
	  case 0: str="\n"+BS("Der Sand treibt Dir die Traenen in die Augen.");
	    break;
	  case 1: str="\n"+BS("Eine Sandlawine begraebt das Lastkamel, doch es kann"+
		    " sich aus dem Sandhaufen befreien.");
	  break;
	  case 2: str="\n"+BS("Ein kleiner Sandwirbel reisst dem Herdenfuehrer den "+
		    "Fez vom Kopf, doch der erwischt ihn und setzt ihn "+
		    "wieder auf.");
	  break;
	  case 3: str="\n"+BS("Der Sand arbeitet an Deiner Haut, wie eine "+
		    "Kaesereibe am Kaese.");
	  break;
	  case 4: str="\n"+BS("Haettest Du diese Reise doch nie angetreten.");
	    break;
	  case 5: str="\n"+BS("Der Wind reisst Dich aus dem Sattel, doch Du kannst "+
		    "Dich im letzten Moment noch festhalten.");
	  break;
	  case 6: str="\n"+BS("Du siehst eine Palme vorbeifliegen und als sie "+
		    "ueber Dir ist, faellt Dir eine Kokosnuss auf den Kopf.");
	  break;
	  case 7: str="\n"+BS("Du siehst ein Kamel samt seinem Reiter vorbeifliegen"+
		    ". Das haettest ja auch Du sein koennen *schluck*.");
	  break;
	  case 8: str="\n"+BS("WUMM...das war ein Sandstoss. Den Sand wirst Du "+
		    "wohl nie wieder aus Deinen Haaren bekommen.");
	  break;
	  case 9: str="\n"+BS("Ah, Du siehst etwas Blaues, koennte das vielleicht "+
		    "der Himmel sein?\nNein, es ist nur ein vorbeifliegendes "+
		    "Zelt.");
	}
      tell_room(TO, str);
      call_out("sturm",5+random(15));
    }
}

varargs string GetExits(object viewer) 
{ 
  return "";
}

