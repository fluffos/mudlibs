#include "../def.h"

inherit "std/transport";

nosave int dir;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Kamel" );
  SetProp(P_INT_LONG, 
	  "Du sitzt hier oben auf einem der sieben Kamele dieser "
	  "Kamelkaravane und bestaunst die atemberaubende Landschaft. "
	  "Dieses riesige Meer mit seinen unberuehrten Sandduenen ist "
	  "voll von Abenteuern und Gefahren, die von Dir erforscht werden "
	  "wollen." );

  SetProp(P_SHORT, "Eine Kamelkaravane" );
  SetProp(P_LONG, 
	  "Du siehst eine Gruppe von sieben Kamelen, wobei das letzte von "
	  "ihnen als Lasttier verwendet wird und das erste dem Herdenfuehrer "
	  "gehoert. Du hoffst, dass Du auch noch ein Kamel ergattern "
	  "kannst, um mit der Kamel-Karavane nach Quaul ziehen zu koennen.");

  SetProp(P_NAME, "Kamelkaravane" );
  AddId(({"karavane","kamel","kamelkaravane"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LIGHT, 1);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_DESERT,ENV_TEMPERATURE:40]));

  AddDetail(({"karavane", "kamel"}),
	    QueryProp(P_INT_LONG) );
  AddDetail(({"sandsturm", "sturm"}),
	    "Sei froh, dass hier keiner ist, sonst wuerde es Dir schlecht "+
	    "gehen.\n");
  AddDetail("himmel", 
	    "Noch ist er blau, aber das kann sich schnell aendern, dann "+
	    "ist er braun vor Sand.\n");
  AddDetail("boden", 
	    "Gottseidank musst Du nicht auf diesem gluehend heissen Sand "+
	    "herumlaufen.\n");
  AddDetail("sand", 
	    "Den gibts hier wirklich ueberall im Ueberfluss.\n");
  AddDetail("herdenfuehrer",
	    "Der Typ ist von der Hitze so ausgedoerrt, dass Du ihn in "+
	    "seinem Gewand ueberhaupt nicht sehen kannst.\n");
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst in einiger Entfernung einen Sandsturm heulen.\n" );
  AddSmell(DEFAULT_SMELL, 
	   "Du riechst nur den durchdringenden Geruch Deines Kamels.\n" );
  SetProp(P_DEPARTMSG, 
	  ({ "Die Kamelkaravane zieht los.\n", 
	      "Eine Kamelkaravane setzt sich in Bewegung und zieht davon.\n"}));
  SetProp(P_ARRIVEMSG, 
	  ({ "Die Kamelkaravane haelt @@QueryArrived@@ an.\n",
	      "Eine Kamelkaravane kommt angetrabt.\n"}));
  SetProp(P_ENTERMSG, 
	  ({ "krabbelt muehsam auf ein Kamel",
	       "zwingt sich auf ein Kamel"}));
  SetProp(P_ENTERFAIL, 
	  "Der Herdenfuehrer sagt: Wir haben nur 5 Kamele." );
  SetProp(P_MAX_PASSENGERS, 6);
  SetProp(P_LEAVEMSG, 
	  ({ "laesst sich aus dem Kamelsattel fallen",
	       "plumpst von dem Kamel herunter"}));
  SetProp(P_LEAVEFAIL, 
	  ({ "Die Kamelkaravane ist doch unterwegs, da kannst Du nicht runter",
	       "wollte den Schutz der Kamele wirklich verlassen"}));

  AddCmd(({"steig", "steige"}), "steig_kamel");
  AddCmd(({"reite"}), "reite_kamel");
  //AddCmd(({"verlass","verlasse"}), "verlassen");

  //  AddItem(NPC "hfuehrer", REFRESH_DESTRUCT);

  dir=0;

  //erstmal Erg
  AddRoute(ERG, 30, 5, "in einer kleinen Kamelstation in der Wueste",
	   ({"wuestenrand","station","kamelstation","erg","rand"}), "an den Rand der Wueste");
  
  AddMsg("\n"+BS("Der Herdenfuehrer zaehlt noch einmal seine Kamele durch und gibt "
         "dann das Zeichen zum Aufbruch."), 4);
  AddFun("dirq",1);
  AddMsg("\n"+BS("Du spuerst einen kurzen Ruck und Dein Kamel setzt sich in "
         "Bewegung."), 4);
  AddMsg("\n"+BS("Und ab geht es nach Suedosten zur uralten Stadt Quaul."), 5);
  AddMsg("\n"+BS("Da Du noch nicht sehr tief in der heissen Wueste bist, laeuft "
         "Dein Kamel noch recht fluessig dahin."), 20);
  AddMsg("\n"+BS("Du schaust Dich um und bist durch die reflektierten "
         "Sonnenstrahlen im Sand sehr geblendet."), 10);
  AddMsg("\n"+BS("Ploetzlich wirst Du von einem entfernten Geraeusch erschreckt. "
         "Das hoert sich doch wirklich wie ein Sandsturm an, oder?"), 2);
  AddFun("sandsturm" ,2);
  AddMsg("\n"+BS("Es war wohl doch kein Sandsturm."), 10);
  AddMsg("\n"+BS("Dein Kamel schaukelt sanft von links nach rechts."), 5);
  AddMsg("\n"+BS("Du setzt Deine Reise fort, merkst aber bald, wie das Kamel in der "
         "Hitze zu wanken beginnt."), 20);
  AddMsg("\n"+BS("Dein Kamel sieht ziemlich erschoepft aus. Du hoffst, dass es den "
         "restlichen Weg schaffen wird."), 20);
  AddMsg("\n"+BS("Dein Kamel aechzt unter Deinem Gewicht."), 5);
  AddMsg("\n"+BS("Als Du Dich einer riesigen Ansammlung von Kamelen und anderen "
         "Lebewesen naeherst, atmest Du erleichtert auf. Denn gleich wirst "
         "Du in Quaul ankommen und das arme Kamel ausruhen lassen koennen."
         ), 10);
  AddFun("kontrolle",2);
  AddMsg("\n"+BS("Zum Schluss wendet sich die Karavane nach Osten und Du kannst "
         "in der Ferne eine Schlucht erkennen. Wahrscheinlich ist das "
         "der Eingang nach Quaul."), 10);
  AddMsg("\n"+BS("Die Schlucht ist jetzt direkt vor Dir."), 5);
  AddMsg("\n"+BS("Langsam aber doch trudelt die Karavane in den Karavanenbahnhof "
	 "von Quaul ein."), 1);

  //zwischenstop in Quaul
  AddRoute(QUAUL, 30, 5, "in Quauls Karavanenbahnhof",
	   ({"schlucht","quaul","bahnhof","karavanenbahnhof"}),"nach Quaul");

  AddMsg("\n"+BS("Sicherheitshalber werden die Kamele noch einmal durchgezaehlt."),3);
  AddFun("dira",1);
  AddMsg("\n"+BS("Da alle anwesend sind, nickt der Herdenfuehrer und ruft: "
         "AUFBRUCH!"), 5);
  AddMsg("\n"+BS("Dein Kamel gehorcht und setzt sich in Bewegung."), 4);
  AddMsg("\n"+BS("Deine Reise nach Arrakeen beginnt entlang eines kilometerlangen "
	 "Kraterrandes. Da moechtest Du nicht unbedingt runterfallen, also "
	 "aenderst Du die Richtung des Kamels etwas nach links."),10);
  AddMsg("\n"+BS("Kurz nachdem Du den Kraterrand hinter Dir gelassen hast, bekommst"
	 " Du irgendwie ein mulmiges Gefuehl."), 5);
  AddFun("kontrolle",2);
  AddMsg("\n"+BS("War wohl doch nichts. Vielleicht ist das wegen der Hitze "
	 "hier."),20);
  AddMsg("\n"+BS("Dir rinnen Schweissperlen ueber das Gesicht."), 4);
  AddMsg("\n"+BS("In einiger Entfernung ist ein Sandsturm zu hoeren und der "
    "Herdenfuehrer beschliesst etwas schneller weiterzuziehen."), 2);
  AddMsg("\n"+BS("Dein Kamel gibt jetzt richtig Gas und seine Hoecker "
    "schwabbeln stark hin und her."), 15);
  AddMsg("\n"+BS("Die Kamele keuchen vor Anstrengung."), 4);
  AddMsg("\n"+BS("Ploetzlich siehst Du etwas vor Dir auf dem Weg."), 2);
  AddFun("fata_morgana",5);
  AddMsg("\n"+BS("Als Dein Kamel naeher kommt, merkst Du, dass es nur eine "
    "Fata Morgana war. Du seufzt leise auf."), 4);
  AddMsg("\n"+BS("Als Du Dich von diesem Schicksalsschlag erholt hast, richtest Du "
	 "Deinen Blick wieder nach vorn."), 10);
  AddMsg("\n"+BS("Sind dort in der Ferne etwa Stadtmauern zu erkennen?"), 4);
  AddMsg("\n"+BS("Oder sollte es sich gar um eine Oase handeln?"), 4);
  AddMsg("\n"+BS("Und tatsaechlich, da siehst Du auch schon eine kleine Oase direkt vor Dir."), 5);

  //und ueber Arrakeen zurueck
  AddRoute(ARRAKEEN, 30, 5, "an einem kleinen See in der Naehe von Arrakeen",
	   ({"see","arakeen","arrakeen","oase"}),"nach Arrakeen");
  
  AddMsg("\n"+BS("Der Herdenfuehrer treibt die Kamele an und der Ritt geht "
    "los."),3);
  AddFun("dire",1);
  AddMsg("\n"+BS("Die Karavane richtet sich nach Westen und kommt recht "
    "schnell voran."),10);
  AddMsg("\n"+BS("Eine kleine Oase kommt in Sicht..."),3);
  AddMsg("\n"+BS("Die Karavane zieht gemuetlich an der Oase vorbei."),10);
  AddMsg("\n"+BS("Nachdem die Oase weit hinter Dir liegt, bekommst Du doch "
    "auf einmal sehr viel Durst."),5);
  AddMsg("\n"+BS("Mitten auf dem Weg liegt ein verendeter Elefant und die "
    "Karavane ist gezwungen ihn zu umgehen."),10);
  AddMsg("\n"+BS("Ein ploetzlicher Windstoss weht Dir Sand in die Augen."),20);
  AddMsg("\n"+BS("Dein Kamel trabt gemuetlich weiter nach Westen."),5);
  AddMsg("\n"+BS("Ploetzlich taucht neben der Karavane eine Gestalt auf..."),2);
  AddFun("kontrolle",2);
  AddMsg("\n"+BS("Die Gestalt verschwindet wieder..."),10);
  AddMsg("\n"+BS("Am Horizont zeichnen sich die Umrisse eines grossen "
    "Gebirges ab. Du naeherst Dich wohl schon dem Rand der Wueste."),5);
  AddMsg("\n"+BS("Das Gebirge rueckt immer naeher und wirkt von Schritt "
    "zu Schritt bedrohlicher."),10);
  AddMsg("\n"+BS("Direkt vor Euch wird auf einmal der Sand stark aufgewirbelt. "
    "Du bekommst richtig Angst! Hoffentlich handelt es sich dabei nicht "
    "um einen Sandsturm..."),5);
  AddFun("sandsturm",2);
  AddMsg("\n"+BS("Zum Glueck war es doch kein Sandsturm!"), 10);
  AddMsg("\n"+BS("Aus einiger Entfernung bemerkst Du eine kleine Huette am "
    "Fusse eines grossen Felsbrockens. Ob das wohl schon das Ziel ist?"),10);
  AddMsg("\n"+BS("Der Herdenfuehrer ruft etwas Unverstaendliches, worauf "
    "sich die Kamele in einen gemaessigten Schritt begeben und auf die "
    "kleine Huette zusteuern."),5);
  AddMsg("\n"+BS("Langsam laeuft die Karavane im Karavanenbahnhof ein und "
    "kommt zum Stehen."),2);

  Start();
}

void dirq() { dir=1; }
void dira() { dir=2; }
void dire() { dir=3; }

void init()
{
  ::init();

  if(interactive(this_player()))
    {
      catch(call_other(QUAUL, "???"));
      catch(call_other(ARRAKEEN, "???"));
      catch(call_other(ERG, "???"));
    }
}

nosave int reite_kamel(string str)
{
  notify_fail(BS("Worauf willst Du denn reiten?"));

  if(str=="auf kamel"||str=="mit kamel")
    return Enter(TP);

  if(str=="kamel"||str=="karavane"||str=="kamelkaravane")
    return notify_fail("Deine Rechtschreibung laesst aber zu wuenschen uebrig.\n"),0;
  
  if(str=="auf karavane"||str=="auf kamelkaravane")
    return notify_fail(BS("Vielleicht solltest es zuerst mit nur einem Kamel "
			  "versuchen, und nicht gleich mit der ganzen "
			  "Kamelkaravane.")),0;
  return 0;
}

nosave int steig_kamel(string str)
{
  object fs;
  
  notify_fail(BS("Du steigst in einen Haufen Kameldreck."));

  if(str=="von kamel"||str=="vom kamel"||str=="von kamel ab"||
     str=="vom kamel ab" ||str=="ab")
    {
      if(fs=present(FAHRSCHEIN,TP))
	{
	  write("Ein kleiner Gnom meint: 'Den brauchst Du jetzt nicht mehr!'\n"
		"Mit diesen Worten nimmt er Dir den Fahrschein weg und "
		"verschwindet.\n");
	  fs->remove();
	}
      return Leave(TP);
    }
  
  if(str=="von kamelkaravane"||str=="von karavane"||
     str=="von kamelkaravane ab"||str=="von karavane ab")
    if(present(TP, ME))
      return notify_fail("Aber Du sitzt doch nur auf einem Kamel.\n"),0;
    else
      return notify_fail("Aber Du sitzt doch gar nicht auf einem Kamel.\n"),0;

  if(str=="kamel"||str=="karavane"||str=="kamelkaravane")
    return notify_fail("Deine Rechtschreibung laesst aber zu wuenschen uebrig.\n"),0;

  if(str=="auf kamel")
    return Enter(TP);

  if(str=="auf karavane"||str=="auf kamelkaravane")
    return notify_fail(BS("Vielleicht solltest es zuerst mit nur einem Kamel versuchen"+
		 ", und nicht gleich mit der ganzen Kamelkaravane.")),0;
  return 0;
}

