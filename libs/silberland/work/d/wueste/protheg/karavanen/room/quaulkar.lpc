#include "../def.h"

inherit MOST "std_room";

#define MAX_AMOUNT 500
#define DESERT "/d/wueste/zordan/desert/room/desert"

nosave int amount, oft;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Karavanen-Bahnhof");
  SetProp(P_INT_LONG,
	  BS("Du befindest dich auf Quauls Karavanen-Bahnhof. Hier herrscht "
	     "den ganzen Tag reges Treiben, wo du auch hinsiehst laufen "
	     "Kamele und ganze Karavanen kreuz und quer herum. Du wunderst "
	     "Dich, ob es hier ueberhaupt Irgendjemanden gibt der sich hier "
	     "auskennt."));

  AddDetail(({"quaul", "krater"}),
	    "Die Stadt Quaul soll angeblich in einem Krater liegen...");

  AddDetail("karavane",
	    "Es wird sicher irgendwo eine sein die Dich mitnimmt.");

  AddDetail("karavanen",
	    "Davon gibt es hier sehr viele, suchst Du eine bestimmte?");

  AddDetail(({"karavanen-bahnhof","bahnhof","karavanenbahnhof"}),
	    QueryProp(P_INT_LONG));

  AddDetail("tag",
	    "Ein wunderschoener Tag mit einem blauen Himmel und einer Sonne,"
	    " die Dir froehlich zulaechelt.");

  AddDetail("himmel",
	    "In weiter Ferne siehst Du ein paar Geier kreisen.");

  AddDetail("geier",
	    "Gott sei Dank sind die weit, weit entfernt.");

  AddDetail(({"dank","spruch"}),
	    "Das ist doch nur so ein Spruch!");

  AddDetail("ferne",
	    "Mit blossen Augen kannst Du in der Ferne Umrisse einer Stadt "
	    "erkennen.");

  AddDetail("augen",
	    "Wenn Du einen Spiegel haettest, koenntest Du sie untersuchen.");

  AddDetail("spiegel",
	    "Du schaust in den Spiegel und kommst drauf, dass Du dich wieder"
	    "einmal waschen solltest.");

  AddDetail("treiben",
	    "Ab und zu siehst Du einige vermummte Maenner herumlaufen.");

  AddDetail("maenner",
	    "Sie scheinen Dich zu ignorieren, denn sie haben anscheinend "
	    "wichtigeres zu tun, als sich mit Dir zu unterhalten.");

  AddDetail("umrisse",
	    "Leider kannst Du nichts naeheres erkennen.");

  AddDetail("stadt",
	    "Du kannst nichts erkennen, weil da ein Sandsturm wuetet.");

  AddDetail(({"sandsturm","sturm"}),
	    "Viele, viele kleine Sandkoerner!");

  AddDetail(({"sandkoerner","koerner"}),
	    "Wenn Du sie zaehlen willst, tu Dir keinen Zwang an!");

  AddDetail("zwang",
	    "Keiner zwingt Dich, aber wenn Du zaehlen willst, dann zaehle!");

  AddDetail("kamele",
	    "Hier laufen so viele Lebewesen herum, die der Gattung Kamel "
	    "angehoeren, suchst Du ein bestimmtes?");

  AddDetail("gattung",
	    "Es sind natuerlich auch noch andere Gattungen hier, wie zum "
	    "Beispiel Dich, oder bist Du auch ein Kamel?");

  AddDetail("beispiel",
	    "Untersuch nicht alles! Oder bist Du etwa ein Script?");

  AddDetail("script",
	    "Die sind im Silberland verboten!");

  AddDetail("silberland",
	    "Richtig! Du bist hier im Silberland.");

  AddDetail("irgendjemand",
	    "Naja, irgendjemand wird schon zustaendig sein, um Ordnung in "
	    "dieses Chaos zu bringen.");

  AddDetail("ordnung",
	    "Von Ordnung kann man hier aber wirklich nicht sprechen.");

  AddDetail("chaos",
	    "Dem Chaos nach zu urteilen, hat hier schon lange kein Aufpasser"
	    " mehr vorbeigesehen.");

  AddDetail(({"aufpasser","lebewesen"}),
	    "Als Du so die Leute hier beobachtest, faellt Dir ein ziemlich "
	    "kleines graues Wesen auf, dass recht aufmerksam das Treiben "
	    "hier mit den Augen verfolgt.");

  AddDetail("leute",
	    "Hier laufen ziemlich viele Leute herum, aber keiner scheint Dich"
	    " zu beachten.");

  AddDetail(({"wesen","aufpasser"}),
	    "Du gehst naeher zu ihm hin und siehst, dass er einen Zettel "
	    "im Schoss liegen hat.");

  AddDetail("schoss",
	    "Da liegt ja ein Zettel in seinem Schoss.");

  AddDetail("zettel",
	    "Du kannst einige Schriftzeichen erkennen. Vielleicht solltest "
	    "Du versuchen sie zu lesen!");

  AddDetail(({"schriftzeichen","zeichen"}),
	    "Die sind zum lesen da!");

  AddDetail("boden",
	    "Ueberall wo Du auch hinsiehst, sind Spuren von Kamelen und "
	    "deren Treibern.");

  AddDetail(({"fuehrer","herdenfuehrer","treiber","treibern"}),
	    "Das sind die Leute, die die Kamele antreiben bzw. fuehren.");

  AddDetail("schleifspuren",
	    "Die fuehren hier kreuz und quer ueber den Boden und duerften "
	    "von irgendwelchen schweren Lasten stammen.");

  AddDetail(({"gueter","lasten","last"}),
	    "Viele Karavanen ziehen hier mit ihren Lasten und Guetern durch.");

  AddDetail(({"spuren","fussspuren","kamelspuren"}),
	    "Fussspuren, Kamelspuren, Schleifspuren usw.");

  AddDetail("fusspuren",
	    "Eigentlich schreibt man die mit 3 s!");

  AddDetail("sonne",
	    "Die Sonne scheint erbarmungslos auf Dich herab.");

  AddReadDetail(({"zettel","zeichen","schriftzeichen"}),
		"Ich sein frueher Aufpasser, aber dann mich Kollegen "
		"entlassen weil ich nix gut verstehen. Seitdem hier "
		"gross Chaos herrschen und ich nix Arbeit mehr finden."
		"Bitte spenden bissi Geld!");

  AddExit("norden",    "/d/wueste/protheg/kraterrand/room/krater_1_0_0");
  AddExit("sueden",    "/d/wueste/protheg/kraterrand/room/krater_3_0_0");
  AddExit("osten",     "/d/wueste/protheg/kraterrand/room/krater_2_1_0");

  AddExit("westen",    DESERT ":64:35");
  AddExit("nordwesten",DESERT ":64:34");
  AddExit("suedwesten",DESERT ":64:36");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
  
  amount=oft=0;
  AddCmd("spende","spendenfkt");
  
  AddItem(OBJ "fsauto" , REFRESH_DESTRUCT);
}

void init()
{
  ::init();

  catch(call_other(ERG, "???"));
}

void reset()
{
  ::reset();

  oft=0;
}

nosave int spendenfkt(string str)
{
  int muenzen,geld;
  object el;

  notify_fail(BS("Wieviele Muenzen willst Du denn dem Alten spenden?"));
  if(!str) return 0;
  
  if(str=="1 muenze") 
    return write("Sei nicht so hartherzig!\n"),1;
  
  if(sscanf(str, "%d muenzen", muenzen)==1)
    {
      if(!muenzen || muenzen < 0)
	return write("Sei nicht so hartherzig!\n"),1;

      if((!geld=TP->QueryMoney()) || (geld < muenzen))
	return write("Soviel hast Du doch gar nicht bei Dir!\n"),1;

      write(BS("Du hast Mitleid mit dem armen Alten, deswegen gibts Du "
	       "ihm etwas Geld."));
      say(TPN+" gibt einem alten Mann etwas Geld.\n", ({TP}));

      amount+=muenzen;

      if((amount>=MAX_AMOUNT) && (oft<5))
	{
	  write("Der alte Mann blickt Dich aus feuchten Augen an und streckt "
		"Dir seine Hand mit einem Geschenk hin.\n"
		"Der Alte meint: Danke fuer Spende! Ich Dich schenken dieser "
		"Stein dafuer!\n"
		"Dankend nimmst Du den Stein an Dich.\n");

	  el=clone_object("/obj/gems/"+
		  ({"amethyst", "aquamarin", "bergkristall", "bernstein",
		      "diamant", "granat", "lapislazuli", "onyx", "opal",
		      "rubin", "saphir", "smaragd", "topas", "turmalin",
		      "zirkon"})[random(13)]);

	  TP->AddMoney(-muenzen);
	  el->move(TP,M_NOCHECK);

	  amount-=MAX_AMOUNT;

	  oft++;

	  write_file(LOG "spenden", ctime()+" : "+TP->Name()+" bekommt "+
		     el->name(WEN)+" fuer "+muenzen+" Muenzen.\n");
	  return 1;
	}
      else
	return write("Der alte Mann blickt Dich dankend an.\n"),1;
    }
  return 0;
}
