/*
  Ein Fahrschein fuer die Reise mit der Karavane...
*/

#pragma strong_types;

inherit "std/thing";

#include "../def.h"

nosave string owner;

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Fahrschein");
  SetProp(P_LONG, BS("Wozu wird man wohl einen Fahrschein brauchen?"));
  SetProp(P_NAME, "Fahrschein");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddId(({FAHRSCHEIN,"schein","fahrschein"}));
}

void SetOwner(string spieler)
{
  owner=spieler;

  SetProp(P_LONG, 
	  BS("Dieser Fahrschein gehoert "+CAP(owner)+" und gilt deswegen "+
	     "nur wenn Du "+CAP(owner)+" bist!"));
}

string QueryOwner()
{
  return owner;
}
