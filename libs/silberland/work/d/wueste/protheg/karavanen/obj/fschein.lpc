/*
  Ein Fahrschein fuer die Reise mit der Karavane...
*/

#pragma strong_types;

inherit "std/thing";

#include "../def.h"

nosave string owner;

void create()
{
  ::create();

  SetProp(P_SHORT, "Eine Mitfahrerlaubnis");
  SetProp(P_LONG, 
	  BS("Diese Mitfahrerlaubnis gilt fuer eine Fahrt mit der Karavane "
	     "zwischen Erg - Quaul - Arrakeen."));

  SetProp(P_NAME, "Mitfahrerlaubnis");
  SetProp(P_GENDER, FEMALE);

  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOBUY, 1);

  SetProp(P_NODROP, 
	  BS("Das Papier entsorgt sich selber, wenn es ungueltig ist"));
  SetProp(P_NEVERDROP, 1);

  AddId(({FAHRSCHEIN,"erlaubnis","mitfahrerlaubnis","fahrschein"}));
}

void SetOwner(object spieler)
{
  owner=getuid(spieler);

  SetProp(P_LONG, 
	  BS("Diese Mitfahrerlaubnis berechtigt "+CAP(owner)+" fuer eine "
	     "Fahrt mit der Karavane zwischen Erg - Quaul - Arrakeen."));
}

string QueryOwner()
{
  return owner;
}
