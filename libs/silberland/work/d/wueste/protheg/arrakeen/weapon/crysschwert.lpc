#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{
  if(!is_clone(TO)) return;
  
  ::create();
  
  AddId(({"crys-schwert", "schwert", "waffe"}));
  
  SetProp(P_INFO, 
	  BS("Crys-Schwerter wie dieses werden aus den Zaehnen von Sandwuermern "+
	     "gefertigt. Sie sind dadurch besonders leicht und einfach zu fuehren.\n"));
  SetProp(P_MATERIAL, ([MAT_GOLD:20,MAT_IVORY:80]));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 50+random(10));
  
  SetProp(P_WC_BONUS, (["\narrakeenwaechter":100]));
  
  DefineType();
}

nosave DefineType()
{
  switch(random(4))
    {
    case 1:
      SetProp(P_SHORT, "Ein Crys-Langschwert");
      SetProp(P_LONG, 
	      BS("Das ist ein Crys-Langschwert, wie es die Fremen als Waffe "+
		 "verwenden. Es ist sehr leicht und unglaublich stabil.\n"));
      SetProp(P_NAME, "Crys-Langschwert");
      SetProp(P_WC, 160+random(10));
      SetProp(P_WEIGHT, QueryProp(P_WC)*4);
      SetProp(P_VALUE, QueryProp(P_WC)*7);
      SetProp(P_SIZE, 120);
      break;
    case 2:
      SetProp(P_SHORT, "Ein Crys-Breitschwert");
      SetProp(P_LONG, 
	      BS("Das ist ein Crys-Breitschwert, wie es die Fremen als Waffe "+
		 "verwenden. Es ist sehr leicht und unglaublich stabil.\n"));
      SetProp(P_NAME, "Crys-Breitschwert");
      SetProp(P_WC, 200+random(10));
      SetProp(P_NR_HANDS, 2);
      SetProp(P_WEIGHT, QueryProp(P_WC)*4);
      SetProp(P_VALUE, QueryProp(P_WC)*7);
      SetProp(P_SIZE, 100);
      SetProp(P_WC_FIX, 40);
      break;
    case 3:
      SetProp(P_SHORT, "Ein Crys-Krummschwert");
      SetProp(P_LONG, 
	      BS("Das ist ein Crys-Krummschwert, wie es die Fremen als Waffe "+
		 "verwenden. Es ist sehr leicht und unglaublich stabil.\n"));
      SetProp(P_NAME, "Crys-Krummschwert");
      SetProp(P_WC, 160+random(10));
      SetProp(P_WEIGHT, QueryProp(P_WC)*4);
      SetProp(P_VALUE, QueryProp(P_WC)*7);
      SetProp(P_SIZE, 90);
      break;
    default:      
      SetProp(P_SHORT, "Ein Crys-Kurzschwert");
      SetProp(P_LONG, 
	      BS("Das ist ein Crys-Kurzschwert, wie es die Fremen als Waffe "+
		 "verwenden. Es ist sehr leicht und unglaublich stabil.\n"));
      SetProp(P_NAME, "Crys-Kurzschwert");
      SetProp(P_WC, 110+random(10));
      SetProp(P_WEIGHT, QueryProp(P_WC)*4);
      SetProp(P_VALUE, QueryProp(P_WC)*7);
      SetProp(P_SIZE, 60);
    }
}
