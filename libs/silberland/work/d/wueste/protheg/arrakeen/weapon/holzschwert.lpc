/*
  Ein Holzschwert fuer die Kinder von Arrakeen
*/

#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzschwert");
  SetProp(P_LONG,
	  BS("Ein kleines Holzschwert, wie es kleine Kinder benuetzen, damit "
	     "sie sich nicht verletzen. Es hat eine lange hoelzerne Klinge, "
	     "ein breites Schwertheft, um die Finger zu schuetzen und einen "
	     "gerillten Griff."));
  SetProp(P_NAME, "Holzschwert");
  SetProp(P_GENDER, NEUTER);
  AddId(({"holzschwert", "schwert", "waffe"}));
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 25);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:100]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 45);
  SetProp(P_VALUE, 20);
  SetProp(P_WC_BONUS, (["NPC":100]));
  SetProp(P_HIT_FUNC, TO);
  
  AddDetail(({"klinge","holzklinge","hoelzerne klinge"}),
	    "Das Holzschwert besitzt eine lange hoelzerne Klinge aus "
	    "Eichenholz.");
  AddDetail(({"holz","eiche","eichenholz"}),
	    "Das ganze Schwert besteht aus robustem Eichenholz, welches die "
	    "Kaempfe der Kinder ueberstehen soll.");
  AddDetail(({"heft","schwertheft"}),
	    "Das Schwertheft schuetzt bei allzu leidenschaftlichen Kaempfen "
	    "die Finger des Schwerttraegers.");
  AddDetail(({"griff","schwertgriff","holzgriff","aussehen","edles aussehen"}),
	    "Der Holzgriff ist gerillt und gibt damit dem Schwert ein "
	    "etwas edleres Aussehen.");
}

int HitFunc(object e)
{
  if((ENV(ME)) && (interactive(ENV(ME))))
    return -100;
}
