#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

inherit "std/weapon";

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"schere", "gartenschere"}));
  SetProp(P_SHORT, "Eine alte, rostige Gartenschere");
  SetProp(P_LONG, 
	  BS("Die Gartenschere ist schon leicht rostig und sieht sehr gebraucht aus.\n"));
  SetProp(P_NAME, "Gartenschere");
  SetProp(P_NAME_ADJ, ({"alt","rostig"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_WC, 60);
  SetProp(P_SIZE, 70);
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 300);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, ({DT_POISON,DT_PIERCE}));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_DAMAGED, 60);
  SetProp(P_MATERIAL, ([MAT_WOOD:20, MAT_IRON:80]) );
}
