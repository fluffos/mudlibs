#include "../def.h"

inherit MOST "std_room";

#define PREIS 100
#define HLB_DSCH "/d/dschungel/dante/tijaraneu/room/ti_pfad14"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp(P_INT_LONG,
	  BS("Du stehst in einer Gasse in Arrakeen. Die Haeuser bestehen aus "
	     "schwarzem Stein. Aus dem Sueden kannst Du schon den Marktlaerm "
	     "hoeren. Auf dem Boden liegt eine duenne Schicht aus Sand und "
	     "Staub. Eine grosse Holzkonstruktion mit einer Holztreppe, an "
	     "deren Ende ein Schild befestigt ist, steht hier."));

  AddSound(({DEFAULT_SOUND}),
	   "Du hoerst den Laerm einer geschaeftigen Stadt.");
  AddSound(({"laerm"}),
	   "Du hoerst den typischen Laerm einer Stadt.");
  AddDetail(({"arrakeen", "hauptstadt", "stadt"}),
	    "Du stehst in Arrakeen, der Hauptstadt der Wueste.");
  AddDetail(({"wueste"}),
	    "Die Wueste beginnt nahe der Stadt.");
  AddDetail(({"magier"}),
	    "Es wird erzaehlt, dass Muaddib an der Erbauung von Arrakeen "
	    "beteiligt war.");
  AddDetail(({"erbauung"}),
	    "Die Erbauung von Arrakeen ist sicher auf einen Magier "
	    "zurueckzufuehren.");
  AddDetail(({"sand", "schicht", "staub"}),
	    "Der Boden ist mit mit einer duennen Schicht aus Sand und Staub "
	    "ueberzogen, die vermutlich aus der nahen Wueste heruebergeweht "
	    "wurde.");
  AddDetail(({"boden"}),
	    "Der Boden ist mit einer duennen Schicht aus Sand und Staub "
	    "bedeckt.");
  AddDetail(({"gasse"}),
	    "Eine einfache Gasse in Arrakeen.");
  AddDetail(({"haeuser", "haus"}),
	    "Die Haeuser sind hier aus Stein gebaut.");
  AddDetail(({"haendler", "marktlaerm"}),
	    "Du hoerst Haendler schreien.");
  AddDetail(({"stein"}),
	    "Das ist jetzt wirklich nicht wichtig.");
  AddDetail(({"treppenende","ende","holztreppenende"}),
	    "Am Ende der Holztreppe ist ein Schild befestigt.");
  AddDetail(({"konstruktion","holzkonstruktion"}),
	    "Eine seltsam anmutende Holzkonstruktion, die entfernt an einen "
	    "Galgen erinnert.");
  AddDetail(({"galgen"}),
	    "Nein, das ist ganz sicher kein Galgen, da bist Du Dir ziemlich "
	    "sicher.");
  AddDetail(({"treppe","holztreppe"}),
	    "Eine hoelzerne Treppe fuehrt hinauf zu einem Podest auf der "
	    "Holzkonstruktion.");
  AddDetail(({"podest","holzpodest"}),
	    "Das Podest ist mit einem roten Teppich belegt und an den "
	    "Raendern liegen dicke, zusammengerollte Taue.");
  AddDetail(({"schild","holzschild"}),
	    "Auf dem Schild steht eine Art Fahrplan.");
  AddDetail(({"plan","fahrplan"}),
	    "Der steht auf dem Schild.");
  AddDetail(({"rand","podestrand","raender","podestraender"}),
	    "An den Raendern des Podestes liegen einige zusammengerollte "
	    "Taue.");
  AddDetail(({"teppich"}),
	    "Ein roter Teppich zieht sich vom Podest bis hier herunter "
	    "ans Ende der Treppe. Er wird offensichtlich oft benutzt, "
	    "oder mindestens gereinigt, da er vollkommen frei von Sand ist.");
  AddDetail(({"tau","taue"}),
	    "Dicke zusammengerollte Taue liegen auf dem Podest. Wofuer man "
	    "sie wohl braucht?");
  AddReadDetail(({"schild","holzschild","treppenschild","treppenholzschild",
		    "plan","fahrplan"}),
	make_document(duplicate(" ",10)+
	" Wagen Sie eine Fahrt mit dem Heissluftballon!\n"+
	duplicate(" ",10)+
	"-----------------------------------------------\n\n"
	" Kommen  Sie und erholen  sie sich bei  einer Reise mit  unserem\n"
	" wunderbaren Heissluftballon. Geniessen Sie die ueberwaeltigende\n"
	" Aussicht und lassen Sie sich den  heissen Wuestenwind durch die\n"
	" Haare wehen...\n\n"
	" Eine Ueberfahrt kostet nur "+PREIS+" Muenzen.\n\n"
	"                                               Ihre Reiseleitung\n"));
  AddSpecialDetail(({"himmel"}), "himmelguggn");

  Licht("hell");
  Umgebung("heiss", TT_TOWN, 0);
  Ausgaenge("ara",({"westen","osten","norden","sueden"}));
  
  AddItem(ROOM "hlb", REFRESH_DESTRUCT, 1);
}

nosave himmelguggn()
{
  if(present("\nballon"))
    return "Der Himmel wird von einem grossen, bunten Heissluftballon verdeckt.\n";
  else
    return "Ein strahlendblauer Himmel breitet sich ueber Dir aus.\n";
}

void init()
{
  ::init();
  
  if((TP) && (interactive(TP)))
    call_other(HLB_DSCH, "???");
}
