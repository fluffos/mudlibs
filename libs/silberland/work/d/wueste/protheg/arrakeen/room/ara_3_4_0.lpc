#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Der Marktplatz von Arrakeen");
  SetProp(P_INT_LONG,
	  BS("Du stehst auf einem Marktplatz, auf dem hektisches Treiben "
	     "herrscht. Ueberall sind Staende aufgebaut, an denen die "
	     "unterschiedlichsten Dinge feilgeboten werden. In der Luft "
	     "haengt ein seltsamer Geruch. Der Laerm hier ist wohl der "
	     "Ursprung des Laermes in der ganzen Stadt."));

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht nach diversen Lebensmitteln und Gewuerzen, die man hier "
	   "kaufen kann.");

  AddDetail(({"dinge"}),
	    "Hier kann man wohl all das kaufen, was normale Laeden nicht "
	    "bieten. Hier bekommt man sicher auch Imitate von "
	    "Fremenausruestung.");

  AddDetail(({"fremenausruestung", "imitate"}),
	    "Ob diese echt aussehenden Imitate auch so funktionieren, wie die "
	    "Originale, kannst Du Dir nicht vorstellen.");

  AddDetail(({"laden", "laeden"}),
	    "So etwas siehst Du hier nicht. Hier stehen nur Staende herum.");

  AddDetail(({"staende"}),
	    "Bei sovielen Staenden verlierst Du die Uebersicht.");

  AddDetail(({"uebersicht"}),
	    "Die hast Du schon laengst verloren.");

  AddSound(({DEFAULT_SOUND}),
	   "Die Haendler und Kunden schreien hier so laut, dass man das "
	   "sicher durch die ganze Stadt hoeren kann.");

  AddDetail(({"geruch"}),
	    "Das kannst Du so nicht untersuchen.");

  AddDetail(({"laerm"}),
	    "Wenn Du Dich konzentrierst, vielleicht kannst Du ja was hoeren?");

  AddDetail(({"marktplatz", "platz"}),
	    "Du stehst mitten auf dem Platz.");

  AddDetail(({"luft"}),
	    "Vielleicht solltest Du mal schnuppern?");

  AddDetail(({"arrakeen", "hauptstadt", "stadt", "wueste"}),
	    "Arrakeen ist die Hauptstadt der Wueste und Du stehst mitten in "
	    "der Stadt.");

  AddDetail(({"ursprung"}),
	    "Das ist doch nicht so wichtig, oder?");

  AddDetail(({"treiben"}),
	    "Hier ist es ziemlich voll, dafuer, dass der Platz nur so klein "
	    "ist.");

  AddDetail(({"original", "originale"}),
	    "Ueber die Originale erzaehlt man sich viel. Vielleicht besitzt "
	    "auch Du mal eines...");

  Licht("hell");
  Umgebung("heiss", TT_TOWN, 0);

  Ausgaenge("ara",({"westen","sueden","norden"}));
  //Ausgaenge("palast", ({"ostoben#in den Garten"}));

  AddItem(NPC "stadtwaechter", REFRESH_DESTRUCT);
  AddItem(NPC "citizen", REFRESH_DESTRUCT);
  AddItem(NPC "citizen", REFRESH_DESTRUCT);
}
