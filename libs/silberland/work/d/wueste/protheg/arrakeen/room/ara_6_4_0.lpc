#include "../def.h"

inherit MOST "std_room";

#define WIZNAME "andyl"
#define ANSCHLUSS "/d/wueste/andyl/kanalisation/room/haus"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Weg in Arrakeen");
  SetProp(P_INT_LONG,
	  BS("Du stehst hier auf einem Weg in Arrakeen. Noerdlich von Dir "
	     "siehst Du das Armenviertel der Stadt. Du siehst viele "
	     "Lehmbauten, die meisten davon sind bereits extrem baufaellig, "
	     "und loechrige Zelte welche sich aneinander reihen. Eine Huette "
	     "im Norden scheint man betreten zu koennen. Suedlich von Dir "
	     "befindet sich die schuetzende schwarze Mauer, welche um die "
	     "Stadt herumfuehrt."));

  AddDetail(({"arrakeen", "stadt", "wuestenstadt"}),
	    "Du stehts hier in der grossen, von Menschen erbauten, "
	    "Wuestenstadt Arrakeen.");

  AddDetail(("boden"),
	    "Der Boden besteht aus festgetretener, trockener Erde und "
	    "jeder Menge Sand.");

  AddDetail(("erde"),
	    "Die Erde ist hier extremst trocken, kein Wunder bei dem Wetter.");

  AddDetail(("wunder"),
	    "Ist es eben nicht.");

  AddDetail(("menge"),
	    "Ist sicher nicht wenig.");

  AddDetail(("weg"),
	    "Du stehts hier auf einem Weg der die Stadtmauer entlangfuehrt.");

  AddDetail(("huette"),
	    "Ein kleine, wackelige Huette aus getrocknetem Lehm im "
	    "Armenviertel faellt Dir auf. Man scheint sie betreten "
	    "zu koennen.");

  AddDetail(("menschen"),
	    "Menschen haben diese Stadt erbaut und wohnen auch hier.");

  AddDetail(({"armenviertel", "viertel"}),
	    "Noerdlich von Dir befindet sich das Armenviertel der Stadt. "
	    "Dort leben alle armen Menschen, die sich aus verschiedensten "
	    "Gruenden keine bessere Unterkunft leisten koennen.");

  AddDetail(({"armut", "gruende"}),
	    "Gruende fuer Armut gibt es viele.");

  AddDetail(({"unterkunft", "unterkuenfte"}),
	    "Gute Unterkuenfte kannst Du nirgends im Armenviertel entdecken.");

  AddDetail(({"lehmbauten", "bauten"}),
	    "Die meisten Lehmbauten sind bereits in sich zusammengefallen "
	    "oder zumindest sehr baufaellig.");

  AddDetail(({"lehm", "getrockneten lehm"}),
	    "Getrockneter Lehm wird in der Wueste recht haeufig eingesetzt.");

  AddDetail(("wueste"),
	    "Schau ueber die Mauer, dann siehst Du Sand und noch mehr Sand. "
	    "Das nennt sich dann Wueste.");

  AddDetail(({"sand", "platz"}),
	    "Sand gibt es hier genug. Waere es hier nicht gar so heiss, waere "
	    "dies der ideale Platz zum Sandburgen bauen.");

  AddDetail(({"sandburg", "sandburgen", "sandburgenbauen"}),
	    "Zum Sandburgenbauen ist es hier einfach zu heiss.");

  AddDetail(({"zelte", "zelt"}),
	    "Die Zelte sind zum groessteil loechrig und wuerden bei einem "
	    "heftigeren Sandsturm wohl problemlos weggeweht werden.");

  AddDetail(({"sandsturm", "sturm", "stuerme", "sandstuerme"}),
	    "Na hoffentlich erlebst Du so ein Wetter nicht. Derzeit ist "
	    "davon zumindest nichts zu entdecken.");

  AddDetail(({"wetter", "himmel", "sonne"}),
	    "Gnadenlos brennt die Sonne aus dem blauen Himmel auf Dich "
	    "herab.");

  AddDetail(({"mauer", "stadtmauer"}),
	    "Die Mauer, welche eine schwarze Faerbung hat, umgibt die ganze "
	    "Stadt und bietet so Schutz vor herumstreunenden Monstern, "
	    "wilden Tieren oder anderen Feinden.");

  AddDetail(("schutz"),
	    "Die dicken Mauern sollten genuegend Schutz vor diversen "
	    "boesartigen Ereignissen bieten.");

  AddDetail(({"ereignisse", "boesartige ereignisse"}),
	    "Sandstuerme, wilde Tiere, Monster, andere Feinde, etc.");

  AddDetail(({"monster", "tiere", "wilde tiere", "feinde"}),
	    "Derzeit sind keine zu sehen.");

  AddDetail(("faerbung"),
	    "Die schwaerzliche Faerbung der Mauer scheint nicht die "
	    "urspruengliche Farbe gewesen zu sein.");

  AddDetail(({"farbe", "urspruengliche Farbe"}),
	    "Du kannst leider nur raten was die urspruengliche Farbe der "
	    "Mauer war.");

  AddSound(DEFAULT_SOUND,
	   "Du glaubst ein leises Jammern aus Norden zu vernehmen.");

  AddSound(("jammern"),
	   "Das Jammern scheint aus der Huette zu kommen.");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht in etwa wie man es in einer Wuestenstadt erwartet. "
	   "Dir faellt also nichts ungewoehnlich auf.");  

  AddExit("huette", ([EX_DEST: ANSCHLUSS,
		      EX_MSG: "in die Huette"]));
  
  AddCmd(CMD_BETRETEN, "ins_haus");
  
  Licht("hell");
  Umgebung("heiss",TT_TOWN, 0);  
  Ausgaenge("ara",({"westen","osten"}));
}

nosave int ins_haus(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(member(({"huette","haus"}), str)==-1) return 0;
  
  write(BS("Vorsichtig betrittst Du die kleine, wackelige Huette..."));
  say(BS(TPN+" betritt vorsichtig die kleine, wackelige Huette..."), ({TP}));
  
  TP->move(ANSCHLUSS, M_GO);
  
  return 1;
}
