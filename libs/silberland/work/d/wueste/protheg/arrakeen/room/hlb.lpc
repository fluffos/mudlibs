/*

  Eine Heissluftballonfahrt die ist lustig...

  verbindet Osttijara-Dschungel mit Arrakeen-Wueste

*/

inherit "std/transport";
inherit "std/pub";

#include "../def.h"

#define DSCHUNGELPLATZ "/d/dschungel/dante/tijaraneu/room/ti_pfad14"
#define ARRAKEENPLATZ ROOM "ara_2_4_0"
#define WOLKENPLATZ "/d/luft/hicks/wolkenstadt/room/ws5"

#define PREIS 100

#define M(x,y) \
  AddMsg(break_string(x,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT)+"\n", y)

nosave int mayleave;

void create() 
{
  transport::create();
  pub::create();

  RemoveItem("/obj/topliste");

  SetProp(P_INT_SHORT, "In einem Heissluftballon sitzend");
  SetProp(P_INT_LONG, 
	  BS("Du stehst hier im Fahrerkorb des gewaltigen Heissluftballons "
	     "und versuchst Dich irgendwo festzuhalten. Eine ueberwaeltigende "
	     "Aussicht bietet sich Dir. Ein Zwerg, vermutlich der "
	     "Ballonfuehrer, wuselt neben Dir aufgeregt um einen kleinen "
	     "Holzofen herum."));

  SetProp(P_SHORT, 
	  "Ein riesiger, bunter Heissluftballon liegt hier vor Anker");

  SetProp(P_LONG,
	  BS("Du siehst einen gewaltigen, bunten Heissluftballon, der "
	     "hier vor Anker liegt. Du solltest schnell einsteigen, denn "
	     "lange wird er hier nicht sein..."));

  SetProp(P_NAME, "Heissluftballon");
  AddAdjective(({"riesig","riesige","riesiger","riesigen"}));
  SetProp(P_NAME_ADJ, ({"riesig"}));

  AddId(({"Transporter","ballon","heissluftballon","luftballon","\nballon"}));

  SetProp(P_GENDER, MALE);
  SetProp(P_TRANSPARENT,1);
  SetProp(P_NOREST, 
	  "Du denkst, dass das keine so gute Idee waere und laesst es...\n");
  
  AddDetail(({"aussicht"}),
	    "Die Aussicht ist einfach atemberaubend!");
  
  AddDetail(({"boden"}),
	    "Der befindet sich weit unter Dir... Oder meinst Du den Boden des "
	    "Heissluftballons?");
  
  AddDetail(({"himmel"}),
	    "Der Himmel wird von hier aus von einem riesigen, blauen "
	    "Heissluftballon eingenommen.");
  
  SetProp(P_DEPARTMSG, ({
    "Der Zwerg loest die Taue und wirft sie ueber Bord.\n"
      "Der Heissluftballon beginnt langsam zu steigen.\n\n",
      "Der Heissluftballon legt ab und steigt steil in die Hoehe.\n"}));

  SetProp(P_ARRIVEMSG, ({
    "Der Heissluftballon erreicht den @@QueryArrived@@, worauf der Zwerg "
      "sofort hektisch ueber Bord huepft und alle Taue befestigt.\n\n",
      "Ein bunter Heissluftballon schwebt langsam herab und wird "
      "anschliessend schnell fest vertaeut.\n"}));
    
  SetProp(P_ENTERMSG, ({
    "klettert in den Korb hinein",
      "klettert in den Korb des Heissluftballons"}));

  SetProp(P_ENTERFAIL, ({
    "Der Zwerg im Korb grummelt etwas und haelt 5 Finger hoch",
    "ist zu schwer fuer den Heissluftballon"}));

  SetProp(P_MAX_PASSENGERS, 5);

  SetProp(P_LEAVEMSG, ({
    "klettert aus dem Korb heraus und steigt die Holztreppe hinab",
      "klettert aus dem Korb heraus und kommt die Treppe herunter"}));

  SetProp(P_LEAVEFAIL, ({
    "Das wuerdest Du nicht ueberleben",
      "hegt scheinbar suizide Gedanken, bleibt aber doch im sicheren Korb"}));

  AddCmd(({"betrete", "betritt"}), "rein");
  AddCmd(({"verlasse", "verlass"}), "raus");
  
  AddFun("hupfit_arrakeen",1);
  
  AddRoute(ARRAKEENPLATZ, 30, 10, "Standplatz in Arrakeen",
	   ({"arrakeen","wueste","arrakeenstandplatz","wuestenstandplatz"}),
	   "nach Arrakeen");

  M("Der Heissluftballon steigt hoeher, Du siehst bereits die Daecher "
    "von Arrakeen unter Dir schrumpfen.", 10);
  M("Der Zwerg legt etwas Kohle nach und heizt so richtig ein.", 5);

  AddFun("hupfoff",1);

  M("Der Heissluftballon steigt immer hoeher, Arrakeen ist bereits so klein "
    "wie ein Ameisenhaufen geworden.", 10);
  M("Ein kraeftiger Wind treibt den Ballon nach Sueden. Der Zwerg freut sich "
    "und schaufelt weiter Kohle in den kleinen Ofen hinein.", 20);
  M("Der Heissluftballon treibt weiter in Richtung Sueden... Unter Dir "
    "bemerkst Du bereits den Strand, die Grenze der gewaltigen Wueste.", 20);
  M("Eine kleine Sturmboe erfasst den Ballon und reisst ihn herum.", 5);
  M("Eine Gruppe Moewen fliegt fasziniert eine Zeit lang mit dem Ballon "
    "mit und kehrt dann wieder um.", 20);
  M("Der Heissluftballon steigt immer hoeher hinauf.", 5);
  M("Immer hoeher hinauf...", 10);
  M("Der Heissluftballon naehert sich einer grossen Wolkenformation.", 10);
  M("Die Wolkenformation wird immer groesser...", 10);
  M("Bei der Wolkenformation scheint es sich um eine Wolkenstadt zu handeln.", 10);
  M("Der Heissluftballon schwebt nun ueber der Wolkenstadt.", 1);
  
  AddFun("hupfit_wolkenstadt",10);

  M("Der Heissluftballon begibt sich in den Landeanflug.", 5);
  M("Der Zwerg murmelt etwas und dann ist der Heissluftballon auch schon "
    "gelandet.", 2);
  
  AddRoute(WOLKENPLATZ, 30, 10, "Standplatz in den Wolken",
	   ({"wolkenstadt","wolken","liliandor","luft","wolkenstandplatz"}),
	   "zur Wolkenstadt");
  
  M("Der Zwerg ruft etwas und der Heissluftballon beginnt zu steigen.", 10);
  
  AddFun("hupfoff",1);
  
  M("Der Heissluftballon schwebt ueber den Rand der Wolkenstadt weiter "
    "nach Sueden.", 15);
  M("Der Wind treibt den Heissluftballon immer weiter nach Sueden.", 20);
  M("Am suedlichen Horizont bemerkst Du eine duenne Linie. Das wird wohl der "
    "Landstrich des Dschungels sein...",20);
  M("Auf dem Landstrich kannst Du bereits erste grosse Gebaeude erkennen.",
    10);
  M("Der Heissluftballon naehert sich dem Strand von Tijara, der Zwerg "
    "beginnt etwas nervoes an dem Ofen herumzuwerkeln.",15);
  M("Der Heissluftballon befindet sich bereits in einem stetigen "
    "Sinkflug.",15);
  M("Unter Dir wird die Stadt Tijara immer groesser, Du kannst bereits "
    "ein paar Haeuser unterscheiden...\nDa ist das Haus des Gouverneurs, "
    "da ist ein seltsames Clownhaus, sogar das Baumhaus von Lux, der "
    "Lichtfee kannst Du erkennen.\n",20);
  M("Der Heissluftballon sinkt immer mehr und beginnt auf den neuen Ostteil "
    "von Tijara hinzutreiben.", 10);

  AddFun("hupfit_tijara",1);

  M("Der Zwerg faengt ploetzlich fuerchterlich zu fluchen an, da der Ballon "
    "offenbar zu tief fliegt und eine Palme streift.",5);
  M("Der Zwerg huepft hektisch im Heissluftballon herum und der Ballon "
    "treibt auf einen grossen Platz zu...", 10);
  M("Kurz bevor der Heissluftballon landet, murmelt der Zwerg 'gahumo!'.",
    5);

  AddRoute(DSCHUNGELPLATZ, 30, 10, "Standplatz in Tijara",
	   ({"dschungel","tijara","osttijara","tijarastandplatz",
	       "dschungelstandplatz","osttijarastandplatz"}),
	   "nach Tijara");
  
  M("Der Heissluftballon steigt immer hoeher.", 10);
  M("Beinahe haette der Ballon in seinem Steigflug eine Palme gestriffen.", 5);
  
  AddFun("hupfoff",1);
  
  M("Der Ballon hat bereits die obere Palmengrenze ueberschritten, um Dich "
    "herum breitet sich ein endloser Horizont aus. Nach Norden hin eroeffnet "
    "sich das weite Meer und nach Sueden hin erstreckt sich weit der tiefe "
    "Dschungel.",20);
  M("Der Zwerg werkelt an dem kleinen Ofen herum und der Ballon steigt noch "
    "weiter an.",15);
  M("Eine sanfte Brise treibt den Ballon aufs offene Meer hinaus. Gerade "
    "ueberfliegst Du die weissen Sandstraende von Tijara.",10);
  M("Der Zwerg jubelt, weil ein guter Wind den Ballon nach Norden treibt.",15);
  M("Etwas gelangweilt blickst Du auf das Meer unter Dir hinab, da erkennst "
    "Du einen gewaltigen Schatten knapp unter der Wasseroberflaeche.", 10);
  M("Es sieht fast so aus, als wuerde ein Seedrache dem Schatten des "
    "Heissluftballons folgen...",3);
  M("Jetzt ist er wieder abgetaucht.",10);
  M("Der Heissluftballon steigt immer hoeher hinauf.", 5);
  M("Immer hoeher hinauf...", 10);
  M("Der Heissluftballon naehert sich einer grossen Wolkenformation.", 10);
  M("Die Wolkenformation wird immer groesser...", 10);
  M("Bei der Wolkenformation scheint es sich um eine Wolkenstadt zu handeln.",
    10);
  M("Der Heissluftballon schwebt nun ueber der Wolkenstadt.",1);

  AddFun("hupfit_wolkenstadt",10);

  M("Der Heissluftballon begibt sich in den Landeanflug.", 5);
  M("Der Zwerg murmelt etwas und dann ist der Heissluftballon auch schon "
    "gelandet.", 2);

  AddRoute(WOLKENPLATZ, 30, 10, "Standplatz in den Wolken",
           ({"wolkenstadt","wolken","liliandor","luft","wolkenstandplatz"}),
           "zur Wolkenstadt");

  M("Der Zwerg ruft etwas und der Heissluftballon beginnt zu steigen.", 10);

  AddFun("hupfoff",1);

  M("Der Heissluftballon schwebt ueber den Rand der Wolkenstadt weiter "
    "nach Norden.", 15);
  M("Der Wind treibt den Heissluftballon immer weiter nach Norden.", 20);
  M("Dein Blick folgt den Moewen, die den Heissluftballon begleiten und in "
    "der Ferne erkennst Du bereits einen duennen Strich am Horizont...\n",15);
  M("Der Strich wird immer dicker und du kannst bereits die groben "
    "Umrisse eines Hafens entdecken...",10);
  M("Der Hafen befindet sich nun weit unterhalb des Ballons und vor Dir "
    "erstreckt sich die gewaltige Wueste...",15);
  M("Der Zwerg murmelt: 'Na endlich'.\n"
    "Du fragst Dich noch was er meint, da bemerkst Du ebenfalls die "
    "Huegel im Norden, ob das schon die Schutzmauern von Arrakeen sind?",5);
  M("Als der grosse 'Ameisenhaufen' Arrakeen in Sicht kommt, beginnt der "
    "Zwerg an dem Ofen herumzuwerkeln und der Ballon beginnt zu sinken...",10);
  M("Der Heissluftballon gleitet langsam herab... Du kannst bereits die "
    "Anlegestelle sehen.",5);

  AddFun("hupfit_arrakeen",1);

  M("Immer tiefer sinkt der Ballon und der Zwerg huepft aufgeregt hin und "
    "her...", 5);
  
  AddDrink("Blaubarts Moewenrum", ({"rum","moewenrum","moevenrum"}), 89,
	   ({5,20,2}), 3, 5,
	   ({"Der Zwerg ueberreicht Dir ein Stamperl mit einer hochroten "
	       "Fluessigkeit, das Du sofort und in einem Zug leerst...\n"
	       "Einen Moment lang fuehlst Du Dich wie ein Vogel und "
	       "siehst alles ganz klar! WOW, was fuer ein Drink!\n",
	       "&& leert ein kleines Stamperl \"Blaubarts Moevenrum\" und "
	       "beginnt leicht zu wanken.\n"}));

  AddDrink("\"Zwergenwasser\"", ({"wasser","zwergenwasser"}), 159,
	   ({25,10,5}), 13, 8,
	   ({"Du leerst das Glas Wasser in einem Zug und wunderst Dich noch "
	       "warum das ganze \"Zwergenwasser\" heisst, als Dir ploetzlich "
	       "schwarz vor Augen wird...\n"
	       "Der Zwerg lacht Dich nur aus, als Du vor Dich hinroechelst.\n",
	       "&& trinkt ein Glast \"Zwergenwasser\" und beginnt zu "
	       "roecheln...\nDer Zwerg lacht &4 nur aus.\n"}));

  AddDrink("Oragora (suess)", ({"oragora"}), 299,
	   ({1,30,5}), 0, 3,
	   ({"Du goennst Dir ein Glas eiskaltes, extrasuesses Oragora.\n"
	       "Hmm, schmeckt irgendwie nach Orange und noch etwas...\n",
	       "&& goennt sich ein Glas eiskaltes, extrasuesses Oragora.\n"}));
  
  AddDrink("Meerwasser", ({"meerwasser"}), 25,
	   ({-1, 0, 0}), 0, -1,
	   ({"Du nimmst einen Schluck vom Meerwasser und spuckst es "
	       "augenblicklich wieder aus...\n"
	       "Pfui, das ist ja wirklich Meerwasser!\n"
	       "Der Zwerg grinst Dich an.\n",
	       "&& trinkt einen Schluck vom Meerwasser und beginnt heftig "
	       "zu spucken!\n"}), 100);
    
  AddDrink("Kaktussaft", ({"saft","kaktussaft"}), 99,
	   ({10,10,2}), 0, 3,
	   ({"Du setzt das Glas an, trinkst und verziehst das Gesicht bei "
	       "dem sauren Getraenk!\n",
	       "&& verzieht das Gesicht, als &1 ein Glas Kaktussaft trinkt.\n"}));
  
  RemoveCmd(({"spendier", "spendiere"}));
  
  Start();
  
  AddItem(NPC "bzwerg", REFRESH_DESTRUCT);
}

void hupfit_arrakeen(){ mayleave=1;}
void hupfit_tijara(){ mayleave=2;}
void hupfit_wolken(){ mayleave=3;}
void hupfoff(){ mayleave=0;}

GetDetail(mixed key, mixed race)
{                                                                              
  string ret;
  
  ret=::GetDetail(key,race,1);
  
  if(!ret)
    return ({
	"Du geniesst lieber die Aussicht, als alles zu untersuchen.\n",
	  "Eine Moewe grinst Dich aus der Ferne an.\n",
	  "Der Zwerg grinst Dich an.\n",
	  "Du geniesst lieber den frischen Wind.\n"
	  })[random(4)];
  else
    return ret;
}

nosave varargs void disconnect(int change, int change_time)                    
{
  object room;
  mixed *departmsg;
  
  departmsg = QueryProp(P_DEPARTMSG);
  if((room=environment()) && pointerp(departmsg) )
    {
      tell_room(ME, process_string(departmsg[0]));
      tell_room(room, process_string(departmsg[1]));
      
      switch(file_name(room))
	{
	case ARRAKEENPLATZ: hupfit_arrakeen();
	  break;
	case DSCHUNGELPLATZ: hupfit_tijara(); 
	  break;
	case WOLKENPLATZ: hupfit_wolken(); 
	  break;
	}
    }
  
  roomCode = 0;
  
  if(change)
    call_out("changeHp",change_time);
}

GetExits()
{ 
  if(QueryArrived() )
    return "Du kannst den Ballon jederzeit verlassen.\n";
  
  return "";
}

nosave rein(string str)
{
  notify_fail("Was willst Du betreten?\n");
  
  if(str && id(str)) return Enter();
  return 0;
}

nosave raus(string str)
{
  notify_fail("Was willst Du verlassen?\n");

  if(str && id(str))
    if(mayleave)
      {
	write(BS("Wagemuetig springst Du noch rechtzeitig ab..."));

	switch(mayleave)
	  {
	  case 1:
	    TP->move(ARRAKEENPLATZ, M_GO|M_SILENT);
	    break;
	  case 2:
	    TP->move(DSCHUNGELPLATZ, M_GO|M_SILENT);
	    break;
	  case 3:
	    TP->move(WOLKENPLATZ, M_GO|M_SILENT);
	    break;
	  }
	
	tell_room(ME, 
		  BS(CAP(getuid(TP))+" springt noch rechtzeitig ab..."));
	
	TP->AddHp(-50-(random(20)));
	
	write(BS("... und schlaegst hart auf dem Boden auf!!"));
      }
    else
      return Leave();
  
  return 0;
}

void init()
{
  ::init();

  // Sichergehen, dass alle Plaetze auch geladen sind.
  if(interactive(TP))
    {
      call_other(ARRAKEENPLATZ, "???");
      call_other(DSCHUNGELPLATZ,"???");
      call_other(WOLKENPLATZ,"???");
    }
}

void geldher(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl, ME)) return;
  
  if(pl->QueryMoney()<PREIS)
    {
      tell_object(pl, 
		  "Der Zwerg herrscht Dich an: Du hast nicht genug Geld!\n"
		  "Mit diesen Worten zwingt er Dich aus dem Korb.\n");
      tell_room(ME, 
		BS(CAP(getuid(pl))+" hat offensichtlich nicht genug Geld "
		   "mit und wird vom Zwerg achtkantig aus dem Korb "
		   "geworfen!"), ({pl}));
      
      if(!Leave(pl))
	{
	  DB("*** Heissluftballon: !!Rauswerfen!! "+CAP(getuid(pl))+"\n");

	  tell_object(pl, "Der Zwerg grinst Dich gemein an...\n");

	  if(mayleave==2)
	    pl->move(DSCHUNGELPLATZ, M_GO|M_SILENT);
	  else
	    pl->move(ARRAKEENPLATZ, M_GO|M_SILENT);
	  
	  pl->AddHp(-50-(random(20)));
	  write("... und dann schlaegst Du hart auf dem Boden auf!!\n");
	}
    }
  else
    {
      tell_object(pl,
		  BS("Du bezahlst dem Zwerg die "+PREIS+" Muenzen "
		     "Reisekosten und freust Dich schon auf die Reise."));
      tell_room(ME, 
		  BS(CAP(getuid(pl))+" bezahlt dem Zwerg die Reisekosten."),
		({pl}));
      pl->AddMoney(-PREIS);
    }
}

public varargs int Enter(object who)
{
  int ret;
  
  if(ret=::Enter(who))
    if(objectp(who))
      if(!IS_WIZARD(who))
	call_out("geldher", 1, who);
  
  return ret;
}

