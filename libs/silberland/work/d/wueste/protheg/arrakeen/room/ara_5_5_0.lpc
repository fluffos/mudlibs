#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp(P_INT_LONG,
	  BS("Hier ist die Atmosphaere nicht ganz so duester wie im Westen. "
	     "Trotzdem wirken die Haeuser verfallen und unbewohnt. Im Westen "
	     "kannst Du das Tor zur verbotenen Zone ausmachen, im Osten steht "
	     "ein schmuckloses Haus mit einem grossen Wappen ueber der "
	     "Tuer."));

  AddDetail(({"atmosphaere"}),
	    "Die Atmosphaere ist im Westen definitiv duesterer. Aber trotzdem "
	    "moechtest Du hier nicht laenger verweilen, als noetig.");

  AddDetail(({"haeuser"}),
	    "Die Haeuser machen einen ungepflegten Eindruck. Sie sind alt und "
	    "sicherlich unbewohnt. Das macht die ganze Atmosphaere etwas "
	    "duester und trist.");

  AddDetail(({"haus"}),
	    "Das Haus ist im ganzen schmucklos, nur ein seltsam bekanntes "
	    "Wappen schmueckt den Eingang.");

  AddDetail(({"tuer"}),
	    "Die Tuer scheint offen zu sein. Vielleicht kannst Du das Haus "
	    "betreten?");

  AddDetail(({"eindruck"}),
	    "Dein Eindruck von dieser Gegend ist nicht so gut, wie vom Rest "
	    "von Arrakeen.");

  AddDetail(({"gegend"}),
	    "Irgendwie trist und oed.");

  AddDetail(({"arrakeen"}),
	    "Arrakeen ist die Hauptstadt der Region Wueste und mehr oder "
	    "weniger die einzige Stadt der Wueste, die Dir so einfaellt.");

  AddDetail(({"hauptstadt"}),
	    "Hauptstadt und vermutlich einzige Stadt in der Wueste. Hmmm. Das "
	    "koennte man vielleicht untersuchen.");

  AddDetail(({"region", "silberland", "wueste"}),
	    "Im Silberland ist die Wueste sicher eine der aufregendsten "
	    "Regionen.");

  AddDetail(({"eingang"}),
	    "Der Eingang ist eigentlich recht schmucklos.");

  AddDetail(({"rest"}),
	    "Ist das wirklich wichtig?");

  AddDetail(({"stadt"}),
	    "Die Stadt in der Wueste ist Arrakeen und Du stehst mittendrin. "
	    "Du kannst Fragen stellen...");

  AddDetail(({"bezirk", "tor", "zone"}),
	    "Jedesmal, wenn Du das Tor zum verbotenen Bezirk siehst, "
	    "beschleicht Dich eine dunkle Vorahnung.");

  AddDetail(({"vorahnung"}),
	    "Das kannst Du noch nicht richtig erfassen.");

  AddDetail(({"falke", "hintergrund", "wappen", "streitkraefte"}),
	    "Ein roter Falke auf schwarzem Hintergrund, das ist das Wappen "
	    "der herzoeglichen Streitkraefte.");

  AddDetail(({"fragen"}),
	    "Das ist doch wirklich nicht wichtig, oder?");

  Licht("hell");
  Umgebung("heiss",TT_TOWN, 0);  
  Ausgaenge("ara", ({"westen","ostoben"}));

  AddItem(NPC "stadtwaechter", REFRESH_DESTRUCT);
}
