#include "../def.h"

inherit MOST "std_room";

nosave string *wasser_getrunken;
nosave int next;
nosave string last;

#define MAX_HEILUNG 3
#define TRINKEN 8

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In den herzoeglichen Gaerten");
  SetProp(P_INT_LONG,
	  BS("Du stehst direkt vor dem herzoeglichen Palast zu Arrakeen "
	     "mitten in einem herrlich gepflegten Garten. Ueberall stehen "
	     "Palmen und andere Pflanzen, die ein angenehmes Gefuehl von "
	     "Ruhe ausstrahlen. In der Mitte des kleinen Platzes plaetschert "
	     "ein Springbrunnen."));

  AddDetail(({"palast"}),
	    "Hier residiert der Herzog von Arrakeen, Herrscher ueber die "
	    "grosse weite Wueste. Die Leute hier in der Stadt sprechen viel "
	    "ueber seine Weisheit.");

  AddDetail(({"arrakeen", "stadt"}),
	    "Arrakeen heisst die Stadt, in der Du Dich befindest.");

  AddDetail(({"einwohner", "leute"}),
	    "Die Einwohner von Arrakeen sind eigentlich gut auf ihren "
	    "Herrscher zu sprechen.");

  AddDetail(({"herrscher"}),
	    "Als Herrscher kann man den Herzog von Arrakeen eigentlich nicht "
	    "bezeichnen. Er behandelt seine Untergebenen gerecht und spart "
	    "auch nicht mit Wasser.");

  AddDetail(({"wasser"}),
	    "Wasser scheint hier in der Wueste eine besondere Rolle zu "
	    "spielen. Was angesichts der hier herrschenden Temperaturen auch "
	    "nicht weiter verwunderlich ist.");

  AddDetail(({"temperatur", "temperaturen", "grad"}),
	    "Eigentlich faellt die Temperatur hier selten unter 40 Grad.");

  AddDetail(({"wueste"}),
	    "Du hast jetzt schon soviele Dinge ueber die Wueste gehoert, "
	    "dass es Dich juckt, diese selbst auch einmal zu erkunden.");

  AddDetail(({"ding", "dinge"}),
	    "Das musst Du schon selbst herausfinden.");

  AddDetail(({"garten"}),
	    "Der Garten ist wirklich hervorragend gepflegt. Ueberall wachsen "
	    "gruene Buesche und Palmen aus dem gut durchfeuchteten Boden. Du "
	    "fuehlst Dich wie in einer Oase.");

  AddDetail(({"boden"}),
	    "Komisch, wie feucht der Boden ist. Eigentlich muesste er genau "
	    "so trocken sein, wie der Rest in Arrakeen.");

  AddDetail(({"rest"}),
	    "Der Rest von Arrakeen ist total ausgetrocknet.");

  AddDetail(({"buesche"}),
	    "Du kannst sie nicht weiter identifizieren, willst es auch gar "
	    "nicht. Die Buesche wirken einfach nur beruhigend auf Dich.");

  AddDetail(({"gefuehl", "ruhe"}),
	    "Ein Gefuehl von innerer Ruhe macht sich in Deinem gestressten "
	    "Herzen breit. Wenn es hier nicht so heiss waere, wuerdest Du "
	    "hier gerne etwas ausruhen.");

  AddDetail(({"herz", "herzen", "zeit"}),
	    "Huch, eine Zeit lang hattest Du das Gefuehl, es irgendwo "
	    "liegengelassen zu haben. Aber da schlaegt es wieder im gewohnten "
	    "Rhythmus.");

  AddDetail(({"rhythmus", "rythmus"}),
	    "Das ist hier wirklich nicht wichtig.");

  AddDetail(({"herzog"}),
	    "Vielleicht ergibt sich ja mal die Gelegenheit, dass Du diesen "
	    "weisen Herrscher kennenlernst.");

  AddDetail(({"mitte", "platz"}),
	    "Du stehst auf einem Platz innerhalb des Gartens. Vor Dir siehst "
	    "Du einen Springbrunnen.");

  AddDetail(({"brunnen", "springbrunnen", "betrachtung"}),
	    "Ueberall in diesem Park macht sich eine Verschwendung von Wasser "
	    "bemerkbar. Bei genauerer Betrachtung des Brunnens fuehlst Du ein "
	    "starkes Durstgefuehl.");
  
  AddDetail(({"durst", "durstgefuehl"}),
	    "Ob es jemandem etwas ausmacht, wenn Du einen Schluck Wasser zu "
	    "Dir nimmst?");

  AddDetail(({"verschwendung"}),
	    "Wo soviel Wasser verschwendet wird, muss eine grosse Quelle "
	    "sein.");

  AddDetail(({"quelle"}),
	    "Hier steht ein Brunnen herum?!");

  AddDetail(({"gelegenheit", "gelegenheiten"}),
	    "Gelegenheiten ergeben sich immer wieder.");

  AddDetail(({"oase"}),
	    "Anders kann man diesen Park nicht beschreiben. Du fuehlst Dich "
	    "hier sehr wohl und geborgen.");

  AddDetail(({"park"}),
	    "Eigentlich ist es nur der zum Palast gehoerende Garten, aber es "
	    "kommt Dir vor wie ein grosser Park.");

  AddDetail(({"palme", "palmen"}),
	    "Die Palmen, die hier wachsen, stehen gerade in voller Bluete. "
	    "Ein wunderschoener Anblick.");

  AddDetail(({"bluete"}),
	    "Die Palmen bluehen in verschiedenen Farben.");

  AddDetail(({"farbe", "farben"}),
	    "Du siehst rot, rosa und violett.");

  AddDetail(({"anblick"}),
	    "Diesen Anblick kannst Du gewiss nicht mehr vergessen.");

  AddDetail(({"pflanze", "pflanzen"}),
	    "Die Pflanzen hier wirken sehr beruhigend auf Dich.");

  AddDetail(({"schluck"}),
	    "Du koenntest es ja mal probieren.");

  AddDetail(({"untergebene", "untergebenen"}),
	    "Untergebene ist ein eher selten gebrauchter Ausdruck hier.");

  AddDetail(({"ausdruck"}),
	    "Das ist wirklich unwichtig.");

  AddDetail(({"weisheit"}),
	    "Die Weisheit des Herzogs ist beruehmt im ganzen Land.");

  AddDetail(({"land", "silberland"}),
	    "Das Land ist natuerlich das Silberland, aber das weisst Du ja "
	    "sowieso.");

  AddDetail(({"rolle"}),
	    "Die Rolle des Wassers in der Wueste ist angesichts der hohen "
	    "Temperaturen leicht zu ersehen.");

  AddCmd(CMD_TRINKEN, "trink_wasser");

  //  AddExit("osten", "/d/wueste/muaddib/palast/room/entrance");

  AddItem(NPC "gaertner", REFRESH_DESTRUCT);

  wasser_getrunken=({});

  Licht("hell");
  Umgebung("heiss", TT_PLAIN);
  Ausgaenge("palast");

  Ausgaenge("ara", ({"westunten#in die Stadt zurueck"}));
}

nosave int trink_wasser(string str)
{
  notify_fail(BS("Was willst Du denn trinken?"));
  if(!str) return 0;

  if((stringp(last) && (last==getuid(TP)) && next>=time()))
     return write(BS("Nicht so hastig!!")), 1;

  if(str=="wasser"||str=="wasser aus brunnen"||str=="aus brunnen")
    if(TP->drink_soft(TRINKEN, 1))
      {
	next=time()+2;
	last=getuid(TP);

	if(member(wasser_getrunken, getuid(TP))==-1)
	  {
	    write(BS("Du trinkst etwas Wasser und fuehlst, wie es Deinen "
		     "Koerper regeneriert..."));
	    
	    TP->AddHp(10+random(5));
	    TP->AddSp(30+random(10));
	    
	    if(!random(MAX_HEILUNG)) wasser_getrunken+=({getuid(TP)});
	    return 1;
	  }
	else
	  return write(BS("Du trinkst etwas Wasser aus dem Brunnen und "
			  "fuehlst Dich sofort erfrischt.")), 1;
      }
    else
      return write(BS("So herrlich das Wasser auch sein mag, aber Du kannst "
		      "fast nichts mehr trinken...")), 1;
  
  return 0;
}

