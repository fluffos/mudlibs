#include "../def.h"
#include "pfand.h"

inherit MOST "std_room";

#define BSKN(x) break_string(x, 78, KN+" sagt: ", \
			     BS_LEAVE_MY_LFS+BS_NO_PARINDENT)

nosave object warehouse;

varargs void init_warehouse(int flag)
{
  if(!flag && !objectp(warehouse))
    write_file(LOG "pfandlagererror", ctime(time())+
	       " : Variable 'warehouse' not found for "+CAP(getuid(TP))+"\n");
  
  call_other(ROOM "pfand_lager", "???");
  warehouse=find_object(ROOM "pfand_lager");
}

string tafel()
{
  TP->More("    Banjal praesentiert:\n"
        "+---                                                 ---+\n"
	"|                                                       |\n"
	"| Wenn  Du  Geld   brauchst,   bist  Du  hier  richtig. |\n"
	"  Versetze  doch  einfach  eine  Deiner  Waffen,   oder\n"
	"  eine Deiner Ruestungen.\n"
	"  \n"
	"  Du  bekommst  dafuer  von  mir  den  vollen  Wert des\n"
	"  Objektes  (maximal  20 000  Muenzen)  ausbezahlt  und\n"
	"  zahlst es dann  entweder Ratenweise,  oder auf einmal\n"
	"  zurueck (natuerlich mit Zinsen!)\n\n"
	"  Werden die Raten mitsamt Zinsen nicht zurueckgezahlt,\n"
	"  wird  das Objekt versteigert / verkauft oder  einfach\n"
	"  einbehalten.\n"
	"  \n"
	"  Weiters  besteht die  Moeglichkeit,  die Objekte nach\n"
	"  Abbezahlung noch weiter  hier lagern zu lassen,  fuer\n"
	"  einen kleinen Unkostenbeitrag.\n"
	"  \n"
	"| 'blabla Kleingedrucktes blabla'                       |\n"
	"|                                                       |\n"
        "+---                                                 ---+\n");
  return "";
}

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Banjals Allerlei");
  SetProp(P_INT_LONG, 
	  BS("Du findest Dich in einem kleinen Laden wieder, der, so wie es "
	     "aussieht bis zum Dach mit allerlei Waffen, Ruestungen und "
	     "sonstigem Geruempel vollgestopft ist. Mit etwas Phantasie "
	     "erkennst Du inmitten all dem Geruempel die Umrisse eines "
	     "Tisches, der aber ebenfalls ueber und ueber mit Papieren "
	     "uebersaeht ist. Links und rechts vom Ausgang stehen zwei "
	     "trollhohe Steingolems, vermutlich die Ladenwaechter. "
	     "Eine Tafel wurde einem der Steingolems umgehaengt."));
  
  SetProp(P_NOREST, BS("Du kannst doch nicht einfach in einem Laden rasten!"));
  
  AddDetail(({"fussboden","boden"}),
	    "Der Boden ist mit einer dickeren Sandschicht ueberzogen, "
	    "vermutlich deswegen, weil der Ausgang nicht durch eine Tuer "
	    "geschuetzt ist. An einigen Stellen siehst Du noch, dass der "
	    "Laden eigentlich mit einem Teppich ausgelegt ist.");
  
