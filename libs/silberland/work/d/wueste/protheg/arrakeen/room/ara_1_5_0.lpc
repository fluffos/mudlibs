nosave int cmd_ziehen(string str)
{
  notify_fail(BS("Ziehen? Woran willst Du denn ziehen?"));
  if(!str) return 0;
  
  if(str=="hebel"||str=="an hebel")
    return write(BS("Du versuchst am Hebel zu ziehen, doch der ist "
		    "irgendwie fixiert! Du willst ihn nicht abbrechen, "
		    "deswegen laesst Du es.")), 1;
  
  return 0;
}

nosave int cmd_klingeln(string str)
{     
  notify_fail(BS("Klingeln? Womit denn!?"));
  if(!str) return 0;
  
  if(str=="mit glocke"||str=="glocke")
    {
      if(TP->InFight())
	return write(BS("Dafuer bist Du zur Zeit zu beschaeftigt!")), 1;

      write(BS("Die Glocke gibt einen seltsames Surren von sich, woraufhin "
	       "Du eine Stimme von hinten hoerst: 'Ah! Ein Kunde!'")+
	    BS("Ploetzlich bewegt sich hinter Dir etwas und bevor Du Dich "
	       "umdrehen kannst, hebt Dich einer der Steingolems ueber das "
	       "ganze Geruempel hinweg in den hinteren Teil des Lagers..."));
      say(BS(TPN+" beugt sich kurz zum Tisch hin, Du vernimmst ein Surren und "
	     "ploetzlich hebt "+TP->QueryPronoun(WEN)+" einer der Steingolems "
	     "hoch und nach hinten in den Laden."), ({TP}));
      
      TP->move(ROOM "schmiede", M_GO|M_SILENT|M_NO_SHOW);
      
      return 1;
    }
  
  return 0;
}

int check_object(object what)
{
  if(living(what)) return 0;
  if(what->QueryProp(P_NODROP)) return 0;
  if(what->QueryProp(P_NEVERDROP)) return 0;
  return 1;
}

void pfand_oder_nicht(string str, int va, object what, object who)
{
  if(str=="ja"||str=="j")
    {
      warehouse->Set_Pfand(what, va);
      
      who->AddMoney(va);
      
      write("\n"+
	    BSKN("Gut, hier hast Du die "+va+" Muenzen. Vergiss aber nicht "
		 "regelmaessig die Zinsen dafuer zu bezahlen, sonst sehe ich "
		 "mich gezwungen, Konsequenzen zu ziehen."));
      
      return;
    }
  
  if(str=="nein"||str=="n"||str=="~q"||str=="q") 
    {
      write("\n"+
	    BSKN("Gut, dann werde ich das solange Du willst fuer Dich "
		 "aufbewahren. Vergiss aber nicht regelmaessig die Miete "
		 "dafuer zu bezahlen, sonst sehe ich mich gezwungen, "
		 "Konsequenzen zu ziehen."));
      
      return;
    }
  
  write("Ja/Nein? ");

  input_to("pfand_oder_nicht", 0, va, what, who);
}

nosave int cmd_versetzen(string str)
{
  object ob;
  int ret;
  
  notify_fail(BS("Ohne "+KN+" wird hier nichts versetzt!"));
  if(!present(KEEPER_ID)) return 0;
  
  notify_fail(BSKN("Was willst Du denn versetzen?"));
  if(!str) return 0;
  
  if(!objectp(ob=present(str,TP))) return 0;
  
  init_warehouse();
  
  if(sizeof(warehouse->Get_Objects(TP))==MAX_ITEMS) 
    return write(BSKN("Noch mehr werde ich von Dir nicht annehmen!")), 0;

  if(ob->QueryWorn()) 
    return write(BSKN("Das solltest Du zuerst ausziehen!")), 0;

  if(ob->QueryProp(P_WIELDED)) 
    return write(BSKN("Das solltest Du zuerst wegstecken!")), 0;
  
  if(!check_object(ob)) 
    return write(BSKN("Du kannst "+ob->name(WEN, 1)+" leider nicht "
		      "hergeben.")), 0;
  
  if(ob->QueryProp(P_CURSED))
    return write(BSKN("Ieh! Verfluchte Sachen nehme ich nicht!")), 0;
  
  if(ob->QueryProp(P_VALUE) <= 50)
    return write(BS(KN+" blickt Dich schief an und meint: Das ist mir zu "
		    "billig!")), 0;
  
  if(!ret=warehouse->Insert_Object(ob, TP)) 
    return write(BSKN("Hm, da stimmt was nicht. Ich glaube, ich will das "
		      "lieber doch nicht annehmen.")), 1;
  
  write(BSKN("Hm, also "+ret+" Muenzen, kann ich dafuer schon "
	     "hergeben.")+
	BSKN("Willst Du dafuer Pfand haben?")+"Ja/Nein? ");
  
  input_to("pfand_oder_nicht", 0, ret, ob, TP);
  
  return 1;
}

void teil_miete_begleichen(string str, mapping l, object who, string tmp)
{
  object *dinge;
  int i,m;
  
  i=to_int(str);
  dinge=m_indices(l);
  
  if(i < 1 || i > sizeof(dinge))
    {
      write(tmp);
      
      input_to("teil_miete_begleichen", 0, l, TP, tmp);
    }
  
  m=l[dinge[i-1]];
  
  if(who->QueryMoney() < m)
    return write(BSKN("Soviel Geld hast Du nicht bei Dir."));
  
  //who->AddMoney(-m);
  
  warehouse->Miete_begleichen(dinge[i-1]);
  
  write(BS("Du uebergibst "+KN+" "+m+" Muenzen.")+
	BS(KN+" nickt Dir zu."));
}

void miete_begleichen(string str, int m, mapping l, object who)
{
  object *dinge;
  int i;
  string tmp;
  
  if(str=="ja"||str=="j")
    {
      if(who->QueryMoney() < m)
	{
	  write(BSKN("Hm, soweit ich sehe, hast Du soviel ja garnicht "
		     "mit!")+
		BSKN("Willst Du statt dessen vielleicht einen Teil "
		   "zahlen?"));
	
	  write("Nein/Teil ? ");

	  input_to("miete_begleichen", 0, m, l, TP);
	  
	  return;
	}

      //who->AddMoney(-m);
      
      warehouse->Miete_begleichen(who);
      
      write(BS(KN+" streicht auf einer Liste etwas durch und nickt Dir zu."));
      
      return;
    }
  
  if(str=="nein"||str=="n"||str=="~q"||str=="q")
    {
      write(BSKN("Ok, aber warte nicht zulange damit!"));
      
      return;
    }
  
  if(str=="teil"||str=="teilweise"||str=="ein teil"||str=="einen teil"||
     str=="t")
    {
      dinge=m_indices(l);
      
      if(sizeof(dinge)==1)
	{
	  write(BSKN("Aber Du hast doch nur einen Gegenstand hier bei mir "
		     "hinterlegt. Willst Du die Miete fuer "
		     +dinge[0]->name(WEN)+" bezahlen?")+
		"Ja/Nein ? ");

	  input_to("miete_begleichen", 0, m, l, TP);
	}
      
      write(BSKN("Folgendes bewahre ich fuer Dich auf:"));
      
      for(i=0;i<sizeof(dinge);i++)
	write(BS((i+1)+". '"+dinge[i]->Name(WER)+"' "+
		 (l[dinge[i]] > 0 ? "Schulden: "+l[dinge[i]]+" Muenzen":
		  "keine Schulden")+"."));
      
      tmp="";
      for(i=1;i<=sizeof(dinge);i++)
	tmp+=i+" ";
      tmp+="? ";
      write(tmp);
      
      input_to("teil_miete_begleichen", 0, l, TP, tmp);
    }
  
  write("Ja/Nein/Teil ? ");
  input_to("miete_begleichen", 0, m, l, TP);   
}

nosave int cmd_zahlen(string str)
{
  int i, s, m;
  string ret;
  mapping lager;
  object *dinge;
  
  notify_fail(BS("Ohne "+KN+" wird hier nichts versetzt!"));
  if(!present(KEEPER_ID)) return 0;
  
  notify_fail(BS(KN+" fragt Dich: Willst Du Deine Miete zahlen?"));
  if(!str) return 0;
  
  if(str!="miete" && str!="miete ab" &&
     str!="rate" && str!="rate ab" &&
     str!="raten" && str!="raten ab" &&
     str!="schuld" && str!="schuld ab" &&
     str!="schulden" && str!="schulden ab" &&
     str!="pfand" && str!="pfand ab") return 0;
  
  if(!m_sizeof(lager=warehouse->Get_Miete(TP))) 
    return write(BSKN("Sei froh, Du schuldest mir gerade nichts!")), 1;
  
  dinge=m_indices(lager);
  ret="";
  m=0;
  
  for(s=sizeof(dinge),i=0;i<s;i++)
    {
      if(!lager[dinge[i]]) continue;
      
      ret+=BSKN("Fuer "+dinge[i]->name(WEN, 1)+" sind noch "+
	      lager[dinge[i]]+" Muenzen zu entrichten!");
      
      m+=lager[dinge[i]];
    }
  
  if(!m)
    return write(BSKN("Oh, Du musst noch keine Miete zahlen.")), 1;
  
  if(sizeof(dinge)>1)
    ret+=BSKN("Das macht insgesamt "+m+" Muenzen.");
  
  ret+=BS(KN+" fragt Dich: Willst Du die Summe jetzt begleichen?")+
    BS(KN+" fragt Dich: Oder vielleicht nur einen Teil?");
  ret+="Ja/Nein/Teil? ";
  
  write(ret);
  input_to("miete_begleichen", 0, m, lager, TP);

  return 1;
}

nosave int cmd_abholen(string str)
{
  object *dinge;
  string *tmp;
  mapping m;
  int i,c;
  
  notify_fail(BS("Ohne "+KN+" wird hier nichts versetzt!"));
  if(!present(KEEPER_ID)) return 0;
  
  notify_fail(BS("Was willst Du denn abholen?"));
  if(!str) return 0;
  
  if(str=="alles"||str=="alles ab")
    {
      if(sizeof(warehouse->Get_Miete(TP)))
	return write(BSKN("Du kannst nicht alles abholen, denn "
			  "Du hast noch nicht alle Schulden abbezahlt. "
			  "Du kannst schuldenfreie Sachen jedoch "
			  "einzeln abholen.")), 1;
      
      if(!sizeof(dinge=warehouse->Get_Objects(TP)))
	return write(BSKN("Hm, bist Du sicher, dass ich etwas fuer "
			  "Dich aufbewahren sollte? Ich habe jedenfalls "
			  "nichts von Dir.")), 1;
      
      for(i=sizeof(dinge)-1;i>=0;i--)
	{
	  write(BSKN("Hier habe ich von Dir "+dinge[i]->name(WEN)+"."));
	
	  if(dinge[i]->move(TP, M_GET)==ME_TOO_HEAVY)
	    write(BSKN("Oh, das ist Dir zu schwer. Na dann behalte "
		       "ich es noch."));
	  else
	    {
	      if(!warehouse->Remove_Object(TP, dinge[i]))
		return write(BSKN("Ha! Da stimmt was nicht! Bitte "
				  "melde das PROtheG!!")), 1;
	      
	      write(BSKN("Hier hast Du "+dinge[i]->QueryPronoun(WEN)+
			 "."));
	    }
	}
      return 1;
    }
  
  c=0;
  
  if(sizeof(tmp=explode(str, " "))>1)
    if(intp(c=to_int(tmp[1])))
      if(c > 0 && c <= MAX_ITEMS)
	dinge=warehouse->Get_Objects(TP, tmp[0], c);
  
  if(!sizeof(dinge))
    dinge=warehouse->Get_Objects(TP, tmp[0]);
  
  if(!sizeof(dinge))
    return write(BSKN("Hm, so etwas habe ich nicht... Bist Du sicher, "
		    "dass ich das haben soll?")), 1;
  
  if(sizeof(dinge)>1)
    {
      write(BSKN("Hm davon habe ich mehreres zur Auswahl!"));
      
      m=warehouse->Get_Miete(TP, tmp[0]);
      
      for(i=0;i<sizeof(dinge);i++)
	write(BS((i+1)+". "+dinge[i]->Name(WER)+
		 (member(m, dinge[i]) ? " ("+m[dinge[i]]+" Muenzen noch zu "
		  "zahlen)" : "")));

      write(BSKN("Du kannst zB '"+tmp[0]+" 2' abholen, oder auch gleich "
		 "'alles'."));

      return 1;
    }
  
  if(sizeof(m=warehouse->Get_Miete(TP, tmp[0], c)))
    return write(BSKN("Nein, "+m[m_indices(m)]->name(WEN)+" kann ich "
		      "Dir noch nicht geben, denn Du schuldest"
		      "mir dafuer noch "+m[m_indices(m)[0]]+
		      " Muenzen.")), 1;
  
  if(dinge[0]->move(TP, M_GET)==ME_TOO_HEAVY)
    write(BSKN("Oh, das ist Dir zu schwer. Na dann behalte ich es noch."));
  else
    {
      if(!warehouse->Remove_Object(TP, dinge[0]))
	return write(BSKN("Ha! Da stimmt was nicht! Bitte "
			  "melde das PROtheG!!")), 1;
      
      write(BSKN("Hier hast Du "+dinge[0]->QueryPronoun(WEN)+"."));
    }
  
  return 1;
}
