#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In den herzoeglichen Gaerten");
  SetProp(P_INT_LONG,
	  BS("Du stehst nordwestlich vom Eingang des herzoeglichen Palastes "
	     "zu Arrakeen mitten in einem wunderschoenen Garten, der in "
	     "dieser Ecke besonders von einem schoen gepflegten Beet be"
	     "herrscht wird."));

  AddDetail(({"palast"}),
	    "Hier residiert der Herzog von Arrakeen, Herrscher ueber die "
	    "grosse weite Wueste. Die Leute hier in der Stadt sprechen viel "
	    "ueber seine Weisheit.");

  AddDetail(({"arrakeen", "stadt"}),
	    "Arrakeen heisst die Stadt, in der Du Dich befindest.");

  AddDetail(({"einwohner", "leute"}),
	    "Die Einwohner von Arrakeen sind eigentlich gut auf ihren "
	    "Herrscher zu sprechen.");
  
  AddDetail(({"herrscher"}),
	    "Als Herrscher kann man den Herzog von Arrakeen eigentlich nicht "
	    "bezeichnen. Er behandelt seine Untergebenen gerecht und spart "
	    "auch nicht mit Wasser.");

  AddDetail(({"wasser"}),
	    "Wasser scheint hier in der Wueste eine besondere Rolle zu "
	    "spielen. Was angesichts der hier herrschenden Temperaturen "
	    "auch nicht weiter verwunderlich ist.");

  AddDetail(({"temperatur", "temperaturen", "grad"}),
	    "Eigentlich faellt die Temperatur hier selten unter 40 Grad. "
	    "Hier im Palastgarten ist es jedoch angenehm warm.");

  AddDetail(({"wueste"}),
	    "Du hast jetzt schon soviele Dinge ueber die Wueste gehoert, "
	    "dass es Dich juckt, diese selbst auch einmal zu erkunden.");

  AddDetail(({"ding", "dinge"}),
	    "Das musst Du schon selbst herausfinden.");

  AddDetail(({"palastgarten","garten"}),
	    "Der Garten ist wirklich hervorragend gepflegt. Ueberall wachsen "
	    "gruene Buesche und Palmen aus dem gut durchfeuchteten Boden. Du "
	    "fuehlst Dich wie in einer Oase.");

  AddDetail(({"buesche"}),
	    "Du kannst sie nicht weiter identifizieren, willst es auch gar "
	    "nicht. Die Buesche wirken einfach nur beruhigend auf Dich.");

  AddDetail(({"gefuehl", "ruhe"}),
	    "Ein Gefuehl von innerer Ruhe macht sich in Deinem gestressten "
	    "Herzen breit. Wenn es hier nicht so heiss waere, wuerdest Du "
	    "hier gerne etwas ausruhen.");

  AddDetail(({"herz", "herzen", "zeit"}),
	    "Huch, eine Zeit lang hattest Du das Gefuehl, es irgendwo "
	    "liegengelassen zu haben. Aber da schlaegt es wieder im gewohnten "
	    "Rhythmus.");

  AddDetail(({"rhythmus", "rythmus"}),
	    "Dein Herz schlaegt in einem regelmaessigen Rhythmus.");

  AddDetail(({"herzog"}),
	    "Vielleicht ergibt sich ja mal die Gelegenheit, dass Du diesen "
	    "weisen Herrscher kennenlernst.");

  AddDetail(({"gelegenheit", "gelegenheiten"}),
	    "Gelegenheiten ergeben sich immer wieder.");

  AddDetail(({"oase"}),
	    "Anders kann man diesen Park nicht beschreiben. Du fuehlst Dich "
	    "hier sehr wohl und geborgen.");

  AddDetail(({"park"}),
	    "Eigentlich ist es nur der zum Palast gehoerende Garten, aber es "
	    "kommt Dir vor wie ein grosser Park.");

  AddDetail(({"palme", "palmen"}),
	    "Die Palmen, die hier wachsen, stehen gerade in voller Bluete. "
	    "Ein wunderschoener Anblick.");

  AddDetail(({"bluete"}),
	    "Die Palmen bluehen in verschiedenen Farben.");

  AddDetail(({"farbe", "farben"}),
	    "Du siehst rot, rosa und violett.");

  AddDetail(({"anblick"}),
	    "Diesen Anblick wirst Du gewiss nicht mehr vergessen.");

  AddDetail(({"pflanze", "pflanzen"}),
	    "Die Pflanzen hier wirken sehr beruhigend auf Dich.");

  AddDetail(({"untergebene", "untergebenen"}),
	    "Untergebene ist ein eher selten gebrauchter Ausdruck hier.");

  AddDetail(({"ausdruck"}),
	    "Das ist wirklich unwichtig.");

  AddDetail(({"weisheit"}),
	    "Die Weisheit des Herzogs ist beruehmt im ganzen Land.");

  AddDetail(({"land", "silberland"}),
	    "Das Land ist natuerlich das Silberland, aber das weisst Du ja "
	    "sowieso.");

  AddDetail(({"rolle"}),
	    "Die Rolle des Wassers in der Wueste ist angesichts der hohen "
	    "Temperaturen leicht zu ersehen.");

  AddDetail(({"boden"}),
	    "Der Boden ist von tiefen Furchen durchzogen, was darauf "
	    "schliessen laesst, dass hier noch gearbeitet wird. Du solltest "
	    "hier vielleicht besser nicht stoeren.");

  AddDetail(({"furche", "furchen"}),
	    "Du kannst nicht erkennen, ob hier schon gesaet wurde oder nicht. "
	    "Es sieht auf jeden Fall nach viel Arbeit aus und Du moechtest "
	    "eigentlich nicht unangenehm auffallen.");

  AddDetail(({"arbeit", "fall"}),
	    "Da muss der Gaertner schon einiges dran tun.");

  AddDetail(({"gaertner"}),
	    "Du kannst ihn ja mal fragen, wenn Du ihn siehst.");

  AddDetail(({"ecke"}),
	    "Du befindest Dich in der nordwestlichen Ecke des Gartens.");

  Licht("hell");
  Umgebung("heiss", TT_PLAIN);
  Ausgaenge("palast");
}
