#include "../def.h"

inherit "std/store";

mapping inhalt, players;

void create()
{
  ::create();
  
  inhalt=([]);
  players=([]);
}

void reset() { /*no resets here*/ }
aufraeumen() { /*gibs nicht*/ }

void backup(mapping inh, mapping pls, object *inv)
{
  int i;
  
  if(!sizeof(inh)) return;
  if(!sizeof(pls)) return;
  if(!sizeof(inh)) return;
  
  DB(BS("*** Pfand_Backup activated"));
  
  inhalt=inh;
  players=pls;
  
  for(i=sizeof(inv)-1;i>=0;i--)
    inv[i]->move(ME, M_NOCHECK);
}

void restore()
{
  call_other(ROOM "pfand_lager", "???");
  find_object(ROOM "pfand_lager")->restore(inhalt, players, all_inventory());
}

mapping dump()
{
  return inhalt;
}

void reset()
{
  if(sizeof(inhalt) || sizeof(players) || sizeof(all_inventory()))
    DB(BS("*** Pfand_Backup still activated!!"));
}
