/*
  Post in Arrakeen
  
  by Muaddib@Silberland
*/

#include "../def.h"

inherit "/std/post";
inherit MOST "std_room";

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Hauptpostamt Arrakeen");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im Hauptpostamt der Region Wueste. "
	     "Die Waende sind weiss getuencht, daher ist "
	     "es hier auch ziemlich kuehl und angenehm. "
	     "Trotz dieser Tatsache halten sich hier recht "
	     "wenig Leute auf. Um Briefe schreiben und lesen "
	     "zu koennen, gib <post> ein."));

  AddDetail("hauptpostamt", 
	    "Eigentlich gibt es sowieso nur eines.");

  AddDetail(({"region","wueste"}), 
	    "Du befindest Dich in der Region Wueste, "
	    "beziehungsweise in der Stadt Arrakeen.");

  AddDetail(({"stadt", "arrakeen"}),
	    "Du bist in Arrakeen, der Hauptstadt der Region.");

  AddDetail(({"waende", "wand"}),
	    "Die Waende sind weiss getuencht.");

  AddDetail("boden", 
	    "Der Boden sieht erstaunlich sauber aus.");

  AddDetail("decke", 
	    "Die Decke ist genau wie die Waende weiss getuencht.");

  AddDetail("silberland",
	    "Das kannst Du nicht ernsthaft fragen!");

  AddDetail("tatsache", 
	    "Das ist unwichtig.");

  AddDetail("leute", 
	    "Davon siehst Du hier wenig.");

  AddDetail(({"brief", "briefe"}),
	    "Um die zu lesen oder zu schreiben, bist Du ja hier, oder?");
  
  Licht("hell");
  Umgebung("warm",TT_HOUSE, 1);
  Ausgaenge("ara", ({"westen"}));  
}
