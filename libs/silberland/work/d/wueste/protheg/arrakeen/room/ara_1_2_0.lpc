/*
** Laden in Arrakeen
**
** by Muaddib@SL
**
*/

#include "../def.h"
#include <laden.h>

inherit "std/laden";
inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Laden mitten in Arrakeen");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem sehr gut gekuehlten Laden mitten in "
	     "Arrakeen. An den Waenden sind lauter Regale angebracht, "
	     "auf denen unterschiedliche Dinge lagern. "
	     "Im hinteren Teil des Ladens fuehrt eine Treppe nach oben."));

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER); 
  SetProp(P_SHOPKEEPER_ID, "haendler");
  SetProp(P_SHOPKEEPER_NAME, "der Haendler");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail("laden", 
	    "Es ist wirklich erstaunlich kuehl hier.");

  AddDetail("arrakeen", 
	    "Da brauchst Du nur mal rauszugehen...");

  AddDetail(({"regal","regale", "dinge"}), 
	    "Die Regale sind mit den unterschiedlichsten Dingen gefuellt.");

  AddDetail(({"wand","waende"}), 
	     "An der Wand gegenueber der Tuer haengt eine Tafel.");

  AddDetail("tuer", 
	    "Die Tuer, durch die Du gekommen bist.");

  AddDetail(({"tafel","schild"}), 
	    "Du kannst sie lesen.");

  AddDetail("teil", 
	    "Das ist nicht so wichtig.");

  AddDetail("treppe", 
	    "An der Treppe haengt ein kleines Schild.");

  AddDetail(({"gemaecher","privatgemaecher","oben"}),
	    "Die Privatgemaecher befinden sich oben.");

  AddReadDetail("schild",
		"Kein Zutritt zu den Privatgemaechern!");

  AddReadDetail("tafel",
    "Verfuegbare Befehle:\n"
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"
    "                  Haendler dafuer bezahlt.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom(ROOM "lagerraum");

  Licht("hell");
  Umgebung("warm",TT_HOUSE, 1);
  Ausgaenge("ara", ({"sueden"}));
  
  AddCmd(({"angebot"}), "list");
  
  AddItem(NPC "haendler", REFRESH_DESTRUCT);
}
