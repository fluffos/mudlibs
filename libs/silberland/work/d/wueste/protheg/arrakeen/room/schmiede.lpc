/*
  Schmiede im Pfandleiher

  2003-Nov-14  PROtheG  File angelegt.
*/

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Banjals Allerlei (Hinten)");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich nun im hinteren Teil von Banjals Laden. "
	     "Wie auch schon vorne, ist hier ebenfalls alles von oben bis "
	     "unten mit allerlei Zeugs vollgestopft. Die Mitte des Raumes "
	     "wird von einem grossen Amboss eingenommen, an dem hin und "
	     "wieder der Schmied arbeitet. Die Rueckwand besteht aus einem "
	     "gigantischen Schmiedeofen und einem grossen Haufen Kohle."));
  
  SetProp(P_NOREST, BS("Du kannst doch nicht einfach in einem Laden rasten!"));
  
  AddDetail(({"zeugs","zeug"}),
	    "Das gleiche Zeugs wie vorne: allerlei Waffen, Ruestungen und "
	    "sonstiges Geruempel.");
  
  AddDetail(({"geruempel"}),
	    "Du staunst, wieviel Geruempel man in so einem Laden stapeln "
	    "kann. Vorne liegt natuerlich viel mehr herum, dennoch liegen "
	    "hier einige Waffen, Ruestungen in allen Groessen und sonstiger, "
	    "nur teilweise noetiger Schnickschnack herum.");
  
    AddDetail(({"ruestungsgroessen","groessen"}),
	    "Du siehst Ruestungen in allen Groessen, sogar welche, die Dir "
	    "passen koennten.");
  
  AddDetail(({"schnickschnack"}),
	    "Sooooviel! Du kannst das alles nicht in Worte fassen, soviel "
	    "Schnickschnack hast Du in Deinem ganzen Leben noch nicht "
	    "gesehen!");
  
  AddDetail(({"worte"}),
	    "Es ist so ueberwaeltigend viel, dass Du es kaum in Worte fassen "
	    "kannst.");
  
  AddDetail(({"ruestung","ruestungen"}),
	    "Dich juckt es in den Fingern, bei dem Gedanken an diese vielen, "
	    "tollen Ruestungen...");
  
  AddDetail(({"waffe","waffen"}),
	    "Soooviele schoene Waffen...");
  
  AddDetail(({"leben"}),
	    "So lang ist das nicht mehr...");
  
  AddDetail(({"finger"}),
	    "Bei den vielen, schoenen Ruestungen und Waffen juckt es Dich "
	    "schon etwas in den Fingern...");
  
  AddDetail(({"gedanken"}),
	    "Boese Gedanken! Boese Gedanken!");
  
  AddDetail(({"fussboden","boden"}),
	    "Der Boden hier ist mit einer dichten Schicht aus Kohlestaub, "
	    "Russ und Sand ueberzogen.");
  
  AddDetail(({"schicht"}),
	    "Eine dichte Schicht aus Kohlestaub, Russ und Sand.");
  
  AddDetail(({"kohlestaub","kohlestaubschicht","staubschicht"}),
	    "Der Kohlestaub stammt von dem grossen Haufen Kohle.");
  
  AddDetail(({"russ","russschicht"}),
	    "Der Russ stammt aus dem Schmiedeofen.");
  
  AddDetail(({"sand","sandschicht"}),
	    "Der Sand ist hier in der Wueste allgegenwaertig!");
  
  AddDetail(({"wueste"}),
	    "Wo denn sonst?");
  
  AddDetail(({"decke"}),
	    "Die Decke ist beinahe vollstaendig mit Russ ueberzogen. Du "
	    "kannst gerade noch die Querbalken erkennen.");
  
  AddDetail(({"balken","querbalken"}),
	    "Man erkennt noch schwach die Querbalken an der Decke, doch "
	    "auch sie sind beinaher vollstaendig mit Russ ueberzogen.");
  
  AddDetail(({"schmied"}),
	    "Hm, wo ist er denn hin?");

  AddDetail(({"mitte","raummitte"}),
	    "Die Raummitte wird von einem grossen Amboss eingenommen.");
  
  AddDetail(({"amboss"}),
	    "In der Mitte des Raumes befindet sich ein grosser, "
	    "tiefschwarzer Amboss. Obwohl er staendig vom Schmied "
	    "bearbeitet wird, weist er keinerlei Abnuetzungserscheinungen "
	    "auf. Seitlich wurden einige Werkzeuge befestigt, die "
	    "waehrend des Schmiedens benoetigt werden.");
  
  AddDetail(({"hammer","haemmer","schmiedehammer","schmiedehaemmer",
		  "werkzeug","werkzeuge"}),
	    "Einige, teilweise recht seltsam geformte Werkzeuge haengen "
	    "an dem Amboss, sie werden wohl zum Schmieden benoetigt.");
  
  AddDetail(({"schmieden"}),
	    "Ein Schmiedeofen, ein Amboss, ein grosser Haufen Kohle...\n"
	    "Ja, hier wird geschmiedet.");
  
  AddDetail(({"haufen","kohlehaufen","kohle"}),
	    "Ein grosser Haufen Kohle liegt hier herum. Mit der Kohle "
	    "wird der Schmiedeofen betrieben.");
  
  AddDetail(({"ofen","schmiedeofen","schmiedofen"}),
	    "Der grosse Schmiedeofen nimmt fast die gesamte Rueckwand "
	    "des Raumes ein. Ein grosses Schmelzbecken haengt ueber der "
	    "Glut. Du siehst, wie das Metall darin koechelt.");
  
  AddDetail(({"wand","rueckwand"}),
	    "Die gesamte Rueckwand wird von einem grossen Schmiedeofen "
	    "eingenommen.");
  
  AddDetail(({"waende"}),
	    "Die Rueckwand wird von einem grossen Schmiedeofen eingenommen, "
	    "die anderen beiden Waende sind schwarz vom vielen Russ. Du "
	    "erkennst jedoch hin und wieder Umrisse irgendeines Musters, "
	    "das offenbar total verrusst ist.");
  
  AddDetail(({"muster"}),
	    "Du kannst leider nur noch schwach die Umrisse erkennen.");
  
  AddDetail(({"umriss","umrisse","musterumrisse","musterumriss"}),
	    "Schwach erkennst Du die Umrisse eines Musters auf den stark "
	    "verschmutzten Waenden.");
  
  AddDetail(({"metall"}),
	    "Das Metall im Schmelzbecken KOCHT! Das ist sicher sehr heiss...");
  
  AddDetail(({"becken","schmelzbecken"}),
	    "Das Schmelzbecken haengt ueber der Glut. Es ist voll mit "
	    "kochendem Metall!");
  
  AddDetail(({"glut"}),
	    "Die Glut ist verdammt heiss. Mit einer kleinen Schaufel laedt "
	    "der Schmied immer wieder etwas Kohle nach, um die Glut noch "
	    "weiter anzuheizen. Sie wird gebraucht, um das Metall schmelzen "
	    "zu koennen.");
  
  AddDetail(({"schaufel"}),
	    "Die ist zum Nachschaufeln der Kohle in die Glut.");
  
  AddDetail(({"nachschaufeln"}),
	    "Mit der kleinen Schaufel wird Kohle in die Glut "
	    "nachgeschaufelt.");
  
  AddDetail(({"laden","raum","geschaeft"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"banjal"}),
	    "Der befindet sich im vorderen Teil des Ladens.");
  
  AddDetail(({"teil","hinteren teil","hinterer teil"}),
	    "Du befindest Dich hier im hinteren Teil des Ladens.");
  
  AddDetail(({"vorderen teil","vorderer teil"}),
	    "Der befindet sich vorne ;P");
  
  AddDetail(({"abnuetzungserscheinung","abnuetzung"}),
	    "Jedenfalls kannst Du keine entdecken.");
  
  
  AddCmd(({"schaufel","schaufle"}), "cmd_schaufeln");
  AddCmd(CMD_NEHMEN, "cmd_nehmen");
  
  Licht("hell");
  Umgebung("heiss",TT_HOUSE, 1);
  AddExit("vorne", ([EX_DEST: ROOM "ara_1_5_0",
		     EX_MSG: "wieder zurueck nach vorne"]));
  
  AddItem(NPC "tanjal", REFRESH_DESTRUCT);
}

nosave int cmd_schaufeln(string str)
{
  notify_fail(BS("Was willst Du denn nachschaufeln?"));
  if(!str) return 0;
  
  if(str=="kohle nach" || str=="nach")
    if(present("tanjal"))
      return write(BS("Tanjal meint: Fass hier ja nichts an!")), 1;
    else
      return write(BS("Tanjal ist nicht da. Du greifst sicherheitshalber "
		      "nichts an.")), 1;
  
  return 0;
}

nosave int cmd_nehmen(string str)
{
  if(!str) return 0;
  
  if(str=="kohle"||str=="kohlenstueck"||str=="stueck kohle"||
     str=="kohle vom haufen"||str=="kohle vom kohlehaufen"||
     str=="kohlenstueck vom haufen"||str=="kohlenstueck vom kohlehaufen"||
     str=="stueck kohle vom haufen"||str=="stueck kohle vom kohlehaufen")
    return write(BS("Du laesst die Kohle lieber da liegen!")), 1;
  
  return 0;
}
