#include "../def.h"
#include <pub.h>

inherit "std/pub";
inherit MOST "std_room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Lokal 'Wuesten-Sturm'");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem kleinen, relativ kuehlen Lokal, das einem "
	     "alten, gemuetlichen Mann gehoeren zu scheint. Der Tresen ist "
	     "blitzblank geputzt und davor stehen zwei kleine Tische. Der "
	     "Besitzer steht hinter dem Tresen und ist staendig damit "
	     "beschaeftigt, alles schoen sauber zu halten. Sonnenlicht "
	     "durchflutet den Raum und gibt der Atmosphaere eine gemuetliche "
	     "Note."));
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "wirt" );
  SetProp(P_PUBKEEPER_NAME, "Achmed Ach Lachned");
  SetProp(P_PUBKEEPER_GENDER, MALE );

  AddDetail(({"lokal","kneipe"}), 
	    "Du befindest Dich im einzigen Lokal hier in der Wueste.");

  AddDetail(({"mann","wirt","besitzer"}), 
	    "Der Besitzer der Kneipe macht einen gemuetlichen Eindruck.");

  AddDetail(({"eindruck"}), 
	    "Das ist doch nicht so wichtig.");

  AddDetail("wueste", 
	    "Ist Dein Hirn schon so trocken, dass Du nicht mehr weisst, "
	    "wo Du bist?");

  AddDetail("hirn", 
	    "Du kannst es nicht mehr fuehlen. Scheint trocken zu sein.");

  AddDetail("note", 
	    "Es ist wirklich gemuetlich hier.");

  AddDetail(({"tisch","tische"}), 
	    "Das sind kleine Tische.");

  AddDetail("tresen", 
	    "Der Tresen ist sehr sauber geputzt. Von Staub ist hier nichts "
	    "zu sehen.");

  AddDetail("staub", 
	    "Definitiv kein Staub zu sehen.");

  AddDetail(({"sonnenlicht", "atmosphaere"}), 
	    "Das Sonnenlicht sorgt fuer eine angenehme Atmosphaere im Raum.");

  AddDetail("raum", 
	    "Na, welcher Raum ist wohl gemeint, hm?");

  AddDetail("boden", 
	    "Der ist nicht so besonders hier.");

  AddDetail("decke", 
	    "Eine einfache, hoelzern getaefelte Decke.");

  AddDetail(({"wand","waende"}), 
	    "An einer Wand haengt ein Schild, "
	    "das Du mit <menue> lesen kannst.");

  AddDetail("schild", 
	    "Du kannst es mit <menue> lesen.");

  AddDrink("Tafelwasser", ({"tafelwasser","wasser"}),
	   90, 5, 0, 2,
	   ({"Der Wirt bringt Dir ein Glas frisches Tafelwasser. "
	       "Es schmeckt herrlich erfrischend.\n", 
	       "&& erfrischt sich mit einem Glas Tafelwasser.\n"}));
  
  AddDrink("Spice-Wein", ({"spicewein", "wein"}), 
	   100, 20, 5, 3, 
	   ({"Der Wirt bringt Dir ein Glas voll mit einer seltsam gefaerbten "
	       "Fluessigkeit, die extrem nach Zimt riecht. Du trinkst das Glas in "
	       "einem Zug aus und spuerst ein komisches Ziehen im Hals.\n",
	       "&& bekommt ein Glas mit einer uebel riechenden Fluessigkeit und "
	       "trinkt es auf einmal aus.\n"}));

  AddDrink("Chrt-Likoer", ({"likoer", "chrt", "chrtlikoer", "chrt-likoer"}),
	   323, 23, 2, 9,
	   ({"Der Wirt stellt Dir ein Glas mit violetter Fluessigkeit hin. Als Du "
	       "ihn ansiehst, meint er nur: \"Trinken! Nicht fragen!\". Du folgst "
	       "seinem Rat und kippst das Zeug runter. Naja, schmeckte garnicht "
	       "einmal so schlecht.\n",
	       "&& bekommt ein Glas mit einer seltsam violetten Fluessigkeit, "
	       "schaut zuerst skeptisch, trinkt es dann aber aus.\n"}));
  
  AddDrink("Kaffee", ({"kaffee"}), 
	   25, ({0,20,0}), 0, 5, 
	   ({"Der Wirt bringt Dir einen Kaffee, den Du genuesslich trinkst.\n"
	       "Uffz, ist der stark...\n", "&& bekommt einen Kaffee und "
	       "trinkt ihn aus.\n"}));
  
  AddDrink("Kaktussaft", ({"saft","kaktussaft"}), 
	   50, 10, 0, 4,
	   ({"Der Wirt bringt Dir einen Kaktussaft, der Dich sehr erfrischt.\n",
	       "Der Wirt bringt &3 einen Kaktussaft.\n"}));

  
  AddDrink("Scheich-Cocktail", ({"cocktail", "scheich-cocktail"}), 
	   2500, 70, 20, 20,
	   ({"Der Wirt oeffnet eine kleine Flasche und gibt sie Dir. "
	       "Du leerst sie auf einen Schluck und hast urploetzlich "
	       "das Gefuehl, abzuheben.\n", "&& nimmt einen tiefen "
	       "Schluck aus einem kleinen Flaeschchen und bekommt "
	       "ploetzlich einen glasigen Blick.\n"}));

  
  AddFood("Bratwurm 'Wuestensturm'", ({"bratwurm","wurm"}), 
	  400, 50, 20,
	  ({"Du bekommst einen Teller voll mit irgendeinem lecker riechenden Zeug, "
	      "dass Du in einem Anflug von Appetit verschlingst.\n",
	      "&& verschlingt das Essen, scheinbar ohne darueber nachzudenken, was "
	      "das auf dem Teller eigentlich ist.\n"}));

  AddFood("Sandwurmrippchen", ({"rippchen","sandwurmrippchen","wurmrippchen"}),
	  250, ({30,20,10}), 15,
	  ({"Der Wirt bringt Dir einen Teller mit saftigen Sandwurmrippchen. "
	      "Genuesslich schmatzend nagst Du alle Rippchen ab. *ruelps* Wohl "
	      "etwas zuviel Knoblauch erwischt.\n",
	      "&& bekommt einen Teller voller Sandwurmrippchen und stuerzt sich "
	      "schmatzend darauf. Ein Ruelpser bestaetigt, dass es &3 geschmeckt "
	      "hat.\n"}));

  AddFood("Klapperschlange \(knusprig\)", ({"schlange","klapperschlange"}),
	  390, ({35,30,5}), 17,
	  ({"Der Wirt reicht Dir ein laengliches, gewundenes Etwas, dass Du "
	      "irgendwie als Klapperschlange identifizierst. Du steckst das "
	      "eine Ende einfach mal in den Mund und schwupps hat Du die ganze "
	      "Schlange aufgegessen.\n",
	      "&& knuspert an einer Klapperschlange herum und da ist sie auch "
	      "schon gegessen.\n"}));

/*
  AddFood("Grnagsalat \(fuer Vegetarier\)", ({"salat","grnagsalat","vegetariersalat"}),
	  250, ({5,5,2}), -1,
	  ({"Der Wirt bringt Dir einen Teller mit seltsam anmutenden, gruenblauen "
	      "Blaettern darauf und einer weissen Sauce. Du faengst an, den "
	      "Salat wie ein Karnickel reinzustopfen. Hinundwieder knirscht es "
	      "zwischen Deinen Zaehnen, doch eigentlich schmeckt es Dir ganz gut, "
	      "doch Du hast noch immer Hunger.\n",
	      "&& verspeist zaehneknirschend einen Grnagsalat.\n"}));
*/

  AddItem(NPC "wirt", REFRESH_DESTRUCT);
  
  Licht("hell");
  Umgebung("warm",TT_HOUSE, 1);
  Ausgaenge("ara",({"westen"}));
}




