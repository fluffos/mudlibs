#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Das Stadttor");
  SetProp(P_INT_LONG,
	  BS("Du stehst unter dem oestlichen Teil des Westtores. Es besteht "
	     "komplett aus schwarzem Stein und wurde dazu entworfen, "
	     "ungebetene Gaeste abzuwehren. Nach Norden und Sueden fuehren Tueren "
	     "zu den Stadtmauern. Mitten durch das Westtor geht das grosse "
	     "Sicherheitsgitter, gefertigt aus dem besten zwergischen Metall, um "
	     "Feinde mit Sicherheit draussenhalten zu koennen."));
  
  AddDetail(({"feind", "feinde"}),
	    "Du moechtest gar nicht genau wissen, was damit gemeint sein koennte.");
  AddDetail(({"tor", "westtor", "bauwerk"}),
	    "Das Westtor ist ein maechtiges Bauwerk. Wenn Du durch dieses Tor nach "
	    "Westen durchschreitest, wirst Du nicht den Schutz der Stadt hinter Dir "
	    "lassen.");
  AddDetail(({"stein"}),
	    "Ein seltsam glatter, schwarzer Stein, der unglaublich stabil zu sein "
	    "scheint.");
  AddDetail(({"gaeste"}),
	    "Ungebetene Gaeste werden von diesem Tor sicher effizient abgehalten.");
  AddDetail(({"norden", "sueden", "sicherheit", "teil"}),
	    "Das ist doch wirklich nicht wichtig.");
  AddDetail(({"mauer", "mauern", "stadtmauer", "stadtmauern"}),
	    "Die Mauern sind ziemlich hoch und sehr stabil gebaut.");
  AddDetail(({"gitter", "sicherheitsgitter"}),
	    "Das Gitter besteht aus dem haertesten zwergischen Metall, das im "
	    "Silberland gefunden werden konnte.");
  AddDetail(({"silberland"}),
	    "Du befindest Dich im Silberland.");
  AddDetail(({"metall"}),
	    "Du kannst es nicht erkennen, aber es sieht sehr stabil aus.");
  AddDetail(({"arrakeen", "hauptstadt", "stadt", "wueste"}),
	    "Arrakeen ist die Hauptstadt der Wueste und Du befindest Dich mitten "
	    "in Arrakeen.");
  AddDetail(({"schutz"}),
	    "Vielleicht sehnst Du Dich irgendwann einmal nach dem Schutz von "
	    "Arrakeen, wenn Du in der Wueste bist.");
  AddDetail(({"tuer", "tueren"}),
	    "Wenn Du durch die Tueren gehst, so kannst Du einmal im Schutz der "
	    "Mauern um die Stadt gehen.");

  Licht("hell");
  Umgebung("heiss", TT_TOWN, 0);
  Ausgaenge("ara",({"norden","sueden","westen","osten"}));
  
  AddItem(NPC "stadtwaechter", REFRESH_DESTRUCT);
  AddItem(NPC "stadtwaechter", REFRESH_DESTRUCT);  
}
