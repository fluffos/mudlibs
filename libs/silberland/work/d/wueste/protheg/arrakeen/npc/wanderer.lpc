#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Wanderer");
  SetProp(P_LONG, 
	  BS("Der alte Wanderer zwischen den Welten sieht alt aus. Er hat "
	     "ein vom Wetter gegerbtes Gesicht und schneeweisse Haare. "
	     "Seine Kleidung ist scheinbar einfach, jedoch erkennst Du, "
	     "dass es sich um die allerfeinsten Stoffe handelt. Er traegt "
	     "nur einen Stock bei sich."));
  SetProp(P_NAME, "Wanderer");

  create_default_elf(25, MALE);
  AddId(({"wanderer", "elf"}));

  SetProp(P_ALIGN, 700);

  SetProp(P_HANDS, 
	  ({" mit seinen alten Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));

  SetProp(P_MSGIN, "kommt auf seinen Stock gestuetzt an");
  SetProp(P_MSGOUT, "geht auf seinen Stock gestuetzt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(P_DEFAULT_INFO, "sagt: So etwas hab ich noch nie gehoert.\n");

  SetProp(P_NOATTACK, 1);
}

