#include "../def.h"

nosave string *feinde;

void create()
{
  if(is_clone(ME)) return destruct(this_object());

  feinde=({});
}

public void hilferuf(object pl)
{
  if(member(feinde, getuid(pl))==-1)
    {
      feinde+=({getuid(pl)});

      domainshout("Ein Stadtwaechter ruft: "+pl->Name()+" greift uns an!\n",
		  "/d/wueste/protheg/arrakeen/room",1);
  }
}

