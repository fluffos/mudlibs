/*
  Ein einaeugiger Gnom
  Imun gegen Spells und schwer zu treffen...
  Hat ein spezielles Item fuer den, der ihn toetet...
*/

#include "../def.h"

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein einaeugiger Gnom");
  SetProp(P_LONG,
	  BS("Ein kleiner, einaeugiger Gnom huepft vor Dir auf und ab. "
	     "Er bewegt sich so schnell, dass Du ihn nicht einmal genau "
	     "erkennen kannst... Du siehst nur, dass seine Haut total "
	     "mit Schlamm, oder sonstigem Dreck bedeckt ist, was ihn "
	     "anscheinend vor der Hitze schuetzen soll. "
	     "Ansonsten traegt er nur einen kleinen Filzhut und einen "
	     "hoelzernen Wanderstab."));
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));
  AddId(({"gnom", "augengnom", "\ngnom", "Keulenexperte"}));

  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinen kleinen Haenden",
		       QueryProp(P_HANDS)[1], DT_SLASH}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 111);
  SetProp(P_WEIGHT, 35653);
  SetProp(P_ALIGN, -20);
  SetProp(P_WIMPY, 10);
  AddClass(CL_GNOME);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   -1.0, 
    DT_LIGHTNING: -1.0, DT_EXPLOSION:  0.0, DT_SOUND:   0.0, DT_LIGHT: -1.0,
    DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
    DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0 ]) );
  SetProp(P_NOMAGIC, 20);

  AddDetail(({"stab","kampfstab","wanderstab"}),
	    "Ein langer, aus Holz gefertigter Stab. Viele Magier benutzen "
	    "solche Staebe als Verteidigungswaffe. Aber auch als Wanderstab "
	    "kann man ihn benutzen.");
  AddDetail(({"hut","filzhut"}),
	    "Der Filzhut ist schwarz und hat eine nach oben gebogene Krempe. "
	    "Er ist riesengross und eignet sich gut dafuer, Regen abzuhalten, "
	    "oder sein Gesicht zu verbergen, indem man ihn nach unten zieht. "
	    "Auch bei starkem Sonnelicht ist so ein Hut ganz nuetlzich, da "
	    "die Augen beschattet werden.");
  AddDetail(({"haut"}),
	    "Die Haut des Gnomes ist ueber und ueber mit Schlamm und "
	    "sonstigem Dreck bedeckt.");
  AddDetail(({"dreck","schlamm"}),
	    "Anscheinend bietet der viele Schlamm und Dreck dem Gnom einen "
	    "guten Hitzeschutz.");
  AddDetail(({"hitze","schutz","hitzeschutz","grund"}),
	    "Irgendeinen Grund wird der ganze Dreck ja wohl haben...");


  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kippt tot um.\n");

  AddInfo(DEFAULT_INFO, 
	  ({"scheint Dich nicht zu verstehen.\n",
	      "fragt: Buaha Afja Ouf Anga?\n",
	      "kratzt sich am Kopf.\n",
	      "gruebelt vor sich hin.\n",
	      "meint: Ausfad Unga Muguli.\n"}));

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Gnom will das nicht tragen muessen.\n"}));
  
  SetProp(P_SPELLRATE, 80);
  
  AddSpell(4,300,
	   "Der Gnom wuselt blitzschnell um Dich herum und trifft Dich von "
	   "hinten.\n",
	   "Der Gnom wuselt blitzschnell um @WEN herum.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,250,
	   "Der Gnom schwingt seinen Kampfstab...\n",
	   "Der Gnom schwingt seinen Kampfstab...\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
	   "Der Gnom wuselt blitzschnell um Dich herum und trifft Dich von hinten.\n",
	   "Der Gnom wuselt blitzschnell um @WEN herum.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  SetChats(1, 
	   ({"Der Gnom wuselt um Dich herum.\n",
	       "Der Gnom huepft aufgeregt hin und her.\n",
	     ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );

/*  SetProp(P_MNPC_AREA, "/d/wueste/protheg/arrakeen/ara");
  SetProp(P_MNPC_WAIT, ({50, 40, 50}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wueste/protheg/arrakeen/room/ara_2_4_0");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES);
*/
  SUID;
  /*
  CLONEME("/p/weapon/club/kampfstab");
  command("zuecke stab");
  
  CLONEME("/p/armour/helm/hut");
  command("trage hut");
*/
}

void die(int poisondeath) 
{
  if(objectp(QueryProp(P_KILLER)) && interactive(QueryProp(P_KILLER)))
    {
      tell_room(MENV, BS("Dem sterbenden Gnom faellt das Auge heraus..."));
      //blobb
    }
  
  ::die(poisondeath);
}

int Defend(int dam, mixed dtype, mixed spell, object enemy)
{
  if(!pointerp(dtype))
    dtype=({ dtype });

  if(sizeof(dtype & ({ DT_EXPLOSION, DT_TERROR, DT_SOUND })))
    return ::Defend(dam, dtype, spell, enemy);

  if(sizeof(dtype & ({ DT_SLASH, DT_BLUDGEON, DT_PIERCE, DT_SQUEEZE, DT_WHIP,
		       DT_RIP })) && !spell)
    {
      if(dam>100)
	{
	  tell_room(MENV, BS("Der Gnom weicht der Attacke "+
			     (random(2) ? "knapp ":"")+"aus."));
	  dam=60+random(40);
	}
      
      return ::Defend(dam, dtype, spell, enemy);
    }

  tell_room(MENV, BS("Der Gnom weicht der Attacke muehelos aus..."));
  return ::Defend(0, dtype, spell, enemy);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  
  if(touch)
    call_out("reaction", 0, TP,
	     "Als Du den Gnom beruehrst, durchzuckt Dich ein elektrischer "
	     "Schlag!\nScheinbar ist der Gnom statisch geladen!\n",
	     "Als "+TP->name(WER)+" den Gnom beruehrt, entlaedt sich dieser "
	     "ploetzlich statisch!");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, macher);
      tell_room(MENV, BS(andere), ({ob}));
      ob->Defend(100+random(50), ({DT_ELECTRIC}), 
		 ([SP_SHOW_DAMAGE:1, SP_NO_ENEMY:1]), TO);
    }
}
