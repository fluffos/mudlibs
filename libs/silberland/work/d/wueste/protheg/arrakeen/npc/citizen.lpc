#include "../def.h"

inherit MOST "mynpc";

nosave void DefineType()
{
  switch(random(100))
    {
    case  0 .. 49:
      AddId(({"einwohner","arrakeenbuerger","buerger"}));
      SetProp(P_SHORT, "Ein Einwohner von Arrakeen");
      SetProp(P_LONG, 
	      BS("Dieser Einwohner ist wohl damit beschaeftigt, seinen "
		 "Tagesgeschaeften nachzugehen."));
      create_default_mensch(12+random(5));
      SetProp(P_ALIGN, 100+random(50));
      SetProp(P_NAME, ({"Einwohner von Arrakeen", "Einwohners von Arrakeen",
			"Einwohner von Arrakeen", "Einwohner von Arrakeen"}));
      SetProp(P_GENDER, MALE);

      AddMoney(150+random(300));
      
      CLONEME(ARMOUR "anzug");
      command_me("zieh anzug an");
      break;
    case 50 .. 74:
      AddId(({"einwohnerin","arrakeenbuergerin","buergerin"}));
      SetProp(P_SHORT, "Eine Einwohnerin von Arrakeen");
      SetProp(P_LONG, 
	      BS("Diese Einwohnerin ist wohl damit beschaeftigt, ihren "
		 "Tagesgeschaeften nachzugehen."));
      create_default_mensch(10+random(5));
      SetProp(P_ALIGN, 100+random(50));
      SetProp(P_NAME, ({"Einwohnerin von Arrakeen", "Einwohnerin von Arrakeen",
			"Einwohnerin von Arrakeen", "Einwohnerin von Arrakeen"}));
      SetProp(P_GENDER, FEMALE);
      
      AddMoney(150+random(300));
      
      CLONEME(ARMOUR "umhang");
      command_me("trage alles");
      break;
    default:
      AddId(({"kind"}));
      SetProp(P_SHORT, "Ein kleines Kind aus Arrakeen");
      SetProp(P_LONG, 
	      BS("Das Kind ist noch sehr jung und unerfahren. Doch das "
		 "scheint ihm nichts auszumachen, denn es rennt viel "
		 "lieber durch die Gassen auf der Suche nach "
		 "\"grossen Abenteuern\"."));

      create_default_mensch(5+random(3));

      SetProp(P_ALIGN, 100+random(50));
      SetProp(P_NAME, ({"Einwohnerkind", "Einwohnerkindes",
			"Einwohnerkind", "Einwohnerkind"}));
      SetProp(P_GENDER, NEUTER);
      SetProp(P_SIZE, 100+random(20));
      
      CLONEME(ARMOUR "anzug");
      command_me("trage alles");
      CLONEME(WEAPON "holzschwert");
      command_me("zuecke schwert");
      break;
    }
}

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SUID;
  
  AddId(({"\narrakeenbuerger"}));

  DefineType();
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15, T_RANGE_MAX:50]));
  
  SetProp(P_SPELLRATE, 25);
  
  AddSpell(2, 200, 
	   Name()+" haut Dir kraeftig in die Magengrube.\n",
	   Name()+" haut @WEM kraeftig in den Magen.\n",
	   ({DT_BLUDGEON,DT_TERROR}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 250, 
	   Name()+" tritt Dich fest.\n",
	   Name()+" tritt @WEN fest.\n",
	   ({DT_BLUDGEON,DT_TERROR}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 100, 
	   Name()+" versetzt Dir eine deftige Ohrfeige.\n",
	   Name()+" versetzt @WEM eine deftige Ohrfeige.\n",
	   ({DT_SLASH,DT_TERROR}), ([SP_SHOW_DAMAGE:1]));

  SetProp(P_LOG_INFO, "protheg/arrakeen/citizen");

  SetProp(P_DIE_MSG, " stirbt mit einem Fluch auf den Lippen.\n");

  SetProp(P_DEFAULT_INFO, "sagt: Tut mir leid, ich hab jetzt keine Zeit.\n");
  
  SetProp(P_REJECT, ({REJECT_KEEP, " steckt es ein und hastet weiter.\n"}));
  
  SetProp(P_MNPC_AREA, ROOM "ara");
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  //  SetProp(P_MNPC_DEFAULTROOM, get_dir(ROOM "ara*")[random(40)]);
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_OUTDOORS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);
}

void init()
{
  ::init();

  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));

  if(TP && TP->id("\narrakeenbuerger") && !random(3))
    call_out("begruesse_buerger",0);
  
  if(TP && TP->id("\narrakeenwaechter") && !random(2))
    call_out("begruesse_waechter",0);
}

int Defend(int damage, string dam_type, mixed spell, object enemy)
{
  WAECHTER->hilferuf(enemy);

  return::Defend(damage, dam_type, spell, enemy);
}

void begruesse_buerger()
{
  if((TP) && (present(TP, MENV)))
    tell_room(ENV(ME), 
	      ({Name()+" winkt "+TP->name(WEM)+" zu.\n",
		  Name()+" begruesst "+TP->name(WEN)+" stuermisch.\n",
		  Name()+" umarmt "+TP->name(WEN)+" zur Begruessung.\n"})[random(3)]);
}

void begruesse_waechter()
{
  if((TP) && (present(TP, MENV)))
    tell_room(ENV(ME), 
	      ({Name()+" nickt "+TP->name(WEM)+" zu.\n",
		  Name()+" begruesst "+TP->name(WEN)+" hochachtungsvoll.\n",
		  Name()+" verneigt sich vor "+TP->name(WEM)+".\n"})[random(3)]);
}

void die(int poisondeath) 
{
  KILLMASTER->register_npc_death(QueryProp(P_KILLER)||TP);
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    KILLMASTER->register_player_death(player, lxp);
  
  ::NotifyPlayerDeath(player, killer, lxp);
}
