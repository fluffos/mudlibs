/*
** Der Wirt aus Arrakeen
**
** by Muaddib@Silberland
**
** Ueberarbeitet und adaptiert by PROtheG
*/

#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"achmed","wirt"}));

  create_default_mensch(15,MALE);

  SetProp(P_SHORT, "Achmed Ach Lachned der hiesige Wirt");
  SetProp(P_LONG, 
          BS("Achmed scheint die Atmosphaere in seinem Lokal zu "
	     "geniessen. Er kennt die meisten seiner Kunden und hat "
	     "den Ruf, denen zu helfen, die in Not sind."));
  SetProp(P_NAME, "Achmed");

  SetProp(P_ALIGN, 250);
  SetProp(P_SIZE, 175);
  
  SetProp(P_SPELLRATE, 40);
  SetProp(P_ARTICLE, 0);
  
  AddSpell(1, 300, 
	   "Achmed holt einen Holzknueppel hinter der Theke hervor und "
	   "haut zu.\n",
	   "Achmed haut @WEM mit einem Holzknueppel auf den Kopf.\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Achmed begruesst Dich in seinem Lokal.\n",
      "Achmed fuellt ein Glas mit Kaktussaft.\n",
      "Achmed mixt einen Scheichcocktail.\n",
      "Achmed bekommt ein grosses Stueck Sandwurm geliefert.\n"
      "Dir wird schlecht.\n",
      "Achmed serviert jemandem eine knusprige Klapperschlange.\n"
      "Achmed redet mit einem Einwohner.\n",
      "Achmed verbrueht sich an einer Tasse Kaffee.\n" }));

  SetAttackChats(6, ({
    "Achmed schaut Dich entsetzt an.\n",
      "Achmed wird sauer und schreit: Lass das bleiben!\n",
      "Achmed ruft um Hilfe.\n",
      "Achmed sagt: Das wirst Du bitter bereuen.\n" }));

  SetProp(P_LOG_INFO, "protheg/arrakeen/achmed");

  AddInfo(DEFAULT_INFO, 
	  "Willst Du nicht lieber etwas bestellen?",
	  "sagt: ");
  
  AddInfo(({"arbeit","lokal","kneipe"}),
	  "Willkommen in meinem Lokal 'Wuesten-Sturm'.",
	  "erklaert stolz: ");
  
  AddInfo(({"tafelwasser","wasser"}), 
	  "Das ist ein ganz besonderes Wasser. Wir lassen es extra "
	  "aus dem Silberwald herbringen.", 
	  "erzaehlt :");

  AddInfo("silberwald", 
	  "Da gibt es sehr gutes Wasser.", 
	  "sagt: ");

  AddInfo(({"chrt-likoer", "chrtlikoer", "likoer"}),
	  "Hehe, dazu sage ich nur Trinken! Nicht fragen!",
	  "grinst: ");
  
  AddInfo(({"spice-wein", "spice", "spicewein", "wein"}),
	  "Dieser Wein wird von meinem Grossvater hergestellt. Wie er "
	  "das genau macht, hat er mir noch nie gesagt.",
	  "fluestert :");

  AddInfo(({"kaffee"}),
	  "Der Kaffee hilft auch den Schwaechsten wieder zu neuer Kraft.", 
	  "wirbt: ");

  AddInfo("grossvater", 
	  "Ja, der kommt manchmal vorbei.", 
	  "sagt: ");

  AddInfo(({"kaktussaft", "saft","sonderangebot"}),
	  "Das ist ein besonders wertvoller Saft ohne Alkohol, der "
	  "zur Zeit im Sonderangebot ist.", 
	  "erklaert: ");

  AddInfo(({"scheich-cocktail", "scheichcocktail", "cocktail"}),
	  "Das ist unser bestes Getraenk. Es wird nach einem uralten "
	  "Rezept hergestellt. Das Rezept war frueher in Besitz eines "
	  "Scheichs, bis mein Grossvater es bekommen hat.", 
	  "sagt: ");

  AddInfo("scheich",
	  "Hmm, ich kann mich  nicht an den Namen erinnern.", 
	  "gruebelt: ");
  
  AddInfo(({"rezept"}),
	  "Das wird nicht verraten...",
	  "grinst geheimnisvoll: ");
  
  AddInfo(({"muaddib", "muad'dib", "mua"}),
	  "Muaddib...hmmm, ja, der kommt hier auch manchmal her. "
	  "Sein Name bedeutet in einer der alten Sprachen uebrigens "
	  "Wuestenspringmaus.", 
	  "erzaehlt: ");

  AddInfo(({"wuestenspringmaus", "springmaus", "maus"}),
	  "Das sind ganz suesse, kleine Maeuse, die in der Wueste "
	  "besonders gut ueberleben koennen. Manche Leute haben mir "
	  "schon erzaehlt, dass es noch Exemplare gibt, aber frag mich "
	  "nicht, wo.", 
	  "erklaert: ");

  AddInfo(({"sandwurm", "wurm", "bratwurm", "wuestensturm"}),
	  "Der wird extra fuer mein Lokal in der Wueste gefangen und "
	  "geschlachtet. Man muss ihn frisch zubereiten und keiner kann "
	  "das besser als ich.", 
	  "erklaert: ");
  
  AddInfo(({"rippchen","sandwurmrippchen"}),
	  "schmatzt nur.");
  
  AddInfo(({"knusprige schlange","schlange","knusprige klapperschlange",
	      "klapperschlange"}),
	  "Die schmackhafteste und knusprigste Klapperschlange weit und "
	  "breit. Hehe, das hier ist sowieso das einzige Lokal weit und "
	  "breit.",
	  "sagt: ");
  
  AddInfo("dusty",
	  "Ich hab vom Wirt in Midas erfahren, dass sie eh nur Saft und "
	  "Cola mag. Daher wird sie hier wohl auch nicht herkommen.",
	  "seufzt: ");
  
  AddInfo(({"cola"}),
	  "Nein, hier gibt es kein Cola!",
	  "meint: ");
  
  AddInfo("woody",
	  "Woody ist hier auch noch nicht gewesen. Aber Max, das ist der "
	  "Wirt in Midas, hat mir schon von ihm erzaehlt.", 
	  "sagt: ");
  
  AddInfo(({"midas"}),
	  "Die Stadt liegt ziemlich weit im Westen.");
  
  AddInfo(({"max"}),
	  "Das ist der Wirt in Midas.",
	  "sagt: ");
  
  AddInfo("creative",
	  "Crea... hmm, ja, der ist Stammgast hier. Meist kommt er mit "
	  "Muaddib her und dann reden die beiden immer.", 
	  "raunt: ");

  AddInfo(({"gebirgszwerg","angrox"}),
	  "Das ist doch dieser Gebirgszwerg, oder? Soll ziemlich nett sein, "
	  "war aber leider auch noch nicht da. Vielleicht kommt er ja mal "
	  "vorbei.", 
	  "sagt: ");

  AddInfo("feyaria",
	  "Ja, die war schon da. Hat sich die Speisekarte angeschaut und "
	  "dann ist sie wieder gegangen.", 
	  "sagt: ");

  AddInfo("eros", 
	  "Eros... der Goetterbote... nein, ich kenn ihn leider nicht "
	  "privat.", 
	  "ueberlegt: ");

  AddInfo("sargola",
	  "Jaja, der Sargola... Das ist doch der, der immer soviele Fehler im "
	  "Raum-Zeit-Gefuege produziert, oder?", 
	  "fragt: ");
  
  AddInfo(({"herzog","herrscher"}),
	  "Der Herzog lebt im Palast im Osten von Arrakeen. Ich habe ihn "
	  "jedoch erst einmal gesehen, als er damals bei der Eroeffnung "
	  "meines Lokals dabei war.",
	  "erzaehlt: ");
  
  AddInfo(({"palast","herzogspalast","herzogpalast"}),
	  "Der herzoegliche Palast befindet sich im Osten von Arrakeen. "
	  "Er soll von einem wunderschoenen Garten umgeben sein und ausserdem "
	  "von den herzoeglichen Streitkraeften bewacht werden.",
	  "sagt: ");
  
  AddInfo(({"garten","herzogsgarten"}),
	  "Der herzoegliche Garten soll der schoenste im ganzen Silberland "
	  "sein.",
	  "erzaehlt stolz: ");
  
  AddInfo(({"land","silberland"}),
	  "Sag bloss, Du weisst nicht, dass das hier das Silberland ist?",
	  "gruebelt: ");
  
  AddInfo(({"gefaengnis","bezirk","verbotener bezirk","zone"}),
	  "deutet nur mit einem Finger auf den Mund...");
  
  AddInfo(({"stadt","arrakeen"}),
	  "Na wo glaubst Du denn, dass Du Dich befindest?",
	  "sagt: ");
  
  AddInfo(({"rekrutierung","rekrutierungsbuero","buero"}),
	  "Das befindet sich hier irgendwo in der Stadt...",
	  "kratzt sich am Kopf: ");
  
  AddInfo(({"einwohner","bewohner","kunden"}),
	  "Arrakeens Einwohner sind alle sehr nett und sie lassen auch immer "
	  "viel Trinkgeld da, sofern sie es sich leisten koennen...",
	  "grinst: ");
  
  AddInfo(({"trinkgeld","geld"}),
	  "blickt Dich mit leuchtenden Augen an.");
  
  AddInfo(({"hafen","schiff","galeere"}),
	  "Weit im Sueden, wo das Meer beginnt, befindet sich Arrakeens "
	  "Hafen.",
	  "sagt: ");
  
  AddInfo(({"suedkueste"}),
	  "Arrakeens Hafen befindet sich an der Suedkueste.",
	  "sagt: ");
  
  AddInfo(({"ostkueste"}),
	  "Von der Ostkueste weiss ich nichts, die ist mir zu weit weg.",
	  "winkt ab: ");
  
  AddInfo(({"wueste"}),
	  "Gross! Heiss! Viel Sand! Kein Wasser! Nein, danke...",
	  "winkt ab: ");
  
  AddInfo(({"sand"}),
	  "Wo waere die Wueste denn ohne Sand?",
	  "fragt: ");
  
  AddInfo(({"sturm"}),
	  "Sturm? Wo? Aso... Du meinst wohl nur mein Lokal. ;-)",
	  "gruebelt: ");
  
  AddInfo(({"achmed","name","achmed ach lachned"}),
	  "Ja, ich bin der Achmed.",
	  "sagt laechelnd: ");
  
  AddInfo(({"wirt"}),
	  "Ja, ich bin der hiesige Wirt.",
	  "nickt: ");
  
  AddInfo(({"streitkraefte","streitkraft"}),
	  "Die herzoeglichen Streitkraefte beschuetzen den Palast. Ausserhalb "
	  "des Palastes patrouillieren nur die Stadtwaechter.",
	  "sagt: ");
  
  AddInfo(({"waechter","stadtwaechter"}),
	  "Dank der Waechter fuehle ich mich hier ziemlich sicher.",
	  "sagt: ");
  
  AddInfo(({"wanderer","heiler"}),
	  "Der sollte hier in Arrakeen eigentlich irgendwo herumlaufen.",
	  "meint: ");
  
  AddInfo(({"geruecht","geruechte"}),
	    "laechelt Dich nur geheimnisvoll an...");
  
  AddInfo(({"hilfe"}),
	  "Du willst mir helfen? Na dann los, bestell Dir was.",
	  "grinst: ");
  
  AddInfo(({"not"}),
	  "Bist Du in Not? Dann bestelle Dir schnell ein Glaeschen Spice-Wein "
	  "und es wird Dir gleich besser gehen!",
	  "laechelt: ");
  
  AddInfo(({"glaeschen","glaeschen wein"}),
	  "Bestelle Dir doch einfach gleich ein Glaeschen Spice-Wein!",
	  "sagt: ");
  
  AddInfo(({"fez"}),
	  "Ist er nicht huebsch? Den habe ich in Quaul erstanden.",
	  "erzaehlt: ");
  
  AddInfo(({"trinken","getraenk","getraenke","essen","speisen","speise",
	      "angebot","speisekarte"}),
	  "Auf dem 'menue' siehst Du alles, was ich anbiete.",
	  "sagt: ");
  
  AddInfo(({"alkohol","alkoholische getraenke","alkoholisches getraenk"}),
	  "Ja, ich habe auch alkoholische Getraenke im Angebot. Du siehst "
	  "sie bei 'menue'.",
	  "sagt: ");
  
  AddInfo(({"quaul"}),
	  "Quaul befindet sich weiter westlich in der Wueste, ist jedoch "
	  "ueber die Karavane recht bequem zu erreichen.",
	  "sagt: ");
  
  AddInfo(({"karavane","kamelkaravane"}),
	  "Die Karavane pendelt von hier nach Quaul und hinueber an den "
	  "westlichen Wuestenrand.",
	  "sagt: ");
  
  AddInfo(({"wuestenrand","gebirge"}),
	  "Weiter im Westen geht die Wueste direkt ins Gebirge ueber.");
  
  AddInfo(({"meer","ostmeer","suedmeer"}),
	  "Die Wueste grenzt im Sueden und im Osten direkt an Meer an.",
	  "sagt: ");
  
  AddInfo(({"ballon","heissluftballon","ballonfahrt"}),
	  "Gleich noerdlich von hier landet regelmaessig ein grosser "
	  "Heissluftballon der bis nach Tijara fliegt.",
	  "sagt: ");
  
  AddInfo(({"tijara","dschungel"}),
	  "Der Heissluftballon fliegt bis nach Tijara.",
	  "sagt: ");

  CLONEME("/d/wueste/protheg/kraterrand/armour/fez");
  command_me("trage fez");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WAECHTER->hilferuf(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}
