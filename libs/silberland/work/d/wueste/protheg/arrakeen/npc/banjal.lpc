#include "../def.h"
#include ROOM "pfand.h"

inherit "std/npc";

varargs void AI(string *x, string y, string z)
{
  if(strlen(z))
    AddInfo(x, y, z);
  else 
    AddInfo(x, y, "sagt: ");
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Berserkerzwerg Banjal Burrld laechelt Dich an");
  SetProp(P_LONG,
	  BS("Banjal Burrld ist ein uralter Zwergenberserker, der seinen "
	     "Beruf schon seit langem aufgegeben und sich als Haendler "
	     "niedergelassen hat. Seine Ruestung, die er nie auszieht, "
	     "erinnert noch an die alte Zeit. Ansonsten ist aus ihm ein "
	     "beinharter, unnachgiebiger Geschaeftszwerg geworden."));
  SetProp(P_NAME, 
	  ({"Banjal Burrld","Banjal Burrlds","Banjal Burrld","Banjal Burrld"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));
  AddId(({"banjal", "banjal burrld", "burld", "berserker","zwerg","NOWIMPY",
	      "NOCONTROL","zwergenberserker","berserkerzwerg","Axtmeister"}));
  set_living_name("banjal");

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen Haenden",
		QueryProp(P_HANDS)[1]+150,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 129);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -80);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_XP, QueryProp(P_XP)+1000*100);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:  -0.2, DT_COLD:   -0.2, DT_WATER:   0.2, 
	    DT_SOUND: -0.3, DT_POISON: -0.2, DT_TERROR: -0.2,
	    DT_MAGIC: -0.5, DT_MIND:   -0.2, DT_AIR:    -0.2]));

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 20);
  
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DIE_MSG,  " kippt tot nach hinten um.\n");
  SetProp(P_KILL_MSG, "Ha! Ich bin doch noch nicht eingerostet!\n");
  
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 9);
  
  call_other("/gilden/berserker", "learn_berserker_skills", 9000, 9000);
  
  ModifySkill("eisenhaut",    10000);
  ModifySkill("eisenhaut",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("kampfschrei",  10000);
  ModifySkill("kampfschrei",  ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("kopfstoss",    10000);
  ModifySkill("kopfstoss",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("spalten",      10000);
  ModifySkill("spalten",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("willenskraft", 10000);
  ModifySkill("willenskraft", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  
  AddSpell(2, 1, "", "", DT_BLUDGEON, "schrei");
  AddSpell(2, 1, "", "", DT_BLUDGEON, "stoss");
  AddSpell(1, 1, "", "", DT_BLUDGEON, "spalten");
  
  SetProp(P_SPELLRATE, 60);
  
  AddInfo(DEFAULT_INFO, 
	  ({"nickt nur.\n",
	      "sagt: Geh und nerv wen anderen!\n",
	      "kratzt sich gruebelnd am Kopf.\n",
	      "gruebelt und blickt schief.\n",
	      "fragt: Hae?\n",
	      "wird spaeter darueber nachdenken.\n",
	      "murmelt irgendwas in seinen Bart.\n"}));
  
  AI(({"hilfe","tafel","kleingedrucktes","lager","lagerung"}),
     "Da, lies die Tafel!");
  
  AI(({"geld"}),
     "Lass mich in Ruh!");
  
  AI(({"zinsen","zinssatz","unkosten","unkostenbeitrag"}),
     ZINSSATZ+" % Zinsen pro halben Tag pro aufbewahrtem Gegenstand.");
  
  AI(({"tag","tage"}),
     "86400 Sekunden.");

  AI(({"halber tag","halben tag"}),
     "43200 Sekunden.");
  
  AI(({"sekunde","sekunden"}),
     "Nerv nicht!");
  
  AI(({"nerven","nerv"}),
     "Ja, Du nervst!");
  
  AI(({"rate","raten"}),
     "33 Prozent! Pro Gegenstand! Pro halben Tag!");
  
  AI(({"gegenstand","gegenstaende","objekt","objekte","waffe","waffen",
	   "ruestung","ruestungen"}),
     "Nur "+MAX_ITEMS+" Objekte pro Kunde!");
  
  AI(({"kunde","kunden"}),
     "Das hoffe ich doch!");
  
  AI(({"schmied","hinten"}),
     "Hinten! Glocke!");
  
  AI(({"arrakeen","stadt"}),
     "Ja! Arrakeen ist hier!");
  
  //SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP, "Banjal Burrld meint: 'Nicht so'.\n" }) );

  /*  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );
  */

  SUID;
  
  enable_commands();
  
  CLONEME("/p/weapon/axe/kriegsbeil");
  //command("zuecke waffe");
  CLONEME( "/gilden/berserker/obj/stirnband" );
  CLONEME("/p/armour/armour/kettenhemd");
  CLONEME("/p/armour/boots/kampfstiefel");
  CLONEME("/p/armour/helm/topfhelm");
  command("trage alles");
}

int Defend(int dam, string dam_type, int spell, object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke beil");
  
  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) 
    command_me("eisenhaut");
  else
    if(!present("\nberserker_willenskraft",ME))
      command_me("willenskraft");
  
  return ::Defend(dam, dam_type,spell,enemy); 
}

void schrei(object enemy,int damage, mixed dam_type) 
{
  command_me("kampfschrei");
}

void stoss(object enemy,int damage, mixed dam_type) 
{
  //bei einem Zwerg eigentlich wurscht ;)
  if(100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE) > 30)
    command_me("kopfstoss");
  else
    command_me("zertreten");
}

void spalten(object enemy,int damage, mixed dam_type) 
{
  if(enemy->QueryProp(P_HP)<((40+random(11))*enemy->QueryProp(P_MAX_HP)/100))
    command_me("spalten");
  else
    stoss(enemy, damage, dam_type);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("waffen_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("waffen_check", 5);

  return ::StopHuntingMode(silent);
}

void waffen_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke beil weg");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe) 
    {
    case "albern":
      call_out("reaction", 0, TP,
	       "blickt Dich ernst an.",
	       "blickt ernst.");
      break;
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
	       "knufft Dich mit seinem Ellenbogen.",
	       "knufft "+TP->name(WEN)+" mit seinem Ellenbogen.");
      break;
    case "froh":
    case "nett":
    case "traurig":
      call_out("reaction", 0, TP,
	       "blickt Dich schief an.", 
	       "blickt "+TP->name(WEN)+" schief an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "meint nur: Lass das!",
	       "meint nur: Lass das!");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "seufzt nur.",
	       "seufzt nur.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
