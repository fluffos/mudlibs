/*
**  Krundel Springvombaum der Haendler
**
**  Ueberarbeitet by PROtheG
*/

#include "../def.h"

#define AI(x,y) AddInfo(x, y, "sagt: ")

inherit MOST "mynpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"krundel","hobbit","haendler"}));

  create_default_hobbit(15, MALE);

  SetProp(P_SHORT, 
	  "Krundel Springvombaum fuchtelt aufgeregt mit seinen Armen umher");
  SetProp(P_LONG, 
          BS("Obwohl Krundel bereits ziemlich alt und runzelig aussieht, "
	     "strotzt er geradezu vor Vitalitaet. Bei jedem neuen Kunden, "
	     "der seinen Laden betritt, erhellt sich das Gesicht des kleinen "
	     "Hobbits und seine Arme beginnen vor Aufregung unkontrolliert "
	     "herumzufuchteln."));

  SetProp(P_NAME, ({
    "Krundel Springvombaum","Krundel Springvombaum",
      "Krundel Springvombaum","Krundel Springvombaum"}));

  SetProp(P_ALIGN, 200+random(100));
  SetProp(P_ARTICLE, 0);

  SetProp(P_HANDS, ({" mit seinen herumfuchtelnden Armen", 
		       QueryProp(P_HANDS)[1]+random(50), DT_SLASH})); 
  SetProp(P_SPELLRATE, 40);
  
  AddSpell(2, 300, 
	   Name()+" tritt Dich fest.\n",
	   Name()+" tritt @WEN fest.\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400, 
	   Name()+" wirbelt mit seinen Armen und trifft Dich hart von hinten.\n",
	   Name()+" wirbelt mit seinen Armen und trifft @WEN hart von hinten.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]));
  
  SetChats(4, ({
    Name()+" fuchtelt aufgeregt mit seinen Armen umher.\n",
      Name()+" sortiert ein paar Gegenstaende um.\n",
      Name()+" sagt: Oh, ein neuer Kunde! Sei gegruesst!\n",
      Name()+" fragt: Willst Du nicht was kaufen?\n",
      Name()+" unterhaelt sich aufgeregt mit einem Einwohner.\n",
      Name()+" blickt sich nach neuen Kunden um.\n" }));
  
  SetAttackChats(6, ({
    Name()+" bruellt Dich an.\n",
      Name()+" bruellt: Die Stadtwaechter werden gleich hier sein!\n",
      Name()+" ruft: Hilfe! So helft mir doch!\n",
      Name()+" schimpft: Das wirst Du bitter bereuen.\n" }));
  
  SetProp(P_LOG_INFO, "protheg/arrakeen/haendler");

  AddInfo(DEFAULT_INFO, 
	  ({"sagt: Aeh, keine Ahnung.\n",
	      "fragt: Woher soll ich das wissen?\n",
	      "gruebelt darueber nach.\n",
	      "zuckt nur mit den Schultern.\n",
	      "fragt: Willst Du nicht lieber etwas kaufen?\n"}));
  
  AI(({"krundel","name"}),
     "Ja, mein Name ist Krundel, Krundel Springvombaum.");
  
  AI(({"laden"}),
     "Der Laden hier gehoert mir, ist er nicht wunderschoen?");
  
  AI(({"springvombaum"}),
     "Einer meiner Urahnen sprang einem von einem einhundert Meter "
     "hohen Baum!");
  
  AI(({"meter","hundert","einhundert"}),
     "Hmm, so genau weiss ich es nicht, aber der Baum soll unglaublich "
     "hoch gewesen sein.");
  
  AI(({"baum","eiche"}),
     "Eine riesige uralte Eiche soll es gewesen sein!");

  AI(({"urahn","urahnen","urahne"}),
     "Welchen meiner Urahnen meinst Du? Ich kenne weit ueber vierhundert.");
  
  AI(({"ahn","ahnen","ahne"}),
     "Welchen meiner Ahnen meinst Du? Ich kenne ca dreihundert.");
  
  AI(({"bekannter","bekannte"}),
     "Ich habe soviele, ich kann nichtmal schaetzen wie viele...");
  
  AI(({"verwandter","verwandte"}),
     "Davon habe ich so viele...");
  
  AI(({"hobbit","hobbits"}),
     "Wir Hobbits kennen alle unsere Verwandten, Bekannten, Ahnen und sogar "
     "Urahnen.");

  AI(({"derlim","hobbingen"}),
     "Derlim liegt irgendwo ganz weit im Westen, ich war noch nie dort. Ich "
     "bin in einer kleinen Hobbitsiedlung am noerdlichen Wuestenrand "
     "aufgewachsen.");

  AI(({"geruecht","geruechte"}),
     "Dumdidum...");
  
  AddInfo(({"rand","wuestenrand","norden"}),
	  "deutet nach Norden.");
  
  AI(({"stadt","arrakeen"}),
     "Ja, wie befinden uns hier in der Stadt Arrakeen.");
  
  AI(({"hilfe"}),
     "Hilfe? Ich? Aeh, willst Du vielleicht etwas kaufen?");
  
  AI(({"wueste"}),
     "Du befindest Dich hier in der Wueste, ja ;-)");
  
  AI(({"waren","ware","angebot","angebote"}),
     "Mit 'angebot' siehst Du alles was ich habe.");
  
  AI(({"herzog"}),
     "Der Herzog sitzt in seinem Palast und kommt nur sehr selten heraus.");
  
  CLONEME("/d/wueste/protheg/kraterrand/armour/fez");
  command_me("trage fez");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WAECHTER->hilferuf(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void init()
{
  ::init();

  if(interactive(TP))
    call_out("hallo", 1, TP);
}

void hallo(object pl)
{
  if((pl) && (MENV) && (present(pl, MENV)))
    tell_object(pl,
	 BS(Name()+" breitet die Arme aus und seufzt: Ah, ein Kunde!"));
}
