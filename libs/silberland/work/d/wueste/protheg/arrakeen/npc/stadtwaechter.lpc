#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Stadtwaechter");
  SetProp(P_LONG, 
	  BS("Die Stadtwaechter werden in Arrakeen gut geschult und "
	     "ausgebildet, um etwaigen Angriffen trotzen zu koennen. "
	     "Auch werden sie in den Kuensten der Magie unterwiesen."));
  SetProp(P_NAME, "Stadtwaechter");

  create_default_mensch(20, MALE);

  SetProp(P_INFO, 
	  BS("Der Stadtwaechter sieht ziemlich kraeftig aus und "
	     "ist von einer schwachen magischen Aura umhuellt."));

  AddId(({"waechter", "stadtwaechter", "\narrakeenwaechter"}));
  

  SetProp(P_ALIGN, 200);

  SUID;

  CLONEME(ARMOUR "njak");	
  CLONEME(ARMOUR "umhang");
  command_me("trage alles");

  CLONEME(WEAPON "crysschwert");
  
  SetProp(P_LOG_INFO, "protheg/arrakeen/stadtwaechter");

  AddInfo(DEFAULT_INFO, 
	  ({"ignoriert Dich einfach.\n",
	      "sagt: Lass mich in Ruhe, ich habe eine wichtige Aufgabe.\n",
	      "dreht sich einfach um und geht ein Stueck weiter.\n",
	      "blickt einfach ueber Dich hinweg.\n",
	      "schimpft: stoer mich nicht!\n"}));

  SetChats(1, ({
    "Der Stadtwaechter schaut Dich skeptisch an.\n",
      "Der Stadtwaechter mustert Dich argwoehnisch.\n",
      "Der Stadtwaechter schaut sich aufmerksam um.\n",
      "Der Stadtwaechter erschlaegt eine Fliege.\n",
      "Der Stadtwaechter lauscht angestrengt, doch nichts passiert.\n"}) );
  
  SetAttackChats(10, ({
    "Der Stadtwaechter schaut Dich boese an.\n",
      "Der Stadtwaechter lacht ueber Deinen Kampfstil.\n",
      "Der Stadtwaechter schaut Dich an und zischt: \"Verraeter!\"\n",
      "Der Stadtwaechter taeuscht Dich und steht ploetzlich ganz woanders.\n"}) );

  SetProp(P_DIE_MSG, " wirft Dir einen veraechtlichen Blick zu und stirbt.\n");
  SetProp(P_KILL_NAME, "Die Gerechtigkeit von Arrakeen");
  SetProp(P_KILL_MSG, "Tod den Verraetern!\n");
  SetProp(P_WIMPY, 0);
  
  SetProp(P_SPELLRATE, 20);

  AddSpell(5,150+random(50),
	   Name()+" wirft Dir einen boesen Blick zu.\n",
	   Name()+" schaut @WEN seltsam an.\n", 
	   DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,250+random(50),
	   Name()+" beschwoert einen Sandsturm ueber Dir.\n",
	   Name()+" beschwoert einen Sandsturm ueber @WEM.\n", 
	   ({DT_MAGIC,DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,350+random(50),
	   Name()+" jagt Dir sein Schwert rein.\n",
	   Name()+" jagt @WEM sein Schwert rein.\n", 
	   ({DT_PIERCE,DT_SLASH}), ([SP_SHOW_DAMAGE:1]));

  SetProp(P_MNPC_AREA, ROOM "ara");
  SetProp(P_MNPC_FLAGS, 
	  MOV_BACKWARDS+MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_INFIGHT);
}

int Defend(int damage, string dam_type, mixed spell, object enemy)
{
  WAECHTER->hilferuf(enemy);
  
  if((!QueryProp(P_WEAPON)) && (present("schwert")))
    command_me("zueck schwert");
  
  return ::Defend(damage, dam_type, spell, enemy);
}

void init()
{
  ::init();
  
  if((!QueryProp(P_MNPC_DEFAULTROOM)) && (MENV))
    SetProp(P_MNPC_DEFAULTROOM, file_name(MENV));
  
  if(WAECHTER->IsFeind(TP)) Kill(TP);
}

void die(int poisondeath)
{
  KILLMASTER->register_npc_death(QueryProp(P_KILLER)||TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME)
    KILLMASTER->register_player_death(player, lostexp);

  ::NotifyPlayerDeath(player, killer, lostexp);
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!=-1) 
    {
      switch(gruppe) 
	{
	case "fies":
	  call_out("react", 0, TP, 
		   "schaut Dich veraechtlich an",
                   "schaut "+TP->name(WEN)+" veraechtlich an");
	  break;
	case "lieb":
	  call_out("react", 0, TP, 
		   "schaut Dich angewiedert an",
	           "schaut "+TP->name(WEN)+" angewidert an");
	  break;
	case "aergerlich":
	  call_out("react", 0, TP, 
		   "mustert Dich streng",
	           "mustert "+TP->name(WEN)+" streng");
	  break;
	case "traurig":
	  call_out("react", 0, TP, 
		   "faehrt Dich an: Nerv mich nicht",
	           "faehrt "+TP->name(WEN)+" an: Nerv mich nicht");
	  break;
	case "intim":
	  call_out("react", 0, TP, 
		   "fluestert Dir zu: Lass das, das darf nur meine Frau",
	           "fluestert "+TP->name(WEM)+" irgendetwas zu");
	  break;
	case "aengstlich":
	  call_out("react", 0, TP, 
		   "erschreckt Dich fuerchterlich",
	           "erschreckt "+TP->name(WEN)+" fuerchterlich");
	  break;
	default:
	  call_out("react", 0, TP, 
		   "sagt: Lass mich in Ruhe, ich hab zu tun",
	           "sagt: "+TP->name()+", Lass mich in Ruhe, ich hab zu tun");
	}
    }
}

void react(object to, string victim, string others)
{
  if(present(to, MENV))
    {
      tell_object(to, BS(Name(WER, 1) + " "+victim+".\n"));
      tell_object(MENV, BS(Name(WER, 1)+" "+others+".\n"));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("schwert_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("schwert_check", 5);

  return ::StopHuntingMode(silent);
}

void schwert_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke schwert weg");
}
