#include "../def.h"
#include <npcmaster.h>

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwerg sitzt im Heissluftballon");
  SetProp(P_LONG,
	  BS("Ein staemmiger, rotbaertiger Zwerg sitzt hier im "
	     "Heissluftballon herum und ist zustaendig fuer die "
	     "Ueberfahrt von Arrakeen nach Tijara und wieder zurueck."));
  SetProp(P_NAME, "Zwerg");

  create_default_zwerg(15);

  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  AddId(({"zwerg","ballonfahrer","ballonfahrerzwerg","NOCONTROL","NOWIMPY"}));

  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden",
		       QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_BODY, QueryProp(P_BODY)+50);

  SetProp(P_XP, 0); 
  SetProp(P_NO_SCORE, 1);

  SetProp(P_ALIGN, 50);

  SetProp(P_NOATTACK, "grummelt Dich an und deutet nach unten...");

  SetProp(P_MSGIN, "betritt den Heissluftballon");
  SetProp(P_MSGOUT, "verlaesst den Heissluftballon");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, "Hnga, mao fuuu guka baah!",
	  "grummelt: ");

  AddInfo(({"bart","rotem bart","roten bart","roter bart","waguga"}),
	  "deutet auf seinen Bart und meint: Waguga.");

  AddInfo(({"flug","ballon","luftballon","heissluftballon"}),
	  "deutet auf den Ballon und murmelt die Worte \"Arrakeen\" und "
	  "\"Tijara\".");

  AddInfo(({"arrakeen","arakeen","araken","arraken","wueste","wuestenstadt"}),
	  "Hab Dugu Arrakeen. Pogo wuos waboa humlo nugu.",
	  "erzaehlt: ");

  AddInfo(({"tijara","neutijara","ostteil","dschungel","erlebnis"}),
	  "Hab Dugu Tijara. Guntu Ostteil. Pogo wuos mebel muxta rop ba "
	  "mege.",
	  "erzaehlt: ");
  
  AddInfo(({"orte","landungsorte","ort","landungsort","stadt"}),
	  "Hab Dugu Arrakeen a Hab Dugu Tijara.", "zaehlt auf: ");

  AddInfo(({"meer","ozean","moogo"}),
	  "Ah, Moogo!",
	  "schwaermt: ");

  AddInfo(({"spezialofen","ofen","kohle","kabaruf"}),
	  "deutet stolz auf den Ofen und meint: Kabaruf.");

  AddInfo(({"hab","dugu","guntu","pogo","wuos","mebel","muxta","rop",
	      "ba","mege","waboa","humlo","nugu"}),
	  "sieht Dich seltsam an.");
  
  AddInfo(({"hnga","mao","fuuu","guka","baah"}),
	  "grummelt Dich an.");
  
  SetProp(P_REJECT, ({REJECT_DROP, "Der Zwerg braucht das nicht.\n"}));

  SetChats(2, ({
    "Der Zwerg zieht an einem Seil.\n",
      "Der Zwerg huepft im Korb auf und ab.\n",
      "Der Zwerg schubst Dich auf die Seite und der Ballon haengt wieder "
      "gerade.\n",
      "Der Zwerg murmelt etwas.\n",
      "Der Zwerg wischt sich den Schweiss von der Stirn.\n",
      "Der Zwerg schaufelt etwas Kohle nach.\n"}) );

  SetGuardProtection(100, GUARD_LOCATION);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  
  switch (gruppe) 
    {
    case "albern":
      call_out("reaction", 0, TP,
	       "kichert Dich an.",
	       "kichert "+TP->Name(WEN)+" an.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "tritt Dich.",
	       "tritt "+TP->Name(WEN)+".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "zwickt Dich.",
	       "zwickt "+TP->Name(WEN)+".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "huepft grinsend um Dich herum.",
	       "huepft grinsend um "+TP->Name(WEN)+" herum.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "laeuft rot an und dreht sich weg...",
	       "laeuft rot an und dreht sich weg...");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "laechelt Dich an.",
	       "laechelt "+TP->Name(WEN)+" an.");
      break;
    case "traurig":
      if(TP->QueryProp(P_SIZE) < 150)
	call_out("reaction", 0, TP,
		 "klopft Dir aufmunternd auf die Schulter.",
		 "klopft "+TP->Name(WEM)+" aufmunternd auf die Schulter");
      else
	call_out("reaction", 0, TP,
		 "klopft Dir aufmunternd auf den Oberschenkel.",
		 "klopft "+TP->Name(WEM)+" aufmunternd auf den Oberschenkel.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

void init()
{
  object hlb;

  if(!is_clone(TO)) return;
  ::init();
  
  call_other(ROOM "hlb", "???");
  
  hlb=find_object(ROOM "hlb");
  
  if(MENV)
    if(MENV==hlb)
      return;
  
  if(present("ballonfahrerzwerg", hlb))
    {
      remove();
      return;
    }
  
  ME->move(hlb, M_NOCHECK);
}
