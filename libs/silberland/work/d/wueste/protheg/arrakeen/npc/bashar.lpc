/*
  Arrakeens Bashar
*/
#include "../def.h"

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Der Bashar von Arrakeen");
  SetProp(P_LONG,
	  BS("Der Bashar ist eine beeindruckende Erscheinung eines Menschen! "
	     "Mit beinahe zwei Metern Hoehe und einem Schulterumfang wie "
	     "ein durchschnittlicher Schrank steht er Dir gegenuebersteht "
	     "und Dich grimmig beaeugt."));
  SetProp(P_NAME, "Bashar");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));

  AddId(({"bashar","NOWIMPY"}));

  create_default_mensch(35, MALE);
  SetProp(P_HANDS, ({" mit seinen starken Haenden",QueryProp(P_HANDS)[1]+150,
		       ({DT_RIP,DT_TERROR})}));

  SetProp(P_BODY, QueryProp(P_BODY)*3/2);

  SetProp(P_XP, QueryProp(P_XP)+500*1000); // Bonus fuer Spells

  SetProp(P_SIZE, 199);
  SetProp(P_ALIGN, -50);

  AddProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING:-0.1, DT_EXPLOSION: 0.0, DT_SOUND: -0.3, DT_TERROR:-0.6,
      DT_HOLY:     -0.4, DT_UNHOLY:   -0.3, DT_MAGIC: -0.1 ]) );
  
  SetProp(P_NOMAGIC, 30);

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  
	  " laesst alles liegen, schreit 'MAMIIII' und rennt davon.\n");

  SetProp(P_NOCORPSE, 1);
  
  AddInfo(DEFAULT_INFO, ({"grummelt Dich an.\n",
			    "sagt: Verschwinde!\n",
			    "grummelt: Hau Ab!\n",
			    "schimpft: Du bist ja immer noch da!\n"}));
  
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_REJECT, ({REJECT_DESTRUCT, 
	  "Der Bashar zerstoert Dein Zeug nach Berserkerart..\n"}));

  // I am the Berserker
  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 10);
  
  call_other("/gilden/berserker", "learn_berserker_skills",10000, 10000 );

  ModifySkill("eisenhaut",    10000);
  ModifySkill("eisenhaut",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );         
  ModifySkill("rammen",       10000);
  ModifySkill("rammen",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("willenskraft", 10000);
  ModifySkill("willenskraft", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("zertreten",    10000);
  ModifySkill("zertreten",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("kopfstoss",    10000);
  ModifySkill("kopfstoss",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );

  SetProp(P_SPELLRATE, 60);

  AddSpell(3,1,
           "","", DT_BLUDGEON, "bspells");

  AddSpell(2,500,
           "Der Bashar laesst einen gewaltigen Kampfschrei los, der Dich umhaut.\n",
           "Der Bashar laesst einen gewaltigen Kampfschrei los, der @WEN umhaut.\n",
           DT_SOUND,([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 400,
	   "Der Bashar tritt Dir mit voller Wucht gegen Dein Knie!\n",
	   "Der Bashar tritt mit voller Wucht gegen @WESSEN Knie!\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 250,
	   "Der Bashar versucht Dich mit dem stumpfen Axtende umzustossen.\n",
	   "Der Bashar rammt @WEM das stumpfe Axtende hinein.\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(1, 1, DS_ANTIMAGIC,
	  "Der Bashar verwirrt Dich mit seiner herumfuchtelnden Axt.\n",
	  "Der Bashar verwirrt @WEN mit seiner herumfuchtelnden Axt.\n");
  
  SetChats(3, ({
    "Ein Stadtwaechter kommt herein.\n"
      "Der Stadtwaechter fluestert dem Bashar etwas zu.\n"
      "Der Bashar bruellt den Stadtwaechter nieder.\n"
      "Der Stadtwaechter geht nach westunten,\n",
      "Der Bashar grummelt: Hau ab!\n",
      "Der Bashar blickt Dich veraechtlich an.\n",
      "Der Bashar sagt: Verschwinde, oder ich lasse Dich einsperren!\n"}));
  SetAttackChats(10, ({
    "Der Bashar bruellt Dich an.\n",
      "Der Bashar tritt Dich.\n",
      "Der Bashar wirft sich auf Dich.\n",
      "Der Bashar springt um Dich herum.\n",
      "Der Bashar tritt Dir in die Kniekehle.\n"}));
  
  SUID;
  CLONEME("/p/weapon/axe/streitaxt");
  
  CLONEME("/gilden/berserker/obj/stirnband");
  CLONEME("/p/armour/bracers/mithrilarmschienen");
  CLONEME("/p/armour/helm/topfhelm");
  CLONEME("/p/armour/trousers/lendenschurz");
  command("trage alles");

  //WAECHTER->add_wache();
}

void rauswerfen(object whom)
{
  if((objectp(whom)) && (present(whom, MENV)))
    {
      tell_object(whom, 
		  "Der Bashar bruellt: RAUS mit "+whom->QueryPronoun(WEM)+
		  "!!\n"
		  "Zwei Stadtwaechter stuermen daraufhin hinein und draengen "
		  "Dich hinaus...\n");
      tell_room(MENV, 
		BS("Der Bashar laesst "+whom->Name(WEN)+" rauswerfen..."));
      whom->move(ROOM "ara_5_5_0", M_GO|M_SILENT);
    }
}

void init()
{
  ::init();

  if((WAECHTER->IsFeind(TP)) && (!IsEnemy(TP)))
    call_out("rauswerfen", 1, TP);
}

int Defend(int dam, string dtype, int spell, object enemy)
{
  WAECHTER->hilferuf(enemy);

  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) 
    command_me("eisenhaut");

  return ::Defend(dam, dtype,spell, enemy);
}

void bspells(object enemy,int damage, mixed dam_type)
{
  if(!present("\nberserker_willenskraft",ME)) 
    {
      command_me("willenskraft");
      return;
    }

  switch(100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE)) 
    {
    case  0.. 30: command_me("zertreten"); break;
    case 81..300: if (random(2)) 
      command_me("rammen");
    else
      command_me("kopfstoss");
    break;
    default: command_me("rammen"); break;
    }
  return;
}

void die(int poisondeath) 
{
  //WAECHTER->remove_wache(this_object());
  KILLMASTER->register_npc_death(PL);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    KILLMASTER->register_player_death(PL);
  
  ::NotifyPlayerDeath(player, killer, lostexp);
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

