/*
**  Tanjal Burrld, der Schmied aus Arrakeen
**  
**  2003-Dez-04  PROtheG  angelegt
*/

#include "../def.h"
#include ROOM "pfand.h"

inherit "std/repair";

nosave int last;

varargs void AI(string *x, string y, string z)
{
  if(strlen(z))
    AddInfo(x, y, z);
  else 
    AddInfo(x, y, "schreit: ");
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Schmied Tanjal Burrld legt Kohle nach");
  SetProp(P_LONG,
	  BS("Tanjal Burrld ist ein uralter Zwergenschmied, der nach seinem "
	     "Aussehen betrachtet, diesen Beruf schon seit sehr langer Zeit "
	     "nachgeht. In seinen starken Armen haelt er meisst seinen"
	     "gewaltigen Schmiedehammer, um damit am Amboss eine Waffe zu "
	     "schmieden. Da hier der Schmiedeofen stark einheizt, traegt "
	     "Tanjal nur einen Lendenschurz und ein feuerabweisendes "
	     "Asbesthemd."));
  
  SetProp(P_INFO, BS("Tanjal Burrld scheint beinahe taub zu sein!"));
  SetProp(P_NAME, 
	  ({"Tanjal Burrld","Tanjal Burrld","Tanjal Burrld","Tanjal Burrld"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:70]));
  AddId(({"tanjal", "tanjal burrld", "burld", "schmied","zwerg","NOWIMPY",
	    "NOCONTROL","SKILL_NOLEARN","zwergenschmied"}));
  set_living_name("tanjal");
  
  create_default_npc(30);
  
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
		QueryProp(P_HANDS)[1]+150,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 132);
  SetProp(P_WEIGHT, 81000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:  -0.7, DT_COLD:   -0.2, DT_WATER:   0.2, 
	    DT_SOUND: -0.3, DT_POISON: -0.2, DT_TERROR: -0.2,
	    DT_MAGIC: -0.5, DT_MIND:   -0.2, DT_AIR:    -0.2]));
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 20);
  
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DIE_MSG,  " bricht tot zusammen.\n");
  SetProp(P_KILL_MSG, "Jederzeit wieder!");
  
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_NOATTACK, "schreit: NEIN! GEH WEG! ICH HAB ZU TUN!");
  
  AddInfo(DEFAULT_INFO, 
  ({"nickt stirnrunzelnd.\n",
      "schreit: GEH UND NERV WEN ANDEREN!\n",
      "kratzt sich gruebelnd am Kopf.\n",
      "gruebelt und blickt schief.\n",
      "schreit: HAE?\n",
      "wird spaeter darueber nachdenken.\n",
      "deutet auf seine Ohren und schreit: ICH HOERE NICHT MEHR SO GUT!\n",
      "murmelt irgendwas in seinen Bart.\n"}));
  
  SetProp(P_DEAF, -1);
  
  AI(({"waffe","waffen","metallwaffe","metallwaffen"}),
     "WAS? AFFEN? NEIN! ICH REPARIERE NUR WAFFEN!");
  
  AI(({"metall"}),
     "METALL? JAJA! METALL! ICH KANN ALLES AUS METALL REPARIEREN!");
  
  AI(({"banjal","tanjal"}),
     "JA! ICH HEISSE TANJAL!");
  
  AI(({"schmied","lied"}),
     "LIED? NEIN! ICH WERDE DIR KEIN LIED SINGEN! ICH BIN NAEMLICH EIN "
     "SCHMIED!");
  
  AI(({"ofen","schmiedeofen"}),
     "HAUFEN? JAJA! DER GROSSE KOHLEHAUFEN HIER IST FUER DIE GLUT!");
  
  AI(({"haufen","kohlehaufen"}),
     "OFEN? JAJA! IM SCHMIEDEOFEN WIRD DAS METALL GEKOCHT!");
  
  AI(({"geld"}),
     "GELB? NEIN! MEIN BART IST ROT! SIEH DOCH!");
  
  AI(({"bart"}),
     "HART? JAJA! DAS LEBEN IST HART!");
  
  AI(({"leber","leben"}),
     "IGITT! LEBER!");
  
  AI(({"blut","glut"}),
     "BLUT? NEIN! HIER WIRD NICHT GEKAEMPFT! ICH HABE ZU TUN!");
  
  AI(({"reparieren","repariere"}),
     "WAS FUER VIREN? STECK MICH BLOSS NICHT AN!");
  
  AI(({"uhr","reparatur"}),
     "UHR? NEIN ICH HABE KEINE UHR! ICH REPARIERE WAFFEN AUS METALL! "
     "MIT 'repariere <waffe>'!");
  
  SetProp(P_LOG_INFO, "protheg/arrakeen/tanjal");
  
  SetProp(P_REJECT, ({REJECT_DROP,
     "Tanjal Burrld schreit: WILLST DU ETWAS REPARIEREN LASSEN?\n"}));
  
  SetChats(3, ({
    "Tanjal kratzt sich am Kopf.\n",
      "Tanjal legt etwas Kohle nach.\n",
      "Tanjal reinigt sein Werkzeug.\n",
      "Tanjal facht das Feuer weiter an.\n",
      "Tanjal saeubert den Amboss.\n",
      "Tanjal bearbeitet mit dem Hammer ein Stueck Metall.\n"}));

  SUID;
  CLONEME("/p/weapon/club/schmiedehammer");
  command("zuecke hammer");
  CLONEME("/p/armour/trousers/lendenschurz");
  CLONEME(ARMOUR "asbesthemd");
  command("trage alles");
}

string short()
{
  if(last+30 < time())
    {
      SetProp(P_SHORT, "Schmied Tanjal Burrld "+({
	"legt Kohle nach",
	  "facht das Feuer weiter an",
	  "schlaegt mit dem Hammer auf gluehendes Metall ein",
	  "saeubert den Amboss",
	  "reinigt sein Werkzeug"})[random(5)]);

      last=time();
    }

  return ::short();
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe) 
    {
    case "froh":
    case "nett":
    case "albern":
      call_out("reaction", 0, TP,
	       "grinst Dich an.",
	       "grinst.");
      break;
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
	       "knufft Dich mit seinem Ellenbogen.",
	       "knufft "+TP->name(WEN)+" mit seinem Ellenbogen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "blickt Dich traurig an.", 
	       "blickt "+TP->name(WEN)+" traurig an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "erroetet und schreit: LASS DAS!",
	       "erroetet und schreit: LASS DAS!");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "meint: Lass mich arbeiten!",
	       "meint: Lass mich arbeiten!");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

int rep_auswahl(object ob)
{ 
  if(ob->QueryMaterialGroup(MATGROUP_METAL)&&
     ob->QueryProp(P_WEAPON_TYPE))
    return 1;
  
  write(BS("Tanjal schreit: ICH KANN NUR WAFFEN AUS METALL REPARIEREN!"));
  return 0;
}

_query_deaf()
{
  return -1;
}
