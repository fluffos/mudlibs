#include "../def.h"

#define WASSERSPERRE LOG "wassersperre"

nosave int offen; // ist das Gartentor offen oder zu?
nosave string *banned; // wer hat temporaer keinen Zutritt mehr?

void create()
{
  if(is_clone(ME)) return destruct();

  SUID;

  restore_object(WASSERSPERRE);

  offen=1;
}

void reset()
{
  offen = 1;
}

int opened()
{
  return offen;
}

void schliessen()
{
  offen = 0;
}

void aussperren(object spieler)
{
  if(member_array(getuid(spieler), banned)!=-1) return;
    
  banned+=({getuid(spieler)});

  save_object(WASSERSPERRE);
}

/*
Kommentar zu den Funktionen aussperren() und wieder_reinlassen():
Sobald die Tempelanlage angeschlossen ist (spaeter), wird jeder Spieler, der
sich am Gaertner (Herzog, etc) vergreift, temporaer aus dem Palast 
ausgessperrt. Dann muss er zum Tempel gehen und beichten, worauf er wieder
reingelassen wird. Er bekommt dann beim Rausschmiss durch den Gaertner oder
eine Wache den Rat, beichten zu gehen.
Wenns mal funktioniert. Ist aber zZ auch nicht wichtig. 1.2.98, Muaddib
*/

void wieder_reinlassen(object spieler)
{
  if(member_array(banned, getuid(spieler))==-1) return;

  banned-=({getuid(spieler)});
  
  save_object(WASSERSPERRE);
}

void oeffnen()
{
  offen=1;
}




