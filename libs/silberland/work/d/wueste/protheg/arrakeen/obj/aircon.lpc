/*
** Eine 'Klimaanlage' fuer Seherhaeuser, so verpackt, dass auch Arthoas
** damit zufrieden ist.
**
** by Muaddib@Silberland
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"klimaanlage", "kuehlung", "truhe"}) );
  SetProp(P_SHORT, "Eine geheimnisvolle Truhe");
  SetProp(P_LONG, BS("Als Du die Truhe naeher betrachtest, stellst Du fest, "+
		     "dass in ihr ein Zwerg in einem Laufrad rennt. Am Lauf"+
		     "rad ist mit einer Stange ein Bueschel Palmenwedel "+
		     "verbunden, die Dir bei jeder Umdrehung frische Luft "+
		     "zufaechern. Dadurch wird es angenehm kuehl.\n"));
  
}
