/*
**
** Scheide fuer das Crys-Schwert, das
** Schwert loest sich auf, wenn es nicht
** in die Scheide gesteck wird
**
** 26.9.1997 Muaddib@Silberland
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;

  ::create();
  SetProp(P_SHORT, "Eine Scheide");
  SetProp(P_LONG, BS("Das ist eine schoen gearbeitete Scheide aus wertvollem "+
		     "Leder.\n"));
  SetProp(P_INFO, BS("Auf der Seite steht: Nur hier sind die Zaehne haltbar."+
		     "\n"));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Scheide");
  AddId( ({"scheide", "schwerthuelle"}) );
  
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  //SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}










