#include "../def.h"

inherit "std/armour";

void DefineType()
{
  switch(random(100))
    {
    case 33 .. 65:
      SetProp(P_SHORT, "Ein grosser Njakschutz");
      SetProp(P_LONG, 
	      BS("Ein von Sandstuermen gegerbter, grosser Njakschutz aus "
		 "sehr widerstandsfaehigem Sandwurmleder. Er scheint fuer sehr "
		 "grosse Lebewesen gemacht worden zu sein.\n"));
      SetProp(P_NAME_ADJ, "gross");
      SetProp(P_WEIGHT, 1200);
      SetProp(P_AC, 32);
      SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE:190]));
      break;
    case 66 .. 99:
      SetProp(P_SHORT, "Ein kleiner Njakschutz");
      SetProp(P_LONG, 
	      BS("Ein von Sandstuermen gegerbter, kleiner Njakschutz aus "
		 "widerstandsfaehigem Sandwurmleder. Er scheint fuer sehr "
		 "kleine Lebewesen gemacht worden zu sein.\n"));
      SetProp(P_NAME_ADJ, "klein");
      SetProp(P_WEIGHT, 700);
      SetProp(P_AC, 28);
      SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:140]));
      break;
    default:
      SetProp(P_SHORT, "Ein Njakschutz");
      SetProp(P_LONG, 
	      BS("Ein von Sandstuermen gegerbter, mittelgrosser Njakschutz aus "
		 "widerstandsfaehigem Sandwurmleder. Er scheint fuer mittelgrosse "
		 "Lebewesen gemacht worden zu sein.\n"));
      SetProp(P_WEIGHT, 900);
      SetProp(P_AC, 30);
      SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:190,P_SIZE:140]));
    }
}

void create()
{
  if(!is_clone(TO)) return;
  ::create();
 
  AddId(({"njakschutz", "schutz", "njak"}));
  
  DefineType();
  
  SetProp(P_INFO, 
	  BS("Der Njakschutz scheint eine sehr stabile Ruestung zu sein. Nur "
	     "Feuer scheint ihm etwas auszumachen."));
  SetProp(P_NAME, "Njakschutz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, ([MAT_LEATHER:70, MAT_IRON:30]));
  SetProp(P_VALUE, 1200+random(300));
  SetProp(P_QUALITY_DECAY, ([DT_FIRE:5, DT_ACID:200, 0:100]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_ACID:1]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:3, T_COLD_PROT:1]));
}
