inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"


create()
{
  string col;

  if(!is_clone(TO)) return;
  ::create();
 
  col=({"hell","","dunkel"})[random(3)]+
    ({"rot","gruen","gelb","blau","tuerkis","violett","orangen","braun",
	"sandfarben","grau"})[random(10)];
  AddId(({"kaftan","umhang"}));
  SetProp(P_SHORT, "Ein "+col+"er Kaftan");
  SetProp(P_LONG,
	  BS("Der "+col+"e Kaftan ist ein ganz besonderer Umhang, der nur fuer "+
	     "wichtige Leute gefertigt wird.\n"));
  SetProp(P_INFO, "Er scheint vor Hitze zu schuetzen.\n");
  SetProp(P_NAME, "Kaftan");
  SetProp(P_NAME_ADJ, col);
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_SILK:100])); 
  SetProp(P_WEIGHT, 400); 
  SetProp(P_VALUE, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT: 10, T_COLD_PROT:1]));
}





