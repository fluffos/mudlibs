inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Gurtafi");
  SetProp(P_LONG, 
	  BS("Ein hervorragend gearbeiteter Gurtafi aus Schlangenhaut. "+
	     "Er glitzert in einem seltsamen blaugruen.\n"));
  AddId(({"gurtafi","anzug"}));
  SetProp(P_NAME, "Gurtafi");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO,
	  BS("Ein Gurtafi ist ein ziemlich guter, jedoch billiger Schutz. "+
	     "Einfache Buerger kleiden sich oft damit, da er ein guter "+
	     "Hitzeschutz ist.\n"));
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 333);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 18);
  SetProp(P_MATERIAL, ([MAT_SKIN:95,MAT_MISC_DEAD:5]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:5, T_COLD_PROT:2]));
  AddDetail(({"haut","schlangenhaut","muster"}),
	    "Die verarbeitete Schlangenhaut bildet ein wunderschoenes Muster.\n");
}


