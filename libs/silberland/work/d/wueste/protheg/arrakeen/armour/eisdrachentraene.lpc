/*
**
** Magischer Ring, der einen negativen Temperaturoffset hat
** gefaehrlich halt in kuehlen Gegenden, aber *zuck* ich schreibs in
** die ID :)
**
** by Muaddib@SL
**
** 2001-03-23 PROtheG  Zu einer Drachentraene umfunktioniert...
**
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

nosave int festgefroren;

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Eine Eisdrachentraene");
  SetProp(P_LONG, 
	  BS("Eine makellose runde Traene eines Eisdrachen. In ihre Mitte "
	     "wurde ein Loch gebohrt, so dass man sie als Ring, oder an "
	     "einer Kette um den Hals tragen kann."));
  SetProp(P_INFO, 
	  BS("Diese Traene stroemt eine eisige Kaelte aus..."));
  SetProp(P_NAME, "Eisdrachentraene");
  SetProp(P_GENDER, FEMALE);

  AddId(({"traene","drachentraene","eisdrachentraene","ring"}));

  AddDetail(({"mitte","traenenmitte"}),
	    "Die Mitte der Traene wurde durchbohrt, dass man sie als "
	    "Ring tragen kann.");
  AddDetail(({"kette","hals"}),
	    "Man kann die Eisdrachentraene auch an einer Kette um den "
	    "Hals tragen.");
  AddDetail(({"loch"}),
	    "Das Loch wurde scheinbar sehr vorsichtig gebohrt, denn Du "
	    "kannst keine Abschuerfungen oder sonstige Kratzer an der "
	    "Traene erkennen.");
  AddDetail(({"abschuerfung","abschuerfungen","kratzer"}),
	    "Du kannst keine erkennen.");

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 2);

  SetProp(P_MATERIAL, ([MAT_ICE:90,MAT_MAGIC:10]));

  SetProp(P_MAGIC, 1);
  SetProp(P_WEIGHT, 169);
  SetProp(P_VALUE, 999);
  SetProp(P_NOBUY, 1);

  SetProp(P_WORN_TEXT, "angesteckt");
  SetProp(P_WEAR_TEXT,
	  ({"Du steckst Dir die Eisdrachentraene an den Finger.\nEine eisige "
	      "Kaelte ueberkommt Dich.\n",
	      " steckt sich eine Eisdrachentraene an den Finger.\n"}));
  SetProp(P_UNWEAR_TEXT,
	  ({"Du streifst Dir die Eisdrachentraene wieder vom Finger.\n",
	      " streift sich eine Eisdrachentraene vom Finger.\n"}));
  SetProp(P_WEAR_FUNC, ME);
  SetProp(P_REMOVE_FUNC, ME);

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:-15, T_HEAT_PROT:8 ]) );
}

int WearFunc(object ruest,int silent)
{
  festgefroren=time()+10800+random(100);  //bissi mehr als 3 minuten
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  if(time()<festgefroren) 
    return write(BS("Die Drachentraene ist an Deinem Finger festgefroren. "
		    "Du musst noch etwas warten, bis sie sich an Deine "
		    "Koerpertemperatur angepasst hat und Du sie wieder "
		    "abnehmen kannst.")),0;
  else return 1;
}
