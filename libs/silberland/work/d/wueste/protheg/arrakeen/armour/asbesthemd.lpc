#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Asbesthemd");
  SetProp(P_LONG,
	  BS("Dieses Hemd besitzt lange Aermel, einen V-Kragen und ist "
	     "mit einer dicken Schicht Asbest ueberzogen, die den "
	     "Traeger vor Feuer schuetzen soll. Es Das Hemd wird "
	     "dadurch jedoch recht steif und schwer."));

  SetProp(P_NAME, "Asbesthemd");
  SetProp(P_GENDER, NEUTER);
  AddId(({"asbesthemd", "hemd"}));

  SetProp(P_MATERIAL, MAT_ASBESTOS);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 350);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 25);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE:1000, 0:70]));
  
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:2]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:10]));
  
  SetProp(P_INFO, 
	  BS("Das Asbesthemd schuetzt recht gut vor Feuer."));
}
