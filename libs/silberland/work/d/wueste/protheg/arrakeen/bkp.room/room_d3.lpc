#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Die Hauptstrasse");
  SetProp (P_INT_LONG,
    "Du stehst auf der Hauptstrasse von Arrakeen. Vom geschaeftigen "+
    "Treiben der Stadt ist hier nichts mehr zu bemerken. Westlich von Dir "+
    "ragt das Westtor aus dem Boden, riesig und bedrohlich. Weiter im "+
    "Osten ist der herzoegliche Palast von Arrakeen zu sehen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt", 
                "wueste"}),
    "Arrakeen ist die Hauptstadt der Wueste und Du stehst auf der "+
    "Hauptstrasse dieser Stadt.");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse in Arrakeen verbindet den Herzogenpalast mit dem "+
    "Westtor.");
  AddDetail ( ({"herzogenpalast", "palast", "regierungssitz"}),
    "Der Palast von Arrakeen ist der Regierungssitz des Herzogs der "+
    "Wueste. Es gibt einige Geruechte ueber versteckte Fallen und dunkle "+
    "Verliese im Palast.");
  AddDetail ( ({"falle", "fallen", "geruechte", 
                "verlies", "verliese"}),
    "Man hoert halt solche Geruechte. Ob da was wahres dran ist, kann man "+
    "schlecht beurteilen.");
  AddDetail ( ({"herzog", "mann"}),
    "Der Herzog soll angeblich ein sehr gerechter und weiser Mann sein.");
  AddDetail ( ({"tor", "westtor", "schutz"}),
    "Das Tor dient dem Schutz der Stadt.");
  AddDetail ( ({"boden"}),
    "#Der Boden ist hier wohl die Hauptstrasse von Arrakeen.");
  AddDetail ( ({"treiben"}),
    "Das Treiben findet wohl eher weiter im Osten statt.");
  AddDetail ( ({"osten"}),
    "Das ist wohl nicht weiter wichtig.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./room_d4");
  AddExit ("westen", "./room_d2");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
