#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst in einer Gasse in Arrakeen. Aus dem Norden kannst Du "+
    "Stimmen hoeren, die auf florierenden Handel schliessen lassen. In "+
    "Richtung Sueden wird es allerdings sehr ruhig, fast schon "+
    "totenstill. Man hat Dich ja gewarnt, was den suedlichen Teil der "+
    "Stadt angeht. Aber wenn Du das Risiko unbedingt auf Dich nehmen "+
    "willst...Links neben Dir steht ein Schild.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"schild"}),
    "Das Schild ist unscheinbar und schwarz. Das einzig auffaellige daran "+
    "ist der rote Falke, der oberhalb der Schrift auf das Schild gemalt "+
    "wurde.");
  AddDetail ( ({"falke"}),
    "Ein roter Falke auf schwarzem Grund...Du ueberlegst lange, doch dann "+
    "faellt Dir ein, wo Du ihn schon mal gesehen hast: Das ist das Wappen "+
    "der herzoeglichen Streitkraefte. Du solltest die Schrift lesen.");
  AddDetail ( ({"arrakeen"}),
    "Arrakeen ist die Hauptstadt der Wueste. Weiterhin ist es die Stadt, "+
    "in der Du Dich momentan befindest.");
  AddDetail ( ({"gasse"}),
    "Naja, eine Gasse halt, schmal und auch sonst ganz gewoehnlich.");
  AddDetail ( ({"handel"}),
    "Handel wird wohl auf dem Marktplatz getrieben, der weiter noerdlich "+
    "ist.");
  AddDetail ( ({"marktplatz"}),
    "Der Marktplatz befindet sich im Norden.");
  AddDetail ( ({"stimmen"}),
    "Laute Stimmen toenen vom nahen Marktplatz herueber.");
  AddDetail ( ({"hauptstadt"}),
    "Arrakeen ist die Hauptstadt. Von der Wueste jedenfalls.");
  AddDetail ( ({"stadt", "wueste", "wuestenregion"}),
    "Arrakeen ist die einzige kartographierte Stadt in der Wuestenregion. "+
    "Ueber andere hoert man allenfalls Geruechte.");
  AddDetail ( ({"geruecht", "geruechte"}),
    "Ja, derer gibt es viele in dieser Stadt.");
  AddDetail ( ({"risiko"}),
    "Bist Du bereit, das Risiko auf Dich zu nehmen, in diesen Teil der "+
    "Stadt einzudringen?");
  AddDetail ( ({"teil"}),
    "Ueber diesen Teil hoert man nur ueble Geruechte.");
  AddDetail ( ({"schrift"}),
    "Vielleicht kannst Du sie lesen?");
  AddReadDetail ( ({"schild", "schrift"}),
    "Zum Rekrutierungsbuero ->");
  AddDetail ( ({"streitkraefte"}),
    "Dis Streitkraefte des Herzogs haben einen exzellenten Ruf. Vielleicht "+
    "kannst Du den Streitkraeften beitreten.");
  AddDetail ( ({"herzog"}),
    "Der Herzog der Wuestenregion regiert ueber diese Stadt und die "+
    "Wueste.");
  AddDetail ( ({"ruf"}),
    "Der Ruf der herzoeglichen Streitkraefte ist hervorragend.");
  AddDetail ( ({"wappen"}),
    "Das Wappen steht fuer die herzoeglichen Streitkraefte.");
  AddDetail ( ({"grund"}),
    "Das ist doch nicht so wichtig, oder?");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./room_d5");
  AddExit ("sueden", "./room_f5");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
