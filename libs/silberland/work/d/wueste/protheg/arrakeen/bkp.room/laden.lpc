/*
**
** Laden in Arrakeen
**
** by Muaddib@SL
**
*/

inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "../def.h"


#define LAGER "d/wueste/muaddib/arrakeen/room/lagerraum"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:25]));
  SetProp (P_INT_LONG, BS(
  "Du stehst in einem sehr gut gekuehlten Laden mitten in Arrakeen. An den "+
  "Waenden sind lauter Regale angebracht, auf denen unterschiedliche Dinge "+
  "lagern. Im hinteren Teil des Ladens fuehrt eine Treppe nach oben.\n"));
  SetProp (P_INT_SHORT,"In einem Laden in Arrakeen");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER); 
  SetProp(P_SHOPKEEPER_NAME, "der Haendler");

  AddDetail("laden", "Es ist wirklich erstaunlich kuehl hier.\n");
  AddDetail("arrakeen", "Da brauchst Du nur mal rauszugehen...\n");
  AddDetail( ({"regal","regale", "dinge"}), "Die Regale sind mit den "+
  "unterschiedlichsten Dingen gefuellt.\n");
  AddDetail( ({"wand","waende"}), "An der Wand gegenueber der Tuer haengt "+
  "eine Tafel.\n");
  AddDetail("tuer", "Die Tuer, durch die Du gekommen bist.\n");
  AddDetail( ({"tafel","schild"}), "Du kannst sie lesen.\n");
  AddDetail("teil", "Das ist nicht so wichtig.\n");
  AddDetail("treppe", "An der Treppe haengt ein kleines Schild.\n");

  AddReadDetail("schild", "Wuestensturm: oben\n");
  AddReadDetail("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom (LAGER);

  AddExit ("sueden","./room_c3");
  AddExit ("oben","./kneipe");


}









