#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include "../def.h"

#define DEPUTY "muaddib"

inherit "std/room";

nosave int allowed=1;
nosave string *mitarbeiter;


void create()
{
  int i;
  string *tmp;
  
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Regionskontrollzentrum Wueste");
  SetProp (P_INT_LONG,
    "Du stehst im Regionskontrollzentrum der Wueste. Du brauchst hier "+
    "keine Details zu untersuchen, denn dieser Raum wird nie fuer die "+
    "Oeffentlichkeit geoeffnet werden. Nur R+ und Mitarbeiter der Wueste "+
    "duerfen hier herein. Wichtig ist auch nur das Brett, an dem wichtige "+
    "Spezifika der Region beschrieben werden. Und zwar nur fuer Magier "+
    "relevante Themen.");
  // ROOM DESCRIPTION END
  
  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("stadt", "nach Arrakeen#/d/wueste/muaddib/arrakeen/room/room_d5.lpc");
  // EXITS END

  // ITEMS START
  AddItem("/d/wueste/muaddib/wuestenbrett.lpc", REFRESH_DESTRUCT);
  AddItem("/d/wueste/muaddib/arrakeen/obj/zettelmaschine.lpc", REFRESH_REMOVE);
  // ITEMS END

  mitarbeiter=({});
  mitarbeiter += ({"feyaria", "angrox", "eros", "dusty", "woody"});
  tmp=get_dir("/d/wueste/*");
  for (i=sizeof(tmp)-1; i; i--)
    if (file_size("/d/wueste/"+tmp[i])==-2 && tmp[i][0]!='.')
      mitarbeiter+=({ tmp[i] });
  AddCmd("lock", "lock");
  AddCmd("unlock", "unlock");
  AddCmd("q", "q");
}

void init()
{
  object pl;
  string* home;

  ::init();
   if (this_interactive() || previous_object())
    if (member(mitarbeiter, getuid(this_player()))==-1)
      if (!allowed) {
          tell_object(this_player(), "Du kannst die Wuestler zZ nicht"+
		      "stoeren.\n");
          this_player()->move(TP->QueryProp(P_LAST_COMMAND_ENV), 
			      M_GO|M_SILENT|M_NO_SHOW);
          if ((pl=find_player(DEPUTY)))
            tell_object(pl, capitalize(getuid(this_player()))+
			" wollte Dich im RKZ stoeren.\n");
        }
      else
        if ((pl=find_player(DEPUTY)))
          if (!present(pl))
            tell_object(pl, capitalize(getuid(this_player()))+
			" versuchte, das RKZ zu betreten.\n");
}

int lock()
{
  if (getuid(this_player())=="muaddib" || getuid(this_player())=="creative") {
    allowed=0;
    write("Locked.\n");
    return 1;
  }
  return 0;
}

int unlock()
{
  if (getuid(this_player())=="muaddib" || getuid(this_player())=="creative") {
    allowed=1;
    write("Unlocked.\n");
    return 1;
  }
  return 0;
}

int q()
{
  if (getuid(this_player())=="muaddib" || getuid(this_player())=="creative") {
    write("RKZ is "+(allowed?"open":"locked")+".\n");
    return 1;
  }
  return 0;
}

void SetAllowedFromOutSide(int value)
{
  if (!(geteuid(PO)=="muaddib"||(ENV(PO)&&geteuid(ENV(PO))=="muaddib")))
    return;
  allowed=value;
}

