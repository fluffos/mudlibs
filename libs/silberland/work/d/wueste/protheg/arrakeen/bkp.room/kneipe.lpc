/*
**
** Kneipe 'Wuestensturm'
**
** by Muaddib@Silberland
**
*/

inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
#include <pub.h>

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:30]));
  SetProp (P_INT_SHORT, "Kneipe 'Wuesten-Sturm'");
  SetProp (P_INT_LONG, BS(
  "Du stehst in einer kleinen, relativ kuehlen Kneipe, die einem alten, "+
  "gemuetlichen Mann gehoeren zu scheint. Der Tresen ist blitzblank "+
  "geputzt und davor stehen zwei kleine Tische. Der Besitzer steht hinter "+
  "dem Tresen und ist staendig damit beschaeftigt, alles schoen sauber zu "+
  "halten. Sonnenlicht durchflutet den Raum und gibt der Atmosphaere eine "+
  "gemuetliche Note.\n"));
  SetProp (P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp (P_PUBKEEPER_ID, "wirt" );
  SetProp (P_PUBKEEPER_NAME, "der Wirt" );
  SetProp (P_PUBKEEPER_GENDER, MALE );
  AddDetail("kneipe", BS("Du befindest Dich in der einzigen Kneipe hier in "+
  "der Wueste.\n"));
  AddDetail( ({"mann","wirt","besitzer"}), BS("Der Besitzer der Kneipe "+
  "macht einen gemuetlichen Eindruck.\n"));
  AddDetail( ({"eindruck"}), "Das ist doch nicht so wichtig.\n");
  AddDetail("wueste", BS("Ist Dein Hirn schon so trocken, dass Du nicht mehr "+
  "weisst, wo Du bist?\n"));
  AddDetail("hirn", "Du kannst es nicht mehr fuehlen. Scheint trocken zu "+
  "sein.\n");
  AddDetail("note", "Es ist wirklich gemuetlich hier.\n");
  AddDetail( ({"tisch","tische"}), "Das sind kleine Tische.\n");
  AddDetail("tresen", BS("Der Tresen ist sehr sauber geputzt. Von Staub ist "+
  "hier nichts zu sehen.\n"));
  AddDetail("staub", "Definitiv kein Staub zu sehen.\n");
  AddDetail( ({"sonnenlicht", "atmosphaere"}), BS("Das Sonnenlicht sorgt "+
	 "fuer eine angenehme Atmosphaere im Raum.\n"));
  AddDetail("raum", "Na, welcher Raum ist wohl gemeint, hm?\n");
  AddDetail("boden", "Der ist nicht so besonders hier.\n");
  AddDetail("decke", "Eine einfache, hoelzern getaefelte Decke.\n");
  AddDetail( ({"wand","waende"}), BS("An einer Wand haengt ein Schild, "+
   "das Du mit <menue> lesen kannst.\n"));
  AddDetail("schild", "Du kannst es mit <menue> lesen.\n");

  AddDrink("Tafelwasser", ({"tafelwasser","wasser"}), 20, 1, 0, 1,
  ({"Der Wirt bringt Dir ein Glas frisches Tafelwasser. Es schmeckt "
      "herrlich erfrischend.\n", 
      "&& erfrischt sich mit einem Glas Tafelwasser.\n"}));
  
  AddDrink("Spice-Wein", ({"spicewein", "wein"}), 100, 20, 5, 3,
  ({"Der Wirt bringt Dir ein Glas voll mit einer seltsam gefaerbten "
      "Fluessigkeit, die extrem nach Zimt riecht. Du trinkst das Glas in "
      "einem Zug aus und spuerst ein komisches Ziehen im Hals.\n",
      "&& bekommt ein Glas mit einer uebel riechenden Fluessigkeit und "
      "trinkt es auf einmal aus.\n"}));
  
  AddDrink("Kaffee", "kaffee", 25, 5, 0, 2, 
	   ({"Der Wirt bringt Dir einen Kaffee, den Du genuesslich trinkst.\n"+
	       "Uffz, ist der stark...\n", "&& bekommt einen Kaffee und "+
	       "trinkt ihn aus.\n"}));

  AddDrink("Kaktussaft", ({"saft","kaktussaft"}), 50, 10, 0, 4,
  ({"Der Wirt bringt Dir einen Kaktussaft, der Dich sehr erfrischt.\n",
      "Der Wirt bringt &3 einen Kaktussaft.\n"}));

  
  AddDrink("Scheich-Cocktail", ({"cocktail", "scheich-cocktail"})
         , 2500, 70, 20, 20,
	   ({"Der Wirt oeffnet eine kleine Flasche und gibt sie Dir. "
	       "Du leerst sie auf einen Schluck und hast urploetzlich "
	       "das Gefuehl, abzuheben.\n", "&& nimmt einen tiefen "
	       "Schluck aus einem kleinen Flaeschchen und bekommt "
	       "ploetzlich einen glasigen Blick.\n"}));

  
  AddFood("Bratwurm 'Wuestensturm'", ({"bratwurm","wurm"}), 400, 50, 20,
  ({"Du bekommst einen Teller voll mit irgendeinem lecker riechenden Zeug, "
      "dass Du in einem Anflug von Appetit verschlingst.\n",
      "&& verschlingt das Essen, scheinbar ohne darueber nachzudenken, was "
      "das auf dem Teller eigentlich ist.\n"}));

  AddExit("unten","./laden");
  AddItem(NPC "wirt", REFRESH_DESTRUCT);
}




