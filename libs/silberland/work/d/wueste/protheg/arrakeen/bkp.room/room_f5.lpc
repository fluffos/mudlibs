#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine Kreuzung in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst auf einer Kreuzung in Arrakeen. Im Westen siehst Du ein "+
    "grosses Tor und dahinter die duestere Atmosphaere der verbotenen "+
    "Zone, im Osten fuehrt die Strasse bis zu einem schmucklosen Haus "+
    "und endet dort. Im Norden siehst Du den Marktplatz von Arrakeen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"arrakeen"}),
    "Arrakeen ist die Hauptstadt der Wueste.");
  AddDetail ( ({"wueste"}),
    "Du kennst Die Wueste nicht? Hm, ist vielleicht auch besser so. Man "+
    "sagt naemlich, dass es dort gefaehrlich sein soll.");
  AddDetail ( ({"atmosphaere"}),
    "Die ist hier sehr bedrueckend und duester. Eigentlich willst Du nur "+
    "noch weg.");
  AddDetail ( ({"bezirk", "zone"}),
    "Die verbotene Zone (oder auch der Bezirk genannt) ist das Gefaengnis "+
    "von Arrakeen. Eigentlich ist es kein Gefaengnis, sondern die "+
    "Katakomben. Jedenfalls herrscht da unten das Gesetz des Staerkeren und "+
    "es gibt keine Wachen.");
  AddDetail ( ({"gefaengnis"}),
    "Man sagt Gefaengnis zum verbotenen Bezirk. Eigentluch seltsam.");
  AddDetail ( ({"gesetz"}),
    "Gesetze gibt es dort eigentlich nicht. Aber so genau weiss man das "+
    "nicht, da sich niemand dort runter wagt.");
  AddDetail ( ({"staerkere", "staerkeren"}),
    "Stark muss man sein, um dort ueberleben zu koennen.");
  AddDetail ( ({"haus"}),
    "Das muss das Haus sein, das vorher schon angekuendigt war.");
  AddDetail ( ({"hauptstadt", "stadt"}),
    "Hm, eigentlich ist Arrakeen die einzige Stadt in der Wueste, von der "+
    "Du bisher gehoert hast.");
  AddDetail ( ({"katakomben"}),
    "Eigentlich willst Du das nicht so genau wissen.");
  AddDetail ( ({"kreuzung", "kreuzungen"}),
    "Du interessierst Dich doch nicht fuer Kreuzungen, oder?");
  AddDetail ( ({"markt", "marktplatz"}),
    "Du kannst den Marktplatz im Norden sehen.");
  AddDetail ( ({"strasse"}),
    "Die Strasse ist nicht sehr ungewoehnlich.");
  AddDetail ( ({"wache", "wachen"}),
    "Wachen gibt es in den Katakomben von Arrakeen nicht mehr. Die sind "+
    "alle ermordet worden.");
  AddDetail ( ({"tor"}),
    "Das Tor ist fest verschlossen.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./room_e5");
  AddExit ("osten", "./room_f6");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
