#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/players/muaddib/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Im Rekrutierungsbuero der Streitkraefte");
  SetProp (P_INT_LONG,
    "Du stehst im Rekrutierungsbuero der herzoeglichen Streitkraefte. An "+
    "den Waenden haengen wertvoll aussehende Waffen und Ruestungen. In "+
    "der Mitte des Raumes steht ein gewaltiger Schreibtisch, hinter dem "+
    "ein ordenbehaengter Bashar sitzt und Dich streng mustert. Im "+
    "hinteren Teil des Raumes siest Du eine Treppe, die nach oben fuehrt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"bashar", "offizier"}),
    "Ein Bashar ist ein hoher Offizier in den herzoeglichen "+
    "Streitkraeften.");
  AddDetail ( ({"streitkraefte", "streitkraft"}),
    "Das ist das Hauptquartier der herzoeglichen Streitkraefte. Hier "+
    "werden Rekrutierungen vorgenommen und neue Strategien entworfen.");
  AddDetail ( ({"boden"}),
    "Der Boden ist mit edlem Holz getaefelt.");
  AddDetail ( ({"holz"}),
    "So genau kannst Du das nicht identifizieren.");
  AddDetail ( ({"treppe"}),
    "Vielleicht kannst Du nach oben gehen?");
  AddDetail ( ({"ruestung", "ruestungen", "waffen"}),
    "Die ausgestellten Waffen und Ruestungen sehen sehr wertvoll aus und "+
    "haben den Streitkraeften sicherlich schon wertvolle Dienste erwiesen.");
  AddDetail ( ({"dienst", "dienste"}),
    "Das ist doch eigentlich nicht so wichtig, oder?");
  AddDetail ( ({"decke"}),
    "Die Decke ist wertvoll getaefelt.");
  AddDetail ( ({"waenden", "wand","waende"}),
    "Die Waende sind wertvoll geschmueckt und lassen den Raum edel "+
    "aussehen.");
  AddDetail ( ({"strategie", "strategien"}),
    "Strategien gegen die aufkeimende Gewalt in Arrakeen zum Beispiel.");
  AddDetail ( ({"beispiel"}),
    "Nur ein Beispiel.");
  AddDetail ( ({"hauptquartier"}),
    "Es kursieren Geruechte ueber weitere Stuetzpunkte in der Wueste.");
  AddDetail ( ({"geruecht", "geruechte", "stuetzpunkt","stuetzpunkte"}),
    "De Geruechte besagen, dass die Stuetzpunkte der Ueberwachung der "+
    "Fremen dienen.");
  AddDetail ( ({"fremen"}),
    "Fremen sind die Ureinwohner der Wueste.");
  AddDetail ( ({"arrakeen", "hauptstadt", "wueste"}),
    "Du befindest Dich in Arrakeen, das ist die Hauptstadt der Wueste.");
  AddDetail ( ({"ureinwohner"}),
    "Das sind die Fremen.");
  AddDetail ( ({"gewalt"}),
    "Auch hier herrscht in gewissen Teilen durchaus viel Gewalt.");
  AddDetail ( ({"bezirk", "teil", "teile", 
                "teilen"}),
    "Damit ist bestimmt der verbotene Bezirk gemeint.");
  AddDetail ( ({"mitte", "schreibtisch"}),
    "Der gewaltige Schreibtisch des Bashars befindet sich ungefaehr in der "+
    "Mitte des Raumes.");
  AddDetail ( ({"raum"}),
    "Der Raum ist ein Bruchteil des Hauptquartieres der herzoeglichen "+
    "Streitkraefte.");
  AddDetail ( ({"bruchteil"}),
    "Du nimmst an, dass das Hauptquartier noch wesentlich groesser ist.");
  AddDetail ( ({"rekrutierung", "rekrutierungen"}),
    "Wer hier fuer was rekrutiert wird, ist Dir noch nicht ganz klar. Aber "+
    "vielleicht findest Du es ja heraus?");
  AddDetail ( ({"rekrutierungsbuero"}),
    "Irgendwo muessen ja neue Soldaten rekrutiert werden.");
  AddDetail ( ({"soldat", "soldaten"}),
    "Du wunderst Dich, wer sich hier wohl meldet.");
  AddDetail ( ({"ueberwachung"}),
    "Die wilden Fremen werden von hier aus ueberwacht, damit sie keinen "+
    "Staatsstreich anzetteln.");
  AddDetail ( ({"staatsstreich"}),
    "So etwas ist hier absolut unerwuenscht.");
  // DETAILS END

  // EXITS START
  AddExit ("raus", "auf die Strasse#"+"./room_f6");
  AddSpecialExit("oben", "treppe_rauf");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int treppe_rauf()
{
  write(BS("Du wendest Dich der Treppe zu. In diesem Moment dreht sich "+
	"der Bashar zu Dir um und bruellt Dir zu: \"Weg da oder ich "+
	"lasse Sie verhaften!\"\n"));
  say(BS(TP->name(WER, 2)+" geht zur Treppe und wird in diesem Moment "+
	"vom Bashar angebruellt: \"Weg da oder ich lasse Sie verhaften."+
	"\"\n"));			
return 1;	
}	
