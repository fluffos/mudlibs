#include <properties.h>
#include <moving.h>
#include "../def.h"



inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Ein Weg in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst auf einem Weg in Arrakeen, der innerhalb der schuetzenden "+
    "Mauern einmal um die Stadt herumfuehrt. Die Mauern bestehen aus "+
    "glattem, schwarzem Stein, der sicher nicht in dieser Art entstanden "+
    "ist. Die Mauern dienen wohl dem Schutz der Stadt vor Monstern und "+
    "Feinden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"weg"}),
    "Du stehst auf einem Weg innerhalb der Stadtmauern.");
  AddDetail ( ({"stadtmauer"}),
    "Die Stadtmauer ist zum Schutz der Stadt 12 Meter hoch aus glattem, "+
    "schwarzem Stein, so dass keine Feinde ueber sie steigen koennen.");
  AddDetail ( ({"stadt"}),
    "Du bist in Arrakeen.");
   AddDetail ( ({"erbauer", "magier"}),
    "Muaddib hat diese Stadt gebaut.");
  AddDetail ( ({"hoehe", "mannslaengen"}),
    "Du hast die Hoehe auf 6 Mannslaengen geschaetzt. Damit warst Du "+
    "ziemlich genau, wenn Du einen Elfen als Masstab genommen hast.");
  AddDetail ( ({"feind", "feinde"}),
    "Feinde der Stadt sind hauptsaechlich unzivilisierte Fremen und "+
    "Monster, die man in der offenen Wueste finden kann.");
  AddDetail ( ({"fremen"}),
    "Die Fremen sind ein Volk, das zum Teil in der Wueste und zum anderen "+
    "Teil hier in der Stadt leben.");
  AddDetail ( ({"wueste"}),
    "Die Wueste beginnt irgendwo hinter der Stadt.");
  AddDetail ( ({"arrakeen"}),
    "Arrakeen ist die Hauptstadt der Wueste.");
  AddDetail ( ({"stein","gesteinsart"}),
    "Das moechtest Du gar nicht so genau wissen.");
  AddDetail ( ({"hauptstadt"}),
    "Die Hauptstadt ist Arrakeen.");
  AddDetail ( ({"mauer", "schutz", "stein"}),
    "Die Mauer dient dem Schutz des Volkes.");
  AddDetail ( ({"volk"}),
    "Man sagt, das Volk bestuende aus Fremen, die lieber in der Hauptstadt "+
    "als in Sietchsiedlungen wohnt.");
  AddDetail ( ({"sietchsiedlung", "sietchsiedlungen","lebensgemeinschaft"}),
    "Eine Sietchsiedlung ist eine sagenumwobenen Lebensgemeinschaft mitten "+
    "in der Wueste.");
  AddDetail ( ({"meter","teil"}),
    "Das ist wirklich nicht so wichtig.");
  AddDetail ( ({"monster"}),
    "Damit sind wohl die Monster gemeint, die ueber Arrakeen herfallen "+
    "koennten.");
  AddDetail ( ({"art"}),
    "Stein entsteht normalerweise nicht in glatter und schwarzer Form.");
  AddDetail ( ({"form"}),
    "Das ist wirklich unwichtig.");
  AddDetail ( ({"gebiet", "gebiete"}),
    "Es gibt im Silberland viele erforschte und unerforschte Gebiete.");
  AddDetail ( ({"silberland","land","welt"}),
    "Das Silberland ist das einzige bekannte Land auf dieser Welt.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./room_e9");
  AddExit ("westen", "./room_g8");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
