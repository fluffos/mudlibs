// by PROtheG

#include "../def.h"

inherit MOST "mynpc";

string fackel()
{
  object f;

  if((MENV) && (file_name(MENV)==ROOM "nordturm"))
    if(MENV->GetFackel())
      {
	f=clone_object("/obj/fackel");
	
	f->move(ME, M_NOCHECK);
	
	if(f->move(TP, M_GIVE)==ME_TOO_HEAVY)
	  {
	    write(BS("Der Turmwaechter gibt Dir eine Fackel aus dem Schrank, "
		     "doch sie ist Dir zu schwer und faellt Dir aus der "
		     "Hand!"));
	
	    f->move(MENV,M_NOCHECK);
	    
	    return "";
	  }
	return "oeffnet den Schrank und uebergibt Dir eine Fackel.";
      }
    else
      return "sagt: Ich habe leider keine mehr im Schrank.";

  return "sagt: Ich habe im Moment keine.";
}

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Turmwaechter");
  SetProp(P_LONG, 
	  BS("Vor Dir steht ein ziemlich kraeftiger Mensch, der seine "
	     "Pflicht ziemlich ernstzunehmen scheint. Huete Dich vor seinem "
	     "Zorn und besonders vor seinen Kollegen!!"));
  
  create_default_mensch(20, MALE);
  
  AddId(({"\nturmwaechter","wache","waechter","turmwaechter",
	    "Schwertexperte"}));
  
  SetProp(P_ALIGN, 400);

  SetProp(P_HANDS, ({" mit seinen starken Haenden", 200, DT_BLUDGEON}));

  SetProp(P_NAME, "Turmwaechter");
  SetProp(P_NOMAGIC, 20);

  AddInfo(({"barlogor","grab","nftah",DEFAULT_INFO}), 
	  "Frag das mal den alten Nftah am Dachboden.","meint: ");

  AddInfo(({"oben","dachboden"}),
	  "deutet nach Oben.");

  AddInfo(({"wuerfeln","wuerfel","spiel","wuerfelspiel"}),
	  "Willst Du vielleicht ein Spiel wagen?","freut sich: ");

  AddInfo(({"karten","kartenspiel"}),
	  "Nein, ich spiele nur mit Wuerfeln.","sagt: ");

  AddInfo(({"friedhof","nftahfriedhof","nftahfamilienfriedhof",
	      "grab","grabstaette","nftahgrab","nftahgrabstaette"}),
	  "Meinst Du den Nftahfriedhof nordoestlich von hier?", "fragt: ");

  AddInfo(({"fackel","fackeln"}), CLOSURE(fackel));
  
  SetProp(P_LOG_INFO, "protheg/missing");

  SetChats(1,({
    "Der Turmwachter setzt sich an den Tisch und wuerfelt eine Runde.\n",
      "Der Turmwaechter geht auf und ab.\n",
      "Der Turmwaechter mustert Dich.\n",
      "Der Turmwaechter ruht sich auf einem Sessel kurz aus.\n"}));
  
  SetAttackChats(1,({
    "Der Turmwaechter bruellt: Ich werde Dich lehren!!\n",
      "Der Turmwaechter sticht gefaehrlich nahe an Deinem Hals vorbei...\n",
      "Der Turmwaechter hackt mit seinem Schwert auf Dich ein.\n",
      "Der Turmwaechter versucht Dich zu ueberwaeltigen.\n"}));

  SUID;

  CLONEME("/p/armour/shield/bronzeschild");
  CLONEME("/p/armour/armour/kettenhemd");
  CLONEME("/p/armour/helm/topfhelm");
  command_me("trage alles");

  CLONEME("/p/weapon/sword/langschwert");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  /*
  if((!random(100) && (interactive(enemy))) && 
     (file_name(MENV)==ROOM "nordturm"))
    { 
      enemy->StopHuntFor(ME,1);
      StopHuntFor(enemy,1);
      write(BS("Der Turmwaechter ueberwaeltigt Dich und laesst Dich "
	       "einsperren..."));
      say(BS("Der Turmwaechter ueberwaeltigt "+enemy->name(WEN)+" und laesst "+
	     enemy->QueryPronoun(WEN)+" einsperren..."),TP);
      enemy->move(ROOM "zelle:"+getuid(enemy), M_NOCHECK);
    }
  else 
*/
  
  if(!QueryProp(P_WEAPON))
    command_me("zuecke langschwert");
  
  return ::Defend(dam, dam_type, spell, enemy);
}


void init()
{
  ::init();
  
  if(TP && TP->id("\nturmwaechter")) 
    AddDefender(TP);

  call_out("nimm_alles", 2);
}

void nimm_alles()
{
  command_me("nimm alles");
}

void InformDefend(object enemy)
{
  if(!ME->InFight())
    say("Der Turmwaechter bruellt: Stirb Frevler"+
	((TP->QueryProp(P_GENDER)==FEMALE)? "in":"")+"!!!\n");

  Kill(enemy);
}

void die(int poisondeath) 
{
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    KILLMASTER->register_player_death(player, lxp);
      
  ::NotifyPlayerDeath(player, killer, lxp);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("schwert_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("schwert_check", 5);

  return ::StopHuntingMode(silent);
}

schwert_check()
{
  QueryProp(P_WEAPON)->SetProp(P_CURSED, 0);
  
  if(!m_sizeof(GetEnemies()))
    command("stecke schwert weg");
}
