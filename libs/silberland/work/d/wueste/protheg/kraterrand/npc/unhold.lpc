#include "../def.h"
#include "npcmaster.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boeser Unhold treibt hier sein Unwesen");
  SetProp(P_LONG, 
	  BS("Vor Dir steht ein furchtbarer Unhold, der bloss darauf wartet, "
	     "Dich aufzufressen. Sein riesiger Koerper koennte Dich wie eine "
	     "Fliege zerquetschen und seine vier Arme koennten Dich auf der "
	     "Stelle zerreissen. Ehrfurchtsvoll trittst Du einen Schritt "
	     "zurueck..."));

  SetProp(P_NAME, "Unhold");
  SetProp(P_GENDER, MALE);
  AddAdjective(({"boesen","boser"}));
  SetProp(P_NAME_ADJ, "boes");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:80]));
  AddId(({"\nunhold","unhold",
	    "\nurharterwichtigergegnerweilunholdbweachtschatz"}));
  
  create_default_npc(35);

  SetProp(P_ALIGN, -600-random(100));
  SetProp(P_HANDS, ({" mit seinen furchtbaren Klauen", 
		       QueryProp(P_HANDS)[1]+222, ({DT_TERROR,DT_RIP})}));
  SetProp(P_BODY, QueryProp(P_BODY)+99);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 900);
  SetProp(P_WEIGHT, 814935);
  SetProp(P_MAX_HANDS,4);
  SetProp(P_NOCORPSE,1);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([
	    DT_FIRE:  -0.2, DT_COLD:     -0.2, DT_WATER:     0.1, 
	    DT_AIR:   -0.4, DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.1, 
	    DT_SOUND: -0.1, DT_LIGHT:     0.3, DT_ELECTRIC:  0.0, 
	    DT_ACID:  -0.3, DT_POISON:   -0.2, DT_TERROR:   -0.4,
	    DT_HOLY:   0.2, DT_UNHOLY:    0.2, DT_MAGIC:     0.2]));

  SetProp(P_NO_SCORE, 1);
  SetGuardProtection(GUARD_LOCATION, 100);

  SetProp(P_SPELLRATE, 60);
  SetProp(P_NOMAGIC, 33);

  SetProp(P_KILL_MSG, "All Dein Gold gehoert nun mir!\n");
  
  SetProp(P_MSGIN, "stampft wuetend herein");
  SetProp(P_MSGOUT, "stampft wuetend");
  SetProp(P_DIE_MSG, " verendet jaemmerlich.\n");

  AddDetail(({"klauen","krallen","arme","arm","klaue","kralle"}),
	    "Der Unhold besitzt vier starke, Arme mit jeweils fuenf "
	    "messerscharfen Klauen, die er staendig an den Waenden wetzt, "
	    "um sie zu schaerfen.");

  AddDetail(({"bein","beine"}),
	    "Der Koerper des Unholdes ist zu gross und schwer, als dass "
	    "ihn irgendwelche Beine tragen koennten.");

  AddDetail(({"koerper"}),
	    "Der massige Koerper des Unholdes fuellt fast die halbe "
	    "Grabkammer aus. Mit nur einem kleinen Schwung koennte er Dich "
	    "unter sich begraben!!");

  AddDetail(({"kopf"}),
	    "Der Kopf besteht eigentlich nur aus dem riesigen Maul und dem "
	    "Augenpaar.");

  AddDetail(({"maul"}),
	    "Das riesige, zaehnebesetzte Maul sabbert unentwegt vor sich "
	    "hin.");

  AddDetail(({"augen","augenpaar","auge"}),
	    "Sie lassen nicht ab von Dir!");

  AddInfo(DEFAULT_INFO, ({
    "bruellt Dich an.\n",
      "tritt Dich brutalst nieder.\n",
      "blickt Dich finster an.\n"}));

  SetChats(3, ({
    "Der Unhold bruellt Dich an.\n",
      "Der Unhold stampft mit dem Fuss auf.\n",
      "Der Unhold wetzt seine Klauen.\n",
      "Der Unhold schnuppert herum.\n"}));


  AddSpell(1,300,
	   "Der Unhold schleudert Dich gegen Die Wand.\n",
	   "Der Unhold schleudert @WEN gegen Die Wand.\n",
	   DT_BLUDGEON,"umfallt");

  AddSpell(5,400,
	   "Der Unhold jagt Dir seine Klauen in den Leib.\n",
	   "Der Unhold jagt @WEM seine Klauen in den Leib.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
	   "Der Unhold reisst Dich beinahe entzwei.\n",
	   "Der Unhold reisst @WEN beinahe entzwei.\n",
	   DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1000,
	   "Der Unhold begraebt Dich unter seinem maechtigen Koerper.\n",
	   "Der Unhold begraebt @WEN unter seinem maechtigen Koerper.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
}

void umfallt(object enemy, int damage, mixed dam_type)
{
  if(!enemy->QueryProp(P_PARALYZED))
    enemy->SetProp(P_PARALYZED, 
		   ([
		     PARALYZE_TIME:5+random(5),
		     PARALYZE_MSG:"Dir wird schwarz vor Augen...\n",
		     PARALYZE_MSG_OTHER:"%s bleibt ohnmaechtig liegen.\n",
		     PARALYZE_END:"Du wachst langsam auf...\n",
		     PARALYZE_END_OTHER:"%s wacht wieder auf.\n"]));
}

void init()
{
  ::init();
  
  if(!is_clone(TO)) return;  

  if(interactive(TP)) call_out("sers", 2);
}

void sers()
{
  if(TP && present(TP, MENV))
    tell_object(TP, "Der Unhold erblickt Dich und bruellt auf.\n");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(MENV && file_name(MENV)==ROOM "grabkammer")
    if(ROOM "grabkammer"->SchatzDa())
      {
	return ::Defend(dam/2, dam_type, spell, enemy);
	heal_self(dam);
	tell_room(MENV, 
		  "Der Unhold huellt sich in eine dunkle Aura und sieht "
		  "ploetzlich gesund aus!\n");
      }

  return ::Defend(dam, dam_type, spell, enemy);
}

