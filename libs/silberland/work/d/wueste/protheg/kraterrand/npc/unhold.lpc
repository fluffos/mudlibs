  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt den Unhold.\n");
  
  ::die(poisondeath);
}
*/

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    write_file(LOG "unhold",
	       ctime()+": Der Unhold killt "+CAP(getuid(player))+
	       " ("+lxp+")\n");
  if(ENV(killer))
    tell_room(ENV(killer), "Der Unhold bruellt erfreut.\n");
  
  killer->heal_self(500);
}

int _query_wimpy() { return 0; }

int PreventFollow(object dest)
{
  string wo;
  
  if(sscanf(file_name(dest), ROOM "%s",wo )!=1) return 1;
  if(member(({"grabkammer","gruft","krater_0_2_0"}), wo)==-1)
    return 1;
  return 0;
}
