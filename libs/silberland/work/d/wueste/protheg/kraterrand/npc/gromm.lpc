/*
  Gromm der Erfinder der Bewaesserungsanlage! 
  und Questnpc
  by PROtheG
*/

#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gromm der Erfinder");
  SetProp(P_LONG, 
	  "Bla bla erfinder questnpc!\n");

  create_default_human(15);

  AddId(({"gromm","erfinder"}));

  SetProp(P_ALIGN, 400);
  SetProp(P_HANDS, ({" mit einem Hammer", 170, DT_BLUDGEON}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Gromm");
  SetProp(P_ARTICLE, 0);

  SetProp(P_NOATTACK, "ist schon viel zu alt fuer so etwas!\n");

  SUID;
  //  CLONEME(OBJ "samen");
}
