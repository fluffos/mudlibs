#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine dreckige Ratte");
  SetProp(P_LONG, 
	  BS("Eine dreckige Ratte, die Dich frech aus kleinen roten Augen "
	     "heraus anstarrt. Mit den spitzen Zaehnchen kann sie Dir sicher "
	     "fest in den Finger beissen, wenn Du sie nicht in Ruhe laesst."));

  SetProp(P_NAME, "Ratte");
  SetProp(P_GENDER, FEMALE);

  AddId(({"dreckige ratte", "ratte"}));

  create_default_npc(3);
  
  SetProp(P_HANDS, ({ " mit kraeftigen Kiefern", 50, DT_PIERCE}));
  SetProp(P_RACE, "Ratte");
  SetProp(P_SIZE, 15+random(5));
  SetProp(P_WEIGHT, 800+random(100));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "huscht quiekend herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " verendet quiekend.\n");
  
  AddInfo(DEFAULT_INFO, "piepst frech.\n");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP,
	      "Die Ratte ist viel zu klein, um sowas zu schleppen.\n" }) );
}
