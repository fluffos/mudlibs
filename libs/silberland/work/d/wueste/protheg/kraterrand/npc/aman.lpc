// by PROtheG

#include "../def.h"

inherit MOST "mynpc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Aman der Limonadenverkaeufer");
  SetProp(P_LONG, 
	  BS("Aman ist schon recht alt, aber trotzdem steht er hier in der "
	     "Hitze und verkauft seine Limonade. Niemand weiss, woher er "
	     "kommt, denn keiner scheint seine Sprache verstehen zu "
	     "koennen."));

  SetProp(P_NAME, "Aman");
  SetProp(P_ARTICLE, 0);

  create_default_mensch(15, MALE);

  AddId(({"aman","limonadenverkaeufer","verkaeufer","Messerexperte"}));

  SetProp(P_ALIGN, 200);
  SetProp(P_HANDS,({" mit seinem Haenden", QueryProp(P_HANDS)[1], DT_PIERCE}));

  AddInfo(DEFAULT_INFO, 
	  ({"scheint Deine Sprache nicht zu verstehen.\n",
	      "meint: Umbala?\n",
	      "deutet nur grinsend auf seine Limonaden.\n"}));

  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1,200,
	   "Aman beisst Dich.\n",
	   "Aman beisst @WEN.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,350,
	   "Aman steckt Deine Hand in den Entsafter.\n",
	   "Aman steckt @WESSEN Hand in den Entsafter.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  SUID;
  
  CLONEME(ARMOUR "fez");
  CLONEME(ARMOUR "umhang");
  command("trage alles");    

  CLONEME(WEAPON "obstmesser");
  command("zuecke messer");    
}


