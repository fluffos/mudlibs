/*
  Schlange...
*/

#include "../def.h"

inherit MOST "mynpc";

#define SNAKES ([0:"Sandviper";"giftig";DT_POISON,          \
		 1:"Klapperschlange";"wuetend";DT_SQUEEZE,  \
		 2:"Wuestennatter";"gefaehrlich";DT_PIERCE])

void create()
{
  int rnd;
  
  if(!is_clone(TO)) return;
  ::create();
  
  rnd=random(3);

  SetProp(P_SHORT, "Eine "+SNAKES[rnd]);
  SetProp(P_LONG, 
	  BS("Du hast die "+SNAKES[rnd] +" in ihrer Ruhe gestoert, nun will "
	     "sie Dich buessen lassen..."));

  SetProp(P_NAME, SNAKES[rnd] );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, SNAKES[rnd,1]);
  AddAdjective(({SNAKES[rnd,1]+"e",SNAKES[rnd,1]+"en"}));

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:60]));

  AddId(({SNAKES[rnd],"schlange", "\nschlange"}));

  create_default_npc(8+random(5));
  
  SetProp(P_HANDS,({({" mit ihren kraeftigen Kiefern",
			" mit ihrem langen Schwanz",
			" mit ihren spitzen Zaehnen"})[random(3)],100,
		      SNAKES[rnd,2]}));

  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 105+random(100));
  SetProp(P_WEIGHT, 5901);
  SetProp(P_ALIGN, -200);
  SetProp(P_HEAL, 10);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "schlaengelt zischend herein");
  SetProp(P_MSGOUT, "schlaengelt zischend");
  SetProp(P_DIE_MSG,  " kruemmt sich im Todeskrampf.\n");
  
  AddInfo(DEFAULT_INFO, "zischt Dich an.\n");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Die "+SNAKES[rnd] +" braucht soetwas nicht..\n"}));
}
