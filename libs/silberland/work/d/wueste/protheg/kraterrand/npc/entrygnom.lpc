/*
  Ein kleiner gemeiner Gnom
*/
#include "../def.h"

inherit MOST "mynpc";

#define ARBEITSLAGER "/d/wueste/protheg/lager/room/eingang"

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleiner Gnom");
  SetProp(P_LONG,
	  BS("So einen merkwuerdigen kleinen Gnom hast Du wohl noch nie "
	     "gesehen. Bis auf einen kleinen Lendenschurz bekleidet, huepft "
	     "der kleine andauernd um Dich herum und kichert dabei irr."));
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"gnom", "entrygnom"}));
  
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen flinken Fingern",
		       QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 25384);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,([DT_MAGIC:1.0]));
  SetProp(P_NOMAGIC, 100);
  
  SetProp(P_MSGIN, "kommt irr kichernd herein");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DIE_MSG,  " stirbt mit einem letzten Kichern.\n");
  SetProp(P_MURDER_MSG, "*kicher* Nochmal! *kicher*");
  
  SetProp(P_LOG_INFO, "protheg/missing");

  AddInfo(DEFAULT_INFO, 
	  ({"sabbert Dich an.\n",
	      "schleckt Dich ab.\n",
	      "huepft um Dich herum.\n",
	      "kichert einfach nur.\n"}));
  
  AddInfo(({"ausgang","ausweg"}),
	  "Den findest Du nieee!",
	  "kichert: ");

  AddInfo(({"hilfe"}), 
	  "ICH sollen Dich helfen koennen?", 
	  "kichert: ");

  AddInfo(({"gnom"}), 
	  "Jaja, ich sein Gnom!",
	  "grinst: ");

  AddInfo(({"hoehle"}), 
	  "Sein huebsches Hoehle, gell?", 
	  "sagt: ");

  AddInfo(({"diamant","diamanten","steinchen"}), 
	  "Jajaja, scheene kleine Steinchen sind fest in Waende! Ich schon "+
	  "versucht, aber meiner Zaehne sind zu schwach!", 
	  "sabbert: ");

  AddInfo(({"tor","stahltor"}), 
	  "Ich Dir nix lassen rein!! Du mir niee zwingen koennen, dass "+
	  "aufmachen!!", 
	  "grummelt: ");

  AddInfo(({"zaehne"}), 
	  "Meiner Zaehne schon sehr alt.", 
	  "sabbert traurig: ");

  AddInfo(({"waende"}), 
	  "Harte Waende mit vieles kleines glitzerndes Steinchen.",
	  "sabbert: ");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP,"Der Gnom sabbert ein wenig darauf herum und wirft "+
	      "Dein Geschenk achtlos auf den Boden.\n"}));
  
  SetChats(5, 
     ({"Der Gnom kichert irr.\n",
	 "Der Gnom zuckt ploetzlich zusammen.\n",
	 "Der Gnom huepft kichernd um Dich herum.\n",
	 "Der Gnom sabbert Dich an und kichert nur.\n",
	 "Der Gnom geht Dir auf die Nerven.\n",
	 "Der Gnom zwickt Dich, Du wuerdest ihn am liebsten treten.\n"}));

  AddCmd(({"zwinge","zwing"}), "zwingen");
}

nosave int zwingen(string str)
{
  notify_fail("Wen willst Du wozu zwingen?\n");
  if(!str) return 0;
  
  if(str=="gnom zu mach auf"||str=="gnom zu mach tor auf"||
     str=="gnom zu mach stahltor auf"||str=="gnom zu oeffne tor"||
     str=="gnom zu oeffne stahltor")
    return write("Der Gnom lacht Dich nur aus und kichert.\n"
		 "Du wuerdest ihn am liebsten treten dafuer!\n"),1;
  return 0;
}

void init()
{
  ::init();
  
  if(interactive(TP)) call_out("tag", 1, TP);
}

void tag(object ob)
{
  if(ENV(ob))
    if(ENV(ob)==ENV(TO))
      if(present("\ngrab_quest_item", ob))
	write(BS("Der kleine Gnom huepft lachend um Dich herum.")+
	      BS("Der kleine Gnom meint: Du hilfst Barlogor? "
		 "Da bist Du hier gaanz falsch!"));
      else
	write(BS("Der kleine Gnom springt Dich an und sabbert Dir "+
		 ({"das rechte Ohr","das Auge","die Nase",
		     "das linke Ohr"})[random(4)]+" voll."));
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object env;
  
  if (find_call_out("reaction") != -1) return;
  
  if((gruppe=="fies"))
    {
      env=ENV(TO);
      if(present(TP, env) && file_name(env)==ROOM "gnomhoehle")
	{
	  tell_object(TP, 
		      "Der Gnom grummelt Dich an und sagt: Jaja ich oeffne "
		      "Dir ja schon...\n");
	  tell_room(env, 
		    "Der Gnom geht zu dem grossen Stahltor macht "
		    "irgendwelche Bewegungen und das Tor oeffnet sich...\n");
	  /*
	    TP->move(ARBEITSLAGER,M_GO|M_NOCHECK, "das Stahltor", "durchschreitet",
	    "kommt durch das Tor herein");
	  */
	  env->AddExit("tor", 
		       ([EX_DEST:ROOM "krater_0_3_0",
		       EX_MSG:"durch das Tor",
		       EX_PLMSG:"Du betrittst das Tor.\n"+
		       "Da hoerst Du ein leises 'Klick' und wirst ploetzlich in "+
		       "die Luft geschleudert...\n"]));
	}
    }
  else
    call_out("reaction", 0, TP,
	     "jault laut auf und schreit: 'Wehe Du machen nochmal!'.\n",
	     "jault laut auf.\n");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

