/*
  Barlogor der Grabquestnpc
  by PROtheG
*/

#include "../def.h"

inherit MOST "mynpc";

#define AI(x,y) AddInfo(x,y,"sagt: ", "\b\b\b\b\b\bfluestert @WEM etwas zu.\n")
#define BST(x,y) break_string(x,78,y)
#define WARTEZEIT 3
#define QUESTKEY "Das namenlose Nftahgrab"

nosave get_belo();
nosave get_key();
nosave set_key_flag();
nosave int quester;

void create()
