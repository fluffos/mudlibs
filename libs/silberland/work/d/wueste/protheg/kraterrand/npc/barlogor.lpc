void reset()
{
  ::reset();

  if(!MENV) return;

  if(quester) quester--;
}

nosave int helpme(string str)
{
  object hm;
  string tmp;
  string *n;

  notify_fail(BST("Du kannst mir mit <biete barlogor hilfe an> "
		  "helfen.\n", Name()+" sagt: "));
  if(!str) return 0;

  if(sscanf(str, "%s hilfe an", tmp)!=1) return 0;
  
  n=explode(tmp, " ");

  if(!sizeof(n & ({"nftah","barlogor","ukmant"})))
    return notify_fail(BS("Wem willst Du denn Deine Hilfe anbieten?")), 0;

  if(present("\ngrab_quest_item",TP))
    return write(BS(Name()+" sagt: Aber Du hilfst mir doch bereits!")), 1;
  
  if(quester) 
    return write("\n"+
		 BST("Oh! Zur Zeit habe ich keine Arbeit fuer Dich. "
		     "Ich habe bereits jemanden losgeschickt, komm "
		     "doch etwas spaeter wieder vorbei!\n", 
		     Name()+" sagt: ")),1;
  
  if(TP->QueryQuest(QUESTKEY))
    return 
      write("\n"+
	    BST("Vielen Dank, aber Du hast mir schon einmal geholfen. "
		"Noch einmal moechte ich Dir das nicht zumuten.\n", 
		Name()+" sagt: ")),1;

  write("\n"+
	BST("Ja, Du willst mir wahrlich helfen? Oh welch noble Tat von Dir! "
	    "Also, ich habe von der Ngohafamilie den Auftrag "
	    "bekommen, ein Grab im oestlichen Teil dieses Friedhofes zu "
	    "renovieren, doch ich traue mich nicht, aufgrund der "
	    "Geruechte ueber ein gewisses Monster, welches dort hausen "
	    "soll...\nBitte renoviere das Grab und bringe mir diesen "
	    "Hammer und diesen Meissel wieder zurueck.\nWenn du mit dem "
	    "Grab fertig bist, sage hier einfach <fertig>, oder teile es "
	    "mir mit. Vergiss dabei bitte nicht, dass Du nur begrenzt "
	    "Zeit hast, also hurtig hurtig!",
	    Name()+" sagt: ")),1;
  
  hm=clone_object(OBJ "q_hm");
  hm->move(TP,M_NOCHECK);
  
  write("\n"+BS(Name()+" uebergibt Dir einen Hammer und einen Meissel."));
  say("\n"+
      BS(Name()+" fluestert "+TP->name(WEM)+" etwas zu.")+
      BS(Name()+" uebergibt "+TP->name(WEM)+" einen Hammer und "
      "einen Meissel."), ({TP}));
  
  quester=WARTEZEIT;

  return 1;
}

void die(int poisondeath)
{
  KILLMASTER->register_npc_death(QueryProp(P_KILLER)||TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp)
{
  if(killer==ME)
    KILLMASTER->register_player_death(player, lxp);

  ::NotifyPlayerDeath(player,killer,lxp);
}

void catch_tell(string str)
{
  string what, who;
  object qi;
  
  if(!MENV) return;

  str=lower_case(str);
  str=regreplace(str, "[^a-z ]","",1);

  if(sscanf(str, "%s teilt dir mit fertig",who)==1||
     sscanf(str, "%s sagt fertig",who)==1)
    {
      who=explode(who," ")[<1];

      if(TP && TP==find_player(who))
	{
	  what="Na ich weiss nicht! Irgendwas fehlt da noch...\n";

	  if(ME->InFight())
	    what="Tut mir leid, aber ich bin im Moment beschaeftigt! "
	      "*metzel*\n";
	  else
	    if(!qi=present("\ngrab_quest_item",TP))
	      what="Fertig? Womit bist Du denn fertig?\n";
	    else
	      if(qi->QueryStat("gemeisselt"))
		{
		  what="Einen Moment das muss ich mir ansehen!\n";

		  tell_room(MENV, 
			    "Barlogor ruft nach einem Diener.\n"
			    "Barlogor schickt den Boten los.\n");

		  call_out("finish",5,TP);
		}

	  if(present(TP,MENV))
	    command_me("sage "+what);
	    //tell_object(TP, BST(what, Name()+" sagt: "));
	  else
	    TP->Message(BST(what, Name()+" teilt Dir mit: "), MSGFLAG_TELL);
	}
    }
}

void finish(object pl)
{
  object bel,qi,ith;
  int finished;
  
  if(!present(pl, MENV))
    {
      tell_object(pl, "Du machst Dich schnell auf den Weg zu Barlogor,\n");
      pl->move(MENV, M_NOCHECK|M_GO);
    }

  if(!qi=present("\ngrab_quest_item",pl))
    return tell_object(pl,
      BST("Da scheint wohl irgendetwas schief "
	  "gegangen zu sein, Du wirst die Quest wohl nocheinmal "
	  "spielen muessen...\n",
	  Name()+" meint: "));

  if(!qi->AllDone()) 
    {
      qi->remove();

      return tell_object(pl,
        BST("Da scheint wohl irgendetwas schief "
	    "gegangen zu sein, Du wirst die Quest wohl nocheinmal "
	    "spielen muessen...\n",
	    Name()+" meint: "));
    }
  
  finished=pl->GiveQuest(QUESTKEY);

  if(finished==1)
    {
      tell_object(pl,
          BST("Ja! Du hast es geschafft! Mygara Sei Dank! Das Grab ist "
	      "wieder so praechtig wie frueher!! Als Belohnung soll "
	      "ich Dir von der Ngoha Familie dies hier "
	      "ueberreichen...", 
	      Name()+" sagt hoch erfreut: "));
      
      tell_object(pl, BS(Name()+" uebergibt Dir einen kleinen Fingerhut."));

      say(BS(Name()+" uebergibt "+pl->Name(WEM,1)+" eine Belohnung."), ({pl}));
      
      bel=clone_object(ARMOUR "fingerhut");
      
      if(bel->move(pl, M_SILENT)==ME_TOO_HEAVY)
        {
          bel->remove(1);

          tell_object(pl, 
              BS("Der Fingerhut ist Dir zu schwer!")+
              BST("Komm wieder, wenn Du ihn tragen kannst, frag "
		  "mich dann nach 'Belohnung' und Du bekommst den "
		  "Fingerhut.", Name()+" sagt: "));
        }
      else
	tell_object(pl,
            BST("Falls er Dir einmal abhanden kommen sollte, frag "
		"mich einfach nach 'Belohnung' und Du bekommst einen "
		"neuen.", Name()+" sagt: "));
      
      //Zordan meinte, dass ghoert offiziell ;)
      write_file("/log/quests/nftahgrab", 
	   dtime(time())+": "+CAP(getuid(pl))+" vollendet die Quest.\n");
      
      qi->remove(1);
      
      tell_object(pl, 
	  BS("Du gibts Barlogor noch Hammer und Meissel zurueck."));
      
      quester=0;
    }
  else
    return 
      tell_object(pl,
	  "ACHTUNG!!! Hier ist was seltsames passiert !!!\n"
	  "Bitte teile dies PROtheG mit: Fehler bei Barlogor ("+
	  finished+")\n");
}

nosave string get_belo()
{
  object bel;
 
  if(present("\nprotheg_ursuper_questbelohnung_fingerhut", TP))
    return "Aber Du hast doch schon einen Fingerhut!!\n";

  if(!TP->QueryQuest(QUESTKEY))
    return "Frag mich das nochmal, wenn Du mir erfolgreich geholfen hast!\n";

  bel=clone_object(ARMOUR "fingerhut");

  if(bel->move(TP, M_SILENT)==ME_TOO_HEAVY)
    {
      bel->remove(1);
      return Name()+" meint: Der Fingerhut ist Dir zu schwer!\n";
    }
  
  write(BS("Barlogor uebergibt Dir etwas."));
  
  return "Falls er Dir einmal abhanden kommen sollte, frag mich einfach nach "
    "'Belohnung' und Du bekommst einen neuen.\n"; 
}

nosave get_key()
{
  object qi,key;
  
  if(present("\nunholdtruhenschluessel",TP))
    return "Aber Du hast doch schon einen Schluessel von mir bekommen!\n";

  if(TP->QueryQuest(QUESTKEY))
    return "Aber Du brauchst den doch gar nicht mehr!\n";

  if(!qi=present("\ngrab_quest_item",TP))
    return "Wofuer willst Du denn meinen Schluessel?\n";

  if(!qi->QueryStat("gefragt"))
    return "Ja, ich habe einen Schluessel, doch ich weiss nicht mehr genau "
      "wofuer der ist. Aber wenn Du mich etwas ausfragst und ich mich "
      "wieder erinnere, werde ich ihn Dir bei erneuter Anfrage geben.";
  
  key=clone_object(OBJ "q_key");
  key->move(TP, M_NOCHECK);
  
  write(BS(Name()+" uebergibt Dir seinen Schluessel."));
  return "Du wirst schon wissen, was Du damit tust!\n";
}

nosave string set_key_flag()
{
  object qi;
  
  if(qi=present("\ngrab_quest_item",TP))
    qi->SetStat("gefragt");

  return "Der Schatz wird in speziellen Truhen aus der Totenwelt "
    "aufbewahrt. Ich habe fuer so eine Truhe einmal einen Schluessel "
    "erkaempft.\n";
}

mixed _query_noattack()
{
  if(quester)
    return "sagt: Nein, jetzt nicht, ich warte auf jemanden.";
}

/*
Der alte Nftah Barlogor Ukmant hatte den Auftrag bekommen, das Grab eines
beruehmten Mitglieds einer Nftahfamilie zu renovieren. Doch seine Arbeiter
weigerten sich, ihre Arbeit auf dem Friedhof zu vollenden, da sich dort 
angeblich ein Ungeheuer eingenistet haben soll.

So geschah es, dass Barlogor Ukmant an mich herantrat und mich bat, 
jemanden zu finden, der mutig genug waere, um sich dieser Aufgabe zu 
stellen. Ich leite diese Bitte hiermit an euch weiter.

Gewiss ist Barlogor kein knausriger Zwerg, er erwaehnte mir gegenueber 
sogar etwas von einer grosszuegigen Belohnung fuer eure Hilfe.

  PROtheG

PS: Um aus dem Questgebiet keine 'Spieler-Autobahn' zu machen
    kann jeweils immer nur einer die Quest spielen. Er/Sie hat
    dafuer ca ein einhalb stunden (1.5h) Zeit. Braucht man zu
    lange, entzieht Barlogor einem den Auftrag wieder...
    (Sudereien deswegen bitte nach /dev/null)
*/
