#include "../def.h"

inherit "std/thing";

void create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Stueck Draht");
  SetProp(P_LONG, 
	  BS("Ein laengliches, verbogenes Stueck Draht. Er duerfte einmal "
	     "ein Teil eines Bettgestelles gewesen sein..."));

  SetProp(P_INFO, BS("Er scheint recht biegsam zu sein..."));
  SetProp(P_NAME, "Draht");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_MISC_METAL);
  AddId(({"drahtstueck","draht"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);
  AddCmd(({"bastle","bastel","bastele","bau","baue","form","forme"}), 
	 "bastelnfkt");
  AddCmd(({"biege","bieg","verbieg","verbiege"}), "biegenfkt");
}

nosave int bastelnfkt(string str)
{
  notify_fail(BS("Was willst Du aus dem Draht formen?"));
  if(!str) return 0;
  
  if(str=="dietrich"||str=="dietrich aus draht"||str=="dietrich aus draht"||
     str=="dietrich aus drahtstueck"||str=="dietrich aus stueck draht"||
     str=="dietrich aus drahtstueck"||str=="stueck draht zu dietrich")
    {
      if(id("dietrich"))
	return write(BS("Der Dietrich ist doch schon perfekt genug!")),1;

      if(TP->QueryAttribute(A_DEX)<random(12))
	return write(BS("Du knotest eine Weile daran herum, doch irgendwie "
			"will daraus kein Dietrich werden. Beim naechsten "
			"Mal wird es Dir sicher gelingen!")),1;

      write(BS("Du biegst und knotest das Stueck Draht so lange, bis Du "
	       "einen perfekten Dietrich in Haenden haelst..."));

      SetProp(P_SHORT, "Ein kleiner Dietrich");
      SetProp(P_LONG, 
	      BS("Der kleine Dietrich koennte Dein Weg in die Freiheit "
		 "sein..."));

      SetProp(P_INFO, "Damit bekommst Du bestimmt jedes Schloss auf!\n");
      SetProp(P_NAME, "Dietrich");

      RemoveId(({"draht","drahtstueck"}));

      AddId("dietrich");

      return 1;
    }
  return 0;
}

nosave int biegenfkt(string str)
{
  notify_fail(BS("Was willst Du denn verbiegen?"));
  if(!str) return 0;
  
  str=explode(str, " ")[0];

  if(str=="dietrich") return bastelnfkt("dietrich");

  if(member(({"draht","drahtstueck","stueck draht"}), str)==-1) return 0;
  
  return write(BS("Du biegst das Drahtstueck in alle moeglichen Richtungen. "
		  "Da faellt Dir ein, dass Du daraus genausogut einen "
		  "Dietrich basteln koenntest.")),1;
}
