/*
  Statue fuer die Grabquest
*/

#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/thing";

nosave int geputzt;

create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine kleine Statue");
  SetProp(P_LONG,
	  BS("Das ist eine kleine Statue, die eigentlich oben auf einem "
	     "Grabstein sitzen sollte. Sie stellt offenbar 'Halrot', "
	     "einen Hausgott der Nftah dar."));
  SetProp(P_INFO, 
	  BS("Statuen dieser Art findet man oft an wichtigen Graebern. "
	     "Meisst stellen sie eine bestimmte Gottheit dar, die den "
	     "Toten bei seiner 'Reise' bewachen soll."));
  SetProp(P_NAME, "Statue");
  SetProp(P_GENDER, FEMALE);
  AddId(({"statue","halrot","halrotstatue","\ngrabqueststatue","QUESTOBJ"}));
  SetProp(P_MATERIAL, MAT_MARBLE);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL,1);
  SetProp(P_NODROP, "Nein, die ist vielleicht wichtig!\n");
  SetProp(P_NEVERDROP,1);

  geputzt=0;

  AddCmd(({"putze","putz","saeuber","saeubere"}),"putzen");
}

nosave putzen(string str)
{
  notify_fail("Was willst Du denn putzen?\n");
  if(!str) return 0;

  if(str=="statue")
    {
      write(BS("Du rubbelst ein wenig an der Statue herum und befreist sie "
	       "vom groessten Schmutz."));
      say(BS(TPN+" rubbelt ein wenig an einer Statue herum."), ({TP}));

      geputzt=1;
      return 1;
    }
  return 0;
}

QueryGeputzt()
{
  return geputzt;
}

long()
{
  string l;
  
  l=QueryProp(P_LONG);
  
  if(geputzt)
    l+=BS("Sie sieht halbwegs sauber aus.");
  else
    l+=BS("Sie sieht sehr schmutzig aus, ueberall an der Statue haengen "
	  "kleine Fetzen von Flechten, oder kleben kleine Erdkrusten. ")+
      BS("Vielleicht sollte man die Statue ein wenig putzen!");
  return l;
}
    
