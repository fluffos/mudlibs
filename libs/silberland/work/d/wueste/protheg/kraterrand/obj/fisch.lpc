#include <properties.h>
#include <language.h>
#include <food.h>
#include "../def.h"

inherit "std/food";

create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Fisch");
  SetProp(P_LONG, "Ein normaler, essbarer Fisch.\n");
  SetProp(P_NAME, "Fisch");
  SetProp(P_GENDER, MALE);
  AddId(({"fisch"}));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_LIVING:100]));
  SetProp (P_FOOD_INFO, ([F_HEAL:20, F_SOAK:10, F_ALCOHOL:0, F_POISON:0]));
  create_fish();
}

BeimEssen()
{
  write("Du stopfst den Fisch schmatzend in Dich hinein.\n");
  say(TPN+" stopft sich einen Fisch in den Mund.\n");
  return ::BeimEssen();
}

create_fish()
{
  switch(random(15))
    {
    case 0:
      SetProp(P_SHORT, "Ein kleiner Hai");
      SetProp(P_LONG, "Der kleine Hai sieht recht schmackhaft aus.\n");
      SetProp(P_NAME, "Hai");
      SetProp(P_NAME_ADJ, "klein");
      AddId(({"hai"}));
      SetProp(P_GENDER, MALE);
      SetProp(P_WEIGHT, 200);
      SetProp(P_VALUE, 400);
      SetProp (P_FOOD_INFO, ([F_HEAL:25, F_SOAK:9, F_ALCOHOL:0, F_POISON:0]));
      break;
    case 1:
      SetProp(P_SHORT, "Eine flache Flunder");
      SetProp(P_LONG, "Die Flunder sieht aus, als haette sich jemand raufgesetzt.\n");
      SetProp(P_NAME, "Flunder");
      SetProp(P_NAME_ADJ, "flach");
      AddId(({"flunder"}));
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 300);
      SetProp(P_VALUE, 500);
      SetProp (P_FOOD_INFO, ([F_HEAL:30, F_SOAK:11, F_ALCOHOL:0, F_POISON:0]));
      break;
    case 2:
      SetProp(P_SHORT, "Ein Kugelfisch");
      SetProp(P_LONG, "Es heisst, Kugelfische sollen giftig sein.\n");
      SetProp(P_NAME, "Kugelfisch");
      AddId(({"kugelfisch"}));
      SetProp(P_GENDER, MALE);
      SetProp(P_WEIGHT, 150);
      SetProp(P_VALUE, 500);
      SetProp (P_FOOD_INFO, ([F_HEAL:12, F_SOAK:4, F_ALCOHOL:0, F_POISON:1]));
      break;
    case 3:
      SetProp(P_SHORT, "Ein langer Zitteraal");
      SetProp(P_LONG, "Der Aal scheint immer noch zu zucken, aber das kommt wohl daher, dass er "+
	      "frueher einmal elektrisch geladen war.\n");
      SetProp(P_NAME, "Zitteraal");
      SetProp(P_NAME_ADJ, "lang");
      AddId(({"zitteraal","aal"}));
      SetProp(P_GENDER, MALE);
      SetProp(P_WEIGHT, 400);
      SetProp(P_VALUE, 900);
      SetProp (P_FOOD_INFO, ([F_HEAL:40, F_SOAK:20, F_ALCOHOL:0, F_POISON:0]));
      break;
    case 4:
      SetProp(P_SHORT, "Eine kleine Seeschlange");
      SetProp(P_LONG, "Die Seeschlange gilt in manchen Gebieten als Delikatesse.\n");
      SetProp(P_NAME, "Seeschlange");
      SetProp(P_NAME_ADJ, "klein");
      AddId(({"schlange","seeschlange"}));
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 200);
      SetProp(P_VALUE, 900);
      SetProp (P_FOOD_INFO, ([F_HEAL:20, F_SOAK:8, F_ALCOHOL:0, F_POISON:0]));
      break;
    case 5..8:
      SetProp(P_SHORT, "Eine Makrele");
      SetProp(P_LONG, "Eine frische Makrele! Lecker!\n");
      SetProp(P_NAME, "Makrele");
      AddId(({"makrele"}));
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 200);
      SetProp(P_VALUE, 900);
      SetProp (P_FOOD_INFO, ([F_HEAL:25, F_SOAK:10, F_ALCOHOL:0, F_POISON:0]));
      break;
    default:
      SetProp(P_SHORT, "Ein Thunfisch");
      SetProp(P_LONG, "Ein grosser Thunfisch! Du kannst es kaum erwarten ihn zu essen!\n");
      SetProp(P_NAME, "Thunfisch");
      AddId(({"thunfisch"}));
      SetProp(P_GENDER, MALE);
      SetProp(P_WEIGHT, 500);
      SetProp(P_VALUE, 900);
      SetProp (P_FOOD_INFO, ([F_HEAL:40, F_SOAK:20, F_ALCOHOL:0, F_POISON:0]));
      break;
    }
}
