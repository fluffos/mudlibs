/*
  Der Schluessel fuer die Truhe des Unholds
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleiner Bernsteinschluessel");
  SetProp(P_LONG,
	  BS("Du haelst einen kleinen, bernsteinernen Schluessel in der Hand. "
	     "Er sieht recht alt und abgegriffen aus, oder sind das "
	     "Kratzer?"));
  SetProp(P_INFO,
	  BS("Dieser Schluessel scheint nicht von dieser Welt zu stammen! "
	     "Der Legende nach soll er soll die Schatztruhe eines Unholdes "
	     "oeffnen koennen."));
  SetProp(P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"klein","kleinen","kleiner"}));
  SetProp(P_GENDER, MALE);
  AddId(({"schluessel","truhenschluessel","\nunholdtruhenschluessel",
	    "bernsteinschluessel","bernsteintruhenschluessel",
	    "NODESTRUCT","NOUNCURSE","QUESTOBJ"}));

  AddDetail(({"kratzer"}),
	    "Anscheinend hat Irgendjemand oder -etwas diesen Schluessel "
	    "mit einigen Kratzern versehen. Du kannst sogar eine Art "
	    "Muster erkennen.");
  AddDetail(({"muster"}),
	    "Du kannst nicht genau erkennen was es ist, aber Du bist Dir "
	    "sicher, dass es etwas ist!");
  AddDetail(({"bernstein"}),
	    "Der Schluessel besteht vollstaendig aus Bernstein.");
  AddDetail(({"bart","schluesselbart"}),
	    "Der Bart des Bernsteinschluessels ist scharf gezackt.");
  AddDetail(({"zacken","bartzacken","schluesselbartzacken"}),
	    "Die Bartzacken des Schluessels sind ziemlich scharf.");

  SetProp(P_MATERIAL, MAT_AMBER);
  SetProp(P_CURSED, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Den brauchst Du doch!\n");
}
