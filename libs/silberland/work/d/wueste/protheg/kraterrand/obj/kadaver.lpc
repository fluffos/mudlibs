/*
  Futter fuer die Aasgeier
*/

inherit "std/thing";

#include "../def.h"

#define KADAVER \
({ "eines Menschen", "eines Elfen", "eines Zwergs", "eines Hobbits", \
   "eines Dunkelelfen", "eines Trolls", "einer Fee", "eines Ogers"})
#define KADAVERIDS \
({ "mensch","elf","zwerg","hobbit","dunkelelf","troll","fee","oger"})

void aussehen()
{
  int r;

  r=random(sizeof(KADAVER));

  SetProp(P_SHORT, "Der Kadaver "+KADAVER[r]);
  SetProp(P_LONG, "Hehe, der "+
	  ({"stinkende","verwesende","verrottende","verfallende",
	      "vertrocknende"})[random(5)]+
	  " Kadaver "+KADAVER[r]+".\n");

  RemoveId(KADAVERIDS);
  AddId(KADAVERIDS[r]);
}

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_NAME, "Kadaver");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_NOGET, 
	  "Ein grauenerregendes Kribbeln erfasst Dich, bei dem Gedanken, "
	  "das zu tun!!\n");

  AddId(({"\nkadaver","kadaver","leiche"}));

  aussehen();
}

void reset()
{
  ::reset();
  
  if(is_clone(ME)) aussehen();
}
