#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/thing";

create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Der Schatz eines Unholds");
  SetProp(P_LONG,
	  BS("Dieser Schatz gehoert einem Unhold, lauter Gold und kleine "
	     "glitzernde Juwelen! Doch fuerchte Dich vor seiner Rache, "
	     "falls er Dich damit sieht..."));
  SetProp(P_INFO, 
	  "Der Legende nach, kann man einen Unhold besiegen, indem man "
	  "seinen Schatz der Sonne ausliefert...\n");

  SetProp(P_NAME, "Schatz");

  SetProp(P_GENDER, MALE);

  AddId(({"schatz","\ngrabquestschatz"}));

  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:60,MAT_GOLD:40]));

  SetProp(P_WEIGHT, 5347);

  SetProp(P_VALUE, 93467);
  SetProp(P_NOBUY, 1);
//  SetProp(P_NOSELL, "Nein, das waere keine gute Idee!\n");
}

init()
{
  object en;
  
  ::init();
  
  en=MENV;
  
  if(en)
    if(file_name(en)==ROOM "krater_0_2_0" && present("\nunhold",en))
      call_out("stirb",1);
}

stirb()
{
  object ob,en;
  
  if(!en=MENV) return;
  
  if(ob=present("\nunhold",en))
    {
      tell_room(en, 
		BS("Als Du den Schatz in den heissen Wuestensand "
		   "wirfst, bruellt der Unhold vor Schmerzen auf und windet "
		   "sich im Todeskampf im Sand..."));
      ob->die();
      tell_room(en, 
		BS("Der Unhold faehrt nun mit seinem Schatz direkt in die "
		   "Hoelle."));
      remove();
    }
}
