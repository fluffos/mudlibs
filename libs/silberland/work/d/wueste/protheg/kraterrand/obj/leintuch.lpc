#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/thing";

create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Leintuch");
  SetProp(P_LONG, "Ein ganz normales Leintuch.");
  SetProp(P_INFO, "Es sieht ziemlich reissfest aus. Was man damit wohl alles "+
	  "anstellen kann?\n");
  SetProp(P_NAME, "Leintuch");
  AddId(({"tuch","leintuch"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);
}

