// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ganz knapp ueber Quaul, bei Gromms Huette");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am oberen Rand eines ziemlich grossen Kraters. "
	     "Der Krater scheint recht tief zu sein, denn Du kannst nicht "
	     "bis auf den Grund blicken. Du raetselt, was da unten wohl sein "
	     "koennte...")+
	  BS("Unweit von Dir entfernt steht eine kleine, sandgepeinigte "
	     "Huette, ob die wohl bewohnt ist?"));

  AddDetail("rand",
	    "Der Rand sieht ziemlich bruechig aus, naeher solltest Du Dich "
	    "nicht vorwagen!");

  AddDetail("krater",
	    "Ob es auch einen Weg da runter gibt?");

  AddDetail("weg",
	    "Der einfachste Weg ist wohl der Sprung!");

  AddDetail(({"sprung","syntax"}),
	    "Die Syntax muesste wohl lauten: <springe runter> .");

  AddDetail(({"grund","loch"}),
	    "Du siehst von hier oben nur ein bodenloses schwarzes Loch.");

  AddDetail("himmel",
	    "Ein leuchtend blauer, wolkenloser Himmel, nur ab und zu siehst "
	    "Du vereinzelte Vogelschwaerme herumirren.");

  AddDetail(({"aasgeier","voegel","vogelschwaerme","schwaerme"}),
	    "Das sind hauptsaechlich Aasgeier, auf der Suche nach toten "
	    "Abenteurern und sich verirrten Tieren.");

  AddDetail(({"leute","abenteurer"}),
	    "Das sind meistens Leute wie Du!");

  AddDetail("tiere",
	    "Die Aasgeier halten ausschau nach kranken, oder halb "
	    "verdursteten Tieren, um denen ein schnelles Ende zu bereiten.");

  AddDetail("ende",
	    "Das steht Dir auch bald bevor, wenn Du hier noch laenger stehen "
	    "bleibst.");

  AddDetail("suche",
	    "Ja, nach Dir suchen sie auch schon!");

  AddDetail("boden",
	    "Hie und da raekeln sich am Boden ein paar vertrocknete Buesche, "
	    "scheinbar hat hier irgendjemand einmal versucht, etwas "
	    "anzubauen.");

  AddDetail("buesche",
	    "Vertrocknete, kleine, dornengespickte Buesche...\n...AUA, jetzt"
	    "hast Du Dich gestochen!");

  AddDetail("huette",
	    "Eine uralte, kleine Huette mit ein paar Fenstern einem Strohdach"
	    ", einem ausgedoerrten Garten und einer seltsamen Apparatur an "
	    "einer Hauswand.");

  AddDetail("fenster",
	    "Sie wurden mit Brettern vernagelt, um den Sand draussen zu "
	    "halten.");

  AddDetail(({"holz","bretter"}),
	    "Ziemlich stabiles Holz, Du kannst keinen Spalt finden, um in "
	    "die Huette reinzuschauen.");

  AddDetail("spalt",
	    "Um etwas zu sehen, wirst Du die Huette wohl betreten muessen!");

  AddDetail("sand",
	    "Die ganze Huette ist davor recht gut geschuetzt.");

  AddDetail(({"dach","strohdach"}),
	    "Auf der Huette liegt eine dicke Schicht Stroh.");

  AddDetail("schicht",
	    "Die Schicht ist nur so dick, weil das Stroh durch Lehm zusammen"
	    "gehalten wird.");

  AddDetail(({"lehm","baustoff"}),
	    "Lehm wird in diesen Gegenden oft als Baustoff verwendet.");

  AddDetail(({"gegenden","wuestengegenden"}),
	    "In den Wuestengegenden regnet es recht selten und deswegen "
	    "werden die Huetten aus billigen und weit verbreiteten "
	    "Materialien gebaut.");

  AddDetail(({"hauptmaterialien","materialien"}),
	    "Die Hauptmaterialien sind Lehm und Stroh.");

  AddDetail("stroh",
	    "Das duerfte hier schon sehr lange auf dem Dach liegen, so "
	    "trocken wie das aussieht.");

  AddDetail("garten",
	    "Der klaegliche Versuch etwas hier anbauen zu wollen. Zuerst "
	    "scheint es geklappt zu haben, doch warum hat der Gaertner dann "
	    "aufgehoert?");

  AddDetail("versuch",
	    "Warum er aufgehoert hat, vermag wohl nur er Dir zu sagen.");

  AddDetail("gaertner",
	    "Da der Garten hier an der Huette angelegt wurde, waere es doch "
	    "wohl logisch, anzunehmen, dass der Gaertner, wenn er nicht "
	    "wegezogen ist, in dieser Huette wohnt, oder?");

  AddDetail(({"wand","hauswand"}),
	    "Fast die ganze rechte Hauswand ist von einer seltsamen "
	    "Apparatur eingenommen. Auf der linken Hauswand haengen ein paar "
	    "alte und halbverrotete Werkzeuge.");

  AddDetail(({"werkzeuge","gartenwerkzeuge"}),
	    "Hauptsaechlich Gartenwerkzeuge, wie Schaufel und Rechen.");

  AddDetail(({"schaufel","rechen"}),
	    "Leider sind die Werkzeuge schon alt und unbrauchbar.");

  AddDetail("apparatur",
	    "Ein Wirrwarr an Schlaeuchen und Roehren, das frueher anscheinend "
	    "oft gebraucht wurde.");

  AddDetail("wirrwarr",
	    "Du kannst nicht einmal erahnen, was dieser Wirrwarr darstellen "
	    "soll. Dir faellt ein kleines Schild auf, welches schraeg "
	    "herunterhaengt.");

  AddDetail("schlaeuche",
	    "Lauter verrottete alte Schlaeuche. Die kann man nicht mehr "
	    "verwenden.");

  AddDetail(({"roehre","roehren","rohr","rohre"}),
	    "Die Rohre scheinen noch halbwegs intakt zu sein, duerften aber "
	    "mit Unmengen an Sand zugestopft sein.");

  AddDetail(({"schild","holzschild"}),
	    "Ein kleines halbvergammeltes Holzschild, da steht sogar etwas "
	    "darauf.");

  AddReadDetail(({"schild","holzschild"}),
		"Du kannst gerade noch ein paar Buchstaben entziffern:"
		"\"Be..esse..ngsa..age fu.. Qu..l\" Er..nde. Gr..m");

  AddCmd(({"betret","betrete","betritt"}), "betrete_huette");	 

  AddExit("sueden", ([EX_DEST:DESERT ":69:37",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedosten", ([EX_DEST:DESERT ":70:37",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("osten", ([EX_DEST:DESERT ":70:36",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordosten", ([EX_DEST:DESERT ":70:35",
                        EX_TESTFUNC: "nopewueste"]));
  
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);  
}

nosave int betrete_huette(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;

  if(str=="huette")
    {
      /*
	TP->move(ROOM "huette_gromm", M_GO, "die Huette", "betritt",
	"kommt herein");
	return 1;
      */
      return write(BS("Du ruettelst an die Tuer, da ertoent aus dem Inneren "
		      "eine Stimme: \"Lasst mich doch endlich in Ruhe!!\"")),1;
    }
  return 0;
}

