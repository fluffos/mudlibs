// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Oben am Rande des Kraters");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich hier am Rande eines Kraters. "
	     "Hier sieht die Gegend ziemlich trostlos und verlassen aus. "
	     "Bis auf ein paar verdorrte Buesche gibt es hier auch nichts "
	     "interessantes...")+
	  BS("Doch! Da faellt Dir hinter einem Busch etwas auf."));

  AddDetail("boden",
	    "Der sandige Boden brennt unter Deinen Fuessen.");

  AddDetail("himmel",
	    "Wolkenlos, wie fast immer...");

  AddDetail("buesche",
	    "War da nicht etwas hinter einem Busch?");

  AddDetail("fuesse",
	    "Du huepfst herum, dass Deine Fuesse wenigstens etwas Kuehlung "
	    "bekommen.");

  AddDetail("kuehlung",
	    "Kuehlung?? Hier in der Wueste?? Vergiss es!!");

  AddDetail("krater",
	    "Westlich von Dir erstreckt sich ein riesiger Krater.");

  AddDetail("rand",
	    "Du stehst am Rand eines riesigen Kraters.");

  AddDetail("gegend",
	    "Sieht ziemlich trostlos aus, die Gegend...");

  AddDetail("wueste",
	    "Genau in der befindest Du Dich!");

  AddDetail("busch",
	    "Liegt da nicht Jemand hinter dem Busch?");

  AddDetail("jemand",
	    "Hinter dem Busch liegt doch tatsaechlich ein alter, "
	    "verwesender Leichnam.");

  AddDetail(({"leiche","leichnam"}),
	    "Du erblickst einen am Boden gekreuzigten Leichnam, der von "
	    "der Sonne so ausgetrocknet wurde, dass er nicht weiter verwest "
	    "sondern einfach nur so da liegt... Armer Kerl!");

  AddDetail(({"sonne","feind"}),
	    "Die Sonne ist Dein groesster Feind, hier in der Wueste!");

  AddDetail("kerl",
	    "Wer mag den wohl so zugerichtet haben?");

  AddSmell(({DEFAULT_SMELL,"verwesungsgeruch","luft"}),
	   "Ein leichter Verwesungsgeruch liegt in der Luft.");

  AddSmell(({"leichnam","kerl"}),
	   "Buaaah! An dem willst Du doch nicht etwa riechen?");
  
  AddExit("osten",     ([EX_DEST:DESERT ":70:35",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedosten", ([EX_DEST:DESERT ":70:36",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordosten", ([EX_DEST:DESERT ":70:34",
                        EX_TESTFUNC: "nopewueste"]));

  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);  
}
