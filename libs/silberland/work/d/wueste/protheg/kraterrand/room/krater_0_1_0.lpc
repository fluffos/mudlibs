/*
  Questraum fuer Nftahgrab
  by PROtheG
*/

#include "../def.h"

inherit MOST "std_room";

nosave int statue, flechte;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Friedhof in der Wueste");
  SetProp(P_INT_LONG, 
	  BS("Du stehst hier auf einem kleinen Fleck mitten in der Wueste. "
	     "Alles scheint normal zu sein, bis auf die Tatsache, dass hier "
	     "ueberall Grabsteine herumstehen. Den Statuen und Denkmaelern "
	     "nach zu urteilen, scheint dies hier eine Grabstaette der Nftah "
	     "zu sein."));

  AddDetail("boden",
	    "Der sandige Boden ist hier recht festgetreten, anscheinend wird "
	    "der Friedhof oft besucht.");

  AddDetail("himmel",
	    "Einige Geier kreisen am Himmel, ansonsten ist er einfach nur "
	    "blau.");

  AddDetail("geier",
	    "Die warten auf Leute, die sich hier verlaufen, um sie dann "
	    "genuesslich zu verspeisen.");

  AddDetail(({"leute","beispiel"}),
	    "Leute wie Dich zum Beispiel!");

  AddDetail(({"fleck","ort"}),
	    ME->QueryProp(P_INT_LONG));

  AddDetail("wueste",
	    "Die Wueste ist ein seltsamer Ort fuer einen Friedhof, oder?");

  AddDetail("tatsache",
	    "Hier stehen ueberall Grabsteine herum, das ist eine Tatsache!");

  AddDetail("grabsteine",
	    "Die Grabsteine sind hier einem aeusserst rauhen Klima "
	    "ausgesetzt, deswegen sind die meisten verwittert. Man kann kaum "
	    "noch lesen, wer da begraben ist. Manche Graeber erkennt man noch "
	    "an einem Familienwappen, welches in die Grabsteine "
	    "eingemeisselt ist.");

  AddDetail(({"hitze","sandstuerme","sandsturm","klima","stuerme","sturm"}),
	    "Furchtbare Sandstuerme und sengende Hitze machen den "
	    "Grabsteinen hier schwer zu schaffen.");

  AddDetail("nftah",
	    "Anscheinend haben die Nftah diesen Friedhof angelegt, denn ihre "
	    "Statuen und Denkmaeler sind unverkennbar.");

  AddDetail(({"denkmaeler","denkmal"}),
	    "Denkmaeler werden zu Ehren bestimmter Nftahhelden errichtet. "
	    "Diese hier bestehen aus einem zweistufigen Sockel, auf welchem "
	    "eine knapp zwei Meter hohe Marmorfigur posiert.");

  AddDetail("sockel",
	    "Sie verhindern nur, dass die Denkmaeler und Statuen nicht im "
	    "Sand versinken.");

  AddDetail("meter",
	    "Zwei Meter sind sie gross.");

  AddDetail(({"kaempfer","helden","nftahhelden"}),
	    "Beruehmte Kaempfer bekommen nach ihrem, meist kurzen Leben, "
	    "ein Denkmal, welches an ihre grossen Taten erinnern soll.");

  AddDetail("leben",
	    "Das Leben der Kaempfer war wohl nicht sehr lang.");

  AddDetail(({"ehren","taten"}),
	    "Wahrscheinlich war der Kaempfer in einer wichtigen Schlacht sehr "
	    "erfolgreich.");

  AddDetail("schlacht",
	    "Die Schlacht ist das wichtigste fuer einen Kaempfer der Nftah.");

  AddDetail(({"wueste","sand"}),
	    "Du bist hier in der Wueste, was hast Du denn anderes erwartet, "
	    "als Sand?");

  AddDetail(({"marmor","marmorfigur","figur"}),
	    "Eine zwei Meter hohe Figur aus grauem Marmor, die diesem "
	    "rauhen Klima schon sichtlich lange ausgesetzt ist.");

  AddDetail(({"statuen","statue"}),
	    "Die Statuen sehen alle schon recht mitgenommen aus. Sie stellen "
	    "entweder eine wichtige Persoenlichkeit, oder den jeweiligen "
	    "Hausgott der Familie dar.");

  AddDetail("persoenlichkeit",
	    "Damit ist wohl einer der vielen Nftahhelden gemeint.");

  AddDetail("familie",
	    "Bei den Nftah hat jede Familie ein eigenes Familienwappen, "
	    "auf das sie sehr stolz ist..");

  AddDetail(({"familienwappen","wappen"}),
	    "Die Graeber der Familien werden durch die Familienwappen "
	    "gekennzeichnet.");

  AddDetail("graeber",
	    "Hier liegen hunderte Graeber, welches meinst Du denn? "
	    "Oder suchst Du eines einer bestimmten Familie?");

  AddDetail(({"grabstaette","friedhof","zustand"}),
	    "Die Grabstaette scheint in einem erbaermlichen Zustand zu sein. "
	    "Ueberall liegen umgekippte Grabsteine, umgefallene und mit "
	    "Flechten ueberwucherte Statuen herum und niemand scheint sich "
	    "um sie zu kuemmern.");

  AddDetail(({"hausgott","hausgoetter"}),
	    "Viele Familien der Nftah pflegen einen Hausgott anzubeten. Sie "
	    "wuerdigen ihnen mit kleinen Opfergaben und Statuen.");

  AddDetail(({"gaben","opfergaben"}),
	    "Oftmals opfern die Nftah ihren Hausgoettern kleinere Tiere.");

  AddDetail(({"tiere","ziegen","schafe"}),
	    "Es werden hauptsaechlich kleinere Tiere, wie Ziegen und Schafe "
	    "geopfert.");

  AddDetail(({"ziege","schaf"}),
	    "Diese Tiere sind hier sehr weit verbreitet und werden deswegen "
	    "oft als Opfergaben an die jeweiligen Hausgoetter verwendet.");

  AddSpecialDetail(({"flechten","flechte"}), "flechten");
  AddSpecialDetail("form","form");

  AddSound(DEFAULT_SOUND, 
	   "Hier herrscht eine Grabesstille, nicht einmal der Wind ist zu "
	   "hoeren.");

  AddSound("wind",
	   "Nicht einmal den Wind hoerst Du hier!");

  AddSound(({"grabesstille","stille"}),
	   "Hier herrscht absolute Stille.");

  AddSmell(({DEFAULT_SMELL,"moder"}),
	   "Es riecht ein wenig nach Moder, aber gehoert das nicht zu einem "
	   "richtigen Friedhof dazu.");

  AddSmell("friedhof",
	   "Es riecht typisch nach Friedhof.");

  AddCmd(({"schabe","schab","kratz","kratze","entferne","reiss","reisse",
	     "rupf","rupfe","loese","loes"}), "flechten_raus");

  AddCmd(CMD_NEHMEN, "nimm_statue");

  AddExit("westen",     ([EX_DEST:DESERT ":65:33",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordosten",  ([EX_DEST:DESERT ":67:32",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordwesten", ([EX_DEST:DESERT ":65:32",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("norden",     ([EX_DEST:DESERT ":66:32",
                        EX_TESTFUNC: "nopewueste"]));
  
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);
  
  statue=1;
  flechte=1;
}

string flechten()
{
  if(flechte)
    return "Einige Flechten scheinen eine besondere Form zu bilden.\n";
  else
    if(statue)
      return "Eine kleine Marmorstatue liegt zwischen den Flechten herum.\n";
    else
      return "Ein paar Flechten scheinen vor kurzem herausgerissen worden zu "
	"sein.\n";
}

string form()
{
  if(statue)
    return "Irgendwas ist darunter! Ob man die Flechten wohl irgendwie "
      "wegbekommt?\n";
  else
    return "Du musst Dich getaeuscht haben...\n";
}

nosave int flechten_raus(string str)
{
  notify_fail(BS("Was willst Du denn ausreissen?"));
  if(!str) return 0;

  if(str=="flechte aus"||str=="flechten aus"||
     str=="flechte heraus"||str=="flechten heraus"||
     str=="flechte"||str=="flechten"||
     str=="flechte ab"||str=="flechten ab")
    if((!random(3))&&(present("\ngrab_quest_item",TP))&&(flechte))
      {
	write(BS("Du ziehst und zerrst eine Weile an den Flechten und legst "
		 "schliesslich eine kleine Marmorstatue frei."));

	say(BS(TPN+" zieht an ein paar Flechten herum."), ({TP}));

	AddDetail(({"marmorstatue","statue"}),
		  "Eine kleine Marmorstatue liegt da zwischen den Flechten.\n"
		  "Ob man die mitnehmen kann?\n");

	flechte=0;

	return 1;
      }
    else
      {
	write(BS("Du ziehst und zerrst eine Weile an den Flechten, aber Du "
		 "schaffst es nicht, die Flechten auszureissen. Beim "
		 "naechsten Mal schaffst Du es bestimmt."));

	say(BS(TPN+" zieht vergeblich an ein paar Flechten herum."), ({TP}));

	return 1;
      }
  return 0;
}

nosave int nimm_statue(string str)
{
  object ob;
  
  if(!str) return 0;

  if(str=="statue"||str=="statue mit"||
     str=="marmorstatue"||str=="marmorstatue mit")
    if((present("\ngrab_quest_item",TP))&&(statue))
      {
        if(present("\ngrabqueststatue",TP))
          return write(BS("Aber Du hast doch bereits eine Marmorstatue!")),1;
	
	if(flechte)
	  return write(BS("Die Marmorstatue ist fest von Flechten "
			  "umwachsen!")),1;

	ob=clone_object(OBJ "q_statue");
	
	if((ob->move(TP))==ME_TOO_HEAVY)
	  {
	    ob->remove(1);
	    return write(BS("Die Statue ist Dir zu schwer. Du laesst sie "
			    "daher liegen.")),1;
	  }
	else
	  write(BS("Du steckst die kleine Statue unbemerkt ein."));

        RemoveDetail(({"marmorstatue","statue"}));

	statue=0;

	return 1;
      }
    else
      return write(BS("Die Statue scheint irgendwie von den Flechten "
		      "festgehalten.")),1;
  return 0;
}

void reset()
{
  ::reset();

  statue=1;
  flechte=1;
  RemoveDetail(({"marmorstatue","statue"}));
}
