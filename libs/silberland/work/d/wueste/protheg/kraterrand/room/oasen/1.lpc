#include "../def.h"

inherit MOST "std_room";
inherit ROOM "oasen/in";

#define MAXHEILEN 5
#define TRINK 8

#define XK 48
#define YK 11

nosave int heilen;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In einer kleinen Oase");
  SetProp(P_INT_LONG,
	  BS("Du kannst Deinen Augen kaum trauen, befindest Du Dich doch "
	     "tatsaechlich an einem kleinen, von Palmen umringten See mitten "
	     "in der Wueste! Neben dem See wurde ein Schild aufgestellt."));

  AddDetail(({"sand","boden"}),
	    "Der Boden hier in der Wueste ist ziemlich sandig, woher das "
	    "wohl kommen mag?");

  AddDetail("himmel",
	    "Der Himmel besteht eigentlich nur aus strahlendem Blau.");

  AddDetail(({"blau","farbe"}),
	    "Meinst Du die Farbe des Himmels, oder des Sees?");

  AddDetail("augen",
	    "Du reibst Dir Deine Augen und blickst noch einmal, doch da ist "
	    "tatsaechlich ein See mitten in der Wueste!");

  AddDetail("see",
	    "Du blickst in das Wasser eines kristallklaren Sees, an dessen "
	    "Oberflaeche das Sonnenlicht glitzert.");

  AddDetail(({"sonne","sonnenlicht"}),
	    "Die Sonne strahlt ziemlich heiss vom Himmel herab und das "
	    "Sonnenlicht bewirkt ein wunderschoenes Glitzern auf dem See.");

  AddDetail("glitzern",
	    "Es beruhigt Dich irgendwie.");

  AddDetail("oberflaeche",
	    "Das Sonnenlicht glitzert auf der Oberflaeche des Sees.");

  AddDetail(({"kokospalmen","palmen"}),
	    "Sehr hohe Kokospalmen, doch es haengen keine Fruechte daran!");

  AddDetail("fruechte",
	    "Vielleicht gibt es ja doch welche, aber von hier unten kommt man"
	    " da nicht ran!");

  AddDetail("wueste",
	    "Wo glaubst Du denn, dass Du Dich hier befindest?");

  AddDetail("wasser",
	    "Ob es wohl geniessbar ist?");

  AddDetail("schild",
	    "Auf dem Schild scheint etwas geschrieben zu sein! Daneben "
	    "entdeckst Du ein Skelett.");

  AddDetail(({"kerl","skelett"}),
	    "Das einzige was der arme Kerl noch bei sich hat ist ein "
	    "halbverrotteter roter Fez, viel ist das nicht, aber er braucht "
	    "sowieso nichts mehr.");

  AddDetail("fez",
	    "Der ist leider schon viel zu vermodert.");

  AddDetail("nase",
	    "Du greifst Dir an die Nase und stellst fest, dass sie noch da "
	    "ist.");

  heilen=MAXHEILEN;
  
  AddReadDetail("schild",
		"  ,-------------------------.\n"
		"  |                         |\n"
		"  |      Mein Wasser!!      |\n"
		"  | Kostet nur 150 Muenzen  |\n"
		"  |                         |\n"
		"  |                Mustafa  |\n"
		"  |                         |\n"
		"  `----------.  ,-----------'\n"
		"             |  |\n"
		"             |  |\n");

  AddSound(({DEFAULT_SOUND,"wind","ferne"}),
	   "Aus der Ferne hoerst Du den Wind heulen.");

  AddSmell(DEFAULT_SMELL,
	   "Der heisse Sand brennt Dir in der Nase.");

  AddCmd(({"trink","trinke"}), "trinkenfkt");
  
  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  oasen_exits(XK,YK);
}

void reset()
{
  ::reset();

  heilen=MAXHEILEN;
}

nosave int trinkenfkt(string str)
{
  int h;
  
  notify_fail(BS("Was willst Du denn woraus trinken?"));
  if(!str) return 0;

  if(str=="wasser aus see"||str=="wasser aus dem see")
    {
      if(!TP->drink_soft(TRINK, 1))
	return write(BS("Soviel kannst Du nicht auf einmal trinken!")), 1;

      if(heilen)
	{
	  heilen--;

	  write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst "
		   "Dich total erfrischt!"));

	  say(BS(TPN+" trinkt etwas Wasser aus dem See."), ({TP}));

	  h=40+random(40);

	  TP->AddHp(h);

	  write_file(LOG "oasen", CAP(getuid(TP))+" trinkt Wasser fuer "+
		     h+" Lebenspunkte. \(1\)\n");
	}
      else
	{
	  write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst "
		   "Dich etwas besser."));
   	  say(BS(TPN+" trinkt etwas Wasser aus dem See."), ({TP}));
	}

      return 1;
    }

  return 0;
}
