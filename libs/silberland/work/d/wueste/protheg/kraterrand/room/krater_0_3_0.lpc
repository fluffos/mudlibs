// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Oben am Rande des Kraters");
  SetProp(P_INT_LONG, 
          "Du befindest Dich hier am Rande eines Kraters. "
          "Hier sieht die Gegend ziemlich trostlos und verlassen aus. "
          "Bis auf ein paar verdorrte Buesche und einen kleinen Baum gibt "
          "es hier auch nichts interessantes.");

  AddDetail(({"boden","sand"}),
            "Sand, Sand, Sand, nichts als Sand!");

  AddDetail(({"krater","rand","tatsache"}),
  	TO->QueryProp(P_INT_LONG));

  AddDetail("gegend",
	    "Hier gibt es weit und breit nichts Besonderes zu sehen, bis auf "
	    "die Tatsache, dass Du Dich hier am Rand eines riesigen Kraters "
	    "befindest.");

  AddDetail(({"himmel","sonne"}),
	    "Eine strahlendblaue Sonne brennt vom Himmel herab.");

  AddDetail(({"busch","buesche","dornbuesche"}),
	    "Ein paar kleine, vertrocknete Dornbuesche stehen hier herum.");

  AddDetail("dornen",
	    "Lange, spitze Dornen ragen aus den Dornbueschen hervor...");

  AddDetail("baum",
	    "Ein alter, kleiner Baum, der allerdings noch recht kraeftige "
	    "Aeste zu besitzen scheint.");

  AddDetail(({"aeste","ast"}),
	    "Die Aeste des Baumes wachsen sonderbarerweise in den Boden "
	    "hinein und geben damit dem Baum eine aussergewoehnliche "
	    "Stabilitaet.");

  AddDetail(({"gewicht","stabilitaet"}),
	    "Dein Gewicht wuerde der Baum wohl aushalten..."
	    "Vielleicht kann man ja daran hinunterklettern...");

  AddCmd(({"kletter","klettere"}), "klettern");
  AddCmd(({"greif","greife"}), "greifen");

  AddExit("osten",      ([EX_DEST:DESERT ":69:33",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordwesten", ([EX_DEST:DESERT ":67:32",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordosten",  ([EX_DEST:DESERT ":69:32",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("norden",     ([EX_DEST:DESERT ":68:32",
                        EX_TESTFUNC: "nopewueste"]));
  
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);  
}

nosave int klettern(string str)
{
  notify_fail(BS("Wohin moechtest Du denn klettern?"));
  if(!str) return 0;

  if(str=="an baum runter"||str=="an baum herunter"||
     str=="am baum runter"||str=="am baum herunter")
    {
      write(BS("Wagemutig kletterst Du ueber den Rand des Kraters und haelst "
	       "Dich dabei an dem kleinen Baum fest. Knapp unterhalb des "
	       "Kraters bemerkst Du den Eingang zu einer kleinen Hoehle und "
	       "schwingst Dich gekonnt hinein..."));

      TP->move(ROOM "gnomhoehle",M_GO,"","schwingt sich ueber den Rand des "
	       "Kraters","schwingt sich herein");
      return 1;
    }
  else
    if(str=="runter"||str=="ueber kraterrand")
      return write(BS("Woran moechtest Du denn runterklettern?")),1;
  
  return 0;
}

nosave int greifen(string str)
{
  notify_fail(BS("Wo moechtest Du denn reingreifen?"));
  if(!str) return 0;

  if(str=="in dornen"||str=="in dornen rein"||str=="auf dornen")
    {
      write(BS("Mutig greifst Du in die Dornen, doch schon bald bezahlst Du "
	       "Deinen Mut mit einem heftigen, stechenden Schmerz."));

      say(BS(TPN+" greift voll in die Dornen und sticht sich!"), ({TP}));
      
      SetProp(P_KILL_NAME, "Ein langer, spitzer Dorn");
      
      TP->do_damage(10+random(20));
      
      return 1;
    }

  return 0;
}
