// by PROtheG

#include "../def.h"

#define MAXOBST 5
#define OBST 4

inherit MOST "std_room";

nosave int obst;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dachboden");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf dem Dachboden des Nordturmes. Der Raum "
	     "ist mit kostbaren Teppichen ausgelegt und die Waende sind mit "
	     "kostbaren Wandteppichen behaengt. In der Mitte steht ein "
	     "grosser Tisch aus Marmor, um den ein paar Sessel gereiht sind. "
	     "An einem Ende des Tisches steht ein grosser thronaehnlicher "
	     "Stuhl. Auch die Fenster des Raumes sind mit Teppichen und "
	     "Tuechern verhangen und der Raum ist dementsprechend duester."));

  AddDetail("boden",
	    "Der Boden ist mit kostbaren Teppichen ausgelegt.");

  AddDetail(({"wandteppich","wandteppiche","teppiche","teppich"}),
	    "Kostbare Teppiche in allen Farben und Mustern, liegen auf dem "
	    "Boden oder haengen an den Waenden.");

  AddDetail(({"pracht","farben","muster","farbe"}),
	    "Du kannst nur staunen ueber diese Pracht!");

  AddDetail(({"dachboden","raum","nordturm","turm"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"decke","luster"}),
	    "An der Decke haengt ein kostbarer Luster, der allerdings recht "
	    "verstaubt aussieht und anscheinend schon sehr lange nicht mehr "
	    "gebraucht wurde.");

  AddDetail("fenster",
	    "Die Fenster wurden mit Wandteppichen und Tuechern behaengt und "
	    "lassen somit kein Licht durch.");

  AddDetail("licht",
	    "Davon gibt es hier recht wenig.");

  AddDetail(({"wand","waende","tapete"}),
	    "An den Waenden haengen viele schmale Wandteppiche, die "
	    "regelrecht eine Tapete bilden, welche sogar die Fenster "
	    "verdeckt. Weiters sind wunderschoen bemalte Seidentuecher "
	    "in regelmaessigen Abstaenden an den Waenden befestigt.");

  AddDetail("abstaende",
	    "Neben jedem dritten Wandteppich haengt so ein Seidentuch.");

  AddDetail(({"seide","tuecher","seidentuecher","seidentuch"}),
	    "Du siehst Tuecher aus wertvoller Seide mit vielen Motiven, wie "
	    "die Entfuehrung aus dem Serailium, Ali Achmed und die 39 "
	    "Raeuber.");

  AddDetail(({"tuch","motive","motiv","entfuehrung","serailium","ali","achmed",
		"raeuber"}),
	    "Viele von diesen Motiven kommen Dir bekannt vor, denn Du kennst "
	    "sie aus Geschichten und Legenden von frueher.");

  AddDetail(({"geschichten","legenden","legende"}),
	    "Viele davon sind auf diesen Seidentuechern verewigt.");

  AddDetail("mitte",
	    "In der Mitte dieses sonderbaren Raumes steht ein grosser Tisch "
	    "aus massivstem Marmor umringt von einigen Sesseln, ebenfalls "
	    "aus Marmor.");

  AddDetail(({"marmortisch","tisch"}),
	    "Auf dem Tisch steht eine kleine Schuessel mit Trockenobst, "
	    "ansonsten ist der Tisch ganz normal.");

  AddDetail(({"sesseln","sessel"}),
	    "Die Sessel scheinen fuer eine groessere Gruppe von Leuten "
	    "bereitgestellt worden...");

  AddDetail(({"gruppe","leute"}),
	    "Fuer wen wohl?");

  AddDetail("marmor",
	    "Ziemlich massiver, weisser Marmor wurde fuer diesen Tisch "
	    "verwendet, wer den wohl hier heraufgetragen hat?");

  AddDetail("ende",
	    "An einem Ende des Marmortisches steht ein grosser Stuhl, der "
	    "wohl fuer jemand ganz bestimmten reserviert ist.");

  AddDetail(({"marmorstuhl","stuhl"}),
	    "Ein massiver Marmorstuhl mit allerlei Schnoerksel und "
	    "Verzierungen.");

  AddDetail(({"schnoerksel","verzierungen","verzierung","muehe"}),
	    "Da hat sich jemand ziemliche Muehe gegeben mit diesem Stuhl.");

  AddDetail("schuessel",
	    "In der Schuessel auf dem Tisch befindet sich etwas "
	    "Trockenobst.");

  AddDetail(({"treppe"}),
	    "Eine grosse Treppe fuehrt wieder nach unten.");

  AddSound(({DEFAULT_SOUND,"wind"}),
	   "Hin und wieder hoert man den Wind am Fenster vorbeiheulen.");

  AddSound("fenster",
	   "HEEUUUUULL!!");

  AddSmell(DEFAULT_SMELL, 
	   "Ein angenehmer Geruch kommt aus der Schuessel auf dem Tisch.");

  AddSmell(({"duft","trockenobst","obst","geruch"}),
	   "Der angenehme Duft von getrocknetem Obst stroemt Dir entgegen.");

  AddSpecialDetail(({"obst","trockenobst"}), "obstlook");

  AddCmd(CMD_NEHMEN, "obsttake");
  AddCmd(CMD_ESSEN, "essen_fkt");

  Licht("duester");
  Umgebung("warm", TT_HOUSE, 1);

  obst=MAXOBST;

  AddExit("unten", ROOM "nordturm");

  AddItem(NPC "barlogor",REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  obst=MAXOBST;
}

string obstlook()
{
  if(!obst)
    return "Es befindet sich im Moment kein Trockenobst in der Schuessel.\n";
  else
    return "Es befindet sich etwas Trockenobst in der Schuessel.\n";
}

nosave int obsttake(string str)
{
  int what;

  if(!str) return 0;

  if(str=="obst"||str=="trockenobst"||
     str=="obst aus schuessel"||str=="trockenobst aus schuessel")
    if(obst)
      {
	if(!TP->eat_food(OBST, 1))
	  return write(BS("Du glaubst nicht, dass Du das Obst noch "
			  "herunterbekommst...")), 1;

	what=20+random(20);

	write(BS("Du nimmst etwas Trockenobst aus der Schuessel und stopfst "
		 "es Dir in den Mund..."));

	write_file(LOG "dachboden",
		   dtime(time())+": "+CAP(getuid(TP))+
		   " kriegt heal_self\("+what+"\)\n");

	TP->heal_self(what);

	obst--;

	return 1;
      }
    else
      return write(BS("Die Schuessel ist leider leer.")), 1;

  return 0;
}

nosave int essen_fkt(string str)
{
  if(!str) return 0;

  if(str=="obst"||str=="trockenobst"||
     str=="obst aus schuessel"||str=="trockenobst aus schuessel")
    return obsttake("obst");

  return 0;
}
