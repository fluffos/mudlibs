// by PROtheG

#include "../def.h"

#define AUGE_LINKS "Amethyst"
#define AUGE_RECHTS "Rubin"

inherit MOST "std_room";

nosave int left_set, right_set;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "1 Meter vor dem Absturz");
  SetProp(P_INT_LONG,
	  BS("Du stehst hier unweit von einem riesigen Krater. Unter Dir "
	     "erstreckt sich bis in weite Ferne ein Abgrund, dessen "
	     "Ausmasse Du nicht erkennen kannst. Du raetselt, was da unten "
	     "wohl sein koennte... Schau bloss nicht zu lange hinunter, sonst "
	     "faellst Du noch runter! Weiters gibt es hier eine Menge Felsen, "
	     "aber das ist auch schon alles!"));

  AddDetail(({"krater","abgrund","kraterrand"}),
	    "Deine Finger beginnen zu jucken, bei dem Gedanken an die "
	    "Schaetze, die dort unten auf Dich warten.\nAm liebsten "
	    "wuerdest Du gleich runterspringen.");

  AddDetail(({"ausmasse","ferne"}),
	    "Der Krater streckt sich nach Nordwesten, soweit Du nur sehen "
	    "kannst.");

  AddDetail("boden",
	    "Der Boden ist hier ziemlich felsenreich, aber sonst nichts.");

  AddDetail(({"finger","gedanken","schaetze"}),
	    "Pass auf, sonst fuehren sie Dich noch in Dein Verderben!");

  AddDetail(({"verderben","tod","ecke"}),
	    "Der Tod wartet hier an jeder Ecke auf Dich!");

  AddDetail(({"vogel","himmel"}),
	    "Ach waerest Du doch ein Vogel, dann koenntest Du Dir den Himmel "
	    "ganz genau ansehen!");

  AddDetail(({"menge","felsen"}),
	    "Sehr viele Felsen liegen hier in der Gegend herum.");

  AddDetail("gegend",
	    "Ueberall in der Gegend liegen verstreut Felsen herum, manche "
	    "sogar in verrueckt anmutenden Felsformationen.");

  AddDetail(({"felsformationen","formationen"}),
	    "Nahe am Kraterrand ist eine bereits sehr stark verwitterte "
	    "Felsformation, die einer Statue nicht unaehnlich sieht!");

  AddDetail(({"felsformation","statue"}),
	    "Das war wirklich einmal eine Statue, aber die Zeit und der Sand "
	    "haben ihren Teil getan und jetzt ist davon nur noch der Kopf, "
	    "ein Arm und der Rumpf uebrig.");

  AddDetail(({"wueste","sand"}),
	    "Sand ist in der Wueste allgegenwaertig, den wird man so schnell "
	    "nicht los.");

  AddDetail(({"teil","zeit","zahn"}),
	    "Der Zahn der Zeit hat an dieser Statue genagt und nur noch "
	    "Furchen und Rillen uebriggelassen.");

  AddDetail("furchen",
	    "In den tiefen Furchen hat sich sehr viel Sand angesammelt.");

  AddDetail("rillen",
	    "Genauer betrachtet bilden die Rillen ein Muster... komisch, "
	    "dass Dir das nicht gleich aufgefallen ist.");

  AddDetail("arm",
	    "Der Arm zeigt in den Krater hinunter ... was da wohl unten "
	    "ist!?\nEin Finger haengt noch daran.");

  AddDetail("finger",
	    "Er scheint an irgendeinem Mechanismus aufgehaengt zu sein.");

  AddDetail(({"hebel","mechanismus"}),
	    "Der Finger scheint ein Hebel zu sein. Was der hier "
	    "draussen wohl zu tun hat!?");

  AddDetail("kopf",
	    "Das einzige, das man noch erkennen kann sind die beiden "
	    "Augenhoehlen.");

  AddDetail("rumpf",
	    "Der Rumpf sieht ziemlich mitgenommen aus, als ob irgendein "
	    "Tier daran seine Krallen geputzt haette.");

  AddDetail("tier",
	    "Das Tier duerfte sehr grosse Krallen gehabt haben!");

  AddDetail("krallen",
	    "Die Krallen haben tiefe Furchen und Rillen hinterlassen.");

  AddDetail("muster",
	    "Das Muster zeigt im entfernteren Sinn einen Oktaeder.");

  AddDetail("sinn",
	    "Was sollte das fuer einen Sinn haben, einen Oktaeder in so "
	    "eine Statue einzuritzen?!");

  AddDetail(({"form","oktaeder"}),
	    "Die Form erinnert Dich irgendwie an die eines Edelsteines.");

  AddDetail("edelstein",
	    "Wozu wird man hier wohl einen Edelstein brauchen?");

  AddDetail("augenhoehlen",
	    "Die Augenhoehlen haben unterschiedliche Formen, sind aber "
	    "vollkommen sandfrei, was von einer oefteren Benutzung zeugt.");

  AddDetail("formen",
	    "Das linke Auge ist ganz anders geformt, als das rechte Auge.");

  AddDetail("auge",
	    "Welches Auge? Das linke, oder das rechte?");

  AddDetail("benutzung",
	    "Wozu man diese Augenhoehlen wohl benutzen kann?!"
	    "Ob man da was reinstecken kann?");

  AddSpecialDetail("linkes auge", "linkes_auge");
  AddSpecialDetail("rechtes auge", "rechtes_auge");

  AddCmd(({"steck","stecke"}),"steckfkt");
  AddCmd(({"zieh","ziehe"}),"zieh_finger");

  AddExit("sueden", ([EX_DEST:DESERT ":68:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedwesten", ([EX_DEST:DESERT ":67:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedosten", ([EX_DEST:DESERT ":69:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("osten", ([EX_DEST:DESERT ":69:37",
                        EX_TESTFUNC: "nopewueste"]));

  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);  

  left_set=right_set=0;
}

string linkes_auge()
{
  if(left_set)
    return "In das linke Auge ist ein "+AUGE_LINKS+" eingesetzt worden.\n";
  else
    return "Das linke Auge hat eine laengliche Form.\n";
}

string rechtes_auge()
{
  if(right_set)
    return "In das rechte Auge ist ein "+AUGE_RECHTS+" eingesetzt worden.\n";
  else
    return "Das rechte Auge hat eine achteckige Form.\n";
}

nosave int zieh_finger(string str)
{
  object dummy;

  notify_fail(BS("Woran moechtest Du denn ziehen?"));
  if(!str) return 0;

  if(str=="an finger"||str=="finger"||str=="am finger")
    if(left_set && right_set)
      {
	left_set=0;
	right_set=0;
	/*
	    write("\nDu ziehst an dem Finger und vernimmst ein grauenhaftes "
		"Knacken.\nPloetzlich oeffnet sich unter Dir der Boden und "
		"Du faellst in ein\nbodenloses, schwarzes Loch...\n\n\n"
		"... und faellst ...\n\n\n"
		"... und faellst ...\n\n\n");
		TP->do_damage(50);
		TP->move(NFTAHHOEHLEGEHEIMEINGANG, M_NOSHOW);
	*/
	write(BS("Du ziehst an dem Finger...")+
	      BS("Doch ploetzlich fallen die beiden Edelsteine wieder "
		 "heraus..."));
	
	dummy=clone_object("/obj/gems/"+lower_case(AUGE_RECHTS));
	dummy->move(ME,M_NOCHECK);
	dummy=clone_object("/obj/gems/"+lower_case(AUGE_LINKS));
	dummy->move(ME,M_NOCHECK);
      }
    else
      return write(BS("Du ziehst an dem Finger ... aber nichts passiert. "
		      "Du scheinst etwas vergessen zu haben!")), 1;
  
  return 0;
}

nosave int steckfkt(string str)
{
  object ob;
  string what, where;
  
  notify_fail(BS("Was willst du wo reinstecken?"));
  if(!str) return 0;

  if(sscanf(str,"%s in %s",what,where)!=2) return 0;

  switch(where)
    {
    case "linkes auge": 
      if(ob=present(what,TP))
	if(left_set) 
	  return write(BS("Aber da ist doch schon ein "+AUGE_LINKS+
			  " eingesetzt!")), 1;
	else
	  if(ob->QueryProp(P_NAME)==AUGE_LINKS)
	    {
	      left_set=1;
	      write(BS("Vorsichtig setzt Du den "+AUGE_LINKS+" in das linke "
		       "Auge ein."));
	      ob->remove(1);
	    }
	  else
	    if(ob->id("EDELSTEIN"))
	      {
		write(BS("Vorsichtig setzt Du "+ob->name(WEN,0)+" in das "
			 "linke Auge ein, da laeuchtet es ploetzlich auf "
			 "und der Edelstein zerspringt in kleinste "
			 "Teilchen."));
		ob->remove(1);
	      }
      	    else
	      return write(BS("Aber das ist doch gar kein Edelstein!")), 1;
      else
	return write(BS("Soetwas hast Du doch gar nicht bei Dir!")), 1;
      break;

    case "rechtes auge": 
      if(ob=present(what,TP))
	if(right_set) 
	  return write(BS("Aber da ist doch schon ein "+AUGE_RECHTS+
			  " eingesetzt!")), 1;
	else
	  if(ob->QueryProp(P_NAME)==AUGE_RECHTS)
	    {
	      right_set=1;
	      write(BS("Vorsichtig setzt Du den "+AUGE_RECHTS+
		       " in das rechte Auge ein."));
	      ob->remove(1);
	    }
	  else
	    if(ob->id("EDELSTEIN"))
	      {
		write(BS("Vorsichtig setzt Du "+ob->name(WEN,0)+" in das "
			 "rechte Auge ein, da leuchtet es ploetzlich auf "
			 "und der Edelstein zerspringt in kleinste Teilchen."));
		ob->remove();
	      }
      	    else
	      return write(BS("Aber das ist doch gar kein Edelstein!")),1;
      else
	return write(BS("Soetwas hast Du doch gar nicht bei Dir!")),1;
      break;
      
    case "auge": 
      if(ob=present(what,TP))
	return write(BS("Welches Auge meinst Du denn? Das linke, oder das "
			"rechte?")), 1;
      else
	return write(BS("Soetwas hast Du doch gar nicht bei Dir!")),1;
      break;
      
    default: return 0;
    }  
  
  return 1;
}
