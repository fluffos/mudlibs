#include "../def.h"

inherit MOST "std_room";
inherit ROOM "oasen/in";

#define MAXRIPPEN 6
#define MAMPF 15

#define XK 92
#define YK 33

nosave int rippen;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Bei einer stinkenden Leiche mitten in der Wueste");
  SetProp(P_INT_LONG,
	  BS("Abrupt endet Dein Weg hier vor einem ziemlich grossen Elefanten"
	     "kadaver. Du wirst wohl um die Leiche herumlaufen muessen, um"
	     "weiterzukommen."));

  AddDetail("weg",
	    "Hier in der Wueste kann man das nicht direkt Weg nennen, aber "
	    "irgendwohin gehst Du ja!");

  AddDetail(({"leiche","elefant","kadaver","elefantenkadaver"}),
	    "Der Elefant duerfte noch nicht sehr lange tot sein, denn das "
	    "Fleisch sieht noch recht ordentlich aus. Doch es duerfte sich "
	    "bereits ein anderer an der Leiche zu schaffen gemacht haben, "
	    "denn die Bauchseite ist aufgerissen.");

  AddDetail("bauchseite",
	    "Die Bauchseite ist offen und ein paar Rippen schauen heraus.");

  AddDetail("fleisch",
	    "Das Fleisch koennte man vielleicht noch verwenden...");

  AddDetail("rippen",
	    "Ob man sich da vielleicht eine abbrechen koennte?");

  AddDetail(({"sand","boden"}),
	    "Der Boden hier in der Wueste ist ziemlich sandig, woher das "
	    "wohl kommen mag?");

  AddDetail(({"himmel","sonne"}),
	    "Die Sonne brennt herab und verursacht in der Leiche einen "
	    "bestialischen Gestank.");

  AddDetail("wueste",
	    "Wo glaubst Du denn, dass Du Dich hier befindest?");

  rippen=MAXRIPPEN;
  
  AddSound(({DEFAULT_SOUND,"wind","ferne"}),
	   "Aus der Ferne hoerst Du den Wind heulen.");

  AddSmell(({"gestank",DEFAULT_SMELL}),
	   "Dem Elefantenkadaver entstroemt ein bestialischer Gestank.");

  AddSmell(({"elefant","leiche","kadaver","elefantenkadaver"}),
	   "Die Leiche liegt noch nicht lange hier, aber sie stinkt bereits "
	   "gewaltig...");
  
  AddCmd(({"brich","breche"}), "brechenfkt");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  oasen_exits(XK,YK);
}

void reset()
{
  ::reset();

  rippen=MAXRIPPEN;
}

nosave int brechenfkt(string str)
{
  int h;
  
  notify_fail(BS("Was willst Du denn abbrechen?"));
  if(!str) return 0;

  if(str=="rippe"||str=="rippe ab")
    {
      if(!rippen)
	return write(BS("Die besten sind leider schon abgebrochen!")),1;

      if(!TP->eat_food(MAMPF, 1))
	return write(BS("Du verspuerst zur Zeit keinen grossen Hunger.")), 1;

      rippen--;

      h=35+random(40);

      TP->AddHp(h);

      write_file(LOG "oasen", CAP(getuid(TP))+" bricht der Leiche eine "
		 "Rippe fuer "+h+" Lebenspunkte heraus. \(3\)\n");

      write(BS("Mit aller Kraft brichst Du dem toten Elefanten eine Rippe ab "
	    "und beginnst daran herumzuknabbern..."));

      say(BS(TPN+" knabbert an einem grossen Stueck aus der Leiche herum."),
	  ({TP}));

      return 1;
    }

  return 0;
}
