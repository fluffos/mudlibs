// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Oben am Rande des Kraters");
  SetProp(P_INT_LONG, 
          BS("Du stehst hier am oberen Rand eines ziemlich grossen Kraters. "
	     "Von Unten stroemt etwas kaeltere Luft herauf, vielleicht bist "
	     "Du dort besser aufgehoben, als hier oben. Hier herrscht eine "
	     "ungeheure Hitze und die gnadenlose Sonne traegt auch ihren "
	     "Teil dazu bei. Irgendwas an diesem Ort kommt Dir unheimlich "
	     "vor. Verstreut liegen hier einige Kadaver, ueber die sich die "
	     "Aasgeier immer wieder hermachen."));

  AddDetail(({"rand","krater"}),
	    "Du stehst am Rand eines Kraters, dessen Ausmasse Dich in "
	    "Ehrfurcht erzittern lassen.");

  AddDetail(({"ausmasse","unten","ehrfurcht"}), 
	    "Voller Ehrfurcht blickst Du hinunter in das dunkle, bodenlose "
	    "Nichts und ploetzlich packt Dich der Gedanke runterzupringen.");

  AddDetail("nichts",
	    "Irgendwas wird da unten schon sein, aber Du kannst von hier "
	    "oben kaum etwas erkennen.");

  AddDetail("gedanke",
	    "Nun spring schon!");

  AddDetail("himmel",
	    "Blauer geht es wohl kaum!");

  AddDetail(({"teil","sonne"}),
	    "Die Sonne brennt Dir in Dein Gesicht und Du musst Dich "
	    "abwenden.");

  AddDetail("gesicht",
	    "Dein Gesicht! Was willst Du denn da gross untersuchen?!");

  AddDetail("boden",
	    "Ab und zu liegen ein paar Kadaver am Boden verstreut.");

  AddDetail("hitze",
	    "Die Hitze macht Dir schwer zu schaffen.");

  AddDetail("luft",
	    "Daraus koennte man schliessen, dass es da Unten viel angenehmer "
	    "sein koennte, als hier oben!");

  AddDetail("ort",
	    "Dieser Ort scheint die Geier magisch anzuziehen, warum wohl "
	    "all diese Kadaver hier herumliegen?!");

  AddSmell(({DEFAULT_SMELL,"tod","verwesung"}),
	   "Es riecht hier nach Tod und Verwesung, muss wohl an den Kadavern "
	   "liegen.");

  AddSound(({DEFAULT_SOUND}),
	   "Das Heulen des Windes wird ab und zu vom Kraechzen der Aasgeier "
	   "durchbrochen.");

  AddSound(({"heulen","wind"}),
	   "Das Heulen des Windes ist so ziemlich das einzige Geraeusch, "
	   "welches Du hier hoeren kannst.");

  AddSound("geraeusch",
	   "Bis auf das Heulen des Windes hoert man hier nur das Kraechzen "
	   "der Aasgeier.");

  AddSound("kraechzen",
	   "Die Aasgeier kraechzen ab und zu, wenn sie sich ueber einen "
	   "Kadaver stuerzen.");

  AddDetail("kadaver",
	    "Es scheint im moment keiner da zu sein.");

  AddDetail(({"geier","aasgeier"}),
	    "Die haben wahrscheinlich im moment etwas wichtigeres zu tun.");
  
  AddExit("sueden", ([EX_DEST:DESERT ":66:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedosten", ([EX_DEST:DESERT ":67:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedwesten", ([EX_DEST:DESERT ":65:38",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("westen", ([EX_DEST:DESERT ":65:37",
                        EX_TESTFUNC: "nopewueste"]));
  
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);
  
  AddItem(NPC "aasgeier", REFRESH_DESTRUCT);
  AddItem(OBJ "kadaver", REFRESH_DESTRUCT);
}
