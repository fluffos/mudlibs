// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Bei einer Befestigungsanlage");
  SetProp(P_INT_LONG, 
	  BS("Vor Dir erhebt sich der grosse Nordturm von Quauls Befestigungs"
	     "anlage. Gross und dunkel steht er hier am Rande des Kraters und "
	     "bewacht den Haupteingang im Sueden. Der Turm scheint voll von "
	     "Wachen zu sein, denn aus jedem Fenster hoert man Stimmen."));

  AddDetail(({"rand","krater"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"nordturm","bauwerk"}),
	    "Ein maechtiges Bauwerk, welches allen Feinden strotzen soll. "
	    "Es besteht aus grossen Steinbloecken, in die ein paar Fenster "
	    "und eine kleine Tuer eingelassen sind.");

  AddDetail(({"tuerme","turm"}),
	    "Ein maechtiges Bauwerk, welches allen Feinden strotzen soll. "
	    "Es besteht aus grossen Steinbloecken, in die ein paar Fenster "
	    "und eine kleine Tuer eingelassen sind.\n"
	    "Oder meintest Du etwa den Suedturm?");

  AddDetail("suedturm",
	    "Der steht weiter im Sueden.");

  AddDetail("boden",
	    "Der Turm spendet genug Schatten, daher ist der Boden hier nicht "
	    "so aufgeheizt wie anderswo.");

  AddDetail(({"wolke","himmel"}),
	    "Keine Wolke ist am Himmel zu sehen.");

  AddDetail("schatten",
	    "Der laesst den Aufenthalt hier etwas angenehmer erscheinen.");

  AddDetail("aufenthalt",
	    "Der ist auch so schon anstrengend!");

  AddDetail(({"anlage","befestigungsanlage"}),
	    "Quauls Haupteingang wird von einer Befestigungsanlage, "
	    "bestehend aus zwei grossen Tuermen, welche Tag und Nacht "
	    "besetzt sind, beschuetzt.");

  AddDetail(({"uhr","tag","nacht"}),
	    "Praktisch rund um die Uhr sind die Tuerme besetzt!");

  AddDetail(({"eingang","haupteingang"}),
	    "Der ist im Sueden.");

  AddDetail("feinde",
	    "Quauls Feinden wird der Eingang verwehrt.");

  AddDetail("fenster",
	    "Die Fenster sind sehr weit oben und mit Eisenstaeben "
	    "vergittert.");

  AddDetail(({"staebe","eisenstaebe"}),
	    "Die sehen ziemlich stabil aus... ein Stab faellt Dir auf...");

  AddDetail(({"stab","eisenstab"}),
	    "Er scheint etwas locker zu sein, ob man den irgendwie raus"
	    "bekommen koennte...");

  AddDetail("stimmen",
	    "Hast Du schon jemals eine Stimme gesehen??");

  AddSound(({DEFAULT_SOUND,"stimme","stimmen"}),
	   "Die Stimmen kommen aus dem Inneren des Turmes.");

  AddDetail("wachen",
	    "Die befinden sich im Turm.");

  AddDetail(({"bloecke","steinbloecke"}),
	    "Ziemlich grosse Bloecke aus Stein bilden diesen grossen Turm.");

  AddDetail("stein",
	    "Das einzige aus Stein, ist hier der grosse Nordturm.");

  AddDetail(({"steintuer","tuer"}),
	    "Eine kleine massive Steintuer mit einem kleinen, vergitterten "
	    "Guckloch.");

  AddDetail("quaul",
	    "Quaul liegt tief unten in dem Krater.");

  AddSpecialDetail(({"guckloch","loch"}),"gugug");
	    
  AddCmd(({"brich","breche","reisse","reiss","zieh","ziehe"}), "hehe");
  AddCmd(({"betrete","betritt","betret","betritte"}), "betretenfkt");

  AddExit("westen",     ([EX_DEST:DESERT ":64:34",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordwesten", ([EX_DEST:DESERT ":64:33",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedwesten", ([EX_DEST:DESERT ":64:35",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("norden",     ([EX_DEST:DESERT ":65:33",
                        EX_TESTFUNC: "nopewueste"]));

  AddExit("sueden", KARAVANE "quaulkar");

  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);
}

nosave int hehe(string str)
{
  notify_fail(BS("An was willst Du denn ziehen?"));
  if(!str) return 0;

  if(str=="stab"||str=="eisenstab"||str=="an stab"||str=="an eisenstab"||
     str=="stab heraus"||str=="eisenstab heraus")
    if(TP->QueryProp(P_RACE)=="Fee")
      return write(BS("Der Stab sitzt viel zu fest...")), 1;
    else
      return write(BS("Leider ist der Stab viel zu hoch oben und du kommst "
		      "nicht heran.")), 1;
  return 0;
}

nosave int betretenfkt(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="turm"||str=="nordturm"||str=="steinturm"||str=="anlage"||
     str=="befestigungsanlage")
    {
      write(BS("Du willst die Tuer oeffnen, doch sie scheint von innen "
	       "verbarrikadiert zu sein..."));

      call_out("gugug", 2);
      return 1;
    }

  return 0;
}

string gugug()
{
  if(TP && ENV(TP) == ME)
    {
      write(BS("Im Inneren wird man sich Deiner Neugier bewusst und man "
	       "laesst Dich herein."));
      TP->move(ROOM "nordturm", M_GO|M_NOCHECK|M_NO_SHOW);
    }

  return "";
}
