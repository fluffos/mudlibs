// by PROtheG

#include "../def.h"
#include "/d/wasser/feyaria/schiffe.h"

inherit MOST "std_room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

nosave object *angeln;
nosave int fische;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Steg mitten im Meer");
  SetProp(P_INT_LONG, 
	  BS("Der Steg endet hier abrupt im grossen Meer. Uralte Holzplanken "
	     "unter Dir aechzen, als die Wellen dagegenschlagen und der Wind "
	     "zerzaust Deine Haare. Doch das macht Dir nichts aus, denn Du "
	     "bist geblendet von dem wunderbaren Ausblick, den Du von hier "
	     "aus hast."));
  
  AddDetail(({"steg"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"planken","holzplanken","boden"}),
	    "Die uralten Holzplanken unter Dir wirken, als koennten sie "
	    "jederzeit zusammenbrechen. Du solltest lieber wieder zum "
	    "steinernen Teil des Steges zurueckkehren.");

  AddDetail(({"teil"}),
	    "Im Norden wird der hoelzerne Steg durch einen steinernen Steg "
	    "ersetzt.");

  AddDetail(({"norden","wueste"}),
	    "Nach Norden hin erstreckt sich die Wueste bis zum Horizont.");

  AddDetail(({"horizont","richtungen"}),
	    "Im Norden liegt die grosse, weite Wueste und im Sueden liegt "
	    "das grosse Meer.");

  AddDetail(({"sueden","meer","flaeche"}),
	    "Nach Sueden hin erstreckt sich ein gewaltiges Meer.");

  AddDetail(({"himmel"}),
	    "Ein beinahe grenzenlos blauer Himmel erstreckt sich in alle "
	    "Richtungen.");

  AddDetail(({"ausblick","atem"}),
	    "Der Ausblick von diesem kleinen Steg hier raubt Dir beinahe "
	    "den Atem! Eine riesige blaue Flaeche breitet sich nach Sueden "
	    "hin aus. In weiter Ferne glaubst Du hie und da ein Schiff "
	    "erkennen zu koennen.");

  AddDetail(({"wind"}),
	    "Ein kraeftiger Wind weht vom Meer her und zerzaust Deine Haare.");

  AddDetail(({"ohren"}),
	    "Der Wind heult so laut, dass Du fast nichts hoerst.");

  AddDetail(({"haare"}),
	    "Noch hat sie der Wind nicht weggeweht!");

  AddDetail(({"ferne"}),
	    "Das Meer ist riesig, da wird in der Ferne schon mal ein Schiff "
	    "vorbeifahren.");

  AddDetail(({"schiff","schiffe"}),
	    "Vielleicht haelt ja hier eins der Schiffe am Steg.");

  AddDetail(({"salzwasser","wasser"}),
	    "Das Salzwasser unter Dir wirkt ziemlich truebe.");

  AddDetail(({"wellen"}),
	    "Die Wellen sind hier recht niedrig, sonst wuerden sie Dich "
	    "wohl von dem niedrigen Steg herunterspuelen ;)");

  AddSound(({DEFAULT_SOUND}),
	   "Der Wind heult Dir um die Ohren und das Wasser blubbert unter "
	   "Dir, Du hoerst ansonsten beinahe gar nichts!");

  AddSound(({"meer","wellen","rauschen","wasser","blubbern"}),
	   "Das Rauschen und Blubbern des Meeres unter Dir beruhigt Dich "
	   "vollkommen.");

  AddSmell(({DEFAULT_SMELL, "steg","fisch","fische"}),
	   "Es riecht teilweise recht streng nach Fisch, den Steg entlang.");

  angeln=({});
  fische=10+random(5);

  AddExit("norden", "zurueck aufs Festland#" ROOM "hafen");
  
  Licht("sehr_hell");
  Umgebung("heiss", TT_HOUSE, 1);

  AddItem(KUESTENSEGLER, REFRESH_DESTRUCT, 1);
  AddItem(GALEERE,       REFRESH_DESTRUCT, 1);
  
  AddCmd(({"bade","steige","steig","schwimme","schwimm","springe","spring"}),
	 "springenfkt");
  AddCmd(({"angle","angel"}), "angelfkt");
}

void reset()
{
  ::reset();

  fische=10+random(5);
}

nosave int springenfkt(string str)
{
  notify_fail(BS("Wohin willst Du denn schwimmen?"));
  if(!str) return 0;

  if(str=="in meer"||str=="ins meer"||str=="in das meer"||
     str=="auf das meer"||str=="aufs meer"||
     str=="auf das meer hinaus"||str=="aufs meer hinaus")
    return write(BS("In letzter Minute beschliesst Du, es doch zu lassen!")),1;
  
  return 0;
}

// uebernommen aus /d/huegelland/zordan/fischerweg/room/a6a7.c

nosave int angelfkt(string str) 
{
  notify_fail(BS("Worin genau moechtest Du angeln?"));

  if(member(({"meer","in meer","mit angel in meer","im meer",
		"mit angel im meer"}), str)==-1) return 0;

  if(!present("angel", TP)) 
    return notify_fail(BS("Aber Du hast ja gar keine Angel bei Dir!")), 0;
  
  if(member(angeln, TP) > -1 )
    return write(BS("Aber Du angelst doch schon!")), 1;
  
  write(BS("Du wirfst die Angel in hohem Bogen ins Meer aus."));

  say(BS(CAP(TP->Name())+" wirft "+TP->QueryPossPronoun(FEMALE,WEN)+
	 " Angel in hohem Bogen ins Meer aus."));

  angeln+=({TP});

  call_out("angelfkt2", 5+random(5), TP);
  return 1;  
}

void angelfkt2(object who) 
{
  object ob;

  angeln-=({who});

  if(!objectp(who)) return;

  if(!present(who)) return;

  if(!random(2) || fische <1) 
    { 
      tell_object(who, 
		  BS("Nach einiger Zeit wird es Dir zu lange und Du holst die "
		     "leere Angel wieder ein."));
      tell_room(TO, 
		BS(CAP(who->Name())+" holt eine leere Angel wieder ein."), 
		({who}));
      return;
    }
  
  fische--;
  
  tell_object(who, 
	      BS("Ploetzlich spuerst Du, wie es an der Angel zuckt.")+
	      BS("Es hat doch tatsaechlich ein Fisch angebissen, den Du "
		 "gekonnt an Land ziehst."));

  tell_room(TO, BS(CAP(who->Name())+" hat einen Fisch gefangen!"), ({who}));

  ob=clone_object(OBJ "fisch");

  if(ob) 
    ob->move(ME,M_NOCHECK);
  else 
    write(BS("Im letzten Moment springt Dir der Fisch vom Haken."));

  return;
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
