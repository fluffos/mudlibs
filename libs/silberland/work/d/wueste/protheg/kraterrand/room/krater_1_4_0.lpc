// by PROtheG

#include "../def.h"

#define MAXSCHLANGE 3;

inherit MOST "std_room";

nosave int schlange;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Oben am Rande des Kraters");
  SetProp(P_INT_LONG, 
	  "Du befindest Dich hier am Rande eines Kraters. "
	  "Hier sieht die Gegend ziemlich trostlos und verlassen aus. "
	  "Bis auf ein paar verdorrte Buesche gibt es hier auch nichts "
	  "interessantes.");

  AddDetail("boden",
	    "Der Boden ist uebersaet mit Sand sonst nichts.");

  AddDetail("sand",
	    "Sand! Sand! Sand! Sand! Ueberall nur Sand!!");

  AddDetail(({"himmel","sonne"}),
	    "Die Sonne brennt Dir in die Augen und Du wendest Deinen Blick "
	    "ab.");

  AddDetail(({"blick","augen","punkte"}),
	    "Du siehst lauter kleine Punkte...");

  AddDetail("gegend",
	    "Hier gibt es nur den Krater, ein paar Buesche und Sand, sonst "
	    "nichts.");

  AddDetail("krater",
	    "Westlich von Dir erstreckt sich ein riesiger Krater.");

  AddDetail("rand",
	    "Du stehst hier am Rand eines riesigen Kraters.");

  AddDetail(({"buesche","spender","schattenspender"}),
	    "Einige ziemlich vertrocknete Buesche stehen hier herum. Sie "
	    "werden oft von kleineren Tieren als Schattenspender "
	    "verwendet.");

  AddDetail("tiere",
	    "Meistens Schlangen, Insekten oder irgendwelche Reptilien.");

  AddDetail(({"reptilien","insekten"}),
	    "Viele kleine Tiere leben hier in der Wueste.");

  AddDetail("wueste",
	    "Du befindest Dich mitten in ihr...");

  AddSpecialDetail("schlangen","snake");  

  schlange=MAXSCHLANGE;

  AddExit("osten",     ([EX_DEST:DESERT ":70:34",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedosten", ([EX_DEST:DESERT ":70:35",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordosten", ([EX_DEST:DESERT ":70:33",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("norden",    ([EX_DEST:DESERT ":69:33",
                        EX_TESTFUNC: "nopewueste"]));
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);  
}

void reset()
{
  ::reset();

  schlange=MAXSCHLANGE;
}

nosave string snake()
{
  object snake;
  
  if(schlange && ((ENV(TP)) == ME) && !present("\nschlange"))
    {
      snake=clone_object(NPC "schlange");
      snake->move(ME,M_NOCHECK);
      snake->Kill(TP);

      schlange--;

      return BS("Du untersuchst einen Busch naeher, doch ploetzlich greift "
		"Dich eine Schlange an...");
    }
  else
    return BS("Viele kleine Tiere leben hier in der Wueste.");
}
