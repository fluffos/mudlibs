// by PROtheG

#include "../def.h"

#define MAXSCHLANGE 3;
#define ANSCHLUSSRAUM "/d/wueste/gwenshara/estadt/room/basari/basari_2x1"

inherit MOST "std_room";

nosave int schlange;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einer gewaltigen Treppe");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich hier auf einem grossen, steinernen Platz, von "
	     "dem aus eine gewaltige Treppe hinab in den Krater fuehrt. "
	     "Einige Leute tummeln sich auf dem Platz, doch keiner scheint "
	     "Dir Beachtung zu schenken. Was sich wohl am Fusse der Treppe "
	     "befinden mag..."));

  AddDetail("boden",
	    "Der Boden besteht aus einem eigenartigen Stein, der sich "
	    "angenehm kuehl anfuehlt, trotz der heissen Sonne.");

  AddDetail(({"stein","steinplatte","platte"}),
	    "Der ganze Platz scheint aus einer einzigen, seltsam geformten "
	    "Steinplatte zu bestehen. Obwohl alles von Sand bedeckt ist, kann "
	    "man an einigen Stellen bestimmte Zeichen erkennen.");

  AddDetail("stellen",
	    "An einigen Stellen der Steinplatte ist weniger Sand und man "
	    "kann merkwuerdige Zeichen erkennen.");

  AddDetail("zeichen",
	    "Du wirst aus den Zeichen nicht schlau, es duerfte sich wohl um "
	    "sehr alte Zeichen handeln.");

  AddDetail("platz",
	    QueryProp(P_INT_LONG));

  AddDetail("sand",
	    "Der Sand, der von den vielen Leuten aus der offenen Wueste hier "
	    "her gebracht wird, ueberdeckt den Platz fast vollstaendig.");

  AddDetail("wueste",
	    "Du befindest Dich hier mitten in der Wueste an einer grossen "
	    "Treppe die irgendwo hinunter fuehrt...");

  AddDetail("treppe",
	    "Eine Treppe aus maechtigen, steinernen Bloecken fuehrt hinab in "
	    "den grossen Krater...");

  AddDetail(({"bloecke","steinbloecke","quader"}),
	    "Grosse Quader wurden hier zum Bau dieser Treppe verwendet. Du "
	    "wunderst Dich, wer sie wohl gebaut haben mag.");

  AddDetail("bau",
	    "Der Bau duerfte schon laenger zurueckliegen, denn die Quader "
	    "scheinen schon sehr lange der Witterung ausgesetzt zu sein.");

  AddDetail("witterung",
	    "Die Witterung ist hier in der Wueste besonders stark, da der "
	    "Wind und der Sand an allem \"arbeiten\".");

  AddDetail(({"wind","sand"}),
	    "Der Wind und der Sand sind hier in der Wueste Dein groesster "
	    "Feind!");

  AddDetail(({"feind","feinde"}),
	    "Natuerlich gibt es in der Wueste noch andere Feinde, aber die "
	    "sind meistens gut versteckt.");

  AddDetail("krater",
	    "Was wohl da unten sein mag? Geruechten zufolge soll dort eine "
	    "Stadt liegen...");

  AddDetail(({"stadt","quaul"}),
	    "Unten in diesem Krater soll sich die Stadt Quaul befinden, die "
	    "fuer ihre Sagen und Mythen beruehmt ist...");

  AddDetail(({"sagen","mythen"}),
	    "Viel wird erzaehlt ueber die Stadt Quaul und deren Einwohner.");

  AddDetail("beachtung",
	    "Die Leute scheinen alle ziemlich beschaeftigt zu sein und "
	    "schenken Dir keine Beachtung...");

  AddDetail(({"einwohner","echsenwesen","wesen"}),
	    "Quauls Einwohner sollen Echsenwesen sein.");

  AddDetail("himmel",
	    "Kein einziges Woelkchen ist zu erkennen, nur die Sonne, die Dir "
	    "erbarmungslos in die Augen brennt.");

  AddDetail(({"sonne","augen"}),
	    "Du reibst Dir Deine brennenden Augen...");

  AddDetail("woelkchen",
	    "Wo bitte siehst Du da Woelkchen??");

  AddDetail("leute",
	    "Einige Leute tummeln sich hier auf dem Platz herum und alle "
	    "gehen die Treppen hinab, bzw kommen gerade herauf. Was da "
	    "wohl unten ist?");

  AddDetail("fuss",
	    "Ja, genau Du hast mindestens einen Fuss!");

  AddDetail(({"schild","holzschild"}),
	    "Das Holzschild besagt, dass die Treppe nach Quaul "
	    "voruebergehend gesperrt ist.");

  AddReadDetail(({"schild","holzschild"}),
		"Das Holzschild besagt, dass die Treppe nach Quaul "
		"voruebergehend gesperrt ist.");

  AddSpecialDetail("versteck","snake");
  
  AddExit("westen", KARAVANE "quaulkar");
  AddExit("treppe", ([EX_DEST:ANSCHLUSSRAUM, EX_MSG:"die Treppe hinunter"]));  
  
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);

  schlange=MAXSCHLANGE;
}

void reset()
{
  ::reset();

  schlange=MAXSCHLANGE;
}

nosave string snake()
{
  object snake;
  
  if(schlange && ((ENV(TP)) == ME) && !present("\nschlange"))
    {
      snake=clone_object(NPC "schlange");
      snake->move(ME,M_NOCHECK);
      snake->Kill(TP);

      schlange--;

      return "Du untersuchst ein moegliches Versteck und ploetzlich greift "
	"Dich eine Schlange an...\n";
    }
  else
    return "Anscheinend sind sie doch sehr gut versteckt...\n";
}
