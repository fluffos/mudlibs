/*
  Questraum fuer Nftahgrab
  by PROtheG
*/

#include "../def.h"

inherit MOST "std_room";

#define BSA(x) break_string(x, 78, "",1)
#define QUESTKEY "Das namenlose Nftahgrab"

nosave int grabplatte, gruft;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Friedhof in der Wueste");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einer mit Grabsteinen uebersaeten Flaeche, "
	     "mitten in der Wueste. Dieser Teil des Friedhofes scheint etwas "
	     "exklusiver zu sein, denn hier stehen ueberall groessere Gruften "
	     "zwischen den Graebern herum. Eine besonders grosse Gruft steht "
	     "sogar ganz in Deiner Naehe."));

  AddDetail("boden",
	    "Der sandige Boden ist hier ziemlich festgetreten, anscheinend "
	    "wird dieser Friedhof oft besucht.");

  AddDetail("himmel",
	    "Die Sonne brennt erbarmungslos auf Dich hernieder.");

  AddDetail("sonne",
	    "Du schaust kurz auf, wendest aber Deinen Blick sofort wieder "
	    "ab.");
  
  AddDetail("blick",
	    "Sooft solltest Du da nicht raufschaun!");
  
  AddDetail("flaeche",
	    QueryProp(P_INT_LONG));
  
  AddDetail("wueste",
	    "Und wo glaubst Du Dich hier sonst zu befinden?");

  AddDetail(({"nftahfamilien","teil","friedhof"}),
	    "Dieser Teil des Friedhofes scheint fuer die groesseren "
	    "Nftahfamilien reserviert zu sein.");

  AddDetail(({"grabsteine","graeber"}),
	    "Die Graeber sehen schon recht mitgenommen aus. Jedes ist mit dem "
	    "Wappen der Familie geschmueckt, um die Angehoerigkeit des "
	    "Grabes, oder der Gruft zu sichern.");

  AddDetail(({"angehoerigkeit","nftah"}),
	    "Jeder Nftah gehoert einer bestimmten Familie an, der er "
	    "bis in den Tod treu ergeben ist und auf seine Herkunft ist "
	    "ein jeder Nftah stolz.");

  AddDetail("tod",
	    "Die Nftah sind bekannt dafuer, dass sie, wenn es notwendig ist, "
	    "bis in den Tod kaempfen, deswegen gibt es hier wohl so viele "
	    "Graeber.");

  AddDetail("herkunft",
	    "Die Nftah sind sehr stolz auf ihre Herkunft und achten sehr "
	    "auf ihre Familien.");

  AddDetail(({"familie","familien"}),
	    "Die Familien und deren Angehoerigkeit ist fuer die Nftah "
	    "sehr wichtig. Jede Familie hat ihr eigenes Wappen, durch das "
	    "sie eindeutig gekennzeichnet ist.");

  AddDetail(({"familienwappen","wappen","nftahwappen"}),
	    "Welches Wappen meinst Du denn ... vielleicht das einer "
	    "speziellen Familie?");

  AddDetail(({"ngohafamilienwappen","ngoha","ngohawappen","wappen der ngoha",
		"ngoha wappen","wappen der ngohafamilie",
		"ngoha familienwappen"}),
  	    "Du suchst eine Weile herum und findest dann ein paar "
	    "der Ngohafamiliengraeber. Sie liegen, wie nicht anders zu "
	    "erwarten, gleich neben der grossen Ngohagruft.");

  AddDetail(({"ngohagraeber","ngohafamiliengraeber","namen"}),
	    "Du siehst hier vier Graeber der Ngohafamilie. Du versuchst die "
	    "Namen zu entziffern: Nftah Grolog Ngoha, Nftah Fanglor Ngoha, "
	    "Nftah Nahalor Ngoha... den letzten Namen kannst du leider nicht "
	    "entziffern... Der Sand hat die Grabplatte total glatt "
	    "geschliffen.");

  AddDetail("naehe",
	    "Gleich daneben.");

  AddDetail(({"grolog","fanglor","nahalor"}),
	    "Das scheinen die Namen, der hier beerdigten Nftah zu sein.");

  AddDetail(({"ngoha","ngohafamilie"}),
	    "Ja, das ist die Familie, deren Graeber du suchen sollst...");

  AddDetail("sand",
	    "Der Sand ist hier in der Wueste allgegenwaertig. In Verbindung "
	    "mit dem Wind, wirkt er wie ein rauhes Schleifpapier.");

  AddDetail(({"wind","verbindung","papier","schleifpapier"}),
	    "Der Wind und der Sand wirken auf die Grabsteine wie "
	    "Schleifpapier, denn mit der Zeit werden die Grabsteine alle "
	    "glattgeschliffen.");

  AddDetail(({"zeit","weile"}),
	    "Alles dauert nunmal eine gewisse Zeit...");

  AddDetail(({"grab","gruft","gruefte","gruften"}),
	    "Hier liegen sehr viele Graeber und Gruften in allen Formen und "
	    "Groessen, meinst Du vielleicht ein bestimmtes? Vielleicht eines, "
	    "einer bestimmten Familie?");

  AddDetail(({"groesse","form","formen","groessen"}),
	    "Es gibt grosse, kleine und sogar winzige Gruften und Graeber aus "
	    "Marmor, Granit, manche sechseckig, manche achteckig. Die Nftah "
	    "haben hier wohl keine genauen Formen festgelegt.");

  AddDetail(({"sockel","platte","marmorplatte"}),
	    "Der Sockel besteht aus einer achteckigen Marmorplatte, welche "
	    "verhindern soll, dass die Gruft im Sand versinkt.");

  AddDetail("marmor",
	    "Dieser Marmor ist vollkommen weiss, entweder hat ihn der Wind "
	    "glattgeschliffen, oder es ist ein besonders teurer Marmor.");

  AddDetail(({"stein","granit"}),
	    "Harter Granit!");

  AddDetail("dach",
	    "Das ganze steinerne Dach ruht auf acht Saeulen, um die Ruhe der "
	    "Toten in der Gruft zu bewahren.");

  AddDetail(({"saeulen","mitte"}),
	    "Sie sind kreisrund und aus Stein. In der Mitte hat jede Saeule "
	    "ein Familienwappen. Komisch an einer Saeule ist das Wappen "
	    "leicht schraeg.");

  AddDetail("saeule",
	    "Das Wappen neigt sich etwas nach rechts, das scheint absichtlich "
	    "so zu sein. Vielleicht ist da ein verborgener Mechanismus?");

  AddDetail("mechanismus",
	    "Ob sich das Wappen irgendwie bewegen laesst?");

  AddDetail("tote",
	    "Irgendwie muessen sie doch hineingebracht werden.");

  AddSpecialDetail("grabplatte","grabplattenfkt");

  AddSpecialDetail(({"gebaeude","ngohagruft","ngoha gruft","gruft der ngoha",
		       "ngohafamiliengruft","gruft der familie ngoha"}),
		   "gruftfkt");

  AddSmell(({DEFAULT_SMELL,"moder"}),
           "Es riecht ein wenig nach Moder, aber gehoert das nicht zu einem "
           "richtigen Friedhof dazu.");

  AddSmell("friedhof",
           "Es riecht nach typisch nach Friedhof.");

  AddSound(DEFAULT_SOUND, 
           "Bis auf ein kleines Lueftchen, herrscht hier eine Grabesstille.");

  AddSound("lueftchen",
           "Sei froh, dass es hier so ruhig ist, normalerweise herrschen hier "
	   "die schlimmsten Stuerme.");

  AddSound(({"sturm","stuerme"}),
	   "Wenn hier ein Sturm herrschen wuerde, koenntest Du doch wohl "
	   "kaum dem Lueftchen lauschen, oder?");

  AddSound(({"grabesstille","stille"}),
           "Hier herrscht beinahe absoulte Stille.");

  AddCmd(({"ziehe","zieh","drueck","druecke"}), "nixda");
  AddCmd(({"drehe","dreh"}), "gruft");
  AddCmd(({"saeuber","saeubere","wisch","feg","wische","fege","putze","putz"}),
	 "putzen");
  AddCmd(({"meissel","meissle","meissele"}), "meisseln");
  //AddCmd(({"wirf","werfe","leg","lege","lass"}), "schatzweg");
  
  AddGuardedExit("osten",     ROOM "krater_0_3_0", 
		 "\nunhold", "Der Unhold laesst Dich nicht vorbei!\n");
  AddGuardedExit("westen",    ROOM "krater_0_1_0", 
		 "\nunhold", "Der Unhold laesst Dich nicht vorbei!\n");
  AddGuardedExit("nordwesten",DESERT ":66:32", 
		 "\nunhold", "Der Unhold laesst Dich nicht vorbei!\n");
  AddGuardedExit("nordosten", DESERT ":68:32", 
		 "\nunhold", "Der Unhold laesst Dich nicht vorbei!\n");
  AddGuardedExit("norden",    DESERT ":67:32", 
		 "\nunhold", "Der Unhold laesst Dich nicht vorbei!\n");

/*  
    AddExit("nordwesten", ([EX_DEST:DESERT ":66:32",
                            EX_TESTFUNC: "nopewueste"]));
    AddExit("nordosten",  ([EX_DEST:DESERT ":68:32",
                            EX_TESTFUNC: "nopewueste"]));
    AddExit("norden",     ([EX_DEST:DESERT ":67:32",
                            EX_TESTFUNC: "nopewueste"]));
*/
  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);
  
  grabplatte=0;
  gruft=0;
}

nosave int putzen(string str)
{
  notify_fail(BS("Was willst du denn abputzen?"));
  if(!str) return 0;

  if(str=="grabplatte"||str=="platte"||str=="grabplatte ab"||str=="platte ab"||
     str=="sand weg"||str=="sand ab"||str=="sand von platte ab"||
     str=="sand von grabplatte ab"||str=="sand von platte weg"||
     str=="sand von grabplatte weg")
    {
      if(!present("\ngrab_quest_item",TP))
	return notify_fail(BS("Dich graut bei dem Gedanken, an einem Grab "
			      "herumzufummeln.")), 0;

      if(grabplatte)
	return write(BS("Die Grabplatte ist bereits vor kurzem geputzt "
			"worden.")), 1;

      write(BS("Mit einem gekonnten Wink fegst Du den Sand von der "
	       "Grabplatte, aber der Name ist trotzdem nicht lesbar. "
	       "Du wirst ihn wohl, oder uebel neu einmeisseln muessen!"));
      say(BS(TPN+" fummelt ein wenig an einem Grab herum."), ({TP}));

      grabplatte=1;

      return 1;
    }
  return 0;
}

nosave int meisseln(string str)
{
  string n;
  object qi;
  
  notify_fail(BS("Wenn Du weisst welchen, dann kannst Du ja versuchen den "
		 "_kompletten_ Namen einzumeisseln mit \'meissle name ein\'."));
  if(!str) return 0;
  
  if(sscanf(str, "nftah %s ngoha ein", n)==1||
     sscanf(str, "nftah %s ngoha", n)==1)
    {
      if(!qi=present("\ngrab_quest_item",TP))
	return write(BS("Dich graut bei dem Gedanken, an einem Grab "
               "herumzufummeln.")), 1;

      if(!grabplatte)
	return write(BS("Die Grabplatte ist viel zu schmutzig, man sollte sie "
	       "erst reinigen, bevor man da etwas einmeisseln will.")),1;

      if(n!=qi->QueryNftahName())
	return write(BS("Was? "+n+" soll der richtige Name sein? Irgendwie "
               "bist Du davon nicht ueberzeugt.")), 1;
      
      if(!qi->QueryStat("gefunden"))
	return write(BS("Woher weisst Du denn den Namen? Einfach drauflos"
               "haemmern bringt ja keine fp, also los geh! und "
               "finde heraus, warum er so heisst wie er heisst!")),1;
      
      if(qi->QueryStat("gemeisselt"))
	return write(BS("Aber Du hast doch bereits den Namen in den Stein "
               "eingemeisselt!")),1;
      
      n=regreplace(CAP(n), "[A-Za-z]", "&...",1);
      write(BSA("Du kniest Dich hin, setzt Deinen Meissel an und haemmerst "
		"drauf los...\n"
		"   N...f.<klink>..t...a<klonk>...h\n"
		"   "+n+"\n"
		"   N...g.<aua, auf den Finger>..o...h...a...\n"
		"Als Du mit Deiner Arbeit fertig bist, betrachtest Du Dein "
		"Werk und kommst zu dem Schluss, das das Grab nun wieder "
		"recht ordentlich aussieht. Vielleicht solltest Du es "
		"Barlogor mitteilen, dass Du fertig bist.\n"));

      say(BS(TPN+" zueckt Hammer und Meissel und bearbeitet damit "
	     "einen Grabstein. Als "+TP->QueryPronoun()+" damit fertig ist, "
	     "betrachtet "+TP->QueryPronoun()+" stolz "+
	     TP->QueryPossPronoun(NEUTER,WEN)+" Werk."));
      
      qi->SetStat("gemeisselt");
      
      return 1;
    }
  else 
    return notify_fail(BS("Du musst den kompletten Namen einmeisseln!")), 0;
}

void reset()
{
  ::reset();
  
  if(gruft) 
    tell_room(TO, BS("Du hoerst ein leises Klick."));

  if(grabplatte) 
    tell_room(TO, BS("Ploetzlich weht eine kurze Windboe alles mit Sand zu!"));

  grabplatte=0;
  gruft=0;      

  RemoveDetail(({"spalt","eingang","steinplatte"}));

  RemoveCmd(({"schluepfe","schluepf","kriech","krieche","zwaenge","zwaeng"}));
}

nosave int nixda(string str)
{
  notify_fail(BS("Was willst Du denn ziehen bzw. druecken?"));
  if(!str) return 0;
  
  if(str=="wappen"||str=="an wappen"||
     str=="ngohawappen"||str=="an ngohawappen")
    return write(BS("Das Wappen bewegt sich kein Stueck.")), 1;
  
  return 0;
}

nosave void oeffne_sesam()
{
  if(gruft) return;
  
  gruft=1;
  
  AddDetail("spalt",
	    "Ob man sich durch den hindurchzwaengen koennte?");
  AddDetail(({"steinplatte","eingang"}),
	    "Eine schwere Steinplatte bildet den Eingang zur "
	    "Ngohagruft.");
  
  AddCmd(({"schluepfe","schluepf","kriech","krieche","zwaenge","zwaeng"}), 
	 "zwaengen");
}

nosave int gruft(string str)
{
  if(!str) return 0;

  if(str=="wappen"||str=="an wappen"||
     str=="ngohawappen"||str=="an ngohawappen"||
     str=="ngohafamilienwappen"||str=="an ngohafamilienwappen")
    {
      if(gruft)
	return write(BS("Das Wappen wurde bereits gedreht.")), 1;
      
      oeffne_sesam();
      
      return write(BS("Ein kleines Klick ertoent und ploetzlich gleitet eine "
		      "Steinplatte auf die Seite und legt einen kleinen Spalt "
		      "frei.")),1;
    }
  return 0;
}

nosave int zwaengen(string str)
{
  notify_fail(BS("Wo willst Du Dich hindurchzwaengen?"));
  if(!str) return 0;
  
  if(str=="spalt"||str=="spalte")
    return write(BS("Willst Du den Spalt zwaengen, oder dich durch den "
           "Spalt zwaengen?")), 1;
  
  if(str=="durch spalt"||str=="in spalt"||str=="durch spalt hindurch"||
     str=="durch spalte"||str=="in spalte"||str=="durch spalte hindurch"||
     str=="in spalt hinein"||str=="in spalte hinein")
    {
      write(BS("Der Spalt ist recht schmal, doch die Steinplatte kann man "
	       "muehelos bewegen, deswegen hast Du keine Probleme "
	       "hineinzugelangen."));
      
      TP->move(ROOM "gruft",M_GO,"","verschwindet lautlos","kommt an");
      
      return 1;
    }
  return 0;
}

nosave string grabplattenfkt()
{
  object qi;

  if(qi=present("\ngrab_quest_item",TP))
    {
      if(qi->QueryStat("gemeisselt"))    
	return BS("Du hast die Grabplatte vor kurzem geputzt und den "
		  "Namen Nftah "+CAP(qi->QueryNftahName())+
		  " Ngoha eingemeisselt wurde.");
      else
	if(grabplatte)
	  return BS("Bei einem weiteren Blick erkennst Du, dass die "
		    "Grabplatte vor einiger Zeit geputzt wurde, doch "
		    "der Name ist trotzdem nicht lesbar.");
    }
  else
    if(grabplatte)    
      return BS("Bei einem weiteren Blick erkennst Du, dass die Grabplatte "
		"vor einiger Zeit geputzt wurde, doch der Wind hat bereits "
		"einen Grossteil wieder zugeweht.");
  
  return BS("Der Sand hat hier ganze Arbeit geleistet. Die Grabplatte ist "
	    "ueber und ueber mit Sand bedeckt, man kann nicht einmal "
	    "erkennen, ob da etwas steht oder nicht. Vielleicht kann man "
	    "den Sand ja irgendwie loswerden?");
}

nosave string gruftfkt()
{
  return 
    BS("Die Ngoha scheinen eine ziemlich reiche Familie zu sein, denn die "
       "Gruft scheint riesig zu sein. Sie besteht aus einem achteckigen "
       "Sockel auf dem ein zylinderfoermiges Gebaeude aus Stein ruht. Das "
       "ebenfalls achteckige Dach wird von acht Saeulen gehalten. "+
       (gruft ? 
	"Eine Steinplatte an der Seite weist einen Spalt auf, durch den "
	"man sicher hineingelangen koennte.":
	"Du kannst keinen Eingang entdecken, aber irgendwie muessen die Toten "
	"doch dort bestattet werden..."));
}

public int QueryGeputzt()
{
  return grabplatte;
}
