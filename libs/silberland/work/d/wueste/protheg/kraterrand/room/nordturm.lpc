// by PROtheG

#include "../def.h"

inherit MOST "std_room";

#define MAXGELD 2000
#define MAXFACKELN 2

nosave int geld, pause, fackeln;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem kleinen Turm");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich nun im Inneren des grossen Turmes. Die "
	     "Wachen haben sich hier anscheinend ein recht gemuetliches "
	     "Stuebchen eingerichtet. In der Mitte des Raumes steht ein "
	     "grosser Holztisch, der wohl zum Kartenspielen verwendet "
	     "wird, an der Wand stehen einige Schraenke und eine Steintreppe "
	     "schlaengelt sich an der Wand entlang hinauf auf den "
	     "Dachboden."));

  AddDetail(({"turm","raum","stuebchen","inneres"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"boden","fussboden"}),
	    "Der Boden besteht aus vielen kleinen Steinkacheln, in deren "
	    "Ritzen sich Unmengen von Sand befindet.");

  AddDetail(({"ritze","ritzen"}),
	    "Die Ritzen sind voller Sand! Du kannst sie kaum erkennen.");

  AddDetail(({"kacheln","steinkacheln"}),
	    "Diese Steinkacheln sollen eine Art Fussboden darstellen, "
	    "jedenfalls scheinen sie dafuer einmal gemacht worden zu sein.");

  AddDetail(({"wand","waende"}),
	    "Die Waende bestehen aus schmucklosen Steinquadern. Ein paar "
	    "Schraenke stehen angelehnt und eine kleine Treppe schlaengelt "
	    "sich an der Wand entlang auf den Dachboden.");

  AddDetail(({"steinquader","quader"}),
	    "Massive Steinquader!! Wer sie wohl verwendet hat, um diesen "
	    "Turm zu bauen?");

  AddDetail(({"treppe","steintreppe"}),
	    "Sie fuehrt nach oben!");

  AddDetail("wache",
	    "Keine Wache anwesend?? Wo mag sie bloss sein?!");

  AddDetail("schraenke",
	    "Schraenke aus massivem Holz, doch leider sehen sie alle "
	    "versperrt aus.");

  AddDetail("schrank",
	    "Welchen Schrank meinst Du denn?");

  AddDetail("sand",
	    "Ab und zu traegt eine Windboee etwas Sand durch eines der "
	    "Fenster.");

  AddDetail("fenster",
	    "Die vergitterten Fenster bringen etwas Licht in diesen sonst "
	    "dunklen Raum.");

  AddDetail("licht",
	    "Das einzige Licht in diesem Raum kommt durch die Fenster und "
	    "von der Fackel, die am Fuss der Treppe befestigt ist.");

  AddDetail("fackel",
	    "Die Fackel ist wohl fuer den, der die Treppe erklimmen will.");

  AddDetail("fuss",
	    "Am Fuss der Treppe ist eine Fackel befestigt worden.");

  AddDetail(({"sandsturm","sturm","windboe","windboee"}),
	    "Draussen herrscht wohl wieder ein kleiner Sandsturm...");

  AddDetail("dachboden",
	    "Ueber die Treppe gelangt man nach oben auf den Dachboden. Was "
	    "da wohl ist?");

  AddDetail("decke",
	    "Die Decke hat bis auf das Treppenloch nichts Besonderes an "
	    "sich.");

  AddDetail("mitte",
	    "Ein grosser Holztisch steht in der Mitte.");

  AddDetail("unmengen",
	    "Ganz viel Sand!");

  AddDetail("treppenloch",
	    "Die Treppe fuehrt durch dieses Treppenloch nach oben auf den "
	    "Dachboden.");

  AddDetail("loch",
	    "Loch? Welches meinst Du denn?");

  AddDetail("holz",
	    "Wahrscheinlich ist das Palmenholz, denn andere Arten von "
	    "Baeumen wachsen in diesem Teil der Wueste nicht.");

  AddDetail(({"arten","baeume","palmen"}),
	    "Palmen sind die einzigen Baeume hier in diesem Wuestenteil.");

  AddDetail("wueste",
	    "Wo glaubst Du denn, wo Du Dich hier befindest?");

  AddDetail(({"umgebung","teil","wuestenteil"}),
	    "In der naeheren Umgebung waechst nichts anderes, ausser "
	    "Palmen.");

  AddDetail("palmenholz",
	    "Palmenholz ist ein auesserst hartes und widerstandsfaehiges "
	    "Holz und wird gern fuer massive Schraenke verwendet.");

  AddDetail(({"tisch","holztisch"}),
	    "Ein recht massiver Holztisch steht hier. Auf ihm liegt ein "
	    "Stapel Karten und ein kleiner Becher mit Wuerfeln.");

  AddDetail(({"kartenspielen","karten"}),
	    "Ob Du wohl mitspielen darfst?");

  AddDetail("stapel",
	    "Ein Stapel Karten liegt auf dem Tisch.");

  AddDetail("becher",
	    "Ein kleiner, mit Wuerfeln gefuellter Becher aus Leder steht auf "
	    "dem Holztisch.");

  AddDetail(({"wuerfel","wuerfeln"}),
	    "Die Wuerfel befinden sich in dem kleinen Becher auf dem "
	    "Tisch.");

  AddDetail(({"kamelleder","leder"}),
	    "Sieht nach Kamelleder aus.");

  geld=MAXGELD;
  pause=0;
  fackeln=MAXFACKELN;

  AddExit("raus", ROOM "krater_1_0_0");
  AddExit("oben", ROOM "dachboden");
  SetProp(P_HIDE_EXITS, ({"oben"}));

  AddCmd(CMD_OEFFNEN,"hihi");
  AddCmd(({"wuerfel","wuerfle"}), "wuerfeln");

  Licht("hell");
  Umgebung("warm", TT_HOUSE, 1);

  AddItem(NPC "turmwaechter", REFRESH_DESTRUCT);
  AddItem(NPC "turmwaechter", REFRESH_DESTRUCT);
}

nosave int hihi(string str)
{
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;

  if(str=="schrank")
    return write("Du ruettelst an einem Schrank, doch der ist fest "
		 "versperrt...\nEntaeuscht laesst Du ab.\n"), 1;

  if(str=="schraenke")
    return write(BS("Gleich alle auf einmal??")), 1;

  return 0;
}

nosave int wuerfeln(string str)
{
  int einsatz, own, wach;
  
  notify_fail("Womit willst Du denn wuerfeln?\n");
  if(!str) return 0;

  if(member(({"wuerfel","mit wuerfel","mit wuerfeln"}), str) == -1)
    return 0;

  if(!present("\nturmwaechter", ME))
    return write(BS("Es scheint keiner da zu sein, um mit Dir zu spielen.")),1;

  if(TP->InFight())
    return write(BS("Du bist gerade anderweitig beschaeftigt")), 1;

  if(geld < 0) geld=0;

  if(!geld)
    return write(BS("Der Turmwaechter hat kein Geld mehr, um mit Dir zu "
		    "spielen.")), 1;

  if(pause >= time())
    return write(BS("Der Turmwaechter meint: Nur nicht so schnell!")), 1;
  
  einsatz=100+random(50);

  if(TP->QueryMoney() < einsatz)
    return write(BS("Der Turmwaechter meint: Du hast ja nicht einmal genug "
		    "Geld fuer den Einsatz! Mit Dir spiel ich nicht!\n")), 1;

  if(einsatz > geld) 
    {
      write(BS("Der Turmwaechter meint: Das ist mein letztes Geld!"));
      einsatz=geld;
    }

  own=random(26)+5;
  
  wach=random(26)+5;
  
  write("\nDer Waechter und Du, ihr setzt euch gemuetlich zum Tisch...\n"
	"Ihr einigt euch auf den Einsatz in der Hoehe von "+einsatz+" Muenzen."
	"\nDu nimmst den Wuerfelbecher in die Hand und beginnst zu wuerfeln.\n"
	"... schuettel ...\n"
	"... schuettel ...\n"
	"Mit einem gekonnten Wurf landen alle 5 Wuerfel auf dem Tisch...\n"
	"Du zaehlst die einzelnen Punkte zusammen und kommst auf: "+own+".\n"
	"\nNun ist der Turmwaechter dran...\n"
	"Er hebt den Becher vorsichtig in die Hoehe und beginnt dann kraeftig "
	"zu schuetteln. Immer wilder hoerst Du die Wuerfeln in dem Becher "
	"umherrattern...\n"
	"Und da purzeln die Wuerfel auch schon auf den Tisch...\n"
	"Abermals zaehlst Du die Punkte zusammen und kommst auf: "+wach+".\n");

  say(BS(TPN+" und ein Turmwaechter setzen sich hin und wuerfeln "
	 "eine Runde."), ({TP}));

  if(own==wach)
    {
      write(BS("Ein Pasch! Keiner gewinnt... Los nocheinmal!"));

      say(BS("Offenbar haben die zwei einen Pasch gewuerfelt."), ({TP}));
      
      return 1;
    }

  if(own > wach)
    {
      TP->AddMoney(einsatz);

      geld-=einsatz;

      write(BS("Du hast GEWONNEN!"));

      write(BS("Mit einem haemischen Grinser kassierst Du vom Turmwaechter den"
	       " beschlossenen Einsatz ein und bedankst Dich hoeflich."));

      say(BS(TPN+" hat gewonnen und streicht grinsend seinen Gewinn "
	  "ein."), ({TP}));
      
      if(geld < 0) geld=0;
      
      if(!geld)
	write(BS("Der Turmwaechter schnieft: Jetzt hab ich kein Geld mehr!"));
    }
  else
    {
      TP->AddMoney(-einsatz);

      geld+=einsatz;

      write(BS("Du hast Verloren!!!"));

      write(BS("Aergerlich verziehst Du Deine Mundwinkel, doch dann bezahlst "
	       "Du die geforderten "+einsatz+" Muenzen."));

      say(BS(TPN+" hat verloren und bezahlt dem Turmwaechter den "
	     "vereinbarten Einsatz."), ({TP}));
    }

  pause=time()+5;
  return 1;
}

void reset()
{ 
  ::reset();

  if(geld < MAXGELD) geld=MAXGELD;

  fackeln=MAXFACKELN;
}

int QueryFackeln()
{
  return fackeln;
}

int GetFackel()
{
  if(!fackeln) return 0;

  fackeln--;
  
  return 1;
}

int QueryMoney()
{
  return geld;
}
