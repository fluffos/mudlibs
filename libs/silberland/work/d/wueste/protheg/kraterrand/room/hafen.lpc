// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Wuestenhafen");
  SetProp(P_INT_LONG, 
	  BS("Suedlich von Dir breitet sich ein riesiges Meer aus. Soweit Du "
	     "nur sehen kannst, siehst Du nur Wasser. Nach Norden hin "
	     "oeffnet sich die trostlose, weite Wueste, doch hier bist Du "
	     "noch recht sicher. Ein uraltes Haus neben einer kleinen "
	     "Hafenkneipe erinnert hier noch daran, dass hier frueher einmal "
	     "eine Reederei gestanden haben mag. Ansonsten liegt hier nur "
	     "altes Geruempel und alte verrottete Kisten entlang des "
	     "Steges herum."));

  AddDetail(({"hafen"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"wuestenboden","boden"}),
	    "Der sandige Wuestenboden wird hier von einem steinernen Steg "
	    "abgeloest, der bis tief in die Bucht zeigt, da der Strand hier "
	    "so flach ist, dass die Schiffe wohl auflaufen wuerden.");

  AddDetail(({"meer","bucht"}),
	    "Der Hafen liegt in einer kleinen Bucht, so kommen die grossen "
	    "Wellen nicht bis hier her. Auf beiden Seiten des Steges "
	    "erstreckt sich ein wunderschoener, kleiner Sandstrand. Nach "
	    "Sueden hin erstreckt sich das Meer.");

  AddDetail(({"seiten","strand","sandstrand"}),
	    "An beiden Seiten des Stegs zieht sich ein malerischer "
	    "Sandstrand bis in die weite Ferne...");

  AddDetail(({"auge","ferne"}),
	    "Soweit das Auge reicht, siehst Du nur den Strand!");

  AddDetail("wellen",
	    "Sanfte, kleine Wellen treffen auf den Sandstrand und ueben eine "
	    "beruhigende Wirkung auf Dich aus...");

  AddDetail("wirkung",
	    "Du wirst ploetzlich viel entspannter...");

  AddDetail(({"steinsteg","steg"}),
	    "Der gewaltige Steinsteg zieht sich weiter nach Sueden, bis weit "
	    "ins Meer hinein.");

  AddDetail(({"meerwasser","wasser"}),
	    "Das Meerwasser fuehlt sich erfrischend kuehl an, am liebsten wuerdest Du gleich "
	    "hineinspringen.");

  AddDetail("wueste",
	    "Die Wueste erstreckt sich von hier aus weit in den Norden.");

  AddDetail(({"blau","himmel"}),
	    "Ein freundliches Blau ueberzieht den Himmel, der im Sueden "
	    "einige Wolken aufweist. Hie und da siehst Du ein paar "
	    "Seemoewen kreisen.");

  AddDetail(({"wolke","wolken"}),
	    "Weiter im Sueden, haengen einige Wolken ueber dem Meer.");

  AddDetail(({"moewen","seemoewen", "moeven", "seemoeven"}),
	    "Hie und da kreisen Seemoewen ueber Dir und suchen tote Fische "
	    "oder sonstiges, was deren Aufmerksamkeit erregt.");

  AddDetail("aufmerksamkeit",
	    "Nichts entgeht der Aufmerksamkeit der Seemoewen.");

  AddDetail(({"fisch","fische"}),
	    "Das Meer ist voller Fische, doch sie halten sich in tieferem "
	    "Wasser auf, also weiter im Sueden.");

  AddDetail(({"schiff","schiffe"}),
	    "Die Schiffe legen am Ende des Stegs an, da es dort tief genug "
	    "ist.");

  AddDetail("ende",
	    "Das Ende des Stegs lieger weiter im Sueden.");

  AddDetail("geruempel",
	    "Uraltes, wertloses Geruempel liegt hier herum und dient nur "
	    "noch als Heim und Brutplatz fuer Seemoewen.");

  AddDetail("kisten",
	    "Gewaltige Kistenstapel saeumen hier den Steinsteg und warten "
	    "darauf abgeholt zu werden. Einige von ihnen stehen hier schon "
	    "sehr lange herum. Ob sie wohl je abgeholt werden?");

  AddDetail("heim",
	    "Die Seemoewen sehen das alte Geruempel als Heim an.");

  AddDetail("brutplatz",
	    "An den vielen Nestern zwischen dem alten Geruempel merkst Du, "
	    "dass die Seemoewen sich hier einen Brutplatz eingerichtet "
	    "haben.");

  AddDetail(({"nester","nest","moewennest","seemoewennest"}),
	    "Hie und da befindet sich ein kleines Seemoewennest inzwischen "
	    "all dem Geruempel.");

  AddDetail(({"stapel","kistenstapel"}),
	    "Gewaltige, vor sich hingammelnde Kistenstapel stehen hier herum "
	    "und bieten allerlei Verstecke fuer kleine Tiere und Voegel.");

  AddDetail(({"vogel","voegel"}),
	    "Hauptsaechlich Seemoewen.");

  AddDetail(({"strandgetier","tiere","getier"}),
	    "Ratten, Krebse und sonstiges Strandgetier, dass hier "
	    "herumrennt.");

  AddDetail(({"ratten","ratte","krebs","krebse"}),
	    "Die verstecken sich zwischen den Kistenstapeln.");

  AddDetail("verstecke",
	    "Du kannst keine entdecken, sie werden wohl sehr gut versteckt "
	    "sein!");

  AddDetail(({"reederei","haus"}),
	    "Das uralte Haus scheint frueher eine grosse Reederei gewesen zu "
	    "sein, doch heute ist das nur noch ein wackeliges, "
	    "halbzerfallenes Haus, dass von Ratten bewohnt wird.");

  AddDetail(({"kneipe","hafenkneipe"}),
	    "Westlich neben der alten Reederei steht eine kleine Hafenkneipe. "
	    "Ein kleines Schild ist ueber der Tuer befestigt, ansonsten wirkt "
	    "die Kneipe eher schaebig.");

  AddDetail("tuer",
	    "Die Tuer steht sperrangelweit offen und ab und zu hoert man "
	    "Gegroehle.");

  AddDetail(({"holzschild","schild","name"}),
	    "Ein kleines Holzschild haengt ueber der Tuer zur Hafenkneipe. "
	    "Der Name steht in alten grossen Lettern drauf.");

  AddDetail("letter",
	    "Grosse Lettern prangen an dem Schild ueber der Tuer!");

  AddReadDetail(({"schild","letter","lettern","holzschild"}),
		"Auf dem Schild steht in alten Lettern: 'Zum gestrandeten Wal'");
  AddSound(({DEFAULT_SOUND, "gegroehle"}),
	   "Ab und zu hoerst Du ein lautes Gegroehle aus der Kneipe, was da "
	   "wohl los ist?!");
  
  AddSound(({"meer","wellen","rauschen","wasser"}),
	   "Das Rauschen des Meeres beruhigt Dich vollkommen.");

  AddSmell(({DEFAULT_SMELL, "steg","fisch","fische"}),
	   "Es riecht teilweise recht streng nach Fisch, den Steg entlang.");

  AddExit("sueden", "auf den Steg hinaus#" ROOM "steg");
  AddExit("westen", "in die Hafenkneipe#" ROOM "hafenkneipe");
  AddExit("norden", "/d/wueste/zordan/desert/room/desert:68:46");
  AddExit("nordwesten", "/d/wueste/zordan/desert/room/desert:67:46");
  AddExit("nordosten",  "/d/wueste/zordan/desert/room/desert:69:46");
  
  Licht("sehr_hell");
  Umgebung("heiss", TT_DESERT);

  AddCmd(({"bade","steige","steig","schwimme","schwimm","springe","spring"}), 
	 "springenfkt");
  
  AddItem("/d/wueste/protheg/karavanen/obj/fsauto", REFRESH_DESTRUCT);
}

nosave int springenfkt(string str)
{
  notify_fail(BS("Wohin willst Du denn schwimmen?"));
  if(!str) return 0;

  if(str=="in meer"||str=="ins meer"||str=="in das meer"||
     str=="auf das meer"||str=="aufs meer"||
     str=="auf das meer hinaus"||str=="aufs meer hinaus")
    return write(BS("In letzter Minute beschliesst Du, es doch zu lassen!")),1;

  return 0;
}
