// Hafenkneipe by PROtheG

#include "../def.h"

inherit "std/pub";
inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Hafenkneipe 'Zum gestrandeten Wal'");
  SetProp(P_INT_LONG, 
	  BS("Du findest Dich in einer kleinen, urigen Hafenkneipe wieder. "
	     "An der kleinen Theke steht ein alter, einaeugiger Seebaer und "
	     "zwinkert Dir freundlich zu. Die Waende sind ueber und ueber "
	     "mit allerlei Zeugs behangen, Harpunen, Haikoepfe und sonstiges, "
	     "was so eine echte Kneipe ausmacht. Weiters stehen ein paar "
	     "kleine Tischchen herum, an denen alte Seebaeren rumhaengen und "
	     "sich Geschichten ueber die See erzaehlen."));
  
  AddDetail(({"kneipe","raum","hafenkneipe"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail("boden",
	    "Der Boden besteht aus originalen Schiffsplanken und knarrt "
	    "fuerchterlich bei jedem Schritt.");

  AddDetail(({"netz","fischernetz","decke"}),
	    "Ein altes, loechriges Fischernetz wurde an der Decke "
	    "aufgespannt, es haengen sogar einige alte Fischerutensilien "
	    "darin.");

  AddDetail(({"utensilien","fischerutensilien","fischerutensilien"}),
	    "Da haengt ein alter Stiefel, da eine Harpune und dort eine "
	    "Regenmuetze.");

  AddDetail(({"dekoration","stiefel","harpunen","harpune","muetze",
		"regenmuetze"}),
	    "Lauter altes Geruempel haengt hier herum, laesst den Raum aber "
	    "recht gemuetlich wirken.");

  AddDetail("theke",
	    "Eine kleine Theke, voll mit allerlei undefinierbarem Zeugs und "
	    "halbvollen Flaschen. Ein alter Seebaer steht dahinter und "
	    "zwinkert Dir freundlich zu.");

  AddDetail(({"geruempel","zeugs"}),
	    "Du bist Dir eigentlich nicht so sicher, ob Du wissen willst, "
	    "was das alles ist!");

  AddDetail(({"grosse flaschen", "kleine flaschen", "runde flaschen", 
		"eckige flaschen", "schmale flaschen", "breite flaschen", 
		"flaschen"}),
	    "Lauter Flaschen! Grosse, kleine, runde, eckige, schmale, "
	    "breite Flaschen!!");

  AddDetail(({"stuetze","ellenbogenstuetze","tischchen"}),
	    "Ein paar kleine, jedoch bereits sehr alte Tischchen stehen "
	    "hier herum und dienen den alten Seebaeren bei ihren Geschichten "
	    "als Ellenbogenstuetze.");

  AddDetail(({"wand","waende"}),
	    "Die Waende sind ueber und ueber mit allerlei Zeugs behangen, "
	    "Harpunen, Haikoepfe und sonstiges, dass diese Kneipe recht "
	    "originell aussehen laesst.");

  AddDetail(({"hubbart","seebaer"}),
	    "Hinter der Theke steht Hubbart, der alte Seebaer. Frueher "
	    "einmal war er der Kapitaen einer grossen Segelyacht, doch nun "
	    "ist er fuer sowas zu alt und betreibt diese gemuetliche "
	    "Hafenkneipe.");

  AddDetail(({"sueden","see","meer","wasser"}),
	    "Die See, wie das Meer von den Seebaeren oft genannt wird "
	    "erstreckt sich weit nach Sueden.");

  AddDetail(({"kapitaen","yacht","segelyacht"}),
	    "Hubbart war damals der Kapitaen einer grossen Segelyacht, die "
	    "die Kuesten des Silberlandes umsegelte, doch als sie sank, "
	    "wurde er arbeitslos und blieb hier in dieser Hafenkneipe "
	    "haengen.");

  AddDetail(({"silberland","kuesten"}),
	    "Jahrelang segelte Hubbart die Kuesten des Silberlandes ab.");

  AddDetail(({"koepfe","haikoepfe"}),
	    "Einige Haikoepfe wurden als Dekoration aufgehaengt. Ihre Zaehne "
	    "blitzen Dir entgegen...");

  AddDetail(({"zaehne","zahn","haizaehne","haizahn"}),
	    "Messerscharfe Haizaehne blitzen Dir entgegen.");

  AddDetail(({"seemannsgarn","garn","geschichten"}),
	    "Die Geschichten sind meisstens nur Seemannsgarn und handeln von "
	    "Meerjungfrauen, Seedrachen, oder Seeschlangen und sonstigen "
	    "Meeresungeheuern.");

  AddDetail(({"seedrachen","seeschlangen","meeresungeheuer","ungeheuer",
		"drachen","schlangen"}),
	    "Die Meere sind angeblich voll davon!");

  AddSound(({"schritt"}),
	   "*Krach*knacks*aechz*quietsch*");

  AddDetail(({"frau","fisch","meerjungfrauen"}),
	    "Die legendaeren Meerjungfrauen sollen halb Fisch, halb Frau "
	    "sein und wer sie einmal gesehen hat soll seinen Verstand "
	    "verlieren, wegen ihrer Schoenheit.");

  AddDetail(({"verstand","schoenheit"}),
	    "Die Schoenheit der Meerjungfrauen liess schon so manchen "
	    "Seebaeren seinen Verstand verlieren...");

  AddDetail(({"planken","schiffsplanken"}),
	    "Lange, hoelzerne, jedoch schon ziemlich betagte Schiffsplanken.");

  AddDetail(({"seebaeren"}),
	    "Von denen sitzen hier einige herum.");

  AddSound(({DEFAULT_SOUND, "planken","schiffsplanken","knarren","aechzen"}),
	   "Ab und zu hoerst Du wie die Schiffsplanken knarren und aechzen.");

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht hier etwas seltsam, leicht modrig und etwas nach "
	   "faulem Fisch.");

  AddSound(({"seebaeren","geschichten","murmeln","brummen"}),
	   "Hie und da vernimmst Du ein leises Murmeln und Brummen, als sich "
	   "die Seebaeren wiedereinmal eine ihrer Geschichten erzaehlen.");

  AddSmell("fisch",
	   "Es riecht hier irgendwie nach faulem Fisch.");
  
  AddFood("Wasserleichenfinger",
	  ({"finger","wasserleichenfinger"}),100,30,10,
	  ({"Hubbart greift in ein Gurkenglas, holt einige Finger heraus "
	      "und legt sie auf einen Teller. Dann etwas Brot dazu und Du "
	      "bekommst die Wuerstchen serviert. "
	      "Gierig schlingst Du sie herunter...",
	      "&& bekommt ein paar Wuerstchen aus einem Gurkenglas "
	      "serviert."}));

  AddFood("Piratenaugen flambiert",
	  ({"augen","piratenaugen","flambierte augen",
	      "flambierte piratenaugen"}),120,({0,15,15}),5,
	  ({"Hubbart stellt Dir einen Teller mit zwei seltam aussehenden "
	      "Kugeln hin...\n"
	      "Das sind keine Kugeln, sondern echte Augen!!\n"
	      "Du schauderst.\n"
	      "Aber schliesslich hast Du sie ja bestellt, also wuergst Du "
	      "gleich beide, ohne weiter nachzudenken einfach runter und "
	      "wirst von ihrem Geschmack angenehm ueberrascht!\n",
	      "&& bekommt einen Teller mit zwei echten Augen vorgesetzt und "
	      "schluckt diese mit einem seltsamen Gesichtsausdruck runter...\n"
	      "Du schauderst.\n"}));

  AddFood("Haisteak a la Berserker",
	  ({"steak", "haisteak", "berserkersteak","steak a la berserker",
	      "haisteak a la berserker"}),150,45,15,
	  ({"Hubbart greift unter den Tresen und holt ein Stueck Fleisch "
	      "heraus. Dann wirft er es auf eine grosse Pfanne und wuerzt "
	      "es kraeftig.\n"
	      "Hubbart legt Dir das Haisteak (medium) vor und Du schlingst es "
	      "wie ein echter Berserker runter...\n"
	      "*mjam* war das lecker!\n\n",
	      "Hubbart greift unter den Tresen und holt ein Stueck Fleisch "
	      "heraus. Dann wirft er es auf eine grosse Pfanne und wuerzt "
	      "es kraeftig.\n"
	      "Anschliessend legt er &4 das Haisteak (medium) vor und &1 "
	      "schlingt es wie ein echter Berserker runter...\n"}));
  
  AddFood("Walrippchen (fettig)",
	  ({"rippchen","walrippchen","fettige walrippchen"}),250,50,20,
	  ({"Hubbart geht kurz nach hinten in die Kueche und kommt mit einem "
	      "grossen Teller voller koestlicher Rippchen zurueck, die Du "
	      "sofort auffutterst. Danach gibt Dir Hubbart eine alte "
	      "Serviette, dass Du Dir Deine fettigen Finger abwischen "
	      "kannst.\n",
	      "Hubbart geht in die Kueche und bringt && einen grossen Teller "
	      "mit fettigen, aber koestlich aussehenden Walrippchen.\n"}));
  
  AddFood("Tintenfischringe (paniert)",
	  ({"ringe","tintenfisch","tintenfischringe"}),300,22,9,
	  ({"Hubbart stellt Dir einen Teller voller dampfender "
	      "Tintenfischringe hin, die Du, jeden einzeln sofort verputzt.\n",
	      "Hubbart stellt && einen Teller voller dampfender "
	      "Tintenfischringe hin, die &1 sofort aufisst.\n"}));

  AddDrink("Krakenpisse",
	   ({"pisse","krakenpisse"}),200,10,0,5,
	   ({"Hubbart nimmt ein kleines Glas und haelt es an eine grosse "
	       "Flasche mit einer Krake drauf. Ein kleiner Dreh an einem "
	       "Hahn und schon fuellt sich das Glas. Mit einer gekonnten "
	       "Handbewegung schuettest Du alles in Dich hinein und "
	       "erstarrst angewidert...\nAlle grinsen Dich an."
	       "DAS ZEUG IST JA PICKSUESS!!! *wuerg*",
	       "&& bekommt ein Glas 'Krakenpisse' serviert, trinkt es und "
	       "bleibt angewidert stehen...\nDu grinst && an."}));

  AddDrink("Grogg der Toeter",
	   ({"grogg","grogg den toeter","grogg der toeter"}),220,28,20,2,
	   ({"Hubbart greift nach einer Flasche unter dem Tresen und giesst "
	       "vorsichtig etwas zaehes in ein Stamperl. Du nimmst das "
	       "Stamperl zwischen die Finger kippst den Inhalt mit einem "
	       "Schluck runter...\n"
	       "Deine Sinne schwinden und Deine Knie werden weich, doch Du "
	       "erholst Dich rasch wieder und denkst 'Was fuer ein Drink!'\n",
	       "Hubbart greift nach einer Flasche unter dem Tresen und "
	       "giesst && etwas ein. && schluckt das Gebraeu in einem Zug "
	       "herunter und beginnt zu roecheln und zu wanken, doch &1 "
	       "erholt sich rasch wieder und laechelt gluecklich.\n"}));

  AddDrink("Lebertran",
	   ({"tran","lebertran"}),220,({15,0,5}),0,5,
	   ({"Hubbart nimmt ein Glas und giesst eine besonders zaehe, "
	       "schwarze Fluessigkeit hinein. Du setzt an und wuergst das "
	       "Zeug herunter. Hubbart schuettelt sich und denkt 'Is fuea "
	       "de Gesundhait'.\n",
	       "Hubbart setzt && ein Glas mit Lebertran vor!\n"
	       "Du schuettelst Dich.\n"}));

  AddDrink("Rum (Lebenselixier)",
	   ({"rum","elixier","elexier","elixir","elexir","lebenselixier"}),
	   250,({30,0,5}),10,10,
	   ({"Hubbarts Augen glaenzen, als er Dir ein Glas echten, "
	       "selbstgebrauten Rum einschenkt. Ein koestliches Getraenk! "
	       "Brennt etwas im Hals, ansonsten sehr bekoemmlich! Du leerst "
	       "das Glas auf einen Zug, Dir wird kurz heiss und kalt "
	       "gleichzeitig und danach geht es Dir nur noch guuuuuut.\n",
	       "Hubbarts Augen glaenzen, als er && ein Glas seines "
	       "selbstgebrauten Rums einschenkt.\n"}));

  AddDrink("Meerjungfrauenlikoer (scharf)",
	   ({"likoer","meerjungfrauenlikoer"}),350,10,5,3,
	   ({"Hubbart schenkt Dir ein Stamperl mit einem besonders scharfen "
	       "Likoer ein!\n"
	       "Dein Kopf laeuft feuerrot an und Du schluckst nur noch, doch "
	       "da hast Du es auch schon ueberstanden!\n",
	       "&& bekommt von Hubbart ein Stamperl mit scharfem "
	       "Meerjungfrauenlikoer vorgesetzt, trinkt es in einem Zug und "
	       "roechelt vor sich hin.\n"
	       "Du grinst && an.\n"}));

  AddDrink("Piratenbraeu",
	   ({"braeu","piratenbraeu"}),400,40,10,13,
	   ({"Hubbart stellt Dir einen grossen Krug original Piratenbraeu "
	       "hin, den Du gemuetlich leerst. Irgendwie bekommst Du Lust "
	       "auf noch eins!\n",
	       "&& goennt sich genuesslich ein Piratenbraeu.\n"
	       "Du willst auch eins haben!\n"}));
  
  AddCmd("menue", "newmenue");
  
  AddExit(({"osten","raus"}), "hinaus#" ROOM "hafen");
  SetProp(P_HIDE_EXITS, ({"osten"}));
  
  Licht("hell");
  Umgebung("heiss", TT_HOUSE, 1);
}

string i2m(int size)
{
  string ret;

  switch(size)
    {
    case  0.. 5 : ret="(sehr wenig)"; break;
    case  6..10 : ret="(wenig)";      break;
    case 11..20 : ret="(genug)";      break;
    case 21..30 : ret="(viel)";       break;
    case 31..40 : ret="(sehr viel)";  break;
    default     : ret="(gigantisch)";
    }  
  return ret;
}

nosave int newmenue(string str)
{
  int i;
  string ret,tmp;
  mixed *food;
  mixed *drink;

  food=query_food();
  drink=query_drink();
  ret=tmp="";
  
  if(!str || str=="getraenke" || str=="getraenk" || str=="trinken")
    if(sizeof(drink))
      {
	ret+=duplicate(" ",25)+"Getraenke:\n"+
	  duplicate(" ",24)+"------------\n";

	//mit Alk
	for(i=0;i<sizeof(drink);i++)
	if(drink[i][4])
	  tmp+=duplicate(" ",5)+
	    sprintf("%-29.29s %5.5d Muenzen %s\n", 
		    drink[i][0], calc_price(drink[i]), i2m(drink[i][5]));

	if(strlen(tmp))
	  {
	    ret+="\n"+duplicate(" ",3)+"Getraenke mit Alkohol:\n\n";
	    ret+=tmp;
	  }

	tmp="";

	//ohne Alk
	for(i=0;i<sizeof(drink);i++)
	  if(!drink[i][4])
	    tmp+=duplicate(" ",5)+
	      sprintf("%-29.29s %5.5d Muenzen %s\n", 
		      drink[i][0], calc_price(drink[i]), i2m(drink[i][5]));

	if(strlen(tmp))
	  {
	    ret+="\n"+duplicate(" ",3)+"Getraenke ohne Alkohol:\n\n";
	    ret+=tmp;
	  }
	ret+="\n\n";
      }
  
  if(!str || str=="speisen" || str=="essen")
    if(sizeof(food))
    {
      ret+=duplicate(" ",25)+"Speisen:\n"+
	duplicate(" ",24)+"----------\n\n";

      for(i=0;i<sizeof(food);i++)
	ret+=duplicate(" ",5)+
	  sprintf("%-29.29s %5.5d Muenzen %s\n", 
		  food[i][0], calc_price(food[i]), i2m(food[i][4]));
      ret+="\n ";
    }
  
  if(!strlen(ret))
    ret="Zur Zeit sind wir ausverkauft!\n";

  TP->More(make_document(ret));
  return 1;
}

