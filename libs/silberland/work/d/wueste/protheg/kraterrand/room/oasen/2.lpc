#include "../def.h"

inherit MOST "std_room";
inherit ROOM "oasen/in";

#define MAXHEILEN 5
#define MAMPF 8

#define XK 56
#define YK 25

nosave int heilen;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Irgendwo in der Wueste");
  SetProp(P_INT_LONG,
	  BS("Ploetzlich steht vor Dir, voellig unerwartet ein grosser "
	     "Wuestenstrauch mit reifen Wuestennuessen. Du fragst Dich, wie "
	     "dieser Strauch hier in der Wueste ueberleben kann."));

  AddDetail(({"sand","boden"}),
	    "Der Boden hier in der Wueste ist ziemlich sandig, woher das "
	    "wohl kommen mag?");

  AddDetail(({"himmel","sonne"}),
	    "Die Sonne brennt Dir beinahe die Augen aus.");

  AddDetail("augen",
	    "Du solltest wohl nicht zu oft in die Sonnen blicken, denn Deine "
	    "Augen brennen bereits!");

  AddDetail(({"nuesse","wuestennuesse"}),
	    "Sie sehen sehr hart aus, ob sie geniessbar sind?");

  AddDetail("wueste",
	    "Wo glaubst Du denn, dass Du Dich hier befindest?");

  AddDetail(({"strauch","wuestenstrauch"}),
	    "Einige Wuestennuesse wachsen auf dem Strauch, ansonsten ist "
	    "da nichts besonderes dran.");

  heilen=MAXHEILEN;
  
  AddSound(({DEFAULT_SOUND,"wind","ferne"}),
	   "Aus der Ferne hoerst Du den Wind heulen.");

  AddSmell(DEFAULT_SMELL,
	   "Der heisse Sand brennt Dir in der Nase.");

  AddDetail("nase",
	    "Deine Nase scheint noch da zu sein, sonst wuerde sie wohl kaum "
	    "brennen.");
  
  AddCmd(({"pflueck","pfluecke"}), "pflueckenfkt");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  oasen_exits(XK,YK);
}

void reset()
{
  ::reset();

  heilen=MAXHEILEN;
}

nosave int pflueckenfkt(string str)
{
  int h;
  
  notify_fail(BS("Was willst Du denn pfluecken?"));
  if(!str) return 0;

  if(str=="nuesse"||str=="wuestennuesse"||str=="nuss"||str=="wuestennuss")
    {
      if(!TP->eat_food(MAMPF, 1))
	return write(BS("Du verspuerst zur Zeit keinen grossen Hunger.")), 1;
      
      if(heilen)
	{
	  heilen--;
	
	  h=30+random(40);
	  
	  TP->AddHp(h);
	  
	  write_file(LOG "oasen", CAP(getuid(TP))+" knackt eine Wuestennuss "
		     "fuer "+h+" Lebenspunkte. \(2\)\n");
	}

      write(BS("Du pflueckst Dir eine Wuestennuss knackst sie und futterst "
	       "sie auf."));
      say(BS(TPN+" knabbert an etwas herum."));

      return 1;
    }

  return 0;
}
