#include "../def.h"

inherit MOST "std_room";
inherit ROOM "oasen/in";

#define MAXHEILEN 5
#define MAMPF 8

#define XK 115
#define YK 17

nosave int heilen;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "An einem ausgetrockneten See");
  SetProp(P_INT_LONG,
	  BS("Vor Deinen Augen breitet sich ein tristes Bild aus...")+
	  BS("Wohin Du auch siehst, bemerkst Du nur die trockenen Ueberreste "
	     "einer, einst sicherlich wasserreichen, Oase. Einige "
	     "vertrocknete Palmen fuehren hier ein kuemmerliches Dasein. "
	     "Als einziger Ueberlebender, faellt Dir ein huefthoher Busch "
	     "auf, dessen Blaetter noch gruen gefaerbt zu sein scheinen."));

  AddDetail("boden",
	    "Der Boden ist so trocken, dass er durchgehend mit Rissen "
	    "durchzogen ist.");

  AddDetail("risse",
	    "Sie ziehen sich kreuz und quer ueber den ausgetrockneten See.");

  AddDetail("augen",
	    "Deine Augen offenbaren Dir ein aeusserst trauriges Bild eines "
	    "ausgetrockneten Sees.");

  AddDetail("bild",
	    "Du kannst Dir nur vorstellen, wie schoen es hier einmal gewesen "
	    "sein mag.");

  AddDetail("ueberreste",
	    "Einige vertrocknete Palmen saeumen den ausgetrockneten See und "
	    "ein kleiner Busch steht herum.");

  AddDetail("palmen",
	    "Frueher sind an den Palmen sicherlich grosse Kokosnuesse "
	    "gewachsen");

  AddDetail("kokosnuesse",
	    "Weit und breit keine zu entdecken.");

  AddDetail(({"sonne","himmel"}),
	    "Die Sonne brennt gnadenlos vom Himmel herab.");

  AddDetail(({"see","oase"}),
	    "Wie gross die Oase frueher auch gewesen sein mag, nun ist von "
	    "dem See nur noch ein ausgetrockneter Fleck auf dem Boden.");

  AddDetail("fleck",
	    "Staubtrocken und mit Rissen uebersaeht.");

  AddDetail("dasein",
	    "So moechtest Du sicherlich nicht enden... Vertrocknet in der "
	    "Wueste.");

  AddDetail("wueste",
	    "Rund um Dich herum nur endlos weite Wueste...");

  AddDetail(({"busch","ueberlebender"}),
	    "Dieser kleine Busch hier duerfte ueber sehr tiefgehende Wurzeln "
	    "verfuegen, denn er scheint noch etwas Wasser zu bekommen, was "
	    "man an seinen gruenen Blaettern erkennen kann.");

  AddDetail("blaetter",
	    "Saftige gruene Blaetter, doch was ist das? Da haengen doch "
	    "tatsaechlich seltsam geformte Fruechte unter den Blaettern.");

  AddDetail("fruechte",
	    "Ob die wohl essbar sind?");

  AddDetail("wasser",
	    "Wasser ist hier in der Wueste das kostbarste was es geben kann!");

  AddDetail("wurzeln",
	    "Du kannst leider nicht sehen, wie tief die Wurzeln gehen.");

  AddSmell(({"luft",DEFAULT_SMELL}),
	   "Es liegt ein leicht suesslicher Duft in der Luft...");

  AddSmell("duft",
	   "Er scheint von dem kleinen Busch auszugehen.");

  AddSound(({DEFAULT_SOUND,"wind","ferne"}),
           "Aus der Ferne hoerst Du den Wind heulen.");

  heilen=MAXHEILEN;

  AddCmd(({"pflueck","pfluecke"}), "pflueckenfkt");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);

  oasen_exits(XK,YK);
}

void reset()
{
  ::reset();

  heilen=MAXHEILEN;
}

nosave int pflueckenfkt(string str)
{
  int h;
  
  notify_fail(BS("Was willst Du denn pfluecken?"));
  if(!str) return 0;

  if(str=="fruechte"||str=="seltsame fruechte")
    {
      if(!TP->eat_food(MAMPF, 1))
	return write(BS("Soviel passt nicht mehr in Deinen Magen!")), 1;

      if(heilen)
	{
	  heilen--;

	  h=40+random(40);

	  TP->AddHp(h);

	  write_file(LOG "oasen", CAP(getuid(TP))+" isst eine Frucht fuer "+
		     h+" Lebenspunkte. \(4\)\n");
	}

      write(BS("Du pflueckst eine dieser seltsam anmutenden Fruechte "
	       "und stopfst sie genuesslich in Dich hinen *mampf*!"));
      
      say(BS(TPN+" stopft sich eine seltsam aussehende Frucht in "
	     "den Mund."), ({TP}));
      
      return 1;
    }
  
  return 0;
}

