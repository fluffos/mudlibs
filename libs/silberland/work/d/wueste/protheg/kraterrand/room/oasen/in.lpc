#include <properties.h>
#include "../../def.h"

#define ODZ "/d/wueste/zordan/desert/room/desert"

varargs oasen_exits(int x, int y)
{

  if(!x || !y) return;
  // x - horizontal
  // y - vertikal

  AddExit("nordwesten", ODZ +":"+ (x-1) +":"+ (y-1));
  AddExit("norden",     ODZ +":"+ (x  ) +":"+ (y-1));
  AddExit("nordosten",  ODZ +":"+ (x+1) +":"+ (y-1));
  AddExit("westen",     ODZ +":"+ (x-1) +":"+ (y  ));
  AddExit("osten",      ODZ +":"+ (x+1) +":"+ (y  ));
  AddExit("suedwesten", ODZ +":"+ (x-1) +":"+ (y+1));
  AddExit("sueden",     ODZ +":"+ (x  ) +":"+ (y+1));
  AddExit("suedosten",  ODZ +":"+ (x+1) +":"+ (y+1));

  return ;

}
