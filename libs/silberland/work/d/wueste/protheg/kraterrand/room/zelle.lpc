// by PROtheG

#include "../def.h"

inherit MOST "std_room";

#define MAX_RATTEN 2
#define FENSTER 1
#define WASSER 2
#define DIETRICH 3

/*
  1 Abhauen mittels Leintuch und loser Stange
  2 Abhauen mittels Überschwemmung und Wacheüberwaeltigen
  3 Abhauen mittels Schlossaufsperren(Dietrich)
*/

nosave int exitdoor();
nosave int exitwindow();
nosave int seq,ratten,tuer,fenster;
nosave int leintuch_tied,leintuch_weg;
nosave int verstopft;
nosave int draht;
nosave void waechter();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Kerkerzelle");
  SetProp(P_INT_LONG, 
	  "Das hast Du nun davon! Jetzt sitzt Du hier in dieser kleinen "
	  "Kerkerzelle. Wie kommst Du denn hier wieder heraus? Die Zelle "
	  "ist sehr spartanisch eingerichtet mit einem Bett, einem Tisch, "
	  "einem Sessel, einer Toilette und einem vergitterten Fenster.\n");

  AddDetail(({"boden","tage"}),
	    "Der sandige Boden hat schon bessere Tage gesehen.\n");
  AddDetail(({"zelle","kerkerzelle"}),
	    TO->QueryProp(P_INT_LONG));
  AddDetail("bett",
	    "Das ist eigentlich kein Bett, sondern eher ein rostiges "
	    "Gestell mit einer halbverfaulten Matratze und einem stinkenden "
	    "Kopfkissen.\n");
  AddDetail("gestell",
	    "Ein aus Eisenstaeben und einem Gitter lieblos zusammen"
	    "gebundenes Gestell soll ein Bett darstellen.\n");
  AddDetail("staebe",
	    "Welche Staebe meinst Du denn?\n");
  AddDetail("eisenstaebe",
	    "Sehr standhaft sehen die nicht aus...\n");
  AddDetail("gitter",
	    "Das Gitter besteht aus mehreren, ineinandergeflochtenen "
	    "Draehten.\n");
  AddDetail("draehte",
	    "Rostige alte Draehte wurden hier zu einem Gitter fuer das Bett "
	    "zusammengeflochten. Sonderlich stabil sehen die nicht aus...\n");
  AddDetail("matratze",
	    "Eine Matratze aus halbverfaultem Stroh, immerhin liegt ein "
	    "Leintuch darauf.\n");
  AddSpecialDetail(({"leintuch","tuch"}),"tuechle");
  AddSmell(({DEFAULT_SMELL, "geruch"}),
	   "Hier riecht es nach verfaultem Stroh und Tierkadavern.\n");
  AddSmell("stroh",
	   "Darauf soll man nun schlafen...\n");
  AddSmell(({"kadaver","tierkadaver"}),
	   "Sicherlich irgendwelche Ratten, oder sonstiges Ungeziefer.\n");
  AddDetail(({"kissen","kopfkissen"}),
	    "Das Kopfkissen sieht eher aus wie ein Rattennest!\n");
  AddSpecialDetail(({"nest","rattennest"}), "ratten");
  AddDetail(({"ratten","ungeziefer"}),
	    "Hier gibt es sicher genug davon...\n");
  AddDetail("decke",
	    "Ab und zu rieselt etwas Sand von der Decke, was nicht gerade "
	    "fuer dessen Stabilitaet spricht.\n");
  AddDetail("sand",
	    "Ein Sandkorn rieselt Dir ins Auge und Du wendest Deinen Blick "
	    "schmerzerfuellt ab...\n");
  AddDetail("blick",
	    "Nochmal willst Du dort nicht mehr hochsehen...\n");
  AddDetail("auge",
	    "Das kannst Du so nicht sehen.\n");
  AddDetail("sandkorn",
	    "Schmerzerfuellt reibst Du Dir Dein Auge...\n");
  AddDetail("stabilitaet",
	    "Unwillkuerlich erzittert Du...\n");
  AddDetail("tisch",
	    "Ein kleiner, wackeliger Tisch, dessen Beine unterschiedlich "
	    "lang sind.\n");
  AddDetail(({"angelegenheit","beine","tischbeine"}),
	    "Eine aeusserst wacklige Angelegenheit...\n");
  AddDetail("waende",
	    "Kahle Waende aus purem Stein lassen diese Zelle trostlos "
	    "aussehen.\n");
  AddDetail("stein",
	    "Die gesamte Zelle besteht aus haertestem Stein.\n");
  AddDetail("sessel",
	    "Ein kleiner, halbvergammelter Sessel steht hier herum.\n");
  AddSpecialDetail("fenster","fenster");
  AddDetail("moeglichkeit"
	    "Oder gibt es derer etwa mehr?");
  AddDetail("freiheit",
	    "Die haettest Du wohl jetzt gerne...\n");
  AddDetail(({"staebe","eisenstaebe"}),
	    "Schwere Eisenstaebe wurden in das Fenster eingelassen. Sie "
	    "scheinen aber nicht mehr allzu fest zu sitzen, der Zahn der "
	    "Zeit hat wohl an dem Fenstersims genagt.\n");
  AddDetail("wand",
	    "An einer Wand steht eine graue Toilettenschuessel.\n");
  AddSpecialDetail(({"toilette","schuessel","toilettenschuessel"}),"klo");
  AddDetail(({"spuelleine","leine","rueckwand"}),
	    "Da haengt eine kurze Spuelleine, was wohl passiert, wenn man an "
	    "der zieht?\n");
  AddDetail(({"sims","fenstersims"}),
	    "Eisenstaebe sind in den Fenstersims eingelassen, doch sie "
	    "scheinen schon etwas locker zu sein...\n");
  AddDetail("moeglichkeit",
	    "Siehst Du denn etwa eine andere Moeglichkeit?\n");
  AddDetail(({"zahn","zeit"}),
	    "Der Zahn der Zeit scheint die Staebe etwas gelockert zu "
	    "haben.\n");
  AddDetail(({"tuerschloss","schloss"}),
	    "Die Tuer ist mit einem grossen Schloss versehen. Haettest Du "
	    "doch bloss den Schluessel irgendwo.");
  AddDetail("schluessel",
	    "Den einzigen Schluessel, den es fuer dieses Schloss gibt, hat "
	    "der Waechter draussen :\(");
  AddSpecialDetail(({"tuer","zellentuer"}), "tuerli");
  
  AddExit("tuer",
	  ([ 
	    EX_DEST: ROOM "krater_3_0_0",
	    EX_TESTFUNC: CLOSURE(exitdoor),
	    EXG_ID:"turmwaechter",
	    EXG_PLMSG:"Der Turmwaechter sagt: HALT! So einfach geht das nicht.\n",
	    EXG_RMMSG:"Der Turmwaechter laesst @WEN@ nicht raus...\n"]));
  AddExit("fenster",
	  ([ EX_DEST: ROOM "krater_3_0_0",
	  EX_TESTFUNC: CLOSURE(exitwindow),
	  EXG_ID:"turmwaechter",
	  EXG_PLMSG:"Der Turmwaechter sagt: HALT! So einfach geht das "
	  "nicht.\n",
	  EXG_RMMSG:"Der Turmwaechter laesst @WEN@ nicht raus...\n"]));
  
  AddCmd(({"locker","lockere"}),"lockernfkt");
  AddCmd(({"nehme","nimm"}),"nehmenfkt");
  AddCmd(({"knuepfe","knuepf","bind","binde"}), "knuepfenfkt");
  AddCmd(({"stopfe","stopf"}),"stopfenfkt");
  AddCmd(({"zieh","ziehe"}),"spuelfkt");
  AddCmd(({"reisse","reiss","rupfe","rupf"}), "reissenfkt");
  AddCmd(({"oeffne","knacke","knack"}), "oeffnenfkt");
  
  Licht("hell");
  Umgebung("heiss", TT_HOUSE, 1);

  tuer=0;
  seq=0;
  fenster=0;
  leintuch_weg=0;
  verstopft=0;
  
  ratten=MAX_RATTEN;
}

void init()
{
  ::init();
  
  if(!interactive(TP)) return;

  if(file_name()==ROOM "zelle")
    TP->move(ROOM "zelle:"+getuid(TP),M_TPORT|M_NOCHECK|M_SILENT);
  
  if(interactive(TP))
    seq=random(3)+1;
  
  DB("*** "+CAP(getuid(TP))+" wurde gerade in die Zelle gesteckt ("+seq+")\n");
  
  write_file(LOG "zelle",ctime(time())+" : "+CAP(getuid(TP))+" kommt rein.\n");
}

string tuechle()
{
  if(leintuch_weg)
    return "Hm scheint, als ob jemand das Leintuch genommen hat.\n";
  else
    return "Ein Leintuch wurde ueber das halbverfaulte Stroh gespannt, um "
      "den Geruch halbwegs ertraeglich zu halten.\n";
}

string fenster()
{
  if(leintuch_tied)
    return "Die dicken Eisenstaebe scheinen gelockert worden zu sein, "
      "einer ist sogar herausgebrochen. Ein Leintuch wurde an einen "
      "der Staebe geknuepft und baumelt an der Ausserwand.\n";
  if(fenster)
    return "Die dicken Eisenstaebe scheinen gelockert worden zu sein, "
      "einer ist sogar herausgebrochen!\n";
  return "Bis auf die Zellentuer die sonst einzige Moeglichkeit in die "
    "Freiheit zu gelangen, waeren da nicht diese dicken Eisenstaebe.\n";
}

int exitdoor()
{
  if(!tuer)
    return write("Du rennst gegen die geschlossene Zellentuer!\n"),0;
  
  if(!query_once_interactive(TP)) return 1;
  
  tuer=0;
  
  write("Schnell laeufst Du durch die Tuer, doch da sehen Dich auch schon "
	"die Turmwaechter...\n"
	"Ein Turmwaechter ruft: "+TPN+" ist ausgebrochen! Zu den Waffen!!\n"
	"Mit letzter Kraft erreichst Du die unverriegelte Eingangstuer und "
	"rennst in die Freiheit.\n");
  domainshout("Ein Turmwaechter ruft: "+TPN+
	      " ist ausgebrochen! Zu den Waffen!!\n"
	      "Ein kleiner Gnom kommt an.\n"
	      "Der kleine Gnom haelt Dir ein Pergament unter die Nase:\n"+
	      make_dokument(duplicate(" ",25)+"!! GESUCHT !!\n\n"+
			    duplicate(" ",17)+(CAP(getuid(TP)))+
			    (TP->QueryProp(P_GENDER)==2 ?
			     ", die Schwerverbrecherin!\n":
			     ", der Schwerverbrecher!\n")+
			    duplicate(" ",17)+"Belohnung sind "+
			    (TP->QueryProp(P_LEVEL)*1000)+" Muenzen.\n")+
	      "Der kleine Gnom geht wieder.\n");
  return 1;
}

int exitwindow()
{
  if(!fenster)
    return write("Du versuchst vergeblich, Dich zwischen den Staeben "
		 "durchzuzwaengen, doch es will Dir nicht gelingen.\n"),0;
  if(!query_once_interactive(TP)) return 1;

  if(!leintuch_tied)
    return write("Du zwaengst Dich durch die Eisenstaebe hindurch, doch "
		 "ohne Hilfsmittel wirst Du es wohl kaum lebend hinunter "
		 "schaffen...\n"),0;
  write("Geschickt kletterst Du zwischen den Eisenstaeben hindurch und "
	"hangelst Dich mit Hilfe des Leintuches hinunter...\n"
	"FREI!! FREI!! Endlich hast Du Deine Freiheit wieder.\n");
  say(TP->name(WER)+" schwingt sich aus dem Fenster.\n",TP);
  return 1;
}

string tuerli()
{
  if(tuer)
    return "Die Zellentuer ist OFFEN!!!\n";
  else
    return "Sie ist mit einem grossen Tuerschloss versehen. Ob man die "
      "irgendwie aufbekommen kann?\n";
}

string ratten()
{
  object ob;

  if(ratten)
    {
      write(BS("Als Du das Nest untersuchst, springt ploetzlich eine kleine "
	       "Ratte hervor, die Dich wuetend angreift..."));
      ob=clone_object(NPC "ratte");
      ob->move(ME, M_GO|M_SILENT);
      ob->Kill(TP);
      ratten--;
      return "";
    }
  else
    return "Du untersuchst das Nest, doch leider ist es leer...\n";
}

nosave int oeffnenfkt(string str)
{
  object di;
  
  notify_fail("Was willst Du denn oeffnen/knacken?\n");
  if(!str) return 0;
  
  if(str=="tuer"||str=="zellentuer")
    return write(BS("Ein grosses Schloss hindert Dich daran, die Tuer "
		    "zu oeffnen.")),1;
  
  if(str=="schloss"||str=="schloss auf")
    if(seq==DIETRICH)
      {
	if(!di=present("dietrich",TP))
	  return write(BS("Wenn Du nur bloss etwas haettest, um das Schloss "
			  "knacken zu koennen!")),1;
	if(TP->QueryAttribute(A_DEX)<random(12))
	  return write(BS("Du fummelst eine Weile mit dem Dietrich im Schloss "
			  "doch Du bist zu ungeschickt. Beim naechsten Mal "
			  "klappt es sicher!")),1;
	write("Mit einer gekonnten Handbewegung drehst Du den Dietrich im "
	      "Schloss herum. Das anschliessende Knacks ist zwar das Ende "
	      "des Dietriches, doch das Schloss ist offen!");
	di->remove(1);
	tuer=1;
	return 1;
      }
    else
      return write(BS("Du siehst keine Moeglichkeit die Tuer aufzuknacken.")),1;
  
  return 0;
}

nosave int reissenfkt(string str)
{
  object ob;
  
  notify_fail("Was willst Du denn ausreissen?\n");
  if(!str) return 0;
  
  if(str=="draht aus"||str=="draehte aus")
    if(seq==DIETRICH)
      {
	if(draht)
	  return write(BS("Wenn Du noch mehr Draehte rausreisst, wird wohl "
			  "nie mehr jemand auf diesem Bett schlafen koennen.\n")),1;
	if(TP->QueryAttribute(A_STR)<random(12))
	  return write(BS("Du ziehst und zerrst an den Draehten, doch die "
			  "erweisen sich als aeusserst widerspenstig und "
			  "Du musst loslassen. Aber beim naechsten Mal "
			  "schaffst Du es!")),1;
	write(BS("Mit einem kleinen Ruck reisst Du ein langes Stueck Draht "
		 "aus dem Gitter heraus.\n"));

	ob=clone_object(OBJ "draht");

	if(ob->move(TP, M_SILENT)==ME_TOO_HEAVY)
	  {
	    ob->move(ME,M_NOCHECK);
	    write("Der Draht faellt Dir aus der Hand.\n");
	  }
	draht=1;
	return 1;
      }
    else
      return write(BS("Du laesst das Gitter besser ganz! Wer weiss, wie lange "
		      "Du hier noch bleiben musst.")),1;
}      

nosave int lockernfkt(string str)
{
  object ob;
  
  notify_fail("Was willst Du denn lockern?\n");
  if(!str) return 0;

  if(str=="stab"||str=="staebe"||str=="eisenstab"||str=="eisenstaebe")
    if(seq==FENSTER)
      {
	if(fenster) 
	  return write("Ein Eisenstab fehlt bereits, noch einer waere wohl "
		       "zuviel Arbeit.\n"),1;
	if(TP->QueryAttribute(A_STR)<random(12))
	  return write(BS("Du zerrst so fest wie nur moeglich an einem der "
			  "Staebe, doch schaffst es nicht ganz, ihn "
			  "herauszubrechen.")),1;
	write(BS("Mit einem festen Ruck schaffst Du es, einen der Eisenstaebe "
		 "zu lockern. Mit einem weiteren ziehst Du den Stab ganz "
		 "heraus und der Weg scheint frei zu sein..."));
	fenster=1;
	return 1;
      }
    else
      return write(BS("Du versuchst den Eisenstab zu lockern, doch er bewegt "
		      "sich kein Stueck...")),1;
  return 0;
}

nosave int nehmenfkt(string str)
{
  object ob;
  
  notify_fail("Was willst Du denn nehmen?\n");
  if(!str) return 0;
  
  if(str=="leintuch")
    if(seq==FENSTER||seq==WASSER)
      {
	if(leintuch_weg)
	  return write("Was fuer ein Leintuch meinst Du denn?\n"),1;

	write("Mit einem kleinen Ruck ziehst Du das Leintuch vom Bett ab.\n");

	ob=clone_object(OBJ "leintuch");

	if(ob->move(TP, M_SILENT)==ME_TOO_HEAVY)
	  {
	    ob->move(ME,M_NOCHECK);
	    write("Das Leintuch gleitet Dir aus der Hand.\n");
	  }
	else
	  write("Du schnappst Dir das Leintuch.\n");

	leintuch_weg=1;
	return 1;
      }
    else
      return write("Das willst Du lieber nicht angreifen.\n"),1;

  return 0;
}

nosave int stopfenfkt(string str)
{ 
  string foo,bar;
  object ob;

  notify_fail("Was willst Du denn wo hineinstopfen?\n");
  if(!str) return 0;
  
  if(sscanf(str,"%s in %s",foo,bar)!=2) return 0;
  
  if(bar=="klo"||bar=="klo hinein"||
     bar=="kloschuessel"||bar=="kloschuessel hinein"||
     bar=="schuessel"||bar=="schuessel hinein"||
     bar=="toilette"||bar=="toilette hinein"||
     bar=="toilettenschuessel"||bar=="toilettenschuessel hinein")
    if(ob=present(foo,TP)&&(foo=="tuch"||foo=="leintuch"))
      {
	if(seq!=WASSER) 
	  return write(BS("Du willst doch keine Ueberschwemmung riskieren!?")),1;
	
	ob->remove(1);
	
	write("Du verknotest das Leintuch und stopfst es in die kleine "
	      "Toilettenschuessel. Pass bloss auf, das koennte eine "
	      "Ueberschwemmung geben!\n");
	verstopft=1;
	return 1;
      }
    else
      return write("Irgendwie findest Du es nicht richtig, gerade das da "
		   "hineinzustopfen.\n"),1;
  return 0;
}

nosave int knuepfenfkt(string str)
{  
  object ob;
  
  if(!str) return write("Was willst Du denn woran knuepfen?\n"),1;

  if(str=="tuch an stab"||str=="leintuch an stab"||
     str=="tuch an eisenstab"||str=="leintuch an eisenstab"||
     str=="tuch an staebe"||str=="leintuch an staebe"||
     str=="tuch an eisenstaebe"||str=="leintuch an eisenstaebe")
    {
      if(!fenster)
	return write("Das hat doch keinen Sinn, denn durch die Eisenstaebe "
		     "wuerdest Du nie hindurchpassen!\n"),1;
      if(!ob=present("leintuch",TP))
	return write("Aber das hast Doch gar nicht bei Dir!\n"),1;
      
      leintuch_tied=1;
      write("Du knuepfst das Leintuch an einen der Eisenstaebe am Fenster "
	    "und laesst den Rest draussen herunterbaumeln. Nichts koennte "
	    "Dich jetzt noch von einer Flucht abhalten...\n");
      ob->remove();
      waechter(TP);
      return 1;
    }
  return write("Was willst Du denn woran knuepfen?\n"),1;
}

varargs void waechter(object victim)
{
  object ob;
  
  ob=clone_object(NPC "turmwaechter");
  ob->move(ME,M_NOCHECK|M_SILENT);
  tuer=1;
  if(victim)
    {
      write(BS("Ein Turmwaechter erkennt Dein Vorhaben und stuermt wuetend "
	       "herein..."));
      ob->Kill(victim);
    }
  else
    write(BS("*Knacks* hoerst Du das Schloss laut knacken als der "
	     "Turmwaechter deine Zelle betritt."));
}

string klo()
{
  if(verstopft)
    return "Die Toilette scheint mit irgendetwas verstopft worden zu sein!\n"
      "Eine kleine Spuelleine ist an der Rueckwand befestigt.\n";
  else
    return "Die Toilettenschuessel duerfte einmal weiss gewesen sein und "
      "verstopft scheint sie auch zu sein. Wuerde sie noch mehr verstopft "
      "werden, koennte das eine Ueberschwemmung geben. Eine kleine Spuelleine "
      "ist an der Rueckwand befestigt.\n";
}

nosave int spuelfkt(string str)
{
  notify_fail("An was willst Du denn ziehen?\n");
  if(!str) return 0;
  
  if(str=="leine"||str=="spuelleine"||str=="an leine"||str=="an spuelleine")
    {
      write(BS("Mit einem kraeftigen Ruck ziehst Du an der Spuelleine und es "
	       "ertoent ein lautes... WUUUUSSCCHHH!!!!..."));
      if(verstopft)
	{
	  write(BS("Irgendetwas scheint den Weg des Wassers zu behindern!! "
		   "Da rinnt es auch schon aus der Toilettenschuessel heraus "
		   "und eine Ueberschwemmung scheint sich anzubahnen..."));
	  call_out("ueberschwemmung",10);
	}
      return 1;
    }
  return 0;
}

void ueberschwemmung()
{
  tell_room(TO,
	    BS("Das laute Plaetschern des Wassers scheint draussen bemerkt "
	       "zu werden..."));
  waechter();
}

int QuerySeq()
{
  return seq;
}
