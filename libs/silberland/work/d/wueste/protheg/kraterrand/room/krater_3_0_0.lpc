// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Bei einem steinernen Turm");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich hier am Rande eines Kraters. "
	     "Hier sieht die Gegend ziemlich trostlos und verlassen aus. "
	     "Bis auf diesen riesigen Turm gibt es hier nichts was des "
	     "Untersuchens wert waere."));

  AddDetail("boden",
	    "Der sandige Boden brennt Dir unter deinen Fuessen und Du "
	    "bemerkst einige Fusspuren, die zu einer Tuer in dem Turm "
	    "fuehren.");

  AddDetail(({"himmel","ferne"}),
	    "In der Ferne siehst Du ein paar Voegel kreisen.");

  AddDetail("voegel",
	    "Die sehen eher aus wie Geier.");

  AddDetail(({"geier","aasgeier"}),
	    "Es duerfte sich sogar um Aasgeier handeln.");

  AddDetail(({"fuesse","fuss"}),
	    "Du huepfst andauernd von einem Fuss auf den anderen, um der "
	    "Hitze wenigstens etwas entgehen zu koennen.");

  AddDetail("hitze",
	    "Diese Hitze hier ist kaum auszuhalten!");

  AddDetail(({"krater","loch"}),
	    "Oestlich von Dir erstreckt sich ein grosses Loch, welches man "
	    "durchaus als riesigen Krater bezeichnen koennte.");

  AddDetail("rand",
	    "Du stehst hier am Rand eines ziemlich grossen Kraters, "
	    "hoffentlich schubst Dich da niemand hinunter...");

  AddDetail("gegend",
	    "Bis auf diesen Turm und den grossen Krater im Osten gibt es "
	    "hier absolut nichts ausser SAND!");

  AddDetail("sand",
	    "Sand Sand Sand Sand Sand ueberall nur Sand!!");

  AddDetail(({"untersuchen","muehe"}),
	    "Du brauchst Dir nicht solche Muehe zu geben, hier ist nichts.");

  AddDetail(({"tuer","holztuer"}),
	    "In den Turm ist unten eine massive Tuer aus Holz eingelassen.");

  AddDetail(({"holz","eichenholz"}),
	    "Es scheint sich um Eichenholz zu handeln.");

  AddDetail("turm",
	    "Vor Dir ragt ein gewaltiger Turm aus dem heissen Sand. Bis auf "
	    "eine Holztuer und ein paar, sehr hoch gelegenen, Fenstern ist "
	    "an ihm scheinbar nichts besonderes.");

  AddDetail(({"spuren","fusspuren"}),
	    "Die Fusspuren fuehren zu einer Holztuer im Turm.");

  AddDetail("fenster",
	    "Sie sind sehr weit oben und scheinen vergittert zu sein.");

  AddDetail("gitter",
	    "Von hier unten kannst Du nichts genaues erkennen...");

  AddCmd(CMD_OEFFNEN,"oeffnenfkt");

  AddExit("sueden",     ([EX_DEST:DESERT ":65:37",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("nordwesten", ([EX_DEST:DESERT ":64:35",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("suedwesten", ([EX_DEST:DESERT ":64:37",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("westen",     ([EX_DEST:DESERT ":64:36",
                        EX_TESTFUNC: "nopewueste"]));
  AddExit("norden",     KARAVANE "quaulkar");

  Ausgaenge("krater");
  Licht("hell");
  Umgebung("sehr_heiss", TT_DESERT);
}

nosave int oeffnenfkt(string str)
{
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;

  if(str=="tuer"||str=="holztuer")
    return write(BS("Du ziehst und ruettelst an der Holztuer, da ertoent eine "
		 "Stimme hinter der Tuer: \"Kein Eintritt Fremder!\"")), 1; 
  return 0;
}
