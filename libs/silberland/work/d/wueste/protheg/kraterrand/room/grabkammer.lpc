/*
  Questraum fuer Nftahgrab
  by PROtheG
*/

#include "../def.h"

inherit MOST "std_room";

nosave int sarkophag, leer;
nosave string truhe;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer dunklen Grabkammer");
  SetProp(P_INT_LONG, 
	  BS("Du betrittst eine dunkle und fuer Wuestenverhaeltnisse ziemlich "
	     "kuehle Grabkammer. Vor Dir befindet sich ein grosser Sarkophag "
	     "aus Stein. Irgendwie wirst Du das Gefuehl nicht los, dass Du "
	     "hier nicht alleine bist..."));

  AddDetail(({"steinplatten","boden","waende","wand"}),
	    "Der Boden und auch die Waende sind mit Steinplatten "
	    "ausgelegt. Im grossen und ganzen ein leerer Raum, oder hast Du "
	    "in einer Grabkammer etwas anderes erwartet?");

  AddDetail(({"kammer","grabkammer","raum"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"grad","wuestenverhaeltnisse","wueste"}),
	    "In der Wueste herrschen normalerweise an die 60 Grad, aber hier "
	    "unten ist es schon beinahe zu kalt.");

  AddDetail("gefuehl",
	    "Irgendetwas ist hier, hier in diesem Raum...");

  AddDetail("stein",
	    "Alles hier scheint aus Stein zu bestehen.");

  AddDetail(({"sarkophag","beine"}),
	    "Vor Dir steht ein grosser, auf zwei Beinen stehender "
	    "Sarkophag. An der Seite steht eine kleine Truhe.");

  AddDetail("seite",
	    "An einer Seite des Sarkophags steht eine kleine Truhe.");

  AddSpecialDetail("truhe","truhe");
  AddSpecialDetail(({"licht","decke"}),"decke");
  AddSpecialDetail("spalt","spalt");

  AddCmd("oeffne", "oeffnen");
  AddCmd(({"nehme","nehm","nimm"}),"nehmen");

  Licht("dunkel");
  Umgebung("kuehl", TT_CAVE, 1);

  sarkophag=0;
  truhe="";
  leer=0;

  AddExit("raus", ([EX_DEST:ROOM "gruft", EX_TESTFUNC:"tuerloeffnen"]));

  AddItem(NPC "unhold", REFRESH_DESTRUCT);
}

void init()
{
  ::init();
  
  if(interactive(TP))
    {
      if(ROOM "krater_0_2_0"->QueryGeputzt())
	Licht("duester");
      else
	Licht("dunkel");
    }
}

void reset()
{
  ::reset();

  if(leer)
    tell_room(TO, BS("Der Unhold legt seinen Schatz in eine Truhe."));
  
  sarkophag=0;
  truhe="";
  leer=0;

  RemoveDetail(({"gold","edelsteine","schatz","schaetze","leiche","nftah",
		   "toter","krieger","nftahehren","ehren", "ruestung", 
		   "schuhe", "fussbekleidung","helm","panzer","hose",
		   "armschienen", "beinschienen","handschuhe","kettchen",
		   "schild","kunstwerk"}));

  RemoveReadDetail(({"schild","name"}));
}

int tuerloeffnen()
{
  ROOM "gruft"->tuerloeffnen();

  return 1;
}

string truhe()
{
  if(strlen(truhe))
    if(leer)
      return "Die Truhe ist geoeffnet, aber leider leer.\n";
    else
      return "Die Truhe ist geoeffnet und voller Schaetze!!\n";
  return "Die Truhe scheint geschlossen zu sein.\n";
}

string decke()
{
  if(ROOM "krater_0_2_0"->QueryGeputzt())
    return BS("Die Decke besteht, wie alles hier aus Steinplatten, doch genau "
	      "ueber Dir kommt etwas Licht durch einen Spalt, aber es ist zu "
	      "wenig, um den Raum zu erhellen.");

  return BS("Der Boden, die Decke und auch die Waende sind mit Steinplatten "
	    "ausgelegt. Im grossen und ganzen ein leerer Raum, oder hast Du "
	    "in einer Grabkammer etwas anderes erwartet?");
}

string spalt()
{
  if(ROOM "krater_0_2_0"->QueryGeputzt())
    return BS("Durch einen Spalt in der Decke kommt ein wenig Licht hinein, "
	      "es reicht aber nicht, um den Raum zu erleuchten.");

  return "Sowas siehst Du da nicht!\n";
}

string namensschild()
{
  object qi;
  string n;
  
  if(qi=present("\ngrab_quest_item",TP))
    {
      qi->SetStat("gefunden");
      return BS("Auf dem Schild steht ein Name: Nftah "+
		CAP(qi->QueryNftahName())+" Ngoha.");
    }

  return BS("Das Schild ist leider total verrostet und unleserlich!");
}

nosave int oeffnen(string str)
{
  object key;
  
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;

  if(str=="sarkophag"||str=="grab"||str=="grabmal")
    {
      if(sarkophag)
	return write(BS("Der Sarkophag wurde bereits geoffnet.")),1;

      if(present("\nunhold",TO))
	return 
	  write(BS("Als Du Dich dem Sarkophag naeherst, um ihn zu oeffnen "
		   "macht der Unhold ploetzlich einen Satz nach vorne "
		   "und Du faellst erschrocken nach hinten. Da wirst Du Dir "
		   "wohl etwas ueberlegen muessen, um den Unhold "
		   "loszuwerden.")),1;

      write(BS("Du naeherst Dich vorsichtig dem Sarkophag und oeffnest ihn "
	       "mit grosser Muehe. Darin liegt ein Nftah, oder besser, das "
	       "was von ihm noch uebrig ist..."));

      AddDetail(({"leiche","nftah","toter","krieger"}),
		"Der tote Nftah wurde mit allen Nftahehren in seiner "
		"Ruestung begraben.");

      AddDetail(({"nftahehren","ehren"}),
		"Die Nftah pflegen ihre Krieger in voller Ruestung zu "
		"begraben.");

      AddDetail("ruestung",
		"Du siehst alles, was man fuer eine Ruestung braucht: Helm, "
		"Panzer, Hose, Arm- und Beinschienen und Handschuhe.");

      AddDetail(({"schuhe","fussbekleidung"}),
		"Die Nftah brauchen soetwas nicht.");

      AddDetail(({"helm","panzer","hose","armschienen","beinschienen"}),
		"Ein prachtvolles Kunstwerk, aber es gehoert dem Toten...");

      AddDetail("kunstwerk",
		"Hmm, die Handschuhe sehen besonders schoen aus...");

      AddDetail("handschuhe",
		"Ganz normale Kettenhandschuhe, doch was ist das? An "
		"einem Handschuh ist ein kleines Schild an einem Kettchen "
		"befestigt.");

      AddDetail("kettchen",
		"An dem Kettchen scheint ein kleines Schild befestigt zu "
		"sein.");

      AddDetail("schild",
		"Da steht was drauf...");

      AddReadDetail(({"schild","name"}), CLOSURE(namensschild));

      sarkophag=1;

      return 1;
    }
  
  if((str=="truhe")||(str=="truhe mit schluessel"))
    {
      if(strlen(truhe))
	return write(BS("Aber die Truhe ist doch schon geoeffnet!")),1;

      if(!key=present("\nunholdtruhenschluessel",TP))
	return write(BS("Das Schloss bewegt sich kein Stueck! Da fehlt wohl "
			"ein Schluessel.")+
		     BS("Ob Barlogor was darueber weiss?\n")), 1;
      
      truhe=getuid(TP);
      
      write(break_string(
       "Du steckst den Schluessel in das kleine Schloss und drehst ihn "
       "um.\n*KNACKS*\nDu beruehrst den Deckel, als er auch schon ganz "
       "von alleine aufspringt und seine, im Inneren verborgenen "
       "Schaetze preisgibt. Der Schluessel ist jedoch zerbrochen und Du "
       "wirfst ihn weg.\n",78,"",1));
      
      say(BS(TPN+" oeffnet eine kleine Truhe."), ({TP}));
      
      AddDetail(({"schatz","schaetze","gold","edelsteine"}),
		"Die Truhe ist randvoll an Gold und Edelsteinen.");
      
      key->remove();
      
      return 1;
    }
  return 0;
}

nosave int nehmen(string str)
{
  object ob, unhold;
  string was, woraus;

  notify_fail(BS("Was willst Du denn nehmen?"));
  if(!str) return 0;

  if(member(({"alles","schatz","schaetze","gold","goldschatz",
		"goldschaetze","edelstein","edelsteine",
		"edelsteinschatz","edelsteinschaetze", 
		"gold und edelsteine"}), str)!=-1)
    return write(BS("Willst Du den Schatz aus der Truhe nehmen?")), 0;
  
  if(sscanf(str, "%s aus %s", was, woraus)!=2) return 0;
  
  if(member(({"alles","schatz","schaetze","gold","goldschatz",
		"goldschaetze","edelstein","edelsteine",
		"edelsteinschatz","edelsteinschaetze", 
		"gold und edelsteine"}),
	    was)==-1) return 0;

  if(member(({"truhe","schatztruhe"}), woraus)==-1) return 0;

  if(!strlen(truhe)) return 0;
  
  if(leer)
    return write(BS("Aber die Truhe ist doch leer!?")),1;
  
  if(truhe!=getuid(TP))
    return write(BS(CAP(truhe)+" hat diesen Schatz entdeckt! Also darf "
		    "nur "+CAP(truhe)+" ihn nehmen!")), 1;
  
  write(BS("Gierig fasst Du in die Truhe und steckst den gesamten "
	   "Schatz in Deine Taschen..."));
  
  ob=clone_object(OBJ "q_schatz");
  
  if(ob->move(TP, M_SILENT)==ME_TOO_HEAVY)
    {
      ob->remove(1);
      write(BS("Doch der Schatz ist Dir zu schwer, daher laesst Du "
	       "ihn in der Truhe zurueck."));
      return 1;
    }
  
  say(BS(TPN+" entnimmt einer Truhe etwas."),TP);
  
  if(unhold=present("unhold",TO))
    {
      tell_room(TO, BS("Der Unhold bruellt wuetend auf."));
      TP->AddPursuer(unhold);
    }
  
  leer=1;
  
  return 1;
}

int SchatzDa()
{
  if(leer) return 0;
  else return 1;
}
