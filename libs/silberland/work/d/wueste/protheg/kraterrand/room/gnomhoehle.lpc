// by PROtheG

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Hoehle im Kraterrand");
  SetProp(P_INT_LONG, 
	  BS("Ploetzlich findest Du Dich in einer kleinen Hoehle wieder...")+
	  BS("Ein staehlernes Tor scheint in die Hoehlenwaende eingesetzt zu "
	     "sein. An den Waenden glitzern hunderte Diamanten, die den "
	     "Hoehleneingang erhellen. Weiters sind noch zwei grosse "
	     "Fackelhalter mit brennenden Fackeln aufgestellt, die in der "
	     "Hoehle ein gewisses schauriges Leuchten erzeugen..."));

  AddDetail(({"boden","decke","hoehlenwaende","waende"}),
	    "Ueberall sieht man das Glitzern und Funkeln von Diamanten, die "
	    "nur darauf warten, aus dem Gestein herausgebrochen zu werden...");

  AddDetail("hoehle",
	    ME->QueryProp(P_INT_LONG));

  AddDetail(({"steinchen","diamanten"}),
	    "Kleine, funkelnde und aeusserst wertvolle Steinchen... Dich "
	    "juckt es in den Fingern, wenn Du nur an sie denkst!");

  AddDetail("fackeln",
	    "Ein seltsames, kuehles Flackern geht von den Fackeln aus...");

  AddDetail(({"licht","flackern"}),
	    "Als waere diese Flamme nicht von dieser Welt...");

  AddDetail("flamme",
	    "Je laenger Du sie betrachtest, desto unruhiger wirst Du...");

  AddDetail("welt",
	    "Diese Flamme scheint nicht aus dem Silberland zu kommen...");

  AddDetail(({"halter","fackelhalter"}),
	    "Sehr stabil aussehende Fackelhalter, an denen jeweils sechs "
	    "Fackeln befestigt sind.");

  AddDetail(({"finger","jucken"}),
	    "Du verspuerst ein leichtes Jucken, wenn Du an die Diamanten in "
	    "den Waenden denkst...");

  AddDetail(({"glitzern","funkeln"}),
	    "Die Diamanten funkeln in dem eigenartigen Licht, welches von den "
	    "Fackeln auszugehen scheint.");

  AddDetail(({"blau","leuchten"}),
	    "Die ganze Hoehle ist in ein ungewoehnliches Blau gehuellt, "
	    "welches von den Fackeln auszugehen scheint...");

  AddDetail("silberland",
	    "Woher die Flamme wohl gekommen ist?");

  AddDetail(({"wand","hoehlenwand"}),
	    "In die hintere Hoehlenwand ist ein massives Stahltor "
	    "eingelassen.");

  AddDetail(({"tor","stahltor"}),
	    "Ein Tor aus reinstem Stahl scheint zu verhindern, dass Jemand "
	    "weiter in die Hoehle vordringen kann, oder etwa dass Etwas nicht "
	    "hinaus kann...");

  AddDetail("etwas",
	    "Bei solch einem Tor duerfte das \"Etwas\" ziemlich stark "
	    "sein...");

  AddDetail(({"jemand","wesen"}),
	    "Jemand wie Du!");

  AddDetail(({"stahl","zwergenstahl"}),
	    "Reinster Stahl, wie man es nur bei Zwergen findet.");

  AddDetail(({"zwerge","zwerg"}),
	    "Nur Zwerge koennen echten Zwergenstahl schmieden!");

  AddDetail(({"gestein","vulkangestein"}),
	    "Viele kleine Diamanten reifen hier in diesem uralten "
	    "Vulkangestein und warten nur darauf, von einem fleissigen Wesen "
	    "herausgebrochen zu werden...");

  AddDetail(({"rand","eingang","hoehleneingang"}),
	    "Du blickst ueber den Rand des Hoehleneingangs, doch zurueck "
	    "hinauf wirst Du es wohl nicht mehr schaffen und hinunterspringen "
	    "haeltst Du fuer keine gute Idee...\n"
	    "Es muss wohl einen anderen Weg geben.");

  AddDetail(({"tiefe","idee"}),
	    "Du blickst noch einmal in die Tiefe... und laesst es dann doch "
	    "lieber. Scheint keine gute Idee zu sein da runter zu springen.");

  AddDetail("weg",
	    "Irgendeinen gibt es sicher!");

  AddCmd(CMD_NEHMEN, "notake");
  AddCmd(CMD_OEFFNEN, "noselfopen");

  Licht("hell");
  Umgebung("warm", TT_CAVE, 1);

  AddItem(NPC "entrygnom",REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  RemoveExit("tor");
}

string GetExits() 
{
  if(!sizeof(QueryProp(P_EXITS))) return "";
  else return ::GetExits();
}

nosave int notake(string str)
{
  if(!str) return 0;

  if(!present(str,TO) && (str=="fackel"||str=="fackeln"))
    return write(BS("Du willst die Fackeln lieber nicht beruehren...")), 1;

  return 0;
}

nosave int noselfopen(string str)
{
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;

  if(str=="tor"||str=="stahltor")
    return write(BS("Leider erkennst Du keine Moeglichkeit, dieses Tor zu "
		    "oeffnen und Du wendest Dich enttaeuscht ab...")), 1;

  return 0;
}
