/* 
   Questraum fuer Nftahgrab
   by PROtheG
*/

#include "../def.h"

inherit MOST "std_room";

nosave int statue, vor_kurzem_geoeffnet;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer duesteren Familiengruft");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich nun hier in der Familiengruft der Ngoha. "
	     "Dich froestelt bei dem Gedanken an die vielen Toten, die Dich "
	     "umgeben. Die Gruft sieht auf den ersten Blick, bis auf einen "
	     "grossen Sarkophag ziemlich leer aus, doch dann erkennst Du, "
	     "dass in die Waende viele kleine Tuerchen eingebaut sind. "
	     "Dahinter werden wohl die toten Nftah begraben sein..."));

  AddDetail(({"boden","steinplatten","platten","platte","decke"}),
	    "Der Boden und die Decke sind mit quadratischen Steinplatten "
	    "ausgelegt worden.");

  AddDetail("blick",
	    "Auf den ersten Blick sieht der Raum hier vollkommen leer aus.");

  AddDetail(({"gruft","familiengruft","raum"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"ngoha","ngohafamilie"}),
	    "Ja, diese Gruft gehoert der Ngohafamilie.");

  AddDetail(({"angst","gedanke","gedanken"}),
	    ([ 0:"Du zitterst vor Angst.", "dunkelelf":"Du geniesst es."]));

  AddDetail(({"nftah","tote","toten"}),
	    "Wenn sich hinter jedem Tuerchen ein Grab befindet, dann liegen "
	    "hier nicht weniger als einhundert Nftah begraben.");

  AddDetail(({"waende","steinwaende"}),
	    "Kleine Tuerchen aus Stein wurden in die Steinwaende "
	    "eingelassen.");

  AddDetail("stein",
	    "Alles hier scheint aus Stein zu sein.");

  AddDetail(({"tuerchen","steintuerchen"}),
	    "Viele kleine Tuerchen sind in die steinernen Waende der Gruft "
	    "eingelassen. Hinter jedem Tuerchen ist ein Grab.");

  AddDetail(({"sarkophag","mitte"}),
	    "In der Mitte des Raumes steht ein steinerner Sarkophag mit "
	    "zahlreichen Verzierungen und einer kleinen Statue auf der einen "
	    "Seite. Ein kleines Familienwappen prangt an der Frontseite.");

  AddDetail(({"szene","kampfszene","verzierung","verzierungen"}),
	    "Die Verzierungen stellen eine Kampfszene dar, bei der die Nftah "
	    "gegen zwei riesige Drachen kaempfen.");

  AddDetail(({"ngohagrab","ngohagraeber","grab","graeber"}),
	    "Hier gibt es davon mindestens einhundert, suchst Du ein "
	    "Bestimmtes?");

  AddDetail(({"grolog","fanglor","nahalor","grologgrab","fanglorgrab",
		"nahalorgrab"}),
	    "Sein Grab ist hier sicher auch irgendwo...");

  AddDetail(({"drache","drachen"}),
	    "Sie scheinen sich in einer grossen Hoehle zu befinden.");

  AddDetail("hoehle",
	    "Ob die hier irgendwo in der Naehe ist?!");

  AddDetail("naehe",
	    "Vielleicht sogar gleich hier unter Dir...");

  AddDetail(({"steinwand","wand"}),
	    "Die gesamten Waende sind eigentlich nur eine Wand, denn der "
	    "Raum ist kreisrund und hat keine Ecken.");

  AddDetail(({"ecke","ecken"}),
	    "Die siehst Du hier nicht.");

  AddDetail("statue",
	    "Das ist eine kleine Statue, die eigentlich oben auf einem "
	    "Grabstein und nicht auf so einem Sarkophag sitzen sollte. "
	    "Sie stellt offenbar 'Gralmgrog', einen Hausgott der Nftah dar.");

  AddDetail("gralmgrog",
	    "Gralmgrog ist einer der vielen Nftah Hausgoetter.");

  AddDetail(({"hausgott","hausgoetter"}),
	    "Die Nftah pflegen, sehr viele Hausgoetter anzubeten.");

  AddDetail(({"grabstein","grabsteine"}),
	    "Grabsteine stehen normalerweise draussen...");

  AddDetail("seite",
	    "Welche Seite meinst Du denn, die West- oder die Ostseite, des "
	    "Sarkophags?");

  AddDetail(({"sarkophagplatte"}),
	    "Der Sarkophag ist mit einer sehr schoen verzierten "
	    "Sarkophagplatte versehen.");

  AddDetail("westseite",
	    "Eine kleine Statue ist auf der Westseite der Sarkophagplatte "
	    "befestigt.");

  AddDetail(({"wappen","familienwappen","frontseite"}),
	    "Das Wappen an der Frontseite des Sarkophags scheint auch "
	    "drehbar zu sein.");

  AddSpecialDetail(({"sockel","ostseite"}), "statuefkt");

  AddDetail(({"ueberreste","haufen","geruempel","ueberrest"}),
	    "Das sieht aus wie die Ueberreste einer Statue oder einer "
	    "kleinen Figur, wahrscheinlich sogar eine Kopie der auf der "
	    "Westseite stehenden Statue.");

  AddDetail("figur",
	    "Viel kann man da leider nicht mehr erkennen.");

  AddDetail("kopie",
	    "Teile der Ueberreste sehen der Statue doch sehr aehnlich.");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst ein leises Rumpeln hinter der Wand.");

  AddSound(({"rumpeln","richtung"}),
	   "Du kannst leider nicht genau erkennen, aus welcher Richtung das "
	   "Rumpeln kommt.");

  AddSmell(DEFAULT_SMELL,
	   "Ein gewisser, undeutbarer Gestank erfuellt den Raum.");

  AddSmell(({"gestank","schluss"}),
	   "Du schnupperst ein wenig herum und kommst dann zu dem Schluss, "
	   "dass der Gestank hinter dem Tuerchen mit dem Heptagramm "
	   "hervorkommt.");

  AddSmell(({"heptagramm","heptagram"}),
	   "Probiers mal mit untersuchen...");

  AddDetail(({"heptagramm","heptagram"}),
	    "Es steht ein wenig hervor...");

  AddDetail("spalt",
	    "Ob man sich durch den hindurchzwaengen koennte?");

  AddDetail("steinplatte",
	    "Eine schwere Steinplatte bildet den Ausgang aus der "
	    "Ngohagruft.");
  
  Licht("duester");
  Umgebung("kuehl", TT_CAVE, 1);  
  
  AddCmd(({"drehe","dreh"}), "gruft");
  AddCmd(({"stelle","stell"}), "tuerchen");
  AddCmd(({"drueck","druecke"}), "fake");
  AddCmd(({"durchsuche","durchsuch","durchwuehle","durchwuehl"}),
	 "durchsuchen");
  AddCmd(({"schluepfe","schluepf","kriech","krieche","zwaenge","zwaeng"}),
	 "zwaengen");

  statue=0;
}

varargs void schliesse_grabkammer(int flag)
{
  RemoveDetail(({"grabkammer"}));
  
  RemoveExit("grabkammer");

  if(flag)
    tell_room(TO,
	      BS("Ein junger Nftah kommt herein und sieht sich um.")+
	      BS("Der junge Nftah erblickt die Tuer zur Grabkammer und "
		 "schliesst sie."));
}

void reset()
{
  ::reset();

  if(statue)
    tell_room(TO, 
	      BS("Du stoesst unabsichtlich eine kleine Statue um. Diese "
		 "faellt zu Boden und zerbricht dabei in viele kleine "
		 "Einzelteile."));
  
  statue=0;
  
  if(vor_kurzem_geoeffnet < time())
    schliesse_grabkammer();
}

nosave int fake(string str)
{
  notify_fail(BS("Was willst Du denn druecken?"));
  if(!str) return 0;
  
  if(str=="heptagramm")
    return write(BS("Voller Erwartung drueckst Du auf das Heptagramm, doch "
		    "nichts geschieht... oder?")),1;
  return 0;
}

nosave int durchsuchen(string str)
{
  notify_fail(BS("Was willst Du denn durchsuchen?"));
  if(!str) return 0;
  
  if(str=="ueberrest"||str=="ueberreste")
    return write(BS("Du durchwuehlst die Ueberreste der kaputten Statue, "
		    "doch Du findest nichts.")),1;
  return 0;
}

nosave int gruft(string str)
{
  notify_fail(BS("Was willst Du denn drehen?"));
  if(!str) return 0;

  if(str=="wappen"||str=="an wappen"||
     str=="ngohawappen"||str=="an ngohawappen"||
     str=="ngohafamilienwappen"||str=="an ngohafamilienwappen")
    return write(BS("Das Wappen wurde bereits gedreht, sonst waere ja der "
		    "Spalt nicht da.")),1;
  
  return 0;
}

nosave int zwaengen(string str)
{
  notify_fail("Wo willst Du Dich hindurchzwaengen?\n");
  if(!str) return 0;

  if(str=="durch spalt"||str=="in spalt"||str=="durch spalt hindurch"||
     str=="durch spalte"||str=="in spalte"||str=="durch spalte hindurch"||
     str=="in spalt hinein"||str=="in spalte hinein")
    {
      write(BS("Der Spalt ist recht schmal, doch die Steinplatte kann man "
	       "muehelos bewegen, deswegen hast Du keine Probleme "
	       "hineinzugelangen.\n"));
      TP->move(ROOM "krater_0_2_0",M_GO,"","verschwindet lautlos","kommt an");

      ROOM "krater_0_2_0"->oeffne_sesam();

      return 1;
    }
  return 0;
}

string statuefkt()
{
  if(statue)
    return BS("Eine kleine Statue ist auf der Ostseite der Sarkophagplatte "
	      "befestigt.");
  return BS("Ein kleiner leerer Sockel prangt an der Ostseite der "
	    "Sarkophagplatte. Gleich daneben liegt ein kleiner Haufen "
	    "Geruempel, der wohl einmal eine Statue, wie sie an der "
	    "Westseite steht, darstellen sollte... Ob man auf den Sockel "
	    "etwas raufstellen koennte?");
}

void tuerloeffnen()
{
  AddDetail(({"grabkammer","eingang"}),
	    "Wer wohl da drinnen liegen mag?\n");
  
  AddExit("grabkammer", "in eine Grabkammer#" ROOM "grabkammer");  
}

nosave int tuerchen(string str)
{
  object ob;
  string w;
  
  notify_fail(BS("Was willst Du denn worauf stellen?"));
  if(!str) return 0;
  
  if(sscanf(str, "%s auf sockel", w)!=1) return 0;
  
  if(statue)
    return write(BS("Aber da steht doch bereits eine Statue auf dem "
		    "Sockel.")),1;

  if(!ob=present(w,TP))
    return write(BS("Das hast Du doch gar nicht bei Dir!")), 1;

  if(!ob->id("\ngrabqueststatue"))
    return write(BS("Du bist Dir nicht genau sicher, ob Du das da raufstellen "
		    "solltest!")),1;

  if(!ob->QueryGeputzt())
    return write(BS("So eine schmutzige Statue? Du koenntest Halrot "
		    "erzuernen!")),1;
  
  statue=1;

  vor_kurzem_geoeffnet=time()+60*60;
  
  ob->remove(1);
  
  tuerloeffnen();

  write(BS("Du stellst die Statue vorsichtig auf den Sockel und vernimmst ein "
	   "leises <klick>. Du siehst Dich um und findest nach einiger Zeit "
	   "die Grabkammer, die am ehesten zu der oberen Position der "
	   "Grabplatte passt und oeffnest das Tuerchen zur dahinter "
	   "liegenden Grabkammer."));
      
  return 1;
}

string GetExits(object viewer) 
{ 
  if(!sizeof(QueryProp(P_EXITS)))
    return "";
  else
    return ::GetExits(viewer);
}
