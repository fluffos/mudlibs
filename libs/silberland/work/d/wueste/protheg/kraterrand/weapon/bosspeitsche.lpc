#include "../def.h"

inherit "std/weapon";

nosave int next;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine genoppte Lederpeitsche");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du eine leichte, aber sehr widerstands"
	     "faehige Peitsche, deren unteres Ende ein lederner fester Griff "
	     "bildet und am anderen Ende aus vielen kleinen, mit Silbernoppen "
	     "bestueckten Lederfransen besteht."));

  SetProp(P_INFO, 
	  BS("Diese Peitsche ist nicht nur eine gute Waffe, sondern auch ein "
	     "sehr beliebtes Foltermittel. Am liebsten wuerdest Du sofort "
	     "jemanden so richtig auspeitschen."));

  SetProp(P_NAME, "Lederpeitsche");
  SetProp(P_NAME_ADJ, "genoppt");
  AddAdjective(({"genoppte","genoppten"}));
  SetProp(P_GENDER, FEMALE);
  AddId(({"peitsche", "lederpeitsche"}));

/*
  AddDetail("griff",
	    "");
*/

  SetProp(P_WEAPON_TYPE, WT_WHIP);
  SetProp(P_WC, 160);
  SetProp(P_DAM_TYPE, DT_WHIP);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:95, MAT_SILVER:5]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WC_FIX, 33);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:14]));

  AddCmd(({"peitsche","peitsch"}), "auspeitschen");

  next=0;
}

int HitFunc(object enemy)
{
  object pl;

  if((objectp(pl=QueryProp(P_WIELDED))) && 
     (random(enemy->QueryAttribute(A_DEX)) < pl->QueryAttribute(A_DEX)) &&
     (!random(3)))
    {
      tell_room(ENV(enemy), 
		BS(enemy->Name(WER,1)+" jault auf unter den "
		   "Peitschenhieben..."));
      return pl->QueryAttribute(A_STR)+random(20);
    }
}

nosave int auspeitschen(string str)
{
  int o,al;
  string foo;
  object op,pun;

  notify_fail(BS("Wen willst Du denn auspeitschen?"));
  if(!str) return 0;

  if(sscanf(str,"%s aus",foo)!=1) return 0;

  if(!op=present(foo, ENV(TP)))
    return write(BS("Aber "+CAP(foo)+" ist doch gar nicht da!?")), 1;

  pun=QueryProp(P_WIELDED);
  if(TP!=pun)
    return write(BS("Du solltest Die Peitsche vielleicht erst einmal "
		    "zuecken!")), 1;
  
  if(time() > next)
    return write(BS("Pass auf mit dem Auspeitschen! Du willst die Peitsche "
		    "ja nicht beschaedigen...")), 1;
  
  if(TP->InFight())
    return write(BS("Darauf kannst Du Dich waehrend eines Kampfes nicht "
		    "konzentrieren.")), 1;
  
  if(op==pun)
    {
      write(BS("Du verdrehst Deinen Arm etwas und faengst an, beherzt auf "
	       "Dich einzuschlagen bis entweder Dein Arm oder Dein "
	       "Schmerzzentrum aufgibt...")+
	    BS("AAAH, hat das gut getan!!"));

      tell_room(ENV(pun),
		BS(pun->Name(WER,1)+" schwingt seine Peitsche und schlaegt "
		   "auf ein, bis "+pun->QueryPronoun(WER)+" erschoepft und "
		   "mit schmerzverzerrtem Gesicht zusammenbricht."), ({pun}));

      pun->AddHp(-random(4));

      return 1;
    }

  o=random(3);

  write(({BS("Du hebst Deine Peitsche und versetzt "+op->Name(WEM,1)+
	     " einen maechtigen Peitschenhieb, dass "+op->QueryPronoun(WER)+
	     " sich nur so vor Schmerzen windet."),
	    
	    BS(op->Name(WESSEN,1)+" Koerper zuckt schmerzvoll unter Deinen "
	       "Schlaegen, doch irgendwie schreit "+op->QueryPronoun(WER)+
	       " auch nach meeehr..."),

	    BS("Mit einem hoellischen Grinsen auf Deinen Lippen pruegelst Du "
	       "auf "+op->Name(WEN,1)+" ein und pruegelst und pruegelst und "
	       "kannst gar nicht mehr aufhoeren so sehr gefaellt es Dir "+
	       op->QueryPronoun(WEN)+" zu verpruegeln und "+
	       op->QueryPronoun(WEN)+" roecheln zu sehen...")})[o]);
  
  tell_room(ENV(op),
	    ({BS(pun->Name(WER,1)+" hebt "+pun->QueryPossPronoun(FEMALE,WEN)+
		 " Peitsche und versetzt "+op->Name(WEM,1)+" einen "
		 "maechtigen Peitschenhieb, dass "+op->QueryPronoun(WER)+
		 " sich nur so vor Schmerzen windet."),

		BS(op->Name(WESSEN,1)+" Koerper zuckt schmerzvoll unter "+
		   pun->Name(WESSEN,1)+" Schlaegen, doch irgendwie schreit "+
		   op->QueryPronoun(WER)+" auch nach meeehr..."),

		BS("Mit einem hoellischen Grinsen auf "+
		   pun->QueryPossPronoun(FEMALE,2,PLURAL)+
		   " Lippen pruegelt "+pun->Name(WER,1)+" auf "+
		   op->Name(WEN,1)+" ein und pruegelt und pruegelt und kann "
		   "gar nicht mehr aufhoeren so sehr gefaellt es "+
		   pun->QueryPronoun(WEM)+" "+op->Name(WEN,1)+
		   " zu verpruegeln und roecheln zu sehen...")})[o],
	    ({pun,op}));

  tell_object(op, 
	      ({BS(pun->Name(WER,1)+" hebt "+pun->QueryPossPronoun(FEMALE,WEN)+
		   " Peitsche und versetzt Dir einen maechtigen "
		   "Peitschenhieb, dass Du Dich nur so vor Schmerzen "
		   "windest."),
		  
		  BS("Dein Koerper zuckt schmerzvoll unter "+
		     pun->Name(WESSEN,1)+" Schlaegen, doch es scheint Dir "
		     "zu gefallen und Du lechzt nach meeehr..."),

		  BS("Mit einem hoellischen Grinsen auf "+
		     pun->QueryPossPronoun(FEMALE,2,PLURAL)+
		     " Lippen pruegelt "+pun->Name(WER,1)+" auf Dich ein "
		     "und pruegelt und pruegelt und kann gar nicht mehr "
		     "aufhoeren so sehr gefaellt es "+pun->QueryPronoun(WEM)+
		     " Dich zu verpruegeln und roecheln zu sehen...")})[o]);
  
  al=pun->QueryProp(P_ALIGN);

  if(al>-300)
    {
      pun->SetProp(P_ALIGN, al-10);
      pun->AddSp(-2);
    }
  
  next=time()+5;
  
  return 1;
}
