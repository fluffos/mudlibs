#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Obstmesser");
  SetProp(P_LONG, 
	  "Ein kleines, aber ziemlich scharf aussehendes Obstmesser. Als "
	  "Waffe ist es nicht sehr gut geeignet, ist ja schliesslich kein "
	  "Dolch, sondern ein Obstmesser.");

  SetProp(P_NAME, "Obstmesser");
  SetProp(P_GENDER, NEUTER);
  AddId(({"messer","obstmesser"}));

  SetProp(P_VALUE, 150);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 25);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 75);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WC_FIX, 10);
  SetProp(P_MATERIAL, ([MAT_TICTOC_WOOD:15,MAT_LEATHER:10,MAT_STEEL:75]));
}
