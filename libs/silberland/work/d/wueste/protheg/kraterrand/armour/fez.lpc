/*
  Amans Fez
*/

#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein roter Fez");
  SetProp(P_LONG,  
	  BS("Ein lustig aussehender kleiner Fez mit einer schwarzen Quaste "
	     "oben drauf."));
  SetProp(P_NAME, "Fez");
  SetProp(P_NAME_ADJ "rot");
  AddAdjective(({"roter","roten"}));

  SetProp(P_GENDER, MALE);
  AddId(({"fez", "roter fez"}));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);

  SetProp(P_MATERIAL, ([MAT_FELT:80,MAT_COTTON:20]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-1,T_HEAT_PROT:3]));
}
