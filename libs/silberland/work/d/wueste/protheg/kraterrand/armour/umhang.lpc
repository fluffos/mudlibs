/*
  Amans Seidenumhang
*/

#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein seidener Umhang");
  SetProp(P_LONG,  
	  BS("Ein ziemlich kleiner und abgetragener seidener Umhang. Er "
	     "hat bereits einige Loecher."));

  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId(({"umhang", "seidenumhang","seidener umhang"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 100);  
  SetProp(P_VALUE, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-3, T_HEAT_PROT:5 ]));
}
