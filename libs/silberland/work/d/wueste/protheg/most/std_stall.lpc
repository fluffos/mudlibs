// by PROtheG
// Std-inherit-file fuer den Kamelstall

#include <properties.h>
#include "../def.h"

inherit "std/room";
inherit MOST "std_room";

create()
{
  ::create();
  set_light("duester");
  set_temp("kuehl");
  SetProp(P_INT_SHORT, "Im Kamelstall");
  SetProp(P_INT_LONG, 
	  "Du stehst hier in einem kleineren Teil des Kamelstalles und "+
	  "wunderst Dich, woher hier dieser ganze Gestank kommt. Ueber"+
	  "all am Boden stapeln sich Heuballen und allerhand stinkendes "+
	  "undefinierbares Zeug!\n");
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, 
	  ([ENV_TERRAIN:TT_CAVE]));
  AddSound(({DEFAULT_SOUND}),
	   "Ab und zu hoerst Du einen Wassertropfen von der Decke fallen.\n");
  AddDetail("boden",
	    "Du kannst nicht genau erkennen, ob das der Boden ist, oder "+
	    "nur eine weitere Schicht Dreck.\n");
  AddDetail("decke",
	    "Die Decke haengt ziemlich tief, doch du kannst trotzdem nichts "+
	    "genaueres entdecken!\n");
}
