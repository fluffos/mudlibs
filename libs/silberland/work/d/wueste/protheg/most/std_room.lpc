#pragma strong_types

#include "../def.h"

#define RICHTUNGENS ({"nordost","nordwest","suedwest","suedost", \
                     "nordostob","nordwestob","suedwestob","suedostob", \
                     "nordostunt","nordwestunt","suedwestunt","suedostunt"})
#define RICHTUNGENG ({"nord","west","sued","ost", \
                     "nordob","westob","suedob","ostob", \
                     "nordunt","westunt","suedunt","ostunt"})
#define RICHTUNGENO ({"ob","unt"})
#define RICHTUNGEN RICHTUNGENS+RICHTUNGENG+RICHTUNGENO
#define X "_"

#define HZM "/d/unterwelt/protheg/avmitte/room/hzm"

inherit "std/room";
inherit MOST "std_things";

void create()
{
  ::create();
}

void init()
{
  ::init();
  
  if((TP) && (interactive(TP)) && (TP->QueryProp(P_GHOST)) && (!random(3)))
    {
      call_out("geisterfaenger", 4, TP, ME);
  
      tell_object(TP,
		  BS("Ploetzlich umfaengt Dich ein seltsames Gefuehl...")+
		  "\n\n\n"+
		  BS("Dir ist als wuerde Dich etwas verfolgen...")+
		  "\n\n\n");
      
      DB("*** Geisterfaenger: "+sprintf("%O in %O\n", TP, ME));
    }
  
  call_other(HZM, "???");
}

void geisterfaenger(object who, object where)
{
  if(!objectp(who)) return;
  if(!objectp(where)) return;
  if(!ENV(who)) return;
  if(ENV(who)!=where) return;
  if(!who->QueryProp(P_GHOST)) return;
  if(IS_WIZARD(who)) return;
  
  tell_object(who,
	      BS("Ploetzlich materialisiert sich vor Dir ein gewaltiges "
		 "Wesen...")+
	      BS("Das Wesen bruellt: 'Ein Geist!'")+
	      BS("Das Wesen bruellt: 'Ab zum TOD mit Dir!'"));
  
  SetProp(P_KILL_NAME, "Ein Geisterjaeger");
  
  who->move("/room/death/death_room", M_NOCHECK);
}

void Licht(string l)
{
  int licht;
  
  switch(l)
    {
    case "sehr_dunkel": 
      licht=-3-random(3);
      break;
    case "dunkel": 
      licht=-1-random(2);
      break;
    case "duester": 
      licht=0; 
      break;
    case "hell": 
      licht=1+random(2);
      break;
    case "sehr_hell": 
      licht=3+random(3);
      break;
    default: 
      DB("Unzulaessiger Lichtlevel: "+l+"\n"); 
      return;
    }

  SetProp(P_LIGHT, licht);
}

void set_light(mixed str)
{
  //  if(intp(str)) return ::set_light(str);
  
  DB(BS("*** Alter Aufruf von set_light in "+file_name(ME)));
  
  return Licht(str);
}

varargs void Umgebung(string tmp, int terr, int room)
{
  int temp;

  switch(tmp)
    {
    case "eisig": 
      temp=-10-random(10);
      break;
    case "sehr_kalt": 
      temp=-1-random(10);
      break;
    case "kalt": 
      temp=0+random(10);
      break;
    case "kuehl": 
      temp=10+random(5);
      break;
    case "maessig": 
      temp=15+random(5);
      break;
    case "warm": 
      temp=20+random(5);
      break;
    case "heiss": 
      temp=30+random(10);
      break;
    case "sehr_heiss": 
      temp=40+random(10);
      break;
    default: 
      DB("Unzulaessiger Temperaturlevel: "+tmp+"\n"); 
      return ;
    }
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:temp]));
  
  if(terr)
    SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:terr]));

  if(room)
    SetProp(P_INDOORS, room);
  
}

void set_temp(string str)
{
  DB(BS("*** Alter Aufruf von set_temp in "+file_name(ME)));

  return Umgebung(str);
}

string *newpos(string wohin, string pos1, string pos2, string pos3)
{
  string *ret;
  int x,y,z;
  
  x=to_int(pos1);
  y=to_int(pos2);
  z=to_int(pos3);

  switch(wohin)
    {
    case "ob": ret=({x,y,(z+1)});break;
    case "unt": ret=({x,y,(z-1)});break;
    case "nord": ret=({(x-1),y,z});break;
    case "nordob": ret=({(x-1),y,(z+1)});break;
    case "nordunt": ret=({(x-1),y,(z-1)});break;
    case "nordost": ret=({(x-1),(y+1),z});break;
    case "nordostob": ret=({(x-1),(y+1),(z+1)});break;
    case "nordostunt": ret=({(x-1),(y+1),(z-1)});break;
    case "ost": ret=({x,(y+1),z});break;
    case "ostob": ret=({x,(y+1),(z+1)});break;
    case "ostunt": ret=({x,(y+1),(z-1)});break;
    case "suedost": ret=({(x+1),(y+1),z});break;
    case "suedostob": ret=({(x+1),(y+1),(z+1)});break;
    case "suedostunt": ret=({(x+1),(y+1),(z-1)});break;
    case "sued": ret=({(x+1),y,z});break;
    case "suedob": ret=({(x+1),y,(z+1)});break;
    case "suedunt": ret=({(x+1),y,(z-1)});break;
    case "suedwest": ret=({(x+1),(y-1),z});break;
    case "suedwestob": ret=({(x+1),(y-1),(z+1)});break;
    case "suedwestunt": ret=({(x+1),(y-1),(z-1)});break;
    case "west": ret=({x,(y-1),z});break;
    case "westob": ret=({x,(y-1),(z+1)});break;
    case "westunt": ret=({x,(y-1),(z-1)});break;
    case "nordwest": ret=({(x-1),(y-1),z});break;
    case "nordwestob": ret=({(x-1),(y-1),(z+1)});break;
    case "nordwestunt": ret=({(x-1),(y-1),(z-1)});break;
    default: ret=({x,y,z});
    }
  ret=({to_string(ret[0]),to_string(ret[1]),to_string(ret[2])});
  return ret;
}

varargs void set_exits(string str,mixed how,int flag)
{
  int i, h, s;
  string *aktpos, *file, *rg, *tmp, *givenexits;
  string exitfile, thisfile, path;
  
  // ({""}) muss sein wegen unten/oben ;)
  rg=RICHTUNGEN;

  if(how)
    if(pointerp(how))
      {
	/*
	  Eigens angegebenes Array mit moeglichen Ausgaengen
	  Angabe der Exitmsg mit # getrennt
	  
	  Wenn flag gesetzt, dann werden nur die explizit angegebenen Ausgaenge gesetzt
	  
	  Durchfiltern der Ausgaenge, weil oben unten en wird eh gesetzt
	*/

	for(i=0;i<sizeof(how); i++)
	  {
	    tmp=explode(how[i], "#");
	    
	    if(tmp[0][<2..<0]=="en")
	      tmp[0]=tmp[0][0..<3];

	    how[i]=implode(tmp, "#");
	    
	  }
	
	if(flag)
	  rg-=how;
	else
	  rg=how;
      }
    else
      switch(how)
	{
	case "gerade" : rg=RICHTUNGENG+RICHTUNGENO; break;
	case "schraeg": rg=RICHTUNGENS+RICHTUNGENO; break;
	}
  
  // vorhandene exits
  givenexits=m_indices(TO->QueryProp(P_EXITS));

  thisfile=file_name(TO);
  path="/"+to_string(implode(explode(thisfile,"/")[0..<2],"/"))+"/";
  aktpos=explode(explode(thisfile, "/")[<1],"_");
  
  //DB("File: "+aktpos[0]+X+aktpos[1]+X+aktpos[2]+X+aktpos[3]+".\n");

  for(i=0;i<sizeof(rg); i++)
    {
      //Aufsplittung in Exit und Exitmsg
      tmp=explode(rg[i], "#");
      if(member_array(tmp[0]+"en", givenexits)==-1)
	{
	  file=newpos(tmp[0],aktpos[1],aktpos[2],aktpos[3]);
	  exitfile=path+str+X+implode(file,X);
	  
	  if((file_size(exitfile+".lpc")>0) && (exitfile!=thisfile))
	    if(sizeof(tmp)==2)
	      {
//		DB("Adding Exit: "+tmp[0]+"en with msg: "+tmp[1]+"\n");
		AddExit(tmp[0]+"en", ([EX_DEST:exitfile, EX_MSG:tmp[1]]));
	      }
	    else
	      {
//		DB("Adding Exit: "+tmp[0]+"en.\n");
		AddExit(tmp[0]+"en", exitfile);
	      }
	}
    }
  return;
}

varargs void Ausgaenge(string str,mixed how,int flag)
{
  return set_exits(str, how, flag);
}

varargs string GetDetail(mixed key, mixed race, int flag)
{
  string ret;

  ret=::GetDetail(key, race);

  if(!ret && !flag) 
    if(file_name(ME)[0..28]=="/d/unterwelt/protheg/avmitte/")
      return ({"Ist das wirklich wichtig?\n",
		 "Sowas gibt es wirklich?\n",
		 "Sowas untersucht Ihr?\n",
		 "Habt Ihr jetzt nicht eigentlich etwas anderes zu tun?\n",
		 "Lasst es, das bringt doch so nichts!\n",
		 "Geht lieber toeten, denn so wird das nichts!\n",
		 "Ihr untersucht aber auch wirklich alles, oder?\n",
		 "Protheg war zu faul fuer dieses Detail!\n",
		 "Dieses Detail wurde an einen Gnom vermietet.\n",
		 "Gibt es hier nicht, oder nicht in dieser Form!\n",
		 "Untersucht doch nicht jeden Bloedsinn!\n"})[random(11)];
    else
      return ({"Ist das wirklich wichtig!\n",
		 "Sowas gibt es wirklich?\n",
		 "Sowas untersuchst Du?\n",
		 "Hast Du jetzt nicht eigentlich was anderes zu tun?\n",
		 "Lass das, das bringt doch so nichts!\n",
		 "Geh lieber metzeln, denn so wird das nichts!\n",
		 "Du untersuchst aber auch wirklich alles, oder?\n",
		 "Protheg war zu faul fuer dieses Detail!\n",
		 "Dieses Detail wurde an einen Gnom vermietet.\n",
		 "Gibts hier nicht, oder nicht in dieser Form!\n",
		 "Untersuch doch nicht jeden Bloedsinn!\n"})[random(11)];

  return ret;
}

