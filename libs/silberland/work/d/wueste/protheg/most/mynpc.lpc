varargs void create_default_troll(int level, int sex)
{
  if(!level) level=10+random(10);
  SetProp(P_GENDER, FEMALE);

  SetProp(P_WEIGHT, 300000+random(60000));
  SetProp(P_SIZE, 300+random(40));

  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  1.0, DT_COLD:      0.0, DT_WATER:     0.0,
	    DT_AIR:  -0.2, DT_LIGHTNING: 0.5, DT_EXPLOSION: 0.5,
	    DT_SOUND: 0.0, DT_LIGHT:     1.0, DT_ELECTRIC:  0.0,
	    DT_ACID:  0.0, DT_POISON:    0.0, DT_TERROR:   -0.3,
	    DT_HOLY:  0.0, DT_UNHOLY:    0.0, DT_MAGIC:     0.2,
	    DT_MIND:  0.0]));

  SetProp(P_RACE, "Troll");
  AddClass(CL_TROLL);
  AddClass(CL_GIANT);

  SetProp(P_MAX_HANDS, 2);

  create_default_npc(level);
}

varargs void create_default_human(int level, int sex)
{
  return create_default_mensch(level, sex);
}

varargs void create_default_dwarf(int level, int sex)
{
  return create_default_zwerg(level, sex);
}

varargs void create_default_fairy(int level, int sex)
{
  return create_default_fee(level, sex);
}

varargs void create_default_ogre(int level, int sex)
{
  return create_default_oger(level, sex);
}

void die(int pd)
{
  string f,k;
  int z;

  f="/"+implode(explode(file_name(ME),"/")[0..3],"/")+"/log/";
  
  if(file_size(f)!=-2)
    {
      DB(BS("*** !!Achtung!! Kein log-dir vorhanden!! "+file_name(TO)));
      return ::die(pd);
    }

  if(QueryProp(P_LEVEL)>=40) f+="kills_ultra";
  else if(QueryProp(P_LEVEL)>=25) f+="kills_strong";
  else f+="kills_weak";

  if(QueryProp(P_KILLER))
    k=getuid(QueryProp(P_KILLER));
  else
    if(TP)
      if(query_once_interactive(TP))
	k=getuid(TP);
      else
	k=explode(file_name(TP), "#")[0];
    else
      return ::die(pd);

  z=TP->QueryProp(P_HP) * 100 / TP->QueryProp(P_MAX_HP);

  write_file(f,
	     ctime()+": "+CAP(k)+" killt "+name()+".\n");

  ::die(pd);
}

void NotifyPlayerDeath(object player, object killer, int lxp)
{
  string f;
  int z;

  if(killer==ME)
    {
      f="/"+implode(explode(file_name(ME),"/")[0..3],"/")+"/log/";
      
      if(file_size(f)!=-2)
	{
	  DB(BS("*** !!Achtung!! Kein log-dir vorhanden!! "+file_name(TO)));
	  return;
	}
      
      f+="playerdeath";
      
      z=QueryProp(P_HP) * 100 / QueryProp(P_MAX_HP);

      write_file(f,
		 ctime()+": "+Name()+" ("+z+"%) killt "+CAP(getuid(player))+
		 " ("+lxp+")\n");
    }
}

