#include "../def.h"

inherit "std/mnpc";
inherit "std/player/moneyhandler";
inherit "std/npc/spells";

nosave int nomove, fixlevel;

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:5,T_RANGE_MAX:60]));
  SetProp(P_MNPC_FLAGS, 0);
  
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_ALCOHOL, 0);
}

varargs void create_default_quaul(int level, int sex)
{
  string id;
  string *titel,*longmale,*longfemale;
  int hands;

  fixlevel=level;
  titel=({"schwache","unerfahrene","mittelmaessige","fortgeschrittene",
	    "exzellente"});
  longmale=({
    "Vor Dir steht ein ziemlich junger, schwacher Quaul, der in seinem "
      "kurzen Leben, noch nicht viel erlebt hat. Doch bereits jetzt "
      "schlaegt in ihm das Herz eines echten Quauls. Immer hoeflich und "
      "nett und wenn es zu einem Kampf kommt, wird er niemals die Flucht "
      "ergreifen und bis zum letzten Lebenspunkt kaempfen.",

      "Vor Dir steht ein junger Quaul, der gerade seine Ausbildung begonnen "
      "hat und daher noch nicht sonderlich gut erfahren ist. Noch hat er "
      "sein richtiges Alter nicht erreicht und seine Faehigkeiten noch "
      "nicht voll entfaltet.",

      "Vor Dir steht ein Quaul, der seine Entwicklung schon zur Haelfte "
      "absolviert hat und seine Faehigkeiten schon recht gut beherrscht. "
      "Ihm fehlt noch recht viel Erfahrung, daher ist er in dieser Stufe "
      "noch relativ leicht zu besiegen.",

      "Vor Dir steht ein bereits weit fortgeschrittener Quaul, der seine "
      "Entwicklung abgeschlossen hat und sich nur noch durch Erfahrung "
      "verbessern kann. In dieser Altersphase kaempfen die Quaul eher "
      "wenig, lernen dafuer aber viel mehr um ihre Fertigkeiten zu "
      "erhoehen. Trotzdem sollte man sie nicht unterschaetzen!",

      "Vor Dir steht ein gewaltiger Quaul, der in all seinen Fertigkeiten "
      "ein Meister ist und somit die absolute Vollendung in seiner "
      "Ausbildung erreicht hat. Bis jetzt hat es noch keiner geschafft "
      "ihn zu bezwingen und Du wirst ihn auch nicht so einfach besiegen "
      "koennen! Huete Dich davor, ihn zu erzuernen, denn seine Rache wird "
      "gnadenlos und furchtbar sein!"
      });

  longfemale=({
    "Vor Dir steht eine ziemlich junge, schwache Quaul, die in ihrem kurzen "
      "Leben, noch nicht viel erlebt hat. Doch bereits jetzt schlaegt in "
      "ihr das Herz einer echten Quaul. Immer hoeflich und nett und wenn es "
      "zu einem Kampf kommt, wird sie niemals die Flucht ergreifen und bis "
      "zum letzten Lebenspunkt kaempfen.",

      "Vor Dir steht eine junge Quaul, die gerade ihre Ausbildung begonnen "
      "hat und daher noch nicht sonderlich gut erfahren ist. Noch hat sie "
      "ihr richtiges Alter nicht erreicht und ihre Faehigkeiten noch nicht "
      "voll entfaltet.",

      "Vor Dir steht eine Quaul, dir ihre Entwicklung schon zur Haelfte "
      "absolviert hat und ihre Faehigkeiten schon recht gut beherrscht. Ihr "
      "fehlt noch recht viel Erfahrung, daher ist sie in dieser Stufe noch "
      "relativ leicht zu besiegen.",

      "Vor Dir steht eine bereits weit fortgeschrittene Quaul, die ihre "
      "Entwicklung abgeschlossen hat und sich nur noch durch Erfahrung "
      "verbessern kann. In dieser Altersphase kaempfen die Quaul eher "
      "wenig, lernen dafuer aber viel mehr um ihre Fertigkeiten zu "
      "erhoehen. Trotzdem sollte man sie nicht unterschaetzen!",

      "Vor Dir steht eine gewaltige Quaul, die in all ihren Fertigkeiten "
      "eine Meisterin ist und somit die absolute Vollendung in ihrer "
      "Ausbildung erreicht hat. Bis jetzt hat es noch keiner geschafft sie "
      "zu bezwingen und Du wirst sie auch nicht so einfach besiegen "
      "koennen! Huete Dich davor, sie zu erzuernen, denn ihre Rache wird "
      "gnadenlos und furchtbar sein!"
      });

  SetProp(P_NAME,"Quaul");

  if(!level) level=random(5)+1;
  if(level>5) level=5;
  if(level<1) level=1;

  AddId("quaul");
  AddId("NOWIMPY"); //Die werden sich da net dreinreden lassen ;)

  if(!sex) sex=random(2)+1;
  SetProp(P_GENDER, sex);

  create_default_npc(9*level);

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+(level*50+random(100)));
  SetProp(P_MAX_SP, QueryProp(P_MAX_SP)-(level*50));
  SetProp(P_BODY, QueryProp(P_BODY)+level*10);

  SetProp(P_ALIGN, 300+(level*50+random(50)));

  SetProp(P_MAX_HANDS, 2);

  SetProp(P_XP,QueryProp(P_XP)+level*10000);

  SetProp(P_RACE, "Quaul");

  hands=160+level*15+random(20);

  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE: -0.4, DT_COLD:      0.3, DT_WATER:     0.0,
	    DT_AIR:   0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1,
	    DT_SOUND: 0.0, DT_LIGHT:     0.0, DT_ELECTRIC:  0.0,
	    DT_ACID:  0.0, DT_POISON:    0.2, DT_TERROR:    0.2,
	    DT_HOLY: -0.2, DT_UNHOLY:    0.2, DT_MAGIC:    -0.6]));

  SetProp(P_NOMAGIC, level*10);

  SetProp(P_SPELLRATE, 40+level*10);

  if(sex==FEMALE)
    {
      SetProp(P_SHORT, "Eine "+titel[level]+" Quaul");
      SetProp(P_HANDS,({" mit ihrem stacheligen Schwanz", hands, DT_WHIP}));
      SetProp(P_LONG,longfemale[level-1]);

      SetProp(P_WEIGHT, 60000+random(5000));
      SetProp(P_SIZE, 170+random(10));

      AddSpell(1,350+level*75,
	       "Die Quaul reisst Dich mit ihren scharfen Krallen auf.\n",
	       "Die Quaul reisst @WEN mit ihren scharfen Krallen auf.\n",
	       DT_RIP,([SP_SHOW_DAMAGE:1]));

      AddSpell(2,200+level*50,
	       "Die Quaul spuckt Dir eine aetzende Fluessigkeit in die Augen.\n",
	       "Die Quaul spuckt @WEN an.\n",
	       DT_ACID,([SP_SHOW_DAMAGE:1]));

      AddSpell(5,150+level*20,
	       "Die Quaul durchbohrt Dich mit ihrem Schwanz.\n",
	       "Die Quaul durchbohrt @WEN mit ihrem Schwanz.\n",
	       DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

      AddSpell(2,250+level*60,
	       "Die Quaul beschwoert ihre maechtigen Ahnen.\n",
	       "Die Quaul beschwoert ihre maechtigen Ahnen.\n",
	       DT_HOLY, ([SP_SHOW_DAMAGE:1]));
    }
  else
    {
      SetProp(P_SHORT, "Ein "+titel[level]+"r Quaul");
      SetProp(P_HANDS,({" mit seinem stacheligen Schwanz", hands, DT_WHIP}));
      SetProp(P_LONG,longmale[level-1]);

      SetProp(P_WEIGHT, 65000+random(5000));
      SetProp(P_SIZE, 180+random(10));

      AddSpell(1,400+level*75,
	       "Der Quaul reisst Dich mit seinen scharfen Krallen auf.\n",
	       "Der Quaul reisst @WEN mit seinen scharfen Krallen auf.\n",
	       DT_RIP,([SP_SHOW_DAMAGE:1]));

      AddSpell(2,250+level*50,
	       "Der Quaul spuckt Dir eine aetzende Fluessigkeit in die Augen.\n",
	       "Der Quaul spuckt @WEN an.\n",
	       DT_ACID,([SP_SHOW_DAMAGE:1]));

      AddSpell(5,200+level*20,
	       "Der Quaul durchbohrt Dich mit seinem Schwanz.\n",
	       "Der Quaul durchbohrt @WEN mit seinem Schwanz.\n",
	       DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

      AddSpell(2,300+level*60,
	       "Der Quaul beschwoert seine maechtigen Ahnen.\n",
	       "Der Quaul beschwoert seine maechtigen Ahnen.\n",
	       DT_HOLY, ([SP_SHOW_DAMAGE:1]));
    }
}

varargs void create_default_nftah(int level, int sex)
{
  string id;
  string *titel,*longmale,*longfemale;
  int hands;

  fixlevel=level;
  titel=({"schwache","unerfahrene","mittelmaessige","fortgeschrittene",
	  "exzellente"});

  longmale=({
    "Du siehst einen etwas schwaecheren, jungen Nftah vor Dir stehen. Er "
      "wirkt unsicher und blickt etwas nervoes umher. In seinem jungen "
      "Leben hat er noch nichts erreicht und gilt daher noch nicht als "
      "vollwertiges Mitglied in den Raengen der Nftahkrieger.",

      "Vor Dir steht ein junger, noch unerfahrener Nftah, der wohl erst "
      "vor kurzem mit seiner Ausbildung zum Nftahkaempfer begonnen hat. "
      "Mit gewoelbter Brust und gehobenem Kinn stolziert er herum, um "
      "seine Unerfahrenheit zu verbergen. Jedoch sein fuer Nftah "
      "untypisches hitziges Temperament verraet ihn, als noch unwuerdig "
      "sich einen echten Nftahkrieger zu nennen.",

      "Der Nftah vor Dir hat seine Wachstumsphase ueberwunden und widmet "
      "sich nunmehr vollstaendig seiner Ausbildung zum Nftahkaempfer. Man "
      "merkt das daran, dass er andauernd Kampfuebungen vollfuehrt und oft "
      "einfach nur so vor sich hinmeditiert, um seine innere Ruhe zu finden.",

      "Der Nftah vor Dir scheint stumm vor sich hinzumeditieren. Das "
      "koerperliche Wachstum und die Grundausbildung der Nftahkrieger "
      "abgeschlossen fehlt ihm nur noch die Kampferfahung, die noetig "
      "ist um zu der oberen Elite der Nftah zu gehoeren. Pass auf, denn "
      "er wird keinem Kampf ausweichen, mag er auch noch so sinnlos "
      "erscheinen!",

      "Ein gewaltiger, kampfgestaehlter Nftahkrieger steht vor Dir. Jeder "
      "einzelne Teil seines Koerpers, der nicht unter der Ruestung steckt "
      "ist mit Muskeln uebersaeht. Obwohl er die Ruhe selbst zu sein "
      "scheint, umgibt ihn doch eine gewaltige Aura der Staerke. Nur noch "
      "sehr starke, oder lebensmuede Kaempfer wuerden es wagen ihn "
      "anzugreifen, denn mit dem Abschluss seiner Ausbildung und seiner "
      "maechtigen Erfahrung ist er ein beinahe unbesiegbarer Gegner."
      });

  longfemale=({
    "Du siehst eine etwas schwaechere, junge Nftah vor Dir stehen. Sie "
      "wirkt unsicher und blickt etwas nervoes umher. In ihrem jungen "
      "Leben hat sie noch nichts erreicht und gilt daher noch nicht als "
      "vollwertiges Mitglied in den Raengen der Nftahkrieger.",

      "Vor Dir steht eine junge, noch unerfahrene Nftah, die wohl erst "
      "vor kurzem mit ihrer Ausbildung zur Nftahkaempferin begonnen hat. "
      "Mit gewoelbter Brust und gehobenem Kinn stolziert sie herum, um "
      "ihre Unerfahrenheit zu verbergen. Jedoch ihr fuer Nftah untypisches "
      "hitziges Temperament verraet sie, als noch unwuerdig sich eine "
      "echte Nftahkriegerin zu nennen.",

      "Die Nftah vor Dir hat ihre Wachstumsphase ueberwunden und widmet "
      "sich nunmehr vollstaendig ihrer Ausbildung zur Nftahkaempferin. "
      "Man merkt das daran, dass sie andauernd Kampfuebungen vollfuehrt "
      "und oft einfach nur so vor sich hinmeditiert, um ihre innere Ruhe "
      "zu finden...",

      "Die Nftah vor Dir scheint stumm vor sich hinzumeditieren. Das "
      "koerperliche Wachstum und die Grundausbildung der Nftahkrieger "
      "abgeschlossen fehlt ihr nur noch die Kampferfahung, die noetig "
      "ist um zu der oberen Elite der Nftah zu gehoeren. Pass auf, denn "
      "sie wird keinem Kampf ausweichen, mag er auch noch so sinnlos "
      "erscheinen!",

      "Eine gewaltige, kampfgestaehlter Nftahkriegerin steht vor Dir. "
      "Jeder einzelne Teil ihres Koerpers, der nicht unter der Ruestung "
      "steckt ist mit Muskeln uebersaeht. Obwohl sie die Ruhe selbst zu "
      "sein scheint, umgibt sie doch eine gewaltige Aura der Staerke. "
      "Nur noch sehr starke, oder lebensmuede Kaempfer wuerden es wagen "
      "sie anzugreifen, denn mit dem Abschluss ihrer Ausbildung und "
      "ihrer maechtigen Erfahrung ist sie ein beinahe unbesiegbarer Gegner."
      });

  SetProp(P_NAME,"Nftah");

  if(!level) level=random(5)+1;
  if(level>5) level=5;
  if(level<1) level=1;

  AddId("nftah");
  AddId("NOWIMPY"); //sind ja starke kerle und sollen net gleich fluechten

  if(!sex) sex=random(2)+1;
  SetProp(P_GENDER, sex);
  create_default_npc(10*level);

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+(level*100+random(100)));
  SetProp(P_MAX_SP, (level*100)+random(level*10));
  SetProp(P_BODY, QueryProp(P_BODY)+level*15);

  SetProp(P_ALIGN, -300-(level*50-random(50)));

  SetProp(P_MAX_HANDS, 2);

  SetProp(P_XP,QueryProp(P_XP)+level*10000);

  SetProp(P_RACE, "Quaul");

  hands=160+level*15+random(20);

  hands=200+level*40+random(30);

  SetProp(P_XP,QueryProp(P_XP)+level*15000);

  SetProp(P_RACE, "Nftah");
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE: -0.4, DT_COLD:      0.2, DT_WATER:     0.0,
	    DT_AIR:   0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0,
	    DT_SOUND: 0.0, DT_LIGHT:     0.0, DT_ELECTRIC:  0.0,
	    DT_ACID: -0.3, DT_POISON:   -0.6, DT_TERROR:   -0.2,
	    DT_HOLY:  0.2, DT_UNHOLY:   -0.2, DT_MAGIC:     0.3]));

  SetProp(P_SPELLRATE, 10+level*10);

  if(sex==FEMALE)
    {
      SetProp(P_SHORT, "Eine "+titel[level]+" Nftah");
      SetProp(P_HANDS, ({" mit ihren Scheerenhaenden",hands,DT_SQUEEZE}));
      SetProp(P_LONG,longfemale[level-1]);
      
      SetProp(P_WEIGHT, 80000+random(5000));
      SetProp(P_SIZE, 190+random(10));
      
      AddSpell(8,300+level*30,
	       "Die Nftah jagt Dir ihren Stachel in die Brust.\n",
	       "Die Nftah jagt @WEM ihren Stachel in die Brust.\n",
	       DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

      AddSpell(1,400+level*20,
	       "Die Nftah jagt Dir ihren giftigen Stachel in die Brust.\n",
	       "Die Nftah jagt @WEM ihren giftigen Stachel in die Brust.\n",
	       DT_POISON, "gift", ([SP_SHOW_DAMAGE:1]));
    }
  else
    {
      SetProp(P_SHORT, "Ein "+titel[level]+"r Nftah");
      SetProp(P_HANDS, ({" mit seinen Scheerenhaenden",hands+25,DT_SQUEEZE}));
      SetProp(P_LONG,longmale[level-1]);

      SetProp(P_WEIGHT, 80000+random(5000));
      SetProp(P_SIZE, 190+random(10));

      AddSpell(8,300+level*30,
	       "Der Nftah jagt Dir seinen Stachel in die Brust.\n",
	       "Der Nftah jagt @WEM seinen Stachel in die Brust.\n",
	       DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

      AddSpell(1,400+level*20,
	       "Der Nftah jagt Dir seinen giftigen Stachel in die Brust.\n",
	       "Der Nftah jagt @WEM seinen giftigen Stachel in die Brust.\n",
	       DT_POISON, "gift", ([SP_SHOW_DAMAGE:1]));
    }
}

void gift(object enemy,int damage, mixed dam_type)
{
  enemy->AddPoison(1);
}

varargs void create_default_mensch(int level, int sex)
{
  if(!level) level=10+random(10);

  if(sex && sex<3) SetProp(P_GENDER, sex);

  SetProp(P_WEIGHT, 75000+random(5000));
  SetProp(P_SIZE, 170+random(30));

  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  0.0, DT_COLD:      0.0, DT_WATER:     0.0,
	    DT_AIR:   0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0,
	    DT_SOUND: 0.0, DT_LIGHT:     0.0, DT_ELECTRIC:  0.0,
	    DT_ACID:  0.0, DT_POISON:    0.0, DT_TERROR:    0.0,
	    DT_HOLY:  0.0, DT_UNHOLY:    0.0, DT_MAGIC:     0.0,
	    DT_MIND:  0.0]));

  SetProp(P_RACE, "Mensch");
  AddClass(CL_HUMAN);

  SetProp(P_MAX_HANDS, 2);

  create_default_npc(level);
}

