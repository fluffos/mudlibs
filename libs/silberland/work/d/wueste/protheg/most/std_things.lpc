#include <properties.h>
#include "../def.h"

#define ZANF ({ "  /  ", " |   ", " |   ", " |   ", " |   ", " |   ", \
  " |   ", "  \\  " })
#define ZENDE ({ "   / \\", "  | O |", "  |\\_/", "  |", "  |__", "  |/ \\", \
  "  | O |", "   \\ /" })
#define SPACES(x) "                                                                              "[0..x-1]

int color_strlen(string str) 
{
  string esc_pattern;
  string *x;
  int i, j;
  
  esc_pattern=" [^m]*m";
  esc_pattern[0]=27;

  x=regexplode(str, esc_pattern);

  j=0;

  for(i=0;i<=sizeof(x);i+=2) 
    j+=strlen(x[i]);

  return j;
}

string extract_colors(string str)
{
  string ret,esc_pattern;
  string *x;
  int i;

  esc_pattern=" [^m]*m";
  esc_pattern[0]=27;
  
  x=regexplode(str, esc_pattern);
  
  ret="";

  for(i=0;i<=sizeof(x);i+=2)
    ret+=x[i];
  return ret;
}

string duplicate(string what, int howmuch)
{
  string ret;
  
  ret="";
  for(;howmuch>0;howmuch--)
    ret+=what;
  return ret;
}

string make_dokument(string str) 
{
  string *zeilen;
  string erg;
  int j,i;
  
  zeilen=({ "" })+explode(str,"\n")+({""});
  while(sizeof(zeilen)<8)
    zeilen=({ "" })+zeilen+({ "" });
  erg="\n    "+duplicate("_",71)+"\n";
  j=0;
  for(i=0;i<sizeof(zeilen);i++) 
    {
      erg+=ZANF[j]+zeilen[i]+SPACES(65-color_strlen(zeilen[i]))+ZENDE[j]+"\n";
      if((j<3)||(i>sizeof(zeilen)-6))
	j++;
    }
  erg+="   `"+duplicate("-",70)+"'\n\n";
  return erg;
}

string make_document(string str)
{
  return make_dokument(str);
}

// aus /std/pub.c
string FormatString(string str, object pl) 
{
  if(!pl) pl=TP;
  
  if (!str || str=="") return str;
  
  str=implode(efun::explode(str,"&&"),pl->name(WER,2));
  str=implode(efun::explode(str,"&?"),pl->name(WESSEN,2));
  str=implode(efun::explode(str,"&!"),pl->QueryPronoun(WER));
  str=implode(efun::explode(str,"&1"),pl->QueryPronoun(WER));
  str=implode(efun::explode(str,"&2"),pl->QueryPronoun(WESSEN));
  str=implode(efun::explode(str,"&3"),pl->QueryPronoun(WEM));
  str=implode(efun::explode(str,"&4"),pl->QueryPronoun(WEN));
  str=implode(efun::explode(str,"&="),pl->QueryPossPronoun(1));
  str=implode(efun::explode(str,"&#"),pl->QueryPossPronoun(2));
  
  return CAP(str);
}
