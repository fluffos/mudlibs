#include <properties.h>
#include "../def.h"

inherit "std/room";
inherit MOST "std_room";

#define DI "/obj/gems/diamant.lpc"
#define DS (["dunkelelf" :40,      \
	     "fee"       :40,      \
	     "zwerg"     :80,      \
	     "elf"       :30,      \
	     "hobbit"    :50,      \
	     "mensch"    :60,      \
	     "oger"      :15,      \
	     "troll"     :10])

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Irgendwo in einem Schacht in irgendeiner Hoehle");
  SetProp(P_INT_LONG, 
	  "Ein breiter, jedoch nicht sonderlich hoher Schacht der nur fuer "+
	  "einen Zweck da ist: Edelsteinabbau! Wo bist Du denn da bloss "+
	  "hineingeraten?! Aber, wenn Du hier raus willst, wirst Du wohl "+
	  "oder uebel mit anpacken muessen und nach Edelsteinen schuerfen...\n");
  AddCmd(({"schuerfe","schuerf"}), "schuerfen");
}

schuerfen(string str)
{
  object tp;
  
  notify_fail("Nach was willst Du denn schuerfen?\n");
  if(!str) return 0;
  if(str=="edelstein"||str=="edelsteine"||str=="nach edelstein"||
     str=="nach edelsteine")
    {
      tp=TP;
      if(!present("spitzhacke",tp)==tp)
	return write("Womit moechtest Du denn schuerfen?\n"),1;
      if(random(5)) 
	return write("bla\n"),1;
      
      return 1;
    }
  return 0;
}
