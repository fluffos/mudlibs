inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "desert.h"

#define FILE(x,y) "wueste_"+x+"_"+y
#define STANDARDDETAILS "Boden Himmel Wueste"

setdetail(string det);
already_set(string str);
set_environment(int what);
set_exits();

string *details;

set_environment(string wo,int setdetails)
{
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, SEHR_HELL);
  SetProp(P_ENVIRONMENT, 
	  ([ENV_TEMPERATURE:40,ENV_TERRAIN:TT_DESERT]));
  set_exits();
  switch(wo)
    {
      case "wueste": if(setdetails) create_wueste();break;
      case "krater": if(setdetails) create_krater();break;
      case "strand": if(setdetails) create_strand();break;
    }
}  

create_wueste()
{
  int x;
  string lang;
  mapping map;
  
  SetProp(P_INT_SHORT, DESC_KURZ_WUESTE[random(5)]);
  details=({});
  lang="";
  for(x=1;x<=5;x++)
    {
      switch(x)
	{
	  case 1: map=DESC_LANG_WUESTE_1; break;
	  case 2: map=DESC_LANG_WUESTE_2; break;
	  case 3: map=DESC_LANG_WUESTE_3; break;
	  case 4: map=DESC_LANG_WUESTE_4; break;
	  case 5: map=DESC_LANG_WUESTE_5; break;
	}
      lang+=map[random(3)];
    }	    
  SetProp(P_INT_LONG, lang+"\n");
  setdetails(lang+STANDARDDETAILS,"wueste");
}

create_krater()
{
  int x;
  string lang;
  mapping map;
  
  SetProp(P_INT_SHORT, DESC_KURZ_KRATER[random(3)]);
  details=({});
  lang="";
  for(x=1;x<=4;x++)
    {
      switch(x)
	{
	case 1: map=DESC_LANG_KRATER_1; break;
	case 2: map=DESC_LANG_KRATER_2; break;
	case 3: map=DESC_LANG_KRATER_3; break;
	case 4: map=DESC_LANG_KRATER_4; break;
	}
      lang+=map[random(3)];
    }	    
  SetProp(P_INT_LONG, lang+"\n");
  setdetails(lang+STANDARDDETAILS,"krater");
}

create_strand()
{
  int x;
  string lang;
  mapping map;
  
  SetProp(P_INT_SHORT, DESC_KURZ_STRAND[random(5)]);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30]));
  details=({});
  lang="";
  for(x=1;x<=4;x++)
    {
      switch(x)
	{
	  case 1: map=DESC_LANG_STRAND_1; break;
	  case 2: map=DESC_LANG_STRAND_2; break;
	  case 3: map=DESC_LANG_STRAND_3; break;
	  case 4: map=DESC_LANG_STRAND_4; break;
	}
      lang+=map[random(3)];
    }	    
  SetProp(P_INT_LONG, lang+"\n");
  setdetails(lang+STANDARDDETAILS,"strand");
}

setdetails(string str,string wo)
{
  int i,siz,ra,ret;
  string *words,wort,newstr;
  mapping dets;
  
  words=get_words(str);
  siz=sizeof(words);
  if(!siz) return;
  newstr="";
  switch(wo)
    {
      case "wueste":dets=DETAILS_WUESTE;break;
      case "krater":dets=DETAILS_KRATER;break;
      case "strand":dets=DETAILS_STRAND;break;
    }
  for(i=0;i<siz;i++)
    {
      if(member_array(words[i],
		      ({"Du","Dir","Dich","Dein","Deiner","Deine","Deinem",
			  "Deinen","Nordwesten","Nordosten","Suedwesten",
			  "Suedosten","Norden","Sueden","Westen","Osten",
			  "Besonderes","Der","Die","Das","Ja","Nein"})) >= 0)
	continue;
      wort=LOWER(words[i]);
      if((ret=having(wort,dets))>0)
	{
	  if(already_set(wort))
	    continue;
	  ra=random(2)+1;
	  AddDetail(dets[ret],dets[ret,ra]);
	  tell_object(find_player("protheg"), 
		      "Adding Detail: "+wort+" Size: "+sizeof(dets[ret])+
		      " Beschreibung: "+ra+"\n");
	  details+=dets[ret];
	  newstr+=dets[ret,ra];
	}
    }
  setdetails(newstr,wo);
}

having(string str,mapping dets)
{
  int i,ret;
  for(i=1;i<=m_sizeof(dets);i++)
    {
      if(member_array(str,dets[i])>=0)
	{ret = i; break;}
      else
	ret = 0;	
    }
  return ret;
}

get_words(string str)
{
  int i;
  string *words;
  
  words=regexp(regexplode(str, "[^A-Za-z]"),"\\<[A-Z]");
  if(!sizeof(words)) return;
  return words;
}

already_set(string was)
{
  if(member_array(was,details)>=0) 
    return 1;
  else 
    return 0;
}

set_exits()
{
  int i,s;
  mapping exits;
  string *aktpos,*file;
  
  exits=m_indices(TO->QueryProp(P_EXITS));
  aktpos=explode(file_name(TO)[<3..<1],"_");
  tell_object(find_player("protheg"), 
	      "File: "+FILE(aktpos[0],aktpos[1])+".\n");
  for(i=sizeof(exits)-1;i>=0; i--)
    tell_object(find_player("protheg"), 
		"Vorhandene Exits: "+exits[i]+".\n");
  for(i=0;i<sizeof(RICHTUNGEN); i++)
    {
      if(member_array(RICHTUNGEN[i],exits)==-1)
	{
	  file=newpos(RICHTUNGEN[i],aktpos);
	  if(file_size(ROOM("wueste/"+FILE(file[0],file[1])+".lpc"))>0)
	    {
	      tell_object(find_player("protheg"), 
			  "Adding Exit: "+RICHTUNGEN[i]+".\n");
	      AddExit(RICHTUNGEN[i], ROOM("wueste/"+FILE(file[0],file[1])));
	    }
	  else
	    tell_object(find_player("protheg"), 
			"Non existent: "+FILE(file[0],file[1])+"\n");
	}
      else
	tell_object(find_player("protheg"), 
		    "Already have: "+RICHTUNGEN[i]+"\n");
    }
  return;
}

newpos(string wohin,string *position)
{
  string *ret;
  int x,y;
  
  x=to_int(position[0]);
  y=to_int(position[1]);
  switch(wohin)
    {
    case "norden": ret=({(x-1),y});break;
    case "nordosten": ret=({(x-1),(y+1)});break;
    case "osten": ret=({x,(y+1)});break;
    case "suedosten": ret=({(x+1),(y+1)});break;
    case "sueden": ret=({(x+1),y});break;
    case "suedwesten": ret=({(x+1),(y-1)});break;
    case "westen": ret=({x,(y-1)});break;
    case "nordwesten": ret=({(x-1),(y-1)});
    }
  ret=({to_string(ret[0]),to_string(ret[1])});
  return ret;
}
