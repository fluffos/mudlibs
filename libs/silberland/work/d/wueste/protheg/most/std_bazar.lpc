// by PROtheG
// Std-inherit-file fuer den Bazar

#include <properties.h>
#include "../def.h"

inherit MOST "std_room";

create()
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Eine Strasse im Bazar");
  SetProp(P_INT_LONG, "Bazar-Standardraum.\n");
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, 
	  ([ENV_TEMPERATURE:25,ENV_TERRAIN:TT_TOWN]));
  AddSound(({DEFAULT_SOUND,"murmeln","bazarbesucher"}),
	   "Du hoerst nur das Murmeln von Bazarbesuchern.");
}
