#include "../def.h"

inherit "std/room";

#define ANSCHLUSS "/d/unterwelt/protheg/av/room/weg_t01"

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein finsterer Keller");
  SetProp(P_INT_LONG,
	  "Du stehst hier in dem dunklem Keller unterhalb des verfallenen Hauses. "
	  "Es riecht hier unangenehm, und irgendwie fuehlst "
	  "Du Dich beobachtet, allerdings siehst Du niemanden. "
	  "Im Norden ist ein Loch in der Mauer welches einen Weg offenbart. "
	  "Es ist ziemlich klein, aber Du solltest problemlos durchpassen. "
	  "Ein alter, geoeffneter Brunnenschacht befindet sich unweit von Dir. "
	  "Eine Treppe aus getrocknetem Lehm fuehrt wieder zurueck ins Haus.\n");  
  
  AddDetail(({"schacht","brunnenschacht"}),
	    "Er fuehrt kerzengerade runter. Wohin genau, kannst Du "
	    "nicht erkennen...");
  
  AddDetail(({"keller"}),
	    "Du befindest Dich hier im Keller unter einem Haus in der "
	    "Wuestenstadt Arrakeen.");
  AddDetail(("decke"),
	    "Die Decke besteht aus Holzlatten.");
  AddDetail(("weg"),
	    "Das Loch offenbart einen Weg nach Norden."),
  AddDetail(({"latten", "holzlatten"}),
	    "Die Holzlatten der Decke sind grob gearbeitet und sehen nicht mehr "
	    "uebermaessig stabil aus.");
  AddDetail(({"lehm", "getrockneten lehm", "baustoff"}),
	    "Getrockneter Lehm ist in der Wueste ein beliebter Baustoff.");
  AddDetail(({"wueste"}),
	    "Du befindest dich darin, darunter und irgendwie auch darauf!");
  AddDetail(({"sand","hauptbestandteil","bestandteil"}), 
	    "Sand ist der Hauptbestandteil einer Wueste.");
  AddDetail(({"loch"}),
	    "Im Norden ist ein Loch in der Mauer durch welches Du "
	    "auch sicher hindurchpassen koenntest.");
  AddDetail(("boden"),
	    "Der Boden besteht aus Sand und getrocknetem Lehm.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende hier bestehen aus Sand und getrocknetem Lehm. "
	    "In der Mauer noerdlich von Dir ist zudem ein Loch.");
  AddDetail(({"mauer", "noerdliche Mauer"}),
	    "Da ist ein Loch in der noerdlichen Mauer.");
  AddDetail(("treppe"),
	    "Die Treppe besteht aus getrocknetem Lehm und fuehrt zurueck in "
	    "das Haus ueber Dir.");
  AddDetail(("haus"),
	    "Du befindest Dich im Keller des verfallenen Haus.");
  AddDetail(({"arrakeen","wuestenstadt", "stadt"}),
	    "Ueber Dir befindet sich Arrakeen, die beruehmte Wuestenstadt.");
  AddDetail(({"tod"}),
	    "Der sichere Tod wartet hier irgendwo auf Dich. Hoffentlich "
	    "begegnest Du ihm nicht.");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst einige Geraeusche, die wahrscheinlich "
	   "von den Wesen in der Stadt ueber dir kommen.");
  AddSound(({"wesen","menschen"}),
	   "Du hoerst zwar Menschen, erkennst die Stimmen aber nicht.");
  AddSound(({"stimmen","stimme"}),
	   "Das sind die Stimmen der Wesen ueber dir.");
  AddSound(({"geraeusche","geraeuschen"}), 
	   "Die Geraeusche sind nicht eindeutig zu identifizieren. Du "
	   "glaubst aber Schritte, Stimmen und ein Wispern zu vernehmen.");
  AddSound(({"wispern", "weiter", "wartet", "sichere", "dich", "der", "geh", 
	       "auf", "nicht"}),
           "Es klingt beinahe wie 'GEH NICHT WEITER, AUF DICH WARTET DER "
           "SICHERE TOD!'");
  AddSound(({"schritte","stimmen"}),
	   "Sie stammen wohl von den Menschen in Arrakeen.");
  AddDetail(("menschen"),
	    "In Arrakeen leben vielen Menschen.");
  AddDetail(("nase"),
	    "Boaahh, hast Du aber eine grosse Nase!");
  AddSmell(DEFAULT_SMELL,
	   "Aus dem Loch steigt Dir ein ekelhafter Geruch in die Nase.");
  AddSmell(("geruch"),
	   "Waeehh, ist der ekelhaft. Es wird Dich einige Ueberwindung kosten "
	   "durch das Loch zu steigen.");
  AddDetail(("ueberwindung"),
	    "Die wirst Du schon irgendwie aufbringen muessen.");
  
  AddCmd(CMD_KLETTERN, "cmd_klettern");
  
  AddExit(({"loch"}), "durch das Loch#" ROOM "eingang");
  
  AddExit(({"rauf"}), ROOM "haus"); 
  
  AddExit(({"runter"}), ([EX_DEST: ANSCHLUSS, 
			  EX_TESTFUNC: "keine_quester",
			  EX_MSG: "in den Brunnenschacht"]));
}  

nosave int cmd_klettern(string str)
{
  notify_fail(BS("Wohin willst Du denn klettern?"));
  if(!str) return 0;
  
  if(str=="runter"||str=="hinunter"||str=="hinab")
    {
      if(TP->QueryProp(P_RESTING))
	return write(BS("Du raste erstmal fertig!")), 1;
      
      if(present("\narrakeenkanalitem", TP))
	return write(BS("Das Loch in der Mauer interessiert Dich aber viel "
			"mehr!")), 1;
  
      /*
      if(!IS_WIZARD(TP) && !TP->QueryProp(P_TESTPLAYER))
	return write(BS("Da gehts noch nicht hinunter... Bitte PROtheG "
			"ansudern!")), 1;
      */
      
      write(BS("Du beginnst den Schacht hinunterzuklettern."));
      
      if(!TP->do_exhaust(200, 1))
	{
	  write(BS("Erschoepft loesen sich Deine Finger ab und Du "
		   "faellst..."));	  
	  
	  SetProp(P_KILL_NAME, "Ein harter Aufprall");
	  
	  if(TP->QueryProp(P_RACE)=="Fee")
	    {
	      write(BS("Im letzten Moment kannst Du den Aufprall mit Deinen "
		       "Fluegeln abbremsen..."));
	      
	      TP->move(ANSCHLUSS, M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW);
	      
	      TP->do_damage(20);
	      
	      return 1;
	    }

	  write(BS("Ungebremst schlaegst Du unten auf..."));
	  
	  TP->move(ANSCHLUSS, M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW);
	  
	  TP->do_damage(80);
	  
	  return 1;
	}
      
      write(BS("Erschoepft gelangst Du unten an..."));
      
      TP->move(ANSCHLUSS, M_GO);

      return 1;      
    }
  
  return 0;
}

int keine_quester(string dest)		  
{
  if(!TP) return 0;

  if(!query_once_interactive(TP)) return 1;

  if(present("\narrakeenkanalitem", TP))
    return write(BS("Das Loch in der Mauer interessiert Dich aber viel "
		    "mehr!")), 0;
  
/*
  if(!IS_WIZARD(TP) && !TP->QueryProp(P_TESTPLAYER))
    return write(BS("Da gehts noch nicht hinunter... Bitte PROtheG "
		    "ansudern!")), 0;
*/
  
  return 1;
}
