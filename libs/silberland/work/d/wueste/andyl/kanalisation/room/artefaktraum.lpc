#include "../def.h"

inherit "std/room";

nosave int schlange1=0;
nosave int schlange2=0;
nosave int armreif=1;

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Eine geheimnisvolle Kammer");
  SetProp(P_INT_LONG,
	  "Du stehts hier in einer geheimnisvollen Kammer. "
	  "Alles hier besteht aus dicken Steinquadern, die "
	  "Waende sind mit verschiedensten Zeichen und Symbolen "
	  "versehen und in der Mitte des Raumes ist ein schlichter "
	  "steinerner Altar zu sehen.\n");
  
  AddDetail(({"boden", "steinboden"}),
	    "Der Boden besteht aus dicken Steinquadern, die so dicht "
	    "anneinanderliegen, dass Du kaum die Ritzen zwischen den "
	    "Bloecken ausmachen kannst.");
  AddDetail(("ritzen"),
	    "Die Ritzen zwischen den Steinbloecken sind kaum zu erkennen.");
  AddDetail(({"quader", "steinquader", "bloecke", "steinbloecke"}),
	    "Wahrlich beeindruckend grosse Steinbloecke. Es war sicher "
	    "sehr schwer diese hierher in die Wueste zu schaffen.");
  AddDetail(("wueste"),
	    "Arrakeen befindet sich ja in der Wueste.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus dicken Steinquadern, ebenso wie "
	    "die Decke und der Boden. Verschiedenste Zeichen und Symbole "
	    "sind in den Stein eingeritzt worden.");
  AddDetail(({"symbole", "zeichen"}),
	    "Leider ist es Dir nicht einmal ansatzweise moeglich die "
	    "Zeichen und Symbole deuten zu koennen.");
  AddDetail(({"raum", "kammer"}),
	    "Du befindest Dich hier in einer geheimnisvollen Kammer "
	    "unterhalb der Kanalisation von Arrakeen.");
  AddDetail(({"kanalisation", "arrakeen"}),
	    "Die Kanalisation von Arrakeen ist ueber Dir.");
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht ein schlichter Steinaltar.");
  AddDetail(("stein"),
	    "Grauer harter Stein.");
  AddDetail(("decke"),
	    "Die Decke besteht aus dicken Steinquadern.");
  AddDetail(({"altar", "steinaltar"}),
	    "Ein einfacher Steinaltar. Auf seiner Oberflaeche sind links und "
	    "rechts zwei steinerne Schlangen zu sehen und in der Mitte ist "
	    "das Bild eines Armreifs zu sehen.");
  AddDetail(("oberflaeche"),
	    "In die Oberflaeche des Altars wurde das Bild eines Armreifs "
	    "eingraviert, flankiert von zwei steinernen Schlangen, einer "
	    "links und einer rechts.");
  AddDetail(({"schlangen", "schlange", "steinerne schlange", 
		"steinerne schlangen"}),
	    "Die steinernen Schlangen wirken beinahe so als waeren sie echt. "
	    "Moment, so wie es aussieht kann man die drehen.");
  AddDetail(({"bild", "armreif"}),
	    "Das Bild eines schlichten Armreifs.");
  AddSmell(DEFAULT_SMELL,"Du riechst abgestandene Luft.");
  AddSmell(("luft"),
	   "Puhhh, die Luft hier ist wirklich abgestanden. Du "
	   "fragst Dich wie lange hier schon nicht mehr gelueftet "
	   "wurde.");
  AddSound(DEFAULT_SOUND,
	   "Es ist absolut still hier."); 

  AddExit(({"suedwesten"}), ROOM "barrierenraum"); 
  
  AddCmd(({"dreh", "drehe", "verdreh", "verdrehe"}), "verdrehe_was");  
}  

void armbandcheck()
{
  object ar;

  if(schlange1 && schlange2)
    if(armreif && present("\narrakeenkanalitem", TP))
      {
	ar=clone_object(OBJ "armreif");
	
	if(ar->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    write(BS("Eine Nische oeffnet sich ploetzlich in dem Altar. "
		     "Darin liegt ein Armband welches Dir jedoch zu schwer "
		     "werden wuerde, wenn Du es nehmen wuerdest, daher "
		     "laesst Du es liegen."));
	    
	    ar->remove(1);
	  }
	else
	  {
	    write(BS("Eine Nische oeffnet sich ploetzlich in dem Altar. "
		     "Darin liegt ein Armband welches Du sofort an Dich "
		     "nimmst."));
	    
	    armreif=0;
	  }
	
	write(BS("Die Nische verschwindet darauf wieder und die Schlangen "
		 "kehren in ihre Ursprungsposition zurueck."));
	
	schlange1=0;
	schlange2=0;
      }
    else
      {
	write(BS("Eine Nische oeffnet sich ploetzlich in dem Altar. "
		 "Leider ist nichts in ihr und die Nische verschwindet "
		 "nach kurzer Zeit wieder und die Schlangen kehren in "
		 "ihre Ursprungspositionen zurueck."));
	schlange1=0;
	schlange2=0;
      }
}

nosave int verdrehe_was(string str)
{
  notify_fail("Was willst Du drehen?\n");
  if(!str) return 0;

  if(str == "schlange" || str == "steinerne schlange" ||
     str == "schlangen" ||  str == "steinerne schlangen")
    {
      write(BS("Welche Schlange moechtest Du drehen? Die "
	       "linke oder die rechte Schlange?"));
      
      return 1;
    }

  if(str == "linke schlange" || str == "linke steinerne schlange")
    if(!schlange1)
      { 
	write(BS("Du drehst die linke Schlange um 90 Grad."));

	schlange1=1;

	armbandcheck();
	
	return 1;
      }
    else
      {
	write(BS("Du drehst die linke Schlange in ihre Urpsrungsposition "
		 "zurueck."));

	schlange1=0;

	return 1;

      }
  
  if(str == "rechte schlange" || str == "rechte steinerne schlange")
    if(!schlange2)
      { 
	write(BS("Du drehst die rechte Schlange um 90 Grad."));

	schlange2=1;

	armbandcheck();

	return 1;
      }
    else
      {
	write(BS("Du drehst die rechte Schlange in ihre Urpsrungsposition "
		 "zurueck."));

	schlange2=0;

	return 1;
      }

  return 0;
}

void reset()
{
  ::reset();
  armreif=1;
  schlange1=0;
  schlange2=0;
}
