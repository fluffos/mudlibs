#include "../def.h"

inherit "std/room";

#define ANSCHLUSS "/d/wueste/protheg/arrakeen/room/ara_6_4_0"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Eine Huette im Armenviertel von Arrakeen");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich hier in einer baufaelligen Huette "
	     "im Armenviertel von Arrakeen. Die Einrichtung ist sehr karg "
	     "und besteht aus einem schiefem Tisch, einem kaputtem Hocker und "
	     "einem Lager aus Stroh. Zudem siehst Du einen kleinen "
	     "Obelisken in der Mitte des Raumes.")+
	  BS("Eine Treppe fuehrt hinunter in den Keller."));

  AddDetail(({"mitte","raum"}),
	    "In der Mitte des Raumes steht ein kleiner Obelisk.");
  AddDetail(({"viertel", "armenviertel"}),
	    "Du befindest Dich hier im Armenviertel von Arrakeen.");
  AddDetail(("huette"),
	    "Diese aus Lehm gefertigte Huette ist bereits ziemlich baufaellig.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus getrocknetem Lehm und haben bereits "
	    "etliche Spalten und Risse, durch welche die heisse Sonne "
	    "unbarmherzig hereinbrennt.");
  AddDetail(({"risse", "spalten"}),
	    "Durch die Spalten und Risse in den Waenden und der Decke brennt "
	    "die Sonne unbarmherzig herein.");
  AddDetail(("sonne"),
	    "Unbarmherzig brennt die Sonne durch die Spalten und Rissen "
	    "in die Huette herein.");
  AddDetail(("himmel"),
	    "Unbarmherzig brennt die Sonne von dort herab.");
  AddDetail(({"decke"}),
	    "Wie auch in den Waenden sind in der aus getrocknetem Lehm "
	    "bestehenden Decke unzaehlige Spalten und Risse zu entdecken.");
  AddDetail(("boden"),
	    "Der Boden besteht aus alten Holzlatten, welche nicht mehr "
	    "uebermaessig stabil wirken. Jede Menge Sand liegt auf ihnen. "
	    "Eine Treppe aus Lehm fuehrt hinunter in den Keller.");
  AddDetail(("menge"),
	    "Sicher nicht sehr wenig.");
  AddDetail(("sand"),
	    "Sand soll in Wuestengegenden ja relativ haeufig vorkommen.");
  AddDetail(({"wueste", "wuestengegend", "wuestengegenden"}),
	    "Arrakeen befindet sich nunmal in einer Wueste.");
  AddDetail(({"latten", "holzlatten"}),
	    "Besonders stabil sehen diese Holzlatten ja nicht mehr gerade aus.");
  AddDetail(("holz"),
	    "Das Holz ist ziemlich alt und wirkt nicht uebermaessig stabil.");
  AddDetail(("lehm"),
	    "An vielen Stellen broeckelt der getrocknete Lehm bereits ab.");
  AddDetail(({"stellen", "stelle"}),
	    "Schau Dir einfach die Waende und die Decke an.");
  AddDetail(("treppe"),
	    "Die Treppe aus getrockneten Lehm fuehrt hinunter in den Keller.");
  AddDetail(("keller"),
	    "Den Keller kannst Du ueber die Treppe erreichen.");
  AddDetail(("einrichtung"),
	    "Die Einrichtung hier ist auesserst karg. Du siehst nur einen "
	    "kaputten Hocker, einen schiefen Tisch, ein Lager aus Stroh und "
	    "einen kleinen Obelisken.");
  AddDetail(({"hocker", "beine"}),
	    "Bei dem Hocker sind zwei Beine abgebrochen, somit ist er nutzlos.");
  AddDetail(({"tisch", "holztisch"}),
	    "Auf dem schiefen Holztisch stehen ein Becher und ein Teller.");
  AddDetail(("becher"),
	    "In dem Becher ist ein wenig Wasser.");
  AddDetail(("wasser"),
	    "Besonders viel ist davon nicht da.");
  AddDetail(("teller"),
	    "Auf dem Teller ist eine Scheibe hartes Brot.");
  AddDetail(({"brot", "scheibe"}),
	    "Die Scheibe Brot ist schon ziemlich hart und vermutlich nur noch "
	    "schwer zu beissen.");
  AddDetail(({"lager", "stroh", "staette", "schlafstaette"}),
	    "Das einfaches Lager aus Stroh duerfte wohl als Schlafstaette dienen.");
  AddDetail(({"stadt", "wuestenstadt", "arrakeen"}),
	    "Du befindet Dich hier in der grossen Wuestenstadt Arrakeen.");
  AddDetail(("nase"),
	    "Du hast eine sehr feinfuehlige Nase.");
  AddDetail(("obelisk"),
	    "Ein schwarzer, metallener Obelisk in "
	    "welchen magische Symbole eingelassen wurden. Obwohl er "
	    "eigentlich sehr klein und leicht aussieht kann man ihn "
	    "nicht im geringsten bewegen. Eine schwarze metallene "
	    "Kette ist an dem Obelisk befestigt.");
  AddDetail(("metall"),
	    "Ein voellig schwarzes, Dir unbekanntes Metall.");
  AddSpecialDetail(({"kette", "ketten"}), "kette_schau");
  AddDetail(({"symbole", "magische symbole"}),
	    "Magische Symbole deren Bedeutung Dir aber verborgen bleibt.");
  AddDetail(("bedeutung"),
	    "Die Bedeutung Dir Symbole bleibt Dir leider verborgen.");
  AddSmell(DEFAULT_SMELL,"Von unten dringt ein unangenehmer Geruch "
	   "an Deine Nase.");
  AddSmell(("geruch"),
	   "Ihhh, das stinkt ja ziemlich dort unten.");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst verschiedenste Geraeusche und Stimmen der Bewohner "
	   "von Arrakeen."); 
  AddSound(({"geraeusche", "alltagsgeraeusche"}),
	   "Typisches Alltagsgeraeusche.");
  AddSound(({"stimmen", "bewohner", "stimme"}),
	   "Du hoerst hohe Stimmen, tiefe Stimmen, leise Stimmen, laute Stimmen, "
	   "junge Stimmen, alte Stimmen und einige mehr, wie es eben bei "
	   "Bewohnern einer Stadt so ueblich ist.");
  AddExit(({"runter"}), ROOM "keller");
  AddExit(({"raus"}), ANSCHLUSS);
  
  AddItem("/obj/sehertor", REFRESH_NONE, ([P_SEERDOOR_DISCOVER:0]));
  
  CLONEME(NPC "maedchen"); 
}  

string kette_schau()
{
  if(present("\ntionil"))
    return BS("Die Kette ist aus demselben schwarzem Metall wie der Obelisk. "
	      "Das kleine Maedchen ist mit ihr an den Obelisk gekettet "
	      "worden.");

  return BS("Die Kette ist aus demselben schwarzem Metall wie der Obelisk. "
	    "Sie liegt ungenutzt am Boden herum.");
}

void reset()
{
  ::reset();

  if(!present("\ntionil") && !present("\ntionildaemonin"))
    CLONEME(NPC "maedchen"); 
}
