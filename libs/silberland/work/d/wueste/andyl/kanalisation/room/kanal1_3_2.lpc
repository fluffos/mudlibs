#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	  "Du stehst hier an einer Kreuzung in der Kanalisation von "
	  "Arrakeen. Ein Gang fuehrt weiter runter nach Norden, ein "
	  "anderer nach Nordosten und der letzte zurueck nach Sueden. "
	  "Du bist Dir ziemlich sicher, dass Du beobachtet wirst.\n");  
  
  AddDetail(("boden"),
	    "Der Boden ist eine undefinierbare Bruehe, aus Faekalien, "
	    "Sand und Wasser.");
  AddDetail(({"bruehe", "wasser"}),
	    "Diese braune wasserhaeltige Bruehe ist einfach nur ekelhaft.");
  AddDetail(("faekalien"),
	    "Die willst Du jetzt aber nicht naeher untersuchen, oder?");
  AddDetail(("sand"),
	    "Klein, braun, sandig. Sand eben.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("lehm"),
	    "Der Lehm wurde zuerst getrocknet.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende hier bestehen aus Lehm und Sand.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(({"arrakeen", "name", "stadt"}),
	    "Arrakeen ist der Name der Stadt ueber Dir.");
  AddDetail(({"gang", "gaenge", "kreuzung", "nordunten"}),
	    "Drei Gaenge fuehren von hier weiter. Einer nach Nordunten, "
	    "einer nach Nordosten und der letzte nach Sueden.");
  
  AddSmell(DEFAULT_SMELL,"Es riecht hier einfach ekelhaft.");
  AddSound(DEFAULT_SOUND,
	   "Du glaubst ein leises Zischen im Norden zu hoeren.");
  AddSound(("zischen"),
	   "Jetzt hoerst Du es nicht mehr, aber Du bist Du bist "
	   "Dir sicher, dass es aus Norden kam.");

  AddExit(({"nordunten"}), ROOM "monsterhoehle"); 
  AddExit(({"nordosten"}), ROOM "kanal1_4_3");
  AddExit(({"sueden"}),    ROOM "kanal1_3_1");
  
  AddItem(({NPC "wuestenspinne", NPC "narugzombie", NPC"narugskelett",
	      NPC"narugmumie" }), REFRESH_DESTRUCT, 
	  ([P_MNPC_DEFAULTROOM:file_name()])); 
}







