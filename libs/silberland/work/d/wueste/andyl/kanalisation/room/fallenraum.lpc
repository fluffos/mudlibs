#include "../def.h"

inherit "std/room";

nosave int falle1=1;
nosave int falle2=1;
nosave int falle3=1;

nosave int fallenentschaerft=0;

nosave int trankda=1;
nosave int trank=random(4);

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	  "Dieser Raum besteht voellig aus massiven Steinquadern und "
	  "wirkt auch ansonsten verhaeltnismaessig sauber. Selbst "
	  "der Gestank ist hier nicht ganz so unertraeglich wie "
	  "in der uebrigen Kanalisation. Einzig dichte "
	  "Nebelschwaden durchstreifen den Raum. Dein Gefuehl raet Dir "
	  "dennoch hier extra vorsichtig zu sein.\n");
  
  AddDetail(("gefuehl"),
	    "Dein Gefuehl raet Dir, hier extra vorsichtig zu sein. Zudem "
	    "fuehlst Du Dich beobachtet und das bereitet Dir zusaetzliches "
	    "Unbehagen.");
  AddDetail(("raum"),
	    "Dieser Raum unterscheidet sich recht deutlich von der uebrigen "
	    "Kanalisation.");
  AddDetail(("decke"),
	    "Wie auch die Waende und der Boden besteht die Decke aus "
	    "grossen Steinquadern. Du kannst einen duennen laenglichen "
	    "Schlitz oberhalb der Suedwand und davor ein Loch entdecken.");
  AddDetail(("schlitz"),
	    "Zu was auch immer dieser Schlitz gut sein soll, er bereitet "
	    "Dir ernstes Kopfzerbrechen.");
  AddDetail(("loch"),
	    "Zu was auch immer dieses Loch gut sein soll, es bereitet "
	    "Dir ernste Bedenken.");
  AddDetail(({"kopfzerbrechen", "bedenken"}),
	    "Vielleicht solltest Du hier alles naeher untersuchen um deine "
	    "Bedenken zu zerstreuen.");
  AddDetail(({"nebel", "nebelschwaden", "schwaden"}),
	    "Dichte Nebelschwaden ziehen durch den Raum. Das eigenartige daran: "
	    "Der Nebel hat eine giftgruene Faerbung.");
  AddDetail(("faerbung"),
	    "Die unnatuerlich gruene Faerbung des Nebels ist einerseits "
	    "ungewoehnlich und andererseits besorgniserregend.");
  AddDetail(({"unbehagen", "unrecht"}), 
	    "Dein Unbehagen ist hier ziemlich gross. Vermutlich nicht zu "
	    "Unrecht.");
  AddDetail(("boden"),
	    "Der Boden besteht aus dicken Steinquadern und ist mit jeder "
	    "Menge Sand und einigen Steinchen bedeckt.");
  AddDetail(({"quader", "steinquader"}),
	    "Die Steinquader sind ziemlich massiv. Muss ziemlich viel Arbeit "
	    "gewesen sein die hier her zu schaffen.");
  AddDetail(({"steinchen", "steine"}),
	    "Etliche Steine und Steinchen liegen am Boden herum.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(({"arrakeen", "stadt", "wuestenstadt"}),
	    "Arrakeen wird die Wuestenstadt ueber Dir genannt.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende hier bestehen aus dicken Steinquadern. An der Ostwand "
	    "der Westwand und der Suedwand faellt Dir etwas auf.");
  AddSpecialDetail(({"westwand", "loecher"}), "westwand_schau");
  AddSpecialDetail(({"ostwand", "kette"}), "ostwand_schau");
  AddSpecialDetail(({"suedwand", "kaestchen"}), "suedwand_schau");
  AddSpecialDetail(({"haken", "stahlhaken"}), "haken_schau");
  AddDetail(("arbeit"),
	    "Extrem viel Arbeit!");
  AddDetail(({"sand", "menge"}),
	    "Da liegt eine Menge Sand am Boden. Moment, unter dem "
	    "Sand entdeckst Du eine Steinplatte.");
  AddSpecialDetail(({"steinplatte", "platte", "druckplatte"}), "platte_schau");
  AddDetail(("geschick"),
	    "Nur gut, dass Du so geschickt bist.");
  AddDetail(("erfindungsgeist"),
	    "Der ist so manches mal ziemlich hilfreich.");
  
  AddSmell(({DEFAULT_SMELL,"gestank"}),
	   "Der Gestank ist hier gar nicht mal so schlimm.");
  AddSound(DEFAULT_SOUND,
	   "Es ist unheimlich still hier."); 

  AddExit(({"norden"}), ROOM "kanal1_5_3");

  AddCmd(("oeffne"), "oeffne_was");
  AddCmd(({"blockier", "blockiere"}), "blockiere_was");
  AddCmd(({"befestige", "befestig", "mach", "mache"}), "mach_was");
  AddCmd(({"verstopfe", "verstopf", "stopf", "stopf"}), "verstopfe_was");
}  

nosave int verstopfe_was(string str)
{
  notify_fail("Was willst Du mit was verstopfen?\n");
  if(!str) return 0;
  
  if(str == "loecher"||str=="loch")
    {
      notify_fail(BS("Womit willst Du die Loecher verstopfen?"));
      return 0;
    }
  
  if(str == "loecher mit steinchen" || str == "loecher mit steinen" ||
     str == "loecher in westwand mit steinchen" || 
     str == "loecher in westwand mit steinen" )
    if(!falle3)
      {
	write(BS("Die Loecher in der Westwand wurden bereits verstopft."));
	return 1;
      }
    else
      if(random(TP->QueryAttribute(A_DEX)) < 10) // Geschicklichkeitstest
	return write(BS("Du versuchst die Loecher in der Westwand mit den "
			"Steinchen zu verstopfen, doch du stellst Dich so "
			"ungeschickt an, dass alle Steinchen wieder "
			"herausfallen.")+
		     BS("Du denkst . o O (Beim naechsten Mal klappt es "
			"bestimmt!)")), 1;
      else
	{
	  say(BS(TPN+" macht sich an der Westwand zu schaffen."));
	  
	  write(BS("Geschickt verstopfst Du die Loecher in der Westwand "
		   "mit den Steinchen."));

	  falle3=0;
	  
	  fallenentschaerft++;
	  
	  return 1;
	}
  
  if(str == "locher mit sand")
    if(!falle3)
      {
	write(BS("Die Loecher in der Westwand wurden bereits verstopft."));

	return 1;
      }
    else
      {
	write(BS("Das scheint mit dem Sand nicht wirklich gut zu gehen."));

	return 1;
      }

  return 0;
}

nosave int mach_was(string str)
{
  notify_fail("Was willst Du wo festmachen?\n");
  if(!str) return 0;

  if(str == "kette fest")
    {
      write("Woran willst Du die Kette festmachen?");

      return 1;
    }
  
  if(str == "kette an haken" || str == "kette an stahlhaken" ||
     str == "kette an haken fest" || str == "kette an stahlhaken fest" )
    if(!falle2)
      {
	write(BS("Das wurde schon gemacht."));

	return 1;
      }
    else
      if(random(TP->QueryAttribute(A_DEX)) < 8) // Geschicklichkeitstest
	return write(BS("Du versuchst die Kette an dem Stahlhaken zu "
			"befestigen, doch du stellst Dich so ungeschickt "
			"an, dass Dir die Kette aus der Hand rutscht.")+
		     BS("Du denkst . o O (Beim naechsten Mal klappt es "
			"bestimmt!)")), 1;
      else
	{
	  say(BS(TPN+" macht sich an der Ostwand zu schaffen."));
	  
	  write(BS("Du haengst die Kette am Stahlhaken fest und blockierst "
		   "so den Mechanismus der ausgeloest werden sollte."));
	  
	  falle2=0;
	  
	  fallenentschaerft++;

	  return 1;
	}
  
  return 0;
}


string haken_schau()
{
  if(falle2)
    return BS("Aus der Ostwand ragt ein Stahlhaken heraus.");

  return BS("Aus der Ostwand ragt ein Stahlhaken heraus an "
	    "der eine Kette festgemacht wurde.");
}

string ostwand_schau()
{
  if(falle2)
    return BS("Aus der Ostwand ragt ein Stahlhaken und eine Kette "
	      "fuehrt vom Boden in die Decke. Durch die Kette wird mit "
	      "ziemlicher Sicherheit irgendetwas unangenehmes ausgeloest. "
	      "Vielleicht kann man die Kette ja irgendwo festmachen?");

  return BS("Aus der Ostwand ragt ein Stahlhaken an der eine Kette "
	    "festgemacht wurde.");
}

string westwand_schau()
{
  if(falle3)
    return BS("In der Westwand sind einige besorgniserregene Loecher zu "
	      "entdecken aus den sehr unerfreuliche Dinge schiessen "
	      "koennten. Ob man die Loecher wohl mit irgendwas verstopfen "
	      "koennte?");

  return BS("In der Westwand sind einige Loecher die aber verstopft wurden.");
}

string suedwand_schau()
{
  string ret;

  ret=BS("In der Suedwand ist ein kleines Kaestchen im Stein eingelassen, "
	 "welches man oeffnen koennte.");

  switch(fallenentschaerft)
    {
      
    case 0:
      
      return ret+=BS("Allerdings waere es ausgesprochen ratsam sich vorher "
		     "noch etwas umzusehen.");
      
    case 1:
      
      return ret+=BS("Allerdings waere es sehr ratsam sich vorher noch etwas "
		     "umzusehen.");
      
    case 2:
      
      return ret+=BS("Allerdings waere es ratsam sich vorher noch etwas "
		     "umzusehen.");
      
    default:
      
      return ret;
    }
}

nosave int blockiere_was(string str)
{
  notify_fail("Was willst Du blockieren?\n");
  if(!str) return 0;

  if(str == "platte" || str == "steinplatte" || str == "druckplatte" )
    if(!falle1)
      {
	write(BS("Die Druckplatte ist doch bereits blockiert."));

	return 1;
      }
    else
      if(random(TP->QueryAttribute(A_INT)) < 12) // Geschicklichkeitstest
	return write(BS("Du drehst Dich im Kreise und suchst herum, aber "
			"Dir will einfach nicht einfallen, womit du die "
			"Platte blockieren koenntest...")+
		     BS("Du denkst . o O (Bin ich zu dumm? Ich sollte es "
			"nochmal probieren!)")), 1;
      else
	{
	  say(BS(TPN+ " macht sich am Boden zu schaffen."));
	  
	  write(BS("Mit einigem Geschick und Erfindungsgeist blockierst "
		   "Du die Druckplatte mit dem herumliegenden Sand."));
	  
	  falle1=0;
	  
	  fallenentschaerft++;
	  
	  return 1;
	} 
  
  return 0;
}

string platte_schau()
{
  if(falle1)
    return BS("Das scheint eine Druckplatte zu sein, die irgendetwas "
	      "Unerfreuliches ausloest. Ob man die wohl blockieren koennte?");

  return BS("Das scheint eine Druckplatte zu sein, die irgendetwas "
	    "Unerfreuliches ausloest. Ihr Mechanismus wurde aber mit "
	    "Sand blockiert. ");
}

nosave int oeffne_was(string str)
{
  object ob;

  notify_fail("Was willst Du oeffnen?\n");
  if(!str) return 0;

  if(str == "kaestchen" || str == "kaestchen in suedwand")
    {
      SetProp(P_KILL_NAME, "Eine alte Vorrichtung von toedlicher Arglist");
      
      if(falle1)
	{
	  write("\n"
		"@@@  @@@  @@@  @@@@@@  @@@@@@@@@@  @@@@@@@@@@\n"  
		"@@!  @@!  @@! @@!  @@@ @@! @@! @@! @@! @@! @@!\n"
		"@!!  !!@  @!@ @!@!@!@! @!! !!@ @!@ @!! !!@ @!@\n"
		" !:  !!:  !!  !!:  !!! !!:     !!: !!:     !!:\n"
		"  ::.:  :::    :   : :  :      :    :      :  \n"
		"\n"+
		BS("Eine riesiges Saegeblatt faehrt mit irrsinniger Wucht "
		   "aus der Decke auf Dich hernieder."));

	  say(BS("Auf "+TP->name(WER,0)+" faehrt mit irrsinniger Wucht "
		 "ein Saegeblatt aus der Decke hernieder."));
	  
	  TP->do_damage(200);
	}
      if(falle2)
	{
	  write("\n"
		" ___________ _____ _____  _   _ _\n"
	        "|___  /_   _/  ___/  __ \\| | | | |\n"
		"   / /  | | \\ `--.| /  \\/| |_| | |\n"
                "  / /   | |  `--. \\ |    |  _  | |\n"
                "./ /____| |_/\\__/ / \\__/\\| | | |_|\n"
                "\\_____/\\___/\\____/ \\____/\\_| |_\(_\)\n"
		"\n"+
		BS("Ein Flammenstrahl aus der Decke verbrennt Dich."));

	  say(BS(TPN+" wird von einem Flammenstrahl aus der "
		 "Decke heftig getroffen."));
	  
	  TP->do_damage(150);
	}

      if(falle3)
	{
	  write("\n"
		"@@@@@@@@ @@@ @@@  @@@  @@@@@@@  @@@\n"
		"     @@! @@! @@!@!@@@ !@@       @@@\n"
		"    @!!  !!@ @!@@!!@! !@! @!@!@ !@!\n"
		" !!:     !!: !!:  !!! :!!   !!:    \n"
		":.::.: : :   ::    :   :: :: :  :.:\n"
		"\n"+
		BS("Armbrustbolzen schiessen ploetzlich aus der\n"
		   "Westwand auf Dich zu."));

	  say(BS("Armbrustbolzen schiessen ploetzlich aus "
		 "der Westwand auf "+TP->name(WEN,0)+" zu."));

	  TP->do_damage(100);	
	}
      
      if(TP->QueryProp(P_GHOST)) //hehe schon tot?
	return 1;
      
      say(BS(TP->name(WER,0)+" oeffnet das Kaestchen in der Suedwand."));
      
      if(!trankda)
	{
	  write(BS("Du oeffnest das Kaestchen in der Suedwand "
		   "findest aber nichts darin und schliesst es "
		   "deshalb wieder."));
	  return 1;
	}
      
      switch(random(4))
	{
	case 1: ob=clone_object(OBJ"schwacherheiltrank");
	  break; 
	  
	case 2: ob=clone_object(OBJ"heiltrank");
	  break;
	  
	case 3: ob=clone_object(OBJ"starkerheiltrank");
	  break;
	  
	default: ob=clone_object(OBJ"egifttrank");
	  break;
	}
      
      if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  write(BS("Du oeffnest das Kaestchen in der Suedwand und findest "
		   "einen Trank darin. Da er Dir jedoch zu schwer werden "
		   "wuerde, laesst Du ihn bleiben und schliesst das "
		   "Kaestchen wieder."));
	  
	  ob->remove(1);
	  
	  return 1;
	}

      write(BS("Du oeffnest das Kaestchen in der Suedwand "
	       "und findest einen Trank darin, den Du sofort "
	       "einsteckst."));
      
      trankda=0;
      
      return 1;
    }
  
  return 0;
}

void reset()
{
  ::reset();

  falle1=1;
  falle2=1;
  falle3=1;
  
  fallenentschaerft=0;
  
  trankda=1;
}
