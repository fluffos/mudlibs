#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Eine Saeulenhalle in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du befindest Dich hier in einer grossen Saeulenhalle. Alles hier ist "
	   "aus altem Marmor. Du siehst keine Einrichtungsgegenstaende, dafuer ein "
	   "grosses Becken in der Mitte des Raumes. Dichter giftgruener Nebel geht "
	   "von dem Becken aus und zieht quer durch den Raum. Der Boden ist mit "
	   "unzaehligen Skeletten bedeckt und es riecht nach Tod und Verwesung. "
	   "Der Durchgang fuehrt zurueck nach Nordwesten.\n");

  AddDetail(("marmor"),
	    "Dies scheint sehr feiner, kostbarer Marmor zu sein.");
  AddDetail(({"einrichtungsgegenstaende", "gegenstaende", "einrichtung"}),
	    "Einrichtungsgegenstaende kannst Du hier nirgends entdecken aber "
	    "ein grosses Becken ist in der Mitte des Raumes.");
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht ein grosses Becken.");
  AddDetail(({"becken"}),
	    "In der Mitte des Raumes steht das grosse Becken. Eine "
	    "brodelnde gruene Fluessigkeit befindet sich darin. Hin "
	    "und wieder zischt die Fluessigkeit auf und mehr gruener "
	    "Nebel wird erzeugt.");
  AddDetail(("fluessigkeit"),
	    "Eine gruene, zaehe, uebelriechende Fluessigkeit.");
  AddDetail(({"nebel", "nebelschwaden", "gruene nebelschwaden", "gruener nebel"}),
	    "So dicht wie hier ist der gruene Nebel noch nirgends sonst gewesen. "
	    "Das Becken scheint der Ursprung es Nebels zu sein.");
  AddDetail(("ursprung"),
	    "Das Becken scheint der Ursprung es Nebels zu sein.");	    
  AddDetail(("boden"),
	    "Der Boden ist aus feinstem Marmor und mit unzaehligen Skeletten "
	    "bedeckt.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus feinstem Marmor. Hin und wieder ist etwas "
	    "eingetrocknetes Blut auf ihnen zu sehen.");
  AddDetail(({"blut"}),
	    "Hier und da siehst Du eingetrocknetes Blut an den Waenden.");
  AddDetail(({"decke"}),
	    "Die Decke besteht aus feinstem Marmor.");
  AddDetail(({"saeulenhalle", "halle", "raum"}),
	    "Du befindest Dich hier in einer grossen Saeulenhalle. Die Saeulen "
	    "sind relativ schmucklos, dafuer aber aus feinstem Marmor gefertigt.");
  AddDetail(({"saeulen", "saeule"}),
	    "Die Saeulen bestehen aus feinstem Marmor.");
  AddDetail(("durchgang"),
	    "Der Durchgang fuehrt zurueck nach Nordwesten.");
  AddDetail(("skelette"),
	    "Der Boden ist mit unzaehligen menschlichen Skeletten bedeckt, aber "
	    "auch Skelette anderer Kreaturen wie Nftah, Zwerge und Elfen "
	    "kannst Du entdecken. Fast alle menschlichen Skelette tragen "
	    "das Zeichen der Bruderschaft von Narug.");
  AddDetail(("zeichen"),
	    "Fast alle menschlichen Skelette tragen das Zeichen der Bruderschaft "
	    "von Narug.");
  AddDetail(({"bruderschaft", "narug", "geheimorganisation", "bruderschaft von Narug", "art"}),
	    "Die Bruderschaft von Narug scheint eine Art Geheimorganisation gewesen "
	    "zu sein.");
  AddDetail(({"elfen", "zwerge", "nftah", "kreaturen"}),
	    "Alle tot und ihre Ueberreste grausam verstuemmelt.");
  AddDetail(("ueberreste"),
	    "Viel ist wirklich nicht mehr vorhanden.");
  AddSmell(DEFAULT_SMELL,"Es riecht nach Tod und Verwesung.");
  AddSmell(({"tod", "verwesung"}),
	   "Dir wird hier richtiggehend uebel.");
  AddSound(DEFAULT_SOUND,
	   "Bis auf ein leises gelegentliches Zischen im Becken ist es hier "
	   "still.");
  AddSound(("zischen"),
	   "Jedes mal wenn es zischt steigt wieder etwas mehr Nebel aus dem "
	   "Becken auf.");
  
  AddExit(({"durchgang"}), ([EX_DEST: ROOM "kanal1_5_4",
			      EX_MSG: "in den Durchgang"])); 
  
  // XANATHIR
  
  AddItem(NPC "beholder", REFRESH_DESTRUCT);
}  
