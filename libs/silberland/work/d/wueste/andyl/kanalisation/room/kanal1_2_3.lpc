#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein finsterer Raum unterhalb von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du befindest dich inmitten der Kanalisation unter Arrakeen, es ist "
	   "ziemlich finster, aber Du erkennst doch das Wesentliche. "
	   "Es riecht hier ziemlich unangenehm, aber man gewoehnt sich ja an "
	   "alles. Irgendwie fuehlst Du Dich beobachtet.\n"
	   "Im Sueden fuehrt der Weg weiter in die Kanalisation und "
	   "im Suedwesten geht es zurueck zum Eingang.\n");
  AddDetail(("eingang"),
	    "Der Eingang zur Kanalisation befindet sich im Suedwesten.");
  AddDetail(({"wesentliches","wesentliche","eigentliches","eigentliche"}),
	    "Das Eigentliche ist unsichtbar, und das ist das einzig "
	    "Wesentliche.");
  AddDetail(({"himmel","decke"}),
	    "Du schaust nach oben, aber Du siehst nichts, ausser "
	     "einer grau-gelben Flaeche. Der Hauptbestandteil "
	     "der Decke duerfte Sand sein.");
  AddDetail(({"flaeche"}),
	    "Die Decke ist ziemlich flach, also ist es eine "
	     "Flaeche.");
  AddDetail(({"wand","waende"}),
	    "Eigentlich kann man das nicht als Wand bezeichnen. Das, was Du "
	     "hier siehst, sind Unmengen von Sand, gestapelt, und durch "
	    "Feuchtigkeit zusammengehalten.");
  AddDetail(({"unmengen"}),
	    "Im laufe der Zeit hat sich hier wahrlich eine "
	    "Menge Sand angesammelt. Der Typ der den Sand hierhergetragen "
	    "hat, wahr bestimmt ziemlich lange beschaeftigt.");
  AddDetail(("typ"),
	    "Das war sich ein schwarzarbeitender, unterbezahlter Nftah.");
  AddDetail(("nftah"),
	    "Die sieht man hier in Arrakeen nicht oft.");
  AddDetail(({"zeit","menge","entschluss"}),
	    "Ein sehr subjektiver Begriff... Denk mal darueber nach.");
  AddDetail(({"begriff"}),"Begriffe kann man nicht untersuchen. TSTSTS.");
  AddDetail(({"kanalisation"}),"Du befindest Dich mitten drinnen.");
  AddDetail(({"feuchtigkeit"}),
	    "Obwohl rund um Dich nur Wueste ist, ist hier "
	    "unten alles ziemlich feucht. Du wunderst Dich.");
  AddDetail(({"wueste"}),
	    "Du befindest dich darin, darunter und irgendwie auch darauf!");
  AddDetail(({"sand","hauptbestandteil","bestandteil"}), 
	    "Sand ist der Hauptbestandteil einer Wueste.");
  AddDetail(({"arrakeen","wuestenstadt"}),
	    "Wenn du Arrakeen untersuchen willst, solltest du hinauf gehen");
  AddDetail(({"boden"}), 
	     "Am Boden befinden sich farbtechnisch gesehen einige interssante,"
	     " und durchaus sehenswerte Kombinationen von Farben und "
	     "Formen.");
  AddDetail(({"farbe","farben","kombination","kombinationen"}),
	    "Dir offenbaren sich hauptsaechlich Kombinationen aus sattem "
	     "Gelb und Braun.");
  AddDetail(({"gelb","braun"}),
	    "Irgendwie erinnert dich die Farbe an "
	     "etwas...");
  AddDetail(({"form","formen"}),
	    "Du koenntest nicht genau sagen was das wohl ist.");
  AddDetail(({"weg"}),
	    "Du kannst nicht viel erkennen, da ueberall Nebelschwaden "
	    "haengen.");
  AddDetail(({"nebel","nebelschwaden"}), 
	    "Hier ist der Nebel noch ertraeglich, aber dennoch nicht "
	    "sehr wohltuend. Eine wirklich unangenehme Gegend.");
  AddDetail(({"gegend"}),
	    "Wueste, es stinkt, es ist heiss und feucht. Ausgesprochen unangenehm.");
  AddDetail(({"nase","augen"}),
	    "Du bist zwar toll, aber das schaffst Du dann "
	    "doch nicht."); 
  AddDetail(({"stadt"}),
	    "Ueber Dir befindet sich Arrakeen, die beruehmte Wuestenstadt.");
  AddDetail(({"faekalien"}),
	    "Pfui, grauslich, geschmacklos!");
  AddSmell(DEFAULT_SMELL,"Es riecht nach ziemlich graesslichen Dingen. "
	   "Du denkst kurz nach und kommst zum Entschluss, dass Du nicht "
	   "genau wissen willst was Du gerade gerochen hast.");
  AddSmell(({"dinge"}),
	   "Du hast es so gewollt. Dir steigt der Geruch von "
	   "ziemlich alten Faekalien in die Nase. "
	   "Dir traenen die Augen !");
  AddSmell(({"geruch","faekalien"}),"Einfach nur graesslich!");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst einige Geraeusche, die wahrscheinlich "
	   "von den Wesen in der Stadt ueber dir kommen.");
  AddSound(({"wesen","menschen"}),
	   "Du hoerst eigentlich nur mehr dass ueber Dir noch was sein "
	   "muss. Du hoerst aber nichts bestimmtes.");
  AddSound(({"geraeusche","geraeuschen"}), 
	   "Die Geraeusche sind nicht eindeutig zu identifizieren.");

  AddExit(({"sueden"}), ROOM "kanal1_2_2");
  AddExit(({"suedwesten"}), ROOM "eingang");
}  
