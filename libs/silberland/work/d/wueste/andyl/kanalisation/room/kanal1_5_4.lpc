#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier in einem weiteren Raum der Kanalisation "
	   "von Arrakeen. Dichte giftgruene Nebelschwaden ziehen durch den "
	   "Raum und es riecht weniger nach Kanalisation sondern eher "
	   "nach Tod und Verderben. Drei Skelette liegen am Boden. "
	   "Im Suedosten ist ein Durchgang der anscheinend zum "
	   "Ursprungsort des gruenen Nebels fuehrt. Ein Weg fuehrt zurueck "
	   "nach Sueden. Du fuehlst Dich sehr genau beobachtet.\n");  

  AddDetail(({"gruenen Nebel", "giftgruenen Nebel", "Nebel", "Nebelschwaden", "schwaden", "raum"}),
	    "Dicht ziehen die giftgruenen Nebelschwaden durch den Raum und blockieren "
	    "so massiv Deine Sicht.");
  AddDetail(("weg"),
	    "Der Weg fuehrt zurueck nach Sueden.");
  AddDetail(("sicht"),
	    "Deine Sicht wird durch den Nebel massiv blockiert.");
  AddDetail(("boden"),
	    "Der Boden besteht aus einem ekelhaftem braunen Schlamm. "
	    "In dem Schlamm sind drei menschliche Skelette zu sehen.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(("arrakeen"),
	    "Arrakeen befindet sich irgendwo ueber Dir.");
  AddDetail(({"sand", "bestandteil"}),
	    "Sand, ein beliebter Bestandteil von Wuesten.");
  AddDetail(({"wueste"}),
	    "Arrakeen befindet sich ja in der Wueste.");
  AddDetail(({"tod", "verderben"}),
	    "Tod und Verderben lauern hier irgendwo. Nur wo genau?");
  AddDetail(({"ursprungsort", "ursprung"}),
	    "Der Ursprungsort des gruenen Nebels scheint im Suedosten zu liegen.");
  
  AddDetail(("schlamm"),
	    "Du moechtest nicht wissen aus was sich dieser Schlamm zusammensetzt. "
	    "Drei menschliche Skelette stecken in dem Schlamm.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("lehm"),
	    "Lehm wird in Wuestengegenden recht haeufig eingesetzt.");
  AddDetail(({"wueste", "wuestengegend", "gegend", "gegenden" "wuestengegenden"}),
	    "Du befindest Dich hier in der Wueste oder besser gesagt: darunter.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende hier bestehen aus Lehm und Sand. Die suedoestliche Wand "
	    "in welche der Durchgang fuehrt besteht jedoch aus soliden Felsbloecken.");
  AddDetail(({"bloecke", "felsbloecke", "fels"}),
	    "Der Durchgang nach Suedosten und die Wand davor bestehen aus massiven "
	    "Felsbloecken.");
  AddDetail(({"durchgang"}),
	    "Der Durchgang ist ziemlich breit, sodass auch grosse Kreaturen "
	    "ohne Probleme durchgehen koennen.");
  AddDetail(("kreaturen"),
	    "Solchen Kreaturen moechtest Du lieber nicht begegnen.");
  AddDetail(({"problem", "probleme"}),
	    "Ein Problem oder mehrere Probleme scheinen nicht weit von hier zu sein.");
  AddDetail(({"skelette", "menschliche skelette", "skelett", "menschliches skelett"}),
	    "Drei menschliche Skelette stecken in dem Schlamm. Sie sind extrem "
	    "schlimm zugerichtet, also wer immer diese armen Seelen getoetet "
	    "hat muss ausgesprochen maechtig sein. Du kannst bei jedem Skelett "
	    "das Zeichen der Bruderschaft von Narug entdecken.");
  AddDetail(({"seelen", "frieden"}),
	    "Die armen Seelen. Moegen sie in Frieden ruhen!");
  AddDetail(("zeichen"),
	    "Jedes Skelett traegt das Zeichen der Bruderschaft von Narug.");
  AddDetail(({"narug", "bruderschaft", "bruderschadt von narug", "geheimorganisation", "art"}),
	    "Die Bruderschaft von Narug duerfte eine Art Geheimorganisation "
	    "gewesen sein.");
  AddSmell(DEFAULT_SMELL,"Es stinkt hier nach Tod und Verderben.");
  AddSmell(({"tod", "verderben", "hauch"}),
	   "Unverkennbar der Hauch des Todes.");
  AddSound(DEFAULT_SOUND,
	   "Es ist still hier. Zu still!"); 
  
  AddExit(({"sueden"}), ROOM "kanal1_5_3"); 
  AddExit(({"durchgang"}), ([EX_DEST: ROOM "beholderversteck",
			      EX_MSG: "in den Durchgang"])); 
}  







