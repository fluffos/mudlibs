#include "../def.h"

inherit "std/room";

nosave int gegenstandda=1;

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "In diesem Teil der Kanalisation von Arrakeen fuehren "
	   "zwei Gaenge weiter. Einer nach Suedwesten und der andere "
	   "nach Nordwesten. Ein paar groesser Steine liegen hier am Boden. "
	   "Du hast das Gefuehl als wuerde jemand ein wachsames Auge "
	   "auf Dich werfen.\n"); 

  AddDetail(({"teil", "kanalisation"}),
	    "Du befindest Dich hier in einem Teil der Kanalisation von "
	    "Arrakeen.");
  AddDetail(("arrakeen"),
	    "Schaetzungsweise duerfte Arrakeen direkt ueber Dir liegen.");
  AddDetail(({"gaenge", "gang"}),
	    "Zwei Gaenge fuehren von hier weiter. Einer nach Nordwesten und "
	    "der andere nach Suedwesten.");
  AddDetail(({"boden", "verbund"}),
	    "Der Boden besteht groesstenteils aus einem Verbund von Wasser, "
	    "Sand, Dreck und diversen undefinierbaren Dingen.");
  AddDetail(({"wasser", "gedanken", "gedanke"}),
	    "Du tust Dir schwer bei dem Gedanken das unter Dir Wasser "
	    "nennen zu sollen.");
  AddDetail(("sand"),
	    "Oh, Sand. Schon lang nicht mehr gesehen in dieser Wueste.");
  AddDetail(({"wueste", "weiten"}),
	    "Die Wueste, unendliche Weiten...");
  AddDetail(("dreck"),
	    "Also Du kannst nur eines sagen: Dieser Dreck stammt garantiert "
	    "nicht von Dir!");
  AddDetail(({"dingen", "fee", "zwerge", "zwerg", "bloedsinn", "haeuflein", 
		"ausfluss", "undefinierbare dinge"}),
	    "Bei den undefinierbaren Dingen handelt es sich um den Ausfluss "
	    "einer Fee, dem Haeuflein eines Zwerges und...\n"
	    "...nooeee, Bloedsinn. Du willst gar nicht wissen was fuer Dinge "
	    "das wirklich sind.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("lehm"),
	    "Der wurde hier als Baustoff eingesetzt.");
  AddDetail(({"baustoff", "baustoffe", "max", "verwandten", "verwandte", 
		"verwandtem"}),
	    "Anscheinend soll es bei einem Verwandtem von Max ja tolle "
	    "Baustoffe geben."); 
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen hier aus Sand und Lehm.");
  AddDetail(("gefuehl"),
	    "Kein sehr angenehmes Gefuehl.");
  AddDetail(({"auge"}),
	    "Vermutlich nicht nur ein wachsames Auge.");
  AddDetail(({"steine", "weg"}),
	    "Ein paar ballgrosse Steine liegen hier auf dem Weg. Einer "
	    "davon faellt Dir besonders auf.");
  AddDetail(("stein"),
	    "Unter dem Stein scheint etwas zu liegen. Ob man "
	    "den Stein wohl wegrollen kann?");
  
  AddSmell(DEFAULT_SMELL,"Es riecht hier ziemlich ekelerregend.");
  AddSound(DEFAULT_SOUND,
	   "Es ist absolut still hier."); 

  AddExit(({"nordwesten"}), ROOM "kanal1_3_4"); 
  AddExit(({"suedwesten"}), ROOM "kanal1_3_2"); 

  AddCmd(({"roll", "rolle"}), "rolle_was");
}  

nosave int rolle_was(string str)
{
  notify_fail("Was willst Du wegrollen?\n");
  if(!str) return 0;
  
  if(str == "stein" || str == "stein weg" )
    {
      if(!gegenstandda)
	{
	  say(BS(TPN+" rollt einen Stein etwas zur Seite."));

	  write(BS("Du findest leider nur einige verrostete Eisenteile "
		   "die voellig unbrauchbar sind."));

	  return 1; 
	}
	
      switch(random(4))
	{
	case 1:
	  say(BS(TPN+" rollt einen Stein weg und scheint etwas darunter "
		 "gefunden zu haben."));
	
	  write(BS("Du rollst den Stein weg und findet darunter ein Paar "
		   "Sandalen."));

	  CLONEME("/p/armour/boots/sandalen");

	  gegenstandda=0;

	  return 1;
	  
	case 2:
	  	  
	  say(BS(TPN+" rollt einen Stein weg und scheint etwas darunter "
		 "gefunden zu haben."));

	  write(BS("Du rollst den Stein weg und findest darunter "
		   "ein Paar Lederarmschienen."));

	  CLONEME("/p/armour/bracers/lederarmschienen");

	  gegenstandda=0;

	  return 1;

	case 3:
	  
	  say(BS(TPN+" rollt einen Stein weg und scheint etwas darunter "
		 "gefunden zu haben."));

	  write(BS("Du rollst Den Stein weg und findest darunter "
		   "einen Guertel."));

	  CLONEME("/p/armour/belt/guertel");

	  gegenstandda=0;

	  return 1;
	  
	default:
	  
	  say(TPN+" rollt einen Stein etwas zur Seite.");
	  
	  write(BS("Du findest leider nur einige verrostete Eisenteile "
		   "die voellig unbrauchbar sind."));

	  gegenstandda=0;

	  return 1;
	}
    }

  return 0;
}

void reset()
{
  ::reset();

  gegenstandda=1;
}
