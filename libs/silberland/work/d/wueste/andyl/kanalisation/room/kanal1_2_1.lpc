#include "../def.h"

inherit "std/room";

nosave int gegenstandda=1;

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier in einer Sackgasse in der Kanalisation. "
	   "Der einzige Weg der offensichtlich von hier wieder wegfuehrt "
	   "ist der zurueck nach Norden. Nach wie vor fuehlst Du Dich "
	   "beobachtet, siehts aber nirgends jemanden.\n");  
  AddDetail(("sackgasse"),
	    "Du befindest Dich hier in einer Sackgasse. Du kommst nirgends "
	    "weiter, Du kannst nur zurueck.");
  AddDetail(("weg"),
	    "Der einzige Weg den es hier gibt, ist der zurueck nach Norden.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier, wie Du unschwer am Geruch erkennen kannst, "
	    "in der Kanalisation unterhalb von Arrakeen.");
  AddDetail(({"arrakeen", "wuestenstadt", "stadt"}),
	    "Arrakeen wird die Wuestenstadt ueber Dir genannt.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm und Sand. Sie ist "
	    "etwas feucht.");
  AddDetail(("sand"),
	    "Sand findet man in der Wueste doch relativ haeufig.");
  AddDetail(("wueste"),
	    "Arrakeen befindet sich ja in der Wueste.");
  AddDetail(({"lehm", "getrockneten lehm", "baustoff"}),
	    "Getrockneter Lehm ist ein beliebter Baustoff in der Wueste.");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Sand und Lehm und sind ziemlich feucht.");
  AddDetail(("boden"),
	    "Der Boden ist eine einzige Mischung aus Dreck, Wasser, Sand, Lehm und "
	    "Faekalien. Einfach nur ekelhaft!");
  AddDetail(("mischung"),
	    "Eine ausgesprochen ekelhafte Mischung.");
  AddDetail(("faekalien"),
	    "Die willst Du lieber nicht naeher untersuchen.");
  AddDetail(({"wasser", "bruehe"}),
	    "Wasser ist ja in der Wueste nicht gerade haeufig, obwohl Du die braune "
	    "Bruehe unter Dir nur ungern Wasser nennen wuerdest.");
  AddDetail(("dreck"),
	    "Oha, in dem Dreck scheint ja etwas zu sein. Ob man den Dreck wohl "
	    "durchsuchen sollte?");
  AddDetail(("wunder"),
	    "Wunder geschehen immer wieder. Dummerweise meist nie dann "
	    "wenn man sie echt brauchen koennte.");
  AddSmell(({DEFAULT_SMELL, "geruch"}),
	   "Es stinkt hier erbaermlich. Kein Wunder, "
	   "Du befindest Dich ja auch in einer Kanalisation.");
  AddSound(DEFAULT_SOUND,
	   "Es ist ueberraschend still hier. Nicht einmal Ratten sind hier "
	   "zu hoeren. Irgendwie seltsam.");
  AddDetail(("ratten"),
	    "Keine zu sehen.");
  AddSound(("ratten"),
	   "Ratten kannst Du hier keine hoeren, eigentlich ziemlich seltsam.");
 
  AddExit(({"norden"}), ROOM "kanal1_2_2");
  
  AddCmd(({"durchsuche", "durchsuch", "such", "suche","wuehl","wuehle",
	     "durchwuehl","durchwuehle"}), "durchsuche_was");
}  

nosave int durchsuche_was(string str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if(!str) return 0;

  if(str == "dreck" || str == "in dreck")
    {
      if(!gegenstandda)
	{
	  say(BS(TPN+" wuehlt etwas im Dreck herum."));

	  write(BS("Du findest leider nur einige Lederreste "
		   "die voellig unbrauchbar sind."));

	  return 1; 
	}
	
      switch(random(4))
	{
	case 1:
	  
	  say(BS(TPN+" wuehlt etwas im Dreck und scheint sogar etwas "
		 "darin gefunden zu haben."));

	  write(BS("Du suchst in dem Dreck herum und findest einen "
		   "Lederhelm, der aus dem Dreck herauskullert."));

	  CLONEME("/p/armour/helm/lederhelm");

	  gegenstandda=0;

	  return 1;
	  
	case 2:
	  
	  say(BS(TPN+" wuehlt etwas im Dreck und scheint sogar etwas "
		 "darin gefunden zu haben."));

	  write(BS("Du suchst in dem Dreck herum und findest ein "
		   "Amulett, welches aus dem Dreck herausfaellt."));

	  CLONEME("/p/armour/amulet/amulett");
	  
	  gegenstandda=0;
	  
	  return 1;
	  
	case 3:

	  say(BS(TPN+" wuehlt etwas im Dreck und scheint sogar etwas "
		 "darin gefunden zu haben."));

	  write(BS("Du suchts in dem Dreck herum und findest einen "
		   "Ring, der aus dem Dreck herauskullert."));

	  CLONEME("/p/armour/ring/ring");
	  
	  gegenstandda=0;
	  
	  return 1;
	  
	default:
	  
	  say(BS(TPN+" wuehlt etwas im Dreck herum."));
	  
	  write(BS("Du findest leider nur einige Lederreste "
		   "die voellig unbrauchbar sind."));
	  
	  return 1; 
	}
    }
  
  return 0;
}


void reset()
{
  ::reset();

  gegenstandda=1;
}
