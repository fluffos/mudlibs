#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation");
  SetProp(P_INT_LONG,
	   "In diesem Teil der Kanalisation befindet sich eine Holztreppe "
	   "die nach unten fuehrt. Ansonsten ist es hier aehnlich wie im "
	   "Rest der Kanalisation. Ein Gang fuehrt ausserdem zurueck nach "
	   "Westen.\n");

  AddDetail(("teil"),
	    "In diesem Teil der Kanalisation fuehrt eine Holztreppe nach "
	    "unten.");
  AddDetail(("gang"),
	    "Der Gang fuehrt zurueck nach Westen.");
  AddDetail(("wasser"),
	    "Das Wasser hier ist eine voellig braune Suppe und riecht "
	    "unglaublich uebel. Aber immerhin ist es erstaunlich, dass es "
	    "in dieser Wueste ueberhaupt Wasser gibt.");
  AddDetail(("wueste"),
	    "Arrakeen befindet sich ja in der Wueste.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation unterhalb von "
	    "Arrakeen.");
  AddDetail(("arrakeen"),
	    "Arrakeen befindet sich ueber Dir.");
  AddDetail(("rest"),
	    "Der Rest der Kanalisation ist mindestens genauso ekelhaft wie "
	    "hier.");
  AddDetail(("decke"), 
	    "Die Decke besteht aus Sand und Lehm, teilweise ist sie feucht "
	    "und einzelne Wassertropfen fallen von ihr herunter.");
  AddDetail(({"wassertropfen", "tropfen"}),
	    "Die Wassertropfen platschen geraeuschvoll von der Decke herab.\n");
  AddDetail(({"waende", "wand"}),
	    "Die Wand besteht aus Sand und Lehm und ist zudem etwas feucht.");
  AddDetail(({"boden"}),
	    "Der Boden besteht hauptsaechlich aus Schlamm, der sich aus Lehm, "
	    "Wasser, Sand und einigen Dingen zusammensetzt, von denen Du "
	    "lieber nicht wissen moechtest was es einmal war.");
  AddDetail(({"sand"}),
	    "Ganz gewoehnlicher Sand.");
  AddDetail(({"lehm"}),
	    "Fast alles hier besteht aus getrocknetem Lehm. Nur da es leider "
	    "auch ziemlich feucht ist, hat sich das alles mit Sand und Dreck "
	    "zu einem ekelhaftem Schlamm vermischt.");
  AddDetail(({"dinge", "dingen"}),
	    "Von den Dingen moechtest Du lieber gar nicht wissen was sie "
	    "einmal waren. Schon willst Du Dich angeekelt abwenden, als Dir "
	    "da ein Schimmern auffaellt.");
  AddDetail(("schimmern"),
	    "Da steckt eine Metallplatte in dem Schlamm und Dreck.");
  AddDetail(({"metallplatte", "platte"}),
	    "Auf der Metallplatte ist das Bild einer Gestalt zu sehen die "
	    "eine Maske traegt und eine Treppe hinabsteigt. Was dies wohl "
	    "zu bedeuten hat?");
  AddDetail(({"gestalt", "maske", "bild"}),
	    "Die Gestalt auf der Metallplatte traegt eine Maske und steigt "
	    "eine Treppe hinab.");
  AddDetail(({"treppe", "holztreppe"}), 
	    "Die Holztreppe fuehrt nach unten.");
  AddDetail(({"holz"}),
	    "Das Holz der Treppe scheint ausgesprochen alt zu sein. Trotz "
	    "allem wirkt es aber noch sehr stabil.");
  AddDetail(({"dreck", "suppe", "schlamm"}), 
	    "Igitt, diese Suppe aus Dreck, Sand und Schlamm ist echt "
	    "ekelerregend."); 
  AddDetail(({"lufthauch", "hauch", "spur"}),
	    "Der Lufthauch scheint von unten die Treppe hoch zu kommen und "
	    "macht den Gestank hier eine Spur ertraeglicher.");
  AddSmell(({DEFAULT_SMELL, "gestank"}),
	   "Es stinkt hier ziemlich schlimm. Aber ein leichter "
	   "Lufthauch von der Treppe macht das Ganze eine Spur "
	   "ertraeglicher.");
  AddSmell(({"lufthauch", "hauch", "ganze"}),
	   "Durch den Lufthauch ist der Gestank hier um ein wenig "
	   "ertraeglicher.");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst das Geraeusch wenn einzelne Wassertropfen in der "
	   "braunen Suppe unter Dir auftreffen."); 
  AddSound(({"wassertropfen", "tropfen", "geraeusch"}),
	   "*tropf* *tropf* *tropf*");

  AddExit(({"westen"}), ROOM "kanal1_3_4");

  AddExit(({"runter"}), ([EX_DEST:ROOM "aufstieg", 
			  EX_TESTFUNC:"exit_unten"]));
}  

int exit_unten(string dir)
{
  object ob;
  
  // Masken-Check
  if(objectp(ob=present("\narrakeenkanalmaske", TP)) && (ob->QueryWorn()==TP))
    return 1;
  
  write("__        ___   _ __  __ __  __ _\n" 
	"\\ \\      / / | | |  \\/  |  \\/  | |\n"
	" \\ \\ /\\ / /| | | | |\\/| | |\\/| | |\n"
	"  \\ \V  V / | |_| | |  | | |  | |_|\n"
	"   \\_/\\_/   \\___/|_|  |_|_|  |_(_)\n"+
	BS("Als Du die Treppe hinabsteigen willst, wirft Dich ein "
	   "unglaublich starker Windstoss gegen die Wand. AUTSCH!!!"));
  
  say(BS("Als "+TP->name(WER,0)+" die Treppe hinabsteigen will, wird "+
	 TP->QueryPronoun()+" von einem unglaublich starken Windstoss "
	 "gegen die Wand geschleudert."));

  SetProp(P_KILL_NAME, "Ein unglaublich starker Windstoss");      
  
  TP->do_damage(30+random(6));
  
  return 0;
}

