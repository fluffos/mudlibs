#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "In der Kanalisation");
  SetProp(P_INT_LONG,
	   "Du befindest dich hier an einer Kreuzung in der Kanalisation. "
	   "Es geht in drei Richtungen weiter, nach Norden, nach Sueden und "
	   "nach Suedosten. Die Nebelschwaden die im Norden so intensiv waren "
	   "sind hier schon fast wieder verschwunden.\n");

  AddDetail(({"schwaden", "nebel", "nebelschwaden"}),
	    "Die Nebelschwaden sind hier schon fast nicht mehr vorhanden.");
  AddDetail(({"boden"}),
	    "Der Boden ist hier zwar uneben, aber man kann ohne "
	    "Probleme darauf gehen, stehen und was auch sonst noch.");
  AddDetail(({"probleme","problem"}), "Hmmm, es gibt keine Probleme.");
  AddDetail(({"himmel","decke"}),
	    "Ueber Dir ist die sagenumwobene Stadt Arrakeen, Du siehst Sand, "
	    "der zeitweise von der Decke rieselt. Du solltest nicht zu lange "
	    "nach oben sehen, Sand im Auge ist ziemlich unangenehm.");
  AddDetail(({"feuchtigkeit", "haeufigste"}),
	    "Feuchtigkeit in der Wueste is auch nicht unbedingt das Haeufigste.");
  AddDetail(("wueste"),
	    "Du kennst die Wueste ja sicher schon. Viel Sand und so.");
  AddDetail(({"stadt","arrakeen"}),
	    "Du siehst die Stadt nicht. Du stehst darunter !");
  AddDetail(({"augen","nase","auge"}),
	    "Du bist zwar toll, aber das schaffst Du dann "
	    "doch nicht.");
  AddDetail(({"wand","waende"}),
	    "Eigentlich kann man das nicht als Wand bezeichnen. Das, was Du "
	    "hier siehst, sind Unmengen von Sand, gestapelt, und durch "
	    "Feuchtigkeit zusammengehalten.");
  AddDetail(({"kreuzung"}),"Hier treffen drei Wege aufeinander.");
  AddDetail(({"weg","wege","wegesystem"}),
	    "Wege sind typische Verbindungen zwischen zwei "
	    "Punkten.");
  AddDetail(({"punkt","punkte","punkten","kreis","gerade"}),
	    "| , - , /  verschiedene Geraden\n"
	    "o          ein Kreis\n"
	    ".          ein Punkt\n");
  AddDetail(({"verbindung","verbindungen"}),
	    "Die Kanalisation unter Arrakeen erstreckt sich durch ein "
	    "ausgefeiltes Wegesystem ueber ein grosses Gebiet.");
  AddDetail(({"gebiet"}),
	    "Du kannst kein ganzes Gebiet auf einmal "
	    "untersuchen. Das solltest du schon wissen, wenn Du bis hierher "
	    "gekommen bist.");
  AddDetail(({"sand", "unmengen"}),
	    "Sand links, Sand rechts, Sand oben, Sand unten... "
	    "reicht das ???");  
  AddDetail(({"ausgang"}),"Es gibt drei, Norden, Sueden und Suedosten.");
  AddDetail(({"norden","nordosten","suedosten"}),"Drei Himmelsrichtungen.");
  AddDetail(({"himmelsrichtung","himmelsrichtungen"}),
	    "Es gibt 8 : Norden, Osten, Sueden, Westen, Nordosten, Suedosten, "
	    "Suedwesten, Nordwesten.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddSmell(DEFAULT_SMELL,
	   "Es riecht hier ziemlich unertraeglich. Aber was will man in "
	   "einer Kanalisation erwarten?");
  AddSmell(({"kanalisation"}),
	   "Es stinkt... was hast Du erwartet ? Vanilleduft ?");
  AddSmell(({"vanilleduft"}),
	   "Das ist nicht Vanille. Das ist etwas Anderes, "
	   "und Du wirst es nicht moegen!");
  AddSmell(({"anderes", "stoffwechselprodukte"}),
	   "Es sind menschliche Stoffwechselprodukte. Du erkennst unter "
	   "anderem die Reste eines Kamel-Kebabs.");
  AddDetail(({"kebab","kamel-kebab", "reste", "mutation"}),
	    "Also vor seiner Mutation hat es bestimmt "
	    "besser gerochen.");
  AddSmell(({"kebab","kamel-kebab", "reste", "mutation"}),
	    "Also vor seiner Mutation hat es bestimmt "
	    "besser gerochen.");
  AddSound(DEFAULT_SOUND,
	   "Man hoert hier nicht viel, aber Du kannst eindeutig festzustellen,"
	   " dass ueber Dir eine grosse Stadt sein muss..");
  AddSound(({"stadt"}),
	   "Du hoerst eigentlich nichts genaues, aber es handelt sich "
	   "bestimmt um das eilige Gewusel der Haendler und "
	   "Wuestenbewohner.");
  AddSound(({"gewusel","laute"}),
	   "Du hoerst immer wieder Laute, die klingen, als ob ueber Dir "
	   "jemand tanzen wuerde.");
  AddSound(({"haendler","wuestenbewohner"}),
	   "Du bist zu tief um Einzelheiten erlauschen zu koennen.");
  AddDetail(({"einzelheiten"}),"Da muesstest Du schon naeher heran gehen.");

  AddExit(({"norden"}), ROOM "kanal1_2_3");
  AddExit(({"suedosten"}), ROOM "kanal1_3_1");
  AddExit(({"sueden"}), ROOM "kanal1_2_1");
  
  AddItem(({ NPC"wuestenspinne.lpc", NPC"narugzombie.lpc", NPC"narugskelett.lpc", 
	       NPC"narugmumie.lpc" }), REFRESH_DESTRUCT, 
	  ([P_MNPC_DEFAULTROOM:file_name()]));
}  










