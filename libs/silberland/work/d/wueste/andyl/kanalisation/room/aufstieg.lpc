#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum unterhalb der Kanalisation");
  SetProp(P_INT_LONG,
	   "Du befindest Dich jetzt in einem Raum unterhalb der Kanalisation "
	   "von Arrakeen. Es stinkt hier zum Glueck nicht mehr ganz so "
	   "erbaermlich und auch ist es hier wieder verhaeltnismaessig trocken. "
	   "Ein Treppe fuehrt zurueck nach oben. Am Fuss der Treppe steht eine "
	   "Steinskulptur. Ein Gang fuehrt weiter nach Nordwesten.\n");
  
  AddDetail(("glueck"),
	    "Ein wahres Glueck, dass es hier nicht so erbaermlich stinkt wie "
	    "in der Kanalisation.");
  AddDetail(("raum"),
	    "Dieser Raum befindet sich unter der Kanalisation von Arrakeen.");
  AddDetail(("gang"),
	    "Was sich wohl hinter diesem Gang befindet?");
  AddDetail(("boden"),
	    "Der Boden besteht aus Sand und getrocknetem Lehm aber es sind "
	    "auch vereinzelt Steinplatten zu sehen. Zum Glueck ist es hier "
	    "nicht so schlammig wie in der Kanalisation.");
  AddDetail(({"steinplatten", "platten"}),
	    "Die Steinplatten sehen nicht so aus als waeren sie natuerlichen Ursprungs. "
	    "Die hat sicher irgendwer vorher behauen und hier hergeschafft. Aber wer?");
  AddDetail(({"ursprung"}),
	    "Natuerlichen Ursprungs sind diese Steinplatten sicher nicht.");
  AddDetail(({"wand", "waende"}),
	    "Die Waende hier bestehen aus getrocknetem Lehm.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("sand"),
	    "Ganz gewoehnlicher Sand.");
  AddDetail(("lehm"),
	    "Zum Glueck ist der Lehm hier trocken, sonst waere es genauso schlammig "
	    "wie in der Kanalisation.");
  AddDetail(({"treppe", "holztreppe"}),
	    "Ein alte Holztreppe fuehrt zurueck nach oben in die Kanalisation. Am "
	    "Fuss der Treppe steht eine Dich faszinierende Steinskulptur.");
  AddDetail(({"fuss"}),
	    "Am Fuss der Treppe steht eine Steinskulptur.");
  AddDetail(({"stein"}),
	    "Der Stein der Skulptur wirkt marmorartig, ist er aber nicht.");
  AddDetail(({"skulptur", "steinskulptur", "gesicht"}),
	    "Die Steinskulptur stellt das Gesicht eines Dir unbekannten Wesens dar. "
	    "Die Augen sind weit offen und starren auf das obere Ende der Treppe. "
	    "Der Mund ist weit geoeffnet und Dir kommt es vor, als wuerde ein leichter "
	    "Windhauch aus ihm kommen.");
  AddDetail(({"augen","treppe", "ende"}),
	    "Die Augen des Gesichtes sind wachsam auf das obere Ende der "
	    "Treppe gerichtet.");
  AddDetail(({"wind", "windhauch", "ausmasse", "mund"}),
	    "Aus dem Mund der Skulptur spuerst Du einen leichten Windhauch. "
	    "Irgendetwas sagt Dir jedoch, dass dieser Wind orkanartige Ausmasse "
	    "annehmen kann.");
  AddDetail(({"wesen", "art"}),
	    "So ein Wesen hast Du noch nie gesehen, moeglicherweise eine Art "
	    "von humanoiden Echsenwesen.");
  AddDetail(({"echsenwesen"}),
	    "Ein humanoides Echsenwesen, so wuerdest Du es zumindest beschreiben.");
  AddDetail(({"holz"}),
	    "Das Holz der Treppe muss alt sein, sehr alt. Dennoch ist es in "
	    "ausgesprochen guten Zustand.");
  AddDetail(({"kanalisation", "arrakeen"}),
	    "Du befindest Dich hier unterhalb der Kanalisation von Arrakeen.");
  AddSmell(DEFAULT_SMELL,"Gut riecht es hier immer noch nicht, aber immerhin "
	   "besser als in der Kanalisation.");
  AddSound(DEFAULT_SOUND,
	   "Es ist ziemlich still hier."); 

  AddExit(({"nordwesten"}), ROOM "barrierenraum");
  AddExit(({"rauf"}), ROOM "abstieg");
}  
