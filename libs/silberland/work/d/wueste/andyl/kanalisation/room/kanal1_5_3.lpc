#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier auf einer Kreuzung in der Kanalisation "
	   "von Arrakeen. Dichte Nebelschwaden durchstreifen den Raum. "
	   "Drei Gaenge fuehren von hier weiter, einer nach "
	   "Norden, der andere nach Sueden und der letzte nach Suedwesten. "
	   "Das ungute Gefuehl, welches Du ueberall in der Kanalisation "
	   "gespuert hast, ist hier bereits ausgesprochen stark.\n");  
  
  AddDetail(("gefuehl"),
	    "Das ungute Gefuehl ist hier bereits ausgesprochen stark.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(({"arrakeen", "stadt", "wuestenstadt"}),
	    "Arrakeen wird die Wuestenstadt ueber Dir genannt.");
  AddDetail(("boden"),
	    "Der Boden ist eine einzige Schlammbruehe aus verschiedensten "
	    "Bestandteilen. Dichte Nebelschwaden ziehen durch den Raum.");
  AddDetail(({"schlamm", "bruehe", "schlammbruehe"}),
	    "Die Schlammbruehe besteht aus verschiedensten unidentifizierbaren "
	    "Bestandteilen.");
  AddDetail(({"bestandteile", "teile"}),
	    "Du willst Du sie gar nicht so genau untersuchen.");
  AddDetail(({"nebel", "nebelschwaden", "schwaden"}),
	    "Die Nebelschwaden ziehen durch den Raum und huellen Dich ein. "
	    "Deine Sicht dadurch stark eingeschraenkt.");
  AddDetail(({"sicht"}),
	    "Deine Sicht ist durch den Nebel stark beeintraechtigt.");
  AddDetail(({"gaenge", "gang", "kreuzung"}),
	    "Drei Gaenge fuehren von hier weiter. Einer nach Norden, "
	    "der andere nach Sueden und der letzte nach Suedwesten.");
  AddDetail(({"raum", "teil"}),
	    "Dieser Raum ist ein Teil der Kanalisation von Arrakeen.");
  AddDetail(({"decke"}),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus getrocknetem Lehm und "
	    "Sand.");
  AddDetail(({"sand", "wuestensand"}),
	    "Gewoehnlicher Wuestensand.");
  AddDetail(("lehm"),
	    "Der Lehm wird in dieser Gegend gerne fuer alles "
	    "moegliche verwendet.");
  AddDetail(({"gegend", "wueste"}),
	    "Du befindest Dich hier in der Wueste. Genauer: darunter.");
  AddSmell(DEFAULT_SMELL,"Es stinkt hier fuerchterlich.");
  AddSound(DEFAULT_SOUND,
	   "Es ist unheimlich still hier."); 

  AddExit(({"norden"}),     ROOM "kanal1_5_4"); 
  AddExit(({"sueden"}),     ROOM "fallenraum"); 
  AddExit(({"suedwesten"}), ROOM "kanal1_4_2");

  AddItem(({ NPC "wuestenspinne", NPC "narugzombie", NPC "narugskelett", 
	       NPC "narugmumie" }), REFRESH_DESTRUCT, 
	  ([P_MNPC_DEFAULTROOM:file_name()]));
}  
