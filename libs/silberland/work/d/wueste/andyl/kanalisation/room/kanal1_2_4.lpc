#include "../def.h"

inherit "std/room";

nosave int gegenstandda=1;

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier in einer Sackgasse in der Kanalisation von Arrakeen. "
	   "Der Gestank ist hier nach wie vor fuerchterlich und auch "
	   "optisch ist es hier nicht sehr ansprechend. Der einzige Ausgang "
	   "ist der Weg nach Osten. An der Westwand siehst Du ein menschliches "
	   "Skelett liegen. Du hast irgendwie ein mulmiges Gefuehl.\n");

  AddDetail(("gefuehl"),
	    "Du hast ein mulmiges Gefuehl, als ob Dich jemand beobachten wuerde.");
  AddDetail(({"gasse", "sackgasse"}),
	    "Du stehst hier in einer Sackgasse in der Kanalisation von Arrakeen. "
	    "Der einzige Weg nach draussen ist im Osten.");
  AddDetail(("kanalisation"),
	    "Es stinkt, es ist dunkel, und undefinierbare Dinge sind am Boden zu "
	    "sehen. Ja, Du bist eindeutig in einer Kanalisation.");
  AddDetail(({"arrakeen"}),
	    "Die Wuestenstadt ueber Dir wird so genannt.");
  AddDetail(({"stadt", "wuestenstadt"}),
	    "Eine Stadt die in der Wueste liegt ist eine ...?");
  AddDetail(("wueste"),
	    "Du befindest Dich hier im Untergrund der Wueste.");
  AddDetail(("untergrund"),
	    "Da Du im Untergrund bist, kannst Du auch die Sonne nicht sehen.");
  AddDetail(("sonne"),
	    "Selbst mit Deinen guten Augen kannst Du die Sonne hier nirgends "
	    "erspaehen.");
  AddDetail(("augen"),
	    "Zumindest glaubst Du, dass Du gute Augen hast.");
  AddDetail(({"boden"}),
	    "Der Boden besteht aus Sand, Dreck, Wasser und einigen undefinierbaren "
	    "Dingen.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("sand"),
	    "Toll, genau sowas koenntest Du fuer Deine Sanduhr gebrauchen.");
  AddDetail(({"sanduhr", "uhr"}),
	    "Mist, natuerlich hast Du die gerade jetzt nicht dabei.");
  AddDetail(("dreck"),
	    "Sehr viel Dreck.");
  AddDetail(({"wasser"}),
	    "Es benoetigt viel Vorstellungskraft um die braune Suppe unter Dir "
	    "Wasser nennen zu koennen.");
  AddDetail(({"vorstellungskraft"}),
	    "Aber genug Vorstellungskraft hast Du ja zum Glueck.");
  AddDetail(("glueck"),
	    "Glueck kann man immer brauchen.");
  AddDetail(({"suppe", "braune suppe"}),
	    "Die braune Suppe ist einfach nur ekelhaft.");
  AddDetail(("dinge"),
	    "Diese Dinge sollen, wenn es nach Dir geht, auch undefinierbar bleiben.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus Lehm und Sand. An der Westwand und der Suedwand "
	    "faellt Dir etwas auf.");
  AddDetail(("lehm"),
	    "Getrockneter Lehm.");
  AddDetail(({"ausgang", "weg"}),
	    "Der einzige Ausgang ist der Weg nach Osten.");
  AddDetail(({"westwand", "fuss"}),
	    "Am Fuss der Westwand liegt ein menschliches Skelett.");
  AddDetail(("suedwand"),
	    "In der Suedwand ist ein Spalte.");
  AddDetail(("spalte"),
	    "Sehen kann man darin nichts, aber vielleicht kann man "
	    "ja reingreifen?");
  AddDetail(("skelett"),
	    "Das Skelett traegt das Zeichen der Bruderschaft von Narug. "
	    "Die Finger des Skelettes sind seltsam verdreht.");
  AddDetail(({"narug", "bruderschaft", "art", "geheimorganisation"}),
	    "Die Bruderschaft von Narug duerfte ein Art von Geheimorganisation "
	    "gewesen sein.");
  AddDetail(({"zeichen"}),
	    "Das menschliche Skelett traegt das Zeichen der Bruderschaft von Narug.");
  AddDetail(("finger"),
	    "Sie zeigen auf die Nordwand.");
  AddDetail(("nordwand"),
	    "Da sind Schriftzeichen in roter Farbe niedergeschrieben worden.");
  AddDetail(({"farbe", "blut"}),
	    "Bei der roten Farbe duerfte es sich um getrocknetes Blut handeln.");
  AddDetail(({"schriftzeichen", "zeichen", "nachricht"}),
	    "Du kannst sie lesen.");
  AddReadDetail(({"schriftzeichen", "zeichen", "nachricht"}),
	"Da steht:\n\n"
	"Ich liege im Sterben, aber ich muss diese Nachricht noch "
	"unbedingt weitergeben. Heute morgen haben wir, die Bruderschaft "
	"von Narug, beschlossen das Uebel in dieser Kanalisation zu "
	"vernichten. Doch der Plan schlug fehl, alle meine Brueder wurden "
	"getoetet und selbst nach ihrem Tod zu Sklaven gemacht. Ich konnte "
	"fliehen, trug aber toedliche Wunden davon. Wer immer auch diese "
	"Kanalisation betritt: Huetet euch vor der Heimtuecke des B..\n\n"
	"Hier endet die Nachricht.");
  AddSmell(({DEFAULT_SMELL, "gestank"}),
	   "Es riecht hier einfach fuerchterlich.");
  AddSound(DEFAULT_SOUND,
	   "Es ist voellig still hier."); 

  AddExit(({"osten"}), ROOM "kanal1_3_4"); 

  AddCmd(({"greif", "greife"}), "greif_was");
}  

nosave int greif_was(string str)
{
  notify_fail("In was willst Du greifen?\n");
  if(!str) return 0;

  if(str == "spalte" || str == "in spalte" || str == "in spalte hinein" ||
     str == "spalt" || str == "in spalt" || str == "in spalt hinein")
    {
      if(!gegenstandda)
	{
	  say(BS(TPN+" greift in eine Spalte in der Suedwand."));
	  
	  write(BS("Du greifst in die Spalte findest aber leider nichts "
		   "ausser Dreck."));

	  return 1;
	}

      say(BS(TPN+" greift in die Spalte in der Suedwand und findet dort "
	     "einen Schild."));

      write(BS("Du greifst in die Spalte, da faellt ploetzlich ein Schild "
	       "heraus."));
      
      gegenstandda=0;  

      switch(random(3))
	{
	case 2:
	  
	  CLONEME("/p/armour/shield/kupferschild");

	  break;

	case 1:
	  
	  CLONEME("/p/armour/shield/bronzeschild");
	  
	  break;

	default:

	  CLONEME("/p/armour/shield/eisenschild");

	  break;
	}
	 
      return 1;
    }

  return 0;
}

void reset()
{
  ::reset();

  gegenstandda=1;
}
