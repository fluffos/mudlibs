#include "../def.h"

inherit "std/room";

nosave mixed parray;
nosave int barriere=1;
nosave int sand=1;

void create()
{
  ::create();

  parray=allocate(3);
  parray[0] = allocate(3);
  parray[1] = allocate(3);
  parray[2] = allocate(3);
  
  parray[0][0]=5;
  parray[1][0]=8;
  parray[2][0]=3;
  parray[0][1]=2;
  parray[1][1]=9;
  parray[2][1]=4;
  parray[0][2]=6;
  parray[1][2]=0;
  parray[2][2]=7;

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum unterhalb der Kanalisation");
  SetProp(P_INT_LONG,
	  BS("Du stehst in einem Raum unterhalb der Kanalisation von "
	     "Arrakeen. Im Gegensatz zu den Raeumen der Kanalisation sind "
	     "die Waende hier aus soliden Steinquadern gemacht und auch "
	     "der Geruch ist hier einigermassen ertraeglich. Ein Durchgang "
	     "fuehrt weiter nach Nordosten und im Suedosten kommst Du zurueck "
	     "zu der Treppe die Du hinabgestiegen bist.")+
	  "@@barriereda@@");

  AddDetail(("arrakeen"),
	    "Die Kanalisation von Arrakeen befindet sich ueber Dir.");
  AddDetail(("raeume"),
	    "In die Raeume der Kanalisation moechtest Du eigentlich nicht mehr.");
  AddDetail(({"gegensatz", "vergleich"}),
	    "Dieser Raum bietet einen krassen Gegensatz im Vergleich zu denen "
	    "in der Kanalisation.");
  AddDetail(("raum"),
	    "Dieser Raum unterscheidet sich grundlegend von denen der Kanalisation. "
	    "Sowohl die Decke, als auch der Boden und die Waende bestehen aus "
	    "grossen Steinquadern. Zudem stinkt es hier bei weitem nicht so.");
  AddDetail(("treppe"),
	    "Ueber die Treppe bist Du hier herunter gekommen.");
  AddDetail(({"hand", "haende"}),
	    "Du hast auesserst geschickte Haende, aber das hast Du "
	    "ja schon immer gewusst.");
  AddDetail(({"steinquader", "quader", "dimension", "dimensionen"}),
	    "Die Steinquader haben beeindruckende Dimensionen. Es war sicher "
	    "eine Menge Arbeit die hier herunter zu schaffen.");
  AddDetail(("arbeit"),
	    "Diese Arbeit wuerdest Du Dir sicher nicht antun.");
  AddDetail(("menge"),
	    "Ja, das war sicher eine riesige Menge an Arbeit.");
  AddDetail(("decke"),
	    "Die Decke besteht, wie auch der Boden, aus "
	    "grossen soliden Steinquadern.");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus grossen soliden Steinquadern. An der "
	    "Westwand faellt Dir etwas auf.");
  AddDetail(("westwand"),
	    "An der Westwand entdeckst Du einige Steinplatten die man "
	    "offenbar verschieben kann.");
  AddDetail(("kanalisation"),
	    "Die eigentliche Kanalisation befindet sich ueber Dir.");
  AddDetail(("stein"),
	    "Harter grauer Stein.");

  AddSpecialDetail(({"boden", "steinboden"}), "boden_schau");
  AddSpecialDetail(({"platten", "steinplatten"}), "platten_schau");
  AddSpecialDetail(("energie"), "energie_schau");
  AddSpecialDetail(("barriere"), "barriere_schau");
  AddSpecialDetail(({"sand", "sandschicht"}), "sand_schau");
  AddSpecialDetail(("bild"), "bild_schau");
  AddSpecialDetail(("durchgang"), "durchgang_schau");
  
  AddSmell(({DEFAULT_SMELL, "geruch"}),
	   "Es riecht hier nicht mehr so schlimm wie in der Kanalisation.");
  AddSound(DEFAULT_SOUND, "Es ist ziemlich still hier."); 
  
  AddCmd(({"schieb", "schiebe", "verschieb", "verschiebe"}), "verschiebe_was");
  AddCmd(({"wische", "wisch"}), "wische_was");

  AddExit(({"nordosten"}), ([EX_DEST: ROOM "artefaktraum",
			     EX_TESTFUNC: "barrierenweg"])); 
  AddExit(({"suedosten"}), ROOM "aufstieg");
}  

int barrierenweg(string dir)
{
  if(barriere) 
    { 
      write(BS("Du kommst an der Barriere nicht vorbei.\n"));
      return 0;
    }

  return 1;
}

string durchgang_schau(string str)
{
  if(barriere)
    return BS("Der Durchgang nach Nordosten wird von einer Barriere "
	      "aus reiner Energie blockiert.\n"); 
  
  return BS("Der Durchgang nach Nordosten ist jetzt nicht mehr blockiert.\n");
}

nosave int wische_was(string str)
{
  notify_fail("Was willst Du wegwischen?\n");
  if(!str) return 0;

  if(str == "sand" || str == "sandschicht" || 
     str == "sand weg" || str == "sandschicht weg")
    if(sand)
      {
	write(BS("Mit Deinen Haenden wischt Du die Sandschicht "
		 "weg und entdeckst unter ihr ein Bild im Boden.\n"));
	sand=0;

	return 1;
      }
    else
      {
	write(BS("Hier wurde schon genug Sand weggewischt.\n"));
	
	return 1;
      }
  
  return 0;
}

string sand_schau()
{
  if(sand)
    return BS("Eine dicke Sandschicht bedeckt den Boden. Da scheint etwas "
	      "unter ihr zu sein. Ob man die Sandschicht wegwischen koennte?\n");
  
  return BS("Der Sand wurde grossteils vom Boden weggewischt.\n");
}

string boden_schau()
{
  if(sand)
    return BS("Der Steinboden besteht genau wie die Waende aus grossen "
	      "Steinquadern. Eine dicke Sandschicht bedeckt den Boden.\n");
  
  return BS("Der Steinboden besteht genau wie die Waende aus grossen "
	    "Steinquadern. Ein Bild ist auf dem Boden zu erkennen.\n");
}

string bild_schau()
{
  if(sand)
    return BS("Sowas siehst Du da nicht!");

  return "+-------------+\n"
    "| \\    |    \/ |\n"
    "|             |\n"
    "|>>>  '*'  <<<|\n"
    "|             |\n" 
    "|o|0  >|<  0|o|\n"
    "+-------------+\n";
}

string barriereda()
{
  if(!barriere) 
    return ""; 
  
  return "Eine blau schimmernde Barriere aus reiner Energie "
    "versperrt den Durchgang nach Nordosten.";
}

string barriere_schau()
{
  if(!barriere) 
    return BS("Es ist nichts mehr von einer Barriere zu erkennen."); 
  
  return BS("Eine blau schimmernde Barriere aus reiner Energie "
	    "versperrt den Durchgang nach Nordosten.");
}

string energie_schau()
{
  if(!barriere) 
    return BS("Es scheint keine Energie mehr vorhanden zu sein.\n"); 
  
  return("Eine blau schimmernde Barriere aus reiner Energie "
	 "versperrt den Durchgang nach Nordosten.\n");
}

string platten_schau()
{
  int x;
  int y;
  y=0;
  x=0;
  
  while(!(y>=3))
    {
      while(!(x>=3))
	{
	  if(!(parray[x][y]==0))
	    {
	      write("+---+");
	    }
	  else 
	    {
	      write("     ");
	    }
	  
	  if(!(x==2))
	    {
	      write(" ");
	    }
	  else
	    {
	      write("\n");
	    }
	  x++;
	}
      x=0;
      
      while(!(x>=3))
	{
	  switch(parray[x][y])
	    {
	    case 0: write("     "); break;
	    case 2: write("| | |"); break;
	    case 3: write("| \/ |"); break;
	    case 4: write("|>>>|"); break;
	    case 5: write("|'*'|"); break;
	    case 6: write("|<<<|"); break;
	    case 7: write("|o|0|"); break;
	    case 8: write("|>|<|"); break;
	    case 9: write("|0|o|"); break;
	    } 
	  if(!(x==2))
	    {
	      write(" ");
	    }
	  else
	    {
	      write("\n");
	    }
	  x++;
	}
      x=0;
      
      while(!(x>=3))
	{
	  
	  if(!(parray[x][y]==0))
	    {
	      write("+---+");
	    }
	  else 
	    {
	      write("     ");
	    }
	  if(!(x==2))
	    {
	      write(" ");
	    }
	  else
	    {
	      write("\n");
	    }
	  x++;
	}
      x=0;
      y++;
    }
  return("\n");
}

void barrieren_check()
{
  if((parray[0][0]==0) && (parray[1][0]==2) && (parray[2][0]==3) &&
     (parray[0][1]==4) && (parray[1][1]==5) && (parray[2][1]==6) &&
     (parray[0][2]==7) && (parray[1][2]==8) && (parray[2][2]==9))
    {
      barriere=0;
      
      write(BS("Als Du die Platte verschiebst leuchtet die Barriere kurz "
	       "auf und verschwindet dann."));
    }
}

void verschieben()
{
  write(BS("Du verschiebst eine Platte."));

  platten_schau();

  barrieren_check();
}

nosave int verschiebe_was(string str)
{
  int tmp, tmp2;
  notify_fail("Welche Platte willst Du verschieben?\n"
	      "<Syntax: verschiebe platte x>\n"
	      "+-------+\n"
	      "| 1 2 3 |\n"
	      "| 4 5 6 |\n"
	      "| 7 8 9 |\n"
	      "+-------+\n");
  if(!str) return 0;

  switch(str)
    {
    case "platte 1":
      tmp=parray[0][0];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1;}
	}
      else
	{
	  if(parray[1][0] == 0)
	    {
	      parray[1][0]=tmp;
	      parray[0][0]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[0][1] == 0)
	    {
	      parray[0][1]=tmp;
	      parray[0][0]=0;
	      verschieben();
	      return 1;
	    }
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	}
      break;
      
    case "platte 2":  
      tmp=parray[1][0];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1; }
	}
      else
	{
	  if(parray[2][0] == 0)
	    {
	      parray[2][0]=tmp;
	      parray[1][0]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[1][1] == 0)
	    {
	      parray[1][1]=tmp;
	      parray[1][0]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[0][0] == 0)
	    {
	      parray[0][0]=tmp;
	      parray[1][0]=0;
	      verschieben();
	      return 1;
	    }
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	} 
      break;
      
    case "platte 3":
      tmp=parray[2][0];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1; }
	}
      else
	{
	  if(parray[1][0] == 0)
	    {
	      parray[1][0]=tmp;
	      parray[2][0]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[2][1] == 0)
	    {
	      parray[2][1]=tmp;
	      parray[2][0]=0;
	      verschieben();
	      return 1;
	    }
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	}
    
      break;
      
    case "platte 4":
	tmp=parray[0][1];
	if(tmp == 0)
	  {
	    { write(BS("Dort ist keine Platte.")); return 1; }
	  }
	else
	  {
	    if(parray[0][0] == 0)
	    {
	      parray[0][0]=tmp;
	      parray[0][1]=0;
	      verschieben();
	      return 1;
	    }
	    if(parray[1][1] == 0)
	    {
	      parray[1][1]=tmp;
	      parray[0][1]=0;
	      verschieben();
	      return 1;
	    }
	   if(parray[0][2] == 0)
	    {
	      parray[0][2]=tmp;
	      parray[0][1]=0;
	      verschieben();
	      return 1;
	    }
	   write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	  }
	break;
	
    case "platte 5":
      tmp=parray[1][1];
      if(tmp == 0)
	  {
	    { write(BS("Dort ist keine Platte.")); return 1; }
	  }
      else
	{
	  if(parray[1][0] == 0)
	    {
	      parray[1][0]=tmp;
	      parray[1][1]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[2][1] == 0)
	    {
	      parray[2][1]=tmp;
	      parray[1][1]=0;
	      verschieben();
	      return 1;
	    }
	   if(parray[1][2] == 0)
	     {
	       parray[1][2]=tmp;
	       parray[1][1]=0;
	       verschieben();
	       return 1;
	     }
	   if(parray[0][1] == 0)
	     {
	       parray[0][1]=tmp;
	       parray[1][1]=0;
	       verschieben();
	       return 1;
	     }
	   write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	}
      break;
      
    case "platte 6":
      tmp=parray[2][1];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1; }
	}
      else
	{
	  if(parray[2][0] == 0)
	    {
	      parray[2][0]=tmp;
	      parray[2][1]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[1][1] == 0)
	    {
	      parray[1][1]=tmp;
	      parray[2][1]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[2][2] == 0)
	    {
	      parray[2][2]=tmp;
	      parray[2][1]=0;
	      verschieben();
	      return 1;
	    }
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	} 
      break;
      
    case "platte 7":
      tmp=parray[0][2];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1; }
	}
      else
	{
	  if(parray[0][1] == 0)
	    {
	      parray[0][1]=tmp;
	      parray[0][2]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[1][2] == 0)
	    {
	      parray[1][2]=tmp;
	      parray[0][2]=0;
	      verschieben();
	      return 1;
	    }  
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	}
      break;
      
    case "platte 8":
      tmp=parray[1][2];
      if(tmp == 0)
	{
	  { write(BS("Dort ist keine Platte.")); return 1; }
	}
      else
	{
	  if(parray[0][2] == 0)
	    {
	      parray[0][2]=tmp;
	      parray[1][2]=0;
	      verschieben();
	      return 1;
	    }
	  if(parray[1][1] == 0)
	    {
	      parray[1][1]=tmp;
	      parray[1][2]=0;
	      verschieben();
	      return 1;
	    }  
	  if(parray[2][2] == 0)
	    {
	      parray[2][2]=tmp;
	      parray[1][2]=0;
	      verschieben();
	      return 1;
	    }  
	  write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	} 
      break;
      
    case "platte 9":
	tmp=parray[2][2];
	if(tmp == 0)
	  {
	    { write(BS("Dort ist keine Platte.")); return 1; }
	  }
	else
	  {
	    if(parray[1][2] == 0)
	      {
		parray[1][2]=tmp;
		parray[2][2]=0;
		verschieben();
		return 1;
	      }
	    if(parray[2][1] == 0)
	      {
		parray[2][1]=tmp;
		parray[2][2]=0;
		verschieben();
		return 1;
	      }   
	    write(BS("Diese Platte kannst Du nicht verschieben.")); return 1;
	  }
	break;
    default: return 0; 
      break;
    }
  return 0;
}

void reset()
{
  ::reset();

  tell_room(TO,
	    BS("Eine magischer Blitz zuckt durch den Raum und alle "
	       "Platten sind ploetzlich wieder in ihrer Ausgangsposition."));
  
  parray[0][0]=5;
  parray[1][0]=8;
  parray[2][0]=3;
  parray[0][1]=2;
  parray[1][1]=9;
  parray[2][1]=4;
  parray[0][2]=6;
  parray[1][2]=0;
  parray[2][2]=7;

  barriere=1; 
  sand=1;
}

