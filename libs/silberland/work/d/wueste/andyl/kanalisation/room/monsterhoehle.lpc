#include "../def.h"

inherit "std/room";

string default_sound()
{
  if(!present("todesviper") )
     {
       return(BS("Es ist still hier.\n"));
     }
   else return(BS("Du vernimmst ein unangenehmes Zischen."));
}

string hoer_zischen()
{
  if(!present("todesviper") )
    {
      return(BS("Sowas hoerst Du hier nicht.\n"));
    }
  else return(BS("*ziiiisssssccccchhhh*\n"));  
}

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen.");
  SetProp(P_INT_LONG,
	   "Dieser Raum ist voellig mit einem rotbraunen Schlamm "
	   "ueberzogen und es ist ungewoehnlich heiss und feucht "
	   "hier drinnen. Ein Gang fuehrt zurueck nach Suedoben.\n");

  AddDetail(({"gang", "suedoben"}),
	    "Der Gang fuehrt zurueck nach Suedoben.");
  AddDetail(("raum"),
	    "Dieser Raum ist ueber und ueber mit einem "
	    "rotbraunen Schlamm ueberzogen.");
  AddDetail(({"schlamm", "faerbung" }),
	    "Der Schlamm hat eine rotbraune Faerbung und stinkt "
	    "bestialisch.");
  AddDetail(({"boden", "schicht"}),
	    "Der Boden ist ausnahmslos mit einer dicken Schicht des "
	    "rotbraunen Schlamms bedeckt.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende bestehen aus Lehm und Sand und sind grossteils "
	    "mit dem rotbraunen Schlamm bedeckt.");
  AddDetail(("lehm"),
	    "Getrockneter Lehm.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm, aber selbst "
	    "an ihr haftet jede Menge des Schlamms.");
  AddDetail(("menge"),
	    "Eine durchaus beachtliche Menge.");
  AddDetail(("sand"),
	    "Sand ist in der Wueste ja nicht unbedingt selten.");
  AddDetail(("wueste"),
	    "Arrakeen befindet sich in der Wueste.");
  AddDetail(({"arrakeen", "stadt", "wuestenstadt"}),
	    "Arrakeen nennt man die Wuestenstadt ueber Dir.");
  AddSmell(({DEFAULT_SMELL, "geruch"}),
	   "Es riecht so schlimm, dass Dir augenblicklich uebel wird.");
  AddSmell(("schlamm"),
	   "Der Schlamm stinkt bestialisch. Der ist wohl hauptverantwortlich "
	   "fuer den ueblen Geruch hier.");
  AddSound(({ DEFAULT_SOUND }), #'default_sound);
  
  AddSound(("zischen"), #'hoer_zischen);
  
  AddExit(({"suedoben"}), ROOM "kanal1_3_2"); 
  
  // TODESVIPER
  AddItem(NPC "todesviper", REFRESH_DESTRUCT);
}  






