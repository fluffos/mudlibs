#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	  "In diesem Raum der Kanalisation von Arrakeen gabelt sich "
	  "der Weg. Ein Weg fuehrt nach Westen und der andere nach Osten. "
	  "Durch den Gang im Suedosten kannst Du wieder zurueck. Die Luft "
	  "hier riecht ausgesprochen uebel und Du hast einen akuten Anfall "
	  "von Paranoia.\n");
  
  AddDetail(({"kanalisation", "raum"}),
	    "Du befindest Dich hier in einem Raum der "
	    "Kanalisation von Arrakeen.");
  AddDetail(({"weg", "weg", "gang"}),
	    "Zwei Wege fuehren von hier weiter. Einer nach Osten und einer "
	    "nach Westen. Ein Gang fuehrt zurueck nach Suedosten.");
  AddDetail(({"anfall", "paranoia"}),
	    "Dich ueberkommt hier ein akuter Anfall von Paranoia. Du fuehlst "
	    "Dich verfolgt und beobachtet. Liegt wahrscheinlich an der "
	    "schlechten Luft hier oder etwa nicht?");
  AddDetail(("luft"),
	    "Die Luft hier drinnen riecht ausgesprochen uebel. Da muss man "
	    "ja saemtliche Zustaende bekommen.");
  AddDetail(({"zustand", "zustaende", "beispiel"}),
	    "Zustaende wie Paranoia zum Beispiel.");
  AddDetail(("arrakeen"),
	    "Arrakken ist irgendwo ueber Dir.");
  AddDetail(({"boden", "kombination"}),
	     "Der Boden ist ein Kombination aus Lehm, Dreck, Sand und "
	     "diversen Absonderungen.");
  AddDetail(("dreck"),
	    "Tja, hier scheint wohl niemand regelmaessig sauber zu machen.");
  AddDetail(("decke"),
	    "Die Decke besteht aus Lehm.");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Sand und Lehm.");
  AddDetail(("absonderungen"),
	    "So interessant sie auch sein moegen, Deine Eltern haben Dir "
	    "damals schon verboten mit sowas zu spielen.");
  AddDetail(("eltern"),
	    "Das waren sicherlich sehr weise Eltern.");
  AddDetail(("lehm"),
	    "Ganz gewoehnlicher getrockneter Lehm.");
  AddDetail(({"sand", "sandkorn", "sandkoerner"}),
	    "Oh, ein Sandkorn. Und da noch eins. Und hier schon wieder eines. "
	    "Insgesamt muessen es wohl 89349304341 Sandkoerner sein. Das ist "
	    "aber nur eine grobe Schaetzung.");
  AddDetail(("schaetzung"),
	    "Genauer geht es eben nicht.");
  
  AddSmell(DEFAULT_SMELL,"Es stinkt erbaermlich hier drinnen.");
  AddSound(DEFAULT_SOUND,
	   "Es ist voellig still hier."); 
  
  AddCmd (({"spiel", "spiele"}), "spiele_mit");
  
  AddExit(({"westen"}),    ROOM "kanal1_2_4"); 
  AddExit(({"osten"}),     ROOM "abstieg"); 
  AddExit(({"suedosten"}), ROOM "kanal1_4_3"); 
  
  AddItem(({ NPC "wuestenspinne",NPC "narugzombie",NPC "narugskelett",
	       NPC "narugmumie" }), REFRESH_DESTRUCT, 
	  ([P_MNPC_DEFAULTROOM:file_name()]));
}  

nosave int spiele_mit(string str)
{
  notify_fail("Womit willst du spielen?\n");
  if(!str) return 0;
  
  if(str == "absonderungen" || str == "mit absonderungen")
    {
      say(BS(TPN+" spielt mit ekelhaften Absonderungen herum! Ieehhgit!"));
      
      write(BS("Du spielst mit den ekelhaften Absonderungen herum.\n"
	       +"Auf deine Eltern hast du wohl auch nie gehoert, oder?"));
      return 1;
    }
  
  return 0;
}





