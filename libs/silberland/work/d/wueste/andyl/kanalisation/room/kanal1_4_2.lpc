#include "../def.h"

inherit "std/room";

nosave int muenzenda=3+random(3);

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	  "Du stehst hier in einem Gang in der Kanalisation von Arrakeen. "
	  "Nebelschwaden durchziehen den Raum und der Gestank ist schier "
	  "unertraeglich. Du kannst von hier weiter nach Nordosten und "
	  "Suedwesten gehen. Du spuerst deutlich eine Aura des Boesen die "
	  "nicht allzuweit von hier sein kann.\n");  
  

  AddDetail(({"nebelschwaden", "schwaden", "nebel"}),
	    "Die Nebelschwaden wirken ausgesprochen unheimlich und unnatuerlich.");
  AddDetail(("raum"),
	    "Dieser Raum ist ein Gang in der Kanalisation von Arrakeen.");
  AddDetail(("gang"),
	     "Der Gang fuehrt nach Nordosten und Suedwesten.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(("arrakeen"),
	    "Arrakeen sollte theoretisch direkt ueber Dir sein.");
  AddDetail(({"aura", "boese", "boeses"}),
	    "Du spuerst hier foermlich eine Aura das Boesen. Du hast nur "
	    "keine Ahnung wovon sie ausgeht. Du fuehlst dich zudem "
	    "beobachtet.");
  AddDetail(("ahnung"),
	    "Leider hast Du keine.");
  AddDetail(("boden"),
	    "Der Boden ist ein Schlamm aus, Dreck, Sand, Wasser und einigen "
	    "Dingen von denen Du nicht wissen moechtest was sie sind.");
  AddDetail(("schlamm"),
	    "Ein ausgesprochen zaehfluessiger Schlamm.");
  AddDetail(({"wasser", "suppe"}),
	    "Naja, als Wasser kann man die braune Suppe nicht unbedingt bezeichnen.");
  AddDetail(({"dinge", "moeglichkeit"}),
	    "Undefinierbare Dinge und das sollen sie nach Moeglichkeit auch bleiben.");
  AddDetail(({"dreck", "menge"}),
	    "Jede Menge Dreck ist hier vorhanden.");
  AddDetail(("sand"),
	    "Sand scheint in dieser Gegend ja genuegend vorhanden zu sein.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(("lehm"),
	    "Getrockneter Lehm kann fuer so einiges verwendet werden.");
  AddDetail(({"gegend", "wueste"}),
	    "Du befindest Dich hier in der Wueste, oder besser gesagt: darunter.");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Sand und getrocknetem Lehm. An der "
	    "Suedwand faellt Dir etwas auf.");
  AddDetail(("suedwand"),
	    "Da ist ein kleines Metallgitter in die Suedwand eingelassen "
	    "worden.");
  AddDetail(({"gitter", "metallgitter"}),
	    "Durch das Gitter fliesst das braeunliche Wasser ab in die Tiefe. "
	    "Ein Funkeln faellt Dir hinter dem Gitter auf.");
  AddDetail(("tiefe"),
	    "Du kannst leider nicht sagen wie weit es da noch hinab geht.");
  AddDetail(("funkeln"),
	    "Das Funkeln ist definitiv hinter dem Gitter, aber um es zu erreichen "
	    "wirst Du wohl durch das Gitter greifen muessen.");
  
  AddSmell(({DEFAULT_SMELL, "gestank"}),
	   "Einfach widerlich dieser Gestank hier!");
  AddSound(DEFAULT_SOUND,
	   "Es ist ziemlich still hier."); 

  AddExit(({"nordosten"}),  ROOM "kanal1_5_3"); 
  AddExit(({"suedwesten"}), ROOM "kanal1_3_1");

  AddCmd(({"greife", "greif"}), "greif_was");
}

nosave int greif_was(string str)
{
  notify_fail("Durch was willst Du greifen?\n");
  if(!str) return 0;

  if(str == "durch gitter" || str == "durch metallgitter" ||
     str == "durchs gitter" || str == "durchs metallgitter" ||
     str == "durch das gitter" || str == "durch das metallgitter")
    if(muenzenda > 0)
      {
	write(BS("Du greifst durch das Gitter, und ergreifst ein paar "
		 "Muenzen."));

	say(BS(TPN+" greift durch das Metallgitter im Sueden, und steckt "
	       "daraufhin ein paar Muenzen ein."));
	
	TP->AddMoney(51+random(50));
	
	muenzenda--;
	
	return 1;
      }
    else
      {
	write(BS("Du greifst durch das Gitter und greifst in einen grausigen "
		 "Batzen Dreck und Schlamm."));

	say(BS(TPN+" greift durch das Metallgitter im Sueden, findet aber "
	       "nichts."));

	return 1;
      }
  
  return 0;
}

void reset()
{
  ::reset();

  muenzenda=3+random(3);
}
