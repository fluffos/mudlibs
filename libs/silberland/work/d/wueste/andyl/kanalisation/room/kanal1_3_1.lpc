#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "In der Kanalisation unter Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier an einer weiteren Kreuzung in der Kanalisation "
	   "unter Arrakeen. Gaenge fuehren von hier nach Norden, Nordosten, "
	   "Osten und Nordwesten. Es riecht fuerchterlich hier und Du hast "
	   "ein sehr ungutes Gefuehl.\n");  
  
  AddDetail(({"gaenge", "gang", "kreuzung"}),
	    "An dieser Kreuzung fuehren Gaenge von hier weiter nach Norden, "
	    "Nordosten, Osten und Nordwesten.");
  AddDetail(({"arrakeen", "stadt"}),
	    "Arrakeen wird die Stadt ueber Dir genannt.");
  AddDetail(({"kanalisation"}),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(({"boden", "mixtur"}),
	    "Der Boden ist eine Mixtur aus Dreck, Sand und Wasser. Einfach "
	    "nur ekelhaft!");
  AddDetail(("wueste"),
	    "Du befindest Dich hier in der Wueste oder besser gesagt: darunter.");
  AddDetail(("gefuehl"),
	    "Du hast das ungute Gefuehl, dass Du beobachtet wirst. Nur "
	    "Du hast keine Ahnung von wem oder was, da Du niemanden siehst.");
  AddDetail(("ahnung"),
	    "Du hast nicht die geringste.");
  AddDetail(({"wand","waende", "grossteil"}),
	    "Die Waende hier bestehen zum Grossteil aus Sand und getrocknetem "
	    "Lehm. Die Waende sind zudem etwas feucht.");
  AddDetail(({"decke"}),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(({"lehm", "baustoff"}),
	    "Lehm ist hier als Baustoff offenbar sehr beliebt.");
  AddDetail(("sand"),
	    "Sand kommt in der Wueste angeblich recht haeufig vor.");
  AddDetail(("wasser"),
	    "Das Wasser hier ist ausgesprochen unrein. Aber Wasser ist "
	    "ohnehin ziemlich selten in der Wueste.");
  AddDetail(("dreck"),
	    "Wirklich schmutzig dieser Dreck hier und der Geruch betaeubt "
	    "saemtliche Sinne.");
  AddDetail(("sinne"),
	    "Deine Sinne sind durch den Geruch hier schon ziemlich betaeubt.");
  AddSmell(({DEFAULT_SMELL,"geruch"}),
	   "Es riecht nach ziemlich graesslichen Dingen. "
	   "Du denkst kurz nach und kommst zum Entschluss, dass Du nicht "
	   "genau wissen willst was Du gerade gerochen hast.");
  AddSmell(({"dingen", "dinge"}),
	   "Neeeein, Du willst nicht genau wissen nach was es hier riecht.");
  AddDetail(("entschluss"),
	    "Ein ausgesprochen weiser Entschluss wie Du findest.");
  AddSound(DEFAULT_SOUND,
	   "Du meinst aus dem Norden Geraeusche, vernommen zu haben.");
  AddSound(({"geraeusche", "geraeusch"}),
	   "Das hat sich beinahe wie ein Zischen angehoert.");
  AddSound(({"zischen"}),
	   "Das Zischen kam aus Richtung Norden.");
  AddDetail(({"richtungen", "richtung", "orientierungssinn"}),
	    "Du kennst Deine Richtung immer ganz genau, Du hast ja "
	    "einen hervorragenden Orientierungssinn.");

  AddExit(({"nordwesten"}), ROOM "kanal1_2_2");
  AddExit(({"norden"}),     ROOM "kanal1_3_2");
  AddExit(({"nordosten"}),  ROOM "kanal1_4_2");
  AddExit(({"osten"}),      ROOM "maskenraum");
  
  // auskommentiert da funktion "leg_um" nicht existiert...
  // AddCmd(({"leg","lege"}),"leg_um"); // Was sollte das werden?
}  
