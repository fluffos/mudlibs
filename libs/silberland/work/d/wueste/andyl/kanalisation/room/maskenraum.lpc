#include "../def.h"

inherit "std/room";

nosave int maskeda=1;

void create()
{
  ::create();
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_DESERT]));
  SetProp(P_INT_SHORT, "Ein Raum in der Kanalisation von Arrakeen");
  SetProp(P_INT_LONG,
	   "Du stehst hier in einem weitern Raum der Kanalisation von "
	   "Arrakeen. Nebelschwaden ziehen durch den Raum und der Gestank "
	   "ist kaum noch auszuhalten. Der einzige Ausgang den Du siehst "
	   "ist der Weg nach Westen. Eine ungute Ahnung befaellt Dich.\n");
  
  AddDetail(({"nebelschwaden", "schwaden", "sicht"}),
	    "Nebelschwaden ziehen durch den Raum und schraenken die Sicht "
	    "doch ziemlich ein.");
  AddDetail(({"weg", "ausgang"}),
	    "Der einzige Weg aus diesem Raum, ist der Weg nach Westen.");
  AddDetail(("raum"),
	    "Dieser Raum unterscheidet sich etwas von den uebrigen in der "
	    "Kanalisation. Besonders auffaellig ist, dass die Waende aus "
	    "Lehmziegeln gemacht wurden.");
  AddDetail(("ahnung"),
	    "Du hast so eine Ahnung als ob Dich irgendetwas beobachten wuerde "
	    "und zwar irgendetwas, dass Dir nicht wohlgesonnen ist."),
  AddDetail(("boden"),
	    "Der Boden ist eine einzige undefinierbare Schlammbruehe in der "
	    "ein paar Dreckhaufen aufragen.");
  AddDetail(({"schlammbruehe", "bruehe", "schlamm"}),
	    "Jetzt bloss nicht daran denken was da alles drin sein koennte.");
  AddDetail(("decke"),
	    "Die Decke besteht aus getrocknetem Lehm.");
  AddDetail(({"arrakeen", "stadt"}),
	    "Arrakeen wird die Stadt ueber Dir genannt.");
  AddDetail(("kanalisation"),
	    "Du befindest Dich hier in der Kanalisation von Arrakeen.");
  AddDetail(("sand"),
	    "Etwas ganz seltenes in der Wueste.");
  AddDetail(("wueste"),
	    "Arrakeen befindet sich ja in der Wueste.");
  AddDetail(({"haufen", "dreckhaufen"}),
	    "Die Dreckhaufen ragen aus der Schlammbruehe hervor. Nur uebermaessig "
	    "interessant scheinen diese nicht zu sein.");
  AddDetail(({"waende", "wand"}),
	    "Die Waende hier bestehen hier aus Lehmziegeln welche mit einer Dreckschicht "
	    "ueberzogen sind.");
  AddDetail(({"lehm", "getrockneten lehm"}),
	    "Ganz gewoehnlicher getrockneter Lehm.");
  AddDetail(({"ziegeln", "ziegel", "lehmziegeln", "lehmziegel"}),
	    "Seltsam, die Waende der uebrigen Kanalisation sind nur aus "
	    "Sand und Lehm. Wieso hier wohl Lehmziegel verwendet wurden?");
  AddDetail(({"schicht", "dreckschicht"}),
	    "Unter der Dreckschicht scheint etwas zu sein. Ob man die wohl "
	    "abkratzen kann?");
  AddSmell(DEFAULT_SMELL,"Der Gestank hier ist kaum noch zu ertragen.");
  AddSmell(("gestank"),
	   "Igitt. Du faengst an zu wuergen.");
  AddSound(DEFAULT_SOUND,
	   "Es ist ueberraschend still hier."); 

  AddExit(({"westen"}), ROOM "kanal1_3_1"); 
  
  AddCmd(({"kratz", "kratze"}), "kratze_ab");    
}  

nosave int kratze_ab(string str)
{
  object ma;

  notify_fail("Was willst Du abkratzen?\n");
  if(!str) return 0;

  if(str == "dreck ab" || str == "dreckschicht ab" || str == "schicht ab")
    {
      if(present("\narrakeenkanalitem", TP) && maskeda)
	{
	  say(BS(TPN+" kratzt etwas an der Wand herum und scheint dabei "
		 "etwas gefunden zu haben."));

	  write(BS("Du findest unter der Dreckschicht eine Nische "
		   "in der eine alte Stoffmaske liegt..."));

	  ma=clone_object(OBJ "maske");
	  
	  if(ma->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      write(BS("Da Du die Maske jedoch nicht mehr tragen kannst, "
		       "laests Du sie zurueck und versteckst die Nische "
		       "wieder."));
	      
	      ma->remove(1);
	    }
	  else
	    {
	      write(BS("Schnell steckst Du die Maske ein."));
	      
	      maskeda=0;
	    }
	  
	  return 1;
	}
	 
      say(BS(TPN+" kratzt etwas an der Wand herum."));
  
      write(BS("Du findest unter der Dreckschicht eine Nische "
	       "die aber leider leer ist."));
      
      return 1;
    }
  
  return 0;
}

void reset()
{
  ::reset();

  maskeda=1;
}
