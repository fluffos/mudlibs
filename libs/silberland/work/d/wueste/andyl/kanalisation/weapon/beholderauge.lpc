#include "../def.h"
#include <vt100.h>
#include <ansi.h>

inherit "std/weapon";

#define ROTATE 33

nosave int timeout, rotate, magics;

nosave SetMagic()
{
  magics%=4;
  
  switch(magics)
    {
    case 0: 
      SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_LIGHTNING, DT_ELECTRIC})); 
      break;
      
    case 1: 
      SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_ACID, DT_COLD})); 
      break;
      
    case 2: 
      SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_MAGIC, DT_FIRE})); 
      break;
      
    case 3: 
      SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_UNHOLY, DT_TERROR})); 
      break;
    }

  rotate=0;
}

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  if(file_name(previous_object())!="/p/daemon/itemd/itemd") 
    {
      raise_error("Illegales Clonen des Uniques! ");

      destruct();

      return;
    }
  
  SetProp(P_SHORT, "Das Auge des Betrachters");
  SetProp(P_LONG, 
	  BS("Dies ist eines dar Augen eines alten Betrachters. Es sieht aus "
	     "wie ein etwas unfoermiger Stab an dessen Ende ein Auge ist. Es "
	     "besteht aus ungewohnlich harten Fleischresten und kann wohl gut "
	     "als Waffe verwendet werden."));
  SetProp(P_INFO, 
	  BS("Das Auge des Betrachters ist eine sehr maechtige Waffe die "
	     "einiges an Magie in sich birgt."));
  AddId(({"auge", "auge des betrachters"}));
  SetProp(P_NAME, "Auge des Betrachters");
  SetProp(P_GENDER, NEUTER);  
  SetProp(P_VALUE, 20000); 
  SetProp(P_WEIGHT, 1500); 
  SetProp(P_SIZE, 80);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, ({
    DT_BLUDGEON, DT_LIGHTNING, DT_ACID, DT_MAGIC, DT_ELECTRIC, DT_COLD, 
      DT_FIRE, DT_UNHOLY, DT_TERROR})); 
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 45);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([ MAT_MISC_DEAD : 60, MAT_MISC_MAGIC:40]));
  SetProp(P_WIELD_RESTRICTIONS, 
	  ([P_LEVEL:25, A_INT:20, A_DEX:17, SR_SEER:1, P_FROG:1]));
  
  SetProp(P_HIT_FUNC, this_object());
  
  AddDetail(({"fleischreste", "fleisch"}),
	    "Die Fleischreste scheinen haerter als jedes Metall zu sein.");
  
  AddDetail(({"stab"}),
	    "Der Stab wirkt etwas unfoermig, ist jedoch recht gut "
	    "ausbalanciert. An einem Ende befindet sich ein seltsames "
	    "Auge.");
  
  AddDetail(({"ende"}),
	    "An einem Ende befindet sich ein seltsames Auge.");

  rotate=0;
  magics=0;

  SetMagic();
}

void reset()
{
   if(!is_clone(ME)) return;
  ::reset();
  
  if(!MENV) 
    {
      call_out("remove", 0);
      
      return;
    }
  
  if(query_once_interactive(MENV))
    {
      timeout=0;

      return;
    }
  
  if(timeout > 2)
    {
      call_out("remove", 0);
      
      return;
    }
  
  timeout++;
}

varargs int remove(int silent)
{
  SetProp(P_CURSED, 0);
  
  return ::remove(silent);
}

string name(int casus, int daemon)
{
  string n;

  n=::name(casus, daemon);

  if((TP) && (TP->QueryProp(P_TTY)=="ansi"))
    return VT_GREEN+VT_TA_B+n+VT_NORMAL;
  else 
    if((TP) && (TP->QueryProp(P_TTY)=="vt100"))
      return VT_TA_B+n+VT_NORMAL;

  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

string short()
{
  string s;

  if(QueryProp(P_WORN)) 
    s=" ("+(QueryProp(P_WIELDED)||"gezueckt")+")"; 
  else 
    s="";
  
  if((TP) && (TP->QueryProp(P_TTY)=="ansi"))
    return VT_GREEN+VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  else 
    if((TP) && (TP->QueryProp(P_TTY)=="vt100"))
      return VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n";

  return QueryProp(P_SHORT)+s+".\n";
}

int HitFunc(object enemy)
{
  if(!objectp(QueryProp(P_WIELDED))) return 0;
  
  rotate++;

  if(rotate >= ROTATE) 
    {
      tell_object(QueryProp(P_WIELDED), BS("Das Auge leuchtet kurz auf..."));
      
      magics++;
      
      SetMagic();
    }
  
  return 0;
}
