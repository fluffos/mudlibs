#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine Todesviper");
  SetProp(P_LONG,
	  "Die Todesviper ist eine Mischung aus einer Schlange "
	  "und einer humanoiden Gestalt. Ihr ganzer Koerper ist "
	  "mit dicken, dunkelroten Schuppen ueberzogen. Ihr Oberkoerper "
	  "aehnelt dem eines Menschen waehrend der Unterkoerper eher "
	  "einer Schlange zuzuordnen ist. An ihren Haenden befinden sich "
	  "lange Spitze Krallen. Eine gespaltene Zunge zuengelt mit einem "
	  "unangenehmen Zischen immer wieder aus ihrem, mit spitzen Zaehnen "
	  "besetztem Mund. Sie sieht Dich voller Hass mit ihren dunkelgruenen "
	  "Augen an.");
  
  SetProp(P_NAME, "Todesviper");
  SetProp(P_GENDER, FEMALE);
  AddId(({"viper", "todesviper", "NOWIMPY", "Speerexperte"}));
  
  create_default_npc(30);
  
  SetProp(P_HANDS, ({
    " mit ihren spitzen Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_BODY, 220);
  SetProp(P_RACE, "Todesviper");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_REJECT, ({ REJECT_DROP, "Die Todesviper laesst es fallen.\n"}));
  SetProp(P_DIE_MSG, " zuckt heftig, faellt dann zu Boden und bleibt regungslos liegen.\n");
  SetProp(P_KILL_MSG, "Ssschhtttiiirrb Eeeeindringliiiing!\n");
  
  CLONEME("/p/weapon/spear/kampfspiess");
  command("zuecke kampfspiess");
  
  CLONEME(OBJ +({"schwacherheiltrank","schwacherheiltrank",
		  "heiltrank","starkerheiltrank"})[random(4)]);
  
  SUID;
  
  SetProp(P_SPELLRATE, 30);

  AddSpell(6,200,
	   "Die Todesviper schlaegt mit ihrem Schwanz nach Dir.\n",
	   "Die Todesviper schlaegt mit dem Schwanz auf @WEN.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(3,300,
	   "Die Todesviper rammt ihren Kampfspiess in Dich.\n",
	   "Die Todesviper rammt ihren Kampfspiess in @WEN.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(1,350,
	   "Die Todesviper springt vor und beisst Dir in den Hals.\n",
	   "Die Todesviper springt vor und beisst @WEM in den Hals.\n",
	   DT_POISON, ([SP_SHOW_DAMAGE:1]) );
}
