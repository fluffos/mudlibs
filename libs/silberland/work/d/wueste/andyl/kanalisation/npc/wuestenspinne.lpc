#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Wuestenspinne");
  SetProp(P_LONG,
	  "Die Wuestenspinne hat die Farbe von Sand und ist so in der "
	  "Wueste sehr schwer aufzufinden. Sie hat acht messerscharfe "
	  "Beine mit denen sie ihre Opfer leicht aussschalten kann. Dein "
	  "Gesicht spiegelt sich in den zwei dunklen facettenreiche Augen.");
  
  SetProp(P_NAME, "Wuestenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "wuestenspinne"}));
  
  create_default_npc(10);
  
  SetProp(P_HANDS, ({" mit ihren scharfen Beinen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_BODY, 50+random(10));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 50+random(20));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_REJECT, ({ REJECT_DROP, "Die Wuestenspinne will das nicht.\n"}));
  SetProp(P_DIE_MSG, " faellt mit einem lauten Knirschen zu Boden.\n");
 
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt#");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt#");
  
  SetProp(P_MNPC_AREA, ({
    ROOM "kanal1_2_3", ROOM "kanal1_2_2", ROOM "kanal1_2_1", 
      ROOM "kanal1_2_4", ROOM "kanal1_3_1", ROOM "kanal1_3_2", 
      ROOM "kanal1_3_4", ROOM "maskenraum", ROOM "kanal1_4_2", 
      ROOM "kanal1_4_3", ROOM "fallenraum", ROOM "kanal1_5_3", 
      ROOM "kanal1_5_4"}));
  
  SetProp(P_MNPC_WAIT, ({ 15, 25, 35 }));
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS + MOV_INDOORS + MOV_MOVES);

  AddInfo(DEFAULT_INFO, "kann Dich nicht verstehen.\n");
  
  SetProp(P_SPELLRATE, 5);

  AddSpell(6,200,
	   "Die Wuestenspinne rammt eines ihrer scharfen Beine in Deinen Bauch.\n",
	   "Die Wuestenspinne rammt eines ihrer scharfen Beine in den Bauch von @WEN.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,220,
	   "Die Wuestenspinne springt auf Deinen Kopf.\n",
	   "Die Wuestenspinne springt auf den Kopf von @WEN.\n",
	   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy)
{
  ModifySkillAttribute(TO, SA_SPEED, 200, 500);

  return ::Defend(dam, dam_type_list, spell, enemy);
}
