#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Narugskelett");
  SetProp(P_LONG,
	  "Ein beinahe schwarzes menschliches Skelett, an dessen "
	  "Kleidungsreste das Abzeichen der Bruderschaft von Narug "
	  "zu erkennen ist. In seinen Augen leuchet ein violettes "
	  "unheiliges Feuer und es scheint sehr aggressiv zu sein.");
  
  SetProp(P_NAME, "Narugskelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett", "narugskelett"}));
  AddClass(({CL_UNDEAD,CL_SKELETON}));

  create_default_npc(14+random(4));
  
  SetProp(P_HANDS, ({
    " mit seinen Knochenfingern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_BODY, 140+random(30));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160+random(50));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_AGGRESSIVE, 0.9);
  SetProp(P_REJECT, ({ REJECT_DROP, "Das Narugskelett wirft es zurueck.\n" }));
  SetProp(P_DIE_MSG, " bricht in sich zusammen.\n");
  SetProp(P_KILL_MSG, "Meister, ein Eindringling weniger!\n");
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([DT_EXPLOSION:  0.3, DT_LIGHT:   0.3, DT_ACID:  0.3, 
	    DT_POISON:    -1.0, DT_TERROR: -1.0, DT_HOLY:  0.5, 
	    DT_UNHOLY:    -0.5, DT_MAGIC:   0.0, DT_RIP:  -0.5,
	    DT_PIERCE:    -0.5 ]));
  
  SetProp(P_MSGIN, "findet hier ein Opfer");
  SetProp(P_MSGOUT, "geht# um dort neue Opfer zu finden");
  SetProp(P_MMSGIN, "findet hier ein Opfer");
  SetProp(P_MMSGOUT, "geht# um dort neue Opfer zu finden");
  
  SetProp(P_MNPC_AREA, ({
    ROOM "kanal1_2_3", ROOM "kanal1_2_2", ROOM "kanal1_2_1", 
      ROOM "kanal1_2_4", ROOM "kanal1_3_1", ROOM "kanal1_3_2", 
      ROOM "kanal1_3_4", ROOM "maskenraum", ROOM "kanal1_4_2", 
      ROOM "kanal1_4_3", ROOM "fallenraum", ROOM "kanal1_5_3", 
      ROOM "kanal1_5_4"}));

  SetProp(P_MNPC_WAIT, ({ 10, 20, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS + MOV_INDOORS + MOV_MOVES);

  AddInfo(DEFAULT_INFO, "ignoriert Deine Frage voellig.\n");

  AddDetail(({"augen", "feuer"}),
	    "In den Augen des Narugskelettes lodert ein violettes unheiliges "
	    "Feuer.");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(20,300,
	   "Das Narugskelett fuehrt einen maechtigen Hieb auf Dich herab.\n",
	   "Das Narugskelett fuehrt einen maechtigen Hiab auf @WEN herab.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]));
  
  CLONEME("/p/weapon/sword/krummschwert");
  command("zuecke krummschwert");
  SUID;
}
