inherit "std/npc";
inherit "std/npc/spells";

#include <new_skills.h>
#include "../def.h"

nosave int schutz;

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Xorathir, der alte Betrachter");
  SetProp(P_LONG, 
	  BS("Xorathir ist ein uralter Betrachter, welche auch als Beholder bekannt sind.")+
	  BS("Er sieht aus wie eine riesige fliegende Fleischkugel, "
	     "von der andauernd ein ekliger gruener Schleim tropft. "
	     "Inmitten dieser Kugel ist ein riesiges Auge, welches "
	     "Dich argwoehnisch beobachtet. Direkt darunter ist ein "
	     "grosses Maul welches mit messerscharfen Zaehnen gespikt ist. "
	     "Auf der Oberseite der Kugel kannst Du neun Tentakel sehen, an "
	     "deren Enden jeweils ein weiteres Auge ist. Der Beobachter "
	     "trieft foermlich vor Bosartigkeit und scheint sehr maechtig "
	     "zu sein."));
  SetProp(P_NAME, "Xorathir");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"xorathir", "betrachter", "alter betrachter", "alten betrachter", 
	    "alter beholder", "alten beholder", "beholder", "NOCONTROL","NOWIMPY"}));
  set_living_name("xorathir");
  SetProp(P_INFO, 
	  BS("Der Betrachter scheint voll alter starker Magie zu sein."));
  create_default_npc(40);

  SetProp(P_HANDS, ({" mit seinen spitzen Zaehnen",500,DT_PIERCE}));
  SetProp(P_MAX_HP, 1100);
  SetProp(P_BODY, 300);
  SetProp(P_XP, 4000000);
  SetProp(P_RACE, "Betrachter");
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -1000);
  SetProp(P_HEAL, 100);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_NOMAGIC, 30);
  SetProp(P_DIE_MSG,  " schreit: NEEEEEEEEEEIIIIIIIINNNNNNN!!!.\n");
  SetProp(P_MURDER_MSG, "NEEEEEEEEEEEIIIIIIIIIIIINNNNNNNN!!!");
  SetProp(P_KILL_NAME, "Xorathir, der alte Betrachter");

  SetProp(P_KILL_MSG, ({
    "verlacht lauthals sein Opfer.",
      ": \"HAHA, Du elendes Wuermchen!\"",
      ": \"Jaaaaaaa, der Nachtisch ist gesichert!\""})[random(3)]);
  
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1]));

  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([DT_FIRE:  -0.3, DT_COLD:      -0.3, DT_WATER:     -0.3, 
	    DT_AIR:   -0.3, DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.3, 
	    DT_SOUND:  0.2, DT_LIGHT:      0.0, DT_ELECTRIC:  -0.3, 
	    DT_ACID:  -0.3, DT_POISON:     0.0, DT_TERROR:    -1.0,
	    DT_HOLY:  -0.5, DT_UNHOLY:    -1.0, DT_MAGIC:     -1.0]));

  SetChats(2, ({
    "Xorathir starrt Dich boese an.\n",
      "Xorathir droht: Verschwinde von hier Du Wurm!\n",
      "Xorathir verdreht vier seiner Augen in Deine Richtung.\n",
      "Xorathir verdreht drei seiner Augen in Deine Richtung.\n",
      "Xorathir verdreht zwei seiner Augen in Deine Richtung.\n",
      "Xorathir verdreht fuenf seiner Augen in Deine Richtung.\n"}));
    
  AddInfo(DEFAULT_INFO, " droht: \"Belaestige mich nicht unwuerdige Kreatur!\"\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
			  "Xorathir scheint eher an DIR interessiert zu sein!\n" }) );
  SetProp(P_SPELLRATE,70);

  AddSpell(3,550,
	   "Xorathir reisst mit seinen spitzen Zaehnen etwas Fleisch aus Dir heraus.\n",
	   "Xorathir reisst mit seinen spitzen Zaehnen etwas Fleisch aus @WEM heraus.\n",
	   DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 1,
	    "Xorathir verfaellt in eine Trance und beginnt etwas zu murmeln.\n",
	    "Xorathir verfaellt in eine Trance und beginnt etwas zu murmeln.\n",
	    DT_MAGIC, "spell_schutz");
  AddSpell(2,600,
	   "Xorathir spuckt einen Feuerball auf Dich.\n",
	   "Xorathir spuckt einen Feuerball auf @WEN.\n",
	   DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,650,
	   "Xorathir beschiesst Dich mit spitzen Eispfeilen.\n",
	   "Xorathir beschiesst Dich @WEN mit spitzen Eispfeilen.\n",
	   DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,700,
	   "Xorathir ersaeuft Dich in einer ploetzlich entstandenen Untiefe.\n",
	   "Xorathir ersaeuft @WEN in einer ploetzlich entstandenen Untiefe.\n",
	   DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,750,
	   "Xorathir beschwoert einen Orkan um Dich herum.\n",
	   "Xorathir beschwoert einen Orkan um @WEN herum.\n",
	   DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,800,
	   "Xorathir wirft einen Blitz auf Dich.\n",
	   "Xorathir wirft einen Blitz auf @WEN.\n",
	   DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,850,
	   "Xorathir laesst die Umgebung um Dich explodieren.\n",
	   "Xorathir laesst die Umgebung um @WEN explodieren.\n",
	   DT_EXPLOSION,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,900,
	   "Xorathir murmelt etwas und ein gewaltiger Schock durchfaehrt Dich.\n",
	   "Xorathir murmelt etwas und ein gewaltiger Schock durchfaehrt @WEN.\n",
	   DT_ELECTRIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,950,
	   "Xorathir bespuckt Dich mit einer schmerzhaften, aetzenden Substanz.\n",
	   "Xorathir bespuckt @WEN mit einer schmerzhaften, aetzenden Substanz.\n",
	   DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 800,
	   "Xorathir haucht Dir einen uebelriechenden Nebel entgegen.\n",
	   "Xorathir haucht @WEM einen uebelriechenden Nebel entgegen.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1050,
	   "Xorathir kreischt einmal auf und eine ungekannte Angst durchzuckt Dich.\n",
	   "Xorathir kreischt einmal auf und eine ungekannte Angst durchzuckt @WEN.\n",
	   DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1100,
	   "Xorathir legt eine Fluch ueber Dich.\n",
	   "Xorathir legt einen Fluch ueber @WEN.\n",
	   DT_UNHOLY,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,1150,
	   "Xorathir huellt Dich in eine extrem schmerzhafte violette Aura.\n",
	   "Xorathir huellt @WEN in eine extrem schmerzhafte violette Aura.\n",
	   DT_MAGIC,([SP_SHOW_DAMAGE:1])); 
  AddDefaultSpell(1,100,DS_PARALYZE,
		  "Xorathir paralysiert Dich mit seinen Augen.\n",
		  "Xorathir paralysiert @WEN mit seinen Augen.\n", 2);
  AddDefaultSpell(1,100,DS_POISON,
		  "Xorathir vergiftet das Blut in deinen Adern.\n",
		  "Xorathir vergiftet das Blut in den Adern von @WEM.\n", 2);
  AddDefaultSpell(1, 100, DS_DISARM,
		  "Xorathir starrt Dich intensiv an und ploetzlich verlierst Du Deine Waffe.\n",
		  "Xorathir starrt @WEN intensiv an und ploetzlich verliert @WER die Waffe.\n");
  
  SetAttackChats(15, ({
    "Xorathir faucht: Du wirst sterben, Du nichts!.\n", 
      "Xorathir taucht ploetzlich hinter Dir wieder auf.\n",
      "Alle Augen Xorathirs richten sich ploetzlich auf Dich.\n",
      "Xorathir lacht laut ueber Dich.\n",
      "Xorathir konzentriert sich auf einen maechtigen Zauber.\n",
      "Xorathir meint: Du wirst der Nachtisch!.\n",
      "Xorathir grinst fies.\n"}) );
  SUID;
  schutz=2;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("react")!= -1) return; 
  else
    call_out("react", 2, 
	     "blickt Dich kurz an und attackiert dann sofort",
	     "blickt "+TP->name(WEM)+" kurz an und attackiert dann sofort");
}

void react(string victim, string others)
{
  if(present(TP, ENV(TO))) 
  {
    if (IS_WIZARD(TP))
      {
	tell_room(ENV(TO), BS("Xorathir sagt: Verschwinde du elendes Magierwuermchen!\n"));
      }
    else
      {
	tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
	tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
	Kill(TP);
      }
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int i;
  object *ob;
  
  if(schutz && dam > 34)
    {
      if(--schutz <= 0) 
	{
	  tell_room(ENV(enemy),
		    "Xorathirs magischer Schutzschild bricht in sich zusammen.\n");
	  schutz=0;
	}

      return ::Defend(dam/2, dam_type, spell, enemy);
    }

  return ::Defend(dam, dam_type, spell, enemy);
}


void spell_schutz(object enemy, int damage, mixed dam_type)
{
  if(schutz)
    tell_room(ENV(enemy),
	      BS("Xorathir verstaerkt seinen magischen Schutzschild."));
  else
    tell_room(ENV(enemy),
	      BS("Xorathir baut einen magischen Schutzschild um sich auf."));

  if((schutz+=random(12)+5)>22 ) schutz=22;
}


// Mitloggen wenn der NPC einen Spieler killt:

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if (killer == TO)
    write_file(LOG "beholder.log",
	       ctime()+": Xorathir der alte Betrachter hat gerade "
	       +((player->QueryProp(P_FROG))?CAP(getuid(player)):player->name(WEN))
	       +" umgebracht ("+lostexp+").\n");
}

varargs void die(int pd)
{
  object ob;
  
  if(!pd) {
    if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
      ob->Mark();
    }
    
    if(objectp(QueryProp(P_KILLER)) && interactive(QueryProp(P_KILLER))) {
      if(objectp(ob=find_object(ITEMD)->GenerateUnique(WEAPON "beholderauge"))) {
	      ob->move(ME);
      }
    }
  }
  
  ::die(pd);
}
