#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"daemonin", "daemon", "NOWIMPY", "\ntionildaemonin"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Daemonin");
  SetProp(P_SHORT, "Eine Daemonin");
  SetProp(P_LONG, "Du siehst eine Daemonin mit menschenaehnlicher "
	   "Gestalt, allerdings besitzt sie statt einer Haut eine "
	   "gruenes Schuppenkleid und ihre Haende haben gewaltige Klauen. "
	   "Sie sieht einfach nur finster aus.\n");

  SetProp(P_ALIGN, -500);

  create_default_npc(16);

  SetProp(P_SIZE, 200);
  SetProp(P_RACE, "Daemon");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_HANDS, ({" mit ihren Klauen", 180, DT_PIERCE}));
  
  AddClass(CL_DEMON);
  
  AddDetail(({"schuppen", "schuppenkleid", "haut"}),
	    "Wo eigentlich Haut sein sollte befindet sich kleine gruene "
	    "Schuppen.");
  
  SetProp(P_SPELLRATE,15);

  AddSpell(1,220, 
	   "Die Daemonin rammt Dir ihre Klauen in den Hals.\n",
	   "Die Daemonin rammt @WEM ihre Klauen in den Hals.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(6, ({
    "Die Daemonin schnauzt: Du kannst mich nicht besiegen, Du Wurm!\n",
      "Die Daemonin faucht: Du wirst sterben, qualvoll sterben!\n",
      "Die Daemonin funkelt boese.\n"
      }));
  
  SetProp(P_DIE_MSG, " explodiert in gleissendem Licht.\n");
  SetProp(P_KILL_MSG, "HARHARHARHAR!!!");
  
  SetProp(P_DEFAULT_INFO,
	   "schnauzt: Nerv micht nicht Du Wurm!");
  SetProp(P_REJECT, ({ REJECT_DROP, "Die Daemonin will das nicht.\n" }));

  SUID;
}

varargs void die(int poisondeath)
{
  object spieler, item;
  
  tell_room(MENV, "Eine magische Explosion fegt Durch den Raum.\n");

  if(objectp(spieler=QueryProp(P_KILLER)))
    {
      if(objectp(item=present("\narrakeenkanalitem", spieler)) && 
	 (item->armreifuebergeben()))
	if(!IS_SEER(spieler))
	  {
	    tell_object(spieler,
			BS("Zurueck bleibt nur ein dunkler Edelstein..."));
	    
	    CLONEME("/obj/gems/smaragd");
	    
	    item->remove(1);
	  }
	else
	  {
	    if("/obj/sehertormaster"->DiscoverDoor(ROOM "haus", spieler))
	      {
		write_file(LOG "sehertor",
			   BS(dtime()+": "+CAP(getuid(spieler))+" findet das "
			      "Seherportal."));
		tell_object(spieler, 
			    BS("Durch die Magieansammlung im Raum wird fuer "
			       "dich ploetzlich ein magisches Portal "
			       "sichtbar."));
	      }
	    else
	      {
		tell_object(spieler,
			    BS("Zurueck bleibt nur ein dunkler Edelstein..."));
		
		CLONEME("/obj/gems/smaragd");	    
	      }
	    
	    item->remove(1);
	  }
    }
  ::die(poisondeath);
}

