#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Narugzombie");
  SetProp(P_LONG,
	  "Eine wandelnde menschliche Leiche, von der Kleidungs und "
	  "Fleischfetzen haengen und die das Abzeichen der Bruderschaft "
	  "von Narug traegt. Der Koerper strahlt ein unheiliges violettes "
	  "Leuchten aus.");
  
  SetProp(P_NAME, ({"Narugzombie", "Narugzombie", "Narugzombie", "Narugzombie"}));
  SetProp(P_GENDER, MALE);
  AddId(({"zombie", "narugzombie"}));

  AddClass(({CL_UNDEAD}));

  create_default_npc(14);
  
  SetProp(P_HANDS, ({
    " mit seinen verwesenden Haenden", QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_BODY, 110+random(30));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 140+random(50));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_AGGRESSIVE, 0.9);
  SetProp(P_REJECT, ({ REJECT_DROP, "Das Narugzombie wirft es zurueck.\n"}));
  SetProp(P_DIE_MSG, " bricht in sich zusammen.\n");
  SetProp(P_KILL_MSG, "Der Eindringling stoehrt uns nicht weiter, Meister!\n");
  
  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([DT_EXPLOSION: 0.5, DT_POISON: -0.8, DT_TERROR: -1.0,
	    DT_HOLY:      0.5, DT_UNHOLY: -0.5 ]));
  
  SetProp(P_MSGIN, "findet hier ein Opfer");
  SetProp(P_MSGOUT, "geht# um dort neue Opfer zu finden");
  SetProp(P_MMSGIN, "findet hier ein Opfer");
  SetProp(P_MMSGOUT, "geht# um dort neue Opfer zu finden");
  
  SetProp(P_MNPC_AREA, ({
    ROOM "kanal1_2_3", ROOM "kanal1_2_2", ROOM "kanal1_2_1", 
      ROOM "kanal1_2_4", ROOM "kanal1_3_1",  ROOM "kanal1_3_2", 
      ROOM "kanal1_3_4", ROOM "maskenraum", ROOM "kanal1_4_2", 
      ROOM "kanal1_4_3", ROOM "fallenraum", ROOM "kanal1_5_3", 
      ROOM "kanal1_5_4"}));

  SetProp(P_MNPC_WAIT, ({ 15, 25, 35 }));
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_MOVES);
  
  AddInfo(DEFAULT_INFO, "scheint Deine Frage nicht einmal zu bemerken.\n");

  AddDetail(({"leuchten", "koerper"}),
	    "Der Koerper der Narugzombies strahlt ein violettes unheiliges "
	    "Licht aus.");
  
  SetProp(P_SPELLRATE, 15);

  AddSpell(20,200,
	   "Der Narugzombie beisst Dir ploetzlich in die Schulter.\n",
	   "Der Narugzombie beisst @WEN ploetzlich in die Schulter.\n",
	   DT_RIP, ([SP_SHOW_DAMAGE:1]));
  
  CLONEME("/p/armour/armour/messingruestung.lpc");
  command("trage messingruestung");
  SUID;
}
