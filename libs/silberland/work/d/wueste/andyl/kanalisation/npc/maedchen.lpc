#include "../def.h"

inherit "std/npc";

#define BSI(x,y) break_string(x,78,y,1)

nosave int gotbracelet;

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Maedchen");
  SetProp(P_LONG, "Ein kleines, schmutziges Menschenmaedchen.\n"
	  "Sie traegt Lumpen hat halblanges schwarzes Haar, "
	  "runde gruene Augen und eine dunkelbraune Hautfarbe. "
	  "Sie wurde mit einer Kette an den Obelisken in der Mitte "
	  "des Raumes gekettet. Sie sieht ziemlich ungluecklich aus "
	  "und kann sicher Hilfe gebrauchen.\n");
  SetProp(P_NAME, "Maedchen");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"kleines","klein","kleine"}));
  SetProp(P_NOATTACK, "sieht Dich mit ihrem hilflosem Blick an\nund darauf bringst Du es einfach nicht uebers Herz " 
	  "es anzugreifen.");  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_REJECT, ({
    REJECT_GIVE, "Das Maedchen meint: Danke, aber das brauch ich nicht.\n"}));

  AddId(({"maedchen", "kleines maedchen", "menschenmaedchen", "tionil", 
	    "\ntionil"})); 
  create_default_npc(3);
  SetProp(P_BODY, 3);
  SetProp(P_HANDS, ({" mit ihren kleinen Haenden.", 10}));
  SetProp(P_ALIGN, 100); 
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 0);
  
  SetChats(2, ({
    "Das Maedchen seufzt: Niemand will mir helfen.\n",
      "Das Maedchen jammert: Alles nur wegen diesem Zauberer.\n",
      "Das Maedchen sieht Dich flehend an.\n",
      "Das Maedchen rollt sich in ihrem Lager zusammen.\n",
      }));

  AddDetail(({"haar", "haare"}),
	    "Die Haare des kleinen Maedchens sind schmutzig und verfilzt.");
  AddDetail(({"haut", "hautfarbe"}),
	    "Das Maedchen hat eine dunkelbraune Hautfarbe.");
  AddDetail(({"augen", "auge"}),
	    "Das Maedchen schaut Dich mit traurigen gruenen Augen an.");
  AddDetail(({"lumpen", "kleidung"}),
	    "Die Kleidung des Maedchens besteht nur aus alten loechrigen Lumpen.");
  AddInfo(({"hilfe", "helfen", "problem"}), "@@hilfe@@", "sagt: ");
  AddInfo(("name"),
	  "Mein Name ist Tionil.", "sagt: ");
  AddInfo(({"eltern", "mutter", "vater", "papa", "mama", "papi", "mutti"}),
	  "Meine Eltern sind leider schon vor langer Zeit gestorben.", "meint traurig: ");
  AddInfo(({"lumpen", "kleidung"}),
	  "Eine bessere Kleidung als diese Lumpen kann ich mir leider nicht leisten.", 
	  "meint betruebt: "); 
  AddInfo(({"huette"}),
	  "Diese Huette haben einst meine Eltern gebaut.", "meint betruebt: "); 
  AddInfo(({"zauberer"}),
	  "Der boese Zauberer hat mich fuer immer an diesen Obelisken gekettet. "
	  "Und das alles nur weil ich ihm einen kleinen Streich gespielt habe.", "sagt: ");
  AddInfo(({"fluch"}),
	  "Der Fluch des boesen Zauberers hat mich fuer immer an diesen "
	  "Obelisken gekettet.", "sagt: ");
  AddInfo(({"oblisk", "oblisken" "ketten", "kette"}),
	  "Der Obelisk und die Ketten sind so gut wie unzerstoerbar. "
	  "Nur ein bestimmter magischer Armreif kann den Fluch, durch "
	  "den ich hier festgehalten werde, brechen.", "sagt: ");
  AddInfo(("streich"),
	  "Das war eigentlich ein ganz harmloser Streich, ich hab dem Zauberer nur seine Schuhe "
	  "an einem sehr heissem Tag versteckt.", "sagt: ");
  AddInfo(("schuhe"),
	  "Die Schuhe des Zauberers waren mit ganz vielen lustigen Zeichen bemalt.", "sagt: ");
  AddInfo(({"arrakeen", "armenviertel"}),
	  "Du berfindest Dich hier im Armenviertel von Arrakeen. Ich lebe "
	  "hier schon seit meiner Geburt.", "sagt: ");
  AddInfo(({"kanalisation"}),
	  "Die Kanalisation von Arrakeen kann man durch den Keller dieser Huette betreten. "
	  "Aber Vorsicht: Da soll es ganz fiese Monster geben.", "sagt: ");
  AddInfo(({"hilfe", "helfen", "aufgabe"}),"@@hilfe@@", "sagt: ");
  
  gotbracelet=0;
  
  AddCmd(({"biete"}), "biete_hilfe");
}

string hilfe()
{
  if(!present("\narrakeenkanalitem", TP))
    return "Ich koennte wirklich Hilfe gebrauchen. Vor einiger "
      "Zeit hab ich einem boesen Zauberer einen kleinen "
      "Streich gespielt und als Strafe hat er mich verflucht "
      "und hier fuer immer an diesen Obelisken gekettet. "
      "Die einzige Moeglichkeit diesen Fluch zu brechen waere "
      "einen gewissen Armreif zu finden welcher sich anscheinend "
      "in der Kanalisation unterhalb von Arrakeen befindet. "
      "Dummerweise hausen da boese Monster, deswegen hat mir bisher "
      "noch niemand Hilfe angeboten. *seufz*\n";
  
  return "Aber du hilfst mir doch schon. Hast Du den Armreif "
    "etwa noch nicht gefunden?\n";
}

nosave int biete_hilfe(string str)
{ 
  notify_fail("Wem moechtest Du Hilfe anbieten?\n");
  if(!str) return 0;

  if(str == "maedchen hilfe an" || 
     str == "menschenmaedchen hilfe an" || 
     str == "kleines maedchen hilfe an" ||
     str == "tionil hilfe an")
    {
      if(present("\narrakeenkanalitem",TP))
	return write(BSI("Aber Du hilfst mir doch schon! Gib mir einfach den "
			 "Armreif wenn Du es hast.","Das Maedchen meint: ")),1;

      write(BSI("Du willst mir wirklich helfen? Das ist wirklich "
		"aeusserst nett von Dir. Du musst versuchen den "
		"besagten Armreif in der Kanalisation zu finden und "
		"ihn mir anschliessend bringen. Dann wird der Fluch "
		"aufgehoben und ich bin endlich wieder frei. Aber sei "
		"gewarnt, da unten lauern Kreaturen von grosser Macht. "
		"Halte Dich also nach Moeglichkeit von diesen fern.",
		"Das Maedchen sagt: "));
      
      CLONE(OBJ "kanalqitem", TP);
      
      return 1;
    }
  
  return 0;
}


void give_notify(object obj)
{
  object ob;
  
  if(gotbracelet)
    {
      write(BS("Das Maedchen reagiert nicht...")+
	    BS(obj->Name()+" faellt zu Boden."));
      obj->move(MENV, M_NOCHECK);
    }
  
  if(obj->id("\narrakeenkanalarmreif"))
    {
      if(!ob=present(("\narrakeenkanalitem"),TP))
	{
	  write(BSI("Nanu? Wie kommst du denn an den? "
		    "Den muss ich jetzt beseitigen.",
		    "Das Maedchen sagt: "));

	  obj->remove(1);

	  return;
	}
      else
	{
	  obj->remove();

	  // ARMREIFGEFUNDEN WIRD IM QUESTITEM DES SPIELERS AUF 1 GESETZT
	  ob->uebergeben(0);

	  // SPIELER FUER SEQUENZ PARALYSIEREN
	  // aber nur 100 sek (fuer alle notfaelle)
	  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:100, PARALYZE_MSG:"", 
				     PARALYZE_MSG_OTHER:"", PARALYZE_END:"", 
				     PARALYZE_END_OTHER:""]));
	  // MAEDCHEN UNANSPRECHBAR MACHEN
	  SetProp(P_CHAT_CHANCE,0);

	  call_out(("seq1"), 0);
	  
	  gotbracelet=1;
	  
	  return;
	}
    }              
  else
    {
      write(BS("Das Maedchen meint: Danke, aber das brauche ich nicht.\n"));
      
      give_obj(obj, TP);
    }
}  

void seq1()
{
  //Gibts den Spieler noch?
  if(!objectp(TP)) return;
  if(!present(TP, MENV)) return;

  write("\n"+
	BS("Das Maedchen steckt den Armreif an und ploetzlich fangen der "
	   "Obelisk und die Ketten an zu gluehen.")+
	"\n");

  call_out(("seq2"), 8);
}

void seq2()
{
  //Gibts den Spieler noch?
  if(!objectp(TP)) return;
  if(!present(TP, MENV)) return;

  write(BS("Die Ketten brechen mit Getoese auseinander und das Maedchen ist "
	   "frei. Aber etwas scheint nicht zu stimmen, die Haut des "
	   "Maedchens veraendert sich und verwandelt sich in ein gruenes "
	   "Schuppenkleid. Das Maedchen kreischt unmenschlich auf.")+
	BS("Das Maedchen kreischt: AIIIIIIIIIIIIHHHHHHHHHH!")+
	"\n");

  call_out(("seq3"), 12);
}

void seq3()
{
  //Gibts den Spieler noch?
  if(!objectp(TP)) return;
  if(!present(TP, MENV)) return;

  write(BS("Die Arme des Maedchens mutieren zu riesige Klauen und vor Dir "
	   "steht jetzt kein kleines unschuldiges Maedchen mehr sondern "
	   "eine ausgewachsene Daemonin.")+
	"\n");

  call_out(("daemon1"), 10);
}

void daemon1()
{
  //Gibts den Spieler noch?
  if(!objectp(TP)) return;
  if(!present(TP, MENV)) return;

  
  write(BSI("Ah, Du sterblich"+
	    (TP->QueryProp(P_GENDER)==FEMALE ? "e Naerrin!":"er Narr!"),
	    "Die Daemonin kraechzt: "));
  
  write(BSI("Du hast mich von dem Bann befreit den dieser siebenmal verdammte "
	    "Zauberer vor einer Ewigkeit auf mich gelegt hat. Jetzt kann ich "
	    "endlich wieder diese Welt mit Angst und Schrecken ueberziehen, "
	    "Blut wird in Stroemen fliessen und die Erde wird brennen!\n"
	    "Und mit DIR werde ich beginnen. HARHARHARHAR!", 
	    "Die Daemonin kraechzt: ")+
	"\n");

  call_out(("daemon2"), 14);
}


void daemon2()
{
  object daemonin;

  //Gibts den Spieler noch?
  if(!objectp(TP)) return;
  if(!present(TP, MENV)) return;


  write(BS("Die Daemon holt mit ihren Klauen aus und laesst ihre Krallen auf "
	   "Dich heruntersausen.")+"\n\n");

  tell_room(ENV(TP), 
	    BS("Das Maedchen verwandelt sich ploetzlich in eine Daemonin und "
	       "greift "+TP->name(WER,0)+" an."), ({TP}));

  // SPIELER DEPARALYSIEREN
  TP->SetProp(P_PARALYZED, 0);

  // DAEMON CLONEN
  daemonin=clone_object(NPC "daemonin");
  daemonin->move(MENV, M_NOCHECK|M_SILENT);
  daemonin->Kill(TP);

  // MAEDCHEN ENTFERNEN 
  remove(1);  
}


