#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Narugmumie");
  SetProp(P_LONG,
	  "Eine Mumie in schwarzen Bandagen, an dessen Brust Du das "
	  "Abzeichen der Bruderschaft von Narug erkennen kannst. Ein "
	  "unheimliche intensive violette Aura umgibt die Mumie. Sie "
	  "scheint auesserst aggressiv zu sein.");
  
  SetProp(P_NAME, "Narugmumie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mumie", "narugmumie"}));
  AddClass(({CL_UNDEAD}));

  create_default_npc(18+random(4));
  
  SetProp(P_HANDS, ({
    " mit ihren kraeftigen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_BODY, 200+random(40));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160+random(50));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_AGGRESSIVE, 0.9);
  SetProp(P_REJECT, ({ REJECT_DROP, "Die Narugmumie wirft es zurueck.\n"}));
  SetProp(P_DIE_MSG, " zerfaellt zu Staub.\n");
  SetProp(P_KILL_MSG, "Ich hab deinen Willen erfuellt, Meister!\n");
  
  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([DT_FIRE:    0.5, DT_EXPLOSION:  0.3, DT_LIGHT:   0.3,
	    DT_ACID:    0.3, DT_POISON:    -1.0, DT_TERROR: -1.0,
	    DT_HOLY:    0.2, DT_UNHOLY:    -0.5, DT_MAGIC:  -0.5,
	    DT_PIERCE: -0.5 ]));
  
  SetProp(P_MSGIN, "findet hier ein Opfer");
  SetProp(P_MSGOUT, "geht# um dort neue Opfer zu finden");
  SetProp(P_MMSGIN, "findet hier ein Opfer");
  SetProp(P_MMSGOUT, "geht# um dort neue Opfer zu finden");
  

  SetProp(P_MNPC_AREA, ({
    ROOM "kanal1_2_3", ROOM "kanal1_2_2", ROOM "kanal1_2_1", 
      ROOM "kanal1_2_4", ROOM "kanal1_3_1", ROOM "kanal1_3_2", 
      ROOM "kanal1_3_4", ROOM "maskenraum", ROOM "kanal1_4_2", 
      ROOM "kanal1_4_3", ROOM "fallenraum", ROOM "kanal1_5_3", 
      ROOM "kanal1_5_4"}));
  
  SetProp(P_MNPC_WAIT, ({ 10, 20, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_MOVES);

  AddInfo(DEFAULT_INFO, "beachtet deine Frage nicht.");
  
  AddDetail(({"aura"}),
	     "Eine unheilige violette Aura umgibt die Narugmumie.");
  
  SetProp(P_SPELLRATE, 30);

  AddSpell(40,250,
	   "Die Narugumie spricht einen Fluch auf Dich.\n",
	   "Die Narugmumie spricht einen Fluch auf @WEN.\n",
	   DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));
  
  
  AddSpell(30,300,
	   "Die Narugmumie schleudert Dich gegen eine Wand.\n",
	   "Die Narugmumie schleudert @WEN gegen eine Wand.\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(20,350,
	   "Die Narugmumie wirft violettes Feuer auf Dich.\n",
	   "Die Narugmumie wirft violettes Feuer auf @WEN.\n",
	   ({DT_FIRE,DT_UNHOLY}), ([SP_SHOW_DAMAGE:0]));
  
  AddSpell(10,450,
	   "Die Narugmumie umfasst Deinen Hals und drueckt zu.\n",
	   "Das Narugskelett umfasst den Hals von @WEN und drueckt zu.\n",
	   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  CLONEME("/p/armour/amulet/amulett");
  CLONEME("/p/armour/ring/ring");

  command("trage alles");
  SUID;
}
