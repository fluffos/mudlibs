#include "../def.h"

inherit "std/food";

#include <food.h>

nosave int timeout=5+random(2);

void create()
{
  if(!is_clone(ME)) return;
  ::create(({"trinke","trink"}));

  SetProp(P_SHORT, "Ein gruener Trank");
  SetProp(P_LONG,
	  BS("Ein gruener Trank in einem kleinem Flaeschchen. "
	     "Wozu der wohl gut sein soll?"));
  SetProp(P_INFO, 
	  BS("Der Trank scheint Vergiftungen lindern zu koennen."));
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Trank");
  SetProp(P_NAME_ADJ, "gruen");
  AddId(({"trank", "gruener trank", "flaeschchen"}));
  AddAdjective(({"gruen","gruener","gruenen","gruene"}));

  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({2, 2}), 
	    F_DRINK : 5,
	    F_MSG: BS("Du trinkst den gruenen Trank und fuehlst Dich sogleich "
		      "besser."),
	    F_MSG_ROOM: "trinkt einen gruenen Trank."]));
}

void BeimEssen()
{
  if(timeout <= 2)
    AddProp(P_FOOD_INFO, ([F_HEAL : ({1, 1})]));
  
  if(!TP->AddPoison(-1-random(2)))
    write(BS("Du scheinst Deine Vergiftung ueberwunden zu haben."));
  else
    write(BS("Deine Vergiftung ist nun deutlich abgeschwaecht."));
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if(--timeout <= 0)
    call_out("weg", 10);
}

void weg()
{
  if(MENV)
    if(interactive(MENV))
      tell_object(MENV, 
		  BS("Als Du Dich umdrehst, faellt Dir ploetzlich der "
		     "gruene Trank aus der Hand und zerbricht."));
  
  remove(1);
}
