#include "../def.h"

inherit "std/thing";

nosave int uebergeben=0;

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  AddId(({"\narrakeenkanalitem"}));
  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Arrakeenkanalitem");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 1);
}

public void uebergeben()
{
  uebergeben=1;
}

public int armreifuebergeben()
{
  return uebergeben;
}

varargs int move(mixed dest, int method)
{
  mixed res;

  while(remove_call_out("try_remove")!=-1);

  res=::move(dest,method);

  if(!MENV || !living(MENV))
    call_out("try_remove",30);

  return res;
}

void try_remove() 
{
  if(!MENV || !living(MENV))
      remove();
}
