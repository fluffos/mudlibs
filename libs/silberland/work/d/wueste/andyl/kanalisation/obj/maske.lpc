#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Stoffmaske");
  SetProp(P_LONG, 
	  "Eine alte Stoffmaske in Form ein monsterhaften Fratze. Goldene "
	  "Runen wurden mit Farbe auf sie gezeichnet.\n");
  SetProp(P_NAME, "Stoffmaske");
  SetProp(P_INFO, 
	  "Diese Stoffmaske ist magisch und erlaubt den Zugang zu gewissen "
	  "magisch geschuetzten Bereichen.");
  SetProp(P_GENDER, FEMALE);
  AddId(({"stoffmaske", "maske", "\narrakeenkanalmaske"}));
  SetProp(P_MAGIC, 1);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100]));
  SetProp(P_NOBUY, 1); 
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 50);

  AddDetail(("runen"), 
	    "Die Bedeutung der Runen bleibt Dir leider verschlossen.");
}
