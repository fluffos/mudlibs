#include "../def.h"

inherit "std/food";

#include <food.h>

nosave int timeout=5+random(2);

void create()
{
  if(!is_clone(ME)) return;
  ::create(({"trinke","trink"}));

  SetProp(P_SHORT, "Ein blauer Trank");
  SetProp(P_LONG,
	  BS("Ein blauer Trank in einem kleinem Flaeschchen. "
	     "Wozu der wohl gut sein soll?"));
  SetProp(P_INFO, 
	  BS("Der Trank scheint einige Deiner Magie- und Lebenspunkte "
	     "regenerieren zu koennen."));
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Trank");
  SetProp(P_NAME_ADJ, "blau");
  AddId(({"trank", "blauer trank", "flaeschchen"}));
  AddAdjective(({"blau","blauer","blauen","blaue"}));

  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 250);
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({25, 25}), 
	    F_DRINK : 5,
	    F_MSG: BS("Du trinkst den blauen Trank und fuehlst Dich sogleich "
		      "besser."),
	    F_MSG_ROOM: "trinkt einen blauen Trank."]));
}

void BeimEssen()
{
  if(timeout <= 2)
    AddProp(P_FOOD_INFO, ([F_HEAL : ({15, 15})]));
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if(--timeout <= 0)
    call_out("weg", 10);
}

void weg()
{
  if(MENV)
    if(interactive(MENV))
      tell_object(MENV, 
		  BS("Als Du Dich umdrehst, faellt Dir ploetzlich der "
		     "blaue Trank aus der Hand und zerbricht."));
  
  remove(1);
}
