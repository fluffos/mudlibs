#include "../def.h"

inherit "std/food";

#include <food.h>

nosave int timeout=8+random(3);

void create()
{
  if(!is_clone(ME)) return;
  ::create(({"trinke","trink"}));

  SetProp(P_SHORT, "Ein dunkelblauer Trank");
  SetProp(P_LONG,
	  BS("Ein dunkelblauer Trank in einem kleinem Flaeschchen. "
	     "Wozu der wohl gut sein soll?"));
  SetProp(P_INFO, 
	  BS("Der Trank scheint ein wenig Deiner Magie- und Lebenspunkte "
	     "regenerieren zu koennen."));
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Trank");
  SetProp(P_NAME_ADJ, "dunkelblau");
  AddId(({"trank", "dunkelblauer trank", "flaeschchen"}));
  AddAdjective(({"dunkelblau","dunkelblauer","dunkelblauen","dunkelblaue"}));

  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({10, 10}), 
	    F_DRINK : 3,
	    F_MSG: BS("Du trinkst den dunkelblauen Trank und fuehlst Dich "
		      "sogleich besser."),
	    F_MSG_ROOM: "trinkt einen dunkelblauen Trank."]));
}

void BeimEssen()
{
  if(timeout <= 2)
    AddProp(P_FOOD_INFO, ([F_HEAL : ({5, 5})]));
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if(--timeout <= 0)
    call_out("weg", 10);
}

void weg()
{
  if(MENV)
    if(interactive(MENV))
      tell_object(MENV, 
		  BS("Als Du Dich umdrehst, faellt Dir ploetzlich der "
		     "dunkelblaue Trank aus der Hand und zerbricht."));
  
  remove(1);
}



