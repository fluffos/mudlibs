#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein staehlener Armreif");
  SetProp(P_LONG, 
	  BS("Ein einfacher staehlerner Armreif. Der Name \"Ureman\" ist "
	     "in seine Innenseite eingraviert worden."));
  SetProp(P_NAME, "Armreif");
  SetProp(P_INFO, 
	  BS("Diesem Armreif wohnt die Kraft inne Bannzauber und Flueche zu "
	     "brechen."));
  SetProp(P_GENDER, MALE);
  AddId(({"armreif", "reif", "staehlerner armreif", "\narrakeenkanalarmreif"}));
  SetProp(P_MAGIC, 1);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]));
  SetProp(P_NOBUY, 1); 
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);

  AddDetail(("innenseite"), 
	    "Da ist der Name \"Ureman\" eingraviert worden.\n");
}
