#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int sargzu=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "In einem unterirdischen Grab.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier in einem unterirdischen Grab. Es ist ziemlich duster "
	   +"hier jedoch dringt ein wenig Licht durch das Loch, durch welches Du hereingestuerzt "
	   +"bist. Die Luft hier drinnen ist muffig. Ein seltsamer Altar ist im Norden des Raumes zu "
	   +"sehen, und in der Mitte steht ein aufwendig verzierter Steinsarg. Es ist ausserdem "
	   +"noch sehr viel Sand in dieser Steinkammer zu finden. Ausgang ist nur leider auch "
	   +"keiner zu erkennen.\n");
  // ROOM DESCRIPTION END;

   // DETAILS START

  AddDetail(("decke"),
	    "In der Decke ist ein kleines Loch durch welches ein wenig Sonnenlicht "
	    +"faellt. Jedoch ist die Decke viel zu hoch um an dieses Loch heranzukommen.\n");
  AddDetail(("loch"),
	    "Durch dieses Loch bist Du unsanft in die Kammer geflogen, bzw. hast Du es bei "
	    +"deinem Flug verursacht.\n");
  AddDetail(("flug"),
	    "Der Flug selber war ja eigentlich ganz nett, nur der Aufprall nicht.\n");
  AddDetail(("aufprall"),
	    "Der Aufprall war nicht gerade angenehm. Dein Ruecken tut noch immer weh.\n");
  AddDetail(("ruecken"),
	    "Der schmerzt noch immer. AUA!\n");
  AddDetail(({"boden", "steinboden"}),
	    "Der Boden, duerfte ein Steinboden sein. Jedoch sieht man ihn vor "
	    +"lauter Sand fast nicht.\n");
  AddDetail(({"sand"}),
	    "Sand gibts hier drinnen massenhaft.\n");
  AddDetail(({"wand", "waende", "steinwand", "steinwaende"}),
	    "Ziemlich schaebige Steinwaende, in dessen Ritzen sich bereits einiges "
	    +"an Sand angesammelt hat. Lange halten die sicher nicht mehr.\n");
  AddDetail(({"ritzen", "ritze", "menge"}),
	    "In den Ritzen der Steinwaende hat sich schon eine Menge Sand angesammelt.\n");
  AddDetail(({"licht", "sonnenlicht"}),
	    "Ein wenig Sonnenlicht scheint noch durch das Loch in der Decke herein.\n");
  AddDetail(("luft"),
	    "Du koenntest sie ja mal reichen.\n");
  AddSmell(("luft"),
	   "Riecht ziemlich muffig. Hier hat wohl laenger keiner mehr gelueftet.\n");
  AddDetail(({"raum", "art"}),
	    "Dieser Raum scheint eine Art Grabkammer zu sein.\n");
  AddDetail(({"kammer", "grabkammer", "grab", "steinkammer"}),
	    "Du stehst hier in einer Grabkammer. So wie es aussieht "
	    +"scheint es die Grabkammer einer hohen Persoenlichkeit zu sein.\n");
  AddDetail(({"persoenlichkeit", "sicherheit"}),
	    "Hier ist mit Sicherheit eine groessere Persoenlichkeit begraben.\n"); 
  AddDetail(("altar"),
	    "In den Altar ist das Bild einer Harfe eingemeiselt.\n");
  AddDetail(({"bild", "harfe"}),
	    "Das Bild der Harfe ist ein Meisterwerk an Steinmetzkunst. "
	    +"Man koennte fast meinen es waere eine versteinerte Harfe.\n");
  AddDetail(({"meisterwerk", "steinmetzkunst", "meister"}),
	    "Dieses Meisterwerk kann nur ein begnadeter Meister der Steinmetzkunst "
	    +"geschaffen haben.\n");
  AddDetail(("ausgang"),
	    "Keiner zu entdecken.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht ein reichlich verzierter Steinsarg.\n");
  AddSpecialDetail(({"sarg", "steinsarg"}), "sargschau");
  AddSpecialDetail(("skelett"), "skelett_schau");
  AddSpecialDetail(({"sargdeckel", "deckel"}), "deckel_schau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Krabbeln eines Insekts.\n");
  AddSound(({"insekt", "krabbeln", "knirsch", "stampf"}),
	   "Krabbel, krabbel, krabbel, krabbel, STAMPF, *KNIRSCH*. Du denkst:\n"
	   +"Hehe, erwischt!\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Riecht muffig hier.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  // EXITS END
  
  
  // COMMANDS START
  AddCmd(("oeffne"), "oeffne_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

deckel_schau()
{
  if (sargzu==1) return(BS("Der Sargdeckel liegt oben auf dem Sarg.\n"));
  else return(BS("Der Sargdeckel liegt jetzt neben dem Sarg.\n"));
}


oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if ((str == "sarg" || str == "steinsarg"))
    {
      if (sargzu==1)
	{
	  write(BS("Mit einiger Anstrengung schaffst Du es den Sargdeckel "
		   +"beiseite zu schieben. Der Sarg ist nun offen.\n"));
	  sargzu=0;
	  return 1;
	}
      else
	{
	  write(BS("Der Sarg ist doch schon offen.\n"));
	  return 1;
	}
    }
  else return 0;
}
  
sargschau()
{
  if (sargzu==1)
    {
      return(BS("Ein herrlich verziehrter Sarg. Darin liegt sicher eine grosse "
	      +"Persoenlichkeit. Du koenntest den Sarg oeffnen wenn Du willst.\n"));
    }
  else
    {
      return(BS("In dem geoeffneten Sarg liegt ein Skelett. Es zahlt sich sicher aus "
		+"dieses genauer zu untersuchen.\n"));
    }
}

skelettschau()
{
  if (sargzu==1)
    {
      return(BS("In dem Sarg liegt vielleicht eines. Um es zu untersuchen musst Du "
		+"jedoch erst den Sarg oeffnen.\n"));
    }
  else
    {
      // HIER NOCH ABFRAGE EINBAUN OB BARDE MIT ERFUELLTER AUFGABE ODER NICHT...
      write(BS("Da gibts jetzt ncoh keine Beschreibung was passiern wird.\n"));
      TP->move(ROOM+"oase5", M_GO, "zum Ausgang", "laeuft", "hechtet aus einem Sandloch");
      return("");
    }
}


reset()
{
  ::reset();
  sargzu=1;
}  

















