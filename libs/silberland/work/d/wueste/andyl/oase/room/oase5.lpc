#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"


inherit "std/room";

int sandda=1;
int mantikor=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "Auf einem kleinen Huegel.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst jetzt auf einem kleinen Huegel im Nordosten "
	   +"der Oase. Die Sonne brennt hier heisser herunter als sonstwo "
	   +"auf diesem Zufluchtsort. Ausser ausgedoerrten Kakteen kannst Du "
	   +"hier keine Pflanzen entdecken. Viele Skelette von Lebewesen liegen "
	   +"hier herum, was Dich nicht gerade sonderlich froehlich stimmt. Du "
	   +"fuehlst, dass hier irgendwo eine Bedrohung lauern muss. Ein leichtes "
	   +"Gefaelle fuehrt wieder zurueck nach Westen.\n");

  // ROOM DESCRIPTION END;
  AddDetail(({"oase", "ort", "orte", "zufluchtsort", "zufluchtsorte", "teil"}),
	    "Die Oase ist eine der seltenen Zufluchtsorte in der trostlosen Wueste. "
	    +"Dieser Teil der Oase stimmt Dich jedoch nicht gerade froehlich.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint hier staerker auf Dich herunter zu brennen als anderswo "
	    +"in der Oase.\n");
  AddDetail(("himmel"),
	    "Keine Wolke ist am Himmel zu erkennen. Nur die Sonne die gnadenlos "
	    +"auf dich herab brennt.\n");
  AddDetail(({"wolke", "wolken"}),
	    "Nichts davon am Himmel zu entdecken. Jedoch ueber Deinem Kopf bildet sich "
	    +"eine kleine schwarze Wolke, da Du schon wieder so ein sinnloses Detail "
	    +"untersucht hast und nichts dafuer bekommst.\n");
  AddDetail(("detail"),
	    "Dummerweise gibt es dafuer jetzt ebenfalls nichts.\n");
  AddDetail(("kopf"),
	    "Ueber Deinem Kopf schwebt jetzt eine kleine schwarze Wolke und "
	    +"gemeinerweise faengt die nicht mal zu regnen an.\n");
  AddDetail(({"kakteen"}),
	    "Die Kakteen sind bereits braun und ausgedoerrt. Lange duerften die hier nicht "
	    +"mehr stehn.\n");
  AddDetail(("huegel"),
	    "Du stehst hier auf einem kleinen Huegel im Nordosten der Oase. Leider ist die "
	    +"Aussicht von hier nicht besonders. Ueberall nur der rotbraune Sand. Einzig der "
	    +"Teich, die Palmen und der Brunnen im Sueden heitern Dich etwas auf.\n");
  AddDetail(({"teich", "palmen", "brunnen"}),
	    "Der Teich, die Palmen und der Brunnen im Sueden sind das einzige was die "
	    +"Aussicht nicht komplett trostlos erscheinen laesst.\n");
  AddDetail(("aussicht"),
	    "Die Wueste bietet keine besonders gute Aussicht. Ueberall nur Sand.\n");
  AddDetail(("pflanzen"),
	    "Ausser den verdorrten Kakteen kannst Du keine weiteren Pflanzen entdecken. Die "
	    +"Hitze ist hier wohl einfach zu gross dafuer.\n");
  AddDetail(({"hitze", "gemuet"}),
	    "Die Hitze hier drueckt Dir ordentlich aufs Gemuet. Abgesehen davon schwitzt "
	    +"Du am ganzen Koerper.\n");
  AddDetail(("koerper"),
	    "Dein ganzer Koerper ist ueber und ueber mit Schweiss bedeckt.\n");
  AddDetail(("schweiss"),
	    "Riecht so als waer es Dein hauseigener Schweiss.\n");
  AddSmell(("schweiss"),
	   "Du riechst an dem Schweiss und denkst:\n" 
	   +"Puuhhhh, ja das ist definitiv mein Schweiss.\n");
  AddDetail(({"lebewesen", "ex-lebewesen", "ex"}),
	    "Genauer gesagt handelt es sich um Ex-Lebewesen.\n");
  AddDetail(({"skelette", "nftah", "elfen", "elf", "tier", "tiere"}), 
	    "Hier liegen Skelette von verschiedenen Tieren und auch von einem Elfen "
	    +"und einem Nftah. Die meisten Kadaver wirken irgendwie seltsam.\n");
  AddDetail(({"kadaver"}),
	    "Die Kadaver wirken alle irgendwie seltsam verrenkt und verstuemmelt, "
	    +"die duerften nicht an der Hitze gestorben sein.\n");
  AddDetail(("gefaelle"),
	    "Das Gefaelle fuehrt wieder zurueck in die Oase.\n");
  AddDetail(({"bedrohung", "hut"}),
	    "Die Bedrohung lauert hier. Nur wo? Du bleibst wohl besser auf der "
	    +"Hut.\n");
  AddDetail(("boden"),
	    "Der Boden ist ueber und ueber mit Sand bedeckt. In dem Sand kannst "
	    +"ein paar Fussspuren entdecken die jedoch abrupt enden. Ausserdem "
	    +"faellt Dir eine kleine Erhebung auf.\n");
  AddDetail(("erhebung"),
	    "Da scheint etwas unter dem Sand zu sein. Vielleicht kann man den Sand "
	    +"ja irgendwie wegwischen.\n");
  AddDetail(("sand"),
	    "Von dem hast Du in der Wueste allmaehlich genug gesehen und gespuert.\n");
  AddDetail(("wueste"),
	    "Rings um Dich hast Du genuegend Wueste.\n");
  AddDetail(({"fussspuren", "spuren", "fussspur", "spur"}),
	    "Die Spuren im Sand scheinen von einer riesigen, loewenaehnlichen "
	    +"Kreatur zu stammen. Hoffentlich begegnest Du dieser nicht.\n");
  AddDetail(("kreatur"),
	    "Dieser Kreatur moechtest Du wirklich nicht begegnen.\n");
  AddSpecialDetail(({"tuer", "steintuer"}), "tuer_schau");
  AddSpecialDetail(({"ring", "stahlring"}), "ring_schau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Grollen.\n");
  AddSound(({"grollen"}),
	   "Hmmm, jetzt ist es nicht mehr zu hoeren. Musst Dich wohl getaeuscht haben.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht seltsam hier. Jedoch kannst Du den Geruch nicht einordnen.\n");
  // DETAILS START;
  
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("westen"), ROOM+"oase4");
  // EXITS END
  
  
  // COMMANDS START 
  
  AddCmd(({"zieh", "ziehe"}), "ziehe_an");
  AddCmd(({"wisch", "wische"}), "wische_weg");
  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

ziehe_an(str)
{
 notify_fail("Woran willst Du ziehen?\n");
 if (!str) return 0;
 if (sandda==1) return 0;
 if ((str == "stahlring" || str == "an stahlring" ||
      str == "ring" || str == "ring"))
   {
     if (mantikor==1)
       {
	 write(BS("Als Du an dem Ring ziehst, hoerst Du ploetzlich ein "
		  +"lautes Krachen, die Tuer springt auf und ein "
		  +"zornentbrannter Mantikor kommt zum Vorschein.\n"));	 
	 // MANTIKOR CLONEN
	 // SPIELER ATTACKIEREN 
	 // GEMEIN SEIN *eg*
	 mantikor=0;
	 return 1;
       }
     else
       {
	 write(BS("Du ziehst an dem Stahlring jedoch nichts passiert.\n"));
	 return 1;
       }
   }
 else return 0;
}

wische_weg(str)
{
  notify_fail("Was willst Du wegwischen?\n");
  if (!str) return 0;
  if ((str=="sand" || str=="sand weg")) 
    {
      if (sandda==1)
	{
	  write(BS("Du wischt den Sand weg und legst eine "
		   +"grosse Steintuer frei.\n"));
	  sandda=0;
	  return 1;
	}
      else
	{
	  write(BS("Das brauchst Du nicht mehr zu machen.\n"));
	  return 1;
	}
    }
  else return 0;
}
	    

tuer_schau()
{
  if (sandda==1)
    {
      return("Sowas siehst Du da nicht!\n");
    }
  else
    {
      return(BS("Eine grosse Steintuer, welche in den Boden eingelassen wurde. "
		+"Ein grosser Stahlring ist daran befestigt. Vielleicht kann man "
		+"an dem ja mal ziehen?\n"));
    }
}

ring_schau()
{
  if (sandda==1)
    {
      return("Sowas siehst Du da nicht!\n");
    }
  else
    {
      return(BS("Ein grosser Stahlring der an einer Steintuer befestigt ist. "
		+"Vielleicht kann man an dem ja mal ziehen?\n"));
    }
}


reset()
{
  ::reset();
  sandda=1;
  mantikor=1; 
}  

















