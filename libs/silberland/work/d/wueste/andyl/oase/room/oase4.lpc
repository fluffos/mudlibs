#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"


inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "Eine kleine Oase.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Dieser Teil der Oase ist ziemlich unscheinbar. "
	   +"Es gibt hier nur einen verdorrten Busch und jede Menge Sand. "
	   +"Auffaellig ist auch ein seltsam suesslicher Geruch. Ansonsten "
	   +"ist es hier ziemlich ruhig. Im Sueden kannst Du den kleinen "
	   +"Teich erkennen und im Suedwesten siehst Du einige Palmen. Eine "
	   +"kleine Steigung fuehrt ausserdem auf einen kleinen Huegel im "
	   +"Osten.\n");

  // ROOM DESCRIPTION END;
  AddDetail(({"oase", "ort", "orte"}),
	    "Du befindest Dich hier auf einer kleiner Oase mitten in der "
	    +"Wueste. Solche Orte sind in der Wueste leider allzu selten.\n");
  AddDetail(("teil"),
	    "Dieser Teil der Oase ist ziemlich unscheinbar.\n");
  AddDetail(({"himmel"}),
	    "Erbarmungslos scheint die Sonne vom Himmel auf Dich herab und treibt "
	    +"Dir den Schweiss ins Gesicht.\n");
  AddDetail(({"schweiss", "gesicht"}),
	    "Viel Schweiss rinnt Dir ueber ueber Dein Gesicht. Daran ist nur "
	    +"die Sonne schuld.\n");
  AddDetail(("sonne"),
	    "Erbarmmungslos brennt die Sonne auf Dich herunter.\n");
  AddDetail(("teich"),
	    "Ein kleiner Teich befindet sich suedlich von hier.\n");
  AddDetail(({"palme", "palmen"}),
	    "Im Suedwesten kannst Du einige Palmen sehen.\n");
  AddDetail(("busch"),
	    "Der Busch ist verdorrt und bietet keinen sehr schoenen "
	    +"Anblick. Jedoch scheint da eine seltsam weissliche Stelle "
	    +"beim Busch zu sein.\n");
  AddDetail(("anblick"),
	    "Der Busch bietet wirklich keinen sehr schoenen Anblick.\n");
  AddDetail(({"menge", "unmenge"}),
	    "Hier gibt es um genau zu sein sogar Unmengen von Sand.\n");
  AddDetail(("stelle"),
	    "Als Du die Stelle genauer untersuchst, entdeckst Du ein "
	    +"vom Sand fast vollstaendig verdecktes Skelett.\n");
  AddDetail(("sand"),
	    "Davon hast Du in der Wueste schon genug gesehen.\n");
  AddDetail(("wueste"),
	    "Unueberschaubar weit erstreckt sie sich ueberall um Dich "
	    +"herum.\n");
  AddDetail(("skelett"),
	    "Es duerfte sich bei dem Skelett um einen Zwergen handeln der "
	    +"ziemlich uebel zugerichtet wurde. Viele Gliedmassen sehen "
	    +"unnatuerlich verrenkt aus und in der Schaedeldecke is ein "
	    +"grosses Loch.\n");
  AddDetail(({"zwerg", "ende"}),
	    "So wie es aussieht duerfte der Zwerg kein sehr schoenes Ende "
	    +"gefunden haben.\n");
  AddDetail(({"gliedmassen"}),
	    "Die Gliedmassen des Zwerges oder das was davon ueber ist sehen "
	    +"unnatuerlich verdreht aus.\n");
  AddDetail(({"schaedeldecke", "loch", "verletzung"}),
	    "In der Schaedeldecke des Zwerges ist ein riesiges Loch. Wer immer "
	    +"auch ihm diese Verletzung zugefuegt hat muss ueber gewaltige Kraefte "
	    +"verfuegt haben.\n");
  AddDetail(("kraefte"),
	    "Die Kraefte muessen aussergewoehnlich gewesen sein.\n");
  AddDetail(("boden"),
	    "Der Boden besteht aus dem ueberall gegenwaertigem Sand. Ein "
	    +"paar eigenartige Spuren fallen Dir auf.\n");
  AddDetail(({"spuren", "loewe", "loewen", "fussspuren"}),
	    "Es sind die Fussspuren eines sehr grossen Wesens, moeglicherweise "
	    +"die Spuren eines Loewen, jedoch passt da irgendetwas nicht zu einem "
	    +"Loewen.\n");
  AddDetail(("wesen"),
	    "Diesem Wesen moechtest Du lieber nicht begegnen.\n");
  AddDetail(("steigung"),
	    "Die Steigung fuehrt auf einen kleinen Huegel im Osten.\n");
  AddDetail(("huegel"),
	    "Die Steigung fuehrt auf den kleinen Huegel den Du im "
	    +"Osten siehst.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nur das leise Pfeifen des Windes.\n");
  AddSound(({"pfeifen", "wind"}),
	   "Du kannst ihm ja mal lauschen.\n");
  AddSound(({"pfeifen", "wind"}),
	   "Hoert sich beruhigend an.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht seltsam suesslich hier. Der Geruch scheint von "
	    "dem Busch zu kommen.\n");
  AddSmell(("busch"),
	   "Irgendetwas riecht hier faul.\n");
  // DETAILS START;
  
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("osten"), ROOM+"oase5");
  AddExit (("suedwesten"), ROOM+"oase3");
  // EXITS END
  
  
  // COMMANDS START 
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

reset()
{
  ::reset();
}  

















