#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "Eine kleine Oase.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in einer kleinen Oase "
	   +"mitten in der Wueste. Waehrend sich die Wueste rund um Dich "
	   +"in monotonem gelbrot des Sandes zeigt, ist hier ein Fleck an "
	   +"dem wenigstens etwas gruene Vegetation zu sehen ist. Im Norden "
	   +"entdeckst Du auch einen kleinen Teich und sogar ein paar Palmen "
	   +"im Nordwesten. Im Nordosten kannst Du ausserdem einen Brunnen "
	   +"sehen.\n");


  // ROOM DESCRIPTION END;
  AddDetail(({"oase", "zufluchtsort", "zufluchtsorte"}),
	    "Du befindest Dich hier auf einer Oase mitten in der Wueste. "
	    "Gut das es solche Zufluchtsorte in so eine oeden Gegend gibt.\n");
  AddDetail(("himmel"),
	    "Die Sonne brennt gnadenlos von oben auf Dich herab.\n");
  AddDetail(("sonne"),
	    "Gnade scheint die Sonne mit Dir nicht zu kennen. Der Schweiss "
	    +"rinnt der ueber den ganzen Koerper.\n");
  AddDetail(("koerper"),
	    "Ein sehr schoener Koerper wie Du findest.\n");
  AddDetail(("schweiss"),
	    "Dein ganzer Koerper ist von Schweiss bedeckt.\n");
  AddDetail(("gnade"),
	    "Fuer Dich zeigt die Sonne absolut keine Gnade.\n");
  AddDetail(("teich"),
	    "Ein Teich in dem es das lebenswichtige Wasser gibt "
	    +"liegt noerdlich vor Dir.\n");
  AddDetail(("wasser"),
	    "Du sehnst Dich richtig nach der Frische des Wassers. "
	    +"Ein Bad waere jetzt sicher sehr angenehm.\n");
  AddDetail(("frische"),
	    "Die angenehme Frische des Wassers wuerdest Du jetzt "
	    +"sicher gerne spueren.\n");
  AddDetail(("bad"),
	    "Ein Bad in dem Teich hoert sich fuer Dich sehr verlockend an.\n");
  AddDetail(({"wueste", "gegend"}),
	    "Die Wueste erstreckt sich schier endlos um Dich herum. "
	    +"Ueberall siehts Du nur den gelbroten Sand.\n");
  AddDetail(("sand"),
	    "Ueberall rund um Dich siehst Du den gelbroten Sand.\n");
  AddDetail(({"palmen", "palme"}),
	    "Die Palmen befinden sich nordwestlich von hier.\n");
  AddDetail(("fleck"),
	    "Zumindest ein kleiner Fleck in der Wueste beinhaltet "
	    +"etwas Vegetation.\n");
  AddDetail(("vegetation"),
	    "Es handelt sich dabei hauptsaechlich um struppige Buesche "
	    +"und Kakteen.\n");
  AddDetail(({"kakteen", "kaktus"}),
	    "Ganz normale Kakteen. Manche groesser, manche kleiner "
	    +"und alle mit Stacheln.\n");
  AddDetail(({"stacheln", "stachel"}),
	    "Die Stacheln sind ziemlich spitz. Du moechtest sicher "
	    +"auf keinen dieser Kakteen fallen. Das koennte ziemlich "
	    +"weh tun.\n");
  AddDetail(({"busch", "buesche"}),
	    "Die Buesche sind zwar nicht sonderlich schoen anzuschaun, "
	    +"aber immerhin bringen sie etwas Abwechslung in die monotone "
	    +"Wuestenlandschaft.\n");
  AddDetail(("abwechslung"),
	    "Abwechslung kann man in dieser oeden Gegend durchaus gebrauchen.\n");
  AddDetail(({"wuestenlandschaft", "anblick"}),
	    "Die Wuestenlandschaft bietet einen trostlosen Anblick.\n");
  AddDetail(("brunnen"),
	    "Der Brunnen im Nordosten scheint etwas besonderes zu sein. "
	    +"Den solltest Du Dir genauer ansehen.\n");
  AddDetail(("boden"),
	    "Auf dem Boden ist hauptsaechlich feiner Sand. Dazwischen siehts "
	    +"Du auch vereinzelt etwas Vegetation.\n");
  AddDetail(("ueberraschung"),
	    "Das war jetzt eine Ueberraschung, oder etwa nicht?\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst das sanfte Fluestern des Windes.\n");
  AddDetail(({"wind","fluestern"}),
	    "Der Wind fluestert Dir etwas zu, aber Du verstehst es "
	    "nicht.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht nach Oase. Welch Ueberraschung!\n");
  // DETAILS START;
  
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("nordosten"), ROOM+"oase2");
  AddExit (("nordwesten"), ROOM+"oase3");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


reset()
{
  ::reset();
}  

















