#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int sandweg=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "Eine kleine Oase.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "In diesem Teil der Oase steht ein kleiner Brunnen, "
	   +"welcher einen sehr alten Eindruck macht. Rund um Dich siehst Du "
	   +"den allgegenwaertigen gelbroten Sand der Wueste. Jedoch sind hier "
	   +"und da auch ein paar Kakteen und ein paar Straeucher. " 
	   +"Im Westen kannst Du ausserdem einen Teich und mehrere Palmen "
	   +"entdecken.\n");
  

  // ROOM DESCRIPTION END;
  AddDetail(({"oase", "einoede"}),
	    "Du bist hier in einer Oase, einem Zufluchtsort inmitten dieser "
	    +"Einoede aus Sand und Hitze.\n");
  AddDetail(({"zufluchtsort", "zufluchtsorte", "ort", "orte"}),
	    "Solche Orte sind in der Wueste leider allzu selten zu finden.\n");
  AddDetail(({"hitze", "kraefte"}),
	    "Die Hitze der Wueste zehrt doch ziemlich an deinen koerperlichen "
	    +"Kraeften.\n");
  AddDetail(("boden"),
	    "Der Boden besteht durchgehend aus dem allgegenwaertigen Sand.\n");
  AddDetail(("sand"),
	    "Davon hast du mittlerweile genug in der Wueste gesehen.\n");
  AddDetail(({"wueste", "weite"}),
	    "Rings um dich erstreckt sich die schier endlose Weite der Wueste.\n");
  AddDetail(("teil"),
	    "In diesem Teil der Oase steht ein alter Brunnen der sehr "
	    +"alt zu sein scheint. In welchem Zeitalter der wohl schon "
	    +"erbaut wurde?\n");
  AddDetail(("zeitalter"),
	    "Dieses Zeitalter muss schon sehr lange zurueckliegen, zumindest "
	    +"dem Zustand des Brunnens nach zu urteilen.\n");
  AddDetail(("eindruck"),
	    "Der Brunnen macht auf Dich den Eindruck, als ob er sehr alt waere.\n");
  AddDetail(("zustand"),
	    "Der Zustand des Brunnens laesst darauf schliessen, dass er sehr "
	    +"alt sein muss.\n");
  AddDetail(("himmel"),
	    "Der Himmel ist strahlend blau, keine Wolke ist an ihm zu sehen. "
	    +"Dafuer brennt jedoch die Sonne gnadenlos auf Dich herunter.\n");
  AddDetail(({"wolke", "wolken"}),
	    "Du kannst keine Wolken am Himmel sehen. Eigentlich schade, etwas "
	    +"Regen waere hier ein echter Segen.\n");
  AddDetail(({"segen", "regen"}),
	    "Etwas Regen waere hier ein echter Segen.\n");
  AddDetail(("sonne"),
	    "Gnadenlos brennt die Sonne auf Deine ohnehin schon sehr "
	    +"trockene Haut herunter.\n");
  AddDetail(("haut"),
	    "Du untersuchst Deine Haut und kommst zu dem Schluss, dass "
	    +"diese dringend etwas Feuchtigkeitscreme benoetigt.\n");
  AddDetail(({"creme", "feuchtigkeitscreme"}),
	    "Du scheinst keine bei Dir zu haben. Ist aber auch zu aergerlich.\n");
  AddDetail(({"schluss", "schluesse"}),
	    "Du scheinst gut im Schluesse ziehn zu sein.\n");
  AddDetail(({"brunnen"}),
	    "Es ist ein sehr alter Brunnen, welcher aus Gesteinsbrocken erbaut "
	    +"wurde. Ein kleines Schild, welches an einem Gesteinsbrocken haengt, "
	    +"faellt Dir auf.\n");
  AddDetail(({"gesteinsbrocken", "brocken"}),
	    "Der Brunnen wurde aus vielen grossen Gesteinsbrocken erbaut. "
	    +"An einem Brocken haengt ein kleines Schild.\n");
  AddDetail(("teich"),
	    "Der Teich befindet sich westlich von hier.\n");
  AddDetail(({"palmen", "westen"}),
	    "Im Westen kannst Du einige Palmen sehen.\n");
  AddDetail(({"strauch", "straeucher", "gruen"}),
	    "Die Straeucher sehen zwar nich sehr schoen aus, aber hier ist man "
	    +"ja fuer jedes Gruen dankbar, welches man entdeckt.\n");
  AddDetail(({"kakteen", "kaktus"}),
	    "Ganz normale Kakteen, gruen und mit Stacheln. Manche davon haben "
	    +"eine nicht unbeachtliche Groesse erreicht.\n");
  AddDetail(({"ohr", "ohren", "dinger"}),
	    "Mit diesen Dingern kannst Du lauschen.\n");
  AddDetail(({"haar", "haare"}),
	    "Dein Haar ist perfekt gestyled, wie immer.\n");
  AddDetail(({"nase"}),
	    "Ein angenehmer Duft dringt an deine Nase.\n");
  AddDetail(({"groesse"}),
	    "Die Groesse einiger Kakteen ist nicht unbeachtlich.\n");
  AddDetail(({"stacheln", "stachel"}),
	    "Spitze Stacheln, seeehr spitze Stacheln.\n");
  AddDetail(({"wunschbrunnen"}),
	    "Du weisst doch sicher noch wie ein Wunschbrunnen funktioniert? "
	    +"Einfach etwas Wertvolles hineinwerfen und sich etwas wuenschen.\n");
  AddDetail(({"wertvolles", "muenzen", "beispiel"}),
	    "Naja, Muenzen zum Beispiel.\n");
  AddSpecialDetail(("schild"), "schild_schau");
  AddSound( DEFAULT_SOUND,
	    "Das sanfte Saeuseln des Windes dringt an Dein Ohr.\n");
  AddSound(({"saeuseln", "wind"}),
	   "Klingt angenehm, ist jedoch voellig unverstaendlich.\n");
  AddSmell(("duft"),
	   "Du weisst zwar nicht was es ist, aber es riecht wunderbar.\n");
  AddDetail(({"wind"}),
	    "Der Wind umschmeichelt deine Ohren und faehrt durch Dein "
	    +"Haar.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Ein seltsamer jedoch angenehmer Duft dringt aus dem Brunnen zu deiner "
	    +"Nase.\n");

  // DETAILS START;
  
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("suedwesten"), ROOM+"oase1");
  // EXITS END
  
  
  // COMMANDS START
  AddCmd(({"lies", "lese"}), "lies_was");
  AddCmd(({"wirf", "werfe"}), "wirf_was");
  AddCmd(({"wische", "wische"}), "wisch_weg");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

schild_schau()
{
  if (sandweg==0)
    {
      return(BS("Auf dem Schild hat sich eine Menge Sand angesammelt. "
		+"Vielleicht solltest Du den Sand wegwischen.\n"));
	     
    }
  else 
    {
      return(BS("Du kannst etwas darauf erkennen. "
		+"Das solltest Du vielleicht lesen.\n"));
    }
}

wisch_weg(str)
{
  notify_fail("Was willst Du wegwischen?\n");
  if (!str) return 0;
  if ((str == "sand weg" || str == "sand" || str == "sand von schild" ||
       str == "sand von schild weg" ))
    {
      if (sandweg==1)
	{
	  write(BS("Das brauchst Du nicht mehr zu machen.\n"));
	  return 1;
	}
      else 
	{
	  write(BS("Du wischt den Sand von dem Schild und "
		   +"kannst jetzt etwas darauf erkennen. "
		   +"Das solltest Du vielleicht lesen.\n"));
	  sandweg=1;
	  return 1;
	}
    }
  else return 0;
}

wirf_was(str)
{
  // HIER KOMMT ALLES FUER DEN WUNSCHBRUNNEN  
}


lies_was(str)
{
  notify_fail("Was moechtest Du lesen?\n");
  if (!str) return 0;
  if (str == "schild")
    {
      if (sandweg == 0) return 0;
      else
	{
	  write("+---------------+\n"
		+"| Wunschbrunnen |\n"
		+"+---------------+\n");
	  return 1;
	}
    }
}

reset()
{
  ::reset();
  sandweg=0;
}  

















