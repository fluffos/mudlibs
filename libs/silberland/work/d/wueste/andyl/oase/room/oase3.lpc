#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_DESERT]));
  SetProp (P_INT_SHORT, "Oase mit Palmen.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Endlich siehst Du wieder ein paar Baeume in dieser "
	   +"oeden und unwirtlichen Gegend. Drei Palmen ragen vor Dir auf. Sie "
	   +"scheinen hier auf der Oase gut gewachsen zu sein. Zwar tragen sie "
	   +"keine Fruechte, aber zumindest werfen sie einen kuehlenden Schatten. "
	   +"Oestlich von Dir erblickst Du einen kleinen Teich in welchem Du baden "
	   +"koenntest.\n");


  // ROOM DESCRIPTION END;
  AddDetail(({"oase", "schoenes"}),
	    "Eine Oase ist doch immer wieder etwas sehr Schoenes."
	    "Gut, dass es in dieser unwirtlichen Gegend so etwas gibt.\n");
  AddDetail(({"himmel", "sonne"}),
	    "Gnadenlos brennt die Sonne von oben auf Dich herab. "
	    +"Gut, dass die Palmen wenigstens etwas Schatten spenden.\n");
  AddDetail(("teich"),
	    "Ein kleiner Teich mitten in der Weite der Wueste. So etwas gibt "
	    +"es nicht allzu oft. Du verspuerst den starken Drang danach ins "
	    +"hoffentlich kuehle Wasser zu springen.\n");
  AddDetail(("Weite"),
	    "So weit, so unueberschaubar weit.\n");
  AddDetail(("drang"),
	    "Du kannst ihn kaum noch unterdruecken.\n");
  AddDetail(({"wasser", "nass"}),
	    "Das Wasser laedt Dich zu einem Sprung in sein erfrischendes "
	    +"Nass ein.\n"); 
  AddDetail(("sprung"),
	    "Hoer auf unnuetze Details zu untersuchen und spring endlich in den "
	    +"Teich.\n");
  AddDetail(({"detail", "details"}),
	    "Genau so unnuetze Details wie dieses hier.\n");
  AddDetail(("baeume"),
	    "Baeume wie diese drei Palmen sind nicht gerade ein haeufiger Anblick "
	    +"in dieser ungastlichen gegend.\n");
  AddDetail(("anblick"),
	    "Ein wahrhaft seltener Anblick. Zumindest an einem Ort wie diesem.\n");
  AddDetail(({"wueste", "ort", "gegend"}),
	    "Sand, ueberall nur feuerroter Sand so weit das Auge reicht. "
	    +"Was fuer eine oede und trostlose Gegend.\n");
  AddDetail(({"auge", "augen"}),
	    "Du versuchst Dir selbst in die Augen zu sehen, schaffst dies aber "
	    +"nicht.\n");
  AddDetail(("sand"),
	    "Der Sand ist feuerrot und ist hier in einer ziemlich grossen "
	    +"Menge vertreten.\n");
  AddDetail(({"menge", "groessenordnung"}),
	    "Naja, Du weisst schon. Viel, noch mehr, unglaublich "
	    +"viel, unueberschaubar viel und noch etwas mehr. So in dieser "
	    +"Groessenordnung in etwa.\n");
  AddDetail(({"bad", "schluss"}),
	    "Nachdem Du kurz an Dir gerochen hast kommst du zu folgendem Schluss:\n "
	    +"Du brauchst SEHR dringend ein Bad!\n");
  AddDetail(({"palmen", "palme"}),
	    "Die Palmen scheinen hier trotz der unwirtlichen Gegend hervorragend "
	    +"gediehen zu sein. Fruechte kannst Du auf ihnen keine zu entdecken. "
	    +"Vielleicht versteckt sich da oben jedoch noch eine. Ob du wohl auf "
	    +"eine Palme klettern koenntest?\n");
  AddDetail(({"fruechte", "frucht"}),
	    "Es waere doch zu schoen wenn auf den Palmen Fruechte wie "
	    +"Kokosnuesse zu finden waeren.\n");
  AddDetail(({"kokosnuesse", "kokosnuss"}),
	    "Die sind lecker und nahrhaft, ausserdem wird man davon gross "
	    +"und stark. Genau das richte fuer Dich.\n");
  AddDetail(("schatten"),
	    "Schatten ist ein Geschenk des Himmels an einem derartig heissen "
	    "Ort.\n");
  AddDetail(({"geschenk", "geschenk"}),
	    "Manche Geschenke nimmt man einfach gerne an.\n");
  AddDetail(("boden"),
	    "Sand, nichts als eine grosse Menge von dem feuerrotem Sand.\n");
  AddDetail(("ohr"),
	    "Du willst Dein Ohr untersuchen, kommst jedoch darauf, dass "
	    +"Du ja zwei Ohren hast. Jetzt kannst Du Dich nicht entscheiden "
	    +"welches Ohr Du untersuchen sollst. Immer diese schwierigen "
	    +"Entscheidungen.\n");
  AddDetail(("entscheidungen"),
	    "Manche Entscheidungen sind ja auch zu schwer.\n");
  AddDetail(("ohren"),
	    "Du hast genau zwei Ohren. Dessen bist Du Dir sicher.\n");  
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nur das sanfte Fluestern des Windes.\n");
  AddDetail(({"wind","fluestern"}),
	    "Sanft umschleicht das Fluestern Dein Ohr.\n");
  AddSound(({"wind","fluestern"}),
	    "Sanft umschleicht das Fluestern Dein Ohr.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht nach Oase mit Teich und Palmen.\n");
  // DETAILS START;
  
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("nordosten"), ROOM+"oase4");
  AddExit (("suedosten"), ROOM+"oase1");
  // EXITS END
  
  
  // COMMANDS START
  AddCmd(({"kletter", "klettere"}), "kletter_auf");
  AddCmd(({"spring", "springe", "huepf", "huepfe", "bade"}), "bade_in"); 
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

kletter_auf(str)
{
  notify_fail("Auf was willst Du klettern?\n");
  if (!str) return 0;
  if ((str == "auf palme" || str == "auf palmen" ||
       str == "auf baum"  || str == "auf baeume" ))
    {
      write(BS("Du versuchst auf eine Palme zu klettern, "
	       +"rutscht aber ab und landest 'PLATSCH' im "
	       +"kuehlen Nass des Teiches.\n"));
      // DA KOMMT NOCH WAS
      return 1;
    }
  else return 0;
}

bade_in(str)
{
  notify_fail("Worin willst du baden?\n");
  if (!str) return 0;
  if (( str == "in teich" || str == "ins wasser" || str == "in wasser" ||
	str == "ins Nass" || str == "in nass" ))
    {
      write(BS("Du nimmst ein erfrischendes Bad im Teich.\n"));
      // DA KOMMT AUCH NOCH WAS
      return 1;
    }
  else return 0;
}

reset()
{
  ::reset();
}  

















