/*
  Ar-Thoas
  wasserwaechter
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "../desert.h"

#define HEAL_SELF 100

nosave int drank=0;

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Der Waechter des Wassers");
  SetProp(P_LONG, 
	  BS("Er wacht ueber das kostbarste Gut in der Wueste,"
	     "Wasser; und er ist bereit dafuer sein Leben zu lassen. "
	     "Allerdings war das seinige noch nie in Gefahr."));
  
  SetProp(P_NAME, "Wasserwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"wasserwaechter", "waechter"}));
  
  create_default_npc(40+random(6));
  
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -400);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 600, DT_BLUDGEON}));
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:   0.3, DT_COLD:      -0.1, DT_WATER:    -1.0, 
	    DT_AIR:    0.0, DT_LIGHTNING: -0.1, DT_EXPLOSION: 0.3, 
	    DT_SOUND: -0.1, DT_LIGHT:     -0.2, DT_ELECTRIC: -0.1, 
	    DT_ACID:  -0.1, DT_POISON:     0.4, DT_TERROR:   -0.2,
	    DT_HOLY:   0.0, DT_UNHOLY:     0.0, DT_MAGIC:    -0.2]));
  
  SUID;

  CLONEME(ARMOUR "sandpanzer");
  CLONEME(ARMOUR "sandstiefel");		
  CLONEME(ARMOUR "sandhose");
  command_me("trage alles");
  
  CLONEME(WEAPON "ksaebel");
  command_me("zuecke saebel");
	
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Der Waechter sagt: Lass das, ich hass das!"}));
	
  SetProp(P_SPELLRATE, 33);
  
  AddSpell(1, 999,
	   "Der Waechter oeffnet mit seinem Krummsaebel Deinen Brustkorb.\n",
	   "Der Waechter oeffnet mit seinem Krummsaebel @WESSEN Brustkorb.\n",
	   ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));
  
  /*
    AddSpell(2, 800,
    "Der Waechter schlitzt Dir den Bauch sehr tief auf.\n",
    "Der Waechter schlitzt @WEM den Bauch sehr tief auf.\n");
  */
	
  SetProp(P_DIE_MSG, " stirbt in Erfuellung seiner Pflicht.\n");
  
  AddDetail("leben",
	    "Bist Du denn bereit Dein Leben zu beenden?\n");
  AddDetail("gut",
	    "Wasser ist wohl das kostbarste Gut in der Wueste.\n");
  AddDetail("wueste",
	    "Da befindest Du Dich gerade.\n");
  AddDetail("gefahr",
	    "Vom Waechter des Wasser geht eine grosse Gefahr fuer Dein Leben aus.\n");
  AddCmd(({"trinke", "trink"}), "drink_well");
  
  AddInfo("erlaubnis",
	  "Da musst Du schon unseren Anfuehrer fragen.", "sagt: ", 1);
  AddInfo("anfuehrer",
	  "Er lebt unweit von hier in suedoestlicher Richtung.", "sagt: ", 1);
  AddInfo("richtung",
	  "Gehe einfach nach Sueden bis Du anstoesst, und schwenke dann nach Osten.", "erklaert: ", 1);
}

drink_well(string str)
{	
  notify_fail("Was oder wovon willst Du trinken?\n");
  if(!str) return 0;
  
  if(str=="wasser" || str=="aus brunnen")
    if(present("\npermission", TP))
      {
	write(BS("Der Waechter des Wassers tritt einen Schritt zur Seite und "
		 "gibt Dir den Weg zum Brunnen frei."));
	
	if(!drank)
	  {
	    TP->heal_self(HEAL_SELF);
	    write(BS("Du trinkst von dem Brunnenwasser und fuehlst "
		     "Dich sichtlich erfrischt und neu gestaerkt."));
	    drank=1;
	    return 1;
	  }
	else
	  return write(BS("Du trinkst zwar von dem Wasser kannst aber keinen "
			  "wesentlichen Unterschied zu vorher feststellen.")),1;
      }
    else
      notify_fail("Der Waechter sagt: Du hast keine Erlaubnis dazu.\n");
  return 0;
}

reset()
{
  drank=0;

  ::reset();
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
    ctime()+": "+CAP(getuid(TP))+" killt den Wasserwaechter.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": Der Wasserwaechter killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
