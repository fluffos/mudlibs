/*
  Ar-Thoas
  scorpion
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Skorpion");
  SetProp(P_LONG, 
	  BS("Ein kleiner Skorpion, der Dir mit seinem Giftstachel droht."));
  
  AddDetail(({"giftstachel", "stachel"}),
	    "Scheint als koenne er doch recht geschickt damit umgehen. "
	    "Vielleicht solltest Du Dich hueten, ihm zu nahe zu kommen.");
  	
  SetProp(P_NAME, "Skorpion");
  SetProp(P_GENDER, MALE);
  AddId(({"scorpion", "skorpion"}));
  create_default_npc(10);
  SetProp(P_SIZE, 12);
  SetProp(P_WEIGHT, 220);
  SetProp(P_ALIGN, -300);
  SetProp(P_BODY, 33);
  SetProp(P_HANDS, ({" mit seinem giftigen Stachel", 200, DT_POISON}));
  SetProp(P_MAX_HANDS, 1);
  
  SetProp(P_RACE, "Skorpion");
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  -0.2, DT_COLD:      -0.3, DT_WATER:     0.5, 
	    DT_AIR:    0.0, DT_LIGHTNING: -0.3, DT_EXPLOSION: 0.2, 
	    DT_SOUND: -0.1, DT_LIGHT:     -0.2, DT_ELECTRIC: -0.2, 
	    DT_ACID:  -0.1, DT_POISON:    -0.7, DT_TERROR:    0.0,
	    DT_HOLY:   0.0, DT_UNHOLY:     0.0, DT_MAGIC:    -0.6]));
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Der Skorpion sticht Dich in den Finger."}));
  
  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1, 300,
	   "In einem Moment der Unachtsamkeit sticht Dich der Skorpion in den "
	   "kleinen Zeh.\n",
	   "In einem Moment der Unachtsamkeit sticht @WEN der Skorpion in den "
	   "kleinen Zeh.\n", ({DT_POISON}), ([SP_SHOW_DAMAGE:1]));

  /* Wenn er stirbt soll eine besondere Meldung erscheinen. */
  SetProp(P_DIE_MSG, " laesst seinen Stachel zu Boden sinken.\n");
}
