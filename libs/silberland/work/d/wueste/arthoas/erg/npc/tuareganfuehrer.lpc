/*
  Ar-Thoas
  tuareg-anfuehrer
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "../desert.h"

int liv(object ob);

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Der Anfuehrer der Tuareg");
  SetProp(P_LONG, 
	  BS("Er sieht wahrlich erhaben und maechtig aus, wie er da so "
	     "vor Dir steht, gross gewachsen und eingehuellt in seinem "
	     "indigofarbenen Umhang. An seiner linken Seite traegt er ein "
	     "maechtiges Schwert."));
		
  set_living_name("tuareganfuehrer");
  
  SetProp(P_NAME, "Anfuehrer der Tuareg");
  SetProp(P_GENDER, MALE);
  
  AddId(({"tuareganfuehrer", "anfuehrer", "\ntanfuehrer"}));
	
  create_default_npc(40);
  
  SetProp(P_SIZE, 230);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 700, DT_BLUDGEON}));

  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  -0.3, DT_COLD:     -0.4, DT_WATER:     0.0, 
	    DT_AIR:    0.2, DT_LIGHTNING: 0.3, DT_EXPLOSION: 0.2, 
	    DT_SOUND: -0.1, DT_LIGHT:     0.1, DT_ELECTRIC: -0.2, 
	    DT_ACID:  -0.1, DT_POISON:    0.3, DT_TERROR:    0.0,
	    DT_HOLY:   0.2, DT_UNHOLY:   -0.8, DT_MAGIC:    -0.3]));
  
  SUID;
  
  //inventory
  CLONEME(ARMOUR "iumhang");
  command_me("ziehe umhang an");
  
  CLONEME(WEAPON "tsword");
  command_me("zuecke schwert");
	
  SetProp(P_REJECT, 
	  ({REJECT_KEEP, "Der Anfuehrer der Tuareg sagt: Ich erkenne Deine "
	      "Gabe an."}));
	
  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1, 600,
	   "Der Anfuehrer der Tuareg schlaegt Dir beinahe den Arm ab.\n",
	   "Der Anfuehrer der Tuareg schlaegt @WEM beinahe den Arm ab.\n", 
	   ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 500,
	   "Der Anfuehrer der Tuareg holt weit aus und die Wucht des "
	   "Schlages wirft Dich einige Meter zurueck.\n",
	   "Der Anfuehrer der Tuareg holt weit aus und die Wucht des "
	   "Schlages wirft @WEN einige Meter zurueck.\n", 
	   ({DT_EXPLOSION}));
  
  AddSpell(3, 400,
	   "Der Anfuehrer der Tuareg landet einen aeusserst gluecklichen "
	   "Treffer.\n",
	   "Der Anfuehrer der Tuareg landet einen aeusserst gluecklichen "
	   "Treffer.\n", 
	   ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));
  
  
  SetProp(P_DIE_MSG, " verflucht Dich in seinem letzten Atemzug.\n");
  SetProp(P_KILL_MSG, "Du bist kein Gegner fuer mich. Werd erstmal "
	  "erwachsen.\n");
  
  AddDetail("umhang",
	    "Eigentlich eher ein langes, wallendes, indigofarbenes Gewand.\n");
  AddDetail("gewand",
	    "Der Anfuehrer der Tuareg traegt es wie einen Umhang.\n");
  AddInfo("erlaubnis",
	  "Erlaubnis? Wofuer brauchst Du eine Erlaubnis?", 
	  "fragt: ", 1);
  AddInfo("wasser",
	  "Hm, wenn Du mich um Wasser bittest werde ich sehen, was ich fuer "
	  "Dich tun kann.", 
	  "gruebelt: ", 1);
  
  AddCmd("bitte", "beg_for_water");
}

//PERMISSION-HANDLING TO ALLOW P TO DRINK WATER FROM THE WELL
int beg_for_water(string str)
{	
  notify_fail("WEN willst Du um WAS bitten?\n");
  if(!str) return 0;

  if(str=="um wasser" || str=="um wasser aus brunnen")
    return write("WEN willst Du um Wasser bitten?\n"),1;
	
  if(str=="anfuehrer um wasser" || str=="anfuehrer um wasser aus brunnen")
    if(present("\npermission", TP))
      return write(BS("Der Anfuehrer der Tuareg sagt: Diese Bitte habe ich "
		      "Dir doch bereits gewaehrt.")),1;
    else
      {
	CLONE(OBJ "waterpermission", TP);
	  return write(BS("Der Anfuehrer der Tuareg sagt: Deine Bitte sei "
			  "Dir gewaehrt.")),1;
	}
}

//P IS ONLY ALLOWED TO KILL THE LEADER, IF ALL OTHER WARRIORS ARE DEAD
int Defend(int dam, string dam_type, int spell, object enemy)
{
  object *leute;
  int i;
  leute=filter_array(all_inventory(ENV(ME)),CLOSURE(liv));

  if(present("\ntkrieger", ENV(ME)))
    {
      SetProp(P_HP, QueryProp(P_MAX_HP)); //restore original hp
      StopHuntFor(enemy,1);
      enemy->StopHuntFor(ME,1);
      
      write(BS("Die Tuaregkrieger stellen sich schuetzend vor ihren "
	       "Anfuehrer. Es sieht so aus, als muesstest Du sie zuerst "
	       "ins Jenseits befoerdern."));
      
      for(i=sizeof(leute)-1;i>=0;i--)
	if(leute[i]->id("\ntkrieger")) leute[i]->Kill(TP);	
    }
  else 
    ::Defend(dam, dam_type, spell, enemy);
}

int liv(object ob)
{
  if(ob==TP || ob==ME || query_once_interactive(ob))
    return 0;
  return 1;
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(TP))+" killt den Tuareganfuehrer.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": Der Tuareganfuehrer killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
