inherit "std/mnpc";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

create() 
{
	if (!is_clone(this_object())) return;

	::create();

	SetProp(P_SHORT, "Ein Heldentoeter");
	SetProp(P_LONG, 
		"Der Heldentoeter irrt durch das Silberland und spuert Helden auf. "    
		"Sein Gehrin ist eine Masse die nur aus einer Gehirnzelle besteht. In dieser "
		"Zelle sitzt nur eine Information: ICH MUSS HELDEN TOETEN. ");

	SetProp(P_NAME, "Heldentoeter");
	SetProp(P_GENDER, MALE);

	set_living_name ("heldentoeter");

	AddId( ({"toeter", "heldentoeter", "\nhtoeter"}) );

	SetProp(P_SIZE, 400+random(30));
 
	create_default_npc( 35 );

	SetProp(P_ALIGN, 0);
	SetProp(P_RACE, "Heldentoeter");

	SetProp( P_REJECT, ({REJECT_DROP, "Der Toeter sagt: Das interessiert mich nicht. "+
		"Meine Bestimmung ist es Helden aufzuspueren, um sie zu Lars zu befoerdern.\n"}) );

	SetProp (P_HANDS, ({" mit seinem gesammten Gewicht", 450, DT_BLUDGEON}) );

	SetProp(P_DEFAULT_INFO, 
		"lacht und sagt: Ich MUSS Helden toeten.\n");

	SetProp(P_SPELLRATE,20);

	AddSpell(2,600, 
		"Der Toeter rammt seine Gehirnzelle in Deinen Kopf.\n",
		"Der Toeter rammt @WEN.\n",
		DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
}



