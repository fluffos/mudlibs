inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"


void get_users();


create() 
{
	if (!is_clone(this_object())) return;

	::create();

	SetProp(P_SHORT, "Ein Heldentoeter");
	SetProp(P_LONG, 
		"Der Heldentoeter irrt durch das halbe Silberland und spuert Helden auf. "    
		"Sein Gehrin ist eine Masse die nur aus einer Gehirnzelle besteht. In dieser "
		"Zelle sitzt nur eine Information: ICH MUSS HELDEN TOETEN. ");

	SetProp(P_NAME, "Heldentoeter");
	SetProp(P_GENDER, MALE);

	set_living_name ("heldentoeter");

	AddId( ({"toeter", "heldentoeter", "\nhtoeter"}) );

	SetProp(P_SIZE, 400+random(30));
 
	create_default_npc(48);
	
	SetProp(P_RESISTANCE_STRENGTHS,
	([	DT_FIRE:		 0.3, DT_COLD:			 0.4, DT_WATER:		 0.5, DT_AIR:		 0.0,
		DT_LIGHTNING:	 0.3, DT_EXPLOSION:	     0.3, DT_SOUND:		 0.1, DT_LIGHT:		 0.1,
		DT_ELECTRIC:	 0.2, DT_ACID:			 0.1, DT_POISON:	 0.4, DT_TERROR:	 0.8,
		DT_HOLY:		 0.0, DT_UNHOLY:		 0.0, DT_MAGIC:		-0.2 ]) );

	SetProp(P_ALIGN, 0);
	SetProp(P_RACE, "Heldentoeter");

	SetProp( P_REJECT, ({REJECT_DROP, "Der Toeter sagt: Das interessiert mich nicht. "+
		"Meine Bestimmung ist es Helden aufzuspueren, um sie zu Lars zu befoerdern.\n"}) );

	SetProp (P_HANDS, ({" mit seinem gesammten Gewicht", 500, DT_BLUDGEON}) );

	SetProp(P_DEFAULT_INFO, 
		"lacht und sagt: Ich MUSS Helden toeten.\n");

	SetProp(P_SPELLRATE, 3);

	AddSpell(10, 1000,
		"Der Toeter versucht Dich zu teoten.\n",
		"Der Toeter versucht @WEN zu toeten.\n",
		DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
		
		
	//string *user_array;
	//user_array = allocate(sizeof(users));
	
	//user_array = users;
		
	//write_file ("/d/ebene/lostboy/steppe/log/users_log", 
		//sprintf ("%s: %s betritt blablabla.\n", dtime(time()), users());
}


void init()
{
	::init();
	
	get_users();
}


void get_users()
{
	string *user_arr;
	user_arr = allocate(sizeof(users()));
	
	user_arr = users();
	
	write_file("/d/ebene/lostboy/steppe/log/", 
		sprintf ("%s: %s betritt blablabla.\n", dtime(time()), users());
}








