/*
  Ar-Thoas
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
	
  SetProp(P_SHORT, "El-Serachim");
  SetProp(P_LONG, 
	  BS("Der Haendler steht vermummt vor Dir, und sieht Dich mit "+
	     "erwartungsvollen Augen an, die Dir aus dem kleinen Schlitz "+
	     "entgegenblitzen."));
	
  SetProp(P_NAME, "El-Serachim");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddId(({"serachim", "el-serachim", "haendler"}));
  SetProp(P_ARTICLE, 0);
	
  create_default_npc(28);
	
  SetProp(P_WEIGHT, 66000);
  SetProp(P_ALIGN, 100);
  SetProp(P_AGGRESSIVE, 0);
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Serachim fragt: Willst Du das verkaufen?\n"}));
	
  SetProp(P_DEFAULT_INFO, "raet Dir den Moench aufzusuchen.\n");
	
  AddInfo("moench", 
	  "Er wandert irgendwo vor der Schlucht herum, "+
	  "Du bist ihm sicher schon begegnet.", 
	  "schnauzt: ");
	
  set_living_name("serachim");
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  0.2, DT_COLD:     -0.4, DT_WATER:    0.5, 
	    DT_AIR:   0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION:0.3, 
	    DT_SOUND:-0.1, DT_LIGHT:    -0.2, DT_ELECTRIC:-0.2, 
	    DT_ACID: -0.1, DT_POISON:    0.4, DT_TERROR:  -0.3,
	    DT_HOLY:  0.0, DT_UNHOLY:    0.0, DT_MAGIC:   -0.2]));
  
  SUID;

  CLONEME("/p/armour/helm/hut");
  CLONEME("/p/armour/belt/guertel");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/ring/ring");
  command_me("trage alles");
	
  SetChats(1, ({
    "El-Serachim denkt  . o 0 (Aaah! Dir dreh ich jetzt den "+
      "allerletzten Ramsch an)\n",
      "El-Serachim verneigt sich vor Dir und fragt: Was kann ich fuer "+
      "Euch tun?\n",
      "El-Serachim preist voller Stolz seine Waren an.\n"}) );
  
  AddDetail(({"augen","auge"}),
	    "Sie sind die einzigen Stellen an El-Serachim, die nicht mit einem "+
	    "Kleidungsstueck bedeckt sind.\n");
  AddDetail(({"kleidung", "kleidungsstueck", "stueck"}),
	    "Hm...bist Du nicht eigentlich hier, weil Du etwas kaufen wolltest?\n");
  AddInfo(({"ramsch"}),
	  "Aber nein! Ich verkaufe nur Waren der allerbesten Qualitaet! ",
	  "antwortet: ");
  AddInfo(({"qualitaet"}),
	  "Richtig! Nur das feinste vom Feinsten biete ich zum Verkauf an. ",
	  "nickt und sagt: ");
  AddInfo(({"ware", "waren", "feinsten", "verkauf", "kleidung", "kleidungsstueck", 
	      "kauf"}),
	  "zeigt auf die Tafel, die an einer Wand haengt.\n");
  AddInfo(({"sortiment"}),
	  "verweist Dich auf die Tafel an der Wand.\n");
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
    ctime()+": "+CAP(getuid(TP))+" killt El-Serachim.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": El-Serachim killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
