/*
  arth
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create() 
{
  if(!is_clone(ME)) return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Ratte");
  SetProp(P_LONG, 
	  BS("Die Ratte ernaehrt sich scheinbar von den Resten, die ihr der "
	     "Wuestenfuchs ueber laesst. Sie hat einen langen spitzen "
	     "Schwanz und kleine scharfe Zaehne."));

  SetProp(P_NAME, "Ratte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "klein");

  AddId(({"ratte", "rat"}));

  SetProp(P_SIZE, 30);

  create_default_npc(6);

  SetProp(P_ALIGN, 100);
  SetProp(P_RACE, "Ratte");
  SetProp(P_REJECT, ({ REJECT_DROP, "Die Ratte wirft @WAS kommentarlos weg.\n" }));
  SetProp (P_HANDS, ({" mit ihren scharfen Zaehnen", 60, DT_BLUDGEON}));
  SetProp(P_DEFAULT_INFO, "schaut Dich fragend an.\n");
}



