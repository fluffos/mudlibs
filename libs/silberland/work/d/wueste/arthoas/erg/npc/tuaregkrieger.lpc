/*
  Ar-Thoas
  tuareg-krieger
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Krieger der Tuareg");
  SetProp(P_LONG, 
	  BS("Der Krieger sieht aus, als wuerde er jeden Angreifer "
	     "kurzerhand vernichten. Seine Augen blitzen durch den "
	     "schmalen Spalt des indigofarbenen Litham.\n"));
  
  SetProp(P_NAME, "Tuaregkrieger");
  SetProp(P_GENDER, MALE);
  AddId(({"tuaregkrieger", "krieger", "\ntkrieger"}));
	
  create_default_npc(30+random(3));
  SetProp(P_LEVEL, 35);
  
  SetProp(P_SIZE, 195+random(10));
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 500, DT_BLUDGEON}));
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:   0.2, DT_COLD:      -0.2, DT_WATER:     0.2, 
	    DT_AIR:    0.0, DT_LIGHTNING: -0.3, DT_EXPLOSION: 0.3, 
	    DT_SOUND: -0.1, DT_LIGHT:      0.0, DT_ELECTRIC: -0.2, 
	    DT_ACID:  -0.1, DT_POISON:     0.4, DT_TERROR:   -0.2,
	    DT_HOLY:   0.0, DT_UNHOLY:     0.0, DT_MAGIC:     0.3]));
  
  SUID;

  //inventory
  CLONEME(ARMOUR "sandpanzer");
  CLONEME(ARMOUR "sandhose");
  CLONEME(ARMOUR "litham");
  CLONEME(ARMOUR "sandstiefel");
  CLONEME(ARMOUR "iumhang");
  command_me("trage alles");
  
  CLONEME(WEAPON "sword");
  command_me("zuecke schwert");
  
  SetProp(P_REJECT, ({REJECT_DROP, " "}));
  
  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1, 600,
	   "Der Krieger attackiert Dich mit einer geheimen Technik der "
	   "Tuareg.\n",
	   "Der Krieger attackiert @WEN mit einer geheimen Technik der "
	   "Tuareg.\n", 
	   ({DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  /*
    AddSpell(2, 300,
    "Der Krieger oeffnet mit seinem Krummsaebel Deinen Brustkorb.\n",
    "Der Krieger oeffnet mit seinem Krummsaebel @WESSEN Brustkorb.\n", 
    ({DT_PIERCE}));
  */	

  SetProp(P_DIE_MSG, 
	  " sinkt zu Tode getroffen zu Boden und haucht sein Leben aus.\n");
  
  AddDetail("krieger",
	    "Er hat noch niemals zuvor einen Kampf verloren.\n");
  AddDetail("kampf",
	    "Lass es lieber, falls Dir Dein Leben lieb ist.\n");
  AddDetail("augen",
	    "Bedrohlich funkeln sie Dich an.\n");
  AddDetail(({"spalt", "litham", "schleier", "kopf", "gesicht"}),
	    "Kopf und Gesicht sind mit einem indigofarbenen Schleier bedeckt, den die "
	    "Tuareg 'Litham' nennen. Bloss ein schmaler Spalt laesst die Augen frei. "
	    "Er ist das besondere Kennzeichen der Krieger.\n");
  AddDetail("kennzeichen",
	    "Der Litham kennzeichnet die Krieger unter den Tuareg, wobei besonderen Wert "
	    "darauf gelegt wird, dass sein Stoff glaenzend, streifig und abfaerbend ist, "
	    "das auch den blauen Schimmer ihrer Haut erklaert.\n");
  AddDetail(({"schimmer", "haut"}),
	    "Ihre Haut hat einen indigofarbenen Schimmer, der wohl daher ruehrt, dass der "
	    "Litham abfaerbt.\n");
}

void die(int dead)
{
  object ob;
  
  if(ob=present("litham", ME))
    ob->remove();
  
  KILLMASTER->register_npc_death(TP);

  ::die(dead);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);
      
      write_file(LOG "playerdeath",
		 ctime()+": Ein Tuaregkrieger killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}

void init()
{
  ::init();
  
  if(TP && TP->id("\ntkrieger"))
    AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
