/*
  Ar-Thoas
  Leopard -Schlucht
*/

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

inherit MOST "mynpc";

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Leopard");
  SetProp(P_LONG, 
	  BS("Ein wirklich gewaltiges Exemplar eines Maennchens. Du schaetzt " 
	     "seine Laenge auf etwas mehr als 2m. Sein Fell ist auf der "
	     "Oberseite gelbbraun, auf der Unterseite weisslich. Seine "
	     "typischen Merkmale sind die schwarzen Flecken und Rosetten, "
	     "und natuerlich seine schwarze Schwanzspitze."));
  	
  SetProp(P_NAME, "Leopard");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));

  SetProp(P_RACE, "Wildkatze");
  
  AddId(({"leopard","NOWIMPY", "\narthoas_leopard"}));
  
  create_default_npc(20);
  
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, -200-random(200));
  SetProp(P_BODY, 66);
  SetProp(P_SIZE, 120);
  SetProp(P_HANDS, 
	  ({" mit seinen gefletschten Zaehnen", 500, DT_RIP}));
  SetProp(P_MAX_HANDS, 4);

  /*
    SetProp(P_RESISTANCE, ({ DT_FIRE, DT_LIGHTNING, DT_COLD }));
    SetProp(P_VULNERABILITY, ({ DT_LIGHT }));
  */

  SetProp(P_AGGRESSIVE, 0.02);
  SetProp(P_REJECT, 
	  ({REJECT_KEEP, 
	      "DAS wirst Du sowieso nicht mehr brauchen, wenn Du tot bist."}));

  SetAttackChats(33, ({"Der Leopard zerfleischt Dich.\n",
			 "Der Leopard faucht Dich an.\n"}) );

  SetProp(P_NOMAGIC, 10);

  SetChats(12, ({
    "Der Leopard umkreist Dich zaehnefletschend.\n",
      "Der Leopard blickt Dich hungrig an.\n",
      "Der Leopard verharrt in einer erwartenden Position.\n",
      "Der Leopard bruellt Dich derart an, dass Dein Blut fast zu stocken beginnt.\n"
      }));

  SetProp(P_DEFAULT_INFO, 
	  "knurrt Dich an, als wolle er Dir etwas sagen, aber " 
	  "leider verstehst Du nichts.\n");

  SetProp( P_DIE_MSG, " bruellt ein letztes Mal und stirbt.\n" );

}

void die(int pd) 
{
  KILLMASTER->register_npc_death(QueryProp(P_KILLER)||TP);

  ::die(pd);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    KILLMASTER->register_player_death(player, lxp);

  ::NotifyPlayerDeath(player, killer, lxp);
}

