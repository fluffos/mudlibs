/*
  Ar-Thoas
  Lanner - Greifvogel
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Lanner");
  SetProp(P_LONG, 
	  BS("Ein derart grosses Exemplar eines Greifvogels hast Du Dein Leben lang "
	     "noch nicht gesehen."));
  
  AddDetail(({"exemplar", "greifvogel", "vogel"}),
	    "Wow! Er ist wahrlich gewaltig.");
  AddDetail("krallen",
	    "Sie sehen aus, als koennten sie Deinen Koerper problemlos "
	    "aufschlitzen.");
    	
  SetProp(P_NAME, "Lanner");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Vogel");
  AddId(({"greif","greifvogel","lanner"}));
  create_default_npc(24);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, -200);
  SetProp(P_BODY, QueryProp(P_BODY)+66);
  SetProp(P_HANDS, ({" mit seinen toedlichen Krallen an", 200, ({DT_MAGIC,DT_RIP})}));
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:     -0.3, DT_COLD:     -0.3, DT_AIR:  -0.5,
	    DT_LIGHTNING:-0.3, DT_EXPLOSION: 0.3, DT_SOUND: 0.1, 
	    DT_LIGHT:    -0.3, DT_ELECTRIC: -0.2, DT_ACID: -0.1, 
	    DT_POISON:    0.4, DT_TERROR:    0.2, DT_MAGIC:-0.6]));
  
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_REJECT, ({REJECT_KEEP, "DAS wirst Du sowieso nicht mehr brauchen, "
			"wenn Du tot bist.\n"}));

  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1, 420,
	   "Der Lanner kreischt Dich an.\n",
	   "Der Lanner kreischt @WEN an.\n", 
	   ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 666,
	   "Der Lanner hackt auf Deinen Kopf ein.\n",
	   "Der Lanner hackt auf @WESSEN Kopf ein.\n", 
	   ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(33, 
		 ({"Der Lanner stuerzt sich auf Dich herab.\n",
		     "Der Lanner schuechtert Dich mit seinen Schwingen ein.\n"}));  

  SetProp(P_DIE_MSG, " fliegt mit letzter Kraft zurueck in den Greifenhorst.\n");
  SetProp(P_NOCORPSE, 1);
}

void die(int pd)
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt den Lanner.\n");

  KILLMASTER->register_npc_death(TP);

  ::die(pd);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    {
      KILLMASTER->register_player_death(player, lxp);
      
      write_file(LOG "playerdeath",
		 ctime()+": Der Lanner killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
