/*
  Ar-Thoas
  Oryx - Saebelantilope
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Oryx");
  SetProp(P_LONG, 
	  BS("Eine Saebelantilope mit der wohl schoensten Zeichnung "
	     "ueberhaupt. Wie Du nun richtig vermuten wirst, traegt sie "
	     "ihren Namen nicht ohne Grund. Ihr Haupt zieren 1.20m lange "
	     "Hoerner, die mitnichten harmlos aussehen. Vielmehr noch "
	     "stellen sie eine grosse Gefahr dar, selbst fuer den "
	     "erfahrensten Abenteurer."));
  
  AddDetail(({"antilope", "saebelantilope"}),
	    "Unter Raubtieren gilt sie als Delikatesse. Besonders die "
	    "kraeftigen Hinterlaeufe.");
  AddDetail(({"leopard", "leoparden"}),
	    "*Aechz* nochmal Glueck gehabt, scheint keiner da zu sein.");
  AddDetail(({"horn", "hoerner"}),
	    "Die Hoerner sind fast 1,20m lang, leicht nach hinten gebogen und "
	    "gerillt. Die Rillen erinnern Dich an Blutrinnen, wie sie "
	    "maechtige Schwerter haben.");
  AddDetail(({"delikatesse", "hinterlaeufe", "hinterlauf"}),
	    "Waerst Du eine Raubkatze, so wuerde Dir der Gedanke daran das "
	    "Wasser im Mund zusammenlaufen lassen. Vielleicht solltest Du "
	    "sicherheitshalber einen Hinterlauf abtrennen, und mitnehmen, "
	    "schliesslich kann man ja nie wissen, ob man ihn in naher "
	    "Zukunft noch brauchen koennte.");
  
  SetProp(P_NAME, "Oryx");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Antilope");
  
  AddId(({"oryx", "NOWIMPY"}));
  
  create_default_npc(9);
  
  SetProp(P_WEIGHT, 220000);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 36);
  SetProp(P_HANDS, ({" mit ihren Hoernern", 200, DT_PIERCE}));
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:   0.2, DT_COLD:      -0.4, DT_WATER:     0.5, 
	    DT_AIR:    0.0, DT_LIGHTNING: -0.3, DT_EXPLOSION: 0.3, 
	    DT_SOUND: -0.1, DT_LIGHT:      0.0, DT_ELECTRIC: -0.2,
	    DT_ACID:  -0.1, DT_POISON:     0.4, DT_TERROR:   -0.3,
	    DT_HOLY:   0.0, DT_UNHOLY:     0.0, DT_MAGIC:    -0.1]));
  
  /*
    VERY IMPORTANT 'CAUSE THERE'S NO LIMITATION ON HOW MUCH CAN AN ORYX BE 
    CLONED!!! WHICH IS NECESSARY TO ENSURE PLAYERS CAN PASS THE LEOPARD IN 
    THE RAVINE!!!
  */
  SetProp(P_XP, 0); 

  SetProp(P_REJECT, ({REJECT_KEEP, "Die Oryx sieht Dich treuherzig an. "}));

/* Wenn sie stirbt soll eine besondere Meldung erscheinen. */
  SetProp(P_DIE_MSG, " faellt zu Boden.\n");
  SetProp(P_CORPSE, OBJ "deadoryx");
}
