/*
  arth
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  AddId(({"sklavenarbeiter","arbeiter", "\nslave", "Axtkaempfer"}));
 
  SetProp(P_GENDER, MALE);
  
  SetProp(P_RACE, "Mensch");
  
  SetProp(P_NAME, "Sklavenarbeiter");
  SetProp(P_SHORT, "Ein Sklavenarbeiter");
  
  SetProp(P_LONG, 
	  BS("Der Sklavenarbeiter ist ein hartgesottener Bursche, dem das "
	     "Leben bisher nicht viel geschenkt hat."));
  
  create_default_npc(19);
  
  SetProp(P_ALIGN, 400);
  SetProp(P_SIZE, 170);  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit wundgeschundenen Haenden", 190, DT_BLUDGEON}));
  
  SUID;
  
  CLONEME("/p/weapon/axe/spitzhacke");
  command_me("zuecke spitzhacke");
  
  CLONEME("/obj/fackel");
  
  SetAttackChats(30,({
    "Der Sklavenarbeiter versteht die ganze Aufregung garnicht.\n",
      "Der Sklavenarbeiter fleht Dich um Gnade an.\n"}));
  
  SetChats(3,({
    "Der Sklavenarbeiter bricht unter der gewaltigen Anstrengung zusammen.\n",
      "Der Sklavenarbeiter bearbeitet unaufhoerlich Fels.\n",
      "Der Sklavenarbeiter schwitzt sich die Seele aus dem Leib.\n"}));
  
  SetProp(P_DIE_MSG, " ist endlich aus seiner Versklavung befreit.\n");
  
  SetProp(P_DEFAULT_INFO,
	  "darf auf Anordnung des Sklavenaufsehers nicht mit Dir sprechen.\n");

  SetProp(P_REJECT,
	  ({REJECT_DROP,
	      "Der Sklavenarbeiter sagt: Schon am ersten Tag haben sie uns im "
	      "wahrsten\n"
	      "Der Sklavenarbeiter sagt: Sinne des Wortes eingeblaeut, dass "
	      "wir kein\n"
	      "Der Sklavenarbeiter sagt: Eigentum haben duerfen.\n"}));
}
