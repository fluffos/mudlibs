/*
  Ar-Thoas
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include "../desert.h"

//#define NPCMASTER VALLEY+ "npc_master"
#define NPCMASTER "/d/wueste/arthoas/erg/room/valley/npc_master"

create()
{
  if (!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Sandwesen");
  SetProp(P_LONG, 
	  BS("Das Sandwesen sieht Dich voller Wut, aus seinen hasserfuellten, "
	     "blutrot funkelnden Augen an. Es scheint vollstaendig aus "
	     "reinem Sand zu bestehen."));
  
  SetProp(P_NAME, "Sandwesen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_RACE, "Sandwesen");
  
  AddId(({"sandwesen", "wesen", "sandcreature"}));
  
  create_default_npc(24);
	
  SetProp(P_SIZE, 320);
  SetProp(P_WEIGHT, 22000);
  SetProp(P_ALIGN, -400);
  SetProp(P_AGGRESSIVE, 1);
  
  SetProp(P_REJECT,
	  ({REJECT_DESTRUCT, "Das Sandwesen zerstoert voller Wut @WEN!\n"}));
	
  SetProp(P_DEFAULT_INFO, 
	  "versucht etwas zu sagen, staubt aber bloss aus seinem Mund.\n");
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:-0.3, DT_COLD:-0.4, DT_WATER:0.6, 
	    DT_AIR:0.0,	DT_LIGHTNING:-0.3, DT_EXPLOSION:0.3,
	    DT_SOUND:-0.1, DT_LIGHT: 0.0, DT_ELECTRIC:-0.2,
	    DT_ACID:-0.1, DT_POISON:-0.4, DT_TERROR:-0.3,
	    DT_HOLY:0.0, DT_UNHOLY:0.0, DT_MAGIC:-0.6]));
  
  SUID;
  
/*
  clone_object("/p/armour/schuerze") -> move(this_object());
  command_me("ziehe schuerze an");
  
  clone_object("/p/armour/rock_kurz") -> move(this_object());
  command_me("ziehe rock an");
  
  clone_object("/p/armour/bluse") -> move(this_object());
  command_me("ziehe bluse an");

  set_living_name("sandcreature");
*/
  
  NPCMASTER->add_npc();
}

remove(int arg)
{
  if(is_clone(ME)) NPCMASTER->remove_npc();

  ::remove(arg);
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
    ctime()+": "+CAP(getuid(TP))+" killt eine Sandkreatur.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": Eine Sandkreatur killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
