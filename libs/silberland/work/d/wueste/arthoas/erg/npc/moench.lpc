/*
  Ar-Thoas
  Moench - mnpc on path (raum01 - raum08)
  holds information about ravine...and the QUEST <free the lost souls> 
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../desert.h"

#define MIN_LEVEL 60    //set for testing...must be set in +wueste/arthoas/room/path/gate2hell.c too!!!!!!!!!!!!

string quest_legend(string str);
string dark_lord(string str);
string lost_souls(string str);
string thy_soul(string str);
string last_chance(string str);
string dragon_scale(string str);
string holy_sword(string str);
string holy_shield(string str);
string amulet_of_faith(string str);

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Moench");
  SetProp(P_LONG, 
	  BS("Der Moench scheint eine lange Reise hinter sich zu haben, "
	     "seit er sein Kloster verliess."));
  
  set_living_name("moench");
  
  SetProp(P_NAME, "Moench");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddId("moench");
  create_default_npc(35);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_BODY, QueryProp(P_BODY)+44);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOATTACK, 1);

  SetProp(P_MSGOUT, "missioniert weiter");
  SetProp(P_MSGIN, "missioniert herein");

  SetProp(P_REJECT, 
	 ({REJECT_KEEP, "Der Moench nickt anerkennend und erteilt Dir die "
	      "Absolution.\n"}));

  SetProp(P_DEFAULT_INFO, 
	 ({"betet dreimal den Rosenkranz.\n",
	      "laechelt Dich freundlich an.\n",
	      "sagt: Stoer mich nicht, wenn ich meditiere!\n"}));

  set_living_name("moench");
	
  SetProp(P_MNPC_CMDS, 
	 ({"nordostoben", "norden", "nordostoben", "norden", "nordostoben", 
	      "osten", "osten", "westen", "westen", "suedwestunten", 
	      "sueden", "suedwestunten", "sueden", "suedwestunten"}));
  
  SetProp(P_MNPC_WAIT,({ 60, 90, 90}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "raum01");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_CMDS+MOV_MAYLOAD);

  SUID;

  CLONEME(ARMOUR "mkutte");
  command_me("ziehe kutte an");

  CLONEME(WEAPON "wstab");
  command_me("zuecke stab");

  CLONEME(OBJ"bibel");
  
  SetChats(1,({
    "Der Moench richtet seinen Blick 'gen Himmel.\n"
      "Der Moench ruft: Oh, ich danke Dir guter Gott!\n"
      "Der Moench grummelt: In der Schlucht habe ich beinahe mein Leben verloren.\n",
      "Der Moench murmelt: Ich muss die anderen warnen.\n"}));
  
  AddInfo("schlucht", 
	  "Bleibe dem Ort lieber fern, dort lauert die Gefahr. Ich wanderte "
	  "durch die Schlucht, aber ich habe nur durch viel Glueck ueberlebt.", 
	  "warnt Dich: ", 1);
  AddInfo("ort", 
	  "Ich spreche von der Schlucht natuerlich! Sag einmal hoerst "
	  "Du mir ueberhaupt zu???", 
	  "stutzt: ", 1);
  AddInfo(({"gefahr", "glueck", "leopard"}), 
	  "Ja, ich hatte Glueck, denn ich hatte zufaellig ein Stueck Fleisch "
	  "bei mir.", 
	  "sagt: ", 1);
  AddInfo("fleisch", 
	  "Es war das zarte Fleisch einer Antilope.", 
	  "fluestert: ", 1);
  AddInfo("stueck", 
	  "Ach, was Stueck...pah! Ich hab ihr einfach einen Hinterlauf "
	  "abgeschnitten.", 
	  "fluestert Dir ins Ohr: ", 1);
  AddInfo("antilope", 
	  "Hm...ich glaube, ich habe heute auf meinem Weg eine gehoert. Aber "
	  "wo genau das war kann ich Dir leider nicht mehr sagen.", 
	  "ueberlegt: ", 1);
  AddInfo("moench", 
	  "Normalerweise leben meinesgleichen in Kloestern und studieren die "
	  "heilige Schrift.", 
	  "sagt: ", 1);
  AddInfo(({"kloster", "schrift"}), 
	  "Oh ja, natuerlich habe ich sie studiert. Ich wage sogar zu "
	  "behaupten, dass ich ein wahrer Kenner der heiligen Schrift bin.", 
	  "bebt: ", 1);
  AddInfo(({"friedhof","elefantenfriedhof","raetsel"}),
	  "Du musst das Raetsel des Elefantenfriedhofes ganz alleine loesen! Es "
	  "wird Dir niemand dabei helfen koennen!",
	  "sagt: ");        

  /*
    quest-info
  AddInfo("hilfe", 
	  "Nein, Ich brauche Deine Hilfe nicht, ich komme schon sehr gut allein "
	  "zurecht, aber vielleicht, wenn Du mutig bist, wuerdest Du ja kurz mal "
	  "in einer idle-freien Minute den verlorenen Seelen helfen wollen? Wenn "
	  "dem so ist, gib einfach <hilf seelen> ein.", 
	  "antwortet: ", 1);
  */
  
  AddInfo("legende", CLOSURE(quest_legend), "erzaehlt: ", 1);
  AddInfo(({"satan", "teufel", "fuerst"}), CLOSURE(dark_lord), "warnt Dich: ", 1);
  AddInfo("seelen", CLOSURE(lost_souls), "sagt: ", 1);
  AddInfo("seele", CLOSURE(thy_soul), "meint: ", 1);
  AddInfo(({"chance", "funken"}), CLOSURE(last_chance), "ist sich sicher: ", 1);
  AddInfo("schuppenkleid", CLOSURE(dragon_scale), "ueberlegt: ", 1);
  AddInfo("schwert", CLOSURE(holy_sword), "murmelt: ", 1);
  AddInfo("schild", CLOSURE(holy_shield), "sagt: ", 1);
  AddInfo("amulett", CLOSURE(amulet_of_faith), "fluestert: ", 1);
  
  //	AddCmd(({"hilf", "helfe"}), "help_souls");
  //	AddCmd("beschwoere", "call_devil");
}

int help_souls(string str)
{
  int pl_lev, lev_diff;
  object ob;
  
  notify_fail("Der Moench sagt: Du scheinst sehr hilfsbereit zu sein, aber "
	      "moeglicherweise\nDer Moench sagt: solltest Du auch sagen wem "
	      "Du helfen moechtest?\n");
  if(!str) return 0;

  pl_lev = this_player()->QueryProp(P_LEVEL);
  
  lev_diff = MIN_LEVEL - pl_lev;
  
  if(str=="moench")
    return write("Der Moench sagt: Ich weiss Diese Geste zu schaetzen, aber "
		 "glaube mir, ich\nDer Moench sagt: brauche wirklich keine "
		 "Hilfe.\n"),1;

  if(((str=="seelen")||(str=="verlorenen seelen")))
    if(present("\nfree_souls", TP))
      return write("Der Moench sagt: Du hilfst den verlorenen Seelen doch schon..."
		   "weisst Du das\nDer Moench sagt: nicht mehr?\n"),1;
    else
      {
	if(pl_lev >= MIN_LEVEL)
	  {
	    CLONE(OBJ"free_souls",TP);
	  
	  write("Der Moench sagt: Nun denn, so soll es sein. Du solltest wissen, dass ER es ist,\n"
		"Der Moench sagt: der sie gefangen haelt. Ich stiess beim Studium der Heiligen\n"
		"Der Moench sagt: Schrift auf diese Legende. Und ER ist es, den es zu vernichten\n"
		"Der Moench sagt: gilt...nur so werden die Seelen fuer immer frei sein.\n");
	  return 1;
	}
      else
	switch(lev_diff)
	  {
	  case 1:
	    write("Der Moench sagt: Glaube mir, dieser Aufgabe bist Du bei Gott noch nicht\n"
		  "Der Moench sagt: gewachsen. Schau doch einfach ein wenig spaeter wieder vorbei.\n");
	    return 1;
	    break;
	    
	  case 2 .. 4:
	    write("Der Moench sagt: Glaube mir, dieser Aufgabe bist Du bei Gott noch nicht\n"
		  "Der Moench sagt: gewachsen. Schau doch einfach einige Zeit spaeter wieder\n"
		  "Der Moench sagt: vorbei...wenn Du so 2 bis 4 Stufen gestiegen bist.\n");
	    return 1;
	    break;
	    
	  case 5 .. 7:
	    write("Der Moench sagt: Glaube mir, dieser Aufgabe bist Du bei Gott noch nicht\n"
		  "Der Moench sagt: gewachsen. Schau doch einfach viel spaeter wieder\n"
		  "Der Moench sagt: vorbei...wenn Du so 5 bis 7 Stufen gestiegen bist.\n");
	    return 1;
	    break;
	    
	  default:
	    write("Der Moench sagt: Och, lass mal lieber. Komm doch einfach wieder, wenn\n"
		  "Der Moench sagt: Du Dich bei etwas kleineren Aufgaben bewaehrt hast.\n");
	    return 1;
	    break;
	  }
    }
  else
    if(((str=="seelen")||(str=="verlorenen seelen"))&&(present("\nfree_souls", TP)))
      {

      }
}

string quest_legend(string str)
{
	if(present("\nfree_souls", TP))
		return "ER stammt nicht von dieser Welt und doch vermag ER dort zu wandeln. "
			"Wahnsinn folgt IHM wie eine Seuche, und nie duerft Ihr versuchen IHN "
			"zu rufen, denn ER lauert in der anderen Welt auf das Zeichen eines "
			"Eingangs. ER ist der Herr des Blutes, und sein ist ein Teil des "
			"Totenreiches. Wie ein Dieb in der Nacht kommet ER und breitet seinen "
			"Schatten ueber die Staedte. Verstohlen und heimlich ist SEIN Wirken, doch "
			"Koenigreiche zerbrechen unter SEINEM unhoerbaren Schritt.";
	
	return "Legende? WER hat Dir von einer Legende erzaehlt?";
}

	
string dark_lord(string str)
{
	if(present("\nfree_souls", TP))
		return "Nein, nein, um Gottes Willen. Das waere Dein sicherer "
			"TOD. Glaube mir Du haettest vermutlich nicht den Funken einer "
			" Chance, er wuerde Dich auf der "
			"Stelle toeten. Andererseits...wenn Du meinst...so versuche Dein "
			"Glueck und beschwoere ihn.  Ich hoffe nur, dass es jemanden geben "
			"wird, der an Deinem Grab um Dich weint.";
	
	return "Es ist verdammt wichtig, ihn zu meiden.";
}


string lost_souls(string str)
{
	if(present("\nfree_souls", TP))
		return "Finde IHN und es wird sich alles fuegen, so wie es vom Schicksal "
			"vorbestimmt ist.";
	
	return "Sie werden von IHM gefangen gehalten, mehr brauchst Du zu dieser "
			"Stunde noch nicht zu wissen. Aber sei gewarnt, nur die staerksten Helden "
			"werden in ihrer Mission erfolgreich sein.";
}


string thy_soul(string str)
{
	if(present("\nfree_souls", TP))
		return "Geh behutsam vor, denn auch Deine Seele ist in Gefahr. In seinem Reich "
			"ist ER noch um ein Vielfaches maechtiger als in unserer Welt.";
			
	return "Sei beruhigt, Deine Seele ist nicht in Gefahr, wieso sollte sie auch?";
}


string last_chance(string str)
{
	if(present("\nfree_souls", TP))
		return "Hm...wenn ich ehrlich bin faellt mir da doch noch etwas ein, und "
			"zwar berichtet die Legende an einer anderen Stelle, dass eines Tages "
			"ein Krieger kommen wird, geschuetzt durch ein Schuppenkleid, in der "
			"rechten das heilige Schwert, in der linken das heilige Schild, und "
			"um den Hals wird er das Amulett des Glaubens tragen. Ja, so steht es "
			"geschrieben, also wird es geschehen.";
	
	return "Chance? Keine Ahnung welche Chance Du hast, oder Dir Dein Leben in "
		"Zukunft noch bieten wird.";
}


string dragon_scale(string str)
{
	if(present("\nfree_souls", TP))
		return "Leider stehen keine Details diesbezueglich in der Legende, es heisst "
			"bloss: ...es sind die Schuppen einer uralten Kreatur. Aber weiters heisst es, "
			"dass es Dich vor SEINEN physischen Angriffen schuetzen wird, zumindest teilweise.";
	
	return "Hm...keine Ahnung wovon Du sprichst. Meinst Du die Schuppen eines Fisches, "
		"oder Deine eigenen?";
}


string holy_sword(string str)
{
	if(present("\nfree_souls", TP))
		return "Ah, hier steht, dass es einst waehrend eines Kreuzzuges gegen die Heiden "
			"verloren ging, und dass das Schwert in den Besitz einer gefuerchteten Kriegerrasse "
			"uebergegangen sei. Du benoetigst es, da es die einzige Waffe auf dieser Seite "
			"des Seins ist, die IHM ernstzunehmenden Schaden zufuegen kann.";
	
	return "Ich bin ein Mann des Glaubens, mit derartigen Mordinstrumenten habe ich, und "
		"will ich auch garnichts zu tun haben.";
}


string holy_shield(string str)
{
	if(present("\nfree_souls", TP))
		return "Es heisst, dass es Philip Augustus auf einem seiner Kreuzzuege abhanden "
			"gekommen sei, als er und seine Mannen von einem raeuberischen Nomadenstamm "
			"ueberfallen wurden. Und zwar steht geschrieben, dass sie gerade die grosse "
			"Flaeche der ewigen Trockenheit durchqueren wollten, als das geschah. Allerdings "
			"faellt mir ein, dass berichtet wird, dass es schon bald darauf von abenteuerlustigen "
			"kleinen Wesen gefunden wurde, die es von da an als ihren Schatz hueten. Hm..."
			"vielmehr ueberliefert die Legende allerdings nicht. Oh, warte! An einer anderen "
			"Stelle werden diese kleinen Wesen auch die Hueter der Berge genannt. Naja, vielleicht "
			"kannst Du ja etwas damit anfangen. Es wird dich gleich dem Schuppenkleid vor SEINEN "
			"uebermaechtigen physischen Angriffen schuetzen.";
	
	return "Schild? Wozu sollte ich ein Schild benoetigen? Wer attackiert schon einen "
		"Mann des Friedens!";
}


string amulet_of_faith(string str)
{
	if(present("\nfree_souls", TP))
		return "Das Amulett des Glaubens so steht geschrieben, wird seit je her von "
			"den aeltesten Freunden der Natur bewacht, und tief in den Waeldern vor dem "
			"Anblick der Welt verborgen gehalten. Das Amulett wird Dich im Gegensatz zu "
			"Schuppenkleid und Schild vor SEINER unheiligen Magie schuetzen.";
	
	return "Ich bin ein Mann des Glaubens, aber von einem gleichnamigen Amulett habe "
		"ich noch nie gehoert.";
}


reset()
{
	if(!is_clone(this_object())) return;
	::reset();
	this_object()->move(PATH"raum01", M_GO);
}

