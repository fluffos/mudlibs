/*
  arth
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include <new_skills.h>
#include "../desert.h"

#define MIN_TIME_FOR_ENSLAVEMENT 60

nosave object slave;

nosave string *marked = ({});
#define MARKED 

int move_slave(object slave);

create()
{
  if(!is_clone(ME)) return;
  
  ::create();

  AddId(({"sklavenaufseher","aufseher", "\noverseer", "Peitschenexperte"}));
  
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Sklavenaufseher");
  SetProp(P_NAME_ADJ, "unbarmherzig");
  
  SetProp(P_SHORT, "Ein unbarmherziger Sklavenaufseher");
  SetProp(P_LONG, 
	  BS("Der Sklavenaufseher ist relative gross, muskelbepackt und hat "
	     "wenig Erfahrung im Umgang mit anderen Menschen. Er kennt nur "
	     "ein Mittel, um zum Ziel zu gelangen: Gewalt. Er achtet hier "
	     "darauf, dass nicht gefaulenzt wird, sondern alle seine "
	     "'Schaefchen' bis zur Erschoepfung, oder gar bis zum Tod "
	     "'arbeiten'."));
  
  create_default_npc(28);
  
  SetProp(P_ALIGN, -600);
  SetProp(P_SIZE, 220);
  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit aller Brutalitaet", 220, DT_TERROR}));
  
  set_living_name("sklavenaufseher");
  
  SUID;
  
  CLONEME("/p/weapon/whip/peitsche");
  command_me("zuecke peitsche");
  
  CLONEME("/p/armour/trousers/lederhose");
  CLONEME("/p/armour/armour/lederpanzer");
  CLONEME("/p/armour/boots/lederstiefel");
  command_me("trage alles");
  
  SetProp(P_SPELLRATE,25);
  
  AddSpell(1,300,
	   "Der Sklavenaufseher versucht Dich zu versklaven.\n",
	   "Der Sklavenaufseher versucht @WEN zu versklaven.\n",
	   DT_WHIP,([SP_SHOW_DAMAGE:1]));
  
  SetChats(5,({
    "Der Sklavenaufseher beobachtet Dich genau.\n",
      "Der Sklavenaufseher bruellt: Los Sklaven, arbeitet!\n",
      "Der Sklavenaufseher schreit: Schneller ihr Hunde!\n",}));
  
  SetProp(P_DIE_MSG,
	   " wird so bald niemanden mehr versklaven.\n");
  
  SetProp(P_DEFAULT_INFO,
	   "schnauzt Dich an: Was willst Du, soll ich Dich etwa auch "
	  "versklaven?\n");
  
  SetProp(P_REJECT,
	  ({REJECT_DESTRUCT, "Der Sklavenaufseher sagt: Ha! Du bist der "
	      "naechste.\n" }));
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
    ctime()+": "+CAP(getuid(TP))+" killt den Aufseher.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": Der Aufseher killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
