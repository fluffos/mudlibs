//Ar-Thoas
//SATAN --> P->dead if he has no special item, which has been blessed by the monk
//for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <actions.h>
#include "../desert.h"

//int adj_body();


create()
{
  if (!is_clone(this_object())) return;  
  
  ::create();
  
  SetProp(P_SHORT, "Ein Fuerst");
  SetProp(P_LONG, "Ein Fuerst der Finsternis.");
  
  //SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:5, T_RANGE_MAX:44]);
          
  SetProp(P_NAME, "Satan");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_LIGHT, 0);
  
  SetProp(P_RESISTANCE_STRENGTHS,
	([	DT_FIRE:		-1.0, DT_COLD:			-1.0, DT_WATER:		-1.0, DT_AIR:		-1.0,
		DT_LIGHTNING:	-1.0, DT_EXPLOSION:	    -1.0, DT_SOUND:		-1.0, DT_LIGHT:		-1.0,
		DT_ELECTRIC:	-1.0, DT_ACID:			-1.0, DT_POISON:	-1.0, DT_TERROR:	-1.0,
		DT_HOLY:		 1.0, DT_UNHOLY:		-1.0, DT_MAGIC:		-1.0 ]) );
/*
  SetProp(P_RESISTANCE_STRENGTHS,
	([	DT_FIRE:		-0.7, DT_COLD:			-0.4, DT_WATER:		-0.5, DT_AIR:		 0.0,
		DT_LIGHTNING:	-0.3, DT_EXPLOSION:	     0.3, DT_SOUND:		-0.1, DT_LIGHT:		-0.8,
		DT_ELECTRIC:	-0.2, DT_ACID:			-0.1, DT_POISON:	-0.4, DT_TERROR:	-0.8,
		DT_HOLY:		 1.0, DT_UNHOLY:		-1.0, DT_MAGIC:		-0.6 ]) );
*/
  AddId(({"satan", "natas", "teufel", "diablo", "fuerst", "NOWIMPY"}));
  
  create_default_npc(99);
  
  set_living_name("diablo");
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:99]));
 
  SetProp(P_ALIGN, -9999);
  SetProp(P_RACE, "Hoellenfuerst");
  SetProp(P_SIZE, 666);
  
//  SetProp(P_BODY, #'adj_body);
  SetProp(P_HANDS, ({" mit seiner Unheiligkeit", 666, DT_UNHOLY}) );
  
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_NOMAGIC, 1);
  SetProp(P_KILL_NAME, "Natas");
  SetProp(P_KILL_MSG, "rim nun treoheg eleeS enieD");
  SetProp(P_MSGIN, "steigt aus den Tiefen der Hoelle empor");
  SetProp(P_MSGOUT, "faehrt hinab in die Tiefen der Hoelle");
}


