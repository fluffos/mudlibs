/*
  Ar-Thoas
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(this_object())) return;
  
  ::create();
	
  SetProp(P_SHORT, "Ptahla, die Wirtin");
  SetProp(P_LONG, 
	  BS("Ptahla scheint bereits einen anstregenden Tag hinter sich "
	     "zu haben. Willst Du sie wirklich mit einer neuen Bestellung "
	     "belaestigen?"));
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));

  SetProp(P_NAME, "Ptahla");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Mensch");
  AddId(({"wirtin","tuareg","ptahla"}));
  SetProp(P_ARTICLE, 0);

  create_default_npc(24);

  SetProp(P_HANDS, ({" mit ihren blossen Haenden",QueryProp(P_HANDS)[1],
		       DT_BLUDGEON}));
  SetProp(P_WEIGHT, 44000);
  SetProp(P_ALIGN, -200);
  SetProp(P_AGGRESSIVE, 0);
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Ptahla will Deinen Schrott nicht!\n"}));
	
  SetProp(P_DEFAULT_INFO, "raet, den Moench aufzusuchen.\n");
	
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  0.3, DT_COLD:     -0.4, DT_WATER:     0.5, 
	    DT_AIR:   0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION: 0.3,
	    DT_SOUND:-0.1, DT_LIGHT:     0.0, DT_ELECTRIC: -0.2,
	    DT_ACID: -0.1, DT_POISON:    0.4, DT_TERROR:   -0.3,
	    DT_HOLY:  0.0, DT_UNHOLY:    0.0, DT_MAGIC:    -0.6]));
  
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt herein und sieht sich um");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " faellt seufzend zu Boden.\n");
  SetProp(P_MURDER_MSG, "Und wer kuemmert sich jetzt um die Kunden?!");

  SetProp(P_SPELLRATE, 30);

  AddSpell(3,300,
	   Name()+" tritt Dich kraeftig.\n",
	   Name()+" tritt @WEN kraeftig.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,350,
	   Name()+" rammt Dir ihr Knie in den Bauch.\n",
	   Name()+" rammt @WEM ihr Knie in den Bauch.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,450,
	   Name()+" wirft Dir einen Krug hinterher.\n",
	   Name()+" wirft @WEM einen Krug hinterher.\n",
	   ({DT_SLASH,DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  
  SUID;  
  
  catch(CLONEME("/p/armour/cloak/schuerze"));
  catch(CLONEME("/p/armour/trousers/rock_kurz"));
  catch(CLONEME("/p/armour/armour/bluse"));
  command_me("trage alles");
  
  AddInfo(({"moench"}), 
	  "Er wandert irgendwo vor der Schlucht herum, "
	  "Du bist ihm sicher schon begegnet.", 
	  "schnauzt: ");
  
  AddInfo(({"bestellung"}), 
	  "Na los, sag schon was Du willst, ich hab ja "
	  "schliesslich nicht ewig Zeit!", 
	  "grummelt: ");
  
  AddInfo(({"zeit"}), 
	  "Zeit ist das, wovon ich am wenigsten habe =:<",
	  "schluchzt: ");
  
  AddInfo(({"tag"}), 
	  "Der heutige Tag ist wirklich furchtbar. Die reinste "
	  "Hetzjagd! Von einem Kunden zum anderen...alle wollen sie etwas "
	  "gleichzeitig, und am besten noch sofort. Um alle zufrieden zu "
	  "stellen muesste ich mich foermlich zerreissen =:<. Ach haett' ich "
	  "nur was Anstaendiges gelernt, dann muesst ich mich nicht Tag ein "
	  "Tag aus in dieser Spelunke abrackern.", 
	  "weint sich bei Dir aus: ");
  
  set_living_name("ptahla");
  
  SetChats(1, ({
    "Ptahla sagt: Was willst Du, Fremder?\n",
      "Ptahla murrt: Los hau ab, ich hab auch so schon genug zu tun.\n",
      "Ein Gast ruft: Wirtin! No so an Schnops, ober glei!\n"}));
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt "+name()+".\n");

  KILLMASTER->register_npc_death(TP);
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": "+name()+" killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction")!=-1) return;

  if(touch)
    call_out("reaction", 0, TP,
	     "gibt Dir eine Ohrfeige und geht weiter zum naechsten Kunden.",
	     "gibt "+TP->name(WEM)+" eine Ohrfeige und arbeitet weiter.",1);
  else
    call_out("reaction", 0, TP,
	     "meint: Lass mich in Ruh, ich muss arbeiten!",
	     "meint zu "+TP->name(WEM)+
	     ": Lass mich in Ruh, ich muss arbeiten.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-5-random(5));
    }
}
