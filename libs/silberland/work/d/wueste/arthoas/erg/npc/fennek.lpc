/*
  Ar-Thoas
  fennek
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Fennek");
  SetProp(P_LONG, 
	  BS("Er wird auch Wuestenfuchs genannt. Seine Charakteristika sind "
	     "sehr grosse Ohren, grosse Augen, eine feine und spitze Schnauze "
	     "und ein helles, sandfarbenes Fell.\n"));
	  
  AddDetail(({"ohren", "gehoer"}),
  	"Die grossen Ohren sollen die Abfuhr der Koerperwaerme foerden, "
  	"und dienen ferner zur Orientierung.\n");
  AddDetail(({"augen","nachts"}),
  	"Aufgrund der hohen Umgebungstemperatur ist der Fennek gezwungen Nachts zu "
  	"jagen. Zwar setzt er vorallem sein gutes Gehoer ein, aber auch seine Augen "
  	"und seine Nase helfen ihm dabei.\n");
  AddDetail("nase",
  	"Er hat eine sehr feine Nase, die ihm bei der naechtlichen Jagd zur Seite "
  	"steht.\n");
  AddDetail("fell",
  	"Sein Fell hat die Farbe seiner natuerlichen Umgebung, sandfarben.\n");
  AddDetail("umgebung",
  	"In der Regel Wueste.\n");
  	
  SetProp(P_NAME, "Fennek");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));
  SetProp(P_RACE, "Fuchs");
  
  AddId(({"fennek", "fuchs", "wuestenfuchs"}));
  create_default_npc(7);
  
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 200);
  SetProp(P_BODY, QueryProp(P_BODY)+33);
  SetProp(P_HANDS, ({" mit seinen kleinen, scharfen Zaehnen", 100, 
		       ({DT_RIP,DT_PIERCE})}));
  SetProp(P_MAX_HANDS, 4);
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:     -0.2, DT_COLD:     -0.3, DT_WATER: 0.3,
	    DT_LIGHTNING:-0.3, DT_EXPLOSION: 0.3, DT_SOUND: 0.7, 
	    DT_LIGHT:    -0.2, DT_ELECTRIC: -0.2, DT_ACID: -0.1, 
	    DT_POISON:    0.3, DT_TERROR:    0.3, DT_HOLY: -1.0, 
	    DT_MAGIC:    -0.4]));
  
  SetProp(P_NOMAGIC, 10);
  
  AddInfo(DEFAULT_INFO, 
	  ({"versteht Dich doch gar nicht.\n",
	      "legt den Kopf schief und blickt Dich an.\n",
	      "knurrt Dich fragend an.\n"}));

  SetProp(P_REJECT, 
	  ({REJECT_KEEP, "Der Fennek sieht dankbar zu Dir auf."}));

  SetProp(P_DIE_MSG, " legt seine Ohren an und wird nie wieder etwas hoeren.\n");
}

void die(int pd)
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt den Fennek.\n");
  ::die(pd);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    write_file(LOG "playerdeath",
	       ctime()+": Der Fennek killt "+CAP(getuid(player))+" ("+lxp+").\n");
}
