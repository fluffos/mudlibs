/*
  Ar-Thoas
  rattlesnake
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Klapperschlange");
  SetProp(P_LONG, 
	  BS("Du erkennst sie sofort an der graubraunen Faerbung, "
	     "der hellen eingefassten Sechseckflecken auf der Oberseite, "
	     "und natuerlich an der Klapper am Schwanzende."));
  
  AddDetail("faerbung",
	    "An sich graubraun.\n");
  AddDetail(({"sechseckflecken", "flecken", "oberseite"}),
	    "Auf der Oberseite befinden sich helle Sechseckflecken.\n");
  AddDetail(({"klapper", "schwanzende"}),
	    "Die Klapper am Schwanzende besteht aus Hornringen.\n");
  AddDetail(({"hornringe", "ringe"}),
	    "Sie entstanden durch Rueckstaende beim Haeuten.\n");
  AddDetail("rueckstaende",
	    "Sie bilden die Klapper.\n");
  AddDetail("haeuten",
	    "Also jetzt gerade haeutet sie sich nicht.\n");
  AddDetail("ende",
	    "Hm...Dein Ende naht vielleicht.\n");
  	
  SetProp(P_NAME, "Klapperschlange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"rattlesnake", "schlange", "klapperschlange"}));
  SetProp(P_RACE, "Schlange");
  create_default_npc(18);
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 4000);
  SetProp(P_ALIGN, -700);
  SetProp(P_BODY, 18);
  SetProp(P_HANDS, ({" mit ihren Giftzaehnen", 200, DT_POISON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:  -0.2, DT_COLD:       0.2, DT_WATER:     0.5,
	    DT_AIR:    0.0, DT_LIGHTNING: -0.3, DT_EXPLOSION: 0.3,
	    DT_SOUND: -0.1, DT_LIGHT:     -0.2, DT_ELECTRIC: -0.2,
	    DT_ACID:  -0.1, DT_POISON:    -0.8, DT_TERROR:    0.0,
	    DT_HOLY:   0.0, DT_UNHOLY:     0.0, DT_MAGIC:    -0.2]));
  
  SetProp(P_REJECT,({REJECT_DROP,"Die Schlange beisst Dich in den Finger."}));
  
  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1, 200,
	   "Die Schlange richtet sich auf und beisst Dich in den Po.\n",
	   "Die Schlange richtet sich auf und beisst @WEN in den Po.\n", 
	   ({DT_POISON}), ([SP_SHOW_DAMAGE:1]));

  /* Wenn sie stirbt soll eine besondere Meldung erscheinen. */
  SetProp(P_DIE_MSG, " sinkt tot zu Boden.\n");
}

void die(int pd)
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt die Klapperschlange.\n");

  ::die(pd);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    write_file(LOG "playerdeath",
	       ctime()+": Die Klapperschlange killt "+CAP(getuid(player))+
	       " ("+lxp+").\n");
}
