/*
  Ar-Thoas
  oasenwaechter
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
  for npc-statistics -> /players/arthoas/doc/wuestental/npcs.c
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Waechter der Oase");
  SetProp(P_LONG, 
	  BS("Der Waechter sieht alles andere als freundlich aus. "
	     "Er scheint nicht nur gross und aeusserst kraeftig zu sein, "
	     "sondern auch ein kampferfahrener Krieger."));
		
  SetProp(P_NAME, "Oasenwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  SetProp(P_RACE, "Mensch");
  AddId(({"oasenwaechter", "waechter"}));
  
  create_default_npc(35+random(3));
	
  SetProp(P_SIZE, 195+random(10));
  SetProp(P_WEIGHT, 90000+random(5000));
  SetProp(P_ALIGN, -200);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 500, DT_BLUDGEON}));
  
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([
	    DT_FIRE:      0.2, DT_COLD:     -0.4, DT_WATER:  0.2, 
	    DT_LIGHTNING:-0.3, DT_EXPLOSION: 0.3, DT_SOUND: -0.1, 
	    DT_ELECTRIC: -0.2, DT_ACID:     -0.1, DT_POISON:-0.1, 
	    DT_TERROR:   -0.3, DT_MAGIC:    -0.6]));
  
  SUID;

  // Die Oasenwaechter bekommen KEINEN Sandpanzer, Zordan
  // CLONEME(ARMOUR "sandpanzer");
  CLONEME( "/p/armour/armour/lederpanzer.lpc");
  CLONEME(ARMOUR "sandstiefel");
  CLONEME(ARMOUR "sandhose");
  command_me("trage alles");

  CLONEME(WEAPON "ksaebel");
  command_me("zuecke saebel");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, 
	      "Der Waechter sagt: Wer braucht schon solchen Ramsch!"}));
	
  SetProp(P_SPELLRATE, 18+random(5));
  
  AddSpell(1, 600,
	   "Der Waechter schlitzt Dir den Bauch auf.\n",
	   "Der Waechter schlitzt @WEM den Bauch auf.\n", 
	   ({DT_WHIP}), ([SP_SHOW_DAMAGE:1]));
  //AddSpell(2, 940,
  //"Der Waechter oeffnet mit seinem Krummsaebel Deinen Brustkorb.\n",
  //"Der Waechter oeffnet mit seinem Krummsaebel @WESSEN Brustkorb.\n");
  
  SetProp(P_DIE_MSG, 
	  " sinkt zu Tode getroffen zu Boden und haucht sein Leben aus.\n");
  
  AddDetail("krieger",
	    "Nur die wenigsten wuerden einen Kampf gegen ihn ueberleben.\n");
  AddDetail("kampf",
	    "Na los! Trau Dich! \n");
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
    ctime()+": "+CAP(getuid(TP))+" killt den Oasenwaechter.\n");
  
  KILLMASTER->register_npc_death(TP);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer==ME)
    {
      KILLMASTER->register_player_death(player, lxp);

      write_file(LOG "playerdeath",
		 ctime()+": Der Oasenwaechter killt "+CAP(getuid(player))+
		 " ("+lxp+").\n");
    }
}
