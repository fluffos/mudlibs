/*
  Ar-Thoas
  Wanderstab - Moench
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Wanderstab");
  SetProp(P_LONG, 
	  BS("Der Stab ist Holz gefertigt, man kann ihn jedoch auch als Waffe benutzen."));

  SetProp(P_NAME, "Wanderstab");
  SetProp(P_GENDER, MALE);
  
  AddId(({"stab", "wanderstab"}));

  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 1250);
  
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  
  SetProp(P_WC, 125);
  
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
}
