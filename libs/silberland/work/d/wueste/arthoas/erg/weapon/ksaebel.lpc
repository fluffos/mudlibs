/*
  Ar-Thoas
  krummsaebel - oasenwaechter
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Krummsaebel");
  SetProp(P_LONG, "Diese Art des Saebels ist gekruemmt, damit man dem Gegner "+
  					"schwere Schnittwunden zufuegen kann.\n");

  SetProp(P_NAME, "Krummsaebel");
  SetProp(P_GENDER, MALE);

  AddId(({"saebel", "krummsaebel"}));

  SetProp(P_VALUE, 1200);
  SetProp(P_WEIGHT, 1250);
  SetProp(P_SIZE, 90);

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_BLUDGEON}) );

  SetProp(P_WC, 150);

  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, MAT_STEEL);

  SetProp(P_WC_BONUS, (["waechter":100]));
  SetProp(P_WC_FIXFACTOR, 0.4);
}
