/*
  Ar-Thoas
  schwert -> tuareg-krieger
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if(!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Breitschwert");
  SetProp(P_LONG, 
	  BS("Dieses Schwert wurde aus purem Adamant gefertigt, "
	     "und hat eine lange, breite und sehr scharfe Klinge. "
	     "Es eignet sich sowohl dazu auf seinen Gegner einzuschlagen "
	     "als auch auf ihn einzustechen."));
	
  SetProp(P_NAME, "Adamantschwert");
  SetProp(P_GENDER, NEUTER);
  
  AddId(({"schwert", "adamantschwert", "breitschwert"}));
	
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 170);

  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE, DT_BLUDGEON}));
  SetProp(P_NR_HANDS, 1);

  SetProp(P_MATERIAL, MAT_ADAMANT);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 2000);
  SetProp(P_SIZE, 110);

  SetProp(P_WC_BONUS, (["\ntkrieger":100]) );
  SetProp(P_WC_FIXFACTOR, 0.2);
	
  AddDetail(({"klinge"}),
	    "Sie schreckt so manchen potentiellen Angreifer schon bloss durch "+
	    "ihren Anblick ab.\n");
}
