/*
  Ar-Thoas
  Ein Hinterlauf
*/

inherit "std/thing";

#include <properties.h>
#include "../desert.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Hinterlauf");
  SetProp(P_LONG, 
	  BS("Der Hinterlauf einer Oryx. Njam, njam, njam, sieht der lecker aus."));
  
  SetProp(P_NAME, "Hinterlauf");
  SetProp(P_GENDER, MALE);
  
  AddId(({"hinterlauf", "lauf"}));
  
  SetProp(P_VALUE, 200);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, MAT_FLESH);
}
















































































