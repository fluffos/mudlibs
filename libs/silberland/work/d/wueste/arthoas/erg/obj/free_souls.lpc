//Ar-Thoas
//invis-item...allows P to drink from well...get permission from leader

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <player.h>



create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  
    "");
  
  SetProp(P_NAME, "Nothing");
  SetProp(P_GENDER, NEUTER);

  AddId("\nfree_souls");

  SetProp(P_WEIGHT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
}