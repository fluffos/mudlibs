/*
  Ar-Thoas
  sandburg
  f(x) fuer zertrete burg, mit message an eigentuemer, falls ein anderer die burg zertritt...
  maybe ein zaubertrankversteck??? (falls der eigentuemer seine burg zertritt???)
*/

inherit "std/thing";

#include <properties.h>
#include "../desert.h"

nosave string owner;

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Sandburg");
  SetProp(P_LONG, 
	  BS("Eine wunderschoene Burg aus Sand. Sie hat alles, was zu "
	     "einer richtigen Burg gehoert, vier Tuerme, Burgzinnen, "
	     "und ueberhaupt ist sie einfach uuuuuuuur toll! =:>"));
    
  AddDetail(({"turm", "tuerme", "eckpunkt", "eckpunkte"}),
	    "An jedem der vier Eckpunkte ragt ein kleiner Turm empor.\n");
  AddDetail(({"burgzinnen", "zinnen"}),
	    "Einfach genial, wie detailgetreu alles nachgebildet wurde. "
	    "Selbst so Kleinigkeiten wie Zinnen wurden aus dem Sand "
	    "geformt.\n");
  AddDetail(({"kleinigkeiten", "kleinigkeit"}),
	    "Naja, so ne Kleinigkeit ist das gar nicht.\n");
  AddDetail(({"punkt"}),
	    "Hm...jo, Du hast recht, DAS ist der springende Punkt.\n");
  
  SetProp(P_INFO, 
	  BS("Mit dem Befehl 'zertrete sandburg' kannst Du sie wieder "
	     "zerstoeren, aber willst Du das ueberhaupt?"));
  
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_NAME, "Sandburg");
  AddId(({"sandburg", "burg"}));
  
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Du wuerdest sie doch nur kaputtmachen!\n");
  SetProp(P_MATERIAL, MAT_SAND);
  
  AddCmd(({"zertrete","zertritt"}), "zertrete");
}

nosave int zertrete(string str)
{  object ob;

   notify_fail("Was moechtest Du zertreten?\n");
   if(!str) return 0;
   
   if(str=="sandburg" || str=="burg")
     {
       if(owner!=capitalize(this_player()->query_real_name()))
	 return write(break_string("Willst du wirklich die Sandburg von "+
				   owner+" zertreten?\n")),1;
   	  
       write(BS("Du hebst Deinen Fuss und trampelst wie wild auf der "
		"Sandburg herum."));
       if(!TP->FindPotion("\nDurch Dein Trampeln loest sich ein kleines "
			  "Flaeschchen aus dem Sand, das Du sofort austrinkst.\n\n"))
	 write(BS("Durch Dein Trampeln bemerkst Du gar nicht, dass Du gerade ein "
		  "kleines Flaeschchen zertreten hast.\n"));
       call_out("remove",0);
       return 1;	  
     }	
   
   if(str=="sandburg wirklich"||str=="burg wirklich")
     {
       write(BS("Schurkeeeee! Du hast es gewagt, die Sandburg von "+CAP(owner)+
		" zu zertreten. Du bist fuer den Playerkill freigegeben!\n"));
       
       if(ob=find_living(lower_case(owner))) 
	 tell_object(ob, capitalize(this_player()->query_real_name()) + " zerstoerte "
		     "Deine Sandburg!!!\n");
       call_out("remove",0);
       return 1;
       
     }
   return 0;
}

_query_long()
{
  string a;
  a="Eine wunderschoene Burg aus Sand. Sie hat alles, was zu einer richtigen "
    "Burg gehoert, vier Tuerme, Burgzinnen, und ueberhaupt ist sie einfach "
    "uuuuuuuur toll!\n";
  
  if(strlen(owner))
    a+="Sie gehoert "+CAP(owner)+".\n";
  return BS(a);
  
}

set_owner(arg)
{
  if(!strlen(owner))
    return owner = arg;
}

query_owner()
{
  return owner;
}
