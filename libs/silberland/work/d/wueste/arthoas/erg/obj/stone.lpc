create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Stein");
  SetProp(P_LONG,  
    "");
  SetProp(P_INFO, "Von diesem Stein strahlt eine eigenartige Macht aus.\n");
  SetProp(P_NAME, "Stein");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_MISC_MAGIC);
  AddId(({"laguz", "rune", "stein"}));

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 99999);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  //SetProp(P_AUTOLOADOBJ, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_LIGHT, 1);
	
	AddDetail("macht",
		"Es handelt sich um eine Dir vollkommen unbekannte Macht. "+
		"Vielleicht solltest Du in Dich gehen, um hinter sein Geheimnis "+
		"zu kommen?\n");
	
	//AddCmd("meditiere", "meditation");
	
//	AddCmd("laguzlaguzlaguz", "drink", 0);
}

