/*
  Ar-Thoas
  Eine tote Oryx
*/

inherit "std/thing";

#include <properties.h>
#include "../desert.h"
#include <moving.h>
#include <combat.h>

int bein;

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine tote Oryx");
  SetProp(P_LONG, 
	  BS("Die Leiche einer Oryx. Schaum tritt aus dem Maul heraus, das "
	     "Fell verblasst schnell in der Sonne und die ersten Fliegen "
	     "beginnen sich bereits einzufinden. Was man jetzt damit wohl "
	     "anstellen kann?"));
  SetProp(P_NAME, "Oryx");
  SetProp(P_INFO, 
	  BS("Die Hinterlaeufe sehen recht fleischig aus, vielleicht "
	     "kann man sie ja abschneiden und spaeter verzehren."));
  
  SetProp(P_GENDER, FEMALE);
  
  AddId(({"oryx", "deadoryx"}));
  
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 220000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_NOGET, 1);
  
  AddCmd(({"schneid", "schneide"}), "cut");

  bein = 1;
}

nosave int cut(string str)
{
  object ob, we;
  
  notify_fail("Was willst Du abschneiden?");
  if(!str || !bein) return 0;
  
  if(str=="hinterlauf ab"||str=="lauf ab")
    { 
      if(!we=TP->QueryProp(P_WEAPON))
	      return notify_fail("Ohne Schneidwerkzeug wird das wohl nichts!\n"),0;
      if(member(({WT_SWORD,WT_AXE,WT_KNIFE}), we->QueryProp(P_WEAPON_TYPE))==-1)
	      return notify_fail("Ohne geeignetes Schneidwerkzeug wird das wohl nichts!\n"),0;
      
      say(BS(TPN+" schneidet der toten Oryx einen Hinterlauf ab."));

      ob=clone_object(OBJ "hinterlauf");
      bein = 0;

      if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  ob->move(MENV, M_NOCHECK);

	  write(BS("Du schneidest der toten Oryx einen Hinterlauf ab."));
	}
      else
	write(BS("Du schneidest der toten Oryx einen Hinterlauf ab, den Du "
		 "sofort einsteckst."));

      call_out("remove", 0);
      
      return 1;
    }
  else
    if(str=="hinterlaeufe ab"||str=="laeufe ab")
      return write("Ein Lauf sollte reichen!\n"),1;
    else
      return write("Die Hinterlaeufe sehen als einzige schmackhaft aus...\n"),1;
  return 0;
}

void reset()
{
  ::reset();
  
  call_out("remove", 0);
}
