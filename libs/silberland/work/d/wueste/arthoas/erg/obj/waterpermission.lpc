//Ar-Thoas
//invis-item...allows P to drink from well...get permission from leader

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../desert.h"

create()
{
  if(!is_clone(TO)) return;
  
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  
  SetProp(P_NAME, "Nothing");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_NODROP,    1);
  SetProp(P_NEVERDROP, 1);

  AddId("\npermission");

  SetProp(P_WEIGHT, 0);
}

void reset()
{
  if(!is_clone(TO)) return;
  
  ::reset();

  call_out("remove", 0);
}
