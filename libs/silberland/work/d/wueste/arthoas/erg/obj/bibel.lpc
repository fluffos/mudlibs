/*
  Ar-Thoas
  bible
*/

inherit "std/thing";

#include <properties.h>
#include "../desert.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Die Bibel");
  SetProp(P_LONG, "Das Buch der Buecher.");
  SetProp(P_NAME, "Bibel");
  SetProp(P_GENDER, FEMALE);
  AddId("bibel");
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_PAPER);
}
















































































