/*
  Ar-Thoas
  litham -> tuareg-krieger...removed when npc dies -> p will never get one
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Litham");
  SetProp(P_LONG, "xxx\n");
  
  AddId("litham");
  
  SetProp(P_NAME, "Litham");
  SetProp(P_GENDER, MALE);
  SetProp(P_AC, 3);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Du wagst es nicht den Litham eines Tuareg-Kriegers an Dich zu nehmen.\n");
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_CLOTH);
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]) );
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  
  if(!environment()) call_out("remove", 0);
  if(!living(environment())) call_out("remove", 0);
}
