/*
  Ar-Thoas
  spezielle sandstiefel -> to pass quicksand
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"sandschuhe", "schuhe", "\nssandschuhe"}));
  
  SetProp(P_SHORT, "Ein Paar Sandschuhe");
  SetProp(P_LONG, 
	  BS("Diese speziellen Sandschuhe wurden aus feinen Silberfaeden "
	     "gefertigt, wobei kleine Sandkristalle eingeflochten wurden. "
	     "Irgendwie erinnern sie Dich vom Prinzip an Schneeschuhe."));
	
  SetProp(P_NAME, "Paar Sandschuhe");
  SetProp(P_NAME_ADJ, "speziell");
  AddAdjective(({"spezielle", "spezielles", "speziellen"}));
	
  SetProp(P_INFO, 
	  BS("Tja, die Funktion von Schneeschuhen ist, das Einsinken "+
	     "bei tiefem Schnee zu verhindern. Aber ob Dir das jetzt weiterhilft?"));
  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 2);
  
  SetProp(P_MATERIAL, ([MAT_SAND:91, MAT_SILVER:9]));
	
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 20]));
								 
  AddDetail(({"silberfaeden"}),
	    "Sie sind dermassen duenn, dass sie wie Stoffaeden zu verarbeiten sind.");
  AddDetail(({"stoff", "stoffaeden"}),
	    "Noe, aus Stoff sind sie sicher nicht.");
  AddDetail(({"silber"}),
	    "Tja, warum ausgerechnet Silber verwendet wurde wird Dir bei bestem Willen "
	    "nicht klar.");
  AddDetail(({"sandkristalle", "kristalle", "sand"}),
	    "Die Bedeutung der Sandkristalle wirst Du wohl niemals ergruenden.");
}
