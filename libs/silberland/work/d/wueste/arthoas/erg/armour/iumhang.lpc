/*
  Ar-Thoas
  indigofarbener umhang -> tuareganfuehrer
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId (({"umhang", "iumhang"}));
  
  SetProp(P_SHORT, "Ein Umhang");
  SetProp(P_LONG, 
	  BS("Du hast einen perfekt verarbeiteten Umhang vor Dir. "
	     "Besonders auffaellig ist die kraeftige Indigofaerbung."));
  
  SetProp(P_NAME, "Umhang");
  SetProp(P_NAME_ADJ, "indigofarben");
  AddAdjective("indigofarbenen");
  
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_INFO, "Der Umhang stellt einen guten Schutz vor Witterungseinfluessen dar.\n");  
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, MAT_CLOTH);
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]) );
}
