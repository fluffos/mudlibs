/*
  Ar-Thoas
  sandstiefel -> oasenwaechter
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"sandstiefel", "stiefel"}));
  
  SetProp(P_SHORT, "Ein Paar Sandstiefel");
  SetProp(P_LONG, 
	  BS("Sie wurden aus feinen Silberfaeden gefertigt, wobei "+
	     "kleine Sandkristalle eingeflochten wurden.\n"));
  
  SetProp(P_NAME, "Paar Sandstiefel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  
  SetProp(P_MATERIAL, ([MAT_SAND:80, MAT_SILVER:10, MAT_GOLD:10]));
  
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 35]));
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]));
  
  AddDetail(({"silberfaeden"}),
	    "Sie sind dermassen duenn, dass sie wie Stoffaeden zu verarbeiten sind.");
  AddDetail(({"stoff", "stoffaeden"}),
	    "Noe, aus Stoff sind sie sicher nicht.");
  AddDetail(({"silber"}),
	    "Tsja, warum ausgerechnet Silber verwendet wurde wird Dir bei bestem Willen "
	    "nicht klar.");
  AddDetail(({"sandkristalle", "kristalle", "sand"}),
	    "Die Bedeutung der Sandkristalle wirst Du wohl niemals ergruenden.");
}
