/*
  Ar-Thoas
  sandhose -> oasenwaechter
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"sandhose", "hose"}));
  SetProp(P_SHORT, "Eine Sandhose");
  SetProp(P_LONG, 
	  BS("Sie wurde aus feinen Silberfaeden gefertigt, wobei "
	     "kleine Sandkristalle eingeflochten wurden."));
	
  SetProp(P_NAME, "Sandhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 750);
  SetProp(P_VALUE, 2400);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 9);
	
  SetProp(P_MATERIAL, ([MAT_SAND:80, MAT_SILVER:10, MAT_GOLD:10]));
	
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 35]));
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]));
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]));

  AddDetail(({"silberfaeden"}),
	    "Sie sind dermassen duenn, dass sie wie Stoffaeden zu verarbeiten sind. \n");
  AddDetail(({"stoff", "stoffaeden"}),
	    "Noe, aus Stoff ist sie sicher nicht.\n");
  AddDetail(({"silber"}),
	    "Tsja, warum ausgerechnet Silber verwendet wurde wird Dir bei bestem Willen "+
	    "nicht klar.\n");
  AddDetail(({"sandkristalle", "kristalle", "sand"}),
	    "Die Bedeutung der Sandkristalle wirst Du wohl niemals ergruenden. =:> \n");
}
