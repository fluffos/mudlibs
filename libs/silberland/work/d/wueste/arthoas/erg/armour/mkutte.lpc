/*
  Ar-Thoas
  Moenchskutte
  weapon & armory -> /players/arthoas/doc/wuestental/w&a.c
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../desert.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"moenchskutte", "kutte"}));
  SetProp(P_SHORT, "Eine Moenchskutte");
  SetProp(P_LONG, 
	  BS("Eine einfache, braune Moenchskutte. Ideal um "
	     "einen vor Wind und Wetter zu schuetzen."));
  SetProp(P_NAME, "Moenchskutte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 300);
  SetProp(P_INFO, "Die Kutte ist zwar nicht schoen, aber praktisch!\n");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_MATERIAL, MAT_CLOTH);
  
  SetProp(P_AC, 2);
}
