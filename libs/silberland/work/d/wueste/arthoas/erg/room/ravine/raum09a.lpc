/*
  Ar-Thoas
  desert -Schlucht (incl. GuardedExit)
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "ravine.h"

nosave void get_wild(object ob);
nosave void get_wild2(object ob);
nosave void get_wild3(object ob);

nosave int cloned;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Schlucht");
  SetProp(P_INT_LONG,
	  BS("Fast hast Du es geschafft, wuerde Dir jetzt noch etwas zustossen, " 
	     "waerst Du schon ein besonderer Guenstling Molochs. Am Boden " 
	     "liegen zahlreiche Felsbrocken. Ausserdem haben sich meterhohe " 
	     "Geroellhaufen gebildet. So faszinierend der Berge Erscheinung " 
	     "auch ist, willst Du nur noch weg von hier. Du kannst entweder nach " 
	     "Norden, oder in suedlicher Richtung das Tal betreten."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 35, ENV_TERRAIN:TT_MOUNTAIN]));
  
  STANDARD2
  STDSKY2

  AddDetail(({"boden"}),
	    "Unmengen an Steinen und Felsen haben sich hier angehaeuft.");
  AddDetail(({"felsen", "steine", "felsbrocken"}),
	    "Sie bilden meterhohe Haufen aus sogenanntem Geroell.");
  AddDetail(({"geroell", "bann"}),
	    "Ein Geroellhaufen zieht Dich in seinen Bann. " 
	    "Irgendwie hast Du ein komisches Gefuehl dabei.");
  AddDetail(({"geroellhaufen", "haufen"}),
	    "Waere ideal fuer einen Hinterhalt, aber ein Optimist wie Du...");
  AddDetail(({"optimist"}),
	    "Du! ");
  AddDetail(({"punkt"}),
	    "Davon sind genug hier.");
  AddDetail(({"seite"}),
	    "Hier liegt keine rum.");
  AddDetail(({"wolke"}),
	    "Du hast Pech, jetzt ist gerade keine da.");
  AddDetail(({"felswaende", "waende"}),
	    "An dieser Stelle sehen sie besonders gefaehrlich aus. Es " 
	    "hat den Anschein, als wuerde jeden Augenblick eine " 
	    "Geroelllawine zu Tale stuerzen.");
  AddSmell(DEFAULT_SMELL,
	   "Irgendwie riecht es hier nach...hm...Dir kommt der Geruch " 
	   "bekannt vor...aber ja, es riecht nach GEFAHR !!!");
  AddSmell(({"gefahr"}),
	   "Wow, Du inhalierst die Gefahr -Mann was fuer ein Gefuehl =:) ");
  AddSmell(({"gefuehl"}),
	   "Noe, das kann man nicht riechen!!!");
  AddSmell(({"faeulnis"}),
	   "Aeeeh, ekelig! Hier liegen unmengen an Knochen herum, " 
	   "und die verfaulenden Fleischreste daran verursachen diesen " 
	   "bestialischen Gestank.");
  AddSmell(({"gestank"}),
	   "Die Hitze traegt ihres dazu bei, dass der Gestank " 
	   "ein beinah unertraegliches Mass erreicht.");
  AddDetail(({"knochen"}),
	    "Die Knochen wagemutiger Druiden findest Du ebenso hier, " 
	    "wie die von Berzerkern, die zu wenig Vorsicht walten liessen." 
	    "Knochen von Abenteurern kannst Du deshalb auch nach intensivster " 
	    "Suche nicht finden, weil sie vermutlich auf einmal mit Putz und " 
	    "Stengel, quasi als Fruehstueckshaeppchen verspeist werden." 
	    ""
	    "Hehe, und moeglicherweise liegen Deine bald daneben...,wer weiss? " 
	    "        =:)");
  AddDetail(({"gefuehl"}),
	    "Hm...bist Du Psychotherapeut? Ich denke nicht also kannst " 
	    "Du auch kein Gefuehl untersuchen. Lass Dir doch was anderes " 
	    "einfallen.");
  AddDetail(({"psychotherapeut"}),
	    "Sei froh, dass keiner da ist, wer weiss schon welch' " 
	    "kranke Phantasien er zu Tage foerdern wuerde.");
  AddDetail(({"tage"}),
	    "Hm...plural zu Tag.");
  AddDetail(({"tag"}),
	    "Meinst Du einen bestimmten? ");
  AddDetail(({"phantasie", "phantasien"}),
	    "Nur in Deinem Kopf...*hoffentlich*");
  AddDetail(({"moloch"}),
	    "Moloch ist der Daemon des Missgeschicks und des Verhaengnisses, " 
	    "sei froh, dass er nicht da ist.");
  AddDetail(({"missgeschick", "verhaengnis", "verhaengnisses"}),
	    "Sehr unangenehm, dafuer solltest Du Dich wahrhaft nicht interessieren.");
  AddDetail(({"daemon"}),
	    "Ein Daemon ist etwas sehr boeses und noch dazu magisch.");
  AddDetail(({"erscheinung"}),
	    "Hattest Du unlaengst eine? ");
  AddDetail(({"guenstling"}),
	    "Wenn Dich jemand gern hat, und Dich foerdert, dann bist Du sein " 
	    "Guenstling.");
  AddDetail(({"hinterhalt"}),
	    "Jo, moeglicherweise geraetst Du in einen Hinterhalt, wer weiss das " 
	    "schon... :> ");
  AddDetail(({"horizont"}),
	    "Weiter als bis zum Horizont siehst Du nicht, keine Chance.");
  AddDetail(({"chance"}),
	    "Noe, gibts keine.");
  AddDetail(({"kopf"}),
	    "Don't loose your head!");
  
  cloned = 0;        
  
  AddExit("norden", RAVINE "raum09");
  AddSpecialExit("sueden", "get_leopard");
}

nosave int get_leopard(string dir)
{
  object obj;
  
  if(TP->QueryGuest())
    return write("Du traust Dich nicht weiter nach Sueden!\n"),1;
  
  if(!present("\narthoas_leopard") && !cloned)
    {
      clone_object(NPC "leopard")->move(ME, M_NOCHECK|M_NO_ATTACK|M_SILENT);
      cloned=1;
      write(BS("Ein Raubtier springt ploetzlich aus dem Hinterhalt hervor.")+ 
	    "Das Raubtier stellt sich Dir in den Weg.\n");
      return 1;
    }

  if((obj=deep_present("hinterlauf", TP)) && (present("\narthoas_leopard")))
    {
      call_out("get_wild", 1, obj);
      
      TP->SetProp(P_PARALYZED, 
	  ([PARALYZE_TIME:6,
	    PARALYZE_MSG: "Du starrst wie gebannt auf den Leopard!\n"]));
    }

  if(present("\narthoas_leopard"))
    return write(BS("Der Leopard stellt sich Dir in den Weg.\n")),1;
  else
    TP->move(RAVINE "raum10", M_GO, "nach Sueden");  
 
  return 1;
}

reset()
{
  ::reset();
  
  if(!present("\narthoas_leopard",ME)) cloned=0;
}


nosave get_wild(object ob)
{
  if((find_call_out("get_wild2")==-1)||(find_call_out("get_wild3")==-1))
    {
      call_out("get_wild2", 2, ob);
      write(BS("Der Leopard kommt langsam aber bedrohlich auf Dich zu.\n"));
    }
}

nosave get_wild2(object ob)
{
  if(present(TP, ME))
    {
      call_out("get_wild3", 2, ob);
      write("Ploetzlich springt Dich der Leopard an.\n");
      write(BS("Im allerletzten Moment gelingt es Dir beiseite zu springen.\n"));
    }
}

nosave get_wild3(object ob)
{
  if(present(TP, ME))
    {
      TP->SetProp(P_PARALYZED, 0);
      
      write(BS("Noch bevor der Leopard seinen zweiten Angriff startet " 
	       "faellt Dir das Fleisch ein, das Du bei Dir hast, und wirfst "
	       "es dem Leopard zu, worauf er von Dir ablaesst."));
      
      TP->move(RAVINE "raum10", M_GO, "nach Sueden");

      ob->remove();

      catch(present("\narthoas_leopard",ME)->remove(1));

      cloned=1;
    }
}
