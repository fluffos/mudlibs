//Ar-Thoas
//desert

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"


create()
{
	::create();

	SetProp( P_INT_SHORT, "Eingang zur Schlucht" );
	SetProp( P_INT_LONG,
		"Bei der Einkerbung handelt es sich, wie Du nun unschwer "+
		"erkennen kannst, um eine Schlucht, die sich in suedliche Richtung "+
		"erstreckt. Der Pfad endet hier in oestlicher Richtung und "+
		"fuehrt weiter nach Sueden abwaerts in die Schlucht. "
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 33, ENV_TERRAIN:TT_ROAD]) );
	
	STANDARD1
	STDSKY1
	
	AddDetail("pfad",
		  "Der Pfad endet hier in oestlicher Richtung und "
		  "fuehrt weiter nach Sueden abwaerts in die Schlucht.");

	AddDetail("raum",
		"Jaaa, Du bist in einem Raum, open-air sozusagen. ");
	
	AddDetail("koepfe",
		"Hier siehst Du nur einen, und der ist noch dort wo er hin gehoert, "+
		"auf Deinem Hals. ");
		
	AddDetail("hals",
		"Was wird das? Eine Koerperstudie, oder was !?! ");
		
	AddDetail( ({"koerperstudie", "studie", "koerper"}),
		"Lass das mal lieber...Deinen Koerper entdeckst Du doch besser fuer Dich "+
		"allein. ");
	
	AddDetail( ({"mensch", "menschen"}),
		"Menschen findest Du primaer in Midas, das ist ihre Stadt. ");
		
	AddDetail( ({"midas", "metropole", "stadt"}),
		"Sag bloss Du kennst die Metropole Midas nicht...schaem Dich! ");
	
	AddDetail("steinbock",
		"Arthoas ist Steinbock, allerdings auch bloss vom Sternzeichen. ");
		
	AddDetail( ({"sternzeichen", "sterne", "stern"}),
		"Es ist viel zu hell, um Sterne zu sehen. ");
	
	AddDetail("macht",
		"Diese Berge sind wahrlich beeindruckend hoch. ");
	
	AddDetail("gott",
		"Hoffentlich steht er Dir bei, bei all den Gefahren die moeglicherweise "+
		"noch auf Dich lauern. ");
		
	AddDetail( ({"gefahr", "gefahren"}),
		"Worauf wartest Du? Du wirst doch keine Angst haben, oder? ");
		
	AddDetail("angst",
		"Noe, sowas kennst Du doch nicht =:> \n");
	
	AddDetail("entfernung",
		"Auf, auf, vor Dir liegt noch ein langer Weg. ");
	
	AddDetail("abkuehlung",
		"Sei nicht so zimperlich. \n");
	
	AddDetail("gestein",
		"Im Erdinneren ist es fluessig. \n");
	
	AddDetail( ({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
		"Unter Dir. Aber genau genommen siehst Du sowas hier nicht. \n");
	
	AddDetail( ({"einkerbung", "schlucht"}),
		"Vor Dir ragen die Berge, mit all ihrer statischen Macht, die seit einem "+
		"Aeon Zeit hatte zu wachsen, in den Himmel. Sie scheinen Dich davor "+
		"zu warnen, Wege zu beschreiten, denen Du moeglicherweise noch nicht "+
		"gewachsen bist. ");
		
	AddDetail("koenigsblau",
		"*grins* That's Arth's favorite. ");
	
	AddDetail( ({"flora", "bewuchs"}),
		"Flora? Naja vielleicht hast Du ja ein paar Bluemchen oder aehnliches "+
		"bei Dir, aber hier findest Du dergleichen bestimmt nicht. ");
		
	AddDetail("bluemchen",
		"Hast Du welche? Hier sind wie gesagt keine. \n");
		
	AddDetail( ({"untergrund", "grund"}),
		"Steine, Steine und nochmal Steine...nichts als Steine...wie oed. ");
		
	AddDetail( ({"wege", "weg"}),
		"Trau Dich doch mutiger Abenteurer. ");
		
	AddDetail("abenteurer",
		"Abenteurer hat das Silberland schon viele kommen und gehen gesehen. ");
		
	AddDetail("welt",
		"Das hier ist das Silberland, aber da war doch noch was...*gruebel* "+
		"oh, rl glaube ich wars...naja, ist ja auch egal. ");
		
	AddDetail("silberland",
		"Diese Welt heisst Silberland. \n");
		
	AddDetail( ({"stein", "steine"}),
		"Lass das mal lieber. Schliesslich bist Du kein Steinbock, dass Du "+
		"auf den Steinen so rum turnst. Ist schliesslich nicht ganz ungefaehrlich. ");
		
	AddDetail( ({"hoehe", "jahre", "jahr"}),
		"Das siehst Du hier nicht. \n");

	AddExit( "sueden", RAVINE+"raum09" );
	AddExit("westen", PATH+"raum07");
}
