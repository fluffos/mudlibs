inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"

string d_mission(string str);
string d_ptahla(string str);
string d_temp(string str);

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Tief in einem Berg");
  SetProp(P_INT_LONG,  
	  BS("Da stehst Du nun Du armer Tor, und bist so klug als wie zuvor. " 
	     "Der Fels ist angenehm kuehl, eine richtige Wohltat, nach den "
	     "Temperaturen, denen Du in der Wueste ausgesetzt warst. Im Nord- "
	     "und Suedosten flackern kleine Lichter."));
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]));
  
  AddDetail("waende",
	    "Die Waende rings um Dich herum wurden, worauf der Fels schliessen " 
	    "laesst, in grosser Eile bearbeitet. Vermutlich bestand grosses " 
	    "Interesse daran, moeglichst schnell ins Innere des Berges vorzustossen. "
	    "Aber irgendwie sind die Waende nicht alle gleich.");
  AddDetail("wand",
	    "Welche Wand meinst Du denn?");
  AddDetail("ostwand",
	    "Tatsaechlich, mit der Ostwand stimmt etwas nicht. Es sieht fast so aus, "
	    "als waere die Hoehle an dieser Stelle kuenstlich verschlossen worden. " 
	    "Was wohl der Grund dafuer gewesen sein mag, dass man diesen Teil der " 
	    "Hoehle wieder zumauerte, ist Dir ein Raetsel.");
  AddDetail("stelle",
	    "Es sieht fast so aus, als koennte man, wenn man " 
	    "das richtige Werkzeug verwendet durch die Wand durchbrechen. " 
	    "Vorausgesetzt naruerlich es laesst sich eine Schwachstelle finden.");
  AddDetail("schwachstelle",
	    "Also auf den ersten Anblick kannst Du keine Schwachstelle entdecken.");
  AddDetail("anblick",
	    "Vielleicht solltest Du es ja auf noch einen Versuch ankommen lassen, " 
	    "eine Schwachstelle zu entdecken.");
  AddDetail("versuch",
	    "Egal wie oft Du es noch versuchst, Du kannst keine Schwachstelle "
	    "ausmachen. Moeglicherweise liegt es aber auch daran, dass Du nicht "
	    "genau genug suchst?");
  AddDetail("eile",
	    "In der Ruhe liegt die Kraft!");
  AddDetail("interesse",
	    "Was wohl die Erbauer dieser Hoehlen angetrieben haben mag?");
  AddDetail("erbauer",
	    "Ob wohl die Erbauer fuer das flackern der Lichter verantwortlich sind?");
  AddDetail("lichter",
	    "Scheinbar ist dort jemand. Eine andere Erklaerung hierzu faellt Dir so " 
	    "auf die Schnelle nicht ein.");
  AddDetail("schnelle",
	    "Auch wenn Du laenger darueber bruetest, kommst Du zu keinem anderen " 
	    "Ergebnis, als dass dort hundertprozentig jemand sein muss.");
  AddDetail(({"erklaerung", "ergebnis"}),
	    "Dort ist jemand!");
  AddDetail("suedosten",
	    "Dort flackern kleine Lichter. Wer dort wohl sein mag? Und ueberhaupt, " 
	    "wenn jemand dort ist, was macht derjenige dort?");
  AddDetail("boden",
	    "Der Boden ist genauso nichtssagend wie alles andere hier auch, bis auf " 
	    "die Tatsache, dass hier ein kleiner Wuestenfuchs sein Heim eingerichtet "
	    "hat.");
  AddDetail(({"nische", "heim", "schlafplatz", "platz"}),
	    "In einer kleinen Nische hat er seinen Schlafplatz eingerichtet, und " 
	    "ein Stueck davon entfernt tuermen sich die bereits zum Teil verrotteten "
	    "Ueberreste von seinen Mahlzeiten.");
  AddDetail(({"ueberreste", "reste"}),
	    "Zum Teil sind sie schon verrottet, andere wiederum scheinen noch "
	    "relativ frisch zu sein.");
  AddDetail(({"mahlzeit", "mahlzeiten"}),
	    "Also Dich wird er sicher nicht verspeisen der kleine Wuestenfuchs.");
  AddDetail(({"wuestenfuchs", "fuchs", "hoehlenbewohner"}),
	    "Scheinbar ist gerade keiner da, vielleicht ist er ja auf der Suche nach "
	    "Beute.");
  AddDetail("decke", 
	    ([
	      0: 
	      "Die Decke ueber Dir ist genauso kahl und feucht " 
	      "wie der uebrige Fels hier ueberall.", 
	      "zwerg": 
	      "Die Decke ist viel zu weit " 
	      "entfernt, um genaueres feststellen zu koennen, aber vermutlich ist "
	      "sie genauso kalt und kahl wie der uebrige Fels.", 
	      "troll": 
	      "Naja, auf deine Zehenspitzen darfst Du Dich nicht stellen, sonst "
	      "stoesst Du Dir den Kopf an der kahlen kalten Decke."]));
  AddDetail("fels",
	    "Er ist kalt und kahl. Ausserdem wurde er nicht sehr sorgfaeltig " 
	    "bearbeitet, scheinbar war es wichtiger den Raum moeglichst rasch " 
	    "fertig zu stellen, als auf Feinheiten zu achten.");
  AddDetail("feinheiten",
	    "Hier wurde nicht auf Feinheiten geachtet, der Fels ist rauh und sehr " 
	    "ungleichmaessig.");
  AddDetail(({"hoehle", "raum"}), 
	    ME->QueryProp(P_INT_LONG));
  AddDetail("wohltat",
	    "Du geniesst die angenehme Temperatur hier.");
  AddDetail("ruhe",
	    "Glaubst Du wirklich, dass Du erfolgreich sein wirst, wenn Du 'Ruhe' " 
	    "untersuchst?");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst Du wie die Sklavenarbeiter hier unaufhoerlich den Fels "
	   "bearbeitet.");
  AddSound(({"geraeusch", "geraeusche", "entfernung"}),
	   "Du bist nicht nahe genug an der Quelle der Geraeusche dran.");
  AddSound("quelle",
	   "Du lokalisierts die Quelle jeweils im Nord- und im Suedosten.");
  AddSound("ruhe",
	   "Aber hier ist es doch garnicht ruhig.");
  
  AddSpecialDetail(({"mission"}), "d_mission");
  AddSpecialDetail(({"ptahla"}), "d_ptahla");
  AddSpecialDetail(({"temperatur"}), "d_temp");
}

string d_mission(string str)
{
  if(present("\nfree_souls", TP))
    return BS("Hat Dich der Moench nicht ausgesandt, um eine " 
	      "delikate Angelegenheit zu regeln?");
  
  if(present("\fennek", TP))
    return BS("Wolltest Du Ptahla nicht etwas bringen?");
  
  return BS("Du befindest Dich derzeit auf keiner Mission, " 
	    "oder etwa doch?");
}

string d_ptahla(string str)
{
  if(present("\fennek", TP))
    return BS("Hier wirst Du sie sicher nicht finden, sie ist " 
	      "und bleibt wo sie hingehoert.");
  
  return "Sowas siehst Du da nicht.\n";
}

string d_temp(string str)
{
  if(deep_present("thermometer", TP))
    return BS("Um die Temperatur zumindest ungefaehr zu erfahren " 
	      "koenntest Du doch einmal Dein Thermometer untersuchen.");
  
  return BS("Tsja, haettest Du ein Thermometer bei Dir, so " 
	    "koenntest Du einen Blick darauf werfen, aber so musst Du Dich leider " 
	    "damit begnuegen, dass es hier herinnen angenehm kuehl ist.");
}
