/*
  Ar-Thoas
  desert
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad" );
  SetProp(P_INT_LONG,
	   "Den See hast Du nun hinter Dir gelassen, nur noch bei genauerem "+
	   "Betrachten kannst Du seine Umrisse schwach wahrnehmen. Dafuer hast "+
	   "Du Dich dem Berg genaehert, und er sieht jetzt noch viel hoeher "+
	   "und maechtiger aus als zuvor. Seine Gipfel, die weit in den Himmel "+
	   "ragen, regen Deine Neugier an. Der Pfad fuehrt leicht ansteigend "+
	   "weiter in noerdliche Richtung. Wenn Du Deinen Blick gegen den "+
	   "Horizont richtest, kannst Du das Flimmern der Luft um Dich herum "+
	   "sehen, das durch die hohe Umgebungstemperatur verursacht wird. "
	   );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_ROAD]) );
  
  STANDARD1
  STDSKY1
  
  AddDetail("platin",
	    "Ist doch einigermassen wertvoll denk ich. ");
  AddDetail(({"silber", "gold"}),
	    "Reden ist Silber doch schweigen ist Gold. ");
  AddDetail(({"mensch", "menschen"}),
	    "Iiiiih, Menschen! Ist ja ekelig. \n");
  AddDetail("koepfe",
	    "Don't loose your head!\n");
  AddDetail("hoehe",
	    "Ui, das ist ja wirklich sehr weit oben. \n");
  AddDetail("hunger",
	    "Was!?! jetzt schon? \n");
  AddDetail(({"jahr", "jahre"}),
	    "Jo, wir alle kommen in die Jahre, mit der Zeit halt...=:>-~~~ ");
  AddDetail("betrachten",
	    "Etwas betrachten bedeutet, dass man etwas ansieht. \n");
  AddDetail(({"abkuehlung", "temperaturruckgang"}),
	    "Den Prozess des Temperaturrueckganges bezeichnet der plebs allgemeinhin "+
	    "als Abkuehlung. \n");
  AddDetail(({"temperaturrueckgang", "rueckgang"}),
	    "Wenn es kaelter wird spricht man von Temperaturrueckgang. ");
  AddDetail("prozess",
	    "Momentan findet kein Prozess statt, oder hat Dich wer geklagt? ");
  AddDetail(({"see", "details"}),
	    "Du bist viel zu weit weg, um Details zu erkennen. ");
  AddDetail("auge",
	    "Na geh, nicht schon wieder...");
  AddDetail(({"umriss", "umrisse"}),
	    "Du kannst sie gerade noch erahnen, mehr ist von dieser Entfernung "+
	    "bei bestem Willen nicht moeglich. ");
  AddDetail(({"wille", "willen"}),
	    "Du hast doch einen eigenen, oder? ");
  AddSmell(DEFAULT_SMELL,
	   "Hier riecht es irgendwie komisch, um nicht zu sagen es stinkt fast "+
	   "schon. ");
  AddSmell("gestank",
	   "Der 'Duft' wird Dir aus dem Norden entgegengetragen. ");
  AddDetail("norden",
	    "Sicherlich, lass uns Norden untersuchen. ");
  AddSmell("Duft",
	   "Naja, von Duft im positiven kann man in diesem Fall sicher nicht "+
	   "sprechen. ");
  AddDetail("neugier",
	    "Hm...Neugier ist eine Empfindung und daher schwerlich zu untersuchen. ");
  AddDetail("empfindung",
	    "zb. Neugier? \n");
  AddDetail("gott",
	    "Ob er existiert?\n");
  AddDetail("gestein",
	    "Im Erdinneren ist es fluessig. \n");
  AddDetail(({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
	    "Unter Dir. Aber genau genommen siehst Du sowas hier nicht. \n");
  AddDetail(({"pflanzen", "bewuchs"}),
	    "Naja, Bewuchs ist ein wenig uebertrieben, Gras waechst am Boden, und "+
	    "hin und wieder siehst Du ein paar Buesche.");
  AddDetail(({"busch", "buesche", "dornbusch", "dornbuschen", "buschen"}),
	    "Scheinen Dornbuschen zu sein, die ausser laestig picksen eigentlich "+
	    "nicht wirklich recht Nuetzliches koennen. ");
  AddDetail("nuetzliches",
	    "Na zB den Weltfrieden herbeifuehren, den Hunger der Welt stillen...uva. ");
  AddDetail("weltfriede",
	    "Ob Du den wirklich erwirken kannst? \n");
  AddDetail("welt",
	    "Mir hat mal wer erzaehlt, dass ausser dem Silberland noch eine andere "+
	    "existiert. -allerdings hab ich so meine Zweifel. ");
  AddDetail("zweifel",
	    "Da hast Du schon recht untersuche die Zweifel - PRUEFE - auf ihre "+
	    "Existenzberechtigung. ");
  AddDetail("Silberland",
	    "Oohja, das ist herrlich! Haette eigentlich mehr als 'Silber-' verdient, "+
	    "ich denke da so an Platin, aber das wuerde halt dann auch nicht so gut "+
	    "klingen: Platinland -neeeeee das kommt nich gut du. ");
  AddDetail("gras",
	    "Vor langer Zeit waren das bestimmt saftige gruene Wiesen, doch heute "+
	    "ist davon bloss noch verdorrtes Gras ueber. ");
  AddDetail(({"wiese", "wiesen"}),
	    "Sowas siehst Du da nicht mehr! ");
  AddDetail(({"untergrund", "grund"}),
	    "Eine doch recht trockene und staubige Angelegenheit. ");
  AddDetail("angelegenheit",
	    "Kuemmer Dich um Deine eigenen!");
  AddDetail("raum",
	    "Jaaa, Du bist in einem Raum, open-air sozusagen. ");
  AddDetail("steppe",
	    "Suedlich von Dir erstreckt sie sich in schier unaufhaltsamen Dimensionen.");
  AddDetail(({"dimension", "dimensionen"}),
	    "Bedaechtig zaehlst Du sie ab, und kommst zu dem Schluss, dass es wohl "+
	    "4 sein muessen, oder?");
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite. ");
  AddDetail("entfernung",
	    "Wie weit genau kannst Du nicht feststellen, aber es scheint doch noch "+
	    "recht weit zu sein. ");
  AddDetail("blick",
	    "Du koenntest ihn ja mal so rumschweifen lassen, das wuerde sich dann "+
	    "wahrscheinlich auch auszahlen, wenn es was zu sehen gaebe. ");
  
  SetProp(P_HIDE_EXITS, ({"suedwesten"}) );
  
  AddExit("suedwesten", PATH+"raum01");
  AddExit("norden", PATH+"raum03" );
  AddExit("suedwestunten", PATH+"raum01");
}
