inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Nomadenzelt");
  SetProp(P_INT_LONG,
	   "Du stehst im Zelt des Anfuehrers der Tuareg, das von der Witterung schon "+
	   "ziemlich mitgenommen aussieht. Hier findest Du nichts, das fuer Dich von Wert "+
	   "sein koennte, ausser den Anfuehrer selbst...naja wer weiss. \n");

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  GROUND6
  STANDARD6
    
  AddDetail(({"zelt"}), 
	    ME->QueryProp(P_INT_LONG));
  AddDetail(({"witterung", "hitze", "sand", "wind"}),
	    "Hitze, Sand und Wind haben ihre Spuren an dem Zelt hinterlassen.");
  AddDetail(({"spuren", "risse", "loecher"}),
	    "Pure Abnuetzungserscheinungen eben.\n");
  AddDetail(({"abnuetzung", "erscheinungen", "abnuetzungserscheinungen"}),
	    "Risse, Loecher?\n");

  AddSpecialDetail(({"anfuehrer", "tuareg"}), "find_chief");
  
  AddExit("sueden", ARAGH "raum49");

  AddItem(NPC "tuareganfuehrer", REFRESH_DESTRUCT);
  AddItem(NPC "tuaregkrieger", REFRESH_DESTRUCT);
  AddItem(NPC "tuaregkrieger", REFRESH_DESTRUCT);
  AddItem(NPC "tuaregkrieger", REFRESH_DESTRUCT);
  
  
}

find_chief()
{
  if (!present("~chief"))
    return "Scheinbar ist er gerade anderweitig beschaeftigt.\n";
}

