inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

/*
  uebergabewerte: 
  1. pfad (wo der npc geclont werden soll; 
  2. pfad (in welchem verz npc zu hause ist)
  3. eine id des npc's mit der er angesprochen werden kann...
*/

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Dass Du die Hitze nicht allzulang ertragen kannst, dessen bist Du Dir " 
	     "bewusst. Nun bist Du oestlich des Berges, von dem Du noch vor einiger " 
	     "Zeit dachtest, dass er unueberwindbar sei, und Dir daher diese Seite " 
	     "fuer immer verborgen bliebe. Die Sonne brennt herunter, und wenn Du " 
	     "dachtest im Dschungel ist es heiss, so wirst Du nun eines besseren " 
	     "belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 38, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD3
  STDSKY3
	
  AddDetail(({"3000m"}),
	    "Irre hoch ist das.");
  AddDetail(({"irre"}),
	    "Neee, bist Du nicht...naja, vielleicht ein klein wenig...");
  AddDetail(({"gehirn"}),
	    "Haettest wohl gern eines, haeh?");
  AddDetail(({"punkt", "linie", "ebene", "koerper"}),
	    "Punkt == 0dimensional, Linie == 1dimensional, Ebene == 2dimensional, " 
	    "Koerper == 3dimensional, und die 4. Dimension, vermutet man, "
	    "ist die Zeit.");
  AddDetail(({"dimension"}),
	    "Du siehst einen Fehler im Raum-Zeit-Gefuege.");
  AddDetail(({"seite", "a4", "A4"}),
	    "Nu A4 ist 297 mal 210mm...etc...");
  AddDetail(({"vorankommen"}),
	    "Je eine Duene im Westen und im Osten versperren Dir den Weg.");
  AddSmell(DEFAULT_SMELL,
	   "Hier ist einfach alles geruchlos.");
  AddSound(DEFAULT_SOUND,
	   "Nicht ein einziger Ton ist hier zu hoeren.");
  AddDetail(({"duene"}),
	    "Du hast das Gefuehl, als sehe eine wie die andere aus.");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand.");
  AddDetail(({"sand"}),
	    "Du kannst an diesem Sand nichts Besonderes erkennen.");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  
  AddExit("norden", RAVINE "raum10");
  AddExit("sueden", VALLEY "raum28");
}

reset()
{
  ::reset();
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}




















