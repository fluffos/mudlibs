//Ar-Thoas
//desert

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

int cloned;

string found_lanner(string key);

create()
{
	::create();

	SetProp( P_INT_SHORT, "Steppenpfad" );
	SetProp( P_INT_LONG,
		"Der Pfad fuehrt leicht ansteigend von nun an nach Osten "+
		"weiter. Sofern Du Deinen Augen trauen darfst, bei der "+
		"Umgebungstemperatur beginnst Du schon langsam daran zu "+
		"zweifeln, scheint auch der Berg, in nicht allzugrosser "+
		"Ferne, das Ende seiner oestlichen Ausbreitung zu erreichen. "+
		"Das Flimmern der Luft hat bereits deutlich zugenommen, und "+
		"im Gegensatz dazu die Vegetation ab. "
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 31, ENV_TERRAIN:TT_ROAD]) );

	STANDARD1
	STDSKY1

	AddDetail("mensch",
		"Ob vor Dir wohl schon mal wer hier war? ");
	
	AddDetail("ferne",
		"Bald hast Du auch das Ende seiner oestlichen Ausbreitung erreicht. ");
	
	AddDetail("entfernung",
		"Zu weit entfernt, um noch was zu erkennen. ");
	
	AddDetail("ende",
		"Alles hat ein Ende nur die Knarkhwurst zwei. ");
		
	AddDetail( ({"knarkhwurst", "wurst"}),
		"Vielleicht findest Du in Knarkh was Du suchst. ");
		
	AddDetail("knarkh",
		"Hm...irgendwo suedwestlich von Midas. ");
		
	AddDetail( ({"midas", "metropole"}),
		"Sag bloss Du kennst die Metropole Midas nicht...schaem Dich! ");

	AddDetail("ausbreitung",
		"Irgendwo im Osten, genaueres kannst Du von hier nicht sehen. ");
	
	AddDetail( ({"auge", "aug", "augen"}),
		"Du hast 2 davon, erstaunlich gell? \n");
	
	AddDetail("gestein",
		"Im Erdinneren ist es fluessig. \n");
	
	AddDetail( ({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
		"Unter Dir. Aber genau genommen siehst Du sowas hier nicht. \n");
	
	AddDetail("koenigsblau",
		"*grins* That's Arth's favorite. ");

	AddDetail( ({"gras", "bewuchs", "vegetation"}),
		"Allmaehlich vermischen sich Gras und steiniger Untergrund. Wobei das "+
		"Gras hier eine eigenartige Faerbung aufweist. ");
		
	AddDetail("faerbung",
		"Das Gras ist hier nicht so vergilbt wie im Sueden. Offenbar hat der "+
		"Boden hier mehr Feuchtigkeit in sich gespeichert. ");
		
	AddDetail( ({"untergrund", "feuchtigkeit"}),
		"Dadurch, dass der Untergrund hier schon um einiges haerter ist, als im "+
		"Sueden, dauert es laenger, bis das Wasser in den Boden sickert. ");
		
	AddDetail("wasser",
		"Haettest Du moeglicherweise gern, aber hier siehst Du keines. ");
		
	AddDetail( ({"stelle", "erhoehung"}),
		"Sie befindet sich nun suedoestlich von Dir, und Du hast Dich wieder "+
		"ein schoenes Stueck dem Berg genaehert. ");
		
	AddDetail( ({"monument", "erscheinung", "erhoehung"}),
		"Obwohl Du keine Details erkennen kannst bist Du doch beeindruckt. "+
		"Nicht bloss ob der Hoehe, nein auch deshalb, weil es den Anschein "+
		"hat, als waere diese Erhoehung von Menschen erschaffen worden, "+
		"und Dich verwundert, wie Menschen ueberhaupt jemals in der Lage "+
		"waren solche Hoehen zu erklimmen. ");
		
	AddDetail("hoehe",
		"An seiner hoechsten Stelle misst der Berg satte 3003 m. ");
		
	AddSound(DEFAULT_SOUND,
		"Komisch Dir war so, als haettest Du ein *Zischen* gehoert. \n");
		
	AddSound("zischen",
		"Tatsaechlich da war es schon wieder. Vielleicht solltest Du "+
		"genauer hin hoeren. ");

	AddSound( ({"genau"}), #'found_lanner);


	SetProp(P_HIDE_EXITS, ({"suedwesten"}));

	AddExit("suedwesten", PATH+"raum05");
	AddExit( "osten", PATH+"raum07" );
	AddExit("suedwestunten", PATH+"raum05");
}


string found_lanner(string key)
{
	if (cloned)
	{
		if (present ("lanner"))
			return "Das hast Du doch bereits hinter Dir!?!\n";
		else
			return "War wohl bloss der Wind...\n";
	}
	else
	{
		write(break_string("Waehrend Du Deine Ohren spitzt und in Lauschstellung gehst, "+
			"ist Dein Schicksal besiegelt.\n", 78) );
		clone_object(NPC+"lanner") -> move(this_object(), M_NOCHECK);
		cloned = 1;
	}
	return "";
}

reset()
{
	if (!present("lanner")) cloned = 0;
	::reset();
}
