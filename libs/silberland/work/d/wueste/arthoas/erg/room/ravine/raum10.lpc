/*
  Ar-Thoas
  desert
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "ravine.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Schlucht");
  SetProp(P_INT_LONG,
	  BS("Suedlich endet die Schlucht, und eine oede Landschaft erstreckt " 
	     "sich vor Dir links begrenzt durch ein gewaltiges Bergmassiv " 
	     "und rechts durch die Unueberwindbarkeit des Gelaendes."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 36, ENV_TERRAIN:TT_MOUNTAIN]));
  
  STANDARD2
  STDSKY2
  
  AddDetail(({"boden"}),
	    "Nichts als Felsen und Steine.");
  AddDetail(({"felsen", "steine", "dinger"}),
	    "Felsen sind grosse Steine, und Stein sind kleine Felsen. " 
	    "Nein im ernst, interessieren Dich die Dinger wirklich? " 
	    "Wenn ja geh in eine Buchhandlung und besorg Dir ein " 
	    "diesbezuegliches Fachbuch.");
  AddDetail(({"buchhadlung"}),
	    "Vielleicht findest Du ja eine, wenn Du genau suchst...=:) ");
  AddDetail(({"fachbuch", "buch"}),
	    "So was aber auch! Liegt hier keines mehr 'rum? Na dann muss " 
	    "es wohl schon jemand vor Dir genommen haben (Du koenntest ja " 
	    "auf einen Raumreset warten =:))) ");
  AddDetail(({"wolke"}),
	    "Du hast Pech, jetzt ist gerade keine da.");
  AddDetail(({"felswaende", "waende"}),
	    "Leider viel zu steil, um daran hoch zu klettern.");
  AddSmell(DEFAULT_SMELL,
	   "Leichter Faeulnisgeruch aus dem Norden draengt sich Deiner Nase auf.");
  AddSmell(({"faeulnis"}),
	   "Vielleicht versuchst Du Dein Glueck im Norden? ");
  AddDetail(({"gelaende"}),
	    "Niemals, dort hin solltest Du bloss gehen, falls Du den Tod suchst.");
  AddDetail(({"tod"}),
	    "Dich will er noch nicht, aber vielleicht schon bald? ");
  AddDetail(({"horizont"}),
	    "Weiter als bis zum Horizont siehst auch Du nicht.");
  AddDetail(({"landschaft"}),
	    "Suedlich endet die Schlucht, und eine oede Landschaft erstreckt " 
	    "sich vor Dir links begrenzt durch ein gewaltiges Bergmassiv " 
	    "und rechts durch die Unueberwindbarkeit des Gelaendes.");
  AddDetail(({"unueberwindbarkeit"}),
	    "Das Gelaende laesst kein Vorankommen zu.");
  AddDetail(({"vorankommen"}),
	    "In noerdlicher Richtung und in suedlicher ist ein Vorankommen " 
	    "moeglich.");
  AddDetail(({"richtung"}),
	    "Das ist doch wohl relativ, oder? ");
  AddDetail(({"punkt", "seite"}),
	    "Sowas siehst Du hier beim besten Willen nicht.");
  AddDetail(({"wille"}),
	    "Hoffentlich hast Du genug davon...");
  
  AddExit("norden",    RAVINE "raum09a");
  AddExit("sueden",    VALLEY "raum27");
  AddExit("suedosten", VALLEY "raum34");
}
