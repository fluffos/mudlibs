inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Dass Du die Hitze nicht allzulang ertragen kannst, dessen bist Du Dir " 
	     "bewusst. Nun bist Du oestlich des Berges, von dem Du noch vor einiger " 
	     "Zeit dachtest, dass er unueberwindbar sei, und Dir daher diese Seite " 
	     "fuer immer verborgen bliebe. Die Sonne brennt herunter, und wenn Du " 
	     "dachtest im Dschungel ist es heiss, so wirst Du nun eines besseren " 
	     "belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 40, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD3
  STDSKY3
  
  AddDetail(({"gehirn"}),
	    "Das Vorhandensein des selbigen, vereinfacht den Denkprozess. \n");
  AddDetail(({"denkprozess"}),
	    "try one... \n");
  AddDetail(({"vorhandensein"}),
	    "Sowas siehst Du hier nicht. \n");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.\n");
  AddDetail(({"seite"}),
	    "Wenn Du lieb und nett bist, schick ich Dir mal ne Seite voll mit " 
	    "Orten an denen Du Forscherpunkte findest. \n");
  AddDetail(({"punkt"}),
	    "-= . =- \n");
  AddDetail(({"orte"}),
	    "Hm...vielleicht suchst Du doch besser selbst danach. ");
  AddDetail(({"forscherpunkte"}),
	    "Ohje...die hat Dir schon wer weggeschnappt. \n");
  AddSmell(DEFAULT_SMELL,
	   "Nahezu absolut geruchlos ist die Wueste hier.\n");
  AddSound(DEFAULT_SOUND,
	   "Aus dem Suedosten dringen Geraeusche an Dein Ohr, die menschliches " 
	   "Leben vermuten lassen. ");
  AddSound(({"geraeusche"}),
	   "Von hier kannst Du nichts genaueres feststellen, vielleicht solltest " 
	   "Du naeher ran gehen? ");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand!\n");
  AddDetail(({"sand"}),
	    "Du kannst an diesem Sand nichts Besonderes erkennen.\n");
  AddDetail(({"vorankommen"}),
	    "Als einziger Ausgang steht Dir Norden zur Verfuegung, alle anderen " 
	    "sind durch eine Sichelduene versperrt. ");
  AddDetail(({"sichelduene"}),
	    "Diese Duenenart entsteht, wenn der Wind laengere Zeit aus einer " 
	    "Richtung blaest. ");

  AddExit("norden", VALLEY "raum35");
}

reset()
{
  ::reset();
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}
