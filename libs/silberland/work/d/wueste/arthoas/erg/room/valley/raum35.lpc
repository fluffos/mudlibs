inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Dass Du die Hitze nicht allzulang ertragen kannst, dessen bist Du Dir " 
	     "bewusst. Oestlich ragt das Tibesti-Gebirge empor, das Du wohl niemals " 
	     "ueberwinden wirst. Die Sonne brennt herunter, und wenn Du " 
	     "dachtest im Dschungel ist es heiss, so wirst Du nun eines besseren " 
	     "belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 38, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD3
  STDSKY3
  
  AddDetail(({"gehirn"}),
	    "Sowas siehst Du hier nicht.  :>-~~~");
  AddDetail(({"punkt"}),
	    "Was ist los mit Dir?!? " 
	    "Lass die daemliche Forscherei, metzel lieber was!");
  AddDetail(({"forscherei"}),
	    "Noe, so wird das nix.");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand...daran wird sich so schnell auch nichts aendern.");
  AddDetail(({"sand"}),
	    "Vielleicht kann man ja darin graben?");
  AddDetail(({"vorankommen"}),
	    "Im Westen versperrt Dir eine Duene den Weg, und im Osten " 
	    "ragt die Felswand des Tibesti-Gebirges steil empor.");
  AddDetail(({"wand", "felswand"}),
	    "Daran hoch zu klettern kannst Du gleich vergessen, dafuer ist " 
	    "sie viel zu steil. Fast haettest Du knapp ueber dem Boden eine " 
	    "kleine Oeffnung uebersehen.");
  AddDetail(({"oeffnung"}),
	    "Sie ist gross genug, um durchzukriechen, aber was wohl darin " 
	    "auf Dich wartet?");
  AddSmell(DEFAULT_SMELL,
	   "Nahezu absolut geruchlos ist die Wueste hier.");
  AddSmell(({"wueste"}),
	   "Was soll das? Willst Du Dir ein paar Sandkoerner reinziehen?");
  AddSound(DEFAULT_SOUND,
	   "Hin und wieder kannst Du ein leises Pfeifen wahrnehmen.");
  AddSound(({"pfeifen","duenen","sandduenen"}),
	   "Als Du genau lauscht, kannst Du das Pfeifen hoeren, das " 
	   "der Wind verursacht, wenn er ueber die Sandduenen blaest.");
  
  AddCmd(({"krieche", "kriech"}), "climb_cave");
  AddCmd(({"grab","grabe"}), "graben");
  
  AddExit("norden",     VALLEY "raum34");
  AddExit("sueden",     VALLEY "raum36");
  AddExit("suedwesten", VALLEY "raum29");
  AddExit("suedosten",  ARAGH "raum41");
}

nosave graben(string str)
{
  notify_fail("Wo willst Du denn graben?\n");
  if(!str) return 0;
  
  if(str=="erde"||str=="grabe in erde")
    return write(BS("Du faengst an mit blossen Haenden im Sand herumzugraben. "
		    "Nach einiger Zeit und halbverbrannten Fingerkuppen, laesst "
		    "Du es jedoch enttaeuscht bleiben und schuettest das "
		    "entstandene Loch wieder zu.")),1;
  return 0;
}

nosave climb_cave(string str)
{
  object ob;
  
  notify_fail("Wohin willst Du kriechen?\n");
  if(!str) return 0;
	
  if((str=="durch oeffnung")||(str=="in oeffnung")||(str=="oeffnung"))
    {
      write(BS("Behende kletterst Du durch die Oeffnung, und immer " 
	       "tiefer in die Hoehle, bis Du schliesslich die niedrigen Passagen " 
	       "hinter Dir gelassen hast, und Du nun genug Platz hast, um aufrecht "
	       "stehen zu koennen."));
				
      TP->move(VALLEY "cave01", M_GO, "im Berg", "verschwindet","klettert herein");
      return 1;
    }
  return 0;
}

reset()
{
  ::reset();
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}
