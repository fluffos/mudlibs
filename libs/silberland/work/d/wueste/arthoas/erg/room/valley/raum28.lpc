inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

nosave int cloned_scorpion;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Dass Du die Hitze nicht allzulang ertragen kannst, dessen bist Du Dir " 
	     "bewusst. Nun bist Du oestlich des Berges, von dem Du noch vor einiger " 
	     "Zeit dachtest, dass er unueberwindbar sei, und Dir daher diese Seite " 
	     "fuer immer verborgen bliebe. Die Sonne brennt herunter, und wenn Du " 
	     "dachtest im Dschungel ist es heiss, so wirst Du nun eines besseren " 
	     "belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 38, ENV_TERRAIN:TT_DESERT]));

  STDSKY3
  STANDARD3
    
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  AddDetail(({"gehirn"}),
	    "Oh tatsaechlich, Du koenntest noch etwas davon vertragen.");
  AddDetail(({"punkt"}),
	    "Hab ich irgendwo einen vergessen? ");
  AddDetail(({"seite", "seiten"}),
	    "Alles hat 2 Seiten, ausser...hehe, das ueberlass ich Deiner Phantasie.");
  AddDetail(({"phantasie"}),
	    "Pst. Behalts lieber fuer Dich.");
  AddDetail(({"vorankommen"}),
	    "Eine grosse Sichelduene erlaubt Dir bloss den Ort nach Norden " 
	    "zu verlassen.");
  AddDetail(({"sichelduene"}),
	    "Diese Duenenart entsteht, wenn der Wind laengere Zeit aus einer " 
	    "Richtung blaest.");
  AddSmell(DEFAULT_SMELL,
	   "Hier ist einfach alles geruchlos.");
  AddSound(DEFAULT_SOUND,
	   "Nicht ein einziger Ton ist hier zu hoeren.");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand...was sonst hast Du erwartet?");
  AddDetail(({"sand"}),
	    "Der Sand der Duene weist eine Unregelmaessigkeit auf.");
  AddDetail(({"duene", "unregelmaessigkeit"}),
	    "Bei eingehender Betrachtung faellt Dir an der suedlichen Seite " 
	    "ein kleiner Schatten auf.");
  AddDetail(({"betrachtung", "taetigkeit"}),
	    "Wie untersucht man eine Taetigkeit? ");
  AddDetail(({"schatten"}),
	    "Scheinbar handelt es sich dabei um den Eingang zu einem kleinen Bau.");
  AddDetail(({"eingang"}),
	    "Ein sehr kleines Loch.");
  AddDetail(({"loch"}),
	    "Viel zu klein fuer Dich, um durchzuklettern.");
  AddDetail(({"bau", "heim"}),
	    "Wessen Heim das wohl sein koennte?");
  
  AddCmd(({"greif", "greife", "fasse", "fass"}), "reach_in_hole");
  
  AddExit("norden", VALLEY "raum27");
}

nosave reach_in_hole(string str)
{
  object obj;
  int ran_num;
  
  notify_fail("Wo willst Du hineingreifen?\n");
  if(!str) return 0;
  
  if(str=="in loch")
    {
      write(BS("Du fasst allen Mut zusammen, und greifst in das kleine Loch."));
      say(BS(CAP(TPN)+" greift in ein kleines Loch."));
      
      cloned_scorpion += 1;
      
      switch (cloned_scorpion)
	{
	case 1:
	  write(BS("Ploetzlich schreist Du laut auf, und ziehst Deine " 
		   "Hand sofort wieder heraus."));
	  say(BS("aber zieht die Hand unmittelbar darauf "
		 "mit schmerzverzerrtem Gesicht wieder heraus."));
	  
	  TP->AddPoison(1+random(2));
	  
	  clone_object(NPC "scorpion")->move(ME, M_GO);
	  
	  return 1;
	  break;
	case 2:
	  write(BS("Du weisst eigentlich garnicht warum und weshalb " 
		   "Du eigentlich Deine Hand in das Loch gesteckt hast. Du weisst "
		   "jetzt eigentlich nur mehr, dass Du jetzt Hoellenschmerzen hast. " 
		   "Ausserdem ist Dir jetzt auf einmal so furchtbar uebel."));
	  say(BS(TPN+" geht vor Schmerz in die Knie. Ausserdem sieht "+
		 TP->name(WESSEN,1)+" Gesicht auf einmal so gruen aus, "
		 "mehr noch, es spielt abwechselnd alle moeglichen Farben."));
	  
	  this_player()->AddPoison(2+random(2));
	  
	  clone_object(NPC+"scorpion")->move(this_object(), M_GO);

	  return 1;
	  break;
	default:
	  write(BS("So sehr Du darin auch herumfummelst scheint "
		   "das Loch leer zu sein."));
	  write(BS("Du denkst . o 0 (ob da wohl mal was drinnen war?)"));
	  
	  say(BS(TPN+" zieht die Hand aber mit enttaeuschtem Gesichtsausdruck "+
		 "wieder heraus."));
	  say(BS("Du denkst . o 0 (ob er vielleicht nur pech hatte?)"));
				
	  return 1;
	  break;
	}
    }
  return 0;
}


reset()
{
  ::reset();
  
  cloned_scorpion=0;
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
