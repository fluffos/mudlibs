//coordinates npc's

#include <moving.h>

object *my_npc;
int ran_num, num_of_npcs;


create()
{
  if(is_clone(this_object())) remove();
  my_npc =({});
}

handle_npc(int num_for_ran, int max_num, object where_to_clone, string which_npc, string npc_id)
{
  object *my_npc_ptr;
  
  //clone_object(which_npc) -> move(where_to_clone, M_NOCHECK | M_NO_ATTACK);
  ran_num = random(num_for_ran);
  
  my_npc-=({0});
  
  my_npc_ptr=my_npc;
  num_of_npcs=sizeof(my_npc_ptr);
  
  if((ran_num<max_num)&&(!present(npc_id,where_to_clone))&&(num_of_npcs<3))
    clone_object(which_npc)->move(where_to_clone, M_NOCHECK|M_NO_ATTACK);
}

add_npc()
{
  my_npc+=({previous_object()});
}

remove_npc()
{
  my_npc-=({previous_object()});
  my_npc-=({0});
}

query_prevent_shadow()
{
  return 1;
}

dump_npc()
{
  return my_npc;
}
