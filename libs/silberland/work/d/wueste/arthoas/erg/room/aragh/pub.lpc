/*
  Ar-Thoas
  kneipe
*/

inherit "/std/pub";

#include <rooms.h>
#include <properties.h>
#include <pub.h>
#include "../desert.h"

create()
{
  ::create();
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "'Zum Sandwurm'");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten in der einzigen Kneipe weit "
	     "und breit, mit dem originellen Namen 'Zum Sandwurm'. "
	     "Hier ist es genauso sandig wie sonst auch ueberall, mit "
	     "dem einzigen Unterschied eben, dass es hier "
	     "so richtig angenehm kuehl ist.\n"));
	
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "ptahla");
  SetProp(P_PUBKEEPER_NAME, "Ptahla");
  SetProp(P_PUBKEEPER_GENDER, FEMALE);
  SetProp(P_PUBMSG_NOKEEPER, 
	  BS("Ptahla macht gerade Pause, vielleicht "
	     "versuchts Du Dein Glueck spaeter wieder?"));
  SetProp(P_PUBMSG_NOENEMY, 
	  BS("Du bist ein Traeumer, wenn Du denkst, dass "
	     "Ptahla die bedient, waehrend Du mit ihr kaempfst!"));
  SetProp(P_PUBMSG_NOINVITE, "Ptahla sieht Dich missbilligend an.\n");
  SetProp(P_PUBMSG_FIGHTING, "Ptahla muss nur noch schnell etwas klaeren.\n");
  
  AddDetail(({"kneipe"}),
	    "Na rat mal wo Du gerade bist?!?\n");
  AddDetail(({"boden", "untergrund"}),
	    "Sand, Sand, Sand. Wo Du auch hinblickst der Boden ist voller "
	    "Sand.\n");
  AddDetail(({"sand"}),
	    "Der Boden ist voll davon. Und aufgrund des regen 'Verkehrs' zu "
	    "einem festen Untergrund zusammengetrampelt worden.\n");
  AddDetail(({"verkehr"}),
	    "Nicht vergessen: wer sich schuetzt lebt laenger! Ansonsten "
	    "sammelst Du am besten Deine eigenen Erfahrungen.\n");
  AddDetail(({"erfahrung", "erfahrungen"}),
	    "Jo, wenn Du die meiste Zeit im eSeL rumhaengst, wirst Du es "
	    "schwer haben welche zu sammeln.\n");
  AddDetail(({"esel"}),
	    "Echt, wo???\n");
  AddDetail(({"zeit"}),
	    "Versuch mal 'zeit' zu tippen. =:> \n");
  AddDetail(({"waende"}),
	    "An einer Wand faellt Dir etwas auf.\n");
  AddDetail(({"wand"}),
	    "Welche Wand meinst Du denn?\n");
  AddDetail(({"nordwand"}),
	    "Jetzt erst faellt Dir eine kleine Tafel auf, die da ganz "
	    "unscheinbar vor sich herhaengt, so als waere sie dort vergessen "
	    "worden.\n");
  AddDetail(({"tafel"}),
	    "Hm...Du koenntest ja glatt mal versuchen sie zu lesen.\n");
  AddReadDetail(({"tafel"}),
		"Bist Du das erste Mal in einer Kneipe? Du solltest wissen, "
		"das man diese ominoesen Tafeln stets mit dem Befehl <menue> "
		"liest. =:>\n");
  AddDetail(({"decke"}),
	    "Sie laeuft nach oben hin spitz zu, aber das ist auch schon das "
	    "alleraufregendste daran.\n");
  AddSound(DEFAULT_SOUND,
	   "Aus der Kueche vernimmst Du leises Brutzeln.\n");
  AddSound(({"kueche", "brutzeln"}),
	   "Ja! Definitiv stammt es aus der Kueche, aber wie Du dort "
	   "hingelangst ist Dir ein unueberwindbares Mysterium.\n");
  AddDetail(({"mysterium"}),
	    "Fuer Dich scheinbar der Weg in die Kueche. =:>-~~~\n");
  AddDetail(({"weg", "ziel"}),
	    "Absolut korrekt, der Weg ist das Ziel, oder war's doch "
	    "umgekehrt?\n");
  AddDetail(({"kueche"}),
	    "Glaub mir, es ist besser Du weisst nicht wie man da hingelangt. "
	    "Man wuerde Dich bestimmt bloss zum Abwaschen oder Abtrocknen "
	    "einspannen. Ausserdem bringen sie einem die Bestellung und man "
	    "muss sie sich nicht selbst aus der Kueche holen.\n");
  AddDetail(({"abwaschen", "abtrocknen"}),
	    "Mach das lieber bei Dir zuhause, ist sinnvoller als hier. =:>\n");
  AddDetail(({"bestellung"}),
	    "Du koenntest ja mal versuchen eine aufzugeben, Du Genie!\n");
  AddSmell(DEFAULT_SMELL,
	   "Der Geruch hier verheisst Deinem Magen ein wahres Festmahl.\n");
  AddSmell(({"geruch"}),
	   "Kueche!\n");
  AddSmell(({"kueche"}),
	   "Ihr entstroemt ein herrlicher Duft. Vielleicht solltest Du Dir "
	   "ja 'ne Kleinigkeit bestellen?\n");
  AddDetail(({"festmahl", "mahl", "fest", "kleinigkeit"}),
	    "Na so bestell doch endlich...\n");
  AddDetail(({"genie"}),
	    "Sowas siehst Du da nicht! =:>>>\n");
  AddDetail(({"gast","gaeste"}),
	    "Einige Gaeste sitzen hier herum und trinken gemuetlich.");
  
  //food

  AddFood("gebratene Klapperschlange", 
	  ({"gebratene", "schlange", "klapperschlange", "gebratene schlange", 
	      "gebratene klapperschlange"}),
	  300, ({40, 50}), 18,
	  ({"Ptahla drueckt Dir eine aufgespiesste Klapperschlange in "
	      "die Hand, die Du genuesslich verspeist. Oeha...beinahe "
	      "haettest Du die Giftzaehne mitgegessen.",
	      "Ptahla drueckt && eine aufgespiesste Klapperschlange in "
	      "die Hand, die &! genuesslich verspeist."}));
  
  AddFood("Fennek-Steak", 
	  ({"fennek-steak", "steak", "fennek"}),
	  500, ({70, 60}), 22,
	  ({"Ptahla serviert Dir das zarteste Steak, das Du je genossen "
	      "hast. Dafuer musste wohl ein sehr junger Fennek sein Leben "
	      "lassen, was nun doch einige Schuldgefuehle in Dir weckt. "
	      "Trotzdem wuerdest Du Dir am liebsten gleich noch eines "
	      "bestellen.",
	      "&& wird ein zartes Fennek-Steak serviert. Njam, njam, njam, "
	      "sieht das koestlich aus."}));
  
  AddFood("fritierte Sandwuermer", 
	  ({"fritierte", "wuermer", "sandwuermer", "fritierte wuermer", 
	      "fritierte sandwuermer"}),
	  130, ({30, 30}), 10,
	  ({"Ptahla setzt Dir eine mit fritierten Sandwuermern gefuellte "
	      "Schuessel vor. Iiiiiiih...Du koenntest schwoeren, dass sich da "
	      "noch einer bewegt hat. Angeekelt schluckst Du sie, ohne sie zu "
	      "zerbeissen.",
	      "&& bekommt eine Schuessel gefuellt mit Sandwuermern "
	      "vorgesetzt. Irgendwie sieht &! nicht sehr gluecklich aus mit "
	      "dieser Wahl.\n"}));
  
  AddFood("Datteln", 
	  ({"teller", "dattelteller", "datteln", "teller datteln"}),
	  100, ({20, 20}), 9,
	  ({"Kaum bestellt, schon geliefert. Frische, saftige Datteln liegen "
	      "auf einem Teller vor Dir, der viel zu klein aussieht. Als Du "
	      "die letzte verdrueckt hast stellst Du aber fest, dass die "
	      "Sache doch saettigender ist, als Du zuvor dachtest.",
	      "&& schlemmt einen grossen Teller voll mit Datteln in sich "
	      "hinein. Sichtlich zufrieden und frisch gestaerkt schwelgt &! "
	      "in der Erinnerung an das koestliche Mahl."}));
  
  
  //drinks
  
  AddDrink("Wasser", 
	   ({"wasser"}),
	   10, ({3, 3}), 0, 3,
	   ({"Aaaaaaaah, tut das gut! Du fuehlst Dich sichtlich erfrischt.",
	       "&& trinkt ein Glas Wasser....wie unspektakulaer!"}));
  
  AddDrink("Pfefferminztee", 
	   ({"pfefferminz", "tee", "pfefferminztee", "minz"}),
	   30, ({4, 4}), 0, 3,
	   ({"Vorsicht heiss!, warnt Dich Ptahla, doch da hast Du "
	       "bereits einen grossen Schluck genommen, und Dich natuerlich "
	       "so verbrannt, dass der Schmerz Dich von innen zu verbrennen "
	       "droht.",
	       "&& trinkt frisch gebruehten Pfefferminztee."}));
  
  AddDrink("Wuestengeheimnis",
	   ({"geheimnis","geheimniss","wuestengeheimnis","wuestengeheimniss"}),
	   399, ({30,35,10}), 0, 10,
	   ({"Du bekommst ein seltsam anmutendes rotes Glas, dass Du in "
	       "einem Zug leerst. Hmm, was das jetzt genau war kannst Du "
	       "nicht nachvollziehen, es schmeckte irgendwie sauer, aber "
	       "auch salzig, aber auch irgendwie suess und scharf war es "
	       "auch.",
	       "&& bekommt ein seltsam anmutendes Glas ueberreicht welches "
	       "&! in einem Zug leert. Dem Gesichtsausdruck nach, bist Du "
	       "Dir aber nicht sicher, ob Du das auch trinken wuerdest."}));

  AddDrink("Dattelschnaps", 
	   ({"schnaps", "dattelschnaps"}),
	   150, ({22, 33}), 5, 4,
	   ({"Wie ein Alkoholiker schuettest Du den Schnaps in Deinen "
	       "gierigen Rachen.",
	       "&& vernichtet Dattelschnaps, so wie ein Neugeborenes "
	       "Muttermilch."}));
  
  AddDrink("Schlangengift", 
	   ({"gift", "schlangengift"}),
	   280, ({20, 40}), 5, 5,
	   ({"Ptahla drueckt Dir eine kleine Ampulle Schlangen'gift' in "
	       "die Hand, die Du sofort leerst. Sofort beginnst Du Dich zu "
	       "kruemmen und zu winden, Deine Zehennaegel biegen sich auf, "
	       "die Haare fallen Dir aus... Als Du wieder zu Dir kommst, "
	       "stellst Du fest, dass Du Dich wie neu geboren fuehlst.",
	       "&& leert eine Ampulle mit Schlangen'gift'. Also entweder ist "
	       "&! immun, oder aber der Inhalt verspricht nicht was drauf "
	       "steht."}));
  
  
  AddItem(NPC "ptahla", REFRESH_DESTRUCT);
  
  AddExit("westen",     ARAGH "raum43");
  AddExit("nordwesten", ARAGH "raum42");
  AddExit("suedwesten", ARAGH "raum44");
}
