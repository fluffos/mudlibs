/*
  Ar-Thoas
  desert
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad");
  SetProp(P_INT_LONG,
	  BS("Den See, der sich nun im Suedosten befindet, kannst Du " 
	     "nur noch sehr schwer erkennen, aber dafuer ist nun der " 
	     "Berg, der sich hinter dem See nach Norden erstreckt, klarer " 
	     "auszumachen. Waehrend Du den Berg so betrachtest wird Dir " 
	     "klar, dass er noch niemals bezwungen wurde und wahrscheinlich " 
	     "auch niemals wird. Seine Gipfel, die weit in den Himmel ragen, " 
	     "regen Deine Neugier an. Der Pfad fuehrt leicht ansteigend weiter " 
	     "in noerdliche Richtung. Wenn Du Deinen Blick gegen den Horizont " 
	     "richtest, kannst Du das Flimmern der Luft um Dich herum sehen, " 
	     "das durch die hohe Umgebungstemperatur verursacht wird."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_ROAD]));
  
  STANDARD1
  STDSKY1
  
  AddDetail("form",
	    "Strahlung halt, mehr gibts dazu nicht zu sagen.");
  AddDetail("abkuehlung",
	    "\nNana, jetzt schon nach Abkuehlung suchen ist doch ein wenig 'weich'. " 
	    "\n\n" 
	    "                 S O F T I I I   ! " 
	    "\n");
  AddDetail(({"auge", "untersuchung"}),
	    "\nAUTSCH !!! \n\n" 
	    "Hehe, T(r)ollpatsch...du hast Dir bei der Untersuchung des Auges " 
	    "doch tatsaechlich Deinen Finger in selbiges geRAMMT!");
  AddDetail("finger",
	    "Sozusagen corpus delicti!");
  AddDetail("corpus",
	    "Na wirst Du wohl schleunigst damit aufhoeren Dich hier in aller " 
	    "Oeffentlichkeit selbst zu befummeln!?!");
  AddDetail("see",
	    "Du bist viel zu weit weg, um Details zu erkennen.");
  AddDetail(({"detail", "details"}),
	    "Jo, huebsche gross geschriebene Worte, die hin und wieder nen " 
	    "Forscherpunkt bringen.");
  AddDetail(({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
	    "Unter Dir. Aber genau genommen siehst Du sowas hier nicht.");
  AddDetail("gestein",
	    "Das Gestein, das hier so rumliegt ist natuerlich 'fest', aber " 
	    "im Erdinneren ist es aufgrund der hohen Temperatur 'fluessig'.");
  AddDetail("gott",
	    "Hm...unt Gott...kewle Idee...was erwartest Du Dir bei unt Gott? " 
	    "Sowas wie: ein grosser alter weissbaertiger Mann...?");
  AddDetail("hoehe",
	    "Keine Angst, da musst Du nicht rauf.");
  AddDetail("angst",
	    "Vor Dir erscheint eine Gruppe wild taetowierter Musiker und singt: " 
	    "Angst ist nur ein gefuehl...");
  AddDetail(({"gruppe", "musiker"}),
	    "Vereint singen sie: die Welt hat uns verlangt, " 
	    "sie hat nichts besseres verdient...*schrumm* *schrumm*... habt ihr " 
	    "noch nicht erkannt, warum es boehse onkelz gibt!");
  AddDetail("forscherpunkt",
	    "GRATS -wieder einer mehr, oder?");
  AddDetail(({"jahr", "jahre"}),
	    "Jo, Du kommst auch schon in die Jahre, aber so alt wie der Berg bist " 
	    "Du noch lange nicht.");
  AddDetail("koepfe",
	    "Mal ueberlegen, ob Du da dazugehoeren koenntest...hm...<no comment>");
  AddDetail("worte",
	    "Ach Worte, was sind schon Worte...");
  AddDetail("neugier",
	    "Hm...Neugier ist eine Empfindung und daher schwerlich zu untersuchen.");
  AddDetail("empfindung",
	    "Du empfindest Neugier.");
  AddDetail(({"entfernung", "entfernungen"}),
	    "Tja, selbst Entfernungen sind relativ -denk doch mal daran, dass " 
	    "Raum&Zeit gekruemmt ist.");
  AddDetail("raum",
	    "Jaaa, Du bist in einem Raum, open-air sozusagen.");
  AddDetail(({"pflanzen", "bewuchs"}),
	    "Naja, Bewuchs ist ein wenig uebertrieben, fuer das bisserl Gras, das " 
	    "hier waechst.");
  AddDetail("gras",
	    "Vor langer Zeit waren das bestimmt saftige gruene Wiesen, doch heute " 
	    "ist davon bloss noch verdorrtes Gras ueber.");
  AddDetail(({"wiese", "wiesen"}),
	    "Sowas siehst Du da nicht mehr!");
  AddDetail(({"untergrund", "grund"}),
	    "Eine doch recht trockene und staubige Angelegenheit.");
  AddDetail("angelegenheit",
	    "Kuemmer Dich um Deine eigenen!");
  AddDetail("steppe",
	    "Suedlich von Dir erstreckt sie sich in schier unaufhaltsamen Dimensionen.");
  AddDetail(({"dimension", "dimensionen"}),
	    "Bedaechtig zaehlst Du sie ab, und kommst zu dem Schluss, dass es wohl " 
	    "4 sein muessen, oder?");
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite.");
  AddDetail("blick",
	    "Du koenntest ihn ja mal so rumschweifen lassen, das wuerde sich dann " 
	    "wahrscheinlich auch auszahlen, wenn es was zu sehen gaebe.");
  AddSmell(DEFAULT_SMELL,
	   "Ganz leicht kannst du den modrigen Geruch des Morastes feststellen. " 
	   "Irgendwie ekelig.");
  AddSmell("geruch",
	   "??? \"rieche\"xy ???");
  AddSmell("morast",
	   "Scheint aus dem Sueden zu kommen.");
  AddDetail(({"mensch", "menschen"}),
	    "Hihi...3 Steirer steigen hinter einem Gebuesch hervor, zuecken ihre Klampfen " 
	    "und spueln a oldes stairisches Liad: " 
	    "A bisserl a funken von ehrlichkeit, a bisserl weniger soebstherrlichkeit " 
	    "..und, dass zerscht a moi klan is was dann gressa wiad, des host ni kapiat...");
  AddDetail("gebuesch",
	    "Dahinter hat(te) sich scheinbar wer versteckt.");
  AddDetail(({"liad", "lied"}),
	    "Liad == Lied.");
  AddDetail(({"steirer", "steinbaecker", "timischl", "schifkowitz"}),
	    "STS");
  AddDetail("sts",
	    "SteinbaeckerTimischlSchifkowitz");
  AddSmell("sueden",
	   "jojo, ne zu riechende Himmelsrichtung -logisch...");
  AddSound(DEFAULT_SOUND,
	   "Komisch hier sind schon viel weniger Moskitos zu hoeren.");

  SetProp(P_HIDE_EXITS, ({"nordosten"}));
  
  AddExit("nordosten", PATH "raum02");
  AddExit("nordostoben", PATH "raum02");
  AddExit("sueden", "/d/ebene/creative/feldlager/room/b5_a6");

  AddItem(NPC "moench", REFRESH_DESTRUCT);
}
