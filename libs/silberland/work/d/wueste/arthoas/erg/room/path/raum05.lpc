//Ar-Thoas
//desert

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"


create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad" );
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich nun unmittelbar vor der Stelle, an der der "
	     "Pfad in oestlicher Richtung weiterverlaeuft. Das Ende des "
	     "Berges ist nun um einiges klarer zu erkennen. Doch erscheint "
	     "er Dir immer noch weit entfernt...bloss die gipfelaehnliche "
	     "Erhoehung des Berges hebt sich klar von der uebrigen "
	     "Landschaftsformation ab. Die maechtige Erscheinung beeindruckt "
	     "Dich doch sehr, schliesslich muss dieses Monument noch aelter "
	     "sein als die Menschheit."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN:TT_ROAD]) );
  
  STANDARD1
    STDSKY1
    
  AddDetail("silberland",
	    "Hier erwarten Dich grosse Taten.");
  AddDetail("taten",
	    "Die musst Du schon selbst vollbringen.");
  AddDetail("menschheit",
	    "Alle Menschen.");
  AddDetail(({"mensch", "menschen"}),
	    "Hier ist niemand ausser Dir.");
  AddDetail("grund",
	    "Sowas siehst Du hier weit und breit nicht.");
  AddDetail("entfernung",
	    "Wenn Du so weiter troedelst, wirds Du wohl keine grosse "
	    "Entfernung zuruecklegen.");
  AddDetail("details",
	    "Kannst Du hier eben keine sehen.");
  AddDetail("gestein",
	    "Im Erdinneren ist es fluessig.");
  AddDetail(({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
	    "Unter Dir. Aber genau genommen siehst Du sowas hier nicht.");
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite.");
  AddDetail(({"gras", "bewuchs"}),
	    "Allmaehlich vermischen sich Gras und steiniger Untergrund. "
	    "Wobei das Gras hier eine eigenartige Faerbung aufweist.");
  AddDetail("faerbung",
	    "Das Gras ist hier nicht so vergilbt wie im Sueden. Offenbar "
	    "hat der Boden hier mehr Feuchtigkeit in sich gespeichert.");
  AddDetail(({"untergrund", "feuchtigkeit"}),
	    "Dadurch, dass der Untergrund hier schon um einiges haerter ist, "
	    "als im Sueden, dauert es laenger, bis das Wasser in den Boden "
	    "sickert.");
  AddDetail("wasser",
	    "Haettest Du moeglicherweise gern, aber hier siehst Du keines.");
  AddDetail("stelle",
	    "Du bist nun exakt westlich von der gipfelaehnlichen Erhoehung. "
	    "Allerdings hast Du Dich trotzallem wieder ein wenig vom Berg "
	    "entfernt, da sich der Abstand zwischen Pfad und ihm vergroessert "
	    "hat.");
  AddDetail("abstand",
	    "Du denkst . o 0 (wahrlich, ich war schon mal naeher dran...)");
  AddDetail("ende",
	    "Alles hat ein Ende, oder?");
  AddDetail("alles",
	    "Nee, die Wurst hat zwei.");
  AddDetail(({"landschaftsformation", "formation"}),
	    "Die Gegend um Dich herum, vielleicht siehst Du Dich einfach mal "
	    "ein wenig um...?");
  AddDetail("gegend",
	    "Oh Gott, wuerdest Du weniger Substantiva untersuchen, haettest "
	    "Du bestimmt schon mehr davon gesehen!");
  AddDetail("substantiva",
	    "Noe, das beschreibe ich nicht - Du solltest das wissen.");
  AddDetail("gott",
	    "Nun eigentlich werden im Silberland zwei Goetter verehrt.");
  AddDetail("goetter",
	    "Woody & Dusty\n");
  AddDetail(({"woody", "dusty"}),
	    "Also hier sind sie nicht.");
  AddDetail(({"monument", "erscheinung", "erhoehung"}),
	    "Obwohl Du keine Details erkennen kannst bist Du doch "
	    "beeindruckt. Nicht bloss ob der Hoehe, nein auch deshalb, "
	    "weil es den Anschein hat, als waere diese Erhoehung von "
	    "Menschen erschaffen worden, und Dich verwundert, wie "
	    "Menschen ueberhaupt jemals in der Lage waren solche "
	    "Hoehen zu erklimmen.");
  AddDetail("hoehe",
	    "An seiner hoechsten Stelle misst der Berg satte 3003 m.");

  AddSound(DEFAULT_SOUND,
	   "Komisch Dir war so, als haettest Du ein *Zischen* gehoert.");
  AddSound("zischen",
	   "Tatsaechlich da war es schon wieder. Doch irgendwie kannst Du "
	   "von hier aus nicht den Ursprung des Geraeusches feststellen.");
  
  
  SetProp(P_HIDE_EXITS, ({"nordosten"}));
  
  AddExit("nordosten", PATH "raum06");	
  AddExit("nordostoben", PATH "raum06" );
  AddExit("sueden", PATH "raum04");
}
