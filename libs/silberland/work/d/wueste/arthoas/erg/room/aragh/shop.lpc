/*
  Ar-Thoas
  shop
*/

inherit "std/laden";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <laden.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

#define STOCK ARAGH "stockroom"

nosave int cloned_castle;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT,"In einem Laden");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem kleinen Laden. Die Temperatur "+
	     "ist hier sehr angenehm, im Gegensatz zu draussen. "+
	     "Es ist sehr ordentlich hier, ob der Haendler nichts "+
	     "anderes zu tun hat, als aufzuraeumen? Naja vielleicht "+
	     "hat er so wenig Kundschaft."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:25]));
  
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER); 
  SetProp(P_SHOPKEEPER_ID, "serachim");
  SetProp(P_SHOPKEEPER_NAME, "El-Serachim");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  
  AddDetail("kundschaft",
	    "Naja, Du bist doch ein potentieller Kunde, oder was suchst Du "+
	    "sonst hier?\n");
  AddDetail("kunde",
	    "Serachim hat sicher auch etwas in seinem Sortiment, das Dir "+
	    "zusagt.\n");
  AddDetail("sortiment",
	    "Hm...vielleicht solltest Du Dich darueber mit dem Haendler "+
	    "unterhalten?\n");
  AddDetail("gegensatz",
	    "Na draussen zb, da ist es doch heisser als hier drinnen, oder? \n");
  AddDetail("temperatur",
	    "Direkt angenehm hier herinnen. \n");
  AddDetail("decke",
	    "Was ist jetzt, willst Du was kaufen oder verkaufen oder was? \n");
  AddDetail(({"waende", "wand"}),
	     "An einer Wand haengt eine Tafel.\n");
  AddDetail("tafel",
	    "Moeglicherweise solltest Du sie lesen?\n");
  AddDetail(({"boden", "untergrund", "grund"}),
	     "Der Sand ist hier derart fest gepresst, dass ein stabiler Untergrund "+
	     "enstand.\n");
  AddDetail("sand",
	    "Daraus besteht der Boden, und als Kind macht man noch etwas anderes damit =;>\n");
  AddDetail("kind",
	    "Aus dem Alter bist Du doch schon raus, oder? \n");
  AddDetail("alter",
	    "Mach mal 'info' =;> \n");
  
  AddCmd(({"bau", "baue"}), "build_castle");
  
  AddReadDetail("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom(STOCK);
  
  AddItem(NPC "serachim", REFRESH_DESTRUCT);

  AddExit("nordwesten", ARAGH "raum41");
}



int build_castle(string str)
{  
  object ob;
  
  notify_fail("Was willst Du bauen?\n");
  
  if(str=="sandburg"||str=="burg")
    {
      if(cloned_castle)
	return write("Scheinbar hat schon jemand vor Dir eine Burg gebaut.\n"+
		     "Aber auf jeden Fall ist nicht genuegend Sand vorhanden.\n"),1;
      else
	{
	  write("Du baust eine wunderschoene Sandburg.\n");
	  ob=clone_object(OBJ+"sandburg");
	  ob-> move(this_object(), M_NOCHECK);
	  ob->set_owner(capitalize(this_player()->query_real_name()));
	  cloned_castle=1;
	  say(capitalize(this_player()->name())+" baut eine wunderschoene Sandburg. \n");
	  return 1;
	}
    }
  return 0;
}


reset()
{
  ::reset();
  
  if(!present("sandburg")) cloned_castle = 0;
}
