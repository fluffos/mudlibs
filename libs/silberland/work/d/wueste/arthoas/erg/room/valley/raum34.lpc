inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste "
	     "nennen. Dass Du die Hitze nicht allzulang ertragen kannst, "
	     "dessen bist Du Dir bewusst. Oestlich ragt das Tibesti-Gebirge "
	     "empor, das Du wohl niemals ueberwinden wirst. Die Sonne brennt "
	     "herunter, und wenn Du dachtest im Dschungel ist es heiss, so "
	     "wirst Du nun eines besseren belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 38, ENV_TERRAIN:TT_DESERT]));
  
  
  STANDARD3
  STDSKY3
  
  AddDetail(({"schnellkurs", "kurs"}),
	    "Na hier und jetzt sicher nicht!!!");
  
  AddDetail(({"astronomie"}),
	    "Geh und frag Sedda.");
  AddDetail(({"punkt", "argument"}),
	    "-------------------------------------------------------\n" 
	    "|              Error: Bad Argument.                   |\n" 
	    "-------------------------------------------------------\n");
  AddDetail(({"gehirn"}),
	    "Du dokterst eine Zeit lang an Deinem Kopf herum, gibst dann doch "
	    "auf... keine Chance bei diesem Dickkopf.");
  AddDetail(({"kopf"}),
	    "Jemand singt: Don't loose your head! ");
  AddDetail(({"dickkopf"}),
	    "Selber Dickkopf!");
  AddSmell(DEFAULT_SMELL,
	   "Nahezu absolut geruchlos ist die Wueste hier.");
  AddSmell(({"wueste"}),
	   "Was soll das? Willst Du Dir ein paar Sandkoerner reinziehen? ");
  AddSound(DEFAULT_SOUND,
	   "Hin und wieder kannst Du ein leises Pfeifen wahrnehmen. ");
  AddSound(({"pfeifen"}),
	   "Als Du genau lauscht, kannst Du das Pfeifen hoeren, das " 
	   "der Wind verursacht, wenn er ueber die Sandduenen blaest.");
  AddDetail(({"duene"}),
	    "Hier gleicht eine Sandduene der anderen.");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand.");
  AddDetail(({"sand"}),
	    "Vielleicht kann man ja darin graben?");
  AddDetail(({"vorankommen"}),
	    "Im Westen versperrt Dir eine Duene den Weg, und im Osten " 
	    "ragt die Felswand des Tibesti-Gebirges steil empor.");
  AddDetail(({"wand", "felswand"}),
	    "Daran hoch zu klettern kannst Du gleich vergessen, dafuer ist " 
	    "sie viel zu steil. ");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  
  AddExit("nordwesten", RAVINE "raum10");
  AddExit("sueden",     VALLEY "raum35");
}


reset()
{
  ::reset();
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}

