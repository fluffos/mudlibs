//Ar-Thoas
//hoelle
//thy soul is lost...

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"


create()
{
	::create();

	SetProp( P_INT_SHORT, "In der Hoelle" );
	SetProp( P_INT_LONG, "Das hier ist die Hoelle, falls Du "+
						 "das hier liest, bist Du in Kuerze tot.\n");
	SetProp( P_LIGHT, 0);
	SetProp( P_LIGHT, 0);
	SetProp( P_INDOORS, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 40, ENV_TERRAIN:TT_OTHER]) );
	
	AddDetail( ({"boden", "waende", "wand", "decke"}),
		"Du bist hier im ewigen Nichts der Hoelle.\n");
		
	AddDetail( ({"nichts", "hoelle"}),
		"Feuer, Feuer, und abermals Feuer, egal wo Du auch hinblickst nichts "+
		"als Feuer...naja, die Hoelle eben. =:> \n");
	
	AddItem(NPC+"diablo", REFRESH_DESTRUCT);
}


reset()
{
	::reset();
}
