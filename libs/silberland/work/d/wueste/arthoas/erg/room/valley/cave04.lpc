inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"

string d_temp(string str);

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Unter Truemmern begraben");
  SetProp(P_INT_LONG,  
	  BS("Scheinbar war das doch keine so gute Idee. Da liegst Du " 
	     "nun, und kannst Dich nicht einen Millimeter bewegen. Ueber Dir, neben "
	     "Dir, einfach ueberall liegen Truemmer von der ehemaligen Decke herum, "
	     "und haben Dich foermlich eingekeilt."));
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]));
  
  AddDetail(({"stueck", "millimeter"}),
	    "So sehr Du Dich auch bemuehst, hast Du keine Chance Dich auch nur ein " 
	    "aller winzigstes Stueck zu bewegen.");
  AddDetail(({"fels", "felsen", "truemmer"}),
	    "Du bist wunderschoen unter den Truemmern bei lebendigem Leibe begraben " 
	    "worden. Und da Du Dich auch nicht bewegen kannst, bleibt Dir nichts "
	    "anderes ueber, als auf Hilfe von aussen zu hoffen.");
  AddDetail("hilfe",
           "Jetzt waer ein idealer Zeitpunkt um voller Inbrunst um Hilfe zu rufen.");
  AddDetail("inbrunst",
	    "Schrei einfach so laut Du kannst.");
  AddDetail("zeitpunkt",
	    "Jetzt zum Beispiel?");
  AddDetail("beispiel",
	    "Nope. Ein weiteres Beispiel gibt es keines.");
  AddDetail("decke",
	    "Hast Du das schon vergessen, oder hast Du es verdraengt? Hm..."
	    "wahrscheinlich stehst Du noch unter Schock. Also rekapitulieren wir: Du "
	    "wolltest nach Nordosten gehen und da hat Dich die herabstuerzende Decke "
	    "einfach unter sich begraben.");
  AddDetail("nordosten",
	    "Keine Chance, Du kannst Dich ja nicht einmal ein winziges Stueck "
	    "bewegen.");
  AddDetail("chance",
	    "Deine einzige Chance ist auf Hilfe von aussen zu hoffen.");
  AddDetail("boden",
	    "Der Fels...naja lassen wir das, ich denke Du hast genug von Felsen..."
	    "fuer laengere Zeit.");
  AddDetail("zeit",
	    "Du koenntest Dir ja ueberlegen, was Du mit der Zeit anfangen koenntest, "
	    "bis Hilfe von aussen da ist, um Dich zu befreien. Aber irgendwie sind "
	    "Deine Moeglichkeiten doch eher eingeschraenkt.");
  AddDetail(({"moeglichkeiten", "moeglichkeit"}),
	    "Naja, mit dem Platzangebot wirst Du es mit Tennis zb. schwer haben.");
  AddDetail("tennis",
	    "Noe, lass Dir mal lieber was anderes einfallen.");
  AddDetail("platzangebot",
	    "Sehr komfortabel ist es hier nicht gerade, schliesslich es ist ja auch "
	    "kein 5 Sterne Hotel, aber dafuer ist es gratis.");
  AddDetail(({"hoehle", "raum"}), 
	    ME->QueryProp(P_INT_LONG));
  AddSound(DEFAULT_SOUND,
	   "Dir war so, als haettest Du ein Geraeusch gehoert.");
  AddSound("geraeusch",
	   "Ob da von draussen schon jemand an Deiner Rettung arbeitet?");
  AddDetail("rettung",
	    "Wenn dann kommst sie von aussen, aus eigener Kraft kannst Du Dich hier " 
	    "niemals befreien.");
  AddDetail("kraft",
	    "Und wenn Du stark bist wie 10 Ochsen hast Du trotzdem nicht den Funken "
	    "einer Chance.");
  AddDetail("ochsen",
	    "Neee, Ochsen siehst Du hier nur einen Ochsen.");
  AddDetail("ochse",
	    "Du koenntest Dich Ochse nennen, weil Du nach Nordosten gegangen bist, "
	    "und jetzt hier so nutzlos rumhaengst.");

  AddSpecialDetail(({"temperatur"}), "d_temp");
}

string d_temp(string str)
{
  if(deep_present("thermometer", TP))
    return BS("Um die Temperatur zumindest ungefaehr zu erfahren " 
	      "koenntest Du doch einmal Dein Thermometer untersuchen.");
  
  return BS("Tsja, haettest Du ein Thermometer bei Dir, so "
	    "koenntest Du einen Blick darauf werfen, aber so musst Du Dich leider "
	    "damit begnuegen, dass es hier herinnen angenehm kuehl ist.");
}

BecomesNetAlive(object wer)
{
  if(query_wiz_level(wer) <= 2)
    call_other(VALLEY "cave01.lpc", "SetVars", wer);
}
