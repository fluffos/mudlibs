inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Wuestendorf");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im suedlichsten Teil des Wuestendorfes, dessen Zentrum "
	     "eine kleine Oase ist, die sich im Norden befindet. Im Osten wird "
	     "das Dorf durch das Tibesti-Gebirge begrenzt. Ein grosses Haus "
	     "siehst Du im Nordosten."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD6
  GROUND6
  House
  SKY6
  
  AddDetail(({"teil"}),
	    "Hier bist Du im suedlichsten Teil, folglich erstreckt sich "
	    "das Wuestendorf in noerdlicher Richtung, wo dann ja wohl auch "
	    "das Zentrum zu finden sein wird.\n");
  AddDetail(({"einwohner", "einheimische"}),
	    "Keiner da. Aber irgendwann laeuft Dir bestimmt noch einer ueber "
	    "den Weg.");
  AddDetail(({"weg"}),
	    "Ja woher soll ich wissen, welchen Weg zu gehen Du gedenkst?");
  AddDetail(({"oase"}),
	    "Das Zentrum bildet eine kleine Oase mit Brunnen -> Wasser!\n");
  AddDetail(({"zentrum"}),
	    "Im Norden! Hier bestimmt nicht.\n");
  
  AddExit("norden",     ARAGH "raum44");
  AddExit("osten",      ARAGH "raum49");
  AddExit("nordwesten", ARAGH "raum39");
  AddExit("sueden", "/d/wueste/zordan/anschluss/room/erg1");
}
