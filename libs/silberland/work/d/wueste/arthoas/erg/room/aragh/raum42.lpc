inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Wuestendorf" );
  SetProp(P_INT_LONG, 
	  BS("Du stehst im noerdlichen Teil des Wuestendorfes, dessen "
	     "Zentrum eine kleine Oase ist, die sich im Sueden befindet. "
	     "Im Osten siehst Du ein mittelgrosses Haus, das Du allerdings "
	     "von hier aus nicht erreichen kannst. Ein mittelgrosses Haus "
	     "befindet sich im Suedosten."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD6
  Ground_Oasis
  House
  SKY6
  
  AddDetail(({"teil"}),
	    "Hier bist Du im noerdlichen Teil, folglich erstreckt sich "
	    "das Wuestendorf in suedlicher Richtung, wo dann ja wohl auch "
	    "das Zentrum zu finden sein wird.\n");
  AddDetail(({"einwohner", "einheimische"}),
	     "Keiner da.\n");
  AddDetail(({"oase"}),
	    "Das Zentrum bildet eine kleine Oase mit Brunnen -> Wasser!\n");
  AddDetail(({"zentrum"}),
	    "Im Sueden! Hier bestimmt nicht.\n");
  
  AddItem(NPC "oasenwaechter", REFRESH_DESTRUCT);
  
  AddExit("norden",     ARAGH "raum41");
  AddExit("suedosten",  ARAGH "pub");
  AddExit("sueden",     ARAGH "raum43");
  AddExit("suedwesten", ARAGH "raum38");
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
