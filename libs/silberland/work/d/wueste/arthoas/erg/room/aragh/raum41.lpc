inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Wuestendorf");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im noerdlichsten Teil des Wuestendorfes, dessen "
	     "Zentrum eine kleine Oase ist, die sich im Sueden befindet. "
	     "Im Osten wird das Dorf durch das Tibesti-Gebirge begrenzt. "
	     "Auch ist hier die Temperatur bei weitem ertraeglicher als im "
	     "Nordwesten. Ein mittelgrosses Haus siehst Du im Suedosten."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD6
  GROUND6
  House
  Berber
  SKY6
  
  AddDetail(({"hals"}),
	    "Du tastest sorgfaeltig Deinen Hals ab, und kommst zu dem "
	    "Schluss, dass alles dort ist wo es hingehoert.\n");
  AddDetail(({"schluss"}),
	    "Willst jetzt schon aufgeben?\n");
  AddDetail(({"klinge", "kreuz"}),
	     "Die Klingen ihrer Schwerter waren gerade, dadurch aehnelten "
	    "diese einem Kreuz, dem wohl typischsten christlichen Symbol "
	    "schlechthin.\n");
  AddDetail(({"symbol"}),
	    "Das Symbol der Christen ist das Kreuz.");
  AddDetail(({"christ", "christen"}),
	     "Bist Du einer?\n");
  AddDetail(({"teil"}),
	    "Hier bist Du im noerdlichsten Teil, folglich erstreckt sich "
	    "das Wuestendorf in suedlicher Richtung, wo dann ja wohl auch "
	    "das Zentrum zu finden sein wird.\n");
  AddDetail(({"einwohner", "einheimische"}),
	     "Keiner da. Das ist schon ein sehr eigenartiges Volk.");
  AddDetail(({"oase"}),
	    "Das Zentrum bildet eine kleine Oase mit Brunnen -> Wasser!\n");
  AddDetail(({"zentrum"}),
	    "Im Sueden! Hier bestimmt nicht.\n");
  
  AddExit("nordwesten", VALLEY "raum35");
  AddExit("suedosten",  ARAGH "shop");
  AddExit("sueden",     ARAGH "raum42");
  AddExit("suedwesten", ARAGH "raum37");
}
