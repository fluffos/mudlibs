/*
  Ar-Thoas
  desert
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad");
  SetProp(P_INT_LONG,
	  BS("Endlich, im Norden scheint der Pfad in oestliche Richtung " 
	     "abzubiegen. Jetzt kannst Du auch bereits das Ende des Berges " 
	     "erahnen, obwohl er Dir nun wieder ein wenig weiter entfernt " 
	     "scheint...aber ganz deutlich zeichnet sich eine gipfelaehnliche " 
	     "Erhoehung des Berges ab, die sich genau am Eckpunkt befindet, an " 
	     "dem der Berg sich weiter Richtung Osten erstreckt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_ROAD]));
  
  STANDARD1
  STDSKY1
  
  AddDetail("raum",
	    "Jaaa, Du bist in einem Raum, open-air sozusagen. ");
  
  AddDetail(({"mensch", "menschen"}),
	     "Hier ist niemand ausser Dir. \n");
  
  AddDetail(({"kopf", "koepfe"}),
	     "Konfuzius sagt: Mancher Kopf ist hohl. \n");
  
  AddDetail(({"jahr", "jahre"}),
	    "365 Tage. \n");
  
  AddDetail("tage",
	    "24 Stunden. \n");
  
  AddDetail("stunden",
	    "60 Minuten. \n");
  
  AddDetail("minuten",
	    "60 Sekunden. \n");
  
  AddDetail("sekunden",
	    "21-22-23 und so fort...\n");
  
  AddDetail("hoehe",
	    "Jo, wer hoch fliegt, faellt tief. ");
  
  AddDetail("entfernung",
	    "Huete Dich vor dem ... , er wuerde Dich kurzerhand aus dieser " 
	    "Welt entfernen. ");
  
  AddDetail("welt",
	    "Das hier ist das Silberland, aber da war doch noch was...*gruebel* " 
	    "oh, rl glaube ich wars...naja, ist ja auch egal. ");
  
  AddDetail("silberland",
	    "Diese Welt heisst Silberland. \n");
  
  AddDetail("ende",
	    "Manchmal der einzige Weg aus einer heiklen Situation. ");
  
  AddDetail(({"weg", "ausweg"}),
	    "Es gibt immer einen Ausweg, und wenns nur 'ende' ist. ");
  
  AddDetail("situation",
	    "Hoffentlich geraetst Du nicht in eine solche =:> ");
  
  AddDetail("eckpunkt",
	    "Nicht allzu weit entfernt im Norden fuehrt der Pfad weiter in Richtung " 
	    "Osten. ");
  
  AddDetail("abkuehlung",
	    "Auch hier wirst Du diesbezueglich nicht fuendig. ");
  
  AddDetail("gestein",
	    "Im Erdinneren ist es fluessig. \n");
  
  AddDetail(({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
	    "Unter Dir. Aber genau genommen siehst Du sowas hier nicht. \n");
  
  AddDetail("eckkpunkt",
	    "Jene Stelle, an der der Berg von Norden nach Osten seine " 
	    "Ausbreitungsrichtung aendert. ");
  
  AddDetail(({"ausbreitungsrichtung", "richtung"}),
	    "Hier verlaeuft der Berg noch von Norden nach Sueden respektive " 
	    "vice versa. ");
  
  AddDetail("stelle",
	    "Du hast sie noch nicht erreicht, sie liegt weiter im Norden. ");
  
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite. ");
  
  AddDetail(({"gras", "bewuchs"}),
	    "Vor langer Zeit waren das bestimmt saftige gruene Wiesen, doch heute " 
	    "ist davon bloss noch verdorrtes Gras ueber. ");
  
  AddDetail(({"wiese", "wiesen"}),
	    "Sowas siehst Du da nicht mehr! ");
  
  AddDetail(({"untergrund", "grund"}),
	    "Eine doch recht trockene und staubige Angelegenheit. ");
  
  AddDetail("angelegenheit",
	    "Kuemmer Dich um Deine eigenen!");
  
  AddDetail("erhoehung",
	    "Leider ist sie viel zu weit weg, wodurch Du ausser schemenhaften " 
	    "Umrissen weiters nichts erkennen kannst. ");
  
  AddDetail(({"umriss", "umrisse", "silhouette"}),
	    "Im Norden, ganz genau eigentlich im Nordosten, kannst Du die Silhouette " 
	    "einer Erhoehung erkennen. ");
  
  SetProp(P_HIDE_EXITS, ({"suedwesten"}));
  
  AddExit("suedwesten", PATH "raum03");
  AddExit("norden", PATH "raum05");
  AddExit("suedwestunten", PATH "raum03");
}
