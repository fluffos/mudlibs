inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Dass Du die Hitze nicht allzulang ertragen kannst, dessen bist Du Dir " 
	     "bewusst. Nun bist Du oestlich des Berges, von dem Du noch vor einiger " 
	     "Zeit dachtest, dass er unueberwindbar sei, und Dir daher diese Seite " 
	     "fuer immer verborgen bliebe. Die Sonne brennt herunter, und wenn Du " 
	     "dachtest im Dschungel ist es heiss, so wirst Du nun eines besseren " 
	     "belehrt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 40, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD3
  STDSKY3
  
  AddDetail(({"gehirn"}),
	    "Ujeee, is leider aus.");
  AddDetail(({"punkt"}),
	    "Was suchst denn, den springenden Punkt? ");
  AddDetail(({"seite"}),
	    "Ja, geh besser zur Seite, und mach den anderen Platz.");
  AddDetail(({"platz"}),
	    "Hier ist genug fuer alle da.");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand...scheinbar gibst Du die Hoffnung nicht auf, " 
	    "eines Tages in einer Sandwueste etwas anderes als Sand zu finden.");
  AddSmell(DEFAULT_SMELL,
	   "Hier ist einfach alles geruchlos.");
  AddSound(DEFAULT_SOUND,
	   "Nicht ein einziger Ton ist hier zu hoeren.");
  AddDetail(({"vorankommen"}),
	    "Die einzige Moeglichkeit diesen Ort zu verlassen ist nach Nordosten, " 
	    "da Du ringsum von einer Zig meter hohen Duene umgeben bist.");
  AddDetail(({"duene"}),
	    "Sie ist wahrlich gewaltig.");
  AddDetail(({"sand"}),
	    "Du siehst unzaehlige Spuren im Sand.");
  AddDetail(({"spuren"}),
	    "Schlangenspuren -eindeutig!");
  
  AddItem(NPC "rattlesnake", REFRESH_DESTRUCT);
  
  AddExit("nordosten", VALLEY "raum35");
}


reset()
{
  ::reset();
  
  NPCMASTER->handle_npc(9, 3, this_object(), NPC "sandcreature", "sandcreature");
}
