inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Wuestendorf");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im westlichsten Teil des Wuestendorfes, dessen "
	     "Zentrum eine kleine Oase ist, die sich im Osten befindet. "
	     "Im Westen wird das Dorf durch eine gewaltige Duene begrenzt."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD6
  Ground_Oasis
  Berber
  SKY6
    
  AddDetail(({"zentrum", "oase"}),
	    "Im Osten! Hier bestimmt nicht.\n");
  AddDetail(({"hals"}),
	    "Du tastest sorgfaeltig Deinen Hals ab, und kommst zu dem Schluss, "
	    "dass alles dort ist wo es hingehoert.\n");
  AddDetail(({"schluss"}),
	    "Willst jetzt schon aufgeben?\n");
  AddDetail(({"klinge", "kreuz"}),
	    "Die Klingen ihrer Schwerter waren gerade, dadurch aehnelten diese "
	    "einem Kreuz, dem wohl typischsten christlichen Symbol schlechthin.\n");
  AddDetail(({"symbol"}),
	    "Das Symbol der Christen ist das Kreuz.");
  AddDetail(({"christ", "christen"}),
	    "Bist Du einer?\n");
  AddDetail(({"teil"}),
	    "Hier bist Du im westlichsten Teil, folglich erstreckt sich das "
	    "Wuestendorf in oestlicher Richtung, wo dann ja wohl auch das Zentrum "
	    "zu finden sein wird.\n");
  AddDetail(({"einwohner", "einheimische"}),
	    "Keiner da. Das ist schon ein sehr eigenartiges Volk.");
  AddDetail(({"duene"}),
	    "Eine derart gewaltige Duene hast Du noch nie zuvor gesehen. "+
	    "Sie ist bestimmt ueber 100m hoch, also unueberwindbar.\n");	
  
  AddItem(NPC "oasenwaechter", REFRESH_DESTRUCT);
  
  AddExit("norden",    ARAGH "raum37");
  AddExit("nordosten", ARAGH "raum42");
  AddExit("osten",     ARAGH "raum43");
  AddExit("suedosten", ARAGH "raum44");
  AddExit("sueden",    ARAGH "raum39");
}
