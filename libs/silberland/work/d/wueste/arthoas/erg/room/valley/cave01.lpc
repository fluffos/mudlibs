inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"

string d_faust(string str);
string d_pakt(string str);
string d_mission(string str);
string d_ptahla(string str);
string d_temp(string str);
string d_reason(string str);
string d_northeast(string str);
string rubble_scene(string str);
int move_burried_player(object pl);
int free_player(string str);
move_player(object pl);
move_player2(object pl);
move_player3(object pl);
move_player4(object pl);
move_dest(object pl);
move_dest2(object pl);

int ceiling_down;
int found_weakness;
int wall_cut;
int cl_rat;
int player_burried_under_stones;
int p_in_hell;
object b_pl;

#define RUBBLE_LOG LOG "rubble_log"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Berg");
  SetProp(P_INT_LONG,  
	  BS("Da stehst Du nun Du armer Tor, und bist so klug als wie zuvor. " 
	     "Der Fels ist angenehm kuehl, eine richtige Wohltat, nach den "
	     "Temperaturen, denen Du in der Wueste ausgesetzt warst. Im Nord- "
	     "und Suedosten flackern kleine Lichter."));
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]));
  
  AddDetail("waende",
	    "Die Waende rings um Dich herum wurden, worauf der Fels schliessen " 
	    "laesst, in grosser Eile bearbeitet. Vermutlich bestand grosses " 
	    "Interesse daran, moeglichst schnell ins Innere des Berges vorzustossen. "
	    "Aber irgendwie sind die Waende nicht alle gleich.");
  AddDetail("wand",
	    "Welche Wand meinst Du denn?");
  AddDetail("ostwand",
	    "Tatsaechlich, mit der Ostwand stimmt etwas nicht. Es sieht fast so aus, "
	    "als waere die Hoehle an dieser Stelle kuenstlich verschlossen worden. " 
	    "Was wohl der Grund dafuer gewesen sein mag, dass man diesen Teil der " 
	    "Hoehle wieder zumauerte, ist Dir ein Raetsel.");
  AddDetail("stelle",
	    "Es sieht fast so aus, als koennte man, wenn man " 
	    "das richtige Werkzeug verwendet durch die Wand durchbrechen. " 
	    "Vorausgesetzt natuerlich es laesst sich eine Schwachstelle finden.");
  AddDetail("schwachstelle",
	    "Also auf den ersten Anblick kannst Du keine Schwachstelle entdecken.");
  AddDetail("anblick",
	    "Vielleicht solltest Du es ja auf noch einen Versuch ankommen lassen, " 
	    "eine Schwachstelle zu entdecken.");
  AddDetail("versuch",
	    "Egal wie oft Du es noch versuchst, Du kannst keine Schwachstelle "
	    "ausmachen. Moeglicherweise liegt es aber auch daran, dass Du nicht "
	    "genau genug suchst?");
  AddDetail("eile",
	    "In der Ruhe liegt die Kraft!");
  AddDetail("interesse",
	    "Was wohl die Erbauer dieser Hoehlen angetrieben haben mag?");
  AddDetail("erbauer",
	    "Ob wohl die Erbauer fuer das flackern der Lichter verantwortlich sind?");
  AddDetail("lichter",
	    "Scheinbar ist dort jemand. Eine andere Erklaerung hierzu faellt Dir so " 
	    "auf die Schnelle nicht ein.");
  AddDetail("schnelle",
	    "Auch wenn Du laenger darueber bruetest, kommst Du zu keinem anderen " 
	    "Ergebnis, als dass dort hundertprozentig jemand sein muss.");
  AddDetail(({"erklaerung", "ergebnis"}),
	    "Dort ist jemand!");
  AddDetail("suedosten",
	    "Dort flackern kleine Lichter. Wer dort wohl sein mag? Und ueberhaupt, " 
	    "wenn jemand dort ist, was macht derjenige dort?");
  AddDetail("boden",
	    "Der Boden ist genauso nichtssagend wie alles andere hier auch, bis auf " 
	    "die Tatsache, dass hier ein kleiner Wuestenfuchs sein Heim eingerichtet "
	    "hat.");
  AddDetail(({"nische", "heim", "schlafplatz", "platz"}),
	    "In einer kleinen Nische hat er seinen Schlafplatz eingerichtet, und " 
	    "ein Stueck davon entfernt tuermen sich die bereits zum Teil verrotteten "
	    "Ueberreste von seinen Mahlzeiten.");
  AddDetail(({"ueberreste", "reste"}),
	    "Zum Teil sind sie schon verrottet, andere wiederum scheinen noch "
	    "relativ frisch zu sein.");
  AddDetail(({"mahlzeit", "mahlzeiten"}),
	    "Also Dich wird er sicher nicht verspeisen der kleine Wuestenfuchs.");
  AddDetail("hoehlenbewohner",
	    "Na wer damit wohl gemeint sein kann?");
  AddDetail(({"wuestenfuchs", "fuchs"}),
	    "Scheinbar ist gerade keiner da, vielleicht ist er ja auf der Suche nach "
	    "Beute.");
  AddDetail("decke", 
	    ([ 
	      0: 
	      "Die Decke ueber Dir ist genauso kahl und feucht wie der uebrige "
	      "Fels hier ueberall.", 
	      "zwerg": 
	      "Die Decke ist viel zu weit entfernt, um genaueres feststellen zu "
	      "koennen, aber vermutlich ist sie genauso kalt und kahl wie der "
	      "uebrige Fels.", 
	      "troll": 
	      "Naja, auf deine Zehenspitzen darfst Du Dich nicht stellen, sonst "
	      "stoesst Du Dir den Kopf an der kahlen kalten Decke."]));
  AddDetail("tor",
	    "Hm...irgendwie kommt Dir der Text bekannt vor wenn Du nur wuesstest "
	    "woher?");
  AddDetail("goethe",
	    "Exakt! Das ist ein adaptiertes Goethe-Zitat.");
  AddDetail(({"text", "zitat"}),
	    "Da stehst Du nun Du armer Tor, und bist so klug...leicht adaptiert, "
	    "aber definitiv goethischen Ursprungs, das Original natuerlich.");
  AddDetail(({"ursprung", "original"}),
	    "Dieses Zitat entstammt einem sehr bekannten Stueck.");
  AddDetail("stueck",
	    "Wenn Du jetzt auch noch weisst aus welchem Stueck das Zitat stammt?");
  AddDetail("angelegenheit",
	    "Hat nicht jeder seine individuellen Angelegenheiten zu regeln?");
  AddDetail("fels",
	    "Er ist kalt und kahl. Ausserdem wurde er nicht sehr sorgfaeltig " 
	    "bearbeitet, scheinbar war es wichtiger den Raum moeglichst rasch " 
	    "fertig zu stellen, als auf Feinheiten zu achten.");
  AddDetail("feinheiten",
	    "Hier wurde nicht auf Feinheiten geachtet, der Fels ist rauh und sehr " 
	    "ungleichmaessig.");
  AddDetail(({"hoehle", "raum"}), 
	    ME->QueryProp(P_INT_LONG));
  AddDetail("wohltat",
	    "Du geniesst die angenehme Temperatur hier.");
  AddDetail("wueste",
	    "Da solltest Du schon raus gehen. Von hier kannst Du bei " 
	    "bestem Willen die Wueste nicht untersuchen.");
  AddDetail(({"wille", "willen"}),
	    "So sehr Du Dich auch bemuehst, die Wueste von hier aus zu " 
	    "erforschen, scheiterst Du klaeglich.");
  AddDetail("ruhe",
	    "Glaubst Du wirklich, dass Du erfolgreich sein wirst, wenn Du 'Ruhe' " 
	    "untersuchst?");
  AddSmell(DEFAULT_SMELL, "Ein etwas eigenartiger Geruch liegt in der " 
	   "Luft.");
  AddSmell("luft",
	   "Die Luft riecht fast so, als wuerde hier etwas verwesen.");
  AddSmell("geruch",
	   "Das ist eindeutig der Geruch, der in der Luft liegt, wenn etwas " 
	   "verwest. Der Gestank ist jetzt, wo Du so drueber nachdenkst widerlich.");
  AddSmell("gestank",
	   "Scheinbar ruehrt er von den Ueberresten, die von den Mahlzeiten " 
	   "des kleinen Hoehlenbewohners uebrig blieben.");
  AddSound(DEFAULT_SOUND,
	   "Extrem leise hoerst Du wie jemand in einiger Entfernung unaufhoerlich " 
	   "den Fels bearbeitet.");
  AddSound(({"geraeusch", "geraeusche", "entfernung"}),
	   "Du bist nicht nahe genug an der Quelle der Geraeusche dran.");
  AddSound("quelle",
	   "Du lokalisierst die Quelle definitiv im Suedosten.");
  AddSound("ruhe",
	   "Aber hier ist es doch garnicht ruhig.");
  AddDetail("geheimnis",
	    "Das kannst Du natuerlich nicht sehen, sonst waere es ja kein "
	    "Geheimnis.");
  
  AddSpecialDetail(({"faust"}), "d_faust");
  AddSpecialDetail(({"pakt", "teufel"}), "d_pakt");
  AddSpecialDetail(({"mission"}), "d_mission");
  AddSpecialDetail(({"ptahla"}), "d_ptahla");
  AddSpecialDetail(({"temperatur"}), "d_temp");
  AddSpecialDetail(({"grund"}), "d_reason");
  AddSpecialDetail(({"nordosten"}), "d_northeast");
  
  AddCmd("befreie", "free_player");
  AddCmd("durchwuehle", "dig_bones");
  AddCmd(({"greif", "greife", "fasse", "fasse"}), "grab_niche");
  AddCmd(({"brich", "breche"}), "cut_wall");
  AddCmd(({"suche", "such"}), "search_weakness");
  
  AddSpecialExit("nordosten", "go_northeast");
  AddExit("suedosten", VALLEY "cave02");	
  AddExit("raus", VALLEY "raum35");
  
  AddItem(NPC "fennek", REFRESH_DESTRUCT);
}

nosave int dig_bones(string str)
{
  int i;
  
  notify_fail("Was moechtest Du durchwuehlen?\n");
  if(!str) return 0;
  
  if((str=="ueberreste")||(str=="reste"))
    {
      if ((cl_rat == 0) && (!present("rat", ME)))
	{
	  write(BS("Du durchwuehlst sorgfaeltig die Ueberreste " 
		   "kannst aber ausser ein paar Ratten, die Du mit deiner Wuehlerei " 
		   "aufgescheucht hast, nichts besonderes feststellen."));
	  
	  for(i=0;i<3;i++)
	    clone_object(NPC "rat")->move(ME, M_GO, "aus den Ueberresten", 
					  "krabbelt", "krabbelt aus den Ueberresten");
	  cl_rat = 1;
	  
	  return 1;
	}
      else
	return write(BS("Du durchwuehlst sorgfaeltig die Ueberreste " 
			"kannst aber nichts besonderes feststellen.")),1;
    }
  return 0;
}

int grab_niche(string str)
{
  notify_fail("Wo moechtest Du hinein greifen?\n");
  if(!str) return 0;
  
  if((str=="nische")||(str=="in nische"))
    return write(BS("Du greifst in die Nische, tastest eifrig darin " 
		    "herum, und tatsaechlich ertastest Du etwas, kannst allerdings " 
		    "nicht definieren, was das etwas eigentlich ist, und ziehst "
		    "enttaeuscht Deine Hand wieder heraus. Vielleicht solltest Du "
		    "Dir etwas anderes einfallen lassen, um das Geheimnis zu "
		    "lueften.")),1;
  return 0;
}

int search_weakness(string str)
{
  notify_fail("Wonach moechtest Du suchen?\n");
  if(!str) return 0;

  if((str=="stelle")||(str=="stelle in ostwand")||
     (str=="nach stelle")||(str=="nach stelle in ostwand"))
    return write("Was fuer eine Stelle moechtest Du suchen?\n"),1;
  
  if((str=="schwachstelle")||(str=="schwachstelle in ostwand")||
     (str=="nach schwachstelle")||(str=="nach schwachstelle in ostwand"))
    if(present("\nfree_souls", TP))
      {
	write(BS("Du suchst die Wand sorgfaeltig nach einer moeglichen " 
		 "Schwachstelle ab. Du willst eigentlich schon aufgeben, als Du "
		 "gerade, als Du Dich von der Wand enttaeuscht abwenden willst einen "
		 "kleinen Riss entdeckst, der ausreichen duerfte, dass, wenn man ihn "
		 "mit brachialer Gewalt gezielt bearbeitet die Wand zum Einsturz zu "
		 "bringen ist."));
	
	found_weakness = 1;
	
	AddDetail("riss",
		  "Du bist Dir hundertprozentig sicher, dass der Riss es Dir "
		  "moeglich machen koennte, durch die Ostwand zu brechen.");
	return 1;
      }
    else
      return write(BS("Du suchst die Wand sorgfaeltig nach einer moeglichen " 
		      "Schwachstelle ab, aber so sehr Du Dich auch bemuehst kannst "
		      "Du keine ausmachen. Diese Wand wurde scheinbar erstklassig "
		      "gemauert.")),1;
  return 0;
}


int cut_wall(string str)
{
  object ob;
  
  notify_fail("Wo willst Du durchbrechen?\n");
  if(!str) return 0;

  if((str=="durch ostwand")||(str=="ostwand")||(str=="ostwand durch"))
    if(found_weakness)
      if(ob=deep_present("spitzhacke", TP))
	if(ob->QueryProp(P_WIELDED))
	  if(TP->QueryAttribute(A_STR) > 20)
	    {
	      write(BS("Du umfasst den Griff der Spitzhacke so " 
		       "fest Du kannst, holst weit aus, und hackst mit all Deiner " 
		       "Kraft auf den Riss in der Wand ein. Bereits nach wenigen " 
		       "Hieben hast Du ein faustgrosses Stueck aus der Wand " 
		       "herausgeschlagen. Angespornt durch diesen Etappensieg " 
		       "mobilisierst Du all Deine Kraefte und pruefst die Wand " 
		       "mit Deiner Spitzhacke aufs aeusserste. Schliesslich bricht " 
		       "die Wand in sich zusammen, und Du vor Erschoepfung nieder."));
	      
	      RemoveDetail("ostwand");
	      AddSpecialExit("osten", "head_east");
	      wall_cut = 1;
	      return 1;
	    }
	  else
	    return 
	      write(BS("Du umfasst den Griff der Spitzhacke so " 
		       "fest Du kannst, holst weit aus, und hackst mit all Deiner " 
		       "Kraft auf den Riss in der Wand ein. Nach, Deiner Meinung " 
		       "nach, bereits unendlichen Hieben fehlt bloss ein kleines " 
		       "Stueck in der Wand. Schon ein wenig deprimiert mobilisierst " 
		       "Du noch einmal all Deine Kraefte und hackst wie ein " 
		       "freigelassener Irrer auf die Wand ein. Schliesslich brichst " 
		       "nur Du vor Erschoepfung nieder, aber die Wand steht nach " 
		       "wie vor. Enttaeuscht stellst Du fest, dass Du dieser Aufgabe "
		       "scheinbar noch nicht gewachsen bist.")),1;
	else
	  return write(BS("Du solltest die Spitzhacke vielleicht doch " 
			  "erst zuecken?")),1;
      else
	return write(BS("Du hast leider nicht das noetige Werkzeug dabei, das " 
			"man benoetigt, um eine Wand dieser Art einzureissen.")),1;
    else
      return write(BS("Moeglicherweiser solltest Du erst nach einer Schwachstelle " 
		      "suchen, sonst wird das sicher nichts.")),1;
  return 0;
}

int head_east(string str)
{
  object pl;
  
  pl=TP;
  
  if((p_in_hell) ||(!present("\nfree_souls", TP)))
    return
      write(BS("Vorsichtig gehts Du einen Schritt nach Osten. " 
	       "Ploetzlich, wie aus dem Nichts tut sich vor Dir ein Abgrund auf, " 
	       "von dem Du schwoeren koenntest, dass er vorher noch nicht da war. " 
	       "Als Du genau hinhoerst, dringen von unten Geraeusche an Dein Ohr, " 
	       "die Dich zu dem Schluss kommen lassen, das da gerade wer "
	       "beschaeftigt ist. Da Du ja ein hoeflicher Held bist entscheidest "
	       "Du Dich einfach spaeter noch mal vorbeizukommen, wenn sich der "
	       "Trubel gelegt hat.")),1;
  move_player(pl);
  
  p_in_hell = 1;
	
  return 1;
}

move_player(object pl)
{
  write(BS("Vorsichtig gehts Du einen Schritt nach Osten."));
  
  say(BS("Vorsichtig geht "+pl->name()+" einen Schritt nach Osten."));
  
  pl -> SetProp(P_PARALYZED,
		([	
		  PARALYZE_TIME:-1, 
		  PARALYZE_MSG: "",
		  PARALYZE_MSG_OTHER: "",
		  PARALYZE_END: "",
		  PARALYZE_END_OTHER: ""
		 ]));
  
  if((find_call_out("move_player2")==-1) ||(find_call_out("move_player3")==-1) ||
     (find_call_out("move_player4")==-1) ||(find_call_out("move_dest")==-1) ||
     (find_call_out("move_dest2")==-1))
    call_out("move_player2", 6, pl);
}

move_player2(object pl)
{
  if(present(TP, ME))
    {
      write(BS("Ploetzlich, wie aus dem Nichts tut sich vor Dir ein Abgrund auf, " 
	       "von dem Du schwoeren koenntest, dass er vorher noch nicht da war."));
      
      call_out("move_player3", 6, pl);
    }
}

move_player3(object pl)
{
  if(present(TP, ME))
    {
      write(BS("Du hast ein ungutes Gefuehl bei der Sache, denn irgendetwas in Dir "
	       "sagt Dir, dass da unten das Boese auf Dich lauert."));
      
      call_out("move_player4", 6, pl);
    }
}

move_player4(object pl)
{
  if(present(TP, ME))
    {
      write(BS("All Deinen Befuerchtungen zum Trotz nimmst Du all Deinen Mut "
	       "zusammen, und beginnst den Abgrund hinunterzuklettern."));
      
      say(BS(CAP(pl->name())+" verschwindet in einem Abgrund."));
      
      call_out("move_dest", 6, pl);
    }
}

move_dest(object pl)
{
  if(present(TP, ME))
    {
      write("\n      -=< SHIT! >=-     \n\n");
      write(BS("...war das einzige Wort, das Du noch artikulieren konntest, als Du " 
	       "den Halt verloren hattest, und nun schlitterst Du in einem "
	       "Wahnsinnstempo den Abgrund hinunter."));
      
      write("\nDu denkst . o 0(na auf die landung bin ich gespannt  :<)\n\n");
      
      call_out("move_dest2", 3, pl);
    }
}

move_dest2(object pl)
{
  if(present(TP, ME))
    {
      write(BS("Das letzte an das Du Dich noch erinnern kannst, ist, dass " 
	       "Du Dich dem Boden bedrohlich schnell naeherst."));
		
      pl->move(VALLEY "gate2hell", M_GO, "", "",
	       "prallt von oben herab vor Dir auf dem Boden auf, und bleibt "
	       "bewusstlos liegen");
      
      pl->AddHp(-200);
      
      pl->SetProp(P_PARALYZED,
		  ([	
		      PARALYZE_TIME: 18, 
		      PARALYZE_MSG: "Du bist bewusstlos.\n",
		      PARALYZE_MSG_OTHER: "",
		      PARALYZE_END: "Du erwachst aus der Bewusstlosigkeit.\n",
		      PARALYZE_END_OTHER: "%s erwacht aus seiner Bewusstlosigkeit.\n"
		     ]));
    }
}

int go_northeast(string str)
{
  object pl;
  
  if(TP->QueryAttribute(A_DEX) > 20)
    {
      write(BS("Gerade als Du einen Schritt Richtung " 
	       "Nordosten machst stuerzt die Decke vor Dir ein. Du " 
	       "kannst gerade noch rechtzeitig einen Satz zurueck machen " 
	       "sonst waerst Du wohl jetzt unter den Truemmern begraben."));
      
      ceiling_down = 1;	
      RemoveExit("nordosten");
      AddSpecialDetail("truemmer", "rubble_scene");
      
      return 1;
    }
  else
    {
      write(BS("Gerade als Du einen Schritt Richtung " 
	       "Nordosten machst stuerzt die Decke ueber Dir ein, und " 
	       "und begraebt Dich unter sich."));
      
      pl = TP;
      b_pl = pl;
      
      SetProp(P_KILL_NAME, "Eine herabstuerzende Decke");
      pl->do_damage(30);
      
      player_burried_under_stones = 1;
      
      move_burried_player(pl);
      
      ceiling_down = 1;	
      RemoveExit("nordosten");
      AddSpecialDetail("truemmer", "rubble_scene");
      
      return 1;
    }
}

string rubble_scene(string str)
{
  if(player_burried_under_stones)
    {
      AddDetail("hilfe",
		"Du koenntest ja ein netter Mitmensch sein, und versuchen ihn zu "
		"befreien.");
			
      return BS("Truemmer verhinden, dass Du nach Nordosten gelangst. " 
		"Ausserdem scheint jemand verschuettet worden zu sein. Ob er "
		"vielleicht Hilfe benoetigt, um da wieder raus zu kommen?");
    }
  else		
    return BS("Truemmer verhindern, dass Du nach Nordosten gelangst.");
}

void SetVars(object pl)
{
  b_pl = pl;
  ceiling_down = 1;	
  RemoveExit("nordosten");
  AddSpecialDetail("truemmer", "rubble_scene");
  player_burried_under_stones = 1;
}

int free_player(string str)
{
  notify_fail("Wen willst Du befreien?\n");
  if(!str) return 0;
  
  if(player_burried_under_stones)
    if(str==lower_case(getuid(b_pl)))
      {
	tell_object(b_pl, 
		    CAP(TPN)+" befreit Dich aus den Truemmern.\n");
	
	b_pl->move(VALLEY "cave01", M_GO|M_NO_SHOW, "aus den Truemmern befreit", 
		   "wird", "kriecht dankbar unter den Truemmern hervor");
	
	player_burried_under_stones = 0;
	
	write_file(RUBBLE_LOG, 
		   sprintf("%s: %s wird von %s befreit.\n", dtime(time()),
			   CAP(getuid(b_pl)), CAP(getuid(TP))));
	
	return 1;
      }
    else
      return 0;
  else
    return notify_fail("Es ist ja niemand zu befreien hier!\n"),0;
}


int move_burried_player(object pl)
{
  pl->move(VALLEY "cave04", M_GO|M_NO_SHOW, 
	   "nach Nordosten und wird von Truemmern verschuettet", 
	   "geht", "wird von Dir aus den Truemmern befreit");
		
  write_file(RUBBLE_LOG, sprintf("%s: %s wird verschuettet.\n", dtime(time()),
				 CAP(getuid(pl))));
  
  return 1;
}

_query_int_long()
{
  string ret;
  
  ret="Da stehst Du nun Du armer Tor, und bist so klug als wie zuvor. Der " 
    "Fels ist angenehm kuehl, eine richtige Wohltat, nach den Temperaturen, denen " 
    "Du in der Wueste ausgesetzt warst.\n";
  
  if(ceiling_down)
    return ret + "Im Suedosten flackern kleine Lichter, und scheinbar stuerzte erst "
      "vor kurzem im Nordosten die Decke ein.\n";
  
  return ret + "Im Nord- und Suedosten flackern kleine Lichter.\n";
}

string d_northeast(string str)
{
  if(ceiling_down)
    if(player_burried_under_stones)
      return BS("Unzaehlige Truemmer verperren Dir den Weg, um nach " 
		"Nordosten zu gelangen. Es sieht fast so aus, als waere die Decke "
		"dort erst vor kurzem eingestuerzt. Irgendwie wirst Du das Gefuehl "
		"nicht los, dass jemand unter den Truemmern verschuettet ist.");
    else
      return BS("Unzaehlige Truemmer verperren Dir den Weg, um nach Nordosten zu "
		"gelangen. Es sieht fast so aus, als waere die Decke dort erst " 
		"vor kurzem eingestuerzt.");
  else
    return BS("Dort flackern kleine Lichter. Wer dort wohl sein mag? "
	      "Und ueberhaupt, wenn jemand dort ist, was macht derjenige dort?");
}

string d_faust(string str)
{
  if(present("\nfree_souls", TP))
    return BS("Absolut korrekt. Nun beginnst Du allerdings zu " 
	      "gruebeln, was dieser Faust mit Dir zu tun haben koennte. Als Du " 
	      "schliesslich den Zusammenhang erkennst, naemlich dass Faust mit " 
	      "dem Teufel einen Pakt schloss, und bist Du nicht auf einer " 
	      "aehnlichen Mission?");
  else
    return BS("Du ballst Deine Rechte zu einer Faust, kannst aber " 
	      "nichts besonderes feststellen.");
}

string d_pakt(string str)
{
  if(present("\nfree_souls", TP))
    return BS("Hier ist niemand, mit dem Du einen Pakt schliessen " 
	      "koenntest, und wenn, waere es bei Gott nicht ratsam.");
  else
    return "Sowas siehst Du da nicht.\n";
}

string d_mission(string str)
{
  if(present("\nfree_souls", TP))
    return BS("Hat Dich der Moench nicht ausgesandt, um eine " 
	      "delikate Angelegenheit zu regeln?");
  
  if(present("\fennek", TP))
    return BS("Wolltest Du Ptahla nicht etwas bringen?");
  
  return BS("Du befindest Dich derzeit auf keiner Mission, oder etwa doch?");
}

string d_ptahla(string str)
{
  if(present("\fennek", TP))
    return BS("Hier wirst Du sie sicher nicht finden, sie ist " 
	      "und bleibt wo sie hingehoert.");
  else
    return "Sowas siehst Du da nicht.\n";
}

string d_temp(string str)
{
  if(deep_present("thermometer", TP))
    return BS("Um die Temperatur zumindest ungefaehr zu erfahren " 
	      "koenntest Du doch einmal Dein Thermometer untersuchen.");
  else
    return BS("Tsja, haettest Du ein Thermometer bei Dir, so " 
	      "koenntest Du einen Blick darauf werfen, aber so musst Du Dich leider " 
	      "damit begnuegen, dass es hier herinnen angenehm kuehl ist.");
}

string d_reason(string str)
{
  if(present("\nfree_souls", TP))
    return BS("Was auch immer der Grund fuer die Erbauer gewesen " 
	      "sein mag, vielleicht hast Du ja einen, um zu versuchen diesen Teil " 
	      "der Hoehle neu zu entdecken.");
  else
    return BS("Was auch immer der Grund fuer die Erbauer gewesen " 
	      "sein mag, du bist Dir sicher, dass sie Ihre Gruende hatten zu tun, "
	      "was sie taten.");
}

reset()
{
  ::reset();
  
  cl_rat = 0;
  found_weakness = 0;
  RemoveDetail("riss");
  wall_cut = 0;
  RemoveSpecialExit("osten");
  
  if(player_burried_under_stones)
    ceiling_down = 1;
  else
    {
      ceiling_down = 0;
      RemoveDetail("truemmer");
      AddSpecialExit("nordosten", "go_northeast");
    }
}
