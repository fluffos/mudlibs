inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Wuestendorf");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im suedoestlichsten Teil des Wuestendorfes, dessen "
	     "Zentrum eine kleine Oase ist, die sich im Nordwesten befindet. "
	     "Im Osten wird das Dorf durch das Tibesti-Gebirge begrenzt. Ein "
	     "grosses Haus siehst Du im Norden."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_DESERT]));
  
  STANDARD6
  GROUND6
  House
  Berber
  SKY6
	
  AddDetail(({"zentrum", "oase"}),
	     "Im Nordwesten! Hier bestimmt nicht.\n");
  AddDetail(({"hals"}),
	    "Du tastest sorgfaeltig Deinen Hals ab, und kommst zu dem Schluss, dass "+
	    "alles dort ist wo es hingehoert.\n");
  AddDetail(({"schluss"}),
	    "Willst jetzt schon aufgeben?\n");
  AddDetail(({"klinge", "kreuz"}),
	     "Die Klingen ihrer Schwerter waren gerade, dadurch aehnelten diese einem Kreuz, "+
	     "dem wohl typischsten christlichen Symbol schlechthin.\n");
  AddDetail(({"symbol"}),
	    "Das Symbol der Christen ist das Kreuz.");
  AddDetail(({"christ", "christen"}),
	     "Bist Du einer?\n");
  AddDetail(({"einwohner", "einheimische"}),
	     "Keiner da. Das ist schon ein sehr eigenartiges Volk.");
  AddDetail(({"teil"}),
	    "Hier bist Du im suedoestlichsten Teil, folglich erstreckt sich das Wuestendorf "+
	    "in nordwestlicher Richtung.\n");
  AddDetail(({"tibesti", "gebirge", "berg"}),
	     "Es umschliesst das Dorf im Sueden und Osten. Die "
	     "Felswaende sind hier, bis auf ein kleines Loch, besonders steil.\n");
  AddDetail(({"loch"}),
	     "Das Loch ist mitten in der Felswand. Du wuerdest sogar hindurchpassen und "
	     "weiter nach Osten gehen koennen!");
  
  AddExit("norden", ARAGH "raum48");
  AddExit("westen", ARAGH "raum45");
  
  AddExit("osten", 
	  ([
	    EX_DEST: "/d/wueste/verdandi/friedhof/room/berg-unten",
	    EX_MSG: "in eine Hoehle im Osten",
	    EX_PLMSG: "Du quetschst Dich durch das Loch in die Hoehle dahinter." ]));
}

