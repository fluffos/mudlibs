//Ar-Thoas
//vorhof zur hoelle
//step through the door and your soul will be lost...
//several demon-guards guard the gate to hell...

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"


string *gewarnt = ({});
#define WARNED (member(gewarnt, getuid(this_player()))!=-1)

create()
{
	::create();

	SetProp( P_INT_SHORT, "Vor dem Tor" );
	SetProp( P_INT_LONG, "Das hier ist die Vorhalle zur Hoelle.\n");

	SetProp( P_LIGHT, 0);
	SetProp( P_LIGHT, 0);
	SetProp( P_INDOORS, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 33, ENV_TERRAIN:TT_OTHER]) );
	
	//AddItem(NPC+"demonguard", REFRESH_DESTRUCT);
	
	AddSpecialExit("tor", "enter_hell");
	AddSpecialExit("welt", "flee_wimp");
}


flee_wimp()
{
	this_player()->move("/d/dschungel/feyaria/felseninsel/room/steg", M_TPORT);
	return 1;
}

int enter_hell(string str)
{
  if (WARNED)
  {  
  	if (this_player()->QueryProp(P_LEVEL) < 60)
  	{
  	 write ("Du bist noch nicht reif dafuer, versuch es spaeter wieder. \n");
  	 return -1;
  	}
	else
	{
    this_player()->move(PATH+"hell", M_GO);
    return 1;
    }
  }
  else
 {
  write("Du erinnerst Dich an die Worte des Monechs, so von wegen sterben und Tod "+
  		"und bist Dir auf einmal garnicht mehr so sicher, dass Du da durch willst. \n");
  		
  gewarnt += ({getuid(this_player())});
 }
}

void reset()
{
  ::reset();
  gewarnt=({});
}
