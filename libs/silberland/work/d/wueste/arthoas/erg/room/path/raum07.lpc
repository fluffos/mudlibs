//Ar-Thoas
//desert

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

int cloned;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad");
  SetProp(P_INT_LONG,
	  "Flora kannst Du hier nur noch nach genauerer Suche finden, was "
	  "Dich aber auch nicht weiter verwundert, schliesslich fuehlst Du "
	  "Dich in dieser Umgebung auch nicht unbedingt heimelig. Im "
	  "Suedosten kannst Du im Berg eine Art Einkerbung erkennen. Das "
	  "Flimmern der Luft hat bereits deutlich zugenommen, und im "
	  "Gegensatz dazu die Vegetation ab.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 32, ENV_TERRAIN:TT_ROAD]) );
  
  STANDARD1
  STDSKY1
    
  AddDetail(({"mensch", "menschen"}),
	     "Menschen leben hier schon sehr lange.");
  AddDetail("raum",
	    "Jaaa, Du bist in einem Raum, open-air sozusagen.");
  AddDetail("suche",
	    "Na such mal schoen, wer weiss was Du findest.");
  AddDetail(({"luftfeuchtigkeit", "feuchtigkeit"}),
	    "Meinst Du wirklich, dass Du in der Lage bist, die Luftfeuchtigkeit "
	    "festzustellen?");
  AddDetail("abkuehlung",
	    "Sei nicht so zimperlich.");
  AddDetail(({"aug", "auge", "augen"}),
	    "Augen zu und durch.");
  AddDetail("gestein",
	    "Im Erdinneren ist es fluessig.");
  AddDetail(({"erdinneren", "erdinneres", "inneres", "erdinnen"}),
	    "Unter Dir. Aber genau genommen siehst Du sowas hier nicht.");
  AddDetail("einkerbung",
	    "Vielleicht solltest Du naeher ran gehen?");
  AddDetail(({"beinbruch", "bruch", "knoechel"}),
	    "Diesmal bist Du noch heil davon gekommen, aber Du hast vollkommen recht, "
	    "eigentlich solltest Du den Stein nehmen, und ihn weit weg schleudern, "
	    "damit sich nicht eines Tages doch noch jemand daran verletzt.");
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite.");
  AddDetail(({"flora", "bewuchs", "vegetation"}),
	    "Gras waechst hier fast ueberhaupt nicht, genau genommen waechst hier "
	    "gar nichts, auf diesem steinigen Untergrund.");
  AddDetail(({"untergrund", "grund", "umgebung"}),
	    "An und fuer sich ist das ja noch der typische Boden einer Steppenlandschaft "
	    "ausser, dass er hier sehr hart ist, und aufgrund der hohen Temperatur "
	    "beziehungsweise der niederen Luft- und Bodenfeuchtigkeit waechst hier fast kein "
	    "Gras mehr.");
  AddDetail(({"gras", "pflanzen"}),
	    "Das Gras ist hier schon derart verdorrt, dass es vollkommen -ja fast schon "
	    "weiss ist.");
  AddDetail(({"feuchtigkeit", "bodenfeuchtigkeit", "wasser"}),
	    "Da der Boden hier so hart und rissig ist, versickert das Wasser sofort in "
	    "den Ritzen.");
  AddDetail(({"ritzen", "risse"}),
	    "Der Boden ist hier derart vertrocknet, dass er voll davon ist.");
  AddDetail(({"koepfe", "jahre", "hoehe", "gott", "entfernung"}),
	    "Hier siehst Du sowas nicht.");
  AddDetail(({"monument", "erhoehung", "erscheinung"}),
	    "Ziemlich genau im Sueden nun. Du wirst das Gefuehl nicht los, dass das "
	    "nicht natuerlichen Ursprungs ist.");
  AddDetail("gefuehl",
	    "Falls Dich Dein Gefuehl nicht taeuscht bist Du fest davon ueberzeugt, dass "
	    "es von unbekannten Wesen vor langer Zeit erbaut wurde.");
  AddDetail("wesen",
	    "Vielleicht triffst Du ja welche, aber vielleicht sind auch schon alle tot, "
	    "wer weiss?");
  AddDetail("es",
	    "Fuer Details bist Du zu weit entfernt, aber nah genug, zu erkennen, dass "
	    "diese Erhoehung exorbitante Aehnlichkeiten zu einem Aussichtsturm aufweist.");
  AddDetail("aehnlichkeiten",
	    "Wahrlich verblueffend.\n");
  AddDetail(({"aussichtsturm", "turm"}),
	    "Du koenntest Dich natuerlich irren -aber diese Aehnlichkeiten...\n");
  
  AddSound(DEFAULT_SOUND,
	   "Komisch Dir war so, als haettest Du ein *Zischen* gehoert.");
  AddSound("zischen",
	   "Tatsaechlich da war es schon wieder. Doch irgendwie kannst Du "
	   "von hier aus nicht den Ursprung des Geraeusches feststellen.");
  
  /*
    AddSpecialDetail("stein", "found_stone");
    
    AddItem(OBJ"stone", REFRESH_REMOVE);
    
    AddDetail(({"stein"}),
    "\nAutsch!!!!\n"
    "\n"
    "Ups, Du bist von einem kleinen Stein abgerutscht, und haettest "
    "Dir beinahe den Knoechel verletzt. "
    "Da liegt dieses Ding nun so unschuldig am Boden herum, und haette "
    "Dir doch beinahe einen Beinbruch verursacht.");
  */

  AddExit( "osten", PATH "raum08" );
  AddExit("westen", PATH "raum06");
}

