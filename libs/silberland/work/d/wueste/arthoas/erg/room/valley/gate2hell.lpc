//Ar-Thoas
//vorhof zur hoelle
//step through the door and your soul will be lost...
//several demon-guards guard the gate to hell...

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "cave.h"

#define TEUFEL "/d/wasser/dante/zinsel/room/inferno"

string d_wall(string str);
string d_torch(string str);
int enter_hell(string str);

nosave int found_torch, torch_light, i;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Vor einem uralten Tor");
  SetProp(P_INT_LONG, 
	  BS("Das hier ist die Vorhalle zur Hoelle, der einzige sichtbare " 
	     "Ausgang ist ein gewaltiges Tor im Norden. Dir faellt auf, dass dieser "
	     "Teil der Hoehle exrem hoch ist, und die Waende im Gegensatz zu denen, "
	     "die Du bisher gesehen hattest besonders sorgfaeltig in den Fels "
	     "gearbeitet wurden. Aber ansonsten ist dieser Raum komplett kahl.\n"));
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 40, ENV_TERRAIN:TT_CAVE]));
  
  
  AddDetail(({"hoehle", "raum", "vorhalle", "halle", "ort"}), 
	    ME->QueryProp(P_INT_LONG));
  AddDetail("tor",
	    "Auf dem Tor siehst Du praechtige Verzierungen, und schimmernde "
	    "Intarsien.");
  AddDetail("verzierung"
	    "Auf dem Tor sind viele Verzierungen.");
  AddDetail("verzierungen",
	    "Symbole aus Gold, die mit Edelsteinen ausgeschmueckt sind.");
  AddDetail(({"symbole", "zeichen"}),
	    "Uralte Zeichen, die aelter sind als alles Leben auf dieser Welt, und "
	    "mitten drinnen eine gehoernte Fratze.");
  AddDetail("fratze",
	    "Es scheint ein Bildnis des Fuersten zu sein.");
  AddDetail(({"darstellung", "bildnis"}),
	    "Du hast in Deinem Leben schon so manche Darstellung von ihm gesehen, "
	    "aber noch keine wirkte so real...hatte so eine Ausstrahlung...so wie "
	    "diese.");
  AddDetail("leben",
	    "Noch bevor es Leben gab, galten diese Symbole bereits als alt.");
  AddDetail("welt",
	    "Das SilberLand ist doch nicht alles, viele Regionen warten auf ihre " 
	    "Entdeckung. Sie liegen brach bis sich ein Magier findet, der sich ihrer "
	    "annimmt, und sie erschliesst.");
  AddDetail(({"regionen", "silberland"}),
	    "Darueber erfaehrst Du am schnellsten das meiste, wenn Du los ziehst, "
	    "bis in die entlegendsten Winkel.");
  AddDetail("winkel",
	    "Ja, das Silberland ist gross und logischerweise auch sehr verwinkelt. " 
	    "Vieles ist auf den ersten Blick nicht das was zu sein scheint.");
  AddDetail("blick",
	    "Oftmals muss man schon ganz genau forschen, um etwas zu erreichen.");
  AddDetail("magier",
	    "Hier ist keiner, es sei denn er ist grad invis.");
  AddDetail("entdeckung",
	    "Scheinbar bist Du hier einer wahrlich grossen Sache auf der Spur.");
  AddDetail("sache",
	    "Tsja, das musst Du schon selbst herausfinden.");
  AddDetail("spur",
	    "Prinzipiell solltest Du jede Spur verfolgen, die sich Dir bietet, man " 
	    "weiss ja nie wohin sie fuehrt.");
  AddDetail("boden",
	    "Der Boden wurde scheinbar vor langer langer Zeit mit Marmor " 
	    "ausgelegt.");
  AddDetail("zeit",
	    "Ach Zeit ist etwas aeusserst vergaengliches, wovon man nie genug "
	    "haben kann.");
  AddDetail("decke",
	    "Ist hoch ueber Dir, das Loch, durch das Du gefallen bist, kannst Du "
	    "nicht einmal erahnen.");
  AddDetail("loch",
	    "Ehrlich, Du siehst es nicht.");
  AddDetail(({"gold", "edelsteine", "edelstein", "silber"}),
	    "An dem Tor findest Du davon reichlich, allerdings bekommst Du das von "
	    "dort niemals ab.");
  AddDetail("gegensatz",
	    "Der Unterschied ist schon gewaltig.");
  AddDetail("unterschied",
	    "Moeglicherweise ruehrt er daher, dass die obigen Raeume bloss "
	    "geschaffen wurden, weil man eben diesen Raum hier finden wollte, "
	    "und das so rasch als moeglich.");
  AddDetail("raeume",
	    "Echt? Wo? Hier ist doch nur ein Raum.");
  AddDetail("ausgang",
	    "Du koenntest ja Dein Glueck mit dem Tor versuchen.");
  AddDetail("glueck",
	    "Wobei...ich fuerchte Du wirst nicht viel Glueck haben, weder beim "
	    "Versuch das Tor zu oeffnen, noch, falls es Dir doch gelingen sollte, "
	    "dahinter.");
  AddDetail("versuch",
	    "Klar, versuchen kannst Du es natuerlich. Aber vielleicht willst Du was "
	    "dahinter liegt ja garnicht finden.");
  AddDetail("hoelle",
	    "Dieses Tor hier scheint doch tatsaechlich das Tor zur Hoelle zu sein, "
	    "dessen bist Du Dir mittlerweile sicher.");
  AddDetail(({"einlegearbeiten", "intarsien"}),
	    "Herrliche Einlegearbeiten aus Silber, vermutlich schimmern sie deshalb "
	    "so schoen.");
  AddDetail("teil",
	    "Irgendwie hat dieser Bereich der hoehle eine ganz eigene Ausstrahlung.");
  AddDetail("bereich",
	    "Verglichen mit dem Teil der Hoehle, der sich oben befindet.");
  AddDetail(({"ausstrahlung", "strahlung"}),
	    "Du kannst das Boese, das hinter dem Tor zu lauern scheint, foermlich "
	    "fuehlen.");
  AddDetail("boese", 
	    ([  
	      0: "Es gibt Maechte auf dieser Welt, die so finster sind, dass sie "
	      "sogar Dunkelelfen erschaudern lassen.", 
	      "dunkelelf": 
	      "Es gibt Maechte auf dieser Welt, die so finster sind, dass sogar Du " 
	      "als Dunkelelf erschauderst." ]));
  AddDetail("maechte",
	    "Den finsteren Maechten ist nichts heilig, sie schrecken vor nichts und "
	    "niemand zurueck, selbst ihre Verbuendeten vernichten sie, wenn sie "
	    "obsolet geworden sind.");
  AddDetail("verbuendete",
	    "So mancher hat trotz eines Paktes mit den Maechten der Finsternis den "
	    "Hauch des Lebens ausgehaucht, nachdem die Maechte keine Verwendung mehr "
	    "fuer ihn hatten.");
  AddDetail("finsternis",
	    "Moegest Du gewappnet sein, wenn Du gezwungen sein solltest ihr "
	    "gegenueberzutreten.");
  AddDetail("pakt",
	    "Dieser Rat ist gratis: Schliesse niemals einen Pakt mit einem Fuersten "
	    "der Finsternis.");
  AddDetail(({"rat", "ratschlaege"}),
	    "Schluss mit Ratschlaegen, von nun an bist Du auf Dich allein gestellt.");
  AddDetail(({"fuersten", "fuerst"}),
	    "Hier ist doch garkein Fuerst.");
  AddDetail("hauch",
	    "Hoffe, und bete, dass Dir das nicht all zu frueh widerfaehrt.");
  AddDetail("verwendung",
	    "Sie verwenden ihre Verbuendeten, ohne, dass diese es merken, dazu, um "
	    "ihre dunklen Ziele zu erreichen.");
  AddDetail(({"ziel", "ziele"}),
	    "Zu verhindern, dass sie ihr Ziel erreichen, das sollte die Aufgabe "
	    "eines jeden sein. Immer und ueberall.");
  AddDetail("aufgabe",
	    "Mach den Kampf gegen all das Uebel, und gegen all die vorherrschende "
	    "Ignoranz, zu Deiner Aufgabe, und Du schaffst Dir eine bessere Welt.");
  AddDetail(({"uebel", "ignoranz"}),
	    "Ignoranz ist die Mutter aller Uebel.");;
  AddDetail("mutter",
	    "Na meinst Du echt, dass Du hier eine Mutter findest, ausgerechnet "
	    "hier?.");
  AddDetail("kampf",
	    "Noe, hier nicht...zumindest nicht gerade.");
  AddDetail("marmor",
	    "Der Boden wurde mit pechschwarzem Marmor ausgelegt. Irgendwie "
	    "eingenartig, obwohl dieser Raum wohl schon fuer Jahrhunderte "
	    "verschlossen gewesen sein muss, befindet sich nicht ein winziges "
	    "Staubkorn auf dem Boden.");
  AddDetail(({"korn", "staubkorn"}),
	    "Nicht ein einziges.");
  AddDetail("jahrhunderte",
	    "Hm, wieviele genau weisst Du natuerlich nicht, aber es muessen schon "
	    "ein paar gewesen sein, dem Tor nach zu urteilen.");
  AddSpecialDetail(({"fels", "waende"}), "d_wall");
  AddDetail("sorgfalt",
	    "Bei einer derartigen Genauigkeit muss man schon sehr sorgfaeltig "
	    "arbeiten schlussfolgerst Du richtig.");
  AddDetail("genauigkeit",
	    "Aber warum hier unten so viel Wert auf Genauigkeit gelegt wurde ist "
	    "Dir ein unverstaendlich.");
  AddDetail(({"wert", "begriff"}),
	    "Jeder empfindet etwas anderes als wertvoll. Es ist halt ein sehr "
	    "subjektiver Begriff.");
  AddDetail("wand",
	    "Hier gleicht jede Wand der anderen, ausser der Nordwand.");
  AddDetail("nordwand",
	    "In die Nordwand wurde ein gewaltiges Tor eingarbeitet.");
  AddDetail("unebenheit",
	    "Als Du die Waende ein zeites mal betrachtest, kannst Du doch ein paar "
	    "Unebenheiten feststellen.");
  AddSpecialDetail(({"unebenheiten"}), "d_torch");
  AddDetail("fackeln",
	    "Hm...eigenartig sie sehen absolut neu aus...Du wunderst Dich ob dieser "
	    "Tatsache. ");
  AddDetail("tatsache",
	    "Neuwertige Fackeln an einem Ort, an dem schon ewig niemand mehr war?");
  
  //AddItem(NPC "demonguard", REFRESH_DESTRUCT);
  
  AddExit("tor", TEUFEL);
}


reset()
{
  ::reset();
  
  if(i == 6)
    {
      found_torch = 0;
      torch_light = 0;
    }
  i++;
}

int enter_hell(string str)
{
  write("\nDie Felsengruende waren SEIN,\nmit Gold verziert und Edelstein\n" 
	"Und silbern koestlich ausgelegt,\nDas Tor mit Zauberkraft gepraegt...\n\n");
  return 1;
}


string d_torch(string str)
{
  found_torch = 1;
  
  AddCmd("zuende", "lighten_torch");
  
  return BS("Jetzt erst erkennst Du, dass es sich um Fackeln handelt.");
}

nosave int lighten_torch(string str)
{
  notify_fail("Was willst Du denn anzuenden?\n");
  if(!str) return 0;

  if(found_torch)
    {
      if(str=="fackel an")
	return write(BS("Wieso Singular? Willst Du denn nicht gleich alle "
			"anzuenden?")),1;
      
      if((str=="fackeln an")||(str=="alle fackeln an"))
	{
	  write(BS("Mit einem klitzekleinen Feuerball zuendest Du die Fackeln an " 
		   "der Wand an."));
	  
	  torch_light=1;
	  i=1;
	  SetProp(P_LIGHT, 6);
	  return 1;
	}
    }
  return 0;
}

string d_wall(string str)
{
  if(found_torch)
    if(torch_light)
      return BS("Die Waende hier wurden scheinbar mit einer grossen Sorgfalt " 
		"in den Fels gearbeitet. Ausserdem siehst Du, ausgenommen von "
		"der Nordwand, in der Mitte jeder Wand eine brennende Fackel "
		"stecken.");
    else
      return BS("Die Waende hier wurden scheinbar mit einer grossen Sorgfalt " 
		"in den Fels gearbeitet. Ausserdem siehst Du, ausgenommen von der "
		"Nordwand, in der Mitte jeder Wand eine Fackel stecken.");
  else
    return BS("Die Waende hier wurden scheinbar mit einer grossen Sorgfalt " 
	      "in den Fels gearbeitet. Nicht die kleinste Unebenheit ist "
	      "auszumachen.");
}
