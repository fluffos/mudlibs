inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "valley.h"

move_pl_west();
move_pl_southwest();
move_pl_southwest2();
move_pl_dest();

nosave string *gewarnt = ({});

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Wuestental");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Erg, wie die Einwohner die Sandwueste nennen. " 
	     "Ein kleines Wuestendorf liegt im Osten. In Richtung Suedwesten kannst " 
	     "Du die unendlichen Weiten der Wueste erkennen. "
	     "Im Westen verhindert Treibsand ein Vorankommen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 40, ENV_TERRAIN:TT_DESERT]));
  
  SetProp(P_KILL_NAME, "Treibsand");
  
  STANDARD3
  STDSKY3
  
  AddDetail(({"gehirn"}),
	    "Das Vorhandensein des selbigen, vereinfacht den Denkprozess. ");
  AddDetail(({"denkprozess"}),
	    "try one... ");
  AddDetail(({"vorhandensein"}),
	    "Sowas siehst Du hier nicht. ");
  AddDetail(({"bewuchs"}),
	    "Das findest Du hier bestimmt nicht.");
  AddDetail(({"seite"}),
	    "Wenn Du lieb und nett bist, schick ich Dir mal ne Seite voll mit " 
	    "Orten an denen Du Forscherpunkte findest. ");
  AddDetail(({"punkt"}),
	    "-= . =- ");
  AddDetail(({"orte"}),
	    "Hm...vielleicht suchst Du doch besser selbst danach. ");
  AddDetail(({"forscherpunkte"}),
	    "Ohje...die hat Dir schon wer weggeschnappt. ");
  AddDetail(({"forscherpunkt"}),
	    "Tatsaechlich da war noch einer =:> Scheinbar hat ihn Dein "
	    "Vorgaenger uebersehen. ");
  AddSmell(DEFAULT_SMELL,
	   "Nahezu absolut geruchlos ist die Wueste hier.");
  AddSound(DEFAULT_SOUND,
	   "Aus dem Osten dringen Geraeusche an Dein Ohr. ");
  AddSound(({"geraeusche"}),
	   "Von hier kannst Du nichts genaueres feststellen, vielleicht solltest " 
	   "Du naeher ran gehen? ");
  AddDetail(({"boden"}),
	    "Sand, Sand, Sand!");
  AddDetail(({"sand"}),
	    "Du kannst an diesem Sand nichts Besonderes erkennen.");
  AddDetail(({"vorankommen"}),
	    "Ein weitergehen Richtung Westen solltest Du Dir gleich wieder "
	    "aus dem Kopf schlagen, so mancher hat sein Leben im Treibsand "
	    "verloren. Als einzige reale Alternative steht Dir bloss der "
	    "Weg nach Osten zur Verfuegung. ");
  AddDetail(({"sichelduene"}),
	    "Diese Duenenart entsteht, wenn der Wind laengere Zeit aus einer " 
	    "Richtung blaest. ");
  AddDetail(({"ausgang", "verfuegung"}),
	    "Du solltest Dich bald entscheiden, soviel Auswahl hast Du auch "
	    "wieder nicht. ");
  AddDetail(({"auswahl"}),
	    "Waehle weise zwischen Osten und Westen =:> ");
  AddDetail(({"treibsand"}),
	    "Im Westen erstreckt sich soweit Dein Auge reicht nichts als der "
	    "gefuerchtete Treibsand, der schon so manchem wackeren Abenteurer "
	    "das Leben gekostet hat. ");
  AddDetail(({"abenteurer"}),
	    "Du koenntest Dich ja nach Westen vorwagen, und in die Fussstapfen "
	    "grosser Helden steigen. ");
  AddDetail(({"fussstapfen"}),
	    "Im Treibsand?");
  AddDetail(({"stapfen"}),
	    "Na los, beweise Deinen heroischen Wagemut und stapfe drauflos.");
  
  AddExit("osten", ARAGH "raum40");
  AddSpecialExit("westen", "head_west");
}

nosave int head_west(string dir)
{
  object ob, pl;
  
  if((member(gewarnt, getuid(pl=TP))>=0))
    if(ob=present("\nssandschuhe", pl))
      if(ob->QueryProp(P_WORN)==pl)
	if(ob=present("\nquicksand", pl))
	  return move_pl_west(pl),1;
	else
	  {
	    clone_object(OBJ "quicksand")->move(pl, M_NOCHECK);
	    move_pl_west(pl);
	    return 1;
	  }
      else
	notify_fail("Du hast die erforderliche Ausruestung nicht angezogen.\n");
    else
      notify_fail("Du hast die erforderliche Ausruestung ja gar nicht dabei.\n");
  else
    {
      write(BS("Du bist Dir ploetzlich gar nicht mehr so sicher, "
	       "ob Du ueberhaupt schon bereit bist nach Westen zu gehen, vielleicht "
	       "solltest Du ja sicherheitshalber nochmal Deine Ausruestung "
	       "ueberpruefen. So mancher ist im Treibsand einfach spurlos "
	       "verschwunden."));
      
      say(BS(pl->Name()+" will nach Westen gehen, haelt dann aber doch noch "
	     "einmal inne, um dieses Entscheidung noch einmal zu ueberdenken."));
      
      gewarnt+=({getuid(pl)});
      
      return 1;
    }
  return 0;
}

void reset()
{
  ::reset();
  
  gewarnt=({});
}

move_pl_west(object pl)
{
  write(BS("Langsam und behutsam wagst Du Dich einen Schritt vor. Du stellst "
	   "fest, dass Du trotz des Treibsandes nicht versinkst. "
	   "Du bist Dir auch ganz sicher, dass Du diesen Effekt den Schuhen "
	   "zu verdanken hast, und bist nun sehr froh sie zu tragen. Zuversichtlich "
	   "setzt Du Deinen Weg nach Westen fort."));
	
  say(BS(pl->Name()+" wagt sich nach Westen, und verschwindet "
	 "schon nach kurzer Zeit aus Deiner Sichtweite. "));
	
  pl->SetProp(P_PARALYZED, 
	      ([
		PARALYZE_TIME:45, 
		PARALYZE_MSG: "Du wanderst gerade durch den Treibsand!\n",
		PARALYZE_MSG_OTHER: "",
		PARALYZE_END: "",
		PARALYZE_END_OTHER: ""]));
								
  pl->move("/room/void", M_GO|M_SILENT|M_NOCHECK|M_NO_SHOW);
	
  if((find_call_out("move_pl_southwest")==-1)||
     (find_call_out("move_pl_southwest2")==-1)||
     (find_call_out("move_pl_dest")==-1))
    call_out("move_pl_southwest", 9, pl);
}

move_pl_southwest(object pl)
{
  tell_object(pl, 
	      BS("Schon nach kurzer Zeit ragt vor Dir das Hoggar-Massiv empor, und "
		 "zwingt Dich Deinen Weg Richtung Suedwesten fortzusetzen, da Du "
		 "dort eine Moeglichkeit ausmachen kannst, an dem Berg "
		 "vorbeizukommen."));
  
  call_out("move_pl_southwest2", 12, pl);
}

move_pl_southwest2(object pl)
{
  tell_object(pl, 
	      BS("Du hattest scheinbar recht behalten, denn nun befindest Du Dich "
		 "suedlich des Massivs, das mit seiner gigantischen Hoehe das Tor "
		 "zur Goetterwelt zu sein scheint. Unweit im Westen kannst Du schon "
		 "deutlich erkennen, dass die Wueste immer mehr Vegetation "
		 "aufzuweisen scheint."));
  
  call_out("move_pl_dest", 9, pl);
}


move_pl_dest(object pl)
{
  tell_object(pl, 
	      BS("Tatsaechlich, Du naeherst Dich bereits dem Ende des Treibsandes, "
		 "der fast nahtlos einer Steppenlandschaft weicht. Direkt an der "
		 "Grenze, fast schon wie eine Art Grenzwall wachsen ein paar "
		 "Dornbuesche und ein wenig vertrocknetes Gestruepp, das " 
		 "Du in Deiner Euphorie endlich wieder 'festen' Boden unter Deine "
		 "Fuesse zu bekommen, behende ueberwindest."));
  
  pl->move("/d/ebene/lostboy/steppe/room/steppe5", M_GO|M_SILENT|M_NOCHECK);
  
  pl->SetProp(P_PARALYZED, 0);
}
