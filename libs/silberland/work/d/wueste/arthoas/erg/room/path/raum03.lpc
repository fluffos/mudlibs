/*
  Ar-Thaos
  desert
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "path.h"

nosave int cloned;

string found_oryx();

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Steppenpfad");
