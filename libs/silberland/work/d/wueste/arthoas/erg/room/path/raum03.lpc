  AddDetail("tiere",
	    "Hier findet man so manche Tiere, schau Dich halt ein wenig um.");
  
  AddDetail("krone",
	    "Sie waechst eher mehr in der Horizontalen, als im Senkrechten. Sieht " 
	    "irgendwie fast wie ein ueberdimensionaler Pilz aus.");
  
  AddDetail("pilz",
	    "Frag den Schwammerlsucher, der weiss darueber mehr.");
  
  AddDetail(({"schwammerlsucher", "sucher"}),
	    "Nordwestlich von Midas.");
  
  AddDetail(({"midas", "metropole"}),
	    "Sag bloss Du kennst die Metropole Midas nicht...schaem Dich! ");
  
  AddDetail(({"horizontal", "horizontale"}),
	    "Naaaaa, nicht was Du jetzt denkst.\n");
  
  AddDetail(({"senkrecht", "senkrechte"}),
	    "Senkrecht bedeutet 90 Grad auf waagrecht/horizontal.");
  
  AddDetail("grad",
	    "Du nimmst 1 Grad und untersuchst es bis in kleinste Detail aufs peinlichste " 
	    "genau. Du kommst zu dem Schluss: 1 Grad entspricht genau 1 Grad, und hat keinen " 
	    "materiellen Wert.");
  
  AddDetail("wert",
	    "Keinen, ich wiederhole keinen Wert!\n");
  
  AddDetail("schluss",
	    "Wer hat an der Uhr gedreht, ist es wirklich schon sooo spaet? ...");
  
  AddDetail("uhr",
	    "Tippe mal <zeit>\n");
  
  AddDetail(({"detail", "details"}),
	    "Details werden von Magiern beschrieben, damit dann Spieler wie Du etwas untersuchen " 
	    "koennen. Mancher Magier schreibt mehr, mancher weniger...that's life.");
  
  AddDetail("magier",
	    "Sei immer schoen nett zu Magiern.");
  
  AddDetail("spieler",
	    "Es gibt artige und unartige...hoffentlich bist Du ein artiger, sonst erwarten Dich " 
	    "noch ein paar boesartige Ueberraschungen.  :> ");
  
  AddDetail(({"ueberraschungen", "ueberraschung"}),
	    "Geh sei kein Spielverderber, waer doch oed, wenn ich Dir das jetzt schon " 
	    "verrate.");
  
  AddDetail("spielverderber",
	    "z.B. Jene, die immer alles gleich wissen wollen ");
  
  AddDetail("blaetter",
	    "Auf dem Baum selbst befinden sich fast keine mehr, da er sie bei " 
	    "zunehmender Hitze abwirft.");
  
  AddDetail("gras",
	    "Vor langer Zeit waren das bestimmt saftige gruene Wiesen, doch heute " 
	    "ist davon bloss noch verdorrtes Gras ueber.");
  
  AddDetail(({"wiese", "wiesen"}),
	    "Sowas siehst Du da nicht mehr! ");
  
  AddDetail(({"untergrund", "grund"}),
	    "Eine doch recht trockene und staubige Angelegenheit.");
  
  AddDetail("angelegenheit",
	    "Kuemmer Dich um Deine eigenen!");
  
  AddDetail("steppe",
	    "Hier ist der Anteil der Steppe schon geringer als im Sueden.");
  
  AddDetail("koenigsblau",
	    "*grins* That's Arth's favorite.");
  
  AddSmell(DEFAULT_SMELL,
	   "Hier riecht es irgendwie komisch, um nicht zu sagen es stinkt fast " 
	   "schon.");
  
  AddSmell("gestank",
	   "WUUAAH!!! Du bist scheinbar direkt an der Quelle des Uebels.");
  
  AddSmell("quelle",
	   "Du kannst sie zwar nicht sehen, aber riechen umso klarer (leider!).");
  
  AddSound(DEFAULT_SOUND,
	   "Tatsaechlich da war doch glatt ein Geraeusch.");
  
  AddSound("geraeusch",
	   "Scheinbar kommt es von den Bueschen, die hier wachsen.");
  
  AddSound(({"busch", "buesche"}),
	   "Hm...jetzt ist es wieder ruhig...\n"
	   "Aber vielleicht findest du etwas, wenn du die Buesche genauer "
	   "untersuchst? ");
  
  AddCmd(({"durchsuche","durchsuch"}), "durchsuchen");
  
  
  AddExit("nordosten", PATH "raum04");
  AddExit("nordostoben", PATH "raum04");
  AddExit("sueden", PATH "raum02");
  
  SetProp(P_HIDE_EXITS, ({"nordosten"}));
  
}

string found_oryx()
{
  object ob;
  
  if(present("oryx"))
    return "Hm...scheinbar ist da doch nichts, oder bloss nicht mehr?\n";
  
  if(present("deadoryx"))
    return "Da hier noch die Leiche einer Oryx liegt, traut sich keine weitere aus "
      "ihrem Versteck.\n";
    
  if(deep_present("hinterlauf", TP))
    return "Du hast doch schon einen Hinterlauf! Also wozu noch einen?\n";

  if(cloned) return "";
  
  call_out("getoryx",1);

  cloned=1;

  return "Als Du die Angelegenheit genauer untersuchst, entdeckst Du ein " 
    "Tier, das zuvor im Verborgenen nach Nahrung suchte.\n";
}

nosave durchsuchen(string str)
{
  notify_fail("Was willst Du denn durchsuchen?\n");
  if(!str) return 0;

  if(str=="busch"||str=="buesche")
    return write(BS(found_oryx())),1;
  return 0;
}

getoryx()
{
  clone_object(NPC "oryx") -> move(this_object(), M_NOCHECK | M_NO_ATTACK);
  cloned=0;
}

p_death()
{
  TP->die();
}


julia_laura()
{
  if((find_call_out("phase_2")==-1) ||(find_call_out("phase_3") == -1) ||(find_call_out("phase_4") == -1))
    {	
      call_out("phase_2", 4);
      return("Du beginnst Deine Erinnerungen zu durchforsten...\n");
    }
}

phase_2()
{
  if(present(TP, this_object()))
    {
      if(TP->QueryProp(P_GENDER) == MALE)
	write("Du denkst . o 0(das Wochenende mit Julia) \n");

      if(TP->QueryProp(P_GENDER) == FEMALE)
	write("Du denkst . o 0(das Wochenende mit Marco) \n");

      call_out("phase_3", 4);
    }
}

phase_3()
{
  if(present(TP, this_object()))
    {
      if(TP->QueryProp(P_GENDER) == MALE)
	write("Du denkst . o 0(montags wars Laura) \n");

      if(TP->QueryProp(P_GENDER) == FEMALE)
	write("Du denkst . o 0(montags wars Stephan) \n");

      call_out("phase_4", 4);
    }
}

phase_4()
{
  if(present(TP, this_object()))
    write(BS("Aaaaaah genau, da war doch so ein See, aehm..." 
	     "nicht ganz, er war schon vertrocknet -Ha, ich wusste, dass ich mich " 
	     "daran erinnere!"));
}
