  AddDetail("sicht",
	    "Lichtfahrer sind sichtbarer.");
  
  AddDetail("lichtfahrer",
	    "Nicht hier! \n");
  
  AddDetail(({"mensch", "menschen"}),
	    "Mensch sein ist nicht schwer, menschlich sein dagegen sehr.");
  
