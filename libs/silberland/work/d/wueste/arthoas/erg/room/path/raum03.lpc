  AddSpecialDetail(({"etwas", "jemand"}), "found_oryx");
  
  AddDetail(({"baum", "baeume"}),
	    "Dein Kennerblick verraet Dir sofort, dass das bloss ein Baobab sein kann.");
  
  AddDetail(({"baobab", "merkmale"}),
	    "Ganz klar erkenntlich sind die klassischen Merkmale, ein kurzer dicker " 
	    "Stamm, eine merkwuerdige schwach ausgebildete Krone und er traegt fast " 
	    "keine Blaetter.");
  
  AddDetail("stamm",
	    "Er misst zwar fast 8m im Durchmesser, allerdings ist der Baum trotzdem " 
	    "nur ungefaehr 12m hoch. Nach einiger Zeit stellst Du fest, dass der Stamm " 
