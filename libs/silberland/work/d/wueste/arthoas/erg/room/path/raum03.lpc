  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 26, ENV_TERRAIN:TT_ROAD]));
  SetProp(P_KILL_NAME, "Lars");
  SetProp(P_KILL_MSG, "Dein Aufnahmegesuch wurde einstimmig angenommen.");
  
  STANDARD1
  STDSKY1
  
  AddDetail("raum",
