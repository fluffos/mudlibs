/*
  Ar-Thoas
  desert
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "ravine.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Schlucht");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich nun in der Schlucht, links und rechts von " 
	     "Dir ragen die Felswaende steil nach oben. Am Boden liegen " 
	     "zahlreiche Felsbrocken. Die Hoehe der Berge beeindruckt " 
	     "Dich sehr, und loest in Dir ein beklemmendes Gefuehl aus. " 
	     "Nach Norden kannst Du diesen Ort verlassen, und nach Sueden " 
	     "tiefer in kommende Abenteuer eindringen."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 34, ENV_TERRAIN:TT_MOUNTAIN]));
  
  STANDARD2
  STDSKY2
  
  AddDetail(({"wolke"}),
	    "Du hast Glueck, just in diesem Augenblick zieht eine Wolke " 
	    "vorueber.");
  AddDetail(({"boden"}),
	    "Nichts als Felsen und Steine.");
  AddDetail(({"felsen", "steine", "dinger"}),
	    "Felsen sind grosse Steine, und Steine sind kleine Felsen." 
	    "Nein im Ernst, interessieren Dich die Dinger wirklich? " 
	    "Wenn ja geh in eine Buchhandlung und besorg Dir ein " 
	    "diesbezuegliches Fachbuch.");
  AddDetail(({"buchhandlung"}),
	    "Vielleicht findest Du ja eine, wenn Du genau suchst...=:) ");
  AddDetail(({"fachbuch", "buch"}),
	    "So was aber auch! Liegt hier keines mehr 'rum? Na dann muss " 
	    "es wohl schon jemand vor Dir genommen haben (Du koenntest ja " 
	    "auf einen Raumreset warten =:))) ");
  AddDetail(({"felswaende", "waende"}),
	    "Leider viel zu steil, um daran hoch zu klettern.");
  AddSmell(DEFAULT_SMELL,
	   "Es riecht ein wenig verfault.");
  AddSmell(({"faeulnis"}),
	   "Scheint aus dem Sueden zu kommen.");
  AddDetail(({"hoehe"}),
	    "Immens hoch! Staendest Du am Gipfel koenntest Du Gott bestimmt " 
	    "die Hand schuetteln.");
  AddDetail(({"abenteuer"}),
	    "Husch husch in die Gilde, dort haengt eine Liste der bekannten " 
	    "Abenteuer.");
  AddDetail(({"liste"}),
	    "-> GILDE!!! ");
  AddDetail(({"gipfel"}),
	    "Hoch droben siehst Du das Ende des Berges, genannt Gipfel.");
  AddDetail(({"ende"}),
	    "Ob das jetzt eine gute Idee ist? ");
  AddDetail(({"idee"}),
	    "Na, lass Dir was einfallen.");
  AddDetail(({"gott"}),
	    "Gott ist immer und ueberall.");
  AddDetail(({"gilde"}),
	    "Also sowas findest Du hier bestimmt nicht, oder doch? ");
  AddDetail(({"felsbrocken", "brocken"}),
	    "Eindeutig zuviele. Sie erschweren Dein Vorankommen doch immens.");
  AddDetail(({"vorankommen"}),
	    "Na los, streng Dich ein wenig an.");
  AddDetail(({"hand"}),
	    "Need a helping hand? *evilgrin* ");
  AddDetail(({"horizont"}),
	    "Wenn Du Dich beeilst, erreichst Du ihn noch vor dem Morgengrauen.");
  AddDetail(({"morgengrauen"}),
	    "Jo, hab' ich ne Zeit lang gespielt, dann aber mein Passwort vergessen...");
  AddDetail(({"passwort"}),
	    "Weisst Du es vielleicht? ");
  AddDetail(({"ort"}),
	    "Hier fuehlst Du Dich einsam und verlassen. Kein Wunder hier ist weit und " 
	    "breit nichts zu sehen.");
  AddDetail(({"wunder"}),
	    "Glaube mir, es ist wirklich kein Wunder, dass hier nichts zu sehen ist.");
  AddDetail(({"punkt"}),
	    "Sowas siehst Du hier leider noch immer nicht.");
  AddDetail(({"raumreset", "reset"}),
	    "Kannst ja drauf warten, wennst lustig bist ");
  AddDetail(({"gefuehl", "gefuehle"}),
	    "Gehe in Dich, erforsche Deine Gefuehle...");
  AddDetail(({"seite"}),
	    "Seite, Seite, Seite, hast Du keine anderen Interessen? ");
  AddDetail(({"interessen"}),
	    "Woher soll ich wissen, was Dich interessiert? ");
  
  AddExit("norden", PATH "raum08");
  AddExit("sueden", RAVINE "raum09a");
}
