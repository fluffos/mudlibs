inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../desert.h"
#include "aragh.h"

nosave string *used;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Oase");
  SetProp(P_INT_LONG, 
	  BS("Du stehst nun im Zentrum des Dorfes. In der Mitte der Oase "
	     "befindet sich ein kleiner Brunnen. Ein mittelgrosses Haus "
	     "siehst Du im Osten, ein weiteres im Nordosten, und ein grosses "
	     "Haus im Suedosten, von hier aus kannst Du aber bloss das Haus "
	     "im Osten betreten."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_DESERT]) );
  
  STANDARD6
  Ground_Oasis
  House
  Berber
  SKY6
	
  AddDetail(({"brunnen"}),
	    "Er sorgt dafuer, dass die Bewohner, Pflanzen und Tiere dieser "
	    "kleinen Oase nicht verdursten.");
  AddDetail(({"bewohner"}),
	    "Naja, jedem das seine, aber Du moechtest hier bestimmt nicht "
	    "wohnen, oder?");
  AddDetail(({"pflanzen"}),
	    "Dattelpalmen fallen Dir auf, ansonsten scheint hier nichts "
	    "besonderes zu gedeihen.");
  AddDetail(({"tiere", "tier"}),
	    "Hehe, auf der Suche nach Schnetzelbarem?");
  AddDetail(({"wasser"}),
	    "Vielleicht solltest Du mal davon probieren?");
  AddDetail(({"suche"}),
	    "Na dann such mal schoen =;>\n");
  AddDetail(({"osten"}),
	    "Scheint eine Kneipe zu sein.\n");
  AddDetail(({"kneipe"}),
	    "Vielleicht solltest Du sie mal betreten?\n");
  AddDetail(({"hals"}),
	    "Du tastest sorgfaeltig Deinen Hals ab, und kommst zu dem Schluss, "
	    "dass alles dort ist wo es hingehoert.\n");
  AddDetail(({"schluss"}),
	    "Willst jetzt schon aufgeben?\n");
  AddDetail(({"klinge", "kreuz"}),
	    "Die Klingen ihrer Schwerter waren gerade, dadurch aehnelten diese "
	    "einem Kreuz, dem wohl typischsten christlichen Symbol schlechthin.\n");
  AddDetail(({"symbol"}),
	    "Das Symbol der Christen ist das Kreuz.");
  AddDetail(({"christ", "christen"}),
	    "Bist Du einer?\n");
  AddDetail(({"einwohner", "einheimische"}),
	    "Keiner da. Wer versteht schon die Berber.");
  AddDetail(({"oase", "zentrum"}),
	    "Da bist Du gerade.\n");
  
  AddCmd(({"trinke", "trink"}), "drink_well");
  
  AddItem(NPC "wasserwaechter", REFRESH_DESTRUCT);
  
  AddExit("norden", ARAGH "raum42");
  AddExit("osten",  ARAGH "pub");
  AddExit("sueden", ARAGH "raum44");
  AddExit("westen", ARAGH "raum38");
  
  used=({});
}

reset()
{
  ::reset();
  
  used=({});
}

nosave drink_well(string str)
{
  object tp,ob;

  notify_fail("Was oder wovon willst Du denn trinken?\n");
  if(!str) return 0;
  
  if(str=="wasser aus brunnen"||str=="wasser"||str=="aus brunnen")
    {
      if(!tp=TP) return 0;
      
      if(ob=present("waechter"))
	return write(ob->Name()+" stoesst Dich brutal weg!\n"),1;

      write(BS("Du beugst Dich nach vor und trinkst einen grossen Schluck "
	       "aus dem Brunnen. Danach fuehlst Du Dich total erfrischt.\n"));
      say(tp->Name()+" trinkt aus dem Brunnen.\n", ({tp}));
      if(member(used, getuid(tp))>-1)
	{
	  tp->heal_self(90+random(10));
	  if(random(2)) used+=({getuid(tp)});
	}
      return 1;
    }
  return 0;
}
