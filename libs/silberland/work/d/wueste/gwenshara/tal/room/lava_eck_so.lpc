#include "../def.h"

inherit STD "std_lavasee";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"\b"+
    "Du befindest Dich hier im suedwestlichen Eck des Lavabeckens.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "eck", "ecke" }),
    "Du schwitzt hier in einem Eck des Lavabeckens.");

  AddDetail( ({ "lavabecken", "becken" }),
    "Hier fliesst die Lava in einem Becken zusammen.");

//--Kommandos--------------------------------------------------------------

//  AddCmd( CMD_KLETTERN, "cmd_exit" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "lava_rand_s");
  AddExit( "norden", ROOM "lava_rand_o");
  AddExit( "nordwesten", ROOM "lava_mitte");

//--Items & NPCs-----------------------------------------------------------

  AddItem( ({NPC "salamander",
	     NPC "feuerdruide",
	     NPC "teufel",
	     NPC "funken",}) , REFRESH_DESTRUCT);
}
