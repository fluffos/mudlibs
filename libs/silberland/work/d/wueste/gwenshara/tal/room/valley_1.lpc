#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Wuestental");
  SetProp(P_INT_LONG,
    "Durch den Erg fuehrt ein Weg auf das Tibesti-Gebirge zu. Um Dich herum "
    "hat sich die Sandwueste in eine Steinwueste gewandlet, die in Richtung "
    "Osten, zum Gebirge hin, von immer groesseren Steinen beherrscht wird. "
    "Hin und wieder huscht ein Tierchen zwischen den Steinen vorbei und eine "
    "Eidechse waermt sich auf einem Stein in der Sonne.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "erg", "tal", "wuestental" }),
    "Das Wuestental, durch das du gerade wanderst, wird von den Einheimischen "
    "Erg genannt.");

  AddDetail( ({ "weg" }),
    "Der Weg, dem Du folgst, ist kaum als solcher zu bezeichnen. Genaugenommen "
    "sind es nur Tierspuren.");

  AddDetail( ({ "tibesti", "tibesti-gebirge", "gebirge" }),
    "Das maechtige Tibesti-Gebirge reckt sich im Osten dem Himmel entgegen. Ueber "
    "seinen hoechsten Gipfeln glaubst Du Voegel zu erspaehen.");

  AddDetail( ({ "sandwueste", "steinwueste", "wueste", "feld" }),
    "Die flache Sandwueste hat sich hier in ein von Steinen, Felsen und Schotter "
    "bedecktes Feld verwandelt.");

  AddDetail( ({ "richtung" }),
    "Nach Osten hin wird die Wueste von immer groesseren Steinen beherrscht, bis sie "
    "schliesslich ans Gebirge grenzt.");

  AddDetail( ({ "steine", "steinen", "felsen", "schotter" }),
    "Der Boden ist von allerlei Steinen bedeckt. In Richtung Gebirge werden die Steine "
    "groesser und teilweise zu richtigen Felsen.");
  
  AddDetail( ({ "tiere", "tierchen" }),
    "Zwischen den Steinen huschen hin und wieder einige Tiere hin und her. Du erkennst, "
    "dass es grossteils Eidechsen und Spinnen sind.");

  AddDetail( ({ "eidechse" }),
    "Auf einem etwas groesseren Stein neben Dir hat sich eine Eidechse in die Sonne gelegt.");

  AddDetail( ({ "stein" }),
    "Der Stein, auf dem sich die Eidechse breit gemacht hat, scheint wackelig zu liegen. "
    "Ob die Eidechse runterfaellt, wenn man den Stein anstubst?");

  AddDetail( ({ "sonne" }),
    "Unbarmherzig strahlt die Sonne auf Dich herab.");

  AddDetail( ({ "einheimische", "einheimischen", "einheimischer" }),
    "Weit und breit kein Einheimischer zu sehen. Vielleicht wissen sie, das es besser ist "
    "nicht lange in der Wueste zu stehen.");

  AddDetail( ({ "tierspuren", "spuren", "spur", "tierspur" }),
    "Im Sand des Bodens hast Du eine Tierspur entdeckt, der man ohne weitere Probleme "
    "folgen kann.");

  AddDetail( ({ "himmel" }),
    "Wie das Auge eines wuetenden Zyklopen steht die Sonne am Himmel. In der Ferne "
    "glaubst Du ueber den hoechsten Gipfeln des Tibesti-Gebirges Voegel zu sehen.");

  AddDetail( ({ "gipfel", "gipfeln" }),
    "Ueber den hoechsten Gipfeln des Tibesti-Gebirges glaubst Du Voegel erkennen zu "
    "koennen.");

  AddDetail( ({ "voegel" }),
    "Die Voegel, die da ueber den hoechsten Gipfeln ihre Kreise ziehen muessen "
    "riesig sein, wenn Du sie bis hierher erkennst.");

  AddDetail( ({ "eidechsen", "spinnen" }),
    "Zwischen den Steinen huschen ab und an ein paar Eidechsen und Spinnen herum. "
    "Eine Eidechse hat sich auf einem Stein neben Dir breit gemacht.");

  AddDetail( ({ "probleme", "problem" }),
    "Dein einziges Problem hier ist diese Hitze.");

  AddDetail( ({ "boden" }),
    "Der Boden ist von Sand und Steinen bedeckt. Eine Tierspur fuehrt hier ins "
    "Gebirge.");

  AddDetail( ({ "sand" }),
    "Hier in der Wueste findest Du sehr, sehr viel Sand.");

  AddDetail( ({ "kreise", "kreisbahnen" }),
    "Die Voegel ueber den Gipfeln des Gebirges fliegen kreisfoermige Kreisbahnen.");

  AddDetail( ({ "auge" }),
    "Wie das flammende Auge eines Zyklopen brennt die Sonne vom Himmel.");

  AddDetail( ({ "zyklopen", "zyklop", "riese", "riesen" }),
    "Die Sonne gleicht dem Auge eines solchen einaeugigen Riesen.");

  AddDetail( ({ "hitze" }),
    "Die Hitze hier bist du einfach nicht gewohnt.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind durch das Tal brausen.");

  AddSound( ({ "wind" }),
    "Der Wind braust mit einem heulen durch das Tal.");

  AddSmell( DEFAULT_SMELL,
    "Du atmest die Luft der Wueste ein, doch es ist nichts Besonderes darin.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "stubs", "stubse", "stups", "stupse" }), "cmd_stein" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "/d/wueste/arthoas/erg/room/valley/raum34" );
  AddExit( "osten", ROOM "valley_2");
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_stein(string str)
{
  notify_fail("Was willst Du anstubsen?\n");

  if (!str || str == "") return 0;
  if (!(str == "stein" ||
	str == "stein an" )) return 0;

  write(BS("Du stubst den Stein an, auf dem die Eidechse sitzt. "
	   "Sie faellt runter, klettert aber sofort wieder rauf."));
  say(BS(TPN+" stubst einen Stein, auf dem eine Eidechse sitzt an. "
         "Sie faellt runter, klettert aber sofort wieder darauf."));
  return 1;
}
