#include "../def.h"

inherit STD "std_road";

int ast, demon;

void create()
{
  ::create();
  ast=3;
  demon=1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Ufer des Lavaflusses");
  SetProp(P_INT_LONG,
    "Du stehst hier am Ufer des brennenden Lavaflusses. Vor Dir waelzt "
    "sich der traege Strom dahin. Der Boden unter Dir ist aus robustem "
    "Vulkangestein. Ein verdorrter Baum steht nahe dem Lavafluss und "
    "glueht langsam vor sich hin. Unter ihm findet sich ein Haufen erkal"
    "teter Asche.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage(
    ({""}),30,"func");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "brich", "brech", "breche" }), "cmd_brechen" );
  AddCmd( ({ "stocher", "stochere" }), "cmd_stochern");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "rauf", ROOM "road_2" );
}

int cmd_brechen(string str)
{
  object ob;
  notify_fail("Was willst Du wovon abbrechen?\n");
  if(!str || str=="") return 0;
  if(!(str == "ast von baum" ||
       str == "ast vom baum ab" ||
       str == "ast vom baum" ||
       str == "ast von baum ab")) return 0;

  if(ast)
  {
    write(BS("Du brichst einen Ast vom Baum ab."));
    say(BS(TPN+" bricht einen Ast vom Baum ab."));
    ob = clone_object(OBJ "ast");
    if(ob->move(TP, M_GET) != 1)
    {
      ob->move(TO, M_PUT);
    }
    ast--;
  }
  else
  {
    write(BS("Du brichst einen Ast ab, der jedoch zerbroeselt."));
  }

  return 1;
}

int cmd_stochern(string str)
{
  notify_fail("Worin willst Du stochern?\n");
  if(!str || str == "") return 0;
  if(!(str == "in haufen" ||
       str == "in asche" ||
       str == "in aschehaufen")) return 0;

  if(demon)
  {
    write(BS("Du stocherst in der Asche..."));
    say(BS(TPN+" stochert in der Asche..."));
    TP->SetProp(P_PARALYZED,
		([PARALYZE_TIME:100,
		  PARALYZE_MSG:"Irgendwas hat sich gerade in der Asche bewegt...\n",
                  PARALYZE_MSG_OTHER:"",
		  PARALYZE_END:"",
                  PARALYZE_END_OTHER:""]));
    call_out("demon_seq", 2, 0);
    demon--;
  }
  else
  {
    write(BS("Du stocherst in der Asche."));
    say(BS("Du stocherst in der Asche."));
  }

  return 1;
}

void demon_seq(int ab)
{
  write("Demon-Sequence\n");
}

void reset()
{
  ::reset();
  ast=3;
  demon=1;
}
