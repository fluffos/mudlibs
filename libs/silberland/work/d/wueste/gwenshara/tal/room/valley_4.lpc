#include "../def.h"

inherit "std/room";

string koerper()
{
  string str;
  str+="Das bist Du:\n";
  str+=TP->long();
  return str;
}

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Tibesti-Gebirge");
  SetProp(P_INT_LONG,
    "Der Pfad steigt hier nach Norosten an. Im Grunde genommen zeiegen "
    "Dir nur die beiden Felswaende, dass Du noch am richtigen Weg bist. "
    "Der Schwefelanteil in der Luft hat deutlich zu genommen und die Hitze "
    "steigt in Richtung Nordosten weiter an. Ein heisser Wind weht Dir aus "
    "dem Nordosten entgegen und bringt Dich ganz schoen ins Schwitzen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "pfad", "nordosten", "weg" }),
    "Der Pfad, dem Du bis hierher gefolgt bist, steigt in Richtung Nordosten "
    "steil an.");

  AddDetail( ({ "grunde", "sinn" }),
    "Im Grunde genommen ergibt dieses Detail gar keinen Sinn.");

  AddDetail( ({ "waende", "felswaende", "felsen", "wand", "felswand" }),
    "Die massiven Felswaende links und rechts des Pfades zeigen Dir, dass "
    "Du Dich nicht verlaufen hast. An einer der Waende erkennst Du seltsame "
    "Einkerbungen.");

  AddDetail( ({ "anteil", "schwefel", "schwefelanteil" }),
    "Die Atemluft hier ist mit einem ziemlich grossen Anteil an Schwefel "
    "versetzt. Du bist zwar kein Arzt, aber auf Dauer kann das wohl nicht "
    "gesund sein.");

  AddDetail( ({ "luft", "atemluft" }),
    "Die Luft, die Du hier so grosszuegig einatmest hat einen ziemlich "
    "grossen Anteil an Schwefel in sich.");

  AddDetail( ({ "schwitzen" }),
    "Dein Koerper reagiert auf Die Hitze hier, indem er Dich mit Schweiss "
    "abzukuehlen versucht.");

  AddDetail( ({ "detail", "details", "dinger" }),
    "Details sind die Dinger, die Du hier gerade untersuchst.");

  AddDetail( ({ "wind" }),
    "Aus dem Nordosten blaest ein heisser Wind, der Dich mehr und mehr "
    "austrocknet.");

  AddDetail( ({ "einkerbungen", "kerben" }),
    "An einer der Felswaende hast Du seltsame Einkerbungen entdeckt. Es "
    "sieht so aus, als wuerden sie von Kletterwerkzeug herruehren.");

  AddDetail( ({ "arzt", "leute" }),
    "Aerzte sind Leute, die andere Leute wieder zusammenflicken.");

  AddDetail( ({ "hitze" }),
    "Du schwitzt.");

  AddDetail( ({ "schweiss" }),
    "Schweiss ist so eine salzhaltige Fluessigkeit, die aus deinem Koerper "
    "kommt, wenn Dir heiss ist.");

  AddDetail( ({ "koerper" }), #'koerper);
 
  AddDetail( ({ "wekzeug", "kletterwerkzeug", "ausruestung", 
                "kletterausruestung" }),
    "Zu einer guten Kletterausruestung gehoeren ein Seil, ein Kletterhaken, "
    "Steigeisen une ein Kletterhelm. Wenn Du eine gute Kletterausruestung "
    "hast kannst du vielleicht auf die Felswand klettern.");

  AddDetail( ({ "fluessigkeit", "fluessiges" }),
    "Ja, 'was Fluessiges waer jetzt echt toll.");

  AddDetail( ({ "seil", "haken", "kletterhaken", "eisen", "steigeisen",
                "helm", "kletterhelm" }),
    "Das gehoert zu einer guten Kletterausruestung.");

  AddDetail( ({"boden"}),
    "Der Boden ist sehr sandig.");

  AddDetail( ({"himmel"}),
    "Der Himmel ist absolut wolkenlos.");

  AddSound( DEFAULT_SOUND,
    "Der Wind heult um Dich herum.");

  AddSound( ({ "wind", "heulen" }),
    "HUUUUUUUUUUUUUUUUUUUU-UUUUUUUUUUUUUUUU");

  AddSmell( DEFAULT_SMELL,
    "Schwefel liegt in der Luft");

  AddSmell( ({ "schwefel" }),
    "Baeh! Das riecht ja ekelhaft.");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_KLETTERN, "cmd_klettern" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordosten", "./valley_5" );
  AddExit( "sueden", "./valley_3");
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_klettern(string str)
{
  int meter;
  notify_fail("Wohin willst Du klettern?\n");

  if (!str || str == "") return 0;
  if (!(str == "auf wand" ||
        str == "auf felswand")) 
    return 0;

  tell_object(TP, "Du kletterst auf die Felswand.\n");
  Message(TP->Name(WER, 1)+" beginnt auf die Felswand zu klettern.\n", 
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  if(!present("steigeisen", TP) ||
     !present("kletterhelm", TP) ||
     !present("seil", TP) ||
     !present("kletterhaken", TP))
  {
    meter=1+random(20);
    tell_object(TP, BS("Du verlierst den Halt und faellst "+meter+" Meter "
                "in die Tiefe."));
    Message(TP->Name(WER, 1)+BS(" faellt etwa "+meter+" Meter in die Tiefe."),
            MSGFLAG_NO_TP);
    SetProp(P_KILL_NAME, "Der Fall von einer Felswand");
    TP->do_damage(meter*5);
    SetProp(P_KILL_NAME, 0);
    return -1;
  }

  tell_object(TP, BS("Du erklimmst den Woodykopf."));
  Message(TP->Name(WER, 1)+BS(" erklimmt den Gipfel."), MSGFLAG_NO_TP);
  TP->move(ROOM "gipfel", M_NO_SHOW|M_GO);
  return 1;
}
