#include "../def.h"

inherit STD "std_road";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Der aschebedeckte Weg fuehrt Dich hier an eine Kreuzung. Im Norden "
    "liegt ein Lavabecken, das Du umgehen kannst. Im Osten fuehrt der Weg "
    "einen Berg hinauf, der durch den roten Dunst schwarz erscheint. Am "
    "noerdlichen Ende des Tals erkennst Du die Umrisse eines gewaltigen "
    "Vulkans. Asche brennt Dir in den Augen und die trockene Luft laesst "
    "Deine Lippen aufspringen.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "weg" }),
    "Dieser Weg zieht sich durch das gesamte Tal. Er ist eigentlich mehr "
    "eine Spur aus Asche, die nicht von der Lava weggebrannt wurde.");

  AddDetail( ({ "kreuzung", "wege" }),
    "Der Weg spaltet sich hier in drei weitere Wege auf. Zwei von ihnen "
    "fuehren westlich und oestlich um das Lavabecken herum. Einer fuehrt "
    "Dich im Osten zum einem Berg.");

  AddDetail( ({ "becken", "lavabecken", "norden", "steinbecken" }),
    "Noerdlich von Dir sammelt sich Lava, die aus dem Vulkan rinnt, in "
    "einem gewaltigen, steinernen Becken. Sie blubbert darin traege vor "
    "sich hin. Man koennte von hier aus hinunter steigen, doch ohne "
    "den richtigen Schutz endet es garantiert toedlich.");

  AddDetail( ({ "osten" }),
    "Im Osten fuehrt ein zunehmende steiniger werdender Weg den Berg hinauf. "
    "Vielleicht kommt es Dir nur so vor, aber es scheint so als wuerde aus "
    "dem Osten ein kuehlerer Wind kommen.");

  AddDetail( ({ "berg" }),
    "Im Osten ragt ein Berg auf, durch den roetlichen Dunst im Tal erscheint "
    "er Dir schwarz. Irgendwie wirkt er mit seiner schwarzen Kuehle in mitten "
    "dieses Infernos fehlplaziert.");

  AddDetail( ({ "ende", "umrisse" }),
    "Am noerdlichen Ende des Tals thront wie ein Koenig ein riesiger Vulkan. "
    "Einem Wal gleich speit er Feuer und Asche. Er erfuellt das ganze Tal mit "
    "einem ungeheuer lauten Tosen und Bruellen.");

  AddDetail( ({ "vulkan" }),
    "Der Vulkan am Ende des Tals ist einfach nur riesig. Noch nie hast Du "
    "so einen wunderbaren Vulkan gesehen. Wie ein riesiger Wal speit er "
    "Feuer, Asche und Stein in den Himmel. Du glaubst sogar so etwas wie "
    "einen Eingang in ihn zu erkennen.");

  AddDetail( ({ "asche", "flocken", "ascheflocken" }),
    "Ascheflocken fliegen durch die Luft und reizen Deine Lungen. Sie verfangen "
    "sich in Deinen Haaren und mit jedem Atemzug atmest Du ein paar von ihnen ein.");

  AddDetail( ({ "augen" }),
    "Ein paar Traenen rinnen aus Deinen Augen." );

  AddDetail( ({ "luft" }),
    "Die trockene, heisse Luft treibt alles Wasser aus Deinem Koerper." );

  AddDetail( ({ "lippen" }),
    "Blut tropft von Deinen aufgesprungenen Lippen. Die Hitze hier hat Dich ganz "
    "ausgedoerrt." );

  AddDetail( ({ "spur", "aschespur" }),
    "Der Weg, auf dem Du hier stehst, ist nichts weiter als eine breite Aschespur, "
    "die durch eine Laune der Natur nicht verglueht ist." );
 
  AddDetail( ({ "lava", "stein", "gestein" }),
    "Noerdlich von hier sammelt sich Lava in einem grossen Steinbecken." );

  AddDetail( ({ "schutz" }),
    "Welch ein Schutz das sein koennte weisst Du nicht." );

  AddDetail( ({ "wind" }),
    "Du bist Dir sicher, dass es im Osten kuehler ist. Warum das so ist, weisst Du "
    "jedoch nicht. Vielleicht laesst es sich im Osten herausfinden?" );

  AddDetail( ({ "kuehle" }),
    "Es scheint Dir so, als wuerde Dich schon der Anblick des Berges abkuehlen." );

  AddDetail( ({ "inferno", "flammeninferno" }),
    "Dieses Tal ist das reinste Flammeninferno." );

  AddDetail( ({ "koenig" }),
    "Der Vulkan am noerdlichen Ende des Tals erscheint Dir wie ein gewaltiger "
    "Koenig, der ueber dieses Tal herrscht." );

  AddDetail( ({ "wal", "vergleich" }),
    "Wie ein Wal blaest der Vulkan Feuer und Asche in den Himmel - daher kommt auch "
    "der Vergleich." );

  AddDetail( ({ "tosen", "bruellen" }),
    "Sehen kannst Du das nicht, hoeren dagegen schon." );

  AddDetail( ({ "eingang", "hoehleneingang", "oeffnung" }),
    "Du glaubst einen Hoehleneingang im Vulkan zu erkennen. Wigentlich ist es nur "
    "eine unpassende Oeffnung im Gestein. Leider bist Du zu weit entfernt um genaueres "
    "zu erkennen." );

  AddDetail( ({ "wasser" }),
    "Weit und breit findest Du kein Wasser." );

  AddDetail( ({ "koerper" }),
    "Dein Koerper ist schon ganz ausgetrocknet." );

  AddDetail( ({ "lunge" }),
    "Du atmest mittlerweile schon mehr Asche als Luft ein." );

  AddDetail( ({ "atemzug", "atem", "atmen", "zug", "qual" }),
    "Jeder Atemzug hier wird durch die Asche zur Qual" );

  AddDetail( ({ "haar" }),
    "Deine Haare sind schon ganz grau." );

  AddDetail( ({ "traenen", "wangen" }),
    "Aschige Traenen rinnen Deine geroeteten Wangen hinab." );

  AddDetail( ({ "laune", "natur" }),
    "Es muss wohl eine Laune der Natur sein, dass einiges nicht weggebrannt wurde." );

  AddSound( ({ "tosen", "bruellen", "laerm" }),
    "Ein gewaltiger Laerm erfuellt das Tal.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", ROOM "road_2" );
  AddExit( "osten",  ROOM "road_4");
  AddExit( "nordosten", ROOM "road_5");
  AddExit( "nordwesten", ROOM "road_6");
}
