#include "../def.h"

inherit STD "std_road";

string ruestung();
string augen();
string haar();

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier beginnt ein Weg durch das Tal der Flammen. Er fuehrt Dich im Norden "
    "zu einem See aus gluehender Lava. Im Nordosten erkennst Du schemenhaft "
    "die Umrisse eines schwarzen Berges. Gegen Westen hin trennt Dich "
    "fluessiges Gestein von einem Wald aus brennden Baeumen. Asche weht "
    "um Dich, getragen von einem heissen Wind aus dem Norden.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "weg" }),
    "Ein Weg durch das sagenhafte Tal der Flammen beginnt hier. Was Dich "
    "wohl erwarten mag?");

  AddDetail( ({ "norden", "see", "lavasee" }),
    "Im Norden erkennst Du einen See aus geschmolzenem Gestein. Er wirft "
    "grosse Blasen, die nach wenigen Sekunden zerplatzen und Lava verspritzen.");

  AddDetail( ({ "nordosten", "umrisse" }),
    "Im Nordosten erkennst Du durch den Dunst die Umrisse eines Berges.");

  AddDetail( ({ "berg" }),
    "Wie ein Riese thront der Berg im Nordosten. Seine dunkle Farbe verursacht "
    "Unbehagen in Dir. Irgendwie scheint es so, als wolle der Berg dem Feuer "
    "trotzen.");

  AddDetail( ({ "westen" }),
    "Im Westen blickst Du ueber einen breiten Fluss aus fluessigem Gestein. "
    "Er trennt Dich von einem Wald dessen Baeume lichterloh brennen und doch "
    "nicht verbrennen.");

  AddDetail( ({ "gestein", "lava", "steine" }),
    "Eine gewaltige Hitze ist noetig um diese ungeheuren Mengen an Gestein in "
    "Lava zu verwandeln. Jede Beruehrung mit dem geschmolzenen Gestein wuerde "
    "Dich in sekundenschnelle verbrennen und schrecklich schmerzhaft sein.");

  AddDetail( ({ "wald", "inferno" }),
    "Der Wald im Westen ist, von hier aus betrachtet, ein Inferno aus brennden "
    "Aesten und Dornen. Am beeindruckendsten ist, dass er nicht verglueht, "
    "obwohl jeder Baum in Flammen steht.");

  AddDetail( ({"baeume", "dornen", "aeste", "aesten", "ast", "baum"}),
    "Jeder Ast und jeder Baum in dem Wald dort drueben brennen lichterloh. "
    "Zusammen mit den Dornen, die in einem Wald unerlaesslich sind ist das "
    "sicher ein gemuetlicher Platz.");

  AddDetail( ({ "asche", "luft" }),
    "Die Asche in der Luft wirbelt um Dich. Sie dringt in jede Ritze Deiner "
    "Ruestung, verfaengt sich in deinem Haar und laesst Dich graesslich "
    "husten.");

  AddDetail( ({ "wind" }),
    "Ein heisser Wind weht aus dem Norden. Er traegt die ganze Asche zu Dir "
    "und treibt Dir Traenen in die Augen.");

  AddDetail( ({ "blasen", "blase" }),
    "Die Blasen an sich kannst Du nicht sehen. Doch aus dem Blubbern und den "
    "Lavaspritzern, die du siehst schliesst Du, dass welche da sein muessen.");

  AddDetail( ({ "sekunden" }),
    "Innerhalb weniger Sekunden zerplatzen die Blasen wieder. Seit der letzten "
    "Blase sind "+random(24)+2+" Sekunden vergangen.");

  AddDetail( ({ "riese" }),
    "Riesenhaft thront der schwarze Berg auf, so als koenne ihm all das Feuer "
    "nichts anhaben.");

  AddDetail( ({ "farbe" }),
    "Die Umrisse des Berges sind schwarz, tief schwarz!");

  AddDetail( ({ "unbehagen" }),
    "Du fuehlst Dich nicht wohl bei diesem Berg. Am liebsten wuerdest Du ihn "
    "gar nicht erst besuchen.");

  AddDetail( ({ "hitze" }),
    "Die gewaltige Hitze kommt vermutlich tief aus dem Inneren des Silberlandes.");

  AddDetail( ({ "beruehrung" }),
    "Jede Beruehrung mit der Lava wuerde Dich aufs schlimmste verbrennen.");

  AddDetail( ({ "feuer", "flammen" }),
    "Das Feuer ist hier allgegenwaertig. In diesem Tal wurde das Feuer geboren, "
    "sagt man. Der Himmel scheint nur aus Flammen zu bestehen und auch der Boden "
    "ist Asche. Wie hier etwas ueberleben kann wundert Dich.");

  AddDetail( ({ "platz", "spaziergang" }),
    "Der Wald ist sicher ein guter Platz fuer einen romantischen Spaziergang.");

  AddDetail( ({ "ritze" }),
    "Diese verdammte Asche dringt wirklich in jede Ritze! In absolut jede!");

  AddDetail( ({ "ruestung" }), #'ruestung);

  AddDetail( ({ "haar" }), #'haar);

  AddDetail( ({ "traenen", "augen" }), #'augen);

  AddDetail( ({ "spritzer", "lavaspritzer" }),
    "Im Norden siehst Du Spritzer aus heisser Lava spritzen.");

  AddDetail( ({ "inneren", "inneres", "tiefen", "silberland", "silberlandes" }),
    "Die Hitze um die Steine zu schmelzen kommt aus den Tiefen des Silberlandes." );

  AddDetail( ({ "fluss", "lavafluss" }),
    "Der Lavafluss, der im Westen traege an Dir vorbeirinnt strahlt eine "
    "gewaltige Hitze aus. Darin schwimmen waere fatal. Westlich, etwas "
    "nach unten versetzt, entdeckst Du eine Stelle am Ufer des Flusses, "
    "auf die Du gelangen koenntest." );

  AddDetail( ({ "stelle", "ufer" }),
    "An dieser Stelle wuerde Dich die Lava nicht erreichen. Du koenntest "
    "den Lavafluss genauer unter die Lupe nehmen. Um dort hin zu gelangen "
    "muesstest Du jedoch einen Sprung nach unten riskieren." );

  AddDetail( ({ "sprung" }),
    "Trau Dich!" );

  AddDetail( ({ "lupe" }),
    "Mit einer Lupe kannst Du alles ganz genau betrachten." );

  AddSound( "blubbern",
    "*Blubb* *Blubb* *Spritz*");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "spring", "springe", "hops", "hopse" }), "cmd_sprung" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "road_3" );
  AddExit( "suedwestoben", ROOM "road_1");
}

int cmd_sprung(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "nach unten" ||
       str == "runter" ||
       str == "auf stelle" ||
       str == "auf ufer")) return 0;

  TP->move(ROOM "ufer", M_TPORT|M_SILENT, "unten", "springt nach", 
           "springt vom herunter.");
  return 1;
}

string ruestung()
{
  object *r;
  int i;
  string str;
  r   = TP->QueryProp(P_ARMOURS);
  str = "Du traegst ";

  for(i=0; i<sizeof(r); ++i)
  {
    if(i!=sizeof(r)-1)
      str+=r[i]->name(WEN);
    else
      str+="und "+r[i]->name(WEN)+".";
  }
  if(!sizeof(r)) str="Du hast ja gar nichts an!.";
  return BS(str);
}

string haar()
{
  return BS("Deine "+TP->QueryProp(P_HAIR_COLOR)+"en Haare sind ganz "
            "graz von der Asche.");
}

string augen()
{
  return BS("Der Wind treibt Dir Traenen in Deine "+
            TP->QueryProp(P_EYE_COLOR)+"en Augen!");
}