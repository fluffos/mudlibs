#include "../def.h"

inherit "std/room";

string name()
{
  return "Du stehst hier am Woodykopf und heisst "+TPN;
}
int harp;

void create()
{
  ::create();
  harp=2;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Woodykopf");
  SetProp(P_INT_LONG,
    "Du stehst hier am Woodykopf. Der Woodykopf ist einer der Gipfel des "
    "Tibesti-Gebirges. Er hat seinen Namen durch sein aussehen bekommen. "
    "Der Gipfel sieht aus wieder Kopf von Woody. Du stehst hier sozusagen "
    "auf Woodys goettlicher Nase. Um den Woodykopf kreisen gefaehrliche "
    "Tibesti-Harpyien.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "woodykopf", "kopf", "gipfel" }),
    "Dies hier ist der Woodykopf. Einer der Tibesti-Gipfel");

  AddDetail( ({ "gebirge", "tibesti-gebirge" }),
    "Du stehst hier im Tibesti-Gebirge.");

  AddDetail( ({ "name", "namen" }), #'name);

  AddDetail( ({ "woody", "gott" }),
    "Woody ist ein Gott des Silberlandes.");

  AddDetail( ({ "nase" }),
    "Du stehst hier auf der Nase von Woody. Von hier aus hast Du einen "
    "guten Ausblick ueber das Tibesti-Gebirge.");

  AddDetail( ({ "harpyien", "tibesti-harpyien", "wesen" }),
    "Ueber dem Woodykopf erkennst Du Harpyien ihre Kreise ziehen. "
    "Angeblich sind diese Wesen aeusserst aggressiv und man sollte sie "
    "nicht reizen. Es heisst, einige Harpyien haben ihre Nester im "
    "Woodykopf.");

  AddDetail( ({ "boden" }),
    "Du stehst hier auf Woodys Nase. Nur ein paar Centimeter trennen Dich "
    "von einem Fall in die Tiefe.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber dem Woodykopf ist strahlend blau.");

  AddDetail( ({ "tibesti-gipfel", "loewenstein", "eisenhelm" }),
    "Das Tibesti-Gebirge hat viele Gipfel. Sie alle tragen klangvolle "
    "Namen wie: Loewenstein, Eisenhelm oder Woodykopf");

  AddDetail( ({ "silberland" }),
    "Alles was du hier siehst ist das Silberland.");

  AddDetail( ({ "kreise" }),
    "Die Harypien ziehen ueber dem Woodykopf ihre Kreise.");

  AddDetail( ({ "nester" }),
    "Du beobachtest die Harypien eine Weile und bemerkst, dass "
    "sie wohl im Ohr des Woodykopfes nisten.");

  AddDetail( ({ "centimeter", "schritt" }),
    "Wenn Du auch nur einen falschen Schritt machst faellst Du "
    "sehr lang und sehr tief.");

  AddDetail( ({ "tiefe", "fall" }),
    "Jupp, sehr tief.");

  AddDetail( ({ "ohr" }),
    "Aus dem Ohr von Woody fliegen ab und zu ein paar Harpyien "
    "hinaus. Vielleicht kann man eine von ihnen anlocken?");

  AddDetail( ({ "ausblick", "blick" }),
    "Du laesst Deinen Blick ueber das Gebirge schweifen und erkennst "
    "etwas weiter nordoestlich von hier einen rauchenden Berg.");

  AddDetail( ({ "berg" }),
    "Ob das vielleicht ein Vulkan ist?");

  AddDetail( ({ "vulkan", "lava" }),
    "Als der Berg beginnt Lva zu spucken bist Du Dir sehr sicher, dass "
    "es einer ist.");

  AddSound( ({DEFAULT_SOUND, "kreischen"}),
    "Das Kreischen der Harpyien uebertoent alles.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "locke", "lock" }), "cmd_locken" );
  AddCmd( ({"reize", "reiz"}), "cmd_reizen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "unten", "./valley_4" );
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_locken(string str)
{
  notify_fail("Was willst Du anlocken?\n");
  if(!str || str == "") return 0;
  if(!(str == "harpyie" ||
       str == "harpyie an" ||
       str == "harpyien" ||
       str == "harpyien an")) return 0;

  write(BS("Du versucht eine Harpyie an zu locken, aber irgendwie klappts "
        "nicht so ganz. Vielleicht solltest Du eine reizen?"));
  say(BS(TPN+" wachelt mit den Armen."));

  return 1;
}

int cmd_reizen(string str)
{
  object ob;
  notify_fail("Wen willst du reizen?\n");
  if(!str || str == "") return 0;
  if(!(str == "harpyie" ||
       str == "eine harpyie" ||
       str == "harpyien" ||
       str == "eine harpyien")) return 0;

  if(harp)
  {
    write(BS("Du beschimpfst die Harpyien aufs wildeste und schon kommt eine "
             "angeflogen... Sie sieht nur nicht gluecklich darueber aus!"));
    say(BS(TPN+" beschimpft die Harpyien."));

    ob=clone_object(NPC "harpyie");
    ob->move(TO, M_GO);
    ob->Kill(TP);
    harp--;
  }
  else
  {
    write(BS("Du beschimpfst die Harpyien aufs wildeste allerdings hoert Dir "
          "keine zu."));
    say(BS(TPN+" beschimpft die Harpyien."));
  }

  return 1;
}

void reset()
{
  ::reset();
  harp=2;
}
