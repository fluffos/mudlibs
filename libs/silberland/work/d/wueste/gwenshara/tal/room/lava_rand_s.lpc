#include "../def.h"

inherit STD "std_lavasee";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"\b"+
    "Du befindest Dich hier am oestlichen Rand des Lavabeckens.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "rand" }),
    "Du kannst hier aus der Lava klettern.");

  AddDetail( ({ "lavabecken", "becken" }),
    "Hier fliesst die Lava in einem Becken zusammen.");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_KLETTERN, "cmd_exit" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "lava_eck_sw");
  AddExit( "osten", ROOM "lava_eck_so");
  AddExit( "norden", ROOM "lava_mitte");
  AddExit( "nordosten", ROOM "lava_rand_o");
  AddExit( "nordwesten", ROOM "lava_rand_w");

//--Items & NPCs-----------------------------------------------------------

  AddItem( ({NPC "salamander",
	     NPC "feuerdruide",
	     NPC "teufel",
	     NPC "funken",}) , REFRESH_DESTRUCT);
}
