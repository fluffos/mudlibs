#include "../def.h"

inherit "std/room";

int lgb, tier;

void create()
{
  ::create();
  lgb = 5;
  tier = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Tibesti-Gebirge");
  SetProp(P_INT_LONG,
    "Du wanderst einen Pfad im Tibesti-Gebirge entlang. Seitlich des Pfades "
    "erhebt sich sandfarben das Gebirge. Aus dem Nordosten weht Dir ein "
    "heisser Wind entgegen. Vereinzelt stehen ein paar kleine Buesche, die "
    "im Wind rascheln.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "pfad", "weg" }),
    "Du wanderst auf einem sandigen Pfad durch das Tibesti-Gebirge. Hin und "
    "wieder steht ein windschiefer, vertrockneter Busch herum.");

  AddDetail( ({ "gebirge", "tibesti", "tibesti-gebirge", "berge" }),
    "Setlich des Pfades erhebt sich das sandfarbene Tibesti-Gebirge. Du "
    "siehst keinerlei Moeglichkeit den Pfad zu verlassen, denn die Steinwaende "
    "ragen fast senkrecht in die Hoehe.");

  AddDetail( ({ "wind", "nordostwind" }),
    "Aus dem Nordosten weht ein bestaendiger, heisser und trockener Wind. Du "
    "hast das Gefuehl, dass es im Nordosten immer heisser wird.");

  AddDetail( ({ "buesche" }),
    "Vereinzelt stehen vertrocknete Buesche am Pfad. Ihre Blaetter rascheln im "
    "heissen Nordostwind.");

  AddDetail( ({ "moeglichkeit" }),
    "Du findest hier keine Moeglichkeit den Weg zu verlassen, sicher waere das "
    "auch viel zu gefaehrlich.");

  AddDetail( ({ "waende", "steinwaende" }),
    "Seitlich des Pfades erheben sich die Steinwaende des Tibesti-Gebirges, wie "
    "unueberwindbare Hindernisse.");

  AddDetail( ({ "hoehe", "hoehen" }),
    "Das Tibesti-Gebirge erhebt sich bereits hier, am Anfang, in ungeahnte "
    "Hoehen.");

  AddDetail( ({ "gefuehl" }),
    "Du spuerst eindeutig, dass es im Nordosten heisser wird.");

  AddDetail( ({ "blaetter", "blatt", "langgrundblatt" }),
    "Das sieht nach einem Langgrundblatt aus. Diesese Blaetter rauchen Hobbits "
    "in ihren Pfeifen. Vielleicht sind im Busch noch ein paar brauchbare zu finden.");

  AddDetail( ({ "hindernis", "hindernisse" }),
    "Die Steinwaende scheinen Dir unueberwindbare Hindernisse zu sein.");

  AddDetail( ({ "anfang" }),
    "Du befindest Dich erst am Anfang des Tibesti-Gebirges, doch schon hier sind "
    "die Berge unuebrwindbar hoch.");

  AddDetail( ({ "hobbits", "kerlchen", "pelzkerlchen" }),
    "Hobbits sind gesellige Pelzkerlchen, die gerne eine gute Pfeife rauchen.");

  AddDetail( ({ "pfeifen", "pfeife" }),
    "Wenn Du eine hast, dann kannst Du das Langgrundblatt hier sicher gut gebrauchen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist wolkenlos und die Sonne brennt von ihm herab.");

  AddDetail( ({ "sonne", "strahlen" }),
    "Die Sonne sendet ihren waermenden Strahlen auf Dich herab.");

  AddDetail( ({ "boden" }),
    "Der Boden ist von feinem Wuestensand bedeckt.");

  AddDetail( ({ "sand", "wuestensand" }),
    "Nirgendwo findet sich so viel Sand, wie hier.");

  AddSound( DEFAULT_SOUND,
    "Du glaubst das Heulen eines hungrigen Sandwolfs zu hoeren, vielleicht "
    "ist es auch nur der Wind, der auch die Blaetter der Buesche zum rascheln "
    "bringt.");

  AddSound( ({ "heulen", "sandwolf" }),
    "Du bist Dir nicht ganz sicher. Es koennte auch nur der Wind gewesen sein.");

  AddSound( ({ "wind", "blaetter", "buesche", "busch" }),
    "Der Wind faehrt durch die Buesche und entreisst den Bueschen ein leises "
    "Rascheln.");

  AddSound( ({ "rascheln" }),
    "Du lauscht dem Rascheln und bemerkst darin ein leises Zischeln.");

  AddDetail( ({ "zischeln", "tier" }),
    "Das Zischeln kommt von einem Busch in der Naehe. Es koennte ein Tier "
    "sein, dass man vielleicht aufscheuchen kann.");

  AddSmell( DEFAULT_SMELL,
    "Du riechst nur den Staub und den Sand der Wueste.");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_DURCHSUCHEN, "cmd_blatt" );
  AddCmd( ({"scheuche", "scheuch"}), "cmd_schlange");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "valley_1" );
  AddExit( "nordosten", ROOM "valley_3");
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_blatt(string str)
{
  object blatt;
  notify_fail("Was willst Du durchsuchen?\n");

  if (!str || str == "") return 0;
  if (!(str == "busch" ||
	str == "buesche" ||
	str == "busch nach blatt" ||
	str == "busche nach blatt" ||
	str == "blaetter" ||
	str == "strauch" ||
	str == "straeucher")) return 0;

  if(lgb > 0)
  {
    write(BS("Du durchsuchst die Buesche und findest tatsaechlich ein "
	  "brauchbares Langgrundblatt."));
    say(BS(TPN+" untersucht die Buesche genauer und scheint etwas gefunden "
	"zu haben."));
    blatt = clone_object("/d/huegelland/orw/pfeifenladen/obj/langgrundblatt");
    if(blatt->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      write(BS("Da Dir das Blatt zu schwer ist, laesst Du es am Busch."));
      lgb++;
    }
    lgb--;
  }
  else
  {
    write(BS("Du durchsuche die Buesche, kannst aber kein passendes "
	  "Blatt finden."));
    say(BS(TPN+" untersucht die Buesche genauer."));
  }

  return 1;
}

int cmd_schlange(string str)
{
  object schlange;
  if(!str || str == "") return 0;
  if(!(str == "tier auf" ||
       str == "tier" ||
       str == "etwas auf" ||
       str == "etwas")) return 0;

  if(tier != 0)
  {
    write(BS("Du scheuchst das Tier aus dem Busch."));
    say(BS(TPN+" scheucht ein Tier aus einem Busch."));
    schlange = clone_object(NPC "klapperschlange");
    schlange->move(TO, M_GO);
    tier--;
  }
  else
  {
    write(BS("Du willst das Tier aus dem Busch scheuchen, aber es ist scheinbar "
          "doch keines darin."));
    say(BS(TPN+" versucht ein Tier aus einem Busch zu scheuchen, doch es ist "
        "gar keines dort!"));
  }

  return 1;
}

void reset()
{
  ::reset();
  lgb = 5;
  tier = 1;
}
