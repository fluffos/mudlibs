#include "../def.h"

inherit "std/room";

int leiche;

void create()
{
  ::create();
  leiche = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Tibesti-Gebirge");
  SetProp(P_INT_LONG,
    "Der Pfad, dem Du durchs Tibesti-Gebirge folgst, fuehrt hier an einem "
    "Haufen Steine vorbei. Die Hitze hat hier deutlich zugenommen und Du "
    "glaubst einen leichten Hauch von Schwefel in der Luft zu riechen. Im "
    "Sand erkennst Du, vorallem um den Steinhaufen herum, sehr viele "
    "Tierspuren.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "pfad", "weg" }),
    "Der Pfad schlaengelt sich zielsicher durchs Gebirge. Einen Pfad kann "
    "man es eigentlich nicht wirklich nennen, es ist eher der einzig "
    "begehbare Weg hier.");

  AddDetail( ({ "gebirge", "tibesti", "tibesti-gebrige", "felsmassiv", "massiv",
	       "bergen" }),
    "Das Tibesti-Gebirge ist ein beinahe unueberwindbares Felsmassiv am Rand "
    "der Wueste. Viele gefaehrliche Tiere sollen darin leben.");

  AddDetail( ({ "haufen", "steine", "steinhaufen" }),
    "Der Steinhaufen wurde wohl von einer Geroelllawine aus den umliegenden "
    "Bergen gebildet. An einer Stelle wirken die Steine etwas lockerer.");

  AddDetail( ({ "hitze", "schritt" }),
    "Mit jedem Schritt nach Norden hin nimmt die Hitze zu.");

  AddDetail( ({ "hauch", "schwefel" }),
    "Du meinst einen leichten Hauch Schwefel in der Luft zu spueren. Leider "
    "kann man ihn nicht so richtig gut sehen.");

  AddDetail( ({ "sand", "boden" }),
    "Im sanidgen Boden sind, vorallem um den Steinhaufen herum, sehr viele "
    "Tierspuren zu sehen.");

  AddDetail( ({ "spuren", "tierspuren" }),
    "Die Tierspuren konzentrieren sich auf den Steinhaufen. Er scheint etwas "
    "an sich zu haben, dass sie anzieht.");

  AddDetail( ({ "rand" }),
    "Hier bist du relativ am Rand der Wueste.");

  AddDetail( ({ "wueste", "landschaft" }),
    "Die Wueste ist eine oede und trockene Landschaft.");

  AddDetail( ({ "tiere", "acht" }),
    "Die Tiere im Tibesti-Gebirge sind alle entweder giftig oder hungrig. "
    "Also solltest Du Dich vor ihnen in Acht nehmen.");

  AddDetail( ({ "lawine", "geroelllawine" }),
    "Der Steinhaufen hier wurde von einer Geroelllawine aus den umliegenden "
    "Bergen gebildet.");

  AddDetail( ({ "stelle" }),
    "Eine Stelle des Steinhaufens scheint locker zu sein. Mit dem geeigneten "
    "Werkzeug koennte man dort vielleicht graben.");

  AddDetail( ({ "luft" }),
    "Die Luft ist heiss und scheinbar von Schwefel durchsetzt.");

  AddDetail( ({ "werkzeug", "richtige" }),
    "Eine Schaufel sollte das Richtige sein.");

  AddDetail( ({ "himmel", "sonne" }),
    "Die Sonne starrt vom wolkenlosen Himmel auf Dich herab.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Heulen des Windes.");

  AddSound( ({ "heulen", "wind" }),
    "Wuuuuuhuuuuuu!");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht leicht nach Schwefel.");

  AddSmell( ({ "schwefel", "note", "duftnote" }),
    "Es ist nur eine ganz leichte Duftnote");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({"grab", "grabe", "schaufel", "schaufle"}), "cmd_graben" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "valley_4" );
  AddExit( "suedwesten", ROOM "valley_2" );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "hyaene" , REFRESH_DESTRUCT);
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_graben(string str)
{
  object ring;
  notify_fail("Worin moechtest Du graben?\n");
  if(!str || str == "") return 0;
  if(!(str == "in haufen" ||
       str == "in steinhaufen" ||
       str == "in steinen" ||
       str == "an stelle" ||
       str == "in stelle" )) return 0;

  notify_fail("Ohne Schaufel kannst Du hier nicht graben!\n");
  if(!present("schaufel", TP)) return 0;

  write(BS("Du graebst in dem Steinhaufen herum und stoesst auf die "
        "Ueberreste eines Wanderers."));
  say(BS(TPN+" graebt in dem Steinhaufen und scheint auf etwas gestossen "
     "zu sein."));
  
  if(leiche)
  {
    write(BS("Du findest bei der Leiche einen Ring, den Du einsteckst."));
    say(BS(TPN+" steckt irgendwas ein."));
    ring = clone_object("/p/armour/ring/ring");
    if(ring->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      write(BS("Da Dir der Ring zu schwer ist, laesst Du ihn."));
      leiche++;
    }
    leiche--;
  }  
  else
  {
    write(BS("Du findest bei der Leiche nichts Besonderes."));
  }

  write(BS("Die Steine rollen wieder nach."));
  say(BS("Die weggschaufelten Steine rollen wieder nach."));

  return 1;
}

void reset()
{
  ::reset();
  leiche = 1;
}
