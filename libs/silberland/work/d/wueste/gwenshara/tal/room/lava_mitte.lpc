#include "../def.h"

inherit STD "std_lavasee";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"\b"+
    "Du befindest Dich hier exakt in der Mitte dieses Infernos.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "mitte" }),
    "Du bemerkst das dies hier exakt die Mitte des Lavasees sein muss.");

  AddDetail( ({ "inferno", "lavabecken", "becken" }),
    "Dieses Lavabecken hier ist ein wahres Inferno.");

//--Kommandos--------------------------------------------------------------

//  AddCmd( CMD_KLETTERN, "cmd_exit" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "lava_rand_w");
  AddExit( "osten", ROOM "lava_rand_o");
  AddExit( "sueden",  ROOM "lava_rand_s");
  AddExit( "norden", ROOM "lava_rand_n");
  AddExit( "suedwesten", ROOM "lava_eck_sw");
  AddExit( "suedosten", ROOM "lava_eck_so");
  AddExit( "nordosten", ROOM "lava_eck_no");
  AddExit( "nordwesten", ROOM "lava_eck_nw");


//--Items & NPCs-----------------------------------------------------------

  AddItem( ({NPC "salamander",
	     NPC "feuerdruide",
	     NPC "teufel",
	     NPC "funken",}) , REFRESH_DESTRUCT);
}
