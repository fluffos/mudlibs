#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Der Feuerwindpass");
  SetProp(P_INT_LONG,
    "Du stehst hier am Beginn eines Gebirgspasses. Die Erde hier hat eine "
    "seltsam schwarze Faerbung angenommen, als ob sie versengt worden "
    "waere. Die wenigen Buesche, die du hier siehst, sind entweder "
    "verkohlt oder gluehen vor sich hin. Die Felswaende links und rechts "
    "von Dir sind mit einer dicken Schicht Russ bedeckt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 55, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "beginn", "pass", "gebirgspass" }),
    "Hier beginnt ein Gebirgspass, der sich in gerade Linie nach Nordosten "
    "zieht.");

  AddDetail( ({ "erde", "boden" }),
    "Der sandige Boden ist hier geschwaerzt, als haetten Flammen ihn "
    "verbrannt.");

  AddDetail( ({ "faerbung" }),
    "Es sieht so aus, also haette hier ein gewaltiges Feuer gewuetet, denn "
    "die Felswaende und der Boden sind von Russ geschwaerzt.");

  AddDetail( ({ "buesche" }),
    "Ein paar wenige Buesche gedeihen hier, trotz der widrigen Umstaende. "
    "Jedoch sind alle, die Du hier siehst kohlrabenschwarz, verbrannt oder "
    "ihre Blaetter gluehen, als haetten sie gerade eben noch gebrannt.");

  AddDetail( ({ "waende", "felswaende", "seiten" }),
    "Die Felswaende an den Seiten des Passes sind mit einer dicken "
    "Russschicht bedeckt. Ein ziemlich starkes Feuer muss wohl an ihnen "
    "entlang gestrichen sein. Ab und an entdeckst Du ein Glitzern an den "
    "Waenden.");

  AddDetail( ({ "russ", "schicht", "russschicht" }),
    "Beinahe alles hier ist von einer dicken Russschicht bedeckt.");

  AddDetail( ({ "linie", "nordosten" }),
    "Der Gebirgspass zieht sich in einer beinahe schnurgeraden Linie nach "
    "Nordosten. Dort in der Ferne erkennst Du auch eine Rauchsaeule "
    "aufsteigen.");

  AddDetail( ({ "flammen" }),
    "Die Flammen, die hier ueber den Pass gefegt sind muessen von enormer "
    "Hitze gewesen sein um diese Verwuestung hier anzurichten.");

  AddDetail( ({ "feuer" }),
    "Vor nicht all zu langer Zeit muss hier ein gewaltiges Feuer gebrannt "
    "haben. Seine Flammen muessen unglaublich heiss gebrannt haben.");

  AddDetail( ({ "umstaende" }),
    "Hier herrschen aeusserst vegetationsfeindliche Umstaende.");

  AddDetail( ({ "blaetter" }),
    "Die meisten Blaetter hier sind verbrannt. Einige wenige glimmen noch.");

  AddDetail( ({ "glitzern", "stellen" }),
    "Einige Stellen der Felswaende glitzern. Es muss sich wohl um "
    "geschmolzenen Sand handeln.");

  AddDetail( ({ "saeule", "rauchsaeule", "ferne" }),
    "Im Nordosten steigt eine schwarze Rauchsaeule in den Himmel hinauf. "
    "Da sie sehr gross ist muss es sich im ein riesiges Feuer handeln, "
    "das dort brennt.");

  AddDetail( ({ "hitze" }),
    "Ein Feuer, dass den Boden und die Waende verbrennt muss extrem heiss "
    "gewesen sein.");

  AddDetail( ({ "verwuestung" }),
    "Die Flammen, die hier gewuetet haben, haben alles verwuestet.");

  AddDetail( ({ "himmel" }),
    "Hier ist der Himmel noch blau, doch weiter im Norden wird er "
    "immer roetlicher.");

  AddDetail( ({ "zeit" }),
    "*Tick-Tack*");

  AddDetail( ({ "sand", "quarz" }),
    "Der Sand wurde hier teilweise eingeschmolzen, sodass etwas wie "
    "Quarz entstanden ist.");

  AddSound( ({DEFAULT_SOUND, "bruellen", "flammen"}),
    "Im Nordosten hoerst Du das Bruellen von Flammen.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "asche"}),
    "Der Geruch von Asche steigt Dir in die Nase.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", "./valley_4" );
  AddExit( "nordosten", "./valley_6");

//--Items------------------------------------------------------------------
  
  AddItem( OBJ "flammenpass_schild", REFRESH_DESTRUCT);

}
