#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Tibesti-Gebirge");
  SetProp(P_INT_LONG,
    "Du stehst hier am Ende des Passes. Zwei zerklueftete Felsen markieren "
    "das Ende des Gebirgspfades durch das Tibesti-Massiv. Noerdlich fuerht "
    "ein schmaler Grat ueber einen Fluss von fluessigem Gestein. Schwarzer "
    "Kies bedeckt den Boden und der Himmel ist von roetlicher Farbe. Von "
    "dieser erhoehten Position aus hast Du eine gute Uebersicht ueber das "
    "Tal.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 65, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "pass", "gebirgspass", "ende" }),
    "Der Gebirgspass, dem Du gefolgt bist endet hier.");

  AddDetail( ({"felsen"}) ,
    "Zwei Felsen - links und rechts von Dir - kennzeichnen das Ende "
    "des sicheren Pfades. Nur ein schmaler Grat fuehrt hier weiter." );

  AddDetail( ({"pfad", "gebirgspfad"}) ,
    "Der sichere Gebirgspfad, dem Du bis hier hin durch das Gebirge "
    "gefolt bist existiert nicht mehr." );

  AddDetail( ({ "massiv", "tibesti", "tibesti-massiv", "tibesti-gebirge", 
             "wall", "gebirge" }) ,
    "Das Tibesti-Gebirge umgibt das Tal, das hier liegt, wie ein "
    "schuetzender Wall." );

  AddDetail( ({ "grat", "felsgrat", "felsgrates" }) ,
    "Ein schmaler Grat aus Vulkangestein fuehrt noerdlich von hier ueber "
    "einen Fluss aus geschmolzenem Gestein." );

  AddDetail( ({ "fluss" }) ,
    "Den toetlichen Fluss aus heisser Lava kannst Du nur dank des Felsgrates "
    "noerdlich von hier ueberqueren." );

  AddDetail( ({ "gestein", "lava", "vulkangestein" }) ,
    "Das fluessige Gestein tief unter Dir nennt man Lava." );

  AddDetail( ({ "boden" }) ,
    "Schwarzer Kies bedeckt den Boden. An manchen Stellen meinst Du noch ein "
    "schwaches Gluehen des Steins zu sehen." );

  AddDetail( ({ "kies" }) ,
    "Der Kies hier auf dem Boden ist pechschwarz." );

  AddDetail( ({ "himmel" }) ,
    "Der Himmel ueber Dir ist seltsam roetlich gefaerbt. So wie Blut." );

  AddDetail( ({ "farbe", "blut", "faerbung" }) ,
    "Der Himmel hier hat eine blutrote Faerbung. Das ist sicher kein "
    "gutes Zeichen." );

  AddDetail( ({ "position" }) ,
    "Von hier aus kannst Du Deinen Blick hervorragend ueber das Tal "
    "schweifen lassen." );

  AddDetail( ({ "tal", "uebersicht" }) ,
    "Noerdlich von Dir erstreckt sich ein Tal. Sein Anblick verschlaegt "
    "Dir im ersten Moment die Sprache. Noch nie hast Du so viel Feuer "
    "auf einem Fleck gesehen. Dein Blick schweift ueber das Tal und Du "
    "erkennst zu allererst den riesigen Vulkan im Norden. Im Westen des "
    "Tals siehst Du einen Wald, der Feuer gefangen hat und in der Mitte "
    "des Infernos blubbert ein Lavasee. Ueberrascht bist Du vom Osten "
    "des Tals, denn dort befindet sich ein Gletscher." );

  AddDetail( ({ "gluehen", "stellen" }) ,
    "An einigen Stellen glueht der Kies." );

  AddDetail( ({ "anblick", "moment", "sprache" }) ,
    "Der Anblick dieses elementaren Schauspiels ist atemberaubend." );

  AddDetail( ({ "feuer", "fleck" }) ,
    "Das ganze Tal scheint aus Feuer zu bestehen. Sogar der Himmel ueber "
    "dem Tal brennt. Wie eine Gewitterwolke schweben Flammen ueber dem "
    "Inferno und senden Blitze aus Feuer gegen den Boden." );

  AddDetail( ({ "vulkan", "ungetuem" }) ,
    "Der riesige Vulkan ist genau noerdlich von Dir. Er ist ein feuer"
    "speiendes Ungetuem aus schwarzem Gestein." );

  AddDetail( ({ "wald" }) ,
    "Der Wald im Westen brennt lichterloh. Nach einiger Zeit bemerkst Du, "
    "dass er scheinbar nicht verbrennt - eine maechtige Kraft muss ihn "
    "davor schuetzen niederzubrennen." );

  AddDetail( ({ "mitte", "lavasee", "see" }) ,
    "In der Mitte des Tals liegt ein See aus kochendem Gestein. Durch den "
    "Vulkan wird er immer wieder mit neuer Lava versorgt." );

  AddDetail( ({ "gletscher", "berg", "eis" }) ,
    "Was soll denn das? So nahe an diesem Inferno liegt ein Gletscher? Das "
    "verwirrt Dich nun doch. Warum schmilzt dieser Berg aus Eis nicht?" );

  AddDetail( ({ "schauspiel", "schauspiels" }) ,
    "Hier muss eine gewaltige elementare Kraft konzentriert sein. Ob dies "
    "das legendaere Tal der Flammen ist, aus dem alles Feuer entspringen "
    " soll?" );

  AddDetail( ({ "wolke", "flammen", "blitze", "gewitterwolke" }) ,
    "Der Himmel ueber dem Tal ist in Flammen getaucht. Blitze aus Feuer "
    "zucken aus ihm auf das Tal zu." );

  AddDetail( ({ "kraft", "energie", "elementarenergie" }) ,
    "Die reine Elementarenergie des Feuers ist hier konzentriert." );

  AddDetail( ({ "inferno", "hoelle" }) ,
    "Das Tal ist scheinbar eine Hoelle aus Feuer. Ob Du genug Schutz "
    "vor der Hitze dort unten hast?" );

  AddSound( ({DEFAULT_SOUND, "bruellen", "feuer"}),
    "Das Bruellen des Feuers ist unueberhoerbar.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "asche"}),
    "Der Geruch von Asche steigt Dir in die Nase.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedosten", "./valley_6" );
  AddExit( "norden", "./road_1");

}
