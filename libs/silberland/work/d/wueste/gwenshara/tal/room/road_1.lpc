#include "../def.h"
#include <verben.h>

inherit STD "std_road";

int uneb;
int wurm;

void create()
{
  ::create();
  uneb=1;
  wurm = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier auf einem schmalen Felsgrat. Unter Dir fliesst ein "
    "Fluss aus Lava traege dahin. Alles erscheint Dir in einem diffusen, "
    "roten Schleier und giftige Daempfe wallen um Dich herum auf. Die "
    "Hitze hier braet Dich leicht an.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "grat", "felsgrat", "boden" }),
    "Du stehst hier auf einem schmalen Felsgrat. Er ist von etlichen "
    "Unebenheiten bedeckt. Du schaetzt, dass er wohl aus Vulkangestein "
    "besteht.");

  AddDetail( ({ "fluss" }),
    "In einem satten Orange glueht unter Dir geschmolzenes Gestein, dass "
    "sich traege seinen Weg bahnt. Von ihm steigen gewaltige Hitze und "
    "giftige Daempfe auf.");

  AddDetail( ({ "lava", "gestein", "masse" }),
    "Die Lava waelzt sich unter Dir gemuetlich und hitzeverstroemend "
    "dahin. Angesichts dieser Naturgewalt kommst Du Dir vor, wie ein "
    "kleiner Wurm.");

  AddDetail( ({ "schleier", "licht" }),
    "Der Himmel taucht alles in ein diffuses, roetliches Licht, dass Dich "
    "nicht weit sehen laesst.");

  AddDetail( ({ "daempfe", "luft" }),
    "Giftige Daempfe erfuellen die Luft, hier solltest Du nicht zu tief "
    "einatmen.");

  AddDetail( ({ "hitze" }),
    "Die Hitze hier braet Deine haut leicht an.");

  AddDetail( ({ "unebenheiten", "oberflaeche" }),
    "Etliche Unebenheiten zieren die Oberflaeche dieses Flesgrates, so dass "
    "Du aufpassen musst nicht runterzufallen. Eine der Unebenheiten zieht "
    "Deine Aufmerksamkeit auf sich.");

  AddDetail( ({ "vulkangestein" }),
    "Der Felsgrat unter Dir besteht eindeutig aus Vulkangestein.");

  AddDetail( ({ "orange" }),
    "Die gewaltige, orangene Masse unter Dir verstroemt eine unglaubliche "
    "Hitze.");

  AddDetail( ({ "weg" }),
    "Die Lava bahnt sich unbarmherzig ihren Weg. Alles was ihr in diesem "
    "steht wird gnadenlos verbrannt.");

  AddDetail( ({ "gewalt", "naturgewalt", "anblick" }),
    "Bei diesem Anblick wird Dir bewusst, wie wenig Dein Leben eigentlich "
    "zaehlt.");

  AddDetail( ({ "wurm", "wuermchen" }),
    "Du bist wirklich ein Wuermchen. Apropos, in der Lava fallen Dir kleine "
    "Wuermer auf.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber dir brennt.");

  AddDetail( ({ "haut" }),
    "Deine Haut ist schon ganz rot.");

  AddDetail( ({ "unebenheit" }),
    "Diese eine Unebenheit sieht sehr sproede aus, vielleicht kann man "
    "sie abbrechen?");

  AddDetail( ({ "aufmerksamkeit" }),
    "Diese eine Unebenheit macht auf sich aufmerksam.");

  AddDetail( ({ "wuermer", "lavawuermer" }),
    "Ob das wohl Lavawuermer sind? Eventuell kannst Du Dir einen angeln!");

  AddDetail( ({ "leben" }),
    "In dieser Umgebung ist Dein Leben nicht mehr wert, als Futter fuer "
    "die Flammen.");

  AddDetail( ({ "futter", "flammen", "holz" }),
    "Flammen fressen gerne Holz.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({"breche", "brich", "brech"}), "cmd_abbrechen" );
  AddCmd( ({"angel", "angle"}), "cmd_angeln");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordostunten", "./road_2" );
  AddExit( "sueden", "./valley_7");
}

int cmd_abbrechen(string str)
{
  object ob;
  notify_fail("Was willst Du abbrechen?\n");
  if(!str || str == "") return 0;
  if(!(str == "unebenheit" ||
       str == "unebenheit ab")) return 0;

  if(!uneb)
  {
    write(BS("Du reisst und zerrst an der Unebenheit, doch sie ist wohl "
          "haerter als es aussieht."));
    say(BS(TPN+" reisst an einer Unebenheit herum."));
    return 1;
  }

  write(BS("Mit einem starken Ruck brichst Du die Unebenheit ab."));
  say(BS(TPN+" bricht ein Stueck aus dem Felsgrat."));
  ob = clone_object(OBJ "felsgrat");
  if(ob->move(TP, M_GET) == ME_TOO_HEAVY)
  {
    write(BS("Das Stueck ist Dir zu schwer. Du laesst es liegen."));
    say(BS(TPN+" laesst das Stueck einfach liegen."));
    ob->move(TO);
  }
  uneb--;
  return 1;
}

int cmd_angeln(string str)
{
  object ob;
  notify_fail("Was moechtest Du angeln?\n");
  if(!str || str == "") return 0;
  if(!(str == "nach wurm" ||
       str == "wurm" ||
       str == "wuermer" ||
       str == "nach wuermer" ||
       str == "nach wuermern" ||
       str == "lavawurm" ||
       str == "nach lavawurm" ||
       str == "nach lavawuermer" ||
       str  == "nach lavawuermern" )) return 0;

  if(!present("angel", TP))
  {
    write("Ohne Angel kann man nicht angeln!\n");
    return -1;
  }

  if(!wurm)
  {
    write(BS("Du wirst Deine Angel aus und wartest... Es beisst "
          "aber kein Lavawurm an."));
   say(BS(TPN+" wirft eine Angel aus, faengt jedoch nichts."));
   return 1;
  }

  write(BS("Du wirst Deine Angel aus und wartest... Sofort "
        "hat ein Wurm angebissen und Du holst ihn herauf."));
  say(BS(TPN+" wirft die Angel aus und zieht einen Wurm aus "
      "der Lava."));
  ob = clone_object(NPC "lavawurm");
  ob->move(TO, M_SILENT|M_GO);
  wurm--;
  return 1;
}