#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein verbrannter Weg");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 60, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

  AddSound( ({DEFAULT_SOUND, "bruellen", "feuer"}),
    "Das Bruellen des Feuers ist unueberhoerbar.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "asche"}),
    "Der Geruch von Asche steigt Dir in die Nase.");

  AddDetail( ({ "himmel" }),
    "Der Himmel glueht feuerrot." );

  AddDetail( ({ "boden" }),
    "Der Boden hier ist mit einer dicken Ascheschicht bedeckt." );

  AddDetail( ({ "schicht", "ascheschicht" }),
    "Eine dicke Schicht aus erkalteter Asche bedeckt den Boden." );

  AddDetail( ({ "dunst", "sicht" }),
    "Ein roetlicher Dunst behindert Deine Sicht." );

  AddDetail( ({ "tal", "tal der flammen" }),
    "Du bist hier mitten im Tal der Flammen!" );
//--Items & NPCs-----------------------------------------------------------

  AddItem( ROADNPC , REFRESH_DESTRUCT);
}