#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem See aus geschmolzenem Stein");
  SetProp(P_INT_LONG,
    "Ueberall um Dich herum fliesst fluessiges Gestein. Die sengende Hitze "
    "um Dich herum treibt Dir alle Fluessigkeit aus dem Koerper. Wenn hier "
    "etwas lebt, dann kann es nicht hitzeempfindlich sein. Rund um Dich "
    "schlagen ab und zu Flammen aus dem fluessigen Gestein.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 100, ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "lava", "gestein", "stein" }),
    "Um Dich herum befindet sich ueberall fluessiges Gestein. Es fliesst "
    "traege dahin. Ohne entsprechende Hilfsmittel wuerdest Du hier wohl keine "
    "Sekunde ueberleben.");

  AddDetail( ({ "hitze" }),
    "Die Luft ueber dem fluessigen Gestein scheint schon richtig zu gluehen!" );

  AddDetail( ({ "fluessigkeit" }),
    "Jegliche Fluessigkeit wird Dir durch diese unglaubliche Hitze ausgetrieben." );

  AddDetail( ({ "koerper" }),
    "Dein Koerper leidet unter den Auswirkungen der Lava." );

  AddDetail( ({ "flammen", "flamme", "saeule", "flammensaeule" }),
    "Ab und zu schlaegt eine Flammensaeule aus der Lava empor." );

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen ist durch maechtige Magie zu erkaltetem Stein "
    "erstarrt. Alles andere besteht nur aus fliessendem und gluehendem Gestein." );

  AddDetail( ({ "auswirkungen", "auswirkung" }),
    "Deine Haut ist trocken, wie Pergament. Dein Haar ist an einigen Stellen "
    "versengt und Deine Lippen sind trocken und aufgesprungen." );

  AddDetail( ({ "magie" }),
    "Maechtige Magie scheint Dich hier zu beschuetzen!" );

  AddDetail( ({ "haut", "pergament" }),
    "Deine Haut ist ausgetrocknet, wie altes Pergament." );

  AddDetail( ({ "haar", "stellen" }),
    "Dein Haar hat an einigen Stellen Feuer gefangen und ist dort verbrannt." );

  AddDetail( ({ "lippen" }),
    "Deine Lippen sind ausgetrocknet und aufgesprungen." );

  AddDetail( ({"fuesse", "fuessen"}),
    "Dank maechtiger Magie stehen Deine Fuesse auf sicherem Boden. Allerdings "
    "solltest Du keinen Schritt wagen, da Dich das fluessige Gestein unweigerlich "
    "verbrennen wuerde!");

  AddDetail( ({"hilfsmittel", "mittel"}),
    "Ohne irgendwelche Hilfsmittel wuerdest Du hier in der Lava versinken.");

  AddDetail( ({"sekunde"}),
    "Keine Sekunde wuerdest Du hier ueberleben.");

  AddDetail( ({"himmel"}),
    "Der Himmel scheint aus reinem Feuer zu bestehen.");

  AddDetail( ({"luft"}),
    "Die Luft hier glueht roetlich und wirkt als wuerde sie selbst brennen");

  AddDetail( ({"schritt", "bewegung"}),
    "Jeder Schritt, jede Bewegung kann hier ohne die richtigen Hilfsmittel "
    "toedlich enden.");
  
  AddDetail( ({"feuer"}),
    "Feuer ist hier ueberall...");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Fliessen des Gesteins und das Fauchen von Flammen.");

  AddSound( ({"flammen", "fauchen", "flammensaeulen"}),
    "Fauchend brechen Flammensaeulen aus dem Boden!");

  AddSound( ({"fliessen", "stein", "gestein"}),
    "*Blubb* *Blubb*");

  AddSmell( DEFAULT_SMELL,
    "Wegen der ganzen Hitze riechst Du kaum etwas.");

  SetProp(P_ELEMENTAL_ROOM, ERZ);
}

int burn()
{
  return 1;
  if(present("\ngwenshara_waterboots", TP) || !interactive(TP)) return 1;
  tell_object(TP, BS("Du sinkst in der Lava ein!"));
  tell_room(TO, BS(TPN+" sinkt in der Lava ein!"), ({TP}));
  TP->AddHp(-50-random(51));
  return 0;
}

int cmd_exit(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str || str == "") return 0;
  if(!(str == "aus see" ||
       str == "aus becken" ||
       str == "aus lava" ||
       str == "aus lavasee" ||
       str == "aus lavabecken" ||
       str == "raus" ||
       str == "rauf" )) return 0;
  
  if(ME_TOO_EXHAUSTED == TP->move(QueryProp("lava_connector"), M_GO))
  {
    write(BS("Du versuchst den Rand des Beckens zu erklimmen, bist allerdings "
	  "zu muede."));
    say(BS(TPN+" versucht aus dem Becken zu klettern, schafft es jedoch nicht."));
    return 1;
  }

  write(BS("Du erklimmst den Rand des Lavasees und ziehst Dich hinaus."));
  say(BS(TPN+" erklimmt den Rand des Lavabeckens."));

  return 1;
}

void AddExit(mixed cmd, string dest)
{
  ::AddExit(cmd, ([EX_DEST: dest, EX_TESTFUNC: "burn"]));
}
