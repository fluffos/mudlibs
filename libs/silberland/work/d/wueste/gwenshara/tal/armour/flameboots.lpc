#include "../def.h"

inherit "std/armour";

int questmode;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  questmode = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Flammenstiefel");
  SetProp(P_LONG,
    "Diese Stiefel scheinen auf den ersten Blick nur aus Flammen zu "
    "bestehen. Auf den zweiten Blick erkennst Du das sie jedoch eigentlich "
    "ein Sandalenpaar sind, auf dem ein maechtiger elementarer Zauber "
    "liegt.");
  SetProp(P_INFO, BS("Diese Stiefel lassen ihren Traeger auf fluessigem "
                 "Gestein laufen."));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Flammenstiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "flammenstiefel", "\ngwenshara_waterboots"}) );
  SetProp(P_PLURAL, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:5, MAT_FIRE:95]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_FIRE:1]) );
}

// Fuer die Quest noetig...
void _go_questmode()
{
  log_file(LOG "tempelquest.log", "Xerinstiefel in Questmode! ("+
           file_name(PO)+")", 78);
  questmode=1;
  SetProp(P_AC, 0);
}

int _get_questmode()
{
  return questmode;
}