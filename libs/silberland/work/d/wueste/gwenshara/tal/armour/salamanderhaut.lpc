#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Haut eines Salamanders");
  SetProp(P_LONG,
    "Diese Haut gehoerte einst einem Riesensalamander. Sie ist schwarz mit "
    "gelben Flecken. Man sagt der Haut eines Riesensalamanders nach einen "
    "guten Hitzeschutz zu bieten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Salamanderhaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haut", "salamanderhaut", "riesensalamanderhaut"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:7]));
}
