#include "../def.h"

inherit "std/armour";

int flame;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  flame = random(3);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein rubinbesetzer Goldring");
  SetProp(P_LONG,
    "Der Ring besteht aus Gold und drei kleine, tiefrote Rubine sind in "
    "ihn eingelassen. Das Metall des Goldringes ist seltsam warm und aus "
    "den Rubinen dringt ein unnatuerliches Flackern, wie von Flammen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Goldring");
  SetProp(P_GENDER, MALE);
  AddId( ({"goldring", "ring", "flammenring", "\ngwenshara_flamering"}) );

  SetProp(P_NAME_ADJ, "rubinbesetzt" );
  AddAdjective( ({"rubinbestzten","rubinbestzter","rubinbestztem",
		  "rubinbestztes", "rubinbestzte"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GOLD:50, MAT_RUBY:20, MAT_FIRE:10, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_FIRE:1]) );

  SetProp(P_INFO, BS("Mit diesem Ring kannst Du anderen mit einem Flammenstoss "
	          "einheizen! (flammenstoss <name)") );

  AddCmd( ({"flammenstoss"}), "flame");
}

int flame(string str)
{
  object who;
  notify_fail("Wen soll der Flammenstoss treffen?\n");
  if(!str || str == "") return 0;
  if(!present(str, ENV(TP))) return 0;

  if(!QueryProp(P_WORN))
  {
    write(BS("Du musst den Ring schon tragen!"));
    return -1;
  }

  if(flame<1)
  {
    write(BS("Der Ring ist noch nicht aufgeladen!"));
    return -1;
  }

  who = present(str, ENV(TP));
  if(interactive(who))
  {
    write(BS("Eine Stichflamme stoesst aus dem Ring auf "+who->Name(WEN)+
	     " hervor!"));
    tell_object(who, BS("Eine Stichflamme stoesst von "+TPN+" aus auf Dich "
	        "zu! Dir wird ganz wohlig warm..."));
    tell_room(ENV(TP), BS("Eine Stichflamme stoesst von "+TPN+" aus auf "+
	      who->Name(WEN)+" zu! Das duerfte schoen warm sein..."),
	      ({who, TP}));
    return 1;
  }
  write(BS("Eine Stichflamme stoesst aus dem Ring auf "+who->Name(WEN)+
	     "hervor!"));
  tell_room(ENV(TP), BS("Eine Stichflamme stoesst von "+TPN+" aus auf "+
            who->Name(WEN)+" zu!"), ({who, TP}));

  who->Defend(100, DT_FIRE, ([SP_SHOW_DAMAGE:1, SP_NAME:"Feuerpfeil"]), TP);

  flame--;
  return 1;
}

void reset()
{
  if(!is_clone(TO)) return;
  flame = random(3);

  if(ENV(TO))
    tell_object(ENV(TO), "Der rubinbesetzte Goldring erwaermt sich");
}
