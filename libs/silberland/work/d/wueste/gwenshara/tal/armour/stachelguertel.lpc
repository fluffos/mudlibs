#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Stachelguertel");
  SetProp(P_LONG,
    "Dieser Lederguertel wurde mit allen nur erdenklichen Arten von "
    "Stacheln ausgestattet. Dornen, Metallspitzen, Glasscherben, spitze "
    "Steine - alles ist an ihn gebunden oder eingearbeitet. Wer diesen "
    "Guertel mit blossen Haenden angreift, duerfte sich sehr uebel "
    "verletzen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stachelguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "stachelguertel", "\ngwenshara_stingbelt"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1+random(3));
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS,	 ([A_DEX:18]) );

  SetProp(P_INFO, BS("Unbewaffnete Gegner duerften Schmerz erleiden, wenn "
	  "sie auf den Guertel treffen.") );
}

int WearFunc(object me)
{
  object *armour, glove;
  int i;
  armour = TP->QueryArmours();

  for(i=0; i<sizeof(armour); ++i)
    if(armour[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE)
      glove = armour[i];

  if(objectp(glove)) return 1;

  tell_object(TP, BS("Du schneidest Dich am Guertel!"));
  TP->AddHp(-10);
  return 1;
}

int RemoveFunc(object me)
{
  object *armour, glove;
  int i;
  armour = TP->QueryArmours();

  for(i=0; i<sizeof(armour); ++i)
    if(armour[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE)
      glove = armour[i];

  if(objectp(glove)) return 1;

  tell_object(TP, BS("Du schneidest Dich am Guertel!"));
  TP->AddHp(-10);
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object *armour;
  int i;
  armour = TP->QueryArmours();

  if(enemy->QueryProp(P_WEAPON)) return 0;
  for(i=0; i<sizeof(armour); ++i)
    if(armour[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE)
       return 0;
  
  if(random(20)) return 0;
  tell_object(enemy, BS("Du triffst auf den Guertel Deines Gegners und "
	      "verletzt Dich dabei!"));
  tell_object(QueryProp(P_WORN), BS(enemy->Name(WER)+" trifft Deinen "
	     "Guertel und verletzt sich dabei!"));
  tell_room(ENV(enemy), BS(enemy->Name(WER)+" schneidet sich die Haende "
	    "auf."), ({enemy, QueryProp(P_WORN)}));
  enemy->Defend(100+random(100), ({DT_PIERCE  }), ([SP_SHOW_DAMAGE:1]), TO);
  return 0;
}
