#include "../def.h"

inherit "std/armour";

int sp;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  sp = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Seelenring");
  SetProp(P_LONG,
    "Du betrachtest Platinring genauer. Er ist mit Runen alter Kraft "
    "verziert, die "+(sp>0?"hellblau":"fahl")+" leuchten. In seinem Inneren "
    "zucken hin und wieder Blitze. Eine Aura der Magie geht von diesem "
    "Meistwerk der Schmiedekunst aus!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Seelenring");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "seelenring", "\ngwenshara_soulring"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PLATINUM:80, MAT_MAGIC:20]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 1);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_REMOVE_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:18]) );

  SetProp(P_INFO, BS("Solche Ringe der alten Zeit koennen eine beachtliche "
	         "Menge astraler Energie speichern, doch sollte man sie "
		 "nicht ueberladen! (syntax: lade seelenring auf, entlade ring)") );

  AddCmd( ({"lade", "lad"}), "cmd_aufladen");
  AddCmd( ({"entlade", "entlad"}), "cmd_entladen");
}


int RemoveFunc(object me)
{
  if(!sp) return 1;
  tell_object(QueryProp(P_WORN), BS("Der Seelenring entlaedt seine astrale Energie!"));
  tell_room(ENV(QueryProp(P_WORN)), BS(QueryProp(P_WORN)->Name(WER)+" wirf kurz von "
	    "einer Aura reinster Magie umgeben!"), ({QueryProp(P_WORN)}));
  sp = 0;
  return 1;
}

int cmd_entladen(string str)
{
  int change;
  notify_fail("Was willst Du entfladen?\n");
  if(!str || str == "") return 0;
  if(!(str == "ring" ||
       str == "seelenring" )) return 0;
  
  if(!QueryProp(P_WORN))
  {
    write(BS("Das funktioniert nur, wenn Du den Ring am Koerper traegst."));
    return -1;
  }

  if(!sp)
  {
    write(BS("In Deinem Seelenring ist keine astrale Kraft geladen!"));
    return -1;
  }

  change=5+random(11);

  if(change>sp) change = sp;
  tell_object(TP, BS("Der Seelenring uebertraegt einen Teil seiner Kraft auf "
		  "Dich."));
  say(BS(TPN+" wird von einer blaeulichen Aura eingehuellt."));
  TP->AddSp(change);
  sp-=change;

  if(sp<0) sp =0;
  return 1;	  
}

int cmd_aufladen(string str)
{
  int change;
  notify_fail("Was willst Du aufladen?\n");
  if(!str || str == "") return 0;
  if(!(str == "ring" ||
       str == "ring auf" ||
       str == "seelenring" ||
       str == "seelenring auf")) return 0;

  if(!QueryProp(P_WORN))
  {
    write(BS("Das funktioniert nur, wenn Du den Ring am Koerper traegst."));
    return -1;
  }

  change = 5+random(11);
  if(TP->QueryProp(P_SP) < change) change = TP->QueryProp(P_SP);
  if(change == 0)
  {
    write(BS("Du hast zu wenig Magie in Dir!"));
    return -1;
  }
  
  tell_object(TP, BS("Du laesst einen Teil Deiner magischen Energie auf den "
	      "Seelenring uebergehen."));
  say(BS(TPN+" wird von einer blaeulichen Aura eingehuellt."));
  TP->AddSp(-change);
  sp+=change;

  if(sp>30+random(21))
  {
    write(BS("Der Ring wurde ueberladen und schleudert seine Kraft in einem "
	  "Astralgewitter in die Umgebung!"));
    say(BS("Von "+TP->Name(WEM)+" gehen astrale Blitze aus!"));
    SetProp(P_KILL_NAME, "Ein Astralgewitter");
    TP->do_damage(sp, TO);
    SetProp(P_KILL_NAME, 0);
    TakeFlaw(sp);
    sp = 0;
  }

  return 1;
}
