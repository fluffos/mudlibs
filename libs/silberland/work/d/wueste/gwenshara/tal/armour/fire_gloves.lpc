#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Haende eines Feuerriesen");
  SetProp(P_LONG,
    "Das sind die zwei Haende eines Feuerriesen. Man sagt, in den Haenden "
    "von Feuerriesen sei das Element Feuer selbst gefangen. Die Haende sind "
    "noch warm und bluten, als seien sie eben erst abgeschlagen worden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerriesenhaende");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haende", "riesenhaende", "feuerriesenhaende", "\ngwehsara_fireglove"})
       );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_FLESH:40, MAT_BLOOD:20, MAT_BONE:20,
			MAT_MAGIC:20]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVES );
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 90);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, P_GUILD:"druidenzirkel"]) );

  SetProp(P_INFO, BS("Diese Haende sind mit dem Element Feuer verbunden.") );
  
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 25);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, FEUER);
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
