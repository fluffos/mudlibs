#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  "Hitze");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kaelteschutz");
  SetProp(P_GENDER, MALE);
  AddId( ({"\ngwenshara_kaelteschutz"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_FIRE );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 100);
}

void SetTemperature(int grad, int zeit)
{
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT: grad ]));
  call_out("end", zeit);
}

void end()
{
  if(objectp(QueryProp(P_WORN)))
    tell_object(QueryProp(P_WORN), BS("Dein Kaelteschutz loest sich auf."));
  remove(1);  
}

string extra_look()
{
  if(!QueryProp(P_WORN)) return "";
  return CAP(QueryProp(P_WORN)->QueryPronoun())+" ist von Flammen umgeben.\n";
}
