#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Wasserwirbelhandschuhe");
  SetProp(P_LONG,
    "Das Paar Wasserwirbelhandschuhe sieht aus wie stroemendes Wasser, das "
    "hin und wieder kleine Wirbel bildet. Sie haben die Farbe des Meeres, "
    "aus dem sie auch kommen. Nur wahrhaft maechtige Druiden koennen solche "
    "Handschuhe erschaffen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Wasserwirbelhandschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"handschuhe", "wasserhandschuhe", "wirbelhandschuhe",
	   "wasserwirbelhandschuhe". "\ngwehsara_waterglove"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WATER:80, MAT_MAGIC:20]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
 
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVES );
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 90);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, P_GUILD:"druidenzirkel"]) );

  SetProp(P_INFO, BS("Diese Haende sind mit dem Element Wasser verbunden.") );
  
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 25);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, WASSER);
}

