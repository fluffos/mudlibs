#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Vulkanhandschuhe");
  SetProp(P_LONG,
    "Das Paar Vulkanhandschuhe bestehen aus schwarzem Stein, der von "
    "gluehenden Rissen durchzogen ist. Steinerne Dornen wachsen an einigen "
    "Stellen aus ihnen. Du spuerst eine starke Verbundenheit mit dem "
    "Element Erz von ihnen Ausgehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Vulkanhandschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"handschuhe", "paar", "vulkanhandschuhe", "\ngwehsara_stoneglove"})
       );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:40, MAT_STONE:20, MAT_MAGIC:40]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVES );
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 110);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, P_GUILD:"druidenzirkel"]) );

  SetProp(P_INFO, BS("Diese Handschuhe sind mit dem Element Erz verbunden.") );
  
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 25);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, ERZ);
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
