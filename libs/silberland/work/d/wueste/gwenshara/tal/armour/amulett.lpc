#include "../def.h"

inherit "std/armour";

string *color = ({"silbern", "rot", "schwarz", "weiss"});
string *save  = ({CL_DEMON, CL_DRAGON, CL_UNDEAD, ""});
int r;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  r = random(sizeof(color));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+color[r]+"es Amulett");
  SetProp(P_LONG,
    "Das Amulett ist aus "+color[r]+"nem Obsidian geschniten. Es stellt "
    "eine von einem Kreis aus Runen umgebene Flamme dar.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Amulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "obsidianamulett", "schutzamulett",
	   "\ngwenshara_protectionamulet"}) );

  SetProp(P_NAME_ADJ,  color[r]);
  AddAdjective( ({color[r]+"en", color[r]+"er", color[r]+"em", color[r]+"es",
		  color[r]+"e"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OBSIDIAN);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:20]) );

  if(save[r] != "")
  {
    if(save[r] != CL_UNDEAD)
      SetProp(P_INFO, BS("Man sagt, "+color[r]+"er Obsidian schuezte gegen "+
		      CAP(save[r])+"en.") );
    else
     SetProp(P_INFO, BS("Man sagt, "+color[r]+"er Obsidian schuezte gegen "+
		      "Untote.") );
  }
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  // Gegen eine bestimmte Klassen schuetzen wir uns mir 100%
  if(enemy->is_class_member(save[r])) return 3;
  return 0;
}
