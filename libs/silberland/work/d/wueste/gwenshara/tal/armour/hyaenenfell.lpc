#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Fell einer Hyaene");
  SetProp(P_LONG,
    "Das Hyaenenfell ist reudig und zerzaust. Als Umhang oder Mantel kann "
    "es aber immer noch gut dienen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hyaenenfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "hyaenenfell"}) );
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:3 ]) );
}
