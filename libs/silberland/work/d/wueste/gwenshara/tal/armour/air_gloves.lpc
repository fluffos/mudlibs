#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Sturmhandschuhe");
  SetProp(P_LONG,
    "Das Paar Sturmhandschuhe besteht aus orkanartig tosender Luft. Ein oder "
    "zwei Mal glaubst Du Blitze durch die Handschuhe zucken gesehen zu haben. "
    "Von ihnen geht ein bestaendiger Wind aus, der ab und anschwillt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Sturmhandschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"handschuhe", "lufthandschuhe", "sturmhandschuhe",
	   "windhandschuhe". "\ngwehsara_airglove"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_AIR:80, MAT_MAGIC:20]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
 
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVES );
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 90);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, P_GUILD:"druidenzirkel"]) );

  SetProp(P_INFO, BS("Diese Haende sind mit dem Element Luft verbunden.") );
  
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 25);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, LUFT);
}

