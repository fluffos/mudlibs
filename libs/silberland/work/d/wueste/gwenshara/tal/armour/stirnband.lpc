#include "../def.h"

inherit "std/armour";

string *array = ({"rot", "gruen", "blau", "pink", "gelb", "violett", "cyan",
		"ockern", "schwarz", "weiss"});
string color;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  color=array[random(sizeof(array))];
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+color+"es Stirnband");
  SetProp(P_LONG,
    "Dieses Stirnband ist nichts weiter besonderes. Es ist aus "+color+"nem "
    "Leinenstoff gefertigt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stirnband");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"band", "stirnband"}) );

  SetProp(P_NAME_ADJ, color+"nes" );
  AddAdjective( ({color+"en", color+"er", color+"em", color+"es", color+"e"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}

