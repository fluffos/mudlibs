#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein brennendes Paar Stiefel");
  SetProp(P_LONG,
    "Diese Stiefel scheinen Dir ganz normale Lederstiefel zu sein. Das "
    "einzige was auffaellig ist, waere da das sie brennen. Irgend ein "
    "wahnsinniger hat diese wunderbaren Lederstiefel angezuendet! So ein "
    "Schuft!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paar Stiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "lederstiefel", "\ngwenshara_burningboots"}) );

  SetProp(P_NAME_ADJ, "brennend" );
  AddAdjective( ({"brennenden","brennender","brennendem","brennendes",
		  "brennende"}) );
  SetProp(P_PLURAL, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_OIL:10, MAT_FIRE:10]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 750);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 4);
  SetProp(P_QUALITY_DECAY, 95);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_FIRE:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:15]) );

  SetProp(P_INFO, BS("Diese Stiefel koennten beim Zertreten der Berserker "
		  "ueble Wunden reissen.") );

  SetProp(P_EFFECTIVE_WC, 150);
  SetProp(P_DAM_TYPE, ({DT_FIRE, DT_BLUDGEON}));
}
