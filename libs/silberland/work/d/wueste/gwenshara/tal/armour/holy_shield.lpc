#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein heiliger Schild");
  SetProp(P_LONG,
    "Dieser Schild wurde aus einem Dir unbekannten weissen Metall "
    "geschmiedet. Auf seiner Parierseite ist das Wappen der Paladine, eine "
    "Rose inmitten zweier gekreuzter Schwerter, eingraviert. Dieser Schild "
    "strahlt eine Aura der Heiligkeit aus, wie Du sie noch nie erlebt hast.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "\ngwenshara_holyshield"}) );

  SetProp(P_NAME_ADJ, "heilig" );
  AddAdjective( ({"heiligen","heiliger","heiligem","heiliges","heilige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_METAL:70, MAT_MISC_HOLY:30]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 20);
  SetProp(P_QUALITY_DECAY, 120);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+
		            ([DT_UNHOLY:1, DT_TERROR:1, DT_HOLY:1,
			      DT_LIGHT:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:20, A_DEX:18]) );

  SetProp(P_INFO, BS("Dieser Schild ist eine geheiligte Ruestung!") );
  SetProp(P_MAGIC, 1);
  SetProp(P_PALADIN_SCHILDPARADE_AC, 25);
  SetProp(P_PALADIN_SPELLCOST, 5);
}
