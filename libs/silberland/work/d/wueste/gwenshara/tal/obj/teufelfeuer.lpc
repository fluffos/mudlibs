#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Flamme aus der Hoelle");
  SetProp(P_LONG,
    "Dieses Feuer kommt aus den Tiefen der Hoelle! Es ist eine etwa "
    "faustgrosse Feuerkugel, die Dich nicht zu verbrennen scheint. Sie "
    "brennt in flackernden Flammen - vielleicht kannst Du Dir ihre Magie "
    "zu nutze machen.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, BS("Du kannst die Magie der Flamme beschwoeren!"));
  SetProp(P_NAME, "Hoellenflamme");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"flamme", "hoellenflamme"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_FIRE );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  AddCmd( ({"beschwoere", "beschwoer"}), "cmd_kaelteschutz");
}

int cmd_kaelteschutz(string str)
{
  object ob;
  notify_fail("Was willst Du beschwoeren?\n");
  if(!str || str == "") return 0;
  if(!(str == "magie" ||
       str == "magie der flamme" ||
       str == "flamme" )) return 0;
  
  if(TP->QueryProp(P_SP)<50)
  {
    write(BS("Deine magische Kraft reicht dazu nicht aus!"));
    return -1;
  }

  if(present("\ngwenshara_kaelteschutz", TP))
  {
    write(BS("Du bist bereits vor Kaelte geschuetzt!"));
    return -1;
  }
  
  write(BS("Die Hoellenflamme vereinigt sich brennend mit Deinem Koerper! "
        "Du fuehlst ungeahnte Hitze in Dir!"));
  say(BS(TPN+" wird von Flammen eingehuellt."));

  ob = clone_object(ARMOUR "kaelteschutz");
  ob->move(TP);
  ob->SetTemperature(10, 300+(random(5*60)));
  ob->DoWear(1);
  remove(1);
  return 1;
}
