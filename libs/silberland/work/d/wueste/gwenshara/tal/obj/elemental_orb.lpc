#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Glaskugel"); 
  SetProp(P_LONG,
    "Diese Glaskugel ist absolut unbesonders.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "In solchen Kugeln lassen sich die Elemente einfangen.");
  SetProp(P_NAME, "Glaskugel");
  SetProp(P_GENDER, MALE);
  AddId( ({"kugel", "glaskugel", "elementarkugel", "\nelemenatal_orb"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS:50, MAT_MAGIC:50]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Diese Kugel willst Du nicht hergeben.");
}

void SetElement(string element)
{
  string long, short;

  write_file(LOG "elemental_orb",
             dtime()+" Element: "+element+" ("+file_name(PO)+")\n");

  if(!(element == "feuer" ||
       element == "wasser" ||
       element == "erde" ||
       element == "luft"))
  {
    raise_error("Ungueltiger Eintrag fuer 'element'");
    return;
  }

  SetProp(P_LONG,
   "In dieser Kugel aus feinstem Glas ist die Essenz des "
   "Elements "+CAP(element)+" gefangen. Es wirbelt wuetend "
   "darin.");
  AddId("\nelemental_orb_"+element);
}

varargs int move(mixed dest, int method)
{
  int ret;
  ret = ::move(dest, method);
  call_out("check", 0);
  return ret;
}

void check()
{
  object *ob;
  ob=filter_objects( deep_inventory(ENV(TO)), "id", "\nelemental_orb");
  ob-=({TO});
  if(sizeof(ob) == 0) return;
  if(!living(ENV(TO))) return;
	  
  if(ENV(ME))
  {
    tell_object(ENV(ME), BS("Durch die Praesenz einer weiteren Glaskugel "
    "in Deinem Inventar entsteht eine elementare Gegenpolie und die Glaskugel "
    "stoesst sich von Dir ab."));
  }
  move(ENV(TO), M_PUT);
}