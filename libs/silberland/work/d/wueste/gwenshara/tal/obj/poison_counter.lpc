#include "../def.h"

inherit "std/thing";

mapping reg;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  reg = ([]);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Waffengiftregistertool");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "WGC");
  AddId("\ngwenshara_tal_wg");
  SetProp(P_INVIS, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  call_out("cycle", 10);
}

void RegisterWeapon(object weapon)
{
  if(!objectp(weapon)) return;

  reg += ([weapon: 10]);
  weapon->SetHitFunc(TO);
  return;
}

void UnregisterWeapon(object ob)
{
  if(!member(reg, ob)) return;
  reg = m_delete(reg, ob);
  return;
}

void cycle()
{
  int i, *vals;
  object ob;

  if(!sizeof(reg))
  {
    remove(1);
    return;
  }

  for(i=0; i<sizeof(reg); ++i)
  {
    if(reg[i, 0] <= 0)
    {
      ob = m_values(reg)[i];
  //    if(objectp(ENV(ME)) && interactive(ENV(ME)))
//      tell_object(ENV(ME), BS("Das Gift auf "+ob->Name()+" ist verbraucht!"));
      UnregisterWeapon(ob);
    }

    vals = m_values(reg);
    reg[i, 0] = --vals[i];
  }

  call_out("cycle", 30);
}

int HitFunc(object enemy)
{
  object gift;
  if(!present("\npoisoned", enemy)) return 0;
  if(random(30)) return 0;
  
  gift = clone_object(OBJ "poison");
  gift->move(enemy);

  if(objectp(ENV(ME)))
  tell_object(ENV(ME), BS(enemy->Name()+" wird von Deiner Waffe vergiftet!"));
  return 0;
}
