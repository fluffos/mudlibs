#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Stueck eines Felsgrates");
  SetProp(P_LONG,
    "Dieses Stueck Stein ist nicht weiter besonders. Es ist relativ fest, "
    " hat eine raue Oberfaleche.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, BS("Der Stein glitzert schwaerzlich. Vielleicht kann man "
                     "die Kristalle aus ihm herausloesen?"));
  SetProp(P_NAME, "Stueck eines Felsgrates");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stueck", "felsgrat", "stueck eines felsgrates", "felsstueck",
           "felsgratstueck", "\ngwenshara_felsgrat"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
}
