#include "../def.h"

inherit "std/thing";

mixed old;
string s;
object target;
int timestamp;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  old = 0;
  s   = "";
  target = 0;
  timestamp = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------

  AddId("\ngwenshara_elemental_curse");
  SetProp(P_NAME, "Der Fluch der Elemente");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
}

void SetTarget(object o)
{
  target = o;
  timestamp = time();
  call_out("damage", 4);
  tell_object(o, BS("Der Fluch der Elemente trifft Dich mit voller Kraft!"));
}

void SetTargetObject(object o)
{
  target = o;
  s      = o->QueryProp(P_SHORT);
  old    = o->QueryProp(P_ITEMD_ELEMENTAL_VALUE);
  timestamp = -1;
  if(!o->QueryProp(P_ARMOUR_TYPE))
  {
    remove(1);
    return;
  }
  call_out("end", 300);
  if(objectp(environment(o)) && living(environment(o)))
    tell_object(environment(o), BS(o->Name(WER)+" wurde vom Fluch der Elemente getroffen!"));
  o->Set(P_SHORT, symbol_function("new_short", this_object()), F_QUERY_METHOD);
  o->SetProp(P_ITEMD_ELEMENTAL_VALUE, -5);
}

string new_short()
{
  return s+" (verflucht)";
}

void damage()
{
  target->Defend(200, ({DT_FIRE, DT_WATER, DT_COLD, DT_POISON, DT_AIR, DT_MAGIC}), ([SP_SHOW_DAMAGE:0]), TO);
  if(time() < timestamp+500)
    call_out("damage", 4);
  else
    remove(1);
}

void end()
{
  target->Set(P_SHORT, 0, F_QUERY_METHOD);
  target->SetProp(P_ITEMD_ELEMENTAL_VALUE, old);  
  remove(1);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(timestamp != -1 && target == victim) remove(1);
}
