#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "GIFT! GIFT! UARK! STIRB!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gift");
  SetProp(P_GENDER, MALE);
  AddId( ({"\npoisoned"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_POISON );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_INVIS, 1);
  SetProp(P_X_ATTR_MOD,([A_STR:-10]));
  
  call_out("ex", 30);
}

void ex()
{
  if(ENV(ME) && interactive(ENV(ME)))
    tell_object(ENV(ME), BS("Du erholst Dich von dem Gift."));
  remove(1);
}
