#include "../def.h"

inherit "std/thing";

string text()
{
  if(file_name(ENV(TO)) == "/d/wueste/gwenshara/tal/room/valley_5")
    return "Du kannst folgendes entziffern:\n am e pa s\n";
  else if(file_name(ENV(TO)) == "/d/wueste/gwenshara/tal/room/valley_6")
    return "Du kannst folgendes entziffern:\nFl  men  s\n";
  else
    return "Ich gehoer hier nicht hin!\n";
}

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein verkohltes Schild");
  SetProp(P_LONG,
    "Dieses Holzschild ist so verkohlt, das seine Aufschrift nur schwer "
    "zu lesen ist.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schild", "holzschild"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOGET, 1);

  AddReadDetail( ({"schild", "holzschild", "verkohltes schild"}), #'text);
}
