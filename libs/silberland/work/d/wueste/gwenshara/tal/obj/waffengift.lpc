#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Tiegel mit Waffengift");
  SetProp(P_LONG,
    "In diesem kleinen Metalltiegel befindet sich eine schwarze Paste. Diese"
    " alchemistische Mischung kann auf einer Waffe aufgetragen verheerende "
    "Wirkung fuer den Gegner haben - Allerdings bleibt sie, ein Mal "
    "aufgetragen, nur begrenzt haltbar!");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, BS("Waffengift kann man auf seine Waffe auftragen. "
		  "(trage gift auf <waffe> auf)"));
  SetProp(P_NAME, "Tiegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"gift", "waffengift", "tiegel", "metalltiegel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL:70, MAT_MISC_POISON:30]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"trage", "trag"}), "cmd_poison");
}

int cmd_poison(string str)
{
  string wn;
  object weapon, gift;
  if(!str || str == "") return 0;
  if(sscanf(str, "gift auf %s auf", wn) != 1) return 0;

  if(!objectp(weapon=present(wn, TP)))
  {
    write(BS("So eine Waffe hast Du nicht bei Dir!"));
    return 1;
  }
  if(!weapon->QueryProp(P_WEAPON_TYPE))
  {
    write(BS("Das ist keine Waffe..."));
    return 1;
  }
  if(weapon->QueryHitFunc())
  {
    write(BS("Auf diese Waffe kannst Du kein Gift auftragen."));
    return 1;
  }

  if(!objectp(gift=present("\ngwenshara_tal_wg", TP))) 
  {
    gift = clone_object(OBJ "poison_counter");
    gift->move(TP);
  }
  
  gift->RegisterWeapon(weapon);

  write(BS("Du traegst eine Dosis Waffengift auf "+weapon->Name(WEN)+
	" auf."));
  say(BS(TPN+" traegt eine schwarze Paste auf eine Waffe auf."));
  remove(1);
  return 1;
}
