#include "../def.h"
#include "/secure/npcmaster.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

int zahl, ab;

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  zahl = 3+random(8);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schwarm gluehender Funken");
  SetProp(P_LONG,
    "Ein schwarm aus gluehenden Funken wirbelt vor Dir auf. Sie pulsieren "
    "und wirken erschreckend lebendig. Durch ihre raschen Bewegungen bist "
    "Du Dir nicht sicher wieviele es tatsaechlich sind, aber Du schaetzt "
    "ihre Zahl auf maximal "+zahl+" Funken.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Funkenschwarm");
  SetProp(P_GENDER, MALE);
  AddId(({"schwarm", "funkenschwarm", "funke", "NOWIMPY", "NO_MUMMY",
	  "NOFALLDOWN", "funken"}));
  SetProp(P_ARTICLE, 1);
  AddClass( ({CL_FLYING}) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5+random(16));

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  SetProp(P_HANDS, ({" gluehend",
                    100,
                    ({DT_FIRE})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 30); //Bewgungsraduis :)
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, zahl);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@WER faellt durch den Schwarm hindurch.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:      0.2, DT_WATER:       1.0,
       DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.3,
       DT_SOUND:    -0.2, DT_LIGHT:    -0.1, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.3, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:     -1.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.5, DT_WHIP:       -0.5,
       DT_RIP:      -0.5,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM "lava", ROOM "tal", ROOM "wald", ROOM "hoehle",
                           ROOM "himmel", ROOM "wasser", ROOM "road" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tal_1");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
 

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "*schwirr*");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  AddSpell(3, 200,
    "Ein Funke brennt sich in Dich ein!\n",
    "Ein Funke brennt sich in @WEN ein!\n",
     ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 100, DS_BLIND,
    "Ein Funke springt Dir in die Augen.\n",
    "Ein Funke springt @WEM in die Augen.\n");

  AddSpell(3, 300,
    "Ein Funke expoldiert und verbrennt Dich.\n",
    "Ein Funke explodiert vor @WEM\n",
    ({DT_FIRE, DT_EXPLOSION}), ([SP_SHOW_DAMAGE:1]));

  if(QueryProp(P_LEVEL) > 15)
    AddSpell(1, 600,
      "Einer der Funken verbrennt Dich an einer empfindlichen Stelle!\n",
      "Einer der Funken verbrennt @WEN an einer empfindlichen Stelle!\n",
      ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  ab = (int) (QueryProp(P_MAX_HP)/zahl);
  if(QueryProp(P_LEVEL) < 15) SetProp(P_NO_SCORE, 1);
}

void Attack(object enemy)
{
  SetProp(P_NAME, "Funke");
  ModifySkillAttribute(TO, SA_SPEED, zahl*100, 2);
  ::Attack(enemy);
  SetProp(P_NAME, "Funkenschwarm");
  return;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int r;
  r = ::Defend(dam, dam_type, spell, enemy);
  if((int) (QueryProp(P_HP)/ab) != zahl && QueryProp(P_HP) > 0)
  {
    tell_room(ENV(TO), BS("Ein Funke verglueht."));
    zahl = (int) (QueryProp(P_HP)/ab);
  }
  return r;
}

int _query_spellrate()
{
  return zahl*5;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  if(!random(10))
  {
    CLONEME(OBJ "funke");
  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(!touch) return;
  tell_object(TP, BS("Du verbrennst Dich an dem Schwarm!"));
  tell_room(ENV(TP), BS(TPN+" schreit laut auf!"), ({TP}));
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
