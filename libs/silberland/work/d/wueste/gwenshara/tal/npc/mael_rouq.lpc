#include "../def.h"

inherit STD "std_tal_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Mael'Rouq das Lavaelementar");
  SetProp(P_LONG,
    "Dies ist der legendaere Mael'Rouq. Er ist eine riesige Gestalt, die aus "
    "gluehendem Gestein besteht. Es heisst, er sei der Fuerst der "
    "Lavaelementare. Seine golemartige Form, die dich an ein Erzelementar "
    "erinnert, floesst Dir Angst ein.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mael'Rouq");
  SetProp(P_GENDER, MALE);
  AddId(({"elementar", "lavaelemanter", "\ngwenshara_maelrouq", 
          "NOWIMPY", "mael", "rouq", "maelrouq", "mael'rouq"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit gluehenden Haenden",
                    QueryProp(P_HANDS)[1]+200,
                    ({DT_BLUDGEON, DT_FIRE})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 300);
  SetProp(P_WEIGHT, 2000000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_BODY, QueryProp(P_BODY)+200);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:      0.1, DT_WATER:       0.1,
       DT_AIR:      -0.5, DT_TERROR:   -0.5, DT_HOLY:        0.1,
       DT_UNHOLY:   -0.5, DT_MAGIC:    -0.5, DT_SLASH:      -0.9,
       DT_BLUDGEON: -0.9, DT_PIERCE:   -0.9, DT_SQUEEZE:    -0.9,
       DT_WHIP:     -0.9, DT_RIP:      -0.9,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " zerfaellt zu einem gluehenden Steinhaufen.\n");
  SetProp(P_NOCORPSE, 1);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

  AddSpell(1, 300,
    "Mael'Rouq verflucht Dich mit dem Fluch der Elemente.\n",
    "Mael'Rouq belegt @WEN mit dem Fluch der Elemente.\n",
     DT_MAGIC, "curse", ([SP_SHOW_DAMAGE:1]));

  AddSpell(7, 700,
    "Mael'Rouq zermalmt Dich mit seinen Faeusten.\n",
    "Mael'Rouq zermalmt @WEN mit seinen Faeusten.\n",
    ({DT_BLUDGEON, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

 /* Das was er kann reicht =)
  * AddSpell(1, 10,
    "Mael'Rouq stampft mit einem Fuss auf\nDie Erde bebt.\n",
    "Mael'Rouq stampft mit einem Fuss auf\nDie Erde bebt.\n",
    ({DT_MAGIC}), "stun"); */

}

void curse(object enemy, int damage, mixed dam_type)
{
  object curse;

  if(!random(2))
  {
    curse = clone_object(OBJ "curse");
    curse->SetTarget(enemy);
    curse->move(enemy, M_NOCHECK);
  }
  
  if(!random(3) && enemy->QueryProp(P_GUILD) == "druidenzirkel")
  {
    curse = clone_object(OBJ "curse");
    curse->SetTargetObject(enemy->QueryProp(P_ARMOURS)[random(
			          sizeof(enemy->QueryProp(P_ARMOURS)))]);
    curse->move(enemy, M_NOCHECK);
  }
}

void stun(object enemy, int damage, mixed dam_type)
{
  object *e;
  int i;
  e=PresentEnemies();
  
  for(i=0; i<sizeof(e); ++i)
    e[i]->SetProp(P_PARALYZED, ([ PARALYZE_TIME:3,
			          PARALYZE_MSG: "Die Kraft des Erzes haelt Dich fest!\n",
				  PARALYZE_MSG_OTHER: "",
  			          PARALYZE_END_OTHER: ""]));
}


void die(int poisondeath)
{
  object orb;
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");
  if(present("\ndragon_lore", (QueryProp(P_KILLER)||TP)))
  {
    orb = clone_object(OBJ "elemental_orb");
    orb->SetElement("erde");
    orb->move(ENV(TO));
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object o, *inv;
  int i;
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
