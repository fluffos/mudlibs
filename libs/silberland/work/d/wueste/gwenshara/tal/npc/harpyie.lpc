#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Tibesti-Harpyie");
  SetProp(P_LONG,
    "Das ist eine Tibesti-Harpyie. Sie ist zerzaust und scheint so wild zu "
    "sein, dass sie Dir am liebsten das Herz aus deinem Leid ressen wuerde "
    "und es, waehrend es pulsiert, noch essen will.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Tibesti-Harpyie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"harpyie", "tibesti-harpyie"}));
  AddClass( ({CL_HUMAN, CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit ihren scharfen Klauen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Fluegelungeheuer");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 200,
    "Die Tibesti-Harpyie kreischt Dich laut an.\n",
    "Die Tibesti-Harpyie kreischt @WEN laut an.\n",
     DT_SOUND, ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" starrt Dich gierig an.\n",
    Name(WER, 1)+" kreischt laut.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(ARMOUR "stirnband" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    default:
      call_out("reaction", 0, TP,
        " stuerzt sich kreischend auf Dich!",
        " stuerzt sich kreischend auf "+TPN);
      Kill(TP);
      break;

  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
