#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";
int speien, air;
object minnion;

varargs void shoot(object *enem);

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  speien=0;
  minnion=0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Aleysztranim die Glutrote");
  SetProp(P_LONG,
    "Aleysztranim ist selbst fuer eine Drachin riesig. Ihr Koerper besteht "
    "aus geschwaerztem Vulkangestein und ist von rot gluehenden Rissen "
    "durchzogen. Die Augen der Drachin sind Flammen aus den tiefen der Erde. "
    "Durch ihre verbrannten Schuppen kannst Du ein Herz aus gluehendem Eisen "
    "fluessiges Gestein durch die Adern des Ungetuems pumpen sehen. Aleysztr "
    "anims Fluegel sind lodernde Flammen, die von einem Skelett aus Obsidian "
    "gehalten werden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Aleysztranim");
  SetProp(P_GENDER, FEMALE);
  AddId(({"aleysztranim", "lavadrache", "drache", "\nlavadrache"}));
  AddClass( ({CL_DRAGON}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("lavadrache");

//--Eigenschaften----------------------------------------------------------

  create_default_dragon(50, 11, 2);

  SetProp(P_HANDS, ({" mit feuergehaerteten Klauen",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_RIP})
                    }) );

  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 10000);
  SetProp(P_WEIGHT, 75000000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 75);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" verbrennt @WEN mit ihrem Atem.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:    -0.95, DT_COLD:      0.2, DT_WATER:       0.3,
       DT_AIR:       0.0, DT_LIGHTNING:-0.2, DT_EXPLOSION:  -0.3,
       DT_POISON:   -0.2, DT_MAGIC:    -0.5, DT_SLASH:      -0.1,
       DT_BLUDGEON: -0.1, DT_PIERCE:   -0.1, DT_SQUEEZE:    -0.1, 
       DT_WHIP:     -0.1, DT_RIP:      -0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "gleitet auf maechtigen Schwingen herein");
  SetProp(P_MSGOUT, "gleitet auf maechtigen Schwingen");
  SetProp(P_MMSGIN, "entsteht aus einem Flammeninferno");
  SetProp(P_MMSGOUT, "verbrennt zu einem Haufen Asche");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " erlischt und faellt krachend zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Flammen der Erde werden Euch vergehen lassen, %s!");
  SetProp(P_KILL_MSG, "Das Feuer verzehrt alle, die sich gegen es stellen!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "blickt Dich aus brenneden Augen. Du verstummst.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 95);

  AddSpell(1, 650,
    "Aleysztranim laesst Dein Blut kochen.\n",
    "Aleysztranim kocht @WESSEN Blut.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_MASS_FEAR,
    Name(WER,1) + " verstroemt Drachenfurcht!\n",
    Name(WER,1) + " verstroemt Drachenfurcht!\n" );

  AddDefaultSpell(1, 300, DS_DRAIN_MANA,
    "Aleysztranim entzieht Dir geistige Energie.\n",
    "Aleysztranim feuert einen blauen Strahl auf @WEN.\n");

  AddDefaultSpell(1, 450, DS_MASS_DAMAGE,
    "Die Welt explodiert um Dich herum.\n",
    "Die Welt explodiert um Dich herum.\n",
    ({DT_FIRE, DT_EXPLOSION}));

  AddSpell(1, 200,
    "Aleysztranim huellt Dich in eine Flammenkugel.\n",
    "Aleysztranim huellt @WEN in eine Flammenkugel.\n",
    ({DT_FIRE, DT_MAGIC}));
 
}

void die(int poisondeath)
{
  int i;
  object *pl, o;
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  tell_room(ENV(TO), BS("Eine elementare Energie fegt an Dir vorbei!"));
  pl=filter_array(all_inventory(ENV(TO)), "interacitve");
  for(i=0; i<sizeof(pl); ++i)
    if(present("\ngwenshara_orb_fire", pl[i]) &&
       present("\ngwenshara_orb_water", pl[i]) &&
       present("\ngwenshara_orb_earth", pl[i]) &&
       present("\ngwenshara_orb_air", pl[i]))
    {
      tell_object(pl[i], BS("Die elementaren Kugeln vereinigen sich!"));
      o = clone_object(OBJ "elemental_sliver");
      if(o->move(pl[i], M_GET) != 1)
        o->move(ENV(TO), M_PUT);
    }
  domainshout(BS("Aleysztranim die Glutrote wurde vernichtet!"));

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
  speien = 0;
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  int hp, max_hp;
  hp = QueryProp(P_HP);
  max_hp = QueryProp(P_MAX_HP);

  if(hp < (max_hp/4)*3 && speien==0)
  {
    speien++;
    enemy->Defend(700, ({DT_FIRE}), 0, TO);
    tell_object(enemy, BS(TO->Name()+" speit fluessiges Gestein nach Dir."));
    tell_room(ENV(TO), BS(TO->Name()+" speit fluessiges Gestein nach "+enemy->Name()+"."));
  }

  else if(hp < max_hp/2 && air == 0)
  {
    tell_room(ENV(TO), BS(TO->Name()+" erhebt sich mit maechtigen Fluegelschlaegen in "
	      "den Himmel."));
    air=1;
    shoot(QueryEnemies()[0]);
    tell_object(find_player("gwenshara"), move(ROOM "himmel_dragon", M_SILENT|M_NOCHECK)+"\n");
  }

  else if(hp < max_hp/4 && speien == 1)
  {
    speien++;
    enemy->Defend(700, ({DT_FIRE}), 0, TO);
    tell_object(enemy, BS(TO->Name()+" speit fluessiges Gestein nach Dir."));
    tell_room(ENV(TO), BS(TO->Name()+" speit fluessiges Gestein nach "+enemy->Name()+"."));
  }

 /* else if(!objectp(minnion) && !random(3))
  {
    tell_room(ENV(TO), BS(TO->Name()+" ruft ein Lavaelementar zu Hilfe."));
    minnion = clone_object(NPC "minnion");
    minnion->move(ENV(TO));
    minnion->Kill(enemy);
  }
  
  else if(objectp(minnion) && !random(10))
  {
    minnion->Flammentod(enemy);
  }*/

  return ::Defend(dam, dam_type_list, spell, enemy);
}

void shoot(object *e)
{
  int i, x;
  string f;
  if(air!=1) return;
  if(!sizeof(e)) return;
  
  f=file_name(ENV(e[0]));
  x = strstr(f, "/d/wueste/gwenshara/tal/room/", 0);

  for(i=0; i<sizeof(e); ++i)
  {
    if(x != -1 && !present(getuid(e[i]), ENV(ME)))
    {
      tell_object(e[i], BS("Ein Flammenstrahl trifft Dich."));
      tell_room(ENV(e[i]), BS("Ein Flammenstrahl trifft "+e[i]->Name(WEN)+"."), 
	        ({e[i]}));
      e[i]->Defend(300, DT_FIRE, ([SP_SHOW_DAMAGE:1]), TO);
    }
  }

  call_out("shoot", 2, e);
  return;
}
