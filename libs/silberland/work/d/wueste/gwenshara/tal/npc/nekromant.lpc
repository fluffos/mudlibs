#include "../def.h"

inherit "/p/std/npc/necromancer_npc";

string *race = ({"Mensch", "Elf", "Hobbit", "Zwerg",
		  "Dunkelelf", "Oger", "Troll", "Fee",
		  "Ork", "Goblin"});
string *class  = ({CL_HUMAN, CL_ELF, CL_HOBBIT, CL_DWARF, CL_DARKELF, CL_OGRE,
		   CL_TROLL, CL_FAIRY, CL_ORC, CL_GOBLIN});
string *silben = ({"Yak", "Hai", "Yol", "Sark", "Zirm", "Njarg", "Zum", "Fri",
		   "Kring", "Sal", "Por", "Nirg", "Son", "Ark", "Brim", "Ras", 
		   "Siff", "Saen", "Mor", "Pos", "Ron", "Ra", "Am", "Hiin", 
		   "Tar", "Nar", "Vi", "Ter", "Vel", "Bal", "Tha", "Op", 
		   "Mi", "Stro", "Dan", "Nde", "Zun", "Sha", "Ain", "Ron",
		   "Wod", "Pro", "Ang", "Rox", "Fey", "Ar"});

void create()
{
  int r, gender;
  mapping gt;
  string title, name;
  if(!is_clone(TO)) return;

  ::create();
  r = random(sizeof(race));
  create_necromancer_npc(20+random(16), 3+random(5), 2+random(6), 1);
  gender = (random(2)>0?MALE:FEMALE);
  if(gender == MALE)
    gt = call_other("/gilden/nekromanten", "QueryProp", P_GUILD_MALE_TITLES);
  else
    gt = call_other("/gilden/nekromanten", "QueryProp", P_GUILD_FEMALE_TITLES);

  title = gt[QueryProp(P_GUILD_LEVEL)];
  name  = silben[random(sizeof(silben))]+(random(2)>0?"-":"'")+
	  silben[random(sizeof(silben))];
//--Beschreibungen---------------------------------------------------------

  SetProp(P_GENDER, gender);
  SetProp(P_SHORT, name+" "+title);
  SetProp(P_LONG,
    name+" ist "+(gender==MALE?"ein Nekromant":"eine Nekromantin")+
   " der Rasse "+race[r]+". "+CAP(QueryPronoun(WER))+" hat sich mit den "
   "Maechten des Boesen und der Dunkelheit eingelassen um unendliche Macht "
   "zu erlangen! Hier sucht "+QueryPronoun(WER)+" nach geeigneten Opfern "
   "fuer ihre dunklen Rituale!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, name);
  AddId(({"nekromant", "nekromantin", lower_case(name)}));
  AddClass( ({class[r]}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_HANDS, ({" mit blossen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  SetProp(P_RACE, race[r]);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM "lava", ROOM "tal", ROOM "wald", ROOM "hoehle",
                           ROOM "himmel", ROOM "wasser" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tal_1");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird kreischend in die Niederhoellen geschleudert.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "Wir Nekromanten sterben nie, %s! Merk Dir das!");
  SetProp(P_KILL_MSG, "Gegen die Macht der Finsternis kannst auch Du, %s, "
		      "nicht bestehen!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" spaeht nach Opfern.\n",
    Name(WER, 1)+" schleicht umher.\n",
    Name(WER, 1)+" sieht Dich abschaetzend an.\n",
    Name(WER, 1)+" fluestert dunkle Worte.\n",
    Name(WER, 1)+" schleicht sich an Dich heran.\n",
    Name(WER, 1)+" beschwoert gruenen Nebel.\n",
    Name(WER, 1)+" ruft seltsam klingende Worte.\n",
    Name(WER, 1)+" wird von kaltem Wind umweht.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
   // Dolch je nach Stufe
  if(QueryProp(P_LEVEL) < 24)  CLONEME("/p/weapon/knife/hiebdolch");
  else if(QueryProp(P_LEVEL) > 25 && QueryProp(P_LEVEL) < 31) 
    CLONEME("/p/weapon/knife/langdolch");
  else if(QueryProp(P_LEVEL) > 30)
    CLONEME("/p/weapon/knife/meucheldolch");
  command("zuecke dolch");

  if(QueryProp(P_LEVEL) > 26 && !random(10))
    CLONEME(ARMOUR "nekro_robe" );
  if(QueryProp(P_LEVEL) > 32 && !random(15))
    CLONEME(OBJ "waffengift");
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

int query_size()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 290;
  if(QueryProp(P_RACE) == "Zwerg" || QueryProp(P_RACE) == "Hobbit" ||
     QueryProp(P_RACE) == "Goblin")
    return 120;
  if(QueryProp(P_RACE) == "Fee") return 40;
  else return 180;
}

int _query_weight()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 185000;
  if(QueryProp(P_RACE) == "Fee") return 20000;
  else return 75000;
}
