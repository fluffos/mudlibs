#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Hyaene");
  SetProp(P_LONG,
    "Vor Dir steht eine zerrupft aussehende Hyaene. Sie ist ausgehungert "
    "und hat ein gieriges Funkeln in ihren Augen. Lauernd schleicht sie "
    "um Dich herum und wartet nur darauf das Du Schwaeche zeigst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hyaene");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hyaene", "katze", "raubkatze"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);


//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit ihren Fangzaehnen",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE, DT_RIP})
                    }) );

  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN gierig auf.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1,
       DT_SOUND:     0.1, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:   -0.4, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:      -0.1,
       DT_MIND:     -0.3, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:5,T_RANGE_MAX:60]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM "valley" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "valley_3");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(2, 200,
    "Die Hyaene beisst Dich in den Fuss.\n",
    "Die Hyaene beisst @WEN in den Fuss.\n",
     ({DT_PIERCE, DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 300,
    "Die Hyaene greift Dich wild an.\n",
    "Die Hyaene greifft @WEN wild an.\n",
     ({DT_PIERCE, DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_MASS_DAMAGE,
         "Die Hyaene verfaellt in einen Blutrauch und beisst wild um sich!\n",
         "Die Hyaene verfaellt in einen Blutrauch und beisst wild um sich!\n", 
	 ({DT_RIP, DT_PIERCE}));
  

//--Chats------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" schleicht um Dich herum.\n",
    Name(WER, 1)+" knurrt leise.\n",
    Name(WER, 1)+" wuehlt im Sand.\n",
    Name(WER, 1)+" jagt einer Eidechse nach.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "hyaenenfell" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
