#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Klapperschlange");
  SetProp(P_LONG,
    "Diese Klapperschlange sieht nicht gerade erfreut aus. Sie sieht aus, "
    "als haette man sie gerade aufgeweckt. Mit ihrer Hornrassel am Schwanz"
    "ende klappert sie bedrohlich.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Klapperschlange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", "klapperschlange"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5);

  SetProp(P_HANDS, ({" mit ihren Giftzaehnen",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE, DT_POISON})
                    }) );

  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 22);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann @WEN nicht tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.2, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:    -0.3, DT_LIGHT:    -0.1, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:   -0.2, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.1, DT_BLUDGEON:    0.1,
       DT_PIERCE:    0.1, DT_SQUEEZE:   0.1, DT_WHIP:        0.1,
       DT_RIP:       0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " rollt sich tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Sssssssssss!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddDefaultSpell(1, 1, DS_POISON,
    Name(WER,1) + " schlaegt ihre Giftzaehne in Dich!\n",
    Name(WER,1) + " schlaegt ihre Giftzaehne in @WEN!\n" );
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}


