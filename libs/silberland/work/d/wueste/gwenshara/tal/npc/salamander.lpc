#include "../def.h"

inherit STD "std_tal_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Riesensalamander");
  SetProp(P_LONG,
    "Der Riesensalamander ragt riesenhaft (wie auch sonst?) vor Dir auf. "
    "Er hat die Groesse von zwei Trollen und geht aufrecht auf seinen zwei "
    "Hinterhaxen. Eine Krone aus Flammen ziert sein hocherhobenes Haupt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Riesensalamander");
  SetProp(P_GENDER, MALE);
  AddId(({"salamander", "riesensalamander", "echse", "eidechse", 
	  "riseneidechse", "\ngwenshara_azzitai"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15+random(5));

  SetProp(P_HANDS, ({" mit seinen Pranken",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 600);
  SetProp(P_WEIGHT, 350000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:      0.3, DT_WATER:       0.4,
       DT_EXPLOSION:  -0.3
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden und seine Flammenkrone erlischt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "*ZISCH*");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 10);

  AddSpell(1, 300,
    "Der Riesensalamander speit einen Flammenstrahl nach Dir.\n",
    "Der Riesensalamander speit einen Flammenstrahl nach @WEM.\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 300,
    Name(WER,1) + " schlaegt Dich mit beiden Pranken!\n",
    Name(WER,1) + " schlaegt @WEN mit beiden Pranken!\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" faucht.\n",
    Name(WER, 1)+" atmet eine kleine Rauchwolke aus.\n",
    "Duenne Rauchfahnen steigen aus den Nuestern des Salamanders auf.\n",
    Name(WER, 1)+" gibt einen bruellenden Laut von sich.\n",
    Name(WER, 1)+" schnuppert in der Luft.\n",
    Name(WER, 1)+" speit einen Flammenstrahl.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(ARMOUR "salamanderhaut" );
  command("trage alles");
}
