#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit STD "std_tal_npc";
inherit "/std/npc/spells";
#include "/p/std/npc/druid_npc.h"

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Xerin der Herr der Flammen");
  SetProp(P_LONG,
    "Der Zwerg vor Dir strahlt eine aussergewoehnliche Macht aus. Er ist "
    "ein alter Vertreter seiner Art. Sein Haar ist schlohweiss, ebenso "
    "sein Bart. Kohleschwarze Augen blicken Dich unter buschigen "
    "Augenbrauen an. Ab und an zuengeln Flammen in allen erdenklichen Farben"
    " aus seinem Bart.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Xerin");
  SetProp(P_GENDER, MALE);
  AddId(({"xerin", "herr", "zwerg", "feuerdruide", "herr der flammen", "feuer"
          "zwerg", "NOWIMPY", "NOCONTROL", "QUESTOBJ"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_druid(FEUER, 28, 16);

  SetProp(P_HANDS, ({" mit starken Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das brauch ich nicht!\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:      0.2, DT_WATER:       0.3,
       DT_AIR:      -0.1, DT_EXPLOSION:  -0.2, DT_MAGIC:      -0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt mit einer letzten Beschwoerung zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Die Elemente werden Rache an Dir ueben, %s!");
  SetProp(P_KILL_MSG, "Niemand widersteht der uralten und reinigenden  Kraft "
                      "des weigen Seelenfeuers!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, ({"nickt zustimmend.\n",
                          "sagt: Davon weiss ich nichts.\n",
                          "sagt: Ich werde mich erkundigen!\n",
                          "sagt: Du wirst die Antwort in den Elementen finden.\n",
                          "sagt: Tut mir leid, da kann ich dir nicht helfen.\n"}));
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" brummt etwas in seinen Bart.\n",
    Name(WER, 1)+" blickt sich um.\n",
    Name(WER, 1)+" schaetzt Dich erfolgreich ein.\n",
    Name(WER, 1)+" beschwoert eine kleine Flamme.\n",
    Name(WER, 1)+" murmelt alte Worte.\n",
    Name(WER, 1)+" spricht zu den Flammen.\n",
    Name(WER, 1)+" laesst einen Ring aus Flammen entstehen.\n",
    Name(WER, 1)+" schliesst kurz die Augen.\n",
   }) );

  SetAttackChats(5,
  ({Name(WER, 1)+" bruellt wuetend auf!\n",
    Name(WER, 1)+" laesst Feuer auf seine Feinde regnen!\n",
    Name(WER, 1)+" ruft den Zorn der Elemente herbei!\n",
    Name(WER, 1)+" bringt Dein Blut zum Kochen!\n",
    Name(WER, 1)+" sammelt seine Energien!\n",
    Name(WER, 1)+" erhitzt die Luft.\n",
    Name(WER, 1)+" brennt ein Loch in Deine Ruestung.\n",
    Name(WER, 1)+" schleudert einen Flammenstrahl.\n",
    Name(WER, 1)+" laesst den Boden brennen.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/helm/hut");
  CLONEME(ARMOUR "amulett");
  CLONEME(ARMOUR "flameboots");
  command("trage alles");

  SetProp(P_BODY, QueryProp(P_BODY)+100);
}

varargs void die(int pd)
{
  if(QueryProp(P_KILLER))
    if(TEMPELQ->IsQuester(QueryProp(P_KILLER)))
      if(present("\ngwenshara_waterboots", TO))
         present("\ngwenshara_waterboots", TO)->_go_questmode();
  ::die(pd);
  return;
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
   case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich streng an.",
        "blickt "+TPN+" streng an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt "+TPN+" guetig an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Dafuer bin ich schon zu alt!",
        "sagt: Dafuer bin ich schon zu alt!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verwuschelt Dein Haar.",
        "verwuschelt "+TP->Name(WESSEN)+" Haar.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
