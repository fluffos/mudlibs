#include "../def.h"

inherit STD "std_tal_npc";

int art;
string *pre = ({"kleiner", "\b", "grosser"});

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  art = random(3);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+pre[art]+" Feuerwusel");
  SetProp(P_LONG,
    "Der Feuerwusel ist eine handgrosse Feuerkugel, die Dir Licht spendet. "
    "Dieses Exemplar wurde von keinem Druiden beschworen, sondern ist ein "
    "in Freiheit Lebendes!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerwusel");
  SetProp(P_GENDER, MALE);
  AddId(({"wusel", "feuerwusel"}));
//  AddClass( ({CL_ELEMENTAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(1+random(5)+(art*5));

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  SetProp(P_HANDS, ({" mit Flammen",
                    QueryProp(P_HANDS)[1],
                    ({DT_FIRE})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 30*(art));
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,art*10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -(art*0.1), DT_COLD:      0.1, DT_WATER:       1.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.2,
       DT_SOUND:    -0.3, DT_LIGHT:    -0.5, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:      -0.1,
       DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verglueht.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Naechstes mal brenne ich Dich nieder!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, art*10);

  AddSpell(2, 1+art*100,
    "Der Feuerwusel verbrennt Dich.\n",
    "Der Feuerwusel verbrennt @WEN.\n",
     ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 1+art*200,
    "Der Feuerwusel wirft einen Feuerball nach Dir!\n",
    "Der Feuerwusel wirft einen Feuerball nach @WEM!\n",
     ({DT_FIRE, DT_EXPLOSION}), ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" knistert.\n",
    Name(WER, 1)+" brennt vor sich hin.\n",
    Name(WER, 1)+" flackert.\n",
    Name(WER, 1)+" knackt.\n",
    Name(WER, 1)+" glueht herum.\n",
    Name(WER, 1)+" wuselt im Kreis.\n",
    Name(WER, 1)+" huepft auf und ab.\n",
   }) );
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(!touch) return;
  tell_object(TP, BS("Du verbrennst Dich an dem Feuerwusel!"));
  tell_room(ENV(TP), BS(TPN+" schreit laut auf!"), ({TP}));
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
