#include "../def.h"

inherit "/p/std/npc/nekro_npc.lpc";
inherit "/std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine verkohlte Leiche");
  SetProp(P_LONG,
    "Die Leiche dieses ehemaligen Abenteurers ist schwarz und verbrannt. "
    "Durch ihren fruehzeitigen Tod sucht die in ihrem Koerper gefangene "
    "Seele des Abenteurers nun nach Erloesung.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Leiche");
  SetProp(P_GENDER, FEMALE);
  AddId(({"leiche", "abenteurer", "untoter"}));
  AddClass( ({CL_UNDEAD}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15+random(11));

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  SetProp(P_HANDS, ({" mit ihren verbrannten Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:      0.2, DT_WATER:       0.3, 
       DT_EXPLOSION:  -0.1
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM "lava", ROOM "tal", ROOM "wald", ROOM "hoehle",
                           ROOM "himmel", ROOM "wasser", ROOM "road" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tal_1");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Erloesung!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(1, 300,
    "Die verkohlte Leiche bruellt Dich mit ihrem heissen Atem an!\n",
    "Die verkohlte Leiche bruellt @WEN mit ihrem heissen Atem an!\n",
     ({DT_SOUND, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 400,
    "Die verkohlte Leiche atmet einen Strahl Feuer auf Dich aus!\n",
    "Die verkohlte Leiche atmet einen Strahl Feuer auf @WEN aus!\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_CURSE_ARMOUR,
    Name(WER,1) + " schleudert einen ueblen Fluch gegen Dich!\n",
    Name(WER,1) + " schleudert einen ueblen Fluch gegen @WEN!\n" );

  AddSpell(1, 300,
    "Die verkohlte Leiche packt Dich an der Kehle!\n",
    "Die verkohlte Leiche packt @WEN an der Kehle!\n",
    ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" stoehnt gequaelt.\n",
    Name(WER, 1)+" schlurft herum.\n",
    Name(WER, 1)+" aechzt.\n",
    Name(WER, 1)+" blickt Dich aus gebrochenen Augen an.\n",
    Name(WER, 1)+" heult auf.\n",
    Name(WER, 1)+" gibt unheimliche Laute von sich.\n",
   }) );
 
//--Ausruestung------------------------------------------------------------
  SUID;
  if(!random(5)) CLONEME("/p/armour/armour/bronzepanzer");
  if(QueryProp(P_LEVEL) > 19 && !random(7)) CLONEME("/p/armour/amulet/amulett");
  if(QueryProp(P_LEVEL) > 20 && !random(15))
  {
    switch(random(9))
    {
      case 1: CLONEME(ARMOUR "armschienen_low"); break;
      case 2: CLONEME(ARMOUR "guertel_low"); break;
      case 3: CLONEME(ARMOUR "stiefel_low"); break;
      case 4: CLONEME(ARMOUR "umhang_low"); break;
      case 5: CLONEME(ARMOUR "handschuhe_low"); break;
      case 6: CLONEME(ARMOUR "helm_low"); break;
      case 7: CLONEME(ARMOUR "ring_low"); break;
      case 8: CLONEME(ARMOUR "trousers_low"); break;
      default: CLONEME(ARMOUR "shield_low"); break;
    }
  }
  
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  tell_room(ENV(TO), BS(Name(WER)+" bruellt auf!"));
  Kill(TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
