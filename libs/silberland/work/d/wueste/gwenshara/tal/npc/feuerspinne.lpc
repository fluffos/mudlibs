#include "../def.h"

inherit STD "std_tal_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Feuerspinne");
  SetProp(P_LONG,
    "Die Feuerspinne ist eine uebergrosse Spinne mit gelb-roter Zeichnung "
    "am Ruecken. Ihren Namen erhielt sie, weil diese Art nur in der Naehe "
    "grosser Feuerquellen und Braende zu finden ist.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "feuerspinne"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(8);

  SetProp(P_HANDS, ({" mit ihren Beisszangen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP})
                    }) );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.1, DT_WATER:       0.2]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " bricht in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );

//--Ausruestung------------------------------------------------------------

  SUID;
//Spinnenseide? -> im die()
}

//--die()------------------------------------------------------------------

varargs void die( int poisondeath )
{
  if(QueryProp(P_KILLER) && !random(3)) 
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
  ::die(poisondeath);
  return;
}
//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(touch) Kill(TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
