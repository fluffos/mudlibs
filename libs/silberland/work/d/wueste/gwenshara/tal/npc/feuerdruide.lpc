#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


inherit STD "std_tal_npc";
//inherit "/p/std/npc/druid_npc"; -> Geht nicht mit 2 NPC erben!
inherit "/std/npc/spells";
#include "/p/std/npc/druid_npc.h"

string *race_a = ({"menschlich", "elfisch", "hobbitisch", "zwergisch",
		  "dunkelelfisch", "ogrisch", "trollisch", "feeisch",
		  "orkisch", "goblinisch", "untot", "skelettiert"});
string *class  = ({CL_HUMAN, CL_ELF, CL_HOBBIT, CL_DWARF, CL_DARKELF, CL_OGRE,
		   CL_TROLL, CL_FAIRY, CL_ORC, CL_GOBLIN, CL_UNDEAD,
		   CL_SKELETON});
string *title  = ({" meditiert hier", " beschwoert hier elementare Kraft",
		   "", " vereinigt sich hier mit dem Feuer"});
int r;

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  r = random(sizeof(race_a));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+race_a[r]+"er Feuerdruide"+
		    title[random(sizeof(title))]);
  SetProp(P_LONG,
    "Der "+race_a[r]+" Feuerdruide ist einer der Meister seiner Zunft. "
    "Er hat sich hier eingefunden um sein Element absolut zu verstehen und "
    "um sich darin zu versenken. In langer Meditation hat er die Lehren "
    "des wahren Feuers erkannt und wird sie auch gegen Dich einsetzen!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerdruide");
  SetProp(P_GENDER, MALE);
  AddId(({"druide", "feuerdruide", "elementarist", class[r]}));
  AddClass( ({class[r]}) );
  SetProp(P_ARTICLE, 1);

  SetProp(P_NAME_ADJ, race_a[r]);
  AddAdjective( ({race_a[r]+"er", race_a[r]+"e", race_a[r]+"es",
		  race_a[r]+"en", race_a[r]+"em"}));

//--Eigenschaften----------------------------------------------------------

  create_default_druid(FEUER, 20+random(15), 10+random(6));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, CAP(class[r]));
  SetProp(P_SIZE, 180+random(200));
  SetProp(P_WEIGHT, 75000+random(100000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 25);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" verbrennt @WEN in seinen Haenden.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Macht des Feuers hat mich verlassen, %s!");
  SetProp(P_KILL_MSG, "Die Flammen werden Deine Seele reinigen, %s!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" meditiert vor sich hin.\n",
    Name(WER, 1)+" beschwoert eine kleine Flamme.\n",
    Name(WER, 1)+" versucht in den Flammen zu lesen.\n",
    Name(WER, 1)+" wird von einem Flammenring umgeben.\n",
    Name(WER, 1)+" versenkt sich meditativ in sein Element.\n",
    Name(WER, 1)+" murmelt leise Worte.\n",
    Name(WER, 1)+" mustert Dich.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  
  if(QueryProp(P_LEVEL) > 27 && !random(10))
    CLONEME(ARMOUR "amulett" );
  if(QueryProp(P_LEVEL) > 32 && !random(15))
    CLONEME(ARMOUR "flamering");
  command("trage alles");
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
   case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich streng an.",
        "blickt "+TPN+" streng an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt "+TPN+" guetig an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Ich brauche keinen unwissenden Waschlappen, wie Dich!",
        "sagt: Ich brauche keinen unwissenden Waschlappen, wie Dich!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verwuschelt Dein Haar.",
        "verwuschelt "+TP->Name(WESSEN)+" Haar.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

int query_size()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 290;
  if(QueryProp(P_RACE) == "Zwerg" || QueryProp(P_RACE) == "Hobbit" ||
     QueryProp(P_RACE) == "Goblin")
    return 120;
  if(QueryProp(P_RACE) == "Fee") return 40;
  else return 180;
}

int _query_weight()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 185000;
  if(QueryProp(P_RACE) == "Fee") return 20000;
  else return 75000;
}
