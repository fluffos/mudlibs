#include "../def.h"

inherit STD "std_tal_npc";
#include "/p/std/npc/berserker_npc.h"

string *race_a = ({"Menschen", "Elfen", "Hobbit", "Zwergen",
		  "Dunkelelfen", "Oger", "Troll", "Feen",
		  "Ork", "Goblin", "Untoten", "Skelett"});
string *class  = ({CL_HUMAN, CL_ELF, CL_HOBBIT, CL_DWARF, CL_DARKELF, CL_OGRE,
		   CL_TROLL, CL_FAIRY, CL_ORC, CL_GOBLIN, CL_UNDEAD,
		   CL_SKELETON});
string *title  = ({" wuetet hier herum", " vergiesst hier das Blut seiner Feinde",
		   "", " uebt hier den Axtkampf"});
int r;

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  r = random(sizeof(race_a));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+race_a[r]+"berserker"+
		    title[random(sizeof(title))]);
  SetProp(P_LONG,
    "Dieser wuetende "+race_a[r]+"berserker sucht hier nach einer wuerdigen "
    "Herausforderung. Mordluestern starrt er Dich an. Hoffentlich spielt er "
    "nicht mit dem Gedanken Dich anzugreifen! Er sieht wirklich furchterregend "
    "aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, race_a[r]+"berserker");
  SetProp(P_GENDER, MALE);
  AddId(({"berserker", race_a[r]+"berserker", class[r]}));
  AddClass( ({class[r]}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_berserker(20+random(15), 5+random(6));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, CAP(class[r]));
  SetProp(P_ALIGN, (random(2)>0?600:-600));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stuerzt verblutend zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wie konntest Du mich besiegen, %S?!");
  SetProp(P_KILL_MSG, "Ich bin eben doch staerker als Du, %s!");

//--Infos------------------------------------------------------------------
  
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" wuetet herum.\n",
    Name(WER, 1)+" knurrt Dich an.\n",
    Name(WER, 1)+" laesst seine Axt herabsausen.\n",
    Name(WER, 1)+" bruellt vor Wut!\n",
    Name(WER, 1)+" mustert Dich.\n",
    Name(WER, 1)+" rammt seine Axt in den Boden.\n",
    Name(WER, 1)+" stoesst markerschuetterndes Geschrei aus.\n",
    Name(WER, 1)+" floesst Dir Furcht ein.\n",
    Name(WER, 1)+" sieht sich nach wuerdigen Gegnern um.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  // Axt je nach Stufe
  if(QueryProp(P_LEVEL) < 24){
    CLONEME("/p/weapon/axe/kriegsbeil");
    command_me("zuecke beil");
  }
  else if(QueryProp(P_LEVEL) > 25 && QueryProp(P_LEVEL) < 31) 
    CLONEME("/p/weapon/axe/stabaxt");
  else if(QueryProp(P_LEVEL) > 30)
    CLONEME("/p/weapon/axe/streitaxt");
  command("zuecke axt");

  if(QueryProp(P_LEVEL) > 26 && !random(10))
    CLONEME(ARMOUR "feuerstiefel" );
  if(QueryProp(P_LEVEL) > 32 && !random(15))
    CLONEME(ARMOUR "stachelguertel");
  command("trage alles");
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(!touch) return;
  tell_object(TP, BS(Name(WER)+" bruellt Dich an!"));
  tell_room(ENV(TP), BS(Name(WER)+" bruellt "+TPN+" an!"), ({TP}));
  Kill(TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

int query_size()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 290;
  if(QueryProp(P_RACE) == "Zwerg" || QueryProp(P_RACE) == "Hobbit" ||
     QueryProp(P_RACE) == "Goblin")
    return 120;
  if(QueryProp(P_RACE) == "Fee") return 40;
  else return 180;
}

int _query_weight()
{
  if(QueryProp(P_RACE) == "Oger" || QueryProp(P_RACE) == "Troll")
    return 185000;
  if(QueryProp(P_RACE) == "Fee") return 20000;
  else return 75000;
}
