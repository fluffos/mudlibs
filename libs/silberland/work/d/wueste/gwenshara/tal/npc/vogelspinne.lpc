#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Vogelspinne");
  SetProp(P_LONG,
    "Eine haarige Vogelspinne spinnt sich hier ihr Netz. Sie sieht etwas "
    "ausgehungert aus - vermutlich gibt es hier nicht viele Beutetiere.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Vogelspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "vogelspinne", "tier"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({" mit ihren Fuesschen",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.1]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 200,
    "Die Vogelspinne beisst Dich!\n",
    "Die Vogelspinne beisst @WEN!\n",
     ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_POISON,
    Name(WER,1) + " beisst Dich mit ihren giftigen Beisswerkzeugen!\n",
    Name(WER,1) + " beisst @WEN mit ihren giftigen Beisswerkzeugen!\n" );
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
