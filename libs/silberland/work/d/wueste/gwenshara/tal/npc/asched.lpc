#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit STD "std_tal_npc";

int pool, turned;

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  pool=0;
  turned=0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein flammender Aschedaemon");
  SetProp(P_LONG,
    "Der Aschedaemon ist eine Gestalt aus wirbelnder Asche mit humanoidem "
    "Koerperbau. Sein Gesicht erinnert entfernt an menschliche Zuege, die "
    "in der endlosen Agonie des Verbrennens gefangen sind. Um ihn herum "
    "brennt die Luft mit dunkelroter Flamme. Irgendwie erinnert er Dich an "
    +users()[random(sizeof(users()))]->Name(WEN)+".");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Aschedaemon");
  SetProp(P_GENDER, MALE);
  AddId(({"daemon", "aschedaemon", "\ngwenshara_aschedaemon", 
          "NOWIMPY", }));
  AddClass( ({CL_DEMON}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit aschigen Haenden",
                    QueryProp(P_HANDS)[1]+200,
                    ({DT_BLUDGEON, DT_UNHOLY})
                    }) );

  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 200000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:      0.1, DT_WATER:       0.1,
       DT_AIR:      -0.5, DT_TERROR:   -0.5, DT_HOLY:        0.1,
       DT_UNHOLY:   -0.5, DT_MAGIC:    -0.5, DT_SLASH:      -0.9,
       DT_BLUDGEON: -0.9, DT_PIERCE:   -0.9, DT_SQUEEZE:    -0.9,
       DT_WHIP:     -0.9, DT_RIP:      -0.9,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " zerplatzt und eine Feuerkugel faellt zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 60);

  AddSpell(1, 300,
    "Der Aschedaemon beisst Dir in den Hals und saugt Dir Magie aus.\n",
    "Der Aschedaemon beisst @WEM in den Hals.\n",
     DT_RIP, "drain_mana", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500,
    "Der Daemon greift durch Deine Brust und zerquetscht Dein Herz.\n",
    "Der Daemon greift durch @WESSEN Brust.\n",
    ({DT_TERROR}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 300,
    "Ein dunkelroter Strahl trifft Dich aus den Augen des Daemons.\n",
    "Ein dunkelroter Strahl trifft @WEN.\n",
    ({DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));

}

private void power_up()
{
  if(turned) return;
  SetProp(P_MAX_HP, (int) (QueryProp(P_MAX_HP)*1.5));
  SetProp(P_HANDS, ({" mit gewaltigen Hoellenklauen",
                    QueryProp(P_HANDS)[1]+100,
                    ({DT_RIP, DT_UNHOLY})
                    }) );
  SetProp(P_HP, QueryProp(P_MAX_HP));
  tell_room(ENV(TO), BS("Der Aschedaemon manifestiert sich."));
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_SLASH:    -0.5,
       DT_BLUDGEON: -0.5, DT_PIERCE:   -0.5, DT_SQUEEZE:    -0.5,
       DT_WHIP:     -0.5, DT_RIP:      -0.5,
     ]) );
  SetProp(P_SHORT, "Ein maechtiger Aschedaemon");
  turned=1;
  return;
}

void drain_mana(object enemy, int damage, mixed dam_type)
{
  int mp;
  mp = 10+random(11); // Zwischen 10 und 20 MP
  enemy->AddSp(-mp);
  if(turned) return;
  pool+=mp;
  switch(pool)
  {
    case 0 .. 10: tell_room(ENV(TO), 
			      BS("Eine roetliche Aura umgibt den Daemon."));
                  break;
    case 11 .. 30: tell_room(ENV(TO),
                              BS("Die Aura um den Daemon leuchtet dunkelrot."));
                   break;
    case 31 .. 60: tell_room(ENV(TO),
                              BS("Der Daemon gewinnt an Substanz."));
                   break;
    case 61 .. 70: tell_room(ENV(TO),
                              BS("Der Daemon wird diese Welt bald vollends "
                                 "betreten haben."));
                    break;
    case 71 .. 90: tell_room(ENV(TO),
                              BS("Der Daemon kann sich jeden Moment manifestieren."));
                   break;
    case 91 .. 99: if(!random(2)) power_up();
                   break;
    default: power_up();
  }
  return;
} 


void die(int poisondeath)
{
  object orb;
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");
  if(present("\ndragon_lore", (QueryProp(P_KILLER)||TP)))
  {
    orb = clone_object(OBJ "elemental_orb");
    orb->SetElement("feuer");
    orb->move(ENV(TO));
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object o, *inv;
  int i;
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }

  // Wenn ein Spieler stirbt wird er als Diener wiederbelebt
  if(objectp(o=present("Leiche", ENV(TO))))
  {
    inv = all_inventory(o);
    o->remove(1);
    o = clone_object(NPC "undead");
    o->SetProp(P_CONTROLLABLE_BY_NEKRO, 0);
    TO->AddDefender(o);
    for(i=0; i<sizeof(inv); ++i)
     inv[i]->move(o, M_GET);
    o->move(ENV(TO), M_TPORT);
    tell_room(ENV(TO), BS("Der Aschedaemon belebt die Leiche von "+player->Name(WEM)+"!"));
  }
}
