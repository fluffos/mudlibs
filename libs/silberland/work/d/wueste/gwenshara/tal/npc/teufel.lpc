#include "../def.h"

inherit STD "std_tal_npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Feuerteufel");
  SetProp(P_LONG,
    "Vor Dir flattert ein kleiner Feuerteufel auf und ab. Er ist ein "
    "Maennchen aus reinem Feuer mit zwei feurigen Schwingen, die ihm aus "
    "dem Ruecken wachsen. Aus seinem kleinen Gesicht sehen dich Augen, "
    "wie gluehende Kohlen an und eine lange Flammennase ragt Dir entgegen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerteufel");
  SetProp(P_GENDER, MALE);
  AddId(({"teufel", "feuerteufel", "flammenteufel"}));
  AddClass( ({CL_DEMON, CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5+random(5));

  SetProp(P_HANDS, ({" mit feurigen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_FIRE})
                    }) );

  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 30+random(20));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, -600-random(400));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" behaelt @WEN neugierig.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:      0.3, DT_WATER:       1.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.2,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:   -0.3, DT_MAGIC:      -0.1,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verglueht und faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_MSG, "Du hast keine Chance, wenn Du nicht ein Mal meine "
		      "Flammen ertraegst, Weichling!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 200,
    "Der Feuerteufel wirft einen Feuerpfeil nach Dir.\n",
    "Der Feuerteufel wirft einen Feuerpfeil nach @WEM.\n",
    ({DT_MAGIC, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 200,
    "Der Feuerteufel beschwoert daemonisches Feuer auf Dich!\n",
    "Der Feuerteufel beschwoert daemonisches Feuer auf @WEN!\n",
    ({DT_UNHOLY, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 200,
    "Der Feuerteufel schleudert einen Blitz aus Flammen nach Dir!\n",
    "Der Feuerteufel schleudert einen Blitz aus Flammen nach @WEM!\n",
    ({DT_LIGHTNING, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" flattert auf und ab.\n",
    Name(WER, 1)+" begutachtet Dich genau.\n",
    Name(WER, 1)+" schaetzt Dich erfolgreich ein.\n",
    Name(WER, 1)+" atmet eine kleine Flamme aus.\n",
    Name(WER, 1)+" steigt ein wenig auf.\n",
    Name(WER, 1)+" sinkt etwas ab.\n",
    Name(WER, 1)+" beschwoert einen kleinen Feuerball.\n",
    Name(WER, 1)+" hinterlaesst eine Flammenspur in der Luft.\n",
   }) );

  SetAttackChats(5,
  ({Name(WER, 1)+" huellt sich in Feuer!\n",
    Name(WER, 1)+" wirft einen Feuerball haarscharf an Dir vorbei!\n",
    Name(WER, 1)+" murmelt boese Beschwoerungen.\n",
    Name(WER, 1)+" flammt gefaehrlich auf!\n",
    Name(WER, 1)+" glueht ploetzlich weiss!\n",
    Name(WER, 1)+" stuerzt sich auf Dich herab.\n",
    Name(WER, 1)+" brennt ein Loch in Deine Ruestung.\n",
    Name(WER, 1)+" sprueht Funken.\n",
    Name(WER, 1)+" kraechzt etwas Unverstaendliches.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "teufelsspiess" );
  command("zuecke spiess");

  SetProp(P_BODY, 30);
}

varargs void die( int poisondeath )
{
  if(!random(50))
    CLONEME(OBJ "teufelflamme");
  ::die(poisondeath);
}	



//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(!touch) return;
  tell_object(TP, BS("Du verbrennst Dich an dem Feuerwusel!"));
  tell_room(ENV(TP), BS(TPN+" schreit laut auf!"), ({TP}));
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
