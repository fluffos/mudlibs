#include "../def.h"

inherit "std/weapon";

string *schwaenze = ({"eins", "zwei", "drei", "vier", "fuenf", "sechs",
	             "sieben", "acht", "neun", "zehn"});

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Blitzgeissel");
  SetProp(P_LONG,
    "Die Blitzgeissel ist ein Peitschenschaft aus Metall, aus dessen "
    "vorderem Ende "+schwaenze[random(sizeof(schwaenze))]+" Blitze "
    "zucken.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Blitzpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "blitzpeitsche", "\ngwenshara_blotwhip"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_IRON:30, MAT_LIGHTNING:40, MAT_MAGIC:30]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_LIGHTNING, DT_ELECTRIC}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250]) );
  
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:15]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Solche Peitschen werden auf Grund ihrer hohen "
		  "Rueckschlagquote nicht mehr verwendet."));
}

int HitFunc( object enemy ) 
{
  if(random(50)) return 0;

  tell_object(QueryProp(P_WIELDED), BS("Die Peitsche erzeugt einen "
	      "magsichen Rueckschlag!"));
  QueryProp(P_WIELDED)->Defend(50+random(50), DT_MAGIC, ([SP_SHOW_DAMAGE:0]),
		               TO);
  return 0;
}
