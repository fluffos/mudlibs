#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Feuerteufelspiess");
  SetProp(P_LONG,
    "Diese zweizackige Gabel verwenden Feuerteufel um ihre Gegner zu "
    "stechen. Sie koennen damit richtig gefaehrlich werden. Allerdings "
    "ist so ein Spiess fuer unausgeblidete Kaempfer viel zu klein, als dass "
    "sie damit viel erreichen koennten. Auf Grund seiner Groesse koennte man "
    "ihn aber mit etwas Geschick als Dolch verwenden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerteufelspiess");
  SetProp(P_GENDER, MALE);
  AddId( ({"spiess", "gabel", "feuerteufelgabel", "feuerteufelspiess",
	   "teufelspiess", "teufelsspiess", "teufelgabel", "teufelsgabel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 99);
  SetProp(P_WC_FIX, 15);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\ngwenshara_tal_npc":100 ]) );
}
