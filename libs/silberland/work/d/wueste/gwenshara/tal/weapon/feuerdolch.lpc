#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Dolch namens 'Flammenzunge'");
  SetProp(P_LONG,
    "Der Dolch Flammenzunge hat einen mit rotem Leder umwickelten Griff. "
    "Sein Knauf ist mit einem Rubin besetzt. Die Klinge ist aus einem rot "
    "gluehenden Stahl, der aussieht, als waere eben aus der Esse genommen. ");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dolch 'Flammenzunge'");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "flammenzunge", "zunge", "\ngwenshara_flameknife"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STEEL:50, MAT_FIRE:20, MAT_LEATHER:10, MAT_RUBY:5,
		        MAT_MAGIC:15]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 123);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({DT_FIRE, DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["flamenekro":200 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:15, SR_SEER:1]) );

//--Details----------------------------------------------------------------

  AddDetail( ({"leder", "griff"}),
	    "Der Griff des Dolches ist mit rotem Leder umwickelt.");

  AddDetail( ({"knauf", "rubin"}),
	    "Der Knauf ist mit einem Rubin besetzt, der in wilden Feuer glueht.");

  AddDetail( ({"klinge", "stahl"}),
            "Die Klinge glueht rot und ist so heiss, als waere sie eben erst aus "
	    "der Esse genommen.");
}

int HitFunc( object enemy ) 
{
  if(!random(60))
  {
    tell_room(ENV(ENV(TO)), BS("Feuerzunge huellt "+enemy->Name(WEN)+" in Flammen!"),
	      ({enemy}));
    tell_object(enemy, BS("Feuerzunge huellt Dich in Flammen!"));
    enemy->Defend(300+random(300), ({DT_FIRE}), 0, TO);
  }

  return 0;
}
