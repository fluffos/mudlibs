#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine heilige Lichtklinge");
  SetProp(P_LONG,
    "Die heilige Lichtklinge ist das Schwert der maechtigsten Paladine und "
    "Kaempfer fuer das Gute. Sie wurde aus allen bekannten Arten des Metalls "
    "im kalten Feuer geschmiedet. Der Knauf dieses Schwertes ist mit einer "
    "strahlenden Sonne verziert. Die runenueberzogene Schneide des Schwertes "
    "ist weiss, wie Schnee. Es ist ein Albtraum fuer alle Untoten, Daemonen "
    "und Gegner des Guten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lichtklinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"klinge", "lichtklinge", "schwert", "lichtschwert"}) );

  SetProp(P_NAME_ADJ, "heilig" );
  AddAdjective( ({"heiligen","heiliger","heiligem","heiliges","heilige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_IRON:5,
			MAT_STEEL:5,
			MAT_COPPER:5,
			MAT_BRONCE:5,
			MAT_BRASS:5,
			MAT_TIN:5,
			MAT_LEAD:5,
			MAT_TITANIUM:5,
			MAT_MERCURY:5,
			MAT_ALUMINIUM:5,
			MAT_TUNGSTEN:5,
			MAT_COBALT:5,
			MAT_IRIDIUM:5,
			MAT_CHROMIUM:5,
			MAT_LIGHT:5]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_LIGHT, DT_HOLY, DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["\ngwenshara_paladin":200 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:18, A_DEX:22]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Dieses Schwert ist der Gegner alles Boesen!"));
  SetProp(P_PALADIN_SPELLCOST, 10);
}

int HitFunc( object enemy ) 
{
  int r;
  if(enemy->QueryProp(P_ALIGN)<0)
  {
    r = random(70);
    if(!r)
    {
      tell_room(ENV(QueryProp(P_WIELDED)), BS("Die heilige Lichtklinge "
		  "strahlt in hellem Licht auf!"));
      return 60+random(50);
    }
    if(r<20) return 40;
  }
  return 0;
}
