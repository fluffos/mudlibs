#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Feuerschwert");
  SetProp(P_LONG,
    "Das Feuerschwert ist ein Griff aus Metall, der mit roten Runen "
    "ueberzogen ist. Aus dem oberen Ende des Griffes stoesst ein Strahl aus "
    "weissem Feuer. Gib Acht, damit Du Dich nicht daran verbrennst!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feuerschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "feuerschwert"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MITHRIL:40, MAT_FIRE:60]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 165);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_FIRE}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["feuergeist":200 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:15]) );
}
