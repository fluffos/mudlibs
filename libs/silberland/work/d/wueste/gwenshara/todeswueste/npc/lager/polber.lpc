#include "../def.h"
#include ZONE "master/dragonquest.h"

inherit "/p/std/npc/necromancer_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Polber der Nekromant");
  SetProp(P_LONG,
    "Polber ist ein hoch gewachsender Mensch mit schwarzem, zerzausten Haar. "
    "Seine dunkle Robe, sowie sein grimmiger Gesichtsausdruck zeugen davon, "
    "dass er die Gegenwart anderer Lebewesen wohl eher ablehnt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Polber");
  SetProp(P_GENDER, MALE);
  AddId(({"polber", "nekromant", NECROMANCER, "NOWIMPY"}));
  AddClass( ({ CL_HUMAN }) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_necromancer_npc(40, 7, 7, 1);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,20);

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 0, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt fluchend zu Boden.\n");
  SetProp(P_MURDER_MSG, "Niemand kann einen Nekromanten wirklich toeten! Auch Du nicht, %s");
  SetProp(P_KILL_MSG, "Du Narr dachtest du waerst stark genug!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, ({"ignoriert Dich.\n",
                          "zuckt mit den Schultern.\n",
                          "sagt: Wen interessiert das?\n",
                          "beachtet Dich gar nicht."}));
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddLibrary(NPC "lager/dragonquest.lib", 3);

//--Items------------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "blutfaenger" );
  command("zuecke dolch");

  CLONEME( "/d/unterwelt/nekromanten/armour/kutte" );
  command("trage alles");
}

void give_notify(object ob)
{
  if(!ob->id(KNOCHEN))
  {
    command_me("sag Das kann ich nicht gebrauchen!");
    command_me("emote wirft "+ob->Name(WEN, 1)+" weg.");
    ob->move(ENV(TO), M_NOCHECK|M_PUT);
    return;
  }
  
  if(TP != QUESTMASTER->GetQuester())
  {
    command_me("sag Du solltest das gar nicht haben!");
    command_me("emote zerstoert die Fingerknochen.");
    ob->remove(1);
    return;
  }

  QUESTMASTER->SetKnochen();
  command_me("sag Sehr gut, "+TPN+". Waehrend ich die Fingerknochen nun mit "
             "nekromantischer Energie auflade musst Du etwas anderes fuer uns "
             "erledigen!");
  command_me("sag Kurungurs Fluch wird von vier Runensaeulen aufrecht erhalten. "
             "In jeder Himmelsrichtung befindet sich eine. Du musst sie zerstoeren!");
  ob->remove(1);
  return;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
