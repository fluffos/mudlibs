#include "../def.h"

inherit NPC "std_desert_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Speikobra");
  SetProp(P_LONG,
    "Diese gefaehrliche Schlange windet sich hier durch die Wueste.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Speikobra");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kobra", "speikobra", "schlange", "\ngwenshara_speikobra"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({" mit ihren Zaehnen",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE, DT_POISON})
                    }) );

  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schlängelt herein");
  SetProp(P_MSGOUT, "schlängelt ");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " rollt sich zusammen.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 10);
 
  AddDefaultSpell(1, 0, DS_BLIND,
                  "Die Kobra speit Dir Saeure ins Gesicht!\n",
                  "Die Kobra speit Dir Saeure ins Gesicht!\n");
}
