#include "../def.h"

inherit "/p/std/npc/nekro_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schatten");
  SetProp(P_GENDER, MALE);
  AddId(({"schatten"}));
  AddClass( ({ CL_UNDEAD, CL_DEMON }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit seinen Schattenhaenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_UNHOLY})
                    }) );

  SetProp(P_RACE, "Schatten");
  SetProp(P_SIZE, 0);
  SetProp(P_WEIGHT, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen!\n" }) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -70, T_RANGE_MAX:70]));
}

void SetOrigin(object ob)
{
  if(!objectp(ob))
  {
    remove(1);
    return;
  }

  SetProp(P_SHORT, "Der Schatten von "+ob->Name(WEM));
  SetProp(P_LONG,
    "Dieser Schatten ist das schattige Ebenbild von "+ob->Name(WEM)+".");
  return;
}
