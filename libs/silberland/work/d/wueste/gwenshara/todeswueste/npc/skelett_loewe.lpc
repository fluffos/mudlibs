#include "../def.h"

inherit "/p/std/npc/skeleton";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Skelett eines Loewen");
  SetProp(P_LONG,
    "Einst war dieser Loewe der stolze Koenig der Wueste. Jetzt ist er nicht "
    "mehr als ein Haufen untoter Knochen, belebt durch eine unheilige Macht. "
    "In seinen Augenhoehlen glimmen gruene Funken. Trotz seines Todes strahlt "
    "er immer noch eine ehrfurchtgebietende Aura aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Skelett eines Loewen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"loewenskelett", "\ngwenshara_skelett_loewe"}));
  AddClass( ({ CL_UNDEAD, CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_skeleton(20);

  SetProp(P_HANDS, ({" mit seinen Faengen",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE, DT_RIP})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen!\n" }) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 20, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wueste:7:20");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  call_out("walk_around", 20);
}
#include "walk_around.h"
