#include "../def.h"

inherit "/p/std/npc/skeleton";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der Chitinpanzer eines Riesenskorpions");
  SetProp(P_LONG,
    "Einst war dieses Tier ein Riesenskorpion. Es ragt beinahe zwei Schritt "
    "auf, ist jetzt jedoch nur noch eine Huelle, die von unheiliger Macht "
    "zum Leben gezwungen wird.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Chitinpanzer eines Riesenskorpions");
  SetProp(P_GENDER, MALE);
  AddId(({"panzer", "chitinpanzer", "skorpionpanzer", "\ngwenshara_skelett_skorpion"}));
  AddClass( ({ CL_UNDEAD, CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_skeleton(15);

  SetProp(P_HANDS, ({" mit seinen Scheren",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen!\n" }) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 20, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wueste:7:20");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  call_out("walk_around", 20);
}
#include "walk_around.h"
