#include "../def.h"

inherit "p/std/npc/paladin_npc";

void create()
{
  object ob;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Grossmeisterin Miriel Funkensang von Rabenfels");
  SetProp(P_LONG,
    "Die Grossmeisterin der Paladine ist eine wunderhuebsche Elfe mit "
    "honigfarbenem Haar und strahlend blauen Augen. Ihre Ruestung strahlt "
    "frisch poliert, und mit dem Wappenrock der Paladine wirkt sie noch "
    "imposanter.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Miriel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"miriel", "grossmeisterin", "funkensang", "NOWIMPY",
          "\ngwenshara_dragonquest_startnpc"}));
  AddClass( ({ CL_ELF }) );
  SetProp(P_ARTICLE, 0);

  set_living_name("miriel");

//--Eigenschaften----------------------------------------------------------

  create_default_paladin(40, 15);

  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 1500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MAGIC:      -0.2, DT_MIND:     -0.1 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 0, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt mit einem Gebet zu Dusty auf den Lippen.\n");
  SetProp(P_MURDER_MSG, "Dusty verfluche Dich, %s!");
  SetProp(P_KILL_NAME, "Grossmeisterin Miriel Funkensang von Rabenfels");
  SetProp(P_KILL_MSG, "Moege Dusty Deiner Seele gnaedig sein!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, ({
                           "blickt Dich fragend an.\n",
                           "sagt: Wir werden den Drachen vernichten!\n",
                           "laechelt Dich freundlich an.\n",
                           "sagt: Das Boese wird nicht siegen!\n",
                           "sagt: Davon weiss ich nichts, aber ich kann Deine Hilfe gebrauchen!"
                         }));
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"hilfe","helfen"}),
    "Wenn Du uns helfen willst biete mir Deine Hilfe an, ich sage Dir dann, was zu "
    "tun ist!",
    "sagt: ");

  AddLibrary(NPC "lager/dragonquest.lib", 2);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sagt: Der Drache muss aufgehalten werden!\n",
    Name(WER, 1)+" sagt: Wir waren knapp davor - irgendwas hat ihn gestaerkt!\n",
    Name(WER, 1)+" sagt: Wenn uns nur jemand helfen koennte...\n",
    Name(WER, 1)+" gruebelt.\n",
    Name(WER, 1)+" meint: Er muss doch zu besiegen sein!\n",
    Name(WER, 1)+" spricht: Nicht einmal ein Drache hat das Recht dazu!\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  ob = clone_object("/p/weapon/sword/bastardschwert" );

  call_other("/p/daemon/itemd/itemd", 
             "identify",
             ob,
             -1,
             100,
             100,
             ({40, 80, 100, 102, 103}),
             1);

  ob->move(TO, M_GET|M_NOCHECK);
  command("zuecke schwert");

  CLONEME("/gilden/paladine/armour/p_armschienen");
  CLONEME("/gilden/paladine/armour/p_beinschienen");
  CLONEME("/gilden/paladine/armour/p_helm");
  CLONEME("/gilden/paladine/armour/wappenmantel");
  CLONEME(ARMOUR "spiegelpanzer");
  command("trage alles");

//--Commands---------------------------------------------------------------
  
  AddCmd( ({ "biete", "biet" }), "cmd_bieten" );
}

int cmd_bieten(string str)
{
  string text;

  notify_fail("Wem willst Du was anbieten?\n");
  if(!(str == "miriel hilfe an" ||
       str == "grossmeisterin hilfe an" ||
       str == "funkensang hilfe an")) return 0;

 if(QUESTMASTER->StartQuest(TP) < 0)
    text = QUESTMASTER->GetQuester()->Name(WER)+" hilft uns bereits!";
  else
    text = "Vielen Danke "+TPN+"! Es wird nicht leicht werden Kurungur zu "
           "vernichten, denn er scheint ueber eine Unverwundbarkeit zu "
           "verfuegen. Polber meinte einen Weg gefunden zu haben gegen "
           "diese anzukommen. Sprich am Besten mit ihm darueber! "
           "Uebrigens hast Du nur fuenf Stunden zeit uns zu helfen - "
           "solltest Du in dieser Zeit nicht fertig werden, werden wir "
           "uns um neue Hilfe umsehen!";

  command_me("sag "+text);
  return 1;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
