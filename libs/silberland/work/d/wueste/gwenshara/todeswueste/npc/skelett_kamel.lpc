#include "../def.h"

inherit "/p/std/npc/skeleton";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Skelett eines Kamels");
  SetProp(P_LONG,
    "Dieses fast drei Mannschritt hohe Skelett gehoerte einst zu einem Kamel. "
    "Der feine Sand der Wueste hat seine Knochen blank poliert. Nur ein "
    "gruenes Gluehen in seinen leeren Augenhoehlen deutet auf seine jenseitige "
    "Existenz hin.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Skelett eines Kamels");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kamelkelett", "\ngwenshara_skelett_kamel"}));
  AddClass( ({ CL_UNDEAD, CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_skeleton(15);

  SetProp(P_HANDS, ({" mit seinen skelettierten Fuessen",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 275);
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen!\n" }) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 20, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wueste:7:20");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  call_out("walk_around", 20);
}
#include "walk_around.h"
