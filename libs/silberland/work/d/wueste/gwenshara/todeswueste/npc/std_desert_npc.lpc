#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Bewohner der Todeswueste");
  SetProp(P_LONG,
    "Ja ganz klar! Ein Bewohner der Todeswueste.");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.5, DT_COLD:     -0.1, DT_WATER:      -0.1,
       DT_LIGHT:    -0.1
     ]) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 20, T_RANGE_MAX:70]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wueste:7:20");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  call_out("walk_around", 20+random(10));
}

#include "walk_around.h"

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
