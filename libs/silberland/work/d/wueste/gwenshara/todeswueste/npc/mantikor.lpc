#include "../def.h"

inherit NPC "std_desert_npc";

int might;
mapping desc = ([
                  0:({"jung","Er ist noch sehr jung, also wohl ungefaehrlich."}),
                  1:({"erwachsen","Dieses Exemplar ist bereits ausgewachsen! Nimm dich in Acht!"}),
                  2:({"alt","Sein Fell ist bereits an einigen Stellen ergraut - er ist wohl alt!"}),
                  3:({"uralt","Ein langer Bart kuendet von seinem hohen Alter."})
               ]);

void create()
{
  string *s;
  if(!is_clone(TO)) return;

  ::create();
  might = random(4);
  s = desc[might];

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+s[0]+"er Mantikor");
  SetProp(P_LONG,
    "Dieses Wesen sieht aus wie eine tierhafte Mischung aus Mensch, Skorpion und "
    "Loewe. Es heisst sie sollen sehr Zaubermaechtig sein und mit ihrem Futter "
    "gerne spielen. "+s[1]);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mantikor");
  SetProp(P_NAME_ADJ, s[0]);
  SetProp(P_GENDER, MALE);
  AddId(({"mantikor", "\ngwenshara_mantikor", "NOWIMPY"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+(might*2)+random(might*3));

  SetProp(P_HANDS, ({" mit seinen Loewenpranken",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP})
                    }) );

  SetProp(P_RACE, "Mantikor");
  SetProp(P_SIZE, 100+(might*50));
  SetProp(P_WEIGHT, might*1000);
  SetProp(P_ALIGN, -might*100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, might*5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " bricht bruellend zusammen.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, might*10);

  AddSpell(4, 100+(might*50),
    Name(WER, 1)+" schlaegt seine spitzen Zaehne in Dich.\n",
    Name(WER, 1)+" schlaegt seine spitzen Zaehne in @WEN.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  if(might > 0)
    AddSpell(3, 150+(might*50),
             Name(WER, 1)+" sticht Dich mit seinem Skorpionschwanz.\n",
             Name(WER, 1)+" sticht @WEN mit seinem Skorpionschwanz.\n",
             DT_POISON, ([SP_SHOW_DAMAGE:1]));

  if(might > 1)
    AddSpell(2, 250+(might*50),
             Name(WER, 1)+" zerreist Dich mit seinen Pranken.\n",
             Name(WER, 1)+" zerreiset @WEN mit seinen Pranken.\n",
             DT_RIP, ([SP_SHOW_DAMAGE:1]));

  if(might > 2)
    AddSpell(1, 300+(might*50),
             Name(WER, 1)+" entzieht Dir Lebenskraft!\n",
             Name(WER, 1)+" entzieht @WEM Lebenskraft!\n",
             DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
}
