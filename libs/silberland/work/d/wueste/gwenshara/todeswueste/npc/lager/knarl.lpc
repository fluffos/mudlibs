#include "../def.h"
#include ZONE "master/dragonquest.h"

inherit "/p/std/npc/berserker_npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Knarl der Starke");
  SetProp(P_LONG,
    "Dieser riesige Troll traegt den Namen Knarl. Bei jeder seiner Bewegungen "
    "spielen seine Muskeln auf beeindruckende Weise. In seinen Augen brennt "
    "ein wildes Feuer, wie man es nur bei wirklich blutruenstigen Berserkern "
    "sieht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Knarl");
  SetProp(P_GENDER, MALE);
  AddId(({"knarl", "starke", "berserker", BERSERKER}));
  AddClass( ({ CL_TROLL }) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_berserker(40, 10);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 360);
  SetProp(P_WEIGHT, 375000);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.5, DT_SLASH:     0.2, DT_BLUDGEON:    0.2,
       DT_PIERCE:    0.2, DT_SQUEEZE:   0.2, DT_WHIP:        0.2,
       DT_RIP:       0.2,
     ]) );


  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0, T_RANGE_MAX:70]));
//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt bruellend.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "grunzt leise.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddLibrary(NPC "lager/dragonquest.lib", 1);

  SetChats(1,
  ({Name(WER, 1)+" grunzt.\n",
    Name(WER, 1)+" schaerft seine Axt.\n",
    Name(WER, 1)+" schwingt seine Axt.\n",
    Name(WER, 1)+" bindet sein Stirnband neu.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/axe/langaxt" );
  command("zuecke axt");

  CLONEME(ARMOUR "berserker_helm" );
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/p/armour/armour/plattenpanzer" );
  CLONEME( "/p/armour/trousers/kettenhose" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
