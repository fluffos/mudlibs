/*

     Der Questmaster zur Drachenquest

     Gwenshara@SL, 2008
*/

#include "dragonquest.h"
#include "../def.h"
#define BSI(x, y) break_string(x, 78, y)

object quester;
int knochen;
mapping saeulen;
int waffe;

void create()
{
  if(is_clone(TO))
  {
    raise_error("Darf nicht geclont werden!");
    destruct(TO);
    return;
  }

  quester = 0;
  saeulen = ([ ]);
}

void ResetQuest()
{
  quester = 0;
  knochen = 0;
  saeulen = 0;
  waffe   = 0;
  return;
}

int StartQuest(object pl)
{
  if(!PO->id(STARTER_NPC)) return -1;
  if(objectp(quester)) return -2;
 
  quester = pl;
  knochen = 0;
  saeulen = ([MASHATOR_ROOM:0,
              ASHGARHAI_ROOM:0,
              SILEM_ROOM:0,
              KARISHEI_ROOM:0]);
  waffe   = 0;
  call_out("CancelQuest", 18000);
  return 1;
}

void CancelQuest()
{
  if(!objectp(quester)) return;
  quester->Message(BSI("Du hast zu lange gebraucht! Tut mir leid, aber wir "
                   "muessen von vorne beginnen!", "Miriel teilt Dir mit: "),
                   MSGFLAG_TELL);

  while(find_call_out("CancelQuest") != -1)
    remove_call_out("CancelQuest");

  if(present(KNOCHEN, quester))
    present(KNOCHEN, quester)->remove();

  ResetQuest();
  return;
}

int SetKnochen()
{
  if(!PO->id(NECROMANCER)) return -1;
  if(knochen) return 0;
  knochen = 1;
  return 1;
}

int GetKnochen()
{
  return knochen;
}

int SetWeapon()
{
  if(file_name(PO) != WEAPON_ROOM) return -1;
  if(waffe) return 0;
  waffe = 1;
  return 1; 
}

int GetWeapon()
{
  return waffe; 
}

int AddSaeule()
{
  if(member(({MASHATOR_ROOM, ASHGARHAI_ROOM, SILEM_ROOM, KARISHEI_ROOM}),
             file_name(PO)) < 0) return 0;
  saeulen[file_name(PO)] = 1;
  return 1;
}

int SaeulenFertig()
{
  if(saeulen[MASHATOR_ROOM] &&
     saeulen[ASHGARHAI_ROOM] &&
     saeulen[SILEM_ROOM] &&
     saeulen[KARISHEI_ROOM]) return 1;
  return 0;
}

int FinishQuest()
{
  int ok;
  if(!objectp(quester) ||
     !SaeulenFertig()  ||
     !PO->id(END_NPC)) return -5;
  ok = quester->GiveQuest(QUESTNAME);
  ResetQuest();
  return ok;
}

object GetQuester()
{
  return quester;
}
