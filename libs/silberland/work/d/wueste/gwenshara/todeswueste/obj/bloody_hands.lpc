inherit "std/thing";

#include "../def.h"

int nr;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  nr = 5;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Deine Haende sind voll Blut!");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Ein machtvolles Ritual liegt auf Deinen Haenden!");
  SetProp(P_NAME, "Haende");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"haende", "\ngwenshara_dragonquest_bloodyhands"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BLOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

void reset()
{
  if(!is_clone(TO)) return;
  if(nr-- < 1)
  {
    tell_object(ENV(TO), BS("Das Blut weicht von Deinen Haenden!"));
    remove(1);
  }
}

string extra_look()
{
  return BS(CAP(ENV(TO)->QueryPossPronoun())+"e Haende sind blutrot!");
}
