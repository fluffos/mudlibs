#include "../def.h"
#define WUESTENMASTER ROOM "master"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine alte Karte");
  SetProp(P_LONG,
    "Dies ist eine Karte der Todeswueste. Du kannst sie betrachten.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Diese Karte zeigt Dir wo Du Dich befindest!");
  SetProp(P_NAME, "Karte");
  SetProp(P_GENDER, FEMALE);
  AddId("karte");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"betrachte", "betracht"}), "cmd_anschaun");
}

int cmd_anschaun(string str)
{
  string map;
  notify_fail("Was willst Du betrachten?\n");
  if(!str || str == "") return 0;
  if(!(str == "karte" ||
       str == "alte karte")) return 0;

  map = WUESTENMASTER->QueryPlayerPosition(TP);

  write("Du bist hier:\n");
  write(map);
  write("\n");
  return 1;
}
