inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Gerippe eines Loewen");
  SetProp(P_LONG,
    "Vor Dir liegen die blanken Knochen eines Loewen. Der Sand hat sie ganz "
    "blank poliert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gerippe eines Loewen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"gerippe", "loewengerippe", "\nnekromanten_knochen", "knochen"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_SIZE, 140);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_LEVEL, 10+random(10));
  SetProp(P_RACE, "Loewe");
}

string _query_info()
{
  if(TP->QueryProp(P_GUILD) == "nekromanten")
    return "Mit Deiner unheiligen Macht kannst Du diese Knochen beleben!";
  return 0;
}
