#include "../def.h"

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "raum"
#define WUESTENMASTER ROOM "master"
#define DETAILMASTER  ROOM "detailmaster"
#define TG(x) if(find_player("gwenshara")) tell_object(find_player("gwenshara"), BS("TW: "+x));
#define NPC_CHANCE 20

create() {
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "wueste" );
  SetProp(P_ROOMS, ({"wueste"}) );
}

string Validate(string file) {
  string name,foo;
  int xl,yl;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d%s",name,xl,yl,foo) == 4) &&
      (member(QueryProp(P_ROOMS), name) != -1)) 
    if(WUESTENMASTER->room_exists(xl, yl))
       return name+":"+xl+":"+yl;
  return 0;
}

int CustomizeObject() {
  string name,foo,foo2,*waende,wtext;
  string npc;
  int xl,yl,i;
  mapping exits;
  object ob;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d:%d%s",foo,xl,yl,foo2)!=4)
    return 0;

  exits=WUESTENMASTER->get_exits(xl,yl);
  PO->SetExits(exits);
  DETAILMASTER->Customize(PO);

  // Felswände
  waende = ({ });
  if(WUESTENMASTER->get_room_sign(xl-1, yl-1) == "b")
    waende += ({"Nordwesten"});
  if(WUESTENMASTER->get_room_sign(xl, yl-1) == "b")
    waende += ({"Norden"});
  if(WUESTENMASTER->get_room_sign(xl+1, yl-1) == "b")
    waende += ({"Nordosten"});
  if(WUESTENMASTER->get_room_sign(xl+1, yl) == "b")
    waende += ({"Osten"});
  if(WUESTENMASTER->get_room_sign(xl+1, yl+1) == "b")
    waende += ({"Suedosten"});
  if(WUESTENMASTER->get_room_sign(xl, yl+1) == "b")
    waende += ({"Sueden"});
  if(WUESTENMASTER->get_room_sign(xl-1, yl+1) == "b")
    waende += ({"Suedwesten"});
  if(WUESTENMASTER->get_room_sign(xl-1, yl) == "b")
    waende += ({"Westen"});

  if(sizeof(waende))
  {
   wtext="";
   for(i=0; i<sizeof(waende); i++)
   {
     if(sizeof(waende) == 1)
     {
       wtext = waende[i];
       break;
     }
     if(i==sizeof(waende)-1) wtext+="\b\b und "+waende[i];
     else wtext += waende[i]+", ";
   }
    PO->SetProp(P_INT_LONG, PO->QueryProp(P_INT_LONG)+"Im "+wtext+" ragen Felswaende auf.");
  }

  return 1;
}
