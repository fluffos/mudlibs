#include "../def.h"

inherit "std/room";

int staub, blut;

string schale();

void create()
{
  ::create();
  staub = 0;
  blut  = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Dieses Rundzelt ist mit dunklen Stoffen eigerichtet. Von der Decke "
    "baumeln etliche verschiedene Knochen. Der Boden ist mit einem dunklen "
    "Teppich ausgelegt und in der Mitte des Zelts befindet sich ein "
    "kleiner Tisch aus dunklem Holz. Das einzige Licht in diesem Zelt kommt "
    "von eine kleiner Oeffnung ueber dem Tisch. Der Rest befindet sich in "
    "einer zwielichtigen Duesternis.");

   // Fuers Skelett
   SetProp(P_NAME, "Polber");
   SetProp(P_RACE, ({"Mensch", "Halbling", "Elf", "Dunkelelf",
                     "Troll", "Oger", "Zwerg", "Fee"})[random(8)]);
   SetProp(P_LEVEL, 20);   

   // Fuers Schneiden
   SetProp(P_KILL_NAME "Blutverlust");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(11), ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "rundzelt", "zelt" }),
    "Du befindest Dich hier in einem duesteren Rundzelt.");

  AddDetail( ({ "stoffe", "stoffen", "stoff" }),
    "Der Boden ist von einem dunklen Teppich bedeckt und die Zeltwaende "
    "bestehen ebenso aus schwarzem Stoff.");

  AddDetail( ({ "decke", "dach", "zeltdach" }),
    "Du erkennst in der vorherrschenden Duesternis ein paar merkwuerdige "
    "Objekte und Knochen von der Decke baumeln.");

  AddDetail( ({ "knochen" }),
    "Verschiedene Knochen haengen von der Decke.");

  AddDetail( ({ "boden" }),
    "Ein dunkler Langhaarteppich bedeckt den Boden. Ein paar Sandkoerner "
    "haben sich in ihm verfangen.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Rundzeltes befindet sich ein kleiner Tisch aus "
    "dunklem Holz.");
 
  AddDetail( ({ "tisch" }),
    "Dieser kleine Tisch wird durch eine Oeffnung im Zeltdach beleuchtet. "
    "Er wurde aus einem dunklen Holz gezimmert und es wurden mehrere Gegenstaende "
    "auf ihm abgestellt.");

  AddDetail( ({"holz"}),
    "Der Tisch besteht aus einem dunklen Holz.");

  AddDetail( ({ "licht", "lichtstrahl" }),
    "Ein duenner Lichtstrahl beleuchtet den Tisch in der Mitte des Zelts. Er "
    "kommt aus einer Oeffnung im Zeltdach.");

  AddDetail( ({ "oeffnung" }),
    "Durch eine kleine, kreisrunde Oeffnung im Dach dringt ein Lichtstrahl, der "
    "den Tisch beleuchtet.");

  AddDetail( ({ "rest", "duesternis" }),
    "Der Rest der Einrichtung verschwindet beinahe in der Duesternis. Du kannst "
    "lediglich ein paar Konturen erahnen.");

  AddDetail( ({"teppich", "langhaarteppich"}),
    "Der Teppich hat lange Haare. Er koennte von einem der beruehmten Zottel"
    "bueffel stammen.");

  AddDetail( ({"waende", "zeltwaende", "wand"}),
    "Du kannst die Waende gar nicht von der Duesternis unterscheiden.");

  AddDetail( ({"objekte"}),
    "Du kannst nicht genau erkennen was es ist. Womoeglich koenntest Du es "
    "aber ertasten.");

  AddDetail( ({"sand", "sandkoerner"}),
    "Die paar Sandkoerner wurden von Dir hereingetragen.");

  AddDetail( ({ "gegenstaende" }),
    "Auf dem Tisch befinden sich ein aufgeschlagenes Buch, eine mit Schale "
    "und ein Dolch.");

  AddDetail( ({ "einrichtung" }),
    "Du kannst nichts richtig erkennen. Lediglich die Konturen erahnen.");

  AddDetail( ({ "konturen" }),
    "Du versuchst Dein bestes, jedoch duerfte da nicht mehr sein, als "
    "dieses seltsame menschenaehnliche Ding.");

  AddDetail( ({ "haare" }),
    "Ob das wirklich die Haare des Zottelbueffels sind?");

  AddDetail( ({ "zottelbueffel", "bueffel" }),
    "Der ist so selten, dass gar keiner hier ist!");

  AddDetail( ({ "buch" }),
    "Es ist aufgeschlagen und liegt auf dem Tisch.");

  AddDetail( ({ "schale" }), #'schale);

  AddDetail( ({ "dolch" }),
    "Der Dolch sieht nicht sehr stabil aus. Er ist wohl nicht zum "
    "Kaempfen gedacht.");

  AddReadDetail( ({ "buch", "passage" }),
    "Du findest eine spannende Passage:\n"
    "... nur jener, der gebadet seine Hand in Blut und Knochen, "
    "kann Yokruks Ueberreste ergreifen ...\n"
    "An den Rand wurden ein paar Bemerkungen gekritzelt.");

  AddReadDetail( ({ "bemerkungen" }),
    "Eigenblut mit Knochen von Loewen zeigt besten Effekt.\n"
    "Dir faellt eine noch kleinere Randbemerkung auf." );
 
  AddReadDetail( ({"randbemerkung"}),
    "(Anm.: Knoch.St. von K. besorgt; Ungenutzte Mengen "
    "in Verw. von K.");

  AddDetail( ({"passage"}),
    "Die steht da im Buch.");

  AddDetail( ({ "ding", "skelett" }),
    "Bei diesem Ding handelt es sich um ein Skelett, dass hier "
    "im Zelt steht. Obwohl es durch nichts zusammen gehalten wird "
    "steht es aufrecht. Hmm... Ob es eine gute Idee ware ihm die "
    "Hand zu geben?");

 AddDetail( ({ "idee", "hand" }),
   "Vermutlich waere es eine saublode Idee!");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "taste", "ertaste", "tast", "ertast" }), "cmd_tasten" );
  AddCmd( ({ "gib" }), "cmd_hand" );
  AddCmd( ({ "fuell", "fuelle" }), "cmd_fuellen" );
  AddCmd( ({ "schneid", "schneide" }), "cmd_schneiden" );
  AddCmd( ({ "wasche", "wasch", "bade", "bad"}), "cmd_ritual" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", ROOM "lager/lager_0_0" );
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_ritual(string str)
{
  object ob;
  notify_fail("Worin willst Du was baden?\n");
  if(!(str == "haende in schuessel" ||
       str == "haende in blut" ||
       str == "haende in knochen")) return 0;

  if(!blut || !staub)
  {
    write(BS("Da fehlt noch was..."));
    return -1;
  }

  write(BS("Du waeschst Deine Haende in Blut und Knochen, wobei "
        "Du alles aus der Schuessel verbrauchst."));
  say(BS(TPN+" waescht sich die Haende."));
  staub = 0;
  blut  = 0;

  if(QUESTMASTER->GetQuester() != TP)
  {
    write(BS("Nichts gescheiht..."));
    return -1;
  }

  if(!present("\ngwenshara_dragonquest_bloodyhands", TP))
  {
    ob = clone_object(OBJ "bloody_hands");
    ob->move(TP, M_GET|M_NOCHECK);
  }
  write(BS("Deine Haende faerben sich blutrot."));
  return 1;
}

int cmd_fuellen(string str)
{
  notify_fail("Was willst Du wohin fuellen?\n");
  if(str == "blut in schale")
  {
    write(BS("Schneide Dich doch mit dem Dolch, das ist einfacher."));
    return -1;
  }

  if(staub)
  {
    write(BS("In der Schale befindet sich bereits Knochenstaub."));
    return -1;
  }  

  if((str == "staub in schale" ||
     str == "knochenstaub in schale") &&
     present("\ngwenshara_dragonquest_knochenstaub", TP))
  {
    write(BS("Du fuellst den Knochenstaub in die Schale."));
    say(BS(TPN+" fuellt etwas in die Schale."));
    staub = 1;
    return 1;
  }
  return 0;
}

string schale()
{
  string str;
  str = "In der Schale befindet sich ";
  if(staub && blut) str += "eine Mischung aus Knochenstaub und Blut";
  else if(staub && !blut)   str += "Knochenstaub";
  else  if(blut && !staub)  str += "Blut";
  else str += "nichts";
  str += ".";
  return BS(str);
}

int cmd_schneiden(string str)
{
  notify_fail("Womit willst Du Dich schneiden?\n");
  if(!(str == "mit dolch" ||
       str == "dich mit dolch")) return 0;

  if(blut)
  {
    write(BS("In der Schale befindet sich bereits Blut."));
    return -1;
  }

  write(BS("Du schneidest Dich mit dem Dolch und laesst das Blut in die Schale rinnen."));
  say(BS(TPN+" schneidet sich mit einem Dolch."));
  TP->do_damage(10+random(20));
  blut = 1;
  return 1;
}

int cmd_tasten(string str)
{
  notify_fail("Was moechtest Du ertasten?\n");
  if(!str || str == "") return 0;
  if(!(str = "objekt" ||
       str == "objekte")) return 0;

  write(BS("Du fummelst herum und spuerst etwas langes, schleimiges."));
  write(BS("Angewidert laesst Du es doch lieber..."));
  say(BS(TPN+" fummelt an der Decke herum."));
  return 1;
}

int cmd_hand(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "skelett hand" ||
       str == "skelett die hand" ||
       str == "ding hand" ||
       str == "ding die hand")) return 0;

  write(BS("Du gibst dem Skelett die Hand."));
  say(BS(TPN+" haelt seine Hand ins Dunkel."));
  call_out("get_alive", 2);
  return 1;
}

void get_alive()
{
  object skelett;
  if(present("\ngwenshara_polber_skele", TO)) return;

  Message(BS("Ein Skelett tritt aus dem Schatten hervor!"), MSGFLAG_VISUAL);
  skelett = clone_object("/gilden/nekromanten/npc/skelett");
  skelett->SetSkeleton(TO, TO,  6666+random(2000));
  skelett->AddId("\ngwenshara_polber_skele");
  skelett->SetProp(P_AGGRESSIVE, 1);
  skelett->move(TO, M_SILENT|M_NOCHECK);
  return;
}

int _query_size()
{
  switch(QueryProp(P_RACE))
  {
    case "Mensch":    return 175;
    case "Elf":
    case "Dunkelelf": return 200;
    case "Zwerg":
    case "Halbling":  return 100;
    case "Fee":       return 60;
    case "Troll":
    case "Oger":      return 300;
  }
  return 0;
}
