#0:0
text_short ({"In einer staubigen Ebene","In der Wueste des Todes","Mitten im Sand","In einer gluehenden Sandlandschaft","Zwischen ein paar Duenen","Umgeben von Sand","In unendlichen Weiten...","Weit weg von jeglichem Wasser","In einem Haufen Sand","Irgendwo in der Wueste","Verschollen im Sandmeer","Ein Meer aus Sand","Nichts als Hitze und Sand","Ein staubiger Fleck Wueste","Bei einer Fata Morgana","Unter gluehender Sonne","Ein ausgedoerrter Landstrich","Die Todeswueste","Die Wueste und der Tod",})
text_long ([6:({"Vor Dir ragen die blanken Knochen eines Elefanten auf.","Ein paar verwitterte Rippen ragen aus einem Sandhaufen.","Eine runenverzierte Saeule ragt hier in den Himmel.","Ueber Deinem Kopf kreisen bereits die ersten Geier.","Es fuehlt sich an, als wuerde Dir eine unsichtbare Kraft alles Leben aussaugen.","Deine Lippen sind schon aufgesprungen.","Ein Skorpion laeuft an Dir vorbei.","Der rote Sand scheint hier regelrecht zu gluehen.","Irgendwoher hoerst Du das Bruellen eines Loewen.","Fuer einen Tropfen Wasser wuerdest Du sogar deine Seele verkaufen.","Ob Du jemals wieder aus dieser Hoelle entkommst?","Nicht ein einziger Fleck Schatten schenkt Dir Kuehlung.","Wie Blut ergiesst sich dieser rote Sand ueber die Weiten der Todeswueste.","Ob die Farbe des Sandes wohl von geronnenem Blut kommt?",}),2:({"Die Sonne brennt auf Dich herab.","Ein heisser Luftzug wirbelt Sand auf um Dich herum auf.","Ein wolkenloser Himmel breitet sich ueber dieser Todeswueste aus.","Nichts als endlose Weiten aus Sand breiten sich um Dich herum aus.","Der Sand hat die Farbe von Blut.",}),5:({"Jeder Tropfen Wasser scheint aus Dir gezogen zu sein.","Nicht ein Mal mehr Schweiss dringt aus Deinem Koerper.","Dieses Licht hier macht Dich beinahe wahnsinnig.","Jeder Schritt bereitet Dir schon unsagbare Qualen.","Die Orientierung hast Du schon laengst verloren.",}),1:({"Du befindest Dich zwischen den roten Sandduenen der Todeswueste.","Muehsam schleppst Du Dich durch die Wueste.","Du befindest Dich hier auf einer roten Duene.","Schwitzend wankst Du durch den Glutofen der Todeswueste.","Um Dich herum befindet sich nichts als roter Sand.",}),4:({"Dein Mund ist schon ganz trocken.","Es fuehlt sich an, als wuerden Flammen ueber Deine Haut lecken.","Langsam gewoehnst Du Dich an die Hitze.","Die Luft vor Deinen Augen beginnt zu flirren.","Du hoerst Deine haut braten.",}),3:({"Aus der Ferne dringt das Heulen eines Sandsturms an Dein Ohr.","Am Boden erkennst Du die Spuren von einem Tier.","In der Ferne glaubst Du Wasser zu erkennen.","Vor Dir breitet sich eine ausgedoerrte Wasserstelle aus.","Irgendwo muss es doch Wasser geben!",}),])
text_details (["wueste":({"Du befindest Dich mitten in der Wueste","Die Menge an Sand um Dich herum deutet wohl auf eine Wueste hin.","Ja, so ist die Wueste - heiss und noch heisser.","Ueberall Sand - definitiv die Wueste!",}),])
parsed 0
