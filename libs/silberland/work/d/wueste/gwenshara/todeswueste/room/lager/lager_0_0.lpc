#include "../def.h"

inherit ROOM "lager/std_lager_room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Mitten in dieser Einoede des Todes wurde hier ein Zeltlager errichtet. "
    "Hier erhebt sich ein schwarzes, mit roten Runen verziertes, Zelt. Im "
    "Osten und Sueden erkennst Du weitere Zelte. Suedoestlich von Dir befindet "
    "sich eine kleine Wasserstelle.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "einoede" }),
    "Diese Wueste ist eine wahrhafte Einoede des Todes.");

  AddDetail( ({"tod", "todes"}),
    "Wie lange wird es wohl noch dauern bis Dich der Tod ereilt?");

  AddDetail( ({"zeltlager", "lager"}),
    "Irgendjemand hat hier, mitten in der Wueste, ein Zeltlager errichtet.");

  AddDetail( ({"runen"}),
    "Verschiedene Runen wurden an das Aeussere des Zeltes gemalt. Sie sind "
    "von blutroter Farben und scheinen zu funkeln.");

  AddDetail( ({"rundzelt", "zelt"}),
    "Es handelt sich um ein etwas groesseres Rundzelt, dass mit ein paar "
    "Seilen und Pfloecken am Boden fixiert ist. Du kannst es von hier aus "
    "problemlos betreten.");

  AddDetail( ({"zelte"}),
    "Im Sueden und Osten sind weitere Zelte.");

  AddDetail( ({"wasser", "wasserstelle"}),
    "Suedoestlich von hier befindet sich eine kleine Wasserstelle.");

  AddDetail( ({"farbe"}),
    "Irgendwie erinnert Dich diese Farbe an etwas... und dieser Geruch...");
 
  AddDetail( ({"seile", "pfloecke"}),
    "Acht Seile und Pfloecke fixieren dieses Zelt am Boden.");

  AddDetail( ({"geruch"}),
    "Naja, also eigentlich siehst Du ihn ja nicht.");

  AddSmell( ({ "geruch" }),
    "Diese Runen riechen metallisch... das erinnert Dich an etwas... "
    "vielleicht faellt es Dir ein, wenn Du sie kurz kostest?");

  AddDetail( ({ "aeusseres", "aeussere"}),
    "Das gesamte Zelt ist mit diesen Runen bedeckt.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "koste", "kost" }),    "cmd_runen" );
  AddCmd( ({ "betrete", "betret"}), "cmd_betreten" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden",     ROOM "wueste:8:2" );
  AddExit( "nordosten",  ROOM "wueste:9:2" );
  AddExit( "osten",      ROOM "lager/lager_1_0" );
  AddExit( "suedosten",  ROOM "lager/lager_1_1" );
  AddExit( "sueden",     ROOM "lager/lager_0_1" );
  AddExit( "suedwesten", ROOM "wueste:7:4" );
  AddExit( "westen",     ROOM "wueste:7:3" );
  AddExit( "nordwesten", ROOM "wueste:7:2" );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_runen(string str)
{
  notify_fail("Was willst Du kosten?\n");
  if(!str || str == "") return 0;
  if(!(str == "runen")) return 0;

  if(TP->QueryProp(P_GUILD) == "nekromanten")
    write(BS("Du kostest von den Runen und stellst fest, dass sie mit "
          "koestlichem Blut gemalt wurden!"));
  else
    write(BS("Du kostet von den Runen und stellst fest, dass sie mit "
          "Blut gemalt wurden! Wie widerlich!"));
  say(BS(TPN+" leckt am Zelt herum."));
  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str != "zelt") return 0;

  if(TP->move(ROOM "lager/zelt_nekromant", M_GO|M_SILENT) != 1)
  {
    write("Das geht gerade nicht.\n");
    return -1;
  }

  write(BS("Du betrittst das Zelt."));
  say(BS(TPN+" betritt das Zelt."));
  tell_room(find_object(ROOM "lager/zelt_nekromant"),
            BS(TPN+" betritt das Zelt."), ({TP}));
  return 1;
}
