#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer alten Silbermine");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus sproedem Sandstein. Ab und zu erkennst Du ein "
    "silbernes Funkeln darin.");

  AddDetail( ({ "wand", "waende" }),
    "So wie der Boden, bestehen die Waende aus Sandstein. Auch hier ist "
    "hin und wieder ein silbernes Funkeln zu erkennen.");

  AddDetail( ({ "sandstein" }),
    "Diese Mine wurde in den sproden Sandstein geschlagen.");

  AddDetail( ({ "funkeln", "silberspuren", "silber", "spuren" }),
    "Das Funkeln stammt von vereinzelten Silberspuren.");

  AddDetail( ({ "mine", "silbermine" }),
    "Du bist hier in einer alten Silbermine.");

  AddDetail( ({"decke"}),
    "Die Decke besteht aus roetlichem Sandstein. Ab und zu wird sie mit "
    "Stuetzbalken daran gehindert auf Dich zu fallen.");

 AddDetail( ({"balken", "stuetzbalken", "holzbalken"}),
   "Diese Holzbalken verhindern, dass Dir die Decke auf den Kopf faellt.");

  AddDetail( ({"kopf"}),
    "Waer doch schade um ihn.");

  AddSound( ({DEFAULT_SOUND, "haemmern", "tiefen", "mine"}),
    "Du hoerst ein Haemmern aus den Tiefen der Mine.");
}
