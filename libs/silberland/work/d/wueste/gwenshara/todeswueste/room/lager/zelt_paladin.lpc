#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Zelt in der Wueste");
  SetProp(P_INT_LONG,
    "Das Innere dieses Zeltes ist hell erleuchtet. Du findest hierdrin "
    "nicht gerade viele Gegenstaende. Abgesehen von einer Schlafstelle, "
    "einem kleinen Dustyaltar und einer Wasserschuessel ist hier nichts "
    "zu finden.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(11), ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "zelt" }),
    "Du befindest Dich hier in einem strahlend weissen Zelt.");

  AddDetail( ({ "gegenstaende", "innere", "inneres" }),
    "Bis auf eine Schlafstelle, einen Altar und eine Wasserschuessel ist dieses "
     "Zelt leer.");

  AddDetail( ({ "stelle", "schlafstelle" }),
    "Diese Schlafstelle besteht aus einer einachen Strohmatraze und duenen Decken.");

  AddDetail( ({ "altar", "dustyaltar", "tischchen", "holztischchen" }),
    "Der Altar ist ein einfaches Holztischchen mit einem weissen Tuch und einer "
    "Statue der Dusty darauf. Hier kann man sich wohl niederlassen um Ruhe im "
    "Gebet zu finden.");

  AddDetail( ({ "schuessel", "wasserschuessel" }),
    "Eine einfache Schuessel, befuellt mit Wasser, steht neben der Schlafstelle.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus dem roetlichen Sand der Wueste.");

  AddDetail( ({ "decke", "dach", "zeltdach" }),
    "Das Zeltdach bietet keine besonders interessanten Gegebenheiten.");

  AddDetail( ({ "wand", "waende", "zeltwand", "zeltwaende" }),
    "Die Zeltwaende bieten keine besonders interessanten Gegebenheiten.");

  AddDetail( ({ "matraze", "strohmatraze" }),
    "Sicher nicht sehr bequem.");

  AddDetail( ({ "decken" }),
    "In dieser Wueste reichen duenne Decken vollkommen.");

  AddDetail( ({ "tuch" }),
    "Ein strahlend weisses Tuch bedeckt das kleine Holztischchen. Auf ihm "
    "befindet sich eine Statue der Dusty.");

  AddDetail( ({ "statue" }),
    "Diese Statue besteht aus reinem Gold. Sie stellt die Goettin Dusty in "
    "all ihrer Pracht dar.");

  AddDetail( ({ "dusty", "goettin" }),
    "Persoenlich ist sie nicht anwesend.");

  AddDetail( ({ "ruhe", "gebet" }),
    "Vielleicht brauchst auch Du etwas Ruhe.");

  AddDetail( ({ "wasser" }),
    "Dieses Wasser ist offensichtlich dazu gedacht um sich zu waschen.");

  AddDetail( ({ "sand", "wueste" }),
    "Draussen gibt es noch viel mehr Sand und Wueste.");

  AddDetail( ({ "gegebenheiten" }),
    "Tja - die sind nicht da.");

  AddDetail( ({ "gold", "metall" }),
    "Die Statue ist aus diesem wertvollen Metall gefertigt.");

  AddDetail( ({ "pracht" }),
    "In all ihrer Pracht steht die Statue da.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "bete", "bet" }), "cmd_beten" );
  AddCmd( ({ "wasche", "wasch" }), "cmd_waschen");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", ROOM "lager/lager_0_1" );
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_beten(string str)
{
  write(BS("Du haeltst ein kurzes Gebet und fuehlst Dich erfrischt."));
  say(BS(TPN+" kniet zu einem kurzen Gebet nieder."));
  return 1;
}

int cmd_waschen(string str)
{
  notify_fail("Womit willst Du Dich waschen?\n");
  if(!(str == "mit wasser")) return 0;

  write(BS("Du waescht Dir schnell Dein Gesicht."));
  say(BS(TPN+" waescht sich schnell."));
  return 1;
}
