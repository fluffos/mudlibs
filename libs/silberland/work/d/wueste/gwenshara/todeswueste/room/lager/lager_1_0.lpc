#include "../def.h"

inherit ROOM "lager/std_lager_room";

string block();
string axt();
string beutel();
int axt;

void create()
{
  ::create();
  axt = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier befindet sich ein kleines Zelt. Es wurde wohl als Teil eines "
    "Lagerplatzes aufgeschlagen, denn im Westen und Suedwesten erkennst "
    "Du noch mehr Zelte. Suedlich von hier befindet sich eine kleine "
    "Wasserstelle. Ein Holzblock steht hier herum.");

  SetProp(P_LIGHT, 2);

//--Details----------------------------------------------------------------

  AddDetail( ({ "zelt" }),
     "Dieses kleine Zelt reicht gerade so fuer eine Person. Es besteht aus "
     "einem grauen Stoff, der mit zwei Stoecken aufgespannt wurde. Darin "
     "befinden sich nur ein paar spaerliche Habseligkeiten." );

  AddDetail( ({ "teil", "lagerplatz", "lagerplatzes" }),
     "Dieses Zelt scheint der Teil eines groesseren Lagerplatzes zu sein." );

  AddDetail( ({ "zelte" }),
     "Im Suedwesten findest Du ein strahelnd weisses und im Westen ein "
     "schwarzes Zelt." );

  AddDetail( ({ "stelle", "wasserstelle" }),
     "Von hier kannst Du nichts genaues erkennen." );

  AddDetail( ({ "block", "holzblock" }), #'block );

  AddDetail( ({ "art" }),
     "Na sowas eben." );

  AddDetail( ({ "feuerholz", "holz" }),
     "Auf diesem Block wird wohl Feuerholz geschlagen." );

  AddDetail( ({ "axt", "handaxt" }), #'axt );

  AddDetail( ({ "person" }) ,
    "Jemand, wie Du!" );

  AddDetail( ({ "stoff", "stoecke", "stoecken" }) ,
    "Der graue Stoff wurde mit zwei Stoecken zu einem Zelt umfunktioniert." );

  AddDetail( ({ "habseligkeiten" }) ,
    "Das Uebliche eben." );

  AddDetail( ({ "uebliche", "uebliches", "grundausruestung", "ausruestung" }) ,
    "Eine Schaufel, ein Seil, eine Fackel, ein paar Beutel..." );

  AddDetail( ({ "seil", "schaufel" }) ,
    "Das gehoert zur Grundausruestung eines Abenteurers." );

  AddDetail( ({ "beutel" }) , #'beutel );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "nehme", "nimm" }),    "cmd_nehmen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden",     ROOM "wueste:9:2" );
  AddExit( "nordosten",  ROOM "wueste:10:2" );
  AddExit( "osten",      ROOM "wueste:10:3" );
  AddExit( "suedosten",  ROOM "wueste:10:4" );
  AddExit( "sueden",     ROOM "lager/lager_1_1" );
  AddExit( "suedwesten", ROOM "lager/lager_0_1" );
  AddExit( "westen",     ROOM "lager/lager_0_0" );
  AddExit( "nordwesten", ROOM "wueste:8:2" );

//--Items------------------------------------------------------------------

  AddItem(NPC "lager/knarl", REFRESH_DESTRUCT );
}

void reset()
{
  ::reset();
  axt = 1;
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_nehmen(string str)
{
  object ob;
  if(!(str == "axt" ||
       str == "axt von block" ||
       str == "axt an dich" ||
       str == "axt an mich" ||
       str == "handaxt" ||
       str == "handaxt von block" ||
       str == "handaxt an dich" ||
       str == "handaxt an mich")) return 0;

  if(!axt) return 0;
  ob = clone_object("/p/weapon/axe/handaxt");
  if(ob->move(TP, M_GET) != 1)
  {
    write(BS("Du laesst die Handaxt fallen."));
    ob->move(TO, M_PUT);
    axt = 0;
    return 1;
  }
  write(BS("Du nimmst die Handaxt an Dich."));
  Message(BS(TPN+" nimmt eine Handaxt."), MSGFLAG_VISUAL);
  axt = 0;
  return 1;
}

string block()
{
  string axe;
  if(axt) axe = " Es steckt sogar eine kleine Handaxt darin.";
  else    axe = "";
  return BS("Es ist so eine Art von Holzblock, wie benutzt wird um Feuerholz darauf "
             "zu schlagen."+axe);
}

string axt()
{
  string axe;
  if(axt) return BS("Sie wurde in den Block geschlagen. Ob jemand was dagegen haettest, wenn Du "
                    "sie an Dich nehmen wuerdest?");
  else    return BS("Sowas siehst Du da nicht!");
}

string beutel()
{
  string str;
  object ob;
  str = "Du siehst Dir die Beutel genauer an, ";
  if(!present("\ngwenshara_dragonquest_knochenstaub", TP) &&
     QUESTMASTER->GetQuester() == TP &&
     !present("\ngwenshara_dragonquest_bloodyhands", TP))
  {
    str += "und findest etwas Knochenstaub.";
    ob = clone_object(OBJ "knochenstaub");
    if(ob->move(TP, M_GET) != 1)
    {
      str += "\nDa er dir zu schwer ist, laesst Du ihn aber im Beutel.";
      ob->remove(1);
    }
  }
  else str += "findest aber nichts.";
  return BS(str);
}
