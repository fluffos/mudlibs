#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Eingang einer Mine");
  SetProp(P_INT_LONG,
    "Oestlich von Dir erhebt sich eine maechtige Felswand. In dieser Wand "
    "befindet sich ein mit Holzbalken abgestuetzer Eingang zu einer Mine. "
    "Aus dem Eingang fuehren Schienen ans Tageslicht. Auch hier ist der "
    "Boden von dem feinen, roten Sand bedeckt. Ab und zu blitzen weisse "
    "Knochen aus dem Sand hervor, waehrend die Sonne gnadenlos auf Dich "
    "herab brennt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 60, ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "betrete", "betret" }), "cmd_betreten" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "wueste:26:10" );
  AddExit( "nordwesten", ROOM "wueste:25:10" );
  AddExit( "westen", ROOM "wueste:25:11" );
  AddExit( "nordosten", ROOM "wueste:27:10");
  AddExit( "suedwesten", ROOM "wueste:25:12");

}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(!str || str == "") return 0;
  if(!(str == "mine" ||
       str == "eingang" ||
       str == "mineneingang")) return 0;

  write(BS("Du betritts die Mine."));
  Message(BS(TPN+" betritt die Mine."), MSGFLAG_VISUAL);

  TP->move(ROOM "mine/mine_1_1", M_GO);
  return 1;
}
