#include "../def.h"

inherit ROOM "lager/std_lager_room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier an einer kleinen Wasserstelle. Hier ist es etwas kuehler "
    "als in der Wueste, aber dennoch sehr heiss. Neben dem Wasserloch "
    "befindet sich eine erkaltete Feuerstelle. Im Norden, Westen und Nordwesten "
    "kannst du Zelte erkennen. Wer ist denn so wahnsinnig und stellt "
    "in dieser Todeswueste Zelte auf?");

  SetProp(P_LIGHT, 2);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wasserstelle" }),
    "Ein kleines Wasserloch im Boden bildet hier eine kleine Wasserstelle.");

  AddDetail( ({ "loch", "wasserloch" }),
    "In einem Loch am Boden befindet sich etwas Wasser.");

  AddDetail( ({ "feuerstelle" }),
    "Ein paar Schritt neben der Wasserstelle befindet sich eine Feuerstelle, "
    "die jedoch schon abgekuehlt ist. Es befindet sich nur mehr etwas "
    "Asche darin.");

  AddDetail( ({ "zelte" }),
    "Noerdlich und Westlich von hier wurden ein paar Zelte aufgestellt. "
    "Um mehr zu erkennen musst Du schon naeher ran gehen.");

  AddDetail( ({ "wasser", "bruehe" }),
    "Eigentlich ist es mehr eine schlammige Bruehe, aber wer wird sich schon "
    "mitten in einer Wueste darueber beschweren, dass das Wasser nicht ganz "
    "so hervorragend schmeckt.");

  AddDetail( ({ "schritt", "menschenschritt" }),
    "Es handelt sich um ein paar Menschenschritt");

  AddDetail( ({ "asche", "ueberreste" }),
    "Die Asche stellt die letzten verbliebenen Ueberreste eines Feuers dar.");

  AddDetail( ({ "feuer" }),
    "Hier brennt schon laenger keines mehr.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "trink", "trinke" }),    "cmd_trinken" );
  AddCmd( ({ "zuend", "zuende"}), "cmd_anzuenden" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden",     ROOM "lager/lager_1_0" );
  AddExit( "nordosten",  ROOM "wueste:10:3" );
  AddExit( "osten",      ROOM "wueste:10:4" );
  AddExit( "suedosten",  ROOM "wueste:10:5" );
  AddExit( "sueden",     ROOM "wueste:9:5" );
  AddExit( "suedwesten", ROOM "wueste:8:5" );
  AddExit( "westen",     ROOM "lager/lager_0_1" );
  AddExit( "nordwesten", ROOM "lager/lager_0_0" );

//--Items------------------------------------------------------------------
  
  AddItem( NPC "lager/miriel", REFRESH_DESTRUCT );
  AddItem( NPC "lager/polber", REFRESH_DESTRUCT );
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_trinken(string str)
{
  object ob;
  notify_fail("Was willst Du trinken?\n");
  if(!(str == "wasser" ||
       str == "aus wasserloch" ||
       str == "aus wasserstelle" ||
       str == "von wasserloch" ||
       str == "von wasserstelle" )) return 0;

  write(BS("Du trinkst etwas Wasser und fuehlst Dich gleich gekuehlt."));
  say(BS(TPN+" trinkt etwas Wasser."));
  if(!present("\ngwenshara_todeswueste_chill", TP))
  {
    ob = clone_object(ARMOUR "kuehlung");
    ob->move(TP, M_GET|M_NOCHECK);
    ob->DoWear(1);
  }
  return 1;
}

int cmd_anzuenden(string str)
{
  notify_fail("Was willst Du anzuenden?\n");
  if(!(str == "feuerstelle an" ||
       str == "feuer an")) return 0;

  write(BS("Leider hast Du kein Brennmaterial bei Dir."));
  return 1;
}
