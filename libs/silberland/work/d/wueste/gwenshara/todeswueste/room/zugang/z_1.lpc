#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem engen Tal");
  SetProp(P_INT_LONG,
    "Du befindest Dich hier am Anfang - oder am Ende - eines engen Klammtals. "
    "links und rechts von Dir erheben sich steile Felswaende in die Hoehe. An "
    "einer der Waende befindet sich ein Lehmhaus, vor dem einige Kamele an "
    "einer Tranke angebunden. Die schmale Klamm fuehrt im Westen in die "
    "offene Wueste hinaus und im Osten weiter ins Gebirge.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "anfang", "ende" }),
    "Hier beginnt, oder endet, das enge Klammtal.");

  AddDetail( ({ "tal", "klamm", "klammtal" }),
    "Diese enge Klamm fuehrt hier von West nach Ost. Seitlich erheben sich "
    "sehr hohe und steile Felswaende. Der Himmel ist nur noch als duenner "
    "blauer Streifen zu erkennen.");

  AddDetail( ({ "waende", "felswaende" }),
    "Die Felswaende sind sicher mehere hundert Meter hoch. Wenn von dort "
    "oben ein Stein auf Dich herunterfaellt, tut es sicher weh.");

  AddDetail( ({ "hoehe" }),
    "Das sind sicher ein paar hundert Meter.");

  AddDetail( ({ "haus", "lehmhaus" }),
    "Dieses Lehmhaus besteht eigentlich aus einem Haupthaus und einem Anbau. "
    "Ueber der Tuer befindet sich ein Holzschild und davor steht eine "
    "Traenke, an der zwei Kamele angebunden sind.");

  AddDetail( ({ "kamele", "tiere" }),
    "Die beiden Tiere schaun doof drein und trinken ab und zu einen Schluck.");

  AddDetail( ({ "traenke" }),
    "Sie ist halb voll mit Wasser.");

  AddDetail( ({ "wueste" }),
    "Die Wueste liegt im Westen.");

  AddDetail( ({ "himmel", "streifen" }),
    "Weit ober Dir erkennst Du den Himmel nur als duennen, blauen Streifen.");

  AddDetail( ({ "haupthaus" }),
    "Das Haupthaus ist etwas groesser und hat einen Eingang.");

  AddDetail( ({ "anbau" }),
    "Der Anbau ist eindeutig etwas spaeter gebaut worden. Er hat keine Tuer "
    "und nur kleine Fenster.");

  AddDetail( ({ "schild", "holzschild" }),
    "Es ist aus Holz und beschrieben.");

  AddDetail( ({ "tuer", "eingang", "rahmen", "holzrahmen" }),
    "Die Tuer hat einen einfachen Holzrahmen und ein Schild darueber.");

  AddDetail( ({ "schluck" }),
    "Die Kamele trinken ab und zu einen Schluck Wasser.");

  AddDetail( ({ "holz", "palmenholz" }),
    "Es handelt sich vermutlich um Palmenholz.");

  AddDetail( ({ "wasser" }),
    "Du koenntest auch davon trinken!");

  AddSound( ({DEFAULT_SOUND, "wind"}),
    "Der Wind pfeift durch die Klamm.");

  AddReadDetail( ({"schild", "holzschild"}),
    "'Zur goldenen Duene'");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "trinke", "trink" }), "cmd_trinken" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM+"zugang/z_0");
  AddExit( "osten", ROOM+"zugang/z_2");
  AddExit( "haus", "in das Haus#"+ROOM+"/zugang/haupthaus");
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "wasser" ||
       str == "wasser aus tranke")) return 0;

  write(BS("Du trinkst etwas Wasser aus der Tranke."));
  write(BS("Die Kamele schaun Dich verdattert an."));
  say(BS(TPN+" erregt die Aufmerksamkeit der Kamele, in dem "+
      TP->QueryPronoun()+" aus der Tranke trinkt."));

  return 1;
}
