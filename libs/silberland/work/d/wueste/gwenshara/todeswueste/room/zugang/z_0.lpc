#include "../def.h"

#define DROOM "/d/wueste/zordan/desert/room"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Wueste");
  SetProp(P_INT_LONG,
    "Rings um Dich herum befindet sich die offene Wueste. Sand erhebt sich "
    "in meterhohen Duenen und weht Dir ins Gesicht. Im Osten erkennst Du "
    "einen Einschnitt im Gebirge, den man als Klamm bezeichnen koennte. Der "
    "Himmel ueber Dir bestrahlt Dich mit Hitze. Karavanenspuren fuehren "
    "nach Westen und in die Klamm.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 52, ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "wueste" }),
    "Sie befindet sich ueberall um Dich herum.");

  AddDetail( ({ "sand" }),
    "Dieser feinkoernige, gelbe Sand bedekt alles um Dich herum und kriecht "
    "in jede Ritze.");

  AddDetail( ({ "duenen", "duene" }),
    "Um Dich herum befinden sich meterhohe Duenen aus Sand. In einer Duene "
    "erkennst Du etwas Weisses hervorblitzen.");

  AddDetail( ({ "gesicht" }),
    "Dein Gesicht ist schon ganz rau und trocken.");

  AddDetail( ({ "osten", "einschnitt", "gebirge", "klamm" }),
    "Im Osten erhebt sich ein maechtiges Gebirge, das die Wueste begrenzt. "
    "Wie ein dunkler Strich erkennst Du einen Einschnitt darin. Es sieht aus "
    "als haette sich vor vielen Jahrtausenden ein Fluss hindurch gegraben.");

  AddDetail( ({ "himmel" }),
    "Ueber Dir erstrahlt der Himmel in seinem ganzen Blau.");

  AddDetail( ({ "hitze" }),
    "Ja, eigentlich ist es hier viel zu heiss zum forschen.");

  AddDetail( ({ "spuren", "karavanenspuren" }),
    "Diese Spuren deuten auf den regelmaessigen Karavanenverkehr hin.");

  AddDetail( ({ "ritze" }),
    "Wirklich in JEDE!");

  AddDetail( ({ "weisses" }),
    "Du kannst nicht genau erkennen was es ist. Vielleicht solltest Du die "
    "Duene durchwuehlen?");

  AddDetail( ({ "strich" }),
    "Wie ein dunkler Strich ist der Einschnitt im Gebirge zu erkennen.");

  AddDetail( ({ "jahrtausenden", "jahrtausende" }),
    "Es ist schon lange her, als hier einst ein Fluss floss.");

  AddDetail( ({ "fluss" }),
    "Hier ist keiner. Alles staubtrocken.");

  AddDetail( ({ "blau" }),
    "Der Himmel ist blauer als ein Zechpreller!");

  AddDetail( ({ "verkehr", "karavanenverkehr" }),
    "Hier duerften etliche Karavanen passieren.");

  AddDetail( ({ "zechpreller", "saeufer" }),
    "Diese Saeufer sind meistens zu bis oben hin.");

  AddDetail( ({ "karavanen" }),
    "Das sind die Dinger mit den Kamelen.");

  AddDetail( ({ "dinger", "kamele" }),
    "Karavanen eben.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({ "wind" }),
    "*Pfeiiiiiiiiiiiiiiiif*");

  AddDetail( ({ "ohren" }),
    "Du klappst deine Ohren an und lauschst Dir selbst.");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "durchwuehle", "durchwuehl" }), "cmd_wuehlen" );
  AddCmd( ({ "zerre", "zerr" }), "cmd_zerren" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden",  DROOM+":137:21");
  AddExit( "sueden", DROOM+":137:23");
  AddExit( "westen", DROOM+":136:22");
  AddExit( "nordwesten", DROOM+":136:21");
  AddExit( "suedwesten", DROOM+":136:23");
  AddExit( "osten", ROOM+"/zugang/z_1");
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_wuehlen(string str)
{
  notify_fail("Was willst Du durchwuehlen?\n");
  if(!str || str == "") return 0;
  if(!(str == "duene" ||
       str == "duenen")) return 0;

  write(BS("Du wuehlst in der Duene und ertastest etwas hartes. "
        "Du solltest daran zerren!"));
  say(BS(TPN+" vergraebt "+TP->QueryPossPronoun()+"e Haende in einer "
      "Duene."));

  return 1;
}

int cmd_zerren(string str)
{
  object ob;
  notify_fail("Was willst Du woraus zerren?\n");
  if(!str || str == "");
  if(!(str == "etwas aus duene" ||
       str == "etwas hartes aus duene")) return 0;

  ob = clone_object("koerperteil");
  if(ob->move(TP, M_GET) != 1)
  {
    write(BS("Du zerrst an dem Ding an und laesst es fallen!"));
    say(BS(TPN+" zerrt etwas aus einer Duene hervor."));
    ob->move(TO);
  }
  write(BS("Du zerrst etwas aus der Duene und steckst es ein."));
  say(BS(TPN+" zerrt etwas aus einer Duene."));
  
  return 1;
}
