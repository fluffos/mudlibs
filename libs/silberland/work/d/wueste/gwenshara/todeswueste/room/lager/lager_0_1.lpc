#include "../def.h"

inherit ROOM "lager/std_lager_room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Vor Dir ragt ein strahlend weisses Zelt auf. Durch das einstrahlende "
    "Sonnenlicht wirst Du beinahe blind, wenn Du zu lange hinsiehst. Auch hier "
    "hat sich der todbringende Sand ausgebreitet. Im Osten erspaehst Du eine "
    "kleine Wasserstelle.");

  SetProp(P_LIGHT, 2);

//--Details----------------------------------------------------------------

  AddDetail( ({ "zelt" }),
    "Vor Dir erhebt sich ein strahlend weisses Zelt. Vereinzelt wurde mit "
    "Goldfaeden paladinische Symbole in die Zeltwand gestickt. Du kannst es "
    "von hier aus problemlos betreten.");

  AddDetail ( ({ "sonnenlicht", "licht" }),
    "Wenn Du zu lange auf das weisse Zelt starrst wird Dich das Licht der "
    "Sonne blind machen." );

  AddDetail( ({ "stelle", "wasserstelle" }),
    "Im Osten erkennst Du eine kleine Wasserstelle. Wenn Du durstig bist "
    "findest Du dort vermutlich Erleichterung.");

  AddDetail( ({ "faeden", "goldfaeden" }),
    "Mit feinen Goldfaeden wurde paladinische Symbole in die Zeltwand "
    "gestickt.");

  AddDetail( ({ "symbole" }),
    "Die Symbole zeigen Rosen und Sonnen. Vermutlich haben sie irgendeine "
    "Schutzfunktion.");

  AddDetail( ({ "wand", "zeltwand" }),
    "Die weisse Zeltwand wurde mit goldenen Symbolen bestickt.");

  AddDetail( ({ "erleichterung", "durst" }),
    "Damit ist Durst gemeint.");

  AddDetail( ({ "rosen", "sonnen", "schutzfunktion", "boese", "boeses", "boesen" }),
    "Die ganzen Rosen und Sonnen schuetzen vielleicht vor dem Boesen.");
//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "starr", "starre" }),    "cmd_starren" );
  AddCmd( ({ "betrete", "betret"}), "cmd_betreten" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden",     ROOM "lager/lager_0_0" );
  AddExit( "nordosten",  ROOM "lager/lager_1_0" );
  AddExit( "osten",      ROOM "lager/lager_1_1" );
  AddExit( "suedosten",  ROOM "wueste:9:5" );
  AddExit( "sueden",     ROOM "wueste:8:5" );
  AddExit( "suedwesten", ROOM "wueste:7:5" );
  AddExit( "westen",     ROOM "wueste:7:4" );
  AddExit( "nordwesten", ROOM "wueste:7:3" );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_starren(string str)
{
  notify_fail("Worauf willst Du starren?\n");
  if(!str || str == "") return 0;
  if(!(str == "wand an" ||
       str == "zeltwand an" ||
       str == "auf zeltwand" ||
       str == "auf wand" ||
       str == "zulange auf wand" ||
       str == "zulange auf zeltwand" )) return 0;

  write(BS("Jetzt bist Du blind - Du bist gewarnt worden!"));
  say(BS(TPN+" starrt durch die Gegend."));
  TP->SetProp(P_BLIND, ([BLIND_TIME:20,
                         BLIND_MSG:"Schwarze Punkte tanzen vor Deinen Augen.\n",
                         BLIND_END_MSG:"Die schwarzen Punkte verschwinden.\n"]));
  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str != "zelt") return 0;

  if(TP->move(ROOM "lager/zelt_paladin", M_GO|M_SILENT) != 1)
  {
    write("Das geht gerade nicht.\n");
    return -1;
  }

  write(BS("Du betrittst das Zelt."));
  say(BS(TPN+" betritt das Zelt."));
  tell_room(find_object(ROOM "lager/zelt_paladin"),
            BS(TPN+" betritt das Zelt."), ({TP}));
  return 1;
}
