#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Lager in der Todeswueste");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50+random(11), ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "sand", "boden" }),
    "Der Boden ist bedeckt von blutrotem Sand.");

  AddDetail( ({"himmel"}),
    "Erbarmungslos brennt die Sonne vom Himmel herunter.");

  AddDetail( ({"sonne", "kreis", "inbegriff", "erbarmungslosigkeit"}),
    "Dieser goldene Kreis ist der Inbegriff der Erbarmungslosigkeit.");

  AddDetail( ({"wueste", "todeswueste"}),
    "Du befindest Dich hier mitten in einer Todeswueste.");

  AddSound( DEFAULT_SOUND,
    "Irgendwo in der Ferne heult der Wind.");

  AddSound( ({ "ferne", "wind" }),
    "Hoffentlich ist das wirklich nur der Wind...");
}
