#include "../def.h"
#include <pub.h>

inherit "std/pub";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Zur glodenen Duene");
  SetProp(P_INT_LONG,
    "Hier befindest Du Dich in einem kleinen Lehmhaus. Es sieht ganz danach "
    "aus, als waerst Du in einer Taverne gelandet. Hier ist ein kleiner "
    "Schankraum mit einer Theke. Der Boden hier besteht lediglich aus "
    "gestampftem Erdboden. Auch die zwei Tische, die hier stehen kuenden "
    "nicht gerade von einem reichen Haushalt. An der hinteren Wand fuehrt "
    "ein kleiner Durchgang weiter ins Innere des Hauses und hinter der "
    "Theke geht es in die Kueche.");

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "kellnerin");
  SetProp(P_PUBKEEPER_NAME, "Kellnerin");
  SetProp(P_PUBMSG_NOKEEPER, "Im Moment ist keine Bedienung hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Im Moment ist es eher unguenstig zu bestellen!"));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Die Kellnerin hat gerade Besseres zu tun."));
  SetProp(P_PUBMSG_FIGHTING, "Die Kellnerin kaempft gerade.\n");
  

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "haus", "lehmhaus" }),
    "Darin befindest Du Dich wohl.");

  AddDetail( ({ "taverne" }),
    "Die Theke und der Duft deuten darauf hin, dass es sich hier um eine "
    "Taverne handelt.");

  AddDetail( ({ "raum", "schankraum" }),
    "Hier werden wohl Getranke und Essen konsumiert.");

  AddDetail( ({ "theke" }),
    "Die Theke besteht aus poliertem Holz. Mit Kreide wurde die Speisekarte "
    "auf die Vorderseite gemalt.");

  AddDetail( ({ "boden", "erdboden", "erde" }),
    "Anscheinend hat sich hier niemand um einen echten Fussboden gekuemmert. "
    "Du stehst lediglich auf platt getrampeltem Erdboden, wie er auch "
    "ausserhalb dieses Hauses zu finden ist.");

  AddDetail( ({ "tische" }),
    "Die beiden Tische sind fleckig und bestehen aus einfachem Palmenholz.");

  AddDetail( ({ "haushalt" }),
    "Scheinbar hat dieser Haushalt Konkurs angemeldet.");

  AddDetail( ({ "wand" }),
    "An der hinteren Wand geht es weiter ins Haus.");

  AddDetail( ({  "waende"  }),
    "Einfache Lehmwaende eben. Nur an der hinterwand befindet sich ein "
    "kleiner Durchgang.");

  AddDetail( ({ "durchgang" }),
    "Der kleine Durchgang fuehrt weiter ins Haus. Vermutlich in einen "
    "Schlafraum.");

  AddDetail( ({ "innere" }),
    "Im hinteren Teil des Hauses verbirgt sich vermutlich ein Schlafraum.");

  AddDetail( ({ "kueche" }),
    "Um in die Kueche zu gelangen musst Du hinter die Theke gehen.");

  AddDetail( ({ "getraenke", "essen" }),
    "Bei den Gedanken an Essen und Getranke grummelt Dein Magen vor sich hin.");

  AddDetail( ({ "holz", "palmenholz" }),
    "Das gleiche Palmenholz, dass hier ueberall verwendet wird.");

  AddDetail( ({ "speisekarte", "vorderseite" }),
    "Mit 'menue' kannst Du sie betrachten.");

  AddSpecialDetail( ({ "fussboden" }), "fussboden");

  AddDetail( ({ "konkurs" }),
    "Pass auf, dass Du nicht bald pleite bist!");

  AddDetail( ({ "schlafraum" }),
    "Den findest Du hinter dem Durchgang.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "kueche", ROOM+"zugang/kueche");
  AddExit( "hinten", ROOM+"zugang/schlafraum");
  AddExit( "raus", "nach Draussen#"+ROOM+"/zugang/z_1");

//--Essen & Trinken--------------------------------------------------------
  AddDrink("Frisches Quellwasser", ({"wasser", "quellwasser"}),
           20, 10, 0, 5,
           ({"Die Kellnerin bringt Dir einen Becher frisches Quellwasser.\n",
             "&& trinkt frisches Quellwasser.\n"}));

  AddFood("Ein Stueck Sandkuchen", ({"kuchen", "stueck", "sandkuchen"}),
           50, 20, 10,
           ({"Die Kellnerin bringt Dir ein Stueck vom Sandkuchen.\n"
	     "Er ist so frisch, dass die Sandkoerner in Deinem Mund knirschen!\n",
             "&& isst ein Stueck staubigen Sandkuchen.\n"}));

  AddDrink("Warmer Pfefferminztee", ({"tee", "pfefferminztee"}),
           50, 25, 0, 10,
           ({"Die Kellnerin bringt Dir einen dampfenden Becher mit "
	     "Tee.\n",
             "&& bekommt einen dampfenden Becher serviert.\n"}));

  AddDrink("Jakob Daniels Gebraeu", ({"gebraeu"}),
           150, 50, 10, 5,
           ({"Die Kellnerin bringt Dir ein Glas mit bernsteinfarbener Fluessigkeit.\n"
	     "Als Du es trinkst, glaubst Du deine Kehle verbrennt! *HUST*",
             "&& trinkt aus einem Glas mit bernsteinfarbener Fluessigkeit und hustet wild.\n"}));

  AddFood("Geiersteak", ({"steak", "geier", "geiersteak"}),
           200, 50, 20,
           ({"Die Kellnerin bringt Dir Steak vom Geier nach Art des Hauses.\n",
             "&& vernichtet ein ganzes Geiersteak.\n"}));

  AddFood("Luxusmenue 'Goldene Duene' fuer 10 Personen", ({"menue", "luxusmenue", "duene"}),
           10000, 0, 0,
           "luxusmenue");
}

void luxusmenue(object spender, object esser)
{
  object *all;
  int portionen, i;
  float percent;
  tell_room(TO, BS(spender->Name(WER)+" ordert das Luxusmenue 'Goldene Duene' "
	    "fuer 10 Personen!"), ({spender}));
  tell_object(spender, BS("Du orderst das Luxusmenue 'Goldene Duene' "
	    "fuer 10 Personen!"));
  tell_room(TO, BS("Kurz darauf wird eine riesige Speiseplatte aus der Kueche gebracht, "
	    "von der jeder ein Stueck abbekommt."));
  tell_room(TO, BS("Die Reste werden eingepackt und "+esser->Name(WEM)+" mitgegeben."),
	    ({esser}));
  tell_object(TO, BS("Die Reste werden eingepackt und Dir mitgegeben."));


  all = filter_array(all_inventory(TO), "interactive");
  portionen = 10;
  if(sizeof(all)<1) return;
  for(i=0;i<sizeof(all);i++)
  {
    percent = 100.0*all[i]->QueryProp(P_FOOD)/all[i]->QueryProp(P_MAX_FOOD);
    all[i]->AddHp((int) (300*percent));
    all[i]->AddSp((int) (300*percent));
  }
  return;
}

string fussboden()
{
  string home;
 
  switch(TP->QueryProp(P_RACE))
  {
    case "Elf": home = "in Elessar";
                break;
    case "Dunkelef": home = "in Dhrkion";
                     break;
    case "Troll": home = "im Trollager";
                  break;
    case "Oger": home = "im Ogerlager";
                 break;
    case "Zwerg": home = "in Felonia";
                  break;
    case "Hobbit": home = "in Derlim";
                   break;
    case "Fee": home = "im Feenschloss";
                break;
    default: home = "in Midas";
	     break;
  }

  if(TP->QueryProp(P_RACE) == "Troll" ||
     TP->QueryProp(P_RACE) == "Oger")
    return "Eigentlich ganz so wie "+home+".\n";

  return "Das ist bei euch "+home+" besser!\n";
}
