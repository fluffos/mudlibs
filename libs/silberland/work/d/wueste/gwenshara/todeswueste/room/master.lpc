#include "../def.h"
#include <wizlevels.h>

#define MAP "/d/wueste/gwenshara/todeswueste/room/map"
#define PATH ROOM "wueste"
#define DETAILMASTER ROOM "detailmaster"
#define TG(x) if(debug && find_player("gwenshara")) tell_object(find_player("gwenshara"), BS("TW: "+x));
#define SPECIALROOMS "/d/wueste/gwenshara/todeswueste/room/special_rooms"

nosave string *map;
nosave int debug;
mapping special_rooms = ([ ]);

void ReadSpecialRooms();
int links_to_special_room(int x, int y);

void load_details()
{
  if(!call_other(DETAILMASTER, "is_parsed"))
    call_other(DETAILMASTER, "Parse");
}

void create()
{
  string file;
  debug = 1;
  if(is_clone(TO))
  {
    TO->remove();
    return;
  }

  TG("Reading Map");
  file = read_file(MAP);
  if(!stringp(file))
  {
    TG("No Map!!!");
    TO->remove();
    return;
  }
  TG("Exploding Map")
  map = explode(file, "\n");
  if(!sizeof(map))
  {
    TG("Keine Map vorhanden!");
    TO->remove();
    return;
  }

  call_other(PATH, "???");
  load_details();
  ReadSpecialRooms();
  debug = 0;
}

void SetDebug(int d)
{
  debug = d;
  return;
}

int room_exists(int x, int y)
{
  if(map[y][x..x] != ".") return 0;
  return 1;
}

mapping get_exits(int x, int y)
{
  mapping exits;
  exits = ([ ]);

  TG("Suche Ausgaenge fuer: "+x+"|"+y)

  if(!room_exists(x, y))
  {
    TG("Keine exits!")
    return exits;
  }
  
  if(room_exists(x-1, y-1))
  {
    TG("Finde: nordwesten")
    if(stringp(links_to_special_room(x-1,y-1)))
    {
      TG("  => Special Room!")
      exits+=(["nordwesten":links_to_special_room(x-1,y-1)]);
    }
    else
      exits+=(["nordwesten":PATH+":"+(x-1)+":"+(y-1)]);
  }
  if(room_exists(x, y-1))
  {
    TG("Finde: norden")
    if(stringp(links_to_special_room(x,y-1)))
    {
      TG("  => Special Room!")
      exits+=(["norden":links_to_special_room(x,y-1)]);
    }
    else
      exits+=(["norden":PATH+":"+x+":"+(y-1)]);
  }
  if(room_exists(x+1, y-1))
  {
    TG("Finde: nordosten")
    if(stringp(links_to_special_room(x+1,y-1)))
    {
      TG("  => Special Room")
      exits+=(["nordosten":links_to_special_room(x+1,y-1)]);
    }
    else
      exits+=(["nordosten":PATH+":"+(x+1)+":"+(y-1)]);
  }
  if(room_exists(x+1, y))
  {
    TG("Finde: osten")
    if(stringp(links_to_special_room(x+1,y)))
    {
      TG("  => Special Room")
      exits+=(["osten":links_to_special_room(x+1,y)]);
    }
    else
      exits+=(["osten":PATH+":"+(x+1)+":"+y]);
  }
  if(room_exists(x+1, y+1)) 
  {
    TG("Finde: suedosten")
    if(stringp(links_to_special_room(x+1,y+1)))
    {
      TG("  => Special Room")
      exits+=(["suedosten":links_to_special_room(x+1,y+1)]);
    }
    else
      exits+=(["suedosten":PATH+":"+(x+1)+":"+(y+1)]);
  }
  if(room_exists(x, y+1))
  {
    TG("Finde: sueden")
    if(stringp(links_to_special_room(x,y+1)))
    {
      TG("  => Special Room")
      exits+=(["sueden":links_to_special_room(x,y+1)]);
    }
    else
      exits+=(["sueden":PATH+":"+x+":"+(y+1)]);
  }
  if(room_exists(x-1, y+1))
  {
    TG("Finde: suedwesten")
    if(stringp(links_to_special_room(x-1,y+1)))
    {
      TG("  => Special Room")
      exits+=(["suedwesten":links_to_special_room(x-1,y+1)]);
    }
    else
      exits+=(["suedwesten":PATH+":"+(x-1)+":"+(y+1)]);
  }
  if(room_exists(x-1, y))
  {
    TG("Finde: westen")
    if(stringp(links_to_special_room(x-1,y)))
    {
      TG("  => Special Room")
      exits+=(["westen":links_to_special_room(x-1,y)]);
    }
    else
      exits+=(["westen":PATH+":"+(x-1)+":"+y]);
  }
  return exits;
}

string *QueryMap()
{
  return map;
}

string QueryPlayerPosition(object pl)
{
  string filename,location,foo,output;
  int xp, yp, i, j;
  if(!objectp(pl)) return "Kein solcher Spieler!\n";

  filename = file_name(ENV(pl));
  if(sscanf(filename, "%s:%d:%d%s", location, xp, yp, foo) != 4)
    return "Nicht in der Todeswueste!\n";
  if(location != ROOM+"wueste") return "Nicht in der Todeswueste!\n";

  output="";
  for(i=0; i<sizeof(map); ++i)
  {
    for(j=0; j<strlen(map[i]); ++j)
    {
      TG("xp == j .. "+xp+" == "+j+"\nyp == i .. "+yp+" == "+i);
      if(xp == j && yp == i) output += "X";
      else                   output += map[i][j..j];
    }
    output += "\n";
  }
  return output;
}

string get_room_sign(int x, int y)
{
 return  map[y][x..x];
}

// NPC
string get_npc()
{
  string *possible_npc, selected;
  possible_npc = get_dir(NPC "*.lpc");
  possible_npc-=({"std_desert_npc.lpc"});
  TG(sprintf("Moegliche NPC sind: %O", possible_npc))
  selected = possible_npc[random(sizeof(possible_npc))];
  selected = explode(selected, ".")[0];
  TG("Waehle NPC: "+selected)
  return NPC+selected;
}

// Special Rooms
void ReadSpecialRooms()
{
  string *lines, path;
  int i, x, y;

  TG("Special Rooms werden aus "+SPECIALROOMS+" gelesen.")
  lines = explode(read_file(SPECIALROOMS), "\n");
    
  for(i=0; i<sizeof(lines); ++i)
  {
    if(sscanf(lines[i], "%d %d %s", x, y, path) != 3) continue;
    TG(x+"|"+y+" => "+path)
    special_rooms += ([x+":"+y:path]);
  }

  TG(sizeof(m_indices(special_rooms))+" Raeume gelesen.")
  return;
}

mapping QuerySpecialRooms()
{
  return special_rooms;
}

string links_to_special_room(int x, int y)
{
  return special_rooms[x+":"+y];
}
