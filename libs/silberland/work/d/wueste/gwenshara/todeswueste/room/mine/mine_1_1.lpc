#include "../def.h"

inherit ROOM "mine/std_mine_room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier beginnt ein Stollen in die Tiefe. In einem sanften Gefaelle "
    "fuehrt der Gang weiter nach Sueden. Leise dringt ein regelmaessiges "
    "Haemmern an dein Ohr. Scheinbar wird die Mine also noch benutzt.");

  SetProp(P_LIGHT, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "stollen", "gang" }),
    "Dieser Stollen hier fuehrt Dich weiter in die Mine hinein.");

  AddDetail( ({ "tiefe", "sueden" }),
    "Im Sueden fuehrt der Gang in eine dunkle Tiefe hinab.");

  AddDetail( ({ "haemmern" }),
    "Dem solltest Du wohl besser lauschen!");

  AddDetail( ({ "ohr" }),
    "Gluecklicherweise hast Du zwei Ohren an Deinem Kopf!");

  AddDetail( ({ "kopf" }),
    "Ja, an dem befinden sich Deine Ohren.");

  AddDetail( ({"gefaelle"}),
    "Nach Sueden hin faellt der Gang ab, da er tiefer hinunter geht.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", "raus#" + ROOM "mine/eingang" );
  AddExit( "suedunten", ROOM "mine/mine_1_2" );
}
