#include "../def.h"

inherit "std/weapon";

int blood, full;

void create()
{
  if(!is_clone(TO) ) return;

  ::create();
  blood = 0;
  full  = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Blutfaenger");
  SetProp(P_LONG,
    "Der Blutfaenger ist eine alte Ritualwaffe der Nekromanten. Er wurde aus "
    "den Knochen eines Drachen geschnitzt. In seiner Blutrinne befinden sich "
    "feine Loecher, durch die das Blut seiner Opfer ins Innere gelangen kann.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Blutfaenger");
  SetProp(P_GENDER, MALE);
  AddId( ({"blutfaenger", "faenger", "dolch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 111);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:16]) );

  SetProp(P_INFO, BS("Wenn sich der Dolch mit Blut vollgesogen hat, kann ein "
          "Schatten beschworen werden, der von weisen Nekromanten unterwerfbar "
          "ist!"));

  AddCmd( ({"beschwoere", "beschwoer"}), "cmd_beschwoeren" );
}

int cmd_beschwoeren(string str)
{
  object ob;
  notify_fail("Was willst Du beschwoeren?\n");
  if(str != "schatten") return 0;

  notify_fail("Der Blutfaenger ist noch nicht bereit!\n");
  if(!full) return 0;
  
  write(BS("Dein Schatten wird lebendig!"));
  say(BS(TP->Name(WESSEN)+" Schatten wird lebendig!"));

  ob = clone_object(NPC "lager/schatten");
  ob->SetOrigin(TP);
  ob->move(ENV(TP), M_NO_SHOW|M_GO|M_NOCHECK);
  return 1;
}

int HitFunc( object enemy ) 
{
  if(!random(4) && !full)
    blood++;
  if(blood > 250+random(50))
  {
    tell_object(ENV(TO), BS("Der Blutfaenger hat sich vollgesogen!"));
    full = 1;
  }
  return 0;
}
