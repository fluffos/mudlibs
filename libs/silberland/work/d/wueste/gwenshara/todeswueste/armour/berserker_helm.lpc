#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Stachelhelm");
  SetProp(P_LONG,
    "Dieser Helm ist mit tausenden feiner Stacheln besetzt. Wenn man den ins "
    "Gesicht bekommt tut das sicher Weh!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stachelhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "stachelhelm"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:18]) );

  SetProp(P_EFFECTIVE_WC, 150);
  SetProp(P_DAM_TYPE, DT_PIERCE);
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
