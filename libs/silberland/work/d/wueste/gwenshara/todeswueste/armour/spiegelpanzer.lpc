#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Spiegelpanzer");
  SetProp(P_LONG,
    "Diese Plattenruestung besteht aus auf hochglanz polierten Platten. Du "
    "kannst Dein Spiegelbild darin erkennen. Wenn Licht darauf faellt koennten "
    "Gegner geblendet werden. Diese Ruestung erhalten normalerweise nur "
    "sehr hohe Paladine.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Spiegelpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "spiegelpanzer", "\ngwenshara_spiegelpanzer"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS:15, MAT_TITANIUM:50, MAT_CHROMIUM:30, 
                        MAT_LEATHER:15]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 37);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_LIGHT:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:18, A_DEX:20]) );

  SetProp(P_INFO, BS("Wenn Du geschickt bist kannst Du Deine Gegner mit "
                     "diesem Panzer blenden!") );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  int dur;
  // Chance nach A_DEX und es muss hell sein und Gegner darf nicht blind sein
  if(random(100) > ENV(TO)->QueryAttribute(A_DEX) || 
     ENV(enemy)->QueryProp(P_LIGHT) < 1 ||
     enemy->QueryProp(P_BLIND)) return 0;
  
  tell_room(ENV(ENV(TO)),
            BS(ENV(TO)->Name(WESSEN)+" Panzer reflektiert das Licht der Umgebung!"),
            ({ENV(TO), enemy}));
  tell_object(ENV(TO), BS("Dein Panzer reflektiert das Licht der Umgebung!"));
  tell_object(enemy, BS("Du wirst geblendet!"));

  dur = 2+random(2);
  enemy->SetProp(P_DISABLE_ATTACK, dur);
  enemy->SetProp(P_DISABLE_ATTACK, dur);
  return 0;
}
