#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Aaaah angenehm kuehl.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kuehlung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\ngwenshara_todeswueste_chill"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WATER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-4, T_HEAT_PROT:10]));
  call_out("remove", 300, 1);
}
