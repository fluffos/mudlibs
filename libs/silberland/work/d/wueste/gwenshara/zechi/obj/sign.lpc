#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Das Zeichen des Erwaehlten glueht auf Deiner Stirn!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zeichen des Erwaehlten");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"zeichen", "zeichen des erwaehlten", 
	   "\ngwenshara_sign_of_slayer"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_LIGHT );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
}

string extra_look()
{
  if(!objectp(ENV(TO))) return "";
  return BS("Ein seltsames Zeichen glueht blaeulich auf "+
	 ENV(TO)->QueryPossPronoun()+"er Stirn!");
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();

  if(objectp(ENV(TO)))
  {
    tell_object(ENV(TO), BS("Das Zeichen auf Deiner Stirn verblasst."));
  }
  
  remove(1);
}

