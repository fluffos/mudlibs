//#include "../def.h"
#include <properties.h>
#include "/gilden/zechpreller/zech.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein verziertes Trinkhorn");
  SetProp(P_LONG,
    "Das Horn ist aus dem Horn eines silbernen Drachen gefertigt. Demnach "
    "glitzert es leicht silbern. Es ist mit einigen Edelsteinen verziert und "
    "etwa in der Mitte ist eine Flaeche aus Holz angebracht, damit man es "
    "greifen kann. Wie es heisst, gehoerte dieses Trinkhorn einst Torxes, "
    "einem der ersten unter den Zechprellern."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trinkhorn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"horn", "trinkhorn", GQID+"7", GQID}) );
  AddAdjective( ({"verziertes", "verzierte", "verzierten", "verziertem"}) );
  SetProp(P_NAME_ADJ, "verziert");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:30, MAT_HORN:50, MAT_SILVER:10, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 60);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
