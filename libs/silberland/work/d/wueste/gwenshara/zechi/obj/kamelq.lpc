#include "../def.h"

inherit "std/thing";

#include <properties.h>

int flag0, flag1;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  flag0=0;
  flag1=0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Ja was is denn das?" );
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Kamel-Questchen");
  SetProp(P_GENDER, MALE);
  AddId("\nkamel_quest");

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_AUTOLOADOBJ, 1);
}

int QueryFlag(int i)
{
  if(!i) return flag0;
  if(i==1) return flag1;
  return -1;
}

void SetFlag(int flag)
{
  if(!flag) flag0 = 1;
  else if(flag==1) flag1 = 1;
}
