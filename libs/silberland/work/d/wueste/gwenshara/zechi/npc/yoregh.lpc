#include "../def.h"
//#include "/d/wueste/gwenshara/estadt/basari.h"
#define TG(x) tell_object(find_player("gwenshara"), x)
#define BASARIMASTER "/d/wueste/gwenshara/estadt/master/basarimaster"
#define BASARIROOM "/d/wueste/gwenshara/estadt/room/basari/"

inherit "/d/wueste/gwenshara/estadt/std/std_basari_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine zwielichtige Gestalt");
  SetProp(P_LONG,
    "Diese Gestalt ist ein Wuestenraeuber wie er im Buche steht. "
    "Er traegt einen blauen Kaftan und einen weissen Turban. Als "
    "Guertel dient ihm ein breites, rotes Stoffband. Sein verschlagenes "
    "Laecheln wird von einem schwarzen Bart eingerahmt. Allerdings scheint "
    "er einige Probleme zu haben."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Yoregh");
  SetProp(P_GENDER, MALE);
  AddId(({"gestalt","raeuber","wuestenraeuber", "yoregh", "\nzech_trio_npc"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Sowas brauche ich nicht!\n" }) );


  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:     -0.2, DT_WATER:       0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );
  SetProp(P_NOATTACK, "sagt: Ich habe schon genug Probleme!");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "hat noch etwas an einem anderen Ort zu erledigen");
  SetProp(P_MNPC_AREA, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, ({
			"versteht Dich doch gar nicht.\n",
			"murmelt etwas vor sich hin.\n",
			"sagt: Nein!\n",
			"sagt: Frag' mich doch nicht.\n"}));
  
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
  
  AddInfo( ({"problem","probleme","hilfe", "problemen"}),
	   "Oh... das ist eine laaange Geschichte.\n", "sagt: ");
  
  AddInfo( ({"geschichte"}),
	   "Jaja... Wir, das heisst meine Freunde und ich, haben es "
	   "geschafft! Wir sind als erste in die geheime Schatzkammer "
	   "der Wuestenzwerge eingedrungen. Oh, die Schaetze, die dort "
	   "liegen! Schnell haben wir sie an uns gerafft und sind abgehauen...\n"
	   "Und dann hat man uns erwischt... Toremoton haben sie geschnappt "
	   "und  in den Kaefig hier heroben eingesperrt. Mutan konnte, "
	   "so hoffe ich, in unser Lager fliehen. Wenn und doch jemand helfen "
	   "koennte... Wir muessen hier weg!\n", "erzaehlt: ");
  
  AddInfo( ({"freunde", "freund"}),
	  "Toremoton, Mutan und ich sind die besten Freunde.\n", "sagt: ");
  
  AddInfo( ({"kammer","schatzkammer"}),
	  "Tief unter uns liegt eine Kammer. Sie ist bis oben hin gefuellt "
	  "mit Schaetzen! Keiner kommt an den Fallen der Wuestenzwerge vorbei.\n",
	  "wispert verschwoererisch: ");
  
  AddInfo( ({"zwerge","wuestenzwerge"}),
	  "Hier handeln die Wuestenzwerge mit allerlei sachen.\n", "meint: ");
  
  AddInfo( ({"schaetze","schatz"}),
	  "Jede Menge Gold und Edelsteine!\n", "sagt: ");
  
  AddInfo( ({"toremoton"}),
	  "Den haben die Wuestenzwerge erwischt und in den Kaefig gesperrt. "
	  "Ich waere Dir sehr verbunden, wenn Du ihn da raus holen koenntest "
	  "und uns ein Kamel besorgst damit wir verschwinden koennen.\n", "fluestert: ");
  
  AddInfo( ({"kaefig"}),
	  "In dem Kaefig am Nordende des Basars sitzt mein Freund!\n", "spricht: ");
  
  AddInfo( ({"mutan"}),
	  "Mutan ist der schnellste von uns. Er konnte den Zwergen entkommen und ist "
	  "in unser Lager geritten. Er hat einen Teil des Schatzes bei sich.\n", "sagt: ");
  
  AddInfo( ({"lager"}),
	  "Unser Lager liegt viel weiter im Norden, in der Naehe dieses Echsendorfes. "
	  "Wenn Du mir Deine Hilfe anbieten wuerdest, dann geben wir Dir einen Teil "
	  "unseres Schatzes ab!\n", "sagt: ");
  
  AddInfo( ({"fallen"}),
	  "Die Wuestenzwerge koennen meisterliche Fallen bauen.\n", "berichtet: ");

  AddInfo( ({"horn","trinkhorn"}),
          "In der Schatzkammer der Wuestenzwerge haben wir auch ein Trinkhorn "
	  "gefunden... doch es erschien uns nicht sehr wertvoll, wenn Du es "
	  "haben willst, dann hilf mir und Toremoton zu unserem Lager zu "
	  "gelangen!\n", "sagt: ");

  AddCmd( ({"biete","biet"}), "cmd_help");
}

int cmd_help(string str)
{
  notify_fail("Wem moechtest Du was anbieten?\n");
  if(!str) return 0;
  if(!(str == "yoregh hilfe an" ||
      str == "gestalt hilfe an" ||
      str == "zwielichtige gestalt hilfe an" ||
      str == "zwielichtiger gestalt hilfe an")) return 0;

  if(present("\nkamel_quest", TP))
  {
   command_me("sag Du hilfst mir doch schon, "+TPN);
   return 1;
  }

  TP->Message("Du bietest Yoregh Deine Hilfe an.\n");
  ENV(TP)->Message(TPN+" bietet Yoregh Hilfe an.\n", MSGFLAG_NO_TP);
  TP->Message(break_string("Sehr gut "+TPN+". Oeffne bitte den Kaefig, "
			  "in dem Toremoton sitzt. Dann beschaffe uns ein "
	                  "gefuettertes und getraenktes Kamel, auf dem wir "
			  "fliehen koennen. Wir nehmen Dich mit in unser "
                          "Lager und geben Dir dann Deinen Teil unserer Beute!",
			  78, "Yoregh fluestert Dir zu: "));
  ENV(TP)->Message("Die Gestalt fluestert "+TPN+" etwas zu.\n", MSGFLAG_NO_TP);
  clone_object(OBJ "kamelq")->move(TP);
  return 1;
}

void die( int poisondeath )
{
  ::die(poisondeath);
  BASARIMASTER->Msg("Yoregh wird von "+QueryProp(P_KILLER)+" umgebracht.\n");
}

void init()
{
  object ob;
  ::init();
  if(!TP) return;
  if(!ob=present("\nkamel_quest", TP)) return;
  if(ob->QueryFlag(0) + ob->QueryFlag(1) == 2) 
    call_out("StartSequenz", 0, TP);
}

void StartSequenz(object pl)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_PARALYZED, ([PARALYZE_TIME:300,
			     PARALYZE_MSG:"Jetzt nicht!\n",
			     PARALYZE_MSG_OTHER:"",
			     PARALYZE_END:"Dann mal los!\n",
			     PARALYZE_END_OTHER:""]));
  command_me("sag Sehr gut, "+pl->Name(WER, 1)+"! geh mit dem Kamel "
	     "schon mal zum Ausgang des Basars. Ich komme sofort nach!");
  catch(present("\nbasarikamel", ENV(TO))->remove(1));
  pl->move(BASARIROOM "sequencer", M_TPORT|M_SILENT|M_NOCHECK);
  call_out("sequenz", 1, 1, pl);
}

void sequenz(int ab, object pl)
{
  switch(ab)
  {
    case 1: tell_object(pl, BS("Du fuehrst Dein Kamel langsam durch den Basar."));
	    call_out("sequenz", 4, 2, pl);
	    break;
    case 2: tell_object(pl, BS("Fast hast Du den Ausgang erreicht."));
	    call_out("sequenz", 3, 3, pl);
	    break;
    case 3: tell_object(pl, BS("Ploetzlich beginnt ein gewaltiges Chaos am Basar."));
	    call_out("sequenz", 4, 4, pl);
	    break;
    case 4: tell_object(pl, BS("Lautes Rufen toent ueber den Basar. Du beeilst Dich besser!"));
	    call_out("sequenz", 2, 5, pl);
	    break;
    case 5: tell_object(pl, BS("Gerade als Du den Ausgang erreicht hast kommen Yoregh und "
			    "Teremoton an."));
	    tell_object(pl, BS("Yoregh setzt sich auf das Kamel."));
	    tell_object(pl, BS("Teremoton setzt sich auf das Kamel."));
	    tell_object(pl, BS("Du setzt Dich auf das Kamel."));
	    call_out("sequenz", 4, 6, pl);
	    break;
    case 6: tell_object(pl, BS("Mit einem Ruck setzt sich das Kamel in Bewegung."));
	    call_out("sequenz", 3, 7, pl);
	    break;
    case 7: tell_object(pl, BS("Schwankend bewegt sich das Kamel in die offene Wueste hinaus."));
	    call_out("sequenz", 4, 8, pl);
	    break;
    case 8: tell_object(pl, BS("Eine zeitlang bewegt ihr euch entlang der Kamelroute "
			    "Richtung Arrakeen."));
	    call_out("sequenz", 5, 9, pl);
	    break;
    case 9: tell_object(pl, BS("Ihr weicht nun von der Karavanenroute ab und wendet euch "
			    "gen Norden."));
	    call_out("sequenz", 4, 10, pl);
	    break;
    case 10: tell_object(pl, BS("Mit raschen Schritten wankt das Kamel durch die Wueste."));
	     call_out("sequenz", 5, 11, pl);
	     break;
    case 11: tell_object(pl, BS("Vor euch erkennst Du die Palisade eines kleinen Dorfes."));
	     call_out("sequenz", 3, 12, pl);
	     break;
    case 12: tell_object(pl, BS("Ploetzlich regnet es von irgendwo Pfeile und Speere auf "
			     "euch und das Kamel nieder!"));
	     call_out("sequenz", 2, 13, pl);
	     break;
    case 13: tell_object(pl, BS("Das Kamel stuerzt, Du faellst zu Boden!")+
		             BS("Um Dich herum wird alles schwarz."));
	     call_out("sequenz", 7, 14, pl);
	     break;
    case 14: tell_object(pl, BS("Du wachst auf und bemerkst das Du vor dem Dorf stehst."));
	     call_out("sequenz", 2, 15, pl);
	     break;
    case 15: tell_object(pl, break_string("Unser letzter Gefaehrte wurde von den Echsen "
			    "gefangen genommen! Du musst ihn dort rausholen!", 78,
			    "Yoregh teilt Dir mit: "));
	     pl->SetProp(P_PARALYZED, 0);
	     pl->move("/d/wueste/gwenshara/echsendorf/room/ttges_1", 
		      M_NOCHECK|M_TPORT);
	     break;
  }
}
