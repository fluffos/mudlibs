#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
//#include "/d/wueste/gwenshara/estadt/basari.h"
#define BASARIARMOUR "/d/wueste/gwenshara/estadt/armour/basari/"

inherit "/std/npc";

int angebunden;
object owner;

void create() {
  if (!is_clone(TO)) return;
  ::create();
  angebunden = 1;

  SetProp(P_SHORT, "Ein Kamel (angebunden)");
  SetProp(P_LONG, BS(
    "Das Kamel glotzt Dich aus seinen Kamelaugen heraus doof an. "
    "Seine Hoecker wackeln lustig herum. Mit seinem Schwanz peitscht "
    "es ein paar laestige Fliegen weg und seine Ohren wippen auf und "
    "ab."));
  SetProp(P_NAME, "Kamel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"kamel", "tier", "\nbasarikamel"}));

  create_default_npc(10+random(2));
  SetProp(P_HANDS, ({" mit seinen Hoeckern",155,DT_BLUDGEON}));
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 200+random(30));
  SetProp(P_WEIGHT, 70000+random(10000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0,  DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0, DT_MAGIC:   0.0, DT_MIND:  -0.2]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 0); 

  SetProp(P_MSGIN, "wackelt heran");
  SetProp(P_MSGOUT, "wackelt");
  SetProp(P_MMSGIN, "wackelt an");
  SetProp(P_MMSGOUT, "wackelt weiter");

  SetProp(P_DIE_MSG,  " macht 'Muergh' und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, 0);

  AddInfo(DEFAULT_INFO, "macht 'Uerh'.\n");

  // Das Kamel kann ganz boeoeoeoeoese Spells!
  SetProp(P_SPELLRATE, 40);
  AddSpell(4, 170,
           "Das Kamel spuckt Dich an.\n",
	   "Das Kamel spuckt @WEN an.\n",
	   ({DT_ACID, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 230,
           "Das Kamel rammt Dich mit einem Hoecker.\n",
	   "Das Kamel rammt @WEN mit einem Hoecker.\n",
	   ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 290,
          "Das Kamel schreit Dich mit einem 'Uearaghiek' an.\n",
	  "Das Kamel schreit @WEN mit einem 'Uearaghiek' an.\n",
	 ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 340,
	  "Das Kamel trampelt ueber Dich hinweg.\n",
	  "Das Kamel trampelt ueber @WEN hinweg.\n",
	  ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));

 CLONEME(BASARIARMOUR "hoecker");

 AddCmd( ({"bind","binde"}), "cmd_binden");
}

string bindinfo()
{
  if(angebunden) return "Es ist hier angebunden.";
  return "Es folgt "+owner->name()+".";
}

int cmd_binden(string str)
{
  notify_fail("Was moechtest Du binden?\n");
  if(!str || str == "") return 0;
  if(!(str == "kamel los" )) return 0;

  if(!angebunden)
  {
    write("Das Kamel ist bereits losgebunden und folgt "+owner->name()+".\n");
    return -1;
  }

  write("Du bindest das Kamel los.\nEs wird Dir nun ueberall hin folgen.\n");
  tell_room(ENV(TO), TPN+" bindet das Kamel los.\n", ({TP}));
  TP->AddPursuer(TO);

  angebunden=0;
  owner=TP;

  SetProp(P_SHORT, owner->Name(WESSEN)+" Kamel");
  SetProp(P_NOATTACK, 1);

  return 1;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  if(!angebunden)
    if(find_player(getuid(owner))) return;
    else                           remove(1);
}

object QueryOwner(){return owner;}
