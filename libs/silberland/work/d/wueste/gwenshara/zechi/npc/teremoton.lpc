#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein gefangener Raeuber");
  SetProp(P_LONG,
    "Der Raeuber traegt einen blauen Kaftan mit einem breiten, roten "
    "Guertel. Sein Gewans ist jedoch verstaubt und sein Gesicht beschmutzt. "
    "Wie es aussieht hat man ihn bei einem Diebstahl erwischt!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Teremoton");
  SetProp(P_GENDER, MALE);
  AddId(({"teremoton", "raeuber", "\nzechi_trio_npc"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -60);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  
//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"raub","diebstahl"}),
    "Rede darueber besser mit Yoregh!",
    "sagt: ");

  AddInfo( ({"yoregh", "wuestenrauber"}),
    "Yoregh ist ein zwielichtiger Geselle! Er streunt am Basar herum und "
    "benoetigt Deine Hilfe!", "sagt: ");
}
