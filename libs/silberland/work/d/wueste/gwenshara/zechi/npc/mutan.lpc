#include "../def.h"
//#include "/d/wueste/gwenshara/estadt/basari.h"
#define BSI(x,y) break_string(x, 78, y)

inherit "/d/wueste/gwenshara/estadt/std/std_basari_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Gefangener");
  SetProp(P_LONG,
    "Dieser Gefangene scheint vormals in feine Seidengewaender gehuellt "
    "gewesen zu sein. Jetzt haengt ihm sein Gewand nur noch in Fetzen "
    "vom Koerper. Es sieht so aus als haette man ihn mit Gewalt festgenommen."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mutan");
  SetProp(P_GENDER, MALE);
  AddId(({"gefangener","raeuber","wuestenraeuber", "mutan", "\nzech_trio_npc"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Was soll ich denn damit?\n" }) );


  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:     -0.2, DT_WATER:       0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );
  SetProp(P_NOATTACK, 1);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, ({
			"fragt: Holst Du mich hier raus?\n",
			"murmelt etwas vor sich hin.\n",
			"sagt: Nein!\n"
			}));
  
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
  
  AddInfo( ({"gefangenschaft"}),
	   "Als ich in unser Lager zurueck wollte, da haben mich diese "
	   "verdammten Echsenmenschen geschnappt und hier eingesperrt!\n", "sagt: ");
  
  AddInfo( ({"lager","weg"}),
	   "Unser Lager liegt am noerdlichen Ende der Wueste.\n", "erzaehlt: ");
  
  AddInfo( ({"freunde", "freund"}),
	  "Toremoton, Yoregh und ich sind die besten Freunde.\n", "sagt: ");
  
  AddInfo( ({"echsenmenschen","echsen","menschen","biester"}),
	  "Diese verdammten Biester haben mich am Weg in mein Lager geschnappt!\n",
	  "knurrt: ");
  
  AddInfo( ({"kammer"}),
	  "In der Kammer neben an sind meine ganzen Sachen. Ich habe bemerkt das die "
	  "Echsen dort auch jede Menge Gold und andere Schaetze aufbewahren.\n", "meint: ");
  
  AddInfo( ({"schaetze","schatz"}),
	  "Jede Menge Gold und Edelsteine!\n", "sagt: ");
  
  AddInfo( ({"sachen"}),
	  "Meine Waffen und Ruestungen.\n", "erklaert: ");
  
  AddInfo( ({"horn","trinkhorn"}),
	  "Woher auch immer Du davon weisst... Die Echsen haben es mir abgenommen und "
	  "zu den Schaetzen in der Kammer geworfen.\n", "sagt: ");
  
  AddInfo( ({"mutan"}),
	  "Das bin ich!\n", "sagt: ");
}

void init()
{
  object ob;
  ::init();
  if(!TP) return;
  if(!ob=present("\nkamel_quest", TP)) return;
  if(ob->QueryFlag(0) + ob->QueryFlag(1) == 2) 
    call_out("get_trio", 0, 0, TP);
}

void get_trio(int ab, object pl)
{
  object trio;
  if(!objectp(pl) || !find_player(getuid(pl))) return;
  
  switch(ab)
  {
    case 0: tell_room(ENV(TO), BS("Ploetzlich hoerst Du das Klirren von "
		      "Stahl auf Stahl!"));
            pl->SetProp(P_PARALYZED, ([PARALYZE_TIME:300,
			     PARALYZE_MSG:"Jetzt nicht!\n",
			     PARALYZE_MSG_OTHER:"",
			     PARALYZE_END:"Auf in den Kampf!\n",
			     PARALYZE_END_OTHER:""]));
	    call_out("get_trio", 3, 1, pl);
	    break;

    case 1: tell_room(ENV(TO), BS("Der Kampflaerm verebbt und kurz darauf "
		      "hoerst Du ein Zischen."));
	    call_out("get_trio", 4, 2, pl);
	    break;

    case 2: tell_room(ENV(TO), BS("Du hoerst Gemurmel und dann, wie jemand "
		     "die Treppe zur Ruestkammer hinab geht."));
	    call_out("get_trio", 5, 3, pl);
	    break;

    case 3: tell_room(ENV(TO), BS("Ein dumpfer Schlag ertoent und die Tuer "
		      "erzittert!"));
	    call_out("get_trio", 5, 4, pl);
	    break;

    case 4: tell_room(ENV(TO), BS("Die Tuer splittert! Du erblickst einen "
		      "eindrucksvollen Wuestenraeuber in der Tuer stehen."));
	    call_out("get_trio", 3, 5, pl);
	    break;

    case 5: tell_room(ENV(TO), BSI("Da bist Du ja, "+pl->Name(WER)+"!",
				  "Yoregh, der Wuestenraeuber sagt: "));
	    call_out("get_trio", 3, 6, pl);
	    break;

    case 6: tell_room(ENV(TO), BSI("Aber nun brauchen wir Dich nicht mehr! "
		      "Du stehst uns jetzt nur noch im Weg!",
		      "Yoregh, der Wuestenraeuber sagt: "));
	    call_out("get_trio", 4, 7, pl);
	    break;

    case 7: tell_object(pl, BS("Yoregh stuerzt sich, gefolgt von Teremoton, "
			"zusammen mit Mutan auf Dich!"));
            tell_room(ENV(TO), BS("Der Wuestenraeuber stuerzt sich, gefolgt "
		      "von einem anderen und dem Gefangenen auf "+
		      pl->Name(WER)+"!"), ({pl}));
	    call_out("get_trio", 1, 8, pl);
	    break;

    case 8: trio = clone_object(NPC "trio");
	    trio->move(ENV(TO), M_NOCHECK);
	    trio->Kill(pl);
	    pl->SetProp(P_PARALYZED, 0);
	    remove(1);
	    break;

    default: raise_error("Sequenz-Fehler!");
	     break;
	    
  }
}
