#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Wuestenraeubertrio");
  SetProp(P_LONG,
    "Die drei Wuestenraeuber Yoregh, Teremoton und Mutan. Sie sind aeusserst "
    "ueble Gesellen. Jetzt, da sie wieder vereint sind, werden sie versuchen "
    "ihre Schaetze zurueck zu erlangen und jeden, der ihnen im Weg steht dafuer "
    "umbringen."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Das Wuestenraeubertrio");
  SetProp(P_GENDER, NEUTER);
  AddId(({"raeuber", "yoregh", "teremoton", "mutan", "wuestenraeuber", "\nzech_trio_npc",
	  "NOWIMPY", "NOCONTROL", "NO_MUMMY", "trio", "wuestenraeubertrio"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit ihren Waffen"
                    ,350
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 225000);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.1, DT_WATER:       0.1
     , DT_AIR:      -0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1
     , DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " laeuft davon.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Du Hund! Dich werden wir noch fertig machen!");
  SetProp(P_KILL_MSG, "Haha! Du dachtest doch nicht das Du gegen die "
		      "legaendere Wuestenrauber siegen koenntest!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "interessiert das nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagen: ");

//--Chats------------------------------------------------------------------

  SetAttackChats(10,
  ({"Die Wuestenrauber sturzen sich auf Dich.\n"
   "Yoregh rammt Dich mit seiner Schulter.\n",
   "Teremoton rammt Dir seine Faust in den Magen.\n",
   "Mutan faengt an Dich zu wuergen.\n",
   "Die Wuestenraeuber haben Dich umzingelt!\n",
   "Von allen Seiten prasseln Schlaege auf Dich nieder.\n"
   })
  ); 
}

varargs void die( int poisondeath )
{
  object sign;
  if(QueryProp(P_KILLER))
  write_file("/d/wueste/gwenshara/zechi/log/quest.log",
           getuid(QueryProp(P_KILLER))+" toetet das Trio und erhaelt das "
	   "Zeichen.\n");
  if(!present("\ngwenshara_sign_of_slayer", QueryProp(P_KILLER)))
  {
    sign = clone_object(OBJ "sign");
    sign->move(QueryProp(P_KILLER), M_GET);
  }
  if(present("\nkamel_quest", QueryProp(P_KILLER)))
     present("\nkamel_quest", QueryProp(P_KILLER))->remove(1);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    log_file(LOG "deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

