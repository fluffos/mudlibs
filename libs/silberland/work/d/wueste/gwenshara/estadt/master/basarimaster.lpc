// Der Basar-Master
#include "../def.h"
#include <ansi.h>

string *enemies;
string *listener;
mapping feilscher;

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  enemies = ({ });
  listener = ({"gwenshara"});
  feilscher=([ ]);
  return;
}


/* Die Funs fuer die Autoattacks */
void AddEnemy(object pl)
{
  string uid;
  if(!PO) return;
  if(strstr(file_name(PO), BASARINPC)!=0) return;

  if(!pl)              return;
  if(!interactive(pl)) return;

  uid = getuid(pl);

  if(member(enemies, uid) == -1) enemies += ({ uid });
}

void RemoveEnemy(object pl)
{
  if(!pl)              return;
  if(!interactive(pl)) return;

  if(!member(enemies, getuid(pl))) return;
  enemies-=({getuid(pl)});
}

int IsEnemy(object pl)
{
  string uid;

  if(!pl)              return 0;
  if(!interactive(pl)) return 0;

  uid = getuid(pl);

  if(!(member(enemies, uid) != -1)) return 0;
  return 1;
}

string *QueryEnemies()
{
  return enemies;
}

/* Listening & Logging */
int AddListener(string who)
{
  if(!PO) return 0;
  if(!(PO == find_player("gwenshara"))) return 0;
  if(member(listener, who)) return 0;
  listener+=({who});
  return 1;
}

string *QueryListener()
{
  return listener;
}

void Msg(string s)
{
  object pl;
  int i;
  string str;

   i = sizeof(listener);
  while(i--)
  {
    pl = find_player(listener[i]);

    if(objectp(pl) && interactive(pl) && IS_WIZARD(pl))
    {
      str = BS("BASAR: "+s);
      if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
      tell_object(pl,str);
    }
  }
  write_file(BASARILOG+ctime(time())[20..], ctime()+" "+str);
}

/* Feilschen */
void AddFeilscher(string name, int mult)
{
  if(!PO) return;
  if(strstr(file_name(PO), BASARINPC)!=0) return;
  if(member(feilscher, name))
  {
    feilscher[name]=mult;
  }
  feilscher+=([name:mult]);
}

int QueryMult(string name)
{
  if(!member(feilscher, name)) return 0;
  return feilscher[name];
}

string *QueryFeilscher()
{
  return m_indices(feilscher);
}

int IsFeilscher(string name)
{
  if(!member(feilscher, name)) return 0;
  return 1;
}

/* Reset */

void reset()
{
  enemies   = ({ });
  feilscher = ([ ]);
}
