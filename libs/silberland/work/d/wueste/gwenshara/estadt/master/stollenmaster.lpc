#include "../def.h"
#include <ansi.h>

//--Defines---------------------------------------------------------------
#define CREATION_LOG           LOG "maze.creation"
#define ERROR_LOG              LOG "maze.error"
#define LINE "------\n"

#define MIN_PASSAGE_LENGTH     2
#define PASSAGE_EXTENSION      0

#define E_NORTH                1
#define E_NORTHEAST            2
#define E_EAST                 4
#define E_SOUTHEAST            8
#define E_SOUTH                16
#define E_SOUTHWEST            32
#define E_WEST                 64
#define E_NORTHWEST            128

#define ROOM_PICTURE           ({"...","...","..."})

#define STOLLEN                STOLLENROOM "stollen"

//--Variablen-------------------------------------------------------------
mapping links;      // Speichert die Ausgaenge der Raeume
int width, height;  // Hoehe und Breite
string *passages;   // Alle automatisch generierten Gaenge
string *digged;     // Selbstgegrabene Gaenge
string *open_rooms; // Wird von create_links verwendet um noch nicht
                    // bearbeitete Raeume zu merken
string *open_paths; // Alle noch zu erzeugenden Pfade
int finished;       // Labyrinth fertig?
int stime;          // Zeit zum Messen
mixed errflg;       // Wenn Fehler auftreten != 0
int tries;          // Der wievielte Notfallsneustart ist es?

//--Prototypes------------------------------------------------------------
varargs void InitializeMaze(int _height, int _width);
int CreateNextPath();
int *choose_exits(int x, int y);
void create_links(int x, int y, int maxlength, int length);
void finish_open_rooms();
int is_passage(string room);
int is_digged(string room);
int AddOpenRoom(string r);
int RemoveOpenRoom(string r);
int AddPassageRoom(string r);
varargs int AddExit(string room, int exit, int no_cross);
int _query_finished();
void SetFinished(int i);

void create()
{
  if (is_clone(TO)) return;

  links      = ([ ]);
  width      = 0;
  height     = 0;
  passages   = ({ });
  digged     = ({ });
  open_rooms = ({ });
  open_paths = ({ });
  finished   = 2;


}

//--Query Functions-------------------------------------------------------
mapping _query_links()
{
  return links;
}

int _query_width()
{
  return width;
}

int _query_height()
{
  return height;
}

string *_query_passages()
{
  return passages;
}

string *_query_digged()
{
  return digged;
}

string *_query_open_rooms()
{
  return open_rooms;
}

string *_query_open_paths()
{
  return open_paths;
}

int _query_exits(string room)
{
  if(!member(links, room)) return 0;
  else return links[room];
}

