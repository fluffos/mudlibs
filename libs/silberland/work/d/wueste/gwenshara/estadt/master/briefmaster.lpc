// Questmaster fuer die Postbotenquest
#include "../def.h"
#include "briefmaster.h"
#define SDMASTER "/obj/sehertormaster"


mapping postman;

// Prototypen
void Load();

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  postman = ([ ]);
  
  Load();
  return;
}

// Die Daten aus dem Savefile holen
void Load()
{
  restore_object(SAVEFILE);
}

// Die Daten ins Savefile packen
void Save()
{
  save_object(SAVEFILE);
}

// Wie weit ist der Spieler schon in der Quest?
int GetStatus(object pl)
{
  // Spieler hat die Quest noch nicht gemacht/begonnen
  if(!member(postman, pl)) return -1;
  return postman[pl];
}

// Neuen Status setzen
int SetStatus(object pl, int new_status)
{
  // Hoeher als fertig koennen wir nicht sein
  if(new_status > Q_MAX_STATUS) return -1;
  postman[pl] = new_status;
  return GetStatus(pl);
}

// Naechsten Status setzen
int NextStatus(object pl)
{
  int state;
  if(!member(postman, pl)) state = -1;
  else state = GetStatus(pl);
  
  SetStatus(pl, ++state);
  // Der Spieler hat die Quest beendet!
  if(GetStatus(pl) >= Q_STATUS_END)
  {
    pl->GiveQuest(QUESTNAME);
	// Sehertor als Belohnung
	SDMASTER->DiscoverDoor(DOORROOM);
	if(IS_SEER(pl))
	  tell_object(pl, BS("Du kannst nun das magische Posttor der Stadt nutzen!"));
	else
	  tell_object(pl, BS("Sobald Du Seher bist, kannst Du das magische Posttor "
	                     "der Stadt nutzen!"));
  }
  
  return GetStatus(pl);
}

// Dem Spieler den naechsten Brief geben
int GetMailObject(object pl)
{
  object brief;
  int mov;
  string filename;

  filename  = STADTOBJ;
  filename +=  "brief_";
  filename += BRIEFOBJ[GetStatus(pl)];
  
  brief = clone_object(filename);
  if((mov=brief->move(pl, M_GET|M_NOCHECK)) != 1)
  {
    tell_object(pl, BS("Es kam zu einem Fehler beim Erhalten des naechsten "
	                   "Briefs! Wende Dich bitte an einen Magier!"));
	brief->remove(1);
	return mov;
  }
  
  return 1;
}