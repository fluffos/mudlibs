inherit "std/weapon";

#include <properties.h>
#include <combat.h>


void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Schere");
  SetProp(P_LONG, "Mit einer Schere kann man schneiden, aber sicher "
		  "kannst Du sie auch als Waffe nutzen.");
  SetProp(P_NAME, "Schere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schere"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 59);
  SetProp(P_WC_FIX, 60);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":150, "Messermeister":250, "Unakar":150]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON: 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_SIZE, 20);
  SetProp(P_QUALITY_DECAY, 100); 
}

