inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Opalschwert");
  SetProp(P_LONG,
    "Dieses Schwert ist aus einem einzigen Opal geschliffen. "
    "Es leuchtet gruenlich, da das Licht durch es hindurch scheint. "
    "Sein Griff ist mit blauem Stoff umwickelt. Auf ihm sind "
    "goldene Zeichen gemalt.");
  SetProp(P_NAME, "Opalschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"opalschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OPAL: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 845);
  SetProp(P_SIZE, 65);
  SetProp(P_QUALITY_DECAY, 90);
 
}

