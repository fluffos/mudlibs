inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenschwert");
  SetProp(P_LONG,
    "Das Schwert ist schlank geschmiedet. Es ist im Prinzip ein "
    "Langschwert, wurde nur an die Hand eines Elfen angepasst, so "
    "dass es fuer alle anderen Rassen unmoeglich ist es zu nutzen.");
  SetProp(P_NAME, "Elfenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "elfenschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 155);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["nuarek":178]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_SHADOW: 100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 107);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WIELD_RESTRICTIONS, ([P_RACE:"Elf"]));
 
}

