#include "../def.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein steinener Drachenschwanz");
  SetProp(P_LONG,
    "Dieser Schwanz gehoerte wohl einst zu einem Aquamarindrachen. Er "
    "besteht vollkommen aus dem Stein und hat einen handlichen Griff. "
    "Er laesst sich wie eine Peitsche fuehren und sticht mit seinen "
    "Stacheln in den Gegner.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Drachenschwanz");
  SetProp(P_GENDER, MALE);
  AddId( ({"schwanz", "drachenschwanz"}) );

  SetProp(P_NAME_ADJ, "steinern" );
  AddAdjective( ({"steinernen","steinerner","steinernem","steinernes","steinerne"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_AQUAMARINE );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH, DT_WATER}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:20]) );

  call_other("/p/daemon/itemd/functions/hitfunc2", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfunc2."));

//--Details----------------------------------------------------------------

  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_ITEMD, ({"verletzt mit der Magie des Aquamarindrachen",
		     "nuetzt sich fast gar nicht ab",
		     "ist hochmagisch",
		     "war Teil eines Drachen"}) );
}
