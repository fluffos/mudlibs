inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hobbitstab");
  SetProp(P_LONG,
    "Dieser Wanderstab wurde von einem kundigen Hobbit "
    "zu recht geschnitten. Am oberen Ende hat der Stab "
    "eine lederumwickelte Einkerbung, damit man ihn besser "
    "halten kann.");
  SetProp(P_NAME, "Hobbitstab");
  SetProp(P_INFO, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"hobbitstab", "stab"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["basarbesucher":150]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD: 95, MAT_LEATHER: 5]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 200);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WIELD_RESTRICTIONS, ([P_RACE:"Hobbit"]));
 
}

