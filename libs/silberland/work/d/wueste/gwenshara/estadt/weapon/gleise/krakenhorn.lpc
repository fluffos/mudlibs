#include "../def.h"
#define BRUECKE GLEISEROOM "e2_bruecke"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Horn eines Kraken");
  SetProp(P_LONG,
    "Dieses Horn ist duenn und ungefaehr einen Meter lang. Ausserdem ist es "
    "hohl, so dass man durchblasen kann und damit einen Ton erzeugt. Man kann "
    "es sicher als Degen fuehren.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Krakenhorn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"horn", "krakenhorn"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Du kannst es blasen und damit einen Ton erzeugen."));

  AddCmd( ({"blasen", "blas"}), "cmd_blasen");
}

int cmd_blasen(string str)
{
  object env;
  notify_fail("Was willst Du blasen?\n");
  if(!str || str == "") return 0;
  if(!id(str)) return 0;
  if(!objectp(ENV(TP))) return 0;

  write(BS("Du blaest das Horn und ein tiefes Brummen erfuellt Deine Umgebung."));
  say(BS(TPN+" blaest in ein Horn und ein tiefes Brummen erfuellt die Umgebung."));

  env = ENV(TP);
  if(file_name(env) == BRUECKE)
  {
    call_other(env, "CallOnyxDragon");
    write(BS("Das Horn zerbricht beim Blasen!"));
    remove(1);
  }
  return 1;
}
