inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Opaldolch");
  SetProp(P_LONG,
    "Dieser Dolch ist aus einem kleinen Opal geschliffen. "
    "Er leuchtet gruenlich, da das Licht durch es hindurch scheint. "
    "Sein Griff ist mit rotem Stoff umwickelt. Auf ihm sind "
    "silberne Zeichen gemalt.");
  SetProp(P_NAME, "Opaldolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"opaldolch", "dolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 112);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Dolchkaempfer":50, "Dolchexperte":150, "Dolchmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OPAL: 100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 100);
  SetProp(P_SIZE, 65);
  SetProp(P_QUALITY_DECAY, 60);
 
}

