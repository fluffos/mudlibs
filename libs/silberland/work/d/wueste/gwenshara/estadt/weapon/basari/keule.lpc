inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Kristallkeule");
  SetProp(P_LONG,
    "Die Kristallkeule ist aus einem Stueck Kristall geschliffen. "
    "Sie scheint fuer eine Keule sehr handlich zu sein.");
  SetProp(P_NAME, "Kristallkeule");
  SetProp(P_INFO, "Die Kristallkeule ist fuer eine Keule sehr handlich.");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kristallkeule", "keule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 111);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["wuestenzwerg":150, "basarwaechter":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL: 100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 90);
  SetProp(P_QUALITY_DECAY, 90);
 
}


