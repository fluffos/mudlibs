#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine wuestenzwergische Kampfaxt");
  SetProp(P_LONG,
    "Diese Axt wurde von den Wuestenzwergen in Quaul geschmiedet. Sie hat "
    "einen Holzstiel, der gerade lang genug ist um sie Zweihaendig zu fuehren. "
    "Das Axtblatt ist aus einem dunklen Stahl und mindestens hundert mal "
    "gefaltet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kampfaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "kampfaxt", "\nwzaxt"}) );

  SetProp(P_NAME_ADJ, "wuestenzwergisch" );
  AddAdjective( ({"wuestenzwergischen","wuestenzwergischer",
		  "wuestenzwergischem","wuestenzwergisches",
		  "wuestenzwergische"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:80, MAT_ADAMANT: 20])  );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 257);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["wuestenzwerg":20 ]) );
}
