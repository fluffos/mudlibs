#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der Hammer eines Richters");
  SetProp(P_LONG,
    "Der Hammer ist aus Holz gefertigt. In den richtigen Haenden kann er so "
    "richtig weh tun, in Deinen wird er jedoch nur jede Menge Krach machen."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hammer eines Richters");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"hammer", "richthammer", "richterhammer", "hammer eines richters"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 30);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["hwel as laater":180]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Mit dem Hammer kannst du klopfen um Ruhe zu erbitten."));

  AddCmd( ({"klopfe","klopf","bitte","bitt", "erbitte","erbitt"}), "cmd_silent");
}

int cmd_silent(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "um ruhe" ||
       str == "um ruh"  ||
       str == "mit hammer" )) return 0;

  TP->Message("Du klopfst mit Deinem Hammer und machst jede Menge Krach.\n"
	      "Alles wird leise.\n");
  ENV(TP)->Message(TPN+" klopft mit "+TP->QueryPossPronoun(WESSEN)+"em Hammer "
		  "und macht viel Krach.\nDu wirst ganz leise.\n",
		  MSGFLAG_NO_TP);
  return 1;
}
