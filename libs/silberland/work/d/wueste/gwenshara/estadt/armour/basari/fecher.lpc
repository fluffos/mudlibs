#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int faecherzu = 10;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Faecher");
  SetProp(P_LONG,
    "Der Faecher ist aus Seide gemacht und hat einen Holzgriff. "
    "Er ist gelblich gefaerbt und wuerde wunderbar zu einem roten "
    "Kleid passe. Man kann ihn auf und zu klappen." );
  SetProp(P_INFO, 
         BS("Ein Faecher kann Dich sicher besser kuehlen.") );
  SetProp(P_NAME, "Faecher");
  SetProp(P_GENDER, MALE);
  AddId( ({"faecher", "feenfaecher"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_SILK:90, MAT_WOOD:10 ]) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 550);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:10]));

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );

  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:0, T_HEAT_PROT:6 ]) );
}
