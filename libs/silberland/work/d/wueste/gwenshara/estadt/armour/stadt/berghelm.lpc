inherit "std/armour";           

#include "../def.h"     

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Bergarbeiterhelm");
  SetProp(P_SHORT, "Ein Kopftuch eines Minenarbeiters");
  SetProp(P_LONG, 
      "Dieses Tuch ist so geschnitten, dass man es sich komplett um den Kopf "
	  "wickeln kann. Wenn man das tut bleiben lediglich zwei Schlitze frei, "
	  "durch die Du sehen kannst. Solche Tuecher werden von Minenarbeitern "
	  "getragen und sollen sie vor dem Staub in den Schaechten schuetzen." );
  SetProp(P_INFO,
      "Damit wirst Du sicher ein besserer Graeber (oder -in)!" );
  AddId( ({"tuch", "kopftuch", "arbeitertuch", "arbeiterkopftuch"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 700);
  SetProp(P_MATERIAL, ([ MAT_MISC : 100]) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 100); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp("skill_mod", (["sk_digging":500]));
  SetProp("itemd_no_magic", 1);
  SetProp("itemd", ({"erleichtert das Graben ein Wenig."}));
}

