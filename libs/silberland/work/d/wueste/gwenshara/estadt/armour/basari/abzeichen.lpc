inherit "std/armour";           

#include <properties.h>         
#include <language.h>           
#include <combat.h>             

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Abzeichen des Meisterschneiders");
  SetProp(P_SHORT, "Ein Abzeichen des Meisterschneiders");
  SetProp(P_LONG, 
      "Dieses Abzeichen besagt, das der Besitzer hiervon ein "
      "Meisterschneider ist." );
  SetProp(P_INFO,
      "Wozu man es nur brauchen koennte?" );
  AddId( ({"abzeichen", "abzeichen des meisterschneiders", "\nbasari_abzeichen"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([ MAT_SILK : 100]) );
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 10); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );
}

