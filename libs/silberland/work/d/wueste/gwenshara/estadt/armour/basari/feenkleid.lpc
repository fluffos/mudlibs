#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Feenkleid");
  SetProp(P_LONG,
    "Dieses rote Kleid ist perfekt an die Groesse einer Fee "
    "angepasst. Es reicht einer Fee bis zur Huefte und ist am "
    "Ruecken frei. Es ist an einer Seite vom Oberschenkelbereich "
    "bis zum Ende des Kleides nicht zusammen genaeht, so dass "
    "einer Fee, die dieses Kleid traegt alle Beinfreiheit bleibt, "
    "die sie benoetigt." );
  SetProp(P_INFO, "Dieses Kleid ist extra fuer Feen gemacht." );
  SetProp(P_NAME, "Feenkleid");
  SetProp(P_GENDER, MALE);
  AddId( ({"kleid", "feenkleid"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 22);
  SetProp(P_MATERIAL, ([ MAT_SILK:100 ]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 999);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 90,
                                 P_RACE: "Fee"]));

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}
