#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenumhang");
  SetProp(P_LONG,
    "Dieser Umhang wurde aus feinster Seide gemacht. Er ist so fein "
    "gewebt, dass er fast schon durchsichtig scheint." );
  SetProp(P_INFO, 0 );
  SetProp(P_NAME, "Elfenumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "seidenumhang", "elfenumhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_SILK:100 ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 634);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 95);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}
