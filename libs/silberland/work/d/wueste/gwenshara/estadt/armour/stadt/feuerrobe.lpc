inherit "std/armour";           

#include "../def.h"    
#include "/gilden/druidenzirkel/druiden_extern.h" 
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Hueterrobe");
  SetProp(P_SHORT, "Roben des Hueters der Lohe");
  SetProp(P_LONG, 
      "Diese Roben sind in dunklem rot gealten und ueber und ueber mit goldenen "
      "Flammen bestickt. Bei jeder Bewegung scheint es, als wuerden sie sich von selbst bewegen. "
      "Solche Gewaender traegt sonst nur der Hohe Hueter der Lohe von Quaul." );
  AddId( ({"roben", "robe", "roben des hueters", "roben des hueters der lohe"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 4000);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 80, MAT_GOLD: 10, MAT_MAGIC: 10]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_QUALITY_DECAY, 100); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([ DT_FIRE: 1 ]));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([FEUER:20]));
}

