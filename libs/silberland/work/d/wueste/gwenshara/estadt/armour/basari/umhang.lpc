#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein seidener Umhang");
  SetProp(P_LONG,
    "Dieser Umhang wurde aus feinster Seide gemacht. Er ist so fein "
    "gewebt, dass er fast schon durchsichtig scheint. In den Umhang "
    "wurde eine merkwuerdig schimmernde Rune eingewebt." );
  SetProp(P_INFO, BS("Die eingewebte Rune ist das Siegel von Unakar.") );
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "seidenumhang", "seidener umhang","seidenen umhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([ MAT_SILK:100 ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 634);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 95);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}
