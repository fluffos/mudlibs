#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kamelhoecker");
  SetProp(P_LONG,
    "Dieser Hoecker stammt von einem Kamel. Er ist ganz "
    "haarig und richtig flauschig. Ein paar Sandkoerner finden "
    "sich daran. Man koennte ihn als Helm benutzen, wenn man ihn "
    "ueber den Kopf zieht." );
  SetProp(P_INFO, 0 );
  SetProp(P_NAME, "Kamelhoecker");
  SetProp(P_GENDER, MALE);
  AddId( ({"hoecker", "kamelhoecker"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_MISC_DEAD:90, MAT_HAIR:10 ]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 634);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 70);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}
