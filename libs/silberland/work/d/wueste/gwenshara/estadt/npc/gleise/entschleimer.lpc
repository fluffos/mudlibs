#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zwergischer Arbeiter");
  SetProp(P_LONG,
    "Dieser arme Wuestenzwerg wurde dazu verdonnert die Gleise vom "
    "widerlichen Hoehlenschleim zu entfernen, damit sie nicht so glitschig "
    "sind. Er traegt einen Grubenhelm, der schon ganz schleimbedeckt ist "
    "und einfache Arbeitskleidung. Natuerlich hat er weder Haar noch Bart.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Arbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"arbeiter", "zwerg", "wuestenzwerg"}));
  AddClass( ({ CL_DWARF }) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "zwergisch");
  AddAdjective( ({ "zwergischer", "zwergischem", "zwergische" }) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_MAX_HANDS, 2);;

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Oh danke! Das kann ich brauchen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.1, DT_WATER:       0.2,
       DT_ACID:     -0.1, DT_POISON:   -0.1
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"schleim","hoehlenschleim"}),
    "Heute muss ich die Strecke vom Schleim frei halten!",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 10);

  AddSpell(1, 250,
    Name(WER, 1)+" drischt Dich mit dem Besen windelweich!\n",
    Name(WER, 1)+" drischt @WEN mit dem Besen windelweich!\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sagt: Ich hasse Schleim.\n",
    Name(WER, 1)+" sagt: Das ist so ekelhaft!\n",
    Name(WER, 1)+" schrubt die Gleise.\n",
    Name(WER, 1)+" putzt die Gleise gruendlich.\n",
    Name(WER, 1)+" jammert.\n",
    Name(WER, 1)+" schwingt den Besen.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/d/ebene/ronja/feenquest/weapon/besen");
  command("zuecke besen");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

