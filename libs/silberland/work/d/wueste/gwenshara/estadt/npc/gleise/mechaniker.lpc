#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Baralesch der Wuestenzwergenmechaniker");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg traegt einen hochgebundenen Turban und eine Leder"
    "schuerze. Er hat einen Werkzeugguertel umgebunden und arbeitet hier an "
    "den Gleisen. Wie alle seine Artgenossen hat er keine Haare und keinen "
    "Bart.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Baralesch");
  SetProp(P_GENDER, MALE);
  AddId(({"baralesch", "mechaniker", "zwerg", "NOCONTROL", "Keulenmeister"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " haemmert auf den Gleisen herum und hoert Dich nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"gleise","gleis"}),
    "Dieses Gleisstueck hier wurde eindeutig sabotiert! Verdammte Dunkelelfen!",
    "sagt: ");

  AddInfo( ({"dunkelelfen", "sabotage"}),
    "Dieses Gezuecht schleicht hier in den Gaengen herum und ruiniert "
    "andauernd unsere Gleise!", "sagt: ");

  AddInfo( ({"wagen", "fahrwagen"}),
    "Der Fahrwagen war meine Konstruktion!", "sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" brummelt: Verdammte Dunkelelfen!\n",
    Name(WER, 1)+" sagt: Das war Sabotage!\n",
    Name(WER, 1)+" haemmert auf den Gleisen herum.\n",
    Name(WER, 1)+" schraubt die Gleise fest.\n",
    Name(WER, 1)+" sucht etwas im Werkzeugkoffer.\n",
    Name(WER, 1)+" tauscht ein Gleisteil aus.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/club/hammer" );
  command("zuecke hammer");

  CLONEME( "/p/armour/cloak/lederschuerze" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

