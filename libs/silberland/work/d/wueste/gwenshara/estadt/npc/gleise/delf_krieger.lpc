#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dunkelelfischer Krieger");
  SetProp(P_LONG,
    "Dieser Dunkelelf ist in eine leichte Lederruestung gekleidet und "
    "traegt einen Saebel als Waffe. Offenbar handelt es sich um einen "
    "ihrer Krieger!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dunkelelfenkrieger");
  SetProp(P_GENDER, MALE);
  AddId(({"krieger", "dunkelelf", "\nwz_darkelf", "Schwertkaempfer"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_darkelf(15+random(10), 12+random(8));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" steckt @WEN ein.\n" }) );

//--Tod--------------------------------------------------------------------

  SetProp(P_MURDER_MSG, "Fuer Lloth!");
  SetProp(P_KILL_MSG, "Dein Opfer auf dem Altar meiner Goettin!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " sagt: Verschwinde!\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 25);

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/sword/saebel" );
  command("zuecke saebel");

  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/armour/trousers/lederbeinschienen" );
  CLONEME( "/p/armour/boots/kampfstiefel" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void init()
{
  ::init();
  if(TP->id("wuestenzwerg"))
    Kill(TP);
}
