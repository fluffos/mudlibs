#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit "/std/npc";

string corpse_back();

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hwel as Laater, der Richter" );
  SetProp(P_LONG,
	 "Vor Dir ragt ein, fuer seine Rasse, gewaltiger Wuestenzwerg auf. "
	 "Er hat einen grauen, ordentlich gestutzten Vollbart und ebenfalls "
	 "graue Haare. Seine Augen druecken eine freundliche Art der Strenge "
	 "aus. Er scheint Dir irgendwie, trotz seiner Strenge, sympathisch. Er "
	 "ist hier fuer die Planung des Handels und fuer die Verurteilung von "
	 "Stoerenfrieden zustaendig.");
  SetProp(P_NAME, "Hwel as Laater");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"zwerg", "wuestenzwerg", "richter","hwel","as", "laater","hwel as laater","\nrichter"}));
  SetProp(P_ARTICLE, 0);

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden",155,DT_BLUDGEON}));
  SetProp(P_RACE, "Wuestenzwerg");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 40000+random(1000));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:     -0.2,  DT_COLD:      0.1,  DT_WATER:  0.1, DT_AIR:     0.0,
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR:  0.3,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: -0.2, DT_MIND:    0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "geht in die Wueste");
  SetProp(P_MNPC_AREA, 0);

  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Die Gerechtigkeit siegt immer!");

// Infos
  AddInfo(DEFAULT_INFO, ({
                          "sieht Dich misstrauisch an.\n",
			  "fragt: Wie bitte?\n",
			  "laechelt Dich an.\n",
			  "murmelt: Ja? wirklich?\n",
			  "sagt: Nein, nein, das ist doch ganz leicht!\n",
			  "fragt: Ganz sicher?\n",
			  "meint: Hm... da muss ich umplanen.\n"
                        }));

  AddInfo( ({"garde","basargarde"}),
	   "Die Basargarde passt auf, dass Dir hier nichts geschieht.\n", "sagt: ");

  AddInfo( ({"basar","mada","basari","mada basari"}),
	   "Ja, das ist hier.\n", "sagt: ");

  AddInfo( ({"nftah","barlogor", "ukmant", "nftah barlogor ukmant"}),
	   "Oh, der Arme! Er koennte Deine Hilfe gebrauchen. Am besten redest Du "
	   "einmal mit ihm.\n", "sagt: ");

  AddInfo( ({"bursche","bursch"}),
	   "Nftah Barlogor Ukmant natuerlich!\n", "sagt: ");

  AddInfo( ({"kraterrand", "turm"}),
	   "Oben am Kraterrand, im Turm, befindet sich Nftah Barlogor Ukmant.\n","sagt: ");

  AddInfo( ({"leiche","ueberreste","tod"}), #'corpse_back);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Hwel as Laat sagt: Oh, wenn Du das nicht mehr brauchst...\n" }) );

 CLONEME(BASARIARMOUR "umhang");
 CLONEME("/p/armour/armour/seidenjacke");
 command("trage alles");

 CLONEME(BASARIWEAPON "richthammer");
 command_me("zuecke hammer");

 CLONEME(BASARIOBJ "key");
}

string corpse_back()
{
  object *inv;
  int i;
  call_other(ROOM "aufbewahrungsraum", "???");
  inv=all_inventory(find_object(ROOM "aufbewahrungsraum"));
  for(i=0; i < sizeof(inv); i++)
    if(inv[i]->QueryOwner() == TP)
    {
      call_out("get_back", 1, inv[i]);
      return "sagt: Ahja... Da ist ja Deine Leiche!";
    }
  return "sagt: Ich kann Deine Leiche leider nicht finden.";
}

void get_back(object leiche)
{
  say("Mit einem Lichtblitz erscheint eine Leiche.\n");
  leiche->move(ENV(ME), M_NOCHECK|M_SILENT);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;


  switch(gruppe)
  {
    case "fies":
      call_out("react", 0, "knurrt.", "knurrt.");
      break;

    case "aergerlich":
      call_out("react", 0, "schuettelt den Kopf.",
        "schuettelt den Kopf.");
    break;

    case "frech":
      call_out("react", 0, "laechelt.",
        "laechelt.");
    break;

    case "nett":
      call_out("react", 0, "verneigt sich vor Dir.",
        "verneigt sich vor "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "freut sich.",
        "freut sich.");
    break;

    default:
      call_out("react", 0, "laechelt Dich an.",
        "laechelt "+TP->name()+" an.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

