// Teppichhaendler
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_normnpc";
inherit "std/npc/spells";
inherit "std/player/moneyhandler";

int teppiche;

void create() {
  if (!is_clone(TO)) return;
  ::create();
  teppiche = 5;

  SetProp(P_SHORT, "Alef, der Teppichhaendler");
  SetProp(P_LONG,
    "Alef ist ein eher kleiner, drahtiger Wuestenzwerg. Er traegt "
    "leichtes, weisses Gewand und einen Turban. Wie jeder Wuestenzwerg "
    "hat er keinen Bart. Seine orangenen Augen leuchten froehlich und "
    "er preist immer die neuesten Teppiche an.");
  SetProp(P_NAME, "Teppichhaendler Alef");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"alef","teppichhaendler","NOWIMPY"}));

  create_default_npc(20+random(10));
  SetProp(P_HANDS, ({" mit einem Teppich",175,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_WEIGHT, 30000+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0,  DT_COLD:      0.5,  DT_WATER:  0.5,  DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: -0.5, DT_SOUND:  0.0,  DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "preist hier seine Teppiche an");
  SetProp(P_MMSGOUT, "geht in die Wueste");
  SetProp(P_MNPC_AREA, 0);

  SetProp(P_DIE_MSG,  " rollt sich wie ein Teppich zusammen.\n");
  SetProp(P_NOCORPSE, 0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Alef dankt.\n" }) );

  SetProp(P_SPELLRATE, 20);

  AddSpell(5, 500, "Alef pruegelt mit seinem Teppich auf Dich ein.\n",
                  "Alef pruegelt mit seinem Teppich auf @WEN ein.\n",
                  ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2, 200, DS_DISARM, 
           "Alef schlaegt Dir Deine Waffe aus der Hand.\n",
	   "Alef schlaegt @WEM die Waffe aus der Hand.\n",
           ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 300, "Alef rammt Dir seine Faust ins Gesicht.\n",
	   "Alef rammt @WEM seine Faust ins Gesicht.\n",
           ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));

  //Infos
  AddInfo( DEFAULT_INFO, ({"sagt: Ich habe wunderbare Teppiche!",
			   "sieht Dich gross an.",
			   "fragt: Willst Du nicht lieber einen Teppich kaufen?",
			   "preist seine Teppiche an."}));
  AddInfo( ({"teppich","teppiche", "kamelhaarteppich", "kamelhaarteppiche"}),
          "Ich habe sehr exzelennte Ware. Wenn Du einen Teppich erwerben willst, "
	  "dann kannst Du dies mit <kaufe teppich> tun. Einer meiner Kamelhaarteppiche "
	  "kostet nur 5000 Muenzen!", "sagt: ");

  AddInfo( ({"haar", "kamelhaar"}),
          "Die Haare werden den Kamelen einzeln abgeschoren, damit wird "
	  "beste Qualitaet erzielt! Jeder meiner Teppiche ist mit einer "
	  "Garantie ausgestattet!", "sagt: ");

  AddInfo( ({"garantie"}),
	  "Jeder meiner Teppiche ist garantiert wasserfest und ueberteuert!",
	  "sagt: ");

  AddCmd( ({"kaufe","kauf","bestelle","bestell"}), "cmd_teppich");
}

int cmd_teppich(string str){
  int money;
  object teppich;
  money=TP->QueryMoney();

  notify_fail("Was willst Du kaufen?\n");

  if(!str || str == "") return 0;
  if(!(str == "teppich"  ||
       str == "teppiche" )) return 0;

  if(teppiche <= 0){
    command_me("sag Leider habe ich keine Teppiche mehr.\n");
    return -1;
  }

  if(money < 5000){
    TO->command_me("sag Soviel Geld hast Du doch gar nicht!\n");
    return -1;
  }
  teppich = clone_object(BASARIOBJ "teppich");

  if(teppich->move(TP, M_GET) == ME_TOO_HEAVY)
  {
    command_me("sag Du kannst den Teppich ja gar nicht mehr tragen!");
    teppich->remove(1);
    return 1;
  }
  
  command_me("sag Hier bitte sehr!");
  write("Alef ueberreicht Dir einen Teppich.\n");
  tell_room(ENV(TO), "Alef ueberreicht "+TPN+" einen Teppich.\n", ({TP}));
  TP->AddMoney(-5000);
  "p/daemon/zentralbank"->PayIn(5000, 100);

  return 1;
}
