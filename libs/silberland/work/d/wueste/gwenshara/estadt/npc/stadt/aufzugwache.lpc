#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Aufzugswaechter");
  SetProp(P_LONG,
    "Dieser Zwerg bewacht den Aufzug. Er ist klein und dicklich. Natuerlich "
    "hat er kein einziges Haar am ganzen Koerper.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Aufzugswaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "aufzugswaechter", "zwerg", "wuestenzwerg"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130+random(10));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -1000+random(2000));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+"sagt: Danke schoen!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Nein! Wirklich?\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/axe/obsidianaxt" );
  command("zuecke axt");

  CLONEME( "/p/armour/armour/kettenhemd" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
