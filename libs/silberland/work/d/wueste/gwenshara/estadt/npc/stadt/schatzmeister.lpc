#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  int i;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Haschram, Schatzmeister der Wuestenzwerge");
  SetProp(P_LONG,
    "Dieser Zwerg traegt einen roten Turban mit einem grossen Rubin darauf. "
	"Er hat seinen Bart zu kleinen Zoepfchen geflochten und blickt Dich aus "
	"ernsten Augen an. An seinem Guertel baumelt ein Bund mit unzaehligen "
	"kleinen Schluesseln.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Haschram");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "wuestenzwerg", "haschram", "schatzmeister", "\nws_schatzmeister"}));
  SetProp(P_ARTICLE, 0);

  set_living_name("haschram");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_WEIGHT, 80000+random(20000));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
 
  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Darueber weiss ich nichts. Tut mir leid.");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"schatz"}),
           "Unser Schatz ist gut verwahrt!", "sagt: " );
		   
  AddInfo( ({"kammer", "schatzkammer"}),
           "Hinter diesem Tor aus massivem Zwergenstahl befindet sich unsere "
		   "Schatzkammer!", "sagt: " );
		   
  AddInfo( ({"schloesser", "taefelchen"}),
           "Hinter jeder Marmorplatte verbirgt sich ein gut gesichertes "
		   "Schliessfach.", "sagt: " );
		   
  AddInfo( ({"fach", "faecher", "schliessfaecher"}),
           "Hier kannst Du ein Schliessfach mieten um darin Gegenstaende "
		   "zu verwahren. Sie werden mit einem besondern Verfahren versiegelt, "
		   "so dass nur der Besitzer zugriff auf die Gegenstaende hat.", "sagt: " );
		   
  AddInfo( ({"schluessel", "loecher"}),
           "Die Schatzkammer kann nur mit den richtigen Schluesseln geoeffnet "
		   "werden. Die Schluessel werden von den maechtigsten Wesen der Stadt "
		   "bewacht!", "sagt: " );
		   
  AddInfo( ({"verfahren"}),
           "Mit diesem Verfahren wird der Mieter mittels seiner Seelenkraft an "
		   "das Schliessfach gebunden. Nur er und ich koennen es dann noch "
		   "oeffnen.", "sagt: ");
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
    if(!random(4) && !present("\nwuestenzwerg_schatzwache", ENV(TO)))
    {
        tell_room(ENV(TO), Name(WER, 1) + " ruft laut um Hilfe!\n");
        call_out("hilfe", 2+random(9), ENV(TO));
    }
    return ::Defend(dam, dam_type_list, spell, enemy);
}

void hilfe(object env)
{
    object wache;
    wache = clone_object( STADTNPC "schatzwache" );
    wache->move(env, M_GO|M_NOCHECK);
}
