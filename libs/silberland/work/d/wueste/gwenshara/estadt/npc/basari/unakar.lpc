#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_normnpc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Unakar der Meisterschneider");
  SetProp(P_LONG,
    "Unakar ist ein etwas aelterer Wuestenzwerg. Er traegt "
    "eine gruene Robe und das Abzeichen des Meisterschneiders. "
    "Wie jeder andere Wuestenzwerg ist er komplett unbehaart."
  );

  SetProp(P_NAME, "Schneider Unakar");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:80]));
  AddId( ({"unakar","ladenbesitzer","zwerg","wuestenzwerg"}) );
  AddClass(CL_DWARF); // siehe /sys/class.h

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Haenden",55,DT_BLUDGEON}));
  SetProp(P_RACE, "Wuestenzwerg");
  SetProp(P_SIZE, 130+random(20));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);

  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht in die Wueste");
  SetProp(P_MNPC_AREA, 0);

  AddInfo(DEFAULT_INFO, "Keine Ahnung...","meint: ");
  AddInfo( ({"abzeichen", "abzeichen des meisterschneiders"}),
	  "Mit diesem Abzeichen bin ich offiziell als bester meiner "
	  "Zunft geehrt worden!", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );

  CLONEME(BASARIWEAPON "schere");
  command("zuecke schere");

  CLONEME(BASARIARMOUR "abzeichen");
  command("trage alles");
}
