#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Fahrer der Wuestenzwerge");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg ist etwas dicklicher, als seine Artgenossen. Er "
    "traegt eine leichte Lederkleidung, hat aber so, wie alle Wuestenzwerge "
    "keine Haare - nicht ein Mal einen Bart!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fahrer");
  SetProp(P_GENDER, MALE);
  AddId(({"fahrer", "zwerg", "wuestenzwerg", "\nwz_fahrer"}));
  AddClass( ({ CL_DWARF }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 135);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Nicht mit dem Fahrer sprechen!\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  if(ENV(TO)->id("\nwz_wagen"))
    ENV(TO)->Halt();

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
