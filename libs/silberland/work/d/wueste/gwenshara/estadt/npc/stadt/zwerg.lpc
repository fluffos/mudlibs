#include "../def.h" 

inherit STD "std_stadt_npc";

string *adjectives = ({"klein", "jung", "alt", "gross", "dick", "duenn",
		       "stark", "schwach"});

void create()
{
  int i;
  if(!is_clone(TO)) return;

  ::create();
  i = random(sizeof(adjectives));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+adjectives[i]+"er Wuestenzwerg");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg ist wohl ein Bewohner der Stadt. Er erledigt "
    "hier seine Geschaefte oder geht Vergnuegungen nach. Vielleicht weiss "
    "er auch das eine oder andere.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wuestenzwerg");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "wuestenzwerg", "\nwuestenzwerg"}));
  SetProp(P_NAME_ADJ, adjectives[i]);
  AddAdjective( ({ adjectives[i]+"er", adjectives[i]+"es",
	           adjectives[i]+"en", adjectives[i]+"em" }) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5+random(10));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 80000+random(20000));
  SetProp(P_ALIGN, -1000+random(2000));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+"sagt: Oh! Das kann ich verkaufen!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  STADTROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, STADTROOM "2b3_aufzug");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Darueber weiss ich nichts. Tut mir leid.");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
