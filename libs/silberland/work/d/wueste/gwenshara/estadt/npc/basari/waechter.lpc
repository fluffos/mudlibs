#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_npc";

string *name=({"Shept","Rugosch","Alef","Yxon", "Tulosch", "Xanthos", "Lolgrolosch",
	       "Valvarun", "Perilax", "Pogolosch", "Assarbad", "Muakim", "Torxes",
	       "Tykran", "Arngrimm", "Rakolus", "Sulman", "Murak", "Aluris",
	       "Mengreyth", "Siriom", "Grim"});

void create() {
  string final_name;
  if (!is_clone(TO)) return;
  ::create();

  final_name=name[random(sizeof(name))];

  SetProp(P_SHORT, final_name+", ein Basarwaechter" );
  SetProp(P_LONG, 
	 "Dieser Wuestenzwerg ist fuer die Sicherheit der "
	 "Personen am Basar zustaendig. Er traegt einen "
	 "roten Turban und ein Abzeichen der Basargarde. Es "
	 "waere wohl besser sich nicht mit diesen Basar"
	 "waechtern anzulegen. Sie koennen sicher unangenehm "
	 "werden.");
  SetProp(P_NAME, "Basarwaechter "+final_name);
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"zwerg", "wuestenzwerg", "waechter",
	  "basarwaechter","NOWIMPY", lower_case(final_name), "Dolchkaempfer",
	  "Schwertkaempfer"}));
  SetProp(P_ARTICLE, 0);

  create_default_npc(15+random(10) );
  SetProp(P_HANDS, ({" mit seinen Haenden",155,DT_BLUDGEON}));
  SetProp(P_RACE, "Wuestenzwerg");
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_WEIGHT, 40000+random(1000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0,  DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 1.0,  DT_EXPLOSION: 0.5,  DT_SOUND:  0.0, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR:  0.3,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0, DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt wachsam an");
  SetProp(P_MSGOUT, "geht wachsam");
  SetProp(P_MMSGIN, "tritt seine Wache an");
  SetProp(P_MMSGOUT, "hat Feierabend");
  SetProp( P_MNPC_AREA, BASARIROOM "basari", BASARIROOM "kneipe_zelt" );
  SetProp( P_MNPC_WAIT, ({ 15, 20, 20 }) );
  SetProp( P_MNPC_DEFAULTROOM, BASARIROOM "basari_1x1");
  SetProp( P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES );

  SetProp(P_DIE_MSG,  " geht blutig zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, 0);

// Infos
  AddInfo(DEFAULT_INFO, "sieht Dich misstrauisch an.\n");

  AddInfo( ({"garde","basargarde"}),
	   "Die Basargarde passt auf das Dir hier nichts geschieht.\n", "sagt: ");

  AddInfo( ({"basar","mada","basari","mada basari"}),
	   "Ja, das ist hier.\n", "sagt: ");

  AddInfo( ({"nftah","barlogor", "ukmant", "nftah barlogor ukmant"}),
	   "Ah ja. Der Bursche ist oefters oben, am Kraterrand. Er meinte, "
	   "er koenne Hilfe brauchen.\n", "sagt: ");

  AddInfo( ({"bursche","bursch"}),
	   "Nftah Barlogor Ukmant natuerlich!\n", "sagt: ");

  AddInfo( ({"kraterrand"}),
	   "Oben am Kraterrand, im Turm, befindet sich Nftah Barlogor Ukmant.\n","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Basarwaechter sagt: Sowas habe ich schon gesucht!\n" }) );

 CLONEME(BASARIARMOUR "umhang");
 CLONEME("/p/armour/armour/lederruestung");
 command("trage alles");

 switch(random(2)){
	 case 1: CLONEME(BASARIWEAPON "opalwaffe_schwert");
		 command("zuecke schwert");
		 break;

	 case 2: CLONEME(BASARIWEAPON "opalwaffe_dolch");
		 command("zuecke dolch");
		 break;

	 default: CLONEME(BASARIWEAPON "keule");
		  command("zuecke keule");
		  break;
 }
}

void Attack(object enemy)
{
  if( (enemy->QueryProp(P_HP)) <= (enemy->QueryProp(P_WIMPY)+10) ||
      (enemy->QueryProp(P_HP)) <= 10)
  {
    command_me("sag Ab mit Dir in den Kaefig, "+enemy->name()+"!");
    enemy->Message("Du wirst in den Kaefig geschleppt und eingesperrt!\n");
    //ENV(enemy)->Message(enemy->name()+" wird fort gebracht.\n", ([MSGFLAG_EXCLUDE:({enemy})]));
    enemy->move(BASARIROOM "kaefig", M_NOCHECK, "den Kaefig geschleppt", "wird in", "wird herein geworfen");
    call_other(BASARIROOM "basari_1x2", "CloseDoor");
    call_other(BASARIMASTER, "RemoveEnemy", enemy);
    StopHuntFor(enemy, 1);
    enemy->StopHuntFor(TO, 1);
    return;
  }
  ::Attack(enemy);
  return;
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt.", "knurrt.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "laechelt.",
        "laechelt.");
    break;

    case "nett":
      call_out("react", 0, "verneigt sich vor Dir.",
        "verneigt sich vor "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "freut sich.",
        "freut sich.");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert Dich.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void init()
{
  ::init();

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!(BASARIMASTER->IsEnemy(TP)))   return;

  call_out("angriff", 0, TP);
}

void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand ruft: "
                             : Name(WER,1)+" ruft: ";

  tell_room(ENV(TO),
     "\n"+break_string(pl->Name(WER)+" ist unser Feind! "
             "Toetet "+pl->QueryPronoun(WEN)+"!!!", 78,
             shouter)+"\n");

  Kill(pl);

  return;
}
