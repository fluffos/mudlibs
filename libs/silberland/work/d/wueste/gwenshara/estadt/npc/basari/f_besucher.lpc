#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_npc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Basarbesucherin" );
  SetProp(P_LONG, 
	 "Diese Basarbesucherin hier sucht auf dem Basar "
         "nach exotischen Gegenstaenden und Gewuerzen. Sie "
         "sieht leicht verwirrt aus, vielleicht ob des "
         "ueberweltigenden Angebotes an seltsamen Waren.");
  SetProp(P_NAME, "Basarbesucherin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"besucherin","basarbesucherin"}));

  create_default_npc(10+random(10) );
  SetProp(P_HANDS, ({" mit ihren Haenden",55,DT_BLUDGEON}));
  SetProp(P_RACE, "NPC");
  SetProp(P_SIZE, 170+random(30));
  SetProp(P_WEIGHT, 40000+random(1000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0,  DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 1.0,  DT_EXPLOSION: 0.5,  DT_SOUND:  0.0, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR:  0.3,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0, DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht ");
  SetProp(P_MMSGIN, "sucht hier nach Gewuerzen");
  SetProp(P_MMSGOUT, "geht nach Hause");
 SetProp( P_MNPC_AREA, ROOM "basari", ROOM "kneipe_zelt" );
  SetProp( P_MNPC_WAIT, ({ 20, 20, 20 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "basari_1x1");
  SetProp( P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES );

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, 0);

// Infos
  AddInfo(DEFAULT_INFO, "sieht Dich fragend an.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Basarbesucherin sagt: Sowas habe ich schon gesucht!\n" }) );


 switch(random(2)){
         case 1 .. 2: SetProp(P_RACE, "Fee");
                      SetProp(P_SHORT, "Eine feeische Basarbesucherin");
                      SetProp(P_SIZE, 30);
                      SetProp(P_HANDS, ({" mit Feenmagie",156,DT_MAGIC}));
		      SetProp(P_NAME_ADJ, "feeisch");
		      AddAdjective( ({"feeisch", "feeische", "feeischen",
			         "feeischem"}));
                      AddClass(CL_FAIRY);
		      AddId("fee");
              
                      CLONEME(BASARIARMOUR "feenkleid");
                      CLONEME(BASARIARMOUR "fecher");
                      command("trage alles");
		      break;

          default: SetProp(P_RACE, "Feline");
                   SetProp(P_SHORT, "Ein felinischer Basarbesucher");
                   SetProp(P_SIZE, 170);
		   SetProp(P_HANDS, ({" mit ihren Krallen",170,DT_RIP}));
		   SetProp(P_NAME_ADJ, "felinisch");
		   AddAdjective( ({"felinisch", "flinische", "felinischen",
			         "felinischem"}));
                   AddClass(CL_FELINE);
                   AddId("feline");
 }

}
