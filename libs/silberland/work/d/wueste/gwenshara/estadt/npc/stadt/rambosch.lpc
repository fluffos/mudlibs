#include "../def.h"

inherit "/p/std/npc/berserker_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Rambosch ben Rambolosch");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg ist, fuer einen Vertreter seiner Rasse, gewaltig. "
    "Sein nackter Oberkoerper zeigt furchteinfloessende Muskelpakete und "
    "Taetowierungen. Unzaehlige Narben kuenden von gewonnen Schlachten. "
    "Wie bei all seinen Artgenossen traegt er kein einziges Haar am Koerper. "
    "Er bildet hier wohl die naechste Generation Elitekrieger aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rambosch");
  SetProp(P_GENDER, MALE);
  AddId(({"rambosch", "rambosch ben rambolosch", "zwerg", "wuestenzwerg"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("rambosch");

//--Eigenschaften----------------------------------------------------------

  create_default_berserker(40, 10);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerstoert @WEN mit gewaltiger Kraft.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt mit einem Kampfschrei.\n");
  SetProp(P_MURDER_MSG, "Du wirst an den Wuestenzwergen scheitern!");
  SetProp(P_KILL_MSG, "Niemand kann mich, Rambosch ben Rambolosch, bezwingen!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "bruellt: ROAAAAAAR!!!\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"taetowierungen","taetowierung"}),
    "Fuer jeden besiegten Feind erhalte ich eine Taetowierung! Es sind schon "+100+random(1000)+"!",
    "sagt: ");

  AddInfo( ({"verteidigung", "anlagen", "general", "verteidigungsanlagen" }),
    "Ich bin der General der inneren Verteidiung und damit dafuer verantwortlich, dass "
    "hier keine unserer Feinde durchkommen!", "sagt: ");

  AddInfo( "rambolosch",
    "Rambolosch ben Rambrosch war mein Vater! Ein maechtiger Krieger!", "sagt: ");

  AddInfo( "rambrosch",
    "Rambrosch ben Rambrasch war mein Grossvater! Er war ebenfalls "
    "ein grosser General!", "sagt: ");

  AddInfo( "rambrasch", 
    "Rambrasch kam noch aus dem Gebirge!", "sagt: ");

  AddInfo( "tor", 
    "Das Tor ist verschlossen! Dahinter befindet sich unsere Zitadelle, deren Krieger "
    "mein Volk vor unseren Feinden schuetzen!", "sagt: ");

  AddInfo( "zitadelle",
    "In der Zitadelle werden unsere Elitekrieger ausgebildet. Nur die Besten und "
    "Staerksten schaffen es dort hin!", "sagt: ");

  AddInfo( ({ "besten", "staerksten", "krieger", "elite", "elitekrieger" }),
    "Die Besten der Besten! Du wuerdest keine fuenf Sekunden gegen sie bestehen!",
    "sagt: ");

  AddInfo( "gebirge",
    "Unsere Ahnen stammen aus dem Gebirge.", "sagt: ");

  AddInfo( ({"feinde", "feinden"}),
    "Dunkelelfen, Echsen und andere...", "sagt: ");

  AddInfo( "dunkelelfen", 
    "In letzter Zeit haben wir immer wieder Spione und Spaehtrupps der Dunkelelfen "
    "gefangen genommen. Sie planen etwas!", "sagt: ");

  AddInfo( "echsen",
    "Widerliche Kreaturen!", "grummelt: ");


//  AddLibrary(INFO_STADT, 2, 1);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schreit: Los Jungs! Noch eine Runde!\n",
    Name(WER, 1)+" wandert auf und ab.\n",
    Name(WER, 1)+" wuetet wild herum.\n",
    Name(WER, 1)+" schaerft seine Axt.\n",
    Name(WER, 1)+" fragt: Willst Du Dich mit mir anlegen?\n",
    Name(WER, 1)+" bruellt: Alle Mann, Aaaaachtunk!\n",
    Name(WER, 1)+" sagt: Weiter so, Maenner!\n",
    Name(WER, 1)+" zeigt einigen Kriegern ein paar Tricks mit der Axt.\n",
    Name(WER, 1)+" spaltet eine Holzattrappe in zwei Teile.\n" + Name(WER, 1)+" sagt: So wird das gemacht!\n",
    Name(WER, 1)+" ruft: Nur die besten duerfen den Koenig bewachen! Gebt alles!\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( STADTWEAPON "wzaxt" );
  command("zuecke axt");

  if(!random(3))
   // CLONEME( STADTARMOUR "rubinhandschuhe" );
  //else
    CLONEME( "/p/armour/gloves/titanhandschuhe" );

  if(!random(2))
    CLONEME( "/p/armour/trousers/mithrilbeinlinge" );
  else
    CLONEME( "/p/armour/trousers/titanbeinschienen" );

  CLONEME( "/p/armour/boots/kampfstiefel" );

  if(!random(2))
    CLONEME( "/p/armour/helm/mithrilhelm" );
  else
    CLONEME( "/p/armour/helm/titanhelm" );

  if(!random(3))
    CLONEME( "/p/armour/bracers/plattenzeug" );

  command("trage alles");

}

int _query_wimpy() {
  return 0;
}


void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void init()
{
  ::init();
  if(!objectp(TP)) return;
  if(!TP->id("\nwzkrieger")) return;

  //call_out("riesenkraft", 0, TP);
}
