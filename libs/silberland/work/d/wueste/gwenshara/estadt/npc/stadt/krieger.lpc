#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Krieger der Wuestenzwerge");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg ist stark geruestet. Er dient seinem Volk als "
    "Kaempfer. Demnach wird er all seine Feinde gnadenlos zerschmettern. "
    "Wie alle Wuestenzwerge hat er kein einziges Haar am Koerper.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Krieger");
  SetProp(P_GENDER, MALE);
  AddId(({"krieger", "zwerg", "wuestenzwerg", "\nwuestenzwerg"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130+random(10));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -1000+random(2000));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+"sagt: Danke schoen!\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.1, DT_WATER:       0.2,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  STADTROOM "1" }) );
  SetProp(P_MNPC_DEFAULTROOM, STADTROOM "1c2_wehrgang");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Fuer mein VolK!");
  SetProp(P_KILL_MSG, "Stirb, Feind der Wuestenzwerge!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ignoriert Dich und macht seinen Dienst weiter.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Ausruestung------------------------------------------------------------

  SUID;
  switch(random(3))
  {
    case 1: CLONEME( "/p/weapon/club/kriegshammer" );
            command("zuecke hammer");
	    break;
    case 2: CLONEME( "/p/weapon/axe/kriegsbeil" );
            command("zuecke beil");
	    break;
    default: CLONEME( "/p/weapon/chain/morgenstern" );
            command("zuecke morgenstern");
	    break;
  }

  CLONEME( "/p/armour/armour/kettenhemd" );
  CLONEME( "/p/armour/helm/kettenhaube" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void init()
{
  ::init();
  if(TP->id("\nquaul_npc"))
  {
    TP->AddDefender(TO);
  }
}

void InformDefend(object enemy)
{
  Kill(enemy);
}