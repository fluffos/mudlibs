#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein gehoernter Riesenkraken");
  SetProp(P_LONG,
    "Dieser Riesenkraken ist ein maritimes, in unterirdischen Seen lebendes "
    "Tier. Er hat ein riesiges Horn am Kopf, mit dem er seine Beute zu "
    "Tode sticht um sie dann mit seinem Schnabel zu verspeisen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Riesenkraken");
  SetProp(P_GENDER, MALE);
  AddId(({"kraken", "riesenkraken", "\nkraken", "NOFALLDOWN", "NOWIMPY"}));
  AddClass( ({ CL_ANIMAL }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit seinen acht Tentakeln",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_SQUEEZE})
                    }) );

  SetProp(P_RACE, "Kraken");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 275000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:     -0.1, DT_WATER:      -0.3,
       DT_AIR:       0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.1, DT_LIGHT:     0.3, DT_ELECTRIC:    0.1,
       DT_ACID:     -0.1, DT_POISON:   -0.1 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "tentakelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " sackt in sich zusammen.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 15);

  AddSpell(3, 300,
    Name(WER, 1)+" zerquetscht Dich mit seinen Tentakeln.\n",
    Name(WER, 1)+" zerquetscht @WEN mit seinen Tentakeln.\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_POISON,
    Name(WER,1) + " beisst Dich mit seinem Schnabel!\n",
    Name(WER,1) + " beisst @WEN mit seinem Schnabel!\n" );

  AddSpell(2, 450,
    Name(WER, 1)+" rammt Dich mit seinem Horn.\n",
    Name(WER, 1)+" rammt @WEN mit seinem Horn.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(GLEISEWEAPON "krakenhorn" );
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
