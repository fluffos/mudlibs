#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"
#include "/gilden/berserker/berserker_extern.h"

inherit "/p/std/npc/berserker_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Shept, der Waffenhaendler");
  SetProp(P_LONG,
    "Shept ist ein kleiner aber kraeftiger Wuestenzwerg. Seine "
    "schwarzen Augen funkeln listig, und er hat keinen Bart! Er "
    "ist zwar klein, aber ein nicht zu unterschaetzender Gegner.");

  SetProp(P_NAME, "Waffenhaendler Shept");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:80]));
  AddId( ({"shept","ladenbesitzer", "Axtkaempfer"}) );
  AddClass(CL_DWARF); // siehe /sys/class.h

  create_default_berserker(25, 8);
  SetProp(P_HANDS, ({" mit seinen muskuloesen Armen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);

  //SetProp(P_WIMPY, 0);

  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht in die Wueste");
  SetProp(P_MNPC_AREA, 0);

  AddInfo(DEFAULT_INFO, "Haha! Berech Mugoi! Kann ich helfen?","sagt: ");
  AddInfo( ({"waffe","waffen"}),
          "Ich handle mit allen erdenklichen Arten von Waffen! Wenn Du "
          "etwas ueber Waffen erfahren willst, dann frag mich einfach!\n",
          "sagt: ");
  AddInfo( ({"axt","aexte","beil","beile"}),
          "Aexte und Beile sind sehr maechtige Waffen. Sie werden "
          "bevorzugt von Berserkern gefuehrt. Die meisten von ihnen "
          "sind zweihaendig zu fuehren und schlecht ausbalanciert. "
          "Sie sind ausserdem sehr kopflastig und reine Schwungwaffen.\n",
          "erklaert: ");
  AddInfo( ({"schwert","schwerte","schwerter"}),
          "Die meisten Schwerter sind elegante Einhandwaffen. Sie "
          "werden gerne von Paladinen verwendet, da diese Schwerter "
          "als besonders ehrenhaft betrachten. Trotzdem ist das Schwert "
          "die klassische Waffe eines jeden Abenteurers!\n",
          "erklaert: ");
  AddInfo( ({"keule","keulen"}),
          "Keulen sind sehr plumpe und unschoene Waffen. Es gibt sie "
          "einhaendig sowie zweihaendig. Meist werden sie von Raeubern "
          "oder primitiven Urvoelkern benutzt. Man sagt das im Gebirge "
          "des Silberlands eine Keule von grosser Kraft liegt.\n",
          "erklaert: ");
  AddInfo( ({"messer","dolche", "dolch"}),
          "Messer und Dolche sind kleine und schwache Waffen. "
          "Sie werden oft bei den unheiligen Ritualen der Nekromanten "
          "benutzt oder von anderem lichtscheuem Gesindel verwendet.\n",
          "erklaert: ");
  AddInfo( ({"speer","speere"}),
          "Speere sind lange Waffen mit einem Stiel, meist aus Holz "
          "und einer scharfen Spitze, meist aus Metall. In groesseren "
          "Gefechten oder im Kampf gegen groessere Gegner sind sie "
          "durchaus gut einsetzbare Waffen.\n",
          "erklaert: ");
  AddInfo( ({"peitsche","peitschen"}),
          "Peitschen sind wenig starke Waffen. Die gefaehrlichsten "
          "Peitschen finden bei den Drow, den Dunkelelfen, "
          "Verwendung. Eigentlich kann man Peitschen nur dazu "
          "gebrauchen Tiere zu zaehmen.\n",
          "erklaert: ");
  AddInfo( ({"bogen","boegen","schusswaffe","schusswaffen"}),
          "Boegen und andere Schusswaffen sind leider nicht "
          "sehr weit verbreitet. Am ehesten werden sie von den "
          "verschiedenen Elfenvoelkern benutzt, welche damit "
          "eine unvergleichliche Perfektion erreicht haben.\n",
          "erklaert: ");

  AddInfo( ({"garde","basargarde"}),
	   "Die Basargarde passt auf das Dir hier nichts geschieht.\n", "sagt: ");

  AddInfo( ({"basar","mada","basari","mada basari"}),
	   "Ja, das ist hier.\n", "sagt: ");

  AddInfo( ({"nftah","barlogor", "ukmant", "nftah barlogor ukmant"}),
	   "Ah ja. Der Bursche ist oefters oben, am Kraterrand. Er meinte, "
	   "er koenne Hilfe brauchen.\n", "sagt: ");

  AddInfo( ({"bursche","bursch"}),
	   "Nftah Barlogor Ukmant natuerlich!\n", "sagt: ");

  AddInfo( ({"kraterrand"}),
	   "Oben am Kraterrand, im Turm, befindet sich Nftah Barlogor Ukmant.\n","sagt: ");

  AddInfo( ({"arrakeen","stadt"}),
	   "Arrakeen ist ein grosse Stadt!\n", "meint: ");

   AddInfo( ({"zwerge","wuestenzwerge"}),
          "Die Wuestenzwerge sind ein nahezu unbekanntes Volk! Hier haben "
	  "sie einen festen Platz, auf dem sie Markt halten. Ausserdem haben "
	  "sie hier ihre Warenlager. Es heisst unter dem Basar haben sie eine "
	  "Stadt.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );

  CLONEME("/p/weapon/axe/obsidianaxt");
  command_me("zuecke axt");
}
