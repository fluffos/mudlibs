#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Byrxarzymnixvuem der Onyxdrache");
  SetProp(P_LONG,
    "Vor Dir erhebt sich die Gestalt eines grossen Onyxdrachen. Seine "
    "Schuppen bestehen aus schwarzen Onyxplatten. Gluehend rote Augen "
    "brennen in seinem Gesicht und kleine rauchfahnen steigen aus seinen "
    "Nuestern. Er sieht aus wie eine Bestie aus der Unterwelt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Byrxarzymnixvuem");
  SetProp(P_GENDER, MALE);
  AddId(({"byrxarzymnixvuem", "onyxdrache", "\nonyxdragon"}));
  SetProp(P_ARTICLE, 0);

  set_living_name("byrxarzymnixvuem");

//--Eigenschaften----------------------------------------------------------

  create_default_dragon(0, 4, 2, 5+random(3));

  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHT:     0.2, DT_ACID:      0.1, DT_POISON:   -0.4,
       DT_TERROR:   -0.4]) );

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt mit einem herzzerreisenden Kreischen.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  "/obj/gemmaster"->DistributeGem(15, 6, 0, 1, ({"onyx"}));
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  call_other(GLEISEROOM "e2_bruecke", "CallAquamarinDragon");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void reset()
{
  if(!is_clone()) return;
  ::reset();

  if(InFight() || QueryProp(P_HP) != QueryProp(P_MAX_HP)) return;
  if(objectp(ENV(TO)))
  {
    tell_room(TO, BS(Name(WER)+" fliegt hoch an die dunkelste Stelle der Hoehlendecke."));
  }

  remove(1);
}
