#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dunkelelfischer Schleicher");
  SetProp(P_LONG,
    "Dieser Dunkelelf schleicht hier durch die Gaenge. Er ist leicht "
    "bewaffnet um moeglichst wenig Geraeusche zu verursachen. Was will er "
    "wohl hier?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dunkelelfenschleicher");
  SetProp(P_GENDER, MALE);
  AddId(({"schleicher", "dunkelelf", "\nwz_darkelf", "Schwertkaempfer",
	  "Messerkaempfer"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_darkelf(10+random(10), 9+random(8));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" steckt @WEN ein.\n" }) );

//--Tod--------------------------------------------------------------------

  SetProp(P_MURDER_MSG, "Fuer Lloth!");
  SetProp(P_KILL_MSG, "Dein Opfer auf dem Altar meiner Goettin!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " sagt: Verschwinde!\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
 
//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, GLEISEROOM);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "j2_darkelf");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Ausruestung------------------------------------------------------------

  SUID;
  if(random(2))
  {
    CLONEME( "/p/weapon/sword/saebel" );
    command("zuecke saebel");
  }
  else
  {
    CLONEME( "/p/weapon/knife/langdolch" );
    command("zuecke dolch");
  }

  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void init()
{
  ::init();
  if(TP->id("wuestenzwerg"))
    Kill(TP);
}
