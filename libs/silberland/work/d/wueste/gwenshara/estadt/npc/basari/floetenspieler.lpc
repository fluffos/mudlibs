#include "../def.h"

inherit STD "std_basari_normnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Floetenspieler");
  SetProp(P_LONG,
    "Der Floetenspieler ist von weit her gereist um hier seine Kunst zu "
    "demonstrieren. Er sitzt nun also hier herum und zeigt wie gut er "
    "mit seiner Floete umgehen kann."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Floetenspieler");
  SetProp(P_GENDER, MALE);
  AddId(({"spieler", "floetenspieler"}));
  AddClass( ({CL_HUMAN }) );
  SetProp(P_ARTICLE, 1);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(9+random(5));

  SetProp(P_HANDS, ({" mit seiner Floete"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " beendet sein Floetenspiel.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Dann zeig ich Tod mal wie gut ich spielen kann...");
  SetProp(P_KILL_NAME, "Floetenspieler");
  SetProp(P_KILL_MSG, ({"spielt auf seiner Floete.", MSG_EMOTE}));

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ist in sein Floetenspiel vertieft.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 10);

  AddDefaultSpell(1, 1, DS_PARALYZE,
    Name(WER,1) + " hypnotisiert Dich mit seinem Floetenspiel.\n",
    Name(WER,1) + " hypnotisiert @WEN mit seinem Floetenspiel.\n"
  );

//--Chats------------------------------------------------------------------

  SetChats(5,
  ({Name(WER, 1)+" spielt ein schoenes Lied auf seiner Floete.\n"
   ,Name(WER, 1)+" putzt seine Floete ordentlich durch.\n"
   ,Name(WER, 1)+" ist ganz in sein Floetenspiel versunken.\n"
   ,Name(WER, 1)+" spielt ein schnelles Lied.\n"
   ,Name(WER, 1)+" spielt ein langsames Lied.\n"
   ,Name(WER, 1)+" spielt das Lied 'Alles hat ein Ende nur die Knarkhwurst hat Zwei'.\n"
   ,Name(WER, 1)+" spielt 'Es gibt kein Bier in Elessar'.\n"
   ,Name(WER, 1)+" bittet Dich um Geld.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Gleich hau ich Dich!\n"
   ,Name(WER, 1)+" sagt: Das hat gar nicht weh getan.\n"
   })
  );
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}


void give_notify(object ob)
{
  if(ob->id("\ngeld"))
  {
    command_me("emote bedankt sich herzlich.");
    tell_room(ENV(TO), "Der Floetenspieler spielt ein Lied fuer "+TPN+".\n",
              ({TP}));
    tell_object(TP, "Der Floetenspieler spielt ein Lied fuer Dich.\n");
    return;
  }

  ::give_notify(ob);
}
