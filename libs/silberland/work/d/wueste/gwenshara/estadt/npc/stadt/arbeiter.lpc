#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  object axe;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zwergischer Stollenarbeiter");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg hier ist ein klassischer Minenarbeiter. Er ist "
	"etwas kleiner als seine Artgenossen, dafuer sieht er ungleich kraeft"
	"iger aus. Um seinen Kopf hat er keinen einfachen Turben, sondern ein "
	"Tuch gebunden, das gerade Schlitze fuer die Augen frei laesst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stollenarbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"arbeiter", "stollenarbeiter", "zwerg", "wuestenzwerg"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 100+random(500));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Danke! In den tiefen Stollen ist das sicher nuetzlich!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du wirst den Bau nicht aufhalten!");
  SetProp(P_KILL_MSG, "Tja, ich kann nicht nur schuerfen.");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sieht dich fragend an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"gang", "gaenge", "stollen"}),
    "Dieser Gang ist noch nicht zum Bau freigegeben. Zuerst muessen wir "
    "die Edelsteine hier abbauen.", "sagt: ");

  AddInfo( ({"schuerfen", "edelsteine", "abbauen", "abbau"}),
    "Westlich von hier kann jeder Schatzsucher Edelsteine abbauen. Du brauchst "
    "nur das richtige Werkzeug!",
    "sagt: ");

  AddInfo( ({"werkzeug"}),
    "Du brauchst eine Spitzhacke, wie meine. Die kannst Du im Laden weiter "
    "oestlich von hier kaufen.", "sagt: ");

//--Spells----------------------------------------------------------------

  SetProp(P_SPELLRATE, 80);

  AddSpell(3, 300,
    Name(WER)+" rammt seine Spitzhacke in Dich.\n",
    Name(WER)+" rammt seine Spitzhacke in @WEN.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 200, DS_MASS_DAMAGE,
    Name(WER)+" bewirft Dich mit Dreck.\n",
    Name(WER)+" bewirft Dich mit Dreck.\n",
    DT_BLUDGEON);

  AddSpell(3, 450,
    Name(WER)+" zertruemmert Dein Knie!\n",
    Name(WER)+" zertruemmert @WESSEN Knie!\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/axe/spitzhacke");
  command_me("zuecke spitzhacke");

  CLONEME(STADTARMOUR "berghelm");
  command_me("trage alles");

}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
