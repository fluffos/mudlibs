#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  object axe;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zwergischer Arbeiter lenkt hier einen Kran");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg, haarlos wie jeder seiner Rasse, sitzt hier in "
    "einem der Holzkraene um Kisten zu verladen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kranarbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"arbeiter", "kranarbeiter", "zwerg", "wuestenzwerg", "NOWIMPY"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit seinem Kran",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 100+random(500));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Danke! Sowas hab ich schon lange gesucht!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "beginnt hier mit seiner Arbeit");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot aus seine, Kran.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " ist mit dem Verladen einer Kiste beschaeftigt.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"kisten", "ballen", "ware"}),
    "All die Ware in den Kisten und Ballen wird hier umgeschlagen und verteilt.", "sagt: ");

  AddInfo( ({"kran"}),
    "Um einen solchen Kran zu lenken, benoetigt es jahrelange Uebung!", "sagt stolz: ");


  SetChats(10,
      ({Name(WER, 1)+" laesst eine schwere Kiste hinab in die Tiefe.\n",
        Name(WER, 1)+" hebt mit seinem Kran ein paar Ballen von einem Wagen auf einen anderen.\n",
        Name(WER, 1)+" laesst einen langen Balken nur knapp ueber deinem Kopf vorbeiziehen.\n",
        Name(WER, 1)+" kurbelt den Haken des Krans gaaaanz lange bis in die Tiefe hinab.\n",
        Name(WER, 1)+" oelt ein paar Zahnraeder seines Krans.\n",
        Name(WER, 1)+" disktuiert mit einigen Arbeitern darueber welche Kisten wo hin sollen.\n",
        "Eine Lore wird vom Kran von einer Schiene auf eine andere gesetzt.\n",
        Name(WER, 1)+" kontrolliert den Seilzug seines Krans.\n",
        "Ein schwerbeladener Minenwagen rollt heran und wird prompt von " + name(WEM, 1) + " abgeladen\n",
        "Ein Zwerg wird mitsamt einer Palette vom Kran von unten herauf hier abgesetzt.",
        Name(WER, 1) + " schiebt seinen Kran an eine andere Stelle.\n",
        "Der Kran laedt eine Palette mit Stoffballen ab.\n",
        Name(WER, 1) + " schnautzt einen faulenzenden Arbeiter an.\n"
       }) );

  SUID;
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
