#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  int anz;
  if(!is_clone(TO)) return;

  ::create();
  anz = 3 + random(9);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Gruppe Wustenzwerge kippt hier ein Bierchen nach dem anderen");
  SetProp(P_LONG,
    "An einem der Tische sitzt eine Gruppe kahlkoepfiger Wuestenzwerge und -innen. "
    "Sie scheinen schon etwas angeduedelt zu sein, und dennoch schiebt ihnen der "
    "Wirt ein Mass nach dem anderen ueber den langen Tisch.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gruppe Wustenzwerge");
  SetProp(P_NAME_ADJ, "betrunkene");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zwerge", "gruppe", "betrunkene", "wuestenzwerge", "NOWIMPY"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(19+anz);
  SetProp(P_HANDS, ({" mit ihren Faeusten",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_WEIGHT, 80000 * anz);
  SetProp(P_ALIGN, -200+random(500));
  SetProp(P_MAX_HANDS, 2 * anz);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" schreit: Wirt! Noch ein Bier dafuer!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " loest sich auf. Alle laufen davon.\n");
  SetProp(P_NOCORPSE, 1 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " groehlen nach dem naechsten Bier.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  SetChats(2,
      ({Name(WER, 1)+" kippt ein Bier nach dem anderen.\n",
        Name(WER, 1)+" singt ein Loblied auf Koenig Tarxes.\n",
        Name(WER, 1)+" groehlt laut auf.\n",
        "Der Wirt schenkt " + name(WEM, 1)+" noch eine Runde aus.\n",
        "Ein Zwerg aus der Gruppe fragt: Wer ist heut mit zahlen dran?\n",
        "Ein Mitglied der Zwergengruppe torkelt betrunken zur Ausschank.\n",
        Name(WER, 1)+" faengt lautstark an zu diskutieren.\n",
        "Eine Zwergin ruft: Felonisches Bier - das lob ich mir!!!\n",
        "Ein Zwerg sagt: <HICK>\n",
        "Die Zwerge sehen betrunken aus.\n"
       }) );

  SUID;
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
