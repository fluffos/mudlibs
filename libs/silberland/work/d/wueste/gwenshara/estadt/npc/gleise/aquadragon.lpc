#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Isyfgrikynbraxmik der Aquamarindrache");
  SetProp(P_LONG,
    "Dieser Drache ist unheimlich gross. Sein Koerper ist durchscheinend "
    "und in seinem Inneren leuchtet ein helles Licht. Aus majestaetischen "
    "Augen heraus blickt er Dich an, als wuesste er, dass Du viel zu "
    "schwach bist um etwas gegen ihn auszurichten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Isyfgrikynbraxmik");
  SetProp(P_GENDER, MALE);
  AddId(({"isyfgrikynbraxmik", "aquamarindrache", "\naquamarindrache"}));
  SetProp(P_ARTICLE, 0);

  set_living_name("isyfgrikynbraxmik");

//--Eigenschaften----------------------------------------------------------

  create_default_dragon(3, 10, 2, 15+random(6));

  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHT:    -0.5, DT_ACID:      0.1, DT_POISON:   -0.4,
       DT_WATER:    -0.5 ]) );

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " zerfaellt in einzelne Brocken.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Items------------------------------------------------------------------
 
  "/obj/gemmaster"->DistributeGem(15, 6, 0, 1, ({"aquamarin"}));
  SUID;
  CLONEME(GLEISEWEAPON "schwanz");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

void reset()
{
  if(!is_clone()) return;
  ::reset();

  if(InFight() || QueryProp(P_HP) != QueryProp(P_MAX_HP)) return;
  if(objectp(ENV(TO)))
  {
    tell_room(TO, BS(Name(WER)+" taucht in den See ab."));
  }

  remove(1);
}
