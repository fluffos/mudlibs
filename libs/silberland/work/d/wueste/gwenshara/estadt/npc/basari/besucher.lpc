#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_npc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Basarbesucher" );
  SetProp(P_LONG, 
	 "Dieser Basarbesucher hier sucht auf dem Basar "
         "nach exotischen Gegenstaenden und Gewuerzen.");
  SetProp(P_NAME, "Basarbesucher");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"besucher","basarbesucher", "Keulenkaempfer", "Schwertkaempfer"}));

  create_default_npc(10+random(10) );
  SetProp(P_HANDS, ({" mit seinen Haenden",55,DT_BLUDGEON}));
  SetProp(P_RACE, "NPC");
  SetProp(P_SIZE, 170+random(30));
  SetProp(P_WEIGHT, 40000+random(1000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0,  DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 1.0,  DT_EXPLOSION: 0.5,  DT_SOUND:  0.0, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR:  0.3,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0, DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "sucht hier nach Gewuerzen");
  SetProp(P_MMSGOUT, "geht nach Hause");
  SetProp( P_MNPC_AREA, BASARIROOM);
  SetProp( P_MNPC_WAIT, ({ 20, 20, 20 }) );
  SetProp( P_MNPC_DEFAULTROOM, BASARIROOM "basari_1x1");
  SetProp( P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS);

  SetProp(P_DIE_MSG,  " sagt: Ich habe noch immer nicht das Richtige gefunden!\n"
		      "Dann ist er tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, 0);

// Infos
  AddInfo(DEFAULT_INFO, "sieht Dich fragend an.\n");
  AddInfo( ({"waechter","basarwaechter"}),
	  "Die Basarwaechter halten hier Ordnung.");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Basarbesucher sagt: Sowas habe ich schon gesucht!\n" }) );


 switch(random(12)){
         case 1: SetProp(P_RACE, "Elf");
	         SetProp(P_SHORT, "Ein elfischer Basarbesucher");
		 SetProp(P_NAME_ADJ, "elfisch");
		 AddAdjective( ({"elfisch", "elfischer", "elfischen",
			         "elfischem"}));
                 AddClass(CL_ELF);
		 AddId("elf");

                 CLONEME("/d/kristallwald/sargola/dorf/armour/leggings");
                 CLONEME(BASARIARMOUR "elfenumhang");
		 command("trage alles");
                 
                 CLONEME(BASARIWEAPON "elfenschwert");
                 command("zuecke schwert");
		 break;
		 
         case 2: SetProp(P_RACE, "Mensch");
                 SetProp(P_SHORT, "Ein menschlicher Basarbesucher");
		 SetProp(P_NAME_ADJ, "menschlich");
		 AddAdjective( ({"menschlich", "menschlicher", "menschlichen",
			         "menschlichem"}));
                 AddClass(CL_HUMAN);
		 AddId("mensch");
              
                 CLONEME("/p/armour/shield/kupferschild");
                 CLONEME("/p/armour/armour/lederruestung");
                 command("trage alles");

                 CLONEME("/p/weapon/sword/saebel");
		 command("zuecke saebel");
		 break;

         case 3: SetProp(P_RACE, "Zwerg");
                 SetProp(P_SHORT, "Ein zwergischer Basarbesucher");
                 SetProp(P_SIZE, 120);
		 SetProp(P_NAME_ADJ, "zwergisch");
		 AddAdjective( ({"zwergisch", "zwergischer", "zwergischen",
			         "zwergischem"}));
                 AddClass(CL_DWARF);
		 AddId("zwerg");
              
                 CLONEME("/d/gebirge/dusty/zwerge/obj/zhose");
                 command("trage alles");

                 CLONEME("/d/gebirge/dusty/zwerge/obj/zkaxt");
		 command("zuecke axt");
		 break;


         case 4: SetProp(P_RACE, "Hobbit");
                 SetProp(P_SHORT, "Ein hobbitischer Basarbesucher");
                 SetProp(P_SIZE, 110);
		 SetProp(P_NAME_ADJ, "elfisch");
		 AddAdjective( ({"hoibbitisch", "hobbitischer", "hobbitischen",
			         "hobbitischem"}));
                 AddClass(CL_HOBBIT);
                 AddId("hobbit");

                 CLONEME(BASARIWEAPON "hobbitstab");
		 command("zuecke stab");
		 break;

         case 5: SetProp(P_RACE, "Ork");
                 SetProp(P_SHORT, "Ein orkischer Basarbesucher");
		 SetProp(P_NAME_ADJ, "orkisch");
		 AddAdjective( ({"orkisch", "orkischer", "orkischen",
			         "orkischem"}));
                 AddClass(CL_ORC);
		 AddId("ork");
              
                 CLONEME("/p/armour/armour/lederruestung");
                 command("trage alles");

                 CLONEME("/p/weapon/sword/krummsaebel");
		 command("zuecke saebel");
		 break;

         case 6: SetProp(P_RACE, "Troll");
                 SetProp(P_SHORT, "Ein trollischer Basarbesucher");
                 SetProp(P_SIZE, 300);
		 SetProp(P_NAME_ADJ, "trollisch");
		 AddAdjective( ({"trollisch", "trollischer", "trollischen",
			         "trollischem"}));
                 AddClass(CL_TROLL);
		 AddId("troll");
              
                 CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung");
                 command("trage alles");

                 CLONEME("/p/weapon/club/steinkeule");
		 command("zuecke keule");
		 break;

         case 7: SetProp(P_RACE, "Oger");
                 SetProp(P_SHORT, "Ein ogerischer Basarbesucher");
                 SetProp(P_SIZE, 250);
		 SetProp(P_NAME_ADJ, "ogerisch");
		 AddAdjective( ({"ogerisch", "ogerischer", "ogerischen",
			         "ogerischem"}));
                 AddClass(CL_OGRE);
		 AddId("oger");
              
                 CLONEME("/p/armour/armour/ringelpanzer");
                 command("trage alles");

                 CLONEME("/d/ebene/lamuerte/wwald/obj/ogerschwert");
		 command("zuecke schwert");
		 break;

         default: SetProp(P_RACE, "Gaffo");
                  SetProp(P_SHORT, "Ein gaffotischer Basarbesucher");
                  SetProp(P_SIZE, 150);
		  SetProp(P_NAME_ADJ, "gaffotisch");
		 AddAdjective( ({"gaffotisch", "gaffotischer", "gaffotischen",
			         "gaffotischem"}));
                  AddClass(CL_GAFFO);
                  AddId("gaffo");
              
                  CLONEME("/p/armour/armour/lederpanzer");
                  command("trage alles");
 
                  CLONEME("/d/ebene/obj/waffe/keule");
	          command("zuecke keule");
		  break;
 }

}

