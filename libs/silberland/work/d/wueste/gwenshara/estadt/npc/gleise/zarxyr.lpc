#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Zarxyr Hun'ett die Dunkelelfenpriesterin");
  SetProp(P_LONG,
    "Diese junge Dunkelelfe ist eine Priesterin der Lloth. Sie traegt ein "
    "Kleid aus duenner Spinnenseide und hat ihr Haar kunstvoll zurueck "
    "gebunden. Ihre rubinroten Augen funkeln Dich streng an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zarxyr");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zarxyr", "dunkelelfe", "priester", "dunkelelfenpriesterin", "\npriesterin"}));
  AddClass( ({ CL_DARKELF }) );
  SetProp(P_ARTICLE, 0);

  set_living_name("zarxyr");

//--Eigenschaften----------------------------------------------------------

  create_default_darkelf(25, 27);

  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,15);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Lloth wird mich erheben!");
  SetProp(P_KILL_MSG, "Auch Du widerstehst Lloth nicht!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " ignoriert Dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 75);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sagt: Los! Weiter!\n",
    Name(WER, 1)+" scheucht einen Dunkelelfen herum.\n",
    Name(WER, 1)+" schwingt die Peitsche.\n",
    Name(WER, 1)+" laesst die Peitsche knallen.\n",
    Name(WER, 1)+" betet zu Lloth.\n",
    Name(WER, 1)+" sagt: Die Koenigin wird euch roesten, wenn ihr euch nicht beeilt!\n",
    Name(WER, 1)+" murmelt etwas von einem Kraken.\n",
    Name(WER, 1)+" flucht ueber die Wuestenzwerge.\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/d/unterwelt/zordan/dhrkion/weapon/peitsche" );
  command("zuecke peitsche");
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
