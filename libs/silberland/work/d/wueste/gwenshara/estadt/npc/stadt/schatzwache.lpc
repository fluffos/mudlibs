#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zwergischer Schatzwaechter");
  SetProp(P_LONG,
    "Dieser Zwerg ist so stark geruestet, dass du nicht ein mal sagen "
	"kannst, ob es sich um einen Mann oder eine Frau handelt. Man sagt, "
	"die Schatzwache der Wuestenzwerge wuerden sich aus den Besten "
	"Kriegern rekrutieren. Nur die Koenigswachen waeren noch besser "
	"ausgebildet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schatzwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "schatzwaechter", "wuestenzwerg", "zwerg", 
          "\nwuestenzwerg_schatzwache"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130+random(20));
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -1000+random(2000));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" ignoriert Dich.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " geht toedlich verwundet zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Niemand gelangt an unseren Schatz!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ignoriert Dich und macht seinen Dienst weiter.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------
  
  SetProp(P_SPELLRATE, 30);
  
  AddSpell(3, 300,
    Name(WER, 1)+" laesst seine Waffe auf Dich herab sausen.\n",
	Name(WER, 1)+" laesst seine Waffe auf @WEN herab sausen.\n",
	DT_SLASH, ([SP_SHOW_DAMAGE:1]));
	
  AddSpell(2, 500,
    Name(WER, 1)+" bricht Dir mit einem Faustschlag ein paar Knochen.\n",
	Name(WER, 1)+" bricht @WEM ein paar Knochen.\n",
	DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
	
  AddSpell(1, 700,
    Name(WER, 1)+" zertruemmert Deinen Schaedel.\n",
	Name(WER, 1)+" zertruemmert @WESSEN Schaedel.\n",
	DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
	
  AddSpell(3, 250,
    Name(WER, 1)+" bruellt Dich mit einem lauten Kampfschrei an.\n",
	Name(WER, 1)+" bruellt @WEM einen lauten Kampfschrei entgegen.\n",
	DT_SOUND, ([SP_SHOW_DAMAGE:1]));
  
//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( STADTWEAPON "wzaxt" );
  command("zuecke axt");
  
  CLONEME( "/p/armour/armour/plattenpanzer" );
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/p/armour/helm/topfhelm" );
  CLONEME( "/p/armour/trousers/kettenhose" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

int Defend(int dam, string *dam_type, mixed spell, object enemy)
{
  int ret;
  object ob;
  ret = ::Defend(dam, dam_type, spell, enemy);
  return ret;
}

void init()
{
  ::init();
  if(TP->id("\nwuestenzwerg_schatzwache") || TP->id("\nws_schatzmeister"))
    TP->AddDefender(TO);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
