#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit STD "std_basari_normnpc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Layandra, die Wuestenelfe");
  SetProp(P_LONG,
    "Layandra ist eine der wenigen Wuestenelfen. Sie hat "
    "klare, silberne Augen und sandfarbenes Haar. Ihre "
    "Gesichtszuege sind sanft und weich. Sie ist die "
    "Pflanzenhaendlerin hier."
  );

  SetProp(P_NAME, "Layandra");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:80]));
  AddId( ({"layandra","ladenbesitzer"}) );
  AddClass(CL_ELF); // siehe /sys/class.h

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);

  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht in die Wueste");
  SetProp(P_MNPC_AREA, 0);

  AddInfo(DEFAULT_INFO, "Saya Sal'an'dra, Was wuenschst Du?","fragt: ");
  AddInfo( ({"pflanzen","pflanze","kraeuter","kraut"}),
	  "Ich verkaufe hier am Basar alle erdenklichen Arten von Pflanzen und "
	  "Kraeutern. Wenn Du etwas genaueres zu einer bestimmten Pflanze wissen "
	  "willst, dann frag mich danach.");
  AddInfo( ({"alraune","alraunen"}),
	  "Die Mandragora officinarum, oder Alraune genannte Pflanze ist fuer "
	  "den Koerper eines Lebewesens im unverarbeiteten Zustand ungeniess bar."
	  "Die Pflanze enthaelt Hyoscyamin, Scopolamin und Atropin. Die Fruechte "
	  "können für Kinder eine Gefahr darstellen. Die typischen "
	  "Vergiftungserscheinungen sind starke Pupillenerweiterung, geroetete, "
	  "trockene und heisse Haut sowie Pulsbeschleunigung. Bei starker "
	  "Vergiftung erfolgt Bewußtlosigkeit und narkoseaehnlicher Schlaf. "
          "Durch Atemlaehmung kann es zum Tod des Patienten kommen. ", "erklaert: ");
  AddInfo( ({"einbeere"}),
	  "Die gelbe Einbeere ist fast ueberall zu finden. Sie dient als Heilpflanze "
	  "und wird eingesetzt um kleinere, koerperliche Schaeden zu behandeln. Dennoch ist "
	  "vorsicht geboten! Die Blaetter dieser Pflanze sind giftig!", "erklaert: ");
  AddInfo( ({"zweibeere"}),
	  "Die orangene Zweibeere ist, so wie die Einbeere eine Heilpflanze. Sie "
	  "hat eine staerkere, heilende Wirkung und ist dazu noch seltener zu finden."
	  "Wie bei der Einbeere auch sind ihre Blaetter nicht geniessbar.", "erklaert: ");
  AddInfo( ({"dreibeere"}),
	  "Die rote Dreibeere ist eine sehr seltene und gut heilende Pflanze. Sie "
	  "stammt aus der Familie der Einbeeren. Ihre Blaetter haben die selbe Wirkung "
	  "wie die der Einbeere.", "erklaert: ");
  AddInfo( ({"vierbeere"}),
	  "Die Vierbeere stammt zwar auch aus der Einbeeren-Familie doch ist ihre Frucht, "
	  "anders als bei den anderen Beeren, giftig. Allerdings sind ihre Blaetter essbar.",
	  "erklaert: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
}
