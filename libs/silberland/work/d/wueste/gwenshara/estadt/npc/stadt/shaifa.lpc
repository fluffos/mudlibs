#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  object axe;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Shaifa die Haendlerin");
  SetProp(P_LONG,
    "Shaifa ist eine Frau der Wuestenzwerge. Wie alle Zwergenfrauen ist "
	"sie etwas kleiner als ihre maennlichen Artgenossen. Im Gegensatz zu "
	"den maennlichen Wuestenzwergen traegt sie ihr Haar lang und zu vielen "
	"kleinen Zoepfen geflochten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Shaifa");
  SetProp(P_GENDER, FEMALE);
  AddId(({"shaifa", "haendlerin", "zwergin", "wuestenzwergin",
          "\nwuestenzwerge_haendler"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(12);

  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das solltest Du besser verkaufen!\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sieht dich fragend an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"waren"}),
    "Ich kann Dir meine Waren zeigen!", "sagt: ");
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
