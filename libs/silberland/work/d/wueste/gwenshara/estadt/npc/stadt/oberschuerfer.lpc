#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  object axe;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ashad ben Alef der Baumeister");
  SetProp(P_LONG,
    "Ashad ben Alef ist der Baumeister der Wuestenzwerge. Er plant hier "
    "gerade neue Stadtteile. Er ist nicht nur ein meisterlicher Konstrukteur "
    "sondern auch ein sagenhafter Bergarbeiter.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ashad");
  SetProp(P_GENDER, MALE);
  AddId(({"ashad", "ashad ben alef", "zwerg", "wuestenzwerg", "meister",
	  "baumeister"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 0);
  set_living_name("ashadbenalef");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(40);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130+random(10));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -1000+random(2000));
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Vielleicht kann ich das noch brauen...\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du wirst den Bau nicht aufhalten!");
  SetProp(P_KILL_MSG, "Tja, ich kann nicht nur schuerfen.");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sieht dich fragend an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"gang", "gaenge", "stollen"}),
    "Dieser Gang ist noch nicht zum Bau freigegeben. Zuerst muessen wir "
    "die Edelsteine hier abbauen.", "sagt: ");

  /*AddInfo( ({"schuerfen", "edelsteine", "abbauen", "abbau"}),
    "Westlich von hier kann jeder Schatzsucher Edelsteine abbauen. Du brauchst "
    "nur das richtige Werkzeug!",
    "sagt: ");

  AddInfo( ({"werkzeug"}),
    "Du brauchst eine Spitzhacke, wie meine. Die kannst Du im Laden weiter "
    "oestlich von hier kaufen.", "sagt: ");*/

  AddInfo( ({ "teile", "stadtteile", "erweiterungen", "stadt" }),
    "Wir planen hier Erweiterungen unserer Stadt. Bevor wir diese jedoch "
    "umsetzen koennen, muessen wir die Schaetze im Gestein bergen.", "sagt: ");

  AddInfo( ({ "schaetze", "gestein" }),
    "Das Gestein hier ist von vielen Metalladern und Edelsteinen durchzogen. "
    "Diese Schaetze wollen wir bergen, bevor wir mit dem Bau neuer Stadteile "
    "beginnen.", "sagt: " );

  AddInfo( ({ "metall", "adern", "metalladern" }),
    "Gold, Silber, Eisen... alles was Du Dir nur vorstellen kannst.", "schwaermt: ");

  AddInfo( ({ "edelsteine" }),
    "Opale, Smaragde... Diamanten!", "traeumt: ");

//--Spells----------------------------------------------------------------

  SetProp(P_SPELLRATE, 80);

  AddSpell(3, 500,
    Name(WER)+" rammt seine Spitzhacke in Dich.\n",
    Name(WER)+" rammt seine Spitzhacke in @WEN.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 400, DS_MASS_DAMAGE,
    Name(WER)+" laesst Gesteinsbrocken von der Decke regnen.\n",
    Name(WER)+" laesst Gesteinsbrocken von der Decke regnen.\n",
    DT_BLUDGEON);

  AddSpell(3, 450,
    Name(WER)+" zertruemmert Dein Knie!\n",
    Name(WER)+" zertruemmert @WESSEN Knie!\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 300, DS_REDUCE_AC,
    Name(WER)+" zersticht Deine Ruestung mit der Spitzhacke.\n",
    Name(WER)+" zersticht @WESSEN Ruestung mit der Spitzhacke.\n");

  AddSpell(1, 1,
    Name(WER)+" versucht Dich mit einem Hieb zu toeten!!!\n",
    Name(WER)+" versucht @WEN mit einem Hieb zu toeten!!!\n",
    DT_PIERCE, "spalten");

//--Ausruestung------------------------------------------------------------

  SUID;
  axe = clone_object( "/p/weapon/axe/spitzhacke");
  axe->SetProp(P_SHORT, axe->QueryProp(P_SHORT)+" des Bergarbeiters");
  axe->SetProp("skill_mod", (["sk_prospect":2000]));
  axe->SetProp("itemd_no_magic", 1);
  axe->SetProp("itemd", ({"ist hochmagisch", "erleichtert das Schuerfen"}));
  axe->move(TO);
  command_me("zuecke spitzhacke");

  CLONEME(STADTARMOUR "berghelm");
  command_me("trage alles");

}

void spalten(object enemy, int damage, mixed dam_type)
{
  if(!random(10))
    enemy->Defend(1000+random(1000), DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  else
  {
    tell_object(enemy, BS(Name(WER)+" schafft es nicht, verletzt Dich aber "
	        "lebensgefaehrlich!!!"));
    tell_room(ENV(TO), BS(Name(WER)+" schafft es nicht, verletzt "+
	      enemy->Name(WEN)+" aber lebensgefaehrlich!!!"), ({enemy}));
    enemy->Defend(700+random(700), DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  }
  return;
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
