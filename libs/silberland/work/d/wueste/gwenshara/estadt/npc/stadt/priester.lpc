#include "../def.h" 

inherit STD "std_stadt_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Hatschi ben Ashul ben Quaul, Hueter der hohen Lohe von Quaul");
  SetProp(P_LONG,
    "Dieser alte Wuestenzwerg ist der hohe Hueter der blauen Lohe von Quaul. "
    "Er hat sein Leben der Wacht ueber das grosse Feuer hier im Tempel verschrieben. "
    "Sein rotes Gewand ist ueber und ueber mit goldenen Stickerein von Flammen "
    "verziert und raschelt bei jedem Schritt. Er scheint sehr weise.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hatschi");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "wuestenzwerg", "\nhoherhueter", "hatschi", "hatschi ben ashul",
          "hueter", "priester"}));

//--Eigenschaften----------------------------------------------------------

  create_default_npc(40);

  SetProp(P_HANDS, ({" mit der uralten Macht des Feuers",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_FIRE})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+"sagt: Opfer das lieber dem Feuer!\n" }) );

  SetProp(P_ARTICLE, 0);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Flammensaeule");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt mit einem letzten Aufschrei.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Darueber muss ich meditieren.");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  SetProp(P_SPELLRATE, 36);
  SetProp(P_NOMAGIC, 20);

  AddSpell(3, 200,
           Name(WER) + " feuert einen Flammenpfeil auf dich.\n", 
           Name(WER) + " feuert einen Flammenpfeil auf @WEN.\n",
           DT_FIRE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 250,
            "Aus " + Name(WESSEN) + " Finger schiesst ein Flammenstrahl auf dich!\n", 
            "Aus " + Name(WESSEN) + " Finger schiesst ein Flammenstrahl auf @WEN!\n",
            DT_FIRE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 333,
              Name(WER) + " deutet auf dich und du gehst in Flammen auf!\n", 
              Name(WER) + " deutet auf @WEN und @WER geht in einer Stichflamme auf!\n",
              DT_FIRE, "ignite", ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 350, DS_MASS_DAMAGE,
              Name(WER) + " huellt deine Umgebung in bruellende Flammen.\n",
              Name(WER) + " huellt deine Umgebung in bruellende Flammen.\n",
              DT_FIRE);


  CLONEME(STADTARMOUR "feuerrobe");
  command_me("trage alles");

}

public void ignite(object enemy, int damage, mixed dam_type)  {
  if(random(3)) return;
  tell_object(enemy, "Du stehst in Flammen!!!");
  tell_room(environment(enemy), BS(enemy->Name(WER) + " steht lichterloh in Flammen!!!"));

  call_out("burn", 2, enemy, 2+random(6));
  return;
}

public void burn(object enemy, int cnt) {
  if(--cnt > 0) {
    tell_object(enemy, BS("Du brennst lichterloh!"));
    enemy->AddHp(-10 - random(10));
    call_out("burn", 2, enemy, cnt);
  } else {
    tell_object(enemy, BS("Du brennst nicht mehr."));
  }
  return;
}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  if(!pointerp(dam_type_list)) {
    dam_type_list = ({ dam_type_list });
  }
  
  if(member(dam_type_list, DT_FIRE) > -1) {
    if(!random(3)) {
      command_me("emote ruft: Dein uebles Feuer kann mir nichts anhaben!");
      tell_room(environment(this_object()), BS("Die Macht der Lohe heilt den Hueter!"));
    }
    AddHp(dam/5);
    return 0;
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}
