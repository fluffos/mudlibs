#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine patroullierende Wache der Wuestenzwerge");
  SetProp(P_LONG,
    "Dieser Wuestenzwerg hier ist kaum von seinen Artgenossen im Gebirge "
    "zu unterscheide. Sein Helm verbirgt sein Gesicht und ein schweres "
    "kettenhemd seinen Koerper. Nur ein Bart ist nicht zu erkennen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Streckenwache");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wache", "zwerg", "wuestenzwerg", "streckenwache", "Keulenexperte"}));
  AddClass( ({ CL_DWARF }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  GLEISEROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "a1_gleise");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " ignoriert Dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"gleise","strecke","wagen","stadt"}),
    "Auf dieser Gleistrecke faehrt ein Wagen in die Stadt. Gebt Acht auf die "
    "Dunkelefen!",
    "sagt: ");

  AddInfo( ({"dunkelelfen"}),
    "Ab und zu Ueberfallen Dunkelelfen die Waegen, darum patroullieren wir hier.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(4, 200,
    Name(WER, 1)+" schlaegt kraeftig zu.\n",
    Name(WER, 1)+" schlaegt @WEN kraeftig.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 250,
    Name(WER, 1)+" truemmert seine Waffe auf deine Knie.\n",
    Name(WER, 1)+" zerdeppert @WESSEN Knie.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500,
    Name(WER, 1)+" zertruemmert Dich mit einem Hammerschlag!\n",
    Name(WER, 1)+" zertruemmert @WEN mit einem Hammerschlag!\n",
     DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 300,
    Name(WER, 1)+" bruellt Dich an.\n",
    Name(WER, 1)+" bruellt @WEN an.\n",
    DT_SOUND, ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/club/kampfhammer" );
  command("zuecke hammer");

  CLONEME( "/p/armour/armour/kettenhemd" );
  CLONEME( "/p/armour/helm/tellerhelm" );
  command("trage alles");
}
