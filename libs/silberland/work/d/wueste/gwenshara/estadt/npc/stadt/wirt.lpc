#include "../def.h" 
#include "../../master/briefmaster.h"

inherit "/p/std/npc/zechpreller_npc.lpc";


void create()
{
  int i;
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der Wirt Ahbed ben Sachhabad bedient hier die Gaeste");
  SetProp(P_LONG,
    "Ahbed ist ein kraeftiger Wuestenzwerg. Er hat, wie alle seines Volkes, "
    "keine Haare am Kopf. Dafuer hat er einen umso stattlicheren Bart. In "
    "seinem Guertel steckt ein weisses Tuch, mit dem er gelegentlich die "
    "Kruege durchputzt. Wenn er sich unbeobachtet glaubt, genehmigt er sich "
    "gerne einen Schluck aus einem der Faesser.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ahbed ben Sachhabad");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "wuestenzwerg", "ahbed", "wirt", "\nwzwirt"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_zechpreller(25, 6);

  SetProp(P_SPELLRATE, 25);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Pranken",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" destilliert @WEN zu reinem Alokohol.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
 
  SetProp(P_MNPC_FLAGS, 0);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " laesst einen letzten Ruelpser.\n");

//--Infos------------------------------------------------------------------

//--Kommandos-------------------------------------------------------------

}

void die(int poisondeath)
{
  write_file(STADTLOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(STADTLOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
