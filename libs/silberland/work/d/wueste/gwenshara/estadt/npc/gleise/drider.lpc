#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grosser Wachdrider");
  SetProp(P_LONG,
    "Dieses arme Geschoepf ist ein Dunkelelf, der von Lloth in ein Mischwesen "
    "aus Spinne und Drow verwandelt wurde. Nun ist er ein Wesen mit "
    "Spinnenleib und halbwegs elfischem Oberkoerper.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wachdrider");
  SetProp(P_GENDER, MALE);
  AddId(({"drider", "wachdrider", "\ndrider_guard"}));
  AddClass( ({ CL_DARKELF, CL_ANIMAL, CL_DEMON }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(17);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 220);
  SetProp(P_WEIGHT, 175000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:     -0.1, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.2, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3,
       DT_HOLY:      0.3, DT_UNHOLY:   -0.3, DT_MAGIC:      -0.1,
       DT_MIND:      0.1, DT_SLASH:     0.1, DT_BLUDGEON:    0.1,
       DT_PIERCE:    0.1, DT_SQUEEZE:   0.1, DT_WHIP:        0.1,
       DT_RIP:       0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Mein Tod ist nicht das Ende!");
  SetProp(P_KILL_MSG, "Fordere nicht den Zorn von Lloth!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " klackert mit den Mandibeln.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 45);

  AddSpell(2, 300,
    Name(WER, 1)+" schleudert eine Lanze aus unheiliger Energie nach Dir.\n",
    Name(WER, 1)+" schleudert eine Lanze aus unheiliger Energie nach @WEM.\n",
     DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 150, DS_POISON,
    Name(WER,1) + " vergiftet Dich mit seinem widerlichen Speichel!\n",
    Name(WER,1) + " vergiftet @WEN mit seinem widerlichen Speichel!\n" );

  AddSpell(2, 150,
    Name(WER, 1)+" schleudert einen Terrorblitz nach Dir.\n",
    Name(WER, 1)+" schleudert einen Terrorblitz nach @WEM.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, DS_SLOW,
    Name(WER, 1)+" sprueht Spinnenfaeden auf Dich!\n",
    Name(WER, 1)+" sprueht Spinnenfaeden auf @WEN!\n");


//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" klackert mit seinen Mandibeln.\n",
    Name(WER, 1)+" sieht sich wachsam um.\n",
    Name(WER, 1)+" wandert unruhig herum.\n",
    Name(WER, 1)+" webt ein feines Spinnennetz."
   }) ) ;
}

void die(int poisondeath)
{
  write_file(GLEISELOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(GLEISELOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

