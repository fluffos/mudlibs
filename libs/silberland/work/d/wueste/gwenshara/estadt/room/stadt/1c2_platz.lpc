#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier an einer Kreuzung in Quaul. Irgendwo weit ueber Dir "
    "erkennst Du die Hoehlendecke. Noerdlich von Dir entdeckst Du eine riesige "
    "Statue, die einen Zwergen darstellt. Die Gaenge fuehren Dich weiter nach "
    "Westen, und nach Osten. An der Suedwand befindet sich ein grosses Tor "
    "mit einem Schild darueber. Im Norden fuehrt, neben der Statue, ein breiter "
    "Durchgang zu einer weiteren Halle.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "kreuzung" }),
    "Du stehst hier an einer Art Kreuzung. Im Westen werden die Gaenge "
    "stollenartiger, waehrend sie im Osten normal gepflastert weiterfuehren. "
    "Suedlich von Dir befindet sich ein grosses Tor mit einem Schild "
    "darueber." );

  AddDetail( ({ "statue", "zwergen", "zwerg" }),
    "Die Statue noerdlich von Dir stellt einen maechtigen Zwergen in seiner "
    "Schlachtruestung und mit einem Kriegshammer dar. Sie misst sicher fast sechs  "
    "Trolle in der Hoehe. Ueberraschender Weise hat dieser Zwerg einen langen, "
    "wallenden Bart. Ganz anders als die Wuestenzwerge." );

  AddDetail( ({ "suedwand" }),
    "An der Suedwand befindet sich ein grosses, geschlossenes Tor. Zwei Saeule "
    "n flankeren es und ein paar Stufen fuehren hinauf. Ueber dem Tor wurde "
    "ein Schild in den Fels gemeisselt." );

  AddDetail( ({ "tor" }),
    "Das Tor ist geschlossen und ein grosser Balken davor genagelt." );

  AddDetail( ({ "schild" }),
    "Das Schild wurde aus dem gelblichen Fels herausgemeisselt. Man kann es "
    "lesen." );

  AddDetail( ({ "art" }),
    "Es ist keine wirkliche Kreuzung, da die Gaenge nur in zwei Richtungen "
    "weiter gehen." );

  AddDetail( ({ "ruestung", "schlachtruestung" }),
    "Die Ruestung der Statue besteht aus einem Plattenpanzer mit fein "
    "gemeisselten zwergischen Runen. Ein gehoernter Helm thront auf dem "
    "Kopf der Statue und seine Beine sind in schwere Eisenstiefel gehuellt." );

  AddDetail( ({ "kriegshammer", "hammer" }),
    "Der Kriegshammer der Statue ist mit feinen Ornamenten verziert und "
    "erscheint Dir als maechtige Waffe." );

  AddDetail( ({ "troll", "trolle" }),
    "Hier siehst Du gerade keinen." );

  AddDetail( ({ "hoehe" }),
    "Die Statue ist etwas trollgross." );

  AddDetail( ({ "weise" }),
    "Ueberraschend!" );

  AddDetail( ({ "bart" }),
    "Der Bart der Statue ist lang und wallend dargestellt. Vermutlich handelt "
    "es sich also um einen Gebirgszwerg. An der Spitze des Barts, die fast "
    "bis zum Boden reicht, erkennst Du etwas." );

  AddDetail( ({ "saeulen", "saeule", "steinsaeule" }),
    "Zwei Steinsaeulen flankieren das Tor im Sueden. Sie reichen bis zur "
    "Hoehlendecke hinauf." );

  AddDetail( ({ "stufen" }),
    "Drei Stufen fuehren hinauf zu dem grossen Tor in der Suedwand." );

  AddDetail( ({ "richtungen" }),
    "Westen und Osten." );

  AddDetail( ({ "plattenpanzer", "plattenruestung", "panzer" }),
    "Die Statue traegt eine altzwergische Plattenruestung." );

  AddDetail( ({ "runen" }),
    "Die Runen sind vermutlich der altzwergischen Sprache geschrieben." );

  AddDetail( ({ "helm", "kopf" }),
    "Auf dem Kopf der Statue thront ein maechtiger gehoernter Helm." );

  AddDetail( ({ "beine", "stiefel", "eisenstiefel" }),
    "Die Beine der Statue sind in feste Eisenstiefel gehuellt." );

  AddDetail( ({ "ornamenten", "ornamente" }),
    "Wie Du rasch erkennst handelt es sich um zwergische Runen." );

  AddDetail( ({ "waffe" }),
    "Der Kriegshammer der Statue scheint eine maechtige Waffe darzustellen." );

  AddDetail( ({ "gebirgszwerg" }),
    "Bei der Statue handelt es sich vermutlich um das Abbild eines Gebirgszwer"
    "gen." );

  AddDetail( ({ "spitze" }),
    "Bei der Spitze des Barts erkennst Du eine kleine Steintafel." );

  AddDetail( ({ "sprache" }),
    "Die altzwergische Sprache ist sehr schwer zu lesen und noch schwieriger "
    "zu sprechen." );

  AddDetail( ({ "abbild" }),
    "Damit ist die Statue gemeint." );

  AddDetail( ({ "steintafel", "tafel" }),
    "Auf der unscheinbaren Steintafel steht in gold gehalten etwas." );

  AddReadDetail( ({ "tafel", "steintafel" }),
    "Tarxes, Sohn des Torgesch, Enkel des Famulosch, Urenkel des Angrox und "
    "erster Bergkoenig von Quaul." );

  AddReadDetail( ({ "runen" }),
    "Du erkennst alte Segenssprueche in den Runen." );

  AddReadDetail( ({ "schild" }),
    "EINE FILIALE DER SILBERBANK" );

  AddDetail( ({ "balken" }),
    "Er wurde vor das Tor genagelt und beschriftet." );

  AddReadDetail( ({ "balken" }),
    "Achtung! Baustelle!" );

  AddDetail( ({ "hoehlendecke" }),
    GetDetail("decke") );

  AddDetail( ({"durchgang"}),
    "Ein Durchgang, breit wie zwei Fuhrwaegen, fuehrt hier nach Norden in eine grosse Halle.");

  AddDetail( "halle",
    "Du kannst nur vage erkennen was dort geschiet.");

  AddDetail( ({"fuhrwagen", "wagen", "fuhrwaegen"}),
     "Durch diesen Durchgang passen leicht zwei Fuhrwaegen, ohne sich zu beruehren.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", STADTROOM "1c1_hub" );
  AddExit( "westen", STADTROOM "1b2_tor" );
  AddExit( "osten",  STADTROOM "1d2_stadt" );
  AddExit( "sueden", STADTROOM "1c3_bank" );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT);
}
