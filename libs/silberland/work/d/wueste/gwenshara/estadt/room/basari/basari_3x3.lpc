inherit "/d/wueste/gwenshara/estadt/room/std_basari";

#include <properties.h>
#include "../def.h"
#include "/sys/ansi.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

int tasse;

void create()
{
  ::create();
  tasse = 1;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Auf dem Mada Basari");
  SetProp( P_INT_LONG,
   "Du stehst hier am suedoestlichen Ende des Mada Basari. Hier befindet sich "
   "ein Tor, das in den Kraterrand eingelassen wurde. Vor dem Tor befindet sich "
   "eine Konstruktion aus Holzbalken, an der man Kamele und andere Reittiere "
   "festbinden kann. Neben den Balken befindet sich eine mit Wasser gefuellte "
   "Traenke. Das Tor befindet sich im Sueden und ist von riesenhaften Ausmassen.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( ({"ende","eck","ecke"}),
	  "Du befindest Dich hier im suedoestlichsten Eck des Basars." );

  AddDetail( ({"tor"}),
	   "Das Tor, das in die Suedwand des Kraters eingelassen ist, ist von grossen, "
	   "nicht jedoch riesenhaften, Ausmassen. Es ist so breit, dass etwa drei Menschen "
	   "neben einander hindurch gehen koennten. Seine Hoehe entspricht ungefaehr zwei "
	   "Trollen. Um das Tor herum sind seltsame Zeichen eingelassen." );

  AddDetail( ({"rand","kraterrand","suedwand","wand", "krater"}),
	   "Im Sueden, am Kraterrand, ist ein Tor eingelassen." );

  AddDetail( ({"konstrukt", "konstruktion", "gebilde"}),
	   "Die Konstruktion aus Holzbalken ist dazu gedacht Kamele und andere Reittiere "
	   "daran festzubinden, damit sie nicht weglaufen. Sie besteht aus drei kurzen, "
	   "aber dicken Balken, die in den Boden grammt sind und einem langen Balken, an "
	   "dem man die Tiere festbinden kann." );

  AddDetail( ({"balken","holzbalken"}),
	    "Die Konstruktion vor dem Tor besteht aus insgesamt vier Holzbalken, die "
	    "stabil miteinander verbunden sind." );

  AddDetail( ({"kamele","reittiere","tiere"}),
	    "Kamele und andere Reittiere kann man hier an der Holzkonstruktion festbinden, "
	    "damit sie nicht davon laufen." );

  AddDetail( ({"wasser"}),
	    "Das Wasser, das sich in der Traenke befindet, ist vollkommen klar und sauber. "
	    "Scheinbar wird es regelmaessig erneuert." );

  AddDetail( ({"traenke","behaelter"}),
	    "Die Traenke ist ein einfacher, mit Wasser gefuellter Behaelter. Aus ihr "
	    "koennen alle hier befindlichen Tiere trinken, wenn sie Lust dazu haben." );

  AddDetail( ({"ausmasse"}),
	    "Einfach riesenhaft." );

  AddDetail( ({"menschen"}),
	    "Das Tor ist so breit das leicht drei Menschen nebeneinander hindurch "
	    "gehen koennen." );

  AddDetail( ({"hoehe","trolle","trollen"}),
	    "Das Tor ist so hoch wie es zwei Trolle uebereinander gestapelt waeren." );

  AddDetail( ({"boden"}),
	    "Der Boden ist voller Sand. Hier sollte man mal fegen!" );

  AddDetail( ({"lust"}),
	    "Die Tiere duerfen hier aus der Traenke trinken, wenn sie Lust haben. "
	    "Vielleicht solltest Du es auch einmal versuchen." );

  AddDetail( ({"sand"}),
	    "Du wunderst Dich darueber das Du mitten in der Wueste Sand findest!" );

  AddDetail( ({"wueste"}),
	    "Ja, da bist Du." );

  AddDetail( ({"zeichen", "worte"}),
	    "Die Zeichen scheinen aus dem Alt-Zwergischen zu kommen. Du koenntest "
	    "versuchen sie zu lesen.");

  AddReadDetail( ({"zeichen", "worte"}),
		"Arado barak zrom oyal allayah koraxod arrax rogmarok.\n"
		"Was wuerde wohl passieren wenn Du diese Worte aussprichst?");
//-----Details Ende-----

  AddItem(BASARINPC "besucher", REFRESH_DESTRUCT);
  AddItem("/d/wueste/gwenshara/zechi/npc/kamel", REFRESH_DESTRUCT);

  AddCmd( ({"fege","feg","kehre","kehr"}), "cmd_fegen");
  AddCmd( ({"sag","sage","sprich","spreche"}), "cmd_formel");
  AddCmd( CMD_TRINKEN, "cmd_trink");

  AddExit("norden", BASARIROOM "basari_2x3");
  AddExit("nordwesten", BASARIROOM "basari_2x2");
  AddExit("westen", BASARIROOM "basari_3x2");
}

int cmd_fegen(string str){
  write(BS("Irgendwoher hast Du ploetzlich einen Besen und beginnst zu "
	"fegen. Dabei wirbelst Du jedoch nur jede Menge Sand auf."));
  say(TPN+" wirbelt jede Menge Staub auf.\n");
  return 1;
}

int cmd_trink(string str){
  notify_fail(BS("Du ueberlegst es Dir doch lieber anders... "
	   "immerhin bist Du kein Tier."));
  return 0;
}

int cmd_formel(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "arado barak zrom oyal allayah koraxod arrax rogmarok")) return 0;

  Message(BS("Die Schrift am Tor beginnt in regenbogenfarbenem Licht zu gluehen."));

  if(!tasse) return -1;
  
  if(clone_object(BASARIOBJ "tasse")->move(TP, M_GET) == ME_TOO_HEAVY)
     return -1;

  write("In Deinem Inventar materialisiert sich eine Tasse...\n"
	"Was sich die Zwerge dabei wohl gedacht haben?\n");
  tasse = 0;
  return 1;
}

void reset()
{
  ::reset();
  tasse = 1;
}
