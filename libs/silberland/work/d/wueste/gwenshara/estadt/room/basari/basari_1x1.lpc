inherit "std/laden";

#include "../def.h"
#include <laden.h>
#include "/d/wueste/gwenshara/estadt/basari.h"

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:40]));

  SetProp(P_INT_SHORT,"Beim Waffenstand des Mada Basari");

  SetProp(P_SHOPKEEPER_ID, "shept");
  SetProp(P_SHOPKEEPER_NAME, "Shept");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SPECIAL_SHOP, ([P_WC:"Shept sagt: Ich kaufe nur Waffen!\n"]));

  SetStorageRoom(BASARIROOM "lagerraum_waffen" );

// Details Anfang
  AddDetail( ({"ende"}), 
	     "Du befindest Dich hier am nordwestlichen Ende des Mada "
	     "Basari. Hier bietet ein Waffenhaendler seine Waffen feil. "
	     "Vielleicht macht er Dir ja einen fairen Preis, anders als "
	     "Landar.");

  AddDetail( ({"mada","basari","markt"}), 
	     "Du befindest Dich hier am Mada Basari, dem sagenhaften Basar der "
	     "Wuestenzwerge. In der ganzen Wueste ist er bekannt fuer seine "
	     "sonderbaren Angebote und exotischen Waren.");

  AddDetail( ({"haendler","waffenhaendler"}), 
	     "Der Waffenhaendler hier heisst Shept. Er ist ein sehr erfahrener "
	     "Krieger der Wuestenzwerge. Ihn zum Duell zu fordern waere keine "
	     "gute Idee.");

  AddDetail( ({"waffen"}), 
	     "In den Truhen und Faessern, die sich hier stapeln befinden sich "
	     "vermutlich etliche Waffen. Ausserdem weiss Shept auch jede Menge "
	     "ueber Waffen.");

  AddDetail( ({"preis"}), 
	     "Shept gehoert zu den Haendlern mit dem besten Preis und der "
	     "besten Qualitaet im ganzen Silberland.");

  AddDetail( ({"landar","moechtegernhaendler"}), 
	     "Landar ist ein Moechtegernhaendler in Midas. Sein Preis und "
	     "seine Qualitaet lassen wirklich zu wuenschen uebrig.");

  AddDetail( ({"basar","basare"}), 
	     "Sieh Dich um! Hier befindest Du Dich am Mada Basari, einem der "
	     "schoensten Basare der Wueste. Alle moeglichen Voelker kommen hier "
	     "her um Waren zu erstehen und zu verkaufen.");

  AddDetail( ({"wuestenzwerge"}), 
	     "Die Wuestenzwerge haben sich in grauer Vorzeit von den Gebirgszwergen "
	     "abgespalten und haben sich hier fast vollkommen andest entwickelt. Sie "
	     "koennen schon als Unterart oder sogar als eigene Rasse angesehen werden.");

  AddDetail( ({"wueste","ort"}), 
	     "Du befindest Dich hier in der Wueste. Sie ist der sandigste und trockenste "
	     "Ort im Silberland. Nur die Haertesten koennen hier ueberleben.");
  
  AddDetail( ({"angebote","waren"}), 
	     "Hier findest Du die seltsamsten Angebote und die exotischsten Waren.");

  AddDetail( ({"shept"}), 
	     "Shept ist der hiesige Waffenhaendler. Er ist ein erfahrener "
	     "Krieger und Karavanenfuehrer.");

  AddDetail( ({"krieger"}), 
	     "Die Krieger der Wuestenzwerge gehoeren zu den gefaehrlichsten der Wueste. "
	     "Sie erfahren eine harte Ausbildung, bei der ihr Koerper und ihre Nerven "
	     "fuer lange Wuestenschlachten gestaehlt werden.");

  AddDetail( ({"duell"}), 
	     "Wenn Du vor haben solltest Shept zum Zweikampf zu fordern, dann "
	     "bist Du schon jetzt tot.");

  AddDetail( ({"idee","ideen"}), 
	     "In Deinem Kopf finden sich sicher viele Ideen.");

  AddDetail( ({"truhen","faesser"}), 
	     "In den Truhen und Faessern, die hier so herrenlos herumstehen befinden "
	     "sich Shepts Waren. Lass lieber Deine Finger davon.");

  AddDetail( ({"waffen"}), 
	     "Shept handelt mit allen Waffen. Du kannst sie an- und "
	     "verkaufen.");

  AddDetail( ({"menge"}), 
	     "Ohja, Shept weiss sehr viel ueber Waffen.");

  AddDetail( ({"haendler","haendlern"}), 
	     "Im Silberland gibt es viele verschiedene Haendler. Shept ist "
	     "einer der besten unter ihnen.");

  AddDetail( ({"qualitaet","sachen"}), 
	     "In Sachen Qualitaet ist Shept einer der fuehrenden "
	     "Haendler.");

  AddDetail( ({"midas"}), 
	     "Midas liegt in der Ebene, also nordwestlich von hier. Midas ist "
	     "eine sehr grosse Stadt.");

  AddDetail( ({"voelker"}), 
	     "Hier findest Du viele Voelker versammelt.");

  AddDetail( ({"vorzeit"}), 
	     "Die Vorzeit war tatsaechlich sehr grau. Bis die Goetter die "
	     "Farben erfunden haben. Dann hiess sie 'die bunte Vorzeit'.");

  AddDetail( ({"gebirgszwerge"}), 
	     "Die Zwerge im Gebirge werden auch Gebirgszwerge genannt. Das "
	     "laesst sich daraus schliessen, das sie im Gebirge leben.");

  AddDetail( ({"unterart"}), 
	     "Die Wuestenzwerge sind eine Unterart der Gebirgszwerge.");

  AddDetail( ({"rasse"}), 
	     "Die Wuestenzwerge sehen sich selbst gerne als eine eigene "
	     "Rasse.");

  AddDetail( ({"haertesten"}), 
	     "In der Wueste koennen nur die Haertesten ueberleben.");

  AddDetail( ({"karavanenfuehrer","fuehrer"}), 
	     "Shept hat viele Jahre hindurch Karavanen durch die Wueste gefuehrt.");

  AddDetail( ({"ausbildung"}), 
	     "Die Krieger der Wuestenzwerge erfahren eine harte Ausbildung, "
	     "in der ihr Koerper und ihre Nerven gestaehlt werden.");

  AddDetail( ({"koerper"}), 
	     "Der Koerper eines wuestenzwergischen Kriegers ist stahlhart.");

  AddDetail( ({"nerven"}), 
	     "Du musst ja stahlharte Nerven haben so viel zu forschen.");

  AddDetail( ({"wuestenschlachten","schlachten","schlacht"}), 
	     "Die Wuestenzwerge haben schon so manche Schlacht in der offennen "
	     "Wueste gewonnen.");

  AddDetail( ({"zweikampf"}), 
	     "Der Zweikampf wird auch Duell genannt.");

  AddDetail( ({"kopf"}), 
	     "Dein Kopf sitzt auf Deinem Koerper.");

  AddDetail( ({"finger"}), 
	     "Lass Deine Finger von den Truhen!");

  AddDetail( ({"stadt"}), 
	     "Midas ist die groesste Stadt im Silberland.");

  AddDetail( ({"silberland","land"}),
	     "Du bist gerade im Silberland.");  

  AddDetail( ({"boden"}),
	     "Am sandigen Boden findest Du etliche Spuren.");

  AddDetail( ({"spuren"}),
	     "Du findest Kamel- und Menschenspuren.");

  AddDetail( ({"kamelspuren"}),
	     "Diese Spuren stammen hoechstwahrscheinlich von Kamelen.");

  AddDetail( ({"kamele","kamel","kamelen","reittiere"}),
	     "Kamele sind Reittiere.");

  AddDetail( ({"menschenspuren"}),
	     "Die Spuren von humanioden Lebewesen ziehen sich durch den Sand.");

  AddDetail( ({"lebewesen"}),
	     "Es gibt sehr viele Lebewesen. Manche sind schoen, andere haesslich...");

  AddDetail( ({"himmel"}),
	     "Der Himmel ist strahlend blau.");

  AddDetail( ({"stand"}),
	     "Der Stand des Waffenhaendlers besteht nur aus ein paar Truhen und Faessern.");

  AddDetail( ({"jahre"}),
	     "Ach, die Jahren fliegen dahin...");

  AddDetail( ({"karavanen","versorgungskaravanen"}),
	     "Shept hat viele Jahre lang Versorgungskaravanen durch die Wueste "
	     "gefuehrt.");

  AddDetail( ({"gebirge"}),
	     "Das Gebirge findest Du weiter noerdlich im Silberland. Dort leben "
	     "die Gebirgszwerge.");

  AddDetail( ({"zwerge"}),
	     "Wuesten- doer Gebirgszwerge?");

  AddDetail( ({"farben"}),
	     "Die Goetter mussten die Farben erst erfinden!");

  AddDetail( ({"goetter"}),
	     "Woody und Dusty sind unsere Goetter.");

  AddDetail( ({"woody","dusty"}),
	     "Das sind die Goetter im Silberland.");

  AddDetail( ({"sand"}),
	     "Davon gibt es hier genuegend.");
// Details Ende


  AddExit("suedosten", BASARIROOM "basari_2x2");
  AddExit("sueden", BASARIROOM "basari_2x1");
  AddExit("osten", BASARIROOM "basari_1x2");

   AddItem(BASARINPC "shept", REFRESH_DESTRUCT);
   AddItem(BASARINPC "besucher", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier am nordwestlichen Ende des Mada Basari, dem "
	"Markt der Wuestenzwerge. Hier hatt ein Waffenhaendler seinen Stand "
	"geoeffnet und bietet allerlei Waffen feil. Der Stand des Waffenhaendlers "
	"besteht eigentlich nur aus ein paar Faessern und Truhen. ";
  if(!present(QueryProp(P_SHOPKEEPER_ID)))
    txt += "Der Waffenhaendler ist leider nirgends zu sehen.";
  else  txt += "";

  return BS(txt);
}
