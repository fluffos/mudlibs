#pragma strong_types

inherit "d/wueste/gwenshara/estadt/room/std_basari";

#include <properties.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

int aepfel;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_LONG,
   "Hier ist im Vergleich zum Rest des Marktes nichts los. Vermutlich hat "
   "das damit zu tun, dass sich hier zur Zeit kein Haendler befindet. Hier "
   "befindet sich ein kleiner Sandhuegel, auf dem ein Korb steht, neben dem Korb "
   "ist ein Teppich ausgebreitet. So wie es aussieht hat sich hier ein "
   "Schlangenbeschwoerer breit gemacht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( ({"vergleich","rest"}), 
	   "Im Vergleich zum Rest des Basars ist hier nichts los. Kein "
	   "Gedraenge, keine Besuchermassen und nicht so viel Laerm.");

  AddDetail( ({"zeit","datum"}), 
	   "Das aktuelle Datum: "+ctime()+"\nDas MUD laeuft "+uptime()+".");

  AddDetail( ({"haendler"}), 
	   "Hier befindet sich kein einziger. Wenn Du einen suchen solltest "
	   "findest Du sie ueberall, nur nicht hier.");

  AddDetail( ({"sandhuegel","huegel"}), 
	   "Auf dem kleinen Sandhuegel, der hier aufgeschuettet wurde befindet sich ein "
	   "kleiner Korb. Er ist geschlossen. Anscheinend befindet sich etwas in ihm. Neben "
	   "dem Korb wurde ein Teppich ausgebreitet.");

  AddDetail( ({"korb","korbes"}),
	   "Ein geflochtener Korb befindet sich auf dem kleinen Sandhuegel. Er ist "
	   "geschlossen. Vermutlich befindet sich im Inneren des Korbes etwas interessantes.");

  AddDetail( ({"teppich"}), 
	   "Der Teppich, der hier einfach so im Sand liegt, ist wunderschoen. Er wurde "
	   "mit schoenen Mustern verziert.");

  AddDetail( ({"schlangenbeschwoerer","beschwoerer"}), 
	   "Ein Schlangenbeschwoerer ist dazu in der Lage mittels seiner Floete eine "
	   "Schlange zu baendigen.");

  AddDetail( ({"gedraenge","geschubse"}), 
	   "Eigentlich bist Du ganz gluecklich darueber, dass hier kein so grosses "
	   "Gedraenge und Geschubse herrscht. Hier ist es fast gemuetlich.");

  AddDetail( ({"besuchermassen","massen"}), 
	   "Die Besuchermassen des Basars scheinen diesen Teil des Basars nicht zu moegen. "
	   "Hier findest Du zumindest kaum einen Besucher.");

  AddDetail( ({"inneren","inneres","innere"}), 
	   "Wie koenntest Du denn in das Innere des Korbes gelangen?");

  AddDetail( ({"muster","mustern"}), 
	   "Die Muster des Teppichs gefallen Dir, am liebsten wuerdest Du sie mit Deinen "
	   "Fingern nachziehen.");

  AddDetail( ({"floete"}), 
	   "Schlangenbeschwoerer haben meist eine Floete dabei.");

  AddDetail( ({"schlange","schlangen","tiere"}), 
	   "Schlangen sind schuppige Tiere. Womoeglich findest Du im Korb eine.");

  AddDetail( ({"teil"}), 
	   "Dieser Teil des Basars ist fast gaenzlich unbeachtet.");

  AddDetail( ({"besucher"}), 
	   "Hier findest Du nur ganz wenige Besucher.");

  AddDetail( ({"lage"}), 
	   "Befindest Du Dich gerade in einer angenehmen Lage?");

  AddDetail("boden", "Der Boden ist mit feinem Sand bedeckt.");
//-----Details Ende-----

  AddSound( DEFAULT_SOUND,
	    "Hier ist es wunderbar ruhig, also kein Laerm."); 

  AddSound( "laerm", 
	    "Hier ist es so schoen ruhig.");

  AddExit("osten", BASARIROOM "basari_3x3");
  AddExit("westen", BASARIROOM "basari_3x1");
  AddExit("norden", BASARIROOM "basari_2x2");
  AddExit("nordosten", BASARIROOM "basari_2x3");
  AddExit("nordwesten", BASARIROOM "basari_2x1");

  aepfel=2;
  
  AddItem(BASARINPC "floetenspieler", REFRESH_DESTRUCT);

  AddCmd( ({"ziehe","zieh"}), "cmd_zieh");
  AddCmd( CMD_OEFFNEN, "cmd_oeffne");
}

int cmd_zieh(string str){
  notify_fail("Was moechtest Du nachziehen?\n");
  if(!str) return 0;
  if(!(str == "muster nach")) return 0;

  Message(TPN+" zieht das Muster am Teppich nach.\n", MSGFLAG_VISUAL,
  ([MSGFLAG_EXCLUDE:({ TP })]));
  write("Du ziehst das Muster am Teppich nach. Der Teppich ist soooo weich!\n");
  BASARIMASTER->Msg(TPN+" streichelt den Teppich.\n");

	return 1;
}

int cmd_oeffne(string str){

  object obj;

  notify_fail("Was willst Du oeffnen?\n");
  if(!str) return 0;
  if(!(str == "korb")) return 0;

  Message(TPN+" oeffnet den Korb und zuckt zurueck.\n", MSGFLAG_VISUAL,
  ([MSGFLAG_EXCLUDE:({ TP })]));
  
  TP->AddPoison(1);
  
  if(aepfel < 1)
    return write(BS("Du oeffnest den Korb und greifst hinein.")+
		 BS("Autsch! Da ist wohl eine Schlange drin!")), 1;
  
  obj=clone_object(BASARIOBJ "apfel");
  
  if(obj->move(TP) == ME_TOO_HEAVY)
    {
      write("Du kannst, was im Korb ist, nicht ergattern.\n");
      return -1;
    }
  
  write("Du oeffnest den Korb und greifst hinein.\nAutsch! Da ist wohl eine "
	"Schlange drin!\nTrotzdem konntest Du einen Apfel ergattern.\n");
  BASARIMASTER->Msg(TPN+" greift in den Schlangenkorb.\n");
  
  aepfel--;
  
  return 1;
}

void reset()
{
  ::reset();
  
  aepfel=2;
}
