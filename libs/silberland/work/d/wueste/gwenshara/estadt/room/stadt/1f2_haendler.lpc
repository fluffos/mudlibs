#include "../def.h"
#include <laden.h>

//inherit STD "std_stadt";
inherit "std/laden";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier in einer Hoehle, die in den Stein gearbeitet "
	"wurde. Der hintere Bereich wurde durch eine hoelzerne Verkaufstheke "
    "vom Kundenbereich abgetrennt. Hinter der Theke erkennst Du etliche "
	"Reihen von Regalen, in denen die unterschiedlichsten Waren lagern. "
	"An der Wand neben dem Eingang haengt eine kleine Tafel.");
	
//--Shop-------------------------------------------------------------------
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER|SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\nwuestenzwerge_haendler");
  SetProp(P_SHOPKEEPER_NAME, "Shaifa");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetStorageRoom(STADTROOM "lager_haendler");

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle" }),
    "Du befindest Dich hier in einer kleinen Hoehle, die wohl als Verkaufs"
	"raum genutzt wird." );
	
  AddDetail( ({ "bereich" }),
    "Der Bereich hinter der Theke dient offenbar als Lager. Unzaehlige Regale "
	"beinhalten die hier verkauften Waren. Vor der Theke befindet sich der "
	"Kundenbereich, in dem Du hier stehst." );
	
  AddDetail( ({ "theke", "verkaufstheke" }),
    "Die Theke ist in genau so hoch, dass sie einem Zwerg bis an dir Brust "
	"reicht. Sie besteht aus einem dunklen Holz, dass vermutlich von anderen "
	"Zwergenstaemmen importiert wurde. Die Maserung ist noch sehr gut zu "
	"erkennen." );
	
  AddDetail( ({ "kundenbereich" }),
    "Du stehst hier im Kundenbereich. Eigentlich sind es nur die wenigen Meter "
	"zwischen der Tuer und der Theke." );
	
  AddDetail( ({ "regale", "regalen", "reihen", "reihe", "regal" }),
    "Reihe um Reihe reihen sich die Regal mit unterschiedlichsten Waren "
	"aneinander." );
	
  AddDetail( ({ "waren", "ware" }),
    "Die unzaehligen Waren kannst Du dir mittels <zeige> anzeigen lassen." );
	
  AddDetail( ({ "eingang" }),
    "Der Eingang in diese Hoehle ist eine kleine Holztuer, durch die Du herein "
	"gekommen bist." );
	
  AddDetail( ({ "tafel", "schiefertafel" }),
    "Auf diese Schiefertafel wurde etwas geschrieben. Du kannst sie also lesen!" );
	
  AddDetail( ({ "lager" }),
    "Die Regale im hinteren Bereich der Hoehle dienen wohl als Lager fuer die "
	"verschiedenen Waren." );
	
  AddDetail( ({ "tuer", "holztuer" }),
    "Durch die kleine Holztuer hast Du diese Hoehle betreten." );
	
  AddDetail( ({ "raum", "verkaufsraum" }),
    "Du stehst hier offensichtlich in einem Verkaufsraum." );
	
  AddDetail( ({ "brust" }),
    "Die Theke reicht genau bis an die Brust eines Zwergen." );
	
  AddDetail( ({ "holz", "holzes" }),
    "Du hast keine Ahnung um was fuer ein Holz es sich handelt. Es wurde "
	"vermutlich importiert, da hier keine Baeume wachsen." );
	
  AddDetail( ({ "maserung" }),
    "Die Maserung des Holzes ist ganz gut zu erkennen. Ein einer Stelle faellt Dir "
	"ein Loch in der Theke auf." );
	
  AddDetail( ({ "zwerg", "wuestenzwerge" }),
    "Die hiesigen Zwerge sind Wuestenzwerge." );
	
  AddDetail( ({ "zwergenstaemme", "staemme" }),
    "Es gibt mehrere Zwergenstaemme im Silberland. Die hiesigen Zwerge nennen sich "
	"Wuestenzwerge." );
	
  AddDetail( ({ "ahnung" }),
    "Die kannst Du nicht untersuchen, weil Du sie nicht hast." );
	
  AddDetail( ({ "baeume" }),
    "In der Stadt hast du noch keinen gesehen." );
	
  AddDetail( ({ "stelle", "loch" }),
    "Das Loch ist gerade so gross, wie Dein Finger." );
	
  AddDetail( ({ "stein", "sandstein" }),
    "Es handelt sich hier um Sandstein." );
	
  AddDetail( ({ "stadt", "quaul" }),
    "Die Stadt Quaul ist die Heimat der Wuestenzwerge." );
	
  AddDetail( ({ "heimat" }),
    "Diese Stadt hier." );
	
  AddDetail( ({ "wand", "waende" }),
    "Sie bestehen aus dem selben Stein, wie auch der Boden." );
	
  AddDetail( ({ "silberland" }),
    "Hier bist Du." );
	
  AddDetail( ({ "finger", "wuerste" }),
    "Die kleinen Wuerste an Deiner Hand." );
	
  AddDetail( ({ "hand" }),
    "Da sind die Finger dran." );
	
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier, wie im Rest der Stadt aus Stein." );
	
  AddDetail( ({ "decke" }),
    "Die Decke hier besteht aus unbehauenem Stein." );
	
  AddReadDetail( ({"tafel"}),
    "Verfuegbare Befehle:\n"
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", STADTROOM "1e2_stadt" );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "shaifa", REFRESH_DESTRUCT );
  
//--Commands--------------------------------------------------------------
}