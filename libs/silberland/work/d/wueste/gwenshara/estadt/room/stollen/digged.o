#0:0
text_short ({"In einem Stollen","Tief unter der Wueste","In einem selbstgebauten Gang","Umgeben von Erde","Ein einsturzgefaehrdeter Stollen","Ein staubiger Stollen","Ein dreckiger Gang",})
text_long ([2:({"Staub rieselt von der Decke.","Ein leichter Lufthauch versorgt dich mit frischer Luft.","Du erkennst glitzernde Einschluesse in den Waenden.","Ein wackeliger Stuetzbalken bewahrt den Gang vor dem Einsturz.",}),5:({"Vereinzelte Wassertropfen fallen von der Decke.","Es ist schon ein wenig warm hier...","Vor Dir liegt ein zersplitterter Totenkopf!","Die Waende wirken hier nicht ganz so stabil.",}),1:({"Du befindest Dich in einem Stollen.","Hier wurde ein schmaler Stollen gegraben.","Muehsam hast Du Dir den Weg hierher gegraben.","Der Stollen hier ist frisch gegraben.",}),4:({"Riecht es hier nach faulen Eiern?","Ab und zu zittert die Decke bedrohlich.","Du glaubst Edelsteinspiltter zu erkennen.","Du fuehlst Dich hier irgendwie eingeengt.",}),3:({"In der Ferne hoerst Du ein Klopfen.","Der Boden ist von feinem Goldstaub bedeckt.","Frische Schuerf- und Grabspuren bedecken die Waende.","Einige Steinbrocken liegen hier herum.",}),])
text_details (["lufthauch":({"Selten weht hier ein Lufthauch durch.","Ab und zu frische Luft is schon ganz angenehm.","Ein kuehlender Lufthauch wirkt hier Wunder.",}),"goldstaub":({"Dieser Staub besteht aus einem kleinen Teil Gold.",}),"decke":({"Die Decke hier scheint nicht sehr tragfaehig.","Staub rieselt von der Decke.","Die Decke besteht aus festem Stein.",}),"steinbrocken":({"Ein paar Steinbrocken liegen hier.","Vermutlich Ueberreste vom Graben.",}),"gang":({"Du befindest Dich hier ein einem Stollen oder auch Gang.",}),"stuetzbalken":({"Dieser Balken bewahrt den Gang vor dem Einsturz.",}),"luft":({"Etwas muffig.","Schoen frisch!",}),"schuerfspuren":({"Vielleicht solltest Du hier auch schuerfen?",}),"eier":({"Das koennte Schwefel sein.","Dieser Geruch ist unangenehm.","Vielleicht ist Schwefel in der Naehe?",}),"gold":({"Glitzerndes, glaenzendes Gold.","Wieviel das wohl wert ist?","Mehr!",}),"waende":({"Die Waende hier wurden aus dem rohen Stein gehauen.","Schuerfspuren an den Waenden zeigen deutlich, dass hier jemand gearbeitet hat.","Ab und zu glitzern seltene Einschluesse in ihnen.","Die Waende hier bestehem aus robustem Stein.",}),"stein":({"Hart und felsig.",}),"ferne":({"Irgendwo in der Ferne klopft es.","Ganz schoen weit weg.","Die Ferne ist abstrakt!",}),"wassertropfen":({"Ab und zu faellt einer von ihnen zu Boden.",}),"einsturz":({"Hoffentlich haelt der Stollen!",}),"einschluesse":({"Es handelt sich sicher um Edelsteine!","Vielleicht ist es Gold.",}),"edelsteinspiltter":({"Ob es hier Edelsteine gibt?",}),"staub":({"Ab und zu rieselt etwas Staub von der Decke.","Hoffentlich setzt sich der Staub nicht in Deinen Lungen ab!","Ob in den Staub Edelsteine sind?","Haaaaaaaaaaaaaaaatschi!",}),"schwefel":({"Schwefel brennt gut.","Das kann ein Zeichen fuer Drachen sein!",}),"eiern":({"Das koennte Schwefel sein.","Dieser Geruch ist unangenehm.","Vielleicht ist Schwefel in der Naehe?",}),"wueste":({"Du bist hier tief unter der Wueste.","Die Wueste ist irgendwo ober Dir.",}),"stollen":({"Hier bist Du eindeutig in einem Stollen.","Dieser Stollen hier ist schon ein wenig eng.","Eigentlich ist dieser Stollen doch ganz stabil.",}),"totenkopf":({"Dieser Totenkopf wirkt sehr menschlich.","Dieser Totenkopf wirkt sehr elfisch.","Dieser Totenkopf wirkt sehr zerwgisch.","Dieser Totenkopf wirkt sehr trollisch.","Dieser Totenkopf wirkt sehr unheimlich.",}),"weg":({"Der Weg bis hier her war etwas beschwerlich.","Es war ein langer Weg.",}),"klopfen":({"Tick-Tock-Tick-Tock-Tock.","Tock-Tock-Tock.","Tick-Tick.","Tock-Tick-Tock-Tiktick.",}),"spuren":({"Frische Schuerfspuren bedecken die Waende. Vielleicht solltest Du hier auch schuerfen?",}),"grabspuren":({"Ob man hier an den Waenden weitergraben kann?",}),])
