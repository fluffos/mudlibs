inherit "/d/wueste/gwenshara/estadt/room/std_basari";

#include <properties.h>
#include "../def.h"
#include "/sys/ansi.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

string key();
int SetKaefig(int i);
int kaefig;

void create()
{
  ::create();
  kaefig=0;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Auf dem Mada Basari");
  SetProp( P_INT_LONG,
   "Du stehst hier am noerdlichen Ende des Mada Basari. Im Norden steht ein "
   "Kaefig aus stabilen Holzstaeben. Direkt vor Dir befindet sich ein Pranger. "
   "Ein Podest, das hier neben dem Pranger steht, verstaerkt Deinen Eindruck, dass "
   "Du hier auf einem Richtplatz gelandet bist. Diebe scheinen auf dem Basar "
   "kein all zu langes Leben zu haben.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( ({"ende"}),
            "'Alles hat ein Ende nur die Knarkhwurst hat zwei...' Keine "
	    "Angst. Du bist nicht am Strand gelandet. Hier stehst Du am "
	    "noerdlichen Ende des grossen Basars.");

  AddDetail( ({"norden"}),
            "Im Norden steht ein sehr stabiler Kaefig aus Holzstaeben. In "
	    "ihm werden wohl die Verbrecher bis zur ihrer Verurteilung fest"
	    "gehalten.");

  AddDetail( ({"kaefig"}),
            "Der Kaefig ist aus extrem stabilen Holzstaeben gefertigt. Seine "
	    "Vorderseite ist wohl als Tuer gefertigt, denn an ihr erkennst Du "
	    "ein ueberaus stabiles Zwergenschloss.");

  AddDetail( ({"staebe","holzstaebe","holzstaeben"}),
            "Die Holzstabe des Kaefigs sind aus extrem belastbarem Holz gemacht. "
	    "Sonst wurde ja jeder, der darin eingesperrt ist, ohne Probleme "
	    "daraus entkommen.");

  AddDetail( ({"pranger","pfahl"}),
            "Der Pranger ist ein einfacher Pfahl, der hier in den Sand gerammt "
	    "wurde. An ihm haengen Handschellen und Blutspuren zeugen davon, dass "
	    "hier offenbar Strafen vollzogen werden. Feinden gegenueber sind "
	    "die Wuestenzwerge wohl gnadenlos.");

  AddDetail( ({"podest","konstruktion"}),
            "Das Podest neben dem Pranger ist eine einfache Konstruktion aus "
	    "Holzbrettern. Wenn man nicht all zu schwer ist sollte man sich "
	    "darauf stellen koennen, ohne dass es einbricht.");

  AddDetail( ({"eindruck"}),
            "Wie es scheint bist Du hier auf einem Richtplatz gelandet.");

  AddDetail( ({"richtplatz"}),
            "Hier bist Du auf dem Richtplatz des Basars gelandet. Ein Mal im "
	    "Monat werden hier alle Verbrecher bestraft. Meist geschieht das "
	    "wenn der Kaefig im Norden ueberfuellt ist.");

  AddDetail( ({"diebe","verbrecher"}),
            "Verbrecher werden auf dem Basar meistens sehr schnell geschnappt "
	    "und werden dann hart bestraft.");

  AddDetail( ({"knarkhwurst","knarkhwuerste"}),
            "Hier findest Du keine Knarkhwuerste. Wenn Du welche haben willst, "
	    "dann musst Du in das boese Dorf Knarkh nahe dem Fischerdorf gehen.");

  AddDetail( ({"angst"}),
            "Nur die Ruhe. Du bist hier immer noch in der Wueste.");

  AddDetail( ({"strand"}),
            "Hier hast Du zwar Sand, aber ein Strand ist das noch lange nicht.");

  AddDetail( ({"verurteilung"}),
            "Bei der Verurteilung der Gefangenen werden die harten Strafen auch "
	    "gleich ausgefuehrt.");

  AddDetail( ({"vorderseite","seite"}),
            "Die Vorderseite ist die einzige Tuer, durch die man in den Kaefig und "
	    "aus ihm heraus kommt.");

  AddDetail( ({"tuer"}),
            "Die Vorderseite des Kaefigs ist gleichzeitig seine Tuer. An ihr "
	    "befindet sich ein stabil wirkendes Zwergenschloss.");

  AddDetail( ({"schloss","zwergenschloss"}),
            "Dieses Zwergenschloss hier ist von unvergleichbarer Qualitaet. "
	    "Es gehoert zu der Sorte, die man wirklich nur mit dem passenden "
	    "Schluessel auf bekommt.");

  AddDetail( ({"holz","palmenholz"}),
            "Es scheint sich um Palmenholz zu handeln. Vermutlich hat man es "
	    "von der Oase Arrakeen hier her gebracht.");

  AddDetail( ({"probleme"}),
            "Du solltest hier keine Probleme machen, sonst sitzt Du ganz "
	    "schnell in dem Kaefig fest.");

  AddDetail( ({"handschellen","schellen"}),
            "Die Handschellen am Basar dienen dazu die Verurteilten waehrend "
	    "ihrer Bestrafung hier zu behalten.");

  AddDetail( ({"spuren","blut","blutspuren"}),
            "Am Pranger findest Du vereinzelt Blutspuren. Wie es aussieht sind "
	    "die Wuestenzwerge nicht gerade zimperlich was Strafen betrifft. "
	    "Diebe werden hier wohl ausgepeitscht.");

  AddDetail( ({"feinde","feinden","tafel"}),
            "Am Eingang des Basars findest Du eine Tafel, auf der die "
	    "Feinde der Wuestenzwerge aufgelistet sind.");

  AddDetail( ({"zwerge","wuestenzwerge","volk","zwergenvolk"}),
            "Die Wuestenzwerge sind das hier heimische Zwergenvolk.");

  AddDetail( ({"holzbretter","bretter"}),
            "Die Holzbretter koennen Dein Gewicht sicher tragen. "
	    "Du kannst es doch einfach versuchen und Dich auf "
	    "das Podest stellen.");

  AddDetail( ({"monat","jahr"}),
            "Ein Jahr hat 12 Monate.");

  AddDetail( ({"dorf","fischerdorf"}),
            "Das Fischerdorf befindet sich suedwestlich von Midas.");

  AddDetail( ({"knarkh"}),
            "Knarkh ist ein boeses Dorf!");

  AddDetail( ({"ruhe", "zelt"}),
            "Im Zelt oestlich von Dir kann man sicher gut ausspannen.");

  AddDetail( ({"gefangenen"}),
            "Die Gefangenen befinden sich im Kaefig.");

  AddDetail( ({"qualitaet"}),
            "Die Qualitaet des Zwergenschlosses ist ueberraschend gut.");

  AddDetail( ({"sorte"}),
            "Das Schloss bekommt man nur mit dem dazugehoerigen Schluessel "
	    "auf.");

  AddDetail( ({"schluessel"}), #'key);

  AddDetail( ({"oase","arrakeen"}),
            "Arrakeen ist eine Oase im Norden der Wueste.");

  AddDetail( ({"verurteilte","verurteilten"}),
            "Dier Leute, die hier verurteilt werden sind meist Verbrecher.");

  AddDetail( ({"gewicht"}),
            "Die Holzbretter werden Dein Gewicht schon noch aushalten.");

  AddDetail( ({"strafe","strafen","bestrafung"}),
            "Hier werden die Verbrecher bestraft.");

  AddDetail( ({"boden"}), "Der Boden ist mit feinem Sand bedeckt.");

  AddDetail( ({"leben"}), "Diebe haben hier allgemein betrachtet kein sehr "
	    "langes Leben.");
  //-----Details Ende-----

  //-----Items-----
  AddItem(BASARINPC "richter", REFRESH_DESTRUCT);
  //AddItem(BASARINPC "gefangener", REFRESH_DESTRUCT);

  //-----Exits-----
  AddExit("osten", BASARIROOM "kneipe_zelt");
  AddExit("westen", BASARIROOM "basari_1x1");
  AddExit("suedosten", BASARIROOM "basari_2x3");
  AddExit("sueden", BASARIROOM "basari_2x2");
  AddExit("suedwesten", BASARIROOM "basari_2x1");

  //-----Commandos-----
  AddCmd( CMD_OEFFNEN, "cmd_open");
  AddCmd( ({"mache","mach"}), "cmd_probleme");
  AddCmd( ({"sperr","sperre"}), "cmd_kaefig");
}

string key()
{
  if(present("\nkamel_quest", TP))
    return "Wenn Du den passenden Schluessel haettest, dann koenntest Du "
           +"ganz einfach in den Kaefig.\n";
  return "Eigentlich interessiert Dich der Schluessel gar nicht.\n";
}

int cmd_open(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str) return 0;
  if(!(str == "kaefig" ||
       str == "tuer"   ||
       str == "vorderseite" )) return 0;

  notify_fail("Der Kaefig ist schon offen.\n");
  if(kaefig) return 0;

  write("Dazu brauchst Du einen passenden Schluessel.\n");
  return 1;
}

int cmd_probleme(string str)
{
  notify_fail("Was willst Du machen?\n");
  if(!str) return 0;
  if(!(str == "probleme" ||
       str == "schwierigkeiten")) return 0;

  write(BS("Du beginnst zu wueten und ploetzlich packt Dich eine Wache und "
        "steckt Dich in den Kaefig. Tja, das hast Du jetzt davon!\n"));
  say(TPN+" wuetet herum.\n"+TP->QueryPronoun(1)+" wird von einer Wache in "
      "den Kaefig gesteckt.\n");
  TP->move(BASARIROOM "kaefig",  M_NOCHECK);
  return 1;
}

int cmd_kaefig(string str)
{
  notify_fail("Was moechtest Du aufsperren?\n");
  if(!str) return 0;
  if(!(str == "kaefig auf"         ||
       str == "tuer auf"           ||
       str == "vorderseite auf"    ||
       str == "schloss auf"        ||
       str == "zwergenschloss auf" )) return 0;

  notify_fail("Du hast nicht den passenden Schluessel!\n");
  if(!present("\nbasari_key", TP)) return 0;

  write(BS("Mit einem Klicken oeffnet sich das Schloss und Du "
        "oeffnest die Vorderseite des Kaefigs."));
  kaefig=1;
  AddExit("kaefig", BASARIROOM "kaefig");
  call_other(BASARIROOM "kaefig", "KExit");
  say(TPN+" oeffnet den Kaefig.\n");
  return 1;
}

int QueryKaefigStatus()
{
  return kaefig;
}

int SetKaefig(int i)
{
  kaefig=i;
  return i;
}

void CloseDoor()
{
  if(!kaefig) return;
  kaefig=0;
  call_other(BASARIROOM "kaefig", "RemoveExit");
  call_other(BASARIROOM "kaefig", "say", "Die Tuer wird geschlossen!\n");
  RemoveExit("kaefig");
  say("Die Kaefigtuer wird geschlossen.\n");
}

void KExit()
{
  AddExit("kaefig", "in den Kaefig#"+BASARIROOM "kaefig");
  return;
}
