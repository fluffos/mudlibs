#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Gleise fuehren hier weiter, auf eine Oeffnung im Fels zu. Sie "
    "sind hier gut instand gehalten. Der Gang wurde hier nicht so stark "
    "bearbeitet und ist daher noch etwas roh und zackig. Aus dem Osten "
    "hoerst Du immer wieder ein paar Tropfen auf eine Wasserflaeche "
    "fallen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "gleise" }),
    "Die Gleise, die hier gut instand gehalten sind, fuehren von Suedwesten "
    "nach Osten - oder umgekehrt." );

  AddDetail( ({ "oeffnung" }),
    "Durch die Oeffnung im Fels erkennst Du blaeuliches Licht. Ausserdem "
    "siehst Du dahinter eine Bruecke." );

  AddDetail( ({ "tropfen" }),
    "Du siehst hier keine Tropfen, kannst sie aber sehr gut hoeren." );

  AddDetail( ({ "wasserflaeche" }),
    "Du siehst hier keine Wasserflaeche, von einem kleinen Rinnsal an der "
    "Wand abgesehen." );

  AddDetail( ({ "bruecke" }),
    "Du kannst hier nicht viel von der Bruecke erkennen. Sie ist weiter im "
    "Osten." );

  AddSound( ({ "tropfen" }),
    "Immer wieder hoerst Du, wie ein paar Tropfen platschend in einem Wasser "
    "landen." );

  AddDetail( ({ "rinnsal" }),
    "Ein kleines Rinnsal rinnt die noerdliche Wand herunter und versickert "
    "dort im Boden." );

  AddDetail( ({ "wasser" }),
    "Das Wasser duerfte sich, so wie die Tropfen, im Osten befinden." );

  AddSound( ({ "wasser" }),
    "Du hoerst neben den Tropfen hie und da das Schwappen von Wellen." );

  AddSound( ({ "wellen", "schwappen" }),
    "*schwipp* *schwapp*" );

  AddDetail( ({ "licht" }),
    "Durch die Oeffnung im Osten gelangt ein wenig Licht herein, aber nicht "
    "genug um den Raum zu erhellen." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", GLEISEROOM "c3_gleise" );
  AddExit( "osten", GLEISEROOM "e2_bruecke");

//--Items-----------------------------------------------------------------

  AddItem( GLEISENPC "delf_schleicher", REFRESH_DESTRUCT);
}

