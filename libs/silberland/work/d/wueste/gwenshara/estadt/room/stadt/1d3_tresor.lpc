#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier in dem grossen Vorraum der koeniglichen Schatzkammer. "
	"Der Boden wurde mit feinsten Marmorplatten ausgelegt. Ein roter Teppich "
	"fuehrt vom Eingang zu einem Durchgang im Sueden. Die Waende bestehen "
	"ebenfalls aus Marmor, der auf hochglanz poliert wurde. Einige Fackelst"
	"aender wurden aufgestellt erhellen diesen Vorraum. An der Suedwand "
	"befindet sich ein Durchgang, der mit einem Fallgitter gesichert ist.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "vorraum", "raum" }),
    "Du befindest Dich hier im Vorraum der koeniglichen Schatzkammer. Er "
	"ist aeusserst luxurioes ausgestattet." );
	
  AddDetail( ({ "kammer", "schatzkammer", "gebaeude" }),
    "In diesem Gebaeude befinden sich angeblich die groessten Schaetze "
	"der Wuestenzwerge." );
	
  AddDetail( ({ "boden" }),
    "Der Boden wurde mit teuren Marmorplatten ausgelegt, die auf Hochglanz "
	"poliert wurden." );
	
  AddDetail( ({ "platten", "marmorplatten" }),
    "Der Boden und die Waende wurden mit feinstem weissen Marmor verkleidet." );
	
  AddDetail( ({ "teppich" }),
    "Ein roter Teppich aus gefaerbtem Kamelhaar wurde vom Eingang bis zu dem "
	"Fallgitter im Sueden gelegt. Er soll Besucher vom Reichtum der Zwerge "
	"ueberzeugen." );
	
  AddDetail( ({ "eingang" }),
    "Der Eingang in dieses Gebaeude befindet sich im Norden. Er ist gross und "
	"breit und kann im Notfall mit einem Fallgitter verschlossen werden." );
	
  AddDetail( ({ "durchgang", "suedwand" }),
    "Im Sueden befindet sich ein Durchgang, der wohl in den Hauptraum der "
	"Schatzkammer fuehrt. Er ist gerade so gross, dass ein Troll angenehm hindurch "
	"gehen kann. Ein Fallgitter versperrt ihn jedoch." );
	
  AddDetail( ({ "waende", "wand" }),
    "Die Waende wurden, so wie der Boden, mit weissem Marmor verkleidet." );
	
  AddDetail( ({ "staender", "fackelstaender" }),
    "Vier goldene Fackelstaender erhellen den Raum." );
	
  AddDetail( ({ "hochglanz" }),
    "Die Marmorplatten wurden soweit poliert, dass Du dich selbst darin "
	"spiegelst." );
	
  AddDetail( ({ "hauptraum" }),
    "Der befindet sich wohl hinter dem Fallgitter im Durchgang." );
	
  AddDetail( ({ "troll" }),
    "Trolle sind sehr gross." );
	
  AddDetail( ({ "notfall" }),
    "Im Fall eines Angriffs." );
	
  AddDetail( ({ "fallgitter" }),
    "Der Durchgang in der Suedwand wurde mit einem Fallgitter verschlossen. "
	"Es sieht aeusserst stabil aus. Vielleicht kann es einer der Waechter fuer "
	"Dich oeffnen." );
	
  AddDetail( ({ "marmor" }),
    "Dieser weisse Marmor ist sehr selten und sehr sehr teuer." );
	
  AddDetail( ({ "schaetze" }),
    "Angeblich werden hier die grossen Schaetze der Wuestenzwerge gelagert." );
	
  AddDetail( ({ "besucher" }),
    "Du bist ein Besucher und findest das alles sehr beeindruckend." );
	
  AddDetail( ({ "haar", "kamelhaar" }),
    "Der Teppich wurde aus besonders feinem Kamelhaar gefertigt, das dunkelrot "
	"gefaerbt wurde." );
	
  AddDetail( ({ "reichtum" }),
    "Dieses Volk muss sehr reich sein!" );
	
  AddDetail( ({ "volk" }),
    "Damit sind die Wuestenzwerge gemeint." );
	
  AddDetail( ({ "waechter" }),
    "Es ist wohl gerade keiner da." );
	
  AddDetail( ({ "angriff", "angriffs", "fall" }),
    "Wer waere denn so verrueckt diese Schatzkammer anzugreifen?" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", STADTROOM "1d2_stadt" );
  AddExit( "sueden", ([EX_DEST: STADTROOM "1d4_tresor",
                       EX_TESTFUNC: "fallgitter"])  );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "schatzwache", REFRESH_DESTRUCT );
  AddItem( STADTNPC "schatzwache", REFRESH_DESTRUCT );
}

int fallgitter()
{
  if(present("\nwuestenzwerg_schatzwache", TO))
  {
    tell_object(TP, BS("Eine der Schatzwachen oeffnet das Fallgitter fuer "
	                   "Dich."));
	tell_room(TO, BS("Eine der Schatzwachen oeffnet das Fallgitter fuer "
	                 +TP->Name(WEN)+" und schliesst es dann wieder."), ({TP}));
	return 1;
  }
  
  tell_object(TP, BS("Du kannst nicht weiter gehen, da das Fallgitter "
                     "geschlossen ist!"));
  return 0;
}
