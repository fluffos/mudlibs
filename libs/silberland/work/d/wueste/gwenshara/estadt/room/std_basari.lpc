#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "../basari.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Mada Basari");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);

//-----Details Anfang-----
  AddDetail( "sand",
            "Hier gibt es viel davon. Du bist ja auch in der Wueste.");

  AddDetail( ({"wueste","wuesten"}),
            "Die Wueste ist trocken und voll mit Sand.");

  AddDetail( ({"himmel"}),
            "Er ist strahlend blau.");

  AddDetail( "sonne",
             "Sie brennt unertraeglich auf dich herunter.");

  AddDetail( ({"mada","basari","basar"}),
            "Das hier ist der Mada Basari, der grosse Basar der "
	    "Wuestenzwerge!\n");
//-----Details Ende-----

  AddSmell( DEFAULT_SMELL,
	    "Hier riecht es nach vielen exotischen Gewuerzen und Kamel.");
  AddSmell( ({"gewuerze","gewuerzen"}),
            "Die vielen verschiedenen Gewuerze riechen gut.");
  AddSmell( "kamel",
            "Ierks! Das stinkt!");

  AddSound( DEFAULT_SOUND,
            "Von ueberall her hoerst Du die Stimmen der Haendler, die ihre "
            "Waren feil bieten.");
  AddSound( ({"stimmen","haendler"}),
            "Von ueberall her droehnen die Stimmen der Haendler.");

} 
