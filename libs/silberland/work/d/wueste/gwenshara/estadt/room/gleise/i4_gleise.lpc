#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Der Gang hier ist wesentlich breiter, als Du es hier unten bisher "
    "gesehen hast. Du siehst, dass die Gleise, die hier durch fuehren, "
    "an einer Stelle unterbrochen sind, weil daran gearbeitet wird. Damit "
    "sie weiter benutzt werden koennen wurde eine kleine Ausweichschlaufe "
    "gebaut.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "gleise" }),
    "Die Gleise kommen aus dem Nordwesten und fuehren weiter nach Nordosten. "
    "An einer Stelle sind sie hier unterbrochen, da man gerade daran arbeitet. "
    "Damit die Gleise weiter benutzt werden koennen, haben die Wuestenzwerge "
    "eine kleine Ausweichschlaufe gebaut. Einige Werkzeuge stehen neben den "
    "Gleisen herum." );

  AddDetail( ({ "stelle" }),
    "An einer Stelle wurden wurden die Gleise unterbrochen, da man daran "
    "irgendwas repariert." );

  AddDetail( ({ "schlaufe", "ausweichschlaufe" }),
    "Damit die Gleise weiterhin benutzt werden koennen, wurde ein zusaetzliches "
    "Gleisstueck so eingebaut, dass es die aktuelle Baustelle umfaehrt." );

  AddDetail( ({ "werkzeuge" }),
    "Neben den Gleisen steht ein kleiner Werkzeugkoffer und ein Eimer." );

  AddDetail( ({ "baustelle" }),
    "Hier handelt es sich eindeutig um eine Baustelle an den Gleisen." );

  AddDetail( ({ "koffer", "werkzeugkoffer" }),
    "In dem Werkzeugkoffer findest Du alles, was man so braucht um "
    "Dinge zu reparieren." );

  AddDetail( ({ "stueck", "gleisstueck" }),
    "Dieses Gleisstueck dient als Ausweichschlaufe." );

  AddDetail( ({ "dinge" }),
    "Eben Dinge, die kaputt sind. Sonst muesste man sie nicht reparieren." );

  AddDetail( ({ "eimer" }),
    "Der Eimer ist gefuellt mit tausenden von Schrauben." );

  AddDetail( ({ "schrauben" }),
    "Die Schrauben werden wohl benutzt um die Gleise im Boden zu verankern." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", GLEISEROOM "h3_gleise" );
  AddExit( "nordosten", GLEISEROOM "l3_gleise");

//--Items-----------------------------------------------------------------
  
  AddItem( GLEISENPC "mechaniker", REFRESH_DESTRUCT );
}

