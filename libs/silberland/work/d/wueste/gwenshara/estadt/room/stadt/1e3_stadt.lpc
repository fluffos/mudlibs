#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest dich hier in einem Durchgang zwischen zwei Hallen in "
    "Quaul, der Stadt der Wuestenzwerge. Mehrere Feuerkoerbe an den Waenden "
    "erhellen den Durchang mit flackerndem Licht. Der breite Weg des Durchgangs "
    "fuehrt nach Sueden, waehrend ein kleinerer im Halbschatten verborgen "
    "nach Osten abzweigt.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );
	

  AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
  
//--Exits------------------------------------------------------------------
  
  AddExit( "norden", STADTROOM "1e2_stadt" );
  AddExit( "osten", STADTROOM "1f3_gasse" );
  AddExit( "sueden", STADTROOM "1e4_koenigsplatz" );
}
