#include "../def.h"

inherit STD "std_gleise";

int drider;

string stelle()
{
  if(drider)
    return BS("An einer Stelle des Stalaktiten erkennst Du eine eingeritzte Rune.");
  return BS("An dieser Stelle hat sich wohl etwas befunden, dass "
	    "unkenntlich gemacht wurde.");
}

void create()
{
  ::create();
  drider = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Dieser Gang ist schmaler als die anderen, in denen Du bisher warst. "
    "Im Osten fuehrt ein schmaler Riss im Fels weiter. Die Waende hier "
    "bestehen aus scharfkantig abgebrochenem Gestein. Es sieht aus wie "
    "hunderte kleiner Speere, die darauf warten Dich aufzuspiessen. Auch "
    "von der Decke ragen etliche Stalaktiten nach unten.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "riss" }),
    "Ein schmaler Riss fuehrt im Osten weiter. Es sieht aus, als waere der "
    "Fels hier gewaltsam geoeffnet worden. Du wirst aufpassen muessen, Dich "
    "nicht an den Kanten zu schneiden." );

  AddDetail( ({ "fels", "gestein", "felsgestein" }),
    "Das Felsgestein hier ist scharfkantig und spitz." );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier sind uebersaeaet von scharfkantigen und spitzen Felsen. "
    "Es sieht so aus, als waere dieser Gang mit purer Gewalt auseinander "
    "gerissen worden." );

  AddDetail( ({ "speere" }),
    "Es sind keine wirklchen Speere, aber wenn Du aus Versehen dagegen stoesst "
    "kann das boese enden." );

  AddDetail( ({ "decke" }),
    "Von der Decke ragen mehrere spitze Stalaktiten nach unten." );

  AddDetail( ({ "stalaktiten" }),
    "Wenn auch nur einer von ihnen abbricht koennte er Dich toedlich verletzen. "
    "Ein Stalaktit schwebt drohend ueber dem Riss im Osten." );

  AddDetail( ({ "kanten" }),
    "Die Kanten hier sind ganz schoen scharf. Nur eine falsche Bewegung und Du "
    "wirst dich zweifelsfrei verletzen." );

  AddDetail( ({ "gewalt" }),
    "Irgend eine brachiale Kraft hat diesen Gang aus dem Felsen gerissen." );

  AddDetail( ({ "stalaktit" }),
    "Er ragt sehr tief in den Gang, so dass Du Dich buecken musst um unter "
    "ihm durch zu kommen. An einer Stelle erscheint Dir etwas merkwuerdig." );

  AddDetail( ({ "bewegung" }),
    "Pass gut auf, sonst wird es gefaehrlich fuer Dich!" );

  AddDetail( ({ "kraft" }),
    "Diese Kraft war vermutlich maechtige Magie!" );

  AddDetail( ({ "stelle" }),
    #'stelle );

  AddDetail( ({ "magie" }),
    "Es waere sehr gut moeglich, dass es sich hier um Magie handelt." );

  AddDetail( ({ "rune" }),
    "Die Rune stellt eine Spinne mit dem Kopf einer Frau dar." );

  AddDetail( ({ "spinne", "frau" }),
    "Du bist Dir ziemlich sicher, dass es sich bei dieser Rune um eine "
    "dunkelelfische Beschwoerungsglyphe handelt." );

  AddDetail( ({ "glyphe", "beschwoerungsglyphe" }),
    "Was auch immer sie ruft, es waere vielleicht besser sie zu zerkratzen!" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", GLEISEROOM "h3_gleise" );
  AddExit( "osten", ([ EX_DEST: GLEISEROOM "j2_darkelves", 
		       EX_TESTFUNC:        "summon_drider",
		       EXG_ID:             "\ndrider_guard"]));

//--Kommandos--------------------------------------------------------------

  AddCmd( ({"zerkratze", "zerkratz"}), "cmd_kratzen");

}

int summon_drider()
{
  object ob;
  if(TP->id("\nwz_darkelf")) return 1;
  if(present("\ndrider_guard", TO))
  {
    tell_room(TO, BS("Der Wachdrider baut sich vor dem Riss auf und laesst niemanden vorbei."));
    return 0;
  }
  if(!drider) return 1;

  tell_room(TO, BS("Tausende kleiner Spinnen kriechen aus Ritzen im Boden "
	    "hervor und Formen sich zu einer Gestalt!"));
  tell_object(TP, BS("Erschrocken stolperst Du zurueck!"));

  ob = clone_object(GLEISENPC "drider");
  ob->move(TO, M_GO|M_SILENT|M_NOCHECK);
  ob = 0;

  return 0;
}

int cmd_kratzen(string str)
{
  notify_fail("Was moechtest Du zerkratzen?\n");
  if(!str || str=="") return 0;
  if(!(str == "rune" ||
       str == "glyphe" ||
       str == "beschwoerungsglyphe")) return 0;

  notify_fail("Mit blossen Haenden geht das nicht! Such Dir doch eine Waffe!\n");
  if(!objectp(TP->QueryProp(P_WEAPON))) return 0;

  if(!drider)
  {
    tell_object(TP, BS("Das hat schon jemand fuer Dich erledigt!"));
    return -1;
  }

  drider = 0;
  tell_object(TP, BS("Mit deiner Waffe schlaegst Du ein paar mal auf die Rune, "
	      "bis sie unkenntlich ist."));
  tell_room(TO, BS(TPN+" schlaegt auf einen Stalaktiten ein."), ({TP}));
  return 1;
}

void reset()
{
  ::reset();
  drider=1;
}
