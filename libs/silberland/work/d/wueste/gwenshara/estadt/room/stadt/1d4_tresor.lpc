#include "../def.h"
#include "../../master/store.h"
#define BEAMTER(x) TO->Message(break_string(x, 78, "Haschram sagt: "), MSGFLAG_SOUND)

inherit STD "std_stadt";

void Error(int n)
{
  BEAMTER("Es ist ein Fehler aufgetreten! Wende Dich mit der Fehlernummer "+
	  n+" an einen anwesenden Magier!");
}

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier befindest Du Dich offensichtlichim Hauptraum der Schatzkammer. "
	"So, wie auch der Vorraum, wurde der gesamte Raum mit Marmorplatten "
	"verkleidet. An der Suedwand befindet sich ein riesiges staehlernes "
	"Tor, vor dem zwei ebenso riesige Kohlebecken stehen. In den Waenden "
	"erkennst Du viele kleine goldene Schloesser.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "hauptraum", "raum" }),
    "Du befindest Dich hier im riesigen Hauptraum der Schatzkammer." );
	
  AddDetail( ({ "schatzkammer" }),
    "Dies hier ist die beruechtigte Schatzkammer der Wuestenzwerge. Die "
	"ganzen Schaetze befinden sich wohl hinter dem Stahltor." );
	
  AddDetail( ({ "vorraum" }),
    "Den Vorraum erreichst Du durch einen Durchgang im Norden." );
	
  AddDetail( ({ "platten", "marmorplatten", "platte" }),
    "Der gesamte Raum wurde mit teuren Marmorplatten aus gelegt. Auf einigen "
	"kannst Du sogar die Praegung des Lieferanten erkennen." );
	
  AddDetail( ({ "suedwand" }),
    "Die Suedwand wird von einem gigantischen Stahltor eingenommen." );
	
  AddDetail( ({ "tor", "stahltor" }),
    "Das Tor ist riesig. Es wurde aus gehaertetem Zwergenstahl gefertigt, und "
	"ist wohl auch von dem staerksten Berserker nicht zu durchbrechen. Neben "
	"dem Tor erkennst Du etwa in Brusthoehe sechs kleine Loecher in der Wand." );
	
  AddDetail( ({ "kohlebecken", "becken" }),
    "Grosse Flammen schlagen aus den Kohlebecken und erhellen den Raum." );
	
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind ebenfalls mit Marmorplatten ueberzogen. In jeder Platte "
	"befindet sich ausserdem ein kleines goldenes Schloss und ein Taefelchen "
	"mit einer eingravierten Nummer." );
	
  AddDetail( ({ "schloesser" }),
    "Ueber jedem Taefelchen befindet sich ein kleines Schloss." );
	
  AddDetail( ({ "flammen" }),
    "Hohe Flammen schlagen aus den Kohlebecken." );
	
  AddDetail( ({ "lieferanten", "praegung" }),
    "Die Platten wurden, wie Du anhand der Praegung erkennen kannst, von "
	"verschiedenen Lieferanten hier her gerbacht." );
	
  AddDetail( ({ "schaetze" }),
    "Die grossen Schaetze werden hinter dem Stahltor verborgen gehalten." );
	
  AddDetail( ({ "schloss" }),
    "So ein Schloss kann vermutlich nur mit dem richtigen Schluessel geoeffnet "
	"werden." );
	
  AddDetail( ({ "taefelchen" }),
    "Auf jeses dieser kleinen goldenen Taefelchen wurde eine Nummer graviert." );
	
  AddDetail( ({ "berserker", "krieger" }),
    "Berserker sind die staerksten Kaempfer." );
	
  AddDetail( ({ "hoehe", "brusthoehe" }),
    "Neben Tor in Brusthoehe befinden sich sechs etwa fingerdicke Loecher." );
	
  AddDetail( ({ "loecher" }),
    "Du hast nicht die geringste Ahnung, wofuer diese Loecher da sind." );
	
  AddDetail( ({ "schluessel" }),
    "Du hast keinen." );
	
  AddDetail( ({ "kaempfer" }),
    "Berserker gelten weithin als die maechtigsten Krieger." );
	
  AddDetail( ({ "ahnung" }),
    "Wenn du nur eine haettest..." );
	
  AddDetail( ({ "stahl", "zwergenstahl" }),
    "Dieser Zwergenstahl wurde merhfach gehaertet, so dass er sogar einem "
	"Berserker widerstehen kann." );
	
  AddDetail( ({ "durchgang" }),
    "Der Durchgang im Norden wurde mit einem Fallgitter gesichert." );
	
  AddDetail( ({ "nummer" }),
    "Viele verschiedene Nummern stehen auf den Taefelchen." );
	
  AddDetail( ({ "fallgitter", "seite" }),
    "Du kannst von dieser Seite problemos durch das Fallgitter hindurch "
	"gehen." );
	
	
//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", STADTROOM "1d3_tresor" );
  
//--Items-----------------------------------------------------------------

  AddItem( STADTOBJ "entnahme_kiste", REFRESH_DESTRUCT );
  AddItem( STADTNPC "schatzmeister", REFRESH_DESTRUCT );
  AddItem( STADTOBJ "tafel_faecher", REFRESH_DESTRUCT );

//--Commands--------------------------------------------------------------
  AddCmd( ({ "miete", "miet" }), "cmd_spind" );
  AddCmd( ({ "betrachte","betracht","schau","schaue" }), "cmd_spindinv");
  AddCmd( ({ "lege","leg","lager","lagere" }), "cmd_lagern");
  AddCmd( ({ "nimm", "nahme" }), "cmd_nimm");
  AddCmd( ({ "leere", "leer", "raeume", "raeum" }), "cmd_leeren");
}


int cmd_leeren(string str)
{
  notify_fail("Was willst Du leeren?\n");
  if(!str || str == "") return 0;
  if(!(str == "schliessfach" ||
       str == "fach" )) return 0;

  if(call_other(STOREMASTER, "EmptyStore", TP) == -1)
  {
    BEAMTER("Tut mir leid, aber Du hast hier offenbar kein Schliessfach!");
  }
  
  return 1;
}


int cmd_nimm(string str)
{
  string was;
  object ob;
	
  notify_fail("Was willst Du nehmen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s aus schliessfach", was) != 1) return 0;

  notify_fail("Sowas ist da nicht!\n");
  if(!ob=present(was, find_object(LAGERRAUM+getuid(TP)))) return 0;

  if(call_other(STOREMASTER, "RemoveObject", ob, TP) == -2)
  {
    BEAMTER("Tut mir leid, aber Du hast hier offenbar kein Schliessfach!");
  }
  return 1;
}

int cmd_lagern(string str)
{
  int i;
  string what;
  object ob;
  
  notify_fail("Was moechtest Du wo lagern?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s in schliessfach", what) != 1) return 0;

  notify_fail("Sowas hast Du doch gar nicht!\n");
  if(!ob=present(what, TP)) return 0;

  notify_fail("Das kannst Du nicht in das Schliessfach geben.\n");
  if(ob->QueryProp(P_CURSED) || ob->QueryProp(P_NODROP))
    return 0;

  i=call_other(STOREMASTER, "AddObject", ob, TP);

  if(i == -2)
  {
    BEAMTER("Tut mir leid, aber Du hast hier offenbar kein Schliessfach!");
  }

  tell_object(TP, BS("Du legst "+ob->name()+" in Dein Schliessfach."));
  Message(BS(TPN+" legt etwas in "+TP->QueryPossPronoun(2)+" Schliessfach."), MSGFLAG_NO_TP);
  
  return 1;
}

int cmd_spindinv(string str)
{
  notify_fail("Was willst Du betrachten?\n");
  if(!str || str == "") return 0;
  if(!(str == "inventar von schliesfach" ||
       str == "schliessfachinventar" ||
       str == "inventar" ||
       str == "in schliessfach" ||
       str == "inventar von fach" ||
	   str == "fachinventar" ||
	   str == "in fach")) return 0;

  if(!objectp(find_object(LAGERRAUM+getuid(TP))))
  {
   BEAMTER("Tut mir leid, aber Du hast hier offenbar kein Schliessfach!");
   return -1; 
  }

  tell_object(TP, call_other(STOREMASTER, "QueryStoreInv", TP));

  TO->Message(TPN+" sieht in "+TP->QueryPossPronoun(2)+" Schliessfach\n", MSGFLAG_NO_TP);
  return 1;
}

int cmd_spind(string str)
{
  int i;
  notify_fail("Was willst Du mieten?\n");

  if(!str || str == "") return 0;

  if(!(str == "schliessfach" ||
       str == "platz" ||
       str == "lagerplatz" ||
	   str == "fach")) return 0;
	   
  if(!present("\nschatzmeister"))
  {
    tell_object(TP, BS("Ohne den Schatzmeister kannst Du kein Schliessfach "
	                   "beantragen!"));
	return -1;
  }

  tell_object(TP, "Du fuellst den Mietantrag fuer ein Schliessfach aus.\n");
  TO->Message(TP->Name(WER, 1)+" fuellt ein Formular aus.\n", MSGFLAG_NO_TP);

  tell_object(TP, BS("Wie lange willst Du das Fach mieten? [in Wochen]"));
  input_to("spind_kosten");
  
  return 1;
}

int spind_bewilligt(object pl, int weeks)
{
  int i;
  if(find_object(LAGERRAUM+getuid(pl)))
  {
    BEAMTER("Du willst also Deine Mietdauer verlaengern. Gut!");
	i = STOREMASTER->RenewDuration(pl, weeks);
	if(i < 1)
	{
	  Error(i);
	  return -1;
	}
	BEAMTER("Deine Mietdauer wurde um "+weeks+" Wochen verlaengert!");
    return 1;
  }

  i = call_other(STOREMASTER, "ActivateStore", pl, weeks);
  
  if(i < 0)
  {
    Error(i);
    return -1;
  }
  else if(i == 0)
  {
    BEAMTER("Um hier ein Schliessfach zu erhalten musst Du Erzseher sein!");
  }

  BEAMTER("Also gut, "+pl->Name(WER)+" ab nun kannst Du hier deine Sachen lagern!");
}

int spind_bewilligen(string input, int weeks)
{
  if(input == "ja")
    spind_bewilligt(TP, weeks);
  else
    tell_object(TP, BS("Du zerreist den Mietantrag."));
  return 1;
}

int spind_kosten(string weeks)
{
  int i, cost;
  
  i = to_int(weeks);
  cost =i*PRICE;
  // weniger als eine woche ist sinnlos
  if(i<1)
  {
    tell_object(TP, BS("Die Mindestmietdauer betraegt eine Woche!"));
	return 0;
  }
  
  tell_object(TP, BS("Das wurde Dich "+cost+" Erfahrungspunkte kosten."));
  tell_object(TP, BS("Willst Du das Schliessfach mieten? [ja|nein]"));
  input_to("spind_bewilligen", 0, i);
  return 1;
}
