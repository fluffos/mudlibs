#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Tor von Quaul");
  SetProp(P_INT_LONG,
    "Du befindest Dich hier am Tor von Quaul. Das riesige Felsportal oeffnet "
    "sich hier nach Quaul. Grosse Feuerschalen links und rechts davon erhellen "
    "den Platz. Ueber dem Tor befinden sich einige schmale Fenster und an "
    "der Decke des Tores erkennst du ein starkes Eisengitter, dass bei Bedarf "
    "herabgelassen werden kann.");

//--Details----------------------------------------------------------------
  AddDetail( ({ "tor", "portal", "steinportal", "torbogen", "bogen" }),
      "Ein riesiges Steinportal fuehrt Dich nach Quaul hinein - oder hinaus." );

  AddDetail( ({ "schale", "schale", "feuerschale", "feuerschalen" }),
      "Zwei grosse Flammen, die aus eisernen Schalen lodern erhellen das "
      "Tor, sodass alles gut erkennbar ist." );

  AddDetail( ({ "platz" }),
      "Unter dem Torbogen befindet sich ein etwas groesserer Platz, der von den "
      "Wachen genutzt wird um Reisende zu kontrollieren." );

  AddDetail( ({ "fenster" }),
      "Ueber dem Tor befinden sich schmale Fenster, hinter denen Du Licht "
      "erkennen kannst. Vermutlich handelt es sich dabei um Schiessscharten, "
      "welche die Verteidiger der Stadt nutzen um sich zu verschanzen." );

  AddDetail( ({ "gitter", "eisengitter" }),
      "Ein Gitter aus etwa unterarmdicken Eisenstaeben kann so herabgelassen "
      "werden, dass das Tor undurchdringlich verschlossen ist." );

  AddDetail( ({ "bedarf" }),
      "Wenn die Stadt angegriffen wird." );

  AddDetail( ({ "flamme", "flammen" }),
      "Zwei zwergenhohe Flammen erhellen das Tor. Sie werden von "
      "faustgrossen Kohlen genaehrt." );

  AddDetail( ({ "wachen" }),
      "Zwei Wachen sollten hier am Tor stehen, um die Sicherheit der Stadt "
      "zu gewaehrleisten." );

  AddDetail( ({ "reisende" }),
      "Solche, wie du es bist." );

  AddDetail( ({ "scharten", "schiessscharten", "schlitze" }),
      "Durch die schmalen Schlitze koennen Angreifer beschossen werden." );

  AddDetail( ({ "verteidiger", "angreifer" }),
      "Das ist wohl nur im Kampf relevant." );

  AddDetail( ({ "staebe", "eisenstaebe" }),
      "Die sehen sehr massiv aus, und sind sicher nicht einfach so zu "
      "zerstoeren." );

  AddDetail( ({ "kohle", "kohlen" }),
      "Durch sie brennt das Feuer." );

  AddDetail( ({ "sicherheit" }),
      "Die Wuestenzwerge scheinen wert auf die Sicherheit ihrer Stadt zu legen." );

  AddDetail( ({ "kampf" }),
      "Die Wuestenzwerge wirken sehr kampferprobt." );

  AddExit( "westen", STADTROOM "1a2_bruecke" );
  AddExit( "osten",  STADTROOM "1c2_platz");

  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT );
  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT );
}
