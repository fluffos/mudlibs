inherit "/d/wueste/gwenshara/estadt/room/std_basari";

#include <properties.h>
#include "../def.h"
#include "/sys/ansi.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

string wer;
int stat;
int greifen=5;
int anzahl=1;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_SHORT, "Auf dem Mada Basari");
  SetProp( P_INT_LONG,
   "Du befindest Dich hier ganz im Osten des Basars. Hier befindet sich "
   "ein kleiner Trinkbrunnen. Das Wasser entspringt in der Mitte des "
   "Brunnens und plaetschert in das sternenfoermige Becken, das im Boden "
   "eingelassen wurde. Aus dem Norden vernimmst Du einen wunderbaren Duft.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----

  AddDetail( ({"osten"}),
	    "Nach Osten kannst Du nicht mehr weitergehen. Probier einfach "
	    "eine andere Richtung.");

  AddDetail( ({"richtung"}),
	    "Du kannst nach Norden, Sueden oder Westen gehen.");

  AddDetail( ({"norden","sueden","westen"}),
	    "Pass auf, dass Du Dich nicht verlaeufst.");

  AddDetail( ({"basar","basars"}),
	    "Du befindest Dich im Moment auf dem Basar.");

  AddDetail( ({"moment"}),
	    "Und schon ist er um.");

  AddDetail( ({"brunnen","trinkbrunnen","brunnens"}),
	    "Der Brunnen hat ein sternfoermiges Becken. In der Mitte sprudelt "
	    "das Wasser in die Hoehe.");

  AddDetail( ({"becken","beckens"}),
	    "Dieses sternfoermige Becken ist mit einem Mosaik besetzt, das "
	    "verschiedene Ornamente darstellt.");

  AddDetail( ({"mosaik"}),
	    "Das Mosaik besteht aus vielen kleinen Mosaiksteinchen. Der ganze "
	    "Brunnen ist an der Aussenwand und im Inneren besetzt.");

  AddDetail( ({"mosaiksteinchen","steinchen"}),
	    "Du kannst sie gar nicht zaehlen, weil es einfach zuviele sind. "
	    "Dir verschlaegt der Atem bei all den Farben.");

  AddDetail( ({"atem"}),
	    "Du ringst nach Luft.");

  AddDetail( ({"luft"}),
	    "Sie ist total staubig und Du musst husten.");

  AddDetail( ({"farben"}),
	    "Es sind wirklich alle Farben da: Weiss, Rot, Gruen, Blau, Gelb, "
	    "Tuerkis, Rosa, Schwarz, Orange, Braun, Violett, Beige und viele "
	    "mehr.");

  AddDetail( ({"weiss","rot","gruen","blau","gelb","tuerkis","schwarz","orange",
	       "braun","violett"}),
	    "Du solltest vielleicht mal zum Osterhasen gehen!");

  AddDetail( ({"osterhase","hase","osterhasen"}),
	    "Du fragst Dich warum? Vielleicht kann er Dich ueber die Farben "
	    "aufklaeren, wenn Du das nicht mal weisst.");

  AddDetail( ({"rosa"}),
	    "Du bemerkst ein rosa Plaettchen, das gar nicht hier her gehoert.");

  AddSpecialDetail( ({"plaettchen"}),"rosaplaettchen");

  AddDetail( ({"fuge"}),
	    "Die Fuge broeckelt schon herunter und das Plaettchen fliegt "
	    "fast heraus. Du kannst ja versuchen es heraus zu kratzen.");

  AddDetail( ({"jemand"}),
	    "Dieser Jemand hat wohl keinen Sinn fuer Farben.");

  AddDetail( ({"sinn"}),
	    "Du anscheinend schon, sonst waere Dir das Plaettchen nicht "
	    "aufgefallen.");

  AddDetail( ({"beige"}),
	    "Ein Steinchen, in einem der Sternenbilder, wirkt wie vergilbtes "
	    "Gold.");

  AddDetail( ({"gold"}),
	    "Du koenntest es polieren, das Mosaiksteinchen. Dann glitzert es "
	    "bestimmt wieder schoen im Sonnenlicht.");

  AddDetail( ({"ornamente"}),
	    "Sie bestehen aus diesen Mosaiksteinchen und verzieren die "
	    "Aussenwand und das Innere.");

  AddDetail( ({"aussenwand","wand"}),
	    "Du erkennst lauter alte Sternenbilder.");

  AddDetail( ({"sternenbilder","bilder"}),
	    "Du siehst verschiedene Sternenformen in verschiedensten Farben.");

  AddDetail( ({"sternenformen","formen"}),
	    "Sie sind geschwungen, gerade oder zackig und sind dreieckig bis "
	    "zehneckig.");

  AddDetail( ({"innere","inneren"}),
	    "Das Wasser bewegt sich unruhig durch den Sprudel. Du siehst "
	    "aber verschiedene Motive von Meerestieren.");

  AddDetail( ({"meerestieren","meerestiere","tiere","meerestier","tier","motive"}),
            "Du siehst den Umriss von einem gruenen Fisch, einer "
	    "dunkelblauen Krake, einen roten Hummer, einen schwarzen Seeigel "
	    "und eine gelbe Anemone.");

  AddDetail( ({"umriss"}),
	    "Durch das bewegende Wasser kannst Du die Meerestiere ungefaehr "
	    "erkennen.");

  AddDetail( ({"fisch","gruener fisch"}),
	    "Der Fisch schillert durch das Wasser gruen durch und wirkt so "
	    "lebendig, als wuerde er augenblicklich heraus springen.");

  AddDetail( ({"krake","dunkelblaue Krake"}),
	    "Die Arme der Krake wirken im unruhigen Wasser so als wuerden sie "
	    "sich bewegen.");

  AddDetail( ({"arme","armen"}),
	    "Von den Armen der Krake zu Deinen. Du beugst Deinen Arm und spannst "
	    "Deine Muskeln an.");

  AddDetail( ({"muskeln","muskeln","muskel"}),
	    "Der Muskel bildet eine grosse Auswoelbung und zeigt, dass Du "
	    "stark bist.");

  AddDetail( ({"arm"}),
	    "Da schlabbert Dein Muskel herunter.");

  AddDetail( ({"auswoelbung"}),
	    "Ploetzlich kippt die Auswoelbung nach unten und haengt "
	    "schlabbrig vom Arm herunter.");

  AddDetail( ({"hummer","roter hummer","roten hummer"}),
	    "Dieses Bild vom Hummer ist, was Du soweit erkennen kannst, sehr "
	    "schoen.");

  AddDetail( ({"bild"}),
	    "Du wuerdest einmal gerne das Bild angreifen.");

  AddDetail( ({"seeigel","igel","schwarzer seeigel","schwarzen seeigel"}),
	    "Auch der ist ein Meerestier.");

  AddDetail( ({"anemone","gelbe anemone"}),
	    "Ein schoenes leuchtendes Gelb in allen Farben abschattiert.");

  AddDetail( ({"wasser"}),
	    "Das Wasser bewegt sich unruhig und reflektiert spielerisch "
	    "das Sonnenlicht.");

  AddDetail( ({"sonnenlicht","licht"}),
	    "Es ist hier unertraeglich heiss, dass Du genau jetzt zum "
	    "Schwitzen anfaengst.");

  AddDetail( ({"schwitzen"}),
	    "Dir rinnt wirklich alles herunter. Du denkst an ein spezielles "
	    "Lied...");

  AddDetail( ({"lied"}),
	    "Du kannst es singen.");

  AddDetail( ({"mitte"}),
	    "Hier entspringt der Sprudel des Beckens.");

  AddDetail( ({"sprudel"}),
	    "Er entspringt in der Mitte des Beckens, zischt in die Hoehe und "
	    "schwappt dann in das Wasser.");

  AddDetail( ({"hoehe"}),
	    "Nicht sehr hoch sprudelt das Wasser hinauf. Es ist aber gerade "
	    "hoch genug, dass sich das Wasser hin und her bewegt.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Sand. Alles ist staubig.");

  AddDetail( ({"sand"}),
	    "Gerade jetzt beisst Du auf Sand. Igitt! Dieses Krachen ist ja "
	    "ekelhaft.");

  AddDetail( ({"krachen"}),
	    "Du kannst es nur hoeren.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau, blauer geht es einfach nicht. "
	    "Nur die Sonne ist zu sehen.");

  AddDetail( ({"sonne"}),
	    "Das Sonnenlicht brennt auf Dich herunter.");

  AddDetail( ({"duft"}),
	    "Du kannst ihn nur riechen.");

  AddDetail( ({"zaehnen","zaehne"}),
	    "Du betastest Deine Zaehne und greifst nur auf Sand. Du spuckst "
	    "und spuckst und spuckst. Ekelhaft!!!");
  

  AddSmell(DEFAULT_SMELL, "Ein wunderbarer Duft stroemt Dir aus dem Norden "
	   "entgegen.");

  AddSmell( ({"duft"}),
	   "Es riecht nach frisch Gebratenem und Wein entgegen.");

  AddSmell( ({"gebratenes","gebratenem","wein"}),
	   "Dir rinnt das Wasser im Mund zusammen.");

  AddSmell( ({"mund"}),
	   "Du solltest lieber Deinem Mund lauschen.");

  AddSmell( ({"wasser"}),
	   "Du riechst nichts.");

  AddSmell( ({"norden"}),
	   "Geh nach Norden und rieche dort weiter.");

  AddSound(DEFAULT_SOUND, "Du lauscht Stimmen, die aus dem Norden kommen.");

  AddSound( ({"krachen"}),
	   "KRACH KRACH KRACH!! Das tut Deinen Zaehnen bestimmt nicht gut.");

  AddSound( ({"zaehne","zaehnen"}),
	   "Du solltest sie lieber untersuchen.");

  AddSound( ({"mund"}),
	   "SCHMATZ!");

  AddSound( ({"schmatz"}),
	   "Dir rinnt alles im Mund zusammen.");

  AddSound( ({"Stimmen"}),
	   "Du kannst nichts wirklich gut verstehen.");
  
	    
  
//-----Details Ende-----

  AddExit("norden", BASARIROOM "kneipe_zelt");
  AddExit("westen", BASARIROOM "basari_2x2");
  AddExit("sueden", BASARIROOM "basari_3x3");
  AddExit("suedwesten", BASARIROOM "basari_3x2");
  AddExit("nordwesten", BASARIROOM "basari_1x2");
  
  AddCmd( CMD_TRINKEN, "cmd_water");
  AddCmd( ({"traenke","traenk"}), "cmd_kamel");
  AddCmd( ({"polier","poliere"}), "cmd_gold");
  AddCmd( ({"greif","greife"}), "cmd_hummer");
  AddCmd( ({"sing","singe"}), "cmd_lied");
  AddCmd( ({"kratz","kratze"}), "cmd_plaettchen");
  AddCmd( ({"wirf","werfe"}), "cmd_werfen");

} 

string rosaplaettchen()
{
 if(anzahl==1)
 {return(BS("Jemand hat das notduerftig ausgebessert. Es liegt sehr locker in "
	    "der Fuge."));}
  return(BS("Jemand duerfte das rosa Plaettchen heraus gekratzt haben. Du "
	    "siehst nur noch den Abdruck der rosa Farbe."));
}

void reset()
{
  ::reset();
  greifen=5;
  anzahl=1;
  
}

	    
int cmd_water(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if(!str) return 0;
  if(!(str == "wasser" ||
       str == "von wasser" ||
       str == "wasser aus brunnen" ||
       str == "von brunnen" ||
       str == "aus brunnen" )) return 0;

  write("Du trinkst von dem kuehlen Wasser und fuehlst Dich sofort "
	      "besser.\n");
  if(TP->drink_soft(5)) TP->AddHp(5);
  
  Message(TPN+" trinkt von dem Brunnen.\n", MSGFLAG_NO_TP);
  return 1;
}

int cmd_kamel(string str)
{
  notify_fail("Wen willst Du wo traenken?\n");
  if(!str) return 0;
  wer="";
  if(sscanf(str, "%s an brunnen", wer) != 1) return 0;

  notify_fail(CAP(wer)+" ist doch gar nicht hier!\n");
  if(!present(wer)) return 0;
  
  if(wer!="kamel") return 0;
  
  notify_fail("Hol Dir doch besser ein eigenes Kamel.\n");  
  if(!present("\nkamel_quest", TP)) return 0;

  Message("Das Kamel senkt seinen Kopf und trinkt vom Wasser.\n");
  stat=present("\nkamel_quest", TP)->QueryFlag(0);
  present("\nkamel_quest", TP)->SetFlag(0);  

  return 1;
}

int cmd_gold(string str)
{
  notify_fail("Was willst Du polieren?\n");
  if(!str) return 0;
  if(!(str == "mosaiksteinchen"||
       str == "steinchen"||
       str == "beiges mosaiksteinchen"||
       str == "beiges steinchen")) return 0;

  write(BS("Du spuckst Dir in Deinen Aermel und faengst an wie wild an dem "
	"Steinchen herumzupolieren. Minuten spaeter erst laesst sich das "
	"Ergebnis zeigen. Tatsaechlich, es glitzert guelden im Sonnenlicht. "
	"Du bist stolz auf Dich.\n"));
  say(TPN+" werkt beim Trinkbrunnen herum.\n");

  return 1;
}

int cmd_hummer(string str)
{
  notify_fail("Was willst Du angreifen?\n");
  if(!str) return 0;
  if(!(str == "bild an"||
       str == "hummer an"||
       str == "ins wasser"||
       str == "in wasser")) return 0;

  write(BS("Du betastest das Bild und entdeckst, dass das ein echter Hummer "
	"ist. AUTSCH!!! Dieses Biest hat Dich gezwickt... Du steckst Deinen "
	"blutenden Finger in den Mund. Das ist ja ein echtes Tier!!!\n"));
  say(TPN+" schreit auf und steckt sich seinen Finger in den Mund.\n");

  if(greifen<1)
  {
     return -1;
  }
  
  TP->AddHp(-5);
  greifen--;
  
  return 1;
}

int cmd_lied(string str)
{
  notify_fail("Was willst Du singen?\n");
  if(!str) return 0;
  if(!(str == "lied"||
       str == "ein lied")) return 0;

  write(BS("Du singst: \"Brennend heisser Wuestensand ... So schoen, schoen war "
	"die Zeit ... fern so fern das Heimatland ... So schoen, schoen war "
	"die Zeit ... Kein Gruss, kein Herz, kein Kuss, kein Schmerz ... So "
	"schoen, schoen war die Zeit ... alles liegt so weit, so weit ...\""));
  say(BS(TPN+" sing: \"Brennend heisser Wuestensand ... So schoen, schoen war "
	"die Zeit ... fern so fern das Heimatland ... So schoen, schoen war "
	"die Zeit ... Kein Gruss, kein Herz, kein Kuss, kein Schmerz ... So "
	"schoen, schoen war die Zeit ... alles liegt so weit, so weit ...\" "
	"Anscheinend hat "+(TP->QueryPronoun(1))+" Heimweh gepackt."));

  return 1;
}

int cmd_plaettchen(string str)
{
 object plaettchen;
 
 notify_fail("Was willst Du heraus kratzen?\n");
  if(!str) return 0;
  if(!(str == "plaettchen heraus"||
       str == "rosa plaettchen heraus"||
       str == "plaettchen aus fuge heraus"||
       str == "rosa plaettchen aus fuge heraus")) return 0;

 {
  if(anzahl<1)
  {
   write(BS("Da ist ja kein Plaettchen mehr, also lass das kratzen. Du "
	 "brichst Dir nur Deine Fingernaegel ab.\n"));
   say(TPN+" hantiert beim Trinkbrunnen herum.\n");
     return -1;
  }
 if(present("\nplaettchen",TP))
  {
   write(BS("Du kratzt herum und brichst Dir Deinen Fingernagel ab. Du wirst "
	 "aergerlich und denkst Dir, dass Du es bleiben laesst, weil Du eh "
	 "schon eines hast.\n"));
   say(BS(TPN+" arbeitet am Trinkbrunnen herum und flucht vor sich hin.\n"));
      return -1;
  }
 else
  {
   {
 plaettchen=clone_object(BASARIOBJ "plaettchen");
   if (ME_TOO_HEAVY == plaettchen->move(TP,M_GET|M_SILENT))
    {
     write(BS("Das Plaettchen faellt zu Boden.\n"));
 
     plaettchen->remove();
       return 1;
    }
   else
    {
     write(BS("Du kratzt das Plaettchen herunter und steckst es sofort "
	   "heimlich ein.\n"));
     say(TPN+" betastet den Trinkbrunnen.\n");
       anzahl--;
       return 1;
    }
   }
  }
    return 0;
 }
   return 0;
}

int cmd_werfen(string str)
{
 notify_fail("Was willst Du wo hinein werfen?\n");

  if(!str) return 0;
  if(!(str == "plaettchen in brunnen"||
       str == "plaettchen in trinkbrunnen"||
       str == "plaettchen in brunnen hinein"||
       str == "plaettchen in trinkbrunnen hinein"||
       str == "mosaikplaettchen in brunnen"||
       str == "mosaikplaettchen in trinkbrunnen"||
       str == "mosaikplaettchen in brunnen hinein"||
       str == "mosaikplaettchen in trinkbrunnen hinein")) return 0;
 
 
 if(present("\nplaettchen",TP))
 {
  write(BS("Du wirfst laessig das rosa Plaettchen in den Brunnen. Ploetzlich "
	"verfaerbt sich das Wasser rosa und faengt zu blubbern an ... Eine "
	"Schleiertaenzerin steigt aus dem Wasser empor und tanzt einen exotischen "
	"Tanz ..."));
  say(BS(TPN+" wirft ein rosa Plaettchen in den Trinkbrunnen und starrt wie "
      "gebannt auf ihn.\n"));

  TP->SetProp(P_PARALYZED, 200);
  
  call_out("fall1",15);
   
  present("\nplaettchen",TP)->remove(1);
  return 1;
 }

 write(BS("Du kannst nur etwas Spezielles in den Brunnen werfen, das Du aber "
       "nicht hast."));

 return 1;
}

void fall1()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Sie schwingt ihre Hueften, die mit Schleier ueberdeckt sind. "
	 "Selbst ihr Gesicht ist von einem durchsichtigen Schleier verhuellt ... "
	 "Dich durchfaehrt ein Prickeln ... Sie ist so sinnlich und tanzt mit "
	 "galanten Schritten auf dem Wasser ..."));

   call_out("fall2",20);
}
void fall2()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Sanft und sinnlich steigt sie in das Wasser ... Ihr Blick haftet "
	 "noch einmal auf Dir und schon verschwindet auch der Kopf in den "
	 "Wellen ... Das Wasser klaert sich ... Du blinzelst kurz, reibst Dir "
	 "die Augen und fragst Dich ob es ein Traum war ..."));

   say(BS(TPN+" blinzelt mit den Augen und reibt sich diese anschliessend."));

   TP->SetProp(P_PARALYZED, 0);
}
