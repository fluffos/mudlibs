#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Mit einem grossen Schritt trittst du in eine gewaltige Halle. In einem Haus "
    "oestlich von dir herrscht reger Betrieb. In der Mitte dieser Halle findest "
    "du ein grosses Loch, das wie ein Brunnen von einem gemauerten Rand umgeben "
    "ist. Die Decke ist ueber und ueber mit glitzernden Kristallen ueberzogen. "
    "Im Sueden erkennst du ein grosses, edelsteinverziertes Tor. Im Westen "
    "fuehrt eine steinerene Treppe durch einen Saeulengang zu einem Portal.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );
	

  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT );
  
//--Exits------------------------------------------------------------------
  
  AddExit( "norden", STADTROOM "1e3_stadt" );
  AddExit( "westen", STADTROOM "1d4_tempel" );
  AddExit( "osten", STADTROOM "1f4_kneipe" );
}
