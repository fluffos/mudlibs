#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

int ueberfall;

string darkelf_voices();

void create()
{
  ::create();

  ueberfall = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier bist du an eine Kreuzung gelangt. Die Gleise fuehren nach Westen "
    "und Suedosten. Allerdings zweigt ein kleiner Gang nach Nordosten ab. "
    "Du glaubst aus diesem Gang leise Stimmen zu hoeren, bist Dir aber nicht "
    "sicher. Irgendwo in der Ferne hoerst Du auch ein Rumpeln und metallenes "
    "Kreischen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "kreuzung" }),
    "Hier laufen drei Gaenge zusammen. Einer im Westen, einer im Suedosten "
    "und einer im Nordosten." );

  AddDetail( ({ "gleise" }),
    "Die Gleise, die von den Wuestenzwergen hier verlegt wurden, laufen hier "
    "von Westen nach Suedosten - oder umgekehrt." );

  AddDetail( ({ "gang" }),
    "Welchen genau meinst Du? Den Westgang, Nordostgang oder den Suedostgang?" );

  AddDetail( ({ "stimmen" }),
    "Du siehst hier keine Stimmen." );

  AddDetail( ({ "ferne" }),
    "Die Ferne ist wirklich weit weg. Und sehen kann man sie auch nicht wirklich." );

  AddDetail( ({ "rumpeln" }),
    "Irgendwo im Osten hoerst Du ein Rumpeln." );

  AddDetail( ({ "kreischen" }),
    "Das metallene Kreischen kommt scheinbar aus dem Westen." );
  
  AddDetail( ({ "westgang" }),
    "Die Gleise verlaufen in den Westgang. In diese Richtung liegt auch der Basar." );

  AddDetail( ({ "suedostgang" }),
    "Die Gleise verlaufen in diese Richtung. In dieser Richtung liegt die Stadt." );

  AddDetail( ({ "nordostgang" }),
    "Der Gang im Nordosten ist etwas kleiner, als dieser hier, durch der Wagen "
    "der Wuestenzwerge faehrt. Du glaubst aus dieser Richtung Stimmen zu hoeren." );

  AddDetail( ({ "basar" }),
    "Der Basar ist der Ort, an dem die Wuestenzwerge Handel treiben und ihre "
    "Hauptverbindung in die Aussenwelt." );

  AddDetail( ({ "stadt" }),
    "Diese Gaenge fuehren zwischen der Stadt der Wuestenzwerge und dem Basar hin und "
    "her." );

  AddDetail( ({ "wagen" }),
    "Auf den Gleisen hier rast ab und zu ein Wagen der Wuestenzwerge vorbei." );

  AddDetail( ({ "richtung", "richtungen" }),
    "Es gibt viele Richtungen." );

  AddSound( ({ "stimmen" }),
    #'darkelf_voices );

  AddSound( ({ "kreischen" }),
    "Ein leises metallisches Kreischen kommt irgendwo aus dem Westen. Vermutlich ist "
    "es der Wagen, der diese Geraeusche verursacht." );

  AddSound( ({ "rumpeln" }),
    "Irgendwo im Osten rumpelt es ab und zu." );

  AddDetail( ({ "aussenwelt" }),
    "Die Wuestenzwerge haben nur wenig Kontakt mit der Aussenwelt." );

  AddDetail( ({ "handel" }),
    "Am Basar wird mit vielen Dingen Handel getrieben." );

  AddDetail( ({ "hauptverbindung", "verbindung" }),
    "Diese Gaenge sind die Hauptverbindung zur Aussenwelt." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", GLEISEROOM "f2_gleise" );
  AddExit( "nordosten", GLEISEROOM "i2_darkelves");
  AddExit( "suedosten", GLEISEROOM "i4_gleise");
}

string darkelf_voices()
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    return BS("Du hoerst dunkelelfische Wortfetzen: \"Ueberfall... Angriff... Zwerge...\"");
  else if(TP->QueryProp(P_RACE) == "Elf")
    return BS("Du verstehst die Stimmen zwar nicht, aber erkennst die Zuege der dunkelelfischen Sprache.");

  return BS("Du hoerst zwar Stimmen, verstehst aber kein Wort davon.");
}

void Ueberfall()
{
  int i,x;
  object ob;

  if(ueberfall) return;
  tell_room(TO, BS("Ein paar Dunkelelfen treten aus den Schatten! Ein Hinterhalt!"));
  
  x = 1+random(3);
  for(i=x; i>0; --i)
  {
    ob = clone_object(GLEISENPC "delf_krieger");
    ob->SetProp(P_AGGRESSIVE, 1);
    ob->move(TO, M_GO|M_NOCHECK);
    ob->AddId("\nwz_ueberfall_npc");
  }

  call_out("kavallerie", 4+random(4), x);

  ueberfall=1;
  return;
}

void kavallerie(int n)
{
  int i;
  object ob;

  tell_room(TO, BS("Durch den Kampflaerm aufmerksam geworden stuermen Zwergenkrieger herein!"));
  
  for(i=n; i>0; --i)
  {
    ob = clone_object(GLEISENPC "streckenwache");
    ob->move(TO, M_GO|M_NOCHECK);
    ob->AddId("\nwz_ueberfall_npc");
  }

  call_out("clean_up_hinterhalt", 600, i);
  return;
}

int check_hinterhalt(object ob)
{
  if(ob->id("\nwz_ueberfall_npc") && living(ob)) return 1;
  return 0;
}

void clean_up_hinterhalt()
{
  object *inv;
  int i;

  inv = filter_array(all_inventory(TO), "check_hinterhalt");

  for(i=0; i<sizeof(inv); ++i)
  {
    tell_room(TO, BS(inv[i]->Name(WER)+" verschwindet in einem Gang."));
    inv[i]->deep_remove(1);
  }
  ueberfall=0;
  return;
}

int QueryUeberfall()
{
  return ueberfall;
}
