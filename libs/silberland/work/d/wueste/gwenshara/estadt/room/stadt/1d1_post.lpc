#include "../def.h"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

inherit STD "std_stadt";
inherit "/std/post";

void create()
{
  post::create();
  SetDefaultDetails();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier im Postamt von Quaul. Hier kannst Du Deine Post "
    "lesen und Briefe versenden. Drei Postkabinen dienen dazu, dass Du Deine "
    "Post ungestoert lesen kannst. An einer Wand haengt ein Regal, in dem "
    "die Briefe von Quaul sortiert werden.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "postamt" }),
    "Du befindest dich hier im Postamt von Quaul." );

  AddDetail( ({ "post" }),
    "Wenn Du Briefe hast, kannst Du sie hier lesen und schreiben." );

  AddDetail( ({ "briefe" }),
    "Wenn Du Briefe bekommen hast oder welche schreiben moechtest kannst Du "
    "das hier tun. Die Briefe der Stadt werden in einem Regal sortiert." );

  AddDetail( ({ "postkabinen", "kabinen" }),
    "In diesen kleinen Kabinen kannst Du in aller Ruhe Deine Post erledigen." );

  AddDetail( ({ "wand" }),
    "An einer Wand haengt ein Regal, in dem die ganzen Briefe an die Stadt "
    "sortiert werden." );

  AddDetail( ({ "regal" }),
    "Das Regal hat viele Faecher in denen die Briefe sortiert werden. Im Momen"
    "t ist es leer." );

  AddDetail( ({ "ruhe" }),
    "Wenn Du etwas Ruhe haben willst, dann geh in eine der Postkabinen." );

  AddDetail( ({ "faecher" }),
    "Die Faecher sind alphabetisch sortiert und alle leer, bis auf eines." );

  AddDetail( ({ "moment" }),
    "Jetzt gerade." );

  AddDetail( ({ "fach" }),
    "In dem Fach liegt ein Brief." );

  AddDetail( ({ "brief" }),
    "Auf dem Brief steht die Adresse des Empfaengers und ein grosser, roter "
    "Stempel prangt darauf." );

  AddDetail( ({ "adresse" }),
    "Du kannst sie lesen." );

  AddDetail( ({ "empfaengers", "empfaenger" }),
    "Die Adresse des Empfaengers steht am Brief." );

  AddDetail( ({ "stempel" }),
    "NICHT ZUSTELLBAR" );

  AddReadDetail( ({ "brief" }),
    "Du willst das Postgeheimnis doch lieber wahren und laesst es." );

  AddReadDetail( ({ "adresse" }),
    "An: Bingo, Derlim" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", STADTROOM "1d2_stadt" );

//--Items-----------------------------------------------------------------

  AddItem("/std/postschalter");
  AddItem( STADTNPC "postmeister", REFRESH_DESTRUCT );
  
  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );
  SetProp(P_TPORT_COST_IN, 1);
  SetProp(P_TPORT_COST_OUT, 1);
}
