#include "../def.h"

inherit STD "std_stadt";

private int brunnen_an;

public string brunnen_long() {
  string str;
  str = "Auf diesem Teil des Platzes befindet sich ein kleiner Brunnen ";
  if(brunnen_an) {
    str += ", in dem Wasser plaetschert.";
  } else {
    str += ".";
  }

  return str;
}

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Hier hast du den Ostteil eines Platzes in der unterirdischen Stadt "
	"Quaul erreicht. Im Norden und Osten geht es durch kleinere Tueren "
	"in etwas kleinere Gebaeude. Nach Sueden hin fuehrt ein breiter Gang "
	"weiter. @@brunnen_long@@");

//--Details----------------------------------------------------------------

  AddDetail( ({ "ostteil", "teil" }),
    "Du stehst hier auf einem Platz ein Quaul. Er erstreckt sich noch weiter "
	"nach Westen." );
	
  AddDetail( ({ "platzes", "platz" }),
    "Auf diesem Platz befindet sich lediglich ein kleiner Brunnen, sowie "
	"Gaenge zu zwei kleineren Gebaeuden im Norden und Osten." );
	
  AddDetail( ({ "tueren", "holztueren", "tuer" }),
    "Du siehst zwei menschenhohe Holztueren. Eine ist braun, die andere in einem "
	"sanften Grau gehalten. Ueber beiden Tueren wurden Steinschilder angebracht." );
	
  AddDetail( ({ "gebaeude" }),
    "Im Norden und Osten schliessen sich vermutlich kleinere Gebaeude an." );
	
  AddDetail( ({ "gang" }),
    "Ein breiter Gang fuehrt weiter nach Sueden. Es duerfte sich dabei um so etwas, "
	"wie einen Hauptgang handeln, der womoeglich zu weiteren Geschaeften fuehrt." );
	
  AddDetail( ({ "brunnen" }),
    "Dieser kleine Brunnen wurde von einem wahren Meister gemacht. Er besteht aus "
	"purem Aquamarin und ist leicht durchscheinend, so dass es aussieht, als wuerde "
	"er aus Wasser bestehen." );
	
  AddSpecialDetail( ({ "wasser" }),
    "detail_wasser" );
	
  AddDetail( ({ "aquamarin" }),
    "Der Brunnen wurde aus blaeulichem Aquamarin geschnitten und ist leicht "
	"durchscheinend." );
	
  AddDetail( ({ "meister" }),
    "Dieser Zwerg muss ein wahrer Meister seiner Zunft sein!" );
	
  AddDetail( ({ "geschaefte", "geschaeften" }),
    "In dieser Ebene der Stadt befinden sich einige nuetzliche Geschaefte." );
	
  AddDetail( ({ "hauptgang", "nebengang" }),
    "Ein Hauptgang ist breiter und hoeher als ein Nebengang." );
	
  AddDetail( ({ "grau", "granitgrau" }),
    "Fast, wie Granit." );
	
  AddDetail( ({ "schilder", "steinschilder", "schild" }),
    "In das Schild ueber der noerdlichen Tuer wurde ein Nadel mit einem "
	"Garn gemeisselt, und in das im Osten ein Schriftzug." );

  AddDetail( ({ "blau", "aquamarinblau" }),
    "Es handelt sich hier rein zufaellig um Aquamarinblau." );

  AddDetail( ({ "stroemung" }),
    "Du beobachtest die Stroemung und stellst fest, dass sie von einem "
	"kleinen Loch in der Brunnenwand ausgeht." );
	
  AddDetail( ({ "zunft" }),
    "Die Zunft der Edelsteinschneider." );
	
  AddDetail( ({ "zwerg" }),
    "Er muss ein Meister sein!" );
	
  AddDetail( ({ "ebene" }),
    "Du befindest Dich hier in einer Ebene von Quaul." );
	
  AddDetail( ({ "granit" }),
    "Richtiges Granitgrau!" );
	
  AddDetail( ({ "garn", "nadel" }),
    "Worauf das wohl hindeuten soll?" );
	
  AddDetail( ({ "schriftzug" }),
    "HAENDLER FUER ALLERLEI" );

  AddDetail( ({ "brunnenwand" }),
    "In der Brunnenwand befindet sich ein kleines Loch, durch das offenbar "
	"Wasser stroemt." );
	
  AddDetail( ({ "loch" }),
    "Hm. Du kannst nichts genaues erkennen. Vielleicht willst Du den Finger "
	"reinstecken?" );
	
  AddDetail( ({ "edelsteinschneider" }),
    "Die Edelsteinschneider sind hier sehr angesehen." );
	
  AddDetail( ({ "allerlei", "alles" }),
    "Alles eben." );
	
  AddDetail( ({ "finger" }),
    "Ob das wirklich so eine gute Idee ist?" );
	
  AddDetail( ({ "idee", "einfaelle", "einfall" }),
    "Du hattest sicher schon schlechtere Einfaelle." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", STADTROOM "1d2_stadt" );
  AddExit( "osten",  STADTROOM "1f2_haendler"  );
  AddExit( "sueden", STADTROOM "1e3_stadt" );
  AddExit( "norden", STADTROOM "1e1_schneider"   );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT);
  
//--Commands--------------------------------------------------------------
  
  AddCmd( ({"stecke", "steck"}), "cmd_stecken" );
  AddCmd( ({"druecke", "drueck"}), "cmd_druecken" );

  brunnen_an = 1;
}

int cmd_stecken(string str)
{
  notify_fail("Was willst Du wohin stecken?\n");
  if(!str || str == "") return 0;
  if(!(str == "finger in loch" ||
       str == "finger in kleines loch")) return 0;
	   
  write(BS("Du steckst Deinen Finger in das kleine Loch an der "
        "Brunnenwand und tastest ein wenig darin herum. Es fuehlt "
		"sich an, als waere darin ein Schalter verborgen."));
  return 1;
}

int cmd_druecken(string str)
{
  notify_fail("Was willst Du wo druecken?\n");
  if(!str || str == "") return 0;
  if(!(str == "schalter in loch" ||
       str == "schalter in brunnen" ||
	   str == "schalter in kleinem loch")) return 0;
	   
  write(BS("Du drueckst den Knopf."));
  say(BS(TPN+" steckt "+TP->QueryPossPronoun()+"e Hand in den Brunnen."));

  call_out("switch_brunnen_state", 2);
  return 1;
}

public void switch_brunnen_state() {
  if(brunnen_an) {
    tell_room(TO, BS("Mit einem lauten Gluckern entleert sich der Brunnen ploetzlich. Ups?!"));
  } else {
    tell_room(TO, BS("Ein lautes Plaetschern ertoent und der Brunnen fuellt sich randhoch mit Wasser."));
  }

  brunnen_an = !brunnen_an;
}

public string detail_wasser() {
  if(brunnen_an) {
    return BS("Das Wasser im Brunnen ist, so wie er selbst, von durchscheinendem Blau. Du "
	  "erkennst eine leichte Stroemung darin und frags Dich, wo sie wohl herkommen "
	  "mag.");
  } else {
    return BS("Komsich. Gar kein Wasser im Brunnen. Allerdings erkennst du ein kleines "
           "Loch in der Brunnenwand.");
  }
}