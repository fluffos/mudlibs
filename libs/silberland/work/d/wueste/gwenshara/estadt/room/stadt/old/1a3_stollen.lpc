#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Der Gang hier gleicht schon eher einem Stollen. Er ist zwar noch gut "
    "ausgebaut, aber schon sehr niedrig. Die Waende werden von Stuetzbalken "
    "gehalten. Der Boden ist von Staub, Erde und kleinen Felsbroeckchen "
    "bedeckt. Irgendwie sieht dieser Gang noch nicht ganz fertig aus.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "stollen" }),
    "Dieser Gang sieht eher aus wie ein unfertiger Stollen." );

  AddDetail( ({ "waende" }),
    "Die Waende sind zwar mit Steinplatten ausgekleidet, werden aber noch "
    "von Stuetzbalken gehalten." );

  AddDetail( ({ "balken", "stuetzbalken" }),
    "Hoelzerne Stuetzbalken tragen die Decke dieses Gangs." );

  AddDetail( ({ "boden" }),
    "Der Boden hier ist von Staub, Erde und kleinen Felsbroeckchen bedeckt. "
    "Sieht so aus, als waeren das Ueberreste vom Bau des Gangs." );

  AddDetail( ({ "staub", "schicht", "staubschicht" }),
    "Eine dicke Staubschicht bedeckt den Gang." );

  AddDetail( ({ "erde", "haufen", "erdhaufen" }),
    "Einige kleine Erdhaufen liegen in dem Gang. Sie sind vielleicht von der "
    "Decke gerieselt." );

  AddDetail( ({ "felsbrocken", "felsbroeckchen", "broeckchen" }),
    "Etliche kleine Felsbrocken bedecken den Boden. Hier wird wohl noch "
    "gebaut." );

  AddDetail( ({ "decke" }),
    "Die Decke ist hier niedrig und besteht aus rohem Fels." );

  AddDetail( ({ "ueberreste", "ueberrest" }),
    "Dieser Gang ist wohl ein Ueberrest vom Bau der Stadt." );  

  AddDetail( ({ "bau", "teil" }),
    "Dieser Teil der Stadt ist wohl noch nicht fertig gebaut." );
  
//--Ausgaenge--------------------------------------------------------------

  //AddExit( "westen", ([EX_DEST: ANSCHLUSS_STADT_STOLLEN,
  //		       EX_TESTFUNC: "stollen_frei"]));
  AddExit( "osten",  STADTROOM "2b3_aufzug"   );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "arbeiter", REFRESH_DESTRUCT );
}

void init()
{
  ::init();
  //call_out("setup_stollenmaster", 0);
  return;
}

int stollen_frei(string cmd)
{
  if(STOLLENMASTER->_query_finished() == 1)
    return 1;

  tell_object(TP, BS("Der Stollen im Westen ist eingestuerzt!"));
  return 0;
}

string stollentext()
{
   if(STOLLENMASTER->_query_finished() < 1)
      return "Der Stollen im Westen ist eingestuerzt.";
   return ".";
}

void setup_stollenmaster()
{
  if(STOLLENMASTER->_query_finished() != 2)
    return;
  call_other(STOLLENMASTER, "InitializeMaze", 20, 20);
  return;
}
