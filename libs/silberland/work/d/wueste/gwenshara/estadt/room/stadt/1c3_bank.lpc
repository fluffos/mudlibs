#include "../def.h"

inherit "/d/ebene/Midas/room/bank/bank";

public int bankhilfe() {
  hilfe("bank");
  return 1;
}


void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    BS("Du befindest dich hier in einer edlen Halle, die mit Marmor, Gold und "
    "Edelsteinen ausgekleidet ist. An den Seiten siehst du einige Wuestenzwerge "
    "mit Waagen und grossen Buechern zu hantieren. Sie scheinen Edelsteine und "
    "Gold abzuwiegen. Direkt gegenüber von dir siehst du einen Schalter hinter "
    "dessen Goldgitter ein Wuestenzwerg mit Monokel sitzt. An der Decke prangt "
    "in grosen Lettern die Inschrift: 'Gold und Stein - sperr bei uns ein!'")+
    BS("Neben dem Schalter steht ein Schild."));

//--Details----------------------------------------------------------------

  AddDetail( ({ "kreuzung" }),
    "Du stehst hier an einer Art Kreuzung. Im Westen werden die Gaenge "
    "stollenartiger, waehrend sie im Osten normal gepflastert weiterfuehren. "
    "Suedlich von Dir befindet sich ein grosses Tor mit einem Schild "
    "darueber." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", STADTROOM "1c2_platz" );
  
//--Items-----------------------------------------------------------------

  /*AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
  AddItem( STADTNPC "krieger", REFRESH_DESTRUCT);*/

  AddCmd("lies|lese&schild|tafel", "bankhilfe", "Was willst du lesen?\n");
}

public string bankfile() {
  return LOG "bank";
}
