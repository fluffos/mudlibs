#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier auf einer Holzplattform, die von vier Seilen "
    "an der Hoehlendecke gehalten wird. Ein steinerner Steg im Westen fuehrt "
    " hier her. Die Plattform ist rund und in der Mitte befindet sich ein Loch, "
    "durch das der Aufzug nach unten faehrt.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "plattform", "holzplattform" }),
    "Du befindest Dich hier auf einer Holzplattform, von der aus Du den "
    "Aufzug betreten kannst." );

  AddDetail( ({ "seile", "seilen" }),
    "Vier starke Seile halten die Plattform hier. Ohne sie wuerdest Du wohl "
    "abstuerzen." );

  AddDetail( ({ "decke", "hoehlendecke" }),
    "Von der Hoehlendecke haengen vier Seile, die die Plattform festhalten. "
    "Ausserdem erkennst Du einen komplizierten Mechanismus an ihr." );

  AddDetail( ({ "steg" }),
    "Ein Steg aus gelbem Stein hat dich hier her gefuehrt." );

  AddDetail( ({ "mitte" }),
    "In der Mitte der Plattform befindet sich ein kreisrundes Loch, durch "
    "das der Aufzug hindurch fahren kann." );

  AddDetail( ({ "aufzug" }),
    "Der Aufzug der Wuestenzwerge faehrt von dieser Plattform aus in die "
    "tieferen Ebenen." );

  AddDetail( ({ "mechanismus" }),
    "Der Mechanismus an der Hoehlendecke besteht aus mehreren Zahnraedern und "
    "Riemen. Vermutlich ist es durch ihn moeglich den Aufzug rauf und runter "
    "fahren zu lassen." );

  AddDetail( ({ "loch" }),
    "Durch dieses Loch faehrt der Aufzug. Pass auf, dass Du nicht hinein "
    "faellst!" );

  AddDetail( ({ "ebene", "ebenen" }),
    "In den tieferen Ebenen befindet sich die eigentliche Stadt." );

  AddDetail( ({ "zahnraeder", "raeder", "zahnraedern", "scheiben",
	        "metallscheiben" }),
    "Die kleinen Metallscheiben mit ihren Zaehnchen drehen sich, immer dann, "
    "wenn sich der Aufzug bewegt." );

  AddDetail( ({ "riemen", "lederriemen" }),
    "Die Lederriemen haben irgendwas mit dem Mechanismus zu tun, was genau, "
    "weisst Du nicht." );

  AddDetail( ({ "zaehnchen", "geschwindigkeit" }),
    "Die kleinen Zaehnchen drehen sich mit einer atemberaubenden Geschwindig"
    "keit." );

  AddDetail( ({ "boden", "bretter", "holzbretter", "holzbrettern" }),
    "Der Boden besteht aus vielen kleinen Holzbrettern." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", STADTROOM "1d2_steg"  );

//--Items-----------------------------------------------------------------

  AddItem( STADTOBJ "aufzug", REFRESH_NONE, 1);
}
