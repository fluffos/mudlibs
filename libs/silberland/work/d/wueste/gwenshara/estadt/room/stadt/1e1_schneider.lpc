#include "../def.h"
#include "../../master/enhanced_items.h"

inherit STD "std_stadt";

string *cost_cat_list = ({
    "eine_stunde",
    "fuenf_stunden",
    "sieben_stunden",
    "zwoelf_stunden",
    "ein_tag",
    "drei_tage",
    "fuenf_tage",
    "eine_woche",
    "zwei_wochen",
    "ein_monat",
    "zwei_monate"
});

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Das Haus, in der Du Dich hier befindest, ist relativ klein. An den "
	"Waenden und der Decke haengen viele meterlange Stoffbahnen. In einer "
	"Ecke tuermen sich dutzende Stoffballen auf einem Tisch. Mitten im "
	"Raum befindet sich eine kleine Gruppe von Sitzpolstern, die sich um "
	"einen kleines Tischchen scharren. Direkt neben der Eingangstuer befindet "
	"sich ein kleiner Buecherstaender mit einem aufgeschlagenen Buch.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "haus", "raum", "raums" }),
    "Dzu befindest Dich hier in einem kleinen Haus in Quaul." );

  AddDetail( ({ "waende", "waenden" }),
    "An den Waenden und der Decke haengen unzaehlige Meter an Stoff." );

  AddDetail( ({ "decke" }),
    "Du kannst den Stein der Decke gar nicht erkennen, weil so viel "
	"Stoff von ihr herabhaengt." );

  AddDetail( ({ "stoff", "bahnen", "stoffbahnen", "stoffe" }),
    "Viele verschiedene Stoffe haengen von Waenden und Decke. Manche "
	"leuchten in den Farben des Regenbogens, waehrend sich andere "
	"etwas gedeckter geben. Einige der Stoffe sehen sogar richtig teuer "
	"aus." );

  AddDetail( ({ "ecke" }),
    "In einer Ecke dieses Hauses tuermen sich dutzende Stoffballen auf "
	"einem kleinen Tisch, der sich unter der Last biegt." );

  AddDetail( ({ "ballen", "stoffballen" }),
    "Die Stoffballen sind in von verschiedenen Farben und Qualitaeten." );

  AddDetail( ({ "tisch", "holztisch" }),
    "Diser kleine Holztisch biegt sich unter der Last der Stoffe auf ihm." );

  AddDetail( ({ "gruppe" }),
    "Eine kleine Gruppe von vier bequemen Sitzpolstern befindet sich bei dem "
	"kleinen Tischchen in der Mitte des Raums." );

  AddDetail( ({ "polster", "sitzpolster", "sitzpolstern" }),
    "Die Sitzpolster sehen richtig bequem aus, und laden dazu ein sich hinzu"
	"setzen. Sie scheinen mit einer weichen Fuellung gestopft zu sein." );

  AddDetail( ({ "tischchen" }),
    "Auf dem kleinen Tischchen bei den Sitzpolstern steht ein kleiner Tee"
	"kocher." );

  AddDetail( ({ "eingangstuer", "tuer" }),
    "Das ist jene Tuer, durch die Du herein gekommen bist. Neben ihr steht "
	"ein kleiner Buchstaender." );

  AddDetail( ({ "staender", "buchstaender", "buecherstaender" }),
    "Der kleine Buchstaender ist etwa so hoch, dass ein Zwerg bequem davon "
	"lesen kann. Auf ihm liegt ein aufgeschlagenes Buch." );

  AddDetail( ({ "buch" }),
    "Das Buch ist in Leder gebunden. Es scheint die verschiedenen Preise "
	"des Schneiders aufzulisten. Mit genug Intelligenz kann man es sicher "
	"lesen!" );

  AddDetail( ({ "intelligenz" }),
    "Vermutlich bist Du intelligent genug. Versuch es doch einfach." );

  AddDetail( ({ "leder" }),
    "Es handelt sich wohl um Ziegenleder." );

  AddDetail( ({ "preise" }),
    "Die findest Du in dem Buch." );

  AddDetail( ({ "schneider", "schneider" }),
    "Offensichtlich handelt es sich hier um das Haus eines Schneiders." );

  AddDetail( ({ "last" }),
    "Diese Stoffballen duerften einiges wiegen." );

  AddDetail( ({ "zwerg" }),
    "Dies ist die Stadt der Wuestenzwerge." );

  AddDetail( ({ "fuellung" }),
    "Sie laedt dazu ein sich richtig hineinfallen zu lassen." );

  AddDetail( ({ "farben" }),
    "Du erkennst alle nur erdenklichen Farben des Regenbogens." );

  AddDetail( ({ "regenbogen", "regenbogens" }),
    "So ein Regenbogen hat sehr viele Farben." );

  AddDetail( ({ "qualitaeten" }),
    "Von billigen bis zu teuren, robusten Stoffen findest Du hier alles." );

  AddDetail( ({ "teekocher", "kocher" }),
    "Er ist noch heiss. Es duerfte sich noch Tee darin befinden." );

  AddDetail( ({ "meter" }),
    "Es sind sicher hunderte Meter, die sich hier ueber den ganzen Raum "
	"verteilen." );

  AddDetail( ({ "ziegenleder" }),
    "Das kommt von Ziegen." );

  AddDetail( ({ "tee" }),
    "Er duftet kraeftig." );

  AddDetail( ({ "mitte" }),
    "In der Mitte des Hauses befinden sich ein paar Sitzpolster." );

  AddDetail( ({ "ziege" }),
    "Das Leder muss von der Bergziege des Huegellands stammen." );

  AddDetail( ({ "bergziege" }),
    "Sie lebt im Huegelland - obwohl es dort nur Huegel und keine Berge gibt."
  );

  AddDetail( ({ "huegelland" }),
    "Dort lebt die Bergziege." );

  AddDetail( ({ "huegel" }),
    "Das Huegelland besteht grossteils aus Huegeln." );

  AddDetail( ({ "berge" }),
    "Schon merkwuerdig. Eigentlich muesste es ja eine Huegelziege sein." );

  AddDetail( ({ "huegelziege" }),
    "Also ist es Huegelziegenleder!" );

  AddDetail( ({ "huegelziegenleder" }),
    "Genau darin ist das Buch gebunden." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", STADTROOM "1e2_stadt" );

//--Items-----------------------------------------------------------------

  //AddItem( STADTNPC "schneider", REFRESH_DESTRUCT );

//--Commands--------------------------------------------------------------
  AddCmd( ({ "lies" }), "cmd_buch" );
  AddCmd( CMD_GEBEN, "cmd_bestellung_aufgeben");
}


// neue bestellung
int cmd_bestellung_aufgeben(string str)
{
  notify_fail("Was willst du aufgeben?\n");
  if(!str || str == "") return 0;
  if(str != "bestellung auf") return 0;

  tell_object(TP, BS("Du nimmst ein Bestellformular zur hand und beginnst "
                      "es auszufuellen. Du kannst diesen Vorgang jederzeit mit "
					  "'abbruch' beenden!"));
  tell_object(TP, BS("Welcher Gegenstand soll bestickt werden?"));
  input_to("bestellung1");
  return 1;
}

void bestellung3(string fliste, object item, int nr)
{
  string *faeden, text;
  int i, cost, total_cost, c;



  // bei abbruch sind wir weg :)
  if(fliste == "abbruch") return;

  // wenn das item nicht mehr existiert -> ende im gelaende
  if(!objectp(item))
  {
    tell_object(TP, BS("Hoppla! Der angegebene Gegenstand ist verschwunden!"));
	return;
  }

  faeden = explode(fliste, ", ");

  // pruefen, ob diese faeden auch existieren
  if(sizeof(faeden) != nr)
  {
    tell_object(TP, BS("Du hast zu viele oder zu wenige Faeden angegeben! Versuch "
                        "es gleich nochmal! [Durch , getrennt oder 'abbruch']"));
	input_to("bestellung3", 0, item, nr);
    return;
  }

  for(i=0; i<sizeof(cost_cat_list); i++) {
      tell_object(TP, sprintf("%d. %-30s ", i+1, regreplace(cost_cat_list[i], "_", " ", 1)));
      if(i % 2 == 0) {
          tell_object(TP, "\n");
      }
  }
  tell_object(TP, BS(sprintf("Wie lange soll der Zauber bestehen? [1 .. %d]",
                             sizeof(cost_cat_list))));
  input_to("bestellung4", 0, item, nr, faeden);
}

void bestellung2(string faeden, object item)
{
  int nr;

  // bei abbruch sind wir weg :)
  if(faeden == "abbruch") return;

  // wenn das item nicht mehr existiert -> ende im gelaende
  if(!objectp(item))
  {
    tell_object(TP, BS("Hoppla! Der angegebene Gegenstand ist verschwunden!"));
	return;
  }

  nr = to_int(faeden);
  if(nr < 1 || nr > 5)
  {
    tell_object(TP, BS("Bitte gib eine Zahl zwischen 1 und 5 an!"));
	tell_object(TP, BS("Wieviele Faeden sollen verwendet werden? [1-5]"));
    input_to("bestellung2", 0, item);
	return;
  }

  tell_object(TP, BS("Welcher Faden solle verwendet werden?"));
  input_to("bestellung3", 0, item, nr);
}

void bestellung1(string item)
{
  object ob;

  // bei abbruch sind wir weg :)
  if(item == "abbruch") return;

  // Der Gegenstand muss natuerlich im Inventar sein...
  if(!objectp(ob=present(item, TP))){
    tell_object(TP, BS("So einen Gegenstand hast Du gar nicht..."));
	return;
  }

  // Wenn es keine Ruestung ist, gehts auch nicht
  if(!stringp(ob->QueryProp(P_ARMOUR_TYPE)))
  {
    tell_object(TP, BS("Du kannst hier nur Ruestungen besticken lassen!"));
	return;
  }

  // ... und nur Dinge, die man auch weggeben kann
  if(ob->QueryProp(P_NODROP) || (ob->QueryProp(P_CURSED) && ob->QueryWorn()))
  {
    tell_object(TP, BS("Du kannst "+ob->name(WEN, 1)+" nicht weggeben!"));
	return;
  }

  bestellung2("1", ob); // nur 1 faden supported
}

void bestellung4(string input, object item, int nr, string *faeden) {
    int i, c, dc, total_cost;
    mapping cache;
    string *pnames, pn, text;

    // bei abbruch sind wir weg :)
    if(input == "abbruch") return;

    pnames = ({});

    i = to_int(input);
    if(i < 1 || i > sizeof(cost_cat_list)) {
        tell_object(TP, BS("Diese Dauer gibt es nicht!"));
        return;
    }

    input = cost_cat_list[i-1];

    total_cost = 0;
    for(i=0; i<sizeof(faeden); ++i)
    {
      if(call_other(ENHMASTER, "GetCostOfEffect", faeden[i]) == -1) {
  	       tell_object(TP,
               BS("Ein Faden mit der Bezeichnung '"+faeden[i]+"' "
                  "existiert nicht! Informiere Dich besser nochmals."));
           return;
  	  }

      if(call_other(ENHMASTER, "IsValidCategory", input) == 0) {
          tell_object(TP, BS(
              sprintf("Die Dauer '%s' gibt es nicht. Informiere Dich nochmals!",
                      input)));
          return;
      }

      pn = ENHMASTER->PrepareEffectApplication(faeden[i], input);
      if(pn == "") {
          tell_object(TP, BS(
              sprintf("Die Kombination aus '%s' und '%s' existiert nicht. Bitte "
                      "wende Dich an einen Magier!", faeden[i], input)));
      }

      cache = ENHMASTER->GetCache();
  	  total_cost += to_int(cache[pn]);
      pnames += ({ pn });
    }

    // Nochmal bestaetigen bitte!
    text  = sprintf("+%'-'|76s%s", "Deine Bestellung", "+\n");
    text += sprintf("| Gegenstand: %' '-63s|%s", item->QueryProp(P_SHORT), "\n");
    text += sprintf("| Faden: %' '-68s|%s", implode(faeden, ","), "\n");
    text += sprintf("| Kosten (XP): %' '-62d|%s", total_cost, "\n");
    text += sprintf("+%'-'|76s%s", "", "+\n");
    text += sprintf("Willst Du Diese Bestellung abgeben? [ja|nein] ");
    tell_object(TP, text);
    input_to("bestellung5", 0, item, nr, pnames);
}


void bestellung5(string input, object item, int nr, string *pnames)
{
    if(input == "nein" || input == "n")
    {
        tell_object(TP, "Du zerknuellst das Formular und wirfst es weg.\n");
        Message(TP->Name(WER) + " zerknuellt einen Zettel und wirft ihn weg.",
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return;
    }
    else if(input != "j" && input != "ja")
    {
        tell_object(TP, "Ungueltige Eingabe.\nWillst Du diese Bestellung abgeben? [ja|nein] ");
        input_to("bestellung5", 0, item, nr, pnames);
        return;
    }

    call_out("enhance_item", 0, TP, item, nr, pnames);
}

void enhance_item(object pl, object item, int len, string *pnames, string duration) {
    int i, cr;

    for(i=0; i<len; i++) {
        cr = ENHMASTER->CheckPlayerItem(pl, item, pnames[i]);
        if(cr != 0) {
            tell_object(pl, BS("Der Schneider kann den Gegenstand nicht besticken:"));
            tell_object(pl, BS(ENHMASTER->CheckResultToString(cr)));
            return;
        }
    }
    tell_object(pl, BS(sprintf("Der Schneider nimmt %s an sich und beginnt mit seiner Arbeit.", item->name(WEN, 1))));
    for(i=0; i<len; i++) {
        cr = ENHMASTER->ApplyEffect(pl, item, pnames[i]);
        if(cr != APPLY_OK) {
            tell_object(pl, BS(sprintf("Ohje! Da ging etwas schief. Fehlernummer: %d", cr)));
            return;
        }
    }
    tell_object(pl, BS(sprintf("Einen kurzen Moment spaeter erhaeltst du %s zurueck.", item->name(WEN, 1))));
}

int cmd_buch(string str)
{
  string text, *keys, kapitel;
  mapping effects;
  int i, cost;
  mapping duration_factor;

  kapitel = "";

  if(!str || str == "")return 0;
  if(str == "buch")
  {
    kapitel = "Inhaltsverzeichnis";
    text =  "Das Buch hat mehrere Kapitel, die du lesen kannst:\n";
	text += "  1. Einleitung\n";
	text += "  2. Faeden\n";
	text += "  3. Kosten fuer Stunden\n";
	text += "  4. Kosten fuer Tage\n";
	text += "  5. Kosten fuer Wochen\n";
	text += "  6. Kosten fuer Monate\n";
	text += "  7. Bestellungen\n";
	text += "Du kannst jedes dieser Kapitel lesen.\n";
  }

  else if(str == "einleitung" || str == "kapitel 1")
  {
    kapitel = "Kapitel 1: Einleitung";
    text = BS("Der Meister der Schneider kann Gegenstaende, die zu einem "
	          "gewissen Anteil aus Stoff bestehen mit einem Muster besticken. "
 			  "Jedes Muster kann aus maximal  fuenf Faeden bestehen. Die "
			  "Wirkung eines Musters ist, je nach verwendeten Faeden, "
			  "unterschiedlich.")+"\n";
	text += BS("Jedes Muster benoetigt Seelenkraft um aufrecht erhalten zu "
	            "werden. Aus diesm Grund benoetigt der Meister je nach "
				"Wirkungsdauer des Musters eine unterschiedlich große Anzahl "
				"Deiner Erfahrungspunkte um das Muster zu aktivieren.")+"\n";
    text += BS("Ein Muster kann fuer eine Wirkungsdauer von mehreren Stunden, "
			   "Tagen oder Monaten aktiviert werden. Nach Ablauf der Dauer "
			   "verliert sich die mystische Wirkung des eingestickten Musters "
			   "sofort.")+"\n";
	text += BS("Mehr ueber die verschiedenen Faeden erfaehrst Du in Kapitel 2 "
	            "'Faeden'. Fuer eine Auflistung der Kosten, gestaffelt nach den "
				"Kategorien findest Du in den Kapiteln 3 bis 6.");
  }

  else if(str == "faeden" || str == "kapitel 2")
  {
    kapitel = "Kapitel 2: Faeden";
	text = BS("Je nachdem welche Faeden fuer ein Muster verwendet werden, "
	           "variieren dessen Effekte.");
	text += BS("* Rote Faeden sind besonders Feuerfest.");
	text += BS("* Weisse Faeden bleiben auch in der Kaelte geschmeidig.");
	text += BS("* Ein blauer Faden wirkt wasserabweisend.");
	text += BS("* Mit einem gelben Faden wird das Muster winddicht.");
	text += BS("* Blitzende Faeden leiten Blitze besonders gut ab.");
	text += BS("* Ein stinkender Faden hat seinen Geruch von Explosionstests.");
	text += BS("* Vibrierende Faeden vermindern die Lautstaerke anderer Geraeusche.");
	text += BS("* Mit hellen Faeden gewoehnst Du Dich besser an Licht.");
	text += BS("* Weissblaue Faeden haben nichtleidende Eigenschaften.");
	text += BS("* Die Saeure eines aetzenden Fadens schuetzt das Muster vor anderen Saeuren.");
	text += BS("* Ein gruener Faden neutralisiert Gifte.");
	text += BS("* Mit einem scharzem Faden im Muster wird der Traeger weniger furchtsam.");
	text += BS("* Strahlende Faeden haben eine gewisse Heiligkeit an sich.");
	text += BS("* Daemonenanbeter bevorzugen eher duestere Faeden.");
	text += BS("* Ein unsichtbarer Faden schaerft Deinen Verstand gegen Gedankenangriffe.");
	text += BS("* Magische Faeden erzeugen eine Art magischer Schutzhuelle.");
	text += BS("* Staehlerne Faeden verhaerten das Muster, so dass es besser schuetzt.");
	text += BS("* Harte Faeden machen das Muster widerstandsfaehiger.");
	text += BS("* Ein plusierender Faden verstaerkt Deine Blutzirkulation.");
	text += BS("* Deririsierende Faden verstaerkt die magische Aura.");
	text += BS("* Starke Faeden verbessern die Leistung deiner Muskeln.");
	text += BS("* Weise Faeden wirken positiv auf das Gehirn.");
	text += BS("* Atmende Faenden erhoehen Deine Lungenkapazitaet und Ausdauer.");
	text += BS("* Ein verschlungener Faden verbessert die Hand-Auge-Koordination.");
	text += BS("* Kraftvolle Faeden sprudeln ueber vor Lebensenergie.");
	text += BS("* Astrale Faeden erweitern Deine astrale Aura.");

  }

  else if(str == "kosten fuer stunden" || str == "kapitel 3")
  {
    kapitel = "Kapitel 3: Kostentabelle - Stunden";
	text = BS("Dieses Kapitel listet die Kosten der einzelnen Faeden fuer eine "
	           "Wirkungsdauer im Stundenbereich.");
    text += BS(sprintf(" %' '2s. %' '|13s%' '|12s%' '|12s%' '|12s%' '|12s\n",
					        "Nr",  "Faden",  "1 h", "5 h", "7 h", "12 h"));
    text += sprintf("+%'-'65s+\n", "");

    effects         = call_other(ENHMASTER, "GetEffects");
    keys            = m_indices(effects);
	duration_factor = call_other(ENHMASTER, "GetDurationCategories");

    for(i=0; i<sizeof(keys); ++i)
    {
       cost = call_other(ENHMASTER, "GetCostOfEffect", keys[i]);
       text += sprintf("%' '2i. %' '-13s%' '|12i%' '|12i%' '|12i%' '|12i\n",
	                    i, keys[i],
						(int) (cost*duration_factor["eine_stunde"]),
						(int) (cost*duration_factor["fuenf_stunden"]),
						(int) (cost*duration_factor["sieben_stunden"]),
						(int) (cost*duration_factor["zwoelf_stunden"]));
    }
  }

  else if(str == "kosten fuer tage" || str == "kapitel 4")
  {
    kapitel = "Kapitel 4: Kostentabelle - Tage";
	text = BS("Dieses Kapitel listet die Kosten der einzelnen Faeden fuer eine "
	           "Wirkungsdauer im Tagesbereich.");
    text += BS(sprintf(" %' '2s. %' '|13s%' '|12s%' '|12s%' '|12s\n",
					        "Nr",  "Faden",  "1 Tag", "3 Tage", "5 Tage"));
    text += sprintf("+%'-'65s+\n", "");

    effects         = call_other(ENHMASTER, "GetEffects");
    keys            = m_indices(effects);
	duration_factor = call_other(ENHMASTER, "GetDurationCategories");

    for(i=0; i<sizeof(keys); ++i)
    {
       cost = call_other(ENHMASTER, "GetCostOfEffect", keys[i]);
       text += sprintf("%' '2i. %' '-13s%' '|12i%' '|12i%' '|12i\n",
	                    i, keys[i],
						(int) (cost*duration_factor["ein_tag"]),
						(int) (cost*duration_factor["drei_tage"]),
						(int) (cost*duration_factor["fuenf_tage"]));
    }
  }

  else if(str == "kosten fuer wochen" || str == "kapitel 5")
  {
    kapitel = "Kapitel 5: Kostentabelle - Wochen";
	text = BS("Dieses Kapitel listet die Kosten der einzelnen Faeden fuer eine "
	           "Wirkungsdauer im Woichenbereich.");
    text += BS(sprintf(" %' '2s. %' '|13s%' '|12s%' '|12s\n",
					        "Nr",  "Faden",  "1 Woche", "2 Wochen"));
    text += sprintf("+%'-'65s+\n", "");

    effects         = call_other(ENHMASTER, "GetEffects");
    keys            = m_indices(effects);
	duration_factor = call_other(ENHMASTER, "GetDurationCategories");

    for(i=0; i<sizeof(keys); ++i)
    {
       cost = call_other(ENHMASTER, "GetCostOfEffect", keys[i]);
       text += sprintf("%' '2i. %' '-13s%' '|12i%' '|12i\n",
	                    i, keys[i],
						(int) (cost*duration_factor["eine_woche"]),
						(int) (cost*duration_factor["zwei_wochen"]));
    }
  }

  else if(str == "kosten fuer monate" || str == "kapitel 6")
  {
    kapitel = "Kapitel 6: Kostentabelle - Monate";
	text = BS("Dieses Kapitel listet die Kosten der einzelnen Faeden fuer eine "
	           "Wirkungsdauer im Monatebereich.");
    text += BS(sprintf(" %' '2s. %' '|13s%' '|12s%' '|12s\n",
					        "Nr",  "Faden",  "1 Monat", "2 Monate"));
    text += sprintf("+%'-'65s+\n", "");

    effects         = call_other(ENHMASTER, "GetEffects");
    keys            = m_indices(effects);
	duration_factor = call_other(ENHMASTER, "GetDurationCategories");

    for(i=0; i<sizeof(keys); ++i)
    {
       cost = call_other(ENHMASTER, "GetCostOfEffect", keys[i]);
       text += sprintf("%' '2i. %' '-13s%' '|12i%' '|12i\n",
	                    i, keys[i],
						(int) (cost*duration_factor["ein_monat"]),
						(int) (cost*duration_factor["zwei_monate"]));
    }
  }

  else if(str == "bestellungen" || str == "kapitel 7")
  {
    kapitel = "Kapitel 7: Bestellungen";
	text = BS("Der Schneider nimmt gerne Bestellungen zum Besticken "
	          "Deiner Ausruestung an. Mit dem Befehl <gib bestellung "
			  "auf> kannst Du eine neue Bestellung aufgeben. Mit "
			  "<zeige bestellungen> siehst Du alle Auftraege, die Du "
			  "in Arbeit gegeben hast und mit <storniere bestellung> "
			  "kannst Du einen Deiner Auftraege abbrechen.")+"\n";
	text += BS("Der Meister arbeitet so schnell er kann an den Auftraegen. "
	           "Allerdings kann er immer nur an einem Muster gleichzeitig "
			   "arbeiten. Pro Faden benoetigt er ungefaehr eine Stunde.")+"\n";
	text += BS("Damit der Meisterschneider einen Ausruestungsgegenstand "
	            "besticken kann, musst Du diesen natuerlich abgeben. Sobald "
				"Deine Bestellung abgeschlossen ist, kannst Du ihn hier mit "
				"dem Befehl <hole bestellung ab> wieder an dich nehmen.");
  }

  else
    return 0;

  TP->More(sprintf("+%'-'|76s%s", kapitel, "+\n")+text+sprintf("+%'-'78s", "+\n"));
  return 1;
}

