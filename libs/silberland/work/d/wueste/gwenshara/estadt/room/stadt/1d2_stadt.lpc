#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier auf dem Westteil eines Platzes in Quaul. Suedlich von Dir befindet sich ein "
    "grosses Gebaeude, dass mit einem schweren Fallgitter gesichert ist. Im "
    "Norden befindet sich eine offene Tuer in der Felswand. Ueber ihr ist "
    "ein Schild in den Fels gemeisselt. Oestlich erstreckt sich der Platz "
    "weiter.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "westteil" }),
    "Du befindest Dich hier am Westteil eines Platzes in Quaul. Hier befinden "
    "sich die ersten grossen Geschaefte." );

  AddDetail( ({ "platz", "platzes" }),
    "Du befindest Dich hier auf einem grossen Platz in Quaul. Alle wichtigen "
    "Geschaefte zweigen davon ab." );
  AddDetail( ({ "gebaeude" }),
    "Suedlich von Dir befindet sich ein groesseres Gebaeude. Seine Tuer ist mi"
    "t einem schweren Fallgitter gesichert. Es duerfte sich um ein wichtiges "
    "Gebaeude handeln. Neben der Tuer erkennst Du eine kleine, goldene Tafel"
    "." );

  AddDetail( ({ "gitter", "fallgitter" }),
    "Das Gebaeude suedlich von Dir ist mit einem Fallgitter gesichert. Zur "
    "Zeit ist das Gitter hochgezogen, kann aber im Ernstfall jederzeit runter "
    "fallen." );

  AddDetail( ({ "tuer" }),
    "Die Tuer im Norden wurde aus einer Felswand gestemmt. Ueber ihr ist ein "
    "Schild in den Fels gemeisselt." );

  AddDetail( ({ "schild" }),
    "Das Schild wurde ueber der Tuer eingemeisselt. Du kannst es lesen." );

  AddDetail( ({ "geschaefte" }),
    "Viele wichtige Geschaefte befinden sich hier auf diesem Platz." );

  AddDetail( ({ "tafel" }),
    "Die kleine Tafel wurde aus Gold gegossen. Eine feine Schrift wurde darin "
    "eingraviert. Vermutlich kann man sie lesen." );

  AddDetail( ({ "ernstfall" }),
    "Bei einem Ueberfall vielleicht." );

  AddDetail( ({ "felswand" }),
    "Noerdlich von Dir befindet sich eine Tuer in der Felswand." );

  AddDetail( ({ "schrift" }),
    "Man kann sie besser lesen." );

  AddReadDetail( ({ "schild" }),
    "POSTAMT" );

  AddReadDetail( ({ "tafel", "schrift" }),
    "KOENIGLICHER SCHATZMEISTER" );

  AddDetail( ({ "ueberfall" }),
    "Wenn man das Gebaeude ueberfallen kann, dann sind darin sicher Wertgegen"
    "staende." );

  AddDetail( ({ "gold" }),
    "Die Tafel wurde aus Gold gemacht." );

  AddDetail( ({ "zeit" }),
    "Deine Zeit verstreicht langsam." );

  AddDetail( ({ "wertgegenstaende", "gegenstaende", "silber", "edelsteine" }),
    "Dinge, die einen Wert haben eben." );

  AddDetail( ({ "dinge", "wertgegenstand" }),
    "Gold und Silber oder Edelsteine." );

  AddDetail( ({ "wert" }),
    "Ja, Wert macht einen Wertgegenstand aus." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", STADTROOM "1c2_platz" );
  AddExit( "osten",  STADTROOM "1e2_stadt"  );
  AddExit( "sueden", STADTROOM "1d3_tresor" );
  AddExit( "norden", STADTROOM "1d1_post"   );

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
}
