#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

int onyxdragon, aquadragon;

void create()
{
  ::create();
  onyxdragon = 1;
  aquadragon = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Gleise laufen hier ueber eine Bruecke in einer riesigen Hoehle. "
    "Unter der Bruecke breitet sich ein kleiner unterirdischer See aus. "
    "Riesige Stalaktiten haengen von der Hoehlendecke. Ein blaeuliches "
    "Gluehen aus dem See huellt die Szene in eine mystische Atmosphaere.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "gleise" }),
    "Die Gleise des wuestenzwergischen Wagens laufen hier ueber eine "
    "steinerne Bruecke von Westen nach Osten." );

  AddDetail( ({ "bruecke" }),
    "Du stehst hier mitten auf einer Bruecke, die sich ueber einen "
    "kleinen unterirdischen See spannt. Sie besteht aus einem gelben "
    "Fels, der hier unten weit verbreitet scheint." );

  AddDetail( ({ "hoehle" }),
    "Diese Hoehle ist so gross, dass die Decke am hoechsten Punkt im "
    "Dunkel verschwindet. Du siehst nicht wie weit sich nach Norden und "
    "Sueden erstreckt, nur der See ist klar erkennbar." );

  AddDetail( ({ "see" }),
    "Unter der Bruecke breitet sich ein kleiner unterirdischer See, wie "
    "eine riesige Lacke aus. Seine Oberflaeche wird ab und zu von kleinen "
    "Wellen gekraeuselt. Irgendwo von seinem Grund geht ein blaeuliches "
    "Leuchten aus, das die gesamte Hoehle erhellt." );

  AddDetail( ({ "stalaktiten" }),
    "Riesenhafte Stalaktiten haengen von der Hoehlendecke und beruehren "
    "an manchen Stellen fast den See. Ab und zu siehst Du einen Tropfen "
    "von ihnen auf die Oberflaeche des Sees platschen." );

  AddDetail( ({ "decke", "hoehlendecke" }),
    "Die Hoehlendecke spannt sich ueber Dich, wie der Himmel. Ihr hoechster "
    "Punkt ist nicht erkennbar und zahlreiche Stalaktiten haengen von ihr "
    "in die Tiefe." );

  AddDetail( ({ "gluehen" }),
    "Irgendwo vom Grund des Sees aus geht ein blaeuliches Gluehen aus, dass "
    "die gesamte Hoehle in eine mystische Atmosphaere taucht." );

  AddDetail( ({ "szene" }),
    "Die ganze Szene hier hat etwas mystisches." );

  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere hier ist mystisch, beinahe schon heilig. Als waerst Du "
    "hier in dem Heiligtum eines alten Gottes." );

  AddDetail( ({ "wagen" }),
    "Ab und zu rast hier ein Wagen vorbei." );

  AddDetail( ({ "punkt" }),
    "Der hoechste Punkt der Hoehle liegt genau ueber Dir. Er ist in solche "
    "Finsternis gehuellt, dass Du nichts erkennen kannst." );

  AddDetail( ({ "dunkel" }),
    "Das Dunkel am hoechsten Punkt ist eine undurchdringliche Finsternis." );

  AddDetail( ({ "lacke", "wasserlacke" }),
    "Wie eine riesige Wasserlacke breitet sich der unterirdische See unter "
    "der Bruecke aus." );

  AddDetail( ({ "wellen" }),
    "In dem Rythmus der fallenen Tropfen wellt sich die Oberflaeche des Sees." );

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Sees waere spiegelnd glatt, wenn sie nicht ab und zu "
    "von Wellen gekraeuselt wurde." );

  AddDetail( ({ "grund" }),
    "Irgendwas am Grund des Sees strahlt ein blaeuliches Gluehen aus." );

  AddDetail( ({ "leuchten", "licht" }),
    "Das blaeuliche Licht, das vom See ausgeht erfuellt die gesamte Hoehle." );

  AddDetail( ({ "stellen" }),
    "Einige Stalaktiten haengen so tief, dass sie an manchen Stellen fast den "
    "See beruehren. An einer Stelle faellt Dir etwas auf." );

  AddDetail( ({ "tropfen" }),
    "Die Tropfen fallen von den Stalaktiten auf den See und verursachen dabei "
    "lustige Geraeusche." );

  AddDetail( ({ "himmel" }),
    "Nein. Hier nicht. Du bist in einer Hoehle." );

  AddDetail( ({ "tiefe" }),
    "Unter Dir befindet sich der See. Eigentlich ist das nicht wirklich tief." );

  AddDetail( ({ "heiligtum" }),
    "Ob das hier wirklich das Heiligtum von irgendwem ist?" );

  AddDetail( ({ "gott", "gottes" }),
    "Du kennst keinen Gott, der in nassen Hoehlen verehrt wird." );

  AddDetail( ({ "finsternis" }),
    "Die Finsternis dort oben ist undurchdringlich. Moment! Du glaubst etwas "
    "Rotes aufgluehen zu sehen." );

  AddDetail( ({ "rythmus" }),
    "*plitsch* *plitsch* *platsch* *plitsch* *platsch* *platsch*" );

  AddDetail( ({ "stelle" }),
    "An einer Stelle ragt ein schuppiger Stein aus dem Wasser." );

  AddDetail( ({ "rotes" }),
    "Du siehst es nicht mehr. Aber es war sicher da!" );

  AddDetail( ({ "stein" }),
    "Schwups! Der Stein verschwindet im Wasser. Irgendwie sah es aber mehr "
    "aus wie eine Schwanzspitze." );

  AddDetail( ({ "spitze", "schwanzspitze" }),
    "Hm... ob man das Wesen irgendwie hervorlocken koennte?" );

  AddDetail( ({ "wesen" }),
    "Was koennte das nur sein?" );

  AddDetail( ({ "wasser" }),
    "Das Wasser des Sees scheint ganz klar zu sein." );

  AddDetail( ({ "geraeusche" }),
    "Die sieht man nicht." );

  AddSound( ({ "geraeusche" }),
    "*platsch*" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", GLEISEROOM "d2_gleise" );
  AddExit( "osten", GLEISEROOM "f2_gleise");

//--Aktionen--------------------------------------------------------------

  AddCmd( ({"locke", "lock"}), "cmd_locken");
}

int cmd_locken(string str)
{
  notify_fail("Was willst Du locken?\n");
  if(!str || str=="") return 0;
  if(!(str == "wesen" ||
       str == "etwas" ||
       str == "wesen hervor" ||
       str == "etwas hervor")) return 0;

  write(BS("Du versuchst alles moegliche, aber das Wesen traut sich nicht "
	"hervor. So wird das nichts."));
  return 1;
}

void clone_onyxdragon()
{
  object ob;
  tell_room(TO, BS("Ploetzlich faellt ein grosser basaltfarbener Drache "
	    "aus der Dunkelheit an der Decke. Seine roten Augen gluehen Dich an."));
  ob = clone_object(GLEISENPC "onyxdragon");
  ob->move(TO, M_GO|M_SILENT|M_NOCHECK);
  return;
}

void CallOnyxDragon()
{
  if(!onyxdragon)
  {
    tell_room(TO, BS("Die Stalaktiten beben und Gestein faellt von der Decke, "
	      "doch sonst geschieht nichts."));
    return;
  }

  tell_room(TO, BS("Die Stalaktiten beben und Gestein faellt von der Decke. "
	    "Ein echsischer Schrei erfuellt den Raum."));
  onyxdragon = 0;
  call_out("clone_onyxdragon", 1+random(5));
  return;
}

void clone_aquadragon()
{
  object ob;
  tell_room(TO, BS("Aus dem See fliegt ein blauer Aquamarindrache empor und "
	    "landet mit einem Bruellen auf der Bruecke!"));
  ob = clone_object(GLEISENPC "aquadragon");
  ob->move(TO, M_GO|M_SILENT|M_NOCHECK);
  return;
}

void CallAquamarinDragon()
{
  if(!aquadragon) return;
  tell_room(TO, BS("Der See beginnt zu brodeln!!!"));
  aquadragon = 0;
  call_out("clone_aquadragon", 2+random(8));
}

void reset()
{
  ::reset();
  onyxdragon = 1;
  aquadragon = 1;
}

