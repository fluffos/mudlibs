#include "../def.h"
#include <pub.h>

inherit "/std/pub";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Quauls Koenigsbraeu");
  SetProp(P_INT_LONG,
    "Dieses Haus ist das beruehmte 'Koenigsbraeu' in Quaul. Etliche lange "
    "Holztische wurden hier aufgestellt, an denen sich Zwerge tummeln. Hinter "
    "einer langen Ausschank am hinteren Ende des Raumes sind viele grosse "
    "Bierfaesser gestapelt. Grosse Feuerschalen erhellen den Raum und "
    "ein Bild des Koenigs ist im edelsteinverzierten Rahmen ueber der "
    "Schank aufgehaengt.");

  SetProp(P_PUBKEEPER_ID, "\nwzwirt");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_NAME, "Ahbed");
  SetProp(P_PUBKEEPER_GENDER, MALE);

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );
	

  AddItem( STADTNPC "trinker", REFRESH_DESTRUCT );
  AddItem( STADTNPC "wirt", REFRESH_DESTRUCT );
  
//--Exits------------------------------------------------------------------
  
  AddExit( "westen", STADTROOM "1e4_koenigsplatz" );

  AddDrink("Koenigsbraeu", ({"koenigsbraeu", "braeu"}), 150, 30, 8, 10, 
           ({"Du trinkst das hauseigene Koenigsbraeu mit der guten Schaumkrone. Mmmmmh!",
             "&& trinkt das hauseigene Koenigsbraeu mit der guten Schaumkrone. Mmmmh!"}));
  AddDrink("Kleines Bierchen", ({"bierchen", "kleines", "bier"}), 50, 8, 4, 5, 
           ({"Der Wirt schenkt dir ein kleines Bierchen ein. Haette ruhig mehr sein koennen...",
             "Der Wirt schenkt && ein kleines Bierchen ein."}));
  AddDrink("Felonia Dunkel", ({"felonia dunkel", "dunkelbier", "dunkel"}), 400, 35, 25, 10, 
           ({"Du bekommst ein Glas schweres Schwarzbier aus den Tiefen Felonias serviert. Faehrt ein wie nur was!",
             "&& stuerzt ein Glas schweres Schwarzbier aus den Tiefen Felonias hiab."}));
  AddDrink("Koenigsbraeu", ({"koenigsbraeu", "braeu"}), 250, 20, 8, 10, 
           ({"Du trinkst das hauseigene Koenigsbraeu mit der guten Schaumkrone. Mmmmmh!",
             "&& trinkt das hauseigene Koenigsbraeu mit der guten Schaumkrone. Mmmmh!"}));
  AddDrink("Mepsi Cola", ({"cola", "mepsi", "mepsi cola"}), 25, 10, 0, 5, 
           ({"Ahmed schenkt dir aus einer Flasche Mepsi Cola mit der Aufschrift 'Original' ein.\n"
             "Du denkst . o O ( Das in Midas schmeckt besser... )\n",
             "Amend schenkt && Aus einer Flashe Mepsi Cola mit der Aufschrift 'Original' ein.\n"
             "&& denkt . o O ( Das in Midas schmeckt besser )\n"}));
}
