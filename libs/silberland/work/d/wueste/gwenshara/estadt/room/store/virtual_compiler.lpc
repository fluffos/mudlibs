#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../../master/store.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH,  ROOM "store/");
  SetProp(P_STD_OBJECT, ROOM "store/store");
  SetProp(P_VALID_NAME, ({"store"}));
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
  {
    //SetProp(P_STD_OBJECT, ROOM+name);
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d",foo,who)!=2)
    return 0;
  return 1;
}



