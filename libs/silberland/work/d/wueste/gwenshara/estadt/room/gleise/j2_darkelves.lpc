#include "../def.h"

inherit STD "std_gleise";

int kiste_geschlossen;
int kiste_gefuellt;
int schluessel;

string kiste()
{
  string text;
  text = "Die Kiste ist ";
  if(kiste_geschlossen)
  {
    text+="geschlossen. Ein Schloss haengt daran.";
    return BS(text);
  }
  else
    text+="geoffnet. ";

  if(kiste_gefuellt)
  {
    text+="In ihr findest Du ein paar Muenzen und eine Schriftrolle.";
  }
  else
    text+="Leider ist sie leer.";

  return BS(text);
}

string schloss()
{
  if(kiste_geschlossen)
    return BS("An der Kiste haengt ein kleines Schloss. Mit dem richtigen "
	      "Schluessel kann man es sicher oeffnen.");
  else return BS("Sowas siehst Du hier nicht!");
}

string kisteinv()
{
  if(kiste_geschlossen)
    return BS("Sowas siehst Du hier nicht!");
  if(!kiste_gefuellt)
    return BS("Die Kiste ist leer.");
  return BS("Du kannst die Kiste einfach ausraeumen.");
}

void create()
{
  ::create();
  kiste_geschlossen = 1;
  kiste_gefuellt    = 1;
  schluessel        = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier in einer kleinen Hoehle, die allem Anschein nach "
    "mit purer Magie aus dem Stein gerissen wurde. Sie hat die Form einer "
    "Halbkugel und besteht aus vollkommen glattem Stein. Ein paar Strohmatrazen "
    "dienen als Schlaflager und an der hinteren Wand steht eine kleine "
    "Obsidiankiste.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle" }),
    "Diese Hoehle ist halbkugelfoermig und aus komplett glattem, dunklem "
    "Fels." );

  AddDetail( ({ "anschein" }),
    "Es hat den Anschein, als waere diese Hoehle mit Magie geformt worden." );

  AddDetail( ({ "magie" }),
    "Ob hier dunkelelfische Magie am Werk war?" );

  AddDetail( ({ "stein" }),
    "Der Stein dieser Hoehle ist dunkel und scheint vollkommen glatt zu sein." );

  AddDetail( ({ "form" }),
    "Diese Hoehle ist eine perfekte Halbkugel." );

  AddDetail( ({ "halbkugel" }),
    "Wie eine Kugel, nur in der Mitte durchgeschnitten." );

  AddDetail( ({ "matrazen", "strohmatrazen" }),
    "Ein paar Strohmatrazen liegen ueber den Boden verteilt. Sie dienen offenbar "
    "als Schlaflager." );

  AddDetail( ({ "lager", "schlaflager" }),
    "Einige Matrazen am Boden dienen als spaerliches Schlaflager. Wer hier wohl lebt?" );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier sind vollkommen glatt. Ein einer Wand steht eine kleine "
    "Obsidiankiste." );

  AddDetail( ({ "kiste", "obsidiankiste" }),
    #'kiste );

  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir und ebenfalls komplett glatt." );

  AddDetail( ({ "werk" }),
    "Hier war sicher ein maechtiger Magier am Werk um diese Hoehle zu schaffen." );

  AddDetail( ({ "mitte" }),
    "Schneidet man eine Kugel in der Mitte durch entstehen zwei Halbkugeln." );

  AddDetail( ({ "boden" }),
    "Der Boden hier ist ebenfalls fast spiegelglatt." );

  AddDetail( ({ "schloss" }),
    #'schloss );

  AddDetail( ({ "muenzen", "schriftrolle" }),
    #'kisteinv );

  AddDetail( ({ "kugel" }),
    "Zwei Halbkugeln zusammen bilden eine Kugel." );

  AddDetail( ({ "magier" }),
    "Diese Hoehle hat vermutlich ein dunkelelfischer Magier geschaffen!" );

  AddDetail( ({ "schluessel" }),
    "Hier findest Du auf den ersten Blick keinen Schluessel. Vielleicht solltest "
    "Du die Schlaflager durchsuchen?" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", GLEISEROOM "i2_darkelves" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "oeffne" }), "cmd_oeffnen" );
  AddCmd( ({ "durchsuche", "durchsuch" }), "cmd_durchsuchen" );
  AddCmd( ({ "raeume", "raeum" }), "cmd_raeumen" );

//--Items-----------------------------------------------------------------

  AddItem( GLEISENPC "zarxyr", REFRESH_DESTRUCT );
  AddItem( GLEISENPC "delf_krieger", REFRESH_DESTRUCT );
  AddItem( GLEISENPC "delf_schleicher", REFRESH_DESTRUCT );
}

int cmd_raeumen(string str)
{
  object rolle;
  int m;
  notify_fail("Was willst Du ausraeumen?\n");
  if(!str || str == "") return 0;
  if(!(str == "kiste aus" ||
       str == "obsidiankiste aus")) return 0;

  notify_fail("Die Kiste ist doch leer!\n");
  if(!kiste_gefuellt) return 0;

  notify_fail("Die Kiste ist doch geschlossen!\n");
  if(kiste_geschlossen) return 0;

  m = 50+random(100);
  tell_room(TO, BS(TPN+" raeumt die Kiste leer."), ({TP}));
  tell_object(TP, BS("Du nimmst "+m+" Muenzen und eine Schriftrolle an Dich."));
  rolle = clone_object( GLEISEOBJ "rolle" );
  if(rolle->move(TP, M_GET) != 1)
  {
    tell_room(TO, BS(TPN+" laesst eine Schriftrolle fallen."), ({TP}));
    tell_object(TP, BS("Du laesst die Schriftrolle fallen."));
    rolle->move(TO, M_PUT|M_NOCHECK);
  }
  TP->AddMoney(m);

  kiste_gefuellt=0;
  return 1;
}

void reset()
{
  ::reset();
  schluessel = 1;
  kiste_geschlossen = 1;
  kiste_gefuellt = 1;
  tell_room(TO, BS("Die Kiste klappt zu."));
}

int cmd_durchsuchen(string str)
{
  object key;
  notify_fail("Was willst Du durchsuchen?\n");
  if(!str || str=="") return 0;
  if(!(str == "matrazen" ||
       str == "schlaflager" ||
       str == "lager")) return 0;

  tell_room(TO, BS(TPN+" durchwuehlt die Schlaflager."), ({TP}));
  if(!schluessel)
  {
    tell_object(TP, BS("Du durchwuehlst die Schlaflager, kannst aber nichts finden."));
    return 1;
  }

  key = clone_object(GLEISEOBJ "schluessel");
  tell_object(TP, BS("Du durchwuehlst die Schlaflager und findest einen Schluessel."));
  if(key->move(TP, M_GET) != 1)
  {
    tell_object(TP, BS("Du laesst den Schluessel fallen."));
    tell_room(TO, BS(TPN+" laesst einen Schluessel fallen."));
    key->move(TO, M_PUT|M_NOCHECK);
  }

  schluessel = 0;
  return 1;
}

int cmd_oeffnen(string str)
{
  object key;
  notify_fail("Was willst Du oeffnen?\n");
  if(!str || str == "") return 0;
  if(!(str == "kiste" ||
       str == "obsidiankiste" ||
       str == "kiste mit schluessel" ||
       str == "obsidiankiste mit schluessel")) return 0;

  notify_fail("Ohne Schluessel geht das nicht!\n");
  key = present("\nwz_darkelfkey", TP);
  if(!objectp(key)) return 0;

  notify_fail("Die Kiste ist doch offen!\n");
  if(!kiste_geschlossen) return 0;

  kiste_geschlossen = 0;
  tell_object(TP, BS("Du oeffnest die Kiste. Der Schluessel bricht dabei ab."));
  tell_room(TP, BS(TPN+" oeffnet die Kiste."));
  key->remove(1);
  return 1;
}
