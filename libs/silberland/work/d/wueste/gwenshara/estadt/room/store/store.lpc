/*
**
** Lagerraum
**
*/


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../master/store.h"
#include <moving.h>
#include <player.h>

void create()
{
   if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein Spind");
  SetProp(P_INT_LONG, "Hier koennen Dinge gelagert werden.");
  
  previous_object()->CustomizeObject();
}

int clean_up(int ref)
{
  return 0;
}
