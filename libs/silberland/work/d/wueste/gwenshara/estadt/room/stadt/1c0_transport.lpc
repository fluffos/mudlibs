#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier auf einer geraeumigen Felsplattform. Nach Sueden hin fuehrt "
    "eine breite Steinbruecke zu einem grossen Felsvorsprung. Im Norden siehst "
    "du viele verschiedene Oeffnungen in die Felswand. Mehrere Rampen und "
    "ausgetretene Wege, sowie Schienenstraenge fuehren in die unterschiedlichen "
    "Tunneloeffnungen. Rechterhand befindet sich ein kleiner Holzverschlag mit "
    "ein paar Tischen davor. Immer wieder rollen Minenwagen heran, oder "
    "einzelne Staffettenlaeufer draengen sich an dir vorbei. Uebreall tummeln "
    "sich Zwerge, die hier entweder ueber die Bruecke in die Stadt stroemen, "
    "oder von dort kommen.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );

  
//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", STADTROOM "1c1_hub");

//--Items-----------------------------------------------------------------
 //  AddItem( STADTNPC "kranarbeiter", REFRESH_DESTRUCT);


  AddCmd("betrete|betret&oeffnung|tunnel|tunneloeffnung", "cmd_betreten", "Was willst du betreten?");

  AddRoomMessage(({
    BS("Ein Staffettenlaeufer kommt aus einer der Tunneloeffnungen und laeuft gleich weiter in die Stadt.\n"),
    "Ein schwerbeladener Wagen rollt auf den Schienen an dir vorbei.\n",
    "Zwei von Zwergen gefuehrte Wagen krachen aneinander, da sie das selbe Gleis nutzen.\n",
    "Mit raschen Schritten draengt sich ein Botenlaeufer an dir vorbei.\n",
    "Ein Trupp bewaffneter Zwerge laeuft im Stechschritt in einen der Tunnel.\n",
    "Neben dir wird eine mit Edelsteinen befuellte Lore vorbeigeschoben.\n",
    "Du glaubst Kampflaerm aus einem der Tunnel zu hoeren - oder doch nicht?\n",
    "Eine Gruppe abgekaempfter und verwunderter Krieger kommt aus den Tunneln.\n",
    "Jemand ruft: Beiseite! Wichtige Botschaft fuer den Koenig!\n",
    "Du wirst unsanft angerempelt.\n",
    "Ein Zwergenarbeiter quetscht sich an dir vorbei und murmelt: Steh't nur im Weg 'rum!\n",
    "Eine Wuestenzwergin fragt: Wann faehrt der naechste Wagen nach Felonia?\n",
    "Ein fetter zwergischer Haendler meint panisch: Ist der letzte Zug schon angefahren?!\n",
    "Eine Gruppe von Gebirgszwergen wandert groehlend an dir vorbei. Sind wohl Touristen...\n",
    "Eine Zwergin aus Ardhmir fragt: Darf man hier Socken in den Sandalen tragen?\n",
    "Ein Wagenzug, mit mehreren Faessern beladen, rattert aus einem der Tunnel herbei.\n",
    "Einige kleine Kisten werden abgeladen und mit einem Handkarren in die Stadt gefuehrt.\n",
    BS("Irgendwo laeutet eine Glocke - und dann zischt ploetzlich ein Stollenwagen voller Krieger an dir vorbei.\n"),
  }), 20);
}

public int cmd_betreten() {
  write(BS("Gerade als du in einen der Tunnel gehen willst, haelt dich ein Staffettenlaeufer und sagt: "));
  write(BS("  \"Ohne zu weissen wohin du willst, wirst du dich in den Tunneln nur verlaufen!\""));
  write(BS("Du ueberlegst es dir dann doch anders."));
  return 1;
}
