#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Ueber eine steinerne Bruecke im Suedwesten betrittst du hier den Vorplatz der "
    "Zitadelle der Wuestenzwerge. Vor dir erhebt sich das gewaltige Tor "
    "Baschrad al Zhul, welches dir mit seinen edelsteinverzierten Fluegeln "
    "den Zutritt verwehrt. Neben dem Tor erkennst du etliche Schiesscharten "
    "in den Waenden. Davor ueben sich einige, offenbar juengere, Zwerge "
    "in der Kunst des Krieges.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );

  
//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", STADTROOM "1c1_hub");

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "rambosch", REFRESH_DESTRUCT );
}
