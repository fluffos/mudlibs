#include "../def.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "std/room";

void Loch_Sequ(int ab, object wer);
void Lockern_Sequ(int ab, object wer);
void Zwaengen_Sequ(int ab, object wer);
int Catch(object pl);

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Mada Basari");
  SetProp(P_INT_LONG, 0);

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

//--Details----------------------------------------------------------------
//--Kommandos--------------------------------------------------------------
//--Ausgaenge--------------------------------------------------------------
//--Items & NPCs-----------------------------------------------------------
}

//--Fun fier die Squenzen--------------------------------------------------
void Sequenz(int welche, object wer)
{
  switch(welche)
  {
    case 0: Loch_Sequ(1, wer);
             break;
    case 1: Zwaengen_Sequ(1, wer);
             break;
    case 2: Lockern_Sequ(1, wer);
             break;
    default: tell_object(wer,"Es liegt ein Fehler vor, bitte wende Dich an "
                           "einen Magier.\n");
              return;
              break;
  }
  wer->SetProp(P_PARALYZED, ([PARALYZE_TIME:200,
                              PARALYZE_MSG: "Du bist zu beschaefigt.\n",
			      PARALYZE_MSG_OTHER: "",
			      PARALYZE_END: "",
			      PARALYZE_END_OTHER: ""]));

}

void Loch_Sequ(int ab, object wer)
{
  if(!present(wer, TO)) return;
  if(!find_player(lower_case(wer->name()))) return;
  switch(ab)
  {
    case 1: tell_object(wer,BS("Langsam kriechst Du durch den Tunnel."));
            call_out("Loch_Sequ", 5, 2, wer);
	    break;
    case 2: tell_object(wer,BS("Immer weiter schiebst Du Dich vorran durch die "
                         "Dunkelheit..."));
            call_out("Loch_Sequ", 5, 3, wer);
	    break;
    case 3: tell_object(wer,BS("  ...und weiter..."));
            call_out("Loch_Sequ", 4, 4, wer);
	    break;
    case 4: tell_object(wer,BS("    ...und weiter..."));
            call_out("Loch_Sequ", 4, 5, wer);
	    break;
    case 5: tell_object(wer,BS("      ...und weiter..."));
            call_out("Loch_Sequ", 4, 6, wer);
	    break;
    case 6: tell_object(wer,BS("Nur ein Stueckchen vor Dir erkennst Du einen "
                         "Lichtschimmer!"));
            call_out("Loch_Sequ", 4, 7, wer);
	    break;
    case 7: tell_object(wer,BS("Bald hast Du es geschafft!"));
             call_out("Loch_Sequ", 5, 8, wer);
	     break;
    case 8: tell_object(wer,BS("Du kletterst aus dem Loch.")+"\n");
            call_out("Catch", 0, wer);
            TP->SetProp(P_PARALYZED, 0);
	    //TP->move(...);
	    break;
    default: tell_object(wer,"Hier liegt ein Fehler vor, bitte wende Dich an einen "
			  "Magier.\n");
	     TP->SetProp(P_PARALYZED, 0);
	     break;
  }
}

void Zwaengen_Sequ(int ab, object wer)
{
  if(!present(wer, TO)) return;
  if(!find_player(lower_case(wer->name()))) return;
  switch(ab)
  {
    case 1: tell_object(wer,BS("Vorsichtig zwaengst Du Dich durch die "
			 "Gitterstaebe des Kaefigs."));
	    call_out("Zwaengen_Sequ", 2, 2, wer);
	    break;
    case 2: tell_object(wer,BS("Vorsichtig, um nicht entdeckt zu werden, "
			 "schleichst Du am Richter vorbei."));
	    call_out("Zwaengen_Sequ", 3, 3, wer);
	    break;
    case 3: tell_object(wer,BS("Du wendest Dich nach Sueden zum Kraeuterstand..."));
	    call_out("Zwaengen_Sequ", 3, 4, wer);
	    break;
    case 4: tell_object(wer,BS("... und faellst auf Deine Nase!"));
	    wer->AddHp(-5);
	    call_out("Zwaengen_Sequ", 4, 5, wer);
	    break;
    case 5: tell_object(wer,BS("Gerade als Du Dich wieder aufrichten willst, "
			 "bemerkst Du einen Basarwaechter ganz in der Naehe."));
	    call_out("Zwaengen_Sequ", 5, 6, wer);
	    break;
    case 6: tell_object(wer,BS("Der Basarwaechter uebersieht Dich und geht weiter."));
	    call_out("Zwaengen_Sequ", 3, 7, wer);
	    break;
    case 7: tell_object(wer,BS("Du rappelst Dich auf und schleichst schnell weiter."));
	    call_out("Zwaengen_Sequ", 3, 8, wer);
	    break;
    case 8: tell_object(wer,BS("Beim Kraeuterhaendler wendest Du Dich sofort nach "
		         "Westen und laeufst schnell weiter."));
	    call_out("Zwaengen_Sequ", 4, 9, wer);
	    break;
    case 9: //wer->move(...);
	    TP->SetProp(P_PARALYZED, 0);
	    Catch(wer);
	    break;
    default: tell_object(wer,"Hier liegt ein Fehler vor, bitte wende Dich an einen "
			  "Magier.\n");
	     TP->SetProp(P_PARALYZED, 0);
	     break;	    
  }
}

void Lockern_Sequ(int ab, object wer)
{
  if(!present(wer, TO)) return;
  if(!find_player(lower_case(wer->name()))) return;
  switch(ab)
  {
    case 1: tell_object(wer,BS("Du lockerst zwei Stangen vom Gitter."));
	    call_out("Lockern_Sequ", 3, 2, wer);
	    break;
    case 2: tell_object(wer,BS("Vorsichtig zwaengst Du Dich durch die entstandene "
	                 "Luecke."));
	    call_out("Lockern_Sequ", 4, 3, wer);
	    break;
    case 3: tell_object(wer,BS("Du blickst Dich um und entscheidest Dich dafuer "
			 "Richtung Westen zu fluechten."));
	    call_out("Lockern_Sequ", 3, 4, wer);
	    break;
    case 4: tell_object(wer,BS("Als Du am Waffenstand angekommen bist schleichst Du "
			"hinter ihm vorbei."));
	    call_out("Lockern_Sequ", 4, 5, wer);
	    break;
    case 5: tell_object(wer,BS("Du schleichst vorsichtig nach Sueden zum Teppichhaendler."));
	    call_out("Lockern_Sequ", 3, 6, wer);
	    break;
    case 6: tell_object(wer,BS("Beim Teppichhaendler angekommen machst Du Dich daran den "
			 "Basar schleunigst zu verlassen.\n"));
	    call_out("Lockern_Sequ", 4, 7, wer);
	    break;
    case 7: //wer->move(...);
	    TP->SetProp(P_PARALYZED, 0);
	    Catch(wer);
	    break;
    default: tell_object(wer,"Hier liegt ein Fehler vor, bitte wende Dich an einen "
			  "Magier.\n");
	     TP->SetProp(P_PARALYZED, 0);
	     break;
  }
}

int Catch(object pl)
{  
  int luck;
  luck=SKILLMASTER->UseSkill(pl, SK_LUCK, -(100*pl->QueryAttribute(A_DEX)), 0, 1);
  // Mit Glueck wird man nicht erwischt!
  if(luck>0)
  {
      pl->move("/d/wueste/protheg/kraterrand/room/krater_2_1_0", M_GO|M_SILENT);
    return luck;
  }

  tell_object(pl,BS("Ein Basarwaechter teilt Dir mit: Wohin des Wegs! Du bist doch ein Gefangener!"));
  tell_object(pl,BS("Du wirst von zwei Wachen weggeschleppt un den Kaefig gesperrt."));
  pl->move(BASARIROOM "kaefig", M_TPORT|M_SILENT);
  return 0;

}
