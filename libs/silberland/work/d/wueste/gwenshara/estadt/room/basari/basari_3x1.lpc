inherit "/d/wueste/gwenshara/estadt/room/std_basari_laden";

#include "../def.h"
#include <laden.h>
#include "/d/wueste/gwenshara/estadt/basari.h"

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:40]));

  SetProp(P_INT_SHORT,"Beim Schneider des Mada Basari");

  SetProp(P_SHOPKEEPER_ID, "unakar");
  SetProp(P_SHOPKEEPER_NAME, "Unakar");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SPECIAL_SHOP, ([P_AC:"Unakar sagt: Ich kaufe nur Kleidung!\n"]));

  SetStorageRoom(BASARIROOM "lagerraum_schneider" );

// Details Anfang
   AddDetail( ({"ende"}), 
	      "Hier befindest Du Dich am suedwestlichen Ende des Mada Basari. "
	      "Ueberall tummeln sich die verschiedensten Gestalten und "
	      "suchen nach exotischen Gewuerzen oder anderem Kram.");

  AddDetail( ({"markt","mada","basari","basar"}), 
	     "Verloren stehst Du am Mada Basari, dem gewaltigen Markt der "
	     "Wuestenzwerge. Die zahlreichen, seltsamen Angebote verwirren "
	     "Deine Sinne.");

  AddDetail( ({"wuestenzwerge"}), 
	     "Vor vielen Jahren haben sich die Wuestenzwerge von den Zwergen "
	     "im Gebirge abgespalten und nach neuem Land gesucht, das sie "
	     "besiedeln koennen.");

  AddDetail( ({"leute","menge"}), 
	     "Hier tummeln sich so viele Leute, dass es schwer ist den Ueberblick "
	     "zu bewahren. Diebe haben hier, in der Menge, sicher leichtes Spiel.");

  AddDetail( ({"stand"}), 
	     "Hier befindest Du Dich vor dem Stand des Schneiders Unakar. Er kann "
	     "Dir wunderbare Kleider naehen und sie perfekt anpassen.");

  AddDetail( ({"schneider","schneiders","unakar"}), 
	     "Unakar ist der beste Schneider der Wuestenzwerge und hat somit als "
	     "Einziger von ihnen das Recht seine Waren am Markt zu verkaufen.");

  AddDetail( ({"kleidung","kleider"}), 
	     "Die Kleider, die Unakar naeht, sind wunderschoen und erfreuen sich "
	     "bei vielen Leuten grosser Beliebtheit. Die Stoffe, aus denen sie "
	     "gemacht sind, sind wunderhaft leicht und weich.");

  AddDetail( ({"stoffballen"}), 
	     "Aus den verschiedenfarbigen Stoffballen, die neben dem Stand am "
	     "Boden liegen fertigt Unakar die schoensten und teuersten Kleider im "
	     "Silberland.");

  AddDetail( ({"fadenstuecke"}), 
	     "Die unachtsam weggeworfenen Fadenstuecke sind nur die Reste der "
	     "Faeden, mit denen Unakar naeht.");

  AddDetail( ({"gestalten"}), 
	     "Die verschiedensten Gestalten lungern hier herum. Moeglicherweise "
	     "sind unter ihnen auch Diebe.");

  AddDetail( ({"gewuerze","gewuerzen"}), 
	     "Hier gibt es keine Gewuerze.");

  AddDetail( ({"kram"}), 
	     "Am Mada Basari findest Du allen moeglichen und unmoeglichen "
	     "Kram. Einiges von dem Kram ist sicher nuetzlich (wie zum Beispiel "
	     "Bratpfannen) anderes allerdings eher unnuetz (wer braucht denn schon "
	     "Kameldung?).");

  AddDetail( ({"angebote", "haendler"}), 
	     "Die vielen Angebote verwirren Deine Sinne. Du versucht allen "
	     "Haendlern gleichzeitig zu lauschen, alles gleichzeitis zu riechen "
	     "und zu sehen.");

  AddDetail( ({"jahre","jahren"}), 
	     "Vor vielen, vielen Jahren haben sich ein paar Zwerge in die Wueste auf "
	     "gemacht um neues Land zu besiedeln.");

  AddDetail( ({"zwerge","zwergen"}), 
	     "Wuestenzwerge oder Gebirgszwerge?");

  AddDetail( ({"land"}), 
	     "Die Wuestenzwerge haben dieses Land hier besiedelt.");

  AddDetail( ({"gebirge","gebirgszwerge"}), 
	     "Die Gebirgszwerge graben in den Hoehlen des grossen "
	     "Gebirges nach Reichtuemern und Schaetzen.");

  AddDetail( ({"ueberblick"}), 
	     "Wegen der vielen Leute ist es fuer Dich sehr schwer den "
	     "Ueberblick zu behalten.");

  AddDetail( ({"diebe","dieben", "boerse", "geldboerse"}), 
	     "Hier gibt es sicher einige Diebe. Pass besser auf Deine "
	     "eigene Geldboerse auf, als nach Dieben zu suchen.");

  AddDetail( ({"menge"}), 
	     "Da sich hier sehr viele Leute rumtreiben haben Diebe hier "
	     "sehr leichtes Spiel.");

  AddDetail( ({"spiel"}), 
	     "Diebe haben hier sicher leichtes Spiel.");

  AddDetail( ({"einziger"}), 
	     "Nur der beste Schneider der Wuestenzwerge darf seine "
	     "Waren am Markt verkaufen. Er wird in einem Wettbewerb bestimmt.");

  AddDetail( ({"waren"}), 
	    "Unakar hat wunderbare Waren zu bieten.");

  AddDetail( ({"recht"}), 
             "Der beste Schneider der Wuestenzwerge hat das Recht seine "
	     "Waren am Mada Basari zu verkaufen.");

  AddDetail( ({"beliebtheit"}), 
             "Unakars Kleider erfreuen sich groesster Beliebtheit unter "
	     "den Leuten hier.");

  AddDetail( ({"stoffe"}), 
	     "Die Stoffe, aus denen Unakar seine Kleider naeht sind wunderbar "
	     "weich und leicht.");

  AddDetail( ({"boden"}), 
	     "Der Boden neben dem Stand ist voller Fadenstuecke und "
	     "Stoffreste.");

  AddDetail( ({"silberland"}), 
	     "Hier befindest Du Dich in der Wueste des Silberlandes");

  AddDetail( ({"bratpfanne","bratpfannen","beispiel"}), 
	     "Bratpfannen kann man immer brauchen!");

  AddDetail( ({"kameldung","dung"}), 
	     "Ih! Das braucht ja wirklich niemand!");

  AddDetail( ({"sinne"}), 
	     "Ein humanoides Wesen hat meist fuenf Sinne. Das Leben "
	     "hat aber nur einen.");

  AddDetail( ({"wueste"}), 
	     "Auch wenn es nicht so aussieht, Du befindest Dich mitten "
	     "ihr.");

  AddDetail( ({"reichtuemer","reichtuemern","schaetze"}), 
	     "In den tiefen Hoehlen des Gebirges lagern sicher "
	     "unglaubliche Schaetze.");

  AddDetail( ({"hoehlen","hoehle"}), 
	     "In den tiefen Hoehlen des Gebirges kann so manches "
	     "Ungeheuer lauern.");

  AddDetail( ({"stoffreste","reste","schnipsel","schnipseln"}), 
	     "Mit diesen kleinen Schnipseln kannst Du nichts anfangen.");

  AddDetail( ({"silerlandes"}), 
	     "Das ist der zweite Fall, auch Genetiv genannt.");

  AddDetail( ({"ungeheuer"}), 
	     "Der Balrog ist eines dieser Ungeheuer.");

  AddDetail( ({"balrog"}), 
	     "Die Zwerge haben zu gierig geschuerft und dieses Wesen "
	     "geweckt.");

  AddDetail( ({"wesen"}), 
             "Wesen gibt es viele. Drueck Dich genauer aus.");

  AddDetail( ({"genetiv","fall"}), 
	     "Der zweite Fall. Zum Beispiel: des Hauses, des Entes, des Leoparden ...");

  AddDetail( ({"entes"}), 
	     "Des Entes? Unsinn!");

  AddDetail( ({"unsinn"}), 
	     "So ein Unsinn aber auch!");

  AddDetail( ({"faeden"}), 
	     "Mit Faeden naeht Unakar seine Kleider zusammen.");  

  AddDetail( ({"leben"}), 
	     "Das Leben hat nur einen Sinn.");

  AddDetail( ({"sinn"}), 
	     "Den Sinn des Lebens kennt man nicht.");

  AddDetail( ({"himmel"}), 
	       "Der Himmel ist strahlend blau.");

  AddDetail( ({"wettbewerb","bewerb"}), 
	     "Jaehrlich wird der neue Meisterschneider durch einen "
	     "Wettbewerb ermittelt.");

  AddDetail( ({"meisterschneider"}), 
	     "Der beste der Schneider.");

// Details Ende


  AddExit("norden", BASARIROOM "basari_2x1");
  AddExit("nordosten", BASARIROOM "basari_2x2");
  AddExit("osten", BASARIROOM "basari_3x2");

   AddItem(BASARINPC "unakar", REFRESH_DESTRUCT);
   AddItem(BASARINPC "f_besucher", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier am suedwestlichen Ende des Mada Basari, dem "
	"Markt der Wuestenzwerge. Etliche Leute draengen sich vor dem Stand eines "
	"Schneiders, der wunderbare Kleidung anbietet. Neben dem Stand liegen einige "
	"Stoffballen und Fadenstuecke herum. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Der Schneider ist leider nirgends zu sehen.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
