inherit "/d/wueste/gwenshara/estadt/room/std_basari_laden";

#include "../def.h"
#include <laden.h>
#include <food.h>
#include "/d/wueste/gwenshara/estadt/basari.h"

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:40]));

  SetProp(P_INT_SHORT,"Am Kraueterstand des Mada Basari");

  SetProp(P_SHOPKEEPER_ID, "layandra");
  SetProp(P_SHOPKEEPER_NAME, "Layandra");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
 /* SetProp(P_SPECIAL_SHOP,
	  ([P_FOOD_INFO:"Layandra sagt: Ich kaufe nur Kraeuter\n"]));*/

  SetStorageRoom(BASARIROOM "lagerraum_pflanzen" );

//-----Details Anfang-----
  AddDetail( ({"basar","basari","mada","mada basari","basars"}),
	    "Der Mada Basari ist der grosse Basar der Wuestenzwerge.");

  AddDetail( ({"zwerge","wuestenzwerge","volk","zwergenvolk"}),
	    "Die Wuestenzwerge sind ein hier ansaessiges Zwergenvolk.");

  AddDetail( ({"boden"}),
	    "Der Boden ist voller festgetretenem Sand.");

  AddDetail( ({"brett","liste"}),
	    "Auf dem Brett ist eine Liste mit den hier kaeuflichen Kraeutern "
	    "zu finden. Man kann sie angeblich lesen!");

  AddDetail( ({"kaeufer","menge"}),
	    "Jede Menge potentielle Kaeufer treiben sich vor dem Stand herum und "
	    "betrachten die angebotenen Kraeuter.");

  AddDetail( ({"mitte"}),
	    "Du befindest Dich hier genau in der Mitte des Basars.");

  AddDetail( ({"pflanzen","kraeuter","kraeutern","waren"}),
	    "Die Pflanzen und Kraeuter hier sehen sehr gut gepflegt aus. "
	    "Vielleicht solltest Du welche kaufen...");

  AddDetail( ({"stand"}),
	    "Der Stand, der hier aufgebaut ist, bietet jede erdenkliche Art von "
	    "Pflanzen oder Kraeutern an.");

  AddDetail( ({"art"}),
	    "Tatsaechlich jede erdenkliche Art. Heilende, giftige, wuerzende...");
//-----Details Ende-----


  AddExit("osten", BASARIROOM "basari_2x3");
  AddExit("nordwesten", BASARIROOM "basari_1x1");
  AddExit("westen", BASARIROOM "basari_2x1");
  AddExit("suedosten", BASARIROOM "basari_3x3");
  AddExit("nordosten", BASARIROOM "kneipe_zelt");
  AddExit("suedwesten", BASARIROOM "basari_3x1");
  AddExit("sueden", BASARIROOM "basari_3x2");
  AddExit("norden", BASARIROOM "basari_1x2");

   AddItem(BASARINPC "layandra", REFRESH_DESTRUCT);
   AddItem(BASARINPC "waechter", REFRESH_DESTRUCT);
   AddItem("/d/wueste/gwenshara/zechi/npc/yoregh", REFRESH_DESTRUCT);
  
  RemoveCmd( ({"verkaufe","verkauf","versetze","versetz"}) );
  AddCmd( ({"verkaufe","verkauf","versetze","versetz"}), "cmd_sell");
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier genau in der Mitte des Mada Basari. Vor Dir "
	"findest Du einen Stand voll duftender Kraeuter und Pflanzen. Auf einem "
	"Brett ist eine Liste mit den erwerbbaren Kraeutern aufgehaengt. Einige "
	"potentielle Kaeufer draengen sich vor dem Stand und begutachten die "
	"verschiedenen Kraeuter. ";
  
  if(!present(QueryProp(P_SHOPKEEPER_ID)))
    txt += "Die Haendlerin ist derzeit nicht hier.";
  else txt += "";

  return BS(txt);
}

int cmd_sell(string str) // Hier kann man nicht verkaufen
{
  notify_fail("Hier kannst Du nichts verkaufen.\n");
  return 0;  
}
