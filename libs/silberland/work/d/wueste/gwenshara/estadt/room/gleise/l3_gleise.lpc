#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

int silber;

void create()
{
  ::create();

  silber = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier vor einem grossen Tor, dass Dich weiter in die Gaenge "
    "unter der Wueste fuehrt. Ausserdem enden hier Gleise an einem kleinen "
    "Holzbock. Neben dem Tor stehen zwei Kohlebecken, die mit ihren Feuern "
    "den Gang erhellen. Von der Decke tropft ab und an etwas Wasser.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "tor" }),
    "Du stehst hier vor einem grossen Tor, dessen Rand mit zwergischen Runen "
    "versehen wurde. Es steht weit offen, und du kannst dahinter eine grosse "
    "Bruecke erkennen.");

  AddDetail( ({ "gleise" }),
    "Zwei silberne Gleise fuehren von hier aus in die Dunkelheit.");

  AddDetail( ({ "bock", "holzbock" }),
    "An diesem Holzbock enden die Gleise. Er dient wohl dazu, die Gleisstrecke "
    "zu begrenzen, so dass die Waegen nicht geradewegs in das Tor krachen.");

  AddDetail( ({ "becken", "kohlebecken" }),
    "In den eisernen Becken liegt ein Haufen Kohle, der einer Flamme als Nahrung "
    "dient.");

  AddDetail( ({ "feuer", "feuern", "flammen" }),
    "Die Flammen, die in den Becken flackern, erhellen diesen Gang gerade so, dass "
    "Du etwas erkennen kannst.");

  AddDetail( ({ "decke" }),
    "Auf der Decke haben sich ein paar Stalaktiten gebildet. Von einem tropft "
    "ab und an etwas Wasser.");

  AddDetail( ({ "runen" }),
    "Diese kantigen Runen wurden in den Stein des Tors eingelassen. Sie bestehen "
    "aus einem irisierenden Metall. Vermutlich kann man sie auch lesen.");

  AddDetail( ({ "bruecke", "holzbruecke" }),
    "Von hier aus kannst Du nur erkennen, dass dahinter eine grosse Holzbruecke "
    "weiterfuehrt.");

  AddDetail( ({ "dunkelheit" }),
    "Weiter hinten in den Gaengen duerfte es kein Licht mehr geben.");

  AddDetail( ({ "wagen", "waegen" }),
    "Auf diesen Gleisen fahert ein Wagen hin- und her.");

  AddDetail( ({ "haufen", "kohle" }),
    "Die Kohlehaufen dienen als Nahrung fuer die Flammen, die den Gang erhellen.");

  AddDetail( ({ "nahrung" }),
    "Das Feuer sieht sehr hungrig aus!");

  AddDetail( ({ "metall" }),
    "Dieses Metall erinnert Dich an Mithril, muss aber etwas anderes sein, da es "
    "leicht irisierend leuchtet.");

  AddDetail( ({ "licht" }),
    "Hier wird der Gang von dem Licht der Flammen erhellt.");

  AddDetail( ({ "kohlehaufen" }),
    "In einem der Kohlehaufen glaubst Du ein glitzerndes Objekt zu erkennen.");

  AddDetail( ({ "mithril" }),
    "Mithril ist ein sehr wertvolles Metall.");

  AddDetail( ({ "objekt" }),
    "Du kannst nicht erkennen, worum es sich bei diesem Objekt handelt. Ob es ratsam "
    "ist einfach so den brennenden Kohlehaufen zu durchwuehlen?");

  AddReadDetail( ({ "runen" }),
    "Du liest: Freund tritt ein, das Boes' lass sein!");

  AddDetail( ({ "stalaktiten" }),
    "Das sind die, die nach unten haengen. Von einem tropft etwas Wasser.");

  AddDetail( ({ "wasser" }),
    "Etwas Wasser tropft ab und zu von der Decke.");

  AddDetail( ({ "stalaktit" }),
    "Von einem Stalaktit tropft immer wieder etwas Wasser, dass am Boden schon eine "
    "kleine Lacke gebildet hat.");

  AddDetail( ({ "lacke" }),
    "In der kleinen Lacke erkennst Du dein Spiegelbild.");

  AddDetail( ({ "spiegelbild" }),
    "Hey! Das bist ja Du! Du hast das Gefuhel, dein Spielbild will getrunken werden...");

  AddDetail( ({ "gefuehl" }),
    "Es ist schon beinahe befehlend!");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "trink", "trinke" }), "cmd_trinken" );
  AddCmd( ({ "wuehle", "wuehl", "durchwuehle", "durchwuehl" }), "cmd_wuehlen");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", GLEISEROOM "i4_gleise" );
  AddExit( "osten",  ANSCHLUSS_STADT);

//--Items & NPCs-----------------------------------------------------------

  AddItem( GLEISENPC "streckenwache" , REFRESH_DESTRUCT);
  AddItem( GLEISEOBJ "wagen", REFRESH_REMOVE, 1);
}

void reset()
{
  ::reset();
  silber = 1;
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "spiegelbild" ||
       str == "lacke" ||
       str == "wasser" ||
       str == "aus lacke")) return 0;

  tell_object(TP, BS("Du trinkst einen Schluck Wasser aus der Lacke."));
  tell_room(TO, BS(TPN+" schleckt am Boden herum. Widerlich."), ({TP}));
  TP->FindPotion("Das Wasser war sehr inspirierend! Ein Zaubertrank!");
  return 1;
}

int cmd_wuehlen(string str)
{
  object *gloves;
  notify_fail("Was willst Du durchwuehlen?\n");
  if(!str || str == "") return 0;
  if(!(str == "kohle" ||
       str == "haufen" ||
       str == "in kohle" ||
       str == "in haufen" ||
       str == "kohlehaufen" ||
       str == "in kohlekaufen" )) return 0;

  gloves = TP->QueryArmours(AT_GLOVE);
  if(sizeof(gloves) < 1)
  {
    tell_object(TP, BS("Du verbrennst Dir die Haende am Feuer! Wie wars mit Handschuhen?"));
    tell_room(TO, BS(TPN+" verbrennt sich die Haende am Feuer."), ({TP}));
    TP->AddHp(-10-random(10));
    return -1;
  }

  if(silber<1)
    tell_object(TP, BS("Du durchwuehlst den Kohlehaufen, findest aber doch nichts. Schade."));
  else
  {
    gloves = ({ clone_object("/p/std/skills/jewelry/obj/silber") });
    if(gloves[0]->move(TP, M_GET) != 1)
    {
      tell_object(TP, BS("Du findest ein Stueck Silber, laesst es aber fallen!"));
      gloves[0]->move(TO, M_PUT|M_NOCHECK);
    }
    else
      tell_object(TP, BS("Du findest ein Stueck Silber!"));

    silber = 0;
  }

  tell_room(TO, BS(TPN+" greift in die Flammen!"), ({TP}));
  return 1;
}
