#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier auf einem steinernen Steg, der Dich vom Tor zur "
    "Plattform eines Aufzugs bringt. Von unten zieht ein starker Wind herauf "
    "und Du musst aufpassen, nicht von dem Steg geweht zu werden. Unter "
    "Dir erkennst Du die Zwergenstadt Quaul und ihre Einwohner. Im Westen "
    "liegt das Tor und im Osten die Plattform des Aufzugs.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "steg" }),
    "Du befindest Dich hier auf einem Steg, der Dich ueber ein grosses Loch im "
    "Boden fuehrt. Er ist breit genug, dass in ganzer Pferdekarren darueber "
    "fahren koennte." );

  AddDetail( ({ "tor" }),
    "Westlich von Dir befindet sich das Tor von Quaul." );

  AddDetail( ({ "plattform" }),
    "Im Osten befindet sich die Plattform, von der aus Du den Aufzug betreten "
    "kannst." );

  AddDetail( ({ "aufzug" }),
    "Der Aufzug fuehrt durch das Loch, ueber dem Du Dich befindest, in die "
    "unteren Ebenen der Stadt." );

  AddDetail( ({ "wind" }),
    "Von unten herauf weht ein starker Wind, der an Deiner Kleidung zerrt." );

  AddDetail( ({ "stadt", "zwergenstadt" }),
    "Die Stadt befindet sich unter Dir. Du erkennst einige Zwerge herumgehen "
    "und ihren Alltag erledigen." );

  AddDetail( ({ "einwohner", "zwerge" }),
    "Tief unter Dir erkennst Du einige Einwohner der Stadt, die ihren "
    "taeglichen Geschaeften nachgehen." );

  AddDetail( ({ "loch" }),
    "Das Loch befindet sich genau unter Dir." );

  AddDetail( ({ "ebenen", "ebene" }),
    "Von hier aus erkennst Du nichts genaues, ausser, dass die Stadt in mehrer"
    "e Ebenen unterteilt ist." );

  AddDetail( ({ "kleidung" }),
    "Deine ganze Kleidung flattert im Wind." );

  AddDetail( ({ "alltag" }),
    "Du erkennst nichts genaues, vermutest aber, dass die Zwerge ihren all"
    "taeglichen Erledigungen nachgehen." );

  AddDetail( ({ "geschaefte", "geschaeften", "erledigung", "erledigungen" }),
    "Tief unter Dir kaufen verschiedene Einwohner der Stadt ein." );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus einem stabilen Steinsteg." );

  AddDetail( ({ "decke", "hoehlendecke" }),
    "Die Hoehlendecke ist ein Stueck ueber Dir." );

  AddDetail( ({ "stueck" }),
    "Ein grosses Stueck. Selbst ein grosser, ausgestreckter Troll kann sie nicht "
    "erreichen." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", STADTROOM "1c2_wehrgang"  );
  AddExit( "osten",  STADTROOM "1e2_plattform" );

}
