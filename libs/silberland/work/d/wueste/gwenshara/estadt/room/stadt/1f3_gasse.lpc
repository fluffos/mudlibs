#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Gasse, in der du hier stehst, ist kaum erleuchtet. Sie liegt in "
    "der Duesternis vor dir und wird durch die Waende zweier Haeuser gebildet. "
    "Dieser Teil der Stadt duerfte nich oft genutzt werden. Einge Faesser "
    "und Kisten stapeln sich am hinteren Ende der Gasse.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );
	
  
//--Exits------------------------------------------------------------------
  
  AddExit( "westen", STADTROOM "1e3_stadt" );
}
