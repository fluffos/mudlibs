#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "/sys/ansi.h"
#include <verben.h>
#define CORPSELOG "/d/wueste/gwenshara/estadt/log/corpselog.log"

int ausgang;

void create()
{
  ::create();
  ausgang=random(3);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einem Holzkaefig");
  SetProp( P_INT_LONG,
   "Hier bist Du in einem Holzkaefig eingesperrt.@@info@@" );
  SetProp(P_ENVIRONMENT, ([
                           ENV_TEMPERATURE: 20,
                           ENV_TERRAIN    : TT_HOUSE,]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_NOMAGIC, 100);

//-----Details Anfang-----
  AddDetail( ({"ausgang","ausgaenge"}),
	    "Du kannst ein Bussgeld bezahlen um hier heraus zu kommen.");

  AddDetail( ({"kaefig","holzkaefig"}),
            "Du bist hier in einem Holzkaefig eingesperrt. Augenscheinlich "
	    "gibt es keine Ausgaenge." );

  AddDetail( ({"decke","kaefigdecke"}),
            "Durch die Kaefigdecke hindurch kannst Du den Himmel erkennen." );

  AddDetail( ({"ausgaenge"}),
            "Augenscheinlich gibt es hier keine Ausgaenge." );

  AddDetail( ({"himmel"}),
            "Am Himmel zeigt sich kein einziges Woelkchen das die sengenden "
	    "Strahlen der Sonne von Dir abhalten will." );

  AddDetail( ({"woelkchen","wolke","wolken"}),
            "Am ganzen Himmel findest Du nicht eine Wolke." );

  AddDetail( ({"strahlen"}),
            "Die Strahlen der Sonne verbrennen langsam, aber sicher Deine Haut." );

  AddDetail( ({"sonne"}),
            "Du siehst eine hellgelbe Sonne.\nAls sie Dich blendet und Du zu "
	    "Boden blickst faellt Dir eine Stelle im Sand auf." );

  AddDetail( ({"haut"}),
            "Deine Haut wird von den Strahlen der Sonne verbrannt." );

  AddDetail( ({"etwas"}),
            "Haeltst Du es tatsaechlich fuer sinnvoll einfach 'etwas' zu "
	    "untersuchen?" );

  AddDetail( ({"stelle"}),
            "Du bemerkst das der Sand etwas aufgewuehlt ist. Vielleicht solltest "
	    "Du irgendwas mit ihm anstellen." );

  AddDetail( ({"boden"}),
            "Der Boden ist voller Sand." );

  AddDetail( ({"sand"}),
            "Der Sand ist warm und von sandiger Farbe. War auch nicht anders zu "
	    "erwarten." );

  AddDetail( ({"farbe"}),
            "Der Sand ist doch tatsaechlich von sandiger Farbe." );

  AddDetail( ({"wand","waende"}),
            "Durch die Waende hindurch kannst Du das Geschehen am Basar "
	    "beobachten." );

  AddDetail( ({"geschehen","basar"}),
            "Am Basar spielt sich so einiges ab. Einige Besucher gehen am "
	    "Kaefig vorbei, jedoch wuerdigen sie Dich keines Blickes." );

  AddDetail( ({"besucher","basarbesucher"}),
            "Die Besucher am Basar scheinen sich gar nicht fuer Dich zu "
	    "interessieren." );

  AddDetail( ({"blick","blickes"}),
            "Fuer die Basarbesucher gibt es scheinbar wichtigere Dinge als "
	    "Dich." );

  AddDetail( ({"eck","ecke","stangen"}),
	    "In einer Ecke des Kaefigs entdeckst Du eine Luecke zwischen "
	    "den Stangen." );

  AddDetail( ({"luecke"}),
	    "Mit etwas Muehe sollte es Dir gelingen Dich durch die Stangen "
	    "zu zwaengen.");

  AddDetail( ({"muehe"}),
	    "Das wird schon!" );

  AddDetail( ({"dinge","menge"}),
            "Am Basar gibt es jede Menge interessanter Dinge." );

  AddDetail( ({"staebe","gitterstaebe","staeben","gitterstaeben"}),
            "Es scheint Dir so als koennte man versuchen die Staebe zu "
	    "lockern." );
//-----Details Ende-----
//-----Gerueche Anfang-----
  AddSmell(DEFAULT_SMELL,
	   "Du riechst den staubigen Geruch von Sand.");

  AddSmell( ({"geruch"}),
	   "Der staubige Geruch von Sand steigt Dir in die Nase." );

  AddSmell( ({"sand"}),
	   "Der Sand riecht genauso staubig wie etwas anderes. Wenn Dir "
	   "doch nur einfallen wuerde was das noch war..." );

  AddSmell( ({"staub"}),
	   "Durch den Geruch von Staub hindurch riechst Du schwach einen "
	   "anderen Geruch." );

  AddSmell( ({"anderen geruch","anderer geruch"}),
	   "Der Geruch von Palmenholz schwebt sanft im Kaefig." );

  AddSmell( ({"holz","palmenholz","staebe","staeben","gitterstaebe","gitterstaeben"}),
	   "Das Holz riecht recht gut. Ausserdem faellt Dir jetzt etwas an "
	   "den Gitterstaeben auf." );
//-----Gerueche Ende-----
//-----Geraeusche Anfang-----
  AddSound( DEFAULT_SOUND,
	   "Abgesehen von dem Schreien der Marktleute kannst Du hier "
	   "nichts vernehmen." );

  AddSound( ({"schreie","schreien","marktleute","leute","verkaeufer"}),
	   "Die Verkaeufer preisen am Basar allerlei Dinge an." );

  AddSound( ({"nichts","nicht","laute","lauten"}),
	   "In den Lauten des Nichts hoerst Du ein leises Pfeifen." );

  AddSound( ({"leisem pfeifen","leises pfeifen","pfeifen"}),
	   "Das Pfeifen ruehrt von einem leichten Luftzug her." );

  AddSound( ({"luftzug","zug","luft"}),
	   "Der Luftzug pfeift leise und scheint aus einem Eck zu kommen." );
//-----Geraeusche Ende-----

 /* Hier kommt man auch raus :) */
 AddCmd( ({"bitte","bitt"}), "cmd_begnadigung");
 AddCmd( ({"zahl","zahle"}), "cmd_bussgeld");
 AddCmd( ({"zwaeng","zwaenge"}), "cmd_staebe");
 AddCmd( ({"grab","grabe"}), "cmd_loch");
 AddCmd( ({"locker","lockere"}), "cmd_lockern");

 /* Ablegen darf man hier nix - fuehrt nur zu Bugs */
 AddCmd( ({"leg","lege"})+CMD_WERFEN, "cmd_no_lay");

 // Zechpreller Gildenquest
 AddItem(({"/d/wueste/gwenshara/zechi/npc/teremoton"}), REFRESH_DESTRUCT);
}

string info()
{
  if(TP->QueryProp(P_LEVEL) < 15)
    return "Vielleicht ist es ratsam den Richter um eine Begnadigung zu bitten.";
  return "";
}

void reset()
{
  object *insassen, *inv;
  int i;
  insassen=filter_array(all_inventory(TO), #'interactive);

  ::reset();

  if(sizeof(insassen)<1) return;

  if(find_object(BASARIROOM "basari_1x2"))
    if(!present("richter", find_object(BASARIROOM "basari_1x2"))) return;

  if(!call_other(BASARIROOM "basari_1x2", "QueryKaefigStatus"))
  {
    AddExit("raus", BASARIROOM "basari_1x2");
    call_other(BASARIROOM "basari_1x2", "KExit");
    Message("Die Kaefigtuer wird geoeffnet.\n");
    call_other(BASARIROOM "basari_1x2", "say", 
	      "Die Kaefigtuer wird geoeffnet.\n");
    call_other(BASARIROOM "basari_1x2", "SetKaefig", 1);
  }

  call_out("bestrafung", 0, 0, insassen);
}

void bestrafung(int ab, object *wer)
{
  int i;
  string liste;
  if(!wer) return;

  switch(ab)
  {
    case 0: for(i=0; i<sizeof(wer); i++)
             {
	       tell_object(wer[i], BS("Du wirst auf den Richtplatz gezerrt und an den "
	               "Pranger gefesselt."));
               wer[i]->SetProp(P_PARALYZED, ([
		       PARALYZE_TIME: 1000,
                       PARALYZE_MSG:  "Du bist an den Pranger gekettet.\n",
		       PARALYZE_MSG_OTHER: "%s ruettelt an den Ketten.\n",
		       PARALYZE_END: "Du wirst losgekettet.\n",
		       PARALYZE_END_OTHER: "%s wird losgekettet.\n"
		       ]));
	      call_other(BASARIROOM "basari_1x2", "Message", 
			 wer[i]->Name(WER, 1)+" wird hereingezerrt.\n");
	      wer[i]->move(BASARIROOM "basari_1x2", 
			   M_NOCHECK|M_SILENT|M_NO_SHOW);
	      call_other(BASARIMASTER, "RemoveEnemy", wer[i]);
	     }

	     call_out("bestrafung", 3, 1, wer);
	     break;

   case 1: liste = "";
           for(i=0; i<sizeof(wer); i++)
	    {
	      liste+=capitalize(wer[i]->name());
	      liste+=", ";
	    }
            call_other(BASARIROOM "basari_1x2", "Message",
	    break_string("Ihr, "+liste+"habt gegen die Regeln des Basars "
		         "Verstossen!\n", 78, "Hwel as Laather sagt: "));
	    call_out("bestrafung", 3, 2, wer);
	    break;

   case 2: call_other(BASARIROOM "basari_1x2", "Message",
	    break_string("Nach altem Recht werdet ihr nun, so wie es die "
		          "alte Tradition verlangt bestraft. Vier Hiebe "
			  "mit der Peitsche sollen euch zurecht weisen!\n",
			  78, "Hwel as Laather sagt: "));
	    call_out("bestrafung", 4, 3, wer);
	    break;

   case 3: call_other(BASARIROOM "basari_1x2", "Message", 
		      "Der Richter zueckt eine Peitsche.\n");
	    call_out("bestrafung", 3, 4, wer);
	    break;

   case 4: call_other(BASARIROOM "basari_1x2", "Message",
	    "Hwel as Laater zaehlt: Eins...\n\nDer Richter schlaegt mit der "
	    "Peitsche zu...\n\n");
	    for(i=0; i<sizeof(wer); i++)
	    {
	      tell_object(wer[i], BS("Du schreist auf, als Dich die Peitsche "
				  "trifft.\n"));
	      tell_room(BASARIROOM "basari_1x2",
	                 capitalize(wer[i]->name())+" schreit auf.\n",
			  ({ wer[i] }) );
	      wer[i]->AddHp(-20-random(25));
	    }
	    call_out("bestrafung", 6, 5, wer);
	    break;

   case 5: call_other(BASARIROOM "basari_1x2", "Message",
	    "Hwel as Laater zaehlt: Zwei...\n\nDer Richter schlaegt mit der "
	    "Peitsche zu...\n\n");
	    for(i=0; i<sizeof(wer); i++)
	    {
	      tell_object(wer[i],BS("Du schreist auf, als Dich die Peitsche "
				 "trifft.\n"));
	      tell_room(BASARIROOM "basari_1x2",
	                 capitalize(wer[i]->name())+" schreit auf.\n",
			  ({ wer[i] }) );
	      wer[i]->AddHp(-20-random(25));
	    }
	    call_out("bestrafung", 6, 6, wer);
	    break;

   case 6: call_other(BASARIROOM "basari_1x2", "Message",
	    "Hwel as Laater zaehlt: Drei...\n\nDer Richter schlaegt mit der "
	    "Peitsche zu...\n\n");
	    for(i=0; i<sizeof(wer); i++)
	    {
	      tell_object(wer[i],BS("Du schreist auf, als Dich die Peitsche "
				 "trifft.\n"));
	      tell_room(BASARIROOM "basari_1x2",
	                 capitalize(wer[i]->name())+" schreit auf.\n",
			  ({ wer[i] }) );
	      wer[i]->AddHp(-20-random(25));
	    }
	    call_out("bestrafung", 6, 7, wer);
	    break;

   case 7: call_other(BASARIROOM "basari_1x2", "Message",
	    "Hwel as Laater zaehlt: Vier...\n\nDer Richter schlaegt mit der "
	    "Peitsche zu...\n\n");
	    for(i=0; i<sizeof(wer); i++)
	    {
	      tell_object(wer[i],BS("Du schreist auf, als Dich die Peitsche "
				 "trifft.\n"));
	      tell_room(BASARIROOM "basari_1x2",
	                 capitalize(wer[i]->name())+" schreit auf.\n",
			  ({ wer[i] }) );
	      wer[i]->AddHp(-20-random(25));
	    }
	    call_out("bestrafung", 5, 8, wer);
	    break;

   case 8: call_other(BASARIROOM "basari_1x2", "Message",
	    "Hwel as Laater sagt: Nun seid Ihr von der Schuld befreit!\n\n");
	    for(i=0; i<sizeof(wer); i++)
	    {
	      wer[i]->SetProp(P_PARALYZED, 0);
	    }
	    call_other(BASARIROOM "basari_1x2", "CloseDoor");
	    break;
  }
}

int cmd_no_lay(string str)
{
  write("Hier legst Du lieber nichts weg...\n");
  return 1;
}

int cmd_begnadigung(string str)
{
  notify_fail("Wen moechtest Du worum bitten?\n");
  if(!str) return 0;
  if(!(str == "richter um begnadigung" ||
       str == "richter um gnade" ||
       str == "um begnadigung" ||
       str == "um gnade")) return 0;

  write("Du bittest Den Richter um eine Begnadigung.\n");
  say(TPN+" redet mit dem Richter.\n");

  if( TP->QueryProp(P_LEVEL) < 15 )
  {
    call_out("begnadigung", 0, 1);
    return 1;
  }

  write("Der Richter lehnt ab.\n");
  say(TPN+" seufzt auf.\n");
  return 1;
}

int cmd_bussgeld(string str)
{
  notify_fail("Was willst Du zahlen?\n");
  if(!str) return 0;
  if(!(str == "geld" ||
       str == "busse" ||
       str == "bussgeld")) return 0;

  if( TP->QueryMoney() < (TP->QueryProp(P_LEVEL)*20) )
  {
    write("Leider hast Du zu wenig Geld.\n");
    return -1;
  }

  write(BS("Du zahlst ein Bussgeld von "+(TP->QueryProp(P_LEVEL)*20)+
       " Muenzen und bist frei."));
  say(TPN+" zahlt ein Bussgeld und kommt frei.\n");

  TP->AddMoney( -(TP->QueryProp(P_LEVEL)*20) );
  "p/daemon/zentralbank"->PayIn( (TP->QueryProp(P_LEVEL)*20) , 100);

  TP->move(BASARIROOM "basari_1x2", M_NOCHECK|M_SILENT);
  return 1;
}

void begnadigung(int ab)
{
  if(!ab) return;
  switch(ab)
  {
    case 1: write("Der Richter betrachtet Dich und nickt dann.\n");
            call_out("begnadigung", 1, 2);
	    break;
    case 2: write(BS("Der Richter nickt einem Waechter zu, der Dich sofort "
		  "aus dem Kaefig holt."));
	    say(TPN+" wird aus dem Kaefig geholt.\n");
	    call_out("begnadigung", 2, 3);
	    break;
   case 3: TP->move(BASARIROOM "basari_1x2", M_NOCHECK|M_SILENT);
            write("Der Richter sagt: Mach ja keinen Unsinn mehr!\n");
	    break;
  }
}

int cmd_loch(string str)
{
  notify_fail("Was moechtest Du wo graben?\n");
  if(!str) return 0;
  if(!(str == "loch in boden" ||
       str == "tunnel in boden" ||
       str == "loch in sand" ||
       str == "tunnel in sand" ||
       str == "ausgang in boden" ||
       str == "ausgang in sand" )) return 0;

  if(ausgang==0)
  {
    write(BS("Du graebst mit Deinen Haenden im Sand herum und entdeckst ein "
	     "Loch, in das Du sofort kriechst."));
    say(TPN+" wuehlt im Sand herum und ist ploetzlich verschwunden.\n");

    TP->move(BASARIROOM "sequencer", M_NO_SHOW|M_NOCHECK|M_SILENT);
    call_other(BASARIROOM "sequencer", "Sequenz", 0, TP);
    ausgang=random(3);
  }
  else
    write(BS("Du graebst im Boden herum, doch Du findest nichts."));
  return 1;
}

int cmd_staebe(string str)
{
  notify_fail("Wodurch moechtest Du Dich wie zwaengen?\n");
  if(!str) return 0;
  if(!(str == "muehsam durch stangen" ||
       str == "muehsam durch staebe"  ||
       str == "muehsam durch gitter"  ||
       str == "muehsam durch gitterstaebe" ||
       str == "muehsam durch gitterstangen" ||
       str == "mit muehe durch stangen" ||
       str == "mit muehe durch staebe" ||
       str == "mit muehe durch gitter" ||
       str == "mit muehe durch gitterstaebe" ||
       str == "mit muehe durch gitterstangen")) return 0;

  if(ausgang==2)
  {
    write(BS("Du machst Dich ganz duenn und zwaengst Dich muehsam durch "
	     "die Gitterstaebe"));
    say(TPN+" macht sich duenn und ist ploetzlich weg.\n");

    TP->move(BASARIROOM "sequencer", M_NO_SHOW|M_NOCHECK|M_SILENT);
    call_other(BASARIROOM "sequencer", "Sequenz", 1, TP);
    ausgang=random(3);
  }
  else
    write(BS("Die Staebe sind viel zu eng zusammen dafuer."));
  return 1;
}

int cmd_lockern(string str)
{
  notify_fail("Was moechtest Du lockern?\n");
  if(!str) return 0;
  if(!(str == "staebe" ||
       str == "stangen" ||
       str == "gitter"  ||
       str == "gitterstaebe" ||
       str == "gitterstangen" )) return 0;

  if(ausgang==1)
  {
    write(BS("Vorsichtig lockerst Du zwei Staebe und trittst hinaus."));
    say(TPN+" ruettelt an den Staeben und ist verschwunden.\n");

    TP->move(BASARIROOM "sequencer", M_NO_SHOW|M_NOCHECK|M_SILENT);
    call_other(BASARIROOM "sequencer", "Sequenz", 2, TP);
    ausgang=random(3);
  }
  else
    write(BS("Die Gitterstabe sitzen zu fest!"));
  return 1;
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  call_out("corpse_remove", 0, victim);
}

void corpse_remove(object victim)
{
  object corpse, *inv, cp;
  int i;
  corpse=present("Leiche");
  if(!corpse)
  {
    BASARIMASTER->Msg(victim->name()+" stirbt im Kaefig, keine Leiche!!");
    return;
  }
  
  Message(BS("Die Leiche von "+victim->name()+" wird aus dem Kaefig geholt."
	 ));
  
  inv = all_inventory(corpse);
  if(!sizeof(inv)) return;
		  
  victim->Message(break_string("Wenn Du Deine Leiche wieder haben willst, dann "
	          "frage den Richter des Basars danach!", 78, 
		  "Ein Basarwaechter teilt Dir mit: "), MSGFLAG_TELL);

  cp = clone_object(OBJ "mummy_container");
  cp->SetOwner(victim);
  corpse->move(cp, M_NOCHECK);  

  write_file(CORPSELOG, ctime()+": ----- Neue Leiche ("+getuid(victim)+") -"
	     "----");

  cp->move(ROOM "aufbewahrungsraum", M_NOCHECK);
}

void KExit()
{
  AddExit("raus", "aus dem Kaefig#"+BASARIROOM "basari_1x2");
  return;
}
