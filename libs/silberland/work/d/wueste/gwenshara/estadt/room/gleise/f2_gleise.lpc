#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Gleise fuehren hier von Westen, wo sie aus einer hellen Oeffnung "
    "im Fels kommen, nach Suedosten. Hier ragen einige unfoermige Felsen "
    "von der Decke. Ein leichter Wind pfeift Dir hier um die Ohren. Schrecklich "
    "diese Zugluft.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "gleise" }),
    "Die silbrigen Gleise fuehren hier von Westen nach Suedosten. Wenn Du "
    "ihnen weiter folgst landest Du sicher an einer Haltestelle." );

  AddDetail( ({ "oeffnung" }),
    "Durch eine Oeffnung im Westen gelangt man aus diesem Gang hinaus "
    "in eine Hoehle. Von dort dringt auch ein wenig blaeuliches Licht "
    "in den Gang." );

  AddDetail( ({ "felsen" }),
    "Die Decke ist uebersaeaet mit ziemlich unfoermigen Felsen. Bei einem "
    "Fels faellt Dir etwas seltsames auf." );

  AddDetail( ({ "decke" }),
    "Die Decke hier ist nicht so glatt, wie in anderen Gaengen. Ueberall an "
    "ihr befinden sich seltsam unfoermige Felsen." );

  AddDetail( ({ "wind" }),
    "Ein leichter Wind pfeift Dir hier um die Ohren. Pass bloss auf, dass Du "
    "keinen steifen Hals bekommst." );

  AddDetail( ({ "zugluft" }),
    "Diese Zugluft hier ist wirklich unangenehm. Davon bekommt man auch "
    "leicht Ohrenschmerzen." );

  AddDetail( ({ "haltestelle", "haltestellen" }),
    "Hier unten gibt es zwei Haltestellen. Eine am Basar der Wuestenzwerge "
    "und eine bei ihrer Stadt." );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle im Westen ist riesig und in ihr befindet sich ein unterirdischer "
    "See. Um sie zu erkunden solltest Du nach Westen gehen." );

  AddDetail( ({ "licht" }),
    "Ein leicht blaeuliches Gluehen dringt vom Westen herein." );

  AddDetail( ({ "fels" }),
    "Dieser eine Fels sieht irgendwie flauschig aus. Vielleicht solltest Du ihn "
    "streicheln um dem auf den Grund zu gehen." );

  AddDetail( ({ "hals" }),
    "Wenn Du zu lang im Wind stehst wird Dein Hals steif." );

  AddDetail( ({ "schmerzen", "ohrenschmerzen" }),
    "Die Zugluft hier kann sicher schnell Ohrenschmerzen verursachen." );

  AddDetail( ({ "basar" }),
    "Der Basar der Wuestenzwerge befindet sich weiter oestlich von hier." );

  AddDetail( ({ "stadt" }),
    "Du muesstest schon relativ nah an der Stadt dran sein." );

  AddDetail( ({ "see" }),
    "Hier findest Du keinen See, aber weiter im Westen vielleicht." );

  AddDetail( ({ "gluehen" }),
    "Ein mystisches Gluehen dringt aus der Hoehle im Westen in diesen "
    "Gang herein." );

  AddDetail( ({ "grund" }),
    "Um dem flauschigen Fels auf den Grund zu gehen koenntest Du ihn streicheln." );

  AddDetail( ({ "ohren" }),
    "Deine Ohren sind schon ganz kalt." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedosten", GLEISEROOM "h3_gleise" );
  AddExit( "westen", GLEISEROOM "e2_bruecke");

//--Kommandos-------------------------------------------------------------

  AddCmd( ({"streichel", "streichle"}), "cmd_streicheln" );
}

int cmd_streicheln(string str)
{
  notify_fail("Was willst Du streicheln?\n");
  if(!str || str == "") return 0;
  if(!(str == "fels" ||
       str == "ueber fels" ||
       str == "felsen")) return 0;

  write(BS("Du streichelst den Fels vorsichtig und bemerkst, dass er sogar "
	"Fluegel hat. Es duerfte sich um eine Fledermaus handeln!"));
  say(BS(TPN+" fummelt an der Decke herum."));
  return 1;
}
