#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier ab Beginn einer maechtigen Halle, in der es drunter und "
    "drueber geht. Du stehst hier auf einem grossen Felsvorsprung, der gut und "
    "sicher zehn mal zehn Schritt misst. Von ihm fuehren drei grosse, steinerne "
    "Bruecken zu gegenueberliegenden Felswaenden, wo sie in kleinen Toren muenden. "
    "Mehrere grosse, hoelzerne Kraene werden hier mit Kisten und Ballen beladen, "
    "die sie dann in das gigantische Loch vor dir absenken oder auf Loren umladen.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "kreuzung" }),
    "Du stehst hier an einer Art Kreuzung. Im Westen werden die Gaenge "
    "stollenartiger, waehrend sie im Osten normal gepflastert weiterfuehren. "
    "Suedlich von Dir befindet sich ein grosses Tor mit einem Schild "
    "darueber." );

  
//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", STADTROOM "1c0_transport" );
  AddExit( "nordosten", STADTROOM "1d0_kaserne" );
  AddExit( "nordwesten",  STADTROOM "1b0_ruinentor"   );
  AddExit( "sueden", STADTROOM "1c2_platz");

//--Items-----------------------------------------------------------------

  AddItem( STADTNPC "zwerg", REFRESH_DESTRUCT );
  AddItem( STADTNPC "kranarbeiter", REFRESH_DESTRUCT);
}
