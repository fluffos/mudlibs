#include "../def.h"

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier vor dem Tor, dass Dich auf den Basar der Wuestenzwerge "
    "bringt. Einige Schritte vor dem Tor befindet sich ein kleiner, "
    "hoelzener Bock. Nach diesem fuehren zwei silbern glitzernde Gleise in "
    "die Dunkelheit. Seitlich des Tors erhellen zwei Kohlebecken, in denen "
    "Feuer brennen den Gang.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "tor" }),
    "Dieses Tor fuehrt hinaus auf den Basar der Wuestenzwerge. Zwei "
    "Kohlebecken davor erhellen den Gang, in dem Du hier stehst.");

  AddDetail( ({ "basar" }),
    "Vor dem Tor befindet sich der Basar der Wuestenzwerge, auf dem sie "
    "Handel treiben und feilschen.");

  AddDetail( ({ "schritte" }),
    "Etwa vier Menschenschritte.");

  AddDetail( ({ "bock" }),
    "Dieser hoelzerne Bock bildet den Abschluss fuer zwei Gleise, die "
    "hier herfuehren. Ohne ihn wuerden die Waegen, die hier her fahren "
    "ungebremst auf den Basar donnern.");

  AddDetail( ({ "gleise", "schienen" }),
    "Auf diesen beiden silbernen Schienen rasen die Waegen der Wuesten"
    "zwerge zwischen der Stadt und dem Basar hin und her.");

  AddDetail( ({ "dunkelheit" }),
    "Irgendwo in dieser Finsternis befindet sich die Stadt der "
    "Wuestenzwerge.");

  AddDetail( ({ "becken", "kohlebecken" }),
    "In zwei Becken aus Eisen lodert ein maechtiges Feuer, dessen "
    "flackerndes Licht den Gang erhellt.");

  AddDetail( ({ "feuer" }),
    "Das flackernde Feuer der Kohlebecken erhellt diesen Teil des Gangs.");

  AddDetail( ({ "handel" }),
    "Auf dem Basar wird mit allerlei exotischen Waren gehandelt.");

  AddDetail( ({ "menschenschritte" }),
    "Etwa acht Zwergenschritte, oder zwei Trollschritte.");

  AddDetail( ({ "abschluss" }),
    "Waere der Bock nicht, kaeme es hier sicher regelmaessig zu Unfaellen.");

  AddDetail( ({ "waegen" }),
    "Auf den Gleisen hier fahren Waegen zwischen der Stadt der Wuestenzwerge "
    "und ihrem Basar.");

  AddDetail( ({ "finsternis" }),
    "Ob Du Dich selbst auf den Weg machen solltest?");

  AddDetail( ({ "eisen" }),
    "Das Eisen, aus dem die Kohlebecken bestehen ist russgeschwaerzt.");

  AddDetail( ({ "licht" }),
    "Ohne das flackernde Licht hier wuerdest Du nichts sehen.");

  AddDetail( ({ "teil" }),
    "Dieser Teil des Ganges ist gemeint.");

  AddDetail( ({ "waren" }),
    "Wenn Dich die Waren der Haendler interessieren, solltest Du auf dem "
    "Basar nachsehen.");

  AddDetail( ({ "zwergenschritte", "zwergenschritt" }),
    "Ein Zwergenschritt ist ist ein wenig mehr als ein Hobbitschritt.");

  AddDetail( ({ "trollschritte" }),
    "Acht Trollschritte entsprechen ziemlich genau acht Ogerschritten.");

  AddDetail( ({ "unfaelle", "unfaellen", "unfall" }),
    "Wenn ein Wagen entgleist, waere das ein Unfall.");

  AddDetail( ({ "weg" }),
    "Trau Dich ruhig! Weit kann es ja nicht sein bis zur Stadt.");

  AddDetail( ({ "haendler" }),
    "Die sind draussen am Basar.");

  AddDetail( ({ "hobbitschritt" }),
    "Ein Hobbitschritt ist viel mehr als ein Feenfluegelschlag.");

  AddDetail( ({ "ogerschritt", "ogerschritte", "ogerschritten" }),
    "Ein Ogerschritt... fuehrt das nicht langsam zu weit?");

  AddDetail( ({ "stadt" }),
    "Die Wuestenzwerge hausen irgendwo unter der Wueste, in einer "
    "Stadt.");

  AddDetail( ({ "feenfluegelschlag" }),
    "Das ist immer noch weiter als ein Feenschritt.");

  AddDetail( ({ "feenschritt" }),
    "Nunja... ein Feenschritt ist ganz ganz klein!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ANSCHLUSS_BASAR );
  AddExit( "sueden", GLEISEROOM "a2_gleise");

//--Items & NPCs-----------------------------------------------------------

  AddItem( GLEISENPC "streckenwache" , REFRESH_DESTRUCT);
  AddItem( GLEISEOBJ "wagen", REFRESH_REMOVE, 1);
}

/*void reset()
{
  ::reset();
  if(!objectp(find_object(GLEISEOBJ "wagen")))
    call_other(GLEISEOBJ "wagen", "???");
}*/
