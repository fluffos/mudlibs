#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

int kraken;

void create()
{
  ::create();
  kraken = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier am Ufer eines unterirdischen Sees. Es faellt "
    "hier sanft ab in den See. Das Wasser schappt ab und zu gegen Deine "
    "Fuesse. Von dem See geht ein blaeuliches Gluehen aus, dass die "
    "riesige Hoehle, in der Du Dich hier befindest erhellt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "ufer" }),
    "Du befindest Dich hier am Ufer eines unterirdischen Sees, der sich "
    "weiter nach Norden hin erstreckt." );

  AddDetail( ({ "see" }),
    "Der See erstreckt sich weiter nach Norden, wo er auch von einer Bruecke "
    "ueberspannt wird." );

  AddDetail( ({ "wasser" }),
    "Das Wasser ist hier etwas trueb, scheint aber blaeulich zu gluehen, so "
    "dass du ab und zu Schatten darin erkennen kannst." );

  AddDetail( ({ "fuesse", "fuss" }),
    "Ab und zu schwappt eine Welle des Wassers gegen deine Fuesse. Es ist "
    "eiskalt und sicher nicht zum Baden geeignet." );

  AddDetail( ({ "gluehen" }),
    "Das blaeulich Gluehen erhellt die riesige Hoehle hier. Es scheint "
    "weiter aus dem Norden zu kommen." );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle, in der Du Dich hier befindest, ist riesig. Sie erstreckt "
    "sich weiter nach Norden hin, wo sie auch von einer Bruecke durchquert "
    "wird." );

  AddDetail( ({ "bruecke" }),
    "Die Bruecke befindet sich weiter im Norden. Du siehst gerade einen "
    "Wagen drueber rasen. Wenn Du den See im ueberqueren willst, solltest "
    "Du es dort versuchen." );

  AddDetail( ({ "schatten" }),
    "Du erkennst im trueben Wasser einige Schatten. Die meisten sind starr "
    "und bewegungslos, also duerfte es sich um Steine handeln. Ein Schatten "
    "jedoch bewegt sich. Vielleicht ist es ein Fisch." );

  AddDetail( ({ "welle" }),
    "Eine Welle schwappt gegen Deinen Fuss und Du stellst fest, dass das Wasser "
    "eiskalt ist." );

  AddDetail( ({ "baden" }),
    "Du willst es lieber gar nicht erst versuchen." );

  AddDetail( ({ "wagen", "waegen" }),
    "Ab und zu fahren Waegen ueber die Bruecke im Norden." );

  AddDetail( ({ "fisch" }),
    "Fuer einen Fisch ist der Schatten viel zu gross. Wohl doch eher ein "
    "Riesenfisch." );

  AddSpecialDetail( ({"riesenfisch"}), "detail_riesenfisch");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", GLEISEROOM "c4_gang" );

//--Aktionen--------------------------------------------------------------

  AddCmd( ({"bade", "bad", "schwimm", "schwimm"}), "cmd_baden");
}

int cmd_baden(string str)
{
  notify_fail("Worin willst Du baden?\n");
  if(!str || str == "") return 0;
  if(!(str == "in see" ||
       str == "in wasser" ||
       str == "in unterirdischem see")) return 0;

  tell_object(TP, BS("Du testest das Wasser mit dem Finger und stellst fest, dass "
	      "es eindeutig zu kalt ist."));
  tell_room(TO, BS(TPN+" steckt einen Finger ins Wasser und zittert vor Kaelte."), ({TP}));
  return 1;
}

void clone_kraken()
{
  object ob;
  if(objectp(present("\nkraken", TO)) || !kraken) return;
  ob = clone_object(GLEISENPC "kraken");
  ob->move(TO, M_GO|M_SILENT|M_NOCHECK);
  tell_room(TO, BS("Ein riesiger Kraken taucht langsam aus dem See auf!"));
  kraken = 0;
  return;
}

string detail_riesenfisch(string s)
{
  if(kraken)
  {
    call_out("clone_kraken", 2);
    return BS("Gerade als Du darueber nachdenkst, wie Fische in diesem Wasser "
	      "ueberleben koennen beginnt das Wasser zu brodeln.");
  }

  return BS("Wie koennen so grosse Fische in diesem Wasser nur ueberleben?");
}

void reset()
{
  ::reset();
 kraken = 1;
}

