#include "../def.h"

inherit "std/room";

void create()
{
  mapping exits;
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem alten Stollen");
  SetProp(P_INT_LONG, "Ein Stollen");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 55, ENV_TERRAIN: TT_DESERT]) );

//--Details----------------------------------------------------------------
//--Kommandos--------------------------------------------------------------
//--Ausgaenge--------------------------------------------------------------
//--Items & NPCs-----------------------------------------------------------

  if(file_name(TO) == ROOM "stollen") return;

  PO->CustomizeObject();
}

void SetExits(mapping e)
{
  string *dirs;
  int i;

  dirs = m_indices(e);
  for(i=0; i<sizeof(dirs); ++i)
    AddExit(dirs[i], e[dirs[i]]);
  return;
}
