#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Der Gang fuehrt hier von Norden nach Sueden. Es sieht aus, als waere "
    "er gegraben worden, damit der Fahrwagen der Wuestenzwerge hier "
    "auf den Gleisen durchrasen kann. An den Waenden sind noch die Spuren "
    "von zwerigscher Bearbeitung erkennbar.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wagen", "fahrwagen" }),
    "Ab und zu faehrt hier der Fahrwagen der Wuestenzwerge durch. Er befoerdert "
    "Passagiere zwischen ihrer Stadt und dem Basar hin und her." );

  AddDetail( ({ "zwerge", "wuestenzwerge" }),
    "Die Wuestenzwerge sind Zwerge, die sich in der Wueste angesiedelt haben. "
    "Sie haben kein Haar am Koerper, was schon etwas seltsam ist." );

  AddDetail( ({ "gleise", "gleisen" }),
    "Die Zwerge haben hier silberne Gleise verlegt, damit ihr Fahrwagen auch "
    "sicher ankommt. An einigen Stellen sehen sie schon etwas angerostet aus." );

  AddDetail( ({ "spuren" }),
    "An den Waenden erkennst Du eindeutige Spuren kuenstlicher Bearbeitung." );

  AddDetail( ({ "bearbeitung" }),
    "Du erkennst die Spuren von Meisseln, Spitzhacken und Schaufeln." );

  AddDetail( ({ "passagiere", "passagier" }),
    "Da Du hier stehst, hast Du Dich offensichtlich dazu entschieden kein "
    "Passagier zu sein. Wenn Du mit dem Wagen mitfahren willst, kannst Du "
    "das noerdlich von hier tun." );

  AddDetail( ({ "stadt" }),
    "Die Stadt der Wuestenzwerge befindet sich angeblich irgendwo oestlich "
    "von hier." );

  AddDetail( ({ "basar" }),
    "Der Basar befindet sich nicht weit noerdlich von hier." );

  AddDetail( ({ "haar" }),
    "Es ist schon seltsam, dass die Wuestenzwerge kein einziges Haar haben. "
    "Anders als ihre Artgenossen haben sie damit auch keinen Bart." );

  AddDetail( ({ "koerper" }),
    "Die Koerper der Wuestenzwerge sind klein und gedrungen." );

  AddDetail( ({ "stellen" }),
    "Die Stellen sehen nicht mehr sehr gut aus. Vielleicht sollte sich jemand "
    "darum kuemmern." );

  AddDetail( ({ "meissel", "meisseln", "haemmer" }),
    "Offenbar haben die Zwerge den Fels hier mit ihren Haemmern und Meisseln "
    "glatt geschlagen." );

  AddDetail( ({ "hacken", "spitzhacken" }),
    "Dieser Gang hier wurde sicher mit Spitzhacken gegraben. Man kann hier "
    "sicher auch nach Edelsteinen schuerfen." );

  AddDetail( ({ "schaufel", "schaufeln" }),
    "Mit Schaufeln hat man den Schutt weggetragen." );

  AddDetail( ({ "artgenossen" }),
    "Damit sind die Gebirgszwerge gemeint." );

  AddDetail( ({ "bart" }),
    "Keiner da. Eben." );

  AddDetail( ({ "edelsteinen", "edelsteine" }),
    "Die Waende glitzern und funkeln, als waren sie mit Edelsteinen gefuellt." );

  AddDetail( ({ "gebirgszwerge" }),
    "Die leben weit weg im Gebirge und haben Baerte." );

  AddDetail( ({ "gebirge" }),
    "Das Gebirge ist weit entfernt von hier." );

  AddDetail( ({ "baerte" }),
    "Ja, die Gebirgszwerge haben sowas." );

  AddDetail( ({ "schutt", "zeit" }),
    "Der wurde schon vor langer Zeit weggetragen." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", GLEISEROOM "a1_gleise" );
  AddExit( "suedosten", GLEISEROOM "c3_gleise");
}
