#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();
  replace_program(STD "std_stadt");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Plattform, auf der du dich hier wiederfindest, ist, im Gegensatz "
    "zu den anderen beiden, sehr ruhig. Noerdlich von dir wurde ein "
    "verzierter Steinbogen in den Fels gemeisselt, durch den es in einen "
    "dunkleren Gang zu fuehren scheint. Davor und daneben wurden unzaehlige "
    "Kerzen und Feuerschalen aufgestellt.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );

  
//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedosten", STADTROOM "1c1_hub" );
  
//--Items-----------------------------------------------------------------

  AddRoomMessage( ({
    "Einige der Kerzen flackern in einem Luftzug.\n",
    "Ein Zwerg kommt vorbei und zuendet andaechtig eine Kerze an.\n",
    "Eine alte Zwergin haelt kurz Andacht vor dem Tor.\n",
    "Ein alter baertiger Zwerg stimmt eine alte Zwergenhymne an.\n",
    "Eine kleine Gruppe Zwergenarbeiter kommt ueber die Bruecke, um hier kurz zu beten.\n",
    "Ein alter Zwerg in roter Robe geht mit einer Laterne in die Dunkelheit.\n",
    "Ein kalter Lufthauch weht durhc den Durchgang.\n"
    }), 60);
}
