#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Die Gleise machen hier, so wie auch der Gang, eine scharfe Kurve. An "
    "den Waenden befindet sich eine gruenliche Schleimschicht, die in der "
    "Dunkelheit blaeulich glueht. Ein kleinerer, offenbar natuerlicher, "
    "Gang fuehrt weiter nach Sueden.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "gleise", "gleisen" }),
    "Die Gleise machen hier eine sehr scharfe Kurve von Nordwesten nach "
    "Nordosten." );

  AddDetail( ({ "kurve" }),
    "Die Kurve hier ist wirklich sehr steil. Wenn die Gleise beschaedigt "
    "waeren haette das sicher unangenehme Konsequenzen." );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind von einer widerlichen Schleimschicht ueberzogen, die "
    "in der Dunkelheit blaeulich glueht." );

  AddDetail( ({ "schleim", "schicht", "schleimschicht", "schleims" }),
    "Diese Schleimschicht ist richtig ekelhaft. Ab und zu tropft ein fetter "
    "Batzen des Schleims zu Boden. Was fuer einen Geschmack hat so ein "
    "Schleim eigentlich?" );

  AddDetail( ({ "dunkelheit", "licht" }),
    "Wenn Du hier kein Licht hast, ist es dunkel. Das nennt man Dunkelheit." );

  AddDetail( ({ "gang" }),
    "Der Gang der nach Sueden fuehrt ist kleiner und scheint natuerlich gewachsen zu sein." );

  AddDetail( ({ "konsequenzen", "konsequenz" }),
    "Die Konsequenz von beschaedigten Gleisen an dieser Stelle, waere die eines "
    "katastrophalen Unfalls." );

  AddDetail( ({ "batzen" }),
    "Ab und zu tropft ein grosser Batzen Schleim zu Boden." );

  AddDetail( ({ "boden" }),
    "Am Boden haben sich kleine Schleimpfuetzen gebildet. Auch die Gleise sind "
    "leicht beschleimt." );

  AddDetail( ({ "geschmack" }),
    "Den Geschmack von Schleim kann man nur auf eine Art untersuchen..." );

  AddDetail( ({ "stelle" }),
    "Diese Stelle ist sehr praedestiniert fuer einen Unfall." );

  AddDetail( ({ "unfall", "unfalls" }),
    "Ein Unfall hier ware katastrophal!" );

  AddDetail( ({ "pfuetzen", "schleimpfuetzen" }),
    "Eigentlich ist das einfach nur ekelhaft." );

  AddDetail( ({ "art" }),
    "Das kannst Du Dir wohl denken..." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", GLEISEROOM "a2_gleise" );
  AddExit( "nordosten", GLEISEROOM "d2_gleise");
  AddExit( "sueden", GLEISEROOM "c4_gang");

//--Kommandos-------------------------------------------------------------

  AddCmd( ({"koste", "kost", "schlecke", "schleck", "lecke", "leck"}),
          "cmd_schleim" );

//--Items-----------------------------------------------------------------

  AddItem( GLEISENPC "entschleimer", REFRESH_DESTRUCT );
}

int cmd_schleim(string str)
{
  notify_fail("Was willst Du kosten?\n");
  if(str != "schleim") return 0;

  write(BS("Du kostest ein wenig Schleim und stellst fest, dass er salzig schmeckt."));
  say(BS(TPN+" schleckt an der Wand."));
  return 1;
}
