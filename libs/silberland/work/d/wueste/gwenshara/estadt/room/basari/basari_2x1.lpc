#pragma strong_types

inherit "/d/wueste/gwenshara/estadt/room/std_basari";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

#define ANSCHLUSS "/d/wueste/protheg/kraterrand/room/krater_2_1_0"

string yournameis()
{
  return "Dein Name ist "+TP->QueryProp(P_NAME)+".\n";
}

string yourraceis()
{
  return "Du bist ein "+TP->QueryProp(P_RACE)+"!\n";
}

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Beim Teppichhaendler des Mada Basari");
  SetProp( P_INT_LONG,
   "Du stehst hier am Beginn des Mada Basari, dem grossen Markt der "
   "Wuestenzwerge. Der Boden hier wurde mit vielen verschiedenen Teppichen "
   "ausgelegt. Du erkennst sofort das Du hier beim Teppichhaendler gelandet "
   "bist. Nach Norden hin geht es zum Waffenhaendler und nach Sueden hin "
   "zum Schneider. Den Kraeuterhaendler findest Du oestlich von hier. Am "
   "Mada Basari findest Du alles was Dein Herz begehrt!\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "beginn", "Du stehst hier am Beginn des grossen Mada Basari.");
  
  AddDetail( ({"mada","basari","basar","markt"}),
            "Dies hier ist der Mada Basari, der grosse Markt der "
            "Wuestenzwerge. Hier werden alle moeglichen Waren aus aller "
            "Herren Laender feil geboten. Allerdings solltest Du auf Deine "
	    "Geldboerse Acht geben, denn wo viele Leute sind sind auch Diebe."
	     );
  
  AddDetail( ({"waren"}),
     "Hier werden derzeit Teppiche angeboten. Alle samt aus Kamelhaar "
     "gemacht und sicher nicht gerade billig." );

  AddDetail( ({"herren", "laender"}),
     "Hier werden auch Waren angeboten, die sonst nur fern der Wueste "
     "zu bekommen sind." );

  AddDetail( ({"boerse", "geldboerse", "acht"}),
     "Auf deine Geldboerse solltest Du gut aufpassen. Hier gibt es ganz "
     "sicher Diebe." );

  AddDetail( ({"leute"}),
     "Auf dem Basar treiben sich allerlei Leute aus allen nur erdenklichen "
     "Regionen herum." );

  AddDetail( ({"diebe"}),
     "Diebe sind aeusserst unangenehme Gesellen, die danach trachten Dir "
     "Deine Boerse zu erleichtern." );

  AddDetail( ({"haar", "kamelhaar", "kamel", "kamels"}),
     "Das Haar eines Kamels eignet sich besonders gut um Teppiche daraus zu "
     "fertigen." );

  AddDetail( ({"wueste"}),
     "Du befindest Dich hier ziemlich genau in der Mitte der Wueste." );

  AddDetail( ({"regionen", "region"}),
     "Das Silberland besteht aus unterschiedlichen Regionen. Diese sind "
     "die Ebene, das Gebirge, die Unterwelt, der Dschungel, das Huegelland, "
     "der Kristallwald, die Meere des Wassers und die Wueste." );

  AddDetail( ({"mitte", "zentrum"}),
     "Der Basar befindet sich in etwa im Zentrum der Wueste." );
  
  AddDetail( ({"ebene", "midas"}),
     "In der Ebene liegt die grosse Stadt Midas. Sie grenzt im Westen "
     "ans Huegelland, im Norden ans Gebirge, im Suedwesten ans Wasser und "
     "im Suedosten an die Wueste." );

  AddDetail( ({"gebirge"}),
     "Das Gebirge liegt noerdlich der Ebene. Dort sind die Zwerge und "
     "die Trolle beheimatet." );

  AddDetail( ({"unterwelt"}),
     "Die dunkle Unterwelt liegt unter der Oberflaeche des Silberlandes. "
     "Dort leben die Dunkelelfen und andere lichtscheue Wesen." );

  AddDetail( ({"dschungel", "tijara"}),
     "Der Dschungel liegt im aeussersten Sueden des Silberlandes auf "
     "der Insel Tijara." );

  AddDetail( ({"huegelland", "festland", "festlandes"}),
     "Im Huegelland leben die Hobbits. Es befindet sich im Westen des "
     "Festlandes." );

  AddDetail( ({"kristallwald", "wald", "heimat"}),
     "Der Kristallwald ist die Heimat der Elfen. Auch hat man von Zentauren "
     "gehoert, die dort leben sollen." );

  AddDetail( ({"meere", "wassers", "wasser", "meer", "insel", "inseln"}),
     "Die Meere des Silberlands bilden die Region Wasser." );

  AddDetail( ({"trolle"}),
     "Trolle sind eine grosse und brutale Rasse." );

  AddDetail( ({"flaeche", "oberflaeche"}),
     "Du befindest Dich hier auf der Oberflaeche des Silberlands." );

  AddDetail( ({"dunkelelfen", "wesen"}),
     "Dunkelelfen sind lichtscheue und boesartige Wesen." );

  AddDetail( ({"silberland", "silberlands", "silberlandes"}),
     "Du bist hier im Silberland." );

  AddDetail( ({"hobbits"}),
     "Hobbits sind eine kleine, gesellige und haarige Rasse." );

  AddDetail( ({"elfen", "zentauren"}),
     "Im Kristallwald leben Elfen und man hat auch von Zentauren gehoert." );

  AddDetail( ({"zwerge","wuestenzwerge"}),
            "Die Wuestenzwerge unterscheiden sich von den Gebirgszwergen "
            "dadurch, dass sie vollkommen unbehaart sind. Allerdings sind "
	    "sie genauso geizig wie ihre Geschwister im Gebirge.");

  AddDetail( ({"gebirgszwerge", "geschwister"}),
     "Gebirgszwerge leben, wie der Name schon sagt, im Gebirge." );

  AddDetail( "boden",
             "Der Boden hier wurde mit etlichen Teppichen ausgelegt wodurch "
             "Du den eigentlichen Boden nicht mehr erkennen kannst.");

  AddDetail( ({"teppich","teppiche", "teppichen"}),
            "Am Boden liegen viele verschiedenen Teppiche, die meisten sind "
            "aus Kamelhaar, jedoch findest Du auch welche aus anderen, "
	     "teilweise seltsameren, Stoffen.");

  AddDetail( ({"stoffe", "stoffen"}),
     "Viele seltsame und Dir unbekannte Stoffe entdeckst Du." );

  AddDetail( "haendler", "Am Mada Basari findest du viele Haendler.");

  AddDetail( "teppichhaendler", 
            "Der Teppichhaendler ist hier zu finden. Er verkauft, wie der "
	    "Name schon sagt Teppiche.");

  AddDetail( ({"waffenhaendler", "sortiment", "waffen", "arten"}),
            "Den Waffenhaendler findest Du im Norden. Sein Sortiment ist "
	    "unuebertroffen. Du findest dort alle Arten von Waffen.");

  AddDetail( ({"kraueterhaendler","pflanzenhaendler","layandra",
	       "haendlerin", "kraeuterhaendlerin"}),
            "Der einzige nicht zwergische Haendler am Basar ist Layandra. "
            "Sie ist eine Wuestenelfe und verkauft allerlei Kraueter und "
	     "Pflanzen. Es lohnt sich sicher sie zu besuchen.");

  AddDetail( ({"kraeuter", "pflanzen"}),
     "Ab besten siehst Du Dich weiter im Osten danach um." );

  AddDetail( ({"wuestenelfe","wuestenelfen"}),
            "Die Wuestenelfen sind ein nomadischer Elfenstamm. Sie "
            "durchqueren die Wueste und kommen hin und wieder hier vorbei "
            "um ihre exotischen Waren zu verkaufen. Die einzige Wuestenelfe, "
            "die sich hier niedergelassen hat ist Layandra, die "
	     "Kraeuterhaendlerin.");

  AddDetail( "herz",
             "Auf diesem Basar hier findest Du alles was dein Herz begehrt!");

  AddDetail("schneider", "Den Schneider findest Du weiter im Sueden.");

  AddDetail("name", #'yournameis);
  AddDetail("rasse", #'yourraceis);
//-----Details Ende-----

  AddExit("norden", BASARIROOM "basari_1x1");
  AddExit("osten", BASARIROOM "basari_2x2");
  AddExit("sueden", BASARIROOM "basari_3x1");
  AddExit("suedosten", BASARIROOM "basari_3x2");
  AddExit("nordosten", BASARIROOM "basari_1x2");
  AddExit("westoben", ANSCHLUSS); //Ausgang aus dem Krater

  AddItem( BASARINPC "alef", REFRESH_DESTRUCT);
  AddItem( BASARINPC "waechter", REFRESH_DESTRUCT);
  AddItem( BASARIOBJ "tafel", REFRESH_DESTRUCT);
} 

public void init() {
   ::init();
 
   if(interactive(this_player())) {
     check_bard_awf_quest(this_player());
   }
 }
