inherit "/std/virtual/v_compiler";

#include "../def.h"
#include <v_compiler.h>

#define P_ROOMS "raum"

#define TG(x) tell_object(find_player("gwenshara"), x);

#define DIGDETAILS STOLLENROOM "detailmaster_digged"
#define PASDETAILS STOLLENROOM "detailmaster_passage"

void create() {
  ::create();
  SetProp(P_COMPILER_PATH, STOLLENROOM "");
  SetProp(P_STD_OBJECT, STOLLENROOM "stollen" );
  SetProp(P_ROOMS, ({"stollen"}) );
}

string Validate(string file) {
  file = ::Validate(file);
  if(!STOLLENMASTER->VC_validate_exists(file))  
    return 0;

  TG("Validated: "+file+"\n");
  return file;
}

mixed CustomizeObject() {
  int x, y;
  string foo, bar, name, detmaster, type;
  mapping exits;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d:%d%s",foo,x,y,bar)!=4)
    return 0;

  TG("Exxits\n")
  // Ausgaenge vom Master holen
  exits = STOLLENMASTER->VC_get_exits_mapping(x, y); 
  if(x == 0 && y == STOLLENMASTER->_query_height()/2)
    exits += (["osten":ANSCHLUSS_STOLLEN_STADT]);
  PO->SetExits(exits);

  TG("Type\n")
  // Raumtyp ermitteln
  type = STOLLENMASTER->VC_get_roomtype(x, y);

  TG("Description\n")
  // Beschreibung ermitteln
  if(type == "D")
    DIGDETAILS->Customize(PO);
  else
    PASDETAILS->Customize(PO);

  return 1;
}
