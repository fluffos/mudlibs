#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


inherit STD "std_stadt";

void create()
{
  ::create();

  SetProp(P_ELEMENTAL_ROOM, FEUER); //modifiziert Feuer-Zauber 

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Die Hohe Halle der Lohe in Quaul");
  SetProp(P_INT_LONG,
    "Durch ein Portal, welches mit Flammen verziert ist, betrittst du den "
    "hohen Tempel von Quaul. Er ist kreisrund und in der Mitte mit einer "
    "Stufe hinabgesetzt. Im Zentrum des Tempels brennt in einem Loch eine "
    "gewaltige blaue Flamme, die bis zur hohen Decke hinauf lodert. Davor "
    "wurde ein Altar mit einem dicken Buch darauf errichtet.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "" );
	

  AddItem( STADTNPC "priester", REFRESH_DESTRUCT );
  
//--Exits------------------------------------------------------------------

  AddExit( "osten", STADTROOM "1e4_koenigsplatz" );

//--Commands---------------------------------------------------------------
 
  AddCmd( "bete|bet", "cmd_beten");
}

public int cmd_beten() {
  write(BS("Du kniest vor dem Altar nieder und haeltst eine kurze Andacht."));
  say(BS(TPN+" kniet vor dem Altar nieder und haelt eine kurze Andacht."));
  if(TP->QueryProp(P_GHOST) || TP->QueryProp(P_FROG)) {
    write(BS("Eine Flmmenlohe umhuellt dich und gibt dir wieder deine koeperliche Form."));
    say(BS(TPN + " wird von einer Flammenlohe umhuellt und wieder koerperlich."));
    TP->SetProp(P_GHOST, 0);
    TP->SetProp(P_FROG, 0);
  } else {
    write(BS("Eine wohlige Waerme und Freundschaft umfaengt dich. Moechtest du nach deinem Tod "
             "in diesem Tempel wieder erwachen? [ja/nein]"));
    input_to("set_pray_room_here");
  }

  return 1;
}

public void set_pray_room_here(string input) {
  if(input == "ja" || input == "j") {
    write(BS("Die hohe Flamme von Quaul nimmt einen Teil deiner Seele auf und verankert ihn hier."));
    write(BS("Wenn du das naechste mal stirbst, wirst du hier erwachen."));
    TP->SetProp(P_TMP_PRAY_ROOM, this_object());
  } else {
    write(BS("Die wohlige Waerme vergeht wieder. Nichts weiter geschieht."));
  }
}
