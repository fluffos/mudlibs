#include "../def.h"
#include <combat.h>

inherit STD "std_gleise";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du zwaengst Dich hier durch einen recht schmalen Seitengang. Die Waende "
    "sind rau und scharfkantig. Im Suedosten siehst Du ein blaues Schimmern. "
    "Du musst Dich richtig bemuehen weiter zu kommen, so eng ist es hier.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "seitengang" }),
    "Dieser Seitengang ist wirklich sehr schmal. Die anderen Gaenge hier "
    "unten sind viel angenehmer zu durchwandern." );

  AddDetail( ({ "schimmern" }),
    "Das blaeuliche Schimmern kommt aus dem Suedosten. Es sieht so aus, als "
    "wuerde es dort Wasser geben." );

  AddDetail( ({ "wasser" }),
    "Ob es dort wirklich Wasser gibt? Das muesste doch ein unterirdischer See "
    "sein." );

  AddDetail( ({ "see" }),
    "Wenn Du herausfinden willst, ob es dort wirklich einen See gibt, dann "
    "solltest Du im Suedosten nachsehen!" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", GLEISEROOM "c3_gleise" );
  AddExit( "suedosten", GLEISEROOM "d5_ufer");
}

