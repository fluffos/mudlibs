#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du stehst hier auf einer riesigen, steinern Bruecke, die Dich ueber einen "
    "gaehnenden Abgrund fuehrt. Grosse Feuerschalen erhellen die Bruecke, "
    "wahrend ringsum Dunkleheit gaehnt. Im Westen befindet sich ein Tor im Fels, "
    "durch das Du zur Haltestelle des unterirdischen Fahrwagens gelangst. "
    "Weiter im Osten befindet sich ebenfalls ein Tor, durch das Du nach "
    "Quaul gelangst.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "bruecke", "steibuecke", "haengebruecke" }),
    "Du gehst hier ueber eine massive Haengebruecke, die Dich ueber "
    "eine gewaltige unterirdische Schlucht fuehrt. Immer wieder erfasst "
    "Dich ein Windstoss und drueckt Dich nach rechts oder links." );

  AddDetail( ({ "abgrund" }),
    "Unter Dir breitet sich eine gewaltige unterirdische Schlucht aus. "
    "Wenn Du in diese Schwaerze stuerzt bist Du vermutlich verloren." );

  AddDetail( ({ "tor" }),
    "Meinst Du das Osttor oder das Westtor?" );

  AddDetail( ({ "haltestelle" }),
    "Durch das Westtor gelangst Du zum unterirdischen Fahrwagen der "
    "Wuestenzwerge, der zwischen ihrem Basar und Quaul hin und her "
    "pendelt." );

  AddDetail( ({ "wagen", "fahrwagen", "fahrwagens" }),
    "Der Fahrwagen der Wuestenzwerge rast auf den Gleisen westlich von hier "
    "herum." );

  AddDetail( ({ "schlucht" }),
    "Diese unterirdische Schlucht ist wirklich gigantisch. Es wuerden "
    "sicher drei oder vier Elefanten zwischen die beiden Felswaende, zwischen "
    "denen sich die Bruecke spannt, passen." );

  AddDetail( ({ "schwaerze" }),
    "Du weisst nicht wie tief diese Schlucht nach unten fuehrt. Alles, was Du "
    "erkennst ist gnadenlose Schwaerze." );

  AddDetail( ({ "westtor" }),
    "Das Westtor fuehrt Dich zur Haltestelle des Fahrwagens. Ueber ihm erkennst "
    "Du die Schrift: Basar" );

  AddDetail( ({ "osttor" }),
    "Das Westtor fuehrt Dich nach Quaul hinein, wo Du die restlichen Wuesten"
    "zwerge findest. Ueber ihm steht: Quaul" );

  AddDetail( ({ "basar" }),
    "Der Basar der Wuestenzwerge befindet sich irgendwo westlich von hier. "
    "Du weisst gar nicht wie weit es genau ist." );

  AddDetail( ({ "gleise", "gleisen" }),
    "Der wuestenzwergische Fahrwagen rast auf interirdischen Gleisen hin und "
    "her." );

  AddDetail( ({ "elefanten" }),
    "Wenn Du ein paar Elefanten dabei haettest, koenntest Du versuchen, ob "
    "sie in diese Schlucht passen wuerden." );

  AddDetail( ({ "boden" }),
    "Der Boden wird von der Haengebruecke gebildet. Durch die Holzbretter "
    "erkennst Du die Schwaerze des Abgrunds." );

  AddDetail( ({ "decke" }),
    "Die Decke ist viele Meter ueber Dir. Gerade so weit, dass Du keine "
    "Einzelheiten erkennst." );

  AddDetail( ({ "stein", "steine" }),
    "Die Steine am Boden sind aus Platten aus gelbem Stein." );

  AddDetail( ({ "meter" }),
    "Etliche paar Meter ueber Dir befindet sich die Decke." );

  AddDetail( ({ "einzelheiten" }),
    "Die erkennst Du eben nicht." );

  AddDetail( ({ "felswaende", "waende", "wand" }),
    "Zwei riesige Felswaende befinden sich oestlich und westlich von Dir." );

  AddDetail( ({ "windstoss", "stoss", "windstoessen" }),
    "Bei diesen Windstoessen musst Du ab und zu aufpassen, dass Du nicht "
    "von der Bruecke faellst." );

  AddDetail( ({ "schrift" }),
    "Ueber dem Osttor und dem Westtor findest Du jewels eine Schrift." );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ANSCHLUSS_GLEISE );
  AddExit( "osten",  STADTROOM "1b2_tor");
}
