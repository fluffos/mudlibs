  AddDetail( ({"teller"}), 
             "Auf den Tellern tuermen sich zahlreiche Speisen.");

  AddDetail( ({"tee","speisen","getraenke"}), 
             "Mit <menue> erfaehrst Du was es hier zu essen und zu trinken "
