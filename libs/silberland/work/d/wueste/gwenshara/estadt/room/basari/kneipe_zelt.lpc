  AddDetail( ({"leben","lebens"}), 
             "Der Sinn des Lebens ist hier gar nicht zu besprechen!");

  AddDetail( ({"leckereien"}), 
             "Auf dem Tisch in der Mitte des Zeltes findest Du mehrere "
