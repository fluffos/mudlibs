  AddDetail( ({"muenzen","geld"}), 
               "Wenn Du etwas essen willst, solltest Du das auch bezahlen.");

  AddDetail( ({"tisch"}), 
             "In der Mitte des Zeltes steht ein unscheinbarer Tisch. Er "
             "ist beladen mit allerlei Leckereien. Auf ihm faellt Dir eine "
	     "Kanne auf.");

  AddDetail( ({"kanne"}),
	    "Aus der Kanne auf dem Tisch steigt Dampf auf.");

  AddDetail( ({"dampf"}),
	    "Der Dampf sieht wie Dampf aus... Vielleicht solltest Du "
	    "an ihm riechen.");

  AddDetail( ({"loecher"}), 
             "In der Plane sind einige kleinere Loecher. Keines von ihnen "
             "scheint bedenklich gross zu sein.");

  AddDetail( ({"stellen"}), 
             "An einigen Stellen in der Zeltplane kannst Du kleinere Loecher "
