  AddDetail( ({"kamel","kamele"}), 
             "Die Wuestenzwerge besitzen ein paar dieser seltsamen Tiere.");

  AddDetail( ({"tier","tiere"}), 
             "Kamele sind tatsaechlich seltsame Tiere, wie Du nach einigem "
             "ueberlegen fest stellst.");

  AddDetail( ({"wand","waende"}), 
             "Die Waende werden von Zeltplanen gebildet.");

  AddDetail( ({"gebirge"}), 
               "Das Gebirge findes Du weiter im Norden des Silberlandes. "
               "Dort wohnen auch die Gebirgszwerge.");

  AddDetail( ({"volk"}), 
             "Die Wuestenzwerge sind ein sehr lebenslustiges Volk.");

  AddDetail( ({"zwerge"}), 
             "Meist Du Gebirgszwerge oder Wuestenzwerge?");

  AddDetail( ({"idee"}),
	    "Wenn Du eine Tasse, Kakao und Zucker haettest koenntest Du jetzt einen "
	    "wunderbaren Kakao aufgiessen.");
  //Details Ende
  //Smells!
  AddSmell( "dampf", "Es riecht nach Milch.");
  AddSmell( "milch", "Dir kommt eine seltsame Idee...");
  AddSmell( "idee", "Sowas riecht man doch nicht!");

    
  AddDrink("Krauetertee", ({"kraeutertee"}),
           25, 10, 0, 5, 
           ({"Du bekommst einen Becher voll dampfendem Krautertee und trinkst ihn schnell.\n",
             "&& trinkt einen Becher Kraeutertee.\n"}));

  AddDrink("Vanilletee", ({"vanilletee"}),
           50, 12, 0, 5,
           ({"Du trinkst den Becher mit Vanilletee erstaunlich schnell aus.\nNeue Energie "
             +"durchstroemt Dich.\n",
             "&& trinkt einen Becher voll duftendem Vanilletee.\n"}));

  AddDrink("Tee mit Rum", ({"tee","rumtee","tee mit rum"}), 
           100, 20, 2, 4,
           ({"Du trinkst eine Tasse von dem nach Rum riechenden Tee.\n",
             "&& trinkt eine Tasse Tee.\n"}));

  AddDrink("Kamelmilch", ({"mlich", "kamelmilch"}), 
            150, 35, 0, 1,
           ({"Genuesslich schluerfst Du Kamelmilch aus Deinem Trinkhorn.\n"
            +"Schmeckt gar nicht so uebel!\n",
             "&& schluerft ein Horn voll Kamelmilch.\n"}));


  AddFood("Ein Kamelsteak", ({"kamelsteak", "steak"}), 100, 40, 20, 
           "steak_essen");

  AddFood("Eine Schuessel voll Datteln", ({"datteln", "schuessel"}), 100, 25, 10, 
           ({"Hmm! Du isst die ganze Schuessel voller Datteln leer.",
             "&& isst eine Schuessel voll Datteln!\n"}));

  AddItem(BASARINPC "waechter", REFRESH_DESTRUCT);
  AddItem(BASARINPC "besucher", REFRESH_DESTRUCT);

  AddExit("sueden", BASARIROOM "basari_2x3");
  AddExit("suedwesten", BASARIROOM "basari_2x2");
  AddExit("westen", BASARIROOM "basari_1x2");

 AddCmd( ({"mache", "mach", "giess", "giesse"}), "cmd_kakao");
}

public void steak_essen() {
  object task;

  write(BS("Mit einem Haps ist das ganze Steak verschlungen.\n"));
  say(BS(TPN+"  verschlingt ein Kamelsteak."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(10);
  }
}


int cmd_kakao(string str)
{
  notify_fail("Was moechtest Du aufgiessen?\n");
  if(!str || str == "");
  if(!(str == "kakao" ||
      str == "kakao auf" )) return 0;

  notify_fail("Ohne einer Tasse wird das nix!\n");
  if(!present("\nbasari_tasse", TP)) return 0;
  
  notify_fail("Kakao machen ohne Kakao?\n");
  if(!present("\nbasari_kakao", TP)) return 0;

  notify_fail("Kakao ohne Zucker schmeckt doch nicht!\n");
  if(!present("\nbasari_zucker", TP)) return 0;

  present("\nbasari_kakao", TP)->remove(1);
  present("\nbasari_zucker", TP)->remove(1);

  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME:100,
                              PARALYZE_MSG: "Du bist gerade damit beschaeftigt Kakao zu machen!\n",
			      PARALYZE_MSG_OTHER: "",
			      PARALYZE_END: "",
			      PARALYZE_END_OTHER: ""]));
  call_out("kakao_machen", 0, 0);

  BASARIMASTER->Msg(TPN+" macht sich eine Tasse Kakao.");
  return 1;
}

void kakao_machen(int ab)
{
  if(!TP) return;
  switch(ab)
  {
    case 0: tell_object(TP,"Du stellst die Tasse auf den Tisch.\n");
	    call_out("kakao_machen", 4, 1);
	    break;
    case 1: tell_object(TP,"Vorsichtig befoerderst Du das Pulver in die Tasse.\n");
	    call_out("kakao_machen", 3, 2);
	    break;
    case 2: tell_object(TP,"Du leerst etwas Milch aus der Kanne auf das Pulver.\n");
	    call_out("kakao_machen", 5, 3);
	    break;
    case 3: tell_object(TP,"Jetzt leerst Du den Zucker dazu und ruehrst noch etwas um.\n");
	    call_out("kakao_machen", 3, 4);
	    break;
    case 4: tell_object(TP,"Du wartest noch etwas damit der Kakao nicht allzu heiss ist.\n");
	    call_out("kakao_machen", 4, 5);
	    break;
    case 5: tell_object(TP,"Nun ist der Kakao fertig und Du nimmst die Schale wieder an Dich.\n");
	    present("\nbasari_tasse", TP)->Fill();
	    TP->SetProp(P_PARALYZED, 0);
	    break;
  }
}
