  AddDetail( ({"rand","raender"}), 
             "Die Raender des Zeltes werden von Planen abgedeckt.");

  AddDetail( ({"farbe"}), "Der Farben gibt es viele.");

  AddDetail( ({"personen"}), 
             "Der gelbe Polster ist vermutlich fuer hochrangige Personen "
