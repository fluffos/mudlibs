inherit "std/pub";

#include <moving.h>
#include <pub.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../def.h"
#define AddPropTP(x,y) this_player()->SetProp(x,this_player()->QueryProp(x)+y)
#include "/d/wueste/gwenshara/estadt/basari.h"
#include "/gilden/bardengilde/barden_extern.h"

string eye();

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
