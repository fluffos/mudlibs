  AddDetail( ({"teppich","teppiche","teppichen"}), 
             "Der ganze Boden ist mit wunderschoenen Teppichen aus Kamelhaar "
             "ausgelegt. Einige von ihnen sind mit schoenen Mustern bestickt "
             "worden.");

  AddDetail( ({"muster","mustern"}), 
             "Du kannst verschiedene Muster auf den Teppichen unterscheiden. "
