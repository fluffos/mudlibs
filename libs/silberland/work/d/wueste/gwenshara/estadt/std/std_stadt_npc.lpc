inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wuestenzwerg");
  SetProp(P_LONG,
    "....");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
  SetProp( P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS);
  SetProp(P_MNPC_AREA, ({ STADTROOM }));

  AddId(({"\nquaul_npc"}));

  AddLibrary(INFO_STADT, 2);

  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_FIRE  : -0.15,
         DT_POISON: -0.2,
         DT_MAGIC :  0.15,
         DT_WATER :  0.25, ]) );
}
