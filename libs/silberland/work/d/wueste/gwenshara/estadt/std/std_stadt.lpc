#include "../def.h"

inherit "std/room";

void SetDefaultDetails();

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In Quaul");
  SetProp(P_INT_LONG,
    "Hier befindest Du Dich in der Stadt der Wuestenzwerge.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------
  SetDefaultDetails();
}


void SetDefaultDetails()
{
  AddDetail( ({ "boden", "platten", "steinplatten" }),
    "Der Boden besteht aus Steinplatten aus gelbem Fels.");

  AddDetail( ({ "fels", "faerbung", "stein" }),
    "Dieser Fels hat eine gelb-graue Faerbung." );

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus nicht bearbeitetem Fels. Sie befindet sich weit "
    "ueber Dir." );

  AddDetail( ({ "gaenge", "gang" }),
    "Du befindest Dich hier in einem Gang unter der Wueste." );

  AddDetail( ({ "wueste" }),
    "Irgendwo ober Dir befindet sich die Wueste." );

  AddDetail( ({ "zwerge", "wuestenzwerge", "volk" }),
    "Dieses beinahe unbekannte Volk lebt in dieser Stadt.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende scheinen aus solidem Fels zu bestehen. Ab und zu funkelt es "
    "an ihnen. Ob man hier schuerfen kann?" );

  AddDetail( ({ "stadt", "quaul" }),
    "Diese Stadt wird von den Wuestenzwergen bewohnt." );
}

