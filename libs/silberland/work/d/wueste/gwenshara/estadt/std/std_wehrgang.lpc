#include "../def.h"

inherit STD "std_stadt";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich hier auf dem Wehrgang in der ersten Ebene von Quaul. "
    "Eigentlich handelt es sich nur um einen Felsvorsprung, der sich rund um "
    "ein Loch in der Mitte zieht, in dem der Aufzug in die unterenen Ebenen "
    "faehrt. In den Waenden erkennst Du immer wieder kleine Tueren aus Metall."
    );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wehrgang" }),
    "Hier befindest Du Dich am Wehrgang von Quaul. Er dient dazu die Feinde "
    "der Stadt gleich am Eingang abzufangen." );

  AddDetail( ({ "ebene", "ebenen" }),
    "Die Stadt ist in mehrere Ebenen gegliedert. Die erste ist der Wehrgang "
    "auf dem Du Dich gerade befindest." );

  AddDetail( ({ "vorsprung", "felsvorsprung" }),
    "Genau genommen ist der Wehrgang hier einfach ein Felsvorsprung, der sich "
    "um ein Loch in der Mitte zieht." );

  AddDetail( ({ "loch", "mitte" }),
    "Durch das grosse Loch in der Mitte faehrt ein Aufzug in die tieferen "
    "Ebenen von Quaul." );
 
  AddDetail( ({ "aufzug" }),
    "Der Aufzug ist von einer Plattform in der Mitte aus besteigbar. Er "
    "faehrt in die unteren Ebenen von Quaul und ist der einzige Zugang "
    "zur Stadt." );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus Steinplatten. Ab und zu erkennst Du etwa zwergen"
    "grosse Metalltueren in ihnen. Ausserdem befinden sich Fackelhalter mit "
    "Fackeln an ihnen um die Stadt zu erhellen." );

  AddDetail( ({ "tueren", "tuer", "metalltueren" }),
    "Hinter diesen Metalltueren verbergen sich vermutlich Versorgungsgaenge, "
    "durch die die Wuestenzwerge schnell Verstaerkung hier her schicken "
    "koennen." );

  AddDetail( ({ "metall", "eisen" }),
    "Es duerfte sich um robustes Eisen handeln." );

  AddDetail( ({ "feinde", "feind" }),
    "Als Feind der Stadt hast Du es hier sicher nicht leicht." );

  AddDetail( ({ "eingang" }),
    "Dieser Wehrgang ist der Eingang zur Stadt der Wuestenzwerge." );

  AddDetail( ({ "plattform" }),
    "Die Plattform mit dem Aufzug befindet sich genau in der Mitte des Lochs. "
    "Sie ist von zwei Stegen im Westen und Osten zu erreichen." );

  AddDetail( ({ "zugang", "moeglichkeit" }),
    "Der Aufzug ist die einzige Moeglichkeit in die Stadt zu gelangen." );

  AddDetail( ({ "versorgungsgaenge" }),
    "Hinter diesen Metalltueren verbergen sich Versorgungsgaenge um schnell "
    "Verstaerkung hier herauf zu befoerdern." );

  AddDetail( ({ "verstaerkung" }),
    "Es ist sicher nicht einfach hier durch zu gelangen, wenn man ein Feind "
    "der Wuestenzwerge ist." );

  AddDetail( ({ "stegen", "stege", "steg" }),
    "Zwei schmale Stege fuehren zur Plattform des Aufzugs. Einer ganz im Osten "
    "und einer ganz im Westen." );

  AddDetail( ({ "fackeln", "fackelhalter", "halter" }),
    "Die Fackeln erhellen die Stadt." );
}
