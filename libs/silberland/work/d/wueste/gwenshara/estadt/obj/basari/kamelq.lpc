#include "../def.h"

inherit "std/thing";

#include <properties.h>

int stat;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  stat=0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Ja was is denn das?" );
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Kamel-Questchen");
  SetProp(P_GENDER, MALE);
  AddId("\nkamel_quest");

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_AUTOLOADOBJ, 1);
}

int QueryStat()
{
  return stat;
}

void SetStat(int i)
{
  stat=i;
}
