// Leihgabe von Undzack

inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create( ({ "schluerf", "schluerfe" }) );

  AddId( ({ "vielbeere", "zuvielbeere", "beere", "kuegelchen", "kugel" }) );
  AddDetail( ({ "kuegelchen", "kugel" }), 
	   "Diese Kuegel scheint schon zu viel des Guten.\n"
	   "Im Volksmund wird diese Pflanze auch Zuvielbeere genannt" );
  AddDetail( ({ "blatt", "blaetter"}), 
	    "Die fleischigen Blaetter sehen im Gegensatz zu der Beere essbar aus." );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Vielbeere");


  SetProp(P_SHORT, "Eine Vielbeere");
  SetProp(P_LONG,  "Das hier ist eine Vielbeere. Die schwarze grosse Kuegel "
		  "wird von vier runden Blaettern eingefasst.");

  SetProp(P_WEIGHT, 50);       
  SetProp(P_VALUE, 500);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );      

  SetProp(P_SMELL,
      "Die Vielbeere stinkt leicht nach vergohrenen Bananen.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ -20,0 }), 
         F_SOAK    : 5,         
         F_DRINK   : 5,         
         F_ALCOHOL : 5,         
         F_POISON  : 5,        
         F_MSG     : "Du steckst Dir die Vielbeere in den Mund.\nDas war "
	             "zuviel! Starke Uebelkeit ueberkommt dich.",
         F_MSG_ROOM: "schluerft eine Beere und wird gruen.",
         F_VERB    : "schluerfen"    
      ]) );                     

  AddCmd( ({"esse", "ess", "iss"}), "blatt");
}

int blatt(string str)
{
  if (!str || str=="" )
    return 0;

  if (str == "vielbeere" || str == "beere" || str == "kuegelchen" || str == "kugel")
  {
    TP->command_me("schluerfe vielbeere");
    return 1;
  }

  if (str == "blatt" || str == "blaetter")
  {
    if(!(TP->eat_food(5))) return -1;

    TP->AddHp(20);
    TP->AddPoison(-3);
    write(BS("Du rupfst die Blaetter aus und stopfst sie Dir in den Mund. "
	     "Dabei zerplatzt die Vielbeere und Du wirfst sie fort. "
	     "Verbluefft merkst du, dass das Gruenzeug eine belebende und "
	     "heilende Wirkung hat."));
    say(TPN+" stopft sich Blaetter in den Mund.\n"
        +TPN+" wirkt erfrischt.\n");

    remove();
    return 1;
  }

  return 1;
}
