#include "../def.h"

inherit "std/transport";

#define STATION_BASAR  GLEISEROOM "a1_gleise"
#define STATION_STADT  GLEISEROOM "l3_gleise"
#define FAHRER_ID                 "\nwz_fahrer"
#define UEBERFALL_ROOM GLEISEROOM "h3_gleise"

void create()
{
  ::create();

//-------------------------------------------------------------------------
// Beschreibung von Innen
//-------------------------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Wagen");
  SetProp(P_INT_LONG,
    "Du sitzt hier auf einem wuestenzwergischen Fahrwagen. Er faehrt auf "
    "Gleisen unter Dir durch das unterirdische Gangsystem der Zwerge. "
    "Vier Raeder sind an einer Holzplatte befestigt, auf der sich die Sitze "
    "befinden. Ein kleines metallenes Gelaender bewahrt Dich davor von dem "
    "Wagen zu fallen. Eine Laterne erleichtet das Gefaehrt."
  );

  AddDetail( ({ "wagen", "fahrwagen" }),
    #'long );

  AddDetail( ({ "gleise", "gleisen" }),
    "Die Gleise sind unter dem Wagen." );

  AddDetail( ({ "gang", "gangsystem" }),
    "Der Wagen ratter durch das Gangsystem hier unten." );

  AddDetail( ({ "zwerge", "wuestenzwerg", "stadt" }),
    "Dieser Fahrwagen verkehrt zwischen dem Basar und der Stadt der Wuestenzwerge." );

  AddDetail( ({ "raeder" }),
    "Die metallenen Raeder stehen auf den Gleisen." );

  AddDetail( ({ "platte", "holzplatte", "boden" }),
    "Die Holzplatte bildet den Boden des Wagens." );

  AddDetail( ({ "sitze", "sitz" }),
    "Es gibt insgesamt fuenf Sitze hier, auf denen die Passagiere sitzen koennen." );

  AddDetail( ({ "gelaender" }),
    "Ohne dieses Gelaender wuerdest du bei der ersten Kurve vom Wagen fallen." );

  AddDetail( ({ "laterne" }),
    "Eine kleine, schmiedeeiserne Laterne erhellt den Wagen." );

  AddDetail( ({ "basar" }),
    "Der Wagen haelt beim Basar." );

  AddDetail( ({ "passagiere" }),
    "Du bist einer dieser Passagiere." );

//-------------------------------------------------------------------------
// Beschreibung von Aussen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein wuestenzwergicher Fahrwagen");
  SetProp(P_LONG,
    "Mit diesem Wagen kannst Du durch das Gangsystem der Wuestenzwerge "
    "rasen. Es gibt insgesamt fuenf Sitze."
  );

  AddId( ({"wagen", "fahrwagen", "\nwz_wagen"}) );

  SetProp(P_NAME, "Wagen");
  SetProp(P_NAME_ADJ, ({"wuestenzwergisch"}) );
  AddAdjective( ({"wuestenzwergischer","wuestenzwergisch","wustenzwergischem"
                 ,"wuestenzwerguisches","wuestenzwergische"}) );

  SetProp(P_GENDER, MALE);

  SetProp(P_LIGHT, 1);      
  SetProp(P_TRANSPARENT,1); 

  SetProp(P_DEPARTMSG, ({ 
    "Der Fahrer loest die Bremse und der Wagen rollt los.\n",
    "Mit einem metallenen Kreischen rollt der Wagen los.\n"}));

  SetProp(P_ARRIVEMSG, ({ 
    "Ein Ruck geht durch den Wagen, als er mit einem dumpfen Knall gegen den "
    "Bremsbock stoesst.\n",
    "Ein Wagen rollt auf den Schienen herein und stoesst mit einem dumpfen "
    "Knall gegen den Bock.\n"}));

  SetProp(P_ENTERMSG, ({
    "klettert in den Wagen",
    "klettert in den Wagen und setzt sich auf einen Sitz"}));

  SetProp(P_MAX_PASSENGERS, 6);

  SetProp(P_ENTERFAIL,
    BS("Es sind bereits alle fuenf Sitze des Wagens besetzt!"));

  SetProp(P_LEAVEMSG, ({
    "klettert aus dem Wagen",
    "klettert aus dem Wagen"}));

  SetProp(P_LEAVEFAIL,
    "Der Wagen rast gerade mit moerderischer Geschwindigkeit durch die Gaenge!\n");

  AddCmd( ({"betret","betrete","betritt"}), "cmd_betreten");
  AddCmd( ({"verlasse", "verlass"}),        "cmd_verlassen");

  // Die Reiseroute
  AddRoute(STATION_BASAR,
     30,
     20,
     "beim Basar der Wuestenzwerge", 
     ({"basar","basari", "mada basari"}),
     "zum Basar der Wuestenzwerge");

  AddMsg(BS("Der Wagen gewinnt langsam an Geschwindigkeit."), 5);

  AddMsg(BS("Der Wind pfeift Dir um die Ohren, als sich der Wagen der ersten Kurve naehert."), 7);

  AddMsg(BS("Ploetzlich kreischen die Raeder auf, als sich der Wagen in die Kurve legt."), 3);

  AddMsg(BS("Weiter den Tunnel entlang wird es heller, ob das schon die Stadt ist?"), 4);

  AddMsg(BS("Rumpelnd rattert der Wagen ueber eine Bruecke in einer grossen, hellen Hoehle."), 2);

  AddMsg(BS("Ihr lasst die Bruecke hinter euch."), 3);

  AddMsg(BS("Du wirst wild hin und her geschleudert, als der Wagen mehrere Kurven hintereinander faehrt."), 5);

  AddFun("ueberfall", 2);

  AddMsg(BS("Mit einem Ruck zieht der Fahrer die Bremse an. Funken spruehen und die Bremsen kreischen!"), 3);

  AddMsg(BS("Der Wagen wird rasch langsamer."), 3);

  AddRoute(STATION_STADT, 30, 20, "bei der Stadt der Wuestenzwerge", ({"stadt"}), "zur Stadt");

  AddMsg(BS("Ruettelnd gewinnt der Wagen Geschwindigkeit."), 5);

  AddMsg(BS("Du wirst ordentlich durchgeschuettelt, als der Wagen eine Reihe von Kurven durchfaehrt."), 4);

  AddFun("ueberfall", 2);

  AddMsg(BS("Du siehst einen hellen Fleck, der immer groesser wird."), 3);

  AddMsg(BS("Ploetzlich rast ihr ueber eine Bruecke ueber einen hellen See."), 2);

  AddMsg(BS("Mit einem Rauschen taucht der Wagen wieder in die Dunkelheit ein."), 4);

  AddMsg(BS("Die Raeder spruehen Funken, als sich der Wagen in eine steile Kurve legt."), 3);

  AddMsg(BS("Hektisch zieht der Fahrer die Bremse an."), 3);

  AddMsg(BS("Funkenspruehend greifen die Bremsen."), 3);

  AddMsg(BS("Der Wagen verliert rasch an Geschwindigkeit."), 3);

  AddItem(GLEISENPC "fahrer", REFRESH_DESTRUCT);
}


void reset()
{
  object ob;
  ::reset();
  if(!present(FAHRER_ID, TO))
  {
    ob = clone_object(GLEISENPC "fahrer");
    ob->move(TO, M_GO|M_NOCHECK);
  }    
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(!str || str == "") return 0;
  if(id(str)) return Enter();

  return 0;
}

int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(!str || str == "") return 0;

  if(id(str)) return Leave();

  return 0;
}

void init()
{
  ::init();
 
  catch(call_other(STATION_BASAR, "???"));
  catch(call_other(STATION_STADT, "???"));

  // Erst starten, wenn ein Fahrer da ist
  if(TP->id(FAHRER_ID))
    Start();
}

// Der Wagen kann ueberfallen werden
void ueberfall()
{
  object *passagiere;
  int i;
  if(call_other(UEBERFALL_ROOM, "QueryUeberfall")) return;
  if(random(10)) return;

  tell_room(TO, BS("Ploetzlich rattert der Wagen und kippt mit einem Mal um!"));

  passagiere = filter_array(all_inventory(TO), #'interactive);
  for(i=0;i<sizeof(passagiere);++i)
  {
    passagiere[i]->move(UEBERFALL_ROOM, M_GO|M_NOCHECK);
  }

  if(sizeof(passagiere)>0) call_other(UEBERFALL_ROOM, "Ueberfall");
}
