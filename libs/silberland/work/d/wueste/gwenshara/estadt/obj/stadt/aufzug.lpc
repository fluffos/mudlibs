#include "../def.h"

inherit "std/transport";

#define EBENE1 STADTROOM "1e2_plattform"
#define EBENE2 STADTROOM "2b3_aufzug"
#define EBENE3 STADTROOM "3f2_aufzug"
#define EBENE4 STADTROOM "4b3_aufzug"

void create()
{
  ::create();

//-------------------------------------------------------------------------
// Beschreibung von Innen
//-------------------------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Aufzug");
  SetProp(P_INT_LONG,
    "Dieser Aufzug hat sehr viel Aehnlichkeit mit einem Vogelkaefig. Der "
    "Boden besteht aus Holzbrettern, die aneinander genagelt wurden. Die "
    "Waende und die Decke werden von Gittern gebildet, die verhindern sollen, "
    "dass Du rausfaellst. Er ist gross genug fuer zwei Fuhrwerke."
  );

  AddDetail( ({ "aufzug" }),
    "Du befindest Dich hier im Aufzug." );

  AddDetail( ({ "aehnlichkeit", "kaefig", "vogelkaefig" }),
    "Dieser Aufzug hat sehr viel Aehnlichkeit mit einem Vogelkaefig und Du "
    "bist der Vogel." );

  AddDetail( ({ "boden", "bretter", "holzbretter", "holzbrettern" }),
    "Der Boden besteht aus aneinander genagelten Holzbrettern." );

  AddDetail( ({ "waende", "wand", "decke" }),
    "Die Waende und Decke bestehen aus Gitterstaeben, wie bei einem Vogelkaefi"
    "g. An einer Stelle in dem Gitter befindet sich eine Tuer." );

  AddDetail( ({ "gitter", "staebe", "gitterstaebe", "gittern" }),
    "Die eisernen Gitterstaebe bilden die Waende des Aufzugs." );

  AddDetail( ({ "vogel" }),
    "Du bist der Vogel in diesem Kaefig." );

  AddDetail( ({ "tuer", "gittertuer" }),
    "Durch eine Gittertuer kannst Du den Aufzug betreten oder verlassen." );

  AddDetail( ({"fuhrwerk"}),
    "Zwei Fuhrwerke wuerden problemlos hier herein passen.");

//-------------------------------------------------------------------------
// Beschreibung von Aussen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein Aufzug");
  SetProp(P_LONG,
    "Dieser Aufzug faehrt alle Ebenen der Stadt ab. Er hat sehr viel "
    "Aehnlichkeit mit einem riesigen Vogelkaefig."
  );

  AddId( ({"aufzug","\nwz_aufzug"}) );

  SetProp(P_NAME, "Aufzug");
  SetProp(P_GENDER, MALE);

  SetProp(P_LIGHT, 1);
  SetProp(P_TRANSPARENT,1);

  SetProp(P_DEPARTMSG, ({
    "Ein Aechzen ertoent und der Aufzug setzt sich in Bewegung.\n",
    "Mit einem lauten Aechzen beginnt sich der Aufzug zu bewegen.\n"}));

  SetProp(P_ARRIVEMSG, ({
    "Der Aufzug kommt auf @@QueryArrived@@ an.\n",
    "Ein Aufzug kommt langsam herein und haelt an.\n"}));

  SetProp(P_ENTERMSG, ({
    "betritt den Aufzug",
    "betritt den Aufzug"}));

  SetProp(P_MAX_PASSENGERS, 10);

  SetProp(P_ENTERFAIL,
    BS("Es ist kein Platz mehr im Aufzug!"));

  SetProp(P_LEAVEMSG, ({
    "verlaesst den Aufzug",
    "verlaesst den Aufzug"}));

  SetProp(P_LEAVEFAIL,
    BS("Der Aufzug bewegt sich gerade. Es waere unklug ihn jetzt zu "
       "verlassen."));

  AddCmd( ({"betret","betrete","betritt"}), "cmd_betreten");
  AddCmd( ({"verlasse", "verlass"}),        "cmd_verlassen");

  // Die Reiseroute
  AddRoute(EBENE1,
     30,
     20,
     "dem Wehrgang",
     ({"wehrgang", "ebene 1", "erste ebene"}),
     "zum Wehrgang");

  AddMsg(BS("Der Aufzug gleitet durch das Loch in die Tiefe."), 2);

  AddMsg(BS("Unter Dir kannst Du schon die Stadt erkennen."), 2);

  AddMsg(BS("Langsam senkt sich der Aufzug weiter."), 2);

  AddMsg(BS("Die Geschaeftsebene ist gleich erreicht."), 2);

  AddRoute(EBENE2,
     30,
     20,
     "der Geschaeftsebene",
     ({"geschaeftsebene", "ebene 2", "zweite ebene"}),
     "zur Geschaeftsebene");

  /*AddMsg(BS("Sanft schwebt der Aufzug tiefer durch das Loch im Boden."), 2);

  AddMsg(BS("Die Felswaende fahren an Dir vorbei."), 2);

  AddMsg(BS("Ein riesiger Felsbrocken faehrt an Dir vorbei. Er dient wohl as "
	    "Gegengewicht."), 2);

  AddMsg(BS("Der Aufzug naehert sich der naechsten Station."), 2);

  AddRoute(EBENE3,
     30,
     20,
     "der Vergnuegungsebene",
     ({"vergnuegungsebene", "ebene 3", "dritte ebene"}),
     "zur Vergnuegungsebene");*/

  AddMsg(BS("Knirschend gleitet der Aufzug durch das Loch im Boden."), 2);

  AddMsg(BS("Der Aufzug wackelt leicht als er tiefer sinkt."), 2);

  AddMsg(BS("*KNIRSCH* Die Gitterstaebe schaben an einer Felswand."), 2);

  AddMsg(BS("Der Kaefig gleitet durch die Luft auf die Palastebene zu."), 2);

  AddRoute(EBENE4,
     30,
     20,
     "der Palastebene",
     ({"palastebene", "ebene 4", "vierte ebene"}),
     "zur Palastebene");

 /* AddMsg(BS("Der Aufzug beginnt aufzusteigen."), 2);

  AddMsg(BS("Beschwingt naehert sich der Aufzug dem Loch in der Decke."), 2);

  AddMsg(BS("Knirschend faehrt der Aufzug in die naechste Ebene."), 2);

  AddMsg(BS("Der Aufzug wird langsamer und die Vergnuegungsebene taucht vor "
         "Dir auf."), 2);

  AddRoute(EBENE3,
     30,
     20,
     "der Vergnuegungsebene",
     ({"vergnuegungsebene", "ebene 3", "dritte ebene"}),
     "zur Vergnuegungsebene");*/

  AddMsg(BS("Wackelnd hebt sich der Aufzug an."), 2);

  AddMsg(BS("Durch ein Loch in der Hoehlendecke geht es auf die "
	    "naechste Ebene zu."), 2);

  AddMsg(BS("Langsam taucht die Geschaeftsebene vor Deinen Augen auf."), 2);

  AddRoute(EBENE2,
     30,
     20,
     "der Geschaeftsebene",
     ({"geschaeftsebene", "ebene 2", "vierte ebene"}),
     "zur Geschaeftsebene");

  AddMsg(BS("Quietschend setzt sich der Aufzug wieder in Bewegung."), 2);

  AddMsg(BS("Leise gleitet der Aufzug weiter nach oben."), 2);

  AddMsg(BS("Du tauchst kurz in einen dunklen Tunnel ein."), 2);

  AddMsg(BS("Es wird heller, als Du Dich der Plattform des Wehrgangs "
	    "naeherst."), 2);

  AddItem(STADTNPC "aufzugwache", REFRESH_DESTRUCT);

  Start();
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(!str || str == "") return 0;
  if(id(str)) return Enter();

  return 0;
}

int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(!str || str == "") return 0;

  if(id(str)) return Leave();

  return 0;
}

void init()
{
  ::init();

  catch(call_other(EBENE1, "???"));
  catch(call_other(EBENE2, "???"));
  //catch(call_other(EBENE3, "???"));
  catch(call_other(EBENE4, "???"));
}
