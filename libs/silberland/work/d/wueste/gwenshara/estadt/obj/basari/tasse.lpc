#include "../def.h"

inherit "std/thing";

int heal, full;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  heal=0;
  full=0;
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Porzellantasse");
  SetProp(P_LONG,
    "Das ist eine waschechte Porzellantasse. Aus ihr kann man Kakao oder Tee "
    "trinken. Du kannst kleine und grosse Schlucke aus ihr trinken.\n@@info@@"
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Tasse");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tasse", "porzellantasse", "\nbasari_tasse"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CERAMIC );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 5);
  SetProp(P_VALUE, 30);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  AddCmd( ({"trink", "trinke"}), "cmd_trink");
}

string info()
{
  switch(full)
  {
    case 5: return "Die Tasse ist komplett mit Kakao angefuellt.";
	    break;
    case 4: return "Es wurde schon ein Wenig vom Kakao getrunken.";
	    break;
    case 3: return "Die Tasse ist nur mehr halbvoll mit Kakao.";
	    break;
    case 2: return "Ein Wenig Kakao ist noch in der Tasse.";
	    break;
    case 1: return "Ein kleiner Schluck ist noch in der Tasse.";
	    break;
    default: return "Die Tasse ist komplett leer.";
  }
}


int cmd_trink(string str)
{
  notify_fail("Moechtest Du einen grossen oder einen kleinen Schluck trinken?\n");
  if(str == "aus tasse" ||
     str == "aus porzellantasse" ||
     str == "schluck aus tasse" ||
     str == "schluck aus porzellantasse"||
     str == "kakao" ||
     str == "tasse" ) return 0;  

  notify_fail("Was moechtest Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "kleinen schluck aus tasse" ||
       str == "grossen schluck aus tasse" )) return 0;

  notify_fail("Die Tasse ist doch leer!\n");
  if(full < 0) return 0;

  TP->Message(BS("Du trinkst einen Schluck Kakao aus der Tasse. "+
	           "Aaaahhhh! Das schmeckt herrlich!"));
   ENV(TP)->Message(BS(TPN+" trinkt einen Schluck Kakao."), MSGFLAG_NO_TP);

  if(str == "kleinen schluck aus tasse")
  {
    TP->AddHp(heal);
    full--;
  }
  else if(str == "grossen schluck aus tasse")
  { 
    if(full<2)
    {
      write(BS("Fuer einen grossen Schluck ist zu Wenig Kakao in der Tasse."));
    }
    TP->AddHP(heal*2);
    full-=2;
  }
  else
  {
   write("So geht das nicht!\n");
  }

  if(full<=0) SetProp(P_SHORT, "Eine Porzellantasse");
  return 1;
}

void Fill()
{
  if(!PO) return;
  if(strstr(file_name(PO), BASARIROOM "kneipe_zelt")!=0) return;
  
  SetProp(P_SHORT, "Eine Porzellantasse (mit Kakao gefuellt)");
  heal=random(9)+1;
  full=5;  
}

varargs int move(mixed dest, int method)
{
  int ret;
  ret = ::move(dest, method);
  call_out("check", 0);
  return ret;
}

void check()
{
  object *ob;
  if(!living(ENV(TO))) return;
  ob=filter_objects( deep_inventory(ENV(TO)), "id", "\nbasari_tasse");
  ob-=({TO});
  if(sizeof(ob) == 0) return;

  if(ENV(ME))
  {
    tell_object(ENV(ME), BS("Da Du schon eine Tasse hast, "
			    "laesst Du sie in Ruhe."));
  }
  TO->move(ENV(ENV(TO)), M_NOCHECK);
}
