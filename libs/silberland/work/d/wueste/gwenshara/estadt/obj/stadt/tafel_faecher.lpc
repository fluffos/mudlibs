#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Hinweistafel");
  SetProp(P_LONG,
    "Diese Hinweistafel ist relativ gross und aus blankem Gold mit silbernen "
	"Einlagen als Schrift. Du kannst sie lesen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hinweistafel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tafel","hinweistafel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 1);

  AddCmd( ({ "lies", "lese", "les" }), "cmd_lesen");
}

int cmd_lesen(string str)
{
  notify_fail("Was willst Du lesen?\n");
  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  write("Du kannst Dir hier Dein eigenes Schliessfach mieten, um darin\n");
  write("Gegenstaende zu lagern.\n");
  write("Pro Woche werden 10.000 Erfahrungspunkte benoetigt um das Fach\n");
  write("sicher zu versiegeln. Diese sind im voraus zu bezahlen. Wenn die\n");
  write("Mietdauer abgelaufen ist, und Du Deinen Mietvertrag nicht verlaengerst\n");
  write("werden die gelagerten Gegenstaende in der Kiste 'Zur freien Entnahme'\n");
  write("abgelegt. Fuer alle 10 Spielerstufen kannst Du einen Gegenstand\n");
  write("einlagern.\n\n");
  write("Befehle:\n");
  write("miete schliessfach         Schliesse einen Mitvertrag ab oder\n");
  write("                           verlaengere ihn\n");
  write("schau in schliessfach      Zeige das Inventar deines Schliessfachs\n");
  write("lagere <x> in schliessfach Lagere den Gegenstand im Schliessfach\n");
  write("nimm <x> aus schliessfach  Nimm den Gegenstand aus Deinem Fach\n");
  write("leere schliessfach         Nimm alle Gegenstaende aus Deinem Fach\n");
  return 1;
}
