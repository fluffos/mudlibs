// Konservierte leichen...

#include "../def.h"

inherit "std/container";

#include <properties.h>

object owner=0;
string oname="Niemand";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die mumifizerte Leiche von "+oname);
  SetProp(P_LONG,
    "Die sterblichen Ueberreste von "+oname+" wurden "
    "mumifiziert und somit haltbar gemacht.");
  SetProp(P_NAME, "Leiche von "+oname);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "mumifiziert");
  AddId( ({"leiche","ueberreste", "reste"}));
  AddAdjective( ({"mumifzierte"}) );

  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  SetProp(P_MAX_WEIGHT, 999999);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_WEIGHT_PERCENT, 100);

  SetProp(P_NOGET, "Du laesst die Leiche doch besser liegen...\n");
  SetProp(P_NOSELL, "Niemand kauft eine Leiche!\n");
  SetProp(P_NOBUY, 1);
}

void UpdateDesc()
{
  SetProp(P_SHORT, "Die mumifizerte Leiche von "+oname);
  SetProp(P_LONG,
    "Die sterblichen Ueberreste von "+oname+" wurden "
    "mumifiziert und somit haltbar gemacht.");
  SetProp(P_NAME, "Leiche von "+oname);
}

void SetOwner(object pl)
{
  if(!objectp(pl)) return;
  owner = pl;
  oname = owner->Name(WER);
  SetProp(P_WEIGHT, owner->QueryProp(P_WEIGHT));
  UpdateDesc();
}

object QueryOwner()
{
  return owner;
}

void reset() // Im Reset wird das Inventory aufgeraeumt und das objekt zerstoert
{
  object *inv;
  int i;
  ::reset();
  
  inv=all_inventory(TO);
  if(sizeof(inv))
    for(i=0; i<sizeof(inv); i++)
      inv[i]->remove(1);

  remove();
}
