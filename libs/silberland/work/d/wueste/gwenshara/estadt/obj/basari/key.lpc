#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein hoelzener Schluessel");
  SetProp(P_LONG,
    "Der Schluessel ist ganz aus Holz. Mit ihm kann man irgendwas aufsperren."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({"schluessel", "\nbasari_key"}) );
  AddAdjective( ({"hoelzener", "hoelzenen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 4);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}
