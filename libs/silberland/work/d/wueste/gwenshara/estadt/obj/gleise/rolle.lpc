#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Schriftrolle");
  SetProp(P_LONG,
    "Diese Schriftrolle besteht aus dunklem Pergament. Du kannst sie lesen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schriftrolle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rolle","schriftrolle"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  AddCmd( ({ "lies", "lese", "les" }), "cmd_lesen");
}

int cmd_lesen(string str)
{
  notify_fail("Was willst Du lesen?\n");
  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  write(" _____________________________________________ \n");
  write("(                                            ()\n");
  write("|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|\n");
  write("| Hiermit ergeht der koenigliche Befehl an   |\n");
  write("| Euch die Dienste des Drachen Krykbylkr zu  |\n");
  write("| erlangen.                                  |\n");
  write("|                                            |\n");
  write("| Sobald Ihr es erlangt habt, nutzt es um    |\n");
  write("| die Wuestenzwerge niederzuwerfen und im    |\n");
  write("| Namen von Lloth zu versklaven!             |\n");
  write("|                                            |\n");
  write("| Berichten zu Folge befindet sich der Hort  |\n");
  write("| des Drachen irgendwo in den Tunneln der    |\n");
  write("| Wuestenzwerge. Die Plaene dieser Gaenge    |\n");
  write("| sind im heiligen Tempel verwahrt.          |\n");
  write("|                                            |\n");
  write("| Um Krykbylkr zu unterjochen zeigt ihm die  |\n");
  write("| abgeschlagenen Koepfer seiner Kinder, des  |\n");
  write("| Obsidiandrachen und des Aquamarindrachen.  |\n");
  write("|                                            |\n");
  write("| Ruft die Beiden mit dem Horn eines         |\n");
  write("| gehoernten Unterweltkraken!                |\n");
  write("|                                            |\n");
  write("| Unterwuerfigst,                            |\n");
  write("| Mystixfis                                  |\n");
  write("|___________________________________________ |\n");
  write(" \\__________________________________________\\/\n");
  write("\n");
  return 1;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();

  if(!living(ENV(TO)))
    call_out("remove", 0);
}
