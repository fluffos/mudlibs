// Die Feindtafel
#include "../def.h"
#include "/d/wueste/gwenshara/estadt/basari.h"

inherit "std/thing";

#include <properties.h>

string feinde();

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tafel");
  SetProp(P_LONG,
    "Auf dieser Tafel stehen die Feinde der Wuestenzwerge. "
    "Mit <lies tafel> kannst du sie lesen." );
  SetProp(P_NAME, "Tafel");
  SetProp(P_GENDER, FEMALE);
  AddId("tafel");

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 1);

  AddReadDetail( "tafel", #'feinde);
}


string feinde()
{
  string *enemies;
  string ausgabe;
  int i;
  enemies=BASARIMASTER->QueryEnemies();
  ausgabe="";

  for(i=0; i<sizeof(enemies); i++)
  {
    ausgabe+=CAP(enemies[i]);
    if(i!=sizeof(enemies)-1)
      ausgabe+=", ";
    else
      ausgabe+=".";
  }

  write("                      INFORMATION\n\n"+
        "*) Die Basarwaechter achten darauf, dass Du keinen Unsinn anstellst.\n"+
        "   Sie werden Dich nicht toeten, aber einsperren, wenn Du jemanden angreifst\n"+
	"   oder etwas stiehlst!\n"+
	"*) Du kannst mit (fast) alles Haendlern um Waren feilschen - Doch Vorsicht! Falls\n"+
	"   Du es zu weit treibst wird das Konsequenzen haben!\n"+
	"*) Solltest Du im Kaefig am Basar gestorben sein, bekommst Du Deine Leiche sobald \n"+
	"   Du den Richter nach ihr fragst.\n\n");

  if(ausgabe == "")
    return "Momentan haben die Wuestenzwerge keine Feinde.\n";

  return BS("Die Feinde der Wuestenzwerge sind: "+ausgabe);
}
