#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Obsidianschluessel");
  SetProp(P_LONG,
    "Dieser kleine Schluessel ist aus Obsidian gefertigt. Sein Kopf sieht aus "
    "wie eine kleine Spinne. Wofuer er wohl da ist?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "schluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "schluessel", "obsidianschluessel", "\nwz_darkelfkey" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OBSIDIAN );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();

  if(!living(ENV(TO)))
    remove(0);
}
