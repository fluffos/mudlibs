inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "zimt", "gewuerz", "\nbasari_zimt"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Zimt");


  SetProp(P_SHORT, "Etwas Zimt");
  SetProp(P_LONG,  "Du erblickst etwas ungeriebenen Zimt. Nicht viel allerdings.");

  SetProp(P_WEIGHT, 10);       
  SetProp(P_VALUE, 100);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );      

  SetProp(P_SMELL,
      "Haaaaaaatschi!");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 0,0 }), 
         F_SOAK    : 3,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Du isst den Zimt. Buah! Der ist aber bitter.",
         F_MSG_ROOM: "isst etwas Zimt.",
         F_VERB    : "essen"    
      ]) );                     
  
}

