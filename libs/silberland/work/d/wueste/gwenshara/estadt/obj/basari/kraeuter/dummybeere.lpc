// Leihgabe von Undzack

inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create( ({ "schluerf", "schluerfe" }) );

  AddId( ({ "vielbeere", "zuvielbeere", "beere", "kuegelchen", "kugel" }) );
  AddDetail( ({ "kuegelchen", "kugel" }), "Diese Kuegel scheint schon zu viel des Guten.\nIm Volksmund wird diese Pflanze auch Zuvielbeere genannt" );
  AddDetail( ({ "blatt", "blaetter"}), "Die fleischigen Blaetter sehen im Gegensatz zu der Beere essbar aus." );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Vielbeere");


  SetProp(P_SHORT, "Eine Vielbeere");
  SetProp(P_LONG,  "Das hier ist eine Vielbeere. Die schwarze grosse Kuegel wird von vier runden Blaettern eingefasst.");

  SetProp(P_WEIGHT, 50);       
  SetProp(P_VALUE, 100);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );      

  SetProp(P_SMELL,
      "Die Vielbeere stinkt leicht nach vergohrenen Bananen.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ -20,0 }), 
         F_SOAK    : 5,         
         F_DRINK   : 5,         
         F_ALCOHOL : 5,         
         F_POISON  : 5,        
         F_MSG     : "Du steckst Dir die Vielbeere in den Mund.\nDas war zuviel! Starke Uebelkeit ueberkommt dich.",
         F_MSG_ROOM: "schluerft eine Beere und wird gruen.",
         F_VERB    : "schluerfen"    
      ]) );                     

  AddCmd( "iss", "blatt");
}

int blatt(string str)
{

  int food, drink, max_food, max_drink;

  if (!str || str=="" )
    return 0;

  food = TP->QueryProp(P_FOOD);
  drink = TP->QueryProp(P_DRINK);
  max_food = TP->QueryProp(P_MAX_FOOD);
  max_drink = TP->QueryProp(P_MAX_DRINK);

  if (str == "vielbeere" || str == "beere" || str == "kuegelchen" || str == "kugel")
  {
    TP->command_me("schluerfe vielbeere");
    return 1;
  }

  if (str == "blatt" || str == "blaetter")
  {
    if(food+5 > max_food){
       write("Uff. Das bekommst du nicht mehr 'runter.\n");
       return -1;
    }

    TP->AddHp(20);
    TP->SetProp(P_FOOD, food+5);
    TP->AddPoison(-5);
    write(BS("Du rupfst die Blaetter aus und stopfst sie Dir in den Mund.\nDabei zerplatzt die Vielbeere und Du wirfst sie fort.\nVerpluefft merkst du, dass das Gruenzeug eine belebende und heilende Wirkung hat.\n"));
    say(TPN+" stopft sich Blaetter in den Mund.\n"+TPN+" wirkt erfrischt.\n");

    remove();
    return 1;
  }

  return 1;
}
