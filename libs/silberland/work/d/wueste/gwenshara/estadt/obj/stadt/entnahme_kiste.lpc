#include "../def.h"

inherit "std/container";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Holzkiste");
  SetProp(P_LONG,
    "Eine einfache Kiste aus Holzlatten. Auf ihr klebt ein Zettel mit der "
    "Aufschrift 'Zur freien Entnahme'.");
  SetProp(P_NAME, "Holzkiste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kiste","holzkiste","\nfreientnahme"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Du laesst die Kiste doch besser da wo sie ist.");

  SetProp(P_MAX_WEIGHT, 999999);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_WEIGHT_PERCENT, 0);
}

int query_weight_contents(){return 0;}

