inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "zucker", "beutelchen", "\nbasari_zucker"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Zucker");


  SetProp(P_SHORT, "Ein Beutelchen mit Zucker");
  SetProp(P_LONG,  "In einem kleinen Beutelchen, das in Deiner Hand liegt, befindet sich "
		  "eine kleine Menge Zucker. Dieses weisse, suesse Zeugs, das man zum herstellen "
		  "von Keksen oder Kuchen braucht.");

  SetProp(P_WEIGHT, 50);       
  SetProp(P_VALUE, 300);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 50, MAT_SILK:30, MAT_MISC_FOOD:20 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5,5 }), 
         F_SOAK    : 6,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Du naschst den Zucker aus dem Beutelchen und wirfst es dann fort.",
         F_MSG_ROOM: "nascht etwas Zucker aus einem Beutelchen.",
         F_VERB    : "essen"    
      ]) );                     
  
}

