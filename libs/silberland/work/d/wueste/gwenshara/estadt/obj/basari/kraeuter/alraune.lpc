// Leihgabe von Hasibaerchi

inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "alraune", "kraut" }) );
  AddDetail( ({ "koerper" , "form" }),
	   "Die Alraune scheint einen Torso, zwei Beine und zwei "
	   "Arme zu besitzen. Die Wurzelenden wirken wie lange Finger." );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Alraune");


  SetProp(P_SHORT, "Eine Alraune");
  SetProp(P_LONG,
    "Das hier ist eine Alraune. Die schrumpelige Form erinnert "
    "an einen nackten menschlichen Koerper.");

  SetProp(P_WEIGHT, 50);       
  SetProp(P_VALUE, 300);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );      

  SetProp(P_SMELL,
      "Ih! Die riecht ja nach Magierpisse!");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ -10,10 }), 
         F_SOAK    : 12,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 2,        
         F_MSG     : "Du wuergst die Alraune hinunter!",
         F_MSG_ROOM: "wird gruen.",
         F_VERB    : "essen"    
      ]) );                     
}
