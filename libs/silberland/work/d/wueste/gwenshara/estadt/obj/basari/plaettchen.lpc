#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein rosa Mosaikplaettchen");
  SetProp(P_LONG,
    "Dieses rosa Plaettchen ist nicht sehr gross. Es fuehlt sich seifig oder "
    "schmierig an. Man kann damit sicher Etwas machen." );
  SetProp(P_INFO, "Dir kommt die Idee, dass Du das Plaettchen in den Trinkbrunnen "
    "am Basar hineinwerfen koenntest.");
  SetProp(P_NAME, "Plaettchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"plaettchen","\nplaettchen","plaettchen","mosaikplaettchen"}));

  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

  AddDetail("etwas",
	    "Du hast keine Ahnung was man damit machen kann.");
  AddDetail("ahnung",
	    "Wahrscheinlich muss man es genauer mustern.");

}
