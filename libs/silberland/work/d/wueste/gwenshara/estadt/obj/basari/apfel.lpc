inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

int stat;

void create()
{
  if (!is_clone(this_object()))
    return;

  ::create( ({ "iss", "esse", "ess" }) );

  AddId( ({ "apfel","frucht" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Apfel");


  SetProp(P_SHORT, "Ein Apfel");
  SetProp(P_LONG,  "Der Apfel ist reif, rot und sieht richtig lecker aus. Am "
          "liebsten wuerdest Du ihn sofort aufessen.");

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );

  SetProp(P_SMELL,
      "Der Geruch des Apfels ist wunderbar... Er scheint sehr saftig zu sein.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5,5 }),
         F_SOAK    : 3,
         F_DRINK   : 3,
         F_ALCOHOL : 0,
         F_POISON  : 0,
         F_MSG     : "Du knabberst den Apfel ab.",
         F_MSG_ROOM: "knabbert einen Apfel ab.",
         F_VERB    : "essen"
      ]) );

  AddCmd( ({"fuetter","fuettere"}), "cmd_feed");
}

int cmd_feed(string str)
{
  string wen;
  object kamelquest;

  notify_fail("Wen moechtest womit fuettern?\n");
  if(!str) return 0;
  wen="";
  if(sscanf(str, "%s mit apfel", wen) != 1) return 0;
  if(wen == "kamel")
  {
    if(!present("\nbasarikamel", ENV(TP)))
    {
      write("Hier ist kein Kamel.\n");
      return -1;
    }

    kamelquest = present("\nkamel_quest", TP);

    if(!(present("\nbasarikamel", ENV(TP))->QueryOwner() == TP))
    {
      write("Nimm Dein eigenes Kamel!\n");
      return -1;
    }

    if(objectp(kamelquest)) {
      stat=kamelquest->QueryFlag(1);
      kamelquest->SetFlag(1);
    }

    TP->Message("Du fuetterst Deinem Kamel den Apfel.\n");
    BASARIMASTER->Msg(TPN+" fuettert sein Kamel.\n");
    ENV(TP)->Message(TPN+" fuettert das Kamel mit einem Apfel.\n");
    ENV(TP)->Message("Das Kamel sieht nun satt aus.\n", MSGFLAG_VISUAL);
    remove(1);
    return 1;
  }

  if(!present(wen, ENV(TP)))
  {
    write(CAP(wen)+" ist doch gar nicht hier.\n");
    return -1;
  }

  if(find_player(wen)->eat_food(3))
  {
    if(!find_player(wen)->eat_food(5, 1))
      return write(BS(CAP(wen)+" kriegt den Apfel nicht mehr runter.")), -1;
    
    TP->Message("Du fuetterst "+CAP(wen)+" mit dem Apfel.\n");
    ENV(TP)->Message(TPN+" fuettert "+CAP(wen)+" mit einem Apfel.\n", MSGFLAG_NO_TP, ([MSGFLAG_EXCLUDE:({TP,find_player(wen)})]));
    find_player(wen)->Message(TPN+" fuettert Dich mit einem Apfel.\n");
    find_player(wen)->heal_self(5);
    
    remove(1);
    return 1;
  }

  TP->Message(CAP(wen)+" kann das nicht mehr essen.\n");
  return -1;
}
