#include "../def.h"

inherit "std/thing";

#include <properties.h>

int ausgerollt;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  ausgerollt=0;

  SetProp(P_SHORT, "Ein Teppich (zusammengerollt)");
  SetProp(P_LONG,
    "Dieser wunderbar weiche Teppich wurde eindeutig von Wuestenelfen "
    "hergestellt. Er ist aus Kamelhaar gefertigt und bietet sich richtig "
    "zum Hineinkuscheln an. Auf der Rueckseite traegt er die Insignien RW. "
    "Man kann ihn zusammen rollen und ausrollen." );
  SetProp(P_INFO, "Auf der Rueckseite traegt er die Insignien RW");
  SetProp(P_NAME, "Teppich");
  SetProp(P_GENDER, MALE);
  AddId( ({"teppich","\nteppich"}) );

  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"rollen","rolle"}), "cmd_rollen");

}
  

int cmd_rollen(string str){
  notify_fail("Was willst zu wie rollen?\n");

  if(!str || str == "") return 0;
  if(!(str == "teppich zusammen" ||
       str == "teppich aus"      ||
       str == "teppich auf"      ));

  if(str == "teppich zusammen"){
    if(!ausgerollt)
    {
      write("Der Teppich ist bereits zusammengerollt!\n");
      return -1;
    }
    write("Du rollst den Teppich zusammen.\n");
    say(TPN+" rollt einen Teppich zusammen.\n");

    SetProp(P_SHORT, "Ein Teppich (zusammengerollt)");
    SetProp(P_NOGET, 0);
    ausgerollt=0;
    return 1;
  }
  else if(str == "teppich aus" || str == "teppich auf"){
    if(ausgerollt)
    {
      write("Der Teppich ist bereits ausgerollt!\n");
      return -1;
    }
    write("Du rollst den Teppich auf.\n");
    say(TPN+" rollt einen Teppich aus.\n");

    SetProp(P_SHORT, "Ein Teppich verziert die Landschaft");
    SetProp(P_NOGET, "Ein ausgerollter Teppich ist schwer zu tragen.\n");
    write("Du legst den Teppich ab.\n");
    say(TPN+" legt einen Teppich ab.\n");
    TO->move(ENV(TP), M_NOCHECK);
    ausgerollt=1;
    return 1;
  }

  return 0;
}
