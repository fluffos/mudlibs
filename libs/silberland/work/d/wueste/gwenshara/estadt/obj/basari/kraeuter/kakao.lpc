inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "kakao", "doeschen", "dose", "\nbasari_kakao"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Doeschen mit Kakao");


  SetProp(P_SHORT, "Ein kleines Doeschen mit Kakao");
  SetProp(P_LONG,  "In dem kleinen, silbernen Metalldoeschen befindet sich ein wenig Kakao. "
		   "Von dem braunen Pulver ist genau genug da um eine Tasse zu machen.");

  SetProp(P_WEIGHT, 100);       
  SetProp(P_VALUE, 500);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 50, MAT_MISC_METAL:30, MAT_MISC_FOOD:20 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 0,0 }), 
         F_SOAK    : 2,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Du isst das Kakaopulver auf...\nVielleicht haettest Du es vorher aufkochen sollen?",
         F_MSG_ROOM: "ist Kakaopulver.",
         F_VERB    : "essen"    
      ]) );                     
  
}

