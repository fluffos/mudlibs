// Leihgabe von Undzack

inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create( ({ "schluerf", "schluerfe" }) );

  AddId( ({ "zweibeere", "beere", "kuegelchen", "kugel" }) );
  AddDetail( ({ "kuegelchen", "kugel" }), 
	    "Dieses Kuegelchen zu schluerfen ist sicher ein Genuss." );
  AddDetail( ({ "blatt", "blaetter"}), 
	    "Die fleischigen Blaetter sehen nicht essbar aus." );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Zweibeere");


  SetProp(P_SHORT, "Eine Zweibeere");
  SetProp(P_LONG,  "Das hier ist eine saftige Zweibeere. Das orange "
		   "schillernde Kuegelchen wird von vier großen runden "
		   "Blaettern eingefasst.");

  SetProp(P_WEIGHT, 50);       
  SetProp(P_VALUE, 100);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 100 ]) );      

  SetProp(P_SMELL,
      "Die Zweibeere ist geruchlos.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,0 }), 
         F_SOAK    : 2,         
         F_DRINK   : 2,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Du steckst Dir die Zweibeere in den Mund und "
	             "schlürfst sie vom Stengel.\n Dann wirfst Du das "
		     "Gruenzeug weg.",
         F_MSG_ROOM: "schluerft eine Beere.",
         F_VERB    : "schluerfen"    
      ]) );                     

  AddCmd( ({"esse", "ess", "iss"}), "blatt");
}

int blatt(string str)
{
  if (!str || str=="" )
    return 0;
  
  if (str == "zweibeere" || str == "beere" || str == "kuegelchen" || str == "kugel")
  {
    TP->command_me("schluerfe zweibeere");
    return 1;
  }

  if (str == "blatt" || str == "blaetter")
  {
    if(!(TP->eat_food(5))) return -1;
    if(!(TP->drink_drink(5))) return -1;

    TP->AddPoison(3);
    TP->AddHp(-5);
    write(BS("Du rupfst die Blaetter aus und stopfst sie Dir leichtsinnig "
	     "in den Mund. Dabei zerplatzt die Zweibeere und Du wirfst sie "
	     "fort. Leichte Uebelkeit ueberkommt dich.\n"));
    say(TPN+" stopft sich Blaetter in den Mund.\n");
    say(TPN+" wird kurz gruen im Gesicht.\n");

    remove();
    return 1;
  }

  return 1;
}
