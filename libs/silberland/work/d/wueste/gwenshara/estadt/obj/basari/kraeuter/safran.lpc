inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "safran", "\nbasari_safran"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Safranfaeden");


  SetProp(P_SHORT, "Ein paar Safranfaeden");
  SetProp(P_LONG,  "Du haelst ein paar laecherliche Safranfaeden in der Hand. Und dafuer hat "
		  "man so viel Geld bezahlt?");

  SetProp(P_WEIGHT, 10);       
  SetProp(P_VALUE, 700);         
  SetProp(P_MATERIAL,
      ([ MAT_PLANT: 50, MAT_MISC_METAL:30, MAT_MISC_FOOD:20 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 3,3 }), 
         F_SOAK    : 2,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Du isst die Safranfaeden... einfach nur eklig.",
         F_MSG_ROOM: "ist Safranfaeden.",
         F_VERB    : "essen"    
      ]) );                     
  
}

