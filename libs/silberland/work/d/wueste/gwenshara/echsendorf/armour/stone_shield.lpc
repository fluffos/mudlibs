#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Steinschild");
  SetProp(P_LONG,
    "Der Schild ist einem Rundschild nachempfunden. Er besteht vollkommen "
    "aus Stein. Er ist rauh, als waere er einfach aus dem "
    "Gestein geschlagen worden und bietet nur einen Griff zum Halten an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Steinschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "steinschild", "\ngwenshara_sshield"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 27);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:23]) );
}
