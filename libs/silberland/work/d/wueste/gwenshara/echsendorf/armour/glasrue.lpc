inherit "std/armour";           

#include <properties.h>         
#include <language.h>           
#include <combat.h>             

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId("panzer");
  AddId("ruestung");
  AddId("glasruestung");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Glasruestung");
  SetProp(P_SHORT, "Eine Glasruestung");
  SetProp(P_LONG, 
      "Das ist eine Ruestung, die komplett aus Glas besteht. "
     "Sie schimmert leicht in allen Farben des Regenbogens.\n" );
  SetProp(P_INFO,
      "Die Ruestung wurde von Echsenmenschen geschaffen.\n"
     +"Du verspuert ausserdem leicht die Schwingungen von Magie.\n" );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([ MAT_GLASS : 100, MAT_MISC_MAGIC: 25 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 24);
  SetProp(P_QUALITY_DECAY, 40); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du legst eine Glasruestung an.\n",
                          " legt eine Glasruestung an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du schnallst eine Glasruestung ab.\n",
                            " schnallt eine Glasruestung ab.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );

  SetProp(P_MAGIC, 1); //Protheg hat gesagt ich soll :)

}

