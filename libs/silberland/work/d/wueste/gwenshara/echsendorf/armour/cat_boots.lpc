#include "../def.h"

inherit "std/armour";
 
int bann;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  bann = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Stiefel des gestiefelten Katers");
  SetProp(P_LONG,
    "Diese Stiefel sind vom gestiefelten Kater hoechstpersoenlich. "
    "Sie bestehen aus schlichtem, schwarzem leder und wirken sehr geschmeidig. "
    "Angeblich verdankt ihnen der gestiefelte Kater seine Agilitaet und "
    "Wendigkeit."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stiefel des gestiefelten Kater");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stiefel", "stiefel des gestiefelten katers", "stiefel des katers",
	   "stiefel des gestiefelten kater"}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 70);

  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:20,SR_SEER:1,SR_GOOD:-60]) );

  SetProp(P_INFO, BS("Diese Stiefel werden Dich im Kampf unterstuetzen. Sie koennen aber "
		  "nur von gemeinen und geschickten Leuten getragen werden.") );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object pl;
  if(!(pl=QueryProp(P_WORN))) return 0;
  if(bann) return 0;
  
  if(!random(60))
  {
    if(!(pl->QuerySkillAttribute(SA_SPEED) <= 100))
    {
      pl->Message(BS("Ploetzlich wirst Du schneller!\n"));
      pl->ModifySkillAttribute(TO, SA_SPEED, 150, 5+random(15));
      bann = 1;

      call_out("end_bann", 300);
    }
  }
  else if(!random(200))
  {
    if(pl->id("\nantonio")) return 0; // Antonio hat natuerlich keine Nachteile :)
    pl->Message(BS("Irgendwas geht hier schief! Du wirst langsamer!\n"));
    pl->ModifySkillAttribute(TO, SA_SPEED, 50, 5+random(10));
  }
  return 0;
}

void end_bann()
{
  if(QueryProp(P_WORN))
  {
    tell_object(QueryProp(P_WORN), BS("Die Stiefel erwaermen sich kurz und sind nun "
		"wieder einsatzbereit."));
  }
  
  bann = 0;
}
