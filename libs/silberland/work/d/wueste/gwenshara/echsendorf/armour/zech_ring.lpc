#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der Ring des Zechers");
  SetProp(P_LONG,
    "Du betrachtest den blauen Ring naeher und stellst fest, dass er mit "
    "irgendeiner Fluessigkeit gefuellt ist. Er besteht aus einem Stueck "
    "Aquamarin, das das Licht in allen Regenbogenfarben zurueck wirft. "
    "Ein hervoragender Schliff verstaerkt diesen seltsamen Effekt noch "
    "zusaetzlich."
  );

  AddDetail( ({"fluessigkeit","alkohol","schnaps"}),
    "Im Ring fliesst wohl eine Art Alkohol. Vermutlich ist es Schnaps."
  );

  AddDetail( ({"stueck","aquamarin","edelstein"}),
    "Du bemerkst, das silberne Faeden in den Aquamarin eingelassen sind."
  );

  AddDetail( ({"licht", "farben", "regenbogenfarben", "regenbogen", "schliff",
	       "effekt"}),
    "Der Aquamarin reflektiert das Licht, das ihn trifft, in allen Farben des "
    "Regenbogens."
  );

  AddDetail( ({"faeden"}),
    "Die Faeden im Inneren des Aquamarin bestehen aus einem seltsamen Metall."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ring des Zechers");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "zechring", "ring des zechers", "\nzechpreller_ring"}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PLUTONIUM:5,
			MAT_AQUAMARINE:50,
		       	MAT_TITANIUM:5,
		       	MAT_ALCOHOL:20,
		       	MAT_MISC_EXPLOSIVE:5]) );
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 90);

//  SetProp(P_WEAR_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:20]) );

  SetProp(P_INFO, BS("Dieser Ring wird wohl Zechprellern nutzen.")+
		  BS("Du erkennst eine seltsame Strahlungsaura, die von dem Ring ausgeht.") );

  /* Und das kann der Ring: */
  SetProp(P_ZECHPRELLER_BONUS, (["all":10]));
  SetProp(P_ZECHPRELLER_SPELLCOST, 5);
  SetProp(P_ZECHPRELLER_REDUCE_ALC, 10);
  SetProp("itemd_no_magic", 1);

}
