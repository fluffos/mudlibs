#include "../def.h"

inherit "/p/std/npc/zechpreller_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Krah'Kesh, der betrunkene Wachmann");
  SetProp(P_LONG,
    "Krah'Kesh ist ein kleinerer Echsenmann mit waessrigen Glubschaugen. "
    "Er traegt einen schmutzigen und zerrissenen Wappenrock der Dorfbuettel "
    "und haelt einen Krug, aus dem hin und eine klare Fluessigkeit schwappt, "
    "in der Hand. Sein Schwert steckt nachlaessig in seiner Guertelscheide."
    "Er duerfte kein ueberragender Gegner sein."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Krah'Kesh");
  SetProp(P_GENDER, MALE);
  AddId(({"krah", "kesh", "krahkesh", "krah'kesh", "wachmann", "betrunkener", 
	  "echse", "echsenmann", "echsenwachmann", "buettel", "dorfbuettel", 
	  "NOWIMPY", "Schwertexperte"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_zechpreller(25+random(6), 6);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_BODY, 30);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, "gwenshara/echsendorf_q.log");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.1, DT_WATER:      -0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1
     , DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0
     , DT_ACID:     -0.1, DT_POISON:   -0.1, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1
     , DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1
     , DT_RIP:      -0.1
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " groehlt ein letztes Trinklied.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Larsch! Ich geb Dir 'nen ausch!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "lallt etwas unverstaendliches.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"zechpreller","gilde", "zechprellergilde"}),
    "Die findescht in Kyranda! Dasch isch bei Midasch!",
    "lallt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 55); // Ein guter Zechpreller!

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" singt: Esch gieeeebt kein Bier in Eleschar...\n"
   ,Name(WER, 1)+" prostet Dir zu.\n"
   ,Name(WER, 1)+" schwenkt seinen Krug.\n"
   ,Name(WER, 1)+" ruelpst.\n"
   ,Name(WER, 1)+" groehlt: Esch wird der Weiiiin schein...\n"
   ,Name(WER, 1)+" trinkt einen Schluck aus dem Krug.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/sword/langschwert");

  CLONEME(ARMOUR "glasrue" );
  CLONEME(ARMOUR "zech_ring");
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(!QueryProp(P_WEAPON)) command_me("zuecke schwert");
  if(!present("fackel", TO))
  {
    tell_room(ENV(TO), BS(Name()+" kramt eine Fackel hervor."));
    CLONEME("/obj/fackel");
    command_me("zuende fackel an");
  }
  return ::Defend(dam, dam_type, spell, enemy);
}
