
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Echsenwachmann");
  SetProp(P_LONG, BS(
    "Ein Echsenmensch mit gruen-gelben Schuppenkleid und rotem Schuppenkamm.\n"
    "Er ist stets wachsamm und mustert dich neugierig."));
  SetProp(P_NAME, "Echsenwachmann");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"echse", "wachmann", "echsenwachmann","echsenwachmann","mann"}));
//  set_living_name("");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinem schuppigen Schwanz",55,DT_BLUDGEON}));
  SetProp(P_RACE, "echse");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      1.0,  DT_WATER:  0.4, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: -0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "echst herein");
  SetProp(P_MSGOUT, "echst");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein Leben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Niemand kann uns Echsen töten!");

 AddInfo(DEFAULT_INFO, "zischelt etwas unverstaendliches.\n");
  AddInfo( "gwenshara", "Gwenshara hat mich erschaffen!\n", "zischelt: ");
  AddInfo( "tor", "Hinter dem Tor befindet sich unser Dorf.\n", "meint: ");
  AddInfo( "speer", "Die Speere sind unsere tradititonellen Waffen.\n", "erzaehlt: ");
  AddInfo( "priester", "Du kannst ihn im Tempel finden. Er erzaehlt dir sicher gerne etwas ueber unsere Goettin.\n", "erklaert: ");
  AddInfo( "tempel", "Der Priester ist dort. Wir huldigen dort auch unserer Goettin.\n", "zischt: ");
  AddInfo( ({"goettin","goetter","gott"}), "Frag besser unseren Priester danach.\n", "meint: ");
  AddInfo( ({"ch'sir","dorfaeltesten","dorfaeltester"}), "Ch'Sir ist ein sehr alter Echsenmensch und weiss viel zu berichten.\n", "zischelt: ");
  AddInfo( "dorf", "Dort leben wir. Wir haben auch eine kleine Wasserstelle, wenn du etwas Erfrischung willst. In unserem Dorf findest du ausserdem einen Tempel und den Dorfaeltesten.\n", "zischt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Echsenwachmann will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
          "Der Echsenwachmann sieht sich mit festem Blick um.\n",
          "Der Echsenwachmann mustert dich neugierig.\n",
          "Der Echsenwachmann lehnt sich gelangweilt auf seinen Speer.\n",
          "Der Schuppenkamm des Echsenwachmanns stellt sich auf.\n" }) );

  SetAttackChats(10, ({
    "Der Echsenwachmann zischelt wuetend und die bekommst Angst.\n",
    "Der Schuppenkamm des Echsenwachmanns stellt sich drohend auf.\n",
    "Blaue Blitze zucken ueber den Schuppenkamm des Echsenwachmanns.\n"}) );

  SUID;
  CLONEME(WEAPON "echsspe" );
  command("zuecke speer");
  CLONEME(ARMOUR "glasrue" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
