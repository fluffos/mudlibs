inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Echsenwaechter");
  SetProp(P_LONG, BS(
    "Ein rot-gelb geschuppter Echsenmensch mit gelben Augen. Sein Rueckenkamm "
    "ist giftgruen. Seine Augen huschen aufmerksam herum und suchen nach Feinden. "
    "Er ist eher klein geraten und wirkt auf den ersten Blick nicht unbedingt "
    "gefaehrlich. Doch sollte man sich dennoch vor ihm in Acht nehmen, denn wenn "
    "das Dorf angegriffen wird, oder dem Dorf nur irgendwie Gefahr droht, wird er nicht "
    "davor zurueck schrecken auch sein Leben zu geben.\n" ));
  SetProp(P_NAME, "Echsenwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"echse", "echsenwaechter", "waechter","\ngwenshara_echse"}));
//  set_living_name("");

  create_default_npc(17+random(5));
  SetProp(P_HANDS, ({" mit seinem schuppigen Schwanz",150,DT_BLUDGEON}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_WEIGHT, 50000+random(1000));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      1.0,  DT_WATER:  0.4, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: -0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "echst herein");
  SetProp(P_MSGOUT, "echst");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein Leben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Du hasst unsser Dorf bedroht!!");

  //movings
  SetProp( P_MNPC_AREA, ROOM "ges" );
  SetProp( P_MNPC_WAIT, ({ 15, 20, 20 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "ges_4");
  SetProp( P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES );

 AddInfo(DEFAULT_INFO, "zischelt etwas unverstaendliches.\n");
  AddInfo( "gwenshara", "Gwenshara hat mich erschaffen!\n", "zischelt: ");
  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Echsenwaechter will Deine Sachen nicht tragen.\n" }) );

  SetChats( 2, ({
    "Der Echsenwaechter mustert Dich misstrauisch.\n",
    "Der Echsenwaechster sieht sich aufmerksam um.\n",
    "Der Echsenwaechter lehnt sich auf seinen Speer.\n"
                }) );

  SetAttackChats( 4, ({
    "Der Echsenwaechter versucht dich aufzuspiessen.\n",
    "Der Echsenwaechter holt weit aus.\n",
    "Der Echsenwaechter schleudert Dir seinen Schwanz entgegen.\n"
                      }) );

  SUID;
  CLONEME(WEAPON "echsspe" );
  command("zuecke speer");
  CLONEME(ARMOUR "glasrue" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
