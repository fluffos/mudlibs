inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Echsenfrau");
  SetProp(P_LONG, BS(
    "Die Echsenfrau hat gruene Schuppen und einen blauen "
    "Schuppenkamm. Sie hat eine Verletzung am linken Fuss.\n"));
  SetProp(P_NAME, "Echsenfrau");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  SetProp(P_ARTICLE, 0);
  AddId(({"echse", "echsenfrau","frau"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihrem schuppigen Schwanz",255,DT_BLUDGEON}));
  SetProp(P_RACE, "echse");
  SetProp(P_SIZE, 185);
  SetProp(P_WEIGHT, 40000+random(1000));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      1.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: -0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      1.0,  DT_UNHOLY:    -1.0, DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "echst herein");
  SetProp(P_MSGOUT, "echst");
  SetProp(P_MMSGIN, "echst herein");
  SetProp(P_MMSGOUT, "echst weit weg");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "zischelt etwas unverstaendliches.\n");
  AddInfo( ({"jagd","jagen"}), "Ich kann nicht mit auf Jagd, weil ich "
                               "verletzt bin.\n", "zischt: ");
  AddInfo( "verletzung", "Die habe ich vom Jagen.\n", "zischt: ");  
  AddInfo( ({"gottt","goettin"}), "Wenn Du etwas ueber die Goettin wissen willst,"
	   "dann frag den Priester!");


  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Echsenfrau sagt: Danke!\n" }) );

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
