#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Trogbold");
  SetProp(P_LONG,
    "Dieser fiese, kleine, rotaeugige Trogbold ist ganz schwarz, um sich "
    "am Grund von Wassertroegen als Schatten zu tarnen. Er grinst Dich fies "
    "an. Er stammt ziemlich sicher von den Kobolden ab."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trogbold");
  SetProp(P_GENDER, MALE);
  AddId(({"bold", "trogbold", "kobold"}));
//  AddClass( ({CL_GNOM}) );
  SetProp(P_ARTICLE, 1);


//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,123,
		    ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 45);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" lacht gemein und isst @WEN auf.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.1, DT_WATER:       -0.4
     , DT_AIR:       0.0, DT_LIGHTNING: 0.3, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.1, DT_ELECTRIC:    0.2
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      -0.2
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "erscheint kichernd");
  SetProp(P_MMSGOUT, "loest sich lachend auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " macht 'Uariks' und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Heda! Was soll das? So macht das keinen Spass!");
  SetProp(P_KILL_NAME, "Trogbold");
  SetProp(P_KILL_MSG, "Hihi! Jetz bist hinueber. *lach*");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "lacht Dich aus.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
  
//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(1, 500,
    "Der Trogbold macht 'Buh' und erschreckt Dich fuerchterlich.\n",
    "Der Trogbold macht 'Buh' und erschreckt @WEN fuerchterlich.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 200,
    Name(WER,1) + " lacht Dich laut aus.\n",
    Name(WER,1) + " lacht @WEN laut aus.\n",
    DT_SOUND, ([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1, 300,
    "Der Trogbold tritt Dir in den Hintern.\n",
    "Der Trogbold tritt @WEM in den Hintern.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 100,
    "Der Trogbold sticht Dir in die Augen.\n",
    "Der Trogbold sticht @WEM in die Augen.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500,
    "Der Trogbold macht 'Buh' und erschreckt Dich fuerchterlich.\n",
    "Der Trogbold macht 'Buh' und erschreckt @WEN fuerchterlich.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" kichert.\n"
   ,Name(WER, 1)+" lacht Dich aus.\n"
   })
  );
  
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}
