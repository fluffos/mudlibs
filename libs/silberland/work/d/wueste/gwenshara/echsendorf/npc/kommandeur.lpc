#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Echsenkommandeur");
  SetProp(P_LONG,
    "Vor Dir steht ein, soweit Du es beurteilen kannst, gutausehender und "
    "grosser Echsenmensch. Er hat ein eher gelbliches Schuppenkleid und rote Augen. "
    "Er ist sehr muskuloes und wirkt extrem ausdauernd. Er strahlt eine "
    "Menge Autoritaet aus."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Echsenkommandeur");
  SetProp(P_GENDER, MALE);
  AddId(({"kommandeur", "echsenkommandeur", "echse", "echsenmensch", "NOWIMPY","NOCONTROL",
	  "SCHUPPEN_WUSCHEL"}));
  SetProp(P_ARTICLE, 1);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(36);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,330
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_BODY, 60); //Schuppen

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.3, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1
     , DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:   -0.1, DT_MAGIC:       0.0
     , DT_MIND:     -0.1, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1
     , DT_PIERCE:   -0.1, DT_SQUEEZE:   0.0, DT_WHIP:       -0.1
     , DT_RIP:      -0.1
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Was denkst Du warum ich ein Kommandeur bin?");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "zischt etwas unverstaendliches.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"katze","raubkatze"}),
    "Seit einiger Zeit treibt sich im Dorf eine Katze herum.",
    "sagt: ");

  AddInfo( ({"dorf","echsendorf"}),
    "Da befindest Du Dich.",
    "zischelt: ");

  AddInfo( ({"dorfaelstester","dorfaeltesten","aeltester","aeltesten"}),
    "Der Dorfaelteste befindet sich im Sueden des Dorfplatzes.",
    "sagt: ");

  AddInfo( ({"jaeger","jagdhaus","haus","haus der jaeger"}),
    "Das findest Du noerdlich des Dorfplatzes.",
    "sagt: ");

  AddInfo( ({"flaeschchen","flasche"}),
    "Die Jaeger bewahren in ihrem Keller einen Trank auf, mit dem man Pflanzen "
    "schneller wachsen lassen kann. Sieh doch dort ein Mal nach. Vielleicht "
    "findest Du ja was.",
    "zischt: ");

  AddInfo( ({"topf","blumentopf","weide","baum","weidenbaum"}),
    "Am Balkon findest Du einen Blumentopf. In ihm waechst ein Weidenbaum. Die "
    "Rinde dieses Baumes hilft gegen Kopfschmerzen und ueble Zustaende.",
    "meint: ");

  AddInfo( ({"handschuhe","schuppenhandschuhe"}),
    "In diesen Handschuhen ist maechtige Magie gefangen!",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 65);

  AddSpell(1, 200,
    "Der Kommandeur tritt Dir gegen Deine Waffenhand.\nDeine Waffe faellt einen Stock tiefer.\n",
    "Der Kommandeur tritt @WEM gegen die Waffenhand.\nDie Waffe von @WEM faellt einen Stock tiefer.\n",
     DT_BLUDGEON, "spell_disarm", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500,
    "Der Kommandeur packt Dich an der Kehle und drueckt zu.\n",
    "Der Kommandeur packt @WEN an der Kehle und drueckt zu.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 150,
    "Der Kommandeur rammt Dich gegen die Wand.\n",
    "Der Kommandeur rammt @WEN gegen die Wand.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 100,
    "Der Kommandeur verpasst Dir einen recht heftigen Tritt.\n",
    "Der Kommandeur verpasst @WEM einen recht heftigen Tritt.\n",
    DT_BLUDGEON, "spell_fall", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 300,
    "Der Kommandeur zerschmettert Dein Gesicht mit einem Kopfstoss.\n",
    "Der Kommendeur zweschmettert @WESSEN Gesicht mit einem Kopfstoss.\n",
    DT_BLUDGEON, "spell_headhit");

  AddSpell(1, 200,
    "Der Kommandeur schleudert Dich mit seinem Schwanz fort.\n",
    "Der Kommandeur schleudert @WEN mit seinem Schwanz fort.\n",
    DT_BLUDGEON, "spell_tail", ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_REDUCE_AC,
    "Der Kommandeur zertruemmert Deine Ruestung mit einem gezielten Schlag!\n",
    "Der Kommandeur zertruemmert @WESSEN Ruestung mit einem gezielten Schlag!\n"
  );

  AddDefaultSpell(1, 1, DS_REDUCE_WC,
    "Der Kommandeur rammt Deine Waffe gegen die Wand.\nSie bekommt Risse!\n",
    "Der Kommandeur rammt @WESSEN Waffe gegen die Wand.\nSie bekommt Risse!\n"
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  if(!random(2))
  {
    CLONEME(WEAPON "chromdolch" );
    command("zuecke dolch");
  }

  CLONEME(ARMOUR "egloves2" );
  CLONEME(ARMOUR "glasrue");
  CLONEME("/p/armour/boots/lederstiefel");
  command("trage alles");
}

void spell_disarm(object enemy, int damage, mixed dam_type)
{
  object weapon;
  if(!weapon=enemy->QueryProp(P_WEAPON)) return;
  if(weapon->QueryProp(P_NODROP) || weapon->QueryProp(P_CURSED)) return;

  weapon->DoUnwield(1); //Wegstecken
  weapon->move(ROOM "turm_m", M_PUT); //Bewegen
  call_other(ROOM "turm_m", "Message", "Eine Waffe faellt herein.\n");
}

void spell_fall(object enemy, int damage, mixed dam_type)
{
  int i;
  i=random(2);
  if(!random(10))
  {
    enemy->Message(BS("Du stolperst und kannst Dich gerade noch fangen."));
    ENV(enemy)->Message(BS(enemy->name()+" stolpert und faengt sich gerade noch."),
		([ MSGFLAG_EXCLUDE : ({ enemy }) ]));
    return;
  }

  enemy->Message(BS("Du stolperst und faellst "+(i<0?"zwei":"ein")+" Stockwerk"+(i<0?"e":"")+
		    " runter.\n"));
  enemy->move(ROOM "turm_"+(i<0?"e":"m"), M_NOCHECK, "runter", "faellt",
                                "faellt von oben herein");
  enemy->SetProp(P_PARALYZED, ([
   	                        PARALYZE_TIME:damage/10,
				PARALYZE_MSG:"Keuchend liegst Du am Boden.\n",
				PARALYZE_MSG_OTHER:"%s liegt keuchend am Boden.\n",
				PARALYZE_END:"Du rappelst Dich wieder auf.\n",
				PARALYZE_END_OTHER:"%s rappelt sich auf.\n"
			       ])
		  );
}

void spell_headhit(object enemy, int damage, mixed dam_type)
{
  if(enemy->QueryProp(P_BLIND) != 0) return;
  enemy->SetProp(P_BLIND, ([BLIND_TIME:damage/10,
			    BLIND_MSG:"Nach diesem heftigen Kopfstoss siehst Du nur noch Sterne...\n",
			    BLIND_END_MSG:"Die Sterne verschwinden und Du siehst wieder etwas.\n"
			   ]));
}

void spell_tail(object enemy, int damage, mixed dam_type)
{
  if(!random(5))
  {
    enemy->move(ROOM "balkon", M_NOCHECK, "hinaus", "fliegt", "wird herein geschleudert");
    enemy->SetProp(P_PARALYZED, ([
   	                        PARALYZE_TIME:damage/10,
				PARALYZE_MSG:"Keuchend liegst Du am Boden.\n",
				PARALYZE_MSG_OTHER:"%s liegt keuchend am Boden.\n",
				PARALYZE_END:"Du rappelst Dich wieder auf.\n",
				PARALYZE_END_OTHER:"%s rappelt sich auf.\n"
			       ])
		  );
  }  
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
