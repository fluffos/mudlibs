
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Zzhaxxel, die Wirtin");
  SetProp(P_LONG, BS(
    "Zzhaxxel ist eine noch recht junge Echse. Ihr Schuppenkleid ist "
   +"gruen und scheint in allen Farben des Regenbogens zu glitzern. "
   +"Ihre Augen scheinen wie strahlende Amethyste. Sie scheint sehr "
   +"freundlich zu sein."));
  SetProp(P_NAME, "Zzhaxxel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"echse","echsenmensch","zzhaxxel", "wirtin", "Messermeister"}));

  create_default_npc(25+random(3));
  SetProp(P_HANDS, ({" mit ihren schuppigen Haenden",55,DT_BLUDGEON}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 190+random(30));
  SetProp(P_WEIGHT, 50000+random(1000));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:      1.0, DT_WATER:  -0.1,DT_AIR:    0.0, 
      DT_LIGHTNING: 0.2,  DT_EXPLOSION: -0.5,DT_SOUND:  0.0, DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.3,
      DT_HOLY:      0.5,  DT_UNHOLY:    -0.5,DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "echst herein");
  SetProp(P_MSGOUT, "echst");
  SetProp(P_MMSGIN, "echst heran.");
  SetProp(P_MMSGOUT, "echst weg");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "zischelt etwas unverstaendliches.");
 
  AddInfo( ({"ch'sir","doraeltester","dorfaeltesten"}), "Den findest Du im Sueden des "
	 +"Dorfplatzes.", "zischt: ");
  AddInfo( ({"speisen","essen","menue"}),
	"Schau doch im Menue nach!", "meint: ");
  AddLibrary(NPC "zzhaxxel.lib", 1);
 
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Zzhaxxel sagt: Oh! Danke!\n" }) );

  CLONEME(WEAPON "messer");
  command_me("zuecke messer");

  SetProp(P_SPELLRATE, 30);

  AddSpell(4, 200, "Zzhaxxel rammt Dir ihr Messer in die Schulter.\n",
		"Zzhaxxel rammt @WEM ihr Messer in die Schulter.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 300, "Zzhaxxel beisst Dich in den Arm.\n",
		"Zzhaxxel beisst @WEM in den Arm.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 400, "Zzhaxxel reisst Dir mit ihren Krallen die Haut auf.\n",
		"Zzhaxxel reisst @WEM mit ihren Krallen die Haut auf.\n",
	   DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 900, "Zzhaxxel reisst ein Stueck aus Dir herraus.\n",
		"Zzhaxxel reisst ein Stueck aus @WEM heraus.\n",
	   DT_RIP, ([SP_SHOW_DAMAGE:1]));
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}
