// duerfen ihn zwar angreifen - sollen aber selber schaun ob sies ueberleben
//
//=========================================================================

#include "../def.h"
#include <npcmaster.h>

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Adamantium, das maechtige Erzelementar");
  SetProp(P_LONG,
    "Das Erzelementar ist eine Gestalt aus reinstem Erz, mit rubinernen "
    "Augen und Gold als Haaren. Durch seine Adern fliesst reinstes "
    "Quecksilber. Es wurde beauftragt die Schaetze hier zu bewachen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Adamantium");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar", "erzelementar", "\ngwenshara_erzele", "adamantium", 
	  "NOCONTROL", "NOWIMPY", "NO_MUMMY", "NOFALLDOWN"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(40);

  SetProp(P_HANDS, ({" mit seinen erzenen Haenden",
                    450,
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_WEIGHT, 10000000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_BODY, 90);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zermalmt @WEN.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.1,
       DT_AIR:       1.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:  -0.1,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -1.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:      -0.3,
       DT_MIND:      0.0, DT_SLASH:    -0.6, DT_BLUDGEON:   -0.3,
       DT_PIERCE:   -1.0, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.6,
       DT_RIP:      -0.5,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "bricht aus dem Boden");
  SetProp(P_MMSGOUT, "versinkt im Boden");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " versinkt im Boden.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "Ich komme sogleich wieder!");
  SetProp(P_KILL_NAME, "Der Meister des Erzes");
  SetProp(P_KILL_MSG, "Niemand bezwingt mich!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"auftrag", "befehl", "pflicht"}),
    "Es ist meine Pflicht diesen Schatz zu bewachen!",
    "droehnt: ");

  AddInfo( ({"schatz", "gold"}),
    "Nur auserwaehlte Personen duerfen diesen Schatz beruehren! Er wurde "
    "von unzaehligen Generationen zusammengetragen, somit ist er tausende "
    "von Jahren alt!", "droehnt: ");

  AddInfo( ({"personen"}),
    "Nur wenige haben das Recht einen Teil des Schatzes zu besitzen! "
    "Wer dies nicht achtet wird hier den Tod finden!", "droent: ");

  AddInfo( ({"generationen"}),
    "Viele Generationen haben diesen Schatz zusammen getragen!",
    "droehnt: ");

  AddInfo( ({"tod"}),
    "Gib Acht! Sonst wirst Du hier nur den Tod finden! Wenn Du einer "
    "der Auserwaehlten bist, so ist es Dir gestattet ein einziges Mal "
    "den Schatz zu durchsuchen!", "droehnt laut: ");

  AddInfo( ({"auserwaehlte", "erwaehlte"}),
    "Ein Auserwaehlter ist an dem gluehenden Zeichen auf seiner Stirn "
    "zu erkennen!", "droehnt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 60);

  AddSpell(1, 1800,
    "Adamantium zermalmt Dich zwischen seinen Haenden.\n",
    "Adamantium zermalmt @WEN zwischen seinen Haenden.\n",
     ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 1, DS_REDUCE_AC,
    Name(WER,1) + " befiehlt Deiner Ruestung zu zerfallen!\n",
    Name(WER,1) + " befiehlt @WESSEN Ruestung zu zerfallen!\n" );

  AddDefaultSpell(3, 1, DS_REDUCE_WC,
    Name(WER,1) + " befiehlt Deiner Waffe zu zerfallen!\n",
    Name(WER,1) + " befiehlt @WESSEN Waffe zu zerfallen!\n" );

  AddSpell(4, 300,
    "Adamantium wirft eine Steinlanze nach Dir.\n",
    "Adamantium wirft eine Steinlanze nach @WEM.\n",
    ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 200,
    "Adamantium blickt Dich mit seinen lodernden Augen an.\n",
    "Adamantium blickt @WEN mit seinen lodernden Augen an.\n",
    ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 200,
    "Adamantium wirft einen Erzpfeil nach Dir.\n",
    "Adamantium wirft einen Erzpfeil nach @WEM.\n",
    ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 300,
    "Adamantium schiesst einen Strahl aus fluessigem Erz auf Dich.",
    "Adamantium schiesst einen Strahl aus fluessigem Erz auf @WEN.",
    ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "steinlanze" );
  command("zuecke lanze");
}

//--Funs---------------------------------------------------------------------
int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  object shield;
  if(!present("\ngwenshara_sshield", TO))
  {
    shield = clone_object(ARMOUR "stone_shield");
    shield->move(TO, M_GET);
    tell_room(ENV(TO), BS("Adamantium beschwoert ein Schild herauf."));
    command_me("trage schild");
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
