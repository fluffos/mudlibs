inherit "/std/npc/spells.lpc";
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Echsenpriester");
  SetProp(P_LONG, BS(
    "Der Priester ist ein etwas aelterer Echsenmensch "
    "mit violetten Augen. Sein Schuppenkamm ist seltsam "
    "durchscheinend und blassblau. Eine Aura der Macht geht "
    "von ihm aus, so das Dir schnell bewusst wird das Du etwas "
    "besonderes vor Dir hast. Als du genauer hinsiehst erkennst "
    "Du kleine Schwimmhaeutchen zwischen den Fingern der Echse."));
  SetProp(P_NAME, "Echsenpriester");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"echse", "priester", "echsenpriester","NOWIMPY"}));
//  set_living_name("");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen schuppigen Haenden",265,DT_BLUDGEON}));
  SetProp(P_RACE, "echse");
  SetProp(P_SIZE, 190+random(30));
  SetProp(P_WEIGHT, 50000+random(1000));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:      1.0,  DT_WATER:  -0.6, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1,  DT_EXPLOSION: -0.5, DT_SOUND:  0.0, DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: -0.3,
      DT_HOLY:      1.0,  DT_UNHOLY:    -1.0, DT_MAGIC: -0.2, DT_MIND:   0.0]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "kommt selbstbewusst an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "manifestiert sich aus schwarzen Wogen");
  SetProp(P_MMSGOUT, "wird von schwarzen Wogen verschluckt");

  SetProp(P_DIE_MSG,  " wird von Tentakeln in entfernte Sphaeren gerissen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Wage es nicht noch einmal Dich gegen mich zu stellen!");

  AddInfo(DEFAULT_INFO, "sieht dich fragend an.\n");
  AddInfo( ({"goettin","gott","charyb'yzz","goetter","glaube"}),
           "Wir glauben an Charyb'Yzz, die alles Verschlingende. Nur Dank ihr "
           "koennen wir hier in der Wueste ueberleben, denn sie gebietet ueber das "
           "Wasser. Wir Echsenmenschen haben mit ihr einen Pakt geschlossen, der es "
           "uns erlaubt hier Wasser zu erschaffen! Wenn wir sterben ruft sie uns zu "
           "sich, damit wir auch nach dem Tod nahe bei ihr sind um ihr zu dienen. "
           "Schon unsere Urahnen haben sie verehrt und mussten niemals Durst leiden.", "zischt: ");
  AddInfo( ({"urahnen","vorfahren"}), "Das waren einst grosse Drachen, woher sie kamen wissen wir nicht.", "zischt: ");
  AddInfo( ({"becken","wasser"}), "Das Wasser wurde uns von Charyb'Yzz geschenkt. Dieses Becken war bereits vor uns hier.", "zischt: ");
  AddInfo( "tempel", "Er wurde lange vor meiner Zeit erbaut und dient dazu unserer Goettin zu huldigen.", "zischelt: ");
  AddInfo( "trinken", "Etwas zu trinken habe ich nicht, aber zum erfrischen kannst du in dem Becken baden.", "zischt: ");
  AddInfo( ({"zeichen","inschrift"}), "Das ist die Prophezeiung, dort steht alles "
                                      "geschrieben was unsere Religion ausmacht.", "zischt: " );
  AddInfo( "prophezeiung", "In ihr steht alles ueber den Ursprung des Lebens und "
                           "ueber das Leben nach dem Tod.", "zischelt: " );
  AddInfo( ({"leben","ursprung"}), "Charyb'Yzz hat uns geschaffen und uns alles beigebracht.", "zischelt: ");
  AddInfo( "tod", "Wenn wir sterben, dann gelangen wir in das Reich unserer Goettin um ihr "
                  "auch nach dem Tod noch dienen zu koennen.", "zischt: " );
  AddInfo( "reich", "Das Reich unserer Goettin liegt tief unten im Meer. Dort ist das "
                    "Wasser so schwarz wie die Nacht. Tag fuer Tag gebiert Charyb'Yzz dort "
                    "Seeschlangen und andere Geschuppte. Ein Schattenfeste soll dort stehen, "
                    "in der wir nach unserem Tode dienen duerfen.", "zischt: " );
  AddInfo( ({"schlangen","seeschlangen"}), "Sie stammen aus den tiefsten Tiefen und sind die "
                                          "hoechsten Diener der Charyb'Yzz.", "zischt: " );
  AddInfo( ({"feste","schattenfeste","festung","schattenfestung"}), 
             "Sie befindet sich am tiefsten "
            "Punkt der Meere. In ihr "
            "werden wir nach unserem "
	   "Tode dienen.", "zischelt: " );


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Echsenpriester will Deine Sachen nicht tragen.\n" }) );

 SetChats(5, ({
           "Der Priester kniet vor dem Altar nieder.\n",
           "Der Priester ruft seltsam klingende Worte.\n",
           "Der Priester beschwoert schwarze Wellen in das Becken.\n",
           "Der Priester versinkt in Konzentration.\n" }) );

  SetAttackChats(9, ({
                "Tentakel springen aus dem Boden und behindern Dich.\n",
                "Der Priester murmelt seltsame Worte.\n",
                "Eine Wand aus schwarzem Wasser bildet sich vor dem Priester.\n"}) );

   //Spells
 SetProp(P_SPELLRATE, 50);

 AddSpell(4, 600, "Du spuerst wie unheiliges Wasser Deine Lungen fuellt.\n",
                  "@WER hustet schwarzes Wasser.\n",({DT_WATER,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );
 AddSpell(3, 800, "Der Priester schleudert Dir eine schwarze Welle entgegen.\n",
                  "Der Priester schleudert @WEM eine schwarze Flutwelle entgegen\n",({DT_WATER}),([SP_SHOW_DAMAGE:1]) );
 AddDefaultSpell(2, 200, DS_FEAR, "Der Priester reckt Dir die linke Hand entegen und Du bekommst Angst.\n",
                                  "Der Priester reckt @WEM die linke Hand entgegen.\n" );

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}
