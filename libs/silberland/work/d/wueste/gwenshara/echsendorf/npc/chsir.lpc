
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ch'Sir, der Dorfaelteste");
  SetProp(P_LONG, BS(
    "Das ist Ch'Sir, er duerfte ein sehr alter Echsenmensch sein. "
    "Er sieht irgendwie muede aus, dennoch ist eine gewisse Aura "
    "um ihn, die Dir Respekt einfloest."));
  SetProp(P_NAME, "Ch'Sir");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:50]));
  AddId(({"echse","echsenmensch","ch'sir","dorfaeltester","aeteste","dorfaeltesten","chsir","Messermeister"}));

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen schuppigen Haenden",55,DT_BLUDGEON}));
  SetProp(P_RACE, "echse");
  SetProp(P_SIZE, 190+random(30));
  SetProp(P_WEIGHT, 50000+random(1000));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:      1.0, DT_WATER:  -0.1,DT_AIR:    0.0, 
      DT_LIGHTNING: 0.2,  DT_EXPLOSION: -0.5,DT_SOUND:  0.0, DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.5,  DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.3,
      DT_HOLY:      0.5,  DT_UNHOLY:    -0.5,DT_MAGIC: -0.2, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "echst herein");
  SetProp(P_MSGOUT, "echst");
  SetProp(P_MMSGIN, "echst heran.");
  SetProp(P_MMSGOUT, "echst weg");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );

 AddInfo(DEFAULT_INFO, "zischelt etwas Unverstaendliches.");
  AddInfo( ({"ch'sir","doraeltester","dorfaeltesten"}), "Der bin ich!", "zischt: ");
  AddInfo( ({"herkunft","abstammung"}), "Wir stammen von den einst grossen Drachen ab.", "zischt: ");
  AddInfo( ({"drache","drachen"}), "Die Drachen sind unsere Vorfahren, einst lebten sie "
                                   "unter uns, jetzt aber sind die meisten von ihnen verschwunden. "
                                   "Nur noch ein paar leben auf dieser Welt.", "zischt: ");
  AddInfo( ({"welt","silberland"}), "Das hier ist das Silberland.", "meint: ");
  AddInfo( ({"kristalle","kristallen","kristall"}), "Wir ziehen unsere Magie aus den Kristallen.", "zischt: ");
  AddInfo( ({"stein","steine","licht","lichtquellen"}), "Diese blau glimmenden Steine sind unsere Lichtquellen.", "zischt: ");
  AddInfo( ({"seeschlange","haut","seeschlangenhaut","schlangenhaut"}), "In meiner Jugend habe ich "
            "eine Seeschlange getoetet und einen Teil ihrer Haut genommen.", "zischt: ");
  AddInfo( "jugend", "Die ist schon lang vorrueber, damals habe ich eine Seeschlange getoetet.", "zischt: ");
  AddInfo( "alter", "Ich bin schon weit ueber 200 Jahre alt!", "zischt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ch'Sir will Deine Sachen nicht tragen.\n" }) );

  CLONEME("/p/weapon/knife/obsidiandolch");
  command_me("zuecke dolch");

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
