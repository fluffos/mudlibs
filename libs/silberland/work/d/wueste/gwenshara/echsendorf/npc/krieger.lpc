#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

string questinfo();

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Echsenkrieger");
  SetProp(P_LONG,
    "Der Echsenkrieger ist ein kraeftiger Echsenmensch mit giftgruenem "
    "Schuppenkleid. Er sieht in Kampfesdingen sehr erfahren aus. Doch irgendwie "
    "scheint er auch seine Probleme zu haben."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Echsenkrieger");
  SetProp(P_GENDER, MALE);
  AddId(({"krieger", "echse", "echsenkrieger", "echsenmensch"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:     -1.0,  DT_COLD:      1.0,  DT_WATER:  0.4, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION:-0.5,  DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "interessiert sich nicht fuer Dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"dorf","echsendorf"}),
    "Nun, hier befindest Du Dich.",
    "sagt: ");

  AddInfo( ({"kampf","dinge","kampfesdinge","krieger"}),
    "Ich bin ein Krieger unseres Dorfes.",
    "zischelt: ");

  AddInfo( ({"problem","probleme"}),
    "Hach, diese Kopfschmerzen!",
    "jammert: ");

  AddInfo( ({"schmerzen","kopfschmerzen"}),
    "Oh, Ich waere Dir sehr dankbar wenn Du mir helfen wuerdest! Ganz oben im "
    "Turm findest Du einen Blumentopf, in dem eine Pflanze gedeit, die mir helfen "
    "kann! Im Gegenzug gebe ich Dir dafuer meine Rune.",
    "zischt: ");

  AddInfo( ({"abgang","gitter","runen","rune"}),
    "Um nach unten in die Zelle zu gelangen benoetigst Du so eine Rune "
    "wie ich sie habe.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(1, 500,
    "Der Echsenkrieger rammt Dir seine Waffe in die Brust.\n",
    "Der Echsenkrieger rammt @WEM seine Waffe in die Brust.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_DISARM,
    Name(WER,1) + " entwaffnet Dich geschickt!\n",
    Name(WER,1) + " entwaffnet @WEN geschickt!\n"
  );

  AddSpell(2, 300,
    "Der Echsenkrieger schleudert Dir seinen Schwanz entgegen.\n",
    "Der Echsenkrieger schleudert @WEM seinen Schwanz entgegen.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 100,
    "Der Echsenkrieger versetzt Dir einen kraeftigen Tritt.\n",
    "Der Echsenkrieger versetzt @WEM einen kraeftigen Tritt.\n",
    DT_BLUDGEON, "spell_kick", ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "achfawar" );
  command("zuecke achfawar");

  CLONEME(ARMOUR "glasrue" );
  command("trage alles");

  CLONEME(OBJ "rune");
}

void give_notify(object ob)
{
  if(!ob->id("aspirin"))
  {
    ::give_notify(ob);
    return;
  }

  command_me("sag Oh! Danke!");
  command_me("iss aspirin");
  command_me("wirf rune weg");
  return;
}

void spell_kick(object enemy, int damage, mixed dam_type)
{
  enemy->move(ROOM "ges_7", M_TPORT);
  enemy->SetProp(P_PARALYZED, ([
   	                        PARALYZE_TIME:damage/10,
				PARALYZE_MSG:"Keuchend liegst Du am Boden.\n",
				PARALYZE_MSG_OTHER:"%s liegt keuchend am Boden.\n",
				PARALYZE_END:"Du rappelst Dich wieder auf.\n",
				PARALYZE_END_OTHER:"%s rappelt sich auf.\n"
			       ])
		  );
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

//  if(present("\nechs_rune")) present("\nechs_rune")->remove();

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  if(!present("\nechs_rune", TO))
    clone_object(OBJ "rune")->move(TO, M_GET);
}
