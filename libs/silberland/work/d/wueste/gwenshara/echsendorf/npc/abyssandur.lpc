#include "../def.h"

inherit "std/npc";
inherit "/std/npc/compare";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Abyssandur der Haendler");
  SetProp(P_LONG,
    "Abyssandur ist ein etwas groesserer Echsenmann. Er hat gelbliche "
    "Schuppen und giftgruene Augen. An seinem Blick erkennst Du seinen "
    "aeusserst scharfen Geschaeftssinn. Ausserdem kann er Dir Deine "
    "Ruestungen und Waffen vergleichen."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Abyssandur");
  SetProp(P_GENDER, MALE);
  AddId(({"abyssandur", "haendler", "echse", "echsenmensch", "echsenmann", "\ngwenshara_verkaeufer",
	  "Speerkaempfer"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit schuppigen Haenden",55, ({DT_BLUDGEON})}));

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.5,DT_COLD:      1.0, DT_WATER:       -0.5
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   -0.1
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       -0.1
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verstirbt.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Abyssandur");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "fragt: Willst Du nicht lieber etwas kaufen?\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"chsir","ch'sir"}),
    "Ch'sir ist unser Dorfaeltester.",
    "sagt: ");

  AddInfo( ({"priester","goettin","gott","glaube","glauben"}),
	   "Wenn Du Fragn zu unserem Glauben hast, dann frag im Tempel nach.",
	   "zischt: ");

  AddInfo( ({"zzhaxxel","kneipe","wirtshaus","essen"}),
	   "Etwas zu essen bekommst Du bei Zzhaxxel, sie befindet sich im "
	   "Suedwesten des Dorfes.", "meint: ");

  AddInfo( ({"dorf","echsendorf"}),
	   "Wir leben hier.", "sagt: ");

  AddInfo( ({"ruestungen","waffen","vergleichen","vergleich"}),
	   "Mit 'vergleiche x mit y' kannst Du bei mir Deine Waffen und "
	   "Ruestungen vergleichen lassen.", "sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" fragt: Moechtest Du nicht etwas kaufen?\n"
   ,Name(WER, 1)+" prueft den Lagerbestand.\n"
   ,Name(WER, 1)+" sieht Dich abwartend an.\n"
   })
  );

  SetAttackChats(5,
  ({Name(WER, 1)+" zischt veraergert.\n"
   ,Name(WER, 1)+" faucht laut.\n"
   ,Name(WER, 1)+" peitscht mit seinem Schwanz um sich.\n"
   ,Name(WER, 1)+" tritt wild um sich.\n"
   ,Name(WER, 1)+" versucht zu beissen.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/spear/obsidianspeer");
  command("zuecke speer");

  CLONEME(OBJ "schuppenbeutel" );

  AddCmd( ({"vergleiche", "vergleich"}), "compare");
}
//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "ignoriert Dich.",
        "ignoriert "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}
