#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Antonio, der gestiefelte Kater");
  SetProp(P_LONG,
    "Das ist Antonio. Er ist eine rote Tigerkatze, die auf zwei Beinen geht. "
    "Antonio gehoert zu den wenigen gestiefelten Katzen und Katern, die es "
    "im SilberLand gibt. Seine gruenen Augen funkeln gemein. Es scheint so, "
    "als sei er ein richtiger gemeiner Halunke."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, ({"Antonio, der gestiefelte Kater", "Antonios, des gestiefelten Katers",
		    "Antonio, dem gestiefeltem Kater", "Antonio, den gestiefelten Kater"}));
  SetProp(P_GENDER, MALE);
  AddId(({"kater", "antonio", "katze", "\nantonio", "NOWIMPY", "FELL_WUSCHEL"}));
  AddAdjective(({"gestiefelt","gestiefelte","gestiefelten","gestiefeltem"}));
  AddClass( ({CL_ANIMAL, CL_NIGHTVISION }) );
  SetProp(P_ARTICLE, 0);

 set_living_name("antonio");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25+random(5));

  SetProp(P_HANDS, ({" mit seinen scharfen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_RIP})
                    })
  );

  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, -60);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);


  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.0, DT_WATER:       0.2
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.1, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "springt aus dem Schatten");
  SetProp(P_MMSGOUT, "verschwindet im Schatten");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faucht auf und verendet.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich werde Dir schon noch zeigen wer hier der bessere Fechter ist!");
  SetProp(P_KILL_NAME, "Antonio, der gestiefelte Kater");
  SetProp(P_KILL_MSG, "Haha! Du Schuft!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "laechelt fies.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
  AddInfo( ({"flaeschchen","flasche"}),
    "Das Flaeschchen habe ich hier unten gefunden! Angeblich laesst es "
    "Pflanzen schneller wachsen. Gegen eine klitzekleine Gegenleistung "
    "gebe ich es Dir gerne!", "schnurrt: ");
  AddInfo( ({"leistung","gegenleistung"}),
    "Als ich hier hergekommen bin, habe ich ueber dem Dorf einen Geierschwarm "
    "gesehen. Bring mir einen von ihnen und das Flaeschchen gehoert Dir!",
    "maunzt: ");
  AddInfo( ({"antonio", "kater"}),
    "Das bin ich!", "sagt: ");
//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

  AddSpell(3, 200,
    "Antonio sticht Dich mit seinem Degen.\n",
    "Antonio sticht @WEN mit seinem Degen.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_DISARM,
    Name(WER,1) + " schlaegt Dir Deine Waffe aus der Hand!\n",
    Name(WER,1) + " schlaegt @WEM die Waffe aus der Hand!\n"
  );

  AddSpell(2, 300,
    "Antonio zerkratzt Dir mit seinen Krallen das Gesicht!\n",
    "Antonio zerkartzt @WEM mit seinen Krallen das Gesicht!\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 400, DS_BLIND,
    "Antonio sticht Dir in die Augen!\n",
    "Antonio sticht @WEM in die Augen!\n"
  );

//--Chats------------------------------------------------------------------

  SetChats(5,
  ({"Antonio schnurrt leise.\n"
   ,"Antonio sagt: Haha! So leicht entkommst Du mir nicht!\n"
   ,"Antonio fuchtelt mit seinem Degen herum.\n"
   ,"Antonio funkelt dich mit seinen Augen an.\n"
   ,"Antonio wedelt mit seinem Schwanz.\n"
   ,"Antonio kichert leise.\n" 
   ,"Antonio putz sein Fell.\n"
   ,"Antonios Degen blitzt verraeterisch auf.\n"
   ,"Die Feder auf Antonios Hut wippt auf und ab.\n"
   ,"Antonio miaut fies.\n"
   })
  );

  SetAttackChats(10,
  ({"Antonio sagt: Haha! So leicht entkommst Du mir nicht!\n"
   ,"Antonio schlaegt eine Finte.\n"
   ,"Antonios Degen blitzt gefaehrlich auf.\n"
   ,"Antonio weicht geschickt aus.\n"
   ,"Antonio springt hoch um den Schlaegen auszuweichen.\n"
   ,"Antonio macht einen Ausfall.\n"
   ,"Antonio schlaegt in schneller Reihenfolge zu.\n"
   ,"Antonio verfehlt mit seinem Stich um Haaresbreite.\n"
   ,"Antonio knurrt leise.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "cat_degen" );
  command("zuecke degen");

  CLONEME("/p/armour/belt/guertel.lpc");
  CLONEME(ARMOUR "cat_boots");
  command("trage alles");

  CLONEME(OBJ "flaeschchen");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}


void reset()
{
  object *inv;
  int i;
  ::reset();
  if(!ENV(TO)) return;

  ENV(TO)->Message("Der Kater verschwindet wieder im Schatten.\n");
  call_other(ROOM "keller", "ReCat");
  inv=all_inventory();
  for(i=0; i<sizeof(inv); i++)
    inv[i]->remove(1);
  remove(1);
}

void give_notify(object ob)
{
  if(!ENV(ME)) return;
  if(ob->id("\ngeier_leiche"))
  {
    ENV(ME)->Message("Antonio schnurrt: Oh, vielen Dank!\n", MSGFLAG_SOUND);
    ENV(ME)->Message("Antonio isst die Geierleiche sofort auf.\n", MSGFLAG_VISUAL);
    ob->remove(1);
    //ENV(ME)->Message("Antonio wirft das Flaeschchen weg.\n", MSGFLAG_VISUAL);
    command_me("wirf flaeschchen weg");
    return;
  }
  ENV(ME)->Message("Antonio laesst "+ob->name()+" irgendwo verschwinden.\n", MSGFLAG_VISUAL);
  ob->remove(1);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verengt seine Augen zu Schlitzen.",
        "verengt seine Augen zu Schlitzen.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert albern.",
        "kichert albern.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "laechelt Dich hinterlistig an.",
        "laechelt "+TPN+" hinterlistig an.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "knurrt leise.",
        "knurrt leise.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "s Augen glitzern leicht.",
        "s Augen glitzern leicht.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schnurrt zufrieden.",
        "schnurrt zufrieden.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "schmiegt sich an Dich.",
        "schmiegt sich an "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
