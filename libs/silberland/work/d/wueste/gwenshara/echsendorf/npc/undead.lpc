#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein untoter Echsenmagier");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Echsenmagier");
  SetProp(P_NAME_ADJ, "untot");
  SetProp(P_GENDER, MALE);
  AddId(({"magier", "echsenmagier", "NOWIMPY", "NOCONTROLL", "NO_MUMMY", "NOFALLDOWN"}));
  AddAdjective(({"untoter","untoten","untotes","untote"}));
  AddClass( ({CL_UNDEAD}) );
  SetProp(P_ARTICLE, 1);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(27);

  SetProp(P_HANDS, ({" mit seiner Magie"
                    ,270
                    , ({DT_MAGIC, DT_UNHOLY})
                    })
  );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -5);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

 // SetProp(P_LOG_INFO, "npc_logfile");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:     -0.2, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.1
     , DT_SOUND:    -0.1, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0
     , DT_ACID:     -0.1, DT_POISON:   -0.1, DT_TERROR:     -0.2
     , DT_HOLY:      0.2, DT_UNHOLY:   -0.2, DT_MAGIC:      -0.3
     , DT_MIND:     -0.1, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1
     , DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1
     , DT_RIP:      -0.1
     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " zerfaellt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Aaaaaargh!");
  SetProp(P_KILL_NAME, "Die Rache des Echsenmagiers");
  SetProp(P_KILL_MSG, "Dein Blut gegen mein Blut!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

  AddSpell(1, 200,
    "Der Echsenmagier versucht Dich zu zerreissen.\n",
    "Der Echsenmagier versucht @WEN zu zerreissen.\n",
     ({DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_CURSE_ARMOUR,
    Name(WER,1) + " verwuenscht eine Deiner Ruestungen!\n",
    Name(WER,1) + " verwuenscht eine der Ruestungen von @WEM!\n"
  );

  AddDefaultSpell(1, 200, DS_MASS_DAMAGE,
     "Der untote Echsenmagier sendet eine Welle des Hasses aus!",
     "Der untote Echsenmagier sendet eine Welle des Hasses aus!",
     ({DT_UNHOLY, DT_TERROR}));

  AddSpell(1, 300,
     "Der untote Echsenmagier schleudert einen Pfeil dunkler Energie auf Dich.",
     "Der untote Echsenmagier schleudert einen Pfeil dunkler Energie auf @WEN.",
     ({DT_MAGIC, DT_UNHOLY, DT_TERROR}), ([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------
  SetAttackChats(10,
  ({Name(WER, 1)+" knurrt.\n"
   ,Name(WER, 1)+" beisst Dich in die Hand.\n"
   ,Name(WER, 1)+" versucht Dir das Herz herraus zu reissen!\n"
   ,Name(WER, 1)+" schleudert Dich zu Boden.\n"
   ,Name(WER, 1)+" will Dir Deinen Kopf abreissen!\n"
   })
  );
}

string long()
{
  return BS("Vor Dir erhebt sich die finstere Gestalt eines Untoten in "
        "Echsenform. Er traegt eine schwarze Robe, die seine toetlichen "
	"Verletzungen nur unzureichend verdeckt. Seine Augen sind durch "
	"die unheiligen Maechte in seinem Koerper feuerrot gefaerbt und "
	"starren Dich mit gierigem Blick an.");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

void reset()
{
  if(!is_clone(TO)) return;
  tell_room(ENV(TO), BS("Der Untote zerfaellt."));
  remove(1);
}
