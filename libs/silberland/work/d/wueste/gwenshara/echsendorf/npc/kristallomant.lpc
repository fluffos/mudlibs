  "/obj/gemmaster"->DistributeGem(3,5,1,1);

  //Tauschmaster initialisieren :)
  if(!call_other(KMASTER, "isInit")) call_other(KMASTER, "ini");
  AddCmd(({"tausche","tausch"}), "cmd_tauschen");

