{
  int anz;
  object *gems;
  ::give_notify(ob);
  /*if(!(ob->id("edelsteine") && ob->QueryProp(P_AMOUNT) > 1))
  {
    command_me("sag Danke!");
    return;
  }

  anz=(int) (ob->QueryProp(P_AMOUNT)/2);
