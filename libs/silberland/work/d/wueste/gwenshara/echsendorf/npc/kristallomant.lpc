int cmd_tauschen(string str)
{
  string what, to;
  int deal, am;
  /*command_me("sag Zur Zeit habe ich leider keine Edelsteine.");
  return 1; Notausschalter!*/

  notify_fail("Was moechtest Du wogegen tauschen?\nz.B: tausche onyx gegen rubin\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s gegen %s", what, to) != 2) return 0;

  if(!present(what, TP))
  {
    command_me("sag Sowas hast Du doch gar nicht!");
    return -1;
  }

  am = KMASTER->GetAmount(to);

  if(present(what, TP)->QueryProp(P_AMOUNT) < am)
  {
    command_me("sag Du hast zu wenig zum tauschen! Ich verlange "+
	       am+" gleiche Edelsteine!");
    return -1;
  }

  deal = call_other(KMASTER, "deal", what, to);
  
  if(deal == -1)
  {
    command_me("sag Sowas kannst Du hier nicht tauschen!");
    return -1;
  }
  if(deal == 1)
  {
    if(present(to, TP)) present(to, TP)->AddAmount(1);
    else  clone_object("/obj/gems/"+to)->move(TP, M_GET|M_NOCHECK);
    present(what, TP)->AddAmount(-(KMASTER->GetAmount(to)));
  
    write("Du tauschst ein paar Edelsteine mit dem Echsenmagier.\n");
    tell_room(ENV(TO), BS(TPN+" tauscht Edelsteine mit dem Magier."), ({TP}));
    command_me("sag Danke fuer den Tausch!");
  }

//  log_file(LOG "edelsteintausch", 
//	     ctime(time())+": "+file_name(TP)+" tauscht "+what+" gegen "+to+".\n", 78, 1);

  return 1;
}

void die(int poisondeath)
{
  object *ior, sp;
  int i;
  switch(random(3))
  {
    default: SetProp(P_DIE_MSG, " explodiert in einer blaeulichen Wolke.\n");
	    SetProp(P_KILL_NAME, "Die Rache des Echsenmagiers");
	    ior=filter_array(all_inventory(ENV(TO)), #'interactive);
	    ior-=({TO});
	    for(i=0; i < sizeof(ior); ++i)
	    {
	      ior[i]->do_damage(50+random(50), TO);
	    }
	    break;
    case 2: ior=filter_array(all_inventory(ENV(TO)), #'interactive);
	    ior-=({TO});
	    sp=ior[random(sizeof(ior))];
	    tell_object(sp, BS("Deine Zunge fuehlt "
	                "sich ploetzlich so seltsam an..."));
	    clone_object(OBJ "echsisch")->move(sp, M_NOCHECK);
	    break;
    case 1:SetProp(P_DIE_MSG, " erhebt sich nach seinem Tod zum Unleben!\n");
	    ior=all_inventory(TO);
	    sp=clone_object(NPC "undead");
	    for(i=0; i<sizeof(ior); ++i)
	    {
	      ior[i]->move(sp, M_NOCHECK);
	    }
	    sp->move(ENV(TO), M_NOCHECK|M_SILENT);
	    break;
  }
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "fies":
      call_out("reaction", 0, TP,
        "blickt Dich finster an.",
        "blickt "+TPN+" finster an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

