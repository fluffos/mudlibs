#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein vergilbter Zettel");
  SetProp(P_LONG,
    "Auf dem Zettel erkennst Du eine Gestalt, die mit Hilfe eines "
    "blauen Flaeschchens einen Blumentopf bewaessert."
  );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "vergilbt");
  AddId("zettel");
  AddAdjective( ({"vergilbter","vergilbtes","vergilbtem","vergilbten"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
}

void reset()
{
  ::reset();
  remove();
}
