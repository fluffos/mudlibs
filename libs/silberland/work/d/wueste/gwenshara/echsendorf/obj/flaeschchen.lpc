#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein blaues Flaeschchen");
  SetProp(P_LONG,
    "In diesem Flaeschchen befindet sich eine hochmagische Fluessigkeit."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, BS("Diese Fluessigkeit laesst Pflanzen wachsen."));
  SetProp(P_NAME, "Flaeschchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "blau");
  AddId( ({"flasche","flaeschchen", "\nechs_kanne"}) );
  AddAdjective( ({"blaues","blauen","blauem"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS:50, MAT_MISC_FLUID:40, MAT_MISC_MAGIC:10]) );
  SetProp(P_WEIGHT, 60);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_MAGIC, 1);

}
