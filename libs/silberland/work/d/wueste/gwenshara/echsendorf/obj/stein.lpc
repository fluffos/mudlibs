#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Stein");
  SetProp(P_LONG,
    "Dieser Stein ist rund." );
  SetProp(P_NAME, "Stein");
  SetProp(P_GENDER, MALE);
  AddId(({"stein","\ngwenshi_stein"}));

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}
