#include "../def.h"

inherit "std/container";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schuppenbeutel");
  SetProp(P_LONG,
    "Dieser Beutel besteht aus den Schuppen einer Schlange. Die einzelnen "
    "Schuppen glitzern in den Farben des Regenbogens.");
  SetProp(P_NAME, "Schuppenbeutel");
  SetProp(P_GENDER, MALE);
  AddId( ({"beutel","schuppenbeutel"}));

  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);

  SetProp(P_MAX_WEIGHT, 15000);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_WEIGHT_PERCENT, 50);
}
