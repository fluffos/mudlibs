inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "leiche", "geierleiche","geier","\ngeier_leiche" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Leiche eines Geiers");


  SetProp(P_SHORT, "Die Leiche eines Geiers");
  SetProp(P_LONG,
    "Das hier ist die Leiche eines Geiers.");

  SetProp(P_WEIGHT, 4000);       
  SetProp(P_VALUE, 0);         
  SetProp(P_MATERIAL,
      ([ MAT_FLESH : 100 ]) );      

  SetProp(P_SMELL,
      "Ih! Die schimmelt ja schon!");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,10 }), 
         F_SOAK    : 20,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Gierig isst Du die Leiche des Geiers.\nLecker!",
         F_MSG_ROOM: "isst schmatzend eine Geierleiche.",
         F_VERB    : "essen"    
      ]) );                     
}
