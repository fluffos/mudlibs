inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "rinde", "aspirin","weidenrinde" }) );

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Weidenrinde");


  SetProp(P_SHORT, "Ein Stueck Weidenrinde");
  SetProp(P_LONG,
    "Die Weidenrinde, auch Aspirin gennant, wurde von einem Weidenast "
    "abgeschaelt und getrocknet. Wie du sicher weisst hilft Aspirin bei "
    "einigen kleineren Beschwerden.");

  SetProp(P_WEIGHT, 400);       
  SetProp(P_VALUE, 30);         
  SetProp(P_MATERIAL,
      ([ MAT_MISC_DRUG : 100 ]) );      

  SetProp(P_SMELL,
      "Du riechst das Gwenshara nur Dank Nessa diese Rinde geschaffen hat.\n");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ -1,0 }), 
         F_SOAK    : 5,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : -(random(2)+1),        
         F_MSG     : "Du wuergst das Aspirin runter und merkst sofort das es Dir besser geht.",
         F_MSG_ROOM: "wuergt etwas Aspirin runter.",
         F_VERB    : "essen"    
      ]) );                     
}
