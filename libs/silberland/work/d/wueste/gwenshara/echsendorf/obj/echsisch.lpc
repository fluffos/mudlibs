// Ein bloeder Sprachfluch by Gwenshara@Silberland

inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include <moredef.h>

object owner;

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_NAME, "");

  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_INVIS, 1);
  AddId (({"\nsprachfluch", "\nechs_fluch"}));

  owner = 0;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();

  if(owner) owner->SetProp(P_PERM_STRING, 0);
  tell_object(owner, BS("Deine Zunge fuehlt sich wieder normal an."));
  remove(1);
}


void init()
{
  ::init();

  catch(TP->QueryProp(P_PERM_STRING)->remove(1));

  if(owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner = 0;
  }

  if(TP && interactive(TP) && environment(TO) == TP)
  {
    owner = TP;
    owner->SetProp(P_PERM_STRING, this_object());
  }
}

string permutate_string (string str)
{
  string s, c;
  int i, n;

  s = "";
  n = strlen(str);
  for(i=0;i<n;i++)
  {
    c = str[i..i];

    switch(c)
    {

      case "z": s +=  "zs"; break;
      case "a": s +=  "ahh"; break;
      case "s": s +=  "sss"; break;
      case "r": s +=  "rsh"; break;
      case "h": s +=  "hsssh"; break;
      case "c": s +=  "csss"; break;
      case "f": s +=  "fs"; break;
      case "v": s +=  "fs"; break;
      case "k": s +=  "ksss"; break;
      case "x": s +=  "kssss"; break;
      case "sch": s +=  "sssssh"; break;
	  case "ss": s += "sz"; break;

      case "Z": s +=  "Zs"; break;
      case "A": s +=  "Ahh"; break;
      case "S": s +=  "Sss"; break;
      case "R": s +=  "Rsh"; break;
      case "H": s +=  "Hsssh"; break;
      case "C": s +=  "Csss"; break;
      case "F": s +=  "Fs"; break;
      case "V": s +=  "Fs"; break;
      case "K": s +=  "Ksss"; break;
      case "X": s +=  "Kssss"; break;
      case "Sch": s +=  "Sssssh"; break;

      default : s += c;      break;
    }
  }

  return s;
}

