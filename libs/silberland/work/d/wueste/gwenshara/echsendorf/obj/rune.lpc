#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Rune");
  SetProp(P_LONG,
    "Diese Rune stellt ein seltsames, verschlunges Zeichen da." );
  SetProp(P_INFO, "Hiermit kann man vielleicht einen magischen Mechanismus blockieren.");
  SetProp(P_NAME, "Rune");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rune","\nechs_rune"}) );

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);

  AddDetail( ({"zeichen"}),
     "Das Zeichen ist Dir unbekannt.");
}
