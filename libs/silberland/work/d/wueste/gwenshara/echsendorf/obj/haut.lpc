
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schlangenhaut");
  SetProp(P_LONG,
    "Eine schillernde Schlangenhaut." );
  SetProp(P_NAME, "Schlangenhaut");
  SetProp(P_GENDER, FEMALE);
  AddId(({"haut","schlangenhaut","\ngwenshara_schlangenhaut"}));

  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);

}
