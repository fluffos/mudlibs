// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Du schlenderst die Palisade entlang. Im Westen erblickst Du ein "
  +"groesseres, blaeulich glimmendes Haus. Im Suedosten dagegen "
  +"befindet sich das Eingangstor. Die Palisade ist hier in "
  +"einem ueberaus gutem Zustand. Der Boden hier ist mit feinstem "
  +"Wuestensand bedeckt, kein Stein liegt dort. Hier herrscht "
  +"ein leichter Luftzug, der es etwas ertraeglicher macht. "
  +"Am Horizont erkennst Du eine kleine Wolkenbank und wenn Du "
  +"ueber die Palisade blickst siehst Du eine Gruppe von "
  +"Menschen auf das Dorf zukommen.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "Der Boden ist hier mit feinstem Wuestensand bedeckt, kein noch "
           +"so kleiner Stein liegt hier herum.\n" );

  AddDetail( ({"stein","steine"}), 
            "Hier findest Du wirklich keinen einzigen.\n" );

  AddDetail( ({"sand","wuestensand"}), 
            "Hier liegt feinkoerniger Sand am Boden.\n" );

  AddDetail( ({"tor","eingangstor"}), 
            "Das grosse Eingangstor liegt im Suedosten von hier.\n" );

  AddDetail( ({"gruppe","menschen"}), 
            "Dort draussen in der Wueste erkennst Du eine Gruppe "
           +"Menschen, die sich auf Dich zu bewegt. Nein, bei "
           +"genauerem Hinsehen erkennst Du, dass es doch nur "
           +"eine Fatamorgana ist.\n" );

  AddDetail( "fatamorgana", 
            "Dort draussen in der Wueste ist eine. Sie tut gerade so, als sei "
           +"sie eine Gruppe von Menschen, die hier herkommt.\n" );

  AddDetail( "haus", 
            "Im Westen erkennst Du ein blauelich schimmerndes Haus, Du "
           +"solltest es mal besuchen.\n" );

  AddDetail( "himmel", 
            "Er ist strahlend blau und am Horizont erkennst Du eine "
           +"kleine Wolkenbank.\n" );

  AddDetail( ({"wolken","wolkenbank"}), 
            "Ganz weit weg, am Horizont erblickst Du eine Wolkenbank.\n" );

  AddDetail( "horizont", 
            "Dort, am Horizont, erkennst Du eine Wolkenbank.\n" );

  AddDetail( "dorf", 
            "Das Dorf hier wird von Echsenmenschen bewohnt.\n" );

  AddDetail( "wueste", 
            "Hinter der Palisade beginnt die Wueste.\n" );

  AddDetail( "luftzug", 
            "Ein leichter Luftzug macht es hier gleich ertraeglicher.\n" );

  AddDetail( ({"palisade","palisadenzaun"}), 
            "Die Palisade ist hier in sehr gutem Zustand. Sie besteht "
           +"aus aneinander gereihten Baumstaemmen.\n" );

  AddDetail( ({"staemme","baumstaemme","stamm","baumstamm"}),
            "Jeder Baumstamm ist sorgfaeltig an den anderen gereiht worden.\n" );

  AddDetail( "zustand", "Der Zustand der Palisade hier ist sehr gut.\n" );

  AddDetail( ({"echsenmensch","echsenmenschen","echse"}), 
            "Die Echsenmenschen bewohnen das Dorf hier.\n" );
//-----Details Ende-----

  AddExit("westen", ROOM "ges_5");
  AddExit("suedosten", ROOM "ges_3");
}
