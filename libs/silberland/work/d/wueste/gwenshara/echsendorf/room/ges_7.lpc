// von Gwenshara
// 7.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Hier befindest Du Dich vor einem grossen Tor. "
  +"Es wurde geoffnet und fuehrt in einen hohen Turm. "
  "Hier ist es wenigstens etwas schattiger, "
  +"da Du hier genau im Schatten des Tempels stehst. "
  +"Im Sueden macht der Weg eine Biegung nach "
  +"Suedosten und im Nordosten geht es in die "
  +"Richtung eines grossen blaeulich schimmernden "
  +"Hauses. Oestlich von Dir liegt der Tempel.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----

  AddDetail("turm",
            "Der Turm ist dreistoeckig. Er ist aus Palmenholz und "
	    "Lehm gefertigt. Ein grosses Tor fuehrt in sein Inneres, "
	    "in dem kuehlender Schatten ist.");

  AddDetail(({"inneres", "inneren"}),
            "Im Inneren des Turms ist es angenehm kuehl und schattig. "
	    "Du solltest vielleicht hinein gehen.");
		  
  AddDetail( "biegung", 
            "Im Sueden macht der Weg eine Biegung nach Suedosten.\n" );

  AddDetail( "boden", 
            "Der Boden ist mit Sand bedeckt. Hin und wieder liegen hier "
           +"ein paar kleinere Steine herum.\n" );

  AddDetail( ({"stein","steine"}), 
            "Ein paar Steine liegen am Boden herum. An ihnen ist "
           +"nichts Auffaelliges.\n" );

  AddDetail( "auffaelliges", "Ja, eben das ist nicht da.\n" );

  AddDetail( "tor", 
            "Das Tor ist ungefaehr genauso gross wie das am Dorfeingang. "
           +"Es besteht aus aneinandergezimmerten Palmenstaemmen. Es wurde "
	   "geoffnet und fuehrt in einen dreistoeckigen Turm." );

  AddDetail( ({"staemme","palmenstaemme"}), 
            "Die Palisade und das Tor bestehen aus Palmenstaemmen.\n" );

  AddDetail( ({"bretter","holzbretter"}), 
            "Die Bretter, mit denen das Tor verkeilt wurde sind "
           +"auch aus Palmenholz gefertigt, sie sind so in den Boden "
           +"gerammt das Du sie sicher nicht bewegen kannst.\n" );

  AddDetail( ({"haus","hauses"}), 
            "Im Nordosten geht es auf ein blaeulich schimmerndes Haus zu.\n" );

  AddDetail( "himmel", 
           "Die Sonne brennt vom Himmel, als wuerde sie dich wegschmelzen "
          +"wollen.\n" );

  AddDetail( "sonne", 
            "Sie brennt so stark, dass Du hoffst keinen Sonnenbrand davon "
           +"zu tragen.\n" );

  AddDetail( ({"sonnenbrand","angelegenheit"}),
            "So ein Sonnenbrand ist eine ganz schoen unangenehme "
           +"Angelegenheit.\n" );

  AddDetail( "schatten", 
            "Da Du hier im Schatten des Tempels stehst ist es "
           +"etwas ertraeglicher.\n" );
 
  AddDetail( ({"tempel","tempels"}), 
            "Du stehst hier genau im Schatten des Tempels, welcher im "
           +"Osten steht.\n" );

  AddDetail( ({"weg","innenseite"}), 
            "Der Weg fuehrt hier an der Innenseite der Palisade entlang. Du "
           +"kannst ihm nach Nordosten und Sueden folgen.\n" );

  AddDetail( ({"sand","wuestensand"}), 
            "Hier liegt ganz feiner Wuestensand herum.\n" );

  AddDetail( ({"palmenholz","holz"}), 
            "So wird das Holz der Palmen genannt.\n" );

  AddDetail( ({"palmen","palme"}), 
            "Hier sind leider keine.\n" );

  AddDetail( "palisade", "Sie fuehrt rund ums Dorf herum.\n" );

  AddDetail( "dorfeingang", 
            "Da ist genauso ein Tor wie hier, allerdings ist dieser "
           +"auf der anderen Seite des Dorfes.\n" );

  AddDetail( ({"dorf","dorfes"}), 
            "Du bist hier in einem von Echsenmenschen bewohnten Dorf.\n" );

  AddDetail( ({"echsen","echsenmenschen"}), 
            "Die leben hier in diesem Dorf.\n" );

  AddDetail( ({"seite","eingangstor"}), 
            "Das Eingangstor ist nicht auf dieser.\n" );

  AddDetail(({"lehm", "erdenart"}),
	    "Lehm ist eine besondere Erdenart.");
//-----Details Ende-----

  AddExit("nordosten", ROOM "ges_6");
  AddExit("sueden", ROOM "ges_8");
  AddExit("westen", ROOM "turm_e");
}
