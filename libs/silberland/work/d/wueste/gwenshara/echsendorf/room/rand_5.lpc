// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Oestlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Am Boden siehst Du irgendwas "
   "gruenes." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( ({"irgendwas","gruenes","irgendwas gruenes"}),
             "Am Boden faellt Dir ploetlich eine Pflanze auf.");

  AddDetail( "pflanze", "Ob das eine Kaktus ist?");

  AddDetail( "Kaktus", "Das ist wohl eher ein Kakteensproessling.");

  AddDetail( ({"sproessling","kakteensproessling"}), 
             "Dieser Sproessling wird sicher ein ganz grosser Kaktus.");

//-----Details Ende-----

  AddExit("nordosten", ROOM "rand_4");
  AddExit("sueden", ROOM "rand_12");
  AddExit("norden", DESERT "62:6");
  AddExit("nordwesten", DESERT "61:6");
  AddExit("westen", DESERT "61:7");
  AddExit("suedwesten", DESERT "61:8");
}

string sand(){
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
