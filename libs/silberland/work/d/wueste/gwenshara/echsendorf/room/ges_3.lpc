// von Gwenshara
// begonnen: 1.7.2003
// 
// Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Du befindest dich jetzt hinter dem Tor, das zurueck in die "
  +"Weiten der Wueste fuehrt. Auf dieser Seite ist das Tor "
  +"nicht so schoen verziehrt. Im Westen erkennst Du eine "
  +"seltsame Schale. Die Behausungen, die du hier siehst sind "
  +"allesamt rund gebaut worden und bestehen aus Lehmerde und "
  +"sind eher niedrig. Ganz weit im Westen erkennst Du einen "
  +"etwas groesseren Lehmbau, dessen Eingang mit einem Tuch verhaengt "
  +"ist. Der Boden hier besteht aus festgetretenem Lehm, aus dem "
  +"vermutlich auch die Haeuser gemacht sind. Seltsam unbekannter "
  +"Duft steigt die hier in die Nase.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "seite",
            "Auf dieser Seite ist das grosse Tor nicht so schoen verziert, "
           +"es besteht nur aus aneinandergezimmerten Baumstaemmen.\n" );

  AddDetail( ({"staemme","baumstaemme","baumstaemmen","palmenstaemme"}),
            "Einfache Palmenstaemme, nichts besonderes, aber wie sie "
           +"hier her kommen ist Dir nicht ganz klar.\n" );

  AddDetail( ({"weiten"}),
            "Die unendlichen Weiten der Wueste. Sie zeigen unendlich "
            +"viel Sand.\n" );

  AddDetail( "sand", "In der Wueste gibt es eine Menge davon.\n" );

  AddDetail( "schale",
            "Sie befindet sich etwas weiter westlich von dir. Es sieht "
           +"so aus als, sei sie mit Kohlen gefuellt.\n" );

  AddDetail( ({"kohle","kohlen"}),
            "Es scheint als sei die Schale im Westen damit gefuellt. Um"
           +" naeheres zu erkennen solltest Du dort hin gehen.\n" );

  AddDetail( ({"behausungen","haeuser","haus","behausung"}),
            "Sie wurden alle rund und niedrig gebaut. "
           +"Du meinst das sie aus Lehmerde bestehen.\n" );

  AddDetail( ({"erde","lehmerde","lehm"}),
            "Die Erde hier ist eine gelbe Lehmart, die es nur hier zu finden "
           +"gibt.\n" );

  AddDetail( ({"art","lehmart"}), "Die gibt es nur hier zu finden.\n" );

  AddDetail( ({"lehmbau","eingang","tuch","bau"}),
           "Von hier aus leider nicht gut zu erkennen, versuchs doch mal "
          +"weiter im Westen.\n" );

  AddDetail( "duft", "Riech ihn doch mal.\n");

  AddDetail( "boden", "Er besteht aus festgetretener Lehmerde.\n" );

  AddDetail( "essen", "Ist leider keines da.\n" );

  AddDetail( "himmel", "Er ist himmelblau.\n" );

  AddDetail( "luft", "Durchsichtig und du brauchst sie zum Atmen.\n" );

  AddDetail( "nase", "Du hast eine mitten im Gesicht.\n" );

  AddDetail( "atmen", "Dazu ist die Luft zu gebrauchen.\n" );

  AddDetail( "gesicht", "Die Flaeche wo deine Nase drauf ist.\n" );

  AddDetail( "wueste", 
            "Die Wueste ist ein trockener und trostloser, sehr "
           +"sandiger Ort.\n" );

  AddDetail( "ort", "Was fuer ein Ort genau?\n" );

  AddDetail( ({"flaeche","flaechen"}), "Flaechen sind meistens flach.\n" );

  AddDetail( "menge", "In der Wueste gibt es eine Menge Sand.\n" );

  AddDetail( "wasser", "Hast Du Dir etwa mitten in der Wueste Wasser erwartet?");
//-----Details Ende-----

  AddSmell( DEFAULT_SMELL, "Ein seltsamer Duft liegt in der Luft.\n");

  AddSmell( "duft",
           "Du kannst ihn nicht wirklich zuordnen. Vermutlich ist "
          +"es Essen.\n" );
  AddSmell( "essen", "Dir laeuft das Wasser im Mund zusammen.\n");

  NewDoor( "osten", ROOM "tges_2","tor",
           ({ D_NAME,"Tor",
              D_GENDER,NEUTER,
              D_SHORT,"Ein grosses %ses Tor.",
              D_LONG,
             "Auf dieser Seite ist das grosse Tor nicht so schoen "
            +"verziert. Es besteht nur aus aneinandergezimmerten "
            +"Baumstaemmen.\n"
           }) );

  AddItem( NPC "echswache", REFRESH_DESTRUCT);

  AddExit("westen", ROOM "eroom");
  AddExit("nordwesten", ROOM "ges_12");
  AddExit("suedwesten", ROOM "ges_11");
}
