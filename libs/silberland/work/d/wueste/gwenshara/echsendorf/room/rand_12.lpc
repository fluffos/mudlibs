// der Weg um das Echsendorf herum

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Suedlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Im Osten steigt Rauch auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( "rauch",
	     "Im Osten steigt Rauch auf. Vielleicht befindet sich im "
	     "Talkessel eine Siedlung.\n");
  AddDetail( ({"siedlung","talkessel","kessel"}),
	     "Dort unten befindet sich vermutlich eine Siedlung.\n" );

//-----Details Ende-----

  AddExit("sueden", ROOM "rand_6");
  AddExit("norden", ROOM "rand_5");
  AddExit("nordwesten", DESERT "61:7");
  AddExit("westen", DESERT "61:8");
  AddExit("suedwesten", DESERT "61:9");
}

string sand(){
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
