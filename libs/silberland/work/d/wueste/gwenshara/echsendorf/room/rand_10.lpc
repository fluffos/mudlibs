// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Westlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Vor Dir ist ein seltsames "
   "Feld." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( "feld", "Huch, das ist Treibsand. Da solltest Du nicht hinein "
             "steigen.");

  AddDetail( "treibsand", "Treibsand ist sehr gefaehrlich.");

//-----Details Ende-----

  AddExit("suedwesten", ROOM "rand_9");
  AddExit("norden", ROOM "ttges_1");
  AddExit("sueden", DESERT "66:10");
  AddExit("suedosten", DESERT "67:10");
  AddExit("osten", DESERT "67:9");
  AddExit("nordosten", DESERT "67:8");
}

string sand(){ 
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
