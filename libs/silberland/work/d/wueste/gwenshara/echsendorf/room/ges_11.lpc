// von Gwenshara
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Du befindest Dich hier auf einem kleinen Stueckchen Weg, "
  +"welches vom Tor her um das ganze Dorf herum, immer der "
  +"Palisade folgend verlaeuft. Westlich von Dir befindet sich ein "
  +"Haus. Nach Nordosten hin fuehrt der Weg zu einem grossen "
  +"Tor. Aus dem Boden wachsen spaerliche Wuestengraeser. "
  +"Unter der Palisade zwaengen sich kleine Straeucher durch "
  +"und die Luft steht hier schon fast, was die Hitze nicht "
  +"gerade ertraeglicher macht. Fast waerst Du ueber einen "
  +"Stein gestolpert.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "Der Boden ist sehr sandig, also mit Sand bedeckt. "
           +"Ein paar kleine Steine liegen auf ihm herum. "
           +"Ein paar Wuestengraeser wachsen aus ihm empor.\n" );

  AddDetail( ({"stein","stein","steine"}), 
            "Ein paar Steine ohne Besonderheiten liegen am Weg herum.\n" );

  AddDetail( "besonderheiten", 
            "An den Steinen findest Du keine, sie sind einfach ganz "
           +"normale Steine.\n" );

  AddDetail( "dorf", 
            "Dieses Dorf hier, in dem Du Dich befindest, wird von "
           +"Echsenmenschen bevoelkert.\n" );

  AddDetail( "haeuser", 
            "Westlich von Dir befindet sich ein Haus.\n" );

  AddDetail( "haus", 
            "Das Haus westlich von Dir ist flach und aus Lehm gebaut. "
           +"Einen Eingang findest Du leider nicht.\n" );

  AddDetail( "eingang", 
            "Leider findest Du an dem Haus keinen, also kannst Du "
           +"es nicht betreten.\n" );

  AddDetail( "himmel", 
            "Der Himmel strahlt richtig vor Blaeue.\n" );

  AddDetail( ({"blaeue","blau"}), 
            "Der Himmel ist so blau das er regelrecht vor Blaeue strahlt.\n" );

  AddDetail( "hitze", 
            "Dadurch das die Luft hier fast steht, ist die Hitze kaum "
           +"zu ertragen.\n" );

  AddDetail( "luft", 
             "Die Luft hier flimmert und ist unertraeglich heiss.\n" );
  
  AddDetail( ({"palisade","palisadenzaun"}), 
            "Die Palisade besteht aus aneinander gereihten Baumstaemmen. "
           +"Unter ihr zwaengen sich kleine Straeucher durch.\n" );

  AddDetail( ({"straeucher","wuestenstraeucher"}), 
            "Ein paar kleine, duerre Wuestenstraeucher zwaengen sich unter "
           +"der Palisade durch.\n" );

  AddDetail( ({"graeser","wuestengraeser"}), 
            "Ein paar duerre Graeser wachsen hier aus dem Boden.\n" );

  AddDetail( ({"stueckchen","weg"}), 
            "Dieses Stueckchen Weg fuehrt zum Tor hin, oder weg, je nach "
           +"Sichtweise.\n" );

  AddDetail( "sichtweise", 
            "Je nach Sichtweise fuehrt dieser Weg zum Tor oder davon weg.\n" );

  AddDetail( "tor", "Es liegt im Nordosten.\n" );

  AddDetail( "sand", "Der Boden ist voll mit Sand.\n" );

  AddDetail( "lehm", "Der Boden besteht vermutlich aus Lehm.\n" );

  AddDetail( ({"baumstaemme","baumstaemmen","staemme"}),
             "Die Palisade wurde aus aneinader gereihten Baumstaemmen gefertigt.\n" );

  AddDetail( ({"echsenmensch","echsenmenschen","echse"}), 
            "Die Echsenmenschen bewohnen das Dorf hier.\n" );
//-----Details Ende-----

  AddExit("suedwesten", ROOM "ges_10");
  AddExit("nordosten", ROOM "ges_3");
}
