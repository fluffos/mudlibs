#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

int geier=1, stein=1;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Du gehst hier die Palisade entlang. Hin und wieder kannst Du durch "
   "Ritzen in der Palisade hinaus spaehen. Allerdings siehst Du dort "
   "immer nur Duenen. Die Sonne brennt vom Himmel und ein heisser Wind "
   "weht durch die Ritzen der Palisade. Der Weg fuehrt nach Suedwesten "
   "die Palisade weiter entlang. Von hier aus im Sueden liegt der "
   "Tempel. Im Suedwesten erspaehst Du ein versperrtes Tor.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );
//-----Details Anfang-----

  AddDetail( ({"palisade","palisadenzaun","zaun"}),
            "Die Palisade besteht aus aneinander gereihten "
            "Palmenstaemmen.\n" );

  AddDetail( ({"staemme","palmenstaemme"}), 
            "Die Palmenstaemme wurden der Reihe nach "
            "in den Boden gerammt und bilden so einen festen Zaun.\n");

  AddDetail( "reihe",
             "Einer nach dem Anderen.");

  AddDetail( ({"einer", "anderen"}),
	     "Praktisch eine Reihe.");

  AddDetail( ({"duene","duenen"}), 
           "Wenn Du durch die Ritzen zwischen den Staemmen "
           "spaehst, siehst Du weit und breit nur Duenen.\n" );

  AddDetail( "sonne", "Die Sonne brennt unbarmherzig vom Himmel.\n" );

  AddDetail( "himmel", 
            "Der Himmel ist tief blau und klar, Du erkennst in grosser Hoehe "
            "sogar eine Gruppe von Voegeln, die dort kreist.\n" );

  AddDetail( ({"voegel","voegeln","gruppe"}), 
            "In grosser Hoehe am Himmel kreist eine "
            "Gruppe Voegel, vermutlich sind es Geier.\n" );

  AddDetail( "geier", 
            "Oben am Himmel kreist eine Gruppe Geier, vermutlich warten sie "
            "auf Beute, hoffentlich bist Du nicht ihre Beute.\n" );

  AddDetail( "beute", 
             "Die Geier, die dort oben am Himmel kreisen warten auf welche. "
             "Einer der Voegel fliegt etwas tiefer, vielleicht kannst Du ihn "
             "mit einem Stein ab schiessen.\n");

  AddDetail( "stein", 
             "Da am Boden liegt einer. Damit kannst Du vielleicht einen "
             "der Geier abschiessen.\n" );

  AddDetail( "boden", 
             "Am Boden liegt eine Menge Sand, unter anderem auch ein Stein.\n");

  AddDetail( "wind", "Ein heisser Wind weht durch die Ritzen der Palisade.\n");

  AddDetail( ({"ritze","ritzen"}), 
            "Durch die Ritzen der Palisade hindurch weht ein heisser "
            "Wind, wenn Du hindurch spaehst kannst Du weit und breit "
            "nur Duenen erkennen.\n");

  AddDetail( "weg", 
             "Der Weg fuehrt nach Suedwesten zu einem Tor.\n" );

  AddDetail( "tor", 
             "Das Tor liegt im Suedwesten und ist geoeffnet." );

  AddDetail( "hoehe", "Ganz in der Hoehe fliegen Geier herum.\n" );

  AddDetail( "tempel", "Der steht im Sueden von hier.\n" );

  AddDetail( "sand", "Der Sand hier ist von der Sonne ausgebleicht und ockerfarbig.");

//-----Details Ende-----

  AddSmell( DEFAULT_SMELL, 
            "Hier riecht es nach dem Wind der Wueste.\n" );
  AddSmell( ({"wind","wueste"}), 
            "Du riechst nichts Besonderes im Wind der Wueste.\n" );

  AddSmell( "besonderes", "Ja genau das riechst Du eben nicht!\n" );

  AddSound( DEFAULT_SOUND, 
           "Du hoerst den Wind wie er ueber die Palisade weht und durch "
           "die Ritzen pfeift. Weiters hoerst Du die Schreie einiger "
           "Voegel.\n");
  AddSound( "wind", 
           "Der Wind weht ueber die Palisade und pfeift durch die Ritzen.\n" );

  AddSound( ({"schreie","schreien","voegel","voegeln","geier","geiern","rufe","rufen"}), 
           "Die Rufe der Geier ertoenen hoch am Himmel.\n" );
  
  AddCmd( ({"wirf","werfe","schiess","schiesse"}),"cmd_geier");
  AddCmd( ({"nehme","nimm"}),"cmd_nimm");

  AddItem( NPC "echswache", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "ges_5");
  AddExit("suedwesten", ROOM "ges_7");
}

int cmd_nimm(string str)
{
  object stei;
  
  notify_fail("WAS nehmen?\n");
  if(!str || str == "") return 0;
  if(!(str == "stein")) return 0;
  
  if(!stein){
    write("Du findest gerade keinen geeigneten Stein.\n");
    return 1;
  }
  
  if(present("\ngwenshi_stein", TP)) { 
    write("Du hast doch schon einen Stein!\n");
    return 1;
  }

  stei=clone_object(OBJ "stein");

  if( ME_TOO_HEAVY == stei->move(TP,M_GET) ){
    write(BS("Da Du nichts mehr schleppen kannst, so suchst Du gar "
	     "nicht mehr nach einem Stein.\n"));
      return 1;
  }
  
  write("Du nimmst einen Stein.\n");
  say(TPN+" nimmt einen Stein.\n");
  
  stein--;
  return 1;
}


int cmd_geier(string str)
{
  object leiche;

  notify_fail("Was moechtest Du nach wem schiessen?\n");
  if(!str || str == "") return 0;
  if(!(str == "stein nach geier" ||
       str == "stein nach geiern" ||
       str == "stein auf geier" ||
       str == "geier mit stein ab" )) return 0;
  
  if(!present("\ngwenshi_stein", TP)) { //hat der Spieler einen Stein?
    write("Du hast doch gar keinen Stein!\n");
    return 1;
  }
  if(geier){ //ist ein Geier da?
    leiche=clone_object(OBJ "geier_leiche");
    if(ME_TOO_HEAVY == leiche->move(TP, M_GET) ){//kann er noch was tragen?
      say("Die Leiche eines Geiers faellt vom Himmel.\n");
      leiche->move(ENV(TP));
      geier--;
      return 1;
    }
    
    write("Du zielst und wirfst den Stein nach den Geiern.\n"
	  "Ploetzlich faellt Dir die Leiche von einem Geier "
	  "in die Arme.\n");
    say(TPN+" faengt eine Geierleiche auf.\n");
    
    present("\ngwenshi_stein",TP)->remove();
    geier--;
  }
  
  else {
    write("Du wirfst den Stein und er faellt ueber den Zaun in die Wueste.\n");
    present("\ngwenshi_stein",TP)->remove();
    say(TPN+" wirft einen Stein in die Wueste.\n");
  }
 
  return 1;
}

void reset(){
  ::reset();
 
  geier=1;
  stein=1;
}
