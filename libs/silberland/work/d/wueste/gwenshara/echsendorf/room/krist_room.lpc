#include "../def.h"

inherit "std/room";

string liste();

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer duesteren Huette");
  SetProp(P_INT_LONG,
    "Die Huette, in die Du soeben getreten bist, ist duester und karg "
    "eingerichtet. In mitten der Huette befindet ein schmales Podest aus "
    "Opal, auf dem ein Stueck Aquamarin liegt. An der Ostwand steht ein "
    "sauberes Bett. Die Westwand wird von einem Buecherregal eingenommen, "
    "waehrend sich an der Nordwand ein Fenster befindet. An der Ostwand "
    "haengt eine Liste.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "huette" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "podest", "mitte" }),
    "Auf dem Podest liegt ein Stueck, bereits zur Haelfte geschliffener, "
    "Aquamarin. Daneben liegen einige Werkzeuge zum schleifen und polieren "
    "von Edelsteinen.");

  AddDetail( ({ "opal" }),
    "Das Podest in der Mitte der Huette wurde aus Opal geschliffen. Es ist "
    "etwa huefthoch.");

  AddDetail( ({ "aquamarin", "stueck", "edelstein" }),
    "Der Aquamarin ist bereits zur Haelfte fertig geschliffen.");

  AddDetail( ({ "ostwand", "bett" }),
    "An der Ostwand steht ein sauberes, faltenfreies und scheinbar selten "
    "benutztes Bett. Auf ihm liegen eine Decke und ein Kissen. Ueber dem "
    "Bett haengt eine Liste.");

  AddDetail( ({ "westwand", "regal", "buecherregal" }),
    "Das Buecherregal ist aus Obsidian gemacht und hat drei Faecher. Alle "
    "Buecher darin sind ohne Beschriftung. Man kann sie nur anhand der Farben "
    "unterscheiden.");

  AddDetail( ({"obsidian"}),
    "Obsidian ist ein bestimmter Edelstein.");

  AddDetail( ({ "nordwand", "fenster" }),
    "Durch das Fenster an der Nordwand fallen ein paar wenige Sonnenstrahlen "
    "in die Huette.");

  AddDetail( ({ "werkzeug", "werkzeuge", "pinzetten", "tuecher", "messer" }),
    "Neben dem Edelstein liegen einige Pinzetten, Tuecher und Messer.");

  AddDetail( ({ "haelfte" }),
    "Die obere Haelfte des Aquamarins ist bereits geschliffen. Du vermutest "
    "das er auf einen zwoelfkant Schliff geschliffen werden soll.");
  
  AddDetail( ({ "decke", "leinendecke" }),
    "Auf dem Bett liegt eine einfache Leinendecke. Nicht sehr bequem, aber doch "
    "ganz nuetzlich.");

  AddDetail( ({ "kissen", "kissens" }),
    "Das Kissen ist strohgefuellt und mit Leinen uberzogen. Es ist zwar "
    "steinhart, doch zum Schlafen reicht es alle mal.");

  AddDetail( ({"ueberzug", "ueberzuege", "leinen"}),
    "Die Ueberzuege des Kissens und der Decke sind aus Leinen.");

  AddDetail( ({ "faecher" }),
    "Alle drei Faecher des Regals sind mit kleinen, grossen, dicken oder duennen "
    "Buechern gefuellt.");

  AddDetail( ({ "buecher", "buch", "farben", "einband" }),
    "Jedes Buch im Regal hat einen andersfarbigen Einband.");

  AddDetail( ({ "beschriftung" }),
    "Keines der Buecher ist beschriftet.");

  AddDetail( ({ "strahlen", "sonnenstrahlen" }),
    "Allein die wenigen Sonnenstrahlen, die durch das Fenster hereinfallen, bringen "
    "Licht in die Duesternis der Huette. Du siehst feinen Edelsteinstaub in den "
    "Strahlen tanzen.");

  AddDetail( ({ "schliff", "geltung" }),
    "Damit ein Edelstein richtig zur Geltung kommt, muss er den rechten Schliff "
    "aufweisen.");

  AddDetail( ({ "licht" }),
    "Durch das Fenster faellt spaerliches Licht in die Huette.");

  AddDetail( ({ "duesternis" }),
    "Die Huette ist furchtbar duester. Nur wenig Licht gelangt durch das Fenster "
    "herein.");

  AddDetail( ({ "staub", "edelsteinstaub" }),
    "Der Staub etlicher Edelsteine schwebt in der Huette und erschwert das Atmen "
    "ungemein.");

  AddDetail( ({ "atmen", "zug", "atemzug", "qual" }),
    "Jeder Atemzug wird hier herinnen zur Qual.");

  AddDetail( ({"boden", "lehm"}),
    "Der Boden besteht, wie auch draussen, aus Lehm." );

  AddDetail( ({"waende", "wand"}),
    "Welche Wand meinst Du genau?" );

  AddDetail( ({"suedwand"}),
    "An der Suedwand befindet sich der Ausgang." );

  AddDetail( ({"liste"}), #'liste);

  AddSound( DEFAULT_SOUND,
    "Nichts ist hier zu hoeren.");

  AddSound( ({ "nichts" }),
    "Ja genau, nichts!");

  AddSmell( DEFAULT_SMELL,
    "Der Staub in der Luft laesst Dich niesen.");

  AddSmell( ({ "staub", "luft", "edelsteine", "steine", "geruch" }),
    "Die Luft ist erfuellt von dem Staub und dem Geruch vieler Edelsteine.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", "hinaus#" + ROOM "eroom" );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "kristallomant" , REFRESH_DESTRUCT);

  // liste lesen
  AddReadDetail("liste", #'liste);
}

string liste()
{
 string s, *gems;
 int i;
 gems = "/obj/gemmaster"->QueryGems();
 s = sprintf("%20-' 's%s\n", "Edelstein", "Verhaeltnis");
 s+= sprintf("%31-'-'s\n", "");
 if(!call_other(OBJ "krist_master", "isInit")) call_other(OBJ "krist_master", "ini");
 for(i=0; i<sizeof(gems); i++)
 {
   s+=sprintf("%25-' 's%s\n", capitalize(gems[i]), 
	      call_other(OBJ "krist_master", "GetAmount", gems[i])+":1");
 }

 return s;
}
