// von Gwenshara
// 7.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Hier macht der Weg, der die Palisade entlangt fuehrt eine "
  +"Biegung nach Suedosten. Im Nordosten von hier findest Du "
  +"den Tempel. Du kannst dem Weg weiter nach Suedosten, der "
  +"Palisade entlang folgen. Auch hier brennt die Sonne auf "
  +"Dich herab, als wolle sie Dich wegbrennen. An der "
  +"Palisade fallen Dir einige Kratzspuren auf. Am Boden "
  +"erblickst Du Fussspuren, die zweifelsohne von Echsenmenschen stammen.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "biegung", 
           "Der Weg kommt hier von Norden und macht eine Biegung nach "
           "Suedosten.\n" );

  AddDetail( "weg", 
           "Der Weg fuehrt die Palisade entlang und um das Echsendorf herum.\n" );

  AddDetail( ({"dorf","echsendorf"}), 
            "Du befindest Dich hier in einem von Echsenwesen "
             "bewohnten Dorf, es ist mit einer Palisade gesichert, so dass "
             "man nur durch das grosse Eingangstor ins Dorf gelangen kann.\n" );

  AddDetail( ({"palisade","zaun","palisadenzaun"}), 
           "Der Palisadenzaun fuehrt rund ums Dorf um es vor "
           "unerwuenschten Eindringlingen zu schuetzen. Hier entdeckst "
           "Du Kratzspuren an der Palisade.\n" );

  AddDetail( ({"eindringlinge","eindringlingen"}), 
            "Waere hier nicht der Palisadenzaun koennten alle moeglichen "
            "Tiere, wie zum Beispiel Loewen eindringen und Einwohner "
            "verletzen.\n" );

  AddDetail( ({"tieren","tiere","loewen"}), 
            "Die Palisade schuetzt das Dorf vor gefaehrlichen Tieren.\n" );

  AddDetail( "beispiel", 
            "Ein Beispiel fuer gefaehrliche Tiere hier waeren Loewen.\n" );

  AddDetail( ({"kratzer","kratzspuren"}), 
            "Die Kratzspuren sehen aus wie die einer Wildkatze.\n" );

  AddDetail( ({"wildkatze", "katze"}), "Ob sie noch hier im Dorf ist?\n" );

  AddDetail( "boden", 
            "Der Boden ist mit Sand bedeckt, aber sicher ist auch eine feste "
            "Lehmschicht darunter. Weiters erkennst Du im Sand einige "
            "Fussspuren.\n");

  AddDetail( ({"lehm","lehmschicht","schicht"}), 
            "Unter dem Sand am Boden ist sicher noch eine Schicht aus "
            "festem Lehm.\n" );

  AddDetail( "sand", 
            "Der Boden hier ist ueber und ueber mit feinstem Wuestensand "
            "bedeckt.\n" );

  AddDetail( "wuestensand", 
            "Sand, der aus der Wueste hier her geweht wurde.\n" );

  AddDetail( "wueste", 
            "Draussen, hinter der Palisade, liegt die Wueste.\n" );

  AddDetail( ({"fusspuren","fussspuren"}), 
            "Im Sand zeichnen sich deutlich die Spuren von "
           "Echsenmenschen ab. Vermutlich sind es die Spuren einer "
           "Wachstreife.\n" );

  AddDetail( ({"menschen","echsen","echsenmenschen","echsenwesen","einwohner","echsenmensch"}),
             "Die Echsenmenschen bewohnen das Dorf hier.\n" );

  AddDetail( "himmel", 
            "Der Himmel ist ganz klar und blau. Die Sonne brennt vom ihm herab "
           "auf Dich.\n" );

  AddDetail( "sonne", "Die Sonne sendet ihre heissen Strahlen nach Dir.\n" );

  AddDetail( ({"strahlen","sonnenstrahlen"}), 
            "Die gluehend heissen Strahlen der Sonne versengen Deine "
          "Haut.\n" );

  AddDetail( "spuren", "Meinst Du die Fussspuren, oder die Kratzspuren?\n" );

  AddDetail( "haut", "Pass bloss auf, dass Du keinen Sonnenbrand abbekommst!\n" );

  AddDetail( "sonnenbrand", 
            "Wenn Du Deine Haut weiter so der Sonne aussetzt, wirst Du "
           "einen Sonnenbrand bekommen.\n" );

  AddDetail( "tempel", 
            "Der Tempel, in dem die Echsen ihre Goettin anbeten befindet "
           "sich im Nordosten.\n" );

  AddDetail( "goettin", 
            "Die Echsenmenschen beten eine seltsame, duestere Goettin an.\n" );

  AddDetail( ({"tor","eingangstor"}), 
            "Das wirst Du vermutlich am Eingang des Dorfes finden.\n" );

  AddDetail( "eingang", "Da ist vermutlich das Eingangstor.\n" );
 
  AddDetail( ({"streife","wachstreife","wache"}), 
            "Den Spuren nach zu urteilen kommt hier regelmaessig "
           "ein Echsenmensch vorbei.\n" );
//-----Details Ende-----

   AddItem( NPC "echswache", REFRESH_DESTRUCT);
   AddExit("norden", ROOM "ges_7");
   AddExit("suedosten", ROOM "ges_9");
}
