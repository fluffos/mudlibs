#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Dorf");
  SetProp(P_INT_LONG,
    "Der Weg durch das Echsendorf fuehrt an einer Huette vorbei. Im Westen "
    "weist der Weg zu einem groesseren Platz. Im Osten geht es Richtung "
    "Tor, durch das Du das Dorf wieder verlassen kannst. Der Boden ist, wie "
    "auch sonst ueberall, aus Lehm gemacht.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "weg" }),
    "Der Weg fuehrt vom Tor im Osten zum Dorfplatz im Westen, oder umgekehrt.");

  AddDetail( ({ "dorf", "echsendorf" }),
    "Du bist hier in dem Dorf der Echsenmenschen gelandet.");

  AddDetail( ({ "huette" }),
    "Die Tuer der Huette im Norden ist geoeffnet. Vermutlich handelt es sich "
    "um ein oeffentliches Gebaeude oder etwas in dieser Art.");

  AddDetail( ({ "tuer", "holztuer" }),
    "Die einfache Holztuer der Huette ist geoeffnet.");

  AddDetail( ({ "platz", "westen", "dorfplatz" }),
    "Der Platz im Westen ist, allem Anschein nach, der Dorfplatz. Dort trifft man "
    "sich um Neuigkeiten auszutauschen.");

  AddDetail( ({ "osten", "tor" }),
    "Durch das Tor im Osten kannst Du das Dorf jederzeit wieder verlassen.");

  AddDetail( ({ "boden", "erde" }),
    "Der Boden besteht hier, wie ueberall im Dorf, aus festgetretenem Lehm. ");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt Dich wie ein Zechpreller an.");

  AddDetail( ({ "menschen", "echsen", "echsenmenschen", "gemeinschaft" }),
    "In diesem Dorf lebt eine kleine Gemeinschaft von Echsenmenschen.");

  AddDetail( ({ "gebaeude", "laden" }),
    "Das duestere Gebaeude im Norden ist ein Laden oder Aehnliches. In ihm "
    "wirkt es sehr duester, aber darin koennte es auch angenehm "
    "kuehl sein.");

  AddDetail( ({ "aehnliches"}),
    "Du stellst fest, das ist ein Laden.");

  AddDetail( ({ "anschein" }),
    "Es sieht so aus, als waere der Platz im Westen der Dorfplatz.");

  AddDetail( ({ "neuigkeiten", "neuigkeit" }),
    "Jede Neuigkeit kann am Dorfplatz beredet werden.");

  AddDetail( ({ "lehm", "erdenart" }),
    "Lehm ist eine spezielle Erdart. Es gibt sicher auch eine genauere "
    "Beschreibung dazu.");

  AddDetail( ({"beschreibung", "erdart"}),
    "Lehm ist ein Sediment, und einer der aeltesten Baustoffe der Welt. Wenn "
    "Gestein chemisch verwittert, entsteht ein Sediment - eine feine Mischung "
    "unterschiedlicher Mineralien, der Lehm. Man unterscheidet je nach "
    "Entstehung Berglehm, Gehaengelehm, Geschiebelehm, Loesslehm  und Auenlehm. "
    "Er besteht im Wesentlichen aus Ton, Sand und Schluff, dazu kommt noch "
    "Kalk. Es gibt keine klare Abgrenzung zum Ton. Tonreichen Lehm nennt man "
    "fett, tonarmen Lehm mager. Lehm ist nicht so plastisch wie Ton und auch nicht "
    "so wasserundurchlaessig, da die Sedimente im Ton kleiner sind als die im Lehm. "
    "In feuchtem Zustand ist Lehm formbar, in trockenem Zustand fest. Bei "
    "Wasserzugabe quillt Lehm, beim Trocknen schwindet er, was im Lehmbau "
    "besonders zu beachten ist.");

  AddDetail( ({"zustand"}),
     "Das ist doch kein Zustand!");

  AddDetail( ({"welt", "silberland"}),
    "Diese Welt ist das Silberland.");

  AddDetail( ({"trocknen"}),
     "Beim Trocknen schwindet der Lehm.");

  AddDetail( ({"zugabe", "wasserzugabe"}),
    "Bei Wasserzugabe quillt der Lehm auf.");

  AddDetail( ({"entstehung"}),
    "Man unterscheidet den Lehm je nach dem, wie er entstanden ist.");

  AddDetail( ({"preller", "zechpreller"}),
    "Das soll umschreiben das der Himmel strahlend blau ist." );

  AddDetail( ({"sediment", "ablagerung"}),
    "Mit Sedimenten ist hier eine Ablagerung von Erdteilchen gemeint." );

  AddDetail( ({"lehmbau"}),
    "Wenn man etwas aus, oder mit, Lehm baut, dann betreibt man Lehmbau.");

  AddDetail( ({"baustoff", "baustoffe", "stoffe"}),
    "Das sind Stoffe, aus denen man etwas bauen kann." );

  AddDetail( ({"gestein", "felsen"}),
    "Felsen oder aehnliches werden gemeinhin als Gestein bezeichnet." );

  AddDetail( ({"mischung", "material", "materialien"}),
    "Eine Mischung entsteht, wenn man zwei oder mehr untschiedliche Materialien "
    "vermischt." );

  AddDetail( ({"mineral", "mineralien"}),
    "Als Mineralien werden vom Mineralogen natuerlich vorkommende Feststoffe "
    "bezeichnet." );

  AddDetail( ({"kalk"}),
    "Kalk ist eine spezielle Steinart.");

  AddDetail( ({"feststoffe", "stoffe", "feststoff", "stoff"}),
    "Alles, was fest ist, ist ein Feststoff!");

  AddDetail( ({"berglehm", "gehaengelehm", "geschiebelehm", "loesslehm", "auenlehm"}),
    "Das ist eine besondere Art des Lehms." );

  AddDetail( ({"ton"}),
    "Ton ist ein Material, aus dem Geschirr hergestellt werden kann." );

  AddDetail( ({"sand", "schluff", "menge"}),
    "Du findest hier jede Menge Sand. Schluff ist sehr feiner Sand." );

  AddDetail( ({"teilchen", "erdteilchen", "stueckchen"}),
    "Ganz, ganz winzige Stueckchen Erde." );

  AddDetail( ({"sonne"}),
    "Die Sonne verbrennt Deine Haut!" );  

  AddDetail( ({"haut"}),
    "Du spuerst schon wie Deine Haut an manchen Stellen verdampft!" );

  AddDetail( ({"stellen"}),
    "Vielleicht haettest Du Dir einen besseren Sonnenschutz zulegen sollen.");

  AddDetail( ({"schutz", "sonnenschutz", "schirme", "sonnenschirme", 
	       "creme", "cremen"}),
    "Sonnenschirme, Cremen oder anderes...");

  AddDetail( ({"sonnenbrand", "sache"}),
    "Eine unangenehme Sache." );

  AddDetail( ({"art"}),
    "Du bist ganz schoen aus der Art geschlagen." );

  AddDetail( ({"mineralogen", "leute"}),
    "Das sind die Leute, die sich mit Mineralien beschaeftigen." );

  AddDetail( ({"geschirr", "teller", "loeffel", "kruege"}),
    "Teller, Loeffel, Kruege und vieles mehr wird gemeinsam als Geschirr bezeichnet." );

  AddDetail( ({"abgrenzung"}),
    "Zwischen Lehm und Ton gibt es keine klare Abgrenzung.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Bruzeln Deiner Haut.");

  AddSound( ({ "haut", "bruzeln" }),
    "Wenn Du hier noch laenger in der Sonne wartest handelst Du Dir einen "
    "Sonnenbrand ein.");

  AddSmell( DEFAULT_SMELL,
    "Du riechst den herrlichen Duft von verbrannter Haut und Sand.");

  AddSmell( ({"duft", "haut", "brand", "sonnenbrand"}),
    "Riecht nach Sonnenbrand.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "rein", "in die Huette#" + ROOM "krist_room" );
  AddExit( "westen", ROOM "ges_4");
  AddExit( "osten", ROOM "ges_3");
}
