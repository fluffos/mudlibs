#include "../def.h"

inherit "std/room";

mixed *doorinfo;
int searched;

void create()
{
  ::create();
  searched = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Die Schatzkammer der Echsenmenschen");
  SetProp(P_INT_LONG,
    "Du hast soeben die Schatzkammer der Echsenmenschen betreten. "
    "Ihr Anblick ueberwaeltigt Dich einfach. Du haettest nie gedacht "
    "so viel Gold und Edelsteine auf einem Fleck zu finden! Ueberall "
    "tuermen sich Goldmuenzen und andere Wertsachen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 2);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "kammer", "schatzkammer" }),
    "Du hast soeben die Schatzkammer der Echsenmenschen betreten. "
    "Ihr Anblick ueberwaeltigt Dich einfach. Du haettest nie gedacht "
    "so viel Gold und Edelsteine auf einem Fleck zu finden! Ueberall "
    "tuermen sich Goldmuenzen und andere Wertsachen.");

  AddDetail( ({ "menschen", "echsenmenschen", "echsen", "bewohner" }),
    "Die Bewohner dieses Dorfes sind Echsenmenschen. Sie sehen aus, "
    "wie Echsen, nur gehen sie wie Menschen aufrecht.");

  AddDetail( ({"anblick"}),
    "Dieser Anblick ist einfach ueberwaeltigend! Ueberall tuermen sich "
    "Haufen von Gold und Edelsteinen!" );  

  AddDetail( ({"gold", "edelsteine", "schatz", "schaetze"}),
    "Wie gerne wuerdest Du diese Haufen durchsuchen, allerdings sind "
    "hier sicher Fallen und Schutzvorrichtungen." );

  AddDetail( ({"fleck", "hoehle", "ort", "orte"}),
    "In dieser Hoehle tuermen sich so viele Schaetze, dass es so aussieht "
    "als waeren die Waende aus Gold." );

  AddDetail( ({"muenzen", "goldmuenzen"}),
    "Du schaetzt das hier etwa "+random(10000000000)+" Goldmuenzen liegen. "
    "Eine beachtliche Summe!" );

  AddDetail( ({"sachen", "wertsachen"}),
    "Schmuck und andere Wertsachen liegen, wie achtlos weggeworfene "
    "Gegenstaende, herum. Es faellt doch sicher nicht auf, wenn man hier "
    "das eine oder andere stiehlt." );

  AddDetail( ({ "gegenstaende"}),
    "Das sind wahrlich keine achtlosen Sachen.");

  AddDetail( ({"dorf", "dorfes", "oberflaeche"}),
    "Das Dorf liegt einige Meter ueber Dir, auf der Oberflaeche." );

  AddDetail( ({"meter", "masseinheit", "einheit"}),
    "Ein Meter ist eine Masseinheit.");

  AddDetail( ({"haufen"}),
    "Diese ganzen Haufen an achtlos weggeworfenem Gold! Woher das nur alles "
    "kommen mag?" );

  AddDetail( ({"fallen", "schutzvorrichtungen", "vorrichtungen"}),
    "Wie Du sicher weisst, sind alle alten Grabstaetten und Schatzkammern "
    "gut vor Dieben und Eindringlingen geschuetzt. Vermutlich findest Du "
    "hier irgendwo einen verborgenen Mechanismus, der ausgeloest wird, "
    "sobald man etwas von dem Schatz entfernt." );

  AddDetail( ({"waende", "wand"}),
    "Es scheint Dir so, als waeren die Waende aus purem Gold gemacht." );

  AddDetail( ({"boden"}),
    "Der Boden ist ueberhaeuft mit Schaetzen.");

  AddDetail( ({"gold", "metall"}),
    "Gold ist wirklich ein wunderbares Metall!" );

  AddDetail( ({"summe"}),
    "Wenn Du all das Gold hier besitzen koenntest, dann wuerdest Du Dir "
    "endlich Deine Traeume erfuellen!" );

  AddDetail( ({"staetten", "grabstaetten", "grabstaette", "staette"}),
    "Dies hier ist sicher keine Grabstaette. Zumindest findest Du hier "
    "keine Saerge." );

  AddDetail( ({"diebe", "dieben", "dieb", "eindringling", "eindringlinge"}),
    "Diebe und Eindringlinge kommen oft an Orte wie diesen, um wertvolle Sachen "
    "zu entwenden." );

  AddDetail( ({"mechanismus"}),
    "Du kannst hier keinen finden. Vielleicht ist das auch ein Mechanismus "
    "magischer Art." );

  AddDetail( ({"traeume"}),
    "Nur ein kleiner Bruchteil des Schatzes hier... und all Deine Traeume "
    "werden wahr!" );

  AddDetail( ({"sarg", "saerge"}),
    "Sowas findet man gewoehnlich nur an Grabstaetten." );

  AddDetail( ({"wert"}),
    "Hier muessen Sachen von unschaetzbarem Wert liegen!" );

  AddDetail( ({"teil", "bruchteil"}),
    "Nur ganz wenig wuerde schon reichen! Du musst nur zugreifen!" );  

  AddDetail( ({"art", "edelsteinart"}),
    "Das Gitter besteht aus einer braunen Edelsteinart.");

  AddDetail( ({ "blitz", "blitze" }),
    "Blau-weisse Blitze zucken auf dem Gitter herum. Es wurde wohl mit "
    "einem gefaehrlichen Zauber belegt.");

  AddDetail( ({"zauber"}),
    "Das Gitter ist vermutlich mit eine gefaehrlichen Zauber belegt.");

  AddDetail( ({"decke"}),
    "Die Decke ist nicht besonders aufregend...");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Klimpern von Gold.");

  AddSound( ({ "klimpern", "gold" }),
    "Wenn Du ein bisschen davon an Dich nimmst, dann kannst Du tun "
    "wonach Dir verlangt!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier stark nach Reichtum.");

  AddSmell( ({ "reichtum", "geruch" }),
    "Haaaach! Ein herrlicher Geruch!");
//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuche" );
  AddCmd( ({"stiehl", "stehle", "greife", "greif"}), "cmd_stehlen");
  AddCmd( ({"nimm", "nehme"}), "cmd_nehmen");

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "djinn" , REFRESH_DESTRUCT);

//--Exits------------------------------------------------------------------
  NewDoor( "sueden", ROOM "hoehle1", "gitter",
	  ({D_FLAGS, DOOR_RESET_CL,
	    D_LONG,  BS("Das Gitter ist aus einer braunen Edelsteinart "
		        "gemacht. Dazwischen zucken blau-weisse Blitze "
			"hin und her. Dahinter befindet sich eine Hoehle."),
	    D_SHORT, "Das Gitter ist %s.",
	    D_NAME, "Gitter",
	    D_GENDER, NEUTER
	    })
	 );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_nehmen(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "geld" ||
       str == "gold" ||
       str == "edelsteine" ||
       str == "haufen" ||
       str == "schatz" )) return 0;
  write(BS("Mit dem Schatz muss man etwas anderes machen!"));
  return 1;
}

int cmd_durchsuche(string str)
{
  object horn, *gems;
  int i;
  notify_fail("Was willst Du durchsuchen?\n");
  if(!str || str == "") return 0;
  if(!(str == "schatz" ||
       str == "haufen" )) return 0;

  write(BS("Du durchsuchst die Schaetze..."));
  say(BS(TPN+" macht sich daran die Schaetze zu untersuchen."));

  if(!present("\ngwenshara_sign_of_slayer", TP) || searched)
  {
    tell_room(TO, BS("Eine Stimme droent:"));
    tell_room(TO, BS("Wie kannst Du es wagen, Unwuerdige"+
		  (TP->QueryProp(P_GENDER)==FEMALE?"":"r")+"!"));
    if(find_call_out("let_them_die") == -1) call_out("let_them_die", 0, 0);
    return 1;
  }

  gems = "/obj/gemmaster"->DistributeGem(10, 0, 1);

  if(TP->QueryProp(P_GUILD) == "zechpreller" && 
     !call_other("/gilden/zechpreller/master/questmaster", "QueryQuest",
	        getuid(TP), 1) &&
     TP->QueryProp(P_GUILD_LEVEL) > 5 && 
     !present("\nzechpreller_gildenquest_horn", TP))
  {
    gems+=({clone_object("/d/wueste/gwenshara/zechi/obj/trinkhorn")});
    write("... und findest ein magisches Trinkhorn!\n");
  }

  for(i=0; i<sizeof(gems); ++i)
    if(ME_TOO_HEAVY == gems[i]->move(TP, M_GET))
      gems[i]->move(TO, M_NOCHECK);
  write("... und findest eine Menge Edelsteine!\n");
  searched = 1;

  return 1;
}

int cmd_stehlen(string str)
{
  notify_fail("Was willst Du stehlen?\n");
  if(!str || str == "") return 0;
  if(!(str == "wertsachen" ||
       str == "sachen" ||
       str == "gold" ||
       str == "edelsteine" ||
       str == "schatz" )) return 0;

  write(BS("Du greifst nach einem Teil des Schatzes als Du ein Klicken "
	   "vernimmst."));
  write(BS("Du wankst zur Seite als Du einen Pfeil in Deiner Huefte "
	 "spuerst."));
  say(BS(TPN+" versucht einen Teil des Schatzes zu stehlen und wird von "
      "einem Pfeil getroffen!"));
  TP->AddHp(-10);

  // mit etwas pech wird auch die zweite falle ausgeloest...
  if(!random(5) && find_call_out("let_them_die") == -1) 
    call_out("let_them_die", 0, 0);
  else TP->AddPoison(5); // anderen falls werden wir 'nur' vergiftet
  return 1;
}
//--Funktionen-------------------------------------------------------------

void abschotten()
{
  doorinfo = QueryProp(P_DOOR_INFOS);
  SetProp(P_DOOR_INFOS);
  return;
}

void entriegeln()
{
  if(!doorinfo) raise_error("Kein doorinfo! Entriegeln nicht moeglich!");
  SetProp(P_DOOR_INFOS, doorinfo);
  return;
}

void let_them_die(int ab)
{
  object *inv;
  int i;
  switch(ab)
  {
    default: raise_error("Sequenz-Fehler!");
	     break;

    case 0: if(present("\ngwenshara_erzele"))
	      tell_room(TO, BS("Adamantium sagt: Stirb, Narr!"));
	    tell_room(TO,BS("Mit einem Krachen faellt ein Felsklotz vor das Gitter."));
            abschotten();
	    tell_room(ROOM "hoehle1",
		      "Mit einem Krachen faellt ein Felsklotz vor das Gitter.");
	    call_other(ROOM "hoehle1", "abschotten");
	    call_out("let_them_die", 5, 1);
	    break;
	    
    case 1: tell_room(TO,BS("Irgendwo rieselt leise Sand..."));
	    call_out("let_them_die", 7, 2);
	    break;

    case 2: tell_room(TO,BS("Du bemerkst, dass von der Decke etwas Sand rieselt."));
            call_out("let_them_die", 5, 3);
	    break;

    case 3: tell_room(TO,BS("Es rieselt immer mehr Sand von der Decke!"));
	    call_out("let_them_die", 8, 4);
	    break;

    case 4: tell_room(TO,BS("Deine Fuesse sind bereits von Sand bedeckt. "
		"Vielleicht waere es ratsam einen Ausweg zu suchen."));
	    call_out("let_them_die", 5, 5);
	    break;

    case 5: tell_room(TO,BS("Der Sand steht Dir schon bis zur Huefte!"));
	    call_out("let_them_die", 7, 6);
	    break;

   case 6: tell_room(TO,BS("Der Sand steht Dir nun schon bis zum Hals! Langsam "
	       "wirds knapp!"));
	   call_out("let_them_die", 5, 7);
	   break;

   case 7: tell_room(TO,BS("Der Sand dringt Dir schon in Mund und Nase!"));
	   call_out("let_them_die", 3, 8);
	   break;

   case 8: tell_room(TO,BS("Verzweifelt haeltst Du die Luft an! Der ganze Raum "
	       "ist nun mit Sand gefuellt."));
	   call_out("let_them_die", 3, 9);
	   break;

   case 9: tell_room(TO,BS("Du Luft wird immer knapper!"));
	   call_out("let_them_die", 3, 10);
	   break;

   case 10: tell_room(TO,BS("Vielleicht rettet Dich doch noch jemand!"));
	    call_out("let_them_die", 3, 11);
	    break;

   case 11: tell_room(TO,BS("Du versuchst verzweifelt Luft zu holen, doch schon "
	        "umfaengt Dich Schwaerze..."));
	    SetProp(P_KILL_NAME, "Eine alte Falle");
            inv = filter_array(all_inventory(), #'interactive);
	    for(i=0; i<sizeof(inv); ++i)
	    {
	      inv[i]->SetProp(P_GHOST, 1);
	      inv[i]->SetProp(P_KILLER, TO);
	      inv[i]->move("/room/death/death_room", M_NOCHECK);
	    }
	    SetProp(P_KILL_NAME, 0);
	    entriegeln();
	    tell_room(ROOM "hoehle1", "Der Felsklotz geht wieder hoch.");
	    call_other(ROOM "hoehle1", "entriegeln");
	    break;
  }
  return;
}

void reset()
{
  ::reset();
  searched = 0;
}
