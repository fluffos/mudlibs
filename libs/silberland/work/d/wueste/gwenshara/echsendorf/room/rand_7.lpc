// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();
string besitzer();
string rasse;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Oestlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Ein Skelett ist hier "
   "verendet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( "skelett",
             "Nein, natuerlich ist nicht das Skelett hier verendet "
             "sondern sein vorheriger Besitzer.");

  AddDetail( "besitzer", #'besitzer);

//-----Details Ende-----

  AddExit("nordwesten", ROOM "rand_6");
  AddExit("osten", ROOM "rand_8");
  AddExit("westen", DESERT "62:10");
  AddExit("suedwesten", DESERT "62:11");
  AddExit("sueden", DESERT "63:11");
  AddExit("suedosten", DESERT "64:11");
}

string sand(){ 
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
} 

string besitzer(){
  int bes;
  bes=random(7);
  
  switch(bes){
  case 1: rasse="Menschen";
          break;

  case 2: rasse="Hobbit";
          break;

  case 3: rasse="Elf";
          break;

  case 4: rasse="Zwerg";
          break;

  case 6: rasse="Oger";
          break;

  case 7: rasse="Troll";
	  break;

  default: rasse="Unbekannten";
           break;
  }

  return BS("Der Hoehe und Breite nach zu schliessen gehoert das Skelett einem"
            " "+rasse+".\n");
}
