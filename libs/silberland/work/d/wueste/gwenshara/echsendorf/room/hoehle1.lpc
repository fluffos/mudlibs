#include "../def.h"

inherit "std/room";

mixed doorinfo;

int edelstein;

void create()
{
  ::create();

  edelstein         = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine dunkle Hoehle");
  SetProp(P_INT_LONG,
    "Du stehst hier in einer dunklen, kleinen Hoehle. Sie ist nur grob aus "
    "dem Sand der Wueste geschlagen worden. Eine kleine Bank steht an der "
    "Wand und ein Holznapf liegt daneben. Im Norden der Hoehle ist ein Gitter "
    "eingelassen. Der Boden wurde duerftig mit Stroh ausgelegt. An der Westwand "
    "befindet sich eine Holztuer.");
  SetProp(P_NAME, "Ein elektrischer Schlag");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({"decke", "stein"}),
    "Die Decke wird von dem Stein ueber Dir gebildet.");
  
  AddDetail( ({ "hoehle" }), 
    "Du stehst hier in einer dunklen, kleinen Hoehle. Sie ist nur grob aus "
    "dem Sand der Wueste geschlagen worden. Eine kleine Bank steht an der "
    "Wand und ein Holznapf liegt daneben. Im Norden der Hoehle ist ein Gitter "
    "eingelassen. Der Boden wurde duerftig mit Stroh ausgelegt. An der Westwand "
    "befindet sich eine Holztuer.");

  AddDetail( ({ "sand" }),
    "Ueber Dir tuermen sich etliche Kilogramm Sand bis zur Oberflaeche der "
    "Wueste. Sei froh das Du sie nicht tragen musst!");

  AddDetail( ({ "wueste" }),
    "Die Wueste ist ein unendliches Meer aus Sand, in dem sich Oasen und "
    "Staedte wie rettende Inseln erheben und Kamelkarawanen wie kleine "
    "Schiffchen schwimmen.");

  AddDetail( ({ "bank" }),
    "Die kleine Bank an der Wand dient den hier Gefangenen als Schlaf- und "
    "Sitzgelegenheit. Sie ist gerade so gross, dass man bequem darauf "
    "sitzen kann. Sie wurde, wie vieles im Dorf, aus Palmenholz geschnitzt "
    "und glatt geschliffen.");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind unregelmaessig aus dem Boden gegraben und broeckelig. "
    "Im  Norden wurde ein Gitter eingelassen.");

  AddDetail( ({ "napf", "holznapf" }),
    "In dem Holznapf wird den hier Gefangenen ihr taegliches Essen serviert. "
    "Du findest noch Reste von Getreidebrei darin.");

  /*Ersetzt durch NewDoor
   *
   * AddDetail( ({ "gitter" }),
    "Das Gitter besteht aus einer braunen Eedelsteinart. Dazwischen "
    "zucken blau-weisse Blitze hin und her. Durch das Gitter erkennst Du "
    "das Funkeln von Gold und Edelsteinen. Dahinter befindet sich die "
    "Schatzkammer des Dorfes!");*/

  AddDetail( ({ "boden", "erde" }),
    "Der Boden besteht aus festgetretener Erde. Er ist uebersaet mit "
    "dreckigem Stroh und Unrat.");

  AddDetail( ({ "stroh", "unrat" }),
    "Der ganze Dreck am Boden ekelt Dich an!");

  AddDetail( ({ "kilo", "gramm", "kilogramm" }),
    "Viele Kilogramm Sand lasten auf dieser Hoehle. Sie scheint nicht "
    "in der Stimmung zu sein einbrechen zu wollen.");

  AddDetail( ({ "flaeche", "oberflaeche" }),
    "Ueber Dir befindet sich das Dorf der Echsenmenschen.");

  AddDetail( ({ "meer" }),
    "Die Wueste erstreckt sich bis zum Horizont als unendlich weites Meer.");

  AddDetail( ({ "oasen", "staedte" }),
    "Kleine Oasen und Staedte bieten Schutz vor der bruetenden Hitze der "
    "Wueste.");

  AddDetail( ({ "inseln" }),
    "Wie auf dem Meer bilden Staedte und Oasen in der Wueste rettende "
    "Inseln vor dem Tod.");

  AddDetail( ({ "karawanen", "kamelkarawanen", "kamele", "handelskarawanen" }),
    "Ein paar Handelskarawanen reisen durch die Weiten der Wueste, um "
    "auf den Basaren dieses Landes zu kaufen und zu verkaufen.");

  AddDetail( ({ "schiffe", "schiffchen", "schiffen" }),
    "Die Karavanen sind mit Schiffen am offenen Meer zu vergleichen.");

  AddDetail( ({ "gefangene", "gefangenen", "verbrecher" }),
    "Hier werden die Gefangenen der Echsenmenschen bis zu ihrer "
    "Verurteilung verwahrt.");

  AddDetail( ({"verurteilung"}),
    "Die Echsenmenschen bestrafen Verbrecher besonders hart.");

  AddDetail( ({ "schlafgelegenheit", "sitzgelegenheit", "gelegenheit" }),
    "Die Bank ist fuer Gefangene die einzige Gelegenheit sich hier auszuruhen.");

  AddDetail( ({ "dorf", "echsendorf" }),
    "Ueber Dir befindet sich das Dorf der Echsenmenschen.");

  AddDetail( ({ "holz", "palmenholz" }),
    "Vieles im Echsendorf wird aus Palmenholz hergestellt, da es leicht zu"
    "finden ist.");

  AddDetail( ({ "essen", "brei", "getreidebrei" }),
    "Das Essen der Gefangenen besteht hier aus einfachem Getreidebrei. "
    "Davon bekommen sie gerade genug um ueberleben zu koennen.");

  AddDetail( ({ "reste" }),
    "Im Holznapf befinden sich noch die klaeglichen Reste von Getreidebrei.");

  AddDetail( ({ "edelstein", "edelsteinart", "zirkon", "zirkonen" }),
    "Der braune Edelstein, aus dem das Gitter gemacht ist, duerfte ein "
    "Zirkon sein. Man sagt Zirkonen nach, sie koennen eine unsichtbare "
    "Macht leiten.");

  AddDetail( ({ "blitz", "blitze" }),
    "Blau-weisse Blitze zucken auf dem Gitter herum. Es wurde wohl mit "
    "einem gefaehrlichen Zauber belegt.");

  AddDetail( ({ "funkeln", "gold", "schatz" }),
    "Durch das Gitter ist das Funkeln von Gold zu erkennen.");

  AddDetail( ({ "kammer", "schatzkammer" }),
    "Nur das Gitter trennt Dich von diesem unermesslichen Schatz.");

  AddDetail( ({ "dreck" }),
    "Vielleicht findest Du in dem ganzen Unrat etwas, wenn du ihn "
    "durchsuchst.");

  AddDetail( ({ "stimmung", "lust" }),
    "Die Hoehle hat, wie es scheint, keine Lust einzubrechen.");

  AddDetail( ({ "menschen", "echsenmenschen", "echsen", "bewohner" }),
    "Die Bewohner dieses Dorfes sind Echsenmenschen. Sie sehen aus, "
    "wie Echsen, nur gehen sie wie Menschen aufrecht.");

  AddDetail( ({ "horizont", "grenze", "sichtgrenze" }),
    "Der Horizont ist Deine Sichtgrenze.");

  AddDetail( ({ "hitze" }),
    "Die Wueste zieht Hitze magisch an.");

  AddSpecialDetail( ({ "tod" }),
    "died");

  AddDetail( ({ "weiten", "land", "laendereien" }),
    "Die Laendereien der Wueste sind unendlich weit.");

  AddDetail( ({ "basar", "basars" }),
    "In der Wueste gibt es viele Basare. Dort wird mit allerlei Dingen "
    "gehandelt. Du solltest ein Mal einen besuchen!");

  AddDetail( ({ "macht" }),
    "Zirkone leiten eine unheimliche Macht!");

  AddDetail( ({"zauber"}),
    "Beruehre das Gitter bloss nicht!");

  AddDetail( ({ "dinge", "dingen" }),
    "Dies und das.");

  AddDetail( ({"tuer", "holztuer", "seite", "westwand"}),
    "Die Tuer ist aus Holz gezimmert. Sie ist von dieser Seite "
    "nicht oeffenbar. Wenn Du an ihr klopfst, bemerkt man Dich "
    "aber vielleicht.");

  AddSound( DEFAULT_SOUND,
    "Eine unheimliche Stille lastet auf dieser Hoehle.");

  AddSound( ({ "stille" }),
    "Hier ist es unheimlich still.");

  AddSmell( DEFAULT_SMELL,
    "Du riechst den Gestank von Unrat.");

  AddSmell( ({ "gestank", "unrat" }),
    "Einfach nur ekelhaft!");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_DURCHSUCHEN , "cmd_durchsuchen" );
  AddCmd( ({"klopf", "klopfe"}), "cmd_klopfen");

//--Ausgaenge--------------------------------------------------------------

//  AddExit( "westen", ROOM "hoehle" );
  NewDoor( "norden", ROOM "hoehle2", "gitter",
	  ({D_FLAGS, DOOR_RESET_CL,
	    D_LONG,  BS("Das Gitter ist aus einer braunen Edelsteinart "
		        "gemacht. Dazwischen zucken blau-weisse Blitze "
			"hin und her. Durch das Gitter erkennst Du das "
			"Funkeln von Gold und Edelsteinen. Dahinter "
			"befindet sich die Schatzkammer des Dorfes!"),
	    D_SHORT, "Das Gitter ist %s.",
	    D_NAME, "Gitter",
	    D_GENDER, NEUTER,
	    D_TESTFUNC, "walk_through_my_little_door",
	    D_OPENTESTFUNC, "do_not_try_to_open_my_door",
	    })
	 );
  doorinfo = QueryProp(P_DOOR_INFOS);

//--Items & NPCs-----------------------------------------------------------

  AddItem( "/d/wueste/gwenshara/zechi/npc/mutan" , REFRESH_DESTRUCT);
}

//--Funktionen fuer Kommandos----------------------------------------------
int cmd_klopfen(string str)
{
  notify_fail("Woran willst Du klopfen?");
  if(!str || str == "") return 0;
  if(!(str == "tuer" ||
       str == "an tuer" ||
       str == "holztuer" ||
       str == "an holztuer" )) return 0;

  write(BS("Du klopfst an die Holztuer."));
  say(BS(TPN+" klopft an die Holztuer."));
  call_other(ROOM "hoehle", "???");
  if(!present("wachmann", find_object(ROOM "hoehle")))
    write(BS("Anscheinend ist niemand im Raum nebenan."));
  else
  {
    tell_room(ROOM "hoehle", BS("Der Wachmann oeffnet die Tuer "
	      "und "+TPN+" kommt herein. Danach schliesst er die Tuer wieder."));
    write(BS("Die Tuer wird geoffnet und Du gehst hinaus."));
    say(BS("Die Tuer wird geoeffnet und "+TPN+" geht hinaus. Danach "
        "wird die Tuer wieder geschlossen."));
    TP->move(ROOM "hoehle", M_SILENT|M_NOCHECK);
  }

  return 1;
}

int cmd_durchsuchen(string str)
{
  object gem;
  notify_fail("Was willst Du durchsuchen?\n");
  if(!str || str == "") return 0;
  if(!(str == "dreck" ||
       str == "unrat" ||
       str == "stroh" )) return 0;
  
  write("Du wuehlst im Dreck herum");
  if(!edelstein) write(BS(" und findest dabei allerdings nichts."));
  else
  {
    write(BS(" und findest dabei einen Edelstein!"));
    "/obj/gemmaster"->DistributeGem(1, 0, 1, TP);
    edelstein=0;
  }
  say(BS(TPN+" wuehlt im Dreck herum. So ein Ferkel!"));
  return 1;
}

//--Funktionen fuer Details------------------------------------------------

string died(string str)
{
  return BS("Der Tod hat Dich bereits "+TP->QueryProp(P_DEADS)+" mal "
	   "besucht!");
}

//--Funktionen-------------------------------------------------------------

void abschotten()
{
  doorinfo = QueryProp(P_DOOR_INFOS);
  SetProp(P_DOOR_INFOS);
  return;
}

void entriegeln()
{
  if(!doorinfo) raise_error("Kein doorinfo! Entriegeln nicht moeglich!");
  SetProp(P_DOOR_INFOS, doorinfo);
  return;
}

int walk_through_my_little_door()
{
  if(!present("\ngwenshara_sign_of_slayer", TP))
  {
    tell_room(TO, "Eine Stimme droent:\n");
    tell_room(TO, BS("Du bist nicht wurdig einzutreten "+TPN+"!"));
    return 1;
  }
  return 0;
}

int do_not_try_to_open_my_door()
{
  if(present("\ngwenshara_sign_of_slayer", TP)) return 0;
  write(BS("Als Du die Gitterstaebe beruehrst, bekommst Du einen "
	   "schmerzhaften Schlag!"));
  say(BS(TPN+" beruhert das Gitter und zuckt zusammen."));
  TP->Defend(150, DT_ELECTRIC, 0, TO); // Ich will mich nicht mit
  return 1;                            // Resistenzen rumplagen ;)
}

void reset()
{
  ::reset();
  edelstein         = 1;
}
