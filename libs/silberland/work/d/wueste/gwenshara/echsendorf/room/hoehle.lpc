#include "../def.h"
#include <verben.h>

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Ruestkammer");
  SetProp(P_INT_LONG,
    "Du befindest Dich hier in einer Kammer, die aus dem Stein gehauen wurde. "
    "An den Waenden befinden sich Regale und Stellvorrichtungen fuer Waffen "
    "und Uniformen. Rechts von Dir findest Du eine Holzpuppe, die ein "
    "Kettengewand traegt. Von der Decke haengen Bogen- und Armbrustsehnen. "
    "An der Wand im Osten entdeckst Du eine Holztuer."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "kammer" }),
    "Die Kammer, in der Du stehst, wurde einfach aus dem Stein gehauen. "
    "Die Waende bestehen demnach, sowie auch der Boden, auch aus dem rauen "
    "Gestein der Wueste."
  );

  AddDetail( ({ "stein", "gestein", "wuestengestein", "sandstein", "wuestenstein" }),
    "Der Stein hier sieht aus wie gepresster Sand. Das kommt daher, dass es "
    "vermutlich Sandstein ist."
  );

  AddDetail( ({ "waende"}),
    "Die Waende sind randvoll mit Regalen, sodass Du sie eigentlich nicht erkennen "
    "kannst. Du vermutest das sie aus dem gelblichen Wuestengestein bestehen."
  );

  AddDetail( ({ "regale", "regalen", "regal" }),
    "Die Regale sind alle voll mit Bolzen- und Pfeilbuendeln, Uniformen, Wetzsteinen "
    "und anderen Pflegewerkzeugen."
  );

  AddDetail( ({ "stellvorrichtungen", "vorrichtungen" }),
    "Auf den aus Palmenholz gefertigten Stellvorrichtungen findest Du Speere, "
    "Schwerter, Staebe, Dolche und viele andere Waffen."
  );

  AddDetail( ({ "waffen", "speere", "schwerter", "staebe", "dolche", "waffe" }),
    "Die Waffen, die Du hier findest, sind alle exzellent gefertigt und "
    "geschliffen worden. Besonders auffaellig ist, dass jede Waffe eine "
    "obsidianerne Schneide hat."
  );

  AddDetail( ({ "uniformen" }),
    "Die Uniformen in den Regalen sind alle schoen zusammen gelegt worden und haben "
    "einen fliegenden Drachen eingestickt. Sie sind rot-violett gefaerbt und aus einem "
    "seltsamen Stoff gefertigt."
  );

  AddDetail( ({ "puppe", "holzpuppe" }),
    "Die Holzpuppe rechts von Dir traegt eine komplette Kettenruestung."
  );

  AddDetail( ({ "kettengewand", "gewand", "kettenruestung", "ruestung" }),
    "Das Kettengewand an der Puppe besteht aus einer Kettenhaube, Kettenhandschuhen "
    "und einem knielangen Kettenhemd."
  );

  AddDetail( ({ "decke" }),
    "Die Decke besteht, so wie die Waende auch, aus dem Wuestenstein. Von ihr "
    "baumeln viele Bogen- und Armbrustsehnen herab."
  );

  AddDetail( ({ "boden" }),
    "Der Boden ist mit feinem Sandstaub bedeckt und besteht - wie nicht anders "
    "zu erwarten - aus Sandstein."
  );

  AddDetail( ({ "wueste", "weiten" }),
    "Du freust dich schon wieder richtig darauf die unendlichen Weiten der "
    "Wueste zu erkunden!"
  );

  AddDetail( ({ "sand", "sandstaub" }),
    "Der Boden ist von einer leichten Schicht Sandstaub bedeckt."
  );

  AddDetail( ({ "schicht" }),
    "Damit ist eine sehr duenne Schicht gemeint."
  );

  AddDetail( ({ "bolzenbuendel", "pfeilbuendel", "buendel" }),
    "Im Regal liegen Buendel zu je vierundzwanzig Bolzen oder Pfeilen. Sie "
    "sind hervorragend gefertigt. Ihre Spitzen sind mit Widerhaken versehen, "
    "sodass sie die Wunde nochmals aufreissen, wenn man sie entfernt."
  );

  AddDetail( ({ "wetzsteine", "wetzsteinen", "packung", "packungen",
	        "wetzsteinpackungen", "stueck" }),
    "In den Regalen findest Du Wetzsteinpackungen zu je fuenfundzwanzig Stueck."
  );

  AddDetail( ({ "pflegewerkzeug", "werkzeug", "flaeschchen", "lappen" }),
    "Die Flaeschchen und Lappen in den Regalen sind als Pflegewerkzeug fuer "
    "die Waffen gedacht."
  );

  AddDetail( ({ "holz", "palmenholz" }),
    "Das Holz einer gemeinen Wuestenpalme wird hier als Palmenholz bezeichnet."
  );

  AddDetail( ({ "schneide", "schneiden" }),
    "Die Schneiden der Waffen sind alle aus Obsidian gemacht."
  );

  AddDetail( ({ "drachen", "drache", "umriss" }),
    "Auf den Uniformen erkennst Du den Umriss eines fuerchterlich boesen "
    "Drachen."
  );

  AddDetail( ({ "stoff" }),
    "Der Stoff, aus dem die Uniformen gewebt sind, ist Dir leider unbekannt."
  );

  AddDetail( ({ "kettenhaube", "haube" }),
    "Die Kettenhaube ist eine Haube aus Kettenringen."
  );

  AddDetail( ({ "kettenhandschuhe", "handschuhe" }),
    "Die Kettenhandschuhe sind Handschuhe aus Kettenringen."
  );

  AddDetail( ({ "kettenhemd", "hemd" }),
    "Das knielange Kettenhemd ist ein Hemd aus Kettenringen."
  );

  AddDetail( ({ "sehnen", "bogensehnen", "armbrustsehnen", "bogen" }),
    "Die Sehnen baumeln froehlich von der Decke herab."
  );

  AddDetail( ({ "staub", "sandstaub", "staubschicht", "staubfilm" }),
    "Der Boden wird von einem duennen Staubfilm aus Sand bedeckt."
   );

  AddDetail( ({ "bolzen", "pfeile" }),
    "Das findest Du hier im Regal."
  );

  AddDetail( ({ "spitzen", "widerhaken" }),
    "Die Spitzen der Pfeile und Bolzen sind mit Widerhaken versehen, "
    "damit sie die Wunde, beim entfernen daraus, noch aufreissen."
  );

  AddDetail( ({ "wunden","wunde" }),
    "Du hast keine schlimmeren Wunden."
  );

  AddDetail( ({ "wuestenpalme", "palme", "palmen", "baeumen", "baeume" }),
    "Palmen sind Baeume, die man in der Wueste oder in Kuestengegenden finden kann. "
    "Sie haben ganz wuschelige Blaetter und ihre Fruechte sind die heissbegehrten "
    "Kokosnuesse."
  );

  AddDetail( ({ "obsidian", "edelstein", "edelsteine" }),
    "Obsidiane sind dunkle Edelsteine."
  );
  
  AddDetail( ({ "kettenringe", "ringe" }),
    "Fein geschmiedete Ringe aus Eisen."
  );

  AddDetail( ({ "eisen" }),
    "Eisen wird von den Zwergen im Gebirge hergestellt."
  );

  AddDetail( ({ "zweregen", "zwerge", "gebirge" }),
    "Zwerge leben im Gebirge."
  );
  
  AddDetail( ({ "kuesten", "kueste", "meer", "gegend", "gegenden", "kuestengegend", "kuestengegenden" }),
    "Die Kuestengegenden solltest Du besser beim Meer suchen."
  );

  AddDetail( ({ "blaetter", "palmenblaetter", "wuscheln" }),
    "Die Blaetter von Palmen sind ganz gut zum Wuscheln!"
  );

  AddDetail( ({ "fruechte" }),
    "Palmen haben gute Fruechte, die man gemeinhin als Kokosnuesse bezeichnet."
  );

  AddDetail( ({ "kokosnuss", "kokosnuesse", "nuss", "nuesse" }),
    "Kokosnuesse schmecken vorzueglich und geben Milch, obwohl sie keine Kuehe sind!"
  );

  AddDetail( ({"milch"}),
    "Aus der Milch der Kokosnuss kann man vieles machen. Zum Beispiel eine "
    "Pina Colada."
  );

  AddDetail( ({"kuehe", "kuh"}),
    "Auch Kuehe geben Milch."
  );

  AddDetail( ({"pina colada", "pina", "colada", "beispiel"}),
    "Mhhhh! Eine Pina Colada waere jetzt genau das richtige!"
  );

  AddDetail( "boden",
    "Der Boden ist aus Wuestengestein und von einer feinen Staubschicht "
    "bedeckt.");

  AddDetail( ({"wand", "ostwand"}),
    "An der Wand im Osten ist eine Holztuer zu finden.");

  AddDetail( ({"holztuer", "tuer"}),
    "Die Tuer ist aus Palmenholz gezimmert. Sie hat einen einfachen "
    "Riegel und ein vergittertes Schaufenster.");

  AddDetail( ({"riegel"}),
    "Der Riegel ist geschlossen, und wie es aussieht nur einseitig "
    "oeffenbar.");

  AddDetail( ({"schaufenster", "fenster", "blick"}),
    "Wenn man das Fenster oeffnet, dann kann man einen Blick in den "
    "Raum hinter der Tuer werfen.");

  AddDetail( ({"raum"}),
    "Der Raum ist hinter der Tuer, darum kannst Du ihn von hier aus "
    "nicht sehen.");
  

//--Kommandos--------------------------------------------------------------
 
  AddCmd( ({"wuschel", "verwuschel", "wuschle"}), "cmd_wuscheln");
  AddCmd( ({"oeffne", "entriegel", "entriegle"}), "cmd_oeffnen");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "oben", ROOM "turm_e" );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "betrunkener" , REFRESH_DESTRUCT);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if(!str || str == "") return 0;
  if(!(str == "riegel" ||
       str == "fenster" ||
       str == "schaufenster" )) return 0;

  if(str == "riegel")
  {
    write(BS("Du oeffnest den Riegel und trittst durch die Tuer. Sie faellt "
	  "hinter Dir sofort wieder zu."));
    TP->move(ROOM "hoehle1", M_GO||M_NOCHECK, "tritt durch die Tuer, die "
	     "sofort wieder zufaellt.", "tritt durch die Tuer, die sofort "
	     "wieder zufaellt.");
  }
  else
  {
    write(BS("Du oeffnest das Schaufenster und wirfst einen Blick "
	     "hindurch."));
    write("Auf der anderen Seite erkennst Du:\n");
    write(call_other(ROOM "hoehle1", "int_long", TP));
    say(BS(TPN+" wirft einen Blick durch das Schaufenster."));
  }

  return 1;
}

int cmd_wuscheln(string str)
{
  notify_fail("Was moechtest Du wuscheln?\n");
  if(!str || str == "" ) return 0;
  if(!(str == "palme" ||
       str == "blaetter" ||
       str == "palmenblaetter" )) return 0;

  write(BS("Du verwuschelst einer unsichtbaren Palme die Blaetter."));
  say(BS(TPN+" verwuschelt einer unsichtbaren Palme die Blaetter."));

  return 1;
}
