inherit "std/pub";

#include <moving.h>
#include <pub.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../def.h"

string kunden();
string licht();
int fire;

create() {
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Die Schenke 'Zum ausgebrueteten Ei'");
  SetProp (P_INT_LONG, 
           "Du befindest Dich in einem etwas kleineren Lehmbau. Hier "
	  +"herinnen stehen einige Holztische. Gaeste befinden sich hier "
	  +"eher wenige. Die Waende werden von gemusterten Decken verziert. "
	  +"Irgendwie fuehlst Du Dich hier richtig wohl. Im hinteren Teil des "
	  +"Raumes befindet sich eine Theke.");

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "zzhaxxel");
  SetProp(P_PUBKEEPER_NAME, "Zzhaxxel");
  SetProp(P_PUBMSG_NOKEEPER, "Zzhaxxel ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Zzhaxxel kaempft gerade mit Dir."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Zzhaxxel hat gerade Besseres zu tun."));
  SetProp(P_PUBMSG_FIGHTING, "Zzhaxxel kaempft gerade.\n");

// -----Details-----
  AddDetail( ({"bau","lehmbau","raum","raumes"}),
	     "Du befindest Dich hier in einem etwas kleineren Lehmbau. An der Wand befinden "
	     "sich ein paar kleine Fenster. Im hinteren Teil der Raumes findest Du eine Theke. "
	     "Im Raum verteilt stehen ein paar einfache Holztische.");

  AddDetail( ({"tische","holztische"}),
	     "Die Tische aus Palmenholz stehen im Raum verteilt, du koenntest Dich an einen von "
	     "ihnen setzen. An einem Tisch faellt Dir etwas Seltsames auf.");

  AddDetail( ({"gaeste","gast","kneipe"}),
	     "Wie es aussieht laeuft diese Kneipe hier nicht sehr gut.");

  AddDetail( ({"wand","waende"}),
	     "Die oeden Lehmwaende wurden mit gemusterten Decken verhaengt. Das ganze verleiht dem "
	     "Raum hier eine angenehme Atmosphaere.");

  AddDetail( ({"decken"}),
	     "Die Decken sind alle mit verschiedenen Mustern verziert. Eine Decke sticht besonders "
	     "hervor.\n");

  AddDetail( ({"teil", "hinteren teil","theke"}),
	     "Im hinteren Teil des Raumes befindet sich eine Theke, hinter der die Wirtin ihre "
	     "Kunden bedient.");

  AddDetail( ({"zahl"}), "Du hast tatsaechlich zehn Finger!");

  AddDetail( ({"boden"}),
	     "Hier wurden weisse, glatte Steine am Boden verlegt.");

  AddDetail( ({"fenster"}),
	     "Die Sonne strahlt durch das Glas.");

  AddDetail( ({"holz","palmenholz"}),
	     "Das Holz, aus dem die Tische gemacht sind, ist Palmenholz. In diesem Dorf ist "
	     "vieles aus diesem Holz.");

  AddDetail( ({"tisch"}),
	     "Du koenntest Dich an einen Tisch setzten, wenn Du Lust dazu hast. An einem Tisch "
	     "faellt Dir etwas Seltsames auf.");

  AddDetail( ({"seltsames","etwas"}),
	     "In einem Tisch befindet sich ein Loch!");

  AddDetail( ({"atmosphaere"}),
	     "Hach! Wenn hier noch ein Kamin waere, dann waere alles perfekt!");

  AddDetail( ({"muster","mustern"}),
	     "Die Muster auf den Decken zeigen Szenen aus dem alltaeglichen Leben.");

  AddDetail( ({"decke"}),
	     "Eine der Decken zeigt eine wunderschoene, blasse Menschenfrau.");

  AddDetail( ({"kunden"}), #'kunden);

  AddDetail( ({"steine","marmor"}),
	     "Die Steine am Boden koennten doch tatsaechlich Marmor sein.");

  AddDetail( ({"sonne"}),
	     "Die Sonne erfuellt den ganzen Raum mit hellem Licht.");

  AddDetail( ({"glas"}),
	     "Das Glas ist, wie nicht anders zu erwarten durchsichtig. Du koenntest einen Blick "
	     "nach draussen werfen.");

  AddDetail( ({"dorf","echsendorf"}),
	     "Du befindest Dich hier in einem Echsendorf.");

  AddDetail( ({"loch"}),
	     "Liebendgerne wuerdest Du einen Finger in das Loch im Tisch stecken.");

  AddDetail( ({"kamin"}),
	     "Als Du Dich hier so umblickst entdeckst Du doch tatsaechlich einen Kamin. "
	     "Er befindet sich hinter der Theke. Zzhaxxel hat sicher nichts dagegen, "
	     "das Du ihn anzuendest.");

  AddDetail( ({"szenen"}),
	     "Die Decken, die die Waende verhaengen, zeigen alle typische Szenen aus dem "
	     "Leben eines Echsenmenschen.");

  AddDetail( ({"frau","menschenfrau", "bild"}),
	     "Die Menschenfrau, die auf einer Decke abgebildet ist, hat meerblaues Haar "
	     "und Augen, die Dich in ihren Bann schlagen. Ihr makelloses Gesicht blickt guetig "
	     "auf Dich herab. Ein wohliger Schauer laeuft Dir ueber den Ruecken.");

  AddDetail( ({"licht"}), #'licht);

  AddDetail( ({"finger"}),
	     "Du hast fuenf an der Zahl. Justavius meinte, dass es eigentlich zehn sind!");

  AddDetail( ({"justavius", "detail"}),
	     "Dies ist ein Detail, extra fuer Justavius!");

  AddDetail( ({"haar"}),
	     "Das Haar der Menschenfrau scheint Dir wunderbar weich zu sein.");

  AddDetail( ({"augen"}),
	     "Die Augen der Menschenfrau haben eine seltsame Farbe. Sie schlagen Dich "
	     "sofort in ihren Bann.");

  AddDetail( ({"bann","anblick"}),
	     "Nur mit Muehe kannst Du Dich vom Anblick dieser Augen loesen.");

  AddDetail( ({"gesicht"}),
	     "Das Gesicht der Menschenfrau wird von ihrem meerblauen Haar eingerahmt. Es "
	     "ist zwar etwas blass aber makellos.");

  AddDetail( ({"schauer","ruecken"}),
	     "Ein wohliger Schauer laeuft Dir ueber den Ruecken als Du das Bild betrachtest.");

  AddDetail( ({"farbe"}),
	     "Die Augen der Menschenfrau haben eine unbestimmbare Farbe.");

  AddDetail( ({"muehe","muh","kuh","kuehe"}),
	     "Eine Kuh macht Muh, viele Kuehe machen Muehe.");

  AddDetail( ({"lehmwaende"}),
	     "Die Lehmwaende wurden mit Decken verhangen.");
// -----Smells------
// -----Sounds------

  AddDrink("Wasser", ({"wasser"}),
           1, 0, 0, 1,
           ({"Zhaxxel gibt Dir einen Becher Wasser,den Du "
            +"sofort austrinkst.\n",
             "&& trinkt einen Becher Wasser.\n"}));

  AddDrink("Eierlikoer", ({"likoer", "eierlikoer"}),
           50, 12, 3, 5,
           ({"Zzhaxxel gibt Dir ein wenig Eierlikoer.\n"
	     "Du denkst. o ( Der schmeckt guuuuut! ).\n",
             "&& trinkt einen Eierlikoer.\n"}));
  AddDrink("Kokosmilchshake", ({"shake", "milchshake", "kokosmilchshake"}),
	   100, 25, 0, 5,
	   ({"Zzhaxxel bringt Dir einen Kokosmilchshake.\n",
	     "&& bestellt einen Kokosmilchshake.\n"})); 

  AddDrink("Palmenblattschnaps", "schnaps",
           120, 25, 6, 4,
           ({"Zzhaxxel stellt Dir einen Becher voll Schnaps hin.\n",
             "&& trinkt einen Becher voll Palmenblattschnaps.\n"}));

  AddDrink("Ein 'Drachenodem'", ({"odem", "drachenodem"}),
           320, 75, 30, 10,
           ({"Zzhaxxel stellt sich hinter die Theke und mischt etwas zusammen.\n"
	    "Als Du die Mischung trinkst kippst Du um.\nWUHA! Das Zeug hats in sich!\n",
             "&& trinkt den beruehmten 'Drachenodem' und kippt aus den Latschen.\n"}));

  AddFood("Ein Echsenei", ({"ei", "echsenei"}), 100, 40, 17,
           ({"Zzhaxxel reicht Dir ein Echsenei.\n",
             "&& isst ein Echsenei.\n"}));

  AddFood("Ein flambiertes Eis", ({"eis"}), 250, 30, 10,
           ({"Zzhaxxel stellt einen brennenden Becher Eis vor Dich.\n"
	     "Sofort machst Du Dich darueber her.\n",
             "&& macht sich ueber ein flambiertes Eis her.\n"}));

  AddFood("Eine gegrillte Hornschwanzechse", ({"echse", "hornschwanzechse"}), 100, 15, 5,
           ({"Zzhaxxel schneidet ein Stueck Fleisch vom Grill.\n"
	     "Das Fleisch ist wunderbar zart!\n.",
             "&& isst ein gegrilltes Stueck Hornschwanzechse\n"}));

  AddItem(NPC "zzhaxxel", REFRESH_DESTRUCT);

  AddCmd( ({"setze","setz","sitze","sitz"}), "cmd_sit");
  AddCmd( ({"stecke","steck"}), "cmd_finger");
  AddCmd( ({"blicke","blick","werfe","wirf"}), "cmd_window");
  AddCmd( ({"zuende","zuend"}), "cmd_fire");

  AddExit("nordosten", ROOM "ges_4");
}

string kunden()
{
  string guild;
  if(!TP) return "Huch... da ist ein Fehler!\n";
  guild=TP->QueryProp(P_GUILD);

  switch(guild){
    case "paladine": return "Paladine sind Zzhaxxel immer willkommende Kunden.\n";
                     break;
    case "druidenzirkel": return "Druiden hat Zzhaxxel gerne als Kunden.\n";
                          break;
    case "zechpreller": return "Zechpreller hat Zzhaxxel nicht so gerne. Sie prellen immer.\n";
                        break;
    case "nekromanten": return "Nekromanten sind hier gern gesehene Gaeste.\n";
                        break;
    case "berserker": return "Berserker duldet Zzhaxxel nur solange sie nicht alles kurz und klein schlagen.\n";
                             break;
    case "bardengilde": return "Zzhaxxel hoert gerne die Lieder der Barden.\n";
                        break;
    default: return "Abenteurer sind Zzhaxxel doch die Liebsten.\n";
	     break;
  }
}

string licht()
{
  if(!TP) return "Huch... da ist ein fehler!\n";
  if(TP->QueryProp(P_RACE) != "Dunkelelf")
  {
    return "Das Licht ist angenehm warm.\n";
  }
  return "Das eklige Licht scheint Dich verbrennen zu wollen!\n";
}

int cmd_sit(string str)
{
  notify_fail("Wohin willst Du Dich setzen?\n");
  if(!(str == "an tisch" || str == "zu tisch")) return 0;

  write("Du setzt Dich an einen Tisch und stehst nach einiger Zeit wieder auf.\n");
  say(TPN+" setzt sich an einen Tisch und steht nach einiger Zeit wieder auf.\n");
  return 1;
}

int cmd_finger(string str)
{
  notify_fail("Was moechtest Du wohin stecken?\n");
  if(!(str == "finger in loch")) return 0;

  write("Du steckst einen Finger in das Loch im Tisch.\n"
	"Als Du versuchst ihn heraus zu ziehen schuerfst Du Dir die Haut auf.\n");
  TP->AddHp(-5);
  say(TPN+" fingert an einem Tisch herum.\n");
  return 1;
}

int cmd_window(string str)
{
  notify_fail("Wodurch moechtest Du wohin blicken?\n");
  if(!(str == "durch fenster" || str == "durch glas" || str == "durch fenster nach draussen" ||
       str == "durch glas nach draussen" || str == "durch glas" )) return 0;

  write("Ierks! Jetzt hat Dich doch glatt die Sonne geblendet!\n");
  TP->SetProp(P_BLIND, ([BLIND_TIME:2+random(5), BLIND_MSG:"Die Sonne hat Dich geblendet!\n",
			 BLIND_END_MSG:"Langsam erkennst Du Deine Umgebung wieder.\n"]));
  return 1;
}

int cmd_fire(string str)
{
  notify_fail("Was moechtest Du anzuenden?\n");
  if(!(str == "kamin an")) return 0;

  if(fire)
  {
    write("Im Kamin brennt bereits ein Feuer.\n");
    return -1;
  }
  write("Du entfachst ein Feuer im Kamin.\n");
  say(TPN+" macht sich am Kamin zu schaffen.\n");
  domainshout("Eine Rauchfahne kraeuselt sich aus dem Kamin der Kneipe.\n",
	      "^/d/wueste/gwenshara/echsendorf/room/");
  fire=1;
  return 1;  
}

void reset()
{
  ::reset();
  fire=0;
}
