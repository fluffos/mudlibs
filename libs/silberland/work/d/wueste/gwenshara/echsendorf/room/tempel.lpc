// von Gwenshara
// begonnen: 1.7.2003
// 
// Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

int baden=1;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein unheiliger Tempel");
  SetProp( P_INT_LONG,
     "Du befindest Dich jetzt im Inneren des groessten Lehmbaus im Dorf. "
    +"Wie vermutet ist es der Tempel. Das laesst sich daraus erkennen, dass "
    +"am hinteren Ende des Raumes ein blaeulich gluehender Altar steht. "
    +"Hinter dem Altar haengt ein violettes Banner an der Wand und an "
    +"der Decke des Hauses sind verschiedenste Kraeuter aufgehaengt. "
    +"Die allgemeine Atmosphaere hier ist duester und kuehl. Am Boden "
    +"vor dem Altar ist ein Becken eingelassen worden, in dem nicht gerade "
    +"vertrauenerweckendes Wasser blubbert.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail( ({"altar","altars"}), 
             "Im hinteren Teil des Raumes steht ein blaeulich gluehender "
            +"Altar, welche Goetter hier angebetet werden ist dir nicht klar. "
            +"Der Altar ist aus dir unbekanntem Stein gefertigt, der blaeulich "
            +"glueht und somit den Raum in kuehles, blaues Licht taucht.\n" );

  AddDetail( ({"licht","blau"}), 
            "Das Licht, das vom Altar ausgeht, taucht den Raum in kuehles "
           +"Blau.\n" );

  AddDetail( ({"raum","raumes"}), 
            "Hier bist Du herinnen, mit 'schau' kannst Du Dich umsehen.\n" );

  AddDetail( "stein", 
            "Der Altar ist aus einer Dir unbekannten Steinart gefertigt.\n" );

  AddDetail( ({"art","steinart"}), 
            "Du kennst so ziemlich alle, die des Altars ist Dir "
           +"jedoch unbekannt.\n");

  AddDetail( "atmosphaere", 
             "Sie ist hier kuehl und duester, was vermutlich durch das "
            +"Licht des Altars verursacht wird.\n" );

  AddDetail( "banner", 
             "Das Banner bedeckt die ganze hintere Wand des Tempels. "
            +"Es ist violett und darauf ist ein seltsames Symbol gemalt. "
            +"Dieses Symbol ist dir auch schon am Eingang aufgefallen.\n" );

  AddDetail( ({"symbol","symbole"}), 
            "Das Symbol entspricht einem gleichseitigen Dreieck "
           +"an dessen Ecken jeweils ein roter Punkt ist. Jetzt "
           +"erst faellt dir auf das dieses Symbol auch am Altar "
           +"und an den Waenden zu finden ist, womoeglich ist es "
           +"das Symbol der hier angebeteten Gottheit.\n" );

  AddDetail( ({"gott","goettin","gottheit","goetter"}), 
             "Der Priester kann Dir sicher mehr darueber sagen.\n" );

  AddDetail( ({"becken"}), 
            "In dem in den Boden eingelassenen Becken blubbert "
           +"tiefschwarzes Wasser. Dich ueberkommt das Beduerfnis "
           +"darin zu baden.\n" );

  AddDetail( "wasser",
	     "Das Wasser, das sich in dem Becken befindet ist dunkel. "
	     "Auch wenn das Wasser gefaehrlich erscheint wuerdest Du gerne "
	     "darin baden.");

  AddDetail( "boden",
            "Der Boden besteht auch hier aus festgetretenem Lehm, vor "
           +"dem Altar ist ein Becken in den Boden eingelassen worden.\n" );

  AddDetail( "decke", 
            "Die ist vergleichsweise zu den anderen Haeusern ziemlich hoch. "
           +"Von ihr haengen verschiedenste Kraeuter herunter, die auch einen "
           +"wuerzigen Duft verbreiten.\n" );

  AddDetail( "dorf", "Durch das Dorf bist Du hier her gelangt.\n" );

  AddDetail( "ende", "Am hinteren Ende des Raumes steht ein Altar.\n" );

  AddDetail( ({"haus","hauses","lehmbau","lehmbaus","haeusern"}), 
            "Dieses Haus hier ist eindeutig der Tempel.\n" );

  AddDetail( "himmel", 
            "Der ist hier nicht zu sehen, Du stehst ja auch in einem Haus.\n" );

  AddDetail( "inneren", "Du bist hier im Tempel innen drinnen.\n" );

  AddDetail( ({"kraeuter","kraeutern"}), 
            "Von der Decke des Tempels haengen die verschiedensten Kraeuter, "
           +"unteranderem kommt dir eines bekannt vor, die anderen kennst du "
           +"nicht.\n" );

  AddDetail( ({"kraut","wirselkraut"}), 
            "Wirselkraut ist hier das Dir einzig bekannte Kraut. "
           +"Angeblich soll es heilende Kraefte haben.\n" );

  AddDetail( ({"tempel","tempels"}), 
            "Du bist hier offensichtlich in einem gelandet.\n" );

  AddDetail( ({"wand","waende"}), 
            "An der hinteren Wand haengt ein Banner, "
           +"und an der Suedwand ist eine Inschrift zu sehen.\n" );

  AddDetail( ({"schrift","inschrift","suedwand"}), 
            "An der Suedwand erkennst du eine "
           +"Inschrift, du kannst versuchen sie zu lesen.\n" );

  AddDetail( "zeichen", 
            "Du kannst sie einfach nicht entziffern, vielleicht weiss der "
           +"Priester mehr.\n" );

  AddDetail( "teil", "Abschnitt.\n" );

  AddDetail( "abschnitt", "Teil.\n" );

  AddDetail( "eingang", "Er wurde mit einem violetten Tuch verhaengt.\n" );

  AddDetail( "tuch", "Der Eingang ist damit verhaengt.\n" );

  AddDetail( ({"dreieck","ecken","punkt"}), 
             "Das Dreieck mit jeweils einem roten Punkt an den Ecken "
            +"ist das Symbol der hier angebeteten Gottheit.\n" );

  AddDetail( "beduerfnis",
            "Dich ueberkommt das Beduerfnis in dem Becken "
           +"zu baden.\n" );

  AddDetail( "lehm", "Eine ganz spezielle Erdenart.\n" );

  AddDetail( "erdenart", "Lehm ist zB eine.\n" );

  AddDetail( "duft", "Denn sollte man besser riechen.\n" );

  AddDetail( "luft", "So richtig luftige Luft, riech doch mal.\n" );

  AddDetail( "kraefte", 
            "Welche Du hast weiss ich nicht, aber das Wirselkraut hat heilende.\n" );
//-----Details Ende-----

  AddSmell(DEFAULT_SMELL, "Hier riecht es nach wuerzigen Kraeutern.\n" );

  AddSmell( ({"kraeuter","kraeutern","duft","wirselkraut"}), 
           "Es duftet nach dir unbekannten Kraeutern "
          +"und auch nach Wirselkraut.\n" );

  AddSound(DEFAULT_SOUND, "Ein seltsamer Gesang liegt in der Luft.\n" );
  AddSound( "gesang", 
           "Du lauschst und bemerkst das dieser Gesang weder aus Worten "
          +"besteht noch von einem hier Anwesenden gesungen wird.\n" );

  AddSound( ({"worte","worten"}), "Der Gesang besteht nicht aus Worten.\n" );

  AddReadDetail(({"schrift","inschrift"}),
                  "Dir mag es nicht gelingen die hier geschriebenen Worte "
                  "zu entziffern. Vielleicht kann Dir der Priester mehr "
		"ueber diese Inschrift sagen.");


  AddCmd( ({"bade","schwimm"}),"cmd_baden");
 
  AddItem( NPC "priester", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/feyaria/drachen/obj/statue");

  AddExit("osten", ROOM "ges_4.lpc");

}

int cmd_baden(string str)
{
  notify_fail("Worin moechtest Du baden?\n");

  if(!str || str == "") return 0;
  if(!(str == "in becken" ||
       str == "in wasser" )) return 0;

  write("Du entkleidest Dich und laesst Dich misstrauisch ins Wasser gleiten "
        "und badest eine Weile darin.\nDu fuehlst Dich schon viel besser!\n");
  say(this_player()->Name()+" badet im Becken.\n");

  if(baden) {
  TP->AddHp(20+random(10));
  baden--;
  }

  return 1;
}

void reset()
{
  ::reset();

  baden=1;
}
