inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:40]));
  SetProp (P_INDOORS, 1);

  SetProp(P_INT_SHORT,"In einer dunklen Lehmhuette");

  SetProp(P_SHOPKEEPER_ID, "\ngwenshara_verkaeufer");
  SetProp(P_SHOPKEEPER_NAME, "Abyssandur");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

   SetStorageRoom(ROOM "lagerraum" );

  //Details
  AddDetail( ({"boden"}),
	     "Der Boden hier wird aus Steinplatten gebildet.");

  AddDetail( ({"steinplatten","platten"}),
	    "Sie bestehen aus dunklem Stein.");

  AddDetail("stein",
	    "Er ist aufgeraut und verschluckt einiges an Licht.");

  AddDetail( ({"fenster"}),
	     "Ein einziges Fenster laesst ein wenig Licht herrein.");

  AddDetail("licht",
	    "Ein einziger Strahl erreicht den Boden, ansonsten hellt es sehr "
	    "wenig auf. Alles wirkt duester.");

  AddDetail("strahl",
	    "Er kaempft sich goldgelb durch den kleinen Raum, wird aber vom "
	    "Stein doch verschluckt.");

  AddDetail( ({"kugel","kristallkugel","kristall"}),
	    "Auf dem kleinen Tisch liegt eine Kristallkugel auf einem "
	    "blauen Polster. Du koenntest versuchen in sie zu blicken "
	    "und etwas zu erkennen. Ob sie Dir dann die Zukunft zeigt?\n");

  AddDetail("polster",
	    "Er besteht aus blauem Samt.");

  AddDetail("samt",
	    "Ist gewiss sehr teuer.");

  AddDetail("zukunft",
	    "Trau Dich doch! Oder fuerchtest Du Dich?");

  AddDetail( ({"lehmhuette","huette","raum","verkaufsraum"}),
	    "Der ganze Raum wirkt duester. Du erkennst hie und da hinter den "
	    "Regalen, dass die Waende tatsaechlich mit Lehm verputzt sind. "
	    "Du hast das Gefuehl, dass der Lehm jeden Laut verschluckt.");

  AddDetail( ({"regale","regalen","regal"}),
	    "Der ganze Raum wird von Regalen ausgefuellt, die bis an die "
	    "Decke reichen. Sie sind voll gestopft mit allem moeglichen "
	    "Ramsch. Du fuehlst Dich sehr beengt.");

  AddDetail("decke",
	    "Die Decke ist wie die Waende mit Lehm verputzt.");

  AddDetail("lehm",
	    "Du befuehlst den Lehm, der hart und ausgetrocknet ist.");

  AddDetail( ({"waende","wand"}),
	    "Sie sind, wie die Decke, mit Lehm verputzt.");

  AddDetail("gefuehl",
	    "Es ist nur ein Gefuehl, aber trotzdem, es ist fast zu leise.");

  AddDetail("laut",
	    "Man kann absolut nichts hoeren.");

  AddDetail( ({"ramsch","menge"}),
	    "Du erkennst so einiges, aber zum Teil auch mystische Sachen, "
	    "alltaegliche Sachen wie Kochgeschirr, Stoffe, Kleidung und "
	    "Waffen.");

  AddDetail("teil",
	    "Das heisst nicht alles.");

  AddDetail("sachen",
	    "Alles moegliche.");

  AddDetail( ({"geschirr","kochgeschirr"}),
	    "Alles da was ein Abenteurer, wie Du, braucht.");

  AddDetail("abenteurer",
	    "Du bist doch einer?");

  AddDetail("stoffe",
	    "Sie liegen im Regal aufgereiht in allen Farben.");

  AddDetail("farben",
	    "Meist erdige Farben.");

  AddDetail( ({"kleidung","waffen"}),
	    "Du kannst sie Dir zeigen lassen.");

  AddDetail("tisch",
	    "Ein ganz normaler Tisch, wenn da nicht eine glaenzende "
	    "Kristallkugel liegen wuerde, die Deinen Blick auf sich lenkt.");

  AddDetail("blick",
	    "Du kannst ihn einfach nicht abwenden und starrst immer wieder "
	    "auf die Kristallkugel.");

  AddSmell(DEFAULT_SMELL, "Es riecht staubig, der durch die Hitze etwas "
	   "aufgewaermt ist.");

  AddSmell("hitze",
	   "Es ist stickig heiss herinnen. Da kann man nichts riechen.");

  AddSound(DEFAULT_SOUND, "Nicht ein einziger Laut ist zu hoeren.");


  AddSound("laut",
	   "Es ist keiner zu hoeren.");


  AddExit("nordwesten", ROOM "ges_4");
  AddItem(NPC "abyssandur", REFRESH_DESTRUCT);

  AddCmd( ({"blicke","blick","schau","schau","sieh","siehe"}), "cmd_kugel");
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einer dunklen Lehmhuette. Die Waende sind voll"
	"geraeumt mit Regalen, auf denen jede Menge Ramsch steht. Mitten im "
	"Verkaufsraum steht ein kleiner Tisch. Nur durch ein einziges Fenster kommt "
	"ein klein wenig Licht in den Raum. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Auch wenn niemand hier ist fuehlst Du Dich beobachtet.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}

int cmd_kugel(string str)
{
  if(!str) return 0;
  if(!(str == "in kugel" ||
       str == "in kristallkugel" )) return 0;

  if(!(TP->QueryProp(P_SP) > 21))
  {
    write("Du blickst in die Kugel doch nichts tut sich.\n");
    say(TPN+" blickt gelangweilt in die Kristallkugel.\n");
    return -1;
  }

  switch(random(3))
  {
     case 1: write(BS("Langsam wird die Kugel klarer und Du erkennst eine Hoehle, in ihr "
		   "befindet sich das Skelett einer gewaltigen Seeschlange und auf dem "
	           "Kopf der Seeschlange ruht ein Trinkhorn.\n"));
             say(TPN+" stiert in die Kristallkugel.\n");
             break;
     case 2: write(BS("Langsam wird die Kugel klarer und Du blickst aus grosser Hoehe auf "
		   "ein Schlachtfeld, auf dem sich die Leichen tapferer Recken befinden."
                   "Ein einsamer Reiter reitet darueber hinweg als die ersten Sonnenstrahlen "
                   "ueber den Horizont kriechen.\n"));
             say(TPN+" stiert in die Kristallkugel.\n");
             break;
     case 3: write(BS("Langsam wird die Kugel klarer und Du erkennst zuerst nur Wolken. Doch dann "
		   "lichten sie sich und Du blickst auf einen gewaltigen Berg. Auf dem Berg siehst "
		   "Du einen Titanen, der Dir beinahe wie ein Gott erscheint.\n"));
	     say(TPN+ "stiert in die Kristallkugel.\n");
	     break;
     default: write(BS("Langsam wird die Kugel klarer und Du erblickst ein Einhorn. Das Tier "
		    "laeuft durch einen finsteren Wald, gejagt von schrecklichen Daemonen. "
		    "Ein gifttriefender Speer verwundet das Tier, doch es laeuft unbeirrt "
		    "weiter aus dem Wald hinaus, ins Licht wohin ihm die duesteren Daemonen "
		    "nicht folgen.\n"));
	     say(TPN+" stiert in die Kristallkugel.\n");
	    break;
  }

  write("Ob diese Vision eine Bedeutung hat?\n");
  TP->AddSp(-random(20));
  return 1;
}
