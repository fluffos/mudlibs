// von Gwenshara
// 6.7.2003


inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einem Dorf");
  SetProp( P_INT_LONG,
   "Du befindest Dich jetzt noerdlich des Dorfplatzes. Im Norden befindet sich "
  +"das blaeulich gluehende Haus, das Du schon vorher ausmachen konntest. Nach "
  +"Osten und Westen hin geht es die Palisade entlang. Im Sueden geht es auf "
  +"den Dorfplatz und von dort auf den Tempel zu. Du stehst hier auf einer "
  +"kleinen Erhebung, so dass Du ueber die Palisade sehen kannst.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( ({"dorfplatz","dorfplatzes", "platz"}), 
            "Der ist suedlich von hier.\n" );

  AddDetail( "norden", 
            "Im Norden befindet sich ein seltsam blaeulich "
           +"gluehendes Haus.\n" );

  AddDetail( "haus", 
            "Das Haus im Norden scheint sehr interessant zu sein, "
           +"es glueht blaeulich. Du siehst an ihm sogar "
           +"eine Tuer, und nicht nur ein Tuch, das den Eingang "
           +"verhaengt.\n" );

  AddDetail( ({"tuch","eingang"}), 
            "Der Eingang dieses Hauses hat eine Tuer.\n" );

  AddDetail( "tuer", 
            "Der Eingang des Hauses im Norden ist durch eine geschlossene Tuer "
           +"versperrt. Vielleicht oeffnet man Dir, wenn du klopfst.\n" );

  AddDetail( ({"palisade","osten","westen", "zaun", "palisadenzaun"}), 
            "Die Palisade geht nach Osten und Westen "
            +"weiter. Da Du hier auf einer Erhebung stehst, kannst Du "
            +"ueber die Palisade blicken.\n" );

  AddDetail( "erhebung", 
            "Du stehst hier auf einer solchen und kannst ueber die Palisade "
           +"blicken.\n" );

  AddDetail( "boden", 
            "Du stehst auf ihm, er besteht aus festem Lehm und ist hier leicht "
           +"gehoben, so das Du auf einer Erhebung stehst.\n" );

  AddDetail( "himmel", 
            "Der ist meistens oben. Hier ist er strahlend blau, da ihn "
           +"keine Wolke truebt.\n");

  AddDetail( "wolke", "Keine da, der Himmel ist strahlend blau.\n");

  AddDetail( ({"lehm","lehmerde"}), 
            "Also wirklich, hast Du in den vorigen Raeumen nicht geforscht?\n"
           +"Aber egal, Lehm ist eine spezielle Erdenart.\n" );

  AddDetail( ({"erde","erdenart"}), "Lehm ist zB eine.\n" );

  AddDetail( "tempel", 
            "Der ist von hier aus im Suedwesten. Darin findest Du auch "
           +"den Priester.\n" );

  AddDetail( "suedwesten", "Dort steht der Tempel.\n" );

  AddDetail( "priester", 
             "Sieh mal im Tempel nach.\n" );

  AddDetail( ({"raeume","raeumen"}), 
            "Haettest Du auch in den vorherigen geforscht, wuesstest Du "
           +"mittlerweile was Lehm ist.\n" );

  AddDetail( ({"duenen","duenenkamm","duene","duenenkaemme"}),
            "Dort erspaehst Du eine Reihe schwarzer Schatten.\n");

  AddDetail( ({"reihe","schatten","schattenreihe"}),
            "Da war doch gerade noch ein Schatten, jetzt ist er wieder weg.\n" );
//-----Details Ende-----

  AddSmell( DEFAULT_SMELL, "Hier riecht es nach nichts Besonderem.\n" );

  AddSmell( ({"besonderen","besonderes"}), 
           "Nach sowas riecht es hier eben nicht.\n" );

  AddSound( DEFAULT_SOUND, 
           "Aus dem Haus hoerst Du Geraeusche, was die Geraeusche "
          +"verursacht kannst Du aber nicht sagen.\n" );

  AddSound( ({"haus","tuer"}), "Aus dem Haus kommen undeutliche Geraeusche.\n" );

  AddSound( ({"geraeusch","geraeusche"}), "Sie sind leider zu undeutlich.\n" );

  AddCmd( ({"blicke","blick"}),"cmd_blicken");
  AddCmd( ({"klopf","klopfe"}),"cmd_klopfen");
  AddCmd( ({"sag","sage"}),"cmd_wort");

  AddExit("sueden", ROOM "ges_4");
  AddExit("westen", ROOM "ges_6");
  AddExit("osten", ROOM "ges_12");
}

int cmd_blicken(string str)
{
  notify_fail("Worueber willst Du blicken?\n");
  if(!str || str == "") return 0;
  if(!(str == "ueber palisade" ||
       str == "ueber palisadenzaun" ||
       str == "ueber zaun" )) return 0;

  write(BS("Du blickst ueber den Palisadenzaun und siehst die Duenenkaemme "
           "entlang. Da faellt Dir eine Reihe schwarzer Schatten auf, die sich "
           "auf einem Duenenkamm bewegt.\n"));
  return 1;
}

seq1()  {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Du klopfst kurz an der Tuer.\n\n"));   
  call_out("seq2",4);
}
seq2() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Irgendwie reagiert man nicht auf Dich und Du klopfst noch mal.")+"\n");
  call_out("seq3",7);
}
seq3() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Langsam oeffnet sich die Tuer einen Spalt und das Gesicht einer "
          +"Echse taucht auf.")+"\n");
  call_out("seq4",6);
}
seq4() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Die Echse mustert Dich kurz und beginnt dann zu sprechen.")+"\n");
  call_out("seq5",7);
}
seq5() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Die Echse sagt: \"Dich kenne ich nicht!\"")+"\n");
  call_out("seq6",8);
}
seq6() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Die Echse sagt: \"Ich traue Dir zwar nicht, "
        +"aber wenn Du den Namen unserer "
        +"Goettin kennst darfst du trotzdem herein. Sag ihn einfach "
        +"ich werde ihn auch durch die Tuer durch hoeren.\"")+"\n");
  call_out("seq7",7);
}
seq7() {
  if(TP && ENV(TP)!=ME) return;
  write(BS("Die Echse sieht Dich noch etwas an und schliesst dann die Tuer "
          +"wieder."));
  TP->SetProp(P_PARALYZED, 0);
}

int cmd_klopfen(string str)
{
  notify_fail("Woran moechtest Du klopfen?\n");
  if(!str || str == "") return 0;
  if(!(str == "an tuer" ||
       str == "an haus" ||
       str == "an eingang" )) return 0;

  TP->SetProp(P_PARALYZED, 60);
  call_out("seq1",0);
  return 1;
}

int cmd_wort(string str)
{
  notify_fail("Was moechtest Du sagen?\n");
  if(!str || str == "") return 0;
  if(!(str == "charyb'yzz" ||
       str == "charyb yzz" ||
       str == "charybyzz"  )) return 0;

  write("Die Tuer oeffnet sich und die Echse zerrt Dich schnell herein.\n");
  say(this_player()->name()+" wird von einer Echse ins Haus gezerrt.\n");
  TP->move(ROOM "haus",M_NOCHECK | M_SILENT);

  return 1;
}
