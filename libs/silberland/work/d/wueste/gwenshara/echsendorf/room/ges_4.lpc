// von Gwenshara
// begonnen: 1.7.2003
// 
// Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Auf einem Dorfplatz");
  SetProp( P_INT_LONG,
     "Du stehst auf einem groesseren Platz, vermutlich der Dorfplatz. Er wird "
    +"in der Mitte von einem gewaltigen Kohlebecken dominiert und rundherum "
    +"befinden sich ebenfalls Haeuser. Im Westen siehst du das groesste "
    +"Lehmhaus, den Tempel. Sein Eingang ist mit einem violetten Tuch "
    +"verhaengt worden, sodass man nicht ins Innere blicken kann. Im Sueden "
    +"findest Du ein eher kleines Lehmhaeuschen, dessen Eingang durch "
    +"Stufen nach unten zu erreichen ist. Im Norden geht es auf ein Lehmhaus "
    +"zu, welches in leichtem Blau zu gluehen scheint.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( ({"platz","dorfplatz"}),
            "Du befindest dich auf ihm. Er wird von einem gewaltigen "
           +"Kohlebecken dominiert. Rundherum stehen Lehmbauten, "
           +"vor allem die Gebaeude im Sueden und Westen fallen "
           +"Dir auf.\n" );

  AddDetail( "mitte", "Dort steht ein gewaltiges Kohlebecken.\n" );

  AddDetail( ({"becken","kohlebecken","schale"}),
            "Das ist eine grosse, aus schwarzem Metall gegossene Schale. Sie "
           +"wurde mit Kohlen gefuellt, die noch schwach gluehen. Eigentlich "
           +"sollte es Dir noch gelingen ein Feuer zu entfachen.\n" );

  AddDetail( ({"haus","haeuser","bauten","lehmhaeuschen","haeuschen"}),
            "Im Westen kannst du in ein groesseres Haus gelangen und im "
           +"Sueden gelangst du ein kleines Haeuschen.\n" );

  AddDetail( ({"tempel","lehmbau"}),
            "Der grosse Lehmbau im Westen ist vermutlich der Tempel. Sein "
           +"Eingang wurde mit einem violetten Tuch verhaengt.\n" );

  AddDetail( ({"eingang","tuer"}),
            "Der Eingang des Tempels wurde mit einem violetten Tuch verhaengt. "
           +"Ueber ihm sind ein paar Glyphen angebracht worden.\n" );

  AddDetail( ({"glyphen","symbole","glyphe"}),
            "Du kannst nur eine Glyphe identifizieren, und zwar die zum Schutz, "
           +"wogegen ist Dir allerdings nicht klar. Alle anderen kannst du zwar "
           +"nicht entziffern, sie strahlen aber eine eher unheilige Aura "
           +"aus.\n" );

  AddDetail( ({"tuch","vorhang"}),
            "Er ist dunkelviolett und etwas zerrissen.\n" );

  AddDetail( "stufen", "Sie fuehren in das kleine Lehmhaeuschen.\n" );

  AddDetail( ({"lehmhaus","norden"}),
            "Das Lehmhaus im Norden glueht in blassem Blau, irgendwie "
           +"interessant was? Vielleicht solltest Du dem Haus einen "
           +"Besuch abstatten.\n" );

  AddDetail( "boden", "Da stehst Du drauf, er besteht aus festem Lehm.\n" );

  AddDetail( "himmel", "Er ist klar und himmelblau.\n" );

  AddDetail( ({"kohle","kohlen","holzkohle","teile"}),
            "Kleine schwarze Holzkohlestueckchen.\n");

  AddDetail( ({"stueckchen","holzkohlestueckchen"}),
            "Kleine Teile von Holzkohle, sie wurden extra hier fuer "
           +"hergestellt.\n" );

  AddDetail( "blau", "Kornblumenblau, die Farbe des Abendhimmels.\n" );

  AddDetail( "lehm", "Eine bestimmte Erdenart.\n" );

  AddDetail( "gebaeude", "Vor allem die im Westen und Sueden fallen Dir auf.\n" );

  AddDetail( "lehmbauten", "Sie stehen rund um den Platz.\n" );

  AddDetail( "aura", "Sie traegt nicht gerade zu Deinem Wohlbefinden bei.\n" );

  AddDetail( "schutz", "Etwas bewahren.\n" );

  AddDetail( "innere", "Das ist innen drin.\n" );

  AddDetail( "metall", "Das Kohlebecken ist aus schwarzem Metall gegossen.\n" );

  AddDetail( "erdenart", "So etwas wie Lehm zB.\n" );

  AddDetail( "luft", "Ganz schoen luftig die Luft, nicht war?n" );

  AddDetail( ({"wirselkraut","kraut"}), "Ein heilendes Kraut.\n" );

  AddDetail( ({"abendhimmels","abendhimmel"}), 
            "Den kannst Du nur am Abend sehen.\n" );

  AddDetail( ({"farben","farbe"}), "Rot, Gruen, Gelb ...\n" );

  AddDetail( ({"rot","gruen","gelb"}), "Sowas nennt man Farben.\n" );

  AddDetail( "abend", "Die Zeit bevor es Nacht wird.\n" );

  AddDetail( "nacht", "Die Zeit nach dem Abend.\n" );

  AddDetail( "zeit", "Ich weiss nicht wie spaet es ist.\n" );

  AddDetail( "feuer", 
            "Es sollte Dir noch gelingen im Kohlebecken eines zu entfachen.\n" );

  AddDetail( ({"befinden","wohlbefinden"}),
	     "Ganz wohl fuehlst Du Dich nicht.");
//-----Details Ende-----

  AddSmell( DEFAULT_SMELL,
           "Es riecht irgendwie verbrannt, aus dem Tempel "
          +"riecht es nach Kraeutern.\n" );

  AddSmell( ({"kraeuter","kraeutern"}), 
            "Der Duft von Wirselkraut liegt in der Luft.\n" );

  AddSound( DEFAULT_SOUND,
          "Du hoerst nichts, absolut nichts. Doch, hin und wieder ertoent "
         +"eine dunkle Stimme aus dem Tempel, leider sind die Worte "
         +"unverstaendlich.\n" );

  AddSound( "stimme", 
           "Die Stimme klingt dunkel, leider sind keine Worte zu verstehen.\n" );

  AddSound( ({"wort","worte"}), 
           "Du kannst leider keines von ihnen verstehen, es ist "
          +"auch eher ein Gesang.\n" );

  AddSound( "gesang", "Du hoerst es ganz deutlich, im Tempel singt jemand.\n" );


  AddCmd( ({"entfache","entfach"}),"cmd_entfach");

  AddItem( NPC "echswache", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "eroom");
  AddExit("westen", ROOM "tempel");
  AddExit("sueden", ROOM "dorfae");
  AddExit("norden", ROOM "ges_5");
  AddExit("suedwesten", ROOM "pub");
  AddExit("suedosten", ROOM "haendler");

}

int cmd_entfach(string str)
{
  notify_fail("Was moechtest Du entfachen?\n");

  if(!str || str == "") return 0;
  if(!(str == "becken" ||
       str == "feuer"  ||
       str == "kohlen" )) return 0;

  if(TP->QueryAttribute(A_DEX) > 4+random(10)){
     write("Dir gelingt es ein Feuer zu entfachen.\n"
          +"Du verbrennst Dich und pustest das Feuer "
          +"voller Wut wieder aus.\n");
     this_player()->AddHp(-13);
     return 1;
  }

  write("Dir gelingt es nicht ein Feuer zu entfachen.\n");

  return -1;
}
 
