inherit "std/room";

#include <properties.h>
#include "../def.h"

int weide, entfernt, rinde;

string pot()
{
  if(weide)
    return BS("Aus der Erde, im Blumentopf, windet sich eine kleine Weide.");
  return BS("Im Blumentopf befindet sich lediglich staubtrockene Erde.");
}

string tree()
{
  if(weide)
    return BS("Ein kleiner Weidenbaum schlaengelt sich aus dem "
	      "Blumentopf. Du koenntest wohl seine Rinde abschaben, da "
	      "sie angeblich heilende Wirkung haben soll.");
  return "Sowas siehst Du da nicht!";
}

string save()
{
  if(TP->QueryProp(P_RACE) == "Fee")
    return BS("So sicher, wie Du eine Fee bist.");
  return BS("So sicher, wie Du ein"+(TP->QueryProp(P_GENDER)==MALE?" ":"e ")+
	  TP->QueryProp(P_RACE)+(TP->QueryProp(P_GENDER)==MALE?" ":"e ")+
	  "bist.");
}

string hole()
{
  if(entfernt)
    return BS("An der Wand erkennst Du ein Loch. Damit kann man sicher etwas "
	   "Tolles machen!");
  return BS("An der Wand ist etwas, allerdings kannst Du wegen der Pflanze "
	 "nichts erkennen. Wenn sie nur nicht da waere...");
}


void create()
{
  ::create();
  weide=0;
  entfernt=0;
  rinde=2;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Auf einem Balkon");
  SetProp( P_INT_LONG,
   "Du befindest Dich hier auf einem kleinen Balkon. Nach Westen hin kannst Du in die "
   "Wueste blicken. An der Turmwand windet sich eine Schlingpflanze empor und am Boden "
   "steht ein Blumentopf, der mit Erde gefuellt worden ist. Das Gelaender, das Dich "
   "davor bewahrt in die Tiefe zu stuerzen, ist ebenfalls von der Schlingpflanze "
   "bewachsen. Offenbar wird dieser Balkon nur sehr selten aufgesucht und wirkt deswegen "
   "auch etwas ungepflegt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);

//-----Details Anfang-----
  AddDetail( ({"balkon"}),
	    "Du bist Dir sicher - Das ist ein Balkon." );

  AddDetail( ({"wueste","westen"}),
            "Im Westen kannst Du die unendlichen Weiten der Wueste erkennen. Im Suedwesten "
	    "scheint ein Sandsturm zu wueten." );

  AddDetail( ({"wand","turmwand"}),
            "Die Turmwand wird von einem Gespinst aus Ranken verdeckt. Diese Schlingpflanze "
	    "scheint ganz schoen hartnaeckig zu sein." );

  AddDetail( ({"pflanze","schlingpflanze","gespinst","ranken"}),
            "Die Pflanze schlingt und windet sich an der Wand und ueber das Gelaender des Balkons "
	    "empor. Sie ist fast ganz vertrocknet und man kann Stellen der Wand und "
	    "des Gelaenders durch sie hindurch erkennen." );

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus - teilweise bruechigen - Holzplatten. Auf ihm "
	    "findest Du einen Blumentopf.");

  AddDetail( ({"topf","blumentopf","erde"}), #'pot);

  AddDetail( ({"gelaender","gelaenders"}),
	    "Das Gelaender wurde schlicht gehalten. Es besteht nur aus ein paar Holzstreben, "
	    "aber dennoch ist es auesserst stabil. Es bewahrt Dich davor unabsichtlich "
	    "in die Tiefe zu stuerzen.");

  AddDetail( ({"tiefe"}),
	    "Bis zum Boden ist es ein ganz schoenes Stueck. Wenn Du Dich da hinunter "
	    "stuerzt, bist Du mit ziemlicher Sicherheit tot.");

  AddDetail( ({"weiten"}),
	    "Du bist hier irgendwo in den Weiten der Wueste.");

  AddDetail( ({"sturm","sandsturm"}),
	    "Weit im Westen wuetet ein Sandsturm. Gut das Du nicht dort bist, sonst "
	    "haettest Du sicher die Orientierung verloren.");

  AddDetail( ({"stellen"}),
	    "Nur ein paar Stellen sind von der Pflanze verschont worden. Eine der "
	    "Stellen sticht besonders hervor.");

  AddDetail( ({"platten","holzplatten"}),
	    "Die Platten am Boden sind bereits teilweise sehr bruechig und Du musst "
	    "aufpassen, nicht zu stolpern.");

  AddDetail( ({"weide","baum", "weidenbaum"}), #'tree);

  AddDetail( ({"streben","holzstreben"}),
	    "Das Gelaender besteht aus ein paar stabilen Holzstreben, die Dich "
	    "davor bewahren in die Tiefe zu stuerzen.");

  AddDetail( ({"stueck"}),
	    "Bis zum Boden ist es ganz schoen weit...");

  AddDetail( ({"sicherheit"}), #'save);

  AddDetail( ({"orientierung"}),
	    "Wenn Du sie verloren hast, dann solltest Du sie suchen.");

  AddDetail( ({"stelle"}), #'hole);

  AddDetail( ({"himmel"}),
    "Die Sonne brennt vom Himmel.");

  AddDetail( ({"sonne"}),
    "Die Sonne hier in der Wueste bringt Dich noch um!");

  AddDetail( ({"ferne"}),
    "Irgendwo, weit in der Ferne, heult ein Sandsturm.");

  AddDetail( "loch", #'hole);
  
//-----Details Ende-----

  AddSound(DEFAULT_SOUND, "In der Ferne heult der Sandsturm.");
  AddSound( ({"sturm","sandsturm"}),
	   "Huuuuuuuuhuuuuuuuuuuuu!");

  AddCmd( ({"stuerz","stuerze"}), "cmd_suizid");
  AddCmd( ({"giesse","giess","bewaesser","bewaessere",
	    "leer","leere","fuell","fuelle"}), "cmd_water");
  AddCmd( ({"schabe","schab"}), "cmd_rinde");
  AddCmd( ({"entfern","entferne"}), "cmd_entfernen");
  AddCmd( ({"greife","greife","fass","fasse"}), "cmd_loch");

  AddExit( "osten", ROOM "turm_o");
}

int cmd_loch(string str)
{
  object ob;
  notify_fail("Wohin moechtest Du greifen?\n");
  if(!str || str == "") return 0;
  if(!(str == "in loch")) return 0;

  notify_fail("Die Schlingpflanze verdeckt das Loch noch.\n");
  if(!entfernt) return 0;

  ob = clone_object(OBJ "zettel");
  write("Du greifst in das Loch und findest etwas, das Du sofort einsteckst.\n");
  say(TPN+" macht etwas an der Wand.\n");
  if(ME_TOO_HEAVY == ob->move(TP, M_GET))
  {
    write(BS("Der Zettel ist so schwer, dass er Dir zu Boden faellt."));
    ob->move(ENV(TP), M_GET);
  }
  return 1;
}

int cmd_entfernen(string str)
{
  notify_fail("Was moechtest Du entfernen?\n");
  if(!str || str == "") return 0;
  if(!(str == "ranken von wand" ||
       str == "ranken von stelle" ||
       str == "pflanze von wand" ||
       str == "pflanze von stelle" ||
       str == "schlingpflanze von stelle" ||
       str == "schlingepflanze von wand" ||
       str == "pflanze" ||
       str == "ranken" ||
       str == "schlingpflanze")) return 0;

  notify_fail("Aber die Schlingpflanze ist doch schon entfernt.\n");
  if(entfernt) return 0;

  write("Du entfernst die Pflanze von der Stelle und kannst sie jetzt besser betrachten.\n");
  say(TPN+" werkt an der Schlingpflanze herum.\n");
  entfernt=1;
  return 1;
}

int cmd_rinde(string str)
{
  object ob;
  notify_fail("Was willst Du abschaben?\n");
  if(!str || str == "") return 0;
  if(!(str == "rinde ab" ||
       str == "rinde von weide" ||
       str == "rinde von baum" ||
       str == "rinde von weidenbaum")) return 0;

  notify_fail("Was willst Du abschaben, wenn gar nichts da ist?\n");
  if(!weide) return 0;

  notify_fail("Wenn Du noch mehr Rinde abschabst, sieht der Baum wirklich nackt aus.\n");
  if(!rinde) return 0;

  ob = clone_object(OBJ "aspirin");
  write("Du schabst etwas Rinde von der Weide.\n");
  say(TPN+" schabt etwas Rinde von der Weide.\n");

  if(ME_TOO_HEAVY == ob->move(TP, M_GET))
  {
    write(BS("Das Stueck Rinde faellt zu Boden."));
    ob->move(TO, M_GET);
  }
  rinde--;
  return 1;
}

int cmd_water(string str)
{
  object ob;
  notify_fail("Was moechtest Du womit giessen?\n");
  if(!str || str == "") return 0;
  if(!(str == "topf mit flaeschchen" ||
       str == "topf mit flasche" ||
       str == "blumentopf mit flaeschchen" ||
       str == "blumentopf mit flasche" ||
       str == "erde mit flaeschchen" ||
       str == "erde mit flasche" ||
       str == "flaeschchen in topf" ||
       str == "flasche in topf" ||
       str == "flaeschchen auf erde" ||
       str == "flasche auf erde" ||
       str == "flaeschchen in blumentopf" ||
       str == "flasche in blumentopf"  )) return 0;

  notify_fail("Du hast doch gar kein Flaeschchen!\n");
  if(!ob=present("\nechs_kanne", TP)) return 0;

  notify_fail("Das musst Du doch gar nicht mehr machen.\n");
  if(weide) return 0;

  write("Vorsichtig bewaesserst Du den Blumentopf.\n\n"
        "*WUSCH*\n\nPloetzlich waechst ein kleiner Weidenbaum aus "
	"dem Topf.\n");
  say(TPN+" leert etwas aus einem Flaeschchen in den Blumetopf\n\n"
      "*WUSCH*\n\nPloetzlich waechst ein kleiner Weidenbaum aus dem Topf.\n");
  weide=1;
  ob->remove(1);
  write(BS("Das nunmehr leere Flaeschchen wirfst Du gleich weg."));
  return 1;
}

int cmd_suizid(string str)
{
  notify_fail("Wohin willst Du Dich stuerzen?\n");
  if(!str || str == "") return 0;
  if(!(str == "in tiefe" ||
       str == "runter" ||
       str == "auf boden" ||
       str == "hinunter" )) return 0;

  write(BS("Du nimmst Anlauf und springst vom Balkon in die Tiefe...")+"\n\n");
  say(TPN+" nimmt Anlauf und spring vom Balkon...\nOb das eine so gute Idee war?\n");

  SetProp(P_KILL_NAME, "Ein Sprung in die Tiefe");
  TP->SetProp(P_KILLER, TO);
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_NOCHECK|M_SILENT|M_NO_SHOW);
  TP->SetProp(P_KILLER, 0);
  SetProp(P_KILL_NAME, 0);

  return 1;
}

void reset()
{
  ::reset();
  if(entfernt)
  {
    entfernt=0;
    say("Die Schlingepflanze wuchert wieder ueber die Waende.\n");
  }

  if(weide)
  {
    weide=0;
    say("Die Weide vertrocknet und zerfaellt zu Staub.\n");
  }

  rinde = 2;
}

public void InformBardSongPlayed(object who, int success) {
  object wind;
  if(!objectp(present("\nbard_windflasche", who))) return;
  if(objectp(present("\nbarden_wind"))) return;

  if(success < 1000) {
    tell_object(who, BS("Dein Spiel scheint nicht gut genug zu sein, um einen Wind herbeizurufen."));
    return;
  }

  wind = clone_object("/gilden/bardengilde/npc/suedwind");
  wind->move(this_object(), M_GO);
}
