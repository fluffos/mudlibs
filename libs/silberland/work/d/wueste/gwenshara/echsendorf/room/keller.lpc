#include "../def.h"

inherit "std/room";

int katze, trank;

void create()
{
  ::create();
  trank = 3;
  katze = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem kuehlen Keller");
  SetProp(P_INT_LONG,
    "Du befindest Dich jetzt im Keller des Hauses. Hier unten hat, wie "
    "es aussieht, ein ziemlich aggressives Tier gewuetet. Die Regale, die "
    "wohl an den Waenden stehen sollten, sind grossteils umgeworfen. Der "
    "ganze Boden ist mit zerbrochenen Kruegen, Toepfen und aehnlichem "
    "uebersaet. Es ist angenehm kuehl."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "keller" }), QueryProp(P_INT_LONG)
  );

  AddDetail( ({"decke", "schicht", "erde"}),
    "Ueber Dir trennt eine Schicht aus Erde den Keller vom Haus.");

  AddDetail( ({ "haus","hauses","jaeger" }),
    "Ueber Dir befindet sich das Haus der Jaeger."
  );

  AddDetail( ({ "tier" }),
    "Das Tier muss sehr wuetend gewesen sein und hatte wohl, wie Du an den "
    "Spuren der Waende und auf dem Boden erkennst, sehr scharfe Krallen."
  );

  AddDetail( ({ "regale" }),
    "Die Regale wurden umgeworfen und ihr Inhalt hat sich somit ueber den "
    "gesamten Boden verteilt. Ein Regal an der Nordwand ist verschont geblieben."
  );

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind mit unzaehligen Kratzspuren versehen."
  );

  AddDetail( ({ "boden" }),
    "Der Boden ist mit den Inhalten der Regale uebersaet."
  );

  AddDetail( ({ "toepfe","kruege","aehnliches","aehnlichem","inhalt" }),
    "Die Toepfe und Kruege sind zerbrochen oder leer. Manche sind sogar beides. "
    "Ein Krug sticht aus dem ganzen Chaos heraus."
  );

  AddDetail( ({"chaos"}),
    "Alles hier ist total durcheinander... ein richtiges Chaos!"
  );

  AddDetail( ({ "krallen" }),
    "Du hoffst, dass Du diesen Mordwerkzeugen niemals begegnen musst."
  );

  AddDetail( ({ "regal" }),
    "Das Regal an der Nordwand ist nicht umgefallen. Trotzdem befindet sich nichts in "
    "ihm. Als Du das Regal naeher betrachtest faellt Dir auf, dass der Schatten dahinter "
    "nicht zu ihm passt."
  );

  AddDetail( ({ "nordwand" }),
    "An der Nordwand steht das einzige Regal, das verschont worden ist."
  );

  AddDetail( ({ "spuren","kratzspuren" }),
    "Die Kratzspuren wurden von extrem scharfen Krallen in die Waende gerissen."
  );

  AddDetail( ({ "krug" }),
    "Der Krug ist noch ganz und eine seltsame Fluessigkeit ist in ihm."
  );

  AddDetail( ({ "werkzeuge","mordwerkzeuge","mordwerkzeugen" }),
    "Die Krallen des Tieres muessen stahlhart sein."
  );

  AddDetail( ({"schatten"}),
     "Ein Schatten hinter dem Regal passt nicht dazu."+
     (katze>0?" Ausserdem fallen Dir zwei gruene Katzenaugen auf.":""));

  
  AddDetail( ({"fluessigkeit"}),
    "Die Fluessigkeit ist neonblau. Es koennte sich um einen Heiltrank handeln.");
  
  AddSpecialDetail( ({ "augen","katzenaugen" }),
     "detail_augen"
  );

  AddDetail( ({"trank","heiltrank","kraefte","kraeften"}),
    "Ein Trank mit heilenden Kraeften.");

  AddSound( DEFAULT_SOUND,
    "Du vernimmst ein leises Schnurren"
  );

  AddSound( ({ "schnurren" }),
    "Es scheint von dem Regal an der Nordwand zu kommen.");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_TRINKEN, "cmd_heiltrank" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", ([EX_DEST:  ROOM "haus", EX_TESTFUNC: "exfun_raus"]) );
 
}

//--Ausgangs Funktionen----------------------------------------------------
int exfun_raus()
{
  if(TP->QueryProp(P_LEVEL) < 16 || !(TP->InFight())) return 1;
  if(present("\nantonio"))
  {
    write("Antonio schnurrt: So leicht entkommst Du mir nicht!\n");
    say("Antonio schnurrt: So leicht entkommst Du mir nicht!\n");
    return 0;
  }
  return 1;
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_heiltrank(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "trank" ||
       str == "heiltrank" ||
       str == "fluessigkeit" )) return 0;
  
  if(trank-- > 0)
  {
    tell_object(TP, "Du trinkst einen Schluck vom Heiltrank und fuehlst Dich gleich besser.\n");
    TP->AddHp(10+random(10));
  }
  else
    tell_object(TP, "Du trinkst einen Schluck vom Heiltrank aber es tut sich nichts.\n");
  TO->Message(TP->Name(WER, 1)+" trinkt aus einem Krug.\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//--Funktionen fuer Details------------------------------------------------

string detail_augen(string str)
{
  if(katze)
  {
    clone_object(NPC "antonio")->move(TO, M_NOCHECK|M_SILENT);
    say(BS("Ein gestiefelter Kater springt hinter dem Regal hervor und verneigt sich vor Dir."));
    katze=0;
    return BS("Ein gestiefelter Kater springt hinter dem Regal hervor und verneigt sich vor Dir.");
  }

  return "Aber die siehst Du doch gar nicht.\n";
}

void ReCat()
{
  katze=1;
}

void reset()
{
  ::reset();
  if(present("\nantonio"))
   present("\nantonio")->reset();
  else
    katze = 1;
  trank=3;
}
