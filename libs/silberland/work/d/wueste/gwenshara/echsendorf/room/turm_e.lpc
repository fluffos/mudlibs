inherit "std/room";

#include <properties.h>
#include "../def.h"

string schatten();

int kobold;

void create()
{
  ::create();
  kobold=1;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Im Turm der Stadtwache");
  SetProp( P_INT_LONG,
   "Du befindest Dich hier im untersten Stockwerk des Stadtwachenturms. Hier "
   "sind einige Reitechsen angehaengt worden. Am hinteren Ende der Halle steht ein "
   "Trog voll frischem Wasser. An der Nordwand befinden sich Faesser, die mit "
   "verschiedensten Waffen gefuellt worden sind. An der Suedwand erkennst Du "
   "einige Eimer, in denen ein trockenes Pulver aufbewahrt wird." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_NAME, "feiger Schatten");
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail( ({"werk","stockwerk","stockwerken"}),
	    "Der Turm der Stadtwache besteht aus drei Stockwerken." );

  AddDetail( ({"turm","stadtwachenturm"}),
	    "In diesem, dreistoeckigen Turm, ist die Stadtwache untergebracht "
	    "worden." );

  AddDetail( ({"echsen","reitechsen","reittiere"}),
	    "Die Reitechsen, die hier angebunden wurden, sind stolze, grosse "
	    "Tiere. Sie laufen auf zwei Beinen und haben keine Haende." );

  AddDetail( ({"ende"}),
	    "Am hinteren Ende der Halle befindet sich ein Trog. Er wurde mit Wasser "
	    "gefuellt. Vermutlich werden dort die Reitechsen getraenkt." );

  AddDetail( ({"halle"}),
	    "Man kann diesen Raum hier eigentlich nicht wirklich als Halle bezeichnen. "
	    "Dazu ist er viel zu klein und zu niedrig. Als Du Dich hier so umsiehst, faellt "
	    "Dir eine Leiter auf." );

  AddDetail( ({"trog"}),
	    "Der Trog, der am hinteren Ende der Halle steht, wurde bis zum Rand mit Wasser "
	    "gefuellt. Am Grund des Troges faellt Dir ein seltsamer Schatten auf." );

  AddDetail( ({"nordwand","faesser"}),
	    "An der Nordwand wurden Faesser aufeinander gestapelt, einige sind offen und "
	    "Du erkennst, dass Waffen aller Art ihnen gelagert werden. Vermutlich befinden sich "
	    "in ihnen auch verschiedenste Vorraete." );

  AddDetail( ({"eimer", "suedwand"}),
	    "In den Eimern, die an der Suedwand stehen, wird ein trockenes Pulver aufbewahrt." );

  AddDetail( ({"pulver"}),
	    "Das Pulver in den Eimern ist von schmutzig weisser Farbe. Wie Du es durch Deine "
	    "Finger rieseln laesst, kommst Du auf die absolut abwegige Idee, dass das Pulver "
	    "im Wasser loesbar ist." );

  AddDetail( ({"stadtwache","wache"}),
	    "Die Wache ist dafuer verantwortlich, dass hier niemand Unsinn anstellt." );

  AddDetail( ({"tiere"}),
	    "Welche Tiere genau?" );

  AddDetail( ({"beine","beinen"}),
	    "Huch, zum Glueck sind Deine Beine noch da!" );

  AddDetail( ({"haende"}),
	    "Du koenntest Deine Haende wirklich mal wieder waschen." );

  AddDetail( ({"leiter"}),
	    "Die Leiter fuehrt durch ein Loch in der Decke nach oben." );

  AddDetail( ({"wasser"}),
	    "Das Wasser wurde vermutlich fuer die Reittiere hergerichtet. Du koenntest aber auch "
	    "Deine Haende darin waschen." );

  AddDetail( ({"schatten","wesen"}), #'schatten);

  AddDetail( ({"waffen","speere","schwerter","aexte","zeugs"}),
	    "Speere, Schwerter, Aexte und so Zeugs." );

  AddDetail( ({"vorraete"}),
	    "Vermutlich wird in den Faessern auch etwas zu Essen aufbewahrt." );

  AddDetail( ({"glueck"}),
	    "Jeder braucht ein wenig Glueck im Leben." );

  AddDetail( ({"decke"}),
	    "Die Decke hier wird vom darueberliegenden Raum gebildet. In ihr erblickst Du ein "
	    "Loch, durch das eine Leiter fuert." );

  AddDetail( ({"loch"}),
	    "Eine Leiter fuehrt durch das Loch nach oben." );

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Lehm, ein Gitter ist darin eingelassen." );

  AddDetail( ({"lehm"}),
	    "Lehmiger Lehm eben." );

  AddDetail( ({"hoehle"}),
	     "Da musst Du schon runter." );

  AddDetail( ({"farbe"}),
            "Das Pulver in den Eimern ist von weisslicher Farbe." );

  AddDetail( ({"finger"}),
	    "Huch, sind noch alle da!" );

  AddDetail( ({"idee","ideen"}),
	    "Du kommst aber auch auf dumme Ideen." );

  AddDetail( ({"leben"}),
	    "Du bist froh, dass Du Dein Leben hast." );

  AddDetail( ({"unsinn"}),
	    "So ein Unsinn." );

  AddDetail( ({"hatschi"}),
	    "G'sundheit!" );

  AddDetail( ({"grund"}),
	    "Am Grund des Troges befindet sich ein dunkler Schatten." );

  AddDetail( ({"rand"}),
	    "Der Trog wurde bis zum Rand mit Wasser gefuellt." );

  AddDetail( ({"waende","wand"}),
	    "Welche Wand genau?" );

  AddDetail( ({"gitter"}),
             "Durch das Gitter kannst Du nach unten gehen.");
//-----Details Ende-----

  AddSmell( DEFAULT_SMELL, "Es riecht hier nach Tierfutter.");

  AddSmell( ({"tierfutter","futter"}), "*Hatschi* Das ist aber staubig!");

  AddExit("unten",([EX_DEST:  ROOM "hoehle", EX_TESTFUNC: "exfun_unten"]) );
  AddExit("osten", ROOM "ges_7");
  AddExit("oben", ROOM "turm_m");

  AddCmd( ({"wasch","wasche"}), "cmd_waschen");
  AddCmd( ({"loese","loes","streue","streu"}), "cmd_loesen");

  AddItem(NPC "krieger", REFRESH_DESTRUCT);
}

int exfun_unten()
{
  if(!present("\nechs_rune", TP))
  {
    write(BS("Gerade als Du nach unten gehen willst, leuchten, zuvor "
	  "unsichtbar, Runen am Abgang auf.")+"\n\n"+BS("Ein blendend "
          "heller Blitz schleudert Dich vom Abgang fort.")+"\n\n"+
	  BS("Scheinbar ist der Abgang gegen unbefugtes Betreten gesichert."));
    say(BS(TPN+" versucht hinunter zu gehen, wird jedoch von einem hellen Blitz"
	"zurueck geschleudert."));
    TP->AddHp(-10);
    TP->AddSp(-10);
    return 0;
  }
  return 1;
}

string schatten()
{
  if(kobold)
	  return BS("Du starrst den Schatten am Grund des Troges an und rote Augen starren zurueck. "
		    "Ob da unten ein Wesen lebt? Vielleicht kann man es aufscheuchen, wenn man irgendwas "
		    "ins Wasser streut.");
  return "Da ist doch nichts. Du musst Dich getaeuscht haben.\n";
}

int cmd_waschen(string str)
{
  notify_fail("Was moechtest Du wo waschen?\n");
  if(!str || str == "") return 0;
  if(!(str == "haende in wasser" ||
       str == "haende in trog"   )) return 0;

  
  if(kobold > 1)
  {
    write("Du tauchst Deine Haende in den Trog.\nAutsch! Da hat Dich etwas gebissen!\n");
    say(TPN+" taucht "+TP->QueryPossPronoun(WESSEN)+"e Haende in den Trog und zuckt zurueck.\n");
    TP->do_damage(5, TO);
  }
  else
  {
    write(BS("Du waeschst Deine Haende in dem Wasser."));
    say(BS(TPN+" waescht "+TP->QueryPossPronoun(WESSEN)+"e Haende im Trog."));
  }

  return 1;
}

int cmd_loesen(string str)
{
  object ko;
  notify_fail("Was moechtest Du worin loesen?\n");
  if(!str || str == "") return 0;
  if(!(str == "pulver aus eimer in wasser aus trog" ||
       str == "pulver aus eimer in trog" ||
       str == "pulver aus eimer in wasser" ||
       str == "pulver in wasser" ||
       str == "pulver in trog" )) return 0;


  if(kobold < 1)
  {
    write(BS("Du streust etwas von dem weisslichen Pulver aus dem Eimer in den Trog, wo "
	"es sich augenblicklich aufloest."));

    say(BS(TPN+" streut irgendwas in den Trog."));
    return 1;
  }

  write(BS("Du streust etwas von dem weisslichen Pulver aus dem Eimer in den Trog, wo "
	"es sich augenblicklich aufloest.\nPloetzlich springt ein gemeiner Trogbold aus "
	"dem Trog und greift Dich an!\n"));

  say(BS(TPN+" streut irgendwas in den Trog und ploetzlich springt ein gemeiner "
	 "Trogbold daraus hervor und greift "+QueryPronoun(2)+" an.\n"));

  ko=clone_object(NPC "trogbold");
  ko->move(ENV(TP), M_NOCHECK);
  ko->Kill(TP);
  kobold = 0;
  return 1;
}

void reset()
{
  ::reset();
  kobold=1;
}
