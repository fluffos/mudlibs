inherit "std/room";

#include <properties.h>
#include "../def.h"

int broken=0;

string table();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Im Turm der Stadtwache");
  SetProp( P_INT_LONG,
   "Du befindest Dich hier im mittleren Stockwerk des Stadtwachenturms. Dieser "
   "Raum duerfte ein Schlaf- und Aufenthaltsraum sein. An den Waenden stehen "
   "Betten und in der Mitte des Raumes steht ein Tisch. Der Boden ist mit einem "
   "roten Teppich ausgelegt und ein Loch ist darin. Ausserdem erkennst Du ein "
   "Loch in der Decke." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail( ({"werk","stockwerk","stockwerken"}),
	    "Der Turm der Stadtwache besteht aus drei Stockwerken.");

  AddDetail( ({"turm","stadtwachenturm","stadtwachenturms"}),
	    "In diesem, dreistoeckigen Turm, ist die Stadtwache untergebracht "
	    "worden.");

  AddDetail( ({"stadtwache","wache"}),
	    "Die Wache ist dafuer verantwortlich, dass hier niemand Unsinn "
	    "anstellt.");

  AddDetail( ({"unsinn"}),
	    "Sei ja brav und stell nichts an.");

  AddDetail( ({"leiter"}),
	    "Eine Leiter fuehrt durch ein Loch in der Decke nach oben, die "
	    "andere nach unten." );

  AddDetail( ({"decke"}),
	    "Die Decke hier wird vom darueberliegenden Zimmer gebildet. In "
	    "ihr erblickst Du ein Loch, durch das eine Leiter fuehrt.");

  AddDetail("zimmer",
	    "Du musst schon hinaufgehen, um das Zimmer sehen zu koennen.");

  AddDetail( ({"loch"}),
	    "Eine Leiter fuehrt durch das Loch nach oben und eine andere nach"
	    " unten.");

  AddDetail( ({"boden"}),
	    "Der Boden wurde mit einem rostroten Teppich ausgelegt." );

  AddDetail("teppich",
	    "Der Teppich ist Rostrot und eigentlich ganz schmucklos "
	    "gehalten. Die Bastfasern sticheln aus dem Teppich heraus.");

  AddDetail( ({"rostrot","rot"}),
	    "Es wirkt beruhigend und schafft eine angenehme, entspannte "
	    "Atmosphaere.");

  AddDetail("atmosphaere",
	    "Das wird die Wache hier schon brauchen, bei ihrem Beruf.");

  AddDetail( ({"bastfaser","faser","bastfasern","fasern"}),
	    "Du streichst vorsichtig ueber den Teppich und die Fasern sind "
	    "wirklich unangenehm kratzig.");

  AddDetail("beruf",
	    "Ein ehrbarer Beruf, aber oft nicht ungefaehrlich.");	  

  AddDetail( ({"raum","raumes","schlafraum","aufenthaltsraum"}),
	    "Ein einfacher, dunkler Raum. Eine entspannte Atmosphaere wird "
	    "von den dunklen Waenden, den Betten und dem rostroten Teppich "
	    "geschaffen. Ein schmales Fenster erhellt den Raum ein wenig.");

  AddDetail( ({"fenster","luke"}),
	    "Das ist eher eine kleine Luke als ein Fenster. Das wenige Licht "
	    "erhellt den Raum nur notduerftig.");

  AddDetail("licht",
	    "Mehr wird hier nicht gebraucht, dennoch kann man alles sehr gut "
	    "erkennen.");
	  
  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende bestehen aus dunklem Holz und lassen somit den Raum "
	    "dunkler und kuehler erscheinen. Das einzige Licht strahlt durch "
	    "ein kleines Fenster herein.");

  AddDetail("holz",
	    "Dunkel gebeiztes Holz. Es wirkt stabil.");

  AddDetail("betten",
	    "Es sind eigentlich nur Holzgestelle mit Querlatten, auf denen "
	    "Matratzen gebettet wurden. Sehr schlicht und einfach.");

  AddDetail( ({"holzgestelle","gestelle","holzgestell","gestell"}),
	    "Ein Rahmen, der auf vier Beinen steht.");

  AddDetail( ({"rahmen","beine"}),
	    "Alles besteht aus dunklem Holz.");

  AddDetail( ({"querlatten","latten",}),
	    "Die Querlatten stuetzen die Matratzen und sind quer ueber den "
	    "Rahmen eingespannt.");

  AddDetail( ({"matratzen","matratze"}),
	    "Die Matratzen sind einfache Leinentuecher, die mit einem "
	    "Woll-Sand-Gemisch gefuellt sind. Darueber wurden Leinentuecher "
	    "zusaetzlich noch als Bettdecken gespannt.");

  AddDetail( ({"woll-sand-gemisch","gemisch"}),
	    "Anscheinend gibt es hier nicht so viel Auswahl wie in Midas. "
	    "Man muss sich hier mit sehr wenig begnuegen.");

  AddDetail( ({"midas","auswahl"}),
	    "Du schwitzt... Du denkst an all den Luxus in Midas.");

  AddDetail("luxus",
	    "Hier gibt es alles, aber keinen Luxus."); 

  AddDetail( ({"bettdecke","bettdecken"}),
	    "Da es hier so heiss ist, braucht man nicht mehr als ein duennes "
	    "Leinentuch.");
  AddDetail("mitte",
            "Du gehst den Raum von Ecke zu Ecke diagonal ab. Der Tisch wurde "
	    "wirklich exakt in der Mitte platziert.");

  AddDetail( ({"eck","ecke","ecken"}),
	    "In den Ecken sind nur Steher, auf denen sich Waschschuesseln "
	    "befinden. An der Seite haengen frische Tuecher.");

  AddDetail("steher",
	    "Sie sind aus dunklem Holz und ganz schlicht.");

  AddDetail( ({"schuesseln","waschschuesseln"}),
	    "Aus erdbraunem Ton gefertigt beinhalten sie nur klares Wasser.");

  AddDetail("ton",
	    "Eine rotbraune gebrannte Tonmasse, die wohl hier ueblicherweise "
	    "verwendet wird.");

  AddDetail( ({"tonmasse","masse"}),
	    "War wohl beim Toepfern mal matschig, wurde anschliessend "
	    "gebrannt und ist jetzt ausgehaertet.");

  AddDetail("wasser",
	    "Du guckst in jede Schuessel und ueberall ist das Wasser klar. "
	    "Doch bei einer Waschschuessel ist das Wasser verunreinigt.");

  AddDetail( ({"waschschuessel","schuessel"}),
	    "Hier duerfte sich jemand die Haende gewaschen haben. Es hat "
	    "sich etwas Sand am Schuesselboden angesammelt.");

  AddDetail( ({"hand","haende","haenden"}),
	    "Du blickst auf Deine Haende, die ganz verdreckt sind. Genierst "
	    "Du Dich gar nicht?");

  AddDetail("schuesselboden",
	    "Da liegt der Sand und liegt vor sich hin.");

  AddDetail("sand",
	    "Er schimmert leicht golden und duerfte von draussen sein.");	 
	
  AddDetail("seite",
	    "An der Seite befindet sich eine Halterung.");

  AddDetail("halterung",
	    "Darueber haengt ein Leinentuch.");

  AddDetail( ({"tuch","tuecher","leinentuch","leinentuecher"}),
	    "Jedes Tuch ist beige und scheint aus einem weichen, kuehlen "
	    "Material zu bestehen.");

  AddDetail("material",
	    "Im Gegensatz zum Teppich ganz flauschig.");

  AddDetail("gegensatz",
	    "Tuch und Teppich sind gegensaetzlich.");

  AddDetail("hitze",
	    "Es ist ziemlich heiss herinnen. Ein kleiner Luftzug bringt ein "
	    "wenig Erfrischung.");

  AddDetail( ({"luftzug","zug","erfrischung"}),
	    "Einfach angenehm, aber der Luftzug koennte etwas staerker "
	    "sein.");

  AddDetail("wirkung",
	    "Der aromatische Geruch beruhigt auch Dich.");

  AddDetail("geruch",
	    "Wie willst Du denn den Geruch untersuchen?");

  AddDetail("stunden",
 	    "Die Zeit verrinnt...");

  AddDetail("zeit",
	    "... wie der Sand in Deinen Haenden.");

  AddDetail("luft",
	    "Du kannst sie riechen und sogar hoeren.");
	    
  AddDetail( ({"tisch"}), #'table);

  AddDetail( ({"wuerfel"}), "Die Wuerfel bestehen aus gebranntem Ton.\n"
    "Was koenntest Du bloss mit ihnen anstellen?");

  AddDetail( ({"unterseite", "tischunterseite"}),
    "Vielleicht solltest Du sie abtasten?");

  AddSmell(DEFAULT_SMELL, "Durch die Hitze ist die Luft sehr trocken.");

  AddSmell("hitze",
	   "Da kann man nicht wirklich riechen. Aber versuche es mit "
	   "untersuche.");

  AddSmell("luft",
	   "Ein kleiner Luftzug von Fenster zu Loecher laesst hier alles "
	   "frischer wirken. Dennoch riecht man den Geruch der Bastfasern.");

  AddSmell( ({"geruch","fasern","bastfasern"}),
	   "Die getrockneten Fasern im Teppich haben eine beruhigende "
	   "Wirkung.");

  AddSmell("wirkung",
	   "Gerochen hat sie noch keiner, aber untersucht schon so mancher.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Luft, die durch die Stockwerke "
	   "zieht.");

  AddSound("luft",
	   "Wie ein leises, kaum hoerbares Fluestern.");

  AddSound("fluestern",
	   "Sie fluestert: Fuehl Dich freiiiii!");

  AddSound( ({"stockwerke","werke"}),
	    "Stunden spaeter und Du lauscht immer noch am Stockwerk. Du "
	    "hoerst nichts.");

  AddSound("stunden",
	   "Ist Dir das nicht zu bloed?");

//-----Details Ende-----


  AddExit("unten", ROOM "turm_e");
  AddExit("oben", ROOM "turm_o");

  AddCmd( ({"lege","leg"}), "cmd_bett");
  AddCmd( ({"spiel","spiele","wuerfel","wuerfle"}), "cmd_wuerfel");
  AddCmd( ({"taste","ertaste","tast","ertast"}), "cmd_tasten");
  AddCmd( ({"breche","brich"}), "cmd_brechen");
  AddCmd( ({"wasch","wasche"}), "cmd_waschen");
}

string table()
{
  if(broken)
   return BS("Du erblickst leider nur die Truemmer eines Tisches. Irgendwer hat hier "
	     "wohl seine Wut ausgelassen.");
  return BS("Auf dem Tisch in der Mitte des Raumes liegen ein paar Wuerfel.");
}

int cmd_bett(string str)
{
  notify_fail("Wohin moechtest Du Dich legen?\n");
  if(!str || str == "") return 0;
  if(!(str == "in bett" ||
       str == "ins bett"   )) return 0;

  write(BS("Du legst Dich ins Bett und entspannst Dich.\nHach, tut das guuuut!"));
  say(TPN+" legt sich in ein Bett.\n");

  return 1;
}

int cmd_wuerfel(string str)
{
  notify_fail("Womit moechtest Du spielen?\n");
  if(!str || str == "") return 0;
  if(!(str == "mit wuerfel" ||
       str == "wuerfel"    )) return 0;

  write(BS("Du nimmst einen der Wuerfel und laesst ihn schwungvoll ueber den Tisch "
	   "rollen.\nSchwups schon liegt er am Boden.\nAls Du ihn aufhebst faellt Dir "
	   "auf der Unterseite des Tisches etwas auf.\n"));
  say(BS(TPN+" laesst einen Wuerfel ueber den Tisch rollen, der Wuerfel faellt runter "
	 "und "+TP->QueryPronoun(WER)+" hebt ihn wieder auf.\n"));

  return 1;
}

int cmd_tasten(string str)
{
  notify_fail("Wo moechtest Du tasten?\n");
  if(!str || str == "") return 0;
  if(!(str == "auf unterseite" ||
       str == "unterseite"     ||
       str == "unterseite ab"  ||
       str == "tischunterseite")) return 0;

  write(BS("Du tastest auf der Unterseite des Tisches herum und bemerkst eine Lade.\n Da "
	   "die Lade fest verschlossen ist, wirst Du sie wohl mit Gewalt aufbrechen muessen.\n"));
  say(BS(TPN+" befummelt den Tisch.\n"));

  return 1;
}

int cmd_brechen(string str)
{
  object rune;
  notify_fail("Was moechtest Du aufbrechen?\n");
  if(!str || str == "" ) return 0;
  if(!(str == "lade auf" ||
       str == "tisch auf" ||
       str == "geheimlade auf" )) return 0;

  if(broken)
  {
    write("Der ist schon hinueber...\n");
    return 1;
  }
  
  write(BS("Du ruettelst am Tisch herum und ploetzlich zerbricht er. "
	   "Tja, der is hinueber. Immerhin ist die Lade jetzt offen und "
	   "etwas ist daraus hervorgepurzelt."));
  say(BS(TPN+" zertruemmert den Tisch!\n"));
  rune=clone_object(OBJ "rune");
  rune->move(ENV(TP), M_NOCHECK || M_SILENT);
  broken=1;

  return 1;
}

void reset()
{
  ::reset();
  broken=0;

}
int cmd_waschen(string str)
{
  notify_fail("Was moechtest Du waschen?\n");
  if(!str || str == "") return 0;
  if(!(str == "haende" ||
       str == "haende in schuessel" ||
       str == "haende in waschschuessel" ||
       str == "haende in wasser" ||
       str == "hand"    )) return 0;

  write(BS("Du saeuberst Deine Haende in Ruhe und trocknest sie\n"
	   "anschliessend in dem Tuch ab.\n"));
  say(BS(TPN+" waescht seine Haende und trocknet sie anschliessend ab.\n"));

  return 1;

}
