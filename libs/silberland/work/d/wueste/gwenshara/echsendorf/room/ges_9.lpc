// 7.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Du wanderst die Palisade entlang. Hier macht der Weg eine "
  +"Biegung nach Nordwesten. Direkt noerdlich von hier liegt "
  +"der grosse Tempel. Im Osten macht der Weg wieder eine Biegung "
  +"nach Nordosten, wo er schliesslich zum Tor fuehrt. Hier ist "
  +"an der Palisade nichts Auffaelliges zu entdecken. Der Boden "
  +"ist mit einer Schicht Sand bedeckt und Du kannst Spuren in "
  +"ihm erkennen.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//-----Details Anfang-----
  AddDetail( "auffaelliges", 
            "An der Palisade kannst Du nichts Auffaelliges erkennen, "
           +"im Norden allerdings entdeckst Du seltsame Spuren.\n" );

  AddDetail( "biegung", 
            "Hier macht der Weg eine Biegung nach Nordwesten und "
           +"im Osten eine nach Nordosten.\n" );

  AddDetail( "boden", "Der Boden ist mit einer Schicht Sand bedeckt.\n" );

  AddDetail( ({"sandschicht","schicht","sand"}), 
            "In der Sandschicht kannst Du seltsame Spuren erkennen.\n" );

  AddDetail( "spuren", 
            "Im Sand zeichnet sich deutlich eine Raubkatzenspur ab.\n" );

  AddDetail( "raubkatzenspur", 
            "Die Spuren kommen aus dem Nordwesten und fuehren nach Osten. "
           +"Vielleicht ist Raubkatze ja noch im Dorf.\n" );

  AddDetail( ({"katze","raubkatze"}), 
            "Du bist Dir ziemlich sicher, dass eine hier war, aber ob diese "
           +"noch im Dorf ist kannst Du nicht mit Sicherheit sagen.\n" );

  AddDetail( "dorf", 
            "Du gehst gerade um dieses Dorf hier herum, es wird von "
           +"Echsenmenschen bewohnt.\n" );

  AddDetail( ({"echsen","menschen","echsenwesen","echsenmenschen"}), 
            "Sie wohnen hier in diesem Dorf und "
           +"scheinen Dir sehr friedlich zu sein.\n" );

  AddDetail( "himmel", 
            "Der Himmel ist hier strahlend blau, von ihm herunter scheint "
           +"Dir die Sonne entgegen.\n" );

  AddDetail( "sonne", 
            "Die Sonne scheint vom klaren Himmel herunter und bringt Dich "
           +"ganz schoen ins Schwitzen.\n" );

  AddDetail( ({"palisade","zaun","palisadenzaun"}), 
            "Die Palisade besteht aus aneinander gereihten Baumstaemmen und "
           +"fuehrt um das Dorf herum.\n" );

  AddDetail( ({"baumstaemme","palmenstaemme","baumstaemmen","staemme","palmenstaemmen"}), 
             "Die Palisade besteht aus aneinder gereihten Palmenstaemmen.\n" );

  AddDetail( "tempel", "Der Tempel befindet sich genau noerdlich von Dir.\n" );

  AddDetail( "tor", 
            "Wenn Du dem Weg weiter um das Dorf herum folgst wirst Du am "
           +"Ende auf das grosse Tor treffen durch welches Du in dieses Dorf "
           +"gelangt bist.\n" );

  AddDetail( ({"ende","enden"}), 
            "Alles hat ein Ende, nur die Knarkhwurst hat zwei.\n" );

  AddDetail( "weg", 
            "Dieser Weg hier auf dem Du Dich befindest fuehrt Dich um das "
           +"Dorf der Echsenmenschen herum. Er fuehrt genau die Palisade "
           +"entlang.\n" );

  AddDetail( "sicherheit", 
            "Hier hast Du zwar die Spuren einer Raubkatze, aber ob sie "
           +"noch hier ist kannst Du nicht sicher sagen.\n" );

  AddDetail( ({"wurst","knarkhwurst"}), 
            "Die hat zwei Enden, aber hier wirst Du keine finden.\n" );
//-----Details Ende-----

  AddExit("nordwesten", ROOM "ges_8");
  AddExit("osten", ROOM "ges_10");
}
