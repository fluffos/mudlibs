// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Oestlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Hier hat jemand eine Zeichnung "
   "in den Sand gezeichnet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( "zeichnung",
             "Hier hat jemand einen wunderschoenen Drachen in den Sand "
             "gemalt. So toll koenntest Du das sicher nicht machen." );

  AddDetail( "jemand", "Das war sicher ein unsichtbarer Magier.");

  AddDetail( "magier", "Gwenshara zum Beispiel ist einer.");

  AddDetail( "gwenshara", "Gwenshara hat das hier gemacht.");

  AddDetail( ({"drache","tiere","drachen"}),
             "Drachen sind echsenartige Tiere mit fledermausaehnlichen "
             "Fluegeln.");

  AddDetail( ({"fluegel","fluegeln"}),
             "Voegel fliegen mit ihnen." );

  AddDetail( ({"voegel"}), "Fliegende Tiere.");

//-----Details Ende-----

  AddExit("norden", ROOM "rand_12");
  AddExit("suedosten", ROOM "rand_7");
  AddExit("nordwesten", DESERT "61:8");
  AddExit("westen", DESERT "61:9");
  AddExit("suedwesten", DESERT "61:10");
  AddExit("sueden", DESERT "62:10");
}

string sand(){
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
