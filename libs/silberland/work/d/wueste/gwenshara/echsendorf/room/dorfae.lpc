// von Gwenshara
// 5.7.2003
// 
// Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

int hautda=1;

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Die Huette des Dorfaeltesten");
  SetProp( P_INT_LONG,
     "Du befindest Dich in einer kleinen Huette suedlich des Dorfplatzes. "
    +"Im hinteren Teil des Hauses befindet sich eine kleine Feuerstelle, "
    +"erleuchtet wird die Huette von einem seltsamen blaeulichen glimmenden "
    +"Stein, der in der Mitte des Raumes in einer Halterung steckt. In "
    +"einer Nische stehen unzaehlige Kristalle. Der Eingang ist mir einem "
    +"blauen Tuch verhaengt worden. Auch hier haengen verschiedenste Kraeuter "
    +"von der Decke.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail( ({"boden","fussboden"}), 
            "Der Fussboden besteht aus festem Lehm.\n" );

  AddDetail( ({"lehm","lehmerde"}), 
            "Lehm ist eine ganz besondere Erdenart.\n" );

  AddDetail( ({"erde","erdenart","art"}), 
            "Lehm ist zB eine bestimmte Erdenart.\n");

  AddDetail( "decke", 
	    "Sie besteht, so wie die Waende auch, aus Lehm. "
           +"Von ihr haengen die verschiedensten Kraeuter und andere "
           +"seltsame Dinge.\n" );

  AddDetail( ({"kraut","kraeuter"}), 
	    "Die verschiedensten Kraeuter haengen von "
           +"der Decke, leider kennst Du keines davon, "
           +"die anderen Dinge, die da oben haengen sind "
           +"sowieso viel interessanter.\n" );

  AddDetail( ({"dinge","ding"}), 
 	    "Jetz wo Du genauer hin siehst erkennst Du das "
           +"neben den Kraeutern auch verschiedenste Tierhaeute "
           +"und Knochen haengen.\n" );

  AddDetail( ({"knochen","haeute","tierhaeute"}),
            "Die Knochen verschiedenster Tiere und auch deren Haeute haengen "
           +"von der Decke, besonderst eine Tierhaut sticht heraus.\n" );

  AddDetail( ({"tierhaut","haut"}), 
	    "Du betrachtest die Haut eingehend und stellst "
           +"fest das es sich um die einer Seeschlange "
           +"handeln muss.\n" );

  AddDetail( ({"schlange","seeschlange"}), 
            "Die Haut einer solchen haengt von "
           +"der Decke, sie ist vermutlich der "
           +"ganze Stolz des Besitzers und Du "
           +"kaemst doch nie auf die Idee sie zu stehlen.\n" );

  AddDetail( ({"platz","dorfplatz"}), 
	    "Der ist noerdlich von hier.\n" );

  AddDetail( "eingang", 
            "Er ist gerade so gross das Du durch kommst und mit einem "
           +"Tuch verhaengt.\n" );

  AddDetail( "tuch", "Ein blaues Tuch haengt vor dem Eingang.\n" );

  AddDetail( ({"stelle","feuerstelle","feuer"}), 
	    "Im hinteren Teil des Hauses befindet "
           +"sich eine kleine Feuerstelle, ein paar "
           +"Scheite brennen darin.\n" );

  AddDetail( ({"scheite","holzscheite"}), 
            "Sie brennen in der Feuerstelle, Du koenntest ja einen "
           +"nehmen. Ob das klug waere?\n" );

  AddDetail( "mitte", 
            "In der Mitte dieses Raumes liegt ein blaeulich glimmender Stein in "
           +"einer Halterung.\n" );

  AddDetail( "halterung", 
	    "Die Halterung in der Mitte des Raumes besteht aus schwarzem Metall. "
           +"In ihr liegt ein blaeulich glimmender, etwa faustgrosser Stein. Verschiedene "
           +"Muster bilden sich aus hauchduennen Linien, die ins Metall geritzt "
           +"wurden.\n" );

  AddDetail( ({"linie","linien"}), 
            "Hauchduenne Linien sind in das schwarze Metall "
           +"der Halterung eingeritzt worden. Sie bilden ein "
           +"verworrenes Muster.\n" );

  AddDetail( "muster", 
	    "Das Muster, das die Linien auf der Halterung bilden "
           +"ist komplett verworren.\n" );

  AddDetail( "stein", "Der Stein leuchtet leicht blaeulich.\n" );

  AddDetail( ({"haus","hauses","huette","raum","raumes"}), "Du stehst drinnen.\n" );

  AddDetail( ({"kristall","kristalle"}), 
            "Rote, gruene, gelbe, durchsichtige. Du wuerdest sie nur zu gerne "
           +"einmal beruehren.\n" );

  AddDetail( "nische", 
            "In der westlichen Wand befindet sich eine Nische, in der "
           +"verschiedenste Kristalle aufgereiht sind.\n" );

  AddDetail( "teil", 
            "Im hinteren Teil des Raumes befindet sich eine kleine "
           +"Feuerstelle.\n" );

  AddDetail( ({"wand","waende"}), 
            "Sie bestehen aus Lehm und in der westlichen befindet "
           +"sich eine Nische.\n" );

  AddDetail( "besitzer", "Der dem die Haut der Seeschlange gehoert.\n" );

  AddDetail( "stolz", 
            "Auf die Haut der Seeschlange ist der Besitzer sicher stolz.\n" );

  AddDetail( "metall", "Die Halterung ist aus schwarzem Metall.\n" );
//-----Details Ende-----


  AddCmd( ({"beruehre","beruehr"}), "cmd_kristall");
  AddCmd( ({"nimm","nehme"}), "cmd_nehmen");
  AddCmd( ({"stehle","stiehl","stehl"}), "cmd_stehlen");

  AddItem( NPC "chsir", REFRESH_DESTRUCT);

   AddExit("norden", ROOM "ges_4");

}

int cmd_kristall(string str)
{
  notify_fail("Was moechtest Du beruehren?\n");

  if(!str || str == "") return 0;
  if(!(str == "kristalle" ||
       str == "kristall" )) return 0;
  write(BS("Du beruehrst einen sehr interessant aussehenden Kristall "
           "und spuerst ploetzlich wie Dich eine starke Macht hinaus "
           "zieht.\n"));
  TP->AddHp(-10);
  TP->move(ROOM "ges_4", M_GO, "hinaus geschleudert", "wird", "fliegt herein");
  return 1;
}
 

int cmd_nehmen(string str)
{
   notify_fail("WAS nehmen?\n");

   if(!str || str == "") return 0;
   if(!(str == "scheit" ||
        str == "scheit aus feuer" ||
        str == "scheit von feuer" ||
        str == "scheit aus feuerstelle" ||
        str == "scheit von feuerstelle" )) return 0;

   write("Du nimmst einen Scheit vom Feuer. Als Du Dich daran verbrennst wirfst Du den "
         "Scheit wieder in die Flammen.\n");
   say(TP->name()+" nimmt einen Scheit vom Feuer und verbrennt sich daran.\nDer "
       "landet wieder genau auf der Feuer stelle als "+TPN+" ihn weg wirft.\n");
        TP->AddHp(-10);

        return 1;
}

int cmd_stehlen(string str)
{
  int welche;
  object ob;

   notify_fail("Was willst Du stehlen?\n");

   if(!str || str == "") return 0;
   if(!(str == "haut" ||
        str == "seeschlangenhaut" ||
        str == "schlangenhaut" )) return 0;
   if(TP->QueryAttribute(A_DEX) >= 10+random(5)){
   if(hautda==1){ 
     tell_object(TP,"Du greifst schnell nach der Schlangenhaut und steckst sie ein.\n" );
  
     welche=random(6);
     if(welche <=3){
       ob=clone_object(OBJ "haut")->move(TP);
       hautda=0;
     }
     else{
       ob=clone_object("/d/ebene/creative/feldlager/obj/haut")->move(TP);
       hautda=0;
       return 1;
     }
   }

     else{
       tell_object(TP, "Es scheint so als haette Jemand die Haut gestohlen!\n");
       return -1;
     }
   }
   else 
   	write("Hm... das war wohl nix.\n");
       return 1;
}

void reset()
{
  ::reset();
  
  hautda=1; //Im reset soll die haut wieder da sein
}
