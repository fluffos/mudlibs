// von Gwenshara
// begonnen: 1.7.2003

#pragma strong_types

inherit "std/room";
inherit "std/room/doors.lpc";

#include <properties.h>
#include <language.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Bei einem Tor");
  SetProp( P_INT_LONG, BS(
           "Du stehst jetzt vor dem grossen Tor, das Du vorhin schon zu "
          +"sehen geglaubt hast. Das Tor wird links und rechts von einem "
          +"Palisadenzaun abgeloest. Dir unbekannte Verzierungen und "
          +"Symbole verzieren das Tor. Vor dem Tor erkennst "
          +"Du die Spuren von fremdartigen Wesen, die offenbar oefters "
          +"durch dieses Tor ein und aus gehen. Hier hat sich auch das "
          +"Duenental geoeffnet und zu einem breiten Kessel gebildet. "
          +"Vermutlich befindet sich hinter dem Tor ein Dorf."));
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "tor", 
           "Das Tor ist genau so gross wie die Palisade. Es ist mit seltsamen "
           +"Symbolen verziert.\n" );

  AddDetail( ({"symbole","verzierungen"}), 
            "Die Symbole zeigen Echsenwesen bei alltaeglichen Dingen, wie "
           +"jagen usw.\n");

  AddDetail( ({"dinge","dingen"}), 
            "Die Verzierungen zeigen Echsenwesen bei verschiedenen Dingen, "
           +"wie zB: jagen.\n");

  AddDetail( ({"palisade","zaun","palisadenzaun"}), 
            "Die Palisade besteht aus Baumstaemmen, die nebeneinander in den "
           +"Boden gerammt wurden und so einen stabilen Zaun bilden ueber den "
           +"man nicht so leicht klettern kann.\n");

  AddDetail( ({"spuren","fussspuren","fusspuren"}), 
            "Sie stammen von fremdartigen Echsenwesen und zeigen, dass diese hier "
           +"wohl oefters ein und aus gehen.\n");
  AddDetail( ({"echsenwesen","wesen","echsen"}), 
            "Das sind die Wesen, die vermutlich in dem Dorf hinter der Palisade "
           +"leben.\n");

  AddDetail( "dorf", 
            "Es liegt vermutlich hinter dem Palisadenzaun und wird von den "
           +"Wesen bewohnt, denen die Spuren hier gehoeren.\n");

  AddDetail( ({"tal","duenental","duenen"}), 
            "Das Duenental, durch das Du hier her gelangt bist hat sich zu "
           +"einem weiten Kessel geoeffnet.\n");

  AddDetail( ({"kessel","duenental"}), 
            "Die Duenen hier bilden einen Kessel und mitten darin liegt "
           +"das Dorf.\n");

  AddDetail( ({"erde","boden"}), 
            "Hier liegt teilweise Sand, aber auch fester Lehm ist zu "
           +"erkennen.\n");

  AddDetail( "lehm", "Eine spezielle Erde.\n" );

  AddDetail( ({"baumstaemme","baumstaemmen"}), 
             "Aus Baumstaemmen besteht die Palisade.\n" );

  AddDetail( "himmel", 
            "Er ist strahlend blau und kein einziges Woelkchen truebt "
           +"ihn.\n");

  AddDetail( ({"woelckchen","wolke"}), 
	     "Am Himmel findest Du keine einzige Wolke.\n" );

  AddDetail( "sand", "Staubiger, trockener Sand.\n" );

  AddDetail( "spuren", "Sie stammen von Echsenwesen.\n" );

  AddDetail( "gebiet", "Das hier ist die Wueste.\n" );
//-----Details Ende-----  

  AddItem( NPC "echwachm", REFRESH_DESTRUCT);
  AddItem( NPC "echwachm", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "ttges_1");

  NewDoor( "westen", ROOM "ges_3", "tor",
          ({ D_NAME,"Tor",
             D_GENDER,NEUTER,
             D_SHORT,"Ein grosses %ses Tor.",
             D_LONG, "Das Tor ist genau so gross wie die Palisade."
                     " Es ist mit seltsamen Symbolen verziert.\n"
          }) );

}
