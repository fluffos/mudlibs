// von Gwenshara
// begonnen: 1.7.2003
// 
// Der erste Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Vor einem Tor");
  SetProp( P_INT_LONG, BS(
   "Um Dich herum siehst Du Sand, viel Sand. Du stehst hier in einem Tal, "
  +"das aus zwei Duenen gebildet wird. Es ist unangenehm heiss, auch der "
  +"Wind bringt nicht viel Abkuehlung mit sich. Weiter im Westen siehst Du "
  +"ein grosses Tor. Im Osten geht es wieder auf die offene Wueste zu. Du "
  +"denkst Dir das es besser sein wird, wenn Du weiter gehst. Vielleicht. "
  +"findest Du ja hinter dem Tor eine Oase mit genug Wasser um Dich zu erfrischen.\n") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );

//---------Details---------
  AddDetail ("sand",
          "Den gibt es hier reichlich. Darum nennt man dieses Gebiet auch "
         +"Wueste." );

  AddDetail ("tal",
          "Es wird aus zwei hohen Sandduenen gebildet, so dass Du nur nach "
         +"Osten oder Westen gehen kannst.\n" );

  AddDetail ( ({ "boden", "fussboden"}),
          "Voller Sand. Du glaubst Spuren zu erkennen, das koennen aber "
         +"auch Deine eigenen sein.\n" );

  AddDetail ( ({ "duenen", "duene", "sandduene", "sandduenen"}),
          "Sie bilden hier ein kleines Tal. Wenn Du nach Osten blickst, kannst "
         +"Du noch weiter in die offenen Wueste blicken.\n" );

  AddDetail( ({ "wind", "abkuehlung", "kuehlung"}),
          "Hier geht zwar etwas Wind, doch bringt er keinerlei Abkuehlung. Im "
         +"Gegenteil, es wird sogar noch heisser.\n" );

  AddDetail( ({ "westen", "tor"}),
          "Im Westen glaubst Du ein grosses Tor zu erkennen. Sicher bist Du Dir "
         +"allerdings nicht. Vielleicht solltest Du naeher hin gehen.\n" );

  AddDetail( ({"osten", "wueste"}),
          "Richtung Osten geht es in die offene Wueste. Dort ist es sicher noch "
         +"heisser als hier in dem einigermassen schattigen Tal. Sei froh, dass "
         +"Du nicht dort bist.\n" );

  AddDetail( "oase",
         "Hoffentlich findest Du hinter dem Tor eine, denn Du bist schon fast "
        +"am verdursten. Dort findest Du sicher auch Wasser, sonst waere es ja "
        +"keine Oase. \n" );

  AddDetail( "wasser",
         "Frisches, klares, feuchtes Wasser. Hoffentlich ist das Wasser in der " 
        +"Oase nicht braun und eklig schlammig.\n" );

  AddDetail( ({"spuren","fussspuren"}), 
             "Sie stammen vermutlich von Dir selbst.\n" );

  AddDetail( "himmel", 
            "Keine einzige Wolke die Abkuehlung versprechen wuerde ist am " 
           +"Himmel zu sehen. Er ist strahlend blau und die Sonne brennt auf "
           +"Dich herab.\n" );

  AddDetail( "gebiet", "Die Wueste.\n" );

  AddDetail( "sonne", 
            "Sie brennt vom Himmel auf Dich herab und bringt Dich ganz "
                     +"schoen ins Schwitzen.\n" );

  AddDetail( "gegenteil", 
             "Der Wind der hier weht bringt keine Abkuehlung, nur "
            +"noch mehr Hitze.\n" );

  AddDetail( "hitze",
            "Die Hitze hier macht Dich richtig fertig, Du wuenschtest "
           +"das Du etwas zu trinken haettest.\n" );

  AddDetail("wolke", 
            "Am Himmel siehst Du leider keine. Doch ganz am Horizont "
           +"erkennst Du eine Wolkenbank.\n" );

  AddDetail( ({"horizont","wolkenbank"}), 
            "Am Horizont erkennst Du eine gewaltige "
          +"Wolkenformation.\n" );

  AddDetail( ({"wolkenmasse","wolkenformation"}), 
               "Eine gewaltige Wolkenmasse befindet dort am Horizont.\n" );
//-----Details Ende----- 

  AddSmell(DEFAULT_SMELL, "Es riecht nach Sand.");
  AddSmell("sand", "Pfui, der ist aber staubig.");

  AddExit("westen", ROOM "tges_2");
  AddExit("norden", ROOM "rand_1");
  AddExit("nordosten", "/d/wueste/zordan/desert/room/desert:67:7");
  AddExit("osten", "/d/wueste/zordan/desert/room/desert:67:8");
  AddExit("suedosten", "/d/wueste/zordan/desert/room/desert:67:9");
  AddExit("sueden", ROOM "rand_10");
  
  AddItem("/d/wueste/protheg/karavanen/obj/fsauto", REFRESH_DESTRUCT);
}
