// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Noerdlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Hier ist zur Abwechslung "
   "ein mal nichts Besonderes." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( ({"nichts","besonderes"}),
             "Genau das ist hier nicht. Du brauchst gar nicht erst suchen.");

  AddDetail( "abwechslung", "Hier ist zur Abwechslung nichts Besonderes.");

//-----Details Ende-----

  AddExit("westen", ROOM "rand_8");
  AddExit("nordosten", ROOM "rand_10");
  AddExit("suedwesten", DESERT "64:11");
  AddExit("sueden", DESERT "65:11");
  AddExit("suedosten", DESERT "66:11");
  AddExit("osten", DESERT "66:10");
}

string sand(){ 
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
