inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Im Turm der Stadtwache");
  SetProp( P_INT_LONG,
   "Nun bist Du ganz oben im Turm angelangt. Du befindest Dich hier in "
   "einem komfortabel eingerichteten Raum. An der Nordwand steht ein Bett, "
   "das mit sauberen Laken ueberzogen wurde. An der Suedwand findest Du einen "
   "Waffenschrank und an der Westwand schliesslich einen Durchgang hinaus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail( ({"turm","stadtwachenturm"}),
	    "In diesem, dreistoeckigen Turm, ist die Stadtwache untergebracht "
	    "worden." );

  AddDetail( ({"stadtwache","wache"}),
	    "Die Wache ist dafuer verantwortlich, das hier niemand Unsinn anstellt." );

  AddDetail( ({"unsinn"}),
            "Lass das lieber sein!" );

  AddDetail( ({"leiter"}),
	    "Eine Leiter fuehrt durch ein Loch nach unten." );

  AddDetail( ({"decke"}),
	    "Die Decke kannst Du nicht erkennen, da sie mit gruenem Stoff verhaengt wurde." );

  AddDetail( ({"loch"}),
	    "Eine Leiter fuehrt durch das Loch nach unten." );
  
  AddDetail( ({"nordwand"}),
            "An der Nordwand kannst Du ein einziges Bett finden. Es wurde mit weisser Waesche "
	    "ueberzogen. Anscheinend lebt hier ein Verwalter oder etwas Aehnliches.");

  AddDetail( ({"raum"}),
            "Du befindest Dich hier in einem sehr komfortabel eingerichteten Raum ganz oben im "
	    "Turm." );

  AddDetail( ({"laken","waesche","bettwaesche","bettlaken"}),
           "Die Laken bestehen aus einem leinenaehnlichen Stoff und sind "
	   "genau auf das Bett angepasst. Du vermutest, dass man sie "
	   "eventuell sogar als Fallschirm benutzen koennte, sollte dies einmal "
	   "notwendig sein." );

  AddDetail( ({"suedwand"}),
            "An der Suedwand steht ein Waffenschrank. Daneben entdeckst Du "
	    "ein Buecherregal, das Du wohl vorher uebersehen haben musst." );

  AddDetail( ({"waffenschrank","schrank","waffenschranks"}),
            "Der Waffenschrank besteht aus einem Holzrahmen. Seine Vorderfront "
	    "wurde mit einer duennen Kristallscheibe verglast. In seinem Inneren "
	    "findest Du verschiedene Waffen." );

  AddDetail( ({"westwand"}),
            "An der Westwand befindet sich ein, mit einem Vorhang verhaengter, Durch"
	    "gang." );

  AddDetail( ({"wand","waende"}),
            "Welche Wand meinst Du?" );

  AddDetail( ({"bett"}),
            "Das Bett wurde mit weisser Bettwaesche ueberzogen. Es wirkt sehr sauber und "
	    "ordentlich." );

  AddDetail( ({"verwalter","aehnliches"}),
            "Hier heroben scheint der Verwalter der Stadtwache zu leben. Das erkennst "
	    "Du daran, dass es hier sehr ordentlich und beinahe schon nobel eingerichtet ist." );

  AddDetail( ({"stoff"}),
            "Der Stoff, aus dem die Bettlaken sind, ist leinenaehnlich. Er ist reinweiss und "
	    "scheint immer aufs Gruendlichste gesaeubert zu sein." );

  AddDetail( ({"fallschirm","schirm"}),
            "Die Laken auf dem Bett eignen sich hervorragend fuer einen Fallschirm. Du glaubst "
	    "zwar kaum hier einen zu brauchen, aber man weiss ja nie." );

  AddDetail( ({"regal","buecherregal"}),
            "Im Buecherregal befinden sich viele in Leder gebundene Buecher. Wenn Du Zeit hast "
	    "kannst Du ja im Regal herumstoebern, vielleicht findest Du etwas Interessantes." );

  AddDetail( ({"holzrahmen","rahmen"}),
            "Der Rahmen besteht aus einem dunklen, stabilen Holz." );

  AddDetail( ({"scheibe","kristallscheibe","front","vorderfront","kristall"}),
            "Eine hauchduenne Scheibe aus geschmolzenem Kristall bedeckt die "
	    "Vorderfront des Waffenschranks." );

  AddDetail( ({"waffen","inneren", "inneres"}),
            "Im Waffenschrank findest Du die ungewoehnlichsten Waffen, sogar ein Yari." );

  AddDetail( ({"vorhang"}),
            "Ein violetter Vorhang haengt vor dem Durchgang in der Westwand. Wenn Du "
	    "durch den Durchgang willst, dann musst Du ihn wohl beiseite schieben." );

  AddDetail( ({"buecher"}),
            "Die Buecher im Buecherregal sind alle etwa gleich dick und in Leder gebunden. "
	    "Sie scheinen nicht weiter interessant zu sein." );

  AddDetail( ({"interessantes"}),
            "Im Buecherregal findet sich vielleicht etwas Interessantes." );

  AddDetail( ({"holz"}),
            "Das Holz ist dunkel. Du weisst aber nicht wovon es stammt." );

  AddDetail( ({"durchgang"}),
            "Hinter dem Vorhang, an der Westwand, befindet sich ein Durchgang. "
	    "Du koenntest den Vorhang beiseite schieben und nachsehen was sich "
	    "dahinter befindet." );

  AddDetail( ({"yari","speer"}),
            "Der Yari im Waffenschrank ist ein Speer dessen Spitze von einem "
	    "metallenen Dorn gebildet wird." );

  AddDetail( ({"leder","schlangenleder"}),
            "Die Buecher wurden, wie es aussieht, in Schlangenleder gebunden." );

  AddDetail( ({"dorn","spitze"}),
            "Der Dorn, der die Spitze eines Yaris bildet, besteht aus Metall." );

  AddDetail( ({"boden"}),
            "Im Boden findest Du ein Loch, durch das eine Leiter nach unten fuehrt." );

  AddDetail( ({"metall"}),
            "Metallisches Metall." );
  //-----Details Ende-----
  
  AddCmd( ({"schieb","schiebe"}), "cmd_vorhang");
  AddCmd( ({"stoeber", "stoebere", "durchsuche",
	    "durchsuch", "durchstoeber", "durchstoebere"}), 
	    "cmd_regal");

  AddExit("unten", ROOM "turm_m");

  AddItem(NPC "kommandeur", REFRESH_DESTRUCT);
}

int cmd_vorhang(string str)
{
  notify_fail("Was moechtest Du wegschieben?\n");
  if(!str || str == "") return 0;
  if(!(str == "vorhang weg" ||
       str == "vorhang beiseite" ||
       str == "vorhang zu seite")) return 0;

  write(BS("Du schiebst den Vorhang beiseite und gehst durch den "
	"Durchgang."));

  TP->move(ROOM "balkon", M_GO, "geht durch den Durchgang", 
		  		"schiebt den Vorhang beisteite und",
				"kommt auf den Balkon");
  return 1;
}

int cmd_regal(string str)
{
  notify_fail("Worin willst Du stoebern?\n");
  if(!str || str == "") return 0;
  if(!(str == "in regal" ||
       str == "regal"    ||
       str == "durch regal" ));

  write(BS("Du blaetterst durch einige der Buecher, kannst aber leider "
	   "keines von ihnen entziffern."));
  say(BS(TPN+" blaettert die Buecher im Regal durch."));
  return 1;
}
