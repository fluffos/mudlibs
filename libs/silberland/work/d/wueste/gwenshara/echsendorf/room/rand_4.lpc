// der Weg um das Echsendorf herum
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

string sand();

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Rand eines Talkessel");
  SetProp( P_INT_LONG,
   "Du stehst hier mitten in der offenen Wueste. Die Sonne brennt "
   "vom Himmel und bringt Dich ganz schoen ins Schwitzen. Suedlich von "
   "Dir hoert der Wuestensand ploetzlich auf. Fast waerst Du ueber eine "
   "Sandburg gestolpert." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );

//-----Details Anfang-----
  AddDetail( "boden", 
            "So wie der Boden in der Wueste nun mal ist. Voller Sand.\n" );

  AddDetail( ({"sand","wuestensand","koerner","sandkoerner"}), #'sand );

  AddDetail( ({"wueste","wuesten","ort","orte"}), 
            "Heisse trockene Orte nennt man Wuesten.\n" );

  AddDetail( ({"sonne","ding"}), 
            "Das seltsame, grosse gelbe Ding am Himmel ist die Sonne.\n" );

  AddDetail( ({"himmel"}), 
            "Vom strahlend blauen Himmel brennt die Sonne herunter.\n" );

  AddDetail( "hitze", 
            "Ganz schoen heiss die Hitze.\n" );

  AddDetail( "schwitzen",
             "Die heisse Hitze bringt Dich ins Schwitzen.");
 
  AddDetail( ({"burg","sandburg"}),
             "Diese wunderschoene Sandburg hat drei kleine Tuermchen und "
             "ein Burgtor. Ein vierter Turm ist auch zu erkennen, leider "
             "ist dieser schon fast ganz zerbroeselt.");

  AddDetail( "turm", "Ach wie schade! Der schoene Turm ist ganz kaputt.");

  AddDetail( "tuermchen", "Die Sandburg hat drei kleine Tuermchen.");

  AddDetail( ({"tor","burgtor"}), 
             "Wenn Du eine Ameise waerst, waere dieses Tor gerade zu riesig.");

  AddDetail( "ameise", "Bist Du eine?");

//-----Details Ende-----

  AddExit("osten", ROOM "rand_3");
  AddExit("suedwesten", ROOM "rand_5");
  AddExit("nordosten", DESERT "64:5");
  AddExit("norden", DESERT "63:5");
  AddExit("nordwesten", DESERT "62:5");
  AddExit("westen", DESERT "62:6");
}

string sand(){
  return "Du zaehlst "+random(99999)+" Sandkoerner.\n";
}
