// von Gwenshara
// 9.7.2003

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein Weg in einem Dorf");
  SetProp( P_INT_LONG,
   "Hier macht der Weg eine Biegung nach Nordosten, auf das Tor zu. Die "
   "Palisade ist hier etwas wackelig geraten so dass einige Ritzen "
   "entstanden sind. Nach Nordosten hin fuehrt Dich der Weg zu dem Tor, "
   "durch welches Du auch ins Dorf gelangt bist. Hier am Boden sind "
   "einige Spuren zu sehen und die Sonne brennt vom Himmel auf Deinen "
   "Kopf hernieder.\n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_TOWN]) );
 
//-----Details Anfang-----

  AddDetail( "biegung", 
             "Der Weg macht hier eine Biegung nach Nordosten, auf das "
             "Tor zu.\n" );

  AddDetail( ({"tor","eingangstor"}), 
               "Das Eingangstor liegt von hier aus ganz im Nordosten.\n");

  AddDetail( "boden", 
             "Der Boden ist mit einer Sandschicht bedeckt. In der "
             "Sandschicht kannst Du Spuren erkennen.\n");

  AddDetail( ({"schicht","sand","sandschicht"}), 
               "Eine Sandschicht bedeckt den Lehmboden, in ihr kannst "
               "Du Spuren erkennen.\n");

  AddDetail( "spuren", 
             "In der Sandschicht erkennst du deutlich die Spuren "
             "einer Raubkatze und die von Echsenmenschen.\n");

  AddDetail( ({"echsenmenschen","echsen","menschen"}), 
             "Die Echsenmenschen bewohnen dieses Dorf hier.\n");

  AddDetail( "dorf", 
             "Du gehst hier gerade einen Weg um dieses eine Dorf, welches "
             "von Echsenmenschen bewohnt wird.\n" );

  AddDetail( "himmel", 
             "Vom Himmel her brennt die Sonne auf Dich herab.\n" );

  AddDetail( "sonne", 
             "Die Sonne brennt auf Dich hernieder, als wuerde sie Dich "
             "verbrennen wollen.\n" );

  AddDetail( ({"kopf","koepfen"}), 
               "Hast Du keinen? Falls Du noch nie "
               "einen gesehen haben solltest:\nAuf ihm sind zwei Augen, "
               "eine Nase und der Mund, in manchen Koepfen soll sogar "
               "etwas sein, das man Gehirn nennt.\n" );

  AddDetail( "augen", "Du hast zwei in Deinem Kopf.\n" );

  AddDetail( "nase", "Das Ding zum Riechen nennt man Nase.\n" );

  AddDetail( "mund", "Oger stopfen da ihr Futter rein.\n" );

  AddDetail( "gehirn", 
             "Noch nie davon gehoert? Damit denken manche Wesen.\n");

  AddDetail( ({"palisade","palisadenzaun","zaun"}), 
             "Hier ist beim Bau der Palisade etwas geschlampt worden. "
             "Die Baumstaemme stehen etwas unregelmaessig und dadurch haben "
             "sich Ritzen gebildet.\n" );

  AddDetail( "ritzen", 
            "Eine Ritze ist so gross das Du durchschaun kannst.\n" );

  AddDetail( "ritze", 
             "Durch die Ritze blickst Du in die Wueste, genau auf ein "
             "seltsames Objekt.\n" );

  AddDetail( "objekt", 
             "Das Objekt entpuppt sich bei naeherem Hinsehen als Kadaver.\n");

  AddDetail( ({"kadaver","kamel"}), "Der verwesende Kadaver eines Kamels.\n");

  AddDetail( "weg", 
             "Du befindest Dich hier auf einem Weg, der um das "
             "Dorf fuehrt.\n"); 

  AddDetail( ({"lehm","lehmboden"}), 
             "Der Boden hier besteht aus Lehm.\n" );

  AddDetail( "futter", "Etwas, dass man essen kann.\n" );

  AddDetail( ({"etwas","ding"}), "Was denn genau?\n" );

  AddDetail( "bau", "Beim Bau der Palisade wurde ziemlich geschlampt.\n" );

  AddDetail( ({"staemme","palmenstaemme","baumstaemme","palmenstaemmen","palmenstaemme"}),
            "Die Palisade wurde aus Palmenstaemmen gebaut.\n" );

  AddDetail( "wueste", "Ein trockener, sandiger Ort.\n" );

  AddDetail( ({"katze","raubkatze"}), "Hier ist sie nicht.\n" );

  AddDetail( "ort", "Hier ist ein Ort.\n" );

//-----Details Ende-----

  AddExit("westen", ROOM "ges_9");
  AddExit("nordosten", ROOM "ges_11");
}
