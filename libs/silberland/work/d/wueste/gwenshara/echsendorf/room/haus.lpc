// von Gwenshara
// 5.7.2003
// 
// Raum meines Gesellenstueckes "Echsendorf"

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Die Huette des Dorfaeltesten");
  SetProp( P_INT_LONG,
     "Hier herinnen ist es im Vergleich zu draussen angenehm kuehl. "
    +"An der Rueckwand des Raumes befindet sich ein Fenster. An der "
    +"Westwand sind verschiedenste Jagdwaffen aufgereiht. Vermutlich "
    +"bist Du hier in einem Haus, das von Jaegern bewohnt wird gelandet. "
    +"An der Ostwand siehst Du verschiedene tote Tiere aufgereiht. Eine "
    "Treppe fuehrt in den Keller des Hauses." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

//-----Details Anfang-----
  AddDetail("boden", 
            "Im Vergleich zu den anderen Haeusern ist der Boden "
           +"hier aus Stein und auch kuehl. Eine Treppe fuehrt nach unten.");

  AddDetail("treppe",
	    "Eine Treppe fuehrt in den Keller hinunter.");

  AddDetail("keller",
            "Der Keller befindet sich unter Dir.");

  AddDetail("stein",
            "Der Boden ist aus kuehlem Stein gemacht worden.\n");

  AddDetail("decke", "Die Decke ist rund und aus Lehm gemacht.\n" );

  AddDetail( ({"lehm","lehmerde","erde","erdenart"}), 
            "Lehm ist eine hier sehr oft vorkommende Erdenart.\n" ); 

  AddDetail( ({"fenster","rueckwand","fensters","nordwand"}), 
            "An der Rueckwand des Hauses befindet sich ein Fenster. "
           +"Als Du es naeher betrachtest, stellst Du erstaunt fest, "
           +"dass es sogar Fensterscheiben besitzt. Wenn Du hinaus "
           +"blickst, siehst Du die Duenen in der Umgebung.\n" );

  AddDetail( ({"fensterscheibe","fensterscheiben","scheibe","scheiben","glas"}),
            "Das Glas des Fensters ist gar kein Glas, sondern eine durchsichtige "
           +"Kristallart.\n" );

  AddDetail( ({"haus","hauses","haeusern"}), 
           "Du befindest Dich in einem solchen Haus.\n" );

  AddDetail( ({"jaeger","jaegers","jaegern"}), 
            "Die wohnen vermutlich hier, aber "
           +"im Moment sind keine hier, da sie auf Jagd sind.\n" );

  AddDetail( "moment", "Jetzt in diesem.\n" );

  AddDetail( "jagd", 
            "Die Jaeger jagen Tiere um sie nachher zu Essen verarbeiten zu "
           +"koennen.\n" );

  AddDetail( ({"tiere","tier","ostwand"}), 
            "Einige tote Tiere haengen an der Ostwand.\n" );

  AddDetail( ({"waffen","jagdwaffen","westwand"}), 
              "An der Westwand sind einige Speere, seltsame Wurfwaffen "
             +"und auch Blasrohre.\n" ); 

  AddDetail( "speere", 
            "Das sind genau solche Speere, wie sie auch die Waechter "
           +"benutzen.\n" );

  AddDetail( "waechter", 
            "Einer steht am Tor und die anderen laufen im Dorf herum.\n" );

  AddDetail( "dorf", "Da bist Du drin.\n" );

  AddDetail( "wurfwaffen", 
            "Die meisten von ihnen kennst Du nicht, am ehesten entsprechen "
          +"sie Wurfkeulen.\n" );

  AddDetail( ({"wurfkeulen","keulen"}), 
            "Einige haengen an der Westwand.\n" );

  AddDetail( ({"blasrohre","rohre"}),
            "Lange duenne Rohre, durch die man meist vergiftete Pfeile "
           +"pustet.\n" );

  AddDetail( "pfeile", 
            "Durch Blasrohre kann man vergiftete kleine Pfeile pusten.\n" );
  AddDetail( ({"raum","raumes"}), 
            "In dem stehst Du hier, mit dem Befehl 'schau' kannst Du "
           +"Dich umsehen.\n" );

  AddDetail( ({"waende","wand"}), "Nord-, Sued-, Ost-, oder Westwand?\n" );

  AddDetail( ({"suedwand", "tuer"}), 
            "An der Suedwand befindet sich die Tuer, durch die Du wieder "
           +"raus kommst.\n" );

  AddDetail( "befehl", "Ich behfehle hier gar nichts.\n");

  AddDetail( ({"duenen","umgebung"}),
             "Wenn Du aus dem Fenster blickst, erkennst Du die Duenen in "
             +"der Umgebung.\n");

  AddDetail( "essen",
            "Die toten Tiere werden hier auch zu Essen verarbeitet.\n" );

  AddDetail( ({"kristallart","kristall"}), 
            "Die Fensterscheibe ist aus Kristall.\n" );
//-----Details Ende-----
  
  AddItem( NPC "echsfrau", REFRESH_DESTRUCT);

  AddExit("raus", ROOM "ges_5");
  AddExit("unten", ROOM "keller");

}

