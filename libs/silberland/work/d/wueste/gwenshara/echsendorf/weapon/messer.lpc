#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein echsisches Kuechenmesser");
  SetProp(P_LONG,
    "Ein ganz einfaches Kuechenmesser. Warum es ausgerechnet ein echsisches "
   +"sein soll verstehst Du nicht."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kuechenmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "kuechenmesser"}) );

  SetProp(P_NAME_ADJ, ({"echsisch"}) );
  AddAdjective( ({"echsischen","echsischer","echsischem","echsisches","echsische"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 900);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["zzhaxxel":256 ]) );
}
