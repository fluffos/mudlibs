#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Steinlanze");
  SetProp(P_LONG,
    "Die Steinlanze ist eigentlich nur ein langer Steinzapfen. Sie scheint "
    "aeusserst stabil, aber auch sehr schwer zu sein.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Steinlanze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lanze", "steinlanze"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 165);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\ngwenshara_erzele":135 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:18]) );
}
