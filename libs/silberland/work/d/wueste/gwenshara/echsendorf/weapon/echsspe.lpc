/*
 * echspe.c
 * ---
 * Letzte Aenderung: 2003-7-1 by Gwenshara.
 *
 * Ein weiteres Objekt fuer mein gesellenstueck, diesmal eine Waffe, ein
 * Speer
 *
 */


inherit "std/weapon";           

#include <properties.h>         
#include <language.h>          
#include <combat.h>             


void create()
{

  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */

  AddId("speer");
  AddId("echsenspeer");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Echsenspeer");
  SetProp(P_SHORT, "Ein Echsenspeer");
  SetProp(P_LONG,
    "Dieser Speer ist zwar sehr gross, kann aber vermutlich keinen. "
   +"grossen Schaden anrichten. An seinem Schaft sind verschiedene "
    "Verzierungen in Schlagenform angebracht. Die Spitze besteht "
    "aus einem spitzen Stueck unbekannten Metalls.\n" );
  SetProp(P_VALUE, 450);
  SetProp(P_WEIGHT, 999);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);      
  SetProp(P_DAM_TYPE, DT_PIERCE);     
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 20);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WC_BONUS, (["echsenwaechter:211","echse:200","echsenwachmann:211"]));

  AddDetail( "schaden", "Mit diesem Spper kann man vermutlich nicht "
                        "viel Schaden anrichten.\n" );
  AddDetail( ({"schaft","verziehrung","verziehrungen"}),
             "Am Schaft sind verschiedene Verziehrungen in "
             "Schlangenformen angebracht.\n" );
  AddDetail( ({"spitze","metall"}),
             "Die Spitze des Speeres besteht aus unbekanntem Metall.\n" );
}

