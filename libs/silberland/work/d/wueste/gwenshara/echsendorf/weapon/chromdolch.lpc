#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Chromdolch");
  SetProp(P_LONG,
    "Du erblickst einen blitzenden Chromdolch. Er ist etwa eine Elle lang "
    "und scharf. Er hat nur eine schmale Parierstange und einen lederumwickelten "
    "Griff. Der Griff wurde mit einem Puder bestaebt, damit man den Dolch besser "
    "halten kann."
  );

  AddDetail( "elle",
	    "Etwa 30 Zentimeter.");
  AddDetail( "parierstange",
	    "Die Parierstange des Chromdolches ist nur sehr Schmal.");
  AddDetail( "puder",
	    "Der Griff des Chromdolches wurde mit einem Puder bestaeubt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Chromdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "chromdolch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CHROMIUM:90, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 80);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["echse":120 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:10]) );
}
