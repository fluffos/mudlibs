#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Achfawar");
  SetProp(P_LONG,
    "Diese Waffe unterscheidet sich nur sehr geringfuegig von einem "
    "Dreizack. Der wesentliche Unterschied liegt darin, dass seine "
    "Klingen in einem gleichseitigen Dreieck angeordnet sind. Ausserdem "
    "sind die Klingen von unterschiedlicher Laenge. Die Laengste ist "
    "ganz glatt und endet mit einer Spitze. Die anderen zwei sind "
    "gezackt, so dass sie dem Gegner die Haut aufreissen.."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Achfawar");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "achfawar", "dreizack"}) );

//--Eigenschaften---------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER:10, MAT_WOOD:40, MAT_IRON:30]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 140);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:10, A_STR:11]));

  SetProp(P_WC_BONUS, (["echse":256 ]) );
}
