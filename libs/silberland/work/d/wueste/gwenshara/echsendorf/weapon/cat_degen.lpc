#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein leichter Katzendegen");
  SetProp(P_LONG,
    "Ein leichter Degen, der sich einfach fuehren laesst. Er ist gut "
    "ausbalanziert und liegt angenehm in der Hand. Er hat einen schmucklosen " 
    "Griffkorb, der die Finger schuetzt.\nEr wurde extra fuer Katzenpfoten gemacht."
    
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Katzendegen");
  SetProp(P_GENDER, MALE);
  AddId( ({"degen", "katzendegen"}) );

  SetProp(P_NAME_ADJ, "leicht" );
  AddAdjective( ({"leichten","leichter","leichtem","leichtes","leichte"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 330);
  SetProp(P_SIZE, 45);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\nantonio":220 ]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Der Degen kann wohl nur von Katzen effektiv gefuert werden"));
}

