#include "../def.h"
#define WUESTENMASTER ROOM "master"
#define TG(x) if(find_player("gwenshara")) tell_object(find_player("gwenshara"), BS("TW: "+x));
#define NPC_CHANCE 20

inherit "std/room";

void create()
{
  mapping exits;
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Todeswueste");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------
//--Kommandos--------------------------------------------------------------
//--Ausgaenge--------------------------------------------------------------
//--Items & NPCs-----------------------------------------------------------
if(file_name(TO) == ROOM "labyrinth") return;

  TG(sprintf("customize: %O\n", PO));
  PO->CustomizeObject();
 /* if(random(100) < NPC_CHANCE)
    AddItem(WUESTENMASTER->get_npc(), REFRESH_DESTRUCT,
            ([P_MNPC_DEFAULTROOM: file_name(TO), 
              P_MNPC_AREA: ROOM,
              P_MNPC_FLAGS: MOV_OUTDOORS + MOV_BACKWARDS + MOV_MOVES + MOV_MAYLOAD,
            }]));*/

  AddCmd("customize", "cmd_customize");
}

public int cmd_customize() {
  if(!IS_LEARNER(TP)) return 0;
  call_other(ROOM "virtual_compiler", "CustomizeObject");
  return 1;
}

void SetExits(mapping e)
{
  string *dirs;
  int i;

  dirs = m_indices(e);
  for(i=0; i<sizeof(dirs); ++i)
    AddExit(dirs[i], e[dirs[i]]);
  return;
}
