#0:0
text_short ({"Im Zikkurat des Zwielichts",})
text_long ([6:({"Ein dichter Bodennebel bedeckt den Gang.","Du entdeckst ein paar kleine Locher an der Wand.","Ein goldener Weihrauchschwenker haengt mitten im Gang von der Decke.","Heisser Dampf steigt aus einer Ritze an der Wand.","Eine der Waende ist mit einer schmelzenden Eisschicht bedeckt.","Einige geschwaerzte Steinplatten zeugen von einem Kampf, der hier stattgefunden hat.","Mehrere armdicke Kratzer ziehen sich ueber ueber die Waende.","An einer Wand siehst du ein langsam tickendes Zahnrad.","Ein einem der Ausgaenge erkennst du Schleifspuren von schweren Steinen.","Mehrere Ketten haengen hier aus der Decke.","Ueber dir verlaufen einige heisse Rohre.","Aus einem Krater im Boden sprueht ein feiner Spruehnebel in den Raum.","Der Boden unter deinen Fuessen bewegt sich langsam nach Sueden.","Ein Zittern geht durch den Gang.","Duch eine der Waende hoerst du das Knistern und Fauchen eines Feuers.",}),2:({"An den Waenden findest du einige Hieroglyphen, welche Szenen aus der Vergangenheit darstellen.","Einige der Steinplatten an den Waenden sind gesplittert.","Er wurde mit vollkommen schmucklosen Steinfliessen verkleidet.","Ein grosses Wandbild, das einen Menschen mit Tierkopf darstellt, wurde hier an die Wand gemalt.","Kleine Mosaiksteine machden die Waende hier zu einem bunten Gesamtwerk.",}),3:({"Das Echo eines dumpfen Singsangs dringt an dein Ohr.","Feiner Sand rieselt immer wieder von der Decke.","Aus einer der Waende hoerst du das Schaben von Stein auf Stein.","Ueber dir kannst du das Rasseln einer schweren Metallkette vernehmen.","Irgendwo in der Ferne hoerst du einen Scherzensschrei.",}),4:({"Mit deinen Fuessen tastest du dich vorsichtig voran.","Als du einen unbedachten Schritt nach vorne machst ertoent ein leises Klicken.","Im Boden wurde ein grosses Ankh aus Bernstein eingelassen.","Eine schwach glimmende Linie wurde hier in den Boden eingelassen.","Der Boden hier ist mit Steinkreisen belegt, die sich unter deinen Fuessen sanft drehen.",}),5:({"Die Luft in diesem Raum riecht irgendwie modrig.","Ein angenehmer Duft weht durch diesen Gang.","Staub und Sand kitzeln dich in der Nase.","Ein eigenartiger ozonartiger Dunst steigt dir in die Nase.","Kleine Rauchschwaden verbreiten den Geruch von Verbranntem.",}),1:({"Du stehst in einem aus Stein gehauenen Gang.","Der Gang, in dem du hier stehst, faellt leicht nach Osten hin ab.","Du findest dich in einem Gang aus einfachem Sandstein wieder.","In diesem Gang mischt ein sanfter, kuehler Luftzug die stickige Luft auf.","Dieser Gang des Zikkurats wirkt ",}),])
text_details (["wueste":({"Du befindest Dich mitten in der Wueste","Die Menge an Sand um Dich herum deutet wohl auf eine Wueste hin.","Ja, so ist die Wueste - heiss und noch heisser.","Ueberall Sand - definitiv die Wueste!",}),])
parsed 0
