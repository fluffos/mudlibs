#include "../def.h"

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "raum"
#define DETAILMASTER   ROOM "detailmaster"
#define TG(x) if(find_player("gwenshara")) tell_object(find_player("gwenshara"), BS("ZIKKURAT: "+x+"\n"));
#define NPC_CHANCE 20



create() {
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "labyrinth" );
  SetProp(P_ROOMS, ({"labyrinth"}) );
}

string Validate(string file) {
  string name,foo;
  int xl,yl,level;

  TG(sprintf("validate %s", file));

  file = ::Validate(file);
  TG(sprintf("file=%s", file));
  if ((sscanf(file, "%s:%d:%d:%d%s",name,level,xl,yl,foo) == 5) &&
      (member(QueryProp(P_ROOMS), name) != -1)) {
    if(LABMASTER->IsValidRoom(level, xl, yl))
       return name+":"+level+":"+xl+":"+yl;
  }
  return 0;
}

private void AddExitDescriptions(int l, int x, int y) {
  if(LABMASTER->IsExitRoom(l, x, y) == EXIT_ROOM_WEST) {
    PO->SetProp(P_INT_LONG, PO->QueryProp(P_INT_LONG) + "Ein grosses Portal an der Westwand fuehrt nach draussen.");
    PO->AddDetail( ({"westwand"}), "Ein grosser steinerner Durchgang fuehrt hier nach draussen.");
  } else {
    PO->SetProp(P_INT_LONG, PO->QueryProp(P_INT_LONG) + "Ein grosses Portal an der Ostwand fuehrt nach draussen.");
    PO->AddDetail( ({"ostwand"}), "Ein grosser steinerner Durchgang fuehrt hier nach draussen.");
  }

  PO->AddDetail( ({"portal", "durchgang"}), "Das grosse Portal fuehrt nach draussen, um das Zikkurat zu verlassen." );
}

int CustomizeObject() {
  string name,foo,foo2,*waende,wtext;
  string npc;
  int xl,yl,ll,i;
  mapping exits;
  object ob;

  TG(sprintf("Customize Object: %O", PO));

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d:%d:%d%s",foo,ll,xl,yl,foo2)!=5)
    return 0;

  TG("start customizsation");

  exits=LABMASTER->GetExits(ll, xl,yl);
  TG(sprintf("exits: %O", exits));
  PO->SetExits(exits);
  DETAILMASTER->Customize(PO);

  if(LABMASTER->IsExitRoom(ll, xl, yl) != EXIT_ROOM_NO) {
    AddExitDescriptions(ll, xl, yl);
  }

  return 1;
}
