#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_LONG,
    "Die Steinsaeule ist etwa anderthalb Meter hoch. Sie ist ueber und ueber "
    "mit Hieroglyphen aus eingelassenem Bernstein verziert. An ihrer Spitze "
    "wurde ein kleines goldenes Kohle becken eingelassen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Steinsaeule");
  SetProp(P_GENDER, MALE);
  AddId( ({ "saeule", "steinsaeule", "kohlebecken", "\nzikkurat_beacon" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STONE: 80, MAT_GOLD:10, MAT_CARBON: 10]) );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOGET, "ist viel zu schwer.\n");

  AddCmd( "zuende|zuend&becken|kohlebecken|saeule|steinsaeule|feuer|flamme&an", "cmd_anzuenden", "Was willst du anzuenden?\n");
  AddCmd( "loesche|loesch&becken|kohlebecken|saeule|steinsaeule|feuer|flamme", "cmd_loeschen", "Was willst du loeschen?\n");
  }

  public int cmd_anzuenden() {
      if(QueryProp(P_LIGHT)) {
          write("Das Feuer brennt doch schon!\n");
          return -1;
      }

      if(TP->QueryProp(P_SP)<5) {
          write("Dazu reicht deine magische Kraft nicht aus.\n");
          return -1;
      }

      write("Mit einem kleinen Feuerball entzuendest du das Feuer.\n");
      TP->AddSp(-5);
      say(TPN+" entzuendet das Kohlebecken mit einem kleinen Feuerball.\n");
      SetProp(P_LIGHT, 1);
      return 1;
  }

  public int cmd_loeschen() {
      if(!QueryProp(P_LIGHT)) {
          write("Das Feuer brennt doch gar nicht!\n");
          return -1;
      }

      if(TP->QueryProp(P_SP)<5) {
        write("Dazu reicht deine magische Kraft nicht aus.\n");
        return -1;
    }

      write("Mit einem Schnippen loeschst du das Feuer.\n");
      TP->AddSp(-5);
      say(TPN+" schnippt mit den Fingern und die Flamme geht aus.\n");
      SetProp(P_LIGHT, 0);
      return 0;
  }

public string _query_short() {
    return sprintf("Ein Steinsaeule mit Kohlebecken%s", (QueryProp(P_LIGHT)?" (brennend)":""));
}
