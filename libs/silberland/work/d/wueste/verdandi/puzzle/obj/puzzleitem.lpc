
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/secure/questmaster.h"

int bildnummer;
string *kompl_bild,steinplatte;   // das komplette Bild, die derzeitige Steinplatte
int *place;                       // welche Steinposition wird an place[i]=pos gefunden?
int *found;                       // wurde an der stelle found[i]=1/0 schon ein stein gefunden?
int *eingesetzt;                  // an stelle eingesetzt[i]=nr wurde Pos nr eingesetzt
mapping einzel;                   // die einzelbilder nach position sortiert
string *rahmen;
int solved;

void generate_steinplatte();

create() {
  int i;
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ QUESTITEMID,"QUESTITEM","QUESTOBJ" }) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  place=allocate(10);
  found=allocate(10);
  eingesetzt=allocate(10);
  rahmen=allocate(22);
  
  kompl_bild=steinplatte="";
  einzel=([ ]);
  for(i=0;i<10;i++)
    place[i]=found[i]=eingesetzt[i]=0;  

  generate_steinplatte();
  solved=0;

  AddCmd( "zerstoere", "zerfkt" );
    
  SUID;
}

init() {
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}

void set_bild(int nr) {
  int i;
  string tmp;

  if(file_name(PO) != QUESTMASTER) {
    return;
  }
  tmp=sprintf( QUESTBILDER +"bild%d",nr);
  bildnummer=nr;
  kompl_bild=explode(read_file(tmp),"\n");
}

void set_place(int *zahlen) {
  int i,j,zeile,spalte;
  string res;
  
  if(file_name(PO) != QUESTMASTER) {
    return;
  }
  for(i=0;i<10;i++) {
    place[i]=zahlen[i];
    found[i]=0;
  }

  for(j=1;j<10;j++) {
    res="";
    zeile=((j-1)/3)*7;
    spalte=((j-1)%3)*21;

    for(i=0;i<7;i++) {
      res+=kompl_bild[zeile+i][spalte..(spalte+20)]+"\n";
    }
    einzel+=([ j: res ]);
  }
}

string show_bild() {
  int i;
  string res;
  
  if((!IS_ARCH(TP) && getuid(TP) != "verdandi") || TP != TI) {
    return "";
  }
  res="";
  for(i=0;i<21;i++)
    res+=kompl_bild[i]+"\n";
  return res;
}

string show_einzel(int nr) {
  if(file_name(PO)[0..strlen(QUESTSTEIN)-1] != QUESTSTEIN &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/" &&
     file_name(PO) != QUESTMASTER &&
     PO != ME) {
    return "";
  }
  return (string)einzel[nr];
}

int check_found(int nr) {
  if(file_name(PO) != QUESTMASTER) {
    return -1;
  }
  return found[nr];
}

void set_found(int nr) {
  if(file_name(PO) != QUESTMASTER) {
    return;
  }
  found[nr]=1;
}

int get_number(int nr) {
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return 0;
  }
  return place[nr];
}

void get_quest() {
  int i;
  
  if(!IS_ARCH(TP) && getuid(TP) != "verdandi") {
    return;
  }
  write("+-----------------------------------------------------------------\n");
  write("| FriedhofQuest von "+CAP(getuid(ENV(ME)))+"\n");
  write("+-----------------------------------------------------------------\n");
  write("| Bildnummer: bild"+bildnummer+"\n");
  write("+--------------------+----------------+-------------+-------------\n");
  write("| Fundstelle/Platte: | Eingesetzt an: | Plaettchen: | Gefunden:   \n");
  write("+--------------------+----------------+-------------+-------------\n");
  for(i=1;i<10;i++)
    printf("| %d                  | %d              | %d           | %s\n",
      i,eingesetzt[i],place[i],(found[i]?"Ja":"Nein"));
  write("+--------------------+----------------+-------------+-------------\n");
  write("| Quest geloest: "+(solved==0?"Nein":"Ja")+"\n");
  write("+-----------------------------------------------------------------\n");
}

string show_steinplatte() {
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return "";
  }
  return steinplatte;
}

nosave void generate_steinplatte() {
  string *temp1,*temp2,*temp3;
  mapping pos;
  int i,nr;

/*

    _*-. _ ~  _.:*~*:.:*~*:._.:*~~\/~~*:._.:*~*_*~*:.:*~*:._.:*~*:._.:*~*:.  
   ;    * '*:'       ~       \            |               /                \ 
 . |  ,~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~\  °  }
   _\/\                                                               |    / 
 _= * |                                                               \   <  
(     )                                                               /    \ 
 ) _  (                                                               >   !~ 
(   ' >                                                               }  ;°  
 \    |                                                               | /    
  }   /                                                               \(     
  | < \                                                               } ~-_  
,~    /                                                               \  _-~ 
 \    >                                                               }\/    
  \   }                                                               | :,   
  |   |                                                               }   }  
 /    \                                                               \  {"  
 +-   }                                                               |   \  
 | |  \                                                               }    \ 
  Y   }                                                               ( /\  )
  ;   |                                                               |  / [ 
 {  ° }                                                               /     }
 /\   \                                                               \ °, < 
| )   |                                                               |   )|
| (   <                                                               /  ( (
;  \_ `~^~^~^~^\^~^~^~^~^~^~^T^~^~^~^~!~^~^~^~^~^~^~^~^~^~^~^~^/^~^~^~    " >
´    ~**:*:._.:*~*:._.:*~*::*~~*:._.J*~*:._.:*~*:'~':*~*:._.:*~*:._.:*:._.:/ 

    _*-. _ ~  _.:*~*:.:*~*:._.:*~~\\/~~*:._.:*~*_*~*:.:*~*:._.:*~*:._.:*~*:.  
   ;    * '*:'       ~       \\            |               /                \\ 
 . |  ,~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~\\  °  }
   _\\/\\                                                               |    / 
 _= * |                                                               \\   <  
(     )                                                               /    \\ 
 ) _  (                                                               >   !~ 
(   ' >                                                               }  ;°  
 \\    |                                                               | /    
  }   /                                                               \\(     
  | < \\                                                               } ~-_  
,~    /                                                               \\  _-~ 
 \\    >                                                               }\\/    
  \\   }                                                               | :,   
  |   |                                                               }   }  
 /    \\                                                               \\  {"  
 +-   }                                                               |   \\  
 | |  \\                                                               }    \\ 
  Y   }                                                               ( /\\  )
  ;   |                                                               |  / [ 
 {  ° }                                                               /     }
 /\\   \\                                                               \\ °, < 
| )   |                                                               |   )|
| (   <                                                               /  ( (
;  \\_ `~^~^~^~^\\^~^~^~^~^~^~^T^~^~^~^~!~^~^~^~^~^~^~^~^~^~^~^~^/^~^~^~    " >
´    ~**:*:._.:*~*:._.:*~*::*~~*:._.J*~*:._.:*~*:'~':*~*:._.:*~*:._.:*:._.:/ 




*/

  rahmen[ 0]="    _*-. _ ~  _.:*~*:.:*~*:._.:*~~\\/~~*:._.:*~*_*~*:.:*~*:._.:*~*:._.:*~*:.  \n"+
             "   ;    * '*:'       ~       \\            |               /                \\ \n"+
             " . |  ,~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~^~\\  °  }\n"+
             "   _\\/\\";
  rahmen[ 1]="|    / \n _= * |";
  rahmen[ 2]="\\   <  \n(     )";
  rahmen[ 3]="/    \\\n ) _  (";
  rahmen[ 4]=">   !~ \n(   ' >";
  rahmen[ 5]="}  ;°  \n \\    |";
  rahmen[ 6]="| /    \n  }   /";
  rahmen[ 7]="\\(     \n  | < \\";
  rahmen[ 8]="} ~-_  \n,~    /";
  rahmen[ 9]="\\  _-~ \n \\    >";
  rahmen[10]="}\\/    \n  \\   }";
  rahmen[11]="| :,   \n  |   |";
  rahmen[12]="}   }  \n /    \\";
  rahmen[13]="\\  {\"  \n +-   }";
  rahmen[14]="|   \\  \n | |  \\";
  rahmen[15]="}    \\ \n  Y   }";
  rahmen[16]="( /\\  )\n  ;   |";
  rahmen[17]="|  / [ \n {  ° }";
  rahmen[18]="/     }\n /\\   \\";
  rahmen[19]="\\ °, < \n| )   |";
  rahmen[20]="|   )| \n| (   <";
  rahmen[21]="/  ( (\n"+
             ";  \\_ `~^~^~^~^\\^~^~^~^~^~^~^T^~^~^~^~!~^~^~^~^~^~^~^~^~^~^~^~^/^~^~^~    \" >\n"+
             "´    ~**:*:._.:*~*:._.:*~*::*~~*:._.J*~*:._.:*~*:'~':*~*:._.:*~*:._.:*:._.:/ \n";

  pos=([ ]);
  nr=0;

  for(i=1;i<10;i++) {
    if (eingesetzt[i])
      pos+=([ i: show_einzel(eingesetzt[i]) ]);
    else
      pos+=([ i:
              " . . . . . . . . . . \n"
              "  . . . . . . . . .  \n"
              " . . . . . . . . . . \n"
              "  . . . . "+i+" . . . .  \n"
              " . . . . . . . . . . \n"
              "  . . . . . . . . .  \n"
              "                     \n"
            ]);
  }

  steinplatte=rahmen[nr++];

  temp1=explode(pos[1],"\n");
  temp2=explode(pos[2],"\n");
  temp3=explode(pos[3],"\n");
  
  for (i=0;i<7;i++) {
    steinplatte+=temp1[i];
    steinplatte+=temp2[i];
    steinplatte+=temp3[i];
    steinplatte+=rahmen[nr++];
  }

  temp1=explode(pos[4],"\n");
  temp2=explode(pos[5],"\n");
  temp3=explode(pos[6],"\n");
  
  for (i=0;i<7;i++) {
    steinplatte+=temp1[i];
    steinplatte+=temp2[i];
    steinplatte+=temp3[i];
    steinplatte+=rahmen[nr++];
  }

  temp1=explode(pos[7],"\n");
  temp2=explode(pos[8],"\n");
  temp3=explode(pos[9],"\n");
  
  for (i=0;i<7;i++) {
    steinplatte+=temp1[i];
    steinplatte+=temp2[i];
    steinplatte+=temp3[i];
    steinplatte+=rahmen[nr++];
  }
}

void setquest() {
  int i;
  
  if(!IS_ARCH(TP)||!IS_ARCH(TI)) return;
  for(i=0;i<10;i++)
    eingesetzt[i]=i;
}

int einsetzen(int pos, int nr) {
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return 0;
  }
  if(solved) return 0;
  if(eingesetzt[pos] != 0) return 0;
  eingesetzt[pos]=nr;
  generate_steinplatte();
  return 1;
}

int aufnehmen(int pos) {
  int temp;
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return -1;
  }
  if(solved) return -1;
  if(eingesetzt[pos] == 0) return 0;
  temp=eingesetzt[pos];
  eingesetzt[pos]=0;
  generate_steinplatte();
  return temp;
}

int verschiebe(int pos1, int pos2) {
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return -2;
  }
  if(solved) return -2;
  if(eingesetzt[pos1] == 0) return -1;
  if(eingesetzt[pos2] != 0) return -2;
  eingesetzt[pos2]=eingesetzt[pos1];
  eingesetzt[pos1]=0;
  generate_steinplatte();
  return 1;
}

int vertausche(int pos1, int pos2) {
  int temp;
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return -3;
  }
  if(solved) return -3;
  if(eingesetzt[pos1] == 0) return -1;
  if(eingesetzt[pos2] == 0) return -2;
  temp=eingesetzt[pos2];
  eingesetzt[pos2]=eingesetzt[pos1];
  eingesetzt[pos1]=temp;
  generate_steinplatte();
  return 1;
}

int check_ready() {
  int i,ok,ret;
  object ob;

  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return 0;
  }
  
  if(solved) return 0;
  ok=1;
  for(i=1;i<10;i++)
    if(eingesetzt[i] != i) ok=0;
    
  if(ok) { // quest geschafft :)
    ret=TP->GiveQuest(QUESTNAME);
    switch(ret) {
      case 1:
               write_file(QUESTLOG, 
                 dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
               write_file("/log/quests/puzzle",
                 dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
               if(!present("\n_mag_knochen",TP)) {
                 catch(ob=clone_object("/d/wueste/verdandi/puzzle/obj/xplog"));
                 if(ob) {
                   ob->move(TP,M_NOCHECK);
                   write(BS(
                     "Auf einmal oeffnet sich ueber Dir der Himmel und ein "
                     "Knochen faellt Dir direkt in die Arme."));
                 }
               }
               break;
      case GQ_ALREADY_SET:
               write_file(QUESTLOG, 
                 dtime(time())+": "+CAP(getuid(TP))+" loest die Quest ein weiteres Mal.\n" );
              if(!present("\n_mag_knochen",TP)) {
                catch(ob=clone_object("/d/wueste/verdandi/puzzle/obj/xplog"));
                if(ob) {
                  ob->move(TP,M_NOCHECK);
                  write(BS(
                    "Auf einmal oeffnet sich ueber Dir der Himmel und ein "
                    "Knochen faellt Dir direkt in die Arme."));
                }
              } 
              break;
      default: write(BS(
                 "ACHTUNG: Unbekannter Fehler!! Bitte wende Dich SOFORT an "
                 "einen anwesenden Magier!!!"));
               write_file(QUESTLOG,
                 dtime(time())+": "+CAP(getuid(TP))+" loest die Quest mit FEHLER: "+ret+"\n");
               return 1;
               break;
    }
    solved=1;
    // aufraeumen, loeschen aller sachen... das Questitem loescht sich
    // erst 60 Minuten spaeter. Solange kann der Spieler sich das alte
    // fertige Bild noch ansehen :)
    for(i=0;i<10;i++)
      if(ob=present(QUESTSTEINID,TP))
        ob->remove();
    call_out("remove",60*30);
  }
  return ok;
}

reset() {
  ::reset();
  if(solved)
    call_out("remove",0);
}

int zerfkt(string str) {
  int i;
  object ob;
  
  notify_fail("Was moechtest Du zerstoeren? (Achtung, es gibt KEIN Zurueck!)\n");
  if(str != "alle steinplaettchen") return 0;

  solved=1;
  write_file(QUESTLOG, 
    dtime(time())+": "+CAP(getuid(TP))+" zerstoert alle Steinplaettchen.\n" );
  for(i=0;i<15;i++)
    if(ob=present(QUESTSTEINID,TP))
      ob->remove();
  call_out("remove",0);
  RemoveId( ({ QUESTITEMID,"QUESTITEM","QUESTOBJ" }) ); // nur um sicher zu gehen
  write(BS(
    "Du legst alle Steinplaettchen auf den Boden und trampelst solange darauf "
    "herum, bis alle vollstaendig zerstoert sind!"));
  return 1;
}
