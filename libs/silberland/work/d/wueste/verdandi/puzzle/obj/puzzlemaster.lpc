*/

#include "../def.h"

#include <moving.h>

create() {
  if (is_clone(ME)) return destruct(ME);
  SUID;
}

int stone_found(int place) {
  int nr,*zahlen,i,r1,r2;
  string *files;
  object ob,st;

  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/" &&
     file_name(PO)[0..31] != "/d/wueste/verdandi/friedhof/obj/") {
    return 0;
  }

  zahlen=allocate(10);
  
  if (!ob=present(QUESTITEMID,TP)) {
    /* Spieler faengt die Quest ganz neu an -> 1. Stein ! */
  
    ob=clone_object(QUESTITEM);
    ob->move(TP,M_NOCHECK);
    
    for(i=0;i<10;i++) 
      zahlen[i]=i;    
    
    for(i=0;i<500;i++) {
      r1=random(9)+1;
      r2=random(9)+1;
      nr=zahlen[r1];
      zahlen[r1]=zahlen[r2];
      zahlen[r2]=nr;
    }

    files = get_dir(QUESTBILDER+"bild*");
    nr=random(sizeof(files))+1;
    ob->set_bild(nr);
    ob->set_place(zahlen);
    write_file(QUESTLOG, 
      dtime(time())+": "+CAP(getuid(TP))+" beginnt die Quest.\n" );
  }

  if(ob->check_found(place) != 0) return 0;
  
  ob->set_found(place);
  st=clone_object(QUESTSTEIN);
  st->move(TP,M_NOCHECK);
  st->set_number(ob,ob->get_number(place));
  return 1;
}

int stone_check(int place) {
  object ob;
  
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return 0;
  }

  if(!ob=present(QUESTITEMID,TP)) return 0;
  return ob->check_found(place);
}
