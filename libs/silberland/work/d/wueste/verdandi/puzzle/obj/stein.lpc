
/*

    Ein Stein fuer die PuzzleQuest von Verdandi

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int nummer;
string bild;

init() {
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinplaettchen");
  SetProp(P_LONG, 
    "Eigentlich darf das hier nicht stehen -> SOFORT Magier verstaendigen !!!" );
  SetProp(P_INFO, "Dieses Steinplaettchen ist sicher fuer etwas Lustiges "
                  "zu gebrauchen.\n"
                  "(Hinweis: Im Notfall kannst Du alle Steinplaettchen mit der \n"
                  "          Syntax 'zerstoere alle steinplaettchen' loswerden!)\n");
  SetProp(P_NAME, "Steinplaettchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "steinplaettchen","plaettchen",QUESTSTEINID,"QUESTITEM",
            "UNZERSTOERBAR","QUESTOBJ" }) );

  SetProp(P_MATERIAL, ([ MAT_MISC_STONE:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SUID;
}

void set_number(object ob, int nr) {
  string *lang,newlang;
  string *rahmen;
  int i;
  
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return;
  }
//  nummer=ob->get_number(place);
  nummer=nr;
  newlang="";
  switch (random(7)) {
    case 0:
      rahmen = ({ "./\\/\\/\\/\\/\\_/\\/\\/\\/\\/\\.",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "°\\/\\/\\/\\/\\/~\\/\\/\\/\\/\\/°" });
      break;
    case 1:
      rahmen = ({ "+---------------------+",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "+---------------------+" });
      break;
    case 2:
      rahmen = ({ "/---------------------\\",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "\\---------------------/" });
      break;
    case 3:
      rahmen = ({ "/+++++++++++++++++++++\\",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "\\+++++++++++++++++++++/" });
      break;
    case 4:
      rahmen = ({ "+++++++++++++++++++++++",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+                     +",
                  "+++++++++++++++++++++++" });
      break;
    case 5:
      rahmen = ({ " _____________________ ",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  "|                     |",
                  " ~~~~~~~~~~~~~~~~~~~~~ " });
      break;
    case 6:
      rahmen = ({ " _____________________ ",
                  "<                     >",
                  ">                     <",
                  "<                     >",
                  ">                     <",
                  "<                     >",
                  ">                     <",
                  "<                     >",
                  " ~~~~~~~~~~~~~~~~~~~~~ " });
      break;
  }
  bild=ob->show_einzel(nummer);
  lang=explode(bild,"\n");
  
  for(i=1;i<8;i++)
    rahmen[i][1..21]=lang[i-1];
  for(i=0;i<9;i++)
    newlang+=rahmen[i]+"\n";
  if (getuid(TP) == "verdandi" || getuid(TP) == "zordan")
    newlang+="\n(Bilderposition: "+nummer+")\n";
  SetProp(P_LONG, newlang);
}

int get_number() {
  if(file_name(PO) != QUESTMASTER &&
     file_name(PO)[0..32] != "/d/wueste/verdandi/friedhof/room/") {
    return 0;
  }
  return nummer;
}
