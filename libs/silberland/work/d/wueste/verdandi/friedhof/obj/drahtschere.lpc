
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Drahtschere");
  SetProp(P_LONG,
    "Diese Drahtschere hat wohl schon eine Menge durchgemacht. Sie ist schon "
    "ziemlich rostig und sehr alt. Aber es koennte reichen, um ein kleines "
    "Stueck Draht damit durchzuschneiden" );
  SetProp(P_NAME, "Drahtschere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "drahtschere","schere","\n_drahtschere" }));

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  
  AddCmd( ({ "schneid","schneide","trenne","trenn" }) , "schneidfkt" );
}

int schneidfkt(string str) {
  object env,ob;
  if(!MENV || !living(MENV) || !env=ENV(MENV)) {
    call_out("remove",0);
    return 0;
  }
  if(file_name(env) != "/d/wueste/verdandi/friedhof/room/room-c2") return 0;
  notify_fail("Was moechtest Du durchschneiden?\n");
  if(str != "drahtschlinge" && str != "schlinge" && 
     str != "drahtschlinge durch" && str != "schlinge durch" &&
     str != "draht" && str !="draht durch") return 0;
  if(!ob=present("\n_drahtschlinge",TP)) {
    write(BS(
      "Aber hier ist doch gar keine Drahtschlinge! Du bist so verwundert und "
      "laesst die Drahtschere fallen. Dabei geht sie leider kaputt!"));
    RemoveCmd( ({ "schneid","schneide","trenne","trenn" }) );
    call_out("remove",0);
    return 1;
  }
  write(BS(
    "Mit einem kraeftigen Ruck schneidest Du die Drahtschlinge durch. Leider "
    "geht Dir dabei die Drahtschere kaputt. Aber das ist Dir egal. Die Hauptsache "
    "ist, Du bist wieder FREI FREI FREI!!!"));
  say(BS(
    CAP_TPN+" nimmt eine kleine Drahtschere und befreit die rechte Hand aus "
    "der kleinen Drahtschlinge. Leider geht die Drahtschere dabei kaputt."));
  ob->remove();
  RemoveCmd( ({ "schneid","schneide","trenne","trenn" }) );
  call_out("remove",0);
  return 1;
}
