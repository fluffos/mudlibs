
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine blutverschmierte Feder");
  SetProp(P_LONG,
    "Die Feder gehoerte einst einem kahlkoepfigen Aasgeier." );
    
  SetProp(P_NAME, "Feder");
  SetProp(P_NAME_ADJ, "blutverschmiert");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "feder" }) );
  
  SetProp(P_MATERIAL, ([ MAT_FEATHER: 90, MAT_BLOOD: 10 ]) );
  SetProp(P_WEIGHT, 60);
  SetProp(P_VALUE, 50+random(80) );
}
