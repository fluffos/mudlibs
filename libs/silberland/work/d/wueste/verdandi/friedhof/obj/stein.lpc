
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Steinbrocken");
  SetProp(P_LONG,
    "Du hast einen kleinen Steinbrocken gefunden. Eigentlich ist er recht "
    "haesslich und er gefaellt Dir gar nicht mehr so. Waer da nicht dieser "
    "komische Gedanke in Dir, dass dieser Stein etwas Besonderes ist, "
    "wuerdest Du ihn sicher sofort wieder wegwerfen." );
  SetProp(P_INFO,BS(
    "Der Steinbrocken scheint etwas in sich zu verbergen. Vielleicht gelingt "
    "es Dir ja, sein Inneres zu erkunden? Ein kleiner Riss verraet Dir "
    "jedenfalls, dass sich ein weiterer Blick sicher lohnen wuerde!"));
  SetProp(P_NAME, "Steinbrocken");
  SetProp(P_GENDER, MALE);
  AddId( ({ "stein","brocken","steinbrocken","QUESTOBJ","QUESTITEM","inneres" }) );
  SetProp( P_NAME_ADJ, "klein" );
  AddAdjective( "kleiner" );
  
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 
    "Irgendwas sagt Dir, dass dieser Stein etwas Besonderes ist!\n");
  
  AddCmd ( "oeffne","oeffnefkt" );
  AddCmd ( ({ "brech","brich","breche",
              "zerbrech","zerbreche","zerbrich" }), "brichfkt" );
  AddCmd ( ({ "wirf","werf","werfe" }), "werffkt" );
}

int oeffnefkt(string str) {
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str != "stein" && str != "steinbrocken") return 0;
  write(BS(
    "Du versuchst den Stein zu oeffnen. Doch irgendwie musst Du schon "
    "ein wenig brutaler werden!"));
  say(BS(
    CAP_TPN+" zerrt an einem Steinbrocken herum."));
  return 1;
}

int brichfkt(string str) {
  notify_fail("Was moechtest Du aufbrechen?\n");
  if(str != "stein" && str != "steinbrocken" &&
     str != "stein auf" && str != "steinbrocken auf" ) return 0;
  write(BS(
    "Du versuchst den Stein mit aller Gewalt aufzubrechen. Doch auch so "
    "gelingt es Dir leider nicht. Fast willst Du ihn schon vor lauter "
    "Wut auf den Boden werfen, aber ob das so eine gute Idee ist?"));
  say(BS(
    CAP_TPN+" zerrt an einem Steinbrocken herum."));
  return 1;
}

int werffkt(string str) {
  if(str == "stein" || str == "steinbrocken" ||
     str == "brocken" || str == "stein weg" || 
     str == "steinbrocken weg" || str == "brocken weg") {
    write(BS("Wohin moechtest Du den Stein werfen?\n"));
    return 1;

  }
  notify_fail("Was moechtest Du wohin werfen?\n");
  if(!str) return 0;
  if(strstr(str,"auf boden") == -1) return 0;
  if(strstr(str,"stein") == -1 &&
     strstr(str,"steinbrocken") == -1 &&
     strstr(str,"brocken") == -1) return 0;
  if(strstr(str,"gewalt") == -1) {
    write(BS("HAERTER!!! MIT MEHR GEWALT!!!\n"));
    return 1;
  }
  write(BS(
    "Du holst tief Luft und senkst Deinen rechten Arm mit dem Stein in der "
    "Hand nach hinten. Dann bruellst Du los und laesst den Stein mit aller "
    "Gewalt, die Dir zur Verfuegung steht, auf den Boden knallen!!!"));
  say(BS(
    CAP_TPN+" nimmt einen Stein in die Hand und zerschmettert ihn unter "
    "lautem Gebruell auf dem Boden!"));
  write(BS(
    "HURRAAAA!! Der Stein zersplittert in tausend Stuecke!"));
  write(BS(
    "Jetzt kannst Du erkennen, was der Stein in sich verborgen hatte, "));
  if(!QUESTMASTER->stone_found(9)) {
    write(BS(
      "naemlich einen kleinen Edelstein! Froehlich nimmst Du ihn an Dich."));
    catch("/obj/gemmaster"->DistributeGem(1, 0, 1, TP));
  } else {
    write(BS(
      "naemlich ein Steinplaettchen, welches Du gleich in Deinen Taschen "
      "verschwinden laesst!"));
  }
  RemoveCmd( ({ "wirf","werf","werfe" }) );
  call_out("remove",0);
  return 1;
}
