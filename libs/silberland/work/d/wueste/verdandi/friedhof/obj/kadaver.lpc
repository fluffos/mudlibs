
#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

nosave int haltbar;

create() {
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kadaver");
  SetProp(P_LONG,
    "Diesen Kadaver hatte ein Aasgeier bei sich. Er ist schon recht zerfetzt von den "
    "Krallen und dem Schnabel des Aasgeiers. Welches Tier das einmal war, kannst Du jetzt "
    "nicht mehr erkennen, dafuer ist es schon zu sehr verstuemmelt." );
    
  SetProp(P_NAME, "Kadaver");
  SetProp(P_INFO, BS(
    "Wenn Du mutig genug bist, koenntest Du versuchen, ihn zu essen..."));
  SetProp(P_GENDER, MALE);
  AddId( ({ "kadaver" }) );

  SetProp(P_FOOD_INFO, ([
    F_HEAL: ({ 25,25 }),
    F_SOAK: 12,
    F_MSG:
      "Du legst alle Ekelgefuehle ab und wuergst den Kadaver schnell hinunter.",
    F_MSG_ROOM: 
      "wuergt einen kleinen Kadaver schnell hinunter.",
    F_VERB:
      "essen"
  ]) );
  
  SetProp(P_MATERIAL, ([ MAT_FLESH: 70, MAT_SKIN: 10, MAT_BONE: 10, MAT_PELT: 10 ]) );
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 80);
  
  haltbar=10;
}

reset() {
  ::reset();
  if(!is_clone(TO)) return;
  haltbar--;
  if(haltbar>0) return;
  if(MENV)
    tell_object(MENV,BS(
      "Der Kadaver loest sich in einer kleinen Verwesungswolke auf."));
  call_out("remove",0);
}

