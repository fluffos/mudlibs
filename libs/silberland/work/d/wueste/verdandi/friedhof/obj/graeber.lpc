
#include "../def.h"

#include <properties.h>
#include <combat.h>

#define GRABLOG "/d/wueste/verdandi/friedhof/obj/graeber"

mapping graeber=([ ]);

create() {
  int i;
  
  if (is_clone(TO)) {
    destruct(TO);
    return 1;
  }
  SUID;
  graeber=([ ]);
  if (!restore_object(GRABLOG)) {
    for(i=1;i<11;i++) {
      graeber+=([ i: "  1. Jan 1111";"Niemand";"Niemanden";0;0 ]); 
      // Datum, Name, Killer, Level, XP
    }
  }
}

void NeuesGrab(object vic, object kill, int xp) {
  int i;
  
  for(i=1;i<10;i++) {
    graeber[i,0]=graeber[i+1,0];
    graeber[i,1]=graeber[i+1,1];
    graeber[i,2]=graeber[i+1,2];
    graeber[i,3]=graeber[i+1,3];
    graeber[i,4]=graeber[i+1,4];
  }
  graeber[10,0]=explode(dtime(time()),",")[1]||"  1. Jan 1111";
  graeber[10,1]=CAP(getuid(vic))||"Niemand";
  graeber[10,3]=vic->QueryProp(P_LEVEL)||0;
  graeber[10,4]=xp||0;
  graeber[10,2]="Niemanden";
//  tell_object(find_player("zordan"),sprintf(
//    "%O %O %O %O %O\n",kill,vic,ENV(kill),ENV(vic),vic->QueryProp(P_LAST_DAMTYPES)[0]));
  if((objectp(kill)) && (living(kill))) {
    graeber[10,2]=kill->name(WEN,0)||"Niemanden";
  } else {
    if(vic->QueryProp(P_LAST_DAMTYPES)[0] == DT_POISON )
      graeber[10,2]="Gift";
    if(vic->QueryProp(P_LAST_DAMTYPES)[0] == DT_COLD )
      graeber[10,2]="Kaelte";
    if(vic->QueryProp(P_LAST_DAMTYPES)[0] == DT_FIRE )
      graeber[10,2]="Hitze";
  }
  save_object(GRABLOG);
}

string ShowGraeber() {
  string aus;
  int i;
  
  aus ="Direkt neben Deinen Fuessen siehst Du jetzt einige Grabsteine.\n";
  aus+="Andaechtig versuchst Du die Namen auf den Grabsteinen zu\n";
  aus+="entziffern, was Dir nicht bei allen Graebern leichfaellt, da\n";
  aus+="die Witterung manchen Grabsteinen schon hart zugesetzt hat.\n";
  aus+="Trotzdem kannst Du folgendes ablesen...\n";
  aus+="\n"; 
  aus+="----------------------------------------------------------------------------\n";
  aus+=" Datum:        Name:         Level:  XP:       Gestorben durch:\n";
  aus+="----------------------------------------------------------------------------\n";
  for(i=1;i<11;i++) {
    aus+=sprintf("%s  %-15s %2d %11d  %-30s\n",
      graeber[i,0], graeber[i,1], graeber[i,3], graeber[i,4], graeber[i,2]);
  }
  aus+="----------------------------------------------------------------------------\n";
  return aus;
}

remove() {
  save_object(GRABLOG);
  destruct(TO);
  return 1;
}
