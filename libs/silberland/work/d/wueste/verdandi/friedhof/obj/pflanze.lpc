
#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

create() {
  int gr;
  string *str;
  
  if (!is_clone(TO)) return;
  ::create( ({ "verzehr","verzehre" }) );

  SetProp(P_SHORT, "Ein Wuestengrasbueschel");
  SetProp(P_LONG,
    "Das Aussehen des Wuestengrasbueschels erregt irgendwie Dein Mitleid, "
    "denn es ist ganz duerr und vertrocknet. Moeglicherweise war es "
    "irgendwann sogar einmal gruen, aber jetzt ist es durch die Hitze "
    "am Elefantenfriedhof so ausgetrocknet, dass es nur noch braun aussieht." );
  SetProp(P_NAME, "Wuestengrasbueschel");
  SetProp(P_INFO, BS(
    "Manche behaupten, man koenne das Wuestengrasbueschel sogar verzehren..."));
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "wuestengrasbueschel","bueschel","gras","grasbueschel" }) );

  SetProp(P_FOOD_INFO, ([
    F_HEAL: ({ 30,-10 }),
    F_SOAK: 5,
    F_POISON: -1,
    F_MSG:
      "Du wuergst das Wuestengrasbueschel hinunter. Eigentlich schmeckt "
      "es gar nicht so schlecht wie erwartet. Vor allem fuehlst Du Dich aber "
      "sogar viel besser!",
    F_MSG_ROOM: 
      "wuergt ein vertrocknetes Gras hinunter.",
    F_VERB:
      "verzehren"
  ]) );
  
  SetProp(P_MATERIAL, MAT_MISC_HERBAL );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
}
