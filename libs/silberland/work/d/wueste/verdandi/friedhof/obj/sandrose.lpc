
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  int gr;
  string *str;
  
  if (!is_clone(TO)) return;
  ::create();

  gr=random(7);
  str=({ "winzig","sehr klein","klein","mittelgross","gross",
         "sehr gross","riesig" });
  
  SetProp(P_SHORT, "Eine "+str[gr]+"e Sandrose");
  SetProp(P_LONG,
    "Du siehst eine "+str[gr]+"e Sandrose. Da sie voellig aus "
    "Sand besteht, greift sie sich rauh und trocken an. Rund "
    "und zackig zugleich weist sie auch einige Stellen auf, an "
    "denen sie im Licht wunderschoen schimmert." );
    
  SetProp(P_NAME, "Sandrose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "sandrose","rose" }) );
  SetProp( P_NAME_ADJ, str[gr] );
  AddAdjective( str[gr] );
  
  SetProp(P_MATERIAL, MAT_SAND );
  SetProp(P_WEIGHT, 200+gr*200+random(50));
  SetProp(P_VALUE, 100+gr*100+random(50));
  SetProp(P_NOBUY, 1);
}
