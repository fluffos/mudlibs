
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId("\n_drahtschlinge");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE,  0);
  SetProp(P_NOBUY,  1);
  SetProp(P_NODROP, 1);
}

string extra_look() {
  object player;
  if(!MENV || !player=MENV) return "";
  if(player->QueryProp(P_GENDER)==FEMALE)
    return "Sie ist mit ihrer rechten Hand in einer Drahtschlinge gefangen.\n";
  else 
    return "Er ist mit seiner rechten Hand in einer Drahtschlinge gefangen.\n";
}
