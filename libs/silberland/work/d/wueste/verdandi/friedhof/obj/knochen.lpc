
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  int gr,wer;
  string *str,*was;
  
  if (!is_clone(TO)) return;
  ::create();

  gr=random(4);
  str=({ "klein","mittelgross","gross","sehr gross" });
  was=({ "einem Gnu","einem Elefanten","einer Gazelle","einem Zebra",
         "einem Hobbit","einer Fee","einem Troll","einem Menschen",
         "einem Zwerg","einer Schildkroete","einem Kaefer",
         "einem Vogel","einem Bueffel","einer Eidechse",
         "einem Schakal","einer Hyaene" });
  
  wer=random(sizeof(was));
  
  SetProp(P_SHORT, "Ein "+str[gr]+"er Knochen");
  SetProp(P_LONG,
    "Es handelt sich dabei um einen "+str[gr]+"en Knochen "
    "von "+was[wer]+". Er sieht eigentlich recht appetitlich "
    "aus, denn es haengt kein Fleisch mehr dran." );
  SetProp(P_NAME, "Knochen");
  SetProp(P_GENDER, MALE);
  AddId( ({ "knochen", "\n_knochen" }) );
  SetProp( P_NAME_ADJ, str[gr] );
  AddAdjective( str[gr] );
  
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_WEIGHT, 300+gr*300+random(50));
  SetProp(P_VALUE, 50+gr*50+random(50));
  SetProp(P_NOBUY, 1);
}
