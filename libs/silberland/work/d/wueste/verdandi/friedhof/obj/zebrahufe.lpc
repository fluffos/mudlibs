
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Zebrahufe");
  SetProp(P_LONG,
    "Du siehst ein Paar Zebrahufe. Etwas abgewetzt, voellig haesslich, "
    "fast wertlos und relativ nutzlos fuer Dich..." );
    
  SetProp(P_NAME, "Paar Zebrahufe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "zebrahufe", "hufe" }) );
  
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 650);
  SetProp(P_VALUE, 200);
}
