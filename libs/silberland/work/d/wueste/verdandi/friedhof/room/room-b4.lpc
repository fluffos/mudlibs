#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

int fleisch;
string *steine;
string *wasser;

create() {

  ::create();

  fleisch=3+random(2);
  steine = ({ });
  wasser = ({ });
  
  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "In der suedwestlichen Ecke des Friedhofes liegen nur mehr ein paar "
    "Knochen auf dem Boden herum. Der Friedhof ist im Westen und Sueden "
    "durch ein bergiges Steinmassiv abgegrenzt. Durch die hohen Berge im Nordwesten "
    "faellt sogar ein wenig Schatten auf Dein Haupt. Ein riesiger Elefantenkadaver "
    "breitet sich gigantisch vor Deinen Fuessen aus." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );


  AddDetail( ({ "ecke" }),
	"Du bist nun an der suedwestlichen Ecke des Elefantenfriedhofes angelangt.");

  AddDetail( ({ "friedhof", "elefantenfriedhof" }), QueryProp(P_INT_LONG) );
  
  AddDetail( ({ "knochen" }),
	"Nur vereinzelt liegen hier einige Knochen zwischen ein paar Steinen herum. "
        "Sie stammen bestimmt von den "
	"Elefanten und anderen Tieren, die hier gestorben sind.");
	
  AddDetail( ({ "boden" }),
	"Der Boden hat an dieser Stelle ein leichtes Gefaelle. Am tiefsten Punkt hat sich "
	"sogar ein bisschen Wasser gesammelt. Dir faellt ausserdem auf, dass hier weniger "
	"Knochen herumliegen als sonst ueberall.");
	
  AddDetail( ({ "steinmassiv", "massiv" }),
	"Das Steinmassiv ist ein Teil des Tibesti-Gebirges.");
	
  AddDetail( ({ "berge", "berg" }),
	"Rings um Dich ragen riesige Berge in den Himmel. Sie verdecken durch ihre Hoehe sogar "
	"die Sonne und spenden Dir etwas Schatten. Die schroffen Felswaende schauen bedrohlich auf "
	"Dich herab.");

  AddDetail( ({ "schatten" }),
	"Gluecklicherweise stehst Du jetzt einmal fuer kurze Zeit im Schatten. Dein Kopf haette "
	"in dieser Hitze sicher bald zu gluehen begonnen.");
	
  AddDetail( ({ "haupt", "kopf" }),
	"Der Schatten tut Deinem Kopf sehr gut. Schoen langsam kannst Du auch wieder klar denken.");
	
  AddDetail( ({ "elefantenkadaver", "kadaver" }),
	"Der Elefantenkadaver ist riesig und scheint noch nicht allzu verdorben zu sein. "
	"Die Haut ist an manchen Stellen bereits aufgerissen und laesst die spitzen Rippen "
	"hervorstehen.");
	
  AddDetail( ({ "haut" }),
    "Die spitzen Rippen haben die Haut des toten Elefanten durchstochen.");
    
  AddDetail( ({ "stellen" }),
    "Durch die Hitze hat sich der Kadaver aufgeblaeht und ist dabei an einigen Stellen "
    "aufgerissen.");
    
  AddDetail( ({ "rippen" }),
    "An den Rippen haengt noch viel Fleisch dran.");
    
  AddDetail( ({ "gebirge", "tibestigebirge", "tibesti-gebirge", "tibesti" }),
    "Das Tibesti-Gebirge grenzt im Sueden an den Elefantenfriedhof und erstreckt sich bis "
    "in den Nordwesten.");
	
  AddDetail( ({ "fuesse", "fuss" }),
	"Vor Deinen Fuessen liegt ein riesengrosser Elefantenkadaver.");
	
  AddDetail( ({ "himmel" }),
	"Von hier aus siehst Du nur das strahlende Blau des Himmels. Die Sonne kannst Du nicht "
	"erkennen.");
	
  AddDetail( ({ "elefanten" }),
	"An und fuer sich ist das hier die Sterbestaette fuer Elefanten. Allerdings haben auch "
	"viele andere Lebewesen hier ihr Leben bereits ausgehaucht.");
	
  AddDetail( ({ "tiere" }),
	"Hier kreuchen und fleuchen etliche Tiere herum. Viele jedoch kreuchen und fleuchen "
	"nicht mehr und liegen als Knochen verstreut auf dem Boden.");
	
  AddDetail( ({ "stelle" }),
	"An dieser Stelle ist der Boden leicht abfallend und bildet dadurch eine kleine Senke.");
	
  AddDetail( ({ "gefaelle" }),
	"Durch das leichte Gefaelle hat sich hier noch etwas Wasser sammeln koennen.");
	
  AddDetail( ({ "punkt" }),
	"Hier ist der tiefste Punkt des Elefantenfriedhofes.");
	
  AddDetail( ({ "wasser", "regenwasser", "lacke" }),
	"Das Wasser stammt wohl vom letzten starken Regenguss.");
	
  AddDetail( ({ "senke" }),
	"In der kleinen Senke ist das Regenwasser zusammengelaufen und hat dort eine kleine "
	"Lacke gebildet.");
	
  AddDetail( ({ "regenguss", "guss" }),
	"Der ist leider schon vorbei...");
  
  AddDetail( ({ "sonne" }),
	"Die Sonne hat sich wohl hinter den hohen Bergen versteckt, bzw. die Berge haben sich vor "
	"sie geschoben. Egal, wie man es ausdrueckt; sie blendet Dich nicht, und darueber "
	"bist Du heilfroh.");
	
  AddDetail( ({ "hoehe" }),
	"Ein so langes Massband hast Du wohl nicht dabei, um die Hoehe der Berge abzumessen.");
	
  AddDetail( ({ "nase" }),
	"Du siehst sie zwar nicht, aber trotzdem weisst Du, dass sie da ist.");
	
  AddDetail( ({ "glueck" }),
	"Gibt es das ueberhaupt?");
	
  AddDetail( ({ "felswaende", "felsen" }),
	"Die Felswaende sind scharfkantig und schroff. Ausserdem sind sie viel zu hoch und "
	"steil, um sie zu erklettern. An einer Felswand kannst Du allerdings etwas erkennen.");
	
  AddDetail( ({ "felswand" }),
	"Hm, komisch.... die Felsen sind sonst ganz normal grau, nur hier erkennst Du auch "
	"andere Farben.");
	
  AddDetail( ({ "farben", "gelb", "gruen", "schwarz" }),
	"Gelb-gruen-schwarz wuerde hier wohl am besten passen.");
	
  AddDetail( ({ "gelb-gruen-schwarz", "gelbgruenschwarz" }),
	"Du begutachtest den Farbfleck genauer und stellst enttaeuscht fest, dass es nur eine "
	"gewoehnliche Flechte ist.");
	
  AddDetail( ({ "farbfleck", "flechte" }),
	"Tja, schade. War wohl echt nur eine normale Flechte, wie sie oft an Felsen zu finden "
	"sind. Echt bloed! Du warst Dir schon so sicher, dass Du Dir jetzt einen dicken "
	"Forscherpunkt verdient hast... Wieder nix. :(");
	
  AddDetail( ({ "blau" }),
	"Der Himmel ist wunderschoen blau.");
	
  AddDetail( ({ "sterbestaette", "ruhestaette" }),
	"Der Friedhof ist die letzte Ruhestaette fuer die Elefanten. Hier kommen sie her, "
	"wenn sie merken, dass sich ihr Leben dem Ende zuneigt.");
	
  AddDetail( ({ "leben" }),
	"Du denkst kurz ueber Dein Leben nach und freust Dich, dass es bisher gar nicht so "
	"mies war, wie Du oft dachtest.");
	
  AddDetail( ({ "ende" }),
	"Dein Ende ist noch nicht in Sicht.");
	
  AddDetail( ({ "forscherpunkt" }),
	"Leider war das keiner...\n"
	"Naja, vielleicht ja doch. Wer weiss das schon so genau?");
	
  AddDetail( ({ "lebewesen" }),
	"_Noch_ lebst Du. Also zaehlst Du _noch_ zu den Lebewesen. ;)");
	
  AddDetail( ({ "hitze" }),
	"So drueckend heiss wie in vielen anderen Teilen des Friedhofes ist es hier zum Glueck "
	"nicht. Daran koennten durchaus die hohen Berge schuld sein.");
	
  AddDetail( ({ "zeit" }),
	"Du hast nichts allzu Wichtiges vor, also verweilst Du ein bisschen im Schatten, um Dich "
	"abzukuehlen.");
	

  AddSpecialDetail( ({ "fleisch" }) , "fleischfkt");
  
  AddSpecialDetail( "steine" , "steinefkt" );
  
  AddSpecialDetail( "stein" , "steinfkt" );

  AddSound( DEFAULT_SOUND,
	"Absolute Stille. Fast schon bedrohlich leise.");


  AddSmell( DEFAULT_SMELL,
	"Der Geruch des Kadavers steigt Dir in die Nase.");
	
  AddSmell( ({ "kadaver", "geruch" }),
    "Du bist Dir nicht ganz sicher, ob das Fleisch noch geniessbar ist.");
    
  AddSmell( ({ "fleisch" }),
    "Naja, Du kannst es ja einmal versuchen, dann weisst Du es.");


  AddItem( NPC "elefant", REFRESH_DESTRUCT );

  AddCmd( ({ "nag","nage" }), "nagefkt" );
  AddCmd( ({ "iss","ess","esse" }), "issfkt" );
  AddCmd( ({ "nimm","nehme","nehm" }), "nimmfkt" );
  AddCmd( ({ "trink","trinke" }), "trinkfkt" );
  
  AddExit( "norden",     "./room-b3" );
  AddExit( "nordwesten", "./room-a3" );
  AddExit( "nordosten",  "./room-c3" );
  AddExit( "osten",      "./room-c4" );

}

string fleischfkt(string str) {
  if(fleisch>0) {
    return BS(
      "Das Fleisch, das an den Rippen haengt, sieht eigentlich noch "
      "recht appetitlich aus, und Du koenntest Dir durchaus vorstellen, "
      "dass es Dich ein wenig staerken wuerde.");
  } else {
    return BS(
      "Das Fleisch an den Rippen ist bereits leicht gruenlich geworden und "
      "Du beschliesst daher, besser Deine Finger davon zu lassen.");
  }
}

int issfkt(string str) {
  notify_fail("Was moechtest Du essen?\n");
  if(str != "fleisch" && str != "kadaver") return 0;
  write(BS(
    "Du koenntest das Fleisch natuerlich versuchen zu essen. Allerdings "
    "macht es doch viel mehr Spass, wenn Du Dir klebrige Finger dabei "
    "holst, oder?"));
  return 1;
}

int nagefkt(string str) {
  notify_fail("Was moechtest Du abnagen?\n");
  if(str != "an rippen" && str != "rippen ab" && str != "rippen" &&
     str != "fleisch von rippen" && str != "fleisch von rippen ab" &&
     str != "fleisch ab" && str != "fleisch" && str != "an rippe" &&
     str != "rippe ab" && str != "fleisch von rippe" &&
     str != "fleisch von rippe ab" && str != "rippe" && str != "kadaver" &&
     str != "kadaver ab" && str != "fleisch von kadaver" &&
     str != "fleisch von kadaver ab" && str != "an kadaver") 
    return 0;
  fleisch--;
  if(fleisch >= 0) {
    write(BS(
      "Gierig brichst Du eine hervorstehende Rippe vom Kadaver ab und nagst "
      "genuesslich ein riesiges Fleischstueck herunter. Es schmeckt einfach "
      "koestlich, und Du fuehlst Dich viel besser als vorher."));
    say(BS(
      CAP_TPN+" bricht gierig eine hervorstehende Rippe vom Kadaver ab und faengt an, "
      "genuesslich daran herumzunagen."));
    TP->AddHp(45+random(11));
    TP->AddSP(25+random(11));
  } else {
    write(BS(
      "Gierig brichst Du eine Rippe ab und beginnst wie wild daran "
      "herumzunagen. Als Du feststellst, dass dieses Fleisch schon schlecht "
      "geworden ist, spuckst Du den Rest in Deinem Mund so schnell wie moeglich "
      "aus. Trotzdem ist Dir jetzt aber ziemlich uebel geworden."));
    say(BS(
      CAP_TPN+" bricht gierig eine Rippe ab und faengt stark an "
      "zu wuergen, als "+TP->QueryPronoun(WER)+" ein Stueck Fleisch "
      "davon herunterschluckt."));
    TP->AddHp(-(25+random(11)));
  }
  return 1;
}

reset() {
  ::reset();
  fleisch=3+random(2);
  steine = ({ });
  wasser = ({ });
}

string steinefkt() {
  if(member(steine,getuid(TP)) != -1)
    return BS(
      "Vereinzelt fallen Dir ein paar Steine zwischen den Knochen auf."); 
  return BS(
    "Vereinzelt fallen Dir ein paar Steine auf. Einer interessiert Dich "
    "sogar besonders!");  
}

steinfkt() {
  if(member(steine,getuid(TP)) != -1) return 0;
  return BS(
    "Der Stein erweckt Dein Interesse ganz besonders. Am allerliebsten "
    "wuerdest Du ihn sogar mitnehmen.");
}

int nimmfkt(string str) {
  object ob;
  
  if(member(steine,getuid(TP)) != -1) return 0;
  notify_fail("Was moechtest Du nehmen?\n");
  if(str != "stein" && str != "stein mit") return 0;
  steine += ({ getuid(TP) });
  ob=clone_object( OBJ "stein" );
  ob->move(TP,M_NOCHECK);
  write(BS(
    "Du nimmst den Stein an Dich."));
  say(BS(
    CAP_TPN+" nimmt einen Stein vom Boden auf."));
  return 1;
}

int trinkfkt(string str) {
  notify_fail("Was moechtest Du trinken?\n");
  if(str != "wasser") return 0;
  
  if(TP->QueryProp(P_ALIGN) > 0) {
    write(BS(
      "Du moechtest gerade ein wenig von dem erfrischenden Wasser trinken, als "
      "Deine gute Seele Dich davon abhaelt und Dir sagt, dass die Tiere es "
      "viel noetiger haben."));
    return 1;
  }
  write(BS(
    "Du bueckst Dich zum Wasser und trinkst den armen Tieren das Wasser weg. "
    "Das ist zwar ziemlich boese, aber Du fuehlst Dich ein wenig erfrischt."));
  if(member(wasser,getuid(TP)) == -1) TP->AddHp(10+random(10));
  wasser += ({ getuid(TP) });
  say(BS(
    CAP_TPN+" bueckt sich und trinkt ein wenig Wasser."));
  return 1;
}

