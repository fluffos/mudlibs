#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define AASGEIER NPC "aasgeier"

int cloned;
int edelstein;

create() { 

	::create();
	

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof");
  SetProp( P_INT_LONG,
		"Du stehst hier am noerdlichen Rand des Elefantenfriedhofes. Auf dem Boden "
		"liegen unzaehlige Knochen, und nur ab und zu sind kleine Pflaenzchen "
		"dazwischen zu sehen. Der alte knorrige Baum hinter Dir sieht schon sehr "
		"mitgenommen aus. Du vermutest, dass die Elefanten daran nicht ganz unschuldig "
		"sind.");
	
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 28+random(5), 
							ENV_TERRAIN: TT_DESERT]) );
                           

  AddDetail( "rand",
  		"Poetischer ausgedrueckt wuerde es so heissen: Du stehst hier an der noerdlichen "
  		"Peripherie des Elefantenfriedhofes...");
  		  		
  AddDetail( "peripherie",
  		"Naja, der Rand eben.");
  		
  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
  		"Hier kommen die Elefanten her, um zu sterben. Wenn sie merken, dass ihre Zeit "
  		"zu gehen gekommen ist, machen sie den weiten Weg hierher, um an diesem Ort "
  		"die letzte Ruhe zu finden. Die Stimmung auf dem Friedhof ist auch dementsprechend "
  		"bedrueckend.");
  		
  AddDetail( "weg",
  		"Der weite Weg fuehrt sie wohl durch die Wueste.");
  		
  AddDetail( "wueste",
  		"Sand, Sand, Sand, Sand,... viel Sand...");
  
  AddDetail( "sand",
  		"Die Wueste ist voll damit.");
  		
  AddDetail( "ort",
  		"Damit ist der Friedhof gemeint.");
  		
  AddDetail( "stimmung",
  		"Hier liegt noch richtig der Tod in der Luft, und das verursacht in Dir ein "
  		"beklemmendes Gefuehl.");
  		
  AddDetail( "tod",
  		"Wenn Du nicht aufpasst, kann es Dir hier genauso ergehen wie den armen "
  		"Elefanten, deren Zeit bereits abgelaufen ist.");
  			
  AddDetail( "zeit",
  		"Gib mal 'zeit' ein. ;)");	
  		
  AddDetail( "luft",
  		"Die Luft ist hier sehr heiss und trocken.");
  		
  AddDetail( "gefuehl",
  		"Du fuehlst, dass hier der Tod in der Luft liegt. Hoffentlich ist es nicht Dein "
  		"eigener, den Du da spuerst.");

  AddDetail( "boden",
  		"Der Boden ist gaenzlich mit Knochen bedeckt. Wenn Du genau schaust, kannst "
  		"Du aber auch kleine Pflaenzchen erkennen.");
  
  AddDetail( ({ "knochen", "elefantenknochen" }),
  		"Es liegen hier so viele herum, dass Du niemals auf die Idee kommen wuerdest "
  		"sie alle zu zaehlen.");	
  		
  AddDetail( ({ "pflaenzchen", "pflanzen" }),
  		"Ziemlich vertrocknet sehen die alle aus. Ist aber auch kein Wunder, hier "
  		"regnet es schliesslich nicht oft. Zwischen den vertrockneten Pflaenzchen "
  		"liegt ein kleiner Stein.");

  AddDetail( "stein",
  		"Der kleine Stein sieht irgendwie seltsam aus. Vielleicht kannst Du ja "
  		"auf seiner anderen Seite mehr erkennen?");

  AddDetail( "seite",
  		"Wie koenntest Du nur an die andere Seite des Steines kommen?");
  		
  AddDetail( "wunder",
  		"Hast Du schon mal eins gesehen?");
  		
  AddDetail( "regen",
  		"Du schaust zum Himmel hinauf, kannst aber keine Regenwolken erkennen. Dabei waere "
  		"jetzt eine kleine Abkuehlung genau das richtige fuer Dich.");
  		
  AddDetail( "abkuehlung",
  		"Aus der wird wohl heute nix, dafuer ist der Himmel zu strahlend blau."); 
  		
  AddDetail( "baum",
  		"Diesem Baum haben die Elefanten schon hart zugesetzt. Die Rinde auf dem Stamm ist "
  		"ziemlich abgerieben. Woran das bloss liegen koennte?");
  		
  AddDetail( "stamm",
  		"Du hast die Elefanten stark im Verdacht, dass sie sich am Stamm reiben, wenn es "
  		"sie irgendwo juckt. Zumindest ist das die einzige Erklaerung, die Du dafuer hast.");
  		
  AddDetail( "rinde",
  		"Die Rinde ist schon sehr abgerieben.");
  		
  AddDetail( "erklaerung",
  		"Du hast doch schon eine Erklaerung dafuer. Wozu also noch eine?");
  				
  AddDetail( "verdacht",
  		"Sowas kann man doch nicht sehen...");
  			
  AddDetail( ({ "idee", "ideen" }),
  		"Hin und wieder hat jeder einmal gute und dann wieder weniger gute Ideen. "
  		"Ob es eine gute Idee ist, hier weiter zu forschen? Das musst Du schon selbst "
  		"wissen..."); 
  		
  AddDetail( ({ "ast", "aeste" }),
		"Die Aeste sind recht morsch und verkrueppelt und haben nicht einmal Blaetter. "
		"Auf den ersten Blick faellt Dir zunaechst gar nichts daran auf.");
			
  AddDetail( ({ "blaetter", "blatt" }),
  		"Du siehst nicht einmal ein einziges Blatt.");
			
  AddDetail( "blick",
  		"Erst auf den zweiten Blick kannst Du etwas erkennen.");
		
			
  AddSpecialDetail( "etwas","etwas" );
  		
				
  AddDetail( "himmel",
  		"Strahlend blau erstreckt sich der Himmel ueber Dir. Nicht ein einziges "
  		"Woelkchen ist hier zu sehen.");
  			
  AddDetail( ({ "woelkchen", "wolke", "wolken", "regenwolken", "regenwolke" }),
  		"Es gibt hier wirklich keine. Dafuer ist das Wetter einfach zu schoen.");
  				
  AddDetail( ({ "wetter", "prachtwetter" }),
  		"Heute herrscht wirklich ein Prachtwetter.");

  AddDetail( "sonne",
  		"Sie scheint heute wieder einmal sehr grell.");
 			
  AddDetail( ({ "elefant", "elefanten" }),
  		"Zur Zeit ist gerade keiner da. Falls Du hier einmal einen sehen solltest, dann ist "
  		"es bestimmt ein alter, der auf diesen Friedhof kommt, um in Ruhe zu sterben.");
  				
  AddDetail( "ruhe",
  		"Vielleicht kannst Du sie hoeren, wenn Du ganz still bist.");
  				
  AddDetail( "hitze",
  		"Die kannst Du zwar nicht sehen, aber trotzdem ist sie da. Und davon nicht gerade "
  		"wenig.");
  			
  AddDetail( ({ "luftspiegelung", "luftspiegelungen" }),
  		"Aufgrund der Hitze beginnt die Luft direkt zu flimmern.");

  AddSound( DEFAULT_SOUND,
		"Eigentlich ist es hier recht still. Nur ab und zu hoerst Du ein leises "
		"Knacken.");
		
  AddSound( "knacken",
  		"Dieses Knacken kommt wahrscheinlich von den Aesten, die sich leicht im Winde "
  		"bewegen.");
  		
  AddSound( "aeste",
  		"Ja, richtig. Da die Aeste von der Hitze so trocken sind, knacken sie leise "
  		"vor sich hin.");
  		
  AddSound( ({ "wind", "winde" }),
  		"Ganz leise kannst Du jetzt ein Saeuseln wahrnehmen, das Dir vorhin gar nicht "
  		"aufgefallen ist.");
  		 		
  AddSound( "saeuseln",
  		"Ja, das ist zweifelsohne der Wind. Dessen bist Du Dir ganz sicher.");
  				
  AddSound( "ruhe",
  		"Du strengst Dich zwar tierisch an, die Ruhe zu hoeren, hundertprozentig still ist "
  		"es hier aber dennoch nicht.");

  AddSmell( DEFAULT_SMELL,
		"Hier riecht es nach verwestem Fleisch. Kein Wunder eigentlich, wenn "
		"Du bedenkst, wo Du Dich gerade befindest.");
			
  AddSmell( "fleisch",
  		"Pfui, der Gestank ist echt bestialisch! Igitt!");
  				
  AddSmell( "gestank",
  		"Die vielen Kadaver hier auf dem Friedhof verbreiten einen enormen Gestank. "
  		"Am liebsten wuerdest Du schnell wegrennen, um wieder frische Luft einatmen "
  		"zu koennen.");
  				
  AddSmell( ({ "luft", "friedhofsluft", "friedhofluft" }),
  		"Die Friedhofsluft ist wirklich alles andere als gut.");
  			
  AddSmell( "kadaver",
  		"Du willst da gar nicht so genau hinriechen, glaub's mir.");
  				
  AddSmell( "tod",
  		"Hoffe lieber, dass es nicht Dein Tod ist, den Du riechst...");

  AddCmd ( ({ "dreh","drehe" }), "drehfkt" );

  AddExit( "sueden",     "./room-b2" );
  AddExit( "suedwesten", "./room-a2" );
  AddExit( "suedosten",  "./room-c2" );
  AddExit( "osten",      "./room-c1" );

  cloned = 0;
  edelstein=2+random(2);
}

reset()  { 
  if (!present("aasgeier")) cloned = 0; 
  ::reset();
  edelstein=2+random(2);
}

etwas()  { 
  if (cloned) { 
    if (present ("aasgeier")) 
      return BS("Auf dem Ast ist der Aasgeier gesessen, den Du vorhin durch seine gute "
      		  "Tarnung nicht gleich sehen konntest."); 
    else 
      return BS("Du schaust genauer hin, musst aber leider feststellen, dass Du Dich "
      	"getaeuscht hast. Wahrscheinlich waren das nur die Luftspiegelungen "
        "wegen der Hitze.");
  } else { 
    write(BS("Als Du genauer hinsiehst, entdeckst Du einen haesslichen Aasgeier auf einem "
      	"der Aeste. Du versuchst so leise wie moeglich zu sein, um ihn nicht aufzuscheuchen, "
      	"aber Du warst anscheinend jetzt doch zu laut...")); 
    clone_object (AASGEIER)->move(ME, M_NOCHECK | M_NO_ATTACK); 
    cloned = 1; 
  } 
  return ""; 
}

int drehfkt(string str) {
  notify_fail("Was moechtest Du drehen?\n");
  if(!str) return 0;

  if(str=="stein") {
    write(BS("Moechtest Du den Stein vielleicht umdrehen?\n"));
    return 1;
  }
  
  notify_fail("Was moechtest Du drehen?\n");
  if(str!="stein um") return 0;

  if(QUESTMASTER->stone_found(4)) {
    write(BS(
      "Du drehst den kleinen Stein herum und entdeckst zu Deinem Erstaunen "
      "ein Steinplaettchen. Du nimmst das Steinplaettchen an Dich und legst "
      "den Stein wieder an seine alte Stelle zurueck."));
  } else {
    if(edelstein>0) {
      write(BS(
        "Du drehst den kleinen Stein herum und findest auf einmal ein paar "
        "Edelsteine, die Du sofort in Deinem Inventar verschwinden laesst."));
      catch("/obj/gemmaster"->DistributeGem(edelstein, 0, 1, TP));
      edelstein=0;
    } else {
      write(BS(
        "Du drehst den kleinen Stein enttaeuscht um. Es befindet sich nichts "
        "ausser Sand unter ihm."));
    }
  }
  return 1;  
}
