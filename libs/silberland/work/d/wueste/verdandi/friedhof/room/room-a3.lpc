
#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

create() {
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Von hier aus kannst Du den Elefantenfriedhof in seiner ganzen Groesse "
    "ueberblicken. Im Sueden und Westen tuermen sich unueberwindbare "
    "Felsmassen auf, waehrend sich im Osten der Friedhof eben erstreckt. "
    "Ausser einem duerren Distelbusch sind sonst keine Pflanzen zu "
    "bemerken. Auf dem ausgetrockneten Boden liegen Knochen und "
    "Felsstueckchen verstreut herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );


  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
    "Du bleibst wie erstarrt stehen, als Du diesen Friedhof naeher "
    "betrachtest. Wo Du auch hinsiehst kannst Du den Tod sehen, der "
    "ueber dieses Gebiet herrscht. Grosse Knochen, kleine Knochen, "
    "hier liegt alles verstreut herum.");
    
  AddDetail( ({ "groesse" }),
    "Wie gross der Friedhof wirklich ist, kannst Du nur raten.");
    
  AddDetail( ({ "sueden" }),
    "Die Felsmassen im Sueden und Westen gehoeren zum Tibesti-Gebirge. "
    "Sie sind so hoch, dass ein Erklimmen unmoeglich ist.");

  AddDetail( ({ "westen" }),
    "Westlich und suedlich von Dir ragen schroffe Felsmassen in den Himmel. "
    "Ausserdem erkennst Du jetzt im Westen auch einen Hoehleneingang.");
    
  AddDetail( ({ "eingang", "hoehleneingang" }),
    "Der Eingang in die Hoehle sieht aus wie ein schwarzes Loch.");
    
  AddDetail( ({ "hoehle" }),
    "Die Hoehle befindet sich von Dir aus gesehen im Westen.");
    
  AddDetail( ({ "loch" }),
    "Du wirst doch wissen, was ein Loch ist...");
    
  AddDetail( ({ "felsmassen", "felsen", "felsformationen", "felsformation",
                "teile" }),
    "Diese gigantischen Felsformationen sind Teile des Tibesti-Gebirges. "
    "Sie sind so hoch, dass man sie nie ueberwinden koennte.");
    
  AddDetail( ({ "osten" }),
    "Richtung Osten kannst Du den gesamten Friedhof ueberblicken.");
    
  AddDetail( ({ "distelbusch", "busch" }),
    "Dieser Distelbusch ist die einzige Pflanze, die Du hier sehen kannst. "
    "Er scheint mit seinen duerren Zweigen die Felsen entlang zu kriechen. "
    "Feine Stacheln beschuetzen den Busch davor, gefressen zu werden.");
    
  AddDetail( ({ "pflanzen", "pflanze" }),
    "Ausser einem duerren Distelbusch ist hier keine Pflanze zu sehen.");
    
  AddDetail( ({ "boden" }),
    "Der Boden ist von der Sonne so ausgetrocknet, dass sich bereits Risse "
    "gebildet haben. Auf dem harten Untergrund liegen eine Menge Knochen "
    "und Felsstueckchen herum.");
    
  AddSpecialDetail( ({ "knochen" }), "knochenfkt");
    
  AddDetail( ({ "felsstueckchen", "stueckchen" }),
    "Die Felsstueckchen auf dem Boden sind bestimmt von den grossen Felsen "
    "abgesplittert. Pass bloss auf, dass sich kein grosses Felsstueck loest "
    "und Dir auf den Kopf faellt!");
    
  AddDetail( ({ "tod" }),
    "Der Tod schwebt knapp ueber Dir.");

  AddDetail( ({ "gebirge", "tibesti", "tibestigebirge", "tibesti-gebirge",
                "berg", "berge" }),
    "Das Tibesti-Gebirge umgibt den Friedhof im Sueden und Westen. "
    "Schroffe gigantisch hohe Felswaende schauen bedrohlich auf Dich herab.");

  AddDetail( ({ "zweige", "zweig" }),
    "Die duerren zarten Zweige wachsen ganz dicht am Felsen. Auf jedem Zweig "
    "sitzen unheimlich viele spitze Stacheln, denen Du am besten nicht zu "
    "nahe kommst.");

  AddDetail( ({ "stacheln", "stachel" }),
    "Eigentlich sehen die Stacheln gar nicht so gefaehrlich aus, da sie nur "
    "sehr klein sind. Du kannst Dir aber durchaus vorstellen, dass man sich "
    "daran wunderbar stechen kann.");
    
  AddDetail( ({ "risse", "riss" }),
    "Die Risse im Boden sind durch die Trockenheit und die Hitze "
    "entstanden.");

  AddDetail( ({ "untergrund" }),
    "Der Untergrund besteht aus hartgetrockneter Steinerde, die mit feinem "
    "Sand vermischt ist.");
    
  AddDetail( ({ "menge" }),
    "Du siehst auf dem Boden viele Knochen und Felsstueckchen herumliegen.");

  AddDetail( ({ "sand" }),
    "Feiner Sand aus der Wueste hat sich hier mit harter Erde vermischt und "
    "bildet einen harten Untergrund.");

  AddDetail( ({ "erde", "steinerde" }),
    "Sandfarbene Steinerde wurde durch die Witterung fest zusammengepresst "
    "und bildet mit dem Sand einen harten Untergrund.");

  AddDetail( ({ "felsstueck", "grosses felsstueck", "zustand" }),
    "Du siehst kurz hinauf und ueberpruefst den Zustand der Felsen. "
    "Deiner Meinung nach sehen die Felsen alle sehr stabil und festsitzend "
    "aus. Hoffentlich hast Du damit nicht unrecht!");

  AddDetail( ({ "stueck" }),
    "Was fuer ein Stueck denn?");

  AddDetail( ({ "meinung" }),
    "Wen interessiert hier Deine Meinung?!?");
    
  AddDetail( ({ "felswaende" }),
    "Die Felswaende sehen zu steil aus, um sie zu erklimmen.");

  AddDetail( ({ "waende" }),
    "Meinst Du die Felswaende? Andere sind hier naemlich nicht.");
    
  AddDetail( ({ "trockenheit", "hitze" }),
    "Anhand des Bodens kannst Du ahnen, dass der letzte Regenguss schon ewig "
    "her sein muss. Die Hitze und die Trockenheit haben schon ueberall ihre "
    "Spuren hinterlassen.");

  AddDetail( ({ "witterung", "witterungsbedingungen", "witterungsbedingung" }),
    "Die Witterung ist hier nicht zu unterschaetzen.");

  AddDetail( ({ "sonne", "ruecken" }),
    "Die Sonne scheint Dir mitten auf den Ruecken.");
    
  AddDetail( ({ "spuren" }),
    "Auf dem Boden hast Du einige Spuren hinterlassen.");
    
  AddDetail( ({ "tiere" }),
    "Viele Tiere sterben an den rauhen Witterungsbedingungen oder durch "
    "andere Tiere.");
    
  AddDetail( ({ "gebiet" }),
    "Ueber dieses Gebiet herrscht der Tod.");
    
  AddDetail( ({ "kopf" }),
    "Den kannst Du selbst nicht sehen. Dazu braeuchtest Du schon einen "
    "Spiegel.");
    
  AddDetail( ({ "spiegel" }),
    "So ein Pech, keiner da.");
    
  AddDetail( ({ "pech" }),
    "Eigentlich ist es kein Pech, dass Du keinen Spiegel hast. Sei lieber "
    "froh! ;)"); 
    
  AddDetail( ({ "regenguss", "regen" }),
    "Der letzte Regenguss muss schon laenger her sein.");
    
  AddDetail( ({ "wueste" }),
    "Wenn Du in die Wueste willst, musst Du Dich oestlich halten.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Saeuseln.");
    
  AddSound( ({ "saeuseln" }),
    "Das ist bestimmt der Wind, der in der Hoehle seine Runden dreht.");
    
  AddSound( ({ "wind" }),
    "Hier ist kein Wind, aber in der Hoehle weht ein leichter.");
    
  AddSound( ({ "hoehle" }),
    "Du hoerst ein leises Saeuseln.");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach nix.");
    
  AddSmell( ({ "nix" }),
    "Nix riecht nach gar nix.");

  AddSpecialDetail( "himmel" , "himmelfkt" );

  AddCmd( ({ "rat", "rate" }), "ratfkt" );
  AddCmd( ({ "erklimm", "erklimme" }), "erklimmfkt" );
  AddCmd( ({ "stich", "steche", "stech" }), "stechfkt" );
  
  AddExit( "norden",    "./room-a2" );
  AddExit( "suedosten", "./room-b4" ); 
  AddExit( "nordosten", "./room-b2" );
  AddExit( "osten",     "./room-b3" );
  AddExit( "westen",    "./berg-oben" );
}

string himmelfkt(string str) {
  if(QUESTMASTER->stone_found(2))
    return BS(
      "Die Sonne scheint heiss vom Himmel herunter. Gerade als Du mal wieder "
      "vertraeumt hinauf schaust, faellt Dir ein Steinplaettchen direkt in "
      "die Haende, welches Du wegen Deiner Neugier gleich behaeltst.");
  return BS(
    "Die Sonne scheint heiss vom Himmel herunter.");
}

int ratfkt(string str) {
	notify_fail( "Was willst Du raten?\n");
	if(str != "groesse") return 0;
	write(BS(
	  "Du schaetzt die Groesse des Friedhofes auf "+(1200+random(800))+
	  " Quadratmeter."));  
	return 1;
}

int erklimmfkt(string str) {
	notify_fail( "Was moechtest Du erklimmen?\n");
	if(str != "felsmassen" && str != "felswaende" &&
	    str != "felswand") return 0;
	write(BS(
	  "Vergiss es, Du kleiner Wurm! Die sind viel zu hoch fuer Dich!"));
	return 1;
}

string knochenfkt(string str) {
	string temp;
	
	temp=TP->QueryProp(P_RACE);
	if(temp=="Fee")
	  temp="einer "+temp;
	else
	  temp="einem "+temp;
	return BS(
	  "Unter Deinen Fuessen knirschen einige Knochen als Du darueber gehst. "
      "Sie alle stammen von verendeten Tieren oder aber auch von "+temp+" "
      "wie Dir.");
}

int stechfkt(string str) {
	notify_fail( "Woran moechtest Du Dich stechen?\n");
	if (str != "an stachel" && str != "an stacheln" &&
	     str != "am stachel") return 0;
	write(BS(
	  "Moechtest Du wirklich so dumm sein, und Dich absichtlich an einem "
	  "Stachel stechen?!?"));
	input_to("stechfkt2");
	return 1;
}

stechfkt2(string str) {
	if (str != "ja" && str != "nein") {
		write(BS(
		    "Bitte tippe 'ja' oder 'nein' ein."));
        input_to("stechfkt2");
        return;
    }
    if(str == "ja") {
    	write(BS(
    	    "Daemlich wie Du bist, greifst Du direkt in die Stacheln und "
    	    "verletzt Dich dabei leicht an der Hand. Du machst wohl jeden "
    	    "Bloedsinn, nur um an Forscherpunkte ranzukommen, hm?"));
    	TP->AddHp(-(5+random(10)));
    	domainshout(BS(
    		CAP_TPN+" ist so dumm und greift absichtlich in spitze Stacheln!!!"));
    	return;
    }
    write(BS(
      "Diese Entscheidung war sicher die bessere. So daemlich bist Du ja "
      "zum Glueck dann doch nicht! :)"));
    return;
}

