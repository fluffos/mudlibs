
#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
	"Fast waerst Du jetzt ueber einen kleinen Busch gestolpert, den Du beinahe "
    "uebersehen haettest. Du bist von der Hitze schon so lahm im Hirn, dass Du Dir nichts "
    "sehnlicher wuenschst, als bald ein Plaetzchen zu erreichen, an dem Du Dich abkuehlen "
    "kannst. Weit und breit siehst Du aber - ausser einem verkrueppelten Baum - nichts, das "
    "Dich auf Abkuehlung hoffen laesst. Die Sonne brennt dermassen stark vom Himmel, dass Dir "
    "sogar die auf dem Boden liegenden Knochen vor den Augen verschwimmen..." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "busch" }),
	"Ziemlich duerr und vertrocknet steht der kleine Busch vor Deinen Fuessen. Ein Schritt "
	"mehr und Du haettest ihn sicher aus dem Boden gerissen und waerst dabei wahrscheinlich "
	"ordentlich auf die Nase gefallen. Seine filigranen Zweige sind fast blattlos, und Du kannst Dir "
	"gar nicht vorstellen, wie ein so zartes Gewaechs in einer solchen Gegend ueberhaupt "
	"ueberleben kann.");

  AddDetail( ({ "hitze", "temperatur", "temperaturen" }),
	"Wenn Du ein Thermometer hast, kannst Du ja einmal nachschauen, wie heiss es hier wirklich "
	"ist. Deinem Gefuehl nach sind es sicher um die 100 Grad, aber in dieser Hitze vertraust "
	"Du selbst Deinen Gefuehlen nicht mehr so hundertprozentig.");
	
  AddDetail( ({ "hirn" }),
	"Es wird Dir bald ausrauchen bei diesen Temperaturen...");
	
  AddDetail( ({ "plaetzchen" }),
	"Du suchst und suchst, aber Du findest nur einen knorrigen Baum, der ein wenig Schatten "
	"spenden koennte.");
	
  AddDetail( ({ "baum" }),
	"Der steht weiter im Norden.");
	
  AddDetail( ({ "abkuehlung" }),
	"Eine kleine Abkuehlung waere jetzt echt angenehm...");
  
  AddDetail( ({ "sonne" }),
	"Wie ein riesiger Feuerball brennt sie vom Himmel herab.");
  
  AddDetail( ({ "himmel" }),
	"Du hast bisher selten einen so klaren Himmel gesehen.");
  
  AddDetail( ({ "boden" }),
	"Der sandige Boden ist auch hier mit vielen Knochen uebersaet, und nur vereinzelt ragen "
	"kleine Graeser dazwischen empor. ");
  
  AddDetail( ({ "knochen" }),
	"Die Knochen stammen wohl von den verendeten Tieren, die hier auf dem Friedhof ihr "
	"Leben lassen mussten. Es liegen jedoch so viele Knochen herum, dass Du nicht einmal "
	"schaetzen koenntest, wie viele es tatsaechlich sind.");
  
  AddDetail( ({ "augen" }),
	"Deine eigenen kannst Du ohne Spiegel eher schwer sehen.");
  
  AddDetail( ({ "fuesse" }),
	"Du schaust an Dir herab und bemerkst, dass noch alle beide da sind. Du atmest erleichtert "
	"auf.");
  
  AddDetail( ({ "schritt" }),
	"Wenn Du noch einen unachtsamen Schritt gemacht haettest, waerst Du bestimmt ueber den "
	"Busch gestolpert.");
  
  AddDetail( ({ "nase" }),
	"Wenn alles passt, sollte sie knapp unter den Augen sein.");
	
  AddDetail( ({ "zweige", "zweig" }),
	"Die Zweige des Busches sind sehr trocken und haben nur mehr wenige Blaetter dran.");
	
  AddDetail( ({ "blaetter" }),
	"Sie sind dunkelgruen und verlaufen zur Spitze hin sehr schmal; fast schon wie kleine Nadeln.");
	
  AddDetail( ({ "nadeln" }),
    "Diese Blaetter sehen echt wie kleine Nadeln aus. Du solltest besser nicht hingreifen, sonst "
    "stichst Du Dich womoeglich noch. Als Du genau schaust, sieht Du auf einmal etwas kleines Rotes "
    "dazwischen aufblitzen.");
    
  AddDetail( ({ "rotes", "rot" }),
    "Es scheint aus Stoff zu sein.");
    
  AddDetail( ({ "stoff" }),
    "Du ueberlegst, was das fuer ein roter Stoff sein koennte und auf einmal faellt Dir ein, dass die "
    "Berserker doch so ein Stirnband tragen, das dieselbe Farbe hat.");
    
  AddDetail( ({ "stirnband" }),
    "Da scheint irgendein Berserker mit seinem Stirnband haengengeblieben zu sein. Als Du das rote "
    "Stoffstueckchen genauer begutachtest, kannst Du einen eingestickten Buchstaben erkennen.");
    
  AddDetail( ({ "buchstabe", "buchstaben" }),
    "Der Buchstabe sieht aus wie ein V.");
    
  AddDetail( ({ "v" }),
    "V wie..... Verdandi!");
    
  AddDetail( ({ "gewaechs", "gewaechse", "pflanzen", "pflanze" }),
	"Viele Pflanzen siehst Du hier nicht. Dazu ist der Boden wohl zu unfruchtbar.");
	
  AddDetail( ({ "gegend", "lebensraum" }),
	"Diese Gegend ist sicher nicht der ideale Lebensraum fuer Dich.");
	
  AddDetail( ({ "gefuehl", "gefuehle" }),
	"Kann man so etwas sehen???");
	
  AddDetail( ({ "schatten" }),
	"Vielleicht spendet der Baum im Norden ein bisschen Schatten.");
	
  AddDetail( ({ "norden" }),
	"Dort siehst Du einen verkrueppelten Baum.");
	
  AddDetail( ({ "feuerball" }),
	"Die Sonne sieht aus wie ein riesiger Feuerball.");		
	
  AddDetail( ({ "sand" }),
	"Der Sand auf dem Boden stammt bestimmt aus der Wueste.");
	
  AddDetail( ({ "graeser" }),
	"Hin und wieder kannst Du braune, duerre Graeser zwischen den herumliegenden Knochen erkennen.");	
	
  AddDetail( ({ "tiere" }),
	"Viele Tiere, denen Du hier begegnen kannst, sind harmlos. Vor manch anderen solltest Du Dich "
	"jedoch besser in acht nehmen.");
	
  AddDetail( ({ "leben" }),
	"Auch Deines wird irgendwann vorbei sein. Vielleicht ja auch schon bald...");		
	
  AddDetail( ({ "friedhof", "elefantenfriedhof" }),
	"Der Friedhof ist nicht ganz so ausgestorben, wie man es von einem solchen erwarten koennte. "
	"Sowohl die Tiere als auch Du, laufen hier aber Gefahr, bald Futter fuer Raubtiere zu werden.");		
	
  AddDetail( ({ "berserker" }),
	"Blutruenstige, zerstoererische Wesen, die mit Aexten herumrennen, um alles und jeden in zwei "
	"Teile zu spalten.");		
	
  AddDetail( ({ "stoffstueckchen", "stoffstueck", "stueckchen" }),
	"Zwischen den nadelartigen Blaettern blitzt ein kleines, rotes Stueckchen Stoff hervor.");		
	
  AddDetail( ({ "wueste" }),
	"Halte Dich oestlich. So kommst Du am schnellsten in die Wueste. (Ups, war das jetzt "
	"Spielerhilfe? ;) )");		
		
  AddDetail( ({ "gefahr" }),
	"Die Gefahr lauert immer und ueberall.");
	
  AddDetail( ({ "futter", "tierfutter" }),
	"Willst Du echt als Tierfutter enden?");
	
  AddDetail( ({ "raubtiere" }),
	"Keine Sorge, Du begegnest ihnen schon noch...");
	
  AddDetail( ({ "sorge", "sorgen" }),
	"Du solltest Dir Sorgen um Dein Leben machen. Es kann schneller vorbei sein, als Du denkst.");
	
  AddDetail( ({ "nasenklammer" }),
	"Leider hast Du keine. Also musst Du den Geruch ertragen. ;)");
	
  AddDetail( ({ "farbe" }),
	"Es handelt sich hierbei um die rote Farbe.");
	
  AddDetail( ({ "spitze" }),
	"Autsch!");

  AddSpecialDetail( "verdandi","verdandifkt");
 
  AddSound( DEFAULT_SOUND,
	"Du hoerst ein leises Knirschen.");
	
  AddSound( ({ "knirschen", "geraeusch", "knochen" }),
    "Die Knochen auf dem Boden geben ein knirschendes Geraeusch von sich, als Du darueber gehst.");
  

  AddSmell( DEFAULT_SMELL,
	"Leichter Aasgeruch dringt an Deine Nase.");
	
  AddSmell( ({ "aasgeruch", "geruch", "aas" }),
    "Es stinkt wirklich abscheulich. Am liebsten wuerdest Du Dir eine Nasenklammer auf die Nase "
    "zwicken.");


  AddExit( "norden",     "./room-b1" );
  AddExit( "suedosten",  "./room-c3" );
  AddExit( "nordosten",  "./room-c1" );
  AddExit( "osten",      "./room-c2" );
  AddExit( "suedwesten", "./room-a3" );
  AddExit( "westen",     "./room-a2" );
  AddExit( "sueden",     "./room-b3" );

}

reset() {
  object ob;
  
  ::reset();
  if(random(100)<95) {
    if(ob=present("\n_knochen",ME)) {
      ob->remove();
      tell_room(ME,BS(
        "Du trittst aus Versehen auf den Knochen und er zersplittert in tausend Stuecke."));
    }
  } else {
    if(!present("\n_knochen")) {
      ob=clone_object( OBJ "knochen" );
      ob->move(ME,M_NOCHECK);
    }
  }
}

string verdandifkt(string str) {
  if(TP->FindPotion(BS("Wahrscheinlich war sie einmal hier und ist "
    "unvorsichtigerweise ueber den Busch gestolpert, und dabei blieb dann "
    "wohl ein Teil ihres blutroten Stirnbandes auf dem Zweig haengen... Doch "
    "was ist das? Verdandi scheint hier ein kleines glitzerndes Flaeschchen "
    "verloren zu haben! Neugierig greifst Du danach und trinkst es "
    "sofort mit einer gewissen Kennermiene aus."))) {
    write_file(LOG "zt",
      "["+dtime(time())+"] "+CAP(getuid(TP))+" findet den Zaubertrank.\n");
    return "";
  }
  else
    return BS(
      "Wahrscheinlich war sie einmal hier und ist unvorsichtigerweise "
      "ueber den Busch gestolpert, und dabei blieb dann wohl ein Teil "
      "ihres blutroten Stirnbandes auf dem Zweig haengen...");
}
