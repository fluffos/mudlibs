#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Du bist jetzt am oestlichsten Ende des Elefantenfriedhofes "
    "angekommen und siehst Dich erst einmal genauer um. Nach Osten fuehrt "
    "ein schmaler Weg leicht bergab zur offenen Wueste, waehrend sich Dir "
    "in der anderen Richtung ein Anblick bietet, der Dir den Atem stocken "
    "laesst. Ueberall siehst Du Spuren der Vernichtung und des Todes. "
    "Als Du ein wenig zur Seite trittst, stoesst Du Dich fuerchterlich an "
    "einem Felsen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(5), 
			   ENV_TERRAIN: TT_DESERT]) );

  SetProp(P_HIDE_EXITS, ({"osten"}) );

  
  AddDetail( ({ "ende" }),
    "Du stehst ganz im Osten des Friedhofes.");

  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
    "Der Elefantenfriedhof liegt westlich von Dir. Dahinter tuermt sich "
    "das Tibesti-Gebirge auf.");
    
  AddDetail( ({ "osten" }),
    "Nach Osten solltest Du gehen, wenn Du in die offene Wueste willst.");
    
  AddDetail( ({ "weg", "verbindungsweg", "verbindung" }),
    "Im Osten beginnt der Verbindungsweg zwischen dem Friedhof und der "
    "offenen Wueste. Da der Friedhof hoeher gelegen ist als die Wueste, "
    "neigt sich der Weg leicht zur Wueste hin.");

  AddDetail( ({ "wueste", "ort" }),
    "Die offene Wueste ist nicht gerade der ideale Ort zum Entspannen, "
    "aber es lohnt sich sicher, einmal dort hinzugehen. Ob die Wueste "
    "schon viele Opfer gefordert hat?");
    
  AddDetail( ({ "richtung" }),
    "Es gibt viele Richtungen, aber in diesem Fall war 'Westen' gemeint.");
    
  AddDetail( ({ "anblick" }),
    "Der Anblick ist grauenhaft. Der gesamte Friedhof gleicht einem "
    "Schlachtfeld.");

  AddDetail( ({ "atem", "atmen" }),
    "Du bist einfach zu ueberwaeltigt gewesen, dass Du ganz aufs Atmen "
    "vergessen hast.");
    
  AddDetail( ({ "spur", "spuren" }),
    "Egal wo Du hinsiehst, ueberall kannst Du die Spuren erkennen, welche "
    "die rauhen Lebensbedingungen hier hinterlassen haben.");
    
  AddDetail( ({ "vernichtung", "tod" }),
    "Ueber den gesamten Friedhof zieht sich eine Spur des Todes und der "
    "Vernichtung.");

  AddDetail( ({ "felsen", "fels", "felsblock", "block" }),
    "Neben Dir liegt ein relativ grosser Felsblock, der am oberen Teil "
    "ein wenig abgeflacht ist.");
    
  AddDetail( ({ "seite", "schritt" }),
    "Du machst einen kleinen Schritt zur Seite und haust Dir Dein "
    "Schienbein fuerchterlich an einem Felsen an.");
    
  AddDetail( ({ "himmel", "blau" }),
    "Der Himmel offenbart sein strahlendstes Blau, das durch die Sonne "
    "noch schoener betont wird.");

  AddDetail( ({ "opfer", "leben" }),
    "Sei vorsichtig, sonst bist Du womoeglich das erste Opfer, das in der "
    "Wueste sein Leben aushaucht!");
    
  AddDetail( ({ "westen" }),
    "Im Westen liegt der Friedhof.");
    
  AddDetail( ({ "tibesti", "tibesti-gebirge", "gebirge", "berg", "berge",
                "tibestigebirge" }),
    "Im Sueden und Westen wird der Friedhof von unheimlichen, hohen Bergen "
    "umgeben. Hinter dem Gebirge im Westen liegt die Steppe, im Sueden "
    "vermutest Du die offene Wueste.");

  AddDetail( ({ "boden" }),
    "Neben einigen Knochen ragt ein hoher Felsblock aus dem Boden.");
    
  AddDetail( ({ "steppe" }),
    "Die Steppe kannst Du von hier aus nicht sehen, weil das hohe Gebirge "
    "dazwischen liegt.");
    
  AddDetail( ({ "schienbein" }),
    "Du faengst fuerchterlich an zu fluchen und huepfst wie ein "
    "wildgewordener Kobold von einem Bein auf das andere.\n"
    "Du denkst . o O (Scheiss Felsen!!!)");

  AddDetail( ({ "kobold" }),
    "Sag mal, kommst Du Dir nicht ein wenig laecherlich vor, hier so "
    "herumzuspringen? Du solltest aufpassen, dass Dich niemand dabei "
    "gesehen hat, sonst werden Dich alle anderen auslachen!");
    
  AddDetail( ({ "bein" }),
    "Du springst wie ein Verrueckter von einem Bein auf das andere, als "
    "Du mit dem Schienbein gegen den Felsen stoesst.");
    
  AddDetail( ({ "verrueckter" }),
    "Der einzige Verrueckte bist Du hier! Oder siehst Du noch jemanden so "
    "peinlich herumspringen wie Dich?");

  AddDetail( ({ "schlachtfeld" }),
    "Dir wird wieder einmal bewusst, wie vergaenglich das Leben ist, als "
    "Du Dich hier genauer umsiehst.");
    
  AddDetail( ({ "lebensbedingungen", "lebensbedingung" }),
    "Unter rauhen Lebensbedingungen kann man sich Hitze, Duerre, Witterung, "
    "Trockenheit, aber auch Raubtiere oder andere Feinde vorstellen.");
    
  AddDetail( ({ "hitze", "duerre", "trockenheit", "raubtiere", "feinde",
                "witterung" }),
    "Der Friedhof ist gepraegt davon.");

  AddDetail( ({ "teil", "oberer teil" }),
    "Der obere Teil des Felsblockes ist so flach wie eine Platte.");
    
  AddDetail( ({ "geheimnis" }),
    "Der Friedhof birgt ein kleines Geheimnis. Vielleicht kannst Du es ja "
    "loesen?");
    
  AddDetail( ({ "knochen" }),
    "Wie auch sonst ueberall auf dem Friedhof liegen auch hier viele "
    "Knochen herum. Ein fuerchterlicher Anblick!");

  AddDetail( ({ "ohr" }), ([
    0: "Du hast wirklich gute Ohren, denn der Wind pfeift nur ganz leise.",
    "dunkelelf": "Deine dunklen, spitzen Ohren hoeren den Wind leise "
                 "pfeifen.",
    "elf": "Deine spitzen Ohren hoeren den Wind leise pfeifen." ]));

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind pfeifen.");
    
  AddSound( ({ "wind" }),
    "Der Wind pfeift um einen Felsblock.");
    
  AddSound( ({ "felsblock", "felsen", "block" }),
    "Du gehst mit Deinem Ohr ganz nah an den Felsblock und hoerst den Wind "
    "pfeifen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts.");


  AddSpecialDetail( "sonne","sonnefkt" );
  AddSpecialDetail( ({ "platte","steinplatte" }), "plattefkt" );

  AddCmd( ({ "setz","setze","leg","lege" }), "setzfkt" );
  AddCmd( ({ "entfern","entferne" }), "entfernfkt" );
  AddCmd( ({ "schieb","schiebe","verschieb","verschiebe" }), "schiebfkt" );
  AddCmd( ({ "tausch","tausche","vertausche","vertausch" }), "tauschfkt" );
 
  AddItem( NPC "elefant", REFRESH_DESTRUCT);


  AddExit( "sueden",     "./room-d3" );
  AddExit( "suedwesten", "./room-c3" );
  AddExit( "nordwesten", "./room-c1" );
  AddExit( "westen",     "./room-c2" );
  AddExit( "ostunten",   "./room-e2" );
  AddExit( "osten",      "./room-e2" );
}

string sonnefkt(string str) {
  if (TP->QueryProp(P_BLIND)) return 0;
  write(BS(
    "Du schaust unvorsichtigerweise direkt in die Sonne. Das war "
    "allerdings keine so gute Idee, denn Du bist abrupt geblendet "
    "und kannst gar nichts mehr sehen!!!"));
  TP->SetProp(P_BLIND, ([
    BLIND_TIME: 80+random(20),
    BLIND_MSG: "Du bist zu stark von der Sonne geblendet!\n" ]) );
  return "";
}

plattefkt(string str) {
  object ob;
  mixed ret;
  
  ob=present(QUESTITEMID,TP);
  if(!objectp(ob)) {
    return BS(
      "Die Steinplatte sieht hochinteressant aus. Sieh Dich noch ein wenig "
      "auf dem Friedhof um, vielleicht kannst Du dann das Geheimnis der "
      "Platte lueften.");
  }
  write(ob->show_steinplatte());
  if(ob->check_ready())
    ret="Freudestrahlend schaust Du Dir Dein Werk ein letztes Mal an.\n";
  else
    ret="\n";
  return ret;
}

int setzfkt(string str) {
  object ob,stein;
  int nr,wo;
  string was,dummy;
  
  if(!ob=present(QUESTITEMID,TP)) return 0;
  was=wo=0;

  notify_fail("Was moechtest Du genau machen?\n");
  if(!str) return 0;

  notify_fail(
    "Was moechtest Du wo einsetzen?\n"
    "Hinweis zur Syntax: setz/leg x y an stelle z <x=gegenstand y,z=zahl>.\n");
  if(sscanf(str,"%s %d an stelle %d%s",was,nr,wo,dummy) != 4) return 0;

  notify_fail("Vielleicht solltest Du einen anderen Gegenstand versuchen!\n");
  if(was != "plaettchen" && was != "steinplaettchen") return 0;

  notify_fail("Hmmm, komische Nummer!\n");
  if(nr<1 || nr>9) return 0;
  
  notify_fail("Hmmm, das ist aber eine komische Stelle!\n");
  if(wo<1 || wo>9) return 0;
  
  notify_fail("Dieses Steinplaettchen hast Du ja gar nicht, Scherzbold! :)\n");
  if(!stein=present(sprintf("%s %d",QUESTSTEINID,nr),TP)) return 0;
  
  notify_fail(
    "An dieser Stelle befindet sich bereits ein Steinplaettchen!\n"
    "Du solltest es erst entfernen oder an eine andere Stelle schieben!\n");
  if(!ob->einsetzen(wo,stein->get_number())) return 0;
  
  // es hat geklappt, stein ist eingesetzt
  stein->remove();
  write(BS(
    "Du nimmst Dein "+nr+". Steinplaettchen und setzt es an der "+wo+". "
    "Stelle ein. Falls es Dir dort nicht gefaellt, kannst Du es ja auch "
    "ruhig wieder entfernen oder an/mit eine/r andere/n Stelle schieben/"
    "tauschen."));
  return 1;
}

int entfernfkt(string str) {
  object ob,stein;
  int nr,wo;
  string was,dummy;
  
  if(!ob=present(QUESTITEMID,TP)) return 0;
  was=wo=0;

  notify_fail("Was moechtest Du entfernen?\n");
  if(!str) return 0;

  notify_fail(
    "Was moechtest Du entfernen?\n"
    "Hinweis zur Syntax: entferne x von stelle y <x=gegenstand y=zahl>.\n");
  if(sscanf(str,"%s von stelle %d%s",was,wo,dummy) != 3) return 0;

  notify_fail("Vielleicht solltest Du einen anderen Gegenstand versuchen!\n");
  if(was != "plaettchen" && was != "steinplaettchen") return 0;

  notify_fail("Hmmm, das ist aber eine komische Stelle!\n");
  if(wo<1 || wo>9) return 0;
  
  notify_fail(
    "An dieser Stelle befindet sich ja gar kein Steinplaettchen!\n"
    "Du solltest erst eines einsetzen oder von woanders dorthin schieben!\n");
  nr=ob->aufnehmen(wo);
  if(nr==0) return 0;
  notify_fail(
    "Du magst das schoene Bild nicht mehr zerstoeren!\n");
  if(nr==-1) return 0;
  
  // es hat geklappt, stein kann genommen werden
  stein=clone_object(QUESTSTEIN);
  stein->move(TP,M_NOCHECK);
  stein->set_number(ob,nr);
  write(BS(
    "Du entfernst das Steinplaettchen von der "+wo+". Stelle und steckst "
    "es wieder ein. Du haettest es aber auch einfach an eine andere Stelle "
    "schieben koennen."));
  return 1;
}

int schiebfkt(string str) {
  object ob,stein;
  int nr,wo,wohin;
  string was,dummy;

  if(!ob=present(QUESTITEMID,TP)) return 0;
  was=wo=0;

  notify_fail("Was moechtest Du denn verschieben?\n");
  if(!str) return 0;

  notify_fail(
    "Was moechtest Du denn verschieben?\n"
    "Hinweis zur Syntax: schieb x von stelle y nach z <x=gegenstand y,z=zahl>.\n");
  if(sscanf(str,"%s von stelle %d nach %d%s",was,wo,wohin,dummy) != 4) return 0;
  
  notify_fail("Vielleicht solltest Du einen anderen Gegenstand versuchen!\n");
  if(was != "plaettchen" && was != "steinplaettchen") return 0;
  
  notify_fail("Hmmm, das ist aber eine komische Stelle!\n");
  if(wo<1 || wo>9) return 0;

  notify_fail("Hmmm, das ist aber eine komische Zielstelle!\n");
  if(wohin<1 || wohin>9) return 0;

  nr=ob->verschiebe(wo,wohin);

  notify_fail(
    "An dieser Stelle befindet sich ja gar kein Steinplaettchen!\n"
    "Du solltest erst eines einsetzen oder von woanders dorthin schieben!\n");
  if(nr==-1) return 0;
  notify_fail(
    "An der Zielstelle befindet sich schon ein Steinplaettchen!\n"
    "Du musst es von dort erst entfernen, tauschen oder verschieben!\n");
  if(nr!=1) return 0;
  write(BS(
    "Du verschiebst das Steinplaettchen von der "+wo+". auf die "+wohin+". "
    "Stelle."));
  return 1;
}

int tauschfkt(string str) {
  object ob,stein;
  int nr,wo,wohin;
  string was,dummy;

  if(!ob=present(QUESTITEMID,TP)) return 0;
  was=wo=0;

  notify_fail("Was moechtest Du denn vertauschen?\n");
  if(!str) return 0;

  notify_fail(
    "Was moechtest Du denn vertauschen?\n"
    "Hinweis zur Syntax: tausche x von stelle y mit z <x=gegenstand y,z=zahl>.\n");
  if(sscanf(str,"%s von stelle %d mit %d%s",was,wo,wohin,dummy) != 4) return 0;
  
  notify_fail("Vielleicht solltest Du einen anderen Gegenstand versuchen!\n");
  if(was != "plaettchen" && was != "steinplaettchen") return 0;
  
  notify_fail("Hmmm, das ist aber eine komische Stelle!\n");
  if(wo<1 || wo>9) return 0;

  notify_fail("Hmmm, das ist aber eine komische Zielstelle!\n");
  if(wohin<1 || wohin>9) return 0;

  nr=ob->vertausche(wo,wohin);

  notify_fail(
    "An dieser Stelle befindet sich ja gar kein Steinplaettchen!\n"
    "Du solltest erst eines einsetzen oder von woanders dorthin schieben!\n");
  if(nr==-1) return 0;
  notify_fail(
    "An der Zielstelle befindet sich ja gar kein Steinplaettchen!\n"
    "Du solltest erst eines einsetzen oder von woanders dorthin schieben!\n");
  if(nr==-2) return 0;
  notify_fail(
    "Du magst das schoene Bild nicht mehr zerstoeren!\n");
  if(nr==-3) return 0;
  write(BS(
    "Du vertauschst das Steinplaettchen von der "+wo+". mit dem von der "
    +wohin+". Stelle."));
  return 1;
}

