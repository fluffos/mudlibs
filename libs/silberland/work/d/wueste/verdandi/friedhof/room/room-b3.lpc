#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

string *pflanze;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Die Sonne hat sich kurz hinter einer kleinen Wolke versteckt. Dadurch ist "
    "es hier jetzt fuer Dich viel ertraeglicher geworden. Nicht mehr so "
    "geblendet vom Sonnenlicht kannst Du Dich nun bequem umsehen. Das Gebirge "
    "im Westen und Sueden beeindruckt Dich am meisten. Aber auch den Zugang zur "
    "offenen Wueste kannst Du jetzt erkennen. Zahlreiche Knochen und Steinchen "
    "liegen verstreut auf dem Boden. Dazwischen kannst Du auch einige "
    "Pflaenzchen sehen." );
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  pflanze=({ });

  AddDetail( ({ "sonne" }),
    "Die Sonne ist jetzt von einer kleinen Wolke verdeckt und blendet Dich nicht "
    "mehr ganz so schlimm.");

  AddDetail( ({ "wolke" }),
    "Die Wolke scheint Dich anzuzwinkern. Anscheinend hat sie sich Dir zuliebe "
    "vor die Sonne geschoben, damit Du nicht so schwitzen musst. :)");

  AddDetail( ({ "sonnenlicht", "licht" }),
    "Das gedaempfte Sonnenlicht tut richtig gut in den Augen.");

  AddDetail( ({ "gebirge", "berge", "berg" }),
    "Wie erstarrt stehst Du da und bewunderst die wundervollen Berge. Sie sind "
    "ein Teil des Tibesti-Gebirges.");
    
  AddDetail( ({ "westen", "sueden" }),
    "Im Westen und Sueden erstreckt sich das Tibesti-Gebirge. Einfach gigantisch!");
    
  AddDetail( ({ "zugang" }),
    "Stimmt, Du kannst den Zugang zur Wueste wirklich schon erkennen. Er liegt "
    "aber noch ein Stueck weiter im Osten.");

  AddDetail( ({ "wueste", "stueck" }),
    "Die offene Wueste ist sehr gefaehrlich!");

  AddDetail( ({ "knochen" }),
    "Es sind wirklich sehr viele Knochen, die hier herumliegen. Grosse, kleine, "
    "spitze, stumpfe, lange, kurze, weisse, braune, graue...\n"
    "Wenn Du nur wuesstest wie viele das sind!?!");

  AddDetail( ({ "steinchen" }),
    "Zahlreiche Steinchen liegen hier auf dem Boden.");

  AddDetail( ({ "boden" }),
    "Der sandige Boden ist bedeckt von zahlreichen Knochen und Steinchen. Hin "
    "und wieder haben es auch einige Pflaenzchen geschafft, sich einen Platz "
    "zu erkaempfen.");

  AddDetail( ({ "himmel" }),
    "Die Berggipfel kitzeln den Himmel am Bauch.\n"
    "Der Himmel grinst die Berge freundlich an.");

  AddDetail( ({ "friedhof", "elefantenfriedhof" }),
    "Der Friedhof weckt irgendwie Deine Neugier.");

  AddDetail( ({ "auge", "augen" }),
    "Du kannst sogar in die Sonne schauen, ohne dass Deine Augen zu traenen "
    "beginnen.");

  AddDetail( ({ "teil", "tibesti", "tibesti-gebirge", "tibestigebirge" }),
    "Riesig hohe Felsformationen ragen majestaetisch in den Himmel. Die "
    "Felswaende sind schroff und kahl.");
  
  AddDetail( ({ "felsformationen", "felsformation", "felsen" }),
    "Die gigantischen Felsformationen ragen so weit in den Himmel, dass die "
    "Gipfel wohl in den Wolken verschwinden koennten.");

  AddDetail( ({ "felswaende", "felswand" }),
    "Die Felswaende sind so steil, dass Du Dich fragst, ob da schon einmal jemand "
    "oben war.");

  AddDetail( ({ "wolken" }),
    "Du siehst nur die eine kleine Wolke, welche die Sonne verdeckt.");

  AddDetail( ({ "gipfel", "berggipfel" }),
    "Da hier nicht viele Wolken die Gipfel einhuellen, kannst Du sie in ihrer "
    "vollen Pracht und Groesse bestaunen.");
    
  AddDetail( ({ "pracht", "groesse" }),
    "Es sieht wirklich atemberaubend aus!");

  AddDetail( ({ "bauch" }),
    "Seit wann hat denn der Himmel einen Bauch?!? So ein Bloedsinn!");

  AddDetail( ({ "osten" }),
    "Oestlich von Dir erstreckt sich die offene Wueste.");

  AddDetail( ({ "bloedsinn", "baeuche" }),
    "Himmel haben KEINE Baeuche!!!");

  AddDetail( ({ "platz" }),
    "Viel Platz haben die Pflaenzchen nicht zwischen all den Steinchen und "
    "Knochen.");

  AddDetail( ({ "sand" }),
    "Unter den herumliegenden Knochen und Steinchen befindet sich eine Schicht "
    "aus Sand.");

  AddDetail( ({ "schicht", "sand", "sandschicht" }),
    "Der Sand ist hier ziemlich festgetreten. Vielleicht hat sich auch ein wenig "
    "Erde dazugemischt, um dem Boden mehr Festigkeit zu geben.");

  AddDetail( ({ "erde", "festigkeit", "halt" }),
    "Durch die Erde haben die Pflaenzchen mehr Halt im Boden.");
    
  AddDetail( ({ "neugier" }),
    "Je laenger Du Dich hier umsiehst, umso neugieriger wirst Du. Wer weiss, "
    "vielleicht gibt es hier ja irgendetwas Interessantes?");

  AddDetail( ({ "interessantes" }),
    "Das musst Du schon selbst herausfinden!");

  
  AddSound( DEFAULT_SOUND,
    "Die Knochen klimpern in allen Tonarten vor sich hin.");
    
  AddSound( ({ "knochen", "tonarten", "tonart" }),
    "Jetzt haben die Knochen gerade in dis-moll geklimpert.");

  AddSound( ({ "dis-moll" }),
    "Oder war es a-moll? Du bist Dir da einfach nicht sicher...");
    
  AddSound( ({ "a-moll" }),
    "Du hast eigentlich keine Ahnung von Musik.");
    
  AddSound( ({ "musik" }),
    "Hier ist keine Musik, die Du hoeren kannst.");
  

  AddSmell( DEFAULT_SMELL,
    "Ein leicht scharfer Geruch liegt in der Luft.");
    
  AddSmell( ({ "geruch" }),
    "Du weisst nicht genau, woher dieser Geruch kommt.");
    
  AddSmell( ({ "luft" }),
    "Vielleicht sondern ja die Pflaenzchen diesen scharfen Geruch ab?");
    
  AddSmell( ({ "pflaenzchen", "pflanzen" }),
    "Ja richtig, die Pflaenzchen riechen so scharf. Moeglicherweise schuetzt es "
    "sie davor, von Tieren gefressen zu werden.");
  

  AddSpecialDetail( ({ "pflaenzchen" }), "pflaenzchenfkt");

  AddSpecialDetail( ({ "pflanze" }), "pflanzefkt");

  AddSpecialDetail( ({ "loch" }), "lochfkt");

  AddExit( "norden",     "./room-b2" );
  AddExit( "suedosten",  "./room-c4" );
  AddExit( "nordosten",  "./room-c2" );
  AddExit( "osten",      "./room-c3" );
  AddExit( "sueden",     "./room-b4" );
  AddExit( "westen",     "./room-a3" );
  AddExit( "nordwesten", "./room-a2" );
  
  AddCmd( ({ "zaehl","zaehle" }), "zaehlfkt" );
  AddCmd( ({ "reiss","reisse" }), "reissfkt" );
  AddCmd( ({ "greif","greife" }), "greiffkt" );
}

int zaehlfkt(string str) {
  int anzahl;
  notify_fail("Was moechtest Du hier zaehlen?\n");
  if(str != "knochen") return 0;
  anzahl=TP->QueryProp(P_MAX_HP);
  write(BS(
    "Du faengst an, all die vielen Knochen hier zu zaehlen. Erstaunlicherweise "
    "kommst Du auf genau "+anzahl+" Knochen. Diese Zahl kommt Dir irgendwie "
    "bekannt vor. Du weisst nur nicht woher!?!"));
  say(BS(
    CAP_TPN+" zaehlt all die vielen Knochen hier und schaut verdutzt drein."));
  return 1;
}

reset() {
  ::reset();
  pflanze=({ });
}

string pflaenzchenfkt() {
  if(member(pflanze,getuid(TP)) != -1)
    return BS(
      "Die kleinen Pflaenzchen wachsen zwischen den Steinchen und Knochen. "
      "Sie schimmern sogar ein wenig.");
  return BS(
    "Die kleinen Pflaenzchen wachsen zwischen den Steinchen und Knochen. "
    "Eine davon ist ein wenig groesser und sieht interessant aus. Alle "
    "Pflaenzchen schimmern ein wenig.");
}

string pflanzefkt() {
  if(member(pflanze,getuid(TP)) != -1) return 0;
  return BS(
    "Die Pflanze ist ein wenig groesser als alle anderen. Vielleicht kannst "
    "Du sie ja irgendwie mit grober Gewalt bekommen?");
}

int reissfkt(string str) {
  object ob;
  
  if(member(pflanze,getuid(TP)) != -1) return 0;
  
  notify_fail("Willst Du die Pflanze vielleicht ausreissen?\n");
  if (str == "pflanze" || str == "pflaenzchen") return 0;
  
  notify_fail("Was willst Du ausreissen?\n");
  if (str != "pflanze aus" && str != "pflaenzchen aus") return 0;

  pflanze+= ({ getuid(TP) });

  write(BS(
    "Du reisst die Pflanze mit voller Wucht aus dem Boden heraus und steckst "
    "sie ein. Ein grosses Loch ist mitten im Boden entstanden."));
  say(BS(
    CAP_TPN+" reisst mit voller Wucht etwas aus dem Boden heraus und steckt "
    "es ein."));
  catch(ob=clone_object( OBJ "pflanze" ));
  if(ob) ob->move(TP,M_NOCHECK);
  return 1;
}

string lochfkt() {
  if(member(pflanze,getuid(TP)) == -1) return 0;
  if(!QUESTMASTER->stone_check(8))
    return BS(
      "Durch Dein grobes Verhalten ist ein tiefes Loch im Boden entstanden. "
      "Irgendwie erweckt es Dein Interesse und Du solltest dem unbedingt "
      "weiter nachgehen!");
  return BS(
    "Durch Dein grobes Verhalten ist ein tiefes Loch im Boden entstanden.");
}

int greiffkt(string str) {
  if(member(pflanze,getuid(TP)) == -1) return 0;
  if(QUESTMASTER->stone_check(8)) {
    write(BS(
      "Du hast schon das aus dem Loch, was Du haben wolltest!"));
    return 1;
  }
  
  notify_fail("Moechtest Du vielleicht in das Loch greifen?\n");
  if (str == "loch") return 0;
  
  notify_fail("Wohin moechtest Du greifen?\n");
  if (str != "in loch") return 0;
  
  say(BS(CAP_TPN+" bueckt sich zum Boden."));
  
  if(QUESTMASTER->stone_found(8)) {
    write(BS(
      "Du greifst in das tiefe Loch und findest ein kleines Plaettchen, "
      "welches Du sofort einsteckst."));
    return 1;
  }
  write(BS(
    "Du greifst in das tiefe Loch, findest aber nichts!"));
  return 1;
}

