#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

string *gotschere;

create() {

  ::create();

  gotschere=({ });

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
		"Du stehst mitten auf dem Elefantenfriedhof. Langsam laesst Du Deinen Blick ueber das "
		"gesamte Gelaende schweifen und kannst in oestlicher Richtung sogar schon die offene "
		"Wueste erkennen. Der Boden sieht hier nicht viel anders aus als auf dem Rest des "
		"Friedhofes. Ueberall liegen Knochen und Steine herum, und dazwischen waechst nur ganz "
		"wenig Gras. Eigentlich ist das hier eine sehr trostlose Gegend, aber dennoch versuchst "
		"Du das Beste daraus zu machen.");

  SetProp( P_NO_TPORT, NO_TPORT_OUT);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(4), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "friedhof", "elefantenfriedhof" }),
	"Ein Elefantenfriedhof ist ein Ort, den kranke oder altersschwache Elefanten aufsuchen, um "
	"in Frieden sterben zu koennen.");
	
  AddDetail( "blick",
    "Du richtest Deinen Blick gegen Osten und kannst von hier aus schon den Uebergang zur offenen "
    "Wueste erkennen.");
    
  AddDetail( ({ "gelaende", "ort", "gebiet" }),
    "Damit ist der Friedhof gemeint, auf dem Du Dich gerade befindest.");
    
  AddDetail( "richtung",
    "Im Osten siehst Du schon die Anfaenge der offenen Wueste.");
    
  AddDetail( "wueste",
    "Wenn Du in die Wueste willst, solltest Du Dich oestlich halten. Aber sei vorsichtig! Dort "
    "sollen angeblich viele Gefahren lauern!");
    
  AddDetail( "boden",
    "Der Boden ist mit unzaehligen Knochen und Steinen bedeckt. Nur hin und wieder hat es ein "
    "Grashalm geschafft, sich nach oben hin durchzukaempfen.");
    
  AddDetail( "knochen",
    "Du kombinierst scharf und gelangst zu der Erkenntnis, dass es sich hierbei um Elefantenknochen "
    "handeln koennte. Eigentlich verwundert Dich das auch nicht weiter, denn Dir kommt es ziemlich "
    "logisch vor, dass auf einem Elefantenfriedhof auch Elefantenknochen herumliegen.");
    
  AddDetail( "steine",
    "Zwischen den Knochen liegen auch etliche Steine auf dem Boden. Sie sind alle sandbraun und "
    "weisen eigentlich keine Besonderheiten auf.");
    
  AddDetail( ({ "besonderheiten","besonderheit" }),
    "Oh doch, da liegt inmitten der vielen Steine einer, der ganz anders aussieht als die anderen.");
    
  AddDetail( "stein",
    "Dieser eine Stein ist nicht so braun wie die restlichen Steine, sondern schimmert im Sonnenlicht "
    "leicht blaeulich.");
    
  AddDetail( "sand",
    "Den findest Du in der Wueste."); 

  AddDetail( "gras",
  	"Nur ab und zu ragt zwischen den Knochen und Steinen ein Grashalm hervor."),
  	
  AddDetail( "gegend",
    "Diese Gegend ist wirklich sehr trostlos. Hier gibt es im Prinzip nichts, das Dich zum "
    "laengeren Verweilen animieren koennte.");
    
  AddDetail( "elefanten",
    "Sie haben sich dieses Gebiet ausgesucht, um sich hier zum Sterben zurueckzuziehen.");
    
  AddDetail( ({ "frieden", "friede" }),
    "Leider gibt es den im SilberLand nur sehr selten.");
    
  AddDetail( "osten",
    "Im Osten geht der Weg zur offenen Wueste weiter.");
    
  AddDetail( "uebergang",
    "Du kannst den Uebergang wegen der Luftspiegelungen leider nur sehr verschwommen erkennen.");
    
  AddDetail( ({ "anfaenge", "anfang" }),
    "Richtung Osten faengt die gefaehrliche Wueste an.");
    
  AddDetail( "gefahren",
    "Die Wueste ist angeblich voll damit. Du wirst sicher einigen davon noch frueh genug begegnen.");
    
  AddDetail( ({ "grashalm", "grashalme", "halm", "halme" }),
    "Ganz zart und duerr ragen vereinzelte Grashalme zwischen den Steinen und Knochen hervor.");
    
  AddDetail( "erkenntnis",
    "Bravo, Du hast es ganz richtig erkannt! :)");
    
  AddDetail( "elefantenknochen",
    "Man findet hier sicher vorwiegend die Knochen von Elefanten, aber wahrscheinlich sind auch "
    "Knochen anderer Tiere darunter.");
    
  AddDetail( "sonnenlicht",
    "Im Sonnenlicht schimmert dieser spezielle Stein ganz besonders schoen.");
    
  AddDetail( "prinzip",
    "Das hat sicher nichts mit 'Prinz' zu tun.");
    
  AddDetail( "prinz",
    "Meinst Du vielleicht 'Maerchenprinz'?");
    
  AddDetail( "maerchenprinz",
    "Argl, Du untersuchst auch jedes bloede Wort, hm?");
    
  AddDetail( "wort",
    "Schoen langsam reicht es! Forscherpunkte bekommst Du dafuer eh keine!");
    
  AddDetail( "forscherpunkte",
    "AUS JETZT! VERGISS ES!");

  AddDetail( ({ "verweilen", "sterben", "beste" }),
    "Seit wann ist das denn ein Hauptwort?");
    
  AddDetail( "hauptwort",
    "Untersucht Dein Script etwa alle gross geschriebenen Woerter?");
    
  AddDetail( ({ "script", "woerter" }),
    "Jetzt wirst Du gleich Lars besuchen koennen, wenn Du nicht bald aufhoerst, sinnlose Woerter zu "
    "untersuchen!");
    
  AddDetail( "lars",
    "Er wird Dich gleich holen...");
    
  AddDetail( "silberland",
    "Hier befindest Du Dich derzeit.");
  
  AddDetail( "weg",
    "Im Osten setzt sich der Weg zur offenen Wueste fort. Er geht leicht bergab.");
  
  AddDetail( "tiere",
    "Es waere schade um die Zeit, jetzt alle Tiere aufzuzaehlen, die es gibt.");
  
  AddDetail( ({ "luftspiegelungen", "luftspiegelung" }),
    "Wegen der enormen Hitze kannst Du von hier aus die Wueste nur sehr flimmernd und "
    "verschwommen erkennen. Wenn Du mehr sehen willst, musst Du Dich schon naeher hinwagen.");
    
  AddDetail( "hitze",
    "Du schwitzt Dir halb die Seele aus dem Leib.");
    
  AddDetail( "seele",
    "So etwas kann man doch nicht sehen.");
    
  AddDetail( "leib",
    "Naja, Du koenntest ruhig ein bisschen mehr abnehmen. Vielleicht wuerdest Du dann auch nicht so "
    "stark schwitzen. ;)");
    
  AddDetail( "himmel",
    "Er erstreckt sich tiefblau ueber Dir. Die Sonne steht wie ein riesiger Feuerball mitten am "
    "Himmel und heizt Dich auf.");
    
  AddDetail( "sonne",
    "Sie brennt erbarmungslos auf Dich hernieder.");
    
  AddDetail( "feuerball",
    "Die Sonne sieht wirklich wie ein grosser Feuerball aus.");
  
  AddDetail( "nase",
    "Findest Du auch, dass sie etwas zu gross geraten ist?");

  
  AddSound( DEFAULT_SOUND,
	"Leise kannst Du ein furchteinfloessendes Heulen vernehmen.");
		
  AddSound( "heulen",
	"Der Lautstaerke nach zu urteilen duerfte es sehr weit weg sein. Was das wohl fuer ein Tier "
	"ist?");
	
  AddSound( "tier",
    "Tja, welches Tier koennte das sein?");
    
  AddSound( "schakal",
    "Du koenntest echt recht haben! Es hoert sich wirklich wie das Heulen eines Schakals an.");   
  
  
  AddSmell( DEFAULT_SMELL,
	"Der faulige Geruch von verwestem Fleisch dringt Dir in die Nase.");

  AddSmell( ({ "geruch", "gerueche" }),
    "Eigentlich riecht so ziemlich alles besser als das, was Dir hier in die Nase steigt.");
    
  AddSmell( "fleisch",
    "Pfui, dass verwestes Fleisch aber auch so stinken muss! Dir wird sicher bald uebel, wenn Du "
    "hier noch laenger stehen bleibst.");

  
  AddSpecialDetail( ({ "drahtschlinge","schlinge","draht","hand" }), "drahtfkt" );

  
  AddItem( NPC "schakal", REFRESH_DESTRUCT );

  
  AddExit( "norden", ([
            EX_DEST: "./room-c1",
            EX_TESTFUNC: "checkfkt",
           ]) );

  AddExit( "suedosten", ([
            EX_DEST: "./room-d3",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddExit( "nordwesten", ([
            EX_DEST: "./room-b1",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddExit( "osten", ([
            EX_DEST: "./room-d2",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddExit( "sueden", ([
            EX_DEST: "./room-c3",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddExit( "westen", ([
            EX_DEST: "./room-b2",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddExit( "suedwesten", ([
            EX_DEST: "./room-b3",
            EX_TESTFUNC: "checkfkt",
           ]) );
           
  AddCmd( ({ "nimm","nehm","nehme","hebe","heb" }) , "steinfkt" );
  AddCmd( ({ "such","suche" }), "suchfkt" );
}


int steinfkt(string str) {
  object ob;
  notify_fail("Was willst Du nehmen?\n");
  if(!str) return 0;
  if(str != "stein" && str != "stein auf") return 0;
  if(present("\n_drahtschlinge",TP)) {
    write(BS(
      "Also noch einmal solltest Du den Stein nicht versuchen zu nehmen. Vielleicht "
      "wird sonst Deine linke Hand auch noch gefangen und Du kommst hier gar "
      "nicht mehr lebend raus!"));
    return 1;
  }
  if(member(gotschere,getuid(TP)) != -1) {
    write(BS(
      "Findest Du nicht, dass es jetzt ziemlich daemlich waere, noch einmal "
      "in die Falle zu tapsen?"));
    return 1;
  }
  write(BS(
    "Du versuchst den Stein zu nehmen. Doch zu spaet bemerkst Du die kleine "
    "Drahtschlinge, die sich um den Stein befand. Als Du den Stein beruehrst, "
    "macht es *schnapp* und Deine rechte Hand ist in einer Schlinge gefangen!"));
  say(BS(
    CAP_TPN+" versucht etwas zu nehmen und wird von einer kleinen Drahtschlinge "
    "gefangen!"));
  catch(ob=clone_object( OBJ "drahtschlinge" ));
  if(ob) {
    ob->move(TP,M_NOCHECK);
  }
  return 1;
}

int checkfkt() {
  if(!present("\n_drahtschlinge",TP)) return 1;
  write(BS(
    "Du bist mit Deiner rechten Hand in einer kleinen Drahtschlinge gefangen "
    "und kommst hier nicht so ohne weiteres weg!"));
  say(BS(
    CAP_TPN+" versucht weiterzugehen. Aber "+TP->QueryPossPronoun(2)+
    " rechte Hand ist leider in einer kleinen Drahtschlinge gefangen."));
  return 0;
}

string drahtfkt(string str) {
  if(!present("\n_drahtschlinge",TP)) return 0;
  return BS(
    "Die Drahtschlinge hat sich um Deine rechte Hand gelegt und zieht sich "
    "bei jeder Deiner Bewegungen staerker zusammen. Dir wird bald klar, "
    "dass Du so einfach hier nicht mehr wegkommst. Vielleicht koenntest "
    "Du ja in der Naehe etwas suchen, das Dich aus dieser misslichen "
    "Lage befreien kann?");
}

int suchfkt(string str) {
  object ob;
  if(!present("\n_drahtschlinge",TP)) return 0;
  notify_fail("Wonach willst Du suchen?\n");
  if(str != "drahtschere" && str != "schere" && str != "nach schere" &&
  	 str != "nach drahtschere") return 0;
  if(present("\n_drahtschere") || present("\n_drahtschere",TP)) {
    write(BS("Aber wozu suchen, wenn eh schon eine da ist?\n"));
    return 1;
  }
  if(member(gotschere,getuid(TP)) != -1) {
    write(BS(
      "Du suchst vergeblich ein zweites Mal nach einer Drahtschere. Haettest "
      "Du die Schere doch nur nicht abhanden kommen lassen! :("));
    return 1;
  }
  catch(ob=clone_object( OBJ "drahtschere" ));
  if(ob) {
    ob->move(TP,M_NOCHECK);
  }
  write(BS(
    "Und tatsaechlich!!! Du findest eine kleine Drahtschere und steckst sie "
    "sofort ein."));
  say(BS(CAP_TPN+" sucht nach etwas und wird sogar fuendig."));
  gotschere+=({ getuid(TP) });
  return 1;
}

reset() {
  ::reset();
  gotschere=({ });
}

