#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>


create() {

  ::create();


  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer tieferen Grube mitten auf dem Friedhof. "
    "Wenn Du Dich auf die Fussspitzen stellst, kannst Du sogar "
    "ueber den Rand der Grube schauen. Die Sonne ist hier sehr intensiv "
    "und Du fuehlst Dich nicht besonders gut. Vielleicht waere es "
    "besser, diese Grube so schnell wie moeglich wieder zu verlassen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 38+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );


  AddDetail( ({ "grube" }),
	"Beim unachtsamen Herumgehen bist Du nun in eine relativ tiefe Grube "
	"geraten, die Du anfaenglich gar nicht bemerkt hast. Der Boden ist "
	"uebersaet mit Knochen und knirscht bei jeder Deiner Bewegungen. "
	"Es sieht fast so aus, als ob diese Grube absichtlich gegraben wurde, "
	"um die Knochen zu 'begraben'.");

  AddDetail( ({ "friedhof", "elefantenfriedhof" }),
	"Von hier aus kannst Du den Friedhof nicht so gut ueberblicken.");
	
  AddDetail( ({ "fussspitzen" }),
	"Du stellst Dich auf Deine Fussspitzen und kannst so relativ muehelos "
	"ueber den Rand der Grube schauen.");
 
  AddDetail( ({ "rand", "grubenrand" }),
	"Du siehst ueber den Grubenrand und kannst im Osten hinter einem "
	"riesigen Skelett bereits die offene Wueste erkennen. Im Suedwesten "
	"faellt Dir ein gigantisch grosser Kadaver auf.");
	
  AddDetail( ({ "sonne" }),
	"Heiss und grell steht sie hoch oben am Himmel.");

  AddDetail( ({ "boden" }),
	"Auf dem Boden liegen mengenweise Knochen herum. Darunter befinden "
	"sich wie ueberall hier Millionen von Sandkoernchen.");
	
  AddDetail( ({ "sand" }),
    "Heisser, weisser Sand.");
	
  AddDetail( ({ "himmel" }),
	"Die Sonne brennt erbarmungslos auf Dich hernieder.");
 
  AddDetail( ({ "hitze" }),
	"Dir kommt es hier heisser vor als in der Hoelle.");
	
  AddDetail( ({ "osten" }),
	"Oestlich von Dir liegt ein riesengrosses Skelett. Du kannst Dir gar "
	"nicht vorstellen, welches Tier so riesig sein koennte.");

  AddDetail( ({ "suedwesten" }),
	"Du kannst ja einmal dort hin gehen.");
	
  AddDetail( ({ "wueste" }),
	"Hinter dem grossen Skelett, das wie eine riesige Knochenrutsche "
	"aussieht, beginnt die offene Wueste.");
 
  AddDetail( ({ "skelett" }),
	"Aus Deiner Perspektive sieht das Skelett noch groesser und hoeher "
	"aus, als es in Wirklichkeit ist.");
	
  AddDetail( ({ "kadaver" }),
	"Ein grosser Kadaver liegt suedwestlich von Dir auf dem Boden. Du "
	"glaubst sogar, noch einige Fleischstuecke dranhaengen zu sehen.");

  AddDetail( ({ "tier" }),
	"So gross wie dieses Skelett ist, kann es eigentlich nur von einem "
	"Saurier stammen. ");
	
  AddDetail( ({ "saurier" }),
	"Wenn es einmal ein Saurier war, dann sei lieber froh, dass er nicht "
	"mehr lebt! Der haette Dich sonst sicher muehelos zerfleischt und "
	"zerfetzt.");
 
  AddDetail( ({ "perspektive" }),
	"Da Du in einer Grube stehst, koennte man Deine Perspektive als "
	"Ameisen- oder Maulwurfperspektive bezeichnen.");
  
  AddDetail( ({ "ameisenperspektive" }),
	"Man koennte sie als sehr bodennahe Perspektive bezeichnen. Alles "
	"sieht dadurch viel groesser und maechtiger aus.");

  AddDetail( ({ "fleischstuecke", "fleisch" }),
	"Einige Fleischstuecke haengen noch an dem Kadaver. Ob sie frisch "
	"und geniessbar sind, kannst Du allerdings von hier aus nicht erkennen.");
	
  AddDetail( ({ "knochen" }),
	"Eine ganze Knochensammlung liegt Dir zu Fuessen. Bei jeder Bewegung "
	"knirscht und knackt es unter Dir.");
 
  AddDetail( ({ "millionen", "million" }),
	"Ui, das ist aber viel!");
	
  AddDetail( ({ "sandkoernchen", "sandkoerner", "anzahl", "koernchen", "koerner" }),
	"Du schaetzt die Anzahl der Sandkoernchen auf 653720546.");

  AddDetail( ({ "knochenrutsche", "rutsche" }),
	"Tja, wer weiss...?");
	
  AddDetail( ({ "knochensammlung", "sammlung" }),
	"Wer bitte sammelt schon Knochen?!? Dir waere das viel zu makaber.");
 
  AddDetail( ({ "fuesse" }),
	"Deine Fuesse stehen etwas wackelig auf den vielen Knochen.");

  AddDetail( ({ "bewegung", "bewegungen" }),
	"Du bewegst Deine Fuesse und hoerst die Knochen knacken.");

  AddDetail( ({ "hoelle" }),
	"Warst Du schon einmal dort?");
	
  AddDetail( ({ "wirklichkeit" }),
	"Man kann auch Realitaet dazu sagen.");
 
  AddDetail( ({ "realitaet" }),
	"Man kann auch Wirklichkeit dazu sagen.");
	
  AddDetail( ({ "maulwurfperspektive" }),
	"Man koennte sie als sehr bodennahe Perspektive bezeichnen. Alles "
	"sieht dadurch viel groesser und maechtiger aus.");


  AddSound( DEFAULT_SOUND,
	"Du hoerst die Knochen auf dem Boden knirschen.");
	
  AddSound( ({ "knirschen", "knochen" }),
    "Bei jeder Bewegung knacken die Knochen unter Deinen Fuessen.");

  AddSmell( DEFAULT_SMELL,
	"Ein bisschen muffig riecht es hier in der Grube.");
	
  AddSmell( ({ "grube" }),
    "Wahrscheinlich sind das die Knochen, die hier so vor sich hin muffeln.");
    
  AddSmell( ({ "knochen" }),
    "Du schnupperst einen Knochen ab und legst ihn gleich wieder auf den "
    "Boden, bevor Dir schlecht wird.");


  AddExit( "norden", 
  			([ EX_DEST: "./room-c2",
  			   EX_MSG: "ueber den Rand der Grube nach Norden",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
  
  AddExit( "suedwesten",
  			([ EX_DEST:"./room-b4",
  			   EX_MSG: "ueber den Rand der Grube nach Suedwesten",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
  
  AddExit( "nordosten",
  			([ EX_DEST:"./room-d2",
  			   EX_MSG: "ueber den Rand der Grube nach Nordosten",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
  
  AddExit( "osten",
  			([ EX_DEST: "./room-d3",
  			   EX_MSG: "ueber den Rand der Grube nach Osten",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
    
  AddExit( "sueden",
  			([ EX_DEST: "./room-c4",
  			   EX_MSG: "ueber den Rand der Grube nach Sueden",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
   
  AddExit( "nordwesten",
  			([ EX_DEST: "./room-b2",
  			   EX_MSG: "ueber den Rand der Grube nach Nordwesten",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );
   
  AddExit( "westen",
  			([ EX_DEST: "./room-b3",
  			   EX_MSG: "ueber den Rand der Grube nach Westen",
  			   EX_PLMSG: "Du kletterst ueber den Rand aus der Grube heraus.\n\n"
  			 ]) );

  AddItem( NPC "schliefer", REFRESH_DESTRUCT );

  AddCmd ( ({ "kletter","klettere" }), "kletterfkt");  
}

int kletterfkt(string stri) {
  if(!stri) return 0;
  write(BS(
    "Um die Grube wieder zu verlassen, musst Du nicht klettern. Du "
    "kannst einfach so in jede Richtung gehen."));
  return 1;
}

