#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

int kaefer;
int kaeferfkt();

create() {

  ::create();


  kaefer=1;


  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Du befindest Dich jetzt auf dem suedlichen Teil des Elefantenfriedhofes. "
    "Vom Himmel brennt die Sonne heiss herunter, und Dir verschwimmt regelrecht "
    "alles vor den Augen. Der Boden ist auch hier uebersaet mit unzaehligen "
    "Knochen und Steinen. Nur ab und zu faellt Dir dazwischen ein kleines "
    "Pflaenzchen auf. Im Nordosten kannst Du uebrigens schon den Uebergang in die "
    "offene Wueste erkennen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( "teil",
	"Du stehst gerade auf dem suedlichen Teil des Elefantenfriedhofes.");
	
  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
    "Viele Elefanten spueren, wenn ihr Tod immer naeher rueckt. Sie verlassen dann "
    "oft ihre Gruppen und kommen hier her, um an diesem Ort friedlich zu sterben.");
    
  AddDetail( "himmel",
    "Ein solch kraeftiges Blau hast Du schon lange nicht mehr gesehen.");
    
  AddDetail( "sonne",
  	"Die Sonne kommt Dir heute extrem grell vor. Hoffentlich laeufst Du nicht "
  	"voellig nackt herum, sonst hast Du sicher bald einen Sonnenbrand.");
  	
  AddDetail( "augen",
    "Wenn Du nicht gerade ein Zyklop bist oder Dir bereits ein Auge ausgestochen "
    "wurde, hast Du sicher zwei davon. Im Idealfall solltest Du zwei verschiedene "
    "haben: ein rechtes und ein linkes. ;)");
    
  AddDetail( "boden",
  	"Der Boden ist sandig und mit vielen Knochen bedeckt. Steine gibt es hier "
  	"auch mehr als genug. Zwischen manchen Knochen haben sich sogar kleine "
  	"Pflaenzchen Platz schaffen koennen.");
  	
  AddDetail( "knochen",
  	"Hier bedecken wirklich alle Arten von Knochen den Boden. Von den groessten "
  	"Rippen bis hin zu den kleinsten Zehenknochen liegt hier alles verstreut "
  	"herum. Auf einmal faellt Dir zwischen den vielen Knochen etwas auf.");
  	
  AddDetail( "etwas",
    "Du raeumst ein paar Knochen beiseite und stellst enttaeuscht fest, dass es "
    "sich hierbei nur um eine ganz normale Wurzel handelt.");
  	
  AddDetail( ({ "steine", "sandsteine" }),
    "Die Steine, die Du hier siehst, duerften Sandsteine sein. Sie sind braun, "
    "aber so uninteressant, dass Du sie nicht weiter betrachtest.");

  AddDetail( ({ "pflaenzchen", "pflanze", "pflanzen" }),
  	"Du bist auf diesem Gebiet leider kein Fachmann und weisst somit auch nicht, "
  	"um welche Pflanzen es sich hier handelt. Fest steht aber, dass sie relativ "
  	"vertrocknet aussehen, und die Lebensbedingungen fuer solche kleine Pflanzen "
  	"sicher nicht die einfachsten sind.");
  	
  AddDetail( "nordosten",
  	"Im Nordosten siehst Du den Verbindungsweg zwischen dem Friedhof und der "
  	"offenen Wueste. Von hier aus erkennst Du allerdings noch nicht so "
  	"uebermaessig viel. Dafuer solltest Du schon naeher hingehen.");
  	
  AddDetail( "uebergang",
  	"Du kannst ihn aus dieser Entfernung nur sehr verschwommen wahrnehmen, da die "
  	"Luft in dieser Hitze zu stark flimmert. Geh doch naeher ran, wenn Du mehr "
  	"erkennen willst."); 
  	
  AddDetail( "wueste",
  	"Es gibt sicher genuegend erholsamere Plaetze als die Wueste. In einer Kneipe "
  	"sitzen und sich dort den Bauch vollschlagen ist erstens wesentlich kuehler "
  	"und vor allem nicht einmal annaehernd so gefaehrlich wie das Leben in der "
  	"Wueste. Aber ein echter Held laesst sich doch durch solche Kleinigkeiten "
  	"nicht abschrecken, oder?");
  	
  AddDetail( ({ "elefanten", "elefant" }),
  	"Vielleicht hast Du ja vorhin schon einen hier gesehen?");
  	
  AddDetail( "tod",
    "Noe, mit dem Tod moechtest Du Dich jetzt gar nicht so genau beschaeftigen.");
  
  AddDetail( ({ "gruppen", "gruppe" }),
    "Elefanten sind sehr gesellig und leben in Gruppen zusammen.");
  
  AddDetail( "ort",
    "Koennte leicht sein, dass damit der Elefantenfriedhof gemeint ist. ;)");
    
  AddDetail( "blau",
    "Der Himmel strahlt im schoensten Blau, das Du Dir vorstellen kannst. Nur ein "
    "kleines Woelkchen steht ueber dem Horizont.");
    
  AddDetail( ({ "woelkchen", "wolke" }),
    "Du betrachtest die kleine Wolke naeher und stellst grinsend fest, dass sie wie "
    "ein kleiner weisser Elefant aussieht.");
    
  AddDetail( "sonnenbrand",
    "Zum Glueck hast Du jetzt noch keinen.");
    
  AddDetail( "zyklop",
    "Schreckliche, riesige, grausame, einaeugige Monster sollen das sein. "
    "Hoffentlich begegnest Du hier keinem. Das waere dann sicher Dein Tod, denn "
    "obwohl sie nur ein Auge haben, entkommen ihnen ihre Opfer nur sehr selten.");
    
  AddDetail( "auge",
    "Meinst Du das rechte oder das linke?");
    
  AddDetail( ({ "rechtes auge", "das rechte auge" }),
    "Du greifst schnell hin. Huch, zum Glueck ist es noch da.");
    
  AddDetail( ({ "linkes auge", "das linke auge" }),
    "Du atmest erleichtert auf. Es befindet sich noch dort, wo Du es vermutet hast.");
  
  AddDetail( "idealfall",
    "Bei Dir tritt zum Glueck der Idealfall ein: Du hast wirklich ein rechtes und "
    "ein linkes Auge!");
    
  AddDetail( "sand",
    "Hier ist der Boden schon ziemlich sandig. In der Wueste wirst Du aber davon noch "
    "viel mehr sehen koennen.");
    
  AddDetail( "platz",
    "Du hast hier weit mehr Platz als die kleinen Pflaenzchen, die zwischen den "
    "Knochen und Steinen hervorragen.");
    
  AddDetail( ({ "arten", "knochenarten" }),
    "Hmmm, Du ueberlegst kurz wie viele Knochenarten Du kennst, gibst aber bald das "
    "Denken auf, da Dir bei der hier herrschenden Hitze sowieso nicht viel einfallen "
    "wuerde. Eigentlich ist es ja auch egal. Es sind auf jeden Fall viel zu viele, um "
    "sie alle aufzuzaehlen.");
    
  AddDetail( "rippen",
    "Ja, die liegen hier unter anderem auch auf dem Boden. So lang und gross wie die "
    "sind, stammen sie sicher nicht von kleinen Tieren.");
    
  AddDetail( "zehenknochen",
    "Ob das jetzt wirklich Zehenknochen sind, weisst Du eigentlich gar nicht genau. "
    "Da es aber im Grunde genommen auch ziemlich egal ist, gruebelst Du nicht laenger "
    "darueber nach.");
    
  AddDetail( "wurzel",
    "Eine kleine Wurzel schaut zwischen den vielen Knochen hervor. Pass auf, dass Du "
    "nicht stolperst und hinfaellst!");
    
  AddDetail( "gebiet",
    "Auf dem Gebiet der Pflanzenbestimmung bist Du echt kein Experte.");
    
  AddDetail( ({ "fachmann", "experte" }),
    "Na Du bist sicher keiner! Zumindest nicht, was die Bestimmung von Pflanzen "
    "anbelangt.");
    
  AddDetail( "lebensbedingungen",
    "Hier herrschen harte Lebensbedingungen. Nicht nur fuer die kleinen Pflanzen, "
    "sondern auch fuer die hier lebenden Tiere und vor allem auch fuer Dich.");
    
  AddDetail( ({ "verbindungsweg", "weg" }),
    "Der befindet sich nordoestlich von hier.");
    
  AddDetail( "entfernung",
    "Du stehst einfach noch zu weit weg, als dass Du alles genau erkennen koenntest.");
    
  AddDetail( "luft",
    "Obwohl Du sie nicht sehen kannst, ist sie da.");
    
  AddDetail( "hitze",
    "Die Hitze macht Dir ganz schoen zu schaffen...");
    
  AddDetail( "plaetze",
    "Dir fallen auf Anhieb etliche Plaetze ein, die gemuetlicher und erholsamer sind "
    "als die Wueste.");
    
  AddDetail( "kneipe",
    "Haette eine Kneipe hier auf dem Elefantenfriedhof echt einen Sinn?");
    
  AddDetail( "bauch",
    "Pfffff, der flachste ist das aber auch nicht gerade! ;)");
    
  AddDetail( "leben",
    "Die gefaehrliche Wueste kann Deinem Leben ein jaehes Ende bereiten, wenn Du "
    "nicht aufpasst.");
    
  AddDetail( ({ "held", "helden" }),
    "Zaehlst Du Dich etwa zu den Helden? *lach*");
    
  AddDetail( "kleinigkeiten",
    "Die sind viel zu klein, um sie sehen zu koennen.");
    
  AddDetail( "horizont",
    "Am Horizont siehst Du ein kleines Woelkchen.");
    
  AddDetail( "opfer",
    "Das naechste Opfer koenntest vielleicht schon Du sein.");
    
  AddDetail( "tiere",
    "Es gibt wirklich sehr viele. Einige davon laufen sogar hier auf dem Friedhof "
    "umher.");
    
  AddDetail( ({ "pflanzenbestimmung", "bestimmung" }),
    "Du solltest Dich eher mit anderen Dingen beschaeftigen als mit der Bestimmung "
    "von Pflanzen.");
    
  AddDetail( "ende",
    "Noch ist es nicht da, aber es naht schoen langsam...");
    
  AddDetail( "dinge",
    "Sieh Dich einmal um! Rings um Dich sind soooo viele Dinge!");
    
  AddDetail( "nase",
    "Die Nase ist bei Dir mitten im Gesicht.");
    
  AddDetail( "gesicht",
    "Ohne Spiegel kannst Du Dein Gesicht irgendwie schlecht anschauen.");
  

  AddSound( DEFAULT_SOUND,
	"Du lauschst, hoerst aber nur Dein Herz klopfen.");
	
  AddSound( "herz",
    "*poch* *poch* *poch*");
    

  AddSmell( DEFAULT_SMELL,
	"Heisse Wuestenluft dringt in Deine Nase.");
	
  AddSmell( ({ "wuestenluft", "luft" }),
    "Jetzt erst bemerkst Du einen zarten Geruch.");
    
  AddSmell( "geruch",
    "Riecht es hier nicht ein bisschen nach Fleisch?");
    
  AddSmell( "fleisch",
    "Zumindest riecht es hier nicht nach so verdorbenem Fleisch wie auf dem Rest des "
    "Friedhofes. Bloss woher kommt dieser Geruch?");

  AddCmd( ({ "stolper", "stolpere" }), "stolperfkt");
 
  AddItem( NPC "zebra", REFRESH_DESTRUCT );


  AddExit( "norden", ([ EX_DEST : "./room-c3",
                        EX_TESTFUNC: #'kaeferfkt ]) );

  AddExit( "nordosten", ([ EX_DEST : "./room-d3",
                           EX_TESTFUNC: #'kaeferfkt ]) );

  AddExit( "westen", ([ EX_DEST : "./room-b4",
                        EX_TESTFUNC: #'kaeferfkt ]) );

  AddExit( "nordwesten", ([ EX_DEST : "./room-b3",
                            EX_TESTFUNC: #'kaeferfkt ]) );
}

int kaeferfkt() {
  object ob;
  if(!query_once_interactive(TP)) return 1;
  if(kaefer != 1) return 1;
  if(present("kaefer",ME)) return 1;
  ob=clone_object( NPC "kaefer" );
  if(ob) {
    write(BS(
      "Als Du versuchst weiterzugehen, stolperst Du und landest mit Deiner "
      "Nase direkt vor einem aufgescheuchten Kaefer. Der Kaefer greift Dich "
      "entsetzt an."));
    say(BS(
      CAP_TPN+" stolpert und landet mit der Nase auf dem Boden."), ({ TP }) );
    say(BS(
      "Ein kleiner Kaefer greift "+TPN+" ploetzlich an!"), ({ TP }) );
    kaefer=0;
    ob->move(ME,M_GO | M_SILENT);
    ob->Kill(TP);
    return 0;
  }
  return 1;
}

reset() {
  ::reset();
  if(!present("kaefer",ME)) kaefer=1;
}

int stolperfkt(string str) {
  write(BS(
    "Du stolperst ueber die kleine Wurzel."));
  say(BS(
    CAP_TPN+" stolpert ueber die kleine Wurzel."));
  return 1;
}
