#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

int sand;
string wer;

create() {

  ::create();

  sand=1;
  wer="";

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "Du wanderst weiter und stehst jetzt ganz im Osten des Elefantenfriedhofes. "
    "Dein Blick faellt sofort auf ein riesiges Skelett, das genau vor Dir liegt. "
    "Suedlich von Dir kannst Du hohe Sandduenen sehen, waehrend sich weiter im Osten "
    "die Wueste ganz flach erstreckt. Sandverwehungen haben hier auf dem Boden "
    "alles abgedeckt, so dass ausser Sand nicht viel zu erkennen ist.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );


  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
	"Hier ziehen sich alte, kranke und schwache Elefanten zurueck, um ihren Tod zu erwarten. "
	"Ihre Ueberreste locken aber auch viele andere Tiere an.");
	
  AddDetail( ({ "blick" }),
	"Du erblickst ein riesiges Skelett vor Dir.");

  AddDetail( ({ "skelett" }),
	"Riesig ist gar kein Ausdruck dafuer. Es ist bestimmt einige Meter hoch und endet "
	"irgendwo, wo die Luft schon flimmert. Ob das ueberhaupt einmal ein Elefant war?\n"
	"Die ueberdimensionalen Rippen sehen aus wie Leitersprossen, und die Wirbelsaeule "
	"ist lang genug, dass man auf ihr rutschen koennte.");
	
  AddDetail( ({ "sandduenen", "sandduene", "duene", "duenen" }),
	"Im Sueden wird der Friedhof durch vier hohe Sandduenen abgegrenzt.");
	
  AddDetail( ({ "wueste" }),
	"Da solltest Du unbedingt einmal hingehen. Aber Vorsicht, die Tiere dort sind angeblich "
	"sehr aggressiv!");
	
  AddDetail( ({ "sandverwehungen", "verwehungen" }),
	"Wenn der Wind hier einmal wuetet, verblaest er den Sand von den Duenen auf den Boden.");
  
  AddSpecialDetail( ({ "boden" }), "bodenfkt" );
  
  AddDetail( ({ "sand" }),
	"Im grellen Sonnenlicht sieht der Sand fast weiss aus.");
  
  AddDetail( ({ "osten" }),
	"Im Osten liegt die weite Wueste.");
  
  AddDetail( ({ "vorsicht" }),
	"Aufpassen musst Du schon selbst!");
  
  AddDetail( ({ "sueden" }),
	"Im Sueden ragen vier hohe Sandduenen in den Himmel.");
  
  AddDetail( ({ "elefanten" }),
	"Momentan sind keine hier.");
  
  AddDetail( ({ "tiere" }),
	"Die Tiere, die durch die Ueberreste der Elefanten angelockt werden, sind hauptsaechlich "
	"Raubtiere und Aasfresser.");
  
  AddDetail( ({ "tod" }),
	"Sei vorsichtig, sonst begegnest Du ihm frueher als Dir lieb ist!");
	
  AddDetail( ({ "ueberreste" }),
	"Der Geruch der Ueberreste lockt Raubtiere und Aasfresser an.");

  AddDetail( ({ "meter", "hoehe" }),
	"Du hast keine Ahnung, wie hoch das Skelett ist. Durch die flimmernde Luft kannst Du das "
	"leider nicht abschaetzen.");

  AddDetail( ({ "luft" }),
	"Durch die Hitze beginnt in der Ferne die Luft zu flimmern, so dass Du gar nicht "
	"erkennen kannst, wie weit das Skelett in die Hoehe ragt.");

  AddDetail( ({ "rippen" }),
	"Die Rippen sind von der Sonne ausgeblichen und weisen keinerlei Fleischreste auf. "
	"Durch ihre Anordnung erinnern sie Dich irgendwie an Leitersprossen.");

  AddDetail( ({ "leitersprossen", "sprossen" }),
	"Die Rippen fuehren hoch hinauf in den Himmel. Man koennte vermuten, dass man von "
	"da oben auch wieder irgendwie hinunterkommt.");

  AddDetail( ({ "wirbelsaeule" }),
	"Die Wirbelsaeule des Skeletts ist so lang, dass man sicher muehelos darauf rutschen "
	"koennte. Wenn da bloss nicht diese spitzen Fortsaetze waeren...");

  AddSpecialDetail( ({ "sandschicht","schicht" }), "sandfkt" );
  
  AddSpecialDetail( ({ "sandhaufen","haufen" }), "haufenfkt" );

  AddSpecialDetail( ({ "jemand","spass" }), "jemandfkt" ); 
 
  AddDetail( ({ "fortsaetze", "fortsatz" }),
	"Autsch, sind die spitz!!!");
	
  AddDetail( ({ "wirbel" }),
    "Zwischen allen Wirbeln sitzen diese ekelhaft spitzen Fortsaetze.");

  AddDetail( ({ "sonnenlicht", "gelb" }),
	"Die Sonne brennt wieder einmal in ihrem grellsten Gelb vom Himmel.");

  AddDetail( ({ "sonne" }),
	"Sie ist so hell, dass Du nicht laenger hinsehen kannst.");

  AddDetail( ({ "himmel" }),
	"Als Du zum Himmel hinaufschaust, siehst Du nur grelles Licht. Die Sonne ist "
	"einfach zu hell, um mehr zu erkennen.");

  AddDetail( ({ "raubtiere" }),
	"Mit ihren scharfen Zaehnen koennen sie Dir stark blutende Wunden zufuegen.");

  AddDetail( ({ "aasfresser" }),
	"Aasfresser interessieren sich erst fuer Dich, wenn Du tot bist. Lebend stinkst "
	"Du ihnen zu wenig. ;)");

  AddDetail( ({ "westen", "norden" }),
	"Wenn Du wissen willst, was dort ist, dann geh doch einfach hin!");

  AddDetail( ({ "licht" }),
	"Es ist viel zu hell, um laenger hinauf zu sehen.");

  AddDetail( ({ "zaehne" }),
	"Die Zaehne von Raubtieren koennen Dir tiefe Wunden ins Fleisch reissen.");

  AddDetail( ({ "wunden" }),
	"Falls Du Wunden hast, sieh zu, dass sie bald versorgt werden! Sonst lockt "
	"Dein Blut noch boese wilde Tiere an! ");

  AddDetail( ({ "ferne" }),
	"Die ist ziemlich weit weg.");
	
  AddDetail( ({ "fleischreste" }),
	"Auf den Knochen sind keine mehr. Die sind wohl schon alle abgefressen worden "
	"oder in der Hitze verfault.");

  AddDetail( ({ "geruch" }),
	"Vielleicht solltest Du es einmal mit riechen probieren!");

  AddDetail( ({ "hitze" }),
	"Die Hitze ist fast unertraeglich. Alles flimmert schon, weil es so heiss ist.");

  AddDetail( ({ "ahnung" }),
	"Ahnung? Keine Ahnung, ob man so etwas sehen kann...");

  AddDetail( ({ "anordnung" }),
	"Die Rippen sind wie Leitersprossen angeordnet, die man prima hinaufklettern "
	"koennte.");

  AddDetail( ({ "fleisch" }),
	"Dein eigenes Fleisch ist hoffentlich gut geschuetzt unter Deiner Ausruestung.");

  AddDetail( ({ "knochen" }),
	"Die Knochen, die Du hier siehst, ergeben zusammen ein wunderbares Skelett.");
	
  AddDetail( ({ "blut" }),
    "Gluecklicherweise siehst Du kein Blut an Dir.");
    
  AddDetail( ({ "grabstein", "grabsteine" }),
    "Stark verwittert sehen die Grabsteine schon aus. Wahrscheinlich sind sie aus "
    "Sandstein gemeisselt worden.");
   
  AddDetail( ({ "sandstein", "sandsteine", "stein", "steine" }),
    "Hier auf dem Friedhof sind wohl alle Steine Sandsteine.");

  AddSpecialDetail( ({ "grab","graeber" }), "grabfkt");

  AddSpecialDetail( ({ "ausruestung" }), "ausruestfkt");

  AddSound( DEFAULT_SOUND,
	"Du hoerst die Knochen knacksen.");
	
  AddSound( ({ "knochen", "knacks", "knaaaacks" }),
    "*KNAAAACKS* Hoffentlich waren das nicht Deine Knochen!!!");

  AddSmell( DEFAULT_SMELL,
	"Ganz schwach kannst Du den Verwesungsgeruch erkennen, der von den verfaulten "
	"Ueberresten ausgeht.");
	
  AddSmell( ({ "verwesungsgeruch", "geruch" }),
	"Eigentlich ist er hier gut auszuhalten. Du stehst ja auch nicht mitten vor einem "
	"frischen Kadaver.");
	
  AddSmell( ({ "ueberreste" }),
    "Nachdem hier so gut wie kein Fleisch mehr irgendwo dran ist, stinkt es auch nicht "
    "so nach Aas.");
    
  AddSmell( ({ "aas" }),
    "Dir ist frisches Fleisch weitaus lieber als verfaultes.");

  
  AddExit( "norden",     "./room-d2" );
  AddExit( "suedwesten", "./room-c4" );  
  AddExit( "westen",     "./room-c3" );
  AddExit( "nordwesten", "./room-c2" );

  AddCmd( ({ "rutsch","rutsche" }), "rutschfkt");
  AddCmd( ({ "kletter","klettere" }), "kletterfkt");
  AddCmd( ({ "blas","blase","pust","puste" }), "blasfkt");
}

string grabfkt(string str) {
  if(sand==1) return 0;
  return GRABMASTER->ShowGraeber();
}

int rutschfkt(string str) {
  notify_fail("Wo moechtest Du denn rutschen?\n");
  if(str != "rutsche" && str != "auf rutsche" &&
     str != "rutsche runter" && str != "runter" && str != "wirbelsaeule runter" &&
     str != "wirbelsaeule" && str != "auf wirbelsaeule" && str != "ueber wirbelsaeule") return 0;
  write(BS(
    "Du kletterst wagemutig ueber die Rippen auf den Kopf des "
    "Skeletts und setzt Dich auf das Stirnbein."));
  say(BS(
    CAP_TPN+" klettert wagemutig ueber die Rippen auf den "
    "Kopf des Skeletts."));
  write("\n");
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 120, 
                              PARALYZE_MSG: "Das Rutschen erfordert Deine ganze "
                                            "Konzentration.\nDu hast einfach nicht "
                                            "die Nerven, etwas anderes nebenbei "
                                            "zu tun.\n",
                              PARALYZE_MSG_OTHER: "",
                              PARALYZE_END: "",
                              PARALYZE_END_OTHER: ""
                           ]) );
                           
  TP->SetProp(P_BLIND, ([ BLIND_TIME: 120,
                          BLIND_MSG: "Das Rutschen erfordert Deine ganze "
                                     "Konzentration.\nDu hast einfach nicht "
                                     "die Nerven, etwas anderes nebenbei "
                                     "zu tun.\n",
                          ]) );
  call_out("seq1",4);
  return 1;
}

void seq1() {
  if(!present(TP,ME)) return;
  write(BS(
    "Dir schlottern die Knie und Du bist Dir gar nicht "
    "so sicher, ob das jetzt eine gute Idee war."));
  write("\n");
  say(BS(
    "Du hoerst die Knie von "+TPN+" ueber Dir klappern."));
  call_out("seq2",4);
}

void seq2() {
  if(!present(TP,ME)) return;
  write(BS(
    "Du nimmst all Deinen Mut zusammen, machst kurz die Augen "
    "zu und stoesst Dich ab. Hurtig ratterst Du die Halswirbel "
    "hinunter."));
  write("\n");
  say(BS(
    CAP_TPN+" rutscht los und rattert ueber die Halswirbel "
            "ueber Deinen Kopf hinweg."));
  call_out("seq3",5);
}

void seq3() {
  if(!present(TP,ME)) return;
  write(BS(
    "Als Du die steile Wirbelsaeule hinunterrutschst, erreichst "
    "Du ein Tempo, bei dem Dir ein wenig Angst in die Glieder faehrt."));
  write("\n");
  say(BS(
    "Du schaust kurz hinauf und siehst den aengstlichen Gesichtsausdruck "
    "von "+TPN+"."));
  call_out("seq4",5);
}

void seq4() {
  if(!present(TP,ME)) return;
  write(BS(
    "Im Geschwindigkeitsrausch siehst Du alle moeglichen Knochen "
    "und Gebeine an Dir vorbeihuschen."));
  write("\n");
  call_out("seq5",5);
}

void seq5() {
  if(!present(TP,ME)) return;
  write(BS(
    "Nie haettest Du Dir gedacht, dass eine Rutschpartie selbst in "
    "Deinem hohen Alter noch soviel Spass machen kann. Du schreist "
    "vergnuegt: JUHUIII!!!!!"));
  write("\n");
  say(BS(
    "Du hoest ein vergnuegtes 'JUHUIII'. Anscheinend geniesst "
    ""+TPN+" die Rutschpartie bereits wie ein kleines Kind."));
  call_out("seq6",5);
}

void seq6() {
  if(!present(TP,ME)) return;
  write(BS(
    "Mittlerweile gefaellt es Dir hier oben so gut, dass Du "
    "am liebsten endlos weiterrutschen moechtest."));
  write("\n");
  if (QUESTMASTER->stone_found(1))
    call_out("seq_stone",5);
  else
    call_out("seq7",5);
}

void seq_stone() {
  if(!present(TP,ME)) return;
  write(BS(
    "Auf einmal spuerst Du einen reissenden Schmerz an Deinem "
    "Hinterteil. Sofort drehst Du Dich um und entdeckst ein "
    "kleines Steinplaettchen, welches Du sofort einsteckst."));
  write("\n");
  call_out("seq7",5);
}

void seq7() {
  if(!present(TP,ME)) return;
  write(BS(
    "Naja, leider ist alles Schoene auch einmal vorbei. "
    "Du siehst vor Dir bereits das Ende der Schwanzwirbelsaeule. Schade, "
    "dabei war's gerade jetzt so schoen!"));
  write("\n");
  call_out("seq99",5);
}

void seq99() {
  if(!present(TP,ME)) return;
  write(BS(
    "Du schlaegst hart auf dem Boden der Realitaet auf."));
  write("\n");
  say(BS(
    "Du hoerst in der Ferne ein dumpfes 'Plumps'."));
  TP->SetProp(P_PARALYZED, 0);
  TP->SetProp(P_BLIND, 0);
  TP->move( ROOM "room-e2", M_GO, 0,
    "schreit in der Ferne laut auf",
    "fliegt in hohem Bogen mitten vor Deine Fuesse" );
  return;
}

int kletterfkt(string str) {
  write(BS(
    "Nix da! Du willst ja nicht klettern, sondern ueber die Wirbelsaeule ru......!"));
  return 1;
}

string sandfkt(string str) {
  if (sand==1) {
	return BS(
	  "Leider bedeckt die Sandschicht alles, das sich darunter befindet. Vielleicht kannst "
  	  "Du sie ja irgendwie wegbekommen?");
  }
  return BS(
  	"Der uebrige Sand laesst Dich nur noch vermuten, dass hier einmal eine "
  	"Sandschicht vorhanden war. Jetzt ist davon aber nichts mehr zu erkennen.");
}

string bodenfkt(string str) {
  if (sand==1) {
	return BS(
	  "Der Boden ist mit einer duennen, glatten Sandschicht ueberzogen. Mehr kannst Du nicht "
	  "erkennen.");
	}
  return BS(
    "Neben einem kleinen Sandhaufen siehst Du ein paar Graeber.");
}

int blasfkt(string str) {
  if (sand != 1) return 0;
  if(str == "sand") {
  	write(BS(
  	  "Wohin moechtest Du denn den Sand blasen?"));
  	return 1;
  }
  notify_fail("Was moechtest Du beiseite blasen?\n");
  if (str != "sand weg" && str != "sand beiseite") return 0;
  write(BS(
    "Du fuellst Deine starken Lungen mit viel Luft und "
    "blaest die Sandschicht zu einem kleinen Sandhaufen zusammen. Am "
    "Boden wird auf einmal etwas sichtbar."));
  say(BS(
    CAP_TPN+" holt auf einmal tief Luft und blaest ein wenig Sand zu "
    "einem Sandhaufen zusammen. Du runzelst die Stirn, entdeckst dafuer "
    "aber sogar etwas auf dem Boden!"));
  wer=CAP(getuid(TP));
  sand=0;
  return 1;
}

reset() {
  if(sand==0)
    tell_room(ME,BS(
      "Ein kleiner Windstoss kommt auf und verteilt einen kleinen Sandhaufen "
      "ueber den ganzen Boden."));
  ::reset();
  sand=1;
  wer="";
}

string haufenfkt(string str) {
  if(sand==1) 
    return BS(
      "Wo bitte siehst Du hier einen Sandhaufen? Falls hier einmal ein "
      "Sandhaufen war, wurde der sicher durch den Wind ueber den Boden "
      "verteilt.");
  return BS(
    "Ein kleiner Sandhaufen verweilt gelangweilt direkt neben Dir. "
    "Jemand hat sich wohl den Spass erlaubt und ihn hier entstehen "
    "lassen.");
}

string jemandfkt(string str) {
  if(sand==1) return 0;
  return BS(
    "Der Jemand war wohl "+wer+". Aber ganz sicher bist Du Dir da nicht. "
    ""+wer+" muss kuenstlerisch ganz schoen begabt sein!?! So ein "
    "schoener Sandhaufen!!!");
}

string ausruestfkt(string str) {
	TP->command_me("ausruestung");
	return "\n";
}

