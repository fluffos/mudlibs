#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>

int hyaene;

create() {
  ::create();
  hyaene=1;

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
    "In der nordoestlichen Ecke des Elefantenfriedhofes sind nur ganz wenige "
    "Spuren zu erkennen. Die erkennbaren Spuren sind viel kleiner als die der "
    "Elefanten auf dem Rest des Friedhofes und fuehren direkt in einen "
    "riesigen Schaedel hinein. Auf dem Boden liegen hier aber trotzdem "
    "zahlreiche Knochen herum. Zwischen ein paar kleinen Steinen waechst "
    "hier doch tatsaechlich auch ein wenig Gras." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 28+random(5), 
                            ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "ecke", "ecken" }),
    "Naja, richtige Ecken siehst Du hier eigentlich keine. Man sagt das halt nur so.");
    
  AddDetail( ({ "elefantenfriedhof", "friedhof" }),
    "An diesen Ort kommen die Elefanten um zu sterben. Sie verlassen dafuer ihre Herde "
    "und schlafen hier fuer immer ein.");
    
  AddDetail( ({ "spuren", "spur" }),
    "Hier kannst Du eigentlich nur kleine Spuren auf dem Boden erkennen.");
    
  AddDetail( "elefanten",
    "Jetzt faellt's Dir wieder ein: Das sind doch die grossen, grauen Tiere mit dem "
    "langen Ruessel! :)))");
    
  AddDetail( "rest",
    "Damit ist der restliche Friedhof gemeint.");
    
  AddDetail( ({ "schaedel", "schaedelknochen" }),
    "Vor Dir liegt ein riesengrosser Schaedelknochen. Sicher stammt er von einem "
    "Elefanten, der hier gestorben ist. Er ist so gross, dass Du echt froh bist, diesem "
    "Tier nie zu Lebzeiten begegnet zu sein. Aber jetzt, wo offensichtlich keine "
    "Gefahr mehr von ihm ausgeht, wuerdest Du ihn Dir am liebsten einmal genauer ansehen.");
    
  AddDetail( "boden",
    "Auf dem Boden liegen etliche Knochen herum. Vereinzelt kannst Du hier auch zwischen den "
    "Steinen etwas Gras sehen.");
    
  AddDetail( "knochen",
    "Die Knochen, die hier herumliegen, stammen sicher teilweise von Elefanten, aber auch von "
    "anderen Tieren.");
    
  AddDetail( "steine",
    "Sie sind recht klein und spitz. Ein besonders winziger Stein faellt Dir irgendwie auf.");
    
  AddDetail( ({ "stein", "winziger stein", "winzigen stein" }),
    "Du bueckst Dich und betrachtest den kleinen Stein genauer. Er ist etwas abgerundeter als "
    "die anderen Steine und hat eine sonderbare Form.");
    
  AddDetail( "form",
    "Der Stein sieht irgendwie aus wie ein kleiner Elefant. Du kannst direkt die Ohren, den "
    "Ruessel und die Beine erkennen. Oder sieht der Stein doch ganz normal aus und Du hast schon "
    "Wahnvorstellungen wegen der Hitze?");
    
  AddDetail( ({ "gras", "grasbueschel", "bueschel", "grashalm", "grashalme", "halm", "halme" }),
    "Ein paar duerre Grasbueschel wachsen zwischen den Steinen. Eine kleine "
    "Distel sticht Dir fast in Deine Augen.");

  AddDetail( ({ "augen","auge" }),
    "Deine Augen sind dort wo sie schon immer waren.");
    
  AddDetail( "himmel",
    "Der Himmel ist ganz klar und strahlend blau. Du siehst nicht einmal ein kleines Woelkchen "
    "ueber Dir.");
    
  AddDetail( "ort",
    "Damit ist wohl der Elefantenfriedhof gemeint.");
    
  AddDetail( ({ "herde", "herden" }),
    "Elefanten leben in Herden. Ihr Zusammenhalt innerhalb der Familie ist sehr stark und sie "
    "wuerden es wohl nie zulassen, dass einem Familienmitglied etwas Boeses widerfaehrt. Merkt "
    "allerdings ein alter oder schwacher Elefant, dass sich sein Leben dem Ende zuneigt, verlaesst "
    "er seine Herde, um in Ruhe sterben zu koennen.");
    
  AddDetail( "tiere",
    "Du weisst echt nicht, was Tiere sind??? Jetzt schaem Dich aber!");
    
  AddDetail( "ruessel",
    "Der Ruessel ist bei Elefanten die verlaengerte Nase, die mit der Oberlippe verwachsen ist.");
    
  AddDetail( "tier",
    "Dieses Tier - vermutlich ein Elefant - war wohl nicht gerade das kleinste. Wenn schon der "
    "Schaedel so gross ist, moechtest Du lieber gar nicht erst wissen, wie gross der restliche "
    "Koerper war.");
    
  AddDetail( ({ "gefahr", "gefahren" }),
    "Du bist Dir ziemlich sicher, dass Du hier keinerlei Gefahren fuerchten musst.");
    
  AddDetail( "elefant",
    "Es ist gerade keiner hier.");
    
  AddDetail( ({ "ohren", "beine" }),
    "Mit ein wenig Phantasie kannst Du Ohren, Beine und Ruessel erkennen.");
    
  AddDetail( "wahnvorstellungen",
    "Es waere irgendwie kein Wunder, wenn Du die echt haettest. Es ist so heiss hier, dass Du "
    "kaum mehr klar denken kannst.");
    
  AddDetail( "wunder",
    "Wunder gibt's nicht.");
    
  AddDetail( "hitze",
    "Du kannst sie hier sehr deutlich spueren.");
    
  AddDetail( "sonne",
    "Die Sonne brennt ziemlich erbarmungslos auf Dich herab.");
    
  AddDetail( "familie",
    "Auch Du bist sicher einmal in einer Familie entstanden.");
    
  AddDetail( "boeses",
    "Damit kann vieles gemeint sein. Sicher bist Du dem auch schon oft begegnet.");
    
  AddDetail( "leben",
    "Noch bist Du am Leben. Sei vorsichtig und riskier nicht allzuviel, wenn Du es nicht "
    "verlieren willst.");
    
  AddDetail( "ende",
    "Das Ende naht oft schneller als Dir lieb ist.");
    
  AddDetail( "ruhe",
    "So etwas kann man doch nicht sehen.");
    
  AddDetail( "nase",
    "Gottseidank ist Deine Nase nicht ganz so lang wie ein Elefantenruessel. :)");
    
  AddDetail( "oberlippe",
    "Deine Oberlippe ist hoffentlich noch dort, wo sie zuletzt war. ;)");
    
  AddDetail( "elefantenruessel",
    "Waere Deine Nase so lang wie ein Elefantenruessel, haettest Du wohl arge Probleme, einen "
    "passenden Helm zu finden. ;)");
    
  AddDetail( "koerper",
    "Von dem Koerper ist ausser ein paar Knochen nichts mehr uebrig.");
    
  AddDetail( "phantasie",
    "Die kann man nicht sehen. Entweder hat man sie oder man hat sie nicht.");
    
  AddDetail( "probleme",
    "Hin und wieder hat wohl jeder welche. Aber die meisten Probleme kann man eh problemlos "
    "meistern.");
    
  AddSound( DEFAULT_SOUND,
    "Es ist totenstill. Du kannst ueberhaupt nichts hoeren.");
   
  AddSmell( DEFAULT_SMELL,
    "Das einzige, das Du hier riechen kannst, ist verdorbenes Fleisch.");

  AddSmell( "fleisch",
    "Waehhhh, wie das stinkt!");

  AddSpecialDetail( "distel" , "distelfkt" );

  AddExit( "sueden",     "./room-c2" );
  AddExit( "suedosten",  "./room-d2" );
  AddExit( "suedwesten", "./room-b2" );
  AddExit( "westen",     "./room-b1" );
  
  AddCmd( ({ "erforsch","erforsche" }), "erforschfkt" );
}


int erforschfkt(string str) {
  object ob1,ob2;
  notify_fail("Was genau willst Du erforschen?\n");
  if(str != "schaedel" && str != "schaedel genauer") return 0;
  if(str == "schaedel") {
    write(BS(
      "Du kannst so auf die Schnelle gar nicht soviel erkennen. Es ist auf "
      "jeden Fall ein sehr unheimlicher Schaedel. Wenn Du ihn trotz aller "
      "moeglichen Gefahren mehr erforschen willst, solltest Du dieses "
      "genauer machen."));
    return 1;
  }
  if(hyaene != 1) {
    write(BS(
      "Du hast einfach nicht genug Mut, den Schaedel genauer zu untersuchen. "
      "Die Erfahrungen aus Deiner Vergangenheit hindern Dich einfach "
      "daran!"));
    return 1;
  }
  hyaene=0;
  write(BS(
    "Du versuchst den Schaedel genauer zu erforschen und hoerst aus dem "
    "Inneren auf einmal fletschende Geraeusche. Bevor Du ueberhaupt realisieren "
    "kannst, was hier vor sich geht, stuerzen schon zwei Hyaenen aus dem "
    "Schaedel heraus und greifen Dich an!"));
  say(BS(
    CAP_TPN+" versucht den Schaedel genauer zu erforschen und scheucht ein "
    "paar Hyaenen auf, die auch sofort angreifen!"), ({ TP }) );
  ob1=clone_object( NPC "hyaene" );
  ob2=clone_object( NPC "hyaene" );
  if(ob1) {
    ob1->move(ME, M_GO | M_SILENT);
    ob1->Kill(TP);
  }
  if(ob2) {
    ob2->move(ME, M_GO | M_SILENT);
    ob2->Kill(TP);
  }
  return 1;
}

reset() {
  ::reset();
  if(!present("hyaene",ME)) hyaene=1;
}

string distelfkt(string str) {
  if(QUESTMASTER->stone_found(3)) {
    TP->AddHp(-(10+random(10)));
    return BS(
      "Die Distel waechst zwischen den Grashalmen, kann sich aber dennoch "
      "gut behaupten. Dir faellt auf einmal ein Plaettchen mitten in der "
      "Distel auf. Neugierig wie Du bist nimmst Du das Plaettchen an Dich. "
      "Leider verletzt Du Dich dabei ein wenig.");
  }
  return BS(
    "Die Distel waechst zwischen den Grashalmen, kann sich aber dennoch "
    "gut behaupten.");
}

