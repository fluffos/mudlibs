#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

int rose;

create() {
  ::create();

  rose=1;

  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
	  "Du erreichst nun einen schmalen Weg, der den Elefantenfriedhof mit "
	  "der offenen Wueste verbindet. Auf dem Boden findest Du hier weitaus "
	  "weniger Knochen als auf dem uebrigen Friedhofsgelaende. Bei jedem "
	  "Schritt sinkst Du ein wenig tiefer im Sand ein. Rechts und links "
	  "von Dir saeumen einige Steinbloecke den Weg. Viel siehst Du nicht "
	  "von der Umgebung, denn Dein Blick ist eher nach unten gerichtet, "
	  "damit Du nicht direkt in die pralle Sonne schauen musst." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 34+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );

  SetProp(P_HIDE_EXITS, ({"westen", "osten"}) );
  
  
  AddDetail( ({ "weg" }),
    "Der Weg neigt sich von Westen nach Osten zur Wueste hinunter.");

  AddDetail( ({ "elefantenfriedhof", "friedhof", "friedhofsgelaende",
                "gelaende" }),
    "Richtung Westen kannst Du den gesamten Friedhof ueberschauen. Die weiter "
    "entfernten Stellen flimmern allerdings ein wenig.");

  AddDetail( ({ "wueste" }),
    "Die offene Wueste liegt ein wenig tiefer als der Elefantenfriedhof.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht hier vorwiegend aus Sand. Nur mehr wenige Knochen "
    "liegen herum. Er ist auch viel weicher als auf dem restlichen "
    "Friedhof.");
    
  AddDetail( ({ "knochen" }),
    "Viele Knochen siehst du hier nicht herumliegen. Obwohl sie im grellen "
    "Sonnenlicht in den verschiedensten Farben schillern, beschliesst Du, "
    "Dich nicht weiter dafuer zu interessieren.");

  AddDetail( ({ "schritt" }),
    "Jeder Schritt laesst Dich mehr und mehr im Sand einsinken. Solange Du "
    "nicht einmal in Treibsand geraetst, ist es aber nicht so tragisch.");

  AddDetail( ({ "sand" }),
    "Der Sand leuchtet im hellen Sonnenlicht ganz weiss. An einer Stelle "
    "sieht er sogar aus, als haette er eine bestimmte Form.");

  AddDetail( ({ "steinbloecke", "bloecke", "steinblock", "block" }),
    "Die Steinbloecke bestehen aus Sandstein und sind wahrscheinlich "
    "von den hohen Bergen im Sueden abgesplittert.");
    
  AddDetail( ({ "umgebung" }),
    "Von der Umgebung siehst Du nicht so viel, da Du Dein Gesicht zum Boden "
    "gerichtet hast.");
    
  AddDetail( ({ "gesicht" }),
    "Du tastest Dein Gesicht ab und stellst fest, dass es sich eigentlich "
    "ganz passabel anfuehlt. Wenn bloss die vielen Pickel nicht waeren!!!");
    
  AddDetail( ({ "pickel" }),
    "Naja, Du hattest schon mal weniger... Dafuer hast Du jetzt weniger "
    "Platz fuer neue. :)");
    
  AddDetail( ({ "platz" }),
    "Viel Platz fuer neue Pickel hast Du in Deinem Gesicht wahrlich nicht.");
    
  AddDetail( ({ "panik", "hilfe" }),
    "!!! PANIK !!! HILFE !!!");

  AddDetail( ({ "blick" }),
    "Da Dich die liebe Sonne so stark blendet, hast Du Deinen Blick nach "
    "unten gerichtet.");

  AddDetail( ({ "sonne" }),
    "Die Sonne ist so grell, dass Du nicht lange hineinschauen kannst.");

  AddDetail( ({ "himmel" }),
    "Wolkenlos und strahlend blau erstreckt sich der Himmel ueber Dir.");
  
  AddDetail( ({ "stellen" }),
    "Du laesst Deine Augen ueber den Friedhof wandern und bemerkst in der "
    "Ferne nur mehr sehr schemenhaft die Grenzen des Friedhofes.");

  AddDetail( ({ "augen", "auge" }),
    "Du waerst der erste, der seine Augen ohne Spiegel sehen kann. ;)");

  AddDetail( ({ "ferne", "grenzen", "grenze" }),
    "Durch die hohe Temperatur verschwimmen die Grenzen in der Ferne.");

  AddDetail( ({ "temperatur" }),
    "Wie hoch die Temperatur ist, kannst Du wohl nur mit einem Thermometer "
    "genau messen.");
    
  AddDetail( ({ "sonnenlicht" }),
    "Im Sonnenlicht schauen die herumliegenden Knochen irgendwie bunt aus, "
    "und der Sand leuchtet ganz weiss. Ob Du Dir das nur einbildest, weil Du "
    "von der Hitze schon etwas verwirrt bist?");

  AddDetail( ({ "farben", "farbe" }),
    "Die Knochen erscheinen in den verschiedensten Farben: weiss, grau, gelb, "
    "braun, schwarz, blau, lila, gruen und rot. Manche Farben kommen Dir ja "
    "noch halbwegs normal vor, andere hingegen zweifelst Du ein bisschen an. "
    "Naja, die Hitze eben...");

  AddDetail( ({ "hitze" }),
    "Hier ist es viel zu heiss, um sich wohlzufuehlen.");

  AddDetail( ({ "treibsand" }),
    "Wenn man Treibsand vorher schon erkennen koennte, waere er nicht so "
    "fuerchterlich gefaehrlich! Meistens erkennt man ihn erst, wenn man mitten "
    "drin steckt. :(");
    
  AddDetail( ({ "stelle" }),
    "Du findest eine Stelle im Sand, die ein wenig anders aussieht als die "
    "anderen.");

  AddDetail( ({ "form" }),
    "Die Form erinnert Dich an eine Sandrose.");

  AddDetail( ({ "berge", "berg", "sueden" }),
    "Im Sueden erstreckt sich ein riesiges Gebirge.");

  AddDetail( ({ "sandstein" }),
    "Sandstein ist sehr witterungsanfaellig. Es kann schon einmal leicht "
    "passieren, dass Teile eines Felsens abbrechen und tief hinunter stuerzen.");
    
  AddDetail( ({ "westen" }),
    "Der Elefantenfriedhof liegt im Westen.");
    
  AddDetail( ({ "osten" }),
    "Dort liegt die offene Wueste.");
    
  AddDetail( ({ "gebirge" }),
    "Die hohen Berge gehoeren zum Tibesti-Gebirge.");
    
  AddDetail( ({ "tibesti-gebirge", "tibesti", "tibestigebirge" }),
    "Das Tibesti-Gebirge trennt den Elefantenfriedhof und die offene Wueste "
    "von der Steppe.");
    
  AddDetail( ({ "steppe", "seite" }),
    "Die Steppe liegt viel weiter im Westen, auf der anderen Seite des "
    "Gebirges.");
    
  AddDetail( ({ "teile", "felsen" }),
    "Hoffentlich trifft Dich kein Felsen!!! Das wuerde sicher Deinen Tod "
    "bedeuten!");
    
  AddDetail( ({ "tod" }),
    "Du haettest es dann wenigstens nicht so weit, zu einem Friedhof. ;)");
  

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein trampelndes Geraeusch.");
    
  AddSound( ({ "geraeusch" }),
    "Wahrscheinlich ist das das Trampeln einer Tierherde.");
    
  AddSound( ({ "trampeln", "tierherde", "herde" }),
    "Moeglicherweise sind das ganz viele Bueffel! Du geraetst in Panik.");
    
  AddSound( ({ "bueffel", "bueffelherde" }),
    "Du betest, dass es doch keine Bueffelherde ist, sondern irgendetwas "
    "Harmloses.");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es irgendwie nach Aas.");
    
  AddSmell( ({ "aas", "aasgeruch", "geruch" }),
    "Aasgeruch ist eigentlich nichts Ungewoehnliches fuer einen Friedhof.");
    
  AddSmell( ({ "friedhof" }),
    "Hast Du gedacht, auf einem Friedhof riecht es nach Himbeeren, oder was?");
    
  AddSmell( ({ "himbeeren", "himbeere" }),
    "Schoen waer's, aber hier riecht es leider nicht danach.");

  AddDetail("rose",
    "Du siehst hier keine Rose...");

  AddDetail("haufen",
    "Der Haufen an sich ist voellig uninteressant.");

  AddDetail("neues",
    "Das ist irgendwo unten im Sand.");

  AddDetail("wind",
    "Derzeit spuerst Du gar keinen Wind. Es ist einfach nur drueckend heiss.");

  AddSpecialDetail( "sandrose", "rosefkt" );

  AddItem( NPC "gnu", REFRESH_DESTRUCT );

  AddExit( "westoben", "./room-d2" );
  AddExit( "ostunten", "./room-f2" );
  AddExit( "westen",   "./room-d2" );
  AddExit( "osten",    "./room-f2" );
}

string rosefkt() {
  object ob;
  
  if(rose) {
    rose=0;
    ob=clone_object(OBJ "sandrose");
    ob->move(ME,M_NOCHECK);
    return BS(
      "Tatsaechlich!!! Der Sand hat an der Stelle wirklich die Form einer "
      "Sandrose. Wenn Du vorsichtig genug bist, kannst Du sie ja vielleicht "
      "sogar an Dich nehmen.");
  }
  return BS(
    "Du musst Dich getaeuscht haben. Die Form erinnert Dich irgendwie "
    "doch nicht an eine Sandrose, sondern eher an einen vom Wind zusammen"
    "getragenen Haufen.");
}

reset() {
  ::reset();
  if(rose==0) tell_room(ME,BS(
    "Der Wind laesst im Sand unter Dir etwas Neues entstehen."));
  rose=1;
}
