
inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

knochen() {
  object ob;

  if(random(100)<95) {
    if(ob=present("\n_knochen",ME)) {
      ob->remove();
      tell_room(ME,BS(
        "Du trittst aus Versehen auf den Knochen und er "
        "zersplittert in tausend Stuecke."));
    }
  } else {
    if(!present("\n_knochen")) {
      ob=clone_object( OBJ "knochen" );
      ob->move(ME,M_NOCHECK);
    }
  }
}

reset() {
  ::reset();
  call_out("knochen",60);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  call_out("addgrab",10,victim,killer,lost_xp);
}

void addgrab(object victim, object killer, int lost_xp) {
  GRABMASTER->NeuesGrab(victim, killer, lost_xp);  
}

create() {
  ::create();
  
  call_out("knochen",60);
}

