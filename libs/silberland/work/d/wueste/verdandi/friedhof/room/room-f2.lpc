#include "../def.h"

inherit ROOM "room_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create() {

  ::create();


  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
  	"Du wanderst unermuedlich ueber den heissen Sandboden und wuerdest Dir am "
  	"liebsten alles moegliche ausziehen, nur um nicht so stark zu schwitzen. "
  	"Schweissperlen tropfen Dir von der Nase, als Du Dein Gesicht von der Sonne "
  	"abwendest. Die Hitze wird hier beinahe unertraeglich. Dein Kreislauf macht "
  	"da bestimmt nicht mehr lange mit! Sogar die Duenen in der Wueste erscheinen "
  	"Dir wie eine Fatamorgana." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 41+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );
  
  SetProp(P_HIDE_EXITS, ({"westen"}));

  
  AddDetail( ({ "sandboden", "boden" }),
    "Der Boden gibt bei jedem Schritt ein wenig nach. Hier duerfte der Sand "
    "sehr weich sein.");

  AddDetail( ({ "schweissperlen", "schweisstropfen" }),
    "Von Deiner Nase tropfen eklige Schweissperlen.");

  AddDetail( ({ "nase" }),
    "Jetzt haengt an Deiner Nase ein riesiger Schweisstropfen, der gleich "
    "abfallen wird. Pfui!!!");

  AddDetail( ({ "gesicht" }),
    "Dein Gesicht ist so stark verschwitzt, dass es glaenzt.");
  
  AddDetail( ({ "sonne" }),
    "Die Sonne kennt heute keine Gnade. Sie verbrennt Dich beinahe.");

  AddDetail( ({ "hitze" }),
    "Durch die Hitze kannst Du weder klar denken, noch kannst Du Dich auf Deine "
    "Augen voll verlassen. Es beginnt naemlich alles zu flimmern, was ein "
    "bisschen weiter entfernt ist.");

  AddDetail( ({ "kreislauf" }),
    "Dein Kreislauf macht Dir schwer zu schaffen. Du hast Angst, dass Dich bald "
    "Dein Bewusstsein verlaesst.");

  AddDetail( ({ "duenen", "sandduenen", "duene", "sandduene" }),
    "Riesige Sandduenen bauen sich schemenhaft vor Dir auf. Die Duenen gehoeren "
    "offenbar schon zur offenen Wueste. Durch die Hitze flimmert Dir jedoch "
    "alles vor den Augen, so dass Du nicht einmal genau sehen kannst, wie weit "
    "es bis dahin noch ist.");

  AddDetail( ({ "wueste" }),
    "Du stehst mit einem Bein schon fast in der offenen Wueste. Sie ist gleich "
    "im Osten neben Dir.");

  AddDetail( ({ "fatamorgana" }),
    "Du siehst allerhand Dinge, die gar nicht da sind. Dir kommt sogar vor, dass "
    "Du eine kleine Oase gesehen hast.");

  AddDetail( ({ "himmel" }),
    "Auf dem Himmel ist kein einziges Woelkchen zu sehen, das Dir ein wenig "
    "Schatten spenden koennte.");
    
  AddDetail( ({ "woelkchen" }),
    "Kein Woelkchen weit und breit.");

  AddDetail( ({ "sand" }),
    "Wenn der Sand nicht so schrecklich heiss waere, wuerdest Du gerne einmal "
    "darauf liegen.");
  
  AddDetail( ({ "kreise" }),
    "Als Du stolz Deine selbst gemalten Kreise bewunderst, glaubst Du im Sand "
    "etwas gesehen zu haben. War das nur Einbildung?");

  AddDetail( ({ "schritt", "schritte", "vorankommen" }),
    "Jeder Schritt erschwert das Vorankommen, da Du im weichen Sand einsinkst.");

  AddDetail( ({ "einbildung" }),
    "Dir war doch so, als wuerde sich da im Sand etwas verbergen...");

  AddDetail( ({ "schweiss" }),
    "Dein Schweiss stinkt erbaermlich!");

  AddDetail( ({ "gnade" }),
    "Gnade wirst Du im SilberLand nicht finden.");

  AddDetail( ({ "silberland", "sl" }),
    "Alles, was Du hier sehen kannst, gehoert zum SilberLand.");

  AddDetail( ({ "augen", "auge" }),
    "Eigentlich solltest Du 2 davon haben.");

  AddDetail( ({ "angst" }),
    "Du weisst nicht, wie lange Du noch aufrecht stehen kannst. Du bist "
    "knapp davor, zusammenzuklappen.");
  
  AddDetail( ({ "bewusstsein" }),
    "Noch hast Du Dein Bewusstsein. Aber wie lange noch?");

  AddDetail( ({ "schatten" }),
    "Schatten wirst Du hier keinen finden.");

  AddDetail( ({ "dinge" }),
    "Es gibt soooo viele Dinge...");
    
  AddDetail( ({ "bein" }),
    "Du hast ein rechtes und ein linkes. :)");

  AddDetail( ({ "oase" }),
    "Ups, jetzt ist sie wieder weg. Solltest Du Dir die Palmen nur eingebildet "
    "haben?");

  AddDetail( ({ "palmen", "palme" }),
    "Die Palmen sind wohl mit der Oase verschwunden. Schade, da waere es sicher "
    "angenehm kuehl gewesen.");

  AddDetail( ({ "fuss", "fuesse" }),
    "Du hast 2 verschiedene Fuesse - einen rechten und einen linken.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst den Schweiss auf den Boden tropfen.");
    
  AddSound( ({ "schweiss" }),
    "*tropf* *tropf*");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst Deinen eigenen Schweiss riechen. :(");
    
  AddSmell( ({ "schweiss" }),
    "Dir ekelt vor Dir selbst, so wie Du stinkst!");

  AddCmd( ({ "grab","grabe" }), "grabfkt" );
  AddCmd( ({ "lieg","liege" }), "liegefkt" );


//  AddExit( "westoben", "./room-e2" ); by PROtheG 2001-11-19
//  AddExit( "westen",   "./room-e2" ); 

  AddExit( ({ "westen", "westoben" }), 
	   ([ EX_DEST: "./room-e2",
	   EX_TESTFUNC: "ep_check" ]) );

  AddExit( "osten",    "/d/wueste/zordan/desert/room/desert:19:8" );
//  AddSpecialExit( "osten", "ostenfkt");
}

// Damit der EP-Check in hoehle-unten nicht ausgehebelt wird
int ep_check(string str) {
  if(!TP) return 1;
  if(!interactive(TP)) return 1;

  if(TP->QueryProp(P_XP) < 200000)
    return write(BS("Du fuehlst Dich noch zu unerfahren, um "
		    "weiterzugehen.")),0;
  
  return 1;
}

int ostenfkt(string str) {
  if(!IS_WIZARD(TP)) {
    write(BS(
      "Im Osten erstreckt sich die weite, offene Wueste. Leider ist es fuer "
      "Dich derzeit viel zu gefaehrlich dorthin zu gehen. (Oder aber irgendein "
      "Magier ist einfach noch nicht so weit! :))"));
    return 1;
  }
  write(BS(
    "Der Zugang zur Wueste ist Spielern noch verwehrt, Magiern natuerlich "
    "nicht. :)"));
  return TP->move( "/d/wueste/zordan/desert/room/desert:19:8", M_NOCHECK);
}

int grabfkt(string str) {
  notify_fail("Moechtest Du vielleicht im Sand graben?\n");
  if(str=="sand") return 0;
  
  notify_fail("Wo moechtest Du denn graben?\n");
  if(str != "in sand" && str != "im sand") return 0;

  say(BS(CAP_TPN+" buddelt wie ein verspieltes Kind im Sand herum."));
  if(QUESTMASTER->stone_found(7)) {
    write(BS(
      "Du graebst wie wild im Sand herum. Schon ganz euphorisch bist Du, als "
      "Deine linke Hand auf einmal einen harten Gegenstand entdeckt. Fast "
      "haettest Du Dir Deine Hand aufgeschnitten! Aber zumindest hast Du "
      "etwas gefunden. Das hebt wenigstens Deine Stimmung."));
    return 1;
  }
  write(BS(
    "Du graebst wie wild im Sand herum. Du wirst immer euphorischer bei "
    "Deiner Suche. Aber je laenger Du suchst, umso mehr musst Du erkennen, "
    "dass es hier wohl doch nichts zu finden gibt."));
  return 1;
}

int liegefkt(string str) {
	notify_fail( "Wo moechtest Du liegen?\n");
	if(str != "auf sand" && str != "auf boden" && str != "im sand" &&
	    str != "in sand" && str != "am boden" && str != "sand") return 0;
	write(BS(
	  "Der Sand ist Dir viel zu heiss zum Hinlegen. Du malst statt dessen mit "
	  "Deinem Fuss ein paar Kreise in den Sand."));
	return 1;
}
