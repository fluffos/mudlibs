
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string *hands;
int nr;

create() {
  ::create();

  hands = ({ });
  nr=0;

  SetProp( P_INT_SHORT, "In einer dunklen Hoehle" );
  SetProp( P_INT_LONG,
    "Mitten in einer kleinen, dunklen Hoehle im Tibesti-Gebirge findest "
    "Du Dich wieder. Schwaches Licht dringt von Westen her durch die "
    "Gebuesche vor dem Eingang herein. Du bist Dir nicht sicher, ob diese "
    "Hoehle kuenstlich oder natuerlich entstanden ist. Neben ein paar aus "
    "Stein geschlagenen Stufen faellt Dir ein grosser Felsblock am Ende "
    "der Hoehle auf." );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10+random(5), 
                            ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus massivem Felsgestein. Ein kleines Loch ganz weit "
    "oben kannst Du direkt unter den Stufen erkennen.");

  AddDetail( ({ "felsblock", "block" }),
    "Der Felsblock steht kerzengerade am Ende der Hoehle. Auf seiner Oberseite "
    "kannst Du etwas erkennen. In seiner Form kommt er nichts nahe, was Du "
    "bisher gesehen hast.");

  AddDetail( ({ "form" }),
    "Die Form des Felsblockes erinnert Dich irgendwie an einen Quader.");

  AddDetail( ({ "quader" }),
    "Aber es ist kein normaler Quader. Es ist eher einer, der Dir "
    "unmoeglich herzustellen vorkommt.");

  AddDetail( ({ "oberseite", "symbol" }),
    "  _-------------------_\n"
    " /$$$$$$$$$$$$$$$$$$$$$\\\n"
    "!$$$$$$$$$$$$' $ `$$$$$$!\n"
    "|$$$$$$$$$$$$  $  $$$$$$|\n"
    "|$$$$$$  $$$$  $  $$\"'$$|\n"
    "|$$$$$$$  '$$  $  $' .$$|\n"
    "!$$$$$$$$.  \"  $ .! .$$$|\n"
    "|$$$$$$$$$.    '    $$$$|\n"
    "|$$^^$$$$$'        J$$$$|\n"
    "|$$$   ~\"\"   `.   .$$$$$|\n"
    "|$$$$$e,      ;  .$$$$$$|\n"
    "|$$$$$$$$$$$.'   $$$$$$$|\n"
    "!$$$$$$$$$$$$.    $$$$$$!\n"
    " \\$$$$$$$$$$$$     $$$$/\n"
    "  ~-------------------~  \n");

  AddDetail( ({ "unterseite" }),
    "Die Unterseite des Felsblockes kannst Du leider nicht erkennen.");

  AddDetail( ({ "stein", "stufen" }),
    "Die Stufen sind aus hartem Stein gehauen. Diese sind bestimmt alle "
    "kuenstlich erschaffen worden. Eine Stufe faellt Dir besonders auf. Manche "
    "der Stufen sind schon ein wenig zerstoert. Das muss wohl an der harten "
    "Witterung liegen.");

  AddDetail( ({ "witterung" }),
    "In einer feuchten Hoehle ist die Witterung schon sehr hart. Zu lange "
    "solltest Du Dich hier auch nicht aufhalten.");

  AddDetail( ({ "stufe" }),
    "Die eine Stufe scheint irgendwie komisch zu leuchten. Du kannst sie "
    "von hier unten aber nicht direkt erreichen.");

  AddDetail( ({ "ende" }),
    "Das Ende der Hoehle liegt ganz im Osten. Ein paar Stufen scheinen "
    "nach oben zu fuehren.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus reinem Felsgestein und mit ein wenig Moos ueberdeckt.");

  AddDetail( ({ "moos" }),
    "Das Moos waechst nur spaerlich zwischen den wenigen Pfuetzen in dieser "
    "Hoehle.");

  AddDetail( ({ "pfuetzen", "pfuetze" }),
    "Ein paar kleine Pfuetzen befinden sich neben Deinen Fuessen.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Beinahe waerst Du in eine der Pfuetzen gestiegen. Aber das waere bei deren "
    "Tiefe auch nicht schlimm gewesen.");

  AddDetail( ({ "tiefe", "tief" }),
    "Die Pfuetzen sind wahrlich nicht tief.");

  AddDetail( ({ "tibesti", "gebirge", "berg", "berge", "tibesti-gebirge",
                "tibestigebirge" }),
    "Du befindest Dich mitten in einer kleinen Hoehle im Tibesti-Gebirge. "
    "Das Gebirge trennt die Steppe von der offenen Wueste.");

  AddDetail( ({ "steppe" }),
    "Die Steppe liegt hinter dem Eingang dieser Hoehle.");

  AddDetail( ({ "wueste" }),
    "Die Wueste muss noch weiter im Osten hinter dem Gebirge sein.");

  AddDetail( ({ "licht" }),
    "Das wenige Licht in dieser Hoehle reicht nicht aus, um alles erkennen "
    "zu koennen. Es dringt durch die Gebuesche vor dem Eingang in die Hoehle "
    "herein und stammt ganz sicher von der brennenden Sonne.");

  AddDetail( ({ "gebuesch", "gebuesche", "buesche" }),
    "Dichte Gebuesche wuchern vor dem Eingang der Hoehle. Sie "
    "verhindern das direkte Eindringen der Sonnenstrahlen.");

  AddDetail( ({ "eingang" }),
    "Der Eingang, welcher natuerlich auch gleichzeitig einen Ausgang darstellt, "
    "liegt im Westen der Hoehle.");

  AddDetail( ({ "ausgang", "faelle", "fall" }),
    "Eingang und Ausgang einer Hoehle sind in den meisten Faellen identisch.");

  AddDetail( ({ "sonne" }),
    "Du kannst die Sonne von hier aus nicht sehen. Vielleicht ein wenig "
    "spueren. Aber eigentlich ist es hier drinnen schon sehr kuehl.");

  AddDetail( ({ "eindringen", "untersuchung" }),
    "Bei genauerer Untersuchung stellst Du fest, dass gar keine Sonnenstrahlen "
    "in die Hoehle gelangen. Darum ist es hier auch stockfinster.");

  AddDetail( ({ "sonnenstrahlen", "strahlen" }),
    "Die Sonnenstrahlen werden allesamt durch die dichten Gebuesche vor "
    "dem Eingang abgehalten. Daher kannst Du auch keine erkennen.");

  AddDetail( ({ "westen" }),
    "Im Westen ist der Eingang der Hoehle.");

  AddDetail( ({ "osten", "norden", "sueden" }),
    "Dort ist nur nackte Felswand.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen groesstenteils aus reinem Felsgestein. Nur ein paar "
    "Wurzeln treten hier und da mal aus den Waenden hervor.");

  AddDetail( ({ "felsgestein", "gestein" }),
    "Das Felsgestein ist hart und unbeugsam. Kuehl und ein wenig nass "
    "fasst es sich an, ist daher auch voellig uninteressant.");

  AddDetail( ({ "wurzeln", "wurzel" }),
    "Ein paar vereinzelte Wurzeln haengen von den Waenden herunter. Sie muessen "
    "von ein paar Pflanzen oberhalb der Hoehle stammen.");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Du kannst nur vermuten, dass sich ueber der Hoehle Pflanzen befinden. "
    "Sehen kannst Du jedenfalls nur ein paar Wurzeln.");

  AddSpecialDetail( ({ "loch" }), "lochfkt" );

  AddSound( DEFAULT_SOUND,
    "In der Hoehle ist es seltsam ruhig. Nur den Wind kannst Du ein wenig "
    "pfeifen hoeren.");

  AddSound( "wind",
    "Der Wind pfeift leise durch die Hoehle.");

  AddSmell( DEFAULT_SMELL,
    "Mitten in der Hoehle riecht es ein wenig abgestanden.");

  AddCmd( ({ "leg","lege","fueg","fuege" }) , "legfkt" );

  AddExit( "westen",      "/d/wueste/arthoas/erg/room/aragh/raum49" );
  AddSpecialExit( "oben", "obenfkt");
}

reset() {
  ::reset();
  nr++;
  if(nr>=2) {
    hands=({ });
    nr=0;
  }
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  GRABMASTER->NeuesGrab(victim, killer, lost_xp);  
}

string lochfkt(string str) {
  string temp;
  
  temp=TP->QueryProp(P_RACE);
  if(temp=="Fee")
    temp="eine "+temp;
  else
    temp="einen "+temp;
  return BS(
    "Das Loch schaut gross genug fuer "+temp+" aus.");
}

int legfkt(string str) {
  string welche,wohin;
  
  welche=wohin="";
    
  notify_fail("Was moechtest Du wohin legen?\n");
  if(!str) return 0;

  if(sscanf(str,"%shand%s",welche,wohin) != 2) return 0;  
  
  if(welche != "linke " && welche != "rechte ") {
    write(BS("Welche Hand meinst Du denn?\n"));
    return 1;
  }

  if(sscanf(str,"%s hand %s",welche,wohin) != 2 || wohin == "") {
    write(BS("Wohin moechtest Du Deine "+welche+"Hand legen?\n"));
    return 1;
  }
  
  if( wohin != "auf felsblock" && wohin != "in felsblock" &&
      wohin != "auf block" && wohin != "in block" &&
      wohin != "auf symbol" && wohin != "in symbol" &&
      wohin != "auf oberseite" && wohin != "in oberseite") {
    write(BS("Dort kannst Du Deine "+welche+" Hand nicht hineinlegen!\n"));
    return 1;
  }

  if(welche != "rechte") {
    write(BS("Deine linke Hand passt dort nicht hinein!\n"));
    return 1;
  }
   
  if (member(hands,getuid(TP)) != -1) {
    write(BS(
      "Du hast Deine Hand schon einmal auf das Symbol gelegt."));
    return 1;
  }
  
  hands+=({ getuid(TP) });
  write(BS(
    "Du legst Deine rechte Hand in das Symbol auf der Oberseite des Felsblockes. "
    "Auf einmal durchstroemt Dich eine nicht zu identifizierende, magische "
    "Macht und Du siehst, wie ein blauer Strahl vom Felsblock auf eine der "
    "oberen Stufen strahlt."));
  say(BS(
    CAP_TPN+" beruehrt einen Felsen und auf einmal ist die Hoehle kurzzeitig "
    "von einem blauen Licht erhellt."));
  return 1;
}

int obenfkt(string str) {
  int le,lvl;
  
  if(member(hands,getuid(TP)) == -1) {
    write(BS(
      "Du steigst wagemutig die alten Stufen hinauf. Als Du schon fast oben "
      "angekommen bist, faengt auf einmal eine der Stufen unter Dir magisch "
      "an zu leuchten. Ein Blitz trifft Dich hart und wirft Dich zurueck auf "
      "den Boden!"));
    say(BS(
      CAP_TPN+" versucht ueber die Stufen nach oben zu gehen, wird aber von "
      "einem Blitz getroffen und faellt hart getroffen wieder auf den Boden "
      "zurueck."));
    le =TP->QueryProp(P_HP);
    lvl=TP->QueryProp(P_LEVEL)/2;
    le-=(lvl+random(lvl));
    if(le < 20)
      le=20; // damit man niemals gleich an der Hitze sterben kann :)
    TP->AddHp(-(TP->QueryProp(P_HP)-le));
    return 1;
  }
  if(TP->QueryProp(P_XP) < 200000) {
    write(BS(
      "Du steigst wagemutig die alten Stufen hinauf. Als Du schon fast oben "
      "angekommen bist, durchfaehrt Dich auf einmal ein Geistesblitz:"));
    write(BS(
      "Ein Geistesblitz teilt Dir mit: Du bist noch nicht erfahren genug!"));
    write(BS(
      "Ein Geistesblitz teilt Dir mit: Komm wieder, wenn Du erfahrener bist!!!"));
    write(BS(
      "Gehorsam wie Du bist, gehst Du die Stufen wieder runter."));
    say(BS(
      CAP_TPN+" versucht ueber die Stufen nach oben zu gehen, kehrt aber "
      "freiwillig wieder enttaeuscht um."));
    return 1;
  }
  write(BS("Du steigst wagemutig ueber die alten Stufen nach oben."));
  return TP->move(ROOM "berg-oben",M_GO,"ueber die Stufen nach oben");
}

