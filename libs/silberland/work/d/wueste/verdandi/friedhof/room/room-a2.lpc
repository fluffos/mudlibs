#include "../def.h"

inherit ROOM "room_inh.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {

  ::create();


  SetProp( P_INT_SHORT, "Auf einem Elefantenfriedhof" );
  SetProp( P_INT_LONG,
		"Die Hitze hier auf dem Friedhof macht Dir sehr zu schaffen. Gerne wuerdest Du Dich "
		"irgendwo abkuehlen oder erfrischen, aber weit und breit siehst Du nichts, das Deine "
		"Beduerfnisse befriedigen koennte. Die Sonne brennt seit Stunden erbarmungslos vom "
		"Himmel herab, der Boden ist von der Trockenheit schon ganz rissig, und Du traeumst "
		"eigentlich nur noch von einem schattigen Plaetzchen." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28+random(5), 
						   ENV_TERRAIN: TT_DESERT]) );


  AddDetail( "hitze",
	"Die Hitze bringt Dich fast um den Verstand.");
	
  AddDetail( "friedhof",
    "Du stehst gerade auf der westlichen Seite des Friedhofes.");
    
  AddDetail( ({ "beduerfnis", "beduerfnisse" }),
    "Uiuiui, Du Ferkel, was Du schon wieder denkst... ;)");
    
  AddDetail( "sonne",
    "Sie steht hoch oben am Himmel und brennt Dir gnadenlos auf den Kopf.");
    
  AddDetail( "stunden",
    "Auf Deinen Streifzuegen durchs SilberLand vergehen sie wie im Flug.");
    
  AddDetail( "himmel",
    "Oh, Ueberraschung! Er ist genau ueber Dir! :)");
    
  AddDetail( "boden",
    "Der Boden besteht halb aus Sand, halb aus Erde. Die Hitze hat ihn allerdings so stark "
    "ausgetrocknet, dass unzaehlige Risse entstanden sind. Vereinzelt siehst Du auch Knochen "
    "herumliegen.");
    
  AddDetail( "trockenheit",
    "Hier regnet es so gut wie nie und daher ist der Boden rissig und trocken.");
    
  AddDetail( "schatten",
    "Der einzige erkennbare Schatten ist der, den Du selbst wirfst.");
    
  AddDetail( ({ "plaetzchen", "platz" }),
    "Vielleicht findest Du ja auf dem Friedhof ein Plaetzchen, wo Du Dich ein wenig abkuehlen "
    "kannst.");
    
  AddDetail( "verstand",
    "Auch in der groessten Hitze sollte man ihn nie verlieren.");
    
  AddDetail( "seite",
    "Du befindest Dich auf der westlichen Seite des Friedhofes.");
    
  AddDetail( "ferkel",
    "DU! Oder wer denkt da so zweideutig? ;)");
    
  AddDetail( "kopf",
    "Er sitzt noch auf Deinem Hals.");
    
  AddDetail( ({ "silberland", "heimatland", "land" }),
    "Das SilberLand ist Dein Heimatland.");
    
  AddDetail( "flug",
    "'Etwas vergeht wie im Flug' ist doch nur eine Redensart.");
    
  AddDetail( "ueberraschung",
    "Bist Du wirklich ueberrascht, dass der Himmel ueber Dir ist? Wenn ja, solltest Du Dir "
    "ernsthaft Gedanken machen, ob Dir die Hitze hier nicht doch zu sehr schadet.");
    
  AddDetail( "sand",
    "Feinkoerniger Sand aus der nahen Wueste ist hier mit trockener Erde vermischt.");
    
  AddDetail( "erde",
    "Die Erde ist trocken und staubig. Durch die kleinen beigemengten Steinchen ist sie nicht "
    "ganz so fein wie der Sand.");
    
  AddDetail( "risse",
    "Die Risse sind wohl entstanden, weil die Sonne den Boden zu sehr ausgetrocknet hat. Ein "
    "ganz besonders langer faellt Dir sofort auf.");
    
  AddDetail( "knochen",
    "Voellig abgenagt liegen hier einige Knochen herum. Nicht ein einziges Fleischstueckchen "
    "ist mehr daran zu erkennen.");
    
  AddDetail( "hals",
    "Sei froh, dass Du einen Hals hast. Sonst wuerde Dein Kopf in der Luft schweben.");
    
  AddDetail( "redensart",
    "Es gibt sooooo viele....");
    
  AddDetail( "gedanken",
    "Hoffentlich kannst Du bei dieser Hitze noch denken. Manche tun sich da echt schon schwer. ;)");
    
  AddDetail( "wueste",
    "Von hier aus kannst Du sie nicht sehen, da musst Du schon naeher hingehen.");
    
  AddDetail( "steinchen",
    "Die kleinen Steinchen in der Erde geben dem Boden etwas Halt.");
    
  AddDetail( "riss",
    "Ein Riss ist viel laenger als alle anderen. Du verfolgst seinen Verlauf und siehst, dass er "
    "gegen das Ende hin ziemlich breit wird.");
    
  AddDetail( ({ "fleisch", "fleischstueckchen", "fleischstueck" }),
    "Wer immer die Knochen auch abgenagt hat, muss aeusserst hungrig gewesen sein, denn nicht "
    "einmal ein kleines Fleischstueckchen haengt mehr dran.");
    
  AddDetail( "luft",
    "Luft erleichtert das Leben ungemein. Du freust Dich, dass Dich soviel davon umgibt. :)");
    
  AddDetail( ({ "halt", "festigkeit" }),
    "Durch die kleinen Steinchen gewinnt der Boden mehr Festigkeit.");
    
  AddDetail( "verlauf",
    "Der Riss verlaeuft am Boden entlang und endet auf einem leicht aufgeschuetteten Erdhuegel.");
    
  AddDetail( "ende",
    "Das Ende des Risses ist so breit, dass man schon fast von einem kleinen Eingang sprechen "
    "koennte.");
    
  AddDetail( "leben",
    "Ist es nicht herrlich?");
    
  AddDetail( ({ "erdhuegel", "huegel" }),
    "Jetzt erst bemerkst Du den kleinen Erdhuegel, auf dem der lange Riss endet.");
    
  AddDetail( "eingang",
    "Huch, ist da vielleicht gar eine Hoehle dahinter?");
    
  AddDetail( "hoehle",
    "Du schaust in den Riss und versuchst darin etwas zu erkennen. Leider bist Du aber vom "
    "Sonnenlicht so geblendet, dass Du ausser Schwarz von hier aus nichts sehen kannst. Wenn "
    "Du allerdings ganz besonders mutig bist, koenntest Du Dich ja vielleicht einmal vorsichtig "
    "hineinwagen.");
    
  AddDetail( "sonnenlicht",
    "Es blendet Dich so stark, dass Du von aussen nichts erkennen kannst, als Du in den Riss "
    "schaust.");
    
  AddDetail( "schwarz",
    "Du siehst von hier aus absolut NICHTS. :(");
    
  AddDetail( ({ "ohr", "ohren" }),
    "Nachdem Du gerade ein Geraeusch gehoert hast, hast Du sicher noch zumindest ein Ohr.");
    
  AddDetail( ({ "wind", "windhauch" }),
    "Durch den Windhauch hast Du jetzt leider nicht erkennen koennen, woher das Winseln kam.");
    
  AddDetail( "nase",
    "Die ist mitten in Deinem Gesicht.");
    
  AddDetail( "gesicht",
    "So schlecht, wie alle sagen, siehst Du eigentlich gar nicht aus. ;)"); 	


  AddSound( DEFAULT_SOUND,
	"Ups, was war das? Hat da jetzt nicht gerade ein Tier gewinselt?");
	
  AddSound( "tier",
    "Dem Winseln nach scheint es sich um ein noch junges Tier zu handeln. Allerdings kannst Du "
    "das Geraeusch nicht richtig orten, da Dir im selben Moment ein Windhauch ins Ohr blaest.");
    
  AddSound( ({ "winseln", "geraeusch" }),
    "Du hast keine Ahnung, wo das Geraeusch herkommt.");
    
  AddSound( ({ "wind", "windhauch" }),
    "Huuuuiiii...");  	


  AddSmell( DEFAULT_SMELL,
	"Die trockene Luft riecht eigentlich nach nichts.");
	
  AddSmell( "luft",
    "Ein schwacher Geruch streift jetzt doch Deine Nase.");
    
  AddSmell( "geruch",
    "Du hast schon Besseres gerochen. Vielleicht kommst Du ja noch dahinter, was hier so stinkt."); 

  AddCmd( ({ "betrete","betret","kriech","krieche" }), "betretfkt" );

  AddItem( NPC "bueffel", REFRESH_DESTRUCT );

  AddExit( "sueden",    "./room-a3" );
  AddExit( "nordosten", "./room-b1" );
  AddExit( "suedosten", "./room-b3" );
  AddExit( "osten",     "./room-b2" );

}

int betretfkt(string str) {
  notify_fail("Was moechtest Du betreten?\n");
  if(str != "hoehle" && str != "in hoehle" && str != "riss" && str != "in riss") return 0;
  write(BS("Du nimmst all Deinen Mut zusammen und kriechst in die Hoehle."));
  TP->move( ROOM "hoehle.lpc", M_GO, 0,
    "verkriecht sich in eine kleine Hoehle",
    "kommt in die Hoehle gekrochen");
  return 1;
}

