#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int ruhe;
string *hingelegt;

create() {

  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG,
	"Endlich ist es hier ein wenig kuehler als draussen auf dem Friedhof. Die "
	"Hoehle wurde direkt in die Erde gegraben und ist wohl fuer einen jungen "
	"Schakal ein einigermassen sicheres Versteck vor hungrigen Raubtieren. "
	"Durch das schwache Licht kannst Du hier jedoch nicht allzu viel "
	"erkennen. Die Waende, der Boden.... eigentlich sieht hier drin nichts "
	"ungewoehnlich aus.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20+random(3), 
						   ENV_TERRAIN: TT_CAVE]) );

  AddDetail( "friedhof",
  	"Da befindest Du Dich gerade. Naja, genaugenommen in einer Hoehle auf "
  	"dem Friedhof.");
    
  AddDetail( ({ "hoehle", "erdhoehle" }), QueryProp(P_INT_LONG) );
  
  AddDetail( "erde",
    "Um Dich herum ist ueberall feste, dunkelschwarze Erde.");
	
  AddDetail( "versteck",
    "Ausserhalb der Hoehle lauern viele Gefahren fuer ein Schakalbaby. Hier "
    "in der Hoehle ist es wenigstens einigermassen sicher.");
    
  AddDetail( "raubtiere",
  	"Es gibt genug Raubtiere im SilberLand, die kleine Schakale zum Fressen "
  	"gern haetten. Moeglicherweise bist selbst Du schon einigen von ihnen "
  	"begegnet.");
  	
  AddDetail( "licht",
  	"Das Licht reicht gerade aus, um sich alles anschauen zu koennen. Viel "
  	"gibt es hier allerdings eh nicht zu sehen.");
  	
  AddDetail( ({ "wand", "waende" }),
  	"Da Du Dich in einer Erdhoehle befindest, ist es fast uebertrieben von "
  	"'Waenden' zu sprechen. Rund um Dich ist eben alles aus Erde.");
  	
  AddDetail( "decke",
    "Den Uebergang zwischen Decke und Waenden kannst Du nicht erkennen.");
    
  AddDetail( "gefahren",
    "Davon gibt es im SilberLand mehr als genug.");
    
  AddDetail( "silberland",
    "Wo immer Du auch hinschaust, alles hier gehoert zum SilberLand.");
    
  AddDetail( "sand",
    "Der Sand stammt wohl aus der nahegelegenen Wueste.");
    
  AddDetail( ({ "blutflecken", "blutfleck", "blut", "flecken" }),
    "Wahrscheinlich stammen die Flecken vom Blut der Tiere, die hier "
    "verzehrt worden sind, oder aber von neugierigen Forschern wie Du "
    "einer bist.");
    
  AddDetail( "fellreste",
    "Sie sind blutverschmiert und voellig in Fetzen gerissen.");
    
  AddDetail( "knochen",
    "Sicher stammen diese Knochen von den erbeuteten Tieren.");
    
  AddDetail( "auspolsterung",
    "Als Du die Auspolsterung naeher untersuchst, siehst Du, dass lauter "
    "kleine Felle die weiche Unterlage fuer einen kleinen Schakal bilden.");
    
  AddDetail( ({ "felle", "fell", "maeusefelle", "maeusefell" }),
  	"So kleine Felle hast Du bisher selten gesehen. Es handelt sich dabei "
  	"bestimmt um Maeusefelle. Eigentlich schoen grausam, wenn Du bedenkst, "
  	"wie viele Maeuse dafuer ihr Leben lassen mussten.");
    
  AddDetail( "wueste",
  	"Die ist nicht weit entfernt von hier.");
  	
  AddDetail( "tiere",
    "Die aermsten mussten sterben, damit ein kleiner Schakal gross und stark "
    "werden kann.");
    
  AddDetail( "forscher",
    "Oft ist es gut, wenn man alles genau erforscht, oft waere es aber besser "
    "gewesen, man haette es nicht gemacht. Du kennst sicher genug solcher "
    "Situationen.");
    
  AddDetail( "fetzen",
  	"Sie sind wirklich total zerfetzt. Du kannst nicht einmal mehr erkennen, "
  	"von welchen Tieren sie stammen.");
  	
  AddDetail( "unterlage",
    "Sie besteht aus unzaehligen Maeusefellen und sieht so unbeschreiblich "
    "weich aus, dass Du sie am liebsten selber einmal ausprobieren moechtest.");
    
  AddDetail( ({ "maeuse", "wuestenrennmaeuse" }),
    "Die Maeuse, denen einmal die Felle gehoerten, waren sicher Wuestenrennmaeuse.");
    
  AddDetail( ({ "leben", "situationen" }),
    "Das Leben kann manchmal ganz schoen gefaehrlich sein. Also pass gut auf "
    "Deines auf!");
  
  AddDetail( "irgendetwas",
  	"Vielleicht ein Tier? Wenn Du es genau wissen willst, komm am besten spaeter "
  	"wieder vorbei.");
  	
  AddDetail( "scheisse",
    "Huch, das war aber jetzt knapp!");
    
  AddDetail( "nase",
    "Du greifst schnell hin. Zum Glueck ist sie noch genau da, wo Du sie zuletzt "
    "hattest.");	


  AddSound( DEFAULT_SOUND,
	"Du kannst ein ganz leises Geraeusch wahrnehmen.");
    
  AddSound( "geraeusch",
    "Dir kommt das Geraeusch wie ein leises Atmen vor.");
    
  AddSound( ({ "atmen", "atem" }),
    "Ist es Dein eigener Atem? Oder der eines Schakals? Du weisst es einfach "
    "nicht.");  
  
  AddSmell( DEFAULT_SMELL,
    "Es stinkt nicht gerade, aber es duftet auch nicht hier. Ein kleiner "
    "Schakal koennte durchaus daran schuld sein, dass Dir ein etwas scharfer "
    "Geruch in die Nase steigt.");
	
  AddSmell( ({ "schakal", "schakalbaby", "geruch" }),
    "Naja, auch ein Schakalbaby muss mal.... Pass halt auf, dass Du nicht "
    "hineintrittst!");
    
  AddSmell( "scheisse",
    "Ihhhhh, ist ja eklig!!!");
  
  AddSmell( ({ "kot", "kacke" }),
    "Ihhhhh, ist ja eklig!!!");

  AddSpecialDetail( "boden", "bodenstring" );
  
  AddItem( NPC "schakalbaby", REFRESH_DESTRUCT);

  AddCmd( ({ "leg","lege","lieg","liege" }), "legfkt" );
  AddCmd( ({ "probier","probiere" }), "probfkt" );
  AddCmd( ({ "durchwuehle","durchsuche","durchsuch","durchwuehl",
             "wuehl","wuehle" }), "wuehlfkt" );

  ruhe=1;
  hingelegt=({ });

  AddSpecialExit( "raus",    "rausfkt" );
}

rausfkt(string dir) {
  object ob;
  ob=present("schakalmutter",ME);
  if(ob) {
    if(ob->IsEnemy(TP)) call_out("removemutter",0,ob);
  }
  hingelegt-=({ getuid(TP) });
  return ROOM "room-a2";
}

removemutter(object ob) {
  if(present(ob,ME)) {
    ob->remove();
    tell_room(ME,BS(
      "Die Schakalmutter verzieht sich in eine dunkle Ecke und ist "
      "nicht mehr zu sehen."));
  }
}

string bodenstring() {
  if(present("schakalbaby",ME)) return BS(
    "Er besteht aus festgetretener Erde. Wahrscheinlich ist auch "
    "ein wenig Sand dabei, aber da bist Du Dir jetzt nicht so sicher. "
    "Du siehst einige Blutflecken, Fellreste und Knochen. Ausserdem "
    "faellt Dir jetzt auf, dass der kleine Schakal auf einer weichen "
    "Auspolsterung liegt.");
  return BS(
    "Er besteht aus festgetretener Erde. Wahrscheinlich ist auch ein "
    "wenig Sand dabei, aber da bist Du Dir jetzt nicht so sicher. Du "
    "siehst einige Blutflecken, Fellreste und Knochen. Ausserdem faellt "
    "Dir jetzt auf, dass irgendetwas auf der weichen Auspolsterung lag.");
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  GRABMASTER->NeuesGrab(victim, killer, lost_xp);  
}

int probfkt(string str) {
  write(BS(
    "Was genau moechtest Du denn ausprobieren? Du musst schon genauer werden.\n"));
  return 1;
}

int legfkt(string str) {
  object ob;
  
  notify_fail("Moechtest Du Dich vielleicht auf die Unterlage legen?\n");
  if(str=="unterlage") return 0;

  notify_fail("Moechtest Du Dich vielleicht irgendwo hinlegen?\n");
  if(str != "auf unterlage") return 0;
  
  if(present("schakalbaby",ME)) {
    write(BS(
      "Das kleine Schakalbaby faucht Dich boese an. Verschreckt weichst Du "
      "zurueck und denkst . o O (Bloedes Viech, ich will mich da jetzt "
      "unbedingt hinlegen!!!)\n"));
    return 1;
  }
  if(ob=present("schakalmutter",ME)) {
    write(BS(
      "Die Schakalmutter hindert Dich daran und greift Dich mit ihren "
      "scharfen Zaehnen an!"));
    ob->Kill(TP);
    return 1;
  }
  if(member(hingelegt,getuid(TP)) == -1) hingelegt+=({ getuid(TP) });
  if(!QUESTMASTER->stone_check(5)) {
    write(BS(
      "Du legst Dich entspannt auf die weiche Unterlage. Ein herrliches Gefuehl "
      "kommt in Dir auf und Dein Atem wird ganz ruhig. Nach einer Weile kuschelst "
      "Du Dich immer tiefer in die weiche Unterlage hinein. Auf einmal drueckt "
      "Dich etwas in die Rippen. Es muss sich etwas Haerteres in der "
      "Auspolsterung befinden. Frustriert stehst Du wieder auf."));
    say(BS(
      CAP_TPN+" legt sich kurzzeitig auf die weiche Unterlage, steht dann "
      "aber sofort wieder auf."));
    return 1;
  }
  write(BS(
    "Du legst Dich entspannt auf die weiche Unterlage. Ein herrliches Gefuehl "
    "kommt in Dir auf und Dein Atem wird ganz ruhig. Nach einer Weile kuschelst "
    "Du Dich immer tiefer in die weiche Unterlage hinein und schlaefst dabei "
    "ein. Nach einer Weile wirst Du wieder wach und stehst frisch und munter "
    "wieder auf."));
  say(BS(
    CAP_TPN+" legt sich auf die weiche Unterlage und steht nach einer Weile "
    "wieder auf."));
  if(ruhe) {
    ruhe=0;
    TP->SetProp(P_MV,TP->QueryProp(P_MV)+100);
  }
  return 1; 
}

reset() {
  ::reset();
  ruhe=1;
  hingelegt=({ });
}

int wuehlfkt(string str) {
  object ob;
  
  if(QUESTMASTER->stone_check(5)) return 0;
  if(member(hingelegt,getuid(TP)) == -1) return 0;
  
  notify_fail("Was moechtest Du durchwuehlen?\n");
  if(str != "auspolsterung" && str != "in auspolsterung") return 0;

  if(present("schakalbaby",ME)) {
    write(BS(
      "Das kleine Schakalbaby faucht Dich boese an. Verschreckt weichst Du "
      "zurueck und denkst . o O (Bloedes Viech, ich will da jetzt drin "
      "herumwuehlen!!!)\n"));
    return 1;
  }
  if(ob=present("schakalmutter",ME)) {
    write(BS(
      "Die Schakalmutter hindert Dich daran und greift Dich mit ihren "
      "scharfen Zaehnen an!"));
    ob->Kill(TP);
    return 1;
  }
  if(QUESTMASTER->stone_found(5)) {
    write(BS(
      "Du durchwuehlst die Auspolsterung und findest ein Steinplaettchen. Das "
      "muss es gewesen sein, was Dich in Deine Rippen gepiekst hat! Leicht "
      "saeuerlich steckst Du das Plaettchen ein."));
    return 1;
  }
  write(BS(
    "Du durchwuehlst erfolglos die Auspolsterung."));
  say(BS(
    CAP_TPN+" durchwuehlt erfolglos die Auspolsterung."));
  return 1;
}
