
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer dunklen Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer dunklen Hoehle. Nur sehr wenige Lichtstrahlen "
    "dringen aus dem Osten herein. Der frische Wind blaest von Osten kommend "
    "nach unten aus der Hoehle hinaus. Die Waende und Decke sind fast zu "
    "dunkel, um ueberhaupt etwas erkennen zu koennen. Auf dem Boden liegen "
    "neben ein paar Felsbrocken ein paar Knochen herum." );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_HIDE_EXITS, ({ "unten" }));
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10+random(5), 
                            ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "felsbrocken", "brocken" }),
    "Die Felsbrocken sind wohl vor langer Zeit aus der Decke und den Waenden "
    "herausgebrochen und am Boden liegengeblieben. Unter einem Felsbrocken "
    "sieht es ein wenig komisch aus.");

  AddDetail( ({ "unter felsbrocken", "unter brocken" }),
    "Unter einem abseits gelegenen Felsbrocken entdeckst Du einen kleineren "
    "Felsbrocken.");

  AddDetail( ({ "kleiner felsbrocken", "kleinerer felsbrocken", "kleinen felsbrocken",
                "kleiner brocken", "kleinerer brocken", "kleinen brocken",
                "kleineren felsbrocken", "kleineren brocken" }),
    "Der kleinere Felsbrocken weist ein paar seltsame Abschuerfungen auf.");

  AddDetail( ({ "abschuerfungen", "abschuerfung" }),
    "Die Abschuerfung kann eigentlich nur von der komischen Ritze in der "
    "westlichen Wand stammen.");

  AddDetail( ({ "ritze" }),
    "Die Ritze graebt sich tief in das Felsgestein hinein. Tief in der Ritze "
    "drin scheint etwas zu liegen! Vielleicht solltest Du dem mal "
    "nachgehen!?!");

  AddDetail( ({ "zeit" }),
    "An den Felsbrocken kannst Du erkennen, dass es schon eine sehr sehr "
    "lange Zeit her sein muss.");

  AddDetail( ({ "knochen" }),
    "Bei den Knochen handelt es sich genauer gesagt um Tierknochen.");

  AddDetail( ({ "tierknochen" }),
    "Die Tierknochen liegen hier wohl schon laenger herum. Von welchen "
    "Tieren sie abstammen, kannst Du aber leider nicht so genau erkennen. "
    "Sie sind aber schon etwas groesser als die von den Tieren aus der "
    "Steppe.");

  AddDetail( ({ "tiere" }),
    "Du kannst derzeit keine Tiere erkennen. Oder doch?");

  AddDetail( ({ "steppe", "westen" }),
    "Die Steppe liegt weit im Westen von hier aus.");

  AddDetail( ({ "decke" }),
    "Die dunkle Decke ueber Dir ist scheinbar noch stabil genug. Sie besteht "
    "aus festem Felsgestein, das sicher schon uralt ist.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden liegen nur ein paar Felsbrocken herum. Daneben erkennst "
    "Du allerdings mit einem leichten Schrecken ein paar Tierknochen.");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus hartem, dunklem Felsgestein.");

  AddDetail( ({ "fels", "felsen" }),
    "Die Felsen hier sind alle dunkel und sehr hart.");

  AddDetail( ({ "felsgestein", "gestein" }),
    "Das Felsgestein, aus dem die Waende und die Decke bestehen, ist "
    "dunkelschwarz. Das Gestein glitzert aber auch ein wenig in den "
    "Lichtstrahlen.");

  AddDetail( ({ "glitzern" }),
    "Das Glitzern muss von ein paar Einschluessen im Felsgestein stammen.");

  AddDetail( ({ "einschluesse" }),
    "Richtig. Jetzt wo Du genauer schaust, kannst Du winzige Einschluesse "
    "von Gold, Silber und sogar Edelsteine erkennen.");

  AddDetail( ({ "gold", "silber", "edelsteine", "edelstein" }),
    "Winzige Einschluesse davon stecken in den Waenden und in der Decke. Leider "
    "sind sie viel zu fest damit verbunden, als dass Du etwas davon an Dich "
    "nehmen koenntest.");

  AddDetail( ({ "unten" }),
    "Durch ein kleines Loch kannst Du die Hoehle sich unten weiter ausbreiten "
    "sehen. Du kannst einfach so nach unten gehen, wenn Du magst.");

  AddDetail( ({ "loch" }),
    "Das Loch ist gerade gross genug fuer Dich. Du kannst voellig ohne Gefahr "
    "durch das Loch nach unten gehen.");

  AddDetail( ({ "wind" }),
    "Der Wind streicht Dir schon gar nicht mehr so sanft ueber Deine Haut. "
    "Aber frieren tust Du eigentlich nicht. Es ist eher angenehm. Bei den "
    "Temperaturen, die Du draussen erwartest, ist das ja auch kein Wunder.");

  AddDetail( ({ "haut" }),
    "Deine Haut fuehlt sich schon ein wenig kuehler als sonst an. Aber es "
    "ist wirklich angenehm.");

  AddDetail( ({ "temperaturen", "temperatur" }),
    "Hier in der Hoehle ist es noch recht angenehm. Weiter im Osten duerfte "
    "sich das dann bald aendern.");

  AddDetail( ({ "wunder" }),
    "Nein, das ist wirklich kein Wunder.");

  AddDetail( ({ "licht" }),
    "Ein wenig Licht dringt vom Ausgang der Hoehle im Osten herein.");

  AddDetail( ({ "lichtstrahlen", "strahlen" }),
    "Die Lichtstrahlen, die vermutlich von der Sonne stammen, funkeln in "
    "kleinen Streifen ueber Deine Fuesse.");

  AddDetail( ({ "sonne" }),
    "Du kannst die Sonne von hier aus nicht sehen, vermutest aber, dass sie "
    "sich im Osten hinter dem Ausgang der Hoehle befinden muesste.");

  AddDetail( ({ "osten" }),
    "Im Osten befindet sich der Ausgang der Hoehle.");

  AddDetail( ({ "ausgang", "gang" }),
    "Nach einem kleinen Gang Richtung Osten kannst Du den Ausgang der Hoehle "
    "schon fast erkennen.");

  AddDetail( ({ "richtung" }),
    "Damit ist hier Osten gemeint.");

  AddDetail( ({ "streifen" }),
    "Die Streifen blitzen Dir ueber Deine Fuesse.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Du spielst ein wenig mit den Lichtstrahlen herum und versuchst, sie "
    "moeglichst nett ueber Deine Fuesse gleiten zu lassen. Kurzzeitig "
    "gelingt es Dir sogar und Du freust Dich riesig.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift vom Osten her nach unten aus der Hoehle hinaus.");

  AddSound( "wind",
    "Der Wind ist wirklich laut hier.");
    
  AddSound( "osten",
    "Aus dem Osten kannst Du den Wind pfeifen hoeren.");
    
  AddSound( "pfeifen",
    "Das Pfeifen des Windes ist sehr laut.");

  AddSmell( DEFAULT_SMELL,
    "Fuer eine Hoehle riecht es hier gar nicht so abgestanden. Das muss wohl "
    "am durchziehenden Wind liegen.");

  AddSmell( "hoehle",
    "In der Hoehle riecht es nach frischer Luft.");

  AddSmell( "luft",
    "Du atmest die frische Luft tief ein und freust Dich.");

  AddSpecialDetail( ({ "schrecken" }), "schreckfkt" );

  AddCmd( ({ "greif","greife" }), "greiffkt" );

  AddExit( "osten",     "./room-a3" );
  AddExit( "unten",     "./berg-unten" );
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  GRABMASTER->NeuesGrab(victim, killer, lost_xp);  
}

string schreckfkt(string str) {
  TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME:-1,
        PARALYZE_MSG: "Dein Koerper gehorcht Dir nicht !\n",
        PARALYZE_MSG_OTHER: "%s steht starr vor Schreck vor Dir.\n",
        PARALYZE_END:"",
        PARALYZE_END_OTHER:"" ]));

  call_out("schreck2",4,TP);
  return 
    "*JAPS*\nEin schwerer Felsen faellt direkt auf Deinen Kopf.\nAlles um Dich "
    "herum wird auf einmal so schwarz...\n\n";
}

void schreck2(object ob) {
  if(!present(ob,ME)) {
    tell_object(ob,"Der Tod teilt Dir mit: NOCH EINMAL GLUECK GEHABT!\n");
    tell_object(ob,"Der Tod teilt Dir mit: ABER ICH HOLE DICH SICHER NOCH EINMAL!\n");
    return;
  }
  write("Der Tod kommt von Osten in die Hoehle herein.\n\n");
  write("Der Tod sagt erfreut: AH, EIN NEUER KUNDE!\n\n");
  call_out("schreck3",4,ob);
}

void schreck3(object ob) {
  if(!present(ob,ME)) {
    tell_object(ob,"Der Tod teilt Dir mit: NOCH EINMAL GLUECK GEHABT!\n");
    tell_object(ob,"Der Tod teilt Dir mit: ABER ICH HOLE DICH SICHER NOCH EINMAL!\n");
    return;
  }
  write("Der Tod geht auf Dich zu und nimmt Dich in seine Arme.\n\n");
  write("Auf einmal kommt Lars an.\n\n");
  call_out("schreck4",4,ob);
}

void schreck4(object ob) {
  if(!present(ob,ME)) {
    tell_object(ob,"Der Tod teilt Dir mit: NOCH EINMAL GLUECK GEHABT!\n");
    tell_object(ob,"Der Tod teilt Dir mit: ABER ICH HOLE DICH SICHER NOCH EINMAL!\n");
    return;
  }
  write("Lars grinst Dich an und sagt: Na, erschreckt? ;)\n\n");
  write("Lars und der Tod gehen laut lachend fort...\n\n");
  TP->SetProp(P_PARALYZED, 0);
}

int greiffkt(string str) {

  notify_fail("Moechtest Du vielleicht in die Ritze greifen?\n");
  if(str=="ritze") return 0;

  notify_fail("Wohin moechtest Du greifen?\n");
  if(str != "in ritze") return 0;
  
  if(QUESTMASTER->stone_found(6)) {
    write(BS(
      "Du greifst wagemutig in die Ritze hinein. Es fuehlt sich alles sehr "
      "kalt an. Nach einigem Herumtasten kannst Du aber etwas entdecken. "
      "Du greifst den kalten Gegenstand und steckst ihn in Dein Inventar."));
    return 1;
  }
  write(BS(
    "Du greifst wagemutig in die Ritze hinein. Es fuehlt sich alles sehr "
    "kalt an. Nach einigem Herumtasten kannst Du aber leider immer noch "
    "nichts entdecken. Enttaeuscht gibst Du Deine Suche auf."));
  return 1;
}
