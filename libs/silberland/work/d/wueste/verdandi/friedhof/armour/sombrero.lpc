#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein luftiger Sombrero");
  SetProp(P_LONG,
		"Dies ist der Sombrero eines Elefenbeinjaegers. Er hat "
		"einen so grossen Durchmesser, dass er besonders viel Schatten "
		"spenden kann. Er ist aus buntem Stroh geflochten und hat an der "
		"breiten Krempe ein gruenes Band.");

  SetProp(P_NAME, "Sombrero");
  SetProp(P_INFO, BS("Der Sombrero kann Dich ziemlich gut vor Hitze "
    "schuetzen. In kalten Gebieten koennte er aber eher hinderlich sein.") );
  SetProp(P_GENDER, MALE);
  AddId( ({"sombrero" }) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 1 );
  SetProp(P_NAME_ADJ,"luftig");
  AddAdjective( ({ "luftigen","luftiger" }) );
  
  SetProp(P_MATERIAL, ([ MAT_STRAW: 100 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 50);
  
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:-3, T_HEAT_PROT:8 ]) );

  SetProp(P_DEFEND_FUNC, TO);
}

int DefendFunc(string *dtyp, mixed spell, object enemy) {
  object ob;
  if ((ob=QueryProp(P_WORN)) && member(dtyp, DT_FIRE) >= 0) {
    tell_object(ob,BS(
      "Dein 'heiss'geliebter Sombrero faengt leider Feuer und beginnt sofort "
      "zu verbrennen!!!"));
    call_out("remove_me",6);
    return -(30+random(30));
  }
  return 0;
}

remove_me() {
  object ob;
  if(ob=QueryProp(P_WORN)) {
    tell_object(ob,BS(
      "Der Sombrero steht jetzt vollkommen in Flammen und verbrennt Dir kurz "
      "vor seinem Aufloesen noch Deine Kopfhaut!!!"));
    ob->AddHp(-(10+random(10)));
  }
  DoUnwear(1);
  call_out("remove",0);
}

