#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Hornkrone");
  SetProp(P_LONG,
		"Von einer echten Krone zu sprechen ist eigentlich ziemlich "
		"uebertrieben, denn diese Krone hat nur zwei Spitzen - naemlich die "
		"langen geschwungenen Bueffelhoerner. Zwischen den Spitzen ist sie "
		"jedoch stabil genug, um Deinen Kopf zu schuetzen.");

  SetProp(P_NAME, "Hornkrone");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hornkrone", "krone"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 6 );
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 500);
}
