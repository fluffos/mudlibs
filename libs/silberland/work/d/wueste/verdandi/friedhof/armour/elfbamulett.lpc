#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {

  if( !is_clone(TO) ) return;

  ::create();


  SetProp(P_SHORT, "Ein Elfenbeinamulett");
  SetProp(P_LONG,
		"Dieses Amulett sieht in seiner Schlichtheit wunderschoen aus. Du "
		"erkennst darin Schnitzereien, die offenbar mit viel Liebe gemacht "
		"wurden, da sie ganz zart und fein sind. Derjenige, der dieses Amulett "
		"gefertigt hat, muss ein wahrer Kuenstler gewesen sein!");

  SetProp(P_NAME, "Elfenbeinamulett");
  SetProp(P_INFO, BS("Das Elfenbeinamulett schuetzt ein wenig vor "
		"Elektrizitaet.") );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"elfenbeinamulett", "amulett"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3 );
  SetProp(P_MATERIAL, ([ MAT_IVORY: 100 ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, ([DT_ELECTRIC:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX: 10]) );

}

