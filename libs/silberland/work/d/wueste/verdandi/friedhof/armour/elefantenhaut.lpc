#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Elefantenhaut");
  SetProp(P_LONG,
		"Falten, Falten Falten... Die Elefantenhaut ist total verschrumpelt "
		"und hat in jeder der grossen Poren mindestens eine Borste sitzen.");

  SetProp(P_NAME, "Elefantenhaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"elefantenhaut", "haut"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 23 );
  SetProp(P_MATERIAL, ([ MAT_SKIN: 100 ]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 900);
}
