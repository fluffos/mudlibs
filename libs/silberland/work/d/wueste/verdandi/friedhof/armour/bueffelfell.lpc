#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Bueffelfell");
  SetProp(P_LONG,
		"Das Bueffelfell sieht nicht gerade so aus, als wuerde man es "
		"zu einem hohen Staatsbesuch anziehen, da es dafuer zu viele "
		"kahle Stellen aufweist. Der Bueffel muss schon jede Menge "
		"Kaempfe ausgetragen haben, denn jede kahle Stelle ist eine "
		"bereits verheilte Narbe. Sicher bietet es Dir aber noch "
		"genuegend Schutz um in einem Kampf zu ueberleben.");

  SetProp(P_NAME, "Bueffelfell");
  SetProp(P_INFO, BS("Das Bueffelfell ist nur ein Schutz.") );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"bueffelfell", "fell", "\nfell_is_gerb_able"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7 );
  SetProp(P_MATERIAL, ([ MAT_PELT: 90, MAT_SKIN: 10 ]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1500);
}
