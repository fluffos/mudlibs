
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Aasgeier");
  SetProp(P_LONG,
   "Du blickst einem haesslichen Aasgeier ins Gesicht. Er hat Dich wohl schon "
   "die laengste Zeit beobachtet. Sein kahler Kopf ist mit eingetrocknetem " 
   "Elefantenblut verschmiert, und er scheint auch schon wieder maechtig hungrig "  
   "zu sein. Sei also lieber vorsichtig und reize ihn nicht zu sehr.");

  SetProp(P_NAME, "Aasgeier");
  SetProp(P_GENDER, MALE);
  AddId( ({ "aasgeier", "geier" }) );

  AddDetail( ({ "gesicht" }),
  	"Der Aasgeier hat ein abscheuliches Gesicht.");  	
  
  AddDetail( ({ "kopf", "geierkopf", "aasgeierkopf" }),
	"Der Kopf des Aasgeiers ist blutverschmiert und kahl.");
	
  AddDetail( ({ "elefantenblut", "blut" }),  	
  	"Blut klebt auf dem kahlen, haesslichen Geierkopf.");
  	
  AddDetail( ({ "schnabel" }),
  	"Der blutverschmierte Schnabel ist spitz und leicht nach unten gekruemmt.");

  create_default_npc(14+random(3));
  SetProp(P_HANDS, ({" mit seinem blutverschmierten Schnabel",
                   QueryProp(P_HANDS)[1]+50,DT_RIP}));

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 60+random(15));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:   -1.0,
      DT_LIGHTNING: -0.8, DT_EXPLOSION: -0.1, DT_SOUND:  0.6, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.1 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "kommt vom Ast heruntergeflogen");
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_DIE_MSG,  " stuerzt leblos auf den Boden.\n");
  
  AddInfo(DEFAULT_INFO, "versteht Dich leider nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Aasgeier kann @WEN nicht tragen.\n" }) );
    
  SetProp(P_SPELLRATE,30);

  AddSpell(1,200,
    "Der Aasgeier stuerzt sich hungrig auf Dich.\n",
    "Der Aasgeier stuerzt sich hungrig auf @WEN.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Der Aasgeier bohrt seinen Schnabel tief in Deine Schultern.\n",
    "Der Aasgeier bohrt seinen Schnabel tief in @WESSEN Schultern.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Aasgeier schaut Dich blutverschmiert an.\n",
    "Der Aasgeier hackt mit seinem Schnabel auf einen Knochen ein.\n",
    "Der Aasgeier haelt Ausschau nach Fleischresten.\n",
    "Der Aasgeier sucht die Gegend nach Futter ab.\n",
    "Der Aasgeier fliegt kurz weg und landet wieder vor Dir.\n",
    "Der Aasgeier schaut Dir tief in die Augen.\n",
    "Der Aasgeier hat Dich zum Fressen gern.\n",
    "Der Magen des Aasgeiers knurrt Dir hungrig entgegen.\n"}) );
    
  SUID;
  CLONEME(OBJ "aasfeder");
  if(random(100)>50) CLONEME(OBJ "aasfeder");
  if(random(100)>50) CLONEME(OBJ "aasfeder");
  CLONEME(OBJ "kadaver");
}

