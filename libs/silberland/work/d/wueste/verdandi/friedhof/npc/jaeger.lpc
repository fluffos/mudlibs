inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenbeinjaeger");
  SetProp(P_LONG,
    "Im Kampf kannst Du eigentlich nicht genau erkennen wie der Elfenbeinjaeger aussieht, "
    "da er wie wild auf Dich einschlaegt und Du sehr damit beschaeftigt bist, am Leben "
    "zu bleiben. Dir fallen nur seine zornigen Augen und die dunklen Wuschelhaare auf. "
    "Wahrscheinlich hat er Dich schon laengere Zeit still beobachtet und wartete nur "
    "den richtigen Moment ab, um Dich anzugreifen. ");

  SetProp(P_NAME, "Elfenbeinjaeger");
  SetProp(P_GENDER, MALE);
  AddId( ({ "elfenbeinjaeger","jaeger" }) );

  AddDetail( ({ "augen" }),
  	"Zornigere Augen hast Du noch nie in Deinem Leben gesehen. Wenn Blicke toeten "
  	"koennten...");
  
  AddDetail( ({ "wuschelhaare", "haare", "locken" }),
	"Schwarze, lockige Haare haengen dem Elfenbeinjaeger tief in die Stirn, als er "
	"Dich finster ansieht.");

  AddDetail( ({ "stirn", "stirne" }),
  	"Die Stirn ist durch die vielen Wuschelhaare nicht zu sehen.");

  create_default_npc(18+random(2));
  SetProp(P_HANDS, ({" mit einer scharfen Knochensaege",
                   QueryProp(P_HANDS)[1],DT_RIP}));
                   
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180+random(10));
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
//  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:     0.2, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:    0.2,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.3, DT_SOUND: -0.8, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR: 0.2,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "kommt auf der Suche nach Stosszaehnen auf Dich zu");
  SetProp(P_MSGOUT, "rennt wild schreiend");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES);
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 62, 30, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-b2");

  SetProp(P_DIE_MSG,  " faellt blutueberstroemt zu Boden.\n");

  AddInfo(DEFAULT_INFO, "schreit Dich nur an.\n");

  SetProp(P_SPELLRATE,75);
  
  AddSpell(1,200,
    "Der Elfenbeinjaeger setzt Dir die Knochensaege an.\n",
    "Der Elfenbeinjaeger setzt @WEM die Knochensaege an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,150,
    "Der Elfenbeinjaeger versetzt Dir einen Tritt in den Hintern.\n",
    "Der Elfenbeinjaeger versetzt @WEM einen Tritt in den Hintern.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
     
  AddSpell(3,250,
    "Der Elfenbeinjaeger erwischt Dich an der Gurgel und drueckt fest zu.\n",
  	"Der Elfenbeinjaeger erwischt @WEN an der Gurgel und drueckt fest zu.\n",
  	 DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  	 
  AddSpell(3,100,
    "Der Elfenbeinjaeger pruegelt wild auf Dich ein.\n",
  	"Der Elfenbeinjaeger pruegelt wild auf @WEN ein.\n",
  	 DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  	 
  AddSpell(2,200,
    "Der Elfenbeinjaeger toetet Dich beinahe mit seinen Blicken.\n",
    "Der Elfeinbeinjaeger toetet @WEN beinahe mit seinen Blicken.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  	 
  SetAttackChats(20, ({
   	"Der Elfenbeinjaeger bruellt: Du bekommst das Elfenbein nur ueber meine Leiche!\n",
   	"Der Elfenbeinjaeger schreit: Hau ab, das gehoert alles mir! Verschwinde!!!\n",
  	"Solche Typen wie Dich hasst der Elfenbeinjaeger wie die Pest!\n" }) );
  		
	SUID;
	
  CLONEME(WEAPON "saege" );
  command("zuecke knochensaege");
  
  CLONEME(ARMOUR "elfbamulett");
  CLONEME(ARMOUR "sombrero");
  command("trage alles");
}

reset() {
  object ob,next;
  ::reset();
  if (is_clone(this_object()) && MENV) {
    tell_room(MENV,BS(
      "Der Elfenbeinjaeger verschwindet in die offene Wueste."));
    ME->move("/room/void",M_GO | M_SILENT);
    for(ob=first_inventory(ME);ob;) {
      next=next_inventory(ob);
      ob->remove();
      ob=next;
    }
    call_out("remove",0);
  }
}

int PreventFollow(object dest) {
  if(!dest) return 0;
  if(file_name(dest)[0..32] != "/d/wueste/verdandi/friedhof/room/") return 1;
  return 0;
}

void give_notify(object was) {
  object ob;
  if (!(was->id("stosszahn"))) return ::give_notify(was);
  say(BS("Der Elfenbeinjaeger bruellt: AAAAHHH!!! DANKE!!!!"));
  call_out("reset",0);
  return ::give_notify(was);
}

init() {
  ::init();
  if(!TP) return;
  if(!interactive(TP)) return;
  if(!present("stosszahn",TP)) return;
  call_out("angriff",0,TP);
}

angriff(object ob) {
  if(!present(ob)) return;
  tell_room(MENV,BS(
    "Der Elfenbeinjaeger bruellt: ICH WILL DEINEN STOSSZAHN, "+
    CAP_TPN+"!!!"));
  ME->Kill(ob);
}

