
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Schakalmutter");
  SetProp(P_LONG,
    "Die Schakalmutter stuerzt sich auf Dich, um den Tod ihres Babys zu raechen. "   
    "Du blickst ihr genau in die Augen, worauf sie noch wilder wird und aggressiv um sich "    
    "beisst. Du haettest wohl damit rechnen muessen, dass die Mutter des kleinen Schakals "    
    "ganz in der Naehe ist. ");

  SetProp(P_NAME, "Schakalmutter");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schakal","schakalmutter","mutter", "NOWIMPY" }) );

  AddDetail( ({ "augen" }),	
  	"Du siehst zwei hasserfuellte, abgrundtief boese Augen.");
  
  create_default_npc(17+random(4));
  SetProp(P_HANDS, ({" mit ihren scharfen Reisszaehnen",
                   QueryProp(P_HANDS)[1]+100,DT_PIERCE}));
                   
  SetProp(P_RACE, "Schakal");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 

    ([DT_FIRE:      -0.2, DT_COLD:       0.2, DT_WATER:  0.2, DT_AIR:   -0.7,
      DT_LIGHTNING:  0.7, DT_EXPLOSION: -0.5, DT_SOUND: -1.0, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "springt Dich laut knurrend an");
  SetProp(P_MSGOUT, "fluechtet");
  SetProp(P_DIE_MSG,  " bricht neben ihrem toten Baby leblos zusammen.\n");

  AddInfo(DEFAULT_INFO, "kann doch nicht sprechen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schakalmutter kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(1,400,
    "Die Schakalmutter zerfleischt Dir den Arm.\n",
    "Die Schakalmutter zerfleischt @WESSEN Arm.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,250,
    "Die Schakalmutter stuerzt sich aggressiv auf Dich.\n",
    "Die Schakalmutter stuerzt sich aggressiv auf @WEN \b.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
       
  AddSpell(1,500,
    "Die Schakalmutter beisst wild um sich.\n",   
    "Die Schakalmutter beisst wild um sich.\n",   
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    call_out("remove",2);
  }
}

