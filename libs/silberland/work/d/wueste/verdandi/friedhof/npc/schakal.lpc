
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include "/d/wueste/verdandi/puzzle/puzzle.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein raeudiger Schakal");
  SetProp(P_LONG,
    "Dieser Schakal sieht durch die Hitze ziemlich mitgenommen aus. Sein grau-braunes Fell ist "    
    "raeudig, und er scheint eine Menge Floehe zu haben, denn er kratzt sich staendig. An "    
    "seinem buschigen Schwanz bemerkst Du ueberwiegend schwarzes Haar, waehrend Lippen, Kehle "    
    "und Brust weiss sind. Anders als andere Hundeartige lebt der Schakal einzeln oder in "    
    "Paaren. Dieser hier scheint aber allein zu sein. Oder doch nicht? ");

  SetProp(P_NAME, "Schakal");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "raeudig");
  AddId( ({ "schakal" }) );  
  AddAdjective( ({ "raeudiger", "raeudigen" }) );

  AddDetail( ({ "fell" }), 	
  	"Das grau-braune Fell des Schakals sieht ziemlich raeudig aus."); 
   
  AddDetail( ({ "floehe" }),
	"Du moechtest gar nicht wissen, wie viele Floehe der Schakal hat. Es muessen Millionen sein!");

  AddDetail( ({ "schwanz" }),
  	"Der Schwanz ist im Gegensatz zum restlichen Koerper buschig und ganz schwarz.");
 
  AddDetail( ({ "lippen", "kehle", "brust", "weiss" }),
  	"Lippen, Kehle und Brust sind weiss. Es handelt sich aber eher um ein dreckiges Weiss als um "
  	"ein strahlendes."); 
 
  AddDetail( ({ "blick" }),
	"Boeser koennen Blicke kaum sein.");

  AddDetail( ({ "maul", "zaehne" }),
  	"Im blutverschmierten Maul kannst Du einige spitze Zaehne herausblitzen sehen.");

  AddDetail( ({ "augen" }),
	"Die Augen sind sandbraun und schauen Dich bedrohlich an.");

  create_default_npc(20+random(2));
  
  SetProp(P_HANDS, ({" mit seinem blitzweissen Gebiss",
                   QueryProp(P_HANDS)[1]+50,DT_PIERCE}));
  SetProp(P_RACE, "Schakal");
  SetProp(P_SIZE, 120+random(10));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 

    ([DT_FIRE:       0.2, DT_COLD:       0.2, DT_WATER:  0.2, DT_AIR:    0.2,
      DT_LIGHTNING: -0.9, DT_EXPLOSION: -0.5, DT_SOUND: -0.4, DT_LIGHT: -0.6,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:      -0.1, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "streunt herein");
  SetProp(P_MSGOUT, "streunt");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES); 
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 36, 25, 60 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-c2");
  SetProp(P_DIE_MSG,  " stirbt einen graesslichen Tod.\n");

  AddInfo(DEFAULT_INFO, "knurrt Dich nur boese an.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schakal denkt gar nicht daran, @WEN zu tragen.\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(2,300,
    "Der Schakal bohrt Dir seine scharfen Zaehne tief ins Fleisch.\n",
    "Der Schakal bohrt @WEM seine scharfen Zaehne tief ins Fleisch.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,200,
    "Der Schakal springt Dich von hinten an.\n",
    "Der Schakal springt @WEN von hinten an.\n",
     ({ DT_TERROR, DT_RIP }),([SP_SHOW_DAMAGE:1]));
         
  AddSpell(2,200,
    "Der Schakal will Dich in die ewigen Jagdgruende befoerdern.\n",   
    "Der Schakal will @WEN in die ewigen Jagdgruende befoerdern.\n",    
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Schakal wirft Dir einen boesen Blick zu.\n",
    "Der Schakal umkreist Dich.\n",
    "Der Schakal kratzt sich. Sicher plagen ihn eine Menge Floehe.\n",
    "Der Schakal begutachtet Dich ganz genau.\n",
    "Der Schakal schleckt sich sein Maul, als er Dich ansieht.\n",
    "Der Schakal fletscht bedrohlich die Zaehne.\n",
    "Der Schakal beschnuppert Dich.\n",
    "Der Schakal knurrt Dich leise an.\n",
    "Der Schakal hat bereits einen Riesenhunger.\n",
    "Der Schakal leidet stark unter der Hitze.\n",
    "Der Schakal heult laut auf.\n",
    "Der Schakal straeubt die Haare, um Dir zu imponieren.\n"
    "Der Schakal schleicht um Dich herum.\n",
    "Der Schakal sabbert hungrig auf den Boden.\n",
    "Der Schakal fixiert Dich mit seinen Augen.\n",
    "Der Schakal ueberlegt, wie Du wohl schmecken wuerdest.\n",
    "Der Schakal schaut Dich furchteinfloessend an.\n",
    "Der Schakal versucht Dich mit boesen Blicken einzuschuechtern.\n",
    "Der Schakal hat schon lange nichts mehr gefressen.\n",
    "Der Schakal freut sich schon auf seine naechste Mahlzeit.\n" }) );
}


void die(int poisondeath) {
  object ob;
  
  if(TP->QueryQuest(QUESTNAME)) {
    if(!present("\n_mag_knochen",TP)) {
      catch(ob=clone_object("/d/wueste/verdandi/puzzle/obj/xplog"));
      if(ob) {
        ob->move(TP,M_NOCHECK);
        write(BS(
          "Mit Deinem letzten Hieb schlaegst Du dem Schakal einen ganzen "
          "Knochen aus dem Leib heraus. Verwundert steckst Du ihn schnell "
          "ein."));  
      }
    }
  }
  ::die(poisondeath);
}
