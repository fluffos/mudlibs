
inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bueffel");
  SetProp(P_LONG,
    "Der Bueffel gehoert zwar nicht zu den Raubtieren, aber er ist trotzdem in seiner "
    "Gefaehrlichkeit nicht zu unterschaetzen. Er koennte locker einen Loewen zertreten. "
    "Ausserdem ist er sehr unberechenbar, denn er greift alles und jeden an. Die langen "
    "geschwungenen Hoerner jagen Dir maechtigen Respekt ein. Du solltest also sehr vorsichtig "
    "sein, dass Du nicht sein naechstes Opfer bist. ");

  SetProp(P_NAME, "Bueffel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "bueffel" }) );

  AddDetail( ({ "hoerner", "horn", "haupt" }),
	"Maechtige Hoerner zieren des Bueffels Haupt.");
	
  AddDetail( ({ "respekt" }),
	"Die Hoerner des Bueffels jagen Dir maechtigen Respekt ein.");
  
  AddDetail( ({ "opfer" }),
	"Er sieht Dich schon so an, als plante er etwas...");

  create_default_npc(26);
  SetProp(P_HANDS, ({" mit seinen maechtigen Hoernern",
                   QueryProp(P_HANDS)[1]+80,DT_PIERCE}));

  SetProp(P_RACE, "Bueffel");
  SetProp(P_SIZE, 180+random(10));
  SetProp(P_ALIGN, -350);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:       0.0, DT_WATER:  0.2, DT_AIR:   -0.3,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.5, DT_SOUND: -0.4, DT_LIGHT: -0.4,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR:-0.6,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "kommt laut schnaubend an");
  SetProp(P_MSGOUT, "verzieht sich");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES);
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 50, 50, 44 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-c1");

  SetProp(P_DIE_MSG,  " war wohl doch schwaecher als Du dachtest.\n");

  AddInfo(DEFAULT_INFO, "kann Dir leider nicht antworten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Bueffel schuettelt @WEN sofort wieder ab.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(1,400,
    "Der Bueffel zertrampelt Dich.\n",
    "Der Bueffel zertrampelt @WEN.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Der Bueffel versetzt Dir einen Kopfstoss mit seinen maechtigen Hoernern.\n",
    "Der Bueffel versetzt @WEM einen Kopfstoss mit seinen maechtigen Hoernern.\n",
     ({ DT_BLUDGEON,DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
     
  AddSpell(1,500,
    "Der Bueffel rammt Dich ungespitzt in den Boden.\n",
    "Der Bueffel rammt @WEN ungespitzt in den Boden.\n",
     ({ DT_BLUDGEON,DT_SQUEEZE }),([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Bueffel schnaubt Dir eine Staubwolke entgegen.\n",
    "Der Bueffel sieht Dich mordlustig an.\n",
    "Der Bueffel wird sicher gleich angreifen.\n",
    "Der Bueffel senkt sein Haupt.\n",
    "Der Bueffel fuehlt sich Dir gegenueber sehr ueberlegen.\n",
    "Der Bueffel verhaelt sich noch friedlich.\n" }) );

  SUID;
  
  CLONEME(ARMOUR "bueffelfell");
  CLONEME(ARMOUR "hornkrone");
  command("trage alles");

}

