
inherit "std/mnpc";


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int vogelda;

create() {
  if (!is_clone(this_object())) return;

  ::create();
  vogelda=0;

  SetProp(P_SHORT, "Ein Elefant");
  SetProp(P_LONG,
    "Vor Dir steht ein ziemlich grosser Elefant mit sehr grossen Ohren. Sein Ruessel haengt "
    "traurig herunter und schlenkert im Takt seiner Schritte. Seine Haut ist trocken und "
    "sandig. Ausser den Borsten kannst Du noch etwas auf seinem Ruecken erkennen. ");

  SetProp(P_NAME, "Elefant");
  SetProp(P_GENDER, MALE);
  AddId( ({ "elefant" }) );

  
  AddDetail( ({ "ohren", "ohr", "sonnendach" }),
  	"Die Ohren des Elefanten sind riesig. Sie bilden ein Sonnendach, "
  	"das den Elefanten vor der Hitze ein wenig schuetzt.");
  
  AddDetail( ({ "ruessel" }),
	"Der Ruessel haengt traurig herunter und schlenkert langsam hin und her.");

  AddDetail( ({ "haut" }),
	"Die Haut ist zerfurcht und ausgetrocknet. Millionen von Falten breiten sich "
	"auf dem Elefantenkoerper aus.");
  
  AddDetail( ({ "borsten" }),
  	"Du kannst einzelne stachelige Borsten auf dem Ruecken erkennen.");

  AddDetail( ({ "falten", "elefantenkoerper", "koerper" }),
  	"Eigentlich besteht der gesamte Elefant aus Falten. Du bist froh, dass Du "
  	"noch nicht so viele hast.");
  
  create_default_npc(25+random(3));

  SetProp(P_HANDS, ({" mit seinen Stosszaehnen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));

  SetProp(P_RACE, "Elefant");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:       0.1, DT_WATER: -0.2, DT_AIR:   -0.5,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.8, DT_SOUND: -1.0, DT_LIGHT: -0.2,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.2 ]) );

//  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES);
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 54, 60, 60 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-b4");

  SetProp(P_DIE_MSG,  " faellt laut krachend zu Boden.\n"
  					  "Ein Stosszahn bricht dabei ab und faellt Dir vor die Fuesse.\n");

  AddInfo(DEFAULT_INFO, "kann Dir nicht antworten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Elefant will @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(2,400,
    "Der Elefant schleudert Dir seinen Ruessel entgegen.\n",
    "Der Elefant schleudert @WEM seinen Ruessel entgegen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der Elefant trampelt auf Deinen Fuessen herum.\n",
    "Der Elefant trampelt auf @WESSEN Fuessen herum.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Der Elefant ersticht Dich fast mit seinen Stosszaehnen.\n",
    "Der Elefant ersticht @WEN fast mit seinen Stosszaehnen.\n",
	 DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,200,
    "Der Elefant trompetet Dir schrill ins Ohr.\n",
	"Der Elefant trompetet @WEM schrill ins Ohr.\n",
	 DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Elefant steigt fast auf Dich drauf.\n",
    "Der Elefant betastet Dich mit seinem Ruessel.\n",
    "Der Elefant trompetet, dass Dir ganz schwindlig wird.\n",
    "Der Elefant sucht den Boden nach etwas Essbarem ab.\n",
    "Der Elefant steckt seinen Ruessel ins Maul.\n",
    "Der Elefant hat ueberhaupt keine Angst vor Dir.\n",
    "Der Elefant schaut Dich traurig an.\n",
    "Der Elefant wackelt mit seinen grossen Ohren.\n",
    "Der Elefant betastet die auf dem Boden liegenden Knochen mit dem Ruessel.\n",
    "Der Elefant streckt Dir seinen feuchten Ruessel entgegen.\n",
    "Der Elefant draengt Dich ein Stueck zur Seite.\n",
    "Der Elefant sieht Dich vertrauensvoll an.\n" }) );

  AddSpecialDetail( "ruecken","vogelkomm" );

  SUID;
  CLONEME(WEAPON "stosszahn" ); 
  command("zuecke stosszahn");
  
  CLONEME(ARMOUR "elefantenhaut");
  command("trage alles");
}

string vogelkomm(string str) {
  object ob;
  if(vogelda!=0)
    return BS(
      "Ein kleiner Vogel sitzt auf dem Ruecken des Elefanten und pickt ihm "
      "die Parasiten von der Haut.");
  ob=clone_object( NPC "vogel.lpc" );
  vogelda=1;
  if(ob) {
    ob->move(ME,M_NOCHECK);
  }
  return BS(
    "Erst jetzt erkennst Du den kleinen Vogel auf dem Ruecken des Elefanten. "
    "Er hockt dort und pickt dem Elefanten kleine Parasiten von der Haut.");
}

void die(int poisondeath) {
  object env,ob,next;
  if(!env=MENV) {
    ::die(poisondeath);
    return;
  }
  for(ob=first_inventory(ME);ob;) {
    next=next_inventory(ob);
    ob->DoUnwear(1);
    ob->move(env,M_SILENT + M_NOCHECK);
    ob=next;
  }
  ::die(poisondeath);
}

