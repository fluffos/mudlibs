
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Zebra");
  SetProp(P_LONG,
    "Du bist Dir nicht ganz sicher, welche Farbe das Zebra hat. Ist es schwarz mit weissen "
    "Streifen oder weiss mit schwarzen Streifen? Egal wie man es betrachten will, die "
    "Streifen verschwimmen ohnehin fast voellig durch die heissen Luftspiegelungen, "
    "sodass das Tier vor Raubtieren in der Ferne optimal getarnt ist. ");

  SetProp(P_NAME, "Zebra");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "zebra" }) );

  AddDetail( ({ "farbe" }),
  	"Das Zebra ist schwarz-weiss.");
  
  AddDetail( ({ "streifen" }),
	"Manche Streifen sind schwarz, manche weiss. Anscheinend erhoehen "
	"die Streifen die Ueberlebenschancen des Zebras, denn sie verschwimmen "
	"in der Ferne, und die Raubtiere koennen die Zebras nicht mehr so gut "
	"erkennen.");

  AddDetail( ({ "luftspiegelungen", "luftspiegelung", "ferne" }),
  	"Du erkennst die Streifen noch recht gut. Nur in der Ferne beginnen sie "
  	"zu flimmern.");
  
  create_default_npc(18+random(2));
  SetProp(P_HANDS, ({" mit seinen scharfkantigen Hufen",
                   QueryProp(P_HANDS)[1],DT_SQUEEZE}));

  SetProp(P_RACE, "Zebra");
  SetProp(P_SIZE, 160+random(10));
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
  
    ([DT_FIRE:      -0.2, DT_COLD:       0.2, DT_WATER:  0.2, DT_AIR:   -0.5,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.5, DT_SOUND:  0.4, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "kommt angetrabt");
  SetProp(P_MSGOUT, "galoppiert weiter"); 
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES); 
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 53, 30, 15 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-c1");
  SetProp(P_DIE_MSG,  " hat den letzten Schlag nicht ueberlebt und bricht zusammen.\n");

  AddInfo(DEFAULT_INFO, "kann Dir leider nicht antworten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Zebra schuettelt @WEN gleich wieder ab.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(1,400,
    "Das Zebra peitscht Dir seinen Schwanz mitten ins Gesicht.\n",
    "Das Zebra peitscht @WEM seinen Schwanz mitten ins Gesicht.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Das Zebra baeumt sich gefaehrlich vor Dir auf.\n",
    "Das Zebra baeumt sich vor @WEM gefaehrlich auf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
     
  AddSpell(1,500,
    "Das Zebra wirbelt Dir seine Vorderhufe um die Ohren.\n",
    "Das Zebra wirbelt @WEM seine Vorderhufe um die Ohren.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Das Zebra schnaubt Dich wild an.\n",
    "Das Zebra sucht ein paar halbwegs saftige Grasbueschel.\n",
    "Das Zebra verscheucht die laestigen Fliegen mit seinem Schwanz.\n",   
    "Das Zebra ignoriert Dich voellig.\n",   
    "Das Zebra baeumt sich vor Dir auf.\n",
    "Das Zebra sucht ein schattiges Plaetzchen.\n",
    "Das Zebra geht unruhig hin und her.\n",    
    "Das Zebra schaut gelangweilt in der Gegend herum.\n",
    "Das Zebra atmet Dir heiss ins Gesicht.\n",   
    "Das Zebra wirbelt ein wenig Sand auf.\n",
    "Das Zebra haut auf einmal nach hinten aus.\n",    
    "Das Zebra stampft mit einem Bein auf.\n" }) );
    
  SUID;
  CLONEME(OBJ "zebrahufe");
  CLONEME(OBJ "zebrahufe");
}

