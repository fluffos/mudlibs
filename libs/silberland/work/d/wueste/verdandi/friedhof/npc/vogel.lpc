
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Madenhacker");
  SetProp(P_LONG,
    "Diese kleinen Voegel leben in enger Symbiose mit den Elefanten zusammen. "
    "Sie befreien die Dickhaeuter von laestigen Insekten und Parasiten. Dafuer "
    "bietet ihnen der Elefant Nahrung und Schutz vor Feinden. ");

  SetProp(P_NAME, "Madenhacker");
  SetProp(P_GENDER, MALE);
  AddId( ({ "madenhacker","vogel" }) );

  AddDetail( ({ "symbiose" }),
  	"Jeder Madenhacker hat einen Elefanten, mit dem er in enger Symbiose lebt.");
  
  AddDetail( ({ "insekten", "parasiten", "insekt", "parasit", "leibspeise" }),
	"Insekten und Parasiten sind die Leibspeise des kleinen Vogels.");

  AddDetail( ({ "koepfchen", "kopf" }),
  	"Der kleine Vogel hat sein Koepfchen kurz in die Federn gesteckt.");
  
  AddDetail( ({ "federn", "gefieder" }),
	"Flaumig, weich und zart sehen die Federn aus."); 

  create_default_npc(5);
  SetProp(P_HANDS, ({" so gut wie gar nicht",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS ,
   
    ([DT_FIRE:       0.1, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:   -1.0,
      DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "flattert aufgeregt auf Dich zu");
  SetProp(P_MSGOUT, "flattert aufgeregt");
  SetProp(P_DIE_MSG,  " bleibt regungslos auf dem Boden liegen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich leider nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Vogel kann @WEN nicht tragen.\n" }) );
        
  SetChats(1, ({
  	
  	"Der kleine Vogel putzt sich sein Gefieder.\n",
  	"Der kleine Vogel pickt eine Ameise vom Boden auf.\n",
  	"Der kleine Vogel zwitschert vergnuegt vor sich hin.\n",
  	"Der kleine Vogel traellert ein Liedchen.\n",
  	"Der kleine Vogel duckt sich.\n",
  	"Der kleine Vogel badet im Sand.\n",
  	"Der kleine Vogel steckt sein Koepfchen zwischen die Federn.\n" }) );
}

