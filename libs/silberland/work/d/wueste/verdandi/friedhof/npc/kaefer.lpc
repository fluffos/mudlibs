
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein winziger Kaefer");
  SetProp(P_LONG,
    "Dieser Kaefer ist wirklich sehr klein und durch seine Tarnfarbe kaum vom "
    "Untergrund zu unterscheiden. Du kannst ihn eigentlich nur sehen, wenn er sich "    
    "bewegt. Seine winzigen Beinchen tragen ihn schnell ueber den heissen, sandigen "   
    "Boden. ");
    
  SetProp(P_NAME, "Kaefer");
  SetProp(P_NAME_ADJ, "winzig");
  SetProp(P_GENDER, MALE);
  AddId( ({ "kaefer", "NOWIMPY" }) );
  AddAdjective( ({ "winziger", "winzigen" }) );

  AddDetail( ({ "tarnfarbe", "farbe", "untergrund" }),
  	"Der Kaefer ist Dank seiner Tarnfarbe auf dem Untergrund fast nicht zu erkennen,");
   
  AddDetail( ({ "beinchen", "beine" }),
	"Flink flitzt der Kaefer auf seinen winzigen Beinchen ueber den heissen Boden.");

  AddDetail( ({ "fluegel" }),  
  	"Manchmal spreizt der winzige Kaefer seine kleinen Fluegel.");
  	 
  AddDetail( ({ "fuehler" }),  
  	"Die Fuehler sind noch viel duenner als die Beinchen.");
  
  create_default_npc(5+random(2));
  SetProp(P_HANDS, ({" mit seinen Beisswerkzeugen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 1+random(2));
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_RESISTANCE_STRENGTHS , 
  
    ([DT_FIRE:      -0.2, DT_COLD:       0.1, DT_WATER:  0.4, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0, DT_SQUEEZE: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "krabbelt Dir beinahe in die Nase");
  SetProp(P_MSGOUT, "krabbelt schnell");
  SetProp(P_DIE_MSG,  " bleibt flach auf dem Boden kleben.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich ueberhaupt nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kaefer kann @WEN doch nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,90);
  
  AddSpell(1,100,
    "Der Kaefer zwickt Dich.\n",
    "Der Kaefer zwickt @WEN.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
     
  AddDefaultSpell(3, 200, DS_POISON,
    "Der Kaefer vergiftet Dich leicht.\n",   
    "Der Kaefer vergiftet @WEN leicht.\n");

  AddSpell(1,50,  
  	"Der Kaefer krabbelt Dein Bein hoch.\n",  	
  	"Der Kaefer krabbelt @WESSEN Bein hoch.\n", 	
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der kleine Kaefer versteckt sich kurz unter einer Wurzel.\n",
    "Der kleine Kaefer spreizt seine Fluegel.\n",
    "Der kleine Kaefer krabbelt aufgeregt hin und her.\n",    
    "Der kleine Kaefer versucht sich im Boden zu vergraben.\n",
    "Der kleine Kaefer putzt sich die Fuehler.\n" }) );
}

reset() {
  ::reset();
  if (is_clone(this_object()) && MENV) {
    tell_room(MENV,BS(
      "Der kleine Kaefer verschwindet zwischen all den Knochen."));
    ME->move("/room/void",M_GO | M_SILENT);
    call_out("remove",0);
  }
}
