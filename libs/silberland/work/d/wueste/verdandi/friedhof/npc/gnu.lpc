
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int startwert;
int runde;

create() {
  if (!is_clone(this_object())) return;
  ::create();

  runde = 0;
  startwert = 0;

  SetProp(P_SHORT, "Eine Gnuherde");
  SetProp(P_LONG,
    "Gnus gehoeren zu den eher dummen Tieren des SilberLandes. Sie machen immer das, was alle "
    "machen. Faengt eines an wegzulaufen, dann laufen alle. Faengt eines an zu fressen, dann "
    "fressen alle. Dennoch sind sie aber sehr nuetzliche Tiere, denn die Hyaenen ernaehren "
    "sich liebend gerne von ihnen. ");

  SetProp(P_NAME, "Gnuherde");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "gnu", "gnus", "gnuherde", "herde" }) );

  create_default_npc(25+random(3));
  SetProp(P_HANDS, ({" mit unzaehligen Hoernern",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));

  startwert=QueryProp(P_HANDS)[1];
  
  SetProp(P_RACE, "Gnu");
  SetProp(P_SIZE, 160+random(10));

  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:       0.2, DT_WATER:  0.2, DT_AIR:    0.1,
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.5, DT_SOUND: -0.1, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.1, DT_TERROR: 0.5,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "taucht hinter Dir auf");
  SetProp(P_MSGOUT, "geht vorsichtig");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES);
  SetProp(P_MNPC_AREA, ({ ROOM "room-e2", ROOM "room-f2", ROOM "room-d" }) );
  SetProp(P_MNPC_WAIT, ({ 83, 42, 62 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-e2");

  SetProp(P_DIE_MSG,  " faellt blutend zu Boden und wirbelt eine Menge Sand auf.\n");

  AddInfo(DEFAULT_INFO, "kann Dir nicht antworten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Gnus schuetteln @WEN sofort ab.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(2,200,
    "Ein Gnu springt Dich auf einmal an.\n",
    "Ein Gnu springt @WEN auf einmal an.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Ein Gnu schnaubt Dich wild an.\n",
    "Ein Gnu schnaubt @WEN wild an.\n",
     ({ DT_AIR,DT_SOUND }),([SP_SHOW_DAMAGE:1]));
     
  AddSpell(1,500,
    "Ein Gnu schleudert Dir eine Ladung Sand entgegen.\n",
    "Ein Gnu schleudert @WEM eine Ladung Sand entgegen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Gnuherde geht langsam auf und ab.\n",
    "Ein paar Gnus waelzen sich verspielt auf dem Boden.\n",
    "Ein Gnu rupft einen Grashalm ab.\n",
    "Ein Gnu gibt ein eigenartiges Geraeusch von sich.\n"
    "Die Gnuherde nimmt keine Notiz von Dir.\n",
    "Die Gnus schauen gelangweilt in die Ferne.\n",
    "Alle Gnus senken den Kopf.\n",
    "Einige Gnus wittern, ob Raubtiere in der Naehe sind.\n",
    "Auf einmal wackeln alle Gnus mit den Ohren.\n" }) );
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy) {
  runde++;
  if(runde > 10+random(5)) {
    runde=0;
    tell_room(MENV,BS(
      "Ein Gnu faellt tot zu Boden!"));
    SetProp(P_HANDS, ({" mit unzaehligen Hoernern",
            QueryProp(P_HANDS)[1]*95/100,DT_PIERCE}));
  }
  return ::Defend(dam,dam_type_list,spell,enemy);
}

reset() {
  ::reset();
  if(!is_clone(ME)) return;
  SetProp(P_HANDS, ({" mit unzaehligen Hoernern",
          startwert,DT_PIERCE}));
}

