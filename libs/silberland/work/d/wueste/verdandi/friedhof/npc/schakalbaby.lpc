
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Schakalbaby");
  SetProp(P_LONG,    
    "Der kleine Schakal beobachtet Dich mit grossen Kulleraugen und verfolgt "
    "jede Deiner Bewegungen. Du schaetzt, dass er erst vor wenigen Tagen "    
    "geboren wurde. Seltsam kommt Dir nur vor, dass seine Eltern ihn ganz alleine "   
    "gelassen haben... ");

  SetProp(P_NAME, "Schakalbaby");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "schakal","schakalbaby","baby","NOWIMPY" }) );

  AddDetail( ({ "kulleraugen", "augen" }),	
  	"Verschlafen blickt Dich das Schakalbaby mit grossen Kulleraugen an.");
   
  AddDetail( ({ "eltern" }),
	"Die Eltern sind wohl nicht hier...");

  AddDetail( ({ "beinchen", "bein" }),
  	"Der kleine Schakal steht noch recht wackelig auf seinen Beinchen.");

  create_default_npc(6+random(3));

  SetProp(P_HANDS, ({" mit seinen nadelspitzen Zaehnchen und den kleinen Pfoetchen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Schakal");
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 

    ([DT_FIRE:       0.2, DT_COLD:       0.5, DT_WATER:  0.0, DT_AIR:   -0.3,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.3, DT_SOUND:  0.4, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_DIE_MSG,  " haucht sein junges Leben aus.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich leider ueberhaupt nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Schakal kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(2,200,
    "Der kleine Schakal geraet in Panik und schnappt nach Dir.\n",
    "Der kleine Schakal geraet in Panik und schnappt nach @WEM.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
    "Das Schakalbaby zwickt Dich in die Nase.\n",
    "Das Schakalbaby zwickt @WEN in die Nase.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der kleine Schakal ringelt sich auf seinem Schlafplatz ein.\n",
    "Das Schakalbaby schaut Dich skeptisch an.\n",
    "Der kleine Schakal hebt ein Beinchen und pinkelt auf den Boden.\n",    
    "Das Schakalbaby schlaeft genuesslich ein.\n",   
    "Der kleine Schakal schnuppert Dich ab.\n",
    "Das Schakalbaby winselt leise.\n",
    "Der kleine Schakal blinzelt Dich muede an.\n",
    "Das Schakalbaby rollt sich klein zusammen.\n",
    "Der kleine Schakal hat schon grossen Hunger.\n",    
    "Das Schakalbaby hebt das Koepfchen.\n",    
    "Der kleine Schakal wartet geduldig auf die Rueckkehr seiner Mutter.\n",   
    "Das Schakalbaby beobachtet Dich mit grossen Kulleraugen.\n" }) );
}

void die(int poisondeath) {
  object env,ob;
  if (!env=MENV) {
    ::die(poisondeath);
    return;
  }
  tell_room(env,BS(
    "Kurz bevor das Schakalbaby sein junges Leben aushaucht, hoerst "
    "Du aus einer dunklen Ecke des Raumes ein lautes Knurren. Auf einmal "
    "siehst Du zwei Augen, die aus der Finsternis in Deine Richtung starren."));
  ob=clone_object( NPC "schakalmutter" );
  if(ob) {
    ob->move(env,M_GO);
    ob->Kill(PL);
    tell_object(PL,BS(
      "Die Schakalmutter greift Dich ob Deiner ruchlosen Tat sofort an!"));
  }
  ::die(poisondeath);
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
  	case "frech":
  	case "fies":
      call_out("reaction", 0, TP,
        "knurrt Dich leise an.",
        "knurrt "+TPN+" leise an.");
      break;
      
    case "nett":
      call_out("reaction", 0, TP,
        "kuschelt sich eng an Dich an.",
        "kuschelt sich eng an "+TPN+" an.");
      break;
      
    case "intim":
      call_out("reaction", 0, TP,
        "zuckt zusammen.",
        "zuckt zusammen.");
      break;   
  }
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
