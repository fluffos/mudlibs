
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Tuepfelhyaene");
  SetProp(P_LONG,
    "Diese Hyaene sieht mit ihrem raeudigen Fell sehr abstossend aus. Auf dem "
    "Ruecken ist sie schwarz getupft und sie ist bereits so abgemagert, dass man " 
    "ihre Rippen erkennen kann. Obwohl Hyaenen vom Erscheinungsbild her eher einem "    
    "Hund gleichen, gehoeren sie zur Familie der Katzen. Allerdings treten diese "    
    "Katzen meist in Rudeln auf. Also halte die Augen offen, denn es koennte sein, "    
    "dass sie bald Verstaerkung bekommt. ");

  SetProp(P_NAME, "Tuepfelhyaene");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "tuepfelhyaene","hyaene" }) );

  AddDetail( ({ "ruecken", "fell" }),
	"Das raeudige Fell ist am Ruecken schwarz getupft.");
	
  AddDetail( ({ "rippen" }),
  	"Du kannst die einzelnen Rippen erkennen, so abgemagert ist die arme Hyaene."); 

  create_default_npc(17+random(3));
  
  SetProp(P_HANDS, ({" mit ihren scharfen Fangzaehnen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
                   
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 70+random(15));
  SetProp(P_AGGRESSIVE, 1);  
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 

    ([DT_FIRE:      -0.2, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:   -1.0,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.3, DT_SOUND: -0.4, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));

  SetProp(P_MSGIN, "springt hinter einem Schaedelknochen hervor");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_DIE_MSG,  " bleibt tot auf dem Boden liegen.\n");

  AddInfo(DEFAULT_INFO, "knurrt Dich boese an.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Hyaene kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(1,300,
    "Die Hyaene springt Dich ploetzlich wild an.\n",
    "Die Hyaene springt @WEN ploetzlich wild an.\n",
     ({ DT_TERROR, DT_RIP }),([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Die Hyaene verbeisst sich in Deinem Bein.\n",
    "Die Hyaene verbeisst sich in @WESSEN Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
}

reset() {
  object ob,next;
  ::reset();
  if (is_clone(this_object()) && MENV) {
    tell_room(MENV,BS(
      "Die Hyaene schleicht in den Schaedel zurueck."));
    ME->move("/room/void",M_GO | M_SILENT);
    for(ob=first_inventory(ME);ob;) {
      next=next_inventory(ob);
      ob->remove();
      ob=next;
    }
    call_out("remove",0);
  }
}
