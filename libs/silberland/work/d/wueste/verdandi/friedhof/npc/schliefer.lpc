
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Klippschliefer");
  SetProp(P_LONG,
    "Das murmeltierartige Erdhoernchen sieht wie ein kleines Wollknaeuel aus. Auch wenn Du "
    "es nicht fuer moeglich halten wirst, aber der kleine Klippschliefer ist ein entfernter "
    "Verwandter der Elefanten. Er lebt in tiefen Hoehlen in der Erde und ernaehrt sich "
    "hauptsaechlich von Insekten. ");

  SetProp(P_NAME, "Klippschliefer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "klippschliefer","schliefer","erdhoernchen","hoernchen" }) );
  
  AddDetail( ({ "insekten", "insekt", "kerl" }),
  	"Insekten frisst der kleine Kerl fuer sein Leben gern.");
  
  AddDetail( ({ "wollknaeuel", "knaeuel" }),
	"Er sieht wie ein lebendiges Wollknaeuel aus. Echt niedlich!");
  
  AddDetail( ({ "fell" }),
  	"Das Fell ist ein bisschen sandig."); 
  
  AddDetail( ({ "naeschen", "nase" }),
	"Hin und wieder reckt er sein Naeschen neugierig nach oben.");

  create_default_npc(9+random(2));
  SetProp(P_HANDS, ({" mit einem lauten Pfiff",
                   QueryProp(P_HANDS)[1],DT_SOUND}));

  SetProp(P_RACE, "Erdhoernchen");
  SetProp(P_SIZE, 45+random(10));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
 
    ([DT_FIRE:       0.2, DT_COLD:       0.2, DT_WATER: -0.2, DT_AIR:    0.5,
      DT_LIGHTNING:  0.1, DT_EXPLOSION:  0.5, DT_SOUND: -1.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "rennt flott");  
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES);  
  SetProp(P_MNPC_AREA, ( ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 18, 30, 60 })); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-c1");
  SetProp(P_DIE_MSG,  " bleibt tot liegen.\n");

  AddInfo(DEFAULT_INFO, "kann doch nicht sprechen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Klippschliefer kann @WEN sicher nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(1,150,
    "Der Klippschliefer verbeisst sich in Deinem Fuss.\n",
    "Der Klippschliefer verbeisst sich in @WESSEN Fuss.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,100,
    "Der Klippschliefer versucht Dich mit einem Pfiff zu erschrecken.\n",
    "Der Klippschliefer versucht @WEN mit einem Pfiff zu erschrecken.\n",
     ({ DT_SOUND,DT_TERROR }),([SP_SHOW_DAMAGE:1]));
     
  SetChats(1, ({
    "Der Klippschliefer sonnt sich auf einem Stein.\n",
    "Der Klippschliefer kauert sich zusammen.\n",   
    "Der Klippschliefer reckt sein Naeschen in die Hoehe.\n",
    "Der Klippschliefer putzt sich den Sand aus dem Fell.\n",   
    "Der Klippschliefer gaehnt und macht es sich bequem.\n",    
    "Der Klippschliefer beginnt im sandigen Boden zu graben.\n" }) );
}

