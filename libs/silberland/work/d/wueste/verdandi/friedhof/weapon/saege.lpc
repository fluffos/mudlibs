#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>



create() {

  if (!is_clone(TO) )  return;

  ::create();



  SetProp(P_SHORT, "Eine Knochensaege");

  SetProp(P_LONG,
		"Ihren Namen hat die Knochensaege wohl daher, da sie sich muehelos durch alle "
		"Knochen saegen kann. Elfenbeinjaeger verwenden diese Waffen oft, um die "
		"Stosszaehne von erlegten Elefanten abzusaegen. Auf dem hoelzernen Griff "
		"sitzt eine blitzblanke Klinge mit 2539273 gefaehrlichen Zaehnen. Gezaehlt "
		"hast Du sie zwar nicht, aber Du bist Dir sicher, dass es mindestens so viele "
		"sind." );

  SetProp(P_NAME, "Knochensaege");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"knochensaege", "saege"}) );
  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 110);
  SetProp(P_DAM_TYPE, DT_RIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ MAT_ASH_WOOD: 10, MAT_CHROMIUM: 90 ]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp(P_WC_FIXFACTOR, 0.6 );

  
  SetProp(P_WC_BONUS, (["elfenbeinjaeger": 50]) );

}

