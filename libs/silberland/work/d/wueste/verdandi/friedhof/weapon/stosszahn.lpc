
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

int gotjaeger;

create() {
  if (!is_clone(TO) )  return;
  ::create();

  gotjaeger=0;

  SetProp(P_SHORT, "Ein grosser Stosszahn");
  SetProp(P_LONG,
    "Dieser Stosszahn gehoerte einmal einem Elefanten aus der Wueste. Er ist "
    "leicht abgenutzt und sicher eine Menge wert." );
  SetProp(P_NAME, "Stosszahn");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosser","grossen" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"stosszahn", "zahn"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 95);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IVORY );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_WC_FIXFACTOR, 0.3 );
  
  SetProp(P_WC_BONUS, (["elefant": 105]) );
}

varargs int move(mixed dest, int method) {
  object ob;
  
  if(gotjaeger==0) {
    if(TP && TI && TP==TI && query_once_interactive(TP)) { 
      if(MENV && !living(MENV)) {
        if(strstr(file_name(MENV),"/d/wueste/verdandi/friedhof/room/room") != -1) {
          gotjaeger=1;
          ob=clone_object( NPC "jaeger" );
          if(ob) {
            tell_object(TP,BS(
              "Als Du Dich nach dem Stosszahn bueckst, siehst Du hinter Dir "
              "einen grossen Schatten auftauchen. Ein Elfenbeinjaeger kommt "
              "hereingestuerzt und versucht Dir Deine Beute abzunehmen!"));
            tell_room(MENV,BS(
              "Auf einmal stuerzt ein Elfenbeinjaeger herein und greift "
              +TPN+" ohne zu zoegern an!"), ({ TP }) );
            ob->move(ENV(TP),M_GO | M_SILENT);
            ob->Kill(TP);
            TP->AddPursuer(ob);
          }
        }
      }
    }
  }
  return ::move(dest, method);
}

