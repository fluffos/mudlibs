#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();
  
  SetProp(P_SHORT, "Ein Schakalschwanz");
  SetProp(P_LONG,
		"" );

  SetProp(P_NAME, "Schakalschwanz");
  SetProp(P_GENDER, MALE);
  AddId( ({"schakalschwanz", "schwanz"}) );
  
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 77);
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ MAT_FLESH: 10, MAT_PELT: 90 ]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 250);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp(P_WC_FIXFACTOR, 0.6 );

}

