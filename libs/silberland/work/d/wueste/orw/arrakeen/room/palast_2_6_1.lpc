#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit MOST "std_room";

int pflanzencounter;

void create()
{
  ::create();

  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN: TT_PLAIN]));

  SetProp(P_INT_SHORT, "In den herzoeglichen Gaerten");
  SetProp(P_INT_LONG, 
	  BS("Du stehst nordwestlich vom Eingang des herzoeglichen Palastes "+
	     "zu Arrakeen mitten in einem wunderschoenen Garten, der in "+
	     "dieser Ecke besonders von einem schoen gepflegten Beet "+
	     "beherrscht wird. Neben dem Beet steht ein kleiner Strauch, "+
	     "dessen Zweige mit exotischen Blueten bedeckt sind."));

  AddDetail(({"palast"}),
	    "Hier residiert der Herzog von Arrakeen, Herrscher ueber die Wueste. "+
	    "Die Leute hier in der Stadt sprechen viel ueber seine Weisheit.");
  AddDetail(({"arrakeen", "stadt"}),
	    "Arrakeen heisst die Stadt, in der Du Dich befindest.");
  AddDetail(({"einwohner", "leute"}),
	    "Die Einwohner von Arrakeen sind eigentlich gut auf ihren Herrscher zu "+
	    "sprechen.");
  AddDetail(({"herrscher"}),
	    "Als Herrscher kann man den Herzog von Arrakeen eigentlich nicht "+
	    "bezeichnen. Er behandelt seine Untergebenen gerecht und spart auch "+
	    "nicht mit Wasser.");
  AddDetail(({"wasser"}),
	    "Wasser scheint hier in der Wueste eine besondere Rolle zu spielen. "+
	    "Was angesichts der hier herrschenden Temperaturen auch nicht weiter "+
	    "verwunderlich ist.");
  AddDetail(({"temperatur", "temperaturen"}),
	    "Eigentlich faellt die Temperatur hier selten unter 40 Grad.");
  AddDetail(({"grad"}),
	    "Das ist wohl nicht so wichtig.");
  AddDetail(({"wueste"}),
	    "Du hast jetzt schon soviele Dinge ueber die Wueste gehoert, dass es "+
	    "Dich ueberall juckt, diese selbst auch einmal zu erkunden.");
  AddDetail(({"ding", "dinge"}),
	    "Das musst Du schon selbst herausfinden.");
  AddDetail(({"garten"}),
	    "Der Garten ist wirklich hervorragend gepflegt. Ueberall wachsen "+
	    "gruene Buesche und Palmen aus dem gut durchfeuchteten Boden. Du "+
	    "fuehlst Dich wie in einer Oase.");
  AddDetail(({"boden"}),
	    "Komisch, wie feucht der Boden ist. Eigentlich muesste er genau so "+
	    "trocken sein, wie der Rest in Arrakeen.");
  AddDetail(({"rest"}),
	    "Der Rest von Arrakeen ist total ausgetrocknet.");
  AddDetail(({"buesche"}),
	    "Du kannst sie nicht weiter identifizieren, willst es auch gar nicht. "+
	    "Die Buesche wirken einfach nur beruhigend auf Dich.");
  AddDetail(({"gefuehl", "ruhe"}),
	    "Ein Gefuehl von innerer Ruhe macht sich in Deinem gestressten Herzen "+
	    "breit. Wenn es hier nicht so heiss waere, wuerdest Du hier gerne etwas "+
	    "ausruhen.");
  AddDetail(({"herz", "herzen"}),
	    "Huch, eine Zeit lang hattest Du das Gefuehl, es irgendwo "+
	    "liegengelassen zu haben. Aber da schlaegt es wieder im gewohnten "+
	    "Rhythmus.");
  AddDetail(({"rhythmus", "zeit"}),
	    "Das ist hier wirklich nicht wichtig.");
  AddDetail(({"herzog"}),
	    "Vielleicht ergibt sich ja mal die Gelegenheit, dass Du diesen weisen "+
	    "Herrscher kennenlernst.");
  AddDetail(({"gelegenheit", "gelegenheiten"}),
	    "Gelegenheiten ergeben sich immer wieder.");
  AddDetail(({"oase"}),
	    "Anders kann man diesen Park nicht beschreiben. Du fuehlst Dich hier "+
	    "sehr wohl und geborgen.");
  AddDetail(({"park"}),
	    "Eigentlich ist es nur der zum Palast gehoerende Garten, aber es kommt "+
	    "Dir vor wie ein grosser Park.");
  AddDetail(({"palme", "palmen"}),
	    "Die Palmen, die hier wachsen, stehen gerade in voller Bluete. Ein "+
	    "wunderschoener Anblick.");
  AddDetail(({"bluete"}),
	    "Die Palmen bluehen in verschiedenen Farben.");
  AddDetail(({"farbe", "farben"}),
	    "Du siehst rot, rosa und violett.");
  AddDetail(({"anblick"}),
	    "Diesen Anblick kannst Du gewiss nicht mehr vergessen.");
  AddDetail(({"pflanze", "pflanzen"}),
	    "Die Pflanzen hier wirken sehr beruhigend auf Dich.");
  AddDetail(({"untergebene", "untergebenen"}),
	    "Untergebene ist ein eher selten gebrauchter Ausdruck hier.");
  AddDetail(({"ausdruck"}),
	    "Das ist wirklich unwichtig.");
  AddDetail(({"weisheit"}),
	    "Die Weisheit des Herzogs ist beruehmt im ganzen Land.");
  AddDetail(({"land", "silberland"}),
	    "Das Land ist natuerlich das Silberland, aber das weisst Du ja "+
	    "sowieso.");
  AddDetail(({"beet"}),
	    "Verschiedene Gemuese und Fruechte werden hier angebaut..");
  AddDetail(({"gemuese"}),
	    "Du erkennst keine Dir bekannten Sorten.");
  AddDetail(({"sorten"}),
	    "Du kennst keine der hier angebauten Sorten, was aber nicht weiter "+
	    "verwunderlich ist, da hier ja auf die Temperatur Ruecksicht genommen "+
	    "werden muss. Hier gedeiht sicher nicht alles.");
  AddDetail(({"ecke"}),
	    "Das ist doch nicht so wichtig.");
  AddDetail(({"eingang"}),
	    "Der Eingang zum Palast liegt suedoestlich von Dir.");
  AddDetail(({"frucht", "fruechte"}),
	    "So sehr Du Dich auch anstrengst, Du kannst nichts naeher "+
	    "identifizieren.");
  AddDetail(({"rolle"}),
	    "Wasser scheint hier eine grosse Rolle zu spielen.");
  AddDetail(({"ruecksicht"}),
	    "Der Gaertner muss hier wohl ziemlich Ruecksicht auf das Klima nehmen.");
  AddDetail(({"gaertner"}),
	    "Du koenntest ihn ja mal fragen, wenn Du ihn siehst.");
  AddDetail(({"klima"}),
	    "Einfach ist es sicherlich nicht, in diesem harten Klima Fruechte und "+
	    "Gemuese anzubauen.");

// Zusaetzliche Details von Orw 05.09.2001
  AddDetail( ({"strauch"}),
    "Der Strauch steht gleich neben dem Beet und streckt seine bluehenden "
    "Zweige in die Sonne.");
  AddDetail( ({"zweige"}),
    "Die Zweige des Strauchs sind mit vielen kleinen exotischen Blueten und "
    "gruenen Blaettern uebersaet.");
  AddDetail( ({"blueten"}),
    "Die Blueten leuchten in allen Farben.");
  AddDetail( ({"blaetter"}),
    "Auf den Blaettern befinden sich kleine Wassertropfen, die lustig in der "
    "Sonne glitzern.");
  AddDetail( ({"wassertropfen","tropfen"}),
    "Anscheinend hat der Gaertner, den Strauch vor kurzem gegossen. Die "
    "Wassertropfen auf den Blaettern brechen die Sonnenstrahlen und "
    "verleihen dem Strauch ein mystisches Glitzern.");
  AddDetail( ({"sonnenstrahlen","strahlen"}),
    "Du folgst mit deinem Blick einem Sonnenstrahl bis zu den Wurzeln "
    "des Strauchs, die ziemlich interessant aussehen.");
  AddDetail( ({"wurzeln","wurzel"}),
    "Als Du die Wurzeln genauer untersuchst faellt Dir eine kleine "
    "vertrocknete Pflanze auf die sich um eine der Wurzeln windet.");
  AddDetail( ({"pflanze"}),
    "Koennte Unkraut sein!");
  AddDetail( ({"unkraut"}),
    "Hilf doch dem alten Gaertner und reiss das Unkraut aus. "
    "Aber sei vorsichtig, die Pflanze hat viele Dornen.");
  AddDetail( ({"sonne"}),
    "Die Sonne brennt erbarmungslos vom Himmel.");
  AddDetail( ({"himmel"}),
    "Strahlend blauer Himmel, kein Woelkchen ist zu sehen.");
  AddDetail( ({"woelkchen","wolke","wolken"}),
    "Nicht ein einziges Woelkchen kannst Du am Himmel finden.");
  AddDetail( ({"glitzer","glitzern"}),
    "Der Strauch glitzert wunderschoen. Fasziniert betrachtest Du ihn.");
  AddDetail( ({"blick"}),
    "Dein Blick folgt einem Sonnenstrahl.");
  AddDetail( ({"dornen"}),
    "Extrem viele Dornen!");

  AddCmd(({"reisse","reiss"}),"fkt_ausreissen");
    pflanzencounter=1;

  set_light("hell");
  set_temp("warm");
  set_exits("palast");
}

// Funktion um die Nakrafulpflanze auszureissen (Orw 05.09.2001)
int fkt_ausreissen(string str)
{
  object pflanze;
  notify_fail("Was moechtest Du ausreissen?\n");
  if(!str) return 0;
  if(str=="pflanze aus" ||
     str=="unkraut aus")
  {
    if(pflanzencounter)
    {
      write(BS("Da die Pflanze soviele Dornen hat, solltest Du "
               "versuchen sie vorsichtig auszureissen."));
      say(BS(TPN+" bueckt sich um etwas aus zureissen, steht dann aber "
             "enttaeuscht wieder auf."));
      return 1;
    }
    else
    {
      write(BS("Die Pflanze ist zu klein, Du erwischst sie nicht. Schau "
               "doch spaeter nochmal vorbei."));
      say(BS(TPN+" bueckt sich um etwas auszureissen, steht dann aber "
             "enttaeuscht wieder auf."));
      return 1;
    }
  }
  if(str=="pflanze vorsichtig aus" ||
     str=="unkraut vorsichtig aus")
  {
    if(pflanzencounter)
    {
      pflanze = clone_object("/d/huegelland/orw/pfeifenladen/obj/nakrafulpflanze");
      pflanze->move(this_player(),M_GET|M_SILENT);
      write(BS("Vorsichtig reisst Du die Pflanze aus, ohne Dich an den Dornen "
               "zu verletzen.\n"));
      say(BS(TP->Name()+
        " reisst etwas Unkraut aus.\n"),this_player());
      pflanzencounter--;
      return 1;
    }
    else
    {
      write(BS("Die Pflanze ist zu klein, Du erwischst sie nicht. Schau "
               "doch spaeter nochmal vorbei."));
      say(BS(TPN+" bueckt sich um etwas aus zureissen, steht dann aber "
             "enttaeuscht wieder auf."));
      return 1;
    }
  }
  return 0;
}

reset()
{
  ::reset();
  pflanzencounter=1;  
}