#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include <mnpc.h>

inherit MOST "mymnpc";

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  create_default_mensch(10, MALE);

  SetProp(P_SHORT, "Ein alter Gaertner");
  SetProp(P_LONG, 
	  BS("Der alte Gaertner scheint schon lange Zeit zu arbeiten, "+
	     "trotzdem merkt man ihm seine Muedigkeit nicht an. "+
	     "Sein Gesicht ist ausgemergelt und seine Haut zeigt "+
	     "Spuren der anhaltenden Hitze.\n"));
  SetProp(P_NAME, "Gaertner");
  SetProp(P_NAME_ADJ, "alt");

  AddId("gaertner");
  SetProp(P_MSGIN, "kommt auf der Suche nach Arbeit herein");
  SetProp(P_ALIGN, 100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  
  SUID;
  CLONEME(PROWEAPON "gartenschere");
  command("zuecke gartenschere");

  SetProp(P_REJECT, ({REJECT_KEEP,
    "Der Gaertner bedankt sich und widmet sich wieder seiner Arbeit.\n"}));

  SetProp(P_LOG_INFO, "protheg/arrakeen");

  AddInfo(DEFAULT_INFO, 
	  "Lass mich weiterarbeiten, davon weiss ich nichts.\n", 
	  "sagt: ");

  SetProp(P_MNPC_AREA, ROOM "palast");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "palast_3_5_1");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_OUTDOORS+MOV_MOVES);

}




