inherit "std/thing";

#include <properties.h>
#include <moving.h>

string messages, new_hd, new_body, save_file, alias;
int num_messages;
object who;
int max_messages;

long() {
    write("Du kannst eine weitere Notiz anbringen mit 'notiere <Titel>'.\n");
    write("Oder eine Notiz lesen mit 'lies <Nummer>'. Oder mit\n");
    write("'loesche <nummer>' eine entfernen.\n");
    if (num_messages == 0) {
	return("Keine Nachrichten.\n");
    }
    write("Das Wuestenbrett enthaelt " + num_messages);
    if (num_messages == 1)
	write(" Nachricht:\n\n");
    else
	write(" Nachrichten:\n\n");
    say(capitalize(this_player()->query_real_name()) +
	  " studiert das Wuestenbrett.\n");
    headers();
    return"\n";
}

create() {
	::create();
	SetProp(P_SHORT,"Das Wuestenbrett");
	SetProp(P_NOGET,1);
	SetProp(P_NAME,"Wuestenbrett");
	SetProp(P_GENDER,0);
	AddId("brett");
	AddId("schwarzes brett");
	AddId("Wuestenbrett");
	AddId("wuestenbrett");
    	save_file="/d/wueste/muaddib/brett";
    	restore_object(save_file);
	seteuid(getuid(this_object()));
	AddCmd(({"notiere"}),"new");
	AddCmd(({"lies","lese"}),"read");
	AddCmd(({"loesche","loesch","entferne"}),"remove");
}

headers() {
    string hd, body, rest;
    int i, tmp;

    i = 1;
    rest = messages;
    while(rest != 0 && rest != "") {
	tmp = sscanf(rest, "%s:\n**\n%s\n**\n%s", hd, body, rest);
	if (tmp != 2 && tmp != 3) {
	    write("Korrupt.\n");
	    return;
	}
	write(i + ":\t" + hd + "\n");
	i += 1;
    }
}

new(hd) {
    hd=this_player()->_unparsed_args();
    if (!hd)
	return 0;
    if (who && environment(who) == environment(this_object())) {
	write("Warte auf "+capitalize(who->query_real_name()) + " !\n");
	return 1;
    }
    if (num_messages == 40) {
	write("Das Brett ist randvoll. Nimm erstmal ne Notiz ab.\n");
	return 1;
    }
    if (strlen(hd) > 50) {
	write("Zu lange Kopfzeile, um auf das Papier zu passen.\n");
	return 1;
    }
    new_hd = hd;
    input_to("get_body");
    write("Bitte Notiz eingeben und '**' beenden.\n");
    write("]");
    new_body = "";
    return 1;
}

get_body(str) {
	string tag,datum,zeit,tzeit,z1,z2,z3;
    if (str == "**") {
	tzeit=dtime(time());
	sscanf(tzeit,"%s, %s, %s",tag,datum,zeit);
	sscanf(zeit,"%s:%s:%s",z1,z2,z3);
	new_hd = new_hd + " (" + capitalize(this_player()->query_real_name()) + ", " +z1+":"+z2+", "+datum+ ")";
        say(capitalize(this_player()->query_real_name())+" schreibt die Notiz '"+new_hd+"'.\n");
	messages = messages + new_hd + ":\n**\n" + new_body + "\n**\n";
	num_messages += 1;
	new_body = 0;
	new_hd = 0;
	save_object(save_file);
	write("Ok.\n");
	who = 0;
	return;
    }
    new_body = new_body + str + "\n";
    write("]");
    input_to("get_body");
}

read(str) {
    string hd, body, rest;
    int i, tmp;

    if (str == 0 || (sscanf(str, "%d", i) != 1 &&
		     sscanf(str, "note %d", i) != 1))
	return 0;
    if (i < 1 || i > num_messages) {
	write("So viele Notizen sind nicht auf dem Brett.\n");
	return 1;
    }
    rest = messages;
    while(rest != 0 && rest != "") {
	i -= 1;
	tmp = sscanf(rest, "%s:\n**\n%s\n**\n%s", hd, body, rest);
	if (tmp != 2 && tmp != 3) {
	    write("Korrupt.\n");
	    return;
	}
	if (i == 0) {
	    say(capitalize(this_player()->query_real_name()) +
		  " liest die Notiz '" + hd + "'.\n");
	    write("Die Notiz heisst: '" + hd + "':\n\n");
	    write(body);
	    return 1;
	}
    }
    write("Hm. Das sollte nicht passieren..\n");
}

remove(str) {
    string hd, body, rest;
    int i, tmp;

    if (str == 0 || (sscanf(str, "%d", i) != 1 &&
		     sscanf(str, "note %d", i) != 1))
	return 0;
    if (i < 1 || i > num_messages) {
	write("Es gibt nicht so viele Notizen.\n");
	return 1;
    }
    rest = messages;
    messages = "";
    while(rest != 0 && rest != "") {
	i -= 1;
	tmp = sscanf(rest, "%s:\n**\n%s\n**\n%s", hd, body, rest);
	if (tmp != 2 && tmp != 3) {
	    write("Korrupt.\n");
	    return;
	}
	if (i == 0) {
	    say(capitalize(this_player()->query_real_name()) +
		  " entfernt die Notiz '" + hd + "'.\n");
	    write("Ok.\n");
	    messages = messages + rest;
	    num_messages -= 1;
	    save_object(save_file);
	    return 1;
	}
	messages = messages + hd + ":\n**\n" + body + "\n**\n";
    }
    write("Hm. Das sollte nicht passieren.\n");
}

