#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/palast/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));
  SetProp (P_INT_SHORT, "In einem Wachraum");
  SetProp (P_INT_LONG,
    "Du stehst in einem penibel aufgeraeumten Raum, der wohl als "+
    "Aufenthaltsraum fuer die Palastwache dient. Ausser einem Schrank, "+
    "einem Tisch und ein paar Stuehlen siehst Du nichts auffaelliges an "+
    "diesem Raum.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./entrance");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
