#include <properties.h>
#include <moving.h>
#include "../def.h"

#pragma strict;

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/palast/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));
  SetProp (P_INT_SHORT, "Die Eingangshalle des Palastes");
  SetProp (P_INT_LONG,
    "Du stehst in einer weitlaeufigen Halle, die ueberall mit Mamor und "+
    "edlen Stoffen ausgeschmueckt ist. Direkt vor Dir fuehrt eine Treppe "+
    "nach oben. Zu Deiner Rechten siehst Du eine kleine, aber stabile "+
    "Holztuer, an der ein Schild haengt. Der Boden ist mit einem roten "+
    "Teppich ausgelegt, der die ganze Treppe nach oben fuehrt. Der Raum "+
    "ist mittels eines riesigen Luesters beleuchtet, der von der sehr "+
    "hohen Decke haengt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"schild"}),
    "Vielleicht kannst Du es lesen?");
  AddReadDetail ( ({"schild"}),
    "PALASTGARDE");
  AddDetail ( ({"mamor", "stoff", "stoffe"}),
    "Der Mamor ist mit gruenlichen Aederchen durchzogen und der Stoff "+
    "scheint schwerer gruener Samt zu sein. Im ganzen ergibt sich ein Bild "+
    "von unerschoepflichem Reichtum.");
  AddDetail ( ({"halle"}),
    "Die Halle ist riesig. Du wunderst Dich, da man das dem Palast von "+
    "aussen gar nicht ansieht. Da muss ein guter Bauherr am Werk gewesen "+
    "sein.");
  AddDetail ( ({"bauherr"}),
    "Man munkelt hier, dass ein maechtiger Magier beim Bau des Palastes "+
    "mitgeholfen haben soll.");
  AddDetail ( ({"magier", "name"}),
    "Der Name des Magiers ist unbekannt, nur scheint er ein guter "+
    "Bekannter des Herzogs zu sein.");
  AddDetail ( ({"adern", "aederchen"}),
    "Die gruenen Adern im Mamor geben der Halle einen edlen Touch.");
  AddDetail ( ({"palast"}),
    "Du stehst mitten im Palast des Herzogs der Wueste.");
  AddDetail ( ({"gebiet"}),
    "Das ist doch nicht so wichtig, oder?");
  AddDetail ( ({"holztuer", "tuer"}),
    "Du klopfst gegen die Tuer und tust Dir am Finger weh. Definitiv Holz "+
    "und definitiv stabil.");
  AddDetail ( ({"teppich"}),
    "Der rote Teppich macht einen guten Eindruck und sieht so sauber aus, "+
    "dass Du eigentlich keine Lust hast, darauf zu treten.");
  AddDetail ( ({"lust"}),
    "Das ist nicht so wichtig.");
  AddDetail ( ({"touch"}),
    "Das kannst Du nicht wirklich erfassen.");
  AddDetail ( ({"wand"}),
    "An einer Wand haengt ein riesiges Gemaelde von laengst vergangenen "+
    "Tagen.");
  AddDetail ( ({"tage", "tagen"}),
    "Das ist sicher schon lang rum... hoffst Du.");
  AddDetail ( ({"bild", "gemaelde"}),
    "Das Gemaelde scheint eine Episode aus der Zeit der Wuestenkriege zu "+
    "erzaehlen. Du siehst soviele Grausamkeiten, dass es Dir kalt den "+
    "Ruecken runterlaeuft.");
  AddDetail ( ({"grausamkeit", "grausamkeiten"}),
    "Blut scheint eins der Hauptmerkmale des Bildes zu sein. Du wunderst "+
    "Dich, warum man wohl ein solches Gemaelde in einer Eingangshalle "+
    "aufhaengen wuerde.");
  AddDetail ( ({"herzog"}),
    "Der Herzog regiert die Wueste mit gnaediger Hand.");
  AddDetail ( ({"hand"}),
    "Ob Du die jemals anfassen darfst?");
  AddDetail ( ({"wueste"}),
    "Die Wueste ist ein gaenzlich unerforschtes Gebiet.");
  AddDetail ( ({"aufbau", "bau"}),
    "Irgendjemand muss einfach beim Aufbau des Palastes geholfen haben.");
  AddDetail ( ({"bekannter"}),
    "Wenn es kein Bekannter gewesen waere, dann haette es sich der Herzog "+
    "sich nicht leisten koennen, einen solchen Palast zu bauen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "/d/wueste/muaddib/arrakeen/room/room_d7");
  AddExit ("sueden", "./wachraum");
  AddSpecialExit ("oben", "geh_oben");
  // EXITS END

  // ITEMS START
  // ITEMS END

  
}
  int geh_oben()
  {
    write ("Jemand haelt Dich davon ab, nach oben zu gehen.\n");
    say ("Jemand haelt "+TP->name(WEN,2)+" davon ab, nach oben zu gehen.\n");
    return 1;
  }
