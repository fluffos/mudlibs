inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

#pragma strict_types

void create() {
	if (!is_clone(this_object()))
		return;
	::create();

  AddId("kanister", "behaelter", "\nmuaddib_kanister");
	SetProp(P_SHORT, "Ein grosser Kanister");
	SetProp(P_LONG, BS("Du siehst einen grossen Kanister, der aus einem "+
      "durchsichtigen Stoff besteht. Vielleicht kann man den ja mal "+
      "brauchen.\n"));
  SetProp(P_MATERIAL, ([MAT_GLASS:15, MAT_PLASTIC:5, MAT_MISC_PLANT:50,
      MAT_MISC_MAGIC:30])); 
  SetProp(P_VALUE, 200);
  SetProp(P_NOSELL, 1);
  SetProp(P_WEIGHT, 500);

  SetProp(P_INFO, BS("Du siehst eine kleine Marke am oberen Rand des "+
      "Kanisters, an der \"9 Liter\" steht.\n"));
  AddAdjective(({"gross","grosser","grossen"}));
  SetProp(P_NAME, "Kanister");


  }
  
