#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/opendesert/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_DESERT,ENV_TEMPERATURE:50]));
  SetProp (P_INT_SHORT, "In der offenen Wueste");
  SetProp (P_INT_LONG,
    "Du stehst in der offenen Wueste. Weit und breit ist nichts zu sehen. "+
    "Wie bist Du bloss hier hergekommen? Du kannst Dich nicht mehr an den "+
    "Weg zurueck erinnern. So wie es ausschaut, wirst Du wohl hier "+
    "sterben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END
  
  AddCmd ( ({"untersuche", "unt"}), "untersuchen");
}

void untersuchen(string str)
{
  string *answers;
  int len, i; 
  
  answers = ({ "Du wuerdest Dich gerne konzentrieren, aber das einzige, "+
      "woran Du dich erinnern kannst, ist der Schluck Wasser, den Du so "+
      "leichfertig in den Sand geschuettet hast.", "Ausser Sand siehst Du "+
      "gar nichts.", "Warum sollte Dich das in Deiner jetzigen Situation "+
      "interessieren?", "Du wirst eh bald sterben, also denk doch lieber "+
      "an etwas Angenehmes.", "Tja, wenn Du jetzt noch genug Lebenskraft "+
      "haettest, dann koenntest Du das sicher tun.", "In der Wueste hoert "+
      ""und hilft Dir niemand." });
  len = length(answers);
  
  write(BS(answers(random(len))));
  
}
