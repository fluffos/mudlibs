#pragma strong types;

#define MASTER "/d/wueste/muaddib/event_master.lpc"

mapping events; // Mapping von Event:Filename

void init()
{
  restore_object(MASTER);
}

void create()
{
  if (is_clone(this_object()))
    return;
}

void new_event(string Event, string file)
{
  events += ([ Event:file ]);
  save_object(MASTER);
}

int remove_event(string Event)
{
  if (!member(events, Event))
    return 0;
  events -= ([ Event ]);
  return 1;
  save_object(MASTER);
}

void dummy() // dummy-funktion, damit simuliere ich eine delayfunktion
{
}

int start_event(string Event, object env) 
//env ist der Raum, wo der Event stattfindet
{
  int i;
  string out;

  i = 0;
  while (1)
    {
      out = read_file(events[Event], 0, i);
      if (out == EOF)
	break;
      tell_room(env, out);
      call_out("dummy", 1);
      i++;
    }  
}





