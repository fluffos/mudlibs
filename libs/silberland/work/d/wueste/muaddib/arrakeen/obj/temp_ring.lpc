/*
**
** Magischer Ring, der einen negativen Temperaturoffset hat
** gefaehrlich halt in kuehlen Gegenden, aber *zuck* ich schreibs in
** die ID :)
**
** by Muaddib@SL
**
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object()))
    return;
  
  ::create();

  SetProp(P_SHORT, "Ein leuchtender Ring");
  SetProp(P_LONG, "Ein seltsam blaeulich leuchtender Ring.\n");
  SetProp(P_INFO, BS("Dieser Ring ist ein Hitzeschutzring. Seine magische "+
		     "Energie wird Dich nicht im Stich lassen, aber sei "+
		     "vor Umkehrerscheinungen gewarnt.\n"));
  AddId( "ring" );

  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_DIAMOND:5,MAT_ASBESTOS:20,MAT_MAGIC:70]));
  SetProp(P_TEMPERATURE_PROTECTION, -10);
  SetProp(P_NAME, "Ring");
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 700);

}

