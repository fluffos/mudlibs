// /p/service/mupfel/zettel/zettelmaschine.c Eine Zettelmaschine
// Entstanden aus /p/service/loco/obj/buchautomat.c
// 23-04-95  - Mupfel@AnderLand -

inherit "/std/thing";

#include <properties.h>
#include <moving.h>

#define ZETTEL "/d/wueste/muaddib/arrakeen/obj/tagesordnung.lpc"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Tagesordnung");
  SetProp(P_LONG, "Eine Tagesordnung.\n");
  SetProp(P_NAME, "Tagesordnung");
  AddId(({"tagesordnung", "agenda", "obj$zettel$maschine"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOGET, "");
  SetProp(P_MATERIAL,MAT_PAPER);
}

move(target, method, mess)
{
  if ((method & M_GET) && living(target))
    return get(target), ME_CANT_BE_TAKEN;
  else
    return ::move(target,method,mess);
}

get(targ)
{
  if (!targ || !interactive(targ) || targ != this_player())
    return 0;
  if (present("obj$zettel",this_player()))
  {
    write("Du benoetigst nur eine Tagesordnung.\n");
    return ME_CANT_BE_TAKEN;
  }
  clone_object(ZETTEL)->move(targ,M_GET);
  write("Du nimmst eine Tagesordnung. "
      "Sofort erscheint auf unerklaerliche Weise eine neue.\n");
  say(targ->Name(WER,1) + " nimmt eine Tagesordnung.\n", targ);
  return 1;
}






