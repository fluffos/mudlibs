/*
**
** Ein Saeckchen mit Sand
**
** by Muaddib@SilberLand
**
*/

inherit "std/thing";

#include <language.h>
#include <properties.h>
#include "../def.h"

nosave string *mitarbeiter;
nosave string *erzies;

create()
{
  int i;
  string *tmp;

  mitarbeiter=({});
  erzies=({});
  erzies += ({"feyaria", "angrox", "eros", "dusty", "woody"});
  tmp=get_dir("/d/wueste/*");
  for (i=sizeof(tmp)-1; i; i--)
    if (file_size("/d/wueste/"+tmp[i])==-2 && tmp[i][0]!='.')
      mitarbeiter+=({ tmp[i] });
  if (!is_clone(this_object())) return;
  if (!member(mitarbeiter, getuid(this_player())) ||
      !member(erzies, getuid(this_player())))
    {
      write("Das Saeckchen loest sich auf.\n");
      ME->remove();
      return;
    }
  ::create();
  
  AddId( ({"saeckchen","sandsaeckchen","sack"}) );
  SetProp(P_SHORT, "Ein Saeckchen mit Sand");
  SetProp(P_LONG, BS("Du siehst ein kleines Saeckchen, das anscheinend mit "+
		     "Sand gefuellt ist. Ganz gross prangt das Symbol der "+
		     "Wueste auf dem Saeckchen. Mit <sackhilfe> kannst Du "+
		     "mehr ueber die Funktion herausfinden.\n"));
  AddCmd("sackhilfe", "s_help");
  AddCmd("rwrufe", "rw_rufe");

}


void s_help()
{
 write("Zur Zeit sind folgende Funktionen implementiert:\n"+
       "<rwrufe>...............ruft allen Mitarbeitern der Region etwas zu\n");

}

int rw_rufe(string str)
{
 int i;
 notify_fail("Was moechtest Du denn den Wuestlenmagiern mitteilen?\n");
 if (!stringp(str)) return 0;
 for(i=sizeof(mitarbeiter)-1;i>=0; i--)
   {    
     if(mitarbeiter[i]==getuid(TP))
              write(break_string(TP->_unparsed_args(), 78, 
                              "Du teilst den Wuestenmagiern mit: "));
         else 
          tell_object(mitarbeiter[i], break_string(TP->_unparsed_args(),
                78, "Wuestenmagier "+CAP(getuid(TP))+ " teilt Dir mit: "));
       }      
   }
 return 1;
}
  
