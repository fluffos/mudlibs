#include <properties.h>
#include <language.h>
#include "../def.h"
#include <wizlevels.h>

inherit "std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  if (!IS_WIZARD(this_player())) 
    {    
      write("Das Papier verbrennt in Deiner Hand.\n");
      say("Das Papier verbrennt in "+TP->name(WESSEN, 2)+" Hand.\n");
      ME->remove();
      return;
    }
  AddId( ({"tagesordnung","ordnung", "agenda"}) );
  SetProp(P_SHORT, "Eine Tagesordnung");
  SetProp(P_LONG, BS("Ein Zettel, auf dem die Tagesordnung der heutigen "+
		     "Besprechung der Region Wueste gedruckt ist.\n"));
  SetProp(P_NAME, "Tagesordnung");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);

  AddReadDetail("tagesordnung", 
		" TAGESORDNUNG DER BESPRECHUNG DER REGION WUESTE \n"+
		"             vom 16.12.1997                     \n"+
		"                                                \n"+
		"------------------------------------------------\n"+
		"1. Begruessung                                  \n"+
		"2. aktuelle Frage: Namenswahl etc.              \n"+
		"3. allfaellige Fragen zur Region                \n"+
		"4. technische Probleme                          \n"+
		"5. Status der Gebiet                            \n"+
		"6. Besprechung der Themen der anderen Magier    \n"+
		"------------------------------------------------\n");
}


