flauschen(string spieler)
{
  finde(spieler);
  if (flag==0) return 0; if (flag==2) return 1;
  TOP(BS(
    ""+CTP(WESSEN)+" Wuestenspringmaus springt herein und flauscht "+
    "Dich"+ zusatz+". Sogleich ist sie wieder verschwunden."));
  write(BS(
    "Deine Wuestenspringmaus springt los und flauscht "+P(WEM)+""+
    ""+ zusatz+". Einen Moment spaeter ist sie wieder da."));
  return 1;
}

cmargln(string spieler)
{
  finde(spieler);
  if (flag==0) return 0; if (flag==2) return 1;
  TOP(BS(
    ""+CTP(WESSEN)+" Wuestenspringmaus springt herein und arglt "+
    "Dich"+ zusatz+" an. Sogleich ist sie wieder verschwunden."));
  write(BS(
    "Deine Wuestenspringmaus springt los und arglt "+P(WEM)+""+
    ""+ zusatz+" an. Einen Moment spaeter ist sie wieder da."));
  return 1;
}

wegwerfen(str)
{
  // macht Probleme mit anderen Objekten, die das gleiche Verb definieren
  // notify_fail("");
  // Marcel, Don, 30. Jan 1997, 14:50:27
  if(str=="wuestenspringmaus weg" || str=="springmaus weg")
  {
    write(BS(
"Bist Du Dir ganz sicher, dass Du die Wuestenspringmaus wegwerfen moechtest? "+
     "Wenn ja, so tippe: entlasse springmaus. Aber bedenke, dieser Schritt "+
"ist "+
     "nicht wieder gut zu machen. Die Wuestenspringmaus verlaesst Dich dann fuer immer "+
     "und ewig!\n"));
    return 1;
  }
  return 0;
}

entlassen(str)
{
  notify_fail("Wen moechtest Du entlassen?\n");
  if(str=="springmaus")
  {
    write(BS(
     "Du sagst Deine Springmaus, das sie verschwinden soll und von nun an "+
     "auf sich alleine gestellt ist. Deine Springmaus grummelt Dich mit Traenen "+
     "in den Augen an. Schliesslich verschwindet sie dann.\n"));
    remove();
    return 1;
  }
  return 0;
}








