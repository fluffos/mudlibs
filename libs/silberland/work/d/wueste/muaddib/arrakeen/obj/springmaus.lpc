#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../def.h"

inherit "/std/thing";

#define TOP(x) tell_object(player,"\n"+BS(x))
#define  CTP(x) capitalize(this_player()->name(x))
#define   P(x) player->name(x,1)

object player;
string empfaenger,zusatz;
int flag;

create ()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, capitalize(getuid(this_player()))+"s Wuestenspringmaus");

  SetProp(P_LONG,BS(
  "Oh, wie suess. Eine recht grosse Wuestenspringmaus aus der "+
  "silberlaendischen Wueste. "+
  "Wuestenspringmaeuse sind hochintelligente, schnelle und sehr flexible "+
  "Lebewesen. Das ist auch der Grund dafuer, dass die Wuestenspringmaeuse, "+
  "in der Sprache der Fremen uebrigens Muad'Dib genannt, zu den wenigen "+
  "Lebewesen gehoeren, die in der Wueste ueberleben koennen. "+
  "Die Maus schaut Dich aus schwarzen Augen an und Dir wird ganz "+
  "warm ums Herz. \n"+
 "Mit >whilfe< kannst Du sehen, was alles mit und durch sie moeglich ist.\n"));

  AddId(({"wuestenspringmaus","springmaus","maus"}));
  SetProp (P_NAME, "Wuestenspringmaus");
  /* SetProp (P_NAME_ADJ, "klein"); Maeuse sind eh klein :-) */
  SetProp (P_GENDER, MALE);
  SetProp (P_ARTICLE,1);
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp (P_WEIGHT, 8);
  SetProp (P_VALUE, 1);
  AddCmd("whilfe","springmaushilfe");
  AddCmd(({"wspreche","wsprech"}),"kommu");
  AddCmd(({"wrede","wred"}),"fern_kommu");
  AddCmd(({"wlaechel","wlaechle"}),"laechel");
  AddCmd(({"wknuddel","wknuddle"}),"knuddel");
  AddCmd(({"wschmoll","wschmolle"}),"schmollen");
  AddCmd(({"wtroest","wtroeste"}),"troeste");
  AddCmd(({"wumarm","wumarme"}),"umarme");
  AddCmd(({"wtret","wtrete"}),"trete");
  AddCmd(({"wwuschle","wwuschel"}),"wuschel");
  AddCmd(({"wmustere","wmuster"}),"muster");
  AddCmd(({"wdank","wdanke"}),"danke");
  AddCmd(({"wbewunder","wbewundere"}),"bewundere");
  AddCmd(({"wschau","wschaue"}),"schau");
  AddCmd(({"wtaetschel","wtaetschle"}),"taetschel");
  AddCmd(({"wkuschle","wkuschel"}),"kuschel");
  AddCmd(({"knuddel","knuddle"}),"cmknuddel");
  AddCmd(({"druecke","drueck"}),"cmdrueck");
  AddCmd(({"streichel","streichle"}),"cmstreichel");
  AddCmd(({"kraule","kraul"}),"cmkraule");
  AddCmd(({"herze","herz"}),"cmherze");
  AddCmd(({"wnick","wnicke"}), "nicken");
  AddCmd(({"wgrins","wgrinse"}), "grinsen");
  AddCmd(({"wweck","wwecke"}), "wecken");
  AddCmd(({"wfauch","wfauche"}), "fauchen");
  AddCmd(({"wgratulier","wgratuliere"}), "gratulieren");
  AddCmd(({"wleck","wlecke"}),"lecken");
  AddCmd(({"wwink","wwinke"}),"winken");
  AddCmd(({"werfe","wirf"}), "wegwerfen");
  AddCmd("entlasse","entlassen");
  AddCmd(({"wflausch","wflausche"}), "flauschen");
  /* soweit so gut... jetzt die meinigen Ergaenzungen: */

  /*  AddCmd(({"wbeiss","wbeisse"}),"beissen");
      AddCmd(({"werschreck","werschrecke"}),"erschrecken"); */
  AddCmd(({"wargl","wargle"}),"cmargln");
  /* etc. to be continued :) */
}

springmaushilfe()
{
  write(BS(
   "Du kannst die Wuestenspringmaus knuddeln, druecken, streicheln, "+
   "kraulen und herzen. Ausserdem kannst Du sie zu anderen Spielern "+
   "schicken und diese, durch die Wuestenspringmaus, anlaecheln, flauschen,"+
   "anschauen, ihnen gratulieren, ihnen zunicken, troesten, umarmen, "+
   "treten, taetscheln, ihre Haare verwuscheln, mustern, ihnen danken, "+
   "knuddeln, sie bewundern, sie angrinsen, ihnen zuwinken, sie anfauchen, "+
   "sie aufwecken, das Gesicht ablecken und Dich "+
   "bei ihnen ankuscheln.\n"+
   "Die entsprechenden Befehle sind - wlaechel(le), wschau(e), wtroest(e), "+
   "wumarm(e), wmuster(e), wknuddel(le), wtaetschel(le), wwuschel(le), "+
   "wtret(e), wdank(e), wnick(e), wbewunder(e), wschmoll(e), wkuschel(le), "+
   "wweck(e), wfauch(e), wleck(e), wgrins(e), wwink(e), wflausch(e) und "+
   "wgratulier(e) - "+
   "das erste Wort nach dem Befehl wird als Name des Spielers interpretiert, "+
   "alles Folgende wird gequoted.\n"+
   "Ebenfalls besteht die Moeglichkeit, dass Deine Springmaus fuer Dich eine "+
   "Nachricht an einen anderen Spieler ueberbringt oder im selben Raum fuer "+
   "Dich spricht.\n"+
   "Die Befehle dafuer lauten: wspreche <Text> oder wrede <Name> <Text>.\n"+
   "Diese Hilfe siehst Du mit >whilfe<.\n"+
   "Wenn Du Deine Springmaus nicht mehr magst und loswerden moechtest, so "+
   "wirf sie einfach weg.\n"));
  return 1;
}

finde(spieler)
{
   string *sentence;
   spieler=this_player()->_unparsed_args();
   notify_fail(
   "Deine Springmaus leckt Dir mit ihrer weichen Zunge das Gesicht ab und "+
   "meint dann: Da war wahr wohl was falsch, oder?\n");
   if(!spieler) {flag=0;return;}
   sentence=explode(spieler," ");
   empfaenger=sentence[0];
   zusatz=implode(sentence[1..sizeof(sentence)-1]," ");
   if (zusatz!="") zusatz=" "+zusatz+"";
   if (!player=find_player(lower_case(empfaenger)))
   {
      write(BS("Diesen Spieler kann deine Springmaus nicht finden."));
      flag=2;
      return 0;
   }
   if (player->QueryProp(P_IGNORE) !=0)
   {
     if (member(player->QueryProp(P_IGNORE),getuid(this_player()))!=-1)
     {
        write(BS(
          ""+P(WEM)+" scheint Deine Springmaus zu ignorieren.\n"));
        flag=2;
        return 0;
     }
   }
   if (player->QueryProp(P_INVIS) && (!IS_WIZARD(this_player())))
   {
      write(BS("Diesen Spieler kann dein Urdrache nicht finden."));
      flag=2;
      return 0;
   }
   flag=1;
}

kommu(string text)
{
   string spieler;
   text = this_player()->_unparsed_args();
   spieler = CTP(WEM);
   if (!text) return 0;
   write(BS(
     "Deine Wuestenspringmaus sagt: "+text));
   say(BS(
     ""+capitalize(getuid(this_player()))+"s Wuestenspringmaus sagt: "+text));
   return 1;
}

fern_kommu(string spieler)
{
 finde(spieler);
 if (flag==0) return 0; if(flag==2) return 1;
 write(BS(
   "Deine Springmaus wuselt zu "+P(WEM)+" und sagt: "+zusatz));
 TOP(BS(
   ""+capitalize(getuid(this_player()))+"s Wuestenspringmaus wuselt herein "+
   "und deutet Dir an, dass sie folgendes ausrichten soll: "+zusatz));
 return 1;
}

cmkraule (string was)
{
  notify_fail ("Wen moechtest Du kraulen?\n");
  if (was=="springmaus" || was=="wuestenspringmaus")
    {
      write (BS(
       "Du kraulst deine Wuestenspringmaus minutenlang das weiche "+
       "Fell. Der scheint das zu sehr gefallen. Sie gibt "+
       "ein beruhigendes fiepen von sich, schliesst die Augen und laesst "+
       "es sich so gefallen."));
      say (BS(this_player()->name(WER,2)+
       " krault eine Wuestenspringmaus minutenlang. "+
       "Der scheint das zu gefallen und sie fiept geniesserisch."));
    return 1;
    }
  return 0;
}

cmknuddel (string was)
{
  notify_fail ("Wen moechtest Du knuddeln?\n");
  if (was=="wuestenspringmaus" || was=="springmaus")
    {
      write (BS(
        "Du knuddelst Deine Wuestenspringmaus minutenlang. Alles, was "+
        "Dich belastet hat, scheint in weite Ferne zu ruecken, und "+
        "Du wuenschst Dir, dass dieser Augenblick nie voruebergehen "+
        "moege."));
      say (BS(this_player()->name(WER,2)+
        " knuddelt eine Wuestenspringmaus minutenlang. "+
       "Du wuenschst Dir, Du haettest auch so eine tolle Wuestenspringmaus."));
      return 1;
    }
  return 0;
}

cmdrueck (string was)
{
  notify_fail ("Wen moechtest Du druecken?\n");
  if (was=="wuestenspringmaus" || was=="springmaus")
    {
     write (BS(
       "Du drueckst Deine Wuestenspringmaus an Dich, und versenkst "+
       "Deine Nase in ihrem weichen, flauschigen Fell. Erst "+
       "nach langer, langer Zeit kannst Du Dich wieder von ihr trennen."));
     say (BS(this_player()->name(WER,2)+
       " drueckt eine Wuestenspringmaus an sich "+
       "und versenkt die Nase in ihr weiches, flauschiges Fell."));
   return 1;
   }
 return 0;
}

cmstreichel (string was)
{
  notify_fail ("Wen moechtest Du streicheln?\n");
  if (was=="wuestenspringmaus" || was=="springmaus")
    {
     write (BS(
       "Du streichelst das weiche Fell Deiner kuscheligen "+
       "Wuestenspringmaus. Du nimmst Dir vor, dich bei Gelegenheit bei "+
       "Muaddib fuer diese tolle Springmaus zu bedanken."));
     say (BS(this_player()->name(WER,2)+
   " nimmt eine kuschelige Wuestenspringmaus in die Arme und streichelt ihr "+
       "weiches Fell."));
     return 1;
   }
 return 0;
}

cmherze (string was)
{
  notify_fail ("Wen moechtest Du herzen?\n");
  if (was=="wuestenspringmaus" || was=="springmaus")
  {
   write (BS(
     "Du drueckst Deine kuschelige, knuddelige, weiche Wuestenspringmaus "+
     "an Dein Herz, und merkst, dass es ihr sichtlich zu gefallen scheint. "+
    "Auch Deine Springmaus scheint Gefallen daran zu haben. Du hoerst wie "+
     "aus ihrer kleinen, spitzen Schnauze sowas wie ein "+
     "Fiiiiiiiiiep, Fiep, Fieeeeeeeeeeeeep zu vernehmen ist."));
   say (BS(this_player()->name(WER,2)+
     " herzt eine kuschelige Wuestenspringmaus. Diese antwortet darauf mit "+
     "einem genuesslichen Fiiiiiiiiiep, Fiep, Fieeeeeeeeep!"));
   return 1;
  }
return 0;
}

nicken(string spieler)
{
   finde(spieler);
   if (flag==0) return 0; if (flag==2) return 1;
     write(BS(
       "Deine Wuestenspringmaus rennt in Windeseile zu "+P(WEM)+" "+
       "und nickt "+P(WEM)+""+ zusatz+" zu. Schnell rennt sie "+
       "wieder zu Dir zurueck."));
     TOP(BS("Die Wuestenspringmaus von "+CTP(WEM)+" kommt angerannt und "+
       "nickt Dir"+ zusatz+" zu. Schnell verschwindet sie wieder."));
     return 1;
}

gratulieren(string spieler)
{
   finde(spieler);
   if (flag==0) return 0; if (flag==2) return 1;
   TOP(BS(
     "Die Wuestenspringmaus von "+CTP(WEM)+" taucht ploetzlich "+
     "vor Dir auf und gratuliert Dir"+ zusatz+". Schnell rennt "+
     "sie wieder zu "+CTP(WEM)+" zurueck."));
   write(BS(
     "Deine Wuestenspringmaus rennt zu "+P(WEM)+" und gratuliert "+
     ""+P(WEM)+""+ zusatz+". Schnell rennt sie wieder "+
     "zu Dir zurueck."));
   return 1;
}

troeste(string spieler)
{
   finde(spieler);
   if (flag==0) return 0; if (flag==2) return 1;
   TOP(BS(
     "Die Wuestenspringmaus von "+CTP(WEM)+" taucht ploetzlich "+
     "vor Dir auf, troestet Dich"+ zusatz+" und schaut Dich dabei traurig an."+
     "Mit einem leisen schluchzen verschwindet sie wieder."));
   write(BS(
     "Die Wuestenspringmaus rennt eilig zu "+P(WEM)+", troestet "+
     ""+P(WEM)+""+ zusatz+" und schaut dabei "+P(WEM)+" "+
     "traurig an. Schnell kommt sie wieder zu Dir zurueck."));
   return 1;
}

