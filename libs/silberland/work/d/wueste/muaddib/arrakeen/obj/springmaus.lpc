   write(BS(
     "Deine Wuestenspringmaus schaut dich fragend an, nickt Dir dann zu, "+
     "rennt zu "+P(WEM)+" und tritt "+P(WEM)+""+
     ""+ zusatz+" in den Hintern. Schnell kommt sie wieder zu Dir zurueck."));
   return 1;
