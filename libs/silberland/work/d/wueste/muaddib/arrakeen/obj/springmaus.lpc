{
   finde(spieler);
   if (flag==0) return 0; if (flag==2) return 1;
   TOP(BS(
     "Die Wuestenspringmaus von "+CTP(WEM)+" taucht, mit einem "+
     "strahlendem Gesicht, vor Dir auf und umarmt Dich"+ zusatz+". Vor "+
     "sich hin pfeifend verschwindet sie wieder lautlos."));
   write(BS(
     "Deine Wuestenspringmaus strahlt ueber das ganz Gesicht, macht "+
