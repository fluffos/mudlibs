/*
**
** Crys-Schwert, Standardbewaffnung
** der Wachen in Arrakeen, wird aus 
** den Zaehnen der Sandwuermer her-
** gestellt
**
** 29.9.1997 Muaddib@Silberland
**
*/

#pragma strong types;

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Crys-Schwert");
  SetProp(P_LONG, BS("Das ist ein Crys-Schwert, wie es die Fremen als Waffe "+
		     "verwenden. Es ist sehr leicht und unglaublich stabil."+
		     "\n"));
  SetProp(P_INFO, BS("Das Schwert wird aus den Zaehnen der Sandwuermer "+
		     "gefertigt.\n"));
  SetProp(P_WEIGHT, 500);
  SetProp(P_MATERIAL, ([MAT_GOLD:20,MAT_BONE:80])); 
  SetProp(P_NAME, "Schwert");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 150);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  AddId( ({"crys-schwert", "schwert"}) );

}






