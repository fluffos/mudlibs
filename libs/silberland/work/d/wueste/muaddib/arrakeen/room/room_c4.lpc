#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine gasse in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst in einer Gasse in Arrakeen. Die Haeuser bestehen hier, wie "+
    "es in dieser Stadt ueblich zu sein scheint, aus glattem, schwarzem "+
    "Stein. Im Norden kannst Du schon die Gilde erkennen, im Sueden "+
    "erkennst Du eindeutig den verbotenen Bezirk von Arrakeen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"arrakeen", "stadt", "wueste", "hauptstadt"}),
    "Arrakeen ist die Hauptstadt der Wueste.");
  AddDetail ( ({"bezirk"}),
    "Viele Geruechte ranken sich um den verbotenen Bezirk und seine "+
    "Katakomben. Manche Einwohner von Arrakeen sprechen von Gewalt und "+
    "fuerchterlichen Verbrechen, die sich dort abspielen sollen. ");
  AddDetail ( ({"katakomben"}),
    "Di Katakomben werden nicht mehr kontrolliert, seit dort so viel "+
    "Gewalt herrscht. Daher weiss auch niemand so genau, wie es dort "+
    "zugeht.");
  AddDetail ( ({"gewalt", "verbrechen"}),
    "Darueber wird beharrlich geschwiegen.");
  AddDetail ( ({"bewohner", "einwohner", "haendler"}),
    "Die Bewohner von Arrakeen sind meist friedliebende Haendler und "+
    "Fremen, die nicht mehr in der Wueste leben wollten.");
  AddDetail ( ({"gasse"}),
    "Eine einfache Gasse, sonst nichts.");
  AddDetail ( ({"haeuser", "stein", "material", "stadtmauern", "mauern"}),
    "Die Haeuser bestehen aus glattem, schwarzem Stein, wie Du es bestimmt "+
    "schon an den Stadtmauern gesehen hast. Vermutlich wird es sich dabei "+
    "um ein besonders stabiles Material handeln.");
  AddDetail ( ({"laden"}),
    "Du kannst den Laden ja betreten, um naehres herauszufinden.");
  AddDetail ( ({"hitze"}),
    "Spuerst Du die Hitze etwa nicht?");
  AddDetail ( ({"fremen"}),
    "Fremen sind die nomadischen Einwohner der Wueste. Ihnen werden "+
    "maechtige Faehigkeiten nachgesagt.");
  AddDetail ( ({"faehigkeit", "faehigkeiten"}),
    "Vielleicht hast Du irgendwann einmal die Gelegenheit, den Fremen "+
    "beizutreten..");
  AddDetail ( ({"gelegenheit", "senkung"}),
    "Das ist nun wirklich nicht wichtig.");
  AddDetail ( ({"geruecht", "geruechte"}),
    "Naja, Geruechte, die man halt so hoert.");
  AddDetail ( ({"fremengilde", "gilde", "gildengebaeude"}),
    "In der Fremengilde wirst Du die Kunst der Fremen mit allen ihren "+
    "Faehigkeiten gelehrt.");
  AddDetail ( ({"kunst"}),
    "Das musst Du selbst herausfinden.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./room_c3");
  AddExit ("osten", "./room_c5");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
