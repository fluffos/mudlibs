#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst in einer Gasse in Arrakeen. Die Haeuser bestehen aus "+
    "schwarzem Stein. Aus dem Sueden kannst Du schon den Marktlaerm "+
    "hoeren. Auf dem Boden liegt eine duenne Schicht aus Sand und Staub. ");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst den Laerm einer geschaeftigen Stadt.");
  AddSound ( ({"laerm"}),
    "Du hoerst den typischen Laerm einer Stadt. ");
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt"}),
    "Du stehst in Arrakeen, der Hauptstadt der Wueste.");
  AddDetail ( ({"wueste"}),
    "Die Wueste beginnt nahe der Stadt.");
  AddDetail ( ({"magier"}),
    "Es wird erzaehlt, dass Muaddib an der Erbauung von Arrakeen beteiligt "+
    "war.");
  AddDetail ( ({"erbauung"}),
    "Die Erbauung von Arrakeen ist sicher auf einen Magier "+
    "zurueckzufuehren.");
  AddDetail ( ({"sand", "schicht", "staub"}),
    "Der Boden ist mit mit einer duennen Schicht aus Sand und Staub "+
    "ueberzogen, die vermutlich aus der nahen Wueste heruebergeweht wurde.");
  AddDetail ( ({"boden"}),
    "Der Boden ist mit einer duennen Schicht aus Sand und Staub bedeckt.");
  AddDetail ( ({"gasse"}),
    "Eine einfache Gasse in Arrakeen.");
  AddDetail ( ({"haeuser", "haus"}),
    "Die Haeuser sind hier aus Stein gebaut.");
  AddDetail ( ({"haendler", "marktlaerm"}),
    "Du hoerst Haendler schreien.");
  AddDetail ( ({"stein"}),
    "Das ist jetzt wirklich nicht wichtig.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./room_b5");
  AddExit ("sueden", "./room_d5");
  AddExit ("westen", "./room_c4");
  AddExit ("osten", "./room_c6");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
