#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Die Hauptstrasse");
  SetProp (P_INT_LONG,
    "Du stehst mitten auf der Hauptstrasse in Arrakeen. Oestlich von Dir "+
    "ist der riesige herzoegliche Palast zu erkennen, und vom davor "+
    "gelegenen Marktplatz dringt Laerm zu Dir herueber. Westlich zieht "+
    "sich die Hauptstrasse zum Westtor hin. Der Boden ist mit Sand und "+
    "Staub bedeckt, ein Ueberbleibsel des letzten Sandsturmes.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt", 
                "wueste"}),
    "Arrakeen ist die Hauptstadt der Wueste und Du stehst mitten in dieser "+
    "Stadt.");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse von Arrakeen erstreckt sich vom Westtor im Westen "+
    "bis hin zum Herzogenpalast im Osten.");
  AddDetail ( ({"boden"}),
    "Am Boden liegt massig Staub herum. Du kannst viele Fusspuren "+
    "erkennen.");
  AddDetail ( ({"fusspur", "fusspuren"}),
    "Die Fusspuren am Boden lassen auf regen Betrieb schliessen.");
  AddDetail ( ({"betrieb", "mann", "ueberbleibsel"}),
    "Ist das wirklich wichtig?");
  AddDetail ( ({"herzogenpalast", "palast"}),
    "Dort wohnt der Herzog der Wuestenregion. Es heisst, dass er ein sehr "+
    "gebildeter und weiser Mann sein soll.");
  AddDetail ( ({"herzog"}),
    "Vielleicht kannst Du ihn ja bald einmal besuchen.");
  AddDetail ( ({"laerm", "marktplatz", "schreien"}),
    "Das klingt ganz deutlich nach dem Schreien auf dem Marktplatz im "+
    "Westen.");
  AddDetail ( ({"wuestenregion"}),
    "Die Wuestenregion wird sicher einmal die schoenste im Silberland sein "+
    "- und auch die gefaehrlichste.");
  AddDetail ( ({"silberland"}),
    "Das fragst Du doch nicht wirklich, oder?");
  AddDetail ( ({"sand"}),
    "Da die ganze Wueste aus Sand besteht, kommt es schon mal vor, dass "+
    "Sand in die Stadt geweht wird.");
  AddDetail ( ({"staub"}),
    "Auch Staub kommt gewoehnlich mit dem Sandsturm. Daher ist es auch "+
    "unmoeglich, Arrakeen wirklich sauber zu halten.");
  AddDetail ( ({"sandstuerme", "sandsturm"}),
    "Sandstuerme sind fuerchterlich hier in Arrakeen. Solltest Du je in "+
    "einen solchen geraten, so suche schnellstens ein Versteck!");
  AddDetail ( ({"versteck"}),
    "Das musst Du schon selber finden.");
  AddDetail ( ({"westtor"}),
    "Das Westtor ist der Eingang zu der Stadt und der Ausgang ins "+
    "Unbekannte.");
  AddDetail ( ({"ausgang", "eingang"}),
    "Irgendwie ist hier Eingang gleich Ausgang...komisch.");
  AddDetail ( ({"unbekannte", "unbekanntes"}),
    "Das liegt noch vor Dir.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./room_d5");
  AddExit ("westen", "./room_d3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
