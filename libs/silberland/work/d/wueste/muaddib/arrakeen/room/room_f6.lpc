#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp (P_INT_LONG,
    "Hier ist die Atmosphaere nicht ganz so duester wie im Westen. "+
    "Trotzdem wirken die Haeuser verfallen und unbewohnt. Im Westen kannst "+
    "Du das Tor zur verbotenen Zone ausmachen, im Osten steht ein "+
    "schmuckloses Haus mit einem grossen Wappen ueber der Tuer.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere ist im Westen definitiv duesterer. Aber trotzdem "+
    "moechtest Du hier nicht laenger verweilen, als noetig.");
  AddDetail ( ({"haeuser"}),
    "Die Haeuser machen einen ungepflegten Eindruck. Sie sind alt und "+
    "sicherlich unbewohnt. Das macht die ganze Atmosphaere etwas duester "+
    "und trist.");
  AddDetail ( ({"haus"}),
    "Das Haus ist im ganzen schmucklos, nur ein seltsam bekanntes Wappen "+
    "schmueckt den Eingang.");
  AddDetail ( ({"tuer"}),
    "Die Tuer scheint offen zu sein. Vielleicht kannst Du das Haus "+
    "betreten?");
  AddDetail ( ({"eindruck"}),
    "Dein Eindruck von dieser Gegend ist nicht so gut, wie vom Rest von "+
    "Arrakeen.");
  AddDetail ( ({"gegend"}),
    "Irgendwie trist und oed.");
  AddDetail ( ({"arrakeen"}),
    "Arrakeen ist die Hauptstadt der Region Wueste und mehr oder weniger "+
    "die einzige Stadt der Wueste, die Dir so einfaellt.");
  AddDetail ( ({"hauptstadt"}),
    "Hauptstadt und vermutlich einzige Stadt in der Wueste. Hmmm. Das "+
    "koennte man vielleicht untersuchen.");
  AddDetail ( ({"region", "silberland", "wueste"}),
    "Im Silberland ist die Wueste sicher eine der aufregendsten Regionen.");
  AddDetail ( ({"eingang"}),
    "Der Eingang ist eigentlich recht schmucklos.");
  AddDetail ( ({"rest"}),
    "Ist das wirklich wichtig?");
  AddDetail ( ({"stadt"}),
    "Die Stadt in der Wueste ist Arrakeen und Du stehst mittendrin. Du "+
    "kannst Fragen stellen...");
  AddDetail ( ({"bezirk", "tor", "zone"}),
    "Jedesmal, wenn Du das Tor zum verbotenen Bezirk siehst, beschleicht "+
    "Dich eine dunkle Vorahnung.");
  AddDetail ( ({"vorahnung"}),
    "Das kannst Du noch nicht richtig erfassen.");
  AddDetail ( ({"falke", "hintergrund", "wappen", "streitkraefte"}),
    "Ein roter Falke auf schwarzem Hintergrund, das ist das Wappen der "+
    "herzoeglichen Streitkraefte.");
  AddDetail ( ({"fragen"}),
    "Das ist doch wirklich nicht wichtig, oder?");
  // DETAILS END

  // EXITS START
   AddExit ("westen", "./room_f5");
  AddExit ("haus", "in das Haus#"+"./room_f7");
  // EXITS END

  // ITEMS START
  AddItem(NPC "waechter", REFRESH_DESTRUCT);
  AddItem(NPC "citizen", REFRESH_DESTRUCT);
  // ITEMS END

}
