#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Der Marktplatz von Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst auf einem Marktplatz, auf dem hektisches Treiben herrscht. "+
    "Ueberall sind Staende aufgebaut, an denen die unterschiedlichsten "+
    "Dinge feilgeboten werden. In der Luft haengt ein seltsamer Geruch. "+
    "Der Laerm hier ist wohl der Ursprung des Laermes in der ganzen "+
    "Stadt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht nach diversen Lebensmitteln und Gewuerzen, die man hier "+
    "kaufen kann.");
  AddDetail ( ({"dinge"}),
    "Hier kann man wohl all das kaufen, was normale Laeden nicht bieten. "+
    "Hier bekommt man sicher auch Imitate von Fremenausruestung.");
  AddDetail ( ({"fremenausruestung", "imitate"}),
    "Ob diese echt aussehenden Imitate auch so funktionieren, wie die "+
    "Originale, kannst Du Dir nicht vorstellen.");
  AddDetail ( ({"laden", "laeden"}),
    "So etwas siehst Du hier nicht. Hier stehen nur Staende herum.");
  AddDetail ( ({"staende"}),
    "Bei sovielen Staenden verlierst Du die Uebersicht.");
  AddDetail ( ({"uebersicht"}),
    "Die hast Du schon laengst verloren.");
  AddSound ( ({DEFAULT_SOUND}),
    "Die Haendler und Kunden schreien hier so laut, dass man das sicher "+
    "durch die ganze Stadt hoeren kann.");
  AddDetail ( ({"geruch"}),
    "Das kannst Du so nicht untersuchen.");
  AddDetail ( ({"laerm"}),
    "Wenn Du Dich konzentrierst, vielleicht kannst Du ja was hoeren?");
  AddDetail ( ({"marktplatz", "platz"}),
    "Du stehst mitten auf dem Platz.");
  AddDetail ( ({"luft"}),
    "Vielleicht solltest Du mal schnuppern?");
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt", 
                "wueste"}),
    "Arrakeen ist die Hauptstadt der Wueste und Du stehst mitten in der "+
    "Stadt.");
  AddDetail ( ({"ursprung"}),
    "Das ist doch nicht so wichtig, oder?");
  AddDetail ( ({"treiben"}),
    "Hier ist es ziemlich voll, dafuer, dass der Platz nur so klein ist.");
  AddDetail ( ({"original", "originale"}),
    "Ueber die Originale erzaehlt man sich viel. Vielleicht besitzt auch "+
    "Du mal eines...");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./room_c5");
  AddExit ("westen", "./room_d4");
  AddExit ("osten", "./room_d6");
  AddExit ("sueden", "./room_e5");
  // EXITS END

  // ITEMS START
  AddItem(NPC "citizen", REFRESH_DESTRUCT);
  // ITEMS END

}
