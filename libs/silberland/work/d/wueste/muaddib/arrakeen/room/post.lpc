/*
** Post in Arrakeen
**
** by Muaddib@Silberland
**
*/

inherit "/std/post";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();
  AddExit("westen","+wueste/muaddib/arrakeen/room/room_b5");
  
  SetProp(P_INT_LONG, BS("Du stehst im Hauptpostamt der Region Wueste. "+
			 "Die Waende sind weiss getuencht, daher ist "+
			 "es hier auch ziemlich kuehl und angenehm. "+
			 "Trotz dieser Tatsache halten sich hier recht "+
			 "wenig Leute auf. Um Briefe schreiben und lesen "+
			 "zu koennen, gib <post> ein.\n"));
  AddDetail("hauptpostamt", "Eigentlich gibt es sowieso nur eines.\n");
  AddDetail( ({"region","wueste"}), BS("Du befindest Dich in der Region "+
				       "Wueste. Beziehungsweise in der "+
				       "Hauptstadt.\n"));
  AddDetail( ({"hauptstadt", "arrakeen"}),
	     BS("Du bist in Arrakeen, der Hauptstadt der Region.\n"));
  AddDetail( ({"waende", "wand"}),
	     "Die Waende sind weiss getuencht.\n");
  AddDetail("boden", "Der Boden sieht erstaunlich sauber aus.\n");
  AddDetail("decke", "Die Decke ist genau wie die Waende weiss getuencht.\n");
  AddDetail("silberland",  "Das kannst Du nicht ernsthaft fragen!\n");
  AddDetail("tatsache", "Das ist unwichtig.\n");
  AddDetail("leute", "Davon siehst Du hier wenig.\n");
  AddDetail( ({"brief", "briefe"}),
	     BS("Um die zu lesen oder zu schreiben, bist Du ja hier, "+
		"oder?\n"));
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:29, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("westen", "./room_b5");
}             

