#include <properties.h>
#include <moving.h>
#include "../def.h"

#define WATER_MASTER "/d/wueste/muaddib/arrakeen/npc/water_master.lpc"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Vor den herzoeglichen Parkanlagen");
  SetProp (P_INT_LONG,
    "Du stehst auf einem sehr gepflegten Weg, der fast uebergangslos von "+
    "der Hauptstrasse im Osten zu den herzoeglichen Parkanlagen im Westen "+
    "fuehrt. Die Parkanlagen sind mit einem schoenen schmiedeeisernen Tor "+
    "gesichert.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"park", "parkanlage", "parkanlagen"}),
    "Die Parkanlagen von Arrakeen sind im ganzen Silberland fuer ihre "+
    "atemberaubende Schoenheit bekannt. Hier geht der Herzog spazieren, "+
    "wenn er die Zeit dazu hat, was selten genug der Fall ist.");
  AddDetail ( ({"tor"}),
    "Das Tor ist zugesperrt. In der Mitte haengt eine kleine Tafel aus "+
    "scheinbar reinem Gold.");
  AddDetail ( ({"tafel"}),
    "Hmm, die Schrift scheint verstaendlich fuer Dich zu sein.");
  AddReadDetail ( ({"schrift", "tafel"}),
    "Das Tor ist offen, solange bis ein neues Schloss eingebaut wird.\n"); 
   AddDetail ( ({"zeit"}),
    "Zeit scheint hier niemand zu haben.");
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt", 
                "wueste"}),
    "Arrakeen ist die Hauptstadt der Wueste.");
  AddDetail ( ({"wuestenregion"}),
    "Die Wuestenregion wird bald die schoenste im Silberland sein.");
  AddDetail ( ({"fall", "mitte"}),
    "Das ist doch wohl nicht so wichtig, oder?");
  AddDetail ( ({"gold"}),
    "Woher der Herzog wohl das Gold hat?");
  AddDetail ( ({"herzog"}),
    "Der Herzog regiert im Herzogenpalast ueber die Wueste. Der Palast "+
    "befindet sich innerhalb der Parkanlagen.");
  AddDetail ( ({"herzogenpalast", "palast"}),
    "Der Palast ist eines der Wahrzeichen von Arrakeen.");
  AddDetail ( ({"wahrzeichen"}),
    "Die Wahrzeichen von Arrakeen sind der Herzogenpalast und das Westtor.");
  AddDetail ( ({"westtor"}),
    "Das Westtor ist weit im Osten zu erkennen.");
  AddDetail ( ({"hauptstrasse"}),
    "Die Hauptstrasse von Arrakeen fuehrt genau in der Mitte von Arrakeen "+
    "vom Westtor zum Herzogenpalast.");
  AddDetail ( ({"schrift"}),
    "Sie ist zwar verschnoerkelt, aber Du kannst sie lesen.");
  AddDetail ( ({"weg"}),
    "Das ist ein besonders schoener Weg. Wohl um auf den Park "+
    "einzustimmen.");
  AddDetail ( ({"schoenheit"}),
    "Du bist ueberzeugt, dass der Park schoen ist.");
  AddDetail ( ({"silberland"}),
    "Das meinst Du aber nicht ernsthaft, oder?");

  AddCmd("oeffne", "oeffne_tor");
  AddCmd(({"schliesse","schliess"}), "schliesse_tor");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./room_d5");
  AddSpecialExit("osten", "tor_fun");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int schliesse_tor(string str)
{
  if (!str) return 0;
  if (str != "tor")
    return 0;
  if (!WATER_MASTER->opened())
    {
      write("Das Tor ist schon geschlossen.\n");
      return 1;
    }
  WATER_MASTER->schliessen();
  write("Du schliesst das Tor.\n");
  say(TPN+" schliesst das Tor.\n");
  return 1;
}

int oeffne_tor(string str)
{
  if (!str) return 0;
  if (str != "tor")
    return 0;
  if (WATER_MASTER->opened())
    {
      write("Das Tor ist schon offen.\n");
      return 1;
    }
  WATER_MASTER->oeffnen();
  write("Du oeffnest das Tor.\n");
  say(TPN+" oeffnet das Tor.\n");
  return 1;
}

int tor_fun()
{
  if (WATER_MASTER->opened())
    {
      TP->move(ROOM "room_d7", M_GO);
      return 1;
    }
  write("Das Tor ist geschlossen.\n");
  return 1;
}
