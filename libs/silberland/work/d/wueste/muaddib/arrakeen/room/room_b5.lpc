#include <properties.h>
#include <moving.h>
#include "../def.h"



inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Eine Gasse in Arrakeen");
  SetProp (P_INT_LONG,
    "Du stehst in einer schmalen Gasse in Arrakeen. Die Haeuser sind hier "+
    "genau so wie ueberall in der Stadt aus schwarzem Stein gebaut. Auf "+
    "dem Boden liegt eine duenne Schicht aus Sand und Staub. Im Westen "+
    "erkennst Du ein Gildengebaeude und im Osten ist das Postamt von "+
    "Arrakeen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst den Laerm einer geschaeftigen Stadt.");
  AddSound ( ({"laerm"}),
    "Du hoerst den typischen Laerm einer Stadt. ");
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt"}),
    "Du befindest Dich in Arrakeen, der Hauptstadt der Wueste.");
  AddDetail ( ({"gasse", "strasse", "weg"}),
    "Du stehst in einer gewoehnlichen Gasse in Arrakeen.");
  AddDetail ( ({"sand", "schicht", "staub"}),
    "Die nahe Wueste hat ihren Sand auf den Strassen von Arrakeen "+
    "hinterlassen.");
  /* AddDetail ( ({"art"}),
    "Basalt entsteht normalerweise in stufenfoermiger Art. Das glatte "+
    "Gestein laesst auf einen  Magier schliessen, der bei der Erbauung der "+
    "Stadt mitgeholfen hat."); */
  AddDetail ( ({"boden"}),
    "Der Boden ist mit einer duennen Schicht von Staub und Sand bedeckt.");
  AddDetail ( ({"erbauung"}),
    "Bei der Erbauung von Arrakeen hat sicherlich ein Magier geholfen.");
  AddDetail ( ({"magier"}),
    "Geruechten zufolge soll Muaddib bei der Erbauung geholfen haben.");
  AddDetail ( ({"stein","gestein", "gesteinsart", "art"}),
    "Das ist nun wirklich unwichtig.");
  AddDetail ( ({"gildengebaeude"}),
    "Du erkennst das Gildengebaeude der Fremengilde.");
  AddDetail ( ({"fremengilde", "gilde"}),
    "In der Fremengilde werden Wuestenkaempfer ausgebildet.");
  AddDetail ( ({"haeuser", "haus"}),
    "Die Haeuser hier sind aus schwarzem Stein gebaut.");
  AddDetail ( ({"postamt"}),
    "Im Postamt kannst Du Briefe an alle schreiben.");
  AddDetail ( ({"briefe"}),
    "Briefe kann man im Postamt schreiben.");
  AddDetail ( ({"wueste"}),
    "Die Wueste liegt jenseits der Stadt.");
  AddDetail ( ({"fedaykin", "wuestenkaempfer"}),
    "Von den Wuestenkaempfern der Fremengilde und den elitaeren Fedaykin "+
    "erzaehlt man sich viel in Arrakeen.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", "./room_c5");
  AddExit ("norden", "./room_a5");
  AddExit ("osten", "./post");
  AddSpecialExit ("westen", "gebdfkt");
// EXITS END

// ITEMS START
// ITEMS END

}

int gebdfkt(string dir)
{
  AddReadDetail("schild",
	"************************************************************\n"+
        "* Wir sind mit dem Umbau des Gildengebaeudes beschaeftigt. *\n"+
        "* Dieser Umbau dient Ihrer Bequemlichkeit, daher bitten    *\n"+
        "* wir untertaenigst um Verzeihung wegen der kleinen        *\n"+
        "* Unannehmlichkeit.                                        *\n"+
        "*                                                          *\n"+
        "* Mit freundlichem Grusse,                                 *\n"+
        "*      Ihre Stadtverwaltung                                *\n"
	"************************************************************\n");
  write( BS("Die Tuer ist verriegelt und an der Tuer haengt ein Schild, das "+
  "Du lesen kannst.\n"));
return 1;

}
