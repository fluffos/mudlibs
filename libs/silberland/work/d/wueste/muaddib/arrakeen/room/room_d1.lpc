#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Das Stadttor");
  SetProp (P_INT_LONG,
    "Du stehst unter dem westlichen Teil des Westtores. Westlich von Dir "+
    "geht der Weg in unbekannte und ungesicherte Land. Oestlich von Dir "+
    "geht das Sicherheitsgitter durch das Tor. Das ganze Tor besteht aus "+
    "schwarzem Stein, was eine bedrohliche Atmosphaere schafft. Wer "+
    "weiss, wie man in Arrakeen mit Fremden umgeht...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt"}),
    "Du bist vor dem Tor von Arrakeen, der Hauptstadt der Wueste.");
  AddDetail ( ({"wueste"}),
    "Die Wueste faengt nahe Arrakeen an.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere wirkt hier am Tor direkt bedrohlich.");
  AddDetail ( ({"form"}),
    "An der Form des Steines laesst sich erkennen, dass wohl ein Magier "+
    "bei der Erschaffung witgewirkt haben muss.");
  AddDetail ( ({"erschaffung", "magier"}),
    "Man erzaehlt sich hier, dass Muaddib bei der Erschaffung der Stadt "+
    "beteiligt war.");
  AddDetail ( ({"fremde", "fremden", "fremder"}),
    "Hoffentlich ist dieses Tor keine Einstimmung darauf, wie Arrakeen auf "+
    "Fremde reagiert.");
  AddDetail ( ({"einstimmung"}),
    "Die Einstimmung ist unheimlich.");
  AddDetail ( ({"land"}),
    "Was es da wohl noch alles zu entdecken gibt?");
  AddDetail ( ({"sicherheitsgitter"}),
    "Das ist wohl dazu da, ungebetene Fremde abzuhalten.");
  AddDetail ( ({"tor", "westtor"}),
    "Das Westtor von Arrakeen laedt nicht gerade zum verweilen ein. Du "+
    "willst nur weg von hier.");
  AddDetail ( ({"teil","stein"}),
    "Das ist nun wirklich nicht wichtig.");
  AddDetail ( ({"weg"}),
    "Der weg geht hinaus ins Land.");
  // DETAILS END

  // EXITS START
  AddExit ("osten",  "./room_d2");
  AddExit ("westen", "/d/wueste/protheg/karavanen/room/arakar");
  // AddExit ("sueden", "./room_e1");
  // EXITS END

  // ITEMS START
  // AddItem(OBJ "karawane", REFRESH_DESTRUCT);
  // ITEMS END

}
