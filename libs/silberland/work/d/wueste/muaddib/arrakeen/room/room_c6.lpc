#include <properties.h>
#include <moving.h>
#include "../def.h"

#ifndef ROOM
#define ROOM(x) ("/d/wueste/muaddib/arrakeen/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN:TT_TOWN]));
  SetProp (P_INT_SHORT, "Auf dem Weg zur Tempelanlage");
  SetProp (P_INT_LONG,
    "Du stehst auf einem Weg zur Tempelanlage in Arrakeen. Der Weg ist "+
    "mit sehr feinem, weissen Sand bestreut und macht einen sehr "+
    "gepflegten Eindruck. Im Nordosten kannst Du schon einen Teil der "+
    "Tempelanlage erkennen. Der Weg nach Nordosten ist jedoch mit einer "+
    "Schnur aus rotem Samt abgesperrt. An der Seite steht ein kleines "+
    "Schild.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst den Laerm, den der Markt im Suedwesten verursacht.");
  AddSound ( ({"laerm", "marktlaerm"}),
    "Typischer Marktlaerm halt.");
  AddDetail ( ({"markt"}),
    "Der ist im Suedwesten.");
  AddDetail ( ({"nordosten", "suedwesten", "gelegenheit", "leute", "seite"}),
    "Das ist nun wirklich nicht wichtig.");
  AddDetail ( ({"schild"}),
    "Vielleicht kannst Du es lesen?");
  AddReadDetail ( ({"schild"}), 
    "Liebe Besucher, liebe Glaeubige,\n\n"+BS(
    "Die Tempelanlage wird gerade "+
    "restauriert, nachdem sie vor kurzem geschaendet worden ist. Es wird "+
    "ein Heiler durch die Stadt laufen, bei dem die ueblichen Dienste fuer "+
    "einen kleinen Aufpreis in Anspruch genommen werden koennen.")+"\n"+"Die "+
    "Stadtverwaltung von Arrakeen.\n");
  AddDetail ( ({"weg", "eindruck"}),
    "Der Weg macht einen sehr gepflegten Eindruck.");
  AddDetail ( ({"tempel", "tempelanlage"}),
    "Die Tempel von Arrakeen sind bekannt dafuer, dass sie Reisenden und "+
    "Verwundeten Hilfe und Erholung anbieten.");
  AddDetail ( ({"reisende"}),
    "Reisende kommen recht haeufig nach Arrakeen.");
  AddDetail ( ({"arrakeen", "hauptstadt", "stadt", 
                "wueste"}),
    "Arrakeen ist die Hauptstadt der Wueste.");
  AddDetail ( ({"verwundete", "verwundeter"}),
    "Verwundete werden hier sicherlich gut behandelt und gepflegt, wenn "+
    "sie sich wuerdig und glaeubig erweisen.");
  AddDetail ( ({"erholung", "hilfe"}),
    "Viele Leute, die nach Arrakeen kommen, brauchen Hilfe und auch die "+
    "Gelegenheit, sich zu erholen. Beides wird in der Tempelanlage geboten.");
  AddDetail ( ({"samt", "schnur"}),
    "Die Schnur besteht aus edlem rotem Samt und harmoniert hervorragend "+
    "mit dem weissen Sand des Weges.");
  AddDetail ( ({"sand"}),
    "Der Sand sieht sehr edel aus und ist bestimmt selten zu finden.");
  AddDetail ( ({"teil"}),
    "Von der Tempelanlage kannst Du von hier nur einen Teil sehen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./room_c5");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
