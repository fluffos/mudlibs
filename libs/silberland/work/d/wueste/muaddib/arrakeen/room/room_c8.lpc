#include <properties.h>
#include <moving.h>
#include "../def.h"


inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:45, ENV_TERRAIN: TT_PLAIN]));
  SetProp (P_INT_SHORT, "In den herzoeglichen Gaerten");
  SetProp (P_INT_LONG, 
	   BS("Du stehst im hinteren Teil des herrlichen Gartens. Suedlich "+
	      "von Dir befindet sich der herzoegliche Palast und oestlich "+
	      "siehst Du die Mauer, die die Parkanlagen umgrenzt. Die "+
	      "Mauer ist von Efeu umrankt.\n"));
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"palast"}),
    "Hie residiert der Herzog von Arrakeen, Herrscher ueber die Wueste. "+
    "Die Leute hier in der Stadt sprechen viel ueber seine Weisheit.");
  AddDetail ( ({"arrakeen", "stadt"}),
    "Arrakeen heisst die Stadt, in der Du Dich befindest.");
  AddDetail ( ({"einwohner", "leute"}),
    "Die Einwohner von Arrakeen sind eigentlich gut auf ihren Herrscher zu "+
    "sprechen.");
  AddDetail ( ({"herrscher"}),
    "Als Herrscher kann man den Herzog von Arrakeen eigentlich nicht "+
    "bezeichnen. Er behandelt seine Untergebenen gerecht und spart auch "+
    "nicht mit Wasser.");
  AddDetail ( ({"wasser"}),
    "Wasser scheint hier in der Wueste eine besondere Rolle zu spielen. "+
    "Was angesichts der hier herrschenden Temperaturen auch nicht weiter "+
    "verwunderlich ist.");
  AddDetail ( ({"temperatur", "temperaturen"}),
    "Eigentlich faellt die Temperatur hier selten unter 40 Grad.");
  AddDetail ( ({"grad"}),
    "Das ist wohl nicht so wichtig.");
  AddDetail ( ({"wueste"}),
    "Du hast jetzt schon soviele Dinge ueber die Wueste gehoert, dass es "+
    "Dich ueberall juckt, diese selbst auch einmal zu erkunden.");
  AddDetail ( ({"ding", "dinge"}),
    "Das musst Du schon selbst herausfinden.");
  AddDetail ( ({"garten"}),
    "Der Garten ist wirklich hervorragend gepflegt. Ueberall wachsen "+
    "gruene Buesche und Palmen aus dem gut durchfeuchteten Boden. Du "+
    "fuehlst Dich wie in einer Oase.");
  AddDetail ( ({"boden"}),
    "Komisch, wie feucht der Boden ist. Eigentlich muesste er genau so "+
    "trocken sein, wie der Rest in Arrakeen.");
  AddDetail ( ({"rest"}),
    "Der Rest von Arrakeen ist total ausgetrocknet.");
  AddDetail ( ({"buesche"}),
    "Du kannst sie nicht weiter identifizieren, willst es auch gar nicht. "+
    "Die Buesche wirken einfach nur beruhigend auf Dich.");
  AddDetail ( ({"gefuehl", "ruhe"}),
    "Ein Gefuehl von innerer Ruhe macht sich in Deinem gestressten Herzen "+
    "breit. Wenn es hier nicht so heiss waere, wuerdest Du hier gerne etwas "+
    "ausruhen.");
  AddDetail ( ({"herz", "herzen"}),
    "Huch, eine Zeit lang hattest Du das Gefuehl, es irgendwo "+
    "liegengelassen zu haben. Aber da schlaegt es wieder im gewohnten "+
    "Rhythmus.");
  AddDetail ( ({"rhythmus", "zeit"}),
    "Das ist hier wirklich nicht wichtig.");
  AddDetail ( ({"herzog"}),
    "Vielleicht ergibt sich ja mal die Gelegenheit, dass Du diesen weisen "+
    "Herrscher kennenlernst.");
  AddDetail ( ({"gelegenheit", "gelegenheiten"}),
    "Gelegenheiten ergeben sich immer wieder.");
  AddDetail ( ({"oase"}),
    "Anders kann man diesen Park nicht beschreiben. Du fuehlst Dich hier "+
    "sehr wohl und geborgen.");
  AddDetail ( ({"park", "parkanlage", "parkanlagen"}),
    "Eigentlich ist es nur der zum Palast gehoerende Garten, aber es kommt "+
    "Dir vor wie ein grosser Park.");
  AddDetail ( ({"palme", "palmen"}),
    "Die Palmen, die hier wachsen, stehen gerade in voller Bluete. Ein "+
    "wunderschoener Anblick.");
  AddDetail ( ({"bluete"}),
    "Die Palmen bluehen in verschiedenen Farben.");
  AddDetail ( ({"farbe", "farben"}),
    "Du siehst rot, rosa und violett.");
  AddDetail ( ({"anblick"}),
    "Diesen Anblick kannst Du gewiss nicht mehr vergessen.");
  AddDetail ( ({"pflanze", "pflanzen"}),
    "Die Pflanzen hier wirken sehr beruhigend auf Dich.");
  AddDetail ( ({"untergebene", "untergebenen"}),
    "Untergebene ist ein eher selten gebrauchter Ausdruck hier.");
  AddDetail ( ({"ausdruck"}),
    "Das ist wirklich unwichtig.");
  AddDetail ( ({"weisheit"}),
    "Die Weisheit des Herzogs ist beruehmt im ganzen Land.");
  AddDetail ( ({"land", "silberland"}),
    "Das Land ist natuerlich das Silberland, aber das weisst Du ja "+
    "sowieso.");
  AddDetail ( ({"rolle"}),
    "Die Rolle des Wassers in der Wueste ist angesichts der hohen "+
    "Temperaturen leicht zu ersehen.");
  AddDetail ( ({"efeu"}),
    "Das Efeu umrankt die ganze Mauer und gibt dem ganzen Anblick noch "+
    "eine sehr geheimnisvolle Note.");
  AddDetail ( ({"mauer"}),
    "Das ist die Mauer, die den Garten von dem Wachweg abgrenzt.");
  AddDetail ( ({"wachweg"}),
    "Auf dem Wachweg kann man einmal um Arrakeen herumlaufen.");
  AddDetail ( ({"note"}),
    "Du hast ploetzlich eine Vision, in der Du einen See voller Blut "+
    "siehst. Dann ist er wieder verschwunden.");
  AddDetail ( ({"vision"}),
    "Das war nur eine Vision. Vielleicht auch nur Einbildung.");
  AddDetail ( ({"einbildung"}),
    "Viele Leute haben bei diesen Temperaturen Einbildungen.");
  AddDetail ( ({"blut", "see"}),
    "Das war nur Teil Deiner Vision.");
  AddDetail ( ({"teil"}),
    "Das ist nicht so wichtig.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./room_c7");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
