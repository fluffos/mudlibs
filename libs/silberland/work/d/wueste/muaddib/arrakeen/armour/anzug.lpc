**
*/

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Anzug");
  SetProp(P_LONG, "Ein Anzug, wie ihn Buerger normalerweise tragen.\n");
  AddId("anzug");
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:2, T_COLD_PROT:2]));
}


