inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"


create()
{
  if (!is_clone(TO)) return;
  ::create();
 
  AddId( ({"umhang"}) );
  SetProp(P_SHORT, "Ein Umhang");
  SetProp(P_LONG, BS("Ein besonderer Umhang, der nur fuer wichtige Leute "+
		     "gefertigt wird.\n"));
  SetProp(P_INFO, "Er scheint vor Hitze zu schuetzen.\n");
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100])); 
  SetProp(P_WEIGHT, 1000); 
  SetProp(P_VALUE, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT: 10, T_COLD_PROT:1]));
}





