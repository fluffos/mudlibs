inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"


create()
{
  if (!is_clone(TO)) return;
  ::create();
 
  AddId( ({"wuestenpanzer", "panzer" }) );
  SetProp(P_SHORT, "Ein Wuestenpanzer");
  SetProp(P_LONG, BS("Ein von Sandstuermen gegerbter Wuestenpanzer aus "+
		     "widerstandsfaehigem Material.\n"));
  SetProp(P_INFO, "Es scheint eine sehr stabile Ruestung zu sein.\n");
  SetProp(P_NAME, "Panzer");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_LEATHER:70, MAT_IRON:30]));
  SetProp(P_WEIGHT, 1000); /* evtl. spaeter noch aendern */
  SetProp(P_VALUE, 1500);
}





