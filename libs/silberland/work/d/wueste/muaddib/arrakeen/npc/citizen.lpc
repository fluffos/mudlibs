/*
**
** Buerger von Arrakeen
**
** by Muaddib@SilberLand
**
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include <moving.h>
#include "../def.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;
  ::create();
  
  AddId("buerger");
  SetProp(P_SHORT, "Ein Buerger von Arrakeen");
  SetProp(P_LONG, BS("Dieser Buerger ist wohl damit beschaeftigt, seinen "+
		     "Tagesgeschaeften nachzugehen. Er scheint Dich gaenzlich "+
		     "zu ignorieren.\n"));
  create_default_npc(10);
  SetProp(P_ALIGN, 300);
  SetProp(P_NAME, "Buerger");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Nomade");
  SetProp(P_SIZE, 180);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15, T_RANGE_MAX:50]));
 
  SUID;
  CLONEME(ARMOUR "anzug");
  TO->command_me("zieh anzug an");
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT, 500);
  ob->move(ME);
  
   SetProp(P_SPELLRATE, 15);
   
   AddSpell(1, 100, "Der Buerger haut Dich mit seinen Akten.\n",
	    "Der Buerger haut @WEN mit seinen Akten.\n");
   
   SetProp(P_DIE_MSG, " stirbt mit einem Fluch auf den Lippen.\n");
   SetProp(P_DEFAULT_INFO, "sagt: Tut mir leid, ich hab jetzt keine Zeit.\n");

   SetProp(P_REJECT, ({ REJECT_KEEP, " steckt es ein und hastet weiter.\n"}));

   SetProp(P_MNPC_AREA, (ROOM));
   SetProp(P_MNPC_WAIT, ({12, 7, 3}) );
   SetProp(P_MNPC_DEFAULTROOM, ROOM "room_d5");
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}





