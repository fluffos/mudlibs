/*
** Der Wirt aus Arrakeen
**
** by Muaddib@Silberland
**
*/

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

#define NPC_MASTER "/d/wueste/muaddib/arrakeen/npc/bashar.lpc"
#define BSA(x,y) break_string(x,78,y)

inherit "std/npc";


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId( "wirt" );
  SetProp(P_SHORT, "Ein Wirt");
  SetProp(P_LONG, BS("Der Wirt scheint die Atmosphaere in seiner Kneipe zu "+
		     "geniessen. Er kennt die meisten seiner Kunden und hat "+
		     "den Ruf, denen zu helfen, die in Not sind.\n"));
  SetProp(P_NAME, "Wirt");
  SetProp(P_GENDER, MALE);
  SetProp(P_ALIGN, 250);
  create_default_npc(15);
  
  SetProp(P_SPELLRATE, 40);
  
  AddSpell(1, 300, 
	   "Der Wirt holt einen Holzknueppel hinter der Theke hervor und "+
	   "haut zu.\n",
	   "Der Wirt haut @WEM mit einem Holzknueppel auf den Kopf.\n",
	   DT_BLUDGEON);

  SetChats(4, ({
    "Der Wirt begruesst Dich in der Kneipe.\n",
      "Der Wirt fuellt ein Glas mit Kaktussaft.\n",
      "Der Wirt mixt einen Scheichcocktail.\n",
      "Der Wirt bekommt ein grosses Stueck Sandwurm geliefert. Dir wird "+
      "schlecht.\n",
      "Der Wirt redet mit einem Einwohner.\n",
      "Der Wirt verbrueht sich an einer Tasse Kaffee.\n" }));

  SetAttackChats(6, ({
    "Der Wirt schaut Dich entsetzt an.\n",
      "Der Wirt wird sauer und schreit: Lass das bleiben!\n",
      "Der Wirt ruft um Hilfe.\n",
      "Der Wirt sagt: Das wirst Du bitter bereuen.\n" }));

  AddInfo(DEFAULT_INFO, "Woher soll ich das wissen?\n", "sagt: ");
  AddInfo( ({"tafelwasser","wasser"}), 
	   "Das ist ein ganz besonderes Wasser. Wir lassen es extra "+
	      "aus dem Silberwald herbringen.", "erzaehlt :");
  AddInfo("silberwald", "Da gibt es sehr gutes Wasser.\n", "sagt: ");
  AddInfo( ({"spice-wein", "wein"}),
	   "Dieser Wein wird von meinem Grossvater hergestellt. Wie er "+
	      "das genau macht, hat er mir noch nie gesagt.","fluestert :");
  AddInfo( ({"kaffee"}),
	   "Der Kaffee hilft auch den Schwaechsten wieder zu neuer "+
	      "Kraft.", "wirbt: ");
  AddInfo( "grossvater", "Ja, der kommt manchmal vorbei.\n", "sagt: ");
  AddInfo( ({"kaktussaft", "saft"}),
	   "Das ist ein besonders wertvoller Saft ohne Alkohol, der "+
	      "zur Zeit im Sonderangebot ist.", "erklaert: ");
  AddInfo( ({"scheich-cocktail", "cocktail"}),
	   "Das ist unser bestes Getraenk. Es wird nach einem uralten "+
	      "Rezept hergestellt. Das Rezept war frueher in Besitz eines "+
	      "Scheichs, bis mein Grossvater es bekommen hat.", "sagt: ");
  AddInfo( "scheich",
	   "Hmm, ich kann mich  nicht an den Namen erinnern.\n", "gruebelt: ");
  AddInfo( ({"muaddib", "muad'dib", "mua"}),
	   "Muaddib...hmmm, ja, der kommt hier auch manchmal her. "+
	      "Sein Name bedeutet in einer der alten Sprachen uebrigens "+
	      "Wuestenspringmaus.", "erzaehlt: ");
  AddInfo( ({"wuestenspringmaus", "springmaus", "maus"}),
	   "Das sind ganz suesse, kleine Maeuse, die in der Wueste "+
	      "besonders gut ueberleben koennen. Manche Leute haben mir "+
	      "schon erzaehlt, dass es noch Exemplare gibt, aber frag mich "+
	      "nicht, wo.", "erklaert: ");
  AddInfo( ({"sandwurm", "wurm", "bratwurm"}),
	   "Der wird extra fuer meine Kneipe in der Wueste gefangen und "+
	   "geschlachtet. Man muss ihn frisch zubereiten und keiner kann "+
	   "das besser als ich.\n", "erklaert: ");
  AddInfo( "dusty",
	   "Ich hab vom Wirt in Midas erfahren, dass sie eh nur Saft und "+
	   "Cola mag. Daher wird sie hier wohl auch nicht herkommen.",
	   "seufzt: ");
  AddInfo( "woody",
	   "Woody ist hier auch noch nicht gewesen. Aber Max, das ist der "+
	   "Wirt in Midas, hat mir schon von ihm erzaehlt.", "sagt: ");
  AddInfo( "creative",
	   "Crea... hmm, ja, der ist Stammgast hier. Meist kommt er mit "+
	   "Muaddib her und dann reden die beiden immer.", "raunt: ");
  AddInfo( "angrox",
	   "Das ist doch dieser Gebirgszwerg, oder? Soll ziemlich nett sein, "+
	   "war aber leider auch noch nicht da. Vielleicht kommt er ja mal "+
	   "vorbei.", "sagt: ");
  AddInfo( "feyaria",
	   "Ja, die war schon da. Hat sich die Speisekarte angeschaut und "+
	   "dann ist sie wieder gegangen.", "sagt: ");
  AddInfo( "eros", 
	   "Eros... der Goetterbote... nein, ich kenn ihn leider nicht "+
	   "privat.", "ueberlegt: ");
  AddInfo( "sargola",
      "Jaja, der Sargola... Das ist doch der, der immer soviele Fehler im "+
      "Raum-Zeit-Gefuege produziert, oder?", "fragt: ");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  NPC_MASTER->hilferuf(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}





