/*********************

Muaddib@SL
QuestNPC fuer die Insel der sieben Winde

*********************/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../def.h"

#pragma strong types;

#define BSA(x,y) break_string(x,78,y)

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Wanderer");
  SetProp(P_LONG, BS("Der Wanderer zwischen den Welten sieht alt aus. Er hat "+
                "ein vom Wetter gegerbtes Gesicht und schneeweisse Haare. "+
                "Seine Kleidung ist scheinbar einfach, jedoch erkennst Du, "+
                "dass es sich um die allerfeinsten Stoffe handelt. Er traegt "+
                "nur einen Stock bei sich.\n"));
  SetProp(P_NAME, "Wanderer");
  SetProp(P_GENDER, MALE);
  AddId(({"wanderer"}));
  SetProp(P_LOG_INFO, 1);
  SetProp(P_ALIGN, 700);
  SetProp(P_RACE, "Elf");
  SetProp(P_DEFAULT_INFO, "sagt: So etwas hab ich noch nie gehoert.\n");
  SetProp(P_NOATTACK, 1);

  AddInfo(({"hilfe", "aufgabe"}), "Frag Muaddib mal danach, der wollte "+
        "irgendwas machen, aber ich weiss noch nicht was.\n", "sagt: ");
  AddInfo("muaddib", "Muaddib? Er wird mit der Zeit weiser. Allerdings sehe "+
      "ich ihn selten hier.\n", "seufzt: ");
  AddInfo("insel", "Die Insel der sieben Winde? Tja, keiner weiss, wo diese "+
      "Insel liegt, geschweige denn, ob sie wirklich existiert. Man munkelt, "+
      "dass das Portal der Weisheit dorthin fuehrt. Dazu muesste aber erst "+
      "mal irgendjemand das Portal aktivieren...\n", "gruebelt: ");
  AddInfo("portal", "Das Portal der Weisheit ist nur von wirklich geeigneten "+
      "Personen aktivierbar. Die Aktivierung passiert nicht in unserer Zeit- "+
      "und Raumebene, daher ist es nicht ungefaehrlich, diese zu versuchen. "+
      "Ob Du wohl dafuer geeignet bist?", "sagt: ");
  AddInfo("eignung", "Geeignet bist Du, wenn Du es ueberlebst.", "sagt: "); 
  AddInfo("personen", "Der Wanderer mustert Dich eigentuemlich.\n");
  AddInfo("weisheit", "Es soll eine Gilde auf der Insel der sieben Winde "+
        "geben, die das Portal der Weisheit aufgestellt hat. Aber niemand "+
        "hat bisher eindeutig belegen koennen, dass es die Insel, die Gilde "+
        "und das Portal gibt.\n", "fluestert: ");
  AddInfo("gilde", "Darueber kann ich nichts genaues sagen, ausser, dass man "+
        "den Namen der Gilde nicht laut sagen soll, wenn man nicht grosses "+
        "Unheil auf sich lenken will. Der Sage nach sind die "+
        "Gildenmitglieder geistaehnliche Gestalten, die mit schwarzen "+
        "Schwertern und Magie kaempfen...\n", "fluestert: ");
  AddInfo(({"name", "namen", "unheil", "sage", "gildenmitglieder", "schwerter",
        "magie"}), "Schweig jetzt lieber...\n", "beschwoert Dich: ");
}

