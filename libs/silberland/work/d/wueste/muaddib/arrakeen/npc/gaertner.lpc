/*
** Gaertner im Park des Herzogs
**
** by Muaddib@SilberLand
**
*/

inherit "std/mnpc";

//#define MASTER "/d/wueste/muaddib/arrakeen/npc/bashar.lpc"
#define WATER "/d/wueste/muaddib/arrakeen/npc/water_master.lpc"

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include <mnpc.h>

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  create_default_npc(10); 
  SetProp(P_SHORT, "Ein Gaertner");
  SetProp(P_LONG, BS("Der Gaertner scheint schon lange Zeit zu arbeiten, "+
		     "trotzdem merkt man ihm seine Muedigkeit nicht an. "+
		     "Sein Gesicht ist ausgemergelt und seine Haut zeigt "+
		     "Spuren der anhaltenden Hitze.\n"));
  SetProp(P_NAME, "Gaertner");
  SetProp(P_GENDER, MALE);
  AddId("gaertner");
  SetProp(P_MSGIN, "kommt bei der Suche nach Arbeit herein");
  SetProp(P_ALIGN, 100);
  SetProp(P_RACE, "Nomade");
  SetProp(P_SIZE, 170);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15, T_RANGE_MAX:50]));
  
  SUID;
  CLONEME(WEAPON "gartenschere");
  command("zuecke gartenschere");

  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Der Gaertner bedankt sich und widmet sich wieder seiner Arbeit.\n"}));
  AddInfo(DEFAULT_INFO, "Lass mich weiterarbeiten, davon weiss "+
	  "ich nichts.\n", "sagt: ");

  SetProp(P_MNPC_AREA, ({ROOM "room_d7", ROOM "room_e7", ROOM "room_e8",
			   ROOM "room_c7", ROOM "room_c8"}));
  SetProp(P_MNPC_DEFAULTROOM, "room_d7");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_OUTDOORS+MOV_MOVES);

}




