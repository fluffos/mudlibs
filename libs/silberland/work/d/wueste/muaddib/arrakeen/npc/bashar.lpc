#pragma strong types;

#include <properties.h>
#include <language.h>
#include "../def.h"

object *wachen;
object *feinde;

void create()
{
  if (is_clone(this_object())) 
    return;
  wachen = ({ });
  feinde = ({ });
}

void hilferuf(object spieler)
{
  int u;
  if( member( feinde, spieler) == -1 )
  {
    feinde+=({spieler});
    domainshout("Der Bashar ruft: "+spieler->Name()+" greift uns an!\n",
                "+wueste/muaddib/arrakeen/room",1);
        
  }
}

void zeige_wachen()
{
  int i;
  object *ob;
  ob = wachen;
  for (i=sizeof(ob)-1;i<=0;i--)
    {
      tell_object(find_living("muaddib"), wachen[i]+"\n");
    }
}

void add_wache()
{

    wachen += ({ previous_object() });
}

void remove_wache()
{

    wachen -= ({ previous_object() });
}

int IsFeind(object enemy)
{
  if( member(feinde, enemy)!=-1 )
    return 1;
  else
    return 0;
}

void reset()
{
  feinde = ({ });
}





