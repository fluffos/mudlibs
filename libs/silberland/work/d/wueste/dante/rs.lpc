//einbauen, dass die gegenrichtung angezeigt wird
       
       object g;
 
 int i;
 string *list;
 mapping exits;

  init()
  {
  ::init();
   if(present("runenharnisch",environment( TO))||present("rune", environment(TO)))                                 
   {
   command("nimm alles");
   command("zieh harnisch an");
   }
 }
 
 
   
void create()
{


   
  if (!is_clone(TO)) return;
  ::create();

g=find_living("gott");


  SetProp(P_SHORT, "Ein Runenmann (II.Grad-Werfer)");
  SetProp(P_LONG, BS(
  "Das ist einer der beruechtigten Runenmaenner. Sie leben in dieser Burg "
  "und haben ihr Leben der Magie der Runen geweiht. Ihr oberster Lehrherr ist der "
  "Meister der Runen, der ueber unvorstellbare magische "
  "Kraefte verfuegen soll. Dieser Runenmann allerdings ist noch in Ausbildung, doch schon deutlich "
  "staerker als die Runenmaenner I.Grades. Genauer gesagt gehoert er zu den "
  "Werfern. Sie schleudern Runen um sich und koennen damit auch ueber weitere "
  "Entfernungen treffen."));
  
  SetProp(P_NAME,"Runenmann");
  SP(P_NAME_ADJ, "zweitgradig");
  SetProp(P_GENDER, MALE);
  AddId(({"NOWIMPY", "Runenmann","mann","runenmann", "runenwerfer","werfer"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit einer starken Runenformel",200,DT_MAGIC}));
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN,  0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Umhang scheint interessant zu sein.\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht ploetzlich auf");
  SetProp(P_MMSGOUT, "verschwindet");
  
  SetProp(P_DIE_MSG,  " bruellt irgendeine Runenformel! Umsonst! Er stirbt!\n");
  
  
  
  SUID;
  CLONEME(FA"ruho");
  CLONEME(FA"run");
  command("ziehe alles an");
  
  AddInfo(DEFAULT_INFO, "sagt: TZhfdnpo HjudnH!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Runenmann damit?!\n" }) );
AddInfo(({"rune","runen"}),
"Die Runen haben gewaltige Magie, aber es dauert viele Jahre bis man sie "
"nuetzen kann.", "sagt: ");
AddInfo(({"umhang","runenumhang"}),
"Der Umhang weist Dich als Mitglied der Runenmaenner aus.", "sagt: ");
AddInfo(({"runnenmann","runnenmaenner"}),
"Ich bin einer davon, im II.Grad!", "sagt: ");

  SetProp(P_SPELLRATE,70);
  
  AddSpell(4,300,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,300,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,300,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,400,
    "Der Runenmann haelt Dir eine Eisrune unter die Nase.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann haelt @WEM eine Eisrune unter die Nase.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,500,
    "Der Runenmann zerbricht eine Sturmrune ueber Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann zerbricht eine Sturmrune ueber @WEM.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));


  AddSpell(1,100,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann haelt Dir eine Eisrune unter die Nase.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann haelt @WEM eine Eisrune unter die Nase.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann zerbricht eine Sturmrune ueber Dir.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann zerbricht eine Sturmrune ueber @WEM.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

   SetChats(5,({
   "Der Runenmann sagt: Verschwinde!\n",
   "Der Runenmann bruellt Dich an!\n",
   "Der Runenmann bedraengt Dich!\n",
   "Der Runenmann sagt: Was willst Du!?\n",
   "Der Runenmann dreht sich kurz weg.\n",
   "Der Runenmann lacht Dich aus.\n"}));
   
  
  
// RMASTER->add_mann();
  
  
  set_heart_beat(1);
  
  
  }
 
 
   heart_beat()  {
	
        list=TO->QueryEnemies();
   
  if (pointerp(list) && environment(TO) && sizeof(list) )   {
  	
    list=list[0]; //wir hatten ja ein array von 2 arrays!!!
    
    if(sizeof(list) ) {
    for(i=sizeof(list)-1 ; i>=0;i--)  {

      if (objectp(list[i])) {
	if(g)  {
	 tell_object(g,
	 "Feind "+(i+1)+": "+CAP(getuid(list[i]))+"\n"); 
                }  }}
   	
    exits = (mapping)environment(TO)->QueryProp(P_EXITS);
    if (!mappingp(exits))
    exits = ([ ]);
    walk_mapping(exits, "runen_wurf", this_object());
      
                                            }
                  }		
}



runen_wurf(dir, dest)
{
   object *all;
  
   
   if(!sizeof(list)) {
	if(g)  {
	 tell_object(g,
	 "LEER!!!!!\n"); 
	} }
	
   all = all_inventory(find_object(dest));
   
   if (sizeof(all)) {
      for (i=0; i<sizeof(all); i++)      {
       
        if(  interactive(all[i]) )  {
        	
          if(member_array(all[i], list)!=-1 )  {

	if(g)  {
	 tell_object(g,
	 "RW:Feind "+(i+1)+": "+all[i]->Name(WER)+"\n"
	 "dir: "+dir+" dest: "+dest+"\n");
	}
	
  tell_room(environment(TO), BS(
 "Der Runenmann zueckt eine Rune, holt aus "
 "und schleudert sie nach "+CAP(dir)+"."));  

 /*  tell_room(dest, "Ein Runenmann schleudert eine Rune von "
   " "+CAP(woher)+" hierher!\n");
   */
   
      tell_object(all[i],
      "Die Rune fliegt direkt auf Dich zu.\n");
     
     all[i]->Defend(200, DT_MAGIC, 
 ([SP_SHOW_DAMAGE:1,SP_NAME:"Ein Runenwurf"]), this_object());                                        }
                              
            }                                        
                                        
                               	}
                         }
                     }    
 






