inherit "std/tool";

#pragma strong_types;

#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include <combat.h>
#include <properties.h>
#include <wizlevels.h>

#define HARD_LIMIT 250
#define TMI(x) if (find_player("iwo")) tell_object(find_player("iwo"), break_string(x, 78, "EGGEVENT: "))

// Globals
object *birds = ({});
object *eggs  = ({});

int nuke_em_all = 0;
int event       = 0;

int num_birds   = 0;

void create()
{
  if (is_clone(this_object())) return;

  SetProp(P_NAME, "Eggeventmaster");
  SetProp(P_SHORT, "The Eggeventmaster");

  ME->move("/players/iwo/workroom", M_NOCHECK);
}


int Limit()
{
  TMI(sprintf("Birds/Eggs: %d/%d", sizeof(birds), sizeof(eggs)));

  if (sizeof(birds) + sizeof(eggs) > HARD_LIMIT)
    {
      TMI("Hard Limit reached!");
      nuke_em_all = 1;
      event = 0;
      return 1;
    }
  return 0;
}




void BirdBorn(object bird)
{
  if (nuke_em_all || !event)
    {
      previous_object()->remove();
      return;
    }

  if (member(birds, bird)==-1)
    birds += ({ bird });

  Limit();

  return;
}


void EggDropped(object egg)
{
  if (nuke_em_all || !event)
    {
      previous_object()->remove();
      return;
    }

  if (member(eggs, egg)==-1)
    eggs += ({ egg });

  Limit();

  return;
}


int LimitReached()
{
  if (nuke_em_all) return 1;
  if (sizeof(birds) >= num_birds) return 1;

  return sizeof(birds) + sizeof(eggs) >= HARD_LIMIT;
}

int QueryEvent()
{
  return event;
}

int SetEvent()
{
  event = 1;
}

int PrepareEvent(int birds)
{
  if (!IS_ARCH(TP) && getuid(TP)!= "iwo")
    {
      TMI("Stupid!");
      return 0;
    }

  num_birds = birds > HARD_LIMIT ? HARD_LIMIT : birds;

  event = 1;

  return num_birds;
}
