#include "/secure/wizlevels.h"
#include <properties.h>
#include <language.h>
#include <config.h>
#include <mnpc.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../rabbit.h"
 
object *rabbit_array=({ });
mapping rabbit_map=([]);
mapping kills_by_players=([ ]);
int count = 0;
int lastnotify = 0;
int killall = 1;
int event_in_progress, solved, armageddon; 
int last_amount_check;
int wait, delay;

create() {
  if (is_clone(this_object())) {
    destruct(this_object());


  SetProp(P_NAME, "Karnickelmaster");

  SetProp(P_INVIS, 1);

  SetProp(P_INT_SHORT, "Karnickelmaseter");

    return 1;
  } 
  seteuid(getuid(this_object())); 
}

query_prevent_shadow() { return 1; }

nosave void Channel(string msg) {
  CHMASTER->join("Event",TO);
  CHMASTER->send("Event",TO,msg,MSG_SAY);
}      


string name()
  {
  return "Elsurion";
  }



int armageddon()
{
 Channel("Ein Karnickelarmageddon wurde ausgeloest.");
 armageddon = 1;
}


varargs int StartRabbitEvent()
{
  int i;
  object hr,nr1,nr2;

  if(event_in_progress == 1) return -1;
  kills_by_players=([]);
  call_out("EndIsNear", (DAUER-1)*60);
  event_in_progress=1;
  solved=0;
  tell_iwo("Maximale Anzahl von Karnickel: "+MAXRABBITS+"\n");
  tell_iwo("Dauer des Events: "+DAUER+" Minute(n)!\n");
  tell_angrox("Maximale Anzahl von Karnickel: "+MAXRABBITS+"\n");
  tell_angrox("Dauer des Events: "+DAUER+" Minute(n)!\n");

  call_out("SendStartText", 40);
  return 1;
} 



int geburtenkontrolle(object rabbit)
    {
    int num_karnickel;

    num_karnickel = sizeof(rabbit_map);

    /* iss nicht ganz sauber, aber schnell dafuer :-) */

    switch (num_karnickel)
        {
        case 0..20:
            delay = 20;
            break;
        case 21..40:
            delay = 40;
            break;
        case 41..80:
            delay = 80;
            break;
        case 81..160:
            delay = 160;
            break;

        default:
            delay = 250;
       }

    if (wait >= delay)
        {
        wait = 0;
        clone_object(EVENTRABBIT)->move(environment(rabbit), M_NOCHECK);
        }

    wait++;
    return 1;

    }





int rabbit_moved(object rabbit, string position, int gender)
    {
    
    int i;
    

    if (armageddon == 1)
      {
      rabbit->remove();
      return 0;
      }


    if (!member(rabbit_map, rabbit))
        {
	rabbit_map += ([rabbit: position; gender]);
	}

    rabbit_map[rabbit, 0] = position;

    rabbit_array = m_indices(rabbit_map);

	
    for (i = 0;	i < sizeof(rabbit_map); i++)
        {
	if((position == rabbit_map[rabbit_array[i], 0])
             && (gender =! rabbit_map[rabbit_array[i], 1]))
            {
	    /* Joessas, die wolln ferkeln ! */
            if (sizeof(rabbit_map) >= MAXRABBITS)
                {
                if (sizeof(rabbit_map) >= 200)
                  {
                    tell_iwo("**** MAXIMALE ANZAHL AN KARNICKEL UEBERSCHRITTEN. STARTE ARMAGEDDON ****\n");
                    tell_angrox("**** MAXIMALE ANZAHL AN KARNICKEL UEBERSCHRITTEN. STARTE ARMAGEDDON ****\n");
                    armageddon();
                    return 0;
                  }
                return 0;
                }
	    if((sizeof(rabbit_map) >= (lastnotify + 10)) ||
	       (sizeof(rabbit_map) <= (lastnotify - 10)))
	        {
                if (sizeof(rabbit_map) > SCHWELLE)
                  {
                    StartRabbitEvent();
                  }
		tell_iwo("* Anzahl Karnickel: " + sizeof(rabbit_map) + "\n");
		tell_angrox("* Anzahl Karnickel: " + sizeof(rabbit_map) + "\n");
                
		lastnotify = sizeof(rabbit_map);
		}
		
	    call_other(rabbit, "fuck");

            geburtenkontrolle(rabbit);

            return 1;
	    }    
	}
    return 1;

    }
    
int list_karnickel (object player)
{

    if(!IS_WIZARD(player) && getuid(player)!="iwo" )
        return 0;

    tell_object(player, "KarnickelMaster: Anzahl der Hasis: "
          + sizeof(rabbit_map) + "\n");


    tell_object(player, sprintf("%O\n", rabbit_map));

    return 1;
}
                        


mixed Score(int rabbits_left)
{
 int i,j, *a, *score;
 mapping scoret;
 string *b;
 scoret=([]);
 score=({});
 a=({});
 b=({});
 if(member(kills_by_players, "EVENT"))
   kills_by_players=m_delete(kills_by_players, "EVENT");
 b=m_indices(kills_by_players);
 a=m_values(kills_by_players);
 for(i=0;i<=sizeof(kills_by_players)-1;i++)
   {
    if(member(scoret, a[i]))
      scoret[a[i]]+=({b[i]});
    else scoret+=([a[i]:({b[i]})]);
   }
 score=sort_array(m_indices(scoret), #'<); //')
 /*
 tell_object(find_player("angrox"), sprintf("Scoret: %O\n"
    +"Score:%O\nScoretable: %O\n\n", scoret, score, scoretable));
    */
return ({score, scoret});
}                  




ChannelAuswertung(int *scores0, mapping scores1)
{
 int anzahl,i,j;
 string msg, tabs;
 if(!scores0 || !scores1) return 0;
 if(!sizeof(scores0)) return 0;
 msg="";
 Channel("Die Besten unter euch waren:");
 if((sizeof(scores0))>10) anzahl=10;
 else anzahl=sizeof(scores0);
 for (i=0;i<=anzahl-1;i++)
   {
    for(j=0;j<=(sizeof(scores1[scores0[i]])-1);j++)
      {
       if (scores1[scores0[i]][j]=="GUILD.druidenzirkel")
           msg+=("Elementare, ");
       else msg+=(CAP(scores1[scores0[i]][j])+", ");
      }
    msg=msg+"\b\b";
    tabs=32-(strlen(msg));
    msg+=(sprintf("%*' 's: %d Karnickel",tabs,"",scores0[i]));
    Channel(msg);
    msg="";
   }       
}


int StopArmageddon()
{
  armageddon = 0;
}


Messages()
{
 int anzahl;
 string a,b,str;
 if(event_in_progress==0) return;
 if(last_amount_check<=10)
   {
    Channel("Ich habe die neuesten Berichte! Die Anzahl "
           +"der Karnickel ist seit dem letzten Bericht "
           +"fast auf NULL gesunken! DIE KARNICKELPLAGE IST "
           +"BEENDET!");
    solved=1;
    EndEvent();
    return;
   }
 anzahl=sizeof(rabbit_map); 
 switch(100*anzahl/last_amount_check)
   {
   case 0:        a="ist";
                  b="auf NULL gesunken! DIE KARNICKELPLAGE "
                   +"IST BEENDET!";
                  solved=1;     
                  EndEvent();
                  break; 
   case 1..20:    a="ist";
                  b="beinahe auf Null geschrumpft. Weiter so! "
                    +"Bald ist es geschafft!";
                  break;
   case 21..40:   a="ist";
                  b="auf etwa ein Viertel verringert. Gut so!";
                  break;
   case 41..60:   a="hat sich";
                  b="in etwa halbiert.";
                  break;
   case 61..80:   a="hat sich";
                  b="etwa um ein Viertel verringert.";
                  break;   
   case 81..120:  a="ist";
                  b="in etwa gleichgeblieben.";
                  break;
   case 121..140: a="ist";
                  b="etwa um ein Viertel gestiegen.";
                  break;
   case 141..160: a="ist";
                  b="etwa um die Haelfte gestiegen.";
                  break;
   case 161..180: a="hat sich";
                  b="etwa um drei Viertel erhoeht.";
                  break;
   case 181..220: a="hat sich";
                  b="etwa verdoppelt. Ihr muesst SCHNELLER handeln!";
                  break;
   case 221..240: a="ist";
                  b="etwa um das Eineinviertelfache gestiegen.";
                  break;
   case 241..260: a="ist";
                  b="etwa um einhundertfuenfzig Prozent gestiegen.";
                  break;
   case 261..280: a="hat sich";
                  b="etwa um sieben Viertel erhoeht.";
                  break;
   case 281..320: a="hat sich";
                  b="etwa VERDREIFACHT!!!!";
                  break;
   default:       a="hat sich";
                  b="mehr als VERDREIFACHT!! WARUM TUT IHR NICHTS?!?";
                  break;
   } 
  str="Ich habe die neuesten Berichte! Die Anzahl der Karnickel "+a
     +" seit der letzten Meldung "+b+" Absolut gesehen ";
  switch(100*GetAmount()/(MAXRABBITS))
    {
    case 0..15:  str+="sind fast ueberhaupt keine Karnickel mehr vorhanden.";
                 break;
    case 16..30: str+="sind nur mehr ein paar Karnickel da.";
                 break;
    case 31..45: str+="hoppeln noch etliche Karnickel um ihr Leben.";
                 break;
    case 46..55:  str+="sind viele Karnickel am Leben.";
                 break;
    case 56..70: str+="hoppeln SEHR viele Karnickel herum.";
                 break;
    case 71..85: str+="sind EXTREM viele von Biestern unterwegs!!!!";
                 break;
    case 86..100: str+="hoppelt eine UNGLAUBLICH HOHE Anzahl von "
                      +"diesen kleinen Biestern herum!!!!!!";
                 break;    
    default:     str+="sind eine undefinierbare Anzahl Karnickel da.";
                 break;
    }
  Channel(str);
  last_amount_check=anzahl;
  call_out("Messages",120);
} 






int EndEvent() {
  mixed score;
  if(find_call_out("Messages"))
    remove_call_out("Messages");
  if(find_call_out("EndEvent"))
    remove_call_out("EndEvent");
  if(find_call_out("EndIsNear"))
    remove_call_out("EndIsNear");
  if(!solved)
  Channel("Ihr habt es NICHT geschafft alle Karnickel zu toeten! "
         +"Eine SCHWACHE Leistung! Aber immerhin konntet ihr "
         +"das Allerschlimmste verhindern.");
  event_in_progress=0;
  score=Score(sizeof(rabbit_map));
  armageddon();
  call_out("ChannelAuswertung", 1, score[0],score[1]);
  call_out("StopArmageddon", 240);
  //call_other(RABBITLOGMASTER, "AddStats", score[0],score[1]);
  return 1;
}        

EndIsNear() {
  Channel("Noch EINE Minute bis zum Ende des Events!");
  call_out("EndEvent", 60);
}    



int RemoveRabbit(object rabbit)
{
  if(member(rabbit_map, rabbit)==-1) return -1;
  rabbit_map-=([rabbit]);
  return 1;
}      


nosave int LogKill(string player)
{
  if(member(kills_by_players, player)==0)
     kills_by_players+=([player:0]);
  kills_by_players[player]=kills_by_players[player]+1;
  return 1;
}

int KillRabbit(object rabbit, object player)
{
  if(member(rabbit_map, rabbit)==-1) return -1;
  rabbit_map-=([rabbit]);
  LogKill(getuid(player));
  return 1;
}                             

mapping GetKills()
{
  return kills_by_players;
}

mixed GetRabbits()
{
 return rabbit_array;
}

mixed GetAmount()
{
 return sizeof(rabbit_array);
}              


void SendStartText(string wo) 
{
  Channel("Ein Reisender berichtete soeben von einer sich ausbreitender " 
         +"Karnickelplage! Alle Wehrfaehigen muessen dieser " 
         +"Plage unbedingt Einhalt gebieten, da ansonsten ein grosser " 
         +"Teil des SilberLandes von den Karnickeln kahlgefressen wird !"); 
  call_out("Messages", 60); 
  last_amount_check=sizeof(rabbit_array);
}

