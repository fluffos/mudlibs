
inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../rabbit.h"


int cannot_fuck = FUCKDELAY;
int gender = MALE;
int wurfdelay = WURFDELAY;
int schwanger = 0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"karnickel", RABBITID}));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_SEX, MALE);
  SetProp (P_NAME, "Karnickel");
  SetProp (P_SHORT, "Ein Karnickel");
  SetProp (P_LONG,
           "Ui, ein kleines, suesses Karnickel. Es blickt Dich mit "
          +"mit zwei grossen Augen herzig an, die fast unter den zwei "
          +"weichen Schlappohren verschwinden.\n"
          +"So einem kleinem, unschuldigen Karnickel koenntest Du "
          +"niemals etwas antun. Sein Pappa ist Angrox und seine "
	  +"Mama ist Iwo.");
  SetProp (P_ALIGN, 0);
  create_default_npc(1);
  SetProp (P_SIZE, 30);
  SetProp (P_MAX_HP, random(10)+5);
  SetProp (P_WIMPY, QueryProp(P_MAX_HP)-5);
  SetProp (P_HP, QueryProp(P_MAX_HP));
  SetProp (P_WEIGHT, 2000);
  SetProp (P_RACE, "Karnickel");
  SetProp (P_MAX_HANDS, 2);


  switch(random(11)) {
    case 1..5: SetProp(P_CORPSE, "/obj/money"); break;
    case 6..8: SetProp(P_CORPSE, "/p/magic/magiestein"); break;
    case 9..10: SetProp(P_CORPSE, "/p/std/dragons/obj/schuppe"); break;
  }


  SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT);
  SetProp (P_XP, 0);
  SetProp (P_DIE_MSG, " blickt Dich noch einmal traurig an und stirbt.\n");
  SetProp (P_HANDS, ({" mit kleinen Pfoetchen", 10, DT_BLUDGEON}) );
  SetProp (P_MNPC_AREA, "/d/");
  SetProp (P_MNPC_WAIT, ({5, random(4)+2, random(3)+1}));
  SetProp (P_MNPC_DEFAULTROOM, ENV(ME));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+
                         MOV_INFIGHT+MOV_INDOORS+MOV_MAYLOAD+MOV_SPECIAL);
  SetProp(P_MSGIN, "hoppelt herein");
  SetProp(P_MSGOUT, "hoppelt nach");
  SetProp(P_MMSGIN, "hoppelt herein");
  SetProp(P_MMSGOUT, "hoppelt nach");
  SetProp(P_HB, 1);

  genderchange();


}


int genderchange()
{
  gender = random(2) + 1;


 SetProp(P_SEX, gender);
 return1 ;
}


int wurf()
    {
    object ob;
    ob = clone_object(EVENTRABBIT);
    schwanger = 0;
    ob->move(environment(ME), M_NOCHECK);
    }




void init()
{
  
  ::init();

  call_other(RABBITMASTER, "rabbit_moved", 
      TO, file_name(environment(ME)), gender);

  if (cannot_fuck > 0) cannot_fuck--;
  if (wurfdelay > 0) wurfdelay--;
  if (schwanger == 1 && wurfdelay >= 0) wurf();
  return 1;
}


int fuck()
{

  if (cannot_fuck > 0 || gender == MALE) return 0;
  
  tell_room(environment(ME), BS("Das Karnickel besteigt ein anderes und "
                                "rammelt froehlich vor sich hin."));

  schwanger = 1; wurfdelay = WURFDELAY; cannot_fuck = FUCKDELAY;
  return 1;
				
}





void die(int poisondeath)
{
  call_other(RABBITMASTER, "KillRabbit", ME, TP);
  ::die(poisondeath);
  return;
}

