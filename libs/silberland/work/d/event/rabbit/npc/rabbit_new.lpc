inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../rabbit.h"


nosave int befruchtet=0;
nosave object father;
nosave int erschoepfung=0;
nosave int zeugung=1;
nosave int zeit;
nosave int my_sex=MALE;
nosave int gen=1;
nosave mapping reward;

int Zeugung();
int VersucheZeugung();
int query_sex();
int is_rabbit();
int is_ready_female_rabbit();

#define ta(x) if(find_player("angrox")) tell_object(find_player("angrox"),x)

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  reward=([ "\ngeld": "/obj/money",
          "\nmagiestein": "/p/magic/magiestein",
          "\nschupp": "/p/std/dragons/obj/schuppe"]);
  AddId (({"karnickel", RABBITID}));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_NAME, "Karnickel");
  SetProp (P_SHORT, "Ein Karnickel");
  SetProp (P_LONG,
           "Ui, ein kleines, suesses Karnickel. Es blickt Dich mit "
          +"mit zwei grossen Augen herzig an, die fast unter den zwei "
          +"weichen Schlappohren verschwinden.\n"
          +"                 ,                \n"
          +"                /|                \n"
          +"               / |   ,-~ /        \n"
          +"              Y :|  //  /         \n"
          +"              | jj /( .^          \n"
          +"              >-\"~\"-v\"            \n"
          +"             /       Y            \n"
          +"            jo  o    |            \n"
          +"           ( ~T~     j            \n"
          +"            >._-' _./             \n"
          +"           /   \"~\"  |             \n"
          +"          Y     _,  |             \n"
          +"         /| ;-\"~ _  l             \n"
          +"        / l/ ,-\"~    \\            \n"
          +"       \\//\\/       .- \\           \n"
          +"         Y        /    Y          \n"
          +"         l       I     !          \n"
          +"         ]\\      _\\    /\"\\        \n"
          +"        (\" ~----( ~   Y.  )       \n"
          +"    ~~~~~~~~~~~~~~~~~~~~~~~~~~    \n"
          +"So einem kleinem, unschuldigen Karnickel koenntest Du "
          +"niemals etwas antun.");
  SetProp (P_ALIGN, 0);
  create_default_npc(1);
  SetProp (P_SIZE, 30);
  SetProp (P_MAX_HP, random(10)+5);
  SetProp (P_WIMPY, QueryProp(P_MAX_HP)-5);
  SetProp (P_HP, QueryProp(P_MAX_HP));
  SetProp (P_WEIGHT, 2000);
  SetProp (P_RACE, "kaninchen");
  SetProp (P_MAX_HANDS, 2);
  SetProp(P_CORPSE, 0);
  SetProp (P_XP, 0);
  SetProp (P_DIE_MSG, " blickt Dich noch einmal traurig an und stirbt.\n");
  SetProp (P_HANDS, ({" mit kleinen Pfoetchen", 10, DT_BLUDGEON}) );
  SetProp (P_MNPC_AREA, "/");
  SetProp (P_MNPC_WAIT, ({3, random(6)+2, random(6)+2}));
  SetProp (P_MNPC_DEFAULTROOM, ENV(ME));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS|MOV_MOVES|MOV_BACKWARDS|
                         MOV_INFIGHT|MOV_INDOORS|MOV_MAYLOAD);
  SetProp(P_MSGIN, "hoppelt herein");
  SetProp(P_MSGOUT, "hoppelt nach");
  SetProp(P_MMSGIN, "hoppelt herein");
  SetProp(P_MMSGOUT, "hoppelt nach");
}

void set_sex(int sex)
{
 my_sex=sex;
 if (sex==MALE)
   {
    SetProp(P_MSGIN, "hoppelt herein und schaut sich "
                    +"nach einem Weibchen um");
    SetProp(P_MSGOUT, "sucht ein Weibchen und hoppelt");
    SetProp(P_MMSGIN, "hoppelt herein und schaut sich nach "
                    +"einem Weibchen um");
    SetProp(P_MMSGOUT, "sucht ein Weibchen und hoppelt");
   }
 else 
   {
    SetProp(P_MSGIN, "hoppelt herein und schaut sich nach "
                    +"einem Maennchen um");
    SetProp(P_MSGOUT, "sucht ein Maennchen und hoppelt");
    SetProp(P_MMSGIN, "hoppelt herein und schaut sich nach "
                     +"einem Maennchen um");
    SetProp(P_MMSGOUT, "sucht ein Maennchen und hoppelt");
   }
}


int Zeugung()
{
 if(befruchtet) return 0;
 if(my_sex!=FEMALE) return 0;
 befruchtet=time();
 RemoveId("READYFEMALE");
 //TELL("angrox", "FEMALE -> befruchtet!\n");
 return 1;
}

int VersucheZeugung() {
  object *rab, female;
  int size;
  rab=filter_objects(all_inventory(ENV(ME)), "id", "READYFEMALE");
  if(!sizeof(rab)) return 0;
  female=rab[random(sizeof(rab))];
  female->Zeugung();
  erschoepfung=time()+2;
  return 1;
}


int query_sex() {
  return my_sex; 
}

int is_rabbit() {
  return 1; 
}


int set_exhausted(int x) {
  erschoepfung=x; 
  return 1;
}

void die(int poisondeath)
{
  string rew;
  object ob;
  call_other(RABBITMASTER, "KillRabbit", ME, QueryProp(P_KILLER));
  
  switch(random(38)) {
    case 0..30 : break;
    case 31..35: rew="\ngeld"; break;
    case 36: rew="\nmagiestein"; break;
    case 37: rew="\nschupp"; break;
  }
  if(rew) {
    if(ob=present(rew, ENV(ME))) {
      ob->AddAmount(1);
    }
    else {
      ob=clone_object(reward[rew]);
      ob->move(ENV(ME), M_NOCHECK);
    }
  }
  ::die(poisondeath);
  return;
}


void remove()
{
 call_other(RABBITMASTER, "RemoveRabbit", ME);
 ::remove();
 return ;
}

void AddGen(int parent_gen)
{
  gen=parent_gen+1;
  return ;
}

void SetLevel(int x) {
  create_default_npc(x);
  return ;
}

varargs int move(mixed dest, int method, string dir, string textout, 
    string textin)
{
  int suc;
  object back;
  suc=::move(dest,method,dir,textout,textin);
  if(suc != 1)
    return suc;
  if(!call_other(RABBITMASTER, "CheckCloneAllowed"))
    return suc;
  // Maennliche Karnickel
  if(my_sex==MALE && erschoepfung < time()) {
    //TELL("angrox", sprintf( "MALE -> VersucheZeugung! %O\n", ME));
    call_out("VersucheZeugung", 0);
    return suc;
  }
  // Weibliche Karnickel
  if(my_sex==FEMALE && (befruchtet+4) >= time())
  {
    back=call_other(RABBITMASTER, "CloneRabbit", gen);     
    if(objectp(back)) {
      //TELL("angrox", "NEUES KARNICKEL!\n");
      back->move(ENV(ME), M_GO, "","wird geworfen", "wird geworfen");  
    }
    AddId("READYFEMALE");
    befruchtet=0; 
  } 
}

void move_random(string region) {
  mapping ex;
  string *_exits;
  string choosen;
  
  ex=ENV(ME)->QueryProp(P_EXITS);
  if(!sizeof(ex)) return;
  _exits=m_indices(ex);
  choosen=_exits[random(sizeof(_exits))];
  if(strstr(ex[choosen], region) != 0)
    return ;
  move(ex[choosen], M_GO, CAP(choosen), QueryProp(P_MSGOUT), 
      QueryProp(P_MSGIN));
  return ;
}
