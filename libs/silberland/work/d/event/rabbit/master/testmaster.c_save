#include "/secure/wizlevels.h"
#include <properties.h>
#include <language.h>
#include <config.h>
#include <mnpc.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../rabbit.h"
 
static mapping rabbit_map=([ ]);
static mapping kills_by_players=([ ]);
static int max_rabbits;
static int event_in_progress, last_amount_check, solved;
static int last_gender=MALE;
static string region;
static int max_gen=1;

int create() {
  if (is_clone(this_object())) {
    destruct(this_object());
    return 1;
  } 
  seteuid(getuid(this_object())); 
}

int CloneRabbitForStart(object room)
{
  object ob;
  if (!room) return 0;
  ob=clone_object(RABBITS_NEW);
  if(last_gender==0) last_gender=MALE;
  if(last_gender==MALE) 
  {
    ob->set_sex(FEMALE);
    last_gender=FEMALE;
  }
  else 
  {
    ob->set_sex(MALE);
    last_gender=MALE;
  }
  if(!region) region="/";
  rabbit_map+=([file_name(ob):time()+random(5)]);
  ob->set_exhausted(time()+6);
  ob->move(room, M_GO);
  return 1;
}

int move_rabbits() {
  int i;
  string *rab;
  object rabbit;
  rab=m_indices(rabbit_map);
  TELL("angrox", sprintf("ANZAHL KARNICKEL: %d\n", sizeof(rab)));
  for(i=sizeof(rab)-1; i>=0;i--) {
    if(!rab[i]) {
      TELL("angrox", sprintf("RABBIT: falsches rab[i] = %O\n", rab[i]));
    }
    if(catch(rabbit=find_object(rab[i]))) {
      TELL("angrox", sprintf("FEHLER RABBIT! rab[i]= %s, i= %d, sizeof(rab) = %d\n", rab[i], i, sizeof(rab)));
      TELL("angrox", sprintf("rab[i-1]= %s\n", rab[i-1]));
      break;
    }
    if(!objectp(rabbit)) {
      rabbit_map=m_delete(rabbit_map, rab[i]);
      continue;
    }
    if(rabbit_map[rab[i]] <= time()) {
      rabbit->move_random();
      rabbit_map[rab[i]]=time()+(random(4)*2);
    }
  }
  call_out("move_rabbits", 2);
}

/*
//  1 ... Rabbit wird geclont
//  0 ... Max Anzahl erreicht
// -1 ... Eltern sind nicht eingetragen oder 
          vater==mutter
*/
mixed CloneRabbit(int parent_gen)
{
  object ob;
  int lvl;
  if(!max_rabbits) max_rabbits=DEFAULT_RABBIT_AMOUNT;
  if(sizeof(rabbit_map)>max_rabbits) return 0;
  ob=CLONEOB(RABBITS_NEW);
  if(last_gender==0) last_gender=MALE;
  if(last_gender==MALE) 
  {
    ob->set_sex(FEMALE);
    last_gender=FEMALE;
  }
  else 
  {
    ob->set_sex(MALE);
    last_gender=MALE;
  }
  ob->set_exhausted(time()+6);
  if((parent_gen+1) > max_gen)
    max_gen=parent_gen+1;
  ob->AddGen(parent_gen);
  if(!random(4)) {
    lvl=ob->QueryProp(P_LEVEL)+1;
    ob->SetLevel(lvl<=10?lvl:10);
  }
  rabbit_map+=([file_name(ob):time()+random(10)]);

  return ob;
}

mixed test123() {
  return rabbit_map;
}
