#include "/secure/wizlevels.h"
#include <properties.h>
#include <language.h>
#include <config.h>
#include <mnpc.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../rabbit.h"
 
nosave string *rabbit_arr=({});
nosave int    *time_arry=({});
nosave mapping kills_by_players=([ ]);
nosave int max_rabbits;
nosave int event_in_progress, last_amount_check, solved;
nosave int last_gender=MALE;
nosave string region;
nosave int max_gen=1;

int create() {
  if (is_clone(this_object())) {
    destruct(this_object());
    return 1;
  } 
  seteuid(getuid(this_object())); 
}

int CloneRabbitForStart(object room)
{
  object ob;
  if (!room) return 0;
  ob=clone_object(RABBITS_NEW);
  if(last_gender==0) last_gender=MALE;
  if(last_gender==MALE) 
  {
    ob->set_sex(FEMALE);
    last_gender=FEMALE;
  }
  else 
  {
    ob->set_sex(MALE);
    last_gender=MALE;
  }
  if(!region) region="/";
  rabbit_arr+=({ implode( ({ file_name(ob), to_string(time()+random(5)) }), 
        "!!!") });
  ob->set_exhausted(time()+6);
  ob->move(room, M_GO);
  return 1;
}

int move_rabbits() {
  int i;
  mixed div;
  string *to_del;
  object rabbit;
  to_del=({});
  TELL("angrox", sprintf("RABBIT ANZAHL: %d\n", sizeof(rabbit_arr)));
  for(i=sizeof(rabbit_arr)-1; i>=0;i--) {
    div=explode(rabbit_arr[i], "!!!");
    rabbit=find_object(div[0]);
    if(!objectp(rabbit)) {
      to_del+=({ rabbit_arr[i] });
      continue;
    }
    if(to_int(div[1]) <= time()) {
      rabbit->move_random();
      rabbit_arr[i]=implode( ({to_string(div[0]), to_string(time()+(random(4)*2))}), "!!!");
    }
  }
  for(i=sizeof(to_del)-1;i>=0;i--) {
    rabbit_arr-=({ to_del[i] });
  }
  call_out("move_rabbits", 2);
}

/*
//  1 ... Rabbit wird geclont
//  0 ... Max Anzahl erreicht
// -1 ... Eltern sind nicht eingetragen oder 
          vater==mutter
*/
mixed CloneRabbit(int parent_gen)
{
  object ob;
  int lvl;
  if(!max_rabbits) max_rabbits=DEFAULT_RABBIT_AMOUNT;
  ob=CLONEOB(RABBITS_NEW);
  if(last_gender==0) last_gender=MALE;
  if(last_gender==MALE) 
  {
    ob->set_sex(FEMALE);
    last_gender=FEMALE;
  }
  else 
  {
    ob->set_sex(MALE);
    last_gender=MALE;
  }
  ob->set_exhausted(time()+6);
  if((parent_gen+1) > max_gen)
    max_gen=parent_gen+1;
  ob->AddGen(parent_gen);
  if(!random(4)) {
    lvl=ob->QueryProp(P_LEVEL)+1;
    ob->SetLevel(lvl<=10?lvl:10);
  }
  rabbit_arr+=({ implode (({ file_name(ob), to_string(time()+random(5)) }), 
        "!!!")});

  return ob;
}

mixed test123() {
  return rabbit_arr;
}
