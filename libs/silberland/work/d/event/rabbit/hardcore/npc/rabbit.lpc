void init()
{
  int i;
  mixed back;
  ::init();
  zeit=time();
  if(zeug) return;
  ta(sprintf("RAB: INIT, PO: %O, TP: %O\n", PO, TP));
  zeug=1;
  if(befruchtet && zeit > erschoepfung && my_sex==FEMALE)
  {
    back=call_other(RABBITMASTER, "CloneRabbit", gen);     
    if(objectp(back)) {
      back->move(ENV(ME), M_GO, "","wird geworfen", "wird geworfen");  

    }
    erschoepfung=zeit+4;
    befruchtet=0; 
    zeug=0;
  } 
  if(my_sex==MALE && erschoepfung < zeit) 
    VersucheZeugung();
  call_out("remove_zeug", 0);
}

void remove_zeug() {
  zeug=0; 
}

int Zeugung(object partner)
{
 //ta("RAB: Zeugung()\n");
 if(befruchtet) return 0;
 if(my_sex!=FEMALE) return 0;
 if(partner->query_sex()!=MALE) return 0;
 befruchtet=1;
 erschoepfung=time()+6;
 father=partner;
 zeug=0;
 return 1;
}

int VersucheZeugung() {
  object *rab, ob, env;
  int size;
  env=ENV(ME);
  zeit=time();
  //ta("RAB: VersucheZeugung()\n");
  rab=filter_array(all_inventory(env), "is_female");
  rab-=({ME});
  rab-=({0});
  //ta(sprintf("RAB: %O\n",rab));
  size=sizeof(rab);
  if(!size || size>10) return 0;
  //if(size>5) rab=rab[0..4];
  erschoepfung=zeit+6;
  rab[random(size-1)]->Zeugung(ME);
  zeug=0;
  return 1;
}


int query_sex() {
  return my_sex; 
}

int is_rabbit() {
  return 1; 
}

int is_female(object ob) {
  if(ob->is_ready_female_rabbit()) return 1;
  return 0 ;
}

int is_ready_female_rabbit() {
  if(my_sex==FEMALE && !befruchtet && erschoepfung < time()) return 1;
  return 0;
}

int set_exhausted(int x) {
  erschoepfung=x; 
  return 1;
}

