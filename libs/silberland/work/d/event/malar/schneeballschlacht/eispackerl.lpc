 //12.12.2004 Typo entfernt - Malar
#include <moredef.h>
#include <moving.h>

inherit "std/thing";

#include <properties.h>

int ice;
string *sorte = ({"/d/polar/thor/xandim/obj/calippo",
		  "/d/polar/thor/xandim/obj/jolly",
		  "/d/polar/thor/xandim/obj/paiper",
		  "/d/polar/thor/xandim/obj/nogger",
		  "/d/polar/thor/xandim/obj/tschisi",
		  "/d/polar/thor/xandim/obj/twinni"});

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();
  ice = 15+random(5);

  SetProp(P_SHORT, "Eine Kartonschachtel");
  SetProp(P_LONG,
    "Du betrachtest die Schachtel eingehend und stellst fest, dass "
    "es sich wohl um eine Packung Eis handelt! Du kannst ja rein "
    "greifen." );
  SetProp(P_INFO, "Auf der Seite steht: 'Echtes Silberland Eis!'");
  SetProp(P_NAME, "Schachtel");
  SetProp(P_GENDER, MALE);
  AddId( ({"schachtel", "kartonschachtel", "\nsilvana_eis!"}) );

  SetProp(P_MATERIAL, MAT_CARTON );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);

  AddCmd( ({"greif", "greife"}), "take_ice");
}

int take_ice(string str)
{
  notify_fail("Wo willst Du hinein greifen?\n");
  if(!str || str == "") return 0;
  if(!(str == "in schachtel" ||
       str == "in karton" ||
       str == "in kartonschachtel" )) return 0;

  tell_object(this_player(), "Du greifst in die Schachtel und "
  "holst ein Eis daraus hervor.\n");

  tell_room(environment(this_player()), this_player()->Name(WER)+
  " greift in eine Schachtel und holt ein Eis daraus hervor.\n", ({this_player()}));

  clone_object(sorte[random(sizeof(sorte))])->move(this_player(), M_NOCHECK);
  
  if(!--ice)
  {
    tell_object(environment(this_object()), "Der Karton loest sich auf.\n");
    remove(0);
  }

  return 1;
}
