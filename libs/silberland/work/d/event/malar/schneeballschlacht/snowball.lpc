/*
 * Ein Schneeeeeeeeball! :)
 *
 * by Silvana@Silma (daniel.eder@kabsi.at)
 */
#include <moredef.h>

inherit "std/thing";

#include <properties.h>
#define MSG ({"Mitten ins Gesicht!\n",\
	     "Genau in den Bauch!\n",\
             "Direkt auf die Brust!\n",\
	     "Volltreffer!\n",\
	     "Ein super Treffer!\n",\
	     "Haha! Schneeballschlachten sind lustig!\n",\
	     "Gerade noch so getroffen.\n",\
             "Brrr! Der Schnee ist eiskalt.\n",\
             "Der Schneeball zerspringt in einer Pulverschneewolke!\n",\
             "Der Fuss wurde getroffen!\n",\
	     "Genau auf die Hand!\n"})

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein magischer Schneeball");
  SetProp(P_LONG,
    "Dieser magische Schneeball schwebt um Dich herum. Mit dem Befehl "
    "'schiesse <name> mit schneeball ab' flizt er los! Er verfehlt sein "
    "Ziel niemals!" );
  SetProp(P_INFO, "Dieser Schneeball trifft immer!");
  SetProp(P_NAME, "Schneeball");
  SetProp(P_GENDER, MALE);
  AddId( ({"schneeball", "ball", "\nevent_snowball"}) );

  SetProp(P_MATERIAL, MAT_SNOW );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, 1);

  AddCmd( ({"schiess", "schiesse"}), "shooting");
}

int shooting(string str)
{
  string name;
  string msg;
  object target;
  msg = MSG[random(sizeof(MSG))];
  
  notify_fail("Was willst Du nach wem schiessen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s mit schneeball ab", name) != 1) return 0;

  notify_fail("Dieser Spieler ist gar nicht hier!\n");
  if(!target = present(name, environment(this_player()))) return 0;
  if (!interactive(target)) return 0;

  notify_fail("Du kannst keinen Schneeball auf Dich selbst werfen.\n");
  if (target == this_player()) return 0;

  tell_object(this_player(), "Du wirfst Deinen Schneeball nach "+capitalize(name)+".\n"
  "*PATSCH* "+msg+"\n");
  
  tell_room(environment(this_player()), this_player()->Name(WER)+
  " wirft einen Schneeball nach "+capitalize(name)+"\n*PATSCH* "+msg+"\n",
  ({this_player(), target}));
  
  tell_object(target, this_player()->Name(WER)+" wirft einen Schneeball nach Dir.\n"
  "*PATSCH* "+msg+"\n");

  call_other("/d/event/malar/schneeballschlacht/master", "ScoreUp", getuid(this_player()), 
             getuid(target));

  return 1;
}

// EventAction(GOES_NETDEAD) ... gibts im SL nicht :)
void BecomesNetDead(object spieler)
{
  if(spieler == environment(this_object())) remove(1);
}

// EventAction(DIE) ... gibts im SL nicht :)
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(victim == environment(this_object())) remove(1);
}
