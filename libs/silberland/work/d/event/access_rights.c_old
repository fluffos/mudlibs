#define TD(x) if (find_player("debugger")) tell_object(find_player("debugger"),x)

int access_rights(string name, string file, int readflag, int def)
{
  string s1, s2;

  if (readflag)
  {
    if (name=="hotaru")
      return 1;
    if (name=="malar")
      return 1;
    return def;
  }

  name=lower_case(name);
  if (file=="access_rights.c") return 0;
  if (sscanf(file,"%s/%s", s1, s2)!=2) return 0;

  // TD(sprintf(" * name=%O, file=%O\n",name,file));
  //if (find_player("angrox")) tell_object(find_player("angrox"),"Ok!\n");

  // Fuer Zordans Laeuse-Event 
  if(name=="malar" && s1=="laeuse") 
    return 1;
  if(name=="malar" && s1=="bankraub") 
    return 1;
  if(name=="iwo" && s1=="rabbit") 
    return 1;
  if(name=="dante" && s1=="zolom") 
    return 1;
  if(name=="ronja" && s1=="rabbit") 
    return 1;
  return 0;
}
