//Diese Ratte soll die Pest verbreiten
//sie traegt kleine Floehe, die auf Spieler oder andere NPC übergehen


inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
#include <npc.h>




void create() {
  if (!is_clone(TO)) return;

 ::create();

	  
  SetProp(P_SHORT, "Eine Pestratte");
  SetProp(P_LONG,
    "Du siehst eine schmuddelige, verlauste Ratte vor Dir. Ihr Pelz ist struppig, an "
	"manchen Stellen verfilzt. Du kommst ihr besser nicht zu nahe!");
  SetProp(P_NAME, "Pestratte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"pestratte","ratte"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Ratte");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  AddInfo(DEFAULT_INFO, "piept.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Die Ratte kann nichts tragen.\n"}) );
  SetChats(3, ({
    "Die Ratte kratzt sich.\n",
	"Die Pestratte schnueffelt an Dir.\n",
	"Die Pestratte sucht etwas zu essen.\n" }) );
//CLONEME(OBJ "pestfloh" );
 }


