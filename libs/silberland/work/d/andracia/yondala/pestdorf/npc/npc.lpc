//Standartelfe NPC, der rumlaufen kann

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>




void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein NPC");
  SetProp(P_LONG,
    "Du siehst einen langweiligen NPC vor Dir.");
  SetProp(P_NAME, "NPC");
  SetProp(P_GENDER, MALE);
	AddId(({"npc", "rumlaufding"}));
  SetProp(P_KILL_NAME, "Ein NPC");
  create_default_npc(8);
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 70000);



  AddId(({"/npc"}));

	SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/aboriville/room/aboriville_4d");
	SetProp (P_MNPC_AREA, ({
		"/d/andracia/yondala/aboriville/room/aboriville_2a", 
		"/d/andracia/yondala/aboriville/room/aboriville_2b", 
		"/d/andracia/yondala/aboriville/room/aboriville_2c", 
		"/d/andracia/yondala/aboriville/room/aboriville_3c", 
		"/d/andracia/yondala/aboriville/room/aboriville_4d", 
		"/d/andracia/yondala/aboriville/room/aboriville_5c", 
		"/d/andracia/yondala/aboriville/room/aboriville_6b", 
		"/d/andracia/yondala/aboriville/room/aboriville_3e", 
		"/d/andracia/yondala/aboriville/room/aboriville_4e", 
		"/d/andracia/yondala/aboriville/room/aboriville_4f", 
		"/d/andracia/yondala/aboriville/room/aboriville_4g", 
		"/d/andracia/yondala/aboriville/room/aboriville_4h", 
		"/d/andracia/yondala/aboriville/room/aboriville_5e"}));
	SetProp (P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({5, 10, 5}));



  SetProp(P_ARTICLE, 1);
  SetProp(P_HANDS, ({" mit einem Dolch",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Viech");
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Moerder!");


  AddInfo(DEFAULT_INFO, "sagt: darueber darf ich nicht mit Euch sprechen.\n");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");


  SUID;
  CLONEME(WEAPON "elfendolch" );
  command("zuecke dolch");
  CLONEME(ARMOUR "elfentunika" );
  CLONEME(ARMOUR "elfenguertel" );
  command("trage alles");
}


void InformDefend(object enemy)
{
 Kill(enemy);
}