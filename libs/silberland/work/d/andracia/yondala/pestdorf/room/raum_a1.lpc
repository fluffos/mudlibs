#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein Raum" ); //Kurzbeschreibung
  SetProp( P_INT_LONG,
    "Ein sehr leerer Raum" );//Langbeschreibung
  SetProp( P_LIGHT, 1 );// 1 = hell
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Geraeusch.");
  AddSound( ({ "geraeusch" }),
    "piep.");
  AddSmell( DEFAULT_SMELL,
    "Standardgeruch");
  AddSmell( ({ "" }),
    "");
 

  AddDetail( ({ "" }),
    (""));
	
	
  AddRoomMessage( ({"Etwas passiert.\n",
					"Etwas anderes passiert.\n"}), 210 );


  AddExit( "osten", ROOM + "raum_x" );

}

