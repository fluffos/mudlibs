void reset()
{

	::reset();	

	if(!find_netdead(environment(TO)->name())) ;
	symptome();
	}




void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0);
  SetProp(P_INFO,0);
  SetProp(P_NAME, "die Pest");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\npest" }));

  SetProp(P_MATERIAL, ({MAT_MISC_POISON }) );
 // SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 staerke =0;
call_out("symptome",3);


}

