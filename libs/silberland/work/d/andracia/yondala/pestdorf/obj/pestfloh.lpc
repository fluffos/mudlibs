#include <moredef.h>
inherit "std/unit.lpc";
#include "unit.h"
#include "properties.h"
#include "../def.h"

void uebersprung()
{
	mixed *spieler;
	int wer;
	int i;
	spieler=all_inventory(environment(environment(TO)));
	
	wer=sizeof(spieler);
	if(wer>1)//Mehr als nur der Flohtraeger im Raum
		{
			for(i=wer-1;i>=0;i--)
				{
					if(spieler[i]!=environment(TO)&&spieler[i]->QueryProp(P_RACE)) //Nicht der Flohtraeger und hat eine Rasse
					{
						tell_object(environment(TO), "Der paarungsbereite Pestfloh springt auf "+spieler[i]->name()+" ueber.\n");
						tell_object(spieler[i], "Ein Pestfloh springt von "+ environment(TO)->name(WEM) + " auf Dich ueber.\n");
						CLONE(OBJ+"pestfloh", spieler[i]);
						tell_room(environment(environment(TO)),"Ein Pestfloh springt von "+ environment(TO)->name(WEM) + " auf " + spieler[i]->name(WEN)+" ueber.\n", ({spieler[i],environment(TO) }));
						SetProp(P_AMOUNT, QueryProp(P_AMOUNT)-1);
						return;
					}
				}
		}
	tell_object(environment(TO),"Ein einsamer Pestfloh sucht verzweifelt eine Partnerin zum fortpflanzen.\n");
	
}

void reset()
{
	int was; //was soll passieren?
	object *spieler;
	int wer;
	int i;
	::reset();	

	if(find_netdead(environment(TO)->name())) return;

	was=random(7);
	if (was==0)	{tell_object(environment(TO),"Ein Pestfloh krabbelt auf Dir herum.\n");}
	if (was==1)	{tell_object(environment(TO),"Ein Pestfloh krabbelt in Dein linkes Ohr und kommt beim rechten wieder raus.\n");}
	if (was==2)	{tell_object(environment(TO),"Ein Pestfloh baut sich ein Nest in Deinen Nasenhaaren.\n");}
	if (was==3)	{tell_object(environment(TO),"Ein Pestfloh pinkelt Dich an.\n");}	
	
	if (was==4)
	{
		if(QueryProp(P_AMOUNT)>1)
			{
				tell_object(environment(TO),"Zwei Pestfloehe treiben es wild auf Dir und zeugen einen weiteren Pestfloh.\n");
				SetProp(P_AMOUNT, QueryProp(P_AMOUNT)+1);
				}
				
		else//wenn nur einer da ist
		{
			uebersprung();
		}

	}
	
	
	if (was==5)	
	{
		tell_object(environment(TO),"Ein Pestfloh beisst Dich.\n");
		if(!present("pest", environment(TO)))
		{
			tell_object(environment(TO),"Gratuliere, Du hast nun die Test-Pest :o)\n");
			//environment(TO)->clone_object("pest");
			}
	}
	if (was==6&&QueryProp(P_AMOUNT)>4)	uebersprung();
		
}



void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pestfloh");
  SetProp(P_LONG, "Ein kleiner Floh, der rumkrabbelt.");
  SetProp(P_INFO, "Du solltest ihn schnell zerquetschen, eh er Dich beisst oder sich vermehrt.");
  SetProp(P_NAME, "Pestfloh");
  SetProp(P_GENDER, MALE);
  AddId(({"pestfloh","floh" }));

  SetProp(P_MATERIAL, ({MAT_CHITIN, MAT_BLOOD}) );
 // SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

  SetCoinsPerUnits(0,1);
  SetGramsPerUnits(1,1);

  AddSingularId(({"floh", "pestfloh"}));
  AddPluralId(({"floehe", "pestfloehe"}));


AddCmd(({"zerquetsche", "zerquetsch"}), "zerquetschenCmd");

}

zerquetschenCmd(string str)
{	 notify_fail( "Was moechtest Du zerquetschen?\n" );
	if (str != "floh"&&str!="pestfloh") return 0;
	if(!TP->QueryProp(P_MAX_HANDS)-TP->QueryProp(P_USED_HANDS))
	{
		write("Du hast keine Hand frei.\n");
		return 1;
	}
	write( "Du zerquetscht den Pestfloh zwischen den Fingern.\n");
	say(TPN + " zerquetscht einen Floh mit den Fingern.\n");			
	SetProp(P_AMOUNT, QueryProp(P_AMOUNT)-1);
	//this_object()->remove();
	return 1;
}