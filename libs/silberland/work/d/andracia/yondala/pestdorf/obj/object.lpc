//#include "../def.h"
#include <moredef.h>
inherit "std/thing";
#include <properties.h>

int voll = 1;
string was;
string wer;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Objekt");
  SetProp(P_LONG, "Ein langweilige Objekt.");
  SetProp(P_INFO, "Das hier liest man beim identifizieren.");
  SetProp(P_NAME, "Objekt");
  SetProp(P_GENDER, NEUTER);
  AddId(({"objekt","ding" }));

  SetProp(P_MATERIAL, ({MAT_WOOD}) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
/*  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);*/

  


}


