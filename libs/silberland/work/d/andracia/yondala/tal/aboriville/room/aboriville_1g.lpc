#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Spielzimmer");
  SetProp(P_INT_LONG, 
  		"Fast schon steht man an dieser Stelle in dem Wust von Spielzeug. "
  		"An der Holzwand befinden sich einige Regale, die den Anschein "
  		"machen, als wenn sich normalerweise Spielzeug darin befinden "
  		"wuerde... ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
AddItem(ELFEN_NPC + "kigaelfe3.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "spielzimmer", "stelle", "raum" }),
    "Du befindest Dich im Spielzimmer des Kindergartens.");    
  AddDetail( ({ "boden" }),
    "Wie alles in Aboriville ist auch hier der Boden aus Holz. Allerdings sieht man "
    "davon nicht so viel, denn hier liegt allerlei Spielzeug verteilt herum.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "waende","wand", "holzwand" }),
    "Die Waende bestehen hier wie alles in Aboriville aus Holz. Allerdings sind hier aus "
    "den hoelzernen Waenden heraus einige Regale gewachsen. In denen normalerweise "
    "Spielzeug aufbewahrt zu werden scheint.");
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "decke" }),
    "Die hohe, helle Decke ist aus Holz. Ein paar kleine Gluehwuermchen schweben darunter.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen spenden dem Raum zusaetzliches Licht.");    
  AddDetail( ({ "licht" }),
    "Durch die Tuer faellt ein bisschen Sonnenlicht und auch die Gluehwuermchen unter der "
    "Decke erhellen den Raum.");    
  AddDetail( ({ "sonnenlicht","sonne" }),
    "Das Licht der Sonne erhaelt den Raum.");    
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer hast Du das Spielzimmer betreten und kannst es auch wieder verlassen. Sie fuehrt nach Suedwesten.");    
  AddDetail( ({ "spielzeug", "wust" }),
    "In einer Ecke siehst Du einige kleine Figuren, in einer anderen Ecke liegt ein grosser "
    "Berg mit Baukloetzen. Ausserdem liegen ueberall kleine Puzzleteile und Memorykarten herum.");    
  AddDetail( ({ "baukloetze", "kloetze" }),
    "Mit diesen Baukloetzen haben die Kinder sicher schon so manches Kunstwerk gebaut.");    
  AddDetail( ({ "kunstwerk" }),
    "Im Moment liegen die Kloetze aber wild verteilt im Raum.");    
  AddDetail( ({ "figuren", "tiere", "zwerge","elfen","menschen","nachbildungen" }),
    "Du erkennst einige kleine Figuren, die wohl Nachbildungen von Elfen, Menschen, Zwergen, "
    "Tieren und vielen mehr sind.");    
  AddDetail( ({ "puzzleteile", "teile" }),
    "Die Teile liegen wild verstreut und Du bist nicht sicher, ob ueberhaupt noch alle da sind.");    
  AddDetail( ({ "memorykarten", "karten" }),
    "Mit denen wurde wohl mal gespielt, aber nun liegen die Karten verteilt und teilweise "
    "verknickt im Raum verstreut herum.");    
  AddDetail( ({ "anschein" }),
    "Nun, es scheint so.");    
  AddDetail( ({ "regale" }),
    "Die Regale sind aus der Wand heraus gewachsen als die Kindergaertnerin die "
    "Wand darum gebeten hat. Sie bieten viel Platz fuer das Spielzeug der Kinder.");    
  AddDetail( ({ "platz" }),
    "Viel Platz ist noch in den Regalen, denn das meiste Spielzeug liegt auf dem Boden verteilt.");    
  AddDetail( ({ "ecke", "ecken" }),
    "Auch in den Ecken liegt allerhand Spielzeug.");    
  AddDetail( ({ "berg" }),
    "Die Baukloetze bilden einen Berg.");    
  AddDetail( ({ "kindergaertnerin" }),
    "Die laeuft bestimmt hier herum, wenn Du zu ihr willst solltest Du Dich ein wenig umsehen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das helle Lachen eines Kindes.");
  AddSound( ({ "lachen","kind","kinderlachen" }),
    "Es klingt froehlich und unbeschwert.");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das helle Lachen eines Kindes.");
 
	AddSmell( DEFAULT_SMELL,
	"Es riecht hier frisch nach Natur."); 

	AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_2f.lpc" ); 
	AddCmd(({"puzzle", "puzzel"}), "puzzlen"); 
	AddCmd(({"spiele", "spiel"}), "spielen"); 
	AddCmd(({"baue", "bau"}), "bauen"); 


}


int puzzlen(string str)
{
	notify_fail( "Was moechtest Du puzzlen?\n" );
	if (str =="puzzle"||!str)
		{	
			write("Du suchst alle Teile zusammen und puzzles eifrig drauf los.\n");
			say(TPN+" sucht alle Teile zusammen und faengt an zu puzzlen.\n", TP);
			call_out("puzzlen2",2);
			return 1;
		}
	return 0;	
}

puzzlen2(string str)
{
  if (present(TP))//(TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
	write("Du stellst fest, dass ein Teil fehlt und wirfst wuetend alle Teile durch den Raum.\n");
	say(TPN+" stellt fest, dass ein Teil fehlt und wirft wuetend alle Teile durch den Raum.\n", TP);
	}
	//return 1;
}


int bauen(string str)
{
	notify_fail( "Was moechtest Du bauen?\n" );
	if (str !="turm"&&str!="schloss"&&str!="burg"||!str)
		return 0;
		
	write("Du baust munter drauf los, als Du fast fertig bist laeuft jedoch "+
	"ploetzlich ein Elfenkind an Dir vorbei und zerstoert Dein Werk.\n");
	say(TPN+" versucht mit den Bausteinen etwas zu bauen.\n", TP);
	return 1;
}

int spielen(string str)
{
	notify_fail( "Womit moechtest Du spielen?\n" );
	if (str =="mit figuren"||str="mit figur"||str="mit puppen")
		{
			write("Du schnappst Dir ein paar der Figuren und spielst ein wenig damit.\n");
			say(TPN+" schnappt sich ein paar der Figuren und spielt ein wenig damit.\n", TP);
			return 1;
		}
	if(str=="memory"||str="mit memoriekarten")
		{
			write("So angestrengt Du auch suchst, Du kannst kein Paar entdecken.\n");
			say(TPN+" schaut sich die Memorykarten genauer an.\n", TP);
			return 1;
			}	
	if (str =="mit bausteinen"||str=="mit steinen")
		{
			write("Du baust munter drauf los, als Du fast fertig bist laeuft jedoch "+
				"ploetzlich ein Elfenkind an Dir vorbei und zerstoert Dein Werk.\n");
			say(TPN+" versucht mit den Bausteinen etwas zu bauen.\n", TP);
			return 1;
		}
	return 0;
}
