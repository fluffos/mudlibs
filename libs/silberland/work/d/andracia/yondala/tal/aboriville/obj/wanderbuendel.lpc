inherit "std/container";

#include "properties.h"
#include "container.h"
#include "../def.h"

int respawn_treasure;
int viewed_treasure;
string *treasures;



void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT, "Ein Buendel");
  SetProp( P_LONG, BS("Du siehst ein Buendel, wie es Wanderer oft bei sich haben. Es besteht "
  "aus einem rotweiss karrierten Tuch, welches an einen Stock gebunden wurde. ") );
  SetProp( P_NAME, "Buendel");
  SetProp( P_ARTICLE, 1);
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_COTTON);
  AddId( ({"buendel"}) );
  SetProp( P_WEIGHT, 200);
  SetProp( P_VALUE, 120);
  SetProp(P_MAX_WEIGHT,5000);

 
}
