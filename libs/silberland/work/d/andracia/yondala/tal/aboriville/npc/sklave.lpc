#include "/d/def.h"


inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Sklave");
  SetProp(P_LONG,
    "Ein Sklave von Brisi."
  );

  SetProp(P_NAME, "Sklave");
  SetProp(P_GENDER, MALE);
  AddId(({"sklave", "NOWIMPY", "aborivilles"}));
  SetProp(P_ARTICLE, 2);
  SetProp(P_BODY, 80);



  create_default_npc(30, 250);
  //SetProp(P_ATTRIBUTES, ([A_DEX:15,A_CON:15,A_STR:15,A_INT:15]));

  SetProp(P_HANDS, ({" mit seinen starken grossen Haenden"
                   ,QueryProp(P_HANDS)[1]
                   , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "mensch");
  SetProp(P_SIZE, 0);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Wolke");
  SetProp(P_MMSGOUT, "wird zur Wolke und ist weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Der Sklave");
  SetProp(P_MURDER_MSG, "%s,wenn ich wieder komm mach ich DICH aber fertig!\n");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
   
  
 

}


