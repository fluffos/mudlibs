//gehoert zu der Quest Hilfe fuer die kranke Elfe

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <npc.h>
#include <player/base.h>
#include "../def.h"

void init()
{
   ::init();
   call_out("hilfefrager", 1);
}
int folgend;
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Peter der Wanderer");
  SetProp(P_LONG,
    "Peter der Wanderer ist ein offensichtlich sehr betagter Mensch, der dennoch in einer "
    "guten, koerperlichen Verfassung scheint. Er ist schlank und unter seiner Haut spannen "
    "sich trainierte Muskeln. Peter traegt einen Wanderumhang unter dessen Kapuze seine "
    "langen , grauen Haare hervorschauen, feste Stiefel und eine Tasche. Beim Laufen "
    "stuetz er sich locker auf seinen Wanderstab.");
  SetProp(P_NAME, "Peter");
  SetProp(P_GENDER, MALE);
  AddId(({"peter", "\ndaspeterli", ""}));
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinem Stab",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 100);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NOATTACK, 1);
  SetProp(P_MAX_HANDS, 2);

  SetProp (P_MNPC_DEFAULTROOM , BIRKE_ROOM + "buchenwald_8i.lpc");
//  SetProp (P_MNPC_AREA, ({"/d/" }));
  SetProp (P_MNPC_FLAGS, MOV_BACKWARDS + MOV_INDOORS+ MOV_OUTDOORS);
  SetProp (P_MNPC_WAIT, ({0, 0, 0}));



  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " geht davon.\n");
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Peter der Wanderer");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "gibt darauf keine Auskunft.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"spendieren",""}),
    "Ihr koennt in jeder Lokalitaet einem anderen etwas spendieren.",
    "sagt: ");
  AddInfo( ({"hilfe",""}),
    "Oh, ich habe mich ein wenig verlaufen und warte auf jemanden, der mich fuehrt.",
    "sagt: ");
  AddInfo( ({"elfe","freundin"}),
    "Ich habe eine gute elfische Freundin, sie ist leider krank und ich moechte sie besuchen.",
    "sagt: ");
  AddInfo( ({"fuehren","fuehrer"}),
    "Meine Freundin hat mir mitgeteilt, dass jemand kommen wird um mich zu fuehren.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Peter will Deine Sachen nicht tragen.\n" }) );

/*  SetChats(3, ({
    ".\n"}) );
*/
  AddCmd( ({ "fuehre", "fuehr" }), "fuehren" ); 
  AddCmd( ({ "spendiere", "spendier" }), "spendieren" ); 

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt @WEN.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Peter hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


fuehren(string str)
{
	object questitem;
	if(str=="peter")
		{
			if(present("\nquestelfenhilfe",TP))
				{
					questitem=present("\nquestelfenhilfe",TP);
					if(questitem->auftrag()==8)//ist er bei Stufe 8?
						{
							if (folgend)//wenn er schon jemandem folgt
								command("sag Danke, aber mir wird schon geholfen.");
							else
								{
									command("sag Ah, Euch suche ich. Ja, fuehrt mich bitte zu meiner Freundin! Ich folge Euch.");
									TP->AddPursuer(TO);
									folgend=1;
								}
						}
      				else command("sag Euch folge ich nicht!");
					}
				else command("sag Euch folge ich nicht!");
		}
	else
		write("Wen willst Du fuehren?\n");
return 1;	
	}

void hilfefrager()
{
	object questitem;
	if (folgend) return; //wenn er schon jemandem folgt.
	if (!present("\nquestelfenhilfe",TP)) return;
		
	questitem=present("\nquestelfenhilfe",TP);
	if(questitem->auftrag()==8)
		command ("sag Seid gegruesst, "+TPN+", Ihr wurdet mir schon angekuendigt. Seid Ihr so gut und fuehrt mich nach Aboriville?");
}

int spendieren(string str)
{
	object questitem;
	if(file_name(environment(TP))!=ELFEN_ROOM + "aboriville_6c")
		return 0;
	if(str=="peter bier"||str=="peter tannenbier")
		{
			if(present("\nquestelfenhilfe",TP))
			{
				questitem=present("\nquestelfenhilfe",TP);
				if (questitem->auftrag()==9&&TP->QueryMoney()>499)//richtige Syntax, richtige Stufe, Peter da, genug Geld da
						call_out("spendieren2",1);
			}
		}	
}

void spendieren2()
{
	command("sag Habt vielen Dank. Als Entschaedigung fuer Eure Muehe moechte ich Euch gerne "+
	"etwas schenken. Viel habe ich nicht, so nehmt denn mein Wanderbuendel!");
	CLONE(ELFEN_OBJ +"wanderbuendel.lpc", TP);

	call_out("spendieren3",1);
	}
void spendieren3()
{
	command("sag Nun werde ich zu meiner kranken Freundin zurueckkehren.\n");
	tell_room(environment(TO), "Peter winkt und geht.\n"); 
	call_out("questfertig",1);
}

void questfertig()
{
        int q;
        object questitem;
        questitem = present("\nquestelfenhilfe",TP);
        write("Die kranke Elfe teilt Dir mit: Vielen Dank, fuer Eure Hilfe, "+TPN+"!\n");
             /*   "Die kranke Elfe teilt Dir mit: Als Dank fuer Euren Grossmut schenke ich Euch \n"+
                "Die kranke Elfe teilt Dir mit: die Gabe anderen Eure Gefuehle mitzuteilen.\n"*/

        q = TP->GiveQuest("Hilf der kranken Elfe"); //Quest als bestanden deklarieren
        if (q == 1)
        {
                // TP->SetProp(P_CAN_FLAGS, 15);
                TP->SetProp(P_CAN_FLAGS,
                        TP->QueryProp(P_CAN_FLAGS) | CAN_REMOTE );
                questitem->remove();
                TO->remove();

                // added 2020-08-19 by Woody
                write_file ("/log/quests/kranke_elfe",
                        sprintf ("%s  %s hat der kranken Elfe geholfen.\n",
                        dtime(time()), capitalize(getuid(TP)) ) );
        }
}
