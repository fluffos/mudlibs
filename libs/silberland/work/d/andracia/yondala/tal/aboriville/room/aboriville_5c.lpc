#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>



void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer kleinen, stabilen Haengebruecke welche den Marktplatz "
    "Aborivilles mit der Plattform im Mittelpunkt der Stadt verbindet." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "haengebruecke" }),
    "Die kurze Haengebruecke fuehrt zwischen den Kronen der Baeume hindurch von der "
    "Plattform im Nordosten zum Marktplatz der Elfenstadt im Suedwesten.");    
  AddDetail( ({ "marktplatz" }),
    "Der Marktplatz Aborivilles liegt suedwestlich von Dir, Du kannst ihn betreten.");    
  AddDetail( ({ "plattform" }),
    "Die Plattform im Nordosten stellt den Mittelpunkt der Stadt dar. Von dort aus "
    "kannst Du alle Viertel erkunden.");    
  AddDetail( ({ "mittelpunkt" }),
    "Der Mittelpunkt Aborivilles liegt nordoestlich von Dir.");    
  AddDetail( ({ "nordosten" }),
    "Im Nordosten befindet sich der Mittelpunkt Aborivilles.");    
  AddDetail( ({ "suedwesten" }),
    "Suedwestlich von Dir befindet sich der Marktplatz Aborivilles.");    
  AddDetail( ({ "viertel" }),
    "Aboriville ins in Viertel aufgeteilt.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    


AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_6b.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_4d.lpc" ); 

}

