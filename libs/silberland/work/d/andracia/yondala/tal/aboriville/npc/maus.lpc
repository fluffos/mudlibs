//Die Maus

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Maus");
  SetProp(P_LONG,
    "Eine Maus die in der Gegend herumkrabbelt.");
  SetProp(P_NAME, "Maus");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  CLONEME(ELFEN_OBJ "kaesestueckchen" );

SetProp (P_MNPC_DEFAULTROOM ,ELFEN_ROOM + "aboriville_6f");
SetProp (P_MNPC_AREA, ({ELFEN_ROOM + "aboriville_7g", ELFEN_ROOM + "aboriville_6f",ELFEN_ROOM + "aboriville_6g",  ELFEN_ROOM + "aboriville_5e",
						ELFEN_ROOM + "aboriville_5f", ELFEN_ROOM + "aboriville_5g",ELFEN_ROOM + "aboriville_7e",
						ELFEN_ROOM + "aboriville_7f",ELFEN_ROOM + "aboriville_6e",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));


  AddId(({"maus", "nagetier"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit spitzen Maeusezaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");  
  SetProp(P_SIZE, 12);
  SetProp(P_WEIGHT, 85);

  SetProp(P_MSGIN, "krabbelt herbei"); 
  SetProp(P_MSGOUT, "krabbelt davon");
  SetProp(P_MMSGIN, "kommt aus einem schwarzen Loch");
  SetProp(P_MMSGOUT, "wird in ein schwarzes Loch gezogen");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein kleines Mauschen"); // ELFEN_NPC-Name für den killer

  AddInfo(DEFAULT_INFO, "kann nicht sprechen.\n");  //wenn gefragt wird
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Maus laesst es wieder fallen.\n" }) );
    
}
