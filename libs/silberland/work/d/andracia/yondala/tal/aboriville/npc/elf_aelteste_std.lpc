string stammbaum()
{
	if(this_player()->QueryQuest("Elfenahnen")) //Wenn die Quest schon beendet wurde
		return "sagt: Der haengt hier an der Wand.\n";
           
return
    " sagt: Jedes aelteste Paar hat einen Stammbaum angefertigt, Ayala \n"+
    TO->name()+" sagt: allerdings ist noch nicht ganz fertig damit, vielleicht kann \n"+
    TO->name()+" sagt: sie Eure Hilfe gebrauchen?";
}



void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein aeltester Elf");
  SetProp(P_LONG,
    "Du siehst einen grossen, athletischen Elfen vor Dir. Sein braunes Haar ist an den Schlaefen "
    "schon leicht ergraut, seine Haut mit vielen Narben uebersaeht. Er scheint ein sehr "
    "erfahrener Kaempfer zu sein, dennoch schaut er aus guetigen und weisen Augen in die Welt." );
  SetProp(P_NAME, "Aeltester");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"elf", "aeltester"}));//Dinge auf die man ihn beim untersuchen ansprechen kann

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinem Schwert",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, 800);

  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 1.0, DT_TERROR: 0.0,
      DT_HOLY:      1.0, DT_UNHOLY:    1.0, DT_MAGIC:  1.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,50);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst " +TPN+ " nicht entkommen!");
  SetProp(P_KILL_NAME, "Tasinion, der aelteste Krieger");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Yondala allein mag uns diese Weisheit vermitteln.\n");
  

  AddInfo( ({"namen"}), 
    "Ach, ich kann mir Namen so schlecht merken.",
    "sagt: "); 
  AddInfo( ({"enkel"}), 
    "Ich habe jede Menge Enkel, die sind auch groesstenteils selbst schon verheiratet. Nur "
    "kann ich mir nie merken wer mit wem.",
    "sagt: "); 
  AddInfo( ({"stammbaum"}), 
    "Ayala moechte einen Stammbaum all unserer Nachkommen anfertigen, vielleicht fragt Ihr "
    "besser sie danach.",
    "sagt: "); 
  AddInfo( ({"tasinion", "aeltester kaempfer"}), 
    "Tasinion ist der aelteste Kaempfer.",
    "sagt: "); 
  AddInfo( ({"andvare", "aeltester priester"}), 
    "Andvare ist unser aeltester Priester.",
    "sagt: "); 
  AddInfo( ({"lelo", "heiler", "aeltester heiler"}), 
    "Lelo ist der aelteste Heiler.",
  "sagt: ");
  AddInfo( ({"belenos","weiser","aeltester weise"}), 
    "Belenos ist der aelteste Weise.",
    "sagt: ");
     
  AddInfo( ({"tasinion", "aeltester kaempfer"}), 
    "Tasinion ist der aelteste Kaempfer.",
    "sagt: "); 
  AddInfo( ({"almana","weise","aelteste weise"}), 
    "Almana ist die aelteste Weise.",
    "sagt: "); 
  AddInfo( ({"alyna","heilerin","aelteste heilerin"}), 
    "Alyna ist unsere aelteste Heilerin.",
    "sagt: "); 
  AddInfo( ({"ariana", "aelteste priesterin","priesterin"}), 
    "Ariana ist unsere aelteste Priesterin.",
    "sagt: "); 
  AddInfo( ({"ayala","kaempferin","aelteste kaempferin"}), 
    "Ayala ist die aelteste Kaempferin der Elfen.",
    "sagt: "); 
  AddInfo( ({"linola","verkaeuferin"}),
    "Linola hat einen kleinen Laden in Aboriville. Besucht sie doch einmal.",
    "sagt: ");
  AddInfo( ({"name","namen"}),
    "Jedes Lebwesen traegt einen Namen.",
    "sagt: ");
  AddInfo( ({"enkel"}), 
    "Ich habe jede Menge Enkel, und auch schon Urenkel. Wenn Ihr genaueres wissen moechtet, "
    "so lest doch unseren Stammbaum!",
    "sagt: "); 
  AddInfo( ({ "stammbaum"}), #'stammbaum);//'

  AddInfo( ({"paar", "paare"}), 
    "Unter den Elfen gibt es viele Paare.",
    "sagt: "); 
  AddInfo( ({"brisi","apothekerin"}), 
    "Brisi ist die Apothekerin.",
    "sagt: "); 
  AddInfo( ({"apotheke"}), 
    "Nicht weit von hier gibt es eine kleine Apotheke. Sie gehoert Brisi.",
    "sagt: "); 
  AddInfo( ({"nanna", "kindergaernerin"}), 
    "Nanna ist die Kindergaertnerin im Kindergarten unserer Stadt.",
    "sagt: "); 
  AddInfo( ({"kindergarten"}), 
    "Unweit von hier befindet sich ein Kindergarten, in den unsere Kinder gehen bis sie in die Schule gehen.",
    "sagt: "); 
  AddInfo( ({"schule", "elfenschule"}), 
    "Unsere Stadt hat eine eigene kleine Schule. Sie ist nicht weit von hier, Anarion unterrichtet dort die aelteren Kinder.",
    "sagt: "); 
  AddInfo( ({"kinder","elfenkinder"}), 
    "Die juengeren Elfenkinder gehen in den Kindergarten, die aelteren in die Schule. Bildung ist sehr wichtig.",
    "sagt: "); 
  AddInfo( ({"bildung", "unterricht"}), 
    "Anarion unterrichtet unsere Kinder. Fremden ist die Teilnahme am Unterricht jedoch nur bedingt gestattet.",
    "sagt: "); 
  AddInfo( ({"anarion","lehrer"}), 
    "Anarion ist der Lehrer in unserer Elfenschule.",
    "sagt: "); 
  AddInfo( ({"stadt","aboriville"}), 
    "Ihr befindet Euch hier in Aboriville, der Stadt der Elfen.",
    "sagt: "); 
  AddInfo( ({"elfen"}), 
    "Wir Elfen leben hier. Wir sind die intelleigentesten und besten Lebewesen Andracias!",
    "sagt: "); 
  AddInfo( ({"andracia", "teil"}), 
    "Wir alle sind ein Teil Andracias.",
    "sagt: "); 
  AddInfo( ({"mondol"," pheralas","famione","zylia","selo","linlala","linlaen","golain","miranyl","ambelio","fenwen","fesieel","mindala","nela","miranola","teluwen","garansa","riaona","linwen","linel","alanel","odania","linola","lonola","bimalandon,","lorion","felerian","neraen","navalla","nerael","faemil","ranari","thorasa","hiara","sutana","sowena","enriu","melina","belina","semione","minda","nalda","saladion","alari","lianda","vindo","meldo","lutana","alriel","enrael","lutana","alriel","enrael","lalen","aliaria","daniolo","laia","linla","imalien","pholdolur","tamosa"}),
  	"Ueber Elfen gebe ich keine Auskunft!",
  	"sagt: "); 

  AddInfo( ({"elfenpirat", "elfenpiraten"}), 
    "Elfenpiraten sind die schlimmsten Verraeter, die unser Volk je hervorgebracht hat. Jeder "
    "Elf, der zu den Piraten ueberlaeuft wird auf ewig verbannt aus unserer Mitte!",
    "sagt: "); 
  AddInfo( ({"piraten","pirat"}), 
    "Wir Elfen hassen Piraten, doch noch schlimmer, als ein gewoehnlicher Pirat ist ein Elfenpirat.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
    
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    
  SUID;
  /*CLONEME(ELFEN_WEAPON "elfenbogen" );
  command("zuecke bogen");*/
  CLONEME(ELFEN_ARMOUR "holzpanzer" );
  CLONEME(ELFEN_ARMOUR "elfenholzbeinschienen" );
  CLONEME(ELFEN_ARMOUR "elfenholzarmschienen" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
  
  

}

	
	
void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(3));
}


void InformDefend(object enemy)
{
 Kill(enemy);
}	