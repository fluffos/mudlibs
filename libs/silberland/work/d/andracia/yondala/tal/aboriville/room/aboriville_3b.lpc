#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
object ob;
object next;
object waechter;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Vorraum des Hoheitsgebietes" );
  SetProp( P_INT_LONG,
    "Du stehst hier im Vorraum des Hoheitsgebietes und bist etwas ueberrascht. "
    "Im Gegensatz zum Rest der Hoehlen und Raueme der Stadt sind die Waende hier aus "
    "solidem Holz erschaffen. Der Raum an sich ist leer, bis auf eine Treppe. Nach "
    "Westen gelangst Du in das Heiligtum der Elfen, wenn Dir der Zutritt nicht verwehrt wird. "
    "Nach Norden gelangst Du wieder ins Freie." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
AddItem(ELFEN_NPC + "elfenwaechter_palast.lpc",REFRESH_DESTRUCT);
AddItem(ELFEN_NPC + "elfenwaechter_palast.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "vorraum", "raum" }),
    "Du stehst im Vorraum des Hoheitsgebiets von Aboriville der sich in einem hohlem Baum befindet.");     
  AddDetail( ({ "boden" }),
    "Der Boden besteht in der ganzen Stadt aus Holz. Er sieht so aus, als wuerde er oft begangen werden.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");    
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen hier aus blankem, schmucklosem Holz.");     
  AddDetail( ({ "decke" }),
    "Die Decke besteht wie alles hier aus Holz.");     
  AddDetail( ({ "quelle" }),
    "Du kannst die Quelle nicht erkennen.");     
  AddDetail( ({ "rest", "hoehlen","raeume" }),
    "Schau Dich doch ein wenig um in Aboriville!");     
  AddDetail( ({ "treppe" }),
    "Die Treppe dominiert den Raum. Sie ist fein gearbeitet und windet sich nach oben in die obere Etage.");     
  AddDetail( ({ "etage", "obere etage" }),
    "Von hier aus kannst Du nicht sehen, was sich dort verbirgt.");     
  AddDetail( ({ "westen" }),
    "Im Westen befindet sich das Heiligtum der Elfen.");     
  AddDetail( ({ "heiligtum" }),
    "Das Heiligtum der Elfen befindet sich westlich von Dir. Vielleicht kannst Du es ja betreten.");     
  AddDetail( ({ "zutritt" }),
    "Solange Dich kein Waechter aufhaelt");     
  AddDetail( ({ "norden","freie" }),
    "Nach Norden kannst Du den Vorraum wieder verlassen.");     
  AddDetail( ({ "baeume" }),
    "Die Stadt der Elfen ist auf hohen Baeumen erbaut.");     
  AddDetail( ({ "hoheitsgebiet" }),
    "Es liegt ueber Dir, wenn Du es erkunden willst so gehe einefach nach oben.");     
  AddDetail( ({ "baum" }),
    "Du befindest Dich in einem hohlen Baum.");     
  AddDetail( ({ "gegensatz" }),
    "Hier sieht es irgendwie anders aus als im Rest der Stadt.");     
  AddDetail( ({ "" }),
    "");     
  AddDetail( ({ "" }),
    "");     
        
  AddSound( DEFAULT_SMELL,
    "Es riecht nach dem Harz des Baumes in dem Du Dich befindest.");
  AddSound( DEFAULT_SOUND,
    "Von oben hoerst Du leistes Stimmengemurmel, aus dem Westen dringt ein leises Sirren an "
    "Dein Ohr.");

  AddSound( ({ "stimmengemurmel","gemurmel","stimmen" }),
    "Jemand scheint sich angeregt zu unterhalten.");
  AddSound( ({ "sirren" }),
    "Das Sirren dringt aus dem Westen zu Dir, leider kannst Du die Quelle nicht erkennen.");
  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "baum","harz" }),
    "Das Harz des Baumes riecht leicht suesslich.");



AddExit( "norden", ELFEN_ROOM  + "aboriville_2b.lpc" ); 
AddSpecialExit( "westen", "westen");  //, ELFEN_ROOM  + "aboriville_3a.lpc" ); 
AddSpecialExit( "oben", "oben");  //, ELFEN_ROOM  + "koennigshaus.lpc" ); 

}



int westen(string Dir)
     {
     	if(!present("elfenwaechter",TO))//wenn kein Waechter da ist kann man einfach weiter gehen
     	return this_player()->move(ELFEN_ROOM +"aboriville_3a", M_GO, 0, "nach Westen", "kommt herein");
	                   
 		
               
                    
       	if (!TP->id("Elfenspieler")) { // Kein Elf => passt nicht!
        say("Der Waechter haelt "+TPN+" auf.\nDer Waechter sagt: Dort duerfen nur Elfen hinein, "+TPN+"!\n");
        notify_fail("Der Waechter haelt Dich auf.\nDer Waechter sagt: Dort duerfen nur Elfen hinein, "+TPN+"!\n");
         return 0;
       }
       //return this_player()->move("/gilden/aboriville_3a.lpc", M_GO, 0, "geht nach Westen", "kommt herein");
         return this_player()->move(ELFEN_ROOM +"aboriville_3a", M_GO, 0, "nach Westen", "kommt herein");

     }
     
     
int oben(string Dir)//hier duerfen Spieler keine Waffe hin mitnehmen
   {
     	if(!present("elfenwaechter",TO))//wenn kein Waechter da ist kann man einfach weiter gehen
    		return this_player()->move(ELFEN_ROOM  + "aboriville_3b_o.lpc", M_GO, 0, "klettert nach oben", "kommt herauf geklettert");

//Wenn ein Waechter da ist: 				                  

	say("Der Waechter durchsucht "+TPN+".\n");
	write("Der Waechter durchsucht Dich.\n");

  for(ob=first_inventory(this_player());ob;) 
  {       
  	notify_fail("Der Waechter haelt Dich zurueck.\nDer Waechter sagt: Mit Waffen duerft Ihr nicht nach oben, "+TPN+"!\n");
    next=next_inventory(ob);
    if( ob->QueryProp(P_WEAPON_TYPE)&&!ob->id("\nwaffensegen") ) 
    	{
    		say("Der Waechter haelt "+TPN+" zurueck.\nDer Waechter sagt: Mit Waffen duerft Ihr nicht nach oben, "+TPN+"!\n");
	    	return 0; }
    ob=next;
  	}
 
 	say("Der Waechter sagt: In Ordnung, Ihr duerft passieren, "+TPN+".\n");
	write("Der Waechter sagt: In Ordnung, Ihr duerft passieren, "+TPN+".\n");
	return this_player()->move(ELFEN_ROOM  + "aboriville_3b_o.lpc", M_GO, 0, "klettert nach oben", "kommt herauf geklettert");
                  
}