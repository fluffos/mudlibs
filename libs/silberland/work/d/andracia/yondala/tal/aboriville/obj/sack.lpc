inherit "std/container";

#include "properties.h"
#include "container.h"
#include "../def.h"

int respawn_treasure;
int viewed_treasure;
string *treasures;



void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT, "Ein Sack");
  SetProp( P_LONG, BS("Ein gewoehnlicher, kleines Sack. ") );
  SetProp( P_NAME, "Sack");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_COTTON);
  AddId( ({"sack"}) );
  SetProp( P_WEIGHT, 12);
  SetProp(P_MAX_WEIGHT,200);
 
}
