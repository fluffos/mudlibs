// 23.01.2012 - Yondala@SilberLand: Funktionell ueberarbeitet  

#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einer schaukelnden Haengebruecke die den Wachweg mit "
    "der Stadt der Elfen verbindet. Rund um Dich herum befinden sich die Aeste "
    "der Baeume und schwanken leicht. Westlich von Dir schimmert etwas durch die Baeume." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
AddItem(ELFEN_NPC + "elf_std.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "haengebruecke","bruecke" }),
    "Du stehst auf einer leicht schwankenden Haengebruecke die durch die Kronen "
    "der Baeume hindurch den Wachweg mit der Stadt Aboriville verbindet.");    
  AddDetail( ({ "westen" }),
    "Du glaubst dort eine Stadt erkennen zu koennen und nimmst an, dass es sich wohl um Aboriville handeln muss.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus zu Planken verwachsenen Aesten. Auch wenn er leicht schwankt "
    "bist Du Dir ziemlich sicher, dass er Dich tragen kann. Rechts und links von Dir winden sich "
    "dicke Lianen entlang, sodass Du Dich trotz des schwankenden Bodens leicht fortbewegen kannst.");    
  AddDetail( ({ "lianen" }),
    "Die Lianen bestehen aus Pflanzenfasern und bieten Dir Halt.");    
  AddDetail( ({ "halt" }),
    "Wenn die Bruecke zu sehr schwankt kannst Du Dich an den Lianen festhalten.");    
  AddDetail( ({ "planken" }),
    "Die Planken schwanken unter Dir im Wind.");    
  AddDetail( ({ "wind" }),
    "Ein sehr leichter Wind weht hier.");    
  AddDetail( ({ "pflanzenfasern" }),
    "Hier waechst alles so, wie die Elfen es benoetigen. Sie brauchen die Baeume nur darum zu bitten.");    
  AddDetail( ({ "wachweg" }),
    "Der liegt oestlich von Dir.");    

   AddDetail( ({ "" }),
    "");    

AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

AddExit( "osten", ELFEN_ROOM  + "aboriville_4h.lpc" ); 
AddExit( "westen", ELFEN_ROOM  + "aboriville_4f.lpc" ); 

}

