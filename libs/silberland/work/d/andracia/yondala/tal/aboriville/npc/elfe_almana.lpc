void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(5));
}

void magie(object enemy, int damage, mixed dam_type) 
{
  enemy->SetProp(P_NEXT_SPELL_TIME, enemy->QueryProp(P_NEXT_SPELL_TIME)+random(5));
	tell_object(enemy, "Du bist etwas verwirrt.\n");

}

void InformDefend(object enemy)
{
 Kill(enemy);
}	


