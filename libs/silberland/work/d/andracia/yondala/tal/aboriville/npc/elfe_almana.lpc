//Almana ist die aelteste Weise

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"elf_aelteste_std.lpc";


void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("belenos")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}
string q_magiestein() //fuer die Quest "Die besonderen Magiesteine"
{
  object ob;
  int result;
  
 if( !TP->QueryQuest("Die besonderen Magiesteine") ) 
 if( ob=present("\nzzmagiesteinequest", TP) )
 {
 	result=ob->QueryStone("braun");
  if( result == 0) 
  	{
   ob->SetStone("braun", 1);
     ob=clone_object("/gilden/zaubererzunft/obj/magiestein.lpc"); ob->set_farbsymbol("braun");
     if( ob->move(TP, M_GET) < 0 ) ob->move(environment(TO), M_PUT); 
     tell_room(environment(TO), TO->name()+" gibt "+TP->name()+ob->name(WEN,1)+"\n",({TP}));
     tell_object(TP, TO->name()+" gibt Dir "+ob->name(WEN,1)+"\n");
   return "Hier habt ihr den braunen Magiestein fuer Zauberer Pralecred. Seid vorsichtig damit, "
   "verbraucht ihn nicht, denn ich kann euch keinen weiteren mehr geben.";
  }
  if( result==1 )
    return "Ihr habt den braunen Magiestein fuer Zauberer Pralecred schon erhalten.";
   if( result==2 )
    return "Ihr benoetigt den braunen Magiestein fuer Zauberer Pralecred nicht mehr.";
  }
 return "Magiesteine beinhalten eine elementare Kraft. Diese Steine sind sehr wertvoll.";
}


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Almana, die aelteste Weise");
  SetProp(P_LONG,
    "Du siehst eine kleine, duenne Elfin vor Dir, welche Dich aus klugen Augen guetig "
    "anlaechelt. Almana ist in gruene Seidengewaender gekleidet und sieht gepflegt und ruhig "
    "aus. Du weisst, dass sie sehr alt ist, aber das sieht man ihr wirklich nicht an." );
  SetProp(P_NAME, "Almana");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"almana", "elfe","elfin", "aelteste", "weise"}));
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 165);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 900);

  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 1.0, DT_TERROR: 0.0,
      DT_HOLY:      1.0, DT_UNHOLY:    1.0, DT_MAGIC:  1.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,40);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst %s nicht entkommen!");
  SetProp(P_KILL_NAME, "Almana, der aelteste Krieger");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Yondala allein mag uns diese Weisheit vermitteln.\n");

//Fuer die Quest "Die besonderen Magiesteine"
  AddInfo( ({"magiestein", "magiesteine"}), #'q_magiestein, "sagt: "); //#'  

  AddInfo( ({"stammbaum"}), 
    "Ayala moechte einen Stammbaum all unserer Nachkommen anfertigen, vielleicht fragt Ihr "
    "besser sie danach.",
    "sagt: "); 
  AddInfo( ({"medizin"}), 
    "Medizin habe ich nicht, aber im Laden gibt es sicher welche zu kaufen.",
    "sagt: "); 
  AddInfo( ({"almana","weise","aelteste weise"}), 
    "Das bin ich.",
    "sagt: "); 

  AddInfo( ({""}), 
    ".",
    "sagt: "); 

     
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,1250,
	        "Almana wirft eine Magiekugel nach Dir.\n",
	        "Almana wirft eine Magiekugel nach @WEM.\n",
	         ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(4,180,
	         "Almana blockiert Deine Magie.\n",
	         "Almana blockiert @WESSEN Magie.\n",
	         ({DT_MIND}),"zaubern", ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,650,
	         "Almana schleudert einen Flammenball auf Dich.\n",
	         "Almana schleudert einen Flammenball auf @WEN.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,170,
	         "Almana wird hysterisch.\n",
	         "Almana wird hysterisch.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );








/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
  SUID;
  CLONEME(ELFEN_ARMOUR "heilergewand" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
  
  

}
