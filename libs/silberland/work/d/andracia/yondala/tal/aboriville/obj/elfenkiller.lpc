#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "\nelfenkiller");
  SetProp(P_GENDER, MALE);
  AddId("\nelfenkiller");

  SetProp(P_MATERIAL, MAT_AIR );
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_WEIGHT,0);
call_out("nichtmehrkiller",600);
}

nichtmehrkiller()
{
	write("Du hast das Gefuehl, dass die Elfen eine Deine schlimmen Taten vergessen haben.\n");
	this_object()->remove();
	}