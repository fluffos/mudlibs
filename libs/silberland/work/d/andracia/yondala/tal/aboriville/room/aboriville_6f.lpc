#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG, "Du betrittst einen Kreisplatz aus Steintafeln mit vier Ausgaengen."+
    "Ein Kiesweg fuehrt nach Nordosten und Suedwesten."+
    "Suedoestlich befindet sich ein Gewaechshaus in dem es nach Osten und Sueden weiter zu gehen scheint." );
AddItem(ELFEN_NPC + "elf_std.lpc",REFRESH_DESTRUCT);
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "boden" }),
    "Du stehst auf einen Kreisplatz aus Steintafeln.");    
  AddDetail( ({ "himmel" }),
    "Du siehst einen blauen Himmel durch das Blaetterwerk.");    
  AddDetail( ({ "garten" }),
    "Du befindest Dich in einem Garten.");    
   AddDetail( ({ "weg", "kiesweg", "wege", "kieswege", "kies" }),
    "Kieswege fuehren nach Nordosten und Suedwesten, im Gewaechshaus geht es nach Osten und Sueden weiter.");    
  AddDetail( ({ "stein", "steine", "steintafel", "steintafeln" }),
    "Du stehst aus ihnen. Die Steine, schimmern in einem dunklen Gruen.");    
  AddDetail( ({ "kreisplatz", "kreis", "platz" }),
    "Ein kreisrunder Platz, der aus Steintafeln besteht und 4 Ausgaenge bietet.");    
  AddDetail( ({ "nordosten", "suedwesten", "osten", "sueden", "suedoestlich", "ausgaenge", "ausgaengen", "ausgang" }),
    "Es gibt Ausgaenge nach Nordosten, Suedwesten, Osten und Sueden.");    
  AddDetail( ({ "gruen", "farbe" }),
    "Gruen ist eine Farbe");    
  AddDetail( ({ "kraeutern", "kraeuter" }),
    "Es sind eine Anzahl verschiedener Arten von Kraeuter zu sehen.");    
  AddDetail( ({ "anzahl", "zahl" }),
    "Es sind zuviele zum zaehlen in diesem Garten.");    
  AddDetail( ({ "arten", "art" }),
    "Es sind zu viele und es entzieht sich Dir welche Arten es wohl sein moegen.");    
  AddDetail( ({ "nase" }),
    "Du hast sie in Deinem Gesicht.");    
  AddDetail( ({ "gesicht" }),
    "Du hast sicherlich eins irgendwo.");    
  AddDetail( ({ "gewaechshaus" }),
    "Das Gewaechshaus besteht aus Glasscheiben, die durch Licht in sich hindurch lassen."+
    "Innen gibt es Beete und Toepfe in denen Kraeuter wachsen die noch exotischer sind als die draußen.");    
  AddDetail( ({ "glasscheibe", "glasscheiben", "licht" }),
    "Durch die Glasscheiben faellt Licht in der Gewaechshaus.");    
  AddDetail( ({ "beet", "beete", "beeten", "topf", "toepfe" }),
    "In ihnen wachsen verscheiden Arten von Kraeutern.");    
  AddDetail( ({ "blaetterwerk", "werk", "blaetter" }),
    "Die Baumkronen ueber Dir verhindert eine freie Sicht auf den Himmel.");    
  AddDetail( ({ "baumkronen", "kronen", "baumkrone", "krone" }),
    "Die Baumkronen, unter denen Aboriville auf den starken Aesten der grossen Eichen erbaut wurde, "+
    "sind riesig, sie geben nur teilweise die Sicht auf den Himmel frei.");  
  AddDetail( ({ "sicht", "sehen" }),
    "Nach was schaust Du denn.");  
  AddDetail( ({ "aboriville", "aborivilles" }),
    "Du befindest Dich hier in einem kleinen Garten in der Elfenstadt Aboriville.");  
 AddDetail( ({ "elfenstadt" }),
    "Du befindest Dich in Aboriville.");  
 AddDetail( ({ "aeste", "ast", "aesten" }),
    "Sie sind sehr stark und tragen die Last Aborivilles.");  
 AddDetail( ({ "eichen", "eiche" }),
    "Eichen sind sehr starke Baeume.");  
 AddDetail( ({ "baum", "baeume" }),
    "Du wirst doch wohl wissen was ein Baum ist, oder?");  
 AddDetail( ({ "last" }),
    "Die Last der Elfenstadt Aboriville wird von den starken Aesten alter Eichen getragen.");  
 AddDetail( ({ "liebe", "sorgfalt" }),
    "Der Garten wird mit Liebe und Sorgfalt gepflegt.");  
 AddDetail( ({ "farbe", "farben" }),
    "Der Garten sind Kraeuter in verschiedenen Farben.");  


 AddDetail( ({ "yantar" }),
    "Eine gruenliche Knolle mit gelben Streifen.");  
 AddDetail( ({ "knolle" }),
    "Im Gewaechshaus gibt es sicherlich einige und in den Beeten vieleicht auch.");    
 AddDetail( ({ "streifen" }),
    "Sowas siehst Du hier nicht.");  
      

  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.");

  AddSound( ({ "voegel", "zwitschern" }),
    "Die Voegel zwitschern eine liebliche Melodie.");

  AddSound( ({ "melodie" }),
    "Die Voegel zwitschern melodisch, aber Du kannst sie nicht verstehen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Kraeutern.");
 
  AddSmell( ({ "geruch" }),
    "Der Geruch von Krautern steigt Dir in die Nase.");




AddExit( "nordosten", ELFEN_ROOM  + "aboriville_5g.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_7e.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_6g.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_7f.lpc" ); 


}

