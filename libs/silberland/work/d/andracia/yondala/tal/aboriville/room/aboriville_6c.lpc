// Ein Pup, nur Trinken ohne alk
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Bar" );
  SetProp( P_INT_LONG,
    "Du stehst in einer kleinen, gruenen Bar. Alles um Dich herum besteht aus Blaettern und "
    "Holz. Du bist Dir sicher, dass der Tresen und auch die Barhocker direkt aus dem Boden "
    "gewachsen sind und auch das hoelzerne Regal an der Wand macht den Anschein als waere es "
    "natuerlichen Ursprungs." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "LORION");
  SetProp( P_PUBKEEPER_NAME, "Lorion");
  SetProp( P_PUBKEEPER_GENDER, MALE);
AddItem(ELFEN_NPC + "elf_lorion.lpc",REFRESH_DESTRUCT);

  AddDrink("Tannenbier", ({ "bier", "tannenbier" }),500,15,0,0, //Preis, Volumen, Alk
  ({ 
    "Lorion zapft Dir ein dunkles Tannenbier, Du trinkst es sofort und bist ueberrascht "
    "wie gut es schmeckt. ",
       "&& trinkt ein leckeres Tannenbier."
   }) );
     AddDrink("Erdbeersaft", ({ "saft", "erdbeersaft" }),250,10,0,0, //Preis, Volumen, Alk
  ({ "Lorion greift zwichen die Blaetter der Wand hinter sich und foerdert eine Flasche mit "
    "einer roten Fluessigkeit zu tage und schenkt Dir ein. ",
       "&& bekommt koestlichsten Erdbeerwein serviert."
   }) );
  AddDrink("Seidenraupenmilch", ({ "milch", "raupenmilch","seidenraupenmilch" }),70,5,0,0, //Preis, Volumen, Alk
  ({ "Lorion holt einen Krug frischer Milch hervor und giesst Dir welche ein.\n",
       "&& geniesst einen Becher frische Milch."
   }) );

   AddDetail( ({ "bar", "raum" }),
    "Du befindest Dich in einer kleine, gemuetlichen Bar.");    
   AddDetail( ({ "blaetter" }),
    "Alle Einrichtung, die hier nicht aus Holz besteht, besteht aus Blaettern.");    
   AddDetail( ({ "holz" }),
    "Das Holz sieht sehr solide aus, Du kannst die einzelnen Fasern erkennen, jedoch keine "
    "Jahresringe oder Bearbeitungsspuren");    
   AddDetail( ({ "fasern" }),
    "Du kannst genaus sehen, dass das Holz so gewachsen ist, wie es nun ist.");    
   AddDetail( ({ "jahresringe" }),
    "An denen wuerdest Du das Alter des Holzes erkennen koennen, wenn es denn welche zu sehen "
    "gaebe. Da das Holz aber nicht verletzt ist, kannst Du nichts weiter erkennen.");    
   AddDetail( ({ "alter" }),
    "Ohne Jahresringe ist da nichts zu machen.");    
   AddDetail( ({ "bearbeitungsspuren", "spuren", "bearbeitungsspur", "spur", "abnutzungsspur" }),
    "Entweder sind die Elfen sehr gut darin Holz zu bearbeiten, oder aber das Holz ist so gewachsen, "
    "denn sehen kannst Du keinerlei Spuren.");    
   AddDetail( ({ "tresen" }),
    "Ein solider Tresen ist aus dem Boden gewachsen und teilt nun die kleine Bar in zwei "
    "Bereiche. Auf dem Tresen steht eine kleine Schale.");    
   AddDetail( ({ "bereiche" }),
    "Du stehst vor dem Tresen, der Wirt normalerweise dahinter.");    
   AddDetail( ({ "schale" }),
    "In der Schale befinden sich ein paar Erdnuesse. Die sind bestimmt zu Naschen da.");    
   AddDetail( ({ "naschen" }),
    "Da Du hier Kunde bist, darfst Du bestimmt auch ein paar naschen.");    
   AddDetail( ({ "kunde" }),
    "Jeder, der hier ein Getraenk bestellt ist automatisch ein Kunde.");    
   AddDetail( ({ "getraenk", "angebot", "getraenke", "fluessigkeit", "fluessigkeiten" }),
    "Tippe doch <menue> dann siehst Du das Angebot dieser Bar.");    
   AddDetail( ({ "barhocker" }),
    "Vor dem Tresen stehen vier Barhocker, deren einziges Bein jeweils aus dem Boden gewachsen "
    "zu sein scheint.");    
   AddDetail( ({ "bein" }),
    "Der Barhocker besteht aus einem Bein und einer knotigen, runden Sitzflaeche.");    
   AddDetail( ({ "sitzflaeche" }),
    "Die Sitzflaeche des Barhockers ist relativ rund und sehr knotig. Sie sieht nicht sonderlich "
    "bequem aus.");    
   AddDetail( ({ "regal" }),
    "Hinter dem Tresen steht ein Regal aus Holz in dem sich allerhand Gefaesse und ein paar "
    "Faesser befinden.");    
   AddDetail( ({ "gefaesse" }),
    "Du siehst einige Flaschen, Becher und Kelche.");    
   AddDetail( ({ "flaschen", "kelche", "trinkgefaesse", "becher" }),
    "Als Du etwas genauer hinschaust erkennst Du, dass es riesige Blueten sind, in denen sich "
    "diverse Fluessigkeiten befinden.");    
   AddDetail( ({ "blueten" }),
    "Die Blueten sind besonders gross gewachsen um als Trinkgefaesse zu dienen oder um Getraenke "
    "darin zu lagern.");    
   AddDetail( ({ "faesser" }),
    "Du kannst es natuerlich nicht sehen, bist aber sicher, dass in den Faessern diverse Getraenke reifen.");    
   AddDetail( ({ "anschein", "ursprung" }),
    "Es sieht so aus, sicher bist Du Dir aber nicht.");    
   AddDetail( ({ "boden" }),
    "Der Boden besteht aus solidem Holz ohne irgendeine Bearbeitungs- oder Abnutzungsspur, "
    "er ist sehr sauber und kein Staubkorn liegt auf ihm.");    
   AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen hier aus stabilem, glatten Holz, aus dem ueberall Blaetter und Knospen bluehen.");    
  AddDetail( ({ "knospen", "blumen" }),
    "Die Knospen verheissen Dir einmal wunderschoene Blumen zu werden.");    
  AddDetail( ({ "decke" }),
    "Die Decke ueber Dir laeuft wie eine Kuppel rund zusammen, was den kleinen Raum noch "
    "gedrungener erscheinen laesst. Dicht unter der Decke tummeln sich ein paar Gluehwuermchen.");    
  AddDetail( ({ "wind" }),
    "Hier drin ist es absolut windstill, lediglich draussen weht er leicht.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Sie erhellen den Raum.");    
  AddDetail( ({ "einrichtung" }),
    "Der Raum ist spaerlich eingerichtet. Lediglich ein Tresen steht hier, dahinter befindet "
    "sich noch ein Regal und davor stehen ein paar Barhocker.");    
  AddDetail( ({ "erdnuesse" }),
    "Sie sehen sehr lecker aus.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst ganz leise das Rascheln der Blaetter im leichten Wind.");
  AddSound( DEFAULT_SMELL,
    "Es riecht hier leicht suesslich");

  AddSound( ({ "blaetter","rascheln","wind" }),
    "Es wirkt irgendwie angenehm beruhigend auf Dich.");

 


 AddCmd( ({ "nasche","nasch"}), "naschen" ); 
 AddCmd( ({ "sitz","sitze","setz","setze"}), "sitzen" ); 

AddExit( "westen", ELFEN_ROOM  + "aboriville_6b.lpc" ); 

}

int naschen(string str)
{
  if (str=="nuesse"||str=="erdnuesse"||str=="nuss"||str=="erdnuss"||!str)
    {
      write("Du greifst in die Schale und naschst ein paar Erdnuesse. Sie schmecken koestlich.\n"+
            "Wie von Zauberhand fuellt sich die Schale wieder vollstaendig.\n");
      say (TPN+ " greift in die Schale und nascht ein paar Erdnuesse.\n"+
                "Wie von Zauberhand fuellt sich die Schale wieder vollstaendig.\n");
      }
   else write("Was moechtest Du naschen?\n");
   
   return 1; 
  
  }


int sitzen(string str)
{
  if (str=="auf hocker"||str=="auf barhocker"||!str)
    {
      write("Du setzt Dich auf einen freien Hocker. Da er aber recht unbequem ist stehst Du "+
      " gleiche wieder auf.\n");
      say (TPN+ " setzt sich kurz, verzieht das Gesicht und steht wieder auf.\n");
      }
   else write("Worauf moechtest Du sitzen?\n");
   
   return 1; 
  
  }