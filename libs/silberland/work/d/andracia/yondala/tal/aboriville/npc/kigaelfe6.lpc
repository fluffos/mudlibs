inherit ELFEN_NPC+"kigaelfe_std.lpc";


int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(2);
switch (wer)

{
	case 0:{name="Tamosa";
  AddInfo( ({"tamosa"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Bimalandon und Linola.",
