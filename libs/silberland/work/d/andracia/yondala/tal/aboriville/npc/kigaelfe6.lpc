    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Famione und Zylia.",
    "sagt: ");
  AddInfo( ({"golain","selo"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"famione","zylia"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","bimalandon"}),
    "Meines Vaters Name ist Bimalandon.",
    "sagt: ");
