#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Gewaechshauses" );
  SetProp( P_INT_LONG, "Du steht nun im Suedostteil des Gewaechshauses. "+
    "In einer Ecke seht ein Springbrunnen der die Luft mit einer fuer die "+
    "Kraeuter noetigen Luftfeuchtigkeit versorgt. "+
    "Ansonsten sind um Dich herum ueberall Beete mit Kraeutern in den verschiedensten Farben." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_FOREST]) );
  AddItem(ELFEN_NPC + "kaefer.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "boden", "weg", "rinde", "baeume" }),
    "Du laeufst auf einem Weg, der aus abgefallener Rinde alter Baeume besteht.");    
  AddDetail( ({ "waende", "wand", "glaswand", "glaswaende" }),
    "Glaswaende lassen Sonnenlicht hereindringen.");    
  AddDetail( ({ "decke", "glasdach", "dach" }),
    "Ein Glasdach, welches das Sonnenlicht herrinscheinen laesst.");    
  AddDetail( ({ "sonnenlicht", "sonnenstrahl", "sonnenstrahlen" }),
    "Sonnenstrahlen fallen durch das Glasdach und die Glaswaende herein.");    
  AddDetail( ({ "gewaechshauses", "gewaechshaus", "suedostteil" }),
    "Du stehtst im Suedostteil des Gewaechshauses.");
  AddDetail( ({ "beet", "beete", "kraeuter", "kraut" }),
    "Es sind etliche und Dir alle unbekannt.");    
  AddDetail( ({ "farben" }),
    "Du siehst verschieden farbige Kraeuter.");    
  AddDetail( ({ "luftfeuchtigkeit", "luft", "feuchtigkeit", "klima" }),
    "Die Feuchtigkeit hier ist stark erhoeht, um den Kraeutern ein gutes Klima zu ermoeglichen.");    
  AddDetail( ({ "springbrunnen", "springbrunnens", "brunnen" }),
    "In der Ecke steht ein Springbrunnen, der vor sich hin plaetschert."+
    "Ein kleines Holzschild steht daneben.");
  AddDetail( ({ "schild", "holzschild" }),
    "Ein kleines solides Holzschild. Du kannst es lesen.");    
  AddDetail( ({ "Eck", "Ecke", "Ecken" }),
    "In einer Ecke steht ein Springbrunnen.");    

  
  AddReadDetail( ({ "schild", "holzschild" }),
    "Bitte nicht aus dem Brunnen trinken.\n"+
    "         Kein Trinkwasser !!!");
        
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Plaetschern des Springbrunnens klar und deutlich.");
    
  AddSound( ({ "springbrunnens", "springbrunnen", "brunnen", "plaetschern", "plaetschert" }),
    "In der Ecke steht ein Springbrunnen, der vor sich hin plaetschert.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach den verschiedensten Kraeutern, die hier wachsen.");



AddExit( "norden", ELFEN_ROOM  + "aboriville_6g.lpc" ); 
AddExit( "westen", ELFEN_ROOM  + "aboriville_7f.lpc" ); 

}

