#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

int sitztwer=0;
string name;
int schwingstatus=0;
int schaukelnimgange= 0;
object schaukler;
void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Pausenhof"); 
  SetProp(P_INT_LONG, 
  		"Du stehst auf dem Pausenhof welches das Zentrum des Kindergartens bildet. "
  		"Hier stehen einige Spielgeraete fuer die Kindergartenkinder und "
  		"auch fuer die etwas aelteren Kinder, die hier ihre Schulpausen verbringen "
  		"duerfen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
AddItem(ELFEN_NPC + "kigaelfe4.lpc",REFRESH_DESTRUCT);  		
AddItem(ELFEN_NPC + "elfe_nanna.lpc",REFRESH_DESTRUCT);  		
  		 
  AddDetail( ({ "pausenhof" }),
    "Du stehst auf dem Pausenhof, hier spielen die Kinder in den Pausen.");    
  AddDetail( ({ "pausen","pause", "schulpausen" }),
    "Jeder braucht ab und zu mal eine Pause, in der man sich austoben kann.");    
  AddDetail( ({ "kinder","elfenkinder","kindergartenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "zentrum", "mitte" }),
    "Du befindest Dich in der Mitte des Kindergartens. Von hier aus gelangst Du in"
    "alle anderen Raeume.");    
  AddDetail( ({ "spielgeraete", "geraete", "spielgeraet", "geraet" }),
    "Hier stehen einige Spielgeraete. Du siehst eine Rutsche und "
    "ein Schaukel, die aus den Aesten ueber Dir herunter haengt.");    
  AddDetail( ({ "rutsche" }),
    "Das Holz der Rutsche ist blank gescheuert und Du bist sicher, dass hier"
    "schon einige Kinder herunter gerutscht sind.");    
  AddDetail( ({ "schaukel" }),
    "Die Schaukel schwingt lustig hin und her.");    
  AddDetail( ({ "raeume" }),
    "Lauf doch einfach herum und schau Dir an, was es in diesem Kindergarten alles zu entdecken gibt.");    
  AddDetail( ({ "wind" }),
    "Du spuerst einen leichten Wind auf Deiner Haut.");    
  AddDetail( ({ "haut" }),
    "Die ist noch mehr oder weniger heile.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume und frohes Kinderlachen.");

	AddSmell( DEFAULT_SMELL,
	"Es riecht hier nach Natur."); 
  AddSound( ({ "lachen","kinder","kinderlachen" }),
    "Es klingt froehlich.");
  AddSound( ({ "rauschen","baeume","wind" }),
    "Die Baeume rauschen leise im Wind.");

 
  AddSmell( ({ "" }),
    "");



AddExit( "osten", ELFEN_ROOM  + "aboriville_2g.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_1g.lpc" ); 
AddExit( "westen", ELFEN_ROOM  + "aboriville_2e.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_3e.lpc" ); 
AddExit( "norden", ELFEN_ROOM  + "aboriville_1f.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_3f.lpc" ); 
AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_1e.lpc" ); 
AddExit( "suedosten", ELFEN_ROOM  + "aboriville_3g.lpc" ); 



	AddCmd(({"rutsche", "rutsch"}), "rutschen"); 
	AddCmd(({"schaukel", "schaukle"}), "schaukeln"); 
	AddCmd(({"setz", "sitze", "setze", "sitz", "kletter","klettere"}), "sitzenCmd"); 
	AddCmd(({"spring", "springe"}), "runterspringen"); 
	AddCmd(({"schwing", "schwinge"}), "schwingen"); 



//Im Standartraum definiert
AddCmd( ({ "pflueck", "pfluecke" }), "pfluecken" );
AddCmd( ({ "bitte" }), "bitten" );
}


int rutschen(string str)
{	notify_fail( "Was moechtest Du herunter rutschen?\n" );

	if(str=="rutsche"||str=="rutsche hinunter"||str=="rutsche runter"||str=="rutsche herunter"||str=="auf rutsche"||!str)
		{
			write ("Du kletterst die Rutsche hoch und rutschtst sie mit einem lauten "+
			"HUUUUUIII herunter.\nWas fuer ein Spass.\n");
			say (TPN+" rutscht vergnuegt die Rutsche herunter.\n");
			return 1;
			}
	return 0;
}

int schaukeln(string str)
{
	if(name!=TPN)
		{
			write ("Du sitzt doch gar nicht auf der Schaukel.\n");
			return 1;
			}
			
	notify_fail( "Womit moechtest schaukeln?\n" );
	if (str =="mit schaukel"||!str)
		{	
			write("Dazu musst Du Deine Beine schwingen.\n");
			return 1;
		}
return 0;
}



int sitzenCmd(string str)
{  	
  notify_fail( "Worauf moechtest Du sitzen?\n" );
  if (str!="auf schaukel")
    return 0;
  if (name==TPN)
	{
	  write ("Du sitzt doch bereits!\n");
	  return 1;
	  }
	
  else //also wenn er noch nicht sitzt
	{
	  if(sitztwer==0)
		{
		  write("Du setzt Dich auf die Schaukel.\n");
		  say (TPN+" setzt sich auf die Schaukel.\n", TP);
		  TP->SetProp(P_NOMOVE, "Du sitzt auf der Schaukel und solltest erst herunter springen.\n");
		  sitztwer =1;
		  schaukler=TP;
		  name=TPN;
		  AddDetail( ({ "schaukel" }),
    	  TPN+" sitzt auf der Schaukel.");    
          
		 }
	  if(sitztwer==1)
		write ("Auf der Schaukel sitzt doch schon "+capitalize(name)+".\n");
	  return 1;
		 
	}
return 0;
}




int runterspringen(string str)
 {
   notify_fail( "Moechtest von der Schaukel springen?\n" );
    if (str=="von schaukel"||str=="herunter"||str=="runter"||
	    str=="von schaukel runter"||str=="von schaukel herunter")
  	{
	  if (name!=TPN)
      {
	    notify_fail("Du sitzt doch gar nicht auf der Schaukel!\n");
	    return 0;
		}
	
	switch(schwingstatus)
	  {
		case 0:
		{
		  write ("Du nimmst Schwung und springst mit einem grossen Satz von der Schaukel.\n");
		  say (TPN+" nimmt Schwung und springt mit einem grossen Satz von der Schaukel.\n", TP);
  		  schaukler->SetProp(P_NOMOVE, 0);
    	  AddDetail( ({ "schaukel" }), 
		               "Die Schaukel schwingt lustig hin und her.");    
		  sitztwer=0;
		  name="\nkeinerda";
		  schaukelnimgange=0;
		  schwingstatus=0;
		  break;
		}
		case 1:		
		{
		  write ("Du nimmst Schwung und springst mit einem grossen Satz von der Schaukel.\n");
		  say (TPN+" nimmt Schwung und springt mit einem grossen Satz von der Schaukel.\n", TP);
  		  TP->SetProp(P_NOMOVE, 0);
    	  AddDetail( ({ "schaukel" }),
    		"Die Schaukel schwingt lustig hin und her.");    
		  sitztwer=0;
		  name="\nkeinerda";
		  schaukelnimgange=0;
		  schwingstatus=0;
		  break;
		}	
		case 2:		
		  {
			write ("Du nimmst Schwung und springst mit einem grossen Satz von der Schaukel.\nDabei schlaegst Du Dir das Knie auf.\n");
			say (TPN+" nimmt Schwung und springt mit einem grossen Satz von der Schaukel und schlaegt sich dabei ein Knie auf.\n", TP);
  			TP->AddHP(-5);
  			TP->SetProp(P_NOMOVE, 0);
    		AddDetail( ({ "schaukel" }),
    		  "Die Schaukel schwingt lustig hin und her.");    
			sitztwer=0;
			name="\nkeinerda";
			schaukelnimgange=0;
			schwingstatus=0;
			break;
			}											
		case 3:		
		  {
		    write ("Du nimmst Schwung und springst mit einem grossen Satz von der Schaukel.\nDabei schlaegst Du Dir beide Knie auf.\n");
			say (TPN+" nimmt Schwung und springt mit einem grossen Satz von der Schaukel und schlaegt sich dabei beide Knie auf.\n", TP);
  			TP->AddHP(-10);
  			TP->SetProp(P_NOMOVE, 0);
    		AddDetail( ({ "schaukel" }),
    		"Die Schaukel schwingt lustig hin und her.");    
			sitztwer=0;
			name="\nkeinerda";
			schaukelnimgange=0;
			schwingstatus=0;
			break;
			}			
			default:
			{write ("Dazu schaukelt die Schaukel viel zu doll.\n");}								
		}
   return 1;
			
	}
 return 0;
}


int schwingen(string str)
{
	if(name!=TPN)
		{
			write ("Du sitzt doch gar nicht auf der Schaukel.\n");
			return 1;
			}
			
	notify_fail( "Was moechtest Du schwingen?\n" );
	if (str =="beine"||!str)
		{	
			write("Du schwingst Deine Beine vor und zurueck und wirst immer schneller.\n");
			say(name+" schwingt die Beine vor und zurueck um mehr Schwung zu bekommen.\n");
			schwingstatus++;
			
			if(schaukelnimgange==0)//wenn noch nicht geschaukelt wird
				{	
					schaukelnimgange=1;
					call_out("schwingpruefer",0);}
			return 1;
		}
return 0;
}


void schwingpruefer()
{
	if(schwingstatus>5)
		schwingstatus=5;

	switch(schwingstatus)
	{
		case 0:
			{

				if(name=="\nkeinerda")
					{
						AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}
				AddDetail( ({ "schaukel" }),		
    		name+" sitzt auf der Schaukel.");    
				write("Die Schaukel bleibt stehen.\n");
				say("Die Schaukel mit "+name+" bleibt stehen.\n",TP);
				schaukelnimgange=0;
				break;

				}    
		case 1:
			{
				if(name=="\nkeinerda")
					{
						  AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}
				AddDetail( ({ "schaukel" }),
					name+" sitzt auf der Schaukel und schwingt sanft hin und her.");
				write("Die Schaukel schwingt leicht.\n");
				say("Die Schaukel mit "+capitalize(name)+" schwingt leicht.\n",TP);
				call_out("weniger", 3);
				break;
				}    
		case 2:
			{
				if(name=="\nkeinerda")
					{
						  AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}
				AddDetail( ({ "schaukel" }),
				name+" sitzt auf der Schaukel und schwingt hin und her.");
				write("Die Schaukel schwingt hin und her.\n");
				say("Die Schaukel mit "+capitalize(name)+" schwingt hin und her.\n",TP);
				call_out("weniger", 3);
				break;
				}    
		case 3:
			{
				if(name=="\nkeinerda")
					{
						  AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}
				AddDetail( ({ "schaukel" }),
					name+" sitzt auf der Schaukel und schwingt stark hin und her.");
				write("Die Schaukel schwingt stark vor und zurueck.\n");
				say("Die Schaukel mit "+capitalize(name)+" schwingt stark hin und her.\n",TP);
				call_out("weniger", 3);
				break;
				}    
		case 4:
			{
				if(name=="\nkeinerda")
					{
						  AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}				
				AddDetail( ({ "schaukel" }),
					name+" sitzt auf der Schaukel und schwingt wild hin und her.");
				write("Die Schaukel schwingt wild vor und zurueck.\n");
				say("Die Schaukel mit "+capitalize(name)+" schwingt wild vor und zurueck.\n",TP);
				call_out("weniger", 3);
				break;
				}    
		case 5:
			{
				if(name=="\nkeinerda")
					{
						  AddDetail( ({ "schaukel" }),
						    "Die Schaukel schwingt lustig hin und her.");  
						   break;  
						}				
				AddDetail( ({ "schaukel" }),
					name+" schleudert wild auf der Schaukel hin und her und ueberschlaegt sich fast.");
				write("Die Schaukel schwingt so stark vor und zurueck, dass Du fast "+
				"einen Ueberschlag machst.\n");
				say(capitalize(name)+" macht mit der Schaukel fast einen Ueberschlag.\n",TP);
				call_out("weniger", 3);
				break;
				}    
	}

}

void weniger()
{
	schwingstatus--;
	call_out("schwingpruefer",0);
	
	}
