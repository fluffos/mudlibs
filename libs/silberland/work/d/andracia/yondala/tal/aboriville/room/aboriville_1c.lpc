#include "../def.h"
// Questraum
// eine kranke Elf ist hier die Hilfe braucht

//memo an mich: Waschschuessel fuellbar machen, eventuell kann man irgendwo in der Stadt Wasser auffangen was von den Blaettern tropft

inherit "std/room";

#include <properties.h>
#include <language.h>

void reset()
{
	object ob;
	if (present("\nkrankeselfi",TO))
		{
			ob=present("\nkrankeselfi",TO);
			ob->move("/players/yondala/room/muellhalde", M_GO, "","");
			ob->remove();
			tell_room(TO,"Die kranke Elfe kuschelt sich in ihr Bett.\n");
		}
/*	if (present("tunika",TO))
		{
			ob=present("tunika",TO);
   		ob->remove();
   	}	
   	if (present("guertel",TO))
		{
			ob=present("guertel",TO);
   		ob->remove();
   	}*/
   ::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wohnraum" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem geschmackvoll eingerichteten, aber dennoch sehr natuerlich "
    "wirkendem Raum. Trotz der verschiedenen Moebel zeugen Waende, Boden und Decke davon, "
    "dass Du Dich in der Natur befindest. Du schaust Dir die Einrichtung an und schliesst "
    "daraus, dass hier jemand wohnt.\n Du denkst . o O (Seltsam, sonst verstecken die Elfe "
    "doch ihre Wohnraeume!?)" );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );


  AddDetail( ({ "wohnraum", "raum", "natur", "wohnraeume" }),
    "Du befindest Dich in einem Raum, der zwar natuerlich gewachsen scheint, aber dennoch "
    "edel und geschmackvoll eingerichtet wurde.");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende und die Decke bestehen offensichtlich nur aus Ranken.");    
  AddDetail( ({ "ranken" }),
    "Die Ranken, die die Waende bilden, sind voller gruener Blaetter.");    
  AddDetail( ({ "blaetter", "gruen" }),
    "Die Blaetter der Ranken tauchen den Raum in ein sanftes Gruen.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht genau wie die Waende aus Ranken, dazwischen schwirren ein paar kleine "
    "Gluehwuermchen herum.");    
  AddDetail( ({ "moebel", "einrichtung" }),
    "Du siehst ein Bett, eine Kommode, einen Schrank, einen Tisch und einen Nachttisch. Alle Moebel "
    "scheinen aus dem Boden gewachsen zu sein.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen erhellen den Raum und schwirren unter der Decke zwischen den Ranken umher.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus dem Holz des Baumes, auf welchem Du Dich befindest.");    
  AddDetail( ({ "bett" }),
    "Das Bett scheint aus dem Boden gewachsen und ist voller seidener Kissen und Decken.");    
  AddDetail( ({ "kommode" }),
    "Die Kommode besteht aus Holz. Sie besitzt eine Schublade. Eine kleine Waschschuessel steht darauf.");    
  AddDetail( ({ "holz" }),
    "Der Boden und die Moebel bestehen aus dem Holz des Baumes, auf welchem Aboriville gewachsen ist.");    
  AddDetail( ({ "aboriville", "elfenstadt", "baeumen", "baum", "baeume" }),
    "Du befindest Dich in der Elfenstadt Aboriville, welche hoch in den Baeumen gewachsen ist.");    
  AddDetail( ({ "decken" }),
    "Die Decken in dem hoelzernen Bett sind aus feinster Seide gesponnen.");    
  AddDetail( ({ "seide" }),
    "Die Seide sieht sehr weich aus.");    
  AddDetail( ({ "kissen" }),
    "Die Kissen sind aus feinster Seide und scheinen sehr weich gefuellt zu sein. "
    "Auf dem Kissen ruht ein bleiches Gesicht.");    
  AddSpecialDetail( ({ "gesicht"  }), "gesicht" );
//  AddSpecialDetail( ({ "waschschuessel","schuessel"  }), "schuessel" );//soll man nehmen koennen, wenn man die Quest noch nicht hat und eine da ist.
  AddDetail( ({ "schublade" }),
    "Die Schublade ist verschlossen.");    
  AddDetail( ({ "nachttisch" }),
    "Der Nachttisch steht direkt neben dem Bett, ein Buch liegt darauf.");   
  AddDetail( ({ "schrank" }),
    "Darin bewahrt bestimmt der Besitzer des Hauses seine persoenlichen Dinge auf. Er hat zwei grosse, schwere Tueren.");    
  AddDetail( ({ "buch" }),
    "Das Buch sieht sehr teuer und edel aus.");    
  AddDetail( ({ "besitzer" }),
    "Vielleicht kannst Du ja noch rausfinden, wem dieser Wohnraum gehoert.");    
  AddDetail( ({ "dinge" }),
    "Da die Dinge vermutlich IM Schrank sind, kannst Du sie nicht sehen.");    
  AddDetail( ({ "tueren","schranktueren","schranktuer", "tuer" }),
    "Die zwei Schranktueren verwahren den Inhalt des Schranks sicher.");    
  AddDetail( ({ "tisch" }),
    "Auf dem Tisch steht ein Teller.");    
  AddDetail( ({ "teller" }),
    "Auf dem Teller liegt eine angegessene Mahlzeit herum.");    
  AddDetail( ({ "mahlzeit","essen" }),
    "Du bist Dir nicht sicher, ob dieses Essen noch geniessbar ist.");    
  AddDetail( ({ "schuessel", "waschschuessel" }),
    "Sie ist leer.");    
  AddDetail( ({ "richtung" }),
    "Schau halt hin.");    
  AddDetail( ({ "schuessel","waschschuessel" }),
    "Du siehst eine kleine, weisse Waschschuessel.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "buch" }),
    "Du liest das Buch, es ist nur maessig spannend, das einzige, was Du behaelst ist, dass der "
    "Moerder der Gaertner war.\nDu denkst . o O  (Wer auch sonst!?)");
  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst einen leise rasselnden Atem.");

  AddSound( ({ "atem","rasseln" }),
    "Er kommt aus Richtung Bett.");

 
  AddSmell( ({ "essen","mahlzeit" }),
    "Uah, nein, das ist definitiv nicht mehr geniessbar.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier fast nur nach Natur.");



AddExit( "sueden", ELFEN_ROOM  + "aboriville_2c.lpc" ); 
	AddCmd(({"oeffne"}), "oeffnen"); 
	AddCmd(({"wasche","wasch"}), "waschen"); 
	AddCmd(({"iss","ess","esse"}), "essen"); 

}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
      result = BS("Du befindest Dich in einem geschmackvoll eingerichteten, aber dennoch sehr natuerlich "
    "wirkendem Raum. Trotz der verschiedenen Moebel zeugen Waende, Boden und Decke davon, "
    "dass Du Dich in der Natur befindest. Du schaust Dir die Einrichtung an und schliesst "
    "daraus, dass hier jemand wohnt.");
    }
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}
 
string gesicht()
{
	object obj;
	
	if (present("\nkrankeselfi",TO))
		return "Eine kranke Elfe liegt in dem Bett.\n"; 
    
  CLONE(ELFEN_NPC + "elfe_krank.lpc", environment(TP));
	return "";

}


	
int oeffnen(string str)
{notify_fail("Was willst Du oeffnen?\n");
	if (str=="schrank"||str=="schranktuer")
		{
			write("Du ruettelst und zerrst an der Schranktuer, bekommst den Schrank aber nicht auf.\n");
			say(TPN+ " ruettelt an einer Schranktuer.\n");
			return 1;
			}
	if (str=="schublade")
		{
			write ("Du zerrst wie wild an der kleinen Schublade, kannst sie aber nicht oeffnen.\n");
			say(TPN+" versucht eine Schublade zu oeffnen.\n");
			return 1;
		}
	
	return 0;
	}
	
	
int waschen(string str)//FP 
{
	notify_fail("Worin moechtest Du Dich waschen?\n");
	if (str=="in schuessel"||str=="in waschschuessel")
		{
			write("Du spritzt Dir ein bisschen Wasser ins Gesicht und unter "
			"die Arme und schuettelst Dich.\nDu fuehlst Dich erfrischt.\n");
			say(TPN+ " waescht sich.\n");
			return 1;
			}
		
	
	return 0;
	}
int essen(string str)//FP 
{
	notify_fail("Was moechtest Du essen?\n");
	if (str=="essen"||str=="mahlzeit"||str=="essensreste")
		{
			write("Irgendwie sieht das ganze nicht mehr so sonderlich appetittlich aus, deswegen laesst Du es lieber.\n");
			return 1;
			}
		
	
	return 0;
	}		