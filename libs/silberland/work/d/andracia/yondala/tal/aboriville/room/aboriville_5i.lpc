#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
   SetProp( P_INT_SHORT, "Auf einer Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einer schaukelnden Haengebruecke die den Wachweg mit "
    "der Stadt der Elfen verbindet. Rund um Dich herum befinden sich die Aeste "
    "der Baeume, nach Suedosten kannst Du die Haengebruecke verlassen und den Wachweg betreten." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "haengebruecke","bruecke" }),
    "Du stehst auf einer leicht schwankenden Haengebruecke die durch die Kronen "
    "der Baeume hindurch den Wachweg mit der Stadt Aboriville verbindet.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus zu Planken verwachsenen Aesten. Auch wenn er leicht schwankt "
    "bist Du Dir ziemlich sicher, dass er Dich tragen kann. Rechts und links von Dir winden sich "
    "dicke Lianen entlang, sodass Du Dich trotz des schwankenden Bodens leicht fortbewegen kannst.");    
  AddDetail( ({ "lianen" }),
    "Die Lianen bestehen aus Pflanzenfasern und bieten Dir Halt.");    
  AddDetail( ({ "halt" }),
    "Wenn die Bruecke zu sehr schwankt kannst Du Dich an den Lianen festhalten.");    
  AddDetail( ({ "planken" }),
    "Die Planken schwanken unter Dir im Wind.");    
  AddDetail( ({ "wind" }),
    "Ein sehr leichter Wind weht hier.");    
  AddDetail( ({ "suedosten" }),
    "Im Suedosten von Dir befindet sich der Wachweg, Du kannst ihn betreten.");    
  AddDetail( ({ "wachweg" }),
    "Auf dem Wachweg patroullieren die Elfenwaechter und halten nach Feinden Ausschau.");    
  AddSpecialDetail( ({ "feinde","feind" }),"feindcheck");    
  AddDetail( ({ "pflanzenfasern" }),
    "Hier waechst alles so, wie die Elfen es benoetigen. Sie brauchen die Baeume nur darum zu bitten.");    
  AddDetail( ({ "wachweg" }),
    "Der liegt oestlich von Dir.");    
  AddDetail( ({ "wald" }),
    "Du bist hier von Wald umgeben.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hier ist kaum etwas zu hoeren.");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");



AddExit( "suedosten", ELFEN_ROOM  + "aboriville_6j.lpc" ); 
AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_4h.lpc" ); 
AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );
}

string feindcheck()
{
	if(TP->QueryProp(P_GUILD)=="Pirat"&&TP->id("Elfenspieler")||present ("\nelfenkiller", TP))
		return("Du bist einer von Ihnen, also sei vorsichtig.\n");
		
	else
		return("Die Elfenwaechter erkennen Feinde meist schon, wenn sie durch den Wald unterhalb "
						"der Stadt laufen und reagieren sofort.");	
	
	}
