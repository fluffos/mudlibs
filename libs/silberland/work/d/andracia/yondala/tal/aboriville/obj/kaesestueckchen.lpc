inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kaesestueckchen");
  SetProp(P_LONG,
    "Ein leckeres kleines Stueckchen Kaese. Es duftet herrlich und sieht auch noch sehr schmackhaft aus." );
  SetProp(P_NAME, "Kaesestueckchen");
  SetProp(P_GENDER, NEUTER);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:5, 
											 F_HEAL:({5,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du knabberst ein kleines Kaesestueck.", 
											 F_MSG_ROOM: "knabbert ein kleines Kaesestueck."]));


  AddId("kaese","kaesestueck","kaesestueckchen","stueckchen");

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 40);


 
}

