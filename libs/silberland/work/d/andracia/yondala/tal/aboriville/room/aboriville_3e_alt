int haengen(string str)
{
	notify_fail("Was moechtest Du aufhaengen?\n");
	if (!str) return 0;
	write ("Du bist Dir nicht sicher, ob die Haken so etwas aushalten, also laesst Du es lieber.\n"); 
}


int brechen(string str)
{
	notify_fail("Was moechtest Du abbrechen?\n");
	if (str!="zweig"&&str!="zweig ab") return 0;
	if(zweig)
		{
			write ("Du brichst einen kleinen Zweig ab und steckst ihn ein.\n"); 
			say(TPN+" bricht einen kleinen Zweig ab und steckt ihn ein.\n",TP);
			CLONE(ELFEN_OBJ+"kleinerzweig.c", TP);
			zweig--;	
		}
		else
			write ("Es ist gerade keiner in Deiner Naehe, vielleicht solltest Du ein bisschen warten, bis die Zweige nachgewachsen sind.\n");
			return 1;
}

int klauben(string str)
{
	notify_fail("Was moechtest Du klauben?\n");
	if(str=="tunika"
	 ||str=="tunika von haken"
	 ||str=="tunika von zweig"
	 ||str=="tunika und guertel"
	 ||str=="tunika und guertel von haken"
	 ||str=="tunika und guertel von zweig"
	 ||str=="guertel"
	 ||str=="guertel von haken"
	 ||str=="guertel von zweig"
	 ||str=="kleidung"
	 ||str=="kleidung von zweig"
	 ||str=="kleidung von haken")
	 {
	 	if(da)
	 		{//noch test auf Spielerstufe rein
	 			if(TP->QueryProp(P_LEVEL)>10)
	 				{
	 					write("Dafuer bist Du nun wirklich schon zu gross.\n");
	 					return 1;
	 					}
	 			write("Du klaubst die Kleidung von den Haken.\n");
	 			say(TPN+" klaubt etwas von einem Haken.\n",TP);
	 			CLONE(ELFEN_ARMOUR +"grosseelfentunika.c", TP);
	 			CLONE(ELFEN_ARMOUR +"elfenguertel.c", TP);
	 			da=0;
	 		  AddDetail( ({ "bedarf","moment", "sachen" }),
			    "Im Moment haengt dort nichts.");    
			  AddDetail( ({ "haken" }),
    			"Die meisten Zweige wurden abgebrochen, im Moment haengt dort aber auch nichts. ");    
			  RemoveDetail("tunika");
  			RemoveDetail("guertel");
  			RemoveDetail("kleidungsstuecke");
  
 			
	 			return 1;
	 			}
		else
			{
				write ("Es haengt nichts an den Haken.\n");
				return 1;
				}
			}
	return 0;
}


int nehmen(string str)
{
	notify_fail("Was moechtest Du nehmen?\n");
	if(str=="etwas"	 ||str=="dolch")
	 {
	 	if(dadolch)
	 		{
	 			if(TP->QueryProp(P_LEVEL)>10)
	 				{
	 					write("Dafuer bist Du nun wirklich schon zu gross.\n");
	 					return 1;
	 					}
	 			write("Du nimmst einen kleinen Dolch aus dem Regal.\n");
	 			say(TPN+" nimmt einen Dolch aus dem Regal.\n",TP);
	 			CLONE(ELFEN_WEAPON +"kleinerelfendolch.c", TP);
	 			dadolch=0;
			  RemoveDetail( "dolch" );    
  			RemoveDetail( "etwas" );    
    		AddDetail( ({ "regale", "regal" }),
    			"Die kleinen Regale sind aus der Wand gewachsen und bieten genug Platz fuer die Kleidung der Kinder.");    

 			
	 			return 1;
	 			}
			}
	return 0;
}