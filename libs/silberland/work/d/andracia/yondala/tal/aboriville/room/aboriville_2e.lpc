#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";

#include <properties.h>
#include <language.h>

string wer;
string was;
string aktStr;
int voll = 1;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Klassenzimmer");
  SetProp(P_INT_LONG, 
  		"Du stehst mitten im Klassenzimmer der kleinen Elfenschule von Aboriville."
  		"Hier stehen einige Tische und Stuehle, an den Waenden haengen Plakate und "
  		"eine Tafel, ansonsten ist der Raum recht leer. ");  
  AddItem(ELFEN_NPC + "elf_anarion.lpc",REFRESH_DESTRUCT);
  AddItem(ELFEN_NPC + "elfenschueler1.lpc",REFRESH_DESTRUCT);
  AddItem(ELFEN_NPC + "elfenschueler2.lpc",REFRESH_DESTRUCT);
  AddItem(ELFEN_NPC + "elfenschueler3.lpc",REFRESH_DESTRUCT);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  
   AddDetail( ({ "kinder","elfenkinder", "schueler", "elfenschueler" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "schule", "elfenschule" }),
    "Du befindest Dich hier Klassenzimmer der kleinen Elfenschule von Aboriville. "
    "Hier kommen alle Elfenkinder nach ihrer Kindergartenzeit hin. Manchmal nehmen "
    "aber auch Austausschueler am Unterricht teil.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen am Unterricht der Elfenschule teilnehmen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "kindergartenzeit" }),
    "Nach ihrer Kindergartenzeit muessen die Elfenkinder in die Schule gehen.");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen hier wie alles in Aboriville aus Holz. Allerdings wurden "
    "an ihnen hier einige Plakate befestigt. An einer Wand ist die Tuer, durch die "
    "Du gekommen bist. An der gegenueberliegenden Wand haengt eine Tafel.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "decke" }),
    "Die hohe, helle Decke ist aus Holz. Ein paar kleine Gluehwuermchen schweben darunter.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen spenden dem Raum zusaetzliches Licht.");    
  AddDetail( ({ "licht" }),
    "Durch die Tuer faellt ein bisschen Sonnenlicht und auch die Gluehwuermchen unter der "
    "Decke erhellen den Raum.");    
  AddDetail( ({ "sonnenlicht","sonne" }),
    "Das Licht der Sonne erhaelt den Raum.");    
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer hast Du das Klassenzimmer betreten und kannst es auch wieder verlassen. Sie fuehrt nach Osten.");    
 
   AddDetail( ({ "tafel" }),
    "Auf dieser Tafel schreibt der Lehrer. Manchmal kritzeln aber auch die Schueler "
    "darauf herum. Unten an der Tafel haengt ein kleines Schwaemmchen." );
  AddDetail( ({ "schwaemmchen","band" }),
    "Ein Schwaemmchen baumelt an einem Band unter der Tafel. Mit ihm kann man die Tafel sicherlich wischen.");
  AddDetail( ({ "raum","zimmer","klassenzimmer" }),
    "Du befindest Dich im einzigen Klassenzimmer der kleinen aber dennoch "
    "beruehmten Elfenschule von Aboriville.");    
  AddDetail( ({ "stuehle" }),
    "Auf denen sitzen die Schueler waehrend des Unterrichts. Sie sind aus dem Boden heraus gewachsen.");    
  AddDetail( ({ "tische","tisch" }),
    "An den Tischen sitzen die Schueler waehrend des Unterrichts. Sie sind aus dem Boden heraus gewachsen.");    
  AddDetail( ({ "unterricht" }),
    "Der Unterricht findet in diesem Raum statt.");    
  AddDetail( ({ "boden" }),
    "Wie alles in Aboriville ist auch hier der Boden aus Holz.");    
  AddDetail( ({ "plakate" }),
    "Auf den Plakaten steht der Lernstoff fuer die Schueler.");    
  AddDetail( ({ "lernstoff" }),
    "Auf den Plakaten stehen die Dinge, die fuer die Elfenschueler wichtig sind.");    
  AddDetail( ({ "dinge" }),
    "Dort steht der richtige Umgang mit der Natur, mit Magie und mit Waffen beschrieben.");    
  AddDetail( ({ "umgang", "magie","waffen" }),
    "Es ist sehr wichtig, dass die jungen Elfen das lernen.");    
  AddDetail( ({ "natur", "einklang" }),
    "Die Elfen leben im Einklang mit der Natur.");    
  AddDetail( ({ "himmel" }),
    "Den kannst Du leider von hier aus nicht sehen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddReadDetail( "tafel",
       "Noch ist die Tafel leer." );

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume und frohes Kinderlachen.");

	AddSmell( DEFAULT_SMELL,
	"Es riecht hier nach Natur."); 
  AddSound( ({ "lachen","kinder","kinderlachen" }),
    "Es klingt froehlich.");
  AddSound( ({ "rauschen","baeume","wind" }),
    "Die Baeume rauschen leise im Wind.");
 
  AddSmell( ({ "" }),
    "");




	AddExit( "osten", ELFEN_ROOM  + "aboriville_2f.lpc" ); 
	
	AddCmd(({"setz", "sitze", "setze", "sitz"}), "sitzenCmd"); 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
  AddCmd(({"kritzel", "kritzle","schreibe","schreib"}), "kritzelnCmd");
  AddCmd(({"wisch", "wische"}), "wischenCmd");
}

int kritzelnCmd(string str){
	aktStr = this_player()->_unparsed_args();	// verhindert das die mudlib den Text parsed
	if (!aktStr)
		{write("Was kritzelst Du denn?\n");
			return 1;}
		else
			{
	  if (voll > 0)
	    {
	      write( "Du kritzelst auf der Tafel rum.\n");
	      say(TPN + " kritzelt auf Yondalas Tafel rum.\n");
	      voll = 0;
	      was = aktStr;
	      wer = TPN;
	      AddReadDetail( ({"tafel" }),
	        "Auf der Tafel steht mit krakelieger Handschrift:\n"+was+"\n");
	      AddDetail( ({"handschrift" }),
	        "Die Handschrift sieht aus wie die von " + wer + ".");
	      return 1;
	    }
	  else{
	  	write ("Die Tafel ist schon so voll, Du solltest sie erst wischen.\n");
	    return 1;}
	    }
	  }

int wischenCmd(string str)
{  notify_fail( "Was moechtest Du wischen?\n" );
  if (str == "tafel"||str =="die tafel")
      {write ("Du wischst die Tafel mit dem kleinen Schwaemmchen.\n");
      	say( TPN +" wischt die Tafel mit dem kleinen Schwaemmchen.\n", TP);
      voll = 1;
      was = " ";
      wer = " ";

  AddDetail( ({"handschrift" }),
      "Die Tafel ist nicht beschriftet.");
  AddReadDetail( "tafel",
       "Die Tafel ist frisch gewischt." );
          return 1;}
}


int sitzenCmd(string str)
 {  	
  notify_fail( "Worauf moechtest Du sitzen?\n" );
  if (str!="auf stuhl")
  	return 0;
if (this_player()->QueryProp(P_NOMOVE)!=0)
	{write ("Du sitzt doch bereits!\n");
	return 1;}
	
	else //also wenn er noch nicht sitzt
		{write ("Du setzt Dich auf einen Stuhl.\n");
			say (TPN+" setzt sich auf einen Stuhl.\n", TP);
		TP->SetProp(P_NOMOVE, "Du sitzt auf einem Stuhl und solltest erst aufstehen.\n");
		return 1;}
			
}




int aufstehenCmd(string str)
  {  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
if (str=="auf"||!str)
  	{

if (this_player()->QueryProp(P_NOMOVE)!="Du sitzt auf einem Stuhl und solltest erst aufstehen.\n")

	{write ("Du sitzt doch gar nicht!\n");
	return 1;}
	
	else 
	  {
	    write ("Du stehst von dem Stuhl auf.\n");
		say (TPN+" steht von dem Stuhl auf.\n", TP);
        TP->SetProp(P_NOMOVE, 0);
		return 1;}
	}
return 0;
}