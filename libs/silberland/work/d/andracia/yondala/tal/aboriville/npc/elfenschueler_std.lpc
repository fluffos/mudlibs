//Standartkindergartenelfe

inherit "std/npc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <npc.h>



void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}
//string name;
int wer;
//string name;
  //SetProp(P_LOG_INFO, "yondalas_antworten");
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp( P_REJECT, ({ REJECT_DROP,
    name()+" will Deine Sachen nicht tragen.\n" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 600);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Kindermoerder!");
  SetProp(P_KILL_NAME, "Ein Elfenkind");
  SetProp(P_KILL_MSG, "Was, Du laesst Dich von einem Kind toeten?");

  AddInfo(DEFAULT_INFO, "sagt: Das darf ich Fremden nicht erzaehlen.\n");
  AddInfo( ({"fremde","fremder"}),
    "Ihr seid ein Fremder.",
    "sagt: ");
  AddInfo( ({
"alanel","alari","aliaria","alriel","ambelio",
"belina","bimalandon","enrael","faemil","famione",
"felerian","fenwen","fesieel","garansa ","golain","hiara","imalaian","laia",
"linel","linla","linlaen","linlala","linola","linwen","lonola","lorion","lutana",
"meldo","melina","minda","mindala","miranola ","miranyl","mondol","nalda",
"navalla","nela","nerael","neraen","odania","pheralas", "pholdolur","ranari",
"riaona","saladion","selo","semione","sowena","sutana","tamosa",
"teluwen","thorasa ","vindo","zylia"}),

"Ueber Einwohner Aborivilles darf ich keine Auskunft geben.", //sonst brech ich zusammen
    "sagt: ");
  AddInfo( ({"anarion","lehrer"}),
    "Anarion heisst unser Lehrer in der Elfenschule.",
    "sagt: ");
  AddInfo( ({"schule","elfenschule"}),
    "Alle Elfenkinder gehen erst in den Kindergarten und dann in die Schule. Dort werden wir auf das Leben vorbereitet.",
    "sagt: ");
  AddInfo( ({"andvare", "hohepriester"}),
    "Andvare ist der Hohepriester von Aboriville.",
    "sagt: ");
  AddInfo( ({"ariana","hohepriesterin"}),
    "Ariana ist die Hohepriesterin von Aboriville.",
    "sagt: ");
  AddInfo( ({"belenos","weise","weiser"}),
    "Belenos ist der Vater der Weisheit.",
    "sagt: ");
  AddInfo( ({"almana","weise"}),
    "Almana ist die Mutter der Weisheit.",
    "sagt: ");
  AddInfo( ({"lelo","heiler", "meister der heilkunst"}),
    "Lelo ist der Meister der Heilkunst.",
    "sagt: ");
  AddInfo( ({"alyna","heilerin", "meisterin der heilkunst"}),
    "Alyna ist die Meisterin der Heilkunst.",
    "sagt: ");
  AddInfo( ({"tasinion","heerfuehrer"}),
    "Tasinion ist der Heerfuehrer der Elfen.",
    "sagt: ");
  AddInfo( ({"ayala","heerfuehrerin"}),
    "Ayala ist die Heerfuehrerin der Elfen.",
    "sagt: ");
  AddInfo( ({"brisi","apothekerin", "apotheke"}),
    "Brisi besitzt eine Apotheke hier in Aboriville.",
    "sagt: ");
  AddInfo( ({"riana","sanitaeterelfe"}),
    "Riana hat einen kleinen Talan im Kindergarten. Sie heilt uns, wenn "
    "wir uns mal verletzen.",
    "sagt: ");
  AddInfo( ({"kindergarten",""}),
    "Der Kindergarten von Aboriville ist sehr schoen. Ich bin gerne dorthin gegangen.",
    "sagt: ");
  AddInfo( ({"nanna","kindergaertnerin","kindergaertner"}),
    "Nanna ist die Kindergaertnerin, sie ist sehr lieb.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

         	
	SetProp(P_SPELLRATE, 15);
  SetProp(P_NOMAGIC,5);

	AddSpell(1,200,
	         name()+ " versucht Dich zu schneiden.\n",
	         name()+ " versucht @WEN zu schneiden.\n",
	         ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
	         		         	
	         	
	         	
  SUID;
  CLONEME(ELFEN_WEAPON "kleinerelfendolch.lpc" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "kleineelfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
}

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


void InformDefend(object enemy)
{
 Kill(enemy);
}


void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "findet das lustig.",
        "findet das lustig.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich an.", 
        "laechelt "+TPN+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Dafuer bin ich doch noch zu klein.",
        "sagt: Dafuer bin ich doch noch zu klein.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.", 
        "laechelt "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
