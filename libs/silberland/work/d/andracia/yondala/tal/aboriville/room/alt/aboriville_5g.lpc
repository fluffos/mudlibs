#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Elfenstadt" );
  SetProp( P_INT_LONG,
    "In der Elfenstadt" );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");



AddExit( "westen", ELFEN_ROOM  + "aboriville_5f.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_6g.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_6f.lpc" ); 


}

