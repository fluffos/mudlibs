#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Hoelzerne Armschienen");
  SetProp(P_LONG,
    "Du siehst ein paar hoelzerne Armschienen, die sich ihrem Traeger auf "
    "wundersame Weise perfekt anschmiegen." );

  SetProp(P_NAME, "Armschienen");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armschienen", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([ MAT_BEECH, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 150);
                                       

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_ELECTRIC]) );
   SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:-1]) );


}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
