#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int suessesda=3;

void reset()
{
	::reset();
		if(suessesda<3)
			{
				tell_room(TO,"Ein Elfenkind kommt herein, fuellt die Suessigkeitenschale auf und huepft wieder nach draussen.\n");
				 AddDetail( ({ "schalen" }),
				   "In einer Schale liegen verschiedene Fruechte und in der anderen verschiedene Suessigkeiten.");    
				suessesda=3;
			}
	}
void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In der Essecke");
  SetProp(P_INT_LONG, 
  		"Du stehst in der Essecke des Elfenkindergartens. Ein grosser Tisch mit "
  		"vielen Stuehlen drum herum bildet das Zentrum dieses Talans. Hier wird "
  		"zusammen gegessen und anschliessend noch ein wenig geplappert. Der Tisch ist "
  		"gerade mit tollen Leckereien gedeckt. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
AddItem(ELFEN_NPC + "kigaelfe2.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "essecke" }),
    "Du befindest Dich in einer Essecke.");    
  AddDetail( ({ "tisch" }),
    "Ein grosser Tisch dominiert den Raum, hier koennen die Kinder ihre Mahlzeiten "
    "zu sich nehmen und ein wenig plaudern. Aber auch Tischmanieren werden ihnen hier beigebracht.");    
  AddDetail( ({ "boden" }),
    "Wie alles in Aboriville ist auch hier der Boden aus Holz. Auf ihm stehen ein "
    "Tisch und mehrere Stuehle.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen hier wie alles in Aboriville aus Holz. Allerdings wurden "
    "an ihnen hier einige Bilder befestigt. An einer Wand ist die Tuer, durch die "
    "Du gekommen bist. An der gegenueberliegenden Wand steht ein grosser Schrank.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "decke" }),
    "Die hohe, helle Decke ist aus Holz. Ein paar kleine Gluehwuermchen schweben darunter.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen spenden dem Raum zusaetzliches Licht.");    
  AddDetail( ({ "licht" }),
    "Durch die Tuer faellt ein bisschen Sonnenlicht und auch die Gluehwuermchen unter der "
    "Decke erhellen den Raum.");    
  AddDetail( ({ "sonnenlicht","sonne" }),
    "Das Licht der Sonne erhaelt den Raum.");    
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer hast Du die Essecke betreten und kannst sie auch wieder verlassen. Sie fuehrt nach Sueden.");    
  AddDetail( ({ "raum","essecke" }),
    "Du befindest Dich in der Essecke des Kindergartens von Aboriville. Hier koennen "
    "die Kinder Mahlzeiten zu sich nehmen und plaudern.");    
  AddDetail( ({ "mahlzeiten" }),
    "Meistens bringen die Kinder sich etwas mit oder bitten die Baeume hier um Fruechte.");    
  AddDetail( ({ "baeume", "baum" }),
    "Die ganze Elfenstadt ist in den Baeumen gewachsen. Die Elfen leben im Einklang mit "
    "der Natur und diese schenkt ihnen, was sie zum Leben brauchen.");    
  AddDetail( ({ "natur" }),
    "Die Natur gibt den Elfen worum sie bitten.");    
  AddDetail( ({ "einklang" }),
    "Die Elfen leben voll und ganz im Einklang mit der Natur.");    
  AddDetail( ({ "tisch" }),
    "Auf dem Tisch liegen allerlei Leckereien an denen die Kinder sich bedienen duerfen.");    
  AddDetail( ({ "leckereien" }),
    "Es stehen zwei Schalen dort und ausserdem ein grosser Krug.");    
  AddDetail( ({ "schalen", "schale" }),
    "In einer Schale liegen verschiedene Fruechte und in der anderen verschiedene Suessigkeiten.");    
  AddDetail( ({ "suessigkeiten" }),
    "Von denen naschen die Kinder ab und zu.");    
  AddDetail( ({ "fruechte" }),
    "Die Fruechte locken mit einem lieblichen Duft.");    
  AddDetail( ({ "duft" }),
    "Riech doch mal.");    
  AddDetail( ({ "stuehle", "stuhl" }),
    "Hier sitzen die Kinder immer wenn sie essen oder reden moechten.");    
  AddDetail( ({ "talan" }),
    "Dieser Talan ist mit einigen Stuehlen, einem Tisch und einem Schrank gefuellt."
    "Er dient den Kindern dazu sich zu unterhalten und Mahlzeiten zu sich zu nehmen.");    
  AddDetail( ({ "zentrum" }),
    "Ein grosser Tisch mit zahlreichen Stuehlen bildet das Zentrum dieses Talans.");    
  AddDetail( ({ "krug" }),
    "In dem Krug ist Nektar.");    
  AddDetail( ({ "nektar" }),
    "Den Nektar trinken die Elfenkinder, wenn sie Durst haben.");    
  AddDetail( ({ "bilder" }),
    "An den Waenden haengen froehliche Bilder, die die Kinder gemalt haben.");    
  AddDetail( ({ "schrank" }),
    "Der Schrank ist aus der Wand heraus gewachsen.");    
  AddDetail( ({ "durst" }),
    "Wenn Du welchen hast koenntest Du ja etwas trinken.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das helle Lachen eines Kindes.");
  AddSound( ({ "lachen","kind","kinderlachen" }),
    "Es klingt froehlich und unbeschwert.");
 
	AddSmell( DEFAULT_SMELL,
	"Es riecht hier frisch nach Natur."); 

  AddSmell( ({ "fruechte" }),
    "Die Fruechte riechen frisch und suess. Ob Du eine stibitzen solltest?");



 
  AddSmell( ({ "duft" }),
    "Wirklich verlockend, dieser Duft.");


AddExit( "sueden", ELFEN_ROOM  + "aboriville_2f.lpc" ); 

	AddCmd(({"setz", "sitze", "setze", "sitz"}), "sitzenCmd"); 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
	AddCmd(({"nasche", "nasch"}), "naschen"); 
	AddCmd(({"stibitze", "stibitz", "stiel","stehle","klau","klaue"}), "stibitzen"); 
	AddCmd(({"trinke", "trink"}), "trinken"); 
	AddCmd(({"oeffne"}), "oeffnen"); 

}


int sitzenCmd(string str)
  {  	notify_fail( "Worauf moechtest Du sitzen?\n" );
if (str=="auf stuhl"||!str)
  	{
  		if (this_player()->QueryProp(P_NOMOVE)!=0)
				{write ("Du sitzt doch bereits!\n");
				return 1;}
	
	else //also wenn er noch nicht sitzt
		{write ("Du setzt Dich auf einen kleinen Stuhl.\n");
			say (TPN+" setzt sich auf einen kleinen Stuhl.\n", TP);
		TP->SetProp(P_NOMOVE, "Du sitzt auf einem Stuhl und solltest erst aufstehen.\n");
		return 1;}
		}
	return 0;
}




int aufstehenCmd(string str)
  { 
    notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
if (str=="auf"||!str)
  	{

if (this_player()->QueryProp(P_NOMOVE)!="Du sitzt auf einem Stuhl und solltest erst aufstehen.\n")

	{write ("Du sitzt doch gar nicht!\n");
	return 1;}
	
	else 
		{write ("Du stehst von dem kleinen Stuhl auf.\n");
			say (TPN+" steht von dem kleinen Stuhl auf.\n", TP);
  TP->SetProp(P_NOMOVE, 0);
		return 1;}
		}
return 0;
}

//FP
int naschen(string str)
{
	notify_fail( "Was moechtest Du naschen?\n" );
	if (str !="suesses"&&str!="suessigkeit"&&str!="suessigkeiten")
		return 0;	

	if (suessesda==0)
		{
			write("Die Schale ist doch leer.\n");
			return 1;
		}

	  	//wenn Nanna nicht da ist oder der Spieler Elf ist
	if (!present("nanna", environment(TP))||TP->id("Elfenspieler"))
		{
			write("Du nascht ein bisschen von den Suessigkeiten. Hmmm, lecker.\n");
			say(TPN+" nascht ein paar Suessigkeiten.\n", TP);
			suessesda--;
			if (suessesda==0)
				{  
					AddDetail( ({ "schalen" }),
    				"In einer Schale liegen verschiedene Fruechte, die andere Schaele ist leer, es lagen aber scheinbar einmal Suessigkeiten drin.");    
					}
			return 1;

		}
		else
			{
				write("Nanna haut Dir auf die Finger.\nNanna sagt: Du gehoerst hier nicht her, "+TPN+".\n");
				say("Nanna haut "+TPN+" auf die Finger.\nNanna sagt: Du gehoerst hier nicht her, "+TPN+".\n",TP);
				return 1;
	}
return 0;
}

int stibitzen(string str)
{
	notify_fail( "Was moechtest Du stibitzen?\n" );
	if (str !="obst"&&str !="fruechte"&&str!="frucht")
		return 0;	
	write("Als Du gerade eine Frucht stibitzen willst hoerst Du vor der Tuer "+
		"etwas und laesst es lieber bleiben.\n");
	return 1;
	}


int trinken(string str)
{
	notify_fail( "Was moechtest Du trinken?\n" );
	if (str !="nektar"&&str!="aus krug")
		return 0;
	write("Leider findest Du keinen Becher und weisst nicht, wie Du sonst etwas trinken kannst.\n");
	return 1;
}


int oeffnen(string str)
{
	notify_fail( "Was moechtest Du oeffnen?\n" );
	if (str !="schrank")
		return 0;
	write("Du ruettelst wild an dem Schrank, bekommst ihn aber leider nicht auf. Vermutlich bist Du nicht stark genug.\n");
	say(TPN+" ruettelt an einem Schrank.\n", TP);
	return 1;
}
