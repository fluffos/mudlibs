#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_stdwach.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Nach Nordwesten fuehrt eine kleine Haengebruecke zwischen die Kronen der Baeume. \n" );

//	findewohin("/d/andracia/yondala/tal/room/buchenwald_6j");
 AddItem(ELFEN_NPC + "elfenwaechter.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "bruecke","haengebruecke", "nordwesten" }),
    "Du kannst die Haengebruecke nach Nordwesten hin betreten. Wo sie wohl hinfuehren mag?");    
 

AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_5i.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_7i.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_5k.lpc" ); 
}

int kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
  if( str == "runter"||str == "herunter"||str == "hinunter"||str == "nach unten"||str == "ueber gelaender"||str == "an gelaender runter" )
  {
  	TP->move(BIRKE_ROOM + "buchenwald_6j", M_GO,
  	"","klettert nach unten","klettert einen Baum hinunter");
		write("Du kletterst ueber das Gelaender und am Baum hinab.\n");
    say( TPN+" klettert nach unten.\n");
    return 1;

  }
  return 0;
}