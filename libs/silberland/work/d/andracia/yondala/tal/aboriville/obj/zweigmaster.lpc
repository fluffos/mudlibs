	if(erufe6!="") ausgabe=ausgabe+erufe6;
	if(erufe7!="") ausgabe=ausgabe+erufe7;
	if(erufe8!="") ausgabe=ausgabe+erufe8;
	if(erufe9!="") ausgabe=ausgabe+erufe9;
