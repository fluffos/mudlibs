void jemandruft(string str, object spieler)
{ 
	if(erufe1=="")
		erufe1=spieler->name()+" rief: "+str+"\n";
	else if(erufe2=="")
		erufe2=spieler->name()+" rief: "+str+"\n";	
	else if(erufe3=="")
		erufe3=spieler->name()+" rief: "+str+"\n";		
	else if(erufe4=="")
		erufe4=spieler->name()+" rief: "+str+"\n";		
	else if(erufe5=="")
		erufe5=spieler->name()+" rief: "+str+"\n";		
	else if(erufe6=="")
		erufe6=spieler->name()+" rief: "+str+"\n";		
	else if(erufe7=="")
		erufe7=spieler->name()+" rief: "+str+"\n";		
	else if(erufe8=="")
		erufe8=spieler->name()+" rief: "+str+"\n";		
	else if(erufe9=="")
		erufe9=spieler->name()+" rief: "+str+"\n";		
	else if(erufe10=="")
		erufe10=spieler->name()+" rief: "+str+"\n";		

	else //wenn jedes erufe schon nen wert hat, verschiebe Werte eins nach oben
		erufe1=erufe2;
		erufe2=erufe3;
		erufe3=erufe4;
		erufe4=erufe5;
		erufe5=erufe6;
		erufe6=erufe7;
		erufe7=erufe8;
		erufe8=erufe9;
		erufe9=erufe10;
		erufe10=spieler->name()+" rief: "+str+"\n";	
	}


string gerufenes()
{
	//string ausgabe;
	/*if(erufe1==""&&erufe2==""&&erufe3==""&&erufe4==""&&erufe5==""&&
		 erufe6==""&&erufe7==""&&erufe8==""&&erufe9==""&&erufe10=="") */

	if(erufe1!="") ausgabe=erufe1;
	if(erufe2!="") ausgabe=ausgabe+erufe2;
	if(erufe3!="") ausgabe=ausgabe+erufe3;
	if(erufe4!="") ausgabe=ausgabe+erufe4;
