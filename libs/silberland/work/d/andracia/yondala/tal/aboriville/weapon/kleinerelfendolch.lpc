#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Dolch");
  SetProp(P_LONG,
    "Du siehst einen kleinen Dolch, der wohl nur von Kindern benutzt wird, "
    "die daran den Umgang mit einer Waffe ueben." );

  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "kleiner dolch", "\nkleinerelfendolch", "messer", "kleines messer"}) );
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 40);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IVORY );
  SetProp(P_WEIGHT, 150);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_QUALITY_DECAY, 100);
  

  SetProp(P_WC_BONUS, (["elfenkind": 10]) );
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
