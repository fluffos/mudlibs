//
//Der Lehrer in der Elfenschule, soll auch ueber Faehigkeiten Auskunft geben

inherit "std/npc";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());

if(this_player()&&this_player()->id("\nelfenschueler"))
	AddPursuer(TP);

if (IsEnemy(this_player())==0 )//wenn der Reinkommende kein Feind ist	
	call_out("gruss", 1);
		
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Elfenlehrer Anarion");
  SetProp(P_LONG,
    "Du siehst den Lehrer der beruehmten Schule in Aboriville. Da man Elfen ihr "
    "Alter ja selten ansieht bist Du Dir nicht sicher, meinst aber, dass Anarion "
    "sicher schon einige Jahrhunderte alt sein muss.");
  SetProp(P_NAME, "Anarion");
  SetProp(P_GENDER, MALE);
  AddId(({"lehrer","elf", "elfenlehrer", "anarion"}));
  AddId(({"/nelfennorm"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 196);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 1500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([      DT_HOLY:      1.0, DT_UNHOLY:    -0.5, DT_MAGIC:  0.0, DT_MIND:   1.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Rettet meine Schueler!");
  SetProp(P_KILL_NAME, "Anarion");
  SetProp(P_KILL_MSG, "Das habt Ihr selbst zu verantworten!");
	
  AddInfo(DEFAULT_INFO, "sagt: Das erklaere ich Euch in meiner naechsten Schulstunde.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"alter","seinem alter"}),
    "Ich war schon auf der Welt, da wurde noch nicht mal an Euch gedacht.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Anarion traegt nichts fuer Dich.\n" }) );


//  SetChats(3, ({
//    ".\n"}) );

  SUID;
  CLONEME(ELFEN_WEAPON "elfendolch" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
}

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void InformDefend(object enemy)
{
 Kill(enemy);
}

gruss()
{
  // Spieler noch da?
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  	command("sag Willkommen, "+TPN+", moechtet Ihr an meinem Unterricht teilnehmen?");
}	