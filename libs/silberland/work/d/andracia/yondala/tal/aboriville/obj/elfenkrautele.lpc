#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Elessandres Elfenkraut");
  SetProp(P_LONG,
    "Du siehst eine handvoll duftenden Elfenkrauts, welches sich bestimmt nicht aufloest." );
  SetProp(P_INFO, "Man sagt dem Elfenkraut nach, dass es den Geist belebt und das Auge fuer "
  "die Natur oeffnet.\nDiese spezielle Sorte ist unbegrenzt haltbar.");
  SetProp(P_NAME, "Elfenkraut");
  SetProp(P_GENDER, NEUTER);

  AddId(({"elfenkraut", "kraut", "\nelfenkraut"}));
  SetProp(P_MATERIAL, MAT_MISC_HERBAL );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 200);

}
