#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Zweig");
  SetProp(P_LONG,
    "Du siehst einen kleinen, trockenen Zweig der wohl irgendwo abgebrochen wurde." );
  SetProp(P_NAME, "zweig");
  SetProp(P_GENDER, MALE);
  AddId(({"zweig"}));
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_MATERIAL, MAT_BEECH );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);

}

