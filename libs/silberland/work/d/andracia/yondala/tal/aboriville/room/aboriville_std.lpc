//Beinhaltet Details und die Pflueckfunktion, aber nicht das Add


#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>


int frucht = 1;
object wohin;
int da;


void reset()
{::reset();
da=random(3);
if(da==0)	
	frucht = 1;
}	


void create() 
{
  ::create();

  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir wird von den Aesten der Baeume eingeramt, dazwischen "
    "blitzt ab und zu eine lachende Sonne auf Dich herunter.");    
  AddDetail( ({ "sonnenlicht","sonne","licht" }),
    "Das Licht der Sonne lacht auf Dich herunter und erhellt den Platz an dem Du stehst.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste der Baeume aus denen Aboriville gewachsen ist geben den Blick in "
    "den Himmel frei. Hin und wieder haengen an ihnen einige Fruechte.");    
  AddDetail( ({ "fruechte","frucht" }),
    "Schillerne Fruechte schauen immer wieder zwischen den Blaettern der Baeume hindurch.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter ueber Dir geben den Blick in den Himmel frei, wenn es regnet bilden "
    "sie jedoch sofort ein dichtes Dach.");    
  AddDetail( ({ "blick" }),
    "Ein Blick nach oben zeigt Dir den blauen Himmel und die lachende Sonne.");    
  AddDetail( ({ "dach" }),
    "Jetzt gerade scheint doch die Sonne auf Dich herab.");    
  AddDetail( ({ "boden" }), 
    "Der Boden besteht in der ganzen Stadt aus Holz.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");    
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "blaetter" }),
    "Die Baeume hier tragen viele gruene Blaetter.");    
  AddDetail( ({ "platz" }),
    "Hier ist genug Platz.");    
  AddDetail( ({ "kronen" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "platz" }),
    "Schau Dich halt ein wenig um.");    
  AddDetail( ({ "blueten" }),
    "Hin und wieder blinzeln Dich kleine Blueten aus den Baeumen heraus an.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume im Wind und das froehliche Zwitschern der Voegel in den Baeumen.");

  AddSound( ({ "rauschen","wind" }),
    "Ein leichter Wind sorgt fuer ein leises Rauschen in den Baeumen.");
  AddSound( ({ "zwitschern","voegel" }),
    "Ein paar Voegel zwitschern froehliche Lieder.");
  AddSound( ({ "lieder","melodie" }),
    "Die Melodie ist wunderschoen.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm frisch nach Wald, Blueten und suessen Fruechten.");

  AddSmell( ({ "wald" }),
    "Es riecht nach dem Harz der Baeume, die Dich umgeben.");
  AddSmell( ({ "harz","baeume", "geruch" }),
    "Ein sehr wuerziger Geruch.");
  AddSmell( ({ "blueten","bluetenduft", "duft", "hauch" }),
    "Ein leichter Hauch von Bluetenduft wird an Dich herangetragen.");
  AddSmell( ({ "fruechte","fruechteduft" }),
    "Die Fruechte in den Baeumen verbreiten einen suesslichen Duft.");
  AddSmell( ({ "duft" }),
    "Meinst Du den Bluetenduft oder den Fruechteduft?");

}

pfluecken(string str )
{
  notify_fail( "Was moechtest Du pfluecken?\n" );
  if( str == "frucht" )
	{
    write("Der Baum zieht den Ast mit der Frucht weg und haut Dir auf die Finger.\n");
    say( "Ein Ast schnellt hervor und schlaegt "+ TPN+" auf die Finger.\n");
		TP->do_damage(5,"Ein Ast");
   return 1;
  }
}


bitten(string str )
{
  notify_fail( "Wen moechtest Du um was bitten?\n" );
  if( str == "baum um frucht" )
	{
		if(TP->QueryProp(P_RACE)=="Elf")
		//if(TP->id("Elfenspieler")||TP->QueryProp(P_GUILD)=="Naturvolk")//noch testen
		//if(TP->id("Elfenspieler")||TP->QueryProp(P_GUILD)=="naturvolk")
			{
				if (frucht==1)
					{
						write("Der Baum schenkt Dir eine Frucht.\n");
    				say( TPN+" bekommt eine Frucht vom Baum geschenkt.\n");
   					CLONE(ELFEN_OBJ + "elfenfrucht.lpc", TP);//muss noch gemacht werden
   					frucht=0;
   					}
   				else
   					write("Der Baum rauscht: Ich habe leider gerade keine Frucht fuer Euch.\n");
   			return 1;
   		}	
   		else //Wenn weder Elf noch Naturvolk
   			{write("Der Baum rauscht: Fuer Wesen wie Euch habe ich keine Frucht.\n");
   				return 1;}
  	}
return 0;
}

void findewohin(string str)
{
	wohin=to_object(str);
	}
