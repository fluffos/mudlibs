#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Hornschild");
  SetProp(P_LONG,
    "Du siehst ein grosses, glaenzendes Hornschild. Es ist sehr duenn und leicht, "
    "scheint aber gut gegen so manchen Angriff standhalten zu koennen." );
  SetProp(P_NAME, "Hornschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hornschild", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([ MAT_BEECH, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 80);
                                       

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_FIRE]) );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
