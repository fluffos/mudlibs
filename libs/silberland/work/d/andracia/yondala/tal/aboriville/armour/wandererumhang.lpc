#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Reiseumhang");
  SetProp(P_LONG,
    "Du siehst einen etwas abgenutzen Reiseumhang. Er ist schlicht, grau  und hat eine "
    "grosse Kapuze und einige Knoepfe." );

  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "reiseumhang", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
                                       

  SetProp(P_QUALITY_DECAY, 100);

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
