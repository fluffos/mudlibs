#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
object ob;
object next;
object waechter;



int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_aboriville_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein hoelzernes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);


  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein hoelzernes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  return result;

}
//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er nach Aboriville teleportiert
int betreten(string str)
{
if(!testobgemacht(TPN))	return 0;			
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das hoelzerne Portal.\n");
  say(TPN+" betritt das hoelzerne Portal.\n");
  TP->SetProp(P_PARALYZED, 0);
  TP->move( "/d/andracia/yondala/wolken/lunia/room/portalraum_aboriville.lpc", M_NOCHECK);
  call_other("/d/andracia/yondala/wolken/lunia/room/portalraum_aboriville", "wirbeltext", TP, 0, 1);
  
  return 1;
}

//Details fuer das Portal
string erlaubtenamen()
{
  string alle;
  if(!testobgemacht(TPN)) 
				return 0;
  alle=	"Auf den Saeulen wurden folgende Namen eingepraegt:\n"+ read_file("/d/andracia/yondala/wolken/lunia/portale/portal_aboriville_zugang.lpc");
	return alle;
}

string det_portal()
{
if(!testobgemacht(TPN))
				return 0;
				
return "Du siehst ein Portal aus edlem Holz. Es besteht aus einem hoelzernen"+
	"Bogen, der auf zwei hoelzernen Saeulen ruht. Ob man es betreten kann?\n"; 
} 

string det_bogen()
{
if(!testobgemacht(TPN)) 
				return 0;

return "In den Bogen wurde das Wort \"Aboriville\" gepraegt.\n"; 
} 
string det_saeulen()
{
 /* if(!call_other("/d/andracia/yondala/lunia/room/portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) */
if(!testobgemacht(TPN))
	return 0;

return "In die Saeulen wurden Namen gedruckt.\n"; 
} 
string det_lunia()
{
if(!testobgemacht(TPN)) return 0;

return "Was mag das nur bedeuten?\n"; 
} 

void create() 
{
  ::create();
  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "lunia" }),"det_lunia");
  AddSpecialDetail( ({ "saeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );

  
  
  
  SetProp( P_INT_SHORT, "Im Vorraum des Hoheitsgebietes" );
  SetProp( P_INT_LONG,
    "Du stehst hier im Vorraum des Hoheitsgebietes und bist etwas ueberrascht. "
    "Im Gegensatz zum Rest der Hoehlen und Raueme der Stadt sind die Waende hier aus "
    "solidem Holz erschaffen. Der Raum an sich ist leer, bis auf eine Treppe. In vier "
    "Richtungen kannst Du hier je einen grossen Raum betreten. Viel kannst Du allerdings "
    "von hier aus nicht erkennen." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
AddItem(ELFEN_NPC + "elfenwaechter_palast.lpc",REFRESH_DESTRUCT);
AddItem(ELFEN_NPC + "elfenwaechter_palast.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "vorraum", "raum" }),
    "Du stehst im Vorraum des Hoheitsgebiets von Aboriville der sich in einem hohlem Baum befindet.");     
  AddDetail( ({ "boden" }),
    "Der Boden besteht in der ganzen Stadt aus Holz. Er sieht so aus, als wuerde er oft begangen werden.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");    
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen hier aus blankem, schmucklosem Holz.");     
  AddDetail( ({ "decke" }),
    "Die Decke besteht wie alles hier aus Holz.");     
  AddDetail( ({ "rest", "hoehlen","raeume" }),
    "Schau Dich doch ein wenig um in Aboriville!");     
  AddDetail( ({ "treppe" }),
    "Die Treppe dominiert den Raum. Sie ist fein gearbeitet und windet sich nach unten in die untere Etage.");     
  AddDetail( ({ "etage", "untere etage" }),
    "Von hier aus kannst Du nicht sehen, was sich dort verbirgt.");     
  AddDetail( ({ "richtungen" }),
    "Du kannst, ausser ueber die Treppe nach unten, in vier Richtungen gehen.");     
  AddDetail( ({ "raum" }),
    "In jeder der vier Richtungen in die Du gehen kannst befindet sich ein Raum; was sich "
    "darin befindet kannst Du allerdings nicht feststellen.");     
  AddDetail( ({ "baeume" }),
    "Die Stadt der Elfen ist auf hohen Baeumen erbaut.");     
  AddDetail( ({ "" }),
    "");     
  AddDetail( ({ "" }),
    "");     

        
  AddSound( DEFAULT_SMELL,
    "Es riecht nach dem Harz des Baumes in dem Du Dich befindest.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst leistes Stimmengemurmel.");

  AddSound( ({ "stimmengemurmel","gemurmel","stimmen" }),
    "Jemand scheint sich angeregt zu unterhalten.");
  AddSound( ({ "jemand", "genaues" }),
    "Leider kannst Du nichts genaues verstehen.");

 
  AddSmell( ({ "baum","harz" }),
    "Das Harz des Baumes riecht leicht suesslich.");



AddExit( "nordosten", ELFEN_ROOM  + "aboriville_2c_o.lpc" ); 
AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_2a_o.lpc" ); 
AddExit( "suedosten", ELFEN_ROOM  + "aboriville_4c_o.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_4a_o.lpc" ); 
AddExit( "unten", ELFEN_ROOM  + "aboriville_3b.lpc" ); 

}



