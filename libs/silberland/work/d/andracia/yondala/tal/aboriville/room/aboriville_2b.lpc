#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Pfad in der Elfenstadt" );

  SetProp( P_INT_LONG,
    "Du stehst auf einem Pfad in der Elfenstadt, um Dich herum ist alles gruen. "
    "Nach Sueden kannst Du eine natuerliche Baumhoehle betreten. Nach Osten "
    "und Westen laeufst Du einfach weiter auf dem Pfad entlang." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(ELFEN_NPC + "elf_std.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "westen", "sueden","osten" }),
    "Dahin kannst Du gehen.");    
  AddSpecialDetail( ({ "schild"  }), "schild" );
  AddSpecialDetail( ({ "hoehle","baumhoehle"  }), "hoehle" );
  AddDetail( ({ "pfad" }),
    "Du stehst auf einem Pfad der Elfenstadt.");    
  AddDetail( ({ "eingang", "sueden" }),
    "Nach Sueden hin kannst Du die Hoehle betreten.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Rauschen der Baeume");

  AddSound( ({ "rauschen","baeume" }),
    "Fast klingt es, als wollten die Baeume Dir eine Geschichte erzaehlen.");
  AddSound( ({ "geschichte" }),
    "Schade, dass Du sie nicht verstehen kannst.");
  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");



AddExit( "sueden", ELFEN_ROOM  + "aboriville_3b.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_2c.lpc" ); 
AddExit( "westen", ELFEN_ROOM  + "aboriville_2a.lpc" ); 
AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

}

string hoehle()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "Die Hoehle liegt suedlich von Dir. Ueber ihrem Eingang siehst Du ein grosses, hoelzernes Schild.\n";    
	else
	  return 	"Die Hoehle liegt suedlich von Dir.\n";	
 }
 
 

 
 string schild()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  
	  " _____________________________\n"+
    "|                             |\n"+
    "|*                           *|\n"+
    "|        Hoheitsgebiet        |\n"+
    "|   Eintritt nur ohne Waffen  |\n"+
    "|   fuer das Wohl der Elfen!  |\n"+
    "|                             |\n"+
    "|*                           *|\n"+
    "|_____________________________|\n";
	  
	   
	else
	  return 	"Sowas siehst Du da nicht\n";	
 }