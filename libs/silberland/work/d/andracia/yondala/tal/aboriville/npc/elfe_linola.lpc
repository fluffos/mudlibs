inherit "std/npc";

inherit"/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <moredef.h>
#include <npc.h>
#include <language.h>

string name;
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
   call_out("check", 0, TP);

}

void create() {
  if (!is_clone(TO)) return;
  ::create();
	create_default_npc(20);   
  SetProp(P_NAME, "Linola");
  AddId(({"elfe","verkaeuferin","linola", "/nelfennorm", "LINOLA"}));
  SetProp(P_KILL_NAME, "Linola");
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Linola die Verkaeuferin");
  SetProp(P_LONG,
    "Du siehst eine grosse, schlanke Elfe vor Dir, die Dich aufmunternd anlaechelt.");
  SetProp(P_GENDER, MALE);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_HOLY}));
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 60000);
  SetProp( P_REJECT, ({ REJECT_DROP, "Linola will Deine Sachen nicht tragen.\n" }) );
  SetProp(P_ARTICLE, 0);

	
  SetProp(P_DEFENDERS, (({"elfenwaechter"})));
	

  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 800);


  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([ DT_HOLY:      0.5, DT_UNHOLY:    0.5, ]) );

  SetProp(P_MSGIN, "schleicht heran");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Elfenbrueder, raecht meinen Tod!");
  SetProp(P_KILL_MSG, "Setze nie mehr einen Fuss in meinen Laden!");

  AddInfo(DEFAULT_INFO, "sagt: Fragt doch lieber einen der Aeltesten.\n");

  AddInfo( ({"linola","verkaeuferin"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

 

SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(1,250, "Linola wirft Dir eine Magiekugel entgegen.\n",
	        "Linola wirft @WEN eine Magiekugel entgegen.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Linola schnappt sich ein Schwert und fuegt Dir eine tiefe Schnittwunde zu.\n",
	        "Linola schnappt sich ein Schwert und fuegt @WEM eine tiefe Schnittwunde zu.\n",
	         ({DT_SLASH}), ([SP_SHOW_DAMAGE:1]) );
	
	AddDefaultSpell(1,200, "Linola rammt Dir eine Keule gegen den Kopf.\n",
	        "Linola rammt @WEM eine Keule gegen den Kopf.\n",
	         ({DS_SLOW}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Linola sticht Dir mit einem Dolch in den Bauch.\n",
	        "Linola sticht @WEM mit einem Dolch in den Bauch.\n",
	         ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Linola greift sich eine magische Peitsche und zieht sie Dir ueber den Koerper.\n",
	        "Linola greift sich eine magische Peitsche und zieht sie @WEM ueber den Koerper.\n",
	         ({DT_WHIP}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,100, "Linola zerhackt Dich mit einer kleinen Handaxt.\n",
	        "Linola zerhackt @WEN mit einer kleinen Handaxt.\n",
	         ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );


/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/

  SUID;
  CLONEME(ELFEN_WEAPON +"elfendolch" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR +"elfentunika" );
  CLONEME(ELFEN_ARMOUR +"elfenguertel" );
  CLONEME(ELFEN_ARMOUR +"elfenseidenschuhe" );
  command("trage alles");

}
void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}








