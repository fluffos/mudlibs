//Smell und Sound fehlen

//Schmiede. Schmied soll reparieren koennen. hat magischen Ofen, Feuer 
//schwebt in einem magischen blauen Kraftfeld um zu erklaeren, warum es 
//in den Baeumen Feuer gibt :o)

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Schmiede" );
  SetProp( P_INT_LONG,
    "Du befindest Dich offensichtlich in einer Schmiede, welche sich interessanterweise in einem "
    "hohlen Baum befindet. Die Innenwaende des Baumes sind versilbert und es gibt keinen Ofen, "
    "stattdessen lodert ein magisches Feuer weissgluehend mitten im Raum." );
  AddItem(ELFEN_NPC + "zwerg_knurrg.lpc",REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_HOUSE]) );


  AddDetail( ({ "schmiede","raum" }),
    "Du befindest Dich offensichtlich in einer Schmiede, welche sich interessanterweise in einem "
    "hohlen Baum befindet. Die Innenseite des Baumes ist versilbert und es gibt keinen Ofen, "
    "stattdessen lodert ein magisches Feuer weissgluehend mitten im Raum., darunter steht ein "
    "schwerer Amboss.");    
  AddDetail( ({ "baum" }),
    "Du befindest Dich in einem hohlen Baum, von dessen urspruenglicher Gestalt man aber nicht "
    "mehr so viel erkennen kann.");    
  AddDetail( ({ "gestalt" }),
    "Von der urspruenglichen Gestalt sieht man nicht mehr viel, denn der Baum ist von innen "
    "mit offensichtlich magischen Silber beschlagen.");    
  AddDetail( ({ "silber", "innenseite" }),
    "Die Innenseite des Baumes ist mit magischem Silber beschlagen.");    
  AddDetail( ({ "ofen" }),
    "Keiner da, steht da doch.");    
  AddDetail( ({ "feuer" }),
    "Mitten im Raum schwebt ein hell loderndes Feuer in einem Energieball.");    
  AddDetail( ({ "energieball" }),
    "Der Energieball baendigt das Feuer und haelt es in seiner jetzigen Form um es dem Schmied "
    "nutzbar zu halten.");    
  AddDetail( ({ "form" }),
    "Das Feuer schwebt in einem kugelrunden Energieball.");    
  AddDetail( ({ "schmied" }),
    "Der ist wohl gerade nicht da. Du denkst . o O  (hoffentlich kommt er bald wieder und passt "
    "auf das Feuer auf!)");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holz, allerdings ist er mit einer dicken Schicht Russ und kleinen "
    "Metallstueckchen bedeckt.");    
  AddDetail( ({ "decke" }),
    "Die Decke kann man eigentlich nicht sehen, den sie ist voller Russ.");    
  AddDetail( ({ "wand", "waende" }),
    "Die Waende in diesem Raum sind versilbert und mit einer feinen Russschicht bedeckt.");    
  AddDetail( ({ "amboss" }),
    "Der schwarze Amboss steht in der Mitte des Raumes. Er ist schwarz und voller Dellen.");    
  AddDetail( ({ "dellen" }),
    "Nun, der Amboss ist offensichtlich nicht neu, auf ihm wurde und wird noch immer viel gearbeitet.");    
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes schwebt ein Feuer, darunter steht ein Amboss.");    
  AddDetail( ({ "russ","russschicht","schicht" }),
    "Das Feuer verursacht Russ, der sich in einer mal duennen, mal dicken Schicht im ganzen Raum "
    "ausbreitet");    
  AddDetail( ({ "metallstueckchen", "metallstuecke" }),
    "Wenn das heisse Metall bearbeitet wird fliegen manchmal kleine Metallspritzer heraus, die "
    "dann aushaerten und zu kleinen Metallstuecken werden.");    
  AddDetail( ({ "metall", "metallsorten", "metalle", "eisen" }),
    "Der Schmied arbeitet hier mit verschiedensten Metallsorten.");    
  AddDetail( ({ "holz" }),
    "Nur am Boden des Baumes sieht man noch ab und an etwas Holz.");    
  AddDetail( ({ "metallspritzer", "funken" }),
    "Pass lieber auf, dass Dich so einer nicht trifft, das koennte weh tun.");    
  AddDetail( ({ "arbeit" }),
    "Der Schmied leistet hier schwerste Arbeit.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Prasseln des Feuers.");

  AddSound( ({ "" }),
    "");

 
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier stickig, es riecht nach Russ und Rauch.");
  AddSmell( ({ "" }),
    "");



AddExit( "norden", ELFEN_ROOM  + "aboriville_6b.lpc" ); 

}

