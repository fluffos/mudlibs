#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
reset() {
  ::reset();
 if(!present("tunika",TO)||!present("elfenguertel",TO))
 	{
 		tell_room(ELFEN_ROOM + "aboriville_3e", 
 		"Ein Elfenkind kommt an und haengt etwas an einen Haken.\n"+
		"Das Elfenkind springt davon.\n");
  }

}

void create()
{
	::create();
 AddItem( ELFEN_ARMOUR+"elfenguertel.lpc", REFRESH_REMOVE );
 AddItem( ELFEN_ARMOUR+"grosseelfentunika.lpc", REFRESH_REMOVE );

}

string gucken(object viewer, mixed inv, int flags)
{
	string str;
	str=to_string (make_invlist(viewer, inv, flags));
	//str=to_string (make_invlist(this_player(), 0, 0));
	return str;
}