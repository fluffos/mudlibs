int keinelangeweile=0; //bei 1 macht er Pause
string name;
int wer;

void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}

//string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  
  
  
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 500);
  SetProp(P_WIMPY, 1);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_HANDS, ({"mit einem kleinen Dolch",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_2f");
SetProp (P_MNPC_AREA, ({
	ELFEN_ROOM + "aboriville_1e", 
	ELFEN_ROOM + "aboriville_1f", 
