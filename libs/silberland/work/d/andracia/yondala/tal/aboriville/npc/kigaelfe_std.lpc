SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Kindermoerder!");
  SetProp(P_KILL_NAME, "Ein Elfenkind");
  SetProp(P_KILL_MSG, "Was, Du laesst Dich von einem Kindergartenkind toeten?");

    SetProp( P_REJECT, ({ REJECT_DROP,
    name+" will Deine Sachen nicht tragen.\n" }) );
	
	
  AddInfo(DEFAULT_INFO, "sagt: Das darf ich Fremden nicht erzaehlen.\n");
  AddInfo( ({"fremde","fremder"}),
    "Ihr seid ein Fremder.",
    "sagt: ");
  AddInfo( ({
"alanel","alari","aliaria","alriel","ambelio",
"belina","bimalandon","enrael","faemil","famione",
"felerian","fenwen","fesieel","garansa ","golain","hiara","imalaian","laia",
"linel","linla","linlaen","linlala","linola","linwen","lonola","lorion","lutana",
"meldo","melina","minda","mindala","miranola ","miranyl","mondol","nalda",
"navalla","nela","nerael","neraen","odania","pheralas", "pholdolur","ranari",
"riaona","saladion","selo","semione","sowena","sutana","tamosa",
"teluwen","thorasa ","vindo","zylia"}),

"Ueber Einwohner Aborivilles darf ich keine Auskunft geben.", //sonst brech ich zusammen
    "sagt: ");
  AddInfo( ({"anarion","lehrer"}),
    "Anarion heisst der Lehrer der Elfenschule.",
    "sagt: ");
  AddInfo( ({"schule","elfenschule"}),
    "Wenn ich etwas groesser bin geh ich auch in die Schule.",
    "sagt: ");
  AddInfo( ({"andvare", "hohepriester"}),
    "Andvare ist der Hohepriester von Aboriville.",
    "sagt: ");
  AddInfo( ({"ariana","hohepriesterin"}),
    "Ariana ist die Hohepriesterin von Aboriville.",
    "sagt: ");
  AddInfo( ({"belenos","weise","weiser"}),
    "Belenos ist der Vater der Weisheit.",
    "sagt: ");
  AddInfo( ({"almana","weise"}),
    "Almana ist die Mutter der Weisheit.",
    "sagt: ");
  AddInfo( ({"lelo","heiler", "meister der heilkunst"}),
    "Lelo ist der Meister der Heilkunst.",
    "sagt: ");
  AddInfo( ({"alyna","heilerin", "meisterin der heilkunst"}),
    "Alyna ist die Meisterin der Heilkunst.",
    "sagt: ");
  AddInfo( ({"tasinion","heerfuehrer"}),
    "Tasinion ist der Heerfuehrer der Elfen.",
    "sagt: ");
  AddInfo( ({"ayala","heerfuehrerin"}),
    "Ayala ist die Heerfuehrerin der Elfen.",
    "sagt: ");
  AddInfo( ({"brisi","apothekerin", "apotheke"}),
    "Brisi besitzt eine Apotheke hier in Aboriville.",
    "sagt: ");
  AddInfo( ({"riana","sanitaeterelfe"}),
    "Riana hat einen kleinen Talan bei uns im Kindergarten. Sie heilt uns, wenn "
    "wir uns mal verletzen.",
    "sagt: ");
  AddInfo( ({"kindergarten",""}),
    "Der Kindergarten von Aboriville ist sehr schoen. Ich gehe gerne dorthin.",
    "sagt: ");
  AddInfo( ({"nanna","kindergaertnerin","kindergaertner"}),
    "Nanna ist unsere Kindergaertnerin, sie ist sehr lieb zu uns.",
    "sagt: ");
  AddInfo( ({"rasse","rassen"}),
    "Es gibt verschiedene Rassen. Ich bin ein Elf. Aber es gibt auch Zwerge und andere Wesen. "
    "Nanna hat uns auch schon von vielen anderen Rassen erzaehlt. Aber ich bin mir sicher, dass "
    "sie die bloss erfunden hat. Sowas wie 'Menschen' gibt es doch bestimmt gar nicht.",
    "sagt: ");
  AddInfo( ({"menschen","mensch", "faunenwald"}),
    "Nanna hat uns mal davon erzaehlt.",
    "sagt: ");
  AddInfo( ({"zwerge","zwerg"}),
    "Zwerge stinken. Aber Nanna sagt, dass wir das nicht sagen sollen, das gehoert sich nicht.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  //SetProp(P_LOG_INFO, "npc_logfile");

    SetProp( P_REJECT, ({ REJECT_DROP,
    name+" will Deine Sachen nicht tragen.\n" }) );       	
	         	
  SUID;
  CLONEME(ELFEN_WEAPON "kleinerelfendolch.lpc" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "kleineelfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );

  command("trage alles");
  call_out("langeweile",10);
  
  SetProp(P_SPELLRATE, 10);
  SetProp(P_NOMAGIC,1);

	AddSpell(1,200,
	         name+ " schreit wie am Spiess.\n",
	         name+ " schreit wie am Spiess.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );
}



void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "findet das lustig.",
        "findet das lustig.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "tritt Dir vors Schienbein.",
        "tritt "+TPN+" vors Schienbein.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich an.", 
        "laechelt "+TPN+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Dafuer bin ich doch noch zu klein.",
        "sagt: Dafuer bin ich doch noch zu klein.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.", 
        "laechelt "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}



void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


void InformDefend(object enemy)
{
 Kill(enemy);
}


langeweile()
{
	int wann;
	int lust;
	int ros; 
		
	wann=random(100);
	wann+=200;
	lust=random(6);//hab ich lust was zu machen? 1=ja
	ros=random(3); //mach ich was mit dem Raum oder mit dem Spieler? 1=raum

if(!InFight(TO)) //nur,wenn es nicht kaempft
	{
	if (lust!=1)//ich will was machen
		{
			if (ros!=1) //im Raum
				{
					raum(); //call_out("raum",0);
					}
			else //if(ros==0)//mit einer anwesenden Person
				{
					person(); //call_out("person",0);
					}
			}
				
			
	else //ich will nichts machen
		{
			if(QueryProp(P_GENDER)==MALE)	tell_room(environment(TO), name()+" ueberlegt, was er tun koennte.\n");
			else tell_room(environment(TO), name()+" ueberlegt, was sie tun koennte.\n");
			call_out("langeweile",5);
		}								
	}
	else call_out("langeweile",5);
//nur was machen, wenn er keine Beschaeftigung hat.
//	if (keinelangeweile==0) call_out("langeweile",5);
//erstmal in die funktionen
	}
	
	
raum()
{ 
	int was; //helferlein fuer die Frage was in einem Raum gemacht wird
	int laune;
	laune=random(5); //mach ich was nettes oder was freches? 

	if (laune>=1)//ich hab gute Laune
		{
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1e")
				{
					command("starte kissenschlacht");
					command("nimm zwergenhaar");}
				
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1f")
				{
					command("sitz");
					tell_room(environment(TO), name()+" beginnt eine leckere Frucht zu essen.\n");
					call_out("steh1f", 10);}
					
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1g")
				//command("sag Oh, mir fehlt ein Puzzleteil."); 
				tell_room(environment(TO), name()+"setzt ein Puzzle zusammen.\n");

			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_2f")
				{
					
					was =random(2);
					if(was==1)
						{
							//command("sag ich setz mich");
							command("sitz auf schaukel");
							call_out ("schaukel",1);
							keinelangeweile=1;
							}
						else command ("rutsche");
				}
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_2g")
					{
						//hier muss noch ne Pruefung rein ob schon wer sitzt
						keinelangeweile=1;
						tell_room(environment(TO), name()+" nimmt sich ein Buch.\n");
						command("sitz in schaukelstuhl");
						call_out ("buchlesen",1);
						}

			
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3f")
				{//wenn Kind verletzt ist und Riana da ist
					if(QueryProp(P_HP)!=QueryProp(P_MAX_HP)&&present ("riana", environment(TO)))
						tell_room(environment(TO), name()+" drueckt sich an Riana und weint sich bei ihr aus.\nRiana troestet und heilt "+name()+".\n");
						
						//command("wein riana");
					}

			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3g")
					was=random(4);
					if(was==0)command("baue burg");
					if(was==1)command("spiel mit foermchen");
					if(was==2)command("grabe");
					if(was==3)
						{command("kletter auf Wippe");
							keinelangeweile=1;
							call_out("wippen",1);
						}
		
			

		}
	
	else//ich hab schlechte laune
		{
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1e")
				command("tobe");
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1f")
				command("nasch suessigkeiten"); //das hebt die Laune :o)
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_1g")
				tell_room(environment(TO),name()+" wirft Baukloetze durch den Raum.\n");
	//		if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_2f")
	//		if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_2g")
	//		if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3f")
			if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3g")
				{
					was=random(2);
					if (was==0)	tell_room(environment(TO),name()+" wirft mit Sand um sich.\n");
					if (was==1)
						{
							if(present("sandburg", environment(TO))) command("zertrete burg");
							}
					}
								
				
			}
			
	if (keinelangeweile==0) call_out("langeweile",5);

}

steh1f()
{
	tell_room(environment(TO), name()+" hat fertig gegessen.\n");
	command("steh");
	keinelangeweile=0;
}

schaukel()
{
	int nochmal;
	nochmal = random(5);
	command("schwing");

if(nochmal>0)
	{call_out("schaukel",1);}
	else
		{	call_out("vonschaukel",5);}
}

vonschaukel()
{command("spring von schaukel");
	keinelangeweile=0;
	call_out ("langeweile",10);}

buchlesen()
{
	int lesen;
	lesen=random(6);
	if(lesen==0) tell_room(environment(TO), name()+" schaut sich ein Bild an.\n");
	if(lesen==1) tell_room(environment(TO), name()+" blaettert eine Seite um.\n");
	if(lesen==2) command("sag Gut, dass ich schon lesen kann.");
	if(lesen==3) tell_room(environment(TO), name()+" ist in das Buch vertieft.\n");
	if(lesen==4) command("schaukel");
	if(lesen==5) call_out("lesenende");
	
	if(lesen<5) call_out("buchlesen",5);
}	

lesenende()
{
	command("steh");
	tell_room(environment(TO), name()+" legt das Buch zurueck in das Regal.\n");
	keinelangeweile=0;
	call_out ("langeweile",10);
}

wippen()
{
	int nochmal;
	nochmal = random(8);
	command("wippe");

if(nochmal>0)
	{call_out("wippen",1);}
	else
		{	call_out("vonwippe",5);}
}

vonwippe()
{command("kletter von wippe");
	keinelangeweile=0;
	call_out ("langeweile",10);}
	
	
	
person()
{
	int was;
	int wen;
	object *anwesende;
	int laune;

if(present ("nanna", environment(TO))&&file_name(environment(TP)) == ELFEN_ROOM + "aboriville_2g")
	{
		command("bitte nanna um geschichte");
	}
	
else
	{
	
		
	anwesende= filter_array( all_inventory(environment(TO)), #'living );//'
	wen=random(sizeof(anwesende));
if(sizeof(anwesende)>1)
	{
		for(;;)
		{	wen=random(sizeof(anwesende));
			if(anwesende[wen]->name()!=name()) break;}

	laune=random(5); //mach ich was nettes oder was freches? 1=gut
		if (laune!=1)//ich hab gute Laune
			{
				if(anwesende[wen]->id("Elfenspieler"))
					{
						was=random(4);
						if (was==0)
							{
								tell_object(anwesende[wen], name()+" knuddelt Dich.\n");
								tell_room(environment(TO), name()+" knuddelt "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
							}
						if (was==1)
							{
								tell_object(anwesende[wen], name()+" flauscht Dich.\n");
								tell_room(environment(TO), name()+" flauscht "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
							}
						if (was==2)
							{
								tell_object(anwesende[wen], name()+" laechelt Dich an.\n");
								tell_room(environment(TO), name()+" laechelt "+ anwesende[wen]->name(WEN)+" an.\n", ({anwesende[wen]}));
							}
						if (was==3)
							{
								tell_object(anwesende[wen], name()+" zwinkert Dir zu.\n");
								tell_room(environment(TO), name()+" zwinkert "+ anwesende[wen]->name(WEM)+" zu.\n", ({anwesende[wen]}));
							}
				
					}
				else if(anwesende[wen]->QueryProp(P_RACE)=="Zwerg")
					{
						was=random(4);
						if (was==0)
							{
								command("sag Seid gegruesst, Zwerg "+anwesende[wen]->name()+".");
							}
						if (was==1)
							{
								command("sag Nana sagt, wir muessen auch zu Zwergen freundlich sein. Niemand kann was dafuer als was er geboren wurde, nicht wahr, "+anwesende[wen]->name()+"?");
							}
						if (was==2)
							{
								command("sag Riechen alle Eurer Rasse auf diese penetrante Weise, "+anwesende[wen]->name()+"?");
							}
						if (was==3)
							{
								command("sag Nana sagt Luegen haben kurze Beine. Seid Ihr eine Luege, "+anwesende[wen]->name()+"?");
							}
				
					}
					else
						{
							
							was=random(4);
							if (was==0)
								{
									tell_object(anwesende[wen], name()+" beaeugt Dich neugierig.\n");
									tell_room(environment(TO), name()+" beaeugt "+ anwesende[wen]->name(WEN)+" neugierig.\n", ({anwesende[wen]}));
								}
							if (was==1)
								{
									tell_object(anwesende[wen], name()+" beobachtet Dich.\n");
									tell_room(environment(TO), name()+" beobachtet "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
								}
							if (was==2)
								{
									if (TP && interactive(TP))
									command("sag Ich wusste gar nicht, dass es Eure Rasse wirklich gibt, "+anwesende[wen]->name()+". Ich dachte immer, das sei eins von Nannas Maerchen...");
								}
							if (was==3)
								{
									tell_object(anwesende[wen], name()+" starrt Dich an.\n");
									tell_room(environment(TO), name()+" starrt "+ anwesende[wen]->name(WEN)+" an.\n", ({anwesende[wen]}));
									tell_room(environment(TO), name()+" denkt   . o O (Gestalten laufen hier rum...)\n");
								}
								
						}
				}
		else//schlechte Laune
			{
				if(anwesende[wen]->QueryProp(P_RACE)=="Elf")
					{
						was=random(5);
						if (was==0)
							{
								tell_object(anwesende[wen], name()+" tritt Dich.\n");
								tell_room(environment(TO), name()+" tritt "+ anwesende[wen]->name()+".\n", ({anwesende[wen]}));
							}
						if (was==1)
							{
								tell_object(anwesende[wen], name()+" streckt Dir die Zunge raus.\n");
								tell_room(environment(TO), name()+" streckt "+ anwesende[wen]->name(WEM)+" die Zunge raus.\n", ({anwesende[wen]}));
							}
						if (was==2)
							{
								tell_object(anwesende[wen], name()+" schubbst Dich.\n");
								tell_room(environment(TO), name()+" schubbst "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
							}
						if (was==3)
							{
								tell_object(anwesende[wen], name()+" zwickt Dich.\n");
								tell_room(environment(TO), name()+" zwickt "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
							}
						if (was==4)
							{
								tell_object(anwesende[wen], name()+" grinst Dich an.\n");
								tell_room(environment(TO), name()+" grinst "+ anwesende[wen]->name(WEN)+"an.\n", ({anwesende[wen]}));
							}
						}

				if (anwesende[wen]->QueryProp(P_RACE)=="Zwerg")
					{
						was=random(3);
						if (was==0)
							{
								tell_object(anwesende[wen], name()+" haenselt Dich wegen Deines Geruchs.\n");
								tell_room(environment(TO), name()+" haenselt "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
							}
						if (was==1)
							{
								tell_object(anwesende[wen], name()+" kichert ueber Deine kurzen Beine.\n");
						tell_room(environment(TO), name()+" kichert ueber die kurzen Beine von "+ anwesende[wen]->name()+".\n", ({anwesende[wen]}));
								}
						if (was==1)
							{
								tell_object(anwesende[wen], name()+" schubbst Dich.\n");
								tell_room(environment(TO), name()+" schubbst "+ anwesende[wen]->name(WEN)+".\n", ({anwesende[wen]}));
								command("sag Geh weg, Du doofer Zwerg!");
							}
						}
				
			}
		}
	}
	if (keinelangeweile==0) call_out("langeweile",10);


}