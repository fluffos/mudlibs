// int _query_wimpy() { return 0; }

void StartReaction(string verb, string gruppe, string adverb, int touch) {

      write(name()+ " laesst sich nichts anmerken.\n");
      say(name()+ " laesst sich nichts anmerken.\n",TP);  
}







void check()
{
   if(!TP || !interactive(TP) || (environment(TO)!=environment(TP)))
    return;

	write("Der Elfenwaechter schaut in Deine Seele.\n");
	call_out("check1",2);	
	
	}
void check1()
{
    if(!TP || !interactive(TP) || (environment(TO)!=environment(TP)))
    return;
    
  if (TP->QueryProp(P_LEVEL)<11)
  {
  	if (TP->QueryProp(P_ALIGN) < (-500)||present ("\nelfenkiller", TP)||TP->QueryProp(P_GUILD) == "pirat"&&TP->id("Elfenspieler"))
     	{
     		command("sag Ihr seid auf dem falschen Weg, "+TPN+"! Lange verschone ich Euch nicht mehr.");
				return;
			}
  	}
  
   else if (TP->QueryProp(P_ALIGN) < (-500))
    {
  	  command("sag Ihr seid von uebler Gesinnung, "+TPN+"! Euch wollen wir hier nicht.");
      Kill(TP);
      return;
    }
  
  else if(TP->QueryProp(P_GUILD) == "pirat"&&TP->id("Elfenspieler"))
  	{
  		command("sag Ihr habt unsere Rasse verraten, "+TPN+"!");
      Kill(TP);
      return;
    }
   else if(present ("\nelfenkiller", TP))
    	{
  	  	command("sag Ich erkenne eure Taten, "+TPN+"!");
    		Kill(TP);
    		return;
    	}
    		write("Der Elfenwaechter nickt Dir zu.\n");
    		say("Der Elfenwaechter nickt "+TP->name(WEM)+" zu.\n",TP);

}	




//soll vom Baum schubbsen wenn auf dem Wachweg, sonst einfach nur einen Raum weiterschubbsen
void schubs(object enemy, int damage, mixed dam_type) 
{
	 	string *ausgang;
//	tell_object(enemy, "");
	if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3b_o")
	  {enemy->move(ELFEN_ROOM + "aboriville_3b", M_GO ,
 	 "","faellt nach unten","faellt von oben herunter");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_3b")
	  {enemy->move(ELFEN_ROOM + "aboriville_2b", M_GO);
 	  	//TP->do_damage(20,"Ein Sturz");
 	  	}


	else
/*		{
			string *ausgang; //Durch den * wirds zum array
  		ausgang = m_indices (environment(TO)-> QueryProp(P_EXITS));
  		enemy->command(ausgang[random(sizeof(ausgang))]);
  	  }*/
  	  {
	 			ausgang = m_indices( ENV(TO)->QueryProp(P_EXITS) );
  			enemy->move( ENV(TO)->QueryProp(P_EXITS)[ausgang[random(sizeof(ausgang))]] , M_GO);
				}
 
}







void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(1);
}



void InformDefend(object enemy)
{
 Kill(enemy);
}

void nein(string name)
{command("sag Tut mir leid, aber mit Waffe darf ich Euch hier nicht hoch lassen, "+name+"!");}