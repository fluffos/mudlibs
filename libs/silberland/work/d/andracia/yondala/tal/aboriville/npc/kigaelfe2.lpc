//Alriel, Pholdolur oder Daniolo

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"kigaelfe_std.lpc";


int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Alriel";
  AddInfo( ({"alriel"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Telowen und Odania.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Pheralas und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Miranyl und Famione.",
    "sagt: ");
  AddInfo( ({"pheralas","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"miranyl","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","telowen"}),
    "Meines Vaters Name ist Telowen.",
    "sagt: ");
  AddInfo( ({"mutter","odania"}),
    "Meiner Mutter Name lautet Odania.",
    "sagt: ");
  AddInfo( ({"lutana", "schwester","schwestern"}),
    "Meine Schwester heisst Lutana.",
    "sagt: ");
  AddInfo( ({"brueder","bruder","enrael"}),
    "Mein Bruder heisst Enrael.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe einen Bruder und eine Schwester.",
    "sagt: ");

	break;}
	case 1:{name="Pholdolur";
  AddInfo( ({"pholdolur"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Bimalandon und Linola.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Famione, Golain, Zylia und Selo.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Golain und Selo.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Famione und Zylia.",
    "sagt: ");
  AddInfo( ({"golain","selo"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"famione","zylia"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","bimalandon"}),
    "Meines Vaters Name ist Bimalandon.",
    "sagt: ");
  AddInfo( ({"mutter","linola"}),
    "Meiner Mutter Name lautet Linola.",
    "sagt: ");
  AddInfo( ({"tamosa", "schwester","schwestern"}),
    "Meine Schwester heisst Tamosa.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Schwestern.",
    "sagt: ");
	break;	}
	
	case 2:{name="Daniolo";
  AddInfo( ({"daniolo"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Garansa und Linwen.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Golain und Pheralas.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Famione und Miranyl.",
    "sagt: ");
  AddInfo( ({"golain","pheralas"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"famione","miranyl"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","linwen"}),
    "Meines Vaters Name ist Linwen.",
    "sagt: ");
  AddInfo( ({"mutter","garansa"}),
    "Meiner Mutter Name lautet Garansa.",
    "sagt: ");
  AddInfo( ({"tamosa", "schwester","schwestern"}),
    "Meine Schwestern heissen Linlaen und Aliaria.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Schwestern.",
    "sagt: ");
	break;}
	
}	
	


SetProp(P_NAME, name);
						
  SetProp(P_SHORT, name+" der kleine Elfenjunge");
  SetProp(P_LONG,
    "Du siehst einen kleinen Elfenjungen vor Dir, welcher noch nicht zur Schule "
    "gehen muss und daher sein junges Leben in vollen Zuegen geniessen kann.");

  SetProp(P_GENDER, MALE);
  AddId(({"junge", "elfenjunge", "elf", "elfenkind", "kind", "/nelfenkind", lower_case(name)}));
  create_default_npc(3);
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 40000);


  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  	
	         	

}
