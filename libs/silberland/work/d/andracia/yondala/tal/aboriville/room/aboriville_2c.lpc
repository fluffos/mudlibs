#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Pfad in der Elfenstadt" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem Pfad in der Elfenstadt, um Dich herum ist alles gruen. "
    "Nach Sueden gelangst Du wieder zurueck in Richtung Mittelpunkt Aborivilles. "
    "Nach Westen laeufst Du einfach weiter auf dem Pfad entlang, im Norden "
    "befindet sich eine Blaetterhoehle." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


   AddDetail( ({ "mittelpunkt" }),
    "Von dort aus kannst Du die Stadt erkunden.");    
  AddDetail( ({ "blaetterhoehle" }),
    "Du kannst sie nach Norden hin einfach betreten.");    
  AddDetail( ({ "pfad" }),
    "Du befindest Dich auf ihm und kann ihm in zwei Richtungen folgen.");    
  AddDetail( ({ "norden","sueden", "westen", "richtungen","richtung" }),
    "Du kannst dem Pfad sowohl nach Westen als auch nach Sueden folgen. Nach Norden kannst Du "
    "ihn verlassen und eine kleine Blaetterhoehle betreten.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Rauschen der Baeume");

  AddSound( ({ "rauschen","baeume" }),
    "Fast klingt es, als wollten die Baeume Dir eine Geschichte erzaehlen.");
  AddSound( ({ "geschichte" }),
    "Schade, dass Du sie nicht verstehen kannst.");

 
  AddSmell( ({ "" }),
    "");



AddExit( "norden", ELFEN_ROOM  + "aboriville_1c.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_3c.lpc" ); 
AddExit( "westen", ELFEN_ROOM  + "aboriville_2b.lpc" ); 
AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );


}

