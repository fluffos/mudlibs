
//supergeile Waffe, die man aber nicht zuecken kann :o) dafuer teuer
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>


void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein elfischer Bogen");
  SetProp(P_LONG,
    "Du siehst einen grossen, leichten Bogen. Er ist aus einem Dir unbekannten Holz." );
  SetProp(P_INFO, BS("Mit diesem Bogen verschiessen Elfenwaechter magische Pfeile. "
  "Es braucht Jahrhunderte lange Uebung um mit diesem besonderen Bogen umgehen zu koennen.") );
  SetProp(P_NAME, "Bogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "elfenbogen", ""}) );
  SetProp(P_NAME_ADJ, "elfisch");

  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 100 );
  SetProp(P_DAM_TYPE,  DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
( P_MATERIAL, ({ MAT_MISC_WOOD, MAT_MISC_MAGIC }) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 1500);
  SetProp(P_QUALITY_DECAY, 200);
/*  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );*/
                                       

  SetProp(P_WC_BONUS, (["elfenwaechter": 200]) );
//  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:41]) );
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 1;
}
