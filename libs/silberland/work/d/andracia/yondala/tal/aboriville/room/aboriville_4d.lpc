//26.3.2019 Suedosten auskommentiert, da hier das Gesellenstueck von Bleat hin soll

#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Platz in der Elfenstadt" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einem grossen Platz inmitten der Elfenstadt Aboriville. "
    "Von hier aus kannst Du die Stadt erkunden und sie auch wieder verlassen.\n"
    "Ein kleiner Wegweiser steht hier herum." );
AddItem(ELFEN_NPC + "elf_std.lpc",REFRESH_DESTRUCT);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "platz" }),
    "Der Platz, auf dem Du stehst bildet den Mittelpunkt von Aboriville.");    
  AddDetail( ({ "mittelpunkt" }),
    "Von diesem Platz aus kannst Du Aboriville in viele Richtungen erkunden.");    
  AddDetail( ({ "richtungen" }),
    "Du kannst von hier aus nach Nordosten, Nordwesten, Suedwesten, Suedosten und Osten gehen.");    
  AddDetail( ({ "wegweiser" }),
    "Er besteht aus Holz, Du kannst ihn lesen.");    
  AddDetail( ({ "nordwesten", "nordosten", "suedosten","suedwesten", "osten" }),
    "Schau Dir doch den Wegweiser an.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht in der ganzen Stadt aus Holz und bildet hier eine "
    "grosse Plattform.");    
  AddDetail( ({ "plattform" }),
    "Du stehst auf einer grossen, hoelzernen Plattform, welche den Mittelpunkt "
    "Aborivilles bildet.");    
  AddDetail( ({ "hoheitsgebiet" }),
    "Das Hoheitsgebiet liegt nordwestlich von Dir.");    
  AddDetail( ({ "kindergarten" }),
    "Nordoestlich von Dir erklingt helles Kinderlachen. Dort muss der "
    "Kindergarten sein.");    
  AddDetail( ({ "geschaeftsstadtteil" }),
    "Suedwestlich von Dir sind einige Geschaefte zu erkennen.");    
  AddDetail( ({ "suedosten" }),
    "Im Suedosten befindet sich ein grosses Privatgrundstueck.");    
  AddDetail( ({ "osten" }),
    "Im Osten befindet sich eine Haengebruecke die zum Wachweg fuehrt.");    
  AddDetail( ({ "geschaefte" }),
    "Im Suedosten dieses Platzes befinden sich Geschaefte und dergleichen.");    
  AddDetail( ({ "privatgrundstueck", "privatbesitz" }),
    "Es handelt sich dabei um einen Garten. Ein kleines Schild steht vorne an.");    
  AddDetail( ({ "schild" }),
    "Es ist zu weit weg um es zu lesen.");    
  AddDetail( ({ "haengebruecke" }),
    "Ueber die Haengebruecke im Osten gelangst Du zum Wachweg.");    
  AddDetail( ({ "wachweg" }),
    "Der Wachweg liegt im Osten von Dir, Du kannst ihn ueber die Haengebruecke "
    "erreichen und von dort aus die Stadt verlassen.");    
  AddDetail( ({ "garten" }),
    "Suedoestlich von Dir ist ein Garten, der aber wohl Privatbesitz ist. Du "
    "solltest Dir gut ueberlegen, ob Du ihn wirklich betreten moechtest.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "schild" }),
    "Du kannst von hier aus leider nicht entziffern was darauf steht.");
  AddReadDetail( ({ "wegweiser" }),
    "Nordwesten -> Hoheitsgebiet\n"
    "Nordosten  -> Kindergarten\n"
    "Suedwesten -> Geschaeftsstadtteil\n"
    "Suedosten  -> Privatgrundstueck\n"
    "Osten      -> Wachweg");    



  AddSound( ({ "kinderlachen","kindergarten","lachen" }),
    "Froehliches Kinderlachen erklingt aus dem Kindergarten.");
  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");


AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_3c.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_3e.lpc" ); 
//AddExit( "suedosten", ELFEN_ROOM  + "aboriville_5e.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_5c.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_4e.lpc" ); 
}

