#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gruenes Gewand");
  SetProp(P_LONG,
    "Du siehst ein gruenes Gewand, welches mit feinsten Stickereinen verziehrt ist." );

  SetProp(P_NAME, "Gewand");
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gewand", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
                                       

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_PROTECTION, DT_MIND );
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE : 150]) );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
