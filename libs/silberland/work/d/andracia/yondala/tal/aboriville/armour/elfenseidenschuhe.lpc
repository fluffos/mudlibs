#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Seidenschuhe");
  SetProp(P_LONG,
    "Du siehst ein paar seidene Schuhe, die wohl mehr Zierde als Schutz darstellen." );

  SetProp(P_NAME, "Seidenschuhe");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"seidenschuhe", "schuhe", ""}) );
                                       

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_SILK:90, MAT_LEATHER:10 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 50);

   AddProp(P_DAM_PROTECTION, ([DT_COLD]) );
 

}
