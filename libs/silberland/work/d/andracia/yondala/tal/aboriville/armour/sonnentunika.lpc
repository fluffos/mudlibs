#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine leuchtende Tunika");
  SetProp(P_LONG,
    "Du siehst eine Tunika vor Dir, wie Du sie nirgends vorher gesehen hast. Sie strahlt hell "
    "wie das Licht der Sonne und Du kannst nicht erkennen, woraus sie gemacht ist." );

  SetProp(P_NAME, "Tunika");
  SetProp(P_NAME_ADJ, "leuchtend");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tunika", "", ""}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 40);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
                                       

  SetProp(P_QUALITY_DECAY, 100);
    SetProp(P_DAM_PROTECTION, DT_FIRE);
//SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1]) );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
