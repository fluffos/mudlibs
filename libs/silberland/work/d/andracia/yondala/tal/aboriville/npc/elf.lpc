//Standartelfe weiblich oder maennlich

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

int geschlecht;

void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
geschlecht=random(2);
switch (geschlecht)
{
	case 1:{
  SetProp(P_SHORT, "Ein Elf");
  SetProp(P_LONG,
    "Du siehst einen anmutigen Elf vor Dir, der sich mit geschmeidigen Bewegungen fortbewegt.");
  SetProp(P_NAME, "Elf");
  SetProp(P_GENDER, MALE);
  AddId(({"elf"}));
  SetProp(P_KILL_NAME, "Ein Elf");
  create_default_npc(10);
  SetProp(P_SIZE, 185);
  SetProp(P_WEIGHT, 85000);
  break;

}
default:{  SetProp(P_SHORT, "Eine Elfe");
  SetProp(P_LONG,
    "Du siehst eine anmutige Elfe vor Dir, die sich mit geschmeidigen Bewegungen fortbewegt.");
  SetProp(P_NAME, "Elfe");
  SetProp(P_GENDER, FEMALE);
	AddId(({"elfe", "elfin"}));
  SetProp(P_KILL_NAME, "Eine Elfe");
  create_default_npc(8);
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 70000);

	}}
	// SetProp(P_DEFENDERS, (({"elfenwaechter", "elf","elfe"})));
  AddId(({"/nelfennorm"}));

	SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_4d");
	SetProp (P_MNPC_AREA, ({
		ELFEN_ROOM + "aboriville_2a", ELFEN_ROOM + "aboriville_2b", ELFEN_ROOM + "aboriville_2c", ELFEN_ROOM + "aboriville_3c", 
		ELFEN_ROOM + "aboriville_4d", ELFEN_ROOM + "aboriville_5c", ELFEN_ROOM + "aboriville_6b", ELFEN_ROOM + "aboriville_3e", 
		ELFEN_ROOM + "aboriville_4e", ELFEN_ROOM + "aboriville_4f", ELFEN_ROOM + "aboriville_4g", ELFEN_ROOM + "aboriville_4h", 
		ELFEN_ROOM + "aboriville_5e"}));
	SetProp (P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({5, 10, 5}));



  SetProp(P_ARTICLE, 1);
  SetProp(P_HANDS, ({" mit einem Dolch",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Elfenmoerder!");


  AddInfo(DEFAULT_INFO, "sagt: darueber darf ich nicht mit Euch sprechen.\n");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");


  SUID;
  CLONEME(ELFEN_WEAPON "elfendolch" );
  command("zuecke dolch");
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
}


void InformDefend(object enemy)
{
 Kill(enemy);
}