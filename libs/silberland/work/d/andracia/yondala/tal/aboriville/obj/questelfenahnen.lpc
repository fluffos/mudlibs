void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "\nquestelfenahnen");
  SetProp(P_GENDER, MALE);
  AddId("\nquestelfenahnen");

  SetProp(P_MATERIAL, MAT_AIR );
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
	AddCmd(({"fuege","fueg"}), "einfuegen"); 


}
//fuege bei 1 name ein
int einfuegen(string str)
{
	int stelle;
	string name;
	//write (file_name(environment(TP))+"\n");
if( file_name(environment(TP)) != ELFEN_ROOM + "aboriville_2c_o" )	return 0;
	if(!str)
		{
			write("Was moechtest Du wo einfuegen? (fuege bei nummer name ein)\n");
			return 1;
		}
		
	notify_fail("Was moechtest Du wo einfuegen? (fuege bei nummer name ein)\n");
	
	if(sscanf(str,"bei %d %s ein", stelle, name)!=2) return 0;
  
  if(stelle==1&&name=="garansa")
  	{
  		sname1=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
  	
  else if(stelle==2&&name=="riaona")
  	{
  		sname2=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
  	
  else if(stelle==3&&name=="fenween")
  	{
  		sname3=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
  	
  else if(stelle==4&&name=="teluwen")
  	{
  		sname4=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
  	
  else if(stelle==5&&name=="bimalandon")
  	{
  		sname5=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  	
  else if(stelle==6&&name=="mindala")
  	{
  		sname6=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
  	
  else if(stelle==7&&name=="nerael")
  	{
  		sname7=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  else if(stelle==8&&name=="miranola")
  	{
    	sname8=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  else if(stelle==9&&name=="linwen")
  	{
		  sname9=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  else if(stelle==10&&name=="odania")
  	{
    	sname10=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  else if(stelle==11&&name=="linel")
  	{
    	sname11=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}

  else if(stelle==12&&name=="faemil")
  	{
    	sname12=name;
  		write("Du fuegst den Namen an die richtige Stelle ein.\n");
  	}
	else
		write("Gerade als Du den Namen einsetzen willst bist Du Dir doch nicht mehr ganz so "
		      "sicher. Ueberlege besser noch einmal!\n");
return 1;
	}
	
	
elf1()
{return capitalize(sname1);}
