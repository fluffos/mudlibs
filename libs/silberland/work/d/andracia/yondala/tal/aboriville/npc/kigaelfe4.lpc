inherit ELFEN_NPC+"kigaelfe_std.lpc";


int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Lianda";
  AddInfo( ({"lianda"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Miranola und Faemil.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Pheralas und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Miranyl und Linlaen.",
    "sagt: ");
  AddInfo( ({"pheralas","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlaen","miranyl"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","faemil"}),
    "Meines Vaters Name ist Faemil.",
    "sagt: ");
  AddInfo( ({"mutter","Fenween"}),
    "Meiner Mutter Name lautet Miranola.",
    "sagt: ");
  AddInfo( ({"schwester","schwestern"}),
    "Ich habe keine Schwester.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "vindo", "meldo"}),
    "Meine Brueder heissen Vindo und Meldo.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Brueder.",
    "sagt: ");

	break;}
	case 1:{name="Melina";
  AddInfo( ({"melina"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Mindala und Felerian.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Linlaen.",
    "sagt: ");
  AddInfo( ({"mondol","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","linlaen"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","felerian"}),
    "Meines Vaters Name ist Felerian.",
    "sagt: ");
  AddInfo( ({"mutter","mindala"}),
    "Meiner Mutter Name lautet Mindala.",
    "sagt: ");
  AddInfo( ({"semione","belina","minda", "schwester","schwestern"}),
    "Meine Schwestern heissen Semione, Belina und Minda.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe drei Schwestern.",
    "sagt: ");
	break;}
		
	case 2:{name="Minda";
  AddInfo( ({"minda"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Mindala und Felerian.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Linlaen.",
    "sagt: ");
  AddInfo( ({"mondol","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","linlaen"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","felerian"}),
    "Meines Vaters Name ist Felerian.",
    "sagt: ");
  AddInfo( ({"mutter","mindala"}),
