    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe drei Schwestern.",
    "sagt: ");
	break;}
	
}	
	


SetProp(P_NAME, name);
SetProp(P_SHORT, name+" das kleine Elfenmaedchen");
  SetProp(P_LONG,
    "Du siehst ein kleins Elfenmaedchen vor Dir, welches noch nicht zur Schule "
    "gehen muss und daher sein junges Leben in vollen Zuegen geniessen kann.");

  SetProp(P_GENDER, FEMALE);
  AddId(({"maedchen", "elfenmaedchen", "elfin", "elfe", "elfenkind", "kind", "/nelfenkind", lower_case(name)}));
  create_default_npc(4);
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 35000);


  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


	         	

