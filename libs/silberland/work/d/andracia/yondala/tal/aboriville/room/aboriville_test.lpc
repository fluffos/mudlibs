#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>
int zweig;
int dadolch;
object hakenraum;
void reset()
{
	if (dadolch==0) 
		{
			dadolch=1;
			tell_room(TO, "Ein Elfenkind legt etwas in ein Fach und springt davon.\n");
  AddDetail( ({ "regal" }),
    "In dem Regal liegt Etwas.");    
  AddDetail( ({ "etwas" }),
    "Es scheint ein kleiner Dolch zu sein. Ob Du ihn einfach nehmen darfst?");    
  AddDetail( ({ "dolch" }),
    "Du siehst einen kleinen Dolch, der wohl nur von Kindern benutzt wird, "
    "die daran den Umgang mit einer Waffe ueben.");    

		}

::reset();
	}

