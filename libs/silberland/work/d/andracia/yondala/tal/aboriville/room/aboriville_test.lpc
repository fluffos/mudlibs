int nehmen(string str)
{
	string aufhaenger,dummy;
	object ding;
	notify_fail("Was moechtest Du nehmen?\n");
	if(str=="etwas"	 ||str=="dolch")
	 {
	 	if(dadolch)
	 		{
	 			if(TP->QueryProp(P_LEVEL)>10)
	 				{
	 					write("Dafuer bist Du nun wirklich schon zu gross.\n");
	 					return 1;
	 					}
	 			write("Du nimmst einen kleinen Dolch aus dem Regal.\n");
	 			say(TPN+" nimmt einen Dolch aus dem Regal.\n",TP);
	 			CLONE(ELFEN_WEAPON +"kleinerelfendolch.lpc", TP);
	 			dadolch=0;
			  RemoveDetail( "dolch" );    
  			RemoveDetail( "etwas" );    
    		AddDetail( ({ "regale", "regal" }),
    			"Die kleinen Regale sind aus der Wand gewachsen und bieten genug Platz fuer die Kinder.");    
  			return 1;
	 			}
			}
		if(str=="alles von haken")
			{
				write("Nana, nicht so gierig, immer schoen einzeln nehmen!\n");
				return 1;
			}
		if(sscanf(str,"%s von haken%s",aufhaenger,dummy)!=2)return 0;
		if(present(aufhaenger,hakenraum))
			ding=present(aufhaenger,hakenraum);
		else
			{
				write("So etwas haengt nicht an den Haken.\n");
				return 1;
			 }
		ding->move(TP,M_SILENT);
		write("Du nimmst "+ding->name(WEN)+" vom Haken.\n");
		say("Du nimmt "+ding->name(WEN)+" vom Haken.\n");
		return 1;
}