void create() 
{
  ::create();
  
  hakenraum=to_object("/d/andracia/yondala/aboriville/room/kiga_haken.lpc");
  dadolch=1;
  SetProp(P_INT_SHORT, "Im Vorraum des Kindergartens");
  SetProp(P_INT_LONG, 
  		"Du stehst im Eingangsbereich des Kindergartens. Wie ueberall "
  		"in Aboriville ist hier alles aus Holz. An den Waenden befinden sich Regale "
  		"und Zweige fuer die Kleidung der Kinder.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Holz. An einer Wand befinden sich einige Zweige, aus den "
    "anderen Waenden sind kleine Regale gewachsen.");    
  AddDetail( ({ "zweige","zweig" }),
    "Kleine Zweige sind an den Waenden gewachsen. An ihnen koennen die Kinder bei "
    "Bedarf ihre Kleidung aufhaengen wie an einen Haken.");    
  AddDetail( ({ "regale" }),
    "Die kleinen Regale sind aus der Wand gewachsen und bieten genug Platz fuer die Kleidung der Kinder. In einem Regal liegt Etwas.");    
  AddDetail( ({ "decke" }),
    "Du siehst keine Decke ueber Dir, sondern nur den Himmel.");    
  AddDetail( ({ "platz" }),
    "Die Regale bieten genug Platz fuer die Kleidung aller Kinder.");    
  AddDetail( ({ "kleidung" }),
    "Um zu sehen, was Du traegst tipp doch einfach <ausruestung>.");    
  AddDetail( ({ "eingangsbereich" }),
    "Du befindest Dich im Eingangsbereich. Du kannst hier den Kindergarten betreten oder auch "
    "verlassen.");    
  AddDetail( ({ "bedarf","moment" }),
    "Im Moment haengen dort eine kleine Tunika und ein Guertel. Wenn Du so etwas brauchst "
    "kannst Du es sicher von den Haken klauben.");    
  AddDetail( ({ "haken" }),
    "Die meisten Zweige wurden abgebrochen, im Moment haengen dort nur zwei Kleidungsstuecke.");    
  AddDetail( ({ "tunika","guertel", "sachen" }),
    "Du kannst diese Sachen vom Haken klauben, wenn Du sie benoetigst.");    
  AddDetail( ({ "regal" }),
    "In dem Regal liegt Etwas.");    
  AddDetail( ({ "etwas" }),
    "Es scheint ein kleiner Dolch zu sein. Ob Du ihn einfach nehmen darfst?");    
  AddDetail( ({ "dolch" }),
    "Du siehst einen kleinen Dolch, der wohl nur von Kindern benutzt wird, "
    "die daran den Umgang mit einer Waffe ueben.");    
  AddDetail( ({ "kleidungsstuecke" }),
    "Eine Tunika und ein Guertel."); 
   AddSpecialDetail( ({ "haken" }), "haken" );

  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
//  AddSound( DEFAULT_SOUND,
//    "");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");


AddExit( "nordosten", ELFEN_ROOM  + "aboriville_2f.lpc" ); 
AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_4d.lpc" ); 
	AddCmd(({"haenge", "haeng"}), "haengen"); 
	AddCmd(({"brich", "brech","breche"}), "brechen"); 
	AddCmd(({"nehme", "nimm","nehm"}), "nehmen"); 
}

int haengen(string str)
{
	string aufhaenger,dummy;
	object ding;
	notify_fail("Was moechtest Du aufhaengen?\n");
	if (!str) return 0;
	if(sscanf(str,"%s an haken%s",aufhaenger,dummy)!=2&&sscanf(str,"%s auf%s",aufhaenger,dummy)!=2)
		{
			write("nicht erkannt\n");
			return 0;
		}
		
  if(!present(aufhaenger,TP))
  	{
  		write("So etwas hast Du nicht.\n");
  		return 1;
  	}
  ding=present(aufhaenger,TP);
  if(ding->QueryProp(P_NODROP))
  	{
  		write(ding->QueryProp(P_NODROP)+"\n");
  		return 1;
  	}
  if(!ding->QueryProp(P_AC))
  	{
  		write("Du kannst nur Kleidung an den Haken haengen.\n");
  		return 1;
  	}
  write("Du haengst "+ding->name(WEN)+" an einen Haken.\n");
  say("Du haengt "+ding->name(WEN)+" an einen Haken.\n");
  ding->move(hakenraum,M_SILENT);
  return 1;

	//write ("Du bist Dir nicht sicher, ob die Haken so etwas aushalten, also laesst Du es lieber.\n"); 
}


int brechen(string str)
{
	notify_fail("Was moechtest Du abbrechen?\n");
	if (str!="zweig"&&str!="zweig ab") return 0;
	if(zweig)
		{
			write ("Du brichst einen kleinen Zweig ab und steckst ihn ein.\n"); 
			say(TPN+" bricht einen kleinen Zweig ab und steckt ihn ein.\n",TP);
			CLONE(ELFEN_OBJ+"kleinerzweig.lpc", TP);
			zweig--;	
		}
		else
			write ("Es ist gerade keiner in Deiner Naehe, vielleicht solltest Du ein bisschen warten, bis die Zweige nachgewachsen sind.\n");
			return 1;
}
