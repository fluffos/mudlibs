#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Pfad in der Elfenstadt" );

  SetProp( P_INT_LONG,
    "Du stehst auf einem Pfad in der Elfenstadt, um Dich herum ist alles gruen."
    "Nach Norden kannst Du eine natuerliche Baumhoehle betreten. Nach Osten "
    "gelangst Du wieder da hin wo Du herkommst." );
  AddItem(ELFEN_NPC + "raupe.lpc",REFRESH_DESTRUCT);
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


   AddDetail( ({ "norden","osten" }),
    "Dahin kannst Du gehen.");    
  AddDetail( ({ "pfad" }),
    "Du befindest Dich auf einem Pfad in der Elfenstadt.");    
  AddSpecialDetail( ({ "hoehle","baumhoehle"  }), "hoehle" );
  AddSpecialDetail( ({ "schild"  }), "schild" );
 
  AddDetail( ({ "pfad" }),
    "Du stehst auf einem Pfad der Elfenstadt.");    
  AddDetail( ({ "" }),
    "");    




AddExit( "norden", ELFEN_ROOM  + "aboriville_1a.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_2b.lpc" ); 

AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );


}

string hoehle()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "Die Hoehle liegt noerdlich von Dir. Ueber ihrem Eingang siehst Du ein grosses, hoelzernes Schild.\n";    
	else
	  return 	"Die Hoehle liegt noerdlich von Dir.\n";	
 }
 
 
