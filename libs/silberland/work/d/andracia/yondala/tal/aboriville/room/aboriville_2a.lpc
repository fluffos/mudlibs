 string schild()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  
	  " _____________________________\n"+
    "|                             |\n"+
    "|*                           *|\n"+
    "|   Brisi's kleine Apotheke   |\n"+
    "|   geoeffnet Tag und Nacht   |\n"+
    "|      fuer Ihr Wohl!         |\n"+
    "|                             |\n"+
    "|*                           *|\n"+
    "|_____________________________|\n";
	  
	   
	else
	  return 	"Sowas siehst Du da nicht\n";	
 }