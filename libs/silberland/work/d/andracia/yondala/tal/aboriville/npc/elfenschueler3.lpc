//Alari oder Aliaria

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"elfenschueler_std.lpc";

int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(2);
switch (wer)

{
	case 0:{name="Alari";
  AddInfo( ({"alari"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Nela und Lorion.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Zylia und Selo.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Selo.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Zylia.",
    "sagt: ");
  AddInfo( ({"mondol","selo"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","zylia"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","lorion"}),
    "Meines Vaters Name ist Lorion.",
    "sagt: ");
  AddInfo( ({"mutter","nela"}),
    "Meiner Mutter Name lautet Nela.",
    "sagt: ");
  AddInfo( ({"nalda", "schwester","schwestern"}),
    "Meine Schwester heisst Nalda.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Mein Bruder heisst Saladion.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe eine Schwester.",
    "sagt: ");

	break;}
	case 1:{name="Aliaria";
  AddInfo( ({"aliaria"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Garansa und Linwen.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Pheralas und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Miranyl und Famione.",
    "sagt: ");
  AddInfo( ({"pheralas","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"miranyl","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","linwen"}),
    "Meines Vaters Name ist Linwen.",
    "sagt: ");
  AddInfo( ({"mutter","garansa"}),
    "Meiner Mutter Name lautet Garansa.",
    "sagt: ");
  AddInfo( ({"lalen", "schwester","schwestern"}),
    "Meine Schwester heisst Lalen.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "daniolo"}),
    "Mein Bruder heisst Daniolo.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe eine Schwester und einen Bruder.",
    "sagt: ");

	break;}
	

}	
	

SetProp(P_NAME, name);
						SetProp(P_SHORT, name+" das Elfenmaedchen");
  SetProp(P_LONG,
    "Du siehst ein Elfenmaedchen vor Dir, welches schon zur Schule geht und Dich aus klugen Augen "
    "neugierig betrachtet.");

  SetProp(P_GENDER, MALE);
  AddId(({"maedchen", "elfenmaedchen", "elf", "elfenkind", "kind","\nelfenschueler", "/nelfenkind", lower_case(name)}));
  create_default_npc(4);
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 40000);
  AddInfo( ({"name","namen"}),
    "Man nennt mich "+name+".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");



}