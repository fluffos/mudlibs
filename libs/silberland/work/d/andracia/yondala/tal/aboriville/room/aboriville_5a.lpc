//Hier sollen nur Waffen verkauft werden
inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Blaetterhoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier in einer kleinen Hoehle welche ausschliesslich "
    "von den Aesten und Blaettern der Baeume um Dich herum gebildet wird. "
    "Durch die Blaetter ueber Dir blitzt ab und zu die Sonne hervor. An der "
    "Ostseite der Hoehle ist eine seltsame Ausbuchtung." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
	SetStorageRoom(ELFEN_ROOM  + "aboriville_waffenlager.lpc");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "LINOLA");
  SetProp(P_SHOPKEEPER_NAME, "Linola");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SPECIAL_SHOP,([P_WC:"Linola sagt: Ich kaufe nur Waffen an.\n"]));
  AddItem(ELFEN_NPC + "elfe_linola.lpc",REFRESH_DESTRUCT);

  AddSpecialDetail( ({ "hoehle" }), "elf" );
  AddSpecialDetail( ({ "waffenladen" }), "waffenladen" );
  AddSpecialDetail( ({ "waffen", "waren" }), "waffen" );
  AddSpecialDetail( ({ "wand", "waende" }), "wand" );
  AddSpecialDetail( ({ "tresen", "ausbuchtung" }), "tresen" );
  AddSpecialDetail( ({ "ostseite" }), "ostseite" );
  AddSpecialDetail( ({ "ausbuchtung" }), "ausbuchtung" );
  AddSpecialDetail( ({ "wahrnehmung" }), "wahrnehmung" );


  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir wird von den Aesten der Baeume eingeramt, dazwischen "
    "blitzt ab und zu eine lachende Sonne auf Dich herunter.");    
  AddDetail( ({ "sonnenlicht","sonne","licht" }),
    "Das Licht der Sonne lacht durch die Blaetter auf Dich herunter und erhellt die Hoehle.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste um Dich herum haben sich hier zu einer Hoehle verdichtet.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter um Dich herum sind sehr dicht, lediglich durch die Decke "
    "lassen sie etwas Sonnenlicht herein, wenn es regnet bilden "
    "sie jedoch sofort ein dichtes Dach.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht hier aus Aesten und Blaettern, hin und wieder blitz "
    "die Sonne hindurch.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht wie auch im Rest der ganzen Stadt aus Holz.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst scheinbar genauso, wie die Elfen es brauchen.");    
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "kronen", "krone" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer aus Aesten und Blaettern gewachsenen Hoehle.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume im Wind und das froehliche Zwitschern der Voegel in den Baeumen.");

  AddSound( ({ "rauschen","wind" }),
    "Ein leichter Wind sorgt fuer ein leises Rauschen in den Baeumen.");
  AddSound( ({ "zwitschern","voegel" }),
    "Ein paar Voegel zwitschern froehliche Lieder.");
  AddSound( ({ "lieder","melodie" }),
    "Die Melodie ist wunderschoen.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm frisch nach Wald, Blueten und suessen Fruechten");

  AddSmell( ({ "wald" }),
    "Es riecht nach dem Harz der Baeume, die Dich umgeben.");
  AddSmell( ({ "harz","baeume" }),
    "Ein sehr wuerziger Geruch.");
  AddSmell( ({ "blueten","bluetenduft" }),
    "Ein leichter Hauch von Bluetenduft wird an Dich herangetragen.");
  AddSmell( ({ "fruechte" }),
    "Die Fruechte in den Baeumen verbreiten einen suesslichen Duft.");
  


   AddDetail( ({ "sinn", "wunsch","detail","satz" }),
    "Auf vielfachen Wunsch steht auch fuer dieses Detail ein Satz da, auch wenn man nun mal keinen Sinn sieht, aber bitte.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");



AddExit( "suedosten", ELFEN_ROOM  + "aboriville_6b.lpc" ); 

}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
	  	result = BS( "Du befindest Dich hier im Waffenladen von Aboriville. Um den "
	  	"Laden ist in eine kleinen Hoehle aus Aesten und Blaettern gewachsen "
	  	"welche ausschliesslich so relativ dichte Waende bilden. Lediglich durch "
	  	"die Decke blitzt ab und zu die Sonne hervor. An der Ostseite befindet sich "
	  	"der Verkaufstresen.\nEs gibt einen sichtbaren Ausgang: suedosten.\n") ;
	  }	  	
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}


string hoehle()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return "Um den Waffenladen ist eine kleine, solide Hoehle aus Aesten "
	  	"und Blaettern gewachsen.\n";
	  }
	  return 	"Du stehst in einer kleinen Hoehle, die aus Aesten und Blaettern "
	  				"gewachsen ist. Warum siehst Du allerdings mit Deiner "
	  				"beschraenkten Wahrnehmung nicht.\n";	
 }
string wahrnehmung()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return "Deine Wahrnehmung koennte besser nicht sein.\n";
	  }
	  return 	"Deine Wahrnehmung ist stark begrenzt, vielleicht solltest Du etwas dagegen tun.\n";	
 }
 
 
string waffenladen()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Du stehst hier im Waffenladen von Aboriville.\n";
	  }
	  return 0;
 } 



 
string wand()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return "Die Waende bestehen aus den Aesten und Blaettern der Baeume "
	  	"die diese Stadt tragen. Dazwischen findest Du immer wieder Waffen "
	  	"jeglicher Art.\n";
	  }
	  return "Die Waende bestehen aus den Aesten und Blaettern der Baeume die diese Stadt tragen.\n";	
 } 
 
string waffen()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return 	"An den Aesten der Waende haengen verschiedenste Waffen, die "
	  					"hier zum Verkauf stehen.\n";
	  }
	  return 0;
 } 
 
string tresen()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return "Hinter diesem Tresen steht normalerweise Linola und bietet ihre Waren an.\n";
	  }
	  return 0;
 }   
 
 string ostseite()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Dort befindet sich der Verkaufstresen.\n";
	  }
	  return "Dort befindet sich eine Ausbuchtung deren Sinn Dir nicht klar wird.\n";	
 } 
 
 
  string ausbuchtung()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Es ist ein Verkaufstresen.\n";
	  }
	  return "Was das wohl sein mag?\n";	
 } 