erledigt()//Ende der Quest
{
	object questitem;
	string sname;
	
	if (!present("\nquestelfenahnen",TP))//Wenn die Quest nicht begonnen wurde
	{
		command ("sag Ihr habt die Quest doch gar nicht begonnen, "+TPN+"!");
		return;
	}
	
	questitem=present("\nquestelfenahnen",TP);
	

//stimmen alle Namen bzw wurden alle eingefuegt?
	  if(questitem->elf1()=="Garansa"
	  	&&questitem->elf2()=="Riaona"
	  	&&questitem->elf3()=="Fenween"
	  	&&questitem->elf4()=="Teluwen"
	  	&&questitem->elf5()=="Bimalandon"
	  	&&questitem->elf6()=="Mindala"
	  	&&questitem->elf7()=="Nerael"
	  	&&questitem->elf8()=="Miranola"
	  	&&questitem->elf9()=="Linwen"
	  	&&questitem->elf10()=="Odania"
	  	&&questitem->elf11()=="Linel"
	  	&&questitem->elf12()=="Faemil")
	  	
	  	{
	  		//if(TP->GiveQuest("Elfenahnen")==1) //Quest als bestanden deklarieren
	  		sname=TPN+"\n";
			write_file("/d/andracia/yondala/wolken/lunia/portale/portal_aboriville_zugang.lpc", sname);
			questitem->remove();
	  		command("sag Ohja, er ist vollstaendig! Habt Dank, "+TPN+"!");
			command("sag Als Zeichen meiner Anerkennung mache ich hiermit unser Portal fuer Euch sichtbar!");
 
  			}

	else
command("sag Leider ist der Stammbaum noch nicht vollstaendig. Bitte fuegt die richtigen Namen fuer mich ein.");	
	
	return 1;
	}
	
	
void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(3));
}
	
void InformDefend(object enemy)
{
 Kill(enemy);
}	

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}