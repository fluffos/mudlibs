void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("tasinion")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ayala die aelteste Kriegerin");
  SetProp(P_LONG,
    "Du siehst eine grosse, starke Kriegerin vor Dir. Ihre Kleidung ist schlicht, "+
	"aber sehr fein gewebt und liegt locker um ihren muskuloesen Koerper. "+
	"Das Alter der Kriegerin laesst sich schwer bestimmen, denn sie hat keine Falten, "+
	"doch zeugen Ihre Augen von grosser Weisheit, die nur ein langes Leben gebracht "+
	"haben kann. Sie blickt Dich guetig an, doch Du bist sicher, dass sie jederzeit kampfbereit ist." );
  SetProp(P_NAME, "Ayala");//nur der Name 1. Buchstabe gro�
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"ayala", "elfe", "aelteste", "kriegerin", "elfin","Magiemeister"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");
/*  SUID;
  CLONEME(ELFEN_ARMOUR + ".lpc");
  CLONEME(ELFEN_ARMOUR + ".lpc");
  command("trage alles");
  CLONEME(ELFEN_OBJ + ".lpc");  */
  create_default_npc(37);
  SetProp(P_HANDS, ({" mit ihrem Schwert",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, 800);

  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.5, DT_EXPLOSION: 0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 1.0, DT_TERROR: 0.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,50);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst %s nicht entkommen!");
  SetProp(P_KILL_NAME, "Ayala, die aelteste Kriegerin");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Yondala allein mag uns diese Weisheit vermitteln.\n");
//zweimal da wegen der Farben...
 
  AddInfo( ({ "hilfe", "aufgabe"}), #'hilfe );//'

 // AddInfo( ({ "datei"}), #'datei );//'

  AddInfo( ({"namen"}), 
    "Ach, ich kann mir Namen so schlecht merken.",
    "sagt: "); 
  AddInfo( ({"enkel"}), 
    "Ich habe jede Menge Enkel, die sind auch groesstenteils selbst schon verheiratet. Nur "
    "kann ich mir nie merken wer mit wem.",
    "sagt: "); 
  AddInfo( ({"stammbaum"}), 
    "Jeder von uns fertigt einen Stammbaum seiner Nachkommen an, nur leider habe ich nicht so "
    "viel Zeit wie die anderen Aeltesten. Ausserdem weiss ich viele Namen nicht mehr. Es sind "
    "einfach zu viele. Der Stammbaum haengt hier schon an der Wand, Ihr koennt lesen, wie weit "
    "ich gekommen bin.",
    "sagt: "); 
  AddInfo( ({"ehegatten"}), 
    "Nun, die meisten meiner Enkel sind vermaehlt, nur kann ich mir einfach nicht alle Namen merken.",
    "sagt: "); 
  AddInfo( ({"ayala","kaempferin","aelteste kaempferin"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 

  AddCmd( ({ "erledigt"}), "erledigt" ); 
     
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
//  AddCmd(({"test"}),"testobgemacht");

SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,600,
	        "Ayala schiesst einen heiligen Pfeil auf Dich.\n",
	        "Ayala schiesst einen heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(4,750,
	         "Ayala schiesst einen starken heiligen Pfeil auf Dich.\n",
	         "Ayala schiesst einen starken heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,1200,
	         "Ayala schiesst einen brennenden Pfeil auf Dich.\n",
	         "Ayala schiesst einen brennenden Pfeil auf @WEN.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,150,
	         "Ayala schiesst einen vergifteten Pfeil auf Dich.\n",
	         "Ayala schiesst einen vergifteten Pfeil auf @WEN.\n",
	         ({DT_FIRE}),"gift", ([SP_SHOW_DAMAGE:1]) );








/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
//erstmal nur die Standartsachen
  SUID;
