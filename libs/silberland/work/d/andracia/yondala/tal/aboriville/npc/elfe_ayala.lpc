inherit ELFEN_NPC+"elf_aelteste_std.lpc";

//Liest aus der Datei "/d/andracia/yondala/lunia/portale/portal_aboriville_zugang.lpc"
//ob ein Spieler (Namen uebergeben) die Quest schon absolviert hat
//Bei Ja: Rueckgabe 1
int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
//write("teste\n");
	
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_aboriville_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			//write("Name "+ i + " " + einname+"\n");
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}


string hilfe()//Info, startet die Quest
{
	//if(this_player()->QueryQuest("Elfenahnen")) //Wenn die Quest schon beendet wurde
	if (testobgemacht(TPN))	
		return "sagt: Ich brauche Eure Hilfe nicht mehr.\n";

 	if(present("\nquestelfenahnen",TP))//Wenn die Quest schon begonnen wurde
		return "fragt: Ihr helft mir doch bereits, habt Ihr schon alle Namen eingefuegt?\n"+
					 "Ayala sagt: Tippt einfach \"erledigt\", wenn Ihr mit der Aufgabe fertig seid!\n";


  CLONE(ELFEN_OBJ + "questelfenahnen.lpc", TP);
		return "sagt: Ich brauche Hilfe bei der Anfertigung unseres Stammbaumes. \n"+
		       "Ayala sagt: Ich habe schon fast alle Namen meiner Nachkommen aufgefuehrt. \n"+
		       "Ayala sagt: Lediglich die Namen der Ehegatten meiner Enkel fehlen. Waeret \n"+
		       "Ayala sagt: Ihr so nett sie fuer mich herauszufinden und einzufuegen? \n"+
		       "Ayala sagt: Tippt einfach \"erledigt\", wenn Ihr alle Namen eingefuegt habt.\n";

		
	}
