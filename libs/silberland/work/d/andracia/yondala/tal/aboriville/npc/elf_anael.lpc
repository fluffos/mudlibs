//05.09.2022: Neuer Verkaeufer im Laden
//ist angreifbar und hat ein paar Zauber

inherit "std/npc";

inherit"/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <moredef.h>
#include <npc.h>
#include <language.h>


string name;
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
   call_out("check", 0, TP);

}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Anael");
  AddId(({"elf","verkaeufer","anael", "/nelfennorm", "ANAEL"}));
  SetProp(P_KILL_NAME, "Anael");
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Anael der Haendler");
  SetProp(P_LONG,
    "Du siehst einen grossen, schlanken Elf vor Dir. Er blickt Dich ein wenig hochnaesig an.");
  SetProp(P_GENDER, MALE);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_HOLY}));
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 80000);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Anael will Deine Sachen nicht tragen.\n" }) );
 SetProp(P_ARTICLE, 1);

	
SetProp(P_DEFENDERS, (({"elfenwaechter"})));
	
	create_default_npc(20);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 800);




  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([ DT_HOLY:      0.5, DT_UNHOLY:    0.5, ]) );

  SetProp(P_MSGIN, "schleicht heran");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Elfenbrueder, raecht meinen Tod!");
  SetProp(P_KILL_MSG, "Setze nie mehr einen Fuss in meinen Laden!");

  AddInfo(DEFAULT_INFO, "sagt: Fragt doch lieber einen der Aeltesten.\n");

  AddInfo( ({"Anael","verkaeuferin"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

 

SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,20);

	AddSpell(2,200,
	        "Anael wirft Dir eine Magiekugel entgegen.\n",
	        "Anael wirft @WEN eine Magiekugel entgegen.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );


	AddSpell(2,200, "Anael haut Dir eine Ruestung um die Ohren.\n",
	        "Anael haut @WEM eine Ruestung um die Ohren.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,150, "Anael braet Dir eins mit einer Schaufel ueber.\n",
	        "Anael braet @WEM eins mit einer Schaufel ueber.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
	
	AddDefaultSpell(1,200, "Anael wuergt Dich mit einem Seil.\nDu ringst nach Luft.\n",
	        "Anael wuergt @WEN mit einem Seil.\n@WER ringt verzweifelt nach Luft.\n",
	         ({DS_SLOW}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Anael rammt Dir eine Fackel in den Bauch.\n",
	        "Anael rammt @WEM eine Fackel in den Bauch.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Anael peitscht Dich mit einem Seil.\n",
	        "Anael peitscht @WEN mit einem Seil.\n",
	         ({DT_WHIP}), ([SP_SHOW_DAMAGE:1]) );
	AddDefaultSpell(1,100, "Anael blendet Dich mit einer Fackel.\n",
	        "Anael blendet @WEN mit einer Fackel.\n",
	         ({DS_BLIND}), ([SP_SHOW_DAMAGE:1]) );
			 


/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/

  SUID;
  CLONEME(ELFEN_WEAPON "elfendolch" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME( "/obj/fackel.lpc" );
  CLONEME( "/obj/seil.lpc" );
  CLONEME( "/obj/schaufel.lpc" );
  command("trage alles");

}
void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}








