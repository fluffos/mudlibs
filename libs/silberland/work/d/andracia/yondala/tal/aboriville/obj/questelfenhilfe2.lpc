#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <player/base.h>


int queststatus;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "\nquestelfenhilfe");
  SetProp(P_GENDER, MALE);
  AddId("\nquestelfenhilfe");

  SetProp(P_MATERIAL, MAT_AIR );
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
  AddCmd( ({ "rufe", "ruf" }), "rufen" ); 
  AddCmd( ({ "spendiere", "spendier" }), "spendieren" ); 

queststatus=1;
}
//erhoehe queststatus um 1
int erhoehen()
{
	queststatus+=1;
	}

//gibt den Status des Spielers aus	
int auftrag()
{
	return queststatus;
	}	
	
int rufen(string str)
{
	if(queststatus==7&&str=="peter du wirst erwartet")
		{
			queststatus+=1;
			call_out("tollerrufer", 1);        
      }     
return 0;
}

tollerrufer()
	   {
	   	 if (present("\nkrankeselfi",environment(TP)))
	    	
	    		write("Die kranke Elfe sagt: Ah, vielen Dank, "+TPN+"!\n"+
	    		"Die kranke Elfe sagt: Peter ist bestimmt schon auf dem Weg, seid so gut und \n"+
          "Die kranke Elfe sagt: sucht Ihn, er verlaeuft sich in letzter Zeit so oft.\n"+
          "Die kranke Elfe sagt: Dann fuehrt ihn bitte zu mir.\n");
           
       else
	    		write("Die kranke Elfe teilt Dir mit: Ah, vielen Dank, "+TPN+"!\n"+
	    		"Die kranke Elfe teilt Dir mit: Peter ist bestimmt schon auf dem Weg, seid so\n"+
          "Die kranke Elfe teilt Dir mit: gut und sucht Ihn, er verlaeuft sich in letzter\n"+
          "Die kranke Elfe teilt Dir mit: Zeit so oft. Dann fuehrt ihn bitte zu mir.\n");

					call_other("/d/tal/yondala/wald/room/buchenwald_8i", "peterle",0);
}

int spendieren(string str)
{
	if(file_name(environment(TP))!="/d/andracia/yondala/aboriville/room/aboriville_6c")
		return 0;
		
	write(str);
	if(str=="peter bier"||str=="peter tannenbier")
		if(queststatus==9&&present("\ndaspeterli",environment(TP)))//richtige Syntax, richtige Stufe, Peter da
    {
			call_out("spendieren2",1);
			}	

}

void spendieren2()
{
		object peter;
   	tell_room(environment(TO), "Peter sagt: Habt Dank, nun werde ich zu meiner\n");
    tell_room(environment(TO), "Peter sagt: kranken Freundin zurueckkehren\n");
		tell_room(environment(TO), "Peter winkt.\n");
  	peter=present("\ndaspeterli",environment(TP));
		peter->remove();
		call_out("questfertig",1);
		}

questfertig()
{
		write("Die kranke Elfe teilt Dir mit: Vielen Dank, fuer Eure Hilfe, "+TPN+"!\n"+
 		"Die kranke Elfe teilt Dir mit: Als Dank fuer Euren Grossmut schenke ich Euch \n"+
    "Die kranke Elfe teilt Dir mit: die Gabe anderen Eure Gefuehle mitzuteilen.\n");
	
	 TP->GiveQuest("Hilf der kranken Elfe"); //Quest als bestanden deklarieren
	 // TP->SetProp(P_CAN_FLAGS, 15);
	 TP->SetProp(P_CAN_FLAGS, TP->QueryProp(P_CAN_FLAGS | CAN_REMOTE) );
	 TO->remove();

}

