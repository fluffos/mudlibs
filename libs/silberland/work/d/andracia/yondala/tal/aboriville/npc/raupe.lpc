
inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Eine Raupe");
  SetProp(P_LONG,
    "Du siehst eine kleine, dicke Raupe die hier langsam herumkriecht.");
  SetProp(P_NAME, "Raupe"); //hier soll wirklich der Name hin, der da steht wenn der Kaefer was tut, zum Beispiel den Raum betritt o.ae.
  SetProp(P_GENDER, FEMALE);
//  SetProp(P_ARTICLE, 0); //Ist Standartmaessig 1 und sollte es auch sein, sonst steht da nur "Kaefer betritt den Raum" etc

SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_2b");
SetProp (P_MNPC_AREA, ({"/d/",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({10, 20, 10}));
 		SetProp(P_MSGIN, "kriecht herein herein"); 
  	SetProp(P_MSGOUT, "kriecht");
 

  AddId(({"raupe", "insekt"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinem hungrigen Mund",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");  
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 8);
  SetProp(P_ALIGN, 0);
	CLONEME(ELFEN_OBJ "raupenseide" );
 
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Eine Raupe"); // ELFEN_NPC-Name für den killer
  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  //wenn gefragt wird

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Raupe laesst @WEN fallen.\n" }) );

}