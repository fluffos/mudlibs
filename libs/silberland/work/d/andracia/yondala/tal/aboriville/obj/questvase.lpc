//diese Vase soll waehrend der Elfenhelfenquest geschaetzt werden
//sie hat keinen Wert, damit sie nicht einfach verkauft wird.
#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine alte Vase");
  SetProp(P_LONG,
    "Du siehst eine alte Vase, sie hat ein kitschiges Bluemchenmuster aufgemalt und besitzt "
    "schon einige Risse. Ob sie wohl noch was wert ist?");
  SetProp(P_NAME, "Vase");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "alt");

  AddId(({"vase"}));
  SetProp(P_MATERIAL, MAT_CERAMIC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);

}
