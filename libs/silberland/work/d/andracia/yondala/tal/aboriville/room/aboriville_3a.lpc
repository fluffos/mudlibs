string macht()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut", TP) )
	  {
	  	return "Du bist Dir nicht sicher, wie das gehen soll. Vielleicht solltest Du Dich mal erkundigen.\n";
	  }
		TP->do_damage(5,"frevelhaftes Verhalten");
	  return 	"Dieses Wissen geht nur die Elfen etwas an!\n";	
 }
 
 
int laden(string str )
{
  notify_fail( "Was moechtest Du laden?\n" );
  if( str == "stein" )
	{
		if(magiestatus==1000)//wenn der Stein voll ist.
			{
				write("Der Stein nimmt keine Energie mehr an, er scheint voll zu sein.\n");
				return 1;
			}

		if(TP->QueryProp(P_SP) >= 10 )//wenn der Spieler mindestens 10 MP hat
			{
				write("Du umfasst den Stein kurz mit beiden Haenden und gibst ihm einen Teil Deiner Energie.\n");
    		say( TPN+" umfasst den Stein mit beiden Haenden und konzentriert sich.\n");
				TP->AddSp(-10);
				magiestatus+=5;
    	}
   	else if(TP->QueryProp(P_HP) >= 10 )//wenn der Spieler mindestens 10 LP hat

    		{
				write("Du umfasst den Stein kurz mit beiden Haenden und gibst ihm einen Teil Deiner Lebenskraft.\n");
    		say( TPN+" umfasst den Stein mit beiden Haenden und konzentriert sich.\n");
				TP->AddHp(-10);
				magiestatus+=5;
 				}
			
			
			else 
				{
					write("Das wuerde jetzt fuer Dich toedlich enden. Sammle erstmal wieder Kraft!\n");
					return 1;
				}
				if (magiestatus>1000) magiestatus=1000;
				stein();
	  return 1;
	}
	return 0;
}
		
int abfrage()//gibt den magiestatus raus wenn man xcall macht

{
	return magiestatus;
	}
		
int beruehren(string str )//gibt Magie ab
{
  notify_fail( "Was moechtest Du beruehren?\n" );
  if( str == "stein" )
	{
		if (magiestatus==0) //Wenn der Stein leer ist passiert nichts
			{write("Der Stein fuehlt sich kalt an.\n");
			return 1;}
		
		if (TP->id("Elfenspieler")) //Wenn der Spieler Elf ist
			{
				if (magiestatus>=50)
					{
						TP->AddSp(50);
						magiestatus-=50;
					}
				else				
					{					
						TP->AddSp(magiestatus);
						magiestatus=0;
					}
				
				write("Du umfasst den Stein kurz mit beiden Haenden und spuerst wie neue Kraft Dich durchflutet.\n");
    		say( TPN+" umfasst den Stein mit beiden Haenden und scheint ploetzlich mit neuer Energie erfuellt zu sein.\n");

				}		
		else //wenn Spieler kein Elf kriegt er aua, Stein wird aber auch etwas entladen.
			{
				write("Der Stein blitzt kurz hell auf.\n");
    		say( TPN+" umfasst den Stein mit beiden Haenden und verzieht ploetzlich das Gesicht.\n");
				TP->do_damage(50,"frevelhaftes Verhalten");
				magiestatus-=5;
			}
		stein();
		return 1;
			}
		return 0;			
}	

int alleheile(object ob) 
{
   ob->SetProp(P_POISON, 0);
   ob->AddHP(200);
   return 1;
}	
				
void notfall( )
{
  mixed *people;
  if (TP->id("Elfenspieler"))
	{
	  if (magiestatus!=1000)
		{
		  write("Der Stein hat nicht genug Energie.\n");
		  return;
		}
	  else
		{
		  write("Du beruehrst den Stein in hoechster Not, er leuchtet fuer einen Moment kurz auf und Du spuerst wie er seine Energie in den Raum schickt.\n");
		  say(TPN+ " beruehrt den Stein in hoechster Not, er leuchtet fuer einen Moment kurz auf und Du spuerst wie er seine Energie in den Raum schickt.\n");
		  magiestatus=0;
		  people=filter_array( all_inventory(), #'interactive );
		  map_array(people, #'alleheile);
		  return;
        }//alle werden maximal geheilt und vergiftung weg, stein leer
	 }
  else
	{
      write("Kaum beruehren Deine Finger den Stein durchzuckt Dich ein fuerchterlicher Schmerz.\n");
      say( TPN+" beruehrt den Stein und bekommt einen Schlag.\n");
	  TP->do_damage(50,"frevelhaftes Verhalten"); //oder nen Faketod?
	  return;
	}		
call_out("stein", 0);	

	
}	

	
void machwas() //Der Raum macht spontan Dinge
{
	int was;
	int wer; //mal versuchen ob es klappt, dass nicht immer der 0te Spieler ausgewaehlt wird.
	object *spieler; //Sternchen bedeutet Array
  //object *nichtelfen;
	was = random(5);
if(magiestatus>0)	
	{
		spieler=filter_array( all_inventory(), #'interactive );//wenn interactive 1-> Spieler

		if (sizeof(spieler))
		{
  		  wer=random(sizeof(spieler));
 		  tell_room(this_object(),"Der Stein leuchtet kurz magisch auf.\n");
		  tell_object(spieler[wer],"Du spuerst wie die Magie des Steines Dich durchfliesst.\n");
		  magiestatus-=10;
		  tell_room(TO,"Der Stein leuchtet kurz auf.\n");
		  if (was==0)//der Stein heilt einen Spieler
			{
			  spieler[wer]->AddHP(50);
			  tell_object(spieler[wer],"Du spuerst, wie neues Leben in Deine Adern fliesst.\n");
			}
					
		  if (was==1)//der Stein gibt einem Spieler SP
			{
			  spieler[wer]->AddSP(50);
              tell_object(spieler[wer],"Du spuerst, wie Dein Geist ploetzlich wacher wird.\n");
			}
		  if (was==2&&spieler[wer]->QeryProp(P_POISON))// entgiften
			{
			  spieler[wer]->SetProp(P_POISON,0);
			  tell_object(spieler[wer],"Du spuerst, wie das Gift Deinen Koerper verlaesst.\n");
			 }

	      if (was==3)//macht Hunger
		    {
			  spieler[wer]->SetProp(P_FOOD,0);
			  tell_object(spieler[wer],"Du hast ploetzlich grossen Hunger.\n");
			  }

	      if (was==4)//macht Durst
		    {
		   	  spieler[wer]->SetProp(P_DRINK,0);
			  tell_object(spieler[wer],"Du hast ploetzlich grossen Durst.\n");
		     }
	}
}

//wann ruft sich die Funktion selbst wieder auf?
	call_out("machwas",random(300)+600); 
	//call_out("machwas",wann); 
	}