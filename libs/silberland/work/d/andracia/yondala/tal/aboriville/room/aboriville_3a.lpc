int stein()//hier wir die neue Beschreibung des Details "Stein" gesetzt
{
	if(magiestatus==0)
		{
			AddDetail( ({ "stein" }),
    		"Der Stein ist milchig matt. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
	 		RemoveSound(({ "stein", "summen" }));
    	}
	else if(magiestatus<=250&&magiestatus>0)
		{
			AddDetail( ({ "stein" }),
    		"Der Stein leuchtet ein wenig. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
 			RemoveSound(({ "stein", "summen" }));
    	}
	else if(magiestatus<750&&magiestatus>250)
		{
			AddDetail( ({ "stein" }),
    		"Der Stein funkelt hell, ausserdem scheint er leise zu summen. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
 			RemoveSound(({ "stein", "summen" }));
    	}

	else if(magiestatus>750&&magiestatus<1000)
		
		{
			AddDetail( ({ "stein" }),
    		"Der Stein leuchtet und funkelt sehr hell, ausserdem summt er. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
 			AddSound( ({ "stein", "summen" }),
    		"Der Stein summt.");
    	}
	else if(magiestatus>=1000)
		{
			AddDetail( ({ "stein" }),
  		 	"Der Stein funkelt in allen Farben, ausserdem summt er laut und vibriert. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
 			AddSound( ({ "stein", "summen" }),
    		"Der Stein summt laut.");
    	}
	}
	





int fuehlen(string str )//einmal pro Reset kann einer sich hier Magie holen
{
  notify_fail( "Was moechtest Du fuehlen?\n" );
  if( str == "magie" )
	{
		if(magieda!=0)//wenn magie da ist
			{
				write("Du spuerst wie die Magie des Raumes Dich bis in Deine Haarspitzen erfuellt.\n");
    		say( TPN+" sieht ploetzlich wie elektrisiert aus.\n");
				if(TP->id("Elfenspieler") )//wenn der Spieler Elf ist
					TP->SetProp(P_SP, TP->QueryProp(P_MAX_SP));//setzt die Magiepunkte auf Max
				else
					TP->AddSP(10);

				}
		else write("Du spuerst wie die Magie des Raumes Dich bis in Deine Haarspitzen erfuellt.\n");

	 magieda=0;	
   return 1;
  }
  return 0;
}

