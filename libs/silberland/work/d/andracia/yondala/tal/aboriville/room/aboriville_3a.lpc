//Gildenraum der Elfen
//Idee: Elfen koennen den Raum hier aufladen 
//Idee: Elfen ideln ihre Magie hier schneller hoch, wenn aufgeladen. Eventuell werden Sie auch geheilt oder so.

//fuehle Magie: einmal pro reset kann man sich hier aufladen
//nach /gilden/ umgezogen wegen SetProp-Rechten

#include "../def.h"
inherit "std/gilde";
#include <properties.h>
#include <language.h>

int magieda=1;
int magiestatus=0;
int wann;
void reset()
{::reset();
		magieda=1;
}	
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Heiligtum der Elfen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier im Allerheiligsten der Elfen. Der ganze Raum scheint voller Magie "
    "zu sein die um Dich herum schwirrt und fast greifbar ist. Bis auf einen grossen Stein ist "
    "der Raum vollkommen leer." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "elfen" }),
    "Die Elfen betrachten diesen Raum als hier hoechstes Gut.");    
  AddDetail( ({ "raum", "allerheiligsten", "allerheiligstes" }),
    "Du befindest Dich hier im Allerheiligsten der Elfen. Der ganze Raum scheint voller Magie "
    "zu sein die um Dich herum schwirrt und fast greifbar ist. Bis auf einen grossen Stein, "
    "welcher auf einem weichen Sockel in der Mitte des Raumes gebettet wurde ist der Raum "
    "vollkommen leer.");    
  AddDetail( ({ "magie" }),
    "Du kannst die Magie hier foermlich fuehlen.");    
  AddDetail( ({ "sockel" }),
    "Der Sockel auf welchem der Stein ruht ist aus weichestem Moos gewachsen.");    
  AddDetail( ({ "moos" }),
    "Das Moos aus welchem der Sockel besteht ist sehr weich und waechst nur an einer "
    "Stelle im Raum.");    
  AddDetail( ({ "stelle" }),
    "Genau dort, wo der Stein steht.");    
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein Stein auf einem weichen Sockel.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende des Raumes sind mit herrlichen Mustern und vielen wunderbar detailreichen Motiven verziert.");    
  AddDetail( ({ "muster" }),
    "Du erkennst viele geometrische Figuren und staunst ueber die exakte Symmetrie der Darstellungen.");    
  AddDetail( ({ "figuren" }),
    "Du siehst perfekte Kreise, dreiecke, Schleifen, aber auch Wellen und komplizierte "
    "Rankenmuster welche die grossartigen Motive umrahmen.");    
  AddDetail( ({ "wellen","kreise","dreiecke","schleifen","wellen","rankenmuster", "pracht" }),
    "Du bist fasziniert von dieser hohen Kunst der Elfen, solche Pracht in Holz zu verewigen.");    
  AddDetail( ({ "kunst","kuenstler", "schoenheit" }),
    "Wenn es um Schoenheit geht sind die Elfen wahre Kuenstler.");    
  AddDetail( ({ "symmetrie" }),
    "Alle Figuren stehen im herrlichen Einklang zueinander.");    
  AddDetail( ({ "einklang" }),
    "Irgendwie macht Dich das gluecklich.");    
  AddDetail( ({ "motive", "bilder" }),
    "Du siehst einige Darstellungen von Yondala wie sie beim Erschaffen Aborivilles beisteht, "
    "aber auch Bilder, auf denen sie ausgelassen mit den Elfen singt und tanzt. Fast meinst Du "
    "den froehlichen Gesang der Elfen vernehmen zu koennen. Andere Bilder erzaehlen von den "
    "grossen Schlachten in denen die Elfen glorreich gekaempft haben. Ein Bild jedoch zeigt "
    "die Elfen eine seltame Geste machend um einen Stein versammelt.");    
  AddDetail( ({ "darstellungen", "ruhe", "frieden" }),
    "Es gibt viele Motive auf denen glueckliche in Ruhe und Frieden lebende Elfen abgebildet sind.");    
  AddDetail( ({ "erschaffen" }),
    "Es gibt einige Motive die von der Erschaffung Aborivilles berichten. Auf den Bildern "
    "siehst Du, wie die Elfen zu den Baeumen singen auf dass diese ihnen Obdach gewaehren.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "obdach", "schutz","sicherheit","ruhe","frieden" }),
    "Die Baeume aus und in denen Aboriville besteht bieten den Elfen Schutz und Sicherheit.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "schlachten" }),
    "Du siehst auf den Bildern welche tapferen und heldenhaften Krieger Elfen sein koennen.");    
  AddDetail( ({ "krieger" }),
    "Du bist beeindruckt.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier wie auch sonst ueberall in der Stadt aus Holz. In der Mitte "
    "befindet sich ein kleiner mooserner Sockel.");    
  AddDetail( ({ "decke" }),
    "Die Decke woelbt sich kuppelartig ueber Dir. Sie besteht aus Holz.");    
  AddDetail( ({ "farben" }),
    "Der Stein schimmert in allen Farben, die Du je gesehen hast.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genauso, wie die Elfen es brauchen. In diesem Raum allerdings "
    "ist es besonders solide und traegt wunderschoene Bilder auf sich.");    
  AddDetail( ({ "yondala" }),
    "Du bist ueberzeugt, dass die Elfen Yondala verehren.");    
	AddDetail( ({ "stein" }),
 		"Der Stein ist milchig matt. Du ueberlegst, ob man ihn gefahrlos beruehren kann.");    
  AddDetail( ({ "bild" }),
    "Es sieht aus, als waeren die Elfen um einen Stein versammelt, der genauso aussieht "
    "wie der Stein in diesem Raum.");    
  AddDetail( ({ "geste" }),
    "Es sieht so aus, als wuerden die Elfen auf dem Bild den Stein magisch aufladen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Es rauscht leicht.");

  AddSound( ({ "gesang" }),
    "Du bist Dir nicht sicher.");
  AddSound( ({ "magie" }),
    "Die Magie flirrt schon hoerbar in diesem Raum.");
  AddSound( ({ "rauschen" }),
    "Woher das wohl kommt?");
  AddSound( DEFAULT_SMELL,
    "Es riecht nach Natur.");
 
  AddSmell( ({ "natur" }),
    "Frisch und lebendig.");


  AddSpecialDetail( ({ "macht","kraft" }), "macht" );

	AddExit( "osten", ELFEN_ROOM  + "aboriville_3b.lpc" ); 
	AddCmd(({"fuehle", "fuehl"}), "fuehlen"); 
	AddCmd(({"lade", "belade"}), "laden"); 
    //AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );

	
	//	AddCmd(({"entnehme"}), "entnehmen"); 
	AddCmd(({"beruehre", "beruehre"}), "beruehren"); 
	AddCmd(({"notfall", "not"}), "notfall"); 
	call_out("machwas",random(300)+600); 

}
