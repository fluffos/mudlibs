#include "../def.h"
inherit "std/thing";
#include <properties.h>
object wer;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
wer=TP;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
//  SetProp(P_NAME, "");
//  SetProp(P_GENDER, NEUTER);

//  AddId(({""}));
  SetProp(P_MATERIAL, MAT_MISC_MAGIC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP,1);
  call_out("regen"); 
  call_out("weg",600);//spaetestens nach zehn Minuten verschwindet es
}
void weg()
{
	remove();
}
