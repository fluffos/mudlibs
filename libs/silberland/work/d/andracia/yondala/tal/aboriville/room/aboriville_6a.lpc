#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer Blaetterhoehle" );
  SetProp( P_INT_LONG,
    "." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");



AddExit( "osten", ELFEN_ROOM  + "aboriville_6b.lpc" ); 

}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
      result = BS("Du befindest Dich in einer Filiale der grossen Lunia-Bank "
      "in Aboriville. Dieser Talan ist so gut wie gar nicht eingerichtet, "
      "zwischen den vielen Blaetten entdeckst Du einen freien Schalter. Du "
      "bist Dir sicher, dass Du hier alle Deine Bankgeschaefte erledigen kannst. ");
    }
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}

string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;

  if( viewer->id("Elfenspieler") ||
      viewer->QueryProp(P_GUILD) == "Naturvolk" ||
      present("\nelfenkraut", viewer) )
    {
      result = BS("In der Bank von Aboriville") ;
    } else {
      result = QueryProp(P_INT_SHORT);
    }
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}