#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Mitte des Marktplatzes" );
  SetProp( P_INT_LONG,
    "Du stehst mitten zwischen den Baeumen. Du siehst eigentlich hauptsaechlich nur "+
	  	"Gruen um Dich herum, aber irgendwie bist Du sicher, dass da mehr sein koennte, als Du "+
	  	"auf dem ersten Blick wahrnimmst.\n"  );
AddItem(ELFEN_NPC + "elf_std.lpc",REFRESH_DESTRUCT);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "mitte","zentrum" }),
    "Du stehst auf der Mitte des Marktplazes der Elfenstadt. Von hier aus "
    "kannst Du in viele Richtungen Geschaefte und dergleichen erreichen.");    
  AddDetail( ({ "richtungen", "richtung" }),
    "Du kannst von hier aus in acht verschiedenen Richtungen Aboriville erkunden.");    
  AddDetail( ({ "marktplatz" }),
    "Du stehst hier auf einer Art Marktplatz, auch wenn Du vor lauter "
    "Blaettern nicht viel erkennen kannst, so bist Du Dir sicher, dass es in "
    "einigen der Baumstaemme um Dich herum Laeden gibt.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    



AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitte" }), "bitten" );

AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_7a.lpc" ); 
//AddExit( "westen", ELFEN_ROOM  + "aboriville_6a.lpc" ); //Bank existiert ja noch nicht
AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_5a.lpc" ); 
AddExit( "norden", ELFEN_ROOM  + "aboriville_5b.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_5c.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_6c.lpc" ); 
AddExit( "suedosten", ELFEN_ROOM  + "aboriville_7c.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_7b.lpc" ); 
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
	  	result  ="Du stehst hier im gruenen Zentrum des Marktes der Elfenstadt. "
    "Du kannst hier alles relativ gut ueberblicken, nur wenige Aeste "
    "versperren Dir die Sicht. Um Dich herum sind allerlei Geschaefte und "
    "Gaststaetten welche Du betreten kannst. Auch wenn Du nur selten eine "
    "Elfe zu sehen bekommst, so bist Du Dir sicher, dass hier einige sind "
    "und Dich beobachten.\n";
	  }
	  else {
    	result = QueryProp(P_INT_LONG);
    }
    
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
    		  	
//	result=result+ QueryProp(P_INT_LONG)+ "Es gibt acht sichtbare Ausgaenge: suedwesten, westen, "
//	"nordwesten, norden, nordosten, osten, suedosten und sueden.\n";
}

