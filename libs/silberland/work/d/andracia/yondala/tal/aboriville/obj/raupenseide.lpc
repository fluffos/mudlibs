#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Raupenseide");
  SetProp(P_LONG,
    "Du haelst ein paar schimmernde Faeden Raupenseide in Deinen Haenden.");
  SetProp(P_NAME, "Raupenseide");
  SetProp(P_GENDER, FEMALE);
  AddId(({"seide","raupenseide"}));

  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 120);

}

