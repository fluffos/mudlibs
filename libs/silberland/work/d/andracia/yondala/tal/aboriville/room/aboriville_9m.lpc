int kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
  if( str == "runter"||str == "herunter"||str == "hinunter"||str == "nach unten"||str == "ueber gelaender"||str == "an gelaender runter" )
  {			  
  	TP->move(BIRKE_ROOM + "buchenwald_9m", M_GO,
  	"","klettert nach unten","klettert einen Baum hinunter");
		write("Du kletterst ueber das Gelaender und am Baum hinab.\n");
    say( TPN+" klettert nach unten.\n");
    return 1;

  }
  return 0;
}