#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Pfad in der Elfenstadt" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einem Pfad in Aboriville, um Dich herum ist alles gruen. "
    "Nach Suedosten gelangst Du wieder zurueck zum Mittelpunkt der Stadt. "
    "Weit im Norden siehst Du eine Blaetterhoehle." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  
  AddDetail( ({ "blaetterhoehle","hoehle" }),
    "Sie ist weiter im Norden, Du muesstest hingehen um mehr zu sehen.");    
  AddDetail( ({ "norden","suedosten" }),
    "Du kannst dem Pfad sowohl nach Norden als auch nach Suedosten folgen.");    
  AddDetail( ({ "pfad" }),
    "Du stehst hier auf einem hoelzernen Pfad der sich durch die ganze Elfenstadt schlaengelt.");    
  AddDetail( ({ "mittelpunkt" }),
    "Der Mittelpunkt Aborivilles liegt suedoestlich von hier. Von dort aus kannst Du alle Teile der Stadt erkunden.");    
  AddDetail( ({ "teil","teile" }),
    "Gehe nach Suedosten und sieh selbst!");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");

AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

AddExit( "norden", ELFEN_ROOM  + "aboriville_2c.lpc" ); 
AddExit( "suedosten", ELFEN_ROOM  + "aboriville_4d.lpc" ); 
}

