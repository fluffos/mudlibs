#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein angeknabbertes Schinkenstueckchen");
  SetProp(P_LONG,
    "Du siehst ein kleines Stueckchen Schinken, das wohl jemand angeknabbert hat.");
  SetProp(P_NAME, "Schinkenstueckchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueckchen","schinken","schinkenstueckchen"}));

  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  AddCmd(({"iss", "ess","esse"}),"essen"); //Funktion


}

int essen(string str)
{
	notify_fail("Was moechtest Du denn essen?\n");
	if(!id(str)) return 0;
	if (this_player()->eat_food(2))
     {
     	if(TP->id("Elfenspieler"))
     		{
     			write("Du isst das kleine Schinkenstueckchen.\n"+
     						"Uah, Dir wird schlecht, Du musst Dich uebergeben.\n");
     			say(TPN+ " isst ein kleines Schinkenstueckchen.\n"+
     			    TPN+" uebergibt sich.\n");
     			this_player()->eat_food(-5,0);
					TP->AddHp(-5);
					remove();
					return 1;
				 }     						
       write("Du isst das kleine Schinkenstueckchen.\n");
 			 say(TPN+ " isst ein kleines Schinkenstueckchen.\n");
  		 TP->AddHp(5);
       remove();
       return 1;
     }
     return 1;
    }

