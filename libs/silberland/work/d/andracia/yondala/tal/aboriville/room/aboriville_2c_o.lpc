void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Thronsaal der Kaempfer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier in einem grossen Raum welcher edler und feiner kaum sein koennte. "
    "Obgleich hier alles gewachsen ist, so zeugt dieser Ort - vielleicht auch gerade deswegen - "
    "von der Macht und dem Wohlstand der Elfen. Die Einrichtung ist zweckmaessigedel, Du siehst "
    "zwei Throne, ein paar Stuehle und einen grossen Tisch voller Unterlagen. An der Wand "
    "haengt eine grosse Tafel." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  
  AddItem(ELFEN_NPC + "elf_tasinion.lpc",REFRESH_DESTRUCT);
  AddItem(ELFEN_NPC + "elfe_ayala.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "boden" }),
    "Der Boden besteht in der ganzen Stadt aus Holz. Er sieht so aus, als wuerde er oft begangen werden.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");    
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen hier aus hellem, auf seltsame Art strahlendem Holz.");     
  AddDetail( ({ "decke" }),
    "Die Decke besteht wie alles hier aus edelstem Holz.");     
  AddDetail( ({ "rest", "hoehlen","raeume" }),
    "Schau Dich doch ein wenig um in Aboriville!");     
  AddDetail( ({ "baeume" }),
    "Die Stadt der Elfen ist auf hohen Baeumen erbaut.");     
  AddDetail( ({ "art" }),
    "Strahlendes Holz ist schon was seltsames, aber Du kannst es nicht anders als so beschreiben.");     
  AddDetail( ({ "tafel" }),
    "Auf der Tafel schein ein Stammbaum zu sein.");     
  AddDetail( ({ "stammbaum" }),
    "Du kannst ihn lesen.");     
  AddDetail( ({ "einrichtung" }),
    "Die Einrichtung besteht aus zwei dominanten Thronen, einigen Stuehlen und einem Tisch.");     
  AddDetail( ({ "macht", "natur", "einklang" }),
    "Die Elfen leben im Einklang mit der Natur, welche ihnen zu grosser Macht verhilft.");     
  AddDetail( ({ "ort", "raum", "saal", "thronsaal" }),
    "Du befindest Dich hier in eine grossen Raum welcher edler und feiner kaum sein koennte. "
    "Obgleich hier alles gewachsen ist, so zeugt dieser Ort - vielleicht auch gerade deswegen - "
    "von der Macht und dem Wohlstand der Elfen. Die Einrichtung ist zweckmaessigedel, Du siehst "
    "zwei Throne, ein paar Stuehle und einen grossen Tisch. An der Wand "
    "haengt eine grosse Tafel." );
  AddDetail( ({ "throne" }),
    "Du siehst zwei grosse, edle Throne, die mit allerhand Ornamenten verziert sind.");    
  AddDetail( ({ "ornamente" }),
    "Die Ornamente sind sehr schoen gearbeitet bzw. gewachsen, sie stellen allerhand "
    "Lebewesen und Szenarien dar.");    
  AddDetail( ({ "lebewesen" }),
    "Du erkennst einige Lebewesen Aborivills, aber auch welchen aus ganz Andracia.");    
  AddDetail( ({ "szenarien","szenen" }),
    "Du erkennst Szenen aus dem taeglichen Leben, aber auch eindeutige Kampfszenen.");    
  AddDetail( ({ "kampfszenen" }),
    "In jeder einzelnen erscheinen die Elfen ruhmreich und siegessicher.");    
  AddDetail( ({ "leben" }),
    "Du siehst Szenen aus dem taeglichen Leben der Elfen.");    
  AddDetail( ({ "stuehle" }),
    "Du siehst ein paar hoelzerne Stuehle, die allesamt herlich verziert sind.");    
  AddDetail( ({ "tisch" }),
    "Der hoelzerne Tisch steht mitten im Raum. Er ist ziemlich gross und vollgepackt mit "
    "diversen Unterlagen und Dokumenten.");    
  AddDetail( ({ "wohlstand" }),
    "Dadurch, dass die Elfen ausser der Natur nichts zum Leben brauchen, sind sie sehr wohlhabend.");    
  AddDetail( ({ "seite" }),
    "Nun, nicht mittig, sondern eher seitlich.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
      
  AddReadDetail( ({ "stammbaum","tafel"}), #'stammbaum );

        
  AddSound( DEFAULT_SMELL,
    "Es riecht nach dem Harz des Baumes in dem Du Dich befindest.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst leistes Stimmengemurmel.");

  AddSound( ({ "stimmengemurmel","gemurmel","stimmen" }),
    "Jemand scheint sich angeregt zu unterhalten.");
  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "baum","harz" }),
    "Das Harz des Baumes riecht leicht suesslich.");

AddExit( "suedwesten", ELFEN_ROOM  + "aboriville_3b_o.lpc" ); 

AddCmd( ({ "sitze", "sitz","setze" }), "setzen" );

}


int setzen(string str)
{
	if(str=="auf stuhl")
		{
			write("Du setzt Dich auf einen der Stuehle. Da das aber irgendwie ziemlich langweilig ist stehst Du wieder auf.\n");
			say(TPN+" setzt sich kurz auf einen der Stuehle und steht dann wieder auf.\n");
			return 1;
		}
		else
			{
				write("Worauf moechtest Du Dich setzen?\n");
				return 1;
			}
			
	}





