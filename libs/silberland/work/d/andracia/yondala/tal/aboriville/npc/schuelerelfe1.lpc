SetProp(P_NAME, name);
						SetProp(P_SHORT, name+" der kleine Elfenjunge");
  SetProp(P_LONG,
    "Du siehst einen kleinen Elfenjungen vor Dir, welcher noch nicht zur Schule "
    "gehen muss und daher sein junges Leben in vollen Zuegen geniessen kann.");

  SetProp(P_GENDER, MALE);
  AddId(({"junge", "elfenjunge", "elf", "elfenkind", "kind", "/nelfenkind", lower_case(name)}));
  create_default_npc(3);
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 40000);
  SetProp( P_REJECT, ({ REJECT_DROP,
    name+" will Deine Sachen nicht tragen.\n" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 500);
  SetProp(P_WIMPY, 1);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_2e");
SetProp (P_MNPC_AREA, ({
	ELFEN_ROOM + "aboriville_1e", 
	ELFEN_ROOM + "aboriville_1f", 
	ELFEN_ROOM + "aboriville_1g", 
	ELFEN_ROOM + "aboriville_2f", 
	ELFEN_ROOM + "aboriville_2g", 
	ELFEN_ROOM + "aboriville_3e", 
	ELFEN_ROOM + "aboriville_3f", 
	ELFEN_ROOM + "aboriville_3g"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));






  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Kindermoerder!");
  SetProp(P_KILL_NAME, "Ein Elfenkleinkind");
  SetProp(P_KILL_MSG, "Was, Du laesst Dich von einem Kindergartenkind toeten?");

  AddInfo(DEFAULT_INFO, "sagt: Das darf ich Fremden nicht erzaehlen.\n");
  AddInfo( ({"fremde","fremder"}),
    "Ihr seid ein Fremder.",
    "sagt: ");
  AddInfo( ({"name","namen"}),
    "Mein Name ist "+name+".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

SetProp(P_SPELLRATE, 10);
  SetProp(P_NOMAGIC,1);

	AddSpell(1,200,
	         name+ " schreit wie am Spiess.\n",
	         name+ " schreit wie am Spiess.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );
	         		         	
	         	
	         	
  SUID;
  CLONEME(ELFEN_WEAPON "kleinerelfendolch.lpc" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "kleineelfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
}

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


void InformDefend(object enemy)
{
 Kill(enemy);
}