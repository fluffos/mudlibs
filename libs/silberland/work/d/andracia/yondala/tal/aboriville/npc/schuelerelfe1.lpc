    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Schwestern.",
    "sagt: ");
	break;}
	case 2:{name="Meldo";
		  AddInfo( ({"meldo",""}),
    "Das bin ich.",
    "sagt: ");

	  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Miranola und Faemil.",
  		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Selo.",
