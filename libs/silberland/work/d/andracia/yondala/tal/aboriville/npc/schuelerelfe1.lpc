inherit ELFEN_NPC+"kigaelfe_std.lpc";

void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}

int wer;
string name;
void create() {
  SetProp(P_LOG_INFO, "yondalas_antworten");

  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Ranari";
  AddInfo( ({"ranari"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Fenwen und Alanel.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Famione.",
    "sagt: ");
  AddInfo( ({"mondol","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","alanel"}),
    "Meines Vaters Name ist Alanel.",
    "sagt: ");
  AddInfo( ({"mutter","fenwen"}),
    "Meiner Mutter Name lautet Fenwen.",
    "sagt: ");
  AddInfo( ({"thorasa","hiara", "schwester","schwestern"}),
    "Meine Schwestern heissen Thorasa und Hiara.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Schwestern.",
    "sagt: ");

	break;}
	case 1:{name="Saladion";
  AddInfo( ({"saladion"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Nela und Lorion.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Zylia und Selo.",
