void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Eine blasse, kranke Elfe");
  SetProp(P_LONG,
    "Du siehst eine blasse, kranke Elfe vor Dir. Sie scheint Hilfe zu brauchen.");
  SetProp(P_NAME, "Elfe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"elfe", "elfin", "\nkrankeselfi"}));
  AddId(({"/nelfennorm"}));
    SetProp(P_ARTICLE, 1);
//  set_living_name("");
 SetProp(P_NAME_ADJ, "krank");
  create_default_npc(20);
  SetProp(P_DEFENDERS, (({"elfenwaechter"})));
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 196);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 1500);
  SetProp(P_MAX_HANDS, 2);
/*  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([      DT_HOLY:      1.0, DT_UNHOLY:    -0.5, DT_MAGIC:  0.0, DT_MIND:   1.0]) );
*/
  SetProp(P_NOATTACK, "ist zu krank zum kaempfen.");
  SetProp(P_MSGIN, "liegt in dem Bett");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

/*
  SetProp(P_DIE_MSG,  " faellt aus dem Bett.\n");
  SetProp(P_KILL_NAME, "eine kranke Elfin");
  SetProp(P_KILL_MSG, "Das habt Ihr selbst zu verantworten!");
*/
  AddInfo(DEFAULT_INFO, "sagt: Da kann ich noch nichts zu sagen.\n");
  AddInfo("", ".","sagt: ");

//zweimal da wegen der Farben...
 
  AddInfo( ({ "auftrag", "aufgabe"}), #'auftrag );//'

  AddInfo( ({"hilfe","krankheit"}),//eventuell koennte Sie auch Hilfe geben wenn man mit nem Auftrag nicht klar kommt.
    "Ich bin krank und brauche ein wenig Hilfe. Wuerdet Ihr mir zur Hand gehen? "
    "Dann fragt mich doch bitte nach \"Auftrag\"!",
    "sagt: ");
  AddInfo( ({"elfenkraut","kraut"}),
    "Das Elfenkraut verhilft allen, die nicht zur Rasse der Elfen gehoeren, zu einer besseren "
    "Sicht in unserer Stadt. Viele Dinge hier sind dem nichtelfischen Auge verborgen, doch das "
    "Kraut entschleiert diesen Nebel fuer eine Weile. Allerdings ist das Kraut hier nicht gern "
    "gesehen, deswegen werdet Ihr es in Aboriville nicht finden koennen. Ich glaube allerdings "
    "Fauna verkauft welches.",
    "sagt: ");
  AddInfo( ({"zeitung","zeitungen"}),
    "Zeitungen findet Ihr in fast jedem Ort, sie liegen meist einfach da und Ihr koennt sie "
    "Euch nehmen, sie ist kostenlos. Ihr koenntet Euch ja spaeter auch noch ein Exemplar nehmen, "
    "Dort stehen oft interessante Artikel drin.",
    "sagt: ");
  AddInfo( ({"medizin"}),
    "Ich brauche dringend meine Medizin, dann geht es mir bestimmt bald wieder besser. Ihr "
    "koennt sie einfach hier in Aboriville kaufen.",
    "sagt: ");
  AddInfo( ({"aboriville","elfenstadt"}),
    "Ihr befindet Euch gerade in der Elfenstadt Aboriville.",
    "sagt: ");
  AddInfo( ({"brief",""}),
    "Um einen Brief zu schreiben muesst Ihr Euch in eine Post begeben.",
    "sagt: ");
  AddInfo( ({"post",""}),
    "Es gibt hier ganz in der Naehe eine, habt Ihr Sie schon gefunden?",
    "sagt: ");
  AddInfo( ({"wortlaut",""}),
    "Der Wortlaut fuer den Brief lautet: joholali mumimoi malalal schmudo dil ahndo me.",
    "sagt: ");
  AddInfo( ({"schaetzen","wert"}),
    "Nun, ihr koennt in jedem Laden etwas schaetzen lassen. Geht einfach hier in den Laden "+
    "und tippt \"schaetz Vase\" und man wird Euch ihren Wert sagen.",
    "sagt: ");
  AddInfo( ({"entsorgen","muellschlucker"}),
    "Die meisten Ladenbesitzer halten sich einen kleinen Saurier, der gerne alles verschingt, "+
    "was keinen Wert besitzt. Schreibt einfach \"fuetter muellschlucker mit Vase\" und er wird "+
    "Euch von dieser Last befreien.",
    "sagt: ");
  AddInfo( ({"saurier",""}),
    "Ein alter Magier hat es mal geschafft die Saurier zu schaffen.",
    "sagt: ");
  AddInfo( ({"essen",""}),
    "Riecht doch bitte an dem Essen auf dem Tisch.",
    "sagt: ");
  AddInfo( ({"riechen",""}),
    "Ihr koennt an vielen Dingen riechen. Schreibt dazu einfach \"riech *ding*\".",
    "sagt: ");
  AddInfo( ({"tannenbier","bier"}),
    "Das beste Tannenbier gibt es im hiesigen Pub.",
    "sagt: ");
  AddInfo( ({"pub",""}),
    "Im Geschaeftsvirtel Aborivilles befindet sich ein netter kleiner Pub.",
    "sagt: ");
  AddInfo( ({"geschaeftsviertel","geschaefte"}),
    "Suedlich von hier befindet sich ein kleines Geschaeftsviertel mit allerhand Geschaeften und Lokalitaeten.",
    "sagt: ");
  AddInfo( ({"spendieren",""}),
    "Ihr koennt in jeder Lokalitaet einem anderen etwas spendieren.",
    "sagt: ");
  AddInfo( ({"lokalitaet",""}),
    "Nun ueberall dort wo man essen und trinken kann.",
    "sagt: ");
  AddInfo( ({"fauna",""}),
    "Fauna betreibt einen kleinen Laden im Faunenwald.",
    "sagt: ");
  AddInfo( ({"faunenwald",""}),
    "Der liegt unterhalb Aborivilles, etwas suedwestlich.",
    "sagt: ");
  AddInfo( ({"moerder",""}),
    "Ich lese gerade ein spannendes Buch, dort gibt es auch einen Moerder.",
    "sagt: ");
  AddInfo( ({"buch",""}),
    "Das Buch, welches ich gerade lese, liegt auf meinem Nachttisch.",
    "sagt: ");
  AddInfo( ({"nachttisch",""}),
    "Der Nachttisch steht neben meinem Bett.",
    "sagt: ");
  AddInfo( ({"vase",""}),
    "Ich habe eine alte Vase.",
    "sagt: ");
  AddInfo( ({"magier",""}),
    "Die gibt es hier nicht mehr.",
    "sagt: ");
  AddInfo( ({"freund","peter"}),
    "Mein Freund Peter kommt mich hin und wieder besuchen.",
    "sagt: ");
  AddInfo( ({"besuch",""}),
    "Ja, es ist nett, dass hier hier seid. Sonst besucht mich ja nur der Peter.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Elfin ist zu schwach um etwas zu tragen.\n" }) );


//  SetChats(3, ({
//    ".\n"}) );

  SUID;
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
//  command("trage alles");
 AddCmd( ({ "gib", "gebe" }), "geben" ); 
 AddCmd( ({ "verrate", "verrat" }), "verraten" ); 
 AddCmd( ({ "berichte", "bericht" }), "berichten" ); 
 

}



