void InformDefend(object enemy)
{
  Kill(enemy);
}


void die()
{
  //elfenkiller reinclonen
   CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();   
}

give_notify(object ob)
 {
  if(present("\nquestelfenhilfe",TP))//Wenn die Quest schon begonnen wurde
    {
      questitem=present("\nquestelfenhilfe",TP);
      if (questitem->auftrag()>1&&ob->name()=="ein Elfenkraut")//wenn er schon weiter ist, aber das kraut geben will
          {
            command("sag Das hattet ihr mir doch schon gegeben, "+TPN+"!");
            write("Die kranke Elfe gibt Dir das Elfenkraut zurueck.\n");
            ob->move(TP, M_GET);
           }

      else if (questitem->auftrag()==1&&ob->name()=="ein Elfenkraut")// wenn alles richtig ist
        {
          questitem->erhoehen();
          command("sag Ah, vielen Dank, "+TPN+"!");
          command("sag Nun wuerde ich mich sehr freuen, wenn Ihr mir eine Zeitung bringen koenntet!\n");
        }
      else if (questitem->auftrag()==3&&ob->name()=="eine Medizin")
            {
              questitem->erhoehen();
              command("sag Ah, vielen Dank, "+TPN+"!");
              command("sag Nun wuerde ich mich sehr freuen, wenn Ihr mir das Ende meines Buches "+
                      "verraten wuerdet, meine Augen sind im Moment nicht mehr so gut und das "+
                      "Lesen strengt mich sehr an, aber ich moechte unbedingt wissen, wer der "+
                      "Moerder ist!");
              command("sag Bitte tippt \"verrate 'moerder' \", wenn Ihr es herausgefunden habt!");
            }

      else if (questitem->auftrag()>3&&ob->name()=="eine Medizin")//wenn er schon weiter ist.
          {
            command("sag Das hattet ihr mir doch schon gegeben, "+TPN+"!");
            command("sag Aber ich behalte es mal, falls es mir wieder schlechter gehen sollte!");
           }
          
      else
            {             
              command("sag Was soll ich damit?");
              ob->move(TP, M_GET);
            }
              
      }
      else//wenn er die Quest gar nicht macht
        {
          command("sag Was soll ich damit?");
          ob->move(TP, M_GET);
        }
  }
         
geben(string str)//fuer die Zeitung, weil man die ja nicht wirklich weggeben kann
{
  object ob;
//  object questitem;
  if(!present("\nquestelfenhilfe",TP))//Wenn die Quest schon begonnen wurde
  return 0;
  
  questitem=present("\nquestelfenhilfe",TP);
  if(str=="elfe zeitung"||"kranker elfe zeitung")
    {
      questitem=present("\nquestelfenhilfe",TP);
      if (questitem->auftrag()==2)//ist er bei Stufe 2?
        {
          if (present("zeitung",TP))
            {
              ob=present("zeitung", TP);
              ob->remove();
              write("Du gibst der kranken Elfe die Zeitung.\n");
              say(TPN+" gibt der kranken Elfe eine Zeitung.\n", TP);
              command("sag Vielen Dank");
              command("sag und nun benoetige ich dringend meine Medizin, wuerdet Ihr sie bitte fuer mich kaufen?");//hier noch den naechsten Auftrag hin
              questitem->erhoehen();
              return 1;
             }
            }
      }
    return 0;
  }
  
int verraten(string str)//man soll das Ende des Buches verraten
{
  if(!present("\nquestelfenhilfe",TP))//Wenn die Quest nicht begonnen wurde
  return 0;
  
  questitem=present("\nquestelfenhilfe",TP);
  if (str=="gaertner")//richtige Loesung?
    {
      if (questitem->auftrag()==4)//ist er bei Stufe 4?
        {
          command("sag Ja, das dachte ich mir schon. Habt Dank, "+TPN+".");
          command("sag Nun koenntet Ihr mir einen weiteren Gefallen tun. Ich habe eine alte "+
          "Vase und wuerde gerne wissen, was sie wirklich wert ist. Bitte seid so gut und lasst "+
          "sie fuer mich schaetzen und berichtet mir dann!");
          questitem->erhoehen();
          write("Die kranke Elfe gibt Dir eine Vase.\n");
          say("Die kranke Elfe drueckt "+TPN+" etwas in die Hand.\n",TP);
          CLONE(ELFEN_OBJ + "questvase.lpc", TP);

          return 1;
        }     
      else
        return 0;
      }
  else
    {
      command("sag Ihr nehmt mich auf den Arm! So jemand kommt in dem Buch gar nicht vor!");
      return 1;
    }
  }


int berichten(string str)
{
  if(!present("\nquestelfenhilfe",TP))//Wenn die Quest nicht begonnen wurde
  return 0;
  
  questitem=present("\nquestelfenhilfe",TP);
  if (str=="0"||str=="nichts"||str=="nix"||str=="null"||str=="wertlos")//richtige Loesung?
    {
      if (questitem->auftrag()==5)//ist er bei Stufe 5?
        {
          command("sag Ach, wie schade. Habt trotzdem Dank, "+TPN+". Wenn Ihr moegt, koennt Ihr sie entsorgen.");
          command("sag Nun habe ich grossen Hunger, aber leider laesst mich mein Geruchssinn "+
          "im Stich. Bitte sagt mir, ob das Essen auf dem Tisch noch geniessbar ist!");
          questitem->erhoehen();
          return 1;
        }     
      else
        return 0;
      }
  else
    {
      command("sag Also das glaube ich nicht. Fragt lieber noch einmal nach!");
      return 1;
    }
  }


void catch_tell(string str)
{
//  command("sag jap, ich hoere.");
//  write(str);
if(!TP) return;
  if(!present("\nquestelfenhilfe",TP))//Wenn die Quest nicht begonnen wurde
    return;  
  questitem=present("\nquestelfenhilfe",TP);
  if (questitem->auftrag()!=6) return;//ist er bei Stufe 6?

/*//  if (str==TPN+" sagt: geniessbar"||str=="das essen ist geniessbar"||str=="geniessbar"||str=="das essen ist geniessbar")
  if (str==TPN+" sagt: geniessbar"||
    str==TPN+" sagt: das essen ist geniessbar")
    write("falsch\n");
    //command("sag Seid ihr Euch da ganz sicher? Habt Ihr daran gerochen, "+TPN+"?");
//  else if (str=="ungeniessbar"||str=="das essen ist ungeniessbar"||str=="nicht geniessbar"||str=="das essen ist nicht geniessbar")
  else if (str==TPN+" sagt: ungeniessbar"||
    str==TPN+" sagt: das essen ist ungeniessbar"||
    str==TPN+" sagt: nicht geniessbar"||
    str==TPN+" sagt: das essen ist nicht geniessbar")
    {
/*      command("sag das dachte ich mir, ist ja auch schon etwas aelter, "+TPN+"?");
      command("sag Ich habe eine weitere Bitte: Waeret ihr so guetig meinem alten Freund XY"+
      "einen Brief zu schreiben? Bitte schreibt ganz genau diesen Wortlaut: \"joholali mumimoi "+
      "malalal schmudo dil ahndo me!\"!");
      questitem->erhoehen();
        }
    }
*/
if (strstr(str, "ungeniessbar") != -1||strstr(str,"nicht geniessbar")!=1)
      {write("Die kranke Elfe sagt: Das dachte ich mir, ist ja auch schon etwas aelter.\n"+
            "Die kranke Elfe sagt: Ich habe eine weitere Bitte: Waeret ihr so guetig \n"+
            "Die kranke Elfe sagt: nach meinem alten Freund Peter zu rufen?  \n"+
            "Die kranke Elfe sagt: Ruft einfach: \"Peter, Du wirst erwartet!\"!\n");
          	questitem->erhoehen();}

 else if(strstr(str, "geniessbar") != -1)
        write("Die kranke Elfe sagt: Seid ihr Euch da ganz sicher?\n"+
        "Die kranke Elfe sagt: Habt Ihr daran gerochen, "+TPN+"?\n");
} 



