//23.06.2022 Elfe ist nicht mehr anfreigbar

/*
Diese Elfe benoetigt Hilfe
Man fragt sie nach einem Auftrag, sie clont dann ein unsichtbares Questitem, welches die
Fortschritte des Spielers verzeichnen
Auftrag 1: Elfenkraut besorgen. Elfen muessen nur eines besorgen, alle anderen 2
Auftrag 2: Zeitung besorgen und "geben" weil man das ja nicht kann gibt es die geben-Funktion hier
Auftrag 3: Medizin besorgen und geben
Auftrag 4: ein buch lesen und Ende berichten (Lesefunktion in der Elfe)
Auftrag 5: eine Vase schaetzen lassen
Auftrag 6: Am Essen riechen und sagen obs geniessbar ist.
Auftrag 7: Eine Mail mit einem generierten Geheimcode verschicken an einen Freund, dieser 
           antworet dann ebenfalls mit einem generierten code, den muss man dann der Elfe 
           bringen, die weiss dann "Bescheid", dass er da ist
Auftrag 7: Diesen Freund suchen (warte auf dem Weg unten), ihm das dann das Kraut 
           (bekommt man vorher von kranker Elfe zurueck) geben, 
Auftrag 8: den Freund in eine Kneipe fuehren und ihm etwas spendieren
Auftrag 9: den Freund wieder zur Elfe bringen
Belohnung? Denke mal Muenzen oder besser: TP->SetProp(P_CAN_FLAGS, 15)

riechen
*/



inherit "std/npc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <npc.h>

  object questitem;
string auftrag()//Info, startet die Quest
{
object freund;
int peterda;
peterda=0;  
  if(this_player()->QueryQuest("Hilf der Elfe")) //Wenn die Quest schon beendet wurde
    return "sagt: Aber Ihr habt doch schon laengst alles erledigt!\n";

  if(present("\nquestelfenhilfe",TP))//Wenn die Quest schon begonnen wurde
    {
      questitem=present("\nquestelfenhilfe",TP);
      if (questitem->auftrag()==1)
        return "fragt: Ihr helft mir doch bereits, habt Ihr das Elfenkraut \n"+
               "Die kranke Elfe fragt: schon besorgt?\n"+
               "Die kranke Elfe sagt: Gebt es mir einfach!\n";
      if (questitem->auftrag()==2)
        return "fragt: Ihr helft mir doch bereits, habt Ihr schon eine Zeitung \n"+
               "Die kranke Elfe fragt: gefunden?\n"+
                "Die kranke Elfe sagt: Gebt sie mir einfach!\n";
      if (questitem->auftrag()==3)
        return "fragt: Ihr helft mir doch bereits, habt Ihr meine Medizin \n"+
                "Die kranke Elfe sagt: bekommen? Dann gebt sie mir einfach!\n";               
      if (questitem->auftrag()==4)
        return "fragt: Ihr helft mir doch bereits, habt Ihr das Buch gelesen?\n"+
                "Die kranke Elfe sagt: Verratet mit bitte den Moerder!\n";
      if (questitem->auftrag()==5)
        return "fragt: Ihr helft mir doch bereits, wisst Ihr schon, was die\n"+
               "Die kranke Elfe fragt: Vase wert ist?\n"+
                "Die kranke Elfe sagt: Tippt einfach: \"berichte *preis*\" wenn \n"+
                "Die kranke Elfe sagt: Ihr es wisst!\n";
      if (questitem->auftrag()==6)
        return "fragt: Ihr helft mir doch bereits, habt Ihr schon an dem Essen\n"+
               "Die kranke Elfe fragt: gerochen?\n"+
                "Die kranke Elfe sagt: Sagt einfach, ob es geniessbar oder\n"+ 
                "Die kranke Elfe sagt: ungeniessbar ist!\n";
      if (questitem->auftrag()==7)
        {
              return "sagt: Ihr helft mir doch bereits, bitte ruft Peter \n"+
                "Die kranke Elfe sagt: ruft \"Peter, Du wirst erwartet!\"\n"; 
          }
           
      if (questitem->auftrag()==8)
        if(!present("\ndaspeterli", environment(TO)))
        return "sagt: Ich hatte Euch gebeten, Peter herzufuehren. Bitte sucht \n"+
                "Die kranke Elfe sagt: ihn und bringt ihn her!\n";
        else
        	{
        	   questitem->erhoehen();        
        		 return "sagt Ah, Ihr habt Peter hergebracht, vielen Dank!\n"+
             "Die kranke Elfe betrachtet ihren Freund.\n"+
             "Die kranke Elfe sagt: Peter, alter Freund, Du siehst muede aus.\n"+
             "Die kranke Elfe sagt: "+TPN+", seid so gut und tut mir einen letzten Gefallen!\n"+
             "Die kranke Elfe sagt: Bitte fuehrt Peter in eine Kneipe und spendiert ihm ein\n"+
             "Die kranke Elfe sagt: Tannenbier";
            }
 
      if (questitem->auftrag()==9)
        return "sagt: Seid so gut und spendiert Meinem Freund ein Tannenbier!\n";
}

CLONE(ELFEN_OBJ + "questelfenhilfe.lpc", TP);
  
  if (this_player()->id("Elfenspieler"))//Rasse Elf? Erstmal so
  {       
    return "sagt: Vielen Dank, dass Ihr mir zur Hand gehen wollt. Es waere\n"+
           "Die kranke Elfe sagt: lieb, wenn Ihr mir bei meinen taeglichen\n"+
           "Die kranke Elfe sagt: Angelegenheiten helfen wuerdet.\n"+
           "Die kranke Elfe sagt: Mein erster Auftrag an Euch ist, dass Ihr ein \n"+
           "Die kranke Elfe sagt: Elfenkraut besorgt, ich benoetige es fuer einen \n"+
           "Die kranke Elfe sagt: nicht elfischen Freund.\n"+
           "Die kranke Elfe sagt: Gebt es mir einfach, wenn Ihr bereit seid fuer den neuen\n"+
           "Die kranke Elfe sagt: Auftrag. Ihr koennt mich auch jederzeit nach Auftrag\n"+
           "Die kranke Elfe sagt: fragen, wenn Ihr mal nicht mehr weiter wisst.";

    
  }
else
    {       
    return "sagt: Vielen Dank, dass Ihr mir zur Hand gehen wollt. Es waere\n"+
           "Die kranke Elfe sagt: lieb, wenn Ihr mir bei meinen taeglichen\n"+
           "Die kranke Elfe sagt: Angelegenheiten helfen wuerdet.\n"+
           "Die kranke Elfe sagt: Mein erster Auftrag an Euch ist, dass Ihr zwei\n"+
           "Die kranke Elfe sagt: Elfenkraute besorgt, ich benoetige es fuer einen nicht\n"
           "Die kranke Elfe sagt: elfischen Freund und es ist einfacher fuer Eure\n"+
           "Die kranke Elfe sagt: Auftraege, wenn Ihr auch eins besitzt.\n"+
           "Die kranke Elfe sagt: Gebt es mir einfach, wenn Ihr bereit seid fuer den neuen\n"
           "Die kranke Elfe sagt: Auftrag.";

    
  } 
}

