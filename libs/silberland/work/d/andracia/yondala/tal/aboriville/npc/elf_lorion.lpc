//Lorion der Wirt
inherit "std/npc";

inherit"/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <moredef.h>
#include <npc.h>
#include <language.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Lorion, der Wirt");
  SetProp(P_LONG,
    "Das ist Lorion. Sein Alter kannst Du kaum einschaetzen, er sieht recht jung aus, "
    "seine Augen aber verraten Erfahrung und Weisheit. Um seine Mundwinkel spielt ein kleines "
    "laecheln und er nickt Dir freundlich zu. ");

  SetProp(P_NAME, "Lorion");
  SetProp(P_GENDER, MALE);
  AddId(({"lorion", "LORION", "elf", "wirt","\nelfennorm"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(21);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 195);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 10000);

  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([ DT_HOLY:      0.5, DT_UNHOLY:    0.5]) );

  SetProp(P_MSGIN, "betritt angemessenen Schrittes den Raum");
  SetProp(P_MSGOUT, "verlaesst angemessenen Schrittes den Raum");
  SetProp(P_MMSGIN, "erscheint in einem Funkenregen");
  SetProp(P_MMSGOUT, "verschwindet in einem rosanen Nebel");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Lorion");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "sagt: Fragt das doch besser einen der Aeltesten.\n");
  AddInfo("yondala", "Lang lebe Yondala!","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SUID;
  CLONEME(ELFEN_WEAPON "elfendolch" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  command("trage alles");

//  SetChats(3, ({
//    ".\n"}) );

  SetProp(P_SPELLRATE, 35);
			  
	AddSpell(2,200,
	        "Lorion wirft Dir eine Magiekugel entgegen.\n",
	        "Lorion wirft @WEN eine Magiekugel entgegen.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,200, "Lorion schlaegt Dir mit einem Krug auf den Kopf.\n",
	        "Lorion schlaegt @WEM einen Krug auf den Kopf.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,200, "Lorion versucht, Dich mit einem Kuechenmesser abzustechen.\n",
	        "Lorion versucht @WEN, mit einem Kuechenmesser abzustechen.\n",
	         ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
			 
	AddSpell(1,200, "Lorion spuelt Bier ueber Dich.\n",
	        "Lorion spuelt Bier ueber @WEN.\n",
	         ({DT_WATER}),"rausspuelen", ([SP_SHOW_DAMAGE:1]) );
			 



}
void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}
void rausspuelen(object enemy, int damage, mixed dam_type) 
{
	if(!enemy||!damage) return;
	tell_object(enemy,"Die Bierwelle spuelt Dich hinaus.\n");
	enemy->move(ELFEN_ROOM+"aboriville_6b", M_GO, 0,
                   "wird vor einer Bierwelle hinausgespuelt", "wird aus der Hoehle im Osten herausgespuelt");
 
} 

