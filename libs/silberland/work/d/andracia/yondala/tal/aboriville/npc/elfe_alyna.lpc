// 4.3.24 Wraz: obiges deaktiviert wg. Bugs, unteres eingefuegt (kopiert von elf_lelo.c)

void magie(object enemy, int damage, mixed dam_type) 
{
	object ob;
	ob=clone_object(ELFEN_OBJ + "magiekugel.lpc");
	ob->move(enemy, M_GET);
	ob->setup(enemy);
	//CLONE(ELFEN_OBJ + "/magiekugel.lpc", enemy);
	
}

void InformDefend(object enemy)
{
 Kill(enemy);
}	