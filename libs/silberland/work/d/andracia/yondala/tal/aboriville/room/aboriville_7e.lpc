#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG, "Dir scheint das der Garten hauptsaechlich fuer Kraeuter angelegt wurde."+
    "Seltsame Gerueche steigen Dir in die Nase. "+
    "Als Du diese einatmest fuehlst Du Dich sehr wohl. "+
    "Wer auch immer diesen Garten angelegt hat, "+
    "er tat es mir sehr viel Liebe und Sorgfalt." );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "boden" }),
    "Du laeufst auf einem Kiesweg der von Kraeuterbeeten gesaeumt wird.");    
  AddDetail( ({ "himmel" }),
    "Du siehst einen blauen Himmel durch das Blaetterwerk.");    
  AddDetail( ({ "garten" }),
    "Du befindest Dich in einem Garten.");    
  AddDetail( ({ "kraut", "kraeuterbeet", "beet", "ktaeuterbeeten", "beeten", "kraeuternbeete", "beete" }),
    "Du siehst ein paar verschieden farbige Kraeuter.");    
  AddDetail( ({ "nase" }),
    "Du hast sie in Deinem Gesicht.");    
  AddDetail( ({ "brisi" }),
    "Sie ist nicht hier.");    
  AddDetail( ({ "kraeutern", "kraeuter" }),
    "Es sind eine Anzahl verschiedener Arten von Kraeuter zu sehen.");    
  AddDetail( ({ "arten", "art" }),
    "Es sind Jalape, Manna, schwarzer Nachtschatten und Pfennigkraut.");    
 AddDetail( ({ "japale", "nachtschatten", "manna", "pfennigkraut" }),
    "Du kennst keines dieser Kreuter, vieleicht kann Dir die Apothekerin helfen.");    
  AddDetail( ({ "anzahl", "zahl" }),
    "Es sind zuviele zum zaehlen in diesem Garten.");    
  AddDetail( ({ "gesicht" }),
    "Du hast sicherlich eins irgendwo.");    
  AddDetail( ({ "geruch", "gerueche" }),
    "Versuchs mal mit riechen.");    
  AddDetail( ({ "fuesse", "fuessen" }),
    "Du stehst auf ihnen.");    
  AddDetail( ({ "voegel", "vogel" }),
    "Du siehst keine. Vielleicht sitzen sie in der Baumkrone, schau doch mal zum Himmel.");    
  AddDetail( ({ "melodie" }),
    "Versuchs mal mit lauschen.");  
  AddDetail( ({ "kiesweg", "weg" }),
    "Er besteht aus kleinen Kieselsteinen, die auf dem Boden zwischen den Beeten verteilt wurden.");    
  AddDetail( ({ "kies", "kiesel", "kieseln", "kieselsteinen", "kieselstein", "steinen", "steine", "steinchen" }),
    "Kleine Steinchen die aneinander gelegt den Weg ergeben auf dem Du stehst.");    
  AddDetail( ({ "blaetterwerk", "werk", "blaetter" }),
    "Die Baumkronen ueber Dir verhindert eine freie Sicht auf den Himmel.");    
  AddDetail( ({ "baumkronen", "kronen", "baumkrone", "krone" }),
    "Die Baumkronen, unter denen Aboriville auf den starken Aesten der grossen Eichen erbaut wurde, "+
    "sind riesig, sie geben nur teilweise die Sicht auf den Himmel frei.");  
  AddDetail( ({ "sicht", "sehen" }),
    "Nach was schaust Du denn.");  
  AddDetail( ({ "aboriville", "aborivilles" }),
    "Du befindest Dich hier in einem kleinen Garten in der Elfenstadt Aboriville.");  
 AddDetail( ({ "elfenstadt" }),
    "Du befindest Dich in Aboriville.");  
 AddDetail( ({ "aeste", "ast", "aesten" }),
    "Sie sind sehr stark und tragen die Last Aborivilles.");  
 AddDetail( ({ "eichen", "eiche" }),
    "Eichen sind sehr starke Baeume.");  
 AddDetail( ({ "baum", "baeume" }),
    "Du wirst doch wohl wissen was ein Baum ist, oder?");  
 AddDetail( ({ "last" }),
    "Die Last der Elfenstadt Aboriville wird von den starken Aesten alter Eichen getragen.");  
 AddDetail( ({ "liebe", "sorgfalt" }),
    "Der Garten wird mit Liebe und Sorgfalt gepflegt.");  
 AddDetail( ({ "farbe", "farben" }),
    "Der Garten sind Kraeuter in verschiedenen Farben.");  

     
  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.");

  AddSound( ({ "voegel", "zwitschern" }),
    "Die Voegel zwitschern eine liebliche Melodie.");

  AddSound( ({ "melodie" }),
    "Die Voegel zwitschern melodisch, aber Du kannst sie nicht verstehen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Kraeutern.");
 
  AddSmell( ({ "geruch" }),
    "Der Geruch von Krautern steigt Dir in die Nase.");

  
  AddItem( ELFEN_NPC + "schmetterling.lpc", REFRESH_DESTRUCT);
  
  
AddExit( "norden", ELFEN_ROOM  + "aboriville_6e.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_6f.lpc" ); 

}

