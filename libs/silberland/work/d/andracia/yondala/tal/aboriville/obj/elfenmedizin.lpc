//einfach nur dafuer da um der Elfe gegeben zu werden
//macht sehr satt und heilt wenig, um missbrauch vorzubeugen.
inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas Medizin");
  SetProp(P_LONG,
    "Du siehst ein paar Kraeuter, die vermutlich zusammen eine Medizin ergeben." );
  SetProp(P_NAME, "Medizin");
  SetProp(P_GENDER, FEMALE);


SetProp(P_FOOD_INFO, ([F_SOAK:10, 
											 F_HEAL:({2,2}), // erst HP, MP
											 F_MSG: "Du wuergst die Medizin herunter. Buah, ist die bitter.", 
											 F_MSG_ROOM: "wuergt eine Medizin herunter und verzieht das Gesicht."]));


  AddId(({"medizin", "elfenmedizin", "kraeuter"}));
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 20);


 
}

