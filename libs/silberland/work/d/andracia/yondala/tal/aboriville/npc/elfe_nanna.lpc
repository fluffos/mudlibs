{
	if(!present(zuhoerer, environment(TO)))
		command("sag Nanu, "+name+ "ist ja gar nicht mehr da.");
	else
		{
			command("sag es war einmal 1");
			call_out("entstehungaboriville_3", 1);
		}
	}
	
entstehungaboriville_3()
{
	if(!present(zuhoerer, environment(TO)))
		command("sag Nanu, "+name+ "ist ja gar nicht mehr da.");
	else
		{
			command("sag es war einmal 1");
			call_out("entstehungaboriville_4", 1);
		}
	}
	
entstehungaboriville_4()
{
	if(!present(zuhoerer, environment(TO)))
		command("sag Nanu, "+name+ "ist ja gar nicht mehr da.");
	else
		{
			command("sag es war einmal 1");
			call_out("entstehungaboriville_5", 1);
			}
	}
	
entstehungaboriville_5()
{
		call_out("stehen", 1);		
	}
	
	
	
	
	