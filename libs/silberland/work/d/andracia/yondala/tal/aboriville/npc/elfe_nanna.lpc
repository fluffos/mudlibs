//Die Kindergaertnerin

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>


int geschichte;		// welche Geschichte wird erzaehlt?
int erzaehlen =0;	//erzaehlt Nanna gerade eine Geschichte?
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}
object zuhoerer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Nanna");
  SetProp(P_LONG,
    "Du siehst eine liebe, etwas aeltere Elfe vor Dir. Sie sieht sehr ruhig und guetig aus und "
    "scheint wie geschaffen um die Elfenkinder zu hueten, dennoch laesst der Blick mit dem sie "
    "Dich mustert keinen Zweifel daran, dass sie ihre Schuetzlinge mit ihrem Leben verteidigen wuerde.");
  SetProp(P_NAME, "Nanna");
  SetProp(P_GENDER, FEMALE);
  AddId(({"nanna","elfe", "elfin", "kindergaertnerin"}));
  AddId(({"/nelfennorm"}));
  	SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
	SetProp(P_DEFENDERS, (({"elfenwaechter"})));
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 196);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 1500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([      DT_HOLY:      1.0, DT_UNHOLY:    -0.5, DT_MAGIC:  0.0, DT_MIND:   1.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_2f");
SetProp (P_MNPC_AREA, ({
	ELFEN_ROOM + "aboriville_1e", 
	ELFEN_ROOM + "aboriville_1f", 
	ELFEN_ROOM + "aboriville_1g", 
	ELFEN_ROOM + "aboriville_2f", 
	ELFEN_ROOM + "aboriville_2g", 
	ELFEN_ROOM + "aboriville_3e", 
	ELFEN_ROOM + "aboriville_3f", 
	ELFEN_ROOM + "aboriville_3g"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Rettet meine Kinder!");
  SetProp(P_KILL_NAME, "Nanna");
  SetProp(P_KILL_MSG, "Das habt Ihr selbst zu verantworten!");

  AddInfo(DEFAULT_INFO, "sagt: das erklaere ich den Kindern auch immer mehrfach.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"geschichte","geschichten","erzaehlen"}),
    "Wenn ich eine Geschichte erzaehlen soll, dann bittet mich einfach um eine.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nanna traegt nichts fuer Dich.\n" }) );


//  SetChats(3, ({
//    ".\n"}) );

  SUID;
  CLONEME(ELFEN_WEAPON "elfendolch" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "elfentunika" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");

AddCmd( ({ "bitte"}), "bitten" );


}



// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void InformDefend(object enemy)
{
  Kill(enemy);
}


void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


bitten(string str)
{
//  notify_fail( "?\n" );
	if (str=="nanna um geschichte"||str=="nanna um eine geschichte")
		{
			write("Du bittest Nanna um eine Geschichte.\n");
			say(TPN+" bittet Nanna um eine Geschichte.\n",TP);
			
			if(erzaehlen==1)
				{
					command("sag Aber ich erzaehle doch bereits eine Geschichte!");
					return 1;
				}

		if(TO->InFight())//wenn sie grad kaempft
	{
		command("sag Dafuer habe ich gerade keine Zeit, tut mir leid.");
		return 1;
	}
				
			if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_2g")
				{
					zuhoerer=TP;
					name=TPN;
					command("sag Gerne erzaehle ich Euch eine Geschichte!");
					call_out("setzen",2);
				}
			
			
			else
				{
					command("sag Gerne erzaehle ich eine Geschichte, aber lasst uns dafuer in die Kuschelecke gehen!");
					call_out("richtiger_raum", 1);
				}
			return 1;
			}

	}

richtiger_raum()
{
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_1e")
	  {
	  	command("suedosten");
	  	call_out("richtiger_raum", 2);
			}	
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_1f")
	  {
	  	command("sueden");
	  	call_out("richtiger_raum", 2);
			}
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_1g")
	  {
	  	command("suedwesten");
	  	call_out("richtiger_raum", 2);
			}
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_2f")
	  {
	  	command("osten");
	  	call_out("richtiger_raum", 2);
			}
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_3f")
	  {
	  	command("norden");
	  	call_out("richtiger_raum", 2);
			}
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_3g")
	  {
	  	command("nordwesten");
	  	call_out("richtiger_raum", 2);
			}
	if( file_name(environment(TO)) == ELFEN_ROOM + "aboriville_2g")
	  {
			call_out("setzen", 2);
			}
}
	
setzen()
{
	erzaehlen=1;
	geschichte=0;//spaeter random(x);
	command("sitz in schaukelstuhl");
  //if (environment(zuhoerer)==environment(TO)) zuhoerer->SetProp(P_NOMOVE, 1, "Du lauschst doch gerade einer Geschichte.");
	
	if(geschichte==0) call_out("entstehungaboriville_1",2);
}


stehen()
{
	zuhoerer->SetProp(P_NOMOVE, 0);
	command("steh");
	erzaehlen=0;
}
	
entstehungaboriville_1()
{
//	if(!present(zuhoerer, environment(TO)))
  if (environment(zuhoerer)!=environment(TO))
		command("sag Nanu, "+name+ "ist ja gar nicht mehr da.");
	else
		{
			command("sag es war einmal 1");
			call_out("entstehungaboriville_2", 1);
		}
	}
	
