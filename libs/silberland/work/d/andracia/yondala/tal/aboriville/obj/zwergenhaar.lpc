#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas weiches Zwergenhaar");
  SetProp(P_LONG,
    "Du siehst ein Bueschel weiches Zwergenhaar." );
  SetProp(P_INFO, "Wenn man auf diesem Haar herumkaut reinigt es etwas.");
  SetProp(P_NAME, "Zwergenhaar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"zwergenhaar","haar"}));
  SetProp(P_NAME_ADJ, "weich");
  SetProp(P_MATERIAL, MAT_HAIR );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);

	AddCmd(({"kau", "kaue"}), "kauen"); 

}

//soll was tolles koennen spaeter
kauen(string str)
{    	
	notify_fail( "Was moechtest Du starten?\n" );
	if(str=="zwergenhaar"||str=="haar")
		{
			write("Du kaust auf dem weichen Zwergenhaar rum bis es vollkommen weg ist.\n");
			say(TPN+" kaut auf etwas Zwergenhaar herum.\n");
			}
		return 0;
	}