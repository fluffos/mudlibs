inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein seidener Guertel");
  SetProp(P_LONG, 
    "Du siehst einen braunen Guertel, welcher aus edler, brauner Seide geflochten wurde.");
  SetProp(P_NAME, "Guertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"seidenguertel", "guertel", "\nelfenguertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_SILK ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 140);      
  SetProp (P_QUALITY_DECAY, 200);
                                       
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 250]) );
}