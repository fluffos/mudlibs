#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_stdwach.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

 AddItem(ELFEN_NPC + "elfenwaechter.lpc",REFRESH_DESTRUCT);
AddExit( "westen", ELFEN_ROOM  + "aboriville_10k.lpc" ); 
AddExit( "nordosten", ELFEN_ROOM  + "aboriville_9m.lpc" ); 

}

int kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
  if( str == "runter"||str == "herunter"||str == "hinunter"||str == "nach unten"||str == "ueber gelaender"||str == "an gelaender runter" )
  {
  	TP->move(BIRKE_ROOM + "buchenwald_10l", M_GO,
  	"","klettert nach unten","klettert einen Baum hinunter");
		write("Du kletterst ueber das Gelaender und am Baum hinab.\n");
    say( TPN+" klettert nach unten.\n");
    return 1;

  }
  return 0;
}