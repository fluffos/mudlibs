void axt()
{
  tell_object(environment(this_object()),QueryProp(P_SHORT)+" verwandelt sich in eine magische Axt.\n");
   
  SetProp(P_SHORT, "Eine magische Axt");
  SetProp(P_LONG, 
    "Du siehst eine Axt, die aus purer Magie besteht. Sie "
	"pulsiert leicht und gibt ein schwaches Leuchten von sich.");
  SetProp(P_NAME, "Axt");	
  SetProp(P_GENDER, FEMALE);  
  RemoveId(P_IDS);
  AddId( ({"axt","beil","waffe"}) );  
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_DAM_TYPE, ({DT_SLASH, WT_MAGIC}) );
  SetProp(P_SIZE, 90); 
}



void verwandlung()
{
	int i;
	i=random(7);
	if(i==0) peitsche();
	else if(i==1)schwert();
	else if(i==2)speer();
	else if(i==3)dolch();
	else if(i==4)keule();
	else if(i==5)kette();
	else if(i==6)axt();
}


void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();
//Bleibt immer:
//*********************************************************************************   
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WC, 250); 
  SetProp(P_WC_BONUS,
    (["Magiemeister":265]));   
  SetProp(P_WC_FIX, 100);
  SetProp(P_VALUE, 3000);
  SetProp(P_NR_HANDS, 1); 
  SetProp(P_QUALITY_DECAY, 0);
  AddAdjective("magisch");
  SetProp(P_HIT_FUNC, this_object());  
  
  SetProp(P_WIELD_FUNC, this_object());
//  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) ); 
  //*********************************************************************************   
  //wird sofort geaendert: 
  SetProp(P_NAME, "Waffe");	
  SetProp(P_SHORT, "Eine magische Waffe");
  SetProp(P_LONG, 
    "Du siehst eine magische Waffe. Huiuiuiui, ist die stark.");  
  SetProp(P_GENDER, FEMALE);  
  AddId( ({"waffe"}) );  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, ({DT_SLASH, WT_MAGIC}) );
  SetProp(P_SIZE, 165);  
  //*********************************************************************************   


 
//call_out(verwandlung(),2);
}

int WieldFunc(object waffe)
{
    if(!interactive(this_player()))return 1;
	if (query_wiz_level(this_player())>0)
       return 1;
   
     write( "Nur Seher koennen diese maechtige Waffe zuecken.\n");
     return 0;         

return 1;
}

     


//Der Waffentyp soll sich bei jedem Schlag aendern
int HitFunc(object enemy)
{
	if(random(3)) verwandlung();
    }