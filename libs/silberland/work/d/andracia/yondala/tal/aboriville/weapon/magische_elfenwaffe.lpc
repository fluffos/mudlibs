//Sehr starke Waffe, die bei jedem Treffer ihren Typ aendert. 
//Zerfaellt nach zehn Minuten in Spielerhand

inherit "/std/weapon";
//#include </sys/weapon.h>
#include <properties.h>
#include <combat.h>

weg()
{
	  tell_object(environment(this_object()),QueryProp(P_SHORT)+" loest sich auf.\n");
	  remove();
}
void init() {
  if( interactive(environment(this_object()))) 
    if(find_call_out("weg")<1) call_out("weg", 600);
  ::init();
}


void peitsche()
{
  tell_object(environment(this_object()),QueryProp(P_SHORT)+" verwandelt sich in eine magische Peitsche.\n");
   
  SetProp(P_SHORT, "Eine magische Peitsche");
  SetProp(P_LONG, 
    "Du siehst eine Peitsche, die aus purer Magie besteht. Sie "
	"pulsiert leicht und gibt ein schwaches Leuchten von sich.");
  SetProp(P_NAME, "Peitsche");	
  SetProp(P_GENDER, FEMALE);  
  RemoveId(P_IDS);
  AddId( ({"peitsche","waffe"}) );  
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_DAM_TYPE, ({DT_WHIP, WT_MAGIC}) );
  SetProp(P_SIZE, 280); 
}

void schwert()
{
  tell_object(environment(this_object()),QueryProp(P_SHORT)+" verwandelt sich in ein magisches Schwert.\n");
   
  SetProp(P_SHORT, "Ein magisches Schwert");
  SetProp(P_LONG, 
    "Du siehst ein Schwert, welches aus purer Magie besteht. Es "
	"pulsiert leicht und gibt ein schwaches Leuchten von sich.");
  SetProp(P_NAME, "Schwert");	
  SetProp(P_GENDER, NEUTER);  
  RemoveId(P_IDS);
  AddId( ({"schwert","waffe"}) );  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, ({DT_SLASH, WT_MAGIC}) );
  SetProp(P_SIZE, 130); 
}

