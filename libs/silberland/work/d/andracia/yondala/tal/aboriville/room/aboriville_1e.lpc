#include "../def.h"
inherit ELFEN_ROOM  + "aboriville_std.lpc";
#include <properties.h>
#include <language.h>

int haarda=3;

void reset()
{
	::reset();
	haarda=3;
	}
void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Tobraum");
  SetProp(P_INT_LONG, 
  		"Dies ist die nordwestliche Ecke des Kindergartens. Wie ueblich "
  		"in Aboriville sind auch hier Boden, Waende und auch Decke aus Holz. "
  		"Auf dem Boden liegen hier jedoch einige dicke, weiche Matten und "
  		"grosse Kissen. Hier koennen die Kinder nach Herzenslust herum toben "
  		"oder sich ein wenig raufen.");
AddItem(ELFEN_NPC + "kigaelfe1.lpc",REFRESH_DESTRUCT);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Wie alles in Aboriville ist auch hier der Boden aus Holz. Auf ihm liegen "
    "einige dicke Matten und ein paar grosse Kissen.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "matten" }),
    "Auf den Matten balgen und raufen sich die Kinder dieses Kindergartens "
    "gelegentlich, so koennen sie sich abreagieren und ihre Kraefte messen. "
    "Die Matten bestehen aus weichem Moos und gleichmaessig auf dem Boden verteilt.");    
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus einem besonders weichen Holz, es scheint hier eine dicke, "
    "weiche Rinde zu haben. An einer Wand ist die Tuer, durch die Du gekommen bist.");    
  AddDetail( ({ "rinde" }),
    "Das lebendige Holz dieser Stadt hat ueberall noch seine Rinde, aber hier scheint sie "
    "besonders weich zu sein.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "decke" }),
    "Die hohe, helle Decke ist aus Holz. Ein paar kleine Gluehwuermchen schweben darunter.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen spenden dem Raum zusaetzliches Licht.");    
  AddDetail( ({ "licht" }),
    "Durch die Tuer faellt ein bisschen Sonnenlicht und auch die Gluehwuermchen unter der "
    "Decke erhellen den Raum.");    
  AddDetail( ({ "sonnenlicht","sonne" }),
    "Das Licht der Sonne erhaelt den Raum.");    
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer hast Du den Tobraum betreten und kannst ihn auch wieder verlassen. Sie fuehrt nach Suedosten.");    
  AddDetail( ({ "raum","tobraum" }),
    "Du befindest Dich im Tobraum des Kindergartens von Aboriville. Hier koennen "
    "die Kinder nach Herzenslust toben und laermen.");    
  AddDetail( ({ "herzenslust", "lust" }),
    "Manchmal ueberkommt es einen einfach.");    
  AddDetail( ({ "kissen" }),
    "Die grossen Kissen sind mit etwas sehr weichen gefuellt und laden geradezu "
    "dazu ein eine Kissenschlacht zu beginnen.");    
  AddDetail( ({ "fuellung" }),
    "Die Kissen sind scheinbar mit weichgeklopftem Zwergenhaar gefuellt.");    
  AddDetail( ({ "zwergenhaar" }),
    "Zwergenhaar ist normalerweise hart und borstig, dieses hier wurde aber "
    "solange bearbeitet, bis es kuschelweich wurde.");    
  AddDetail( ({ "kissenschlacht","schlacht" }),
    "Hier wurde schon so manche Kissenschlacht begonnen.");    
  AddDetail( ({ "moos" }),
    "Das weiche Moos ist extra fuer diesen Raum gewachsen, damit die Kinder sich beim Toben nicht verletzen.");    
  AddDetail( ({ "toben", "raufen", "freude" }),
    "Toben und Raufen macht den Kindern hier viel Freude.");    
  AddDetail( ({ "ecke" }),
    "Du befindest Dich in der nordwestlichen Ecke des Kindergartens.");    
  AddSpecialDetail( ({ "kraefte", "kraft" }), "kraft");
   
  AddDetail( ({ "himmel" }),
    "Den kannst Du hier nicht sehen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nichts, die Waende scheinen ziemlich schalldicht zu sein.");

	AddSmell( DEFAULT_SMELL,
	"Es riecht hier nach Natur"); 



	AddExit( "suedosten", ELFEN_ROOM  + "aboriville_2f.lpc" ); 
	AddCmd(({"beginne", "beginn", "starte", "start"}), "kissenschlacht"); 
	AddCmd(({"tobe", "tob"}), "toben"); 

}

int kissenschlacht(string str)
{
	int haar;
	haar=random(20);    	
	notify_fail( "Was moechtest Du starten?\n" );
	
	if (str =="kissenschlacht");
		{
			write("Du schnappst Dir ein Kissen und wirfst es wild durch den Raum.\n");
			say(TPN+" schnappt sich ein Kissen und wirft es wild durch den Raum.\n", TP);

//eventuell spaeter seltener

			if(haarda>0)
				{
					if (haar!=1)return 1;
						
					write("Ein Bueschel Haare faellt aus dem Kissen.\n");
					say("Ein Bueschel Haare faellt aus dem Kissen.\n", TP);
				  CLONE(ELFEN_OBJ+"zwergenhaar.lpc",TO);
				  haarda--;
				}

			return 1;
			}
		return 0;	
	}
	
toben()
{    	
			write("Du tobst wild herum und fuehlst Dich gleich viel besser.\n");
			say(TPN+" tobt wild herum.\n", TP);
			return 1;
	}
		
kraft()
{
//	int kraft=TP->QueryProp(P_
    return "Du bist stark.\n";
     }

	