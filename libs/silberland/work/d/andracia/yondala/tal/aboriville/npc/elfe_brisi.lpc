//05.09.2022: Nun angreifbar und hat ein paar Spells bekommen
// Apothekerin in 1a
// wohnt in 1b

//Wunsch der echten Brisi:
// Haus: Home Twinkle Home, sternschnuppenförmig
// Haustiere: viele kleine suesse Fluffel in pastelltoenen

// mehrer jugendliche Lover

inherit "std/mnpc";
inherit"/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <moredef.h>
#include <npc.h>
#include <language.h>


/*heilt
Verteidigungszauber*/
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Brisi, die Apothekerin");
  SetProp(P_LONG,
    "Das ist Brisi, die kleine Elfe. Brisis Haare schimmern golden bei jedem "
    "Licht. Ihre gruene Augen strahlen Dich an. Sie laeuft barfuss herum, "
    "aber ihre Fuesse sind so rein wie ihre Seele. Sie traegt ein rosafarbenes "
    "Gewand.");

  SetProp(P_NAME, "Brisi");
  SetProp(P_GENDER, FEMALE);
  AddId(({"brisi", "elfe", "elfin", "apothekerin"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, 150);
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 10000);
  SetProp(P_MAX_HANDS, 2);
  //SetProp(P_NOATTACK, 1,"Brisi wird von einem heiligen Schutzschild beschuetzt");

  SetProp(P_HEAL, 1);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([ DT_POISON: 1.0,  DT_HOLY:      1.0, DT_UNHOLY:    1.0, DT_MAGIC:  1.0, DT_MIND:   1.0]) );

  SetProp(P_MSGIN, "betritt angemessenen Schrittes den Raum");
  SetProp(P_MSGOUT, "geht angemessenen Schrittes");
  SetProp(P_MMSGIN, "erscheint in einem Funkenregen");
  SetProp(P_MMSGOUT, "verschwindet in einem rosanen Nebel");


  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
/*  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Brisi");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");
*/
  AddInfo(DEFAULT_INFO, "sagt: Fragt das doch lieber einen der Aeltesten.\n");
  AddInfo("yondala", "Lang lebe Yondala!","sagt: ");

  AddInfo( ({"medizin",""}),
    "Fuer nur 50 Muenzen kann ich Euch welche verkaufen.",
    "sagt: ");
  AddInfo( ({"gift","entgiften","entgifte","vergiftung"}),
    "Ich kann Euch entgiften. Tippt dafuer einfach \"entgifte\"!",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");


  SetChats(1, ({
    "Ein kleiner bunter Schmetterling landet auf Brisis Haaren.\n"}) );
    SetProp(P_SPELLRATE, 20);
   SetProp(P_NOMAGIC,20);
   AddSpell(2,150,
              "Brisi saugt Dir etwas Lebenskraft ab.\n",
              "Brisi saugt @WEM Lebenskraft ab.\n",
              (DT_MAGIC), "kampfheilen", ([SP_SHOW_DAMAGE:1]) );
			  
  AddDefaultSpell(3, 100, DS_POISON, "Brisi floesst Dir einen kleinen Trank ein.\n",
										"Brisi floesst @WEM einen kleinen Trank ein.\n");			  
  AddDefaultSpell(3, 100, DS_BLIND,"Brisi sticht Dir in die Augen.\n",
										"Brisi sticht @WEM in die Augen.\n");			  
  AddDefaultSpell(3, 100, DS_DEAF, "Brisi klatscht Dir gegen die Ohren.\n",
										"Brisi klatscht @WEM gegen die Ohren.\n");			  
  AddDefaultSpell(1, 100, DS_FROG, "Brisi kuesst Dich.\n",
										"Brisi kuesst @WEN.\n");			  



											  
			  
  AddCmd( ({ "entgifte", "entgifte"}), "entgifte" ); 
  AddCmd( ({ "enttaube", "enttaube"}), "enttaube" ); 
  AddCmd( ({ "entblinde", "entblinde"}), "entblinde" ); 
  AddCmd( ({ "entfrosche","entfroschen"}), "entfrosche" ); 
//  AddCmd( ({ "erledigt"}), "erledigt" ); 
  AddCmd(({"kaufe","kauf"}),"kaufenCmd");

}

void kampfheilen(object enemy, int damage, mixed dam_type) 
{
   //command("sag Damage "+damage+".");
   if(!damage) return;

   TO->AddHp(damage*2);
   
}  

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


