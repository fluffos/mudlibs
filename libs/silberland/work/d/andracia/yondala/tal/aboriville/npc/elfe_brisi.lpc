/*
    "| Entgiften              100 |\n"
    "| Entfroschen            400 |\n"
//    "| Entraupen              800 |\n"
    "| Entblinden             200 |\n"
    "| Enttauben              150 |\n"*/
int entgifte()
{
	if(InFight())
	{
		write("Brisi ist gerade in einen Kampf verwickelt.\n");
		return 1;
	}
	if(TP->QueryProp(P_POISON)==0)
		command("sag Aber Ihr seid doch gar nicht vergiftet, "+TPN+"!");
		else
			{
				if(this_player()->QueryMoney() < 100)
					{
						command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
						return 1;
					}
  
  			this_player()->AddMoney(-200);					
				TP->AddPoison(-1);
				if(TP->QueryProp(P_POISON)==0)
					command("sag Es ist mir gelungen, Eure Vergiftung vollstaendig zu heilen, "+TPN+".");
				else
 					command("sag Es ist mir gelungen, Eure Vergiftung etwas zu lindern, "+TPN+".");
 				}
		return 1;
	}
int enttaube()
{
	if(InFight())
	{
		write("Brisi ist gerade in einen Kampf verwickelt.\n");
		return 1;
	}

	if(TP->QueryProp(P_DEAF)==0)
		{command("sag KOENNT IHR MICH HOEREN?");
	   command("sag Seht Ihr? Ihr seid gar nicht taub, "+TPN+"!");	}	
		
		else
			{
				if(this_player()->QueryMoney() < 150)
					{
						command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
						return 1;
					}
  
  			this_player()->AddMoney(-150);					
				TP->SetProp(P_DEAF,0);
					command("sag Es ist mir gelungen, Euch von Eurer Taubheit zu erloesen, "+TPN+".");
 				}
		return 1;
	}
	
	
	
int entblinde()
{	
		if(InFight())
	{
		write("Brisi ist gerade in einen Kampf verwickelt.\n");
		return 1;
	}
	if(TP->QueryProp(P_BLIND)==0)
		{command("sag Ihr seid doch gar nicht blind, "+TPN+"!");	}	
		
		else
			{
				if(this_player()->QueryMoney() < 200)
					{
						command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
						return 1;
					}
  
  			this_player()->AddMoney(-200);					
				TP->SetProp(P_BLIND,0);
					command("sag Es ist mir gelungen, Euch von Eurer Taubheit zu erloesen, "+TPN+".");
					command("sag Ist es nicht herrlich, als erstes MICH zu sehen?");
 				}
		return 1;
		}
		
int entfrosche()
{
	if(InFight())
	{
		write("Brisi ist gerade in einen Kampf verwickelt.\n");
		return 1;
	}	
	if(TP->QueryProp(P_FROG)==0)
		{command("sag Ihr seid doch gar kein Frosch, "+TPN+"!");	}	
		
		else
			{
				if(this_player()->QueryMoney() < 500)
					{
						command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
						return 1;
					}
  
  			this_player()->AddMoney(-200);					
				TP->SetProp(P_FROG,0);
				write("Brisi kuesst Dich.\n");
				say("Brisi kuesst "+TPN+".");
					command("sag Nun seid Ihr kein Frosch mehr, "+TPN+". Es war mir ein Vergnuegen.");
 				}
		return 1;
		}
kaufenCmd(string str)
{ notify_fail("Was willst du kaufen?\n");


if(str=="medizin")
{	
	if(this_player()->QueryMoney() >= 50)
		{
			this_player()->AddMoney(-50);
			write("Du gibst Brisi 50 Muenzen.\nGibt Dir eine Medizin.\n");
			say(TPN+" kauft etwas bei Brisi.\n", TP);
			CLONE(ELFEN_OBJ +"elfenmedizin.lpc", TP);
			return 1;
		}
	else
		command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
 	return 1;
	}
}