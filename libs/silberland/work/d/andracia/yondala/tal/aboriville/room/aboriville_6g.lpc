#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Gewaechshauses." );
  SetProp( P_INT_LONG, "Du befindest Dich im Ostteil das Gewaechshauses.\n"+
    "Hier stehen hauptsaechlich Topfkraeuter in den verschiedensten Farben.\n"+
    "Du spuerst, dass es hier waermer ist und auch Luftfeuchtigkeit ist gestiegen." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "boden", "weg", "rinde", "baeume" }),
    "Du laeufst auf einem Weg, der aus abgefallener Rinde alter Baeume besteht.\n");    
  AddDetail( ({ "waende", "wand", "glaswand", "glaswaende" }),
    "Glaswaende lassen Sonnenlicht herreindringen.\n");    
  AddDetail( ({ "decke", "glasdach", "dach" }),
    "Ein Glasdach, das das Sonnenlicht herreinscheinen laesst.\n");    
  AddDetail( ({ "sonnenlicht", "sonnenstrahl", "sonnenstrahlen" }),
    "Sonnenstrahlen fallen durch das Glasdach und die Glaswaende herin.\n");    
  AddDetail( ({ "gewaechshauses", "gewaechshaus", "ostteil" }),
    "Du stehtst im Ostteil des Gewaechshauses.\n");
  AddDetail( ({ "topfkraeuter", "topf", "kraeuter", "kraut" }),
    "Es sind etliche und die alle unbekannt.\n");    
  AddDetail( ({ "farben" }),
    "Du siehst verscheiden farbige Kraeuter.\n");    
  AddDetail( ({ "luftfeuchtigkeit", "luft", "feuchtigkeit", "klima" }),
    "Die Feuchtigkeit hier ist stark erhoet, um den Kraeutern ein gutes Klima zu ermoeglichen.\n");    
  AddDetail( ({ "sueden" }),
    "Im Sueden scheint ein Springbrunnen zu sein.\n");    
  AddDetail( ({ "springbrunnen", "springbrunnens", "brunnen" }),
    "Er plaetschert leise vor sich hin, und versorgt die Luft mit der noetigen Feuchtigkeit.\n");    

      
  AddSound( DEFAULT_SOUND,
    "Du hoerscht das leise plaetschern eines Springbrunnens.\n");
    
  AddSound( ({ "springbrunnens", "springbrunnen", "brunnen", "plaetschern", "plaetschert" }),
    "Im Sueden schein ein Springbrunnen zu sein, der vor sich hin plaetschert.\n");

  AddSmell( DEFAULT_SMELL,
    "Es richt nach verschiedensten Kraeutern, die hier wachsen.\n");



AddExit( "westen", ELFEN_ROOM  + "aboriville_6f.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_7g.lpc" ); 



}

