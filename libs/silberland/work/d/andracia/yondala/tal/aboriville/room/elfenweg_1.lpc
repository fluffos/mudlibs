#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg" );
  SetProp( P_INT_LONG,
    "Westen Kreuzung, Osten Elfen" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "" }),
    "");





 AddExit( "osten", ELFEN_ROOM +"elfenweg_2.lpc" ); 
 AddExit("westen", "/d/andracia/yondala/faunenwald/room/faunenwald_kreuzung.lpc");
 
 }


