//Ariana ist die aelteste Priesterin

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"elf_aelteste_std.lpc";


void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("andvare")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
   call_out("zweigfrager", 1);
}

string schwur()
{
	if(TP->QueryProp(P_RACE)=="Waldelf")
		return("sagt: Sprecht in meinem Beisein den Satz: \"Ich schwoere ein guter\n"
		       "Ariana sagt: Waldelf zu sein\", so werde ich Euch den Zweig des Lebens \n"
		       "Ariana sagt: ueberreichen.");
	else
		return ("sagt: Wenn ein Waldelf den Schwur abgelegt hat, so erhaelt er den Zweig "+
		        "Ariana sagt: des Lebens.\n");	
	
}
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ariana, die aelteste Priesterin");
  SetProp(P_LONG,
    "Du siehst eine sehr grosse Elfin vor Dir. Ariana ist schlank, hat sehr helle Haut und ist "
    "in feine Gewaender gehuellt. Auf Ihrem Kopf traegt sie einen silbernen Stirnreif in dem "
    "ein kleiner Stein eingelassen ist." );
  SetProp(P_NAME, "Ariana");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"ariana", "elfin", "elfe", "aelteste", "priesterin"}));
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit heiliger Macht",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, 1000);

//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 1.0, DT_TERROR: 0.5,
      DT_HOLY:      1.0, DT_UNHOLY:    1.0, DT_MAGIC:  1.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,50);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst %s nicht entkommen!");
  SetProp(P_KILL_NAME, "Andvare, der aelteste Krieger");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Yondala allein mag uns diese Weisheit vermitteln.\n");
  

  AddInfo( ({"stammbaum"}), 
    "Ayala moechte einen Stammbaum all unserer Nachkommen anfertigen, vielleicht fragt Ihr "
    "besser sie danach.",
    "sagt: "); 
  AddInfo( ({"zweig","zweig des lebens"}), 
    "Jeder wuerdige Elf, der den Schwur gesprochen hat, traegt den Zweig des Lebens bei sich.",
    "sagt: "); 
  AddInfo( ({ "schwur", "schwoeren"}), #'schwur);//'
  
  AddInfo( ({"ariana", "aelteste priesterin","priesterin"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 

     
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,250,
	        "Ariana wirft eine Magiekugel nach Dir.\n",
	        "Ariana wirft eine Magiekugel nach @WEM.\n",
	         ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(4,1180,
	         "Ariana beschwoert den Zorn der Goetter auf Dich herab.\n",
	         "Ariana beschwoert den Zorn der Goetter auf @WEN herab.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,450,
	         "Ariana schleudert einen Flammenball auf Dich.\n",
	         "Andvare schleudert einen Flammenball auf @WEN.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,270,
	         "Andvare vergiftet Dich.\n",
	         "Ariana vergiftet @WEN.\n",
	         ({DT_TERROR}), ([SP_SHOW_DAMAGE:1]) );








/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
  SUID;
  CLONEME(ELFEN_ARMOUR "priestergewand" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");
  
  

}
