void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(2));
}



void InformDefend(object enemy)
{
 Kill(enemy);
}	

zweigfrager()
{
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  	{
  		if (present("\nzweigdeslebens",TP))
	 			command("sag Ich gruesse Euch, "+TPN+". Schoen, dass Ihr mal wieder vorbei schaut!");
			else
				{
					if(TP->QueryProp(P_RACE)=="Elf")
	 		    command("sag Ich gruesse Euch, "+TPN+", doch sagt, wo ist Euer Zweig des Lebens?");
	 		  }
		}
	}
	


void catch_tell(string str)
{
	object ob;

if (strstr(upperstring(str), "ICH SCHWOERE EIN GUTER WALDELF ZU SEIN")!=-1)
	{
		if(TP->QueryProp(P_RACE)!="Waldelf")
  	 {
  		 command("sag Das ist ja niedlich, ein "+TP->QueryProp(P_RACE)+" schwoert ein guter Waldelf zu sein!");
  		 say("Ariana lacht laut.\n");
  		 return; 
  	  } 

	else //wenn er also ein Waldelf ist
		if(present("\nzweigdeslebens",TP))//Wenn er schon den Zweig hat
			{
				command("sag Nun, Ihr habt schon einen Zweig, "+TPN+".");
				say("Ariana nimmt "+TPN+" den Zweig des Lebens aus dem Haar und "
				"zerstoert ihn.\nAriana steckt "+TPN+" einen neuen Zweig ins Haar.\n",TP);//({TP}));
				write("Ariana nimmt Dir Deinen Zweig des Lebens aus den Haaren und zerstoert ihn.\nAriana "+
				"steckt Dir einen neuen Zweig ins Haar.\n");
				ob=present("\nzweigdeslebens",TP);
				ob->remove();
     	 CLONE(ELFEN_OBJ+"zweigdeslebens.lpc", TP);	
    		}		
		else
			{
				command("sag Wohlan, "+TPN+" ich glaube, dass es Euch ernst ist mit Eurem Schwur. So "
				        "gebe ich Euch nun Euren Zweig des Lebens.");
			  say("Ariana steckt "+TPN+" einen Zweig ins Haar.\n",TP);//({TP}));
		  	write("Ariana steckt Dir einen Zweig ins Haar.\n");
        CLONE(ELFEN_OBJ+"zweigdeslebens.lpc", TP);	
      }
    }
} 