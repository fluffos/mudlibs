#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG, "Du schreitest weiter durch den Garten. Der Weg wird auch hier von Beeten\n"+
    "begeleitet. Links sind die Blumenbeete, rechts Kraeuterbeete, in denen Kraeuterut und Blumen angepflanzt wurden, "+
    "von denen Dir einige bekannt vorkommen, andere hingegen hast Du noch nie zuvor gesehen." );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "boden" }),
    "Du laeufst auf einem Kiesweg der von Kraeuterbeeten gesaeumt wird.\n");    
  AddDetail( ({ "himmel" }),
    "Du siehst einen blauen Himmel durch das Blaetterwerk.\n");    
  AddDetail( ({ "garten" }),
    "Du befindest Dich in einem Garten.\n");    
  AddDetail( ({ "beet", "beeten", "beete" }),
    "Es gibt Krauterbeete und Blumenbeete.");    
  AddDetail( ({ "blumen", "blumenbeet", "blumenbeeten", "blumenbeete" }),
    "Du siehst ein paar verschieden farbige Veilchen.\n");    
  AddDetail( ({ "veilchen" }),
    "Sie riechen angenehm.\n");    
  AddDetail( ({ "kraut", "kraeuterbeet", "ktaeuterbeeten", "kraeuternbeete" }),
    "Du siehst ein paar verschieden farbige Kraeuter.\n");    
  AddDetail( ({ "nase" }),
    "Du hast sie in Deinem Gesicht.\n");    
  AddDetail( ({ "brisi" }),
    "Sie ist nicht hier.\n");    
  AddDetail( ({ "kraeutern", "kraeuter" }),
    "Es sind eine Anzahl verschiedener Arten von Kraeuter zu sehen.\n");    
  AddDetail( ({ "arten", "art" }),
    "Es sind Wolfsauge, Venushaar, Uzara und Hundszunge.\n");    
 AddDetail( ({ "wolfsauge", "venushaar", "uzara", "hundszunge" }),
    "Du kennst keines dieser Kreuter, vieleicht kann Dir die Apothekerin helfen.\n");    
 AddDetail( ({ "anzahl", "zahl" }),
    "Es sind zuviele zum zaehlen in diesem Garten.\n");    
  AddDetail( ({ "gesicht" }),
    "Du hast sicherlich eins irgendwo.\n");    
  AddDetail( ({ "geruch", "gerueche" }),
    "Versuchs mal mit riechen.\n");    
  AddDetail( ({ "fuesse", "fuessen" }),
    "Du stehst auf ihnen.\n");    
  AddDetail( ({ "voegel", "vogel" }),
    "Du siehst keine. Vielleicht sitzen sie in der Baumkrone, schau doch mal zum Himmel.\n");    
  AddDetail( ({ "melodie" }),
    "Versuchs mal mit lauschen.\n");  
  AddDetail( ({ "kiesweg", "weg" }),
    "Er besteht aus kleinen Kieselsteinen, die auf dem Boden zwischen den Beeten verteilt wurden.\n");    
  AddDetail( ({ "kies", "kiesel", "kieseln", "kieselsteinen", "kieselstein", "steinen", "steine", "steinchen" }),
    "Kleine Steinchen die aneinander gelegt den Weg ergeben auf dem Du stehst.\n");    
  AddDetail( ({ "blaetterwerk", "werk", "blaetter" }),
    "Die Baumkronen ueber Dir verhindert eine freie Sicht auf den Himmel.\n");    
  AddDetail( ({ "baumkronen", "kronen", "baumkrone", "krone" }),
    "Die Baumkronen, unter denen Aboriville auf den starken Aesten der grossen Eichen erbaut wurde, "+
    "sind riesig, sie geben nur teilweise die Sicht auf den Himmel frei.\n");  
  AddDetail( ({ "sicht", "sehen" }),
    "Nach was schaust Du denn.\n");  
  AddDetail( ({ "aboriville", "aborivilles" }),
    "Du befindest Dich hier in einem kleinen Garten in der Elfenstadt Aboriville.\n");  
 AddDetail( ({ "elfenstadt" }),
    "Du befindest Dich in Aboriville.\n");  
 AddDetail( ({ "aeste", "ast", "aesten" }),
    "Sie sind sehr stark und tragen die Last Aborivilles.\n");  
 AddDetail( ({ "eichen", "eiche" }),
    "Eichen sind sehr starke Baeume.\n");  
 AddDetail( ({ "baum", "baeume" }),
    "Du wirst doch wohl wissen was ein Baum ist, oder?\n");  
 AddDetail( ({ "last" }),
    "Die Last der Elfenstadt Aboriville wird von den starken Aesten alter Eichen getragen.\n");  
 AddDetail( ({ "liebe", "sorgfalt" }),
    "Der Garten wird mit Liebe und Sorgfalt gepflegt.\n");  
 AddDetail( ({ "farbe", "farben" }),
    "Der Garten beinhaltet Kraeuter in verschiedenen Farben.\n");  


  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.\n");

  AddSound( ({ "voegel", "zwitschern" }),
    "Die Voegel zwitschern eine liebliche Melodie.\n");

  AddSound( ({ "melodie" }),
    "Die Voegel zwitschern melodisch, aber Du kannst sie nicht verstehen.\n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Kraeutern.\n");
 
  AddSmell( ({ "geruch" }),
    "Der Geruch von Krautern steigt Dir in die Nase.\n");



AddExit( "norden", ELFEN_ROOM  + "aboriville_5e.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_7e.lpc" ); 



}

