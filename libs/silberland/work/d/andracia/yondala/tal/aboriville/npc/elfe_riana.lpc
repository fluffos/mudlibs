inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
		call_out("check",0);
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Riana, die Sanitaeterelfe");
  SetProp(P_LONG,
    "Du siehst eine grosse Elfin vor Dir, die Dich aus guetigen Augen anschaut. "
    "Sie traegt eine weisse Tunika um den Koeper gewickelt und hat eine weisse "
    "Haube auf dem Kopf.");
  SetProp(P_NAME, "Riana");
  SetProp(P_GENDER, FEMALE);
  AddId(({"sanitaetselfe", "sanitaeterelfe", "elfe", "elfin","riana"}));
  AddId(({"/nelfennorm"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
	// SetProp(P_DEFENDERS, (({"elfenwaechter"})));
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_HOLY}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 65000);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
//ueber init geloest.
//  SetProp(P_AGGRESSIVE,([P_ALIGN:([<=(-500):1])]));
//SetProp(P_AGGRESSIVE,([P_ALIGN:<=(-500):1]));
	
  SetProp(P_NOMAGIC,30);
//  SetProp(P_RESISTANCE_STRENGTHS , 
//    ([ DT_HOLY:      -1.0, DT_UNHOLY:    0.5, ]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Elfenbrueder, raecht meinen Tod!");
  SetProp(P_KILL_NAME, "Riana, die Sanitaeterelfe");
  SetProp(P_KILL_MSG, "Das heile ich nicht!");

  AddInfo(DEFAULT_INFO, "sagt: Darueber darf ich zu Euch nicht sprechen.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Riana will Deine Sachen nicht tragen.\n" }) );

/*  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );

  SUID;
  CLONEME(ELFEN_WEAPON "" );
  command("zuecke waffe");
  CLONEME(ELFEN_ARMOUR "" );
  command("trage alles");*/
}

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}




