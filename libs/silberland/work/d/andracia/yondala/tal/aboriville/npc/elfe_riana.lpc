// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("heilen", 0, TP);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


heilen()
{
	if(TP->QueryProp(P_HP)>TP->QueryProp(P_MAX_HP)-10) //wenn er also weniger als 10 aua hat
		{
			if (TP->id("Elfenspieler"))
				{
					tell_room(environment(TO), "Riana wuschelt "+TPN+" durchs Haar.\n", ({TP}));
					write("Riana wuschelt Dir durchs Haar.\n");
					}
			command("sag So schlimm seid Ihr doch gar nicht verletzt, "+TPN+"!");
			return 1;
			}

		
	if(TP->QueryProp(P_LEVEL)<6||TP->QueryProp(P_LEVEL)<8&&TP->id("Elfenspieler"))
		{
			TP->SetProp(P_HP, (TP->QueryProp(P_MAX_HP)));
			TP->SetProp(P_POISON, 0);
			TP->SetProp(P_BLIND, 0);
			TP->SetProp(P_DEAF, 0);
			TP->SetProp(P_FROG, 0);

			write("Die Sanitaeterelfe schiebt Dir ein Bonbon in den Mund und troestet Dich.\n");
			say("Die Sanitaeterelfe troestet "+TPN+".\n",TP);
			return 1;
			}
	if(TP->QueryProp(P_LEVEL)<10||TP->QueryProp(P_LEVEL)<12&&TP->id("Elfenspieler"))
			{
			write("Die Sanitaeterelfe nimmt Dich in den Arm und troestet Dich.\n");
			say("Die Sanitaeterelfe nimmt "+TPN+" troestend in den Arm.\n",TP);
			return 1;
			}		
else
	{
		if (TP->id("Elfenspieler"))
			{
			write("Die Sanitaeterelfe nimmt Dich in den Arm und troestet Dich.\n");
			say("Die Sanitaeterelfe nimmt "+TPN+" troestend in den Arm.\n",TP);
			return 1;
			}	
		if (TP->QueryProp(P_RACE)=="Zwerg")
			{
				write("Geh weg, Du stinkender, kleiner Zwerg.\n");
				return 1;
			}
	write ("Ihr seid doch schon so gross, "+TPN+", geht doch in die Gaststaette!\n");

	}
}

