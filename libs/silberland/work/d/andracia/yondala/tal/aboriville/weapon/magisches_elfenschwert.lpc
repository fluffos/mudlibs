//Sehr starkes Schwert, gehoert nicht in Spielerhaende!

inherit "/std/weapon";
//#include </sys/weapon.h>
#include <properties.h>
#include <combat.h>




void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WC, 250); 
  SetProp(P_WC_BONUS,
    (["Magiemeister":265]));   
  SetProp(P_WC_FIX, 100);
  SetProp(P_VALUE, 3000);
  SetProp(P_NR_HANDS, 1); 
  SetProp(P_QUALITY_DECAY, 0);
  AddAdjective("magisch");
//  SetProp(P_HIT_FUNC, this_object());  
  
  SetProp(P_WIELD_FUNC, this_object());
//  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) ); 
    
  SetProp(P_SHORT, "Ein magisches Schwert");
  SetProp(P_LONG, 
    "Du siehst ein Schwert, welches aus purer Magie besteht. Es "
	"pulsiert leicht und gibt ein schwaches Leuchten von sich.");
  SetProp(P_NAME, "Schwert");	
  SetProp(P_GENDER, NEUTER);  
  RemoveId(P_IDS);
  AddId( ({"schwert","waffe"}) );  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, ({DT_SLASH, WT_MAGIC}) );
  SetProp(P_SIZE, 130); 

 

}

int WieldFunc(object waffe)
{
    if(!interactive(this_player()))return 1;
    
	write( "Nur die aeltesten Elfen koennen diese maechtige Waffe zuecken.\n");
     return 0; 	
       
}

     


//Der Waffentyp soll sich bei jedem Schlag aendern
int HitFunc(object enemy)
{
	
    }