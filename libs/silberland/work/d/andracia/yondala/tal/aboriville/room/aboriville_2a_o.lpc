    "                                                                  \n"
);
        
  AddSound( DEFAULT_SMELL,
    "Es riecht nach dem Harz des Baumes in dem Du Dich befindest.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst leistes Stimmengemurmel.");

  AddSound( ({ "stimmengemurmel","gemurmel","stimmen" }),
    "Jemand scheint sich angeregt zu unterhalten.");
  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "baum","harz" }),
    "Das Harz des Baumes riecht leicht suesslich.");
AddExit( "suedosten", ELFEN_ROOM  + "aboriville_3b_o.lpc" ); 

AddCmd( ({ "sitze", "sitz","setze" }), "setzen" );
AddCmd( ({ "oeffne" }), "oeffnen" );

}


setzen(string str)
{
	if(str=="auf stuhl")
		{
			write("Du setzt Dich auf einen der Stuehle. Da das aber irgendwie ziemlich langweilig ist stehst Du wieder auf.\n");
			say(TPN+" setzt sich kurz auf einen der Stuehle und steht dann wieder auf.\n");
			return 1;
		}
		else
			{
				write("Worauf moechtest Du Dich setzen?\n");
				return 1;
			}
			
	}


int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str=="truhe")
		{
			write("Du ruettelst so fest Du kannst, aber Du bist Dir sicher, dass Du hier ohne "
			"Schluessel nicht weiterkommst.\n");
			say(TPN+" ruettelt erfolglos an der Truhe.\n");
			return 1;
		}

	return 0;
			
	}


