    "               |              |                                   \n"
    "               |              |               ,-Melina            \n"
    "               |              |-Mindala ______|-Belina            \n"
    "               |              | Felerian      |-Minda             \n" 
    "               |              |               '-Semione           \n" 
    "               |              |                                   \n"
    "               |              |               ,-Thorasa           \n"
    "               |-Linlala  ____|-Fenween_______|-Ranari            \n"
    "               | Mondol       | Alanel        '-Hiara             \n"
    "               |              |                                   \n"
    "               |              |               ,-Nalda             \n"
    " Lelo  ________|              '-Nela  ________|-Saladion          \n"
    " Alyna         |                Lorion        '-Alari             \n"
    "               |                                                  \n"
    "               |                                                  \n"
    "               |-Selo   ______,-Bimalandon ___,-Pholdorur         \n"
    "               | Zylia        | Linola        '-Tamosa            \n"
    "               |              |                                   \n"
    "               |              '-Lorion                            \n"
    "               |                Nela                              \n"
    "               |                              ,-Melina            \n"
    "               |              ,-Felerian _____|-Belina            \n"
    "               |              | Mindala       |-Minda             \n" 
    "               |              |               '-Semione           \n" 
    "               |              |                                   \n"
    "               |              |                                   \n"
    "               |              |-Neraen                            \n"
    "               |              |                                   \n" 
    "               |              |               ,-Sutana            \n"
    "               |              |-Nerael  ______|-Sowena            \n"
    "               |              | Fesieel       '-Enriu             \n"
    "               |              |                                   \n"
