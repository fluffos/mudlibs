inherit ELFEN_NPC+"elfenschueler_std.lpc";

int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Enrael";
  AddInfo( ({"enrael"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Telowen und Odania.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Pheralas und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Miranyl und Famione.",
    "sagt: ");
  AddInfo( ({"pheralas","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"miranyl","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","telowen"}),
    "Meines Vaters Name ist Telowen.",
    "sagt: ");
  AddInfo( ({"mutter","odania"}),
    "Meiner Mutter Name lautet Odania.",
    "sagt: ");
  AddInfo( ({"lutana", "schwester","schwestern"}),
    "Meine Schwester heisst Lutana.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "alriel"}),
    "Mein Bruder heisst Alriel.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe einen Bruder und eine Schwester.",
    "sagt: ");

	break;}
	case 1:{name="Enriu";
  AddInfo( ({"enriu"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Linlaen.",
    "sagt: ");
  AddInfo( ({"mondol","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","linlaen"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","fesieel"}),
    "Meines Vaters Name ist Fesiell.",
    "sagt: ");
  AddInfo( ({"mutter","nerael"}),
    "Meiner Mutter Name lautet Nerael.",
    "sagt: ");
  AddInfo( ({"sutana", "schwester","schwestern"}),
    "Meine Schwestern heissen Sutana und Sowena.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "eriu"}),
    "Ich habe keinen Bruder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe zwei Schwestern.",
    "sagt: ");
	break;}
	case 2:{name="Imalaian";
		  AddInfo( ({"imalaian",""}),
    "Das bin ich.",
    "sagt: ");
 AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Riaona und Linel.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Famione, Golain, Pheralas und Miranyl.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Golain und Pheralas.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Famione und Miranyl.",
    "sagt: ");
  AddInfo( ({"golain","pheralas"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"famione","miranyl"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","linel"}),
