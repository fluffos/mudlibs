    "sagt: ");
  AddInfo( ({"brueder","bruder", "imalien"}),
    "Ich habe keinen Bruder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich zwei Schwestern.",
    "sagt: ");	
  break;}
	
}	
	

SetProp(P_NAME, name);
						SetProp(P_SHORT, name+" der Elfenjunge");
  SetProp(P_LONG,
    "Du siehst einen Elfenjungen vor Dir, welcher schon zur Schule geht und Dich aus klugen Augen "
    "ruhig betrachtet.");

  SetProp(P_GENDER, MALE);
  AddId(({"junge", "elfenjunge", "elf", "elfenkind", "kind","\nelfenschueler", "/nelfenkind", lower_case(name)}));
  create_default_npc(5);
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 50000);
  AddInfo( ({"name","namen"}),
    "Mein Name ist "+name+".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
