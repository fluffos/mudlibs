// 23.01.2012 - Yondala@SilberLand: Funkltionell ueberarbeitet  
// Idee fuer spaeter: Buecher lesbar machen mit Maerchen





#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>

int sitztwer=0;
string name;
void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In der Kuschelecke");
  SetProp(P_INT_LONG, 
  		"Das hier scheint eine kleine Kuschelecke zu sein. Es liegen "
  		"ein paar Decken und Kissen auf etwas weicheren Matten als "
  		"im Westen herum. Ausserdem steht ein kleines Regal mit "
  		"Kinderbuechern an der Wand und davor schaukelt sachte ein Schaukelstuhl.");
AddItem(ELFEN_NPC + "kigaelfe5.lpc",REFRESH_DESTRUCT);
AddItem(ELFEN_NPC + "gluehwuermchen.lpc",REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
 AddDetail( ({ "boden" }),
    "Wie alles in Aboriville ist auch hier der Boden aus Holz. Auf ihm liegen "
    "einige dicke Matten und darauf ein paar grosse Kissen und kuschelige Decken.");    
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "matten", "matte" }),
    "Die Matten bestehen aus dunkelgruenem, weichen Moos. Hier koennen sich die "
    "Kinder ausruhen, wenn sie moegen. Auf den Matten liegen mehrere weiche Kissen und "
    "ein paar kuschelige Decken");    
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus hellem Holz. An einer Wand ist die Tuer, durch die Du gekommen bist, an der Nordwand steht ein kleines Regal.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "decke" }),
    "Die hohe, helle Decke ist aus Holz. Ein paar kleine Gluehwuermchen schweben darunter.");    
  AddDetail( ({ "gluehwuermchen" }),
    "Die Gluehwuermchen spenden dem Raum zusaetzliches Licht.");    
  AddDetail( ({ "licht" }),
    "Durch die Tuer faellt ein bisschen Sonnenlicht und auch die Gluehwuermchen unter der "
    "Decke erhellen den Raum.");    
  AddDetail( ({ "sonnenlicht","sonne" }),
    "Das Licht der Sonne erhaelt den Raum.");    
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer hast Du die Kuschelecke betreten und kannst sie auch wieder verlassen. Sie fuehrt nach Westen.");    
  AddDetail( ({ "raum","kuschelecke" }),
    "Du befindest Dich in der Kuschelecke des Kindergartens von Aboriville. Hier "
    "kommen die Kinder nach aufregedem spielen und herumtollen zur Ruhe.");    
  AddDetail( ({ "ruhe" }),
    "Die braucht jeder ab und an.");    
  AddDetail( ({ "kissen" }),
    "Die grossen Kissen sind mit etwas sehr weichen gefuellt und laden geradezu "
    "dazu ein sich hineinzukuscheln.");    
  AddDetail( ({ "fuellung" }),
    "Die Kissen sind scheinbar mit weichgeklopftem Zwergenhaar gefuellt.");    
  AddDetail( ({ "zwergenhaar" }),
    "Zwergenhaar ist normalerweise hart und borstig, dieses hier wurde aber "
    "solange bearbeitet, bis es kuschelweich wurde.");    
  AddDetail( ({ "moos" }),
    "Das weiche Moos ist extra fuer diesen Raum gewachsen, damit die "
    "Kinder sich darauf ausruehen koennen. Es ist warm und trocken.");    
  AddDetail( ({ "ecke" }),
    "Du befindest Dich in der oestlichen Ecke des Kindergartens.");    
  AddDetail( ({ "regal" }),
    "Das Regal ist aus der Wand heraus gewachsen als die Kindergaertnerin die "
    "Wand darum gebeten hat. Es bietet genuegend Platz fuer die Buecher der Kinder.");    
  AddDetail( ({ "platz" }),
    "Es ist genug Platz da.");    
  AddDetail( ({ "nordwand" }),
    "Aus der Nordwand ist ein kleines Regal gewachsen.");    
  AddDetail( ({ "buecher", "kinderbuecher", "buch", "kinderbuch" }),
    "Du siehst einige Bilderbuecher, aber die meisten Buecher beinhalten offensichtlich Geschichten.");    
  AddDetail( ({ "schaukelstuhl", "stuhl" }),
    "Der Schaukelstuhl ist aus Holz gewachsen und schwingt sacht hin und her.");    
  AddDetail( ({ "bilderbuecher", "bilderbuch" }),
    "Du schaust Dir ein paar der Bilderbuecher an, findest sie dann aber doch zu kindisch.");    
  AddDetail( ({ "geschichten", "geschichte" }),
    "Du koenntest versuchen sie zu lesen.");    
  AddDetail( ({ "schrift" }),
    "Du beherrscht sie nicht.");    
  		
  		
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "geschichten", "schrift","geschichte" }),
    "Leider sind die Geschichten in alter elfischer Schrift geschrieben und Du kannst sie nicht lesen.");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst so gut wie nichts.");

  AddSound( ({ "nichts" }),
    "\n\n");

 	AddSmell( DEFAULT_SMELL,
	"Es riecht hier leicht nach Vanille."); 

  AddSmell( ({ "vanille" }),
    "Es riecht entspannend und angenehm.");



AddExit( "westen", ELFEN_ROOM  + "aboriville_2f.lpc" ); 



	AddCmd(({"kuschel", "kuschle"}), "kuscheln"); 
	AddCmd(({"schaukel", "schaukle"}), "schaukeln"); 
	AddCmd(({"setz", "sitze", "setze", "sitz"}), "sitzenCmd"); 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 


}


int kuscheln(string str)
{
	notify_fail( "Worein moechtest Du Dich kuscheln?\n" );
	if (str =="in decke"||str =="in kissen"||str =="in decken"||str=="ins kissen")
		{	
			write("Du kuschelst Dich wild durch Kissen und Decken. Da Du nicht muede bist stehst Du aber bald wieder auf.\n");
			say(TPN+" kuschelt sich in die Decken und Kissen.\n", TP);
			return 1;
		}
	return 0;
}

int schaukeln(string str)
{
	if(name!=TPN)
		{
			write ("Du sitzt nicht im Schaukelstuhl.\n");
			return 1;
			}
			
	notify_fail( "Womit moechtest schaukeln?\n" );
	if (str =="mit schaukelstuhl"||str =="mit stuhl"||!str)
		{	
			write("Du schaukelst entspannt im Schaukelstuhl vor und zurueck.\n");
			say(TPN+" schaukelt entspannt im Schaukelstuhl vor und zurueck.\n", TP);
			return 1;
		}
}



int sitzenCmd(string str)
  {  	notify_fail( "Worauf moechtest Du sitzen?\n" );
  	if (str!="auf schaukelstuhl"&&str!="in schaukelstuhl"&&str!="in stuhl"&&str!="auf stuhl")
  		return 0;
		if (this_player()->QueryProp(P_NOMOVE)!=0)
			{write ("Du sitzt doch bereits!\n");
			return 1;}
	
	else //also wenn er noch nicht sitzt
		{
			if(sitztwer==0)
				{
					write ("Du setzt Dich in den Schaukelstuhl.\n");
					say (TPN+" setzt sich in den Schaukelstuhl.\n", TP);
					TP->SetProp(P_NOMOVE, "Du sitzt auf dem Schaukelstuhl und solltest erst aufstehen.\n");
					sitztwer =1;
					name=TPN;
					AddDetail( ({ "schaukelstuhl" }),
    					"Der Schaukelstuhl ist aus Holz gewachsen. "+TPN+" sitzt darin.");    

					return 1;
					}
			if(sitztwer==1)
				{
					write ("Auf dem Schaukelstuhl sitzt doch schon "+capitalize(name)+".\n");
					return 1;
				}
			
		}
		return 0;
}




int aufstehenCmd(string str)
{  	
  notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
  if (str=="auf"||!str)
  	{
      if (this_player()->QueryProp(P_NOMOVE)!="Du sitzt auf dem Schaukelstuhl und solltest erst aufstehen.\n")
	    {
		  write ("Du sitzt doch gar nicht!\n");
	      return 1;
		  }
	
	else 
		{
		  write ("Du stehst seufzend aus dem gemuetlichen Schaukelstuhl auf.\n");
		  say (TPN+" steht seufzend aus dem gemuetlichen Schaukelstuhl auf.\n", TP);
  		  TP->SetProp(P_NOMOVE, 0);
    	  AddDetail( ({ "schaukelstuhl" }),
    		"Der Schaukelstuhl ist aus Holz gewachsen und schwingt sacht hin und her.");    
		  sitztwer=0;
		  name="";		
		  return 1;
		}
	}
 return 0;
}
