inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schmetterling");
  SetProp(P_LONG,
    "Ein Schmetterling mit gruen-blauen Fluegeln");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId(({"schmetterling", "insekt", "falter"})); //ansprech-namen
  CLONEME(ELFEN_OBJ "schmetterlingsfluegel" );
  create_default_npc(3);  /* 3=Stufe */
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "insekt"); // Rasse
  SetProp(P_SIZE, 5); // in centimeter
  SetProp(P_WEIGHT, 10); // in gramm
  SetProp(P_ALIGN, 0); // gesinnung -1000 bis +1000
  SetProp(P_MAX_HANDS, 2); // anz. Hände
  SetProp(P_HEAL,0); // HP-Rega durch "iß Leiche"
  SetProp(P_AGGRESSIVE,0); // Agressivitäts-Level
  SetProp(P_WIMPY, 0); // Flucht-Grenze
  SetProp(P_NOMAGIC,0); // Magie-ressi 0-100
//  SetProp(P_RESISTANCE_STRENGTHS , //  Ressis -1 bis +1

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt hinaus");
  SetProp(P_MMSGIN, "kommt aus einem schwarzen Loch");
  SetProp(P_MMSGOUT, "wird in ein schwarzes Loch gezogen");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 ); // 0=Leiche; 1=keine Leiche
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");  // Sterbe-Text
  SetProp(P_KILL_NAME, "Ein niedlicher Schmetterling"); // ELFEN_NPC-Name für den killer
//  SetProp(P_KILL_MSG, "Du hattest keine Chance!"); // Mord-Text


  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  //wenn gefragt wird

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schmetterling laesst es wieder fallen.\n" }) );


}
