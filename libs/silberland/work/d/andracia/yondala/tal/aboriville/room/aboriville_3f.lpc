#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Sanitaetstalan");
  SetProp(P_INT_LONG, 
  		"Du stehst in einem hellen, freundlichen Talan. Hier gibt es relativ wenig "
  		"Einrichtung, lediglich einen hoelzernen Schrank, eine kleine Liege und "
  		"einen Hocker. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
AddItem(ELFEN_NPC + "elfe_riana.lpc",REFRESH_DESTRUCT); 		
  AddDetail( ({ "talan" }),
    "Du stehst in einem Talan wie er typisch ist fuer die Elfenstadt, er ist "
    "allerdings nur spaerlich eingerichtet, erfuellt aber sicher seinen Zweck.");    
  AddDetail( ({ "elfenstadt","stadt","aboriville" }),
    "Du befindest Dich in der Elfenstadt 'Aboriville'.");    
  AddDetail( ({ "zweck" }),
    "Der Zweck des Sanitaetstalans ist es, Kinder, die sich beim Ueben ihrer Kampffertigkeiten verletzen.");    
  AddDetail( ({ "kinder", "kind", "kindes" }),
    "Im Allgemeinen kommen hier nur Elfenkinder her, aber auch andere Kinder werden hier versorgt.");    
  AddDetail( ({ "elfenkinder" }),
    "Die Elfen sind sehr gute Kaempfer und die Elfenkinder lernen in diesem "
    "Kindergarten die Faehigkeiten, die sie fuer das ewige Leben brauchen.");    
  AddDetail( ({ "faehigkeiten", "kaempfen", "teamgeist", "allgemeinwissen" }),
    "Die Elfenkinder lernen hier Faehigkeiten wie Kaempfen, aber auch Teamgeist und Allgemeinwissen kommen nicht zu kurz.");    
  AddDetail( ({ "einrichtung", "einrichtungsgegenstaende" }),
    "Du siehst einen Schrank, einen Hocker und eine Liege.");    
  AddDetail( ({ "schrank" }),
    "Der Schrank ist aus Holz und scheint aus dem Boden gewachsen zu sein und "
    "dort ist er auch immernoch mit seinen Wurzeln fest verankert.");    
  AddDetail( ({ "holz" }),
    "In der Elfenstadt ist fast alles aus Holz, welches die Elfen ihren Beduerfnissen entsprechend wachsen lassen.");    
  AddDetail( ({ "wurzeln" }),
    "Die Wurzeln halten die Einrichtungsgegenstaende an ihren Platz und machen "
    "sie flexibel genug um weiterhin so zu wachsen wie die Elfen es benoetigen.");    
  AddDetail( ({ "platz" }),
    "Alles ist an seinem Platz.");    
  AddDetail( ({ "hocker" }),
    "Der kleine Hocker ist aus dem hoelzernen Boden gewachsen. Er dient der "
    "Sanitaetselfe zum sitzen, falls die Behandlung eines Kindes mal etwas "
    "laenger dauert.");    
  AddDetail( ({ "behandlung" }),
    "Wenn ein verletztes Kind herkommt wird es geheilt.");    
  AddDetail( ({ "liege" }),
    "Auf der Liege liegt zurzeit niemand. Sie ist auch wirklich nur fuer "
    "sehr schwer verletzte Kinder da.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht wie in der ganzen Stadt aus eng miteinander verflochtenen "
    "Aesten, die so dicht sind, dass man nirgends hindurchblicken kann.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Elfenstadt befindet sich in den Aesten starker Baueme, die nur dafuer gewachsen sind.");    
  AddDetail( ({ "baeume" }),
    "Die Baeume, auf denen sich Aboriville befindet sind hier zu einem festen Talan verwoben.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen aus den verwobenen Aesten der Baeume auf welchen die ganze Stadt errichtet wurde. Vor einer Wand steht ein Schrank.");    
  AddDetail( ({ "decke" }),
    "Die Decke in diesem Talan besteht aus den verwobenen Aesten der Baeume auf denen die Stadt gewachsen ist. Hier und dort blinzelt die Sonne durch die gruenen Blaetter.");    
  AddDetail( ({ "blaetter" }),
    "Die Aeste an der Decke sind mit vielen, hellgruenen Blaettern bestueckt.");    
  AddDetail( ({ "sonne" }),
    "Die Sonne blinzelt durch die duenne Decke des Talans.");    
  AddDetail( ({ "kindergarten" }),
    "Der ist draussen.");    
  AddDetail( ({ "natur" }),
    "Du befindest Dich mittendrin.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein paar Voegel zwitschern und ab und zu ein paar Kinder.");

  AddSound( ({ "kinder" }),
    "Die Kinder lachen, weinen, kreischen und quietschen im Kindergarten.");
  AddSound( ({ "voegel" }),
    "Die Voegel zwitschern vergnuegt vor sich hin. Sehen kannst Du aber keine.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Natur, aber auch ein kleines bisschen nach Medizin.");
  AddSmell( ({ "natur" }),
    "Du befindest Dich mittendrin.");
  AddSmell( ({ "medizin" }),
    "Darueber wunderst Du Dich nicht, denn Du bist ja im Sanitaetstalan.");



AddExit( "norden", ELFEN_ROOM  + "aboriville_2f.lpc" ); 
  AddCmd( ({ "oeffne", "oeffne" }), "oeffnen" );


}

int oeffnen(string str )
{
  notify_fail( "Was moechtest Du oeffnen?\n" );
  if( str == "schrank", "den schrank" )
  {
    write("Du ruettelst an der Schranktuer, ploetzlich loest sich ein Ast aus "+
    			"der Wand und haut Dir auf die Finger.\n");
    say( TPN+" versucht einen Schrank zu oeffnen.\n",TP);
		TP->do_damage(3,"Ein Schrank");
    return 1;
  }
  return 0;
}
