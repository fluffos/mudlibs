	else
	  return 0;	
 }


string lianen()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return       "Die Lianen bilden einen natuerlichen Vorhang um die Apotheke vom Wohnraum abzutrennen.\n";    
	else
	  return 	    "Die Lianen bilden einen natuerlichen Vorhang.\n";	
 }


string wohnraum()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "Der Wohnraum liegt oestlich von hier. Du kannst ihn betreten.\n";    
	else
	  return 0;	
 }


string tuer()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Die Tuer an der Westwand fuehrt ins Freie.\n";    
	else
	  return 0;	
 }


string sessel()
{
	if (TPN==sitzer1)
		{ return   	"Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
   			 "und elastisch aus.\n"
    			"Auf dem ersten Sessel sitzt Du.\n"
    			"Auf dem zweiten Sessel sitzt "+sitzer2+".\n";}    

	else if (TPN==sitzer2)
		{ return   	"Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
   			 "und elastisch aus.\n"
    			"Auf dem ersten Sessel sitzt "+sitzer1+".\n"
    			"Auf dem zweiten Sessel sitzt Du.\n";}    

else if (sitzer1==sitzer2)
	{return "Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
   			 "und elastisch aus.\n"
    			"Beide Sessel sind unbesetzt.\n";}
else
	{return "Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
    						"und elastisch aus.\n"
    						"Auf dem ersten Sessel sitzt "+sitzer1+".\n"
    						"Auf dem zweiten Sessel sitzt "+sitzer2+".\n";   
    						}
}



int brisifragen()
{write("Frag doch Brisi!\n");
	return 1;}

sitzenCmd(string str)
  { 
  	notify_fail( "Worauf moechtest Du sitzen?\n" );
		if (str!="auf sessel") 	return 0;

		//sitzt derjenige schon?
		if (this_player()->QueryProp(P_NOMOVE)!=0)
			{
				write ("Du sitzt doch bereits!\n");
				return 1;
				}

		//wenn er noch nicht sitzt, also p_nomove = 0
		//schauen ob noch ein freier Sessel da ist.
		if (freiesessel<=0)
			{
				write("Die Sessel sind schon alle besetzt.\n");
				return 1;
				}
		
		//wenn also noch ein Sessel frei ist:		


		else 
			{
				write ("Du setzt Dich auf einen federnden Sessel.\n");
				say (TPN+" setzt sich auf einen federnden Sessel.\n", TP);
				TP->SetProp(P_NOMOVE, "Dazu musst Du diesen bequemen Sessel erst verlassen.\n");
				if (sessel1==1)
					{
						sessel2=1;
						sitzer2=TPN;
					}
				else
					{
						sessel1=1;
						sitzer1=TPN;
						}
				
				freiesessel-=1;
/*  			AddDetail( ({ "sessel" }),
    			"Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
    			"und elastisch aus.\n"
    			"Auf dem ersten Sessel sitzt "+sitzer1+".\n"
    			"Auf dem zweiten Sessel sitzt "+sitzer2+".");   */ 

				return 1;
				}
			
}



int aufstehenCmd(string str)
{ 
  notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
  if (str!="auf"&&str!=""&&str!="wieder auf")return 0;
  if (this_player()->QueryProp(P_NOMOVE)==0)
  {
	write ("Du sitzt doch gar nicht!\n");
	return 1;
	}
  write ("Schweren Herzens erhebst Du Dich aus dem bequemen Sessel.\n");
	say (TPN+" erhebt sich aus einem Sessel.\n", TP);
	freiesessel+=1;
  TP->SetProp(P_NOMOVE, 0);
	if(sitzer1==TPN)
	{
	sitzer1="niemand";
	sessel1=0;
	}
	if(sitzer2==TPN)
	{
	sitzer2="niemand";
	sessel2=0;
	}
	/*
					if(sitzer1==sitzer2)
						{  
							AddDetail( ({ "sessel" }),
    						"Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
    						"und elastisch aus.\n"
  							"Beide Sessel sind unbesetzt.");  
  					}
  
  				else
  					{  
  						AddDetail( ({ "sessel" }),
						    "Die Sessel scheinen nur aus ineinander verwachsenen Ranken zu bestehen. Sie sehen bequem "
    						"und elastisch aus.\n"
    						"Auf dem ersten Sessel sitzt "+sitzer1+".\n"
    						"Auf dem zweiten Sessel sitzt "+sitzer2+".");    
						}*/
				  

		return 1;
			
}



string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
      result = BS("Du befindest Dich in einer kleinen Apotheke. Rundherum besteht alles aus Holz und Du hast "
    "den Eindruck, dass dieser Raum so gewachsen ist. Die Waende sind voller Regale mit Dosen, "
    "Glaesern und Flaschen. Ausserdem gibt es einen Tresen, zwei gemuetlich wirkende Sessel und "
    "einen kleinen Tisch. Im Osten siehst Du noch eine Tuer.\n");
    }
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}


string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;

  if( viewer->id("Elfenspieler") ||
      viewer->QueryProp(P_GUILD) == "Naturvolk" ||
      present("\nelfenkraut", viewer) )
    {
      result = BS("In einer kleinen Apotheke\n") ;
    } else {
      result = QueryProp(P_INT_SHORT);
    }
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}