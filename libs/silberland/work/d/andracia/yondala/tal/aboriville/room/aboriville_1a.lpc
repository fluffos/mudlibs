 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "An der Nordwand und an der Westwand sind hohe, hoelzerne Regale gewachsen.\n";    
	else
	  return 	"Die Westwand besteht wie alles hier aus Holz und Blaettern.\n";	
 }

