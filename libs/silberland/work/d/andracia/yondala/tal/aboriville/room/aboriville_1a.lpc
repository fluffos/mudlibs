#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int freiesessel =2;
int sessel1=0;
int sessel2=0;
string sitzer1 = "niemand";
string sitzer2 = "niemand";
void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer gruenen Hoehle\n" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einer Hoehle aus Blaettern und Holz. Viel kannst Du nicht erkennen. "
    "Die Waende bestehen aus Holz, lediglich die Ost- und die Westwand unterscheiden sich "
    "etwas. Ausserdem sehen einige Ranken so aus als wuerden sie natuerliche Sessel bilden." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(ELFEN_NPC + "elfe_brisi.lpc",REFRESH_DESTRUCT);

  AddSpecialDetail( ({ "apotheke", "raum" }), "apotheke" );
  AddDetail( ({ "holz" }),
    "Das Holz ist dunkel und sieht aus als waere es lebendig und wie an einem Stueck, denn Du "
    "siehst keine Ritzen oder Fugen. Es scheint, als waere das Holz genauso in dieser Form gewachsen.");    
  AddDetail( ({ "stueck","eindruck" }),
    "Du hast den Eindruck, als sei das Holz so am Stueck nur fuer diese Apotheke so gewachsen.");    
  AddSpecialDetail( ({ "sessel"}), "sessel" );




  AddSpecialDetail( ({ "waende","wand"  }), "wand" );
  AddSpecialDetail( ({ "suedwand", "sueden"  }), "suedwand" );
  AddSpecialDetail( ({ "ostwand", "osten"  }), "ostwand" );
  AddSpecialDetail( ({ "tresen"  }), "tresen" );
  AddSpecialDetail( ({ "nordwand", "norden"  }), "nordwand" );
  AddSpecialDetail( ({ "westwand", "westen"  }), "westwand" );
  AddSpecialDetail( ({ "gefaesse","gefaessen","dosen","glaeser","flaschen"  }), "gefaesse" );
  AddSpecialDetail( ({ "medizin"  }), "medizin" );
  AddSpecialDetail( ({ "kraeuter"  }), "kraeuter" );
  AddSpecialDetail( ({ "cremes", "creme", "salben", "salbe"  }), "creme" );
  AddSpecialDetail( ({ "tisch"  }), "tisch" );
  AddSpecialDetail( ({ "sessel"  }), "sessel" );
  AddSpecialDetail( ({ "regale", "regal"  }), "regale" );
  AddSpecialDetail( ({ "brisi"  }), "brisi" );
  AddSpecialDetail( ({ "lianen", "liane"  }), "lianen" );
  AddSpecialDetail( ({ "wohnraum"  }), "wohnraum" );
  AddSpecialDetail( ({ "tuer"  }), "tuer" );
  AddDetail( ({ "seite", "seiten" }),
    "Alles hat zwei Seiten.");    
  AddDetail( ({ "unebenheiten" }),
    "Die Unebenheiten im Holz scheinen natuerlich zu sein.");    
  AddDetail( ({ "boden" }),
    "Der Boden ist aus glattgelaufenen Holz, welches nur wenige Unebenheiten "
    "aufweisst.");    
  AddDetail( ({ "tafel" }),
    "Die Tafel scheint als einziges hier nicht mit dem Raum verbunden zu sein. Du kannst sie lesen.");    
  AddDetail( ({ "decke" }),
    "Die Decke ueber Dir ist rund und besteht aus Holz. Ueberall funkeln dort kleine "
    "Gluehwuermchen.");    
  AddDetail( ({ "ranken" }),
    "Die Ranken sind gruen und sehen gesund und lebendig aus. Zwischen ihnen siehst Du immer "
    "wieder vereinzelte Blueten.");    
  AddDetail( ({ "blueten", "weiss" }),
    "Die Blueten leuchten in reinem Weiss und duften himmlisch.");    
  AddDetail( ({ "gluehwuermchen", "licht" }),
    "Die Gluehwuermchen tauchen diesen Raum in angenehm warmes Licht.");    
  AddDetail( ({ "vorhang" }),
    "Der Vorhang besteht aus gruenen Lianen. Er ist halb geoeffnet und hindert Dich sicherlich "
    "nicht daran nach hinten durchzugehen.");    
  AddDetail( ({ "freie" }),
    "Dort, wo Du herkommst.");    
  AddDetail( ({ "westwand" }),
    "Die Westwand besteht aus Holz.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "ausgang" }),
    "Der befindet sich suedlich von Dir.");    
  AddDetail( ({ "aeste" }),
    "Um Dich herum besteht alles aus dem Holz der Aeste der Baeume.");    


  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt","rest" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste um Dich herum haben sich hier zu einer Hoehle verdichtet.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter um Dich herum sind sehr dicht und bilden ein dichtes Dach.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht wie auch im Rest der ganzen Stadt aus Holz.");    
   AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "kronen", "krone" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer aus Aesten und Blaettern gewachsenen Hoehle.");

  AddReadDetail( ({ "tafel","dienstleistungen" }),
    " ____________________________\n"
    "|                            |\n"
    "|*                          *|\n"
    "|                            |\n"
    "| Dienstleistung      Kosten |\n"
    "| Entgiften              100 |\n"
    "| Entfroschen            400 |\n"
//    "| Entraupen              800 |\n"
    "| Entblinden             200 |\n"
    "| Enttauben              150 |\n"
//    "| Ganzkoerperheilung   10000 |\n"
    "|                            |\n"
    "|*                          *|\n"
    "|____________________________|");
    
  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst lediglich das Rauschen der Blaetter.");

  AddSound( ({ "rauschen","blaetter" }),
    "Du hoerst die Blaetter Aborivilles rauschen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blueten.");
 
  AddSmell( ({ "blueten" }),
    "Die Blueten duften himmlisch.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");



AddExit( "osten", ELFEN_ROOM  + "aboriville_1b.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_2a.lpc" ); 



	AddCmd(({"setz", "sitze", "setze", "sitz"}), "sitzenCmd"); 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
	AddCmd(({"entgifte","entgiften","entfroschen", "entfrosche", "entraupen", "entraupe", 
					 "entblinde", "entblind" "enttaube"}), "brisifragen"); 

}


//Hier die SpecialFetails fuer Elfen/Naturvolk/Krautbesitzer und Rest
string apotheke()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return    "Du befindest Dich in der beruehmten Apotheke von Aboriville.\n";    
	else
	  return 0;	
 }

string wand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return        "Die Waende rundherum bestehen aus dunklem Holz. An ihnen befinden sich Regale mit allerhand "
    "Gefaessen darauf. In der Suedwand ist die Tuer, durch die Du gekommen bist. In der Ostwand "
    "ist eine weitere Tuer.\n";    
    
	else
	  return 	"Die Waende hier bestehen aus Holz und Blaettern. Nach Sueden und Osten kannst Du die Hoehle verlassen.\n";	
 }

string suedwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return        "An der Suedwand ist lediglich die Tuer, durch die Du gekommen bist.\n";    
	else
	  return 	"Dort befindet sich der Ausgang.\n";	
 }

string ostwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "An der rechten Seite der Ostwand ist eine Tuer, die durch einen Vorhang halb verdeckt ist. "
    "An der linken Seite befindet sich ein Tresen.\n";    
	else
	  return 	"Vor der Ostwand haengen einige Lianen und bilden einen natuerlichen Vorhang. Es scheint als koenntest Du dort tiefer in die Hoehle gelangen.\n";	
 }

string tresen()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return        "Der Tresen scheint direkt aus dem Boden gewachsen zu sein. Eine kleine Tafel steht darauf.\n";    
	else
	  return 0;	
 }

string nordwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "An der Nordwand und an der Westwand sind hohe, hoelzerne Regale gewachsen.\n";    
	else
	  return 	"Die Nordwand besteht wie alles hier aus Holz und Blaettern.\n";	
 }
