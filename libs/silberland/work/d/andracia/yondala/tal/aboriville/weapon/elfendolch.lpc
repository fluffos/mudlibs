#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein elfischer Dolch");
  SetProp(P_LONG,
    "Du siehst einen Dolch, welchen ein wahrer Meister hergestellt haben muss. Er ist glatt "
    "poliert und scheint sehr robust und auch sehr scharf zu sein." );

  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "elfendolch", "messer", "elfenmesser"}) );
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_TITANIUM );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
                            
  SetProp(P_VALUE, 2200);

  SetProp(P_QUALITY_DECAY, 200);
  
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
