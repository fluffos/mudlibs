#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg" );
  SetProp( P_INT_LONG,
    "Westen Kreuzung, Osten Ostzwerge. hochklettern in Elfenstadt" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

 AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );



// AddExit( "osten", ELFEN_ROOM +"elfenweg_7.lpc" ); 
 AddExit("westen", ELFEN_ROOM +"elfenweg_5.lpc");
// AddExit("sueden", ELFEN_ROOM +"kobolde.lpc");
 
 }





kletternCmd(string str )
{
  notify_fail( "Wo willst Du raufklettern?\n" );
  if( str == "hoch"||str == "rauf"||str == "in stadt"||str == "in elfenstadt"||str == "nach oben"||str == "auf baum" )

	if(present("elfenkraut",  TP))

  {  	
  	TP->move(ELFEN_ROOM  + "aboriville_8n.lpc", M_GO,
  	"","klettert nach oben","kommt herauf geklettert");
		write("Du kletterst nach oben.\n");
    say( TPN+" klettert nach oben.\n");
    return 1;

  }
  
  else 
  	{write("Nichts dabei!\n");
  return 1;}
  
  return 0;
}