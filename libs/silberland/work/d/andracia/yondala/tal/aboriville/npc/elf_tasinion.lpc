//Tasinio ist der aelteste Kaempfer

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"elf_aelteste_std.lpc";


void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenkind")||
   	        this_player()->id("ayala")||
   	        this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tasinion, der aelteste Krieger");
  SetProp(P_LONG,
    "Du siehst einen grossen, athletischen Elfen vor Dir. Sein braunes Haar ist an den Schlaefen "
    "schon leicht ergraut, seine Haut mit vielen Narben uebersaeht. Er scheint ein sehr "
    "erfahrener Kaempfer zu sein, dennoch schaut er aus guetigen und weisen Augen in die Welt." );
  SetProp(P_NAME, "Tasinion");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"tasinion", "elf", "aeltester", "krieger","Magiemeister"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinem Schwert",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, 800);

  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
  SetProp(P_XP, QueryProp(P_XP)+100); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 1.0, DT_TERROR: 0.0,
      DT_HOLY:      1.0, DT_UNHOLY:    1.0, DT_MAGIC:  1.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,50);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst %s nicht entkommen!");
  SetProp(P_KILL_NAME, "Tasinion, der aelteste Krieger");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Yondala allein mag uns diese Weisheit vermitteln.\n");
  


  AddInfo( ({"tasinion", "aeltester kaempfer"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 

     
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,650,
	        "Tasinion schiesst einen heiligen Pfeil auf Dich.\n",
	        "Tasinion schiesst einen heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(4,780,
	         "Tasinion schiesst einen starken heiligen Pfeil auf Dich.\n",
	         "Tasinion schiesst einen starken heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,1250,
	         "Tasinion schiesst einen brennenden Pfeil auf Dich.\n",
	         "Tasinion schiesst einen brennenden Pfeil auf @WEN.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,170,
	         "Tasinion schiesst einen vergifteten Pfeil auf Dich.\n",
	         "Tasinion schiesst einen vergifteten Pfeil auf @WEN.\n",
	         ({DT_FIRE}),"gift", ([SP_SHOW_DAMAGE:1]) );








/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
  SUID;
  CLONEME(ELFEN_WEAPON "magisches_elfenschwert" );
  command("zuecke waffe"); 

}
