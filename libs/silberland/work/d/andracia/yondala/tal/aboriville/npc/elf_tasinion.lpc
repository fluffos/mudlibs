void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(3));
}


void InformDefend(object enemy)
{
 Kill(enemy);
}	

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
	 present("schwert",TO)->remove();
   ::die();		
}