#include "../def.h"
//inherit "std/room";
inherit ELFEN_ROOM  + "aboriville_std.lpc";

#include <properties.h>
#include <language.h>
int burg = 0;
object obj;
object wipper1;
object wipper2;
string name1="\nkeinerda";
string name2="\nkeinerda";
int sitztwer;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Sandkasten");
  SetProp(P_INT_LONG, 
  		"Du stehst mitten in einem grossen Sandkasten in dem sich die Kinder des "
  		"Kindergartens vergnuegen koennen. Ein paar Foermchen und Schaufeln liegen "
  		"im Sand verteilt, an der Seite steht eine Wippe.");
AddItem(ELFEN_NPC + "kigaelfe6.lpc",REFRESH_DESTRUCT);  		
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );
  		
  AddDetail( ({ "boden" }),
    "Auf dem Boden liegt hier eine dicke Sandschicht, denn Du bist ja schliesslich im Sandkasten des Kindergartens.");
  AddDetail( ({ "sandschicht", "schicht" }),
    "Mit dem vielen Sand hier koennen die Kinder ihrer Fantasy freien Lauf lassen. ");
  AddDetail( ({ "kinder","elfenkinder" }),
    "Du bist ihnen sicher schon begegnet.");    
  AddDetail( ({ "kindergarten", "elfenkindergarten","platz" }),
    "Du befindest Dich hier im Kindergarten von Aboriville. Hier kommen alle "
    "Elfenkinder zu beginn ihres Lebens hin. Manchmal werden auch Kinder von "
    "anderen Rassen aufgenommen.");    
  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen in Andracia und manchmal duerfen die Kinder "
    "anderer Rassen in den Elfenkindergarten gehen. Das hat meistens politische Gruende.");    
  AddDetail( ({ "gruende" }),
    "Frag Andvare danach.");    
  AddDetail( ({ "leben" }),
    "Schoen, wenn man am Leben ist, nicht wahr?");    
  AddDetail( ({ "sand" }),
    "Der weiche Sand foerdert die Kreativitaet der Kinder. Hier koennen "
    "sie buddeln und Dinge bauen, die ihnen gerade einfallen.");    
  AddDetail( ({ "kreativitaet" }),
    "Die ist sehr wichtig fuer Kinder.");    
  AddDetail( ({ "fantasy", "dinge" }),
    "In Deiner Fantasy siehst Du hier Sandburgen, Schloesser, Tuerme, Strassen und ganze Staedte entstehen.");    
   AddDetail( ({ "sandburgen","schloesser", "strassen", "staedte", "tuerme" }),
    "Sowas siehst Du die Elfenkinder in Deiner Fantasy hier bauen.");    
  AddDetail( ({ "sandkasten" }),
    "Du stehst mitten in einem Sandkasten.");    
  AddDetail( ({ "foermchen" }),
    "Mit denen spielen die Kinder.");    
  AddDetail( ({ "schaufel","schaufeln" }),
    "Mit den Schaufeln graben die Kinder Loecher in den Sand.");    
  AddDetail( ({ "loecher" }),
    "Die sind ueberall im Sand verteilt.");    
  AddDetail( ({ "wippe" }),
    "Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
    "einen tollen Ausblick ueber die Stadt haben wuerdest.");    
  AddDetail( ({ "wippen" }),
    "Schau Dich doch nach jemanden um der mit Dir wippen moechte.");    
  AddDetail( ({ "um", "jemand","jemanden" }),
    "Frag halt wen.");    
  AddDetail( ({ "seite" }),
    "An der Seite steht eine Wippe.");    
  AddSpecialDetail( ({ "ausblick" }),"ausblick");    
  AddDetail( ({ "andvare" }),
    "Den wirst Du hier nicht finden.");    
  AddDetail( ({ "waelder","umgebung" }),
    "Du freust Dich dies alles zu sehen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das helle Lachen eines Kindes.");
  AddSound( ({ "lachen","kind","kinderlachen" }),
    "Es klingt froehlich und unbeschwert.");

  AddSound( ({ "" }),
    "");

 
  AddSmell( ({ "" }),
    "");


AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_2f.lpc" ); 

AddCmd( ({ "bau", "baue" }), "bauenCmd" );
AddCmd( ({ "zertrete", "zertritt", "zerstoere","zerstoer" }), "zertreten" );
AddCmd( ({ "grabe", "grab" }), "graben" );
AddCmd( ({ "spiele", "spiel" }), "spielen" );
AddCmd( ({ "kletter", "klettere" }), "klettern" );
AddCmd( ({ "wippe", "wipp" }), "wippen" );


//Im Standartraum definiert
AddCmd( ({ "pflueck", "pfluecke" }), "pfluecken" );
AddCmd( ({ "bitte" }), "bitten" );

}

ausblick()
{
	if(name1==TPN||name2==TPN)
		return("Von hier oben aus kannst wirklich weit sehen. Du siehst ganz Aboriville, aber auch die Waelder der Umgebung. Du bist begeistert.\n");
		
	else
		return("Dazu musst Du auf die Wippe klettern.\n");	
	
	}


bauenCmd(string str )
{
  notify_fail( "Was moechtest Du bauen?\n" );
  if( str == "burg"||str== "sandburg" )
  	{
  		if (present("sandburg", TO)) // Ist eine Sandburg da?
  			write("Hier stehen doch schon eine Burg!\n");
			else
				{
    			write("Du baust eine riesige Sandburg.\n");
    			say( TPN+" baut eine Sandburg.\n");
   				AddItem("/d/andracia/yondala/wasser/pirateninsel/obj/sandburg.lpc",REFRESH_NONE);
     		}
  		return 1;
		}
  else if( str == "stadt"||str== "staedte"||str== "turm"||str== "tuerme"||str== "schloss"||str== "schloesser" )
	  { 
	 	  write("Du faengst aeusserst motiviert an, leider versagst Du jaemerlich. Du bist wirklich zu ungeschickt.\n");
		  return 1;
		}
}



zertreten(string str )
{ notify_fail( "Was moechtest Du zertreten?\n" );
	if( str == "burg", "sandburg" )
  	{
  		if(!present("sandburg", TO))
  			{
  				write("Hier ist keine Sandburg.\n");
  				return 1;
  			}
  	
   		else
   			{
   				write("Du trittst gegen die Sandburg und springst auf ihr herum bis sie vollkommen weg ist.\n");
    			say( TPN+" macht die Sandburg dem Erdboden gleich.\n", TP);
					obj=present ("sandburg", TO); //eine Sandburg wird geloescht
					obj->remove();
			    return 1;
			  }
			}
 	return 0;
}


graben(string str )
{ 
	if (str=="im sand"||str=="loch"||!str||str=="in sand"||str=="loecher")
		{if(TP->FindPotion("Du graebst im Sand und findest einen Zaubertrank.\n")) return 1;}
	    		
write("Du graebst ein paar tiefe Loecher in den Sand.\n");
say(TPN+" graebt ein paar tiefe Loecher in den Sand.\n");
 	return 1;
}

spielen(string str )
{ 
	notify_fail( "Womit moechtest Du spielen?\n" );
	if(str!="mit foermchen") return 0;
	write("Du spielst ein bisschen mit den Foermchen.\n");
	say(TPN+" spielt mit den Foermchen.\n");
 	return 1;
}




wippen(string str)
{
	if(name1!=TPN&&name2!=TPN)
		{
			notify_fail("Du sitzt doch gar nicht auf der Wippe, Du musst vorher rauf klettern.\n");
			return 0;
			}
			
		if(name1=="\nkeinerda"||name2=="\nkeinerda")//Wenn nicht beide Plaetze besetzt sind	
			{
				write("Du stoesst Dich vom Boden ab, aber alleine macht das keinen Sinn.\n");
				say(TPN+ "versucht alleine zu wippen.\n",TP);
				return 1;
			}
write("Du stoesst Dich mit den Fuessen ab und Ihr wippt froehlich hoch und runter.\n");
if(TP==wipper1)
{tell_object(wipper2, name1+" stoesst sich mit den Fuessen ab und hier wippt froehlich hoch und runter.\n");
say(name1+" und "+name2+ " wippen froehlich auf und ab.\n", wipper2);}


{if(TP==wipper2)
{tell_object(wipper1, name2+" stoesst sich mit den Fuessen ab und ihr wippt froehlich hoch und runter.\n");
say(name1+" und "+name2+ " wippen froehlich auf und ab.\n", wipper1);}
}
return 1;
}



int klettern(string str)
  { 
    notify_fail( "Wohin moechtest Du klettern?\n" );
  	if (str=="auf wippe")
  	  {
  		if (name1==TPN||name2==TPN)
  		  { 
		    write ("Du sitzt doch bereits!\n");
			return 1;
			}
	    else //also wenn er noch nicht sitzt
		  {
			if(sitztwer<2)
			  {
				write("Du setzt Dich auf die Wippe.\n");
				say (TPN+" setzt sich auf die Wippe.\n", TP);
				TP->SetProp(P_NOMOVE, 1,"Du sitzt auf der Wippe und solltest erst herunter klettern.\n");
	            sitztwer++;
	            if (name1=="\nkeinerda")
				  {
				    name1=TPN;
					wipper1=TP;
					}
				else
				  {
				    name2=TPN;
					wipper2=TP;
					}
			if(name1!="\nkeinerda"&&name2=="\nkeinerda")
			AddDetail( ({ "wippe" }), 
			  "Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   			  "einen tollen Ausblick ueber die Stadt haben wuerdest. "+capitalize(name1)+" sitzt auf der Wippe."); 
    		
			else if(name1!="\nkeinerda"&&name2!="\nkeinerda")   
			  AddDetail( ({ "wippe" }), 								
				"Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   				"einen tollen Ausblick ueber die Stadt haben wuerdest. "+capitalize(name1)+" und "+capitalize(name2)+" sitzen auf der Wippe."); 
			
			else if(name1=="\nkeinerda"&&name2!="\nkeinerda")   
			  AddDetail( ({ "wippe" }), 								
				"Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   				"einen tollen Ausblick ueber die Stadt haben wuerdest. "+capitalize(name1)+" sitzt auf der Wippe."); 
            return 1;
			}

			if(sitztwer==2)
			  {
				write ("Die Wippe ist leider schon besetzt.\n");
				return 1;
				}
			
		return 1;
		}
	}
  	if (str=="von wippe"||str=="von wippe herunter"||str=="runter"||str=="herunter"||str=="von wippe runter")
  		{
  			if(name1!=TPN&&name2!=TPN)
  				{write("Du sitzt doch gar nicht auf der Wippe.\n");
  				return 1;}
  					
				write("Du kletterst von der Wippe herunter.\n");
				say(TPN+" klettert von der Wippe.\n",TP);
				sitztwer--;
				TP->SetProp(P_NOMOVE, 0);

  			if(name1==TPN)
  				{
  					name1="\nkeinerda";
  					if(name2=="\nkeinerda")
  						{AddDetail( ({ "wippe" }),
    						"Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   							"einen tollen Ausblick ueber die Stadt haben wuerdest.");
   							return 1;
   							}    
 						else
  						{
						  AddDetail( ({ "wippe" }),
    						"Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   							"einen tollen Ausblick ueber die Stadt haben wuerdest. "+name2+" sitzt auf der Wippe.");
   							return 1;
   							}
   				  }    
  			if (name2==TPN)
  				{
  					name2="\nkeinerda";
  					if(name1=="\nkeinerda")
  					  {
					    AddDetail( ({ "wippe" }),
    					  "Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   						  "einen tollen Ausblick ueber die Stadt haben wuerdest.");
   						return 1;
   						}    
 					else
  					{
					  AddDetail( ({ "wippe" }),
    					"Du siehst eine hoelzerne Wippe und kannst Dir vorstellen, dass Du beim Wippen "
   						"einen tollen Ausblick ueber die Stadt haben wuerdest. "+name1+" sitzt auf der Wippe.");
   					  return 1;
   					}
   				}    
  					
  		}
return 0;
}

