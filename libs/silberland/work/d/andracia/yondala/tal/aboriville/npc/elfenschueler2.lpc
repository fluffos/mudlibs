//Hiara, Sutuna oder Nalda

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"elfenschueler_std.lpc";

int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Hiara";
  AddInfo( ({"hiara"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Fenween und Alanel.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Famione.",
    "sagt: ");
  AddInfo( ({"mondol","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","alanel"}),
    "Meines Vaters Name ist Alanel.",
    "sagt: ");
  AddInfo( ({"mutter","fenwen"}),
    "Meiner Mutter Name lautet Fenwen.",
    "sagt: ");
  AddInfo( ({"thorasa", "schwester","schwestern"}),
    "Meine Schwester heisst Thorasa.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "ranari"}),
    "Mein Bruder heisst Ranari.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe eine Schwester und einen Bruder.",
    "sagt: ");
	break;}
	case 1:{name="Nalda";
  AddInfo( ({"nalda"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Nela und Lorion.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Zylia und Selo.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Selo.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Zylia.",
    "sagt: ");
  AddInfo( ({"mondol","selo"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","zylia"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","lorion"}),
    "Meines Vaters Name ist Lorion.",
    "sagt: ");
  AddInfo( ({"mutter","nela"}),
    "Meiner Mutter Name lautet Nela.",
    "sagt: ");
  AddInfo( ({"alari", "schwester","schwestern"}),
    "Meine Schwester heisst Alari.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Mein Bruder heisst Saladion.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe eine Schwester.",
    "sagt: ");

	break;}
	
	case 2:{name="Sutana";
		  AddInfo( ({"sutana",""}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Fesieel und Nerael.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Linlaen.",
    "sagt: ");
  AddInfo( ({"mondol","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","linlaen"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","fesieel"}),
    "Meines Vaters Name ist Fesiell.",
    "sagt: ");
  AddInfo( ({"mutter","nerael"}),
    "Meiner Mutter Name lautet Nerael.",
    "sagt: ");
  AddInfo( ({"sowena", "schwester","schwestern"}),
    "Meine Schwester heisst Sowena.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "eriu"}),
    "Mein Bruder heisst Eriu.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe einen Bruder und eine Schwester.",
    "sagt: ");
  break;}
	
}	
	

SetProp(P_NAME, name);
						SetProp(P_SHORT, name+" das Elfenmaedchen");
  SetProp(P_LONG,
    "Du siehst ein Elfenmaedchen vor Dir, welches schon zur Schule geht und Dich aus klugen Augen "
    "neugierig betrachtet.");

  SetProp(P_GENDER, MALE);
  AddId(({"maedchen", "elfenmaedchen", "elf", "elfenkind", "kind","\nelfenschueler", "/nelfenkind", lower_case(name)}));
  create_default_npc(4);
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 40000);
  AddInfo( ({"name","namen"}),
    "Man nennt mich "+name+".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");



}