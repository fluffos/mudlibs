inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Elfenfrucht");
  SetProp(P_LONG,
    "Du siehst eine leuchtende Elfenfrucht welche aeusserst delikat aussieht." );
  SetProp(P_NAME, "Elfenfrucht");
  SetProp(P_GENDER, FEMALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:2, 
											 F_HEAL:({10,10}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du verspeist eine delikate Elfenfrucht.", 
											 F_MSG_ROOM: "verspeist eine delikate Elfenfrucht."]));


  AddId(({"frucht", "elfenfrucht"}));

  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);


		call_out("weg",3600); //zerstoert sich in 1 Stunde

}

int weg()
{ 
  this_object()->remove();
	}