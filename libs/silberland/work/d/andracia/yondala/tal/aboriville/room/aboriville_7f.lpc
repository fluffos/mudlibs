#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Gewaechshauses." );
  SetProp( P_INT_LONG, "Du befindest Dich im Suedteil das Gewaechshauses. "+
    "Hier sind hauptsaechlich Beete mit Kraeutern in den verschiedensten Farben. "+
    "Du spuerst, dass es hier waermer ist und auch die Luftfeuchtigkeit ist gestiegen." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "boden", "weg", "rinde", "baeume" }),
    "Du laeufst auf einem Weg, der aus abgefallener Rinde alter Baeume besteht.");    
  AddDetail( ({ "waende", "wand", "glaswand", "glaswaende" }),
    "Glaswaende lassen Sonnenlicht herreindringen.");    
  AddDetail( ({ "decke", "glasdach", "dach" }),
    "Ein Glasdach, das das Sonnenlicht herreinscheinen laesst.");    
  AddDetail( ({ "sonnenlicht", "sonnenstrahl", "sonnenstrahlen" }),
    "Sonnenstrahlen fallen durch das Glasdach und die Glaswaende herin.");    
  AddDetail( ({ "gewaechshauses", "gewaechshaus", "suedteil" }),
    "Du stehtst im Suedteil des Gewaechshauses.");
  AddDetail( ({ "beet", "beete", "kraeuter", "kraut" }),
    "Es sind etliche und die alle unbekannt.");    
  AddDetail( ({ "farben" }),
    "Du siehst verscheiden farbige Kraeuter.");    
  AddDetail( ({ "luftfeuchtigkeit", "luft", "feuchtigkeit", "klima" }),
    "Die Feuchtigkeit hier ist stark erhoet, um den Kraeutern ein gutes Klima zu ermoeglichen.");    
  AddDetail( ({ "osten" }),
    "Im Osten scheint ein Springbrunnen zu sein.");    
  AddDetail( ({ "springbrunnen", "springbrunnens", "brunnen" }),
    "Er plaetschert leise vor sich hin, und versorgt die Luft mit der noetigen Feuchtigkeit.");    

      
  AddSound( DEFAULT_SOUND,
    "Du hoerscht das leise plaetschern eines Springbrunnens.");
    
  AddSound( ({ "springbrunnens", "springbrunnen", "brunnen", "plaetschern", "plaetschert" }),
    "Im Osten schein ein Springbrunnen zu sein, der vor sich hin plaetschert.");

  AddSmell( DEFAULT_SMELL,
    "Es richt nach verschiedensten Kraeutern, die hier wachsen.");



AddExit( "osten", ELFEN_ROOM  + "aboriville_7g.lpc" ); 
AddExit( "norden", ELFEN_ROOM  + "aboriville_6f.lpc" ); 


}
