// int _query_wimpy() { return 0; }

void StartReaction(string verb, string gruppe, string adverb, int touch) {

      write(name()+ " laesst sich nichts anmerken.\n");
      say(name()+ " laesst sich nichts anmerken.\n",TP);  
}







void check(object spieler)
{
	//object spieler;
	//spieler = TP; //spart verarbeitungsdings, weil sonst immer zwei Funktionen aufgerufen werden
  // Spieler noch da?
 // if (spieler && interactive(spieler) && (environment(TO)==environment(spieler)))
    if(!spieler || !interactive(spieler) || (environment(TO)!=environment(spieler)))
    return;
  
    if (spieler->QueryProp(P_ALIGN) < (-500))
    {
      Attack(spieler);
    }
  
  else if(spieler->QueryProp(P_GUILD) == "pirat"&&spieler->QueryProp(P_RACE)=="elf")
  	{
  		command("sag Ihr habt unsere Rasse verraten, "+spieler->name()+"!");
      Attack(spieler);
    }
   else if(present ("\nelfenkiller", spieler))
    	{
  	  	command("sag Ich erkenne eure Taten, "+spieler->name()+"!");
    		Attack(spieler);
    	}
}	

//soll vom Baum schubbsen wenn auf dem Wachweg, sonst einfach nur einen Raum weiterschubbsen
void schubs(object enemy, int damage, mixed dam_type) 
{
	 	string *ausgang;
//	tell_object(enemy, "");
	if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_5k")
	  {enemy->move(BIRKE_ROOM + "buchenwald_5k", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_5l")
	  {enemy->move(BIRKE_ROOM + "buchenwald_5l", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_6j")
	  {enemy->move(BIRKE_ROOM + "buchenwald_6j", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_7i")
	  {enemy->move(BIRKE_ROOM + "buchenwald_7i", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_8i")
	  {enemy->move(BIRKE_ROOM + "buchenwald_8i", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_9j")
	  {enemy->move(BIRKE_ROOM + "buchenwald_9j", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_10k")
	  {enemy->move(BIRKE_ROOM + "buchenwald_10k", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_10l")
	  {enemy->move(BIRKE_ROOM + "buchenwald_10l", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_9m")
	  {enemy->move(BIRKE_ROOM + "buchenwald_9m", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}
	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_8n")
	  {enemy->move(BIRKE_ROOM + "buchenwald_8n", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_7n")
	  {enemy->move(BIRKE_ROOM + "buchenwald_7n", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	TP->do_damage(20,"Ein Sturz");}
 	
	else if( file_name(environment(TO))== ELFEN_ROOM + "aboriville_6m")
	{  enemy->move(BIRKE_ROOM + "buchenwald_6m", M_GO ,
 	 "","faellt aus den Bauemen","faellt aus den Baeumen");
 	  	TP->do_damage(20,"Ein Sturz");}

	else
  	  {
	 			ausgang = m_indices( ENV(TO)->QueryProp(P_EXITS) );
  			enemy->move( ENV(TO)->QueryProp(P_EXITS)[ausgang[random(sizeof(ausgang))]] , M_GO);
				}

 
}







void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(1);
}



void InformDefend(object enemy)
{
 Kill(enemy);
}

void nein(string name)
{command("sag Tut mir leid, aber mit Waffe darf ich Euch hier nicht hoch lassen, "+name+"!");}