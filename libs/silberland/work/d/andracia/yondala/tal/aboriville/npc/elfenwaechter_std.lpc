inherit "std/mnpc";

#include <properties.h> 
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"

string name;
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfenwaechter"))) AddDefender(this_player());
   call_out("check", 0, TP);

}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  SetProp(P_SHORT, "Ein Elfenwaechter.");
  SetProp(P_LONG,"Du siehst einen grossen Elf vor Dir, der Dich aus wachsamen Augen anschaut. "
    			"Er traegt einen hoelzernen Panzer und einen elfischen Bogen.");
  SetProp(P_GENDER, MALE);
  AddId(({"elfenwaechter", "waechter", "elf"}));
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_HOLY}));
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 65000);
  SetProp( P_REJECT, ({ REJECT_DROP,
    			"Der Elfenwaechter will Deine Sachen nicht tragen.\n" }) );
  SetProp(P_SHORT, "Ein Elfenwaechter");
  SetProp(P_NAME, "Elfenwaechter");
	name="Waechter";
  SetProp(P_KILL_NAME, "Ein Elfenwaechter");
		
	  SetProp(P_ARTICLE, 1);

	//wird von jedem Waechter im Kampf unterstuetzt
  AddId(({"/nelfenwaechter"}));
	
//	SetProp(P_DEFENDERS, (({"elfenwaechter"})));
	
	create_default_npc(20);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 800);


//Mit der area mal schauen, ob das so gut ist. Eventuell den Kindergarten rausnehmen.
SetProp (P_MNPC_DEFAULTROOM , ELFEN_ROOM + "aboriville_8n");
SetProp (P_MNPC_AREA, ({ELFEN_ROOM}));
SetProp (P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({25, 50, 25}));



  SetProp(P_NOMAGIC,30);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([ DT_HOLY:      -1.0, DT_UNHOLY:    0.5, ]) );

  SetProp(P_MSGIN, "schleicht heran");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Elfenbrueder, raecht meinen Tod!");
  SetProp(P_KILL_MSG, "Setze nie mehr einen Fuss in diese Stadt!");

  AddInfo(DEFAULT_INFO, "sagt: Im Dienst gebe ich keine Auskuenfte.\n");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

 

SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,400,
	        "Der Elfenwaechter schiesst einen heiligen Pfeil auf Dich.\n",
	        "Der Elfenwaechter schiesst einen heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(4,500,
	         "Der Elfenwaechter schiesst einen starken heiligen Pfeil auf Dich.\n",
	         "Der Elfenwaechter schiesst einen starken heiligen Pfeil auf @WEN.\n",
	         ({DT_HOLY}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,800,
	         "Der Elfenwaechter schiesst einen brennenden Pfeil auf Dich.\n",
	         "Der Elfenwaechter schiesst einen brennenden Pfeil auf @WEN.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,100,
	         "Der Elfenwaechter schiesst einen vergifteten Pfeil auf Dich.\n",
	         "Der Elfenwaechter schiesst einen vergifteten Pfeil auf @WEN.\n",
	         ({DT_FIRE}),"gift", ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,100,
	         "Der Elfenwaechter gibt Dir einen Schubs.\n",
	         "Der Elfenwaechter gibt @WEN einen Schubs.\n",
	         ({DT_MIND}),"schubs", ([SP_SHOW_DAMAGE:1]) );






/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/

  SUID;
  CLONEME(ELFEN_WEAPON "elfenbogen" );
  command("zuecke bogen");
  CLONEME(ELFEN_ARMOUR "holzpanzer" );
  CLONEME(ELFEN_ARMOUR "elfenholzbeinschienen" );
  CLONEME(ELFEN_ARMOUR "elfenholzarmschienen" );
  CLONEME(ELFEN_ARMOUR "elfenseidenschuhe" );
  CLONEME(ELFEN_ARMOUR "elfenguertel" );
  command("trage alles");

}
void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}




