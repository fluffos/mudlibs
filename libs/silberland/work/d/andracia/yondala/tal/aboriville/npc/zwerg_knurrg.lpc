//Der Elfenschmied, ein Zwerg 

#include "../def.h"
#include <properties.h> 
#include <combat.h>
#include <new_skills.h>
#include <moredef.h>
#include <npc.h>
#include <language.h>
inherit "std/repair";
//inherit "std/npc";
inherit"/std/npc/spells.lpc";


int haben = 1;

	
void create() 
{

  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Knurrg der Schmied");
  SetProp(P_LONG,
    "Knurrg ist ein alter, grauhaariger Zwerg. Viel sieht man von ihm nicht, denn er hat langes "
    "Haupthaar und einen noch laengeren Bart, beides in stahlgrau. Er schwitzt stark und riecht "
    "auch etwas streng, aber das sollte bei Zwergen, die koerperlich arbeiten nicht verwundern.");
  SetProp(P_NAME, "Knurrg");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"knurrg", "zwerg", "schmied", "SCHMIED"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinem Schmiedehammer",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Zwerg");

  SetProp(P_ALIGN, 0);
  SetProp(P_KILL_NAME, "Knurrg");
//  SetProp(P_KILL_MSG, "In meinem Laden randalierst Du nicht!");
 SetChats(3, ({
    "Knurrg haelt ein gluehendes Eisen in das magische Feuer.\n",
    "Knurrg wischt sich den Schweiss von der Stirn.\n",
    "Knurrg beschlaegt ein Eisen auf dem Amboss.\n",
    "Knurrg laesst unter seinen Haenden die Funken spruehen.\n",
    "Knurrg ueberprueft die Qualitaet seiner Arbeit.\n",}) );

   AddDetail( ({ "", "" }),
    ""); 
   AddDetail( ({ "", "" }),
    ""); 
   AddDetail( ({ "", "" }),
    ""); 
   AddDetail( ({ "", "" }),
    ""); 
//***********************************************************************
// Infos vom std
  AddInfo( ({"gold","liebe"}),
    "Ich liebe Gold",
    "sagt: ");
  AddInfo( ({"essen","trinken","tanken"}),
    "Geht zum Wirt.",
    "sagt: ");
  AddInfo( ({ "wirt" }),
    "Henk ist der Wirt in der Hafenkneipe und Endoriel verkauft auch Speisen in der Grotte.",
    "sagt: ");
  AddInfo( ({ "hafenkneipe", "kneipe" }),
    "Die ist am Hafen.",
    "sagt: ");
  AddInfo( ({ "pirat", "piraten" }),
    "Die Piraten haben sich auf eine Insel zurueck gezogen. Da ich das Wasser meide, weiss ich nicht, wo sie sind.",
    "sagt: ");
  AddInfo( ({ "haende", "hand" }),
    "Haende hab ich zwei.",
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Man munkelt im Gebirge leben Kobolde.",
    "sagt: ");
  AddInfo( ({ "laden", "kneipe", "laeden", "gilde", "restaurant","post", "quest", "quests" }),
    "So etwas gibt es hier in der Naehe, schaut Euch nur um!",
    "sagt: ");
  AddInfo( ({ "sex", "poppen", "quickie", "ficken", "blowjob" }),
    "haut dir eine runter");


  AddInfo( ({ "endoriel" }),
    "Endoriel? Ohja, so einen gab es hier mal. Aber er wurde vertrieben, weil er sich den "
    "Piraten anschloss.",
    "sagt: ");





//*************************************************************************** 
  AddInfo(DEFAULT_INFO, "brummelt etwas in seinen Bart.\n");

  AddInfo( ({ "eisen", "metalle","metall", "silber","gold" }),
    "Ich bearbeite Metalle, ich bin der beste Schmied in Andracia.",
    "sagt: "); 
  AddInfo( ({ "knurrg", "schmied" }),
    "Das bin ich.",
    "sagt: "); 
   AddInfo( ({ "messer" }),
    "Ich fertige die besten Messer im Land. Fuer einen geringen Preis koennt Ihr eines bekommen.",
    "sagt: "); 
   AddInfo( ({ "preis" }),
    "Alles, was ich fuer ein Messer haben moechte ist ein Schafsbraten!",
    "sagt: "); 
   AddInfo( ({ "schafsbraten", "braten" }),
    "Ich liebe Schafsbraten. Leider bekommt man soetwas in Aboriville nicht. Ihr muesstet einen "
    "Metzger oder einen Schlachter dafuer suchen.",
    "sagt: "); 
   AddInfo( ({ "metzger" }),
    "Puh, da kenne ich keinen, das ist mein Problem.",
    "sagt: "); 
   AddInfo( ({ "schlachter" }),
    "Bei den Trollen findet Ihr sicher einen Schlachter. Da trau ich mich allerdings nicht hin.",
    "sagt: "); 
   AddInfo( ({ "trolle", "troll" }),
    "Die Trolle leben suedlich des Tals in den Helperwaeldern.",
    "sagt: "); 
   AddInfo( ({ "helsperwaelder" }),
    "Der Zutritt dahin ist noch verwehrt, mancher Troll treibt sich dennoch im Tal herum.",
    "sagt: "); 
   AddInfo( ({ "tal" }),
    "Dort befindet Ihr Euch gerade.",
    "sagt: "); 
   AddInfo( ({ "" }),
    "",
    "sagt: "); 
   AddInfo( ({ "" }),
    "",
    "sagt: "); 
      
 //AddCmd( ({ "riech", "rieche" }), "riechenCmd" );


  SetProp(P_SPELLRATE, 45);
  SetProp(P_NOMAGIC,10);			
  
	AddSpell(2,400,
	        "Knurrg versucht, Dich mit seinem Hammer zu spalten.\n",
	        "Knurrg versucht, @WEN mit seinem Hammer zu spalten.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,300,
	        "Knurrg wirbelt seinen Hammer durch die Luft.\n",
	        "Knurrg wirbelt seinen Hammer durch die Luft.\n",
	         ({DT_AIR}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,300,
	        "Knurrg leitet das magische Feuer auf Dich.\n",
	        "Knurrg leitet das magische Feuer auf @WEN.\n",
	         ({DT_FIRE, DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
			 
	AddDefaultSpell(1,100, "Knurrg versucht, Deine Arme zu zertruemmern.\n",
	        "Knurrg versucht @WESSEN Arme zu zertruemmern.\n",
	         ({DS_DISARM}), ([SP_SHOW_DAMAGE:1]) );
 





   SUID;
   CLONEME( "/d/andracia/yondala/wasser/pirateninsel/weapon/schmiede_hammer.lpc" );
   CLONEME("/d/andracia/yondala/wasser/pirateninsel/armour/pirat_hemd.lpc");
   CLONEME("/d/andracia/yondala/wasser/pirateninsel/armour/trogurt_schuerze.lpc");
   CLONEME("/d/andracia/yondala/wasser/pirateninsel/armour/pirat_schuhe.lpc");
   command("trage alles");
   command("zuecke hammer");

}

give_notify(object ob)
 {
 	if(ob->id("schafsbraten"))
 		{
 			command("sag Ah, koestlich! Vielen Dank. Als Dank gebe ich Euch gerne eines meiner Messer!");
		  write("Knurrg gibt Dir ein Messer.\n");
			say("Knurrg gibt "+TPN+" ein Messer.\n",TP);
 			CLONE("/d/andracia/yondala/wasser/pirateninsel/weapon/knurrgmesser.lpc", TP);
			call_out("essen",2, ob);

 		}
   else
     {             
       command("sag Was soll ich damit?");
			 write("Knurrg gibt Dir "+ob->name(WEN)+" zurueck.\n");
			 say("Knurrg gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
       ob->move(TP, M_GET);
      }

    }

void essen(object ob)
{
	ob->remove();
	tell_room(environment(TO), "Knurrg verspeist mit hoechstem Genuss einen Schafsbraten.\n");
}
