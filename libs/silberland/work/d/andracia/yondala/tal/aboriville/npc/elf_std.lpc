//Der soll auch ueber Faehigkeiten Auskunft geben

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int geschlecht;
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("/nelfennorm")||
   	        this_player()->id("/nelfenwaechter"))) AddDefender(this_player());


}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  	
geschlecht=random(2);
if(geschlecht==0)
	{
		SetProp(P_SHORT, "Ein Elf");
  	SetProp(P_LONG,
	  	"Du siehst einen Elfen vor Dir, welcher hier seine taeglichen Belange erledigt. Er "
	    "laechelt vor sich hin und singt leise zu den Baeumen.");
  	SetProp(P_NAME, "Elf");
 	 	SetProp(P_GENDER, MALE);
 	 	AddId(({"elf", "/nelfennorm"}));
  	SetProp(P_ARTICLE, 1);
//  set_living_name("");

  	create_default_npc(10);
  	SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  	SetProp(P_RACE, "Elf");
  	SetProp(P_KILL_NAME, "Ein Elf");
  	SetProp(P_SIZE, 180+random(20));
  	SetProp(P_WEIGHT, 80000);
  	SetProp( P_REJECT, ({ REJECT_DROP,
    	"Der Elf traegt nichts fuer Dich.\n" }) );	
    }  
else	{
		SetProp(P_SHORT, "Eine Elfin");
  	SetProp(P_LONG,
	  	"Du siehst einen Elfin vor Dir, welche hier ihre taeglichen Belange erledigt. Sie sieht "
	    "sehr zufrieden aus und summt ein Lied.");
  	SetProp(P_NAME, "Elfin");
 	 	SetProp(P_GENDER, FEMALE);
 	 	AddId(({"elfin", "elfe", "/nelfennorm"}));
//  set_living_name("");

  	create_default_npc(8);
  	SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  	SetProp(P_KILL_NAME, "Eine Elfin");
  	SetProp(P_SIZE, 170+random(20));
  	SetProp(P_WEIGHT, 60000);
  	SetProp( P_REJECT, ({ REJECT_DROP,
    	"Die Elfin traegt nichts fuer Dich.\n" }) );	
    }
	SetProp(P_RACE, "Elf");
 	SetProp(P_ARTICLE, 1);
 	SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([      DT_HOLY:      1.0, DT_UNHOLY:    -0.5, DT_MAGIC:  0.0, DT_MIND:   1.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ELFEN_ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM , ELFEN_ROOM  ELFEN_ROOM + "aboriville_4d");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Das habt Ihr selbst zu verantworten!");
	
  AddInfo(DEFAULT_INFO, "sagt: Fragt das doch lieber einen der Aeltesten.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"alter","seinem alter"}),
    "Ich war schon auf der Welt, da wurde noch nicht mal an Euch gedacht.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
