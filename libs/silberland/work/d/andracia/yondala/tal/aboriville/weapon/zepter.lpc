int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}



void zerstoeren()
{ write("Durch die Beruehrung eines Unwuerdigen viebrirt das Zepter ploetzlich");
      this_object()->remove();
      }	
