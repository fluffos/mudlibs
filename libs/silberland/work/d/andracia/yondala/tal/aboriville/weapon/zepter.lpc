#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein koenigliches Zepter");
  SetProp(P_LONG,
    "Du siehst ein langes, braunes Zepter. Es sieht aus wie eine Wurzel und scheint auch "
    "tatsaechlich mal eine gewesen zu sein." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Zepter");
  SetProp(P_NAME_ADJ, "koeniglich");

  SetProp(P_GENDER, NEUTER);
  AddId( ({"zepter", ""}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_MAGIC );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_MAGIC );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ({MAT_WOOD MAT_MISC_MAGIC}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 40);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["andvare": 100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:20]) );


//      SetProp(P_WIELD_FUNC, this_object());
}

