#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  ::create();
  SetProp( P_INT_SHORT, "In einer gruenen Hoehle\n" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einer Hoehle aus Blaettern und Holz. Viel kannst Du nicht erkennen. "
    "Die Waende bestehen aus Holz, lediglich die Westwand unterscheidet sich von den anderen. " );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddSpecialDetail( ({ "wohnraum", "raum" }), "wohnraum" );
//  AddSpecialDetail( ({ "sessel"}), "sessel" );
  AddSpecialDetail( ({ "waende","wand"  }), "wand" );
  AddSpecialDetail( ({ "suedwand", "sueden"  }), "suedwand" );
  AddSpecialDetail( ({ "ostwand", "osten"  }), "ostwand" );
  AddSpecialDetail( ({ "nordwand", "norden"  }), "nordwand" );
  AddSpecialDetail( ({ "westwand", "westen"  }), "westwand" );
  AddSpecialDetail( ({ "moebel"  }), "moebel" );

  AddSpecialDetail( ({ "bett"  }), "bett" );
  AddSpecialDetail( ({ "schrank"  }), "schrank" );
  AddSpecialDetail( ({ "tisch"  }), "tisch" );
  AddSpecialDetail( ({ "stuehle"  }), "stuehle" );

  AddSpecialDetail( ({ "apotheke"  }), "apotheke" );
  AddSpecialDetail( ({ "brisi"  }), "brisi" );
  AddSpecialDetail( ({ "lianen", "liane"  }), "lianen" );

  AddSpecialDetail( ({ "wohnraum"  }), "wohnraum" );
  AddSpecialDetail( ({ "tuer"  }), "tuer" );

  AddDetail( ({ "holz" }),
    "Das Holz ist dunkel und sieht aus als waere es lebendig und wie an einem Stueck, denn Du "
    "siehst keine Ritzen oder Fugen. Es scheint, als waere das Holz genauso in dieser Form gewachsen.");    
  AddDetail( ({ "stueck","eindruck" }),
    "Du hast den Eindruck, als sei das Holz so am Stueck nur fuer diese Apotheke so gewachsen.");    
  AddDetail( ({ "seite", "seiten" }),
    "Alles hat zwei Seiten.");    
  AddDetail( ({ "unebenheiten" }),
    "Die Unebenheiten im Holz scheinen natuerlich zu sein.");    
  AddDetail( ({ "boden" }),
    "Der Boden ist aus glattgelaufenen Holz, welches nur wenige Unebenheiten "
    "aufweisst.");    
  AddDetail( ({ "tafel" }),
    "Die Tafel scheint als einziges hier nicht mit dem Raum verbunden zu sein. Du kannst sie lesen.");    
  AddDetail( ({ "decke" }),
    "Die Decke ueber Dir ist rund und besteht aus Holz. Ueberall funkeln dort kleine "
    "Gluehwuermchen.");    
  AddDetail( ({ "ranken" }),
    "Die Ranken sind gruen und sehen gesund und lebendig aus. Zwischen ihnen siehst Du immer "
    "wieder vereinzelte Blueten.");    
  AddDetail( ({ "blueten", "weiss" }),
    "Die Blueten leuchten in reinem Weiss und duften himmlisch.");    
  AddDetail( ({ "gluehwuermchen", "licht" }),
    "Die Gluehwuermchen tauchen diesen Raum in angenehm warmes Licht.");    
  AddDetail( ({ "vorhang" }),
    "Der Vorhang besteht aus gruenen Lianen. Er ist halb geoeffnet und hindert Dich sicherlich "
    "nicht daran nach hinten durchzugehen.");    
  AddDetail( ({ "freie" }),
    "Dort, wo Du herkommst.");    
  AddDetail( ({ "westwand" }),
    "Die Westwand besteht aus Holz.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "ausgang" }),
    "Der befindet sich suedlich von Dir.");    
  AddDetail( ({ "aeste" }),
    "Um Dich herum besteht alles aus dem Holz der Aeste der Baeume.");    


  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt","rest" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste um Dich herum haben sich hier zu einer Hoehle verdichtet.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter um Dich herum sind sehr dicht und bilden ein dichtes Dach.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht wie auch im Rest der ganzen Stadt aus Holz.");    
   AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
  AddDetail( ({ "kronen", "krone" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer aus Aesten und Blaettern gewachsenen Hoehle.");

    
  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst lediglich das Rauschen der Blaetter.");

  AddSound( ({ "rauschen","blaetter" }),
    "Du hoerst die Blaetter Aborivilles rauschen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blueten.");
 
  AddSmell( ({ "blueten" }),
    "Die Blueten duften himmlisch.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");



AddExit( "westen", ELFEN_ROOM  + "aboriville_1a.lpc" ); 
}





//Hier die SpecialFetails fuer Elfen/Naturvolk/Krautbesitzer und Rest

string moebel()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return    "Die Moebel scheinen so gewachsen zu sein, wie Brisi es wollte.\n";    
	else
	  return 0;	
 }


string wohnraum()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return    "Du stehst mitten in Brisis Wohnraum und schaust Dich neugierig um.\n";    
	else
	  return 0;	
 }

string wand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return        "Die Waende rundherum bestehen aus dunklem Holz. Aus ihnen heraus sind verschiedene Moebel gewachsen. "+
					"Nach Westen hin kannst Du wieder durch den Vorhang aus Lianen in die Apotheke gelangen.\n";
	  
	else
	  return 	"Die Waende hier bestehen aus Holz und Blaettern. Nach Westen kannst Du die Hoehle verlassen.\n";	
 }

string suedwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "An der Suedwand stehen ein Tisch und zwei Stuehle.\n";    
	else
	  return 	"Die Suedwand besteht wie alles hier aus Holz und Blaettern..\n";	
 }

string ostwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "Die gesamte Breite der Ostwand wird von einem gigantischen Bett eingenommen.\n";    
	else
	  return 	"Die Ostwand besteht wie alles hier aus Holz und Blaettern..\n";	
 }

string nordwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return   "Aus der Nordwand heraus ist ein grosser Kleiderschrank gewachsen.\n";    
	else
	  return 	"Die Nordwand besteht wie alles hier aus Holz und Blaettern.\n";	
 }
 
string westwand()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Durch die mit Lianen verhangene Tuer im Westen kannst Du den Wohnraum wieder verlassen.\n";    
	else
	  return 	"Vor der Westwand haengen einige Lianen und bilden einen natuerlichen Vorhang. "+
	  "Es scheint als koenntest Du dort die hoelzerne Hoehle verlassen.\n";	
 }

string bett()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Du siehst ein riesiges Himmelbett, ganz aus weichen Blueten.\n";    
	else
	  return 0;	
 }

string schrank()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Dort bewahrt Brisi vermutlich ihre privaten Gegenstaende auf.\n";    
	else
	  return 0;	
 }

string tisch()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Der Tisch ist leer, aber Du vermutest, dass Brisi dort isst und alles erledigt, "+
	  "was man an einem Tisch so tut. Er besteht wie alles hier aus Holz und Du bist fast sicher, "+
	  "dass er fest mit dem Boden verwachsen ist.\n";    
	else
	  return 0;	
 }

string stuehle()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Die Stuehle stehen ordentlich an den Tisch herangerueckt. Sie bestehen wie alles hier aus Holz.\n";    
	else
	  return 0;	
 }


string brisi()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return   "Wenn Brisi gerade nicht hier ist, dann warte kurz, sie kommt sicher bald zurueck.\n";    
	else
	  return 0;	
 }


string lianen()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return       "Die Lianen bilden einen natuerlichen Vorhang um die Apotheke vom Wohnraum abzutrennen.\n";    
	else
	  return 	    "Die Lianen bilden einen natuerlichen Vorhang.\n";	
 }


string apotheke()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return  "Die Apotheke liegt westlich von Dir. Du kannst einfach durch den Vorhang aus Lianen nach Westen gehen.\n";    
	else
	  return 0;	
 }


string tuer()
 {
	if( TP->id("Elfenspieler") ||  present("\nelfenkraut", TP) )
	  return "Die Tuer an der Westwand fuehrt zurueck in die Apotheke.\n";    
	else
	  return 0;	
 }

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
      result = BS("Du stehst hier mitten in Brisis Wohnraum. Er ist recht karg, aber dennoch "
      "gemuetlich eingerichtet. Du siehst mehrere aus dem Holz gewachsene Moebel.\n");
    }
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}


string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;

  if( viewer->id("Elfenspieler") ||
      viewer->QueryProp(P_GUILD) == "Naturvolk" ||
      present("\nelfenkraut", viewer) )
    {
      result = BS("In Brisis Wohnraum\n") ;
    } else {
      result = QueryProp(P_INT_SHORT);
    }
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}