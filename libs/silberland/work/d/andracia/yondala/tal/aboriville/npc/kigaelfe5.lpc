//Lalen, Laia oder Belina

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit ELFEN_NPC+"kigaelfe_std.lpc";


int wer;
string name;
void create() {
  if (!is_clone(TO)) return;
  ::create();
wer=random(3);
switch (wer)

{
	case 0:{name="Lalen";
  AddInfo( ({"lalen"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Garansa und Linwen.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Pheralas, Miranyl, Famione und Golain.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Pheralas und Golain.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Miranyl und Famione.",
    "sagt: ");
  AddInfo( ({"pheralas","golain"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"miranyl","famione"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","linwen"}),
    "Meines Vaters Name ist Linwen.",
    "sagt: ");
  AddInfo( ({"mutter","garansa"}),
    "Meiner Mutter Name lautet Garansa.",
    "sagt: ");
  AddInfo( ({"aliaria", "schwester","schwestern"}),
    "Meine Schwester heisst Aliaria.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "daniolo"}),
    "Mein Bruder heisst Daniolo.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe eine Schwester und einen Bruder.",
    "sagt: ");

	break;}
	case 1:{name="Laia";
  AddInfo( ({"laia"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Riaona und Linel.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Famione, Golain, Pheralas und Miranyl.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Golain und Pheralas.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Famione und Miranyl.",
    "sagt: ");
  AddInfo( ({"golain","pheralas"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"famione","miranyl"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","linel"}),
    "Meines Vaters Name ist Linel.",
    "sagt: ");
  AddInfo( ({"mutter","riaona"}),
    "Meiner Mutter Name lautet Riaona.",
    "sagt: ");
  AddInfo( ({"linla", "schwester","schwestern"}),
    "Meine Schwester heisst Linla.",
    "sagt: ");
  AddInfo( ({"brueder","bruder", "imalien"}),
    "Mein Bruder heisst Imalien.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe einen Bruder und eine Schwester.",
    "sagt: ");
	break;	}
	
	case 2:{name="Belina";
  AddInfo( ({"belina"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"eltern",""}),
 		"Meine Eltern heissen Mindala und Felerian.",
 		"sagt: ");
  AddInfo( ({"grosseltern",""}),
 		"Meine Grosseltern heissen Mondol, Linlala, Linlaen und Ambelio.",
 		"sagt: ");
  AddInfo( ({"grossvaeter","grossvater", "opa","opas"}),
    "Meine Grossvaeter heissen Mondol und Ambelio.",
    "sagt: ");
  AddInfo( ({"grossmuetter","grossmutter","oma","omas"}),
    "Meine Grossmuetter heissen Linlala und Linlaen.",
    "sagt: ");
  AddInfo( ({"mondol","ambelio"}),
    "Das ist einer meiner beiden Grossvaeter.",
    "sagt: ");
  AddInfo( ({"linlala","linlaen"}),
    "Das ist eine meiner beiden Grossmuetter.",
    "sagt: ");
  AddInfo( ({"vater","felerian"}),
    "Meines Vaters Name ist Felerian.",
    "sagt: ");
  AddInfo( ({"mutter","mindala"}),
    "Meiner Mutter Name lautet Mindala.",
    "sagt: ");
  AddInfo( ({"melina","semione","minda", "schwester","schwestern"}),
    "Meine Schwestern heissen Melina, Semione und Minda.",
    "sagt: ");
  AddInfo( ({"brueder","bruder"}),
    "Ich habe keine Brueder.",
    "sagt: ");
  AddInfo( ({"geschwister"}),
    "Ich habe drei Schwestern.",
    "sagt: ");
	break;}
	
}	
	


SetProp(P_NAME, name);
						SetProp(P_SHORT, name+" das kleine Elfenmaedchen");
  SetProp(P_LONG,
    "Du siehst ein kleins Elfenmaedchen vor Dir, welches noch nicht zur Schule "
    "gehen muss und daher sein junges Leben in vollen Zuegen geniessen kann.");

  SetProp(P_GENDER, FEMALE);
  AddId(({"maedchen", "elfenmaedchen", "elfe", "elfin", "elfenkind", "kind", "/nelfenkind", lower_case(name)}));
  create_default_npc(4);
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 35000);
  SetProp( P_REJECT, ({ REJECT_DROP,
    name+" will Deine Sachen nicht tragen.\n" }) );


  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


	         	

}

void die()
{
	//elfenkiller reinclonen
	 CLONE(ELFEN_OBJ+"elfenkiller.lpc", TP);
   ::die();		
}


void InformDefend(object enemy)
{
 Kill(enemy);
}