nuss_cmd(object zahler, object esser)
     {
     	if(TP->id("Elfenspieler"))
     		{
     			if (esser->eat_food(6, 0))
     			{
     				tell_object(esser,
            	"Bimalandon greift unter die Theke und reicht Dir eine noch warme "
            	"Nussecke. Du pustest erst kraeftig und vernaschst sie dann mit "
            	"grossem Genuss.\n" );
       			tell_room(this_object(),
                 esser->name(WER)+" isst eine warme Nussecke und strahlt dabei selig.\n",({ esser }) );
	           esser->AddMp(25);
  	         esser->AddHp(25);      
						}
           else
           	write("So viel kannst Du echt nicht mehr essen!\n");
      	}
       else
       		{
       			tell_object(esser,
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+esser->name(WER)+"!\n"+
            	"Bimalandon wirft Dir 130 Muenzen vor die Fuesse.\n");
       			tell_room(this_object(),
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+esser->name(WER)+"!\n"+
            	"Bimalandon wirft "+esser->name(WER)+" 130 Muenzen vor die Fuesse.\n", ({ esser }) );
  					ob = clone_object("/obj/money.lpc");
  					ob->SetProp(P_AMOUNT, 130);
  					ob->move(TO, M_SILENT);
  				}
			 	}	
			 
pilze_cmd(object zahler, object esser)
     {
     	if(TP->id("Elfenspieler"))
     		{
     			if (esser->eat_food(7, 0))
     			{
     				heili=random(4);
     				if(heili==0)
     					{
     						tell_object(esser,
            			"Bimalandon serviert Dir mit Blaettern gefuellte Pilze.\n" );
       					tell_room(this_object(),
                 "bimalandon serviert "+esser->name(WER)+" mit Blaettern gefuellte Pilze.\n",({ esser }) );
			          esser->AddMp(15);
  	         		esser->AddHp(15);      
							}
     				if(heili==1)
     					{
     						tell_object(esser,
            			"Bimalandon serviert Dir mit Kaese gefuellte Pilze.\n" );
       					tell_room(this_object(),
                 "bimalandon serviert "+esser->name(WER)+" mit Kaese gefuellte Pilze.\n",({ esser }) );
			          esser->AddMp(22);
  	         		esser->AddHp(22);      
							}
     				if(heili==2)
     					{
     						tell_object(esser,
            			"Bimalandon serviert Dir mit Spinat gefuellte Pilze.\n" );
       					tell_room(this_object(),
                 "bimalandon serviert "+esser->name(WER)+" mit Spinat gefuellte Pilze.\n",({ esser }) );
			          esser->AddMp(30);
  	         		esser->AddHp(45);      
							}
     				if(heili==3)
     					{
     						tell_object(esser,
            			"Bimalandon serviert Dir mit Zauberbohnen gefuellte Pilze.\n" );
       					tell_room(this_object(),
                 "bimalandon serviert "+esser->name(WER)+" mit Zauberbohnen gefuellte Pilze.\n",({ esser }) );
			          esser->AddMp(45);
  	         		esser->AddHp(45);
  	         		esser->command("furz");      
							}
						}
           else
           	write("So viel kannst Du echt nicht mehr essen!\n");
      	}
       else
       		{
       			tell_object(esser,
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+esser->name(WER)+"!\n"+
            	"Bimalandon wirft Dir 200 Muenzen vor die Fuesse.\n");
       			tell_room(this_object(),
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+esser->name(WER)+"!\n"+
            	"Bimalandon wirft "+esser->name(WER)+" 200 Muenzen vor die Fuesse.\n", ({ esser }) );
  					ob = clone_object("/obj/money.lpc");
  					ob->SetProp(P_AMOUNT, 200);
  					ob->move(TO, M_SILENT);
  				}
			 }
			 
