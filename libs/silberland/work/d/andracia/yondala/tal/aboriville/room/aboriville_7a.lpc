// Restaurant nur Trinken ohne alk und vegetarisches Essen fuer Elfen und Naturvolk
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";

object ob;
int heili;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Pavillon aus Blaettern\n" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem Pavillon aus Blaettern und Aesten. Alles um "
    "Dich herum ist gruen, die Sonne blinzelt ab und zu durch die Blaetter "
    "und kitzelt Deine Nase. Rechts von Dir befindet sich eine huefthohe "
	"Trennwand." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "BIMALANDON");
  SetProp( P_PUBKEEPER_NAME, "Bimalandon");
  SetProp( P_PUBKEEPER_GENDER, MALE);
  AddItem(ELFEN_NPC + "elf_bimalandon.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "pavillon" }),
    "Du stehtst mitten in einem gruenen Pavillon welcher komplett aus "
    "Blaettern und Aesten gebildet wird.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Baeume leuchten gruen durch die Sonne die hin und "
    "wieder durchblinzelt und bilden um Dich herum einen hellen Pavillon");    
  AddDetail( ({ "aeste" }),
    "Die Aeste der Baeume haben sich zu leichten Waenden verwoben und bilden "
    "zusammen mit ihren Blaettern einen hellen Pavillon.");    
  AddDetail( ({ "sonne" }),
    "Die Sonne blinzelt hin und wieder zwischen den lichten Waenden hindurch "
    "und erhellt diese noch zusaetzlich von aussen.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen hier aus verwobenen Aesten und deren Blaettern, "
    "die durch die Sonne von aussen fast zu leuchten scheinen. An einer Wand "
    "haengt eine Brett.");    
  AddDetail( ({ "brett" }),
    "Auf diesem Brett steht etwas geschrieben, mit <menue> kannst Du es lesen.");    
  AddReadDetail( ({ "brett" }),
    "Tippe doch bitte <menue> ein um zu lesen was dort steht!");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festem Holz.");    

  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir wird von den Aesten der Baeume eingeramt, dazwischen "
    "blitzt ab und zu eine lachende Sonne auf Dich herunter.");    
  AddDetail( ({ "sonnenlicht","sonne","licht" }),
    "Das Licht der Sonne lacht auf Dich herunter und erhellt den Pavillon durch die Blaetter hindurch.");    
  AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
 	AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");    
 	AddDetail( ({ "kronen" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus hellen Blaettern und verwobenen Aesten. Hin und wieder lacht "
    "die Sonne dazwischen hindurch und auch der blaue Himmel ist manchmal zu sehen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddSpecialDetail( ({ "trennwand" }), "trennwand" );
  AddSpecialDetail( ({ "regale","regal" }), "regale" );
  AddSpecialDetail( ({ "thekenwand" }), "thekenwand" );
  AddSpecialDetail( ({ "zwecke" }), "zwecke" );
  AddSpecialDetail( ({ "speisen", "getraenke" }), "speisen" );
  AddSpecialDetail( ({ "blick" }), "blick" );
  AddSpecialDetail( ({ "ding", "dinge" }), "dinge" );
  AddSpecialDetail( ({ "wand", "waende" }), "waende" );


  AddDrink("Morgentau", ({ "tau", "morgentau" }),20,0,0,0,"tau_cmd"); 
  AddDrink("Fruchtsaft", ({ "saft","fruchtsaft" }),60,0,0,0,"saft_cmd"); 
  AddDrink("Nektar", ({ "nektar" }),70,0,0,0, "nektar_cmd");
  AddDrink("Himbeersorbet", ({ "himbeer", "sorbet" }),120,0,0,0,"sorbet_cmd"); 
  AddDrink("Suesse Sojamilch", ({ "sojamilch", "milch" }),350,0,0,0,"milch_cmd"); 
  AddDrink("Notfalltropfen", ({ "tropfen", "notfalltropfen" }),5000,0,0,0,"tropfen_cmd");      
	AddFood("Obstsalat", ({"obst","obstsalat", "salat"}),50,0,0,"obst_cmd");
	AddFood("Nussecke", ({"nussecke","nuss","ecke"}),130,0,0,"nuss_cmd");
	AddFood("gefuellte Pilze", ({"pilze","gefuellte pilze"}),200,0,0,"pilze_cmd");
	AddFood("Bucheckernmousse", ({"bucheckernmousse","bucheckern","eckern","mousse"}),500,0,0,"mousse_cmd");
	AddFood("Trueffelpastete", ({"trueffel","pastete","trueffelpastete"}),600,0,0,"pastete_cmd");

  AddDetail( ({ "nase" }),
    "Wenn Du immer Deine Nase folgst kannst Du hier einige Abenteuer erleben.");    
  AddDetail( ({ "abenteuer" }),
    "Viele Abenteuer warten auf Dich.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm frisch nach Wald, aber auch nach koestlichen Speisen.");

  AddSmell( ({ "wald" }),
    "Es riecht nach dem Harz der Baeume, die Dich umgeben.");
  AddSmell( ({ "harz","baeume" }),
    "Ein sehr wuerziger Geruch.");
  AddSmell( ({ "speisen","speisen" }),
    "Wirklich lecker, jam, Du bekommst Lust etwas zu bestellen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume im Wind und das froehliche Zwitschern der Voegel in den Baeumen.");

  AddSound( ({ "rauschen","wind" }),
    "Ein leichter Wind sorgt fuer ein leises Rauschen in den Baeumen.");
  AddSound( ({ "zwitschern","voegel" }),
    "Ein paar Voegel zwitschern froehliche Lieder.");
  AddSound( ({ "lieder","melodie" }),
    "Die Melodie ist wunderschoen.");




AddExit( "nordosten", ELFEN_ROOM  + "aboriville_6b.lpc" ); 

}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
	  	result = BS("Du stehst mitten in einem Pavillon aus Blaettern und Aesten. Alles um "
      "Dich herum ist gruen, die Sonne blinzelt ab und zu durch die Blaetter "
      "und kitzelt Deine Nase. Rechts von Dir befindet sich eine hoelzerne Theke. ") ;
    }	else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}

string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler")|| 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
	  	result = BS("Im Restaurant \"Zum gruenen Pavillon\"") ;
    }	else {
    	result = QueryProp(P_INT_SHORT);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}


string trennwand()
 {
	if( TP->id("Elfenspieler") || present("\nelfenkraut",TP) )
	  {
	  	return "Dabei handelt es sich um eine Theke.\n";
	  }
	  return "Du bist Dir nicht sicher, welchem Zwecke diese Trennwand dient.\n";	
 } 

string zwecke()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Ich frage mich grad, warum Du hier dieses Detail untersuchst...\n";
	  }
	  return "Ob es sich um eine Theke handelt?\n";	
 } 


string theke()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	if(present ("BIMALANDON", environment(TP)))
	  		return "Hinter der Theke steht Bimalandon und wartet auf Deine "
	  		"Bestellung. An der Thekenwand befinden sich einige Regale.\n";
	  	else
	  		return "Leider ist gerade kein Wirt anwesend. An der Thekenwand "
	  		"befinden sich einige Regale.\n";
	  }
	  	if(present ("BIMALANDON", environment(TP)))
	  		return "Du bist Dir absolut nicht sicher, da Du einfach mit Deinem "
	  		"beschraenktem Blick nicht viel erkennen kannst. Elf muesste man "
	  		"sein...\nHinter der Trennwand steht Bimalandon und schaut Dich "
	  		"naseruempfend an.\n";
	  	else
	  		return "Du bist Dir absolut nicht sicher, da Du einfach mit Deinem "
	  		"beschraenktem Blick nicht viel erkennen kannst. Elf muesste man sein...\n";
 } 
 

string thekenwand()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "An der Thekenwand befinden sich einige Regale.\n";
	  }
	  return 0;
 } 

string regale()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "In den Regalen befinden sich Flaschen, Lebensmittel und Dinge, "
	  	"die man in einem Restaurant nunmal braucht.\n";
	  }
	  return 0;
 } 

string flaschen()
 {
	if( TP->id("Elfenspieler")|| 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Du siehst grosse, kleine, schlanke und bauchige Flaschen "
	  	"welche so natuerlich gewachsen scheinen, dass sie sich nur mit "
	  	"geuebten Blick von der Wand unterscheiden lassen. In ihnen befinden sich "
	  	" Getraenke, die Du hier bestellen kannst.\n";
	  }
	  return 0;
 } 

string lebensmittel()
 {
	if( TP->id("Elfenspieler")|| 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "In den Regalen stehe einige Behaelter in denen sich Speisen "
	  	"befinden, die Du hier bestellen kannst. \n";
	  	}
	  return 0;
 } 

string behaelter()
 {
	if( TP->id("Elfenspieler")|| 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Du siehst verschiedene Behaelter, die so gut getarnt sind, dass "
	  	"sie sich nur mit geuebten Blick von der Wand unterscheiden lassen. In "
	  	"ihnen befinden sich verschiedene Speisen, die Du hier bestellen kannst.\n";
	  }
	  return 0;
 } 

string dinge()
 {
	if( TP->id("Elfenspieler") || 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Unterschiedlichste Dinge wie Besteck, Kerzen, Geschirr und "
	  	"Trinkgefaesse. All diese Dinge sind enstanden wie die Bimalandon sie "
	  	"erwuenscht hat. Sie unterscheiden sich kaum von der umgebung und nur "
	  	"ein klarer Blick mag sie zu erkennen.\n";
	  }
	  return 0;
 } 
 
string restaurant()
 {
	if( TP->id("Elfenspieler")|| 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Du befindest Dich im Restaurant des ehrenwerten Bimalandon.\n";
	  }
	  return "Ob Du hier in einem Restaurant bist?\n";	
 }  
 
string speisen()
 {
	if( TP->id("Elfenspieler")|| 
		  
		  present("\nelfenkraut",TP) )
	  {
	  	return "Was Du bestellen kannst siehst Du, wenn Du <menue> eintippst.\n";
	  }
	  return "Vielleicht solltest Du mal <menue> tippen um zu sehen, was es hier geben koennte!?\n";	
 }  
 
string blick()
 {
	if( TP->id("Elfenspieler"))
		return "Mit dem klaren Blick eines Elfen erkennst Du viele Dinge, die "
		"anderen entgehen koennten.\n";
	if (TP->QueryProp(P_GUILD) == "Naturvolk")
		return "Durch Deine Naehe zur Natur erkennst Du viele Dinge, die "
		"anderen entgehen koennten.\n";
	if (present("\nelfenkraut",TP) )
		return "Das Elfenkraut hat Deinen Blick gestaerkt, nun erkennst Du viele "
		"Dinge, die anderen entgehen koennten.\n";
	  return "Leider ist Dein Blick getruebt und nicht offen genug fuer vieles. "
	  "Vielleicht koenntest Du das aendern?\n";	
 }   
 


tau_cmd(object zahler, object trinker)
     {
     	if(TP->id("Elfenspieler"))
     		{
     			if (trinker->drink_soft(2, 0))
     			{
     				tell_object(trinker,
            	"Bimalandon greift nach einem grossen Blatt und laesst Dir den Tau direkt in den "
            	"Mund fliessen.\n" );
       			tell_room(this_object(),
                 "Bimalandon giesst "+trinker->name(WER)+" frischen Morgentau direkt in den Mund.\n",({ trinker }) );
	           trinker->AddMp(6);
  	         trinker->AddHp(6);      
						}
           else
           	write("So viel kannst Du echt nicht mehr trinken!\n");
      	}
       else
       		{
       			tell_object(trinker,
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+trinker->name(WER)+"!\n"+
            	"Bimalandon wirft Dir 70 Muenzen vor die Fuesse.\n");
       			tell_room(this_object(),
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+trinker->name(WER)+"!\n"+
            	"Bimalandon wirft "+trinker->name(WER)+" 20 Muenzen vor die Fuesse.\n", ({ trinker }) );
  					ob = clone_object("/obj/money.lpc");
  					ob->SetProp(P_AMOUNT, 20);
  					ob->move(TO, M_SILENT);
  				}
         }

