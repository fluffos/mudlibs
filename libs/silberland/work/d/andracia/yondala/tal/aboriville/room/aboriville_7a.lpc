tropfen_cmd(object zahler, object trinker)
     {
     	if(TP->id("Elfenspieler"))
     		{
     			
     			if (trinker->drink_soft(1, 0))
     			{
     				trinker->SetProp(P_DRINK, trinker->QueryProp(P_MAX_DRINK));
     				
     				tell_object(trinker,
            	"Bimalandon reicht Dir einen kleinen Trinkschlauch und Du nimmst einen "
            	"tiefen Schluck daraus.\nDu fuehlst wie Dein Koerper gereinigt wird.\n" );
       			tell_room(this_object(),
                 trinker->name(WER)+" trinkt einen tiefen Schluck aus einem Schlauch, "
                 "den Bimalandon "+trinker->QueryPronoun(WEM)+" hinhaelt.\n",({ trinker }) );
	           trinker->AddMp(200);
  	         trinker->AddHp(200);
  	         heili=random(4);
  	         if (heili==0)
  	         	trinker->Set_Prop(P_BLIND, 0);  	         
  	         if (heili==1)
  	         	trinker->Set_Prop(P_DEAF, 0);
  	         if (heili==2)
  	         	trinker->Set_Prop(P_POISON, 0);
  	         if (heili==3)
  	         	trinker->Set_Prop(P_FROG, 0);
  	         
 						}
           else
           	write("So viel kannst Du echt nicht mehr trinken!\n");
      	}
       else
       		{
       			tell_room(this_object(),"Bimalandon sagt: Ihr werdet hier nicht bedient, "+trinker->name(WER)+"!\n");
				
       			if (trinker->QueryProp(P_GUILD)!="zechpreller")
				{
					tell_room(this_object(), "Bimalandon wirft "+trinker->name(WER)+" 5000 Muenzen vor die Fuesse.\n", ({ trinker }) );				
					tell_object(trinker,"Bimalandon wirft Dir 5000 Muenzen vor die Fuesse.\n");
  					ob = clone_object("/obj/money.lpc");
  					ob->SetProp(P_AMOUNT, 5000);
				}
  					ob->move(TO, M_SILENT);
  			}
         }
        
obst_cmd(object zahler, object esser)
     {
     	if(TP->id("Elfenspieler"))
     		{
     			if (esser->eat_food(5, 0))
     			{
     				tell_object(esser,
            	"Bimalandon schaelt und schnibbelt in atemberaubender Geschwindigkeit einige "
            	"Fruechte und serviert Dir den herlichsten Obstsalat, den Du je gegessen hast. "
            	"Du verputzt ihn auf der Stelle.\n" );
       			tell_room(this_object(),
                 esser->name(WER)+" bekommt von Bimalandon einen Obsalat frisch zubereitet.\n",({ esser }) );
	           esser->AddMp(10);
  	         esser->AddHp(30);      
						}
           else
           	write("So viel kannst Du echt nicht mehr essen!\n");
      	}
       else
       		{
       			tell_object(esser,
            	"Bimalandon sagt: Ihr werdet hier nicht bedient, "+esser->name(WER)+"!\n"+
            	"Bimalandon wirft Dir 50 Muenzen vor die Fuesse.\n");
       			tell_room(this_object(),
