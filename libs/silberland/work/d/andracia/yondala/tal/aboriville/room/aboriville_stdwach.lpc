//erstmal nur die mit dem Elfenkilleritem und Piratenelfen. Mal schaun, welche Rassen/Gilden etc da noch zukommen.
feindcheck()
{
	if(TP->QueryProp(P_GUILD)=="Pirat"&&TP->id("Elfenspieler")||present ("\nelfenkiller", TP))
		return("Du bist einer von Ihnen, also sei vorsichtig.\n");
		
	else
		return("Die Elfenwaechter erkennen Feinde meist schon, wenn sie durch den Wald unterhalb "
						"der Stadt laufen und reagieren sofort.\n");	
	
	}

