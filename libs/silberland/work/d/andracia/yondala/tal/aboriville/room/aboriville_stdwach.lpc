//Beinhaltet Details und das Add fuer die Kletterfunktion
//Beinhaltet short und long fuer die Wachwege


#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
int frucht = 0;
object wohin;
int da;


void reset()
{::reset();
da=random(3);
if(da==0)	
	frucht = 1;
}	


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Wachweg" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf dem Wachweg vor der Elfenstadt Aboriville. Der schmale Weg fuer um einige "
    "alte Buchen herum und wird auf der Innenseite durch jene Buchen und auf der Aussenseite "
    "durch ein Gelaender begrenzt." );


  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");    
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir wird von den Aesten der Baeume eingeramt, dazwischen "
    "blitzt ab und zu eine lachende Sonne auf Dich herunter.");    
  AddDetail( ({ "sonnenlicht","sonne","licht" }),
    "Das Licht der Sonne lacht auf Dich herunter und erhellt den Platz an dem Du stehst.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste der Baeume aus denen Aboriville gewachsen ist geben den Blick in "
    "den Himmel frei. Hin und wieder haengen an ihnen einige Fruechte.");    
  AddDetail( ({ "fruechte","frucht" }),
    "Schillerne Fruechte schauen immer wieder zwischen den Blaettern der Baeume hindurch.");    
   AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");    
  AddDetail( ({ "blaetter" }),
    "Die Blaetter ueber Dir geben den Blick in den Himmel frei, wenn es regnet bilden "
    "sie jedoch sofort ein dichtes Dach.");    
  AddDetail( ({ "blick" }),
    "Ein Blick nach oben zeigt Dir den blauen Himmel und die lachende Sonne.");    
  AddDetail( ({ "dach" }),
    "Jetzt gerade scheint doch die Sonne auf Dich herab.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht in der ganzen Stadt aus Holz.");    
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");    
  AddDetail( ({ "kronen" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baueme im Wind und das froehliche Zwitschern der Voegel in den Baeumen.");

  AddSound( ({ "rauschen","wind" }),
    "Ein leichter Wind sorgt fuer ein leises Rauschen in den Baeumen.");
  AddSound( ({ "zwitschern","voegel" }),
    "Ein paar Voegel zwitschern froehliche Lieder.");
  AddSound( ({ "lieder","melodie" }),
    "Die Melodie ist wunderschoen.");
  AddSound( ({ "" }),
    "");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "wachweg","weg" }),
    "Der Weg besteht aus den ineinander verwachsenen Aesten der Buchen. Auf ihm patroullieren "
    "die Elfenwaechter regelmaessig um nach Feinden Ausschau zu halten.");    
  AddDetail( ({ "aeste", "ast" }),
    "Die Aeste unter Dir sind so fest zusammen gewachsen, dass ein solider Wachweg entstanden ist. "
    "Die Aeste ueber Dir geben den Blick in den Himmel frei. Hin und wieder haengen an ihnen einige Fruechte.");    
  AddDetail( ({ "buchen","buche" }),
    "Die meisten der Baeume, auf denen Aboriville gewachsen ist, sind Buchen.");    
  AddDetail( ({ "aboriville" }),
    "Du befindest Dich auf dem Wachweg der Elfenstadt Aboriville. Die Stadt liegt westlich von Dir.");    
  AddDetail( ({ "stadt", "elfenstadt" }),
    "Du befindest Dich oestlich von Aboriville.");    
  AddSpecialDetail( ({ "feinde","feind" }),"feindcheck");    
  AddDetail( ({ "wald" }),
    "Ueberall um Dich herum ist Wald, denn die Elfen leben im Einklang mit ihm.");    
  AddDetail( ({ "einklang" }),
    "Die Elfen leben mit, vom und im Wald.");    
  AddDetail( ({ "innenseite" }),
    "Auf der Innenseite des Wachweges befinden sich die dichten Kronen der Baeume, auf "
    "denen die Stadt gewachsen ist.");    
  AddDetail( ({ "aussenseite" }),
    "Die Aussenseite des Wachweges wird durch ein starkes Gelaender beschraenkt.");    
  AddDetail( ({ "gelaender" }),
    "Das Gelaender besteht aus vielen Aesten, die sich ineinander verwoben haben um "
    "den Elfenwaechtern und anderen Personen festen Halt zu geben. Du kannst daran aber auch "
    "nach unten auf den Waldweg klettern.");    
  AddDetail( ({ "person","personen" }),
    "Zum Beispiel Dir.");    
  AddDetail( ({ "halt" }),
    "Damit Du und andere nicht herunterfallen.");    
  AddDetail( ({ "ausschau" }),
    "Die Elfenwaechter halten stets nach Feinden Ausschau, denn sie werden Aboriville mit ihrem "
    "Leben verteidigen.");    
  AddDetail( ({ "leben" }),
    "Die Elfenwaechter wuerden ihr Leben opfern um ihre Stadt und ihren Wald zu retten.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus den ineinander verwachsenen Aesten der Baeume.");    
  AddDetail( ({ "kronen" }),
    "Du bist so hoch oben in den Baeumen, dass hier schon deren Kronen beginnen.");    
  AddDetail( ({ "waldweg" }),
    "Der ist weit unter Dir. Du kannst hinunter klettern.");    
  AddDetail( ({ "blaetter" }),
    "Die Baueme um Dich herum sind voller gruener Blaetter.");    

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm frisch nach Wald, Blueten und suessen Fruechten");

  AddSmell( ({ "wald" }),
    "Es riecht nach dem Harz der Baeume, die Dich umgeben.");
  AddSmell( ({ "harz","baeume" }),
    "Ein sehr wuerziger Geruch.");
  AddSmell( ({ "blueten","bluetenduft" }),
    "Ein leichter Hauch von Bluetenduft wird an Dich herangetragen.");
  AddSmell( ({ "fruechte" }),
    "Die Fruechte in den Bauemen verbreiten einen suesslichen Duft.");
AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
AddCmd( ({ "bitt", "bitte" }), "bitten" );

}

pfluecken(string str )
{
  notify_fail( "Was moechtest Du pfluecken?\n" );
  if( str == "frucht" )
	{
    write("Der Baum zieht den Ast mit der Frucht weg und haut Dir auf die Finger.\n");
    say( "Ein Ast schnellt hervor und schlaegt "+ TPN+" auf die Finger.\n");
		TP->do_damage(5,"Ein Ast");
   return 1;
  }
}

bitten(string str )
{
  notify_fail( "Wen moechtest Du um was bitten?\n" );
  if( str == "baum um frucht" )
	{
		if(TP->id("Elfenspieler")||TP->QueryProp(P_GUILD)=="Naturvolk")
		//if(TP->id("Elfenspieler")||TP->QueryProp(P_GUILD)=="naturvolk")
			{
				if (frucht==1)
					{
						write("Der Baum schenkt Dir eine Frucht.\n");
    				say( TPN+" bekommt eine Frucht vom Baum geschenkt.\n");
   					CLONE(ELFEN_OBJ + "elfenfrucht.lpc", TP);//muss noch gemacht werden
   					frucht=0;
   					}
   				else
   					write("Der Baum rauscht: Ich habe leider gerade keine Frucht fuer Euch.\n");
   			return 1;
   		}	
   		else //Wenn weder Elf noch Naturvolk
   			{write("Der Baum rauscht: Fuer Wesen wie Euch habe ich keine Frucht.\n");
   				return 1;}
  	}
return 0;
}
