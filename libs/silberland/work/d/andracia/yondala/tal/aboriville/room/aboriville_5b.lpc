#include "../def.h"
inherit "std/post";
#include <properties.h>
#include <language.h>


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem hohlen Baum\n" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem holen Baumstamm. Viel mehr als die gruenen "+
    "Blaetter der Baeume und das Holz der Innenseite des Baumes siehst Du nicht." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddSpecialDetail( ({ "wand", "waende" }), "waende" );
  AddSpecialDetail( ({ "faecher" }), "faecher" );
  AddSpecialDetail( ({ "post" }), "post" );
  AddSpecialDetail( ({ "abholung" }), "abholung" );
  AddSpecialDetail( ({ "boden" }), "boden" );
  AddSpecialDetail( ({ "spuren" }), "spuren" );
  AddSpecialDetail( ({ "hohlraum" }), "hohlraum" );
  AddSpecialDetail( ({ "elf" }), "elf" );





  AddDetail( ({ "innenseite" }),
    "Die Innenseite des Baumes besteht natuerlich aus Holz.");
  AddDetail( ({ "baum", "baumstamm" }),
    "Du befindest Dich in einem holen Baum.");
  AddDetail( ({ "blaetter" }),
    "Um Dich herum sind viele Blaetter, welche sogar teilweise den Baumstamm verdecken.");
  AddDetail( ({ "aboriville", "elfenstadt","stadt", "andracia", "welt" }),
    "Du befindest Dich in der Elfenstadt Aboriville in der Welt von Andracia.");
  AddDetail( ({ "holz" }),
    "Das Holz dieser Stadt waechst genauso, wie es benoetigt wird.");
  AddDetail( ({ "baeume" }),
    "Die Elfenstadt Aboriville entstand aus einigen maechtigen Baeumen.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus Holz, darunter schweben einige Gluehwuermchen und spenden etwas Licht.");
  AddDetail( ({ "gluehwuermchen" }),
    "Die gluehwuermchen spenden ausreichend Licht.");
  AddDetail( ({ "holz" }),
    "Das Holz der Baeume waechst genaus so, wie die Elfen es brauchen.");
  AddDetail( ({ "elfen" }),
    "Die Elfen leben hier, in dieser Stadt.");
  AddDetail( ({ "licht" }),
    "Es faellt wenig Licht von draussen herein, das meiste stammt von den Gluehwuermchen ueber Dir.");
  AddDetail( ({ "platz" }),
    "Hier ist genug Platz.");
  AddDetail( ({ "kronen" }),
    "Du befindest Dich hier hoch oben in den ausladenden Kronen kraeftiger Baeume.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume im Wind und das froehliche Zwitschern der Voegel in den Baeumen.");

  AddSound( ({ "rauschen","wind" }),
    "Ein leichter Wind sorgt fuer ein leises Rauschen in den Baeumen.");
  AddSound( ({ "zwitschern","voegel" }),
    "Ein paar Voegel zwitschern froehliche Lieder.");
  AddSound( ({ "lieder","melodie" }),
    "Die Melodie ist wunderschoen.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm frisch nach Wald, Blueten und suessen Fruechten");

  AddSmell( ({ "wald" }),
    "Es riecht nach dem Harz der Baeume, die Dich umgeben.");
  AddSmell( ({ "harz","baeume" }),
    "Ein sehr wuerziger Geruch.");
  AddSmell( ({ "blueten","bluetenduft" }),
    "Ein leichter Hauch von Bluetenduft wird an Dich herangetragen.");
  AddSmell( ({ "fruechte" }),
    "Die Fruechte in den Baeumen verbreiten einen suesslichen Duft.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
/*
  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");


  AddSmell( ({ "" }),
    "");

*/

AddExit( "sueden", ELFEN_ROOM  + "aboriville_6b.lpc" );

}
 
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	
	if( viewer->id("Elfenspieler") || 
		  viewer->QueryProp(P_GUILD) == "Naturvolk" ||
		  present("\nelfenkraut", viewer) )
	  {
      result = BS("Du stehst in der Postzentrale von Aboriville. An den Waenden "+
      "rund um Dich herum befinden sich viele kleine und grosse Faecher in "+
      "denen die Post der Einwohner verteilt ist. An einer Wand siehst Du "+
      "einen Hohlraum in dem ein laechelnder Elf sitzt und Post sortiert.");
    }
else {
    	result = QueryProp(P_INT_LONG);
    }	
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}

string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;

  if( viewer->id("Elfenspieler") ||
      viewer->QueryProp(P_GUILD) == "Naturvolk" ||
      present("\nelfenkraut", viewer) )
    {
      result = BS("In der Postzentrale von Aboriville") ;
    } else {
      result = QueryProp(P_INT_SHORT);
    }
    result += GetExits(viewer);
    result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
    return result;
}

string waende()
{
  if( TP->id("Elfenspieler") ||
      
      present("\nelfenkraut", TP) )
    {
      return BS("An den Waenden befinden Sich viele kleine Faecher mit Post, "+
      "die darauf wartet abgeholt zu werden. An einer Wand ist ein kleiner "+
      "Hohlraum.");
    }
    return BS("Die Waende bestehen aus Holz und werden von vielen Blaettern fast verhuellt.");
}

string faecher()
{
  if( TP->id("Elfenspieler") ||
      
      present("\nelfenkraut", TP) )
    {
      return BS("In den Faechern befindet sich die Post der Anwohner Aborivilles.");
    }
    return 0;
}

string post()
{
  if( TP->id("Elfenspieler") ||present("\nelfenkraut", TP) )
    {
      return BS("Die Post fuer die Anwohner Aborivilles wurde in die Faecher sortiert und liegt zur Abholung bereit.");
    }
    return 0;
}

string abholung()
{
  if( TP->id("Elfenspieler") || present("\nelfenkraut", TP) )
    return BS("Die Anwohner Aborivilles koennen ihre Post hier jederzeit abholen.");
  return 0;
}

string boden()
{
  if( TP->id("Elfenspieler") ||present("\nelfenkraut", TP) )
    return BS("Der Boden besteht aus Holz, Du kannst einige Spuren erkennen.\n");
    return "Der Boden besteht aus Holz.\n";
}

  string spuren()
{
  if( TP->id("Elfenspieler") ||present("\nelfenkraut", TP) )
    return BS("Obwohl die Elfen kaum Spuren hinterlassen siehst Du einige, "+
      "denn dieser Baum wird oft von ihnen aufgesucht.");
    return 0;
}

string hohlraum()
{
  if( TP->id("Elfenspieler") || present("\nelfenkraut", TP) )
    return BS("In dem Hohlraum sitzt ein Elf und sortiert Post.");
  return 0;
}

string elf()
{
  if( TP->id("Elfenspieler") ||present("\nelfenkraut", TP) )
     return BS("Der Elf im Hohlraum ist dafuer zustaendig die Post der Elfen "
      "zu sortieren und in die entsprechenden Faecher zu verteilen. Er nickt "
      "Dir freundlich zu und sortiert dann weiter.");
    return 0;
}