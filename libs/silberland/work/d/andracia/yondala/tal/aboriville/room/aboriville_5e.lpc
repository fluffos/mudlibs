#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG, "Du betrittst einen kleinen Garten. \n"+
    "Ein frischer Geruch von Blumen und Kraeutern weht Dir entgegen. \n"+
    "Der Boden unter Deinen Fuessen ist recht weich. \n"+
    "Hier steht ein kleines Holzschild in einem kleinen Wieschen.\n" );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(ELFEN_NPC + "maus.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "boden" }),
    "Du laeufst auf einem Kiesweg der von Blumenbeeten gesaeumt wird.\n");    
  AddDetail( ({ "himmel" }),
    "Du sieht einen blauen Himmel durch das Blaetterwerk.\n");    
  AddDetail( ({ "garten" }),
    "Du befindest Dich in einem Garten.\n");    
  AddDetail( ({ "blumen", "blumenbeet", "beet", "blumenbeeten", "beeten", "blumenbeete", "beete" }),
    "Du siehst ein paar verschieden farbige Rosen.\n");    
  AddDetail( ({ "rose", "rosen" }),
    "Sie duften herrlich.\n");    
  AddDetail( ({ "nase" }),
    "Du hast sie in Deinem Gesicht.\n");    
  AddDetail( ({ "brisi" }),
    "Sie ist nicht hier.\n");    
  AddDetail( ({ "kraeuter" }),
    "Es sind eine Anzahl verschiedener Kraeuter zu sehen, jedoch nicht in Deiner Naehe.\n");    
  AddDetail( ({ "anzahl", "zahl" }),
    "Es sind zuviele zum zaehlen in diesem Garten.\n");    
  AddDetail( ({ "naehe" }),
    "Sie sind zuweit weg um sagen zu koennen welche Kraeuter es sein koennten.\n");    
  AddDetail( ({ "gesicht" }),
    "Du hast sicherlich eins irgendwo.\n");    
  AddDetail( ({ "geruch" }),
    "Versuchs mal mit riechen.\n");    
  AddDetail( ({ "fuesse", "fuessen" }),
    "Du stehst auf ihnen.\n");    
  AddDetail( ({ "voegel" }),
    "Du siehst keine. Vielleicht sitzen sie in der Baumkrone, schau doch mal zum Himmel.\n");    
  AddDetail( ({ "melodie" }),
    "Versuchs mal mit lauschen.\n");  
  AddDetail( ({ "holzschild", "holzschildes", "schild" }),
    "Es wurde hier in den Boden gesteckt. Du kannst es lesen.\n");  
  AddDetail( ({ "wieschen", "wiese" }),
    "Gruenes Gras saeumt die Standbeine des Holzschildes.\n");  
  AddDetail( ({ "gruen" }),
    "Es sieht gruen und gesund aus.\n");  
  AddDetail( ({ "gras" }),
    "Saftiges gruenes Gras dessen Grashalme sich im Wind bewegen.\n");  
  AddDetail( ({ "standbein", "standbeine", "beine" }),
    "Die Beine auf denen das Schild steht.\n");  
  AddDetail( ({ "saftiges", "saftig" }),
    "Ein helles kraeftiges gruen, das das Gras gesund aussehen laest.\n");  
  AddDetail( ({ "grashalme", "grashalm", "halme", "halm" }),
    "Naja, Halme halt, aus was Gras an sich so besteht.\n");  
  AddDetail( ({ "wind", "briese" }),
    "Eine leichte Briese weht die Grashalme sanft hin und her.\n");  
  AddDetail( ({ "kiesweg", "weg" }),
    "Er besteht aus kleinen Kieselsteinen, die auf dem Boden zwischen den Beeten verteilt wurden.\n");    
  AddDetail( ({ "kies", "kiesel", "kieseln", "kieselsteinen", "kieselstein", "steinen", "steine", "steinchen" }),
    "Kleine Steinchen die aneinander gelegt den Weg ergeben auf dem Du stehst.\n");    
  AddDetail( ({ "blaetterwerk", "werk", "blaetter" }),
    "Die Baumkronen ueber Dir verhindern eine freie Sicht auf den Himmel.\n");    
  AddDetail( ({ "baumkronen", "kronen", "baumkrone", "krone" }),
    "Die Baumkronen, unter denen Aboriville auf den starken Aesten der grossen Eichen erbaut wurde, "+
    "sind riesig, sie geben nur teilweise die Sicht auf den Himmel frei.\n");  
  AddDetail( ({ "sicht", "sehen" }),
    "Nach was schaust Du denn.\n");  
  AddDetail( ({ "aboriville", "aborivilles" }),
    "Du befindest Dich hier in einem kleinen Garten in der Elfenstadt Aboriville.\n");  
 AddDetail( ({ "elfenstadt" }),
    "Du befindest Dich in Aboriville.\n");  
 AddDetail( ({ "aeste", "ast", "aesten" }),
    "Sie sind sehr stark und tragen die Last Aborivilles.\n");  
 AddDetail( ({ "eichen", "eiche" }),
    "Eichen sind sehr starke Baeume.\n");  
 AddDetail( ({ "baum", "baeume" }),
    "Du wirst doch wohl wissen was ein Baum ist, oder?\n");  
 AddDetail( ({ "last" }),
    "Die Last der Elfenstadt Aboriville wird von den starken Aesten alter Eichen getragen.\n");  
    

  AddReadDetail( ({ "holzschild", "schild" }),
    " _______________________________\n"+
    "|                               |\n"+
    "|         Brisi's Garten        |\n"+
    "|       Blumen und Kraeuter     |\n"+
    "|      pfluecken VERBOTEN!!!    |\n"+
    "|_______________________________|\n"+
    "        |  |          |  |       \n"+
    "        |  |          |  |       \n"+
    "        |  |          |  |       \n"+
    "         \\/            \\/      \n");
            
  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.\n");

  AddSound( ({ "voegel", "zwitschern" }),
    "Die Voegel zwitschern eine liebliche Melodie.\n");

  AddSound( ({ "melodie" }),
    "Die Voegel zwitschern melodisch, aber Du kannst sie nicht verstehen.\n");
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blumen.\n");
    
  AddSmell( ({ "geruch" }),
    "Der Geruch von Rosen steigt Dir in die Nase.\n");

  AddSmell( ({ "rose", "rosen", "blume", "blumen" }),
    "Sie riechen herrlich.\n");

AddCmd( ({ "pfluecke" }), "CMD_pfluecken" );


AddExit( "nordwesten", ELFEN_ROOM  + "aboriville_4d.lpc" ); 
AddExit( "osten", ELFEN_ROOM  + "aboriville_5f.lpc" ); 
AddExit( "sueden", ELFEN_ROOM  + "aboriville_6e.lpc" ); 

}


int CMD_pfluecken(string str )
{
  notify_fail( "Was willst Du pfluecken?\n" );
  if( str != "blume" && str != "blumen" && str != "rose" && str != "rosen" ) return 0;   
  write("Brisi teilt Dir mit: Bitte lasst meine Blumen an ihrem Platz.\n");
  say( "Beim Versuch einen Blume zu pfluecken haelt " +TPN+ " ploetzlich inne. \n"+"Was mag "+TPN+" wohl grad durch den Kopf gehen...\n");  
  return 1;
}



