inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int groesse;

void create() {
  if (!is_clone(TO)) return;
  ::create();

groesse = random(2);
switch(groesse)
{	case 1: {      
  SetProp(P_SHORT, "Ein grosser Hase");
  SetProp(P_LONG,
    "Du siehst einen grossen grauen Hasen, der hier nach Futter sucht.");
	SetProp(P_NAME_ADJ, "gross");
	create_default_npc(3);
	break;}

	default: {
  SetProp(P_SHORT, "Ein kleiner Hase");
  SetProp(P_LONG,
    "Du siehst einen kleinen grauen Hasen, der hier nach Futter sucht.");
  SetProp(P_NAME_ADJ, "klein");
  create_default_npc(2);
}}


  CLONEME(FAUN_OBJ "hasenpfote" );

  SetProp(P_NAME, "Hase");
  SetProp(P_GENDER, MALE);
  AddId(({"hase", "", ""}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Hase");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 600);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "hoppelt an");
  SetProp(P_MSGOUT, "hoppelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/tal/yondala/faunenwald") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, FAUN_ROOM "/d/tal/yondala/faunenwald/faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Hase");

  AddInfo(DEFAULT_INFO, "muemmelt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hase kann Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Der Hase stellt seine Lauscher auf.\n",
    "Der Hase muemmelt ein Blatt.\n"}) );
}


