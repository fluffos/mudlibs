#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Elfenkraut");
  SetProp(P_LONG,
    "Du siehst eine handvoll duftenden Elfenkrauts." );
  SetProp(P_INFO, "Man sagt dem Elfenkraut nach, dass es den Geist belebt und das Auge fuer "
  "die Natur oeffnet.\nAllerdings ist es nur begrenzt haltbar.");
  SetProp(P_NAME, "Elfenkraut");
  SetProp(P_GENDER, NEUTER);
  AddId("elfenkraut");

  SetProp(P_MATERIAL, MAT_MISC_HERBAL );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 50);
		call_out("weg",18000); //zerstoert sich in 5 Stunden

}

int weg()
{      this_object()->remove();
	}