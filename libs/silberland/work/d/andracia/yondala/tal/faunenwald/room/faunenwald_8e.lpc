#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>


string nachbarraum = "faunenwald_8f.lpc"; 

void init()
{
	::init();
	catch(call_other(FAUN_ROOM+nachbarraum,"???"));
	
	//if(interactive(TP)) 
		tell_room(to_object(FAUN_ROOM+nachbarraum), "Es raschelt auf der anderen Seite der Hecke.\n");
}

void reset()
{
  if (!present("FAKEBOERSE",TO)) 
  {
    AddItem(FAUN_OBJ + "fakeboerse.lpc",REFRESH_NONE);
	tell_room(TO,"Ploetzlich liegt eine Geldboerse auf dem Boden.\n");
	
	}
  ::reset();
}


void create() 
{
  ::create();

   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Osten von Dir ragt eine hohe Hecke in den Himmel empor." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(FAUN_NPC + "faun.lpc",REFRESH_DESTRUCT);
  AddItem(FAUN_OBJ + "fakeboerse.lpc",REFRESH_NONE);

  AddDetail( ({ "osten", "hecke" }),
    "Die Hecke oestlich von Dir ist so hoch, dass Du nicht darueber schauen kannst. Aber die "
    "Blaetter scheinen nicht so dicht zu sein.");

  AddDetail( ({ "blaetter" }),
    "Du kannst versuchen durch die Blaetter zu spaehen.");
  AddDetail( ({ "boden","waldboden" }),
    "Der Waldboden ist mit Tannennadeln gepolstert. Unter der Hecke wurde "
	"Laub angehaeuft.");
  AddDetail( ({ "laub" }),
    "Viele bunte Blaetter liegen hier angehaeuft.");
  AddDetail( ({ "haufen","laubhaufen" }),
    "Ob sich darin etwas verbirgt? Du koenntest ja mal darin wuehlen.");

  AddReadDetail( ({ "" }),
    "");



  AddSound( ({ "gelaechter" }),
    "Mittlerweile ist das Gelaechter in Gekicher ueber gehangen.");
 AddSound( ({ "gekicher","kichern" }),
    "Es kommt von unten.");




 AddExit( "norden", FAUN_ROOM +"faunenwald_7e" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_9e" ); 
 AddCmd(({"spaehe", "spaeh"}),"spaehen"); //Funktion
 AddCmd(({"wuehle", "wuehl"}),"wuehlen"); //Funktion
 //AddSpecialExit( "sueden", "suedengeher" ); 
 //AddSpecialExit( "norden", "nordengeher" ); 
}

int nordengeher(string dir)
{
  if(random(2))
  return this_player()->move(FAUN_ROOM +"faunenwald_7e", M_GO);
  return this_player()->move(FAUN_ROOM +"faunenwald_6e", M_GO);
 
}

int suedengeher(string dir)
{
  if(random(2))
  return this_player()->move(FAUN_ROOM +"faunenwald_9e", M_GO);
  return this_player()->move(FAUN_ROOM +"faunenwald_10e", M_GO);
 
}


varargs int PreventLeave(object ob, mixed dest)
  {
	if(!ob->id("FAKEBOERSE")) return 0;
	if(present("geldboerse",TP))
     {
       write("Du kannst immer nur eine Geldboerse gleichzeitig benutzen.\n");
       //move(environment(TP));
	   return 1;
	  }
    else
    {
      write("Gerade als Du Dich nach der Geldboerse bueckst, verschwindet sie.\n");
	  say(TPN+" will die Geldboerse aufheben.\nDie Geldboerse verschwindet.\n");
	  tell_room(TO,"Du hoerst schadenfrohes Gelaechter.\n");
	  present("FAKEBOERSE",TO)->remove();
	  return 0;// Wenn es eine Waffe ist, erheben wir sofort Einspruch
     }     
	  return ::PreventLeave(ob);
   }
	 
	 
int sound()
{say("Du hoerst ein Geraeusch hinter der Hecke.\n");}

int spaehen(string str) 
{
	string raumbeschreibung; 
	notify_fail("Wodurch moechtest Du spaehen?\n");
    if (str!="durch blaetter" && str!="durch hecke") return 0;
    
    raumbeschreibung = to_object(FAUN_ROOM+nachbarraum)->int_long(TP);
    
	write ("Du spaehst durch die Hecke und siehst:\n"+raumbeschreibung);
	say(TPN+" spaeht durch die Blaetter der Hecke.\n");
	tell_room(FAUN_ROOM+nachbarraum, TPN+" streckt kurz "+TP->QueryPossPronoun(MALE,WEN)+" Kopf durch die Hecke.\n");
	return 1;
}

int wuehlen(string str)
{
  notify_fail("Worin moechtest Du wuehlen?\n");
  if(str=="in laubhaufen"||str=="in haufen"||str=="in laub")
  {
    write("Du wuehlst in dem Laubhaufen herum und entdeckst einen kleinen "+
	      "Kobold, ");
	if(!present("FAKEBOERSE",TO))
    write("der eine Geldboerse an einer Schnur in der Hand haelt.\n");
	else 
	write("der eine Schnur in der Hand haelt, die an der Geldboerse "+
	      "festgebunden ist.\n");
    write("Der kleine Kobold streckt Dir die Zunge raus und bedeckt sich "+
	      "wieder mit Laub.\n");
	say(TPN+" wuehlt im Laub herum.\n",TP);
   return 1;
  }
return 0;
}  

	