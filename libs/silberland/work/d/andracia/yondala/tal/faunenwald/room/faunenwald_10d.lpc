//Die Gilde des Naturvolks

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein unschluessiger Raum");//"In der Gilde des Naturvolks" );
  SetProp( P_INT_LONG, "Niemand weiss, was hier mal sein wird. Forsche nicht, hier ist nichts.");
  /*
    "Du befindest Dich in der Gilde des Naturvolkes. Alles um Dich herum ist "
    "braun oder gruen, die Waende bestehen aus geflochtenen Weidenaesten. "
    "In der Mitte des Raumes befindet sich der Stamm der Weide unter der Du "
    "stehst. Dieser Ort scheint sehr friedlich zu sein." );*/
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
AddItem(FAUN_NPC + "faunus.lpc",REFRESH_DESTRUCT);
AddItem("/obj/zeitungsautomat.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "boden","waldboden" }),
    "Der Boden ist einfacher Waldboden, er ist mit Moos bedeckt und sieht sehr weich aus.");
  AddDetail( ({ "moos" }),
    "Das Moos ist saftig gruen und sieht sehr weich aus.");
  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen hier aus den herabhaengenden Zweigen der Weide, durch die waagerechte "
    "Zweige geflochten wurden um eine dichtere Wand zu schaffen.");
  AddDetail( ({ "zweige","zweigen" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");


 AddExit( "osten", FAUN_ROOM +"faunenwald_10e" ); 

 }


