//Dies hier ist die Standartleiche, in die sich die getoeteten Tiere verwandeln, 
//wenn der Killer zum Clan des Naturvolkes gehoert.

//created by Yondala@Andracia.
//begonnen am 11.11.2006 Und ich hoer heut erst auf, wenn das funzt.


inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tierleiche");
  SetProp(P_LONG,
    "Du siehst die sterblichen Ueberreste eines Tieres, das sein Leben fuer Dich geopfert hat." );
  SetProp(P_NAME, "Tierleiche");
  SetProp(P_GENDER, FEMALE);

SetProp(P_FOOD_STATE, F_RAW); //roh, klar

SetProp(P_FOOD_INFO, ([F_SOAK:5000, 
											 F_HEAL:({10,10}), // erst HP, MP, sollte 15 nicht ueberschreiten. Bei kleinen Tieren natuerlich niedriger.
											// F_HEAL:10, 
											 F_MSG: "Du verspeist eine Tierleiche, leise dankst Du dem Geist des Tieres.", //Der Text soll "netter" formuliert sein
											 F_MSG_ROOM: "verspeist eine Tierleiche und bedankt sich leise beim Geist des Tieres."]));


  AddId("tierleiche","leiche");

  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 150); //leichter als das Originaltier, klar.
  SetProp(P_VALUE, 50);//kommt drauf an, was es war. Aber sollte 100 nicht ueberschreiten


 
}