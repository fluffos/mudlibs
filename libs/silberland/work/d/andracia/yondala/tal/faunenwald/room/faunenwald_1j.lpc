//Noch SMell und Sound
#include "../def.h"
inherit "std/post";
#include <properties.h>



void create() 
{
  ::create();

   SetProp( P_INT_SHORT,
    "In der Eulerei" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Eulerei. Der Raum hier ist recht "
	"hell. Die Waende und auch die Decke bestehen aus den ineinander "
	"verwobenen Aesten der Birken, mitten durch den Raum stecken einige "
	"Stangen, auf denen wenige Eulen sitzen, die Dich neugierig betrachten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "eulerei" }),
    "Die Faune halten sich hier Eulen um ihre Post zu versenden.");
  AddDetail( ({ "faune" }),
    "Gerade ist keiner hier.");
  AddDetail( ({ "eulen" }),
    "Es sitzen ein paar Eulen auf den Stangen an der Wand und mustern Dich neugierig.");
  AddDetail( ({ "post" }),
    "Du kannst sicherlich auch Deine Post hier bearbeiten. Wenn Du dabei ungestoert sein "
    "moechtes, dann betrete einfach eine der beiden Kabinen.");
  AddDetail( ({ "kabinen", "ruhe" }),
    "Wenn Du Deine Post in Ruhe bearbeiten moechtest, dann betrete sie einfach.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier bestehen aus den miteinander verwobenen Aesten der Birken. "
    "An ihnen befinden sich einige Stangen fuer die Eulen.");
  AddDetail( ({ "stangen" }),
    "Die Stangen scheinen auch aus Birkenholz zu bestehen. Auf einigen davon sitzen ein paar Eulen.");
  AddDetail( ({ "birkenholz", "holz" }),
    "Der ganze Raum besteht fast ausschliesslich aus dem Holz der Birken.");
  AddDetail( ({ "raum" }),
    "Du bist Dir nicht sicher, ob dieser Raum natuerlich gewachsen ist oder ob da jemand "
    "nachgeholfen hat. Die Waende bestehen nur aus den Birken und ihren Blaettern. Die Decke "
    "ist hoch ueber Dir und durch sie hindurch glitzert warmes Sonnenlicht.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir und durch die hellen Blaetter der Birken glitzert warmes Sonnenlicht.");
  AddDetail( ({ "birken" }),
    "Dieser Raum besteht aus Birken, die innen nur wenige Aeste und Blaetter haben, deren "
    "aeussere Aeste allerdings fest miteinander verwoben sind, sodass dieser Raum entstand.");
  AddDetail( ({ "aeste" }),
    "Die aeusseren Aeste der Birken sind miteinander verwoben, sodass relativ stabile Waende "
    "entstanden sind. Die inneren Aeste sind kahle Stangen, auf denen ein paar Eulen sitzen.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Birken leuchten durch das Sonnenlicht hellgruen.");
  AddDetail( ({ "sonnenlicht" }),
    "Es glitzert sanft durch die Blaetter der Birken und erhellt diesen Raum.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit Blaettern und Eulenmist bedeckt.");
  AddDetail( ({ "eulenmist" }),
    "Das, was Eulen ab und zu fallen lassen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hier ein staendiges Flattern und Schnattern um Dich herum.");

  AddSound( ({ "flattern" }),
    "Die staendig landenden und startenden Eulen flattern um Dich herum.");
  AddSound( ({ "eulen" }),
    "Die Eulen flattern hauptsaechlich, ab und zu schuschut die eine oder "
	"andere vor sich hin.");
  AddSound( ({ "schuschu" }),
    "Schuschu! Schuschu!");
  AddSound( ({ "schnattern" }),
    "Die Eueln schnattern ab und zu, als wuerden sie sich unterhalten.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Wald und Eulenmist.");

  AddSmell( ({ "eulenmist" }),
    "Du beugst Dich runter und schnupperst an dem Eulenmist.\nPuh, nicht "
	"angenehm.");
  AddSmell( ({ "wald" }),
    "Nun, der Wald riecht waldig.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({"Eine Eule flattert herein, liefert ihre Post ab und setzt sich auf eine der Stangen.\n",
    	"Eine Eule plustert sich auf und laesst ploetzlich etwas fallen.\n"}),30,"func");



 AddExit( "westen", FAUN_ROOM +"faunenwald_1i" ); 
 }


