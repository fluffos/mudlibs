#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Weiter im Westen siehst Du eine grosse Trauerweide, deren Aeste bis "
	"zum Boden reichen. Im Osten ist ein grosses Gebuesch." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "westen", "trauerweide" }),
    "Viel kannst Du von hier aus nicht erkennen, Du solltest hingehen.");
  AddDetail( ({ "aeste" }),
    "Die Aeste der Trauerweide reichen bis auf den Boden. Was dahinter ist "
	"erkennst Du nicht.");
  AddDetail( ({ "gebuesch", "osten" }),
    "Im Osten ist ein Gebuesch. Man kann es scheinbar betreten.");
  AddDetail( ({ "" }),
    "");



 AddExit( "norden", FAUN_ROOM +"faunenwald_9f" ); 
 AddExit( "osten", FAUN_ROOM +"faunenwald_10g" ); 
 AddExit( "westen", FAUN_ROOM +"faunenwald_10e" ); 
 }


