#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Osten stehen einige hohe Birken." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(FAUN_NPC + "faun.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "osten" }),
    "Im Osten stehen einige hohe Birken.");
  AddDetail( ({ "birken" }),
    "Die Birken scheinen miteinander verwachsen und verwoben zu sein, sodass sie fast wie ein Gebaeude wirken.");
  AddDetail( ({ "gebaeude" }),
    "Du kannst nicht sehen, was sich darin befindet. Gehe nach Osten, wenn Du mehr erfahren moechtest.");
  AddDetail( ({ "" }),
    "");


  AddRoomMessage( 
    ({"Eine Eule flattert an Dir vorbei und verschwindet zwischen den Birken.\n",
    	"Eine Eule schiesst aus den Birken hervor und verschwindet.\n"}),60,"func");


 AddExit( "osten", FAUN_ROOM +"faunenwald_1j" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_2i" ); 
 AddExit( "westen", FAUN_ROOM +"faunenwald_1h" ); 
 }


