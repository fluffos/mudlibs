//Fauna, besitzt einen Laden.

inherit "/p/std/npc/druid_npc.lpc";
inherit "/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Fauna");
  SetProp(P_LONG,
    "Du siehst eine kleine, schmaechtige Faunin vor Dir. Sie ist bis auf "
    "ein breites Lederband unbekleidet, ihre Haut, sowie auch ihr Fell, "
    "welches unterhalb ihrer Huefte beginnt, sind braun, allerdings gibt es "
    "auch schon einige graue Haare dazwischen.");
  SetProp(P_NAME, "Fauna");
  SetProp(P_GENDER, FEMALE);
  AddId(({"fauna", "faunin", "FAUNA"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  //create_default_npc(30);
    create_default_druid("humus", 25, 12, 1800); 
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Faun");
  SetProp(P_SIZE, 155);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
//  SetProp(P_AGGRESSIVE,0);
//  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_WATER: -0.5, DT_AIR:    -0.5, 
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5]) );

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "kommt aus dem Wald");
  SetProp(P_MMSGOUT, "verschwindet im Wald");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Fauna");
  AddInfo(DEFAULT_INFO, "will darauf nicht antworten.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"hilfe","helfen"}),
    "Mit \"zeige\" bekommt Ihr eine Uebersicht der Waren die ich gerade im Angebot habe.\n"+
		"Mit \"unt <Nr> fuehre ich Euch den entsprechenden Gegenstand vor.\n"+
		"Wenn Ihr genuegend Muenzen dabei habt, verkaufe ich Euch den genannten Gegenstand. Teilt mir durch \"kaufe <Gegenstand>\" was ihr begehrt!\n"+
		"Solange ich solvent bin, kaufe ich auch gerne Waren. Bietet mir Eure Ware mittels \"verkaufe <Gegenstand>\" an!\n"+
		"Wollt Ihr etwas verkaufen, egal was ich Euch dafuer biete, so koennt Ihr es einfach mit \"versetze <Gegenstand>\"versetzen.\n"+
		"Lasst Ihr etwas durch \"schaetz <Gegenstand>\" von mir schaetzen, so sage ich Euch, was mir der Gegenstand wert ist.\n",
    "sagt: ");
  AddInfo( ({"uebersicht","ware","waren","zeige","zeigen"}),
    "Mit \"zeige\" bekommt Ihr eine Uebersicht der Waren die ich gerade im Angebot habe.",
    "sagt: ");
  AddInfo( ({"kaufen","kaufe","ankauf"}),
    "Wenn Ihr genuegend Muenzen dabei habt, verkaufe ich Euch den genannten Gegenstand. Teilt "
    "mir durch \"kaufe <Gegenstand>\" mit was ihr begehrt!",
    "sagt: ");
  AddInfo( ({"verkaufen","verkaufe","verkauf"}),
    "Solange ich solvent bin, kaufe ich auch gerne Waren. Bietet mir Eure Ware mittels "
    "\"verkaufe <Gegenstand>\" an!",
    "sagt: ");
  AddInfo( ({"versetzen","versetze"}),
    "Wollt Ihr etwas verkaufen, egal was ich Euch dafuer biete, so koennt Ihr das einfach mit "
    "\"versetze <Gegenstand>\" tun.",
    "sagt: ");
  AddInfo( ({"schaetzen","schaetz","schaetze"}),
    "Lasst Ihr etwas durch \"schaetz <Gegenstand>\" von mir schaetzen, so sage ich Euch, was "
    "mir der Gegenstand wert ist.",
    "sagt: ");
  AddInfo( ({"clan","naturvolk"}),
    "Der Clan des Naturvolks hat hier seinen Hauptsitz. Um mehr zu erfahren solltet Ihr Faunus besuchen.",
    "sagt: ");
  AddInfo( ({"faunus",""}),
    "Hier in diesem Wald lebt auch Faunus. Bei ihm koennt Ihr dem Clan des Naturvolks beitreten.",
    "sagt: ");
  AddInfo( ({"laden","waldladen"}),
    "Schaut Euch nur um, Ihr steht mittendrin.",
    "sagt: ");
  AddInfo( ({"waffe","waffen"}),
    "Waffen koennt Ihr bei mir nicht erwerben, tut mir leid.",
    "sagt: ");
  AddInfo( ({"kraut","elfenkraut"}),
    "Ich verkaufe Elfenkraut. Es hilft jenen, die keine Elfen sind, mehr in Aboriville zu sehen.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fauna will Deine Sachen nicht tragen.\n" }) );
}
/*  SetProp(P_SPELLRATE,50);
  AddSpell(1,0,
    "1.\n",
    "2.\n",
     DT_,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );

  SUID;
  CLONEME(FAUN_WEAPON "" );
  command("zuecke waffe");
  CLONEME(FAUN_ARMOUR "" );
  command("trage alles");
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt den "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "++Name(WER,1)" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

