// Die Kneipe 
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";


void create() 
{
  ::create();
   SetProp( P_INT_SHORT, 
    "Im goldenen Tannenzapfen." );

   SetProp( P_INT_LONG, 
    "Du befindest Dich unter einigen maechtigen Tannen, deren untere Aeste ein natuerliches "
    "Dach bilden. Hier ist es warm und sehr gemuetlich. Du fuehlst Dich so wohl, als saessest "
    "Du zuhause. Viel gibt es hier nicht, einige Pilze laden zum Hinsetzen ein. Ein grosser, "
    "roter Pilz scheint die Theke zu sein." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "SANDRUS");
  SetProp( P_PUBKEEPER_NAME, "Sandrus, der Faun");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddDrink("Tannenbier", ({ "bier", "tannenbier" }),500,50,5,8, //Preis, Volumen, Alk
  ({ "Sandrus zapft Dir ein dunkles Tannenbier, Du trinkst es sofort und bist ueberrascht "
  	"wie gut es schmeckt. ",
       "&& trinkt ein leckeres Tannenbier."
   }) );
     AddDrink("Waldbeerwein", ({ "wein", "waldbeerwein" }),650,50,7,8, //Preis, Volumen, Alk
  ({ "Sandrus oeffnet eine bauchige Flasche und schenkt Dir eine dunkle Fluessigkeit ein. Du "
  	"nippst erst zoegerlich, dann trinkst Du den Rest mit hoechstem Genuss. ",
       "&& geniesst einen koestlichen Waldbeerwein."
   }) );
  AddDrink("Stachelbeersaft", ({ "saft", "stachelbeersaft" }),70,5,0,8, //Preis, Volumen, Alk
  ({ "Sandrus zerstampft ein paar Stachelbeeren und drueckt diese dann durch ein Tuch. Er "
  	"faengt den Saft mit einem Becher auf und gibt ihn Dir.\n"
  	"Du denkst   . o O (Frischer geht wirklich nicht!)",
       "&& geniesst einen Becher Stachelbeersaft."
   }) );

  AddFood( "Pilzragout", ({ "pilz", "pilzragout", "ragout" }), 60,6,2,
            ({ "Sandrus greift unter die Theke und pflueckt ein paar frische Pilze. Dann "
            	"bereitet er sie fuer Dich zu und serviert sie Dir an Petersilienkartoffeln.",
                        "&& bestellt ein Pilzragout. "
            }) );    

  AddFood( "Geroestete Tannenzapfen", ({ "tannenzapfen", "zapfen" }), 60,6,2,
            ({ "Sandrus wirft einen Tannenzapfen in die Luft und schleudert einen kleinen "
            	"Feuerball darauf. Dann serviert er Dir den dampfenden Zapfen. Du verschlingst "
            	"ihn hoechst beeindruckt.",
                        "&& laesst sich einen Tannenzapfen roesten. "
            }) );    

  AddFood( "Paniertes Eichhoernchenschnitzel", ({ "eichhoernchenschnitzel", "schnitzel" }), 200,6,2,
            ({ "Sandrus greift in die Tanne, zieht ein wild um sich kratzendes Eichhoernchen "
            	 "heraus und bereitet es zu. \nDu isst es mit einem mulmigen Gefuehl.",
                        "&& verschlingt ein frisch zubereitetes Eichhoernchenschnitzel. "
            }) );    


  AddDetail( ({ "tannen" }),
    "Du stehst unter drei riesigen Tannen, deren Aeste so mit einander verwoben sind, "
    "dass sie ein dichtes, natuerliches Dach bilden. Die Staemme sind sehr dick und sehen aus "
    "wie hoelzerne Saeulen.");
  AddDetail( ({ "aeste", "aesten" }),
    "Die unteren Aeste der drei Tannen greifen mit ihren Nadeln so sehr ineinander, dass weder "
    "Sonnenlicht noch Wasser (falls es regnet) den Boden erreichen.");
  AddDetail( ({ "nadeln" }),
    "Die Nadeln der Aeste sind noch saftig gruen und sehen spitz aus. Du kannst allerdings keine "
    "ereichen.");
  AddDetail( ({ "sonnenlicht" }),
    "Wegen der verwobenen Aeste ueber Dir dringt kein Sonnenlicht in diesen Raum.");
  AddDetail( ({ "wasser" }),
    "Es regnet gerade nicht, aber selbst wenn es das taete, bist Du Dir sicher dass kein Wasser "
    "in diesen Raum dringen wuerde.");
  AddDetail( ({ "raum", "raumes", "kneipe", "goldenen", "tannenzapfen" }),
    "Du befindest Dich im \"Goldenen Tannenzapfen\".");
  AddDetail( ({ "dach", "decke" }),
    "Das Dach dieses Raumes besteht aus den ineinander verwobenen Aesten der drei grossen Tannen.");
  AddDetail( ({ "pilze" }),
    "Die kleineren Pilze laden zum Sitzen ein.");
  AddDetail( ({ "sitzen" }),
    "Setz Dich doch.");
  AddDetail( ({ "pilz" }),
    "Der grosse Pilz, der neben einem der drei Staemme steht scheint die Theke zu sein.");
  AddDetail( ({ "theke" }),
    "Auf dem Pilz, der die Theke darstellt, steht eine kleine Speisekarte.");
  AddDetail( ({ "speisekarte", "holzbrett", "brett","karte" }),
    "Die Speisekarte besteht aus einem duennen Holzbrett, welches beschriftet wurde. "
    "Mit <menue> kannst Du lesen, was dort geschrieben steht.");
  AddDetail( ({ "wand","waende" }),
    "Die Waende werden hier von einigen kleinen Bueschen gebildet.");
  AddDetail( ({ "bueschen","buesche" }),
    "Es scheint sich dabei um Stachelbeerbuesche zu handeln.");
  AddDetail( ({ "stachelbeerbuesche" }),
    "Du bist Dir nicht ganz sicher, denn es sind keine Beeren zu sehen.");
  AddDetail( ({ "beeren" }),
    "Die scheinen alle abgeerntet worden zu sein.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit Moos gepolstert und es ist sehr angenehm auf ihm zu laufen.");
  AddDetail( ({ "staemme", "saeulen" }),
    "Die Staemme sind sehr dick und rauh. Es klebt etwas Harz an ihnen.");
  AddDetail( ({ "harz" }),
    "Harz laeuft die dicken Staemme der Tannen hinab.");
  AddDetail( ({ "moos" }),
    "Das Moos daempft Deine Schritte.");
  AddDetail( ({ "hinsetzen" }),
    "Du koenntest Dich ja setzen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rascheln der Blaetter und die Geraeusche der Tiere, die "
	"draussen ab und an vorbei laufen.");

  AddSound( ({ "schritte" }),
    "Die Schritte sind gedaempft, Du kannst sie kaum hoeren.");
  AddSound( ({ "tiere","geraeusche" }),
    "Unterschiedliche Tiere machen unterschiedliche Geraeusche.");
  AddSound( ({ "rascheln","blaetter" }),
    "Da der Baum lebt und sich ab und zu bewegt, rascheln seine Blaetter "
	"leise vor sich hin.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Wald und auch ein bisschen nach Essen.");

  AddSmell( ({ "wald" }),
    "Du riechst Moos, Blaetter, Harz... alles, was die Gerueche in einem "
	"Wald ausmachen.");
  AddSmell( ({ "moos","blaetter","harz" }),
    "Danach riecht es hier, unter anderem.");
  AddSmell( ({ "gerueche" }),
    "Ein Wald produziert unterschiedlichste Gerueche.");
  AddSmell( ({ "essen" }),
    "Du erschnupperst diverse gebratene Speisen.");
  AddSmell( ({ "speisen" }),
    "Was genau es ist, weisst Du nicht. Aber es riecht gut. Tipp doch "
	"<menue>, dann siehst Du, was es hier alles gibt.");


AddItem(FAUN_NPC + "gluehwuermchen.lpc",REFRESH_DESTRUCT);
AddItem(FAUN_NPC + "sandrus.lpc",REFRESH_DESTRUCT);
RemoveItem("/obj/topliste");
 AddExit( "osten", FAUN_ROOM +"faunenwald_1b" ); 
	AddCmd(({"setz", "sitze", "setze", "sitz"}), "sitzenCmd"); 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 

}


sitzenCmd(string str)
  {  	
  	notify_fail( "Worauf moechtest Du sitzen?\n" );
		if (str!="auf pilz") return 0;

		if (this_player()->QueryProp(P_NOMOVE)!=0) write ("Du sitzt doch bereits!\n");
  	else //also wenn er noch nicht sitzt
		  {
		  	write ("Du setzt Dich auf einen weichen Pilz.\n");
			  say (TPN+" setzt sich auf einen weichen Pilz.\n", TP);
		    TP->SetProp(P_NOMOVE, "Du sitzt auf einem Pilz und solltest erst aufstehen.\n");
		  }		
		return 1;
			
}




aufstehenCmd(string str)
  {  	
  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
		if (str=="auf"||!str)
  	{
  		if (this_player()->QueryProp(P_NOMOVE)==0) write ("Du sitzt doch gar nicht!\n");
			else
				{
					write ("Du stehst von dem weichen Pilz auf.\n");
					say (TPN+" steht von dem weichen Pilz auf.\n", TP);
  				TP->SetProp(P_NOMOVE, 0);
  			}
  		return 1;
		}
		else return 0;
}