#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Kreuzung" );
  SetProp( P_INT_LONG,
    "Sueden Faunenwald, Osten Elfenwald, ganz Osten Ostzwerge" );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "" }),
    "");





 AddExit( "norden", "/d/gebirge/yason/gebirgspass/room/gebirgspass_42.lpc" ); 
 AddExit( "osten", FAUN_ROOM+"birkenhainelfen_1.lpc" ); 
 AddExit("suedwesten", FAUN_ROOM+"birkenhain_1.lpc");
 
 }


