#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Westen siehst Du eine grosse Trauerweide, deren Aeste bis zum Boden reichen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(FAUN_NPC + "reh.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "aeste","aesten" }),
    "Die Aeste der Trauerweide haengen bis auf den Boden hinab.");
  AddDetail( ({ "trauerweide" }),
    "Unter den Aesten der Trauerweide scheint sich so etwas wie ein Raum zu "
	"befinden. Wenn Du nach Westen gehst, betrittst Du ihn.");
  AddDetail( ({ "raum" }),
    "Es scheint sich um einen Raum zu handeln. Du kannst einfach durch die Aeste durchlaufen um hinein zu gelangen.");
  AddDetail( ({ "westen" }),
    "westlich von Dir steht eine grosse Trauerweide.");




 AddExit( "norden", FAUN_ROOM +"faunenwald_9e" ); 
 AddExit( "osten", FAUN_ROOM +"faunenwald_10f" ); 
 AddExit( "westen", FAUN_ROOM+"faunenwald_10d" ); 
 }


