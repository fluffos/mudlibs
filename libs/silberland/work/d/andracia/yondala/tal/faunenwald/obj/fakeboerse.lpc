void create() 
{
  int i;
  if (!is_clone(TO)) return;
  ::create();
  i=10000+random(5000);
  SetProp(P_SHORT, "Eine Geldboerse mit "+i+" Muenzen");
  SetProp(P_LONG,
    "Eine schoene, aus edlem Leder gefertigte Geldboerse.\n"+
    "Sie enthaelt:\n "+i+" Muenzen." );
  SetProp(P_NAME, "Geldboerse");
  SetProp(P_GENDER, FEMALE);
  AddId(({"geldboerse", "boerse","FAKEBOERSE"}));
  SetProp( P_MATERIAL, ({ MAT_LEATHER}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 20);
 // SetProp(P_NOGET, tester());


}
