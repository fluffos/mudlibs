#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(FAUN_NPC + "faun.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "" }),
    "");



 AddExit( "westen", FAUN_ROOM +"faunenwald_4g" ); 
 AddExit( "suedwesten", FAUN_ROOM +"faunenwald_5g" ); 
 AddExit( "nordosten", FAUN_ROOM +"faunenwald_2i" ); 
 }


