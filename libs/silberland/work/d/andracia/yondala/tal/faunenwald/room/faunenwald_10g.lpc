inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>

create(){
::create();

SetProp(P_LIGHT, 1 );
SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

SetProp( P_INT_SHORT, "In einem kleinen Waldladen" );
SetProp( P_INT_LONG,
"Du befindest Dich in einem kleinen Waldladen. Alles um Dich herum ist gruen und sieht sehr "
"lebendig aus. Es dringt sehr viel Licht herein, obwohl die Baeume hier sehr dicht stehen. Die "
"Veraestelungen der Baeume bilden Regale, auf denen die Waren ihren Platz finden. Kleinere "
"Gegenstaende haengen allerdings an den hervorstehenden Zweigen. Die Verkaufstheke besteht aus "
"einem alten Baumstamm, der auf dem Boden liegt.");

SetStorageRoom(FAUN_ROOM + "faunenwald_lager.lpc");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "FAUNA");
  SetProp(P_SHOPKEEPER_NAME, "Fauna");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
AddItem(FAUN_NPC + "fauna.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "waldladen", "laden", "ladens" }),
    "Du befindest Dich in einem Waldladen.");
  AddDetail( ({ "licht" }),
    "Das Licht der Sonne funkelt durch die Blaetter.");
  AddDetail( ({ "sonne" }),
    "Du kannst sie nicht sehen, lediglich ihr Licht glitzert zwischen den Blaettern hindurch.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus tausenenden von Blaettern.");
  AddDetail( ({ "blaetter","blaettern" }),
    "Durch die Blaetter funkelt und glitzert das Licht der Sonne.");
  AddDetail( ({ "baeume", "baeumen", "buesche" }),
    "Die Baeume und Buesche stehen hier sehr dicht. Ihre Aeste bilden natuerliche Regale, auf denen die zum "
    "Verkauf stehenden Waren gelagert werden. Durch die Blaetter schimmert das Licht der Sonne.");
  AddDetail( ({ "aeste", "veraestelungen" }),
    "Die Aeste der Baeume bilden natuerliche Regale. Wobei Du nicht sicher bist, ob sie von "
    "alleine so gewachsen sind oder jemand nachgeholfen hat.");
  AddDetail( ({ "regale" }),
    "Die Regale in diesem Laden scheinen aus den Baeumen heraus zu wachsen. Auf ihnen lagern die "
    "zum Verkauf stehen den Waren.");
  AddDetail( ({ "verkauf", "waren", "hilfe" }),
    "Frag doch mal Fauna nach Hilfe, wenn sie da ist.");
  AddDetail( ({ "platz" }),
    "Trotz der vielen Waren in diesem Laden findet hier alles seinen Platz.");
  AddDetail( ({ "gegenstaende" }),
    "Die grossen Gegenstaende stehen auf den Regalen, die kleineren haengen an den Zweigen der Baeume.");
  AddDetail( ({ "zweige","zweigen" }),
    "Kleine Zweige schauen aus den Waenden heraus. An ihnen hat Fauna einige kleinere Gegenstaende gehaengt.");
  AddDetail( ({ "boden", "waldboden" }),
    "Der Boden ist ein normaler Waldboden, auf dem das Licht der Sonne tanzt.");
  AddDetail( ({ "baumstamm", "stamm" }),
    "Ein alter Baumstamm, der langsam verrottet dient als Verkaufstheke.");
  AddDetail( ({ "verkaufstheke" }),
    "Sie besteht lediglich aus einem alten, halbverrotteten Baumstamm.");
  AddDetail( ({ "wand","waende" }),
    "Die Waende werden hier von dem dichten Blattwerk der Baeume und Buesche gebildet. An ihnen befinden sich zahlreiche hoelzerne Regale.");
  AddDetail( ({ "blattwerk" }),
    "Das Blattwerk der Baeume bildet hier die Waende. Es laesst nur wenig Licht durch.");
  AddDetail( ({ "fauna", "besitzerin" }),
    "Fauna ist die Besitzerin dieses Ladens. Sie scheint gerade nicht da zu sein.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");


  AddReadDetail( ({ "" }),
    "");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Wald.");

  AddSmell( ({ "wald" }),
    "Du riechst Moos, Blaetter, Harz... alles, was die Gerueche in einem "
	"Wald ausmachen.");
  AddSmell( ({ "moos","blaetter","harz" }),
    "Danach riecht es hier, unter anderem.");
  AddSmell( ({ "gerueche" }),
    "Ein Wald produziert unterschiedlichste Gerueche.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rascheln der Blaetter und die Geraeusche der Tiere, die "
	"draussen ab und an vorbei laufen.");

  AddSound( ({ "schritte" }),
    "Die Schritte sind gedaempft, Du kannst sie kaum hoeren.");
  AddSound( ({ "tiere","geraeusche" }),
    "Unterschiedliche Tiere machen unterschiedliche Geraeusche.");
  AddSound( ({ "rascheln","blaetter" }),
    "Da der Baum lebt und sich ab und zu bewegt, rascheln seine Blaetter "
	"leise vor sich hin.");

 AddExit( "westen", FAUN_ROOM +"faunenwald_10f" ); 
 }


