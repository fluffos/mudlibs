#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Westen siehst Du einige grosse Tannen zwischen denen ein Schild angebracht wurde." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddItem(FAUN_NPC + "eichhoernchen.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "schild" }),
    "Du kannst es lesen.");
  AddDetail( ({ "tannen" }),
    "Die Tannen im Westen sind sehr gross. Die unteren Aeste bilden ein natuerliches Dach.");
  AddDetail( ({ "dach" }),
    "Zwischen oder besser gesagt unter den Tannen scheint eine kleine Kneipe zu sein.");
  AddDetail( ({ "kneipe", "westen", "tannenzapfen" }),
    "Du kannst die Kneipe nach Westen hin einfach betreten.");
  AddDetail( ({ "aeste" }),
    "Die Aeste sind so dicht, dass sie ein natuerliches Dach bilden.");

  AddReadDetail( ({ "schild" }),
    " _____________________________\n"
    "|                             |\n"
    "|  Zum goldenen Tannenzapfen  |\n"
    "|_____________________________|");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

 AddExit( "westen", FAUN_ROOM +"faunenwald_1a" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_2b" ); 
 AddExit( "osten", FAUN_ROOM +"faunenwald_1c" ); 

}


