// Standartraum
#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Wald der Faune" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem hellen, freundlichem Wald. Rings um Dich "
	"herum sind die verschiedensten Baeume. Unter Deinen Fuessen daempft "
	"der weiche Waldboden jeden Deiner Schritte." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "wald" }),
    "Du befindest Dich in einem Wald, in dem noch echte Faune leben sollen.");
  AddDetail( ({ "faune" }),
    "Schau Dich gut um, dann entdeckst Du sicher welche.");
  AddDetail( ({ "baeume" }),
    "Du siehst Nadelbaeume und Laubbaeume.");
  AddDetail( ({ "fuessen","fuesse" }),
    "Schau mal runter.");
  AddDetail( ({ "runter" }),
    "Ja, tatsaechlich, da sind sie. Stehen alle fest auf dem Waldboden.");
  AddDetail( ({ "boden","waldboden" }),
    "Der Waldboden ist mit Laub und Tannennadeln gepolstert.");
  AddDetail( ({ "laub" }),
    "Viele bunte Blaetter liegen auf dem Waldboden.");
  AddDetail( ({ "blaetter", "blaettern" }),
    "Die bunten Blaetter sind wohl von den Laubbaeumen herab gefallen, die "
	"gruenen haengen noch daran.");
  AddDetail( ({ "tannennadeln" }),
    "Die vielen kleinen Tannennadeln, die auf dem Waldboden liegen sind "
	"schon alle braun und pieksen nicht mehr doll.");
  AddDetail( ({ "nadelbaeume" }),
    "Du kannst einige Fichten und auch ein paar Tannen entdecken.");
  AddDetail( ({ "fichten", "tannen" }),
    "Die Fichten und Tannen stehen mit ihrem dunklen gruen in Kontrast zu "
	"den helleren Laubbaeumen.");
  AddDetail( ({ "laubbaeume","laubbaeumen" }),
    "Du siehst viele verschiedene Laubbaeume, die Arten kannst Du nicht "
	"alle aufzaehlen. Teilweise sind die Blaetter noch gruen, andere "
	"wiederum haben schon ihr farbiges Herbstkleid angezogen.");
  AddDetail( ({ "herbstkleid" }),
    "Wenn es kaelter wird faerben sich die Blaetter der Laubbaeume bunt ein.");
  AddDetail( ({ "schritte" }),
    "Nun, wenn Du so durch den Wald laeufst.");
  AddDetail( ({ "himmel", "stueckchen" }),
    "Der Himmel schimmert zwischen den Blaettern ueber Dir hindurch. Die "
	"Sonne kannst Du allerdings nicht sehen.");
  AddDetail( ({ "arten","kastanien","eichen" }),
    "Du kennst Dich nicht so aus, meinst aber, Kastanien und Eichen zu "
	"erkennen.");
  AddDetail( ({ "kontrast","gruen" }),
    "Das hellere Gruen der Laubbaeume bildet einen huebschen Kontrast zu "
	"dem dunkleren Gruen der Nadelbaeume.");
  AddDetail( ({ "sonne" }),
    "Die kannst Du nicht sehen, dafuer ist das Blaetterdach ueber Dir zu "
	"dicht.");
  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach ueber Dir ist so dicht, dass nur ab und zu ein "
	"Stueckchen Himmel zu sehen ist.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Baeume und ab und zu das Zwitschern eines "+
	"Vogels.");



}


