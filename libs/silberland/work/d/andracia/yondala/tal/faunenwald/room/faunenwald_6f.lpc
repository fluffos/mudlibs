#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>

string nachbarraum = "faunenwald_6e.lpc"; 

void init()
{
	::init();
		catch(call_other(FAUN_ROOM+nachbarraum,"???"));

	if(interactive(TP))
		tell_room(to_object(FAUN_ROOM+nachbarraum), "Es raschelt auf der anderen Seite der Hecke.\n");
}


void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Westen von Dir ragt eine hohe Hecke in den Himmel empor." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "westen", "hecke" }),
    "Die Hecke westlich von Dir ist so hoch, dass Du nicht darueber schauen kannst. Aber die "
    "Blaetter scheinen nicht so dicht zu sein.");

  AddDetail( ({ "blaetter" }),
    "Du kannst versuchen durch die Blaetter zu spaehen.");
    
  AddDetail( ({ "" }),
    "");




 AddExit( "norden", FAUN_ROOM +"faunenwald_5f" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_7f" ); 
 AddExit( "nordosten", FAUN_ROOM +"faunenwald_5g" ); 
  AddCmd(({"spaehe", "spaeh"}),"spaehen"); //Funktion
// AddSpecialExit( "sueden", "suedengeher" ); 

}

int suedengeher(string dir)
{
  if(random(2))
  return this_player()->move(FAUN_ROOM +"faunenwald_7f", M_GO);
  return this_player()->move(FAUN_ROOM +"faunenwald_8f", M_GO);
 
}

int sound()
{say("Du hoerst ein Geraeusch hinter der Hecke.\n");}


int spaehen(string str) 
{
	string raumbeschreibung; 
	notify_fail("Wodurch moechtest Du spaehen?\n");
    if (str!="durch blaetter" && str!="durch hecke") return 0;
    
    raumbeschreibung = to_object(FAUN_ROOM+nachbarraum)->int_long(TP);
    
	write ("Du spaehst durch die Hecke und siehst:\n"+raumbeschreibung);
	say(TPN+" spaeht durch die Blaetter der Hecke.\n");
	tell_room(FAUN_ROOM+nachbarraum, TPN+" streckt kurz "+TP->QueryPossPronoun(MALE,WEN)+" Kopf durch die Hecke.\n");
	return 1;
}
