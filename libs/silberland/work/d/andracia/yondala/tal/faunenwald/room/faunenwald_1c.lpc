#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Etwas weiter im Westen siehst Du einige grosse Tannen. Im Norden gelangst Du zurueck auf den Weg." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "westen","tannen" }),
    "Von hier aus siehst Du nur, dass es Tannen sind. Geh doch naeher ran.");
  AddDetail( ({ "weg","norden" }),
    "Im Norden liegt er Weg, von dem Du in diesen Weg hin abgebogen bist.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

 AddExit( "westen", FAUN_ROOM +"faunenwald_1b" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_2c" ); 
 AddExit( "norden", "/d/andracia/yondala/tal/birkenhain/room/birkenhain_6" ); 

}


