inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
void init()
{
	if(TP->id("schaf")) Kill(TP);
	::init();
	}
void create() {
  if (!is_clone(TO)) return;
  ::create();

 SetProp(P_SHORT, "Ein Wolf");
  SetProp(P_LONG,
    "Du siehst einen grossen, schwarzen Wolf, der Dich aus gelben Augen "
	"anstarrt. Seine Zaehne sind gefletscht und sein Fell gestraeubt. "
	"Besser, Du laesst ihn in Ruhe.");
  SetProp(P_NAME, "Wolf");
  SetProp(P_GENDER, MALE);
  AddId(({"wolf", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
 CLONEME(FAUN_ARMOUR+"wolfsfell.lpc" );

  create_default_npc(11);
  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Raubtier");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "trottet heran");
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/tal/yondala/faunenwald") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, FAUN_ROOM "/d/tal/yondala/faunenwald/faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Wolf");

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wolf kann Deine Sachen nicht tragen.\n" }) );
  SetChats(5, ({
    "Der Wolf schnueffelt an Dir.\n",
    "Der Wolf knurrt in Deine Richtung.\n"}) );

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
      Attack(TP);  
}

//void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
//  return StartReaction(verb, gruppe, adverb, touch);
//}




void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

