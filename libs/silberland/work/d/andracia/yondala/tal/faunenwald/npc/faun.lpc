//ein Faun
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int geschlecht;
int groesse;

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
geschlecht = random(2);
groesse = random(3);

switch(geschlecht)
{	case 1: {
		SetProp(P_SHORT, "Ein Faun");
		SetProp(P_GENDER, MALE);
	  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
	  SetProp(P_KILL_NAME, "Ein Faun");
	  SetProp(P_NAME, "Faun");
	    SetChats(5, ({
    "Der Faun hebt den Kopf und lauscht.\n",
    "Der Faun plueckt ein Blatt und kaut genuesslich darauf herum.\n",
    "Der Faun scharrt am Boden.\n"}) );
	switch(groesse)
{	case 1: {  
		create_default_npc(1);
  	SetProp(P_SIZE, 100);
  	SetProp(P_WEIGHT, 40000);
  	SetProp(P_WIMPY, 50);
    SetProp(P_LONG,
      "Du siehst einen sehr kleinen Faun vor Dir, der Dich mit grossen Augen anschaut.");
      SetProp(P_NAME_ADJ, "klein");
    break;}
	case 2: {	
		create_default_npc(5);
  	SetProp(P_SIZE, 130);
  	SetProp(P_WEIGHT, 60000);
  	SetProp(P_WIMPY, 20);
    SetProp(P_LONG,
     "Du siehst einen halbstarken Faun vor Dir, der Dich neugierig betrachtet.");
      SetProp(P_NAME_ADJ, "halbstark");
       break;}

//default:	{	
case 0:{		create_default_npc(12);
  	SetProp(P_SIZE, 165);
		SetProp(P_WEIGHT, 80000);
 		SetProp(P_LONG,
      "Du siehst einen sehr kraeftigen, ausgewachsenen Faun vor Dir, welcher Dich einfach ignoriert.");
	  SetProp(P_NAME_ADJ, "gross");}
	  }
	  
break;}
	
	default: {
		SetProp(P_SHORT, "Eine Faunin");
		SetProp(P_GENDER, FEMALE);
		SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
		SetProp(P_KILL_NAME, "Eine Faunin");
		SetProp(P_NAME, "Faunin");}
    AddId(({"faunin"}));
      SetChats(5, ({
    "Die Faunin schau Dich interessiert an.\n",
    "Die Faunin plueckt ein Blatt und kaut genuesslich darauf herum.\n",
    "Die Faunin hebt etwas vom Boden auf.\n"}) );
	
	switch(groesse)
{	case 1: {  
		create_default_npc(1);
  	SetProp(P_SIZE, 100);
  	SetProp(P_WEIGHT, 40000);
  	SetProp(P_WIMPY, 50);
    SetProp(P_LONG,
      "Du siehst eine sehr kleine Faunin vor Dir, die Dich mit grossen Augen anschaut.");
      SetProp(P_NAME_ADJ, "klein");
    break;}
	case 2: {	
		create_default_npc(5);
  	SetProp(P_SIZE, 130);
  	SetProp(P_WEIGHT, 60000);
  	SetProp(P_WIMPY, 20);
    SetProp(P_LONG,
     "Du siehst eine halbstarke Faunin vor Dir, die Dich neugierig betrachtet.");
      SetProp(P_NAME_ADJ, "halbstark");
       break;}

//default:	{	
case 0:{		create_default_npc(12);
  	SetProp(P_SIZE, 165);
		SetProp(P_WEIGHT, 80000);
 		SetProp(P_LONG,
      "Du siehst eine sehr kraeftige, ausgewachsene Faunin vor Dir, welche Dich einfach ignoriert.");
	  SetProp(P_NAME_ADJ, "gross");}
	  }
}



  AddId(({"faun"}));
  SetProp(P_RACE, "Faun");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_NOMAGIC,3);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.5,  DT_WATER:  0.5, DT_AIR:    0.5]) );

  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt aus einem Gebuesch");
  SetProp(P_MMSGOUT, "verschwindet im Wald");
  SetProp(P_MNPC_AREA, (FAUN_ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, FAUN_ROOM "/d/andracia/yondala/faunenwald/room/faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );


  AddInfo(DEFAULT_INFO, "schaut Dich schuechtern an.\n");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Faun schuettelt den Kopf.\n" }) );



}

