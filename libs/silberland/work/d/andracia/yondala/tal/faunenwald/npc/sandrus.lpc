 // SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Sandrus will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);


	AddSpell(3,800,
	         "Sandrus greift Dich mit einem Feuerball an.\n",
	         "Sandrus greift @WEN mit einem dicken Feuerball an.\n",
	         ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );




  SetChats(1, ({
    "Sandrus puhlt sich eine Tannennadel aus dem rechten Huf.\n",
