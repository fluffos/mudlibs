//Der Wirt im Faunenwald
inherit "std/npc";
inherit "/std/npc/spells.lpc";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

string q_magiestein() //fuer die Quest "Die besonderen Magiesteine"
{
  object ob;
  int result;
  
 if( !TP->QueryQuest("Die besonderen Magiesteine") ) 
 if( ob=present("\nzzmagiesteinequest", TP) )
 {
 	result=ob->QueryStone("weiss");
  if( result == 0)
  	{
   ob->SetStone("weiss", 1);
     ob=clone_object("/gilden/zaubererzunft/obj/magiestein.lpc"); ob->set_farbsymbol("weiss");
     if( ob->move(TP, M_GET) < 0 ) ob->move(environment(TO), M_PUT); 
     tell_room(environment(TO), TO->name()+" gibt "+TP->name()+ob->name(WEN,1)+"\n",({TP}));
     tell_object(TP, TO->name()+" gibt Dir "+ob->name(WEN,1)+"\n");
   return "Hier habt ihr den weissen Magiestein fuer Zauberer Pralecred. Seid vorsichtig damit, "
   "verbraucht ihn nicht, denn ich kann euch keinen weiteren mehr geben.";
  }
  if( result==1 )
    return "Ihr habt den weissen Magiestein fuer Zauberer Pralecred schon erhalten.";
   if( result==2 )
    return "Ihr benoetigt den weissen Magiestein fuer Zauberer Pralecred nicht mehr.";
  }
 return "Magiesteine beinhalten eine elementare Kraft. Diese Steine sind sehr wertvoll.";
}


void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Sandrus, der Wirt");
  SetProp(P_LONG,
    "Sandrus ist der Wirt der Kneipe \"Zum goldenen Tannenzapfen\"."
    "\nDu siehst einen kleinen, staemmigen Faun vor Dir. Er hat struwwelige "
    "gelbbraune Haare auf dem Kopf und von der Huefte abwaerts. Sein Kinnbart ist lang und "
    "geflochten, seine leicht schraegen Augen schauen Dich interessiert an. "
    "An seinem Hinterteil wackelt ein kleines Ziegenschwaenzchen.");
  SetProp(P_NAME, "Sandrus");
  SetProp(P_GENDER, MALE);
  AddId(({"sandrus", "faun", "wirt", "SANDRUS"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Faun");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
//  SetProp(P_AGGRESSIVE,0);
//  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_WATER: -0.5, DT_AIR:    -0.5, 
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5]) );

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "zwaengt sich zwischen den Zweigen hindurch");
  SetProp(P_MMSGOUT, "zwaengt sich zwischen den Zweigen hindurch");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Sandrus");
  AddInfo(DEFAULT_INFO, "sagt: Fragt doch lieber Faunus dazu.\n");
  AddInfo("", ".","sagt: ");

//Fuer die Quest "Die besonderen Magiesteine"
  AddInfo( ({"magiestein", "magiesteine"}), #'q_magiestein, "sagt: "); //#'
  
  AddInfo( ({"yason","yondala","nyx","aginor","hochadel"}),
    "Lang lebe der Hochadel von Andracia!",
    "sagt: ");

  AddInfo( ({"faunus"}),
    "Faunus ist der Mann von Fauna und der Fuehrer des Clans des Naturvolkes. Ihr findet ihn suedlich von hier.",
    "sagt: ");

  AddInfo( ({"aufnahmebedingungen","aufnahmebedingung"}),
    ".",
    "sagt: ");

  AddInfo( ({"clan", "naturvolk"}),
    "Ich selbst gehoere zum Clan des Naturvolks. Wenn Ihr etwas darueber erfahren wollt, "
    "dann besucht doch Faunus.",
    "sagt: ");

   AddInfo( ({"fauna",""}),
    "Fauna ist die Frau von Faunus, sie betreibt einen kleinen Laden im suedlichen Teil des Waldes.",
    "sagt: ");

  AddInfo( ({"laden",""}),
    "Es gibt in diesem Wald einen kleinen Laden. Fauna ist die Besitzerin.",
    "sagt: ");

  AddInfo( ({"elfen","elfenstadt"}),
    "Die Elfenstadt ist hier ganz in der Naehe, geht einfach Richtung Nordosten. Sie ist "
    "allerdings leicht zu verfehlen, denn das ungebuebte Auge uebersieht sie leicht.",
    "sagt: ");

  AddInfo( ({"auge","ungeuebtes auge", "ungeuebte auge"}),
    "Nun ich koennte Euch einen kleinen Trick verraten, wie Ihr in der Elfenstadt mehr sehen koennt, wenn Ihr kein Elf seid.",
    "sagt: ");

  AddInfo( ({"trick",""}),
    "Der Trick ist einfach immer etwas Elfenkraut dabeizuhaben.",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
