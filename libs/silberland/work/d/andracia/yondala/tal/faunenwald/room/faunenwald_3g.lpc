#include "../def.h"
inherit FAUN_ROOM + "faunenwald_std.lpc";
#include <properties.h>




void create() 
{
  ::create();


   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "" }),
    "");



 AddExit( "osten", FAUN_ROOM +"faunenwald_3h" ); 
 AddExit( "sueden", FAUN_ROOM +"faunenwald_4g" ); 
 AddExit( "nordosten", FAUN_ROOM +"faunenwald_2h" ); 
 }


