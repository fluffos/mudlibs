inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Nuss");
  SetProp(P_LONG,
    "Du siehst eine kleine braune Nuss. Ob man sie essen kann?" );
  SetProp(P_NAME, "Nuss");
  SetProp(P_GENDER, FEMALE);

SetProp(P_FOOD_INFO, ([F_SOAK:1, 
											 F_HEAL:({5,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du isst eine Nuss.", 
											 F_MSG_ROOM: "isst eine Nuss."]));


  AddId(({"nuss"}));

  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
}