#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Hasenpfote");
  SetProp(P_LONG,
    "Du siehst eine kleine Hasenpfote, die vermutlich einem armen kleinen Hasen abgehackt wurde." );
  SetProp(P_INFO, "Man sagt, das Reiben an einer Hasenpfote bringe Glueck.");
  SetProp(P_NAME, "Hasenpfote");
  SetProp(P_GENDER, FEMALE);
  AddId(({"pfote","hasenpfote"}));
  SetProp( P_MATERIAL, ({ MAT_BONE, MAT_PELT }) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 0);
  AddCmd( ({ "reibe", "reib"}), "reiben" ); 

}


reiben(string str)
{
	if(str=="hasenpfote"||str=="an hasenpfote"||str=="an pfote"||str=="pfote")
		{
			write("Du reibst an der Hasenpfote und ploetzlich geht es Dir ein bisschen besser.\nLeider geht die Pfote dabei kaputt.\n");
			say(TPN+" zerreibt eine Hasenpfote und sieht ploetzlich ein bisschen besser aus.\n");
			TP->AddHP(10);
			TO->remove();
			return 1;
			}
			
	}
	
	