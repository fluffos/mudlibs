void create() {
  int i;
  if (!is_clone(TO)) return;
  ::create();
//  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Faunus, der Herr der Waelder");
  SetProp(P_LONG,
    "Faunus, Oberhaupt und Gruender des Naturvolks.\n"
	"Du siehst einen grossen, alten Faun vor Dir. Er hat struwwelige "
    "graubraune Haare, einen Ziegenbart und von der Huefte abwaerts Fell, "
    "welches die Bocksbeine bedeckt. Hinten siehst Du ein kleines "
    "Ziegenschwaenzchen.");
  SetProp(P_NAME, "Faunus");
  SetProp(P_GENDER, MALE);
  AddId(({"faunus", "faun", "herr","NOWIMPY"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  //create_default_npc(30);
//  create_default_druid(string element, int level, int glevel, int maxhp) 
  i=random(6);
  if(i==0) create_default_druid("humus", 35, 14, 2000); 
  else if(i==1) create_default_druid("luft", 30, 14, 2000); 
  else if(i==2) create_default_druid("wasser", 30, 14, 2000); 
  else if(i==3) create_default_druid("feuer", 30, 14, 2000); 
  else if(i==4) create_default_druid("eis", 30, 14, 2000); 
  else if(i==5) create_default_druid("erz", 30, 14, 2000); 
 
  
  
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Faun");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
//  SetProp(P_AGGRESSIVE,0);
//  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_WATER: -0.5, DT_AIR:    -1.0, 
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5]) );

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "kommt aus dem Wald");
  SetProp(P_MMSGOUT, "verschwindet im Wald");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Faunus");
  AddInfo(DEFAULT_INFO, "sagt: Die Antwort ist in Euch.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"yason","yondala","aginor","hochadel"}),
    "Lang lebe der Hochadel von Andracia!",
    "sagt: ");
/*
  AddInfo( ({"clan"}),
    "Ich bin der Fuehrer des Clans des Naturvolkes. Ihr koennt unserem Clan beitreten, wenn "
