  AddInfo( ({"erforsch", "erforsche", "erforschen"}),
    "Mit erforsche erhaelst Du einen tieferen Einblick in die Bestandteile und funktion eines "
    "Gegenstandes. Lernen kannst Du diesen Zauber ab der ersten Stufe.",
    "sagt: ");

  AddInfo( ({"beaeugen","beaeuge"}),
    ".Lernen kannst Du diesen Zauber ab der ersten Stufe.",
    "sagt: ");

  AddInfo( ({"gluehwuermchen","licht"}),
    ".Lernen kannst Du diesen Zauber ab der zweiten Stufe.",
