// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "sagt: Fuerchtet Euch nicht, "+TPN+".",
        "sagt: Fuerchtet Euch nicht, "+TPN+".");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: wagt das nicht noch einmal!",
        "sagt: wagt das nicht noch einmal!");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich wohlwollend an.",
        "laechelt wohlwollend.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schaut Dich veraergert an.",
        "schaut veraergert.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lasst das bloss nicht Fauna sehen!",
        "sagt: Lasst das bloss nicht Fauna sehen!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TPN+" an.");
      break;
   case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
