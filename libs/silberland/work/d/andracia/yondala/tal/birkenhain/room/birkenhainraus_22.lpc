#include "../def.h"
inherit BIRKE_ROOM + "birkenhainraus_std.lpc";
#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG,
    "Du stehst mitten auf einer bluehenden Wiese in einem herrlichen Birkenhain der sich "
    "in alle Richtungen ausbreitet. Um Dich herum stehen vereinzelte Birken, in der Ferne "
    "um Dich herum und direkt im Sueden kannst Du die Auslaeufer des Gebirges erkennen." );

  AddDetail( ({ "sueden" }),
    "Suedlich von Dir beginnt abrupt das Gebirge, Du kannst es aber scheinbar durch eine enge "
    "Kluft passieren.");
  AddDetail( ({ "kluft" }),
    "Die kannst Du im Sueden betreten.");
    

 AddExit( "sueden",  BIRKE_ROOM+"birkenhainraus_23.lpc" ); 
 AddExit("norden", BIRKE_ROOM+"birkenhainraus_21.lpc");
 
 }


