//Die Leiche, die das Eichhoernchen fuer Clanmitglieder hinterlaesst

inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Eichhoernchenleiche");
  SetProp(P_LONG,
    "Du siehst die sterblichen Ueberreste eines Eichhoernchens, welches sein Leben fuer Dich geopfert hat." );
  SetProp(P_NAME, "Eichhoernchenleiche");
  SetProp(P_GENDER, FEMALE);

SetProp(P_FOOD_STATE, F_RAW); //roh, klar

SetProp(P_FOOD_INFO, ([F_SOAK:5000, 
											 F_HEAL:({5,5}), // erst HP, MP, sollte 15 nicht ueberschreiten. Bei kleinen Tieren natuerlich niedriger.
											// F_HEAL:10, 
											 F_MSG: "Du verspeist eine Tierleiche, leise dankst Du dem Geist des Tieres.", //Der Text soll "netter" formuliert sein
											 F_MSG_ROOM: "verspeist eine Tierleiche und bedankt sich leise beim Geist des Tieres."]));


  AddId("tierleiche","leiche");

  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 150); //leichter als das Originaltier, klar.
  SetProp(P_VALUE, 50);//kommt drauf an, was es war. Aber sollte 100 nicht ueberschreiten


 
}