
//6.10.2008: Angeleintes Schaf bekommt P_FRIEND gesetzt und bei ableinen wieder genommen.

#include "../def.h"
inherit "std/thing";
#include <properties.h>

object schaf;
int angeleint;
object besitzer;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schafleine");
  SetProp(P_LONG,
    "Du siehst eine kurze braune Lederleine die optimal darauf ausgelegt ist ein Schaf anzuleinen." );
  SetProp(P_INFO, "Mit dieser Leine kannst Du ein Schaf anleinen. Es wird Dir dann ueberall hin folgen.\n"
  "Die Syntax lautet: Leine Schaf an.\n"
  "Wenn Dir das Schaf nicht mehr folgen soll, kannst Du es mit \"Leine Schaf ab\" in die "
  "Freiheit entlassen.\n"
  //"Mit \"Binde Schaf an\" kannst Du das Schaf fuer eine gewisse Zeit anbinden"
  );

  SetProp(P_NAME, "Schafleine");
  SetProp(P_GENDER, FEMALE);
  AddId(({"leine", "schafleine"}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  AddCmd(({"leine","lein"}),"leinen");

	}
	
int leinen(string str)
{
	notify_fail("Was willst Du an- oder ableinen?\n");
	if (str=="schaf an") 
		{
			if(!schaf=present("schaf",environment(TP))) write("Hier ist kein Schaf.\n");
			else
				{
//					schaf=present("schaf",environment(TP));
					if(TP->QueryProp(P_PURSUERS)!=0 && member(TP->QueryProp(P_PURSUERS),schaf)!=-1)//Wenn das Schaf schon angeleint ist
						{
							write("Das Schaf ist doch schon an Deiner Leine.\n");
							return 1;
						}
					else if(angeleint)
						{
							write("Du hast doch schon ein Schaf an der Leine.\n");
							return 1;
						}
						//if(!TP->QueryProp(P_PURSUERS))//Wenn der Spieler keine Verfolger hat
						
							if(schaf->besitzer())
						{
							write("Das Schaf ist doch schon an der Leine von "+ schaf->besitzer()+".\n");
							return 1;
							}
							besitzer=TP;
					write("Du nimmst das Schaf an die Leine.\n");
					say(TPN+" nimmt das Schaf an die Leine.\n",TP);
					schaf->inbesitznahme(TP);
   				schaf->SetProp (P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
					TP->AddPursuer(schaf);
					//schaf->SetProp (P_MNPC_WAIT, 0);
					schaf->  SetProp(P_MSGOUT, "trottet "+TPN+" hinterher");
					schaf->SetProp(P_FRIEND,1);
					schaf->SetChats(3, ({
			   		"Das Schaf bloekt.\n",
   			 		"Das Schaf zerrt ein bisschen an der Leine.\n",
   			 		"Das Schaf stubst seine Schnauze sanft gegen Deine Hand.\n"}) );
   			 	SetProp(P_NODROP,"Wenn Du ein Schaf an der Leine hast kannst Du sie nicht einfach ablegen.\n");
					angeleint=1;
					}
							


				}
	if(str=="schaf ab")
		{
			if(!present("schaf",environment(TP))) write("Hier ist kein Schaf.\n");
			else
				{
					schaf=present("schaf",environment(TP));
					if(!TP->QueryProp(P_PURSUERS)||!member(TP->QueryProp(P_PURSUERS),schaf))write("Das Schaf ist nicht an Deiner Leine.\n");
					else
						{
							TP->RemovePursuer(schaf);
							write("Du laesst das Schaf von der Leine.\n");
							say(TPN+" laesst das Schaf von der Leine.\n",TP);
							SetProp(P_NODROP,0);
							schaf->freigabe();
							schaf->SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
							schaf->SetProp (P_MNPC_WAIT, ({5, 5, 5}));
							schaf->  SetProp(P_MSGOUT, "trottet");
    					schaf->SetProp(P_FRIEND,0);
							schaf->SetChats(3, ({
										   "Das Schaf bloekt.\n",
   										 "Das Schaf schmatzt.\n"}) );
   						angeleint=0;
						SetProp(P_NODROP,0);
   						besitzer=0;

						}
					}
				}
	return 1;
	}
leinelos()
{
	angeleint=0;
	SetProp(P_NODROP,0);
	}

mixed hatschaf()
{
	if (schaf)return schaf;
	return 0;
}

void BecomesNetDead(object spieler)
{
	if(spieler==besitzer)	
	{
		angeleint=0;
		SetProp(P_NODROP,0);
	}
}