#include "../def.h"
inherit BIRKE_ROOM + "weide_std.lpc";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG,
    "Du stehst mitten auf einer kleinen Weide. Im Norden ist sie durch ein Gatter begrenzt, "
    "in alle anderen Richtungen durch einen Zaun. Dahinter "
    "siehst Du um Dich herum einen herrlichen Birkenhain." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "weide" }),
    "Du stehst mitten auf einer kleinen Weide. Im Norden ist sie durch ein Gatter begrenzt, "
    "in alle anderen Richtungen durch einen Zaun. Dahinter "
    "siehst Du um Dich herum einen herrlichen Birkenhain.");
  AddDetail( ({ "gatter" }),
    "Das Gatter im Norden verschliesst die Weide.");
  AddDetail( ({ "norden" }),
    "Im Norden siehst Du ein Gatter.");
  AddDetail( ({ "zaun" }),
    "Der Zaun umgibt die Weide.");
  AddDetail( ({ "richtungen" }),
    "Rund um Dich herum.");



  AddExit("sueden", BIRKE_ROOM+"weide_3b.lpc");
AddExit("suedwesten", BIRKE_ROOM+"weide_3a.lpc");
AddExit("osten", BIRKE_ROOM+"weide_2c.lpc");
AddExit("norden", BIRKE_ROOM+"weide_1b.lpc");
AddExit("westen", BIRKE_ROOM+"weide_2a.lpc");
AddExit("suedosten", BIRKE_ROOM+"weide_3c.lpc");

 }



