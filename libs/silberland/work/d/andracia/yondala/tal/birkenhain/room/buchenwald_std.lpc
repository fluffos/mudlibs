#include "../def.h"
inherit "std/room";
#include <properties.h>
int eckernda;
int wieviele;
void init()
{::init();
		call_out("check",3, TP);
}

void reset()
{
	::reset();
	eckernda=random(5);
	}

void create() 
{
  ::create();
	eckernda=random(5);
  SetProp( P_INT_SHORT, "In einem Buchenwald" );
  SetProp( P_INT_LONG,
    "Du stehst hier mitten in einem dichten Buchenwald. Die Baeume stehen hier so eng "
    "beieinander, dass nur ein schmaler Pfad bleibt auf wem Du laufen kannst." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "buchenwald" }),
    "Du stehst mitten zwischen vielen Buchen die zusammen einen Wald bilden.");
  AddDetail( ({ "wald" }),
    "Du siehst den Wald vor lauter Buchen nicht.");
  AddDetail( ({ "buchen", "baeume", "baum" }),
    "Die Buchen um Dich herum scheinen sehr alt zu sein, denn sie reichen hoch "
    "hinauf in den Himmel und ihre Staemme haben einen gigantischen Umfang.");
  AddDetail( ({ "himmel" }),
    "Der Himmel wird fast vollstaendig durch das dichte Blattwerk der Buchen verdeckt.");
  AddDetail( ({ "blattwerk" }),
    "Die Blaetter der Buchen bilden einige Meter ueber Dir ein dichtes Dach.");
  AddDetail( ({ "dach" }),
    "Das Blattwerk der Buchen ist so dicht, dass Du kaum den Himmel sehen kannst. "
    "Dafuer bleibst Du aber sicherlich auch trochen falls es mal regnen sollte.");
  AddDetail( ({ "umfang" }),
    "Der Umfang der alten Buchen ist wirklich gigantisch.");
  AddDetail( ({ "staemme" }),
    "Die Staemme der Buchen sind voller Furchen und ziemlich kahl, das Blattwerk "
    "faengt erst einige Meter ueber Dir an.");
  AddDetail( ({ "furchen" }),
    "Die Furchen in den Staemmen der Buchen sind ziemlich tief. Fast schon sehen "
    "sie aus wie eine Leiter.");
  AddDetail( ({ "leiter" }),
    "Ob man an den Furchen vielleicht nach oben klettern kann?");
  AddDetail( ({ "pfad" }),
    "Du befindest Dich auf einem schmalen Pfad in einem dichten Buchenwald.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit saftigem Moos bedeckt, vereinzelt liegen einige Blaetter herum. "
    "Rechts und links des Pfades stehen einige Buesche.");
  AddDetail( ({ "blaetter" }),
    "Das Blattwerk der Buchen beginnt einige Meter ueber Dir. Vereinzelt liegen auf dem "
    "Boden einige Buchenblaetter herum.");
  AddDetail( ({ "buchenblaetter" }),
    "Ob da auch Bucheckern zwischen den Blaettern liegen?");
  AddDetail( ({ "bucheckern" }),
    "Vielleicht solltest Du die Blaetter mal durchwuehlen?");
  AddDetail( ({ "moos" }),
    "Das Moos ist saftig und quietscht ein bisschen unter Deinen Fuessen.");
  AddDetail( ({ "Fuesse" }),
    "Die sind unten.");
  AddDetail( ({ "buesche" }),
    "Ein paar verfilzte Buesche saeumen den Pfad.");
  AddDetail( ({ "meter" }),
    "Zu weit um sie zu erreichen.");
  AddDetail( ({ "voegel" }),
    "Sehen kannst Du freilich keine, sie halten sich verborgen.");

  AddDetail( ({ "" }),
    "");


  AddSound( DEFAULT_SOUND,
    "Das Moos quietscht unter Deinen Fuessen.");

  AddSound( ({ "moos","quietschen","fuesse" }),
    "quiiiiiiiiiiiiiieeeeetsch");
  AddSound( ({ "voegel","lieder" }),
    "Die Voegel traellern suesse Lieder.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm nach Wald.");



 AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
 AddCmd( ({ "wuehle", "wuehl","durchwuehle", "durchwuehl" }), "wuehlen" );

 }


void check(object spieler)
{	
  // Spieler noch da?
  if (spieler && interactive(spieler) && TO==environment(spieler))
  {
    if (present("\nelfenkiller",spieler)||spieler->QueryProp(P_GUILD)=="Pirat"&&spieler->QueryProp(P_RACE)=="Elf")  // Feind?
     {
//    	write("Eine elfische Stimme ruft: Ein Feind, vernichtet ihn!\n");
//			tell_object(TP, "Eine elfische Stimme ruft: Ein Feind, vernichtet ihn!\n");
			tell_room(environment(spieler), "Eine elfische Stimme ruft: Ein Feind, vernichtet ihn!\n" );

			call_out("schuss", 3, spieler);
     }
 //    else 
//			tell_room(environment(spieler), "Kein Killer!\n" );

  }
}

void schuss(object spieler)
{
	int was;
	int gift;

  if (spieler && interactive(spieler) && TO==environment(spieler))
  {
  	was= random(7);
  	if(was==0)
  		{
 			   tell_object(spieler, "Ein Pfeil sauss haarscharf an Deinem Kopf vorbei.\n");
 			  }
  	if(was==1||was==2)
  		{
 			   tell_object(spieler, "Ein Pfeil streift Dich am Bein.\n");
				 spieler->do_damage(10,"Elfischer Beschuss");
 			  }
  	if(was==3||was==4||was==5)
  		{
       tell_object(environment(spieler), "Hiiii!\n");
 			   tell_object(spieler, "Ein Pfeil durchschiesst Deine Schulter.\n");
				 spieler->do_damage(15,"Elfischer Beschuss");
 			  }
   	if(was==6)
  		{
       tell_object(environment(spieler), "Hi!\n");
 			   tell_object(spieler, "Ein Pfeil trifft Dich mitten in den Bauch und bleibt stecken.\n");
 			   CLONE(BIRKE_OBJ + "elfenpfeil.lpc", spieler);
				 spieler->do_damage(20,"Elfischer Beschuss");
 			   gift=random(5);
 			   spieler->SetProp(P_POISON, gift);

 			  }
			call_out("schuss", 2, spieler);
 			}
 		}


wuehlen(string str)
{
  notify_fail( "Worin willst Du wuehlen?\n" );
	if (str=="blaetter"||str=="in blaetter")
		{
			if (eckernda!=1)
			{
				write ("Du wuehlst in den wenigen Blaettern herum, aber leider findest Du keine Bucheckern.\n");
				return 1;
			}
			else
				{
					write ("Du wuehlst in den Blattern herum und findest tatsaechlich einige Bucheckern, die du sofort einsteckst.\n");
					say(TPN +" hebt etwas vom Boden auf.\n");
					wieviele=random(3);
					wieviele+=2;
					for(;;)
					{
						CLONE(BIRKE_OBJ + "buchecker.lpc", TP);
						wieviele--;
						if(wieviele==0) break;
						}
						eckernda==0;
					return 1;
				}
		}
	}
	