#include "../def.h"
inherit BIRKE_ROOM + "buchenwald_std.lpc";
#include <properties.h>



void create() 
{
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Nach Osten hin oeffnet sich der Wald und Du siehst einen "+
"lichten Birkenhain.");
 

  AddDetail( ({ "osten", "birkenhain" }),
    "Nach Osten kannst Du den Wald verlassen und einem Weg durch den Birkenhain folgen.");
  AddDetail( ({ "weg" }),
    "Du kannst einen getrampelten Weg erkennen welcher durch den Birkenhain fuehrt.");
 AddExit( "nordwesten", BIRKE_ROOM+"buchenwald_6m.lpc" ); 
 AddExit( "sueden", BIRKE_ROOM+"buchenwald_8n.lpc");
 AddExit( "osten", BIRKE_ROOM+"birkenhainelfen_4.lpc" ); 
 
 }

kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
   if( str == "rauf"||str == "hinauf"||str == "herauf"||str == "nach oben"
  	||str == "auf baum"||str == "baum rauf"||str=="hoch" ||str=="an furchen hoch" 
  	||str=="an fruchen nach oben" ||str=="an furchen rauf" ||str=="leiter rauf")
  	 {
  	TP->move(ELFEN_ROOM + "aboriville_7n", M_GO,
  	"","klettert nach oben","klettert einen Baum hinauf");
		write("Du kletterst einen Baum hinauf und steigst ueber ein hoelzernes Gelaender.\n");
    say( TPN+" klettert einen Baum hinauf und verschwindet in der Krone.\n");
    return 1;

  }
  return 0;
}
	
