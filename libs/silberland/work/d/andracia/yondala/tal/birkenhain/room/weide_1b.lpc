//im Sueden ist ein Gatter, wenn man es oeffnet kann man die Weide betreten
#include "../def.h"
inherit "std/room";
#include <properties.h>
int offen;

void create() 
{
  ::create();
offen=0;
  SetProp( P_INT_SHORT, "Auf einer kleinen Weide" );
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geschlossenes Gatter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "birkenhain" }),
    "Der Birkenhain ist jenseits des Zaunes."  );
  AddDetail( ({ "wiese" }),
    "Du stehst mitten auf einer bluehenden Wiese. Das Gras ist kniehoch und wilde Blumen stechen "
    "immerwieder bunt hervor. Ein paar Bienchen summen um Dich herum.");
  AddDetail( ({ "gras" }),
    "Das Gras ist hier durchschnittlich kniehoch und wird immer wieder von bunten Blumen unterbrochen");
  AddDetail( ({ "blumen" }),
    "Die bunten Blumen sind hier wild gewachsen und bilden zusammen mit dem gruenen Gras einen "
    "bunten Teppich.");
  AddDetail( ({ "teppich" }),
    "Die gruene Wiese sieht mit den wilden Blumen zusammen aus wie ein bunter Teppich.");
  AddDetail( ({ "birken", "birke" }),
    "Die Birken stehen vereinzelt in dem Hain.");
  AddDetail( ({ "licht", "kraft" }),
    "Die Sonne strahlt heute mit all ihrer warmen Kraft auf diesen Birkenhain.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht vom blauen Himmel herunter und waermt Dich.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmlisch blau und eine sonnige Sonne laechelt auf Dich herunter.");
  AddDetail( ({ "ferne" }),
    "Weit weg.");
  AddDetail( ({ "gebirge", "auslaeufer" }),
    "Das Gebirge umgibt dieses Tal vollstaendig.");
  AddDetail( ({ "tal" }),
    "Du befindest Dich in einem bewaldeten Tal.");
  AddDetail( ({ "boden" }),
    "Du stehst mitten auf einer saftigen Wiese.");
  AddDetail( ({ "weg" }),
    "Der Weg liegt hinter dem Gatter. Er fuehrt nach Westen durch die Birken hindurch, im Osten wird er allerdings von einem dichten Wald verschluckt."
    "Ansonsten siehst Du ausser Birken und Gebirge eigentlich nichts. ");
  AddDetail( ({ "westen" }),
    "Im Westen beginnt uebergangslos ein dichter Buchenwald.");
  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Die gruenen Blaetter der Birken wetteifern mit dem Gras darum wer im Licht der Sonne am "
    "strahlendsten erscheint.");
  AddDetail( ({ "gruen" }),
    "Das Gruen der Birkenblaetter ist etwas heller als das der Wiese.");
  AddDetail( ({ "bienchen" }),
    "Die Bienchen summen froehlich um Dich herum.");
  AddDetail( ({ "buchenwald", "buchen", "wald" }),
    "Du kannst den Buchenwald nach Westen hin betreten.");

  AddDetail( ({ "osten" }),
    "Im Osten erstreckt sich ein lichter Birkenhain.");  
  AddDetail( ({ "gatter" }),
    "Das Gatter ist geschlossen.");
  AddDetail( ({ "weide" }),
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geschlossenes Gatter.");
  AddDetail( ({ "rand" }),
    "Du stehst am Rand, also nicht mittendrauf.");
  AddDetail( ({ "norden" }),
    "Nach Norden kannst Du die Weide verlassen, wenn das Gatter offen ist.");



 AddExit("sueden", BIRKE_ROOM+"weide_2b.lpc");
AddExit("suedwesten", BIRKE_ROOM+"weide_2a.lpc");
AddExit("suedosten", BIRKE_ROOM+"weide_2c.lpc");
 
   AddCmd(({"oeffne"}),"oeffnen");
   AddCmd(({"schliesse","schliess"}),"schliessen");

 }

int schliessen(string str)
{
	notify_fail("Was moechtest Du schliessen?\n");
	if (str!="gatter") return 0;

	if(!offen)write("Das Gatter ist doch zu.\n");
	else
		{
			 RemoveExit("norden");
  AddDetail( ({ "gatter" }),
    "Das Gatter ist geschlossen.");
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geschlossenes Gatter." );
	write("Du schliesst das Gatter.\n");
	say(TPN+" schliesst das Gatter.\n",TP);
	offen=0;
			call_other(BIRKE_ROOM + "birkenhainelfen_4","zu");
		}
return 1;
}


int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if (str!="gatter") return 0;

	if(offen)write("Das Gatter ist doch schon auf.\n");
	else
		{
			AddExit("norden", BIRKE_ROOM+"birkenhainelfen_4.lpc");
			AddDetail( ({ "gatter" }),
    		"Das Gatter ist geoeffnet, Du kannst die Weide also problemlose verlassen.");
 			AddDetail( ({ "weide" }),
    		"Die Weide liegt suedlich von Dir.");
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geoeffnetes Gatter." );
			write("Du oeffnest das Gatter.\n");
			say(TPN+" oeffnet das Gatter.\n",TP);
			offen=1;
			call_other(BIRKE_ROOM + "birkenhainelfen_4","auf");
		}
	return 1;		
	
	}
	
void zu()//wird bei reset des anderen Raumes aufgerufen
{
	RemoveExit("norden");
  AddDetail( ({ "gatter" }),
    "Das Gatter ist geschlossen.");
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geschlossenes Gatter." );
    offen=0;
   tell_room(TO,"Das Gatter faellt zu.\n");
   
	}

void auf()//wird vom anderen Raum aufgerufen
{
			AddExit("norden", BIRKE_ROOM+"birkenhainelfen_4.lpc");
			AddDetail( ({ "gatter" }),
    		"Das Gatter ist geoeffnet, Du kannst die Weide also problemlose betreten.");
 			AddDetail( ({ "weide" }),
    		"Die Weide liegt suedlich von Dir.");
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.\nEin geoeffnetes Gatter." );
			offen=1;
	    tell_room(TO,"Das Gatter wird von der anderen Seite geoeffnet.\n");
		offen=1;
	}