// macht magen ziemlich leer
inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "kotzi");
  SetProp(P_LONG,
    "Du siehst ein kotzi." );
  SetProp(P_NAME, "Kotzi");
  SetProp(P_GENDER, MALE);



SetProp(P_FOOD_INFO, ([F_SOAK:-20010,
											 F_HEAL:({10,10}), 
											 F_MSG: "Du kotzt.", 
											 F_MSG_ROOM: "kotzt."]));


  AddId("kotzi");

  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 150); 
  SetProp(P_VALUE, 50);


 
}

