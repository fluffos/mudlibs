#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas weisse Wolle");
  SetProp(P_LONG,
    "Du siehst einen kleinen Batzen weisser Wolle vor Dir." );
  SetProp(P_NAME, "Wolle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wolle", "batzen"}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 200);

	}