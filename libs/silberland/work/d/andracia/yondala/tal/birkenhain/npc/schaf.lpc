// Ein Schaf

inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include <mnpc.h>
#include <food.h>
string herrchen;
int melkbar;
int laune;
object leine;
object besitzer;

	
void reset()
{
if(!present("wolle",TO)) CLONEME(BIRKE_OBJ+ "wolle.lpc");
melkbar=1;

if(laune>40)write("Das Schaf stubst Dich an und praesentiert Dir seine prallen Zitzen.\n");
else if(laune>20) write("Das Schaf schaut Dich verliebt an.\n");

if (laune>5)laune--;	
::reset();
	}

void init()
{
	::init();
	
if (laune>10&&TPN==herrchen&&TP->InFight())
 {
 	call_out("getuemmel",1);
 	}
//sonst Defender rausnehmen!
//else
	//besitzer->SetProp(P_DEFENDERS,besitzer->QueryProp(P_DEFENDERS)-({TO}));
   
   }

void getuemmel()
{
	if (environment(besitzer)==environment(TO))
	 	{
	 		tell_room(environment(TO), "Das Schaf wirft sich wuetend ins Getuemmel.\n");
 		 	besitzer->AddDefender(TO);
 		}
}

string wieschautsaus(mixed viewer, mixed viewpoint, int shortflag)
{
	string result;
	string leine;
  string aussehen;
	leine="";
	aussehen="treuherzig";
	if (herrchen) leine=" Das Schaf ist an "+herrchen+" angeleint.";
  if (laune<0) aussehen="irgendwie wuetend";
	  
if(present("wolle",TO))
	
	  result= "Du siehst ein kleines Schaf vor Dir das Dich "+aussehen+" anschaut. Es hat dicke, weisse "+
    "Wolle an seinem Koerper und wurde scheinbar schon laenger nicht geschoren."+leine+"\n";
		
else
	
	 	result= "Du siehst ein kleines Schaf vor Dir das Dich "+aussehen+" anschaut. Es wurde "+
			"vermutlich erst kuerzlich geschoren, denn es ist nackt und ziemlich rosa."+leine+"\n";
 return result;
}

string wieschautsauskurz(mixed viewer, mixed viewpoint, int shortflag)
{
	if(herrchen) return "Ein angeleintes Schaf";
	return "Ein Schaf";
	
	}

void create() {
  if (!is_clone(TO)) return;
  ::create();
herrchen=0;
melkbar=1;
laune =0;
  SetProp(P_SHORT,#'wieschautsauskurz);//' "Ein Schaf");
  SetProp(P_LONG,#'wieschautsaus);//'
  SetProp(P_NAME, "Schaf");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schaf"}));
  SetProp(P_ARTICLE, 1);
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen Hufen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Schaf");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 0);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, BIRKE_ROOM +"weide_4b.lpc");
SetProp (P_MNPC_AREA, "/d/" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+ MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 5, 5}));
 
  

  SetProp(P_MSGIN, "trottet herein"); 
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "laeuft weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Schaf");
  SetProp(P_KILL_MSG, "Maeh!");

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "maeht Dich an.\n");

  CLONEME(BIRKE_OBJ + "wolle.lpc");

SetChats(3, ({
   "Das Schaf bloekt.\n",
   "Das Schaf schmatzt.\n"}) );

  AddCmd(({"schere","scher"}),"scheren");
  AddCmd(({"melke","melk"}),"melken");
  AddCmd(({"fick","ficke"}),"ficken");
   
}

void wutflucht()
{
	string *ausgaenge;
	tell_room(environment(TO), "Das Schaf reisst sich wuetend von der Leine los.\n");
	besitzer->RemovePursuer(TO);
	
	herrchen=0;
	besitzer=0;
	SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({1, 1, 1}));
	SetProp(P_MSGOUT, "trottet");
	SetChats(3, ({
	    "Das Schaf bloekt.\n",
   		"Das Schaf schmatzt.\n"}) );
  if(leine=present("leine",TP))leine->leinelos();
//   		angeleint=0;
	ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  command( ausgaenge[random(sizeof(ausgaenge))] );

	}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
          	if(TPN==herrchen&&laune>0) 
          		{
					      call_out("reaction", 0, TP, 
       					"stubst seine Nase gegen Deine Hand.",
        				"stubst seine Nase gegen "+TP->name(WESSEN)+" Hand.");
        			}
        		else 
        			  call_out("reaction", 0, TP,
        					"maeht.",
        					"maeht.");
      break;
    case "aergerlich":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
        if(laune<(-20)) wutflucht();
        	
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "maeht.",
        "maeht.");
      break;
    case "fies":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
         "schnaubt Dich boese an.",
         "schnaubt "+TPN+" boese an.");
         if(laune<(-20)) wutflucht();
        	
      break;
    case "frech":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
         "schnaubt Dich boese an.",
         "schnaubt "+TPN+" boese an.");
         if(laune<(-20)) wutflucht();
        	
    break;
    case "froh":
      call_out("reaction", 0, TP,
        "maeht froh.", 
        "maeht froh.");
      break;
    case "intim":
         	if(TPN==herrchen)
         		
    		{ 
    			if (laune>0)  
    			 			call_out("reaction", 0, TP,
			        "schmust mit Dir.",
			        "schmust mit " +TPN+ ".");
			      
			     else
			     	  call_out("reaction", 0, TP,
			        "schmust mit Dir.",
			        "schmust mit " +TPN+ ".");
						laune++;
			      
			      }
			    else
      call_out("reaction", 0, TP,
        "maeht Dich entruestet an.",
        "maeht "+TPN+" entruestet an.");
      break;
    case "nett":
         	if(TPN==herrchen)
    		{
    			call_out("reaction", 0, TP,
			        "kuschelt sich an Dich.",
			        "kuschelt sich an " +TPN+ ".");
			     laune++;
        	
        	}
       else call_out("reaction", 0, TP,
        		"maeht Dich an.",
        		"maeht "+TPN+" an.");

      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "maeht.",
        "maeht.");
      break;
    case "traurig":
    	if(TPN==herrchen&&laune>0)
    		{
    			call_out("reaction", 0, TP,
        		"schlappert Dir ein Traenchen aus dem Gesicht.",
        		"schlappert "+TPN+" ein Traenchen aus dem Gesicht.");
        	}
       else call_out("reaction", 0, TP,
        		"maeht Dich an.",
        		"maeht "+TPN+" an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}



int scheren(string str)
{
	string *ausgaenge;
	object wolle;
	notify_fail("Was moechtest Du scheren?\n");
	if(str!="schaf") return 0;
	if(present("schafschere",TP))
		{
			if(!member(TP->QueryProp(P_PURSUERS),TO))
				{
					write("Das Schaf bekommt Angst und weicht Dir aus.\n");
					say(TPN+" versucht das Schaf zu scheren.\n",TP);
					ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  				command( ausgaenge[random(sizeof(ausgaenge))] );
  				}
  		else
  			{
  				if(present("wolle",TO))
  					{
  						write("Vorsichtig setzt Du die Schere an und scherst das Schaf. Schnell haelst Du einen Batzen Wolle in den Haenden.\n");
							say(TPN+" schert das Schaf.\n",TP);
							wolle=present("wolle",TO);
							wolle->move(this_player(), M_GET);
							
						}
					else write("Das Schaf wurde offenbahr erst kuerzlich geschoren, Du solltest warten, bis die Wolle nachgewachsen ist.\n");
						
						
				}
			}
	 else	write("Du solltest dafuer eine Schafschere dabei haben.\n");
	return 1;
	}

int melken(string str)
{
	string *ausgaenge;
	object wolle;
	notify_fail("Was moechtest Du melken?\n");
	if(str!="schaf") return 0;
	if(TP->InFight()||InFight())
		{
			write("Waehrend eines Kampfes kannst Du kein Schaf melken.\n");
			return 1;
			}
	
	if(TP->QueryProp(P_PURSUERS)==0|| !member(TP->QueryProp(P_PURSUERS),TO))
				{
					write("Das Schaf bekommt Angst und weicht Dir aus.\n");
					say(TPN+" versucht das Schaf zu melken.\n",TP);
					ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  				command( ausgaenge[random(sizeof(ausgaenge))] );
  				}
  		else
  			{
  				if(melkbar)
  					{
  						if(laune<-15)
  							{
  								write("Das Schaf schnappt nach Dir und laesst sich nicht melken. Vielleicht solltest Du netter zu ihm sein?\n");
   								say(TPN+" versucht das Schaf zu melken, wird aber gebissen.\n",TP);
  								TP->AddHp(-5);
  								return 1;
  							}
  						write("Du kniest Dich vor das Schaf und melkst es.\n");
							say(TPN+" melkt das Schaf.\n",TP);

  						if(TP->drink_soft(5, 1))
  							{
  								write("Gleich trinkst Du die koestliche warme Milch.\n");
									TP->AddHp(20);
									TP->AddSp(20);
								}
							else write("Da Du so voll bist fliesst die gute Milch auf den Boden. Schade.\n");
							melkbar--;
						}

					else write("Das Schaf wurde offenbahr erst kuerzlich gemolken, es kommt keine Milch.\n");
					}
						
	return 1;
	}




string besitzer()
{
	if(herrchen)
		return herrchen;
	return 0;
	}

void inbesitznahme(object wer)
{
	besitzer=wer;
	herrchen=besitzer->name();
	 
	}


void freigabe()
{
	herrchen=0;
	besitzer=0;
	}

void flucht()
{
	string *ausgaenge;
	tell_room(environment(TO), "Das Schaff reisst sich wuetend von der Leine los.\n");
	
	ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  command( ausgaenge[random(sizeof(ausgaenge))] );
	herrchen=0;
	SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({5, 5, 5}));
	SetProp(P_MSGOUT, "trottet");
	SetChats(3, ({
	    "Das Schaf bloekt.\n",
   		"Das Schaf schmatzt.\n"}) );
  if(leine=present("leine",TP))leine->leinelos();
//   		angeleint=0;
	
	}

int launi()
{return laune;}




void InformDefend(object enemy)
{
	if (laune>10)	Kill(enemy);
}

give_notify(object ob)
{
	if(ob->QueryProp(P_FOOD_INFO)&&TPN==herrchen)
		{
			command("iss "+ob->name());
	  	tell_room(environment(TO), "Das Schaf frisst "+ob->name(WEN, 1)+".\n");
	  }
	else 
		{
			tell_room(environment(TO), "Das Schaf laesst "+ob->name(WEN, 1)+" fallen.\n");
  		ob->move(environment(TO),M_SILENT); 
  	}
			
}

void die(int poisondeath)
{
//	object besitzer;
	//if(besitzer=present(herrchen,TO)&&leine=present("leine",besitzer)) leine->leinelos();
	if(besitzer)
		{
			leine=present("leine",besitzer);
	 		leine->leinelos();
	 	}
	 if(QueryProp(P_KILLER))
	 	{
	 		if(QueryProp(P_KILLER)->id("fuchs")||QueryProp(P_KILLER)->id("wolf"))	
	    QueryProp(P_KILLER)->frissmich1();
	  }
	::die(poisondeath);
	
	}
	
int ficken(string str)
{
	if(str=="schaf")
		{
			if(TP->QueryProp(P_GENDER)==MALE)
				{
					write("Du vergehst Dich an dem Schaf.\n");
					say(TPN+" vergeht sich an dem Schaf.\n",TP);
					TP->SetProp(P_TITLE,"fickt Schafe");
					if(TP==besitzer) wutflucht();
					else Kill(TP);
					return 1;
					}
			else
				{
					write("Das Schaf ist weiblich. Wird schwer fuer Dich.\n");
					return 1;
				}
			}
	
	}
	
void BecomesNetDead(object spieler)
{
	if(spieler==besitzer)
		{
			herrchen=0;
			besitzer=0;
			SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
			SetProp (P_MNPC_WAIT, ({5, 10, 5}));
			SetProp(P_MSGOUT, "trottet");
			SetChats(3, ({
	    	"Das Schaf bloekt.\n",
   			"Das Schaf schmatzt.\n"}) );
   				besitzer->RemovePursuer(TO);

   	}
		
	
	}
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
	if(player==besitzer)
		{
				string *ausgaenge;

			herrchen=0;
			besitzer=0;
			
			SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
			SetProp (P_MNPC_WAIT, ({5, 10, 5}));
			SetProp(P_MSGOUT, "trottet");
			SetChats(3, ({
	    	"Das Schaf bloekt.\n",
   			"Das Schaf schmatzt.\n"}) );			
				leine=present("leine",besitzer);
				leine->leinelos();
			  tell_room(environment(TO), "Das Schaf springt entsetzt davon.\n");
	
				ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
 				command( ausgaenge[random(sizeof(ausgaenge))] );
			besitzer->RemovePursuer(TO);
			}
}