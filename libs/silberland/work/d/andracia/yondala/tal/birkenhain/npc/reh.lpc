inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
int groesse;

void create() {
  if (!is_clone(TO)) return;
  ::create();

groesse = random(2);
switch(groesse)
{	case 1: {      
	  SetProp(P_SHORT, "Ein grosses Reh");
   SetProp(P_NAME_ADJ, "gross");
	create_default_npc(4);
	break;}

	default: {
    SetProp(P_SHORT, "Ein kleines Reh");
  SetProp(P_NAME_ADJ, "klein");
  create_default_npc(2);
}}
  SetProp(P_LONG,
    "Du siehst ein braunes Reh, welches Dich misstrauisch beaeugt.");
  SetProp(P_NAME, "Reh");
  SetProp(P_GENDER, NEUTER);
  AddId(({"reh", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(4);
  SetProp(P_HANDS, ({" mit seinen Hufen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Reh");
  SetProp(P_SIZE, 110);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "stakst herbei");
  SetProp(P_MSGOUT, "stakst");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/tal/yondala/faunenwald") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, BIRKE_ROOM "/d/tal/yondala/faunenwald/faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Reh");

  AddInfo(DEFAULT_INFO, "schaut Dich aengstlich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Reh kann Deine Sachen nicht tragen.\n" }) );

}

