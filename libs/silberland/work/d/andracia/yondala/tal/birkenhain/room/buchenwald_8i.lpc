#include "../def.h"
inherit BIRKE_ROOM + "buchenwald_std.lpc";
#include <properties.h>


void create() 
{
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Nach Westen hin oeffnet sich der Wald und Du siehst einen "+
"lichten Birkenhain.");
//anderen Raum Laden wegen transporter
catch(call_other("/d/huegelland/yason/zwirbelstein/room/burg/zs_burg_dach_a2", "???"));

  AddDetail( ({ "westen", "birkenhain" }),
    "Nach Westen kannst Du den Wald verlassen und einem Weg durch den Birkenhain folgen.");
  AddDetail( ({ "weg" }),
    "Du kannst einen getrampelten Weg erkennen welcher durch den Birkenhain fuehrt.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");



 AddExit( "norden", BIRKE_ROOM+"buchenwald_7i.lpc" ); 
 AddExit( "suedosten", BIRKE_ROOM+"buchenwald_9j.lpc");
 AddExit("westen", BIRKE_ROOM+"birkenhainelfen_3.lpc");
 
 }

kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
   if( str == "rauf"||str == "hinauf"||str == "herauf"||str == "nach oben"
  	||str == "auf baum"||str == "baum rauf"||str=="hoch" ||str=="an furchen hoch" 
  	||str=="an fruchen nach oben" ||str=="an furchen rauf" ||str=="leiter rauf")
  	  {
  	TP->move(ELFEN_ROOM + "aboriville_8i", M_GO,
  	"","klettert nach oben","klettert einen Baum hinauf");
		write("Du kletterst einen Baum hinauf und steigst ueber ein hoelzernes Gelaender.\n");
    say( TPN+" klettert einen Baum hinauf und verschwindet in der Krone.\n");
    return 1;

  }
  return 0;
}
	
void peterle()
{
	object ob;
	ob=clone_object( "/d/andracia/yondala/tal/aboriville/npc/mensch_peter" );
	ob->move(TO,M_GO);
}