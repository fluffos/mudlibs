#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine rote Weste");
  SetProp(P_LONG,
    "Du siehst eine zerfranste, alte Weste die auch noch sehr unschoen "
    "riecht." );

  SetProp(P_NAME, "Weste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"weste"}) );
  AddAdjective( ({"rot"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 80);
                                    

  SetProp(P_QUALITY_DECAY, 30);

}


