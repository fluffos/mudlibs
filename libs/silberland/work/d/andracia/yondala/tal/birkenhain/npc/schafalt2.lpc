// Ein Schaf

inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include <mnpc.h>
#include <food.h>
string herrchen;
int melkbar;
int laune;
object leine;

aussehen()
{
	string leine;
	leine="";
	if (herrchen)leine="Das Schaf ist an "+herrchen+" angeleint.";

if(present("wolle",TO))
	{
		if (laune>=0)
	  SetProp(P_LONG,
    "Du siehst ein kleines Schaf vor Dir das Dich treuherzig anschaut. Es hat dicke, weisse "
    "Wolle an seinem Koerper und wurde scheinbar schon laenger nicht geschoren."+leine);
  else
    SetProp(P_LONG,
      "Du siehst ein kleines Schaf vor Dir das Dich irgendwie wuetend anschaut. Es hat dicke, weisse "
      "Wolle an seinem Koerper und wurde scheinbar schon laenger nicht geschoren."+leine);
		}
else
	{
		if (laune>=0)
  	SetProp(P_LONG,
		  "Du siehst ein kleines Schaf vor Dir das Dich treuherzig anschaut. Es wurde "
			"vermutlich erst kuerzlich geschoren, denn es ist nackt und ziemlich rosa."+leine);
 		else
 		  SetProp(P_LONG,
			  "Du siehst ein kleines Schaf vor Dir das Dich irgendwie wuetend anschaut. Es wurde "
			  "vermutlich erst kuerzlich geschoren, denn es ist nackt und ziemlich rosa."+leine);
	}
	
	}
	
void reset()
{
	aussehen();


if(!present("wolle",TO)) CLONEME(BIRKE_OBJ+ "wolle.lpc");
melkbar=1;

if(laune>20) write("Das Schaf schaut Dich verliebt an.\n");
laune--;	
::reset();

	
	}

void init()
{
	::init();
	
if (laune>20&&TPN==herrchen)
 {
 	tell_room(environment(TO), "Das Schaf wirft sich wuetend ins Getuemmel.\n");
 	TP->AddDefender(TO);
}
 
   	}



void create() {
  if (!is_clone(TO)) return;
  ::create();
herrchen=0;
melkbar=1;
laune =0;
  SetProp(P_SHORT, "Ein Schaf");
  SetProp(P_LONG,
    "Du siehst ein kleines Schaf vor Dir das Dich treuherzig anschaut. Es hat dicke, weisse "
    "Wolle an seinem Koerper und wurde scheinbar schon laenger nicht geschoren.");
  SetProp(P_NAME, "Schaf");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schaf"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen Hufen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Schaf");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 0);
  //SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, "/d/tal/yondala/wald/room/weide_4b.lpc");
SetProp (P_MNPC_AREA, "/d/" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+ MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 5, 5}));
 
  

  SetProp(P_MSGIN, "trottet herein"); 
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "laeuft weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Schaf");
  SetProp(P_KILL_MSG, "Maeh!");

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "maeht Dich an.\n");

  CLONEME(BIRKE_OBJ+ "wolle.lpc");

SetChats(3, ({
   "Das Schaf bloekt.\n",
   "Das Schaf schmatzt.\n"}) );

  AddCmd(({"schere","scher"}),"scheren");
  AddCmd(({"melke","melk"}),"melken");
   
}

void wutflucht()
{
	string *ausgaenge;
	tell_room(environment(TO), "Das Schaf reisst sich wuetend von der Leine los.\n");
	
	ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  command( ausgaenge[random(sizeof(ausgaenge))] );
	herrchen=0;
	SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({1, 1, 1}));
	SetProp(P_MSGOUT, "trottet");
	SetChats(3, ({
	    "Das Schaf bloekt.\n",
   		"Das Schaf schmatzt.\n"}) );
  if(leine=present("leine",TP))leine->leinelos();
//   		angeleint=0;
	
	}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
          	if(TPN==herrchen&&laune>0) 
          		{
					      call_out("reaction", 0, TP, 
       					"stubst seine Nase gegen Deine Hand.",
        				"stubst seine Nase gegen "+TP->name(WESSEN)+" Hand.");
        			}
        		else 
        			  call_out("reaction", 0, TP,
        					"maeht.",
        					"maeht.");
      break;
    case "aergerlich":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
        if(laune<(-20)) wutflucht();
        	aussehen();
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "maeht.",
        "maeht.");
      break;
    case "fies":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
         "schnaubt Dich boese an.",
         "schnaubt "+TPN+" boese an.");
         if(laune<(-20)) wutflucht();
        	aussehen();
      break;
    case "frech":
         	if(TPN==herrchen) laune--;
      call_out("reaction", 0, TP,
         "schnaubt Dich boese an.",
         "schnaubt "+TPN+" boese an.");
         if(laune<(-20)) wutflucht();
        	aussehen();
    break;
    case "froh":
      call_out("reaction", 0, TP,
        "maeht froh.", 
        "maeht froh.");
      break;
    case "intim":
         	if(TPN==herrchen)
         		
    		{ 
    			if (laune>0)  
    			 			call_out("reaction", 0, TP,
			        "schmust mit Dir.",
			        "schmust mit " +TPN+ ".");
			      
			     else
			     	  call_out("reaction", 0, TP,
			        "schmust mit Dir.",
			        "schmust mit " +TPN+ ".");
						laune++;
			      aussehen();
			      }
			    else
      call_out("reaction", 0, TP,
        "maeht Dich entruestet an.",
        "maeht "+TPN+" entruestet an.");
      break;
    case "nett":
         	if(TPN==herrchen)
    		{
    			call_out("reaction", 0, TP,
			        "kuschelt sich an Dich.",
			        "kuschelt sich an " +TPN+ ".");
			     laune++;
        	aussehen();
        	}
       else call_out("reaction", 0, TP,
        		"maeht Dich an.",
        		"maeht "+TPN+" an.");

      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "maeht.",
        "maeht.");
      break;
    case "traurig":
    	if(TPN==herrchen&&laune>0)
    		{
    			call_out("reaction", 0, TP,
        		"schlappert Dir ein Traenchen aus dem Gesicht.",
        		"schlappert "+TPN+" ein Traenchen aus dem Gesicht.");
        	}
       else call_out("reaction", 0, TP,
        		"maeht Dich an.",
        		"maeht "+TPN+" an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}



int scheren(string str)
{
	string *ausgaenge;
	object wolle;
	notify_fail("Was moechtest Du scheren?\n");
	if(str!="schaf") return 0;
	if(present("schafschere",TP))
		{
			if(!member(TP->QueryProp(P_PURSUERS),TO))
				{
					write("Das Schaf bekommt Angst und weicht Dir aus.\n");
					say(TPN+" versucht das Schaf zu scheren.\n",TP);
					ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  				command( ausgaenge[random(sizeof(ausgaenge))] );
  				}
  		else
  			{
  				if(present("wolle",TO))
  					{
  						write("Vorsichtig setzt Du die Schere an und scherst das Schaf. Schnell haelst Du einen Batzen Wolle in den Haenden.\n");
							say(TPN+" schert das Schaf.\n",TP);
							wolle=present("wolle",TO);
							wolle->move(this_player(), M_GET);
							aussehen();
						}
					else write("Das Schaf wurde offenbahr erst kuerzlich geschoren, Du solltest warten, bis die Wolle nachgewachsen ist.\n");
						
						
				}
			}
	 else	write("Du solltest dafuer eine Schafschere dabei haben.\n");
	return 1;
	}

int melken(string str)
{
	string *ausgaenge;
	object wolle;
	notify_fail("Was moechtest Du melken?\n");
	if(str!="schaf") return 0;
	if(TP->QueryProp(P_PURSUERS)==0|| !member(TP->QueryProp(P_PURSUERS),TO))
				{
					write("Das Schaf bekommt Angst und weicht Dir aus.\n");
					say(TPN+" versucht das Schaf zu melken.\n",TP);
					ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  				command( ausgaenge[random(sizeof(ausgaenge))] );
  				}
  		else
  			{
  				if(melkbar)
  					{
  						write("Du kniest Dich vor das Schaf und melkst es.\n");
							say(TPN+" melkt das Schaf.\n",TP);

  						if(TP->drink_soft(5, 1))
  							{
  								write("Gleich trinkst Du die koestliche warme Milch.\n");
									TP->AddHp(20);
									TP->AddSp(20);
								}
							else write("Da Du so voll bist fliesst die gute Milch auf den Boden. Schade.\n");
							melkbar--;
						}

					else write("Das Schaf wurde offenbahr erst kuerzlich gemolken, es kommt keine Milch.\n");
					}
						
	return 1;
	}




string besitzer()
{
	if(herrchen)
		return herrchen;
	return 0;
	}

void inbesitznahme(string name)
{
	herrchen=name;
	}


void freigabe()
{
	herrchen=0;
	}

void flucht()
{
	string *ausgaenge;
	tell_room(environment(TO), "Das Schaff reisst sich wuetend von der Leine los.\n");
	
	ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  command( ausgaenge[random(sizeof(ausgaenge))] );
	herrchen=0;
	SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
	SetProp (P_MNPC_WAIT, ({5, 5, 5}));
	SetProp(P_MSGOUT, "trottet");
	SetChats(3, ({
	    "Das Schaf bloekt.\n",
   		"Das Schaf schmatzt.\n"}) );
  if(leine=present("leine",TP))leine->leinelos();
//   		angeleint=0;
	
	}

int launi()
{return laune;}

void InformDefend(object enemy)
{
	
 Kill(enemy);
}

give_notify(object ob)
{
	if(ob->QueryProp(P_FOOD_INFO)&&TPN==herrchen)
		{
			command("iss "+ob->name());
	  	tell_room(environment(TO), "Das Schaf frisst "+ob->name(WEN, 1)+".\n");
	  }
	else 
		{
			tell_room(environment(TO), "Das Schaf laest "+ob->name(WEN, 1)+" fallen.\n");
  		ob->move(environment(TO),M_SILENT); 
  	}
			
}