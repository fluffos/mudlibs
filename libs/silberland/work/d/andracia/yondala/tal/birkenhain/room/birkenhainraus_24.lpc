#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

 SetProp( P_INT_SHORT, "In einer Bergkluft" );
  SetProp( P_INT_LONG,
    "Rechts und links von Dir ragen hohe Berge auf, doch Du kannst "
    "problemlos auf einem Weg zwischen ihnen herlaufen. Es ist hier "
    "merklich kuehler als im Tal oder der Ebene, denn die Berge legen den Weg in zwielichtigen Schatten. "
    "Der Weg macht hier einen Knick." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "bergluft","kluft" }),
    "Du stehst in einer Kluft zwischen zwei Bergen.");
  AddDetail( ({ "kluft" }),
    "Du befindest Dich in einer Kluft, das ist ein schmaler Spalt zwischen den Bergen.");
  AddDetail( ({ "spalt", "platz" }),
    "Hier ist gerade genug Platz zum gehen.");
  AddDetail( ({ "berge" }),
    "Rechts und links von Dir ragen sie steil und zerklueftet nach oben.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt Dich hier weiter durch die Kluft nach Norden und nach Suedwesten.");
  AddDetail( ({ "norden" }),
    "Im Norden siehst Du entfernt den Birkenhain.");
  AddDetail( ({ "birkenhain" }),
    "Im Norden erkennst Du einen lichten Birkenhain.");
  AddDetail( ({ "suedwesten" }),
    "Im Suedwesten endet der Weg scheinbar.");
  AddDetail( ({ "knick" }),
    "Der Weg macht hier einen Knick von Norden nach Suedwesten.");
  AddDetail( ({ "tal" }),
    "Das Tal ist noerdlich von Dir.");
  AddDetail( ({ "ebene" }),
    "Die Ebene ist suedlich von Dir.");
  AddDetail( ({ "schatten" }),
    "Die Berge werfen einen kuehlenden Schatten auf Dich.");
  AddDetail( ({ "himmel" }),
    "Den kannst Du hier nicht sehen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht nur aus Fels.");
  AddDetail( ({ "fels" }),
    "Der Fels ist grau und kalt.");

 /* AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");
*/

 AddExit( "suedwesten", BIRKE_ROOM +"birkenhainraus_25.lpc" ); 
 AddExit("norden", BIRKE_ROOM+"birkenhainraus_23.lpc");
 
 }


