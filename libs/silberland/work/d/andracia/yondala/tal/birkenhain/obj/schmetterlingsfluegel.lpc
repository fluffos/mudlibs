#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schmetterlingsfluegel");
  SetProp(P_LONG,
    "Du siehst einen huebschen, bunten Schmeterlingsfluegel, den wohl irgendein brutales Wesen "
    "dem armen Tier entrissen haben muss..." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Schmetterlingsfluegel");
  SetProp(P_GENDER, MALE);
  AddId(({"fluegel","schmetterlingsfluegel"}));

  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 70);
  SetProp(P_NOBUY, 0);

}
