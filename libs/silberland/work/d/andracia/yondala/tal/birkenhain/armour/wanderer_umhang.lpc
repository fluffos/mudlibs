#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein langer Umhang");
  SetProp(P_LONG,
    "Du siehst einen alten, ziemlich langen Umhang. Er besteht aus dunklem Filz." );

  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang"}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5 ]) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_FELT);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 180);
 SetProp(P_AUTOLOADOBJ, 1);   
  SetProp(P_QUALITY_DECAY, 80);

}


