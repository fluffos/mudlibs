#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Wolfsfell");
  SetProp(P_LONG,
    "Du siehst ein dunkelbraunes Wolfsfell. Das Fell ist dreckig, stingt und mit vielen "
    "Narben versehen." );

  SetProp(P_NAME, "Wolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolfsfell", "\nfell_is_gerb_able"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 150);
                                

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_ACID:1]) );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}

