inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schmetterling");
  SetProp(P_LONG,
    "Ein Schmetterling mit gruen-blauen Fluegeln");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId(({"schmetterling", "insekt", "falter"})); //ansprech-namen
  CLONEME(BIRKE_OBJ "schmetterlingsfluegel" );
  create_default_npc(1);  /* 3=Stufe */
  SetProp(P_HANDS, ({" mit seinen Fluegeln",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "insekt"); // Rasse
  SetProp(P_SIZE, 5); // in centimeter
  SetProp(P_WEIGHT, 10); // in gramm
  SetProp(P_ALIGN, 0); // gesinnung -1000 bis +1000
  SetProp(P_MAX_HANDS, 2); // anz. Haende
  SetProp(P_HEAL,0); // HP-Rega durch "iß Leiche"
  SetProp(P_AGGRESSIVE,0); // Agressivitaets-Level
  SetProp(P_WIMPY, 0); // Flucht-Grenze
  SetProp(P_NOMAGIC,0); // Magie-ressi 0-100
//  SetProp(P_RESISTANCE_STRENGTHS , //  Ressis -1 bis +1

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
 SetProp(P_MNPC_WAIT, ({ 5, 5, 5 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp (P_MNPC_DEFAULTROOM,"/d/tal/yondala/wald/room/birkenhainelfen_2.lpc");
  SetProp (P_MNPC_AREA, ({"/d/tal/yondala/wald/"}));

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein niedlicher Schmetterling"); // BIRKE_NPC-Name fuer den killer


  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  //wenn gefragt wird

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schmetterling laesst es wieder fallen.\n" }) );


}
