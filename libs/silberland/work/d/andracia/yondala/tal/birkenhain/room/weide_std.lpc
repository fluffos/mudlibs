#include "../def.h"
inherit "std/room";

#include <properties.h>
int offen;

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Weide" );
  SetProp( P_INT_LONG,
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "birkenhain" }),
    "Der Birkenhain ist jenseits des Zaunes."  );
  AddDetail( ({ "wiese" }),
    "Du stehst mitten auf einer bluehenden Wiese. Das Gras ist kniehoch und wilde Blumen stechen "
    "immerwieder bunt hervor. Ein paar Bienchen summen um Dich herum.");
  AddDetail( ({ "gras" }),
    "Das Gras ist hier durchschnittlich kniehoch und wird immer wieder von bunten Blumen unterbrochen");
  AddDetail( ({ "blumen" }),
    "Die bunten Blumen sind hier wild gewachsen und bilden zusammen mit dem gruenen Gras einen "
    "bunten Teppich.");
  AddDetail( ({ "teppich" }),
    "Die gruene Wiese sieht mit den wilden Blumen zusammen aus wie ein bunter Teppich.");
  AddDetail( ({ "birken", "birke" }),
    "Die Birken stehen vereinzelt in dem Hain.");
  AddDetail( ({ "licht", "kraft" }),
    "Die Sonne strahlt heute mit all ihrer warmen Kraft auf diesen Birkenhain.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht vom blauen Himmel herunter und waermt Dich.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmlisch blau und eine sonnige Sonne laechelt auf Dich herunter.");
  AddDetail( ({ "ferne" }),
    "Weit weg.");
  AddDetail( ({ "gebirge", "auslaeufer" }),
    "Das Gebirge umgibt dieses Tal vollstaendig.");
  AddDetail( ({ "tal" }),
    "Du befindest Dich in einem bewaldeten Tal.");
  AddDetail( ({ "boden" }),
    "Du stehst mitten auf einer saftigen Wiese.");
  AddDetail( ({ "weg" }),
    "Der Weg liegt hinter dem Gatter. Er fuehrt nach Westen durch die Birken hindurch, im Osten wird er allerdings von einem dichten Wald verschluckt."
    "Ansonsten siehst Du ausser Birken und Gebirge eigentlich nichts. ");
  AddDetail( ({ "westen" }),
    "Im Westen beginnt uebergangslos ein dichter Buchenwald.");
  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Die gruenen Blaetter der Birken wetteifern mit dem Gras darum wer im Licht der Sonne am "
    "strahlendsten erscheint.");
  AddDetail( ({ "gruen" }),
    "Das Gruen der Birkenblaetter ist etwas heller als das der Wiese.");
  AddDetail( ({ "bienchen" }),
    "Die Bienchen summen froehlich um Dich herum.");
  AddDetail( ({ "buchenwald", "buchen", "wald" }),
    "Du kannst den Buchenwald nach Westen hin betreten.");

  AddDetail( ({ "osten" }),
    "Im Osten erstreckt sich ein lichter Birkenhain.");  
  AddDetail( ({ "weide" }),
    "Du stehst am Rand einer kleinen Weide. Suedlich von Dir weitet sie sich ein wenig aus, "
    "nach Norden ist sie durch ein Gatter begrenzt. Hinter dem die Weide umschliessenden Zaun "
    "siehst Du um Dich herum einen herrlichen Birkenhain.");
  AddDetail( ({ "zaun" }),
    "Der Zaun umgibt die Weide.");
  AddDetail( ({ "rand" }),
    "Du stehst am Rand der Weide, direkt neben dem Zaun.");
  AddDetail( ({ "gatter" }),
    "Um die Weide zu verlassen, wurde ganz im Norden ein Gatter in den "
	"Zaun eingebaut.");


  AddSound( DEFAULT_SOUND,
    "Du hoerst ein paar Grillen Zirpen und hin und wieder das Bloeken eines Schafes.");

  AddSound( ({ "bloeken","schaf" }),
    "Du hoerst ein sattes: Maeh!");
  AddSound( ({ "grillen","grille" }),
    "Klingt irgendwie romantisch.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Heu. Die Luft ist herrlich warm.");

  AddSmell( ({ "heu", "wiese" }),
    "Die warme Wiese ist so trocken, dass es schon ein wenig nach Heu riecht.");
  AddSmell( ({ "luft" }),
    "Die Luft ist warm und riecht leicht suesslich.");
  AddSmell( ({ "" }),
    "");



 }



