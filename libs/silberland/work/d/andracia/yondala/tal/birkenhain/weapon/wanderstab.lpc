#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Wanderstab");
  SetProp(P_LONG,
    "Dieser Wanderstab ist aus einem sehr harten Holz geschnitzt. Kleine Ornamente und Bilder "
    "schmuecken ihn. Man kann ihn aber auch als Waffe benutzen." );
   SetProp(P_NAME, "Wanderstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab", "wanderstab"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE,120);
  SetProp(P_VALUE, 200);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_AUTOLOADOBJ, 1);                                     
  
}
