inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int groesse;

void create() {
  if (!is_clone(TO)) return;
  ::create();

groesse = random(2);
switch(groesse)
{	case 1: {      
  SetProp(P_SHORT, "Ein grosses Eichhoernchen");
	SetProp(P_NAME_ADJ, "gross");
	create_default_npc(2);
	break;}

	default: {
  SetProp(P_SHORT, "Ein kleines Eichhoernchen");
  SetProp(P_NAME_ADJ, "klein");
  create_default_npc(1);
}}

  SetProp(P_LONG,
    "Du siehst ein rotbraunes Eichhoernchen, welches fleissig Nuesse fuer den Winter versteckt.");
  SetProp(P_NAME, "Eichhoernchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"eichhoernchen", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 600);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "huepft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, BIRKE_ROOM );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, BIRKE_ROOM + "faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Eichhoernchen");

  AddInfo(DEFAULT_INFO, "schaut Dich neugierig an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Eichhoernchen kann Deine Sachen nicht tragen.\n" }) );
  SetChats(3, ({
    "Das Eichhoernchen schaut Dich neugierig an.\n",
    "Das Eichhoernchen versucht an Deinem Bein hochzuklettern.\n",
    "Das Eichhoernchen vergraebt eine Nuss.\n"}) );

}


