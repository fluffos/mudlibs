#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Wanderstiefel");
  SetProp(P_LONG,
    "Du siehst ein Paar sehr robuster Wanderstiefel. Auch wenn sie schon etwas abgenutzt "
    "sind, scheinen sie sehr stabil zu sein." );

  SetProp(P_NAME, "Wanderstiefelpaar");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "wanderstiefel", "paar"}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4 ]) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1200);
                                    

  SetProp(P_QUALITY_DECAY, 150);

}


