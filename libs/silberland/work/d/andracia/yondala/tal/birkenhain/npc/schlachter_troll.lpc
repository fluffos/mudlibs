inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
	//if(TP->id("schaf")) Kill(TP);
	::init();
	}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Troll");
  SetProp(P_LONG,
    "Du siehst einen riesigen, haarigen Troll vor Dir. Er ist mit einer roten Weste "
    "bekleidet und haelt ein bluttriefendes Schlachtermesser in den Haenden. "
    "Seine gelben Augen schauen Dich abschaetzend an.");
  SetProp(P_NAME, "Troll");
  SetProp(P_GENDER, MALE);
  AddId(({"troll", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
SUID;
 CLONEME(BIRKE_ARMOUR"troll_weste.lpc" );
 CLONEME(BIRKE_WEAPON"schlachtermesser.lpc" );
 CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung.lpc" );
 CLONEME("/p/armour/boots/lederschuhe.lpc" );
  command("zuecke messer");
  command("trage alles");  

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 300);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_ALIGN, -350);
  SetProp(P_MSGIN, "stapft heran");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/andracia/yondala/tal") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, BIRKE_ROOM "/d/andracia/yondala/tal/birkenhain/room/birkenhainelfen_5.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Troll");

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");
  AddInfo( ({"braten","schafsbraten"}),
    "Du mir ueberlassen Schaf, ich Dir geben halben Braten.",
    "sagt: ");
  AddInfo( ({"schaf",""}),
    "Schaf lecker.",
    "sagt: ");
  AddInfo( ({"hunger",""}),
    "Ich hungrig.",
    "sagt: ");
  AddInfo( ({"hilfe",""}),
    "Ich nix helfen.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Troll freut sich ueber das Geschenk.\n" }) );
  SetChats(1, ({
    "Der Troll fuchtelt mit seinem Messer herum.\n",
    "Der Troll leckt etwas Blut von seinem Messer.\n",
    "Der Troll schaut Dich hungrig an.\n"}) );
  AddCmd( ({ "ueberlasse", "ueberlass"}), "ueberlassen" ); //Wenn der Spieler ein Schaf an der Leine dabei hat

}

int ueberlassen(string str)
{
	object opfer;
	notify_fail("Der Troll sagt: Nur Schaf!\n");
	if(str!="schaf"&&str!="troll schaf") return 0;
	
	if(!present("schaf", environment(TO)))
		{
			write("Der Troll sagt: Kein Schaf da.\n");
			return 1;
		}
		
	if(!present("schafleine", TP))
		{
			write("Der Troll sagt: Schaf muss an Leine.\n");
			return 1;
		}
	if(opfer=present("schafleine", TP)->hatschaf())
		{
			write("Du ueberlaesst dem Troll Dein Schaf.\n");
			say(TPN+" ueberlaesst "+TP->QueryPossPronoun(WESSEN)+" Schaf dem "
			"Troll.\n",TP);

			opfer->die();
			opfer=present("leiche", environment(TP));
			opfer->remove();
 			CLONE("/d/andracia/yondala/wasser/pirateninsel/obj/schafsbraten.lpc", TP);
			write("Der Troll schlachtet Dein Schaf und schneidet sich ein Stueck ab.\n");
			say("Der Troll schlachtet das Schaf und schneidet sich ein Stueck ab.\n",TP);
			return 1;
		}
			write("Der Troll sagt: Schaf muss an Leine.\n");
	return 1;
}
	
	



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
      Attack(TP);  
}

