//Dies hier ist die Standartleiche, in die sich die getoeteten Tiere verwandeln, 
//wenn der Killer zum Clan des Naturvolkes gehoert.

//created by Yondala@Andracia.
//begonnen am 11.11.2006 Und ich hoer heut erst auf, wenn das funzt.
//nochmal umentscheiden am 13.11.2006: Wird keine Leiche, sondern ein Braten, der nach 10 Minuten zerfaellt.

inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Braten");
  SetProp(P_LONG,
    "Du siehst einen herrlich duftenden Braten." );
  SetProp(P_NAME, "Braten");
  SetProp(P_GENDER, MALE);



SetProp(P_FOOD_INFO, ([F_SOAK:10, //sollte ca HP+MP : 2 sein 
											 F_HEAL:({10,10}), // erst HP, MP, sollte 15 nicht ueberschreiten. Bei kleinen Tieren natuerlich niedriger.
											// F_HEAL:10, 
											 F_MSG: "Du verspeist einen koestlichen Braten, leise dankst Du dem Geist des Tieres.", //Der Text soll "netter" formuliert sein
											 F_MSG_ROOM: "verspeist einen koestlichen Braten und bedankt sich leise beim Geist des Tieres."]));


  AddId("braten");

  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 150); //leichter als das Originaltier, klar.
  SetProp(P_VALUE, 50);//kommt drauf an, was es war. Aber sollte 100 nicht ueberschreiten

  call_out("verfall", 10 );
 
}

int verfall()
{//write ("Ein Braten zerfaellt.\n");
	this_object()->remove();
	}