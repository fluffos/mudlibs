#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein zerborstener Pfeil");
  SetProp(P_LONG,
    "Ein zerborstener Pfeil steckt in einer blutenden Wunde." );
  SetProp(P_INFO, "Du kannst den Pfeil mit \"reisse Pfeil aus Wunde\" entfernen.");
  SetProp(P_NAME, "Pfeil");
  SetProp(P_GENDER, MALE);
  AddId("pfeil");

	SetProp( P_MATERIAL, ({ MAT_SILVER, MAT_MISC_WOOD, MAT_MISC_POISON }) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
 	SetProp(P_NEVERDROP, 1); 	
 	SetProp(P_NODROP, 1);
 AddCmd( ({ "reiss", "reisse" }), "reissen" );

}
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
	remove();
	}
	
reissen(string str)
{
	notify_fail( "Was moechtest Du woraus reissen?\n" );
  if( str == "pfeil aus wunde" )
{
	write("Mit einem starken Ruck reisst Du den Pfeil aus Deiner Wunde.\n");
	say(TPN+ " reisst sich einen Pfeil aus einer Wunde.\n");
  TP->do_damage(5,"Einen Pfeil aus der Wunde reissen");
	remove();
	return 1;	
	}
}