// Ein Schaf

inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include <mnpc.h>
string herrchen;
void init()
{::init();
//wenn er im richtigen Raum ist und das Gatter auf ist(sprich es nicht genau die drei Ausgaenge gibt)	
if(file_name(environment(TO))=="/d/tal/yondala/wald/room/weide_1b"
	&&environment(TO)->GetExits()!="Es gibt drei sichtbare Ausgaenge: suedosten, sueden und suedwesten. \n")
	tell_room(environment(TO),"Der Schaefer brummelt: Welcher Taugenichts hat schon wieder das Gatter auf gemacht?\n");
command("schliesse gatter");
if(TP->id("fuchs"))
	{
		command("sag Verdammter Fuchs!\n");
		Attack(TP);
	}
}	

void reset()
{
::reset();
	
	}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  herrchen=0;
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein Teihebschaefer");
  SetProp(P_LONG,
    "Du siehst einen kleinen, alten Teiheb vor Dir. Seine Haut ist dunkel und knitterig und zeugt "
    "von einem harten, arbeitssamen Leben. Er steht hier auf der Weide und huetet Schafe.");
  SetProp(P_NAME, "Schaefer");
  SetProp(P_GENDER, MALE);
  AddId(({"schaefer","mann","teiheb","teihebschaefer"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit einer Schafschere",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, 0);
  //SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, "/d/tal/yondala/wald/room/weide_1b.lpc");
SetProp (P_MNPC_AREA, "/d/tal/yondala/wald/room/weide_" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 15, 5}));
 
  

  SetProp(P_MSGIN, "kommt heran"); 
  SetProp(P_MSGOUT, "geht nach");
  SetProp(P_MMSGIN, "verschwindet");
  SetProp(P_MMSGOUT, "steht auf einmal neben Dir");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Teihebschaefer");
  SetProp(P_KILL_MSG, "Lass meine Schafe in Frieden!");

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "fragt mich nicht, ich bin nur ein einfacher Schaefer.\n");

  AddInfo("yondala", "Lang lebe Yondala.","sagt: ");

        

  AddInfo( ({ "schafe","schaf" }),
    "Ich huete hier die Schafe meines Volkes.",
    "sagt: ");
  AddInfo( ({ "volk" }),
    "Ich gehoere zum Volk der Teiheb.",
    "sagt: ");
  AddInfo( ({ "teiheb" }),
    "Die Teiheb sind das Volk der Wueste.",
    "sagt: ");
  AddInfo( ({ "wueste" }),
    "Die Wueste liegt jenseits der Helsperwaelder.",
    "sagt: ");
  AddInfo( ({ "helsperwaelder" }),
    "Die Helperwaelder liegen suedlich des Tales.",
    "sagt: ");
  AddInfo( ({ "tal" }),
    "In diesem Tal hier huete ich die Schafe meines Volkes. Hier gibt es viel besseres Gras als in der Wueste.",
    "sagt: ");
  AddInfo( ({ "gras" }),
    "Meine Schafe fressen Gras. Ich versuche stets das beste fuer sie zu finden.",
    "sagt: ");
  AddInfo( ({ "hilfe" }),
    "Wobei kann ich alter Teiheb Euch helfen?",
    "sagt: ");
  AddInfo( ({ "elfen" }),
    "Die Elfen leben nicht weit entfernt von hier in einem Buchenwald.",
    "sagt: ");
  AddInfo( ({ "buchenwald" }),
    "Nicht weit entfernt ist ein Buchenwald, dort versteckt liegt die Elfenstadt Aboriville.",
    "sagt: ");
  AddInfo( ({ "elfenstadt","aboriville" }),
    "Aboriville liegt versteckt in einem Buchenwald. Ich war noch nie da, das Elfenkraut ist mir zu teuer.",
    "sagt: ");
  AddInfo( ({ "elfenkraut" }),
    "Ohne Elfenkraut ist der Blick in Aboriville oft verschleiert.",
    "sagt: ");
  AddInfo( ({ "kraut" }),
    "Welches Kraut meint Ihr?",
    "sagt: ");
  AddInfo( ({ "wald","waelder" }),
    "Es gibt viele Waelder in Andracia. Meint Ihr einen bestimmten?",
    "sagt: ");
  AddInfo( ({ "andracia","welt" }),
    "Diese schoene Welt nennt sich Andracia.",
    "sagt: ");
  AddInfo( ({ "leine" }),
    "Mit dieser Leine leine ich meine Schafe an, wenn ich sie scheren oder melken will.",
    "sagt: ");
  AddInfo( ({ "schere","schafschere" }),
    "Mit dieser Schere schere ich meine Schafe, wenn wieder genuegend Wolle da ist.",
    "sagt: ");
  AddInfo( ({ "wolle" }),
    "Ich schere die Schafe und bringe die Wolle dann meinem Volk.",
    "sagt: ");
  AddInfo( ({ "milch","schafsmilch" }),
    "Ich ernaehre mich fast nur von Schafsmilch.",
    "sagt: ");
  AddInfo( ({ "mann" }),
    "Ich bin ein Mann.",
    "sagt: ");
  AddInfo( ({ "hirte","schaefer" }),
    "Schaefer sind oft sehr einsam.",
    "sagt: ");
  AddInfo( ({ "gesellschaft" }),
    "Ich habe nicht oft Gesellschaft. Nur meine lieben Schafe sind immer da.",
    "sagt: ");
  AddInfo( ({ "melken" }),
    "Meine Schafe lassen sich nur melken, wenn sie an der Leine sind.",
    "sagt: ");
  AddInfo( ({ "scheren" }),
    "Zum Scheren benoetige ich eine Schafschere. Ausserdem muss ich das Schaf anleinen, sonst laeuft es davon.",
    "sagt: ");
  AddInfo( ({ "woelfe","wolf" }),
    "Hier in der Naehe lauern Woelfe, die gerne meine Schafe fressen wollen, deswegen habe ich auch den Zaun errichtet.",
    "sagt: ");
  AddInfo( ({ "zaun" }),
    "Der Zaun schuetzt meine Schafe vor den Woelfen.",
    "sagt: ");
  AddInfo( ({ "gatter" }),
    "Das Gatter muss immer geschlossen sein, sonst laufen meine Schafe davon.",
    "sagt: ");
  AddInfo( ({ "troll","trolle" }),
    "Die Trolle sind mir unsympathisch, die stehlen meine Schafe und schlachten sie.",
    "sagt: ");
  AddInfo( ({ "braten","schafsbraten" }),
    "Ich mag meine Schafe lieber lebendig.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  SUID;
  CLONEME(BIRKE_WEAPON +"schafschere.lpc" );
  command("zuecke schere");  
  CLONEME(BIRKE_ARMOUR + "schaefer_hut.lpc");
  CLONEME(BIRKE_ARMOUR + "schaefer_umhang.lpc");
  command("trage alles");
  CLONEME(BIRKE_OBJ+ "leine.lpc");
  CLONEME(BIRKE_OBJ+ "hirtenstab.lpc");
  CLONEME(BIRKE_OBJ+ "wolle.lpc");
 
SetChats(3, ({
   "Der Schaefer schaut sich um.\n",
   "Der Schaefer kaut auf einem Grashalm.\n",
   "Der Schaefer nickt Dir zu.\n",
   "Der Schaefer seufzt zufrieden.\n",
   "Der Schaefer haelt nach Woelfen Ausschau.\n"}) );

  //AddCmd(({"schere","scher"}),"scheren");
   
}



