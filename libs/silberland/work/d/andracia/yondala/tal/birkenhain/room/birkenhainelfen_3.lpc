#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Birkenhain" );
  SetProp( P_INT_LONG,
    "Du stehst mitten auf einer bluehenden Wiese in einem herrlichen Birkenhain. Um Dich herum "
    "stehen vereinzelte Birken, in der Ferne kannst Du die Auslaeufer des Gebirges erkennen und "
    "im Osten beginnt ein dichter Buchenwald." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "birkenhain" }),
    "Du stehst mitten auf einer bluehenden Wiese in einem herrlichen Birkenhain. Um Dich herum "
    "stehen vereinzelte Birken, in der Ferne kannst Du die Auslaeufer des Gebirges erkennen und "
    "im Osten beginnt ein dichter Buchenwald."  );
  AddDetail( ({ "wiese" }),
    "Du stehst mitten auf einer bluehenden Wiese. Das Gras ist kniehoch und wilde Blumen stechen "
    "immerwieder bunt hervor. Ein paar Bienchen summen um Dich herum.");
  AddDetail( ({ "gras" }),
    "Das Gras ist hier durchschnittlich kniehoch und wird immer wieder von bunten Blumen unterbrochen");
  AddDetail( ({ "blumen" }),
    "Die bunten Blumen sind hier wild gewachsen und bilden zusammen mit dem gruenen Gras einen "
    "bunten Teppich.");
  AddDetail( ({ "teppich" }),
    "Die gruene Wiese sieht mit den wilden Blumen zusammen aus wie ein bunter Teppich.");
  AddDetail( ({ "birken", "birke" }),
    "Die Birken stehen vereinzelt auf der Wiese herum. Ihre Blaetter leuchten in einem "
    "froehlich hellem Gruen und die weisse Rinde vermag Dich fasst schon zu blenden.");
  AddDetail( ({ "rinde" }),
    "Die weisse Rinde der Birken strahlt schon beinahe im hellen Licht der Sonne.");
  AddDetail( ({ "licht", "kraft" }),
    "Die Sonne strahlt heute mit all ihrer warmen Kraft auf diesen Birkenhain.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht vom blauen Himmel herunter und waermt Dich.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmlisch blau und eine sonnige Sonne laechelt auf Dich herunter.");
  AddDetail( ({ "ferne" }),
    "Weit weg.");
  AddDetail( ({ "gebirge", "auslaeufer" }),
    "Das Gebirge umgibt dieses Tal vollstaendig.");
  AddDetail( ({ "tal" }),
    "Du befindest Dich in einem bewaldeten Tal.");
  AddDetail( ({ "boden" }),
    "Unter Dir ist ein schmaler Weg in die Wiese getrampelt, ansonsten siehst Du nur Gras und "
    "Blumen.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt nach Westen durch die Birken hindurch, im Osten wird er allerdings von einem dichten Wald verschluckt."
    "Ansonsten siehst Du ausser Birken und Gebirge eigentlich nichts. ");
  AddDetail( ({ "osten" }),
    "Im Osten beginnt uebergangslos ein dichter Buchenwald.");
  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Die gruenen Blaetter der Birken wetteifern mit dem Gras darum wer im Licht der Sonne am "
    "strahlendsten erscheint.");
  AddDetail( ({ "gruen" }),
    "Das Gruen der Birkenblaetter ist etwas heller als das der Wiese.");
  AddDetail( ({ "bienchen" }),
    "Die Bienchen summen froehlich um Dich herum.");
  AddDetail( ({ "buchenwald", "buchen", "wald" }),
    "Du kannst den Buchenwald nach Osten hin betreten.");

  AddDetail( ({ "westen" }),
    "Im Westen erstreckt sich ein lichter Birkenhain.");
  AddDetail( ({ "" }),
    "");





// AddExit( "osten", BIRKE_ROOM+"birkenhainelfen_4.lpc" ); 
 AddExit("westen", BIRKE_ROOM+"birkenhainelfen_2.lpc");
 AddExit("osten", BIRKE_ROOM+"buchenwald_8i.lpc");
 
 }


