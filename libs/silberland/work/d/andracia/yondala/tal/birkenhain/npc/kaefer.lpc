//Der Kaefer

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein Kaefer");
  SetProp(P_LONG,
    "Ein Kaefer der eine kleine Mistkugel vor sicher herrollt.");
  SetProp(P_NAME, "Kaefer"); //hier soll wirklich der Name hin, der da steht wenn der Kaefer was tut, zum Beispiel den Raum betritt o.ae.
  SetProp(P_GENDER, MALE);
//  SetProp(P_ARTICLE, 0); //Ist Standartmaessig 1 und sollte es auch sein, sonst steht da nur "Kaefer betritt den Raum" etc

  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp (P_MNPC_DEFAULTROOM,BIRKE_ROOM+"birkenhain_5.lpc");
  SetProp (P_MNPC_AREA, BIRKE_ROOM);
  SetProp (P_MNPC_WAIT, ({5, 10, 5}));


  AddId(({"kaefer", "insekt"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Scheren",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "insekt");  
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 8);
  SetProp(P_ALIGN, 0);

  SetProp(P_MMSGIN, "kommt aus einem schwarzen Loch");
  SetProp(P_MMSGOUT, "wird in ein schwarzes Loch gezogen");
// was =random(2);
 if (random(2)) 
 	{CLONEME(BIRKE_OBJ+ "mistkugel" );
 		  SetProp(P_MSGIN, "rollt eine Mistkugel herein"); 
  SetProp(P_MSGOUT, "rollt seine Mistkugel");}

 else 
 	{
 		CLONEME(BIRKE_OBJ+ "kaeferzange" );
	  SetProp(P_MSGIN, "krabbelt herein"); 
    SetProp(P_MSGOUT, "krabbelt");
  }

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Ein kleiner Kaefer"); // BIRKE_NPC-Name fuer den killer
  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  //wenn gefragt wird

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kaefer laesst es wieder fallen.\n" }) );

}