#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Wollhut");
  SetProp(P_LONG,
    "Du siehst einen schoen warmen Wollhut." );

  SetProp(P_NAME, "Wollhut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut", "wollhut", ""}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:-1 ]) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 150);
                                    

  SetProp(P_QUALITY_DECAY, 70);

}


