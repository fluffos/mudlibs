// 24.06.2022 Yondala @SilberLand: Leuchtet jetzt schon beim Entstehen, nicht loeschbar
inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

void sterben()
{
//	if(environment(TO)->QueryProp(P_RACE))
		tell_object(environment(this_object()), "Das Gluehwuermchen erlischt.\n");

	this_object()->remove();
}
create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("gluehwuermchen");
  SetProp(P_NAME,"Gluehwuermchen");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_SHORT,"Ein Gluehwuermchen");
  SetProp(P_LONG,
      "Ein kleines, leuchtendes Gluehwuermchen.");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,2);
  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,2000);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
  SetProp(P_LIGHTED, 1);
    AddCmd( ({"loesche", "loesch"}) , "loeschen" );
	call_out ("sterben",600);
}

int loeschen(string str)
{
	if(str=="wuermchen"||str=="gluehwuermchen")
	{
		write("Du kannst das Gluehwuermchen nicht loeschen, es leuchtet von Innen heraus.\n");
		return 1;
	}
}