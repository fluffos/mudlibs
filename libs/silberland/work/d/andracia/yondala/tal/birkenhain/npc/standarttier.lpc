//Das Standarttier. Tiere, die im Andracia von einem Clanmitglied des Naturvolks getoetet 
//werden sollen moeglichst immer eine entsprechende Leiche hinterlassen
//created by Yondala@Andracia, 11.11.2006

inherit "std/npc";


#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Tier");
  SetProp(P_LONG,
    "Du siehst Tier.");
  SetProp(P_NAME, "Tier");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tier", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 600);
  SetProp(P_ALIGN, 0); //Nur bei Tieren mit neutraler Gesinnung
  SetProp(P_MSGIN, "laeuft herbei");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
//  SetProp(P_MNPC_AREA, (BIRKE_ROOM) );
//  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
//  SetProp(P_MNPC_DEFAULTROOM, BIRKE_ROOM "");
//  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Ein Tier");

  AddInfo(DEFAULT_INFO, "spricht nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Tier kann Deine Sachen nicht tragen.\n" }) );
/*
  SetChats(3, ({
    ".\n",
    ".\n"}) );*/
}

void die(int death) 
{
	if( !QueryProp(P_KILLER) ) ::die(death);

	if( (QueryProp(P_GUILD, QueryProp(P_KILLER))) =="abenteurer")	//Gehoert der Killer zum Naturvolk?
		{   
  	write("Ja.\n");
  SetProp(P_NOCORPSE, 1 );	//Dann natuerlich keine Leiche mehr.
  CLONE("/d/tal/yondala/faunenwald/obj/braten.lpc",QueryProp(P_KILLER));	}
	else {

	  write("Nein.\n");
  }
  ::die(death);
}