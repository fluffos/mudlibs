#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Fuchsfell");
  SetProp(P_LONG,
    "Du siehst ein Fuchsfell. Es ist ziemlich struppig und riecht auch etwas streng, "
    "aber man kann es dennoch anziehen." );

  SetProp(P_NAME, "Fuchsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "fuchsfell", "\nfell_is_gerb_able"}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4 ]) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 100);
                                 

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}

farbe(string farbe)
{
  SetProp(P_SHORT, "Ein "+farbe+"es Fuchsfell");
  SetProp(P_LONG,
    "Du siehst ein "+farbe+"es Fuchsfell. Es ist ziemlich struppig und riecht auch etwas streng, "
    "aber man kann es dennoch anziehen." );

	}