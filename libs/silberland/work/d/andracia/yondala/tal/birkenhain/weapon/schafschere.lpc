#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Schafschere");
  SetProp(P_LONG,
    "Du siehst eine kleine Schere, die dazu dient Schafe von ihrer Wolle zu befreien." );
   SetProp(P_NAME, "Schafschere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schere", "schafschere"}) );

  SetProp(P_AUTOLOADOBJ, 1);                                     
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 40);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE,20);
  SetProp(P_VALUE, 200);
  SetProp(P_QUALITY_DECAY, 100);
  
}
