inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Marder");
  SetProp(P_LONG,
    "Du siehst einen wilden Marder, der Dich aus kleinen, schwarzen Augen listig anschaut.");
  SetProp(P_NAME, "Marder");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
//  CLONEME(BIRKE_OBJ "kaesestueckchen" );

SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/tal/birkenhain/room/buchenwald_5k.lpc");
SetProp (P_MNPC_AREA, ({"/d/andracia/yondala/tal/birkenhain/room",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));


  AddId(({"marder"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit spitzen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Waldtier");  
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 5000);

  SetProp(P_MSGIN, "schleicht herbei"); 
  SetProp(P_MSGOUT, "schleicht davon");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein wilder Marder"); 

  AddInfo(DEFAULT_INFO, "kann nicht sprechen.\n"); 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Marder kann @WEN nicht tragen.\n" }) );
    
}
