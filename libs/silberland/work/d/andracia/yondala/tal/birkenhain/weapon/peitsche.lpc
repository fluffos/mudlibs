// mal sehen. Die soll heftig schaden machen, aber nicht so gut in der Hand liegen
// Ausserdem koennen nur böse, grosse Spieler die zuecken
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine neunschwaenzige Peitsche");
  SetProp(P_LONG,
    "Du siehst eine neunschwaenzige Peitsche. Es gibt kaum ein grausameres Schlagwerkzeug "
    "als dieses. Diese Waffe erzeugt besonders schlimme Wunden. Sie wird oft von miesen "
    "Sklaventreibern benutzt." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "neunschwanz"}) );

  SetProp(P_AUTOLOADOBJ, 1);                                     
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40 );//wie geschickt man mit der Waffe ist (normal 30)
//  SetProp(P_DAM_TYPE, DT_ );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 3620);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 150);// haelt lang
  



}


