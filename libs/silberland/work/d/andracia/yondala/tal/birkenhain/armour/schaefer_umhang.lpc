#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Wollumhang");
  SetProp(P_LONG,
    "Du siehst einen schoen warmen Wollumhang." );

  SetProp(P_NAME, "Wollumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "schaeferumhang", "wollumhang"}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:-1 ]) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);

  SetProp(P_QUALITY_DECAY, 100);

}


