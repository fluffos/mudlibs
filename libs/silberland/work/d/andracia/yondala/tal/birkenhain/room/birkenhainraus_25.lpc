#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Sackgasse" );
  SetProp( P_INT_LONG,
    "Leider ist der Weg hier zu Ende. Ueber all um Dich herum ist nur Fels, lediglich im "
    "Nordosten ist Dir der Weg nicht versperrt." );

