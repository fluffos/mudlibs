  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Fels.");
  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du von hier aus kaum erkennen.");
  AddDetail( ({ "ende" }),
    "Der Weg endet scheinbar hier. Wer weiss, ob er irgendwann fortgesetzt wird?");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

