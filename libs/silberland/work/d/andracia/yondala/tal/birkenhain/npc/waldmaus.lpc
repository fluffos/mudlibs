inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Waldmaus");
  SetProp(P_LONG,
    "Eine kleine Waldmaus, die Dich mit kleinen Knopfaugen zutraulich anschaut.");
  SetProp(P_NAME, "Waldmaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"waldmaus", "maus", ""}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");
  SetProp(P_SIZE, 5);
  SetProp(P_WEIGHT, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "kommt angetrippelt");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (BIRKE_ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, BIRKE_ROOM +"/faunenwald_2b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Waldmaus");

  AddInfo(DEFAULT_INFO, "piepst.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Waldmaus ist viiiel zu klein um Deine Sachen zu tragen.\n" }) );

}