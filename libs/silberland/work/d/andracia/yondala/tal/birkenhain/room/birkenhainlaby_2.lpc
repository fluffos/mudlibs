//hierzweigt sich der Weg nach Nordosten zur Labyrinthquest und nach Suedosten richtung Trolle


#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_SHORT, "Vor einer Felswand" );
  SetProp( P_INT_LONG,
    "Du stehst direkt vor einer Felswand. Hier ist es gleich merklich kuehler als noch im "
    "sonnigen Birkenhain, welcher hinter Dir liegt. Vor Dir baut sich die riesige, glatte "
    "Felswand auf, die nur durch den Eingang in eine Hoehle unterbrochen wird." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "birkenhain" }),
    "Du hinter Dir liegt der Birkenhain, der sich zwischen Sueden und Westen ausbreitet. "
    "Dort stehen viele vereinzelte Birken die von der Sonne beschienen werden." );
  AddDetail( ({ "wiese","rand","rande" }),
    "Du stehst am Rande einer bluehenden Wiese. Das Gras ist kniehoch und wilde Blumen stechen "
    "immerwieder bunt hervor. Ein paar Bienchen summen um Dich herum.");
  AddDetail( ({ "gras" }),
    "Das Gras ist hier durchschnittlich kniehoch und wird immer wieder von bunten Blumen unterbrochen");
  AddDetail( ({ "blumen" }),
    "Die bunten Blumen sind hier wild gewachsen und bilden zusammen mit dem gruenen Gras einen "
    "bunten Teppich.");
  AddDetail( ({ "teppich" }),
    "Die gruene Wiese sieht mit den wilden Blumen zusammen aus wie ein bunter Teppich.");
  AddDetail( ({ "birken", "birke" }),
    "Die Birken stehen vereinzelt auf der Wiese herum. Ihre Blaetter leuchten in einem "
    "froehlich hellem Gruen und die weisse Rinde vermag Dich fasst schon zu blenden.");
  AddDetail( ({ "rinde" }),
    "Die weisse Rinde der Birken strahlt schon beinahe im hellen Licht der Sonne.");
  AddDetail( ({ "licht", "kraft" }),
    "Die Sonne strahlt heute mit all ihrer warmen Kraft auf diesen Birkenhain. Leider spuerst Du sie hier nicht, da Du im Schatten der Felswand stehst.");
  AddDetail( ({ "sonne" }),
    "Du kannst sie von hier aus leider nicht sehen.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmlisch blau und eine sonnige Sonne laechelt auf Dich herunter.");
  AddDetail( ({ "ferne" }),
    "Weit weg.");
  AddDetail( ({ "gebirge", "auslaeufer" }),
    "Das Gebirge umgibt dieses Tal vollstaendig. Du stehst sogar direkt vor einer Felswand.");
  AddDetail( ({ "tal" }),
    "Du befindest Dich am Rande eines bewaldeten Tals.");
  AddDetail( ({ "boden" }),
    "Der Boden geht hier von Wiese in Fels ueber.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt durch die Birken hindurch, und viel mehr als Birken und entferntes "
    "Gebirge siehst Du nicht.");
  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Die gruenen Blaetter der Birken wetteifern mit dem Gras darum wer im Licht der Sonne am "
    "strahlendsten erscheint.");
  AddDetail( ({ "gruen" }),
    "Das Gruen der Birkenblaetter ist etwas heller als das der Wiese.");
  AddDetail( ({ "bienchen" }),
    "Die Bienchen summen froehlich um Dich herum.");
  AddDetail( ({ "wald", "westen" }),
    "Im Sueden und in Westen bereitet sich vor Dir der herrliche Birkenhain aus.");

  AddDetail( ({ "osten" }),
    "Im Osten ragt eine hohe Felswand vor Dir auf.");

  AddDetail( ({ "felswand", "fels" }),
    "Die Felswand ist schier unendlich hoch. Du siehst den Eingan zu einer Hoehle.");

  AddDetail( ({ "hoehle", "eingang" }),
    "Viel kannst Du nicht erkennen, sie geht offensichtlich tief in den Fels, allerdings ist es darin stockdunkel.");

  AddDetail( ({ "richtungen" }),
    "Ausser nach Osten.");
  AddDetail( ({ "" }),
    "");


  AddSound( DEFAULT_SOUND,
    "Es ist hier angenehm ruhig. Nur selten ruf ein Kaeuzchen und ab und an hoerst Du ein Rascheln.");

  AddSound( ({ "kaeuzchen","knacken","rascheln" }),
    "Dies ist ein typisches Waldgeraeusch.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald.");

  AddSmell( ({ "wald" }),
    "Du riechts Moose, Baeume und faulige Blaetter.");
  AddSmell( ({ "moose","moos","baeume","baum","blaetter","blatt" }),
    "Du riechst nur typische Waldgerueche.");
  AddSmell( ({ "" }),
    "");

AddExit("westen", BIRKE_ROOM+"birkenhainlaby_1.lpc");
 AddGuardedExit( "hoehle",  BIRKE_ROOM+"birkenhainkreuz_2.lpc","rupert","Rupert sagt: Redet doch erstmal mit mir.\n" ); 

// AddExit("osten", ".lpc");
 
 }


