inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

int heilig;
void create() 
{
 if (!is_clone(TO)) return;
  ::create();

	AddId(({"buchecker","ecker"}));

	heilig=random(500);
	if (heilig==1)
		{  
		  SetProp(P_NAME_ADJ, "magisch");
			SetProp(P_SHORT, "Eine magische Buchecker");
  		SetProp(P_LONG,
    		"Du siehst eine kleine, braune Buchecker vor Dir. Sie ist schon leicht aufgesprungen, "
    		"sodass Du sie einfach essen kannst." );
			SetProp(P_NAME, "Buchecker");
  		SetProp(P_GENDER, FEMALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:-200, 
											 F_DRINK:-200,
											 F_HEAL:({400,400}), // erst HP, MP
											 F_MSG: "Du isst die magische Buchecker und fuehlst Dich sehr gut.", 
											 F_MSG_ROOM: "isst eine kleine Buchecker.",
											 F_POISON: -5,	
											 	]));
  SetProp(P_MATERIAL, ({MAT_FRUIT, MAT_MISC_MAGIC}));

}


else
	{
		SetProp(P_SHORT, "Eine Buchecker");
  	SetProp(P_LONG,
    	"Du siehst eine kleine, braune Buchecker vor Dir. Sie ist schon leicht aufgesprungen, "
    	"sodass Du sie einfach essen kannst." );
  	SetProp(P_NAME, "Buchecker");
  	SetProp(P_GENDER, FEMALE);
  	AddId(({"buchecker","ecker"}));
		SetProp(P_FOOD_INFO, ([F_SOAK:2, 
													 F_HEAL:({5,5}), // erst HP, MP
													 F_MSG: "Du isst die kleine Buchecker, sie schmeckt leicht nussig.", 
													 F_MSG_ROOM: "isst eine kleine Buchecker."]));

  SetProp(P_MATERIAL, MAT_FRUIT);
}
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 10);


 
}

