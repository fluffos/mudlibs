//ein Fuchs, der gerne mal Schafe frisst.

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void init()
{
   ::init();
   if(TP->id("schaf")) Kill(TP);
   
   if (present("leiche",environment(TO))) call_out("frissmich",1);
}

int i;
string farbe;
object fell;
string groesse;
void create() {
  if (!is_clone(TO)) return;
  ::create();

i=random(4);
if(i==0) farbe= "weiss";
if(i==1) farbe= "rot";
if(i==2) farbe= "schwarz";
if(i==3) farbe= "braun";
i=random(3);
if(i==0) groesse= ", junger";
if(i==1) groesse= ", alter";
if(i==2) groesse= "";

i=i*2;	
i+=12;	
  SetProp(P_SHORT, "Ein "+farbe+"er"+groesse+" Fuchs");
  SetProp(P_LONG,
    "Hier steht ein "+farbe+"er"+groesse+" Fuchs der auf der Suche nach Nahrung "
    "herum streunt.");
  SetProp(P_NAME, "Fuchs");
  SetProp(P_GENDER, MALE);
  AddId(({"fuchs", "", ""}));
//  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(i);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Fuchs");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 0);


  SetProp(P_MSGIN, "schleicht herbei");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MNPC_WAIT, ({ 5, 5, 5 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp (P_MNPC_DEFAULTROOM,BIRKE_ROOM+"birkenhain_3.lpc");
  SetProp (P_MNPC_AREA, BIRKE_ROOM);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Fuchs");

  AddInfo(DEFAULT_INFO, "knurrt.\n");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Fuchs kann Deine Sachen nicht tragen.\n" }) );


  SetChats(3, ({
    "Der Fuchs scharrt auf dem Boden.\n",
    "Der Fuchs schaut Dich hungrig an.\n",
    "Der Fuchs nimmt eine Faehrte auf.\n"}) );

  //SUID;
  CLONEME(BIRKE_ARMOUR+"fuchsfell.lpc" );
  fell=present("fuchsfell", TO);
  fell->farbe(farbe);
}
