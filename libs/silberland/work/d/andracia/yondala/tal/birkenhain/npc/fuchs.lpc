frissmich1()
{
	call_out("frissmich",1);
}
	
	frissmich()
{
	object leiche;
	leiche=present("leiche",environment(TO));
  tell_room(environment(TO), "Der Fuchs verspeisst die Leiche.\n");
	leiche->remove();
		}