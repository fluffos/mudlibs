#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Mistkugel");
  SetProp(P_LONG,
    "Du siehst eine kleine Mistkugel vor Dir die vermutlich mal ein Kaefer hergestellt hat." );
  SetProp(P_NAME, "Mistkugel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kugel","mistkugel"}));
SetProp( P_MATERIAL, MAT_EARTH );

  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 0);

}


	