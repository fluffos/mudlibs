#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein grosses, blutiges Schlachtermesser");
  SetProp(P_LONG,
    "Du siehst ein grosses, blutiges Messer. Aufgrund seiner Form eignet es sich "
    "wohl besonders gut dazu Schafe zu schlachten." );
   SetProp(P_NAME, "Schlachtermesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "schlachtermesser","schlachtmesser"}) );

  SetProp(P_AUTOLOADOBJ, 1);                                     
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE,60);
  SetProp(P_VALUE, 1200);
  SetProp(P_QUALITY_DECAY, 100);
  AddCmd( ({ "schlachte", "schlacht"}), "schlachten" ); //Schafe kann man schlachten, alles andere angreifen
  
}

int schlachten(string str)
{
	object opfer;
	if(QueryProp(P_WIELDED)==0)
		{
			write("Du kannst nur etwas schlachten, wenn Du auch das Schlachtermesser gezueckt hast.\n"+
			"Logisch, oder?\n");
			return 1;
		}
	notify_fail("Wen oder was moechtest Du schlachten?\n");
	if(!str) return 0;
	if(!opfer=present(str, environment(TP)))
		{
			write("So etwas siehst Du hier nicht.\n");
			return 1;
		}
	if(opfer->id("schaf"))
		{
			write("Du schlachtest das Schaf.\n");
			say(TPN+" schlachtet ein Schaf.\n");
			opfer->die();
			opfer=present("leiche", environment(TP));
			opfer->remove();
 			CLONE("/d/wasser/yondala/pirateninsel/obj/schafsbraten.lpc", environment(TP));
 			write("Du verwandelst die Leiche in einen leckeren Braten.\n");
 			say(TPN+" verwandelt die Leiche in einen leckeren Braten.\n");
 			return 1;
 		}
 	if(!opfer->QueryProp(P_RACE))
 		{
 			write("Das macht keinen Sinn, Du kannst nur Lebewesen schlachten.\n");
 			return 1;
 		}
 	if(opfer->QueryProp(P_NOATTACK))
 		{
 			write(opfer->name()+" weicht Dir aus.\n");
 			return 1;
 		}
 	if(interactive(opfer))
 		{
 			write("Andere Spieler werde nicht geschlachtet.\n");
 			return 1;
 		}
 	TP->Kill(opfer);
return 1;
}




