//gehoert zu der Quest Hilfe fuer die kranke Elfe

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <npc.h>

void init()
{
   ::init();
   call_out("tag", 1);
}

int folgend;
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wanderer");

  SetProp(P_LONG,
    "Der Wanderer ist ein offensichtlich sehr betagter Mensch, der dennoch in einer "
    "guten, koerperlichen Verfassung scheint. Er ist schlank und unter seiner Haut spannen "
    "sich trainierte Muskeln. Er traegt einen Wanderumhang unter dessen Kapuze seine "
    "langen , grauen Haare hervorschauen, feste Stiefel und eine Tasche. Beim Laufen "
    "stuetz er sich locker auf seinen Wanderstab.");
    
  SetProp(P_NAME, "Wanderer");
  SetProp(P_GENDER, MALE);
  AddId(({"wanderer", "mensch", "mann"}));
//  set_living_name("");

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem Stab",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);

  SetProp (P_MNPC_DEFAULTROOM,"/d/andracia/yondala/tal/room/buchenwald_8i.lpc");
  SetProp (P_MNPC_AREA, ({"/d/andracia/yondala" }));
  SetProp (P_MNPC_FLAGS, MOV_BACKWARDS + MOV_INDOORS+ MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES);
  SetProp (P_MNPC_WAIT, ({3, 5, 3}));

  CLONEME(BIRKE_WEAPON+"wanderstab" );
  CLONEME(BIRKE_OBJ+"wanderbuendel" );
  CLONEME(BIRKE_ARMOUR+"wanderer_hut" );
  CLONEME(BIRKE_ARMOUR+"wanderer_stiefel" );
  CLONEME(BIRKE_ARMOUR+"wanderer_umhang" );
  command("zuecke stab");
  command("trage alles");  

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Wanderer");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "gibt darauf keine Auskunft.\n");
  AddInfo("", ".","sagt: ");


  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wanderer will Deine Sachen nicht tragen.\n" }) );

/*  SetChats(3, ({
    ".\n"}) );
*/

}


void tag()
{
	if(environment(TO)==environment(TP))
		{
			command("sag Gruess Gott.");
		}
	
	}