#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Filzhut");
  SetProp(P_LONG,
    "Du siehst einen gruenen Filzhut mit einem kleinen grauen Puschel daran. Er scheint recht "
    "gut gegen Sonne, aber auch gegen Kaelte zu schuetzen." );

  SetProp(P_NAME, "Filzhut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut", "filzhut", ""}) );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:3 ]) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_FELT );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
                                  

  SetProp(P_QUALITY_DECAY, 70);

}


