#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hirtenstab");
  SetProp(P_LONG,
    "Du siehst einen alten, beschnitzen Stab der sicher mal einem Hirten gehoert hat." );
  SetProp(P_NAME, "Hirtenstab");
  SetProp(P_GENDER, MALE);
  AddId(({"stab", "hirtenstab"}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 100);

	}