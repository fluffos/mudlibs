//Dies ist ein Kommentar, den man setzen kann um anderen etwas zu erklären oder sich selbst
//später daran zu erinnern. Der Compiler liest den Kommentar nicht, ist also egal was drin steht

//hier werden die nötigen Klassen und Bibliotheken und so geladen. einfach immer so übernehmen
#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();
//Kurzbeschreibung:
  SetProp( P_INT_SHORT, "In einem Wald" );

//Langbeschreibung
  SetProp( P_INT_LONG,
    "Du stehst in einem Wald hier stehen einige wirklich imposante Bäume. "
    "Einige von ihnen haben einen Umfang den 2 Mann nicht umfassen könnten." );
  SetProp( P_LIGHT, 1 );//Koennen normale Spieler hier sehen? 1=ja, 0=nein -1=sehr dunkel, 2= sehr hell etc
  SetProp( P_INDOORS, 0 );//Ist der Raum drinnen oder draussen? 0=drinnen, 1=draussen
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) ); //Temperatur und Art der Umgebung, erstmal nicht ändern

//Details koennen wie folgt beschrieben werden:
  AddDetail( ({ "baeume" }),//immer klein!!!
    "Es gibt hier verschiedene Laub und Nadelbäume ein Baum sticht besonders heraus da er völlig verkohlt ist.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
 //so viele Details wie man mag koennen hier einfach angehaengt werden. 
 //Am besten kopieren, geht schneller ;o)   
    
    
//Ein lesbares Detail, wenn es zum Beispiel ein Schild gibt oder so. Auch beliebig viele
  AddReadDetail( ({ "" }),
    "");

//was kommt bei "lausche"?
//nur einmal natuerlich
  AddSound( DEFAULT_SOUND,
    "");
//beliebig viele Geräusche koennen hier eingefuegt werden, aehnlich den Details
  AddSound( ({ "" }),
    "");

//was kommt bei "rieche"?
  AddSmell( DEFAULT_SMELL,
    "");
//beliebig viele Gerueche koennen hier eingefuegt werden, aehnlich den Details

  AddSmell( ({ "" }),
    "");


//Ausgang, mehr oder weniger beliebig viele, machen wir später gemeinsam

//  AddExit( "norden", "nach Norden#" + "./room2" );


}
