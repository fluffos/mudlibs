#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Bergkluft" );
  SetProp( P_INT_LONG,
    "Rechts und links von Dir ragen hohe Berge auf, doch Du kannst "
    "problemlos auf einem Weg zwischen ihnen herlaufen. Es ist hier "
    "merklich kuehler als im Tal, denn die Berge legen den Weg in zwielichtigen Schatten."
    "Nach Norden hin endet die Kluft und gibt den Blick auf einen herrlichen Birkenhain frei." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  AddDetail( ({ "bergluft","kluft" }),
    "Du stehst in einer Kluft zwischen zwei Bergen.");
  AddDetail( ({ "kluft" }),
    "Du befindest Dich in einer Kluft, das ist ein schmaler Spalt zwischen den Bergen.");
  AddDetail( ({ "spalt", "platz" }),
    "Hier ist gerade genug Platz zum gehen.");
  AddDetail( ({ "berge" }),
    "Rechts und links von Dir ragen sie steil und zerklueftet nach oben.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt Dich nach Norden in einen Birkenhain und nach Sueden tiefer in die Kluft hinen.");
  AddDetail( ({ "norden" }),
    "Im Norden siehst Du einen lichten Birkenhain.");
  AddDetail( ({ "birkenhain" }),
    "Im Norden erkennst Du einen lichten Birkenhain.");
  AddDetail( ({ "sueden" }),
    "Im Sueden gelangst Du tiefer in die Kluft.");
  AddDetail( ({ "tal" }),
    "Das Tal ist noerdlich von Dir.");
  AddDetail( ({ "schatten" }),
    "Die Berge werfen einen kuehlenden Schatten auf Dich.");
  AddDetail( ({ "himmel" }),
    "Den kannst Du hier nicht sehen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht nur aus Fels.");
  AddDetail( ({ "fels" }),
    "Der Fels ist grau und kalt.");
  AddDetail( ({ "" }),
    "");




 AddExit( "sueden",  BIRKE_ROOM+"birkenhainraus_24.lpc" ); 
 AddExit("norden", BIRKE_ROOM+"birkenhainraus_22.lpc");
 
 }


