inherit "std/npc";
//inherit "/std/lightsource";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gluehwuermchen");
  SetProp(P_LONG,
    "Du siehst ein kleines Gluehwuermchen, welches sehr stark leuchtet.");
  SetProp(P_NAME, "Gluehwuermchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"gluehwuermchen", "", ""}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_LIGHT, 1);

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinen Beinchen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 2);
  SetProp(P_WEIGHT, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "surrt an");
  SetProp(P_MSGOUT, "surrt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Gluewuermchen");

  AddInfo(DEFAULT_INFO, "kann nicht sprechen.\n");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Gluewuermchen kann Deine Sachen nicht tragen.\n" }) );

}

void die( int poisondeath )
{
/*	object ob;
	ob=clone_object(OBJ+"gluehwuermchen.lpc");
	ob->move(environment(TO));*/
	CLONE(BIRKE_OBJ + "gluehwuermchen.lpc", environment(TO));
	::die(poisondeath);
}