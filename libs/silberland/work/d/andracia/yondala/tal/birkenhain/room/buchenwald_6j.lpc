#include "../def.h"
inherit BIRKE_ROOM + "buchenwald_std.lpc";
#include <properties.h>



void create() 
{
  ::create();

  AddDetail( ({ "buesche" }),
    "Einige verfilze Buesche saeumen den Weg. In einem siehst Du etwas braunes.");
  AddDetail( ({ "etwas","braunes" }),
    "Ob es ein Vogelnest ist?");
  AddDetail( ({ "vogelnest","nest" }),
    "Vorsichtig biegst Du die Zweige auseinander. Tatsaechlich, Du findest ein verlassenes Vogelnest.");



 AddExit( "nordosten", BIRKE_ROOM+"buchenwald_5k.lpc" ); 
 AddExit( "suedwesten", BIRKE_ROOM+"buchenwald_7i.lpc");
 
 }


kletternCmd(string str )
{
  notify_fail( "Wo willst Du hinklettern?\n" );
  if( str == "rauf"||str == "hinauf"||str == "herauf"||str == "nach oben"
  	||str == "auf baum"||str == "baum rauf"||str=="hoch" ||str=="an furchen hoch" 
  	||str=="an fruchen nach oben" ||str=="an furchen rauf" ||str=="leiter rauf")
  	  {
  	TP->move(ELFEN_ROOM + "aboriville_6j", M_GO,
  	"","klettert nach oben","klettert einen Baum hinauf");
		write("Du kletterst einen Baum hinauf und steigst ueber ein hoelzernes Gelaender.\n");
    say( TPN+" klettert einen Baum hinauf und verschwindet in der Krone.\n");
    return 1;

  }
  return 0;
}
	