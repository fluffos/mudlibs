inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Veilchen");
  SetProp( P_LONG, "Dieses schoene Veilchen laedt foermlich dazu ein, daran zu riechen." );
  
  SetProp( P_NAME, "Veilchen");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_MISC_HERBAL ); //MAT_<>
  SetProp( P_WEIGHT, 8); //in g
  SetProp( P_VALUE, 1); //Wert in Muenzen
  AddId( ({"veilchen", "blume" }) );

  SetProp(P_SMELL, BS("Diese Blume duftet herrlich.") );
}

