inherit "std/container";

#include "properties.h"
#include "container.h"
#include "../def.h"

void reset()
{
	object ob;
	::reset();
	if(!present("\nrubikwuerfel", TO))	
		{
			ob=clone_object(OBJ+"rubikwuerfel.lpc");
      ob->move(TO, M_NOCHECK);
	  }
}		

void create() 
{
	object ob;
	if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Schrank");
  SetProp( P_LONG, 
    BS("Ein Eichenschrank mit zwei Tueren und einem eisernen Schloss. Er "+
    "steht auf schön gedrechselten Kugelfuessen und hat eine breite Zierleiste "+
    "als oberen Abschluss. ") );
  SetProp( P_INFO, "Ein massiver Eichenschrank.");
  SetProp( P_NAME, "Schrank");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_WEIGHT, 160000); 
  SetProp( P_VALUE, 10000);
  SetProp( P_NOGET, 1); 
  AddId( ({"schrank", "eichenschrank"}) );

  ob=clone_object(OBJ+"rubikwuerfel.lpc");
  ob->move(TO, M_NOCHECK);

  /*Aktivierung Abschliessbarkeit*/
  add_openclose_commands();
}

void AfterOpen()
{
	object ob, next;
	write(BS("Ein versteckter Mechanismus wirft dir kleine Nadeln "+
	  "entgegen die sich in deine Haut bohren. Wo sie die Haut treffen faengt es an "+
	  "jucken und die einstiche fangen langsam an blau zu werden. "));
	say(BS("Aus dem Schrank schiessen kleine Nadel als "+TP->name()+ 
	  "den Schrank oeffnet und treffen jeden "+
	  "jeden innerhalb der Huette. Wo sie die Haut treffen faengt es an "+
	  "jucken und die einstiche fangen langsam an blau zu werden. "));
	TP->AddPoison(1);  
	for(ob=first_inventory(environment(TO));ob;) {
    next=next_inventory(ob);
    if( interactive(ob) == 1) {
      ob->reduce_hit_point(ob->QueryProp(P_LEVEL)*3+10);
      ob->AddPoison(2);
    }  
    ob=next;
  }
}

int BeforeClose()
{
	write(BS("Das Scharnier hat sich wohl verklemmt. "+
	  "Man kann den Schrank nicht mehr schliessen. "));
	say(BS(TP->name()+ "versucht vergeblich den Schrank zu schliessen. "));
	return 0;
}	
  