inherit "std/thing";

#include <properties.h>
#include "../def.h"

int zustand;
int geloest;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  zustand = 1; // 1 entspricht geloest
  geloest = 0; // 0 entspricht noch nicht gelöst worden
  // Properties
  SetProp( P_SHORT, "Ein komischer Wuerfel");
  SetProp( P_LONG, BS( "Ein komischer Wuerfel der an jeder Seite eine andere "+
  "Farbe hat. Auf jeder Flaeche sind ein paar gitterfoermige Vertiefungen. " ));
  SetProp( P_INFO, BS( "Es scheint so als koennte man den Vertiefungen die einzelnen "+
  "Wuerfelreihen zueinenader verdrehen. "));
  SetProp( P_NAME, "Wuerfel");
  SetProp( P_NAME_ADJ, "komisch");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100, MAT_MAGIC:40]) );
  SetProp( P_WEIGHT, 270);
  SetProp( P_VALUE, 1000);
  SetProp( P_NOSELL, 1);
 
  AddId( ({"wuerfel", "cube", "rubikwuerfel", "raetselwuerfel", "\nrubikwuerfel" }));

  /*Details*/
  AddDetail( ({"vertiefungen", "vertiefung", "gitter"}), BS(
  "Es scheint als wuerden diese Vertiefungen den Wuerfel in exakt 3x3x3 kleinere "+
  "Wuerfel aufteilen. Ein Wunder daß er nicht auseinaner faellt."));
  AddSpecialDetail( ({"seite", "seiten", "farbe", "farben", "flaeche", "flaechen"}), "unt_seite" );
  AddDetail( ({"reihen", "reihe", "scheibe", "scheiben"}), BS(
  "Der Wuerfel ist in exakt 3x3x3 kleinere Wuerfel aufgeteilt. Ein Wunder daß er nicht "+
  "auseinaner faellt. Jeweils eine Scheibe aus 9 Wuerfeln kann wohl zu den anderen "+
  "Scheiben verdreht werden. Welche der Scheiben man verdrehen und wie weit man verdrehen "+
  "will, ist voellug frei. Dies kann man wiederholen soviel man will. "));
  AddDetail( ({"gewicht"}),
  "Der Wuerfel ist leichter als ein vergleichsweise gleichgroßer Stein. \n");
  AddDetail( ({"wert"}),
  "Der Wuerfel ist bestimmt mehr Wert wenn man ihn geloest hat. \n");
  /*Aktivierung Interaktion*/
  AddCmd( ({"verdrehe", "verdreh"}), "verdreh_rubik");
  AddCmd( ({"zerlege", "zerstoere", "vernichte" }), "destrukt_rubik"); 
}

/*Deklaration SpecialDetail*/
string unt_seite(string key)
  {
  if( zustand != 1 )
    {
    return BS("Die Seiten zeigen unterschiedliche Farbkombinationen. Man kann bestimmt "+
    "durch geschicktes zurueckverdrehen auf jeder Seite wieder eine einheitliche "+
    "Farbe hinbekommen. ") ;
    }
  else
    {
    return BS("Die neun Teilflaechen jeder Seiten zeigen eine einheitliche Farbe und "+
    "jede Seite hat ihr eigene Farbe. So sieht das richtig aus. ");
    }
  }

/*Deklaration Interaktionen*/
int destrukt_rubik(string str)
{
	object ob;
  notify_fail("Such dir lieber einen Muellschlucker! \n");
  if( str != "wuerfel" && str != "cube" && str != "rubikwuerfel" && str != "raetselwuerfel") return 0;
  write("Du versuchst den Wuerfel in seine Bestandteile aufzuloesen! \n");
  if( TP->QueryAttribute(A_STR) < 5)
    { 
      write(BS("Du strengst dich zwar an, aber egal was Du versuchst, Du bekommst das Ding nicht kaputt. ")); 
      say(capitalize(TP->name())+ " fummelt an einem komplizierten Wuerfel herum. \n"); 
      return 1;
    } 
  write(BS("Mit einem knirschenden Geraeusche zerfaellt der Wuerfel in 27 einzelne Wuerfel. "+
  "Die einzelnen Wuerfel verlieren ihre Farbe und werden alle weiss und "+
  "bekommen dafuer schwarze Augen wie man Sie von einem normalen Wuerfel kennt. ")); 
  say(BS(capitalize(TP->name())+ " hat mit einem knirschenden Geraeusch "+
  "einem grossen Wuerfel in viele kleine Wuerfel auseinandergenommen. ")); 
  ob = clone_object("/d/huegelland/yason/zwirbelstein/obj/wuerfel.lpc");
  ob->SetProp(P_AMOUNT, 27);
  if( ob->move(TP,M_GET) != 1) ob->move(environment(TP));
  TO->remove(1);
  return 1;
}

int verdreh_rubik(string str) 
{
  notify_fail("Was willst Du verdrehen? \n");
  if( str != "wuerfel" && str != "cube" && str != "rubikwuerfel" && str != "raetselwuerfel") return 0;
  if( zustand == 0 ) // kein erneutes Verdrehen ...
    {
      write(BS("Du verdrehst den Wuerfel erneut! Aber deine Anstrengungen erzeugen auf "+
      "den Seiten des Wuerfels immer neue unterschiedliche Farbkombinationen. "+
      "Auf diese Weise wirst Du das Raetsel um den Wuerfel nicht loesen. "));
      say(capitalize(TP->name())+ " dreht an einem komplizierten Wuerfel herum. \n");
      return 1;
    }
    else
    {
      write(BS("Du verdrehst den Wuerfel! Jetzt sind auf allen Seiten unterschiedliche "+
      "Farben und Du hast keine Ahnung wie man die Farben wieder einheitlich bekommt. "));
      say(capitalize(TP->name())+ " dreht an einem komplizierten Wuerfel herum. \n");
      /* Objektumbau wegen neuer Situation */
      zustand = 0;
      SetProp( P_SHORT, "Ein verdrehter Raetselwuerfel"); 
      SetProp( P_LONG,  "Ein verdrehter Raetselwuerfel der an jeder Seite unterschiedlichste \n"
      "Farbe hat. Auf jeder Flaeche sind ein paar gitterfoermige Vertiefungen." ); 
      SetProp( P_INFO, BS("Jemand hat die farbigen Wuerfelseiten so verdreht daß an keiner Seite "+
      "eine einheitliche Farbe zu sehen ist. Durch geschicktes zurueckverdrehen ist es "+
      "bestimmt moeglich auf jeder Seite wieder eine einheitliche Farbe hinzubekommen. ")); 
      SetProp( P_NAME_ADJ, "verdreht");
      AddCmd( ({"entverdrehe", "zurueckverdrehe", "entverdreh", "zurueckverdreh"}), "reverdreh_rubik"); //Aktivierung Zurueckdrehen
      SetProp( P_VALUE, 500);
      return 1;
    }
}

int reverdreh_rubik(string str)
{
  notify_fail("Du willst bestimmt den Wuerfel zurueckverdrehen, oder? \n"); 
  if( str != "wuerfel" && str != "cube" && str != "rubikwuerfel" && str != "raetselwuerfel") return 0;
  if( zustand != 0 )
    {
      write("Aber dein Wuerfel ist doch aber garnicht verdreht! \n");
      say(capitalize(TP->name())+ " betrachtet eingehend einen komischen Wuerfel. \n");
      return 1;
    } 
  if( TP->QueryAttribute(A_INT) < 5)
  {
    write(BS("Du verdrehst den Wuerfel! Jetzt sind auf allen Seiten immernoch unterschiedliche "+
    "Farben und Du hast keine Ahnung wie man die Farben wieder einheitlich bekommt. "+
    "Vielleicht solltest Du mal ein bischen Kopfarbeit ueben um mit solchen Problemen fertig zu werden. ")); 
    say(capitalize(TP->name())+ " dreht erfolglos an einem komplizierten Wuerfel herum. \n"); 
    return 1;
  } 
  write("Du verdrehst den Wuerfel zurueck! \n" 
  "Jetzt sind auf allen Seiten wieder einheitliche Farben. \n"); 
  say(capitalize(TP->name())+ " dreht an einem komplizierten Wuerfel mit Hingabe herum. \n"); 
  /* Objektumbau wegen neuer Situation */
  if( geloest == 0 )
  {
    SetProp( P_NAME, "Raetselwuerfel");
    geloest = 1;
  }
  SetProp( P_SHORT, "Ein geloester Raetselwuerfel \n"); 
  SetProp( P_LONG, BS("Ein geloester Raetselwuerfel der an jeder Seite eine einheitliche "+
  "Farbe hat. Auf jeder Flaeche sind ein paar gitterfoermige Vertiefungen. ")); 
  SetProp( P_INFO, BS("Es scheint so als koennte man den Vertiefungen die einzelnen "+
  "Wuerfelreihen zueinenader verdrehen. ")); 
  SetProp( P_NAME_ADJ, "geloest");
  RemoveCmd( ({"entverdrehe", "zurueckverdrehe", "entverdreh", "zurueckverdreh"}), "reverdreh_rubik"); //Deaktivierung Zurueckdrehen
  SetProp( P_VALUE, 1000);
  zustand = 1;
  return 1;
}