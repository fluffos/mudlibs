inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Eine Mohnblume");
  SetProp( P_LONG, "Diese schoene Mohnblume laedt foermlich dazu ein, daran zu riechen." );
  
  SetProp( P_NAME, "Mohnblume");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_MISC_HERBAL ); //MAT_<>
  SetProp( P_WEIGHT, 8); //in g
  SetProp( P_VALUE, 1); //Wert in Muenzen
  AddId( ({"mohn", "blume", "mohnblume"}) );

  SetProp(P_SMELL, BS("Diese Blume duftet herrlich.") );
}

