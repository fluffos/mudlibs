inherit "/std/thing.lpc";

#include <properties.h>
#include "../def.h"
#include <attributes.h>


int trigger;

void ausschluepfen();


void heart_beat()
{
  trigger--;
  if(trigger == 0)
    {
    set_heart_beat(0);
    ausschluepfen();
    }
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Termitenei");
  SetProp( P_LONG, 
    BS("Ein Ei einer Termite."));
  SetProp( P_INFO, "Bald wird daraus eine Termite schluepfen");
  SetProp( P_NAME, "Termitenei");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_MISC_LIVING );
  SetProp( P_WEIGHT, 40000); 
  SetProp( P_VALUE, 20); 
  AddId(({ "ei", "termitenei" }));
  AddCmd( "mache", "mache_ei_kaputt" );
  
  trigger = random(20)+10;
}

int mache_ei_kaputt(string str)
{
  if(str != "ei kaputt") {
    notify_fail("Was willst Du machen? \n");
    return 0;
    }
  if(environment(TO) != environment(TP)) {
    notify_fail("Dazu muss das Ei aber auf dem Boden liegen. \n");
    return 0;
    }
  if(TP->QueryAttribute(A_STR)<5) {
    notify_fail("Du bist zu schwach fuer sowas. \n");
    return 0;
    }
  write(BS("Du durchstösst die Eierschale und das halbfertige Lebewesen kullert auf den Boden."));
  say(BS(TPN+" macht ein Ei kaputt."));
  destruct(TO);
  return 1;
}

void ausschluepfen()
{
  object neues_wesen;	
  SUID;
  neues_wesen=clone_object(NPC+"termite_baby.lpc");
  neues_wesen->move(environment(TO), M_TPORT );
  // say(BS("Ein Termitenbaby schluepft aus einem Ei. "));
  destruct(TO);
  return;
}

