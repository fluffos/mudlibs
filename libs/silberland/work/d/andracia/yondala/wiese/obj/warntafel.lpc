#include "../def.h"
#include <ansi.h>
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Warntafel");
  SetProp(P_LONG,
    "Eine grosse, hoelzerne Warntafel mit rotem Schriftzug. Du kannst es bestimmt lesen. " );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Warntafel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tafel", "warntafel", "hinweistafel"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );

  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.");
  AddDetail( ({"tafel", "hinweistafel", "warntafel" }),
    BS("Ein Hinweistafel mit einem roten Schriftzug. Versuch es doch mal mit lesen. "));
  AddDetail( ({ "schriftzug" }),
    BS("Der Schriftzug ist rot und soll auf etwas wichtiges hinweisen. Lesen mach hier Sinn."));
  AddDetail( ({ "sinn" }),
    BS("Es macht Sinn eine Warntafel zu lesen."));
  AddReadDetail( ({"tafel", "hinweistafel", "warntafel" }),
    " +------------------------------+ \n"+
    " +   "+ANSI_RED+"GEFAHR! ACHTUNG! GEFAHR!"+ANSI_NORMAL+"   + \n"+
    " +                              + \n"+
    " +      Termitenverseuchtes     + \n"+
    " +   Gebiet. Betreten nur auf   + \n"+
    " +     eigene Verantwortung.    + \n"+
    " +                              + \n"+
    " + gz. Edorian von Zwirbelstein + \n"+
    " +------------------------------+ \n"+
    "                ##                \n"+
    "                ##                \n"+
    "                ##                \n"+
    "                ##                \n");
}
