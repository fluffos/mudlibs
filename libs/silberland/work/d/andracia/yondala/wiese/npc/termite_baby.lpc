inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init() {
  ::init();
  if(TP && TP->id("termite")) AddDefender(TP);
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  
  create_default_npc(4); 
 
  AddId(({"baby", "termite", "babytermite", "riesentermite" }));
  SetProp( P_SHORT, "Eine frisch geschluepfte Riesentermite");
  SetProp( P_LONG, 
    BS("Diese junge Termite scheint frisch geschluepft. Sie hat sechs braune, haarige Beine, "+
    "eine deutliche Teilung des hellen Koerpers in Kopf, Brust und Hinterleib sowie grosse Facettenaugen "+
    "und scharfe Mandibeln mit denen sie boese zukneifen kann. "));
  SetProp( P_NAME, "Babytermite");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_BODY, QueryProp(P_BODY)+10);
  SetProp( P_XP, QueryProp(P_XP)+(10*100)); 
  SetProp( P_HANDS, ({" mit ihren Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));
  SetProp( P_RACE, "Termite");
  SetProp( P_SIZE, 60); 
  SetProp( P_WEIGHT, 35000); 
  SetProp( P_ALIGN, 0); 
  SetProp( P_MAX_HANDS, 2); 
  SetProp( P_HEAL, -1); 
  SetProp( P_AGGRESSIVE, ([0:0.4])); 
  SetProp( P_WIMPY, 0); 
  SetProp( P_NOMAGIC, 0); 
  SetProp( P_RESISTANCE_STRENGTHS ,  
    ([DT_COLD:       0.5, DT_WATER:  -0.5,  DT_SOUND:    -1.0, 
      DT_ACID:      -0.5, DT_TERROR: -1.0,  DT_HOLY:      1.0, 
      DT_UNHOLY:     1.0, DT_MIND:   -1.0,  DT_BLUDGEON:  0.5]) );
  SetProp( P_MSGIN, "krabbelt heran");
  SetProp( P_MSGOUT, "krabbelt weg");
  SetProp( P_MMSGIN, "schluepft aus einem Ei.");
  SetProp( P_MMSGOUT, "verbuddelt sich im Boden");
  SetProp( P_MNPC_AREA, (ROOM) ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 })); //Bewegungsintervalle
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "termitenbau_d2.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot auf den Ruecken und legt die Beinchen an. \n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Babytermite"); //string fuer Todessequenz
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Deine Sachen rutschen dem Chitinpanzer entlang auf den Boden. \n" }) );
}

void InformDefend(object enemy)
{
  Kill(enemy);
}