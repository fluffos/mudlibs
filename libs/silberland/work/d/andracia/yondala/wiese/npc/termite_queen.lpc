//20.7.2018
//YondalaSL: braucht noch das Chtinplaettchen aus Yasons Gebirge
//22.8.2018 Chitinplaettchen anwesend

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

int anz_eier;

void init() {
  ::init();
  if(TP && TP->id("termite")) AddDefender(TP);
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  
  create_default_npc(8); 
 
  AddId(({"koenigin", "termite", "riesentermite", "termitenkoenigin", "riesentermitenkoenigin"}));
  SetProp( P_SHORT, "Riesentermitenkoenigin");
  SetProp( P_LONG, 
    BS("Diese riesige Termite sorgt immer fuer kraeftig Nachschub an Eiern. Sie kann sich"+
    "kaum bewegen und hat nur sehr kleine Mandibeln. Von einem Chitinpanzer ist nur "+
    "noch wenig zu erkennen. Der riesige Hinterleib zieht sich rythmisch zusammen "+
    "und diese Bewegung durchfaehrt von vorne nach hinten immerwieder den ganzen "+
    "Koerper. "));
  SetProp( P_NAME, "Termitenkoenigin");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_BODY, QueryProp(P_BODY)+230);
  SetProp( P_XP, QueryProp(P_XP)+(30*100)); 
  SetProp( P_HANDS, ({" mit ihren Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));
  SetProp( P_RACE, "Termite");
  SetProp( P_SIZE, 90); 
  SetProp( P_WEIGHT, 158000); 
  SetProp( P_ALIGN, 0); 
  SetProp( P_MAX_HANDS, 2); 
  SetProp( P_HEAL, -1); 
  SetProp( P_AGGRESSIVE, ([0:0.0])); 
  SetProp( P_WIMPY, 0); 
  SetProp( P_NOMAGIC, 0); 
  SetProp( P_RESISTANCE_STRENGTHS ,  
    ([DT_COLD:       0.5, DT_WATER:  -0.5,  DT_SOUND:    -1.0, 
      DT_ACID:      -0.5, DT_TERROR: -1.0,  DT_HOLY:      1.0, 
      DT_UNHOLY:     1.0, DT_MIND:   -1.0,  DT_BLUDGEON:  0.5]) );
  SetProp( P_MSGIN, "krabbelt heran");
  SetProp( P_MSGOUT, "krabbelt weg");
  SetProp( P_MMSGIN, "purzelt herein");
  SetProp( P_MMSGOUT, "verbuddelt sich im Boden");
  SetProp( P_DIE_MSG,  "zuckt noch ein letztes mal und stirbt. \n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Termitenkoenigin"); 
  SetProp( P_REJECT, ({ REJECT_DROP, "Deine Sachen rutschen dem Koerper entlang auf den Boden. \n" }) );
  SetProp( P_CORPSE_FLAGS, COR_NOINVTRANSFER);
  
  SUID;
  for(anz_eier = random(4) + 4; anz_eier > 0; anz_eier-- ) CLONEME(OBJ + "termitenei.lpc");
     CLONEME("/d/andracia/yondala/gebirge/troglodyten/obj/chitinplatte_gelb.lpc");  
  
}

void Attack(object enemy) // Kann NIE angreifen
{
}

void InformDefend(object enemy)
{
  int new_egg, drop_egg;
  
  SUID; 
  new_egg = random(12);
  if( new_egg == 0 ) CLONEME(OBJ + "termitenei.lpc");
  
  drop_egg = random(12);
  if( drop_egg == 0 ) 
  {
    if(first_inventory(TO) && first_inventory(TO)->id("termitenei"))
    {
      set_object_heart_beat(first_inventory(TO), 1);
      first_inventory(TO)->move(environment(TO), M_PUT);
      say(BS("Die Termitenkoenigin legt ein Ei! Schnell mach es lieber kaputt bevor es schluepft. "));
    }
  }
}

void die(int poisondeath) {
  object ob, next;
  for(ob=first_inventory(TO);ob;) {
    next=next_inventory(ob);
    if( ob && ob->id("termitenei") )
    { 
    	set_object_heart_beat(ob, 1);
    	ob->move(environment(TO), M_PUT);
    }
    ob=next;
  }
  ::die(poisondeath);
}
