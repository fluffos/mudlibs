#include "../def.h"

inherit ROOM + "trockene_wiesen_weg_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein kleiner Trampelpfad fuehrt nach Suedosten vom Weg weg. \n" );
 
  AddDetail( ({"trampelpfad", "pfad" }),
    BS("Ein kleiner Trampelpfad fuehrt hier vom Weg weg."));
   
  AddExit( "westen" , ROOM + "trockene_wiesen_weg_c8.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_weg_e7.lpc" );
  AddExit( "suedosten" , ROOM + "trockene_wiesen_e9.lpc" );
}
