#include "../def.h"

inherit ROOM + "termitenbau_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Dieser unheimliche Gang steigt nach Westen hin leicht an. \n" );
    
  AddExit( "westoben" , ROOM + "termitenbau_entrance_c4.lpc");
  AddExit( "osten" , ROOM + "termitenbau_b2.lpc");
}
