#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Querfeldein durch trockene Wiesen" );
  SetProp( P_INT_LONG,
     BS("Du bist abseits des Weges auf den trockenen Wiesen des nordwestlichen "+
     "Huegellands. Ein gefaehrlicher Bereich da die agressiven Riesentermiten in diesem "+
     "Bereich des Landes ihre Heimat haben und ihr Territorium vehement "+
     "verteidigen. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "boden" }),
    BS("Der steinige Boden und das spaerliche, trockene Gras das hier waechst "+
    "lassen erahnen wie wenig Wasser es hier zur Zeit gibt. " ));
  AddDetail( ({ "himmel" }),
    BS("Keine Wolke zu sehen. En wenig Regen wuerde dem Land hier guttun. "));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen. "));

  AddDetail( ({ "wiese", "wiesen" }),
    BS("Das trockene Gras laesst darauf schliessen dass hier ehemals ueppig gruene"+
    "Wiesen vor nicht allzu langer Zeit vorherrschten. "));
  AddDetail( ({ "huegelland", "land", "bereich", "huegellands", "landes", "laendereien" }),
    BS("Dies ist der nordoestliche Teil des Huegellands, Riesentermiten beherrschen "+
    "diesen Bereich und sind fuer die Bewohner der umliegenden Laendereien eine "+
    "staendige Gefahr. "));
  AddDetail( ({ "riesentermiten", "riesentermite", "termiten", "termite", "kriegertermite", "kriegertermiten" }),
    BS("Sei vorsichtig! Diese grossen Kreaturen sind boese und tueckisch. Man kann "+
    "kann nicht mit ihnen reden oder sonst wie sich verstaendigen, sie betrachten "+
    "scheinbar alles was sich bewegt als potentielle Nahrungsquelle. "));
  AddDetail( ({ "heimat", "territorium", "reich", "gebiete", "gebiet", "gegend" }),
    BS("Dieser Bereich des Huegellands ist die Heimat der Riesentermiten. Ein "+
    "gefaehrliches Land und mit Kriegertermiten ist nicht zu spassen."));
  AddDetail( ({ "gras" }),
    BS("Das trockene Gras raschelt unter Deinen Fuessen. Es hat scheinbar schon lange "+
    "nicht mehr geregnet. "));
  AddDetail( ({ "wasser", "mangel" }),
    BS("An Wasser scheint hier ein Mangel zu herrschen. "));
  AddDetail( ({ "wolke", "regen", "wetter" }),
    BS("Keine Wolke in Sicht. Regen wuerde dem Land sehr gut tun."));
  AddDetail( ({ "querfeldein" }),
    BS("Abseits des Wegs eben. "));
  AddDetail( ({ "zeit" }),
    BS("Wenn Du lange genug wartest, wirst Du bestimmt von Termiten gefunden. "));
  AddDetail( ({ "kreaturen" }),
    BS("Hier wirst Du nur Riesentermiten finden. Pass auf dass sie Dich nicht erwischen. "));
  AddDetail( ({ "nahrungsquelle" }),
    BS("Wenn Du weiterhin so doofe Fragen stellst kommt noch eine Termite und will "+
    "Dich fressen. "));
  AddDetail( ({ "bewohner" }),
    BS("Die Bewohner dieser Wiesen sind wohl Riesentermiten."));
  AddDetail( ({ "gefahr", "kreaturen" }),
    BS("Riesentermiten sind gefaehrlich."));
  AddDetail( ({ "ferne", "sicht", "berge", "burg", "zwirbelstein" }),
    BS("In der Ferne im Osten kann man die Berge sehen. Im Nordosten steht der maechtige Marmorturm und "+
    "im Suedwesten kann man noch die Burg Zwirbelstein erkennen."));
  AddDetail( ({ "marmorturm", "turm" }),
    BS("Im Nordosten steht der Marmorturm. Ein beeindruckender Turm den man schon aus "+
    "weiter Ferne gut sehen kann. Der Zaubererzirkel hat dort seinen Sitz. "));
  AddDetail( ({ "zauberer", "sitz", "zaubererzirkel" }),
    BS("Der Zaubererzirkel hat seinen Sitz oben im Marmorturm. Im Nordosten kann man "+
    "ihn erkennen. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
}
