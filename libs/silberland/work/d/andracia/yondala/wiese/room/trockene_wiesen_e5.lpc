#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Hier ist es etwas gruener als sonst.") );
 
  AddDetail( ({ "wiese", "wiesen" }), BS(
    "Das Gras hier waechst ueppig und etwas saftiger als sonst in dieser Gegend. "+
    "Scheinbar finden hier die Pflanzen noch etwas Wasser im Boden. "));
  AddDetail( ({ "gras", "pflanzen" }),
    BS("Das Gras hier hat einen saftigen Gruenton."));
  AddDetail( ({ "gruenton", "gruen" }),
    BS("Hier ist es etwas gruener als sonst."));
   
  AddExit( "osten" , ROOM + "trockene_wiesen_weg_f5.lpc");
  AddExit( "nordwesten" , ROOM + "trockene_wiesen_d4.lpc" );
  
  AddItem( NPC + "termite_krieger.lpc", REFRESH_DESTRUCT );
}
