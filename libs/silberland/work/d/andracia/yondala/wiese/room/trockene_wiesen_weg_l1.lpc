#include "../def.h"
#include <ansi.h>

inherit ROOM + "trockene_wiesen_weg_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    "Im Norden kann man eine Kreuzung erkennen. \n"+
    "Eine grosse Hinweistafel wurde hier aufgestellt. \nDER WEG ZUM TURM IM NORDEN IST DERZEIT GESPERRT. Yondala." );
 
  AddDetail( ({"tafel", "hinweistafel" }),
    BS("Ein Hinweistafel mit einem roten Schriftzug. Versuch es doch mal mit lesen. "));
  AddDetail( ({ "schriftzug" }),
    BS("Der Schriftzug ist rot und soll auf etwas wichtiges hinweisen. Lesen mach hier Sinn."));
  AddDetail( ({ "sinn" }),
    BS("Es macht Sinn eine Hinweistafel zu lesen."));
  
  AddReadDetail( ({"tafel", "hinweistafel" }),
    " +------------------------------+ \n"+
    " +   "+ANSI_RED+"GEFAHR! ACHTUNG! GEFAHR!"+ANSI_NORMAL+"   + \n"+
    " +                              + \n"+
    " +      Termitenverseuchtes     + \n"+
    " +   Gebiet. Betreten nur auf   + \n"+
    " +     eigene Verantwortung.    + \n"+
    " +                              + \n"+
    " + gz. Edorian von Zwirbelstein + \n"+
    " +------------------------------+ \n"+
    "                ##                \n"+
    "                ##                \n"+
    "                ##                \n"+
    "                ##                \n");
   
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_weg_k2.lpc");
 // AddExit( "norden" , KREUZUNG_05 );
}
