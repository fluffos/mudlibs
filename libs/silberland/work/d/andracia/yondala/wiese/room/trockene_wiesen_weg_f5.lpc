#include "../def.h"

inherit ROOM + "trockene_wiesen_weg_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein kleiner Trampelpfad fuehrt nach Westen vom Weg weg. \n" );
 
  AddDetail( ({"trampelpfad", "pfad" }),
    BS("Ein kleiner Trampelpfad fuehrt hier vom Weg weg."));
   
  AddExit( "sueden" , ROOM + "trockene_wiesen_weg_f6.lpc");
  AddExit( "westen" , ROOM + "trockene_wiesen_e5.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_weg_g4.lpc" );
}
