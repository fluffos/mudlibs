#include "../def.h"

inherit ROOM + "trockene_wiesen_weg_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein kleiner Trampelpfad fuehrt nach Sueden vom Weg weg. \n" );
 
  AddDetail( ({"trampelpfad", "pfad" }),
    BS("Ein kleiner Trampelpfad fuehrt hier vom Weg weg."));
  
  AddExit( "westen" , ROOM + "trockene_wiesen_weg_i3.lpc");
  AddExit( "sueden" , ROOM + "trockene_wiesen_j4.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_weg_k2.lpc" );
}
