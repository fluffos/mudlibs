#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Weg durch trockene Wiesen" );
  SetProp( P_INT_LONG,
     BS("Das ist der schmale Weg durch die trockenen Wiesen des nordwestlichen "+
     "Huegellands. Ein gefaehrlicher Weg da die agressiven Riesentermiten in diesem "+
     "Bereich des Landes ihr Unwesen treiben und hin und wieder unvorsichtige "+
     "Wanderer anfallen. Im Nordosten steht weithin sichtbar der Marmorturm, die "+
     "Heimat der Zauberer. Im Suedwesten ist Zwirbelstein gelegen.  " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen. "));

  AddDetail( ({ "boden", "weg", "wegs" }),
    BS("Der steinige Boden und das spaerliche, trockene Gras das am Wegesrand waechst "+
    "lassen erahnen wie wenig Wasser es hier gibt. " ));
  AddDetail( ({ "himmel" }),
    BS("Keine Wolke zu sehen. En wenig Regen wuerde dem Land hier guttun. "));
  AddDetail( ({ "wiese", "wiesen" }),
    BS("Rechts und links des Wegs beginnen die Wiesen des Huegellands. Die anhaltende "+
    "Trockenheit hat alles Gras welken lassen und die ehemals gruenen Huegel in eine "+
    "dreckige braune Flaeche verwandelt. "));
  AddDetail( ({ "huegelland", "land", "bereich", "huegellands" }),
    BS("Dies ist der nordoestliche Teil des Huegellands, Riesentermiten beherrschen "+
    "diesen Bereich und sind fuer die Bewohner der umliegenden Laendereien eine "+
    "staendige Gefahr. "));
  AddDetail( ({ "riesentermiten", "riesentermite", "termiten", "termite" }),
    BS("Sei vorsichtig! Diese grossen Kreaturen sind boese und tueckisch. Man kann "+
    "kann nicht mit ihnen reden oder sonst wie sich verstaendigen, sie betrachten "+
    "scheinbar alles was sich bewegt als potentielle Nahrungsquelle. "));
  AddDetail( ({ "wanderer" }),
    BS("Versuch Dich doch lieber mit jemandem zu unterhalten statt zu untersuchen. "));
  AddDetail( ({ "marmorturm", "turm" }),
    BS("Im Nordosten steht der Marmorturm. Ein beeindruckender Turm den man schon aus "+
    "weiter Ferne gut sehen kann. Der Zaubererzirkel hat dort seinen Sitz. "));
  AddDetail( ({ "zwirbelstein", "zentrum", "burg" }),
    BS("In Suedwesten liegt Zwirbelstein im Zentrum des Huegellands. "));
  AddDetail( ({ "heimat", "unwesen" }),
    BS("Dies hier ist die Heimat der Riesentermiten. Sei vorsichtig in dieser Gegend. "));
  AddDetail( ({ "zauberer", "sitz", "zaubererzirkel" }),
    BS("Der Zaubererzirkel hat seinen Sitz oben im Marmorturm. Im Nordosten kann man "+
    "ihn erkennen. "));
  AddDetail( ({ "gras", "wegesrand", "rand"}),
    BS("Das trockene Gras raschelt unter Deinen Fuessen. Es hat scheinbar schon lange "+
    "nicht mehr geregnet. "));
  AddDetail( ({ "wasser", "mangel", "trockenheit" }),
    BS("An Wasser scheint hier ein Mangel zu herrschen. "));
  AddDetail( ({ "wolke", "regen" }),
    BS("Keine Wolke in Sicht. Regen wuerde dem Land sehr gut tun. "));
  AddDetail( ({ "nahrungsquelle" }),
    BS("Wenn Du weiterhin so doofe Fragen stellst kommt noch eine Termite und will "+
    "Dich fressen. "));
  AddDetail( ({ "bewohner" }),
    BS("Die Bewohner dieser Wiesen sind wohl Riesentermiten."));
  AddDetail( ({ "ferne", "sicht" }),
    BS("In der Ferne im Osten kann man die Berge sehen. Im Nordosten steht der maechtige Marmorturm und "+
    "im Suedwesten kann man noch die Burg Zwirbelstein erkennen."));
  AddDetail( ({ "flaeche" }),
    BS("Diese Wiesen bilden eine grosse, leicht gewellte Flaeche."));
  AddDetail( ({ "gefahr", "kreaturen" }),
    BS("Riesentermiten sind gefaehrlich."));
  AddDetail( ({ "gegend", "laendereien", "reich" }),
    BS("Du befindest Dich im Reich der Termiten."));
  AddDetail( ({ "huegel", "bau" }),
    BS("Irgendwo hier zwischen den grasbewachsenen Huegeln haben die Termiten ihren Bau."));
  AddDetail( ({ "berge" }),
    BS("Die hoch aufragenden Berge befinden sich im Osten."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

}
