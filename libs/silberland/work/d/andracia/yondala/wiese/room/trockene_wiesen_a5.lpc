#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Ein grosser Felsbrocken liegt im Weg.") );
 
  AddDetail( ({ "fels", "felsbrocken", "sandsteinbrocken", "steinbrocken"}), BS(
    "Ein grosser Sandsteinbrocken der noch nicht zerfallen ist und wohl von "+
    "Wind und Wetter im Laufe der Zeit freigelgt wurde und nun langsam zu Sand "+
    "zermahlen wird. "));
  AddDetail( ({ "sand", "steine", "grasnarbe" }), BS(
    "Sand, Steine und eine spaerliche Grasnarbe bilden den Boden."));
  AddDetail( ({ "zeit" }), BS(
    "Sie vergeht ..."));
  AddDetail( ({ "laufe" }), BS(
    "Laufe? Keine Ahnung was ich untersuchen soll. Werd konkreter!"));
  AddDetail( ({ "wind" }), BS(
    "Es ist gerade windstill. "));
  AddDetail( ({"ahnung"}),
    BS("Du hast ja gar keine Ahnung wie schwer es ist solche Gebiete zu erschaffen."));
  AddDetail( ({"weg", "pfad", "trampelpfad"}),
    BS("Du befindest Dich auf einem Trampelpfad mitten im Reich der Riesentermiten."));

  AddExit( "sueden" , ROOM + "trockene_wiesen_a6.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_b4.lpc" );
  
  AddItem( NPC + "termite_krieger.lpc", REFRESH_DESTRUCT );
}
