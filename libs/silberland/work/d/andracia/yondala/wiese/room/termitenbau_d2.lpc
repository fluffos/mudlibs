#include "../def.h"

inherit ROOM + "termitenbau_raw.lpc";

#include <properties.h>

void reset()
{
  ::reset();
  RemoveCmd("durchschreite");
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Die Wand im Osten scheint aus dunklerem Sand zu bestehen. \n" );
    
  AddDetail( ({"ostwand", "wand osten", "wand im osten"}),
    BS("Diese Wand ist sehr duenn und elastisch. Ein fast kreisrunder Bereich der "+
    "Ostwand hat diese Eigenschaft. "));
  AddDetail( ({ "eigenschaft" }),
    BS("Der dunkle Bereich der Wand hat eine elastische Eigenschaft."));
  
  AddSpecialDetail( ({"bereich", "spalt", "wandstuecke" }), "access_door");
  
  AddExit( "sueden" , ROOM + "termitenbau_d3.lpc");
  AddExit( "norden" , ROOM + "termitenbau_d1.lpc");
  AddItem( NPC + "termite_arbeiter.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "termite_krieger.lpc", REFRESH_DESTRUCT );
}

string access_door()
{
  AddCmd( "durchschreite" , "access_area");
  return BS("In der Mitte des elastischen Bereichs der Wand verlaeuft ein kleiner Spalt. "+
    "Vielleicht kann man die Wand durchschreiten wenn man die elastischen Wandstuecke nach rechts "+
    "und links wegdrueckt. ");
}

int access_area(string str)
{
  notify_fail("Was willst Du durchschreiten? \n");
  if(str != "wand" && str != "bereich" && str != "spalt" && str != "ostwand" && str != "wand im osten" && str != "wand osten") return 0;
  write("Du drueckst die Teile der Wand auseinander und steigst hindurch. \n");
  this_player()->move(ROOM + "termitenbau_e2.lpc", M_GO, "nach Osten",
    "drueckt die Teile der Wand auseinander und steigt hindurch",
    "kommt durch die Wand im Westen gestiegen.");
  return 1;
}