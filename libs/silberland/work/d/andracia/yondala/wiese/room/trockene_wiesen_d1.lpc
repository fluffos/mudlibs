#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Ein Sandhuegel unterbricht hier die Grasnarbe und laesst erahnen "+
    "dass hier die Wueste bald die Oberhand gewinnen wird. ") );

  AddDetail( ({ "sandhuegel", "huegel", "duene" }), BS(
    "Der Sandhuegel besteht aus Sand was sonst. "));
  AddDetail( ({ "sand", "vorhut" }), BS(
    "Lockerer trockener Sand."));
  AddDetail( ({ "steine", "grasnarbe" }), BS(
    "Sand, Steine und eine spaerliche Grasnarbe bilden den Boden."));
  AddDetail( ({ "wueste" }), BS(
    "Die Wueste erobert immermehr vom grasueberwachsenen Huegelland. "+
    "Der Sandhuegel ist schon die erste Duene die sich als Vorhut hierher "+
    "bewegt hat. "));
  AddDetail( ({ "oberhand" }), BS(
    "Du bist schon wieder in der Selbstfindung? Um Handlinien zu lesen ist "+
    "die Oberhand aber nicht geeignet. "));
  AddDetail( ({ "selbstfindung" }), BS(
    "Du ueberlegtst und kommst nach einer Weile zu dem Schluss dass Du Du selbst bist."));
  AddDetail( ({ "handlinien" }), BS(
    "Du kannst nicht besonderes an Deinen Handlinien erkennen."));
  AddReadDetail( ({ "handlinien" }), BS(
    "Du versuchst Deine Handlinien zu lesen aber es kommt nichts Sinnvolles dabei raus."));

   
  AddExit( "osten" , ROOM + "trockene_wiesen_e1.lpc");
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_c2.lpc" );
}
