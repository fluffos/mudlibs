inherit "/std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eingang zum Termitenbau" );
  SetProp( P_INT_LONG,
    BS("Du stehst hier mitten zwischen den Tuermen der Termitenheimstatt. "+
    "Ein grosses dunkles Loch im Boden fuehrt hinein in das Reich der Termiten. ") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  
  AddSound( DEFAULT_SOUND,
    BS("Nur ein paar Voegel zwitschern. "));
  AddSound( ({"zwitschern", "voegel"}),
    BS("Nur ein paar Voegel zwitschern. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen. "));

  AddDetail( ({ "himmel", "wetter" }),  
    BS("Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus Sand "));
  AddDetail( ({ "waende", "wand" }),
    BS("Es gibt hier keine Waende. "));
  AddDetail( ({ "zugang", "loch", "eingang" }),
    BS("Ein einfaches Loch in der oberen Kuppe eines Huegels ist der Eingang zum Termitenbau. "));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
    BS("Kleine weisse Schaefchenwolken. "));
  AddDetail( ({ "huegel", "kuppe", "huegels" }),
    BS("In der Kuppe des Huegels klafft ein tiefes Loch. Dies scheint der Eingang zum Termitenbau zu sein."));
  AddDetail( ({ "reich" }),
    BS("Dies ist das Reich der Riesentermiten und in diesem Bau hausen diese aggressiven Insekten."));
  AddDetail( ({ "insekten", "termiten", "riesentermiten", "kreaturen" }),
    BS("Sei vorsichtig! Diese grossen Kreaturen sind boese und tueckisch. Man kann "+
    "kann nicht mit ihnen reden oder sonst wie sich verstaendigen, sie betrachten "+
    "scheinbar alles was sich bewegt als potentielle Nahrungsquelle."));
  AddDetail( ({ "bau", "termitenbau", "termitenheimstatt", "heimstatt", "ort" }),
    BS("Du steht hier am Eingang zum Termitenbau. Nur wenige haben diesen Ort "+
    "gesehen und lebend wieder verlassen."));
  AddDetail( ({ "tuerme", "tuermen", "sand" }),
    BS("Die Termiten haben hier bei ihrem Bau Sand zu Tuerme geformt. "));
  AddDetail( ({ "nahrungsquelle" }),
    BS("Pass auf, sonst verspeisen Dich die Termiten."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/  
  AddExit( "ostunten" , ROOM + "termitenbau_a2.lpc");
  AddExit( "westen" , ROOM + "trockene_wiesen_b4.lpc");
}


