#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Ein Kadaver eines verendeten Tiers liegt hier. ") );
 
  AddDetail( ({ "kadaver", "tier", "tiers", "rind", "wesen" }), BS(
    "Ein armes Rind ist hier gestorben. Ein bischen Fleisch haengt "+
    "noch an den Knochen. Den Rest haben die Termiten wohl schon abgenagt. "));
  AddDetail( ({ "fleisch", "knochen", "rest" }), BS(
    "Ein kleiner Rest Fleisch haengt noch an den Knochen, zuwenig um sich "+
    "zu versorgen. Da es noch nicht nach Verwesung riecht scheint der Kadaver "+
    "noch sehr frisch zu sein. "));
  AddDetail( ({ "verwesung" }), BS(
    "Wenn ein totes Wesen offen herumliegt, faengt es an zu verwesen. Einen "+
    "dafuer typischen Geruch kannst Du nicht riechen. Scheinbar ist der "+
    "Kadaver noch zu jung dafuer. "));
  AddSmell( ({"geruch"}),
    BS("Du kannst nichts besonderes riechen. "));

    
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_d4.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_f2.lpc" );
}
