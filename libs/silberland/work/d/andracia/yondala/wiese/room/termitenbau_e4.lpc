#include "../def.h"

inherit ROOM + "termitenbau_raw.lpc";

#include <properties.h>

//#define SCHWERT "/gilden/zaubererzunft/weapon/zschwert.lpc"

int jupp;

void reset()
{
	if( !jupp && !random(10) )  jupp = 1;
	::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS( "An der Suedwand kommt Dir etwas merkwuerdig vor.") );

  jupp = 1;

  AddDetail( ({ "suedwand" }),
    BS("In der Suedwand ist, halb begraben, ein uraltes Skelett. "));
  AddDetail( ({ "skelett" }),
    BS("Merke Dir diese Stelle. Sollte die Gilde der Magier jemals kommen, hast Du hier was tolles gefunden.\n Liebe Gruesse, Yondala. "));
  AddDetail( ({ "gilde","magier" }),
    BS("Du denkst . o O (Das wird wohl noch dauern) "));
  AddDetail( ({ "yondala" }),
    BS("Teile Yondala mit Wann kommen endlich die Magier? "));

	
 // AddSpecialDetail( ({ "skelett" }), "unt_skelett" );

  AddExit( "norden" , ROOM + "termitenbau_e3.lpc");
  AddItem( NPC + "termite_arbeiter.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "termite_arbeiter.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "termite_arbeiter.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "termite_queen.lpc", REFRESH_DESTRUCT );
}

