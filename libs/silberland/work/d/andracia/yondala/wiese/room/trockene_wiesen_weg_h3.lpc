#include "../def.h"

inherit ROOM + "trockene_wiesen_weg_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein kleiner Trampelpfad fuehrt nach Nordwesten vom Weg weg. \n" );
 
  AddDetail( ({"trampelpfad", "pfad" }),
    BS("Ein kleiner Trampelpfad fuehrt hier vom Weg weg."));
   
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_weg_g4.lpc");
  AddExit( "nordwesten" , ROOM + "trockene_wiesen_g2.lpc");
  AddExit( "osten" , ROOM + "trockene_wiesen_weg_i3.lpc" );
}
