#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Die Reste eine Baumes stehen hier. ") );
 
  AddDetail( ({ "reste", "baum", "baumes", "baeume", "baums" }), BS(
    "Der dunkle Stamm und ein paar Wurzeln toten Holzes sind von der Pflanze "+
    "uebrig geblieben. Das tote Gehoelz dient nun nur noch als Rastplatz fuer "+
    "die Voegel. "));
  AddDetail( ({ "stamm" }), BS(
    "Der dunkle Stamm traegt die Spuren von einem Feuer. Warscheinlich wurde "+
    "der Baum Opfer eines Steppenbrands. "));
  AddDetail( ({ "wurzeln" }), BS(
    "Die Wurzeln sind zum Teil freigelegt. "));
  AddDetail( ({ "holz", "holzes", "gehoelz", "spuren", "feuer", "steppenbrand", "brand", "steppenbrands", "brands"}), BS(
    "Das Holz des Baums ist verwittert aber man kann noch immer die Spuren "+
    "eines Brands daran erkennen. "));
  AddDetail( ({ "pflanze" }), BS(
    "Der Baum und das Gras sind hier zu sehen. Beides sind Pflanzen. "));
  AddDetail( ({ "vogel", "voegel" }), BS(
    "Nur wenige Voegel kommen hier in den trockenen Bereich des Huegellands. "+
    "Geier und andere Aasfresser warten hier auf Beute. "));
  AddDetail( ({ "rastplatz", "platz", "stuempfe", "aeste" }), BS(
    "Die Stuempfe von grossen Aesten am toten Baum dienen den Voegeln die sich "+
    "hierher verirren als Rastplatz. "));
  AddDetail( ({ "teil" }), BS(
    "Haeh? Was fuer ein Teil denn?"));
  AddDetail( ({ "aasfresser", "vertreter" }), BS(
    "Geier sind die haeufigsten Vertreter von Aasfressern die hier nach Aas Ausschau halten."));
  AddDetail( ({ "aas" }), BS(
    "Hier gibt es kein Aas."));
  AddDetail( ({ "beute", "opfer", "hut", "ausschau" }), BS(
    "Sei auf der Hut, sonst erwischen dich die Termiten."));
  
  AddExit( "westen" , ROOM + "trockene_wiesen_e9.lpc");
  AddExit( "nordosten" , ROOM + "trockene_wiesen_g8.lpc" );
}
