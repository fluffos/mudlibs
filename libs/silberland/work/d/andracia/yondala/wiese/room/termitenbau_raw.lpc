#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Termitenbau" );
  SetProp( P_INT_LONG,
    BS("Die rauhen Waende dieser Hoehle gehoeren zu einem Bau von Riesentermiten. "+
    "Hier herrscht stickige Luft und kein Lichtschimmer von draussen kommt herein. ") );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    BS("Das typisch klackernde Geraeusch von sich bewegenden Insekten dringt an Dein Ohr. "));
  AddSound( ({ "insekten", "insekt", "geraeusch", "klang" }),
    BS("Die klackernde Geraeusche scheinen von ueberallher zu kommen. Selbst durch die Waende "+
    "scheint der unangenehm Klang zu dringen."));
  AddSound( ({ "wand", "waende" }),
    BS("Hinter jeder Wand koennten sich weitere Gaenge der Termiten befinden. "));
  AddSmell( DEFAULT_SMELL,
    "Der unangenehme Geruch von Insekten herrscht hier. ");
  AddSmell( ({ "insekten", "insekt", "geruch", "luft" }),
    "Der Geruch ist leicht suesslich und recht unangenehm. ");

  AddDetail( ({ "boden" }),
    BS("Der Boden scheint aus Sand zu bestehen. Irgendwie wurde allerdings der Sand "+
    "zusammengeklebt damit er einen stabilen Boden bildet. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke scheint aus Sand zu bestehen. Irgendwie wurde allerdings der Sand "+
    "zusammengeklebt damit er eine stabile Decke bildet."));
  AddDetail( ({ "wand", "waende", "sand" }),
    BS("Die Waende scheinen aus Sand zu bestehen. Irgendwie wurde allerdings der Sand "+
    "zusammengeklebt damit er ein stabile Waende bildet."));
  AddDetail( ({ "hoehle", "gaenge", "bau", "gang" }),
    BS("Alles in diesem Bau scheint aus Sand zu bestehen. Irgendwie wurde allerdings der Sand "+
    "zusammengeklebt damit er stabile Gaenge bildet."));
  AddDetail( ({ "lichtschimmer", "licht" }),
    BS("Kein Lichtschimmer dringt von draussen hier herein."));
  AddDetail( ({ "riesentermiten", "riesentermite", "termiten", "termite", "kriegertermite", "kriegertermiten", "insekten", "kreaturen" }),
    BS("Sei vorsichtig! Diese grossen Kreaturen, die in diesem Bau hausen, sind boese und tueckisch. Man kann "+
    "kann nicht mit ihnen reden oder sonst wie sich verstaendigen. "));
  AddDetail( ({ "ohr", "ohren" }),
    BS("Du kannst mit Deinen Ohren hoeren."));
  AddDetail( ({ "luft" }),
    BS("Die Luft ist etwas stickig und riecht auch etwas unangenehm."));
    
/* 
  AddDetail( ({ "" }),
    BS(""));
*/
}
