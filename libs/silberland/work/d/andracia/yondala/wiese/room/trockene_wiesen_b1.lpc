#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

int menge_blueten;

void init()
{
  if( menge_blueten < 10 ) menge_blueten++;
  ::init();
}

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Hier ist es etwas gruener als sonst. Eine kleine Blumenwiese breitet "+
    "hier ihren Teppich aus.") );
 
  AddDetail( ({ "blumenwiese", "wiese" }), BS(
    "Das Gras hier waechst ueppig und viele Blueten bilden einen farbigen "+
    "Teppich. "));
  AddDetail( ({ "teppich", "bluetenteppich" }), BS(
    "Die Blumen bilden einen Bluetenteppich. Nur noch wenig gruenes Gras "+
    "kann man dazwischen erkennen. "));
  AddDetail( ({ "blueten", "bluete", "blumen", "blume", "mohnblumen" }), BS(
    "Vorallem rote Mohnblumen wachsen hier. Du kannst eine pfluecken wenn Du willst."));
  AddDetail( ({ "gras", "pflanzen" }), BS(
    "Das Gras ist hier etwas frischer. Scheinbar finden hier die Pflanzen noch "+
    "etwas Wasser im Boden."));
  
  menge_blueten = 10;
  AddCmd( ({ "pflueck", "pfluecke", "rupf", "rupfe" }), "pfluecken_CMD" );
 
  AddExit( "suedosten" , ROOM + "trockene_wiesen_c2.lpc");
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_a2.lpc" );
}

int pfluecken_CMD(string str)
{
  object ob;
  notify_fail("Was willst Du pfluecken?\n");
  if(str != "bluete" && str != "blueten" && str != "mohnblumen" && str != "mohnblume" 
  	                 && str != "mohn" && str != "blume" && str != "blumen")
    return 0;
  notify_fail("Der ganze Blumenteppich ist leider niedergetrampelt.\n");
  if(menge_blueten == 0) return 0;
  menge_blueten--;
  ob = clone_object(OBJ + "blume_mohn.lpc");
  if(ob->move(TP, M_GET) != 1) ob->move(environment(TP),M_SILENT);
  write("Du pflueckst eine Mohnblume. \n");
  say(TPN + " pflueckt eine Mohnblume. \n");
  return 1;  
}