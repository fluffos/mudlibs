#include "../def.h"

inherit ROOM + "trockene_wiesen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Im Sueden ragt der grosse Termitenhuegel in die Hoehe. ") );
 
  AddDetail( ({ "huegel", "termitenhuegel", "tuerme", "sandtuerme", "termitenbau", "termitenbaus", "bauwerk", "bau" }), BS(
    "Die steilen Tuerme aus Sand sind das Bauwerk eines Termitenvolkes. "+
    "Die ungewoehnlich groesse laesst darauf schliessen dass Riesentermiten "+
    "hier ihre Heimstatt haben. "));
  AddDetail( ({ "sand" }), BS(
    "Die Tuerme des Termitenbaus sind aus Sand. "));
  AddDetail( ({ "termitenvolkes", "termitenvolk", "volkes", "volk", "heimstatt" }), BS(
    "Die Wesen die hier ihre Heimstatt haben sind Riesentermiten. Boese, grosse "+
    "und angriffslustige Monster, die keine Skrupel und keine Gnade kennen. "));
  AddDetail( ({ "riesentermiten", "wesen", "insekten", "monster" }), BS(
    "Sei nur vorsichtig! Schon viele Wanderer wurden von den Termiten verschleppt "+
    "und mit Sicherheit von ihrer Brut verspeist. "));
  AddDetail( ({ "brut", "termitenbrut" }), BS(
    "Tief im Bau der Termiten ist die Koenigin und legt ein Ei nach dem anderen."));
  AddDetail( ({ "gnade", "skrupel" }), BS(
    "Fuer die Termiten bist Du nur Nahrung. Sie werden Dir gegenueber keine Gnade kennen."));
  AddDetail( ({ "sicherheit" }), BS(
    "Hier ist man nicht sicher."));
  AddDetail( ({ "tiefen", "tiefe" }), BS(
    "Wie tief traust Du Dich in den Termitenbau?"));
  AddDetail( ({ "wanderer" }), BS(
    "Hierher verirrt sich nur selten ein Wanderer."));
  AddDetail( ({ "hoehe" }), BS(
    "Diese Bauwerke aus Sand sind die Heimstatt der Riesentermiten."));
  AddDetail( ({ "ei" }), BS(
    "Vielleicht findest Du ja ein Ei im Termitenbau."));
  AddDetail( ({ "koenigin", "termitenkoenigin" }), BS(
    "Die Termitenkoenigin ist bestimmt tief im Termitenbau zu finden."));
  AddDetail( ({ "nahrung" }), BS(
    "Wenn Du nicht aufpasst bist Du selbst die Nahrung fuer die Termitenbrut."));
   
  AddExit( "norden" , ROOM + "trockene_wiesen_c2.lpc");
  AddExit( "suedwesten" , ROOM + "trockene_wiesen_b4.lpc" );
  AddExit( "suedosten" , ROOM + "trockene_wiesen_d4.lpc" );
}
