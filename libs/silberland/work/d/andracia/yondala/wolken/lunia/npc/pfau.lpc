inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pfau");
  SetProp(P_LONG,
    "Du siehst einen grossen, blauen Pfau der stolz sein praechtiges Gefieder praesentiert.");
  SetProp(P_NAME, "Pfau");
  SetProp(P_GENDER, MALE);
  AddId(({"pfau", "vogel", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit seinen Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_AIR:    -0.5]) );

  SetProp(P_MSGIN, "stolziert herbei");
  SetProp(P_MSGOUT, "stolziert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (LUNIA_ROOM));//+"/d/wolken/yondala/lunia" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, LUNIA_ROOM + "lunia_2d.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Pfau");
//  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "gurrt.\n");

//  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Pfau kann Deine Sachen nicht tragen.\n" }) );


  SetChats(3, ({
    "Der Pfau schlaegt ein Rad.\n",
    "Der Pfau scharrt am Boden.\n",
    "Der Pfau gurrt.\n"}) );

  //SUID;
  CLONEME(LUNIA_OBJ + "pfauenfeder.lpc" );
}
