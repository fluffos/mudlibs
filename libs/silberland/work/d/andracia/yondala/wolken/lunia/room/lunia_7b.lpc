// 11.10.2022: 	Dieser Raum schickt nun in der init() karpfensziege 
//				in das zweite Seherhaus von Karpfen, wenn dort keine ist.

/********************************************************************

Im Suedwesten ist das Rathaus 
Man kann ein Toerchen oeffnen, um in den Park zu gelangen. 
Nur moeglich fuer Seher oder mit Zutrittserlaubnis

********************************************************************/

#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void init()
{
	object ziege; 
	::init();
	if(objectp(find_object("/d/seher/haus/karpfen:00:01")) &&!present("karpfensziege", find_object("/d/seher/haus/karpfen:00:01")))
	{
		write("Keine Ziege da.\n");	
        CLONE(LUNIA_NPC + "karpfensziege.lpc", to_object("/d/seher/haus/karpfen:00:01"));
	}
}

int offen;
void reset()
{
	RemoveExit("nordosten");
  AddDetail( ({ "toerchen" }),
    "Das Toerchen ist geschlossen. Dahinter siehst Du einen herrlichen Park.");
  AddDetail( ({ "park" }),
    "Der Park sieht sehr gepflegt aus, um ihn zu betreten musst Du das "
	"Toerchen oeffnen.");
	SetProp( P_INT_LONG,
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geschlossenes Toerchen");
    if(offen)tell_room(TO,"Das Toerchen faellt zu.\n");
	call_other(LUNIA_ROOM+"lunia_6c","zu");
	offen=0;
    
    ::reset();
	
	}

void create() 
{
  ::create();
  SetProp( P_INT_LONG,  
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geschlossenes Toerchen");
  SetProp( P_LIGHT, 1 );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "tiger.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "baeume" }),
    ("Die Baeume sind sehr gerade gewachsen und machen einen hoechst "
	"gepflegten Eindruck. Sie verdecken fast das imposante Gebaeude im "
	"Suedwesten.")); 
  AddDetail( ({ "gebaeude" }),
    ("Hinter den Baeumen verbirgt sich ein grosses, weisses Gebaeude. "
	"Zwischen den Staemmen kannst Du gerade mal die glatte, weisse Fassade, "
	"das Eingangsportal und ein Fenster erkennen."));
  AddDetail( ({ "suedwesten" }),
    ("Geh hin, wenn Du mehr sehen willst."));
  AddDetail( ({ "fassade" }),
    ("Die Fassade ist makelos glatt und strahlt in hellem Weiss."));
  AddDetail( ({ "weiss" }),
    ("Das Weiss ist fast schon uebertrieben hell, es blendet sogar ein "
	"wenig."));
  AddDetail( ({ "makel" }),
    ("Du kannst keinen Makel erkennen, freust Dich aber ueber diesen "
	"Forscherpunkt."));
  AddDetail( ({ "forscherpunkt", "jippie" }),
    ("Jippie."));
  AddDetail( ({ "eingangsportal","portal","eingang" }),
    "Ein grosser Schriftzug prankt darueber.\nWenn Du nach Suedwesten gehst, "
	"betrittst Du es.");
  AddDetail( ({ "schriftzug","schrift" }),
    "Wirklich, ein grosser Schriftzug ist das. Was da wohl steht?");
  AddReadDetail( ({ "schriftzug","schrift" }),
    "Rathaus Lunia");
  AddDetail( ({ "rathaus" }),
    "Ach, das hier ist also das Rathaus? Deswegen ist es wohl so imposant.");
  AddDetail( ({ "fenster" }),
    "Alles was hinter dem Fenster ist, liegt im Dunkeln verborgen, Du kannst "
	"nichts erkennen.");
  AddDetail( ({ "dunkeln" }),
    "Vermutlich ist im Rathaus kein Licht an.");
  AddDetail( ({ "licht" }),
    "Ist ja auch unnoetig, wenn man im Rathaus ist, faellt durch das Fenster "
	"wohl genug Licht herein.");
  AddDetail( ({ "staemme" }),
    "Die gehoeren zu den Baeumen.");
  AddDetail( ({ "toerchen" }),
    "Das Toerchen grenzt den Park von der Allee ab.");
  AddDetail( ({ "straeucher" }),
    "Die Straeucher sind hier nicht sehr dicht. Du glaubst, einfach nach Westen "
	"durch sie hindurch gehen zu koennen.");
  AddDetail( ({ "westen" }),
    "Obwohl dort Straeucher sind, kannst Du einfach nach Westen gehen.");
  AddDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

     AddExit( "nordwesten", LUNIA_ROOM + "lunia_6a.lpc" );
     AddExit( "suedosten", LUNIA_ROOM + "lunia_8c.lpc" );
     AddExit( "suedwesten", LUNIA_ROOM + "lunia_8a.lpc" );
   SetProp(P_HIDE_EXITS, ({"westen"}) );
   AddCmd(({"oeffne"}),"oeffnen");
   AddCmd(({"schliesse","schliess"}),"schliessen");

 }

int schliessen(string str)
{
	notify_fail("Was moechtest Du schliessen?\n");
	if (str!="toerchen") return 0;

	if(!offen)write("Das Toerchen ist doch zu.\n");
	else
	  {
		RemoveExit("nordosten");
  AddDetail( ({ "toerchen" }),
    "Das Toerchen ist geschlossen. Dahinter siehst Du einen herlichen Park.");
  AddDetail( ({ "park" }),
    "Der Park sieht sehr gepflegt aus, um ihn zu betreten musst Du das "
	"Toerchen oeffnen.");
  SetProp( P_INT_LONG,  
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geschlossenes Toerchen");
	write("Du schliesst das Toerchen.\n");
	say(TPN+" schliesst das Toerchen.\n",TP);
	offen=0;
			call_other(LUNIA_ROOM+"lunia_6c","zu");
		}
return 1;
}

int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if (str!="toerchen") return 0;

	if(offen)
	{
	   write("Das Toerchen ist doch schon auf.\n");
	   return 1;
	   }
	//if(query_wiz_level(TPN)==0)
	if (!IS_SEER(TP)&&!present("zutrittserlaubnislunia",TP)) 
	{
	   write("Du versuchst das Toerchen zu oeffnen.\n"+
	   "Eine Stimme raunt Dir zu: Komme wieder, wenn Du Seher bist oder besorge Dir eine Zutrittserlaubnis!\n");
	   return 1;
	   }	

			AddExit("nordosten", LUNIA_ROOM+"lunia_6c.lpc");
			AddDetail( ({ "toerchen" }),
    		"Das Toerchen ist geoeffnet, Du kannst den Park also problemlos betreten.");

  SetProp( P_INT_LONG,  
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geoeffnetes Toerchen");
  write("Du oeffnest das Toerchen.\n");
  say(TPN+" oeffnet das Toerchen.\n",TP);
  offen=1;
  call_other(LUNIA_ROOM+"lunia_6c","auf");
  return 1;		
}
	
	
void zu()//wird bei reset des anderen Raumes aufgerufen
{
	RemoveExit("nordosten");
  AddDetail( ({ "toerchen" }),
    "Das Toerchen ist geschlossen. Dahinter siehst Du einen herlichen Park.");

  SetProp( P_INT_LONG,  
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geschlossenes Toerchen");
    offen=0;
      tell_room(TO,"Das Toerchen faellt zu.\n");
	}
	
void auf()//wird vom anderen Raum aufgerufen
{
			AddExit("nordosten", LUNIA_ROOM+"lunia_6c.lpc");
			AddDetail( ({ "toerchen" }),
    		"Das Toerchen ist geoeffnet, Du kannst die Weide also problemlose betreten.");
 			AddDetail( ({ "weide" }),
    		"Die Weide liegt suedlich von Dir.");
  SetProp( P_INT_LONG,  
    "Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist "
	"auf der Aussenseite gesaeumt von hohen Baeumen und Straeuchern hinter denen hin und "
	"wieder ein Haus hervorlugt. Auf der Innenseite des Kreises befindet "
	"sich ein herrlicher gepflegter Park der durch eine kniehohe Hecke "
	"abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige hochgewachsene Baeume und praechtige Buesche.\n"
	"Ein geoeffnetes Toerchen");

	    tell_room(TO,"Das Toerchen wird von der anderen Seite geoeffnet.\n");
		offen=1;
	}
