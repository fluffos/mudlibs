Hier die Raumbeschreibung fuer Aginors Haus im Norden

********************************************************************/

#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Noerdlich von Dir steht ein mysterioeses Haus.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "haus","norden" }),
    ("Im Norden steht ein Haus. Leider kann es nicht betreten werden."));



  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));


 // AddCmd( ({ "betrete", }), "betretenCmd" );
 
 
  AddExit( "suedosten", LUNIA_ROOM + "lunia_2f.lpc" );
  AddExit( "westen", LUNIA_ROOM + "lunia_1d.lpc" );
//  AddExit( "norden", LUNIA_ROOM + "lunia_0e.lpc" );//Aginors Haus

}


