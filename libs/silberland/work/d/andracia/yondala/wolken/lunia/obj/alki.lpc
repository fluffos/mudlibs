#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  AddId("\nalki");

  SetProp(P_MATERIAL, MAT_AIR );
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
}

