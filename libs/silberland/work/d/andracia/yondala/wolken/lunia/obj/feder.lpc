#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Feder");
  SetProp(P_LONG,
    "Du siehst eine kleine Feder, die so leicht und fein ist, dass Du sie vermutlich einfach "
    "wegpusten kannst." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Feder");
  SetProp(P_GENDER, FEMALE);
  AddId("feder", "kleine feder");
 SetProp(P_NAME_ADJ, "klein");
  SetProp(P_MATERIAL, MAT_FEATHER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
     AddCmd( ({ "puste","pust"}), "pusten" );


}


int pusten(string str)
{
	if(str=="feder"||str=="feder weg"||!str)
		{
			write("Du pustest und schon fliegt die kleine Feder davon.\n");
			say(TPN+" pustet eine Feder weg.\n");
      this_object()->remove();
    }			
	else write("Was moechtest Du wegpusten?\n");
		
	return 1;
	
	}