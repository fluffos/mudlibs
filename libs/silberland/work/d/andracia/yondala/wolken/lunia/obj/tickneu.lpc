#include "../def.h"
inherit "std/thing";
#include <properties.h>
int ticken;
int intervall;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  intervall=5;
  SetProp(P_SHORT, "Ein Tick");
  SetProp(P_LONG,
    "Du siehst ein kleines, langweiliges Tick. Es kann eigentlich nichts, ausser vor sich hinticken, wenn Du es wuenschst." );
  SetProp(P_INFO, "Mit \"tick ein\" bzw. \"tick aus\" kannst Du das Ticken ein oder ausschalten.");

  SetProp(P_NAME, "Tick");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tick"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 50);
  AddCmd( ({ "tick" }), "ticken" );

}
void ticker()
{
	if(ticken&&interactive(environment(TO)))
	{
			tell_object(environment(TO),"Tick\n");
			call_out("ticker",intervall*60);
		}
	else
		{
			ticken=0;
			intervall=5;
		}
}
int ticken(string str)
{
	notify_fail("Tick ein/aus/zahl?\n");
	if(str=="ein")
		{
			if(ticken==1)
  			{
	    		tell_object(environment(TO),"Ticken ist schon an.\n");
	    		return 1;
	    		}

			ticken=1;
			intervall=5;
			tell_object(environment(TO),"Ticken ist nun an mit einem Intervall von "+intervall+" Minuten.\n");
			call_out("ticker",intervall*60);
			return 1;
		}
		
	if(str=="aus")
		{
			ticken=0;
			tell_object(environment(TO),"Ticken ist nun aus.\n");
			return 1;
		}
	
	if(intp(to_int(str)))
		{
	    intervall=to_int(str);
			if(intervall<1) intervall=1;
			tell_object(environment(TO),"Ticken ist nun an mit einem Intervall von "+intervall+" Minuten.\n");
			if(ticken!=1)
				{
					ticken=1;
					call_out("ticker",intervall*60);
					}
			return 1;
		}
			
	return 0;
	}
	