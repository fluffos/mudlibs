#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Vor Dir steht ein kleiner Brunnen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "brunnen" }),
    ("Der Brunnen ist aus weissem Marmor. In seiner Mitte steht eine Statue die scheinbar in das "
    "Becken pinkelt."));
  AddDetail( ({ "mitte" }),
    ("Mitten im Brunnen steht eine Statue auf einem kleinen Sockel."));
  AddDetail( ({ "sockel" }),
    ("Der Sockel besteht ebenfalls aus weissem Marmor und ist kreisrund. Auf ihm siehst Du ein "
    "kleines goldenes Schildchen."));
  AddDetail( ({ "becken" }),
    ("Du siehst ein grosses, weisses Becken in dessen Mitte ein Sockel mit einer Statue steht welche "
    "pinkelnd Wasser in das Becken fuellt."));
  AddDetail( ({ "schildchen" }),
    ("Du kannst es lesen."));
  AddDetail( ({ "wasser" }),
    ("Ob es wohl trinkbar ist?\nMisstrauisch schielst Du zu der Statue hin."));
  AddDetail( ({ "statue" }),
    ("Die marmorne Statue ist strahlend weiss und einfach makellos. Sie stellt einen kleinen, "
    "nackten Jungen dar, der ungeniert in das Becken pinkelt."));
  AddDetail( ({ "junge", "jungen" }),
    ("Der Junge ist recht klein und laechelt mit einem unschuldigem Gesicht seinem Wasser hinterher."));
  AddDetail( ({ "gesicht" }),
    ("Das Gesicht des Jungen ist sehr realistisch dargestellt. Deutlich siehst Du die filligran "
    "gearbeiteten Augenbrauen, die leicht spitzen Ohren, die feinen Linien des Mundes."));
  AddDetail( ({ "augenbrauen" }),
    ("Fast scheint es, als waere jedes Haerchen einzeln herausgemeisselt worden."));
  AddDetail( ({ "haerchen","arbeit","linien" }),
    ("Es muss eine wahnsinnige Arbeit gewesen sein diese Statue herzustellen."));
  AddDetail( ({ "ohren" }),
    ("Fast moechte man sie ihm lang ziehen."));
  AddDetail( ({ "mund" }),
    ("Die Lippen sind leicht geoeffnet und laecheln."));
  AddDetail( ({ "lippen" }),
    ("Du staunst, wie realistisch sie dargestellt sind. Fast schon bist Du versucht ihnen zu lauschen."));
  AddSpecialDetail( ({ "penis","pimmel","schniedel","pipimann","schniedelwutz","schwanz"  }), "penis" );
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddReadDetail( ({ "schildchen" }),
    ("*******************************\n"
     "*        WUNSCHBRUNNEN        *\n"
     "* Wuensch Dir was, vielleicht *\n"
     "*     wirst Du erhoert        *\n"
     "*******************************\n"));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");
  AddSound( ({ "lippen","fluestern" }),
    "Die Lippen fluestern leise: Spendet dem Brunnen etwas!\n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

  AddCmd( ({ "wuensche","wuensch" }), "wuenschen" );
  AddCmd( ({ "trinke","trink" }), "trinken" );
  AddCmd( ({ "zieh","ziehe" }), "ziehen" );
  AddCmd( ({ "spende","spend" }), "spenden" );
  AddCmd( ({ "pinkel","pinkle", "piss", "pisse" }), "pinkeln" );
 
 
  AddExit( "westen", LUNIA_ROOM + "lunia_1c.lpc" );
  AddExit( "osten", LUNIA_ROOM + "lunia_1e.lpc" );


}


int wuenschen(string str)
{
	if(str)
		{
			write("Du presst Deine Augen zusammen und denkst ganz fest an Deinen Wunsch.\n"+
       			"Ob er wohl erfuellt wird?\n");
			say(TPN+" presst die Augen zusammen und murmelt etwas.\n");
		}
	else write("Was moechtest Du Dir denn wuenschen?\n");
		
		return 1;
	
	}

int pinkeln(string str)
{
	if(!str||str=="in brunnen"||str=="in wasser"||str=="in becken")
		{
			write("Du fuehlst Dich von der Statue dermassen beobachtet, dass Du Dich doch nicht traust.\n");
		}
	else write("Wo moechtest Du hinpinkeln?\n");
		
		return 1;
	
	}
	
int trinken(string str)
{
	if(str=="wasser"||str=="aus brunnen"||str=="aus becken")
		{
			write("Du tauchst Deine Haende ins Wasser und formst aus Ihnen eine Schale und trinkst "
			"etwas Wasser.\nDu fuehlst Dich herrlich erfrischt.\n");
			say(TPN+" schoepft und trinkt etwas Wasser aus dem Brunnen.\n");
		}
	else write("Was moechtest Du denn trinken?\n");
		
		return 1;
	
	}	

string penis()
{
	if(TP->QueryProp(P_GENDER)==MALE)
		return("Er ist natuerlich viiiiiiel kleiner als Deiner. Dafuer kann er laenger pinkeln.\n");
	return("Pfui, war ja klar, dass Du genau DA hinguckst!\n");

	}


int ziehen(string str)
{
	if(str=="ohren"||str=="ohren lang"||str=="an ohren"||str=="statue an ohren")
		{
			write("Du versuchst die Ohren lang zu ziehen, stellst aber dann enttaeuscht fest, dass sie "
			"tatsaechlich nur aus Marmor bestehen und sich nicht verlaengern lassen.\n");
			say(TPN+" fummelt am Kopf der Statue rum und laesst dann enttaeuscht von ihr ab.\n");
			return 1;
		}
	
		return 0;
	
	}	

int spenden(string str)
{
	int spende;
	string dummy;
	notify_fail("Wieviele Muenzen moechtest Du spenden?\n(Spende x Muenzen)\n");
	if(!str) return 0;
		
	if(sscanf(str,"%d muenzen%s",spende, dummy)!=2&&sscanf(str,"%d muenze%s",spende, dummy)!=2)return 0;
		
		if(this_player()->QueryMoney() >= spende)
			{
				write("Du spendest dem Brunnen "+spende+" Muenzen.\nDie Lippen fluestern: Habt Dank!\n");
				say(TPN+" spendet dem Brunnen ein paar Muenzen.\n");
				if(spende>9&&TP->FindPotion("Ploetzlich haelst Du einen kleinen Trank in Deinen Haenden.\n")) return 1;
	   
				spende=0-spende;
				this_player()->AddMoney(spende);
				}
				else write("Die Lippen fluestern: Soviele Muenzen habt Ihr doch gar nicht bei!\n");
					

		return 1;
	
	}	






