// Der Zauberladenverkaeufer
inherit "std/mnpc";
#include <language.h>
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kuerzel
#include "../def.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Zirpus");
  SetProp(P_LONG,
    "Du siehst einen kleinen, pummeligen Mann mit einem grossen Hut und einem "
	"weiten Umhang. Seine Haut ist sonnengebraeunt, seine schwarz ummalten Augen "
	"schauen Dich freundlich an." );
  SetProp(P_NAME, "Zirpus");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"zirpus", "verkaeufer"}));
    SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_MAGIC:1]) );

  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinem Zauberstab",QueryProp(P_HANDS)[2],DT_BLUDGEON}));
//  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 500);

  SetProp(P_MSGIN, "wandelt herbei"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "wandelt davon");//verlassen wird
  SetProp(P_MMSGIN, "wandelt herein");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "wandelt von dannen");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " stirbt.\n");

  SetProp(P_MURDER_MSG, TPN+ ", ich verfluche Euch und Eure Kinder und Eure Kindeskinder!");
  SetProp(P_KILL_NAME, "Zirpus");
  SetProp(P_KILL_MSG, "");//die meldung wenn der LUNIA_NPC einen Spieler umgebracht hat

  AddInfo(DEFAULT_INFO, "gibt sich mit derlei weltlichen Dingen nicht mehr ab.\n");
SetProp (P_MNPC_DEFAULTROOM, LUNIA_ROOM+"lunia_0c.lpc");
SetProp (P_MNPC_AREA, LUNIA_ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SUID;
  CLONEME(LUNIA_WEAPON +"zirpusstab.lpc" );
  command("zuecke stab");  
  CLONEME(LUNIA_ARMOUR + "grosserhut.lpc");
  CLONEME(LUNIA_ARMOUR + "weiterumhang.lpc");
  command("trage alles");
  
  AddInfo( ({"quest","abenteuer, hilfe"}),
    "Das muesst Ihr schon alleine schaffen.",
    "sagt: "); 
     
  AddInfo( ({ "licht", "sonne" }),
    "Die Sonne spendet unser Licht!",
    "sagt: ");
  AddInfo( ({ "kobold" }),
    "Die Kobolde leben im Vorgebirge!",
    "sagt: ");
  AddInfo( ({ "haende", "hand" }),
    "Haende hab ich zwei.",
    "sagt: ");
  AddInfo( ({ "sex", "poppen", "quickie", "ficken", "blowjob" }),
    "haut dir eine runter");
      
  AddInfo( ({ "yondala", "yoni" }),
    "Yondala ist eine Adlige.",
    "sagt: ");        
  AddInfo( ({ "aginor" }),
    "Aginor ist ein Adliger.",
    "sagt: ");        
  AddInfo( ({ "leni", "luna", "henry" }),
    "Das ist eins von Yondalas Kindern.",
    "sagt: ");
  AddInfo( ({ "leonie" }),
    "Das ist eine Katze die hier rumstreunt.",
    "sagt: ");        
  AddInfo( ({ "" }),
    "",
    "sagt: ");        
  AddInfo( ({ "" }),
    "",
    "sagt: ");        
  AddInfo( ({ "" }),
    "",
    "sagt: ");        
  AddInfo( ({ "" }),
    "",
    "sagt: ");        
 SetChats(3, ({
    "Zirpus laesst kleine Sternchen tanzen.\n",
    "Zirpus kichert.\n",
    "Zirpus sagt: Tick Tick.\n",
    "Zirpus brummelt etwas vor sich hin.\n",
    "Zirpus scheint Dich gar nicht wahr zu nehmen.\n"}) );
	
	
	
   SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(2,450,
	        "Zirpus sprueht einen Wirbel aus funkelnden Sternen auf Dich.\n",
	        "Zirpus sprueht einen Wirbel aus funkelnden Sternen auf @WEN.\n",
	         ({DT_LIGHT}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,280,
	         "Zirpus umarmt Dich.\n",
	         "Zirpus umarmt @WEN.\n",
	         ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,550,
	         "Zirpus schleudert Dir seine geballte Energie entgegen.\n",
	         "Zirpus schleudert @WEM seine geballte Energie entgegen.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );


	
	
}

