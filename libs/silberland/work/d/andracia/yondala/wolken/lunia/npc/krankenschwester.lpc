#include <properties.h> 
#include <combat.h>
#include <new_skills.h>
#include <moredef.h>
inherit "std/npc";
#include <language.h>
#include "../def.h"




string arzt()
{
	if (present("\ndoktor", environment(TO)))
		return("deutet auf den Doktor.\n"+
					"Die Krankenschwester sagt: Wendet Euch bitte an den Doktor!\n");
	
	command("sag Ich rufe ihn, Moment bitte!");
	tell_room(environment(TO), "Die Krankenschwester ruft den Doktor herbei.\n");
  CLONE(LUNIA_NPC+"arzt.lpc", environment(TP));
  return("sagt: Ah, gut, dass sie da sind, Herr Doktor!\n");
	}





void create() {

  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Eine Krankenschwester");
  SetProp(P_LONG,
    "Du siehst eine rundliche Krankenschwester vor Dir, die Dich freundlich anlaechelt. Sie traegt "
    "einen weissen Kittel und eine weisse Haube auf ihren braunen Haaren.");
  SetProp(P_NAME, "Krankenschwester");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);


  AddId(({"schwester", "krankenschwester", "\nkrankenschwester"}));//Dinge auf die man ihn beim untersuchen ansprechen kann

  create_default_npc(15);// Die Zahl entspricht der Spielerstufe des LUNIA_NPC
  
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 1, "sagt: Lasst das, sonst landet Ihr in der Notaufnahme!");
  AddInfo( ({ "medicus", "doktor", "arzt", "asklepio"}), #'arzt );
  AddInfo( ({ "medicus", "doktor", "arzt", "asklepio"}), #'arzt );


  SetProp(P_MMSGIN, "betritt den Raum.");
  SetProp(P_MMSGOUT, "verlaesst den Raum.");

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "tut beschaeftigt.\n");//Wenn der LUNIA_NPC keine Antwort hat

  AddInfo("yondala", "Lang lebe Lady Yondala!","sagt: "); 
  AddInfo("yason", "Lang lebe Lord Yason!","sagt: ");
  AddInfo("aginor", "Lang lebe Lord Aginor!","sagt: "); 
       
  AddInfo( ({ "operation" }),
    "Wir bieten im Moment hauptsaechlich Notoperationen an.",
    "sagt: ");        
/*  AddInfo( ({ "geschlechtsumwandlung" }),
    "Eine Geschlechtsumwandlung koennen wir problemlos durchfueren, sie "
    "kostet 1000000 Muenzen und Ihr braucht keinen Termin dafuer, allerdings "
    "eine behoerdliche Genehmigung.",
    "sagt: ");        
  AddInfo( ({ "Rassenumwandlung" }),
    "Eine Rassenumwandlung koennen wir problemlos durchfueren, sie "
    "kostet 1000000 Muenzen und Ihr braucht keinen Termin dafuer, allerdings "
    "eine behoerdliche Genehmigung.",
    "sagt: ");        
    AddInfo( ({ "genehmigung", "behoerdliche genehmigung" }),
    "Fuer jeden grossen operativen Eingriff muesst ihr eine offizielle "
    "Genehmigung haben. Diese Genehmigung koennt ihr im Rathaus erlangen.",
    "sagt: ");  */      
    AddInfo( ({ "notaufnahme" }),
    "Nun, kranke oder schwer verwundete Personen koennen jederzeit zu uns kommen und werden so "
    "schnell es geht behandelt. Eine Garantie auf Ueberleben gibt es bei uns allerdings nicht.",
    "sagt: ");        
    AddInfo( ({ "garantie", "ueberleben" }),
    "Man kann nie garantieren, dass alles gut gehen wird.",
    "sagt: ");        
    AddInfo( ({ "hilfe" }),
    "Wenn Ihr einen Doktor braucht, so fragt mich danach und ich werde ihn herbeirufen.",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");
    
    

// AddCmd( ({ "bitte" }), "bittenCmd" );
}


// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht.",
        "lacht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schlaegt mit der Faust auf die Theke.",
        "schlaegt mit der Faust auf die Theke.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt.",
        "schmunzelt.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schimpft ueber Dich.",
        "schimpft ueber " +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "singt nickt Dir zu.", 
        "singt nickt @WEM zu.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
//    case "neutral":
//      call_out("reaction", 0, TP,
  //      "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
    //    "prudi zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      //break;
    case "traurig":
      call_out("reaction", 0, TP,
        "wird sentimental.",
        "wird sentimental.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
 
 
}
