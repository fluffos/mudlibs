/* 
 * 30 August 2018 - Yondala@SilberLand
 * Diese Tresor erhaelt man wenn man 30 Tage lang die Wuensche des Konstrukteurs erfuellt. 
 * Er ist abschliessbar per Zahlencode
 
 Ideen fuer Wunsch von Konstrukteur:
 Leiche von XY (random?)
 Apfel
 Stahl
 diverse Fische
 Eine Narrenkappe tragen fuer mindestens eine Stunde (nicht ausloggen in der Zeit)
 Edelsteine (random)
 An einen bestimmten Ort gebracht werden (oder zu einer Person / Rasse / Klasse) Bei Spielern koennte er dem entsprechendem Spieler ein paar Muenzen geben fuer seine Muehe
 
 Wird einen Tag lang kein Wunsch erfuellt, setzt er sich zurueck oder verschwindet ganz (random oder eins nach dem anderen?)
 Konstrukteuer sollte Kobold sein. Bisschen gierig
 Kann in Lunia beantragt werden
 */ 

#pragma strict_types 

#include <properties.h>
#include <moving.h>
#include "/d/seher/sys/moebel.h"

inherit "/std/container";


string beschriftung;

public void create() {
	int wunscherfuellt;
  int i;
  wunscherfuellt=0; //wurde ja noch nicht erfuellt
  if (!is_clone(this_object())) return;
  ::create();
  i=random(5);
  AddId(({"tresor", MOEBEL_ID}));
  beschriftung=0;
  SetProp(P_SHORT,"Ein Tresor");
  SetProp(P_LONG, "Ein Tresor.\n");
  SetProp(P_NAME,"Regal");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT,10000);   
  SetProp(P_WEIGHT_PERCENT,100);
  SetProp(P_TOTAL_OBJECTS,20);
  SetProp(P_MAX_WEIGHT,1000000);
  SetProp(P_SIZE,200);
  SetProp(P_VALUE,1000000);  
  SetProp(P_MATERIAL,([MAT_STEEL ,MAT_MISC_MAGIC]));

 // AddCmd(({"beschrift","beschrifte"}),"cmdBeschrifte");
  
  //AddSpecialDetail(({"schildchen","beschriftung"}),"detBeschriftung");
  //uebernimmt der Tresorbauer
  
  
  
  AddDetail("moebelhandel","Gibts hier noch nicht. "
      "Muss also wo anders her sein.\n");
  AddDetail("gesangsverein",
      "Der liebe Herr Gesangsverein ist vor zwei Minuten am anderen "
      "Ende des Silberlands gesichtet worden. Entweder Du rennst da jetzt "
      "hin und machst Dich laecherlich oder Du vergisst ihn einfach "
      "wieder. :)");
  AddDetail("augenhoehe",([0:
      "Interessant, ein Zwerg haette es genauso gesehen.",
      "zwerg":"Interessant, ein Elf haette es genauso gesehen."]));
 
}

nosave string detBeschriftung() {
  if (!beschriftung) return 
    "Das Schildchen ist leer, das Regal unbeschriftet.\nHm.\nHMM.\n"
    "Ob man das Regal beschriften kann?\nBestimmt kann man.\nAber nur "
    "einmal.\nDu bist Dir da sehr sicher.\n";
  else
    return break_string("Jemand hat mit krakeligen Buchstaben '"+
        beschriftung+"' auf das Schildchen am Regal gemalt.",77);
}

     

nosave int cmdBeschrifte(string wiebitte) {
  string schrift, regal;
  notify_fail("Was willst Du beschriften?\n");
  if ((!wiebitte) || (!this_player()) || (!interactive(this_player())) ||
  (!wiebitte=(string)this_player()->_unparsed_args())) return 0;

  notify_fail("Beschrifte ... mit ...?\n");
  if (sscanf(wiebitte,"%s mit %s",regal, schrift)!=2) return 0;

  notify_fail("Das kannst Du wohl nicht beschriften.\n");
  if (!id(regal)) return 0;

  notify_fail("Auf dem Schildchen des Regals steht bereits klar und "
      "deutlich:\n'"+beschriftung+"'. Kriegst Du nicht wieder runter. :(\n");
  if (beschriftung) return 0;

  notify_fail("Guter Ansatz, aber mit was moechtest Du das Regal "
      "beschriften?\n");
  if ((!schrift) || (schrift=="")) return 0;

  notify_fail("Mmmh, so viel passt da nicht drauf, fasse Dich ein wenig "
      "kuerzer.\n");
  if (strlen(schrift)>20) return 0;

  beschriftung=schrift;
  AddId(lowerstring(beschriftung)+" regal");
  SetProp(P_INFO,"Dieses Regal wurde von "+(string)this_player()->Name(WEM)+
      " beschriftet.\n");

  write(break_string("Du schreibst in grossen lesbaren Buchstaben '"+
        beschriftung+"' auf das Schildchen am Regal, trittst dann zurueck "
        "und bewunderst Dein Werk! Wow!",77));
  say(break_string(this_player()->Name(WER)+" schreibt langsam in grossen "
        "wackeligen Buchstaben etwas auf ein kleines Schildchen an einem "
        "Regal (Du siehst, wie "+
        this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR)+" Zunge an "
        "den Lippen kreist, ist wohl gar nicht so einfach, so ganz ohne... "
        "huch, ohne Stift). Dann tritt "+this_player()->QueryPronoun(WER)+
        " zurueck und bewundert "+
        this_player()->QueryPossPronoun(NEUTER,WEN,SINGULAR)+
        " Werk.",77));
  return 1;
}

public string long() {
  if (!sizeof(all_inventory(this_object())))
    return break_string("Mein lieber Herr Gesangsverein, das ist aber "
        "ein Drum von einem Regal! Naja, eigentlich sieht es ja aus, wie "
        "just aus einem schwedischen Moebelhandel entwendet, aber "
        "gleichzeitig scheint es auch einiges auszuhalten: Die vier Beine "
        "an den Ecken sind nicht etwa aus Holz, sondern aus behauenem Stein, "
        "die Bretter koennten glatt aus Eiche sein. Nicht unbedingt sehr "
        "schmuck, das Teil, aber praktikabel! Dir faellt ein kleines "
        "Schildchen auf, das an einem Fachboden in Deiner Augenhoehe "
        "angenagelt ist.",77);
    else
      return break_string("Ein "+ (beschriftung?
            "mit "+beschriftung+" beschriftetes":"unbeschriftetes")+
          " Regal, in ihm steht:\n",77,0, 1)+
      make_invlist(this_player(),all_inventory(this_object()), 0);
}

varargs int PreventInsert(object ob) {
  if ((!environment()) || 
      ((member(inherit_list(environment()),"std/room.lpc"))<0)) {
    write("Solange Du das Regal mit Dir herumtraegst, wird das nichts.\n");
    return 1;
  }
  return ::PreventInsert(ob);
}
 
int move(mixed dest, int method) {
  if (sizeof(all_inventory(this_object()))) {
    write("Bist jeck?! Mach das Regal doch bitte erstmal leer, "
        "bevor Du es herumtraegst.\n");
    return ME_TOO_HEAVY;
  }
  else if (objectp(dest) && 
    ((member(inherit_list(dest),"std/room.lpc"))>=0) &&
    (present(MOEBEL_ID+" "+MAX_MOEBEL_ALLOWED,dest))) {
     write("Da steht bereits genug herum, findest Du nicht?\n");
    return ME_CANT_BE_DROPPED;
  }
  else return ::move(dest, method);
}

public string short() {
  string s;
  s="Ein "+ (beschriftung?"["+beschriftung+"]":"unbeschriftetes")+" Regal ";
  switch (sizeof(all_inventory(this_object()))) {
    case 0: return s+="(leer).\n";
    case 1..5: return s+="(duenn bestueckt).\n";
    case 6..10: return s+="(etwas gefuellt).\n";
    case 11..15: return s+="(halb vollgestellt).\n";
    case 16..20: return s+="(ziemlich voll).\n";
    case 21..24: return s+="(vollgestellt).\n";
    case 25: return s+="(randvoll).\n";
    default: return s+="(berstend voll).\n";
  }
  return "Hae?.\n";
}
