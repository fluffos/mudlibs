#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Suedlich von Dir erhebt sich ein stattliches Gebaeude.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "gebaeude" }),
    ("Vor Dir erhebt sich ein stattliches Gebauede. Es besteht aus einem zweistoeckigen Hauptteil, "
     "dem praechtigen Eingangsportal und einer riesigen runden Kuppel."));
  AddDetail( ({ "hauptteil" }),
    ("Der Haupteil besteht aus weissem Marmor. Das Gebaeude ist zweistoeckig und jedes Stockwerk ist "
    "hoeher als normal, was Du an den vier riesigen Fenstern ausmachen kannst, die auf jedem "
    "Stockwerk jeweils rechts und links verteilt sind."));
  AddDetail( ({ "stockwerk","stockwerke" }),
    ("Das Gebaeude hat zwei hohe Stockwerke, die mit vielen grossen Fenstern bestueckt sind."));
  AddDetail( ({ "fenster" }),
    ("Du siehst insgesamt 16 grosse Fenster, die in huebsch verzierten Rahmen in dem Gebaeude "
    "stecken. Vor einem der Fenster ist ein Eisengitter befestigt."));
  AddDetail( ({ "rahmen", "fensterrahmen" }),
    ("Du findest an den Fensterrahmen allerlei Verziehrungen."));
  AddDetail( ({ "verziehrungen" }),
    ("Du siehst fein herausgearbeitete Schnoerkel und Ornamente."));
  AddDetail( ({ "schnoerkel", "ornamente" }),
    ("Ein verwirrendes Muster, das nicht wirklich einen Sinn ergibt."));
  AddDetail( ({ "muster" }),
    ("Das Muster ist huebsch anzusehen, auch wenn Du keinen Sinn darin erkennen kannst."));
  AddDetail( ({ "sinn", "lauf" }),
    ("Du verfolgst mit den Augen den Lauf der Schnoerkel und Ornamente, doch einen Sinn kannst Du nicht finden."));
  AddDetail( ({ "augen" }),
    ("Waere gruselig, wenn Du Deine eigenen Augen sehen koenntest, oder?"));
  AddDetail( ({ "eingangsportal","portal","eingang" }),
    ("Der Eingang des Gebaeudes liegt zwischen zwei grossen, dicken Saeulen, die einen kleinen Balkon "
    "tragen. Durch die stabile Eichentuer kann man das Gebaeude vermutlich betreten. Ueber ihr ist "
    "eine Tafel angebracht."));
  AddDetail( ({ "saeulen" }),
    ("Zwei stabile, weisse Saeulen stuetzen das Gebaeude und saeumen dessen Eingang. Auf ihnen ruht "
    "ausserdem ein kleiner Balkon."));
  AddDetail( ({ "balkon" }),
    ("Ausser, dass er da ist kannst Du von dem Balkon von hier aus nichts erkennen."));
  AddDetail( ({ "eisengitter" }),
    ("Was da wohl hinter steckt?"));
  AddDetail( ({ "eichentuer","tuer" }),
    ("Die Tuer sieht sehr stabil aus, aber sie ist geoeffnet, also kannst Du das Gebaeude vermutlich "
    "betreten."));
  AddDetail( ({ "tafel" }),
    ("Du kannst sie lesen."));
  AddReadDetail( ({ "tafel" }),
    ("______________________________________\n"
    "|                                      |\n"
    "|  Koeniglicher Gerichtshof Andracias  |\n"
    "|______________________________________|"));
  AddDetail( ({ "kuppel" }),
    ("Eine riesige, weisse Kuppel kroent das Gebaeude suedlich von Dir."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));



     AddExit( "westen", LUNIA_ROOM + "lunia_8d.lpc" );
     AddExit( "nordosten", LUNIA_ROOM + "lunia_7f.lpc" );
    AddExit( "sueden", LUNIA_ROOM + "lunia_9e.lpc" );
}



