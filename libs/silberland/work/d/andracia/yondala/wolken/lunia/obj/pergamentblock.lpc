#include "../def.h"
#include <moredef.h>
inherit "std/thing";
#include <properties.h>

int da = 5;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Pergamentblock");
  SetProp(P_LONG, "Ein kleiner Pergamentblock, von dem man einzelne Pergamente abreissen kann.\n");
  SetProp(P_NAME, "Pergamentblock");
  SetProp(P_GENDER, MALE);
  AddId(({"pergamentblock", "block" }));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 500);

  AddDetail( ({"pergamente" }),
    "Von diesem Pergamentblock kann man einzelne Pergamente abreissen um sich Notizen darauf zu machen. Es sind noch "+da+" Pergamente vorhanden.");
  AddDetail( ({"" }),
    "");

AddCmd(({"reiss", "reisse"}), "reissCmd");
}


reissCmd(string str)
{	 notify_fail( "Was moechtest Du wovon abreissen?\n" );
	if (str == "pergament ab"||str == "pergament von block"||str == "pergament von block ab"||str == "blatt von block"||str == "blatt von block ab"||str =="blatt ab")
{	if (da > 2)
		{
			write( "Du reisst ein Pergament vom Block ab.\n");
			say(TPN + " reisst ein Pergament vom einem Block ab.\n");
			da -=1;
			CLONE(LUNIA_OBJ + "zettel.lpc", TP);
    return 1;
	  }
	if (da ==2)
		{
			bswrite( "Du reisst das vorletzte Pergament vom Block ab, nun "
			"haelst Du zwei einzelne Pergamente in der Hand.\n");
			say(TPN + " trennt zwei Pergamente voneinander.\n");
			CLONE(LUNIA_OBJ+"zettel.lpc", TP);
			CLONE(LUNIA_OBJ+"zettel.lpc", TP);
			this_object()->remove();
    return 1;
	  }		
}
}
