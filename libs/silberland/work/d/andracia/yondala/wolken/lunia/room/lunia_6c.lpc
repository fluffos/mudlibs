/********************************************************************

Park fuer Seher, Eingangstor

********************************************************************/

#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

int offen;

void create() 
{
  ::create();
  offen=0;

  SetProp( P_INT_SHORT, "In einem Park" );
  SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten Park. "
  "Um Dich herum stehen praechtige Baeume, die Schatten spenden, der Rasen "
  "ist saftig gruen und in mehreren Beeten bluehen wunderschoene Blumen. "
  "Der Park ist von einer kleinen Hecke umgeben, um ihn vor unbefugtem "
  "Zutritt zu schuetzen.\nEin geschlossenes Toerchen.");
  SetProp( P_LIGHT, 1 );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  //AddItem(LUNIA_NPC + "tiger.lpc",REFRESH_DESTRUCT);
//noch was Neues machen, was nur im Park ist
//Kaninchen, Eichhoernchen, Gaense, per Zufall
//Gaensemama mit mit ihr folgenden Kinderkueken
  AddDetail( ({ "toerchen" }),
    "Das Toerchen ist geschlossen.");
  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "park" }),
    "Du stehst in einem wunderschoenen, gepflegten Park. "
  "Um Dich herum stehen praechtige Baeume, die Schatten spenden, der Rasen "
  "ist saftig gruen und in mehreren Beeten bluehen wunderschoene Blumen. "
  "Der Park ist von einer kleinen Hecke umgeben, um ihn vor unbefugtem "
  "Zutritt zu schuetzen.");
  AddDetail( ({ "baeume" }),
    "Es gibt verschiedene Laubbaeume, aber auch einige beschnittene "
	"Buchsbaeume.");
  AddDetail( ({ "laubbaeume" }),
    "Die Laubbaeume sind gesund und hoch gewachsen. Seltsamerweise liegt "
	"kein Laub unter ihnen.");
  AddDetail( ({ "laub" }),
    "Der Park ist wirklich sehr gepflegt, wenn jedes bisschen Laub gleich "
	"aufgesammelt wird, sobald es faellt.");
  AddDetail( ({ "schatten" }),
    "Die Baeume habe so ausladende Kronen, dass sie genuegend Schatten "
	"werfen.");
  AddDetail( ({ "kronen" }),
    "Die Kronen der Baeume sind hoch ueber Dir, sie sind satt gruen und "
	"sehr dicht.");
  AddDetail( ({ "rasen" }),
    "Der Rasen ist saftig gruen, die Kanten sind sauber geschnitten und Du "
	"glaubst, dass jeder Grashalm die selbe Laenge hat wie der Grashalm "
	"daneben.");
  AddDetail( ({ "kanten" }),
    "Unglaublich, wie akurat da jemand am Werk war.");
  AddDetail( ({ "werk" }),
    "Mit diesem Rasen hat jemand gute Arbeit geleiset.");
  AddDetail( ({ "arbeit" }),
    "Es ist sicher viel Arbeit, einen Rasen so zu pflegen.");
  AddDetail( ({ "grashalm", "grashalme" }),
    "Die Grashalme sind alle sauber auf die selbe Laenge gestutzt worden.");
  AddDetail( ({ "laenge" }),
    "Die Grashalme haben alle die selbe Laenge.");
  AddDetail( ({ "beete","blumenbeete" }),
    "Hin und wieder wird der Rasen von Blumenbeeten unterbrochen.");
  AddDetail( ({ "blumen" }),
    "Herrlich duftende Blumen bluehen in den Beeten am Rand des Weges.");
  AddDetail( ({ "rand" }),
    "Am Rand des Weges sind hin und wieder Blumenbeete.");
  AddDetail( ({ "buchsbaeume" }),
    "Die Buchsbaeume sind so beschnitten und getrimmt, dass sie "
	"unterschiedliche Formen haben.");
  AddDetail( ({ "formen" }),
    "Es gibt Kugeln, Quader, Kegel, Wuerfel und viele mehr.");
  AddDetail( ({ "kugeln","kegel","wuerfel","quader" }),
    "Das sind geometrische Formen.");
  AddDetail( ({ "zutritt" }),
    "Hier darf halt nicht jeder rein.");



	
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

  AddExit( "nordosten", LUNIA_ROOM + "lunia_5d.lpc" );

   AddCmd(({"oeffne"}),"oeffnen");
   AddCmd(({"schliesse","schliess"}),"schliessen");

 }

int schliessen(string str)
{
	notify_fail("Was moechtest Du schliessen?\n");
	if (str!="toerchen") return 0;

	if(!offen)write("Das Toerchen ist doch zu.\n");
	else
	  {
		RemoveExit("suedwesten");
        AddDetail( ({ "toerchen" }),
          "Das Toerchen ist geschlossen.");
        SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten "
		"Park. Um Dich herum stehen praechtige Baeume, die Schatten spenden, "
		"der Rasen ist saftig gruen und in mehreren Beeten bluehen "
		"wunderschoene Blumen. Der Park ist von einer kleinen Hecke umgeben, "
		"um ihn vor unbefugtem Zutritt zu schuetzen.\n"
		"Ein geschlossenes Toerchen.");	
		write("Du schliesst das Toerchen.\n");
	    say(TPN+" schliesst das Toerchen.\n",TP);
	    offen=0;
		call_other(LUNIA_ROOM+"lunia_7b.lpc","zu");
		}
  return 1;
}


int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if (str!="toerchen") return 0;

	if(offen)
	{
	   write("Das Toerchen ist doch schon auf.\n");
	   return 1;
	   }
	   
	if (!IS_SEER(TP)&&!present("zutrittserlaubnislunia",TP))  
	{
	   write("Du versuchst das Toerchen zu oeffnen.\n"+
	   "Eine Stimme raunt Dir zu: Komme wieder, wenn Du Seher bist!\n");
	   return 1;
	   }	
	   else
		{
			AddExit("suedwesten", LUNIA_ROOM+"lunia_7b.lpc");
			AddDetail( ({ "toerchen" }),
    		"Das Toerchen ist geoeffnet, Du kannst den Park problemlos verlassen.");

        SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten "
		"Park. Um Dich herum stehen praechtige Baeume, die Schatten spenden, "
		"der Rasen ist saftig gruen und in mehreren Beeten bluehen "
		"wunderschoene Blumen. Der Park ist von einer kleinen Hecke umgeben, "
		"um ihn vor unbefugtem Zutritt zu schuetzen.\n"
		"Ein geoeffnetes Toerchen.");	
			write("Du oeffnest das Toerchen.\n");
			say(TPN+" oeffnet das Toerchen.\n",TP);
			offen=1;
			call_other(LUNIA_ROOM+"lunia_7b.lpc","auf");
		}
	return 1;		
	
	}
	
void zu()//wird bei reset des anderen Raumes aufgerufen
{
  RemoveExit("suedwesten");
  AddDetail( ({ "toerchen" }),
    "Das Toerchen ist geschlossen.");
  SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten "
		"Park. Um Dich herum stehen praechtige Baeume, die Schatten spenden, "
		"der Rasen ist saftig gruen und in mehreren Beeten bluehen "
		"wunderschoene Blumen. Der Park ist von einer kleinen Hecke umgeben, "
		"um ihn vor unbefugtem Zutritt zu schuetzen.\n"
		"Ein geschlossenes Toerchen.");	    
		offen=0;
   tell_room(TO,"Das Toerchen faellt zu.\n");
   
	}

void auf()//wird vom anderen Raum aufgerufen
{
	AddExit("suedwesten", LUNIA_ROOM+"lunia_7b.lpc");
	AddDetail( ({ "toerchen" }),
      "Das Toerchen ist geoeffnet, Du kannst den Park verlassen.");
    SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten "
		"Park. Um Dich herum stehen praechtige Baeume, die Schatten spenden, "
		"der Rasen ist saftig gruen und in mehreren Beeten bluehen "
		"wunderschoene Blumen. Der Park ist von einer kleinen Hecke umgeben, "
		"um ihn vor unbefugtem Zutritt zu schuetzen.\n"
		"Ein geoeffnetes Toerchen.");	
	offen=1;
	tell_room(TO,"Das Toerchen wird von der anderen Seite geoeffnet.\n");
	offen=1;
}
