/********************************************************************

Statue von Aginor
Hier kann man einen Stern druecken um das Sehertor zu bekommen
Wenn es der dritte Stern ist, bekommt man das Tor und 50 SP

****************************************************************************/


#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>


void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Eine grosse Statue steht hier.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "tiger.lpc",REFRESH_DESTRUCT);
//  gedrueckt=0;
  AddDetail( ({ "statue" }),
    ("Die Statue besteht aus pechschwarzem Obsidian. Sie stellt einen Mann "
	 "dar und obwohl Du ihm -zum Glueck- noch nie begegnet bist, bist Du Dir "
	 "sehr sicher, dass es sich um Aginor, dem Herrn der Finsternis handelt."));
  AddDetail( ({ "obsidian" }),
    ("Der Obsidian ist unglaublich schwarz. Es ist, als wuerdest Du in das "
	 "Nichts selbst blicken. Ausserdem ist er hervorragend bearbeitet worden, "
	 "Du siehst keinerlei Kratzer oder andere Bearbeitungsspuren."));
  AddDetail( ({ "nichts" }),
    ("Es ist unfassbar dunkel. Es spiegelt sich nicht mal etwas darin."));
  AddDetail( ({ "kratzer","bearbeitungsspuren","spuren" }),
    ("Du siehst keine. Wer wuerde es auch wagen, so etwas auf der Statue "
	"Aginors zu hinterlassen?"));
  AddDetail( ({ "glueck" }),
    ("Man munkelt, dass nur wenige ein Zusammentreffen mit Aginor ueberlebt haben."));
  AddDetail( ({ "zusammentreffen","treffen" }),
    ("Das blieb Dir bisher wohl erspart, immerhin lebst Du noch."));
  AddDetail( ({ "mann","aginor", "herr" }),
    ("Aginor steht als schwarze Statue vor Dir. Es wirkt, als starre er Dir "
	"genau in die Augen. Sein schwarzer Umhang scheint im Wind zu wehen, "
	"seine Haende sind zu Faeusten geballt. Um den Hals traegt er ein Medaillon."));
  AddDetail( ({ "augen" }),
    ("Die Augen Aginors sind dunkel. Sie starren Dich finster und durchdringend an. "
	"Du schauderst."));
  AddDetail( ({ "finsternis" }),
    ("Die Statue ist so finster, wie die Finsternis, die Aginor beherrscht."));
  AddDetail( ({ "wind" }),
    ("Hier weht kein Wind und die Statue ist nur so dargestellt, wegen des "
	"dramatischen Effekts."));
  AddDetail( ({ "effekt" }),
    ("Der Effekt ist gelungen."));
  AddDetail( ({ "umhang" }),
    ("Der Umhang Aginors ist schwarz und wallend, er bedeckt die Statue fast komplett, "
	"nur der Kopf, die Fuesse und die Haende sind von Aginor zu sehen."));
  AddDetail( ({ "haende" }),
    ("Die Haende Aginors sind zu Faeusten geballt. Mit einer haelt er seinen Umhang fest, "
	"die andere ist leer."));
  AddDetail( ({ "faeuste" }),
    ("Aginors Faeuste sind geballt. In einer Faust haelt er seinen Umhang fest."));
  AddDetail( ({ "faust" }),
    ("Meinst Du die rechte, oder die linke?"));
  AddDetail( ({ "rechte faust" }),
    ("Die ist geballt."));
  AddDetail( ({ "linke faust" }),
    ("Mit der linken Faust haelt er ein Stueck seines Umhangs."));
  AddDetail( ({ "stueck" }),
    ("Nein, Moment, das ist gar kein Stueck seines Umhangs. Das scheint ein separates "
	"Stueck Stoff zu sein."));
  AddDetail( ({ "moment" }),
    ("Nimm Dir einen Moment und forsche hier gut weiter, koennte wichtig sein."));
  AddDetail( ({ "stoff" }),
    ("Der Stoff sieht ganz anders aus als der Umhang. Obwohl er auch aus Obsidian "
	"besteht, hat er eine ganz andere Struktur."));
  AddDetail( ({ "struktur" }),
    ("Gerippt, oder einfach angeflauscht. Sie wirkt weich und kuschelig. Fast, wie "
	"eine Decke."));
  AddDetail( ({ "decke" }),
    ("Ja, vermutlich eine Decke. Waehrend Du Dich noch fragst, warum Aginors Statue eine "
	"Decke in der Hand haelt, faellt Dir die huebsche Stickerei auf, die sich am Rand "
	"befindet."));
  AddDetail( ({ "rand" }),
    ("Der Rand der Decke ist mit einer huebschen Stickerei verziert."));
  AddDetail( ({ "stickerei" }),
    ("Es scheint sich um kleine Sterne zu handeln."));
  AddDetail( ({ "sterne" }),
    ("Die Sterne scheinen aus einem anderen Material zu bestehene, deswegen sieht man "
	"sie so gut. Sie wurden fast nahtlos eingepasst. Einer von ihnen funkelt ein bisschen "
	"mehr als die anderen."));
  AddDetail( ({ "material" }),
    ("Wenn Dich nicht alles taeuscht, sind die Sterne auf der Decke aus Turmalin gefertigt."));
  AddDetail( ({ "turmalin" }),
    ("Solange Dir niemand etwas anderes beweisst, sind sie fuer Dich aus gruenschwarzem Turmalin."));
  AddDetail( ({ "stern" }),
    ("Der eine Stern, steht etwas hervor. Rausziehen kann man ihn wohl nicht, aber so sieht es "
	"auch irgendwie unperfekt aus, weil einer rausguckt, die anderen nicht. Was kann man da nur tun?"));
  AddDetail( ({ "hals" }),
    ("Um den Hals der Statue haengt ein goldenes Medaillon."));
  AddDetail( ({ "medaillon" }),
    ("Es ist nicht wirklich aus Gold. Aber es sieht so aus."));
  AddDetail( ({ "gold" }),
    ("Das Medaillon koennte aus Gold sein, hier ist es aber aus Obsidian, wie fast die ganze Statue."));
  AddDetail( ({ "kopf" }),
    ("Hoch ueber Dir ragt der Kopf Aginors auf seinen finsteren Schultern. Mit ebenso finsterem "+
	"Blick starrt er Dich an."));
  AddDetail( ({ "blick" }),
    ("Gruselig. Gut, dass es nicht der echte Aginor ist."));
  AddDetail( ({ "schulter" }),
    ("Die starken Schultern Aginors malen sich breit und muskuloes unter dem Umhang ab."));
  AddDetail( ({ "fuesse" }),
    ("Fest stehen die grossen Fuesse Aginors auf ihrem Sockel."));
  AddDetail( ({ "sockel" }),
    ("Darauf steht die Statue. Ein Schild wurde daran angebracht."));
  AddDetail( ({ "schild" }),
    ("Das Schild besteht aus Metall. Du kannst es lesen."));
  AddReadDetail( ({ "schild" }),
    ("***************************************\n"+
	"*     Unser Schoepfer Lord Aginor,     *\n"+
	"* moege er uns stets wohlgesonnen sein.*\n"+
	"****************************************\n"));
  AddDetail( ({ "schoepfer" }),
    ("Oha, wer mag denn sowas geschrieben haben?"));
  AddDetail( ({ "lord" }),
    ("Dass Aginor, Yondala und Yason gemeinhin als Lords beziehungsweise Lady bezeichnet werden, "+
	"ist Dir ja bekannt."));
  AddDetail( ({ "metall" }),
    ("Einfaches, normales Metall. Rostfrei."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));

  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

   AddCmd( ({"druecke", "drueck"}), "cmd_druecken" );  
  
   AddExit( "nordwesten", LUNIA_ROOM + "lunia_2f.lpc" );
   AddExit( "sueden", LUNIA_ROOM + "lunia_4g.lpc" );

}

int cmd_druecken(string str)
{
	// keine fehlermeldung damit keiner so schnell drauf kommt
	if( str!="stern" ) return 0;
	

	if(query_wiz_level(TP)>0)
	{
		// write( "Du bist kein normaler Spieler.\n" );
		 if(present("\nstern_2b", TP)&&present("\nstern_8d",TP))
		 {
			 write( "Du fuehlst Dich von Magie durchflutet und spuerst, dass sich in Deiner Naehe etwas veraendert hat.\n" );
			 TP->AddSp(50);
			 call_other( "/obj/sehertormaster", "DiscoverDoor","/d/andracia/yondala/wolken/lunia/room/lunia_5d"); 
			 present("\nstern_2b", TP)->remove();
			 present("\nstern_8d", TP)->remove();
			 return 1;
		 }
		 else if(!present("stern_3g",TP)) CLONE(LUNIA_OBJ +"stern_3g.lpc", TP);
			 
	}
     write( "Du drueckst auf den Stern aber nichts passiert.\n" );   
	 //gedrueckt= 1;
	return 1;
}
