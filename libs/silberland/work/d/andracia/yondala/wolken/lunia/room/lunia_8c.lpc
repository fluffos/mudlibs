#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Suedlich von Dir geht der Boden in eine dicke Bauschwolke ueber.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );


  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus makellosen weissen Marmorplatten, die nahtlos ineinander uebergehen. "
    "Suedlich von Dir wird er aber nach und nach zu einer dicken Wolke."));

  AddDetail( ({ "wolke","bauschwolke" }),
    ("Im Sueden wandelt sich der Boden langsam zu einer dicken Bauschwolke."));
  AddDetail( ({ "sueden" }),
    ("Im Sueden ist maechtig was los. Staendig landen und starten seltsame Dinge und einige Leute "
    "laufen dort herum."));
  AddDetail( ({ "dinge" }),
    ("Es sind mal grosse, mal kleinere Dinge in unterschiedlichsten Formen. Manche sind abstrakt, andere "
	"sehen aus wie Lebewesen. Geh doch nach Sueden, wenn Du mehr erkennen willst"));
  AddDetail( ({ "formen" }),
    ("Manche sind rund, andere eckig. Andere kann man geometrisch nicht zuordnen."));
  AddDetail( ({ "leute" }),
    ("Im Sueden sind einige Leute, die auf oder von seltsamen Dingen klettern."));
  AddDetail( ({ "lebewesen" }),
    ("Hier sind einige Leute, die man durchaus als Lebewesen bezeichnen koennte, Dich eingeschlossen. "));
  AddDetail( ({ "sueden" }),
    ("Dort warst Du bestimmt schonmal, oder?"));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));

  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

     AddExit( "nordwesten", LUNIA_ROOM + "lunia_7b.lpc" );
     AddExit( "osten", LUNIA_ROOM + "lunia_8d.lpc" );
     AddExit( "sueden", LUNIA_ROOM + "lunia_9c.lpc" );
}


