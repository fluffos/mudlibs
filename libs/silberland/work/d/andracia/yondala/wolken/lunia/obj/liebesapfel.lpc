inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Liebesapfel");
  SetProp(P_LONG,
    "Du siehst einen leuchten roten, zuckersuessen Liebesapfel." );
  SetProp(P_NAME, "Liebesapfel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_FOOD_INFO, ([F_SOAK:20, 
											 F_HEAL:({10,10}), // erst HP, MP
											 F_MSG: "Du lutscht und kaust den Liebesapfel mit Stumpf und Stiel.", 
											 F_MSG_ROOM: "verspeisst einen Liebesapfel."]));


  AddId("liebesapfel","apfel");

  SetProp(P_MATERIAL, ({MAT_FRUIT, MAT_SUGAR}));
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 260);
  call_out("fall",300); 
}

void fall()
{ 
	write("Der Liebesapfel klebt an Deinen Fingern, als du versuchst ihn zu loesen faellt er Dir runter.\n");     
	say(TPN+" laesst einen Liebesapfel fallen.\n");
	this_object()->remove();
	}
