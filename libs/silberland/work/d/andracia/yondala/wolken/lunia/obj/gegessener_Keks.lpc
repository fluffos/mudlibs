inherit "/std/food";
#include <moredef.h>
#include <properties.h>
#include <food.h>




void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein aufgegessener Keks");
  SetProp(P_LONG,
    "Da hast Du wirklich nichts, aber auch rein gar nichts, was Du sehen koenntest." );
  AddAdjective("klein");
  SetProp(P_NAME, "Keks");
  SetProp(P_GENDER, MALE);
  SetProp(P_FOOD_INFO, ([F_SOAK:0, F_HEAL:({0,0}), // erst HP, MP
	F_MSG: "Du steckst Dir nichts in den Mund und erhaelst ... nichts.", 
	F_MSG_ROOM: "isst nichts."]));


  AddId(({"keks"}));

  SetProp(P_MATERIAL, ({MAT_FRUIT}));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 100);
 

 
}