inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine handvoll Popcorn");
  SetProp(P_LONG,
    "Du siehst eine handvoll klebrigen Popcorns." );
  SetProp(P_NAME, "Popcorn");
  SetProp(P_GENDER, NEUTER);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:10, 
											 F_HEAL:({10,10}), // erst HP, MP
											 F_MSG: "Du knabberst das ganze Popcorn weg.", 
											 F_MSG_ROOM: "knabbert eine handvoll Popcorn."]));


  AddId("popcorn");
  SetProp(P_MATERIAL, ({MAT_MISC_FOOD, MAT_SUGAR}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 200);
 
}

