#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

int beere;

void reset()
{
	beere=3;

	::reset();
	}
void create() 
{
  ::create();
beere=3;
  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Nach Norden kannst Du ein Haus betreten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "bauchladenhalbling.lpc",REFRESH_DESTRUCT);



  AddDetail( ({ "haus","norden" }),
    ("Im Norden steht ein weisses Haus. Es ist recht niedrig und kreisrund. Du kannst es betreten."));

  AddDetail( ({ "buesche" }),
    ("Du siehst ein paar Buesche die voller saftiger Beeren haengen."));
  AddDetail( ({ "beeren" }),
    ("Hmm, sehen die lecker aus."));
 
 
  AddExit( "suedwesten", LUNIA_ROOM + "lunia_2b.lpc" );
  AddExit( "osten", LUNIA_ROOM + "lunia_1d.lpc" );
  AddExit( "norden", LUNIA_ROOM + "lunia_0c.lpc" );
  AddCmd( ({ "iss","esse", "pfluecke","pflueck" }), "pfluecken" );

}

int pfluecken(string str)
{
	if(str=="beere"||str=="beeren")
		{
			if(!beere)
			{
				write("So viele Beeren sind nicht mehr da. Lass den anderen auch noch welche!\n");
				return 1;
			}
				write("Du pflueckst ein paar Beeren und steckst sie Dir gleich in den Mund.\n");
			say(TPN+ " pflueckt ein paar Beeren und isst sie.\n");
			beere--;
		}
	else
		write ("Was moechtest Du pfluecken?\n");
		
		return 1;
}

