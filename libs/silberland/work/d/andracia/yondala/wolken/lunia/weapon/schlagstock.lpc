#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Schlagstock");
  SetProp(P_LONG,
    "Du siehst einen glatten, schwarzen Schlagstock." );
  SetProp(P_NAME, "Schlagstock");
  SetProp(P_GENDER, MALE);
  AddId( ({"schlagstock", "stock"}) );
                                    

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 45 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_EBONY );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 350);
  SetProp(P_QUALITY_DECAY, 100);
  
/*  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );*/

  SetProp(P_WC_BONUS, (["GENDARM": 150]) );
  
}
