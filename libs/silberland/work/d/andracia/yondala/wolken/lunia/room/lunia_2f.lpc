//eventuell hier nen Zaubertrank bei "ritze"
#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

int da;

void reset()
{
	da=1;
  AddDetail( ({ "wasser","" }),
    ("Im Wasser schwimmt eine kleine Feder."));
  AddDetail( ({ "feder","" }),
    ("Du koenntest versuchen, sie aus dem Wasser zu fischen."));
	
	::reset();
	}

void create() 
{
  ::create();
	da=1;
  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Nordoestlich von Dir steht ein imposantes Gebaeude. Eine kleine Vogeltraenke wurde hier aufgestellt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "vogeltraenke","traenke" }),
    ("Die Vogeltraenke besteht aus einer Saeule und einer grossen flachen Schale."));
  AddDetail( ({ "saeule","" }),
    ("Die Saeule ist etwa huefthoch und hat Laengstrillen vom Fuss bis hoch zu der Stelle "
    "an der die Schale befestigt ist."));
  AddDetail( ({ "laengstrillen","rillen" }),
    ("Die Laengstrillen ziehen sich ueber die ganze Saeule. Das macht sie stabiler."));
  AddDetail( ({ "fuss","" }),
    ("Die Saeule der Vogeltraenke steht auf einem grossen, runden Fuss, welcher in einem fast "
    "makellosem Weiss erstrahlt."));
  AddDetail( ({ "weiss","" }),
    ("Wie so vieles hier ist auch die Vogeltraenke aus weissem Marmor."));
  AddDetail( ({ "makel","" }),
    ("Du siehst eine kleine Ritze im Fuss der Vogeltraenke."));
  AddDetail( ({ "ritze","" }),
    ("Du kratzt ein bisschen in der Ritze, aber passieren tut nicht wirklich etwas, oder?"));
  AddDetail( ({ "stelle","" }),
    ("An einer Stelle an der Vogeltraenke geht die Saeule nahtlos in die Schale mit dem Wasser ueber."));
  AddDetail( ({ "naht","" }),
    ("Nahtlos bedeutet, dass da keine Naht ist. Aber schoen, dass Du so clever forschst. Hast Du "
    "denn den Zaubertrank in diesem Raum schon gefunden?"));
  AddDetail( ({ "zaubertrank","versuch" }),
    ("Netter Versuch ;o)"));
  AddDetail( ({ "wasser","" }),
    ("Im Wasser schwimmt eine kleine Feder."));
  AddDetail( ({ "schale","" }),
    ("Die Schale ist ebenmaessig rund und mit herrlich klarem Wasser gefuellt."));
  AddDetail( ({ "feder","" }),
    ("Du koenntest versuchen, sie aus dem Wasser zu fischen."));
  AddDetail( ({ "","" }),
    ("."));
  AddRoomMessage( 
    ({"Ein kleines Voeglein landet in der Traenke, waescht sich und flattert davon.\n"}),50);


     AddExit( "suedosten", LUNIA_ROOM + "lunia_3g.lpc" );
     AddExit( "nordwesten", LUNIA_ROOM + "lunia_1e.lpc" );
     AddExit( "nordosten", LUNIA_ROOM + "lunia_1g.lpc" );
     AddCmd( ({ "fische","fisch"}), "fischen" );
     AddCmd( ({ "trinke","trink"}), "trinken" );
}

int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(str=="wasser"||str=="aus traenke"||str=="wasser aus traenke"||str=="wasser aus vogeltraenke"||str=="aus vogeltraenk")
	{
		write("Das Wasser ist fuer die Voegel da, lass es ihnen.\n");
		return 1;
	}
	return 0;
}
int fischen(string str)
{
	if(str=="feder"||str=="feder aus wasser"||str=="feder aus schale")
		{
			if(da==1)
				{
					write("Du greifst ins Wasser und fischst die Feder aus der Schale.\n");
					say(TPN+ " greift ins Wasser und fischt eine Feder heraus.\n");
				  AddDetail( ({ "wasser","" }),
				    ("Das Wasser sieht herrlich erfrischend aus."));
				  RemoveDetail("feder");
				  CLONE("/d/andracia/yondala/wolken/lunia/obj/feder.lpc", TP);
				  da=0;
				}
				else write("Was fuer eine Feder? Hier ist keine.\n");
		}
	else
		write ("Was moechtest Du woraus fischen?\n");
		
		return 1;
}
