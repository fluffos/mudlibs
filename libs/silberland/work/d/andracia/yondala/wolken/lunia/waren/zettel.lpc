//#include "../def.h"
#include <moredef.h>
inherit "std/thing";
#include <properties.h>

string was;
string wer;
string aktStr;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
was=0;
wer=0;
  SetProp(P_SHORT, "Ein Stueckchen Pergament");
  SetProp(P_LONG, "Ein Stueck Pergament, welches man beschriften kann.\n");
  SetProp(P_INFO, "Auf diesem Stueck Pergament kann man eine Nachricht notieren " 
  "<notiere 'text'> und auch wieder entfernen <entferne notiz>.\nAusserdem kann man die " 
  "Handschrift des Geschriebenen untersuchen und so den Verfasser der Notizen herausbekommen.");
  SetProp(P_NAME, "Pergament");
  SetProp(P_GENDER, NEUTER);
  AddId("pergament" );

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 100);


  AddSpecialDetail( ({ "handschrift"  }), "handschrift" );

AddCmd(({"notiere", "notier"}), "notierenCmd");
AddCmd(({"entferne", "entfern"}), "entfernenCmd");
AddCmd(({"zerreisse"}), "zerreissenCmd");
}



notierenCmd(string str)
{	 notify_fail( "Was moechtest Du notieren?\n" );
		str = this_player()->_unparsed_args();
		if (!str)
		return 0;
			
	if (!was)
		{
			write( "Du machst eine Notiz auf dem Pergament.\n");
	    say(TPN + " notiert etwas auf einem Stueck Pergament.\n");
	    was = str;
	    wer = TPN;
	    AddReadDetail( ({ "pergament" }),
    		"Auf dem Pergament steht: \n"+str);
	  }
	else
		write ("Das Pergament ist schon voll.\n");
	return 1;
	}



	
		
entfernenCmd(string str)
{	 notify_fail( "Was moechtest Du entfernen?\n" );
	if (str == "notizen"||str =="notiz")
			write( "Du entfernst saemtliche Notizen von dem Pergament.\n");
	    was = 0;
	    wer = 0;
	    AddReadDetail( ({ "pergament" }),
    		"Das Pergament ist nicht beschriftet.");	    
    		return 1;
}


string handschrift()
{ 
	if(!wer)
		return("Das Pergament ist nicht beschrieben.\n");
	  
	if (TPN == wer)
	 return("Du selbst scheinst der Urheber dieser Notizen zu sein.\n");
	
	return("Die Schrift auf dem Pergament scheint von " + wer + " zu stammen.\n");

	}
	
zerreissenCmd(string str)
{	 notify_fail( "Was moechtest Du zerreissen?\n" );
	if (str != "pergament")return 0;
	
	write( "Du zerreisst das Pergament in viele kleine Schnipsel.\n");
	say(TPN + " zerreisst ein Stueck Pergament in viele kleine Schnipsel.\n");			
	this_object()->remove();
	return 1;
}