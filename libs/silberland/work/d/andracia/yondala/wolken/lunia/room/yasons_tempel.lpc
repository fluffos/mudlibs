// 06.03.2012 - Yondala@SilberLand: Alte Datei von Yason gefunden und angehangen

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Yasons Tempel" );
  SetProp( P_INT_LONG, BS(
    "Dies ist Yasons Tempel. Marmorne Saeulen tragen eine hohe helle Decke. "+ 
    "Die Waende sind schlicht und in einem beigen Farbton. In der Mitte des Raums "+
    "steht eine kurze Saeule auf deren oberen Flaeche ein Scheisshaufen gelegt wurde. "+
    "Zwei steinerne Tafeln wurden davor aufgestellt in die laengere Texte in einer "+
    "fremden Sprache eingemeisselt wurden. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "tafel 1", "tafel 2", "tafel" }),
    BS("Versuch doch einfach, ob Du die Tafel lesen kannst."));

  AddReadDetail( ({ "tafel" }), "Welche Tafel willst Du lesen? Die erste oder die zweite? \n" );

  AddReadDetail( ({ "tafel 1", "erste tafel" }),
    BS("Once upon a time at the foot of a shit mountain, there was a town "+
    "where the people known as Happyfolk lived, their very existence a mystery "+
    "to the rest of the world, obscured as it was by shit clouds. Here they "+
    "played out their peaceful lives, innocent of the litany of excess and "+
    "violence that was growing in the world below. To live in harmony with the "+
    "spirit of the mountain called Monkey was enough. Then one day Strangefolk "+
    "arrived in the town. They came in camouflage, hidden behind dark glasses, "+
    "but no one noticed them: they only saw shadows. You see, without the Truth "+
    "of the Eyes, the Happyfolk were blind. "));

  AddReadDetail( ({ "refrain 1"}),
    "Falling out of aeroplanes and hiding out in holes \n"+
    "Waiting for the sunset to come, people going home \n"+
    "Jump back from behind them and shoot them in the head \n"+
    "Now everybody dancing the dance of the dead, \n"+
    "the dance of the dead, \n"+
    "the dance of the dead \n ");

  AddReadDetail( ({ "tafel 2", "zweite tafel" }),
    BS("In time, Strangefolk found their way into the high reaches of the "+
    "mountain, and it was there that they found the caves of unimaginable "+
    "Sincerity and Beauty. By chance, they stumbled upon the Place Where All Good "+
    "Souls Come to Rest. The Strangefolk, they coveted the jewels in these caves "+
    "above all things, and soon they began to mine the mountain, its rich seam "+
    "fueling the chaos of their own world. Meanwhile, down in the town, the "+
    "Happyfolk slept restlessly, their dreams invaded by shadowy figures digging "+
    "away at their souls. Every day, people would wake and stare at the mountain. "+
    "Why was it bringing darkness into their lives? And as the Strangefolk mined "+
    "deeper and deeper into the mountain, holes began to appear, bringing with "+
    "them a cold and bitter wind that chilled the very soul of them up. For the "+
    "first time, the Happyfolk felt fearful for they knew that soon the Monkey "+
    "would soon stir from its deep sleep. And then came a sound. Distant first, "+
    "it grew into castrophany so immense it could be heard far away in space. There "+
    "were no screams. There was no time. The mountain called Monkey had spoken. "+
    "There was only fire. And then, nothing. "));

  AddReadDetail( ({ "refrain 2" }),
    "O little town in U.S.A, your time has come to see \n"+
    "There's nothing you believe you want \n"+
    "But where were you when it all came down on me? \n"+
    "Did you call me now? \n");
    
  AddReadDetail( ({ "index" }),
    BS("Fire Coming Out Of A Monkey's Head"));

  AddDetail( ({ "tempel", "raum", "raums", "halle" }),
    BS("Dieser Tempel scheint eine schlechte Kopie des griechischen Olymps zu sein. "+
    "Seine allgemeine Form ist oval und die Saeulen sind rund herum angeordnet. In "+
    "der Mitte des Raums steht eine kurze Saeule mit zwei Steintafeln davor. Auf der "+
    "kurzen Saeule liegt ein Scheisshaufen. " ));
  AddDetail( ({ "marmor", "marmorne" }),
    BS("Die Waende, der Boden und die Saeulen sind aus einem Beigen Marmor. Helle und "+
    "dunklere Schlieren durchziehen den Marmor. Der Tempel wirkt dadurch zwar sehr hell "+
    "aber auch besonders kuehl. "));
  AddDetail( ({ "saeule", "saeulen" }),
    BS("Rund um den Raum stehen hohe Saeulen die die hohe Decke tragen. Sie sind aus "+
    "demselben beigen Marmor wie Boden und Waende. Ihre Oberflaeche ist besonders glatt "+
    "und am Boden fusst die Saeule auf einer quaderfoermigen Basis. Das Kapitell hoch "+
    "oben an an der Decke kannst Du nur schwer erkennen, glaubst aber auch, dass dort einen "+
    "einfacher Quader den Abschluss bildet." ));
  AddDetail( ({ "decke" }),
    BS("Hoch ueber Dir kannst Du die Decke erkennen wie sie von den Saeulen gestuetzt wird. "+
    "Durch ein kreisrundes Loch in der Mitte der Decke dringt ein heller Lichtstrahl der "+
    "sich in der Weite der Halle verliert. "));
  AddDetail( ({ "wand", "waende" }),
    BS("Die Waende die den Raum kurz hinter den Saeulen sind auch aus dem beigen Marmor. "+
    "Das Licht das zwischen den Saeulen hindurch auf die Wand faellt bildet eine schoenes "+
    "Muster von hell und dunkel. Bis auf den Ausgang hinaus auf den Weg durch Lunia bildet "+
    "die Wand ein perfekte Flaeche ohne Fugen. "));
  AddDetail( ({ "farbe", "farbton", "beige" }),
    BS("Der Marmor scheint ein helles beige zu haben. Mit den Lichtverhaeltnissen hier und "+
    "den hellen und dunklen Schlieren des Gesteins bildet sich ein kuehles Ambiente."));
  AddDetail( ({ "mitte" }),
    BS("Eine kurze Saeule steht hier. Ein Scheisshaufen liegt darauf und zwei schwere "+
    "Steintafeln stehen davor. "));
  AddDetail( ({ "flaeche" }),
    BS("Die obere Flaeche der kurzen Saeule ist fast vollstaendig mit der Scheisse bedeckt. "));
  AddDetail( ({ "scheisshaufen", "scheisse", "haufen" }),
    BS("Wenn man genau hinsieht, erkennt man am Rand der Scheisse ein kleines Miniaturdorf "+
    "mit ganz kleinen zweibeinigen Wesen die wohl dort wohnen."));
  AddDetail( ({ "stein", "steine" }),
    BS("Die Tafeln sind aus einem grauen Stein mit gemeisselten Buchstaben einer fremden "+
    "Sprache darauf. Scheinbar Granit, was es dem Schreiber der Buchstaben besonders schwer "+
    "gemacht hat in den widestandsfaehigen Fels die Graeben zu meisseln. "));
  AddDetail( ({ "sprache", "sprachen" }),
    BS("Beim Betrachten der Buchstaben glaubst Du dass die Sprache 'Englisch' ist."));
  AddDetail( ({ "geheimnis" }),
    BS("Das Geheimnis liegt in den beiden Refrain und im Zweifelsfall kann man ja auch den Index lesen. "));
      
  AddSound( DEFAULT_SOUND,
    "Rhytmische Klaenge erfuellen den Raum. Hin und wieder hoerst Du ein leises Summen\n");

  AddSound( ({ "klaenge", "musik" }),
    BS("Sphaerische und rhytmische Klaenge erfuellen den Raum. "));
  AddSound( ({ "summen" }),
    BS("Das Summen klingt wie das Summen einer Fliege. "));
  AddSound( ({ "fliege" }),
    BS("Ja, es wird wohl eine Fliege sein, die hier rumsummt. "));

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach gar nichts. \n");
  AddExit( "osten", LUNIA_ROOM + "lunia_4a.lpc" );
  
  //Ab hier von Yondala eingefuegte Details	
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus grauem Marmor. Man sieht zwar bereits, dass hier "+
	"oft jemand lang geht, dennoch ist er sehr sauber und gepflegt.");
  AddDetail( ({ "lichtstrahl","strahl" }),
    "Erst dringt der Lichtstrahl kompakt durch das Loch, dann verliert er "
	"sich im Raum, sodass er nicht den Boden beruehrt.");
  AddDetail( ({ "loch" }),
    "Das Loch in der Decke ist wohl ein kreisrundes Fenster. Es ist derzeit "
	"aufgestellt, sodass nicht nur Licht, sondern auch Luft herein kommt.");
  AddDetail( ({ "fenster" }),
    "An der Decke befindet sich ein kreisrundes Fenster, durch das Licht und "
	"Luft hereinstroemen.");
  AddDetail( ({ "luft" }),
    "Die Luft hier ist frisch und klar.");
  AddDetail( ({ "weite" }),
    "Die grosse Halle, in der Du Dich befindest, ist sehr weit.");
  AddDetail( ({ "licht", "lichtverhaeltnisse" }),
    "Durch die Tuer und durch das Fenster in der Decke stroemt einiges an Licht "
	"in den Raum.");
  AddDetail( ({ "ambiente" }),
    "Das Ambiente hier ist recht kuehl, so, wie Yason es gern hat.");
  AddDetail( ({ "yason" }),
    "Yason ist gerade nicht hier.");
  AddDetail( ({ "gestein" }),
    "Marmor ist eine Gesteinsart.");
  AddDetail( ({ "gesteinsart" }),
    "Deren gibt es mehrere, Marmor ist eine davon und daraus besteht dieser Tempel.");
  AddDetail( ({ "schlieren" }),
    "Natuerliche Schlieren durchziehen den Marmor, aus dem hier fast alles ist.");
  AddDetail( ({ "steintafeln" }),
    "Die Tafeln sind aus normalem Stein. Du kannst sie lesen.");
  AddDetail( ({ "form" }),
    "Die Form des Raumes, in dem Du Dich befindest, ist oval, wie ein langezogener Kreis.");
  AddDetail( ({ "kreis" }),
    "o");
  AddDetail( ({ "kopie" }),
    "Es handelt sich bei diesem Tempel nicht um das Original.");
  AddDetail( ({ "original" }),
    "Das Original steht woanders. Der hier ist nachgemacht. Und das nicht sonderlich gut.");
  AddDetail( ({ "olymp" }),
    "Ob Du den mal finden wirst? Man munkelt, dass er irgendwo in diesem Land ist.");
  AddDetail( ({ "land","andracia" }),
    "Dieses Land heisst Andracia.");
  AddDetail( ({ "abschluss" }),
    "Danach kommt nichts mehr.");
  AddDetail( ({ "basis" }),
    "Die Saeulen haben eine quaderfoermige Basis.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche ist stets das, was man zuerst sehen kann.");
  AddDetail( ({ "buchstaben" }),
    "Die einzelnen Buchstaben kennst Du, nur deren Zusammenstellung ist Dir hier fremd.");
  AddDetail( ({ "zusammenstellung" }),
    "Die Buchstaben sind zu einer fremden Sprache zusammengestellt.");
  AddDetail( ({ "quader" }),
    "So wie ein Wuerfel.");
  AddDetail( ({ "wuerfel" }),
    "Ein Wuerfel hat charakteristisch sechs Seiten, die alle gleich sind.");
  AddDetail( ({ "seiten" }),
    "Alle Seiten eines Wuerfels und auch dieses Quaders sind gleich.");
  AddDetail( ({ "dorf","miniaturdorf" }),
    "Sieht irgendwie sehr realistisch aus.");
  AddDetail( ({ "rand" }),
    "Wenigstens nicht mittig, trotzdem bestimmt nicht so schoen dort.");
  AddDetail( ({ "betrachten","betrachtung" }),
    "Wenn Du die Betrachtung betrachtest, betrachtet die Betrachtung auch "
	"Dich. Schon mal darueber nachgedacht?");
  AddDetail( ({ "englisch" }),
    "Eine recht einfach Sprache. Dennoch musst Du nicht zwingend lesen, was dort steht, da ist kein Forscherpunkt, versprochen.");
  AddDetail( ({ "forscherpunkt" }),
    "Wirklich, das waere ja unfair.");
  AddDetail( ({ "texte","text" }),
    "Du kannst die Texte auf den Tafeln lesen.");
  AddDetail( ({ "ausgang","tuer", "osten" }),
    "Nach Osten kannst Du den Tempel verlassen.");
  AddDetail( ({ "lunia" }),
    "Dieser Tempel steht in Lunia, der Hauptstadt Andracias. ");
  AddDetail( ({ "hauptstadt" }),
    "Lunia ist die Hauptstadt Andracias.");
  AddDetail( ({ "fugen" }),
    "Es wurde so ordentlich gearbeitet, dass Du keine siehst.");
  AddDetail( ({ "kapitell" }),
    "So nennt man den Abschluss einer Saeule.");
  AddDetail( ({ "muster" }),
    "Das Licht zeichnet zwischen den Saeulen ein schoenes, nicht konkretes Muster an die Waende.");
  AddDetail( ({ "weg" }),
    "Du gelangst zurueck auf den Weg, wenn Du durch die Tuer im Osten gehst.");
  AddDetail( ({ "wesen" }),
    "Sie sind so klein, dass Du nicht erkennen kannst, welche Rasse es ist.");
  AddDetail( ({ "rasse" }),
    "Vielleicht ist es ja eine eigene, winzigkleine Rasse, die Du noch nicht kennst?");
  AddDetail( ({ "granit","fels" }),
    "Granit ist ein sehr harter Fels.");
  AddDetail( ({ "graeben" }),
    "Die Buchstaben bestehen aus kleinen Graeben, die in den Granit gemeisselt wurden.");
  AddDetail( ({ "schreiber" }),
    "Der Schreiber muss stark und ausdauernd gewesen sein. Wahrscheinlich waren ihm "
	"die Texte sehr wichtig, dass er sie so verewigt hat.");
  AddDetail( ({ "fliege" }),
    "Du folgst dem Summen und entdeckst tatsaechlich eine kleine Fliege, die aufgeregt um den Scheisshaufen herum fliegt.");
  AddDetail( ({ "" }),
    "");
	
  AddSound( ({ "summen" }),
    BS("Das Summen klingt wie das Summen einer Fliege. "));
  AddSound( ({ "fliege" }),
    BS("Ja, es wird wohl eine Fliege sein, die hier rumsummt. "));
  AddSmell( ({ "scheisse","haufen","scheisshaufen" }),
    BS("Auf so eine Idee kommst auch nur Du. Ja, Du riechst an dem Scheisshaufen und er riecht definitiv nicht angenehm. "));
  AddSound( ({ "idee", "ideen" }),
    BS("Deine Ideen haben schon mal besser gerochen. "));
	
	
	



}
