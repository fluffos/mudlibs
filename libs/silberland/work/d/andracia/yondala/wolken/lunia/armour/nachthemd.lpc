#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein gebluemtes Nachhemd");
  SetProp(P_LONG,
    "Du siehst ein weisses Nachthemd mit verschiedensten Blumen darauf. Es ist aus einem "
	"duennen Stoff gefertig, am Saum sowie an den Aermeln ist es mit Rueschen bedeckt." );

  AddAdjective("gebluemt");
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"nachthemd","hemd"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ({MAT_SILK}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 50);
                                  

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
  {

}

