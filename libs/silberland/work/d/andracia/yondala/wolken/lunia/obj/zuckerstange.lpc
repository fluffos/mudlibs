//haelt ewig, dafuer heilt sie wenig und macht sehr satt.

inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zuckerstange");
  SetProp(P_LONG,
    "Du siehst eine quietschbunte, zuckersuesse Zuckerstange." );
  SetProp(P_NAME, "Zuckerstange");
  SetProp(P_GENDER, FEMALE);


SetProp(P_FOOD_INFO, ([F_SOAK:10, 
											 F_HEAL:({5,5}), // erst HP, MP
											 F_MSG: "Du lutscht an der Zuckerstange bis sie vollstaendig weg ist.", 
											 F_MSG_ROOM: "vernascht eine Zuckerstange."]));


  AddId("zuckerstange","stange");

  SetProp(P_MATERIAL, MAT_SUGAR);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
 
  call_out("fall",1200); 
}

void fall()
{ 
	write("Die Zuckerstange klebt an Deinen Fingern, als du versuchst sie zu loesen faellt sie Dir runter.\n");     
	say(TPN+" laesst eine Zuckerstange fallen.\n");
	this_object()->remove();
	}
