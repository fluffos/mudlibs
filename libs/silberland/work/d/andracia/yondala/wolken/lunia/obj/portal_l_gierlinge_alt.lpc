#include "../def.h"

inherit "std/thing";
#include <moredef.h>
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein goldenes Portal");
  SetProp(P_LONG,
    "Du siehst ein Portal aus purem Gold... blabla lang" );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Portal");
  SetProp(P_GENDER, NEUTER);
  AddId("portal");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );
AddCmd( ({ "darf"}), "duerfen" );
seteuid(geteuid());
  SUID;
}

int portal_gefunden(object spieler)
{
  int i;
  string spielername;//komt aus der Datei
  string spielername2;//Ist der Name des aufrufenden Spielers
  spielername2=TPN+"\n";

  SUID;
  //write(read_file(OBJ+"portal_namen_gierlinge.lpc",1,1));
  write("Du bist "+spielername2);
  for(i=1;;)
  {
    spielername=read_file(OBJ+"portal_namen_gierlinge.lpc",i,i);
	write("Gefundener Name: "+spielername);
	if(spielername2==spielername) 
	{
	   write("Passt\n");
	   return 1;
	   break;
	   }
	if(spielername=="Ende"||!spielername)	return 0;
	/*
	if(spieler->name()==read_file(OBJ+"portal_namen_gierlinge",i,i))
	return 1;
	if(read_file(OBJ+"portal_namen_gierlinge",i,i)=="."||
	   !read_file(OBJ+"portal_namen_gierlinge",i,i))
	return 0;*/
  i++;
  }
}

int betreten(string str)
{
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  
  if(!portal_gefunden(TP))
  {
    write("Da Du nicht weisst, wohin Dich das Portal fuehren wird, kannst Du es nicht betreten.\n");
	return 1;
	}
  write("Du betrittst das goldene Portal.\n");
  say(TPN+" betritt das goldene Portal.\n");
  TP->move( "/d/andracia/yondala/gierlingshoehle/room/gierlinge_5e.lpc", M_NOCHECK);
  return 1;
}

int duerfen()
{
  string text;
  text=read_file(OBJ+"portal_namen_gierlinge.lpc");
  write(text);
  //write("File "+read_file(OBJ+"portal_namen_gierlinge",1,1)+"\n");

  //write(read_file(OBJ+"portal_namen_gierlinge.lpc"));


 //return write_file(OBJ+"portal_namen_gierlinge.lpc",TPN);
 return 1;
 }