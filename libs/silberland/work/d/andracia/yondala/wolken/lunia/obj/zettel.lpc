//#include "../def.h"
#include <moredef.h>
inherit "std/thing";
#include <properties.h>

int voll = 1;
string was;
string wer;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Stueckchen Pergament");
  SetProp(P_LONG, "Ein Stueck Pergament, welches man beschriften kann.\n");
  SetProp(P_INFO, "Auf diesem Stueck Pergament kann man eine Nachricht notieren " 
  "<notiere 'text'> und auch wieder entfernen <entferne notiz>. Ausserdem kann man die " 
  "Handschrift des Geschriebenen untersuchen und so den Verfasser der Notizen herausbekommen.\n"
  "Wenn das Pergament nicht mehr benoetigt wird, kann man es einfach zerreissen.");
  SetProp(P_NAME, "Pergament");
  SetProp(P_GENDER, NEUTER);
  AddId("pergament" );

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 100);

  AddDetail( ({"pergament" }),
    "Ein Stueck Pergament, welches man beschriften kann.");

AddCmd(({"notiere", "notier"}), "notierenCmd");
AddCmd(({"lies"}), "lesenCmd");
AddCmd(({"entferne", "entfern"}), "entfernenCmd");
AddCmd(({"unt", "untersuche"}), "untCmd");
AddCmd(({"zerreisse"}), "zerreissenCmd");
}



notierenCmd(string str)
{	 notify_fail( "Was moechtest Du notieren?\n" );
	if (!str)
		{			write( "Was moechtest Du notieren?\n");
			return 1;}
			else
				{
	if (voll > 0)
		{
			write( "Du machst eine Notiz auf dem Pergament.\n");
	    say(TPN + " notiert etwas auf einem Stueck Pergament.\n");
	    voll = 0;
	    was = str;
	    wer = TPN;
	    return 1;
	  }
	else
		{write ("Das Pergament ist schon voll.\n");
			return 1;}

}}

lesenCmd(string str)
{ if (str == "pergament"||str == "notizen" || str == "notiz")
	{
		if (voll > 0)
	    {write ("Das Pergament ist nicht beschrieben.\n");}
	  
	  else
	  	{write ("Auf dem Pergament steht:\n" + was + "\n");}
		return 1;
	}
	}
		
		
entfernenCmd(string str)
{	 notify_fail( "Was moechtest Du entfernen?\n" );
	if (str == "notizen"||str =="notiz")
			write( "Du entfernst saemtliche Notizen von dem Pergament.\n");
	    voll = 1;
	    was = " ";
	    wer = " ";
	    return 1;
}


untCmd(string str)
{ if (str == "handschrift")
	{
		if (voll > 0)
	    {write ("Das Pergament ist nicht beschrieben.\n");}
	  
	  else
	  	if (TPN == wer)
	  		{write("Du selbst scheinst der Urheber dieser Notizen zu sein.\n");}
	  		else
	  	{write ("Die Schrift auf dem Pergament scheint von " + wer + " zu stammen.\n");}
		return 1;
	}
	}
	
zerreissenCmd(string str)
{	 notify_fail( "Was moechtest Du zerreissen?\n" );
	if (str == "pergament")
	{
		write( "Du zerreisst das Pergament in viele kleine Schnipsel.\n");
	    say(TPN + " zerreisst ein Stueck Pergament in viele kleine Schnipsel.\n");			
	    this_object()->remove();
	    return 1;
	}
	return 0;
}