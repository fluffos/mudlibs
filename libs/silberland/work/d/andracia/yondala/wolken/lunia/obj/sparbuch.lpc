// Der Schwarzgeldring, an dem ausgelesen werden kann wie hoch der Kontostand ist.

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>

int anzahl=0;
int guthaben= 0;
string dummies;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Sparbuch");
  SetProp(P_LONG,
    "Du haelst ein kleines duennes Buechlein in den Haenden. Der Einband ist in violette Seide "
    "gebunden, die Raender sind mit silber beschlagen. Das Ganze sieht sehr edel aus.\nDu "
    "kannst Deinen Kontostand auslesen." );
  SetProp(P_INFO, BS("Mit diesem Sparbuch kannst Du Deine Bankgeschaefte taetigen, es "
  "zeichnet Dich als Besitzer Deines Kontos aus.\n"
  "Solltest Du es verlieren, so ist Dein "
  "Geld ebenfalls verloren. Also pass gut darauf auf.\n"
  "Das Sparbuch ist durch einen Zauber an Dich gebunden. Selbst in den Tod wird es Dich "
  "begleiten und auch einen Weltuntergang wird es ueberstehen.") );
  SetProp(P_NAME, "Sparbuch");
  SetProp(P_GENDER, MALE);
  AddId( ({"buch", "sparbuch", ""}) );

  SetProp(P_MATERIAL, ({MAT_SILVER,MAT_SILK}));
  SetProp(P_WEIGHT, 5);
 
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 100);

  AddReadDetail( ({ "sparbuch",  "kontostand", "kontostand aus" }),
    "0");

}

mixed _query_autoloadobj()
    {
      return guthaben;
    }

void _set_autoloadobj(mixed data)
    {
      guthaben=data;
    }


void guthaben_erhoehen(int menge)
{
	guthaben=guthaben+menge;
}


void guthaben_verringern(int menge)
{
	guthaben=guthaben-menge;
}

int guthaben_ausgabe()
{return guthaben;}