//wird vom Kobold hergestellt
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
  SetProp(P_NAME, "Gold");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, random(50)+50);
  AddCmd( ({ "suche","such"}), "suchen" );


}

int undweg()
{
	remove();
}
int suchen(string str)
{
	if(str=="gold"||str=="goldstueck"||str=="goldklumpen")
		{
			write("Du findest einen kleinen Goldklumpen und steckst ihn ein.\n");
			say(TPN+" findet einen kleinen Goldklumpen und steckt ihn ein.\n",TP);
			CLONE(LUNIA_OBJ+"goldklumpen.lpc", TP);
			call_out("undweg",1);
			return 1;
		}
	}

