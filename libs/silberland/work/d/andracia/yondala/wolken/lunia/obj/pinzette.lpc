#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Pinzette");
  SetProp(P_LONG,
    "Du siehst einen kleine, metallene Pinzette, die sich sicher prima dazu eignet Splitter aus "
    "der Haut zu entfernen." );
  SetProp(P_NAME, "Pinzette");
  SetProp(P_GENDER, FEMALE);
  AddId("pinzette");

  SetProp(P_MATERIAL, MAT_MISC_METAL);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
   AddCmd( ({ "entferne","entfern"}), "entfernen" );

}
int entfernen(string str)
{
	object ob;
	notify_fail("Was moechtest Du entfernen?\n");
	if(str=="splitter"||str=="holzsplitter"||str=="splitter mit pinzette"||str=="holzsplitter mit pinzette")
		{
			if (present("\nkasisboesesholzsplitterli",TP))
				{
					ob=present("\nkasisboesesholzsplitterli",TP);
					write("Du greifst Dir den Splitter mit der Pinzette und entfernst ihn.\n");
					say(TPN+" entfernt sich einen Splitter aus der Haut.\n",TP);
					ob->remove();
				}
			else write("Du hast doch gar keinen Splitter.\n");
					return 1;
			}
	return 0;
}