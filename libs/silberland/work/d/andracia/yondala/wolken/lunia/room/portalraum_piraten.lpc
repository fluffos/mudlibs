#include "../def.h"
inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Portal" );
  SetProp( P_INT_LONG,  
    ("Du bist von Dunkelheit umgeben."));
  SetProp( P_LIGHT, -20 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );

  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Bedrueckende Stille herrscht hier.");

  AddSound( ({ "stille" }),
    "Die Stille hier ist bedrueckend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Moder.");

  AddSmell( ({ "moder" }),
    "Irgendwie gruselig.");

 

}

void wirbeltext(object spieler, int i, int ziel)
{
	i++;
	if (i==1)
	{
		tell_object(spieler, "Du findest Dich ploetzlich im voelliegen Nichts.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}

	if (i==2)
	{
		tell_object(spieler, "Leere und Dunkelheit umgeben Dich.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==3)
	{
		tell_object(spieler, "Etwas beginnt, sich in der Dunkelheit zu bewegen.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==4)
	{
		tell_object(spieler, "Vor Dir formiert sich etwas, aus dem Nichts bilden sich Knochen.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==5)
	{
		tell_object(spieler, "Ein Schaedel bildet sich aus der Dunkelheit und kommt auf Dich zu.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==6)
	{
		tell_object(spieler, "Der Schaedel lacht und starrt Dich aus toten Augen an.\nDu willst hier weg.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	
	if (i==7)
	{
		tell_object(spieler, "Ist das da vorne ein Licht?\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;	
	}
	
	else
	{		
		if(ziel==0)//es geht nach Aboriville
			spieler->move("/d/andracia/yondala/wasser/pirateninsel/room/piratengrotte_ranke.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem Portal heraus");	
		else//es geht nach Lunia
			spieler->move(LUNIA_ROOM + "lunia_6e.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem knoechernen Portal heraus");
		
		spieler->SetProp(P_PARALYZED, 0);
		return;
		
	}
	
	
	
	
	
	
	
	
}