#include "../def.h"

inherit LUNIA_ROOM + "lunia_raw.lpc";
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Lunia" );
  SetProp( P_INT_LONG,  
    ("Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist auf der Aussenseite "
    "gesaeumt von hohen Baeumen hinter denen hin und wieder ein Haus hervorlugt. Auf der "
    "Innenseite des Kreises befindet sich ein herrlicher gepflegter Park der durch eine "
    "knoechelhohe Hecke abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige praechtige Baeume und Buesche. Hier steht eine grosse, weisse Vogeltraenke."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



