#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Splitter");
  SetProp(P_LONG,
    "Du siehst einen kleinen dunklen Holzsplitter, den Du Dir irgendwo eingefangen hast. Er steckt "
    "in Deiner Haut fest und ohne Hilfsmittel bekommst Du ihn sicher nicht heraus." );
  SetProp(P_INFO, "Diesen Splitter kann man bestimmt mit einer guten Pinzette entfernen.");
  SetProp(P_NAME, "Splitter");
  SetProp(P_GENDER, MALE);
  AddId(({"splitter","holzsplitter","\nkasisboesesholzsplitterli"}));

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 70);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Der Splitter steckt tief in Deiner Haut, Du kannst ihn nicht ablegen.\n");
}
