#include "../def.h"

inherit "std/thing";

#include <properties.h>

 
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Yondala");
  SetProp(P_LONG,
    "Du siehst eine kleine, sehr detailgetreue Yondala vor Dir. "
	"Sie hat die Statur eines Blauelf, ist normal "
	"gebaut, hat hellblonde Haare und smaragdgruene Augen. "
	"Sie hat ein Kuscheltier unter ihren Arm geklemmt.\n"
	"Sie hat ein Goldsaeckchen an die Huefte gebunden. \n"
	"Yondala hat keine Ruestung an, keine Waffe gezueckt und traegt eine Sonnenbrille und ein Freundschaftsband." );
  SetProp(P_NAME, "Yondala");

  SetProp(P_GENDER, FEMALE);
  AddId(({"yondala"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 0);
 // SetProp(P_NODROP, "Du kannst Deine kleine Yondala nicht ablegen, das wuerde sie sehr traurig machen.\n");
 
}


