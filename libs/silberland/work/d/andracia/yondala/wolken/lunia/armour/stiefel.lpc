//Ein Stiefel fuer auf dem Kopf
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Stiefel");
  SetProp(P_LONG,
    "Du siehst einen alten, gammeligen Stiefel. Er besteht aus Leder und sieht ziemlich abgetragen aus. "
	"Leider ist es nur einer, an den Fuessen kann man ihn also nicht tragen." );
  SetProp(P_INFO, BS("Dieser Stiefel schuetzt Dich vor logischem Denken.") );
  SetProp(P_NAME, "Stiefel");
  SetProp(P_GENDER, MALE);
  AddId( ({"stiefel"}) );
  AddAdjective("alt");
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ({MAT_LEATHER}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_DAM_PROTECTION, DT_MAGIC);

//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
