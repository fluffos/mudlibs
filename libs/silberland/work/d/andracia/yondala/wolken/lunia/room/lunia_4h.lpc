#include "../def.h"
#include <moredef.h>
inherit "std/room";

#include <properties.h>
int oben_geher()
{
	bswrite("Gerade als Du nach oben gehen willst, faellt Dir ein kleines Schild auf.\n");
	return 1;
}


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In Yondalas Villa" );
  SetProp( P_INT_LONG,  
    ("Du stehst in der Eingangshalle zu Yondalas Villa. Der Boden, die "+
	 "Waende und selbst die Decke bestehen aus rosafarbenen Marmor. Es "+
	 "gibt eine gemuetliche Sofaecke, an den Waenden haengen verschiedene "+
	 "Bilder. Eine Treppe fuehrt nach oben, mehrere Tueren fuehren in "
	 "weitere Raeume."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "leonie.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "yondala" }),
    ("Yondala ist gerade nicht hier."));
  AddDetail( ({ "villa" }),
    ("Du befindest Dich in Yondalas Villa. Sie Dich ruhig um, aber fass "+
	"besser nichts an."));
  AddDetail( ({ "eingangshalle","halle","eingang" }),
    ("Die Eingangshalle ist schlicht, aber hochwertig eingerichtet."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus hellem und noch hellerem rosafarbenen Marmor, "+
	"sodass sich ein symmetrisches Karomuster ergibt. In der Mitte der "+
	"Halle liegt ein plueschiger Teppich."));
  AddDetail( ({ "karomuster", "muster" }),
    ("Der helle und der noch hellere Marmor wurden auf dem Boden so "
	"abwechselnd gelegt, dass ein symmetrisches Karomuster entstand."));
  AddDetail( ({ "mitte" }),
    ("Genau in der Mitte der Halle liegt ein dicker Teppich."));
  AddDetail( ({ "teppich" }),
    ("Der Teppich ist dick und flauschig. Er ist sehr fein gearbeitet und "+
	 "besteht aus edlen Stoffen. Da muss jemand Yondala ganz schoen "
	 "moegen, oder Angst vor ihr haben, wenn er ihr so einen Teppich herstellt."));
  AddDetail( ({ "stoffe" }),
    ("So genau kennst Du Dich ja jetzt nicht aus, aber Du bist sicher, dass es "+
	"edle Stoffe sind. "));
  AddDetail( ({ "angst" }),
    ("Aber wer sollte denn Angst vor Yondala haben? Das ist absurd."));
  AddDetail( ({ "waende", "wand" }),
    ("An den Waenden haengen einige Bilder, ausserdem gibt es dort drei "+
	"Tueren und eine Treppe."));
  AddDetail( ({ "bilder" }),
    ("Die Bilder zeigen Yondala mit Freunden und Familie."));
  AddDetail( ({ "freunde","familie" }),
    ("Dir ist keine dieser Personen bekannt."));
  AddDetail( ({ "personen" }),
    ("Macht nichts. Yondala scheinen diese Personen wichtig zu sein."));
  AddDetail( ({ "treppe" }),
    ("Die Treppe fuehrt nach oben zu einem weiteren Stockwerk."));
  AddDetail( ({ "stockwerk" }),
    ("Viel kannst Du davon nicht sehen, die Treppe endet auf einem Flur, "
	"der groestenteils im Dunkeln liegt."));
  AddDetail( ({ "dunkeln","dunkel" }),
    ("Oben ist es so dunkel, dass Du von hier aus nichts erkennen kannst."));
  AddDetail( ({ "flur" }),
    ("Der Flur liegt im Dunkeln. Du muesstest nach oben gehen, um mehr zu sehen."));
  AddDetail( ({ "schild" }),
    ("Das kleine Schild ist ziemlich unauffaellig. Gut, dass Du es gesehen hast."));
  AddDetail( ({ "tueren" }),
    ("Es gibt insgesamt drei Tueren."));
  AddDetail( ({ "tuer" }),
    ("Welche Tuer meinst Du? Nordtuer, Westtuer oder Osttuer?"));
   AddDetail( ({ "osttuer" }),
    ("Eine solide Holztuer."));
   AddDetail( ({ "westtuer" }),
    ("Die Westtuer fuehrt nach draussen, durch sie bist Du wohl herein gekommen."));
   AddDetail( ({ "holztuer" }),
    ("Die Tuer ist fest verschlossen. Wo sie wohl hinfuehrt?"));
   AddDetail( ({ "nordtuer" }),
    ("Die Nordtuer besteht aus Stahl."));
   AddDetail( ({ "stahl" }),
    ("Na huch, was mag sich hinter der Stahltuer verbergen?"));
   AddDetail( ({ "stahltuer" }),
    ("Oeffnen kannst Du sie nicht, aber Du entdeckst ein kleines Guckloch."));
   AddDetail( ({ "guckloch","loch" }),
    ("Ob man durch dieses Guckloch spaehen kann?"));
   AddReadDetail( ({ "schild" }),
    ("Achtung, Treppe ist morsch, bitte nicht nach oben gehen."));
   AddDetail( ({ "decke" }),
    ("Die Decke besteht aus poliertem Marmor. Ein grosser Kronleuchter erhellt "
	"die ganze Eingangshalle."));
   AddDetail( ({ "kronleuchter","leuchter" }),
    ("Unzaehlige kleine Kristalle glitzern und funkeln in dem Licht, welches die "
	 "vielen Kerzen verstroemen."));
   AddDetail( ({ "licht" }),
    ("Das Licht in der Eingangshalle kommt teilweise durch die Osttuer herein, "
	"hauptsaechlich aber von den vielen Kerzen des Kronleuchters, zusaetzlich wird "
	"es tausendfach von den Kristallen gespiegelt und reflektiert."));
   AddDetail( ({ "kerzen", "kerzenlicht" }),
    ("Viele weisse Kerzen brennen auf dem Kronleuchter."));
   AddDetail( ({ "sofaecke","sofa" }),
    ("Die Sofaecke ist wirklich gigantisch. Viele Besucher koennen darauf Platz "
	"nehmen. Sie besteht aus violettem Pluesch und sieht urgemuetlich aus."));
   AddDetail( ({ "besucher" }),
    ("Genau genommen bist Du auch einer."));
   AddDetail( ({ "pluesch" }),
    ("Kuscheliges Pluesch. Bestimmt ganz weich und gemuetlich."));
   AddDetail( ({ "platz" }),
    ("Ob Du auch mal Platz nehmen solltest?"));
   AddDetail( ({ "marmor" }),
    ("Hier besteht alles aus Marmor. Zumindest der Boden, die Waende und die Decke."));
   AddDetail( ({ "raeume" }),
    ("Die kannst Du von hier aus nicht sehen."));
   AddDetail( ({ "kristalle" }),
    ("Sehr viele kostbare Kristalle haengen am Kronleuchter. Sie brechen und reflektieren das "
	"Kerzenlicht."));
   AddDetail( ({ "" }),
    (""));
 
  AddSound( DEFAULT_SOUND,
    ". \n");

  AddSound( ({ "" }),
    ". \n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Vanille. \n");

  AddSmell( ({ "vanille" }),
    "Es riecht sehr angenehm. \n");

 // AddCmd( ({ "betrete", }), "betretenCmd" );
 
  AddCmd( ({ "nimm","nehme", }), "platz_nehmen" ); 
  AddCmd( ({ "stehe","steh", }), "aufstehen" ); 
 AddCmd( ({ "oeffne", }), "oeffneTuer" );
  AddCmd( ({ "spaehe","spaeh", }), "spaehen" );
  AddExit( "westen", LUNIA_ROOM + "lunia_4g.lpc" );
  AddSpecialExit( "oben", "oben_geher" );
  SetProp(P_HIDE_EXITS,({"oben"}));

}

int spaehen(string str)
{
	notify_fail("Wodurch moechtest Du spaehen?\n");
	if(str!="durch loch"&&str!="durch guckloch") return 0;
	if(TP->CannotSee())
	{
		bswrite("Du kannst doch gerade gar nichts sehen.\n");
		return 1;
	}

	bswrite(to_object("/players/yondala/workroom.lpc")->QueryProp(P_INT_LONG));
	write(make_invlist(TP, all_inventory(to_object("/players/yondala/workroom.lpc")), 0));
	tell_room("/players/yondala/workroom.lpc", TPN+ " spaeht durch das Guckloch in der Tuer.\n");
	return 1;
}

int oeffneTuer(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str!="tuer"&&str!="tuere"&&str!="holztuer"&&str!="holztuere"&&str!="stahltuer"&&str!="stahltuere") return 0;
	bswrite("Du ruettelst an der Tuer, sie ist aber fest verschlossen. Schade.\n");
	return 1;
}



int platz_nehmen(string str)
  {  	
  	notify_fail( "Worauf moechtest Du Platz nehmen?\n" );
	if (str!="platz auf sofaecke"&&str!="platz auf sofa"&&str!="platz") 
		return 0;
	if(TP->QueryProp(P_NOMOVE)=="Du hast auf dem Sofa Platz genommen und solltest erst aufstehen.\n")
	{
		write("Du sitzt doch schon.\n");
		return 1;
	}
	bswrite ("Du nimmst auf dem Sofa Platz. Es ist unfassbar total kuschelig weich und gemuetlich.\n");
	say(TPN+" nimmt auf dem Sofa Platz und kuschelt sich tief hinein.\n");
    TP->SetProp(P_NOMOVE, "Du hast auf dem Sofa Platz genommen und solltest erst aufstehen.\n");
    return 1;
}




int aufstehen(string str)
{  	
  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
	if (str!="auf"&&str) return 0;
	if(TP->QueryProp(P_NOMOVE)!="Du hast auf dem Sofa Platz genommen und solltest erst aufstehen.\n")
	{
		write("Du sitzt doch gar nicht auf dem Sofa.\n");
		return 1;
	}
	write("Du stehst vom Sofa auf.\n");
  	say(TPN+" steht vom Sofa auf.\n");
  	TP->SetProp(P_NOMOVE, 0);
  	
 		return 1;
  }

