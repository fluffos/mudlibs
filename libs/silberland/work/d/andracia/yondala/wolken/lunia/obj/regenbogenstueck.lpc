#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Regenbogen");
  SetProp(P_LONG,
    "Du siehst ein buntes Stueck Materie welches sehr wahrscheinlich aus einem Regenbogen geschnitten wurde." );
  SetProp(P_NAME, "Regenbogenstueck");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck","regenbogen","regenbogenstueck"}));

  SetProp(P_MATERIAL, ([ MAT_MISC_MAGIC, MAT_MISC_FLEXIBLE, MAT_AIR ]) );

  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 50);

}
