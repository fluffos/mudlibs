void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Aeron der Dschinn");
  SetProp(P_LONG,
    "Das ist Aeron, der Dschinn. Er ist fast durchsichtig und schimmert blau. Auf seinem Kopf traegt "
    "er einen grossen, weissen Turban der mit einem rotem Rubin verziert ist. Um seinen gewaltigen "
    "Oberkoerper spannt sich eine dunkelrote Weste. Einen Unterkoerper hat Aeron nicht, alles "
    "unterhalb der Huefte verschwimmt in Nebel.");
  SetProp(P_NAME, "Aeron");
  SetProp(P_GENDER, MALE);
  AddId(({"aeron", "wirt","dschinn", "AERON"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");
//  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  
  
  create_default_npc(24);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Dschinn");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_NOCORPSE,1);
//  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_WATER: -0.5, DT_AIR:    -0.5, 
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5]) );

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt von irgendwo herein");
  SetProp(P_MMSGOUT, "schwebt woanders hin");

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Aeron");
  AddInfo(DEFAULT_INFO, "zuckt ahnungslos die Schultern.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"yason","yondala","aginor","hochadel"}),
    "Lang lebe der Hochadel von Andracia!",
    "sagt: ");

  AddInfo( ({"sanfter engel", "blauer engel"}),
    "Oh, den muesst Ihr kosten!",
    "sagt: ");

  AddInfo( ({"bauschwoelkchen"}),
    "Koestlichste Bauschwoelkchen. Wenn die doch nur nicht aus purem Zucker bestaenden!",
    "sagt: ");

  AddInfo( ({"lollie", "heuschreckenlollie"}),
    "Den habe ich im Angebot. Probiert ihn doch, er ist hoechst delikat und sehr reich an Eiweiss"
    "und Protein.",
    "sagt: ");

   AddInfo( ({"angebot",""}),
    "Tippt <menue> um zu sehen, was ich Euch anbieten kann.",
    "sagt: ");

  AddInfo( ({"mondkuchen","kuchen","mond"}),
    "Das ist ein koestliches Gebaeck mit Ammonium-Hydrogencarbonat.",
    "sagt: ");

  AddInfo( ({"ammonium-hydrogencarbonat",""}),
    "Das ist Hirschhornsalz.",
    "sagt laechelnd: ");

  AddInfo( ({"hirschhornsalz",""}),
    "Das verwende ich fuer meine koestlichen Mondkuchen. Kauft doch einen und ueberzeugt Euch selbst!",
    "sagt: ");

  AddInfo( ({"alkohol",""}),
    "Alkohol ist in Lunia verboten. Deswegen ist bei mir auch alles \"alkoholfrei\".",
    "sagt: ");

  AddInfo( ({"wodka",""}),
    "Der Wodka ist SELBSTVERSTAENDLICH ohne *huestel*wenig*huestel Alkohol.",
    "sagt: ");

  AddInfo( ({"gendarme","gendarm"}),
    "Die Gendarme sind sehr streng und kontrollieren taeglich, ob ich auch bloss keinen Alkohol anbiete.",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Aeron will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);

  SetProp(P_NOMAGIC,30);

	AddSpell(1,800,
	         "Aeron schiesst Feuer aus seinen Augen.\n",
	         "Aeron schiesst Feuer aus seinen Augen.\n",
	         ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,300,
	         "Aeron huellt Dich in Nebel ein.\n",
	         "Aeron huellt @WEN in Nebel ein.\n",
	         ({DT_AIR, DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,900,
	         "Aeron laesst einen Blitz auf Dich treffen.\n",
	         "Aeron laesst einen Blitz auf @WEN treffen.\n",
	         ({DT_FIRE,DT_LIGHT}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,400,
	         "Aeron faehrt in Dich.\n",
	         "Aeron faehrt in @WEN.\n",
	         ({DT_FIRE,DT_LIGHT}), ([SP_SHOW_DAMAGE:1]) );

/*
  SetChats(1, ({
    ".\n",
    ".\n"}) );
  SetAttackChats(10, ({
