#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Im Osten erhebt sich ein praechtiges Bauwerk.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "bauwerk", "gebaeude" }),
    "Es handelt sich um ein grosses, weisses Gebaeude, welches man fast schon als "+
    "Villa bezeichnen koennte.");
  AddDetail( ({ "villa" }),
    "Die Villa besteht aus weissem Marmor. Das grosse Eingangsportal wird von "
    "dicken Saeulen umrahmt, welche einen grossen Balkon stuetzen.");    
  AddDetail( ({ "mamor" }),
    "Der Marmor sieht sehr edel aus.");    
  AddDetail( ({ "saeulen", "saeule" }),
    "Die Saeulen bestehen aus Marmor.");    
  AddDetail( ({ "balkon" }),
    "Von diesem Balkon hat man sicher einen guten Blick ueber Lunia.");    
  AddDetail( ({ "blick" }),
    "Vielleicht wirst Du es einmal herausfinden.");      
  AddDetail( ({ "eingang","portal","eingangsportal" }),
    ("Durch das Eingangsportal kann man das Gebaeude betreten."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

     AddExit( "norden", LUNIA_ROOM + "lunia_3g.lpc" );
     AddExit( "sueden", LUNIA_ROOM + "lunia_5g.lpc" );
     AddExit( "osten", LUNIA_ROOM + "lunia_4h.lpc" );

}

betretenCmd(string str )
{
  notify_fail( "Was moechtes Du betreten?\n" );
  if( str == "das haus von nyx" || str == "haus" )
  {
  	
  	TP->move("/d/lunia/nyx/haus/room/haus.lpc", M_GO,
  	"","betritt ein Gebaeude","kommt herein");
		write("Du betritts ein Gebaeude.\n");
    return 1;

  }
  return 0;
}

