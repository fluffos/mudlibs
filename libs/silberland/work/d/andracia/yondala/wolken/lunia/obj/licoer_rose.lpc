// Spieleritem fuer Licoer

//#include "../def.h"
#include <moredef.h>
inherit "std/thing";
#include <properties.h>


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine, rote Rose");
  SetProp(P_LONG, "Du siehst eine kleine, bezaubernde Rose, deren formvollendete Blaetter in einem kraeftigen Rot erstrahlen. "
  "Kleine Tauperlen schimmern auf den Bluetenblaettern wie lauter kleine Diamanten.\n");
  SetProp(P_NAME, "Rose");
  SetProp(P_GENDER, FEMALE);
  AddId("rose");
  SetProp(P_NAME_ADJ,({"klein","rot"}));
  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 150);
  AddDetail( ({"blaetter","bluetenblaetter" }),
    "Die Blaetter der Rose sind samtig weich und ohne Makel.");
  AddDetail( ({"tauperlen" }),
    "Die Tauperlen schimmern wie unzaehlige Diamanten.");
  AddDetail( ({"diamanten" }),
    "Schade, dass es keine echten Diamanten, sondern nur Tauperlen sind.");
  AddDetail( ({"rot" }),
    "Ein kraeftiges, sattes Rot.");  

}

