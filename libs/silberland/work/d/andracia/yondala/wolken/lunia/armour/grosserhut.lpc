//Hut von Zirpus, schuetzt ein bisschen vor Magie und Hitze
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Hut");
  SetProp(P_LONG,
    "Du siehst einen ziemlich grossen Hut. Er ist lila-gruen gestreift und hat eine breite gelbe Krempe." );
//  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Hut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut"}) );
  AddAdjective("gross");
  SetProp(P_NAME_ADJ,"gross");
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ({MAT_SILK, MAT_MISC_MAGIC}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1400);
  SetProp(P_QUALITY_DECAY, 20);
 SetProp( P_TEMPERATURE_PROTECTION, ([ T_HEAT_PROT:3 ]) );                               

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_DAM_PROTECTION, DT_MAGIC);

//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
