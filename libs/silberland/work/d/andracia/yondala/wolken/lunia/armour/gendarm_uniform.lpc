//Uniform vom Gendarm in Lunia
//eine sehr unspektakulaerer Uniform. Haelt nichts aus, geht schnell kaputt
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Uniform");
  SetProp(P_LONG,
    "Du siehst eine schwarze Uniform die vermutlich mal einer Amtsperson gehoert hat." );
//  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Uniform");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"uniform", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 250);
  SetProp(P_QUALITY_DECAY, 50);
                                    

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
