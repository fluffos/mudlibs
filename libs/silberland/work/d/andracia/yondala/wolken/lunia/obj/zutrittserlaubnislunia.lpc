#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Dokument");
  SetProp(P_LONG,
    "Du haelst eine beschriftetes Pergament in den Haenden. Du kannst es "
	"lesen." );
  SetProp(P_NAME, "Dokument");
  SetProp(P_GENDER, NEUTER);
  AddId(({"pergament","papier","dokument","zutrittserlaubnislunia"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  
  AddReadDetail( ({ "pergament","dokument","papier" }),
    "Auf dem Pergament steht:\n\n"+
	"Der Traeger dieses Dokumentes ist berechtigt, den Park \n"+
	"von Lunia auch ohne Begleitung eines Seher zu betreten.\n\n"+
	"                                 XXX Der Buergermeister    ");

}

