#include "../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>
int i;
string farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
i=random(8);
if(i==0) farbe="gruen";
if(i==1) farbe="rot";
if(i==2) farbe="blau";
if(i==3) farbe="schwarz";
if(i==4) farbe="weiss";
if(i==5) farbe="gelb";
if(i==6) farbe="lila";
if(i==7) farbe="orangen";
	
  SetProp(P_SHORT, "Eine "+farbe+"e Fliege");
  SetProp(P_LONG,
    "Du siehst eine "+farbe+"e Fliege wie sie Maenner in feierlichen Situationen zu tragen pflegen." );
  SetProp(P_NAME_ADJ, farbe);
  SetProp(P_NAME, "Fliege");
  SetProp(P_GENDER, FEMALE);
                                    

  AddId( ({"fliege", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_SILK, MAT_COTTON ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 10);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
