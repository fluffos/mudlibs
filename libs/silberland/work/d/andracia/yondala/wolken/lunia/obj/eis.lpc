inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eis");
  SetProp(P_LONG,
    "Du siehst ein koestlich kuehles Eis." );
  SetProp(P_NAME, "Eis");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
	SetProp(P_FOOD_INFO, ([F_SOAK:10, 
	 										   F_HEAL:({15,15}), // erst HP, MP
		 									   F_MSG: "Du schleckst das Eis auf.", 
											   F_MSG_ROOM: "schleckt ein Eis."]));


  AddId("eis");
 
  SetProp(P_MATERIAL, ({MAT_ICE, MAT_SUGAR}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
		call_out("halb",20);
		 
}

void halb()
{write("Das Eis beginnt zu schmelzen.\n");
SetProp(P_FOOD_INFO, ([F_SOAK:8, 
											 F_HEAL:({10,10}), // erst HP, MP
											 F_MSG: "Du schleckst das Eis auf.", 
											 F_MSG_ROOM: "schleckt ein Eis."]));
											 			call_out("weg",20);
}

void weg()
{      this_object()->remove();}