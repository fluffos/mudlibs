#include "../def.h"
#include <moredef.h>

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Landeplatz" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf dem Landeplatz von Lunia. Eigentlich handelt es nur um eine grosse, weisse "
    "Wolke, auf der genuegend Platz fuer all die ankommenden und abfliegenden Transportmittel ist. "
    "Ausserdem siehst Du noch einen Flugplan, ein Willkommensschild und einige Baenke." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_AIR]) );
  call_other("/d/andracia/yondala/gebirge/gebirgspass/room/gebirgspass_67", "???");

  AddDetail( ({ "landeplatz" }),
    "Du befindest Dich auf dem Landeplatz von Lunia. Eigentlich handelt es nur um eine grosse, weisse "
    "Wolke, auf der genuegend Platz fuer all die ankommenden und abfliegenden Transportmittel ist. "
    "Ausserdem siehst Du noch einen Flugplan und einige Baenke.");
  AddDetail( ({ "lunia", "hauptstadt", "stadt" }),
    ("Lunia ist die Hauptstadt Andracias."));
  AddDetail( ({ "wolke", "bauschwolke" }),
    "Du stehst auf einer dicken, weichen Wolke, die noerdlich uebergangslos in weissen Marmor uebergeht.");
  AddDetail( ({ "platz" }),
    "Da hier ausser einigen Baenken und dem Flugplan nichts ist haben alle Reisenden und alle "
    "Transportmittel genuegend Platz.");
  AddDetail( ({ "reisende","reisender" }),
    "Jeder, der hier eines der Transportmittel benuetzt ist ein Reisender.");
  AddDetail( ({ "transportmittel", "transporter" }),
    "Du siehst hier viele verschiedene Transportmittel. Teilweise wunderliche Tiere, teilweise "
    "Dinge, die normalerweise gar nicht fliegen koennen sollten. Manchmal landen Personen aber auch "
    "ohne Transportmittel hier. Du wunderst Dich ein wenig.");
  AddDetail( ({ "tiere", "dienste" }),
    "Verschiedenste Tiere leisten hier als Transporter ihre Dienste. Du siehst einige Voegel, "
    "gefluegelte Pferde und bist Dir fast sicher, dass dort hinten gerade ein Drache abgehoben hat.");
  AddDetail( ({ "voegel" }),
    "Die riesigen Voegel sind sicher hervoragend als Transportmittel geeignet.");
  AddDetail( ({ "pferde" }),
    "Du hast schon ein paar Pferde mit Fluegeln gesehen. Gerade ist wieder eines gelandet.");
  AddDetail( ({ "pferd" }),
    "Ein schoenes, leuchtend weisses Pferd ist eben neben Dir gelandet. Es wiehert Dich froehlich an.");
  AddDetail( ({ "fluegel" }),
    "Du betrachtest die praechtigen Fluegel der fliegenden Pferde.");
  AddDetail( ({ "drache" }),
    "Wenn es einer war, so ist er auch schon davon geflogen und hinter den Wolken verschwunden.");
  AddDetail( ({ "wolken" }),
    "Von hier aus kannst Du prima die bauschigen Wolken sehen von denen Lunia umgeben ist. Hin und "
    "wieder fliegt ein Transporter hinein oder kommt daraus hervor.");
  AddDetail( ({ "personen" }),
    "Manchmal kommt es vor, dass Personen hier einfach so auftauchen ohne von einem Transportmittel "
    "gebracht worden zu sein.\nDu denkst . o O  (Wow, das moechte ich auch mal koennen!)");
  AddDetail( ({ "marmor" }),
    "Im Gegensatz zum Rest der Stadt ist der Landeplatz nicht aus Marmor, sondern aus einer weichen "
    "Bauschwolke. Vermutlich, damit die Transportmittel beim Landen besser angefangen werden.");
  AddDetail( ({ "landen" }),
    "Staendig landen und starten hier diverse Tiere und verzauberte Dinge.");
  AddDetail( ({ "dinge" }),
    "Interessant, was man mittels Magie so alles zum fliegen bekommt. Gerade hat ein kleines Boot "
    "angelegt.");
  AddDetail( ({ "boot" }),
    "Da muss doch Magie im Spiel sein, wie sollte ein Boot, welches sonst nur aus Holz besteht, denn "
    "sonst fliegen koennen?");
  AddDetail( ({ "magie", "spiel" }),
    "Du bist Dir sicher, dass Magie eingesetzt wurde um den ein oder anderen Transporter zum fliegen zu bringen.");
  AddDetail( ({ "holz" }),
    "Das Boot besteht aus glattem, schwarzen Holz. Du bist Dir sicher, dass es sich makellos anfuehlt, "
    "wenn man mit einem Finger drueber streicht.");
  AddDetail( ({ "finger" }),
    "Du besitzt doch sicher den ein oder anderen Finger, oder?");
  AddDetail( ({ "baenke", "bank" }),
    "Einige Baenke stehen hier rum um den Passagieren das Warten zu erleichtern. Sie sind aus hellem "
    "Holzlatten gefertigt und sehen fast wie neu aus.");
  AddDetail( ({ "passagiere", "passagier" }),
    "Wenn Du von hier aus irgendwohin reist, dann bist Du auch ein Passagier.");
  AddDetail( ({ "warten" }),
    "Manchmal muss man ein bisschen auf das richtige Transportmittel warten.");
  AddDetail( ({ "holzlatten", "latten" }),
    "Die Latten sind scheinbar frisch gestrichen. Zumindest sehen sie aus wie neu und riechen auch so.");
  AddDetail( ({ "boden" }),
    "Der Boden hier ist bauschig weich, Du versinkst ab und an ein Stueck in ihm. Klar, Du stehst ja "
    "schliesslich auch auf einer Wolke.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau. Was logisch ist, da Du Dich ja UEBER den Wolken "
    "befindest. Entsprechend lacht eine strahlende Sonne auf Dich herab.");
  AddDetail( ({ "flugplan" }),
    "Du kannst ihn bestimmt lesen.");
  AddDetail( ({ "gegensatz","rest" }),
    "Im Rest der Stadt ist vieles aus Marmor.");
  AddDetail( ({ "farbe" }),
    "Hier ist alles ziemlich weiss.");
  AddDetail( ({ "vogel", "voegel" }),
    "Unter den Transportern sind auch einige Voegel.");

    
  AddReadDetail( ({ "plan","flugplan" }),
    "\n ______________________________________________________________\n"
    "|                                                              |\n"
    "| Sehr geehrte Reisende, aus organisatorischen Gruenden musste |\n"
    "| der Betrieb diverser Reiserouten eingestellt werden.         |\n"
    "| Derzeit verkehrt als einziges oeffentliches Transportmittel  |\n"
    "| unser beliebter Pingu, dessen Dienste aber weiterhin         |\n"
    "| kostenlos sind.                                              |\n"
    "| Aus gegebenen Anlass moechten wir darum bitten, keines der   |\n"
    "| Tiere hier zu fuettern.                                      |\n"                                              
    "|                                Wir bitten um Ihr Verstaendis.|\n"
    "|______________________________________________________________|");

  AddReadDetail( ({ "willkommensschild","schild" }),
    "\n ______________________________________________________________\n"
    "|                                                              |\n"
    "| Willkommen in Lunia, Fremder!                                |\n"
    "| Geniesst Euren Aufenthalt in unserer wunderbaren Stadt.      |\n"
    "| Vergesst dabei aber nicht, dass der Genuss von alkoholischen |\n"
    "| Getraenken, sowie Randalieren hier unter Strafe stehen.      |\n"
    "|                                       Der Oberbuergermeister.|\n"
    "|______________________________________________________________|");

  AddDetail( ({ "kopf" }),
    "Gut, dass Du ihn hier noch nicht verloren hast.");
  AddDetail( ({ "willkommensschild", "schild" }),
    "Du kannst es bestimmt lesen.");
  AddDetail( ({ "sonne" }),
    "Hier oben scheint - zumindest tagsueber- immer die Sonne.");
  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Hier herrscht reges Treiben, Tiere und auch leblose Transporter geben laute Geraeusche von sich. "
    "Ausserdem umfliesst Dich ein schier endloses Stimmengewirr.");


  AddSound( ({ "wiehern","pferd" }),
    "Neben Dir steht ein Pferd und wiehert freundlich.");
  AddSound( ({ "stimmengewirr" }),
    "Leider kannst Du nichts verstehen.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich frisch.");

  AddSmell( ({ "latten","holzlatten","bank", "baenke" }),
    "Die Holzlatten riechen nach frischer Farbe.");

  AddSmell( ({ "farbe" }),
    "Die Holzlatten riechen nicht soooo toll, aber es ist schoen zu wissen, dass sich hier so gut um "
    "alles gekuemmert wird.");

  AddSmell( ({ "" }),
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({"Ein grosses Boot legt ab.\n",
    	"Jemand rempelt Dich an und entschuldigt sich hoeflich.\n",
    	"Du sackst ein Stueck in die Wolke ein und machst einen Schritt nach hinten.\n",
    	"Du sackst ein Stueck in die Wolke ein und machst einen Schritt nach vorne.\n",
    	"Du sackst ein Stueck in die Wolke ein und machst einen Schritt nach links.\n",
    	"Du sackst ein Stueck in die Wolke ein und machst einen Schritt nach rechts.\n",
    	"Ein gigantischer Vogel schlaegt mit seinem Fluegel haarscharf an Deinem Kopf vorbei.\n"}),1);

 
 AddExit( "norden", LUNIA_ROOM+"lunia_8c.lpc" );
 

   AddCmd( ({ "streiche","streich"}), "streichen" );
   AddCmd( ({ "setze","setz", "sitze","sitz"}), "sitzen" );
 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
  catch(call_other( "/d/gebirge/yason/gebirgspass/gebirgspass_67.lpc", "???"));
  // sicherstellen dass auch der Raum mit Pegah geladen ist.
}


sitzen(string str)
  {  	
  	notify_fail( "Worauf moechtest Du sitzen?\n" );
		if (str!="auf bank") return 0;

		if (this_player()->QueryProp(P_NOMOVE)!=0) write ("Du sitzt doch bereits!\n");
  	else //also wenn er noch nicht sitzt
		  {
		  	write ("Du setzt Dich auf eine Bank.\n");
			  say (TPN+" setzt sich auf eine Bank.\n", TP);
		    TP->SetProp(P_NOMOVE, "Du sitzt doch gerade auf der Bank. Steh erstmal auf!\n");
		  }		
		return 1;
			
}




aufstehenCmd(string str)
  {  	
  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
		if (str=="auf"||!str)
  	{
  		if (this_player()->QueryProp(P_NOMOVE)==0) write ("Du sitzt doch gar nicht!\n");
			else
				{
					write ("Du stehst von der Bank auf.\n");
					say (TPN+" steht von der Bank auf.\n", TP);
  				TP->SetProp(P_NOMOVE, 0);
  			}
  		return 1;
		}
		else return 0;
}


streichen(string str)
{
	notify_fail("Womit moechtest Du worueber streichen?\n");
	if(str=="mit finger ueber holz"||str=="mit fingern ueber holz"||str=="ueber holz"||
		 str=="mit fingern uebers holz"||str=="mit finger uebers holz"||str=="uebers holz"||
		 str=="mit fingern uebers boot"||str=="mit finger uebers boot"||str=="uebers boot"|| str=="mit finger ueber boot")
		 {
		 	  CLONE(LUNIA_OBJ + "splitter.lpc", TP);
		 	  write("Du streichst ueber das Holz.\nAUTSCH!\nDu hast Dir einen Splitter eingefangen.\n");
		 	  TP->do_damage(2, "ein Holzsplitter");
		 	  say(TPN+" streicht mit den Fingern ueber das Holz eines Bootes.\n");
		 	  return 1;
		 	}
 	return 0;
}

