inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Zaubereiartikelladen" );
  SetProp( P_INT_LONG,  
    ("Du stehst im Zaubereiartikelladen. Der Laden besteht aus nur einem, kreisrunden Raum. "
     "Die Waende hier moegen weiss sein, doch sieht man von ihnen nicht viel, denn davor stehen "
     "Regale, die mit allem moeglichen Zeug vollgestopft sind. Vor Dir befindet sich ein "
     "Verkaufstresen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  AddItem(LUNIA_NPC + "archibald.lpc",REFRESH_DESTRUCT);
  AddItem(LUNIA_NPC + "zirpus.lpc",REFRESH_DESTRUCT);

  SetProp(P_SPECIAL_SHOP, ([1:"Archibald sagt: Tut mir leid, ich kaufe nichts an!\n"]));
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetStorageRoom(LUNIA_ROOM + "lagerzauberladen.lpc");
  SetProp(P_SHOPKEEPER_ID, "ARCHIBALD");
  SetProp(P_SHOPKEEPER_NAME, "Archibald");
  SetProp(P_SHOPKEEPER_GENDER, MALE);


  AddDetail( ({ "zaubereiartikelladen","laden","raum" }),
    ("Du stehst im Zaubereiartikelladen. Der Laden besteht aus nur einem, kreisrunden Raum. "
     "Die Waende hier moegen weiss sein, doch sieht man von ihnen nicht viel, den davor stehen "
     "Regale, die mit allem moeglichen Zeug vollgestopft sind. Vor Dir befindet sich ein "
     "Verkaufstresen."));
  AddDetail( ({ "waende", "wand" }),
    ("Vor den vermutlich weissen Waenden stehen hohe Regale die mit allerhand Zeug voll "
     "gestellt sind."));
  AddDetail( ({ "regale" }),
    ("Die Regale sind aus einem dir unbekannten Material gefertigt."));
  AddDetail( ({ "material" }),
    ("Es sieht aus wie roter Stahl."));
  AddDetail( ({ "stahl" }),
    ("Du weisst nicht, ob es Stahl ist."));
  AddDetail( ({ "zeug" }),
    ("Es scheinen Waren zu sein, zumindest steh auf jedem Teil ein Preis, auf den meisten "
    "klebt zusaetzlich noch ein kleines Schildchen."));
  AddDetail( ({ "schild","schildchen" }),
    ("Lies es."));
  AddReadDetail( ({ "schild","schildchen" }),
    ("Nicht zuverkaufen!"));
  AddDetail( ({ "waren","ware" }),
    ("Nun, Du bist in einem Laden, es sind sehr, sehr wahrscheinlich Waren, "
    "die hier in den Regalen liegen."));
  AddDetail( ({ "preis", "preise" }),
    ("Wenn Du die Preise der Waren erfahren moechtest, dann tippe <zeig>."));
  AddDetail( ({ "teil" }),
    ("Wenn Dich etwas genauer interessiert, dann tippe <zeig> und danach <unt *nummer> mit der "
    "Nummer des Teils, welches Du untersuchen moechtest."));
  AddDetail( ({ "nummer" }),
    ("Jede Ware bekommt hier eine Nummer zugewiesen um sie leichter untersuchen zu koennen."));
  AddDetail( ({ "boden" }),
    ("Den Boden kannst Du nicht sehen, er wird von unzaehligen Teppichen verdeckt. "));
  AddDetail( ({ "teppiche" }),
    ("Auf dem Boden liegen zahlreiche, bunte Teppiche mit huebschen Mustern."));
  AddDetail( ({ "muster" }),
    ("Die Teppiche sind allesamt bunt und mit wilden Mustern geknuepft."));
  AddDetail( ({ "verkaufstresen","tresen" }),
    ("Der Tresen ist eigentlich nur ein grosser Tisch aus schwarzem Marmor, auf ihm liegen ein "
    "paar Decken."));
  AddDetail( ({ "tisch" }),
    ("Auf dem schwarzen Tisch liegen einige Decken."));
  AddDetail( ({ "marmor" }),
    ("Der Tisch besteht aus feinem, schwarzen Marmor."));
  AddDetail( ({ "decken" }),
    ("Ein paar gehaekelte, etwas altmodisch wirkende Decken liegen auf dem Tisch."));
  AddDetail( ({ "decke" }),
    ("Die Decke ist weiss und relativ unspektakulaer."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
 /* AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");*/

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein bisschen muffig, doch er leichte Duft nach bluehenden Blumen weht von draussen herein.");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm.");
  AddSmell( ({ "luft" }),
    "Die Luft ist ein wenig abgestanden hier.");

 // AddCmd( ({ "betrete", }), "betretenCmd" );
 
 

  AddExit( "sueden", LUNIA_ROOM + "lunia_1c.lpc" );

}


