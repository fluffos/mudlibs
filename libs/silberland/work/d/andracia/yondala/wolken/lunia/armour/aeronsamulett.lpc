//Amulett mit unterschiedlichen Schutzarten
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
  int i;
void create() 
{

  i=random(16);
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein gluehendes Amulett");
  SetProp(P_LONG,
    "Du siehst ein gluehendes Amulett." );
 SetProp( P_TEMPERATURE_PROTECTION, ([ T_HEAT_PROT:3 ]) );

  SetProp(P_NAME, "Amulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ({MAT_GOLD, MAT_MISC_MAGIC}));
  SetProp(P_WEIGHT, 75);
  SetProp(P_VALUE, 2500);
  SetProp(P_QUALITY_DECAY, 50);
                                  

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );


 
	switch (i)
	{
		case 0:
		  SetProp(P_SHORT, "Ein gluehendes Amulett");
		  SetProp(P_LONG,
			"Du siehst ein gluehendes Amulett." );
			SetProp(P_DAM_PROTECTION, DT_FIRE);
			SetProp(P_NAME_ADJ,"gluehend");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Feuer schuetzen.\n");
			break;
		case 1:
		  SetProp(P_SHORT, "Ein kaltes Amulett");
		  SetProp(P_LONG,
			"Du siehst ein kaltes Amulett." );
			SetProp(P_DAM_PROTECTION, DT_COLD);
			SetProp(P_NAME_ADJ,"kalt");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Kaelte schuetzen.\n");
			break;
		case 2:
		  SetProp(P_SHORT, "Ein waessriges Amulett");
		  SetProp(P_LONG,
			"Du siehst ein waessriges Amulett." );
			SetProp(P_DAM_PROTECTION, DT_WATER);
			SetProp(P_NAME_ADJ,"waessrig");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Wasser schuetzen.\n");
			break;
		case 3:
		  SetProp(P_SHORT, "Ein stuermisches Amulett");
		  SetProp(P_LONG,
			"Du siehst ein stuermisches Amulett." );
			SetProp(P_DAM_PROTECTION, DT_AIR);
			SetProp(P_NAME_ADJ,"stuermisch");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Luft schuetzen.\n");
			break;
		case 4:
		  SetProp(P_SHORT, "Ein blitzendes Amulett");
		  SetProp(P_LONG,
			"Du siehst ein blitzendes Amulett." );
			SetProp(P_DAM_PROTECTION, DT_LIGHTNING);
			SetProp(P_NAME_ADJ,"blitzend");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Blitze schuetzen.\n");
			break;
		case 5:
		  SetProp(P_SHORT, "Ein explosives Amulett");
		  SetProp(P_LONG,
			"Du siehst ein explosives Amulett." );
			SetProp(P_DAM_PROTECTION, DT_EXPLOSION);
			SetProp(P_NAME_ADJ,"explosiv");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Explosionen schuetzen.\n");
			break;
		case 6:
		  SetProp(P_SHORT, "Ein lautes Amulett");
		  SetProp(P_LONG,
			"Du siehst ein lautes Amulett." );
			SetProp(P_DAM_PROTECTION, DT_SOUND);
			SetProp(P_NAME_ADJ,"laut");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Laerm schuetzen.\n");
			break;
		case 7:
		  SetProp(P_SHORT, "Ein helles Amulett");
		  SetProp(P_LONG,
			"Du siehst ein helles Amulett." );
			SetProp(P_DAM_PROTECTION, DT_LIGHT);
			SetProp(P_NAME_ADJ,"hell");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Licht schuetzen.\n");
			break;
		case 8:
		  SetProp(P_SHORT, "Ein geladenes Amulett");
		  SetProp(P_LONG,
			"Du siehst ein geladenes Amulett." );
			SetProp(P_DAM_PROTECTION, DT_ELECTRIC);
			SetProp(P_NAME_ADJ,"geladen");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Strom schuetzen.\n");
			break;
		case 9:
		  SetProp(P_SHORT, "Ein saures Amulett");
		  SetProp(P_LONG,
			"Du siehst ein saures Amulett." );
			SetProp(P_DAM_PROTECTION, DT_ACID);
			SetProp(P_NAME_ADJ,"sauer");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Saeure schuetzen.\n");
			break;
		case 10:
		  SetProp(P_SHORT, "Ein giftiges Amulett");
		  SetProp(P_LONG,
			"Du siehst ein giftiges Amulett." );
			SetProp(P_DAM_PROTECTION, DT_POISON);
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Gift schuetzen.\n");
			SetProp(P_NAME_ADJ,"giftig");
			break;
		case 11:
		  SetProp(P_SHORT, "Ein schreckliches Amulett");
		  SetProp(P_LONG,
			"Du siehst ein schreckliches Amulett." );
			SetProp(P_DAM_PROTECTION, DT_TERROR);
			SetProp(P_NAME_ADJ,"schrecklich");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Schrecken schuetzen.\n");
			break;
		case 12:
		  SetProp(P_SHORT, "Ein heiliges Amulett");
		  SetProp(P_LONG,
			"Du siehst ein heiliges Amulett." );
			SetProp(P_DAM_PROTECTION, DT_UNHOLY);
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor unheiligem Schaden schuetzen.\n");
			SetProp(P_NAME_ADJ,"heilig");
			break;
		case 13:
		  SetProp(P_SHORT, "Ein unheiliges Amulett");
		  SetProp(P_LONG,
			"Du siehst ein unheiliges Amulett." );
			SetProp(P_DAM_PROTECTION, DT_HOLY);
			SetProp(P_NAME_ADJ,"unheilig");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor heiligem Schaden schuetzen.\n");
			break;
		case 14:
		  SetProp(P_SHORT, "Ein gedankliches Amulett");
		  SetProp(P_LONG,
			"Du siehst ein gedankliches Amulett." );
			SetProp(P_DAM_PROTECTION, DT_MIND);
			SetProp(P_NAME_ADJ,"gedanklich");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Gedankenmanipulation schuetzen.\n");
			break;
		case 15:
		  SetProp(P_SHORT, "Ein magisches Amulett");
		  SetProp(P_LONG,
			"Du siehst ein magisches Amulett." );
			SetProp(P_DAM_PROTECTION, DT_MAGIC);
			SetProp(P_NAME_ADJ,"magisch");
			SetProp(P_INFO, QueryProp(P_SHORT)+" kann Dich im Kampf vor Schaden durch Magie schuetzen.\n");
			break;
	}

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
    {
		if (member(dtyp, DT_FIRE) >= 0&&i==0) //Schutz gegen Feuer und Angriff mit Feuer
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_COLD) >= 0&&i==1) //Schutz gegen Kaelte und Angriff mit Kaelte
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_WATER) >= 0&&i==2) //Schutz gegen Wasser und Angriff mit Wasser
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_AIR) >= 0&&i==3) //Schutz gegen DT_AIR und Angriff mit DT_AIR
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_LIGHTNING) >= 0&&i==4) //Schutz gegen Blitz und Angriff mit Blitz
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_EXPLOSION) >= 0&&i==5) //Schutz gegen DT_EXPLOSION und Angriff mit DT_EXPLOSION
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_SOUND) >= 0&&i==6) //Schutz gegen Laerm und Angriff mit Laerm
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_LIGHT) >= 0&&i==7) //Schutz gegen Licht und Angriff mit Licht
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_ELECTRIC) >= 0&&i==8) //Schutz gegen Strom und Angriff mit Strom
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_ACID) >= 0&&i==9) //Schutz gegen Saeure und Angriff mit Saeure
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_POISON) >= 0&&i==10) //Schutz gegen Gift und Angriff mit Gift
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_TERROR) >= 0&&i==11) //Schutz gegen DT_TERROR und Angriff mit DT_TERROR
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_HOLY) >= 0&&i==12) //Schutz gegen DT_HOLY und Angriff mit DT_HOLY
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_UNHOLY) >= 0&&i==13) //Schutz gegen DT_UNHOLY und Angriff mit DT_UNHOLY
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_MIND) >= 0&&i==14) //Schutz gegen DT_MIND und Angriff mit DT_MIND
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		if (member(dtyp, DT_MAGIC) >= 0&&i==15) //Schutz gegen Magie und Angriff mit Magie
		{
			tell_object(environment(TO), QueryProp(P_SHORT)+" heilt Dich.\n");
			environment(TO)->AddHp(10+random(5));
		}
		

       return 0;//Ruestung wird dadurch nicht erhoeht
     }