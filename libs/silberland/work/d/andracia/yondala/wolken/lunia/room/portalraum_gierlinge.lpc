#include "../def.h"
inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Portal" );
  SetProp( P_INT_LONG,  
    ("Du bist von festen Stein umgeben. Wohin Du auch schaust, nur Stein ueberall. "+
	 "Oben Stein. Unten Stein. Rechts Stein. Links Stein. Du kannst Dich vor lauter Stein nicht ruehren."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );

  AddDetail( ({ "" }),
    (""));

 

}

void wirbeltext(object spieler, int i, int ziel)
{
	i++;
	if (i==1)
	{
		tell_object(spieler, "Du findest Dich ploetzlich in einem goldenen Wirbel wieder.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}

	if (i==2)
	{
		tell_object(spieler, "Du hast das Gefuehl, dass Du Dich um Dich selbst drehst. Rundherum, von oben nach unten, von rechts nach links.\n");
		call_out("wirbeltext", 5, spieler, i, ziel);
		return;
	}
	if (i==3)
	{
		tell_object(spieler, "Alles um Dich herum ist goldig glitzernd.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==4)
	{
		tell_object(spieler, "Wo ist der Boden? Wo ist der Himmel? Alles ist goldig glitzernd Du bist geblendet von all dem Gold.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==5)
	{
		tell_object(spieler, "Du hast das Gefuehl, nicht mehr atmen zu koennen, weil der goldene Stein Dich zu erdruecken droht.\n");
		call_out("wirbeltext", 5, spieler, i, ziel);
		return;
	}
	if (i==6)
	{
		if(!random(100))
		{
			tell_object(spieler, "Ein besonders spitzer Stein sticht Dir ins Auge.\n");
			spieler->SetProp(P_BLIND, 7);
			call_out("wirbeltext", 5, spieler, i, ziel);
			return;
		}
		
		tell_object(spieler, "Ein besonders spitzer Stein schneidet Dich.\n");
		spieler->do_damage(10);
		call_out("wirbeltext", 5, spieler, i, ziel);
		return;
	}
	
	if (i==7)
	{
		tell_object(spieler, "Ist das da vorne ein Licht?\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;	
	}
	
	else
	{		
		if(ziel==0)//es geht nach Aboriville
			spieler->move("/d/andracia/yondala/gebirge/gierlingshoehle/room/gierlinge_8b.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem Portal heraus");	
		else//es geht nach Lunia
			spieler->move(LUNIA_ROOM + "lunia_5e.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem hoelzernen Portal heraus");
		
		spieler->SetProp(P_PARALYZED, 0);
		return;
		
	}
	
	
	
	
	
	
	
	
}