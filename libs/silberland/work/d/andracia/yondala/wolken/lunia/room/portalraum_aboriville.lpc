#include "../def.h"
inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Portal" );
  SetProp( P_INT_LONG,  
    ("Du bist von Blaettern umgeben. Wohin Du auch schaust, nur Blaetter ueberall. "+
	 "Oben Blaetter. Unten Blaetter. Rechts Blaetter. Links Blaetter."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );

  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

 // AddCmd( ({ "betrete", }), "betretenCmd" );
 

}

void wirbeltext(object spieler, int i, int ziel)
{
	i++;
	if (i==1)
	{
		tell_object(spieler, "Du findest Dich ploetzlich in einem gruenen Wirbel wieder.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}

	if (i==2)
	{
		tell_object(spieler, "Du hast das Gefuehl, dass Du Dich um Dich selbst drehst. Rundherum, von oben nach unten, von rechts nach links.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==3)
	{
		tell_object(spieler, "Alles um Dich herum ist blaetterig gruen.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==4)
	{
		tell_object(spieler, "Wo ist der Boden? Wo ist der Himmel? Alles ist so eintoenig gruen.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==5)
	{
		tell_object(spieler, "Ein paar Aeste scheinen nach Dir zu greifen und Dich fortziehen zu wollen.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==6)
	{
		tell_object(spieler, "Langsam wird Dir ein bisschen mulmig, Dir wird schwindelig von dem Gewirbel.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	
	if (i==7)
	{
		tell_object(spieler, "Ist das da vorne ein Licht?\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;	
	}
	
	else
	{		
		if(ziel==0)//es geht nach Aboriville
			spieler->move("/d/andracia/yondala/tal/aboriville/room/aboriville_3b_o.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem Portal heraus");	
		else//es geht nach Lunia
			spieler->move(LUNIA_ROOM + "lunia_4d.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem hoelzernen Portal heraus");
		
		spieler->SetProp(P_PARALYZED, 0);
		return;
		
	}
	
	
	
	
	
	
	
	
}