inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();


	
	
  SetProp(P_SHORT, "Samoel, die Ziege");
  SetProp(P_LONG,
    "Du siehst eine kleine Ziege vor Dir. Sie hat weisses, struppiges Fell, ein lustiges "
	"kleines Baertchen und zwei kurze Hoerner, die schraeg von Ihrem Kopf abstehen. Die Ziege "
	"schaut Dich mit grossen Kulleraugen an. Sie will anscheinend etwas von Dir.");
  SetProp(P_NAME, "Ziege");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ziege", "tier", "karpfensziege"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit ihren Hufen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ziege");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 0);
	SetProp(P_NOATTACK, "Die Ziege moechte heute nicht sterben.\n");

  SetProp(P_MSGIN, "trabt herbei");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "meckert.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Tiger kann Deine Sachen nicht tragen.\n" }) );


  SetChats(3, ({
    "Die Ziege meckert Dich an.\n",
    "Die Ziege macht: Baaaaeeeeeh!\n",
    "Die Ziege rammt Dir ihre Hoerner in den Bauch.\n"}) );

  AddInfo( ({ "" }),
    "",
    "sagt: ");
   AddCmd(({"lehre","lehr"}),"lehren");
}

//lehre baum Baeume sind gruen
int lehren(string str)
{
	int i;
  notify_fail("lehre <stichwort> <text>\n");
  
  if(this_player()->name()!="Karpfen"&&this_player()->name()!="Yondala")
  {
	  write("Nur Karpfen kann dieser Ziege etwas beibringen.\n");
	  return 1;
  }
  
  	for(i=0;i<strlen(str);i++)
	{
		//write("Position "+i+ " Buchstabe "+dummy[i..i]+"\n");
		if(str[i..i]==" ") break;
	}
	if(i==strlen(str)) return 0; //hat kein Leerzeichen gefunden
	
	AddInfo( ({ str[0..i-1] }), capitalize(str[i+1..strlen(str)]), "meckert: ");
	write("Die Ziege lernt: "+str[0..i]+" bedeutet: "+capitalize(str[i+1..strlen(str)]+"\n"));
	write_file("/d/andracia/yondala/wolken/lunia/log/karpfen_ziege.txt",str+"\n");
	return 1;

}

