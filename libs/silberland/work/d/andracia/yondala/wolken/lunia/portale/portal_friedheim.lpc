string shorttext()
{
	if (testobgemacht(TPN)) return "es klappt\n";
	return "nein";

}

string long()
{
	return "es klappt lang\n";
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  //SetProp(P_SHORT, shorttext());
  //SetProp(P_SHORT, testi(TPN));
  SetProp(P_SHORT, "Portal");
 SetProp(P_LONG,
    "umrankt." );
  SetProp(P_NAME, "Portal");
  SetProp(P_GENDER, NEUTER);
  AddId(({"portal", "steinportal", "gemauertes portal"}));

  SetProp(P_MATERIAL, MAT_MISC_METAL);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
   AddCmd( ({ "betrete",""}), "betreten" );
   AddCmd( ({ "tester",""}), "tester" );
}
int betreten(string str)
{
	if(str!="portal"&&str!="steinportal"&&str!= "gemauertes portal"&&str!="portal aus mauer") return 0;
	
	if(TP->InFight()) 
		{
			write("Waehrend eines Kampfes kannst Du das Portal nicht betreten.\n");
			return 1;
		}
	if(TP->QueryProp(P_NOMOVE))
		{
			write(QueryProp(P_NOMOVE)+"\n");
			return 1;
		}
	
	
	
	return 1;
}


