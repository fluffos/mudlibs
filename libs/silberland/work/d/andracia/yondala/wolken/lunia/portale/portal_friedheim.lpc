int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
//write("teste\n");
	
	daten= read_file(LUNIA_PORT + "portal_friedheim_zugang.lpc");
	einname="";
	write(daten + "lalala/n");
/*	for(ende=0;ende<=strlen(daten);ende++)
