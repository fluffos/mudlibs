#include <moredef.h>
inherit "std/thing";
#include <properties.h>
#include <ansi.h>//fuer die Farben


int *sudoku_gegeben;
int *sudoku_loesung;
int *sudoku_gefuellt; //=gegeben + vom Spieler eingetragenes
string *stellen;
string grad;
//der Speicher ruft diese Funktion zweimal hintereinander auf
//einmal mit der kompletten Loesung und einmal mit den vorgegebenen Zahlen
