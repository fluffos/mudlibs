"|__#___|___|___#___|___|___#___|___|___|\n"+
"|f # "+anzeige[45]+" | "+anzeige[46]+" | "+anzeige[47]+" # "+anzeige[48]+" | "+anzeige[49]+" | "+anzeige[50]+" # "+anzeige[51]+" | "+anzeige[52]+" | "+anzeige[53]+" |\n"+
"|==#=======|===============#===========|\n"+
