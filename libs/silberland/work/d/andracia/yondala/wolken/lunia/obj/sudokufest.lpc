"|__#___|___|___#___|___|___#___|___|___|\n"+
"|c # "+sudoku_loesung[18]+" | "+sudoku_loesung[19]+" | "+sudoku_loesung[20]+" # "+sudoku_loesung[21]+" | "+sudoku_loesung[22]+" | "+sudoku_loesung[23]+" # "+sudoku_loesung[24]+" | "+sudoku_loesung[25]+" | "+sudoku_loesung[26]+" |\n"+
"|==#=======|===#===========#===========|\n"+
"|d # "+sudoku_loesung[27]+" | "+sudoku_loesung[28]+" | "+sudoku_loesung[29]+" # "+sudoku_loesung[30]+" | "+sudoku_loesung[31]+" | "+sudoku_loesung[32]+" # "+sudoku_loesung[33]+" | "+sudoku_loesung[34]+" | "+sudoku_loesung[35]+" |\n"+
"|__#___|___|___#___|___|___#___|___|___|\n"+
"|e # "+sudoku_loesung[36]+" | "+sudoku_loesung[37]+" | "+sudoku_loesung[38]+" # "+sudoku_loesung[39]+" | "+sudoku_loesung[40]+" | "+sudoku_loesung[41]+" # "+sudoku_loesung[42]+" | "+sudoku_loesung[43]+" | "+sudoku_loesung[44]+" |\n"+
"|__#___|___|___#___|___|___#___|___|___|\n"+
"|f # "+sudoku_loesung[45]+" | "+sudoku_loesung[46]+" | "+sudoku_loesung[47]+" # "+sudoku_loesung[48]+" | "+sudoku_loesung[49]+" | "+sudoku_loesung[50]+" # "+sudoku_loesung[51]+" | "+sudoku_loesung[52]+" | "+sudoku_loesung[53]+" |\n"+
"|==#=======|===============#===========|\n"+
