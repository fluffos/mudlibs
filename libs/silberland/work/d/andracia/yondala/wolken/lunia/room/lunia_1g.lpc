//Die Bank

#include "../def.h"

inherit "std/room";
//inherit "/room/std_bank.lpc";
//inherit "/d/ebene/Midas/room/bank/bank.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zentrale der Luniabank" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_INT_LONG,  
    "Du stehst mitten in der Zentrale der grossen Luniabank und staunst ob des hier " +
     "zur Schau gestellten Reichtums. Alles besteht aus edelstem Marmor, oft siehst Du "+
     "goldene Beschlaege an den Schaltern. Auf dem Boden liegen edle Teppiche. "+
     "Ein Schild haengt an der Wand.");

  AddDetail( ({ "schild" }),
    ("Es ist weiss mit einem goldenen Rand, Du kannst es lesen."));
  AddDetail( ({ "zentrale", "bank","luniabank", "raum" }),
    ("Du stehst mitten in der Zentrale der grossen Luniabank und staunst ob des hier "
     "zur Schau gestellten Reichtums. Alles besteht aus edelstem Marmor, oft siehst Du "
     "goldene Beschlaege an den Schaltern. Auf dem Boden liegen edle Teppiche. "
     "Ein Schild haengt an der Wand."));
  AddDetail( ({ "schau" }),
    ("Man zeigt hier, was man hat. Die Geschaefte scheinen gut zu gehen."));
  AddDetail( ({ "geschaefte", "reichtum" }),
    ("Du kannst hier Deine Bankgeschaefte taetigen."));
  AddDetail( ({ "bankgeschaefte" }),
    ("Vermutlich gibt Dir das Schild naehere Auskunft dadrueber."));
  AddDetail( ({ "auskunft" }),
    ("Lies doch einfach das Schild."));
  AddDetail( ({ "marmor" }),
    ("Waende und Boden bestehen aus feinstem Marmor, der ausserdem auch gut "
    "gepflegt ist. Man sieht kein bisschen Dreck."));
  AddDetail( ({ "dreck" }),
    ("Keiner da, ehrlich, da brauchst Du gar nicht suchen."));
  AddDetail( ({ "waende", "wand" }),
    ("Die Waende bestehen aus hellem Marmor. Einige Bilder ziehren die Waende. An einer "
    "Wand haengt ein Schild."));
  AddDetail( ({ "bilder" }),
    ("Auf den Bildern sind Personen abgebildet."));
  AddDetail( ({ "personen" }),
    ("Die Personen auf den Bildern sehen sich recht aehnlich. Allesamt sind sie sehr gut "
     "gekleidet und sehen gepflegt aus. Allerdings kennst Du niemanden davon."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus schwarzem Marmor. Er ist sehr sauber. Einige edle Teppiche liegen "
    "darauf."));
  AddDetail( ({ "teppiche","teppich" }),
    ("Die Teppiche sind dunkelrot und sehr dick. Sie verbinden die Eingangspforte mit den "
    "einzelnen Schaltern."));
  AddDetail( ({ "eingangspforte","pforte" }),
    ("Die Eingangspforte besteht aus besonders dickem Glas und besitzt eine goldene Klinke, "
    "sowie vergoldete Angeln."));
  AddDetail( ({ "glas" }),
    ("Das Glas ist extra dick, damit niemand hier einbrechen kann."));
  AddDetail( ({ "klinke","angeln" }),
    ("Die Klinke und die Angeln sind aus Gold oder zumindest vergoldet. So genau kannst Du das "
    "nicht erkennen. Wirkt jedenfalls ziemlich dekadent."));
  AddDetail( ({ "schalter" }),
    ("Im Moment ist gerade einer frei, wenn Du moechtest koenntest Du jetzt Deine Bankgesch"
    "aefte taetigen."));
  AddDetail( ({ "beschlaege" }),
    ("Die Beschlaege an den Schaltern sehen aus, als sein sie aus purem Gold."));
  AddDetail( ({ "gold" }),
    ("So viel Gold, davon kannst Du wirklich nur traeumen."));
  AddDetail( ({ "decke" }),
    ("Die Decke ist recht hoch ueber Dir. Sie ist bluetenweiss getuencht, in ihrer Mitte "
    "haengt ein riesiger Kronleuchter."));
  AddDetail( ({ "leuchter","kronleuchter" }),
    ("Der Kronleuchter haengt in der Mitte des Raumes und ist gigantisch. Er scheint nur aus "
    "Gold und Diamanten zu sein. Er funkelt und glitzert im Licht "
    "der vielen Kerzen, die er traegt."));
  AddDetail( ({ "diamanten" }),
    ("Es sieht wirklich sehr edel aus."));
  AddDetail( ({ "licht" }),
    ("Durch die vielen Kerzen des Kronleuchters ist es hier fast taghell."));
  AddDetail( ({ "kerzen" }),
    ("Tausende weisser Kerzen zieren den Kronleuchter."));
  AddDetail( ({ "rand" }),
    ("Der Rand des Schildes ist mit Gold beschlagen."));
  AddDetail( ({ "moment" }),
    ("Jetzt gerade."));
  AddDetail( ({ "mitte" }),
    ("Er ist von allen Waenden ganz genau gleich weit entfernt."));
  AddDetail( ({ "" }),
    (""));
/*  AddReadDetail( ({ "schild" }),
    ("Folgenede Dienste bieten wir an:\n"
     "Sparbuch anlegen:  200 M\n"
     "Geld einzahlen:      0 M\n"
     "Geld abheben:      100 M\n"
     "Sparbuch aufloesen:  0 M"));*/
  AddReadDetail( ({ "schild", "dienste", "dienst" }),
    ("Geehrter Kunde:\n"
     "Derzeit koennen wir keine Dienste anbieten.\n"
     "Fuer weitere Informationen wendet Euch gerne an Magierin Yondala.\n\n"
     "Hochachtungsvoll, \ndie Filialleitung"));
   AddDetail( ({ "yondala" }),
    ("Teile Yondala mit: Wann bietet die Bank in Lunia endlich Dienste an?"));
  AddDetail( ({ "" }),
    (""));
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das geschaeftige Treiben der Bankangestellten und die leisen Gespraeche der Kunden. \n");

  AddSound( ({ "treiben","angestellte","bankangestellte" }),
    "Die Bankangestellten wuseln fleissig herum. \n");
  AddSound( ({ "gespraeche","kunden" }),
    "Irgendwie waere es hier selbst Dir peinlich andere zu belauschen, so wendest Du Dich "
    "wieder anderen Dingen zu. \n");
  AddSound( ({ "dinge" }),
    "Dies und das. \n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Bohnerwachs und Zitrone. \n");

  AddSmell( ({ "bohnerwachs" }),
    "Vermutlich wurde das erst kuerzlich benutzt.\n");
  AddSmell( ({ "zitrone" }),
    "Es riecht sehr angenehm. Ist vermutlich Absicht.\n");
  AddSmell( ({ "absicht" }),
    "Wenn Du mir sagst, wie \"Absicht\" riecht, widme ich Dir dieses Detail.\n");


  AddExit( "suedwesten", LUNIA_ROOM + "lunia_2f.lpc" );


}

