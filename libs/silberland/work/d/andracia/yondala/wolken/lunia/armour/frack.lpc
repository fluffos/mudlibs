#include "../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Frack");
  SetProp(P_LONG,
    "Du siehst einen feinen, schwarzen Frack." );
  SetProp(P_NAME, "Frack");
  SetProp(P_GENDER, MALE);

  AddId( ({"frack", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_SILK, MAT_COTTON ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 10);
                                    

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
