#include "../def.h"
inherit "std/room";
#include <properties.h>

void reset()
{
	object mussweg;
	//hier muessen noch Krankenschwester und Arzt removed werden
	if (present("\ndoktor",TO)) 
		{
			tell_room(TO, "Asklepio geht nach einem Patienten schauen.\n");
			mussweg=present("\ndoktor");
			mussweg->remove();
		}
	if (present("\nkrankenschwester",TO)) 
		{
			tell_room(TO,"Die Krankenschwester sagt: So, ich habe zu tun.\n");
			tell_room(TO,"Die Krankenschwester geht durch eine Tuer und schliesst diese hinter sich.\n");
			mussweg=present("\nkrankenschwester");
			mussweg->remove();
		}
		
		
	::reset();
	}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Empfang des Hospitals" );
  SetProp( P_INT_LONG,  
    ("Du stehst hier am Empfang des beruehmte Lunia-Hospitals. Viel ist hier nicht zu sehen, "
    "lediglich eine runde Empfangstheke, ein paar Tueren und ein Sofa befinden sich in Deinem "
    "Blickfeld. Es ist hier sehr sauber und riecht nach Desinfektionsmitteln."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );



  AddDetail( ({ "schmerzen" }),//vom Sound
    ("Du hoffst, dass man Dich hier niemals schreien hoert. Oder noch besser: Du hoffst, dass "
    "Du niemals einen Grund hast so zu schreien."));
  AddDetail( ({ "grund" }),
    ("Du fragst Dich, warum dieser jemand so schreit."));
  AddDetail( ({ "empfang","hospital", "raum" }),
    ("Du stehst im Empfang des Hospitals."));
  AddDetail( ({ "theke","empfangstheke" }),
    ("Die Theke ist ungefaehr auf brusthoehe. Sie ist weiss und bis auf eine kleine Glocke leer."));
  AddDetail( ({ "tueren" }),
    ("Von hier aus gehen einige Tueren in verschiedene Richtungen ab. Bis auf die glaeserne "
    "Doppeltuer durch die Du gekommen bist sind alle geschlossen."));
  AddDetail( ({ "richtungen" }),
    ("In verschiedene Richtungen."));
  AddDetail( ({ "glocke" }),
    ("Auf der Theke steht eine kleine silberne Glocke. Man kann sie nicht hochnehmen, sie hat aber "
    "einen kleinen Knopf obendrauf."));
  AddDetail( ({ "knopf" }),
    ("Der Knopf ist, wie auch der Rest der Glocke, silbern. Man kann ihn sicher druecken, oder "
    "auch draufhauen."));
  AddDetail( ({ "rest" }),
    ("Alles, was nicht Knopf ist, ist Rest in diesem Fall."));
  AddDetail( ({ "fall" }),
    ("*gaehn* bist fleissig, kriegst nen Forscherpunkt."));
  AddDetail( ({ "forscherpunkt" }),
    ("Dafuer zieh ich Dir wieder einen ab :op"));
  AddDetail( ({ "blickfeld" }),
    ("Eine runde Empfangstheke, ein paar Tueren und ein Sofa befinden sich in Deinem "
    "Blickfeld"));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht hier aus weissen Steinen."));
  AddDetail( ({ "steine" }),
    ("Sie sehen aehnlich aus wie die draussen. Du bist Dir allerdings nicht sicher, ob es Marmor ist."));
  AddDetail( ({ "marmor" }),
    ("Du weisst es nicht."));
  AddDetail( ({ "decke" }),
    ("An der Decke wurden einige Lampen angebracht die den Raum erhellen."));
  AddDetail( ({ "lampen" }),
    ("Du bist Dir nicht sicher, wie sie funktionieren, aber sie erhellen den Raum gut und flackern nur selten."));
  AddDetail( ({ "wand","waende" }),
    ("An den Waenden haengen einige Diplome und auch eine Liste."));
  AddDetail( ({ "diplome" }),
    ("Die Diplome zeugen davon, dass der Doktor tatsaechlich eine richtige Ausbildung hat."));
  AddDetail( ({ "ausbildung" }),
    ("Die scheint lange her zu sein laut dem Datum auf den Diplomen."));
  AddDetail( ({ "datum" }),
    ("Das war vermutlich anno Piependeckel."));
  AddDetail( ({ "piependeckel" }),
    ("Das bedeutet, es ist lang her. So lang, dass es egal ist, wann genau das war. Dich gabs da vermutlich noch nicht."));
  AddDetail( ({ "liste" }),
    ("Auf der Liste stehen Preise und Dienstleistungen."));
  AddDetail( ({ "preise","dienstleistungen" }),
    ("Du kannst die Liste lesen."));
  AddReadDetail( ({ "liste","preise","dienstleistungen" }),
    ("_____________________________________\n"
    "|                                     |\n"
    "|    Unsere               Preis in    |\n"
    "| Dienstleistung           Muenzen    |\n"
    "|  Enttauben                 200      |\n"
    "|  Entblinden                300      |\n"
    "|  Entfroschen               900      |\n"
//    "|  Entraupen                 400      |\n"
    "|  Entgiften                 500      |\n"
    "|  Heilen                    800      |\n"
    "|  Koerperteile annaehen    2000      |\n"
//    "|  Notbehandlung            4000      |\n"
//    "|  weitere folgen                     |\n"
    "|                                     |\n"
    "|      Bei Behandlungsbedarf:         |\n"
    "|      fragt nach dem Doktor!         |\n"
    "|_____________________________________|\n"
    "\n"
    ));
  AddDetail( ({ "doppeltuer" }),
    ("Die glaeserne Doppeltuer ist mit einem kleinen Keil festgestellt. So kommt immer genug frische "
    "Luft in den Raum."));
  AddDetail( ({ "luft" }),
    ("Du atmest ein paar mal tief ein und aus. Ja, herrlich, diese frische Luft."));
  AddDetail( ({ "keil" }),
    ("Ein kleiner hoelzerner Keil hindert die grosse, glaeserne Doppeltuer daran zuzufallen."));
  AddDetail( ({ "sofa", "ledersofa" }),
    ("Du siehst ein kleines, schwarzes Ledersofa, das wohl fuer wartende Verwandtschaft gedacht ist."));
  AddDetail( ({ "leder" }),
    ("Das Leder war mal hochwertig, jetzt ist es doch schon ein wenig abgenutzt."));
  AddDetail( ({ "verwandtschaft" }),
    ("Es scheint gerade keine da zu sein."));
  AddDetail( ({ "lunia" }),
    ("Was Lunia ist, solltest Du wissen."));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Es ist hier recht still. Nur hin und wieder hoerst Du einen entfernten Schrei oder ein leises Fluestern. \n");

  AddSound( ({ "schrei", "schreie" }),
    "Irgendjemand hier scheint Schmerzen zu haben. \n");
  AddSound( ({ "schmerzen" }),
    "Du hoffst, dass man Dich hier niemals schreien hoert. \n");
  AddSound( ({ "fluestern" }),
    "Leider kannst Du nicht verstehen, was da gesprochen wird. \n");
  AddSound( ({ "jemand","irgendjemand" }),
    "Die Schreie stecken voller Schmerz und auch ... Angst.\n");
  AddSound( ({ "angst" }),
    "Du kannst deutlich die Angst aus den Schreien heraushoeren.\n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier leicht nach Desinfektionsmitteln. \n");

  AddSmell( ({ "desinfektionsmittel", "mittel" }),
    "Es riecht sozusagen sauber. \n");

  AddCmd( ({ "druecke","drueck", "haue","hau" }), "druecken" );
  AddCmd( ({ "oeffne" }), "oeffnen" );
 AddCmd( ({ "sitze","sitz","setze","setz" }), "setzen" );

  AddExit( "westen", LUNIA_ROOM + "lunia_5g.lpc" );
}

int druecken(string str)
{

	if(str=="knopf"||str=="glocke"||str=="auf knopf"||str=="auf glocke")
		{
			write("Du betaetigst die Glocke.\n*pling*\n");
			say(TPN+" betaetigt die kleine Glocke.\n*pling*\n");
			if(present("\nkrankenschwester", TO))
				{
					write("Die Krankenschwester sagt genervt: Ich bin doch hier!\n");
					say("Die Krankenschwester sagt genervt: Ich bin doch hier!\n");
					}
			else
			  CLONE(LUNIA_NPC + "krankenschwester.lpc", environment(TP));
		return 1;
	  }
	return 0;
	}
	
int oeffnen(string str)
{notify_fail("Was willst Du oeffnen?\n");
	if (str=="tuer"||str=="tueren")
		{
			write("Du ruettelst und zerrst an der Tuer, bekommst sie aber nicht auf.\n");
			say(TPN+ " versucht erfolglos eine Tuer zu oeffnen.\n");
			return 1;
			}
	return 0;
	}	

int setzen(string str)
{notify_fail("Worauf moechtest Du Dich setzen?\n");
	if (str=="auf sofa"||str=="aufs sofa"||str=="auf ledersofa"||str=="aufs ledersofa")
		{
			write("Gerade als Dein Hintern fast das Sofa beruehrt rueckt dieses ein Stueck zur Seite.\n");
			say(TPN+ " will sich auf ein Sofa setzen, das Sofa weicht aber aus.\n");
			tell_room(TO, "Das Sofa sagt: Ich bin nicht fuer Euch bestimmt.\n"+
			"Du bist erstaunt.\n");
			return 1;
			}
	return 0;
	}		