#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Suedoestlich von Dir steht eine riesige weisse Kugel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "sammelkobold.lpc",REFRESH_DESTRUCT);



  AddDetail( ({ "kugel" }),
    ("Suedoestlich von Dir steht eine riesige, weisse Kugel. Sie ist perfekt rund, lediglich an der Dir "
    "zugewandten Seite befindet sich in der Kugel ein rechteckiges Loch. Ein Fleckchen Gras "
    "hindert die Kugel am Wegrollen."));
  AddDetail( ({ "seite" }),
    ("Vorne, sozusagen."));
  AddDetail( ({ "loch" }),
    ("Das Loch ist gross genug um dadurch die Kugel betreten zu koennen."));
  AddDetail( ({ "fleckchen" }),
    ("Nun, ein wenig halt."));
  AddDetail( ({ "gras" }),
    ("Das Gras sieht gesund und gepflegt aus. Es ist strahlend gruen und scheinbar frisch gestutzt."));
  AddDetail( ({ "wegrollen" }),
    ("Gut, dass das Gras da ist. Nicht auszudenken, was passieren koennte, wenn die Kugel ins "
    "Rollen kaeme."));
  AddDetail( ({ "rollen" }),
    ("Das kann ja nicht passieren, solange niemand die Kugel ganz feste anstoesst."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));

  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");
  AddCmd( ({ "stosse","stoss"}), "stossen" );

     AddExit( "norden", LUNIA_ROOM + "lunia_5g.lpc" );
     AddExit( "suedwesten", LUNIA_ROOM + "lunia_7f.lpc" );
     AddExit( "suedosten", LUNIA_ROOM + "lunia_7h.lpc" );
}

int stossen(string str)
{
	notify_fail("Was moechtest Du stossen?\n");
	if(str=="kugel ganz feste an"||str=="kugel ganz feste")
		{
			write ("Du stoesst so fest Du kannst, aber leider bist Du nicht stark genug um die Kugel ins Rollen zu bringen.\n");
			say(TPN+" versucht die grosse, weisse Kugel ins Rollen zu bringen, scheitert aber klaeglich.\n");
			return 1;
		}
	else if(str=="kugel feste an"||str=="kugel feste")
		{
			write ("Du stoesst die Kugel relativ fest an, leider nicht stark genug, denn sie bewegt sich "
			"keinen Milimeter.\nOb Du mal GANZ FESTE stossen solltest?\n");
			say(TPN+" versucht die grosse, weisse Kugel ins Rollen zu bringen, scheitert aber klaeglich.\n");
			return 1;
		}
	else if(str=="kugel an"||str=="kugel")
		{
			write ("Du stoesst die Kugel an, leider nicht stark genug, denn sie bewegt sich "
			"keinen Milimeter.\nOb Du mal fest stossen solltest?\n");
			say(TPN+" versucht die grosse, weisse Kugel ins Rollen zu bringen, scheitert aber klaeglich.\n");
			return 1;
		}
	
	return 0;
	}