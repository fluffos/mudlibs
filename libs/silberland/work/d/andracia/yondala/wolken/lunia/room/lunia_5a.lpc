#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp(P_INT_LONG)+ "Im Westen kannst Du ein wuerfelfoermiges Gebaeude sehen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "gebaeude" }),
    ("Das Gebaeude im Westen ist ein exakter Wuerfel. Alle Seiten sind genau gleich lang."));
  AddDetail( ({ "seiten" }),
    ("Alle Seiten des Gebaeudes sind gleich lang, deswegen sieht es aus wie ein Wuerfel."));
  AddDetail( ({ "wuerfel" }),
    ("Das Gebaeude im Westen sieht aus wie ein Wuerfel. Nur die Punkte fehlen."));
  AddDetail( ({ "punkte" }),
    ("Die fehlen. Aber wer koennte denn auch schon mit so einem grossen Wuerfel wuerfeln?"));
  AddDetail( ({ "westen" }),
    ("Im Westen steht ein wuerfelfoermiges Gebaeude."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");


     AddExit( "norden", LUNIA_ROOM + "lunia_4a.lpc" );
     AddExit( "westen", LUNIA_ROOM + "lunia_5a0.lpc" );
     AddExit( "sueden", LUNIA_ROOM + "lunia_6a.lpc" );
}

