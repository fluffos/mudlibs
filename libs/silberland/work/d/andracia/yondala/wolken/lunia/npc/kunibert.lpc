//Der Verkaeufer im Zaubereiartikelladen in Lunia
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Kunibert");
  SetProp(P_LONG,
    "Das ist Kunibert. Er ist im mittleren Alter, hat schwarze, gegelte Haare und einen schmalen "
    "schwarzen Schnauzbart. Er traegt sehr feine Kleidung und laechelt Dich mit den weissesten "
    "Zaehnen, die Du je gesehen hast, an.");
//SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  SetProp(P_NAME, "Kunibert");
  SetProp(P_GENDER, MALE);
  AddId(({"kunibert", "verkauefer", "mann", "KUNIBERT","Schwertexperte"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(21);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 177);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Kunibert");
//  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "ignoriert Deine Frage.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Kunibert legt @CAP_WER zu seinen Privatsachen.\n" }) );

/*  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));


  SetAttackChats(10, ({
    ".\n"}) );*/
  SetChats(3, ({
    "Kunibert poliert den Tresen.\n",
    "Kunibert laechelt Dich mit strahlend weissen Zaehnen an.\n",
    "Kunibert fragt: Moechtet Ihr nicht etwas kaufen?\n"}) );
  SUID;
  CLONEME("/p/weapon/sword/degen" );
  command("zuecke degen");
  CLONEME(LUNIA_ARMOUR "frack" );
  CLONEME(LUNIA_ARMOUR "fliege" );
  command("trage alles");
  
  
  SetProp(P_SPELLRATE, 30);
  SetProp(P_NOMAGIC,10);

	AddSpell(2,450,
	        "Kunibert sticht Dir in den Bauch.\n",
	        "Kunibert sticht @WEM in den Bauch.\n",
	         ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,280,
	         "Kunibert macht eine Finte.\n",
	         "Kunibert macht eine Finte.\n",
	         ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,550,
	         "Kunibert schlaegt Dich mit dem Griff seines Degens.\n",
	         "Kunibert schlaegt @WEN mit dem Griff seines Degens.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

 	AddSpell(1,100,
	         "Kunibert vertickt Deinen Geist.\n",
	         "Kunibert vertickt @WESSEN Geist.\n",
	         ({DT_MIND}),"tick", ([SP_SHOW_DAMAGE:1]) ); 
}
void tick(object enemy, int damage, mixed dam_type) 
{
	if(!interactive(enemy)||present("NERVOESESTICK", enemy)) return;
	 CLONE(LUNIA_OBJ+"nervoesestick", enemy);
	 
	}