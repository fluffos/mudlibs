#include "../def.h"
inherit "std/room";

#include <properties.h>
string frisierstuhlsitzer;
string wartestuhl1;
string wartestuhl2;
void create() 
{
  ::create();
frisierstuhlsitzer="";
wartestuhl1="";
wartestuhl2="";
  SetProp( P_INT_SHORT, "In einem Frisiersalon" );
  SetProp( P_INT_LONG,  
    ("Du stehst hier in einem kleinen Raum. Alles um Dich herum ist rosa: Die Waende, der Boden, "
    "die drei Stuehle, das Waschbecken, einfach alles. Es riecht hier sehr suesslich."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "rene.lpc",REFRESH_DESTRUCT);



  AddDetail( ({ "frisiersalon","raum" }),
    ("Du stehst hier in einem kleinen Raum. Alles um Dich herum ist rosa: Die Waende, der Boden, "
    "die drei Stuehle, die Waschbecken, einfach alles. Es riecht hier sehr suesslich."));
  AddDetail( ({ "waende", "wand" }),
    ("Die Waende sind rosa. An ihnen haengen einige Spiegel und auch ein paar Auszeichnungen "
    "in silbernen Rahmen. An einer Wand haengt eine Tafel."));
  AddSpecialDetail( ({ "spiegel","in spiegel"  }), "spiegel" );//int_long von TP
  AddDetail( ({ "auszeichnungen", "schriften", "auszeichnung" }),
    ("Du siehst einige Schriften, die den Besitzer des Frisiersalons als hervorragenden "
     "Barbier auszeichnen."));
  AddDetail( ({ "besitzer","barbier" }),
    ("Wenn er nicht da ist, so kommt er bestimmt gleich."));
  AddDetail( ({ "rahmen" }),
    ("Die Rahmen sehen edel aus und scheinen aus purem Silber zu bestehen."));
  AddDetail( ({ "silber" }),
    ("Ganz schoen teuer fuer so eine Auszeichnung echtes Silber zu verwenden."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus rosanen Marmorfliesen."));
  AddDetail( ({ "marmorfliesen","fliesen" }),
    ("Die Marmorfliesen sind aus hellem Marmor und hin und wieder von weissen Aederchen durchzogen."));
  AddDetail( ({ "marmor" }),
    ("Der Marmor ist rosa."));
  AddDetail( ({ "aederchen" }),
    ("Weisse Aederchen ziehen ein abstraktes Muster durch die rosanen Marmorfliesen."));
  AddDetail( ({ "muster" }),
    ("Das Muster ist sehr abstrakt, Du kannst kaum etwas sinnvolles erkennen."));
  AddDetail( ({ "decke" }),
    ("Die Decke ist hellrosa gestrichen. An ihr haengt ein kleiner, glitzender Leuchter."));
  AddDetail( ({ "leuchter" }),
    ("Der Leuchter besteht aus funkelndem Glas und traegt sechs hellstrahlende Kerzen."));
  AddDetail( ({ "glas" }),
    ("Wenn auch nur aus Glas, so sieht der Leuchter doch sehr edel aus."));
  AddDetail( ({ "kerzen" }),
    ("Die Kerzen strahlen unnatuerlich hell und beleuchten den Raum bis in den letzten Winkel."));
  AddDetail( ({ "winkel" }),
    ("An den Winkeln hier ist eigentlich nichts Besonderes, ausser, dass sie wirklich gut ausgleuchtet sind."));
  AddDetail( ({ "stuehle" }),
    ("Du siehst zwei Wartestuehle und einen Frisierstuhl."));
  AddSpecialDetail( ({ "wartestuhl","wartestuehle"  }), "wartestuhl" );
  AddDetail( ({ "kunden", "kunde" }),
    ("Nun, wer sich hier frisieren laesst, der ist ein Kunde."));
  AddDetail( ({ "reihe" }),
    ("Die noch nicht dran sind."));
  AddDetail( ({ "platz" }),
    ("Sie koennen dort sitzen."));
  AddSpecialDetail( ({ "tafel","in spiegel"  }), "spiegel" );//int_long von TP
  AddDetail( ({ "tafel" }),
    ("Auf der Tafel sind Preise und Dienstleistungen notiert. Du kannst sie lesen."));

  AddReadDetail( ({ "tafel" }),//faerben erstmal teurer machen, wer weiss, wies angenommen wird
    ("_________________________________________\n"
    "|*                                       *|\n"
    "| Verehrtester Kunde,                     |\n"
    "| die derzeit einzige Dienstleistung, die |\n"
	"| ich anbieten kann ist eine neue,        |\n"
	"| individuelle Frisur.                    |\n"
	"| Fragt mich einfach danach!              |\n"
    "|                               Ihr Rene  |\n"
    "|*                                       *|\n"
    "|_________________________________________|\n"));
  
  /*    ("_________________________________________\n"
    "|*                                       *|\n"
    "| Verehrtester Kunde,                     |\n"
    "| folgende Dienstleistungen biete ich an: |\n"
    "| waschen, schneiden, foehnen     2000 M  |\n"
    "| faerben                        20000 M  |\n"
    "| Oder fragt mich direkt nach einer       |\n"
    "| neuen, individuellen Frisur!            |\n"
    "|                               Ihr Rene  |\n"
    "|*                                       *|\n"
    "|_________________________________________|\n"));*/
  AddDetail( ({ "preise","dienstleistungen","leistungen" }),
    ("Lies einfach die Tafel."));
  AddSpecialDetail( ({ "frisierstuhl"  }), "frisierstuhl" );
  AddDetail( ({ "waschbecken" }),
    ("An diesem rosafarbenen Waschbecken werden den Kunden vermutlich die Haare gewaschen."));
  AddDetail( ({ "haare" }),
    ("Um die geht es normalerweise in einem Frisiersalon."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

  AddExit( "suedosten", LUNIA_ROOM + "lunia_2b.lpc" );

   AddCmd( ({ "setze","setz", "sitze","sitz"}), "sitzen" );
 
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
}

void aufgestehter()//wird von "Rene" aufgerufen wenn er wen aus seinem Laden wirft.
{frisierstuhlsitzer="";}

string wartestuhl()
{
	string ausgabe;
	ausgabe="Auf denen koennen Kunden, die noch nicht an der Reihe sind, Platz nehmen.\n";
	if(wartestuhl1==""&&wartestuhl2=="")//beide leer
		return ausgabe;
  else if (wartestuhl1==TPN)
  	ausgabe=ausgabe+"Auf einen davon sitzt Du.\n";
  else
  	ausgabe=ausgabe+ "Auf einen von Ihnen sitzt "+wartestuhl1+".\n";
  if(wartestuhl2=="")
		return ausgabe;
  else if (wartestuhl2==TPN)
  	ausgabe=ausgabe+"Auf einen davon sitzt Du.\n";
  else
  	ausgabe=ausgabe+ "Auf einen von ihnen sitzt "+wartestuhl1+".\n";
return break_string(ausgabe);
	}

string frisierstuhl()
{
	if(frisierstuhlsitzer=="")
		return("Auf dem nehmen die Kunden Platz um frisiert zu werden.\n");
	
	else if (frisierstuhlsitzer==TPN)
	return  break_string("Du sitzt auf dem Stuhl, auf dem die Kunden frisiert werden.\n");
  else
  	return break_string("Auf dem nehmen die Kunden Platz um frisiert zu werden. "+frisierstuhlsitzer+" sitzt darauf.\n");
	
	}
sitzen(string str)
  {  	
  	notify_fail( "Worauf moechtest Du sitzen?\n" );
    if(frisierstuhlsitzer==TPN||wartestuhl1==TPN||wartestuhl2==TPN)//wenn er schon irgendwo sitzt
			{
				write("Du sitzt doch schon.\n");
				return 1;
			}
		if (str=="auf stuhl") 
			{
				write("Auf welchem Stuhl moechtest Du denn sitzen?\n");
				return 1;
			}

	
		else if(str=="auf frisierstuhl")
			{
				if(frisierstuhlsitzer!="")
					write("Dort sitzt schon "+capitalize(frisierstuhlsitzer)+".\n");
					
				else	
					{
						write ("Du setzt Dich auf den Frisierstuhl.\n");
						say(TPN+" setzt sich auf den Frisierstuhl.\n");
						TP->SetProp(P_NOMOVE, "Dazu solltest Du erst vom Frisierstuhl aufstehen.\n");
		        frisierstuhlsitzer=TPN;
		      }
		    return 1;
		    }
		    
		else if(str=="auf wartestuhl")
			{
				if(wartestuhl1=="")
					{
						write ("Du setzt Dich auf einen Wartestuhl.\n");
						say(TPN+" setzt sich auf einen Wartestuhl.\n");
            TP->SetProp(P_NOMOVE, "Dazu solltest Du erst vom Wartestuhl aufstehen.\n");
		        wartestuhl1=TPN;
		      }
		    else if(wartestuhl2=="")
					{
						write ("Du setzt Dich auf einen Wartestuhl.\n");
						say(TPN+" setzt sich auf einen Wartestuhl.\n");
            TP->SetProp(P_NOMOVE, "Dazu solltest Du erst vom Wartestuhl aufstehen.\n");
		        wartestuhl2=TPN;
		      }		     	 
				else
					write("Leider sind schon alle Wartestuehle besetzt.\n");
				return 1;
			}
}




aufstehenCmd(string str)
  {  	
  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
		if (str=="auf"||!str)
  	{
  		if(wartestuhl1==TPN)
  			{
  				wartestuhl1="";
  				write("Du stehst vom Wartestuhl auf.\n");
  				say(TPN+" steht vom Wartestuhl auf.\n");
  				TP->SetProp(P_NOMOVE, 0);
  				}
  		else if(wartestuhl2==TPN)
  			{
  				wartestuhl2="";
  				write("Du stehst vom Wartestuhl auf.\n");
  				say(TPN+" steht vom Wartestuhl auf.\n");
  				TP->SetProp(P_NOMOVE, 0);
  				}
  		else if(frisierstuhlsitzer==TPN)
  			{
  				frisierstuhlsitzer="";
  				write("Du stehst vom Frisierstuhl auf.\n");
  				say(TPN+" steht vom Frisierstuhl auf.\n");
  				TP->SetProp(P_NOMOVE, 0);
  				}
  		else
  			write("Du sitzt doch gar nicht.\n");
  				
  		return 1;
  		}
  		return 0;
  	}


string spiegel(object spieler)
{
	string aussehen;
	aussehen=TP->long();
	return break_string(aussehen);
	}