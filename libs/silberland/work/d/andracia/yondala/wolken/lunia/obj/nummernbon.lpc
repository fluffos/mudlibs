#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zettel");
  SetProp(P_LONG,
    "Du haelst einen Zettel mit einer Nummmer in Deinen Haenden. Du kannst "
	"den Zettel lesen." );
  SetProp(P_INFO, "Wenn Deine Nummer aufgerufen wird, kannst Du mit diesem "
  "Zettel einen Antrag stellen.");
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zettel","nummernbon"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  AddReadDetail( ({ "zettel" }),
    "1");

}

