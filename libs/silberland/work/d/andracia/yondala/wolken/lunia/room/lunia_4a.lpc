#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Im Westen steht ein Tempel.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "westen","tempel" }),
    ("Der Tempel ragt hoch ueber Dir auf. Er ist durchaus imposant und wirkt sehr gepflegt."));
  AddDetail( ({ "" }),
    (""));
