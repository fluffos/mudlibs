  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

 //  AddCmd( ({ "betrete", "betritt" }), "betretenCmd" );

  AddExit( "norden", LUNIA_ROOM + "lunia_3a.lpc" );
  AddExit( "sueden", LUNIA_ROOM + "lunia_5a.lpc" );
  AddExit( "westen", LUNIA_ROOM + "yasons_tempel.lpc" );

}
