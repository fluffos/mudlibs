//Stab von Zirpus, heilt bei jedem Treffer mit random 100
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein langer Stab");
  SetProp(P_LONG,
    "Du siehst einen langen Stab. Er ist bunt gestreift und an seinem Ende befindet sich eine leuchtende weisse Kugel." );
  SetProp(P_NAME, "Stab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab"}) );
                                     

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 45 );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_MAGIC}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_EBONY );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 350);
  SetProp(P_QUALITY_DECAY, 100);
  
/*  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );*/

  SetProp(P_WC_BONUS, (["zirpus": 250]) );
  
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
	if(!random(100))
	{
		tell_object(environment(this_object()),"Die Kugel an Deinem Stab leuchtet hell auf und heilt Dich.\n");
		environment(this_object())->AddHp(50);
	}
  return 0;
}
