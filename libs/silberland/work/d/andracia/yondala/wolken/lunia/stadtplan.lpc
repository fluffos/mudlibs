inherit "/std/lightsource";

#include <properties.h>
#include <language.h>
#include <moredef.h>
create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("karte");
  SetProp(P_NAME,"Karte");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Karte");
  SetProp(P_LONG,
      " o-o-o-o.\n"+
      "o       o.\n"+
      "o       o.\n"+
      "o       o.\n"+
      " o-o-o-o.\n");
 
}
