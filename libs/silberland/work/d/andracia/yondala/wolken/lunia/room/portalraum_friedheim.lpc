#include "../def.h"
inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Portal" );
  SetProp( P_INT_LONG,  
    ("Du bist von Mauern umgeben. Wohin Du auch schaust, nur Mauerwerk ueberall. "+
	 "Oben Mauer. Unten Mauer. Rechts Mauer. Links Mauer."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );

  AddDetail( ({ "mauer" }),
    ("Du bist von Mauern umgeben."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");



 // AddCmd( ({ "betrete", }), "betretenCmd" );
 

}

void wirbeltext(object spieler, int i, int ziel)
{
	i++;
	if (i==1)
	{
		tell_object(spieler, "Du findest Dich ploetzlich in einem bunten Wirbel wieder.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}

	if (i==2)
	{
		tell_object(spieler, "Du hast das Gefuehl, dass Du Dich um Dich selbst drehst. Rundherum, von oben nach unten, von rechts nach links.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==3)
	{
		tell_object(spieler, "Alles um Dich herum besteht nur aus Mauerwerk.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==4)
	{
		tell_object(spieler, "Wo ist der Boden? Wo ist der Himmel? Nur noch Mauern um Dich herum.\n");
		call_out("wirbeltext", 3, spieler, i, ziel);
		return;
	}
	if (i==5)
	{
		tell_object(spieler, "Kommen die Mauern naeher?\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	if (i==6)
	{
		tell_object(spieler, "Langsam wird Dir ein bisschen mulmig, Du hast Angst, erdrueckt zu werden.\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;
	}
	
	if (i==7)
	{
		tell_object(spieler, "Ist das da vorne ein Licht?\n");
		call_out("wirbeltext", 4, spieler, i, ziel);
		return;	
	}
	
	else
	{		
		if(ziel==0)//es geht nach Aboriville
			spieler->move("/d/andracia/yondala/friedheim/room/burg/zs_burg_og2_a2.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem Portal heraus");	
		else//es geht nach Lunia
			spieler->move(LUNIA_ROOM + "lunia_6d.lpc", M_GO, "aus dem Portal", "schwebt", "schwebt aus dem gemauerten Portal heraus");
		
		spieler->SetProp(P_PARALYZED, 0);
		return;
		
	}
	
	
	
	
	
	
	
	
}