// Ein Gendarm, der alle einsammelt, die sich pruegeln oder besoffen sind


inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>

void init()
{
	::init();
	call_out("check",5);
	if (this_player() && this_player()->id("GENDARM")) AddDefender(this_player());
}	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein Gendarm");
  SetProp(P_LONG,
    "Du siehst einen Mann in den besten Jahren. Er ist mittelgross, hat graubraune Haare und "
    "einen gigantischen Schnautzbart. Auf seinem Kopf trohnt eine blankpolierte Pickelhaube, "
    "am Koerper traegt er eine schwarze Uniform.");
  SetProp(P_NAME, "Gendarm");
  SetProp(P_GENDER, MALE);
  AddId(({"gendarm", "mann", "GENDARM"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 176);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, LUNIA_ROOM+"lunia_9e.lpc");
SetProp (P_MNPC_AREA, LUNIA_ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  

  SetProp(P_MSGIN, "patrouilliert herein"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "sieht eine verdaechtige Person und geht");//verlassen wird
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "eilt davon");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Gendarm");//name des tötenden npc
  SetProp(P_KILL_MSG, "Nun herrschen wieder Recht und Ordnung");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "weiß keine Antwort.\n");//Wenn der LUNIA_NPC keine Antwort hat

  AddInfo("yondala", "Lang lebe Yondala.","sagt: "); //Frage Antwort

        

  AddInfo( ({ "recht","ordnung", "gesetz","gesetze" }),
    "Dafuer lebe ich!",
    "sagt: ");
  AddInfo( ({ "alkohol","trunkenbolde" }),
    "Alkohol wird hier nicht toleriert.",
    "sagt: ");
  AddInfo( ({ "zelle","gefaengnis","gefaengniszelle" }),
    "Randalierer und Trunkenbolde werden zur Ausnuechterung in unsere Gefaengniszelle gebracht.",
    "sagt: ");
  AddInfo( ({ "randalierer" }),
    "Randalierer haben hier nichts verloren. In Lunia herrschen Recht und Ordnung!",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
    
  SUID;
  CLONEME(LUNIA_WEAPON +"schlagstock.lpc" );
  command("zuecke schlagstock");  
  CLONEME(LUNIA_ARMOUR + "gendarm_uniform.lpc");
  CLONEME(LUNIA_ARMOUR + "pickelhaube.lpc");
  command("trage alles");

SetChats(3, ({
   "Der Gendarm haelt nach Unruhestiftern Ausschau.\n",
   "Der Gendarm betrachtet Dich argwoehnisch.\n"}) );
  SetProp(P_SPELLRATE, 10);
  SetProp(P_NOMAGIC,10);

	AddSpell(2,250,
	         "Der Gendarm pruegelt wie wild auf Dich ein.\n",
	         "Der Gendarm pruegelt wie wild auf @WEN ein.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
   
}
void InformDefend(object enemy)
     {
       Kill(enemy);
     }


void check()
{
  if(TO->InFight())return;//wenn er selbst gra kaempft soll nichts geschehen
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
    if (TP->InFight())  //kaempft der Spieler gerade?
    {
    	command("sag Hier wird nicht randalliert, Freundchen!");
    	CLONE(LUNIA_OBJ +"randale.lpc", TP);
    	write("Der Gendarm schnappt Dich und eh Du Dich versiehst hat er Dich abgefuehrt.\n");
			say ("Der Gendarm fuehrt "+TPN+" ab.\n",TP);
			TP->move( LUNIA_ROOM + "zelle.lpc", M_NOCHECK);	
			}
		else if(TP->QueryProp(P_ALCOHOL)>TP->QueryProp(P_MAX_ALCOHOL)/10) //ist der Spieler betrunken?
    	{
    		command("sag Ihr seid ja voellig betrunken, "+TPN+"!");
    		CLONE(LUNIA_OBJ + "alki.lpc", TP);
    		write("Der Gendarm schnappt Dich und eh Du Dich versiehst hat er Dich abgefuehrt.\n");
				say ("Der Gendarm fuehrt "+TPN+" ab.\n",TP);
				TP->move( LUNIA_ROOM + "zelle.lpc", M_NOCHECK);	
			}
			   
    else        // weder kaempfend, noch betrunken
    {
    	write("Der Gendarm tippt an seine Haube und nickt Dir zu.\n");
		  say ("Der Gendarm tippt an seine Haube und nickt "+TPN+" zu.\n",TP);
    }
  }
}	


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  tell_room(environment(TO), "Der Gendarm zeigt keine Reaktion.\n");
  
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


	