//Gibt 1 zurueck, wenn Name Teil des Highscoreeintrags ist
//uebergeben wird Format: " 7. Mar 2019 22:07:00 Yondala 12"
int namefinden(string wer)
{
	int x;
	for(x=23;x<strlen(wer);x++)
		{
			if(wer[x..x]==" ")
			{
				//gefname=liste[position][23..x-1];
				//write("TPN+ "+TPN+" Wer: "+wer[22..x-1]+".\n");
				if(TPN==wer[22..x-1])
					return 1;
				
			}
		}
	
	return 0;
}

int zahlfinden(string eintrag)
{
	int  zahl;
	string stringzahl;
	int x;

	for(x=23;x<strlen(eintrag);x++)
		{
			if(eintrag[x..x]==" ")
			{
				stringzahl=eintrag[x..strlen(eintrag)];
				zahl=to_int(stringzahl);
				
				//write("Zahl: "+zahl+"\n");
				return zahl;
			}
		}

}

void neuerrekord(int gezaehlteFenster)
{
	int i;
	string neuerEintrag;
	string zeit;
	int erledigt;
	string highscoreliste;	
	zeit=ctime(time());	
	liste=({});
	erledigt =0;
	neuerEintrag=zeit[8..9]+"."+zeit[3..7]+zeit[20..23]+zeit[10..18]+" "+TPN+" "+gezaehlteFenster+"\n";	
	
	
	for(i=0;i<=100;i++)
	{
		highscoreliste=read_file("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc", i, 1);
		if(!highscoreliste)break;		
		//write("gezaehlte: "+gezaehlteFenster+ " : zahlfinden "+zahlfinden(highscoreliste)+ "\n");

		if(to_int(gezaehlteFenster)>zahlfinden(highscoreliste)&&erledigt==0)
		{
			liste=liste+({neuerEintrag});
			erledigt=1;
		}
		if(!highscoreliste)break;
		//liste[i-1]=highscoreliste;
		liste=liste+({highscoreliste});
		highscoreliste="";
	}
	
	rm("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc");
	for(i=0;i<sizeof(liste);i++)
	{
	// 	
	//write("i = "+i+"\n");
		
		if(liste[i]) write_file("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc",liste[i]);//+"\n");
	//write("Listei "+i+ " " +liste[i]+"\n");
	}	
	tell_room(TO, "Ein kleines Maennlein kommt und tauscht eine Marmorplatte aus.\n");
}



void ende3(int gezaehlteFenster)
{
	//int bisher;
	int i;
	string Zahlstring;
	int x;
	string highscoreliste;
//Jetzt global:
	//	string *liste; 


	liste=({});

 // 7. Mar 2019 22:07:00 Yondala 12	
	
	for(i=0;i<=100;i++)
	{
		highscoreliste=read_file("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc", i, 1);	
		if(!highscoreliste)break;
		//liste[i-1]=highscoreliste;
		liste=liste+({highscoreliste});
		highscoreliste="";
	}
	i=i-1;
	//write(liste[i]+ " ist der letzte\n");
	//jetzt sind alle zeilen aus highscore2 in dem array "liste"
	
	for(i=0;i<sizeof(liste);i++)
	{
		if(namefinden(liste[i])==1) //Der Name steht schon in der Liste
		{
			//write(TPN+" steht in der Liste.\n");
			//wenn die Zahl am Ende des Listeneintrags kleiner oder gleich der gezaehlten Fenster ist passiert nichts
			Zahlstring=liste[i][23+strlen(TPN)..strlen(liste[i])-2];
			if(to_int(Zahlstring)<gezaehlteFenster)
				
			//if(zahlfinden(liste[i])<gezaehlteFenster)
			{
				//write("Zahlstring:"+Zahlstring+" ist kleiner oder gleich gezaehlte "+gezaehlteFenster+" Fenster.\n");
				//es gibt einen neuen Highscore fuer die Person

				liste=({});
				for(x=1;x<=100;x++)
				{
					if (x==i) x++; //den Eintrag, der schon da war, ueberspringen
					//write("x= "+x+" i= "+i+"\n");
					highscoreliste=read_file("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc", x, 1);
					
					if(!highscoreliste)break;
					//write(highscoreliste);
					liste=liste+({highscoreliste});
					//write("Liste "+liste[sizeof(liste)-1]+"\n");
					highscoreliste="";
				}
				rm("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc");
				//write("Groesse Liste = "+sizeof(liste)+"\n");
				
				for(i=0;i<sizeof(liste);i++)
				{
				  // 	
					//write("i = "+i+"\n");
					if(liste[i]) write_file("/d/andracia/yondala/wolken/lunia/room/highscore2.lpc",liste[i]);//+"\n");
						//write("Listei "+i+ " " +liste[i]+"\n");
					
				}				
				//Hier jetzt die neuen Werte eingeben
				//neuerrekord(gezaehlteFenster);
			}
			
			//wenn die neu gezaehlten Fenster mehr sind
			else 
			{
				//write("Zahlstring:"+Zahlstring+" ist groesser oder gleich gezaehlte "+gezaehlteFenster+" Fenster.\n");
				//es gibt keinen neuen Highscore, beende alles
				return;
			}

			
		}
	}
gezaehlteFenster--;	
neuerrekord(gezaehlteFenster);	
return;		
	
}



void zaehler(object spieler, int fenster)
{
	int verzaehlt;
	verzaehlt=random(300);
  if (spieler && interactive(spieler) && TO==environment(spieler))
	{
		if(verzaehlt==0)	
			{
				tell_object(spieler,"Mist, Du hast Dich verzaehlt. Du fluchst und gibst auf.\n");
				tell_room(TO, spieler->name()+" hat sich verzaehlt und gibt entnervt auf.\n", ({spieler}));
				//ende(spieler, fenster);
				ende3(fenster);
				return;
			}

		else if(verzaehlt==1)
			{
				tell_object(spieler,"Mist, Du hast Dich verzaehlt. Du fluchst und beginnst von Neuem.\n");
				tell_room(TO, spieler->name()+" hat sich verzaehlt und flucht.\n", ({spieler}));
				//ende(spieler, fenster);
				ende3(fenster);
				fenster=0;
			}
		
			else	
			{
			//tell_object(spieler, capitalize(wandler(fenster)) +" Fenster\n");
			tell_object(spieler, wandler(fenster) +" Fenster\n");
			fenster++;			
			call_out ("zaehler",1, spieler, fenster);
			}

		}
	else
		{
			tell_object(spieler,"Du denkst . o O (Wo sind all die Fenster hin?)\n");
			//ende(spieler, fenster);
			ende3(fenster);
			return;
	}
	//ende3(fenster);
}

int zaehlen (string str)
{
	notify_fail("Was moechtest Du zaehlen?\n");
	if (str=="fenster")
	  {
	  	write ("Du beginnst die Fenster zu zaehlen:\n");
		say(TPN+" versucht die Fenster des Gebaeudes zu zaehlen.\n");
		zaehler(this_player(), 1);
	  	return 1;	  	
	  	}
	return 0;
}

