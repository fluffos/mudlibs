string einerwandler(int i)
{
	
	if(i==0) return "";
	if(i==1) return "ein";
	if(i==2) return "zwei";
	if(i==3) return "drei";
	if(i==4) return "vier";
	if(i==5) return "fuenf";
	if(i==6) return "sechs";
	if(i==7) return "sieben";
	if(i==8) return "acht";
	if(i==9) return "neun";
	if(i==10) return "zehn";
	if(i==11) return "elf";
	if(i==12) return "zwoelf";
	if(i==13) return "dreizehn";
	if(i==14) return "vierzehn";
	if(i==15) return "fuenfzehn";
	if(i==16) return "sechszehn";
	if(i==17) return "siebzehn";
	if(i==18) return "achtzehn";
	if(i==19) return "neunzehn";
	
	if(i==20) return "zwanzig";
	if(i==21) return "einundzwanzig";
	if(i==22) return "zweiundzwanzig";
	if(i==23) return "dreiundzwanzig";
	if(i==24) return "vierundzwanzig";
	if(i==25) return "fuenfundzwanzig";
	if(i==26) return "sechsundzwanzig";
	if(i==27) return "siebenundzwanzig";
	if(i==28) return "achtundzwanzig";
	if(i==29) return "neunundzwanzig";

	return to_string(i);
		//return ("nein\n");
}
string wandler(int i)
{
	string zahl;
	string ausgabe;
	
	int tausender;
	int hunderter;
	int zehner;
	ausgabe="";	
	
	//Zahlen ueber 9999 werden nicht vorkommen, insofern irrelevant
	if (i>9999) return to_string(i);
	if(i<=0) return 0;
	
// Zahlen von 1-19 werden einzeln ausgewertet

    if(i<=29) return einerwandler(i);

	

	


	zahl=to_string(i);
	//if(strlen(zahl)==4) //wir sind im Tausenderbereich
	if(i>999)
	{
		tausender = to_int(zahl[0..0]);
		ausgabe=einerwandler(tausender)+"tausend";
		tausender=tausender*1000;
		i=i-tausender;
	}
	if(i>99)
	{
		zahl=to_string(i);
		hunderter = to_int(zahl[0..0]);
		ausgabe=ausgabe + einerwandler(hunderter)+"hundert";
		hunderter=hunderter*100;
		i=i-hunderter;
	}		
	
		

	if(i>29)
	{
		zahl=to_string(i);
		zehner=to_int(zahl[0..0]);
		i=i-zehner*10;
	}		
	
	if(i&&zehner) 
	{
		if(zehner==3)
			ausgabe=ausgabe+einerwandler(i)+"und"+einerwandler(zehner)+ "ssig";
		else ausgabe=ausgabe+einerwandler(i)+"und"+einerwandler(zehner)+ "zig";
	}
	
	if(!i&&zehner) 
	{
		if(zehner==3)ausgabe=ausgabe+einerwandler(zehner)+ "ssig";
		else ausgabe=ausgabe+einerwandler(zehner)+ "zig";
	}	
	
	if(i&&!zehner) ausgabe=	ausgabe+einerwandler(i);
	

	return ausgabe;
	
	
//	return to_string(i);
//	ausgabe=einerwandler(to_int(zahl(0..0)))+"hundert";	
	//write("test: "+i+"\n");	

	
}

void ende (object spieler, int zahl)
{
	int bisher;
	int i;
	string highscore;
	int neu;
    string zeit;

 //7. Mar 2019 22:07:00 Yondala 12	
	highscore=read_file("/d/andracia/yondala/wolken/lunia/room/highscore.lpc");
	for(i=23;i<strlen(highscore);i++)
	{
		if(highscore[i..i]==" ") break;
	}
	bisher=to_int(highscore[i..strlen(highscore)]);
	//tell_object(spieler, "Alter Rekord: "+bisher+" Aktuell: " + zahl+"\n");
	if(zahl>bisher)
	{
		
		zeit=ctime(time());
		tell_object(spieler, "Du hast den alten Rekord gebrochen.\nEin kleines "+
			"Maennlein kommt und tauscht die alte Marmorplatte zu Deinen Fuessen aus.\n");
			
		rm("/d/andracia/yondala/wolken/lunia/room/highscore.lpc");
		write_file("/d/andracia/yondala/wolken/lunia/room/highscore.lpc", zeit[8..9]+"."+zeit[3..7]+zeit[20..23]+zeit[10..18]+" "+TPN+" "+zahl);		
		
		
	}
	//bisher=
}

