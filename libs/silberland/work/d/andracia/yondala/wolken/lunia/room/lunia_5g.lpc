//	int fenster;
void create() 
{
  ::create();
	//fenster=1;

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Im Osten steht ein riesiges Gebaeude.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



  AddDetail( ({ "gebaeude" }),
    ("Das Gebaeude ist riesig gross. Es besteht vollstaendig aus weissem Marmor. Die grosse "
    "Doppeltuer steht weit offen und hin und wieder siehst Du ein Gesicht hinter einem der "
    "vielen Fenster."));
  AddDetail( ({ "doppeltuer", "tuer" }),
    ("Die Tuer besteht eigentlich aus zwei Tueren, die nach innen aufgeschwungen sind und dort "
    "festgestellt wurden. Ueber der Tuer ist ein grosses Schild."));
  AddDetail( ({ "tueren" }),
    ("Soweit Du es erkennen kannst bestehen die beiden Tueren aus Glas."));
  AddDetail( ({ "gesicht" }),
    ("Hin und wieder taucht kurz ein Gesicht hinter den Fenstern des Gebaeudes auf. Wer das wohl sein mag?"));
  AddDetail( ({ "fenster" }),
    ("Das Gebaeude hat sehr viele Fenster. Sie zu zaehlen wuerde zu lange dauern."));
  AddDetail( ({ "glas" }),
    ("Die Tueren des Gebaeudes sind aus Glas."));
  AddDetail( ({ "schild" }),
    ("Das Schild ist recht gross und scheint entweder frisch geputzt oder frisch gemalt worden zu "
    "sein. In grossen Buchstaben steht dort etwas geschrieben."));
  AddDetail( ({ "buchstaben" }),
    ("Du kannst doch lesen, oder?"));
  AddReadDetail( ({ "schild","buchstaben" }),
    (" ______________\n"
     "|              |\n"
     "|   HOSPITAL   |\n"
     "|______________|\n"));
  AddDetail( ({ "marmorplatten","platten" }),
    ("Die Marmorplatten sind wunderhuebsch und sehr sauber, bestimmt wurde hier erst"+
	"kuerzlich gefegt. Eine der Platten traegt eine Gravur."));
  AddDetail( ({ "marmorplatte","platte" }),
    ("Eine der Platten ist graviert."));
	
  AddSpecialDetail( ({ "gravur"  }), "gravur" );
  
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
//  AddCmd( ({ "hi"}), "hi" );  
//  AddCmd( ({ "endi"}), "ende3" );  
  AddCmd( ({ "zaehl","zaehle" }), "zaehlen" );
//  AddCmd( ({ "zahli" }), "zahlfinden" );
//  AddCmd( ({ "zaehlung" }), "zaehlung" );
//  AddCmd( ({ "wandel","wandle" }), "wandler" );

  AddExit( "norden", LUNIA_ROOM + "lunia_4g.lpc" );
  AddExit( "sueden", LUNIA_ROOM + "lunia_6g.lpc" );
  AddExit( "osten", LUNIA_ROOM + "lunia_5h.lpc" );
}


