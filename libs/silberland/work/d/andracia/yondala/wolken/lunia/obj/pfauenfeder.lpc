#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Pfauenfeder");
  SetProp(P_LONG,
    "Du siehst die Feder einen Pfaus. Sie ist lang und blau und am Ende schillert sie in unendlich vielen Farben." );
  SetProp(P_NAME, "Pfauenfeder");
  SetProp(P_GENDER, FEMALE);
  AddId(({"feder","pfauenfeder"}));

  SetProp(P_MATERIAL, MAT_FEATHER );
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 100);

}
