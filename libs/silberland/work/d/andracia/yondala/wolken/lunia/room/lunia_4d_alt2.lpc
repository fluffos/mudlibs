/********************************************************************

Hier steht das Portal zu den Elfen

********************************************************************/

#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

//********************************************************************
//Fuer das Portal

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN))
    result += "Ein hoelzernes Portal.\n";
  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN))
    result += "Ein hoelzernes Portal.\n";
  return result;

}


//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er nach Aboriville teleportiert
int betreten(string str)
{
if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) return 0;
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das steinerne Portal.\n");
  say(TPN+" betritt das steinerne Portal.\n");
  TP->move( "/d/andracia/yondala/aboriville/room/aboriville_3b_o.lpc", M_NOCHECK);
  return 1;
}

//Details fuer das Portal
string erlaubtenamen()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) 
				return "Sowas siehst Du da nicht!\n";
				
  return "Auf den Saeulen wurden folgende Namen eingepraegt:\n"+
    call_other(LUNIA_ROOM + "portal_master", 
                "gesamtnamen_ausgeben", "aboriville");
}

string det_portal()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) 
				return "Sowas siehst Du da nicht!\n";
				
return "Du siehst ein Portal aus edlem Holz. Es besteht aus einem hoelzernen"+
	"Bogen, der auf zwei hoelzernen Saeulen ruht. Ob man es betreten kann?"; 
} 

string det_bogen()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "In den Bogen wurde das Wort \"Aboriville\" gepraegt."; 
} 
string det_saeulen()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "In die Saeulen wurden Namen gedruckt."; 
} 
string det_abori()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "Was mag das nur bedeuten?"; 
} 

void create() 
{
  ::create();
//*************************************************************************
//Portal

  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "aboriville" }),"det_abori");
  AddSpecialDetail( ({ "saeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );

  //***********************************************************************



   SetProp( P_INT_SHORT, "In einem Park" );
  SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten Park. "
  "Um Dich herum stehen praechtige Baeume, die Schatten spenden, der Rasen "
  "ist saftig gruen und in mehreren Beeten bluehen wunderschoene Blumen. "
  "Der Park ist von einer kleinen Hecke umgeben, um ihn vor unbefugtem "
  "Zutritt zu schuetzen.");
  SetProp( P_LIGHT, 1 );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddDetail( ({ "park" }),
    "Du stehst in einem wunderschoenen, gepflegten Park. "
  "Um Dich herum stehen praechtige Baeume, die Schatten spenden, der Rasen "
  "ist saftig gruen und in mehreren Beeten bluehen wunderschoene Blumen. "
  "Der Park ist von einer kleinen Hecke umgeben, um ihn vor unbefugtem "
  "Zutritt zu schuetzen.");
  AddDetail( ({ "baeume" }),
    "Es gibt verschiedene Laubbaeume, aber auch einige beschnittene "
	"Buchsbaeume.");
  AddDetail( ({ "laubbaeume" }),
    "Die Laubbaeume sind gesund und hoch gewachsen. Seltsamerweise liegt "
	"kein Laub unter ihnen.");
  AddDetail( ({ "laub" }),
    "Der Park ist wirklich sehr gepflegt, wenn jedes bisschen Laub gleich "
	"aufgesammelt wird, sobald es faellt.");
  AddDetail( ({ "schatten" }),
    "Die Baeume habe so ausladende Kronen, dass sie genuegend Schatten "
	"werfen.");
  AddDetail( ({ "kronen" }),
    "Die Kronen der Baeume sind hoch ueber Dir, sie sind satt gruen und "
	"sehr dicht.");
  AddDetail( ({ "rasen" }),
    "Der Rasen ist saftig gruen, die Kanten sind sauber geschnitten und Du "
	"glaubst, dass jeder Grashalm die selbe Laenge hat wie der Grashalm "
	"daneben.");
  AddDetail( ({ "kanten" }),
    "Unglaublich, wie akurat da jemand am Werk war.");
  AddDetail( ({ "werk" }),
    "Mit diesem Rasen hat jemand gute Arbeit geleiset.");
  AddDetail( ({ "arbeit" }),
    "Es ist sicher viel Arbeit, einen Rasen so zu pflegen.");
  AddDetail( ({ "grashalm", "grashalme" }),
    "Die Grashalme sind alle sauber auf die selbe Laenge gestutzt worden.");
  AddDetail( ({ "laenge" }),
    "Die Grashalme haben alle die selbe Laenge.");
  AddDetail( ({ "beete","blumenbeete" }),
    "Hin und wieder wird der Rasen von Blumenbeeten unterbrochen.");
  AddDetail( ({ "blumen" }),
    "Herrlich duftende Blumen bluehen in den Beeten am Rand des Weges.");
  AddDetail( ({ "rand" }),
    "Am Rand des Weges sind hin und wieder Blumenbeete.");
  AddDetail( ({ "buchsbaeume" }),
    "Die Buchsbaeume sind so beschnitten und getrimmt, dass sie "
	"unterschiedliche Formen haben.");
  AddDetail( ({ "formen" }),
    "Es gibt Kugeln, Quader, Kegel, Wuerfel und viele mehr.");
  AddDetail( ({ "kugeln","kegel","wuerfel","quader" }),
    "Das sind geometrische Formen.");
  AddDetail( ({ "zutritt" }),
    "Hier darf halt nicht jeder rein.");
  AddDetail( ({ "" }),
    "");
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");


   AddExit( "sueden", LUNIA_ROOM + "lunia_5d.lpc" );

}
	
