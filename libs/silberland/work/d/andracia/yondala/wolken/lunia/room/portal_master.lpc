string gesamtnamen_ausgeben(string gebiet)
{
  string text;
  string *abfrage;
  int i;
  //write("Erlaubte: \n");
  text="";
  if(gebiet=="gierlingen")
    abfrage=namen_gierlingen;
  if(gebiet=="aboriville")
    abfrage=namen_aboriville;
  if(gebiet=="zwirbelstein")
    abfrage=namen_zwirbelstein;
  if(gebiet=="thumfels")
    abfrage=namen_thumfels;
  if(gebiet=="piraten")
    abfrage=namen_piraten;
  if(gebiet=="grueningen")
    abfrage=namen_grueningen;
  
  
  
  for (i=sizeof(abfrage);i--;i>=0)
  {
   text=text+(abfrage[i]+"\n");
   }

 return text;
 }  
  