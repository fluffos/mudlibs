/*
  Regelt das Nutzen der Portale in Andracia
  mit plus_name(gebiet, spielername) fuegt man einen Spielernamen hinzu
  mit minus_name(gebiet, spielername) entfernt man einen Spielernamen 
  mit einzelname_pruefen(gebiet, spielername) prueft man, ob der Spieler 
                                        das entsprechende Portal besitzt
  

*/


#include "../def.h"
#include <properties.h>
#pragma strict_types
#define SAVEFILE LUNIA_ROOM + "portal_master" 
inherit "std/thing.lpc";


mapping verbingungsraeume;
string *namen_gierlingen;
string *namen_aboriville;
string *namen_zwirbelstein;
string *namen_thumfels;
string *namen_piraten;
string *namen_grueningen;

void create() 
{
  ::create();
  /*
verbindungsraeume=([ 
LUNIA_ROOM+"lunia_5e": "/d/andracia/yondala/gierlingshoehle/room/gierlinge_u_8c.lpc",
LUNIA_ROOM+"lunia_4d": "/d/andracia/yondala/aboriville/room/aboriville_3b_o.lpc",
                 
]);*/

  if (!restore_object(SAVEFILE))  
  {
    namen_gierlingen=({"Aginor", "Yason","Yondala"});
    namen_aboriville=({"Aginor", "Yason","Yondala"});
    namen_zwirbelstein=({"Aginor", "Yason","Yondala"});
    namen_thumfels=({"Aginor", "Yason","Yondala"});
    namen_piraten=({"Aginor", "Yason","Yondala"});
	namen_grueningen=({"Aginor", "Yason","Yondala"});
	}
  seteuid(geteuid());
  SUID;
  seteuid(getuid(this_object()));
  restore_object(LUNIA_ROOM+"portal_master.lpc");
  
}

//fuegt einen Namen zur Erlaubten-Liste hinzu
void plus_name(string gebiet, string spielername)
{
  if(gebiet=="gierlingen")
    namen_gierlingen=namen_gierlingen+({spielername});
  if(gebiet=="aboriville")
    namen_aboriville=namen_aboriville+({spielername});
  if(gebiet=="zwirbelstein")
    namen_zwirbelstein=namen_zwirbelstein+({spielername});
  if(gebiet=="thumfels")
    namen_thumfels=namen_thumfels+({spielername});
  if(gebiet=="piraten")
    namen_piraten=namen_piraten+({spielername});
  if(gebiet=="grueningen")
    namen_grueningen=namen_grueningen+({spielername});
  save_object(SAVEFILE); 
 }

 //entfernt einen Namen aus der Erlaubten-Liste
void minus_name(string gebiet, string spielername)
{
  if(gebiet=="gierlingen")
    namen_gierlingen=namen_gierlingen-({spielername});
  if(gebiet=="aboriville")
    namen_aboriville=namen_aboriville-({spielername});
  if(gebiet=="zwirbelstein")
    namen_zwirbelstein=namen_zwirbelstein-({spielername});
  if(gebiet=="thumfels")
    namen_thumfels=namen_thumfels-({spielername});
  if(gebiet=="piraten")
    namen_piraten=namen_piraten-({spielername});
  if(gebiet=="grueningen")
    namen_grueningen=namen_grueningen-({spielername});
  save_object(SAVEFILE); 	
 }
	
//Darf ein bestimmter Spieler das Portal benutzen, 1=ja
int einzelname_pruefen(string gebiet, string spielername)
{
  if(gebiet=="gierlingen")
  {
    if(member(namen_gierlingen,TPN)>=0) return 1;
	}
  	
  if(gebiet=="aboriville")
  {
    if(member(namen_aboriville,TPN)>=0) return 1;
	}
  	
  if(gebiet=="zwirbelstein")
  {
    if(member(namen_zwirbelstein,TPN)>=0) return 1;
	}
  	
  if(gebiet=="thumfels")
  {
    if(member(namen_thumfels,TPN)>=0) return 1;
	}
  	
  if(gebiet=="piraten")
  {
    if(member(namen_piraten,TPN)>=0) return 1;
	}
  	
  if(gebiet=="grueningen")
  {
    if(member(namen_grueningen,TPN)>=0) return 1;
	}
  	
  return 0;	
}


