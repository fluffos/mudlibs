// Dieser kleine Halbling laeuft durchs Land und verkauft Suessigkeiten


inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include <mnpc.h>

	
void create() {
  if (!is_clone(TO)) return;
  ::create();
SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein Halbling mit einem Bauchladen");
  SetProp(P_LONG,
    "Du siehst einen kleinen Halbling vor Dir, der Dich mit allerhand Suessigkeiten aus seinem "
    "Bauchladen lockt. Er laechelt Dich an und deutet immer wieder mit wilden Gesten auf seine Waren."
    "Er traegt eine gruengelb karierte Hose und ein dickes rotes Cordhemd.");
  SetProp(P_NAME, "Halbling");
  SetProp(P_GENDER, MALE);
  AddId(({"halbling", "bauchladenhalbling", "verkaeufer","haendler"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Halbling");
  SetProp(P_SIZE, 126);
  SetProp(P_WEIGHT, 30000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, LUNIA_ROOM+"lunia_1c.lpc");
//SetProp (P_MNPC_AREA, "/d" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  

  SetProp(P_MSGIN, "preist seine Waren an"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "sieht einen Kunden und geht");//verlassen wird
  SetProp(P_MMSGIN, "ist ploetzlich da");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "entschwindet in eine andere Spaehre");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Halbling");//name des toetenden npc
  SetProp(P_KILL_MSG, "Das hab ich nicht erwartet...");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
  AddDetail( ({ "suessigkeiten", "angebot" }),
    "Frag den Halbling doch danach.");
  AddDetail( ({ "bauchladen", "" }),
    "Der Halbing traegt einen kleinen, hoelzernen Bauchladen vor sich, welcher mit allerlei Suessigkeiten gefuellt ist.");
  AddDetail( ({ "gesten", "" }),
    "Der Halbing deutet auf sein Angebot.");
  AddDetail( ({ "hose", "" }),
    "Die karierte Hose des Halbings sieht sehr bequem aus.");
  AddDetail( ({ "hemd", "cordhemd" }),
    "Das Hemd des Halbings scheint nicht mehr ganz frisch zu sein und ist voller Flecken.");
  AddDetail( ({ "flecken", "" }),
    "Die Flecken kommen sicher daher, dass der Halbing selbst gerne nascht.");
    
  AddInfo(DEFAULT_INFO, "zuckt mit den Schultern und sagt: Das muss ich nicht wissen.\n");//Wenn der LUNIA_NPC keine Antwort hat

        
  AddInfo( ({ "suessigkeiten", "suessigkeit", "angebot", "angebote" }),
    "Seht her! Ich habe Zuckerstangen, Popcorn, Liebesaepfel und koestliches Eis",
    "sagt: ");
  AddInfo( ({ "zuckerstange","zuckerstangen" }),
    "Fuer 100 Muenzen koennt Ihr eine herrliche Zuckerstange bei mir erwerben!",
    "sagt: ");
  AddInfo( ({ "popcorn", "portion" }),
    "Fuer 250 Muenzen bekommt Ihr von mir eine Portion Popcorn.",
    "sagt: ");
  AddInfo( ({ "eis" }),
    "Ein herrlich kuehles Eis sollte Euch 200 Muenzen wert sein.",
    "sagt: ");
  AddInfo( ({ "liebesapfel" }),
    "Fuer 260 Muenzen gebe ich Euch den besten Liebesapfel des Landes!",
    "sagt: ");
  AddInfo( ({ "halbling" }),
    "Ich bin ein Halbling.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "hochadel","yason","yondala","aginor","nyx" }),
    "Lang lebe der Hochadel!",
    "sagt: ");
    
/*    SUID;
    CLONEME(LUNIA_ARMOUR + ".lpc");
    CLONEME(LUNIA_ARMOUR + ".lpc");
    command("trage alles");*/
SetChats(3, ({
   "Der Halbling ruft: Kauft Suessigkeiten!\n",
   "Der Halbling fragt: Moechtet Ihr nicht ein Eis haben?\n",
   "Der Halbling fluestert Dir zu: Die Zuckerstangen sind heute besonders zu empfehlen!\n"}) );

   AddCmd(({"kaufe","kauf"}),"kaufenCmd");
   
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int kaufenCmd(string str)
{
switch(str)
{	case "zuckerstange": 
	{      
			if(this_player()->QueryMoney() >= 100)
				{
					this_player()->AddMoney(-100);
					write("Du bezahlst 100 Muenzen und bekommst dafuer eine Zuckerstange.\n");
					say(TPN+" kauft eine Zuckerstange.\n", TP);
					CLONE(LUNIA_OBJ + "zuckerstange.lpc", TP);
				}

			else
				write("Der Halbling sagt: Ihr habt leider nicht genug Geld dabei.\n");
	break;}
case "popcorn": 
	{      
			if(this_player()->QueryMoney() >= 250)
				{
					this_player()->AddMoney(-250);
					write("Du bezahlst 250 Muenzen und bekommst dafuer eine handvoll Popcorn.\n");
					say(TPN+" kauft etwas Popcorn.\n", TP);
					CLONE(LUNIA_OBJ + "popcorn.lpc", TP);
				}

			else
				write("Der Halbling sagt: Ihr habt leider nicht genug Geld dabei.\n");
	break;}

case "eis": 
	{      
			if(this_player()->QueryMoney() >= 200)
				{
					this_player()->AddMoney(-200);
					write("Du bezahlst 200 Muenzen und bekommst dafuer ein leckeres, kuehles Eis.\n");
					say(TPN+" kauft ein Eis.\n", TP);
					CLONE(LUNIA_OBJ + "eis.lpc", TP);
				}

			else
				write("Der Halbling sagt: Ihr habt leider nicht genug Geld dabei.\n");
	break;}
case "liebesapfel": 
	{      
			if(this_player()->QueryMoney() >= 260)
				{
					this_player()->AddMoney(-260);
					write("Du bezahlst 260 Muenzen und bekommst dafuer klebrig suessen Liebesapfel.\n");
					say(TPN+" kauft einen Liebesapfel.\n", TP);
					CLONE(LUNIA_OBJ + "liebesapfel.lpc", TP);
					}

			else
				write("Der Halbling sagt: Ihr habt leider nicht genug Geld dabei.\n");
		break;}
case "apfel": 
	{      
			if(this_player()->QueryMoney() >= 260)
				{
					this_player()->AddMoney(-260);
					write("Du bezahlst 260 Muenzen und bekommst dafuer klebrig suessen Liebesapfel.\n");
					say(TPN+" kauft einen Liebesapfel.\n", TP);
					CLONE(LUNIA_OBJ + "liebesapfel.lpc", TP);
					}

			else
				write("Der Halbling sagt: Ihr habt leider nicht genug Geld dabei.\n");
		break;}
	default: { write("Der Halbing sagt: So etwas habe ich nicht.\n");}
}
return 1;
}	