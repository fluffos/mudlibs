//Der Verkaeufer im Zaubereiartikelladen in Lunia
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Archibald");
  SetProp(P_LONG,
    "Archibald ist das seltsamste Wesen, was Dir je begegnet ist. Du siehst einen hunzeligen "
    "alten Mann vor Dir, der mit einem Nachthemd und einem alten Stiefel, den er auf dem Kopf "
    "traegt bekleidet ist. Sein langer Bart kitzelt seine nackten Fuesse, sodass er stets "
    "leicht verwirrt vor sich hinkichert.");
  SetProp(P_NAME, "Archibald");
  SetProp(P_GENDER, MALE);
  AddId(({"archibald", "verkauefer", "zauberer", "ARCHIBALD"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");
//  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  
  create_default_npc(21);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 156);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 20);
  SetProp(P_NOMAGIC,30);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_MIND:   1.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Archibald");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "kichert.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Archibald will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
/*  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));


  SetAttackChats(10, ({
    ".\n"}) );*/
	
	AddSpell(2,450,
	        "Archibald dreht seinen Kopf weg und wirbelt mit seinen Haenden auf Dich ein.\n",
	        "Archibald dreht seinen Kopf weg und wirbelt mit seinen Haenden auf @WEN ein.\n",
	         ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
/*	AddDefaultSpell(1, 100, DS_DISARM);
	AddDefaultSpell(1, 200, DS_BLIND,
         "Archibald piekst Dir ins Auge.\n",
         "Archibald piekst @WEM ins Auge.\n" );*/
	AddSpell(1,280,
	         "Archibald zieht Dir an den Haaren.\n",
	         "Archibald zieht @WEN an den Haaren.\n",
	         ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );

	
  SetChats(3, ({
    "Archibald stolpert ueber seinen Bart und kichert.\n",
    "Archibald bohrt in der Nase.\n"}) );
  SUID;
/*  CLONEME(LUNIA_WEAPON "" );
  command("zuecke waffe");*/
  CLONEME(LUNIA_ARMOUR+ "nachthemd" );
  CLONEME(LUNIA_ARMOUR+ "stiefel" );
  command("trage alles");
}
