#include "../def.h"

inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Ein praechtiger Regenbogen scheint hier in den Boden zu versinken.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "pfau.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "regenbogen","bogen" }),
    ("Der Regenbogen schillert in vielen bunten Farben. Anders als normale Regenboegen scheint "
    "dieser hier nicht nur aus Licht zu bestehen."));
  AddDetail( ({ "farben" }),
    ("Regenbogenfarben, quasi."));
  AddDetail( ({ "regenbogenfarben" }),
    ("Rot, gelb, blau, gruen, orange, lila."));
  AddDetail( ({ "regenboegen" }),
    ("Normalerweise bestehen Regenboegen nur aus Licht, dieser hier scheint aber recht fest zu "
    "sein."));
  AddDetail( ({ "licht" }),
    ("Der Regenbogen besteht aus Licht und einem anderen, Dir unbekanntem Material."));
  AddDetail( ({ "material" }),
    ("Was es ist kannst Du nicht sagen, allerdings scheint es fest genug um hinauf klettern zu koennen."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));

  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

  AddCmd( ({ "kletter","klettere", "steige","steig" }), "klettern" );

     AddExit( "nordosten", LUNIA_ROOM + "lunia_2b.lpc" );
     AddExit( "sueden", LUNIA_ROOM + "lunia_4a.lpc" );
}
int klettern(string str)
{
	notify_fail("Worauf moechtest Du klettern?\n");
	if(str!="auf regenbogen")return 0;
	write("Du kletterst auf den Regenbogen.\n");
	this_player()->move(LUNIA_ROOM + "regenbogen.lpc", M_GO, 
	"auf den Regenbogen", "klettert", "kommt herauf geklettert");
	return 1;
	
	}