inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
int i;
string farbe;
object fell;
void create() {
  if (!is_clone(TO)) return;
  ::create();

i=random(5);
if(i==0) farbe= "weiss";
if(i==1) farbe= "rot";
if(i==2) farbe= "orangen";
if(i==3) farbe= "braun";
if(i==4) farbe= "gelb";
	
	
  SetProp(P_SHORT, "Ein "+farbe+"er Tiger");
  SetProp(P_LONG,
    "Du siehst einen grossen, "+farbe+"en Tiger der hier gemuetlich und friedlich seine Runden "
    "dreht. Er sieht recht zahm aus, Du bist Dir aber sicher, dass man ihn trotzdem nicht "
    "reizen sollte.");
  SetProp(P_NAME, "Tiger");
  SetProp(P_GENDER, MALE);
  AddId(({"tiger", "", ""}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(21);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, 0);


  SetProp(P_MSGIN, "schleicht herbei");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (LUNIA_ROOM));//+"/d/wolken/yondala/lunia" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, LUNIA_ROOM + "lunia_7b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Tiger");
//  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "knurrt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Tiger kann Deine Sachen nicht tragen.\n" }) );


  SetChats(3, ({
    "Der Tiger schnueffelt an Deiner Hand.\n",
    "Der Tiger reibt sich an Deinem Bein.\n",
    "Der Tiger beaeugt Dich interessiert.\n"}) );

  //SUID;
  CLONEME(LUNIA_ARMOUR"tigerfell.lpc" );
  fell=present("tigerfell", TO);
  fell->farbe(farbe);
}
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
      Attack(TP); 
      break;

    case "fies":
      Attack(TP); 
      break;
    case "frech":
      Attack(TP); 
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schnurrt.",
        "Tiger schnurrt.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schlappert Dir mit seiner Zunge durchs Gesicht.",
        "schlappert "+TPN+" mit seiner Zunge durchs Gesicht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
