int entgifte(string str)
{
  object zube; //zubehandelnder ;o)
	int wieviel;
	if(TO->InFight())//wenn er grad kaempft
		{
			write("Asklepio sagt: Ich habe gerade keine Zeit.\n");
			return 1;
		}

	if(!str||str=="mich")
		zube=TP;
	else if (present(str, environment(TO)))
		zube=present(str, environment(TO));
  else
  	{
  		write("Asklepio fragt Dich: Wen wollt Ihr entgiften lassen, "+TPN+"?\n");
  		return 1;
  	}
  say(TPN+" moechte eine Entgiftung durchfuehren lassen.\n", TP);

	if(zube->QueryProp(P_POISON)==0)
		{
			if(zube==TP) command("sag Aber Ihr seid doch gar nicht vergiftet, "+TPN+"!");
			else command("sag Aber "+zube->name()+" ist doch gar nicht vergiftet, "+TPN+"!");
			return 1;
			}

	if(this_player()->QueryMoney() < 500)
		{
			command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
			return 1;
			}
  
	this_player()->AddMoney(-500);					
	zube->AddPoison(-1);
	if(zube->QueryProp(P_POISON)==0)
		command("sag Es ist mir gelungen, Eure Vergiftung vollstaendig zu heilen, "+TPN+".");
	else
		command("sag Es ist mir gelungen, Eure Vergiftung etwas zu lindern, "+TPN+".");
				
		return 1;
	}
	
int enttaube(string str)
{
  object zube; //zubehandelnder ;o)
	int wieviel;
	if(TO->InFight())//wenn er grad kaempft
	{
		write("Asklepio sagt: Ich habe gerade keine Zeit.\n");
		return 1;
	}

	if(!str||str=="mich")
		zube=TP;
	else if (present(str, environment(TO)))
		zube=present(str, environment(TO));
  else
  	{
  		write("Asklepio fragt Dich: Wen wollt Ihr enttauben lassen, "+TPN+"?\n");
  		return 1;
  	}
  say(TPN+" moechte eine Enttaubung durchfuehren lassen.\n", TP);	
	if(zube->QueryProp(P_DEAF)==0)
	{
		if(zube==TP)
		{
			command("sag KOENNT IHR MICH HOEREN?");
			command("sag Seht Ihr? Ihr seid gar nicht taub, "+TPN+"!");	
	    }
		else	command("sag "+zube->name()+" ist doch gar nicht taub, "+TPN+"!");   	
	}
	
	else
	{
		if(this_player()->QueryMoney() < 200)
		{
			command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
			return 1;
		}
 		this_player()->AddMoney(-200);					
		zube->SetProp(P_DEAF,0);
		command("sag Es ist mir gelungen, Euch von Eurer Taubheit zu erloesen, "+zube->name()+".");
	}

	return 1;
}


int entfroschen(string str)
{
  object zube; //zubehandelnder ;o)
	int wieviel;
	if(TO->InFight())//wenn er grad kaempft
	{
		write("Asklepio sagt: Ich habe gerade keine Zeit.\n");
		return 1;
	}

	if(!str||str=="mich")
		zube=TP;
	else if (present(str, environment(TO)))
		zube=present(str, environment(TO));
  else
  	{
  		write("Asklepio fragt Dich: Wen wollt Ihr entfroschen lassen, "+TPN+"?\n");
  		return 1;
  	}
  say(TPN+" moechte eine Entfroschung durchfuehren lassen.\n", TP);	
	if(zube->QueryProp(P_FROG)==0)
	{
		if(zube==TP)
		{
			command("sag Ihr seid kein Frosch, "+TPN+"!");	
	    }
		else	command("sag "+zube->name()+" ist doch gar kein Frosch, "+TPN+"!");   	
	}
	
	else
	{
		if(this_player()->QueryMoney() < 900)
		{
			command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
			return 1;
		}
 		this_player()->AddMoney(-900);					
		zube->SetProp(P_FROG,0);
		tell_room(TO, "Asklepio schuettet Fluessigkeit aus einer kleinen Ampulle ueber "+zube->name(WEN)+".\n"+zube->name() +" verwandelt sich wieder in einen "+zube->QueryProp(P_RACE)+".\n", ({zube}));
		tell_object(zube, "Asklepio schuettet Fluessigkeit aus einer kleinen Ampulle ueber Dich. Du verwandelst Dich zurueck in einen "+zube->QueryProp(P_RACE)+".\n");
		command("sag Es ist mir gelungen, Euch Eure alte Form wieder zu geben, "+zube->name()+".");
	}

	return 1;
}


int heile(string str)
{
	object zube; //zubehandelnder ;o)
	int wieviel;
	if(TO->InFight())
	{
		write("Asklepio sagt: Ich habe gerade keine Zeit.\n");
		return 1;
	}

	if(!str||str=="mich")
		zube=TP;
	else if (present(str, environment(TO)))
		zube=present(str, environment(TO));
	else
  	{
  		write("Asklepio fragt Dich: Wen wollt Ihr heilen lassen, "+TPN+"?\n");
  		return 1;
  	}
	if(this_player()->QueryMoney() < 800)
	{
		command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
		return 1;
	}
	
	TP->AddMoney(-800);		
	wieviel=20+random(30);
	
	zube->AddHP(wieviel);//(random(50));
	tell_room(environment(TO),"Asklepio haucht "+zube->name(WEM)+" neues Leben ein.\n",({zube}));
	tell_object(zube, "Asklepio haucht Dir neues Leben ein.\n");
  return 1;
}	
	
	
int entblinde(string str)
{	  object zube; //zubehandelnder ;o)
	int wieviel;
	if(TO->InFight())//wenn er grad kaempft
		{
			write("Asklepio sagt: Ich habe gerade keine Zeit.\n");
			return 1;
		}

	if(!str||str=="mich")
		zube=TP;
	else if (present(str, environment(TO)))
		zube=present(str, environment(TO));
  else
  	{
  		write("Asklepio fragt Dich: Wen wollt Ihr entblinden lassen, "+TPN+"?\n");
  		return 1;
  	}
  say(TPN+" moechte eine Entblindung durchfuehren lassen.\n", TP);	
	if(zube->QueryProp(P_BLIND)==0)
		{
			if(zube==TP)
				{
					tell_room(environment(TO),"Asklepio fuchtelt wild mit seinen Haenden herum.\n");
	        command("sag Seht Ihr? Ihr seid gar nicht blind, "+TPN+"!");	
	        }
	     else	command("sag "+zube->name()+" ist doch gar nicht blind, "+TPN+"!");   	
		 }
	
	else
			{
				if(this_player()->QueryMoney() < 300)
					{
						command ("sag Tut mir leid, "+TPN+", aber Ihr habt nicht genug Geld dabei.");
						return 1;
					}
  
  			this_player()->AddMoney(-300);					
				TP->SetProp(P_BLIND,0);
					command("sag Es ist mir gelungen, Euch von Eurer Bindheit zu erloesen, "+zube->name()+".");
 				}
		return 1;
	}
		

