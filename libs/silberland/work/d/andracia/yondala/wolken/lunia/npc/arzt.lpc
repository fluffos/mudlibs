string flucht()
{
		if(TO->InFight())//wenn er grad kaempft
		{
			return("sagt: Ich habe gerade keine Zeit.\n");
			}
	tell_room(environment(TO), "Asklepio sagt: Oh, ein Patient verlangt nach mir...\n"+
	"Asklepio verschwindet durch eine Tuer.\n");
	TO->remove();
//	return ("Asklepio geht nochmal\n");
	
	
	}
