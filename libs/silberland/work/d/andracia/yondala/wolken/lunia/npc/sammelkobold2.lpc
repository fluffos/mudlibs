// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
/*    case "neutral":
      call_out("reaction", 0, TP,
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      break;*/
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

//Er nimmt alles
void allesnehmen()
{
							tell_room(environment(TO),"Der Kobold freut sich.\n ");//kein /n, wegen scrollen
//command("nimm alles");
}

object lebtes(object ding)
{
	if(ding->Query_Prop(P_VALUE)) return ding;
	return 0;
}

//gucken ob was im Raum ist, was nicht lebt (bzw keine Rasse hat)
void sammeln()
{
		//command("nimm alles");

	
	object *rauminhalt;
	int i;
	rauminhalt=all_inventory(environment(TO));
	i=sizeof(rauminhalt);
	for(i;i--;i>=0)
	{
		//if(rauminhalt[i]->living()==0)//&&rauminhalt[i]->QueryProp(P_VALUE)>=0)//QueryProp(P_RACE)) 
		if(!living(rauminhalt[i]))//wenn es kein Lebewesen ist
			{
				if(rauminhalt[i]->QueryProp(P_VALUE)>0)//wenn es was wert ist
					{
    		    tell_room(environment(TO),"Der Kobold freut sich. ");//kein /n, wegen scrollen
						command("nimm "+lowerstring(rauminhalt[i]->name(RAW))+"");
					}
				else
					{
						command("sag "+capitalize(rauminhalt[i]->name())+", was fuer ein Muell.");
    		    tell_room(environment(TO),"Der Kobold zerstoert "+rauminhalt[i]->name()+".\n");
						rauminhalt[i]->remove();
						}

			}
	}
}



