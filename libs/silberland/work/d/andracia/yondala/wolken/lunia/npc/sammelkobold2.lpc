void init()
{
	::init();
	//if(TP->QueryProp(P_LIGHT))
	if(find_call_out("sammeln")) remove_call_out("sammeln"); 
		call_out("sammeln",1);	
}

void goldverstecken2()
{
	tell_room(environment(TO),"Der Kobold versteckt etwas.\n");
  CLONE(LUNIA_OBJ+"goldklumpen_invis.lpc", environment(TO));
  present("goldklumpen",TO)->remove();

}
void goldverstecken()
{//schaut sich nur um, wenn er nicht im Kampf ist. Wenn er kaemoft versteckt erst auf jeden Fall
	if(!InFight())tell_room(environment(TO),"Der Kobold schaut sich mistrauisch um.\n");
	call_out("goldverstecken2",1);

}

void goldmachen4()
{
	tell_room(environment(TO),"Der Kobold grinst.\n");
	if(random(2)==1)	call_out("goldverstecken",20);
}

//zerstoert einen Gegenstand im Inventory und macht es zu Gold
void goldmachen3(object baldgold)
{
	tell_room(environment(TO),capitalize(baldgold->name())+" verwandelt sich in pures Gold.\n");
	call_out("goldmachen4",1);
	baldgold->remove();
  CLONE(LUNIA_OBJ+"goldklumpen.lpc", TO);

}
void goldmachen2(object baldgold)
{
	tell_room(environment(TO),capitalize(baldgold->name())+" beginnt zu gluehen.\n");
	call_out("goldmachen3",1,baldgold);
}

void goldmachen()
{	
	object *inhalt;
	object baldgold;
	mapping map;
	if(InFight()) 
		{
			call_out("goldmachen",300+random(100));
			return;
		}
	inhalt=all_inventory(TO);
	if(sizeof(inhalt))
		{
			baldgold=inhalt[random(sizeof(inhalt))];
			map=baldgold->QueryProp(P_MATERIAL);
			//funzt noch nicht
			if(!member(map,"Au"))//wenn das Ding nicht eh schon aus Gold besteht.
				{
					tell_room(environment(TO),"Der Kobold starrt "+baldgold->name(WEN)+" mit gierigen Augen an.\n");
					call_out("goldmachen2",1,baldgold);
				}
		}

call_out("goldmachen",300+random(100));
	
}
	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  
  call_out("goldmachen",30+random(30));
  SetProp(P_SHORT, "Ein kleiner Kobold");
  SetProp(P_LONG,
    "Ein kleiner Kobold steht hier herum, der sich gierig umsieht. Er hat feuerrote Haare, "
    "leicht schraegstehende, gruene Augen und eine sehr helle Haut, die von vielen hellen "
    "Tupfern unterbrochen wird. Er traegt einen gruenen Hut, ein gruenes Wams und eine gruene "
    "Hose.");
  AddDetail( ({ "haare" }),
    "Die Haare des Kobolds sind feuerrot.");

  AddDetail( ({ "augen" }),
    "Der Kobold schaut Dich aus gruenen Augen an.");
  AddDetail( ({ "tupfer" }),
    "Das werden wohl Sommersprossen sein.");
  AddDetail( ({ "sommersprossen" }),
    "Die Haut des Kobolds ist uebersaeht von kleinen braunen Sommersprossen.");
  AddDetail( ({ "haut" }),
    "Die helle Haut des Kobolds ist braun gesprenkelt.");
  AddDetail( ({ "" }),
    ".");


  SetProp(P_NAME, "Kobold");
  SetProp(P_GENDER, MALE);
  AddId(({"kobold"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 26);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, LUNIA_ROOM+"lunia_1c.lpc");
//SetProp (P_MNPC_AREA, "/d" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  

  SetProp(P_MSGIN, "trippelt herein"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "trippelt");//verlassen wird
  SetProp(P_MMSGIN, "steigt von einem Regenbogen");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "ruft einen Regenbogen und verschwindet");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Kobold");//name des tötenden npc
//  SetProp(P_KILL_MSG, "Das hab ich nicht erwartet...");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
    
  AddInfo(DEFAULT_INFO, "fragt: Kann man das zu Gold machen?\n");//Wenn der LUNIA_NPC keine Antwort hat

        

  AddInfo( ({ "halbling", "halblinge" }),
    "Faules Pack, das das Gold nicht ehrt.",
    "sagt: ");
  AddInfo( ({ "kobold" }),
    "Ich bin ein Kobold.",
    "sagt: ");
  AddInfo( ({ "gold" }),
    "Ich liebe Gold, ich kann fast alles zu Gold machen!",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "hochadel","yason","yondala","aginor" }),
    "Lang lebe der Hochadel!",
    "sagt: ");
    
