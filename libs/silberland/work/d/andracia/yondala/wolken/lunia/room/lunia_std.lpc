#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Ringallee" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  SetProp( P_INT_LONG,  
    ("Du stehst auf einer Allee, die rund um Lunia herum fuehrt. Der Weg ist auf der Aussenseite "
    "gesaeumt von hohen Baeumen hinter denen hin und wieder ein Haus hervorlugt. Auf der "
    "Innenseite des Kreises befindet sich ein herrlicher gepflegter Park der durch eine "
    "kniehohe Hecke abgegrenzt ist. Dahinter siehst Du perfektes Gras in einem satten Gruen "
    "sowie einige praechtige Baeume und Buesche."));

  AddDetail( ({ "allee" }),
    ("Du stehst auf einer herrlichen Allee, die von gut gepflegten Baeume gesaeumt wird."));
  AddDetail( ({ "baeume" }),
    ("Die Baeume sind sehr gerade gewachsen und machen einen hoechst gepflegten Eindruck."));
  AddDetail( ({ "eindruck" }),
    ("Du hast den Eindruck, dass die Baeume regelmaessig gepflegt und beschnitten werden."));
  AddDetail( ({ "lunia", "hauptstadt", "stadt" }),
    ("Lunia ist die Hauptstadt Andracias."));
  AddDetail( ({ "andracia", "welt" }),
    ("Du befindest Dich gerade in der Welt \"Andracia\"."));
  AddDetail( ({ "weg" }),
    ("Du stehst auf einem Weg, der in einem Kreis rund um Lunia fuehrt. Innerhalb dieses "
    "Kreises befindet sich ein reizender Park, ausserhalb stehen einzelne Haeuser."));
  AddDetail( ({ "kreis" }),
    ("Das -> o ist ein Kreis ;o) "));
  AddDetail( ({ "aussenkreis", "aussenseite" }),
    ("Auf dem Aussenkreis der Stadt tummeln sich verschiedene Haeuser."));
  AddDetail( ({ "innenkreis","innenseite","zentrum" }),
    ("Im Zentrum der Stadt liegt ein praechtiger Park, der mit einer kleinen Hecke abgegrenzt wurde."));
  AddDetail( ({ "hecke" }),
    ("Die Hecke ist scheinbar frisch gestutzt, sie ist etwa kniehoch und sehr gepflegt."));
  AddDetail( ({ "gras" }),
    ("Das Gras ist saftig gruen und hat die perfekte Laenge."));
  AddDetail( ({ "laenge" }),
    ("Wie auch immer Du es definierst, die Laenge ist perfekt und alle Grashalme sind exakt gleich lang."));
  AddDetail( ({ "grashalme" }),
    ("Die Grashalme sind alle perfekt und gleich lang."));
  AddDetail( ({ "buesche" }),
    ("Du siehst ein paar gruene Buesche, die wohl gerade frisch zurueck geschnitten wurden."));

  AddDetail( ({ "gruen" }),
    ("Das Gruen ist einfach praechtig."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus makellosen weissen Marmorplatten, die nahtlos ineinander uebergehen."));
  AddDetail( ({ "marmorplatten" }),
    ("Die Marmorplatten sind wunderhuebsch und sehr sauber, bestimmt wurde hier erst kuerzlich gefegt."));
  AddDetail( ({ "himmel" }),
    ("Der Himmel ueber Dir ist strahlend blau und eine freundliche Sonne laechelt auf Dich herab."));
  AddDetail( ({ "sonne" }),
    ("Die Sonne scheint warm und freundlich."));
  AddDetail( ({ "park" }),
    ("Im Zentrum der Stadt wurde ein herrlicher Park angelegt."));
  AddDetail( ({ "haeuser", "haus" }),
    ("Die Haeuser der Stadt befinden sich alle auf dem Aussenkreis."));
  AddDetail( ({ "marmor" }),
    ("Der Marmor ist makellos weiss."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");


}

