#include "../def.h"

inherit "std/thing";

#include <properties.h>

string extrastr;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  AddId("\nfrisur");

  SetProp(P_MATERIAL, MAT_AIR );
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
}

string extra_look()
{
	return capitalize(environment()->QueryPronoun()) + extrastr;
}

void set_extra_look(string str)
{
	extrastr=str;
}