#include "../def.h"

inherit "std/room";

#include <properties.h>

int riegel;
void create() 
{
	
  ::create();
riegel=0;

  SetProp( P_INT_SHORT, "In der Eingangshalle des Gerichts" );
  SetProp( P_INT_LONG,  
    ("Du stehst hier in der Eingangshalle des andracischen Gerichts. Viel ist hier nicht zu sehen. "
    "Eine Wand wird von einigen Baenken gesaeumt, die andere besteht aus einer reinen Fensterfront. "
    "An den zwei anderen Waenden ist jeweils eine Tuer."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  catch(call_other( LUNIA_ROOM + "zelle.lpc", "???"));



  AddDetail( ({ "wand","waende" }),
    ("Eine Wand wird von einigen Baenken gesaeumt, die andere besteht aus einer reinen Fensterfront. "
    "An den zwei anderen Waenden ist jeweils eine Tuer."));
  AddDetail( ({ "baenke" }),
    ("Die Baenke bestehen aus dunklem Holz. Sie dienen vermutlich dazu das Warten zu erleichtern."));
  AddDetail( ({ "holz" }),
    ("Einfaches, braunes Holz."));
  AddDetail( ({ "warten" }),
    ("Falls man hier mal lange warten muss, kann man sich hinsetzen."));
  AddDetail( ({ "fensterfront" }),
    ("Eine der Waende besteht fast nur aus Fenstern."));
  AddDetail( ({ "fenster" }),
    ("Die grossen Fenster mit den verziehrten Rahmen lassen einiges an Sonnenlicht herein."));
  AddDetail( ({ "rahmen", "fensterrahmen" }),
    ("Du findest an den Fensterrahmen allerlei Verziehrungen."));
  AddDetail( ({ "verziehrungen" }),
    ("Du siehst fein herausgearbeitete Schnoerkel und Ornamente."));
  AddDetail( ({ "schnoerkel", "ornamente" }),
    ("Ein verwirrendes Muster, das nicht wirklich einen Sinn ergibt."));
  AddDetail( ({ "muster" }),
    ("Das Muster ist huebsch anzusehen, auch wenn Du keinen Sinn darin erkennen kannst."));
  AddDetail( ({ "sinn", "lauf" }),
    ("Du verfolgst mit den Augen den Lauf der Schnoerkel und Ornamente, doch einen Sinn kannst Du nicht finden."));
  AddDetail( ({ "augen" }),
    ("Waere gruselig, wenn Du Deine eigenen Augen sehen koenntest, oder?"));
  AddDetail( ({ "tuer" }),
    ("Meinst Du die Westtuer oder die Osttuer?"));
  AddDetail( ({ "westtuer" }),
    ("Die Westtuer ist fest verschlossen. Ueber ihr ist ein Schild angebracht."));
  AddDetail( ({ "schild" }),
    ("Du kannst es vermutlich lesen. Darunter haengt eine kleine Tafel, die Du vermutlich auch lesen kannst."));
  AddReadDetail( ({ "schild" }),
    ("______________________________\n"
    "|                              |\n"
    "|  Hauptgerichtssal Andracias  |\n"
    "|______________________________|"));
  AddDetail( ({ "tafel" }),
    ("\"lies Tafel\""));
  AddReadDetail( ({ "tafel" }),
     (" *************************\n"
      "* heute keine Verhandlung *\n"
      " *************************"));
  AddDetail( ({ "osttuer" }),
    ("Vor der Osttuer ist ein dicker Riegel angebracht. Ausserdem koenntest Du durch ein kleines "
     "Guckloch in den Raum dahinter spaehen."));
  AddDetail( ({ "riegel" }),
    ("Ob man ihn beiseite schieben kann?"));
  AddDetail( ({ "guckloch", "raum" }),
    ("Spaeh doch einfach hindurch, wenn Du wissen moechtest, was hinter dieser Tuer ist."));
  AddDetail( ({ "eingangshalle" }),
    ("Du stehst hier in der Eingangshalle des andracischen Gerichts. Viel ist hier nicht zu sehen. "
    "Eine Wand wird von einigen Baenken gesaeumt, die andere besteht aus einer reinen Fensterfront. "
    "An den zwei anderen Waenden ist jeweils eine Tuer."));
  AddDetail( ({ "boden" }),
    ("Der Boden der Eingangshalle besteht aus schwarzweissen Marmorfliesen."));
  AddDetail( ({ "marmorfliesen","fliesen","marmor" }),
    ("Die Marmorfliesen sehen schon etwas aelter aus, wurden aber offenbar vor kurzem erst poliert."));
  AddDetail( ({ "decke" }),
    ("Die Decke ist recht weit oben und sehr unspektakulaer weiss."));
  AddDetail( ({ "sonnenlicht" }),
    ("Das Sonnenlicht durchflutet den Raum."));//und hoffentlich merkt dabei niemand, dass die Fenster nach Norden gehen :o)
  AddDetail( ({ "gericht", "gerichtsgebaeude" }),
    ("Du stehst hier im Gerichtsgebaeude Andracias."));
  AddDetail( ({ "andracia" }),
    ("Nun, Du solltest eigentlich mittlerweile wissen was das ist."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

 // AddCmd( ({ "betrete", }), "betretenCmd" );
 
 

  AddExit( "norden", LUNIA_ROOM + "lunia_8e.lpc" );

  AddCmd(({"spaehe", "spaeh"}),"spaehen"); //Funktion
  AddCmd(({"schiebe", "schieb"}),"schieben"); //Funktion
  AddCmd(({"oeffne"}),"oeffnen"); //Funktion
}


int spaehen(string str) 
{
	string raumbeschreibung; 
	notify_fail("Wodurch moechtest Du spaehen?\n");

  if (str!="durch loch" && str!="durch guckloch") return 0;
  
  if(riegel==1)
  	{
  		write("Das macht grad wenig Sinn. Die Tuer ist auf, geh einfach rein und schau nach was in dem Raum ist.\n");
  		return 1;
  	}
  
  raumbeschreibung = to_object(LUNIA_ROOM+"zelle.lpc")->int_long(TP);
	write ("Du spaehst durch das Guckloch und siehst:\n"+raumbeschreibung);
	say(TPN+" spaeht durch das Guckloch der Osttuer.\n");
	return 1;
}

int oeffnen(string str)
{
	write("Das klappt so nicht.\n");
	return 1;
	
	}
	
int schieben(string str)
{
	notify_fail("Was moechtest Du beiseite schieben?\n");
	
	if(str!="riegel beiseite"&&str!="riegel zur seite") return 0;
		
	if(riegel==1) 
		{
			write("Die Tuer ist doch offen!\n");
			return 1;
		}
		
	write	("Du schiebst den Riegel beiseite, die Tuer geht auf.\n");
	say(TPN+" schiebt den Riegel an der Osttuer beiseite. Die Tuer oeffnet sich.\n");
	riegel=1;
  AddDetail( ({ "osttuer" }),
    ("Die Osttuer ist geoeffnet."));
  AddDetail( ({ "riegel" }),
    ("Der Riegel ist beiseite geschoben.\n"));
	AddExit( "osten", LUNIA_ROOM + "zelle.lpc" );
	call_out("tuerweg", 60);
	call_other(LUNIA_ROOM + "zelle.lpc", "tuerauf");
		return 1;
	
	
	}
	
void tuerweg()
{
	RemoveExit("osten");
	riegel=0;
  AddDetail( ({ "osttuer" }),
    ("Vor der Osttuer ist ein dicker Riegel angebracht. Ausserdem koenntest Du durch ein kleines "
     "Guckloch in den Raum dahinter spaehen."));
  AddDetail( ({ "riegel" }),
    ("Ob man ihn beiseite schieben kann?"));	
  tell_room(TO, "Die Osttuer faellt ins Schloss.\n");
	call_other(LUNIA_ROOM + "zelle.lpc", "tuerzu");
	}