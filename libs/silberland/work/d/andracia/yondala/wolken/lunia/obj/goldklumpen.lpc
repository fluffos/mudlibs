//wird vom Kobold hergestellt
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Goldklumpen");
  SetProp(P_LONG,
    "Du siehst ein kleines Stueckchen Gold. Es leuchtet schwach." );
  SetProp(P_NAME, "Gold");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueckchen", "gold","goldstueckchen", "klumpen","goldklumpen"}));
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, random(50)+50);



}

