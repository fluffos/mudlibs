#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Lunia Ring" );
  SetProp( P_INT_LONG,  
    BS("Dieser Weg fuehrt in einem perfekten Kreis durch Lunia. "+
    "Die Gebaeude die hier in Lunia stehen wurden von den Adligen "+
    "errichtet und hin und wieder duerfen Nichtadlige hier wandeln. "+
    "der Weg wird durch einen knoechelhohen Zaun begrenzt, dahinter ist "+
    "perfektes Gras einer satten Gruenfaerbung. Goldene Blumen wachsen auf "+
    "den Wiesen zwischen den Bauten der Adligen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );


  AddDetail( ({ "weg" }),
    BS("Das perfekte Muster des Mosaiks das den Weg bildet hat verschiedenste "+
    "Motive und Bilder."));
  AddDetail( ({ "kreis", "rund" }),
    BS("In einem weiten Rund fuehrt dieser Weg durch Lunia. Die Adligen von "+
    "Andracia haben hier ihre Residenzen errichtet und herrschen von hier aus "+
    "ueber die Geschicke der Welt."));
  AddDetail( ({ "lunia", "ort" }),
    BS("Dies ist die Stadt der Adligen von Andracia, Lunia. Ein erhabener Ort "+
    "perfekter Schoenheit und absoluter Macht. Die Adligen haben hier ihre ganz "+
    "persoenliche Residenzen. Wenn Adligen den Sterblichen ihre Macht demonstrieren "+
    "wollen und den Erwaehlten einen Blick in die Adligenwelt gewaehren, so werden sie"+
    "manches Mal hierher gebracht um die erhabene Schoenheit Lunias zu schauen. "));
  AddDetail( ({ "gebaeude", "adligenbauten", "residenzen", "residenz" }),
    BS("Jeder Adlige hat hier seine persoenliche Residenz. Jedes ein Symbol seiner Macht "+
    "und seine uneingeschraenkten Herrschaft ueber den jeweilige Teil Andracias. "));
  AddDetail( ({ "adlige", "adligen", "herrscher" }),
    BS("Schau dir doch die Einzelnen Residenzen der Adligen an, vielleicht weilt der "+
    "jeweilige Herrscher ja gerade in seiner Residenz. "));
  AddDetail( ({ "nichtadlig", "nichtadlige", "erwaehlte", "erwaehlten" }),
    BS("Jeder der nicht den Herrschern von Andracia angehoert, wurde entweder hierher "+
    "eingeladen als Belohnung oder zu seiner Gerichtsverhandlung hierhergebracht."));
  AddDetail( ({ "zaun" }),
    BS("Er ist knoechelhoch und eigentlich kein Hindernis, aber irgendwas haelt dich "+
    "trotzdem davon ab den Weg zu verlassen. "));
  AddDetail( ({ "gras" }),
    BS("Perfekt geschnitten, saftig und kein einziges Unkraut waechst dazwischen. Keine "+
    "Fehlstelle unterbricht die gruene Grasdecke. Keine Erhebung oder Huegel stoert die "+
    "gruene Grasflaeche. "));
  AddDetail( ({ "farbe", "faerbung" }),
    BS("Das Gras ist besonders saftiggruen. Die Mosaiken des Weges haben ihre eigenen "+
    "frischen Fraben. "));
  AddDetail( ({ "blumen" }),
    BS("Die wunderschoenen Goldenen Blumen sind zuweit vom Weg entfernt um sie zu pfluecken "+
    "oder naeher zu betrachten. Irgendwas haelt dich davon ab den Weg zu verlassen. "));
  AddDetail( ({ "wiesen" }),
    BS("Die perfekte Gruenflaeche bildet eine Wiese die man sonst nirgends in Andracia finden "+
    "kann. irgendwas haelt dich davon ab die Wiese zu betreten. "));
  AddDetail( ({ "motive", "motiv", "bilder", "bild" }),
    BS("Die bunten Steine die den Weg bilden, zeichnen Bilder von vergangener Zeit und "+
    "vergangener Herrscher die Andracia zu seiner aktuellen Bluete verholfen haben. "));
  AddDetail( ({ "schoenheit" }),
    BS("Der Weg und die Residenzen der Adligen sind von atemberaubender Schoenheit. "+
    "es gibt keinen vergleichbaren Ort in ganz Andracia. "));
  AddDetail( ({ "andracia", "welt" }),
    BS("Diese Welt wird Andracia genannt. Du befindest Dich in ihrer Mitte in der "+
    "Stadt der Adligen, die die Geschicke der bekannten Welt lenken. "));
  AddDetail( ({ "geschicke", "schicksal", "macht", "blick" }),
    BS("Alle Entscheidungen der Adligen zum Wohle Andracias werden hier getroffen. "+
    "Aber auch die Verbrecher und Stoerenfriede bekommen hier bescheid ueber das "+
    "Schicksal das die Adligen uber den Deliquenten verhaengen. "));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Ein unglaublich wohlriechender Duft von Erhabenheit herrscht hier. \n");

  AddSmell( ({ "duft", "erhabenheit" }),
    "Ein unglaublich wohlriechender Duft von Erhabenheit herrscht hier. \n");
}

