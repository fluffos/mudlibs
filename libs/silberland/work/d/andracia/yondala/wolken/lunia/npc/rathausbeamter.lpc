#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"
#include <moredef.h>
inherit "std/npc";
#include <language.h>

void create() {

  ::create();
SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Ein Beamter");
  SetProp(P_LONG,
    "Ein Beamter, er sieht etwas besorgt aus.");
  SetProp(P_NAME, "Beamter");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");

  AddId(({"beamter"}));//Dinge auf die man ihn beim untersuchen ansprechen kann

  create_default_npc(15);// Die Zahl entspricht der Spielerstufe des LUNIA_NPC
  
  SetProp(P_RACE, "Halbling");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 40000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 1, "ist zu muede zum kaempfen.");


  SetProp(P_MMSGIN, "betritt den Raum.");
  SetProp(P_MMSGOUT, "verlaesst den Raum.");

  SetChats(3, ({
    "Der Beamte sagt: Ich kann Euer Eigentum vor dem Weltuntergang schuetzen!\n",
    "Der Beamte fluestert: Der Weltuntergang ist nahe, rette sich wer kann!\n"}) );
    
  AddInfo(DEFAULT_INFO, "tut beschaeftigt.\n");//Wenn der LUNIA_NPC keine Antwort hat

  AddInfo("yondala", "Lang lebe Lady Yondala!","sagt: "); 
  AddInfo("yason", "Lang lebe Gott Yason!","sagt: ");
  AddInfo("aginor", "Lang lebe Lord Aginor!","sagt: "); 
       
  AddInfo( ({ "hilfe" }),
    "Ich kann Euch helfen Euer Eigentum vor dem Weltuntergang zu beschuetzen! Gebt mir, was "
    "ich schuetzen soll und ich wandel es um.",
    "sagt: ");        
  AddInfo( ({  "weltuntergang", "reboot" }),
    "Wenn die Welt untergeht, dann ist alles verloren!",
    "sagt: ");        
  AddInfo( ({ "eigentum" }),
    "Gebt mir, was ich schuetzen soll und ich wandel es um.",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");
    
    
}

// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht.",
        "lacht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schlaegt mit der Faust auf den Tresen.",
        "schlaegt mit der Faust auf den Tresen.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt.",
        "schmunzelt.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schimpft ueber Dich.",
        "schimpft ueber " +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "singt ein raues Lied.", 
        "singt ein raues Lied.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
//    case "neutral":
//      call_out("reaction", 0, TP,
  //      "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
    //    "prudi zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      //break;
    case "traurig":
      call_out("reaction", 0, TP,
        "wird sentimental.",
        "wird sentimental.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
 
 
}


give_notify(object ob)//anschauen was gegeben wird
 {
  	if(ob->SetProp(P_AUTOLOADOBJ,1))
	  	command("sag "+capitalize(ob->name())+" wird Euch bei einem Weltuntergang nun nicht mehr verloren gehen.");
	  else
	  	command("sag "+capitalize(ob->name())+" kann ich leider nicht von einem Weltuntergang schuetzen.");
  	ob->move(TP, M_GET);//gibt zurueck
  	 
  	}
  	