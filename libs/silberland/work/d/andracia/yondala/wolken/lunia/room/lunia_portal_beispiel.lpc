/*
Hier ein Beispiel Portal

WICHTIG: Jedes neue Portal ist unbedingt anzumelden.
Derzeit gibt es Portal von Lunia zu:
- Gierlingen
- Aboriville
- Zwirbelstein
- Thumfels
- Pirateninsel
- Grueningen

Portale werden in den jeweiligen Raum integriert, dazu ist der unten 
stehende Code zu benutzen.

Es ist darauf zu achten, dass in der Funktion betreten() der korrekte 
Zielpfad eingegeben wird.
Alle Details, die das Portal beschreiben, muessen durch AddSpecialDetail()
dargestellt sein und eine Abfrage 
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", zielort, TPN)) 
				return "Sowas siehst Du da nicht!\n";
enthalten, wobei zielort der Ort ist, der durch das Portal mit Lunia 
verbunden ist, in diesem Beispiel Portal ist es zielort

*/
#include "../def.h"
#include <properties.h>
inherit "std/room";

//Diese Variable vereinfacht das aendern des Ausgangs
string zielort;

//Hier werden die Namen aller Spieler angezeigt, die das Portal benutzen 
//duerfen, wenn der betrachtende Spieler das Portal sehen kann
string erlaubtenamen()
{
  if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", zielort, TPN)) 
				return "Sowas siehst Du da nicht!\n";
				
  return "Auf den Saeulen wurden folgende Namen eingepraegt:\n"+
    call_other(LUNIA_ROOM + "portal_master", 
                "gesamtnamen_ausgeben", zielort);
}


void create() 
{
  ::create();

//*************************************************************************
//Portal

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");
  zielort="gierlingen";

//***********************************************************************
//Normale Properties des Raumes sind hier zu setzen 
  SetProp( P_INT_SHORT, "In einem Park" );
  SetProp( P_INT_LONG, "Du stehst in einem wunderschoenen, gepflegten Park.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );



}

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", zielort, TPN))
    result += "Ein steinernes Portal.\n";
  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", zielort, TPN))
    result += "Ein steinernes Portal.\n";
  return result;

}


//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er an den Zielort teleportiert, hier Gierlingen
//Der Pfad ist individuell anzupassen
int betreten(string str)
{
if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", zielort, TPN)) return 0;
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das steinerne Portal.\n");
  say(TPN+" betritt das steinerne Portal.\n");
  TP->move( "/d/andracia/yondala/gierlingshoehle/room/gierlinge_5e.lpc", M_NOCHECK);
  return 1;
}

