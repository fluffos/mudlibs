(Anatol) teilt Dir mit: das Ding was _darf_. Dann restore_object() auf erfolg
(Anatol) teilt Dir mit: pruefen, dass, falls das Savefile fehlt, die Variablen
(Anatol) teilt Dir mit: initialisiert werden koennen.
(Anatol) teilt Dir mit: in add() steht eigentlich nur die wichtige Lektion:
(Anatol) teilt Dir mit: wenn Du an einer Variable, die Du speicherst, was
(Anatol) teilt Dir mit: aenderst, speicher _sofort_. :)
(Anatol) teilt Dir mit: Eigentlich ganz einfach.
   
*/
#include "../def.h"

inherit "std/thing";
#include <moredef.h>
#include <properties.h>
#pragma strict_types
#define SAVEFILE "/d/andracia/yondala/lunia/obj/portal_l_gierlinge" 

string *erlaubte;

string erlaubtenamen()
{
  string text;
  int i;
  write("Auf den Saeulen wurden folgende Namen eingepraegt:\n");
  for (i=sizeof(erlaubte);i--;i>=0)
  {
   write(erlaubte[i]+"\n");
   }
   return ".";
}
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
 
  seteuid(getuid(this_object()));
  if (!restore_object(SAVEFILE))  erlaubte=({"Aginor", "Yason","Yondala"});
  
  SetProp(P_SHORT, "Ein goldenes Portal");
  SetProp(P_LONG,
    "Du siehst ein Portal aus purem Gold. Es besteht aus einem goldenen "
	"Bogen, der auf zwei goldenen Saeulen ruht. Ob man es betreten kann?" );
  AddDetail( ({ "bogen" }),
    "In den Bogen wurde das Wort \"Gierlingen\" gepraegt.");
  AddDetail( ({ "gierlingen" }),
    "Was mag das nur bedeuten?");
  AddDetail( ({ "saeulen" }),
    "In die Saeulen wurden Namen gedruckt.");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
	SetProp(P_INFO, "");
  SetProp(P_NAME, "Portal");
  SetProp(P_GENDER, NEUTER);
  AddId("portal");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );
AddCmd( ({ "darf"}), "duerfen" );
AddCmd( ({ "darfauch"}), "auchduerfen" );
seteuid(geteuid());
  SUID;
  restore_object(OBJ+"portal_l_gierlinge.lpc");
}

int auchduerfen(string str)
{
  erlaubte=erlaubte+({str});
   //save_object(OBJ+"portal_l_gierlinge.lpc");
   save_object(SAVEFILE); 
   
   //restore_object();
   return 1;
  }


int betreten(string str)
{
  restore_object(OBJ+"portal_l_gierlinge.lpc");
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  
  if(member(erlaubte,TPN)<0)
  {
    write("Da Du nicht weisst, wohin Dich das Portal fuehren wird, kannst Du es nicht betreten.\n");
	return 1;
	}
  write("Du betrittst das goldene Portal.\n");
  say(TPN+" betritt das goldene Portal.\n");
  TP->move( "/d/andracia/yondala/gierlingshoehle/room/gierlinge_5e.lpc", M_NOCHECK);
  return 1;
}

int duerfen()
{
  string text;
  int i;
  write("Erlaubte: \n");
  for (i=sizeof(erlaubte);i--;i>=0)
  {
   write(erlaubte[i]+"\n");
   }

 return 1;
 }