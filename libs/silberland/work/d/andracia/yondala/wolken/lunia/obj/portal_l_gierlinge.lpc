/*(Anatol) teilt Dir mit: du solltest auf ~anatol zugreifen koennen. Kuck Dir
(Anatol) teilt Dir mit: mal ~anatol/o/so.c an

// simple example of load/save_object() 13.02.2012 

#pragma strict_types
#define SAVEFILE "/players/anatol/save/so" // ".o" is appended automatically.

mapping x;                // non-nosave variables will be saved in savefiles.
nosave mapping y;         // nosave variables will NOT be saved in savefiles.

void create() {
   seteuid(getuid(this_object()));         // file access needs a proper EUID
   if (!restore_object(SAVEFILE))          // always initialize, ...
     x=([]);                               // ... default values, if anything.
}

int add() {
   x+=([time():file_name(previous_object())]);
   save_object(SAVEFILE);                  // always save after changes. 
}

int print() { printf("%O\n",x); }          // demonstration purpose only
   

   
(Anatol) teilt Dir mit: hoe, ich habs kommentiert! :)
