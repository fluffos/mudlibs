inherit "std/thing";

#include <thing.h>
#include <properties.h>
//#include "/players/aginor/misc/def.h"
#include <moredef.h>
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Knallbonbon");
  SetProp(P_LONG,
    "Ein kleiner Knubbel in rot glaenzendem Papier. Die Enden verfuehren dazu an"
    " ihnen zu ziehen." );
  SetProp(P_INFO, "");//geheime Info
  SetProp(P_NAME, "Knallbonbon");
  SetProp(P_GENDER, 0);
  AddId(({"knallbonbon","bonbon"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 0);

  AddCmd(({"ziehe", "zieh"}),"cmdZiehen"); //Funktion
}

int cmdZiehen(string str)

{ notify_fail("Was willst du ziehen?\n");
if(str=="ende" || str=="enden" || str=="an bonbon" || str=="an knallbonbon" || str=="an ende" || str=="an enden")
{
		write("Du ziehst feste an beiden Enden des Bonbons. \n"
			"PENG! \n"
			"Deine Haare stehen dir zu Berge! \n");
		say(TPN+" zieht feste an beiden Enden des Bonbons. \n"
			"PENG! \n");
    if (FEMALE==this_player()->QueryProp(P_GENDER)){
    	SetProp(P_TITLE, "der die Haare zu Berge stehen",TP);    		
    }
    else{
    	SetProp(P_TITLE, "dem die Haare zu Berge stehen",TP);
    }	
  	this_object()->remove();
		return 1;
}
}
