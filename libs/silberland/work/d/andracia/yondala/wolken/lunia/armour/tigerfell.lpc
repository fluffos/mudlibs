#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Tigerfell");
  SetProp(P_LONG,
    "Du siehst ein Tigerfell welches sehr stabil und auch warm aussieht." );
 SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6 ]) );

  SetProp(P_NAME, "Tigerfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "tigerfell", "\nfell_is_gerb_able"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 100);
                                    

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
  {
  	int prot;
    prot = 0;
    if (member(dtyp, DT_COLD) >= 0)   /* Eis unter den Schadenstypen */
    	{
    		prot = 5 + random(5);  
		    tell_object(environment(TO), "Das Tigerfell schuetzt Dich ein wenig vor dem Eis.\n");		
		  }
		  return prot;
}

farbe(string farbe)
{
  SetProp(P_SHORT, "Ein "+farbe+"es Tigerfell");
  SetProp(P_LONG,
    "Du siehst ein "+farbe+"es Tigerfell welches sehr stabil und auch warm aussieht." );

	}