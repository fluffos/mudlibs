#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zur weissen Kugel" );
  SetProp( P_INT_LONG,  
    ("Du befindest Dich in einem kugelrunden Raum. Alles hier ist weiss. In der Mitte des Raumes "
    "schwebt eine weisse Theke auf einer dicken weissen Wolke. Du rutscht mit Deinen Fuessen "
    "aufgrund der Kruemmung immer wieder in die Mitte des Raumes."));
  AddItem(LUNIA_NPC + "aeron.lpc",REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "AERON");
  SetProp( P_PUBKEEPER_NAME, "Aeron");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddDrink("Sanfter Engel", ({ "sanfter engel","sanfter","sanft" }),70,5,0,0, //Preis, Volumen, Alk
  ({ "Aeron mixt Dir einen koestlich fruchtig erfrischenden sanften Engel zusammen. Du trinkst ihn "
  	"und bist hellauf begeistert.",
       "&& trinkt voller Begeisterung einen sanften Engel." }) );

  AddDrink("Blauer Engel", ({ "blauer engel","blauer","blau" }),140,10,7,3, //Preis, Volumen, Alk
  ({ "Aeron mixt Dir einen koestlichen blauen Engel zusammen. Du trinkst ihn und fuehlst Dich "
  	"wie im siebten Himmel.",
       "&& trinkt voller Begeisterung einen blauen Engel." }) );
  AddDrink("alkoholfreier Wodka", ({ "wodka","alkoholfreier","alkoholfreier wodka" }),540,5,10,10, //Preis, Volumen, Alk
  ({ "Aeron greift unter die Theke und schuettet Dir schnell einen Drink ein, den Du sofort ext.",
       "&& ext einen Drink." }) );

  AddDrink("Jasmintee", ({ "tee","jasmintee","jasmin" }),140,10,0,2, //Preis, Volumen, Alk
  ({ "Aeron wirft ein paar Jasminblueten in eine Tasse, giesst Wasser hinzu und bringt den Tee "
  	"mit einem Blick zum Kochen. Er reicht Dir die Tasse und Du geniesst den herrlichen Tee.\n",
       "&& bekommt einen frischen, heissen Jasmintee und schluerft ihn vorsichtig." }) );


  AddFood( "Bauschwoelkchen", ({ "bausch", "woelkchen", "bauschwwoelkchen" }), 60,12,2,
            ({ "Aeron pflueckt ein Stueck aus der Wolke, steckt es auf einen Stiel und ueberreicht "
            	"ihn Dir. Du vernaschst das Woelkchen und laesst nicht ein Kruemelchen uebrig.",
                        "&& nascht ein Bauschwoelkchen. "
            }) );    

  AddFood( "Mondkuchen", ({ "mond", "kuchen", "mondkuchen" }), 300,20,6,
            ({ "Aeron serviert Dir einen klebrig suessen Mondkuchen.",
                        "&& bekommt einen klebrig suessen Mondkuchen. "
            }) );

  AddFood( "Sturmsack", ({ "sack", "sturm", "sturmsack" }), 600,50,10,
            ({ "Aeron reicht Dir einen dicken, sahnigen Sturmsack. Du verputzt ihn auf der Stelle "
            	"und reibst Dir wohlig Deinen vollen Bauch.\n",
                        "&& verputzt einen ganzen Sturmsack. "
            }) );
AddFood("Heuschreckenlollie", ({ "lollie", "heuschrecke", "heuschreckenlollie" }),150,0,4,"schrecke");


  
  AddDetail( ({ "kugel","raum", "inneren", "inneres","innen" }),
    ("Der ganze Raum ist kugelrund, denn Du befindest Dich im Inneren einer Kugel."));
  AddDetail( ({ "mitte" }),
    ("Mitten im Raum schwebt eine dicke Wolke auf der eine weisse Theke steht."));
  AddDetail( ({ "wolke" }),
    ("Die Wolke ist sehr dick und undurchsichtig, sie schwebt mitten im Raum und bewegt sich "
    "dabei nur leicht."));
  AddDetail( ({ "theke" }),
    ("Die Theke ist weiss und makellos sauber. Woraus sie gefertigt wurde kannst Du leider "
    "auf den ersten Blick nicht erkennen."));
  AddDetail( ({ "blick" }),
    ("Auf den ersten Blick kannst Du es nicht erkennen."));
  AddDetail( ({ "zweiter blick","zweiten blick" }),
    ("Auf den zweiten Blick glaubst Du zu erkennen, dass die Theke aus Elfenbein besteht."));
  AddDetail( ({ "elfenbein" }),
    ("Dich gruselt ein wenig bei dem Gedanken."));
  AddDetail( ({ "gedanke","gedanken" }),
    ("Du denkst . o O  (Macht man Elfenbein eigentlich aus Elfenbeinen?)"));
  AddSpecialDetail( ({ "elfenbeine"  }), "beine" );
  AddDetail( ({ "fuesse" }),
    ("Deine Fuesse stehen relativ unfest auf dem konkaven Boden."));
  AddDetail( ({ "boden" }),
    ("Der Boden ist reinweiss und aus einem Stueck, zumindest kannst Du keine Bearbeitungsspuren "
    "entdecken. Ausserdem ist er - da Du Dich ja in einer Kugel befindest - konkav und Du rutschst "
    "staendig in die Mitte des Raumes."));
  AddDetail( ({ "stueck" }),
    ("Der ganze Raum scheint aus einem Stueck."));
  AddDetail( ({ "bearbeitungsspuren" }),
    ("Entweder die Kugel besteht aus einem Stueck, oder aber die Uebergaenge wurden meisterhaft "
    "verspachtelt."));
  AddDetail( ({ "uebergaenge" }),
    ("So angestrengt Du auch schaust, Du kannst tatsaechlich keine erkennen."));
  AddDetail( ({ "waende" }),
    ("Eigentlich kann man von nur einer Wand reden, schliesslich gibt es keine Ecken."));
  AddDetail( ({ "ecken" }),
    ("Was meinst Du, was hier nun stehen sollte? Vielleicht ein bloeder Witz?"));
  AddDetail( ({ "witz" }),
    ("Wie bringt man einen Zwerg um den Verstand?"));
  AddDetail( ({ "zwerg","verstand" }),
    ("Steck ihn in einen runden Raum und sag ihm, dass in der Ecke ein Edelstein liegt."));
  AddDetail( ({ "ecke" }),
    ("Immernoch keine da."));
  AddSpecialDetail( ({ "edelstein"  }), "edelstein" );
  AddSpecialDetail( ({ "zwerg"  }), "zwerg" );
  AddDetail( ({ "kundschaft" }),
    ("Jeder, der hier etwas bestellt ist ein Kunde."));
  AddDetail( ({ "kunde" }),
    ("Um zu sehen was Du hier bestellen kannst tippe doch <menue>."));
  AddDetail( ({ "wand" }),
    ("Die Wand, die eigentlich auch gleichzeitig Boden und Decke ist besteht aus einem Material "
    "das Dir gaenzlich unbekannt ist. Es fuehlt sich kalt und fest an, dennoch dringt Tageslicht "
    "herein. Du ueberlegst, ob es sich um eine Art Glas handeln koennte. Ausser der Tuer, durch die "
    "Du gekommen bist ist die Wand herzlichst uninteressant."));
  AddDetail( ({ "material" }),
    ("Den Eigenschaften nach koennte es Milchglas sein."));
  AddDetail( ({ "eigenschaften", "milchglas", "glas", "art" }),
    ("Es koennte sein, sicher bist Du Dir aber nicht so wirklich."));
  AddDetail( ({ "tageslicht" }),
    ("Das Tageslicht scheint durch die Wand und erhellt den Raum ausreichend."));
  AddDetail( ({ "tuer" }),
    ("Nun, was man so Tuer nennt. Letztlich ist es ein rechteckiges Loch."));
  AddDetail( ({ "loch" }),
    ("Durch das Loch bist Du herein gekommen und durch das Loch kannst Du die Kugel auch wieder "
    "verlassen."));
  AddDetail( ({ "decke" }),
    ("Nun, da Du in einer Kugel stehst koennte man doch glatt behaupten, dass die Decke doch auch "
    "irgendwie die Wand ist. Zumindest kannst Du nicht definieren wo das eine aufhoert und das "
    "andere anfaengt."));
  AddDetail( ({ "kruemmung" }),
    ("Der ganze Raum ist nach innen gekruemmt. Klar, Du stehst ja auch in einer Kugel."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    " ");

  AddSound( ({ "" }),
    "");
  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");


  AddExit( "nordwesten", LUNIA_ROOM + "lunia_6g.lpc" );
}


string beine()//Detail fuer Rassen.
{
	if (TP->id("Elfenspieler")) return("Nun, solche wie Deine...\n");
	else return break_string("Du bist keine Elfe, hast also auch keine Elfenbeine. Logisch, oder?\n");

	}

string edelstein()
{
	if (TP->id("zwergenspieler")) return("Gieriger, kleiner Zwerg! Nein, hier ist keiner, sonst"+
		" wuerde ihr zwergische Kundschaft ja jedesmal durchdrehen.\n");
		
  return ("Keiner da, sonst wuerde die zwergische Kundschaft jedesmal durchdrehen.");
}

string zwerg()
{
	if (TP->id("zwergenspieler")) return("Du weisst schon, dass Du ein Zwerg bist, oder?\n");
		
  return ("Keiner da? Dann liegts sicher daran, dass hier keine Edelsteine sind.\n");
}




schrecke(object zahler, object esser)
{
	if (TP->id("Elfenspieler"))//Elfen duerfen das nicht essen
  	{
			esser->SetProp(P_POISON, (esser->QueryProp(P_POISON)+1));//Vergiftung+1
			esser->eat_food(-5,0);//nimmt das Essen was nun drin ist raus und noch einen mehr.
			tell_object(esser, "Du lutscht froehlich an dem Lollie. Erst ist er suess und lecker, doch dann "
			"wird Dir schlecht als Du das tote Insekt in Dir spuerst.\nDu uebergibst Dich.\n");
	       		tell_room(this_object(),
        	        esser->name(WER)+" uebergibt sich nach dem \"Genuss\" eines Heuschreckenlollies.\n",({ esser }) );     		
		
		}
	else
		{
			esser->AddMp(60);
  	  esser->AddHp(60);   
     	tell_object(esser,"Du lutscht genuesslich an dem Lollie und knusperst danach die darin konservierte Heuschrecke.\n");
      tell_room(this_object(),
      esser->name(WER)+" lutscht und knuspert einen Heuschreckenlollie.\n",({ esser }) );     		
		 }
}



