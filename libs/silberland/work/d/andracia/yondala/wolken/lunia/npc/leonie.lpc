
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

	
  SetProp(P_SHORT, "Der Geist von Leonie");
  SetProp(P_LONG,
    "Du siehst den Geist einer kleinen, strubbeligen Katze. Auch wenn sie "+
	"leicht durchscheinend ist, er kennst Du das schwarz-grau getigerte "+
	"Fell, das in alle Richtungen absteht. Leonie fehlen ein paar Zaehne "+
	"und auch der Schwanz ist nicht mehr vollstaendig. Leonie wurde so "+
	"sehr geliebt, dass sie einfach noch nicht gehen kann.");
  SetProp(P_NAME, "Leonie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"katze", "geist", "leonie"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 4000);
  SetProp(P_ALIGN, 0);


  SetProp(P_MSGIN, "schleicht herbei");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (LUNIA_ROOM));//+"/d/wolken/yondala/lunia" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, LUNIA_ROOM + "lunia_7b.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Leonie");
//  SetProp(P_KILL_MSG, "Du hattest keine Chance!");
SetProp(P_NOATTACK, "Leonie ist doch schon tot.");
  AddInfo(DEFAULT_INFO, "knurrt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Lenie kann nichts tragen.\n" }) );


  SetChats(3, ({
    "Leonie schnueffelt an Deiner Hand.\n",
    "Leonie leckt sich ein Pfoetchen.\n",
    "Leonie flippt aus und rast wie verrueckt durch den Raum.\n",
    "Leonie schnurrt.\n",
    "Leonie maunzt.\n",
    "Leonie reibt sich an Deinem Bein.\n",
    "Leonie beaeugt Dich interessiert.\n"}) );

  //SUID;

}

