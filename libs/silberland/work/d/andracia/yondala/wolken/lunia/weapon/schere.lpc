#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine magische Schere");
  SetProp(P_LONG,
    "Du siehst eine grosse, scharf geschliffene Schere." );
  SetProp(P_INFO, "Mit dieser Schere kann man Frisuren zaubern, wenn man denn mit ihr "
  "umgehen kann. Ansonsten ist sie eine ganz brauchbare Waffe.");
  SetProp(P_NAME, "Schere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schere", ""}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["rene": 100]) );
//  SetProp(P_WIELD_RESTRICTIONS, ([A_:]) );
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
