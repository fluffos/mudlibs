//Kunibert clont dieses Tick im Kampf in den Spieler
#include "../def.h"
inherit "std/thing";
#include <properties.h>
int ticken;
void ticker()
{
	int i;
	i=random(50);
	if(!i) 
	{
		tell_object(environment(TO),"Dein nervoeses Ticken laesst nach.\n");
		remove();
	}
	
	if(interactive(environment(TO)))
	{
		if(i==1)tell_object(environment(TO),"Ticki\n");
		else if(i==2)tell_object(environment(TO),"Tock\n");
		else if(i==3)tell_object(environment(TO),"TickTock\n");
		else if(i==4)tell_object(environment(TO),"TockTick\n");
		else if(i==5)tell_object(environment(TO),"Tack\n");
		else if(i==6)tell_object(environment(TO),"TackTock\n");
		else if(i==7)tell_object(environment(TO),"TockTackTick\n");
		else if(i==8)tell_object(environment(TO),"Ticki-Ticki\n");
		else if(i==9)tell_object(environment(TO),"Tock. Tock. Tock.\n");
		else if(i==10)tell_object(environment(TO),"nerVoeser Tuepo. \n");
		else if(i==11)tell_object(environment(TO),"Nerv.\n");
		else if(i==12)tell_object(environment(TO),"TackaTucka\n");
		else if(i==13)tell_object(environment(TO),"TockTockTock\n");
		else if(i==14)tell_object(environment(TO),"TickTack\n");
		else if(i==15)tell_object(environment(TO),"TackTack\n");
		else if(i==16)tell_object(environment(TO),"!!! Tick  !!!\n");
		else if(i==17)tell_object(environment(TO),"11elf TickTock\n");
		else if(i==18)tell_object(environment(TO),"Tuck\n");
		else if(i==19)tell_object(environment(TO),"TickTuck\n");
		else if(i==20)tell_object(environment(TO),"TockTuckTick\n");
		else tell_object(environment(TO),"Tick\n");
		call_out("ticker",10+random(50));
		}
		
		
}
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
 
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId(({"NERVOESESTICK"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_VALUE, 0);

call_out("ticker",10+random(50));
}

