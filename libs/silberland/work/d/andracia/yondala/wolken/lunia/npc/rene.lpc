  AddInfo( ({"",""}),
    ".",
    "sagt: ");


//  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Rene will Deine Sachen nicht tragen.\n" }) );

/*  SetProp(P_SPEllRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAgE:1]));*/

  SetChats(1, ({
    "Rene streicht sich eine Augenbraue glatt.\n",
    "Rene fragt: Wie waere es mit einer neuen Frisur?\n",
    //"Rene sagt: Eine andere Haarfarbe wuerde Euch sicher gut stehen.\n",
    "",
    ""}) );
  SetAttackChats(10, ({
    ".\n"}) );
SetProp(P_LOG_INFO, "yondalas_antworten");
  
  SUID;
  CLONEME(LUNIA_WEAPON "schere" );
  command("zuecke schere");

  CLONEME( "/p/armour/armour/seidenjacke" );
  CLONEME( "/p/armour/belt/guertel" );
  CLONEME( "/p/armour/cloak/seidenumhang" );
  CLONEME( "/p/armour/boots/seidenschuhe" );
  CLONEME( "/p/armour/trousers/seidenhose" );
  command("trage alles");
  AddCmd( ({ "frisur" }), "frisur" );   
 // AddCmd( ({ "faerbe", "faerb" }), "faerbe" );   


   SetProp(P_SPELLRATE, 40);
   SetProp(P_NOMAGIC,30);

	AddSpell(2,450,
	        "Rene sticht mit seiner Schere auf Dich ein.\n",
	        "Rene sticht mit seiner Schere auf @WEN ein.\n",
	         ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,280,
	         "Rene zerquetscht Dich zwischen den Scheerenklingen.\n",
	         "Rene zerquetscht @WEN zwischen den Scheerenklingen.\n",
	         ({DT_SQUEEZE, DT_RIP}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(1,550,
