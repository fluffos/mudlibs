	string *zeichen = ({"a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"});

// vorschlag frisuren als Mapping (dann kann man auch spezifisch Preise festlegen)
mapping frisuren = // Format: "Schluesselwort": Beschreibung; Preis; Extralooktext,
  (["lockenkopf":"Ein Lockenkopf ist eine Frisur aus mittellangen, gelockten Haaren";230;" hat eine prachtvolle Lockenfrisur.\n",
    "loewenmaehne":"Eine Loewenmaehne sind mittellange, leicht antuppierte Haare";200;" hat eine praechtige Loewenmaehne.\n",
    "glatze":"Eine Glatze kann ich Euch leicht anbieten, denn das bedeutet keine Haare zu haben";100;" hat eine Glatze.\n",
    "irokese":"Ein Irokese bedeutet, dass die Haare an den Seiten abrasiert sind";150;" hat eine Irokesenfrisur.\n",
    "geheimratsecken":"Bei Geheimratsecken gehen die Haare besonders an den Schlaefen stark zurueck";150;" hat schon Geheimratsecken.\n",
    "halbglatze":"Bei einer Halbglatze sind nur noch an den Seiten Haare zu finden";150;" hat eine Halbglatze.\n",
    "vokuhila":"Ein Vokuhila bedeutet vorne kurz und hinten lang die Haare";200;" ist ein Vokuhila.\n",
    "bauernzopf":"Bei einem Bauernzopf lasse ich die Haare erst lang wachsen um sie dann kunstvoll zu flechten";500;" traegt einen kunstvollen Bauernzopf.\n",
    "pferdeschwanz":"Ein Pferdeschwanz bedeutet langes Haar im Nacken zusammengebunden";200;" traegt einen Pferdeschwanz.\n",
    "prinzeisenherzschopf":"Ein Prinzeisenherzschopf ist kurzes Haar rund um den Kopf gleichlang";300;" traegt die Haare wie Prinz Eisenherz.\n",
    "halbglatze versteckt":"Eine versteckte Halbglatze zaubere ich, indem ich die seitlichen Haare ueber die Halbglatze lege. Das merkt man gar nicht.";200;" versteckt eine Halbglatze unter einem sehr seitlichen Scheitel.\n",
    "kurzhaarfrisur":"Eine Kurzhaarfrisur sind einfach kurze Haare";120;" hat eine schicke Kurzhaarfrisur.\n",
    "topfschnitt":"Ein Topfschnitt ist meine Spezialitaet, dazu setze ich dem Kunden einen Topf auf und schneide alle Haare ab, die herausgucken";25;" hat einen billigen Topfhaarschnitt.\n",
    "rattenschwaenze":"Rattenschwaenze heisst es, wenn ich mittellanges Haar zu zwei Zoepfen binde";150;" hat zwei kleine Rattenschwaenze.\n",
    "buerstenhaarschnitt":"Ein Buerstenhaarschnitt ist sehr praktisch. Pflegeleicht und passt zu Kaempfern";120;" traegt einen Buerstenhaarschnitt.\n",
    "rastalocken":"Rastalocken sind gewollt verfilzte Haare. Ich mags nicht, aber Euch wuerde es sicher prima stehen";400;" hat Rastalocken.\n",
    "haare besonders lang":"Was soll ich dazu sagen? Ich kann jedes Haar verlaengern";310;" hat besonders lange Haare.\n",
    "hochsteckfrisur":"Ich kann aus jedem Haar eine herrliche Hochsteckfrisur zaubern";450;" traegt eine herrliche Hochsteckfrisur.\n",
    "turmfrisur":"Um ein bisschen groesser zu wirken kann ich nur eine Turmfrisur empfehlen";300;" traegt das Haar zu einer gigantischen Turmfrisur.\n",
    "kapuzinerfrisur":"Bei einer Kapuzinerfrisur rasiere ich dem Kunden einen kleinen Kreis auf den Hinterkopf";210;" traegt eine Kapuzinerfrisur.\n",
    "tolle":"Eine Tolle sind Haare die in einer einzigen grossen Locke auf dem Kopf liegen";230;" traegt eine tolle Tolle.\n"]);


void create() {
  string *frisurnamen;
  string frisurliste;
  int i;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Rene der Barbier");
  SetProp(P_LONG,
    "Rene ist ein Mann mittleren Alters. Er hat eine glatte, leicht gebraeunte Haut und strohblonde "
    "Haare. Er zeigt Dir laechelnd seine strahlenden Zaehne. Rene traegt eine pinke Weste und "
    "eine schwarze Lederhose.");
  SetProp(P_NAME, "Rene");
  SetProp(P_GENDER, MALE);
  AddId(({"rene", "barbier", "frisoer","tucke"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");
//  SetProp(P_NOATTACK, "sagt: Yondala verbietet es mir noch, mit Euch zu kaempfen!\n");
  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 192);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
//  SetProp(P_HEAL,0);
//  SetProp(P_AGGRESSIVE,0);
//  SetProp(P_WIMPY, 0);
//  SetProp(P_NOMAGIC,0);
/*  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );*/

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
//  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Rene");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "sagt: haaaach, nein, erzaehlt mir mehr!\n");
  AddInfo("", "","sagt: ");

  AddInfo( ({"frisur"}),
    "Ich kann Euch viele verschiedene Frisuren anbieten.",
    "sagt: ");
  AddInfo( ({"frisuren"}),
    "Ich kann jedem die Frisur zaubern, die er gerne haette und das zu einem guten Preis. "
    "Wo kein Haar ist, lasse ich welches "
    "wachsen, wo zu viel ist, schneide ich es weg. Fragt mich einfach nach Frisurarten.",
    "sagt: ");
/*  AddInfo( ({"frisurarten","frisurart"}),
    "Ich biete an:\n"+
    "Lockenkopf\n"+
    "Loewenmaehne\n"+
    "Glatze\n"+
    "Irokese\n"+
    "Geheimratsecken\n"+
    "Halbglatze\n"+
    "VoKuHiLaOLiBa\n"+
    "Bauernzopf\n"+
    "Pferdeschwanz\n"+
    "Prinzeisenherzschopf\n"+
    "versteckte Halbglatze\n"+
    "Kurzhaarfrisur\n"+
    "Topfschnitt\n"+
    "Rattenschwaenze\n"+
    "Buerstenhaarschnitt\n"+
    "Rastalocken\n"+
    "besonders lange Haare\n"+
    "Hochsteckfrisur\n"+
    "Turmfrisur\n"+
    "Kapuzinerfrisur\n"+
    "eine tolle Tolle\n"+
    "Zopf\n"+
    "Wenn Ihr Euch fuer eine Frisur entschieden habt, so tippt einfach <frisur xy> und ich werde sehen, was ich fuer Euch tun kann.",
    "sagt: ");
  AddInfo( ({    "lockenkopf","loewenmaehne","glatze","irokese","geheimratsecken","halbglatze",
    "vokuhilaoliba","bauernzopf","pferdeschwanz", "prinzeisenherzschopf","versteckte halbglatze",
    "kurzhaarfrisur","topfschnitt","rattenschwaenze","buerstenhaarschnitt","rastalocken",
    "besonders lange haare","hochsteckfrisur","turmfrisur","kapuzinerfrisur","eine tolle tolle",
    "tolle tolle","tolle","lange haare","zopf"}),
    ".",
    "sagt: ");*/
    
  // jede Frisur beschreiben  
  frisurnamen=m_indices(frisuren);//die Schluesselwoerter aus dem Mapping werden im array gespeichert
  frisurliste="";
  
  for(i=sizeof(frisuren)-1; i>=0; i--)
  {
    /*AddInfo( frisurnamen[i], "Ein(e) "+capitalize(frisurnamen[i])+" ist "+
      frisuren[frisurnamen[i],0]+" und kostet "+frisuren[frisurnamen[i],1]+" Muenzen.",
      "sagt: ");*/
