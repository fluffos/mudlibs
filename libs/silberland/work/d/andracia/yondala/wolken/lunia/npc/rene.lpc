    "so tippt einfach <frisur xy> und ich werde sehen, \n"+
    "was ich fuer Euch tun kann. \n",
    "sagt: ");
    
  
  AddInfo( ({"locken","locke"}),
    "Ich kann Euch einen herrlichen Lockenkopf zaubern.",
    "sagt: ");
  AddInfo( ({"farbe","haarfarbe", "faerben"}),
