int frisur(string str)
{
	object frisuritem;
  string *frisurnamen;
  frisurnamen=m_indices(frisuren); 

	notify_fail("Rene fragt Dich: Welche Frisur soll es denn sein?\n");
	//erst checken ob der Spieler auf dem Frisierstuhl sitzt
	if(TP->QueryProp(P_NOMOVE)!="Dazu solltest Du erst vom Frisierstuhl aufstehen.\n") 
	{
		command("sag Wenn ich Euch frisieren soll, nehmt dazu bitte auf dem Frisierstuhlplatz, "+TPN+"!");
		return 1;
	}
  if( !member( frisuren, str )) return 0; // ist str in frisuren ein Schluesselwort
  // nun Frisur erzeugen und frisuren[str,2] als exttralook uebergeben
	if(this_player()->QueryMoney() < frisuren[str,1])
		{
			command("sag Qualitaet hat Ihren Preis, "+TPN+" und den koennt Ihr offenbar nicht zahlen.");
			command("sag Hinaus mit Euch!");
      TP->SetProp(P_NOMOVE,0);
      this_player()->move(LUNIA_ROOM+"lunia_2b.lpc", M_GO, "von Rene rausgeworfen", "wird",
                                "kommt aus dem Frisiersalon geflogen");

      call_other(LUNIA_ROOM+"lunia_1a.lpc","aufgestehter");
      return 1;
		}
	TP->AddMoney(-frisuren[str,1]);	
	if(!present("\nfrisur", TP))  CLONE(LUNIA_OBJ + "frisur.lpc", TP);
  frisuritem=present("\nfrisur",TP);
  frisuritem->set_extra_look(frisuren[str,2]);
  write("Rene schwingt seine magische Schere und zaubert Dir eine Frisur.\n");
  say("Rene schwingt seine magische Schere und zaubert "+TPN+" eine Frisur.\n",TP);
  return 1;
}


//hier koennen Spieler sich die Haare faerben lassen.
//rausgenommen ist Farben mit mehr als einem Wort und mehr als 15 Zeichen
int faerbe(string str)
{
	int i;
	string tester;
	string farbe;
	farbe="";
	
	
	notify_fail("Rene sagt: Diese Farbe kenne ich nicht. Bitte nur einwortige Farben benutzen!\n");
	if(!str) return 0;
		//write(sizeof (str)+"\n");
		//return 1;
	write("Du waehlst eine Farbe.\n");	
	say(TPN+" will sich die Haare faerben lassen.\n",TP);
	if(TP->QueryProp(P_NOMOVE)!="Dazu solltest Du erst vom Frisierstuhl aufstehen.\n") 
	{
		command("sag Wenn ich Euch die Haare faerben soll, nehmt dazu bitte auf dem Frisierstuhlplatz, "+TPN+"!");
		return 1;
	}
	if(TP->QueryMoney()<200)//wer nicht zahlen kann, fliegt
		{
			command("sag Qualitaet hat Ihren Preis, "+TPN+" und den koennt Ihr offenbar nicht zahlen.");
			command("sag Hinaus mit Euch!");
      TP->SetProp(P_NOMOVE,0);
      this_player()->move("/d/wolken/yondala/lunia/room/lunia_2b.lpc", M_GO, "von Rene rausgeworfen", "wird",
                                "kommt aus dem Frisiersalon geflogen");

      call_other("/d/wolken/yondala/lunia/room/lunia_1a.lpc","aufgestehter");
      return 1;
    }                                

	for(i=0;;i++)
	{
		if(str[i..i]==" ") return 0;
		if (str[i..i]=="") break; 
		//tester=str[i..i];
	  //if( !member( erlaubtezeichen, tester )) 	//return 0; //str[x..x]
	  if( member( zeichen, str[i..i] )==-1) 	//return 0; //str[x..x]
		  {
		  	command("sag Bitte benutzt keine Leer- oder Sonderzeichen, "+TPN+"!");
		  	return 1;
		  }
		if(i>=15)
			{
				command("sag Der Name dieser Farbe ist zu lang, "+TPN+".");  
				return 1;
			}
			
		//farbe=farbe+str[i..i];
		if (str[i..i]=="") break; 
			
		}	
		TP->AddMoney(-200);
		//write(str+"\n");
		TP->SetProp(P_HAIR_COLOR, str);
		write("Rene haelt Dir einen Spiegel vor.\n"+TP->long());
		say("Rene haelt "+TPN+" einen Spiegel vor.\n");
		command("sag Ich hoff, es gefaellt Euch so!?");
		return 1;
	}



