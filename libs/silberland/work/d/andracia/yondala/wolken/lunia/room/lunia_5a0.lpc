
inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>

#include <properties.h>
int kasse;
int kasseauf;
void tick()
{
	tell_room(TO,"Tick\n");
	call_out("tick", 1);
	}

void reset()
{
  AddDetail( ({ "kasse" }),
    ("Die Kasse zeigt zur Zeit keinen Betrag an, ausserdem ist sie geschlossen."));
  RemoveDetail("muenzfach");
  kasseauf=0;//Kasse ist also zu
  kasse=1000+random(10000);	
  AddDetail( ({ "muenzfach" }),
    ("In dem Muenzfach liegen "+kasse+" Muenzen. Wie unbedacht, jemand koennte sie stehlen..."));
  ::reset();
}	
void create() 
{
  ::create();
  kasse=1000+random(10000);
  SetProp( P_INT_SHORT, "In einem feinen Laden" );
  SetProp( P_INT_LONG,  
    ("Du stehst hier in einem kleinen, sehr ordentlichen Laden. Ausser dem Verkaufstresen "
    "siehst Du nur einige Schraenke vor den Waenden und einen Kronleuchter unter der Decke. "
    "Es ist hier sehr sauber und mehr als ordentlich."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetStorageRoom(LUNIA_ROOM + "lagerladen.lpc");
  SetProp(P_SHOPKEEPER_ID, "KUNIBERT");
  SetProp(P_SHOPKEEPER_NAME, "Kunibert");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  AddItem(LUNIA_NPC + "kunibert.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "laden","raum" }),
    ("Du stehst hier in einem kleinen, sehr ordentlichen Laden. Ausser dem Verkaufstresen "
    "siehst Du nur einige Schraenke vor den Waenden und einen Kronleuchter unter der Decke. "
    "Es ist hier sehr sauber und mehr als ordentlich."));
  AddDetail( ({ "verkaufstresen","tresen" }),
    ("Mitten in dem kleinen Raum steht ein Tresen mit einer Kasse."));
  AddDetail( ({ "kasse" }),
    ("Die Kasse zeigt zur Zeit keinen Betrag an, ausserdem ist sie geschlossen."));
  AddSpecialDetail( ({ "zeit","uhrzeit"  }), "zeit" );
  AddDetail( ({ "betrag" }),
    ("Hier steht normalerweise der Betrag, den ein Kunde zu zahlen hat."));
  AddDetail( ({ "kunde" }),
    ("Wenn Du etwas kaufst, bist Du auch ein Kunde. Tippe <zeig>, vielleicht gefaellt Dir etwas."));
  AddDetail( ({ "schraenke" }),
    ("Die Schraenke sind weiss, geschlossen und stehen rundherum an den Waenden."));
  AddDetail( ({ "waende" }),
    ("Die Waende sind weiss. Bis auf eine Wand sind alle Waende mit Schraenken zugestellt."));
  AddDetail( ({ "wand" }),
    ("Vor einer Wand stehen keine Schraenke, dort ist naemlich die Tuer. Und neben der Tuer "
    "haengt eine praechtige Uhr."));
  AddDetail( ({ "tuer" }),
    ("Durch die bist Du gekommen und durch sie kannst Du den Laden auch wieder verlassen."));
  AddDetail( ({ "uhr" }),
    ("Neben der Tuer haengt eine wunderschoene hoelzerne Uhr. Sie ist mit herrlichen Schnitzereien "
    "verziert, unter ihr haengt ein dickes Pendel und schwingt tickend hin und her."));
  AddDetail( ({ "schnitzereien" }),
    ("In die Uhr sind praechtige Schnitzereien hereingearbeitet."));
  AddDetail( ({ "pendel" }),
    ("Das Pendel ist gross und rund und tickt penetrant."));
  AddDetail( ({ "kronleuchter" }),
    ("Unter der Decke haengt ein praechtiger Kronleuchter, der fast schon ein wenig zu protzig "
    "wirkt fuer diesen kleinen Raum."));
  AddDetail( ({ "decke" }),
    ("Die Decke ist weiss gestrichen. Ein Kronleuchter ist an ihr befestigt."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht aus einem netten, Mosaik."));
  AddDetail( ({ "mosaik" }),
    ("Es ist bunt und sehr huebsch."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Ticken einer Uhr. \n");

  AddSound( ({ "ticken","uhr" }),
    "Das Ticken macht Dich etwas nervoes. \n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Bonerwachs und Reinigungsmitteln. \n");

  AddSmell( ({ "bonerwachs", "wachs","reinigungsmittel","mittel" }),
    "Es riecht nicht sonderlich angenehm, aber wenigstens weisst Du, dass es hier sauber ist. \n");

  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "stiehl","stehle","stehl" }), "stehlen" );
 
 
tick();
  AddExit( "osten", LUNIA_ROOM + "lunia_5a.lpc" );

}

string zeit()
{	return(ctime()+"\n");}
	
int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str=="schrank"||str=="schraenke")
		{
			write("Du ruettelst wild an einem Schrank, bekommst ihn aber nicht auf.\n");
			say(TPN+" ruettelt wild an einem Schrank, bekommt ihn aber nicht auf.\n");
			return 1;
		}
	if(str=="kasse")
		{
			if(kasseauf==1)
				{
					write ("Die Kasse ist doch schon geoeffnet.\n");
					return 1;
					}
	
			write("Du oeffnest die Kasse.\n");
			say(TPN+ "oeffnet die Kasse.\n");
			AddDetail( ({ "kasse" }),
    		("Die Kasse zeigt zur Zeit keinen Betrag an, sie ist geoeffnet, Du kannst das Muenzfach sehen."));
      AddDetail( ({ "muenzfach" }),
       ("In dem Muenzfach liegen "+kasse+" Muenzen. Wie unbedacht, jemand koennte sie stehlen..."));
			kasseauf=1;
			return 1;
			}
return 0;	
}

int stehlen (string str)
{
	object besitzer;
	notify_fail("Was moechtest Du stehlen?\n");
	if(str!="muenzen"&&str!="muenzen aus muenzfach"&&str!="muenzen aus fach") return 0;
	
	if(!kasseauf)
		{
			write("Du solltest die Kasse erst oeffnen.");
			return 1;
		}
	else if(!kasse)
		{
			write ("Leider liegen keine Muenzen in der Kasse.\n");
			return 1;
		}
	if (present("KUNIBERT",environment(TP)))
		{
			write("Kunibert haut Dir auf die Finger.\n");
			say("Kunibert haut "+TPN+" auf die Finger.\n");
			besitzer=present("KUNIBERT",environment(TP));
			besitzer->Attack(TP);
			return 1;
		}
	write("Du stiehlst "+kasse+" Muenzen aus der Kasse.\n");
	say(TPN+" stiehlt einige Muenzen aus der Kassen.\n");
	TP->AddMoney(kasse);
	kasse=0;
  AddDetail( ({ "muenzfach" }),
       ("Das Muenzfach ist leer."));
	return 1;
}