#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein weiter Umhang");
  SetProp(P_LONG,
    "Du siehst einen duennen, weiten Umhang, der in vielen Farben leuchtet." );
 SetProp( P_TEMPERATURE_PROTECTION, ([ T_HEAT_PROT:3 ]) );
  AddAdjective("weit");
  SetProp(P_NAME_ADJ,"weit");
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ({MAT_SILK, MAT_MISC_MAGIC}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 50);
                                  

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
  {

}

