#include "../def.h"

inherit "std/room";
#include <properties.h>
int da;

void reset()
{
	da=1;
	::reset();
	}
void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einem Regenbogen" );
  da=1;
  SetProp( P_INT_LONG, "Du stehst hier mitten auf einem Regenbogen. Um Dich "
  "herum sind nur Wolken, Farben und Licht. Die Sonne laechelt sanft auf Dich herab. "
  "Du fuehlst Dich wohl.");
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );


  AddDetail( ({ "regenbogen","bogen" }),
    ("Der Regenbogen schillert in vielen bunten Farben. Anders als normale Regenboegen scheint "
    "dieser hier nicht nur aus Licht zu bestehen."));
  AddDetail( ({ "farben" }),
    ("Regenbogenfarben, quasi."));
  AddDetail( ({ "regenbogenfarben" }),
    ("Rot, gelb, blau, gruen, orange, lila."));
  AddDetail( ({ "regenboegen" }),
    ("Normalerweise bestehen Regenboegen nur aus Licht, dieser hier scheint aber recht fest zu "
    "sein."));
  AddDetail( ({ "licht" }),
    ("Der Regenbogen besteht aus Licht und einem anderen, Dir unbekanntem Material."));
  AddDetail( ({ "material" }),
    ("Was es ist kannst Du nicht sagen, allerdings scheint es fest genug um Dich tragen zu "
    "koennen, aber immernoch so weich, dass man vielleicht sogar ein Stueck abschneiden koennte."));
  AddDetail( ({ "stueck" }),
    ("Wenn Du ein Messer hast, kannst Du es ja versuchen."));
  AddDetail( ({ "messer" }),
    ("Das musst Du schon selbst wissen, ob Du eins dabei hast. Mit <i> siehst Du Deinen Inventar."));
  AddDetail( ({ "inventar" }),
    ("tippe <i>"));
  AddDetail( ({ "wolken" }),
    ("Leuchtend weisse Schaefchenwolken umgeben Dich hier oben."));
  AddDetail( ({ "schaefchenwolken","schaefchen" }),
    ("Sie sehen wollig weich aus."));
  AddDetail( ({ "boden" }),
    ("Der ist weit unter Dir. Aktuell stehst Du mehr oder weniger fest auf einem Regenbogen."));
  AddDetail( ({ "himmel" }),
    ("Dort befindest Du Dich gerade."));
  AddDetail( ({ "sonne" }),
    ("Die Sonne laechelt sanft auf Dich herab. Es ist angenehm warm."));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Hier ist es herrlich still, nur der Wind fluestert leise.");

  AddSound( ({ "wind","fluestern" }),
    "Irgendwie wirkt es beruhigend auf Dich.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach fast Nichts. Die Luft ist so rein, wie Du es selten erlebt hast.");

  AddSmell( ({ "luft" }),
    "Du atemst tief ein und aus. Herrlich.");
  AddSmell( ({ "nichts" }),
    "Du kannst nur den Duft der Blumen erahnen, die im Park weit unter Dir sind.");
  AddSmell( ({ "duft","blumen" }),
    "Ein leicht suesslicher, angenehmer Duft.");
  AddSmell( ({ "park" }),
    "Du kannst den Park unter Dir nur durch den leichten Duft der Blumen erahnen.");

	
	
	
  AddCmd( ({ "schneide","schneide" }), "schneiden" );



     AddExit( "nordwesten", LUNIA_ROOM + "lunia_3a.lpc" );
     AddExit( "suedosten", LUNIA_ROOM + "lunia_7f.lpc" );
}

int schneiden(string str)
{
	notify_fail("Was moechtest Du herausschneiden?\n");
	if(str=="stueck aus regenbogen heraus"||str=="stueck aus regenbogen"||
		str=="stueck aus regenbogen raus"||str=="stueck heraus"||
		str=="stueck raus"||str=="stueck")
		{
			if(!present("messer",TP))
				{
					write("Du hast kein Messer dabei.\n");
					return 1;
				}
			if(da!=1)
				{
					write("Gerade als Du schneiden willst siehst, Du, dass schon ein Stueck fehlt. Es "
					"ist sicher besser zu warten, bis sich der Regenbogen regeneriert hat.\n");
					return 1;
				}
			CLONE(LUNIA_OBJ + "regenbogenstueck.lpc", TP);	
			write("Du schneidest ein Stueck aus dem Regenbogen.\n");
			say(TPN+ " schneidet sich ein Stueck aus dem Regenbogen.\n");
			da=0;
			return 1;
	    }
	return 0;
	}