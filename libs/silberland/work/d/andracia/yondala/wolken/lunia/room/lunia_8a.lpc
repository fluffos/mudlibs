int schalter(string str)
{
  string aufhalter;
  int i;
  string zahltext;
  aufhalter=db_sitzer1[random(sizeof(db_sitzer1))];
  if(!present("nummernbon",TP))
  {
    write("Ein "+aufhalter+" haelt Dich auf.\nDer "+aufhalter+" sagt: He, "
	"nicht vordraengeln.\n");//eventuell hier noch flexiblere Texte machen
	return 1;
	}
  zahltext=present("nummernbon",TP)->GetReadDetail("zettel");
  i=strlen(zahltext);
  zahltext=zahltext[0..i];
  i=to_int(zahltext);
  //write("i ist: "+i+"  zahltext ist: "+zahltext+"\n");
  if(i<weristdran)
  {
    write("Der Beamte schaut auf Deinen Nummer.\n"+
	      "Der Beamte sagt: Ihr habt Euren Termin verpasst.\n"+
	      "Der Beamte zerreisst Deine Nummer.\n");
 	say("Der Beamte schaut auf "+TP->name(WESSEN)+" Nummer.\n"+
	    "Der Beamte sagt: Ihr habt Euren Termin verpasst.\n"+
		"Der Beamte zerreisst "+TP->name(WESSEN)+" Nummer.\n",TP);
    
	present("nummernbon",TP)->remove();
    return 1;
  }
 
 if(i>weristdran)
 {
    write("Der Beamte schaut auf Deinen Nummer.\n"+
	      "Der Beamte sagt: Ihr seid noch nicht dran.\n");
 	say("Der Beamte schaut auf "+TP->name(WESSEN)+" Nummer.\n"+
	    "Der Beamte sagt: Ihr seid noch nicht dran.\n",TP);
		return 1;
		}
	
if(str=="zutritt"||str=="zutritt zum park"||str=="zutritt zum park von lunia"||
   str=="zutritt zum park von lunia fuer nicht-seher")
{
  if(present("zutrittserlaubnislunia",TP))
  {
    write("Der Beamte sagt: Ihr habt doch schon eine Zutrittgenehmigung.\n");
	}
  else if(IS_SEER(TP))
    write("Der Beamte sagt: Seher benoetigen keine gesonderte "+
	      "Zutrittgenehmigung.\n");
	
  else if(TP->QueryMoney()<5000)
    write("Der Beamte sagt: Ihr habt nicht genug Geld dabei.\n");
	
	else
	{
	write("Du beantragst Zutritt zum Park von Lunia fuer Nicht-Seher.\n"+
	"Der Beamte hinter dem Schalter nimmt Deine 5000 Muenzen entgegen.\n"+
	"Der Beamte haendigt Dir ein Stueck Papier aus.\n");
	TP->AddMoney(-5000);
	CLONE(LUNIA_OBJ+"zutrittserlaubnislunia", TP);
	}
	return 1;
  }
if(str=="seherhaus im verwaltungsbezirk Lunia"||
   str=="seherhaus in lunia"|| 
   str=="seherhaus in verwaltungsbezirk lunia"||
   str=="seherhaus im verwaltungsbezirk"||
   str=="seherhaus") 
  {   
  if(!IS_SEER(TP))
    write("Der Beamte sagt: Kommt wieder, wenn Ihr Seher seid!\n");
  
  else if(TP->QueryMoney()<50000)
    write("Der Beamte sagt: Ihr habt nicht genug Geld dabei.\n");
	
  else
	{
	write("Du beantragst Seherhaus im Verwaltungsbezirk Lunia.\n");
	
	if (!write_file(LUNIA_ROOM+"antragsteller.lpc",TPN+" "+dtime()+"\n")) 
	{
	  write("Der Beamte sagt: Leider koennen derzeit keine Antraege angenommen werden.\n"+
	  "Der Beamte sagt: Bitte wendet Euch an einen Magier.\n");
	  }
	else 
	{
	  write("Der Beamte hinter dem Schalter nimmt Deine 50000 Muenzen entgegen.\n"+
	  "Der Beamte sagt: Ein Magier wird Euer Anliegen pruefen und "+
	   "gegebenenfalls\nDer Beamte sagt: auf Euch zukommen.\n");
	   TP->AddMoney(-50000);
	   antragsteller_vorhanden();
	   }
	
	}
	return 1;
  
  } 
  if(str=="einbuergerung"||str=="einbuergerung in andracia")
  {
	 write("Der Beamte sagt: Leider koennen derzeit keine einbuergerungen vorgenommen werden.\n"+
	  "Der Beamte sagt: Bitte wendet Euch an einen Magier.\n");
	  return 1;
  }

  
}
/*Zutritt zum Park von Lunia fuer Nicht-Seher    5000   Muenzen\n"
	"Seherhaus im Verwaltungsbezirk Lunia           50000 Muenzen\n"
	"Einbuergerung in Andracia                      20000 Muenzen\n"
	"Passierschein A 38     
  */
  
int beantragen(string str)
{
  notify_fail("Was moechtest Du denn beantragen?\n");
  if(!str) return 0;
  write("Du trittst an den Schalter.\n");
  call_out("schalter", 2, str);
  return 1;
  }
  





int nummerziehen(string str)
{
  int i;
  notify_fail("Was moechtest Du ziehen?\n");
  if (str!="nummer")return 0;
  if(present("nummernbon",TP))
  {
    write("Da Du schon eine Nummer hast, gibt der Automat Dir keine neue.\n");
	return 1;
	}
  write("Du ziehst eine Nummer.\n");	
  say(TPN+" zieht eine Nummer.\n",TP);
  CLONE(LUNIA_OBJ+"nummernbon", TP);
  i=sizeof(gezogenenummern);
  i--;
  i=gezogenenummern[i];
  i=i+random(5)+3;
  if(i<=weristdran) i=weristdran+random(5)+3;
  gezogenenummern=gezogenenummern+({i});
   present("nummernbon",TP)->AddReadDetail( ({ "zettel" }),i+"\n");
  return 1;
}  
  
int knopfdruecken(string str)
{
  if(str!="knopf") return 0;
  nummerziehen("nummer");
  return 1;
  }
  


