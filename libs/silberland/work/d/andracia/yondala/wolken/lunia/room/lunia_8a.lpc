#include "../def.h"
#include <moredef.h>

inherit "std/room";

#include <properties.h>


string *db_sitzer1;
string *db_sitzer2;
string sitzer1;
string sitzer2;



int weristdran;
int *gezogenenummern;

void platzwechsel()
{
  if (random(2)) return; //Nicht immer wird der aufgerufen, der auf der Bank sitzt
  
  if(random(2))
  {
    tell_room(TO, "Der "+sitzer1+" steht von Bank auf und geht zum Schalter.\n");
    sitzer1=db_sitzer1[random(sizeof(db_sitzer1))];
	tell_room(TO, "Ein "+sitzer1+" setzt sich auf die Bank.\n");
    return;
	}
tell_room(TO, "Die "+sitzer2+" steht von Bank auf und geht zum Schalter.\n");
sitzer2=db_sitzer2[random(sizeof(db_sitzer2))];	
tell_room(TO, "Eine "+sitzer2+" setzt sich auf die Bank.\n");
}

void antragsteller_vorhanden()
{
  if(!read_file(LUNIA_ROOM+"antragsteller.lpc"))return;
  if(find_living("yondala")) tell_object(find_living("yondala"), 
  "Jemand moechte ein Seherhaus in Lunia, siehe /d/andracia/yondala/wolken/lunia/"+
  "room/antragsteller.c!\n");
}
void reset()
{
  object *besucher;
  weristdran++;
  tell_room(TO, "Eine Stimme ruft: "+weristdran+", bitte.\n");
  if(member(gezogenenummern, weristdran)<0) 
  //Platzwechsel ausloesen
  call_out("platzwechsel",2);   
  antragsteller_vorhanden();
::reset();
}



string bank ()
{
  return break_string("An einer Wand, nahe dem Empfangsschalter, steht eine hoelzerne "+
  "Bank. Auf ihr sitzen ein "+sitzer1+" und eine "+sitzer2+".\n"+
  "Neben der Bank steht ein kleiner Automat.\n");
  }
  
 string tafel()
{
  return weristdran+"\n";
} 

//wird mit der Roommessage ausgegeben
void langeweile(int msg)
{
  string *leute;
  string *taetigkeiten;
  leute=({"Ein Elf", "Ein Oger","Ein Troll", "Ein Mann", "Ein Zwerg", 
          "Ein Halbling", "Ein Blauelf", "Ein Dunkelelf","Ein Faun", 
		  "Ein Wikinger", "Ein Indianer", "Ein Eskimo", "Eine Elfe", 
		  "Eine Ogerin","Eine Trollfrau", "Eine Frau", "Eine Zwergin", 
		  "Eine Halblingsfrau", "Eine Blauelfin", "Eine Dunkelelfin",
		  "Eine Faunin", "Eine Wikingerin", "Eine Indianerin", 
		  "Eine Eskimofrau", "Eine Fee"});
  taetigkeiten=({" schaut sich gelangweilt um.\n",
          " gaehnt.\n",
          " raeuspert sich.\n",
		  " fragt: Wann bin ich endlich dran?\n",
		  " schimpft: Geht das mal schneller?\n",
		  " starrt Loecher in die Luft.\n",
		  " scharrt mit den Fuessen auf dem Boden.\n",
		  " beginnt auf und ab zu gehen.\n",
		  " wippt auf den Fersen.\n",
		  " kratzt sich am Kopf.\n",
		  " sucht etwas in der Tasche.\n",
		  " nickt Dir zu.\n",
		  " betrachtet Dich gelangweilt.\n"});      		  
 
 Message(leute[random(sizeof(leute))]+taetigkeiten[random(sizeof(taetigkeiten))], MSGFLAG_VISUAL);

}

string weiblich(string key)
{
  string *ausgaben;
  ausgaben=({"Die "+capitalize(key)+" scheint hier zu warten.\n",
  "Die "+capitalize(key)+" fluestert hin und wieder mit anderen Besuchern.\n",
  "Die "+capitalize(key)+" nickt Dir freundlich zu.\n",
  "Die "+capitalize(key)+" runzelt die Stirn, als Du sie so hemmungslos musterst.\n",
  "Die "+capitalize(key)+" steht am Schalter an.\n",
  "Die "+capitalize(key)+" wartet darauf, dass ihre Nummer aufgerufen wird.\n",
  "Die "+capitalize(key)+" hat wohl ein Anliegen, wegen dem sie hier warten muss.\n"});
  return break_string(ausgaben[random(sizeof(ausgaben))]);

}

string maennlich(string key)
{
  string *ausgaben;
  ausgaben=({"Der "+capitalize(key)+" scheint hier zu warten.\n",
  "Der "+capitalize(key)+" wartet auf etwas.\n",
  "Der "+capitalize(key)+" schaut sich gelangweilt um.\n",
  "Der "+capitalize(key)+" sieht muede aus.\n",
  "Der "+capitalize(key)+" starrt Dich an, so wie Du ihn.\n",
  "Der "+capitalize(key)+" fuehlt sich von Dir beobachtet.\n",
  "Der "+capitalize(key)+" fragt: Warum starrt Ihr mich so an?\n"
  });
  return break_string(ausgaben[random(sizeof(ausgaben))]);

}


void create() 
{
  ::create();
  db_sitzer1=({"Elf", "Oger","Troll", "Mann", "Zwerg", "Halbling", "Blauelf", 
            "Dunkelelf","Faun", "Wikinger", "Indianer", "Eskimo"});
  db_sitzer2=({"Elfe", "Ogerin","Trollfrau", "Frau", "Zwergin", "Halblingsfrau", 
            "Blauelfin", "Dunkelelfin","Faunin", "Wikingerin", "Indianerin",
			"Eskimofrau", "Fee"});
			
  sitzer1=db_sitzer1[random(sizeof(db_sitzer1))];
  sitzer2=db_sitzer2[random(sizeof(db_sitzer2))];
