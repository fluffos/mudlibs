gerichtsdiener()
{
	int i;
	mixed *insassen;
	insassen=filter_array( all_inventory(), #'interactive );
	//insassen=filter_array( all_inventory(), #'interactive );
	tell_room(TO,"Ein Gerichtsdiener oeffnet die Tuer einen spaltbreit.\n");
//i=sizeof(insassen)-1;
	for(i=sizeof(insassen)-1;i>=0;i--)
	{
	  	if(present("\nalki",insassen[i]))//wenn er wegen Trunkenheit da ist
		{
			tell_room(TO,"Der Gerichtsdiener haelt "+insassen[i]->name()+" ein kleines Roehrchen hin.\n",({insassen[i]}));
			tell_object(insassen[i], "Der Gerichtsdiener haelt Dir ein kleines Roehrchen hin.\n");
			tell_room(TO, "Der Gerichtsdiener sagt: Bitte pusten.\n");
			tell_room(TO,insassen[i]->name()+" pustet in das kleine Roehrchen.\n",({insassen[i]}));
			tell_object(insassen[i], "Du pustest in das kleine Roehrchen.\n");
			if(insassen[i]->QueryProp(P_ALCOHOL)<insassen[i]->QueryProp(P_MAX_ALCOHOL)/10)//er ist nicht mehr sonderlich besoffen			
			{
				tell_room(TO, "Der Gerichtsdiener sagt: Wohlan, Ihr seid halbwegs nuechtern.\n"+
					"Der Gerichtsdiener sagt: Ihr duerft gehen, "+insassen[i]->name()+"!\n");
				tell_room(TO,"Der Gerichtsdiener fuehrt "+insassen[i]->name()+" aus der Zelle.\n",({insassen[i]}));
				tell_object(insassen[i], "Der Gerichtsdiener fuehrt Dich aus der Zelle.\n");
				insassen[i]->move( LUNIA_ROOM + "lunia_9e.lpc", M_NOCHECK);	
			}
			else //er ist noch betrunken
			{
				tell_room(TO, "Der Gerichtsdiener sagt: Ihr seid noch nicht ausgenuechtert, "+insassen[i]+"!\n");
				call_out("gerichtsdiener",300);
			}
		}
							  	
	  	/*else if(present("\nrandale",insassen[i]))//wenn er wegen randalieren da ist
	  		{//muss ich mir noch ne rauskomm-Bedingung ausdenken
	  			//eventuell Lebenspunkte oder so?
	  			}*/
	  	else//wenn er aus Versehen eingesperrt wurde
	  	{
	  		tell_room(TO,"Der Gerichtsdiener sagt: Was habt Ihr denn hier zu suchen, "+insassen[i]->name()+"?\n");
	  		tell_room(TO,"Der Gerichtsdiener fuehrt "+insassen[i]->name()+" aus der Zelle.\n",({insassen[i]}));
	  		tell_object(insassen[i], "Der Gerichtsdiener fuehrt Dich aus der Zelle.\n");
			insassen[i]->move( LUNIA_ROOM + "lunia_9e.lpc", M_NOCHECK);	
		}
	}//Schleife Ende
	tell_room(TO,"Der Gerichtsdiener schliesst die Tuer wieder.\n");

}

int schubsen(string str)
{
	string wen;
	string dummy;
	object geschubster;
	notify_fail("Wenn moechtest Du worunter schubsen?\n");
	if(!str) return 0;
		
	if(sscanf(str,"%s von pritsche%s",wen, dummy)!=2)return 0;
	
	if(capitalize(wen)!=capitalize(pritschenlieger))
		write(wen+" liegt gar nicht auf der Pritsche.\n");
		
	if(capitalize(wen)==capitalize(pritschenlieger))
		{
			geschubster=present(wen, environment(TP));
			geschubster->SetProp(P_NOMOVE,0);
			tell_object(geschubster, TPN+" gibt Dir einen Schubs und Du faellst von der Pritsche.\n");
			write("Du schubst "+pritschenlieger+" von der Pritsche.\n");
			tell_room(TO, TPN+" schubst "+pritschenlieger+" von der Pritsche.\n",({TP, geschubster}));
			pritschenlieger="";

		}
   return 1;
}

string pritsche()
{
	if(pritschenlieger==TPN)
		return ("Diese Pritsche dient den Gefangenen als Bett. Und wie Du wissen solltest, liegst Du drauf.\n");
	else if(pritschenlieger!="")
		return ("Diese Pritsche dient den Gefangenen als Bett, "+pritschenlieger+" liegt darauf.\n");
	else
		return ("Diese Pritsche dient den Gefangenen als Bett.\n");
	}

int liegen(string str)
  {  	
  	notify_fail( "Worauf moechtest Du liegen?\n" );
		if (str!="auf pritsche") return 0;
		if(pritschenlieger==TPN) write("Du liegst doch schon auf der Pritsche!\n");
		
		else if(pritschenlieger!=""&&pritschenlieger!=TPN) 
			write("Die Pritsche ist belegt, Du muesstest "+pritschenlieger+" vorher runterschubsen.\n");

		else if(pritschenlieger=="")
			{
		  	write ("Du legst Dich auf die Pritsche.\n");
			  say (TPN+" legt sich auf die Pritsche.\n", TP);
		    TP->SetProp(P_NOMOVE, "Du liegst doch gerade auf der Pritsche. Steh erstmal auf!\n");
        pritschenlieger=TPN;
				}
	
		return 1;
}


aufstehenCmd(string str)
  {  	
  	notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
		if (str=="auf"||str=="von pritsche auf"||!str)
  	{
  		if (this_player()->QueryProp(P_NOMOVE)!="Du liegst doch gerade auf der Pritsche. Steh erstmal auf!\n") write ("Du liegst doch gar nicht auf der Pritsche!\n");
			else
				{
					write ("Du stehst von der Pritsche auf.\n");
					say (TPN+" steht von der Pritsche auf.\n", TP);
  				TP->SetProp(P_NOMOVE, 0);
					pritschenlieger="";
  			}
  		return 1;
		}
		else return 0;
}


int spaehen(string str) 
{
	string raumbeschreibung; 
	notify_fail("Wodurch moechtest Du spaehen?\n");

    if (str!="durch loch" && str!="durch guckloch") return 0;
  raumbeschreibung = to_object(LUNIA_ROOM+"lunia_9e.lpc")->int_long(TP);
	write ("Du spaehst durch das Guckloch und siehst:\n"+raumbeschreibung);
	say(TPN+" spaeht durch das Guckloch der Tuer.\n");
	return 1;
}

int tuerauf()
{
	tell_room(TO,"Jemand oeffnet die Tuer.\n");
    AddExit( "westen", LUNIA_ROOM + "lunia_9e.lpc" );
	call_out("tuerzu",30);
}


int tuerzu()
{
	if(this_object()->GetExits()!="Es gibt einen sichtbaren Ausgang: westen.\n") return 1;
	
	tell_room(TO,"Die Tuer faellt zu. Du bist gefangen.\n");
	RemoveExit( "westen" );
}