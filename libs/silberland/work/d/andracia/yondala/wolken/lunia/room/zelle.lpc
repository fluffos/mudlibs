	string dummy;
	notify_fail("Wieviele Muenzen moechtest Du spenden?\n(Spende x Muenzen)\n");
	if(!str) return 0;
		
	if(sscanf(str,"%d muenzen%s",spende, dummy)!=2&&sscanf(str,"%d muenze%s",spende, dummy)!=2)return 0;
