#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <moredef.h>
int pritsche;
string pritschenlieger;

void init()
{
	call_out("gerichtsdiener",300);
	::init();
}

void create() 
{
  ::create();
pritschenlieger="";

  SetProp( P_INT_SHORT, "In einer kargen Zelle" );
  SetProp( P_INT_LONG,  
    ("Du befindest Dich hier in einer kargen Zelle. Ausser einer niedrigen Pritsche und einer Tuer ist hier "
    "absolut nichts was Deine Augen auch nur eine Sekunde lang fesseln koennte."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  call_out("gerichtsdiener",300);
  catch(call_other( LUNIA_ROOM + "lunia_9e.lpc", "???"));
//noch testen:
//  load LUNIA_ROOM + "lunia_9e.lpc";

  AddDetail( ({ "zelle" }),
    ("Du befindest Dich in einer kargen Zelle."));
 AddDetail( ({ "tuer" }),
    ("Die Tuer besteht aus dunklem Holz. In ihrer Mitte ist ein kleines Guckloch."));
  AddDetail( ({ "loch","guckloch" }),
    ("Du koenntest hindurch spaehen."));
  AddSpecialDetail( ({ "pritsche"  }), "pritsche" );
  AddDetail( ({ "bett" }),
    ("Ein Bett gibt es hier nicht wirklich, aber auf der Pritsche kann man liegen."));
  AddDetail( ({ "augen" }),
    ("Waere gruselig, wenn Du Deine eigenen Augen sehen koenntest, oder?"));
  AddDetail( ({ "sekunde" }),
    ("Nein, nicht mal fuer eine Sekunde."));
  AddDetail( ({ "boden" }),
    ("Der Boden besteht hier aus grauem Stein."));
  AddDetail( ({ "wand","waende" }),
    ("Die Waende bestehen aus grauem Stein. In einer Wand ist eine Tuer."));
   AddDetail( ({ "stein" }),
    ("Der Stein ist langweilig grau."));
   AddDetail( ({ "decke" }),
    ("Die Decke ist aus grauem Stein."));
   AddDetail( ({ "mitte" }),
    ("Mitten in der Tuer ist ein kleines Guckloch."));
   AddDetail( ({ "holz" }),
    ("Das Holz ist braun und sieht sehr stabil aus."));
   AddDetail( ({ "gefangene","gefangener" }),
    ("Wenn Du Dich hier aufaheltst, bist Du ein Gefangener."));
   AddDetail( ({ "" }),
    (""));
 
  AddSound( DEFAULT_SOUND,
    "Du kannst das Blut in Deinen Ohren rauschen hoeren. \n");

  AddSound( ({ "blut", "rauschen","ohren" }),
    "Oder anders ausgedrueckt: Es ist hier absolut still. \n");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Staub und Urin. \n");

  AddSmell( ({ "staub", "urin" }),
    "Nicht sonderlich angenehm. \n");

 // AddCmd( ({ "betrete", }), "betretenCmd" );
 
 


  AddCmd(({"spaehe", "spaeh"}),"spaehen"); //Funktion
	AddCmd(({"steh", "stehe"}), "aufstehenCmd"); 
	AddCmd(({"liege", "lieg","lege","leg"}), "liegen"); 
	AddCmd(({"schubs", "schubse","stoss","stosse"}), "schubsen"); 

 }
