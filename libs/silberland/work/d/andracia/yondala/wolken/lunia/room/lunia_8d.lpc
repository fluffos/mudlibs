//6.4.2019 Yondala@SilberLand: 	break_string in die SpecialDetails eingefuegt
//   							Man kann hier nun den Stern druecken

/********************************************************************

Statue von Yondala
Hier kann man einen Stern druecken um das Sehertor zu bekommen
Wenn es der dritte Stern ist, bekommt man das Tor und 50 SP

********************************************************************/


#include "../def.h"
inherit LUNIA_ROOM + "lunia_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Eine grosse Statue steht hier.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddItem(LUNIA_NPC + "gendarm.lpc",REFRESH_DESTRUCT);
  AddItem(LUNIA_NPC + "gendarm2.lpc",REFRESH_DESTRUCT);


  AddDetail( ({ "statue" }),
    ("Du siehst die Statue eines grossen, wunderschoenen Wesens und bist Dir ziemlich sicher, dass "
     "diese Statue Yondala darstellen soll."));

  AddDetail( ({ "wesen" }),
    ("Das dargestellte Wesen scheint keiner Dir bekannten Rasse anzugehoeren. Yondala hat die "
    "spitzen Ohren eines Elfen, die leicht schraegen Augen eines Koboldes und die Statur einer "
    "Menschenfrau. Auch von anderen Rassen kannst Du einige Merkmale erkennen ohne sie wirklich "
    "benennen zu koennen. Auch wenngleich nur aus Marmor, so erkennst Du doch, dass die Statue "
    "in feinste Gewaender gehuellt ist."));
  AddSpecialDetail( ({ "elfen", "elfe"  }), "elfen" );
  AddSpecialDetail( ({ "kobold", "kobolde"  }), "kobold" );
  AddSpecialDetail( ({ "menschenfrau", "mensch"  }), "mensch" );
  AddDetail( ({ "augen" }),
    ("Yondalas Augen blicken Dich guetig an."));
  AddDetail( ({ "ohren" }),
    ("Die Ohren Yondalas laufen spitz zu. Fast meinst Du, dass sie hoeren kann, was Du sagst."));
  AddDetail( ({ "statur" }),
    ("Yondala ist von kraeftiger Statur."));
  AddDetail( ({ "rassen", "rasse" }),
    ("In dieser Welt gibt es sehr viele Rassen."));
  AddDetail( ({ "merkmale" }),
    ("Du meinst schemenhaft andere Rassen in der Statue zu erkennen, kannst sie aber nicht klar zuordnen."));
  AddDetail( ({ "yondala" }),
    ("Die Statue Yondalas steht vor Dir auf einem Sockel und breitet die Arme aus als wolle sie "
    "Dich segnen."));
  AddDetail( ({ "sockel" }),
    ("Der Sockel besteht aus weissem Marmor."));
  AddDetail( ({ "arme" }),
    ("Die Statue breitet die Arme aus, bereit jeden zu segnen der dessen wuerdig ist. Ihre Handflaechen zeigen dabei "+
	"nach unten."));
  AddDetail( ({ "gewaender", "kleidung" }),
    ("Als Yondala fuer diese Statue Modell sass, hat sie offenbar feinste elfische Kleidung getragen."));
  AddDetail( ({ "modell" }),
    ("Die Statue ist wirklich sehr detailgetreu."));
  AddDetail( ({ "handflaechen", "haende" }),
    ("Yondalas Haende sind fein gearbeitet. An der linken Hand traegt sie einen Ring."));
  AddDetail( ({ "hand","linke hand" }),
    ("An Yondalas linker Hand steckt ein kleiner, silberner Ring."));
  AddDetail( ({ "rechte hand" }),
    ("Du bist ein wirklich guter Forscher!"));
  AddDetail( ({ "forscher" }),
    ("Weiter so!"));
  AddDetail( ({ "ring" }),
    ("Der Ring an Yondalas Hand scheint aus echtem Silber zu sein. Wie er wohl auf den Marmorfinger gekommen ist?"));
  AddDetail( ({ "marmorfinger", "ringfinger" }),
    ("Wie auch die restliche Statue besteht auch Yondalas linker Ringfinger aus Marmor."));
  AddDetail( ({ "finger" }),
    ("Alle Finger der Statue bestehen aus Mamor."));
  AddDetail( ({ "silber" }),
    ("Das Silber des Ringes wird nur durch einen kleinen Stern aus Rosenquarz unterbrochen."));
  AddDetail( ({ "rosenquarz" }),
    ("Das Rosenquarz ist in den Ring und teilweise auch in den Marmor eingepasst. Und das so perfekt, dass nur ein winziger Spalt bleibt."));
  AddDetail( ({ "stern" }),
    ("Ein kleiner, rosafarbener Stern ziert den Ring von Yondalas Statue."));
  AddDetail( ({ "spalt" }),
    ("Ganz klein ist der Spalt, rausbekommen wirst Du den Stern wohl nicht. Dennoch sieht er so aus, als koennte man ihn irgendwie bewegen."));
  AddDetail( ({ "" }),
    (""));
  
  AddSound( DEFAULT_SOUND,
    "Erhabene Stille herrscht hier. \n");

  AddSound( ({ "stille" }),
    "Erhabene Stille herrscht hier. \n");

  AddSmell( DEFAULT_SMELL,
    "Der leichte Duft nach bluehenden Blumen weht Dir zu. \n");

  AddSmell( ({ "duft", "blumen" }),
    "Es riecht sehr angenehm. \n");

  AddDetail( ({ "yondalas", "yondalas haus", "haus" }),
    "Yondalas Haus sieht schoen aus.");     
  AddDetail( ({ "" }),
    "");     
  AddDetail( ({ "" }),
    "");     

     AddExit( "westen", LUNIA_ROOM + "lunia_8c.lpc" );
     AddExit( "osten", LUNIA_ROOM + "lunia_8e.lpc" );
	 
  AddCmd( ({"druecke", "drueck"}), "cmd_druecken" );  
}
int cmd_druecken(string str)
{
	// keine fehlermeldung damit keiner so schnell drauf kommt
	if( str!="stern" ) return 0;
	

	if(query_wiz_level(TP)>0)
	{
		 //write( "Du bist kein normaler Spieler.\n" );
		 if(present("\nstern_3g", TP)&&present("\nstern_2b",TP))
		 {
			 write( "Du fuehlst Dich von Magie durchflutet und spuerst, dass sich in Deiner Naehe etwas veraendert hat.\n" );
			 TP->AddSp(50);
			 call_other( "/obj/sehertormaster", "DiscoverDoor","/d/andracia/yondala/wolken/lunia/room/lunia_5d"); 
			 present("\nstern_3g", TP)->remove();
			 present("\nstern_2b", TP)->remove();
			 return 1;
		 }
		 else if(!present("\nstern_8d", TP)) CLONE(LUNIA_OBJ +"stern_8d.lpc", TP);
			 
	}
    //gedrueckt= 1;
    write( "Du drueckst auf den Stern aber nichts passiert.\n" );	
	return 1;
}


string elfen()
{
	if (TP->id("elfenspieler")) return("Also DU solltest schon wissen, wie ein Elf aussieht.\n");
		
  return break_string("Wenn Du nicht weisst, wie Elfen aussehen, dann schau Dich doch in Aboriville um.\n");
}


string kobold()
{
	if (TP->id("koboldspieler")) return("Also DU solltest schon wissen, wie ein Kobold aussieht.\n");
		
  return break_string("Wenn Du nicht weisst, wie Kobolde aussehen, dann schau Dich doch im Gebirge um.\n");
}


string mensch()
{
	if (TP->id("menschenspieler")) return("Also DU solltest schon wissen, wie ein Mensch aussieht.\n");
		
  return break_string("Wenn Du nicht weisst, wie Menschen aussehen, dann schau Dich doch zum Beispiel mal in Friedheim um.\n");
}