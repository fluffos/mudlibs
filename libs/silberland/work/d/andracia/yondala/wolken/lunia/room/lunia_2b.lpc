//wird vom Seherportal aufgerufen. Wenn alle drei gedrueckt wurden, dann
//bekommt man das Portal



void create() 
{
  ::create();

  SetProp( P_INT_LONG,QueryProp(P_INT_LONG)+ "Eine grosse Statue steht hier.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
 // gedrueckt=0;

  AddDetail( ({ "statue", "abbild", "zauberer", "yason" }),
    ("Die Statue zeigt ein uebergrosses Abbild von dem beruehmten Zauberer Yason. "+
    "Neben dem mit allerlei Sterne geschmueckten, spitzen Hut und der langen "+
    "Magierrobe, die auch mit vielen Sternen bestickt ist, haelt die Statue einen "+
    "kurzen Zauberstab in der Hand. " ));
  AddDetail( ({ "sterne" }),
    "Robe und Hut sind mit aufgestickten Sternen geschmueckt. Zumindest hat "
	"der Bildhauer an den Raendern der Sterne Faeden modelliert. Ein Stern "
	"sieht irgendwie anders aus.");
  AddDetail( ({ "hut", "robe", "magierrobe" }),
    ("Die lange Robe und der spitze Hut sind mit Sternen geschmueckt. Der Bildhauer "+
    "hat sich grosse Muehe gegeben und sogar die Faeden der aufgestickten Sterne modelliert."));
  AddDetail( ({ "hand" }),
    ("Die Statue haelt einen kurzen, unscheinbaren Zauberstab in der Hand."));
  AddDetail( ({ "zauberstab", "stab" }),
    ("Die Statue von Yason haelt einen kurzen, unscheinbaren Zauberstab in der Hand. "));
  AddDetail( ({ "rand" }),
    ("Rund um den Stern ist ein Rand, der einen winzig schmalen Spalt laesst."));
  AddDetail( ({ "spalt" }),
    ("Sieht aus, als waere der Stern nicht fest mit der Statue verbunden. "
	"Ob man ihn irgendwie bewegen kann?"));
 // AddSpecialDetail( ({ "stern" }),"stern");
  AddDetail( ({ "stern" }),
    ("Dieser Stern scheint anders befestigt zu sein, denn er hat keine "+
	 "Faeden am Rand, aber er besteht doch auch nur aus Stein."));
 
  AddCmd( ({"druecke", "drueck"}), "cmd_druecken" );  

  AddExit( "suedwesten", LUNIA_ROOM + "lunia_3a.lpc" );
  AddExit( "nordosten", LUNIA_ROOM + "lunia_1c.lpc" );
  AddExit( "nordwesten", LUNIA_ROOM + "lunia_1a.lpc" );
}

int cmd_druecken(string str)
{
	// keine fehlermeldung damit keiner so schnell drauf kommt
	if( str!="stern" ) return 0;
   
	if(query_wiz_level(TP)>0)
	{
		 //write( "Du bist kein normaler Spieler.\n" );
		 if(present("\nstern_3g", TP)&&present("\nstern_8d",TP))
		 {
			 write( "Du fuehlst Dich von Magie durchflutet und spuerst, dass sich in Deiner Naehe etwas veraendert hat.\n" );
			 TP->AddSp(50);
			 call_other( "/obj/sehertormaster", "DiscoverDoor","/d/andracia/yondala/wolken/lunia/room/lunia_5d"); 
			 present("\nstern_3g", TP)->remove();
			 present("\nstern_8d", TP)->remove();
			 return 1;
		 }
		 else if(!present("stern_2b", TP)) CLONE(LUNIA_OBJ +"stern_2b.lpc", TP);
	}
    //gedrueckt= 1;
	write( "Du drueckst auf den Stern aber nichts passiert.\n" );
	return 1;
}