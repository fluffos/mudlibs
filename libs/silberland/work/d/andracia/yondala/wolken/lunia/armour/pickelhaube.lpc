//Pickelhaube des Gendarms von Lunia. Nichts besonderes, mittelmaessige Ruestung Helm
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Pickelhaube");
  SetProp(P_LONG,
    "Du siehst einen stabilen schwarzen Helm mit einem kleinen Dorn mittendrauf." );
//  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Pickelhaube");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haube", "pickelhaube", "helm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 100);
                                    

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
