// Yondala@Silberland 3.06.2010
// Umgeschrieben fuers Silberland, ehemals Gebiet von Yason@Andracia

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("hafenbewohner")) 
   AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
    
  AddId(({"hafenbewohner"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Hafenbewohner");
  SetProp( P_LONG, "Ein ganz normaler Hafenbewohner");
  SetProp( P_NAME, "Hafenbewohner");
  SetProp( P_GENDER, MALE);
  SetProp( P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 178); //in cm
  SetProp( P_WEIGHT, 78000); //in g
  SetProp( P_ALIGN, 0); //Gesinnung von -1000 bis +1000

  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmöglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Ein Hafenbewohner"); 
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
  
  //Antworten
  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala beschuetzt uns.", "sagt: ");
  
  
  AddInfo( ({"edorian", "edorian zwirbelstein"}),"Das ist der Name des "+
  "Freiherrn von Zwirbelstein. Seine Burg steht ein gutes Stueck ostwaerts. ","sagt: ");

  AddInfo( ({"hilfe"}), "Ich kann Euch auch nicht helfen. ", "sagt: ");
  AddInfo( ({"quest", "arbeit", "auftrag"}),
     "Tut mir leid. Ich habe keine Arbeit fuer Éuch. ","sagt: ");
  AddInfo( ({"burg", "zwirbelstein"}), 
     "Die Burg Zwirbelstein ist der Sitz des Freiherrn von Zwirbelstein.",
	 "sagt: ");
  AddInfo( ({"welt", "andracia"}),
    "Diese Welt wird Andracia genannt. ","sagt: ");
  AddInfo( ({"essen", "trinken"}), 
     "Fuer die Verpflegung koennt Ihr hier im Hafen die Gasthauser "+
	 "aufsuchen. ", "sagt: ");
  AddInfo( ({"liebe"}),
     "Die Liebe ist ein Geschenk. Haltet Sie fest wenn Ihr sie findet.",
     "sagt: ");

  AddInfo( ({"hafen", "kai", "schiffe", "hafenbecken"}),
  "Ihr befindet Euch doch hier am Hafen. "+
  "Geht zum Kai im Westen und schaut Euch dort die Schiffe an. ","sagt: ");
  AddInfo( ({"reise", "reisen", "transport", "transportmittel"}),
     "Von hier aus kann man in fast alle Richtungen reisen. Die Schiffe "
	 "fahren diesen Hafen regelmaessig an und nehmen gerne Reisende mit. "
	 "Auch die Kutsche kann euch nach Zwirbelstein bringen.","sagt: ");
  
  AddInfo( ({"kutsche"}),
     "Die Kutsche kann Euch gen Osten nach Zwirbelstein bringen.","sagt: ");
  
  AddInfo( ({"kuefer", "viburn", "dargel", "viburn dargel", "fass", "faesser"}),
    "Viburn Dargel ist unser Kuefer hier am Ort. Er hat seine Werkstatt "
	"im Nordosten und stellt dort die besten Faesser des Huegellands her.",
	"sagt: ");
  AddInfo( ({"trolske", "sendason", "haendler", "trolske sendason" , "laden",
  	         "ebnan", "kaukalathis", "ebnan kaukalathis"}),
     "Es gibt hier am Hafen zwei Haendler bei denen man sich ausruesten "
	 "kann: Trolske Sendason und Ebnan Kaukalathis. "+
     "Beide machen zwar faire Preise aber versuchen staendig sich gegen"
	 "seitig die Kundschaft zu stehlen.","sagt: ");
  AddInfo( ({"xandro", "barchenter", "wirt", "xandro barchenter"}),
     "Das ist der Wirt der Hafenkneipe. Dort herrschen rauhe Sitten und "
	 "man kann dort bestimmt das eine oder andere Geruecht aufschnappen. "
	 "Allerdings sind die Getraenke dort recht guenstig.","sagt: ");
  
  AddInfo( ({"hafenkneipe", "kneipe", "pub"}),
     "Die Hafenkneipe von Xandro Barchender ist vom Hafen aus gesehen das "
	 "zweite Gebaeude im Sueden.","sagt: ");
  
  AddInfo( ({"lares", "peutler", "lares peutler", "Lares Peutler",
  	         "fischlokal", "lokal", "restaurant", "fressbude", "tanke"}),
	"Das gepflegte Fischlokal hier am Hafen wird von Lares Peutler, einem "
	"ehemaligen Fischer, gefuehrt. Irgendwann hat er seine Vorliebe zum "+
    "Kochen entdeckt und seither sind seine Fischgerichte im ganzen "
	"Andracia bekannt. Es ist vom Hafen aus das zweite Haus im Norden. ",
	"sagt: ");
  
  AddInfo( ({"boromil", "bregelsaum", "boromil bregelsaum", "hafenmeister"}),
     "Unser Hafenmeister Boromil Bregelsaum ist sicher in seiner "
	 "Hafenmeisterei zu finden. ","sagt: ");
  
  AddInfo( ({"hafenmeisterei"}),
     "Die Hafenmeisterei befindet sich noerdlich direkt am Hafenbecken.",
	 "sagt: ");
  
  AddInfo( ({"semkin", "baerensen", "semkin baerensen", "kontorbesitzer"}),
     "Das Kontor von Semkin Baerensenist das einzige hier am Hafen. Alle "
	 "Waren die hier im Hafen ankommen muessen falls noetig bei ihm "
	 "gelagert werden. Daher hat er seinen Reichtum und auch sein eigenes "
	 "Handelsgeschick haben ihm zu einem der reichsten Maenner Andracias "
	 "gemacht.","sagt: ");
  AddInfo( ({"kontor", "lager", "lagerhaus"}),
     "Das Kontor von Semkin Baerensen koennt ihr kaum verfehlen. "+
     "Vom Hafen aus ist es das letzte Haus im Norden. ","sagt: ");
  
  AddInfo( ({"reeder", "storko", "horigan", "storko horigan"}),
     "Storko Horigan leitet die Werft im Osten. Der Reeder baut immer "
	 "wieder neue Fischerboote und auch hin und wieder ein Handelsschiff."+
     "Auch mit vielen Reparaturen an den Schiffen ist der Reeder beschaef"
	 "tigt. Aber Geruechten zufolge war der Kerl noch nie selbst zur See "
	 "gefahren, trotz seiner Erfahrung im Schiffsbau. ",
	 "sagt: ");
  AddInfo( ({"werft"}),
     "Die Werft ist das grosse Gebause im Osten, ihr koennt es nicht "
	 "verfehlen.",
     "sagt: ");
  AddInfo( ({"yann", "okenheld", "yann okenheld", "seiler"}),
    "Yann Okenheld liefert fuer die Fischer und Seefahrer die Seile "
	"beziehungsweise die starken Faeden fuer die Netze. "+
    "Er sucht schon lange einen Lehrling der ihn in seiner Seilerei "
	"unterstuetzt. ",
	"sagt: ");
  
  AddInfo( ({"seilerei", "seile", "faeden", "faden", "netz", "netze"}),
    "Die Seilerei von Yann Okenheld ist vom Hafen aus gesehen das letzte "
    "Haus zur linken Seite.",
    "sagt: ");

  AddInfo( ({"kedio", "horger", "kedio horger", "schmied", "schmiede", 
             "reparaturen", "reparatur"}), 
    "Falls ihr Reparaturen an eurer Ausruestung benoetigt, so ist Kedio "
	"Horger der Richtige. Seine Schmiede befindet sich vom Hafen aus "
	"gesehen im vorletzten Haus auf rechter Seite.",
	"sagt: ");
	
  AddInfo( ({"pirat", "piraten", "pirateninsel"}), 
    "Die Piraten leben auf einer Insel weit draussen vor der Kueste. "+
    "Sie sind sehr gefaehrlich und wer sich uneingeladen auf ihre Insel "
	"begibt, wird einen Kopf kuerzer gemacht.", 
	"sagt: ");
  
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", 
             "asseln", "spinnen", "maeuse", "ratten"}), 
    "Kaefer, Asseln, Spinnen, Maeuse und Ratten sind Ungeziefer. ", 
	"sagt: ");
	
  AddInfo( ({"kuchen"}), 
  ({"Ich mag jetzt keinen Kuchen.", 
    "Ich bin satt.", 
	"Bitte nicht so suesses Zeug jetzt."}) , 
	"sagt: ");
  
  AddInfo( ({"herberge"}), 
    "An der Strasse nach Zwirbelstein liegt eine Herberge. Meint ihr "
	"vielleicht diese?" ,"sagt: ");
	
  AddInfo( ({"kuh", "kuehe"}), 
    "Hier am Hafen sind die meissten leute Fischer. Fuer Kuehe ist hier "
	"nicht genug Weideland." ,"sagt: ");
  
  AddInfo( ({"huehner", "huhn"}), 
    "Viele Leute zuechten Huehner. Ihr seid doch kein Huehnerdieb, oder?", 
	"sagt: ");
  
  AddInfo( ({"schiff", "schiffe"}), 
    "Am Kai kann man beobachten wie die Schiffe anlegen. Vielleicht findet "
	"ihr dort was ihr sucht." ,"sagt: ");
  AddInfo( ({"insel"}), 
    "Es gibt sher viele Inseln. Welche meint ihr denn?" ,"sagt: ");
  AddInfo( ({"canibainsel", "caniba"}), 
    "Caniba ist eine kleine Insel und ihre Bewohner sind ein kleines "+
    "ungemuetliches Volk. Passt auf was ihr esst wenn ihr dort seid." ,
	"sagt: ");
  
  AddInfo( ({"flotte", "handelsflotte"}), 
    "Semkin Baerensenhat hier die groesste Flotte. Seine Schiffe sind "+
    "staendig unterwegs um exotische Waren aus dem Sueden zu bringen." ,
	"sagt: ");
  AddInfo( ({"lausebengel"}), "Ach, der kleine stellt doch nix an." ,
    "sagt: ");
  
  AddInfo( ({"elfen", "aboriville", "elfenstadt"}), 
    "Hier sieht man eigentlich selten Elfen. Die Elfenstadt Aboriville "
	"liegt noch hinter den Bergen im Osten." ,"sagt: ");
	
  AddInfo( ({"arbeit", "aufgabe", "aufgaben", "quest"}) , 
    "Ich habe keine Arbeit fuer Euch.", "sagt: ");
  
  AddInfo( ({"kobold", "kobolde"}), 
    "Ich kenne diese kleinen Gesellen. Aber solche Wesen sieht man hier eher selten." ,"sagt: ");
  AddInfo( ({"buergermeister"}), 
    "Wir haben hier keinen Buergermeister. Auch wenn das Hafendorf ein "
	"gutes Stueck von Zwirbelstein entfernt ist, fallen wir trotzdem noch "
	"in die Gerichtsbarkeit des Freiherrn." ,"sagt: ");
	
  AddInfo( ({"meer", "see"}), 
    "Das weite Meer begrenzt Andracia nach Westen. Keiner weiss was sich "
	"dort hinter dem Horizont befinden mag. Man munkelt, dort wuerde sich "
	"ein silbernes Land befinden." ,"sagt: ");
	
  AddInfo( ({"insel", "inseln"}), 
    "Es gibt mehrere Inseln Meer aber nur wenige sind erforscht." ,"sagt: ");
  
  AddInfo( ({"seemannstod", "ertrinken"}), 
     "Vielen Seefahrern wurde die kalte Tiefe des Meers zum Grab." ,
	 "sagt: ");
  AddInfo( ({"alkohol", "bier"}), 
    "Wollt ihr mir vielleicht ein Bier ausgeben?" ,"fragt: ");
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  /*
  AddInfo( ({""}), "" ,"sagt: ");
  */
}

void InformDefend(object enemy)
{
    Kill(enemy);
}