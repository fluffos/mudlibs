#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({});
  create_default_npc(15); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"reeder", "storko", "horigan", "storko horigan", "Storko Horigan" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Storko Horigan, der Reeder");
  SetProp( P_LONG, BS("Dies ist Storko Horigan, der Reeder. Er hat ungepflegten Kinnbart, in dem sogar "+
    "noch ein langer Holzspan haengt. Sein wettergegerbte Gesicht zeugt von vielen Jahren der Erfahrung. " ) );
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Storko Horigan");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM + "hafen_h3.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "hafen_h3.lpc" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Reeder"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Storko Horigan bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"werft"}), 
  "Dies ist meine Werft. Braucht euer Schiff eine Reparatur, oder warum stoert Ihr mich?","sagt: ");
  AddInfo( ({"bart", "kinnbart"}),
  "Stoert mich bitte nicht mit solch unwichtigem Zeug.", "sagt: " );
  AddInfo( ({"tuer", "angrenzender raum", "nachbarraum"}), 
  "Mein Buero befindet sich hinter der Tuer im Osten. Ich schliesse Sie immer fest ab. Ich moechte nicht dass ihr Euch dort umschaut. " ,"sagt: ");
  
  //Ausruestung
   SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME("/p/armour/armour/weste.lpc");
  CLONEME("/p/armour/trousers/hose.lpc");
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME("/p/armour/gloves/lederhandschuhe.lpc" );

  command("trage alles");
  CLONEME( "/p/weapon/sword/kurzschwert.lpc" );
  command("zuecke schwert");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
     case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }		

    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
