#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({});
  create_default_npc(13); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"seebaer", "seemann" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Seemann");
  SetProp( P_LONG, "Ein alter Seemann der gerne Seemannsgarn erzaehlt.");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 1);
  SetProp( P_NAME, "Seemann");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM  ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM  ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Seemann"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Der Seemann bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "sturmjacke.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "enterhaken.lpc" );
  command("zuecke haken");
  
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }		
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
