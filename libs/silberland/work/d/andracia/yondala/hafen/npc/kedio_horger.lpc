// Schmied
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

#define TY(x) if(find_player("yason")) tell_object(find_player("yason"),x)

inherit "std/repair";
// inherit NPC + "hafenbewohner.lpc";
object *aergerer;
void reset()  {
  ::reset();
  aergerer=({}); // Man ist Dir nur bis zum reset boese.
}

void init()
{
   ::init();
   if (this_player() && this_player()->id("hafenbewohner")) AddDefender(this_player());
}


void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
    aergerer=({}); 
  create_default_npc(16); 

  //Properties
  AddId(({"kedio", "horger", "kedio horger", "schmied", "hafenbewohner" })); 
  SetProp( P_SHORT, "Kedio Horger, der Schmied");
  SetProp( P_LONG, ("Dies ist Kedio Horger, der Schmied. Er hat kurze "
                    "braune Haare und seine Ohren gleichen den Segeln "
					"eines Dreimasters. Es kann wohl sein, dass in seinen "
					"Adern auch Elfenblut fliesst.") );
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Kedio Horger");
  SetProp( P_KILL_NAME, "Schmied"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Kedio Horger bruellt: Euch werd ich das Licht ausblasen! \n",
  	                   "Kedio Horger sagt: Ihr werdet meinen Hammer zu spueren bekommen! \n",
  	                   "Kedio Horger ruft: MachtEuch auf Euer Ende bereit! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
   
  AddInfo( "yondala", "Yondala beschuetzt uns.", "sagt: ");
  
  
  AddInfo( ({"edorian", "edorian zwirbelstein"}),"Das ist der Name des "+
  "Freiherrn von Zwirbelstein. Seine Burg steht ein gutes Stueck ostwaerts. ","sagt: ");

  AddInfo( ({"hilfe"}), "Ich kann Euch auch nicht helfen. ", "sagt: ");
  AddInfo( ({"quest", "arbeit", "auftrag"}),
     "Tut mir leid. Ich habe keine Arbeit fuer Éuch. ","sagt: ");
  AddInfo( ({"burg", "zwirbelstein"}), 
     "Die Burg Zwirbelstein ist der Sitz des Freiherrn von Zwirbelstein.",
	 "sagt: ");
  AddInfo( ({"welt", "andracia"}),
    "Diese Welt wird Andracia genannt. ","sagt: ");
  AddInfo( ({"essen", "trinken"}), 
     "Fuer die Verpflegung koennt Ihr hier im Hafen die Gasthauser "+
	 "aufsuchen. ", "sagt: ");
  AddInfo( ({"liebe"}),
     "Die Liebe ist ein Geschenk. Haltet Sie fest wenn Ihr sie findet.",
     "sagt: ");

  AddInfo( ({"hafen", "kai", "schiffe", "hafenbecken"}),
  "Ihr befindet Euch doch hier am Hafen. "+
  "Geht zum Kai im Westen und schaut Euch dort die Schiffe an. ","sagt: ");
  AddInfo( ({"reise", "reisen", "transport", "transportmittel"}),
     "Von hier aus kann man in fast alle Richtungen reisen. Die Schiffe "
	 "fahren diesen Hafen regelmaessig an und nehmen gerne Reisende mit. "
	 "Auch die Kutsche kann euch nach Zwirbelstein bringen.","sagt: ");
  
  AddInfo( ({"kutsche"}),
     "Die Kutsche kann Euch gen Osten nach Zwirbelstein bringen.","sagt: ");
  
  AddInfo( ({"kuefer", "viburn", "dargel", "viburn dargel", "fass", "faesser"}),
    "Viburn Dargel ist unser Kuefer hier am Ort. Er hat seine Werkstatt "
	"im Nordosten und stellt dort die besten Faesser des Huegellands her.",
	"sagt: ");
  AddInfo( ({"trolske", "sendason", "haendler", "trolske sendason" , "laden",
  	         "ebnan", "kaukalathis", "ebnan kaukalathis"}),
     "Es gibt hier am Hafen zwei Haendler bei denen man sich ausruesten "
	 "kann: Trolske Sendason und Ebnan Kaukalathis. "+
     "Beide machen zwar faire Preise aber versuchen staendig sich gegen"
	 "seitig die Kundschaft zu stehlen.","sagt: ");
  AddInfo( ({"xandro", "barchenter", "wirt", "xandro barchenter"}),
     "Das ist der Wirt der Hafenkneipe. Dort herrschen rauhe Sitten und "
	 "man kann dort bestimmt das eine oder andere Geruecht aufschnappen. "
	 "Allerdings sind die Getraenke dort recht guenstig.","sagt: ");
  
  AddInfo( ({"hafenkneipe", "kneipe", "pub"}),
     "Die Hafenkneipe von Xandro Barchender ist vom Hafen aus gesehen das "
	 "zweite Gebaeude im Sueden.","sagt: ");
  
  AddInfo( ({"lares", "peutler", "lares peutler", "Lares Peutler",
  	         "fischlokal", "lokal", "restaurant", "fressbude", "tanke"}),
	"Das gepflegte Fischlokal hier am Hafen wird von Lares Peutler, einem "
	"ehemaligen Fischer, gefuehrt. Irgendwann hat er seine Vorliebe zum "+
    "Kochen entdeckt und seither sind seine Fischgerichte im ganzen "
	"Andracia bekannt. Es ist vom Hafen aus das zweite Haus im Norden. ",
	"sagt: ");
  
  AddInfo( ({"boromil", "bregelsaum", "boromil bregelsaum", "hafenmeister"}),
     "Unser Hafenmeister Boromil Bregelsaum ist sicher in seiner "
	 "Hafenmeisterei zu finden. ","sagt: ");
  
  AddInfo( ({"hafenmeisterei"}),
     "Die Hafenmeisterei befindet sich noerdlich direkt am Hafenbecken.",
	 "sagt: ");
  
  AddInfo( ({"semkin", "baerensen", "semkin baerensen", "kontorbesitzer"}),
     "Das Kontor von Semkin Baerensenist das einzige hier am Hafen. Alle "
	 "Waren die hier im Hafen ankommen muessen falls noetig bei ihm "
	 "gelagert werden. Daher hat er seinen Reichtum und auch sein eigenes "
	 "Handelsgeschick haben ihm zu einem der reichsten Maenner Andracias "
	 "gemacht.","sagt: ");
  AddInfo( ({"kontor", "lager", "lagerhaus"}),
     "Das Kontor von Semkin Baerensen koennt ihr kaum verfehlen. "+
     "Vom Hafen aus ist es das letzte Haus im Norden. ","sagt: ");
  
  AddInfo( ({"reeder", "storko", "horigan", "storko horigan"}),
     "Storko Horigan leitet die Werft im Osten. Der Reeder baut immer "
	 "wieder neue Fischerboote und auch hin und wieder ein Handelsschiff."+
     "Auch mit vielen Reparaturen an den Schiffen ist der Reeder beschaef"
	 "tigt. Aber Geruechten zufolge war der Kerl noch nie selbst zur See "
	 "gefahren, trotz seiner Erfahrung im Schiffsbau. ",
	 "sagt: ");
  AddInfo( ({"werft"}),
     "Die Werft ist das grosse Gebause im Osten, ihr koennt es nicht "
	 "verfehlen.",
     "sagt: ");
  AddInfo( ({"yann", "okenheld", "yann okenheld", "seiler"}),
    "Yann Okenheld liefert fuer die Fischer und Seefahrer die Seile "
	"beziehungsweise die starken Faeden fuer die Netze. "+
    "Er sucht schon lange einen Lehrling der ihn in seiner Seilerei "
	"unterstuetzt. ",
	"sagt: ");
  
  AddInfo( ({"seilerei", "seile", "faeden", "faden", "netz", "netze"}),
    "Die Seilerei von Yann Okenheld ist vom Hafen aus gesehen das letzte "
    "Haus zur linken Seite.",
    "sagt: ");

  AddInfo( ({"kedio", "horger", "kedio horger", "schmied", "schmiede", 
             "reparaturen", "reparatur"}), 
    "Falls ihr Reparaturen an eurer Ausruestung benoetigt, so ist Kedio "
	"Horger der Richtige. Seine Schmiede befindet sich vom Hafen aus "
	"gesehen im vorletzten Haus auf rechter Seite.",
	"sagt: ");
	
  AddInfo( ({"pirat", "piraten", "pirateninsel"}), 
    "Die Piraten leben auf einer Insel weit draussen vor der Kueste. "+
    "Sie sind sehr gefaehrlich und wer sich uneingeladen auf ihre Insel "
	"begiebt wird einen Kopf kuerzer gemacht.", 
	"sagt: ");
  
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", 
             "asseln", "spinnen", "maeuse", "ratten"}), 
    "Kaefer, Asseln, Spinnen, Maeuse und Ratten sind Ungeziefer. ", 
	"sagt: ");
	
  AddInfo( ({"kuchen"}), 
  ({"Ich mag jetzt keinen Kuchen.", 
    "Ich bin satt.", 
	"Bitte nicht so suesses Zeug jetzt."}) , 
	"sagt: ");
  
  AddInfo( ({"herberge"}), 
    "An der Strasse nach Zwirbelstein liegt eine Herberge. Meint ihr "
	"vielleicht diese?" ,"sagt: ");
	
  AddInfo( ({"kuh", "kuehe"}), 
    "Hier am Hafen sind die meissten leute Fischer. Fuer Kuehe ist hier "
	"nicht genug Weideland." ,"sagt: ");
  
  AddInfo( ({"huehner", "huhn"}), 
    "Viele Leute zuechten Huehner. Ihr seid doch kein Huehnerdieb, oder?", 
	"sagt: ");
  
  AddInfo( ({"schiff", "schiffe"}), 
    "Am Kai kann man beobachten wie die Schiffe anlegen. Vielleicht findet "
	"ihr dort was ihr sucht." ,"sagt: ");
  AddInfo( ({"insel"}), 
    "Es gibt sher viele Inseln. Welche meint ihr denn?" ,"sagt: ");
  AddInfo( ({"canibainsel", "caniba"}), 
    "Caniba ist eine kleine Insel und ihre Bewohner sind ein kleines "+
    "ungemuetliches Volk. Passt auf was ihr esst wenn ihr dort seid." ,
	"sagt: ");
  
  AddInfo( ({"flotte", "handelsflotte"}), 
    "Semkin Baerensenhat hier die groesste Flotte. Seine Schiffe sind "+
    "staendig unterwegs um exotische Waren aus dem Sueden zu bringen." ,
	"sagt: ");
  AddInfo( ({"lausebengel"}), "Ach, der kleine stellt doch nix an." ,
    "sagt: ");
  
  AddInfo( ({"elfen", "aboriville", "elfenstadt"}), 
    "Hier sieht man eigentlich selten Elfen. Die Elfenstadt Aboriville "
	"liegt noch hinter den Bergen im Osten." ,"sagt: ");
	
  AddInfo( ({"arbeit", "aufgabe", "aufgaben", "quest"}) , 
    "Ich habe keine Arbeit fuer Euch.", "sagt: ");
  
  AddInfo( ({"kobold", "kobolde"}), 
    "Ich kenne diese kleinen Gesellen. Aber solche Wesen sieht man hier eher selten." ,"sagt: ");
  AddInfo( ({"buergermeister"}), 
    "Wir haben hier keinen Buergermeister. Auch wenn das Hafendorf ein "
	"gutes Stueck von Zwirbelstein entfernt ist, fallen wir trotzdem noch "
	"in die Gerichtsbarkeit des Freiherrn." ,"sagt: ");
	
  AddInfo( ({"meer", "see"}), 
    "Das weite Meer begrenzt Andracia nach Westen. Keiner weiss was sich "
	"dort hinter dem Horizont befinden mag. Man munkelt, dort wuerde sich "
	"ein silbernes Land befinden." ,"sagt: ");
	
  AddInfo( ({"insel", "inseln"}), 
    "Es gibt mehrere Inseln Meer aber nur wenige sind erforscht." ,"sagt: ");
  
  AddInfo( ({"seemannstod", "ertrinken"}), 
     "Vielen Seefahrern wurde die kalte Tiefe des Meers zum Grab." ,
	 "sagt: ");
  AddInfo( ({"alkohol", "bier"}), 
    "Wollt ihr mir vielleicht ein Bier ausgeben?" ,"fragt: ");

  AddInfo( ({"schmiede"}), 
  "Dies ist meine Schmiede. ", "sagt: ");

  /*
  AddInfo( ({""}), "" ,"sagt: ");
  */

  //Ausruestung
  SUID;
  CLONEME("/p/armour/armour/hemd.lpc");
  CLONEME("/p/armour/trousers/hose.lpc");
  CLONEME("/p/armour/boots/lederstiefel.lpc");
  CLONEME("/p/armour/belt/guertel.lpc");

   command("trage alles");
  CLONEME( "/p/weapon/club/schmiedehammer" );
  command("zuecke hammer"); 

  // befehle
  AddCmd( ({ "vergleiche","vergleich" }), "vergleichen" );
}

int vergleichen(string str)
{
  object victim1, victim2;
  
  string *damtyp1, *damtyp2, vtype, vtype2, wtype, result, vname, wname, text1, text2; 
  string *damres1, *damres2;
  //*wdamtyp, vtype, wtype, result, vname, wname, text1;
  //string *vdamtyp2, *wdamtyp2, vtype2, wtype2, result2, vname2, wname2, text2;
  mapping rues1, rues2;
  
  int zahl1,zahl2,zahl3;//vwc, wwc, vhands, whands, vwcfix, wwcfix, vqdecay, wqdecay, wcdif, suc; 

  notify_fail(TO->name()+" sagt: Was moechtet Ihr mit was vergleichen?\n");
  if(!str) return 0;

  if (TP->InFight())
  {
  	write("Du kannst waehrend dem Kampf nichts vergleichen!\n");
    return 1;
  }
  if (TO->InFight())
  {
  	write(TO->name()+" kann gerade nicht.\n");
  	return 1;
  }  
  if( sscanf(str, "%s mit %s", text1,text2 ) != 2) //wenn kein string mitgegeben
    return 0;
  if(present(text1, TP)) victim1=present(text1, TP);
  else 
  {
  	write(TO->name()+" sagt: Du hast kein "+capitalize(text1)+"!\n");
    return 1;
  }
  if(present(text2, TP)) victim2=present(text2, TP);
  else    
  {
    write(TO->name()+" sagt: Du hast kein "+capitalize(text2)+"!\n");
    return 1;
  }
  if (victim1==victim2)
  {
    write(TO->name()+" sagt: Du kannst einen Gegenstand nicht mit sich selbst vergleichen.\n");
    return 1;
  }   
  
  //Wenn beides Waffen sind.
  if( text1=victim1->QueryProp(P_WEAPON_TYPE) )
  if( text2=victim2->QueryProp(P_WEAPON_TYPE) )
  {
	  say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{
			command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		  return 1;
		}
		this_player()->AddMoney(-200);
		write("Du zahlst 200 Muenzen.\n");
		say( TPN+" zahlt 200 Muenzen\n",TP);
  	write( BS(TO->name()+" vergleicht "+victim1->name(WEN)+" mit "+ victim2->name(WEM)+".\n") );
  
    switch( text1 )
    {
      case WT_SWORD    : text1="ein Schwert"; break;
      case WT_AXE      : text1="eine Axt"; break;
      case WT_CLUB     : text1="ein Knueppel"; break;
      case WT_SPEAR    : text1="ein Speer"; break;
      case WT_KNIFE    : text1="ein Messer"; break;
      case WT_WHIP     : text1="eine Peitsche"; break;
      case WT_CHAIN    : text1="ein Morgenstern"; break;
    }
    switch( text2 )
    {
      case WT_SWORD    : text2="ein Schwert"; break;
      case WT_AXE      : text2="eine Axt"; break;
      case WT_CLUB     : text2="ein Knueppel"; break;
      case WT_SPEAR    : text2="ein Speer"; break;
      case WT_KNIFE    : text2="ein Messer"; break;
      case WT_WHIP     : text2="eine Peitsche"; break;
      case WT_CHAIN    : text2="ein Morgenstern"; break;
    }

    // Waffentyp
    if( text1!=text2 )
      write(capitalize(victim1->name(WER,1))+" ist "+text1+", "+victim2->name(WER,1)+" hingegen ist "+text2+".\n");
    else 
      write("Beide Waffen sind "+text2+".\n");
    zahl1=victim1->QueryProp(P_NR_HANDS);
    zahl2=victim2->QueryProp(P_NR_HANDS);

    // Zweihaendig
    if( zahl1==zahl2)
    {
      if( zahl1==2 )
        write("Beide Waffen muessen mit zwei Haenden gefuehrt werden.\n");
      else
        write("Beide Waffen benoetigen nur eine Hand zum Fuehren.\n");
    } 
    else 
    {
      if( zahl1==2 )
        write(capitalize(victim1->name(WER,1))+" benoetigt beide Haende zum Fuehren, "+victim2->name()+" nur eine.\n");
      else
        write(capitalize(victim1->name(WER,1))+" benoetigt nur eine Hand zum Fuehren, "+victim2->name()+" beide.\n");
    }

    zahl1=victim1->QueryProp(P_WC) - victim2->QueryProp(P_WC);
  
    // Schaden zahl1= WC von Waffe 1 - WC von Waffe 2
    if( zahl1 < -150 )
      write(capitalize(victim1->name(WER,1))+" macht sehr viel weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -150 ) 
      write(capitalize(victim1->name(WER,1))+" macht viel weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -75 )  
      write(capitalize(victim1->name(WER,1))+" macht weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -30 )  
      write(capitalize(victim1->name(WER,1))+" macht etwas weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  0 )
      write(capitalize(victim1->name(WER,1))+" macht etwas mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  30 )
      write(capitalize(victim1->name(WER,1))+" macht mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  75 )
      write(capitalize(victim1->name(WER,1))+" macht viel mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  150 )
      write(capitalize(victim1->name(WER,1))+" macht sehr viel mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 == 0 )
      write(capitalize(victim1->name())+" macht genausoviel Schaden wie "+victim2->name(WER,1)+".\n");
    
    zahl1=victim1->QueryProp(P_QUALITY_DECAY);
    zahl2=victim2->QueryProp(P_QUALITY_DECAY);  
  
    // Abnutzung
    if( zahl1>zahl2)
      write(capitalize(victim1->name(WER,1))+" nuetzt sich langsamer ab als "+victim2->name(WER,1)+".\n");
    else if( zahl1<zahl2)
      write(capitalize(victim1->name(WER,1))+" nuetzt sich schneller ab als "+victim2->name(WER,1)+".\n");
    else
      write( "Beide Waffen nuetzen sich gleich schnell ab. \n");
    
    // Schadensart
    damtyp1=victim1->QueryProp(P_DAM_TYPE);
    damtyp2=victim2->QueryProp(P_DAM_TYPE);

    // filter nach nicht-physischen schaden
    damtyp1 -= m_indices(PHYSICAL_DAMAGE_TYPES);
    damtyp2 -= m_indices(PHYSICAL_DAMAGE_TYPES);
    if( !sizeof(damtyp1) && !sizeof(damtyp2) ) //Wenn beide nur koerperlichen Schaden machen
    {
      write("Beide Waffen verursachen nur physischen Schaden.\n");
    }   
    else 
    {
      if( sizeof(damtyp1) > 1 && sizeof(damtyp2) > 1 )
        write("Beide Waffen verursachen aussergewoehnlichen Schaden.\n");
      else 
      {  
        write(capitalize(victim1->name(WER,1)));
        if( sizeof(damtyp1) > 1 )
          write (" verursacht aussergewoehnlichen Schaden\n");
        if( sizeof(damtyp1) == 1 )//wenn er genau einen unkoerperlichen Schaden macht
        {
          switch(damtyp1[0])
          {
            case DT_FIRE:     write (" Feuerschaden"); break;
            case DT_COLD:     write (" Kaelteschaden"); break;
            case DT_ELECTRIC: write (" schockartigen Schaden"); break;
            case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
            case DT_TERROR:   write (" Angst"); break;
            case DT_HOLY:     write (" heiligen Schaden"); break;
            case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
            default:          write (" besonderen Schaden"); break;
          }
        } 
        else 
          write (" nur physischen Schaden, wohingegen "+victim2->name(WER,1));
        if( sizeof(damtyp2) > 1 )
          write(" aussergewoehnlichen Schaden");
        if( sizeof(damtyp2) == 1 )
        {
          switch(damtyp2[0])
          {
            case DT_FIRE:     write (" Feuerschaden"); break;
            case DT_COLD:     write (" Kaelteschaden"); break;
            case DT_ELECTRIC: write (" schockartigen Schaden"); break;
            case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
            case DT_TERROR:   write (" Angst"); break;
            case DT_HOLY:     write (" heiligen Schaden"); break;
            case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
            default:          write (" besonderen Schaden"); break;
          }
        } 
        else 
          write (" nur physischen Schaden verursacht.\n");
      }
    }
    
    zahl1=victim1->QueryProp(P_WC_FIX);
    zahl2=victim2->QueryProp(P_WC_FIX);

    // Abnutzung
    if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" liegt besser in der Hand als "+victim2->name(WER,1)+".\n");
    else if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" liegt nicht so gut in der Hand als "+victim2->name(WER,1)+".\n");
    else
      write ("Beide Waffen liegen gleich gut in der Hand. \n");

    //Gewicht
    zahl1=victim1->QueryProp(P_WEIGHT);
    zahl2=victim2->QueryProp(P_WEIGHT);
  
    if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist schwerer als "+victim2->name(WER,1)+".\n");
    else if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist leichter als "+victim2->name(WER,1)+".\n");
    else
      write ("Beide Waffen wiegen ungefaehr gleich viel. \n");
    return 1;
  }
  //Wenn beides Ruestungen sind:
  else if( text1=victim1->QueryProp(P_ARMOUR_TYPE)&& text2=victim2->QueryProp(P_ARMOUR_TYPE) )
  {
   	say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{
			command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		  return 1;
		}
		this_player()->AddMoney(-200);
		write("Du zahlst 200 Muenzen.\n");
		say(TPN+" zahlt 200 Muenzen\n",TP);
  	write( BS(TO->name()+" vergleicht "+victim1->name(WEN)+" mit "+ victim2->name(WEM)+".\n") );
    switch( victim1->QueryProp(P_ARMOUR_TYPE) )
    {
      case AT_ARMOUR:  text1="Panzer"; break;
      case AT_HELMET:  text1="Helm"; break;
      case AT_AMULET:  text1="Amulett"; break;
      case AT_RING:    text1="Ring"; break;
      case AT_GLOVE:   text1="Handschuh"; break;
      case AT_CLOAK:   text1="Umhang"; break;
      case AT_BOOT:    text1="Stiefel"; break;
      case AT_SHIELD:  text1="Schild"; break;
      case AT_TROUSERS: text1="Hosen"; break;
      case AT_BELT:    text1="Guertel"; break;
      case AT_BRACERS: text1="Armschienen"; break;
      case AT_MISC:    text1="Besonderes"; break;
    }
    switch( victim2->QueryProp(P_ARMOUR_TYPE) )
    {
      case AT_ARMOUR:  text2="Panzer"; break;
      case AT_HELMET:  text2="Helm"; break;
      case AT_AMULET:  text2="Amulett"; break;
      case AT_RING:    text2="Ring"; break;
      case AT_GLOVE:   text2="Handschuh"; break;
      case AT_CLOAK:   text2="Umhang"; break;
      case AT_BOOT:    text2="Stiefel"; break;
      case AT_SHIELD:  text2="Schild"; break;
      case AT_TROUSERS: text2="Hosen"; break;
      case AT_BELT:    text2="Guertel"; break;
      case AT_BRACERS: text2="Armschienen"; break;
      case AT_MISC:    text2="Besonderes"; break;
    }
    // Ruestungstyp
    if( text1==text2)
      write("Beide Ruestungen sind vom Typ "+text1+".\n");
    else 
      write(capitalize(victim1->name(WER,1))+" ist vom Typ "+text1+", "+victim2->name(WER,1)+" gehoert zum Typ "+text2+".\n");
    
    //Gewicht
    zahl1=victim1->QueryProp(P_WEIGHT);
    zahl2=victim2->QueryProp(P_WEIGHT);
  
    if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist schwerer als "+victim2->name(WER,1)+".\n");
    else if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist leichter als "+victim2->name(WER,1)+".\n");
    else
      write ("Beide Ruestungen wiegen ungefaehr gleich viel. \n");

    text1=victim1->QueryProp(P_INFO);
    text2=victim2->QueryProp(P_INFO);

    if(text1&&text2) write("Beide Ruestungen scheinen ein Geheimnis zu haben.\n");
    else if(text1) write(capitalize(victim1->name(WER,1))+" scheint ein Geheimnis zu haben.\n");
    else if(text2) write(capitalize(victim2->name(WER,1))+" scheint ein Geheimnis zu haben.\n");

    zahl1=victim1->QueryProp(P_AC);
    zahl2=victim2->QueryProp(P_AC);
    zahl3=zahl1-zahl2;  
    if(zahl3>40)write(capitalize(victim1->name(WER,1))+" schuetzt unendlich viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>35)write(capitalize(victim1->name(WER,1))+" schuetzt unglaublich viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>30)write(capitalize(victim1->name(WER,1))+" schuetzt sehr viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>25)write(capitalize(victim1->name(WER,1))+" schuetzt viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>20)write(capitalize(victim1->name(WER,1))+" schuetzt um einiges besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>15)write(capitalize(victim1->name(WER,1))+" schuetzt besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>10)write(capitalize(victim1->name(WER,1))+" schuetzt etwas besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>5)write(capitalize(victim1->name(WER,1))+" schuetzt ein wenig besser als "+victim2->name(WER,1)+".\n");

    else if(zahl3<-40)write(capitalize(victim2->name(WER,1))+" schuetzt unendlich viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-35)write(capitalize(victim2->name(WER,1))+" schuetzt unglaublich viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-30)write(capitalize(victim2->name(WER,1))+" schuetzt sehr viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-25)write(capitalize(victim2->name(WER,1))+" schuetzt viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-20)write(capitalize(victim2->name(WER,1))+" schuetzt um einiges besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-15)write(capitalize(victim2->name(WER,1))+" schuetzt besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-10)write(capitalize(victim2->name(WER,1))+" schuetzt etwas besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-5)write(capitalize(victim2->name(WER,1))+" schuetzt ein wenig besser als "+victim1->name(WER,1)+".\n");
    else write("Beide Ruestungen schuetzen etwa gleich gut.\n");

    text1=victim1->QueryProp(P_WEAR_RESTRICTIONS);
    text2=victim2->QueryProp(P_WEAR_RESTRICTIONS);
    if(!text1&&!text2) write("Beide Ruestungen koennen von jedem getragen werden.\n");
    else if(text1) write(capitalize(victim1->name(WER,1))+" kann nicht von jedem getragen werden.\n");
    else write(capitalize(victim2->name(WER,1))+" kann nicht von jedem getragen werden.\n");
  }
  else
   	write( TO->name()+" sagt: Eine Ruestung mit einer Waffe zu vergleichen macht keinen Sinn. \n" );
  return 1;
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
   case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }	 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
