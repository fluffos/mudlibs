//inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  
  create_default_npc(7); 

  AddId(({"bengel", "lausebengel" })); 
  SetProp( P_SHORT, "Ein Lausebengel");
  SetProp( P_LONG, "Ein kleiner Junge, dem man die Flausen im Kopf schon "
  "ansieht, daher wird er von allen nur noch Lausebengel genannt.");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 1);
  SetProp( P_NAME, "Lausebengel");
  SetProp( P_MNPC_AREA, ROOM ); 
  SetProp( P_MNPC_DEFAULTROOM, ROOM ); 
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Lausebengel"); //string fuer Todessequenz
 
  //Chats
  SetAttackChats( 2, ({"Der Lausebengel bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Ausruestung
  
  SUID;
   CLONEME("/p/armour/trousers/hose.lpc");
   CLONEME("/p/armour/helm/wollmuetze.lpc");
  command("trage alles");
  /*
  CLONEME( OBJ + "zwille.lpc" ); //noch ne lustige Zwille, mit der man auf jemanden schiessen kann
  */
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TP->name(WEM)+ ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TP->name(WEM) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Bloedsinn. \n", 
        "sagt zu " + TP->name(WEM) + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich meiner Mama sagen. \n", 
        "sagt zu " + TP->name(WEM) + ": Das werd ich meiner Mama sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TP->name(WEM) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes fuer sowas. \n", 
        "sagt zu " + TP->name(WEM) + ": Bitte such Dir jemand anderes fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TP->name(WEN) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TP->name() + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


