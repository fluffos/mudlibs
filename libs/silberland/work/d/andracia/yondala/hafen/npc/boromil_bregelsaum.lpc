#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({});
  create_default_npc(15); 

  //Properties
  AddId(({"boromil", "bregelsaum", "boromil bregelsaum","hafenmeister" })); 
  SetProp( P_SHORT, "Boromil Bregelsaum, der Hafenmeister");
  SetProp( P_LONG, "Dies ist Boromil Bregelsaum, der Hafenmeister. Er hat "
                   "einen kurzen, gekraeuselten Bart und sein rechtes "
				   "Auge ist zur Haelfte geschlossen, was ihm einen "
				   "komischen Gesichtsausdruck verleiht." );
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Boromil Bregelsaum");
  SetProp( P_MNPC_AREA, ROOM + "hafen_d1.lpc" );
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "hafen_d1.lpc" ); 
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); 
  SetProp( P_KILL_NAME, "Hafenmeister"); 
 
  //Chats
  SetAttackChats( 5, ({"Boromil Bregelsaum sagt: In meinem Hafen haben Randalierer keine Zukunft! \n",
  	                   "Boromil Bregelsaum sagt: Ihr seid gleich Futter fuer die Fische!",
  	                   "Boromil Bregelsaum bruellt: Ihr seid eine Ratte!" }) ); // rate in%
  AddDetail( ({"auge"}), 
    "Ich habe einmal bei einem Sturm ein Fass an den Kopf bekommen und "
	"seitdem sehe ich auf dem rechten Auge kaum noch etwas. Darum sag ich "
	"jedem Schiffsfuehrer immer wieder, dass er seine Ladung besonders "
	"gut vertaeuen soll. ");
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"hafenmeisterei"}), "Dies ist meine Hafenmeisterei. Womit kann ich Euch helfen?", "sagt: ");
  AddInfo( ({"auge"}), 
    "Ich habe einmal bei einem Sturm ein Fass an den Kopf bekommen und "
	"seitdem sehe ich auf dem rechten Auge kaum noch etwas. Darum sag ich "
	"jedem Schiffsfuehrer immer wieder, dass er seine Ladung besonders "
	"gut vertaeuen soll. " ,"sagt: ");
  AddInfo( ({"bart"}), 
    "Hab ich nicht einen schoenen Bart?" ,"fragt: ");
  AddInfo( ({"liegeplan", "plan"}),
    "Auf einem Liegeplan werden die Schiffe eingetragen, die sich im "+
    "Hafen einen festen Platz beim Hafenmeister eingetragen haben. ",
	"sagt: ");
 AddInfo( ({"seekarten", "karten", "seekarte", "karte"}),
    "Auf Seekarten sind Untiefen und vieles mehr verzeichnet. Als "+
    "Kapitaen muss man sich immer mit den aktuellsten Seekarten versorgen, "+
    "sonst lauft man auf eine Untiefe und geht unter. ",
	"sagt: ");
 AddInfo( ({"hafen"}), 
    "Ich bin der Hafenmeister dieses Hafens. Hier tut niemand was ohne mein Wissen" ,
	"sagt: ");
 AddInfo( ({"wissen"}), 
    "Ich weiss, was hier geschieht." ,
	"sagt: ");
 AddInfo( ({"kapitaen", "kapitaene", "schiffsfuehrer"}),
    "Jeder Schiffsfuehrer muss ein Kapitaenspatent erworben und verdient "+
    "haben bevor er in See stechen darf. " ,
	"sagt: ");
 AddInfo( ({"liegegebuehr", "gebuehr", "hafengebuehren", "hafengebuehr",
               "liegegebuehren", "gebuehren"}), 
    "Die sind je nach Groesse des Schiffs und Dauer des Aufenthalts unterschiedlich." ,
	"sagt: ");
 AddInfo( ({"dauer"}), 
    "Manches mal dauert es laenger als man denkt." ,
	"sagt: ");
 AddInfo( ({"aufenthalt"}), 
    "Hier halten sich viele Schiffe auf." ,
	"sagt: ");
 AddInfo( ({"patent"}), 
    "Habt Ihr ein Patent? Dann koennt Ihr Euch ein Schiff kaufen." ,
	"sagt: ");
 AddInfo( ({"bedarf"}), 
    "Da kann ich Euch nicht weiterhelfen, wendet Euch an die Haendler." ,
	"sagt: ");
 AddInfo( ({"untiefe","untiefen"}), 
    "Untiefen sind der Feind jedes Schiffes." ,
	"sagt: ");
 AddInfo( ({"feind","feinde"}), 
    "Wer hat schon keine Feinde im Leben?" ,
	"sagt: ");
 AddInfo( ({"leben"}), 
    "Fuer manch einen ist das Leben das einzige, was er hat." ,
	"sagt: "); 
  AddInfo( ({""}), 
    "" ,
	"fragt: ");
  AddInfo( ({"fischwasser"}) , 
   "Fischwasser ist Wasser, das ein bisschen fischig schmeckt.", 
    "sagt: ");
  AddInfo( ({"wasser"}) , 
    "Wenn Ihr Wasser wollt, geht doch einfach nach draussen.", 
    "sagt: ");
  AddInfo( ({"moebel","moebelstuecke","tische","tisch","stuhl","stuehle"}) , 
    "Die werden hier dauernd demoliert.", 
  "sagt: ");
  AddInfo( ({"glaeser"}) , 
  "Ich haben nur noch wenige Glaeser, das meiste geht hier ja eh zu Bruch.", 
  "sagt: ");
  AddInfo( ({"bruch"}) , 
  "Hier geht viel zu Bruch.", 
  "sagt: ");
  AddInfo( ({"bursche"}) , 
  "Ja, der junge Bursche spielt hier ab und zu Klavier um etwas zu verdienen. "+
  "Aber ich glaube, ihm hoert kaum jemand zu.", 
  "sagt: ");
  AddInfo( ({"klavier"}) , 
  "Das Klavier steht schon ewig hier.", 
  "sagt: ");
  AddInfo( ({""}) , 
  "", 
  "sagt: ");
  AddInfo( ({""}) , 
  "", 
  "sagt: ");
  AddInfo( ({""}) , 
  "", 
  "sagt: ");
  AddInfo( ({""}), 
    "" ,
	"fragt: ");
  AddInfo( ({""}), 
    "" ,
	"fragt: ");
  AddInfo( ({""}), 
    "" ,
	"fragt: ");
  AddInfo( ({""}), 
    "" ,
	"fragt: ");

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "robbenpelzstiefel.lpc" );
  CLONEME( ARMOUR + "sturmjacke.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "enterhaken.lpc" );
  command("zuecke haken");
  
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lasst doch bitte den Blödsinn. \n"); 
      break; 
     case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }		
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes fuer sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
