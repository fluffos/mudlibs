#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({});
  create_default_npc(16); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"trolske", "sendason", "haendler", "Trolske Sendason", "trolske sendason" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Trolske Sendason, ein Haendler");
  SetProp( P_LONG, "Dies ist Trolske Sendason, ein Haendler. Neben seinem kurzen schwarzen Haar und den grossen braunen "+
    "Augen, faellt vorallem eine grosse Warze an seinem Kinn auf.");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Trolske Sendason");
  SetProp( P_WIMPY, 6); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM +"hafen_d2.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM +"hafen_d2.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Haendler"); //string für Todessequenz
 
  //Chats
  SetChats( 1, ({"Trolske Sendason sagt: Nur bei mir bekommt Ihr die groesste Auswahl. \n", 
  	             "Trolske Sendason sagt: Schaut Euch um, es gibt fuer jeden etwas. \n"}) ); //rate in %
  SetAttackChats( 5, ({"Trolske Sendason bruellt: Zu Hilfe, ein Moerder! \n",
  	                   "Trolske Sendason versucht zu fliehen! \n",
  	                   "Trolske Sendason versteckt sich hinter seinem Tresen. \n" }) ); // rate in%

 // AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({ "ebnan", "kaukalathis", "ebnan kaukalathis"}), 
  "Redet am besten gar nicht mit diesem unfreundlichen Gesellen. Er versucht mit seinen minderwertigen "+
  "Waren zu einem Schleuderpreis mein Geschaeft zu ruinieren. Aber da hat er sich geschnitten, in meinem "+
  "Geschaeft werden Kunden viel freundlicher behandelt. ","sagt: ");
  AddInfo( ({ "warze" }),
    "Also bitte, ich weiss dass ich eine Warze am Kinn habe. "
    "Ihr braucht mich nicht darauf hinweisen", "sagt veraergert: " );
  
  //Ausruestung
  SUID; 
  CLONEME("/p/armour/trousers/hose.lpc");
  CLONEME("/p/armour/boots/lederstiefel.lpc");
  CLONEME( ARMOUR+ "wollpullover.lpc" );

  command("trage alles");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }	
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


