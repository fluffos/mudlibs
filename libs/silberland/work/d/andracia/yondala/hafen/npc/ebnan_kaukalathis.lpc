#include <properties.h>
#include <combat.h>
#include <new_skills.h>
//#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({});
  create_default_npc(16); 

  //Properties
  AddId(({"ebnan", "kaukalathis", "haendler", "ebnan kaukalathis" })); 
  SetProp( P_SHORT, "Ebnan Kaukalathis, ein Haendler");
  SetProp( P_LONG, "Dies ist Ebnan Kaukalathis, ein Haendler. Er hat einen "
  "dunklen Teint und seine kleine Nase will einfach nicht zu seinem "
  "grossen Gesicht passen. ");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Ebnan Kaukalathis");
 SetProp( P_MNPC_AREA, ROOM +"hafen_e4.lpc" ); 
  SetProp( P_MNPC_DEFAULTROOM, ROOM +"hafen_e4.lpc"); 
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); 
  SetProp( P_KILL_NAME, "Haendler"); 
 
  //Chats
  SetChats( 1, ({"Ebnan Kaukalathis fragt: Wer moechte mit mir handeln? \n", 
  	             "Ebnan Kaukalathis sagt: Nur hier bekommt ihr gute Qualitaet! \n"}) ); //rate in %
  SetAttackChats( 5, ({"Ebnan Kaukalathis sagt: Sterbt! \n",
  	                   "Ebnan Kaukalathis sagt: Eure Knochen werden bald in der Sonne bleichen.",
  	                   "Ebnan Kaukalathis sagt: Ich mache Eurem nutzlosen Leben nun ein Ende! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"trolske", "sendason", "trolske sendason" }), 
     "Mit Trolske solltet Ihr lieber nicht handeln, der wird Euch mit "
	 "Sicherheit uebers Ohr hauen. Alles was ihr dort findet koennt ihr "
	 "auch bei mir finden, und ch achte auf die Qualitaet meiner Waren.", 
	 "sagt: ");
  AddInfo( ({"gesicht", "nase"}), 
  "Wollt Ihr Euch ueber mich lustig machen?" ,"fragt: ");
  AddInfo( ({"teint", "hautfrabe"}), 
    "Ich komme eigentlich aus einem Land weit im Sueden, daher meine "
    "etwas dunklere Hautfarbe." ,"sagt: ");
  AddInfo( ({"sueden"}), 
    "Im Sueden ist meine Heimat." ,"sagt: ");
  AddInfo( ({"heimat"}), 
    "Meine Heimat hab ich vor langer Zeit verlassen." ,"sagt: ");

  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME("/p/armour/armour/hemd.lpc");
  CLONEME("/p/armour/trousers/hose.lpc");
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME("/p/armour/belt/guertel.lpc");
  command("trage alles");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Bloedsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }		
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes fuer sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


