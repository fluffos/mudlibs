#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;

void reset()  {
  ::reset();
  aergerer=({}); 
}


string q_magiestein()
{
  object ob;
  int result;
  
	if( !TP->QueryQuest("Die besonderen Magiesteine") ) 
	if( ob=present("\nzzmagiesteinequest", TP) )
	{
		result=ob->QueryStone("blau");
		if( result == 0) 
		{
			ob->SetStone("blau", 1);
	    ob=clone_object("/gilden/zaubererzunft/obj/magiestein.lpc"); ob->set_farbsymbol("blau");
	    if( ob->move(TP, M_GET) < 0 ) ob->move(environment(TO), M_PUT); 
	    tell_room(environment(TO), TO->name()+" gibt "+TP->name()+ob->name(WEN,1)+"\n",({TP}));
	    tell_object(TP, TO->name()+" gibt Dir "+ob->name(WEN,1)+"\n");
			return "Hier habt ihr den blauen Magiestein fuer Zauberer Pralecred. Seid vorsichtig damit, verbraucht ihn nicht, denn "+
			  "ich kann euch keinen weiteren mehr geben.";
		}
		if( result==1 )
		  return "Ihr habt den blauen Magiestein fuer Zauberer Pralecred schon erhalten.";
 		if( result==2 )
		  return "Ihr benoetigt den blauen Magiestein fuer Zauberer Pralecred nicht mehr.";
  }
	return "Magiesteine beinhalten eine elementare Kraft. Diese Steine sind sehr wertvoll.";
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  aergerer=({});
  create_default_npc(16); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"yann", "okenheld", "yann okenheld", "Yann Okenheld", "seiler" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Yann Okenheld, der Seiler");
  SetProp( P_LONG, "Dies ist Yann Okenheld, der Seiler. Er ist etwas kuerzer geraten hat aber "+
    "trotzdem einen sehr kraeftigen Koerperbau. Seine groben Haende haben wohl schon so manches Seil geflochten.");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Yann Okenheld");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM + "hafen_f2.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "hafen_f2.lpc" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Seiler"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Yann Okenheld sagt: Euch werd ich den Garaus machen! \n",
  	                   "Yann Okenheld bruellt: Die Daemonen werden Euch holen! \n",
  	                   "Yann Okenheld sagt: Ihr werdet mich niemals bezwingen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"seile", "faeden", "faden", "netz", "netze"}), 
  "Ich hab leider keine Zeit fuer neue Auftraege. Tut mir leid.", "sagt: ");
  AddInfo( ({"seilerei"}), 
  "Dies ist meine Seilerei. ", "sagt: ");
//  AddInfo( ({"magiestein", "magiesteine", "blauen magiestein", "blauem magiestein"}), #'q_magiestein, "sagt: "); //#'
  AddInfo( ({"seil", "seile"}), "Ich bin leider mit Auftraegen fuer die Handelsflotte voll ausgelastet und kann Euch "+
  "keins der Seile hier verkaufen.", "sagt: ");
  AddInfo( ({"haende", "haenden"}), 
  "Seile zu flechten ist keine Arbeit fuer zarte Haende, wie Ihr an meinen sehen koennt. ", "sagt: ");

  //Ausruestung
  SUID;
 /* CLONEME( ruestungen + "stoffhose.lpc" );
  CLONEME( ruestungen + "leinenhemd.lpc" );
  CLONEME( ruestungen + "lederguertel_2.lpc" );
  command("trage alles");*/
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
     case "fies":
      {
	  if( member(aergerer, TP )==-1 )
        {
         aergerer+=({TP});
        call_out("reaction", 0, TP, 
          "droht: Wenn Ihr das nochmal macht, werd ich boese. \n", 
          "droht " + TP->name(WEM)+ ": Wenn Ihr das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
		  command("sag Nun reicht es mir!");
		  Attack(TP);
		  break;

        }
       }	
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
