#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit NPC + "hafenbewohner.lpc";

object *aergerer;


void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  aergerer=({}); 
  create_default_npc(18); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"xandro", "barchenter", "wirt", "xandro barchenter", "Xandro Barchenter" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Xandro Barchenter, der Wirt der Hafenkneipe");
  SetProp( P_LONG, "Dies ist Xandro Barchenter, der Wirt der Hafenkneipe. Er hat einen buschigen Bart und "+
    "einen kraeftigen Koerperbau. Er ist recht schmutzig und riecht nach altem Bier.");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Xandro Barchenter");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM +"hafen_d4.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM +"hafen_d4.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Wirt"); //string für Todessequenz
 
  //Chats
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"hafenkneipe", "kneipe", "pub"}),
  "Ihr befindet euch doch schon hier in meiner Kneipe. Bestellt doch einfach etwas.", "sagt: ");
  AddInfo( ({"aufgabe", "problem"}) , 
  "Tut mir leid - ich hab gerade keine Arbeit für Euch.", "sagt: ");
  AddInfo( ({"bart"}) , 
  "Ich hab einfach keine Zeit zum rasieren, deswegen hab ich mir den Bart wachsen lassen.", "sagt: ");
  AddInfo( ({"bier"}) , 
  "Jeder bekommt bei mir Bier, sofern ihr mir die paar Muenzen auch abdruecken koennt. ", "sagt: ");

  //Ausruestung
 SUID; 
 CLONEME("/p/armour/trousers/hose.lpc");
 CLONEME("/p/armour/boots/lederstiefel.lpc");
 CLONEME("/p/armour/armour/hemd.lpc");
 CLONEME("/p/armour/cloak/schuerze.lpc");
 command("trage alles");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + TPN + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + TPN + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + TPN + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      {
      call_out("reaction", 0, TP, 
        "tritt Dich.\n", 
        "tritt " + TP->name(WEN) + ".\n"); 
		TP->do_damage(10);
		break;
       }	
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + TPN + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + TPN + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + TPN + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + TPN + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
