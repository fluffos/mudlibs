inherit "std/transport";

#include "../def.h"
#include <properties.h>
#include <moving.h>
#include <language.h>

#define PIRATENINSEL "/d/andracia/yondala/wasser/pirateninsel/room/pirateninsel_steg"

int weather;
// 0 = sehr ruhige See
// 1 = leichte Brise
// 2 = gutes Segelwetter
// 3 = starke Winde
// 4 = stuermische See

void reset()
{
  if( weather > random(4)+1 ) weather++; else weather--;
  if( sizeof(QueryPassengers()) == 0 ) 
  {	
    RemoveRoute();
    call_out("neue_route", 1, weather); 
  }
  ::reset();
}

int neue_route(int wetterlage)
{
  notify_fail("Irgendwas laeuft falsch");// Route sezten hat nicht geklappt!
  if( sizeof(QueryPassengers()) != 0 ) {call_out("neue_route", 10, weather);return 1;}
  // if( QueryArrived() != 0 ) return 0;
  
  // RemoveRoute();
  
  AddRoute( ROOM + "hafen_c3", 35, 12, "Hafen vom Festland", 
            ({ "hafen", "festland" }), "zum Festland" );
  AddMsg( "Das Handelsschiff segelt in Richtung Pirateninsel.\n", 5+(5-weather)*3 );

  switch(wetterlage) {
  case 0:
    AddMsg( "Das Handelsschiff duempelt langsam vor sich hin.\n", 15 );
    AddMsg( "Die flauen Winde lassen nur sehr kleine Wellen entstehen.\n", 15 );
    AddMsg( "Die Segel blaehen sich nur unvollstaendig.\n", 15 );
    AddMsg( "Das Handelsschiff scheint nicht vom Fleck zu kommen.\n", 15 );
    AddMsg( "Die traege Mannschaft hofft auf bessere Winde.\n", 15 );
    AddMsg( "Das Handelsschiff duempelt fast auf der Stelle.\n", 15 );
    break;
  case 1:
    AddMsg( "Das Handelsschiff macht leichte Fahrt.\n", 15 );
    AddMsg( "Kleine Wellen schlagen gegen die Bordwand.\n", 15 );
    AddMsg( "Alle Segel sind gesetzt um jedes bischen Wind auszunutzen.\n", 15 );
    AddMsg( "Das Handelsschiff macht langsame Fahrt.\n", 15 );
    break;
  case 2:
    AddMsg( BS("Das Handelsschiff hat gute Fahrt und durchschneidet "+
      "in gerader Linie das Wasser. Eine angenehme Reise."), 15 );
    AddMsg( "Das Handelsschiff macht gute Fahrt mit geblaehten Segeln.\n", 15 );
    AddMsg( "Die Mannschaft glaubt an eine Ueberfahrt in Rekordzeit.\n", 15 );
    break;
  case 3:
    AddMsg( "Das Handelsschiff kaempft sich durch die hohen Wellen.\n", 15 );
    AddMsg( "Das Schiff schaukelt schwer und die Segel sind gespannt.\n", 15 );
    AddMsg( "Den hohen Wellen entlang hebt und senkt sich das Schiff.\n", 10 );
    AddFun( "seekrank", 5);
    AddMsg( "Das Handelsschiff kaempft sich durch die schweren Seegang.\n", 15 );
    break;
  case 4:
    AddMsg( BS("Das Handelsschiff wird von den grossen Wellen des Sturms "+
    "hin und her geworfen. Die Mannschaft versucht alles damit das Schiff "+
    "nicht kentert."), 15 );
    AddMsg( "Das Handelsschiff kaempft sich durch den Sturm.\n", 15 );
    AddMsg( "Die Segel drohen zu zerreissen bei diesem Wind. \n", 15 );
    AddMsg( "Der Sturm laesst nicht nach.\n", 15 );
    AddMsg( BS("Das Handelsschiff ist ein Spielzeug des Sturms und wird "+
    "hin und her geworfen. "), 15 );
    break;
  }
  
  AddMsg( "Das Handelsschiff naehert sich der Pirateninsel.\n", 6+weather );
  AddRoute( PIRATENINSEL, 35, 12, "Pirateninsel", 
            ({ "insel", "pirateninsel", "piraten" }), "zur Pirateninsel" );
  AddMsg( "Das Handelsschiff segelt in Richtung Festland.\n", 5+(5-weather)*3 );
  
  switch(wetterlage) {
  case 0:
    AddMsg( "Das Handelsschiff duempelt langsam vor sich hin.\n", 15 );
    AddMsg( "Die flauen Winde lassen nur sehr kleine Wellen entstehen.\n", 15 );
    AddMsg( "Die Segel blaehen sich nur unvollstaendig.\n", 15 );
    AddMsg( "Das Handelsschiff scheint nicht vom Fleck zu kommen.\n", 15 );
    AddMsg( "Die traege Mannschaft hofft auf bessere Winde.\n", 15 );
    AddMsg( "Das Handelsschiff duempelt fast auf der Stelle.\n", 15 );
    break;
  case 1:
    AddMsg( "Das Handelsschiff macht leichte Fahrt.\n", 15 );
    AddMsg( "Kleine Wellen schlagen gegen die Bordwand.\n", 15 );
    AddMsg( "Alle Segel sind gesetzt um jedes bischen Wind auszunutzen.\n", 15 );
    AddMsg( "Das Handelsschiff macht langsame Fahrt.\n", 15 );
    break;
  case 2:
    AddMsg( BS("Das Handelsschiff hat gute Fahrt und durchschneidet "+
      "in gerader Linie das Wasser. Eine angenehme Reise."), 15 );
    AddMsg( "Das Handelsschiff macht gute Fahrt mit geblaehten Segeln.\n", 15 );
    AddMsg( "Die Mannschaft glaubt an eine Ueberfahrt in Rekordzeit.\n", 15 );
    break;
  case 3:
    AddMsg( "Das Handelsschiff kaempft sich durch die hohen Wellen.\n", 15 );
    AddMsg( "Das Schiff schaukelt schwer und die Segel sind gespannt.\n", 15 );
    AddMsg( "Den hohen Wellen entlang hebt und senkt sich das Schiff.\n", 10 );
    AddFun( "seekrank", 5);
    AddMsg( "Das Handelsschiff kaempft sich durch die schweren Seegang.\n", 15 );
    break;
  case 4:
    AddMsg( BS("Das Handelsschiff wird von den grossen Wellen des Sturms "+
    "hin und her geworfen. Die Mannschaft versucht alles damit das Schiff "+
    "nicht kentert."), 15 );
    AddMsg( "Das Handelsschiff kaempft sich durch den Sturm.\n", 15 );
    AddMsg( "Die Segel drohen zu zerreissen bei diesem Wind. \n", 15 );
    AddMsg( "Der Sturm laesst nicht nach.\n", 15 );
    AddMsg( BS("Das Handelsschiff ist ein Spielzeug des Sturms und wird"+
    "hin und her geworfen. "), 15 );
    break;
  }
  
  AddMsg( "Das Handelsschiff naehert sich dem Hafen vom Festland.\n", 6+weather );

  Start();
  return 1;
}

void create() 
{
//	if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Handelsschiff" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf einem Handelsschiff der Handelsflotte von Semkin Baerensen.") );
  SetProp( P_SHORT, "Ein Handelsschiff" );
  SetProp( P_LONG, BS(
    "Du siehst ein Handelsschiff der Handelsflotte von Semkin Baerensen.") );
  SetProp( P_NAME, "Handelsschiff" );
  AddId( ({ "handelsschiff", "schiff" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail( ({"handelsschiff", "schiff"}) , BS(
    "Du stehst auf einem Handelsschiff der Handelsflotte von Semkin Baerensen. ") );
  AddSpecialDetail( ({"wetter", "wetterlage"}), "get_weather");
  
  
  SetProp( P_DEPARTMSG, ({
    "Das Handelsschiff legt ab.\n", 
    "Das Handelsschiff legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Das Handelsschiff legt im Hafen von @@QueryArrived@@ an.\n",
    "Das Handelsschiff legt im Hafen an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt das Handelsschiff",
    "kommt auf das Handelsschiff"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere auf das Handelsschiff",
    "hat keinen Platz mehr auf dem Handelsschiff"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaest das Handelsschiff",
    "kommt vom Handelsschiff herunter"}) );
  SetProp( P_LEAVEFAIL, ({
    "Das Handelsschiff befindet sich doch auf hoher See",
    "wollte das Handelsschiff auf hoher See verlassen"}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt", "besteige", "besteig", "enter" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  weather = random(5);
  neue_route(weather);

}

void seekrank()
{
  object *passagiere, opfer;

  if (random(3)) return;

  passagiere = QueryPassengers();
  if (sizeof(passagiere))
  {
    opfer = passagiere[random(sizeof(passagiere))];
    tell_object(opfer, BS(
      "Du wirst seekrank! Schnell stuerzt Du zur Reling um Dich zu uebergeben."));
    tell_room(this_object(), BS(
      sprintf("%s ueberkommt die Seekrankheit! %s stuerzt an die Reling, "
                +"um sich zu uebergeben.",
                 capitalize(opfer->name(WEN)),
                 capitalize(opfer->QueryPronoun(WER)) ) ), ({ opfer }) );
  }
}

string get_weather(string str)
{
  switch(weather) {
  case 0:
    return "Nur wenig Wind regt sich. \n";
  case 1:
    return "Eine leichte Brise herrscht.. \n";
  case 2:
    return "Ein angenehmer Wind laesst die Segel sich aufblaehen. \n";
  case 3:
    return "Der starke Wind zerrt an den Segeln. \n";
  case 4:
    return BS("Die aufgewuehlte See und die straken Winde machen das Segeln zu einem Risiko. ");
  }
}

int rein(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( ROOM+"hafen_c3.lpc", "???"));
    catch(call_other( PIRATENINSEL, "???"));
  }
}