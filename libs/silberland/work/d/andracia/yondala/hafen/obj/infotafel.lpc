#include "../def.h"
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Informationstafel");
  SetProp(P_LONG,
    "Eine grosse, hoelzerne Tafel mit allerlei Informationen zum Schiffsverkehr. Du kannst es bestimmt lesen. " );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Informationstafel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tafel", "infotafel", "hinweistafel", "informationstafel"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );

  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.");
  AddDetail( ({"tafel", "hinweistafel", "infotafel", "informationstafel" }),
    BS("Ein einfache Informationstafel mit vielen Informationen zum Schiffsverkehtr. Versuch es doch mal mit lesen. "));
  AddDetail( ({ "informationen", "infos" }),
    BS("Auf der Informationstafel stehen die Zielhafen der hier verkehrenden Schiffe. Lesen mach hier Sinn."));
  AddDetail( ({ "sinn" }),
    BS("Es macht Sinn eine Informationstafel zu lesen."));
  AddReadDetail( ({"tafel", "hinweistafel", "infotafel", "informationstafel" }),
    " +---------------------------------------+ \n"+
    " + Schiffsverkehr:                       + \n"+
    " + Das Handelsschiff pendelt von hier    + \n"+
    " + zur Pirateninsel.                     + \n"+
    " +                                       + \n"+
    " + Die Karavelle faehrt die Pirateninsel + \n"+
    " + und die Insel der Canniba an          + \n"+
    " +---------------------------------------+ \n" );
}
