#define CHRISTOBAL "d/wasser/yondala/pirateninsel/npc/christobal"



int weather;
// 0 = sehr ruhige See
// 1 = leichte Brise
// 2 = gutes Segelwetter
// 3 = starke Winde
// 4 = stuermische See

void reset()
{
  if( weather > random(4)+1 ) weather++; else weather--;
  if( sizeof(QueryPassengers()) == 0 ) 
  {	
 	  RemoveRoute();
    TY("Karavelle: Ich versuche nun eine neue Wetterlage zu erzeugen.\n");
    call_out("neue_route", 1, weather); 
  }
  ::reset();  
}

string get_segel(string str)
{
  switch(weather) {
  case 0:
    return "Das weisse Segel haengt schlaff vom Quermast. \n";
  case 1:
    return "Ein leichter Wind laesst das weisse Segel flattern. \n";
  case 2:
    return "Ein angenehmer Wind laesst die Segel sich aufblaehen. \n";
  case 3:
    return "Der starke Wind zerrt kraeftig an den Segeln. \n";
  case 4:
    return "Das Segel ist so sehr gespannt dass man fuerchten muss dass es reisst. \n";
  }
}
string get_weather(string str)
{
  switch(weather) {
  case 0:
    return "Nur wenig Wind regt sich. \n";
  case 1:
    return "Eine leichte Brise herrscht. \n";
  case 2:
    return "Ein angenehmer Wind laesst das Segel sich aufblaehen. \n";
  case 3:
    return "Der starke Wind zerrt an den Segeln. \n";
  case 4:
    return "Die aufgewuehlte See und die straken Winde machen das Segeln zu einem Risiko. \n";
  }
}
string get_water(string str)
{
  switch(weather) {
  case 0:
    return "Die fast ebene See krauselt sich nur traege am Schiffsrumpf. \n";
  case 1:
    return "Kleine Wellen schlagen sanft gegen die Bordwand. \n";
  case 2:
    return "Die Wellen lassen das Schiff leicht schaukeln. \n";
  case 3:
    return "Immer wieder spritzt etwas Gischt von den hohen Wellen ueber die Reling. \n";
  case 4:
    return "Der Sturm treibt hin und wieder ganze Wellen ueber das Deck. \n";
  }
}
int neue_route(int wetterlage)
{
  notify_fail("Irgendwas laeuft falsch");// Route sezten hat nicht geklappt!
  if( sizeof(QueryPassengers()) != 0 ) 
  {
  	TY("Karavelle: Es ist jemand an Bord - ich versuchs gleich nochmal.\n");
  	call_out("neue_route", 10, weather);
  	return 1;
  }
  // if( QueryArrived() != 0 ) return 0;
  
  
  AddRoute( HAFEN_1, 35, 12, "Hafen von Andracia", 
            ({ "hafen", "festland" }), "zum Festland" );
  AddMsg( "Die Karavelle segelt in Richtung Pirateninsel.\n", 5+(5-weather)*3 );

  switch(wetterlage) {
  case 0:
    AddMsg( "Die Karavelle duempelt langsam vor sich hin.\n", 15 );
    AddMsg( "Die flauen Winde lassen nur sehr kleine Wellen entstehen.\n", 15 );
    AddMsg( "Die Segel blaehen sich nur unvollstaendig.\n", 15 );
    AddMsg( "Die Karavelle scheint nicht vom Fleck zu kommen.\n", 15 );
    AddMsg( "Die traege Mannschaft hofft auf bessere Winde.\n", 15 );
    AddMsg( "Die Karavelle duempelt fast auf der Stelle.\n", 15 );
    break;
  case 1:
    AddMsg( "Die Karavelle macht leichte Fahrt.\n", 15 );
    AddMsg( "Kleine Wellen schlagen gegen die Bordwand.\n", 15 );
    AddMsg( "Alle Segel sind gesetzt um jedes bischen Wind auszunutzen.\n", 15 );
    AddMsg( "Die Karavelle macht langsame Fahrt.\n", 15 );
    break;
  case 2:
    AddMsg( BS("Die Karavelle hat gute Fahrt und durchschneidet "+
      "in gerader Linie das Wasser. Eine angenehme Reise."), 15 );
    AddMsg( "Die Karavelle macht gute Fahrt mit geblaehten Segeln.\n", 15 );
    AddMsg( "Die Mannschaft glaubt an eine Ueberfahrt in Rekordzeit.\n", 15 );
    break;
  case 3:
    AddMsg( "Die Karavelle kaempft sich durch die hohen Wellen.\n", 15 );
    AddMsg( "Das Schiff schaukelt schwer und die Segel sind gespannt.\n", 15 );
    AddMsg( "Den hohen Wellen entlang hebt und senkt sich das Schiff.\n", 10 );
    AddFun( "seekrank", 5);
    AddMsg( "Die Karavelle kaempft sich durch die schweren Seegang.\n", 15 );
    break;
  case 4:
    AddMsg( BS("Die Karavelle wird von den grossen Wellen des Sturms "+
    "hin und her geworfen. Die Mannschaft versucht alles damit das Schiff "+
    "nicht kentert."), 15 );
    AddMsg( "Die Karavelle kaempft sich durch den Sturm.\n", 15 );
    AddMsg( "Die Segel drohen zu zerreissen bei diesem Wind. \n", 15 );
    AddMsg( "Der Sturm laesst nicht nach.\n", 15 );
    AddMsg( BS("Die Karavelle ist ein Spielzeug des Sturms und wird "+
    "hin und her geworfen. "), 15 );
    break;
  }
  
  AddMsg( "Die Karavelle naehert sich der Pirateninsel.\n", 6+weather );
  AddRoute( HAFEN_2, 35, 12, "Pirateninsel", 
            ({ "pirateninsel", "insel", "piraten" }), "zur Pirateninsel" );
  AddMsg( "Die Karavelle segelt nun in Richtung Kanibaleninsel.\n", 5+(5-weather)*3 );
  
  switch(wetterlage) {
  case 0:
    AddMsg( "Die Karavelle duempelt langsam vor sich hin.\n", 15 );
    AddMsg( "Die flauen Winde lassen nur sehr kleine Wellen entstehen.\n", 15 );
    AddMsg( "Die Segel blaehen sich nur unvollstaendig.\n", 15 );
    AddMsg( "Die Karavelle scheint nicht vom Fleck zu kommen.\n", 15 );
    AddMsg( "Die traege Mannschaft hofft auf bessere Winde.\n", 15 );
    AddMsg( "Die Karavelle duempelt fast auf der Stelle.\n", 15 );
    break;
  case 1:
    AddMsg( "Die Karavelle macht leichte Fahrt.\n", 15 );
    AddMsg( "Kleine Wellen schlagen gegen die Bordwand.\n", 15 );
    AddMsg( "Alle Segel sind gesetzt um jedes bischen Wind auszunutzen.\n", 15 );
    AddMsg( "Die Karavelle macht langsame Fahrt.\n", 15 );
    break;
  case 2:
    AddMsg( BS("Die Karavelle hat gute Fahrt und durchschneidet "+
      "in gerader Linie das Wasser. Eine angenehme Reise."), 15 );
    AddMsg( "Die Karavelle macht gute Fahrt mit geblaehten Segeln.\n", 15 );
    AddMsg( "Die Mannschaft glaubt an eine Ueberfahrt in Rekordzeit.\n", 15 );
    break;
  case 3:
    AddMsg( "Die Karavelle kaempft sich durch die hohen Wellen.\n", 15 );
    AddMsg( "Das Schiff schaukelt schwer und die Segel sind gespannt.\n", 15 );
    AddMsg( "Den hohen Wellen entlang hebt und senkt sich das Schiff.\n", 10 );
    AddFun( "seekrank", 5);
    AddMsg( "Die Karavelle kaempft sich durch die schweren Seegang.\n", 15 );
    break;
  case 4:
    AddMsg( BS("Die Karavelle wird von den grossen Wellen des Sturms "+
    "hin und her geworfen. Die Mannschaft versucht alles damit das Schiff "+
    "nicht kentert."), 15 );
    AddMsg( "Die Karavelle kaempft sich durch den Sturm.\n", 15 );
    AddMsg( "Die Segel drohen zu zerreissen bei diesem Wind. \n", 15 );
    AddMsg( "Der Sturm laesst nicht nach.\n", 15 );
    AddMsg( BS("Die Karavelle ist ein Spielzeug des Sturms und wird "+
    "hin und her geworfen. "), 15 );
    break;
  }
  AddMsg( "Die Karavelle naehert sich der Canibainsel.\n", 6+weather );
  AddRoute( HAFEN_3, 35, 12, "Canibainsel", 
            ({ "canibainsel", "caniba" }), "zur Canibainsel" );
  AddMsg( "Die Karavelle segelt in Richtung Festland.\n", 5+(5-weather)*3 );
  
  switch(wetterlage) {
  case 0:
    AddMsg( "Die Karavelle duempelt langsam vor sich hin.\n", 15 );
    AddMsg( "Die flauen Winde lassen nur sehr kleine Wellen entstehen.\n", 15 );
    AddMsg( "Die Segel blaehen sich nur unvollstaendig.\n", 15 );
    AddMsg( "Die Karavelle scheint nicht vom Fleck zu kommen.\n", 15 );
    AddMsg( "Die traege Mannschaft hofft auf bessere Winde.\n", 15 );
    AddMsg( "Die Karavelle duempelt fast auf der Stelle.\n", 15 );
    break;
  case 1:
    AddMsg( "Die Karavelle macht leichte Fahrt.\n", 15 );
    AddMsg( "Kleine Wellen schlagen gegen die Bordwand.\n", 15 );
    AddMsg( "Alle Segel sind gesetzt um jedes bischen Wind auszunutzen.\n", 15 );
    AddMsg( "Die Karavelle macht langsame Fahrt.\n", 15 );
    break;
  case 2:
    AddMsg( BS("Die Karavelle hat gute Fahrt und durchschneidet "+
      "in gerader Linie das Wasser. Eine angenehme Reise."), 15 );
    AddMsg( "Die Karavelle macht gute Fahrt mit geblaehten Segeln.\n", 15 );
    AddMsg( "Die Mannschaft glaubt an eine Ueberfahrt in Rekordzeit.\n", 15 );
    break;
  case 3:
    AddMsg( "Die Karavelle kaempft sich durch die hohen Wellen.\n", 15 );
    AddMsg( "Das Schiff schaukelt schwer und die Segel sind gespannt.\n", 15 );
    AddMsg( "Den hohen Wellen entlang hebt und senkt sich das Schiff.\n", 10 );
    AddFun( "seekrank", 5);
    AddMsg( "Die Karavelle kaempft sich durch die schweren Seegang.\n", 15 );
    break;
  case 4:
    AddMsg( BS("Die Karavelle wird von den grossen Wellen des Sturms "+
    "hin und her geworfen. Die Mannschaft versucht alles damit das Schiff "+
    "nicht kentert."), 15 );
    AddMsg( "Die Karavelle kaempft sich durch den Sturm.\n", 15 );
    AddMsg( "Die Segel drohen zu zerreissen bei diesem Wind. \n", 15 );
    AddMsg( "Der Sturm laesst nicht nach.\n", 15 );
    AddMsg( BS("Die Karavelle ist ein Spielzeug des Sturms und wird"+
    "hin und her geworfen. "), 15 );
    break;
  }
  
  AddMsg( "Die Karavelle naehert sich dem Hafen vom Festland.\n", 6+weather );

  Start();
  TY("Karavelle: Alles Okay und wieder losfahren.\n");
  return 1;
}

void create() 
{
 // if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "Die Karavelle Santa Marion" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich an Bord der beruehmten Karavelle Santa Marion. Mit diesem bekannten Schiff "+
    "bereist Christobal die Meere auf der Suche nach neuen Inseln und unbekannten Laendern.") );
  SetProp( P_SHORT, "Die Karavelle Santa Marion" );
  SetProp( P_LONG, BS(
    "Diese Karavelle ist beruehmt.") );
  SetProp( P_NAME, "Karavelle Santa Marion" );
  AddId( ({ "karavelle", "schiff", "santa", "marion", "santa marion" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ARTICLE, 0 );

  AddDetail( ({"karavelle", "schiff", "santa marion", "marion", "santa"}),
    BS("Dieses hochseetuechtige Schiff besteht aus einem breiten Deck, auf dem Du stehst. "+
    "An Backbord und Steuerbord ist eine hoelzerne Reeling angebracht. Achtern des Schiffs "+
    "wurde ein kleines Kastell erbaut. Eine hoelterne Frauenfigur dient als Gallionsfigur am Bug. "+
    "Ein grosses, breites Segel wurde am Mast gehisst. ") );
  AddDetail( ({"backbord", "steuerbord", "bord", "seiten"}),
    BS("An beiden Seiten des Schiffs wurde eine hoelzerne Reeling angebracht. Dadurch kann man auch bei "+
    "rauher See nicht sofort ueber Bord gespuelt werden.") );
  AddDetail( ({"deck", "planken", "boden"}),
    BS("Hoelzerne Planken bilden den Boden des Decks. ") );
  AddDetail( ({"kastell", "aufbau", "aufbauten", "kapitaenskajuete" }),
    BS("Ein Kastell nimmt den gesamten hinteren Bereich des Schiffs ein. Du nimmst an dass Christobal "+
    "dort seine Kapitaenskajuete hat.") );
  AddDetail( ({"frauenfigur", "gallionsfigur", "figur", "frau", "darstellung"}),
    BS("Die Gallionsfigur am Bug ist eine geschnitzte Frau, allerdings stellt die Figur nur den Oberkoerper "+
    "einer Frau dar. Das Mieder der Figur ist prall gefuellt und eine goldene Blume steckt in ihrem Haarschopf." ) );
  AddDetail( ({"bug"}),
    BS("Am Bug des Schiffs wurde eine Gallionsfigur angebracht.") );
  AddDetail( ({"segel"}),
    #'get_segel ); //#'
  AddDetail( ({"mast"}),
    BS("Ein grosser Mast haelt das Segel. Ein gewaltiger Baum musste wohl hierzu gefaellt werden.") );
  AddDetail( ({"land", "laender", "insel", "inseln", "reise", "suche"}),
    BS("Wohin die Reise wohl gehen mag?") );
  AddDetail( ({"reeling"}),
    BS("Die Reeling zu beiden Seiten des Schiffs verhindert dass Passagiere und Ladung von Bord gespuelt werden.") );
  AddDetail( ({"holz", "holzsorte", "baum"}),
    BS("Das ganze Schiff wurde aus Holz gemacht. Du kannst leider nicht erkennen welche Holzsorte es ist.") );
  AddDetail( ({"mieder", "blume", "haarschopf", "oberkoerper", }),
    BS("Du bewunderst die detailgetreue Darstellung der Gallionsfigur aber kannst nichts besonderes mehr daran entdecken. ") );
  AddDetail( ({"wellen", "seegang", "wasser", "meer", "see"}),
    #'get_water ); //#'
  AddDetail( ({"wetter", "wetterlage", "himmel"}),
    #'get_weather ); //#'
  AddDetail( ({"ladung"}),
    BS("Hier an Deck wurde keine Ladung verstaut.") );
  AddDetail( ({"passagier", "passagiere"}),
    BS("Du selbst bist auch ein Passagier. Schau dich einfach um ob Du sonst noch jemanden siehst.") );
/*
  AddDetail( ({""}),
    BS("") );
*/
  SetProp( P_DEPARTMSG, ({
    "Die Karavelle legt ab.\n", 
    "Die Karavelle legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Die Karavelle legt an.\n",
    "Die Karavelle legt an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "betritt die Karavelle",
    "betritt die Karavelle"}) );
  SetProp( P_ENTERFAIL, ({
    "die Karavelle kann nur bis zu 8 Passagiere mitnehmen.",
    "die Karavelle ist schon voll"}) );
  SetProp( P_MAX_PASSENGERS, 8 );

  SetProp( P_LEAVEMSG, ({
    "verlaesst die Karavelle",
    "verlaesst die Karavelle"}) );
  SetProp( P_LEAVEFAIL, ({
    "Die Karavelle befindet sich gerade auf hoher See.",
    "schaut sehnsuechtig uebers Meer."}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt", "besteige", "besteig", "enter" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  weather = random(5);
  neue_route(weather);

  // AddItem( CHRISTOBAL, REFRESH_DESTRUCT );
}

void seekrank()
{
  object *passagiere, opfer;

  if (random(3)) return;

  passagiere = QueryPassengers();
  if (sizeof(passagiere))
  {
    opfer = passagiere[random(sizeof(passagiere))];
    tell_object(opfer, BS(
      "Du wirst seekrank! Schnell stuerzt Du zur Reling um Dich zu uebergeben."));
    tell_room(this_object(), BS(
      sprintf("%s ueberkommt die Seekrankheit! %s stuerzt an die Reling, "
                +"um sich zu uebergeben.",
                 capitalize(opfer->name(WEN)),
                 capitalize(opfer->QueryPronoun(WER)) ) ), ({ opfer }) );
  }
}

int rein(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( HAFEN_1, "???"));
    catch(call_other( HAFEN_2, "???"));
    catch(call_other( HAFEN_3, "???"));
  }
}
