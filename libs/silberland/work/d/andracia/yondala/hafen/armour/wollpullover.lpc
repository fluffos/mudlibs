//ACHTUNG: Veraendert den Temperaturschutz!

// Yondala@Silberland 10.06.2010


#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Wollpullover");
  SetProp(P_LONG,
    "Ein kratzender, verfilzter Pullover, der aber sicher schoen warm "
	"haelt." );
  SetProp(P_NAME, "Wollpullover");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"pullover", "wollpullover" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:7, T_HEAT_PROT:-7 ]) );

}


