#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Sturmjacke");
  SetProp(P_LONG,
    "Eine schwere Sturmjacke aus Leder, mit Robbenpelz gefuettert. Sie "
	"haelt schoen warm und schuetzt vor jedem Wetter." );
  SetProp(P_NAME, "Sturmjacke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"jacke", "sturmjacke"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 17 );
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 1260);
  SetProp(P_QUALITY_DECAY, 100);

  AddProp(P_DAM_PROTECTION, ([DT_WATER:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:8 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );
}
