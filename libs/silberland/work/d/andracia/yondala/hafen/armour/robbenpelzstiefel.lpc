#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Robbenpelzstiefel");
  SetProp(P_LONG,
    "Dicke Stiefel aus gutem Robbenpelz. Haelt die Fuesse warm und trocken." );
  SetProp(P_NAME, "Robbenpelzstiefel");
  SetProp(P_GENDER, MALE);
  SetProp (P_PLURAL, 1);
  AddId( ({"stiefel", "pelzstiefel", "robbenpelzstiefel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 6 );
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 750);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-2]));
  AddProp(P_DAM_PROTECTION, ([DT_WATER:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:8 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );
}
