#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hafenschmiede" );
  SetProp( P_INT_LONG,
     "Dies ist die Hafenschmiede. Ein Amboss steht nahe der Feuerstelle und ein "+
     "Fass mit Wasser gleich daneben. An der Wand haengen, Metalloesen und andere "+
     "Dinge die man auf Schiffen braucht. Eisen in allen Formen liegt auf einem "+
     "Tisch fuer die Arbeiten des Schmieds bereit. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Das prasseln des Feuers erfuellt den Raum. ");
  AddSound( ({ "feuer", "prasseln" }),
    "Das Feuer macht nunmal dieses Prasseln.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Russ, Asche und heissem Eisen. ");
  AddSmell( ({ "russ", "asche", "rauch" }),
    "Beissender Rauch haengt in der Luft.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus Stein. Russ und Asche haben den Boden schwarz gefaerbt. ");
  AddDetail( ({ "decke" }),
    "Die Decke ist aus Holz. Einzig unterbrochen durch den Rauchabzug ueber der "+
    "Feuerstelle. ");
  AddDetail( ({ "waende", "wand" }),
    "Die verputzten Waende halten die Hitze der Feuerstelle im Raum. Es ist "+
    "hier um einiges waermer als in den anderen Haeusern. Metalloesen und andere "+
    "Dinge, die man auf Schiffen braucht, haengen hier. ");
  AddDetail( ({ "schmiede", "raum", "haus", "hafenschmiede", "haeusern" }),
    "Hier kannst Du beim Schmied Deine Ausruestung reparieren lassen. ");
  AddDetail( ({ "stein" }),
    "Der steinerne boden ist schwarz von Asche und Russ.");
  AddDetail( ({ "russ", "asche", "rauch", "luft" }),
    "Die Feuerstelle scheint nur ungenuegend vom Rauchabzug ueberdeckt zu "+
    "sein. Die Luft ist von Rauch erfuellt. ");
  AddDetail( ({ "holz" }),
    "Die Decke besteht aus Holz. ");
  AddDetail( ({ "rauchabzug", "kamin" }),
    "Ueber der Feuerstelle soll dieser Kamin dafuer sorgen, dass Rauch und Asche "+
    "nach oben das Haus verlassen.");
  AddDetail( ({ "feuerstelle", "feuer", "hitze" }),
    "Hitze strahlt vom Feuer und erwaermt den Raum. Rauchschwaden haengen in "+
    "der Luft. ");
  AddDetail( ({ "eisen", "formen", "eisenteile" }),
    "Das Eisen benoetigt der Schmied fuer seine Arbeit. ");
  AddDetail( ({ "amboss" }),
    "Darauf bearbeitet der Schmied das Eisen. ");
  AddDetail( ({ "fass", "wasser" }),
    "Das Fass mit Wasser dient zum Abschrecken des heissen Eisen. ");
  AddDetail( ({"abschrecken"}),
    "Um heisses eisen ab zu schrecken taucht man es in Wasser.");


  AddDetail( ({ "metalloesen", "oesen", "haken" }),
    "Fuer die Seile und Segel der Schiffe benoetigt man viele verschiedene "+
    "Oesen und andere metallene Dinge. ");
  AddDetail( ({ "tisch" }),
    "Auf dem Tisch liegen rohe Eisenteile fuer den Schmied bereit. ");
  AddDetail( ({ "seile", "seilerei" }),
    "In der Seilerei kannst Du mehr darueber erfahren. ");
  AddDetail( ({ "segel", "tuchmacherei" }),
    "In der Tuchmacherei kannst Du mehr darueber erfahren. ");
  AddDetail( ({"arbeit", "arbeiten", "meister", "schmied", "schmieds", "meisterschmied"}),
    "Der Schmied scheint ein Meister zu sein und hier hervorragende Arbeit zu leisten.");
  AddDetail( ({"ausruestung"}),
    "Ob du dich optimal ausgeruestet hast?");
  AddDetail( ({"dinge"}),
    "Dinge wie Oesen, Haken und andere Eisenteile haengen an der Wand.");
  AddDetail( ({"schiffe", "schiffen"}),
    "Schiffe findet man eher im Hafenbecken als hier.");
  AddDetail( ({"hafenbecken"}),
    "Du bist aber gar nicht am Hafenbecken!");

/*
  AddDetail( ({""}),
    "");
*/

  /* Exits */
  AddExit( "norden" , ROOM + "hafen_f3.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "kedio_horger.lpc", REFRESH_DESTRUCT );

}

