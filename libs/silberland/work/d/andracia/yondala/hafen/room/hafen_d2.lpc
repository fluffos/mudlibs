inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Handelshaus von Trolske Sendason " );
  SetProp( P_INT_LONG,
     "Dies ist das Handelshaus von Trolske Sendason. Viele verschiedene Dinge kann "+
     "man hier erstehen. Vorallem aber kann man Sachen kaufen, die man zum "+
     "Fischen benoetigt. Wichtige Ausruestungen, die auf keinem Schiff fehlen "+
     "duerfen, gehoeren zum Sortiment.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "Trolske Sendason");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( ROOM+"hafen_storage_d2.lpc");


  AddSound( ({ "schritt", "schritte" }),
    "Deine Schritte klingen etwas hohl, als wenn unter dem duennen Boden "+
    "ein Keller waere. ");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach trockenen Netzen und Staub.");
  AddSmell( ({ "netze", "netzen", "staub" }),
    "Trocken und staubig riecht es hier.");

  AddDetail( ({ "boden" }),
    "Dicke Holzbohlen bilden den Boden. Jeder Schritt kling hohl, "+
    "warscheinlich ist unterhalb dieses Raumes ein Keller. ");
  AddDetail( ({ "decke" }),
    "An der hoelzernen Decke wurden Netze und Reusen aufgehaengt. "+
    "Netze mit groben bis sehr feinen Maschen kann man sehen. ");

  AddDetail( ({ "waende", "wand" }),
    "An der verputzten Wand stehen Paddel, Angel, Bojen und anderes "+
    "Zeug, das man auf Schiffen finden kann. ");
  AddDetail( ({ "haus", "handelshaus", "raum", "laden" }),
    "Dies ist das Handelshaus von Trolske Sendason. Viele verschiedene Dinge kann "+
    "man hier erstehen. Vorallem kann man hier Sachen kaufen die man zum "+
    "Fischen benoetigt. Wichtige Ausruestungen die auf keinem Schiff fehlen "+
    "duerfen gehoeren zum Sortiment.");
  AddDetail( ({ "zeug", "dinge", "sachen", "ding", "sache", "ausruestungen", 
                "sortiment"}),
    "Vieles kann man hier kaufen. Lass doch einfach von Trolske Sendason "
	"'zeige'n was er Dir anbieten kann. ");
  AddDetail( ({ "schiff", "schiffe", "schiffen" }),
    "Schiffe kannst Du hier nicht sehen. Aber Sachen, die man auf Schiffen "+
    "braucht, gibt es hier zuhauf. ");
  AddDetail( ({ "holz", "holzbohlen" }),
    "Der gezimmerte Boden ist sehr stabil.");
  AddDetail( ({ "schritt", "schritte" }),
    "Deine Schritte klingen etwas hohl, als wenn unter dem duennen Boden "+
    "ein Keller waere. ");
  AddDetail( ({ "keller" }),
    "Du kannst keinen Weg nach unten in den Keller sehen. Warscheinlich "+
    "dient er eh nur als Lagerraum. ");
  AddDetail( ({ "netz", "netze", "reusen", "reuse" }),
    "Mit Netzen und Reusen faengt man Fische. ");
  AddDetail( ({ "maschen" }),
    "Je nachdem wie grob die Maschen sind kann man grosse oder kleine "+
    "Fische fangen. ");
  AddDetail( ({ "paddel" }),
    "Bei Flaute muss man paddeln um vom Fleck zu kommen. Viele der Paddel "+
    "sind lang und schmal, manche fuer kleine Boote kurz und etwas breiter. ");
  AddDetail( ({ "angel" }),
    "Wenn Du alleine unterwegs bist und Dir einen Fisch zum essen fangen "+
    "willst, ist so eine Angel das, was Du brauchst.");
  AddDetail( ({ "bojen", "boje", "markierungen" }),
    "Diese schwimmenden Markierungen kann man benutzen um Untiefen "+
    "anzuzeigen oder den Weg des Schiffs zu markieren. Allerdings darf der "+
    "Meeresboden dabei nicht zu tief sein. ");
  AddDetail( ({ "staub" }),
    "Na Staub eben ... ");
  AddDetail( ({ "fisch", "fische" }),
    "Hier kannst Du alles wichtige zum Fischen bekommen. Fische selbst "+
    "gibt es allerdings nicht in diesem Laden. ");
  AddDetail( ({ "untiefen", "riffe", "untiefe", "riff" }),
    "Viele Schiffe sind schon durch Riffe und andere Untiefen gesunken.");
  AddDetail( ({ "weg" }),
    "Du bist in einem Haus - es gibt hier keinen Weg.");
  AddDetail( ({ "meeresboden", "grunde" }),
    "Wer weiss, was so alles am Grunde des Meers alles wohnt.");
  AddDetail( ({"boote"}),
    "Du kannst bestimmt am Hafenbecken Boote bewundern, aber nicht hier.");
  AddDetail( ({"flaute"}),
    "Wenn kein Wind herrscht, nennt man das Flaute. Aber das Wetter sollte man lieber "+
    "unter freiem Himmel untersuchen.");
  AddDetail( ({"himmel", "hafenbecken", "wind", "wetter","meer"}),
    "Dazu musst Du hinaus gehen.");
  AddDetail( ({"fleck"}),
    "Wenn Du Dich bekleckerst hast Du einen Fleck.");
  AddDetail( ({"lagerraum", "lager"}),
    "Der Keller dient bestimmt als Lager. Aber wie man hinab kommt kannst Du nicht erkennen.");
  AddDetail( ({"haendler","verkaeufer","trolske","sendason","trolske sendason"}),
    "Trolske Sendason ist der Verkaeufer in diesem Laden. Vermutlich "
	"behoert dieser ihm auch.");

/*
  AddDetail( ({""}),
    "");
*/
  /* Exits */
  AddExit( "sueden" , ROOM + "hafen_d3.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "trolske_sendason.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
//  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );

}

