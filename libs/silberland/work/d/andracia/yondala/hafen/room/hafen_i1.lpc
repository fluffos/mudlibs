#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Hier beginnt das Hafengebiet. \n" );
  
  AddDetail( ({"hafengebiet"}),
    BS("Hier stehen die ersten Haeuser, die zum Hafen gehoeren. Das nennt man dann "+
    "Hafengebiet. ") );
    
  AddExit( "westen" , ROOM + "hafen_h1.lpc");
  //erstmal bis hier fertig machen, dann wieder reinnehmen
  // AddExit( "osten" , KREUZUNG_02 );
 AddExit( "osten" , ROOM + "kreuzung_2.lpc" );
}