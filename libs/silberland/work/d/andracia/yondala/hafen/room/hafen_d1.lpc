// Hafenmeisterei
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Hafenmeisterei" );
  SetProp( P_INT_LONG,
    "Dies ist die Hafenmeisterei. Auf einem grossen Tisch in der Mitte des "+
    "Raums liegen Seekarten und eine Liegeplan des Hafens aus. Hier kann man "+
    "sich als Kapitaen informieren und, wenn man im Hafen ankert, seine "+
    "Liegegebuehr entrichten. Mehrere schwere Taue haengen an Haken vor "
	"der Wand, um bei Bedarf die Schiffe anleinen zu koennen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

 AddSound( DEFAULT_SOUND,
    "Du hoerst das geschaeftige Treiben der Leute draussen vor der Tuer.");

  AddSound( ({ "treiben", "leute" }),
    "Nun, es sind typische Hafengeraeusche.");
  AddSound( ({ "hafengeraeusche","geraeusche" }),
    "Draussen rufen sich Seeleute Befehle zu, Fischer tauschen Neuigkeiten "
	"aus und Haendler preisen ihre Ware an.");
  AddSound( ({ "seeleute","seemann" }),
    "Die Seeleute rufen sich draussen Befehle zu.");
  AddSound( ({ "befehle" }),
    "Da Du kein Seemann bist, kannst Du mit den meisten Befehlen nichts "
	"anfangen.");
  AddSound( ({ "fischer" }),
    "Viele der Fischer sind oft tage- oder sogar wochenlang unterwegs, da "
	"wollen sie natuerlich die neusten Neuigkeiten wissen, wenn sie zurueck "
	"sind.");
  AddSound( ({ "neuigkeiten" }),
    "So genau interessiert es Dich eigentlich nicht.");
  AddSound( ({ "haendler" }),
    "Die Haendler kaufen die frische Ware direkt von den Fischern, um sie "
	"dann teuer weiter zu verkaufen.");
  AddSound( ({ "ware" }),
    "Die Ware ist total still.");


  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist etwas stickig, es riecht nach Meer und nassen "
	"Seilen.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht nach Salz, Fisch und Tang.");
  AddSmell( ({ "salz","fisch","tang" }),
    "Danach riecht das Meer, unter anderem.");
  AddSmell( ({ "seile" }),
    "Die Seile wurden vermutlich nass, als ein Schiff damit fest gemacht "
	"wurde.");
  AddSmell( ({ "schiff" }),
    "Das Schiff ist nicht hier, Du kannst es nicht riechen.");
  AddSmell( ({ "luft" }),
    "Die Luft ist etwas stickig.");
	

  AddDetail( ({"boden"}),
    "Ein normaler Boden aus Holzbohlen. ");
  AddDetail( ({"wand", "waende"}),
    "Die verputzten Waende wurden in einem hellen Blau gestrichen. An "+
    "einer Wand sind Haken angebracht auf denen mehrere dicke Taue haengen.");
  AddDetail( ({"decke"}),
    "Holzbalken tragen die hoelzerne Decke, an einem Balken haengt eine "
	"schmiedeeiserne Lampe.");
  AddDetail( ({"tuer", "westen", "pier"}),
    "Durch die Tuer im Westen kannst Du wieder hinaus auf den Pier. ");
  AddDetail( ({"hafenmeisterei", "raum", "raums"}),
    "Dies ist die Hafenmeisterei. Der Hafenmeister wohnt hier und "+
    "organisiert die Liegeplaetze und die Hafengebuehren. Viele Seekarten "+
    "hat der Hafenmeister gesammelt und kann so den Kapitaenen helfen. ");
  AddDetail( ({"tisch"}),
    "Der Tisch in der Mitte des Raums ist mit Seekarten beladen. "+
    "Kapitaene koennen sich hier vor ihrer Reise informieren oder sogar "+
    "Seekarten nachzeichnen. ");
  AddDetail( ({"mitte"}),
    "Ein Tisch steht in der Mitte des Raums.");
  AddDetail( ({"seekarten", "karten", "seekarte", "karte"}),
    "Auf Seekarten sind Untiefen und vieles mehr verzeichnet. Als "+
    "Kapitaen muss man sich immer mit den aktuellsten Seekarten versorgen, "+
    "sonst lauft man auf eine Untiefe und geht unter. ");
  AddDetail( ({"liegeplan", "plan"}),
    "Auf einem Liegeplan werden die Schiffe eingetragen, die vom Hafenmeister "+
    "festen Platz zugewiesen bekommen haben. ");
  AddDetail( ({"liegeplatz", "liegeplaetze", "platz" }),
    "Jedes Schiff, das regelmaessig im Hafen festmacht, hat seinen festen "+
    "Platz und wurde im Liegeplan eingetragen. ");
  AddDetail( ({"hafen", "hafens", "schiff", "schiffe"}),
    "Durch die Tuer im Westen kommst Du wieder hinaus. Da kann man den "+
    "Hafen und die vor Anker liegenden Schiff betrachten. ");
  AddDetail( ({"kapitaen", "kapitaene", "schiffsfuehrer"}),
    "Jeder Schiffsfuehrer muss ein Kapitaenspatent erworben und verdient "+
    "haben bevor er in See stechen darf. ");
  AddDetail( ({"liegegebuehr", "gebuehr", "hafengebuehren", "hafengebuehr",
               "liegegebuehren", "gebuehren"}),
    "Wenn man sein Schiff fuer laengere Zeit im Hafen auf einen "+
    "Liegeplatz stellen will, so muss man hier in der Hafenmeisterei "+
    "eine Gebuehr entrichten. ");
  AddDetail( ({"haken"}),
    "Die Haken wurden tief in die Wand geschlagen, damit sie die schweren "
	"Taue zuverlaessig halten. ");
  AddDetail( ({"tau", "taue", "seil", "seile", "leine", "leinen"}),
    "Die Taue und Seile werden gebraucht um Schiffe zu vertaeuen. Nach "
	"Gebrauch werden sie immer wieder fein saeuberlich aufgerollt um sie "
	"zu schonen und jederzeit griffbereit zu haben.");
	AddDetail( ({"gebrauch"}),
    "Die Taue werden gebraucht, um die Schiffe im Hafen festzumachen. ");

	AddDetail( ({"bedarf"}),
    "Frag doch jemanden, wenn Du einen besonderen Bedarf hast. Auch die "+
    "Haendler hier am Hafen haben viele nuetzliche Dinge. ");
  AddDetail( ({"holzbohlen", "holzbalken", "holz"}),
    "Das Holz sieht nach Buche aus.");
  AddDetail( ({"untiefe", "untiefen", "bereich", "finger"}),
    "Oft sieht man Untiefen als ruhigen Bereich des Wassers. Dann kann "+
    "man erkennen dass das Wasser dort nur wenige Finger tief ist. Solche "+
    "Felsen und Riffe haben schon viele Schiffe in die Tiefe gerissen. ");
  AddDetail( ({"hafenmeister"}),
    "Der Hafenmeister ist scheinbar gerade nicht zugegen.");
  AddDetail( ({"kapitaenspatent"}),
    "Noch hast Du keins!");
  AddDetail( ({"haendler"}),
    "Hier ist kein Haendler. ");
  AddDetail( ({"dinge"}),
    "Ja ... Du untersuchst Dinge!");
  AddDetail( ({"buche", "baustoff"}),
    "Der wichtigste Baustoff ist Holz. Hier wurde wohl Buche verwendet. ");
  AddDetail( ({"anker"}),
    "Jedes Schiff sollte einen haben, damit kann man das Schiff auch mal "
	"ausserhalb des Hafens auf Position halten - wenn das Wasser nicht zu "
	"tief ist.");
  AddDetail( ({"riff", "riffe", "felsen"}),
    "So manches Schiff ist schon an einem Riff zerschellt.");
  AddDetail( ({"meer", "wasser", "see"}),
    "Das Meer liegt im Westen.");
  AddDetail( ({"reise"}),
    "Besteige doch einfach ein Schiff!");
  AddDetail( ({"position"}),
    "Das kann manchmal sehr wichtig sein.");
  AddDetail( ({"zeit"}),
    "Zeit ist meist relativ, hier aber Geld.");
  AddDetail( ({"geld"}),
    "Es kostet eine Gebuehr im Hafen fest zu machen. Und je laenger man "
	"bleibt, desto teurer wird es natuerlich. Also ist Zeit hier wirklich Geld.");
  AddDetail( ({"tiefe"}),
    "Was relativ schlecht ist fuer ein Schiff.");
  AddDetail( ({"blau"}),
    "Die Waende sind in einem hellen Blau gestrichen.");
  AddDetail( ({"putz"}),
    "Der Putz ist mit blauer Farbe ueberstrichen.");
  AddDetail( ({"farbe"}),
    "Die Farbe ist blau.");
  AddDetail( ({"lampe"}),
    "Die schmiedeeiserne Lampe ist nicht sonderlich huebsch, aber sie "
	"haelt vier Kerzen hoch, sodass diese den Raum erleuchten koennen.");
  AddDetail( ({"kerzen","kerzen"}),
    "Die Kerzen sind schon halb herunter gebrannt, doch sie erhellen den "
	"Raum genug um alles darin erkennen zu koennen.");  
  AddDetail( ({"raum"}),
    "Du befindest Dich in der Hafenmeisterei.");
  AddDetail( ({"balken"}),
    "An einem der Holzbalken ist eine Lampe befestigt.");	
	
	
/*
  AddDetail( ({""}),
    "");
*/

  /* Exits */
  AddExit( "westen" , ROOM + "hafen_c1.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "boromil_bregelsaum.lpc", REFRESH_DESTRUCT );

}
