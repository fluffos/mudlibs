#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) +
	"Im Sueden ist das Haus eines Haendlers "+
    "und im Norden ist eine nettes Fischlokal. " );
  AddDetail( ({ "himmel" }),
    "Die vielen Wolken werden von einer frischen Brise vom Meer "+
    "her ueber das Festland getrieben. Die kalte Luft und die vielen "
	"Wolken lassen darauf schliessen, dass weit draussen eine aufgewuehlte "
	"See herrscht. ");
  AddDetail( ({"haus"}),
    "Das Haus des Haendlers ist aus Brettern zusammen gezimmert. Es macht "
	"keinen sehr reichen, aber auch keinen armen Eindruck." );
  AddDetail( ({"eindruck"}),
    "Der Haendler scheint weder sonderlich arm, noch sehr reicht zu "
	"sein. Zumindest ist das Dein Eindruck.");
  AddDetail( ({"bretter"}),
    "Die Bretter sind oredntlich und gleichmaessig zusammengefuegt. "
	"Ausserdem wurden sie vormutlich erst kuerlich frisch gestrichen.");
 
 AddDetail( ({"haendlers", "haendler", "sueden"}),
    "Geh nach Sueden, da kannst Du im Haus des Haendlers einkaufen. " );
  AddDetail( ({"fischlokal", "lokal", "Norden"}),
    "Geh doch nach Norden in das Fischlokal hinein um Dir dort das "+
    "Essen schmecken zu lassen." );
   AddDetail( ({"essen"}),
    "Bestimmt bekommst Du dort etwas leckeres zu Essen. Zumindest riecht "
	"das Essen bis hier draussen einfach koestlich.");
  AddSmell( ({"essen","fisch"}),
    "Es riecht hier nach frisch gebratenen Fischen. Lecker." );
   
  AddExit( "norden" , ROOM + "hafen_e2.lpc");
  AddExit( "sueden" , ROOM + "hafen_e4.lpc");
  AddExit( "osten" , ROOM + "hafen_f3.lpc");
  AddExit( "westen" , ROOM + "hafen_d3.lpc");
}