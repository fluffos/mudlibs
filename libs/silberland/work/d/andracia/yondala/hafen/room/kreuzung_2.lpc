#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein Wegweiser steht hier herum. \n" );
  
  AddDetail( ({"hafengebiet"}),
    "Hier stehen die ersten Haeuser die zum Hafen gehoeren. Das nennt man dann "+
    "Hafengebiet. ");
   AddDetail( ({"wegweiser"}),
    "Der Wegweiser zeigt nach Norden, Sueden, Osten und Westen.");   

   AddDetail( ({"Norden"}),
    "zur Steilkueste");   
   AddDetail( ({"sueden"}),
    "zum Strand");   
   AddDetail( ({"osten"}),
    "Hafen");   
   AddDetail( ({"westen"}),
    "Zum Hafen");   
   AddDetail( ({""}),
    " ");   
	AddExit( "westen" , ROOM + "hafen_i1.lpc");
   AddExit( "norden" ,"/d/andracia/yondala/wege/room/kuestenweg_nord_23.lpc" );
   AddExit( "osten" , "/d/andracia/yondala/wege/room/weg_zum_hafen_01.lpc" );
   AddExit( "sueden" , "/d/andracia/yondala/wege/room/weg_zum_strand_i1.lpc" );
   
}

