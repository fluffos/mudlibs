#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Strasse durch das Hafendorf" );
  SetProp( P_INT_LONG, 
   "Dies ist die Strasse durch das Hafendorf. Sie fuehrt direkt zum Hafen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    "Das Pfeifen des Windes und die Geraeusche des Treibens am Hafen "
	"vermischen sich hier. Das Geschrei der Hafenarbeiter und Fischer "
	"liefert die typische Geraeuschkulisse. ");
  AddSound( ({ "wind", "pfeifen" }),
    "Die steife Brise streicht duch den Hafen und erzeugt dieses Geraeusch. ");
  AddSound( ({ "geraeusche", "geraeusch", "geraeuschkulisse", "geschrei", 
               "hafenarbeiter", "fischer", "treiben" }),
    "See und Hafen erzeugen eine Vielzahl an Geraeuschen. ");
 AddSound( ({ "vielzahl" }),
    "Wonach riecht denn bitte eine Vielzahl? Man kann auch uebertreiben.");

  AddSmell( DEFAULT_SMELL,
    "Der typische Geruch von Salzwasser dringt in Deine Nase, getruebt "
    "durch den Geruch des brackigen Wassers und den feilgebotenen Fischen. ");
  AddSmell( ({ "wasser", "salzwasser", "brise", "meer", "see", "frische"}),
    "Salzig schmeckt der Wind, der Dir um die Nase weht. ");
  AddSmell( ({ "geruch", "hafen", "brackwasser", "hafenbecken", "fische", "fisch" }),
    "Der unangenehme Geruch von Fisch und Brackwasser herrscht hier. ");

  AddDetail( ({ "wolken", "wolke" }),
    "Die steife Brise treibt die Wolken von der See auf das Land. ");
  AddDetail( ({ "brise", "luft", "wind" }),
    "Ein etwas staerkerer Wind aus Westen treibt die Wolken vor sich her. ");
  AddDetail( ({ "festland", "land", "region", "kueste", "kuestenregion"}),
    "Das Land im Osten und die umliegenden Kuestengebiete werden von hier "
	"aus mit Fischen versorgt. ");
  AddDetail( ({ "strasse" }),
    "Die Strasse durch das Dorf ist geneigt und hat ihren tiefsten Punkt am Hafen. ");
  AddDetail( ({ "hafendorf", "dorf" }),
    "Dieses Dorf lebt vom Handel und Fischfang. Die ganze Region wird von hier versorgt. ");
  AddDetail( ({ "hafen" }),
    "Immer entlang gen Westen endet die Strasse direkt am Hafen. ");
  AddDetail( ({ "boden", "untergrund" }),
    "Die steinerne Strasse bildet einen guten Untergrund zum laufen. ");
  AddDetail( ({ "himmel" }),
    "Die vielen Wolken werden von einer frischen Brise vom Meer "+
    "her ueber das Festland getrieben. Die kalte Luft und die vielen "
	"Wolken lassen darauf schliessen, dass weit draussen eine aufgewuehlte "
	"See herrscht. Hier am Hafen sind die Wellen nicht allzu hoch. ");
  AddDetail( ({"fischfang"}),
    "Die meisten Einwohner der Umgebung leben vom Fischfang.");
  AddDetail( ({"haeuser", "fischerhuetten", "huetten"}),
    "Einfache Haeuser von Fischern.");
  AddDetail( ({"handel"}),
    "Haefen beziehen ihren Reichtum aus zwei Quellen: dem Handel und dem Fischfang.");
  AddDetail( ({"kuestengebiete", "kuestengebiet", "gebiete", "gebiet" }),
    "Diese Kuestengebiet ist der westlichste Teil des Huegellands. "+
    "Westlich von hier liegt nur noch das Meer.");
  AddDetail( ({"wellen"}),
    "Das kann man am Wasser besser untersuchen.");
  AddDetail( ({"punkt", "ende", "nase", "quellen"}),
    "Du untersuchst schon wieder Bloedsinn.");
  AddDetail( ({"bloedsinn", "das"}),
    "DAS ist Bloedsinn!");
  AddDetail( ({"huegelland"}),
    "Dieses Dorf ist das westliche Ende des Huegellands.");
  AddDetail( ({"reichtum"}),
    "So besonders reich scheint dieses Hafendorf nicht zu sein. Viele der "
	"Haeuser sind nur einfache Fischerhuetten.");
  AddDetail( ({"walfaenger", "schiffe"}),
    "Die Schiffe kann man im Hafen bestaunen.");
  AddDetail( ({"umgebung"}),
    "Im Hafen und der naeheren Umgebung.");
  AddDetail( ({"einwohner","menschen"}),
    "Die meisten Einwohner von Hafen und Umgebung sind Menschen.");
  AddDetail( ({"teil","teile"}),
    "Das Huegelland besteht aus mehreren Teilen, die es durchaus wert "
	"sind erforscht zu werden.");
  AddDetail( ({"haefen"}),
    "Haefen wie dieser.");

/*
  AddDetail( ({""}),
    "");
*/
}

