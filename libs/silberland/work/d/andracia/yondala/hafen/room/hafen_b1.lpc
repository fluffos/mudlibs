#include "../def.h"

inherit ROOM + "hafen_mole_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Osten gelangst Du auf das Festland. \n" );
    
  AddExit( "osten" , ROOM + "hafen_c1.lpc");
  AddExit( "westen" , ROOM + "hafen_a1.lpc");
}