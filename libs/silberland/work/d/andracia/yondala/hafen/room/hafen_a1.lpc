#include "../def.h"

inherit ROOM + "hafen_mole_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Die Mole hat hier einen Knick. \n" );
  
  AddDetail( ({"knick", "richtungswechsel"}),
    BS("Die Mole umschliesst den Hafen gen Sueden und schuetzt gegen "+
    "die Wellen aus Westen. Nach Osten stoesst die Mole gegen das Festland "+
    "und hat hier ihren Richtungswechsel. "));
    
  AddExit( "osten" , ROOM + "hafen_b1.lpc");
  AddExit( "sueden" , ROOM + "hafen_a2.lpc");
}