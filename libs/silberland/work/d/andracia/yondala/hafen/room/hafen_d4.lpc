inherit "std/pub.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hafenkneipe" );
  SetProp( P_INT_LONG,
     "Du bist in einer typischen Hafenkneipe. Es ist laut, Fisch- und "
	 "Alkoholgeruch haengt in der Luft, Matrosen, Gesindel und Dirnen "
     "laermen, trinken und feiern hier. An einer langen Theke "+
     "bedient der Wirt seine durstigen Gaeste. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Xandro Barchenter");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Xandro Barchenter");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddSound( DEFAULT_SOUND,
    "Neben dem lauten Rufen nach Bier und Schnaps von den "+
    "Kneipenbesuchern, hoert man noch Glaeser klirren und Stuehle, "
	"die ueber den Boden hin und her gerueckt werden.");
  AddSound( ({"rufen"}),
    "Die Gaeste rufen laut und fordernd nach Bier und Schnaps.");
  AddSound( ({"musik"}),
    "Hoert sich fast an, wie ein Klavierstueck.");
  AddSound( ({"klavierstueck"}),
    "Du lauschst. Ja, definitiv, die Musik stammt von einem Klavier.");
  AddSound( ({"musik"}),
    "Du folgst der Musik. Tatsaechlich, dort steht ein Klavier.");
			
  AddSound( ({"bier","schnaps","meer"}),
    "*gluck* (Oder was dachtest Du, wie sich das anhoert?)");
			
  AddSound( ({"gaeste","kneipenbesucher"}),
    "Hier kannst Du einiges hoeren; mancher Gast erzaehlt haarstraubende "
	"Geschichten von seiner letzen Fahrt, andere Gaeste singen rauhe "
	"Lieder und einige unterhalten sich ganz normal.");
			
  AddSound( ({"unterhaltung", "gespraech"}),
    "Da es hier so sehr laut ist kannst Du kaum einem Gespraech richtig "
	"folgen.");
			
  AddSound( ({"gast","geschichten"}),
    "Wirklich haarstraeubende Geschichten werden da erzaehlt, von wilden "
	"Piraten, Zwergen, die Menschen fressen und Walen, die jeden "
	"verschlucken, der es sich wagt im Meer zu schwimmen.");
			
  AddSound( ({"piraten","zwerge","menschen","wale", "fahrt"}),
    "Du bist ziemlich sicher, dass nicht mal die Haelfte davon wahr ist.");
  AddSound( ({"gaeste"}),
    "Die Gaeste sind insgesamt sehr laut, die meisten davon aber friedlich "
	"und froehlich, denn immer wieder werden die Gespraeche von herzhaften "
	"Lachern unterbrochen.");
			
  AddSound( ({"haelfte"}),
    "Vermutlich eher noch weniger.");
  AddSound( ({"lacher", "gelaechter"}),
    "Wo man lacht, da lass Dich nieder, so ein altes andracisches Sprichwort.");
  AddSound( ({"sprichwort"}),
    "Da es keiner gesagt hat, kannst Du es auch nicht hoeren.");
  AddSound( ({"lieder"}),
    "Du lauscht einem Moment den rauhen Liedern und hoerst dann erroetend weg.");
  AddSound( ({"moment"}),
    "Der Moment ist vorbei.");
  AddSound( ({"gejohle", "maenner"}),
    "Ein paar betrunkene Maenner johlen sinnlos herum.");
  AddSound( ({"klirren","glaeser"}),
    "Immer wieder werden hier Glaeser klirrend aneinander gestossen.");
  AddSound( ({"stuehle", "geraeusch"}),
    "Jedesmal, wenn ein Gast einen Stuhl rueckt, erzeugt er damit ein karzend-schabendes Geraeusch.");
  AddSmell( ({"geruch"}),
    "Abgestandener Rauch, verschuettetes Bier und schwitzende Matrosen "
	"bilden einen bitteren Geruch der in der Nase beisst. ");			
			
			
	
  AddSmell( DEFAULT_SMELL,
    "Abgestandener Rauch, verschuettetes Bier und schwitzende Matrosen "
	"bilden einen bitteren Geruch der in der Nase beisst. ");
  AddSmell( ({"rauch","pfeife","pfeifchen"}),
    "Viele der Gaeste rauchen kleine Pfeifchen und blasen den Rauch in "
	"die Luft.");
  AddSmell( ({"gaeste"}),
    "Du schnupperst an einem der Gaeste. Als dieser Dich irritiert anschaut "
	"ziehst Du Deine Nase schnell wieder zurueck.");
  AddSmell( ({"nase", "innen"}),
    "Ein ungeloestes Raetsel: Wie riecht die eigene Nase von Innen?");
  AddSmell( ({"raetsel"}),
    "Du schnupperst an einem imaginaeren Raetsel herum. Riecht mysterioes.");
  AddSmell( ({"matrosen", "matrose", "schweiss"}),
    "Du ueberlegst kurz, ob Du an den Matrosen riechen willst, entscheidest "
	"Dich aber dagegen. Man will ja niemanden provozieren.");
  AddSmell( ({"bier"}),
    "Hoffentlich schmeckt das besser als es riecht.");
  AddSmell( ({"fisch", "fischer"}),
    "Einige der Fischer riechen ziemlich fischig.");
 

	
  AddDetail( ({ "boden" }),
    "Der hoelzerne Boden klebt vom verschuettetem Bier. ");
  AddDetail( ({ "decke" }),
    "Die schmucklose hoelzerne Decke kann man durch die tabakschwangere Luft "+
    "nur undeutlich erkennen. ");
  AddDetail( ({ "waende", "wand" }),
    "Die grob verputzten Waende sehen an vielen Stellen so aus, als sein "
    "sie schon oft von fliegenden Kruegen und geworfenen Moebelstuecke "
	"getroffen worden. ");
  AddDetail( ({ "stellen" }),
    "Die meisten stellen sehen so aus, als sein Moebelstuecke dagegen "
	"geflogen. Du bei einer Stelle bist Du Dir nicht so sicher.");
  AddDetail( ({ "stelle" }),
    "Die eine Stelle an der Wand sieht so aus, als sei da etwas Rundes "
	"gegengeschlagen worden.");
  AddDetail( ({ "rundes" }),
    "Du stellst Dir vor, dass das ein Kopf gewesen sein koennte.");
  AddDetail( ({ "kopf" }),
    "Du schuettelst Dich bei dem Gedanken.");
  AddDetail( ({ "gedanken" }),
    "*schuettel*");
	
  AddDetail( ({ "bier", "alkohol", "schnaps" }),
    "Frag doch einfach den Wirt was er alles so in seinem 'menue' hat.");
  AddDetail( ({ "fisch" }),
    "Zu essen wirst Du hier nichts bekommen. Der Geruch von Fisch wurde wohl "+
    "von den Fischern, die sich hier betrinken hereingetragen. ");
  AddDetail( ({ "gaeste" }),
    "Gesindel, Dirnen und Trunkenbolde zechen hier. Schon so mancher Fischer "
	"hat hier seinen Fang und mancher Matrose seine Heuer versoffen. ");
  AddDetail( ({"gesindel"}),
    "Manch zwielichtiges Gesindel treibt sich hier rum. Doch noch sehen "
	"alle relativ friedlich aus.");
  AddDetail( ({"dirnen", "dirne"}),
    "Ein paar junge und auch einige aeltere Dirnen versuchen die Matrosen "
	"zu bezirzen um ein wenig zu verdienen.");  
  AddDetail( ({"trunkenbolde"}),
    "Die Trunkenbolde sind hauptsaechlich Matrosen und Fischer.");	
  AddDetail( ({ "theke" }),
    "Die hoelzerne Theke ist sehr lang und nimmt eine ganze Wand ein. "
	"So haben die Gaeste stehts das Gefuehl, in der ersten Reihe zu stehen. ");
  AddDetail( ({ "gefuehl","gefuehle" }),
    "Du freust Dich darueber, wie gut der Wirt auf die Gefuehle seiner "
    "Gaeste eingeht.");
  AddDetail( ({"reihe"}),
    "Wer steht nicht gerne in der ersten Reihe?");
  AddDetail( ({ "raum", "hafenkneipe", "kneipe" }),
    "Du bist in einer typischen Hafenkneipe. Es ist laut, Fisch- und "
	 "Alkoholgeruch haengt in der Luft, Matrosen, Gesindel und Dirnen "
     "laermen, trinken und feiern hier. An einer langen Theke "
     "bedient der Wirt seine durstigen Gaeste. ");
  AddDetail( ({ "holz" }),
    "Das meiste in diesem Raum besteht aus Holz.");
  AddDetail( ({ "krug", "kruege", "messingkruege" }),
    "Darin wird das Bier ausgeschenkt. Die Messingkruege sind allesamt verbeult. ");
  AddDetail( ({ "moebel", "moebelstuecke", "moebelstueck" }),
    "Es gibt nur die Theke und sehr wenige Tische und Stuehle. "
	"Warscheinlich gehen diese Moebelstuecke zu oft bei Schlaegereien hier zu Bruch. ");
  AddDetail( ({"tische"}),
    "Wenige Tische gibt es hier und noch weniger davon sind ungeschadet, "
	"aber allesamt sind sie dreckig und klebrig.");
  AddDetail( ({"stuehle"}),
    "Kaum einer der Gaeste sitzt entspannt auf seinem Stuhl. Die meisten "
	"haben vermutlich Angst, dass er unter ihm zusammenbricht.");
  AddDetail( ({"angst"}),
    "Die Angst haettest Du auch, wenn Du auf so einem Stuhl sitzen muesstest.");
  AddDetail( ({"stuhl"}),
    "Bis auf den letzten Stuhl sind alle belegt.");
  AddDetail( ({"glaeser","glas"}),
    "Nun, die wenigsten Gaeste trinken aus Glaesern, die meisten haben "
	"verbeutel Messingkruege vor sich stehen.");
  AddDetail( ({"bruch"}),
    "Du vermutest, dass hier taeglich einiges zu Bruch geht.");
  AddDetail( ({"ecke"}),
    "In jeder Ecke sitzen hier Gaeste, die Kneipe ist brechend voll.");
  AddDetail( ({"gesicht"}),
    "Ja, Dein Gesicht ist das huebscheste, echt.");
  AddDetail( ({"schoss"}),
    "Was tut man nicht alles fuer ein paar Muenzen?");
  AddDetail( ({"muenzen"}),
    "Gut, dass Du davon genuegend hast und Dich hier nicht verkaufen musst.");
  AddDetail( ({ "tabak", "luft" }),
    "Die truebe tabakschwangere Luft traegt ihren Teil der verruchten Stimmung die "+
    "hier herrscht bei. ");
   AddDetail( ({"teil"}),
    "Sie traegt dazu bei, loest sie aber nicht aus.");
  AddDetail( ({ "stimmung" }),
    "Sei vorsichtig! Der kleinste Anlass kann hier zu einer wilden Schlaegerei "+
    "fuehren. Waere auch kein Wunder wenn diese dann zu einer Messerstecherei ausartet. ");
  AddDetail( ({"wunder"}),
    "Es waere keines.");
  AddDetail( ({"schlaegerei", "schlaegereien", "messerstecherei"}),
    "Willst Du eine anfangen?");
  AddDetail( ({"fang", "heuer"}),
    "Das gestaltet sich hier etwas schwer. ");
  AddDetail( ({"anlass"}),
    "Wer braucht einen Anlass? Wenn man eine Schlaegerei haben will, so "
	"ist es ein leichtes eine anzufangen.");
  AddDetail( ({"messingkruege", "messingkrug", "krug"}),
    "Die Getraenke werden hier in Messingkruegen ausgeschenkt. Sogar der Schnaps.");
  AddDetail( ({"getraenke", "trinken"}),
    "Schau doch einfach per 'menue' was hier angeboten wird.");
  AddDetail( ({"wirt"}),
    "Normalerweise ist ein Wirt da und schenkt die Getraenke aus.");
  AddDetail( ({"klavier"}),
    "Fast haettest Du das alte Klavier uebersehen. Ein junger Bursche "
	"sitzt daran und erzeugt leise Musik.");
  AddDetail( ({"bursche"}),
    "Der junge Bursche sieht recht aermlich aus, er ist ganz abgemagert.");
  AddDetail( ({"matrosen","fischer"}),
    "Das erste, was jene nach einer langen Zeit auf See besuchen, sind "
	"Kneipen wie diese.");
 AddDetail( ({"zeit"}),
    "Manch einer verbringt mehr Zeit auf See als auf dem Festland.");
 AddDetail( ({"see", "braut"}),
    "Die See ist eine wilde Braut.");
 AddDetail( ({"festland"}),
    "Du bist hier auf dem Festland. Zumindest ist der Boden solange fest, "
	"bist Du auf ihm betrunken herumtorkelst.");
 AddDetail( ({"kneipe","kneipen","hafenkneipe"}),
    "Du bist in einer typischen Hafenkneipe.");
  AddDetail( ({"gewicht"}),
    "Die Stuehle halten wohl nicht jeden aus.");
	
	/*
  AddDetail( ({""}),
    "");
*/

  /* Menue */
  AddDrink("Fischwasser", ({"wasser", "fischwasser"}) , 45, ({10,18}), 0, 6,
         ({ "Du trinkst mit Genuss Dein Fischwasser.",
            "&& laesst sich Fischwasser schmecken." }) );    
  AddDrink("Bier", "bier", 76, 20, 2, 8,
         ({ "Du trinkst Dein Bier in einem Zug aus.",
            "&& leert in einem Zug ein Bierglas." }) );
  AddDrink("Kuestenmalz", ({"malz", "kuestenmalz"}), 99, 25, 7, 10,
         ({ "Du trinkst Dein Malzbier in einem Zug aus.",
            "&& leert in einem Zug ein Malzbier." }) );
  AddDrink("Austernsaft", ({"saft", "austernsaft"}), 112, 0, 0, 10, "drink_austernsaft" );
   /*      ({ "Du trinkst Deinen Austernsaft in einem Zug aus.",
            "&& leert in einem Zug einen Krug Austernsaft." }) );*/
  AddDrink("Schnaps", "schnaps" , 125, ({38,18}), 10, 3,
         ({ "Du kippst Dir Deinen Schnaps in den Hals.",
            "&& kippt sich einen Schnaps in den Hals." }) ); 
 

AddRoomMessage( 
    ({"Ein Gast stuerzt an Dir vorbei und bruellt: Aus dem Weg ich muss kotzen!\n",
      "Aus einer Ecke ertoent lautes Gelaechter.\n",
      "Eine Dirne setzt sich auf den Schoss eines Matrosen und kuesst ihn wild.\n",
      "Ein paar betrunkene Matrosen groehlen etwas unflaetiges.\n",
      "Jemand verschuettet sein Bier.\n",
      "Ein Fischer ruft: Bier her!\n",
    	"Jemand blaest Dir Rauch ins Gesicht.\nDu hustest.\n",
    	"Ein Stuhl bricht unter dem Gewicht eines dicken Fischers zusammen.\nUnter dem Gejohle der anderen erhebt der Fischer sich wieder.\n",
    	"Ein Matrose ruelpst neben Dir.\n",
    	"Von irgendwoher ertoent leise Musik.\n",
		"Langsam bist Du von dem Geruch hier leicht benommen.\n"}),30);
    	
 
  /* Exits */
  AddExit( "norden" , ROOM + "hafen_d3.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "xandro_barchenter.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
//  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );
  AddCmd(({"sitze","sitz","setze","setz"}),"setzen");
  AddCmd(({"fange","fang"}),"schlaegerei");

}



void schlaegerei6()
{
  write("Das letzte, was Du merkst ist, wie man Dich unter lautem Gelaechter aus der Kneipe wirft.\n");
  say("Unter lautem Gelaechter wirft man "+TP->name(WEN)+" aus der Kneipe.\n");
  call_out("schlaegerei7",1);
   			TP->SetProp(P_PARALYZED,([PARALYZE_TIME:5, 
			PARALYZE_MSG:"Dein Kopf schmerzt, alles dreht sich, Du musst erstmal wieder klar werden.\n",
			PARALYZE_MSG_OTHER: TPN+" stoehnt auf.\n", 
			PARALYZE_END: "Du kommst langsam wieder zu Dir.\n", 
			PARALYZE_END_OTHER:TPN+" kommt langsam wieder zu sich.\n"]));
	TP->move(ROOM+"hafen_d3", M_NOCHECK,0,0,0);// ,M_SILENT);
	/*
 	                    "","fliegt im hohen Bogen aus dem Raum",
						"fliegt im hohen Bogen aus dem Raum im Westen");*/
	}
		
void schlaegerei5()
{
  write("Du bist so ungeschickt, dass Du Dich selbst mit dem Stuhl niederschlaegst.\n");
  say(TPN+" schlaegt sich selbst nieder.\n");
  call_out("schlaegerei6",1);
}
void schlaegerei4()
{
  write("Du schwingst den Stuhl bedrohlich ueber Deinem Kopf.\n");
  say(TPN+" schwingt den Stuhl bedrohlich ueber "+TP->QueryPossPronoun(MALE, WEM, SINGULAR)+" Kopf.\n");
  call_out("schlaegerei5",1);
}
		
 void schlaegerei3()
{
  write("Alle starren Dich an.\n");
  say("Alle - auch Du - starren "+TP->name(WEN)+" an.\n");
  call_out("schlaegerei4",1);
}

void schlaegerei2()
{
  write("Du groehlst: IHR STINKT ALLE NACH FISCHPUPS!\n");
  say(TPN+" groehlt: IHR STINKT ALLE NACH FISCHPUPS!\n");
  call_out("schlaegerei3",1);
}
	
int schlaegerei(string str)
{
  notify_fail("Was moechtest Du anfangen?\n");
  if(str!="schlaegerei an") return 0;
  if(TP->InFight())
    {
	  write("Du pruegelst Dich doch schon.\n");
	  return 1;
	  }
  write("Du schnappst Dir einen Stuhl.\n");
  say(TPN+" schnappt sich einen Stuhl.\n");
 			TP->SetProp(P_PARALYZED,([PARALYZE_TIME:-1, 
			PARALYZE_MSG:"Du willst Dich doch pruegeln, eins nach dem anderen.\n",
			PARALYZE_MSG_OTHER: TPN+" macht ein finsteres Gesicht.\n", 
			PARALYZE_END: 0, 
			PARALYZE_END_OTHER:0]));
    		call_out("schlaegerei2",1);
  return 1;
  }
 
  
void drink_austernsaft(object zahler, object trinker)
{
  if (trinker->id("Elfenspieler"))
  {
  	if( trinker->QueryProp(P_POISON) < 2)  trinker->AddPoison(2); // Vergiftung
    // trinker->eat_food(-15,0); //nimmt das Trinken nicht wieder raus
    tell_object(trinker, 
      BS("Du fuehlst dich ploetzlich so unwohl...") );
    tell_room(this_object(),
      trinker->name(WER)+" verschluckt sich fast an dem Austernsaft.",({ trinker }) );       
  }
  else
  {
    trinker->AddMp(30);
    trinker->AddHp(30);   
    tell_object( trinker, BS(
      "Du trinkst Deinen Austernsaft in einem Zug aus.") );
    tell_room(this_object(), BS(
      trinker->name(WER)+" leert in einem Zug einen Krug Austernsaft."),({ trinker }) );
  }
}

int setzen(string str)
{
  notify_fail("Worauf moechtest Du sitzen?\n");
  if(str!="auf stuhl") return 0;
  write("Gerade willst Du Dich setzen, da siehst Du, wie wakelig der "+
        "letzte freie Stuhl ist.\nDu bleibst lieber stehen.\n");
  return 1;
}  
 