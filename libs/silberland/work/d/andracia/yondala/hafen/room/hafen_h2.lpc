#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Kueferei" );
  SetProp( P_INT_LONG,
     "Hier in der Kueferei werden Faesser gemacht. Eine Werkbank und viele "+
     "verschiedene Werkzeuge kannst Du erkennen. Falls Du ein Fass benoetigst ist "+
     "hier der richtige Ort. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du kannst nicht besonderes hoeren. ");
  AddSmell( DEFAULT_SMELL,
    "Du riechst nur den typischen Geruch von bearbeitetem Holz. ");
  AddSmell( ({ "geruch", "holz" }),
    "Eben der typische Geruch von frisch bearbeitetem Holz. ");

  AddDetail( ({ "boden" }),
    "Ein paar Holzspaene liegen auf dem Boden.");
  AddDetail( ({ "decke" }),
    "Eine ganz normale uninteressante Decke. ");
  AddDetail( ({ "waende", "wand" }),
    "An einer Wand steht die Werkbank, ansonsten sind nur die grossen Fenster, "+
    "durch die das Licht in die Werkstatt faellt, bemerkenswert. ");
  AddDetail( ({"faesser", "bierfaesser", "wasserfaesser", "teerfaesser", "pechfaesser", "weinfaesser",
               "fass", "bierfass", "wasserfass", "teerfass", "pechfass", "weinfass", "fassbau" }),
     "Hier in der Kueferei werden Faesser gemacht. Aus Holz und Eisen fertigt "+
     "der Kuefer Weinfaesser oder andere Faesser. Im Grunde sieht jedes Fass gleich "+
     "aus. Aber jedes Fass wird anders behandelt, je nachdem was spaeter darin "+
     "eingefuellt wird. Weinfaesser werden vorallem aus schwerem, aromatischem Holz "+
     "gemacht. Wasser- und Bierfaesser sind aus anderem Holz als Teer- und "+
     "Pechfaesser.");
  AddDetail( ({ "werkbank", "bank" }),
    "Auf dieser Werkbank kann man Holz zurechtzimmern um daraus ein Fass zu machen. ");
  AddDetail( ({ "werkzeug", "werkzeuge" }),
    "Die Werkzeuge dienen dem Kuefer zum herstellen von Faessern. Holz und Eisen "+
    "benoetigt er dazu. ");
  AddDetail( ({ "raum", "haus", "ort", "werkstatt", "kueferei" }),
    "Falls Du ein Fass benoetigst ist hier der richtige Ort. ");
  AddDetail( ({ "span", "spaene", "holzspaene" }),
    "Wo gehobelt wird, da fallen Spaene. Jede Holzbohle muss genau angepasst "+
    "werden damit das Fass spaeter dicht ist. ");
  AddDetail( ({ "fenster", "licht" }),
    "Das Licht zum arbeiten ist verzueglich durch die grossen Fenster. ");
  AddDetail( ({ "holz", "holzbohle" }),
    "Das Holz zum Herstellen eines Fass wird zuerst gebogen fuer die typisch "+
    "bauchige Form der Faesser.");
  AddDetail( ({ "eisen", "eisenband", "eisenring", "eisenbaender", "ring" }),
    "Der Kuefer benoetigt flache Eisenbaender, die zu einem Ring geschmiedet "+
    "wurden, fuer die Herstellung der Faesser. ");
  AddDetail( ({ "kuefer" }),
    "Den Handwerker der sich in der Kueferei mit Fassbau betaetigt nennt man Kuefer. ");
  AddDetail( ({ "form" }),
    "Jedes Fass hat die typisch bauchige Form. ");
  AddDetail( ({ "handwerker", "handwerk", "herstellen", "herstellung", "hersteller" }),
    "Jeder Hersteller und Handwerker erzeugt Dinge, wie Haeuser oder wie hier Faesser. ");
  AddDetail( ({"dinge"}),
    "Du musst schon genauer sein.");
  AddDetail( ({"haeuser"}),
    "Du befindest dich hier in der Kueferei.");
  AddDetail( ({"teer"}),
    "Das findet man hier nicht.");

/*
  AddDetail( ({""}),
    "");
*/

  /* Exits */
  AddExit( "westen" , ROOM + "hafen_g2.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "viburn_dargel.lpc", REFRESH_DESTRUCT );

}

