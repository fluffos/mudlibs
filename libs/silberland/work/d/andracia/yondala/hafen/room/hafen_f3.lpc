#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
	"Hier kann man tuechtige Handwerker finden. Im Sueden ist die hiesige "+
	"Schmiede und im Norden kann man eine Seilerei sehen. " );
  AddDetail( ({ "himmel" }),
    "Die vielen Wolken werden von einer frischen Brise vom Meer "+
    "her ueber das Festland getrieben. Die kalte Luft und die vielen "
	"Wolken lassen darauf schliessen, dass weit draussen eine aufgewuehlte "
	"See herrscht. ");
  AddDetail( ({"handwerker"}),
    "Handwerker sind tuechtige Leute die durch ihr Koennen bekannt "
	"geworden sind. ");
  AddDetail( ({"koennen"}),
    "Geh doch hin und ueberzeuge Dich von ihrem Koennen.");
  AddDetail( ({"leute"}),
    "Eigentlich Leute wie Du und ich, die sich aber durch besonderes "
	"Koennen auszeichnen.");
	
  AddDetail( ({"schmiede", "sueden"}),
    BS("Geh doch nach Sueden um die Schmiede zu untersuchen. ") );
  AddDetail( ({"seilerei", "Norden"}),
    BS("Geh doch nach Norden um die Seilerei zu untersuchen. ") );

  AddExit( "norden" , ROOM + "hafen_f2.lpc");
  AddExit( "sueden" , ROOM + "hafen_f4.lpc");
  AddExit( "osten" , ROOM + "hafen_g3.lpc");
  AddExit( "westen" , ROOM + "hafen_e3.lpc");
  
  /*Objekte und NPCs*/
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
//  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );

}