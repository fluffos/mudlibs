inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Laden von Ebnan Kaukalathis " );
  SetProp( P_INT_LONG,
     "Du befindest Dich im Laden von Ebnan Kaukalathis. Hier kann man die "+
     "verschiedensten Dinge kaufen. Schau dich um oder lass Dir von "+
     "Ebnan Kaukalathis sein Angebot 'zeige'n. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "ebnan kaukalathis");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( ROOM+"hafen_storage_e4.lpc");
/*
  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren. ");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen. ");
*/
  AddDetail( ({ "boden" }),
    "Du erkennst einen einfachen steinernen Boden. ");
  AddDetail( ({ "decke" }),
    "Du siehst eine normale hoelzerne Decke. ");
  AddDetail( ({ "waende", "wand", "waenden" }),
    "Die verputzten Waende sind uninteressant und eigentlich auch kaum zu "
	"sehen. Die Regale hingegen sind gefuellt mit allerlei Dingen.");
  AddDetail( ({ "dinge", "angebot", "dingen", "ueberblick", "waren", "sachen" }),
    "Viele Sachen die ein Abenteurer gebrauchen kann sind hier zu finden. "
	"Lass Dir von Ebnan Kaukalathis sein Angebot 'zeige'n. ");
  AddDetail( ({ "stein", "steine" }),
    "Der Boden besteht aus Stein. ");
  AddDetail( ({ "holz" }),
    "Die Decke besteht aus Holz. ");
  AddDetail( ({"laden"}),
    "Dieser einfache Laden besteht aus mehreren, gefuellten Regalen an "
	"den Waenden und einem breiten Tisch hinter dem normalerweise Ebnan "
	"Kaukalathis auf Kundschaft wartet. ");
  AddDetail( ({"regal", "regale", "regalen"}),
    "Die Regale sind mit vielen verschiedensten Dingen beladen. Du kannst "
	"Dir mit 'zeige einen Ueberblick verschaffen. ");
  AddDetail( ({"tisch"}),
    "Hinter dem Tisch steht normalerweise Ebnan Kaukalathis, wenn er "
	"gerade nicht einem Kunden seine Waren zeigt. ");
  AddDetail( ({"kunden", "kundschaft"}),
    "Sobald Du etwas kaufen moechtest, gehoerst Du auch zur Kundschaft.");
  AddDetail( ({"abenteurer", "abenteuern", "abenteuer"}),
    "Wenn man auf gut Glueck durch Andracia reist, muss man schon zu "
	"Abenteuern bereit sein. ");
  AddDetail( ({"glueck"}),
    "Vielleicht hast Du Glueck und Ebnan hat das was Du suchst in seinem Angebot.");
  AddDetail( ({"ebnan", "kaukalathis", "besitzer"}),
    "Ebnan Kaukalathis ist der Besitzer dieses Ladens.");
  AddDetail( ({"andracia", "kontinent"}),
    "Dieser Kontinent heisst Andracia.");
  AddDetail( ({""}),
    "");
	/*
  AddDetail( ({""}),
    "");
*/

  /* Exits */
  AddExit( "norden" , ROOM + "hafen_e3.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "ebnan_kaukalathis.lpc", REFRESH_DESTRUCT );

}

