#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Norden ist das Haus eines Haendlers "+
    "und im Sueden ist eine verkommene Kneipe. " );
  AddDetail( ({ "himmel" }),
    "Die vielen Wolken werden von einer frischen Brise vom Meer "+
    "her ueber das Festland getrieben. Die kalte Luft und die vielen "
	"Wolken lassen darauf schliessen, dass weit draussen eine aufgewuehlte "
	"See herrscht. ");   
  AddDetail( ({"haus"}),
    "Welches Haus willst Du denn Untersuchen? ");
  AddDetail( ({"haendlers", "haendler","laden"}),
    "Geh nach Norden, da kannst Du im Haus des Haendlers einkaufen. " );
  AddDetail( ({"kneipe"}),
    "Geh nach Sueden um Dich in der Kneipe um zu sehen. " );
  AddDetail( ({"sueden"}),
    "Im Sueden befindet sich eine Kneipe, die nicht gerade sehr einladend aussieht.");  
  AddDetail( ({"Norden"}),
    "Im Norden siehst Du einen Laden.");
  
  AddExit( "norden" , ROOM + "hafen_d2.lpc");
  AddExit( "sueden" , ROOM + "hafen_d4.lpc");
  AddExit( "osten" , ROOM + "hafen_e3.lpc");
  AddExit( "westen" , ROOM + "hafen_c3.lpc");
  
  /*Objekte und NPCs*/
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
//  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );

}