#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_LONG, TO->QueryProp( P_INT_LONG ) + 
      "Die Strasse macht hier einen Knick nach Sueden. \n" );
   AddDetail( ({"knick"}),
    "Die Strasse macht hier einen Knick nach Sueden.");
  AddDetail( ({"bloedsinn"}),
    BS("Hier ist eine Scriptfalle."));
  AddSpecialDetail( ({ "scriptfalle" }), "unt_scriptfalle" );

  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
    
  AddExit( "osten" , ROOM + "hafen_h1.lpc");
  AddExit( "sueden" , ROOM + "hafen_g2.lpc");
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 45+random(60), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel, die Deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name(WESSEN)+" Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}