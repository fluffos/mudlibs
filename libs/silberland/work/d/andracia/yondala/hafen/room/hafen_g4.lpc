// Kontor
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Handelskontor" );
  SetProp( P_INT_LONG,
    "Dies ist das Handelskontor von Semkin Baerensen. Hier wird mit allerlei "+
    "exotischen und speziellen Waren gehandelt. Die Schiffe aus Norden "+
    "bringen Felle und Tran, die Schiffe die Waren aus dem Sueden bringen "+
    "haben oft Gewuerze oder Metallwaren geladen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren. ");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen. ");

  AddDetail( ({"boden"}),
    "Ein normaler Boden aus Holzbohlen. In der Mitte des Raums sind die "+
    "grossen Handelswaren gestapelt: Faesser mit Tran, Messingkessel, "+
    "Eisenbarren und mit Salz gefuellte Saecke. ");
  AddDetail( ({"wand", "waende", "waenden"}),
    "Viele Regale wurden an den Waenden aufgestellt. Allerlei exotische "+
    "Fruechte und Gewuerze stehen darauf. ");
  AddDetail( ({"decke"}),
    "Holzbalken tragen die hoelzerne Decke. ");
  AddDetail( ({"tuer", "strasse", "Norden"}),
    "Durch die Tuer im Norden kannst Du wieder hinaus auf die Strasse. ");
  AddDetail( ({"kontor", "handelskontor"}),
    "Du stehst mitten im Kontor von Semkin Baerensen. Tran und Eisen sind seine "+
    "wichtigsten Handelsgueter. ");
  AddDetail( ({"waren", "ware", "handelswaren", "handelsware", "dinge", "handelsgueter"}),
    "Aus vielen Laendern laesst Semkin Baerensen exotische Dinge mitbringen, aber "+
    "meistens sind die Laderaeume seiner Schiffe mit Tran oder Metallwaren "+
    "gefuellt. ");
  AddDetail( ({"schiffe", "schiff"}),
    "Semkin Baerensen ist stolzer Besitzer eine Flotte von 5 Koggen. Geh in den "+
    "Hafen, falls Du Schiffe beobachten willst. ");
  AddDetail( ({"felle"}),
    "Feine und grosse Felle werden hier angeboten. ");
  AddDetail( ({"tran", "fischfett"}),
    "Tran wird vorallem als Lampenoel eingesetzt. ");
  AddDetail( ({"gewuerz", "gewuerze"}),
    "Diese Gewuerze machen jedes Gericht schmackhaft. ");
  AddDetail( ({"metallwaren"}),
    "Toepfe, Pfannen, Kessel und Besteck aus Eisen, Messing und Kupfer "+
    "werden als Metallwaren zusammengefasst. Auch Barren fuer die Schmiede "+
    "werden hier gehandelt. ");
  AddDetail( ({"mitte", "mitten"}),
    "In der Mitte des Raums sind Handelswaren gestapelt: Faesser mit Tran, "+
    "Messingkessel, Eisenbarren und mit Salz gefuellte Saecke.");
  AddDetail( ({"raum", "raums"}),
    "Viele Regale wurden an den Waenden aufgestellt. Allerlei exotische "+
    "Fruechte und Gewuerze stehen darauf. In der Mitte des Raums sind die "+
    "grossen Handelswaren gestapelt: Faesser mit Tran, Messingkessel, "+
    "Eisenbarren und mit Salz gefuellte Saecke. ");
  AddDetail( ({"fass", "faesser" }),
    "Die Faesser sind mit Tran gefuellt. Dieses Fischfett wird vorallem "+
    "fuer Lampenoel oder seife verwendet. ");
  AddDetail( ({"messingkessel", "kessel"}),
    "Grosse dickwandige Kessel stehen hier. Scheinbar eine Bestellung aus "+
    "Zwirbelstein. ");
  AddDetail( ({"eisen", "eisenbarren", "barren"}),
    "Von hier bekommen die Schmieden ihr Eisen. Hier im Huegelland findet "+
    "man kein Erz das sich zu Eisen verarbeiten laesst. Da Semkin Baerensen der einzige "+
    "Haendler hier mit guten Verbindungen zu den Zwergen des Suedens ist, "+
    "wird er auf lange Sicht das Monopol fuer Eisen hier in der Gegend behalten.");
  AddDetail( ({"salz", "saecke", "sack"}),
    "Semkin Baerensen besitzt hier viele Salzgaerten entlang der flachen Kueste. "+
    "Das gewonnene Salz wird von hier nach Norden und Sueden verschifft und "+
    "bildet somit die Handelsgrundlage des Handelskontors.");
  AddDetail( ({"regale", "regal"}),
    "Allerlei exotische Fruechte und Gewuerze stehen darauf. ");
  AddDetail( ({"frucht", "fruechte", "farben", "formen"}),
    "Viele Formen und Farben haben die einzelnen Fruechte. Frag doch "+
    "Semkin Baerensen wie die Fruechte heissen und wie sie schmecken. ");
  AddDetail( ({"holzbohlen", "holzbalken"}),
    "Das Holz sieht nach Buche aus.");
  AddDetail( ({"buche", "holz", "baustoff"}),
    "Der wichtigste Baustoff ist Holz. Hier wurde wohl Buche verwendet. ");
  AddDetail( ({"gericht"}),
    "Geh lieber ins Fischlokal um was zu essen. ");
  AddDetail( ({"toepfe", "pfannen", "besteck"}),
    "Hier kann mann fertige Metallwaren kaufen. ");
  AddDetail( ({"messing", "kupfer", "metalle"}),
    "Eisen, Messing und Kupfer sind Metalle. Man kann diese als Barren "+
    "oder als fertige Metallwaren handeln. ");
  AddDetail( ({"besitzer", "baerensen", "semkin", "haendler"}),
    "Semkin Baerensen ist der Besitzer dieses Kontors.");
  AddDetail( ({"bestellung"}),
    "Du hast nichts bestellt.");
  AddDetail( ({"erz"}),
    "Im Sueden schuerfen die Zwerge nach Erz und verarbeiten es zu Eisenbarren.");
  AddDetail( ({"flotte", "handelsschiffe"}),
    "Semkin Baerensen hat eine ganze Flotte von Handelsschiffen die von hier aus den "+
    "Handel mit Salz nach Norden und Sueden abdecken.");
  AddDetail( ({"fischlokal", "hafen", "gegend", "koggen", "kueste", "salzgaerten", "laderaeume", 
  	           "schmiede", "zwirbelstein", "Sueden", "suedens", "huegelland", "laendern", "hafendorf"}),
    "Das ist nur das Kontor im Hafendorf. Du findest das was du suchst daher sicher nicht hier.");
  AddDetail( ({"zwerge", "zwergen", "monopol", "einzigen"}),
    "Da die Zwerge im Sueden die Einzigen sind die Eisen liefern und Semkin Baerensen den "+
    "Handel mit den Zwergen mit seiner Flotte kontrolliert wird sein Monopol wohl ungebrochen bleiben.");
  AddDetail( ({"sicht", "fenster" }),
    "Es hat hier keine Fenster.");
  AddDetail( ({"verbindungen"}),
    "Semkin Baerensen hat gute verbindungen zu den Zwergen im Sueden.");
  AddDetail( ({"lampenoel", }),
    "Tran wird vorallem zu Lampenoel verarbeitet.");
  AddDetail( ({"handelsgrundlage", "handel"}),
    "Das Salz das hier an der flachen Kueste in den Salzgaerten gewonnen wird, ist die eigentliche "+
    "Handelsgrundlage von Semkin Baerensen.");

/*
  AddDetail( ({""}),
    "");
*/

  AddItem( NPC + "semkin_baerensen.lpc", REFRESH_DESTRUCT );

  /* Exits */
  AddExit( "norden" , ROOM + "hafen_g3.lpc");
  
 
}