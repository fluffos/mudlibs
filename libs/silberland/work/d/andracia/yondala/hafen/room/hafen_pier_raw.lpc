#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Pier des Hafendorfs" );
  SetProp( P_INT_LONG,
     "Du befindest Dich auf dem Pier an dem die Schiffe anlegen. Im "
	 "Hafen liegen hauptsaechlich Fischkutter und Handelsschiffe vor "
	 "Anker, allerdings kann man hier auch des Oefteren grosse "
	 "Kriegsschiffe bewundern. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    "Das Pfeifen des Windes und die Geraeusche des Treibens am Hafen "
	"vermischen sich hier. Das Geschrei der Hafenarbeiter und Fischer "
	"liefert die typische Geraeuschkulisse. ");
  AddSound( ({ "wind", "pfeifen", "brise" }),
    "Die steife Brise streicht duch den Hafen und erzeugt dieses Geraeusch. ");
  AddSound( ({ "wellen", "welle", "schlagen" }),
    "Das Wasser schlaegt gegen den Pier. Dadurch entsteht dieses Geraeusch. ");
  AddSound( ({ "geraeusche", "geraeusch", "geraeuschkulisse", "geschrei", 
               "hafenarbeiter", "fischer", "treiben" }),
    "See und Hafen erzeugen eine Vielzahl an Geraeuschen. ");
 AddSound( ({ "vielzahl" }),
    "Unzaehlbar viele. ");
 
  AddSmell( DEFAULT_SMELL,
    "Der typische Geruch von Salzwasser dringt in deine Nase, getruebt "+
    "durch den Geruch des brackigen Wassers und feilgebotenen Fischen. ");
  AddSmell( ({ "wasser", "salzwasser", "brise", "meer", "see", "frische", 
               "frisch", "wind" }),
    "Salzig schmeckt der Wind, der Dir um die Nase weht. ");
  
  AddSmell( ({ "salz" }),
    "Salz riecht... salzig. ");
  AddSmell( ({ "geruch", "hafen", "brackwasser", "hafenbecken", "fische", 
               "fisch", "brackwassergeruch" }),
    "Der unangenehme Geruch von Fisch und Brackwasser herrscht hier. ");

  AddDetail( ({ "boden" }),
    "Der gemauerte Pier begrenzt das Hafenbecken. In gewissen Abstaenden "+
    "befinden sich Pfaehle, an denen die Schiffe festmachen koennen. ");
  AddDetail( ({ "himmel" }),
    "Die vielen Wolken werden von einer frischen Brise vom Meer her ueber "
	"das Festland getrieben. Die kalte Luft und die vielen Wolken lassen "+
    "darauf schliessen dass, weit draussen eine aufgewuehlte See herrscht. "
	"Hier im Hafen sind die Wellen jedoch nur klein. ");
  AddDetail( ({ "mole", "huegel", "wall" }),
    "Die als Mole aufgeschichteten Felsen liefern einen guten Wall gegen "
	"die Wellen. Das Hafenbecken ist dadurch ruhig und nur die steife "
	"Brise erzeugt kleinere Wellen die sanft gegen den Pier schwappen. ");
  AddDetail( ({ "hafen", "schutz" }),
    "Das Wasser ist relativ ruhig im Hafen, riecht aber etwas brackig. "
	"Viele Schiffe suchen hier Schutz vor den Gewalten der offenen See. ");
  AddDetail( ({ "fischkutter", "kutter" }),
    "Die meisten der hier vor Anker liegenden Schiffe sind Fischkutter. "
	"Mit Netzen fangen diese viele Fische und versorgen damit die ganze "
	"Kuestenregion. ");
  AddDetail( ({ "handelsschiffe", "handelsschiff" }),
    "Neben Fisch werden in diesem Hafen viele andere Gueter umgeschlagen. "
	"Taeglich kommen Handelsschiffe und bringen Gewuerze, Metalle und "
	"andere Dinge, die man hier nicht herstellt oder anbauen kann. ");
  AddDetail( ({ "anker" }),
    "Ein Anker dient dazu ein Schiff festzuhalten damit es nicht abtreibt. "
	"Der eiserne Haken am Ende der Kette graebt sich in den Untergrund "
	"des Hafens und verhindert so, dass Schiffe aufeinander prallen. ");
  AddDetail( ({ "kriegsschiffe", "kriegsschiff" }),
    "Die bewehrten Kriegsschiffe sind mit vielen Kaempfern besetzt und "
	"sollen den Piraten den Garaus machen. ");
  AddDetail( ({ "schiffe", "schiff" }),
    "Fischkutter und Handelsschiffe kann man erkennen. Hin und wieder "
	"legen hier aber auch Kriegsschiffe an. ");
  AddDetail( ({ "steine", "stein", "pier" }),
    "Der gemauerte Pier begrenzt das Hafenbecken. In gewissen Abstaenden "
	"sind dort Pfaehle, an denen die Schiffe festmachen koennen. ");
  AddDetail( ({ "wasser", "see", "meer", "salzwasser" }),
    "Das Wasser der See brandet gegen die Mole. ");
  AddDetail( ({ "wellen", "welle", "gewalten" }),
    "Die Wellen die gegen den Pier schlagen sind klein. ");
  AddDetail( ({ "hafenbecken", "becken" }),
    "Die Wasseroberflaeche des Hafenbeckens wirkt nur durch die steife "
	"Brise, die kleine Wellen erzeugt, unruhig. Das Wasser riecht aber "
	"etwas brackig. ");
  AddDetail( ({ "wolken", "wolke" }),
    "Die steife Brise treibt die Wolken von der See auf das Land. ");
  AddDetail( ({ "brise", "luft", "wind" }),
    "Ein etwas starker Wind aus Westen treibt die Wolken vor sich her und "
	"erzeugt kleine Wellen in dem ansonsten ruhigen Hafenbecken.");
  AddDetail( ({ "festland", "land", "region", "kueste", "kuestenregion"}),
    "Das Land im Osten und die umliegenden Kuestengebiete werden von hier "
	"aus mit Fischen versorgt. ");
  AddDetail( ({ "hafenarbeiter", "fischer", "publikum" }),
    "Hafenarbeiter und Fischer bilden das vorherrschende Publikum des Hafens. ");
  AddDetail( ({ "pfeifen", "schlagen", "treiben", "vorgaenge" }),
    "Untersuche lieber Dinge statt Vorgaenge.");
  AddDetail( ({ "brackwasser" }),
    "Das Wasser des Hafenbeckens steht nur, daher bleibt der Dreck im "+
    "Hafenbecken zurueck. So entsteht der typische Brackwassergeruch. ");
  AddDetail( ({ "glueck", "gluecksspiele", "spiele" }),
    "Spiele Gluecksspiele um Dein Glueck herauszufordern. ");
  AddDetail( ({ "nase" }),
    "Das ist deine Nase, dreh sie in den Wind und rieche! ");
  AddDetail( ({ "gewuerze", "metalle", "dinge", "gueter" }),
    "Viele Dinge bringen die Handelsschiffe, schau doch bei den Haendlern "
	"oder im Kontor nach, was hier so alles angeboten wird. ");
  AddDetail( ({ "untergrund" }),
    "Das Wasser ist zu truebe um den Untergrund zu erkennen. ");
  AddDetail( ({ "haken", "kette" }),
    "Die Anker haengen an einer Kette und werden abgelassen, wenn man im "
	"Hafen anlegt. ");
  AddDetail( ({ "kaempfer" }),
    "Kriegsschiffe haben viele Kaempfer an Bord. ");
  AddDetail( ({ "pirat", "piraten" }),
    "Zum Glueck sind gerade keine hier. ");
  AddDetail( ({ "wasseroberflaeche" }),
    "Die Wasseroberflaeche ist von vielen kleinen Wellen gekraeuselt. Die "
	"kalte Luft und die vielen Wolken lassen darauf schliessen dass weit "
	"draussen eine aufgewuehlte See herrscht. ");
  AddDetail( ({ "dreck" }),
    "Im Wasser des Hafenbecken ist allerlei Dreck der den typisch "
	"brackigen Geruch erzeugt. Nur selten treibt der Wind das dreckige "
	"Wasser auf die See hinaus. ");
  AddDetail( ({ "pfahl", "pfaehle" }),
    "An den Pfaehlen koennen die Schiffe festmachen. ");
  AddDetail( ({ "felsen", "fels" }),
    "Du musst auf die Mole selbst gehen um die Felsen zu untersuchen. ");
  AddDetail( ({"abstaende"}),
    "Alle paar Schritte ist ein Pfahl. ");
  AddDetail( ({"schritte"}),
    "Willst Du die Abstaende abschreiten?");
  AddDetail( ({"bord"}),
    "Dazu sollte man auf einem Schiff sein.");
  AddDetail( ({"garaus", "prozess"}),
    "Mit Piraten wird kurzer Prozess gemacht.");
  AddDetail( ({"kontor"}),
    "Das Kontor befindet sich etwas die Strasse hinauf.");
  AddDetail( ({"kuestengebiete", "kuestengebiet", "gebiete", "gebiet" }),
    "Diese Kuestengebiet ist der westlichste Teil des Huegellands. "+
    "Westlich von hier liegt nur noch das Meer.");
  AddDetail( ({"netz", "netze"}),
    "Damit werden Fische gefangen.");
  AddDetail( ({"fische"}),
    "Mit Netzen faengt man Fische.");
  AddDetail( ({"strasse"}),
    "Die Strasse fuehrt durch das Hafendorf bis nach Zwirbelstein.");
  AddDetail( ({"zwirbelstein"}),
    "Dazu musst Du erst der Strasse entlang wandern.");
  AddDetail( ({"hafendorf", "dorf", "haeuser"}),
    "Die Haeuser hier bilden ein Hafendorf.");
  AddDetail( ({"huegelland"}),
    "Oestlich des Hafens beginnt das Huegelland.");  
  AddDetail( ({"teil"}),
    "Der Hafen gehoert zum Huegelland.");
  AddDetail( ({"ende"}),
    "Dort, wo sie aufhoert.");
  AddDetail( ({"haendler"}),
    "Fleissige Haendler verkaufen die Ware, die hier im Hafen ankommt.");
  AddDetail( ({"ware","waren"}),
    "Waren jeglicher Art werden hier verschifft.");
  AddDetail( ({"art"}),
    "Schau Dich doch mal bei den Haendlern um.");
  AddDetail( ({"oefteren"}),
    "Es kommt oefter vor, als man meint.");

/*
  AddDetail( ({""}),
    ""));
*/
  AddCmd( ({"schreite"}), "cmd_abschreiten" );
}

//Gibt je nach Koerpergroesse ein unterschiedliches Ergebnis
int cmd_abschreiten(string str)
{
   float schritte;
    float schrittgroesse;
	notify_fail("Was willst Du abschreiten?\n");
	/*
	Abstand=300cm 
	1 Schritt bei 2m Koerpergroesse = 100 cm
	
	S=K/2
	schritte=300/S
	*/
	
	if( str!="abstaende ab" && str!="abstand ab" && str!="pfaehle ab" && str!="pier ab") return 0;
	schrittgroesse=TP->QueryProp(P_SIZE);
	schrittgroesse=schrittgroesse/2;
	schritte=300/schrittgroesse;
	
	write("Du schreitest die Abstaende ab und kommst zu dem Ergebnis, "+
	      "dass alle "+to_string(schritte)+" Schritte ein Pfahl steht.\n");
	say( TP->name()+" schreitet den Pier entlang.\n",TP);
	return 1;	
}