inherit "std/pub.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Fischlokal" );
  SetProp( P_INT_LONG,
     "Du bist im Fischlokal am Hafen. Hier kannst Du einigermassen "+
     "gepflegt die frisch gefangenen Fische essen. Auch bietet der Wirt "+
     "importierten Wein und Bier an.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "lares peutler");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Lares Peutler");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddSound( DEFAULT_SOUND,
    "Verhaltenes Gemurmel und Klappern der Bestecke erzeugt eine "+
    "angenehme Stimmung hier.");
  AddSound( ({"gemurmel", "klappern", "stimmung" }),
    "Hier ist alles schoen ruhig und die Gaeste sind in ihr Mahl vertieft.");
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von geduenstetem Fisch dringt aus der Kueche und "+
    "erfuellt den Raum. ");
  AddSmell( ({"geruch", "fisch"}),
    "Welchen Geruch hast Du denn in einem Fischlokal erwartet?");
  AddSmell( ({"kueche"}),
    "Ein koestlicher Geruch stroemt aus der Kueche. Vielleicht solltest "
	"Du auch etwas bestellen?");
  AddSmell( ({"lokal", "fischlokal"}),
    "Es riecht hier nach koestlich frisch gebratenem Fisch.");

  AddDetail( ({ "boden", "holzboden", "holzbalken" }),
    "Die Holzbalken, die den Boden bilden, sind sauber gewischt.");
  AddDetail( ({ "decke" }),
    "Die Decke wurde mit einem Fischernetz geschmueckt. Seesterne, "+
    "Korallen, Muscheln und ausgestopfte Fische haengen darin. ");
  AddDetail( ({ "waende", "wand" }),
    "Ein Steuerrad, Regale mit Flaschenschiffen und Knotenbretter "+
    "zieren die weiss verputzten Waende. Fenster in Form von runden "+
    "Bullaugen lassen das Licht herein. ");
  AddDetail( ({ "lokal", "restaurant", "pub", "raum", "innere", "fischlokal" }),
    "Dies ist das Fischlokal wo Reeder und Haendler einigermassen "+
    "gepflegt ihre Mahlzeiten einnehmen. ");
  AddDetail( ({ "reeder", "haendler","gaeste" }),
    "Die meisten Gaeste hier sehen ein bisschen wohlhabender aus als "
    "normale Matrosen und Hafenarbeiter.");
  AddDetail( ({ "matrosen","hafenarbeiter", "matrose" }),
    "Die sind hier normalerweise eher seltene Gaeste.");
  AddDetail( ({ "regale","regal" }),
    "In den hoelzernen Regalen stehen unterschiedlich grossen "
	"Flaschenschiffe und einige Knotenbretter.");
	
	 
	
	
  AddDetail( ({ "fisch", "fische", "mahlzeiten" }),
    "Lass Dir doch das 'menue' zeigen und waehle was Du essen "+
    "moechtest. ");
  AddDetail( ({ "wein", "bier" }),
    "Lass Dir doch das 'menue' zeigen und waehle was Du zu deinem Essen "+
    "trinken moechtest. ");
  AddDetail( ({ "holz", "fugen" }),
    "Der Holzboden ist sauber und die Fugen sind besonders klein. ");
  AddDetail( ({ "fischernetz", "netz", "seesterne", "korallen", "muscheln" }),
    "Das ist als Dekoration an der Decke angebracht. ");
  AddDetail( ({ "steuerrad","rad"}),
    "Das Steuerrad ist fest an der Wand angebracht. Es sieht recht alt "
	"aus und war frueher bestimmt echt in Betrieb." );
  AddDetail( ({ "betrieb"}),
    "Das ist lange her, heute kann man es nicht mal mehr drehen, so fest "
	"ist es an der Wand montiert." );
  AddDetail( ({ "knotenbrett", "knotenbretter", "seil" }),
    "Die kleinen Stuecke Seil darauf zeigen wie man den jeweiligen "+
    "Knoten macht. Jeder Matrose muss das auswendig koennen. ");
  AddDetail( ({ "stuecke", "stueck" }),
    "Um einen Knoten zu zeigen reicht ein Stueck von einem Seil, man "
	"braucht kein ganzes dafuer.");

	AddDetail( ({ "flaschenschiff", "flaschenschiffe", "modelle", "modell", "flasche" }),
    "Diese kleinen Modelle beruehmter Schiffe wurden in einer Flasche "+
    "zusammengebaut. Fuer solch eine Arbeit benoetigt man eine besondere "+
    "Fingerfertigkeit. ");
  AddDetail( ({ "fenster", "bullaugen", "form", "licht" }),
    "Durch die runden Fenster, die Bullaugen nachempfunden sind, dringt "+
    "das Licht ins Innere des Lokals. ");
  AddDetail( ({ "besteck", "bestecke", "praegung", "messingbesteck" }),
    "Das Messingbesteck hat eine kleine Praegung mit dem Namen des "+
    "Lokals. Es zu stehlen hat also keinen Sinn. ");
  AddDetail( ({ "name","namen" }),
    "\"Zum froehlichen Hai\"");
  AddDetail( ({ "hai" }),
    "Hier ist keiner, das Lokal heisst so. ");

  AddDetail( ({ "kueche" }),
    "Der Geruch von geduenstetem Fisch dringt von dort ins Lokal. ");
  AddDetail( ({ "schiff", "schiffe", "hafen" }),
    "Die richtigen Schiffe kannst Du unten im Hafen sehen. ");
  AddDetail( ({"arbeit", "tellerwaescher"}),
    "Vielleicht benoetigt der Wirt noch einen Tellerwaescher?");
  AddDetail( ({"dekoration"}),
    "Die Decke wurde mit einem Fischernetz geschmueckt. Seesterne, "+
    "Korallen, Muscheln und ausgestopfte Fische haengen darin. "+
    "Ein Steuerrad, Regale mit Flaschenschiffen und Knotenbretter "+
    "zieren die weiss verputzten Waende. Fenster in Form von runden "+
    "Bullaugen lassen das Licht herein. ");
  AddDetail( ({"getraenke", "trinken", "essen", "mahl"}),
    "Schau doch einfach per 'menue' was hier angeboten wird.");
  AddDetail( ({"wirt", "bestellungen"}),
    "Normalerweise ist ein Wirt da und nimmt die Bestellungen auf.");
  AddSpecialDetail( ({"fingerfertigkeit"}), "unt_ff");
  AddDetail( ({"stimmung"}),
    "Hier ist alles schoen ruhig und die Gaeste sind in ihr Mahl vertieft.");
  AddDetail( ({"gaeste", "reisende", "abenteurer"}),
    "Haendler, Reisende und Abenteurer wie Du sitzen an den Tischen und lassen es sich schmecken.");
  AddDetail( ({"knoten"}),
    "Wenn man zur See fehren will, muss man lernen solche Knoten zu knuepfen.");
  AddDetail( ({"sinn", "sein"}),
    "Sein oder nicht Sein ...");
  AddDetail( ({"see", "meer"}),
    "Das Meer nennt man auch die See.");
  AddDetail( ({"tische"}),
    "Leider sind alle Tische besetzt.");

/*
  AddDetail( ({""}),
    "");
*/
   
  /* Menue */
  AddFood("Zander", "zander", 175, 0, 25, "eat_zander" );
//         ({ "Du verschlingst den saftigen Fisch.",
//            "&& verschlingt einen Fisch." }) );
  AddFood("Haibutt", ({"hai", "butt", "haibutt"}), 150, 0, 20, "eat_haibutt" );
//         ({ "Du verschlingst den saftigen Fisch.",
//            "&& verschlingt einen Fisch." }) );
  AddFood("Thunfisch", ({"thunfisch", "fisch"}), 115, 0, 15, "eat_thunfisch" );
//         ({ "Du verschlingst den saftigen Fisch.",
//            "&& verschlingt einen Fisch." }) );
  AddFood("Brot", "brot", 60, 11, 5,
         ({ "Du isst ein Brot.",
            "&& isst ein Brot." }) );
  AddDrink("Weisswein", "weisswein", 90, 18, 4, 6,
         ({ "Du trinkst einen guten Schluck Weisswein.",
            "&& trinkt einen guten Schluck Weisswein." }) );
  AddDrink("Rotwein", ({"rotwein", "wein"}), 90, 18, 4, 6,
         ({ "Du trinkst einen guten Schluck Rotwein.",
            "&& trinkt einen guten Schluck Rotwein." }) );

  /* Exits */
  AddExit( "sueden" , ROOM + "hafen_e3");

  /*Objekte und NPCs*/
  AddItem( NPC + "lares_peutler", REFRESH_DESTRUCT );
  //RemoveItem( "/obj/topliste" );

}

string unt_ff()
{
	int sp_dex;
	sp_dex=TP->QueryProp(P_ATTRIBUTES)[A_DEX];
	if( sp_dex < 2 ) return "Du bist ein Tollpatsch!\n";
	else if( sp_dex < 4 ) return "Du bist ungeschickt!\n";
	else if( sp_dex < 6 ) return "Du bist kein Tollpatsch.\n";
	else if( sp_dex < 8 ) return "Du kommst ganz gut zurecht!\n";
	else if( sp_dex < 12 ) return "Du kannst eine Waffe fuehren ohne dich zu verletzen. \n";
	else if( sp_dex < 18 ) return "Du schaffst es deine Waffe hochzuwerfen und sicher wieder aufzufangen.\n";
  else if( sp_dex < 24 ) return "Dir ist es ein leichtes eine Muenze zwischen den Fingern tanzen zu lassen.\n";
	else return "Komplizierte Bewegungsablaeufe sind kein Problem fuer dich.\n";
}

void eat_zander(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    // esser->AddPoison(1); //keine Vergiftung
    esser->eat_food(-25,0); //nimmt das Essen wieder raus
    tell_object(esser, 
      BS("Der Fisch wird serviert aber als die toten Glubschaugen des Fischs dich anschauen hast Du keinen Apetitt mehr.") );
    tell_room(this_object(),
      esser->name(WER)+" will seinen Fisch nicht essen.",({ esser }) );       
  }
  else
  {
    esser->AddMp(40);
    esser->AddHp(40);   
    tell_object( esser, BS(
      "Du verschlingst den saftigen Fisch.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verschlingt einen Fisch."),({ esser }) );
  }
}
