inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Seilerei" );
  SetProp( P_INT_LONG,
    "Dies ist die Seilerei. Die Schiffe, die hier festmachen, brauchen "+
     "staendig neue Seile und Taue. Hier werden die Seile gedreht und "+
     "geflochten, sowie anschliessend verkauft. Falls Du Seile brauchst, "+
     "so ist hier der richtige Platz. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "okenheld");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( ROOM+"hafen_storage_f2.lpc");
/*  AddSound( DEFAULT_SOUND,
    "Du hoerst nichts besonderes. "));
  AddSmell( DEFAULT_SMELL,
    "Du riechst nichts besonderes. "));*/

  AddDetail( ({ "boden" }),
    "Der steinerne Boden scheint abgewetzt von den vielen Seilrollen "+
    "die hier staendig hergestellt und genausoschnell von den Reedern "+
    "aufgekauft werden. ");
  AddDetail( ({ "decke", "holzdecke" }),
    "Du siehst eine schmucklose Holzdecke. ");
  AddDetail( ({ "waende", "wand" }),
    "An den Waenden sind Regale angebracht auf denen Seilrollen in "+
    "allen Groessen liegen. ");
  AddDetail( ({ "schiff", "schiffe", "schiffen" }),
    "Die Schiffe, die hier festmachen, benoetigen staendig neue Seile. ");
  AddDetail( ({ "seil", "seile", "tau", "taue" }),
    "Hier kannst Du Seile und Taue kaufen. ");
  AddDetail( ({ "raum", "haus", "platz", "seilerei" }),
    "Dies ist die Seilerei. Die Schiffe, die hier festmachen, brauchen "+
    "staendig neue Seile und Taue. Hier werden die Seile gedreht und "+
    "geflochten, sowie anschliessend verkauft. Falls Du Seile brauchst, "+
    "so ist hier der richtige Platz. ");
  AddDetail( ({ "seilrollen", "seilrolle" }),
    "Die geflochtenen und gedrehten Seile werden aufgerollt und liegen "+
    "so in den Regalen zum Verkauf. ");
  AddDetail( ({ "reeder", "reedern" }),
    "Die Reeder benoetigen fuer ihre Schiffe staendig neue Seile. ");
  AddDetail( ({ "regal", "regale" }),
    "Auf den breiten Regalen liegen die aufgerollten Seile. ");
  AddDetail( ({ "groesse", "groessen" }),
    "Alle Groessen von Seilen kann man hier bekommen. Die besonders "+
    "starken Seilstraenge nennt man Taue. ");
  AddDetail( ({"seilstraenge"}),
    "Diese dicken Taue werden wohl nur auf Schiffen verwendet");
  AddDetail( ({"verkauf"}),
    "Hier werden Seile verkauft.");

  /* Exits */
  AddExit( "sueden" , ROOM + "hafen_f3.lpc");
/*
  AddDetail( ({""}),
    "");
*/

  /*Objekte und NPCs*/
  AddItem( NPC + "yann_okenheld.lpc", REFRESH_DESTRUCT );

}

// Seilkauf muss noch zugefügt werden.