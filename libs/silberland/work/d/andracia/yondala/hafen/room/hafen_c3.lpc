#include "../def.h"
inherit ROOM + "hafen_pier_raw.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
	"Eine breite Rampe unterbricht hier den Pier. \n" );
    
  AddDetail( ({"rampe"}),
    "Die Rampe fuehrt in einem flachen Winkel ins Wasser. \n");
  AddDetail( ({"winkel"}),
    "Warscheinlich wurde die Rampe in diesem Winkel angelegt, um "+
    "neue Schiffe leicht zu Wasser lassen zu koennen. " );
   
/*  AddItem( OBJ+"handelsschiff.lpc", REFRESH_NONE, 1 );
  AddItem( OBJ+"santa_marion.lpc", REFRESH_NONE, 1 );
  AddItem( OBJ+"infotafel.lpc", REFRESH_REMOVE );*/

  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );
  	    
  AddExit( "norden" , ROOM + "hafen_c2.lpc");
  AddExit( "osten" , ROOM + "hafen_d3.lpc");
  AddExit( "sueden" , ROOM + "hafen_c4.lpc");
}