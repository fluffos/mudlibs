#include "../def.h"

inherit ROOM + "hafen_pier_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, TO->QueryProp( P_INT_LONG ) + 
    "Nach Sueden hin beginnen hier ausgedehnte Salzgaerten. \n" );
  
  AddDetail( ({"salzgarten", "salzgaerten"}), 
    "In den einzelnen Becken steht das Wasser und verdunstet langsam und "
	"hinterlaesst das Salz.");
  AddDetail( ({"becken"}), 
    "Noch ist in allen Becken Wasser und das Salz kann nicht abgeerntet "
	"werden.");
  AddDetail( ({"salz", "gut","handelsgut"}), 
    "Salz ist ein wertvolles Handelsgut.");
  AddDetail( ({"sueden"}), 
    "Dort erstrecken sich Salzgaerten soweit Du gucken kannst.");
	
    
  AddExit( "norden" , ROOM + "hafen_c3.lpc");
  
  /*Objekte und NPCs*/
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );

  //AddCmd( ({"betrete", "betritt"}), "cmd_salzgaerten" );
}  