#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Werfthalle" );
  SetProp( P_INT_LONG,
     "Du stehst hier in der Werfthalle. Ein Gerippe aus Holz steht hier und "+
     "soll ein Schiff werden. An den Waenden sind Werkzeuge und Schablonen fuer "+
     "den Schiffsbau an Haken aufgehaengt. Holzspaene und Teerflecken zieren den "+
     "Boden. Die hohe Decke bietet genuegend Platz fuer die hohen Schiffsruempfe. "+
     "Im Westen ist ein grosses Fluegeltor, durch das fertige Schiffe auf die "+
     "Strasse hinausgerollt werden kann. Im Osten fuehrt eine Tuer in angrenzende "+
     "Raeume. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Die Arbeiter hier haemmern und saegen. Diese Arbeitsgeraeusche erfuellen "+
    "die ganze Halle. " );
  AddSound( ({ "haemmern", "saegen", "arbeit", "arbeitsgeraeusche", "arbeitsgeraeusch" }),
    "Nicht besonders leise hier. ");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Teer und Holz. ");
  AddSmell( ({ "teer", "teergeruch" }),
    "Nur wenig Teergeruch haengt in der Luft. Fuer die Behandlung mit Teer ist der "+
    "aktuelle Schiffsbau noch nicht bereit. ");
  AddSmell( ({ "holz" }),
    "Der Geruch von frischem Holz erfuellt die Halle. ");
  AddSmell( ({ "geruch" }),
    "Hier riecht es vorallem nach Holz, aber auch ein bischen nach Teer. ");

  AddDetail( ({ "werft", "halle", "werfthalle" }),
    "Du stehst hier in der Werfthalle. Ein Gerippe aus Holz steht hier und "+
    "soll ein Schiff werden. An den Waenden sind Werkzeuge und Schablonen fuer "+
    "den Schiffsbau an Haken aufgehaengt. Holzspaene und Teerflecken zieren den "+
    "Boden. Die hohe Decke bietet genuegend Platz fuer die hohen Schiffsruempfe. "+
    "Im Westen ist ein grosses Fluegeltor, durch das fertige Schiffe auf die "+
    "Strasse hinausgerollt werden kann. Im Osten fuehrt eine Tuer in angrenzende "+
    "Raeume. ");
  AddDetail( ({ "gerippe", "schiffsrumpf", "schiffsruempfe", "grundlage", "rumpf", "ruempfe" }),
    "Das Gerippe der Spanten dient als Grundlage fuer einen Schiffsrumpf.");
  AddDetail( ({ "holz", "baustoff" }),
    "Wichtigster Baustoff ist Holz. Nicht nur die Schiffe sind daraus gemacht, "+
    "auch die Decke wird von Holzbalken getragen. ");
  AddDetail( ({ "schiffe", "schiff" }),
    "Hier werden Schiffe gebaut. Selbst hohe Schiffsruempfe passen hier in diese "+
    "Werfthalle. Erst draussen wird dann der Mast montiert. ");
  AddDetail( ({ "werkzeug", "werkzeuge", "handwerkszeug", "hobel", "saege", "saegen" }),
    "Hobel, Saegen und vieles mehr brauchen die Arbeiter um ein Schiff hier in "+
    "der Werfthalle zu bauen.");
  AddDetail( ({ "schablone", "schablonen" }),
    "Jeder Schiffsrumpf wird zuerst aus vielen verschiedenen Spanten gebildet. "+
    "Die Schablonen dienen dazu die einzelnen Spanten anzupassen, damit der "+
    "Schiffsrumpf besonders gut im Wasser liegt. Flussschiffe benoetigen einen "+
    "anderen Rumpf als Schiffe fuer die offene See. Fuer jeden Schiffstyp sind "+
    "hier in der Werft Schablonen fuer jeden einzelnen Spanten vorhanden. ");
  AddDetail( ({ "haken" }),
    "An den Waenden sind viele Haken angebracht. Werkzeug und Schablonen "+
    "haengen daran bereit fuer die Arbeiter. ");
  AddDetail( ({ "schiffsbau", "arbeit", "aufbau" }),
    "Die Zimmerleute die hier im Schiffsbau arbeiten, haemmern und saegen "+
    "in dieser Halle tagein tagaus, denn neue Schiffe werden staendig gebraucht. ");
  AddDetail( ({ "holzspaene", "holzspan", "span", "spaene" }),
    "Wo gehobelt wird fallen Spaene. Hier wird kraeftig gearbeitet. ");
  AddDetail( ({ "teerflecken", "teerfleck", "tropfen" }),
    "Ein fertiger Rumpf wird immer mit Teer abgedichtet. Dass da mal der eine oder "+
    "andere Tropfen Teer den Boden trifft, ist wohl selbstverstaendlich. ");
  AddDetail( ({ "platz" }),
    "Diese Halle bietet genuegend Platz fuer einen hohen Schiffsrumpf. ");
  AddDetail( ({ "westen", "fluegeltor", "tor", "strasse" }),
    "Durch das grosse Fluegeltor im Westen kann man das fertige Schiff nach draussen "+
    "auf die Strasse und runter zum Hafen bringen. ");
  AddDetail( ({ "osten", /*"tuer",*/ "raeume", "raum" }),
    "Eine Tuer im Osten fuehrt in angrenzende Raeume. ");
  AddDetail( ({ "teer" }),
    "Teer wird verwendet um fertige Schiffsruempfe abzudichten. ");
  AddDetail( ({ "holzbalken", "balken" }),
    "Schwere Holzbalken tragen die Decke dieser Halle. ");
  AddDetail( ({ "schiffszimmerleute", "schiffzimmermann", "zimmerleute", "zimmermann" }),
    "Die Arbeiter hier sind alles Zimmerleute die mit Holz umzugehen wissen. ");
  AddDetail( ({ "spanten" }),
    "Die Grundlage jedes Schiffsrumpf ist das Gerippe aus Spanten an denen die "+
    "Planken der Bordwand befestigt werden. Man braucht viele verschiedene Spanten "+
    "und entsprechend viele Schablonen fuer einen bestimmten Typ an Schiffsrumpf. ");
  AddDetail( ({ "arbeiter" }),
    "Alle Arbeiter hier sind Zimmerleute. ");
  AddDetail( ({ "arbeitsgeraeusch", "arbeitsgeraeusche" }),
    "Die Arbeiter haemmern und saegen. Spanten fuer Spanten entsteht hier ein Schiff. ");
  AddDetail( ({ "mast", "masten" }),
    "Wenn der Schiffsrumpf fertig ist, wird ausserhalb der Halle dann der Mast "+
    "montiert. Nur bei kleinen Schiffen kann man das in der Halle erledigen. ");
  AddDetail( ({ "flussschiffe", "flussschiff" }),
    "Flussschiffe haben im Gegensatz zu seetauglichen Schiffe, einen besonders "+
    "flachen Rumpf. ");
  AddDetail( ({ "typ", "typen" }),
    "Man unterscheidet Schiffe in Flussschiffe und seetaugliche Schiffe. Allein "+
    "schon am Rumpf kann man Flussschiffe erkennen. ");
  AddDetail( ({ "boden" }),
    "Teerflecken und Holzspaene beschmutzen den Boden. Man kann daran erkennen, "+
    "dass die Arbeit hier in der Werft staendig vorrangetrieben wird. ");
  AddDetail( ({ "decke" }),
    "Die hohe Decke wird von schweren Holzbalken getragen. Sie bietet genuegend "+
    "Platz auch fuer besonders hohe Schiffsruempfe. ");
  AddDetail( ({ "waende", "wand" }),
    "An den Waenden sind viele Haken an denen das Handwerkszeug der "+
    "Schiffszimmerleute haengt. Schablonen fuer die Spanten, Hobel und Saegen, "+
    "all das brauchen die Arbeiter um das Schiff fertigzustellen. ");
  AddDetail( ({"planken"}),
    "Diese Planken benoetigt man zum Schiffsbau.");
  AddDetail( ({"schiffstyp"}),
    "Der Schiffstyp der hier gerade im Aufbau ist, scheint ein seetaugliches Schiff zu sein.");
  AddDetail( ({"bordwand", "bordwaende"}),
    "Die Planken werden zurechtgebogen und bilden die Bordwand.");
  AddDetail( ({"behandlung"}),
    "Die Bordwaende werden sobald sie fertig sind mit Teer behandelt. Erst dadurch wird das Schiff "+
    "wasserdicht und seetauglich.");
  AddDetail( ({"gegensatz", "unterschied"}),
    "Der Unterschied ist gut am Rumpf zu erkennen.");
  AddDetail( ({"hafen", "wasser", "see", "hafenbecken"}),
    "Geh doch dazu zum Hafenbecken.");
  AddDetail( ({"luft"}),
    "Mit riechen kommt man hier besser zurecht.");

/*
  AddDetail( ({""}),
    "");
*/

  /* Exits */
  AddExit( "westen" , ROOM + "hafen_g3.lpc");
  //AddExit( "osten" , ROOM + "hafen_i3.lpc");
  AddDetail( ({"tuer"}),
    BS("Die Tuer ist verriegelt."));

  /*Objekte und NPCs*/
  AddItem( NPC + "zimmermann.lpc", REFRESH_DESTRUCT );
//  AddItem( NPC + "zimmermann.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "storko_horigan.lpc", REFRESH_DESTRUCT );
  
}

