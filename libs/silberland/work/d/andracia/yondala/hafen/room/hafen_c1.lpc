#include "../def.h"

inherit ROOM + "hafen_pier_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Oestlich von hier befindet sich "+
   "die Hafenmeisterei. Das ist das noerdliche Ende des Pier. ") );
  
  AddDetail( ({"hafenmeisterei", "hafenmeister"}),
    "Dazu musst Du nach Osten gehen. " );
  
  AddExit( "osten" , ROOM + "hafen_d1.lpc");
  AddExit( "sueden" , ROOM + "hafen_c2.lpc");
  AddExit( "westen" , ROOM + "hafen_b1.lpc");
  
  /*Objekte und NPCs*/
 // AddItem( NPC + "lausebengel.lpc", REFRESH_DESTRUCT );
 // AddItem( NPC + "seebaer.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "matrose.lpc", REFRESH_DESTRUCT );



}