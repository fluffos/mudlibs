inherit "std/store.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

reset() {
  ::reset();
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1); 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:14]));
  SetProp( P_INT_SHORT, "Dies ist das Lager von Trolske Sendason's Laden" ); 
  SetProp( P_INT_LONG,  "Dies ist das Lager von Trolske Sendason's Laden. \n"
  "Hier verstaut er all sein eingekauftes Zeug." );
 
  // AddItem( "file", refresh, Props);
  AddItem( "/obj/fackel.lpc", REFRESH_REMOVE );
  AddItem( "/obj/fackel.lpc", REFRESH_REMOVE );
  AddItem( "/obj/fackel.lpc", REFRESH_REMOVE );  
  AddItem( "/obj/stempel.lpc", REFRESH_REMOVE );
  AddItem( "/obj/seil.lpc", REFRESH_REMOVE );
  AddItem( "/p/weapon/spear/angel.lpc", REFRESH_REMOVE );
  AddItem( "/obj/boerse.lpc", REFRESH_REMOVE ); 
  AddItem( "/p/weapon/spear/angel.lpc", REFRESH_REMOVE );
}

