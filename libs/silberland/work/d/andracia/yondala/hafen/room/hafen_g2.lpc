#include "../def.h"

inherit ROOM + "hafen_strasse_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Osten ist die Kueferei. \n" );
    
  AddDetail( ({"kueferei"}),
    BS("In einer Kueferei werden Faesser hergestellt. "));
  AddDetail( ({"faesser"}),
    BS("Es hat hier keine. Aber geh doch in die Kueferei, die koennen "+
    "Dir bestimmt weiterhelfen. "));
   
  AddExit( "norden" , ROOM + "hafen_g1.lpc");
  AddExit( "osten" , ROOM + "hafen_h2.lpc");
  AddExit( "sueden" , ROOM + "hafen_g3.lpc");
  
}