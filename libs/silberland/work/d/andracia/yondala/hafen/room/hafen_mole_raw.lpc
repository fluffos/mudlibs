#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Mole" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich auf der Mole die den Hafen umgreift. Im Hafen liegen "+
     "die Fischkutter und Handelsschiffe vor Anker. Auch grosse Kriegsschiffe kann man "+
     "hier des Oefteren bewundern. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    BS("Das Pfeifen des Windes und die Geraeusche des Treibens im Hafen vermischen sich "+
    "hier. Das Schlagen der Wellen, das Geschrei der Hafenarbeiter und Fischer liefert "+
    "die typische Geraeuschkulisse eines Hafens. "));
  AddSound( ({ "wind", "pfeifen" }),
    BS("Die steife Brise verfaengt sich zwischen den Steinen der Mole und erzeugt "+
    "dieses Geraeusch. "));
  AddSound( ({ "wellen", "welle", "schlagen" }),
    BS("Das Wasser der See brandet gegen die Mole. Es schaeumt und bricht sich zwischen "+
    "den Felsen. Dadurch entsteht dieses Geraeusch. "));
  AddSound( ({ "geraeusche", "geraeusch", "geraeuschkulisse", "geschrei", "hafenarbeiter", "fischer", "treiben" }),
    BS("See und Hafen erzeugen eine vielzahl an Geraeuschen. "));
  AddSmell( DEFAULT_SMELL,
    BS("Der typisch frische Geruch von Salzwasser dringt in deine Nase. Zum Glueck kommt "+
    "der Wind vom Meer und verschont deine Nase dadurch vom Geruch des Hafens. "));
  AddSmell( ({ "wasser", "salzwasser", "brise", "meer", "see", "frische", "frisch" }),
    BS("Frisch und salzig weht der Wind dir um die Nase. "));
  AddSmell( ({ "geruch", "hafen", "brackwasser", "hafenbecken", "fische", "fisch", "brackwassergeruch" }),
    BS("Zum Glueck treibt der Wind den unangenehmen geruch von Fisch und Brackwasser "+
    "von Dir weg. "));

  AddDetail( ({ "boden" }),
    BS("Diese steinerne Mole besteht aus grossen Felsen, die in Form eines "+
    "langgestreckten Huegels aus dem Wasser ragt. Die Wellen brechen sich "+
    "daran und das dahinterliegende Hafenbecken ist ruhig. Das Gehen auf den "+
    "groben Steinen ist schwierig und unbequem. "));
  AddDetail( ({ "himmel" }),
    BS("Die vielen Wolken werden von der hier herrschenden frischen Brise vom Meer "+
    "her ueber das Festland getrieben. Die kalte Luft und die vielen Wolken lassen "+
    "darauf schliessen dass weit draussen eine aufgewuehlte See herrscht. Hier am "+
    "Hafen sind die Wellen nicht allzu hoch. "));
  AddDetail( ({ "mole", "huegel", "wall" }),
    BS("Die hier aufgeschichteten Felsen liefern einen guten Wall gegen die Wellen. "+
    "Das Hafenbecken ist dadurch ruhig und nur die steife Brise erzeugt kleine Wellen. "+
    "Die groben Steine umfassen den Hafen, sind aber unbequem zum gehen. "));
  AddDetail( ({ "hafen", "schutz" }),
    BS("Das Wasser ist relativ ruhig im Hafen, riecht aber etwas brackig. Viele Schiffe "+
    "suchen hier Schutz vor den Gewalten der offenen See. "));
  AddDetail( ({ "fischkutter", "kutter" }),
    BS("Die meissten der hier vor Anker liegenden Schiffe sind Fischkutter. Mit Netzen "+
    "fangen diese viele Fische und versorgen damit die ganze Kuestenregion. "));
  AddDetail( ({ "handelsschiffe", "handelsschiff" }),
    BS("Neben Fisch werden hier im Hafen viele andere Gueter umgeschlagen. Taeglich "+
    "kommen solche Handelsschiffe und bringen Gewuerze, Metalle und andere Dinge, "+
    "die man hier nicht herstellt oder anbauen kann. "));
  AddDetail( ({ "anker" }),
    BS("Ein Anker dient dazu ein Schiff festzuhalten damit es nicht abtreibt. Der "+
    "eiserne Haken am Ende der Kette graebt sich in den Untergrund des Hafens und "+
    "verhindert so, dass Schiffe aufeinander prallen. "));
  AddDetail( ({ "kriegsschiffe", "kriegsschiff" }),
    BS("Die bewehrten Kriegsschiffe sind mit vielen Kaempfern besetzt und sollen "+
    "Piraten den Garaus machen. "));
  AddDetail( ({ "schiffe", "schiff" }),
    BS("Fischkutter und Handelsschiffe kann man erkennen. Hin und wieder legen hier "+
    "auch Kriegsschiffe an. "));
  AddDetail( ({ "steine", "stein", "felsen", "fels" }),
    BS("Die Felsen der Mole sind schwarz und kantig. Nahe der Wasseroberflaeche haben "+
    "sich Muscheln festgesetzt. "));
  AddDetail( ({ "wasser", "see", "meer", "salzwasser" }),
    BS("Das Wasser der See brandet gegen die Mole. Es schaeumt und bricht sich zwischen "+
    "den Felsen. "));
  AddDetail( ({ "wellen", "welle", "gewalten" }),
    BS("Die Wellen die gegen die Mole branden sind nicht besonders hoch. "));
  AddDetail( ({ "hafenbecken", "becken" }),
    BS("Die Wasseroberflaeche des Hafenbeckens wirkt nur die steife Brise die kleine "+
    "Wellen erzeugt unruhig. Das Wasser riecht aber etwas brackig. "));
  AddDetail( ({ "wolken", "wolke" }),
    BS("Die steife Brise treibt die Wolken von der See auf das Land. "));
  AddDetail( ({ "brise", "luft", "wind" }),
    BS("Ein etwas starker Wind aus Westen treibt die Wolken vor sich her. "));
  AddDetail( ({ "festland", "land", "region", "kueste", "kuestenregion"}),
    BS("Das Land im Osten und die umliegenden Kuestengebiete werden von hier aus "+
    "mit Fischen versorgt. "));
  AddDetail( ({ "hafenarbeiter", "fischer", "publikum" }),
    BS("Hafenarbeiter und Fischer bilden das vorherrschende Publikum des Hafens. "));
  AddDetail( ({ "pfeifen", "schlagen", "treiben", "vorgaenge" }),
    BS("Untersuche lieber Dinge statt Vorgaenge."));
  AddDetail( ({ "brackwasser" }),
    BS("Das Wasser des Hafenbeckens steht nur und daher bleibt der Dreck im "+
    "Hafenbecken bleiben und so entsteht der typische Brackwassergeruch. "));
  AddDetail( ({ "glueck", "gluecksspiele", "spiele" }),
    BS("Spiele Gluecksspiele um dein Glueck herauszufordern. "));
  AddDetail( ({ "nase" }),
    BS("Das ist deine Nase, dreh sie in den Wind und rieche! "));
  AddDetail( ({ "gewuerze", "metalle", "dinge", "gueter" }),
    BS("Viele Dinge bringen die Handelsschiffe, schau doch bei den Haendlern oder im "+
    "Kontor nach was so alles hier angeboten wird. "));
  AddDetail( ({ "untergrund" }),
    BS("Das Wasser ist zu truebe um den Untergrund zu erkennen. "));
  AddDetail( ({ "haken", "kette" }),
    BS("Die Anker haengen an einer Kette und werden abgelassen wenn man hier im Hafen "+
    "festmacht. "));
  AddDetail( ({ "kaempfer" }),
    BS("Kriegsschiffe haben viele Kaempfer an Bord. "));
  AddDetail( ({ "pirat", "piraten" }),
    BS("Zum Glueck sind keine hier. "));
  AddDetail( ({ "wasseroberflaeche" }),
    BS("Die Wasseroberflaeche des Hafenbeckens wirkt nur die steife Brise die kleine "+
    "Wellen erzeugt unruhig. Die kalte Luft und die vielen Wolken lassen "+
    "darauf schliessen dass weit draussen eine aufgewuehlte See herrscht. Hier an "+
    "der Mole sind die Wellen nicht allzu hoch."));
  AddDetail( ({ "muscheln", "muschel", "essen" }),
    BS("Leider sind diese Muscheln viel zufest mit dem Fels verwachsen. Zum Essen sind "+
    "sie wohl auch nicht geeignet. "));
  AddDetail( ({ "dreck" }),
    BS("Im Wasser des Hafenbecken ist allerlei Dreck der den typisch brackigen Geruch "+
    "erzeugt. Nur selten treibt der Wind das dreckige Wasser auf die See hinaus. "));
  AddDetail( ({"bord"}),
    BS("Dazu sollte man auf einem Schiff sein."));
  AddDetail( ({"garaus", "prozess"}),
    BS("Mit Piraten wird kurzer Prozess gemacht."));
  AddDetail( ({"kontor"}),
    BS("Das Kontor befindet sich etwas die Strasse hinauf."));
  AddDetail( ({"strasse"}),
    BS("Die Strasse fuehrt durch das Hafendorf bis nach Zwirbelstein."));
  AddDetail( ({"zwirbelstein"}),
    BS("Dazu musst Du erst der Strasse entlang wandern."));
  AddDetail( ({"hafendorf", "dorf", "haeuser"}),
    BS("Die Haeuser hier bilden ein Hafendorf."));
  AddDetail( ({"kuestengebiete", "kuestengebiet", "gebiete", "gebiet" }),
    BS("Diese Kuestengebiet ist der westlichste Teil des Huegellands. "+
    "Westlich von hier liegt nur noch das Meer."));
  AddDetail( ({"netz", "netze"}),
    BS("Damit werden Fische gefangen."));
  AddDetail( ({"fische"}),
    BS("Mit Netzen faengt man Fische."));
  AddDetail( ({"form"}),
    BS("Ein einfacher Huegel aus Steinen der das Hafenbecken schuetzt"));
  AddDetail( ({"ende"}),
    BS("Hoffentlich wird das hier nicht DEIN Ende."));
  AddDetail( ({"huegelland","teil"}),
    BS("Du befindest Dich im westlichen Teil des Huegellands."));
  AddDetail( ({"gehen"}),
    BS("Es ist hier nicht ganz einfach, aber auch nicht unmoeglich. Du schaffst das."));
/*
  AddDetail( ({""}),
    BS(""));

Essen, Form, gehen, 

*/
}
