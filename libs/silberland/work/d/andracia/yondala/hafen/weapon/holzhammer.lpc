#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzhammer");
  SetProp(P_LONG, BS("Ein Holzhammer. Eigentlich ist dieser Hammer nur "
                     "als Werkzeug geeignet und stellt nur eine "
					 "unzureichende Waffe dar. ") );
  SetProp(P_NAME, "Holzhammer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "hammer", "holzhammer" }) );
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 45);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 270);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 55);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:2]) );
}

