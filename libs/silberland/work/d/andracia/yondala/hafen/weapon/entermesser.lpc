#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Entermesser");
  SetProp(P_LONG, "Ein gutes Entermesser. Jeder erfahrene Seemann hat eines. " );

  SetProp(P_NAME, "Entermesser");
  SetProp(P_GENDER, NEUTER );
  AddId( ({ "messer", "entermesser" }) );
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 73);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 320);
  SetProp(P_QUALITY_DECAY, 82);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:3]) );
}

