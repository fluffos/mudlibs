#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Enterhaken");
  SetProp(P_LONG, 
    BS("Ein guter Enterhaken. Eigentlich dazu gedacht Schiffe "+
    "heranzuholen und zu vertaeuen. Er besteht aus einem langen "
	"Stab und einer metallenen Spitze.") );
  AddDetail("spitze","Die Spitze spaltet sich in einen Dorn und einen "
                     "Haken."); 
  AddDetail("dorn","Mit diesem Dorn kann man seinen Feinden sicher "
            "tiefe Stichwunden zufuegen."); 
  AddDetail("haken","Mit dem Haken kann man bestimmt schlimme Wunden "
                    "in den Feind reissen."); 					 
  SetProp(P_NAME, "Enterhaken");
  SetProp(P_GENDER, MALE );
  AddId( ({ "haken", "enterhaken"}) );
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 104);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP }));
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_METAL:15, MAT_WOOD:85]) );
  SetProp(P_WEIGHT, 820);
  SetProp(P_SIZE, 156);
  SetProp(P_VALUE, 1200);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:4]) );
}

