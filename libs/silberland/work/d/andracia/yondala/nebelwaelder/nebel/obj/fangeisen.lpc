#include "../def.h"

inherit "std/thing";

#include <properties.h>
int verdeckt;
int gespannt; //kann man in die Falle laufen?
object gefangener;

void init()
{
	::init();
	if(gespannt&&!gefangener)
		{
			
			if(verdeckt)
				{
					if(random(3)==1) call_out("zuschnappen", 1);//wenn es verdeckt ist, ists wahrscheinlicher, dass man reintritt
				  }
			else if(random(5)==1) call_out("zuschnappen", 1);	
			}
		}				


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
verdeckt=1;
gespannt =1;
  SetProp(P_SHORT, "Ein Haeuflein Laub");
  SetProp(P_LONG,
    "Du siehst ein kleines Haeuflein Laub. Wo es wohl herkommt?" );
  SetProp(P_INFO, "Du spuerst, dass in dem Haeuflein etwas verborgen ist, vielleicht solltest "
  "Du es mal durchwuehlen?!");
  SetProp(P_NAME, "Laubhaeuflein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"haeuflein","laubhaeuflein", "laub","\nfangeisen"}));

  SetProp(P_MATERIAL, ({MAT_MISC_HERBAL, MAT_IRON} ));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das Laub rieselt immer wieder durch Deine Finger.\n");
  AddCmd( ({ "durchwuehle", "durchwuehl" }), "durchwuehlen" );
  AddCmd( ({ "loese", "loes" }), "ausloesen" );
  AddCmd( ({ "bedecke", "bedeck" }), "bedecken" );
  AddCmd( ({ "spanne", "spann" }), "spannen" );
  AddCmd( ({ "befreie", "befrei" }), "befreien" );


}
void aufdecken()
{
  SetProp(P_SHORT, "Ein Fangeisen und ein Haeuflein Laub");
if(gespannt)
  SetProp(P_LONG,
    "Du siehst ein gespanntes Fangeisen. Gefaehrlich, wenn das hier einfach so rumliegt, es "
    "sollte vorsichtig ausgeloest werden, sonst verletzt sich noch jemand. Daneben liegt ein "
    "kleines Haeuflein Laub." );
else 
	  SetProp(P_LONG,
    "Du siehst ein ausgeloestes Fangeisen. Es sieht wirklich gefaehrlich aus. Gut, dass es nicht "
    "gespannt ist, sonst wuerde sicher jemand reintreten und sich verletzen. Daneben liegt ein "
    "kleines Haeuflein Laub mit dem man das Eisen vermutlich verdecken koennte." );
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "Fangeisen und ein Haeuflein Laub");
  AddId(({"fangeisen","eisen"}));
  verdeckt=0;
  SetProp(P_NOGET, 0);
}

void verdecken()
{
	SetProp(P_SHORT, "Ein Haeuflein Laub");
  SetProp(P_LONG,
    "Du siehst ein kleines Haeuflein Laub. Wo es wohl herkommt?" );
  SetProp(P_INFO, "Du spuerst, dass in dem Haeuflein etwas verborgen ist, vielleicht solltest "
  "Du es mal durchwuehlen?!");
  SetProp(P_NAME, "Laubhaeuflein");
  AddId(({"haeuflein","laubhaeuflein"}));

  SetProp(P_NOGET, "Das Laub rieselt immer wieder durch Deine Finger.\n");
  verdeckt=1;
}

int durchwuehlen(string str)
{
	notify_fail("Was moechtest Du durchwuehlen?\n");
	if(str=="haeuflein"||str=="laubhaeuflein"||str=="laub")
		{
			if(verdeckt)
				{
					write("Du durchwuehlst das Laubhaeuflein und legst ein Fangeisen frei.\n");
  				say(TPN+" durchwuehlt den Laubhaufen und legt ein Fangeisen frei.\n");
					aufdecken();
          SetProp(P_NOGET, "Ein gespanntest Fangeisen ist viel zu gefaehrlich zum rumtragen.\n");
					
					verdeckt=0;
				}
			else
				{
					write("Du durchwuehlst das Laubhaeuflein, findest aber nichts darin.\n");
  				say(TPN+" durchwuehlt das Laubhaeuflein, findet aber nichts darin.\n");
  			}
  		return 1;					
			}
		return 0;
	}

int bedecken(string str)
{
	notify_fail("Was moechtest Du verdecken?\n");
	if(str=="eisen"||str=="fangeisen"||str=="eisen mit laub"||str=="fangeisen mit laub")
		{
			if(environment(TO)==TP)
				{
					write("Das geht nicht, solange Du es in den Haenden haelst. Leg es dazu ab.\n");
					return 1;
				}
			if(verdeckt)
				{
					write("Das Fangeisen ist doch schon mit Laub bedeckt.\n");
				}
			else
				{
					write("Du bedeckst das Fangeisen mit Laub.\n");
					if(gespannt) write("Hoffentlich tritt keiner darauf, das ist ja wirklich gefaehrlich.\n");
					else write("Gut, dass das Fangeisen nicht gespannt wurde, das waere sonst auch zu gefaehrlich.\n");
  				say(TPN+" bedeckt das Fangeisen mit Laub.\n");
  			  verdecken();
  			}
  		return 1;					
			}
		return 0;
	}
			


int ausloesen(string str)
{
	if(verdeckt) return 0;
	notify_fail("Was moechtest Du ausloesen?\n");
	if(str=="fangeisen vorsichtig aus"||str=="eisen vorsichtig aus"||str=="fangeisen aus"||
		 str=="eisen aus"||str=="eisen"||str=="fangeisen")
		{
			
			if(gespannt)
				{
					write("Vorsichtig loest Du das Fangeisen aus und machst es so ungefaehrlich.\n");
					say(TPN+" loest vorsichtig das Fangeisen aus und macht es so ungefaehrlich.\n");
					gespannt=0;
          SetProp(P_NOGET, 0);
					}
    	else write("Das Eisen ist doch schon ausgeloest.\n");
			return 1;
		}
	return 0;
}	

int spannen(string str)
{
	if(verdeckt) return 0;
	notify_fail("Was moechtest Du spannen?\n");
	if(str=="fangeisen"||str=="eisen")
		{
			if(environment(TO)==TP)
				{
					write("Das geht nicht, solange Du es in den Haenden haelst. Leg es dazu ab.\n");
					return 1;
				}
			if(gefangener==TP)
				{
					write("Das geht nicht, solange Du mit Deinem Fuss darin steckst. Du musst Dich erst befreien.\n");
					return 1;
				}
			if(gefangener)
				{
					write("Das geht nicht, vorher muss "+gefangener->name()+" "+gefangener->name(WESSEN)+" Fuss befreien.\n");
					return 1;
				}
					

			if(!gespannt)
				{
					write("Du spannst das Fangeisen.\n");
					say(TPN+" spannt das Fangeisen.\n");
					gespannt=1;
          SetProp(P_NOGET, "Ein gespanntest Fangeisen ist viel zu gefaehrlich zum rumtragen.\n");
					}
    	else write("Das Eisen ist doch schon gespannt.\n");
			return 1;
		}
	return 0;
}

void zugeschnappt()
{
	verdeckt=0;
	gespannt=0;
	aufdecken();
}
	
	
void zuschnappen()
{
	if(gefangener||TP->id("nebelgeist")) return;
	if(TP&&present(TP, environment(TO))&&TP->QueryProp(P_NOMOVE)!="Du musst erst das Fangeisen loesen!\n")	
		{
			write("AUTSCH!\nDu bist in ein Fangeisen getreten.\n");
			say(capitalize(TPN)+" tritt in ein Fangeisen.\n", TP);
			gefangener=TP;
			gefangener->SetProp(P_NOMOVE, "Du musst erst das Fangeisen loesen!\n");
			zugeschnappt();
		}
	}
			
int befreien(string str)
{
	notify_fail("Wen moechtest Du befreien?\n");
	if(!gefangener)
		{
			write("Es ist niemand in dem Fangeisen gefangen.\n");
			return 1;
		}
	
	if(str==lowerstring(gefangener->name()))
		{
			if(gefangener==TP)
				{
					write("Du befreist Dich aus dem Fangeisen.\n");
					say(TPN+" befreit sich aus dem Fangeisen.\n",TP);
				}
			else
				{
					write("Du befreist "+gefangener->name()+" aus dem Fangeisen.\n");
					tell_room(environment(TO), TPN+" befreit "+gefangener->name()+" aus dem Fangeisen.\n", ({TP, gefangener}));
					tell_object(gefangener, TPN+" befreit Dich aus dem Fangeisen.\n");
				}
			gefangener->SetProp(P_NOMOVE, 0);
			gefangener=0;
			return 1;
		}
		else if(str=="mich" &&TP==gefangener)
				{
					write("Du befreist Dich aus dem Fangeisen.\n");
					say(TPN+" befreit sich aus dem Fangeisen.\n",TP);
		    	TP->SetProp(P_NOMOVE, 0);
	    		gefangener=0;
	    		return 1;
	     	}								
	return 0;
}		