// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  wie_oft=35;
  geh_ich=3;

   AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Schmatzen.");

  AddSound( ({ "schmatzen", "" }),
    "Es kommt offenbar aus dem Westen.");
  AddSound( ({ "westen", "" }),
    "Vom Westen hoerst Du ein leises Schmatzen.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ziemlich feucht, ausserdem kommt von Westen her ein leicht fauliger Geruch.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");
  AddSmell( ({ "westen" }),
    "Aus dem Westen kommt ein fauliger Geruch.");
  AddSmell( ({ "geruch" }),
    "Was das wohl sein mag? Angenehm riecht es zumindest nicht.");


  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3f", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3d", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier ziemlich weich, Du fuehlst ein paar Blaetter und kleinere Zweige.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="blaetter"||str=="zweige"||str=="blatt"||str=="zweig")
		{
			bswrite("Die Blaetter und Zweige sind vermutlich von den Baeumen abgefallen.\n");
			return 1;
			}
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}
