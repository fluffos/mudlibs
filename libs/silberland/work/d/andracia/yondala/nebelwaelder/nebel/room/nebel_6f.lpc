#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );


  SetProp( P_INT_SHORT, "Auf einer Lichtung" );
  SetProp( P_INT_LONG,
    "Du stehst ziemlich in der Mitte einer Lichtung. Um die Lichtung herum herrscht dichter Nebel, Du kannst "
    "kaum erkennen was um Dich herum ist, nur ein paar Schatten deuten an, dass Du Dich vermutlich "
    "in einem Wald befindest. Auf der Lichtung allerdings siehst Du nicht viel mehr als ein "
    "paar Baumstaemme." );
  AddDetail( ({ "lichtung" }),
    "Du stehst ziemlich in der Mitte einer Lichtung. Um die Lichtung herum herrscht dichter Nebel, Du kannst "
    "kaum erkennen was um Dich herum ist, nur ein paar Schatten deuten an, dass Du Dich vermutlich "
    "in einem Wald befindest. Auf der Lichtung allerdings siehst Du nicht viel mehr als ein "
    "paar Baumstaemme.");
  AddDetail( ({ "mitte" }),
    "Du stehst in der Mitte der Lichtung.");
  AddDetail( ({ "nebel" }),
    "Der Nebel steht um die kleine Lichtung wie starke Waende. Du kannst absolut nichts sehen.");
  AddDetail( ({ "nebelwaende", "nebelwand", "waende","wand" }),
    "Die Nebelwaende sind absolut blickdicht. Lediglich ein paar Schatten sind zu erkennen.");
  AddDetail( ({ "schatten" }),
    "Bei den Schatten scheint es sich um Baeume zu handeln. Hoffst Du zumindest.");
  AddDetail( ({ "baeume","baum" }),
    "Viel kannst Du von ihnen nicht sehen, lediglich als Schatten im Nebel kannst Du sie "
    "erkennen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist trocken und fest. Auf ihm liegen einige Baumstaemme verteilt.");
  AddDetail( ({ "baumstaemme","staemme" }),
    "Viele grosse Baumstaemme liegen auf der Lichtung. Irgendwie kommt Dir ihre Anordnung nicht "
    "zufaellig vor. ");
  AddDetail( ({ "anordnung" }),
    "Es sieht so aus, als laegen die Baumstaemme hier in einem Viereck. Das wahr bestimmt Absicht.");
  AddDetail( ({ "viereck" }),
    "Die Baumstaemme liegen also im Viereck. Jemand hat sogar etwas Erde unter die Staemme "
    "gestopft, damit diese nicht wegrollen koennen. Was das wohl alles fuer einen Sinn hat?");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um die Lichtung herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "sinn" }),
    "Vielleicht erkennst Du den Sinn, wenn Du das Zentrum des Vierecks betrachtest.");
  AddDetail( ({ "zentrum" }),
    "Im Zentrum des Vierecks ist eine schwarze Stelle.");
  AddDetail( ({ "wald" }),
    "Du vermutest in einem zu sein.");
  AddDetail( ({ "feuerstelle" }),
    "Das also ist der Grund. Hier hat wohl jemand regelmaessig ein Lagerfeuer gemacht. "
    "Du erkennst auch einige Essensreste um die Feuerstelle herum.");
  AddDetail( ({ "stelle", }),
    "Es sieht aus, als sei diese mal eine Feuerstelle gewesen.");
  AddDetail( ({ "grund" }),
    "Den weisst Du nun.");
  AddDetail( ({ "lagerfeuer","feuer" }),
    "Du kannst ja mal tasten, aber das Feuer ist vermutlich laengst erloschen.");
  AddDetail( ({ "absicht" }),
    "Zufaellig sind die Staemme dort sicher nicht hingerollt.");
  AddDetail( ({ "erde" }),
    "Jemand hat Erde so unter die Staemme gestopft, dass diese nicht so einfach wegrollen koennen.");
  AddDetail( ({ "essensreste","reste" }),
    "Die sind schon verfault und heben sich kaum mehr vom Boden ab.");

  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Holz und auch ein wenig rauchig.");

  AddSmell( ({ "holz" }),
    "Natuerlich riecht es nach Holz, denn hier wurden vor nicht allzulanger Zeit Baeume gefaellt.");
  AddSmell( ({ "baeume" }),
    "Die Baeume riechen nach Holz.");
  AddSmell( ({ "rauch" }),
    "Ja, definitiv, es riecht nach Rauch. Vermutlich ist es die Feuerstelle, "
	"die so riecht.");
  AddSmell( ({ "feuerstelle","stelle" }),
    "Die Feuerstelle riecht nach kaltem Rauch.");
  
  AddExit( "sueden", "./nebel_7f" );
  AddExit( "westen", "./nebel_6e" );
  AddExit( "osten", "./nebel_6g" );

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );

}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="suedosten"||str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="osten"||str=="westen"||str=="sueden")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Den kannst Du auch sehen. Hier ist der Nebel nicht so stark.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
	if(str=="feuer"||str=="feuerstelle"||str=="stelle")
		{
			bswrite("Die Feuerstelle ist kalt.\n");
			return 1;
			}
			
			
	}
