inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kaulquappe");
  SetProp(P_LONG,
    "Du siehst eine kleine, schwarze Kaulquappe. Sie zappelt wild herum." );
  SetProp(P_NAME, "Kaulquappe");
  SetProp(P_GENDER, FEMALE);

SetProp(P_FOOD_INFO, ([F_SOAK:2, 
											 F_HEAL:({6,6}), // erst HP, MP
											 F_MSG: "Du kaust auf einer kleinen Kaulquappe herum. Schmeckt glitschig.", 
											 F_MSG_ROOM: "kaut auf einer kleinen Kaulquappe herum."]));

AddId(({"kaulquappe","wesen"}));
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 10);

}

