// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

//hier kann man nen Stein aus einer Pfuetze fischen-> ZT
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int steinda;

void reset()
{
	steinda=1;
	::reset();	
}
	
	
	
	
	
	
void create() 
{
  ::create();
  wie_oft=50;
  geh_ich=4;

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "fische", "fisch" }), "fischen" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1i", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich. Du fuehlst ausserdem etwas Feuchtes.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="feuchtes"||str=="etwas")
		{
			bswrite("Du tastest auf dem Boden herum und entdeckst eine kleine Pfuetze.\n");
			return 1;
			}
	if(str=="pfuetze")
		{
			bswrite("Du patscht in der kleinen Pfuetze herum. Sie ist nicht sonderlich tief, auf ihrem "
			"Grund fuehlst Du ein paar Steine.\n");
			return 1;
			}	
	if(str=="steine")
		{
			bswrite("Vielleicht kann man ja einen herausfischen?\n");
			return 1;
			}	
		
		
	if(str=="")
		{
			bswrite("\n");
			return 1;
			}	
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(str=="wasser"||str=="wasser aus bach"||str=="aus bach")
		{
			if(TP->InFight())
				{
					bswrite("Dafuer hast Du gerade keine Zeit.\n");
					return 1;
				}
			if(TP->drink_soft(3))
				{
					bswrite("Du schoepfst Dir mit den Haenden etwas Wasser in den Mund. Hach, das erfrischt.\n");
					TP->AddHp(15);
					TP->AddSp(15);
					return 1;
				}
		}
	return 0;
}

int fischen(string str)
{
	notify_fail("Was moechtest Du woraus fischen?\n");
	if(str=="stein aus pfuetze"||str=="stein"||str=="stein heraus")
		{
			if(TP->FindPotion("Du versuchst einen Stein aus der Pfuetze zu fischen, haelst aber ploetzlich einen kleinen Trank in den Haenden.\n")) return 1;
			if(steinda)
				{
					bswrite("Du fischst einen kleinen Stein aus der Pfuetze.\n");
			    CLONE(NEBEL_OBJ +"stein.lpc", TP);
			    steinda--;
				}
			else bswrite("Leider flutschen Dir alle Steine immer wieder aus den Fingern.\n");
			
			return 1;
		}
	return 0;
}