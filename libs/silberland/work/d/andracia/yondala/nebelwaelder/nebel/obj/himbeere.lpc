inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine rote Himbeere");
  SetProp(P_LONG,
    "Du siehst eine kleine, reife Himbeere. Sie leuchtet so rot, dass sie sicher koestlich "
    "suess schmeckt." );
  SetProp(P_NAME, "Himbeere");
  SetProp(P_GENDER, FEMALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:2, 
											 F_HEAL:({5,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du verspeist eine koestliche Himbeere.", 
											 F_MSG_ROOM: "verspeist eine koestliche Himbeere."]));


AddId(({"himbeere","beere"}));
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);


 
}

