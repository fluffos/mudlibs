inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Fliegenpilz");
  SetProp(P_LONG,
    "Du siehst einen kleinen, roten Pilz mit weissen Tupfern. Ob er geniessbar ist?" );
  SetProp(P_NAME, "Fliegenpilz");
  SetProp(P_GENDER, MALE);

SetProp(P_FOOD_INFO, ([F_SOAK:-10, 
											 F_HEAL:({0,0}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du isst einen Fliegenpilz. Sofort wird Dir uebel, Du musst Dich uebergeben.", 
											 F_MSG_ROOM: "isst einen Fliegenpilz und muss sich sofort uebergeben.",
											 F_POISON: 1]));


AddId(({"fliegenpilz","pilz"}));
  SetProp(P_MATERIAL, MAT_MUSHROOM);
  SetProp(P_WEIGHT, 6);
  SetProp(P_VALUE, 6);


 
}

