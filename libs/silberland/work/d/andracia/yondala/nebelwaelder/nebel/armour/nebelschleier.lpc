// Nebelschleier, den der Nebeldrache hat
// Loest sich nach einer Woche auf
// Schuetzt vor verschiedenen Angriffen
// erhoeht Max Lebenspunkte beim Tragen um 15
// heilt bei reset und ab und an im Kampf
// Sollte mal noch etwas "besonderes" kriegen, hab aber keine Idee
// Stand: 11.9.2008

#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
void reset()
{
	if(!is_clone(TO)) return;
	if(interactive(environment(TO))&&QueryProp(P_WORN))
		{
			tell_object(environment(TO),"Der Nebelschleier heilt Dich.\n");
			environment(TO)->AddHp(100+random(50));
		}
	::reset();
	}
	
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  call_out("weg",604800);

  SetProp(P_SHORT, "Ein Nebelschleier");
  SetProp(P_LONG,
    "Du siehst einen Schleier der, obwohl nur aus Nebel bestehend, doch irgendwie fest ist. "
    "Er ist kaum zu sehen, nur das, was er einhuellt bekommt einen leichten Graustich." );
  SetProp(P_INFO, BS("Der Nebelschleier scheint Dich gut vor bestimmten Gefahren schuetzen zu "+
  "koennen. Allerdings wird er nicht ewig halten.") );
  SetProp(P_NAME, "Nebelschleier");
  SetProp(P_GENDER, MALE);
  AddId( ({"nebel", "nebelschleier", "schleier"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_AIR, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_M_HEALTH_MOD,([P_HP:15]));
  SetProp(P_DAM_PROTECTION, DT_FIRE);
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

void weg()
{
	if(interactive(environment(TO)))
		{
			tell_object(environment(TO),"Der Nebelschleier verdichtet sich ploetzlich und dringt in Dich ein.\n");
			environment(TO)->AddHp(random(100)+100);
		}
	remove();
}


int DefendFunc(string *dtyp, mixed spell, object enemy)
  {
  	if(random(2)==1) return 0;
 
 		if (member(dtyp, DT_COLD) >= 0)   /* Eis unter den Schadenstypen */
    		{
		      tell_object(environment(TO), "Der Nebelschleier schuetzt Dich etwas vor dem Kaelteangrif.\n");					
		    	return 5;
		    }

     if (member(dtyp, DT_FIRE) >= 0)   /* Feuer unter den Schadenstypen */
    		{
         tell_object(environment(TO), "Die Aura absorbiert einen Teil des Feuers.\n");					
		     return 4;
		    }
     if (member(dtyp, DT_AIR) >= 0)  
    		{
         tell_object(environment(TO), "Der Nebelschleier verwirbelt den Luftangriff.\n");		
         return 5;
		    }
     if (member(dtyp, DT_WATER) >= 0) 
    		{
         tell_object(environment(TO), "Der Nebelschleier schwaecht den Wasserangriff ab.\n");
         return 4;					
		    }
     if (member(dtyp, DT_TERROR) >= 0)   
    		{
    			if(random(3)==1)
    				{
    					tell_object(environment(TO), "Der Nebelschleier wandelt den Angriff in Heilung.\n");
    					environment(TO)->AddHp(10+random(50));
    					return 0;
    				}
         tell_object(environment(TO), "Der Nebelschleier macht Dich mutiger.\n");
         environment(TO)->SetProp(P_WIMPY,QueryProp(P_WIMPY)-random(10));
         return 3;					
		    }

          return 0;
       }

int WearFunc(object me) {
	if(!IS_SEER(TP) )
		{
			tell_object(TP, "Dazu musst Du Seher sein.\n");
			return 0;
		}
  return 1;
}

int RemoveFunc(object ruest,int silent)
{

  return 1;
}