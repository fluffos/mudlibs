// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
// Hier steht ein Warnschild

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  AddItem(NEBEL_OBJ + "warnschild.lpc",REFRESH_DESTRUCT);
  wie_oft=55;
  geh_ich=5;




  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "nordosten", "nordostlauf");
  AddSpecialExit( "suedosten", "suedostlauf");
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int nordostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int suedostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="suedwesten"||str=="sueden"||
		 str=="nordwesten"||str=="norden")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier relativ hart. Mitten drin steckt ein Pfosten.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen"||str=="nordosten"||str=="suedosten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="pfosten")
		{
			bswrite("Der Pfosten traegt ein Schild.\n");

			return 1;
			}
	if(str=="schild"||str=="warnschild")
		{

					bswrite("Fuehlt sich rauh und trocken an. Da Du so nah davor stehst kannst Du es lesen.\n");
					return 1;
			}		


	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}


