
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinchen");
  SetProp(P_LONG,
    "Du siehst ein kleines, langweiliges Steinchen. Ob Du es jemals fuer irgendetwas gebrauchen kannst?" );

  SetProp(P_NAME, "Steinchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stein","steinchen"}));

  SetProp(P_MATERIAL, MAT_SLIME );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_ARTICLE, 1);
 
}
