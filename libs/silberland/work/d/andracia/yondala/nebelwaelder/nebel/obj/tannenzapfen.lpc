inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein runder Tannenzapfen");
  SetProp(P_LONG,
    "Du siehst einen runden, braunen Tannenzapfen. Wenn man gute Zaehne hat kann man "
    "ihn bestimmt essen. " );
  SetProp(P_NAME, "Tannenzapfen");
  SetProp(P_GENDER, MALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:4, 
											 F_HEAL:({10,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du isst krachend einen harten Tannenzapfen.", 
											 F_MSG_ROOM: "isst krachend einen harten Tannenzapfen."]));


AddId(({"tannenzapfen","zapfen"}));
  SetProp(P_MATERIAL, MAT_FIR);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);


 
}

