//hier ist Friedhelm unter einem Blaetterhaufen versteckt
//Forscherpunkt auf stosse kopf
#include "../def.h"
inherit "std/room";
#include <properties.h>
int da;
int fledermaus;
void reset()
{
	::reset();
		da=1;
	fledermaus=7;
	}
void create() 
{
  ::create();
  da=1;
  fledermaus=7;
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einer kleine, feuchten Hoehle. Die Waende hier sind teilweise weiss, teilweise "
    "braun und an allen glitzern tausende kleine Wassertropfen. Unter der Decke haengen "
    "ein paar Fledermaeuse, auf dem Boden liegen Aeste und vertrocknete Blaetter verstreut." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer kleine, feuchten Hoehle. Die Waende hier sind teilweise weiss, teilweise "
    "braun und an allen glitzern tausende kleine Wassertropfen. Unter der Decke haengen "
    "ein paar Fledermaeuse, auf dem Boden liegen Aeste und vertrocknete Blaetter verstreut." );
  AddDetail( ({ "waende" }),
    "Welche Waende meinst Du? Die braunen oder die weissen Waende?");
  AddDetail( ({ "braune wand","braune waende","lehmwand","lehmwaende" }),
    "Die braunen Waende bestehen aus Lehm.");
  AddDetail( ({ "lehm" }),
    "An machnchen Stellen hat jemand etwas in den feuchten Lehm geritzt.");
  AddDetail( ({ "stellen" }),
    "Du kannst an einer Stelle lesen, was dort geschrieben steht.");
  AddDetail( ({ "stelle" }),
    "Du kannst lesen, was dort steht.");
  AddReadDetail( ({ "stelle" }),
    "H I L F E!");
  AddDetail( ({ "h","i","l","f","e","hilfe" }),
    "Da scheint jemand Hilfe zu brauchen. Bloss wer?");
  AddDetail( ({ "weisse wand","weisse waende","kalkwand","kalkwaende" }),
    "Die weissen Waende bestehen offenbar aus Kalk.");
  AddDetail( ({ "kalk" }),
    "Aus Kalk kann man Kreide machen.");
  AddDetail( ({ "kreide" }),
    "Kreide macht man aus Kalk und wenn diese Hoehle nicht in einem so unzugaenglichen Wald "
    "wie dem Nebelwald liegen wuerde, wuerde man hier sicherlich auch Kalk abbauen um daraus "
    "Kreide zu machen.");
  AddDetail( ({ "wald", "nebelwald" }),
    "Der Nebelwald ist ueber Dir, ausserhalb der Hoehle.");
  AddDetail( ({ "wassertropfen","tropfen" }),
    "Unzaehlige Wassertropfen glaenzen hier auf allen Waenden.");
  AddDetail( ({ "decke" }),
    "Die Decke ist nicht weit ueber Dir. Sie besteht halb aus dem Loch durch das Du gekommen "
    "bist und halb aus Stein. Von der Decke baumeln zahlreiche Fledermaeuse. Du solltest "
    "aufpassen, dass Du nicht aus Versehen mit dem Kopf gegen sie stoesst und sie weckst.");
  AddDetail( ({ "kopf" }),
    "Damit kann man denken.");
  AddDetail( ({ "versehen" }),
    "Na, allein schon dass es hier steht und Du gewarnt wurdest deutet darauf hin, dass es kein "
    "Versehen ist, wenn Du es tust.");
  AddDetail( ({ "loch" }),
    "Durch dieses Loch bist Du gekommen und kannst dadurch die Hoehle wohl auch wieder verlassen.");
  AddDetail( ({ "stein" }),
    "Das ist vermutlich Kalk.");
  AddDetail( ({ "fledermaeuse","fledermaus" }),
    "Einige Fledermauese haengen schlafend unter der Decke. Ihre schwarzen Koerper bewegen "
    "sich rhytmisch als wuerden sie alle gemeinsam atmen.");
  AddDetail( ({ "koerper" }),
    "Du siehst viele schwarze Koerper die ruhig ueber die haengen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist relativ uneben, auf ihm liegen wild verstreut Blaetter und Aeste, die "
    "vermutlich durch das Loch in der Decke hereingefallen sind.");
  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du?");
  AddDetail( ({ "aeste" }),
    "Du siehst groessere und kleinere Aeste, die groesstenteils morsch und vertrocknet sind. "
    "Die kannst Du fuer gar nichts gebrauchen.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter sind alt und vertrocknet, also ziemlich nutzlos. Sie liegen hier teilweise auf "
    "dem Boden verteilt, in einer dunklen Ecke haben sie sich angehaeuft.");
  AddDetail( ({ "ecke" }),
    "In einer dunklen Ecke haben sich Blaetter angehaeuft.");
  AddDetail( ({ "haufen","blaetterhaufen" }),
    "Du solltest ihn vielleicht mal durchwuehlen, vielleicht findest Du etwas.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts spezifischem, die Luft ist nur sehr feucht.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");



  AddRoomMessage( 
    ({""}),30,"func");
  AddCmd( ({ "stosse","stoss" }), "stossen" );
  AddCmd( ({ "baue","bau" }), "abbauen" );
  AddCmd( ({ "durchwuehle","durchwuehl" }), "durchwuehlen" );

  AddExit( "oben", "./nebel_3b" );
   }  
  
int stossen(string str)
{
 	object maus;

	notify_fail("Womit moechtest Du wogegen stossen?\n");
	if(str=="mit kopf gegen fledermaeuse"||
		 str=="mit kopf gegen fledermaus"||
		 str=="kopf gegen fledermaeuse"||
   	 str=="kopf gegen fledermaus")
   {
  	bswrite("Du stoesst mit Deinem Kopf gegen eine der Fledermaeuse.\n");
  	if(fledermaus)
			{
					bswrite("Die Fledermaus erwacht.\n");
				  AddItem( NEBEL_NPC+"fledermaus.lpc" , REFRESH_DESTRUCT);
				  maus=present("fledermaus",TO);
				  maus->Kill(TP);
				  fledermaus--;

				}
			else
				bswrite("Die Fledermaus laesst sich davon nicht beeindrucken und schlaeft friedlich weiter.\n");
			return 1;		
		}
return 0;
} 	
	
		
	
int abbauen(string str)
{
	notify_fail("Was moechtest Du abbauen?\n");
	if(str=="kreide ab")
		{
			bswrite ("Du kratzt an der Wand herum, es gelingt Dir aber leider nicht Kreide abzubauen.\n");
			say(TPN+" werkelt an einer Wand herum.\n",TP);
			return 1;
		}
	return 0;
}

int durchwuehlen(string str)
{
	object friedhelm;
	notify_fail("Was moechtest Du durchwuehlen?\n");
	
	if(str=="haufen"||str=="blaetter"||str=="blaetterhaufen")
		{
			if(TP->CanNotSee()) bswrite ("Du durchwuehlst den Blaetterhaufen. Da Du gerade aber gar nichts siehst findest Du auch nichts.\n");
			else
				{
					if(da) 
				   {							
							bswrite("Du durchwuehlst den Blaetterhaufen und findest einen kleinen, alten Mann.\n");
							say(TPN+" durchwuehlt einen Blaetterhaufen.\n",TP);
    				  CLONE(NEBEL_NPC + "friedhelm.lpc", environment(TP));
				      //AddItem( NEBEL_NPC+"friedhelm.lpc" , REFRESH_DESTRUCT);
				      //friedhelm =present("friedhelm",TO);
				      //friedhelm->heimat(TO);//sagt Friedhelm, wo seine Heimat ist, naemlich hier.
				      da=0;
				    }
				   else
				   	{
							bswrite("Du durchwuehlst den Blaetterhaufen, findest aber nichts. Allerdings ist der Blaetterhaufen warm, so als haette hier jemand noch vor kurzem drin gekauert.\n");
							say(TPN+" durchwuehlt einen Blaetterhaufen\n",TP);
						}
				  }
							
					return 1;
		}
	return 0;
}

void wiederda() //Wird von Friedhelm aufgerufen
{da=1;}