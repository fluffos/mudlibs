// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//hier hat ein Baum eine Krankheit. Einfach so
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  geh_ich=5;
  wie_oft=40;

  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier sehr moderig.");

  AddSmell( ({ "moder" }),
    "Es scheint vom Norden zu kommen.");
  AddSmell( ({ "norden" }),
    "Dort riecht es, als sei einer der Staemme vermodert.");
  AddSmell( ({ "staemme" }),
    "Die Staemme riechen fast alle gleich.");
  AddSmell( ({ "stamm" }),
    "Der Stamm scheint von einer Krankheit befallen zu sein, so sehr stinkt er.");
  AddSmell( ({ "krankheit" }),
    "Buaeh, Du wendest Dich ab.");


  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
 
 
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	
	if(str=="staemme")
		{
			bswrite("Die Staemme fuehlen sich alle gleich an.\n");
			return 1;
			}
	if(str=="stamm")
		{
			bswrite("Du merkst keinen Unterschied zu den anderen Staemmen. Dieser eine Stamm riecht einfach nur anders.\n");
			return 1;
			}
	if(str=="krankheit")
		{
			bswrite("Das wuerde ich an Deiner Stelle lassen, sonst steckst Du Dich noch an.\n");
			return 1;
			}
	if(str=="unterschied")
		{
			bswrite("Ist keiner da, ehrlich.\n");
			return 1;
			}
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}
 