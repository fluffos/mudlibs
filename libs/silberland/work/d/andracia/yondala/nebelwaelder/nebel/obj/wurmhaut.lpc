
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wurmhaut");
  SetProp(P_LONG,
    "Du siehst eine duenne Wurmhaut. Sie ist sehr duenn und klein. Was man damit wohl anfangen soll?" );

  SetProp(P_NAME, "Wurmhaut");
  SetProp(P_GENDER, FEMALE);
  AddId(({"haut","wurmhaut"}));

  SetProp(P_MATERIAL, MAT_SKIN);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);
  SetProp(P_ARTICLE, 1);
 
}
