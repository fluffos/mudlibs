//Sehr gute Waffe. Trifft Geister besonders hart.
//Holzfaellergeist hat einen Bonus drauf
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
int getroffen;
void create() 
{
  if (!is_clone(TO) )  return;
  ::create();
getroffen=0;
  SetProp(P_SHORT, "Eine Geisteraxt");
  SetProp(P_LONG,
    "Eine durchschimmernde Geisteraxt. Sie bestand einmal aus Holz und Eisen, nun scheint "
    "sie aus einer Art Nebel zu bestehen, denn ihr Umriss verschwimmt als saehe man sie "
    "durch truebes Wasser. Sie ist sehr leicht und sieht scharf aus." );
  SetProp(P_INFO, "Diese Waffe scheint Geister besonders hart zu treffen.");
  SetProp(P_NAME, "Geisteraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "geisteraxt"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, ({DT_RIP,DT_SLASH, DT_AIR}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_GHOST );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 0);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WC_BONUS, (["holzfaeller": 50]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:15]) );
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc(object enemy)
{
	if(environment(TO)->id("geist"))return 0;
	if (enemy->id("geist"))
		if(random(5)==0)
			{
     		tell_object(environment(TO), "Die Geisteraxt wendet sich gegen den Geist.\n");      		
     		return 30+random(30);
      }
   return 0;   /* ansonsten keinen zusaetzlichen Schaden anrichten */
}

int QueryDamage(object enemy)
{
	if(environment(TO)->id("geist"))return ::QueryDamage(enemy);
	if (!enemy->id("geist"))
		if(random(5)==0)
			{
     		tell_object(environment(TO), "Die Geisteraxt gleitet durch "+enemy->name(WEN)+" hindurch.\n");      		
     		return 0;
      }
    return ::QueryDamage(enemy);
  }		
void TakeFlaw(int hits)
{
	getroffen++;
	if(getroffen>500)
		remove();
	
	}