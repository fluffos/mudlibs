frissmich1()
{
	call_out("frissmich",1);
}
	
	frissmich()
{
	object leiche;
	leiche=present("leiche",environment(TO));
  tell_room(environment(TO), "Der Wolf verspeisst die Leiche.\n");
	leiche->remove();
		}

//int Defend()
int Defend(int dam, string dam_type, mixed spell, object enemy)
{
	if(present("nebelwoelfin",environment(TO)))
		{
	    tell_room(environment(TO), "Die Nebelwoelfin beschuetzt ihr Junges und greift an.\n");
		  present("nebelwoelfin",environment(TO))->Kill(enemy);
			StopHuntFor(TP,0);
			enemy->StopHuntFor(TO,1);
			return 0;
		}
::Defend(dam, dam_type, spell, enemy);
	}
			