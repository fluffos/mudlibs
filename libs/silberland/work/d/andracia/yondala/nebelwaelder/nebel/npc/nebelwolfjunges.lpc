inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
	if(TP->id("schaf")) Kill(TP);
	::init();
	}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Nebelwolfjunges");
  SetProp(P_LONG,
    "Du siehst eine kleines, weisses Nebelwolfjunges. Es hat einen grossen Kopf mit niedlichen "
    "runden Ohren. Seine wachen Augen schauen Dich neugierig an. Hin und wieder macht es ein paar "
    "tapsige Schritte auf viel zu grossen Pfoten.");
  SetProp(P_NAME, "Nebelwolfjunges");
  SetProp(P_GENDER, NEUTER);
  AddId(({"wolf", "junges", "nebelwolfjunges","nebelwolf"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
  //CLONEME(ARMOUR"wolfsfell.lpc" );

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen kleinen Zaehnchen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Raubtier");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "tapst heran");
  SetProp(P_MSGOUT, "tapst");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/nebel/room/nebel_6i");
  SetProp (P_MNPC_AREA, ({"/d/andracia/yondala/nebel/room/nebel_"}));
  SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+MOV_SPECIAL);
  SetProp (P_MNPC_WAIT, ({5, 2, 5}));
  SetProp(P_NOMOVE,1);//Soll erst laufen koennen, wenn die Mutter tot ist.
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_WIMPY, 150 );
  SetProp(P_KILL_NAME, "Eine Nebelwoelfin");

  AddInfo(DEFAULT_INFO, "bellt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Wolfsjunge kann Deine Sachen nicht tragen.\n" }) );
  SetChats(2, ({
    "Das Wolfsjunge schnueffelt am Boden herum.\n",
    "Das Wolfsjunge schaut Dich mit grossen Augen neugierig an.\n",
    "Das Wolfsjunge stolpert ueber seine eigenen Pfoten.\n",
    "Das Wolfsjunge bellt froehlich.\n"}) );

}


void flucht()
{
	string *ausgang;
  tell_room(environment(TO), "Das Wofsjunge bekommt Angst.\n");
  ausgang = m_indices (environment(TO)-> QueryProp(P_EXITS));
  command(ausgang[random(sizeof(ausgang))]);
  }	
void flucht1()
{
	call_out("flucht",1);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {

  if (find_call_out("reaction") != -1) return;
if(present("nebelwoelfin", environment(TO)))
	{
		tell_room(environment(TO),"Die Woelfin schuetzt ihr Junges und greift an.\n");
		present("nebelwoelfin",environment(TO))->Attack(TP);
		return;
	}

  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "stubst mit seiner Schnauze gegen Deine Hand.\n",
        "stubst mit seiner Schnauze gegen die Hand von @WEM.\n");
      break;
    case "aergerlich":
      flucht();
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "springt froehlich um Dich herum.",
        "springt froehlich um "+TPN+" herum.");
      break;
    case "fies":
      flucht();
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "zwickt Dich in den grossen Zeh.",
        "zwickt "+TPN+" in den grossen Zeh.");
      TP->AddHp(-1);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "bellt froehlich.", 
        "bellt froehlich");
      break;
    case "intim":
    	flucht();

      break;
    case "nett":
      call_out("reaction", 0, TP,
        "wedelt mit dem Schwanz.",
        "weldet mit dem Schwanz.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beobachtet Dich neugierig.",
        "beobachtet "+TPN+" neugierig.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "winselt",
        "winselt");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

