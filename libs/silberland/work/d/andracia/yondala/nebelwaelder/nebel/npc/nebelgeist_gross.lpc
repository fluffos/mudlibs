//24.10.2022 - Yondala@SilberLand: in der die() loescht er nun 4 Geisteinheiten aus NEBELROO+geisterzahl.txt

//[ ] 1  klein 1
//[ ] 2  mittel 3
//[x] 4  gross 8
//[ ] 8  gigantisch 16
//[ ] 16 drache 35

//fusioniert mit einem anderen grossen Nebelgeist.
//greift mit Luft an

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>



void fusion()
{
	if(TP&&!InFight()&&!TP->InFight()&&present(TP,environment(TO)))
		{
			if(random(2)==1)
				{
					tell_room(environment(TO),"Die beiden grossen Nebelgeister fusionieren miteinander.\n");
  				TP->remove();
	  			CLONE(NEBEL_NPC + "nebelgeist_gigantisch",environment(TO));
	  			remove();
	  		}
			}
		}
void init()
{
	::init();
	if(TP->id("\ngrossernebelgeist")) //wenn der andere ein Nebelgeist ist.
		{
			call_out("fusion",3);
		}
	}

void reset()
{
    ::reset();
	if(is_clone(this_object()) && !InFight()&&QueryProp(P_MAX_HP)==QueryProp(P_HP)) 
		{
			tell_room(environment(TO),"Der mittelgrosse Nebelgeist teilt sich.\n");
  		    CLONE(NEBEL_NPC + "nebelgeist_mittel",environment(TO));
			CLONE(NEBEL_NPC + "nebelgeist_mittel",environment(TO));
			remove();
		}

}

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Nebelgeist");
  SetProp(P_LONG,
    "Du siehst mitten im Nebel einen grossen Nebelgeist. Er ist fast durchsichtig "
    "und scheint nicht boesartig zu sein.");
  SetProp(P_NAME, "Nebelgeist"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ,"gross");  
SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM + "nebel_4a");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM }));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+MOV_SPECIAL);
SetProp (P_MNPC_WAIT, ({5, 15, 10}));

  SetProp(P_MSGIN, "weht herein");
  SetProp(P_MSGOUT, "weht");
 

  AddId(({"geist","nebelgeist","\ngrossernebelgeist"}));

  create_default_npc(16);
  SetProp(P_HANDS, ({" mit grosser Kaelte",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");  
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Ein grosser Nebelgeist"); 
  AddInfo(DEFAULT_INFO, "haucht: ghhhefaaahhhhhr.\n");  
SUID;
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Geist kann nichts tragen.\n" }) );


     SetChats(3, ({
       "Der Nebelgeist wabert umher.\n", 
       "Der Nebelgeist verschwindet kurz in einer Nebelwehe.\n",
       "Der Nebelgeist schwirrt um Dich herum.\n",
       "Der Nebelgeist fliegt durch Dich durch.\n",
       "Der Nebelgeist verursacht eine Gaensehaut bei Dir.\n" })) ;

SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      -0.6, DT_WATER:  -0.6, DT_AIR:    -0.4, 
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -0.6, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.6,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.4]) );

  SetProp(P_SPELLRATE, 40); 


    AddSpell(5,400,
              "Der grosse Nebelgeist umhuellt Dich mit eisiger Kaelte.\n",
              "Der grosse Nebelgeist umhuellt @WEN mit eisiger Kaelte.\n",
              ({DT_COLD}), ([SP_SHOW_DAMAGE:0]) );
    AddSpell(2,500,
              "Der grosse Nebelgeist beschwoert stickigen Nebel um Dich.\n",
              "Der grosse Nebelgeist beschwoert stickigen Nebel um @WEN.\n",
              ({DT_AIR}), ([SP_SHOW_DAMAGE:0]) );
    AddSpell(1,200,
              "Der grosse Nebelgeist stoesst Dich weg.\n",
              "Der grosse Nebelgeist stoesst @WEN weg.\n",
              ({DT_BLUDGEON}), "stoss",([SP_SHOW_DAMAGE:0]) );
              	
				
 }

 //Entweder der Spieler geht einen Raum weiter oder er laeuft gegen einen Baum
     void stoss(object enemy, int damage, mixed dam_type) 
     {
	   int i;
	   i=random(8);
	   if(i==1) enemy->command("nordwesten");
 	   else if(i==2) enemy->command("norden");
	   else if(i==3) enemy->command("nordosten");
	   else if(i==4) enemy->command("osten");
	   else if(i==5) enemy->command("suedosten");
	   else if(i==6) enemy->command("sueden");
	   else if(i==7) enemy->command("suedwesten");
	   else enemy->command("westen");
     } 
 

void geistloeschen()
{
	int geisterzahl;
	geisterzahl=to_int(read_file(NEBEL_ROOM+"geisterzahl.txt",1,1));
	
    if(geisterzahl<4) 
	{
		geisterzahl=4;
		//Geisterzahl darf nie 0 sein, wenn ein Geist sie abfragt
		//vermutlich hat dann jemand per Hand daran rumgewerkerlt
		//oder das ganze Gebiet zurueckgesetzt. Dann bitte immer 
		//haendisch NEBEL_ROOM+"geisterzahl.txt" auf 0 setzen
		tell_room(environment(TO), "GEISTERFEHLER 01, BITTE YONDALA ODER ERZMAGIER KONTAKTIEREN!\n");
	}
	geisterzahl-=4;
	rm(NEBEL_ROOM+"geisterzahl.txt");	 
	write_file(NEBEL_ROOM+ "geisterzahl.txt",to_string(geisterzahl));
}


void die(int poisondeath) 
{
      "/obj/gemmaster"->DistributeGem(2,0 , 3, TO);
	  CLONEME(NEBEL_ARMOUR "nebelhandschuhe" );
	geistloeschen();
    ::die(poisondeath);
}