
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tannennadel");
  SetProp(P_LONG,
    "Du siehst eine lange, sehr spitze Tannennadel. Sie ist schon recht trocken und geht langsam von dunkelgruen in grau ueber." );
  SetProp(P_INFO, "Mit dieser Nadel kann man sicher gut andere Leute pieksen.");

  SetProp(P_NAME, "Tannennadel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"nadel","tannennadel"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  AddCmd( ({ "piekse", "pieks" }), "pieksen" );
 
}

int pieksen(string str)
{
	object opfer;
	notify_fail("Wen moechtest Du denn pieksen?\n");
	if(!str) return 0;

	if(present(str, environment(TP)))
		{
			opfer=present(str, environment(TP));
			if(opfer==TP)
				{
					write("Du piekst Dich selbst mit der Tannennadel.\nAutsch.\n");
					say(TPN+" piekst sich selbst mit einer Tannennadel.\n",TP);
				}
			else
				{
					write("Du piekst "+opfer->name(WEN)+" mit der Tannennadel.\n");
					tell_room(environment(TP), TPN+" piekst "+opfer->name(WEN)+" mit einer Tannennadel.\n",({opfer,TP}));
					tell_object(opfer, TPN+ " piekst Dich mit einer Tannennadel.\nAutsch!\n");
				}
				if(random(5)==1)
					{
						tell_room(environment(TP),"Die Tannennadel zerfaellt.\n");
						remove();
					}
					return 1;
		}
		else if(present(str, TP))
			{
				opfer=present(str, TP);
				write("Du piekst "+opfer->name(WEN)+" mit der Tannennadel.\n");
				tell_room(environment(TP), TPN+" piekst "+opfer->name(WEN)+" mit einer Tannennadel.\n",({TP}));
				return 1;
			}
				
 
			return 0;
		
	}