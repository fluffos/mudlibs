//Holzfaellerlager
//ZT bei balanciere auf staemme
#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
object balancierer;
int wieoft;


void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );

  SetProp( P_INT_SHORT, "Auf einer Lichtung" );
  balancierer=0;
  SetProp( P_INT_LONG,
    "Du stehst am Rande einer Lichtung. Um die Lichtung herum herrscht dichter Nebel, Du kannst "
    "kaum erkennen was um Dich herum ist, nur ein paar Schatten deuten an, dass Du Dich vermutlich "
    "in einem Wald befindest. Auf der Lichtung allerdings siehst Du nicht viel mehr als ein "
    "paar Baumstuempfe und einige aufeinander gestapelte Baumstaemme." );
  AddDetail( ({ "lichtung" }),
    "Du stehst am Rande einer Lichtung. Um die Lichtung herum herrscht dichter Nebel, Du kannst "
    "kaum erkennen was um Dich herum ist, nur ein paar Schatten deuten an, dass Du Dich vermutlich "
    "in einem Wald befindest. Auf der Lichtung allerdings siehst Du nicht viel mehr als ein "
    "paar Baumstuempfe.");
  AddDetail( ({ "rande","rand" }),
    "Du stehst am Rand der Lichtung.");
  AddDetail( ({ "nebel" }),
    "Der Nebel steht um die kleine Lichtung wie starke Waende. Du kannst absolut nichts sehen.");
  AddDetail( ({ "nebelwaende", "nebelwand", "waende","wand" }),
    "Die Nebelwaende sind absolut blickdicht. Lediglich ein paar Schatten sind zu erkennen.");
  AddDetail( ({ "schatten" }),
    "Bei den Schatten scheint es sich um Baeume zu handeln. Hoffst Du zumindest.");
  AddDetail( ({ "baeume","baum" }),
    "Viel kannst Du von ihnen nicht sehen, lediglich als Schatten im Nebel kannst Du sie "
    "erkennen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist trocken und fest. Er wird immer wieder von grossen Baumstuempfen unterbrochen.");
  AddDetail( ({ "baumstuempfe","stuempfe", "stumpf", "baumstumpf" }),
    "Viele grosse und einige kleinere Baumstuempfe beherrschen die Lichtung.");
  AddDetail( ({ "jahresringe","ringe" }),
    "Es sind sehr viele an jedem Stumpf.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um die Lichtung herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "wald" }),
    "Du vermutest in einem zu sein.");
  AddDetail( ({ "baumstaemme" }),
    "Die Baumstaemme liegen alle ordentlich auf einem Haufen.");
  AddDetail( ({ "haufen" }),
    "Der Haufen ist durch den Nebel etwas feucht und sieht sehr rutschig aus. Es ist sicher "
    "gefaehrlich darauf herumzuklettern.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Holz und auch ein wenig rauchig.");

  AddSmell( ({ "holz" }),
    "Natuerlich riecht es nach Holz, denn hier wurden vor nicht allzulanger Zeit Baeume gefaellt.");
  AddSmell( ({ "baeume" }),
    "Die Baeume riechen nach Holz.");
  AddSmell( ({ "rauch" }),
    "Hier scheint es ganz in der Naehe gebrannt zu haben.");
  AddSmell( ({ "naehe" }),
    "Da Du den Rauch deutlich riechst, kann es nicht weit weg sein.");
  AddSmell( ({ "zeit" }),
    "\n\n\nHm, wie riecht Zeit?\nIch weiss nicht.\nVielleicht alt?\nWohl eher nein.\n"
    "Weil Zeit NICHT riecht.\nUnd nun forsch mal sinnigere Details ab.\nIst naemlich sonst gefaehrlich.\n\n\n\n");
  AddSmell( ({ "details","detail" }),
    "Details stinken.");
  AddSmell( ({ "gefahr" }),
    "Wow, sehr gut. Bin stolz auf Dich. \nJe laenger Du hier rumstehst, desto gefaehrlicher ist es.\nHaha!");



  AddExit( "nordwesten", "./nebel_6e" );
  AddExit( "nordosten", "./nebel_6g" );
  AddExit( "norden", "./nebel_6f" );
 
  AddCmd( ({ "kletter", "klettere" }), "klettern" );
  AddCmd( ({ "balanciere", "balancier" }), "balancieren" );
  AddCmd( ({ "springe", "spring" }), "springen" );

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );

    SetProp(P_HIDE_EXITS, ({"osten"}) ); 



}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||str=="nordwesten"||str=="nordosten"||
		str=="suedwesten"||str=="westen"||str=="osten")
	{
		bswrite("Du kannst hier sehen.\n");
		return 1;
	}

		if(str=="boden")
		{
			bswrite("Den kannst Du auch sehen. Hier ist der Nebel nicht so stark.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}

int springen(string str)
{
	notify_fail("Wovon moechtest Du springen?\n");
	if(str=="von staemmen"||str=="von staemme"||str=="von haufen"||str=="von staemmen runter"||
		 str=="von staemme runter"||str=="von haufen runter"||str=="von haufen herunter"||str=="runter")
		 {
		 	if(TP->QueryProp(P_NOMOVE)=="Du musst erst von den Staemmen springen.\n")
		 		{
		 			bswrite("Du springst von den Staemmen herunter.\n");
			    say(TPN+" springt von den Staemmen herunter.\n");
			    TP->SetProp(P_NOMOVE,0);
					balancierer=0;
				}
			else
				bswrite("Du bist doch gar nicht auf den Staemmen.\n");
			return 1;		 			
		}
	return 0;
}
		 	
int klettern(string str)
{
	notify_fail("Worauf moechtest Du klettern?\n");
	if (str=="auf staemme"||str=="auf stamm"||str=="auf haufen"||str=="auf baumstaemme")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst von den Staemmen springen.\n")
				{
					bswrite("Du balancierst doch gerade.\n");
					return 1;
				}
			bswrite("Du kletterst auf den Baumstaemmen herum. Ob Du es schaffst von einem Ende zum "+
			"anderen zu balancieren?\n");
			say(TPN+" klettert auf den Baumstaemmen herum.\n");
			return 1;
		}
	return 0;
} 

int balancieren(string str)
{
	notify_fail("Worauf moechtest Du balancieren?\n");
	if (str=="auf staemmen"||str=="auf stamm"||str=="auf haufen"||str=="auf baumstaemmen"||
		  str=="auf staemme" ||str=="auf baumstaemme"||
		  str=="von einem ende zum anderen"||!str)
		{
	if(TP->QueryProp(P_NOMOVE)=="Du musst erst von den Staemmen springen.\n")
		{
			bswrite("Das machst Du doch schon.\n");
			return 1;
		}
	if (balancierer)
		{
			bswrite("Du musst warten, bist "+balancierer->name()+" fertig ist.\n");
			return 1;
		}

			bswrite("Du kletterst auf den Haufen und faengst vorsichtig an zu balancieren.\n");
			say(TPN+" klettert auf den Haufen und faengt vorsichtig an zu balancieren.\n");
			balancierer=TP;
			TP->SetProp(P_NOMOVE, "Du musst erst von den Staemmen springen.\n");
			wieoft=5;
			call_out("balanciersequenz",1);
			return 1;
		}
	return 0;
}



void balanciersequenz()
{
	int was;
	was=random(6);
	if(TP&&TP->QueryProp(P_NOMOVE)=="Du musst erst von den Staemmen springen.\n")
		{
			if(wieoft==0)
				{
					bswrite("Wow, Du hast es geschafft! Trunken vor Stolz springst Du vom Haufen runter.\n");
					say(TPN+" gelangt ans andere Ende der Staemme und springt stolz wieder auf den Boden.\n");
					this_player()->FindPotion("Du entdeckst einen kleinen Zaubertrank den Du sofort trinkst.\n");
					TP->SetProp(P_NOMOVE,0);
					balancierer=0;
					return;
				}
			if(was==1)
				bswrite("Du schwangst stark beim balancieren.\n");
      else if(was==2)
				bswrite("Fast waerst Du gestolpert.\n");
      else if(was==3)
				bswrite("Vorsichtig machst Du ein paar weiter Schritte.\n");
      else if(was==4)
				bswrite("Du breitest die Arme aus um das Gleichgewicht besser halten zu koennen.\n");
      else if(was==5)
				bswrite("Du hast Dein Ziel stehts vor Augen.\n");

						
			else
				{
					bswrite("Hoppla, Du stolperst und faellst von den Staemmen.\nSchwupps, schon sitzt Du auf dem Hintern.\n");
			    TP->AddHp(-5);
			    say(TPN+" faellt beim balancieren von den Staemmen.\n");
			    TP->SetProp(P_NOMOVE,0);
					balancierer=0;
					return;
			  }
			wieoft--;
			call_out("balanciersequenz",2);
		}
	}
