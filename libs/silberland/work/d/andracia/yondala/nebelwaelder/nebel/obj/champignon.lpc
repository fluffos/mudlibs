inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Champignon");
  SetProp(P_LONG,
    "Du siehst einen kleinen, braunweissen Champignon, der vermutlich in einem Wald frisch geflueckt wurde. "
    "Er sieht recht lecker aus." );
  SetProp(P_NAME, "Champignon");
  SetProp(P_GENDER, MALE);

SetProp(P_FOOD_INFO, ([F_SOAK:2, 
											 F_HEAL:({6,6}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du isst einen Champignon.", 
											 F_MSG_ROOM: "isst einen Champignon."]));


AddId(({"champignon","pilz"}));
  SetProp(P_MATERIAL, MAT_MUSHROOM);
  SetProp(P_WEIGHT, 6);
  SetProp(P_VALUE, 6);


 
}

