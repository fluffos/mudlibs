// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//Drachenstatue
//FP auf Hand in Maul
//Per Random gibts dafuer nen Edelstein

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int diamantda;

void reset()
{
	diamantda=random(5);
  }
  
void create() 
{
  ::create();
	diamantda=1;
  wie_oft=20;

  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");




  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "nordosten", "nordostlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "lege", "leg" }), "legen" );
  AddCmd( ({ "kletter", "klettere" }), "klettern" );
}

	
int nordostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4c", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5a", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="osten"||
		 str=="suedwesten"||str=="nordwesten"||str=="suedosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="nordosten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich. Als Du so herum tastest stossen Deine Finger "+
			"gegen etwas Hartes.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
	if(str=="hartes")
		{
			bswrite("Das Harte vor Dir ist kalt und rauh. Scheint ein Stein zu sein.\n");
			return 1;
			}		
	if(str=="stein"||str=="ganzes"||str=="ganze")
		{
			bswrite("Der Stein ist rauh, aber die Kanten sind abgerundet. Das Ganze fuehlt sich wie "+
			"Sockel an.\n");
			return 1;
			}		
	if(str=="kanten"||str=="kante")
		{
			bswrite("Die Kanten sind abgerundet.\n");
			return 1;
			}		
	if(str=="sockel")
		{
			bswrite("Du tastest den Sockel ab und fuehlst nun zwei gigantische Klauen darauf ruhen.\n");
			return 1;
			}		
	if(str=="klauen")
		{
			bswrite("Die Klauen sind rauh und gerillt. Sie besitzen lange, scharfe Krallen und gehen in "
			"zwei muskuloese Beine ueber.\n");
			return 1;
			}		
	if(str=="krallen"||str=="kralle")
		{
			bswrite("Die Krallen sind lang, scharf und leicht nach vorne gewoelbt. Du bist froh, dass "+
			"aus Stein sind und nicht aus Fleisch und Blut.\n");
			return 1;
			}		
	if(str=="beine"||str=="bein")
		{
			bswrite("Die Beine sind sehr dick und lang. Sie enden in einem sehr dicken Bauch.\n");
			return 1;
			}		
	if(str=="bauch")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Der Bauch hat gigantische Ausmasse, Du wuerdest mehrfach hineinpassen. Ueber "+
				"dem Bauch ragt ein Hals in die Hoehe.\n");
			else bswrite("Den kannst Du kaum mehr ertasten, Du muesstest dafuer auf den Sockel klettern.\n");
			return 1;
			}		
	if(str=="hals")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Der Hals ist sehr dick und traegt zwischen zwei maechtigen Schultern einen Kopf, der fast so gross ist wie Du.\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="kopf")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Der Kopf ist wirklich furchterregend. Du ertastest neben grossen Augen und "
				"aufgeblaehten Nuestern ein leicht geoeffnetes Maul mit unzaehligen, scharfen Zaehnen.\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="augen")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Du glaubst fuehlen zu koennen, wie sie Dich durch den Nebel hinweg anstarren.\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="nuestern")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Irrst Du Dich oder sind die Nuestern waermer als der restliche Stein?\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="maul")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Das Maul ist furchterregend. Nie wuerdest Du es wagen Deine Hand in das Maul zu "+
				"legen. Wer weiss, nachher schnappt es zu?\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="zaehne"||str=="zahn")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				{
					bswrite("AUTSCH!\n Nun hast Du Dich an einem Zahn geschnitten.\n");
					TP->AddHp(-10);
					TP->AddPoison(1);
				}
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="schultern")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
			bswrite("Die Schultern der Statue sind sind gewaltig und muskuloes. Sie laufen in zwei maechtigen Armen aus.\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="arme"||str=="arm")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Die Arme sind muskelbepackt und koennten Dich, wenn sie echt waeren, mit einem "+
				"Schlag zerquetschen.\n");
			else bswrite("Da kommst Du nicht dran, kletter auf den Sockel, wenn Du mehr wissen moechtest.\n");
			return 1;
			}		
	if(str=="statue")
		{
			bswrite("Was das wohl fuer eine Statue ist?\n");
			return 1;
			}		
	
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}			
			
	}

int klettern(string str)
{
	notify_fail("Wohin moechtest Du klettern?\n");
	if(str=="auf sockel")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
				bswrite("Du stehst doch schon auf dem Sockel.\n");
			else
				{
					bswrite("Du kletterst auf den Sockel.\n");
					TP->SetProp(P_NOMOVE,"Du musst erst vom Sockel herunter klettern.\n");
				}
			return 1;
		}
	else if(str=="runter"||str=="nach unten"||str=="von sockel"||str=="von sockel verunter")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst vom Sockel herunter klettern.\n")
			  {
			  	bswrite("Du kletterst vom Sockel herunter.\n");
			  	TP->SetProp(P_NOMOVE,0);
			  }
			else bswrite("Du stehst nicht auf dem Sockel.\n");
			return 1;
		}
	return 0;
	}

int legen(string str)
{
	notify_fail("Was moechtest Du worein legen?\n");
	if(str=="hand in maul")
		{
		  if(TP->QueryProp(P_NOMOVE)!="Du musst erst vom Sockel herunter klettern.\n")
		  	{
		  		bswrite("Da kommst Du so nicht dran.\n");
		  		return 1;
		  	}

			bswrite("Mutig legst Du Deine Hand in das Maul.\n");
			if(diamantda==1)
				{
					bswrite("Ploetzlich haelst Du einen kleinen Edelstein in der Hand.\n");
					"/obj/gemmaster"->DistributeGem(1, 0, 3, TP);	
					diamantda=0;
				}
			else 
				{
					bswrite("Ploetzlich schnappt das Maul zu. Nur mit Muehe kannst Du Deine Hand befreien.\n");
					TP->AddHp(-20);
					TP->AddPoison(1);
				}
			return 1;
		}
		return 0;
	}
				
