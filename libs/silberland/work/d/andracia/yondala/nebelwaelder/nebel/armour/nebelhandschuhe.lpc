// Nebelhelm, den der gigantische Nebelgeist hat
// Schuetzt vor verschiedenen Angriffen
// erhoeht Max Lebenspunkte beim Tragen um 5
// Tragbar ab Level 15
// geht nach tausend Schlaegen kaputt
// Stand: 11.9.2008

#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
int schlaege;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  schlaege=800;
  SetProp(P_SHORT, "Ein Paar Nebelhandschuhe");
  SetProp(P_LONG,
    "Du siehst ein Paar Nebelhandschuhe, das, obwohl nur aus Nebel bestehend, doch irgendwie fest ist. "
    "Es ist kaum zu sehen, sondern macht die Haende seines Traegers einfach etwas grauer." );
  SetProp(P_INFO, BS("Das Nebelhandschuhpaar schuetzt besonders gut vor Kaelteangriffen, nicht "+
  "jedoch vor Kaelte ansich.\nMan kann das Nebenlhandschuhpaar nicht reparieren.") );
  SetProp(P_NAME, "Paar Nebelhandschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"nebel", "nebelhandschuhe", "handschuhe","paar","nebelhandschuhpaar","nebelhandschuh","handschuh"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_AIR, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_M_HEALTH_MOD,([P_HP:2]));
  SetProp(P_DAM_PROTECTION, DT_FIRE);
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}




int DefendFunc(string *dtyp, mixed spell, object enemy)
  {
  	int schutz;
  	schutz=0;
		schlaege--;
		if(schlaege<1)
			{
				tell_object(environment(TO), "Der Nebelhelm zerfaellt.\n");
				remove();
			}
 
 		if (member(dtyp, DT_COLD) >= 0)   /* Eis unter den Schadenstypen */
    		{
		      tell_object(environment(TO), "Das Nebelhandschuhpaar absorbiert einen Teil des Kaelteangriffs.\n");					
		    	schutz= 2;
		    }

          return schutz;
       }

int WearFunc(object me) {
	if(TP->QueryProp(P_LEVEL)<10)
		{
			tell_object(TP, "Deine Stufe reicht dafuer nicht aus.\n");
			return 0;
		}
  return 1;
}

int RemoveFunc(object ruest,int silent)
{

  return 1;
}