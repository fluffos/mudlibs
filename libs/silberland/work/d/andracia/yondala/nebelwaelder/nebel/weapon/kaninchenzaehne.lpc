#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Kaninchenzaehne");
  SetProp(P_LONG,
    "Du siehst zwei gelbliche Kaninchenzaehne. Nicht sonderlich appetittlich, aber sie sind "
    "recht scharf und liegen gut in der Hand." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Kaninchenzaehne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"zaehne", "kaninchenzaehne"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 40 );
  SetProp(P_DAM_TYPE, DT_RIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 7);
  SetProp(P_VALUE, 120);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  

}
