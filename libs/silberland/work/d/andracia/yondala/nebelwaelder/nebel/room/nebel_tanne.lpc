#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Tanne" );
  SetProp( P_INT_LONG,
    "Du stehst hier hoch oben auf einer Tanne. Ueber Dir ist nur noch der schmale Wipfel, den "
    "Du nicht mehr erklettern kannst und purer, blauer Himmel. Unter Dir siehst Du dichte "
    "Nebelschwaden, nur hin und wieder wird dieser weisse Teppich durch die ein oder andere "
    "gruene Spitze durchbrochen. Dort jedoch, wo der Nebel endet, hast Du einen herrlichen "
    "Ausblick." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "tanne","tannenbaum" }),
    "Du befindest Dich hier hoch oben im Wipfel einer sehr grossen Tanne.");
  AddDetail( ({ "wipfel" }),
    "Du klammerst Dich an den hier nur noch armdicken Stamm der Tanne fest. Hoeher kannst "
    "Du nicht mehr klettern, der Wipfel wuerde Dich nicht mehr halten koennen.");
  AddDetail( ({ "stamm" }),
    "Der Stamm der Tanne, an den Du Dich klammerst, ist hier nur noch armdick.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau. Kein Wunder, denn die Wolken, sprich der Nebel, "
    "sind ja unter Dir.");
  AddDetail( ({ "wunder" }),
    "Du wunderst Dich nicht.");
  AddDetail( ({ "wolken" }),
    "Ueber Dir sind keine, aber unter Dir verstecken sie als dichter Nebel fast den ganzen Wald.");
  AddDetail( ({ "wald" }),
    "Den Wald kannst Du kaum sehen, da er unter einem dichten Nebel liegt. Nur hin und "
    "wieder siehst Du die Spitze eines anderen Baumes hervorluken.");
  AddDetail( ({ "spitze","spitzen" }),
    "Der Nebel ist so dicht und zieht sich so hoch, dass nur wenige Baeume es schaffen mit ihren "
    "Spitzen daraus hervorzustechen.");
  AddDetail( ({ "baeume" }),
    "Von den meisten Baeumen siehst Du aufgrund des Nebels nicht viel.");
  AddDetail( ({ "wald" }),
    "Der Wald liegt unter einem Nebelschleier verborgen.");
  AddDetail( ({ "nebel", "nebelschleier","schleier", "nebelschwaden","schwaden" }),
    "Der Nebel ist dick und weiss und so gut wie undurchsichtig.");
  AddDetail( ({ "ausblick" }),
    "Du hast einen herrlichen Ausblick von hier oben, Du kannst in alle Richtungen sehen.");
  AddDetail( ({ "richtungen" }),
    "Welche fallen Dir denn spontan ein?");
  AddDetail( ({ "norden", "nordosten" }),
    "Dort erstreckt sich das Huegelland vor Dir. Ein Weg fuehrt von Westen nach Osten.");
  AddDetail( ({ "huegelland" }),
    "Dort gibt es vieles zu sehen, Du solltest unbedingt mal hin.");
  AddDetail( ({ "weg" }),
    "Auf dem Weg laufen gerade ein paar Wanderer.");
  AddDetail( ({ "wanderer" }),
    "Schade, Du bist zu weit weg um etwas genaueres sehen zu koennen.");
  AddDetail( ({ "osten" }),
    "Weit entfernt im Osten kannst Du ein maechtiges Gebirge erkennen.");
  AddDetail( ({ "gebirge" }),
    "Das Gebirge liegt sehr weit im Osten. Du siehst einige steile Haenge "
    "und schneebedeckte Gipfel.");
  AddDetail( ({ "haenge" }),
    "Die Haenge sehen steil und gefaehrlich aus.");
  AddDetail( ({ "gipfel", "ganze" }),
    "Die Gipfel sind mit weissem Schnee bedeckt. Sehr malerisch, das Ganze.");
  AddDetail( ({ "schnee" }),
    "Auf den hohen Gipfeln des Gebirges ist es so kalt, dass dort sogar Schnee liegt.");
  AddDetail( ({ "suedosten" }),
    "Suedoestlich von Dir ist ein Loch im Nebel. Merkwuerdig, es sieht fast "
    "so aus, als sei dort eine kleine Siedlung.");
  AddDetail( ({ "loch", "stelle" }),
    "Suedoestlich von Dir ist der Nebel an einer Stelle aufgerissen.");
  AddDetail( ({ "siedlung" }),
    "Du kannst die Daecher einiger Huetten erkennen. Und sitzt dort nicht auch "
    "jemand?");
  AddDetail( ({ "daecher","huetten" }),
    "Die Haeuser und Daecher sehen aus, als sein sie aus Lehm gemacht.");
  AddDetail( ({ "lehm", "jemand" }),
    "Sicher kannst Du das von hier aus nicht sagen, Du muesstest wohl hingehen.");
  AddDetail( ({ "sueden", "suedwesten" }),
    "Der Nebel ist dort so dicht und hat sich so weit ausgebreitet, dass Du nichts erkennen kannst.");
  AddDetail( ({ "westen" }),
    "Im Westen erstreckt sich ein wunderbar blaues Meer vor Dir von der nahen "
    "Kueste bis zum Horizont funkelt es Dich an und wird nur selten von "
    "ein paar Inseln unterbrochen.");
  AddDetail( ({ "meer" }),
    "Das Meer ist herrlich blau. Es scheint sich schier unendlich auszudehnen.");
  AddDetail( ({ "kueste" }),
    "Die Kueste ist unweit westlich von Dir. Zumindest vermutest Du das, denn der Nebel hoert "
    "dort abrupt auf, es scheint dort steil nach unten zu gehen, Du solltest Dich hueten "
    "Dich zu weit nach Westen zu wagen!");
  AddDetail( ({ "horizont" }),
    "Der Horizont verschmilzt vor Deinen Augen mit dem Meer, Du kannst nicht sagen, wo das eine "
    "endet und das andere beginnt.");
  AddDetail( ({ "augen" }),
    "Niemand kann seine eigenen Augen sehen.");
  AddDetail( ({ "inseln" }),
    "Du kannst ein paar Inseln von hier oben aus sehen. Eine faellt Dir besonder auf.");
  AddDetail( ({ "insel" }),
    "Die Insel, die Dir auffaellt hat eine ganz besondere Form.");
  AddDetail( ({ "form" }),
    "Es ist die Form eines Totenkopfes.");
  AddDetail( ({ "totenkopf" }),
    "Wie gruselig. Was da wohl ist?");
  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten liegt eine grosse Hafenanlage.");
  AddDetail( ({ "hafenanlage", "hafen" }),
    "Du siehst dort einige Haeuser und zwei Schiffe.");
  AddDetail( ({ "haeuser" }),
    "Reger Betrieb herrscht dort, Wesen jeder Rasse gehen dort ein und aus.");
  AddDetail( ({ "betrieb" }),
    "Viele Wesen gehen dort ein uns aus.");
  AddDetail( ({ "rasse" }),
    "Eigentlich siehst Du Vertreter jeder Rasse, die Du kennst.");
  AddDetail( ({ "vertreter" }),
    "Na, einer, nicht alle.");
  AddDetail( ({ "schiffe", "schiff","boote","boot" }),
    "Ein Ruderboot und ein Segelboot sind in der Naehe das Hafens.");
  AddDetail( ({ "ruderboot" }),
    "Das Ruderboot verlaesst den Hafen gerade.");
  AddDetail( ({ "segelboot" }),
    "Das Segelboot faehrt gerade in den Hafen ein.");
  AddDetail( ({ "naehe" }),
    "Nicht weit weg.");
  AddDetail( ({ "teppich" }),
    "Der Nebel breitet sich unter Dir wie ein dicker Teppich aus.");
  AddDetail( ({ "boden" }),
    "Den kannst Du durch den Nebel nicht sehen.");
  AddDetail( ({ "oben" }),
    "Dort ist der Himmel. Und auch die Sonne scheint auf Dich hinunter.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint ungebremst auf Dich hinunter, durch den kuehlen Nebel geraetst "
    "Du aber auch nicht ins Schwitzen.");
  AddDetail( ({ "schwitzen" }),
    "Du schwitzt nicht.");
  AddDetail( ({ "unten" }),
    "Unter Deinen Fuessen ist nur Nebel zu sehen.");
  AddDetail( ({ "fuesse" }),
    "Sind beide noch da. Wie beruhigend.");
  AddDetail( ({ "wesen" }),
    "Wesen wie Du.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst ganz leise, wie der Wind die Tannennadeln lascheln laesst.");

  AddSound( ({ "wind" }),
    "Leise wispert der Wind durch die Tannennadeln.");
  AddSound( ({ "wispern" }),
    "Du kannst nicht verstehen, was der Wind Dir zuwispert.");
  AddSound( ({ "tannennadeln","nadeln" }),
    "Die Tannennadeln reiben leise aneinander.");
  AddSound( ({ "rascheln" }),
    "Das Rascheln der Nadeln ist kaum wahrnehmbar, aber fast das einzige "
	"Geraeusch hier oben.");
  AddSound( ({ "geraeusch" }),
    "Du hoerst nichts ausser dem Wind und dem dadurch entstandenem Rascheln "
	"der Tannennadeln.");
	

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Tanne.");

  AddSmell( ({ "tanne" }),
    "Hauptsaechlich riechst Du das Harz der Tanne.");
  AddSmell( ({ "harz" }),
    "Das Harz riecht suess und schwer.");

  AddCmd( ({ "kletter", "klettere" }), "klettern" );


  //AddItem( "item" , REFRESH_DESTRUCT);
}

int klettern(string str)
{
	notify_fail("Worauf moechtest Du klettern?\n");
	if(str=="runter"||str=="nach unten"||str=="hinunter")
		{
			bswrite("Du kletterst nach unten.\n");
      this_player()->move(NEBEL_ROOM+"nebel_3g", M_GO, 0,
                  "klettert nach unten", "tritt aus dem Nebel");
			return 1;		
		}
	else return 0;
	
}
