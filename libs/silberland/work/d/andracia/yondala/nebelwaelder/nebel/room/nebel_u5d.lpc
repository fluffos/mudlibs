//unterirdischer Kaninchenbau

#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp( P_INT_SHORT, "In einem engen Gang" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten in einem engen Gang. Es ist sehr dunkel hier. Aber auch wenn man "
    "sehen kann entdeckt man nur weniges: Der Gang wurde in den Waldboden gegraben, auf dem "
    "Boden liegen Blaetter und kleinere Aeste herum. Die Decke ist sehr niedrig und Du musst "
    "aufpassen, Dir nicht staendig den Kopf zu stossen. Schraeg ueber Dir ist ein Ausgang." );
  AddDetail( ({ "gang" }),
    "Wo er wohl hinfuehrt?");
  AddDetail( ({ "waldboden", "boden" }),
    "Der ist rund um Dich herum und auch ueber Dir. Er ist ziemlich fest, wenn auch etwas loecherig "
    "an manchen Stellen.");
  AddDetail( ({ "blaetter" }),
    "Auf dem Boden liegen einige Blaetter herum. Sie rascheln, wenn Du an ihnen vorrueber laeufst.");
  AddDetail( ({ "aeste", "zweige" }),
    "Einige kleine Zweige und Aeste liegen auf dem Boden und knacken unter Deinen Schritten.");
  AddDetail( ({ "schritte","schritt" }),
    "Jeder, der laeuft macht Schritte. So ist das.");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr niedrig. Du musst darauf achten, Dir nicht dauernd den Kopf zu stossen.");
  AddDetail( ({ "kopf" }),
    "Gut, dass der angewachsen ist.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Waldboden.");
  AddDetail( ({ "stellen" }),
    "An manchen Stellen befinden sich Loecher im Waldboden.");
  AddDetail( ({ "loecher" }),
    "Die Loecher stammen vermutlich von Wuermern.");
  AddDetail( ({ "wuermer" }),
    "Die Wuermer lockern den Waldboden auf.");
  AddDetail( ({ "ausgang" }),
    "Nach oben kannst Du diesen engen Gang verlassen, dort ist ein Ausgang.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille" }),
    "Es ist nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nassem Laub und feuchter Erde.");

  AddSmell( ({ "laub" }),
    "Es scheint sich dabei umd die Blaetter zu handeln, die auf dem Boden liegen.");
  AddSmell( ({ "erde" }),
    "Natuerlich riecht es hier nach Erde, denn Du bist in einem Gang unter eben dieser.");



  AddExit( "nordosten", "./nebel_u4e" );
  AddExit( "oben", "./nebel_5d" );
 }

