//Wolfsnest
//Eine Nebelwoelfin ist hier mit ihren zwei Jungen

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  AddItem(NEBEL_NPC + "nebelwoelfin.lpc",REFRESH_DESTRUCT);
  AddItem(NEBEL_NPC + "nebelwolfjunges.lpc",REFRESH_DESTRUCT);
  AddItem(NEBEL_NPC + "nebelwolfjunges.lpc",REFRESH_DESTRUCT);
  wie_oft=55;
  geh_ich=5;

  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");



  AddSpecialExit( "westen", "westlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
 }


int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="osten"||str=="sueden"||str=="suedosten"||
		 str=="nordwesten"||str=="suedwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich und voller Gras.\n");
			return 1;
			}
		if(str=="gras")
		{
			bswrite("Das Gras ist ziemlich weich. An einer Stelle ist es niedergedrueckt.\n");
			return 1;
			}
		if(str=="stelle")
		{
			bswrite("An dieser Stelle ist das Gras niedergedrueckt. Es ist hier auch waermer als "
			"der uebrige Boden. Fast scheint es, als haette hier vor kurzem noch jemand gelegen.\n");
			return 1;
			}

	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}


	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
	else
		bswrite("So etwas kannst Du nicht ertasten.\n");
		return 1;	
			
	} 

