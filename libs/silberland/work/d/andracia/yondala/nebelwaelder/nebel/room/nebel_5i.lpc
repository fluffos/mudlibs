// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//Grabstein mit Inschrift (FP)
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  geh_ich=5;
	wie_oft=55;
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "inschrift","inschrift mit fingern","inschrift mit finger",
  	                "schrift","schrift mit fingern","schrift mit finger" }),
    "Du faehrst mit den Fingern ueber die Inschrift und meinst folgendes zu verstehen:\n\n"+
    "   Dem unbekannten Abenteurer,\n"+
    "   der hier einen schnellen Tod fand.\n"+
    "   Er ruhe in Frieden.\n\nDu schauderst. Offenbar ist dies hier ein Grabstein.");



  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="suedwesten"||str=="sueden"||str=="suedosten"||str=="nordosten"||
		 str=="nordwesten"||str=="norden")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier relativ weich. Gleich vor Dir liegt allerdings etwas Hartes.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="hartes")
		{
			bswrite("Dieses Harte ist sehr gross und hat scharfe Kanten.\n");

			return 1;
			}
	if(str=="kanten"||str=="kante")
		{

					bswrite("Du tastest an den Kanten herum und kommst zu dem Schluss, dass es "+
					"sich um einen flachen, rechtwinkeligen Steinblock handelt.\n");
					return 1;
			}		

	if(str=="steinblock"||str=="block")
		{
			bswrite("Der Steinblock ist eben, die Oberflaeche ist allerdings sehr rauh.\n");
			return 1;
			}

	if(str=="oberflaeche")
		{
			bswrite("Fasst fuehlt es sich so an, als haette dort jemand Buchstaben eingemeisselt.\n");
			return 1;
			}

	if(str=="buchstaben")
		{
			bswrite("Der Steinblock hat offenbar eine Inschrift.\n");
			return 1;
			}

	if(str=="inschrift"||str=="schrift")
		{
			bswrite("Du kannst versuchen sie mit Deinen Fingern zu lesen.\n");
			return 1;
			}

	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}


