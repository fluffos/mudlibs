#include "../def.h"
#include <ansi.h>
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Warnschild");
  SetProp(P_LONG,
    "Ein grosses, hoelzernes Warnschild. Es ist schon stark verwittert und die Farbe blaettert "
    "ab. Du kannst es lesen" );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schild","warnschild"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );

  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.");
  AddReadDetail( ({ "schild","warnschild" }),
    ANSI_RED+"Achtung: GEFAHR\n"+
    "Huete Dich vor dem Nebelwald, Wanderer. Kehre schnell auf den Weg nach Osten zurueck, "+
    "sonst ist Dein Leben nicht mehr sicher!"+ANSI_NORMAL);
}
