//Die Ameise wird in nebel_4f geclont, greift denjenigen an, der gegen den 
//Ameisenhaufen getreten hat.

inherit "std/npc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
//#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
void init()
{
   ::init();
   if (this_player() && 
   	      ( this_player()->id("\nameise"))) AddDefender(this_player());

}
void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Eine zornige Ameise");
  SetProp(P_LONG,
    "Du siehst eine kleine, zornige Ameise, die wohl jemand in ihrer Ruhe gestoert hat.");
  SetProp(P_NAME, "Ameise"); 
  SetProp(P_NAME_ADJ, "zornig");
  SetProp(P_GENDER, FEMALE);
//  SetProp(P_ARTICLE, 0); //Ist Standartmaessig 1 und sollte es auch sein, sonst steht da nur "Kaefer betritt den Raum" etc

//SetProp (P_MNPC_DEFAULTROOM, "/d/nebelwaelder/yondala/nebelwald/room/nebel_4f");



  AddId(({"ameise", "insekt","\nameise"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren Zangen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");  
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 8);
  SetProp(P_ALIGN, 0);
  call_out("wasnun",random(10)+5);
  SetProp(P_MSGIN, "kommt aus dem Ameisenhaufen gekrabbelt");

/* was =random(2);
 if (was==1) 
 	{
 		CLONEME(OBJ "mistkugel" );
 		SetProp(P_MSGIN, "rollt eine Mistkugel herein"); 
  	SetProp(P_MSGOUT, "rollt seine Mistkugel");
  	}

 else 
 	{
 		CLONEME(OBJ "kaeferzange" );
	  SetProp(P_MSGIN, "krabbelt herein"); 
    SetProp(P_MSGOUT, "krabbelt");
  }
*/


  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Eine zornige Ameise"); // NEBEL_NPC-Name für den killer
  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  //wenn gefragt wird

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Ameise laesst @WEN wieder fallen.\n" }) );

}
void wasnun()
{
	object bmeise;
	if(InFight())
		{
			tell_room(environment(TO),"Die Ameise ruft Verstaerkung.\n");
			environment(TO)->AddItem( NEBEL_NPC+"bmeise.lpc" , REFRESH_NONE);

		}
	else
		{
			tell_room(environment(TO),"Die Ameise krabbelt wieder in den Ameisenhaufen.\n");
			remove();
		}
	  call_out("wasnun",random(10)+5);
	}
	
void InformDefend(object enemy)
{
 Kill(enemy);
}