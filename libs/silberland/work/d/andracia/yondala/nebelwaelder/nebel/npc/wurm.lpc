

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>





void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein Wurm");
  SetProp(P_LONG,
    "Du siehst einen kleinen, duennen Wurm. Wenn er sich nicht bewegen wuerde, saehe er aus "
    "wie eine leblose Schnur.");
  SetProp(P_NAME, "Wurm"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAX_HP, 1);

SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/nebelwaelder/nebel/room/nebel_u4e");
SetProp (P_MNPC_AREA, ({"/d/andracia/yondala/nebelwaelder/nebel/room/nebel_u"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 15, 10}));

 SetProp(P_MSGIN, "kriecht langsam heran");
 SetProp(P_MSGOUT, "kriecht langsam");
 	CLONEME(NEBEL_OBJ +"wurmhaut" );


  AddId(({"wurm"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinem Koerper",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Wurm");  
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 5);
  SetProp(P_ALIGN, 0);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Ein Wurm"); 
  AddInfo(DEFAULT_INFO, "wurmt.\n");  

call_out("weg",20);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wurm kann nichts tragen. Er hat keine Arme, weisst Du!?\n" }) );


     SetChats(3, ({
       "Der Wurm kringelt sich ein wenig.\n", 
       "Der Wurm kriecht herum.\n", })) ;


 }
void weg()
{
	
	if(InFight())
		call_out("weg",20);
  else
	 {
  		tell_room(environment(TO),"Der Wurm verkriecht sich wieder in einem Loch.\n");
  		present("wurmhaut",TO)->remove();
  		remove();
    }
}
