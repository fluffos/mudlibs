// Nebelhelm, den der gigantische Nebelgeist hat
// Schuetzt vor verschiedenen Angriffen
// erhoeht Max Lebenspunkte beim Tragen um 5
// Tragbar ab Level 15
// geht nach tausend Schlaegen kaputt
// Stand: 11.9.2008

#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
int schlaege;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  schlaege=1000;
  SetProp(P_SHORT, "Ein Nebelhelm");
  SetProp(P_LONG,
    "Du siehst einen Helm der, obwohl nur aus Nebel bestehend, doch irgendwie fest ist. "
    "Er ist kaum zu sehen, nur das, was er einhuellt bekommt einen leichten Graustich." );
  SetProp(P_INFO, BS("Der Nebelhelm scheint Dich gut vor bestimmten Gefahren schuetzen zu "+
  "koennen.") );
  SetProp(P_NAME, "Nebelhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"nebel", "nebelhelm", "helm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([ MAT_AIR, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_M_HEALTH_MOD,([P_HP:5]));
  SetProp(P_DAM_PROTECTION, DT_FIRE);
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}




int DefendFunc(string *dtyp, mixed spell, object enemy)
  {
  	int schutz;
  	schutz=0;
		schlaege--;
		if(schlaege<1)
			{
				tell_object(environment(TO), "Der Nebelhelm zerfaellt.\n");
				remove();
			}
 
 		if (member(dtyp, DT_COLD) >= 0)   /* Eis unter den Schadenstypen */
    		{
		      tell_object(environment(TO), "Der Nebelhelm schuetzt Dich etwas vor dem Kaelteangrif.\n");					
		    	schutz= 4;
		    }

    if (member(dtyp, DT_AIR) >= 0)  
    		{
         tell_object(environment(TO), "Der Nebelhelm verwirbelt den Luftangriff.\n");		
         schutz= 4;
		    }
    if (member(dtyp, DT_TERROR) >= 0)   
    		{
         tell_object(environment(TO), "Der Nebelhelm macht Dich mutiger.\n");
         environment(TO)->SetProp(P_WIMPY,QueryProp(P_WIMPY)-random(10));
         schutz= 4;					
		    }

          return schutz;
       }

int WearFunc(object me) {
	if(TP->QueryProp(P_LEVEL)<15)
		{
			tell_object(TP, "Deine Stufe reicht dafuer nicht aus.\n");
			return 0;
		}
  return 1;
}

int RemoveFunc(object ruest,int silent)
{

  return 1;
}