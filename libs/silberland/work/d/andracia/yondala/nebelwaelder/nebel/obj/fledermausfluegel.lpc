#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Fledermausfluegel");
  SetProp(P_LONG,
    "Du siehst einen kleinen, zerfledderten Fledermausfluegel. Na, die Fledermaus dem der "
    "gehoerte kommt sicher nicht mehr weit." );
  SetProp(P_NAME, "Fledermausfluegel");
  SetProp(P_GENDER, MALE);
  AddId(({"fluegel","fledermausfluegel"}));
SetProp( P_MATERIAL, MAT_SKIN );

  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
 
}


	