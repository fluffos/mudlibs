// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//Im Wasserloch
//man kann eine Kaulquappe fangen (FP)

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int kaulda;

void init()
{
	::init();
    SetProp(P_KILL_NAME,"ein tiefer Fall");
	if(!interactive(TP)) return;
    if(TP) TP->do_damage(15,TO);
}


void reset()
{
    kaulda=1;
	::reset();	
}
void create()
{
  ::create();
  SetProp( P_INT_LONG,
    "Du stehst bis zur Huefte in eiskaltem Wasser. Um Dich herum herrscht weiterhin dichtester "
    "Nebel. Du siehst absolut nichts; weder "
    "siehst Du Deine Fuesse, noch das Wasser in dem Du stehst. Lediglich wenn "
    "Du Dir Deine Hand vor die Augen haelst kannst Du sie erkennen. Um Dich herum ist alles "
    "einfach nur weiss, nur ein paar Schatten deuten an, dass Du Dich vermutlich in einem "
    "Wald befindest." );
 kaulda=1;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 2, ENV_TERRAIN: TT_FOREST]) );
 
 AddDetail( ({ "huefte" }),
    "Die siehst Du nicht, aber Du spuerst, dass das Wasser Dir bis dahin steht.");
  AddDetail( ({ "wasser" }),
    "Sehen kannst Du es nicht, aber es ist eiskalt.");
  AddDetail( ({ "boden" }),
    "Den kannst Du wegen dem Nebel nicht sehen, Du spuerst aber dass "
	"das Wasser nicht all zu tief ist und Du einigermassen gut stehen "
	"kannst.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");
  wie_oft=40;
  geh_ich=4;

  AddSpecialExit( ({"norden", "sueden", "osten", "westen","suedwesten","suedosten","nordwesten","nordosten"}), "laufversuch");

  AddCmd( ({ "kletter", "klettere" }), "klettern" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "fange", "fang" }), "fangen" );
 }




int tasten(string str)
{
  notify_fail("Was moechtest Du ertasten?\n");
  if (!str) return 0;
  if(str=="norden"||str=="sueden"||str=="suedosten"||
     str=="suedwesten"||str=="nordosten"||str=="osten"||str=="westen"||str=="nordwesten")
  {
    bswrite("Dort ertastest Du eine Wand.\n");
    return 1;
  }
  if(str=="boden"||str=="grund")
    {
      bswrite("Du tastest den Boden mit den Fuessen ab. Da scheint aber nichts zu sein, was "+
      "Dich interessieren koennte.\n");
      return 1;
      }

  if(str=="wand")
    {
      bswrite("Fast ueberall ertastest Du nur Waende.\n");
      return 1;
      }
  if(str=="baeume"||str=="baum")
    {
      bswrite("Die kannst Du nicht ertasten, lediglich ein paar Wurzeln fuehlst Du.\n");
      return 1;
      }
  if(str=="richtungen"||str=="richtung"||str=="weg")
    {
      bswrite("Welche Richtung moechtest Du denn ertasten?\n");
      return 1;
      }

  if(str=="fuesse")
    {
      bswrite("Sind beide noch da.\n");
      return 1;
      }
  if(str=="waende")
    {
      bswrite("Du bist von Waenden umgeben, da Du ja in einem Loch steckst. Genau genommen ist "+
      "es aber eigentlich nur eine Wand.\n");
      return 1;
      }

  if(str=="wurzeln"||str=="wurzel")
    {
      bswrite("Es fuehlt sich so an, als koenntest Du die Wurzeln der Baeume ertasten. "+
      "Sie sind aber relativ uninteressant.\n");
      return 1;
      }
 if(str=="loch")
    {
      bswrite("Du stehst in einem Loch welches bis zu Deiner Huefte mit Wasser gefuellt ist.\n");
      return 1;
      }
  if(str=="huefte")
    {
      bswrite("Bis dorthin steht Dir das Wasser.\n");
      return 1;
      }
  if(str=="wasser")
    {
      bswrite("Das Wasser ist eiskalt, irgendetwas ist dort, Du fuehlst eine stetige Bewegung um Dich herum.\n");
      return 1;
      }
  if(str=="bewegung"||str=="bewegungen")
    {
      bswrite("Etwas kleines, quirliges wuselt im Wasser um Dich herum. Vielleicht kannst Du "+
      "es ja fangen?\n");
      return 1;
      }
if(str=="kleines"||str=="quirliges"||str=="etwas")
    {
      bswrite("Du kannst es nicht ertasten. Versuche, es zu fangen.\n");
      return 1;
      }


  else
    {
      bswrite("Sowas kannst Du nicht ertasten.\n");
      return 1;
    }


  }

int klettern(string str)
{
  notify_fail("Woraus moechtest Du klettern?\n");
  if(str=="aus loch"||str=="aus loch heraus"||str=="aus loch raus"||
     str=="raus"||str=="heraus"||str=="rauf")
     {
      if(random(5)==0)
        {
          bswrite("Du kletterst nach Osten aus dem Loch heraus.\n");
          this_player()->move(NEBEL_ROOM+"nebel_5g", M_GO, 0,
                  "klettert aus dem Loch", "tritt aus dem Nebel");
        }
       else
        {
          bswrite("Du kletterst nach Westen aus dem Loch heraus.\n");
          this_player()->move(NEBEL_ROOM+"nebel_5e", M_GO, 0,
                  "klettert aus dem Loch", "tritt aus dem Nebel");
       }
        return 1;
      } 
      return 0;
    }

int laufversuch(string dir)
{
 	if(!interactive(TP))
		 this_player()->move(NEBEL_ROOM+"nebel_4e", M_GO, 0,
         "schwebt aus dem Loch", "schwebt herein");

  bswrite("Du versuchst zu laufen, es klappt aber nicht. Du musst schon klettern.\n");
  TP->do_damage(5, "Ein Baum");
  return 1;
}

int fangen(string str)
{
  notify_fail("Was moechtest Du fangen?\n");
  if(str=="kleines"||str=="quirliges"||str=="etwas")
    {
    	if(kaulda&&random(6)==1)
    		{
    			bswrite("Du greifst ins Wasser und haelst tatsaechlich bald ein kleines, zappelndes "+
    			"Wesen in Deinen Haenden.\n");
    			CLONE(NEBEL_OBJ +"kaulquappe.lpc", TP);
    			kaulda=0;
    			}
    					
    	else bswrite("Du greifst ins Wasser, aber ausser selbigem faengst Du nichts.\n");
    	return 1;
      }

  return 0;
}



