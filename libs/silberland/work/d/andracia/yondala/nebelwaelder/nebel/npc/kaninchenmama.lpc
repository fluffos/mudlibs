

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void init()
{
   ::init();
   if (this_player() && ( this_player()->id("kaninchenjunges"))) AddDefender(this_player());


}



void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Die Kaninchenmama");
  SetProp(P_LONG,
    "Du siehst ein dickes, graues Kaninchen, welches Dich aengstlich ansieht. Es hat Angst "
    "vor Dir und sorgt sich um seine Jungen.");
  SetProp(P_NAME, "Kaninchenmama"); 
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);

SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM + "nebel_u4f");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM + "nebel_u"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

 SetProp(P_MSGIN, "hoppelt heran");
 SetProp(P_MSGOUT, "hoppelt");


  AddId(({"kaninchen", "kaninchenmama","mama"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren scharfen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");  
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 0);
  SetProp(P_WIMPY, 50);

  SUID;
 	CLONEME(NEBEL_WEAPON "kaninchenzaehne" );
  command("zuecke zaehne");
  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Kaninchenmutter"); 
  AddInfo(DEFAULT_INFO, "muemmelt vor sich hin.\n");  


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kaninchenmama kann nichts tragen.\n" }) );


     SetChats(3, ({
       "Die Kaninchenmama muemmelt.\n", 
       "Die Kaninchenmama schueffelt aengstlich an Dir.\n",
       "Die Kaninchenmama nagt an etwas.\n",
       "Die Kaninchenmama hoppelt herum.\n" })) ;


 }

