inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine schrumpelige Wurzel");
  SetProp(P_LONG,
    "Du siehst eine kleine, schrumpelige Wurzel, sie ist leicht gelblich an den Raendern "
    "und riecht etwas faulig." );
  SetProp(P_NAME, "Wurzel");
  SetProp(P_GENDER, FEMALE);
  AddDetail( ({ "raender" }),
    "Die Raender der Wurzel sind leicht gelblich.");	
	
//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:4, 
											 F_HEAL:({15,15}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du kaust auf der Wurzel rum. Buaeh, nicht sonderlich lecker.", 
											 F_MSG_ROOM: "verspeist eine nicht ganz so leckere Wurzel."]));


AddId(({"wurzel"}));
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 50);

  AddCmd( ({ "rieche","riech" }), "riechen" );
 
}

int riechen(string str)
{
	if(str!="wurzel"&&str!="an wurzel") return 0;
	bswrite ("Die Wurzel ist nicht mehr ganz frisch und riecht faulig. Vielleicht muss das aber auch so sein.");
	return 1;
}