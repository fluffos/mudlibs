void reset()
{

  if(!present("\nfangeisen", TO)) 
  	{
  		tell_room(TO,"Ein Jaeger schleicht herein, stellt ein Fangeisen auf und versteckt "+
  		"es unter einem Haeuflein Laub.\nDer Jaeger schleicht davon.\n");
  		CLONE(NEBEL_OBJ + "fangeisen.lpc", TO);
  	} 
	::reset();	
  }	
	
void create() 
{
  ::create();
  CLONE(NEBEL_OBJ + "fangeisen.lpc", TO);
  wie_oft=50;
  geh_ich=4;

  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "osten", "ostlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
 }


int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6i", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="nordwesten"||str=="suedwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.");
			if(present("fangeisen",TO)) bswrite(" Ein Haeuflein Laub liegt neben einem Fangeisen auf dem Boden.\n");
			else if(present("laubhaeuflein",TO)) bswrite(" Ein Haeuflein Laub liegt auf dem Boden.\n");
			else bswrite("\n");
			return 1;
			}
		if(str=="haeuflein"||str=="laub"||str=="laubhaeuflein")
		{
			if(present("fangeisen",TO))bswrite("Das Haeuflein Laub liegt einfach so auf dem Boden.\n");
			else if(present("laubhaeuflein",TO)) 			bswrite("Es scheint sich darin etwas zu verbergen.\n");
			else bswrite("So etwas kannst Du nicht ertasten.\n");
			return 1;
			}
		if(str=="eisen"||str=="fangeisen")
		{
			if(present("fangeisen",TO))bswrite("Das Fangeisen ist hart, sehr scharf und sicher auch sehr gefaehrlich.\n");
			else bswrite("So etwas kannst Du nicht ertasten.\n");
			return 1;
			}			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}


	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
	else
		bswrite("So etwas kannst Du nicht ertasten.\n");
		return 1;	
			
	} 
