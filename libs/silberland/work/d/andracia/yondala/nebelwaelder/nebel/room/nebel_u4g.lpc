// Umgeschrieben fuers Silberland
// hier kann man einen Wurm rauspuhlen

//unterirdischer Kaninchenbau

#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
int wurmda;
void reset()
{
	::reset();
wurmda=random(5);
	}
void create() 
{
  ::create();
  wurmda=random(5);
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp( P_INT_SHORT, "In einem engen Gang" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten in einem engen Gang. Es ist sehr dunkel hier. Aber auch wenn man "
    "sehen kann entdeckt man nur weniges: Der Gang wurde in den Waldboden gegraben, auf dem "
    "Boden liegen Blaetter und kleinere Aeste herum. Die Decke ist sehr niedrig und Du musst "
    "aufpassen, Dir nicht staendig den Kopf zu stossen. " );
  AddDetail( ({ "gang" }),
    "Wo er wohl hinfuehrt?");
  AddDetail( ({ "waldboden", "boden" }),
    "Der ist rund um Dich herum und auch ueber Dir. Er ist ziemlich fest, wenn auch etwas loecherig "
    "an manchen Stellen.");
  AddDetail( ({ "blaetter" }),
    "Auf dem Boden liegen einige Blaetter herum. Sie rascheln, wenn Du an ihnen vorrueber laeufst.");
  AddDetail( ({ "aeste", "zweige" }),
    "Einige kleine Zweige und Aeste liegen auf dem Boden und knacken unter Deinen Schritten.");
  AddDetail( ({ "schritte","schritt" }),
    "Jeder, der laeuft macht Schritte. So ist das.");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr niedrig. Du musst darauf achten, Dir nicht dauernd den Kopf zu stossen.");
  AddDetail( ({ "kopf" }),
    "Gut, dass der angewachsen ist.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Waldboden.");
  AddDetail( ({ "stellen" }),
    "An manchen Stellen befinden sich Loecher im Waldboden.");
  AddDetail( ({ "loecher" }),
    "Die Loecher stammen vermutlich von Wuermern.");
  AddDetail( ({ "wuermer" }),
    "Die Wuermer lockern den Waldboden auf. Vielleicht koenntest Du einen herauspuhlen?");

  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille" }),
    "Es ist nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nassem Laub und feuchter Erde.");

  AddSmell( ({ "laub" }),
    "Es scheint sich dabei um die Blaetter zu handeln, die auf dem Boden liegen.");
  AddSmell( ({ "erde" }),
    "Natuerlich riecht es hier nach Erde, denn Du bist in einem Gang unter eben dieser.");
  AddSmell( ({ "blaetter" }),
    "Die Blaetter riechen leicht modrig.");

	
  AddCmd( ({ "puhle", "puhl" }), "puhlen" );

  AddExit( "westen", "./nebel_u4f" );
  AddExit( "nordosten", "./nebel_u3h" );
 }

int puhlen(string str)
{
	notify_fail("Was moechtest Du woraus puhlen?\n");
	if(str=="wurm heraus"||str=="wurm aus wand"||str=="wurm aus wand heraus"||
	   str=="wurm raus"||str=="wurm aus der wand"||str=="wurm aus der wand heraus"||
		 str=="wurm aus loch"||str=="wurm aus loch heraus"||
		 str=="wurm aus dem loch"||str=="wurm aus dem loch")
		 {
		 	if(wurmda)
		 		{
		 			bswrite("Du puhlst in der Wand herum und befoerderst damit tatsaechlich einen Wurm heraus.\n");
		 			say(TPN+" puhlt einen Wurm aus der Wand.\n",TP);
				  CLONE(NEBEL_NPC+"wurm.lpc",TO);
					wurmda--;
					return 1;
				}
			bswrite("Du puhlst in der Wand herum, aber leider wirst Du nicht fuendig.\n");
		 	say(TPN+" puhlt erfolglos in der Wand herum.\n",TP);
			return 1;
		}
		return 0;
	}
	