//Kann in einer Hoehle im Nebel freigeforscht werden. Wenn man ihn aus dem Nebel fuehrt
//bekommt man eventuell einen Zaubertrank
//Nach kurzer Zeit verschwindet er aber wieder aus Angst.
//Er sagt auch dem Raum Bescheid ob er grad auffindbar ist

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"
int wirdgefuehrt;
object fuehrer;
object hoehle;
/*
string hilfe()
{
 
  return "\n";
}
*/

void init()
{
  ::init();
  //wenn er in einem der drei Raeume ist
 /* if(file_name(environment(TO))==NEBEL_ROOM + "nebelweg_10"||
     file_name(environment(TO))==NEBEL_ROOM + "nebelweg_11"||
     file_name(environment(TO))==NEBEL_ROOM + "nebelweg_12")*/
	   if(file_name(environment(TO))=="/d/andracia/yondala/wege/room/nebelweg_10"||
     file_name(environment(TO))=="/d/andracia/yondala/wege/room/nebelweg_11"||
     file_name(environment(TO))=="/d/andracia/yondala/wege/room/nebelweg_12")
  {
    call_out("binda",1);

  }
}
binda()
{
	 if (present(fuehrer), environment(TO))
    	command("sag Habt Dank "+fuehrer->name()+", Ihr ward mir ein guter Fuehrer, von nun an finde ich sicher alleine nach Hause.");
      
    else 
    	tell_object(fuehrer,"Friedhelm teilt Dir mit: Habt Dank "+fuehrer->name()+", Ihr ward mir ein guter Fuehrer, von nun an finde ich sicher alleine nach Hause.\n");
      
    fuehrer->FindPotion("Friedhelm schenkt Dir aus Dankbarkeit einen kleinen Trank.\n");
    call_other(NEBEL_ROOM + "nebel_hoehle", "wiederda",0);
    tell_room(environment(TO),"Friedhelm laeuft davon.\n");
    remove();
  }
void create() {
  if (!is_clone(TO)) return;
  //SetProp(P_LOG_INFO, "yondalas_antworten");
  ::create();
  wirdgefuehrt=0;
  fuehrer=0;
	call_out("verstecken",20);
  SetProp(P_SHORT, "Friedhelm");
  SetProp(P_LONG,
    "Du siehst einen alten, klapprigen Mann vor Dir. Er ist bis auf die Knochen abgemagert und "
    "schaut Dich aus riesigen Augen an. Seine Haut ist blass, sein Haar steht wirr vom Kopf "
    "er hat viele Wunden und blaue Flecken. Kleidung hat er keine, lediglich ein paar Lumpen "
    "umhuellen ihn.");
  SetProp(P_NAME, "Friedhelm");
  SetProp(P_GENDER, MALE);
  AddId(({"friedhelm", "mann"}));
  SetProp(P_ARTICLE, 0);

  create_default_npc(10);

  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK, "duckt sich im Nebel weg.");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt zitternd an");
  SetProp(P_MSGOUT, "geht zitternd");
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Friedhelm");
  SetProp(P_KILL_MSG, "Haettest Du mir lieber geholfen.");


  AddInfo(DEFAULT_INFO, "sagt: Das weiss ich nicht, helft mir doch bitte statt zu fragen.\n");


  AddInfo( ({"hilfe","helfen"}),
    "Fuehrt mich doch bitte aus dem Nebel heraus.",
    "sagt: ");
  AddInfo( ({"nebel",""}),
    "Ich habe mich im Nebel verlaufen und weiss nicht mehr wie ich herauskomme.",
    "sagt: ");
  AddInfo( ({"weg","ausweg"}),
    "Den suche ich.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Friedhelm will nichts annehmen.\n" }) );

 /* SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));*/
  AddCmd( ({ "fuehre", "fuehr"}), "fuehren" );

  SetChats(10, ({
    "Friedhelm fragt: Wo bin ich bloss hier?\n",
    "Friedhelm sagt: Bitte, fuehrt mit aus dem Nebel!\n",
    "Friedhelm jammert: Ich will hier raus!\n"

    }) );
 

}

// Mitloggen wenn einen Spieler den NEBEL_NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  hoehle->wiederda(); 
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


int fuehren(string str)
{
  if(str=="friedhelm")
    {
      if(TP->QueryProp(P_PURSUERS)!=0 && member(TP->QueryProp(P_PURSUERS),TO)!=-1)//Wenn Friedhelm TP schon folgt
        {
          command("sag Aber ich folge Euch doch schon, "+TPN+".");
          return 1;
        }
      else if(wirdgefuehrt!=0)//wenn er schon irgendwem folgt
        {
          command("sag Aber ich folge doch schon "+fuehrer->name(WEM)+".");
          return 0;
        }
      //wenn er niemandem folgt
        command("sag Habt Dank, ich werde Euch nun folgen.");
        TP->AddPursuer(TO);
        fuehrer=TP;
        wirdgefuehrt=1;
        call_out("fuehrungsende",300);//in fuenf Minuten bekommt er Panik und beendet die Fuehrung.
        return 1;
      }
    
  else
    write("Wen willst Du fuehren?\n");
return 1; 
  }
  
fuehrungsende()
{
    if(file_name(environment(TP))!=NEBEL_ROOM )//Wenn er sich im falschen Raum befindet
      {
        if(present(fuehrer), environment(TO))
          command("sag Ich glaube nicht, dass Ihr mich auf dem richtigen Weg fuehrt, ich versuche es lieber alleine, hier ist es mir zu unheimlich.");

        else
          tell_object(fuehrer,"Friedhelm teilt Dir mit: Ich glaube nicht, dass Ihr mich auf dem richtigen Weg fuehrt,\n"+
                                "Friedhelm teilt Dir mit: ich versuche es lieber alleine, hier ist es mir zu unheimlich.\n");
            
            
        call_other(NEBEL_ROOM +"nebel_hoehle", "wiederda",0);
         remove();    
        }

  }
void verstecken()
{
	if(!fuehrer)
		{
			tell_room(environment(TO),"Friedhelm verkriecht sich wieder im Blaetterhaufen.\n");
			call_other(ROOM+"nebel_hoehle", "wiederda",0);
			remove();
		}
	}
			