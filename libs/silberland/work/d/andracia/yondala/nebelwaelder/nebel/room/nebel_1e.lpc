// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//greif in Nest-> Nebelkraehe kommt und hat nen Edelstein dabei
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int vogelda;


void reset()
{
	vogelda=1;
	::reset();	
  }
	
	
	
	
void create() 
{
  ::create();
	vogelda=1;
  geh_ich=3;
  wie_oft=35;

  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts spezifischem, die Luft ist nur sehr feucht.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");

  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "greife", "greif" }), "greifen" );
}
int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1f", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1d", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.\n");
			return 1;
			}
			
	if(str=="baeume")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume. Ein Baum fuehlt sich irgendwie anders an.\n");
			return 1;
			}
	if(str=="baum")
		{
			bswrite("Dieser Baum hat einen besonders langen Ast, der etwas hervorsteht.\n");
			return 1;
			}	
	if(str=="ast")
		{
			bswrite("Du tastest den Ast ab. Was ist denn da bloss in der Gabelung?\n");
			return 1;
			}
	if(str=="gabelung")
		{
			bswrite("In der Gabelung ist etwas, was sich elastisch, hoelzern anfuehlt. Ob es ein Vogelnest ist?\n");
			return 1;
			}
	if(str=="vogelnest"||str=="nest")
		{
			bswrite("Es scheint wirklich ein Nest zu sein. Du koenntest reingreifen um herauszufinden, "
			"ob Eier darin sind.\n");
			return 1;
			}
	if(str=="eier")
		{
			bswrite("Du musst dafuer in das Nest greifen.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
	return 0;		
	}

int greifen(string str)
{
	object kraehe;
	notify_fail("Wo moechtest Du reingreifen?\n");
	if(str=="in nest")
		{
			if(vogelda)
				{
					bswrite("Du fuehlst etwas flauschig-hartes.\nPloetzlich hackt Dir etwas auf die Finger.\n");
					TP->do_damage(5,"Ein spitzer Schnabel");
				  CLONE(NEBEL_NPC + "nebelkraehe.lpc", environment(TP));
				  kraehe=present("kraehe",TO);
				  //Idee: Der Kraehe einen Edelstein geben 
				  if(random(5)==0) "/obj/gemmaster"->DistributeGem(1, 0, 3, kraehe);
				  kraehe->Kill(TP);
				  vogelda=0;

				}
			else
				bswrite("Das Nest ist leer.\n");
			return 1;		
		}
return 0;
}
	