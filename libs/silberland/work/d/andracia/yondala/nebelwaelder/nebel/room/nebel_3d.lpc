// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

//hier kann man fauliges Wasser trinken, wenn man denn will
//Forscherpunkt auf ->riech Wasser
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  wie_oft=30;
  geh_ich=3;



   AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Schmatzen.");

  AddSound( ({ "schmatzen", "" }),
    "Scheinbar patschen Deine Fuesse durch ein kleines Gewaesser.");
  AddSound( ({ "ursprung", "" }),
    "Du lauschst angestrengt und bist Dir ziemlich sicher, dass es sich um einen kleinen Bach "
    "handeln muss.");
  AddSound( ({ "gewaesser", "fuesse" }),
    "Du bewegst Deine Fuesse ein wenig und hoerst die kleinen Wellen, die sie schlagen.");
  AddSound( ({ "wasser", "" }),
    "Ob man es trinken kann? Vielleicht solltest Du vorher daran riechen.");
  AddSound( ({ "wellen", "" }),
    "Du lauscht den Wellen, die Deine Fuesse im Wasser verursacht haben.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier irgendwie nicht gut, die Luft ist feucht und schwer.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");
  AddSmell( ({ "wasser" }),
    "Das Wasser riecht abgestanden und ekelig. Du solltest es besser nicht trinken.");


  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "trinke", "trink" }), "trinken" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "nordwesten", "nordwestlauf");
  AddSpecialExit( "suedosten", "suedostlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int suedostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int nordwestlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_2c", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="westen"||
		 str=="suedwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden"||str=="matsch")
		{
			bswrite("Der Boden ist hier matschig und sehr nass fast so, als wuerde hier Wasser stehen.\n");
			return 1;
			}
			
	if(str=="osten"||str=="nordwesten"||str=="suedosten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="bach"||str=="wasser"||str=="naesse")
		{
			bswrite("Du patschst mit Deinen Haenden ins Wasser. Es ist recht kuehl und ein wenig dickfluessig.\n");
			return 1;
			}
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(str=="wasser"||str=="wasser aus bach"||str=="aus bach")
		{
			if(TP->InFight())
				{
					bswrite("Dafuer hast Du gerade keine Zeit.\n");
					return 1;
				}
			if(TP->drink_soft(1))
				{
					bswrite("Du schoepfst Dir mit den Haenden etwas Wasser in den Mund. Buah ist das ekelig.\n");
					TP->AddPoison(1);
					return 1;
				}
		}
	return 0;
}