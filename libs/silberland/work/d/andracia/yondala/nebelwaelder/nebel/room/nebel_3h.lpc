// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
//Eingang zum Kaninchenbau, fuehrt zu 5d

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int kanin;	
void reset()
{
    kanin=1;
	::reset();	
}

void create() 
{
  ::create();
	kanin=1;
  wie_oft=50;
  geh_ich=4;


  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "unten", "untenlauf");

 
}


int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int untenlauf(string dir)
{
	if(kanin)
		{
			bswrite("Gerade als Du nach unten gehen willst, kommt Dir etwas entgegen.\n");
			tell_room(TO,"Ein Kaninchen stuermt an Dir vorbei und verschwindet im Nebel.\n");
			kanin=0;
			return 1;
		}
  return this_player()->move(NEBEL_ROOM+"nebel_u3h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||str=="osten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist sandig. Immerwieder ertastest Du Loecher darin.\n");
			return 1;
			}
			
	if(str=="unten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="loecher")
		{
			bswrite("Die Loecher sind alle recht klein. Ausser eines.\n");
			return 1;
			}
	if(str=="sand")
		{
			bswrite("Der Boden hier ist sehr sandig.\n");
			return 1;
			}
	if(str=="loch")
		{
			bswrite("Ein Loch gleich neben Dir ist ziemlich gross. So gross, dass es fast einem "+
			"Eingang gleicht.\n");
			return 1;
			}		
	if(str=="eingang")
		{
			bswrite("Ob Du einfach nach unten gehen kannst?\n");
			return 1;
			}		

	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}


