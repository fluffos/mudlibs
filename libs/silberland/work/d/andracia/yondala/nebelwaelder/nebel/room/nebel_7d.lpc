void create() 
{
  ::create();
  wie_oft=30;
		pilz=random(2);
		pilz+=2;
  geh_ich=3;
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");






  AddSpecialExit( "nordosten", "ostlauf");
  AddSpecialExit( "nordwesten", "westlauf");
 
  AddCmd( ({ "sammel", "sammle" }), "sammeln" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
 }
int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_6c", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="westen"||str=="osten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="nordosten"||str=="nordwesten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier ein wenig steiniger als weiter im Osten. Allerdings fuehlst Du "
			"auch einige sehr sehr weiche Steine.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="steine")
		{
			bswrite("Welche Steine meinst Du? Die weichen oder die harten?\n");
			return 1;
			}	
	if(str=="weiche steine")
		{
			bswrite("Vorsichtig tastest Du die weichen \"Steine\" ab. Du kommst zu dem Schluss, dass es vermutlich Pilze sind.\n");
			return 1;
			}
	if(str=="pilze")
		{
			bswrite("Hier wachsen einige Pilze aus dem Boden. Allerdings weisst Du nicht welche. Dazu muesstest Du sie einsammeln.\n");
			return 1;
			}
	if(str=="harte steine")
		{
			bswrite("Das scheinen ganz normale Steine zu sein.\n");
			return 1;
			}
	if(str=="schluss")
		{
			bswrite("Und wie denkst Du, fuehlt sich ein Schluss an?\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}

int sammeln(string str)
{
	notify_fail("Was moechtest Du sammeln?\n");
	if(str=="pilze"||str=="pilz"||str=="pilze ein"||str=="pilz ein")
		{
			if(pilz)
				{
					bswrite("Du bueckst Dich und sammelst einen Pilz.\n");
					if(random(2)==0)CLONE(NEBEL_OBJ +"champignon.lpc", TP);
			    else CLONE(NEBEL_OBJ +"fliegenpilz.lpc", TP);
			    pilz--;
			  }
			 else bswrite("Hier wurden schon genug Pilze gesammelt, vielleicht suchst Du besser woanders welche oder wartest, bis die hier nachgewachsen sind?\n");
			 	
			 return 1;
			}
		return 0;
}
