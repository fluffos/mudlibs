inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

void init()
{
	if(TP->id("schaf")) Kill(TP);
	::init();
	}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Nebelwoelfin");
  SetProp(P_LONG,
    "Du siehst eine kleine, graue Nebelwoelfin, die sich schuetzend vor ihre Jungen stellt. "
    "Sie ist kaum von ihrer Umgebung zu unterscheiden.");
  SetProp(P_NAME, "Nebelwoelfin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wolf", "woelfin", "nebelwoelfin","nebelwolf"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
  //CLONEME(ARMOUR"wolfsfell.lpc" );

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit ihren Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Raubtier");
  SetProp(P_SIZE, 70);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "trottet heran");
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Nebelwoelfin");

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Woelfin kann Deine Sachen nicht tragen.\n" }) );
  SetChats(5, ({
    "Die Woelfin leckt liebevoll eines ihrer Jungen sauber.\n",
    "Die Woelfin knurrt Dich an.\n",
    "Die Woelfin umrundet Dich schnueffelnd.\n",
    "Die Woelfin beobachtet jede Deiner Bewegungen.\n"}) );
  SetProp(P_SPELLRATE, 10);  
    AddSpell(2,400,
              "Die Nebelwoelfin springt Dir an den Hals.\n",
              "Die Nebelwoelfin springt @WEM an den Hals.\n",
              ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );
    AddSpell(4,200,
              "Die Nebelwoelfin beisst Dich.\n",
              "Die Nebelwoelfin beisst @WEN.\n",
              ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]) );
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
      Attack(TP);
      break;
    case "albern":
 			Attack(TP);
 			break;
    case "fies":
      Attack(TP);
      break;
    case "frech":
      Attack(TP);
      break;
    case "intim":
			Attack(TP);
      break;
    default: tell_room(environment(TO), "Die Woelfin zeigt keine Reaktion und bleibt wachsam.\n");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

