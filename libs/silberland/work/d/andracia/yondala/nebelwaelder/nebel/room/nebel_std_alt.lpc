		NEBEL_ROOM+"nebel_1i.lpc",
		NEBEL_ROOM+"nebel_2a.lpc",
		NEBEL_ROOM+"nebel_2b.lpc",
		NEBEL_ROOM+"nebel_2c.lpc",
		NEBEL_ROOM+"nebel_2h.lpc",
		NEBEL_ROOM+"nebel_2i.lpc",
		NEBEL_ROOM+"nebel_2j.lpc",
		NEBEL_ROOM+"nebel_3a.lpc",
		NEBEL_ROOM+"nebel_3b.lpc",
		NEBEL_ROOM+"nebel_3d.lpc",
		NEBEL_ROOM+"nebel_3e.lpc",
		NEBEL_ROOM+"nebel_3f.lpc",
		NEBEL_ROOM+"nebel_3g.lpc",
		NEBEL_ROOM+"nebel_3h.lpc",
		NEBEL_ROOM+"nebel_3j.lpc",
		NEBEL_ROOM+"nebel_4a.lpc",
		NEBEL_ROOM+"nebel_4c.lpc",
		NEBEL_ROOM+"nebel_4d.lpc",
		NEBEL_ROOM+"nebel_4e.lpc",
		NEBEL_ROOM+"nebel_4f.lpc",
		NEBEL_ROOM+"nebel_4g.lpc",
		NEBEL_ROOM+"nebel_4h.lpc",
		NEBEL_ROOM+"nebel_4i.lpc",
		NEBEL_ROOM+"nebel_4j.lpc",
		NEBEL_ROOM+"nebel_5a.lpc",
		NEBEL_ROOM+"nebel_5b.lpc",
		NEBEL_ROOM+"nebel_5d.lpc",
		NEBEL_ROOM+"nebel_5e.lpc",
		NEBEL_ROOM+"nebel_5f.lpc",
		NEBEL_ROOM+"nebel_5g.lpc",
		NEBEL_ROOM+"nebel_5h.lpc",
		NEBEL_ROOM+"nebel_5i.lpc",
		NEBEL_ROOM+"nebel_5j.lpc",
		NEBEL_ROOM+"nebel_6b.lpc",
		NEBEL_ROOM+"nebel_6c.lpc",
		NEBEL_ROOM+"nebel_6e.lpc",
		NEBEL_ROOM+"nebel_6f.lpc",
		NEBEL_ROOM+"nebel_6g.lpc",
		NEBEL_ROOM+"nebel_6h.lpc",
		NEBEL_ROOM+"nebel_6i.lpc",
		NEBEL_ROOM+"nebel_6j.lpc",
		NEBEL_ROOM+"nebel_7d.lpc",
		NEBEL_ROOM+"nebel_7f.lpc",
		NEBEL_ROOM+"nebel_hoehle.lpc",
		NEBEL_ROOM+"nebel_std.lpc",
		NEBEL_ROOM+"nebel_tanne.lpc",
		NEBEL_ROOM+"nebel_u3h.lpc",
		NEBEL_ROOM+"nebel_u4e.lpc",
		NEBEL_ROOM+"nebel_u4f.lpc",
		NEBEL_ROOM+"nebel_u4g.lpc",
	    NEBEL_ROOM+"nebel_u5d.lpc" });

		alle_raeume=({});
	for(i=sizeof(alle_namen)-1;i>=0;i--)
	{
		call_other(alle_namen[i], "???",0);
		alle_raeume=alle_raeume+({to_object(alle_namen[i])});
	}
	
	for(i=sizeof(alle_raeume)-1;i>=0;i--)
	{
		raum=alle_raeume[i];

		if(all_inventory(raum))
		{
			//tell_room(TO, i+" findet was.\n");
			for(ob=first_inventory(raum);ob;) 
			{       
				if(ob->id("\nkleinernebelgeist")) anzahl+=1;
				if(ob->id("\nmittlerernebelgeist")) anzahl+=2;
				if(ob->id("\ngrossernebelgeist")) anzahl+=4;
				if(ob->id("\ngigantischernebelgeist")) anzahl+=8;
				if(ob->id("\nebeldrache")) anzahl+=16;

				ob=next_inventory(raum);
			}
		}
	}
	

    if(anzahl<=20)	CLONE(NEBEL_NPC + "nebelgeist_klein.lpc", TO);	
	weiteres();
	
	::reset();	
	

  }
  
void create() 
{
  ::create();
  geh_ich=2;
  wie_oft=15;
  
  if(!present("nebelgeist",TO)&& random(2)==1)
    {
      if(call_other(NEBEL_ROOM+"nebelgeistmaster.lpc","darfichgeist")==1) 
       CLONE(NEBEL_NPC + "nebelgeist_klein.lpc", TO);
      } 

  SetProp( P_INT_SHORT, "Im Nebel" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem so dichten Nebel, dass Du absolut nichts sehen kannst; weder "
    "siehst Du Deine Fuesse, noch den Boden oder wohin Du gehen kannst. Lediglich wenn "
    "Du Dir Deine Hand vor die Augen haeltst kannst Du sie erkennen. Um Dich herum ist alles "
    "einfach nur weiss, nur ein paar Schatten deuten an, dass Du Dich vermutlich in einem "
    "Wald befindest." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "wald" }),
    "Du siehst lediglich ein paar Schatten im Nebel von denen Du ausgehst, dass es Baeume sind. "
    "Zumindest hoffst Du das.");
  AddDetail( ({ "nebel", "nebelschwaden","schwaden" }),
    "Der Nebel ist hier dick wie Suppe. Du siehst einfach nichts anderes.");
  AddDetail( ({ "baeume" }),
    "Um was fuer Baeume es sich handelt kannst Du nicht ausmachen, sie sind fuer Dich nur "
    "dunkle Schatten im hellen Nebel. Wo welche stehen koenntest Du vielleicht ertasten.");
  AddDetail( ({ "fuesse" }),
    "Die werden schon irgendwo da unten sein, sehen kannst Du sie allerdings nicht.");
  AddDetail( ({ "himmel" }),
    "Da auch ueber Dir Nebel ist kannst Du den Himmel nicht sehen.");
  AddDetail( ({ "boden" }),
    "Durch den dichten Nebel siehst Du nicht einmal den Boden auf dem Du stehst. Deine Fuesse "
    "melden Dir aber, dass er weich und fast schon ein wenig sumpfig ist.");
  AddDetail( ({ "hand","haende" }),
    "Deine Haende zittern ein wenig.");
  AddDetail( ({ "augen" }),
    "Also die kannst Du nicht sehen und das liegt nicht am Nebel.");
  AddDetail( ({ "schatten" }),
    "Die Schatten werden vermutlich Baeume sein und hoffentlich nichts Schlimmeres.");
  AddDetail( ({ "schlimmeres" }),
    "Wer weiss, was hier alles unerkannt lauert.");

  AddDetail( ({ "richtungen", "richtung" }),
    "Du koenntest versuchen eine Richtung zu ertasten.");
  AddDetail( ({ "suppe" }),
    "Eine heisse Suppe waere jetzt was feines. Aber dafuer musst Du hier erstmal wieder raus.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

//in den einzelnen Raeumen moeglichst unterschiedliche Gerueche und Geraeusche.
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort. Nur hin und wieder vernimmst Du leisen Gesang.");
  AddSound( ({ "gesang" }),
    "Der Gesang kommt aus dem Westen und klingt sehr verlockend.");
  AddSound( ({ "westen" }),
    "Von Westen kommt verlockender Gesang, Du solltest nachschauen, was dort ist.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts spezifischem, die Luft ist nur sehr feucht.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");



//wie_oft wird in jedem Raum gesetzt um die Haeufigkeit individuell anzupassen 

  AddRoomMessage( 
    ({"Du hoerst einen leisen Gesang aus dem Westen.\n",
      "Du fragst Dich, was wohl im Westen sein mag.\n",
      "Alles in Dir will einfach nur nach Westen.\n"})
      ,wie_oft,"westengeher");
    
  AddSpecialExit( ({"norden", "sueden", "osten", "westen","suedwesten","suedosten","nordwesten","nordosten"}), "baumlauf");

  SetProp(P_HIDE_EXITS, 1);
  AddCmd( ({ "halte", "halt" }), "halten" );

}

int baumlauf(string dir)
{
  if(!interactive(TP)) return 1;
  if(TP->QueryProp(P_NOMOVE)) 
    {
      bswrite(TP->QueryProp(P_NOMOVE));
      return 1;
    }
  bswrite("Du laeufst gegen einen Baum.\n");
  say(TPN+" laeuft mit voller Wucht gegen einen Baum.\n",TP);
  TP->do_damage(10, "Ein Baum");
  return 1;
}

int halten(string str)
{
  notify_fail("Was moechtest Du vor was halten?\n");
  if(str=="hand vor augen"||str=="hand vor die augen")
    {
      bswrite("Du haelst Dir kurz die Hand vor die Augen. Ja, so kannst Du sie sehen. Da das auf Dauer aber keinen Sinn macht nimmst Du die Hand wieder runter.\n");
      say(TPN+" haelt sich kurz die Hand vor die Augen.\n",TP);
      return 1;
    }
  return 0;
}

//Einer der Spieler im Raum wird wie in Trance nach Westen gezogen. 
//per command, entweder geht er nach westen bis er die Klippe runterstuerzt, oder 
//er laeuft bis zu seinem Tod gegen Baeume 
//geh_ich wird in jedem Raum gesetzt um die Wahrscheinlichkeit individuell anzupassen 
void westengeher(int msg) 
{ 
	object geher; 
	mixed *spieler; 
	if(random(geh_ich)!=1)return;

  if (msg==2)
    {
        spieler=filter_array( all_inventory(), #'interactive );
        //map_array(spieler, #'alleraus);
      
  if(!sizeof(spieler)) return;
  geher=spieler[random(sizeof(spieler))];
  tell_room(TO,geher->name()+" bekommt einen verklaerten Blick.\n", ({geher}));
  tell_object(geher, "Du haelst es nicht mehr aus, Du willst nur noch nach Westen.\n");
  geher->command_me("westen");
  }
  }
