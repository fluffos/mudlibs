{

	object ob;
	object *alle_raeume;
	string *alle_namen;
	object raum;
	int i;
	int anzahl;

	anzahl=0;	
	alle_namen=({NEBEL_ROOM+"nebel_1d.lpc",
		NEBEL_ROOM+"nebel_1e.lpc",
		NEBEL_ROOM+"nebel_1f.lpc",
		NEBEL_ROOM+"nebel_1g.lpc",
