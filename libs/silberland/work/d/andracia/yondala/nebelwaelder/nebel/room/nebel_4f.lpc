// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//Ameisenhaufen. Wenn man gegen tritt greifen Ameisen an
//->Forscherpunkt
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  wie_oft=40;
  geh_ich=4;



  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "trete", "tritt","tret" }), "treten" );

  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	notify_fail("So etwas kannst Du nicht ertasten.\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier relativ weich, so wie normaler Waldboden. Allerdings ertastest "
			"Du direkt neben Dir einen grossen Huckel.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="huckel")
		{
			bswrite("Der Huckel fuehlt sich fast schon an wie ein kleiner Huegel. Ausserdem krabbelt "
			"und wuselt es darauf wie wild.\n");
			return 1;
			}
	if(str=="huegel")
		{
			bswrite("Ob es sich um einen Ameisenhuegel handelt?\n");
			return 1;
			}		
	if(str=="ameisenhuegel"||str=="ameisenhaufen")
		{
			bswrite("Ja, Du bist Dir ziemlich sicher, dass es sich um einen Ameisenhuegel handeln muss. "+
			"Schnell nimmst Du Deine Haende davon, eh Dich die Ameisen noch angreifen.\n");
			return 1;
			}			
	if(str=="ameisen")
		{
			bswrite("Du patschst noch mal auf dem Ameisenhaufen herum. Ganz schoen bloed, diese Ameisen. "+
			"Bauen ihren Huegel mitten in den Weg, wie leicht tritt dort jemand versehentlich drauf...\n");
			return 1;
			}

	else 
			return 0;
		
	
	
	}



int treten(string str)
{
	object treter, ameise;
	notify_fail("Worauf moechtest Du treten?"); 
	if(str=="auf ameisenhuegel"||str=="auf ameisenhuegel"||str=="auf haufen"||str=="auf huegel"||
		 str=="haufen"||str=="huegel"||str=="gegen haufen"||str=="gegen huegel"||
		 str=="gegen ameisenhaufen"||str=="gegen ameisenhuegel")
		{
       bswrite("Du trittst gegen den Ameisenhaufen.\n");
       
       if(!present("ameise", TO))
			 	{
			 		//bswrite("Einige wuetende Ameisen kommen daraus hervor.\n");
					AddItem( NEBEL_NPC+"ameise.lpc" , REFRESH_NONE);
				}
				else
					{
						bswrite("Die Ameise beisst Dich\n");
						say("Die Ameise beisst "+TPN+".\n");
						TP->AddHp(-5);
					}
						
				  ameise=present("ameise", TO);
				  ameise->Kill(TP);


					return 1;
		}
		return 0;
	}