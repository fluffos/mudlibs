inherit "std/npc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <npc.h>


void andecke()
{
	if(InFight(TO)) call_out("andecke",5);
	else
		{
			tell_room(environment(TO),"Die Fledermaus haengt sich wieder an die Decke.\n");
			remove();
		}
	}

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();
call_out("andecke",50);
  SetProp(P_SHORT, "Eine Fledermaus");
  SetProp(P_LONG,
    "Du siehst eine grosse schwarze Fledermaus, die hier aufgeregt herumflattert.");
  SetProp(P_NAME, "Fledermaus"); 
  SetProp(P_GENDER, FEMALE);

  SetProp(P_MSGIN, "flattert aufgebracht herein");
  SetProp(P_MSGOUT, "flattert");


  AddId(({"fledermaus"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Fledermaus");  
  SetProp(P_SIZE, 15);
  SetProp(P_WEIGHT, 80);
  SetProp(P_ALIGN, 0);


	//CLONEME(OBJ "nebelkraehenfeder" );



  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Eine Fledermaus"); 
  AddInfo(DEFAULT_INFO, "flattert.\n");  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 5); 




  AddSpell(1,50,
              "Die Fledermaus piept laut!\n",
              "Die Fledermauss piept @WEM ins Ohr.\n",
              DT_SOUND, "taub", ([SP_SHOW_DAMAGE:1]) );

}

     void taub(object enemy, int damage, mixed dam_type) 
     {
       enemy->SetProp(P_DEAF, 3+random(3));
     }