// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
// Ein Spinnennetz, das man zerreissen muss um nach Osten zu koennen

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int netzda;

void reset()
{
			
	if(!netzda)
			{
				tell_room(TO, "Eine Spinne spinnt blitzschnell ein Netz im Osten.\n");
				netzda =1;
				call_other(NEBEL_ROOM+"nebel_6c","netzda",0);
			}
	::reset();	
  }
void create() 
{
  ::create();
  netzda=1;
  wie_oft=20;

  call_other(NEBEL_ROOM+"nebel_6c","netzda",0);
	AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddExit( "osten", "./nebel_6c" );
  AddExit( "nordwesten", "./nebel_5a" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "zerreisse", "zerreiss","zerstoere","zerstoer" }), "zerstoeren" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "nordwesten", "nordwestlauf");
}

int ostlauf(string dir)
{
  if(netzda)
  	{
  		bswrite("Du verfaengst Dich in einem grossen Spinnenetz.\n");
  		TP->SetProp(P_NOMOVE, "Du haengst in einem Spinnennetz fest.\n");
  		return 1;
  	}
      return this_player()->move(NEBEL_ROOM+"nebel_6c", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int nordwestlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5a", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="suedwesten"||str=="sueden"||str=="suedosten"||str=="nordosten"||
		 str=="westen"||str=="norden")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier relativ weich. Gleich vor Dir liegt allerdings etwas Hartes.\n");
			return 1;
			}
			
	if(str=="nordwesten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="osten")
		{
			if(netzda) bswrite("Dort haengt etwas grosses, Klebriges.\n");
			else  		 bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="klebriges")
		{
			if(netzda) bswrite("Es fuehlt sich an wie ein Spinnennetz.\n");
			else  		 bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
			}
	if(str=="spinnennetz"||str=="netz")
		{
			if(netzda) bswrite("Du wirst es zerreissen muessen um weiter nach Osten gehen zu koennen.\n");
			else  		 bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	



	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int zerstoeren(string str)
{
	object next, ob;
	notify_fail("Was moechtest Du zerstoeren?\n");
	if(str=="netz"||str=="spinnennetz")
		{
			if(netzda)
				{
					if(TP->QueryProp(P_NOMOVE)!="Du haengst in einem Spinnennetz fest.\n")
						bswrite("Du zerstoerst das Spinnennetz.\n");
					call_other(NEBEL_ROOM+"nebel_6c","netzweg",0);
					
					 for(ob=first_inventory(TO);ob;ob=next_inventory(ob)) 
					 {
					 	if(interactive(ob))
					 		{
					 			if(ob->QueryProp(P_NOMOVE)=="Du haengst in einem Spinnennetz fest.\n") 
					 				{
					 					ob->SetProp(P_NOMOVE, 0);
					 					if (ob!=TP) tell_object(ob,TPN+" zerstoert das Netz und Du bist frei.\n");
					 					else tell_object(ob,"Du zerstoerst das Netz und bist frei.\n");	
					 				}
					 			}
					 		}
           
        
					netzda=0;
				}
			else bswrite("Da ist kein Netz.\n");
			return 1;
		}
	return 0;
}

void netzweg()
{
	object next, ob;
	tell_room(TO,"Jemand zerstoert von der anderen Seite das Spinnennetz.\n");
	netzda=0;
	for(ob=first_inventory(TO);ob;ob=next_inventory(ob)) 
	  {
		  if(interactive(ob))
			  {
				  if(ob->QueryProp(P_NOMOVE)=="Du haengst in einem Spinnennetz fest.\n") 
					  {
					 	  ob->SetProp(P_NOMOVE, 0);
					 			if (ob!=TP) tell_object(ob,"Du bist frei.\n");
					 	}
					}
			}
	}

void netzda()
{
  tell_room(TO, "Eine Spinne spinnt blitzschnell ein Netz im Osten.\n");
	netzda=1;
}	