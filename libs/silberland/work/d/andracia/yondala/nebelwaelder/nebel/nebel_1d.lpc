void create() 
{
  ::create();
  wie_oft=30;
  geh_ich=3;
  wurzel=2;
  AddSound( DEFAULT_SOUND,
    "Es ist hier absolut still.");

  AddSound( ({ "stille", "ort" }),
    "Eine unheimliche Stille lastet auf diesem Ort.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts spezifischem, die Luft ist nur sehr feucht.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");

  //AddExit( "osten", "./nebel_1e" );
  AddCmd( ({ "brich", "brech","breche" }), "brechen" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");

}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="westen"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich. Du kannst einige Unebenheiten ertasten.\n");
			return 1;
			}
			
	if(str=="osten")
		{
			bswrite("Der Weg nach dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}
	if(str=="unebenheiten"||str=="unebenheit")
		{
			bswrite("Es scheint sich dabei um Wurzeln zu handeln.\n");
			return 1;
			}
	if(str=="wurzeln")
		{
			bswrite("Vielleicht kannst Du ja eine abbrechen?\n");
			return 1;
			}
	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}
		
			
	return 0;
	
	
	}

//Forscherpunkt
int brechen(string str)
{
	notify_fail("Was moechtest Du abbrechen?\n");
	if(str=="wurzel ab"||str=="wurzeln ab")
		{
			if(wurzel)
				{
					bswrite("Du brichst eine Wurzel ab und steckst sie ein.\n");
					wurzel--;
					CLONE(NEBEL_OBJ + "wurzel.lpc", TP);
					
				}
			else bswrite("Leider schaffst Du es nicht, eine Wurzel abzubrechen.\n");
			return 1;
		}	
		return 0;
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }