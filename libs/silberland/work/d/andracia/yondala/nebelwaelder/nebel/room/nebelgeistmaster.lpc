//Der Master regelt, wieviele kleine Nebelgeister unterwegs sein duerfen.

#include "../def.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
int geister;


void create() 
{
  ::create();
  geister=30;
  
}

//Jeder Raum fragt bei reset an, ob er nen Geist clonen darf.
int darfichgeist()
{
	if(geister>0)
		{
			geister--;
			return 1;
		}
	return 0;
}

//Jeder Geist, der stirbt meldet hier sein Groesse, damit immer nur 30 Geisteinheiten im Spiel sind
void totergeist(int groesse)
{
	geister+=groesse;
}
	