// Umgeschrieben fuers Silberland

//hier kann man was trinken(FP)

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  wie_oft=45;
  geh_ich=4;

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Glucksen.");

  AddSound( ({ "glucksen"}),
    "Es scheint seinen Ursprung rechts neben Dir zu haben.");
  AddSound( ({ "ursprung", "" }),
    "Du lauschst angestrengt und bist Dir ziemlich sicher, dass es sich um einen kleinen Bach "
    "handeln muss.");
  AddSound( ({ "bach", "" }),
    "Ja, es ist bestimmt ein Bach, das erkennst Du am Glucksen.");
  AddSound( ({ "wasser", "" }),
    "Ob man es trinken kann? Vielleicht solltest Du vorher daran riechen.");
  AddSound( ({ "", "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts spezifischem, die Luft ist nur sehr feucht.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr feucht, was es Dir erschwert richtig zu atmen.");
  AddSmell( ({ "wasser" }),
    "Es riecht frisch und klar. Du bist fast sicher, dass man es gefahrlos trinken kann.");


  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "trinke", "trink" }), "trinken" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1f", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="bach"||str=="wasser")
		{
			bswrite("Du patschst mit Deinen Haenden ins Wasser. Es ist herrlich kuehl und frisch.\n");
			return 1;
			}
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(str=="wasser"||str=="wasser aus bach"||str=="aus bach")
		{
			if(TP->InFight())
				{
					bswrite("Dafuer hast Du gerade keine Zeit.\n");
					return 1;
				}
			if(TP->drink_soft(3))
				{
					bswrite("Du schoepfst Dir mit den Haenden etwas Wasser in den Mund. Hach, das erfrischt.\n");
					TP->AddHp(15);
					TP->AddSp(15);
					return 1;
				}
		}
	return 0;
}