// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int himbeere;

void reset()
{
	himbeere=2+random(4);
	::reset();	
}

void create() 
{
  ::create();
  geh_ich=5;
  wie_oft=60;

 
  AddSpecialExit( "suedwesten", "suedwestlauf");
  AddSpecialExit( "osten", "ostlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "pfluecke", "pflueck" }), "pfluecken" );
}
int pfluecken(string str)
{
	notify_fail("Was moechtest Du pfluecken?\n");
	if(str!="himbeere"&&str!="beere"&&str!="himbeeren"&&str!="beeren") return 0;
	if(!himbeere) 
		{
			bswrite ("Du versuchst eine Himbeere zu pfluecken, verletzt Dich aber an den Dornen des "+
			"Busches. Gerade ist wohl keine reife Beere mehr in Reichweite.\n");
			TP->AddHp(-2);
			return 1;
		}
	else
		{
			bswrite("Du pflueckst eine saftige rote Himbeere und steckst sie ein.\n");
			CLONE(NEBEL_OBJ +"himbeere.lpc", TP);
			himbeere--;
			return 1;
		}
	return 0;

	
	}
	
int ostlauf(string dir)
{
  return this_player()->move("/d/andracia/yondala/wege/room/nebelweg_10", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int suedwestlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4i", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="nordwesten"||str=="westen"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="osten"||str=="suedwesten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume. Hier sind sie allerdings von relativ dichtem Buschwerk umgeben.\n");
			return 1;
			}
	if(str=="buschwerk"||str=="buesche")
		{
			bswrite("Die Buesche hier haben relativ grosse Blaetter und auch ein paar Dornen.\n");
			return 1;
			}	
	if(str=="blaetter")
		{
			bswrite("Die Blaetter der Buesche sind duenn, relativ gross und ein wenig gezackt an den Raendern.\n");
			return 1;
			}
	if(str=="raender")
		{
			bswrite("Die Raender der Blaetter sind gezackt.\n");
			return 1;
			}
	if(str=="dornen"||str=="dorne")
		{
			bswrite("Die Dornen sind sehr spitz, pass auf, dass Du Dich nicht verletzt. Zwischen den "
			"Kugeln ertastest Du hin und wieder etwas Rundliches.\n");
			return 1;
			}
	if(str=="etwas"||str=="rundliches")
		{
			bswrite("Gut moeglich, dass es Beeren sind.\n");
			return 1;
			}
	if(str=="beere"||str=="beeren")
		{
			bswrite("Vielleicht kannst Du ja welche pfluecken.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}


