//[x] 1  klein
//[ ] 2  mittel
//[ ] 4  gross
//[ ] 8  gigantisch
//[ ] 16 drache

//fusioniert mit einem anderen kleinen Nebelgeist.

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>



void fusion()
{
	if(TP&&!InFight()&&!TP->InFight()&&present(TP,environment(TO)))
		{
			//if(random(3)==1)
				//{
					tell_room(environment(TO),"Die beiden kleinen Nebelgeister fusionieren miteinander.\n");
					TP->remove();
				  CLONE(NEBEL_NPC"nebelgeist_mittel",environment(TO));
				  remove();
				//}
   }
}
		
void init()
{
	::init();
	if(TP->id("\nkleinernebelgeist")) //wenn der andere ein Nebelgeist ist.
		{
			call_out("fusion",3);
		}
	}


void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Nebelgeist");
  SetProp(P_LONG,
    "Mitten im Nebel siehst Du einen kleinen Nebelgeist. Er ist fast durchsichtig und scheint "
    "harmlos zu sein.");
  SetProp(P_NAME, "Nebelgeist"); 
  SetProp(P_NAME_ADJ,"klein");  
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);

SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM+"nebel_4a");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_SPECIAL);
SetProp (P_MNPC_WAIT, ({5, 15, 10}));

  SetProp(P_MSGIN, "weht herein");
  SetProp(P_MSGOUT, "weht");
 

  AddId(({"geist","nebelgeist","\nkleinernebelgeist"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit grosser Kaelte",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");  
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOCORPSE, 1);
SUID;
  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_KILL_NAME, "Ein kleiner Nebelgeist"); 
  AddInfo(DEFAULT_INFO, "haucht: ghhhefaaahhhhhr.\n");  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Geist kann nichts tragen.\n" }) );

SetProp(P_SPELLRATE,15);
     SetChats(3, ({
       "Der Nebelgeist wabert umher.\n", 
       "Der Nebelgeist verschwindet kurz in einer Nebelwehe.\n",
       "Der Nebelgeist schwirrt um Dich herum.\n",
       "Der Nebelgeist fliegt durch Dich durch.\n",
       "Der Nebelgeist verursacht eine Gaensehaut bei Dir.\n" })) ;

AddSpell(1,100,
              "Der kleine Nebelgeist haucht Dich an.\n",
              "Der kleine Nebelgeist haucht @WEN an.\n",
              ({DT_COLD}), ([SP_SHOW_DAMAGE:0]) );
 }



void geistloeschen()
{
	int geisterzahl;
	geisterzahl=to_int(read_file(NEBEL_ROOM+"geisterzahl.txt",1,1));
	if(!geisterzahl) 
	{
		geisterzahl=1;
		//Geisterzahl darf nie 0 sein, wenn ein Geist sie abfragt
		//vermutlich hat dann jemand per Hand daran rumgewerkerlt
		//oder das ganze Gebiet zurueckgesetzt. Dann bitte immer 
		//haendisch NEBEL_ROOM+"geisterzahl.txt" auf 0 setzen
		tell_room(TO, "GEISTERFEHLER 01, BITTE YONDALA ODER ERZMAGIER KONTAKTIEREN!\n");
	}
	geisterzahl--;
	rm(NEBEL_ROOM+"geisterzahl.txt");	 
	write_file(NEBEL_ROOM+ "geisterzahl.txt",to_string(geisterzahl));
}


void die(int poisondeath) 
{
	geistloeschen();
  ::die(poisondeath);
}
