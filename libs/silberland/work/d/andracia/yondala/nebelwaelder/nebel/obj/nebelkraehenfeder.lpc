#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Feder");
  SetProp(P_LONG,
    "Du siehst eine lange schwarze Feder, die sicher mal einer Kraehe gehoert hat." );
  SetProp(P_NAME, "Feder");
  SetProp(P_GENDER, FEMALE);
  AddId(({"feder","kraehenfeder"}));
SetProp( P_MATERIAL, MAT_FEATHER );

  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
 
}


	