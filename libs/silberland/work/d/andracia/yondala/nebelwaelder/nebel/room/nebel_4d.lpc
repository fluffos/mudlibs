// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
//Man sitzt in einem Wasserloch und kann nur raus klettern.
//Per random kommt man nach Osten oder Westen
//Wurzel finden aus der man Zauberstab machen kann.
//Forscherpunkt auf tauche nach kugel/schaedel
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int wurzelda;

void init()
{
	::init();
  SetProp(P_KILL_NAME,"ein tiefer Fall");
	if(!interactive(TP)) return;
  if(TP) TP->do_damage(15,TO);
}


void reset()
{
  ::reset();
    wurzelda=1;
  }
void create()
{
  ::create();
  wie_oft=30;
  geh_ich=3;
  SetProp( P_INT_LONG,
    "Du stehst bis zur Huefte in eiskaltem Wasser. Um Dich herum herrscht weiterhin dichtester "
    "Nebel. Du siehst absolut nichts; weder "
    "siehst Du Deine Fuesse, noch das Wasser in dem Du stehst. Lediglich wenn "
    "Du Dir Deine Hand vor die Augen haelst kannst Du sie erkennen. Um Dich herum ist alles "
    "einfach nur weiss, nur ein paar Schatten deuten an, dass Du Dich vermutlich in einem "
    "Wald befindest." );
wurzelda=1;


  AddSpecialExit( ({"norden", "sueden", "osten", "westen","suedwesten","suedosten","nordwesten","nordosten"}), "laufversuch");

  AddCmd( ({ "kletter", "klettere" }), "klettern" );
  AddCmd( ({ "trinke","trink" }), "trinken" );

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddCmd( ({ "tauche", "tauch" }), "tauchen" );
  AddCmd( ({ "brich", "brech","breche" }), "brechen" );


}

int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if (str!="wasser") return 0;
	bswrite("Gerade als Du etwas von dem Wasser trinken willst, kommt Dir "+
	"der Gedanke, dass es vielleicht nicht so schlau ist, etwas zu trinken, "+
	"was Du nicht kennst und nicht sehen kannst.\nDu trinkst nicht von dem Wasser.\n");
	return 1;
}


int tasten(string str)
{
  notify_fail("Was moechtest Du ertasten?\n");
  if (!str) return 0;
  if(str=="norden"||str=="sueden"||str=="suedosten"||
     str=="suedwesten"||str=="nordosten"||str=="osten"||str=="westen"||str=="nordwesten")
  {
    bswrite("Dort ertastest Du eine Wand.\n");
    return 1;
  }
  if(str=="boden")
    {
      bswrite("Um den Boden zu ertasten muesstest Du schon tauchen.\n");
      return 1;
      }

  if(str=="wand")
    {
      bswrite("Fast ueberall ertastest Du nur Waende.\n");
      return 1;
      }
  if(str=="baeume"||str=="baum")
    {
      bswrite("Die kannst Du nicht ertasten, lediglich ein paar Wurzeln fuehlst Du.\n");
      return 1;
      }
  if(str=="richtungen"||str=="richtung"||str=="weg")
    {
      bswrite("Welche Richtung moechtest Du denn ertasten?\n");
      return 1;
      }

  if(str=="fuesse")
    {
      bswrite("Sind beide noch da.\n");
      return 1;
      }
  if(str=="waende")
    {
      bswrite("Du bist von Waenden umgeben, da Du ja in einem Loch steckst. Hin und wieder "+
      "ertastest Du eine Unebenheit.\n");
      return 1;
      }

  if(str=="unebenheit")
    {
      bswrite("Es koennte sich dabei um Wurzeln handeln.\n");
      return 1;
      }
  if(str=="wurzeln")
    {
      bswrite("Es fuehlt sich so an, als koenntest Du die Wurzeln der Baeume ertasten.\n");
      if(wurzelda)bswrite("Eine Wurzel ist besonders hart und lang.\n");
      return 1;
      }
  if(str=="wurzel")
    {
      if(wurzelda)bswrite("Ob man sie herausbrechen kann?\n");
      else bswrite("Es fuehlt sich so an, als koenntest Du die Wurzeln der Baeume ertasten.\n");
      return 1;
      }
  if(str=="loch")
    {
      bswrite("Du stehst in einem Loch welches bis zu Deiner Huefte mit Wasser gefuellt ist.\n");
      return 1;
      }
  if(str=="huefte")
    {
      bswrite("Bis dorthin steht Dir das Wasser.\n");
      return 1;
      }
  if(str=="wasser")
    {
      bswrite("Das Wasser ist eiskalt, Du spuerst keine Bewegung darin, es scheint sich also "
      "um ein stehendes Gewaesser zu handeln.\n");
      return 1;
      }
  if(str=="gewaesser"||str=="bewegung"||str=="bewegungen")
    {
      bswrite("Da Du keine Bewegungen spuerst gehst Du davon aus, dass Du Dich in einem stehenden "+
      "Gewaesser befindest.\n");
      return 1;
      }
  if(str=="grund")
    {
      bswrite("Den kannst Du nur ertasten, wenn Du tauchst.\n");
      return 1;
      }
  if(str=="algen"||str=="kugel"||str=="rundes"||str=="schaedel"||str=="schlamm")
    {
      bswrite("Danach musst Du tauchen.\n");
      return 1;
      }


  else
    {
      bswrite("Sowas kannst Du nicht ertasten.\n");
      return 1;
    }


  }

int klettern(string str)
{
  notify_fail("Woraus moechtest Du klettern?\n");
  if(str=="aus loch"||str=="aus loch heraus"||str=="aus loch raus"||
     str=="raus"||str=="heraus"||str=="rauf")
     {
      if(random(5)==0)
        {
          bswrite("Du kletterst nach Osten aus dem Loch heraus.\n");
          this_player()->move(NEBEL_ROOM+"nebel_4e", M_GO, 0,
                  "klettert aus dem Loch", "tritt aus dem Nebel");
        }
       else
        {
          bswrite("Du kletterst nach Westen aus dem Loch heraus.\n");
          this_player()->move(NEBEL_ROOM+"nebel_4c", M_GO, 0,
                  "klettert aus dem Loch", "tritt aus dem Nebel");
       }
        return 1;
      }
      return 0;
    }

int laufversuch(string dir)
{
		if(!interactive(TP)) 
		 this_player()->move(NEBEL_ROOM+"nebel_4e", M_GO, 0,
         "schwebt aus dem Loch", "schwebt herein");

  bswrite("Du versuchst zu laufen, es klappt aber nicht. Du musst schon klettern.\n");
  TP->do_damage(5, "Ein Baum");
  return 1;
}

int tauchen(string str)
{
  notify_fail("Wohin oder wonach moechtest Du tauchen?\n");
  if(str=="unter"||str=="nach unten"||str=="in wasser"||str=="in gewaesser"||!str)
    bswrite("Du tauchst unter und betastest den Boden. Ausser Schlamm fuehlst Du nur Algen.\n");
  else if(str=="nach algen")
    bswrite("Du tauchst nach den Algen. Sie fuehlen sich sehr glitschig an. Doch was ist das "
          "Harte dazwischen?\n");
  else if(str=="nach hartem"||str=="nach hartem")
    bswrite("Du tauchst nach dem Harten auf dem Grund. Es ist rundlich und fuehlt sich beinahe "
    "wie eine Kugel an.\n");
  else if(str=="nach kugel"||str=="nach rundem"||str=="nach rundes")
    bswrite("Du tauchst nach der Kugel. Igitt, dass ist ja ein Schaedel, erschreckt laesst Du ihn "
    "wieder fallen?\n");
  else if(str=="nach schaedel")
    bswrite("Igitt, nein, den willst Du nicht haben und laesst ihn unten.\n");
  else if(str=="nach schlamm")
    bswrite("Der Schlamm ist glitschig, Du kannst ihn nicht nehmen.\n");
  else if(str=="nach algen")
    bswrite("Die Algen sind glitschig, sie nicht nehmen.\n");
  else
    return 0;
  bswrite ("Prustend kommst Du wieder an die Oberflaeche.\n");
  say(TPN+" taucht kurz unter und kommt prustend wieder an die Oberflaeche.\n",TP);
  return 1;
}

int brechen(string str)
{
  notify_fail("Was moechtest Du herausbrechen?\n");
  if(str=="wurzel heraus"||str=="wurzel ab")
    {
      if(wurzelda)
        {
          bswrite("Du zerrst an der Wurzel und es gelingt Dir tatsaechlich eine herauszubrechen.\n");
          //clonen
          wurzelda=0;
        }
      else
        bswrite("Leider kannst Du keine Wurzel abbrechen, sie sind alle zu stabil.\n");
      return 1;
    }
  return 0;
}

