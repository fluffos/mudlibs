

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>





void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein Kaninchenjunges");
  SetProp(P_LONG,
    "Du siehst ein kleines, flauschiges Kaninchenjunges das aufgeregt um Dich herumhopst.");
  SetProp(P_NAME, "Kaninchenjunges"); 
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);

SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM + "nebel_u4f");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM + "nebel_u"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({4, 5, 2}));

 SetProp(P_MSGIN, "hoppst heran");
 SetProp(P_MSGOUT, "hoppst");


  AddId(({"kaninchen", "kaninchenjunges","junges"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen kleinne Pfoten",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");  
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 500);
  SetProp(P_ALIGN, 0);
  SetProp(P_WIMPY, 80);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Ein Kaninchenjunges"); 
  AddInfo(DEFAULT_INFO, "muemmelt vor sich hin.\n");  


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Kaninchenjunge ist viel zu schwach zum tragen.\n" }) );


     SetChats(3, ({
       "Das Kaninchenjunge muemmelt.\n", 
       "Das Kaninchenjunge schueffelt neugierig an Dir.\n",
       "Das Kaninchenjunge stolpert ueber seine Ohren.\n",
       "Das Kaninchenjunge jagt seinen Puschelschwanz.\n" })) ;


 }

