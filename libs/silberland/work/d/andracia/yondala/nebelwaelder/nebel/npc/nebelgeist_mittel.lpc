//24.10.2022 - Yondala@SilberLand: in der die() loescht er nun 2 Geisteinheiten aus NEBELROO+geisterzahl.txt

//[ ] 1  klein
//[x] 2  mittel
//[ ] 4  gross
//[ ] 8  gigantisch
//[ ] 16 drache

//fusioniert mit einem anderen mittleren Nebelgeist.

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>



void fusion()
{
  if(TP&&!InFight()&&!TP->InFight()&&present(TP,environment(TO)))
    {
  //    if(random(3)==1)
    //    {
          tell_room(environment(TO),"Die beiden mittleren Nebelgeister fusionieren miteinander.\n");
          TP->remove();
          CLONE(NEBEL_NPC"nebelgeist_gross",environment(TO));
          remove();
      //  }
      }
    }
void init()
{
  ::init();
  if(TP->id("\nmittlerernebelgeist")) //wenn der andere ein Nebelgeist ist.
    {
      call_out("fusion",3);
    }
  }

void reset()
{
  ::reset();

  if(is_clone(this_object()) && !InFight()&&QueryProp(P_MAX_HP)==QueryProp(P_HP)) 
    {
      tell_room(environment(TO),"Der mittelgrosse Nebelgeist teilt sich.\n");
      CLONE(NEBEL_NPC"nebelgeist_klein",environment(TO));
      CLONE(NEBEL_NPC"nebelgeist_klein",environment(TO));
      remove();
    }
}

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein mittelgrosser Nebelgeist");
  SetProp(P_LONG,
    "Du siehst mitten im Nebel einen mittlelgrossen Nebelgeist. Er ist fast durchsichtig "
    "und scheint nicht boesartig zu sein.");
  SetProp(P_NAME, "Nebelgeist"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ,"mittelgross");  
SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM + "nebel_4a");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+MOV_SPECIAL);
SetProp (P_MNPC_WAIT, ({5, 15, 10}));

  SetProp(P_MSGIN, "weht herein");
  SetProp(P_MSGOUT, "weht");
 

  AddId(({"geist","nebelgeist","\nmittlerernebelgeist"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit grosser Kaelte",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");  
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Ein kleiner Nebelgeist"); 
  AddInfo(DEFAULT_INFO, "haucht: ghhhefaaahhhhhr.\n");  
  SUID;
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Geist kann nichts tragen.\n" }) );


     SetChats(3, ({
       "Der Nebelgeist wabert umher.\n", 
       "Der Nebelgeist verschwindet kurz in einer Nebelwehe.\n",
       "Der Nebelgeist schwirrt um Dich herum.\n",
       "Der Nebelgeist fliegt durch Dich durch.\n",
       "Der Nebelgeist verursacht eine Gaensehaut bei Dir.\n" })) ;
SetProp(P_SPELLRATE,30);
  
AddSpell(2,200,
              "Der mittelgrosse Nebelgeist haucht Dich an.\n",
              "Der mittelgrosse Nebelgeist haucht @WEN an.\n",
              ({DT_COLD}), ([SP_SHOW_DAMAGE:0]) );
AddSpell(1,300,
              "Der mittelgrosse Nebelgeist raubt Dir den Atem.\n",
              "Der mittelgrosse Nebelgeist raubt @WEM den Atem.\n",
              ({DT_AIR}), ([SP_SHOW_DAMAGE:0]) );
        
SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      -0.4, DT_WATER:  -0.4, DT_AIR:    -0.2, 
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -0.2, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.4,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.2]) );

 }
void geistloeschen()
{
	int geisterzahl;
	geisterzahl=to_int(read_file(NEBEL_ROOM+"geisterzahl.txt",1,1));
	if(geisterzahl<2) 
	{
		geisterzahl=2;
		//Geisterzahl darf nie 0 sein, wenn ein Geist sie abfragt
		//vermutlich hat dann jemand per Hand daran rumgewerkerlt
		//oder das ganze Gebiet zurueckgesetzt. Dann bitte immer 
		//haendisch NEBEL_ROOM+"geisterzahl.txt" auf 0 setzen
		tell_room(environment(TO), "GEISTERFEHLER 01, BITTE YONDALA ODER ERZMAGIER KONTAKTIEREN!\n");
	}
	geisterzahl-=2;
	rm(NEBEL_ROOM+"geisterzahl.txt");	 
	write_file(NEBEL_ROOM+ "geisterzahl.txt",to_string(geisterzahl));
}


void die(int poisondeath) 
{
	geistloeschen();
  ::die(poisondeath);
}