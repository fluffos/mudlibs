// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//hier ist ein Sumpf, nichts besonderes.
//FP auf Riech Faeulnis
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  wie_oft=25;
  geh_ich=3;



  AddSound( DEFAULT_SOUND,
    "Ausser einem gelegentlichen Blubbern hoerst Du nichts.");
RemoveSound(({"stille","ort"}));

  AddSound( ({ "blubbern", "" }),
    "Es scheint vom Boden zu kommen.");

  AddSmell( DEFAULT_SMELL,
    "Es stinkt hier ploetzlich bestialisch.");
RemoveSmell("luft");
  AddSmell( ({ "gestank" }),
    "Es riecht nach Faeulnis, Du kannst kaum atmen.");
  AddSmell( ({ "faeulnis" }),
    "Irgendwas scheint auf dem Boden zu sein, was Du aufgrund des Nebels allerdings nicht sehen "
    "kannst.");


  AddExit( "westen", "./nebel_2b" );
  AddExit( "suedosten", "./nebel_3d" );
  AddExit( "suedwesten", "./nebel_3b" );

  AddSpecialExit( "suedosten", "suedostlauf");
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "suedwesten", "suedwestlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );

}

int suedostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3d", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_2b", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int suedwestlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3b", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="osten"||
	   str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="suedosten"||str=="westen"||str=="suedwesten")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden sehr matschig, Du sinkst fast ein. Scheinbar stehst Du in einem kleinen Sumpf.\n");
			return 1;
			}
		if(str=="sumpf")
		{
			bswrite("Das kann nicht gesund sein, Du solltest lieber schnell weiter gehen.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume. Sie sind hier scheinbar eher verkrueppelt.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}