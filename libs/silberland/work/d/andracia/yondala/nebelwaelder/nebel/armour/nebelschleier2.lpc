// Nebelschleier, den der Nebeldrache hat
// Loest sich 5 Sekunden nach anziehen auf

#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
string echtername;
string echteshort;	
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  call_out("weg",604800);

  SetProp(P_SHORT, "Ein Nebelschleieri");
  SetProp(P_LONG,
    "Du siehst einen Schleier der, obwohl nur aus Nebel bestehend, doch "
	"irgendwie greifbar ist. "
    "Er ist ziehmlich undurchsichtig, was passiert wohl, wenn man ihn "
	"anzieht?");
  SetProp(P_INFO, BS("Der Nebelschleier sieht sehr instabil aus. Er wird "
  "nicht lange halten, wenn Du ihn traegst. Allerdings wird man Dich darin "
  "kaum erkennen.") );
  SetProp(P_NAME, "Nebelschleier");
  SetProp(P_GENDER, MALE);
  AddId( ({"nebel", "nebelschleier", "schleier"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_AIR, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_M_HEALTH_MOD,([P_HP:15]));
  SetProp(P_DAM_PROTECTION, DT_FIRE);
  SetProp(P_WEAR_RESTRICTIONS, (SR_SEER));
}

void weg()
{
	if(interactive(environment(TO)))
		{
			tell_object(environment(TO),"Der Nebelschleier verdichtet sich ploetzlich und dringt in Dich ein.\n");
			environment(TO)->AddHp(random(50)+50);
		}
	remove();
}
