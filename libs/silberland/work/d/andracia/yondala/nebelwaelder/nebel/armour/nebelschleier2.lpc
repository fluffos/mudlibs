int verteidigen(int dam, string dam_type, mixed spell, object enemy)
{
    if(TO->QueryProp(P_WORN)!=0)
   {
         tell_room(environment(environment(TO)),capitalize(enemy->name())+" trifft im Nebel nichts.\n");
		 dam=0;
		 }
else tell_room(environment(environment(TO)),"Bla.\n");

return dam;
//return ::Defend(dam, dam_type, spell, enemy);
}


int WearFunc(object me) {

environment(TO)->SetProp(P_TMP_DEFEND_HOOK, ({time()+10, TO, "verteidigen"}));
call_out("weg",10);
echtername=environment(TO)->name();
echteshort=environment(TO)->QueryProp(P_SHORT);
environment(TO)->SetProp(P_SHORT, symbol_function("Eine Nebelwehe", environment(TO)), F_QUERY_METHOD);
environment(TO)->SetProp(P_NAME, symbol_function("Eine Nebelwehe", environment(TO)), F_QUERY_METHOD);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
environment(TO)->SetProp(P_SHORT, echteshort);
environment(TO)->SetProp(P_NAME, echtername);
  return 1;
}