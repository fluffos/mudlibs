// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland

//Hier der Text von Friedhelm
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  wie_oft=55;
  geh_ich=5;



  AddReadDetail( ({ "konturen","kontur","konturen mit fingern","kontur mit fingern" }),
    "Du liest mit Deinen Fingern folgendes:\n"
    "Seit Tagen irre ich nun durch diesen Wald, bin halb verdurstet,\n"
    "finde keinen Ausweg. Ich will nach Westen, immer nur nach Westen,\n"
    "lange kann ich dem nicht mehr widerstehen. Ich werde mich nun\n"
    "verkriechen und auf Rettung hoffen.\nGez. Friedhelm");


 
  AddSpecialExit( "suedosten", "suedostlauf");
  AddSpecialExit( "westen", "westlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
}
int suedostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_2j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_1h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="osten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="suedosten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr weich.\n");
			return 1;
			}
			
	if(str=="baeume")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume. Ein Baum fuehlt sich irgendwie anders an.\n");
			return 1;
			}
	if(str=="baum")
		{
			bswrite("Die Oberflaeche dieses Baumes ist besonders glatt.\n");
			return 1;
			}	
	if(str=="oberflaeche")
		{
			bswrite("Bis auf eine Stelle ist die Oberflaeche eines Baumes viel glatter als die der "
			"anderen.\n");
			return 1;
			}
	if(str=="stelle")
		{
			bswrite("An einer Stelle scheint jemand etwas eingeritzt zu haben, Du kannst die Konturen "
			"deutlich ertasten.\n");
			return 1;
			}
	if(str=="konturen"||str=="konturen")
		{
			bswrite("Vielleicht kannst Du die Konturen mit den Fingern lesen?\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
	if(str=="finger")
		{
			bswrite("Mit denen tastest Du.\n");
			return 1;
			}		
			
			
	}

