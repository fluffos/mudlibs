#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Dolch");
  SetProp(P_LONG,
    "Du siehst einen Dolch, der sehr fein gearbeitet wurde und eine sehr scharfe Klinge besitzt." );

  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch"}) );
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IVORY );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 200);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WC_BONUS, (["anarion": 50]) );
  
}

int WieldFunc(object waffe) {
  return 1;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
