// Der Geist eines Holzfaellers
// hat eine gute Axt dabei und gibt infos

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Der Geist eines Holzfaellers");
  SetProp(P_LONG,
    "Du siehst den durchscheinenden Geist eines Holzfaellers. Der Geist war sicher mal ein "
    "grosser, starker Mann, der mitten in den besten Lebensjahren stand. Nun ist er tot und "
    "schaut Dich mit traurigen Augen an.");
  SetProp(P_NAME, "Geist eines Holzfaellers"); 
  SetProp(P_GENDER, MALE);

SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM + "nebel_6e");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM +"nebel_6e",
	                      NEBEL_ROOM +"nebel_6f",
	                      NEBEL_ROOM +"nebel_6g",
	                      NEBEL_ROOM +"nebel_7f"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

 SetProp(P_MSGIN, "schwebt herein");
 SetProp(P_MSGOUT, "schwebt");


  AddId(({"geist", "holzfaeller","holzfaellergeist"}));

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seiner Axt",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");  
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_ALIGN, 0);


  SUID;
 	CLONEME(NEBEL_WEAPON "geisteraxt" );
  command("zuecke axt");

  SetProp(P_DIE_MSG,  " ist erloest.\n");
  SetProp(P_CORPSE,0);
  SetProp(P_KILL_NAME, "Der Geist eines Holzfaellers"); 
  AddInfo(DEFAULT_INFO, "stoehnt: Das weiss ich nicht.\n");  
  AddInfo( ({"hilfe",""}),
    "Ich kann Euch nicht mehr helfen. Und Ihr mir auch nicht. Ich bin tot.",
    "sagt: ");
  AddInfo( ({"tod","todesursache"}),
    "Ich viel von einer Klippe.",
    "sagt: ");
  AddInfo( ({"klippe",""}),
    "Die Klippe ist weit im Westen. Ihr solltet aufpassen, dass Ihr nicht auch hinunterstuerzt, "
    "so wie ich und meine Gefaehrten.",
    "sagt: ");
  AddInfo( ({"gefaehrten","holzfaeller"}),
    "Die sind alle tot, nur ich bin uebrig.",
    "sagt: ");
  AddInfo( ({"weg",""}),
    "Den weiss ich nicht.",
    "sagt: ");
  AddInfo( ({"lichtung",""}),
    "Diese Lichtung haben beine Gefaehrten und ich einst geschlagen als wir Holz roden wollten.",
    "sagt: ");
  AddInfo( ({"holz",""}),
    "Davon lebe ich.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@WER gleitet durch den Geist hindurch.\n" }) );

  SetProp(P_SPELLRATE, 30); 

     SetChats(3, ({
       "Der Geist eines Holzfaellers stoehnt.\n", 
       "Der Geist eines Holzfaellers schaut Dich flehend an.\n",
       "Der Geist eines Holzfaellers versucht Holz zu hacken.\n",
       "Der Geist eines Holzfaellers schaut sich aengstlich um.\n" })) ;


    AddSpell(7,400,
              "Der Geist eines Holzfaellers fliegt durch Dich hindurch.\n",
              "Der Geist eines Holzfaellers fliegt durch @WEN hindurch.\n",
              ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
    AddSpell(3,500,
              "Der Geist eines Holzfaellers versucht Dich in sein Reich zu ziehen.\n",
              "Der Geist eines Holzfaellers versucht @WEN in sein Reich zu ziehen.\n",
              ({DT_TERROR,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

}

