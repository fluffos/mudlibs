//Eine Tanne auf die man klettern kann ->FP
//Tannenzapfen zum sammeln
#include "../def.h"
inherit ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int zapfen;

void reset()
{
	::reset();
		zapfen=random(4);
		zapfen+=2;
  if(!present("nebelgeist",TO)&& random(2)==1)
  	{
  		if(call_other(ROOM+"nebelgeistmaster.lpc","darfichgeist")==1) 
  	   CLONE(NEBEL_NPC + "nebelgeist_klein.lpc", TO);
			}	
	
	}
void create() 
{
  ::create();
		zapfen=random(4);
		zapfen+=2;
  wie_oft=45;
  geh_ich=4;

  AddCmd( ({ "kletter", "klettere" }), "klettern" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "nordosten", "nordostlauf");
  AddSpecialExit( "sueden", "suedlauf");

 
}

//Ausgänge
int ostlauf(string dir)
{
  return this_player()->move(ROOM+"nebel_3h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


int westlauf(string dir)
{
  return this_player()->move(ROOM+"nebel_3f", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int nordostlauf(string dir)
{
  return this_player()->move(ROOM+"nebel_2h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int suedlauf(string dir)
{
  return this_player()->move(ROOM+"nebel_4g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			write("Der Boden ist hier weich und federnd er ist mit kleinen, spitzen Tannennandeln bedeckt.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen"||str=="sueden")
		{
			write("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			write("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			write("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			write("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			write("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="tannennadeln"||str=="nadeln"||str=="tannennadel"||str=="nadel")
		{
			write("Sie fuehlen sich trocken an und sind sehr spitz. Hier scheint irgendwo eine Tanne zu stehen.\n");
			if(zapfen)
				write("Zwischen den Nadeln ertastest Du etwas seltsames.\n");
			return 1;
			}
	if(str=="seltsames"||str=="etwas")
		{
			if(zapfen)
				write("Was auch immer es ist, es ist rund.\n");
			else
			write("Du hast Dich wohl geirrt.\n");
			return 1;
			}		
	if(str=="rundes")
		{
			if(zapfen)
				write("Es fuehlt sich gleichzeitig genoppt an.\n");
			else
			write("Du hast Dich wohl geirrt.\n");
			return 1;
			}		
	if(str=="noppen"||str=="genopptes")
		{
			if(zapfen)
				write("Ploetzlich weisst Du was es sein koennte: Ein Tannenzapfen!\n");
			else
			write("Du hast Dich wohl geirrt.\n");
			return 1;
			}		
	if(str=="zapfen"||str=="tannenzapfen")
		{
			if(zapfen)
				{
					write("Schnell steckst Du ihn ein.\n");
					CLONE(OBJ + "tannenzapfen.lpc", TP);
					zapfen--;
				}
			else
			write("Du hast Dich wohl geirrt.\n");
			return 1;
			}		
			
								

			
	if(str=="tannen")
		{
			write("Du tastest herum und findest mehrere Tannen. Eine scheint besonders gross zu sein.\n");
			return 1;
			}			
	if(str=="aeste","ast")
		{
			write("Die Aeste der Tanne sind sehr stark, vielleicht kann man sogar darauf klettern?\n");
			return 1;
			}
	if(str=="tanne"||str=="grosse tanne")
		{
			write("Sie ist besonders gross, Du kannst ihren Stamm nicht umfassen und ihre Aeste sind sicher laenger als Du.\n");
			return 1;
			}
	if(str=="stamm")
		{
			write("Der Stamm hat einen gigantischen Durchmesser.\n");
			return 1;
			}
	if(str=="durchmesser")
		{
			write("Der ist wirklich gross.\n");
			return 1;
			}

	else 
		{
			write("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int klettern(string str)
{
	notify_fail("Worauf moechtest Du klettern?\n");
	if(str=="tanne"||str=="tannenbaum"||str=="grosse tanne"||str=="aeste"||str=="ast"||
		str=="auf tanne"||str=="auf tannenbaum"||str=="auf grosse tanne"||str=="auf aeste"||str=="auf ast")
		{
			write("Du greifst beherzt in die Aeste und kletterst die grosse Tanne hoch.\n");
      this_player()->move(ROOM+"nebel_tanne", M_GO, 0,
                  "verschwindet im Nebel", "kommt hochgeklettert");
			return 1;		
		}
	else if(str=="baum"||str=="auf baum")
		{
		write("Auf welchen Baum moechstest Du denn klettern?\n");
		return 1;
		}
	return 0;
	
}

