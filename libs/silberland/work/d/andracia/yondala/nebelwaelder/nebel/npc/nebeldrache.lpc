void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein unheimlicher Nebeldrache");
  SetProp(P_LONG,
    "Vor Dir baut sich ein gigantischer, koerperloser Nebeldrache auf. "
	"Schemenhaft bilden Nebelschwaden seine Umrisse, nur die leuchtend "
	"roten Augen sind scharf und scheinen Dich durchboren zu wollen.");
  SetProp(P_NAME, "Nebeldrache"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ,"unheimlich");  
SetProp (P_MNPC_DEFAULTROOM, NEBEL_ROOM+"nebel_4a");
SetProp (P_MNPC_AREA, ({NEBEL_ROOM }));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS+MOV_SPECIAL);
SetProp (P_MNPC_WAIT, ({5, 15, 10}));

// muss man mal sehen, ob das alles so gut und logisch ist und so (11.9.2008)
SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.5, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:    -1.0, 
      DT_LIGHTNING: 0.5, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -1.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.8]) );

  SetProp(P_MSGIN, "wabert herein");
  SetProp(P_MSGOUT, "wabert");
 

  AddId(({"drache","nebeldrache"}));

  //create_default_npc(20);
  create_default_dragon(5,7,2,3);
  SetProp(P_HANDS, ({" mit grosser Kaelte",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");  
  SetProp(P_SIZE, 400);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_DIE_MSG,  " loest sich in Dunst auf.\n");
  SetProp(P_KILL_NAME, "Ein Nebeldrache"); 
  AddInfo(DEFAULT_INFO, "schnaubt Dich wortlos an.\n");  

       SetProp (P_REJECT,
         ({ REJECT_KEEP, "Der Nebeldrache nimmt @WEN zwischen die Zaehne.\n" }) );

     SetChats(3, ({
       "Der Nebeldrache blaest Nebel aus seinen Nuestern.\n", 
       "Der Nebeldrache schnaubt Nebel auf Dich.\n",
       "Der Nebeldrache erwischt Dich fast mit seinem Schwanz.\n",
       "Der Nebeldrache starrt Dich mit roten Augen an.\n",
       "Der Nebeldrache laesst Dich froesteln.\n",
       "Der Nebeldrache belauert Dich.\n" })) ;

 SetProp(P_SPELLRATE, 90); 


    AddSpell(5,700,
              "Der Nebeldrache schiesst einen Strahl reiner Kaelte auf Dich.\n",
              "Der Nebeldrache schiesst einen Strahl reiner Kaelte auf @WEN.\n",
              ({DT_COLD}), ([SP_SHOW_DAMAGE:1]) );
    AddSpell(2,800,
              "Der Nebeldrache umhuellt Dich mit stickigem Nebel.\n",
              "Der Nebeldrache umhuellt @WEN mit stickigem Nebel.\n",
              ({DT_AIR}),"blind", ([SP_SHOW_DAMAGE:1]) );
    AddSpell(1,600,
              "Der Nebeldrache versucht Dich einzuschuechtern.\n",
              "Der Nebeldrache versucht @WEN einzuschuechtern.\n",
              ({DT_TERROR}), "angstmacher", ([SP_SHOW_DAMAGE:1]) );
    AddSpell(1,300,
              "Der Nebeldrache schlaegt mit seinem Schwanz nach Dir.\n",
              "Der Nebeldrache schlaegt mit seinem Schwanz nach @WEM.\n",
              ({DT_BLUDGEON, DT_RIP}), "stoss",([SP_SHOW_DAMAGE:0]) );   

			  //ist schon im Standarddrachen
			  /*	AddSpell(1,500,
              "Der Nebeldrache greift Deine Ausruestung an.\n",
              "Der Nebeldrache greift die Ausruestung von @WEM an.\n",
              ({DT_ELECTRIC}), "ruestungsklau", ([SP_SHOW_DAMAGE:1]) );*/


 }


void geistloeschen()
{
	int geisterzahl;
	geisterzahl=to_int(read_file(NEBEL_ROOM+"geisterzahl.txt",1,1));
	if(geisterzahl<16) 
	{
		geisterzahl=16;
		//Geisterzahl darf nie 0 sein, wenn ein Geist sie abfragt
		//vermutlich hat dann jemand per Hand daran rumgewerkerlt
		//oder das ganze Gebiet zurueckgesetzt. Dann bitte immer 
		//haendisch NEBEL_ROOM+"geisterzahl.txt" auf 0 setzen
		tell_room(environment(TO), "GEISTERFEHLER 01, BITTE YONDALA ODER ERZMAGIER KONTAKTIEREN!\n");
	}
	geisterzahl-=16;
	rm(NEBEL_ROOM+"geisterzahl.txt");	 
	write_file(NEBEL_ROOM+ "geisterzahl.txt",to_string(geisterzahl));
}


void die(int poisondeath) 
{
  object ob;
  "/obj/gemmaster"->DistributeGem(10, 15, 3, TO);
  CLONEME(NEBEL_ARMOUR "nebelschleier" ); 
  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 20000 + random(10000));
  ob->move(TO, M_SILENT); 
  geistloeschen();
  
  ::die(poisondeath);
}


void angstmacher(object enemy, int damage, mixed dam_type) 
    {
      enemy->SetProp(P_WIMPY, enemy->QueryProp(P_WIMPY)+random(30)+20);
    }
    

void blind(object enemy, int damage, mixed dam_type) 
    {
   	   tell_object(enemy,"Der Nebel brennt in Deinen Augen.\n");
       enemy->SetProp(P_BLIND, 5+random(3));
    }

void ruestungsklau(object enemy, int damage, mixed dam_type) 
  {
  	object *ruestung;
  	object kaputtmacher;
  	ruestung=enemy->QueryArmours();
  	if(!sizeof(ruestung)) return;
  	kaputtmacher=ruestung[random(sizeof(ruestung))];
		tell_object(enemy, capitalize(kaputtmacher->name())+" nimmt Schaden.\n");
    kaputtmacher->TakeFlaw(random(5)+10);
  	 }
 //Der Spieler landet in irgendeinem Raum im Nebel
