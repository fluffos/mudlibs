// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)

//hier gehts nach unten in die Hoehle von Fiedhelm ->Forscherpunkt auf den Ausgang unten

#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  wie_oft=20;


  AddSpecialExit( "nordosten", "nordostlauf");
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "unten", "untenlauf");

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
}
int nordostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_2c", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3a", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int untenlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_hoehle", M_GO, 0,
                  "verschwindet im Nebel", "kommt herunter geklettert");
  }  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="osten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="nordosten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier relativ hart, ausserdem ist vor Dir scheinbar ein grossen Loch.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume. Ein Baum fuehlt sich irgendwie anders an.\n");
			return 1;
			}
	if(str=="loch")
		{
			bswrite("Je weiter Du tastest, desto groesser kommt das Loch Dir vor. Fasst schon wie ein Eingang zu einer Erdhoehle.\n");
			return 1;
			}	
	if(str=="eingang"||str=="hoehle"||str=="erdhoehle")
		{
			bswrite("Sie scheint gross genug zu sein. Ob Du es wagen solltest einfach nach unten zu gehen?\n");
			return 1;
			}
	if(str=="unten")
		{
			bswrite("Man kann hier scheinbar nach unten gehen.\n");
			return 1;
			}

	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}
