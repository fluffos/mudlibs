//Kann in einer Hoehle im Nebel freigeforscht werden. Wenn man ihn aus dem Nebel fuehrt
//bekommt man eventuell einen Zaubertrank
//Nach kurzer Zeit verschwindet er aber wieder aus Angst.
//Er sagt auch dem Raum Bescheid ob er grad auffindbar ist

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"
int wirdgefuehrt;
object fuehrer;
object hoehle;
/*
string hilfe()
{
 
  return "\n";
}
*/

void init()
{
  ::init();
  //wenn er in einem der drei Raeume ist
  if(file_name(environment(TO))==NEBEL_ROOM + "nebelweg_10"||
     file_name(environment(TO))==NEBEL_ROOM + "nebelweg_11"||
     file_name(environment(TO))==NEBEL_ROOM + "nebelweg_12")
  {
    call_out("binda",1);

  }
}
binda()
{
	 if (present(fuehrer), environment(TO))
    	command("sag Habt Dank "+fuehrer->name()+", Ihr ward mir ein guter Fuehrer, von nun an finde ich sicher alleine nach Hause.");
      
    else 
    	tell_object(fuehrer,"Habt Dank "+fuehrer->name()+", Ihr ward mir ein guter Fuehrer, von nun an finde ich sicher alleine nach Hause.\n");
      
    fuehrer->FindPotion("Friedhelm schenkt Dir aus Dankbarkeit einen kleinen Trank.\n");//gucken ob das so geht, ohne if, muesste aber
    call_other(NEBEL_ROOM + "nebel_hoehle", "wiederda",0);
    tell_room(environment(TO),"Friedhelm laeuft davon.\n");
    remove();
  }
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  wirdgefuehrt=0;
  fuehrer=0;
  hoehle=environment(TO);//muesste gehen, weil er ja nur in dieser Hoehle geclont wird. Eventuell noch aendern.
  SetProp(P_SHORT, "Friedhelm");
  SetProp(P_LONG,
    "Du siehst einen alten, klapprigen Mann vor Dir. Er ist bis auf die Knochen abgemagert und "
    "schaut Dich aus riesigen Augen an. Seine Haut ist blass, sein Haar steht wirr vom Kopf "
    "er hat viele Wunden und blaue Flecken. Kleidung hat er keine, lediglich ein paar Lumpen "
    "umhuellen ihn.");
  SetProp(P_NAME, "Friedhelm");
  SetProp(P_GENDER, MALE);
  AddId(({"friedhelm", "mann"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit wenig Elan",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK, 1);
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt zitternd an");
  SetProp(P_MSGOUT, "geht zitternd");
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Friedhelm");
  SetProp(P_KILL_MSG, "Haettest Du mir lieber geholfen.");


  AddInfo(DEFAULT_INFO, "sagt: Das weiss ich nicht, helft mir doch bitte statt zu fragen.\n");


  AddInfo( ({"hilfe","helfen"}),
    "Fuehrt mich doch bitte aus dem Nebel heraus.",
    "sagt: ");
  AddInfo( ({"nebel",""}),
    "Ich habe mich im Nebel verlaufen und weiss nicht mehr wie ich herauskomme.",
    "sagt: ");
  AddInfo( ({"weg","ausweg"}),
    "Den suche ich.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Hildgunde darf nichts annehmen.\n" }) );

 /* SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));*/
  AddCmd( ({ "fuehre", "fuehr"}), "fuehren" );

  SetChats(3, ({
    "Friedhelm fragt: Wo bin ich bloss hier?\n",
    "Friedhelm sagt: Bitte, fuehrt mit aus dem Nebel!\n",
    "Friedhelm jammert: Ich will hier raus!\n"

    }) );
 

}

// Mitloggen wenn einen Spieler den NEBEL_NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  hoehle->wiederda(); 
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

