fuehren(string str)
{
  if(str=="friedhelm")
    {
      if(TP->QueryProp(P_PURSUERS)!=0 && member(TP->QueryProp(P_PURSUERS),TO)!=-1)//Wenn Friedhelm TP schon folgt
        {
          command("sag Aber ich folge Euch doch schon, "+TPN+".");
          return 1;
        }
      else if(wirdgefuehrt!=0)//wenn er schon irgendwem folgt
        {
          command("sag Aber ich folge doch schon "+fuehrer->name(WEM)+".");
          return 0;
        }
      //wenn er niemandem folgt
        command("sag Habt Dank, ich werde Euch nun folgen.");
        TP->AddPursuer(TO);
        fuehrer=TP;
        wirdgefuehrt=1;
        call_out("fuehrungsende",300);//in fuenf Minuten bekommt er Panik und beendet die Fuehrung.
        return 1;
      }
    
  else
    write("Wen willst Du fuehren?\n");
return 1; 
  }
  
fuehrungsende()
{
    if(file_name(environment(TP))!="/d/tal/yondala/wald/room/xx")//Wenn er sich im falschen Raum befindet
      {
        if(present(fuehrer), environment(TO))
          command("sag Ich glaube nicht, dass Ihr mich auf dem richtigen Weg fuehrt, ich versuche es lieber alleine, hier ist es mir zu unheimlich.");

        else
          tell_object(fuehrer,"Friedhelm teilt Dir mit: Ich glaube nicht, dass Ihr mich auf dem richtigen Weg fuehrt,\n"+
                                "Friedhelm teilt Dir mit: ich versuche es lieber alleine, hier ist es mir zu unheimlich.\n");
            
            
         hoehle->wiederda(); 
         remove();    
        }

  }