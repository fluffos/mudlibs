// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
//Tannennadel und Hinweis auf Tanne in 3g
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>
int nadelda;

void reset()
{
	nadelda=1;
	::reset();	
}
void create() 
{
  ::create();
  nadelda=1;
  wie_oft=45;
  geh_ich=4;


  AddCmd( ({ "kletter", "klettere" }), "klettern" );
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
  AddSpecialExit( "norden", "nordlauf");
}
int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_4f", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
int nordlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_3g", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="suedwesten"||str=="sueden"||str=="suedosten"||
		 str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier weich und federnd er ist mit kleinen, spitzen Tannennandeln bedeckt.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen"||str=="norden")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="tannennadeln"||str=="nadeln")
		{
			bswrite("Sie fuehlen sich trocken an und sind sehr spitz. Hier scheint irgendwo eine Tanne zu stehen.\n");
			if(nadelda)
				bswrite("Eine Nadel fuehlt sich besonders an.\n");
			return 1;
			}
	if(str=="tannennadel"||str=="nadel")
		{
			if(nadelda)
				{
					bswrite("Sie ist besonders spitz. Autsch, schon steckt sie Dir im Finger.\n");
					CLONE(NEBEL_OBJ + "tannennadel.lpc", TP);
					nadelda=0;
				} 
			else
			bswrite("Sie fuehlen sich trocken an und sind sehr spitz. Hier scheint irgendwo eine Tanne zu stehen.\n");
			return 1;
			}		
	if(str=="tannen")
		{
			bswrite("Du tastest herum und findest mehrere Tannen. Im Norden scheint eine besonders grosse zu sein, Du fuehlst nur ihre starken Aeste, nicht aber ihren Stamm.\n");
			return 1;
			}			
	if(str=="aeste"||str=="ast")
		{
			bswrite("Die Aeste der Tanne sind sehr stark, vielleicht kann man sogar darauf klettern?\n");
			return 1;
			}
	if(str=="tanne"||str=="grosse tanne")
		{
			bswrite("Die steht weiter im Norden, Du koennstest hingehen.\n");
			return 1;
			}

	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int klettern(string str)
{
	notify_fail("Worauf moechtest Du klettern?\n");
	if(str=="tanne"||str=="tannenbaum"||str=="grosse tanne"||str=="aeste"||str=="ast"||
		str=="auf tanne"||str=="auf tannenbaum"||str=="auf grosse tanne"||str=="auf aeste"||str=="auf ast")
		{
			bswrite("Das geht hier noch nicht, geh doch zur Tanne im Norden, dort sind die Aeste sicher stabiler.\n");
			return 1;		
		}
	else if(str=="baum"||str=="auf baum")
		{
		bswrite("Auf welchen Baum moechstest Du denn klettern?\n");
		return 1;
		}
	return 0;
	
}
