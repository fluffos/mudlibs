// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
//hier faellt man runter, wenn man nach westen geht.
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  geh_ich=3;


  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");
 
  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );

}


int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_2b", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }

int westlauf(string dir)
{
	if(!interactive(TP)) return 1;
 //Raum suedlich des Hafens
	bswrite("Du gehst nach Westen und faellst ploetzlich in die Tiefe.\n");
  TP->AddHp(-120);
  bswrite("Du schlaegst hart auf die Steine auf.\n");
	//tell_room(environment(TP), TPN+" stuerzt von der Klippe und knallt auf den Boden.\n", ({TP}));
	return this_player()->move("/d/andracia/yondala/wege/room/weg_zum_strand_11.lpc", M_GO, 0,
                  "verschwindet im Nebel","stuerzt von der Klippe und schlaegt neben Dir auf");

  }
  
  
  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordwesten"||str=="nordosten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}

		if(str=="boden")
		{
			bswrite("Der Boden ist hier ziemlich hart und felsig.\n");
			return 1;
			}
			
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="felsen"||str=="fels")
		{
			bswrite("Die Felsen scheinen im Westen steil nach unten zu fuehren.\n");
			return 1;
			}	


	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}		
			
			
	}
