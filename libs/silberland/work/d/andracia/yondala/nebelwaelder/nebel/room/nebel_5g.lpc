// 24.10.2022: Yondala@SilberLand: Es wird ein Geist geclont, wenn in NEBEL_ROOM+geisterzahl weniger als 20 stehen (siehe nebel_std)
// Yondala@Silberland 27.06.2010
// Umgeschrieben fuers Silberland
// Hier kann man ueber das Loch springen
#include "../def.h"
inherit NEBEL_ROOM + "nebel_std.lpc";
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();
  wie_oft=45;
  geh_ich=4;

  AddDetail( ({ "" }),
    "");

  AddCmd( ({ "springe", "spring" }), "springen" );

  AddCmd( ({ "taste", "tast","ertaste","ertast" }), "tasten" );
  AddSpecialExit( "osten", "ostlauf");
  AddSpecialExit( "westen", "westlauf");

 
}

int ostlauf(string dir)
{
  return this_player()->move(NEBEL_ROOM+"nebel_5h", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }


int westlauf(string dir)
{
	if(!interactive(TP)) 

		{
			this_player()->move(NEBEL_ROOM+"nebel_5e", M_GO);
			return 1;
		}	
		bswrite("Du faellst in eine tiefes Loch.\n");
   	this_player()->move(NEBEL_ROOM+"nebel_5f", M_GO, 0,
                  "verschwindet im Nebel", "faellt aus dem Nebel");
  return 1;
  }

  
int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if (!str) return 0;
	if(str=="norden"||str=="sueden"||str=="suedosten"||
		 str=="suedwesten"||str=="nordosten"||str=="nordwesten")
	{
		bswrite("Dort ertastest Du einen Baum.\n");
		return 1;
	}
	if(str=="boden")
		{
			bswrite("Der Boden ist hier sehr uneben, Du kannst einige flache und tiefe Loecher "
			"ertasten.\n");
			return 1;
			}
			
	if(str=="osten"||str=="westen")
		{
			bswrite("Der Weg dorthin ist frei.\n");
			return 1;
			}
	if(str=="baeume"||str=="baum")
		{
			bswrite("In fast alle Richtungen stehen hier Baeume.\n");
			return 1;
			}
	if(str=="richtungen"||str=="richtung"||str=="weg")
		{
			bswrite("Welche Richtung moechtest Du denn ertasten?\n");
			return 1;
			}

	if(str=="fuesse")
		{
			bswrite("Sind beide noch da.\n");
			return 1;
			}
	if(str=="schatten")
		{
			bswrite("Mutig fasst Du in die Schatten. Sie fuehlen sich wie Baeume an.\n");
			return 1;
			}	

	if(str=="flache loecher")
		{
			bswrite("Darin ertastest Du nichts, sie sind leer.\n");
			return 1;
			}
	if(str=="loecher")
		{
			bswrite("Es gibt verschiedene Loecher, manche sind tief, machne eher flach.\n");
			return 1;
			}
	if(str=="tiefe loecher")
		{
			bswrite("Einige der Loecher sind besonders tief. In einem kannst Du nicht einmal den Grund "
			"ertasten.\n");
			return 1;
			}
	if(str=="loch")
		{
			bswrite("Westlich von Dir ist ein scheinbar sehr grosses, sehr tiefes Loch. Hoffentlich "
			"faellst Du nicht hinein. Du musst Dir Etwas einfallen lassen.\n");
			return 1;
			}
	if(str=="etwas"||str=="idee")
		{
			bswrite("Ok, ich will mal nicht so sein. Du ertastest also die Idee ueber das Loch nach "
			"Westen zu springen.\n");
			return 1;
			}
	if(str=="grund")
		{
			bswrite("Den ertasest Du nicht. Das Loch ist also ziemlich tief und es wird vermutlich "
			"ziemlich weh tun dort runter zu fallen...\n");
			return 1;
			}
		
			
	else 
		{
			bswrite("Sowas kannst Du nicht ertasten.\n");
			return 1;
		}
	
	
	}

int springen(string str)
{
	notify_fail("Wohin moechtest Du springen?\n");
	if(str=="ueber loch im westen"||str=="ueber loch"||str=="uebers loch"||
		 str=="ueber loch nach westen"||str=="uebers loch nach westen")
		 {
		 	if(random(5)>0)
		 		{
		 			bswrite("Du nimmst Anlauf und springst ueber das grosse Loch.\n");
		 			this_player()->move(NEBEL_ROOM+"nebel_5e", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
        }
       else
       	{
		 			bswrite("Du nimmst Anlauf und springst ueber das grosse Loch.\n"+
      		 			"Leider schaffst Du es nicht ganz auf die andere Seite.\n");
		 			this_player()->move(NEBEL_ROOM+"nebel_5f", M_GO, 0,
                  "verschwindet im Nebel", "faellt aus dem Nebel");
     //     TP->do_damage(15,"ein tiefer Fall");
        }
        return 1;
      }
      return 0;
    }       		
 
