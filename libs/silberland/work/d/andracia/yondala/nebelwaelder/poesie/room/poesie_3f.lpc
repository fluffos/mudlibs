//Zaubertrank bei Klettern
//Bariton wird hier mal Musikinstrumente verkaufen...
//Instrumente sollen nach Staerke und Koennen verkauft werden

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Musikladen" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einer winzig kleinen Lehmhuette. Vielleicht kommt sie Dir aber auch "+
    "nur so klein vor, weil sie ueber und ueber voll ist mit Musikinstrumenten, die teilweise "+
    "auf dem Boden stehen, teilweise an den Waenden haengen und teilweise in riesigen "+
    "hoelzernen Regalen verstaut sind. Du fuehlst Dich von ihrer Menge fast erschlagen.\n"+
	"MUSIKINSTRUMENTE WERDEN BIS AUF WEITERES NICHT VERKAUFT. YONDALA" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  AddItem( POESIE_NPC+"blauelf_bariton.lpc" , REFRESH_DESTRUCT);

  AddDetail( ({ "lehmhuette", "huette" }),
    "Du stehst in einer kleinen, engen Lehmhuette.");
  AddDetail( ({ "musikinstrumente","instrumente" }),
    "Rund um Dich herum sind lauter Musikinstrumente, Du kannst Dich kaum ruehren.");
  AddDetail( ({ "regale" }),
    "Die Regale sind aus schwarzem Holzstaemmen gefertigt, die Regalboeden bestehen aus fest "
    "geflochtenem Stroh.");
  AddDetail( ({ "holzstaemme","staemme" }),
    "Die Regale wurden aus schlanken, schwarzen Holzstaemmen gefertigt welche mit festem Stroh "
    "zusammen gehalten werden.");
  AddDetail( ({ "stroh" }),
    "Das helle Stroh bildet einen huebschen Kontrast zu dem dunklen Holz der Staemme. Es haelt "
    "sie zusammen und bietet als Regalboden den vielen Musikinstrumenten reichlich Platz.");
  AddDetail( ({ "holz" }),
    "Das Holz der Regale ist schwarz.");
  AddDetail( ({ "regalboden","regalboeden" }),
    "Die Regalboden bestehen aus fest verwobenem Stroh.");
  AddDetail( ({ "platz" }),
    "Obwohl hier reichlich davon ist siehst Du keinen mehr, denn alles ist mit Musikinstrumenten "
    "vollgestellt.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampeltem Lehm, auch wenn man wegen der Musikinstrumente wenig "
    "von ihm sieht.");
  AddDetail( ({ "kontrast" }),
    "Das helle Stroh bildet einen huebschen Kontrast zu dem dunklen Holz der Staemme.");
  AddDetail( ({ "waende" }),
    "Die Waende der Lehmhuette bestehen aus Lehm, was Dich irgendwie nicht ueberrascht. An einer "
    "Wand haengt ein Kasten.");
  AddDetail( ({ "lehm" }),
    "Der Lehm ist grau und hart, er wurde scheinbar schon vor langer Zeit getrocknet.");
  AddDetail( ({ "zeit" }),
    "Tja, wie die Zeit vergeht.");
  AddDetail( ({ "decke" }),
    "Unter der Decke haengen ein paar Geigen.");
  AddDetail( ({ "geigen" }),
    "Die Geigen ueber Dir sehen sehr edel aus, schade, dass Du sie wohl nicht erreichen kannst.");
  AddDetail( ({ "wand" }),
    "Vor den Waenden stehen ueberfuellte Regale, an einer Wand haengt allerdings ein Kasten.");
  AddDetail( ({ "kasten" }),
    "Der Kasten haengt an der Wand. Er ist aus solidem Holz gefertigt und geschlossen.");
  AddDetail( ({ "menge" }),
    "Es sind wirklich viele.");
  AddDetail( ({ "staub" }),
    "Ab und zu siehst Du ein wenig feinen Staub in der Luft rieseln.");
  AddDetail( ({ "luft" }),
    "Durch die Tuer dringen ein paar Sonnenstrahlen. Sie stehen wie ein heller Balken in der "
    "Luft und werden nur hin und wieder von ein paar Staubflocken durchbrochen.");
  AddDetail( ({ "tuer" }),
    "Durch diese Tuer bist Du hereingekommen und durch sie kannst Du den Laden auch wieder verlassen");
  AddDetail( ({ "balken", "sonnenstrahlen", "sonnenstrahl" }),
    "Wie feste Balken stehen die Sonnenstrahlen im Raum. Es waere sicher sinnlos zu versuchen "
    "auf einen von ihnen zu klettern.");
  AddDetail( ({ "staubflocken", "flocken" }),
    "Die Staubflocken rieseln traege durch die Luft.");
  AddDetail( ({ "yondala" }),
    "Teile Yondala mit: Wann gibt es in Poesie endlich Musikinstrumente?\nDas hilft vielleicht...");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst eine leise Melodie.");

  AddSound( ({ "melodie" }),
    "Die Melodie stimmt Dich froh.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier staubig.");

  AddSmell( ({ "staub" }),
    "Der Staub riecht langweilig.");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "kletter","klettere","steige", "steig" }), "klettern" );


  AddExit( "suedwesten", "./poesie_4e" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}

int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str!="kasten") return 0;
	
	write(BS("Du oeffnest den Kasten und findest ein paar kleine Floeten darin, die allerdings fest "
				"im Kasten verankert sind. Enttaeuscht schliesst Du den Kasten wieder."));
  say(TPN+" schaut in den Kasten.\n");
  return 1;
 }
 
 
int klettern(string str)
{
	notify_fail("Auf was moechtest Du klettern?\n");
	if(str!="auf balken"&&str!="auf sonnenstrahl") return 0;
	
	if(TP->FindPotion("Du willst gerade auf den Sonnenstrahl klettern, als Dir an einer Staubflocke etwas Interessantes auffaellt...\n")) return 1;
	write("Du versuchst auf einen der Sonnenstrahlen zu klettern. Natuerlich geht das schief und "
	"Du landest unsaft auf Deinem Hinterteil.\n");
  say(TPN+" macht seltsame Verrenkungen und faellt auf den Hintern.\n");
  return 1;
 }