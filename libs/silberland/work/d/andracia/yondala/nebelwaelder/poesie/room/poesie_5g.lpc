#include "../def.h"

inherit "std/room";

#include <properties.h>
int bluemchen;

void reset()
{
	::reset();
		bluemchen=random(3);
		bluemchen++;
	
	}


void create() 
{
  ::create();
		bluemchen=random(3);
		bluemchen++;
  SetProp( P_INT_SHORT, "Auf einer Gabelung" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einem schmalen Pfad, der sich in drei Richtungen gabelt. "
    "Im Westen fuehrt er Dich auf einen grossen Platz, im Norden und Sueden kannst Du "
    "je eine Lehmhuette betreten." );
  AddItem( POESIE_NPC+"schmetterling.lpc" , REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );
  	
  AddDetail( ({ "platz", "westen" }),
    "Im Westen befindet sich ein grosser Platz.");
  AddDetail( ({ "richtung","richtungen" }),
    "Von hier aus kannst Du nach Norden, Sueden und Westen gehen. Alle anderen Richtungen sind "
    "durch die Hecken gesperrt.");
  AddDetail( ({ "hecken", "hecke" }),
    "Der Pfad ist durch hohe kleinblaettrige Hecken begrenzt. Dahinter steht eine "
    "undurchfringliche Nebelwand.");
  AddDetail( ({ "blaetter", "blatt" }),
    "Die Blaetter der beiden Hecken sind gruen und sehr klein.");
  AddDetail( ({ "pfad" }),
    "Du stehst auf einem schmalen Pfad, der sich hier in drei Richtungen teilt.");
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hell und dick. Du kannst absolut nicht sehen, was sich hinter den Hecken "
    "befindet.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um den Platz herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "nebelwaende", "nebelwand" }),
    "Du betrachtest die Nebelwaende eingaengig und meinst einige Schemen erkennen zu koennen.");
  AddSpecialDetail( ({ "schemen","scheme","formen","form"  }), "schemen" );
  AddDetail( ({ "gesicht","fuss","hand","arm","bein" }),
    "Du bist Dir nicht sicher, was Du in dem wabernden Nebel fuer Formen siehst.");
  AddDetail( ({ "boden" }),
    "Der Boden ist sehr sandig. Am Wegrand siehst Du etwas Buntes.");
  AddDetail( ({ "sand" }),
    "Im Sand kannst Du einige Spuren entdecken.");
  AddDetail( ({ "spuren" }),
    "Die Spuren fuehren in alle moeglichen Richtungen.");
  AddDetail( ({ "gabelung" }),
    "Der Pfad teilt sich hier in drei Richtungen.");
  AddDetail( ({ "lehmhuetten" }),
    "Du siehst hier nur zwei Lehmhuetten, eine gelbliche im Norden und eine eher roetlich im Sueden.");
  AddDetail( ({ "lehmhuette" }),
    "Welche meinst Du, die roetliche oder die gelbliche?");
  AddDetail( ({ "gelbe lehmhuette" }),
    "Naja, sie ist nicht wirklich gelb, der Lehm, aus dem sie erschaffen wurde ist nur ein wenig "
    "gelblicher als der graue Lehm, aus dem die normalen Huetten bestehen.");
  AddDetail( ({ "rote lehmhuette" }),
    "Naja, sie ist nicht wirklich rot, der Lehm, aus dem sie erschaffen wurde ist nur ein wenig "
    "roetlicher als der graue Lehm, aus dem die normalen Huetten bestehen.");
  AddDetail( ({ "lehm" }),
    "Die Lehmhuetten bestehen aus Lehm.");
  AddDetail( ({ "gelbliche lehmhuette" }),
    "Die gelbliche Lehmhuette ist eher klein. Sie steht im Norden und Du kannst die betreten.");
  AddDetail( ({ "roetliche lehmhuette" }),
    "Die roetliche Lehmhuette ist gross und rund. Sie steht im Sueden und Du kannst sie betreten.");
  AddDetail( ({ "sueden" }),
    "Im Sueden steht eine roetliche Lehmhuette.");
  AddDetail( ({ "norden" }),
    "Im Norden steht eine gelbliche Lehmhuette.");

  AddDetail( ({ "wegrand" }),
    "Am Wegrand stehen tatsaechlich ein paar kleine Bluemchen herum.");
  AddDetail( ({ "bluemchen" }),
    "Die Bluemchen am Wegrand sind bunt und eine willkommene Abwechslung neben dem grauen Nebel und dem braunen Sand.");
  AddDetail( ({ "abwechslung" }),
    "Du freust Dich, mal etwas buntes zu sehen.");
  AddDetail( ({ "rand" }),
    "Der Weg hat einen Rand, begrenzt durch den Nebel.");
  AddDetail( ({ "buntes" }),
    "Es sind ein paar niedliche Bluemchen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hin und wieder ein Rascheln und das Pfeifen des Windes. Ansonsten ist es hier fast erdrueckend still.");

  AddSound( ({ "rascheln", "geraeusch" }),
    "Leider kannst Du nicht ausmachen, woher das Geraeusch kommt. Ob Du beobachtet wirst?");
  AddSound( ({ "pfeifen", "wind","brise" }),
    "Es ist hier nicht sonderlich windig, nur hin und wieder kommt eine leichte Brise auf.");
  AddSound( ({ "stille" }),
    "Die Stille ist ein wenig erdrueckend.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein bisschen feucht, ansonsten riecht es neutral.");

  AddSmell( ({ "luft" }),
    "Die Luft ist recht feucht.");

  AddSmell( ({ "bluemchen" }),
    "Die Bluemchen riechen herrlich frisch und suess.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "pfluecke","pflueck" }), "pfluecken" );
 
  AddExit( "norden", "./poesie_4g" );
  AddExit( "westen", "./poesie_5f" );
  AddExit( "sueden", "./poesie_6g" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}


string schemen()
{
	int i;
	i=random(5);
	if (i==0) return ("War da nicht grad ein Gesicht?\n");
	if (i==1) return ("War da nicht grad ein Fuss?\n");
	if (i==2) return ("War da nicht grad eine Hand?\n");
	if (i==3) return ("War da nicht grad ein Bein?\n");
	if (i==4) return ("War da nicht grad ein Arm?\n");
}


int pfluecken(string str)
{
	notify_fail("Was moechtest Du pfluecken?\n");
	if(str!="bluemchen") return 0;
	if(!bluemchen) 
		{
			write ("Du willst gerade ein Bluemchen pfluecken, da faellt "+
			       "Dir auf, wie wenige es nur noch sind. Du laesst es "+
				   "daher lieber und nimmst Dir vor wieder zu kommen, wenn "+
				   "wieder welche nachgewachsen sind.\n");
			return 1;
		}
	else
		{
			write("Du pflueckst ein kleines Bluemchen und steckst es ein.\n");
			say(TPN+" pflueckt ein Bluemchen.\n");
			CLONE(POESIE_OBJ +"bluemchen.lpc", TP);
			bluemchen--;
			return 1;
		}
	return 0;

	
	}