#include "../def.h"
#include <ansi.h>
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tafel");
  SetProp(P_LONG,
    "Eine kleine, steinerne Tafel. Du kannst sie lesen." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "tafel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"tafel"}));

  SetProp(P_MATERIAL, MAT_MISC_STONE);

  SetProp(P_NOGET, "Die Tafel ist fest im Boden verankert.\n");
  AddReadDetail( ({ "tafel" }),
    "   Hier landet hin und wieder ein Adler,\n"+
    "   der Reisende gerne mit nimmt.\n"+
    "   Meistens fliegt er ins grosse, ferne Gebirge \n"+
    "   und in die Stadt der Menschen.\n"+
    "   Tippe dazu einfach reise nach *ziel*\n"
    "   Sobald der Adler dann landet kletterst Du \n"
    "   automatisch auf seinen Ruecken.");
}
