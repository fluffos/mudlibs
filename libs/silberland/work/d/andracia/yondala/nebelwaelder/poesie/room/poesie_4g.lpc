#include <moredef.h>
inherit "std/post";
#include <properties.h>
#include "../def.h"

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer gelblichen Lehmhuette" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einer kleinen, runden Lehmhuette. Bis auf zwei Schreibkabinen ist die "
    "Huette leer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "schreibkabinen","kabinen" }),
    "Es handelt sich und zwei kleine Ein-Personen-Kabine, in denen Du ungestoert Deine Post "
    "lesen und schreiben kannst. Du kannst sie betreten. ");
  AddDetail( ({ "post" }),
    "Mit \"mail\" kannst Du Deine Post lesen.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus gelblichem Lehm.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht einfach nur aus plattgestampfter Erde.");
  AddDetail( ({ "erde" }),
    "Die Erde hier wurde plattgestampft,");
  AddDetail( ({ "decke" }),
    "Die Decke ist kuppelfoermig und aus gelblichem Lehm.");
  AddDetail( ({ "lehm" }),
    "Der Lehm, aus dem hier alles besteht, ist gelblich.");
  AddDetail( ({ "huette","lehmhuette" }),
    "Du befindest Dich in einer kleinen runden Lehmhuette, die aus gelblichem Lehm erbaut wurde.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es ist hier schoen still.");

  AddSound( ({ "stille" }),
    "Es ist absolut nichts zu hoeren. Herrlich.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach feuchter Erde.");

  AddSmell( ({ "erde" }),
    "Komisch, dabei ist hier doch alles trocken, oder?");

  AddExit( "sueden", "./poesie_5g" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}


