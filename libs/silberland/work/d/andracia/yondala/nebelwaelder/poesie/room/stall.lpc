#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Stall" );
  SetProp( P_INT_LONG,
    "Du betritst einen Stall, du wirst fast erschlagen vom Geruch fast erschlagen der dir "
    "entgegen weht. Aus den  Toren zu den einzelnen Pferboxen, welche im Osten liegen dringt " 
		"dir ein Wiehern entgegen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );


  AddDetail( ({ "geruch" }),
    "Der Geruch von Frischen Pferdeaepfeln"); 
  AddDetail( ({ "Pferdeaepfel" }),
    "In einem besonders grosser brauner Pflatschen ein Metallgegenstand schimmert"); 
  AddDetail( ({ "metallgegenstand" }),
    "Es handelt sich offensichtlich um ein paar Sporen, welche ein Reiter verloren hat"); 
  AddDetail( ({ "sporen" }),
    "Glitzernd... sobald man sie vom Mist befreit hat"); 
  AddDetail( ({ "pferdebox" }),
    "die Liegen im Osten"); 
  AddDetail( ({ "wiehern" }),
    "Es scheint von den Boxen im Osten zu kommen und klingt sehrUnruhig "); 
  AddDetail( ({ "boden" }),
    "Der Boden ist dreckig und voller Pferdeaepfel hier hat wohl laenger niemand sauber gemacht"); 
  AddDetail( ({ "waende" }),
    "Die waende Sind voller ungeordneten Reitzeugs"); 
  AddDetail( ({ "reitzeugs" }),
    "Du siehst Dort Saettel Zaumzeug und noch einige Dinge die du nicht genau zuordnen kannst"); 
  AddDetail( ({ "decke" }),
    "Aus Holz gefertigt und durchaus so dicht dass sie den Regen abhaelt, und leider auch den Geruch davon abhaelt nach draussen Abzuziehen"); 
  AddDetail( ({ "" }),
    ""); 
    
 }