#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int i, schlaege, staerke;
string farbe, besonders;

void create() 
{
	schlaege=0;
  if (!is_clone(TO)) return;
  ::create();
besonders="hell";
staerke=1;

if(random(20)==0)
	{
		staerke=2;
		besonders="maechtig";
	  SetProp(P_NAME_ADJ, besonders);

	}  	
i=random(5);
if(i==0) farbe= "weiss"; //Eisschutz
if(i==1) farbe= "rot";//Feuerschutz
if(i==2) farbe= "schwarz";//boeses
if(i==3) farbe= "blau";//Wasserschutz
if(i==4) farbe= "gelb";//Blitzschutz

  SetProp(P_SHORT, "Eine "+besonders+"e "+farbe+"e Aura");
  SetProp(P_LONG,
    "Eine "+besonders+"e "+farbe+"schimmernde Aura. Diese Aura scheint einen maechtigen Schutz zu bieten, "
    "sie leuchtet schwach und scheint vor lauter Magie zu pulsieren." );
 SetProp(P_NAME_ADJ, farbe);
SetProp(P_WORN_TEXT, "umhuellend");

  SetProp(P_INFO, BS("Diese Aura besteht aus purer Magie. Sie kann Dich sicher vor einigem Schaden bewahren, doch bist Du sicher, dass sie das nicht ewig tut.") );
  SetProp(P_NAME, "Aura");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"aura", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
 
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  //AddProp(P_DAM_PROTECTION, ([DT_:]) );
 // SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
 //nur fuer Seher machen.
 SetProp(P_DEFEND_FUNC, this_object());
 }
erloeschen()
{      	
  tell_object(environment(TO), "Die Aura erlischt.\n");
  TO->remove();     		
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
  {
  	int prot;
    prot = 0;
    
    if(i==0)
    	{
    		if (member(dtyp, DT_COLD) >= 0)   /* Eis unter den Schadenstypen */
    		prot = 10 + random(10);  
		    tell_object(environment(TO), "Die Aura absorbiert einen Teil des Eises.\n");					
		    }

    if (i==1)
    	{
	      if (member(dtyp, DT_FIRE) >= 0)   /* Feuer unter den Schadenstypen */
         prot = 10 + random(10);  
         tell_object(environment(TO), "Die Aura absorbiert einen Teil des Feuers.\n");					
         }
 		if(i==2) //boeses
    	{
	      if (member(dtyp, DT_UNHOLY) >= 0)  
         prot = 10 + random(10);  
         tell_object(environment(TO), "Die Aura absorbiert einen Teil der boesen Magie.\n");		
         }
 


		if(i==3) //Wasserschutz
    	{
	      if (member(dtyp, DT_WATER) >= 0) 
         prot = 10 + random(10);  
         tell_object(environment(TO), "Die Aura absorbiert einen Teil des Wassers.\n");					
         }
  	if(i==4) //Blitzschutz
    	{
	      if (member(dtyp, DT_FIRE) >= 0)   
         prot = 10 + random(10);  
         tell_object(environment(TO), "Die Aura absorbiert einen Teil des Blitzes.\n");					
         }

         /* Der Rueckgabewert wird auf den aus P_AC errechneten Wert
          draufgeschlagen. */
       schlaege+=prot;
       if(schlaege>500) call_out("erloeschen",1);
       prot*=staerke;
          return prot;
       }

int WearFunc(object me) {
  //darf nur eine getragen werden
  object besitzer, next;
  object ob;

  besitzer=environment(TO);
	//if(!besitzer->query_wiz_level)return 0;
	if(!IS_SEER(TP) )
		{
			tell_object(besitzer, "Dazu musst Du Seher sein.\n");
			return 0;
		}
		
	for(ob=first_inventory(besitzer);ob;)
	{
		next=next_inventory(ob);
		if(ob->id("aura")&&ob->QueryProp(P_WORN))
			{
				tell_object(besitzer, "Du kannst nur eine Aura tragen.\n");
				return 0;
			}
		ob=next;
		}
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

void BecomesNetDead(object spieler)
{
	if(spieler==environment(TO))
		{
			tell_room(environment(spieler),"Die Aura loest sich auf.\n");
   		remove();
   	}
		
	
	}