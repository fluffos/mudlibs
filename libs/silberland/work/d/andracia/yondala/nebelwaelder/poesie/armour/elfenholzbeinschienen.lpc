#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Hoelzerne Beinschienen");
  SetProp(P_LONG,
    "Du siehst ein paar holerzerne Beinschienen, die sich ihrem Traeger auf "
    "wundersame Weise perfekt anschmiegen." );
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"beinschienen", "", ""}) );
  SetProp(P_ARTICLE, 0);

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([ MAT_BEECH, MAT_MISC_MAGIC ]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 150);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_MAGIC]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
