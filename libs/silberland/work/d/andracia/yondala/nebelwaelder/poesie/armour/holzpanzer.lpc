#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzpanzer");
  SetProp(P_LONG,
    "Du siehst einen duennen hoelzernen Panzer, der keinerlei "
    "Bearbeitungsspuren aufweisst." );
  SetProp(P_NAME, "Holzpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "holzpanzer"}) );
  AddDetail( ({ "bearbeitungsspuren","bearbeitungsspur" }),
    "Du kannst keine sehen, der Panzer scheint so gewachsen zu sein.");    

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([ MAT_WOOD:80, MAT_MAGIC: 20]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//soll noch rein, dass es anfaellig auf Feuer ist (weil ist ja holz)
  SetProp(P_DAM_PROTECTION, DT_MAGIC);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:"Elf"]) );
}

int WearFunc(object me) {
			 if (this_player()->QueryProp(P_ALIGN)<=0)
			 	{write("Du bist viel zu boese um diesen Panzer zu tragen.\n");
			 		return 0;}
  write("Du fuehlst wie sich der Panzer optimal an Deine Groesse und Deine Figut anpasst.\n");
  return 1;
}

int RemoveFunc(object me) {

  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
