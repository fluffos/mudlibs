    "sagt: ");
  SUID;
  CLONEME(POESIE_WEAPON "elfendolch" );
  command("zuecke dolch");
  CLONEME(POESIE_ARMOUR "elfentunika" );
  CLONEME(POESIE_ARMOUR "elfenguertel" );
  command("trage alles");
