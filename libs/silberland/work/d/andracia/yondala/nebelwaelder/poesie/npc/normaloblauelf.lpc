      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );*/

  SetProp(P_MSGIN, "taenzelt heran und setz sich auf den Boden");
  SetProp(P_MSGOUT, "steht auf und taenzelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
SetProp (P_MNPC_DEFAULTROOM, "/d/nebelwaelder/yondala/poesie/room/poesie_4d");
SetProp (P_MNPC_AREA, ({"/d/",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);

  SetProp(P_MNPC_WAIT, ({ 10, 50, 50 }));

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-POESIE_NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");


  AddInfo("", ".","sagt: ");

  AddInfo( ({"",""}),
