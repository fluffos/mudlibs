  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 160); //muss noch berechnet werden aus gender und groesse
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
//  SetProp(P_HEAL, 0);
  //SetProp(P_AGGRESSIVE,0);
  //SetProp(P_WIMPY, 0);
