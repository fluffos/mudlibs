/*
string *alter=({"junge","alte"});
string *gewicht=({"dicke","duenne"});
string *groesse=({"grosse","kleine"});
*/
void create() {
  if (!is_clone(TO)) return;
  ::create();
x=1;
helferlein=random(3);
if (helferlein ==0) 
	{
		alter="junge";
		x++;
	}

else if(helferlein==2) 
	{
		alter="alte";
		x+=2;
	}

else x+=3;
	
helferlein=random(3);
if (helferlein ==0)     gewicht="duenne"; 
else if(helferlein==1) {gewicht="dicke";    x+=3;}
else if(helferlein==2) {gewicht="schlanke"; x+=2;}

helferlein=random(3);
if (helferlein ==0)     groesse="kleine";
else if(helferlein==1) {groesse="grosse"; x+=2;}
else 									                   x+=1;

/*	
    if(alter)    beschreibung = alter+"n ";	
		if(groesse)  beschreibung+= groesse+"n ";	
		if(gewicht)  beschreibung+= gewicht+"n ";	
		*/
	
geschlecht=random(2);
if(geschlecht==0)   
	{
		beschreibung =" ";
    if(alter)    beschreibung= beschreibung+alter+"n ";	
		if(groesse)  beschreibung= beschreibung+groesse+"n ";	
		if(gewicht)  beschreibung= beschreibung+gewicht+"n ";	
		SetProp(P_GENDER, MALE);
		SetProp(P_LONG, "Du siehst einen"+beschreibung+"Blauelf, welcher hier auf dem Boden sitzt und zufrieden "
		"sein Leben geniesst. ");			
	/*	if(alter)     SetProp(P_LONG, QueryProp(P_SHORT)+"\b" +alter+"n ");	
		if(groesse)     SetProp(P_LONG, QueryProp(P_SHORT) +"\b"+groesse+"n ");	
		if(gewicht)     SetProp(P_LONG, QueryProp(P_SHORT) +"\b"+gewicht+"n ");	

		SetProp(P_LONG, QueryProp(P_LONG) +"Blauelf, welcher hier auf dem Boden sitzt und zufrieden "
		"sein Leben geniesst. "); 
		*/
			
		//SetProp(P_SHORT, "Ein "+beschreibung+"Blauelf");	
    SetProp(P_SHORT, "Ein ");		
  	if(alter)   SetProp(P_SHORT, QueryProp(P_SHORT) +alter+"r " );	
		if(groesse) SetProp(P_SHORT, QueryProp(P_SHORT) +groesse+"r ");	
		if(gewicht) SetProp(P_SHORT, QueryProp(P_SHORT) +gewicht+"r ");	
    SetProp(P_SHORT, QueryProp(P_SHORT) +"Blauelf");
		SetProp(P_NAME, "Blauelf");
    AddId(({"elf", "blauelf"}));		
     		x+=4;
		  AddInfo(DEFAULT_INFO, "sagt: Was weiss denn ich?\n"
  											"Der Blauelf sagt: fragt doch nicht mich!\n");
		}

else   
	{
		SetProp(P_GENDER, FEMALE);
    SetProp(P_SHORT, "Eine ");		
		if(alter)     SetProp(P_SHORT, QueryProp(P_SHORT) +alter+" " );	
		if(groesse)     SetProp(P_SHORT, QueryProp(P_SHORT) +groesse+" ");	
		if(gewicht)     SetProp(P_SHORT, QueryProp(P_SHORT) +gewicht+" ");	
		SetProp(P_SHORT, QueryProp(P_SHORT) +"Blauelfe");	
		
		beschreibung =" ";
    if(alter)    beschreibung= beschreibung+alter+" ";	
		if(groesse)  beschreibung= beschreibung+groesse+" ";	
		if(gewicht)  beschreibung= beschreibung+gewicht+" ";	
		SetProp(P_LONG, "Du siehst eine"+beschreibung+"Blauelfe, welche hier auf dem Boden sitzt und zufrieden "
		"ihr Leben geniesst. ");		
		/*SetProp(P_LONG, "Du siehst eine ");		
		if(alter)   SetProp(P_LONG, QueryProp(P_LONG) +alter+" " );	
		if(groesse) SetProp(P_LONG, QueryProp(P_LONG) +groesse+" ");	
		if(gewicht) SetProp(P_LONG, QueryProp(P_LONG) +gewicht+" ");	

		SetProp(P_LONG, QueryProp(P_LONG) +"Blauelfe, welche hier auf dem Boden sitzt und zufrieden "
		"ihr Leben geniesst. ");	*/
	  SetProp(P_NAME, "Blauelfe");
    AddId(({"elfe", "elfin", "blauelfe", "blauelfin"}));		
    x+=2;
    AddInfo(DEFAULT_INFO, "sagt: Was weiss denn ich?\n"
          								"Die Blauelfe sagt: fragt doch nicht mich!\n");
		}
/*		
// SetProp(P_NAME_ADJ,QueryProp(P_NAME_ADJ)+ alter);
 SetProp(P_NAME_ADJ,QueryProp(P_NAME_ADJ)+ gewicht);	
 SetProp(P_NAME_ADJ,QueryProp(P_NAME_ADJ)+ groesse);	
	*/


//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(x);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
