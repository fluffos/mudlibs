#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem schmalen Pfad" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einem schmalen Pfad, der seitlich von kleinen Hecken begrenzt ist. "
    "Im Westen fuehrt er Dich auf einen grossen Platz, im Osten kannst Du lediglich eine "
    "Gabelung erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );
  AddDetail( ({ "platz", "westen" }),
    "Im Westen befindet sich ein grosser Platz.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "hecken", "hecke" }),
    "Der Pfad ist durch hohe kleinblaettrige Hecken begrenzt. Dahinter steht eine "
    "undurchfringliche Nebelwand.");
  AddDetail( ({ "blaetter" }),//FP drauf
    "Die Blaetter der beiden Hecken sind sehr klein. Alle, bis auf eines sind gruen.");
  AddDetail( ({ "pfad" }),
    "Du stehst auf einem schmalen Pfad, der von einem grossen Platz im Westen zu einer "
    "Gabelung im Osten fuehrt.");
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hell und dick. Du kannst absolut nicht sehen, was sich hinter den Hecken "
    "befindet.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um den Platz herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "nebelwaende", "nebelwand" }),
    "Du betrachtest die Nebelwaende eingaengig und meinst einige Schemen erkennen zu koennen.");
  AddSpecialDetail( ({ "schemen","scheme","formen","form"  }), "schemen" );
  AddDetail( ({ "gesicht","fuss","hand","arm","bein" }),
    "Du bist Dir nicht sicher, was Du in dem wabernden Nebel fuer Formen siehst.");
  AddDetail( ({ "boden" }),
    "Der Boden ist sehr sandig.");
  AddDetail( ({ "sand" }),
    "Im Sand kannst Du einige Spuren entdecken.");
  AddDetail( ({ "spuren" }),
    "Die Spuren fuehren von Westen nach Osten und umgekehrt.");
  AddDetail( ({ "gabelung", "osten" }),
    "Der Pfad gabelt sich im Osten.");
  AddDetail( ({ "blatt" }),
    "Das eine Blatt ist eher graeulich.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hin und wieder ein Rascheln und das Pfeifen des Windes. "
	"Ansonsten ist es hier fast erdrueckend still.");

  AddSound( ({ "rascheln", "geraeusch" }),
    "Leider kannst Du nicht ausmachen, woher das Geraeusch kommt. Ob Du beobachtet wirst?");
  AddSound( ({ "pfeifen", "wind","brise" }),
    "Es ist hier nicht sonderlich windig, nur hin und wieder kommt eine leichte Brise auf.");
  AddSound( ({ "stille" }),
    "Die Stille ist ein wenig erdrueckend.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein bisschen feucht, ansonsten riecht es neutral.");

  AddSmell( ({ "luft" }),
    "Die Luft ist recht feucht.");

  AddExit( "osten", "./poesie_5g" );
  AddExit( "westen", "./poesie_5e" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}


string schemen()
{
	int i;
	i=random(5);
	if (i==0) return ("War da nicht grad ein Gesicht?\n");
	if (i==1) return ("War da nicht grad ein Fuss?\n");
	if (i==2) return ("War da nicht grad eine Hand?\n");
	if (i==3) return ("War da nicht grad ein Bein?\n");
	if (i==4) return ("War da nicht grad ein Arm?\n");
}
