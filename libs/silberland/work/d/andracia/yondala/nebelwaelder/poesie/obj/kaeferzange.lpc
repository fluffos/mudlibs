#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Kaeferzange");
  SetProp(P_LONG,
    "Du siehst eine kleine Kaeferzange vor Dir, die vermutlich jemand einem sterbenden Kaefer als Trophaee entrissen hat." );
  SetProp(P_NAME, "Kaeferzange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zange","kaeferzange"}));
SetProp( P_MATERIAL, MAT_CHITIN );

  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 0);

}


	