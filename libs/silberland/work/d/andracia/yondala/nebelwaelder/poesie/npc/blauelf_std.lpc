//Der Blauelf

inherit "std/mnpc";
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include <moving.h>
#include <language.h>
#include "../def.h"

void create() {

  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");

  AddId(({"blauelf"}));//Dinge auf die man ihn beim untersuchen ansprechen kann


  SetProp (P_MNPC_DEFAULTROOM, "/d/nebelwaelder/yondala/poesie/room/poesie_4d");
  SetProp (P_MNPC_AREA, "/d/nebelwaelder/yondala/poesie/room/" );
  SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  
  create_default_npc(15);// Die Zahl entspricht der Spielerstufe des POESIE_NPC
  
  SetProp(P_RACE, "Blauelf");
  SetProp(P_MSGIN, "wandelt herbei"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "wandelt");//verlassen wird
  SetProp(P_MMSGIN, "entschwindet");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "erscheint");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_NOCORPSE, 0 );// bei 0 hat er ne Leiche.
  SetProp(P_KILL_NAME, "Ein Blauelf");//name des toetenden npc
  SetProp(P_KILL_MSG, "Das ist Deine gerechte Strafe!");//die meldung wenn der POESIE_NPC einen Spieler umgebracht hat

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  //AddInfo(DEFAULT_INFO, "ignoriert Deine Frage.\n");

  AddInfo("yoni", "Lang lebe Yoni.","sagt: "); 
  AddInfo( ({"adel","hochadel","yondala","yason", "nyx", "aginor"}),
    "Lang lebe der Hochadel!",
    "sagt: ");

      
  AddInfo( ({ "land" }),
    "Schaut Euch doch um!\n"
    "Es ist um uns herum.",
    "sagt: ");        
  AddInfo( ({ "dorf","poesie" }),
    "Dies ist das Dorf der Poesie.\n"
    "Verlassen, mag ich es nie.",
    "sagt: ");        
  AddInfo( ({ "nebel" }),
    "Niemand weiss mehr wann er kam,\n"
    "Niemand weiss hier, wann er geht.\n"
    "Er ist nicht kalt er ist nicht warm,\n"
    "Er wird von keinem Sturm verweht.",
    "sagt: ");        
  AddInfo( ({ "sturm" }),
    "Ein Sturm ist ein starker Wind,\n"
    "Das weiss doch jedes Kind.",
    "sagt: ");        
  AddInfo( ({ "wind" }),
    "Der Wind, der Wind,\n"
    "Das himmlische Kind",
    "sagt: ");        
  AddInfo( ({ "kind","kinder" }),
    "Kinder sind das wichtigste im Leben.\n"
    "Ohne sie, wuerde es uns nicht geben.",
    "sagt: ");        
  AddInfo( ({ "leben" }),
    "Das Leben, das Leben,\n"
    "Kann es was schoeneres geben?",
    "sagt: ");        
  AddInfo( ({ "halle","versammlungshalle","gilde","versammlungsraum" }),
    "In diesem Haus\n"
    "Treffen sich die blauen Elfen,\n"
    "wir gehen dort ein und aus.\n"
    "Dort koennen wir uns helfen,\n"
    "reden von wichtigen Dingen,\n"
    "lernen zaubern, tanzen, singen.",
    "sagt: ");        
  AddInfo( ({ ",zaubern","zauber","lernen" }),
    "Zaubern lernen wir alle,\n"
    "In unserer Versammlungshalle.",
    "sagt: ");        
  AddInfo( ({ "tanken","kneipe","essen","trinken","speisen","bar", "harmonie", "wirtin","wirt" }),
    "Harmonie bereitet die besten speisen\n"
    "Dorthin kann ich nur verweisen.",
    "sagt: ");        
  AddInfo( ({ "elf","elfe","elfen","blauelf","blauelfen" }),
    "Wir Blauelfen sind klasse,\n"
    "Elf sein ist die beste Rasse!",
    "sagt: ");        
  AddInfo( ({ "adel","hochadel" }),
    "Die Adeligen sind die hoechsten im Land\n"
    "Ist Euch das denn nicht bekannt?",
    "sagt: ");        
  AddInfo( ({ "musik" }),
    "Musik ist das wichtigste was wir haben,\n"
    "an ihr koennen wir uns erquicken und laben.",
    "sagt: ");        
  AddInfo( ({ "laden","melodie" }),
    "Moechtet Ihr etwas kaufen?\nDann solltet Ihr zu Melodie Laufen.",
    "sagt: ");        
  AddInfo( ({ "singen","tanzen", "lachen","freude" }),
    "Singen, Tanzen, Lachen.\nDas sind Dinge, die Freude machen.",
    "sagt: ");        
  AddInfo( ({ "zaubern","zauber" }),
    "Die Zauber lernt Ihr alle\nin unserer Versammlungshalle.",
    "sagt: ");        
  AddInfo( ({ "magie" }),
    "Mit unserer Musik koennen wir Magie vollbringen.\nDazu muessen wir nur musizieren und singen.",
    "sagt: ");        
  AddInfo( ({ "musizieren" }),
    "Zum musizieren koennen uns Elfen\nunsere Instrumente helfen.",
    "sagt: ");        
  AddInfo( ({ "instrumente", "instrument","musikinstrument", "musikinstrumente" }),
    "Seid Ihr reif, so kann Bariton Euch eines geben\nVielleicht rettet es dereins Euer Leben.",
    "sagt: ");        
  AddInfo( ({ "bariton" }),
    "Bariton fertigt Instrumente mit eigner Hand.\nDafuer ist er weithin bekannt.",
    "sagt: ");        
  AddInfo( ({ "geld","muenzen" }),
    "Braucht Ihr muenzen, so muesst Ihr etwas verkaufen.\nDazu solltet Ihr zu Melodie laufen.",
    "sagt: ");        
  AddInfo( ({ "" }),
    "",
    "sagt: ");
    
 //   SUID;
 //   CLONEME(POESIE_OBJ + "goldsaeckchen.lpc");

    
}

