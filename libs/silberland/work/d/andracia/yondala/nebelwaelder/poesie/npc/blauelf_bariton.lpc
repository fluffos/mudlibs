//Bariton, der Musiklehrer
//hier bekommen Blauelfenspieler ihre Floete


#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
inherit POESIE_NPC +"blauelf_std.lpc";
int kleidung, waffe;

inherit "/gilden/bardengilde/obj/std_spellprovider";

string blauelfenfloete() //wenn man nach der Floete fragt.
{
	object floete;
	if(TP->QueryProp(P_RACE)=="Blauelf")
		{
			if(present("\nblauelfenfloete",TP))//Der Spieler ist Blauelf und hat die Floete
				{
					floete=present("\nblauelfenfloete",TP);
					floete->remove();
		      CLONE(POESIE_OBJ+"blauelfenfloete.lpc", TP);
		      command("sag Ihr habt zwar schon eine Floete, doch gebe ich Euch gerne eine neue.\n");
		      write("Bariton nimmt Dir Deine alte Floete ab und gibt Dir eine neue.\n");
		      say("Bariton nimmt "+TPN+" die alte Floete ab und gibt "+ TP->QueryPronoun(WEM)+" eine neue.\n",TP);



		      return("Bitte sehr.\n");
		    }
		   else //Der Spieler ist Blauelf und hat keine Floete
		   	{
		      CLONE(POESIE_OBJ+"blauelfenfloete.lpc", TP);
		      command("sag Hoppla, ein Blauelf ohne Floete, na sowas.\n");
		      say("Bariton nimmt eine kleine Floete aus dem Kasten.\n");
		      return("Hier habt Ihr eine Floete, viel Spass damit!\n");
		    }
		  }
	else//Wenn der Spieler kein Blauelf ist
		{
			return("Wir Blauelfen haben stets eine kleine Floete bei uns, mit deren Hilfe wir "
						 "unsere Magie im Auge behalten und auch untereinander kommunizieren koennen.");	    
		   		
		   		} 
}

void reset()
{
	kleidung=1;
	waffe=1;
	::reset();
	}					
					
		
	
	

void create() {
  if (!is_clone(TO)) return;
  ::create();
	kleidung=1;
	waffe=1;
  SetProp(P_SHORT, "Bariton, der Musiklehrer");
  SetProp(P_LONG,
    "Du siehst einen grossen, dicken Blauelfen vor Dir. Bariton hat hellblaue, fast weisse "
    "Haare, auf seiner Nase sitzt eine kleine, goldene Brille. Er beobachtet Dich interessiert." );
  SetProp(P_NAME, "Bariton");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"bariton", "elf", "blauelf", "lehrer", "musiklehrer"}));
  create_default_npc(32);
  SetProp(P_HANDS, ({" mit Pauken und Trompeten",QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/poesie/room/poesie_3f");
  
  SetProp(P_SIZE, 195);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 900);

  SetProp(P_RACE, "Blauelf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    -0.5, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.5, DT_UNHOLY:    0.5, DT_MAGIC:  0.5 ]) );
  SetProp(P_NOATTACK, 0);//erstmal

//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst " +TPN+ " nicht entkommen!");
  SetProp(P_KILL_NAME, "Bariton");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Ist es Euch wichtig, \nBariton sagt: so fragt mich richtig!\n");

//  AddInfo( ({"floete", "blauelfenfloete","blaufloete"}), #'blauelfenfloete, "sagt: "); //#'  

  AddInfo( ({"bariton","musiklehrer", "lehrer"}), 
    "So werde ich genannt\nWar Euch das nicht bekannt?",
    "sagt: "); 
  AddInfo( ({ "instrumente", "instrument","musikinstrument", "musikinstrumente","musikinstrumenten","instrumenten" }),
    "Seid Ihr reif, so kann ich Euch eines geben\nVielleicht rettet es dereins Euer Leben.",
    "sagt: ");        
  AddInfo( ({"ausruestung", "tunika"}), 
    "Bekundet Euren Wunsch mit einer Bitte,\nDas ist bei uns so Sitte.",
    "sagt: "); 
  AddInfo( ({"hilfe","helfen"}), 
    "Kleinen Blauelfen\nwerd ich gerne helfen.\nDrum sagt, was Ihr begehrt,\nVielleicht wird es Euch gewehrt.",
    "sagt: "); 
  AddInfo( ({"waffen","waffe"}), 
    "Sowas ist fuer mich nicht von Noeten\nNur ungern will ich jemanden toeten.",
    "sagt: "); 
  AddInfo( ({"kasten"}), 
    "Meine Floeten bewahre ich darin,\nWeil ich der Musiklehrer bin.",
    "sagt: "); 
  AddInfo( ({"ausweg","weg","nebel", "nebelwehe","nebelwehen", "ausgang"}), 
    "Durch manche Nebelwehen\nKoennt Ihr einfach hindurch gehen.\n"+
    "Koennt Ihr es auch nicht sehen,\nso koennt Ihr am kleinen Platz noch weiter gehen.\n"+
    "Fuer grosse Weiten\nKoennt Ihr aber auch den Adler reiten.",
    "sagt: "); 
  AddInfo( ({"regale","regal"}), 
    "Ihr koennt doch sehen,\nDass dort meine Instrumente stehen.",
    "sagt: "); 
  AddInfo( ({"reisen"}), 
    "Zum Reisen\nKann ich auf den Adler verweisen.",
    "sagt: "); 
  AddInfo( ({"adler","reiten"}), 
    "Mit seinen grossen Schwingen\nKann der Adler Euch an so manche Orte bringen.",
    "sagt: "); 
  AddInfo( ({"orte"}), 
    "Menschendorf und grosses Tal\nWohin Ihr wollt, Ihr habt die Wahl.",
    "sagt: "); 
  AddInfo( ({"floete", "blauelfenfloete","blaufloete"}), 
    "Yondala hat mir bis auf Weiteres verboten,\ndie Floete zu geben in Eure Pfoten!",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
     
 
  /*SetProp (P_REJECT,
    ({ REJECT_DROP, "Bariton laesst @WEN durch sich hindurchfallen.\n" }) );    */
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
 SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,850,
	        "Bariton wirft eine Magiekugel nach Dir.\n",
	        "Bariton wirft eine Magiekugel nach @WEM.\n",
	         ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,400,
	         "Bariton zerschlaegt eine Geige auf Deinem Kopf.\n",
	         "Bariton zerschlaegt eine Geiger auf dem Kopf von @WEM.\n",
	         ({DT_AIR}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,170,
	         "Bariton stimmt einen Kampfgesang an.\n",
	         "Bariton stimmt einen Kampfgesang an.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );








  SetChats(1, ({
    "Bariton summt leise ein Melodie.\n",
    "Bariton streicht liebevoll ueber eines seiner Instrumente.\n"}) );
//  SetAttackChats(10, ({
  //  ".\n"}) );

  SUID;
  CLONEME(POESIE_ARMOUR "elfentunika" );
  CLONEME(POESIE_ARMOUR "elfenseidenschuhe" );
  CLONEME(POESIE_ARMOUR "elfenguertel" );
  CLONEME(POESIE_ARMOUR "aura" );
  command("trage alles");
  
  AddCmd( ({ "bitte" }), "bitten" );


}

int bitten(string str)
{
	string dummi;
	notify_fail("Wenn moechstest Du um was bitte?\n");
	if(str=="bariton um ausruestung"||str=="bariton um kleidung"||
		 str=="elf um ausruestung"||str=="elf um kleidung"||
		 str=="blauelf um tunika"||str=="blauelf um tunika"||
		 str=="bariton um tunika"||str=="bariton um tunika"||
		 str=="elf um tunika"||str=="elf um tunika"||
		 str=="blauelf um tunika"||str=="blauelf um tunika")
	{
		write("Du bittest "+capitalize(str)+".\n");
		say(TPN+" bittet "+capitalize(str)+".\n",TP);
		if(!kleidung)
			{
				command("sag Die ist schon weg, das tut mir leid.");
				command("sag Kommt wieder zu einer anderen Zeit!");
				return 1;
			}
		if(TP->QueryProp(P_LEVEL)>4)
			{
				command("sag Ihr seid doch schon so gross, "+TPN+", Ihr finde sicher woanders etwas besseres!\n");
				return 1;
			}
		write("Bariton reicht Dir etwas zum anziehen.\n");
		say("Bariton reicht "+TPN+" etwas zum anziehen.\n",TP);
		CLONE(POESIE_ARMOUR+"elfentunika.lpc", TP);
		kleidung=0;
		return 1;
	}
	if(str=="bariton um waffe"||str=="bariton um waffe"||
		 str=="elf um waffe"||str=="elf um waffe"||
		 str=="blauelf um waffe"||str=="blauelf um waffe"||
		 str=="bariton um waffen"||str=="bariton um dolch"||
		 str=="elf um waffen"||str=="elf um dolch"||
		 str=="blauelf um waffen"||str=="blauelf um dolch")
	{
		write("Du bittest "+capitalize(str)+".\n");
		say(TPN+" bittet "+capitalize(str)+".\n",TP);
		if(!waffe)
			{
				command("sag Die ist schon weg, das tut mir leid.");
				command("sag Kommt wieder zu einer anderen Zeit!");
				return 1;
			}
		if(TP->QueryProp(P_LEVEL)>4)
			{
				command("sag Ihr seid doch schon so gross.");
				command("sag So eine Waffe behindert Euch bloss.");
				return 1;
			}
		write("Bariton reicht Dir einen Dolch.\n");
		say("Bariton reicht "+TPN+" einen Dolch.\n",TP);
		CLONE(POESIE_WEAPON+"elfendolch.lpc", TP);
		waffe=0;
		return 1;
	}
	if(str=="bariton um instrument"||
		 str=="elf um instrument"||
		 str=="blauelf um instrument")
	{
		write("Du bittest "+capitalize(str)+".\n");
		say(TPN+" bittet "+capitalize(str)+".\n",TP);
		command("sag Dazu seid Ihr noch nicht bereit.");
		command("sag Kommt wieder zu einer anderen Zeit!");
		return 1;
	}
	if(str=="bariton um floete"||
		 str=="elf um floete"||
		 str=="blauelf um floete")
	{
		write("Du bittest "+capitalize(str)+".\n");
		say(TPN+" bittet "+capitalize(str)+".\n",TP);
		if(TP->QueryProp(P_RACE!="Blauelf"))
			{
		    command("sag Das tut mir leid,");
		    command("sag Doch die Floete halte ich fuer Blauelfen bereit!");
		    return 1;
		  }
		 if(present("blauelfenfloete",TP))
		 	{
	    	write("Bariton gibt Dir einen neue Floete.\n");
	    	say("Bariton gibt "+TPN+" eine neue Floete.\n",TP);
		    present("blauelfenfloete",TP)->remove();
		    CLONE(POESIE_OBJ+"blauelfenfloete.lpc", TP);
		    return 1;
		  }
	
	    	write("Bariton gibt Dir einen neue Floete.\n");
	    	say("Bariton gibt "+TPN+" eine neue Floete.\n",TP);
		    present("blauelfenfloete",TP)->remove();
		    CLONE(POESIE_OBJ+"blauelfenfloete.lpc", TP);
		    return 1;
	 		
		}
if(sscanf(str,"bariton um %s",dummi)==1)
	{
		write("Du bittest "+capitalize(str)+".\n");
		say(TPN+" bittet "+capitalize(str)+".\n",TP);
		command("sag Das kann ich Euch nicht geben,");
		command("sag Ich hoffe, damit koennt Ihr leben.");
		return 1;
	}

	

	return 0;
}

void give_notify(object ob) {
	if(ob->id("\nbard_stimmgabel")) {
		command_me("sag Wunderbar und voll Verzueckung,");
		command_me("sag Dank ich dir voll Entrueckung!");

		if(this_player()->QueryProp(P_GUILD) == "bardengilde" && this_player()->QuerySkill("ein ton in der stille") == 0) {
			command_me("sag So zeig ich dir nun zum Lohn");
			command_me("sag den ohrbefreiend schrillen Ton!");
			call_out("teach_spell", 2, this_player());
		}
	} else {
		command_me(sprintf("emote legt %s in sein Regal.", ob->name(WEN, 1)));
	}

	ob->remove(1);
}

public void teach_spell(object pl) {
	if(!objectp(pl) || environment(pl) != environment(this_object())) {
		return;
	}

	command_me("emote schlaegt mit der Stimmgabel einen hellen Ton an.");

	call_out("LearnBardSpell", 2, this_player(), "ein ton in der stille", 
	         "Dieser Ton heilt die Taubheit der Zuhoerer.", "spiele 'ein ton in der stille'");
}
		