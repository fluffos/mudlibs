//Harmonie die Wirtin von Popina


#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
inherit POESIE_NPC +"blauelf_std.lpc";

/*
void init()
{
   ::init();
}
*/

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Harmonie");
  SetProp(P_LONG,
    "Du siehst eine fast druchscheinend blasse, schlanke Blauelfin. Sie schaut Dich aus "
    "freundlichen Augen an und wartet, ob Du nicht etwas bei ihr bestellen moechtest.." );
  SetProp(P_NAME, "Harmonie");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"harmonie", "elfe","elfin", "blauelfe", "blauelfin", "wirtin", "HARMONIE"}));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren magischen Haenden",QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp (P_MNPC_DEFAULTROOM, "/d/andracia/yondala/poesie/room/poesie_6f");
  
  SetProp(P_SIZE, 165);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 900);

  SetProp(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , //vorlaeufig so, mal sehen wies sich auswirkt
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    -0.5, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.5, DT_UNHOLY:    0.5, DT_MAGIC:  0.5 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst " +TPN+ " nicht entkommen!");
  SetProp(P_KILL_NAME, "Harmonie");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Darueber weiss ich nicht Bescheid.\nHarmonie sagt: Das tut mir wirklich furchtbar leid.\n");


  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({ "tanken","kneipe","essen","trinken","speisen","bar" }),
    "Ich bereite Euch die besten speisen\n"
    "Auf mein <menue> kann ich nur verweisen.",
    "sagt: "); 
  AddInfo( ({"harmonie","wirtin"}), 
    "So werde ich genannt\nWar Euch das nicht bekannt?",
    "sagt: ");      
 
  SetProp (P_REJECT, ({ REJECT_GIVE, "Harmonie moechte das nicht haben.\n" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
 SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);

	AddSpell(7,250,
	        "Harmonie wirft eine Magiekugel nach Dir.\n",
	        "Harmonie wirft eine Magiekugel nach @WEM.\n",
	         ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,650,
	         "Harmonie schickt einen Sturm gegen Dich.\n",
	         "Harmonie schickt einen Sturm gegen @WEN.\n",
	         ({DT_AIR}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,170,
	         "Harmonie stimmt einen Kampfgesang an.\n",
	         "Harmonie stimmt einen Kampfgesang an.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );








/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
  SUID;
  CLONEME(POESIE_ARMOUR "elfentunika" );
  CLONEME(POESIE_ARMOUR "elfenseidenschuhe" );
  CLONEME(POESIE_ARMOUR "elfenguertel" );
  command("trage alles");
  
  

}

