#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";


#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Popina" );
  SetProp( P_INT_LONG,
    "Du stehst in einer runden Lehmhuette, der auch ueber Poesie hinaus bekannten Bar \"Popina\". "
    "Alles ist hier aus Lehm oder Stroh gefertigt, aber dennoch erscheint diese kleine Bar "
    "liebevoll und gemuetlich gestaltet: Der kleine Tresen, die davorstehenden Barhocker und "
    "auch die Wandgestaltung zeugen von einem guten Geschmack." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "HARMONIE");
  SetProp( P_PUBKEEPER_NAME, "Harmonie");
  SetProp( P_PUBKEEPER_GENDER, FEMALE);
  AddItem( POESIE_NPC+"blauelf_harmonie.lpc" , REFRESH_DESTRUCT);

//Getraenke und Speisen noch anpassen
/*
Ideen:
Lebensmagie

     Ausserdem sollte heilung < 3 * (staerke+alc) sein, oder aber andere
     nennenswerte Nachteile bei Konsum des Getraenks auftreten.
	 
	      void AddDrink(string name, mixed ids, int preis, mixed heilung,
                   int alk, int staerke, mixed extra, int prozent);
*/	 
	 
	 
  AddDrink("Lebensmagie", ({ "magie","lebensmagie" }),170,15,1,10, //Preis, Volumen, Alk
  ({ "Harmonie reicht Dir einen Becher mit einer klaren Fluessigkeit, Du trinkst sie auf ex.",
       "&& ext einen Becher Lebensmagie." }) );

  AddDrink("Gebirgsnebel", ({ "gebirgsnebel","nebel" }),340,40,7,10, //Preis, Volumen, Alk
  ({ "Harmonie haucht Dir eine kleine Nebelwolke zu, die Du inhalierst.\Uff, nicht schlecht.",
       "&& inhaliert eine kleine Nebelwolke." }) );
 
  AddDrink("Waldmeistersirup", ({ "waldmeister","waldmeistersirup","sirup"}),120,10,0,10, //Preis, Volumen, Alk
  ({ "Harmonie stampft einige gruene Blaetter zusammen bis sie daraus eine dicke Fluessigkeit "
  	"gewinnt. Sie faengt sie mit einem Becher auf und serviert sie Dir.",
       "&& bestellt einen Waldmeistersirup." }) );

  AddDrink("Jasmintee", ({ "tee","jasmintee","jasmin" }),100,10,0,2, //Preis, Volumen, Alk
  ({ "Harmonie wirft ein paar Jasminblueten in eine Tasse, giesst Wasser hinzu und bringt den Tee "
  	"mit ihren Haenden zum Kochen. Sie reicht Dir die Tasse und Du geniesst den herrlichen Tee.\n",
       "&& bekommt einen frischen, heissen Jasmintee und schluerft ihn vorsichtig." }) );
  AddDrink("Ein kleines Glaeschen Wein", ({ "elfenwein","wein","weinglas","glas","glaesschen" }),140,10,2,2, //Preis, Volumen, Alk
  ({ "Harmonie schenkt Dir ein Glaeschen mit Wein ein. Du schwenkst es kurz, dann trinkst Du einen Schluck. Schade, schon ist das Glas leer.\n",
       "&& geniesst einen herrlichen Elfenwein." }) );


/*  AddFood( "Bauschwoelkchen", ({ "bausch", "woelkchen", "bauschwwoelkchen" }), 60,12,2,
            ({ "Aeron pflueckt ein Stueck aus der Wolke, steckt es auf einen Stiel und ueberreicht "
            	"ihn Dir. Du vernascht das Woelkchen und laesst nicht ein Kruemelchen uebrig.",
                        "&& nascht ein Bauschwoelcken. "
            }) );    */

  AddFood( "Kleesalat", ({ "kleesalat", "klee", "salat" }), 200,20,2,
            ({ "Harmonie fuellt eine kleine Schale mit frischem Kleesalat und reicht sie Dir. Hm, lecker.",
                        "&& verspeist einen frischen Kleesalat. "
            }) );

  AddFood( "Sandkuchen", ({ "sandkuchen", "sand", "kuchen" }), 100,50,50,
            ({ "Harmonie serviert Dir einen Sankuchen. Du bist nicht sicher woraus er besteht, "
            	"aber er schmeckt gut.\nEs rumpelt in Deinem Bauch.\n",
                        "&& laesst sich einen Sandkuchen servieren. "
            }) );
//AddFood("Heuschreckenlollie", ({ "lollie", "heuschrecke", "heuschreckenlollie" }),150,0,4,"schrecke");




  AddDetail( ({ "lehmhuette", "huette" }),
    "Du stehst in einer kleine, runden Lehmhuette.");
  AddDetail( ({ "poesie" }),
    "Das Dorf in dem sich diese Lehmhuette befindet nennt sich \"Poesie\".");
  AddDetail( ({ "dorf" }),
    "Das Dorf in dem Du Dich befindest nennt sich \"Poesie\", in ihm leben die Blauelfen.");
  AddDetail( ({ "blauelfen" }),
    "Du bist doch bestimmt schon der ein oder anderen begegnet, oder?");
  AddDetail( ({ "bar","" }),
    "Du stehst in einer gemuetlichen, kleinen Bar");
  AddDetail( ({ "popina" }),
    "Popina ist der Name der kleinen Bar in der Du Dich gerade befindest.");
  AddDetail( ({ "name","namen" }),
    "Jedes Ding braucht einen Namen.");
  AddDetail( ({ "ding", "dinge" }),
    "Du brauchst nicht jedes Ding untersuchen.");
  AddDetail( ({ "tresen" }),
    "Die halbe Bar wird von dem kleinen Tresen eingenommen. Er besteht aus Lehm und Stroh.");
  AddDetail( ({ "lehm" }),
    "Fast alles hier besteht aus Lehm. Immerwieder findest Du kleine Verzierungen oder ganze "
    "Verse im Lehm verewigt.");
  AddDetail( ({ "verzierungen" }),
    "Viele kleine Bilder oder auch Ornamente wurden ueberall in den Lehm geschnitzt. Es sieht sehr schoen aus.");
  AddDetail( ({ "bilder" }),
    "Um Dich herum an den Waenden, am Tresen, selbst an der Decke findest Du immerwieder kleine "
    "Bilder die vermutlich entweder die Wirtin selbst, oder aber ihre Gaeste dort hinein "
    "geschnitzt haben.");
  AddDetail( ({ "wirtin" }),
    "Die kommt bestimmt bald wieder.");
  AddDetail( ({ "ornamente" }),
    "Du kannst nicht genau erkennen was diese Ornamente darstellen sollen, alles in allem wirken "
    "sie jedoch sehr harmonisch und gut plaziert auf Dich.");
  AddDetail( ({ "stroh" }),
    "Einige Dinge hier sind aus Stroh, die meisten jedoch aus Lehm. Etwas Interessantes kannst Du "
    "allerdings nicht daran entdecken.");
  AddDetail( ({ "verse", "vers" }),
    "Meistens sind es kleine Zweizeiler, die teilweise lustig, teilweise romantisch oder "
    "informativ sind.");
  AddDetail( ({ "zweizeiler" }),
    "Du staunst ueber die Kreativitaet der Blauelfen.");
  AddDetail( ({ "kreativitaet" }),
    "Du selbst hingegen bist schon stolz drauf, dass Du Kreativitaet ueberhaupt schreiben kannst.");
  AddReadDetail( ({ "zweizeiler","verse","vers" }),//hier mal eventuell nen lustigen rein oder so
    "Du liest einen der Zweizeiler und freust Dich.");
  AddDetail( ({ "barhocker", "hocker" }),
    "Vor dem Tresen stehen einige Barhocker, sie sind aus Stroh geflochten und sehen stabil und "
    "recht bequem aus. Hinten haben sie sogar eine kleine Lehne.");
  AddDetail( ({ "lehne" }),
    "Die Lehne hilft den Gaesten, die dem guten Elfenwein zu sehr zugesprochen haben, nicht vom "
    "Hocker zu fallen.");
  AddDetail( ({ "elfenwein", "hunger", "durst" }),
    "Mit \"menue\" siehst Du, was Du hier bestellen kannst.");
  AddDetail( ({ "gaeste" }),
    "Da die Popina die einzige Bar in Poesie ist, sind alle Blauelfen und die wenigen Abenteurer, "
    "die sich hierher verirren hier Gaeste, wenn sie Hunger oder Durst haben.");
  AddDetail( ({ "abenteurer" }),
    "So wie Du aussiehst, bist Du einer.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende, oder besser: die Wand, besteht hier aus Lehm. Ueberall siehst Du Verzierungen "
    "und Bilder eingeritzt. Gleich neben dem Eingang befindet sich ein Gemaelde.");
  AddDetail( ({ "gemaelde" }),
    "Auf dem Gemaelde siehst Du Blauelfen dargestellt die singen und musizieren. Sie sehen "
    "dabei sehr gluecklich aus.");
  AddDetail( ({ "wandgestaltung" }),
    "Neben dem Eingang haengt ein huebsches Gemaelde.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus Lehm. Selbst dort hat es hin und wieder jemand geschafft etwas "
    "hineinzuritzen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus platt gestampftem Lehm.");
  AddDetail( ({ "eingang" }),
    "Durch den bist Du vermutlich hereingekommen und durch ihn kannst Du auch wieder hinaus gehen.");
  AddDetail( ({ "geschmack" }),
    "Nun, ueber Geschmack laesst sich nicht streiten.");

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise Musik.");

  AddSound( ({ "musik" }),
    "Sie scheint von draussen zu kommen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier suesslich.");

  AddSmell( ({ "" }),
    "");

/*  AddRoomMessage( 
    ({""}),30,"func");
*/
  AddCmd( ({ "sitz","sitze","setz","setze" }), "setzen" );


  AddExit( "nordwesten", "./poesie_5e" );


}

int setzen(string str)
{
	notify_fail("Worauf moechtest Du sitzen?\n");
	if(str=="auf hocker"||str=="auf barhocker")
		{
			bswrite("Du setzt Dich kurz auf den Barhocker, da das aber wenig spannend ist stehst Du gleich wieder auf.\n");
			say(TPN+" setz sich kurz auf einen Hocker und steht dann wieder auf.\n",TP);
			return 1;
			}
	return 0;
}
	
	
