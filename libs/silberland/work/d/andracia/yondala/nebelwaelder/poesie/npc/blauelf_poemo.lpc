//Poemo, der Poet
//hier bekommen Spieler ein Liebesgedicht fuer ein Pferdehaar (Piratenquest)


#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
inherit POESIE_NPC +"blauelf_std.lpc";

/*
