string liebesgedicht()
{
	if (TP->QueryQuest("Befreie Hildgunde")==1||present("liebesgedicht",TP))
		return "Ein Gedicht gab ich Euch schon,\nfuer Eurer Muehe Lohn.";
	
	return "Ihr wollt ein Gedicht?\nUmsonst bekommt Ihr es nicht."
				 "\nFuer meine Kuenste,\nerwarte ich Eure Dienste.";
	
	}
					
					
		
	
	

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Poemo, der Poet");
  SetProp(P_LONG,
    "Du siehst einen grossen, hageren Mann vor Dir. Seine spitzen Ohren, seine blaeuliche "
    "Haut und sein etwas durchscheinender Koerper zeugen klar von seiner Rasse: Poemo ist "
    "ein Blauelf, noch dazu scheint er hohen Ranges zu sein, denn er traegt edle Kleidung "
    "und die Nase sehr weit oben." );
  SetProp(P_NAME, "Poemo");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"poemo", "elf", "blauelf", "poet", "mann"}));
  create_default_npc(35);
  SetProp(P_HANDS, ({" mit poetischer Magie",QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp (P_MNPC_DEFAULTROOM, "/gilden/poesie_3c");
  
  SetProp(P_SIZE, 195);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 900);

  SetProp(P_RACE, "Blauelf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  -0.5, DT_AIR:    -0.5, 
      DT_LIGHTNING: 0.5, DT_EXPLOSION: 0.0, DT_SOUND:  -0.5, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.5, DT_ACID:      0.0, DT_POISON: -0.5, DT_TERROR: 0.0,
      DT_HOLY:      0.5, DT_UNHOLY:    0.5, DT_MAGIC:  -1 ]) );
 
  SetProp(P_NOATTACK, 0);//erstmal
  SetProp(P_NOMAGIC,50);
//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Raecht mich, meine Brueder und Schwestern, lasst " +TPN+ " nicht entkommen!");
  SetProp(P_KILL_NAME, "Poemo");
  SetProp(P_KILL_MSG, "Fahrt zu Hoelle, Elender!");

  AddInfo(DEFAULT_INFO, "sagt: Habt Ihr kein Wissen? \nPoemo sagt: Ihr scheints zu missen!\n");

  AddInfo( ({"gedicht", "liebesgedicht"}), #'liebesgedicht, "sagt: "); //#'  

  AddInfo( ({"poemo", "poet"}), 
    "So werde ich genannt\nWar Euch das nicht bekannt?",
    "fragt: "); 
  AddInfo( ({"haar"}), 
    "Ist meine Haar,\nnicht wunderbar?",
    "fragt: "); 
  AddInfo( ({"dienste", "dienst"}), 
    "Ein Pferdehaar hab ich Bariton versprochen\nund mein Wort noch nie gebrochen.\n"
    "Doch hier kann ich nicht fort\nund das Haar ist an einem entfernten Ort.\n"
    "Besorgt mir das Haar von einem Ross,\nich dichte schon mal los.",
    "sagt: "); 
  AddInfo( ({"kuenste", "kunst"}), 
    "Ich Dichte fuer mein Leben gern,\nEtwas andere zu tun liegt mir fern.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({"pferdehaar"}), 
    "Das Haar von einem Pferd,\nist so manchem vieles wert.",
    "sagt: "); 
  AddInfo( ({"hilfe"}), 
    "Nun,\nwas kann ich fuer Euch tun?",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
     
 
 // SetProp (P_REJECT, ({ REJECT_GIVE, "Bariton moechte das nicht haben.\n" }) );
    
// void NotifyGiveQuest(object pl, string key);

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");
 SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC,30);
/*
	AddSpell(7,250,
	        "Melodie wirft eine Magiekugel nach Dir.\n",
	        "Melodie wirft eine Magiekugel nach @WEM.\n",
	         ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

	AddSpell(2,650,
	         "Melodie schickt einen Sturm gegen Dich.\n",
	         "Melodie schickt einen Sturm gegen @WEN.\n",
	         ({DT_AIR}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,170,
	         "Melodie stimmt einen Kampfgesang an.\n",
	         "Melodie stimmt einen Kampfgesang an.\n",
	         ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );




*/



/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );*/
  SUID;
  CLONEME(POESIE_ARMOUR "elfentunika" );
  CLONEME(POESIE_ARMOUR "elfenseidenschuhe" );
  CLONEME(POESIE_ARMOUR "elfenguertel" );
  CLONEME(POESIE_ARMOUR "aura" );
  command("trage alles");
  
  

}

give_notify(object ob)
 {
 	if(ob->id("pferdehaar"))
 		{
 			command("sag Vielen Dank fuer das Haar vom Pferd.");
 			command ("sag Das ist wahrlich ein gutes Gedicht wert.");
		  write("Poemo ueberreicht Dir ein Pergament.\n");
			say("Poemo ueberreicht "+TPN+" ein Pergament.\n",TP);
			ob->remove();
 			CLONE("/d/andracia/yondala/wasser/pirateninsel/obj/liebesgedicht.lpc", TP);
 		}
	else
		{
			command("sag Ach, solch weltliche Sachen.");
			command ("sag Was soll ich Blauelf damit machen?");
			 write("Poemo gibt Dir "+ob->name(WEN)+" zurueck.\n");
			 say("Poemo gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
       ob->move(TP, M_GET);
      }
    }