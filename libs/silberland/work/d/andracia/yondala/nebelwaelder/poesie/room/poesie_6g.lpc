/*Verfuegbare Befehle, Melodie als Infos geben:
<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.
<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus
<kaufe> nummer oder
<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.
<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.
<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der
                  Haendler dafuer bezahlt.
<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand
                  wert waere, wenn Du ihn verkaufen wuerdest.*/

inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen Laden" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einer kleinen, runden Lehmhuette, die offensichtlich ein Laden ist. "
    "Die Waende sind mit einigen Regalen vollgestellt auf denen einige Waren lagern die hier "
    "zum Verkauf stehen. An der Suedwand steht ein kleiner Tresen." ); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetStorageRoom(POESIE_ROOM + "poesie_lager.lpc");
  AddItem( POESIE_NPC+"blauelf_melodie.lpc" , REFRESH_DESTRUCT);

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "MELODIE");
  SetProp(P_SHOPKEEPER_NAME, "Melodie");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
 
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus roetlichem Lehm. Eine Regale wurden davor platziert. Vor der "
    "Suedwand steht ein kleiner Tresen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht einfach nur aus plattgestampfter Erde.");
  AddDetail( ({ "erde" }),
    "Die Erde hier wurde plattgestampft,");
  AddDetail( ({ "decke" }),
    "Die Decke ist kuppelfoermig und besteht aus roetlichem Lehm.");
  AddDetail( ({ "lehm" }),
    "Der Lehm, aus dem die Huette besteht, ist leicht roetlich.");
  AddDetail( ({ "huette","lehmhuette" }),
    "Du befindest Dich in einer kleinen runden Lehmhuette, die aus roetlichem Lehm erbaut wurde.");
  
  AddDetail( ({ "regale" }),
    "Die Regale bestehen aus dunklem Holz. Sie sind mit allerhand Waren vollgestellt und "
    "verdecken die Waende fast vollstaendig.");
  AddDetail( ({ "holz" }),
    "Die Regale bestehen aus dunklem Holz, um welches es sich genau handelt ist Dir nicht bekannt.");
  AddDetail( ({ "waren", "verkauf" }),
    "Mit \"zeig\" siehst Du, welche der Waren zum Verkauf stehen. Sicherlich hilft Melodie Dir "
    "auch gerne weiter.");
  AddDetail( ({ "melodie" }),
    "Melodie ist wohl gerade nicht da, vielleicht kommt sie ja noch.");
  AddDetail( ({ "tresen" }),
    "Auf dem Tresen steht ein Obstkorb und eine Holzkiste.");
  AddDetail( ({ "holzkiste", "kiste" }),
    "Dort bewahrt Melodie ihre Einnahmen auf.");
  AddDetail( ({ "einnahmen" }),
    "Die sind in der Kiste, Du kannst sie nicht nehmen.");
  AddDetail( ({ "obstkorb", "korb" }),
    "In dem Obstkorb befinden sich einige Fruechte.");
  AddDetail( ({ "fruechte" }),
    "Leider sind es Dir fremde Fruechte, Du weisst nicht, ob sie geniessbar sind. Ob Du sie kosten solltest?");
  AddDetail( ({ "suedwand" }),
    "Vor der Suedwand steht ein Tresen.");
  AddDetail( ({ "laden" }),
    "Du schaust Dich um und kommst zu dem Schluss, dass Du in einem Laden stehst.");
  AddDetail( ({ "schluss" }),
    "Man muss nicht alles untersuchen, dieses Detail wird Dich nicht weiterbringen.");
  AddDetail( ({ "detail" }),
    "Dieses auch nicht.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier leicht suesslich.");

  AddSmell( ({ "fruechte" }),
    "Die Fruechte riechen leicht suesslich. Ob man eine kosten sollte?");//Funktion noch reinmachen mit random gut oder schlecht oder so



AddCmd( ({ "koste" }), "kosten" );
  AddExit( "norden", "./poesie_5g" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}


kosten(string str)
{
	int was; //Was passiert, wenn man kostet?
	notify_fail("Was moechtest Du kosten?\n");
	if(str=="frucht"||str=="fruechte")
		{
			if (!this_player()->eat_food(5)) return 1; //Wenn er satt ist
			     	
/*			if(!fruechte)//Wenn keine fruechte da sind, aber mal sehen, vielleicht lass ich auch einfach das 
				{
					write("Leider sind nur noch so wenige Fruechte da, dass Du anstandshalber doch keine nimmst.\n");
			    return 1;
			  }*/
			write("Du kostest von den Fruechten.\n");
			say(TPN+" kostet von den Fruechten.\n");
			was=random(50);
			if(was==0) 
				{
					write("Puh, das war keine gute Idee, Du fuehlst Dich krank.\n");
					TP->AddPoison(random(2)+1);
				}
			if(was==1)
				{
					write("Du fuehlst Dich ploetzlich sehr lebendig!\n");
					TP->AddHp(random(50)+20);
					TP->AddSp(random(50)+20);
				}					
			if(was==2)
				{
					write("Du fuehlst Dich ploetzlich so leer!\n");
					this_player()->eat_food(-50,0);
					TP->SetProp(P_SP,0);
				}					
			if(was==3)
				{
					write("Du fuehlst Dich ploetzlich so tot!\n");
					TP->SetProp(P_HP,1);
				}					
			else
				{
					write("Hmmm, Du fuehlst Dich gestaerkt!\n");
					TP->AddHp(random(5)+5);
					TP->AddSp(random(5)+5);
				}					
						return 1;	
			}
	return 0;
	}

