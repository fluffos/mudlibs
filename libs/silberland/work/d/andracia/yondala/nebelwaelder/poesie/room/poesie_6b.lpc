//Hier soll der Transporter (Adler) halten
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen Platz" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem kleinen Platz. Er ist mit kleinen Bueschen umsaeumt, sonst ist hier "
    "nicht viel, aber ein bisschen gespenstisch ist es schon: Um Dich herum ist dicker Nebel. "
    "Das einzige was Du sehen kannst ist ein schmaler Weg durch das Gebuesch im Nordosten. "
    "Ausserdem steht hier ein kleines Schild." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );
//anderen Raum Laden wegen transporter, fuers SL erstmal ausgeschaltet
//catch(call_other("/d/huegelland/yason/zwirbelstein/room/burg/zs_burg_dach_a2", "???"));


  AddDetail( ({ "platz" }),
    "Du stehst auf einem kleinen Platz. Er ist mit kleinen Bueschen umsaeumt, sonst ist hier "
    "nicht viel, aber ein bisschen gespenstisch ist es schon: Um Dich herum ist dicker Nebel. "
    "Das einzige was Du sehen kannst ist ein schmaler Weg durch das Gebuesch im Nordosten. "
    "Ausserdem steht hier ein kleines Schild.");
  AddDetail( ({ "buesche","busch" }),
    "Der Platz ist von kleineren Bueschen gesaeumt. Es scheint sich um Dornenbuesche zu handeln.");

  AddDetail( ({ "nordostbuesche","gebuesch", "nordosten" }),
    "Zwischen zwei Bueschen nordoestlich von Dir fuehrt ein kleiner Weg.");
 AddDetail( ({ "norden" }),
    "Du kannst nicht sehen, was hinter der Nebelwand ist. Ob Du mutig einfach blind nach Norden laufen solltest?");
  AddDetail( ({ "sicht" }),
    "Einige Zweige verwehren Dir die Sicht auf den grossen Platz. Geh doch nach Osten, wenn Du "
    "sehen willst, was dort ist, der Strauch ist sicher kein Hindernis.");
  AddDetail( ({ "weg" }),
    "Du siehst einen schmalen Weg, der von diesem Platz weg nach Nordosten fuehrt.");
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hell und dick. Du kannst absolut nicht sehen, was sich hinter den Bueschen "
    "befindet.");
  AddDetail( ({ "schild" }),
    "Ein Holzschild steckt hier im Boden. Du kannst es lesen.");
  AddDetail( ({ "holzschild" }),
    "Lies es!");
  AddReadDetail( ({ "schild","holzschild" }),
    "Willkommen in unserem Land,\n"
    "Es ist zwar klein, doch weltbekannt.\n"
    "Kommt zu uns, seid unser Gast,\n"
    "Verweilt im Dorfe ohne Hast!");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um den Platz herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "nebelwaende" }),
    "Du betrachtest die Nebelwaende eingaengig und meinst einige Schemen erkennen zu koennen.");
  AddSpecialDetail( ({ "schemen","scheme","formen","form"  }), "schemen" );
  AddDetail( ({ "gesicht","fuss","hand","arm","bein" }),
    "Du bist Dir nicht sicher, was Du in dem wabernden Nebel fuer Formen siehst.");
  AddDetail( ({ "boden" }),
    "Der Boden ist sehr sandig.");
  AddDetail( ({ "sand" }),
    "Im Sand kannst Du einige Spuren entdecken.");
  AddDetail( ({ "spuren" }),
    "Die Spuren scheinen von einem grossen Tier zu stammen.");
  AddDetail( ({ "tier" }),
    "Du glaubst, das es vermutlich ein sehr grosser Vogel sein muss, zumindest lassen die "
    "meisten Spuren darauf schliessen.");
  AddDetail( ({ "vogel", "adler" }),
    "Der ist wohl gerade nicht hier. Ob er gefaehrlich ist?");
  AddDetail( ({ "dornenbuesche" }),
    "Die Buesche haben hier sehr spitze Dornen.");
  AddDetail( ({ "dornen" }),
    "Die Dornen sehen sehr spitz aus. Du solltest besser nicht reingreifen.");
  AddDetail( ({ "dorf" }),
    "Das wird dann wohl in nordwestlicher Richtung sein, denn sonst kannst Du nirgendwo hin.");
  AddDetail( ({ "sicht" }),
    "Du kannst absolut nichts mehr sehen, besonders im Norden steht direkt vor Dir eine dichte Nebelwand.");
  AddDetail( ({ "nebelwand" }),
    "Du kannst nicht sehen, was dahinter ist. Wenn Du einfach weiter nach Norden gehst weisst Du nicht, was passiert.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hin und wieder ein Rascheln und das Pfeifen des Windes. Ansonsten ist es hier fast erdrueckend still.");

  AddSound( ({ "rascheln", "geraeusch" }),
    "Leider kannst Du nicht ausmachen, woher das Geraeusch kommt. Ob Du beobachtet wirst?");
  AddSound( ({ "pfeifen", "wind","brise" }),
    "Es ist hier nicht sonderlich windig, nur hin und wieder kommt eine leichte Brise auf.");
  AddSound( ({ "stille" }),
    "Die Stille ist ein wenig erdrueckend.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein bisschen feucht, ansonsten riecht es neutral.");

  AddSmell( ({ "luft" }),
    "Die Luft ist recht feucht.");

  AddCmd( ({ "greif", "greife", "fasse","fass" }), "greifenCmd" );

  AddExit( "nordosten", "./poesie_5c" );

  AddSpecialExit( "norden", "nord");
  
  SetProp(P_HIDE_EXITS, ({"norden"}) );

}
    int nord(string dir)
     {
       return this_player()->move("/d/andracia/yondala/wege/room/nebelweg_16", M_GO, 0,
                    "schiebt ein paar Zweige zur Seite und geht nach Norden", "kommt durch einen Strauch");
     }

string schemen()
{
	int i;
	i=random(5);
	if (i==0) return ("War da nicht grad ein Gesicht?\n");
	if (i==1) return ("War da nicht grad ein Fuss?\n");
	if (i==2) return ("War da nicht grad eine Hand?\n");
	if (i==3) return ("War da nicht grad ein Bein?\n");
	if (i==4) return ("War da nicht grad ein Arm?\n");
		
		
	}
	
	
	
greifenCmd(string str )
{
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "in dornen"||str=="in dorne"||str== "in gebuesch" )
  {
    write("Du greifst in die Dornen und piekst Dich ganz fuerchterlich.\n");
    say( TPN+" greift in Dornen und piekst sich ganz fuerchterlich.\n",TP);
		TP->do_damage(5,"Dornen");
    return 1;
  }
  return 0;
}


