#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein leichtes Hemd");
  SetProp(P_LONG,
    "Du siehst ein leichtes Hemd, welches dennoch fein gearbeitet wurde." );

  SetProp(P_NAME, "Hemd");
  SetProp(P_NAME_ADJ, "leicht");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);

  SetProp(P_QUALITY_DECAY, 100);


}
