#include "../def.h"

inherit "std/thing";

#include <properties.h>

int i;
string farbe;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

i=random(5);
if(i==0) farbe= "weisses";
if(i==1) farbe= "rotes";
if(i==2) farbe= "orangenes";
if(i==3) farbe= "blaues";
if(i==4) farbe= "gelbes";
	
	
  SetProp(P_SHORT, "Ein "+farbe+" Bluemchen");
  SetProp(P_LONG,
    "Du siehst eine kleines, "+farbe+" Bluemchen. Du koenntest es jemandem schenken, den Du gern hast.");  
  SetProp(P_NAME, "Bluemchen");
  SetProp(P_GENDER, NEUTER);
  AddId("bluemchen");

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
 
}
