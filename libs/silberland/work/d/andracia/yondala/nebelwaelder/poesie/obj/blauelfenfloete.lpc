int egrins(string str)
{
	int i;
	object *elfen;
	object elf;
	if(!str)
		{
			elfen=filter_array(users(),"check_if_blauelf");//finde alle spieler
			for(i=sizeof(elfen)-1;i>=0;i--)
				tell_object(elfen[i], "Blauelf"+elfensex()+" "+TPN+" grinst Euch aus der Ferne an.\n");
	
			write("Du grinst alle Blauelfen aus der Ferne an.\n");
		}
	else
		{
			if(elf=find_living(str))
				{
					tell_object(elf, "Blauelf"+elfensex()+" "+TPN+" grinst Dich aus der Ferne an.\n");
					write("Du grinst "+capitalize(str)+" aus der Ferne an.\n");
				}
			else
				write("Wen moechtest Du aus der Ferne angrinsen?\n");
			}
return 1;
}