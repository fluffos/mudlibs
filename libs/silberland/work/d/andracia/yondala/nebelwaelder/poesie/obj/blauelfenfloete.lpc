//das Gildenitem der Blauelfen
#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>//fuer die Vision
#include <ansi.h>//fuer die Farben
object besitzer;
nosave int lastHP, lastSP, aktiv=0, farbe=0;
//string aktStr;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
 SetProp(P_SHORT, ANSI_CYAN+"Eine kleine Floete"+ANSI_NORMAL);
  SetProp(P_LONG,
  "Dies ist Deine ganz persoenliche Floete, wie sie nur Blauelfen fuehren.\n"
  "Sie ermoeglicht es Dir, Deinen Gesundheitsstatus im Auge zu behalten und mit "
  "den anderen Blauelfen auch ueber grosse Entfernungen hinweg zu kommunizieren. \n"
  "Tippe dazu einfach <blaufloete> ein.\n"
  "Folgende Kontaktmoeglichkeiten stehen Dir derzeit zur Verfuegung:\n"
  "eknuddel, ewink, elieb, elob, efeuer, egratulier, estrahl, elach, ekicher, etroeste, edanke, "
  "egruesse, enick, ekraule, ekuschel, estubs, egrins und erufe.");
  SetProp(P_NAME, "Floete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"floete", "blauelfenfloete","\nblauelfenfloete"}) );

  SetProp(P_MATERIAL, ({MAT_BEECH, MAT_MISC_MAGIC }));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Ohne Deine Floete wuerdest Du Dich einsam fuehlen.\n");
  SetProp(P_NEVERDROP, 1);

	//SetProp(P_WORN_TEXT, "an einer Schnur um den Hals gehaengt");
  //SetProp(P_ARMOUR_TYPE, AT_MISC );
  //SetProp(P_AC, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  AddCmd( ({ "blaufloete"}), "blaufloete");
//Elfenfernverben, ja, ich bin faul, es sind die gleichen wie bei den normalen Verben
  AddCmd( ({ "eknuddel"}), "elfknuddel");
  AddCmd( ({ "ewink","ewinke"}), "elfwink");
  AddCmd( ({ "elieb"}), "elieb");
  AddCmd( ({ "elob"}), "elob"); 
  AddCmd( ({ "efeuer"}), "efeuer");
  AddCmd( ({ "egratulier"}), "egratulier");   
  AddCmd( ({ "estrahl", "estrahle"}), "estrahl");
  AddCmd( ({ "elach", "elache"}), "elach");
  AddCmd( ({ "ekicher"}), "ekicher");   
  AddCmd( ({ "etroeste"}), "etroeste");   
  AddCmd( ({ "edanke"}), "edanke");
  AddCmd( ({ "egruesse"}), "egruesse");   
  AddCmd( ({ "enick"}), "enick");
  AddCmd( ({ "ekraule"}), "ekraule");
  AddCmd( ({ "ekuschel"}), "ekuschel");   
  AddCmd( ({ "estubs"}), "estubs");
  AddCmd( ({ "egrins"}), "egrins");
  AddCmd( ({ "erufe"}), "erufe");
//  AddCmd( ({ "ehist"}), "ehist");
//Warum weiss ich noch nicht:
  lastHP = lastSP = -1;

}
string extra_look()
{
		return capitalize(environment()->QueryPronoun())+
    " traegt die Floete der Blauelfen an einer Schnur um den Hals.\n";
}

int blaufloete(string str)
{
	notify_fail("blaufloete ein|aus|farbe\n");
	besitzer=environment();
	if(str=="ein")
		{
			aktiv=1;
			farbe=0;
			write("Die Floete ist nun aktiviert.\n");
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
			return 1;
		}
	if(str=="aus")
		{
			aktiv=0;
			write("Die Floete ist nun ausgeschaltet.\n");
			besitzer->RemoveHpHook(ME);
			return 1;
		}	
	if(str=="farbe")
		{
			aktiv=1;
			farbe=1;
			write("Die Floete ist nun farbig eingeschaltet.\n");
			besitzer->AddHpHook(ME);
			return 1;
		}	
	}


NotifyHpChange()
{
	  int    hp, mhp, sp, msp;
	  if(!aktiv) return;

  // Sicherheits-Check
  if (!previous_object() || !besitzer || (besitzer != previous_object()))
    return;
if(besitzer!=environment()) return;

  // Test auf Geist
  if (besitzer->QueryProp(P_GHOST)) return;

  // aktuelle Werte ermitteln
  hp = besitzer->QueryProp(P_HP);
  mhp = besitzer->QueryProp(P_MAX_HP);
  sp = besitzer->QueryProp(P_SP);
  msp = besitzer->QueryProp(P_MAX_SP);


  // Test auf Tod vorher <=0, aber mit 0 lebt man ja noch
  if ((hp<0) || (!living(besitzer)))
  {
    tell_object(besitzer, "Deine Floete zerfaellt.\n");
    TO-remove();
  }

//  if ((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP))
//    write("Lebenspunkte: "+hp+"/"+mhp+" - Magiepunkte: "+sp+"/"+msp+".\n");

//*LP:x von y**MP: x von y **vergiftet**taub**blind**vision**frosch**aktiv**



//Lebensmagie: ***/***| PAUSE VISION GIFT TAUB BLIND FROSCH 
if(!farbe)
	{
		//tell_object(besitzer,"**");
		tell_object(besitzer,"Lebensmagie: "+hp+"/"+mhp+"| ");
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,"..... ");
    else tell_object(besitzer,"PAUSE ");
    if(besitzer->is_class_member(CL_NIGHTVISION)) tell_object(besitzer,"VISION ");
    else tell_object(besitzer,"...... ");
    if(besitzer->QueryProp(P_POISON)) tell_object(besitzer,"GIFT ");
    else tell_object(besitzer,".... ");
    if(besitzer->QueryProp(P_DEAF)) tell_object(besitzer,"TAUB ");
    else tell_object(besitzer,".... ");
    if(besitzer->QueryProp(P_BLIND)) tell_object(besitzer,"BLIND ");
    else tell_object(besitzer,"..... ");

    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,"FROSCH\n");
    else tell_object(besitzer,"..... \n");
    }

else//in Farbe
	{ //Farbe fuer Lebenspunkte
		if(hp*100/mhp<21)	tell_object(besitzer,ANSI_RED+"LEBENSMAGIE: "+hp+"/"+mhp+ANSI_NORMAL);
		else if(hp*100/mhp<41)	tell_object(besitzer,ANSI_PURPLE+"LEBENSMAGIE: "+hp+"/"+mhp+ANSI_NORMAL);
		else if(hp*100/mhp<61)	tell_object(besitzer,ANSI_BLUE+"LEBENSMAGIE: "+hp+"/"+mhp+ANSI_NORMAL);
		else if(hp*100/mhp<81)	tell_object(besitzer,ANSI_YELLOW+"LEBENSMAGIE: "+hp+"/"+mhp+ANSI_NORMAL);
		else tell_object(besitzer,ANSI_CYAN+"LEBENSMAGIE: "+hp+"/"+mhp+ANSI_NORMAL);

    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,ANSI_CYAN+"..... "+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_RED+"PAUSE "+ANSI_NORMAL);
    if(besitzer->is_class_member(CL_NIGHTVISION)) tell_object(besitzer,ANSI_WHITE+"VISION "+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_CYAN+"...... "+ANSI_NORMAL);
    if(besitzer->QueryProp(P_POISON)) tell_object(besitzer,ANSI_RED+"GIFT "+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_CYAN+".... "+ANSI_NORMAL);
    if(besitzer->QueryProp(P_DEAF)) tell_object(besitzer,ANSI_RED+"TAUB "+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_CYAN+".... "+ANSI_NORMAL);
    if(besitzer->QueryProp(P_BLIND)) tell_object(besitzer,ANSI_RED+"BLIND "+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_CYAN+"..... "+ANSI_NORMAL);
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,ANSI_GREEN+"FROSCH\n"+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_CYAN+"..... \n"+ANSI_NORMAL);


}
  // neue Werte merken
  lastHP = hp; 
  lastSP = sp;

}

string elfensex()//ermittelt das Geschlecht des Spielers und gibt bei weiblich ein "in" zurueck
{
	string elfensex;
	elfensex="";
	
	if(TP->QueryProp(P_GENDER)==FEMALE) elfensex="in";
	return elfensex;
	}
 

int check_if_blauelf(object spieler)
{  
	if (spieler!=TP)
		if (spieler->QueryProp(P_RACE)=="Blauelf") return 1;
	else return 0;
	}

int erufe(string aktStr)
{
  int i;
	object *elfen;
	object elf;

	notify_fail("Was moechtest Du den anderen Blauelfen mitteilen?\n");
	aktStr = this_player()->_unparsed_args();	// verhindert das die mudlib den Text parsed
	if (!aktStr) return 0;
	
	call_other("/d/tal/yondala/aboriville/obj/zweigmaster.lpc","jemandruft", aktStr, TP);//soll spaeter in den Gildenraum

	elfen=filter_array(users(),"check_if_blauelf");//finde alle blauelfenspieler

			for(i=sizeof(elfen)-1;i>=0;i--)
				tell_object(elfen[i],"Blauelf"+elfensex()+" "+TPN+" ruft Euch zu: "+aktStr+"\n");

			write("Du rufst den Blauelfen zu: "+aktStr+"\n");
	 
 	 return 1;

	}



int elfknuddel(string str)
{
	int i;
	object *elfen;
	object elf;
	if(!str)
		{
			elfen=filter_array(users(),"check_if_blauelf");//finde alle spieler
			for(i=sizeof(elfen)-1;i>=0;i--)
				tell_object(elfen[i],"Blauelf"+elfensex()+" "+TPN+" knuddelt Euch aus der Ferne.\n");
			write("Du knuddelst alle Blauelfen aus der Ferne.\n");
		}
	else
		{
			if(elf=find_living(str))
				{
					tell_object(elf, "Blauelf"+elfensex()+" "+TPN+" knuddelt Dich aus der Ferne.\n");
					write("Du knuddelst "+capitalize(str)+" aus der Ferne.\n");
				}
			else
				write("Wen moechtest Du aus der Ferne knuddeln?\n");
			}
 	 
 	 return 1;

}

