//einer von vier Raeumen des grossen Platzes

#include "../def.h"

inherit "std/room";

#include <properties.h>
int stein;

void reset()
{
	stein=1;
	::reset();
	}
void create() 
{
  ::create();
stein =1;
  SetProp( P_INT_SHORT, "Auf einem grossen Platz" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem grossen Platz, welcher durch Buesche und dahinter durch einen dichten, "
    "weissen Nebel begrenzt ist. Der Boden ist eben und sandig, in der Naehe siehst Du einige "
    "helle, runde Lehmhuetten. Im Nordosten scheint eine besondere zu sein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );
  AddDetail( ({ "platz" }),
    "Du stehst auf einem grossen Platz. Der Boden ist eben und sandig, rundherum wird der Platz "
    "von Straeuchern umrandet die hin und wieder durch eine Lehmhuette unterbrochen werden. "
    "Hinter den Straeucher steht eine dicke, undurchdringliche Nebelwand.");
  AddDetail( ({ "strauch", "busch" }),
    "Hier ist kein besonderer Busch, alle Buesche sehen gleich aus.");
  AddDetail( ({ "buesche", "gebuesch", "straeucher" }),
    "Der Platz ist von kleineren Bueschen gesaeumt. Es scheint sich um Dornenbuesche zu handeln.");
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hell und dick. Du kannst absolut nicht sehen, was sich hinter den Bueschen "
    "befindet.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und blau, allerdings ist nur ein kleiner Ausschnitt zu sehen.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst nur einen kleinen Ausschnitt, weil rund um den Platz herum dichte Nebelwaende "
    "in den Himmel ragen.");
  AddDetail( ({ "nebelwaende", "nebelwand" }),
    "Du betrachtest die Nebelwaende eingaengig und meinst einige Schemen erkennen zu koennen.");
  AddSpecialDetail( ({ "schemen","scheme","formen","form"  }), "schemen" );
  AddDetail( ({ "gesicht","fuss","hand","arm","bein" }),
    "Du bist Dir nicht sicher, was Du in dem wabernden Nebel fuer Formen siehst.");
  AddDetail( ({ "boden" }),
    "Der Boden ist sehr sandig. Ein paar Steinchen liegen herum.");
  AddDetail( ({ "sand" }),
    "Im Sand kannst Du einige Spuren entdecken.");
  AddDetail( ({ "spuren" }),
    "Die Spuren bedecken den ganzen Platz, hier scheinen oft Leute herumzulaufen.");
  AddDetail( ({ "dornenbuesche", "dornenbuesche", "dornenbusch","dornengebuesch" }),
    "Die Buesche haben hier sehr spitze Dornen.");
  AddDetail( ({ "dornen" }),
    "Die Dornen sehen sehr spitz aus. Du solltest besser nicht reingreifen.");
 AddDetail( ({ "leute" }),
    "Leute wie Du zum Beispiel.");
  AddDetail( ({ "beispiel" }),
    "Oder irgendwer sonst.");
  AddDetail( ({ "lehmhuetten" }),
    "Du kannst rund um den Platz einige Lehmhuetten sehen. Sie sind unterschiedlich gross, aber "
    "alle sehr rund und hell. Die Waende sind jeweils makellos.");
  AddDetail( ({ "makel" }),
    "Was mag \"makellos\" wohl bedeuten, hm?");
  AddDetail( ({ "waende" }),
    "An den Waenden siehst Du keinerlei Bearbeitungsspuren.");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Keine da, wie gesagt.");
  AddDetail( ({ "lehmhuette" }),
    "Um den Platz herum stehen ein paar Lehmhuetten. Im Nordwesten kannst Du eine besonders "
    "grosse betreten.");
  AddDetail( ({ "lehmhuette", "nordosten" }),
    "Im Nordosten steht eine Lehmhuette, die irgendwie anders aussieht als die anderen, warum "
    "kannst Du aber nicht genau sagen.");

  AddDetail( ({ "naehe" }),
    "Ganz in Deiner Naehe befinden sich einige Lehmhuetten.");
  AddDetail( ({ "steinchen" }),
    "Wenn Du eines brauchst koenntest Du eins nehmen, wenn es lose ist.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hin und wieder ein Rascheln und das Pfeifen des Windes. Ansonsten ist es hier fast erdrueckend still.");

  AddSound( ({ "rascheln", "geraeusch" }),
    "Leider kannst Du nicht ausmachen, woher das Geraeusch kommt. Ob Du beobachtet wirst?");
  AddSound( ({ "pfeifen", "wind","brise" }),
    "Es ist hier nicht sonderlich windig, nur hin und wieder kommt eine leichte Brise auf.");
  AddSound( ({ "stille" }),
    "Die Stille ist ein wenig erdrueckend.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein bisschen feucht, ansonsten riecht es neutral.");

  AddSmell( ({ "luft" }),
    "Die Luft ist recht feucht.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

 // AddCmd( ({ "tue" }), "command" );

  AddExit( "nordosten", "./poesie_3f" );
  AddExit( "sueden", "./poesie_5e" );
  AddExit( "westen", "./poesie_4d" );
  AddExit( "suedwesten", "./poesie_5d" );
  AddCmd( ({ "greif", "greife", "fasse","fass" }), "greifenCmd" );
 AddCmd( ({ "nimm", "nehm", "nehme"}), "nehmen" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}


string schemen()
{
	int i;
	i=random(5);
	if (i==0) return ("War da nicht grad ein Gesicht?\n");
	if (i==1) return ("War da nicht grad ein Fuss?\n");
	if (i==2) return ("War da nicht grad eine Hand?\n");
	if (i==3) return ("War da nicht grad ein Bein?\n");
	if (i==4) return ("War da nicht grad ein Arm?\n");
}
int greifenCmd(string str )
{
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "in dornen"||str=="in dorne"||str== "in gebuesch" )
  {
    write("Du greifst in die Dornen und piekst Dich ganz fuerchterlich.\n");
    say( TPN+" greift in Dornen und piekst sich ganz fuerchterlich.\n",TP);
		TP->do_damage(5,"Dornen");
    return 1;
  }
  return 0;
}

int nehmen(string str)
{
	notify_fail("Was moechtest Du nehmen?\n");
	if(str=="steinchen"||str=="stein")
		{
			if (stein)
				{
					write("Du bueckst Dich und nimmst ein kleines Steinchen.\n");
					say(TPN+" bueckt sich und nimmt ein kleines Steinchen.\n",TP);
					CLONE(POESIE_OBJ + "stein.lpc", TP);
					stein--;
					return 1;
				}
			else
				{
					write("Leider kannst Du kein loses Steinchen mehr entdecken.\n");
					return 1;
				}
		}
	return 0;
	
}