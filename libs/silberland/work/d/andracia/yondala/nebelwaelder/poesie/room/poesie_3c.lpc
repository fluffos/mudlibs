int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	
	daten= read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}

handabdruck(string str)
{
	notify_fail("Was moechtest Du worein druecken?\n");
	if(str!="hand in lehm"&&str!="hand in wand"&&str!="hand in lehmwand") return 0;

	if(testobgemacht(TPN)) 
	{
		write("Du hast doch schon mal einen Handabdruck hinterlassen.\n");
		return 1;
	}
	
	write("Du presst Deine Hand fest in die Lehmwand und betrachtest den Abdruck, den Du "
	      "hinterlassen hast.\nDu bist mit Deinem Werk zufrieden.\n");
	say(TPN+" drueckt "+this_player()->QueryPossPronoun(FEMALE, WEN, SINGULAR)+" Hand in den Lehm.\n",TP);
	
	write_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc", TPN+"\n");
	
	return 1;
	}
 
	
	
	
	

