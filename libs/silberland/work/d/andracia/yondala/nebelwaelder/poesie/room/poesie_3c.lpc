//mixed _query_autoloadobj(){return abdruecke;}
//void _set_autoloadobj(mixed data){abdruecke=data;}
string abdruecke()
{
	string alle;
	string eins;
	string *ganzalle;
	string trenner;
	int i;
	
	eins="";
	alle="Du siehst die Handabdruecke von ";
	alle+= read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc", 1,1);
	//i=strlen(alle)-2;
	alle=alle[0..strlen(alle)-2];
	for(i=2;i<100;i++)
	{
		eins= read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc", i, 1);
		if (!eins) break;
		
		if(read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc", i+2, 1)) 
		{
			alle+= ", " + eins[0..strlen(eins)-2];
		}
		else if (read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc", i+1, 1)) 
		{
			alle+= " und " + eins[0..strlen(eins)-2];
		}
		
		//alle+= ", " + eins[0..strlen(eins)-2];
		eins="";
	}
	//alle="Du siehst die Handabdruecke von " + read_file(POESIE_ROOM+"poesie_3c_abdruecke.lpc");
	
	alle+=".\n";
	return alle;
}
