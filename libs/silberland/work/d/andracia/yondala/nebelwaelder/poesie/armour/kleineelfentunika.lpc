#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Tunika");
  SetProp(P_LONG,
    "Du siehst eine kleine, weisse Tunika, die sehr fein gearbeitet ist "
    "und aus edlen Stoffen besteht." );

  SetProp(P_NAME, "Tunika");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tunika", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);

  SetProp(P_QUALITY_DECAY, 100);

SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 151]) );

}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
