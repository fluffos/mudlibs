#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine leichte Hose");
  SetProp(P_LONG,
    "Du siehst eine leichte Hose, die scheinbar von geschickten Haenden gefertigt wurde." );

  SetProp(P_NAME, "Hose");
  SetProp(P_NAME_ADJ, "leicht");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);

  SetProp(P_QUALITY_DECAY, 100);


}
