inherit "std/thing";

#include "properties.h"
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties
  SetProp( P_SHORT, "Kurzbeschreibung");
  SetProp( P_LONG, "Langbeschreibung" );
  SetProp( P_INFO, "Geheiminformationen");
  SetProp( P_NAME, "Name");
  SetProp( P_NAME_ADJ, "adjektiv");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, Material ); //MAT_<>
  SetProp( P_WEIGHT, 0); //in g
  SetProp( P_VALUE, 0); //Wert in Muenzen
  SetProp( P_NOGET, "kann nicht genommen werden");
  SetProp( P_NOBUY, "wird nach dem verkaufen zerstoert");
  SetProp( P_NOSELL, "kann nicht verkauft werden");
  SetProp( P_NODROP, "kann nicht weggeworfen werden");
  SetProp( P_NEVERDROP, "wird nach dam Tod behalten");
  SetProp( P_READ_DETAIL, "kann gelesen werden");
  SetProp( P_READ_MSG, "beim lesen");
  AddId( "Bezeichner", "bezeichner");

  /*Aktivierung Interaktion*/
  AddCmd( ({"verb", "verben"}), "funktion");
}

/*Deklaration Interaktion*/
int funktion(string str) 
{
  notify_fail("Fehlermeldung");
  if( str != "ziel" && str != "ziel" )
      return 0;
  write("Interaktion!");
  say(capitalize(this_player()->name())+ " interagiert");
  return 1;
}