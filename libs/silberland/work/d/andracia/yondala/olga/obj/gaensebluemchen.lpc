inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Gaensebluemchen");
  SetProp( P_LONG, "Du haelst ein kleines Gaensebluemchen in den Haenden. Es ist leuchtend gelb und strahlend weiss und fast perfekt symmetrisch." );
  
  SetProp( P_NAME, "Gaensebluemchen");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_MISC_HERBAL ); //MAT_<>
  SetProp( P_WEIGHT, 8); //in g
  SetProp( P_VALUE, 1); //Wert in Muenzen
  AddId( ({"gaensebluemchen", "blume", "bluemchen"}) );

  SetProp(P_SMELL, BS("Diese Blume duftet herrlich.") );
}

