
#include "../def.h"

inherit "std/thing";

#include <properties.h>

#define HERSTELLKOSTEN 5000
#define ANALYSEKOSTEN 1000
#define ANZGEMS 5

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Broschuere");
  SetProp(P_LONG,
    "Du siehst ein gefaltetes Pergament auf dem einiges geschrieben steht. Es handelt sich um "+
    "Geschaeftsbedingungen, Preise und notwendige Resourcen die man beisteuern muss zur Zauberstabherstellung." );
  SetProp(P_NAME, "Broschuere");
  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, FEMALE);
  AddId(({"broschuere", "zettel", "\nzzbroschuere"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
  AddReadDetail( ({ "broschuere", "zettel" }),
    "Hinweise zur Zauberstabherstellung von Olga.\n"+
    BS("Bitte beachten Sie dass jeder Zauberstab eine Einzelanfertigung ist und auch nur der Qualitaet entspricht der "+
    "beigesteuerten Rohstoffe. ")+
    BS("Zur Herstellung eines Zauberstabs benoetigt Ihr zualleresrt ein geeignetes Stueck Holz. Nicht jeder Holzstock ist "+
    "als Zuberstab geeignet. Ebenfalls kann es sein, dass euer Holzstueck nicht euren gewuenschten Zauber aufnehmen kann. "+
    "Wichtig ist hierbei dass ihr jedes geeignete Holzstueck von mir untersuchen lasst. Dieser Service kostet euch "+
    ANALYSEKOSTEN+" Muenzen.")+
    BS("Fuer jeden Zauber, der auf dem Stab eingepraegt werden soll, benoetige ich zusaetzlich "+ANZGEMS+" Edelsteine der entsprechenden "+
    "Sorte. Eine Liste findet ihr auf der Rueckseite dieser Broschuere. Die allgemeinen Zauber lumini, meditat, analys und teleportiere "+ //, praesenz
    "werden immer miteingepraegt." )+
    BS("Sobald Ihr Euch fuer eine Kombination aus Zaubern entschieden habt und mit dem entsprechenden Stueck Holz bereit seid, "+
    "so koennt ihr nach einer Bezahlung von "+HERSTELLKOSTEN+" Muenzen und einer gewissen Wartezeit euren Zauberstab abholen.") );    
 
  AddReadDetail( ({ "rueckseite", "liste" }),
    "Folgende Edelsteine koennen zum verzaubern von Zauberstaeben verwendet werden:\n"+
    "Rubin: Feuerelementar\n"+
    "Aquamarin: Wasserelementar\n"+
    "Topas: Flammenzunge\n"+
    "Smaragd: Seelengift\n"+
    "Saphir: Eiselementar\n"+
    "Opal: Erzelementar\n"+
    "Lapislazuli: Schwaechezauber\n"+
    "Onyx: Resistenz\n"+
    "Bernstein: Balsam\n"+
    "Granat: Feuerball\n"+
    "Bergkristall: Piorun\n"+  
    "Diamant: Froststrahl\n"+
    "Amethyst: Windeseile\n"+             
    "Zirkon: Wasserhose\n"+
    "Turmalin: Praesenz\n"+
    "Tigerauge: Eispfeil\n");
}
