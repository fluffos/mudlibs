inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

#define HERSTELLKOSTEN 25000
#define ANALYSEKOSTEN 1250
#define ANZGEMS 20


void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
  create_default_npc(35); //erstellt Standartwerte für NPC des Level x
  //Properties

  AddId(({"olga", "zauberstabmacherin", "Olga, die Zauberstabmacherin"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Olga, die Zauberstabmacherin");
  SetProp( P_LONG, BS("Diese aeltere Zaubererin hat sich hier in Ihrem Turm auf das "+
    "Herstellen von Zauberstaeben spezialisiert. Nur sehr selten schafft es ein Zauberer "+
    "die Kunst des Zauberstabmachens zu erlernen. Seit mehr als einem Jahrhundert ist "+
    "sie die einzige in Andracia, die diese Kunst beherrscht.") );
  SetProp( P_NAME, "Olga, die Zauberstabmacherin");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_ARTICLE, 0); // Wenn kein Artikel ausgegeben werden soll.
  SetProp( P_HANDS, ({" mit ihren blossen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 169); //in cm
  SetProp( P_WEIGHT, 64800); //in g
  SetProp( P_ALIGN, -150); //Gesinnung von -1000 bis +1000
  SetProp( P_MAX_HANDS, 2); //Anzahl Haende
  SetProp( P_AGGRESSIVE, 0); //Aggressionsverhalten
  SetProp( P_RESISTANCE_STRENGTHS ,  //Widerstand gegen Schadentypen -1 (immun) bis +1 (doppelt)
    ([DT_FIRE:     -0.5, DT_COLD:     -0.5, DT_WATER: -0.5, DT_LIGHTNING: 1.0, DT_SOUND:  1.0, 
      DT_LIGHT:  1.0, DT_ELECTRIC:  1.0, DT_TERROR: -0.5, DT_HOLY:    -0.5, DT_UNHOLY:  -0.5]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_AREA, (ROOM+"") ); // Bereichsangabe für Bewegung
  //SetProp( P_MNPC_WAIT, ({ 10, 30, 30 })); //Bewegungsintervalle
  SetProp( P_MNPC_DEFAULTROOM, ROOM+""); // Startpunkt
  //SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmöglichkeiten
  SetProp( P_DIE_MSG,  " hat ihren letzten Atemzug getan.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Olga, die Zauberstabmacherin"); //string für Todessequenz
  SetProp( P_KILL_MSG, "HIHI - ich habe %s getoetet!");
  SetProp( P_LOG_INFO, "missing_answers"); //Logfile für unbeantwortete Fragen

  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Antworten
  AddInfo( DEFAULT_INFO, "versteht Dich nicht.");
  AddInfo( "tooser", "tooser hat mich erschaffen.","sagt: ");
  //AddInfo( ({"",""}), "Hier ist die Information.","sagt: ");
  AddInfo( ({"zauberstab","zauberstaebe"}), 
    "Ich kann Euch einen Zauberstab herstellen, aber dazu benoetige ich je nach dem was Euer "+
    "Zauberstab koennen soll, jeweils "+ANZGEMS+" Edelsteine der passenden Sorte. Auch benoetigt ihr einen "+
    "geeigneten Holzstock, der zum Zauberstab verwandelt werden soll. Auch soll mein Dienst"+
    "mit "+HERSTELLKOSTEN+" Muenzen bezahlt sein. ","sagt: ");
  AddInfo( ({"stock", "holzstock"}), 
    "Nicht jeder Holzstock ist dazu geeignet in einen Zauberstab verwandelt zu werden. Ihr koennt "+
    "mir einen Holzstock geben und ich kann Euch dann mitteilen in wiefern der Stock geeignet ist. "+
    "Diesen Dienst biete ich Euch fuer "+ANALYSEKOSTEN+" Muenzen an.","sagt: ");
  AddInfo( ({"dienst","dienste"}),
    "Als Zauberstabmacherin kann ich Euch folgende Dienste anbieten: "
    "Gebt mir einen Stock so kann ich euch fuer "+ANALYSEKOSTEN+" Muenzen sagen in wiefern "+
    "er für die Zauberstabherstellung geignet ist. "+
    "Zur Herstellung eines Zauberstabs muesst ihr neben "+HERSTELLKOSTEN+" Muenzen auch "+
    "je nach Zauberspruechen "+ANZGEMS+" Edelsteine aufwenden.", "sagt: ");
  AddInfo( ({"herstellung","zauberstabherstellung"}), 
    "Ihr muesst mir einfach einen geeigneten Holzstock geben, dann koennen wir darueber reden, "+
    "was ich daraus fuer Euch herstellen soll.","sagt: ");

  /*Zaubersprüche
  SetProp( P_SPELLRATE, rate);
  AddSpell( rate, schaden, "Opferchat.", "Raumchat.", DamageType, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(rate, schaden, SpellTyp, "Opferchat.", "Raumchat.", spezial)
 
  //Chats
  SetChats( rate, ({"Info", "info"}) ); //rate in %
  SetAttackChats( rate, ({"info", "info"}) ); // rate in%


  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausführenden Commands
  CLONEME( "Pfad/datei" );
  command("zuecke waffe");
  CLONEME( "Pfad/datei" );
  command("trage alles");
  */
}

void notify_give(object ob)
{
  if( !ob->id("/nrohstab") )
  {
    tell_room(environment(TO), break_string(TP->name()->", aus "+ob->name()+" kann man keinen Zauberstab herstellen. ",TO->name()+" sagt: ") );
    return;
  }
  tell_room(environment(TO), break_string(TP->name()->", soll ich "+ob->name()+" untersuchen oder einen Zauberstab daraus erzeugen? ",TO->name()+" sagt: ") );
  input_to("question_1");
  return;
}

void question_1(string str)
{
  if( !str ) 
  {
    tell_room(environment(TO), break_string(TP->name()->", aus "+ob->name()+" kann man keinen Zauberstab herstellen. ",TO->name()+" sagt: ") );
    return;
  }
}
// Reactions
 (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
