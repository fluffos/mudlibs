#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_weg_c3"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_weg_d4"
int blumeda;

void reset()
{
	::reset();
	blumeda=2;
}
void create() 
{
  ::create();
 blumeda=2;
  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
     BS("Der Trampelpfad fuehrt hier ueber eine kleine Lichtung. Im Westen begrenzt eine "+
     "undurchdringliches Dornengeflecht den Rand der Lichtung. Ein kleiner freigeschnittener Pfad "+
     "fuehrt mitten hinein ins Dornendickicht. Ansonsten ist diese Lichtung von hohen Baeumen umgeben "+
     "und der Pfad fuehrt hier nach Sueden in den Wald hinen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst hin und wieder ein paar Voegel zwitschern hoeren."));
  AddSound( ({ "voegel", "zwitschern" }),
    BS("In den umliegenden Baeumen muessen wohl viele Voegel leben, denn man hoert ihr zwitschern."));
  AddSmell( DEFAULT_SMELL,
    BS("Du riechst den angenehmen Duft von Gras und Blumen."));
  AddSmell( ({"gras"}),
    BS("Das Gras hat seinen eigenen herben Duft. Aber der Duft der Blumen mildert das Aroma."));
  AddSmell( ({"blumen", "duft", "aroma"}),
    BS("Die Luft ist erfuellt vom lieblichen Duft von Gaensebluemchen. Ihre weissen Blueten "+
    "verstroemen ein angenehmes Aroma."));

  AddDetail( ({ "boden" }),
    BS("Der Boden der Lichtung wird von gruenem Gras bedeckt. Ein paar Gaensebluemchen bluhen "+
    "hier und lassen diese Lichtung sehr idyllisch wirken."));
  AddDetail( ({ "himmel" }),
    BS("Der Himmel ist tiefbau und keine einzige Wolke zeigt sich soweit Du aus dieser Lichtung "+
    "heraus erkennen kannst."));
  AddDetail( ({ "pfad", "trampelpfad", "weg" }),
    BS("Der Trampelpfad fuehrt hier von Sueden ueber die Lichtung mitten hinein in das "+
    "Dickicht, das hier die Lichtung nach Westen begrenzt."));
  AddDetail( ({ "lichtung", "idylle" }),
    BS("Diese kleine Lichtung ist sehr idyllisch. Der Boden ist mit saftig gruenem Gras bedeckt. "+
    "Zu allen Seiten stehen hohe Baeume und lassen daher grosse Teile der Lichtung im Schatten "+
    "liegen. Im Westen fuehrt der Trampelpfad in eine Schneise im Dornengestruepp. "));
  AddDetail( ({ "westen", "dornengeflecht", "dornengestruepp", "geflecht", "gestruepp", "barriere", "begrenzung",
  	            "dickicht", "dornendickicht" }),
    BS("Ein dichtes Dornengestruepp bildet im Westen eine natuerliche Pflanzenmauer. "+
    "Der Trampelpfad fuehrt in einer Schneise mitten hindurch. "));
  AddDetail( ({ "baum", "baeume", "wald" }),
    BS("Rings um die Lichtung stehen hohe Baeume. Im Westen bildet ein undurchdringliches "+
    "Dornengestruepp die Begrenzung der Lichtung. Nur ein kleiner Trampelpfad durchschneidet "+
    "diese Barriere." ));
  AddDetail( ({ "sueden", "loch" }),
    BS("Im Sueden fuehrt ein kleiner Pfad wieder in den Wald hinein. Es ist dort etwas unheimlich, denn "+
    "die hohen Baeume dort stehen so dicht dass der Pfad wie ein dunkles Loch erscheint. "));
  AddDetail( ({ "gras" }),
    BS("Das gruene, saftige Gras, das hier auf der Lichtung den Boden bedeckt, ist nur so hoch wie die "+
    "Knie eines ausgewachsenen Menschen. Ein paar Gaensebluemchen wachsen hier und sorgen fuer einen "+
    "angenehmen Duft in der Luft."));
  AddDetail( ({ "gaensebluemchen", "bluemchen", "blumen", "blume", "blueten" }),
    BS("Die Gaensebluemchen strecken ihre weissen Blueten der Sonne entgegen und verstroehmen einen "+
    "angenehmen Duft. Vielleicht kannst Du ja welche pfluecken."));
  AddDetail( ({ "wolke", "wolken", "wetter" }),
    BS("Nur wenige Wolken zeigen sich am Himmel. Die Sonne scheint und das Wetter wird wohl den ganzen "+
    "Tag noch so schoen sein."));
  AddDetail( ({ "seiten", "seite", "rand" }),
    BS("Die Lichtung wird nach Westen hin von einem dichten Dornengestruepp begrenzt, nur ein kleiner "+
    "Trampelpfad fuenrt dort mitten hinein. Zu allen anderen Seiten steht dichter Wald. Nach Sueden "+
    "fuehrt ein weiterer Trampelpfad mitten hinein in die dunkleren bereiche des Waldes."));
  AddDetail( ({ "teile", "schatten", "bereiche", "dunkel" }),
    BS("Einige Bereiche der Lichtung werden von den ringsum stehenden, hohen Baeumen in Schatten getaucht. "+
    "Im Sueden fuehrt ein kleiner Weg tiefer in das Dunkel des großen Waldes."));
  AddDetail( ({ "schneise" }),
    BS("Wie eine Schneise teilt der nach Westen fuehrende Pfad das Dornengestruepp. Man kann erkennen dass "+
    "eine pflegende Hand den Weg davor bewahrt ueberwuchert zu werden."));
  AddDetail( ({ "pflanzenmauer", "mauer", "pflanzen" }),
    BS("Das Dornengestruepp bildet eine undurchdringliche Mauer. Nicht einmal eine Maus koennte unbeschadet "+
    "hier hinein. Zum Glueck wurde der Weg freigeschnitten und wie eine Schneise teilt dieser das Gestruepp."));
  AddDetail( ({ "hand", "knie", "koerper", "haut" }),
    BS("Du untersuchst deinen Koerper aber du kommst nicht zu neuen Erkenntnissen."));
  AddDetail( ({ "luft" }),
    BS("Die Luft ist erfuellt vom lieblichen Duft der Gaensebluemchen."));
  AddDetail( ({ "erkenntnis", "glueck" }),
    BS("Vielleicht hilft ja eine Meditation."));
  AddDetail( ({ "meditation" }),
    BS("Hier kann man bestimmt gut meditieren."));
  AddDetail( ({ "erkenntnisse", "erkenntnis", "erkennen", "erkentnissen" }),
    BS("Tja - was dir da so alles einfaellt ..."));
  AddDetail( ({ "maus" }),
    BS("Das Dornengestruepp ist so dicht, nicht einmal eine Maus kaeme da hindurch. Eine Maus "+
    "selbst siehst Du hier aber nicht."));
  AddDetail( ({ "sonne", "sonnenstrahlen", "strahlen", "tag" }),
    BS("Es ist hell und du kannst die warmen Sonnenstrahlen auf deiner Haut spueren."));

  /*
  Menschen
  AddDetail( ({ "" }),
    BS(""));
  */

  AddCmd(({"tritt", "trete"}), "cmd_treten");
  AddCmd(({"pflueck", "pfluecke"}), "cmd_pfluecken");
  AddCmd(({"meditiere"}), "cmd_meditieren");
  
  AddExit( "westen", AUSGANG1 );
  AddExit( "sueden", AUSGANG2 );

}

int cmd_treten(string str)
{
	// auf ast treten erzeugt Knacken in den Nachbar-Raeumen
  if( str!="auf ast" && str!="auf aeste" && str!="ast" && str!="aeste" ) return 0;
  if( !random(10) )
  {
    write("Du trittst auf einen Ast, aber er bricht nicht.\n");
    say(TP->name()+" tritt auf einen Ast.\n");
    return 1;
  }
  write( BS("Du trittst auf einen Ast, er bricht und das laute Knacken unterbricht die Ruhe und hallt durch den Wald.") );
  say( BS(TP->name()+" tritt auf einen Ast und ein lautes Knacken hallt durch den Wald.") );
  call_other(AUSGANG1, "???", 0);
  tell_room( AUSGANG1, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  call_other(AUSGANG2, "???", 0);
  tell_room( AUSGANG2, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  return 1;
}

int cmd_pfluecken(string str)
{
	// man soll hier gaensebluemchen pfluecken koennen
  if( str!="bluemchen" && str!="blume" && str!="gaensebluemchen" && str!="gaenseblume" ) return 0;
  //if( !present("gaensebluemchen 4", TP) )
  if(blumeda)
  {
    write("Du pflueckst ein Gaensebluemchen.\n");
    say(TP->name()+" pflueckt ein Gaensebluemchen.\n");
	blumeda--;
    // hier nun ob geben
	CLONE("/d/andracia/yondala/olga/obj/gaensebluemchen.lpc", TP);
    return 1;
  }
  write( BS("Du hast doch schon genuegend Gaensebluemchen gepflueckt.") );
  say( BS(TP->name()+" ueberlegt ob "+TP->QueryPronoun(WER)+" noch ein Gaensebluemchen pfluecken soll.") );
  return 1;
}

int cmd_meditieren(string str)
{
	// meditieren
  if( str ) return 0;

  write( BS("Du meditiert ein paar sekunden aber dann durchfaehrt dich eine Unruhe.") );
  say( BS(TP->name()+" schliesst die Augen und entspannt sich ein bischen.") );
  return 1;
}

