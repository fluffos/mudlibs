#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_og1"
//#define ZZOLGA "/gilden/zaubererzunft/npc/olga"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zweites Obergeschoss von Olga's Turm" );
  SetProp( P_INT_LONG,
     "Dies ist der oberste Raum des Turms. Grosse Fenster nach allen Seiten lassen den Raum "+
     "besonders hell erscheinen. Neben einem grossen Arbeitstisch, der mit Pergamentblaettern und Buechern "+
     "vollstaendig bedeckt ist, sind ein Lesepult, ein einfacher Stuhl, eine schwere Kiste, eine hoelzerne Drehbank "+
     "und ein breites Regal, mit vielen Buechern darin, die einzigen Einrichtungsgegenstaende. Eine Wendeltreppe "+
     "fuehrt hinab in die unteren Etagen");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
/*
  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen.");
  AddSmell( ({  }),
    "");
*/
  AddDetail( ({ "boden", "fussboden" }),
    "Der Fussboden besteht aus einfachen Holzbohlen.");
  AddDetail( ({ "decke", "dach" }),
    "Ueber Dir ist der Dachstuhl zu sehen. Schwere Holzbalken stuetzen die ganze Struktur und die Seiten "+
    "des Dachs sind mit Holz vertafelt. Ein rundes Fenster wurde im Dach eingepasst durch das Lichtstrahlen "+
    "auf den Arbeitstisch fallen.");
  AddDetail( ({ "wand", "waende", "mauer", "mauerwerk" }),
    "Das steinerne Mauerwerk der Waende umfasst die Fenster und reicht bis zum Beginn des Dachstuhls.");
  AddDetail( ({ "raum", "stockwerk", "etage", "raeume", "stockwerke", "etagen" }),
    "Dies scheint der oberste Raum des Turms zu sein. Ueber Dir ist nur noch der Dachstuhl zu sehen.");
  AddDetail( ({ "turm" }),
    "Du befindest Dich hier IM Turm, besser kann man den Turm nicht untersuchen.");
  AddDetail( ({ "fenster", "licht", "lichtstrahlen", "strahlen" }),
    "Neben den grossen Fenstern nach allen Seiten des Turm ist auch ein rundes Fenster ueber Dir im "+
    "Dachstuhl eingepasst. Lichtstrahlen dringen durch dieses Fenster und treffen den Arbeitstisch.");
  AddDetail( ({ "seite", "seiten" }),
    "Du nimmst ein Buch schaust Dir ein paar Seiten an. Stellst fest dass es nur ganz normale Seiten sind und legst es zurueck.");
  AddDetail( ({ "einrichtung", "gegenstaende", "einrichtungsgegenstaende", "gegenstand", "einrichtungsgegenstand" }),
    "Neben einem grossen Arbeitstisch, der mit Pergamentblaettern und Buechern "+
    "vollstaendig bedeckt ist, sind ein Lesepult, ein einfacher Stuhl, eine schwere Kiste, eine hoelzerne Drehbank "+
    "und ein breites Regal, mit vielen Buechern darin, die einzigen Einrichtungsgegenstaende. ");
  AddDetail( ({ "arbeitstisch", "tisch" }),
    "Der Arbeitstisch ist vollstaendig mit Pergamentblaettern und Buechern bedeckt. Du kannst in einem der aufgeschlagenen "+
    "Buechern ein Bild eines langen Zauberstabs mit Kristall erkennen.");
  AddDetail( ({ "pergament", "blaetter", "pergamentblaetter", "pergamente", "blatt", "notizen" }),
    "Die Pergamentblaetter sind teilweise mit allerlei Notizen beschrieben, auf anderen sind Skizzen von Zauberstaeben zu sehen.");
  AddDetail( ({ "buch", "buecher", "buchtitel" }),
    "Du schaust Dir die Buchtitel an und stellst fest, dass sich viele Buecher mit Zauberei befassen. Mehrere Buecher die sich "+
    "mit Baeumen und Straeuchern befassen, kannst Du auch erkennen.");
  AddDetail( ({ "pult", "lesepult" }),
    "Der Lesepult ist leer. ");
  AddDetail( ({ "stuhl", "sitzgelegenheit", "sitz" }),
    "Du kannst nichts besonderes an dem Stuhl erkennen.");
  AddDetail( ({ "kiste" }),
    "Die schwere Kiste ist eisenbeschlagen und hat wohl einen komplizierten Schliessmechanismus. ");
  AddDetail( ({ "drehbank", "mechanik", "trittbrett", "rad", "riementrieb", "spannstock", "stueck" }),
    "Die kleine Drehbank ist ein eindrucksvolles Stueck Mechanik. Ein "
	"Trittbrett treibt ein grosses Rad eines Riementriebs an, das ein "
	"kleines Rad darueber antriebt. Zwischen dem kleinen Rad und einem "
	"Spannstock kann ein Holzstueck eingelegt und gedreht "+
    "werden. ");
  AddDetail( ({ "mechanik", "trittbrett", "rad", "riementrieb", "spannstock" }),
    "Das ist ein Teil der Drehbank.");
  AddDetail( ({ "teile","teil" }),
    "Alle Teile zusammen ergeben die ganze Drehbank.");

  AddDetail( ({ "regal", "buecherregal", "platz" }),
    "Das Regal ist mit ein vielen Buechern vollgestellt. Ein paar Buecher moegen wohl noch Platz darin finden, aber nicht "+
    "allzu viele. Es ist aus einfachem Holz und man kann schon leicht erkennen wie sich die Bretter unter der Last durchbiegen. ");
  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Wendeltreppe fuehrt hinab in die tiefer liegenden Raeume des Turms.");
  AddDetail( ({ "holz", "holzbohlen", "bohlen", "holzbalken", "balken", "holzstueck", "brett", "bretter" }),
    "Du schaust genauer hin aber es ist nur ganz normales Holz.");
  AddDetail( ({ "struktur", "dachstuhl", "stellen" }),
    "Die grossen Balken stuetzen weitere Balken die an vielen Stellen das Dach halten. ");
  AddDetail( ({ "beginn" }),
    "Du kannst nichts besonderes daran erkennen.");
  AddDetail( ({ "zauberstab", "zauberstaebe" }),
    "Ein paar Skizzen von Zauberstaeben kannst Du auf den Pergamentblaettern erkennen. ");
  AddDetail( ({ "kristall", "kristalle", "skizze" , "skizzen", "bild"}),
    "Es ist nur eine gezeichnete Skizze.");
  AddDetail( ({ "last" }),
    "Es sind sehr viele Buecher im Regal, die Bretter des Regals biegen sich schon etwas durch.");
  AddDetail( ({ "schloss", "schliessmechanismus", "mechanismus" }),
    "Ein sehr kompliziertes Schloss wurde in der Kiste eingebaut.");
  AddDetail( ({ "baeume", "straeucher" }),
    "Einige Buecher befassen sich mit Baeumen oder Straeuchern.");
  AddDetail( ({ "zauberei", "zaubereiwerkstatt" }),
    "Hier ist eine Zaubereiwerkstatt, so einfach kann man Zauberei nicht untersuchen.");

/*
  AddDetail( ({ "" }),
    BS(""));
*/
//  AddItem( ZZOLGA, REFRESH_NONE );

  AddCmd( ({"oeffne"}), "cmd_oeffnen" );
  
  AddExit( "unten", AUSGANG1 );
}

int cmd_oeffnen(string str)
{
// kiste oeffnen
  notify_fail("Was willst Du oeffnen?");
  if( str!="kiste" && str!="holzkiste" ) return 0;
  write(BS("Du versuchst die Kiste zu oeffnen, musst aber feststellen dass Sie fest verschlossen ist."));
  say(BS(TP->Name()+" versucht die Kiste zu oeffnen."));
  // Olga was sagen lassen? oder gar einen Zauber wirken?
  return 1;
}
