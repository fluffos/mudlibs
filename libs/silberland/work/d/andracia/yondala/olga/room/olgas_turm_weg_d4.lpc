#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_weg_d3"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_eg"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
    BS("Der Trampelpfad endet hier an einem versteckt im Wald stehenden Turm. Er ist nicht hoeher als die Baeume "+
    "und konnte daher kaum von weitem gesehen werden. Eine kleine, steinerne Treppe fuehrt zum Eingang des Turm. "+
    "Direkt vor dem Turm steht ein hoelzernes Hinweisschild, mit filigran geschwungener Schrift. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Neben dem Rauschen der Blaetter im Wind kann man auch hin und wieder "+
    "das Haemmern eines Spechts in der Ferne hoeren."));
  AddSound( ({ "rauschen", "geraeusch", "geraeusche", "wind" }),
    BS("Der Wind, der durch die Baumkronen weht, erzeugt ein allgegenwaertiges Rauschen im Wald. "));
  AddSound( ({ "haemmern", "specht", "vogel", "voegel" }),
    BS("In einiger Entfernung kannst Du hin und wieder das typische Haemmern eines Spechts hoeren. "));
  AddSmell( DEFAULT_SMELL,
    BS("Die Luft ist erfuellt mit dem typischen Duft eines Waldes."));
  AddSmell( ({ "duft", "geruch", "luft", "wald", "waldluft", "note" }),
    BS("Neben dem feucht-modrigen Geruch der Erde und dem suesslichen Duft den die Baeume beitragen kannst du eine "+
    "besondere Note von Moosen erahnen."));
  AddSmell( ({ "erde", "waldboden", "boden", "erdreich" }),
    BS("Der Waldboden riecht sehr typisch fuer einen Wald: faulende Blaetter und frisches Erdreich."));
  AddSmell( ({ "baeume", "baum" }),
    BS("Baeume haben einen ganz eigenen, angenehmen Geruch. Du geniesst die Waldluft und nimmst einen tiefen Atemzug."));
  AddSmell( ({ "moose", "moos" }),
    BS("Der steinerne Turm der hier im Wald versteckt steht, ist bis zu einer Zwergenlaenge vom Boden hoch, "+
    "sporadisch mit Moos bewachsen."));

  AddDetail( ({ "boden", "erde", "erdreich", "waldboden" }),
    BS("Der Boden besteht aus festgetrampelter Erde. Hier scheinen sehr oft Menschen oder Tieren entlang zu gehen "+
    "da auf dem Weg selbst keine einzige Pflanze waechst."));
  AddDetail( ({ "himmel", "sonne" , "sonnenstrahl", "sonnenstrahlen"}),
    BS("Durch die dichten Baumkronen hindurch kann man desoefteren ein Stueck tiefblauen Himmel erkennen. "+
    "Das gute Sommerwetter sorgt fuer angenehme Waerme hier im Wald."));
  AddDetail( ({ "pfad", "weg", "trampelpfad" }),
    BS("Der Trampelpfad endet hier an einem, aus Stein erbautem Turm. Eine kleine steinerne Treppe fuehrt "+
    "zum Eingang des Turms. Nach Norden fuehrt der Pfad wieder zurueck zu einer Lichtung, die man von hier "+
    "nur erahnen kann."));
  AddDetail( ({ "wald", "nebelwald", "baeume", "umgebung", "bereich" }),
    BS("Die Baeume stehen hier recht eng beieinander und die Baumkronen verbinden sich ueber Dir zu einem "+
    "geschlossenen Blaetterdach. Nur hin und wieder kann man ein kleines Stueck des tiefblauen Himmels "+
    "sehen"));
  AddDetail( ({ "turm" }),
    BS("Der Turm ist aus groben Steinbloecken erbaut und bis zu knapp einer Zwergenhoehe vom Boden aus "+
    "waechst sporadisch Moos in kleinen Buescheln auf den Steinen. Eine steinerne Treppe fuehrt ein paar "+
    "Stufen hinauf zum erhoehten Eingang. Der Turm selbst ist nicht hoeher als die Baeume die hier "+
    "wachsen." ));
  AddDetail( ({ "treppe", "stufen", "rand", "treppenstufe", "teppenstufen" }),
    BS("Die Treppe besteht nur aus 4 Stufen und fuehrt zum Eingang des Turms, eine schwere hoelzerne Tuer."+
    "auf den Stufen waechst am Rand ein paar Bueschel Moos und ein paar Blaetter sind auf die Stufen gefallen."));
  AddDetail( ({ "eingang", "tuer" }),
    BS("Die hoelzerne Tuer, die ins Innere des Turms fuehrt ist schwer beschlagen und das dunkle Holz "+
    "scheint ein besonders widerstandsfaehiges Material zu sein. "));
  AddDetail( ({ "schild", "hinweis", "hinweisschild" }),
    BS("Ein einfaches Hinweisschild aus Holz wurde hier vor den Stufen aufgestellt. Eine filigrane "+
    "Aufschrift laesst vermuten dass eine gebildete Frau dieses Schild beschriftet hat." ));
  AddDetail( ({ "schrift", "lettern", "schnoerkel", "linien", "aufschrift" }),
    BS("Die Schrift auf dem Hinweisschild ist sehr filigran und mit allerlei Schnoerkel und geschwungenen "+
    "Linien verziert. Trotz dem ausgeschmueckten Lettern kann man den Hinweis sehr gut lesen."));
  AddDetail( ({ "holz", "material" }),
    BS("Das Material, aus dem die Tuer des Turms besteht, scheint eine schwere, dunkle Holzart zu sein. "+
    "Irgendwie glaubst Du dass auch Feuer dieser Tuer nichts anhaben kann."));
  AddDetail( ({ "baumkrone", "baumkronen", "blaetterdach" }),
    BS("Ueber dir bilden die Baeume ein geschlossenes Blaetterdach. Kaum ein Sonnenstrahl dring bis hier herab, "+
    "nur hin und wieder kannst du ein bischen blauen Himmel zwischen den Baumkronen erkennen. "));
  AddDetail( ({ "wetter", "sommerwetter", "waerme", "sommer", "tag" }),
    BS("Das Wetter verspricht ein guter Sommertag zu werden. Es ist selbst hier in etwas schattigeren Bereichen "+
    "des Waldes noch warm und zwischen den Baumkronen hindurch kann man manchmal ein kleines Stueck blauen Himmel sehen. "));
  AddDetail( ({ "blaetter", "blatt" }),
    BS("Die Baeume verlieren im Herbst ihre Blaetter. Einige sind wohl dabei auf die Stufen gefallen."));
  AddDetail( ({ "herbst", "einzug" }),
    BS("Noch hat der Herbst keinen Einzug gehalten in diesem Wald. Noch ist alles gruen und die Sonne sorgt "+
    "fuer angenehm warme Luft hier im Wald."));
  AddDetail( ({ "bueschel", "moos" }),
    BS("Hier auf den schattigen Treppenstufen und im unteren Bereich des Turms waechst Moos auf den Steinen. "+
    "Du tastest mit einem Finger und bemerkst wie weich und feucht das Moos ist."));
  AddDetail( ({ "finger" }),
    BS("Mit deinem Finger ist alles in Ordnung."));
  AddDetail( ({ "ordnung", "rucksack" }),
    BS("In dein Rucksack liegt alles kreuz und quer durcheinander. Von Ordnung haelst Du wohl nichts."));
  AddDetail( ({ "entfernung", "ferne" }),
    BS("Du kannst leider nicht abschaetzen wie weit der Specht entfernt sein mag.NMur sein lautes Haemmern "+
    "verraet Dir dass es nicht allzu weit sein kann."));
  AddDetail( ({ "holzart" }),
    BS("Du kannst leider nicht erkennen aus welcher Holzart die Tuer gefertigt ist."));
  AddDetail( ({ "innere" }),
    BS("Dazu musst Du schon hineingehen."));
  AddDetail( ({ "lichtung", "norden" }),
    BS("Im Norden scheint sich eine Lichtung zu befinden. "));
  AddDetail( ({ "pflanze", "pflanzen" }),
    BS("Hier im Wald gibt es viele verschiedene Pflanzen: Baeume, Farne und Moose kannst Du in "+
    "der naeheren Umgebung sehen. "));
  AddDetail( ({ "farne", "farn" }),
    BS("Es ist nur ein einfacher Farn. Er waechst hier im Schatten des Turms. Du kannst nichts besonderes erkennen. "));
  AddDetail( ({ "schatten", "licht" }),
    BS("Der Turm wirft einen grossen Schatten. Aber die Baumkronen lassen auch nur wenig Licht bis hier unten herab."));
  AddDetail( ({ "stein", "steine", "steinbloecke" }),
    BS("Der Turm ist aus groben Steinbloecken erbaut. Auch die Treppe ist aus behauenen Steinen. "));
  AddDetail( ({ "zwergenlaenge", "zwergenhoehe" }),
    BS("Eben die Groesse eines ausgewachsenen Zwerges."));
  AddDetail( ({ "atem", "atemzug", "mundgeruch" }),
    BS("Du hauchst kurz aus aber leider stellst Du nichts besonderes fest - nicht einmal ob du Mundgeruch hast."));
  AddSmell( ({ "atem", "atemzug", "mundgeruch" }),
    BS("Du kannst leider nicht feststellen ob Du Mundgeruch hast."));

  /*
  Feuer, Frau, Groesse, Menschen, Sommertag, Stueck, Tieren, Zwerges
  AddDetail( ({ "" }),
    BS(""));
  */
  AddReadDetail( ({ "schild", "hinweis", "hinweisschild" }),
    "+--------------------------------------------------------------+\n"+
    "| Herzlich willkommen, wandernder Zauberer, schaut herein und  |\n"+
    "| ueberzeugt euch von meinen Diensten als Zauberstabmacherin.  |\n"+
    "| Ihr benoetigt einen geeigneten Stab und Edelsteine um meine  |\n"+
    "| Kunst in Anspruch zu nehmen. Auch solltet ihr genuegend      |\n"+
    "| Muenzen bereithalten um meine Unkosten zu decken.            |\n"+
    "|                                gez. Olga, Zauberstabmacherin |\n"+
    "+--------------------------------------------------------------+\n");


  AddCmd(({"tritt", "trete"}), "cmd_treten");
  //AddCmd(({"sammel", "sammle", "such", "suche"}), "cmd_sammeln");
  AddCmd(({"oeffne"}), "cmd_oeffnen");
  AddCmd(({"betrete"}), "cmd_betreten");
  
  AddExit( "norden", AUSGANG1 );
  // AddExit( "westen", AUSGANG2 );

}

int cmd_treten(string str)
{
	// auf ast treten erzeugt Knacken in den Nachbar-Raeumen
  if( str!="auf ast" && str!="auf aeste" && str!="ast" && str!="aeste" ) return 0;
  if( !random(10) )
  {
    write("Du trittst auf einen Ast, aber er bricht nicht.\n");
    say(TP->name()+" tritt auf einen Ast.\n");
    return 1;
  }
  write( BS("Du trittst auf einen Ast, er bricht und das laute Knacken unterbricht die Ruhe und hallt durch den Wald.") );
  say( BS(TP->name()+" tritt auf einen Ast und ein lautes Knacken hallt durch den Wald.") );
  call_other(AUSGANG1, "???", 0);
  tell_room( AUSGANG1, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  /*call_other(AUSGANG2, "???", 0);
  tell_room( AUSGANG2, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");*/
  return 1;
}

int cmd_oeffnen(string str)
{
	notify_fail("Was willst Du oeffnen?\n");
  if( str!="tuer" && str!="turm" && str!="holztuer" ) return 0;
  write("Yondala hat das bis auf weiteres untersagt. Teile ihr Deinen Unmut mit, dann passiert hier schneller was.\n");
/*	write( BS("Du oeffnest die Tuer und betrittst den Turm.") );
  return TP->move(AUSGANG2, M_GO, 0, "betritt den Turm", "kommt herein");*/
  return 1;
}

int cmd_betreten(string str)
{
	notify_fail("Was willst Du betreten?\n");
  if( str!="turm" ) return 0;
 write("Yondala hat das bis auf weiteres untersagt. Teile ihr Deinen Unmut mit, dann passiert hier schneller was.\n");
/*	write( BS("Du oeffnest die Tuer und betrittst den Turm.") );
  return TP->move(AUSGANG2, M_GO, 0, "betritt den Turm", "kommt herein");*/
  return 1;
}
