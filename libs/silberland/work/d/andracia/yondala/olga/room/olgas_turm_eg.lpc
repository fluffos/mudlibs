#include "../def.h"
	
inherit "std/room";

#include <properties.h>


string unt_zeitschrift()
{
  if(TP->QueryProp(P_GUILD)=="zaubererzunft")
    return BS("Es handelt sich scheinbar um etwas aeltere Ausgaben von 'Zauberei heute' und 'Hexenwerk', "+
      "den bekanntesten Zeitschriften fuer Zauberer. ");
  else
    return BS("Die Titelblaetter der Zeitschriften sind bunt und zeigen irgendwelche Zauberer. "+
      "Du blaetterst kurz darin, kannst aber mit den Artikeln nichts anfangen.");
}

string lies_zeitschrift()
{
  if(TP->QueryProp(P_GUILD)=="zaubererzunft")
    return BS("Du blaetterst die Zeitschriften kurz durch aber kein Artikel davon weckt Dein Interesse. ");
  else
    return BS("Die Titelblaetter der Zeitschriften sind bunt und zeigen irgendwelche Zauberer. "+
      "Du blaetterst kurz darin, kannst aber mit den Artikeln nichts anfangen.");
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Erdgeschoss von Olga's Turm" );
  SetProp( P_INT_LONG,
     "Der runde Raum wird spaerlich erleuchtet durch eine ungewoehnliche Lampe, die an einer eisernen Kette "+
	"in der Mitte des Raums von der hohen Decke haengt. Zwei hoelzerne Baenke stehen an der Wand und "+
	"ein flacher Tisch steht etwas entfernt unter der Lampe. Gegenueber des Eingangs fuehrt eine schmale "+
	"Wendeltreppe in die oberen Stockwerke. ");
	
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise Geraeusche von oben.");
  AddSound( ({ "geraeusch", "geraeusche" }),
    "Scheinbar ist in einem oberen Stockwerk jemand. Man kann hin und wieder Schritte und gedaempft Stimmen hoeren.");
  AddSound( ({ "schritte", "schritten", "knarzen" }),
    "Man kann hoeren wie jemand in einem oberen Stockwerk ueber den hoelzernen Boden geht.");
  AddSound( ({ "stimme", "stimmen" }),
    "Leider kann man nicht verstehen was dort oben geredet wird. Auch bist Du nicht sicher um "+
    "wieviele Stimmen es sich handelt.");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es wie auf einer herbstlichen Blumenwiese. Es ist ein angenehmer Duft.");
  AddSmell( ({ "duft", "blumenwiese", "herbst", "blume", "blumen", "wiese", "beunde" }),
    "Du versuchst dem Duft zu folgen und nach einer kurzen Orientierung kannst Du die Quelle ausmachen: "+
    "an der Wendeltreppe haengen mehrere Buende Blumen zum trocknen.");
  AddSmell( ({ "quelle", "duftquelle" }),
    "Du schnupperst direkt an den getrockneten Blumen und kannst gerade so noch ein Niesen unterdruecken.");
  AddSmell( ({ "niesen" }),
    "Du kannst gerade noch unterdruecken.");

  AddDetail( ({ "boden" }),
    "Holzbohlen bilden den Boden und ein abgewetzter Teppich daempft die Schritte. Nur hin und wieder kommt "+
    "hoert man ein knarzen wenn man ueber den Boden geht.");
  AddDetail( ({ "decke" }),
    "Die hohe Decke ist recht schmucklos, grosse Querbalken tragen "
	"hoelzerne Bohle und in der Mitte wurde eine ungewoehnliche Lampe an "
	"einer eisernen Kette an einem Balken befestigt.");
  AddDetail( ({ "wand", "waende", "innenwand", "innenwaende" }),
    "Das grobe Mauerwerk des Turms kann man auch hier innen sehen. "
	"Felsbloecke und Moertel wurden aber besser verarbeitet und so "
	"enstehen fast glatte Waende. ");

  AddDetail( ({ "raum", "stockwerk", "etage", "orientierung" }),
    "Der Raum ist spaerlich eingerichtet. Nur zwei einfache Holzbaenke "
	"stehen an der Wand und ein flacher Tisch steht unter der Lampe in "
	"der Mitte des Raums. Eine schwere Tuer fuehrt hinaus in den Wald und "+
    "gegenueber der Tuer fuehrt eine Wendeltreppe hinauf in die oberen "
	"Stockwerke.");
  AddDetail( ({ "lampe" }),
    "Eine ungewoehnliche Lampe erhellt den Raum. Es flackert nicht und das Licht ist nicht weiss oder gelblich, wie "+
    "man es von einem Feuer erwarten wuerde sondern eher blau. Das ist bestimmt ein magisches Licht. "+
    "Leider haengt sie zu hoch um sie naeher zu untersuchen. ");
  AddDetail( ({ "kette", "eisenkette" }),
    "Die Lampe ist an einer Kette unter der Decke an einem Balken befestigt. Leider haengt sie zu hoch um sie "+
    "naeher zu untersuchen. Aber vom Aussehen her muesste es eine normale Eisenkette sein. ");
  AddDetail( ({ "bank", "baenke", "holzbank", "holzbaenke" }),
    "Die einfachen Holzbaenke wurden rechts und links an der Wand platziert. Ein bischen Staub liegt auf ihnen, "+
    "scheinbar wurden sie schon lange nicht mehr benutzt. ");
  AddDetail( ({ "tisch" }),
    "Der Tisch steht fast genau in der Mitte des Raums. Er ist scheinbar "
	"nicht dazu gedacht um daran zu sitzen, dafür ist er einfach zu tief. "
	"Es liegt neben einem Stapel kleiner Zettel auch zwei Zeitschriften "
	"mit ungewoehnlich farbigem Titelblatt darauf. "  );
  AddDetail( ({ "mitte" }),
    "Mitte bedeutet, dass alle Waende gleich weit entfernt sind."  );
  AddDetail( ({ "eingang", "tuer", "ausgang", "wald" }),
    "Die Tuer fuehrt hinaus in den Wald. ");
  AddDetail( ({ "wendeltreppe", "treppe" }),
    "Die Wendeltreppe fuehrt hinauf in die oberen Stockwerke. Mehrere "
	"Buende Blumen wurden hier zum Trocknen "+
    "aufgehaengt. Der Duft dieser Blumen erfuellt den Raum.");
  AddDetail( ({ "trocknen" }),
    "Um sie halbar zu machen sollen die Blumen austrocknen. Meistens "
	"haemngt man sie dafuer kopfueber auf."  );
  AddDetail( ({ "holz" }),
    "Es scheint ganz normales Holz zu sein.");
  AddDetail( ({ "eisen" }),
    "Leider kommst Du nicht so nah an die Eisenkette heran um das Eisen genauer zu untersuchen.");
  AddDetail( ({ "stimme", "stimmen", "wort", "worte" }),
    "Die Stimmen sind nur dumpf zu hoeren. Du kannst kein Wort verstehen.");
  AddDetail( ({ "schritt", "schritte" }),
    "Jemand scheint in den oberen Stockwerken zu sein. Zumindest hoert sich das Knarzen der Holzbohlen "+
    "ueber Dir so an .");
  AddDetail( ({ "duft", "geruch" }),
    "Hier funktioniert riechen besser.");
  AddDetail( ({ "blume", "blumen", "bund", "buende", "duftquelle" }),
    "Die Buende Blumen wurden an der Wendeltreppe zum Trocknen aufgehaengt. Sie verstroemen einen angenehmen Duft, "+
    "der einer Blumenwiese nahekommt.");
  AddDetail( ({ "bohle", "bohlen", "holzbohle", "holzbohlen" }),
    "Es sind nur ganz normale Holzbohlen.");
  AddDetail( ({ "balken", "holzbalken", "querbalken" }),
    "Es handelt sich scheinbar um ganz normale Holzbalken.");
  AddDetail( ({ "mauer", "mauerwerk" }),
    "Das Mauerwerk bildet sich auch hier an den Innenwaenden ab. Die gute Verarbeitung und die geglaetteten Fugen "+
    "bilden eine fast glatte Oberflaeche.");
  AddDetail( ({ "fels", "stein", "felsen", "steine", "felsblock", "steinblock", "felsbloecke", "steinbloecke", "oberflaeche" }),
    "Es sind fast glatte Waende. Die Steine des Mauerwerks wurden wohl von einem faehigen Steinmetz behauen. ");
  AddDetail( ({ "steinmetz", "handwerker", "werker" }),
    "Du kannst hier gerade keinen Handwerker sehen.");
  AddDetail( ({ "moertel", "fugen", "fuge" }),
    "Das Mauerwerk ist gut verarbeitet. Der Moertel in den Fugen ist geglaettet und bildet mit den behauenen "+
    "Steinen eine ebene Wand.");
  AddDetail( ({ "verarbeitung" }),
    "Die Waende wurden gut verarbeitet. Der Moertel ist geglaettet und bildet ein ebenes Mauerwerk.");
  AddDetail( ({ "glaette", "glatt", "ebene", "ebenheit" }),
    "Die Wand ist sehr glatt.");
  AddDetail( ({ "stockwerke" }),
    "Du solltest eher jedes Stockwerk einzeln untersuchen. ");
  AddDetail( ({ "licht", "feuer" }),
    "Die Lampe, die an der Decke haengt, leuchtet blaeulich und flackert nicht. Das scheint kein Feuer zu sein, "+
    "es ist warscheinlich ein magisches Licht.");
  AddDetail( ({ "aussehen", "ergebnis" }),
    "Du schaust genauer hin und bleibst bei dem Ergebnis dass es sich wohl um eine Eisenkette handelt.");
  AddDetail( ({ "staub" }),
    "Ein bischen Staub liegt auf den Baenken, scheinbar wurden sie schon laenger nicht mehr benutzt.");
  AddDetail( ({ "stapel", "zettel" }),
    "Scheinbar handelt es sich um eine Broschuere ueber Zauberstabmacherei. Du kannst Dir sicher einen nehmen.");
  AddDetail( ({ "zeitschrift", "zeitschriften", "titel", "titelblatt" }),
    #'unt_zeitschrift );
  AddReadDetail( ({ "zeitschrift", "zeitschriften" }),
    #'lies_zeitschrift );
  AddDetail( ({ "turm" }),
    "Du befindest dich hier IM Turm, besser kann man den Turm nicht untersuchen.");
  AddDetail( ({ "teppich" }),
    "Der Teppich ist abgewetzt und sein Muster kann man kaum mehr erkennen.");
  AddDetail( ({ "muster" }),
    "Das Muster des Teppichs kann man nicht mehr erkennen.");
  AddDetail( ({ "broschuere", "broschueren", "zauberstabmacherei" }),
    "Die Broschueren zur Zauberstabmacherei sind auf dem Tisch gestapelt. Du kannst Dir sicher einen nehmen.");

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddCmd( ({"nimm", "nehme"}), "cmd_nehmen" );
  
  AddExit( "oben", ROOM+"olgas_turm_og1" );
  AddExit( "raus", ROOM+"olgas_turm_weg_d4");
}

int cmd_nehmen(string str)
{
	// notify_fail("Was willst Du nehmen?\n");
	if( str!="broschuere" && str!="zettel" && str!="broschuere vom stapel" && str!="zettel vom stapel" ) return 0;
	CLONE( OBJ+"zzbroschuere", TP);
	write("Du nimmst Dir einen Zettel vom Stapel.\n");	
	say( TPN+" nimmt sich einen Zettel vom Stapel.\n");
	return 1;
}
