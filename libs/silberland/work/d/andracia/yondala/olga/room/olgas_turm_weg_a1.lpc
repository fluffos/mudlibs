#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/wege/room/weg_zum_hafen_04"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_weg_b2"
#define STAB "/gilden/zaubererzunft/weapon/rohstab_eiche.lpc"

int ast_da;

void reset()
{
  ast_da=1;
  ::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich auf einem schmalen Trampelpfad mitten im Wald. Die Baeume stehen hier nicht sehr "+
     "dicht und man kann gut erkennen wohin der Weg weiter verlaeuft. Im Norden kann man den Waldrand und "+
     "die Strasse erkennen. Dahinter sieht man auch noch ein paar grasbewachsene Huegel."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst nur das Rauschen der Baeume im Wind."));
  AddSound( ({ "rauschen", "wind", "blaetter", "aeste"  }),
    BS("Der Wind streicht durch die Blaetter und Aeste der Baeume und verursacht dieses beruhigende Rauschen."));
  AddSound( ({ "knacken"  }),
    BS("Es scheint als ob in der Naehe jemand auf einen Ast getreten sei."));
  AddSmell( DEFAULT_SMELL,
    BS("Du riechst hier nur wenig von dem typischen Geruch der Waelder."));
  AddSmell( ({ "wald", "waelder", "geruch", "laub" }),
    BS("Der typische Geruch der Waelder ist hier nur wenig vorhanden. Nur das bischen verottetes Laub, "+
    "das den Weg bildet, kannst Du vom Geruch her ausmachen."));

  AddDetail( ({ "boden", "waldboden", "untergrund" }),
    BS("Der Boden ist hier niedergetrampelt. Neben ein paar losen Steinen bilden altes Laub und trockene Aeste "+
    "den Untergrund. Neben dem Trampelpfad wachsen verschiedene Pflanzen aus dem Waldboden."));
  AddDetail( ({ "himmel" }),
    BS("Die Baeume stehen zwar nicht allzu dicht hier, doch viel vom Himmel kann man trotzdem nicht erkennen. "+
    "Soviel du erkennen kannst ist der Himmel tiefblau und nur wenige Wolken sind zu sehen."));
  AddDetail( ({ "ruhe" }),
    BS("Der Wind rauscht durch die Baeume und ein angenehmer Waldgeruch umgibt dich. Hier kann man die Ruhe "+
    "foermlich spueren."));
  AddDetail( ({ "pfad", "trampelpfad", "weg", "streifen" }),
    BS("Der Trampelpfad fuehrt von der Strasse im Norden weg nach Suedosten tiefer in den Wald hinein. "));
  AddDetail( ({ "wald", "waelder", "baeume" }),
    BS("Die Baeume des Waldes stehen hier nicht sehr dicht zusammen. Daher sind die Lichtverhaeltnisse sehr gut "+
    "und ein paar Sonnenstrahlen, die durch dass Blattwerk der Baeume dringen, spielen am Boden ein verwirrendes "+
    "Muster aus hellen Flecken."));
  AddDetail( ({ "baum" }),
    BS("Du untersuchst den Dir am naechsten stehenden Baum und stellst erstaunt fest dass es sich hier um eine "+
    "Eiche handelt. "));
  AddDetail( ({ "norden", "strasse", "huegelland", "huegel" }),
    BS("Die Strasse, die nach Westen zum Hafen fuehrt, ist nur ein kleines Stueck gen Norden. "));
  AddDetail( ({ "sueden", "nebelwald" }),
    BS("Im Sueden wird der Wald immer dichter. Auch glaubst Du ein paar Nebelschwaden zu erkennen, "+
    "schliesslich heisst dieser Wald nicht umsonst Nebelwald."));
  AddDetail( ({ "wind" }),
    BS("Du spuerst hier am Boden nur wenig vom Wind, der durch das Blattwerk der Baeume streicht."));
  AddDetail( ({ "blatt", "blaetter", "laub", "blattwerk" }),
    BS("Der Boden ist fast ueberall mit verottenem Laub bedeckt. Nur die Pflanzen, die hier am Rand des Pfades "+
    "wachsen, unterbrechen diesen dunkelbraunen Untergrund. "));
  AddDetail( ({ "ast", "aeste" }),
    BS("Hin und wieder liegen abgebrochene Aeste am Boden. Du versuchst nicht auf diese Aeste zu treten, da "+
    "dies ein lautes Knacken verursachen koennte."));
  AddDetail( ({ "stein", "steine" }),
    BS("Nur wenige Steine liegen hier auf dem Pfad. Es handelt sich dabei auch nur um ganz gewoehnliche Steine."));
  AddDetail( ({ "pflanzen", "gewaechse", "rand" }),
    BS("Die Pflanzen, die hier am Rand des Pfads wachsen, sind kleine Farne. Wie ein kleiner gruener Teppich bedecken "+
    "hier die Farne den ansonsten dunkelbraunen Waldboden."));
  AddDetail( ({ "wolken", "fetzen" }),
    BS("Du hast bei den paar Fetzen Himmel die Du hier sehen kannst nur wenige Wolken ausmachen koennen."));
  AddDetail( ({ "suedosten" }),
    BS("Der Trampelpfad fuehrt in diese Richtung weiter. Man kann dem ausgetrampelten Streifen, der hier "+
    "durch den Wald fuehrt, gut folgen."));
  AddDetail( ({ "lichtverhaeltnisse" }),
    BS("Da die Baeume hier noch recht weit auseinander stehen dringt noch sehr viel Licht bis hier zum Waldboden "+
    "herunter. Durch das Blattwerk der Baeume hindurch erzeugen Lichtstrahlen ein dynamisches Muster von "+
    "Lichtflecken am Boden."));
  AddDetail( ({ "sonnenstrahlen", "muster", "flecken", "licht", "lichtflecken", "lichtstrahlen" }),
    BS("Die Sonnenstrahlen, die durch das vom Wind bewegte Blattwerk der Baeume dringt, bildet am Waldboden ein "+
    "herrlich dynamisches Muster am Waldboden. Es wirkt irgendwie beruhigend."));
  AddDetail( ({ "westen", "hafen" }),
    BS("Du kannst die Strasse, die am Waldrand entlang fuehrt, gut erkennen. Sie fuehrt nach Westen bis zum Hafen. "));
  AddDetail( ({ "nebelwald", "nebel" }),
    BS("Der Wald, den Du gerade durchwanderst heisst Nebelwald. Je tiefer man in den Wald geht, umso dichter sollen "+
    "die Nebel werden. "));
  AddDetail( ({ "teppich", "farne", "farn", "durchmesser" }),
    BS("Dieser kleine gruene Teppich aus Farnen, hier am Rand des Pfads, misst in seinem Durchmesser "+
    "kaum 3 Schritte eines ausgewachsenen Menschen. "));
  AddDetail( ({ "eiche" }),
    BS("Diese Eiche unterscheidet sich kaum von den anderen Baeumen ringsum. Die Rinde des Baums ist recht dunkel "+
    "und der Baum beginnt schon recht tief sich zu veraesteln. "));
  AddDetail( ({ "rinde" }),
    BS("Die dunkle Rinde der Eiche ist sehr rauh, bietet aber nur wenig Moeglichkeiten zum Hochklettern."));
  AddDetail( ({ "moeglichkeiten" }),
    BS("Du siehst nur wenig Moeglichkeiten zum Erklettern der Eiche."));
  AddDetail( ({ "moeglichkeit" }),
    BS("Nein, hier findest Du keine Moeglichkeit zum Hochklettern. Nur den einen Ast hier koennte man abbrechen. "));
  AddDetail( ({ "schritte" }),
    BS("Wenn man auf einen trockenen Ast tritt, so kann man das Knacken weithin hoeren."));
  AddDetail( ({ "waldrand" }),
    BS("Der Waldrand befindet sich im Norden. Man kann sogar noch die Strasse sehen."));
  /*
  Menschen, Naehe, Stueck
  AddDetail( ({ "" }),
    BS(""));
  */
 
  AddCmd(({"kletter", "klettere", "kraxle", "kraxel"}), "cmd_klettern");
  AddCmd(({"tritt", "trete"}), "cmd_treten");
  AddCmd(({"brich", "breche", "brech"}), "cmd_brechen");
  
  ast_da=1;
  
  AddExit( "norden", AUSGANG1 );
  AddExit( "suedosten", AUSGANG2 );
}

int cmd_klettern(string str)
{
	// hier kann man nicht hochklettern
  notify_fail("Wo willst du hinklettern?\n");
  if( str!="eiche" && str!="baum" && str!="hoch" && str!="hinauf" && str!="auf eiche" && str!="auf baum") return 0;
  write(BS("Du versuchst den Baum hochzuklettern, findest aber leider nicht genuegend Halt an der rauhen Rinde.") );
  say(TP->name()+" versucht vergeblich einen Baum hochzuklettern.\n");
  return 1;
}

int cmd_treten(string str)
{
	// auf ast treten erzeugt Knacken in den Nachbar-Raeumen
  if( str!="auf ast" && str!="auf aeste" && str!="ast" && str!="aeste" ) return 0;
  if( !random(10) )
  {
    write("Du trittst auf einen Ast, aber er bricht nicht.\n");
    say(TP->name()+" tritt auf einen Ast.\n");
    return 1;
  }
  write( BS("Du trittst auf einen Ast, er bricht und das laute Knacken unterbricht die Ruhe und hallt durch den Wald.") );
  say( BS(TP->name()+" tritt auf einen Ast und ein lautes Knacken hallt durch den Wald.") );
  call_other(AUSGANG1, "???", 0);
  tell_room( AUSGANG1, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  call_other(AUSGANG2, "???", 0);
  tell_room( AUSGANG2, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  return 1;
}

int cmd_brechen(string str)
{
	// hier kann man einen Eichenast abbrechen -> Rohstab
  object ob;
  notify_fail("Was willst Du abbrechen?\n");
  if(str!="ast ab" && str!="ast") return 0;
  if( !ast_da )
  {
     write( BS("Du versuchst den Ast abzubrechen, aber dieser morsche Teil des Baums zerfaellt in deiner Hand.") );
     say( BS(TP->name()+" untersucht einen Baum.\n") );
     return 1;
  }
  ast_da=0;
  write( BS("Du brichst den langen Ast ab und steckst ihn ein.") );
  write( BS("Du tust das allerdings erst, wenn die Zauberer mal da sind. Merk Dir also die Stelle.") );
  
  say( BS(TP->name()+" bricht einen laengeren Ast ab und steckt ihn ein.") );
  //CLONE( STAB , TP);
  return 1;
}
