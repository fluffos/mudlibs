#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_weg_b3"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_weg_d3"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
    BS("Der Trampelpfad wird zu beiden Seiten von einem undurchdringlichen Dornengestruepp begrenzt. "+
    "Wie ein Geflecht verhindern die Brombeerranken dass man den Weg verlassen kann. Dazwischen wachsen "+
    "die Baeume in die Hoehe und bilden ein geschlossenes Blaetterdach ueber Dir. Da der Pfad nicht in gerader "+
    "Linie durch das Gestruepp schneidet kann man nicht erkennen wohin dieser Weg fuehrt. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren. Sebst das Rascheln des Windes in den Baumkronen fehlt."));
  AddSound( ({ "rascheln", "baumkrone", "baumkronen", "wind" }),
    BS("Es scheint windstill zu sein und kein Rascheln der Baumkronen untermalt die unheimliche Wirkung "+
    "dieses Trampelpfads. "));
  AddSmell( DEFAULT_SMELL,
    BS("Die Brombeerranken haben keinen besonderen Duft. Erst wenn die Ranken ihre Fruechte tragen wird hier wohl "+
    "ein angenehmer Brombeerduft in der Luft liegen."));
  AddSmell( ({ "duft", "brombeerduft", "fruechte", "brombeerfruechte", "frucht", "brombeerfrucht", "brombeere", "brombeeren", "beere", "beeren" }),
    BS("Die Ranken tragen keine Fruechte und sorgen daher auch nicht fuer den entsprechend fruchtigen Geruch. "));
  AddSmell( ({ "brombeerranken", "brombeerranke", "ranken", "ranke", "geruch" }),
    BS("Diese Brombeerranken haben fast keinen wahrnehmbaren Geruch. Erst wenn die Brombeeren reif sind kann mn ihren Duft riechen. "));
  AddSmell( ({ "luft" }),
    BS("Nur der normale Duft des Waldes liegt in der Luft."));

  AddDetail( ({ "boden", "untergrund" }),
    BS("Der Boden des Trampelpfads besteht aus festgetrampelter Erde und ein paar kleinen Steinen dazwischen."));
  AddDetail( ({ "himmel", "hoehe", "blaetterdach", "dach", "baumkrone", "baumkronen" }),
    BS("Das geschlossene Blaetterdach der Baeume verhindert dass man auch nur ein Stueck Himmel zu sehen bekommt. Auch "+
    "dringt durch dieses natuerliche Dach nur wenig Licht. "));
  AddDetail( ({ "dornengestruepp", "gestruepp", "seiten", "seite" }),
    BS("Zu beiden Seiten des Pfads bilden Brombeerranken ein undurchdringliches Geflecht. Leider ist diese natuerliche Barriere "+
    "zu hoch um darueber hinweg zu schauen. Man kann nur die Baumstaemme erkennen die hinauf zum Blaetterdach fuehren."));
  AddDetail( ({ "geflecht", "ranken", "brombeerranken", "ranke", "brombeerranke", "barriere", "dornenranke", "dornenranken" }),
    BS("Die natuerlichen Barrieren aus verflochtenen Brombeerranken zu beiden Seiten des Pfads scheinen von jemanden gepflegt "+
    "zu werden. Man kann an vielen Ranken Schnitte erkennen die davon zeugen, dass desoeftren in den Weg hereinragende Ranken "+
    "abgeschnitten und damit der Weg offen gehalten wird. "));
  AddDetail( ({ "weg", "pfad", "trampelpfad" }),
    BS("Der Weg windet sich hier durch das dornenreiche Gestruepp. Wenn niemand diese Ranken abschneidet, wuerde dieser Weg "+
    "wohl innerhalb kurzer Zeit zuwachsen. "));
  AddDetail( ({ "baeume", "wald", "bereiche" }),
    BS("Man kann von hier aus nur die oberen Bereiche der Baeume erkennen. Das Dornengestruepp verstellt zu viel Sicht um "+
    "mehr als das vom Wald zu erkennen. "));
  AddDetail( ({ "erde" }),
    BS("Die Erde ist trocken und festgetrampelt. Auch die paar Steine, die am Boden liegen, sind oft fest in den Untergrund hinein getreten. "));
  AddDetail( ({ "linie", "richtung", "richtungen", "verlauf", "umgebung" }),
    BS("Der Weg verlauft in einem unregelmaessige Verlauf in grober Richtung von hier aus nach Osten und Westen. "+
    "Im Osten scheint der Wald etwas heller zu sein."));
  AddDetail( ({ "wirkung", "stimmung", "ambiente" , "enge"}),
    BS("Die Enge zwischen den natuerlichen, dornenreichen Barrieren zu beiden Seiten des Wegs und das diffuse Licht, das hier herrscht, "+
    "bilden eine unheimliche Umgebung. "));
  AddDetail( ({ "fruechte", "brombeerfruechte", "frucht", "brombeerfrucht" }),
    BS("Die Brombeerranken sind noch nicht mit Brombeeren beladen. Erst spaeter im Jahr werden hier viele Beere ihren eigenen Duft "+
    "verbreiten."));
  AddDetail( ({ "stein", "steine" }),
    BS("Nur wenige, kleine Steine auf dem Weg sind lose. Jeder groessere Stein wurde fest getreten und steckt tief im Boden."));
  AddDetail( ({ "stueck" }),
    BS("Dieses Stueck Weg ist sehr unheimlich. Zu beiden Seite diese undurchdringlichen Brombeerranken und nur diffuses Licht."));
  AddDetail( ({ "licht" }),
    BS("Dieses bischen Licht, das durch das Blaetterdach dringt, laesst den von Dornenranken umschlossenen Trampelpfad in "+
    "einem unheimlichen Ambiente erscheinen. Dieser Teil des Waldes hat eine angsteinfloessende Wirkung. "));
  AddDetail( ({ "angst" }),
    BS("Dir wird ein bischen bange bei diesem unheimlichen Weg. "));
  AddDetail( ({ "schnitt", "schnitte", "pflege", "menschenhand", "zeit" }),
    BS("Man kann ueberall am Gestruepp zurueckgeschnittene Ranken erkennen, die wohl sonst den Weg ueberwuchern "+
    "wuerden. Irgendjemand pflegt diesen Weg, damit er weiterhin passierbar bleibt. "));
  AddDetail( ({ "osten" }),
    BS("Nach Osten kommt Dir es vor als ob wird der Wald dort etwas heller sei."));
  AddDetail( ({ "westen" }),
    BS("Der Weg selbst scheint grob nach Westen zu fuehren. "));
  AddDetail( ({ "baumstamm", "stamm", "baumstaemme", "staemme" }),
    BS("Leider kommst Du nicht nah genug heran um einen Baumstamm zu untersuchen. "));
  AddDetail( ({ "luft" }),
    BS("Du kannst daran nichts besonderes ebntdecken. Vielleicht kommt man mit riechen weiter."));
  AddDetail( ({ "sicht" }),
    BS("Von hier aus kann man nur wenig erkennen, aber Dir scheint der Wald im Osten etwas heller zu sein."));

  /*
  Jahr, Teil
  AddDetail( ({ "" }),
    BS(""));
  */

  AddExit( "westen", AUSGANG1 );
  AddExit( "osten", AUSGANG2 );

}
