#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_weg_b2"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_weg_c3"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
     BS("Der Trampelpfad fuehrt hier weiter nach Osten in ein dornenreiches Dickicht hinein. Wie eine geschnittene Schneise "+
     "teilt der Weg das unwirtliche Gestruepp. Die Baeume stehen hier schon sehr eng beieinander und durch das Blaetterdach "+
     "dringt nur noch wenig Licht. Der Wald erscheint hier wie in ein gruenes Daemmerlicht getaucht. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Es ist hier sehr still. Nur selten hoert man ein Knacken, wenn jemand auf einen Ast tritt."));
  AddSound( ({ "stille" }),
    BS("Kein einziges Geraeusch ist zu hoeren."));
  AddSound( ({ "geraeusch", "knacken" }),
    BS("Nur wenn jemand auf einen Ast tritt kann man weithin ein Knacken hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Hier riecht es nach feuchter Erde."));
  AddSmell( ({ "erde" }),
    BS("Hier riecht es sehr nach frischer, feuchter Erde, als ob jemand den Waldboden umgegraben haette."));

  AddDetail( ({ "boden" }),
    BS("Der Boden, auf dem Du gehst besteht vorallem aus festgetrampelter Erde und einigen kleinen und groben Steinen."));
  AddDetail( ({ "himmel" }),
    BS("Das dichte Blaetterdach laesst keinen Sonnenstrahl durchdringen. Nur diffuses, gruenes Daemmerlicht herrscht "+
    "hier am Boden."));
  AddDetail( ({ "pfad", "weg", "trampelpfad", "wege", "norden", "strecke" }),
    BS("Der Pfad ist gut zu erkennen. Nach Norden hin fuehrt er zwischen den Baeumen hindurch. Im Osten fuehrt er "+
    "durch die Schneise im Gestruepp. "));
  AddDetail( ({ "osten", "dickicht", "gestruepp", "schneise", "pflanzenmauer", "geflecht", "gestruepp" }),
    BS("Der Weg durchschneidet das Gestruepp. Scheinbar wurde das Dickicht zurueckgeschnitten und nun fuehrt der Weg "+
    "direkt mitten hindurch. Neben Farnen besteht das Dickicht vorallem aus stacheligen Brombeerranken. "+
    "Durch das Gestruepp selbst ist kein Durchkommen, aber zum Glueck wurde ja der Weg freigeschnitten."));
  AddDetail( ({ "baeume", "wald", "umgebung" }),
    BS("Die Baeume stehen hier sehr dicht zusammen und bilden ein geschlossenes Blaetterdach, durch das kein Sonnenstrahl "+
    "mehr herunter dringt. Im Sueden wird der Wald noch dichter. "));
  AddDetail( ({ "blaetterdach", "blattwerk" }),
    BS("Hoch ueber Dir bilden die Baeume ein geschlossenes Blaetterdach. Kaum ein Sonnenstrahl bricht bis hier unten durch. "+
    "Nur gruenes Daemmerlicht dringt durch das Blattwerk."));
  AddDetail( ({ "licht", "daemmerlicht" }),
    BS("Wie durch gruenes Milchglas ist hier der Wald in dunkelgruenes Licht getaucht. Das Blaetterdach uber Dir laesst kaum "+
    "einen Sonnenstrahl bis hier unten durch. Trotzdem kann man die Umgebung noch sehr gut erkennen."));
  AddDetail( ({ "aeste", "ast" }),
    BS("Auch ein paar kleine Aeste liegen am Boden. Man sollte nicht drauf treten, da dies bestimmt laute Geraeusche verursacht. "));
  AddDetail( ({ "erde", "untergrund" }),
    BS("Der Waldboden ist festgetrampelt und liefert einen guten Trampelpfad. Der Untergrund federt gut und komfortabel "+
    "nach unter deinen Fuessen. Auf solchen Wegen ist das Wandern eine eine Freude."));
  AddDetail( ({ "waldboden", "erdreich", "stelle" }),
    BS("Ein Stueck neben dem festgetrampelten Pfad kannst Du eine aufgewuehlte Stelle Erdreich entdecken. "+
    "Hier muss wohl vor kurzem erst jemand gegraben haben. Vielleicht hat aber auch nur ein Wildschwein an dieser Stelle nach "+
    "Essbarem in der lockeren Erde gewuehlt."));
  AddDetail( ({ "fuesse", "fuss" }),
    BS("Du stehst mit deinen Fuessen fest auf dem Waldboden. Du kannst nichts besonderes daran entdecken."));
  AddDetail( ({ "wandern" }),
    BS("Durch diesen Wald zu Wandern ist aufgrund des weichen Waldbodens besonders angenehm. Besser als die steinigen, "+
    "harten Strassen."));
  AddDetail( ({ "freude", "ausstrahlung" }),
    BS("Der Wald hat eine angenehme und ruhige Ausstrahlung. "));
  AddDetail( ({ "stein", "steine" }),
    BS("Nur ein paar kleine Steine liegen am Boden. Du kannst nichts besonderes daran erkennen. "));
  AddDetail( ({ "sonnenstrahl", "sonnenstrahlen" }),
    BS("Sonnenstrahlen dringen nicht bis zum Boden durch. Nur diffuses Daemmerlicht herrscht hier"));
  AddDetail( ({ "farn", "farne", "pflanzen" }),
    BS("Die Farne bilden nur einen geringen Teil des Gestruepps. Vorallem Brombeerranken haben sich hier so sehr verwoben, "+
    "dass durch dieses Dickicht kein Durchkommen ist."));
  AddDetail( ({ "brombeer", "ranken", "brombeerranken" }),
    BS("Die Ranken sind ueberall mit Dornen bewehrt. Wie ein natuerliches Geflecht sind die Ranken zusammen gewachsen "+
    "und bilden eine undurchdringliche Pflanzenmauer. Leider sind diese Brombeeren gerade erst am bluehen und werden "+
    "wohl erst in ein paar Wochen Fruechte tragen."));
  AddDetail( ({ "brombeeren", "fruechte" }),
    BS("Die Brombeeren sind noch nicht reif. Die Brombeerranken sind gerade erst erblueht."));
  AddDetail( ({ "durchkommen", "durchbrechen" }),
    BS("Das dornenreiche Gestruepp ist einfach zu dicht. Da kommst Du nicht durch. Du musst wohl weiter dem Weg folgen."));
  AddDetail( ({ "sueden" }),
    BS("Im Sueden wird der Wald immer dichter. Auch glaubst Du dort zwischen den Baeumen Nebelschwaden zu sehen. "+
    "Der Wald kommt Dir in dieser Richtung sehr unheimlich vor."));
  AddDetail( ({ "nebel", "nebelschwaden", "schwaden" }),
    BS("Dort im Sueden glaubst Du zwischen den Baeumen ein paar graue Nebenschwaden gesehen zu haben. Aber "+
    "vielleicht haben Dir ja auch nur deine Augen einen Streich gespielt. "));
  AddDetail( ({ "richtung", "richtungen" }),
    BS("Der Weg fuehrt hier nach Norden durch den Wald oder nach Osten mitten hinein ins dornenbewehrte Dickicht. "));
  AddDetail( ({ "auge", "augen" }),
    BS("Du kommt mit deinen Augen eigentlich klar, oder?"));
  AddDetail( ({ "streich", "streiche" }),
    BS("Ob das wohl wirklich Nebelschwaden waren?"));
  AddDetail( ({ "milchglas" }),
    BS("Truebes glas wird auch Milchglas genannt."));
  AddDetail( ({ "strasse", "strassen" }),
    BS("Die Strasse befindet sich eine gutes Strecke nordwaerts."));
  AddDetail( ({ "dornen", "dorne", "stacheln", "stachel" }),
    BS("Fiese Stacheln wachsen auf den Brombeerranken. Du musst aufpassen damit Du dich nicht verletzst."));
  AddDetail( ({ "glueck" }),
    BS("Zum Glueck war das Noch keine Scriptfalle."));
  AddDetail( ({ "noch" }),
    BS("Nun unter such sie schon die boese Scriptfalle."));
  AddSpecialDetail( ({ "scriptfalle" }), "unt_scriptfalle" );
  AddDetail( ({ "essbares", "proviant" }),
    BS("Du hast hoffentlich genug Proviant dabei."));

  /*
  Essbarem, Nebenschwaden, Stueck, Teil, Wildschwein, Wochen
  AddDetail( ({ "" }),
    BS(""));
  */
  
  AddCmd(({"wuehl", "wuehle"}), "cmd_wuehlen");
  AddCmd(({"tritt", "trete"}), "cmd_treten");
  AddCmd(({"grab", "grabe", "buddel", "buddle"}), "cmd_graben");
  
  AddExit( "norden", AUSGANG1 );
  AddExit( "osten", AUSGANG2 );

}

int cmd_treten(string str)
{
	// auf ast treten erzeugt Knacken in den Nachbar-Raeumen
  if( str!="auf ast" && str!="auf aeste" && str!="ast" && str!="aeste" ) return 0;
  if( !random(10) )
  {
    write("Du trittst auf einen Ast, aber er bricht nicht.\n");
    say(TP->name()+" tritt auf einen Ast.\n");
    return 1;
  }
  write( BS("Du trittst auf einen Ast, er bricht und das laute Knacken unterbricht die Ruhe und hallt durch den Wald.") );
  say( BS(TP->name()+" tritt auf einen Ast und ein lautes Knacken hallt durch den Wald.") );
  call_other(AUSGANG1, "???", 0);
  tell_room( AUSGANG1, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  call_other(AUSGANG2, "???", 0);
  tell_room( AUSGANG2, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  return 1;
}

int cmd_wuehlen(string str)
{
  notify_fail("Worin willst Du wuehlen?\n");
  if( str!="in erde" && str!="erde" && str!="in erdreich" && str!="erdreich" ) return 0;
  write("Du wuehlst ein bischen in der Erde aber Du kannst nichts besonderes entdecken. \n");
  say(BS(TP->name()+" wuehlt in der Erde aber gibt schon nach kurzer Zeit wieder auf."));
  return 1;
}

int cmd_graben(string str)
{
  if( !present("schaufel", TP) ) return 0;
  write(BS("Du graebst an der aufgewuehlten Stelle, aber Du erkennst schnell dass etwas tiefer das Erdreich unberuehrt ist. "+
    "Hier wurde kein Schatz vergraben. Warscheinlich war es nur ein Wildschwein das hier die Erde aufgewuehlt hat.") );
  say(BS(TP->name()+" graebt mit "+TP->QueryPossPronoun(FEMALE, WEM)+" Schaufel ein paar Brocken Erde zur Seite, hoert dann aber auch gleich wieder auf." ));
  return 1;
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 30+random(45), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}