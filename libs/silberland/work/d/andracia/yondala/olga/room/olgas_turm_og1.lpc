#include "../def.h"

inherit "std/room";

#include <properties.h>



void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Erstes Obergeschoss von Olga's Turm" );
  SetProp( P_INT_LONG,
    "Die Wendeltreppe fuehrt nach oben und unten weiter. Die Wendeltreppe selbst hat hier eine etwas groessere "+
	"Plattform und wird mit hoelzernen Waenden vom restlichen Turm abgegrenzt. Eine Holztuer versperrt Dir den "+
	"Zugang zu den Raeumen in diesem Stockwerk. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Von oben dringen gedaempft Geraeusche an Dein Ohr.");
  AddSound( ({ "geraeusch", "geraeusche", "knarzen" }),
    "Scheinbar ist im oberen Stockwerk jemand. Man kann hin und wieder Schritte und gedaempft Stimmen hoeren.");
  AddSound( ({ "schritte", "schritten" }),
    "Man kann hoeren wie jemand im oberen Stockwerk ueber den hoelzernen Boden geht.");
  AddSound( ({ "stimme", "stimmen" }),
    "Leider kann man nicht verstehen was im oberen Stockwerk geredet wird. Auch bist Du nicht sicher um "+
    "wieviele Stimmen es sich handelt.");
  AddSound( ({ "ohr", "innen" }),
    "Wie hoert sich ein Ohr von Innen an? Irgendwie ohrig...");

  AddSmell( DEFAULT_SMELL,
    "Du schnupperst, aber es scheint keinen besonderen Geruch zu geben, dem man folgen koennte.");
  AddSmell( ({ "geruch", "gerueche" }),
    "Du schnupperst aber Dir faellt nichts auf.");

  AddDetail( ({ "boden" }),
    "Die einfache Plattform auf der Du stehst besteht aus einfachen Holzbohlen. ");
  AddDetail( ({ "decke", "unterseite" }),
    "Die Wendeltreppe nimmt nahezu den gesamten Platz dieses kleinen Raums ein. Ueber Dir kann man nur die Unterseite "+
    "der Stufen sehen.");
  AddDetail( ({ "waende" , "wand"}),
    "Rund um die Wendeltreppe sind hoelzerne Waende.");
  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Stufe fuer Stufe fuehrt die Wendeltreppe nach oben und unten weiter.");
  AddDetail( ({ "stufe", "stufen" }),
    "Es sind nur ganz normale hoelzerne Stufen.");
  AddDetail( ({ "plattform" }),
    "Im grunde ist dies Plattform, auf der Du stehst, nichts weiter als eine besonders breite Stufe der Wendeltreppe. "+
    "Eine Tuer unterbicht die hoelzernen Waende und fuehrt wohl zu weiteren Raeumen auf dieser Etage.");
  AddDetail( ({ "turm" }),
    "Du befindest dich hier IM Turm, besser kann man den Turm nicht untersuchen.");
  AddDetail( ({ "tuer", "holztuer", "zugang" }),
    "Die hoelzerne Tuer versperrt Dir den Zugang zu den restlichen Raeumen in dieser Etage. Ein kleines Schild "+
    "wurde an der Tuer angebracht.");
  AddDetail( ({ "raum", "raeume", "platz" }),
    "Du befindest Dich auf einer Plattform der Wendeltreppe. Die Wendeltreppe fuehrt nach oben und unten weiter. "+
    "Die anderen Raeume dieser Etage kann man durch eine hoelzerne Tuer erreichen.");
  AddDetail( ({ "stockwerk", "etage" }),
    "Dies ist die erste Etage des Turms. ");
  AddDetail( ({ "stimme", "stimmen" }),
    "Die Stimmen sind nur dumpf zu hoeren. Du kannst kein Wort verstehen.");
  AddDetail( ({ "schritt", "schritte" }),
    "Jemand scheint in den oberen Stockwerken zu sein. Zumindest hoert sich das Knarzen der Holzbohlen "+
    "ueber Dir so an .");
  AddDetail( ({ "duft", "geruch" }),
    "Hier funktioniert riechen besser.");
  AddDetail( ({ "schild", "handschrift", "schrift", "wort" }),
    "Das Schild, das an der Tuer angebracht ist, wurde mit einer filigranen Handschrift beschriftet. "+
    "Es steht nur ein einziges Wort darauf: PRIVAT.");
  AddReadDetail( ({ "schild", "handschrift", "schrift", "wort" }),
    "##########\n"+
    "# PRIVAT #\n"+
    "##########\n");
  AddDetail( ({ "holz", "holzbohlen" }),
    "Es scheint ganz normales Holz zu sein.");

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddCmd( ({"oeffne"}), "cmd_oeffnen" );
  AddCmd( ({"breche"}), "cmd_brechen");
  
  AddExit( "oben", ROOM+"olgas_turm_og2" );
  AddExit( "unten", ROOM+"olgas_turm_eg");
}

int cmd_oeffnen(string str)
{
// tuer oeffnen
  notify_fail("Was willst Du oeffnen?");
  if( str!="tuer" && str!="tuere" && str!="holztuer" && str!="holztuere" && str!="zugang" ) return 0;
  write(BS("Du versuchst die Tuer zu oeffnen, musst aber feststellen dass Sie fest verschlossen ist."));
  say(BS(TP->Name()+" versucht die Tuer zu oeffnen."));
  return 1;
}

int cmd_brechen(string str)
{
// einbrechen oder tuer aufbrechen
  notify_fail("Was willst du aufbrechen?");
  if( str!="tuer auf" && str!="tuere auf" && str!="holztuer auf" && str!="holztuere auf" && str!="zugang auf" ) return 0;
  write(BS("Du versuchst die Tuer auf zu brechen, musst aber feststellen dass Sie mit einem magischen Schutz versehen ist. "+
    "Ein Blitz tritt aus der Tuer und trifft Dich auf der Brust. "));
  TP->AddHp(-5-random(6)); // 5 bis 10 Schaden
  say(BS(TP->Name()+" bekommt beim dem Versuch, die Tuer auf zu brechen, einen Schlag verpasst."));
  return 1;
}