//Bucheckern clonen rausgenommen, muss man noch den richtigen Pfad angeben
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define AUSGANG1 "/d/andracia/yondala/olga/room/olgas_turm_weg_a1"
#define AUSGANG2 "/d/andracia/yondala/olga/room/olgas_turm_weg_b3"
#define BUCHECKER "/d/andracia/yondala/tal/birkenhain/obj/buchecker.lpc"

int bucheckern;

void reset()
{
  if( bucheckern < 3 ) bucheckern++;
  ::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Trampelpfad" );
  SetProp( P_INT_LONG,
    BS("Der schmale Trampelpfad fuehrt in einer gewundenen Linie durch den Wald. "+
    "Die vielen Baeume verstellen Dir die Sicht auf den weiteren Verlauf des Pfads in Richtung "+
    "Nordwesten. Im Sueden hingegen wird der Wald etwas lichter und man kann den Pfad "+
    "ein gutes Stueck einsehen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Der Wald ist sehr still. Nur hin und wieder hoert man ein paar Voegel zwitschern."));
  AddSound( ({ "wald" }),
    BS("Der Wald ist hier sehr still."));
  AddSound( ({ "knacken" }),
    BS("Jetzt ist gerade alles still, aber es hat sich so angehoert als ob jemand auf einen "+
    "Ast getreten sei."));

  AddSound( ({ "zwitschern", "voegel", "vogel", "geraeusch", "geraeusche", "rufen", "rufe" }),
    BS("Du lauschst ein paar Augenblicke und hoerst den Rufen der Voegel zu. Leider kannst "+
    "Du nicht ausmachen wo sich wohl die Voegel befinden moegen. Hier im Wald ist es einfach "+
    "zu schwer die Richtung eines Geraeuschs zu bestimmen."));
  AddSmell( DEFAULT_SMELL,
    BS("Hier riecht es nach dem Harz der Baeume."));
  AddSmell( ({ "harz", "baeume", "pflanzensaft", "geruch" }),
    BS("Du folgst dem Geruch des Harz und entdeckst am naechsten Baum eine Stelle, an der "+
    "wohl ein Tier die Rinde des Baums abgeschabt hat. Golden fliesst der Pflanzensaft aus der "+
    "Wunde des Baums."));

  AddDetail( ({ "boden" }),
    BS("Der Trampelpfad besteht aus losen Steinen und lockerer Erde. Auch ein paar kleine Aeste "+
    "liegen auf dem Weg. Der weiche Waldboden "+
    "federt unter Deinen Fuessen. Durch diesen Wald zu Wandern ist sehr angenehm. "));
  AddDetail( ({ "himmel" }),
    BS("Durch das Blaetterdach der Baeume hindurch kann man den Himmel kaum noch erkennen."));
  AddDetail( ({ "weg", "pfad", "trampelpfad", "linie", "verlauf", "bereich", "bereiche" }),
    BS("Der Trampelpfad verlaeuft hier von Nordwesten nach Sueden. Im Nordwesten wird "+
    "der Wald lichter und heller, waehrend im Sueden der Wald dunkler erscheint."));
  AddDetail( ({ "wald", "baeume", "laubbaeume" }),
    BS("Die meisten der Baeume, die hier wachsen, sind Laubbaeume. Neben Eichen und Buchen "+
    "siehst Du hier auch Ahorne und Linden. Aber auch ein paar Kiefern und Tannen stehen in "+
    "der Naehe."));
  AddDetail( ({ "eiche", "ahorn", "linde", "kiefer", "tanne", "eichen", "ahorne", "linden", "kiefern", "tannen", "baumsorten" }),
    BS("Dieser Wald besteht aus vielen verschiedenen Baumsorten. Eichen, Ahorne, Buchen, Linden "+
    "und sogar Kiefern und Tannen kannst Du von hier aus sehen."));
  AddDetail( ({ "baum", "buchen", "buche" }),
    BS("Gleich hier am Trampelpfad steht eine Buche. Leider hat wohl ein wildes Tier diesen Baum schwer "+
    "bearbeitet und ein gutes Stueck Rinde abgeschabt. Aus dieser Wunde fliesst noch immer "+
    "zaehfluessiger, goldener Harz und sammelt sich dort in dicken Tropfen."));
  AddDetail( ({ "sicht", "strecke" }),
    BS("Deine Sicht nach allen Seiten ist schon nach kurzer Strecke von verschiedensten Baeumen verstellt. "+
    "nur nach Nordwesten scheint der Wald etwas lichter zu werden. "));
  AddDetail( ({ "nordwesten", "stueck" }),
    BS("Du kannst den Pfad nach Nordwesten ein gutes Stueck einsehen. In diese Richtung scheint der Wald "+
    "etwas lichter zu werden. "));
  AddDetail( ({ "sueden" }),
    BS("Der Pfad fuehrt nach Sueden weiter durch den Wald. Man kann nur wenig vom Weg erkennen, "+
    "da schon nach kurzer Strecke die Baeume die Sicht versperren."));
  AddDetail( ({ "voegel", "vogel" }),
    BS("Du schaust dich um und beobachtest die unteren Bereiche der Baumkronen, kannst aber keinen "+
    "Vogel entdecken. "));
  AddDetail( ({ "augenblick", "augenblicke" }),
    BS("Du versuchst den Augenblick festzuhalten aber die Welt dreht sich einfach weiter."));
  AddDetail( ({ "richtung" }),
    BS("Der Trampelpfad fuehrt nach Sueden und Nordwesten. Bei allen anderen Richtungen wuerdest "+
    "Du den Pfad verlassen und dich warscheinlich hilflos im Wald verirren."));
  AddDetail( ({ "harz", "pflanzensaft" }),
    BS("Das Harz quillt noch langsam aus der frischen Wunde der Buche. Wie dicke, goldene Tropfen "+
    "klebt der Pflanzensaft am Rand der abgeschabten Stelle."));
  AddDetail( ({ "wunde", "rinde", "stelle", "tropfen", "rand" }),
    BS("Diese Stelle hat wohl ein Tier abgeschabt. Vielleicht ein Wildschwein das sich den Ruecken gekratzt "+
    "hat. Da noch immer etwas Harz aus dem Baum quillt, scheint dies erst vor kurzem passiert zu sein. "));
  AddDetail( ({ "waldboden", "erde" }),
    BS("Der weiche Waldboden federt unter deinem Gewicht. Als Du genauer hinschaust erkennst Du dass "+
    "hier viele Bucheckern am Boden liegen. Vielleicht koenntest Du ja welche sammeln."));
  AddDetail( ({ "steine", "stein" }),
    BS("Die kleinen Steine, die hier auf dem Pfad liegen, sind alle unscheinbar und von grauer "+
    "bis weisser Faerbung."));
  AddDetail( ({ "farbe", "faerbung" }),
    BS("Die Farbe der kleinen Steinchen am Boden geht von grau bis weiss."));
  AddDetail( ({ "steinchen" }),
    BS("Das sind einfach nur unscheinbare Steinchen, die am Boden liegen. Du kannst nichts "+
    "besonderes daran entdecken."));
  AddDetail( ({ "blaetterdach", "dach", "baumkrone", "baumkronen" }),
    BS("Die Baeume stehen hier recht dicht und bilden hoch ueber Dir ein geschlossenes "+
    "Blaetterdach. Man kann kaum noch etwas vom Himmel sehen. "));
  AddDetail( ({ "welt", "andracia" }),
    BS("Als ob man die Welt Andracia im Ganzen untersuchen koennte. Schau Dir doch bitte andere Details an."));
  AddDetail( ({ "details", "detail", "schlauberger", "forscherpunkt" }),
    BS("Du Schlauberger - das koennte ein Forscherpunkt gewesen sein. ;)"));
  AddDetail( ({ "tier", "wildschwein" }),
    BS("Ob es wirklich ein Wildschwein war, das den Baum an dieser Stelle abgeschabt hat, "+
    "kannst Du nicht mehr feststellen "));
  AddDetail( ({ "bucheckern" }),
    BS("Die Bucheckern liegen vor Dir auf dem Waldboden. Du koenntest welche sammeln."));
  AddDetail( ({ "gewicht" }),
    BS("Der Waldboden federt unter Deinem Gewicht. "));
  AddDetail( ({ "ruecken", "beschwerden" }),
    BS("Du scheinst gerade keine Beschwerden zu haben."));
  AddDetail( ({ "ast", "aeste" }),
    BS("Ein paar kleine, trockene Aeste liegen auf dem Weg. Wnn man auf einen Ast tritt koennte er ein "+
    "lautes Knacken verursachen."));

  /*
  Fuessen, Ganzen, Naehe, Seiten, Wandern
  AddDetail( ({ "" }),
    BS(""));
  */
  bucheckern=3;
 
  AddCmd(({"tritt", "trete"}), "cmd_treten");
  AddCmd(({"sammel", "sammle", "such", "suche"}), "cmd_sammeln");
  
  AddExit( "nordwesten", AUSGANG1 );
  AddExit( "sueden", AUSGANG2 );

}

int cmd_sammeln(string str)
{
  notify_fail("Was willst Du sammeln?\n");
  if( str!="eckern" && str!="bucheckern" && str!="ecker" && str!="buchecker" ) return 0;
  if( !bucheckern ) 
  {
    write("Du stoeberst ein bischen am Boden aber du findest nur noch die Schalen der Bucheckern.\n");
    say(TP->name()+" sucht etwas am Boden.\n");
  }
  write("Nach kurzer Suche am Boden hebst Du eine Buchecker auf.\n");
  say(TP->name()+" bueckt sich und hebt einen Buchecker auf.\n");
  bucheckern--;
  CLONE( BUCHECKER, TP);
  return 1;
}

int cmd_treten(string str)
{
	// auf ast treten erzeugt Knacken in den Nachbar-Raeumen
  if( str!="auf ast" && str!="auf aeste" && str!="ast" && str!="aeste" ) return 0;
  if( !random(10) )
  {
    write("Du trittst auf einen Ast, aber er bricht nicht.\n");
    say(TP->name()+" tritt auf einen Ast.\n");
    return 1;
  }
  write( BS("Du trittst auf einen Ast, er bricht und das laute Knacken unterbricht die Ruhe und hallt durch den Wald.") );
  say( BS(TP->name()+" tritt auf einen Ast und ein lautes Knacken hallt durch den Wald.") );
  call_other(AUSGANG1, "???", 0);
  tell_room( AUSGANG1, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  call_other(AUSGANG2, "???", 0);
  tell_room( AUSGANG2, "Du hoerst ein lautes Knacken, als ob jemand auf einen Ast getreten sei.\n");
  return 1;
}
