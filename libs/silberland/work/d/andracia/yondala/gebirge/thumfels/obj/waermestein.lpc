/*
  Waermestein als Questitem Zwergequest
  ansonsten nutzlos
*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties
  SetProp( P_SHORT, "Ein Waermestein");
  SetProp( P_LONG, "Ein unscheinbarer grauer Stein. Er fuehlt sich warm an." );
  SetProp( P_INFO, "Ein Waermestein ist sehr selten. Er haelt seine Waerme ueber jahre hinweg.");
  SetProp( P_NAME, "Waermestein");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_STONE );
  SetProp( P_WEIGHT, 150); 
  SetProp( P_NEVERDROP, 1);
  SetProp( P_VALUE, 0); 
  AddId( ({"stein", "waermestein", "\nwaermestein"}) );
}
