#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Im Sueden endet der Stollen an einem grossen Zwergentor."));

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Dieses Reliefbild zeigt eine Gruppe Zwerge die schwerbewaffnet eine "+
    "Drachenhoehle betreten und einen Drachen der dort auf seinem Berg von "+
    "Schaetzen trohnt.") );
  AddDetail( ({ "drachenhoehle", "drachen", "schaetze" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddDetail( ({ "tor", "zwergentor" }),
    BS("Das schwere Tor verschliesst den gesamten Stollen. Welche Gefahren "+
    "auch immer da draussen lauern - diese Tuer wird mit Sicherheit ihnen "+
    "standhalten. Sie befindet sich nur noch wenige Schritte gen Osten"));

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_a6.lpc" );
  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_b5.lpc" );
}

