// Zwergenschenke
#include "../def.h"

inherit "std/pub.lpc";

#include <properties.h>
#include <language.h>
#include <pub.h>

string *liedertext =
  ({ "Ein grosser boeser Troll verstellte meinen Lauf. \n"+
     "Ich haute ihm die Beine weg, da fiel er auf mich drauf. \n"+
     "\n"+
     "Ein grosser boeser Oger blutete mich voll, \n"+
     "und als er starb, benahm er sich genauso wie der Troll. \n"+
     "\n"+
     "Ein grosser boeser Raeuber wollte von mir Geld, \n"+
     "ich wehrte mich und dachte nicht, dass auch der auf mich faellt. \n"+
     "\n"+
     "Ein grosser boeser Yeti stopfte mich ins Eis \n"+
     "Ich macht' ihn kalt, da rutschte er auf mich. Was soll der Scheiss? \n"+
     "\n"+
     "Ein gosser boeser Werwolf biss in meine Loden. \n"+
     "Ich biss zurueck, da rammte er im Sturz mich in den Boden. \n"+
     "\n"+
     "Ein grosser boeser Ries' schwang tueckisch seine Keule. \n"+
     "Die stoerte nicht. Erst als er starb, bekam ich eine Beule. \n",

  	 "Wir suchen das Erz, \n"+
     "im harten Gestein, \n"+
     "wir hacken und haemmern, \n"+
     "tagaus und tagein. \n"+
     "\n"+
     "Ist es gewonnen, \n"+
     "heizen wir ihm ein, \n"+
     "wir kochen und schmelzen, \n"+
     "tagaus und tagein. \n"+
     "\n"+
     "Der Stahl den wir machen, \n"+
     "der ist weltbekannt, \n"+
     "es gibt keinen bessren, \n"+
     "als aus Zwergenhand. \n",

  	 "Gute Nacht, kleiner Zwerg, bald ist Ruhe im Berg - \n"+
     "Traeum' von Silber und Gold, das schoenste Glueck der Welt! \n"+
     "Gute Nacht, kleiner Zwerg, morgen geht's frisch an's Werk, \n"+
     "Mit Deiner Hacke fein, suchst Du auch Edelstein. \n"+
     " \n"+
     "Gute Nacht kleiner Zwerg, die Nacht ist nicht mehr lang. \n"+
     "Mach die Aeuglein zu, dann wird Dir nicht bang', \n"+
     "Wenn in dunkler Nacht der Dunkelzwerg geht ein, \n"+
     "In Deinen Stollen tief, die Edelstein zu klau'n. \n"+
     " \n"+
     "Gute Nacht, kleiner Zwerg, der Stollen ist jetzt leer. \n"+
     "Gold und Edelstein, die gibt's da nicht mehr. \n"+
     "Gute Nacht, kleiner Zwerg, mit Traenen im Gesicht, \n"+
     "Kauf' fuer das Tor ein Schloss, ist die Moral der Geschicht! \n" });
  	 

string sound_lied(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Leider singen die Zwerge in ihrer eigenen Sprache und Du "+
		"verstehst kein einziges Wort.");
	else return	liedertext[random(sizeof(liedertext))];
}

string smell_bier(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Die stickige Luft riecht nach Zwergen und Zwergenbier.");
	else return BS("Welch herrliches Aroma eines heimatlichen Gebraeus dringt an deine Nase.");
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergenschenke" );
  SetProp( P_INT_LONG,
    BS("Hier in der Zwergenschenke kann man zusammen mit den vielen Zwergen "+
    "ausgelassen feiern und dem Zwergenbier froehnen. Eine lange Theke "+
    "erstreckt sich entlang der West- und Suedwand. Hinter dieser Theke sind "+
    "emsig mehrere Zwerge beschaeftigt, zapfen Bier und bedienen die Gaeste. "+
    "Das Bier stammt aus mehreren Faessern die hinter der Theke aufgestellt "+
    "wurden. Der restliche Raum ist mit sehr stabilen Tischen und Baenken "+
    "moebliert - alles natuerlich auf Zwergengroesse zugeschnitten. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "\ntargon");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Targon Hammersack");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddSound( DEFAULT_SOUND,
    BS("Die Schenke ist erfuellt mit dem lauten Geschrei biersaufender Zwerge. Hin und wieder stimmen "+
    "die Zwerge lustige Sauflieder an."));
  AddSound( ({ "zwerg", "zwerge", "geschrei", "schenke", "durcheinander", "gebruell", "stimmen", "wort" }),
    BS("In diesem Durcheinander von Stimmen und Gebruell kannst Du kaum dein eigenes Wort verstehen."));
  AddSound( ({ "lieder", "sauflieder", "lied", "sauflied" }),
    #'sound_lied );
  AddSmell( DEFAULT_SMELL,
    BS("Die stickige Luft ist erfuellt von dem bitteren Geruch von Zwergen und Zwergenbier "));
  AddSmell( ({ "bier", "zwergenbier", "gebraeu" }),
    #'smell_bier );
  AddSmell( ({ "zwerge", "geruch", "luft", "aroma" }),
    BS("Die stickige Luft riecht nach Zwergen und Zwergenbier."));

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus einfachen quadratischen Steinplatten. Verschuettets Bier und "+
    "andere Dinge erzeugen einen ekligen, klebrigen Belag am Boden."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten die Schenke. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Bis auf halber Hoehe wurden die Waende mit Holz vertafelt. Ueberhalb kann "+
    "man nur behauenen Fels erkennen."));
  AddDetail( ({ "zwergenbier", "bier" }),
    BS("Kauf dir doch eins!"));
  AddDetail( ({ "theke" }),
    BS("Die lange Theke erstreckt sich entlang der Sued- und Westwand. Dahinter sind emsig Zwerge damit "+
    "beschaeftigt Bier zu zapfen und den wartenden Zwergen vor der Theke zu bringen. " ));
  AddDetail( ({ "suedwand", "westwand", "sueden", "westen", "breite" }),
    BS("An der Wand selbst stehen mehrere Bierfaesser aus denen staendig von emsigen Zwergen Bier gezapft "+
    "wird. Davor erstreckt sich ueber die ganze Breite der Sued- und Westwand die Theke an denen sich die "+
    "Gaeste ihr Bier abholen."));
  AddDetail( ({ "nordwand", "norden" }),
    BS("Bis auf halber Hoehe wurde die Wand mit Holz vertafelt. Ueberhalb kann "+
    "man nur behauenen Fels erkennen. Ein kleiner Durchgang hier scheint in einen angrenzenden Raum zu fuehren."));
  AddDetail( ({ "ostwand", "osten" }),
    BS("Bis auf halber Hoehe wurde die Wand mit Holz vertafelt. Ueberhalb kann "+
    "man nur behauenen Fels erkennen. Durch eine groessere Tuer kann man hinaus auf die "+
    "Strassen Thumfels. "));
  AddDetail( ({ "gaeste" }),
    BS("Viele Zwerge sind hier, saufen und feiern, aber auch ein paar Haendler lassen es sich gutgehen und "+
    "geniessen das Zwergenbier. "));
  AddDetail( ({ "faesser", "bierfaesser" }),
    BS("Die Faessern hinter der Theke sind mit Zwergenbier gefuellt. Staendig sind emsige Zwerge damit "+
    "beschaeftigt Bier zu zapfen und den durstigen Zwergen an der Theke zu bringen. "));
  AddDetail( ({ "schenke", "raum", "zwergenschenke" }),
    BS("Hier in der Zwergenschenke kann man zusammen mit den vielen Zwergen "+
    "ausgelassen feiern und dem Zwergenbier froehnen. Eine lange Theke "+
    "erstreckt sich entlang der West- und Suedwand. Hinter dieser Theke sind "+
    "emsig mehrere Zwerge bschaeftigt, zapfen Bier und bedienen die Gaeste. "+
    "Das Bier stammt aus mehreren Faessern die hinter der Theke aufgestellt "+
    "wurden. Der restliche Raum ist mit sehr stabilen Tischen und Baenken "+
    "moebliert - alles natuerlich auf Zwergengroesse zugeschnitten. "));
  AddDetail( ({ "tisch", "bank", "tische", "baenke", "moebel", "mobilar" }),
    BS("Das hoelzerne Mobilar aus stabilen Baenken und Tischen ist der Groesse der Zwerge angepasst. "));
  AddDetail( ({ "luft" }),
    BS("Die Luft ist stickig. "));
  AddDetail( ({ "steinplatten", "platten", "stein" }),
    BS("Die steinernen Platten am Boden sind von einem undefinierbaren Belag klebrig. "));
  AddDetail( ({ "dinge", "belag" }),
    BS("Aus was auch immer der klebrige Belag am Boden bestehen mag - du moechtest es wirklich nicht untersuchen."));
  AddDetail( ({ "laterne", "laternen", "ketten", "kette", "licht" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um die Schenke zu beleuchten. "));
  AddDetail( ({ "vertafelung", "holzvertafelung", "atmosphaere", "wandvertafelung" }),
    BS("Die einfache Holzvertafelung gibt der Schenke eine angenehme Atmosphaere, ganz anders als die kalten "+
    "Felswaende die sonst hier in der Zwergenstadt vorherrschen. "));
  AddDetail( ({ "fels", "felsgestein", "gestein", "felswaende" }),
    BS("Es scheint sich um ganz normales Felsgestein zu handeln."));
  AddDetail( ({ "thumfels", "zwergenstadt", "stadt" }),
    BS("Du befindest dich hier in der Schenke von Thumfels. Schau dich ruhig um."));
  AddDetail( ({ "strasse", "zwergenstrasse", "tuer" }),
    BS("Durch die Tuer im Osten kann man hinaus auf die Strassen Thumfels."));
  AddDetail( ({ "groesse", "zwergengroesse" }),
    BS("Theke, Tische und Baenke sind ausgelegt fuer Personen zwergischer Statur."));
  AddDetail( ({ "holz", "kiefernholz" }),
    BS("Theke, Wandvertafelung, Baenke und Tische sind wohl alle aus Kiefernholz. "));
/*
  AddDetail( ({ "" }),
    BS(""));
*/

  /*Ausgaenge*/
  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_f4.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_e3.lpc" );

  /*Menu*/
  AddDrink("Zwergenbier", ({"bier", "zwergenbier"}), 150, 5, 2, 8,
         ({ "Du trinkst Dein Zwergenbier in einem Zug aus.",
            "&& leert in einem Zug ein Bierglas Zwergenbier." }) );
  AddDrink("Rachenputzer", ({"putzer", "rachenputzer"}) , 250, 10, 6, 3,
         ({ "Du trinkst mit Genuss Deinen Rachenputzer.",
            "&& laesst sich einen Rachenputzer schmecken." }) );    
  AddDrink("Feuerschnaps", ({"schnaps", "feuerschnaps"}) , 350, 18, 9, 3,
         ({ "Du kippst Dir ein Glaeschen Kaeferschnaps in den Hals.",
            "&& kippt sich ein Glaeschen Kaeferschnaps in den Hals." }) );    
  AddFood("Eintopf", ({"eintopf"}), 350, 25,
         ({ "Du laesst dir einen leckeren Eintopf schmecken.",
            "&& laesst sich einen leckeren Eintopf schmecken." }) );
  AddFood("Zwergenbrot", ({"zwergenbrot", "brot"}), 120, 5,
         ({ "Du isst eine Scheibe hartes Zwergenbrot.",
            "&& isst eine Scheibe hartes Zwergenbrot." }) );

 /*Objekte und NPCs*/
  AddItem( THUM_NPC + "zw_targon.lpc", REFRESH_DESTRUCT );
  AddItem( THUM_NPC + "zw_gorbul.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );
}

