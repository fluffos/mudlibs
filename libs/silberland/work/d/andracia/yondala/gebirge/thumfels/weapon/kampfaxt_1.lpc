#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine gute Kampfaxt");
  SetProp(P_LONG, "Eine gute Kampfaxt. Sie liegt sehr gut in der Hand. \n" );
  // SetProp(P_INFO, "In einer starken Hand kann dies eine gefaehrliche Waffe sein. ");
  SetProp(P_NAME, "Kampfaxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "kampfaxt"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 85);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 3300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:4]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}

