// Brunnen
// 17.03.2019 Yondala@SilberLand Erstbesichtigung
// Pfade angepasst, Details hinzugefuegt


#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Brunnen" );
  SetProp( P_INT_LONG,
    BS("Dieser kleine Raum beherbergt nur einen einfachen Brunnen. Aus der Wand im "+
    "Sueden ragt ein eisernes Rohr mit einem Drachenkopf am Ende aus dessen Maul "+
    "klares Wasser in ein steinernes Becken darunter fliesst. Dies scheint der "+
    "einzige Brunnen der Stadt zu sein, aber es "+
    "herrscht hier wirklich kein Andrang. Die Zwerge benoetigen scheinbar weniger "+
    "Wasser als die Oberflaechenbewohner. Vielleicht haengt das mit dem geringen "+
    "Wasserbedarf der Zwerge fuer Koerperpflege zusammen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden", "felsboden" }),
    BS("Der Boden besteht aus einfachem, behauenem Fels. Seitlich des "+
    "Brunnenbeckens sind zwei Abfluesse im Boden. Das Becken hat dort etwas "+
    "kuerzere Raender und somit fliesst das ueberschuessige Wasser dort direkt "+
    "vom Becken in den jeweiligen Abfluss. "));
  AddDetail( ({ "decke", "felsdecke", "felsendecke" }),
    BS("An der einfachen Felsdecke wurde eine Laterne befestigt, die den Raum mit "+
    "hellem Kerzenschein erleuchtet. "));
  AddDetail( ({ "waende", "wand", "felswaende", "felswand" }),
    BS("Die Waende bestehen aus normalem, behauenem Fels. Bis auf den Brunnen an "+
    "der Suedwand und den Ausgang in der Nordwand ist nichts besonderes an den "+
    "Waenden zu erkennen."));
  AddSound( DEFAULT_SOUND,
    BS("Das Wasser plaetschert geraeuschvoll vom Eisenrohr so eine Zwergenelle "+
    "tiefer in das steinerne Brunnenbecken. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst hier nichts besonderes riechen."));

  AddDetail( ({ "raum" }),
    BS("Dieser Raum ist schlicht und der einzige Schmuck ist der modellierte "+
    "Drachenkopf der auf dem Ende des Eisenrohrs aufgesetzt wurde. Der Raum "+
    "wird erfuellt vom Plaetschern des Wassers das vom Eisenrohr in das "+
    "steineren Brunnenbecken faellt."));
  AddDetail( ({ "brunnen", "suedwand" }),
    BS("Auf dem aus der Suedwand kommenden Eisenrohr wurde ein modellierter "+
    "Drachenkopf gesteckt. Aus seinem Maul plaetschert nun das Wasser in das "+
    "darunter stehende Brunnenbecken. "));
  AddDetail( ({ "rohr", "eisenrohr", "eisen" }),
    BS("Das Rohr hat auf dem einen Ende einen modellierten Drachenkopf aufgesteckt. "+
    "Das andere Ende verschwindet in der Felswand. Mit dem Rohr wurde wohl eine "+
    "Quelle angezapft da nun aus dem Maul des Drachen klares Wasser plaetschert. "));
  AddDetail( ({ "drachenkopf", "maul", "drache", "drachen" }),
    BS("Der modellierte Drachenkopf scheint auch aus Eisen zubestehen und wurde "+
    "auf dem Ende des Rohr, das in der Suedwand steckt, befestigt. Das Wasser aus "+
    "dem Rohr fliesst nun aus dem Maul des Drachens in das Brunnenbecken darunter. "));
  AddDetail( ({ "becken", "steinbecken", "brunnenbecken" }),
    BS("Das Brunnenbecken faengt das Wasser das aus dem Drachenkopf quillt auf. "+
    "Es besteht aus Stein und hat keine Verzierungen. Seitlich des "+
    "Brunnenbeckens sind zwei Abfluesse im Boden. Das Becken hat dort etwas "+
    "kuerzere Raender und somit fliesst das ueberschuessige Wasser dort direkt "+
    "vom Becken in den jeweiligen Abfluss. "));
  AddDetail( ({ "abfluesse", "abfluss", "loecher" }),
    BS("Das Wasser, das aus dem Brunnenbecken ueber die kuerzere Raender "+
    "abliesst, verschwindet darin. Eigentlich sind es nur schmale Loecher "+
    "im Felsboden. "));
  AddDetail( ({ "rand", "beckenrand", "brunnenrand", "raender", "seiten" }),
    BS("Die seitlichen Raender sind ueberhalb der Abfluesse im Boden etwas "+
    "kuerzer. Dadurch fliesst das ueberschuessige Wasser aus dem Brunnenbecken "+
    "direkt in die Abfluesse. "));
  AddDetail( ({ "stadt", "zwergenstadt", "thumfels", "zwergenreich" }),
    BS("Hier ist nur der Brunnen der Stadt. Wenn Du mehr vom Zwergenreich sehen "+
    "willst, so geh raus und erkunde weiter. "));
  AddDetail( ({ "andrang", "bier" }),
    BS("Hier herrscht kein Andrang - Zwergen haben scheinbar keinen grossen Bedarf "+
    "an Wasser. Zwerge halten sich sowieso mehr an Bier als dass sie normales Wasser "+
    "trinken wuerden. "));
  AddDetail( ({ "wasser", "quellwasser", "quelle" }),
    BS("Das Wasser im Brunnen ist sehr klar. Scheinbar Quellwasser. "));
  AddDetail( ({ "wasserbedarf", "bedarf" }),
    BS("Ein Zwerg braucht Wasser zum Bier brauen. Ansonsten scheint Wasser "+
    "fuer Zwerge keinen besonderen Reiz zu haben. "));
  AddDetail( ({ "koerperpflege" }),
    BS("Du musst selbst wissen wie Du mit Deiner Koerperpflege umgehst ..."));
  AddDetail( ({ "zwerg", "zwerge" }),
    BS("Es ist gerade keiner da."));
  AddDetail( ({ "fels", "stein" }),
    BS("Normaler Fels zu allen Seiten."));
  AddDetail( ({ "ausgang", "nordwand" }),
    BS("Der Ausgang befindet sich in der Nordwand."));
  AddDetail( ({ "ostwand", "westwand" }),
    BS("Diese Wand besteht nur einfachem Fels."));
  AddDetail( ({ "zwergenelle", "laengenmass" }),
    BS("Eine Zwergenelle ist ein etwas ungenaues Laengenmass das man erzeugt "+
    "durch die Strecke dess Ellbogen eines Zwergs bis zu seiner Faust. "));
  AddDetail( ({ "laterne", "kerzenschein", "kerze" }),
    BS("Die Laterne haengt in der Mitte des Raums an der Decke. Es scheint "+
    "sich aber nicht um eine Kerze zu handeln, da das typische Flackern fehlt."));
  AddDetail( ({ "verzierungen", "schmuck" }),
    BS("Das Becken hat keine Verzierungen."));
  AddDetail( ({ "mitte" }),
    BS("In der Mitte des Raumes haengt eine Laterne."));
  AddDetail( ({ "flackern" }),
    BS("Nun, es fehlt."));
  AddDetail( ({ "ellbogen" }),
    BS("Wusstest Du, dass es niemand schafft, seinen eigenen Ellbogen zu kuessen?"));
  AddDetail( ({ "strecke" }),
    BS("Eine Strecke hat einen definierten Anfang und ein definiertes Ende."));
  AddDetail( ({ "anfang" }),
    BS("Aller Anfang ist schwer."));
  AddDetail( ({ "ende" }),
    BS("Du bist noch lange nicht am Ende angekommen, forsche nur weiter!"));
  AddDetail( ({ "faust" }),
    BS("Selten sieht man die Hand eines Zwerges anders als zu einer Faust geballt."));
  AddDetail( ({ "hand" }),
    BS("Du hast zwei davon."));
  AddDetail( ({ "oberflaechenbewohner" }),
    BS("Die Zwerge sind keine Oberflaechenbewohner, da sie UNTER der Oberflaeche wohnen. Zumindest die meisten."));
  AddDetail( ({ "oberflaeche" }),
    BS("du befindest Dich ebenfalls geare darunter."));
  AddDetail( ({ "reiz" }),
    BS("Welchen anderen Reiz sollte es schon haben?"));
  AddDetail( ({ "" }),
    BS(""));
	
	
	
/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddSound( ({ "plaetschern", "wasser" }),
    BS("Das Wasser plaetschert."));

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_d5.lpc" );
}

