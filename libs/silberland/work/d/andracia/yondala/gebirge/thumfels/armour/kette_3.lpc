#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Bronzekette");
  SetProp(P_LONG, "Eine bronzene Kette, ein schoener Schatz!\n" );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kette");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kette", "bronzekette"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_BRONCE ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
