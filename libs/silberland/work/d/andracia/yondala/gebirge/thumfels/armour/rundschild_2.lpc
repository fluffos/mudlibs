#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Rundschild");
  SetProp(P_LONG, BS(
    "Ein normaler Rundschild aus Holz. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Rundschild");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "rundschild" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 14);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1860);
  SetProp(P_VALUE, 2030);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([0:80, DT_FIRE:20]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3, A_DEX:3]) );
}


