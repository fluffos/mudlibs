#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisenpanzer");
  SetProp(P_LONG, BS(
    "Ein normaler Panzer aus Eisen. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenpanzer");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "eisenpanzer" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 24);
  SetProp(P_MATERIAL, ([MAT_LEATHER:5, MAT_IRON:95]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 3300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:7]) );
}


