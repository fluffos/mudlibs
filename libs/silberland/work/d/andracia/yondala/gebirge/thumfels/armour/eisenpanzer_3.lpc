#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Eisenpanzer");
  SetProp(P_LONG, BS(
    "Ein einfacher Panzer aus Eisen. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenpanzer");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "eisenpanzer" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 19);
  SetProp(P_MATERIAL, ([MAT_LEATHER:5, MAT_IRON:95]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 2800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:5]) );
}


