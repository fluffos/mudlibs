#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Hier treffen sich drei Stollen aus Osten, Sueden und Norden und "+
    "bilden eine T-Kreuzung."));

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Das Reliefbild zeigt eine Szene wie ein zwergischer Schmied ein Stueck "+
    "Eisen mit dem Hammer bearbeitet.") );

  AddDetail( ({ "schmied", "eisen", "hammer" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_c2.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_b3.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_b1.lpc" );
}

