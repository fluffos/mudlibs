#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Ueber der offenen Tuer im Westen baumelt ein, an Ketten befestigtes "+
    "Holzschild, an einem eiseren Halter. "));

  AddDetail( ({"tuer"}),
    BS("Die Tuer im Westen steht offen. Ein schlid haengt an einem "+
    "Halter darueber.") );
  AddDetail( ({"schild", "holzschild"}),
    BS("Ein einfaches hoelzernes Schild. Man kann es lesen.") );
  AddDetail( ({"halter", "eisenketten"}),
    BS("Ein einfacher eiserner Halter an dem mit Eisenketten ein "+
    "Schild befestigt ist. "));
  AddReadDetail( ({"schild", "holzschild"}),
    "+-----------------------+\n"+
    "| Waffen und Ruestungen |\n"+
    "+-----------------------+\n" );

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Hier ist im Stein eine Szene zwischen Zwergen und Troglodyten festgehalten. "+
    "Die Troglodyten tauschen in dem Bild gewebte Stoffe gegen Faesser, warscheinlich "+
    "Zwergenbier.") );
  AddDetail( ({ "troglodyten", "stoffe", "faesser", "zwergenbier" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_d4.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_c3.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_d2.lpc" );
}

