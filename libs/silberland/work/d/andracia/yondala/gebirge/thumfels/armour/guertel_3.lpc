#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Guertel");
  SetProp(P_LONG, BS(
    "Ein einfacher Guertel aus Leder mit einer eisernen Schnalle. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Guertel");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "lederguertel" }) );
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:85, MAT_IRON:15]) );
  SetProp(P_WEIGHT, 140);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}


