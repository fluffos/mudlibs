#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein guter Eisenpanzer");
  SetProp(P_LONG, BS(
    "Ein guter Panzer aus Eisen. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  //SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenpanzer");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "eisenpanzer" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 29);
  SetProp(P_MATERIAL, ([MAT_LEATHER:5, MAT_IRON:95]) );
  SetProp(P_WEIGHT, 2300);
  SetProp(P_VALUE, 3800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:9]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}


