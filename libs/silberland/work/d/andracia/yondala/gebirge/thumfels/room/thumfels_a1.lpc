#include "../def.h"

inherit THUM_ROOM + "zwergentor_raw.lpc";

#include <properties.h>

string AUSGANG =  "/d/andracia/yondala/gebirge/hoehlen/room/hoehlen110.lpc";

void init()
{
  ::init();
  if (interactive(this_player()))
  {
    catch(call_other( AUSGANG, "???"));
  }
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Im Osten beginnt die Strasse in die Zwergenstadt. Im Sueden scheint ein "+
    "Wachraum zu sein."));

  AddDetail( ({ "wachraum" }), 
    BS("Der Wachraum liegt im Sueden.") );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_b1.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_a2.lpc" );
  
  AddItem( THUM_NPC+"zw_torwache_a1.lpc", REFRESH_DESTRUCT );
  AddCmd( "verlasse" , "cmd_exit" );
}

int cmd_exit(string str)
{
	notify_fail("Was willst Du tun?\n");
	if( str!="thumfels" && str !="stadt" && str!="zwergenstadt" ) return 0;
	write("Dieser Weg steht noch nicht bereit.\nErinnere Yondala gerne daran.\n");
	/*write( "Du verlaesst die Zwergenstadt und hinter Dir faellt das Tor wieder zu. \n");
	say( BS(TP->name()+" verlaesst die Zwergenstadt durch das Tor. "));
	TP->move( AUSGANG , M_GO);*/
	return 1;
}