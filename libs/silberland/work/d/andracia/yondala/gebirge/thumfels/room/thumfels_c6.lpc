// Sohle des Foerderschachts
#include "../def.h"

inherit "std/room";

#include <properties.h>

string BEREICH = "/d/" REGION "/" MAGIERNAME "/";

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Sohle des Foerderschachts" );
  SetProp( P_INT_LONG,
    BS("Das hier ist das untere Ende des Foerderschachts der hoch zur "+
    "Oberflaeche fuehrt. Du kannst hier mit dem Foerderkorb zurueck zur Oberflaeche. "+
    "Wenn man den langen Schacht hochschaut kann man ein sehr kleines Stueck Himmel "+
    "erkennen. \nBEFOERDERUNG NACH OBEN IST NOCH UNTERBUNDEN. YONDALA."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Sobald sich der Foerderkorb bewegt kann man ein leichtes Rumpeln vernehmen, "+
    "denn immer wieder stoesst der Foerderkorb gegen die Waende des Schachts. "));
  AddSmell( DEFAULT_SMELL,
    BS("Die Gerueche von der Oberwelt dringen hier nur selten vor. Es herrscht hier "+
    "mehr der Geruch von Erz, Eisen und Zwergen."));
  AddSound( ({ "rumpeln", "foerderkorb" }),
    BS("Immer wenn der Foerderkorb gegen die Waende des Schacht prallt, hoert "+
    "man dieses Rumpeln durch den Schacht hallen. Hin und wieder loest sich dadurch "+
    "auch ein Gesteinsbrocken aus den Schachtwaenden und schlaegt hier mit einem "+
    "lauten Schlag an der Sohle des Foerderschachts auf. "));
  AddSound( ({ "schlag" }),
    BS("Hin und wieder faellt ein Gesteinsbrocken, der durch den Foerderkorb aus "+
    "der Schachtwand geloest wurde, den Schacht herunter und kommt mit einem lauten"+
    "Schlag hier an der Sohle des Schachts auf. "));
  AddSmell( ({ "oberwelt", "oberflaeche" }),
    BS("Hier riecht es nur nach der stickigen Luft der Unterwelt. Neben dem Staub "+
    "kann man hier auch den typische Geruch von Zwergen riechen. "));
  AddSmell( ({ "erz", "eisen", "unterwelt", "zwerge", "staub", "duft", "luft", "note", "geruch", "gerueche"}),
    BS("Der Duft der Unterwelt besteht vorallem aus Staub, Erz und Eisen. Aber "+
    "auch die Zwerge geben hier der Luft noch zusaezlich ihre peroenliche Note hinzu."));

  AddDetail( ({ "boden", "felsboden" }),
    BS("Ein paar kleine, lose Felsbrocken liegen hier am Ende des Schachts. "+
    "Warscheinlich haben diese sich aus der Wand des Schachts geloest. Ansonsten "+
    "steht man hier auf dem blanken Fels. Viele Spuren verraten wo der Foerderkorb "+
    "immer aufsetzt, der Fels vor dieser Stelle ist sehr ausgetreten. "));
  AddDetail( ({ "decke", "waende", "wand", "felswaende", "felsdecke", "felswand" }),
    BS("Die groben Felswaende und die hohe Felsdecke bilden rund um den Foerderschacht "+
    "eine kleine Halle, wo man auf die Ankunft des Foerderkorbs warten kann. Es wurden "+
    "mehrere Laternen hier aufgehaengt, da das Licht des Foerderschachts nicht "+
    "ausreicht diesen Raum zu erhellen. "));

  AddDetail( ({ "ende", "halle", "raum", "sohle", "ankunft" }),
    BS("Die kleine Halle ist die Sohle des Foerderschachts. Der Foerderkorb startet "+
    "von hier seinen Weg nach oben. Die Stelle an der der Korb aufsetzt ist deutlich "+
    "an den Kratzspuren zu erkennen. Direkt davor ist der Fels vom Ausladen und "+
    "Einladen stark ausgetreten. Laternen haengen an der Decke und erleuchten den "+
    "Raum. Hoch oben am oberen Ende des Schachts kann man ein ganz kleines Stueck "+
    "blauen Himmel erahnen.  "));
  AddDetail( ({ "foerderkorb", "korb" }),
    BS("Der Foerderkorb ist scheinbar staendig auf dem Weg herauf und herunter "+
    "um Zwerge und Waren zu transportieren. "));
  AddDetail( ({ "zwerge", "personen", "reisende" }),
    BS("Zwerge und Reisende, die Thumfels besuchen wollen, nutzen diesen "+
    "Foerderschacht und reisen mit dem Foerderkorb von der Oberflaeche hier "+
    "herunter und koennen auf dem gleichen Weg die Zwergenstadt auch wieder verlassen."));
  AddDetail( ({ "waren", "lebensmittel", "einladen", "ausladen" }),
    BS("Mit dem Foerderkorb werden viele Waren in die Zwergenstadt hinunter "+
    "gebracht. Vorallem Lebensmittel werden hinab zu den Zwergen geliefert. "));
  AddDetail( ({ "foerderschacht", "schacht", "weg" }),
    BS("Senkrecht nach oben fuehrt dieser lange Stollen. Der Foerderkorb faehrt "+
    "darin auf und nieder und bringt Personen und Waren von und zur Oberflaeche. "+
    "Man kann ein ganz kleines Stueck Himmel erahnen wenn man hinaufschaut. Dies "+
    "ist der einzige direkte Weg von Thumfels hinauf zur Oberflaeche. Hin und wieder "+
    "rumpelt der Foerderkorb gegen die Waende des Schachts, dabei loesen sich "+
    "Gesteinsbrocken die hier unten dann aufschlagen, sei also vorsichtig. "));
  AddDetail( ({ "stollen", "thumfels", "stadt", "zwergenstadt", "zwergenstollen" }),
    BS("Hier unten fuehren die Stollen durch die Zwergenstadt Thumfels. Diese "+
    "Stollen fuehren auch weiter in die Unterwelt hinab. Sicher gibt es dort auch "+
    "weitere Ein- und Ausstiege zur Oberflaeche, aber diese sind viel weiter entfernt "+
    "als dieser mit einem Foerderkorb befahrene Schacht."));
  AddDetail( ({ "gesteinsbrocken", "felsbrocken", "brocken", "stein", "steine", "steinbrocken" }),
    BS("Wenn der Foerderkorb gegen die Waende des Schachts rumpelt, koennen "+
    "sich Felsbrocken loesen die dann den Schacht entlang hinabstuerzen. Daher ist "+
    "der Aufenthalt hier an der Sohle des Foerderschachts etwas gefaehrlich, da so "+
    "ein fallender Stein einem ungeschuetztem Kopf eine boese Beule beibringen kann. "+
    "Auch sind die vom Aufschlag umherfliegenden Felssplitter eine Gefahr fuer "+
    "ungeschuetzte Augen."));
  AddDetail( ({ "aufenthalt" }),
    BS("Hier an der Sohle des Schachts ist der Aufenthalt etwas gefaehrlich. "+
    "Herabfallende Felsbrocken koennten Dir auf den Kopf fallen wenn man unter dem "+
    "Schacht steht. Aber die Gefahr von herumfliegenden Felssplittern die beim "+
    "Aufschlag solcher Steine entstehen ist noch groesser."));
  AddDetail( ({ "kopf", "beule" }),
    BS("Du stellst Dich besser nicht direkt unter den Schacht. Herabfallende Steine "+
    "koennten Dir eine Beule beibringen. Noch ist Dein Kopf unversehrt - und so soll "+
    "es doch auch bleiben, oder?"));
  AddDetail( ({ "splitter", "felssplitter" }),
    BS("Vor den umherfliegende Splittern herabfallender Steine muss man sich "+
    "vorsehen. Hoffentlich fliegt Dir keiner ins Auge solange Du Dich hier aufhaelst."));
  AddDetail( ({ "oberflaeche", "oberwelt" }),
    BS("Mit dem Foerderkorb kann man nach oben zur Oberflaeche reisen. Dies ist der "+
    "einzige direkte Weg nach oben. Allzu komfortabel ist dies Moeglichkeit zwar "+
    "nicht aber die Alternative waere der beschwerliche Weg durch die Stollen "+
    "der Unterwelt."));
  AddDetail( ({ "moeglichkeiten", "alternativen" }),
    BS("Du hast sehr viele ... Welche nutzt Du?"));
  AddDetail( ({ "moeglichkeit", "alternative" }),
    BS("Du hast mehr als eine ... Welche nutzt Du?"));
  AddDetail( ({ "himmel" }),
    BS("Das klitzekleine Stueck Himmel das man von hier aus sehen kann ist nicht "+
    "wirklich zum anschauen geeignet. Wnn man sich an der Oberflaeche befindet geht "+
    "das viel besser."));
  AddDetail( ({ "fels", "gestein", "felsgestein", "material", "erde" }),
    BS("Waende, Decke und Boden bestehen aus einfachem Felsgestein. Das Innere "+
    "eines Berges besteht im allgemeinen immer aus diesem Material."));
  AddDetail( ({ "spuren", "kratzspuren" }),
    BS("Am Boden sind deutlich Spuren des Foerderkorb zu sehen. Man kann "+
    "genau ausmachen wo er immer aufsetzt. Direkt davor ist der Felsboden "+
    "sehr ausgetreten, warscheinlich von den Zwergen die die Waren des "+
    "Foerderkorbs ausladen."));
  AddDetail( ({ "laterne", "laternen", "bergbaulaterne", "bergbaulaternen",
                "zwergenlaterne", "zwergenlaternen", "licht",
                "zwergenbergbaulaterne", "zwergenbergbaulaternen", "fackel",
                "flackern", "feuer", "lichtquelle", "kerzen", "kerze" }),
    BS("Die Laternen an der Decke leuchten die kleine Halle, die die Sohle "+
    "des Foerderschachts bildet, gut aus. Es scheinen besondere Zwergenbergbaulaternen "+
    "mit einer besonderen Lichtquelle zu sein. Leider kann man nicht erkennen um "+
    "was fuer eine Lichtquelle es sich handelt. Da aber kein fuer Kerzen und "+
    "Fackeln typisches Flackern zu sehen ist,  muss es sich um eine anderes "+
    "geartete Lichtquelle wie Feuer handeln."));
  AddDetail( ({ "innere", "unterwelt", "hoehlen", "hoehlenwelt" }),
    BS("Dieser Berg beinhaltet nicht nur die Stollen der Zwergenstadt, auch "+
    "viele weitere zum groessten Teil natuerliche Hoehlen durch ziehen den Berg. Es "+
    "soll sogar ganze Reiche unter der Erde geben. Viele der Stollen und Hoehlen "+
    "sind noch immer unerforscht, aber die Zwerge sind unermuedlich und erkunden "+
    "immer tiefer gelegene Gebiete dieser Unterwelt. "));
  AddDetail( ({ "aufschlag", "stelle", "gefahr" }),
    BS("Hin und wieder schlagen hier unten an der Sohle des Schachts Steinbrocken auf. "+
    "Pass lieber auf dass Du nicht von einem erschlagen wirst. "));
  AddDetail( ({ "schachtwand", "schachtwaende" }),
    BS("Grober Fels bildet die Schachtwaende. Die Zwerge haben sich große Muehe gegeben "+
    "diesen Schacht senkrecht in den Berg zu treiben."));
  AddDetail( ({ "berg", "berge", "gebirge", "reiche", "gebiete" }),
    BS("Du befindest Dich hier tief im Berg."));
  AddDetail( ({ "einstieg", "einstiege", "ausstieg", "ausstiege" }),
    BS("Hier kann man mit dem Foerderkorb die Zwergenstollen verlassen und hinauf an "+
    "die Oberflaeche reisen."));
  AddDetail( ({ "yondala" }),
    BS("Teile Yondala mit: Wann kann man endlich zur Oberstadt?"));
  AddDetail( ({ "" }),
    BS(""));
  AddDetail( ({ "" }),
    BS(""));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddRoomMessage( ({ BS("Ein losgeloester Steinbrocken schlaegt mit einem lauten "+
                     "Schlag auf dem Boden auf."),
                     "","","","","" }),
                  25,"brocken_hit" );
  AddItem( THUM_NPC+"zwergenarbeiter_unten.lpc", REFRESH_DESTRUCT );
  AddItem( THUM_NPC+"zwergenarbeiter_unten.lpc", REFRESH_DESTRUCT );
  AddItem( THUM_NPC+"zwergenarbeiter_unten.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_c5.lpc" );

  catch(call_other( BEREICH+"oberstadt/room/serpweg_i5.lpc", "???"));
  // sicherstellen dass auch der Raum mit Foerderkorb geladen ist.
}

void brocken_hit(int mess)
{
  object ob;
  if(mess!=0) return;
  for(ob=first_inventory(TO);ob;ob=next_inventory(ob)) {
    if(interactive(ob) && random(20)==0) {
      tell_room(TO, BS("Ein herumfliegender Gesteinssplitter hat "+ob->name()+
      " getroffen und einen blutigen Striemen hinterlassen.") ,({ob}));
      ob->do_damage(1,"ein Gesteinssplitter");
      tell_object(ob,BS("Du wurdest von einem herumfliegenden Gesteinssplitter "+
      "getroffen und diese Stelle zeigt nun einen leicht blutigen Striemen.") ); 
    }
  }
}
