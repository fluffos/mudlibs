#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine einfache Kriegsaxt");
  SetProp(P_LONG, BS(
    "Eine einfache Kriegsaxt mit einer schweren scharfen Klinge. Gut geignet fuer grosse Baeume. ") );
  // SetProp(P_INFO, "Kleine Kaefer kann man damit bestimmt leicht bezwingen.");
  SetProp(P_NAME, "Kriegsaxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "kriegsaxt"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 85);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 2700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 105);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:3]) );
}

