#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(20); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"torwache", "wache", "\ntorwache" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Eine Torwache");
  SetProp( P_LONG, BS("Dieser stark geruestete Zwerg bewacht das Tor. "));
  SetProp( P_GENDER, FEMALE);
  // SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Torwache");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_a6.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_a6.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Torwache"); //string fuer Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Die Torwache bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"tor"}), 
    "Die Tore Thumfels' lassen sich nur von innen oeffnen. Wenn ihr die Stadt verlassen wollt so tut dies einfach. "+
    "Um wieder hereingelassen zu werden, muesst ihr mich einfach um Einlass bitten. ", "sagt: ");
  AddInfo( ({"ausgang", "tuer"}), 
    "Die Tuer laesst sich nur von innen oeffnen. Ihr koennt gerne die Stadt durch diese Tuer verlassen wenn ihr wollt. "+
    "Um wieder hereingelassen zu werden, muesst ihr mich einfach um Einlass bitten. ", "sagt: ");
  AddInfo( ({"einlass"}), 
    "Ihr seid doch schon in der Stadt!", "sagt: ");

  //Ausruestung
  /* SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( "Pfad/datei" );
  command("zuecke waffe");
  CLONEME( "Pfad/datei" );
  command("trage alles");*/
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(8) == 0)
  {
    tell_room(ENV(TO), TO->Name()+" ruft laut: \"Aufwachen Kamaraden - Die Torwache benoetigt HILFE!\" .\n");
    walk_mapping(ENV(TO)->QueryProp(P_EXITS), "ruf_kamaraden", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_kamaraden(string richtung, string strpfad)
{
  object pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
    call_other(pfad,"request_guards");
  return;
}
//wenn angegriffen dann zwei wachen aus dem Wachraum rufen.
