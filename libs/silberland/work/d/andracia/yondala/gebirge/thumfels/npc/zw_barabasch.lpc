#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"barabasch", "haendler", "\nbarabasch" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Barabasch, ein Zwergenhaendler");
  SetProp( P_LONG, BS("Dies ist Barabasch, ein Haendler. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Barabasch");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_c3.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_c3.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Zwergenhaendler"); //string fuer Todessequenz
 
  //Chats
  SetChats( 1, ({
  	BS("Barabasch ruft: Hier gibts die Besten Waffen weit und breit."),
  	BS("Barabasch sagt: Bei Ruestungen sind nur Massanfertigungen besser als mein Angebot."),
  	BS("Barabasch rueckt eine Ruestung zurecht."),
  	BS("Barabasch poliert ein Schwert."),
  	BS("Barabasch ruft: Meine Ruestungen sind guenstig und preiswert.") }) ); //rate in %
  SetAttackChats( 5, ({
  	BS("Barabasch bruellt: Dir werd ichs zeigen!"),
  	BS("Barabasch sagt: Meine Axt wird Dir den Kopf vom Rumpf trennen."),
  	BS("Barabasch ruft: Du Unhold, stirb endlich.") }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( THUM_WEAPON+"kampfaxt_2.lpc" );
  command("zuecke waffe");
  CLONEME( THUM_ARMOUR+"eisenpanzer_2.lpc" );
  CLONEME( THUM_ARMOUR+"guertel_2.lpc" );
  command("trage alles");

}
