#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisenring");
  SetProp(P_LONG, "Ein normaler eiserner Ring." );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenring");
  SetProp(P_NAME_ADJ, "eisern");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "eisenring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_IRON ]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 3900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
