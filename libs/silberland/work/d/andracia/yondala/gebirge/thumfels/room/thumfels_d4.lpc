#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("offene Tueren und sonstige Merkmale"));*/

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("In diesem steinernen Bild wurde ein Zwerg verewigt der wohl eine "+
    "mechanische Erfindung gemacht hat. Im Bild haelt er einen kastenfoermigen "+
    "Gegenstand in die Hoehe der aus Zahnraedern, und komischen Metallstangen "+
    "zu bestehen scheint. ") );
  AddDetail( ({ "erfindung", "gegenstand", "zahnraeder", "metallstangen" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_d5.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_d3.lpc" );

  AddItem( THUM_NPC + "zw_thilas.lpc", REFRESH_DESTRUCT );
}

