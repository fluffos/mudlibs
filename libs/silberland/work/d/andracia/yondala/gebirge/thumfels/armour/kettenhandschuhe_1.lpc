#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gutes Paar Kettenhandschuhe");
  SetProp(P_LONG, BS(
    "Ein gutes Paar Kettenhandschuhe aus Eisen. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kettenhandschuhe");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handschuhe", "kettenhandschuhe" }) );
  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:6, MAT_IRON:94]) );
  SetProp(P_WEIGHT, 640);
  SetProp(P_VALUE, 1900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:4, A_DEX:3]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}


