#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

//Gehoert zur Tauschquest. Hat das Herz und will einen Freibrief bei den Menschen
inherit THUM_NPC+"zwerg_raw";

//#define GHERZ "/d/wasser/yondala/pirateninsel/obj/goldherz.lpc"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Durc, der zwergische Dieb");
  SetProp(P_LONG,
    "Du siehst einen kleine, schmutzigen Zwerg vor Dir. Er traegt nur Lumpen und hat offenbar Laeuse "
    "denn er kratzt sich staendig am ganzen Koerper. Pass auf, dass er Dich nicht bestiehlt.");
  SetProp(P_NAME, "Durc");
  SetProp(P_NAME_ADJ, "zwergisch");
  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "dieb", "zwergendieb", "durc"}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit dreckigen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, -275);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "stiehlt sich herein");
  SetProp(P_MSGOUT, "stiehlt sich");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein zwergischer Dieb");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name()+" will Deine wertlosen Sachen nicht haben.\n" }) );


  AddInfo(DEFAULT_INFO, "sagt: Das geht Euch nicht an.\n");
  AddInfo( ({"broud","hildgunde"}),
    "Kenn ich nicht, ist mir auch egal.",
    "sagt: ");
  AddInfo( ({"herz"}),
    "Ohja, ein schoenes Goldherz hab ich wohl. Wollt Ihr es etwa? Ich wuerde es Euch sogar "
    "ueberlassen, wenn Ihr mir dafuer etwas fuer mich tut. Was haltet Ihr von einem Geschaeft?",
    "fragt: ");
  AddInfo( ({"geschaeft"}),
    "Nun, ich bin durch gewisse Taten bei den Menschen in Ungnade gefallen, daher sind die "
    "Soldaten von Edorian hinter mir her. Erwirkt bei ihm einen Freibrief fuer mich, so ist das "
    "Herz Euer.",
    "sagt: ");
  AddInfo( ({"freibrief"}),
    "Der Freibrief gestattet es mir das Reich der Menschen wieder zu betreten. Fragt ihn nach "
    "\"Freibrief fuer Durc\", er weiss schon wer ich bin. Aber er muss den Freibrief unbedingt "
    "unterschreiben, sonst ist er fuer mich wertlos. Vergesst das nicht!",
    "sagt: ");
  AddInfo( ({"menschen"}),
    "Bei den Menschen kann ich mich zur Zeit nicht blicken lassen.",
    "sagt: ");
  AddInfo( ({"unterschrift"}),
    "Die Unterschrift ist verdammt wichtig!",
    "sagt: ");
  AddInfo( ({"taten","tat", "reiche", "arme"}),
    "Ich nehme den Reichen und gebe den Armen. Naemlich mir. Das scheint den Menschen nicht "
    "zu gefallen.",
    "sagt: ");

  SetChats(3, ({
    "Der diebische Zwerg schaetzt, ob es lohnt Dich zu ueberfallen.\n",
    "Der diebische Zwerg sucht ein Opfer.\n",
    "Durc kratzt sich am Ohr.\n",

    }) );

  //Ausruestung
  SUID;
  CLONEME( THUM_ARMOUR + "guertel_3.lpc" );
  CLONEME( THUM_ARMOUR + "eisenstiefel_3.lpc" );
  CLONEME( THUM_ARMOUR + "eisenpanzer_3.lpc" );
  command("trage alles");
  CLONEME( THUM_WEAPON + "kampfaxt_3.lpc" );
  command("zuecke axt");
 

}

give_notify(object ob)
 {
 	if(ob->id("\nfreibriefunterschrieben"))
 		{
 			command("sag Ah, habt Dank!");
 			command("sag Hier nun wie abgemacht das goldene Herz.");
			write("Der Zwerg gibt Dir ein goldenes Herz.\n");
			say("Der Zwerg gibt "+TPN+ " ein goldenes Herz.\n",TP);
			ob->remove();
 			CLONE( "/d/andracia/yondala/wasser/pirateninsel/obj/goldherz.lpc" , TP);
 		}
	else if(ob->id("\nfreibrief"))
 		{
 			command("sag WAS SOLL ICH DENN DAMIT?!");
 			command("sag Da ist keine Unterschrift drauf, der Wisch ist voellig wertlos!");
			say("Der Zwerg zerreisst wuetend das Pergament.\n");
			ob->remove();
  		}
   else
     {             
       command("sag Was soll ich damit?");
			 write("Der Zwerg gibt Dir "+ob->name(WEN)+" zurueck.\n");
			 say("Der Zwerg gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
       ob->move(TP, M_GET);
      }
    }