// 12.10.2022 - Yondala@SilberLand: Autoload deaktiviert, Article auf 0, ID "schienen" gegeben

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gutes Paar Eisenarmschienen");
  SetProp(P_LONG, BS(
    "Ein gutes Paar Armschienen aus Eisen. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenarmschienen");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armschienen", "eisenarmschienen", "schienen" }) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 780);
  SetProp(P_VALUE, 1600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:4]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}


