// Schmiede
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergenschmiede" );
  SetProp( P_INT_LONG,
    BS("Die Hitze, die in dieser Schmiede herrscht, schlaegt Dir entgegen. "+
    "In der Mitte des Raums steht die Esse die das Eisen zum Gluehen bringen soll. "+
    "Mit einem grossen Blasebalg kann man die Esse anheizen. Ein Haufen Kohle liegt "+
    "in einer Ecke des Raums bereit um als Nachschub an Glut in der Esse zu dienen. "+
    "Eine lange Werkbank mit vielen verschiedenen Zangen und Haemmern nimmt die "+
    "gesamte Westwand in Beschlag. Zwei Faesser mit Wasser und ein rechteckiges "+
    "Becken mit Oel sind neben dem Zwergenamboss aufgestellt. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    BS("Eine dunkle Schicht Russ und Staub bedeckt den Boden. Viele Stiefelabdruecke "+
    "kann man darin erkennen."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist schwarz vom Russ. Eine dreckige Laterne taucht zusammen mit "+
    "der Esse die Schmiede in ein schummriges Licht. " ));
  AddDetail( ({ "waende", "wand" }),
    BS("Alle Waende sind schwarz von Russ. An der gesamten Westwand erstreckt sich "+
    "eine lange Werkbank mit vielen Haemmern und Zangen."));
  AddSound( DEFAULT_SOUND,
    BS("Die Glut in der Esse knistert leise. "));
  AddSmell( DEFAULT_SMELL,
    BS("Der viele Russ und das heisse Eisen das hier verarbeitet wird erzeugt einen "+
    "fuer eine Schmiede typischen Geruch. "));

  AddDetail( ({ "raum", "schmiede" }),
    BS("In der Mitte des Raums steht die Esse die das Eisen zum Gluehen bringen soll. "+
    "Mit einem grossen Blasebalg kann man die Esse anheizen. Ein Haufen Kohle liegt "+
    "in einer Ecke des Raums bereit um als Nachschub an Glut in der Esse zu dienen. "+
    "Eine lange Werkbank mit vielen verschiedenen Zangen und Haemmern nimmt die "+
    "gesamte Westwand in Beschlag. Zwei Faesser mit Wasser und ein rechteckiges "+
    "Becken mit Oel sind neben dem Zwergenamboss aufgestellt."));
  AddDetail( ({ "hitze", "stimmung" }),
    BS("Die Esse hat den ganzen Raum augeheizt. Hier ist es um einiges waermer "+
    "als im Rest der unterirdischen Zwergenstadt. "));
  AddDetail( ({ "esse", "glut", "gluehen" }),
    BS("Rotgluehende Kohle liegt in einem Haufen in der Esse. Die Esse strahlt eine "+
    "immense Hitze aus und hat den Raum stark erwaermt. "));
  AddDetail( ({ "eisen" }),
    BS("Hier kann man Eisen formen zu Ruestungen, Waffen und Werkzeugen. Frag einfach "+
    "den Schmied nach seinem Angebot."));
  AddDetail( ({ "blasebalg" }),
    BS("Mit diesem grossen Blasebalg kann man durch ein eisernes Rohr Luft in die "+
    "Esse blasen und damit die Glut anheizen. Du laesst lieber die Finger davon, "+
    "der Schmied muss selbst wissen wie heiss die Glut sein muss. "));
  AddDetail( ({ "haufen", "kohle", "nachschub" }),
    BS("Die Glut in der Esse ist in ausreichender Menge vorhanden. Man muss gerade "+
    "keine Kohle aus dem Haufen in der Ecke nachlegen. "));
  AddDetail( ({ "ecke" }),
    BS("In der Ecke liegt ein Haufen Kohle der wohl als Nachschub fuer die Glut in "+
    "der Esse dienen soll. "));
  AddDetail( ({ "werkbank", "westwand" }),
    BS("Die lange Werkbank nimmt die gesamte Westwand ein. viele verschiedene Haemmer "+
    "und Zangen liegen darauf bereit. "));
  AddDetail( ({ "werkzeug", "haemmer", "hammer", "zangen", "zange" }),
    BS("Viele Haemmer und Zangen liegen auf der langen Werkbank an der Westwand bereit. "+
    "Diese Werkzeug beoetigt der Schmied um Waffen, Ruestungen und Werkzeuge zu "+
    "schmieden. Frag ihn einfach nach seinem Angebot. "));
  AddDetail( ({ "faesser", "fass", "wasser" }),
    BS("In den beiden Faessern neben dem Amboss ist normales Wasser. Es dient "+
    "warscheinlich dazu heisses Eisen abzuschrecken. Daher willst Du es lieber "+
    "nicht trinken. "));
  AddDetail( ({ "becken", "oel" }),
    BS("Das Becken gleich neben dem Amboss ist mit einem Oel gefuellt. Es dient "+
    "wohl auch zum abschrecken des heissen Eisens, dabei wird das Eisen aber nicht "+
    "so rapide abgekuehlt wie im Wasser."));
  AddDetail( ({ "amboss", "zwergenamboss", "form" }),
    BS("Auf dem Zwergenamboss kann der Schmied mit dem Hammer dem Eisen die richtige "+
    "Form geben. Er hat genau die richtige Hoehe fuer einen zwergischen Schmied. "));
  AddDetail( ({ "russ", "staub", "russschicht", "staubschicht", "ueberzug", "schicht" }),
    BS("Der ganze Raum strotzt vor Russ. Ueberall im Raum liegt eine dunkele Schicht "+
    "Russ, selbst Waende und Decke haben diesen schwarzen Ueberzug. Auch die Laterne "+
    "an der Decke erzeugt durch den Russ nur wenig Licht im Raum. "));
  AddDetail( ({ "stiefelabdruecke", "abdruecke" }),
    BS("In der Staubschicht am Boden kann man sehr viele Stiefelabdruecke erkennen. "+
    "Der Schmied scheint geschaeftig hin und her zu laufen bei seiner Arbeit. Die "+
    "restlichen Abdruecke stammen wohl von so Kunden wie Dich. "));
  AddDetail( ({ "laterne" }),
    BS("Die Laterne an der Decke ist auch mit einer kleinen Schicht Russ bedeckt. "+
    "Nur wenig schummriges Licht erhellt den Raum. Die Esse selbst erzeugt auch "+
    "ein rotes Licht."));
  AddDetail( ({ "licht", "beleuchtung" }),
    BS("Durch die Esse und die schmutzige Laterne wird der Raum in schummriges "+
    "Licht getaucht. Bei dieser Beleuchtung kann man zwar alles hier im Raum "+
    "erkennen, aber es herrscht dadurch auch eine duestere Stimmung."));
  AddDetail( ({ "stadt", "zwergenstadt", "thumfels" }),
    BS("Du befindest dich doch schon mitten in der Zwergenstadt Thumfels."));
  AddDetail( ({ "luft" }),
    BS("Bis auf den Russ der in der Luft zuhaengen scheint ist es ganz normale Luft."));
  AddDetail( ({ "finger" }),
    BS("Das ist dein Finger. Du kannst nichts besonderes daran erkennen. "));

  AddSound( ({ "glut", "esse", "gluehen" }),
    BS("Die Glut in der Esse knistert leise."));
  AddSmell( ({ "russ", "eisen", "schmiede", "geruch" }),
    BS("Hier herrscht der typische Geruch einer Schmiede: Russ, heisses Eisen "+
    "und der Schweiss des fleissigen Schmieds. "));
  AddSmell( ({ "schweiss", "schmied" }),
    BS("Man riecht es dass er fleissig war ..."));

  AddDetail( ({ "angebot", "dienstleistungen", "dienste", "ruestungen", "waffen" }),
    BS("Frag doch den Schmied nach seinen Dienstleistungen."));
  AddDetail( ({ "arbeit", "beschlag" }),
    BS("Der Schmied kann einiges - frag ihn doch einfach nach seinem Angebot."));
  AddDetail( ({ "rohr", "eisenrohr" }),
    BS("Es ist nur ein normales Eisenrohr."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddItem( THUM_NPC+"zw_schmied.lpc", REFRESH_DESTRUCT);

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_c2.lpc" );
}

