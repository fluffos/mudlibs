#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein guter Topfhelm");
  SetProp(P_LONG, BS(
    "Ein guter Helm aus Eisen. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Topfhelm");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "lederhelm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, ([MAT_LEATHER:10, MAT_IRON:80]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:6]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}


