// Laden fuer Waffen und Ruestungen
#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Laden fuer Waffen und Ruestungen" );
  SetProp( P_INT_LONG,
    BS("Dieser Laden handelt ausschliesslich mit Waffen und Ruestungen. "+
    "Alle Regale liegen voll mit den verschiedensten Waffen aus alles Gegenden "+
    "Andracias. Neben Schwertern und Aexten sind auch Morgensterne, "+
    "Saebel und eine grosse Auswahl an Dolchen zu finden. Desweiteren kann man hier "+
    "in einem weiteren Bereich des Ladens Schmuck und einfache Kleidung erstehen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );
  // Props fuer shops
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\nbarabasch");
  SetProp(P_SHOPKEEPER_NAME, "Barabasch");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SPECIAL_SHOP, ([
    P_WC: "Nur Waffen, Ruestungen, Schmuck und Kleidung werden hier gehandelt. \n",
    P_AC: "Nur Waffen, Ruestungen, Schmuck und Kleidung werden hier gehandelt. \n" ]) );
  SetStorageRoom(THUM_ROOM+"storage_c3.lpc");
  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus normalem Fels und ist sehr sauber. Scheinbar "+
    "achtet Barabasch darauf einen besonders sauberen Laden zu haben. " ));
  AddDetail( ({ "decke" }),
    BS("Die Decke besteht aus normalem Fels. Mehrere Laternen wurden an der Decke "+
    "befestigt und leuchten den Laden sehr gut aus. "));
  AddDetail( ({ "waende", "wand" }),
    BS("An allen Waenden stehen Regale die mit Waffen, Ruestungen und anderem Zeug "+
    "vollbeladen sind. "));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nicht besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nicht besonderes riechen."));

  AddDetail( ({ "waffen" }),
    BS("Viele verschiedene Waffen kann man hier in den Regalen sehen. Frag doch "+
    "Barabasch nach seinen Angeboten. "));
  AddDetail( ({ "ruestungen" }),
    BS("Viele verschiedene Ruestungen kann man hier in den Regalen sehen. Frag doch "+
    "Barabasch nach seinen Angeboten."));
  AddDetail( ({ "laden", "raum", "bereich", "raeume" }),
    BS("Dieser Laden ist sehr sauber und auf den Waffen und Ruestungen in den Regalen "+
    "liegt kaum Staub. In einem weiteren Bereich des Ladens kann man Schmuck erstehen. "));
  AddDetail( ({ "regal", "regale" }),
    BS("An allen Waenden stehen mit Waffen, Ruestungen und anderem Zeug "+
    "vollbeladene Regale. "));
  AddDetail( ({ "gegend", "zwergenstadt", "stadt", "thumfels" }),
    BS("Du befindest dich in der Zwergenstadt Thumfels. Schau dich um - es gibt viel "+
    "zu sehen hier. "));
  AddDetail( ({ "schwerter", "schwert", "aexte", "axt", "waren", "zeug",
                "morgensterne", "morgenstern", "saebel", "dolche", "dolch" }),
    BS("Es gibt hier ein reichhaltiges Angebot an Waffen. Neben Schwertern und Aexten "+
    "sind auch Morgensterne, Saebel und eine grosse Auswahl an Dolchen zu finden. "+
    "Frag doch Barabasch nach seinen Angeboten."));
  AddDetail( ({ "schmuck", "kleidung" }),
    BS("In einem weiteren Bereich des Ladens kann man Schmuck und einfache Kleidung "+
    "erstehen. Frag doch Barabasch nach seinen Angeboten. "));
  AddDetail( ({ "fels" }),
    BS("Die Raeume der Zwergenstadt sind direkt in den harten Fels gemeisselt. "));
  AddDetail( ({ "laternen", "laterne" }),
    BS("Die Laternen, die an der Decke befestigt sind, erleuchten den Raum. "));
  AddDetail( ({ "staub", "sauberkeit" }),
    BS("Nur wenig Staub liegt auf den Waren und am Boden. Barabasch, der diesen "+
    "Laden betreibt scheint auf Sauberkeit bedacht - eine Eigenschaft die nur selten "+
    "bei Zwergen festzustellen ist. "));
  AddDetail( ({ "angebot", "auswahl" }),
    BS("Mit 'zeige' kannst Du Dir von Barabasch das Angebot zeigen lassen.") );
  AddDetail( ({ "barabasch", "haendler" }),
    BS("Der Haendler scheint nicht da zu sein.") );
  AddDetail( ({ "zwergenstadt", "thumfels" }),
    BS("Du befindest dich mitten in der Zwergenstadt Thumfels.") );

/*
  AddDetail( ({ "" }),
    BS("") );
*/

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_d3.lpc" );

  AddItem( THUM_NPC+"zw_barabasch.lpc", REFRESH_DESTRUCT );
}

