#include "../def.h"

inherit THUM_ROOM + "zwergentor_raw.lpc";

#include <properties.h>

string AUSGANG =  "/d/andracia/yondala/gebirge/hoehlen/room/hoehlen001.lpc";

void init()
{
  ::init();
  if (interactive(this_player()))
  {
    catch(call_other( AUSGANG, "???"));
  }
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Im Norden beginnt die Strasse in die Zwergenstadt. Im Osten scheint ein "+
    "Wachraum zu sein."));

  AddDetail( ({ "wachraum" }), 
    BS("Der Wachraum liegt im Osten.") );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_b6.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_a5.lpc" );

  AddItem( THUM_NPC+"zw_torwache_a6.lpc", REFRESH_DESTRUCT );
  AddCmd( "verlasse" , "cmd_exit" );
}

int cmd_exit(string str)
{
	notify_fail("Was willst Du tun?\n");
	if( str!="thumfels" && str !="stadt" && str!="zwergenstadt" ) return 0;
	//write(break_string("Das erlaubt Yondala an dieser Stelle noch nicht. Du solltest sie darauf ansprechen.\n"));
	bswrite("Das erlaubt Yondala an dieser Stelle noch nicht. Du solltest sie darauf ansprechen.\n");
	
	
	/*write( "Du verlaesst die Zwergenstadt und hinter Dir faellt das Tor wieder zu. \n");
	say( BS(TP->name()+" verlaesst die Zwergenstadt durch das Tor.\n"));
	TP->move( AUSGANG , M_GO);*/
	return 1;
}