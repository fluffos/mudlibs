#include "../def.h"

inherit "std/room";

#include <properties.h>

int get_guards;

void reset()
{
	get_guards=1;
	::reset();
}

void create() 
{
  ::create();

  get_guards=1;
  SetProp( P_INT_SHORT, "Wachraum" );
  SetProp( P_INT_LONG,
    BS("In diesem Wachraum sind die Waechter, die das Tor zu bewachen haben, "+
    "untergebracht. Neben einem Tisch und zwei einfachen Stuehlen sind noch "+
    "zwei Betten und ein Schrank untergebracht. Ein Waffengestell mit Aexten "+
    "steht gleich neben dem Ausgang. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    BS("Man kann die Geraeusche der Strasse gedaempft hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Hier riecht es sehr nach Zwergen."));
  AddSound( ({ "strasse", "geraeusch", "geraeusche" }),
    BS("man kann hier die Geraeusche der Strasse nur gedaempft vernehmen. ") );
  AddSmell( ({ "luft" }),
    BS("Die Luft riecht sehr nach Zwerg. "));
  AddSmell( ({ "zwerge", "zwerg" }),
    BS("Hier riecht es eindeutig nach Zwergen: ungewaschene Baerte, "+
    "verkleckertes Zwergenbier, durchschwitzte Kettenhemden."));

  AddDetail( ({ "boden" }),
    BS("Du stehst auf ganz normalen Fels."));
  AddDetail( ({ "decke" }),
    BS("An der Decke ist eine Laterne angebracht. Ansonsten besteht die Decke nur "+
    "aus einfachem Fels."));
  AddDetail( ({ "waende", "wand", "erde" }),
    BS("Die Waende bestehen auf normalen Fels. Ein Schrank steht an einer der Waende."));
  AddDetail( ({ "wachraum", "raum" }),
    BS("In diesem Wachraum halten sich die Torwachen auf wenn sie auf der Strasse "+
    "oder am Tor gerade nicht gebraucht werden. Ein Tisch und zwei einfache Stuehle "+
    "stehen in der Mitte des Raums. Zwei Betten und ein Schrank stehen an den Waenden, "+
    "sowie ein Waffengestell gleich neben dem Ausgang zum Tor. "));
  AddDetail( ({ "tor" , "zwergentor"}),
    BS("Sobald man diesen Wachraum verlaesst steht man vor dem grossen Zwergentor das "+
    "die Zwergenstadt gegen die Gefahren, die in den Stollen der Unterwelt hausen, "+
    "abschirmt."));
  AddDetail( ({ "tisch", "stuhl", "stuehle" }),
    BS("Ein einfacher Tisch an dem zwei Stuehle stehen. Hier werden die Wachen "+
    "waehrend ihrer Wache sitzen, ihre Verpflegung verspeisen und sich anderweitig "+
    "beschaeftigen solange niemand ihre Dienste benoetigt. "));
  AddSpecialDetail( ({ "bett", "betten" }),
    "check_guards");
  AddDetail( ({ "schrank", "kleider", "ruestungen" }),
    BS("Im Schrank sind wohl die Kleider und Ruestungen der Wachen untergebracht."));
  AddDetail( ({ "waffengestell", "gestell" }),
    BS("Griffbereit sind viele Aexte im Gestell bereitgelegt. Da die Wachen aber "+
    "ihre eigenen Aexte am Guertel tragen, sind diese wohl nur fuer den Alarmfall "+
    "wenn alle Zwerge der Stadt zu den Waffen gerufen werden. " ));
  AddDetail( ({ "axt", "aexte", "waffen" }),
    BS("Im Gestell gleich neben dem Ausgang sind viele Aexte bereitgelegt. Im "+
    "Alarmfall werden die zu den Waffen gerufenen Zwerge hier noch ausgeruestet."));
  AddDetail( ({ "ausgang", "stollen" }),
    BS("Durch den einzigen Ausgang kommt man wieder direkt vor das Zwergentor, "+
    "das die Zwergenstadt gegen die Gefahren der Stollen ausserhalb abschirmt. "));
  AddDetail( ({ "fels", "felsen" }),
    BS("Dieser Wachraum wurde direkt aus dem Fels gehauen wie fast alles hier "+
    "in der Zwergenstadt. "));
  AddDetail( ({ "laterne" }),
    BS("Direkt unterhalb der niedrigen Decke ist eine Laterne aufgehaengt, die "+
    "den Raum gut ausleuchtet. "));
  AddDetail( ({ "alarmfall" }),
    BS("Du hast noch keinen erlebt.") );
  AddDetail( ({ "baerte" }),
    BS("Das lassen die Zwerge leider nicht zu.") );
  AddDetail( ({ "taverne", "tavernen", "rausch", "umtrunk", "zwergenbier" }),
    BS("Hier gibt es bestimmt mehr als nur eine Taverne in der sich die Zwerge "+
    "einen Rausch ansaufen koennen. ") );
  AddDetail( ({ "thumfels", "stadt", "zwergenstadt", "rande" }),
    BS("Du befindest Dich am Rande der Zwergenstadt Thumfels. "));
  AddDetail( ({ "wache", "wachen", "waechter", "torwachen" }),
    BS("Hier sind die Wachen untergebracht. ") );
  AddDetail( ({ "unterwelt", "gefahren", "abenteuer" }),
    BS("Tief unter der Erde hier bei den Zwergen gibt es bestimmt noch Abenteuer. ") );
  AddDetail( ({ "verpflegung", "essen" }),
    BS("Die Zwerge moegen deftiges Essen. In der Taverne kann man sicher davon kosten.") );


/*
  AddDetail( ({ "" }),
    BS("") );
*/

}

string check_guards()
{
  if( get_guards ) return "Zwei Wachen liegen in den Betten und schlafen. \n";
  else return "Die zerwuehlten Betten sind leer. \n";
}

void request_guards()
{
	if( get_guards ) {
		AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_NONE );
		AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_NONE );
		get_guards = 0;
	}
	return;
}
		