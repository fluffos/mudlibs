#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("offene Tueren und sonstige Merkmale"));*/

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen", "kampfszene" }),
    BS("In diesem Reliefbild ist eine grosse Kampfszene zwischen einer Schar "+
    "Zwerge und einer Gruppe Elfen dargestellt. Die Elfen haben dabei entstellte "+
    "Fratzen die sie wie Monster erscheinen lassen.") );

  AddDetail( ({ "elfen", "fratzen", "monster" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_b2.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_b4.lpc" );

  AddItem( THUM_NPC + "zw_grobal.lpc", REFRESH_DESTRUCT );
}

