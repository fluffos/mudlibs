// Erzlager
#include "../def.h"

inherit "std/room";

#include <properties.h>

string smell_erz(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes am Erz riechen.");
	else return	BS("Das scheint gutes Eisenerz mit ein bischen Feldspat zu sein.");
}

string unt_erz(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes am Erz erkennen.");
	else return	BS("Eindeutig gutes Eisenerz mit ein bischen Feldspat.");
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Erzlager" );
  SetProp( P_INT_LONG,
     BS("Das ist wohl das Erzlager der Zwerge. Hinter einem Lattenzaun befindet sich ein riesiger "+
     "Haufen Erzbrocken der bis fast unter die hohe Decke reicht. Im Norden kann man das obere Station "+
     "einer Lorenbahn sehen. Im Sueden befindet sich in Sichtweite die grossen Kohlelager der Zwerge. Durch die "+
     "Tuer im Westen kommt man wohl auf die Strassen Thumfels. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );

  AddSmell( ({ "erz", "eisenerz", "feldspat" }),
    #'smell_erz );
  AddDetail( ({ "erz", "eisenerz", "erzbrocken" }),
    #'unt_erz );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst hier nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach Erz. "));

  AddDetail( ({ "boden" }),
    BS("Ganz normaler Fels bildet den Boden. Eine dunkle Staubschicht bedeckt den Fels an Stellen "+
    "an denen nur selten jemand seinen Fuss stellt. Ansonsten liegen nur ein paar kleine Erzbrocken "+
    "herum."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten das Erzlager. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Ganz normaler Fels bildet die Waende. "));

  AddDetail( ({ "raum", "erzlager", "lager", "bereich" }),
    BS("Das ist wohl das Erzlager der Zwerge. Hinter einem Lattenzaun tuermt sich ein Berg von Erzbrocken "+
    "bis fast unter die Decke. Nur wenige Brocken liegen auf dem Boden ausserhalb des umzaeunten Bereichs. "));
  AddDetail( ({ "lattenzaun", "latten", "holz", "zaun" }),
    BS("Der hoelzerne Lattenzaun grenzt den begehbaren Bereich gegen den Berg Erzbrocken ab. "+
    "Ein kleines Tor im Lattenzaun dient wohl dazu Erz aus dem Lager zu holen oder neues Erz "+
    "hinein zubringen."));
  AddDetail( ({ "tor" }),
    BS("Das kleine Tor im Lattenzaun dient wohl dazu Erz aus dem Lager zu holen oder neues Erz "+
    "hinein zubringen."));    
  AddDetail( ({ "haufen", "berg" }),
    BS("Der grosse Berg Erzbrocken tuermt sich hinter dem Lattenzaun bis fast an die Decke."));
  AddDetail( ({ "norden", "station", "lorenbahn", "bahn", "lore" }),
    BS("Im Norden kannst Du die obere Station einer Lorenbahn erkennen. "+
    "Dort scheint auch alles mit Laternen ausgeleuchtet zu sein."));
  AddDetail( ({ "staub", "staubschicht", "schicht", "foerdern", "geschaeft" }),
    BS("Das Foerdern von Erz scheint ein besonders staubiges Geschaeft zu sein."));
  AddDetail( ({ "gesteinsbrocken", "brocken" }),
    BS("Am Boden liegen mehrere kleine Erzbrocken herum."));
  AddDetail( ({ "sichtweite" }),
    BS("Du kannst von hier aus die Kohlelager im Sueden und die Lorenbahn im Norden sehen. "+
    "Dort scheint auch alles mit Laternen ausgeleuchtet zu sein."));
  AddDetail( ({ "sueden", "lager", "kohlelager" }),
    BS("Im Sueden befinden sich die Kohlelager der Zwerge. "+
    "Dort scheint auch alles mit Laternen ausgeleuchtet zu sein."));
  AddDetail( ({ "westen", "tuer" }),
    BS("Durch die Tuer im Westen kommt man wohl auf die Strassen von Thumfels"));
  AddDetail( ({ "strassen", "thumfels", "teil", "zwergenstadt", "stadt" }),
    BS("Das hier ist ein Teil der Zwergenstadt Thumfels. Die Strassen, die durch die unterirdische Stadt der "+
    "Zwerge fuehren befinden sich wohl hinter der Tuer im Westen. "));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um das Erzlager zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Nur ganz normaler Fels."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_g3.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_g5.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_f4.lpc" );
}

