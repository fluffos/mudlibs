inherit "std/thing";

#include <moving.h>
#include <properties.h>
#include "../def.h"

int qstatus=0; 

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Zwergequestitem");
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ARTICLE, 0);

  AddId("\nzwergequest");
}

int QueryStatus()
{
	return qstatus;
}

void SetStatus(int flag)
{
	if( flag ) qstatus=1;
}