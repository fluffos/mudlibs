#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Ueber der offenen Tuer im Sueden baumelt ein, an Ketten befestigtes "+
    "Holzschild, an einem eiseren Halter. "));

  AddDetail( ({"tuer"}),
    BS("Die Tuer im Sueden steht offen. Ein schlid haengt an einem "+
    "Halter darueber.") );
  AddDetail( ({"schild", "holzschild"}),
    BS("Ein einfaches hoelzernes Schild. Man kann es lesen.") );
  AddDetail( ({"halter", "eisenketten"}),
    BS("Ein einfacher eiserner Halter an dem mit Eisenketten ein "+
    "Schild befestigt ist. "));
  AddReadDetail( ({"schild", "holzschild"}),
    "+-----------+\n"+
    "| Giesserei |\n"+
    "+-----------+\n" );

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen", "schulszene" }),
    BS("Dieses Reliefbild zeigt einen greisen Zwerg mit Gehstock der vor vielen "+
    "anderen Zwergen eine Rede oder aehnliches haelt. Vielleicht eine Schulszene. ") );
  AddDetail( ({ "gehstock", "rede" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_f5.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_d5.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_e6.lpc" );
}

