#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"gorbul" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Gorbul, ein heruntergekommener Zwerg");
  SetProp( P_LONG, 
    BS("Gorbul ist eine jaemmerliche Gestalt. Er hat einen verfilzten Bart und stinkt besonders schlimm. "+
    "Man sieht ihm seine Probleme an und die Alkoholfahne die er verstroemt laesst darauf schliessen dass "+
    "er mehr trinkt als er sollte. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Gorbul");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_e4.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_e4.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Gorbul, der Saeufer"); //string fuer Todessequenz
 
  //Chats
  SetChats( 1, ({
  	BS("Gorbul kratzt sich im Bart."),
  	BS("Gorbul trinkt sein Bier und bestellt ein Neues."), 
  	BS("Man sieht Gorbul sofort an dass er ein jaemmerlicher Saeufer ist."),
  	BS("Gorbul sagt: Los, noch ein Bier. ") }) ); //rate in %
  SetAttackChats( 5, ({
  	BS("Gorbul bruellt: Dir werde ichs zeigen!"),
  	BS("Gorbul sagt: Noch bin ich nicht tot."),
  	BS("Gorbul schimpft: Nicht mal in Ruhe saufen kann man hier!") }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"waermestein"}), 
    "Ich hatte letztens noch einen Waermestein aber den musste ich beim Hauptmann lassen. Er hat dafuer meine Zeche "+
    "bezahlt und dafuer gesorgt dass ich nicht aus der Stadt geworfen werde. Zum Glueck hab ich so einen guten Bruder.", "sagt: ");
  AddInfo( ({"thilas", "zwergenhauptmann"}), 
    "Thilas, der Zwergenhauptmann ist mein Bruder, er hilft mir immer aus der Patsche wenn ich mal wieder Bloedsinn "+
    "gemacht habe. Aber er weiss gar nicht wie schwer die Arbeit in den Stollen ist.", "sagt: ");
  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( THUM_WEAPON+"kampfaxt_3.lpc" );
  command("zuecke waffe");
  CLONEME( THUM_ARMOUR+"eisenpanzer_3.lpc" );
  CLONEME( THUM_ARMOUR+"kettenhose_3.lpc" );
  command("trage alles");
}
