#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Der Stollen hat hier einen rechtwinkligen Knick von Norden nach Westen. "+
    "Ueber der offenen Tuer im Norden baumelt ein, an Ketten befestigtes "+
    "Holzschild, an einem eiseren Halter. "+
    "Durch einen offenen Durchgang kann man hier nach Osten in ein grosses "+
    "Kohlelager gelangen. "));

  AddDetail( ({"tuer"}),
    BS("Die Tuer im Sueden steht offen. Ein schlid haengt an einem "+
    "Halter darueber.") );
  AddDetail( ({"schild", "holzschild"}),
    BS("Ein einfaches hoelzernes Schild. Man kann es lesen.") );
  AddDetail( ({"halter", "eisenketten"}),
    BS("Ein einfacher eiserner Halter an dem mit Eisenketten ein "+
    "Schild befestigt ist. "));
  AddReadDetail( ({"schild", "holzschild"}),
    "+----------+\n"+
    "| Hochofen |\n"+
    "+----------+\n" );

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Dieses Reliefbild zeigt eine Schar Zwerge in einer Taverne. Alle mit sind "+
    "mit einem grossen Humpen in der Hand dargestellt und die fein gemeisselten "+
    "Gesichter der Zwerge spiegeln die ausgelassene Stimmung wider. ") );
  AddDetail( ({ "humpen", "stimmung" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_g5.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_e5.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_f4.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_f6.lpc" );
}

