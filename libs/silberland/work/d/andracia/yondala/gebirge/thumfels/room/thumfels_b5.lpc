#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Hier treffen sich drei Stollen aus Norden, Osten und Westen und "+
    "bilden eine T-Kreuzung."));

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Das Bild in den Felsen zeigt einen Zwerg der eine Axt an einem Schleifstein "+
    "schaerft. ") );
  AddDetail( ({ "axt", "schleifstein" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_b4.lpc" );
  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_c5.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_a5.lpc" );
}

