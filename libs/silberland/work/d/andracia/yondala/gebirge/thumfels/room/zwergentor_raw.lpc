#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergentor" );
  SetProp( P_INT_LONG,
    BS("Du stehst hier an einem Zwergentor das die Zwergenstadt gegen die "+
    "Stollen ausserhalb absperrt. Das Muster des Bodens endet hier und auch die "+
    "Waende sind hier nur noch glatt bearbeitet ohne besondere Steinmetzarbeiten. "+
    "Eine letzte Laterne haengt hier noch kurz vor dem Tor und beleuchtet das Ende "+
    "der Strasse der Zwergenstadt."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst das geschaeftige Treiben der Zwerge. Trinklieder aus den Tavernen, "+
    "brummige Zwergenstimmen in angeregter Unterhaltung und das Geraeusch schwerer "+
    "Stiefel die auf der Strasse gehen. Desweiteren scheinen sich im Wachraum ein "+
    "paar Zwergenwachen sich zu unterhalten. "));
  AddSound( ({ "trinklieder", "lieder", "texte", "texten" }),
    BS("Aus der fernen Taverne dringen von Zwergen gesungene Trinklieder bis an "+
    "Dein Ohr. Um den Texten zu lauschen solltest Du dich auch zum Umtrunk in "+
    "die Taverne begeben. "));
  AddSound( ({ "stimme", "stimmen", "unterhaltung", "unterhaltungen", 
               "zwerge", "zwerg", "gespraech", "gespraeche", "belang",
               "zwergenwachen", "zwergenwache", "wachen", "wache", "zwergenstimmen" }),
    BS("Du kannst leider nicht verstehen was die Zwerge miteinander reden, "+
    "warscheinlich sind die Gespraeche der Zwerge und Wachen eh nicht von "+
    "Belang fuer einen Reisenden. "));
  AddSound( ({ "stiefel", "strasse", "klacken", "geraeusch" }),
    BS("Die schweren Stiefel vorbeigehender Zwerge geben ein lautes klacken auf den "+
    "Steinplatten des Bodens wieder. "));
  AddSound( ({ "treiben", "stadt", "zwergenstadt", "thumfels" }),
    BS("Klackende Stiefel, redende Zwerge, Trinklieder aus einer Taverne - die "+
    "Geraeusche einer Zwergenstadt. "));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier etwas muffig und nach Zwerge. "));
  AddSmell( ({ "luft" }),
    BS("Die Luft scheint hier doch etwas muffig, aber das scheint die Zwerge nicht "+
    "zu stoeren. "));
  AddSmell( ({ "zwerge", "zwerg" }),
    BS("Hier riecht es eindeutig auch nach Zwergen: ungewaschene Baerte, "+
    "verkleckertes Zwergenbier, durchschwitzte Kettenhemden."));

  AddDetail( ({ "boden" , "strasse", "ende"}),
    BS("Die Steinplatten, die ein kompliziertes Muster bilden enden hier "+
    "kurz vor dem Tor. Danach ist ein Stueck blanker Fels bis zum Tor zu sehen."));
  AddDetail( ({ "decke" }),
    BS("An der hohen Decke haengt eine letzte Laterne an einer Kette kurz vor dem "+
    "Zwergentor herunter und spendet dem Ende der Strasse Licht."));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende sind glatt bearbeitet, aber besonders kunstvolle "+
    "Steinmetzarbeiten wie ein Stueck die Strasse weiter sind hier nicht zu sehen. "));
  AddDetail( ({ "tor", "zwergentor", "einlass" }),
    BS("Das schwere Tor verschliesst den gesamten Stollen. Eine kleine Tuer ist "
    "darin eingearbeitet und in der Tuer ist ein verschliessbares Guckloch "+
    "auf Zwergenaugenhoehe. Die Tuer haengt in riesigen Scharniere die seitlich "+
    "der Tuer im Fels verankert ist. Imposante Stahlverstaerkungen halten die "+
    "Tuer aus riesigen Balken eines speziellen Holzes zusammen. Welche Gefahren "+
    "auch immer da draussen lauern - diese Tuer wird mit Sicherheit ihnen "+
    "standhalten. "));
  AddDetail( ({ "tuer" }),
    BS("Im Zwergentor ist eine Tuer eingebettet. Personen koennen also, ohne dass "+
    "das grosse Tor geoeffnet wird, die Stadt durch diese Tuer betreten oder "+
    "verlassen. " ));
  AddDetail( ({ "guckloch" }),
    BS("Durch das Guckloch in der Tuer kann eine Zwergenwache wohl nachschauen wer "+
    "vom Stollen Einlass begehrt. "));
  AddDetail( ({ "scharnier", "scharniere" }),
    BS("Riesige Scharniere halten das Tor. Nur Zwergenschmiede sind wohl zu solch "+
    "einer Meisterleistung der Metallverarbeitung faehig. "));
  AddDetail( ({ "verstaerkung", "verstaerkungen", 
                "stahlverstaerkung", "stahlverstaerkungen" }),
    BS("Diese Verstaerkungen halten das Tor zusammen. "));
  AddDetail( ({ "balken", "holz", "spezielles Holz", "maserung" }),
    BS("Das Tor scheint aus einem ganz speziellen Holz zu sein. Es ist besonders "+
    "dunkel und die Maserung ist besonders fein."));
  AddDetail( ({ "gefahr", "gefahren", "sicherheit", "hoehlen", "hoehle" }),
    BS("Egal welche Gefahren in den Stollen ausserhalb der Stadt hausen, dieses Tor "+
    "haelt sie draussen. Du fuehlst Dich hier sehr sicher. "));
  AddDetail( ({ "zwergenstadt", "stadt", "thumfels" }),
    BS("Hier beginnt die Zwergenstadt Thumfels. Hinter dem Tor lauern Gefahren und "+
    "unbekannte Hoehlen. "));
  AddDetail( ({ "stollen", "stollen" }),
    BS("Der Stollen wird vom grossen Zwergentor komplett verschlossen. Vielleicht "+
    "laesst dich ja eine der Wachen durch die Tuer nach draussen damit Du dich "+
    "dort als Hoehlenforscher betaetigen kannst. "));
  AddDetail( ({ "muster", "steinplatten", "steinplatte" }),
    BS("Die Muster der Steinplatten am Boden kann man ein Stueck die Strasse weiter "+
    "besser betrachten. "));
  AddDetail( ({ "steinmetzarbeiten", "kunst", "meisterleistung" }),
    BS("Ein Stueck die Strasse weiter kann man die kunstvollen Steinmetzarbeiten "+
    "naeher bewundern. "));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laterne, die an einer langen Kette von der Decke haengt, liefert "+
    "ausreichend Licht um das Zwergentor zu beleuchten. "));
  AddDetail( ({ "fels", "felsen" }),
    BS("Ganz normaler Fels. "));
  AddDetail( ({ "baerte" }),
    BS("Das lassen die Zwerge leider nicht zu.") );
  AddDetail( ({ "taverne", "tavernen", "rausch", "umtrunk", "zwergenbier" }),
    BS("Hier gibt es bestimmt mehr als nur eine Taverne in der sich die Zwerge "+
    "einen Rausch ansaufen koennen. ") );
  AddDetail( ({ "metallverarbeitung", "zwergenschmiede", "erz", "eisen", "ansprechpartner" }),
    BS("Wenns um Erz und Eisen geht sind die Zwerge der richtige Ansprechpartner.") );

/*
  AddDetail( ({ "" }),
    BS("") );
*/
}

