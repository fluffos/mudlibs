// Zwergenhauptmann Thilas, hat einen Waermestein.

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

string qwaermestein()
{
	object ob;
	if( !present("\nzwergequest", TP) )
		return "Ich habe einen Waermestein, er hat meinem Bruder nur Unglueck gebarcht.";
	if( !present("\nwaermestein", TP) )
	{
		ob=clone_object(THUM_OBJ+"waermestein.lpc");
		ob->move(TP, M_NOCHECK);
		return "Ihr wollt einen Waermestein? Hier habt ihr den meines Bruders. Er hat ihm nur Unglueck gebracht, vielleicht "+
		  "findet ihr ja fuer dieses Ding eine gute Verwendung.";
  }
  return "Ihr habt meinen Waermestein schon bekommen. Nun lasst mich in Ruhe.";  
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Thilas, der Zwergenhauptmann");
  SetProp(P_LONG,
    "Dieser stattliche Zwerg ist stark geruestet und verfolgt mit grimmiger Miene "+
    "seinen Patrouillendienst. Er wird auf alle Hilferufe in seiner Hoerweite reagieren "+
    "und allen anderen Zwergen zu Hilfe eilen.");
  SetProp(P_NAME, "Thilas");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hauptmann", "zwerg", "wache", "zwergenpatrouille", "zwergenhauptmann", "patrouille", "zwergenwache", "thilas", "\nzwache", "\nzwerg"}));

  create_default_npc(36);
  SetProp(P_MNPC_AREA, ({THUM_ROOM+"thumfels_"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, THUM_ROOM+"thumfels_d2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp( P_ARTICLE, 0);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Thilas, der Zwergenhauptmann");
  SetProp(P_KILL_MSG, "Leg dich nicht mit Zwergen an!");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Thilas will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    BS("Thilas, der Zwergenhauptmann schaut sich mistrauisch um."),
    BS("Thilas, der Zwergenhauptmann sagt: Hier scheint alles in Ordnung.") }) );
  SetAttackChats(10, ({
    BS("Thilas sagt: Stoerenfriede haben in Thumfels keine Zukunft!"),
    BS("Thilas ruft: Im Namen des Zwergenkoenigs wird Dir nun der Garaus gemacht.") }) );

  SUID;
  CLONEME(THUM_WEAPON+"kampfaxt_1.lpc" );
  command("zuecke axt");
  CLONEME(THUM_ARMOUR+"eisenpanzer_2.lpc" );
  CLONEME(THUM_ARMOUR+"eisenstiefel_2.lpc" );
  CLONEME(THUM_ARMOUR+"kettenhose_2.lpc" );
  CLONEME(THUM_ARMOUR+"topfhelm_2.lpc" );
  CLONEME(THUM_ARMOUR+"eisenarmschienen_2.lpc" );
  CLONEME(THUM_ARMOUR+"rundschild_2.lpc" );
  command("trage alles");

  AddInfo( ({"waermestein"}), #'qwaermestein, "sagt: ");
  AddInfo( ({"gorbul", "bruder"}), "Ich rede nicht gern ueber meinen Bruder. Auch dass ich ihm die Arbeit im "+
    "Stollen verschafft habe scheint ihn nicht zu interessieren.", "sagt: ");
}

