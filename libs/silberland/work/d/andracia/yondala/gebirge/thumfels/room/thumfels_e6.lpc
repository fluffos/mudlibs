// Giesserei
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Giesserei" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich hier in der Giesserei der Zwerge. Die Hitze an diesem Ort ist immens. "+
     "Viele steinere Formen stehen hier bereit um fluessiges Metall aufzunehmen und dem Metall eine Gestalt zu geben. "+
     "Vorallem Formen die einfache Stahl- und Eisenbarren herausbringen, kann man erkennen. "+
     "Im Osten kann man die zwergischen Hochoefen sehen und durch die Tuer im Norden "+
     "kommt man wohl auf die Strassen Thumfels."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren. "));
  AddSmell( DEFAULT_SMELL,
    BS("Es herrscht hier der typische Geruch von fluessigem Metall. "));
  AddSmell( ({ "metall", "geruch", "metall" }),
    BS("Hier herrscht nur der typische Geruch von fluessigem Metall. "));

  AddDetail( ({ "raum", "giesserei", "ort" }),
    BS("Du befindest Dich hier in der Giesserei von Thumfels. Hier wird der Stahl in Formen gegossen. "));
  AddDetail( ({ "formen", "form", "giessformen", "giessform", "gestalt" }),
    BS("Das fluessige Metall wird hier direkt vom Hochofen in die Formen gefuellt. Nach "+
    "dem erkalten in der Form koennen die Barren herausgenommen werden. "));
  AddDetail( ({ "metall", "eisen", "stahl", "eigenschaften" }),
    BS("Das fluessige Metall wird hier direkt vom Hochofen in die Formen gefuellt. Der "+
    "zwergische Stahl ist fuer seine besonders guten Eigenschaften beruehmt."));
  AddDetail( ({ "barren", "stahlbarren", "eisenbarren" }),
    BS("Die Formen geben dem fluessigen Metall die Form von Barren."));
  AddDetail( ({ "osten", "hochoefen", "hochofen" }),
    BS("Im osten befinden sich die zwergischen Hochoefen. Sie strahlen eine immense Hitze aus und liefern "+
    "den beruehmten zwergischen Stahl. "));
  AddDetail( ({ "boden", "felsboden" }),
    BS("Auf dem rauhen Felsboden sind mehrere Metallspritzer erkaltet und bilden komisches Fleckenmuster. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten die Giesserei. "));
  AddDetail( ({ "wand", "waende", "felswaende" }),
    BS("Auch an den Felswaenden sind ein paar Metallspritzer zu sehen."));
  AddDetail( ({ "hitze" }),
    BS("Die Hochoefen strahlen eine immense Hitze aus. Man kann es auf dem ganzen Koerper spueren"));
  AddDetail( ({ "norden", "tuer" }),
    BS("Durch die Tuer im Norden kommt man wohl auf die Strassen von Thumfels"));
  AddDetail( ({ "strassen", "thumfels", "teil", "zwergenstadt", "stadt" }),
    BS("Das hier ist ein Teil der Zwergenstadt Thumfels. Die Strassen, die durch die unterirdische Stadt der "+
    "Zwerge fuehren befinden sich wohl hinter der Tuer im Norden. "));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um die Giesserei zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Nur ganz normaler Fels."));
  AddDetail( ({ "flecken", "muster", "fleckenmuster", "spritzer", "metallspritzer" }),
    BS("Hin und wieder spritzt wohl ein bischen fluessiges Metall beim Fuellen der Giessformen und benetzt Waende und Boden. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_f6.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_e5.lpc" );
}

