#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Ueber der offenen Tuer im Osten baumelt ein, an Ketten befestigtes "+
    "Holzschild, an einem eiseren Halter. "));

  AddDetail( ({"tuer"}),
    BS("Die Tuer im Osten steht offen. Ein schlid haengt an einem "+
    "Halter darueber.") );
  AddDetail( ({"schild", "holzschild"}),
    BS("Ein einfaches hoelzernes Schild. Man kann es lesen.") );
  AddDetail( ({"halter", "eisenketten"}),
    BS("Ein einfacher eiserner Halter an dem mit Eisenketten ein "+
    "Schild befestigt ist. "));
  AddReadDetail( ({"schild", "holzschild"}),
    "+----------------+\n"+
    "| Foerderschacht |\n"+
    "|  zum Erzabbau  |\n"+
    "+----------------+\n" );

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Dieses Reliefbild stellt einen bergsteigenden Zwerg dar. Mit einem Seil "+
    "um die Huefte sucht der Zwerg den Berg nach dem naechsten Halt fuer seinen "+
    "naechsten Schritt ab. ") );
  AddDetail( ({ "halt" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_f2.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_f4.lpc" );
  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_g3.lpc" );
  
  AddItem( THUM_NPC+"durc.lpc", REFRESH_DESTRUCT );
}

