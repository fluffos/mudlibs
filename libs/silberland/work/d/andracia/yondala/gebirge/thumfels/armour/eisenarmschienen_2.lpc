// 12.10.2022 - Yondala@SilberLand: Article auf 0, ID "schienen" gegeben

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Eisenarmschienen");
  SetProp(P_LONG, BS(
    "Eine normales Paar Armschienen aus Eisen. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Eisenarmschienen");
  SetProp(P_GENDER, FEMALE);
    SetProp(P_ARTICLE, 0);
  AddId( ({"armschienen", "eisenarmschienen", "schienen" }) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 740);
  SetProp(P_VALUE, 1350);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:3]) );
}


