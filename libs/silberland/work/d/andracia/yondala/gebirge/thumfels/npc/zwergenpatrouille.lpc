// Zwergenwache

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zwergenpatrouille");
  SetProp(P_LONG,
    "Dieser stattliche Zwerg ist stark geruestet und verfolgt mit grimmiger Miene "+
    "seinen Patrouillendienst. Er wird auf alle Hilferufe in seiner Hoerweite reagieren "+
    "und allen anderen Zwergen zu Hilfe eilen.");
  SetProp(P_NAME, "Zwergenpatrouille");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zwerg", "wache", "zwergenpatrouille", "patrouille", "zwergenwache", "\nzwache", "\nzwerg"}));

  create_default_npc(26);
  SetProp(P_MNPC_AREA, ({THUM_ROOM+"thumfels_"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, THUM_ROOM+"thumfels_d2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Zwergenpatrouille");
  SetProp(P_KILL_MSG, "Leg dich nicht mit Zwergen an!");

  SetProp(P_ARTICLE, 0);

  SetProp(P_LOG_INFO, "missing_answers");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Zwergenpatrouille will Deine Sachen nicht tragen.\n" }) );

  AddInfo( ({"tor"}), 
    "Die Tore Thumfels' lassen sich nur von innen oeffnen. ", "sagt: ");

  SetChats(3, ({
    BS("Die Zwergenwache schaut sich mistrauisch um."),
    BS("Die Zwergenwache sagt: Hier scheint alles in Ordnung.") }) );
  SetAttackChats(10, ({
    BS("Die Zwergenwache sagt: Stoerenfriede haben in Thumfels keine Zukunft!"),
    BS("Die Zwergenwache ruft: Im Namen des Zwergenkoenigs wird Dir nun der Garaus gemacht.") }) );

  SUID;
  CLONEME(THUM_WEAPON+"kampfaxt_2.lpc" );
  command("zuecke axt");
  CLONEME(THUM_ARMOUR+"eisenpanzer_3.lpc" );
  CLONEME(THUM_ARMOUR+"eisenstiefel_3.lpc" );
  CLONEME(THUM_ARMOUR+"kettenhose_3.lpc" );
  CLONEME(THUM_ARMOUR+"topfhelm_3.lpc" );
  CLONEME(THUM_ARMOUR+"eisenarmschienen_3.lpc" );
  CLONEME(THUM_ARMOUR+"rundschild_2.lpc" );
  command("trage alles");
}

