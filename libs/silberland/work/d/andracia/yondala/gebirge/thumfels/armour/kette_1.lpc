#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Goldkette");
  SetProp(P_LONG, "Eine goldene Kette, welch ein Schatz!\n" );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kette");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette", "goldkette"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([ MAT_GOLD ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 3900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}
