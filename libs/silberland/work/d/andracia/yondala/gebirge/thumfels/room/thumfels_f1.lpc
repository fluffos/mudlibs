#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Im Osten endet der Stollen an einem grossen Zwergentor."));

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Das Reliefbild hier am Ende des Stollens zeigt einen Zwerg der eine Schar "+
    "Menschen durch einen Tunnel fuehrt. Die Menschen sehen sehr aengstlich aus und "+
    "sollen wohl Fluechtlinge darstellen. Der Zwerg hingegen ist gut geruestet und "+
    "steht mit einer Anfuehrerpose an Spitze der Menschenschar.") );
  AddDetail( ({ "fluechtlinge", "menschenschar", "anfuehrerpose" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddDetail( ({ "tor", "zwergentor" }),
    BS("Das schwere Tor verschliesst den gesamten Stollen. Welche Gefahren "+
    "auch immer da draussen lauern - diese Tuer wird mit Sicherheit ihnen "+
    "standhalten. Sie befindet sich nur noch wenige Schritte gen Osten"));

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_g1.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_f2.lpc" );
}

