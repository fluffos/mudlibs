// Zwergenpost
#include "../def.h"

inherit "std/post.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergenpost" );
  SetProp( P_INT_LONG,
    BS("Auch die Zwerge sind am Postnetz von Andracia beteiligt. Trotz der "+
    "Abneigung der Zwerge gegen Elfen und Zauberer wurde ihnen wohl erlaubt "+
    "hier eine Poststelle einzurichten. Ob die Zwerge die magische Uebertragung "+
    "von Briefen in ferne Laender auch wirklich nutzen?" ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Hier herrscht erhabene Stille."));
  AddSound( ({ "stille" }),
    BS("Du kannst nichts besonderes hoeren."));

  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));
  AddSmell( ({ "besonderes" }),
    BS("Du kannst wirklich nichts besonderes riechen."));


  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus einfachen quadratischen Steinplatten."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten die Post. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Bis auf halber Hoehe bilden quadratische Platten die Waende. Ueberhalb kann "+
    "man nur behauenen Fels erkennen."));

  AddDetail( ({ "postnetz", "netz", "uebertragung", "zeitverlust" }),
    BS("Durch magische Uebertragung werden die Briefe nahezu ohne Zeitverlust von "+
    "einer Poststelle zur anderen gebracht."));
  AddDetail( ({ "abneigung" }),
    BS("Zwerge haben eine Abneigung gegen Elfen und Zauberer. Aber einer Poststelle innerhalb "+
    "ihrer Stadt haben Sie doch zugestimmt."));
  AddDetail( ({ "elfen" }),
    BS("Zwerge haben eine Abneigung egegen Elfen."));
  AddDetail( ({ "zauberer" }),
    BS("Zauberer sind nur geduldet hier in der Zwergenstadt."));
  AddDetail( ({ "post", "poststelle", "raum" }),
    BS("Trotz der Abneigung der Zwerge gegen Elfen und Zauberer wurde ihnen wohl erlaubt "+
    "hier eine Poststelle einzurichten. Man kann also auch hier Briefe lesen und versenden."));
  AddDetail( ({ "brief", "briefe" }),
    BS("Hier kann man Briefe lesen und schreiben. "));
  AddDetail( ({ "andracia", "laender" }),
    BS("So einfach kann man das gesamte Andracia nicht erkunden."));
  AddDetail( ({ "steinplatten", "platten", "granitplatten" }),
    BS("Einfache Granitplatten schmuecken den Boden sowie die Waende."));
  AddDetail( ({ "laterne", "laternen", "eisenketten", "ketten", "licht" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um die Post zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Normaler Fels."));
  AddDetail( ({ "stadt", "zwergenstadt", "thumfels" }),
    BS("Diese Post ist Teil der unterirdischen Zwergenstadt Thumfels."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_e2.lpc" );

  AddItem( "std/postschalter.lpc", REFRESH_REMOVE );
}

