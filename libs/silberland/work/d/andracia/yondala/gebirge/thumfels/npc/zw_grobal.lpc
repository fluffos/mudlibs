// Zwergenhauptmann Thilas, hat einen Waermestein.

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Grobal, ein Hoehlenforscher");
  SetProp(P_LONG,
    "Grobal hat schon sehr viele gute Erzvorkommen fuer die Zwerge erschlossen. Er kennt sich in "+
    "den Hoehlen und Stollen der Unterwelt besonders gut aus.");
  SetProp(P_NAME, "Grobal");
  SetProp(P_GENDER, MALE);
  AddId(({"grobal", "zwerg", "hoehlenforscher", "\nzwerg"}));

  create_default_npc(36);
  SetProp(P_MNPC_AREA, ({THUM_ROOM+"thumfels_"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, THUM_ROOM+"thumfels_d2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp( P_ARTICLE, 0);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Grobal, der Hoehlenforscher");
  SetProp(P_KILL_MSG, "Leg dich nicht mit Zwergen an!");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Grobal will Deine Sachen nicht tragen.\n" }) );
/*
  SetChats(3, ({
    BS("Die Zwergenwache schaut sich mistrauisch um."),
    BS("Die Zwergenwache sagt: Hier scheint alles in Ordnung.") }) );
  SetAttackChats(10, ({
    BS("Die Zwergenwache sagt: Stoerenfriede haben in Thumfels keine Zukunft!"),
    BS("Die Zwergenwache ruft: Im Namen des Zwergenkoenigs wird Dir nun der Garaus gemacht.") }) );
*/
  SUID;
  CLONEME(THUM_WEAPON+"kampfaxt_2.lpc" );
  command("zuecke axt");
  CLONEME(THUM_ARMOUR+"eisenstiefel_2.lpc" );
  CLONEME(THUM_ARMOUR+"topfhelm_1.lpc" );
  CLONEME(THUM_ARMOUR+"eisenarmschienen_2.lpc" );
  command("trage alles");

  AddInfo( ({"troglodyt", "troglodyten"}), 
    "Unsere Nachbarn, die Trogloyten, hier unten in der Tiefe des Bergs sind etwas einfach aber durchaus "+
    "friedliche Gesellen. Sie suchen nicht nach Erdschaetzen und verarbeiten auch kein Eisen. Sie sind "+
    "immer auf der Suche nach Brennmaterialien um ihre Hauser zu beheizen. ", "sagt: ");
  AddInfo( ({"brennmaterial", "brennmaterialien"}), 
    "Fuer die Troglodyten ist ein Waermestein von unschaetzbarem Wert. Schliesslich benoetigen Sie kein Licht "+
    "wohl aber die Waerme eines Feuers. Nur dass diese Steine leider viel zu selten sind." , "sagt: ");
  AddInfo( ({"waermestein"}), 
    "Ich hab leider keinen. Gorbul, der Saeufer, hat vor ein paar Tagen davon gefaselt dass er einen gefunden "+
    "haette. Vielleicht hat er ja wirklich einen gefunden gehabt.", "sagt: ");
  AddInfo( ({"wesen"}), 
    "Hier in der Unterwelt gibt es verschiedenste Wesen. Viele Kaefer, aber auch nette Nachbarn, wie die Troglodyten.", "sagt: ");
  AddInfo( ({"herkuleskaefer"}), 
    "Diese etwas kleineren Bewohner der Unterwelt sind nicht besonders schmackhaft. Ansonsten "+
    "sind diese Kaefer nur laestig, mehr nicht.", "sagt: ");
  AddInfo( ({"hirschkaefer"}), 
    "Hirschkaefer snd die kleinsten, nennenswerten Kaefer die man hier unten finden kann. ", "sagt: ");
  AddInfo( ({"kopfhornkaefer"}), 
    "Wie der Name schon sagt ist bei diesen Kaefern vorallem das grosse Horn auf ihrem Kopf bemerkenswert. ", "sagt: ");
  AddInfo( ({"felsenfresser", "felsenfresserkaefer"}), 
    "Felsenfresserkaefer sind keine angenehmen Gesellen. Normalerweise sind sie friedlich aber bei Gefahr verspritzen "+
    "sie Saeure, die auch einer Ruestung aus Titan sehr zusetzen kann.", "sagt: ");
  AddInfo( ({"scheinstutzkaefer"}), 
    "Eine der groessten Kaeferart, die man hier antreffen kann, ist der Scheinstutzkaefer. Seine blau-gruenen "+
    "Panzerplatten sind sehr begehrt. Allerdings muss man sich vor seinem Gift vorsehen.", "sagt: ");
  AddInfo( ({"corbonitkaefer"}), 
    "Hin und wieder sieht man einen Corbonitkaefer hier unten. Diese aggressiven Kaefer, mit einem tiefroten Panzer, "+
    "sind mit stacheligen Beinen und einer gemeinen Saeure bewaffnet. ", "sagt: ");
  AddInfo( ({"erdschaetze", "erdschaetzen"}), 
    "Ich weiss wo so manches gutes Erzlager ist, aber Euch sag ich das nicht!", "sagt: ");

/*
  AddInfo( ({""}), 
    "", "sagt: ");
*/
}

