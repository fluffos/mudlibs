#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Hier treffen sich drei Stollen aus Osten, Westen und Sueden und "+
    "bilden eine T-Kreuzung. "+
    "Ueber der offenen Tuer im Norden baumelt ein, an Ketten befestigtes "+
    "Holzschild, an einem eiseren Halter. "));

  AddDetail( ({"tuer"}),
    BS("Die Tuer im Norden steht offen. Ein schlid haengt an einem "+
    "Halter darueber.") );
  AddDetail( ({"schild", "holzschild"}),
    BS("Ein einfaches hoelzernes Schild. Man kann es lesen.") );
  AddDetail( ({"halter", "eisenketten"}),
    BS("Ein einfacher eiserner Halter an dem mit Eisenketten ein "+
    "Schild befestigt ist. "));
  AddReadDetail( ({"schild", "holzschild"}),
    "+-----------------+\n"+
    "|Tempel der Zwerge|\n"+
    "+-----------------+\n" );

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Das steinerne Bild hier zeigt einen Kampf zwischen Menschen und Zwerge "+
    "innerhalb eines grossen Stollens.") );
  AddDetail( ({ "menschen", "kampf" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "osten" }), THUM_ROOM+"thumfels_e2.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_c2.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"zwergentempel.lpc" );
  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_d3.lpc" );
}

