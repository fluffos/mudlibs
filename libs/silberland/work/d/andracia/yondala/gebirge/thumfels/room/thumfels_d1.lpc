// Zwergentempel
#include "../def.h"
Umgezogen nach /gilden/ wegen dem Problem SetProp(P_AP,..)
//inherit "std/room";
inherit "/std/gilde";

#include <properties.h>

string unt_bilder_ost();
string unt_bilder_west();

string *bilder_ost =({
	"Das Reliefbild zeigt eine Szene wie ein zwergischer Schmied ein Stueck "+
    "Eisen mit dem Hammer bearbeitet.",
  "Das Reliefbild in diesem Bereich zeigt eine Gruppe Zwerge die sich "+
    "als Hoehlenforscher mit Laternen in einer Tropfsteinhoehle vorwaerts "+
    "tasten. ",
  "Das Reliefbild stellt eine Gruppe Zwerge dar, die mit Steinen gefuellte "+
    "Loren auf schienen durch einen Stollen schieben. ",
  "Das steinerne Bild hier zeigt einen Kampf zwischen Menschen und Zwerge "+
    "innerhalb eines grossen Stollens.",
  "In diesem steinernen Bild wurde ein Zwerg verewigt der wohl eine "+
    "mechanische Erfindung gemacht hat. Im Bild haelt er einen kastenfoermigen "+
    "Gegenstand in die Hoehe der aus Zahnraedern, und komischen Metallstangen "+
    "zu bestehen scheint. ",
  "In diesem Reliefbild hat ein Zwerg wohl einen grossen Edelstein gefunden. "+
    "Stolz hebt er ihn mit der einen Hand in die Luft und eine Spitzhacke hat "+
    "er in der anderen.",
  "Dieses Reliefbild stellt einen bergsteigenden Zwerg dar. Mit einem Seil "+
    "um die Huefte sucht der Zwerg den Berg nach dem naechsten Halt fuer seinen "+
    "naechsten Schritt ab. ",
  "Das Reliefbild hier zeigt Zwerge die an einem Hochofen arbeiten. Ein Zwerg "+
    "sticht gerade an und laesst das fluessige Eisen in eine Form fliessen. "
  });
string *bilder_west =({
	"In diesem Reliefbild ist eine grosse Kampfszene zwischen einer Schar "+
    "Zwerge und einer Gruppe Elfen dargestellt. Die Elfen haben dabei entstellte "+
    "Fratzen die sie wie Monster erscheinen lassen.",
  "Das Bild in den Felsen zeigt einen Zwerg der eine Axt an einem Schleifstein "+
    "schaerft. ",
  "Das Reliefbild hier bildet eine Szene an der Oberflaeche ab wie Zwerge "+
    "mit einem Kran und zusammen mit Menschen eine Stadtmauer errichten. ",
  "Hier ist im Stein eine Szene zwischen Zwergen und Troglodyten festgehalten. "+
    "Die Troglodyten tauschen in dem Bild gewebte Stoffe gegen Faesser, warscheinlich "+
    "Zwergenbier.",
  "Diese Reliefbild zeigt einen Zwerg auf dem Kutschbock eines von Ochsen "+
    "gezogenen Planwagen. Waffen und Ruestungen schauen aus dem Planwagen heraus. "+
    "Dieses Bild soll also wohl einen fahrenden Zwergenhaendler darstellen. ",
  "Dieses Reliefbild zeigt einen greisen Zwerg mit Gehstock der vor vielen "+
    "anderen Zwergen eine Rede oder aehnliches haelt. Vielleicht eine Schulszene. ",
  "Hier stellt das Reliefbild eine Szene auf einem Fluss dar. Mehrere Flosse "+
    "mit Zwergen besetzt versuchen ueber einen Fluss zu gelangen. Die fein "+
    "herausgemeisselten Zwergengesichter sind gezeichnet von Angst und Abscheu vor "+
    "den tosenden Wassermassen. Ein Floss ist gekentert und von den Zwergen sind "+
    "nur noch ein paar rudernde Arme im Wasser zu erkennen.",
  "Dieses Reliefbild zeigt eine Schar Zwerge in einer Taverne. Alle mit sind "+
    "mit einem grossen Humpen in der Hand dargestellt und die fein gemeisselten "+
    "Gesichter der Zwerge spiegeln die ausgelassene Stimmung wider. "  
  });

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergentempel" );
  SetProp( P_INT_LONG,
    BS("Eine grosse Tempelhalle erstreckt sich hier tief in den Fels. Hohe Saeulen "+
    "stuetzen an Ost- und Westseite der Halle die Decke. Am Kopfende der Saeulen "+
    "sind grosse Kristalle angebracht die mit einem angenehmen Licht die Halle hell "+
    "erleuchten. Am noerdlichen Ende dieses Tempels steht ein steinerener Thron auf "+
    "einem breiten Podium. Breite, zum Podium hin ausgerichtete Baenke stehen hier "+
    "rechts und links und bilden in der Mitte einen Gang direkt zum Thron. Eine kleines "+
    "Schild informiert ueber die Dienstleistung hier im Tempel" ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( ({ "hallen", "schritte" }),
    BS("Jeder Schritt hallt hier in der Tempelhalle."));
  AddSound( ({ "stille" }),
    BS("Im Moment ist keine Versammlung oder aehnliches was die Stille, die "+
    "hier herrscht, stoeren wuerde."));
  AddSound( ({ "geraeusche", "stecknadel", "fallen" }),
    BS("Jeder Schritt hallt hier in der Tempelhalle und unterbricht damit die "+
    "erhabene Stille die hier herrscht. Man koennte eine Stecknadel fallen hoeren."));
  AddSmell( ({ "staub", "luft", "geruch" }),
    BS("Die Luft riecht staubig. "));
  AddSmell( ({ "zwerge" }),
    BS("Hier riecht es eindeutig nach Zwergen: ungewaschene Baerte, "+
    "verkleckertes Zwergenbier, durchschwitzte Kettenhemden."));
  AddSound( DEFAULT_SOUND,
    BS("Es herscht hier eine erhabene Stille. Deine Geraeusche deiner Schritte "+
    "hallen von den Waenden wider. Hier koennte man eine Stecknadel fallen hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier etwas staubig und der Geruch von Zwergen haengt in der Luft."));

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht fast im ganzen Raum aus Granitplatten in eine besondes "+
    "hellen Grauton. Das Podium allerdings scheint aus Mithrilerz geschnitten "+
    "zu sein. Vor dem Podium ist ein grosses Mosaik eingelassen. "));
  AddDetail( ({ "decke", "felsendecke" }),
    BS("Die Felsendecke wird an der Ost- und Westseite von hohen Saeulen gestuetzt. "+
    "Ein aus dem Fels herausgearbeitetes Muster aus geometrischen Formen schmueckt "+
    "die Decke. Vorallem Rauten und Quadrate dominieren im Dekor der Decke."));
  AddDetail( ({ "waende", "seiten" }),
    BS("Zwischen den Saeulen an der Ost- und Westwand setzt sich das Dekormuster "+
    "der Decke bis auf halbe Hoehe fort. Darunter sind Reliefbilder im Fels "+
    "gemeisselt. Auch an der Sued- und Nordwand der Tempelhalle ist das Muster bis "+
    "ganz nach unten in der Wand eingearbeitet. "));
  AddDetail( ({ "halle", "tempel", "tempelhalle", "raum", "platz" }),
    BS("In dieser prunkvollen Tempelhalle preisen die Zwerge ihren Gott, "+
    "aber auch fuer Versammlungen und andere, mehr gesellige Gelegenheiten "+
    "wird diese Halle benutzt. Hohe Saeulen "+
    "stuetzen an Ost- und Westseite der Halle die Decke. Am Kopfende der Saeulen "+
    "sind grosse Kristalle angebracht die mit einem angenehmen Licht die Halle hell "+
    "erleuchten. Am noerdlichen Ende dieses Tempels steht ein steinerener Thron auf "+
    "einem breiten Podium. Breite, zum Podium hin ausgerichtete Baenke stehen hier "+
    "rechts und links und bilden in der Mitte einen Gang direkt zum Thron. "));
  AddDetail( ({ "fels", "gestein", "felsgestein", "zwergensteinmetze", "zwergensteinmetz", "zwergensteinmetzen" }),
    BS("Die Waende und Decke sind aus einfachem Fels, aber das Muster und die "+
    "Reliefbilder die von faehigen Zwergensteinmetzen erstellt wurden, machen "+
    "diesen Raum und den Fels zu etwas besonderem. Auch die Saeulen bestehen "+
    "aus dem normalen Fels, nur die Granitplatten, die den Boden bilden, sind "+
    "aus einem anderen Gestein als der allgegenwaertige Fels. "));
  AddDetail( ({ "saeule", "saeulen", "schaft" }),
    BS("Die Saeulen an Ost- und Westwand bestehen aus normalem glatten Fels. Nur "+
    "die oberen und unteren Abschlussteine sind mit Ornamenten verziert. Die "+
    "Abschlusssteine am Kopfende der Saeulen umfassen leuchtende Kristalle die "+
    "den Raum hell ausleuchten. "));
  AddDetail( ({ "ostseite", "ostwand", "osten", "westseite", "westwand", "westen" }),
    BS("Zwischen den Saeulen setzt sich das Dekormuster der Decke bis auf halbe "+
    "Hoehe fort. Darunter sind Reliefbilder in den Fels gemeisselt. "));
  AddDetail( ({ "nordseite", "nordwand", "norden", "front" }),
    BS("Am noerdlichen Ende der Halle ist das Podium mit dem Thron. An der Wand "+
    "dahinter ist ein beeindruckendes Dekormuster in den Fels eingearbeitet das "+
    "sich bis an die Decke fortfuehrt. "));
  AddDetail( ({ "suedseite", "suedwand", "sueden" }),
    BS("Am suedlichen Ende der Halle befindet sich der Ausgang. An der Wand "+
    "dahinter ist ein beeindruckendes Dekormuster in den Fels eingearbeitet das "+
    "sich bis an die Decke fortfuehrt. "));
  AddDetail( ({ "wand", "seite" }),
    BS("Welche Wand? Es gibt hier in jeder Himmelsrichtung eine."));
  AddDetail( ({ "ausgang" }),
    BS("Der Ausgang befindet sich im Sueden."));
  AddDetail( ({ "abschlussstein", "abschlussteine", "teilen", "teile" }),
    BS("Eine klassische Saeule besteht aus drei Teilen: Der Schaft ruht auf dem "+
    "unteren Abschlussstein, der sogenannten Basis, und wird von einem oberen "+
    "Abschlussstein namens Kapitell bekroent."));
  AddDetail( ({ "kopfende", "kapitell", "kapitelle" }),
    BS("In den mit Ornamenten verzierten Abschlusssteinen am oberen Ende der "+
    "glatten Saeulen ist jeweils ein grosser Kristall eingelassen, die alle "+
    "hell leuchten und die Halle  damit in angenehmes Licht tauchen. "));
  AddDetail( ({ "fussende", "basis", "basen" }),
    BS("Die unteren Abschlusssteine sind auch mit filigranen Ornamenten verziert, "+
    "aber ein leuchtende Kristall wie an den Kapitellen der Saeulen ist hier "+
    "nicht zu sehen. "));
  AddDetail( ({ "kristalle", "kristall", "licht", "beleuchtung", "feuer", "kerzen", "laternen", "leuchten" }),
    BS("Die Kristalle, die in den Kapitellen der Saeulen eingepasst sind, senden "+
    "ein gleichsam angenehmes und helles Licht aus. Anders als gewoehnliches Feuer, das "+
    "sonst in Laternen oder als Kerzen das Licht spendet, flackern diese Kristalle "+
    "nicht sondern liefern ein bestaendiges Leuchten."));
  AddDetail( ({ "ende", "abenteuer" }),
    BS("Es gibt kein Ende - das Abenteuer geht immer weiter!"));
  AddDetail( ({ "thron", "marmor" }),
    BS("Der steinerne Thron, der mittig auf dem Podium an der Nordwand steht, "+
    "ist wohl fuer den Zwergenkoenig gedacht. Er besteht aus einem dunklen Marmor "+
    "und wurde mit allerlei gemeisselten Ornamenten verziert. Dies ist ein "+
    "wirklich prunkvoller aber nicht wirklich bequemer Sitzplatz."));
  AddDetail( ({ "podium", "erhoehung", "stufen" }),
    BS("Das breite Podium an der noerdlichen Wand der Tempelhalle ist fuer "+
    "Zwerge ungefaehr huefthoch und hat an der gesamten vorderen Front vier "+
    "breite Stufen damit man das Podium leicht betreten kann. Das ganze Podium "+
    "und die Stufen davor sind wohl aus Mithrilerzquadern und schimmern "+
    "daher eindrucksvoll im Licht der Kristalle. "));
  AddDetail( ({ "baenke", "bank", "holzbank", "holzbaenke", "sitzplatz", "sitz", "sitzplaetze" }),
    BS("Einfache Holzbaenke sind hier aufgestellt. Alle sind ausgerichtet zum "+
    "Thron auf dem Podium, und bilden in der Mitte einen Gang der vonm Ausgang "+
    "im Sueden direkt bis vor den Thron im Norden fuehrt. Auf diesen Baenken "+
    "finden zu den Versammlungen sehr viele Zwerge, wenn nicht sogar alle "+
    "Buerger Thumfels', Platz."));
  AddDetail( ({ "mitte", "gang", "ueberblick" }),
    BS("Die Baenke bilden in der Mitte einen freien Gang vom Ausgang im Sueden "+
    "direkt zum Thron auf dem Podium im Norden. Von hier aus hat man einen guten "+
    "Ueberblick ueber die gesamte Tempelhalle."));
  AddDetail( ({ "granit", "granitplatten", "bodenbelag", "grauton", "haerte" }),
    BS("Die schweren Granitplatten, die den Boden bilden, sind von besonders "+
    "hoher Haerte und von einem hellen Grauton. Das dauert viele Jahrhunderte "+
    "bis dieser Bodenbelag ausgetreten ist."));
  AddDetail( ({ "mosaik", "schatz", "schmiedehammer" }),
    BS("Vor dem Podium ist ein Mosaik aus Edelsteinen eingelassen das "+
    "einen Schmiedehammer zeigt. Diamanten, Rubine, Smaragde und viele andere "+
    "Edelsteine wurden fuer dieses Mosaik verwendet. Dieser runde und offenliegende "+
    "Schatz mit ungefaehr zwei Zwergenlaengen im Durchmesser ist eine atemberaubende "+
    "Zurschaustellung des zwergischen Reichtums. "));
  AddDetail( ({ "mithrilerz", "erz", "mithrilerzquader", "quader" }),
    BS("Das Podium besteht aus dem wertvollsten Erz das man in der Unterwelt "+
    "finden kann. Es schimmert im Licht und laesst von dem Metall, das darin "+
    "steckt, die Besonderheit erahnen."));
  AddDetail( ({ "muster", "rauten", "raute", "quadrate", "quadrat", 
                "formen", "form", "dekor", "dekormuster" }),
    BS("An Decke und Waende ist eine Muster aus Rauten und Quadraten eingemeisselt. "+
    "Nur die Saeulen die an der Ost- und Westwand stehen unterbrechen das "+
    "eindrucksvolle Dekor."));
  AddDetail( ({ "reliefbilder", "reliefs", "bilder" }),
    BS("Welche Reliefbilder willst Du anschauen? Die an der Ostwand oder die "+
    "an der Westwand?"));
  AddDetail( ({ "luft" }),
    BS("Etwas staubig aber ansonsten gut zu atmen."));
  AddSpecialDetail( ({ "edelsteine", "zurschaustellung", "reichtum", "diamanten",
                       "rubine", "smaragde" }), "get_gem" );
  AddDetail( ({ "baerte", "bart" }),
    BS("Zwerge lassen ihren Bart nur ungern untersuchen, also lass sowas lieber."));
  AddDetail( ({ "besonderheit" }),
    BS("Mithril ist ein besonderes Metall. Selbst Mithrilerz schimmert besonders im Licht. "));
  AddDetail( ({ "buerger", "zwerge", "zwergenkoenig", "zusammenkunft", "gelegenheiten", "gelegenheit", "versammlung", 
  	            "versammlungen" }),
    BS("Alle Zwerge koennen sich hier in diesem Tempel um ihren Zwergenkoenig versammeln. "+
    "Solch eine Zusammenkunft kommt aber sehr selten vor. "));
  AddDetail( ({ "mithril", "metall" }),
    BS("Mithril ist ein sehr ungewoehnliches Metall. Nur ein paar Zwerge wissen um das Geheimnis "+
    "wie man es schmieden kann. "));
  AddDetail( ({ "durchmesser" }),
    BS("Das Mosaik hat einen Durchmesser von ungefaehr zwei Zwergenlaengen."));
  AddDetail( ({ "geruch" }),
    BS("Fuer sowas ist riechen besser geeignet."));
  AddDetail( ({ "himmelsrichtung", "richtung" }),
    BS("Die Himmelsrichtungen sind Norden, Osten, Sueden und Westen."));
  AddDetail( ({ "hoehe", "riese", "riesen" }),
    BS("In dieser Tempelhalle koennte auch ein kleiner Riese aufrecht stehen. Aber Riesen sieht man hier selten."));
  AddDetail( ({ "moment" }),
    BS("Schon vorbei."));
  AddDetail( ({ "ornament", "ornamente", "schnoerkel", "ornamenten" }),
    BS("Der Thron und die unteren und oberen Abschlusssteine sind mit Ornamenten geschmueckt. Allerdings wurden nur runde "+
    "Schnoerkel und einfache Muster verwendet."));
  AddSpecialDetail( ({ "schritt" }),
    "unt_schritt");
  AddDetail( ({ "thumfels", "zwergenstadt", "zentrum" }),
    BS("Du befindest dich hier im Tempel der Zwerge, das Zentrum der Zwergenstadt Thumfels."));
  AddDetail( ({ "unterwelt", "reich", "hoehlen", "stollen" }),
    BS("Hoehlen, Stollen und alles andere das die Zwerge als ihr Reich ansehen, nennt man Unterwelt. "));
  AddDetail( ({ "zwergenbier", "geheimnis" }),
    BS("Hier im Tempel? Such lieber eine Zwergenkneipe."));
  AddDetail( ({ "zwergenkneipe" }),
    BS("Hier ist der Tempel der Zwerge - auch wenn man es annehmen koennte - hier gibts kein Zwergenbier."));
  AddDetail( ({ "zwergenlaenge", "zwergenlaengen" }),
    BS("Allzu besonders grossgewachsen sind Zwerge nicht."));
  AddDetail( ({"schild", "dienstleistungen", "dienste", "dienstleistung", "moeglichkeiten", "informationen"}),
    BS("Das Schild ist mit allen Informationen beschriftet - daher hilft lesen eher.") );

  AddReadDetail( ({"schild", "dienstleistungen", "dienste", "dienstleistung", "moeglichkeiten"}),
      "Dir stehen hier folgende Dienstleistungen zur Verfuegung:\n"
		  "- liste [[nicht] geloest]\n"
		  "- erhoehe [stufe]\n"
		  "- kosten \n"
		  "- lerne <faehigkeit> \n"
		  "- wandle <attribut> in <attribut>\n" );

  AddDetail( ({ "reliefbilder an der ostwand", "reliefs an der ostwand",
                "bilder an der ostwand" }),
    #'unt_bilder_ost );
  AddDetail( ({ "reliefbilder an der westwand", "reliefs an der westwand",
                "bilder an der westwand" }),
    #'unt_bilder_west );

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_d2.lpc" );
  
  AddCmd(({ "lerne", "lern" }), "OwnLearnSpell" );
}

string unt_bilder_ost() {
	return BS(bilder_ost[random(sizeof(bilder_ost))]);
}
string unt_bilder_west() {
	return BS(bilder_west[random(sizeof(bilder_west))]);
}

string unt_schritt(string str)
{
	if( TP->QueryProp(P_GENDER)==FEMALE )
		return "Fuer dich lohnt es sich nicht das zu untersuchen. \n";
	else
		return "Ein kurzer Griff - alles noch da. \n";
}

string get_gem(string str)
{
  if( TP->QueryProp(P_RACE) == "zwerg" )
    return BS("Du bewunderst das Mosaik und labst dich an dem zur Schau "+
      "gestellten Reichtum.");
  if( random(2000) != 0 )
    return BS("Du bueckst Dich und streichst ueber das Mosaik. Keiner der Edelsteine "+
      "ist locker an dieser Stelle. Du musst Dir eine andere Stelle suchen um an "+
      "Edelsteine zu kommen - hier konntest Du keine stehlen.");
  //edelstein aus dem Mosaik geloest!
  "/obj/gemmaster"->DistributeGem(1, 0, 0, TP);
  return BS("Du bueckst Dich und streichst ueber das Mosaik. Ein Edelstein loest "+
    "sich unter deinen Haenden aus dem Mosaik - unbemerkt steckst Du ihn ein.");
}

int OwnLearnSpell(string str)
{
	return "/gilden/abenteurer.lpc"->OwnLearnSpell(str);
}