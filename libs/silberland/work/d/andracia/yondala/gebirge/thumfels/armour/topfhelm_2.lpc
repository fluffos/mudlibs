#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Topfhelm");
  SetProp(P_LONG, BS(
    "Ein normaler Helm aus Eisen. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Topfhelm");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "eisenhelm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_LEATHER:10, MAT_IRON:80]) );
  SetProp(P_WEIGHT, 1250);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:3]) );
}


