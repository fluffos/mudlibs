#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"targon","hammersack", "wirt", "\ntargon" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Targon Hammersack, der Wirt");
  SetProp( P_LONG, BS("Dies ist Targon Hammersack, der Wirt der Zwergenschenke. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Targon");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_e4.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_e4.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Targon Hammersack"); //string fuer Todessequenz
 
  //Chats
  SetChats( 1, ({"Targon ruft: Das beste Zwergenbier gibts nur hier! \n", "Targon ruft: Nicht draengeln! \n"}) ); //rate in %
  SetAttackChats( 5, ({"Targon bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Menueinfos
  /*AddInfo( ({"bier", "zwergenbier"}), break_string("",45), "sagt: ");
  AddInfo( ({"putzer", "rachenputzer"}), break_string("",45), "sagt: ");
  AddInfo( ({"feuerschnaps", "schnaps"}), break_string("",45), "sagt: ");
  AddInfo( ({"eintopf"}), break_string("",45), "sagt: ");
  AddInfo( ({"zwergenbrot", "brot"}), break_string("",45), "sagt: ");*/
  
  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( THUM_WEAPON+"kampfaxt_2.lpc" );
  command("zuecke waffe");
  CLONEME( "/d/andracia/yondala/friedheim/armour/lederarmschienen_2.lpc" );
  CLONEME( THUM_ARMOUR+"kettenhose_1.lpc" );
  command("trage alles");
}

