#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Zwergenschwert");
  SetProp(P_LONG, "Ein normales Zwergenschwert. \n " );
  // SetProp(P_INFO, "Grosse Kaefer kann man damit bestimmt bezwingen.");
  SetProp(P_NAME, "Zwergenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "zwergenschwert"}) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 3300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4, A_STR:3, P_RACE:"Zwerg"]) );
}

