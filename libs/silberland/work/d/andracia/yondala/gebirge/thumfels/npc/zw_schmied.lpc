  AddInfo( ({"erz"}), 
    "Wir sind immer auf der Suche nach guten Erzvorkommen. Ob Eisen oder Mithril, wir sind hier "+
    "die einzigen mit Hochoefen die das Erz zu hochwertigem Metall verarbeiten.", "sagt: ");
  AddInfo( ({"eisen", "metall"}), 
    "In den Hochoefen wird das Erz zusammen mit Kohle zu hochwertigem Metall gekocht. Ganz Andracia "+
    "verwendet unser Eisen.", "sagt: ");
  AddInfo( ({"mithril"}), 
    "Mithril ist ein seltenes Metall und die Verarbeitung ist um einiges schwieriger als normales Eisen. "+
    "Nur uns Zwergen ist bekannt wie man Mithril schmieden kann. ", "sagt: ");
  AddInfo( ({"troll", "trolle"}), 
    "Trolle verirren sich nur selten nach hier unten in die Unterwelt.", "sagt: ");
  AddInfo( ({"kobold", "kobolde"}), 
    "Kobolde wohnen normalerweise auch in der Unterwelt, aber sie bevorzugen eher Hoehlen die "+
    "naeher an der Oberflaeche liegen.", "sagt: ");
  AddInfo( ({"fee", "feen"}), 
    "Feen sieht man nicht so oft in der Unterwelt. Sie befuerchten wohl gegen Felsen zu fliegen oder so.", "sagt: ");
  AddInfo( ({"faune", "faun"}), 
    "Faune hab ich bisher hier unten noch nicht gesehen. ", "sagt: ");
  AddInfo( ({"zauberer"}), 
    "Die Zauberer haben ihren Turm an der Oberflaeche nur ein kleines Stueck westwaerts errichtet.", "sagt: ");
  AddInfo( ({"pirat", "piraten"}), 
    "Piraten bereisen eher die Meere weit im Westen. ", "sagt: ");
  AddInfo( ({"mensch", "menschen"}), 
    "Menschen sind unseren besten Kunden. Die Haendler aus Zwirbelstein kaufen das meisste unseres "+
    "Eisen. Aufgrund des Abkommens mit dem Freiherrn zu Zwirbelstein betreiben die Menschen keine "+
    "eigenen Minen. Waer ja auch ein undicng wenn die Menschen hier ihre instabilen Stollen in den "+
    "Berg treiben wuerden.", "sagt: ");
  AddInfo( ({"halbling", "halblinge"}), 
    "Halblinge sind nette Gesellen, man kann mit ihnen gut feiern und die wissen einfach wie man sich amuesiert.", "sagt: ");
  AddInfo( ({"troglodyt", "troglodyten"}), 
    "Unsere Nachbarn, die Trogloyten, hier unten in der Tiefe des Bergs sind etwas einfach aber durchaus "+
    "friedliche Gesellen. Sie suchen nicht nach Erdschaetzen und verarbeiten auch kein Eisen. Aber "+
    "sie zuechten besonders schmackhafte Kaefer.", "sagt: ");
  AddInfo( ({"kaefer"}), 
    "Richtig schmackhafte Kaefer werden von den Troglodyten gezuechtet. Leider gibt es aber in den Hoehlen "+
    "auch Exemplare die einen Zwerg verspeisen koennen. Wenn ihr also durch die Hoehlen wandert, so hofft "+
    "dass euch kein solches Exemplar begegnet.", "sagt: ");
  AddInfo( ({"bergbau", "minen", "mine"}), 
    "Um Erz und Kohle zu foerdern muessen eben Stollen tief in den Berg getrieben werden. Im Osten fuehrt eine Lorenbahn "+
    "hinab zu unserem Abbaugebiet.", "sagt: ");
  AddInfo( ({"kohle"}), 
    "Menschen verbrennen Holz, wir Zwerge hingegen Kohle, liegt ja auch Nahe das zu verwenden was man hier unten "+
    "findet.", "sagt: ");
  AddInfo( ({"hochofen", "hochoefen"}), 
    "Die Hochoefen, in denen wir Metall kochen, befinden sich im Suedosten der Stadt. ", "sagt: ");
  AddInfo( ({"ruestungen", "ruestung", "waffen", "waffe", "axt", "schwert"}), 
    "Barabasch der Haendler verkauft euch siche die eine oder andere Waffe. Auch passable Ruestungen hat er im Angebot. "+
    "Wenn ihr euch aber um eine massgeschneiderte Ruestung bemuehen wollt, so koennt ihr in der Schmiede einen "+
    "entsprechenden Auftrag erteilen.", "sagt: ");
  AddInfo( ({"zwergenbier", "bier"}), 
    "Ach, es gibt nichts besseres als einen guten Humpen Zwergenbier.", "sagt: ");
  AddInfo( ({"gorbul", "saeufer"}), 
    "Gorbul, ist ein Nichtsnutz. Er saeuft und ertrinkt in seinem Selbstmitleid. "+
    "Es ist eine Schande dass unser Hauptmann solch einen Bruder hat.", "sagt: ");
  AddInfo( ({"grobal", "hoehlenforscher"}), 
    "Grobal ist ein erfahrener Hoehlenforscher. falls ihr etwas ueber die Hoehlen oder die Troglodyten erfahren wollt "+
    "so fragt am besten ihn.", "sagt: ");
  AddInfo( ({"thilas", "zwergenhauptmann", "hauptmann"}), 
    "Thilas ist unser Hauptmann der Zwergenwachen. Er fuehrt ein strenges Regiment und sorgt dafuer dass "+
    "alle Zwerge hier in der Stadt sicher sind. Eine Schande dass sein Bruder Gorbul so ein Nitsnutz ist.", "sagt: ");
  AddInfo( ({"zwergenstadt", "stadt", "thumfels"}), 
    "Die Zwergestadt, in der ihr gerade steht, heisst Thumfels.", "sagt: ");
  AddInfo( ({"geschenk", "gastgeschenk"}), 
    "Ihr braucht mir kein Geschenk machen.", "sagt: ");
  AddInfo( ({"ausgang", "tuer"}), 
    "Ihr koennt Thumfels jederzeit verlassen. Aber hereingelassen werdet ihr nur wenn die Torwache euch einlaesst.", "sagt: ");
 
  //Chats
  SetChats( 2, ({
  	BS("Der Zwergenschmied schmiedet ein Stueck Eisen."),
  	BS("Der Schmied steckt mit einem Zischen das geschmiedete Stueck in ein Fass mit Wasser."),
  	BS("Der Schmied schlaegt mit seinen Hammer immer wieder auf das rotgluehende Stueck Eisen."),
  	BS("Mit der Zange holt der Schmied ein rotgluehendes Stueck Eisen aus der Glut der Esse."),
  	BS("Der Zwergenschmied fragt: Wollt ihr eine Massanfertigung?"),
  	BS("Der Zwergenschmied wischt sich den Schweiss von der Stirn.") }) ); //rate in %
  SetAttackChats( 15, ({
  	BS("Der Zwergenschmied bruellt: Dir werd ichs zeigen!"),
  	BS("Der Zwergenschmied sagt: Stirb, du Boesewicht."),
  	BS("Der Schmied ruft: Du Unhold, Dir werd ich den Kopf einschlagen. ") }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( "/d/andracia/yondala/friedheim/weapon/schmiedehammer.lpc" );
  command("zuecke hammer");
  CLONEME( THUM_ARMOUR+"eisenstiefel_2.lpc" );
  CLONEME( "/d/andracia/yondala/friedheim/armour/lederschuerze.lpc" );
  command("trage alles");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "sagt zu Dir: Keine Angst bei den Zwergen bist Du in Sicherheit.",
        "sagt zu "+TP->Name()+": ");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Was soll der Unmut?",
        "sagt zu "+TP->Name()+": Was soll der Unmut?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Nun lass das mal.",
        "sagt zu "+TP->Name()+": Nun lass das mal.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Lass das bleiben.",
        "sagt zu "+TP->Name()+": Lass das bleiben.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Lass das bitte bleiben.",
        "sagt zu "+TP->Name()+": Lass das bitte bleiben.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Bei den Zwergen ist man gut aufgehoben, nicht wahr?",
        "sagt zu "+TP->Name()+": Bei den Zwergen ist man gut aufgehoben, nicht wahr?");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt zu Dir: He - lass den Bloedsinn.",
        "sagt zu "+TP->Name()+": He - lass den Bloedsinn.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an. ",
        "laechelt "+TP->Name()+" an. ");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "ignoriert dich. ",
        "ignoriert "+TP->Name()+".");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "sagt zu Dir: Sei nicht traurig, alles wird wieder gut.",
        "sagt zu "+TP->Name()+": Sei nicht traurig, alles wird wieder gut.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
	// im Kampf abschalten?
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    if( TP->QueryProp(P_RACE) != "elf") {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
	  } else {
      tell_object(ob, BS(Name(WER, 1)+" tritt dich."));
      tell_room(ENV(TO), BS(Name(WER, 1)+" tritt "+ob->Name()+". " ), ({ob}));
    }
  }
}
 
void InformDefend(object enemy)
{
    Kill(enemy);
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(3) == 0)
  {
    tell_room(ENV(TO), TO->Name()+" ruft laut: \"HILFE!\" .\n");
    walk_mapping(ENV(TO)->QueryProp(P_EXITS), "ruf_hilfe", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_hilfe(string richtung, string strpfad)
{
  object ob, pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
    call_other(pfad,"???",0);
  if( !ob=present("\nzwache", pfad) ) return;
  if( ob->InFight() ) return;
  tell_room(ENV(ob), ob->Name()+" ruft laut: \"Ich eile zur Hilfe!\" .\n");
  //tell_room(ENV(TO), ob->Name()+" reagiert auf den Hilferuf und kommt "+TO->name(WEM)+" zu Hilfe. \n ");
  ob->move(ENV(TO), M_GO, "",
    "reagiert auf den Hilferuf von "+TO->name(), 
    "kommt "+TO->name(WEM)+" zu Hilfe" );
}

