#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit "/std/repair.lpc";

void init()
{
   ::init();
   if (this_player() && this_player()->id("\nzwache")) AddDefender(this_player());
   if (this_player() && this_player()->id("\nzwerg")) AddDefender(this_player());
   if (this_player() && interactive(this_player()) )
   	 if (this_player()->QueryProp(P_RACE) == "Elf" ) 
   	 	 if ( random(10) == 0) call_out( "necke_elf", 3, this_player() );
}

string q_hilfe()
{
  if( TP->QueryProp(P_RACE) != "Elf")
	  return "Frag lieber den Zwergenkoenig, der kann Dir vielleicht weiterhelfen";
	else  
	  return "Von mir bekommst Du keine Hilfe, Elf.";
}

string q_freund()
{
  if( TP->QueryProp(P_RACE) != "Elf")
	  return "Die Freundschaft eines Zwergs ist nur schwer zu erlangen.";
	else  
	  return "Dich als Freund? NIEMALS!";
}

string q_geld()
{
  if( TP->QueryProp(P_RACE) != "Elf")
	  return "Ich geb Dir nichts, versuchs doch mal mit ehrlicher Arbeit.";
	else  
	  return "Von mir bekommst Du kein Geld, Elf.";
}

string q_gems()
{
  if( TP->QueryProp(P_RACE) != "Elf")
	  return "Jeder Zwerg hortet Edelsteine, versuch dich doch selbst als Schuerfer.";
	else  
	  return "Glaub ja nicht dass Du meine Schaetze sehen darfst, Elf.";
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(22); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"zwergenschmied", "schmied", "\nschmied" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Zwergenschmied");
  SetProp( P_LONG, 
    BS("Dieser Zwergenschmied arbeitet gerade in der Schmiede. Man kann bei Ihm "+
    "den Auftrag fuer eine massgeschneiderte Ruestung aufgeben. Er hat einen leicht "+
    "versengten Bart und sehr muskuloese Oberarme. "));
  SetProp( P_GENDER, MALE);
  // SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Schmied");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_c1.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_c1.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Zwergenschmied"); //string fuer Todessequenz

  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "zwerg");
  SetProp(P_SIZE, 90+random(50) );
  SetProp(P_WEIGHT, 80000+random(16000) );
  SetProp(P_ALIGN, 200 + random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_WATER: 0.4, DT_MIND: -0.4]) );

  SetProp(P_MSGIN, "stapft herbei");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "plumpst aus einer Wolke.");
  SetProp(P_MMSGOUT, "verkruemelt sich");

  SetProp(P_DIE_MSG,  " haucht seinen letzten Zwergenatem aus.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, ({"%s, das nutzt nichts. Ich komme wieder!", "Glaube ja nicht dass das ungestraft bleibt, %s.", 
  	"%s, warum machst Du sowas?", "Was hab ich armer Zwerg Dir denn getan, %s?",
  	"%s benutzt unzulaessige Zaubersprueche."  }));
  SetProp(P_KILL_MSG, "Leg dich nicht mit Zwergen an!");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name()+" will Deine Sachen nicht tragen.\n" }) );

  AddInfo( DEFAULT_INFO, ({"Da bin ich ueberfragt.", "Frag mich doch lieber was anderes.",
  "Davon weiss ich nichts."}), "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Liebste von Yason.", "sagt: ");
  AddInfo( "aginor", "Aginor macht dass in Andracia die Sonne scheint und das Leben weitergeht.", "sagt: ");

  AddInfo( ({"zwerg", "zwerge"}), "Ich bin einer.", "sagt: ");
  AddInfo( ({"elf", "elfen"}) , "Diese hochnaesigen Spitzohren kann ich nicht ausstehen.", "sagt: ");

  AddInfo( ({"koenig"}), "Unser Zwergenkoenig heisst Orrnuf.","sagt: ");
  AddInfo( ({"hilfe", "quest"}), #'q_hilfe,"sagt: ");
  AddInfo( ({"freundschaft"}), #'q_freund,"sagt: ");
  AddInfo( ({"geld"}), #'q_geld,"sagt: ");
  AddInfo( ({"edelsteine"}), #'q_gems,"sagt: ");

  AddInfo( ({"massanfertigung", "anfertigung"}), 
    "Zur Zeit bin ich leider mit Auftraegen ueberlastet. Kommt spaeter wieder.", "sagt: ");

  AddInfo( ({"welt", "andracia"}), "Diese Welt wird Andracia genannt. ", "sagt: ");
  AddInfo( ({"essen", "trinken"}), "In den Tavernen bekommt man auch neben dem guten Zwergenbier "+
  "auch immer etwas zum essen. ", "sagt: ");

  AddInfo( ({"targon", "kneipe"}), 
    "Unsere gutbesuchte Kneipe wird von Targon gefuehrt. Er braut da beste Zwergenbier in ganz Thumfels. "+
    "Er hat auch eine kleine Kueche dort und sorgt damit auch fuer die Verpflegung der Gaeste Thumfels'.", "sagt: ");
  AddInfo( ({"nimorbak"}), 
    "Der Haendler Nimorbak verkauft allerlei Kleinkram, falls ihr also Fackeln oder aehnliches fuer eure "+
    "Expedition tiefer in die Unterwelt benoetigt so ist er derjenige der Euch weiterhelfen kann.", "sagt: ");
  AddInfo( ({"orrnuf"}), 
    "Unser Koenig Orrnuf regiert schon seit 108 Jahren Thumfels.", "sagt: ");
  AddInfo( ({"barabasch"}), 
    "Barabasch handelt mit Waffen und Ruestungen. Nicht alle seine Waren sind mit Zwergenhand erschaffen aber "+
    "er achtet darauf dass sein Angebot immer fuer jeden das richtige dabei hat. ", "sagt: ");
  AddInfo( ({"schmied", "schmiede"}), 
    "In meiner Schmiede kann man massgeschneiderte Ruestungen in Auftrag geben. "+
    "Dieser Dienst mag euch sehr teuer erscheinen aber die zwergischen Ruestungen sind ihren Preis wert, "+
    "das kann ich euch versichern.", "sagt: ");
  AddInfo( ({"zwirbelstein"}), 
    "Ihr sucht die Menschen? Der Aufzug zur Oberflaeche ist im Sueden Thumfels'. Oben angekommen muesst Ihr Euch "+
    "nach Westen wenden.", "sagt: ");
  AddInfo( ({"steine"}), 
    "Hier in der Tiefe des Berges sind viele Steine. Ihr meint wohl Edelsteine, oder?", "sagt: ");
  AddInfo( ({"gebirge", "berge"}), 
    "Ihr befindet Euch hier tief im Berg. Manche sagen zu den Stollen und Hoehlen die Unterwelt.", "sagt: ");
  AddInfo( ({"hoehlen", "hoehle", "stollen", "unterwelt", "labyrinth"}),
    "Die Hoehlen und Stollen durchziehen die Berge wie ein grosses Labyrinth. Trotz dem fehlende Licht und "+
