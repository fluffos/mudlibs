// Schlafsaal
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Schlafsaal" );
  SetProp( P_INT_LONG,
    BS("Diese Halle wurde fuer Besucher eingerichtet die in der Zwergenstadt "+
    "fuer eine oder mehr Naechte verweilen wollen. Einige strohgefuellte Matten "+
    "liegen als Schlafstellen bereit. Einige Truhen stehen an der Wand in denen "+
    "die Reisenden ihr Wertsachen verwahren koennen. Der Laerm der angegliederten "+
    "Schenke dringt nur sehr dumpf bis hier in den Schlafsaal."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Aus der angrenzenden Schenke dringen gedaempft die Rufe und Lieder "+
    "der angeheiterten Zwerge."));
  AddSound( ({ "zwerge", "rufe", "lieder", "laerm", "text", "geraeusche" }),
    BS("Leider sind die Geraeusche der angrenzenden Schenke zu sehr gedaempft und "+
    "Du kannst nicht mal den Text der laut gesungenen Lieder verstehen."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach trockenem Stroh."));
  AddSmell( ({ "stroh", "geruch" }),
    BS("Die Matten scheinen mit Stroh gefuellt zu sein, und daher kommt wohl auch der Geruch."));

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus einfachen quadratischen Steinplatten."));
  AddDetail( ({ "decke" }),
    BS("An der Decke haengt eine abgednkelte Laterne die den raum nur spaerlich erleuchtet. "+
    "es ist gerade hell genug um zu einer freien Schlafstelle zu gelangen und in den Truhen "+
    "seine Sachen zu verstauen und dunkel genug um in einen unruhigen Schlaf zu fallen. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende bestehen aus grob behauenem Fels."));

  AddDetail( ({ "halle", "raum", "schlafsaal", "saal" }),
    BS("Diese Halle wurde fuer Besucher eingerichtet die in der Zwergenstadt "+
    "fuer eine oder mehr Naechte verweilen wollen. "));
  AddDetail( ({ "besucher", "reisenden", "reisende" }),
    BS("Du scheinst ja auch einer der Besucher der Stadt zu sein."));
  AddDetail( ({ "stadt", "zwergenstadt", "thumfels", "berg" }),
    BS("Du befindest dich mitten in der Zwergenstadt Thumfels."));
  AddDetail( ({ "nacht", "naechte", "tag" }),
    BS("Man kann hier tief im Berg nicht erkennen ob an der Oberflaeche nun Nacht oder Tag herrscht."));
  AddDetail( ({ "matte", "matten", "schlafstelle", "schlafstellen" }),
    BS("Auf den Matten koennen sich Reisende und andere Besucher der Zwergenstadt ausruhen und schlafen."));
  AddDetail( ({ "truhe", "truhen", "wertsachen", "sachen" }),
    BS("In den Truhen koennen Reisende und Besucher ihre Sachen verstauen und sicher verschliessen."));
  AddDetail( ({ "schenke" }),
    BS("Der Laerm der angrenzenden Schenke kommt nur noch gedaempft in diesem Raum an."));
  AddDetail( ({ "stroh", "fuellung" }),
    BS("Die Matten sind mit Stroh gefuellt. "));
  AddDetail( ({ "laterne", "licht", "dunkel" }),
    BS("Die Laterne , die an der Decke haengt, erhellt den Schlafsaal nur duerftig."));
  AddDetail( ({ "schlaf" }),
    BS("Versuch doch einfach 'schlafe ein'."));
  AddDetail( ({ "steinplatten", "oberflaeche" }),
    BS("Die Steinplatten, die den Boden bilden, haben eine glatte Oberflaeche. "));
  AddDetail( ({ "fels" }),
    BS("Nur einfacher behauener Fels."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_e4.lpc" );
}

