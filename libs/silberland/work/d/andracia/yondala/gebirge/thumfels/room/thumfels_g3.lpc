// Blindschacht zum Abbaugebiet
#include "../def.h"

inherit "std/room";

#include <properties.h>

string smell_erz(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes am Erz riechen.");
	else return	BS("Das scheint gutes Eisenerz mit ein bischen Feldspat zu sein.");
}

string smell_kohle(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes an der Kohle riechen.");
	else return BS("Eindeutig der Geruch schwarzer Steinkohle. Brennt sehr heiss und auch aussergewoehnlich lange.");
}

string unt_erz(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes am Erz erkennen.");
	else return	BS("Eindeutig gutes Eisenerz mit ein bischen Feldspat.");
}

string unt_kohle(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes an der Kohle erkennen.");
	else return BS("Eindeutig schwarze Steinkohle. Brennt sehr heiss und auch aussergewoehnlich lange.");
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Foerderschacht zum Abbaugebiet" );
  SetProp( P_INT_LONG,
     BS("Ein steiler Schacht fuehrt hier tiefer in den Berg hinein. Der Schacht ist leider viel zu steil um "
     "hinabklettern zu koennen. Die Schienen einer Lorenbahn fuehren in zwei Spuren in die Tiefe. Dem "+
     "Staub und den Gesteinsbrocken die hier liegen nach zu urteilen wird aus diesem Schacht Erz und Kohle "+
     "gefoerdert. Im Sueden befindet sich in Sichtweite die grossen Erz- und Kohlelager der Zwerge. Durch die "+
     "Tuer im Westen kommt man wohl auf die Strassen Thumfels."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Man hoert das Rumpeln der Lorenbahn die sich auf den Schienen den steilen Schacht hinauf und hinab "+
    "bewegen."));
  AddSound( ({ "rumpeln", "lorenbahn", "bahn", "loren", "lore", "schienen" }),
    BS("Die Lorenbahn rumpelt wohl langsam den Schienen entlang. "));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach Erz und Kohle."));
  AddSmell( ({ "erz", "eisenerz", "feldspat" }),
    #'smell_erz );
  AddSmell( ({ "kohle", "steinkohle" }),
    #'smell_kohle );

  AddDetail( ({ "boden" }),
    BS("Ganz normaler Fels bildet den Boden. Eine dunkle Staubschicht bedeckt den Fels an Stellen "+
    "an denen nur selten jemand seinen Fuss stellt. Ansonsten liegen nur ein paar kleine Erzbrocken "+
    "und kleinere Kohlestuecke herum."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten dieses Ende des Foerderschachts. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Ganz normaler Fels bildet die Waende. "));

  AddDetail( ({ "raum", "ende" }),
    BS("Hier scheint das obere Ende des Foerderschachts zu sein. Eine Lorenbahn fuehrt hinab zum Abbaugebiet."));
  AddDetail( ({ "foerderschacht", "schacht" }),
    BS("Der steile Foerderschacht fuehrt noch tiefer in den Berg hinein."));
  AddDetail( ({ "berg" }),
    BS("Du befindest dich tief im Berg."));
  AddDetail( ({ "schienen", "lorenbahn", "spuren", "spur", "bahn" }),
    BS("Auf den Schienen rumpelt eine Lorenbahn den steilen Foerderschacht rauf und runter. Ein paar "+
    "Umlenkrollen fuehren das Seil der einen Lorenbahn zur anderen Lorenbahn. Wenn also die eine Lore "+
    "nach unten faehrt wird die Lore auf der anderen Bahn nach oben gezogen."));
  AddDetail( ({ "tiefe" }),
    BS("Dort in der Tiefe, am Ende des Foerderschachts, schient wohl das Abbaugebiet fuer Erz und Kohle zu sein."));
  AddDetail( ({ "staub", "staubschicht", "schicht", "foerdern", "geschaeft" }),
    BS("Das Foerdern von Erz und Kohle scheint ein besonders staubiges Geschaeft zu sein."));
  AddDetail( ({ "gesteinsbrocken", "brocken" }),
    BS("Am Boden liegen mehrere kleine Erzbrocken und Kohlestuecke herum."));
  AddDetail( ({ "erz", "eisenerz", "erzbrocken" }),
    #'unt_erz );
  AddDetail( ({ "kohle", "steinkohle", "kohlestuecke" }),
    #'unt_kohle );
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um dieses Ende des Foerderschachts zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Nur ganz normaler Fels."));
  AddDetail( ({ "abbau", "abbaugebiet", "gebiet" }),
    BS("Das Abbaugebiet von Erz und Kohle scheint sich am unteren Ende des Schachts zu befinden."));
  AddDetail( ({ "umlenkrollen", "rollen", "seil" }),
    BS("Das Seil das die beiden Loren auf den Schienen verbindet wird ueber mehrere Umlenkrollen geleitet. "));
  AddDetail( ({ "sichtweite" }),
    BS("Du kannst von hier aus die Erz- und Kohlelager im Sueden sehen. Dort scheint auch alles mit Laternen "+
    "ausgeleuchtet zu sein."));
  AddDetail( ({ "sueden", "lager", "erzlager", "kohlelager" }),
    BS("Im Sueden befinden sich die Erz und Kohlelager der Zwerge. "));
  AddDetail( ({ "westen", "tuer" }),
    BS("Durch die Tuer im Westen kommt man wohl auf die Strassen von Thumfels"));
  AddDetail( ({ "strassen", "thumfels", "teil", "zwergenstadt", "stadt" }),
    BS("Das hier ist ein Teil der Zwergenstadt Thumfels. Die Strassen, die durch die unterirdische Stadt der "+
    "Zwerge fuehren befinden sich wohl hinter der Tuer im Westen. "));

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_g4.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_f3.lpc" );
  
  // AddItem( THUM_OBJ+"lorenbahn.lpc" );
}

