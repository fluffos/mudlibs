#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Topfhelm");
  SetProp(P_LONG, BS(
    "Ein einfacher Helm aus Eisen. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Topfhelm");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "eisenhelm", "topfhelm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_LEATHER:10, MAT_IRON:80]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


