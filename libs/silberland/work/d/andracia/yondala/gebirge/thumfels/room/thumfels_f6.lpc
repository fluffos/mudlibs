// Hochofen
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hochofen" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich hier direkt an den zwergischen Hochoefen. Hier herrscht eine unertraegliche Hitze. "+
     "Durch einen schmalen Durchgang im Nordosten kommt man wohl du den Erz- und Kohlelagern. Im Westen kann man "+
     "die angegliederte Giesserei erkennen. Durch die Tuer im Norden kommt man wohl auf die Strassen Thumfels."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Man kann das fluessige Metall im Hochofen brodeln hoeren."));
  AddSound( ({ "brodeln", "hochofen" }),
    BS("Im Hochofen brodelt es. Das fluessige Metall wartet wohl nur darauf von zwergischen Schmieden "+
    "verarbeitet zu werden."));
  AddSmell( DEFAULT_SMELL,
    BS("Es herrscht hier der allesdurchdringend Gestank von verbrennender Schlacke und fluessigem Metall. "));
  AddSmell( ({ "gestank", "schlacke", "metall", "geruch" }),
    BS("Hier herrscht der typische Geruch eines Hochofens: verbrennende Schlacke und fluessiges Metall. "));

  AddDetail( ({ "boden", "felsboden" }),
    BS("Auf dem rauhen Felsboden sind mehrere Metallspritzer erkaltet und bilden komisches Fleckenmuster. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten neben dem roten Schimmer des fluessigen Metalls die Hochoefen. "));
  AddDetail( ({ "waende", "wand", "felswaende" }),
    BS("Auch an den Felswaenden sind ein paar Metallspritzer zu sehen."));

  AddDetail( ({ "hochofen", "hochoefen", "ofen", "oefen" }),
    BS("Du befindest dich hier direkt an den zwergischen Hochoefen. Hier herrscht eine unertraegliche Hitze. "));
  AddDetail( ({ "hitze" }),
    BS("Die Hochoefen strahlen eine immense Hitze aus. Man kann es auf dem ganzen Koerper spueren"));
  AddDetail( ({ "nordosten", "durchgang", "lager", "erzlager", "kohlelager" }),
    BS("Durch den kleinen Durchgang im Nordosten kommt man wohl zu den Erz- und Kohlelagern um Nachschub fuer die "+
    "Hochoefen zu holen."));
  AddDetail( ({ "westen", "giesserei" }),
    BS("Die angegliederte Giesserei im Westen ist wohl dazu gedacht das fluessige Metall in Form zu bringen. "));
  AddDetail( ({ "norden", "tuer" }),
    BS("Durch die Tuer im Norden kommt man wohl auf die Strassen von Thumfels"));
  AddDetail( ({ "strassen", "thumfels", "teil", "zwergenstadt", "stadt" }),
    BS("Das hier ist ein Teil der Zwergenstadt Thumfels. Die Strassen, die durch die unterirdische Stadt der "+
    "Zwerge fuehren befinden sich wohl hinter der Tuer im Norden. "));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "neben dem roten Schimmer des fluessigen Metalls ausreichend Licht um die Hochoefen zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Nur ganz normaler Fels."));
  AddDetail( ({ "form", "nachschub", "sachen", "stelle", "erz" }),
    BS("Schau dich doch fuer solche Sachen an anderer Stelle um. "));
  AddDetail( ({ "flecken", "muster", "fleckenmuster", "spritzer", "metallspritzer" }),
    BS("Hin und wieder spritzt wohl ein bischen fluessiges Metall aus dem Ofen und benetzt Waende und Boden. "));
  AddDetail( ({ "schimmer", "gluehen" }),
    BS("Vom fluessigen Metall geht ein rotes Gluehen aus. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( ({ "nordosten" }), THUM_ROOM+"thumfels_g5.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_f5.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_e6.lpc" );

  AddRoomMessage( ({ BS("Ein kleiner Spritzer fluessiges Metall faellt aus dem brodelnden Hochofen."),
                     "","","","","" }),
                  25,"metall_hit" );
}

void metall_hit(int mess)
{
  object ob;
  if(mess!=0) return;
  for(ob=first_inventory(TO);ob;ob=next_inventory(ob)) {
    if(interactive(ob) && random(20)==0) {
      tell_room(TO, BS("Ein herumfliegender Spritzer fluessigen Metalls hat "+ob->name()+
      " getroffen und verbrennt "+ob->QueryPronoun(WEN)+" fuerchterlich.") ,({ob}));
      ob->do_damage(15, "ein Spritzer fluessigen Metalls");
      tell_object(ob,BS("Du wurdest von einem herumfliegenden Spritzer fluessigen Metalls "+
      "getroffen und an dieser Stelle hast Du nun eine schlimme Verbrennung") ); 
    }
  }
}
