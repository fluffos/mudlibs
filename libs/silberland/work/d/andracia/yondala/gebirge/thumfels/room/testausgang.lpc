#include "../def.h"

inherit "std/room";

#include <properties.h>

string EINGANG = THUM_ROOM+"thumfels_a1.lpc";

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Draussen" );
  SetProp( P_INT_LONG,
    "Du bist nun ausserhalb von Thumfels. Ein grosses Tor versperrt dir den Zutritt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddCmd( ({ "bitte", "ersuche", "erbitte" }), "cmd_bitte");
  AddCmd( ({ "klopfe" }), "cmd_klopfe");
  
}

int cmd_bitte(string str)
{
	notify_fail(BS("Um was willst Du bitten?"));
	if( str != "einlass" && str != "um einlass" && str !="zugang" && str != "um zugang" ) return 0;
	if( !present( "\ntorwache", to_object(EINGANG) ) ) {
		write( BS("Niemand antwortet.") );
		return 1;
	} else {
		// gibt es denn irgendwelche Gruende warum jemand nicht eingelassen wird? Zu boese?
		write( BS("Der zwergische Torwaechter beaeugt dich eingehend und laesst dich passieren.") );
		TP->move(EINGANG, M_GO);
		return 1;
	}
}

int cmd_klopfe(string str)
{
	notify_fail(BS("Wo willst Du klopfen??"));
	if( str != "tor" && str != "an tor" ) return 0;
	if( !present( "\ntorwache", to_object(EINGANG) ) ) {
		write( BS("Niemand antwortet.") );
		return 1;
	} else {
		write( BS("Der zwergische Torwaechter beaeugt dich eingehend und fragt nach deinem Begehr.") );
		return 1;
	}
}