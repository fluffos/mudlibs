#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Siberkette");
  SetProp(P_LONG, "Ein silberne Kette, welch ein Schatz!\n" );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kette");
  SetProp(P_NAME_ADJ, "silbern");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette", "silberkette"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_SILVER ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
