// Gemischwarenladen
#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Gemischtwarenladen" );
  SetProp( P_INT_LONG,
    BS("Dieser Laden ist fuer eine Zwergenstadt ungewoehnlich: keine "+
    "Waffen und keine Ruestungen liegen hier in den Regalen, nur so Zeug "+
    "wie Fackeln, Schaufeln und Seile bilden hier das Angebot. "+
    "Ein bischen Lebensmittel und Tabak sind hier scheinbar auch staendig"+
    "verfuegbar."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );
  // Props fuer shops
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\nnimorbak");
  SetProp(P_SHOPKEEPER_NAME, "Nimorbak");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom(THUM_ROOM+"storage_c4.lpc");
  // SetProp(P_SPECIAL_SHOP, ([ ??? ])

  AddDetail( ({ "boden" }),
    BS("Man geht hier auf staubigem blanken Fels."));
  AddDetail( ({ "decke" }),
    BS("An der, aus dem Fels geschlagenen Decke haengen mehrere Laternen, die "+
    "den Verkaufsraum erleuchten."));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende wurden mit Regalen vollgestellt. Fackel, Schaufeln und vieles "+
    "mehr liegen darauf. Lebensmittel und Tabak sind hier auch zu bekommen. "));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst hier nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst hier nichts besonderes riechen."));

  AddDetail( ({ "laden", "raum", "verkaufsraum", "raeume", "gemischtwarenladen" }),
    BS("Dies ist der Gemischtwarenladen von Nimorbak. Die Regale sind gefuellt "+
    "mit allerlei Zeug wie Fackeln, Seilen und Schaufeln." ));
  AddDetail( ({ "stadt", "zwergenstadt", "thumfels" }),
    BS("Du befindest dich in der Zwergenstadt Thumfels. Schau dich um - es gibt viel "+
    "zu sehen hier. "));
  AddDetail( ({ "waffen", "ruestungen" }),
    BS("Ruestungen und Waffen scheinen hier nicht verfuegbar zu sein."));
  AddDetail( ({ "regal", "regale" }),
    BS("Die Regale an den Waenden sind vollgeladen mit allerlei Zeug wie Fackeln, "+
    "Seilen und Schaufeln. "));
  AddDetail( ({ "zeug", "fackeln", "fackel", "seile", "seil", "schaufeln", "schaufel",
                "lebensmittel", "tabak", "angebot", "angebote" }),
    BS("Bis auf Waffen und Ruestungen kann man hier alles bekommen. Frag einfach "+
    "Nimorbak nach seinen Angeboten. "));
  AddDetail( ({ "fels", "felsen" }),
    BS("Die Raeume der Zwergenstadt sind direkt in den harten Fels gemeisselt. "));
  AddDetail( ({ "laterne", "laternen" }),
    BS("Die Laternen, die an der Decke befestigt sind, erleuchten den Raum. "));
  AddDetail( ({ "staub" }),
    BS("Der Boden und auch einige der Waren sind mit etwas Staub bedeckt. Nur die "+
    "Lebensmittel sind staubfrei. Nimorbak, der Ladenbesitzer scheint nicht besonders "+
    "reinlich zu sein. "));

/*
  AddDetail( ({ "" }),
    BS("") );
*/

  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_b4.lpc" );

  AddItem( THUM_NPC+"zw_nimorbak.lpc", REFRESH_DESTRUCT );

}

// Ankauf-Funktion ueberladen und P_ARMOUR_TYPE und P_WEAPON_TYPE aussortieren 
varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryProp(P_WEAPON_TYPE) != 0 )
  {
    write(break_string( "Tut mir leid, aber Waffen kaufen wir hier nicht.", 78, prefix));
    return 1;
  }
  if( ob->QueryProp(P_ARMOUR_TYPE) !=0 )  
  {
    write(break_string( "Tut mir leid, aber Ruestungen kaufen wir hier nicht.", 78, prefix));
    return 1;
  }
 	return ::do_sell(ob, force, prefix, limit);
}
