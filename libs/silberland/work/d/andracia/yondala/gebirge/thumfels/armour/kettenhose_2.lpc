#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Kettenhose");
  SetProp(P_LONG, BS(
    "Eine normale Kettenhose aus Eisen. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kettenhose");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "kettenhose" }) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:6, MAT_IRON:94]) );
  SetProp(P_WEIGHT, 3600);
  SetProp(P_VALUE, 2290);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:4]) );
}


