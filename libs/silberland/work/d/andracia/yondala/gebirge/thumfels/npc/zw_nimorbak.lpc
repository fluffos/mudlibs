#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte fuer THUM_NPC des Level x

  //Properties
  AddId(({"nimorbak", "haendler", "\nnimorbak" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Nimorbak, ein Zwergenhaendler");
  SetProp( P_LONG, 
    BS("Dies ist Nimorbak, ein Haendler. Er hat einen langen grauen Bart und grinst dich freundlich an."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Nimorbak");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, THUM_ROOM + "thumfels_c4.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, THUM_ROOM + "thumfels_c4.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Zwergenhaendler"); //string fuer Todessequenz
 
  //Chats
  SetChats( 1, ({
  	BS("Nimorbak kratzt sich im Bart."),
  	BS("Der Haendler Nimorbak sortiert seine Papiere."), 
  	BS("Nimorbak ruft: Hier gibts alles was man sonst so braucht."),
  	BS("Nimorbak ruft: Nicht draengeln!") }) ); //rate in %
  SetAttackChats( 5, ({
  	BS("Nimorbak bruellt: Dir werde ichs zeigen!"),
  	BS("Nimorbak sagt: Ich werde meine Axt dir zwischen die Augen setzen."),
  	BS("Nimrobak schimpft: Meine Kasse raubst Du nicht aus!") }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"angebot", "angebote"}), 
    "Ihr koennt euch gerne meine Angebote anschauen. Was soll ich euch zeigen?", "sagt: ");

  //Ausruestung
  SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( THUM_WEAPON+"kampfaxt_1.lpc" );
  command("zuecke waffe");
  CLONEME( THUM_ARMOUR+"eisenpanzer_1.lpc" );
  CLONEME( THUM_ARMOUR+"kettenhose_2.lpc" );
  command("trage alles");
}
