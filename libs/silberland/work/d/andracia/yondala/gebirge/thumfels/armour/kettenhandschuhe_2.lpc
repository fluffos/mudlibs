#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Kettenhandschuhe");
  SetProp(P_LONG, BS(
    "Eine normales Paar Kettenhandschuhe aus Eisen. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Kettenhandschuhe");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handschuhe", "kettenhandschuhe" }) );
  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_LEATHER:6, MAT_IRON:94]) );
  SetProp(P_WEIGHT, 620);
  SetProp(P_VALUE, 1750);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:3, A_DEX:2]) );
}


