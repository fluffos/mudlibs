#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein gutes Zwergenschwert");
  SetProp(P_LONG, "Ein gutes Zwergenschwert. Geeignet um tiefe Wunden zu schlagen.\n" );
  // SetProp(P_INFO, "Mit diesem Schwert kann man sich bestimmt auch an groessere Feinde wagen. ");
  SetProp(P_NAME, "Zwergenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "zwergenschwert"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 3800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:5, A_STR:4, P_RACE:"Zwerg"]) );

//  SetProp(P_AUTOLOADOBJ, 1);
}
