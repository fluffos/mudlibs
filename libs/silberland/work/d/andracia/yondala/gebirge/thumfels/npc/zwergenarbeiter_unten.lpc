  }
}

void abgeliefert(string text,string ort)
{
  object ob;
  if( !ob=present("\ntransobj")) {
    i_am_lost();
    return;
  }
  if( file_name(ENV(TO)) != "/gilden/"+ort)
  if( file_name(ENV(TO)) != THUM_ROOM+ort) {
    ob->remove();
    i_am_lost();
    return;
  } 
  tell_room(ENV(TO), BS(Name()+" bringt hier "+text+" "+ob->name()+" ins Lager. ") );
  ob->remove();
}

void commandier (string dir)
{
  command(dir);
}

void home_test()
{
  if( file_name(ENV(TO))!=THUM_ROOM + "thumfels_c6") {
    i_am_lost();
    return;
  }
}
  
void InformDefend(object enemy)
{
    Kill(enemy);
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(3) == 0)
  {
    tell_room(environment(TO), TO->Name()+" ruft laut: \"HILFE!\" .\n");
    walk_mapping(environment(TO)->QueryProp(P_EXITS), "ruf_hilfe", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_hilfe(string richtung, string strpfad)
{
  object ob, pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
    call_other(pfad,"???",0);
  if( !ob=present("\nzwache", pfad) ) return;
  if( ob->InFight() ) return;
  tell_room(environment(ob), ob->Name()+" ruft laut: \"Ich eile zur Hilfe!\" .\n");
  //tell_room(environment(TO), ob->Name()+" reagiert auf den Hilferuf und kommt "+TO->name(WEM)+" zu Hilfe. \n ");
  ob->move(environment(TO), M_GO, "",
    "reagiert auf den Hilferuf von "+TO->name(), 
    "kommt "+TO->name(WEM)+" zu Hilfe" );
}

