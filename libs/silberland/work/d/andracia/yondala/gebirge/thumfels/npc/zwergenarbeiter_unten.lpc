    call_out( "commandier", 21, "sueden" );
    call_out( "commandier", 25, "westen" );
    call_out( "commandier", 29, "sueden" );
    call_out( "home_test", 33 );
    break;
  case 5: // Privathaus 3 (f2)
    call_out( "commandier", 1, "norden" );
