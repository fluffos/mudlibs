// Ausladen macht der Foerderkorb
// Der Foerderkorb schickt die Arbeiter los "transobj" wegzubringen
// Einladen macht der Foerderkorb

//inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit THUM_NPC + "zwerg_raw.lpc";

int i_am_lost()
{
	while (remove_call_out("commandier") != -1) /* continue */ ;
	move( THUM_ROOM + "thumfels_c6.lpc", M_GO, "zurueck zur Sohle des Aufzugs. \n", "rennt");
}

void reset()
{
  ::reset();
  if(objectp(environment(this_object()))) {
      if( file_name(ENV(TO))!=THUM_ROOM + "thumfels_c6" && !present("\ntransobj")) i_am_lost();
  }
}

void init()
{
   ::init();
   if (this_player() && this_player()->id("\nzwache")) AddDefender(this_player());
   if (this_player() && this_player()->id("\nzwerg")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwergenarbeiter");
  SetProp(P_LONG,
    "Ein Zwergenarbeiter der scheinbar Waren aus dem Foerderkorb wegbringt.");
  SetProp(P_NAME, "Zwergenarbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "zwergenarbeiter", "arbeiter", "\ntraeger", "\nzwerg"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "");
  SetProp(P_SIZE, 0);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-THUM_NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  SetProp(P_LOG_INFO, "missing_answers");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name()+" will Deine Sachen nicht tragen.\n" }) );

  /*
  SUID;
  CLONEME(THUM_WEAPON+"axt" );
  commandier("zuecke axt"); // oder erst beim kampfstart zuecken?
  CLONEME(THUM_ARMOUR+"" );
  commandier("trage alles");
  */
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

