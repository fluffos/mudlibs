//Hier sollen die Sklills abgefragt werden, funktioniert aber noch nicht

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Strasse Thumfels" );
  SetProp( P_INT_LONG,
    BS("Diese Strasse von Thumfels ist ein hoher, breiter Stollen von dem ab "+
    "die Wohnungen der Zwerge in den Fels gehauen wurden. Die Felsen sind sehr "+
    "glatt bearbeitet und ueberall sind Reliefbilder mit zwergischen "+
    "Szenen eingemeisselt. Die Eingaenge zu den Zwergenbehausungen sind "+
    "mit steinernen Saeulen und Ornamenten umfasst. Laternen, die an langen "+
    "Ketten von der Decke haengen, beleuchten die Strasse. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst das geschaeftige Treiben der Zwerge. Trinklieder aus den Tavernen, "+
    "brummige Zwergenstimmen in angeregter Unterhaltung und das Geraeusch schwerer "+
    "Stiefel die auf der Strasse gehen. "));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier etwas muffig und nach Zwerge. "));
  AddSound( ({ "trinklieder", "lieder", "texte", "texten" }),
    BS("Aus der Taverne dringen von Zwergen gesungene Trinklieder bis an Dein Ohr. "+
    "Um den Texten zu lauschen solltest Du dich auch zum Umtrunk in die Taverne "+
    "begeben. "));
  AddSound( ({ "stimme", "stimmen", "unterhaltung", "unterhaltungen", 
               "zwerge", "zwerg", "gespraech", "gespraeche", "belang", "zwergenstimmen" }),
    BS("Du kannst leider nicht verstehen was die Zwerge miteinander reden, "+
    "warscheinlich sind die Gespraeche der Zwerge hier auf der Strasse eh nicht von "+
    "Belang fuer einen Reisenden. "));
  AddSound( ({ "stiefel", "strasse", "klacken", "geraeusch" }),
    BS("Die schweren Stiefel vorbeigehender Zwerge geben ein lautes klacken auf den "+
    "Steinplatten des Bodens wieder. "));
  AddSound( ({ "treiben", "stadt", "zwergenstadt", "thumfels" }),
    BS("Klackende Stiefel, redende Zwerge, Trinklieder aus einer Taverne - die "+
    "Geraeusche einer Zwergenstadt. "));
  AddSmell( ({ "luft" }),
    BS("Die Luft scheint hier doch etwas muffig, aber das scheint die Zwerge nicht "+
    "zu stoeren. "));
  AddSmell( ({ "zwerge", "zwerg" }),
    BS("Hier riecht es eindeutig auch nach Zwergen: ungewaschene Baerte, "+
    "verkleckertes Zwergenbier, durchschwitzte Kettenhemden."));

  AddDetail( ({ "boden", "strasse" }),
    BS("Die Strasse besteht aus Steinplatten die ein kompliziertes Muster "+
    "bilden. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten die Strasse. "));
  AddDetail( ({ "waende", "wand" }),
    BS("In den Waenden sind Reliefbilder eingemeisselt. Auch die Eingaenge zu "+
    "den Wohnungen der Zwerge sind mit steinernen Saeulen und Ornamenten Teil "+
    "der Waende. "));
  AddDetail( ({ "thumfels", "stadt", "zwergenstadt" }),
    BS("Du befindest Dich mitten in der Zwergenstadt Thumfels. Dieser hohe, breite "+
    "Stollen ist eine der Strassen von der ab die Zwerge ihre Behausungen in den "+
    "Fels geschlagen haben. Laternen, die an langen Ketten von der Decke haengen, "+
    "beleuchten den Stollen. "));
  AddDetail( ({ "stollen", "meissel" }),
    BS("Mit feinem Meissel wurden hier die Waende bearbeitet. Der Fels ist glatt "+
    "behauen und Reliefbilder schmuecken die Waende. Die Eingaenge zu den "+
    "Zwergenbehausungen wurden mit Saeulen und Ornamenten geschmueckt. "+
    "Die Strasse selbst besteht aus Steinplatten die ein kompliziertes Muster "+
    "bilden. Laternen, die an langen Ketten von der Decke haengen, sorgen "+
    "fuer ausreichende Beleuchtung. "));
  AddDetail( ({ "wohnung", "wohnungen", "zwergenwohnung", "zwergenwohnungen", 
                "behausung", "behausungen", "zwergenbehausung", "zwergenbehausungen" }),
    BS("Schwere, eisenbeschlagene Tueren versperren Dir den Zugang zu den "+
    "Zwergenwohnungen. Um die Eingaenge herum hannst Du die zwergische "+
    "Steinmetzarbeiten in Form von Saeulen und Ornamenten bewundern. "));
  AddDetail( ({ "fels", "felsen", "steine", "gestein" }),
    BS("Zwergische Steinmetze haben diesen Stollen in den Fels gehauen. Die "+
    "kuenstlerischen Meisterleistungen in Form von Reliefbilder schmuecken die "+
    "unterirdische Strasse. "));
  AddDetail( ({ "eingang", "eingaenge" }),
    BS("Schwere, eisenbeschlagene Tueren, umrahmt von Saeulen und Ornamenten, "+
    "fuehren wohl in Zwergenwohnungen. "));
  AddDetail( ({ "saeulen", "saeule", "ornament", "ornamente" }),
    BS("Die Eingaenge zu den Zwergenwohnungen sind damit geschmueckt. Es sind "+
    "bewundernswerte, zwergische Steinmetzarbeiten die vom handwerklichen "+
    "Geschick der Zwerge zeugen."));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um die Strasse zu beleuchten. "));
  AddDetail( ({ "platte", "platten", "steinplatte", "steinplatten" }),
    BS("Die Steinplatten des Bodens bilden ein kompliziertes Muster. Die Fugen "+ 
    "zwischen den Platten sind sehr schmal und zeugen von den handwerklichen "+
    "Faehigkeiten der zwergischen Steinmetze."));
  AddDetail( ({ "muster", "motiv", "motive", "quadrat", "quadrate", "form" 
                "raute", "rauten", "dreieck", "dreiecke", "wuerfel" }),
    BS("Das Muster der Steinplatten am Boden besteht aus vielen verschiedenen, "+
    "sich wiederholenden Formen. Quadrate und Rauten bilden achteckige Motive, "+
    "die sich gegenseitig ueberdecken. Dieses Motiv geht ueber in eine von "+
    "Dreiecken umschlossenes Bild von Wuerfeln. Es hat noch mehr formenreiche "+
    "Motive in den Mustern ... Dir schwindelt schon ein bischen. "));
  AddDetail( ({ "tuer", "tueren", "eisenbeschlag", "eisenbeschlaege", "zugang" }),
    BS("Die Tueren zu den Zwergenwohnungen sind alle fest verschlossen. Durch die "+
    "Eisenbeschlaege sind die Tueren fuer Diebe fast unueberwindlich. "));
  AddDetail( ({ "steinmetz", "steinmetze", "meisterleistung", "meisterleistungen",
                "bildhauer", "fugen", "steinmetzarbeiten" }),
    BS("Die Meisterleistungen der zwergischen Steinmetze und Bildhauer ist im ganzen "+
    "Andracia unuebertroffen."));
  AddDetail( ({ "andracia", "gefahren", "diebe" }),
    BS("So einfach ist das nicht.") );
  AddDetail( ({ "baerte" }),
    BS("Das lassen die Zwerge leider nicht zu.") );
  AddSpecialDetail( ({ "faehigkeiten", "geschick" }), "unt_faehigkeiten" );
  AddDetail( ({ "taverne", "tavernen", "rausch", "umtrunk", "zwergenbier" }),
    BS("Hier gibt es bestimmt mehr als nur eine Taverne in der sich die Zwerge "+
    "einen Rausch ansaufen koennen. ") );
/*
  AddDetail( ({ "" }),
    BS("") );
*/
}

