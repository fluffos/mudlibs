#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine gute Kriegsaxt");
  SetProp(P_LONG, "Eine gute Kriegsaxt. Sie liegt sehr schwer in der Hand. \n" );
  // SetProp(P_INFO, "In einer starken Hand kann dies eine sehr gefaehrliche Waffe sein. ");
  SetProp(P_NAME, "Kriegsaxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "kriegsaxt"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 125);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 3900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 105);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:5, A_STR:5]) );

 // SetProp(P_AUTOLOADOBJ, 1);
}

