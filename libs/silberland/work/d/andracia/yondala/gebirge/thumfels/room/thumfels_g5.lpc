// Kohlelager
#include "../def.h"

inherit "std/room";

#include <properties.h>

string smell_kohle(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes an der Kohle riechen.");
	else return BS("Eindeutig der Geruch schwarzer Steinkohle. Brennt sehr heiss und auch aussergewoehnlich lange.");
}

string unt_kohle(string str)
{
	if( TP->QueryProp(P_RACE)!="Zwerg" ) return BS("Du kannst nichts besonderes an der Kohle erkennen.");
	else return BS("Eindeutig schwarze Steinkohle. Brennt sehr heiss und auch aussergewoehnlich lange.");
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Kohlelager" );
  SetProp( P_INT_LONG,
     BS("Das ist wohl das Kohlelager der Zwerge. Hinter einem Lattenzaun befindet sich ein riesiger "+
     "Haufen Kohlebrocken der bis fast unter die hohe Decke reicht. Im Norden befindet sich in "+
     "Sichtweite die grossen Erzlager der Zwerge. Durch die Tuer im Westen kommt man wohl auf die "+
     "Strassen Thumfels. Durch einen schmalen Durchgang im Suedwesten kann man die Hitze von "+
     "zwergischen Hochoefen spueren. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]) );

  AddSmell( ({ "kohle", "steinkohle" }),
    #'smell_kohle );
  AddDetail( ({ "kohle", "steinkohle", "kohlebrocken" }),
    #'unt_kohle );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst hier nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach Kohle. "));

  AddDetail( ({ "boden" }),
    BS("Ganz normaler Fels bildet den Boden. Eine dunkle Staubschicht bedeckt den Fels an Stellen "+
    "an denen nur selten jemand seinen Fuss stellt. Ansonsten liegen nur ein paar kleine Kohlebrocken "+
    "herum."));
  AddDetail( ({ "decke" }),
    BS("Die Decke ist sehr hoch. Laternen haengen an langen Ketten herab und "+
    "beleuchten das Kohlelager. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Ganz normaler Fels bildet die Waende. "));

  AddDetail( ({ "raum", "kohlelager", "lager", "bereich" }),
    BS("Das ist wohl das Kohlelager der Zwerge. Hinter einem Lattenzaun tuermt sich ein Berg von Kohlebrocken "+
    "bis fast unter die Decke. Nur wenige Brocken liegen auf dem Boden ausserhalb des umzaeunten Bereichs. "));
  AddDetail( ({ "lattenzaun", "latten", "holz", "zaun" }),
    BS("Der hoelzerne Lattenzaun grenzt den begehbaren Bereich gegen den Berg Kohlebrocken ab. "+
    "Ein kleines Tor im Lattenzaun dient wohl dazu Kohle aus dem Lager zu holen oder neue Kohle "+
    "hinein zubringen."));
  AddDetail( ({ "tor" }),
    BS("Das kleine Tor im Lattenzaun dient wohl dazu Kohle aus dem Lager zu holen oder neue Kohle "+
    "hinein zubringen."));    
  AddDetail( ({ "haufen", "berg" }),
    BS("Der grosse Berg Kohlebrocken tuermt sich hinter dem Lattenzaun bis fast an die Decke."));
  AddDetail( ({ "norden", "erzlager" }),
    BS("Im Norden befinden sich das Erzlager der Zwerge. "+
    "Dort scheint auch alles mit Laternen ausgeleuchtet zu sein."));
  AddDetail( ({ "staub", "staubschicht", "schicht", "foerdern", "geschaeft" }),
    BS("Das Foerdern von Kohle scheint ein besonders staubiges Geschaeft zu sein."));
  AddDetail( ({ "gesteinsbrocken", "brocken" }),
    BS("Am Boden liegen mehrere kleine Kohlebrocken herum."));
  AddDetail( ({ "sichtweite" }),
    BS("Du kannst von hier aus die Erzlager im Norden sehen. "+
    "Dort scheint auch alles mit Laternen ausgeleuchtet zu sein."));
  AddDetail( ({ "westen", "tuer" }),
    BS("Durch die Tuer im Westen kommt man wohl auf die Strassen von Thumfels"));
  AddDetail( ({ "strassen", "thumfels", "teil", "zwergenstadt", "stadt" }),
    BS("Das hier ist ein Teil der Zwergenstadt Thumfels. Die Strassen, die durch die unterirdische Stadt der "+
    "Zwerge fuehren befinden sich wohl hinter der Tuer im Westen. "));
  AddDetail( ({ "laterne", "laternen", "kette", "ketten", "licht", "beleuchtung" }),
    BS("Die Laternen, die an langen Ketten von der Decke haengen, liefern "+
    "ausreichend Licht um das Erzlager zu beleuchten. "));
  AddDetail( ({ "fels" }),
    BS("Nur ganz normaler Fels."));
  AddDetail( ({ "suedwesten", "hochoefen", "hochofen", "durchgang" }),
    BS("Durch einen schmalen Durchgang im Suedwesten kann man die Hitze von "+
     "zwergischen Hochoefen spueren."));
  AddDetail( ({ "hitze" }),
    BS("Hochoefen strahlen sehr viel Hitze ab. Im Suedwesten sind wohl die zwergischen Hochoefen."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_g4.lpc" );
  AddExit( ({ "suedwesten" }), THUM_ROOM+"thumfels_f6.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_f5.lpc" );
}

