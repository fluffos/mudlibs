#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine einfache Kampfaxt");
  SetProp(P_LONG, BS(
    "Eine einfache Kampfaxt mit einer scharfen Klinge. Gut geignet fuer kleine Baeume. ") );
  // SetProp(P_INFO, "Kleine Kaefer kann man damit bestimmt gut bezwingen.");
  SetProp(P_NAME, "Kampfaxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "kampfaxt"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 55);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 1100);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 1700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:1, A_STR:2]) );
}

