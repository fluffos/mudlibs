#include "../def.h"

inherit THUM_ROOM + "thumfels_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Hier treffen sich drei Stollen aus Westen, Sueden und Norden und "+
    "bilden eine T-Kreuzung."));

  AddDetail( ({ "reliefbild", "reliefbilder", "bild", "bilder", "szene", "szenen" }),
    BS("Hier stellt das Reliefbild eine Szene auf einem Fluss dar. Mehrere Flosse "+
    "mit Zwergen besetzt versuchen ueber einen Fluss zu gelangen. Die fein "+
    "herausgemeisselten Zwergengesichter sind gezeichnet von Angst und Abscheu vor "+
    "den tosenden Wassermassen. Ein Floss ist gekentert und von den Zwergen sind "+
    "nur noch ein paar rudernde Arme im Wasser zu erkennen.") );
  AddDetail( ({ "fluss", "flosse", "angst", "abscheu", "wassermassen", "wasser", "arme" }),
    BS("Das ist Teil des Reliefbilds.") );

  AddItem( THUM_NPC+"zwergenpatrouille.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "sueden" }), THUM_ROOM+"thumfels_f3.lpc" );
  AddExit( ({ "westen" }), THUM_ROOM+"thumfels_e2.lpc" );
  AddExit( ({ "norden" }), THUM_ROOM+"thumfels_f1.lpc" );
}

