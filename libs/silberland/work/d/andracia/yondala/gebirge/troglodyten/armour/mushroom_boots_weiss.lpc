#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Pilzfaserstiefel");
  SetProp(P_LONG,
    BS("Diese Stiefel sind aus Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. "+
    "Sie sind weisslich mit einem leichten Gelbstich, was auch modisch diese "+
    "Kleidung nicht verbessert.") );
  SetProp(P_INFO, BS("Wenigstens riechen sie nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserstiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "pilzstiefel", "pilzfaserstiefel"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 378);
  SetProp(P_VALUE, 270);
  SetProp(P_QUALITY_DECAY, 105);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );      

  SetProp(P_AUTOLOADOBJ, 1);
}

