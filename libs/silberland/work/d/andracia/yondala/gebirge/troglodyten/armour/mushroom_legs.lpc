#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Pilzfaserhose");
  SetProp(P_LONG,
    BS("Diese Hose ist aus Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. "+
    "Sie ist weisslich mit einem leichten Gelbstich, was auch  modisch diese "+
    "Kleidung nicht verbessert.") );
  SetProp(P_INFO, BS("Wenigstens riecht sie nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "pilzhose", "pilzfaserhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 504);
  SetProp(P_VALUE, 360);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );      
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3, SR_MAX_SIZE:190, P_SIZE:155]) );
}

