// shop_lager
inherit "std/store.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

reset() {
  ::reset();
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1); 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:14]));
  SetProp( P_INT_SHORT, "Dies ist das Lager von Miitox's schneiderei" ); 
  SetProp( P_INT_LONG,  "Dies ist das Lager von Miitox's schneiderei. \n"
  "Hier verstaut er all sein eingekauftes Zeug." );
 
  // AddItem( "file", refresh, Props);
  RemoveItem( "std/stempel.lpc" );
  RemoveItem( "std/geldboerse.lpc" );
  AddItem( ARMOUR + "chitin_armour.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "chitin_arms.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "chitin_legs.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "chitin_boots.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "mushroom_armour.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "mushroom_legs.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "mushroom_boots.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "mushroom_belt.lpc", REFRESH_REMOVE);
  AddItem( ARMOUR + "mushroom_cloak.lpc", REFRESH_REMOVE);
}
