// waechter

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"dantox", "wache", "/ntrwache" }) );
  create_default_npc(18+random(5));
  AddInfo( ({"dantox"}) ,"Das bin ich.", "sagt: " );

  SetProp(P_NAME, "Dantox");

  SetProp( P_SHORT, "Dantox, ein Troglodytenwaechter");
  SetProp( P_LONG, BS("Dies ist Dantox, ein Troglodytenwaechter. Er hat nur einen kleinen, flachen Kopf und da alle "+
    "Troglodyten keinen erkennbaren Hals haben, schaut es bei ihm fast so aus als ob sein Gesicht am oberen Ende seines Rumpfs sei. "+  
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen."));

  SetProp(P_MNPC_AREA, ({ROOM+"troglodyten_e4.lpc",ROOM+"troglodyten_f3.lpc",
    ROOM+"troglodyten_f4.lpc",ROOM+"troglodyten_f5.lpc",ROOM+"troglodyten_f6.lpc",
    ROOM+"troglodyten_g4.lpc",ROOM+"troglodyten_g5.lpc",ROOM+"troglodyten_g6.lpc",
    ROOM+"troglodyten_h3.lpc",ROOM+"troglodyten_h4.lpc",ROOM+"troglodyten_h5.lpc" }) );

  SUID;
  CLONEME(ARMOUR + "chitin_armour.lpc");
  CLONEME(ARMOUR + "chitin_legs.lpc");
  CLONEME(ARMOUR + "chitin_boots.lpc");
  CLONEME(ARMOUR + "chitin_arms.lpc");
  command("trage alles");
  CLONEME(WEAPON + "speer.lpc");
  command("zuecke speer");

  
}