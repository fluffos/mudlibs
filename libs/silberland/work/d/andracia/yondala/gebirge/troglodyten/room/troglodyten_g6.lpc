// Tempel
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Tempel" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich im Tempel der Troglodyten. Dies ist ihr Heiligtum "+
     "und hier beten Sie ihren Gott Enmesharra an. Es gibt hier keine Bilder oder "+
     "Statuen von ihrem Gott. Ein grosser Felsblock steht in der Mitte des Raums. "+
     "Dir ist hier irgend wie umheimlich. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"boden"}), BS(
    "Der felsige Boden ist hier trocken und mit einer duennen Schicht "+
    "gelblichen Staub bedeckt. " ) );
  AddDetail( ({"decke", "pilzschirm", "dach"}), BS(
    "Die Decke scheint die Unterseite des Pilzschirms zu sein. Leicht gelbliche "+
    "Sporen rieseln als kleine Staubwolken langsam aus den Lamellen des Pilzschirms "+
    "auf alles herab." ) );
  AddDetail( ({"waende", "steinwaende", "richtungen", "richtung", "wand" }), BS(
    "Die einfach gemauerten Steinwaende begrenzen den Raum in alle Richtungen. Nur im "+
    "Norden ist eine Luecke frei um den Raum wieder zu verlassen." ) );
  AddSound( DEFAULT_SOUND, BS(
    "Du kannst hier nichts besonderes hoeren." ) );
  AddSmell( DEFAULT_SMELL, BS(
    "Du kannst hier nichts besonderes riechen." ) );

  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({ "gott", "enmesharra" }), BS(
    "Du hast keine Vorstellung von dem Gott der Troglodyten. "));
  AddDetail( ({ "felsblock" }), BS(
    "Der Felsblock ist wuerfelfoermig mit einer Kantenlaenge von ungefaehr zwei "+
    "Meter und auf jeder Seite sind Unmengen von Runen eingemeisselt. "));
  AddDetail( ({ "raum", "heiligtum", "tempel", "behausung", "behausungen", "hoehle" }), BS(
    "Du befindest Dich im Tempel der Troglodyten. Dies ist ihr Heiligtum "+
    "und hier beten sie ihren Gott Enmesharra an. Es gibt hier keine Bilder oder "+
    "Statuen von ihrem Gott. Ein grosser Felsblock steht in der Mitte des Raums. "+
    "Dir ist hier irgend wie umheimlich. "));
  AddDetail( ({ "kanten", "kantenlaenge", "laenge", "mitte" }), BS(
    "Der wuerfelfoermige Felsblock in der Mitte des Tempels hat ungefaehr eine "+
    "Kantenlaenge von zwei Metern. "));
  AddDetail( ({ "runen", "seiten", "seite" }), BS(
    "Auf den Seiten des wuerfelfoermigen Felsblocks sind dir unbekannte Runen "+
    "eingemeisselt. Warscheinlich ergeben sie nur fuer Troglodyten Sinn. "));
  AddDetail( ({"pilze", "pilz"}), BS(
    "Der Pilzschirm ueber Dir bildet das Dach. Ansonsten sind hier keine "+
    "Pilze." ) );
  AddDetail( ({"sporen", "staub", "schicht", "staubwolken", "staubwolke", "wolke", "wolken"}), BS(
    "Feiner gelber Staub haengt hier in der Luft. Es sind scheinbar Sporen, die "+
    "aus den Lamellen des Pilzschirms herabfallen. Hoffentlich schaden diese "+
    "Sporen deiner Lunge nicht, denn Du kannst gar nicht vermeiden dass Du sie einatmest." ) );
  AddDetail( ({"lamellen", "lamelle", "unterseite"}), BS(
    "Die Pilze haben an der Unterseite ihres Pilzschirms Lamellen aus denen die "+
    "reifen Sporen herabfallen. Hier unter dem dachbildenden Pilzschirm rieseln "+
    "die Sporen als gelbliche Wolken herab." ) );
  AddDetail( ({"lunge", "luft"}), BS(
    "Solange Du nicht schmerzhaft husten musst ist alles okay. " ) );
  AddDetail( ({"mauern", "mauer"}), BS(
    "Die Behausungen der Troglodyten und auch dieser Tempel wird von Mauern begrenzt. " ) );
  AddDetail( ({"luecke", "ausgang"}), BS(
    "Durch die Luecke in der Mauer im norden kann man wieder hinaus. " ) );
  AddDetail( ({"bibliothek"}), BS(
    "Ist Dir noch nicht aufgefallen dass Troglodyten blind sind? Eine Bibliothek wirst Du daher hier nicht finden." ) );
  AddDetail( ({"sinn"}), BS(
    "Du erkennst ihn nicht." ) );
  AddDetail( ({"unmengen"}), BS(
    "Viele eben." ) );

/*
  AddDetail( ({""}), BS(
    "" ) );
*/

  /* Exits */
  AddExit( "norden" , ROOM + "troglodyten_g5.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "kladox.lpc", REFRESH_DESTRUCT );

  /*erklettern der Felsblocks -> Zorn der Troglodyten*/

}