#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine rote Pilzfaserhose");
  SetProp(P_LONG,
    BS("Diese Hose ist aus roten Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. ") );
  SetProp(P_INFO, BS("Wenigstens riecht sie nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserhose");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "pilzhose", "pilzfaserhose"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 1320);
  SetProp(P_VALUE, 2772);
  SetProp(P_QUALITY_DECAY, 98);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

