#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gruenblauer Chitinplattenpanzer");
  SetProp(P_LONG,
    BS("Dieser Plattenpanzer wurde aus den Panzerplatten des Scheinstutzkaefers "+
    "gefertigt. Er ist gruenblau, schimmert leicht metallisch und hat aufaellige "+
    "Punktreihen. Ein faehiger Schneider hat diesen Panzer mit Pilzfasereinlagen "+
    "versehen damit man ihn besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenpanzer");
  SetProp(P_NAME_ADJ, "gruenblau");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "plattenpanzer", "chitinpanzer", "chitinplattenpanzer"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 2780);
  SetProp(P_VALUE, 4552);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1, DT_ACID:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

