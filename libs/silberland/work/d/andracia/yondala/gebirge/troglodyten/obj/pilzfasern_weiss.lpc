inherit "std/unit.lpc";

#include "unit.h"
#include "properties.h"
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties

  SetProp( P_INFO, BS("Ein patenter Schneider kann sicher Kleidungen und "+
    "Ruestungen mit solchen Fasern herstellen.") );
  SetProp( P_NAME, ({ "Pilzfaser", "Pilzfasern" }) );
  SetProp( P_NAME_ADJ, "weiss");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_MUSHROOM );

  AddId( ({"faser", "pilzfaser", "fasern", "pilzfasern", "\npilzfaser_weiss",
  	"rote pilzfaser", "rote faser", "rote pilzfasern", "rote fasern"}) );
//  SetUnitShort( ({"pilzfaser", "pilzfasern"}) );

  SetProp( P_NOBUY, 1);

  SetCoinsPerUnits(6,1);
  SetGramsPerUnits(6,1);

  AddSingularId( ({"faser", "pilzfaser"}) );
  AddPluralId( ({"fasern", "pilzfasern"}) );

  AddCmd( ({"flechte", "drehe", "flecht", "dreh"}) , "cmd_seil_flechten" );
}

string long()
{
	string erg;
	
  if( QueryProp(P_AMOUNT) == 1 )
    return BS("Diese weisse Pilzfaser war einmal Bestandteil einer Riesenpilzes. "+
    "Man kann diese Fasern zu Stoffen verweben, zu Seilen spinnen oder zu Suppe "+
    "Verarbeiten. Um sich daraus Kleidungen oder Ruestungen  schneidern zu "+
    "lassen benoetigt man aber mehr als nur diese eine Faser. ");
  else
    erg = "Diese weissen Pilzfasern waren einmal Bestandteile von Riesenpilzen. "+
    "Man kann diese Fasern zu Stoffen verweben, zu Seilen spinnen oder zu Suppe "+
    "verarbeiten. ";
  if( QueryProp(P_AMOUNT) > 50 )
    erg += "Mit "+QueryProp(P_AMOUNT)+" weissen Pilzfasern kannst Du Dir Kleidung "+
    "oder eine Ruestung schneidern lassen und hast warscheinlich sogar noch welche "+
    "uebrig. ";
  /*else
    erg += "Mit diesen weissen Pilzfasern kannst Du Dir sicherlich Kleidung oder"+
    "eine Ruestung schneidern lassen.";*/
  return BS(erg);  
}

int cmd_seil_flechten(string str)
{
	object ob;
  string ziel, dummy;
  
  notify_fail( "Was willst du flechten?\n" );
  if( !str ) return 0;
  if( sscanf(str, "aus %s seil%s", ziel, dummy) != 2 ) return 0;
  if( !id(ziel) ) return 0;
  
  notify_fail( "Du benoetigst 40 Pilzfasern um ein Seil zu flechten.\n" );
  if( QueryProp(P_AMOUNT) < 40 ) return 0;
	notify_fail( "Das kannst Du waehrend eines Kampfs nicht.\n" );
	if( TP->InFight() ) return 0;
	notify_fail( "Im Dunkeln kannst Du das leider nicht.\n" );
	if( TP->CannotSee() ) return 0;
		
	AddAmount( -18 );	
	ob=clone_object("/obj/seil.lpc");
	write( BS("Du flechtest aus den Pilzfasern ein Seil.") );
	say( BS(TP->name()+" flechtet aus Pilzfasern ein Seil.") );
	if( ob->move(TP, M_GET) < 0 ) ob->move(ENV(TP), M_PUT);
	return 1;
}	