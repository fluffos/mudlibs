#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein roter Pilzfaserguertel");
  SetProp(P_LONG,
    BS("Dieser Guertel ist aus roten Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. ") );
  SetProp(P_INFO, BS("Wenigstens riechet er nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserguertel");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "pilzguertel", "pilzfaserguertel"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_BOOTS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 360);
  SetProp(P_VALUE, 756);
  SetProp(P_QUALITY_DECAY, 98);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );      

  SetProp(P_AUTOLOADOBJ, 1);
}

