#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Troglodyt auf Patroullie");
  SetProp(P_LONG,
    "Dieser Troglodyt laeuft auf Patroullie durch die Gaenge und sucht nach "+
    "gefaehrlichen Kaefern die das Dorf bedrohen.");

  AddId( ({ "\ntrwache" }) );
  create_default_npc(18+random(5));

  SetProp(P_ARTICLE, 1);

  SUID;
  CLONEME(ARMOUR + "chitin_armour.lpc");
  CLONEME(ARMOUR + "chitin_legs.lpc");
  CLONEME(ARMOUR + "chitin_boots.lpc");
  CLONEME(ARMOUR + "chitin_arms.lpc");
  command("trage alles");
  CLONEME(WEAPON + "speer.lpc");
  command("zuecke speer");

/*
  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));

*/
}