//Der Standarttroglodyt

inherit "std/mnpc";
#include <properties.h> 
#include <combat.h>
#include <new_skills.h>
#include <moredef.h>
#include <moving.h>
#include <language.h>
#include "../def.h"

// immer wenn er jemanden trifft, der auch Troglodytenwache ist, wird dieser mitkaempfen
void init()
{
   ::init();
   if (this_player() && this_player()->id("\ntrwache")) AddDefender(this_player());
} 

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId(({"troglodyt"}));

  SetProp(P_SHORT, "Ein Troglodyt");
  SetProp(P_LONG,
    "Dieser Troglodyt geht emsig seinen Geschaeften nach.");
  SetProp(P_NAME, "Troglodyt");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Troglodyt");
  SetProp(P_ALIGN, 500-random(300) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SIZE, 160+random(30) );
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:   0.5, DT_COLD:     -0.2, DT_WATER: -0.5, DT_AIR:    0.5, 
      DT_LIGHT: -1.0, DT_ELECTRIC:  0.0, DT_ACID:  -0.2, DT_POISON:-1.0, 
      DT_HOLY:   0.2, DT_UNHOLY:    0.2, DT_MAGIC:  0.5, ]) );
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[2],DT_BLUDGEON}));
  SetProp(P_MSGIN, "schluerft herbei");
  SetProp(P_MSGOUT, "schluerft davon");
  SetProp(P_MMSGIN, "kommt herbei");
  SetProp(P_MMSGOUT, "verschwindet zwischen den Felsen");
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_g4.lpc");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + 
    MOV_INDOORS + MOV_INCHAT + MOV_OUTDOORS);
  SetProp(P_MNPC_WAIT, ({5, 10, 5}));
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 ); 
  SetProp(P_HEAL, 0);
  SetProp(P_KILL_NAME, "Ein Troglodyt"); 
  SetProp(P_REJECT, ({ REJECT_DROP,
    "@CAP_WER sagt: Das meochte ich nicht haben.\n" }) );
  SetProp( P_LOG_INFO, "missing_answers"); 

  AddInfo( DEFAULT_INFO , 
    ({"Davon hab ich keine Ahnung." , "Davon weiss ich nichts.",
      "Das ist bestimmt was von der Oberflaeche.", "Was?", "Nie davon gehoert."}), 
    "sagt: " );
  AddInfo( ({"dorf"}) , "Unsre Dorf ist kaum zu verfehlen." , "sagt: " );
  AddInfo( ({"kaefer"}) , "Wir zuechten Kaefer aber es gibt immernoch wilde "+
    "Exemplare in den Hoehlen." , "sagt: " );
  AddInfo( ({"exemplare"}) , "Es gibt auch ganz gefaehrliche Biester von "+
    "Kaefern in der Naehe" , "sagt: " );
  AddInfo( ({"kaeferzucht", "zuchtkaefer", "fleisch"}) , 
    "Suedwestlich vom Dorf ist unsere Kaeferzucht. "+
    "Das Fleisch unserer Zuchtkaefer ist besonders zart." , "sagt: " );
  AddInfo( ({"pilz", "pilze"}) , 
    "Pilze sind die Grundlage unseres Lebens. Die Fasern der Pilze sind "+
    "fuer so viele Dinge verwendbar." , "sagt: " );
  AddInfo( ({"pilzfarm"}) , 
    "Unser Pilzfarm ist in einer groesseren Hoehle oestlich des Dorfs" , "sagt: " );
  AddInfo( ({"behausung", "behausungen"}) , 
    "Die Pilzeschirme sind ein prima Dach und die Sporen machen die Luft "+
    "sehr angenehm." , "sagt: " );
  AddInfo( ({"wasser", "tropfen"}) , 
    "Das stete Wasser das von oben kommt? Ist es nicht schoen wenn "+
    "das Wasser ueber die Haut perlt? " , "sagt: " );
  AddInfo( ({"sporen", "spore"}) , 
    "Der Geschmack von Sporen macht die Luft doch richtig angenehm, oder?" , "sagt: " );
  AddInfo( ({"leuchten", "licht"}) , 
    ({"Ich weiss nicht was ihr meint.", "Das ist eine Luege.", 
    "Beweist mir erst mal dass es das wirklich gibt."}), "sagt: " );
  AddInfo( ({"bewohner", "troglodyten", "troglodyt"}) , 
    "Wir Troglodyten wohnen hier unten in den Hoehlen." , "sagt: " );
  AddInfo( ({"hoehle", "hoehlen"}) , 
    "Diese Hoehlen sind unsere Heimat. Die Oberflaeche interessiert uns nicht.",
    "sagt: " );
  AddInfo( ({"oberflaeche"}) ,
    "Die Oberflaeche ist uninteressant. Ist es nicht gefaehrlich so ungeschuetzt "+
    "direkt unter dem Himmel?" , "sagt: " );
  AddInfo( ({"sonne"}) , 
    "Das ist eine Luege der Oberflaechenbewohner. Wenn ein Feuerball dort oben "+
    "herumwandern wuerde, waeren die Oberflaechenbewohner doch schon laengst "+
    "alle verbrannt.", "sagt: " );
  AddInfo( ({"ausgang"}) , 
    "Ihr meint einen Weg zur Oberflaeche? Den kenne ich leider nicht." , "sagt: " );
  AddInfo( ({"chitin", "chitinplatten"}) , 
    "Alle groesseren Insekten koennen zu Chitinplatten verarbeitet werden." , "sagt: " );
  AddInfo( ({"fasern", "pilzfasern"}) , 
    "Wenn man einen grossen Pilz verarbeitet bekommt man Pilzfasern. Man kann "+
    "daraus Stoffe, Seile oder Suppe machen." , "sagt: " );
  AddInfo( ({"bladox", "dantox", "jutox", "radilox", "tamodox", "zanilox",
    "wache", "wachen"}) ,
    "Wachen sorgen fuer Ruhe und Ordnung. Wer friedlich ist, hat nichts zu befuerchten.",
    "sagt: " );
  AddInfo( ({"drebox", "haendler"}) , 
    "Unser Haendler Drebox hat hier einen kleinen Laden. Dort findest Du bestimmt "+
    "was Du suchst." , "sagt: " );
  AddInfo( ({"laden", "shop"}) , 
    "Wir haben hier nur einen kleinen Laden. Man findet ihn im Nordwesten des Dorfs.",
    "sagt: " );
  AddInfo( ({"fanox", "dorfaeltester", "aeltester"}) , 
    "Fanox ist unser Dorfaeltester. Er war auch schon mal an der Oberflaeche "+
    "und hat uns schaurige Geschichten erzaehlt. Er haelt sich meistens im "
    "Versammlungsraum auf." , "sagt: " );
  AddInfo( ({"prasox", "haeuptling"}) , 
    "Unser Haeuptling Prasox ist fuer die Geschicke des Dors verantwortlich. "+
    "Falls Du ihn suchst, er ist meistens im Versammlungsraum." , "sagt: " );
  AddInfo( ({"versammlungraum"}) , 
    "Der Versammlungsraum befindet sich im Westen des Dorfs." , "sagt: " );
  AddInfo( ({"kladox", "tempelvorsteher"}) ,
    "Wir preisen Kladox, den Vertreter Enmesharra's. Er weist uns den Weg und "+
    "betreut unseren Tempel." , "sagt: " );
  AddInfo( ({"tempel", "enmesharra"}) , 
    "Der Tempel von Enmesharra befindet sich im suedwesten. Seid respektvoll in "+
    "unserer heiligen Staette." , "sagt: " );
  AddInfo( ({"miitox", "schneider"}) , 
    "Unser Schneide Miitox ist ein Meister seines Fachs. Selbst die "+
    "Oberflaechenbewohner kommen hierher um sich von ihm ein Gewand naehen zu "+
    "lassen. Vorallem Chitinplattenruestungen sind beliebt." , "sagt: " );
  AddInfo( ({"schneiderei"}) , 
    "Die Schneiderei von Miitox, dem beruehmten Schneider, befindet sich im Osten "+
    "des Dorfs. " , "sagt: " );
  AddInfo( ({"resatox", "wirt"}) , 
    "Bei Resatox, unserem Wirt, kann man unsere vorzuegliche Kueche kosten. "+
    "Nichts ist besser als ein saftiges Kaefersteak." , "sagt: " );
  AddInfo( ({"schenke", "pub", "tanke", "tanken"}) , 
    "Die Schenke von Resatox befindet sich im Nordosten." , "sagt: " );
  AddInfo( ({"patroullie"}) , 
    "Einige unserer Wachen sind immer auf Patroullie um grosse Insekten vom "+
    "Dorf fern zu halten." , "sagt: " );
}

string CannotSee(int silent)
{ 
  return "Troglodyten sind blind!"; 
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(3) == 0)
  {
    tell_room(ENV(TO), TO->Name()+" ruft laut: \"HILFE!\" .\n");
    walk_mapping(ENV(TO)->QueryProp(P_EXITS), "ruf_hilfe", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_hilfe(string richtung, string strpfad)
{
  object ob, pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
    call_other(pfad,"???",0);
  if( !ob=present("\ntrwache", pfad) ) return;
  if( ob->InFight() ) return;
  tell_room(ENV(ob), ob->Name()+" ruft laut: \"Ich eile zur Hilfe!\" .\n");
  //tell_room(ENV(TO), ob->Name()+" reagiert auf den Hilferuf und kommt "+TO->name(WEM)+" zu Hilfe. \n ");
  ob->move(ENV(TO), M_GO, "",
    "reagiert auf den Hilferuf von "+TO->name(), 
    "kommt "+TO->name(WEM)+" zu Hilfe" );
}

