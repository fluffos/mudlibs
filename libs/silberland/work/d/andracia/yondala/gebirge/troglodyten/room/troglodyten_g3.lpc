#include "../def.h"

inherit ROOM + "trhoehle_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Sueden kann man gedaempft Geraeusche vernehmen.") );
  AddSound( DEFAULT_SOUND , "Gedaempfte Geraeusche kommen aus dem Sueden. \n" );
  AddSound( ({"geraeusch", "geraeusche"}), BS(
    "Dort scheint sich wohl das Dorf der Troglodyten zu befinden.") );
  RemoveSound( ({"stille"}) );

  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  AddExit( "nordwesten" , ROOM + "troglodyten_f2.lpc");
  AddExit( "nordosten" , ROOM + "troglodyten_h2.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_g4.lpc");
}