// haendler

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"drebox", "haendler", "\ndrebox"}) );
  create_default_npc(15+random(5));

  SetProp(P_NAME, "Drebox");

  SetProp( P_SHORT, "Drebox, der Haendler");
  SetProp( P_LONG, BS("Dies ist Drebox, der Haendler. Sein uebergrosser Mund nimmt fast die gesamte Breite "+
    "seines Kopfs ein. Auch hat er kaum einen Halsansatz. Er hat irgendwie Aehnlichkeit mit einem Hai. "+
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen."));

  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_f3.lpc");
  SetProp(P_MNPC_FLAGS, 0);

  AddInfo( ({"drebox", "haendler"}) , 
    "Ich bin hier der Haendler." , "sagt: " );
  AddInfo( ({"laden", "shop"}) , 
    "Mein Laden ist voll mit vielen Dingen. Mit 'zeige' bekommst Du einen Ueberblick." );

  SUID;
  CLONEME(ARMOUR + "mushroom_armour.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}