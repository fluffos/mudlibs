#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Dorf der Troglodyten" );
  SetProp( P_INT_LONG, /* BS( */
     "Hier leben die Troglodyten. Riesige Pilze wachsen hier und bilden natürliche "
     "Daecher fur die Behausungen der Troglodyten. Primitive Steinmauer trennen die "+
     "einzelnen Raeume voneinander und unterjedem Pilzschirm ist fast die gesamte "+
     "Flaeche mit Mauern umbaut. Ein schwaches Leuchten geht von jedem Riesenpilz "+
     "aus und erhellt damit notduerftig das Dorf. Der Boden dieser grossen Hoehle "+
     "wurde wohl von den Troglodyten geschliffen um einen ebenen Untergrund zu "+
     "erhalten. Kleine, abschuessige Rinnen leiten das Wasser weg das hier staendig "+
     "von der hohen Decke tropft." /* ) */ ); // wird im echtRaum erst geBS
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND, BS(
    "Diese Hoehle ist erfuellt mit dem geschaefigen Schnattern der Troglodyten die "+
    "hier wohnen. ") );
  AddSound( ({"schnattern", "troglodyten", "dorf", "geraeusche", "geraeusch", 
    "kulisse", "geraeuschkulisse"}), BS(
    "Die vielen Troglodyten, die in diesem Dorf leben, erzeugen eine immense "+
    "Geraeuschkulisse. ") );
  AddSmell( DEFAULT_SMELL, BS(
    "Es riecht hier vorallem nach Pilzsporen. Die Troglodyten hingegen scheinen keinen "+
    "Geruch abzusondern.") );
  AddSmell( ({"pilzsporen", "pilzspore", "erde", "geruch"}), BS(
    "Die Pilzsporen riechen irgendwie suessauer und nach frischer Erde.") );
  AddSmell( ({"troglodyten"}), BS(
    "Troglodyten scheinen keinen Geruch abzusondern, du riechst zumindest nix.") );

  AddDetail( ({"boden", "untergrund", "oberflaeche"}), BS(
    "Der Boden wurde von den Troglodyten, die dieses Dorf bewohnen, eben geschliffen. "+
    "Kleine, abschuessige Rinnen leiten das Wasser weg das hier staendig "+
    "von der hohen Decke tropft. ") );
  AddDetail( ({"decke"}), BS(
    "Die hohe Decke ist kaum zu erkennen. Staendig fallen einzelne Tropfen herab aber als "+
    "Regen kann man dies nicht bezeichnen. ") );
  AddDetail( ({"waende", "felswaende", "wand"}), BS(
    "Hinter den Pilzen und Behausungen der Troglodyten kannst Du die kahlen Felswaende "+
    "erkennen. Auf ein paar erreichbaren Simsen sind weitere Pilze und Behausungen der "+
    "Troglodyten erkennbar.") );
  AddDetail( ({"dorf", "hoehle", "umgebung"}), BS(
    "Hier leben die Troglodyten. Riesige Pilze wachsen hier und bilden natürliche "
    "Daecher fur die Behausungen der Troglodyten. Primitive Steinmauer trennen die "+
    "einzelnen Raeume voneinander und unterjedem Pilzschirm ist fast die gesamte "+
    "Flaeche mit Mauern umbaut. Ein schwaches Leuchten geht von jedem Riesenpilz "+
    "aus und erhellt damit notduerftig das Dorf. Der Boden dieser grossen Hoehle "+
    "wurde wohl von den Troglodyten geschliffen um einen ebenen Untergrund zu "+
    "erhalten. Kleine abschuessige Rinnen leiten das Wasser weg das hier staendig "+
    "von der hohen Decke tropft.") );
  AddDetail( ({"troglodyten", "dorfbewohner", "troglodyt", "wesen"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"pilze", "pilz","riesenpilze", "riesenpilz", "behausungen", "behausung"}), BS(
    "Die riesigen Pilzschirme dienen als Daecher fuer die Behausungen der "+
    "Troglodyten. Einfache Steinmauern umschliessen dann die Wohnraeume. "+
    "Fast ueberall sind hier die kompletten vom Pilzschirm ueberdachten Flaechen "+
    "mit Mauern umbaut. In den Mauern sind schmale Spalten als Zugaenge zu "+
    "den Behausungen freigelassen. ") );
  AddDetail( ({"spalten", "spalte", "zugaenge", "zugang"}), BS(
    "Schmale Spalten in den Mauern unter den Pilzschirmen dienen als Zugaenge "+
    "zu den Behausungen der Troglodyten. Du willst lieber nicht die privaten "+
    "Raeume dursuchen um nicht den Zorn der Dorfbewohner auf dich zu ziehen. ") );
  AddDetail( ({"daecher", "dach", "pilzschirme", "pilzschirm"}), BS(
    "Die riesigen Pilze bilden das Dach fuer die Behausungen der Troglodyten "+
    "und schuetzt die Raeume darunter vor den staendig herabfallenden Wassertropfen. ") );
  AddDetail( ({"steinmauern", "steinmauer", "mauern", "mauer"}), BS(
    "Die primitiven Steinmauern umschliessen die Behausungen der Troglodyten. "+
    "Nur kleine Spalten in den Mauern sind als Zugaenge freigelassen. ") );
  AddDetail( ({"raeume", "raum", "wohnraeume"}), BS(
    "Unter den riesigen Pilzschirmen sind die Raeume und Behausungen der "+
    "Dorfbewohner, untereinander abgetrennt durch einfache Steinmauern.") );
  AddDetail( ({"leuchten", "licht", "lichtquelle"}), BS(
    "Dieses schwache Leuchten von den riesigen Pilzen taucht die Hoehle "+
    "in ein ungewoehnliches Licht. Hier kann man auch ohne Lichtquelle "+
    "seine Umgebung erkennen.") );
  AddDetail( ({"flaechen", "flaeche"}), BS(
    "Es gibt hier einen Boden, Waende und eine Decke. Pilze und Steinmauern "+
    "bilden auch eigenstaendige Flaechen. ") );
  AddDetail( ({"rinnen", "rinne"}), BS(
    "Im Boden wurden kleine abschuessige Rinnen eingebracht die das von "+
    "der Decke fallende Wasser aufsammeln und wegleiten. Du kannst leider "+
    "nicht erkennen wohin das Wasser abfliesst.") );
  AddDetail( ({"wasser", "tropfen", "regen", "wassertropfen"}), BS(
    "Staendig fallen dicke Tropfen von der Decke hoch ueber Dir. "+
    "Man kann es kaum mit Regen vergleichen. In den Rinnen im Boden "+
    "fliesst das Wasser dann ab. ") );
  AddDetail( ({"simse", "sims"}), BS(
    "Auf ein paar Simsen an den Waenden kann man weitere Pilze und "+
    "Behausungen der Troglodyten erkennen.") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({"bibliothek", "buecher"}), BS(
    "Da Troglodyten blind sind haben sie keine Verwendung fuer Buecher. Du wirst hier keine "+
    "Bibliothek finden.") );
  AddDetail( ({"himmel", "sonne" }), BS(
    "Du befindest Dich in einer Hoehle tief im Berg. Da sieht man keinen Sonne und keinen Himmel.") );
  AddDetail( ({"oberflaechenbewohner"}), BS(
    "Menschen sind eher Oberflaechenbewohner.") );
  AddDetail( ({"stein", "steine", "fels", "felsen" }), BS(
    "Es sind hier auf dem Boden nur wenige lockere Steine zu sehen. Ansonsten besteht der Boden "+
    "nur aus eben geschliffenem Fels.") );

/*
  AddDetail( ({""}), BS(
    "") );
*/    
  AddCmd( ({"frag", "frage"}), "cmd_fragen" );

  AddRoomMessage( ({ "Ein Troglodyt beschnuppert dich.\n",
    "Eine Gruppe junger Troglodyten schlendert vorbei.\n",
    "Ein aelterer Troglodyt stolpert ueber einen Stein.\n", 
    "Zwei schnatternde Troglodyten ziehen vorbei.\n",
    "Kurz vor einem Zusammenstoss weicht ein Troglodyt vor Dir zurueck. \n",
    "Ein Wassertropfen trifft dich genau in den Nacken. \n",
    "Du hoerst wie ein Troglodyt schimpft. \n",
    "Ein Troglodyt ruft: Dreckige Oberflaechenbewohner!. \n",
    "Ein Troglodyt sagt: "+
       "Die Sonne ist eine dreckige Luege der Oberflaechenbewohner. \n",
    "Ein Troglodyt meint: "+
       "Auf der Oberflaeche ist man dem Himmel schutzlos ausgeliefert. \n",
    "Ein Troglodyt schimpft: Oberflaechenbewohner stinken ja fuerchterlich! \n",
    "Ein Troglodyt rempelt dich scheinbar absichtlich an. \n"
    }), 30 );
    

}

int cmd_fragen(string str)
{
	string dummy;
	
	if( !str ) return 0;
	if( sscanf( str, "troglodyt nach %s", dummy) != 1) return 0;
	write( BS("Du fragst einen voruebergehenden Troglodyt nach "+capitalize(dummy)+".") );
	tell_room( TO, BS( TP->name()+" fragt einen voruebergehenden Troglodyt nach "+capitalize(dummy)+"."), ({TP}) );
	write( "Der voruebergehende Troglodyt ignoroert dich.\n" );
	say( "Der angesprochene Troglodyt geht einfach weiter.\n" );
	return 1;
}