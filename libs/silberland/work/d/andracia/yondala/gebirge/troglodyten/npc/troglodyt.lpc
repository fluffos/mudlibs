#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(9+random(5));

  SetProp(P_ARTICLE, 1);

  SUID;
  CLONEME(ARMOUR + "mushroom_armour.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}