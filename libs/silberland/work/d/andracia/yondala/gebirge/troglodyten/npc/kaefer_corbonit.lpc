#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(18);
  AddId(({"corbonitkaefer"}));
  SetProp( P_SHORT, "Corbonitkaefer");
  SetProp( P_LONG, 
    BS("Der Corbonitkaefer ist feuerrot, mit kleinen Facettenaugen, scharfen Mandibeln "+
    "und stachelbewehrten Beinen. Dieser unfreundliche Zeitgenosse ist besonder gut "+
    "gepanzert und verspritzt eine aggressive Saeure aus seiner Afterdruese.") );
  SetProp( P_NAME, "Corbonitkaefer");
  SetProp( P_KILL_NAME, "Corbonitkaefer");

  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));
 
  AddDetail( ({"stacheln", "stachel"}), 
    BS("Die Beine des Corbonitkaefers sind mit Stacheln besetzt. ") );

  SetProp( P_SIZE, 156); //in cm
  SetProp( P_WEIGHT, 175000); //in g

  SetProp( P_MNPC_DEFAULTROOM, ROOM + "troglodyten_j4.lpc");
  SetProp( P_MNPC_FLAGS, 0);
  SetProp( P_AGGRESSIVE, ([ 0:1.0 ]) );

  SetProp( P_SPELLRATE, 10);
  AddSpell( 60, 15+random(6),
    "Der Corbonitkaefer trifft dich mit seinen stachelbewehrten Beinen.\n", 
    "@WER wird von den stachelbewehrten Beinen des Corbonitkaefers getroffen.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 40, 28+random(8),
    "Ploetzlich stellt sich der Corbonitkaefer auf und bespritzt dich mit Saeure.\n",
    "Der Corbonitkaefer stellt sich auf und bespritzt @WEN mit Saeure.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]));

  SUID; 
  CLONEME( OBJ+"chitinplatte_rot.lpc" );
  CLONEME( OBJ+"chitinplatte_rot.lpc" );

}
