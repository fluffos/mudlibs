// pub
#include "../def.h"

inherit "std/pub.lpc";

#include <properties.h>
#include <language.h>
#include <pub.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Schenke" );
  SetProp( P_INT_LONG,
     BS("Dies ist die Schenke der Troglodyten. Hier treffen sich die Dorfbewohner "+
     "nach getaner Arbeit und plaudern in Geselligkeit. Die Tische und "+
     "Sitzgelegenheiten scheinen zwar aus Holz zu sein, aber irgendwas laesst Dich "+
     "vermuten dass es eher ein vergleichbares Pilzmaterial ist. Ueberall liegt "+
     "ein leicht gelblicher Staub herum, das muessen wohl Sporen des Pilzschirms "+
     "sein der als Dach ueber dem Raum haengt. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Resatox");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Resatox");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddDetail( ({"boden"}), BS(
    "Der felsige Boden ist hier trocken und mit einer duennen Schicht "+
    "gelblichen Staub bedeckt. " ) );
  AddDetail( ({"decke", "pilzschirm", "dach"}), BS(
    "Die Decke scheint die Unterseite des Pilzschirms zu sein. Leicht gelbliche "+
    "Sporen rieseln als kleine Staubwolken langsam aus den Lamellen des Pilzschirms "+
    "auf alles herab." ) );
  AddDetail( ({"waende", "steinwaende", "seiten", "wand"}), BS(
    "Die einfach gemauerten Steinwaende begrenzen den Raum zu allen Seiten. Nur im "+
    "Sueden ist eine Luecke frei um den Raum wieder zu verlassen." ) );
  AddSound( DEFAULT_SOUND, BS(
    "Du kannst hier nichts besonderes hoeren." ) );
  AddSmell( DEFAULT_SMELL, BS(
    "Du kannst hier nichts besonderes riechen." ) );

  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({"pilze", "pilz"}), BS(
    "Der Pilzschirm ueber Dir bildet das Dach. Ansonsten sind hier keine "+
    "Pilze." ) );
  AddDetail( ({"sporen", "staub", "schicht", "staubwolken", "staubwolke", "wolke", "wolken"}), BS(
    "Feiner gelber Staub haengt hier in der Luft. Es sind scheinbar Sporen, die "+
    "aus den Lamellen des Pilzschirms herabfallen. Hoffentlich schaden diese "+
    "Sporen deiner Lunge nicht, denn Du kannst gar nicht vermeiden dass Du sie einatmest." ) );
  AddDetail( ({"felsen", "fels"}), BS(
    "Ueberall sind Felsen. Das ist typisch fuer eine Hoehle." ) );
  AddDetail( ({"lamellen", "lamelle", "unterseite"}), BS(
    "Die Pilze haben an der Unterseite ihres Pilzschirms Lamellen aus denen die "+
    "reifen Sporen herabfallen. Hier unter dem dachbildenden Pilzschirm rieseln "+
    "die Sporen als gelbliche Wolken herab." ) );
  AddDetail( ({"mauern", "mauer"}), BS(
    "Die Behausungen der Troglodyten und auch diese Schenke wird von Mauern begrenzt. " ) );
  AddDetail( ({"luecke", "ausgang"}), BS(
    "Durch die Luecke in der Mauer im Sueden kann man wieder hinaus. " ) );
  AddDetail( ({"lunge", "luft"}), BS(
    "Solange Du nicht schmerzhaft husten musst ist alles okay. " ) );

  AddDetail( ({"dorfbewohner", "dorf"}), BS(
    "Troglodyten wohnen in diesem Dorf.") );
  AddDetail( ({"arbeit"}), BS(
    "Was genau diese Arbeit ist weisst Du auch nicht.") );
  AddDetail( ({"geselligkeit"}), BS(
    "Wenn Du genug getrunken hast wirst Du auch gesellig sein.") );
  AddDetail( ({"tische", "tische"}), BS(
    "Die Tische sind scheinbar aus demselben holzartigen Material wie die "+
    "Sitzgelegenheiten. ") );
  AddDetail( ({"sitze", "sitzgelegenheit", "sitzgelegenheiten"}), BS(
    "Die Sitze sind rund, kniehoch und von einer beigen Farbe. Auf den "+
    "ersten Blick koennte man meinen es waere Holz aber es scheint "+
    "sich um Pilzmaterial zu handeln.") );
  AddDetail( ({"holz", "material", "pilzmaterial", "anschein"}), BS(
    "Sitzgelegenheiten und Tische sind aus einem holzaehnlichen "+
    "Material. Dem Anschein nach ist es Pilzmaterial.") );
  AddDetail( ({"schenke", "raum", "hoehle", "behausung", "behausungen"}), BS(
    "Dies ist die Schenke der Troglodyten. Hier treffen sich die Dorfbewohner "+
    "nach getaner Arbeit und plaudern in Geselligkeit. Die Tische und "+
    "Sitzgelegenheiten scheinen zwar aus Holz zu sein, aber irgendwas laesst Dich "+
    "vermuten dass es eher ein vergleichbares Pilzmaterial ist.") );

  AddDetail( ({"hoehlenwasser", "wasser"}), BS(
    "Das Wasser das hier ausgeschenkt wird ist besonders sauber, schmeckt dafür aber "+
    "auch etwas anders, da es sich ja duch die Felsen erst durchsickern musste.") );
  AddDetail( ({"calvadox"}), BS(
    "Calvadox wird von den Troglodyten aus dem Vergaeren von Kleinpilzen "+
    "gewonnen. Es hat daher einen etwas erdigen Geschmack." ) ); 
  AddDetail( ({"sandox"}), BS(
    "Sandox ist ein scharfes, bierartiges Getraenk das durch auskochen einer "+
    "bestimmten Kaeferart gewonnen wird. ") );
  AddDetail( ({"kaefer", "fleisch"}), BS(
    "Das weissliche Fleisch das hier gebraten aufgetischt wird, hat eine dicke "+
    "Kruste und eine zaehe Konsistenz. Nicht jedem schmeckt sowas, fuer Troglodyten "+
    "ist es ein Leckerbissen.") );
  AddDetail( ({"kaeferbein", "bein"}), BS(
    "Du weisst nicht wie dieses Bein zubereitet wurde, es muss aber ganz besonders "+
    "zubereitet sein, da die Chitinkruste besonder zart und weich geworden ist. ") );
  AddDetail( ({"pilzragout", "ragout"}), BS(
    "Dieses Ragout, aus nicht weniger als 4 Pilzsorten, hat einen suess-sauren Geruch. "+
    "Warscheinlich schmeckt es auch so.") );
  AddDetail( ({"bibliothek"}), BS(
    "Ist Dir noch nicht aufgefallen dass Troglodyten blind sind? Eine Bibliothek wirst Du daher hier nicht finden." ) );
  AddDetail( ({"farbe"}), BS(
    "Das Pilzmaterial hat eine beige Farbe." ) );

/*
  AddDetail( ({""}), BS(
    "" ) );
*/

  AddDrink(  "hoehlenwasser",({ "hoehlenwasser", "wasser" }),140, 8, 0, 8,
         ({ "Du trinkst Dein Wasser in einem Zug aus.",
            "&& leert in einem Zug ein Glas Hoehlenwasser." }) );
  AddDrink(  "Calvadox",({ "calvadox" }),425, 10, 10, 10,
         ({ "Du trinkst mit Genuss Deinen Calvadox.",
            "&& laesst sich ein Glas Calvadox schmecken." }));  
  AddDrink(  "Sandox",({ "sandox" }),315, 8, 2, 16,
         ({ "Ah - dieser Humpen Sandox erfrischt.",
            "&& erfrischt sich mit einem Humpen Sandox." }));  
  AddFood(  "gebratener Kaefer", ({ "kaefer" }),551, 32,
         ({ "Du verspeist ein knusprig gebratenes Kaefersteak mit einem Haps.",
            "&& laesst sich ein gebratenes Kaefersteak schmecken." }) );
  AddFood(  "Kaeferbein",({ "bein", "kaeferbein" }), 467, 22,
         ({ "Du verschlingst das Kaeferbein.",
            "&& verschlingt ein Kaeferbein." }) );
  AddFood(  "Pilzragout", ({ "ragout", "pilzragout" }),373, 16,
         ({ "Du verleibst Dir ein maechtiges Pilzragout ein.",
            "&& macht sich ueber ein Pilzragout her." }) );

  /* Exits */
  AddExit( "sueden" , ROOM + "troglodyten_h4.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "resatox.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  RemoveItem( "/obj/topliste" );
}
