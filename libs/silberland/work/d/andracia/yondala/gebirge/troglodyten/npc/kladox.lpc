// tempelvorsteher

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"kladox", "tempelvorsteher", "vorsteher"}) );
  create_default_npc(15+random(5));

  SetProp(P_NAME, "Kladox");
  SetProp( P_SHORT, "Kladox, der Tempelvorsteher der Troglodyten");
  SetProp( P_LONG, BS("Dies ist Kladox, der Tempelvorsteher der Troglodyten. Er verstroemt einen "+
    "leicht stechenden Geruch, sehr aehnlich wie manche Kaefer ihn haben. "+
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen."));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_g6.lpc");
  SetProp(P_MNPC_FLAGS, 0);

  AddInfo( ({"kladox", "tempelvorsteher"}) ,
    "Ich bin Kladox, der Vertreter Enmesharra's. Seine Macht gibt unserem Dasein "+
    "Sinn. " , "sagt: " );
  AddInfo( ({"tempel"}) , 
    "Dies ist der Tempel von Enmesharra. Seid respektvoll und ehrt unsere "+
    "heilige Staette." , "sagt: " );
  AddInfo( ({"enmesharra"}) , 
    "Enmesharra ist ein Mysterium. Er leitet uns und gab uns die Hoehlen "+
    "als sein Reich. Er wird kommen und die Pilze werden die Oberflaeche "+
    "ueberdachen und damit Schutz vor dem Himmel fuer alle bringen." , "sagt: " );
  AddInfo( ({"geruch"}) , 
    "Was ihr hier riecht ist das Druesensekret von Kopfhornkaefern. "+
    "Es dient uns zur Wahrung unserer Aufgaben hier im Tempel. " , "sagt: " );

  SUID;
  CLONEME(ARMOUR + "mushroom_cloak.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}