// schneiderei

inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Schneiderei" );
  SetProp( P_INT_LONG,
     BS("Dies ist eine Schneiderei. Viele verschieden Kleidungsstuecke stehen "+
     "hier zum Verkauf. Auch eine grosse Auswahl an Ruestungen kann man hier "+
     "erwerben. Scheinbar sind die Gewebe aus Pilzfasern und die "+
     "Chitinplattenruestungen besonders begehrt."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "\nmiitox");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( ROOM + "troglodyten_f6_storage.lpc");
  SetProp( P_SPECIAL_SHOP, ([P_AC:"Hier kann man nur mit Kleidung und Ruestungen handeln.\n"]) );

  AddDetail( ({"boden"}), BS(
    "Der felsige Boden ist hier trocken und mit einer duennen Schicht "+
    "gelblichen Staub bedeckt. " ) );
  AddDetail( ({"decke", "pilzschirm", "dach"}), BS(
    "Die Decke scheint die Unterseite des Pilzschirms zu sein. Leicht gelbliche "+
    "Sporen rieseln als kleine Staubwolken langsam aus den Lamellen des Pilzschirms "+
    "auf alles herab." ) );
  AddDetail( ({"waende", "steinwaende", "seiten", "wand"}), BS(
    "Die einfach gemauerten Steinwaende begrenzen den Raum zu allen Seiten. Nur im "+
    "Norden ist eine Luecke frei um den Raum wieder zu verlassen." ) );
  AddSound( DEFAULT_SOUND, BS(
    "Du kannst hier nichts besonderes hoeren." ) );
  AddSmell( DEFAULT_SMELL, BS(
    "Du kannst hier nichts besonderes riechen." ) );

  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({ "raum", "schneiderei", "behausung", "behausungen", "hoehle" }), BS(
    "Ein paar Verkaufstische liegen mit allerlei Kleidung und Ruestungen voll."
    "Ansonsten kann man einen Arbeitstisch und ein kleines Regal mit "+
    "Chitinplatten erkennen."));
  AddDetail( ({"tische", "tisch", "verkaufstische", "verkaufstisch"}), BS(
    "Auf den Verkaufstischen liegen allerlei Kleidung und Ruestungen. Ansonsten "+
    "kannst Du nichts besonderes daran erkennen.") );
  AddDetail( ({"kleidung", "ruestungen", "ruestung", "chitinruestung", "chitinruestungen", "ueberblick", "auswahl"}), BS(
    "Mit 'zeige' kannst Du dir einen Ueberblick verschaffen.") );
  AddDetail( ({"chitinplatte", "chitinplatten", "regal", "platten"}), BS(
    "Zum Herstellen von Chitinruestungen benoetigt der Schneider diese Platten. Frag "+
    "ihn doch einfach danach vielleicht stellt er ja auch eine ganz fuer dich her.") );
  AddDetail( ({"pilze", "pilz"}), BS(
    "Der Pilzschirm ueber Dir bildet das Dach. Ansonsten sind hier keine "+
    "Pilze." ) );
  AddDetail( ({"sporen", "staub", "schicht", "staubwolken", "staubwolke", "wolke", "wolken"}), BS(
    "Feiner gelber Staub haengt hier in der Luft. Es sind scheinbar Sporen, die "+
    "aus den Lamellen des Pilzschirms herabfallen. Hoffentlich schaden diese "+
    "Sporen deiner Lunge nicht, denn Du kannst gar nicht vermeiden dass Du sie einatmest." ) );
  AddDetail( ({"lamellen", "lamelle", "unterseite"}), BS(
    "Die Pilze haben an der Unterseite ihres Pilzschirms Lamellen aus denen die "+
    "reifen Sporen herabfallen. Hier unter dem dachbildenden Pilzschirm rieseln "+
    "die Sporen als gelbliche Wolken herab." ) );
  AddDetail( ({"lunge", "luft"}), BS(
    "Solange Du nicht schmerzhaft husten musst ist alles okay. " ) );
  AddDetail( ({"mauern", "mauer"}), BS(
    "Die Behausungen der Troglodyten und auch diese Schneiderei wird von Mauern begrenzt. " ) );
  AddDetail( ({"luecke", "ausgang"}), BS(
    "Durch die Luecke in der Mauer im Norden kann man wieder hinaus. " ) );
  AddDetail( ({"bibliothek"}), BS(
    "Ist Dir noch nicht aufgefallen dass Troglodyten blind sind? Eine Bibliothek wirst Du daher hier nicht finden." ) );
  AddDetail( ({"pilzfasern", "kleidung", "kleidungsstuecke", "gewebe"}), BS(
    "Aus Pilzfasern kann man hier Kleidung schneidern lassen." ) );
  AddDetail( ({"chitinplattenruestungen"}), BS(
    "Die Troglodyten wissen wie man aus Chitinplatten Ruestungen schneidert." ) );
  AddDetail( ({"arbeitstisch"}), BS(
    "Nur ein ganz normaler, steinerner Tisch. " ) );

/*
  AddDetail( ({""}), BS(
    "" ) );
*/

  /* Exits */
  AddExit( "norden" , ROOM + "troglodyten_f5.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "miitox.lpc", REFRESH_DESTRUCT );
  AddItem( OBJ + "infotafel.lpc", REFRESH_REMOVE );
}