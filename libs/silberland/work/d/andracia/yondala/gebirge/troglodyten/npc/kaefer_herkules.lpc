// herkuleskaefer

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(6);

  AddId(({"herkuleskaefer"}));
  SetProp( P_SHORT, "Herkuleskaefer");
  SetProp( P_LONG, 
    BS("Kopf und Thorax haben eine schwarzbraune Faerbung. Auch die Panzerplatten "+
    "sind vorne am Ansatz so dunkel, werden aber zum hinteren Ende hin deutlich "+
    "heller. Leider sind diese Platte zu klein um fuer Ruestungen verwendet werden "+
    "zu koennen. Auffallend sind auch die kraeftigen Mandibeln und die für Kaefer "+
    "ungewöhnlich kurzen Fuehler. ") );
  SetProp( P_NAME, "Herkuleskaefer");
  SetProp( P_KILL_NAME, "Herkuleskaefer");

  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));
 
  SetProp( P_SIZE, 32); //in cm
  SetProp( P_WEIGHT, 8000); //in g

  SetProp( P_SPELLRATE, 8);
  AddSpell( 6, 4+random(5),
    "Der Herkuleskaefer wirft dich gegen dein Bein.", 
    "@WER wird vom Herkuleskaefer gegen die Wade getroffen.",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 4, 8+random(8),
    "Ploetzlich stellt sich der Herkuleskaefer auf und bespritzt dich mit Saeure.",
    "Der Herkuleskaefer stellt sich auf und bespritzt @WEN mit Saeure.",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );

}