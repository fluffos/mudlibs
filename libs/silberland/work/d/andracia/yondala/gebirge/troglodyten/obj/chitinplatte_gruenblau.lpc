inherit "std/unit.lpc";

#include "unit.h"
#include "properties.h"
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties

  SetProp( P_INFO, BS("Ein patenter Schneider kann sicher eine gute "+
    "Ruestung mit solchen Platten erstellen.") );
  SetProp( P_NAME, ({ "Chitinplatte", "Chitinplatten" }) );
  SetProp( P_NAME_ADJ, "gruenblau");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_CHITIN );

  AddId( ({"chitinplatte", "chitinplatten", "\nchitinplatte_gruenblau", "platte", "platten",
  	"gruenblaue chitinplatte", "gruenblaue chitinplatten"}) );

  SetProp( P_NOBUY, 1);

  SetCoinsPerUnits(18,1);
  SetGramsPerUnits(21,1);

  AddSingularId("chitinplatte", "platte");
  AddPluralId("chitinplatten", "platten");

}

string long()
{
	string erg;
	
  if( QueryProp(P_AMOUNT) == 1 )
    return BS("Diese gruenblaue Chitinplatte war einmal Bestandteil eines "+
    "Scheinstutzkaefers. Die auffaellige Punktreihe macht dies Platte "+
    "zu etwas besonderem. Sie ist ungewoehnlich leicht und federt bei "+
    "Belastungen nur wenig. Um sich daraus eine Ruestung schneidern zu lassen "+
    "benoetigt man aber mehr als nur diese eine Platte.");
  else
    erg = "Diese gruenblauen Chitinplatten waren einmal Bestandteil von "+
    "Scheinstutzkaefern. Die auffaelligen Punktreihen machen diese Platten "+
    "zu etwas besonderem. Sie sind ungewoehnlich leicht und federn bei Belastungen "+
    "nur wenig. ";
  if( QueryProp(P_AMOUNT) > 46 )
    erg += "Mit "+QueryProp(P_AMOUNT)+" gruenblauen Chitinplatten kannst Du Dir "+
    "eine Ruestung schneidern lassen und hast warscheinlich sogar noch welche "+
    "uebrig.";
  /*else
    erg += "Mit diesen gruenblauen Chitinplatten kannst Du Dir sicherlich"+
    "eine Ruestung schneidern lassen.";*/
  return BS(erg);  
}
