#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar rote Chitinplattenstiefel");
  SetProp(P_LONG,
    BS("Diese Plattenstiefel wurde aus den Panzerplatten des Corbonitkaefers "+
    "gefertigt. Sie sind rot und schimmern leicht metallisch. "+
    "Ein faehiger Schneider hat diesen Stiefel mit Pilzfasereinlagen versehen "+
    "damit man sie besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenstiefel");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "plattenstiefel", "chitinstiefel", "chitinplattenstiefel"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 1105);
  SetProp(P_VALUE, 5448);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1, DT_ACID:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

