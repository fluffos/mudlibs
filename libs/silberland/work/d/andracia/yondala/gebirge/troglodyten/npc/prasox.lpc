// Haeuptling

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"prasox", "haeuptling", "chef"}) );
  create_default_npc(15+random(5));

  SetProp(P_NAME, "Prasox");
  SetProp( P_SHORT, "Prasox der Haeuptling der Troglodyten");
  SetProp( P_LONG, BS("Dies ist Prasox der Haeuptling der Troglodyten. Er hat eine ledrige Haut mit einem leichten Gelbstich. "+
    "Er ist ein kleines Stueck groesser als all die anderen Troglodyten hier und scheint auch ein gutes Stueck muskuloeser zu sein. "+
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen. "));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_e4.lpc");
  SetProp(P_MNPC_FLAGS, 0);

  AddInfo( ({"prasox", "haeuptling"}) , 
    "Ich bin der Haeuptling der Troglodyten. Ich bin das Sprachrohr und "+
    "Richter hier im Hoehlenreich." , "sagt: " );
  AddInfo( ({"versammlungraum"}) , 
    "Im Versammlungsraum gehe ich meinen Aufgaben nach." , "sagt: " );

  SUID;
  CLONEME(ARMOUR + "mushroom_armour.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}