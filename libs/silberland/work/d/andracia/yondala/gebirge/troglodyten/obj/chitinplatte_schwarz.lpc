inherit "std/unit.lpc";

#include "unit.h"
#include "properties.h"
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties

  SetProp( P_INFO, BS("Ein patenter Schneider kann sicher eine gute "+
    "Ruestung mit solchen Platten erstellen.") );
  SetProp( P_NAME, ({ "Chitinplatte", "Chitinplatten" }) );
  SetProp( P_NAME_ADJ, "schwarz");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_CHITIN );

  AddId( ({"chitinplatte", "chitinplatten", "\nchitinplatte_schwarz", "platte", "platten",
  	"schwarze chitinplatte", "schwarze chitinplatten"}) );

  SetProp( P_NOBUY, 1);

  SetCoinsPerUnits(14,1);
  SetGramsPerUnits(26,1);

  AddSingularId("chitinplatte", "platte");
  AddPluralId("chitinplatten", "platten");

}

string long()
{
	string erg;
	
  if( QueryProp(P_AMOUNT) == 1 )
    return BS("Diese schwarze Chitinplatte war einmal Bestandteil eines grossen Kaefers. "+
    "Sie ist ungewoehnlich leicht und federt bei Belastungen wieder zurueck. "+
    "Um sich daraus eine Ruestung schneidern zu lassen benoetigt man aber mehr "+
    "als nur diese eine Platte.");
  else
    erg = "Diese schwarzen Chitinplatten waren einmal Bestandteil von grossen Kaefern. "+
    "Sie sind ungewoehnlich leicht und federn bei Belastungen wieder zurueck. ";
  if( QueryProp(P_AMOUNT) > 46 )
    erg += "Mit "+QueryProp(P_AMOUNT)+" schwarzen Chitinplatten kannst Du Dir "+
    "eine Ruestung schneidern lassen und hast warscheinlich sogar noch welche "+
    "uebrig.";
  /*else
    erg += "Mit diesen schwarzen Chitinplatten kannst Du Dir sicherlich"+
    "eine Ruestung schneidern lassen.";*/
  return BS(erg);  
}
