#include "../def.h"

inherit "std/room";

#include <properties.h>

int anz_pilze = 4;

void reset()
{
	if( anz_pilze < 4 ) anz_pilze++;
	::reset();
}	

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Pilzfarm" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich hier in einer großen Pilzfarm. Die leicht leuchtenden "+
     "Pilze bilden einen Wald von fast zwei Zwergenlaengen Hoehe. Dazwischen wachsen "+
     "viele kleinere Pilze. Die ganze Hoehle ist erfuellt vom Leuchten der Pilze. "+
     "Zwischen den Pilzreihen sind Wege angelegt worden. Hin und wieder kann man "+
     "kahle Stellen erkennen an denen wohl die Pilze geerntet wurden. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND, BS(
    "Du kannst nichts besonderes hoeren. ") ); 
  AddSmell( DEFAULT_SMELL, BS(
    "Es riecht hier vorallem nach Pilzsporen.") );
  AddSmell( ({"pilzsporen", "pilzspore", "erde"}), BS(
    "Die Pilzsporen riechen irgendwie suessauer und nach frischer Erde.") );

  AddDetail( ({"boden", "untergrund"}), BS(
    "Die Wege die hier angelegt wurden bestehen aus Felsschotter. Daneben wachsen "+
    "die Pilze in feuchtem Schlamm. Du willst deshalb die Wege lieber nicht verlassen. ") );
  AddDetail( ({"decke"}), BS(
    "Die ist eine hoehere Halle und die Pilze erleuchten den Raum bis zur hohen Decke. "+
    "Sie scheint aus normalen Felsgestein zu bestehen. ") );
  AddDetail( ({"waende", "wand"}), BS(
    "Die Waende sind aus ganz normalem Felsgestein. ") );
  AddDetail( ({"raum", "pilzfarm", "umgebung", "halle", "hoehle", "platz"}), BS(
    "Du befindest Dich hier in einer großen Pilzfarm. Die leicht leuchtenden "+
    "Pilze bilden einen Wald von fast zwei Zwergenlaengen Hoehe. Dazwischen wachsen "+
    "viele kleinere Pilze. Die ganze Hoehle ist erfuellt vom Leuchten der Pilze. "+
    "Zwischen den Pilzreihen sind Wege angelegt worden. Hin und wieder kann man "+
    "kahle Stellen erkennen an denen wohl die Pilze geerntet wurden. ") );
  AddDetail( ({"pilze", "pilz", "pilzreihen", "pilzreihe", "wald"}), BS(
    "Die Pilze wachsen hier wie in einem Wald von ungefaehr zu zwei Zwergenlaengen Hoehe. "+
    "Ein paar kahle Stellen zeugen davon dass die Troglodyten hier bei Bedarf "+
    "Pilze ernten. Der schlammige Untergrund scheint fuer diese Pilze besonders "+
    "gut geeignet zu sein.") );
  AddDetail( ({"hoehe", "groesse"}), BS(
    "Viele Pilze sind um die zwei Zwergenlaengen hoch. Dazwischen wachsen kleinere Pilze "+
    "verschiedenster Groessen.") );
  AddDetail( ({"wege", "weg"}), BS(
    "Mitten durch die vielen Pilze sind Wege mit Schotter freigehalten damit man "+
    "nicht durch den schlammigen Untergrund stapfen muss. ") );
  AddDetail( ({"stellen"}), BS(
    "Es gibt ein paar Stellen an denen erst kuerzlich die Pilze abgeerntet wurden "+
    "und daher etwas kahl wirken.") );
  AddDetail( ({"troglodyten", "wesen"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({"leuchten", "licht", "lichtquelle"}), BS(
    "Dieses schwache Leuchten von den vielen Pilzen taucht die Hoehle "+
    "in ein ungewoehnliches Licht. Hier kann man auch ohne Lichtquelle "+
    "seine Umgebung erkennen.") );
  AddDetail( ({"felsen", "fels", "felsgestein", "schotter", "gestein", "felsschotter"}), BS(
    "Hier in den Hoehlen ist fast alles Fels. Decke, Waende und Wege bestehen aus "+
    "diesem Gestein.") );
  AddDetail( ({"schlamm"}), BS(
    "Der schlammige Boden neben dem Weg scheint fuer die Pilze der richtige Untergrund.") );
  AddDetail( ({"bibliothek", "buecher"}), BS(
    "Da Troglodyten blind sind haben sie keine Verwendung fuer Buecher. Hier wirst Du keine "+
    "Bibliothek finden.") );
  AddDetail( ({"zwergenlaenge", "zwergenlaengen"}), BS(
    "So hoch wie eben ein ausgewachsener Zwerg wird.") );
  AddDetail( ({"bedarf"}), BS(
    "Wenn Du Pilzfasern benoetigst ist hier der richtige Platz.") );
  AddDetail( ({"pilzfaser", "pilzfasern", "herstellung", "nahrung", "verwendung"}), BS(
    "Pilzfasern werden von den Troglodyten als Nahrung oder zur Herstellung von Ruestungen verwendet.") );
  AddDetail( ({"ruestung", "ruestungen"}), BS(
    "Als Abenteurer ist eine gute Ruestung wichtig.") );
  AddDetail( ({"abenteurer"}), BS(
    "Du bist doch einer, oder?") );

/*
  AddDetail( ({""}), BS(
    "") );
*/
  AddCmd( ({"faelle"," schlage", "faell", "schlag"}), "cmd_faellen" );
  
}

int cmd_faellen(string str)
{
	object ob;
	
	notify_fail( "Was willst Du faellen?\n" );
	if( str!="pilz" && str!="pilze" ) return 0;
	notify_fail( "Das kannst Du waehrend eines Kampfs nicht.\n" );
	if( TP->InFight() ) return 0;
	notify_fail( "Im Dunkeln kannst Du das leider nicht.\n" );
	if( TP->CannotSee() ) return 0;
	notify_fail( BS("Leider sind hier keine Pilze zu finden die eine ausreichende Hoehe zum Faellen aufweisen.") );
	if( anz_pilze<1 ) return 0;
	notify_fail( "Du hast leider keine Axt gezueckt um Pilze zu faellen.\n" );
	if( !ob=TP->QueryProp(P_WEAPON) ) return 0;
	if( ob->QueryProp(P_WEAPON_TYPE)!=WT_AXE ) return 0;	
	notify_fail( "Du bist doch schon dabei einen Pilze zu faellen.\n" );
	if( TP->QueryProp(P_NOMOVE) ) return 0;
	
	// nun faellen
	TP->SetProp(P_NOMOVE, "Du bist geade beschaeftigt mit Faellen eines Pilzes.\n" );
	write("Du beginnst mit dem Faellen eines Pilzes.\n");
	say(TP->name()+" beginnt mit dem Faellen eines Pilzes.\n");
	anz_pilze--;
	call_out( "faellen_fertig", 20+random(4), TP);
	return 1;
}

void faellen_fertig(object spieler)
{
	object ob;
	
	TP->SetProp(P_NOMOVE, 0);
	if( random(30)==0 ) ob=clone_object( OBJ+"pilzfasern_rot" );
	else ob=clone_object( OBJ+"pilzfasern_weiss" );
	ob->SetProp(P_AMOUNT, 2+random(3) );	
	write( BS("Du hast den Pilz gefaellt und nimmst "+ob->name()+".") );
	say( BS(spieler->name()+" hat einen Pilz gefaellt und nimmt sich "+ob->name()+".") );
	if( ob->move(spieler, M_GET) < 0 ) ob->move(TO, M_PUT);
}
