#include "../def.h"
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Informationstafel");
  SetProp(P_LONG,
    "Eine grosse, hoelzerne Tafel mit allerlei Informationen zum den Dienstleistungen des Schneiders. "+
    "Du kannst es bestimmt lesen. " );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Informationstafel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tafel", "infotafel", "hinweistafel", "informationstafel"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );

  SetProp(P_NOGET, "Die Tafel ist fest an der Wand angebracht.");
  AddDetail( ({"tafel", "hinweistafel", "infotafel", "informationstafel" }),
    BS("Ein einfache Tafel. Sie wurde wohl fuer Besucher mit Augen aufgestellt. Versuch es doch mal mit lesen. "));
  AddDetail( ({ "informationen", "infos" }),
    BS("Auf der Tafel stehen die Preise fuer die Dienstleistungen des Schneiders. Lesen mach hier Sinn."));
  AddDetail( ({ "sinn" }),
    BS("Es macht Sinn eine Tafel zu lesen."));
  AddReadDetail( ({"tafel", "hinweistafel", "infotafel", "informationstafel" }),
    " +------------------------------------------------------------------+ \n"+
    " + Zur Herstellung werden benoetigt:                                + \n"+
    " + - Unkostenbeitrag          : 2000 Muenzen                        + \n"+
    " + zusaetzlich folgende Materialien:                                + \n"+
    " + - Pilzfaserhemd            : 70 Pilzfasern                       + \n"+
    " + - Pilzfaserhose            : 80 Pilzfasern                       + \n"+
    " + - Pilzfaserschuhe          : 60 Pilzfasern                       + \n"+
    " + - Pilzfaserguertel         : 50 Pilzfasern                       + \n"+
    " + - Pilzfaserumhang          : 90 Pilzfasern                       + \n"+
    " + - Chitinplattenpanzer      : 40 Pilzfasern und 80 Chitinplatten  + \n"+
    " + - Chitinplattenstiefel     : 20 Pilzfasern und 60 Chitinplatten  + \n"+
    " + - Chitinplattenarmschienen : 24 Pilzfasern und 46 Chitinplatten  + \n"+
    " + - Chitinplattenbeinschienen: 30 Pilzfasern und 50 Chitinplatten  + \n"+
    " +------------------------------------------------------------------+ \n" );
}
