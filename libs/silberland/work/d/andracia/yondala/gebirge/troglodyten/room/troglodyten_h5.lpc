#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Eine Hoehle im Suedosten fuehrt aus dem Dorf hinaus.") );

  AddItem( NPC + "zanilox.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_g5.lpc");
  AddExit( "nordwesten" , ROOM + "troglodyten_g4.lpc");
  AddExit( "norden" , ROOM + "troglodyten_h4.lpc");
  AddExit( "suedosten" , ROOM + "troglodyten_i6.lpc");
}