//Hirschkaefer

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(4);

  AddId(({"hirschkaefer"}));
  SetProp( P_SHORT, "Hirschkaefer");
  SetProp( P_LONG, 
    BS("Besonders auffaellig am Hirschkaefer ist natürlich sein 'Geweih', "+
    "das ihm den Namen Hirschkaefer eingebracht hat. Dabei handelt es sich "+
    "um die massiv vergroesserten Mandibeln des Tieres. Leider sind seine "+
    "Panzerplatten zu klein um fuer Ruestungen verwendet werden "+
    "zu koennen. " ) );
  SetProp( P_NAME, "Hirschkaefer");
  SetProp( P_KILL_NAME, "Hirschkaefer");
 
  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));

  SetProp( P_SIZE, 26); //in cm
  SetProp( P_WEIGHT, 6000); //in g

  SetProp( P_SPELLRATE, 6);
  AddSpell( 6, 4+random(5),
    "Der Hirschkaefer wirft dich gegen dein Bein.", 
    "@WER wird vom Hirschkaefer gegen die Wade getroffen.",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 4, 8+random(8),
    "Ploetzlich stellt sich der Hirschkaefer auf und bespritzt dich mit Saeure.",
    "Der Hirschkaefer stellt sich auf und bespritzt @WEN mit Saeure.",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );

}