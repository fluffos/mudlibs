inherit "std/unit.lpc";

#include "unit.h"
#include "properties.h"
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Properties

  SetProp( P_INFO, BS("Ein patenter Schneider kann sicher eine gute "+
    "Ruestung mit solchen Platten erstellen.") );
  SetProp( P_NAME, ({ "Chitinplatte", "Chitinplatten" }) );
  SetProp( P_NAME_ADJ, "rot");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_CHITIN );

  AddId( ({"chitinplatte", "chitinplatten", "\nchitinplatte_rot", "platte", "platten",
  	"rote chitinplatte", "rote chitinplatten"}) );

  SetProp( P_NOBUY, 1);

  SetCoinsPerUnits(21,1);
  SetGramsPerUnits(27,1);

  AddSingularId("chitinplatte", "platte", "corbonitplatte");
  AddPluralId("chitinplatten", "platten", "corbonitplatten");

}

string long()
{
	string erg;
	
  if( QueryProp(P_AMOUNT) == 1 )
    return BS("Diese rote Chitinplatte war einmal Bestandteil eines Corbonitkaefers. "+
    "Sie ist ungewoehnlich leicht und scheint hart wie Stahl zu sein. "+
    "Um sich daraus eine Ruestung schneidern zu lassen benoetigt man aber mehr "+
    "als nur diese eine Platte.");
  else
    erg = "Diese roten Chitinplatten waren einmal Bestandteil von Corbonitkaefern. "+
    "Sie sind ungewoehnlich leicht und scheint hart wie Stahl zu sein. ";
  if( QueryProp(P_AMOUNT) > 46 )
    erg += "Mit "+QueryProp(P_AMOUNT)+" roten Chitinplatten kannst Du Dir "+
    "eine Ruestung schneidern lassen und hast warscheinlich sogar noch welche "+
    "uebrig.";
  /*else
    erg += "Mit diesen roten Chitinplatten kannst Du Dir sicherlich"+
    "eine Ruestung schneidern lassen.";*/
  return BS(erg);  
}
