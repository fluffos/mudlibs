#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Chitinplattenpanzer");
  SetProp(P_LONG,
    BS("Dieser einfache Plattenpanzer wurde aus den Panzerplatten verschiedener "+
    "Hoehlenkaefer gefertigt. Er ist schwarz und schimmert leicht metallisch. "+
    "Ein faehiger Schneider hat diesen Panzer mit Pilzfasereinlagen versehen "+
    "damit man ihn besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenpanzer");
  // SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "plattenpanzer", "chitinpanzer", "chitinplattenpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 18);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 1856);
  SetProp(P_VALUE, 1020);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1, DT_ACID:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3, SR_MAX_SIZE:190, P_SIZE:155]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

