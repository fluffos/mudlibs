//scheinstutzkaefer

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(15);

  AddId(({"scheinstutzkaefer"}));
  SetProp( P_SHORT, "Scheinstutzkaefer");
  SetProp( P_LONG, 
    BS("Die Faerbung des Scheinstutzkaefers ist gruenblau schimmernd. "+
    "Die Panzerplatten sind mit auffaelligen Punktreihen bedeckt. "+
    "Dieser friedliche Hoehlenbewohner ist besonders giftig und verspritzt "+
    "auch schnellwirkendes Gift aus seiner Afterdruese.") );
  SetProp( P_NAME, "Scheinstutzkaefer");
  SetProp( P_KILL_NAME, "Scheinstutzkaefer");
 
  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));

  AddDetail( ({"faerbung"}), 
    BS("Die Panzerplatten haben eine gruenblaue Faerbung und auffaellige "+
    "Punktreihen. Sie schimmern im Licht. ") );

  SetProp( P_SIZE, 86); //in cm
  SetProp( P_WEIGHT, 38000); //in g

  SetProp( P_SPELLRATE, 8);
  AddSpell( 6, 10+random(6),
    "Der Scheinstutzkaefer wirft dich gegen die Wand.", 
    "@WER wird vom Scheinstutzkaefer gegen die Wand worfen.",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 4, 18+random(8),
    "Ploetzlich stellt sich der Scheinstutzkaefer auf und bespritzt dich mit Gift.",
    "Der Scheinstutzkaefer stellt sich auf und bespritzt @WEN mit Gift.",
    DT_POISON, "vergiften", ([SP_SHOW_DAMAGE:1]) );

  SUID; 
  CLONEME( OBJ+"chitinplatte_gruenblau.lpc" );
  CLONEME( OBJ+"chitinplatte_gruenblau.lpc" );

}

void vergiften(object enemy, int damage, int *dam_type)
{
  if(damage>22) { 
    enemy->AddPoison(1);
    tell_object(enemy, "Das Gift dringt durch die Wunden in deinen Koerper." );
  }
}