// dorfaelteste

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"fanox", "dorfaeltester", "aeltester"}) );
  create_default_npc(12+random(5));

  SetProp(P_NAME, "Fanox");

  SetProp( P_SHORT, "Fanox, der Dorfaelteste");
  SetProp( P_LONG, BS("Dies ist Fanox, der Dorfaelteste. Seine ledrige Haut ist stark verschrumpelt. "+
    "Man koennte glauben man haette ihn verdorren lassen. Ein Alter ist sehr schwer zu schaetzen."+
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen."));

  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_e4.lpc");
  SetProp(P_MNPC_FLAGS, 0);

  AddInfo( ({"fanox", "dorfaeltester", "aeltester"}) , 
    "Ich bin hier der Dorfaelteste - hier passiert nichts wenn ich nicht meine "+
    "Zustimmung gebe." , "sagt: " );
  AddInfo( ({"versammlungraum"}) , 
    "Ich bin immer im Versammlungsraum." , "sagt: " );
  AddInfo( ({"alter"}),
    "Mein Alter verrate ich Euch nicht. ", "sagt: " );

  SUID;
  CLONEME(ARMOUR + "mushroom_cloak.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}