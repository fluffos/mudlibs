#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Sueden ist ein groesserer Spalt im Mauerwerk der Behausungen. Eine "+
    "Hoehle im Westen fuehrt aus dem Dorf hinaus.") );

  AddItem( NPC + "dantox.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_e5.lpc");
  AddExit( "norden" , ROOM + "troglodyten_f4.lpc");
  AddExit( "nordosten" , ROOM + "troglodyten_g4.lpc");
  AddExit( "osten" , ROOM + "troglodyten_g5.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_f6.lpc");
}