#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar gelbe Chitinplattenarmschienen");
  SetProp(P_LONG,
    BS("Diese Armschienen wurden aus Panzerplatten von Termiten "+
    "gefertigt. Sie sind gelb und haben eine dumpfe Oberflaeche. "+
    "Ein faehiger Schneider hat diese Armschienen mit Pilzfasereinlagen versehen "+
    "damit man sie besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenarmschienen");
  SetProp(P_NAME_ADJ, "gelb");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"armschienen", "plattenarmschienen", "chitinarmschienen",
           "chitinplattenarmschienen"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 1410);
  SetProp(P_VALUE, 1916);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

