#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Sueden ist ein groesserer Spalt im Mauerwerk der Behausungen. ") );

  AddItem( NPC + "radilox.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_f5.lpc");
  AddExit( "nordwesten" , ROOM + "troglodyten_f4.lpc");
  AddExit( "norden" , ROOM + "troglodyten_g4.lpc");
  AddExit( "nordosten" , ROOM + "troglodyten_h4.lpc");
  AddExit( "osten" , ROOM + "troglodyten_h5.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_g6.lpc");
}