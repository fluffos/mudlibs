#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gelber Chitinplattenpanzer");
  SetProp(P_LONG,
    BS("Dieser Plattenpanzer wurde aus den Panzerplatten von Termiten "+
    "gefertigt. Er ist gelb und hat eine dumpfe Oberflaeche. "+
    "Ein faehiger Schneider hat diesen Panzer mit Pilzfasereinlagen versehen "+
    "damit man ihn besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenpanzer");
  SetProp(P_NAME_ADJ, "gelb");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "plattenpanzer", "chitinpanzer", "chitinplattenpanzer"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 27);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 2820);
  SetProp(P_VALUE, 3832);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

