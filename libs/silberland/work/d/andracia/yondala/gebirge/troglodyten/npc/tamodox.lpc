// waechter

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"tamodox", "wache", "/ntrwache" }) );
  create_default_npc(18+random(5));
  AddInfo( ({"tamodox"}) ,"Das bin ich.", "sagt: " );

  SetProp(P_NAME, "Tamodox");
  SetProp( P_SHORT, "Tamodox, ein Troglodytenwaechter");
  SetProp( P_LONG, BS("Dies ist Tamodox, ein Troglodytenwaechter. Seine breiten Atemloecher im Gesicht schauen aus "+
    "wie tiefe Hoehlen. Das Fehlen einer ausgeformten Nase laesst Troglodyten besonders andersartig aussehen. "+
    "Es irritiert aber auch in ein Gesicht ohne Augen zu schauen."));
  SetProp(P_MNPC_AREA, ({ROOM+"troglodyten_e4.lpc",ROOM+"troglodyten_f3.lpc",
    ROOM+"troglodyten_f4.lpc",ROOM+"troglodyten_f5.lpc",ROOM+"troglodyten_f6.lpc",
    ROOM+"troglodyten_g4.lpc",ROOM+"troglodyten_g5.lpc",ROOM+"troglodyten_g6.lpc",
    ROOM+"troglodyten_h3.lpc",ROOM+"troglodyten_h4.lpc",ROOM+"troglodyten_h5.lpc" }) );

  SUID;
  CLONEME(ARMOUR + "chitin_armour.lpc");
  CLONEME(ARMOUR + "chitin_legs.lpc");
  CLONEME(ARMOUR + "chitin_boots.lpc");
  CLONEME(ARMOUR + "chitin_arms.lpc");
  command("trage alles");
  CLONEME(WEAPON + "speer.lpc");
  command("zuecke speer");
  
}