// wirt

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "trnpc_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"resatox", "wirt"}) );
  create_default_npc(15+random(5));

  SetProp(P_NAME, "Resatox");
  SetProp( P_SHORT, "Resatox, der Wirt der Troglodyten");
  SetProp( P_LONG, BS("Dies ist Resatox, der Wirt der Troglodyten. Ein etwas rundlicher Vertreter seiner Rasse. "+
    "Vom Gesichtsausdruck aber auch genauso grimmig wie alle Troglodyten. Gesichtsmimik scheint fuer diese blinden "+
    "Hoehlenbewohner kaum relevant zu sein.´"+
    "Es irritiert ein kleines bischen in ein Gesicht ohne Augen zu schauen."));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_h3.lpc");
  SetProp(P_MNPC_FLAGS, 0);

  AddInfo( ({"resatox", "wirt"}) , 
    "Bei mir kannst Du bestellen, ich hab eine vorzuegliche Kueche. "+
    "Probier doch mal unser saftiges Kaefersteak." , "sagt: " );
  AddInfo( ({"schenke", "pub", "tanke", "tanken"}) , 
    "Meine Angebote kannst Du Dir mit 'menue' anzeigen lassen." , "sagt: " );

  SUID;
  CLONEME(ARMOUR + "mushroom_armour.lpc");
  CLONEME(ARMOUR + "mushroom_legs.lpc");
  CLONEME(ARMOUR + "mushroom_boots.lpc");
  command("trage alles");

}