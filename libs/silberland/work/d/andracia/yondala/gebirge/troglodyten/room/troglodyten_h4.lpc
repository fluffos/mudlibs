#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Norden ist ein groesserer Spalt im Mauerwerk der Behausungen. ") );

  AddItem( NPC + "tamodox.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_g4.lpc");
  AddExit( "norden" , ROOM + "troglodyten_h3.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_h5.lpc");
  AddExit( "suedwesten" , ROOM + "troglodyten_g5.lpc");
}