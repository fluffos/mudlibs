#include "../def.h"

inherit ROOM + "trhoehle_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Osten kann man gedaempft Geraeusche vernehmen.") );
  AddSound( DEFAULT_SOUND , "Gedaempfte Geraeusche kommen aus dem Osten. \n" );
  AddSound( ({"geraeusch", "geraeusche"}), BS(
    "Dort scheint sich wohl das Dorf der Troglodyten zu befinden.") );
  RemoveSound( ({"stille"}) );

  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_d5.lpc");
  AddExit( "osten" , ROOM + "troglodyten_f5.lpc");
}