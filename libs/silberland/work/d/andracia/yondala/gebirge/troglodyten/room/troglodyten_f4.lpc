#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Im Westen und Norden sind groessere Spalte im Mauerwerk der Behausungen. ") );

  AddItem( NPC + "bladox.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "troglodyt.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_e4.lpc");
  AddExit( "norden" , ROOM + "troglodyten_f3.lpc");
  AddExit( "osten" , ROOM + "troglodyten_g4.lpc");
  AddExit( "suedosten" , ROOM + "troglodyten_g5.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_f5.lpc");
}