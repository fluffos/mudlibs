// versammlungsraum
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Versammlungsraum" );
  SetProp( P_INT_LONG,
     BS("Dies ist der Versammlungsraum der Troglodyten. Hier wirst Du den "+
     "Dorfaeltesten und den Haeuptling diese Dorfs finden. Wenn Du offizielle "+
     "Anliegen an die Troglodyten hast so ist hier der richtige Ort. "));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"boden"}), BS(
    "Der felsige Boden ist hier trocken und mit einer duennen Schicht "+
    "gelblichen Staub bedeckt. " ) );
  AddDetail( ({"decke", "pilzschirm", "dach"}), BS(
    "Die Decke scheint die Unterseite des Pilzschirms zu sein. Leicht gelbliche "+
    "Sporen rieseln als kleine Staubwolken langsam aus den Lamellen des Pilzschirms "+
    "auf alles herab." ) );
  AddDetail( ({"waende", "steinwaende", "seiten", "wand"}), BS(
    "Die einfach gemauerten Steinwaende begrenzen den Raum zu allen Seiten. Nur im "+
    "Osten ist eine Luecke frei um den Raum wieder zu verlassen." ) );
  AddSound( DEFAULT_SOUND, BS(
    "Du kannst hier nichts besonderes hoeren." ) );
  AddSmell( DEFAULT_SMELL, BS(
    "Du kannst hier nichts besonderes riechen." ) );

  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({ "raum", "versammlungsraum", "behausungen", "behausung", "hoehle", "ort" }), BS(
    "In diesem grossen Raum halten die Troglodyten Versammlungen ab. Warscheinlich "+
    "haelt hier der Haeuptling auch Gericht ueber Verbrecher und Stoerenfriede. "+
    "mehrere Baenke sind hier in einem Kreis aufgestellt. "));
  AddDetail( ({"baenke", "bank"}), BS(
    "Auf den Baenken werden zur Versammlung wohl die berufenen Dorfbewohner sitzen "+
    "und ueber die Streitfragen des Dorfs entscheiden. ") );
  AddDetail( ({ "gericht" }), BS(
    "Der Haeuptling wird wohl der Richter sein. Ob das aber dann ein ordentliches "+
    "Gericht wie im Sinne der Oberwelt ist zu bezweifeln."));
  AddDetail( ({ "verbrecher", "stoerenfriede" }), BS(
    "Die Wachen passen schon auf dass hier keine Gesetze gebrochen werden."));
  AddDetail( ({ "kreis", "tribuene" }), BS(
    "Die Baenke sind im Kreis angeordnet. Eine Tribuene oder aehnliches "+
    "ist hier wohl nicht sinnvoll, da Troglodyten den Redner sowieso nicht sehen koennen." ));
  AddDetail( ({ "versammlung", "redner" }), BS(
    "Zur Zeit ist keine Versammlung."));
  AddDetail( ({ "fragen", "streitfragen", "probleme", "problem" }), BS(
    "Was die Dorfbewohner für Probleme hier besprechen werden ist Dir nicht bekannt. "));
  AddDetail( ({ "gesetze" }), BS(
    "Welche Gesetze die Troglodyten befolgen ist dir unbekannt. Hoffentlich "+
    "begehst Du nicht in deiner Unwissenheit einen Fehler der die Dorfbewohner "+
    "gegen dich aufbringt."));
  AddDetail( ({"pilze", "pilz"}), BS(
    "Der Pilzschirm ueber Dir bildet das Dach. Ansonsten sind hier keine "+
    "Pilze." ) );
  AddDetail( ({"sporen", "staub", "schicht", "staubwolken", "staubwolke", "wolken", "wolke"}), BS(
    "Feiner gelber Staub haengt hier in der Luft. Es sind scheinbar Sporen, die "+
    "aus den Lamellen des Pilzschirms herabfallen. Hoffentlich schaden diese "+
    "Sporen deiner Lunge nicht, denn Du kannst gar nicht vermeiden dass Du sie einatmest." ) );
  AddDetail( ({"lamellen", "lamelle", "unterseite"}), BS(
    "Die Pilze haben an der Unterseite ihres Pilzschirms Lamellen aus denen die "+
    "reifen Sporen herabfallen. Hier unter dem dachbildenden Pilzschirm rieseln "+
    "die Sporen als gelbliche Wolken herab." ) );
  AddDetail( ({"lunge", "luft"}), BS(
    "Solange Du nicht schmerzhaft husten musst ist alles okay. " ) );
  AddDetail( ({"mauern", "mauer"}), BS(
    "Die Behausungen der Troglodyten und auch dieser Versammlungsraum wird von "+
    "Mauern begrenzt. " ) );
  AddDetail( ({"luecke", "ausgang"}), BS(
    "Durch die Luecke in der Mauer im Osten kann man wieder hinaus. " ) );
  AddDetail( ({"bibliothek"}), BS(
    "Ist Dir noch nicht aufgefallen dass Troglodyten blind sind? Eine Bibliothek wirst Du daher hier nicht finden." ) );

/*
  AddDetail( ({""}), BS(
    "" ) );
*/

  /* Exits */
  AddExit( "osten" , ROOM + "troglodyten_f4.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "fanox.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "prasox.lpc", REFRESH_DESTRUCT );

}