#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(12);

  AddId(({"felsenfresserkaefer", "felsenfresser"}));
  SetProp( P_SHORT, "Felsenfresserkaefer");
  SetProp( P_LONG, 
    BS("Der Felsenfresserkaefer hat eine besonders starke Saeure als Waffe. "+
    "Sein tiefschwarzer Koerper schimmert nur wenig im Licht. ") );
  SetProp( P_NAME, "Felsenfresserkaefer");
  SetProp( P_KILL_NAME, "Felsenfresserkaefer");
 
  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));

  AddDetail( ({"saeure"}), 
    BS("Die wirst Du erst zu spueren bekommen wenn Du ihn angreifst. ") );

  SetProp( P_SIZE, 72); //in cm
  SetProp( P_WEIGHT, 28000); //in g

  SetProp( P_SPELLRATE, 8);
  AddSpell( 6, 10+random(6),
    "Der Felsenfresserkaefer wirft dich gegen die Wand.", 
    "@WER wird vom Felsenfresserkaefer gegen die Wand worfen.",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 4, 28+random(8),
    "Ploetzlich stellt sich der Felsenfresserkaefer auf und bespritzt dich mit Saeure.",
    "Der Felsenfresserkaefer stellt sich auf und bespritzt @WEN mit Saeure.",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );

  SUID; 
  CLONEME( OBJ+"chitinplatte_schwarz.lpc" );
  CLONEME( OBJ+"chitinplatte_schwarz.lpc" );

}