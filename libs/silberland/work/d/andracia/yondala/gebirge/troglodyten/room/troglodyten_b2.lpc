#include "../def.h"

inherit ROOM + "trhoehle_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Spezial \n" );
  */
  AddItem( ({ NPC+"kaefer_felsenfresser.lpc", 
              NPC+"kaefer_herkules.lpc",
              NPC+"kaefer_hirsch.lpc",
              NPC+"kaefer_kopfhorn.lpc",
              NPC+"kaefer_scheinstutz.lpc" }), REFRESH_DESTRUCT );


  AddExit( "nordwesten" , ROOM + "troglodyten_a1.lpc");
  AddExit( "nordosten" , ROOM + "troglodyten_c1.lpc");
  AddExit( "suedosten" , ROOM + "troglodyten_c3.lpc");

}