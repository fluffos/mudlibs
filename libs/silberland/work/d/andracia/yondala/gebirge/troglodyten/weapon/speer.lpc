#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Speer");
  SetProp(P_LONG,
    "Dieser einfache Speer besteht aus einem harten Pilzstengel und einer "+
    "Steinspitze. Dies ist eher eine primitive aber doch sehr wirkungsvolle "+
    "Waffe wenn man versteht damit umzugehen." );
  SetProp(P_INFO, "Das Besondere an dieser Waffe ist der Umstand dass man "+
    "mit ihr besonders geraeuscharm kaempfen kann. Fuer blinde Kaempfer ist dies "+
    "von grossem Vorteil.");
  SetProp(P_NAME, "Speer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "pilzspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 75);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_MUSHROOM:70, MAT_MISC_STONE:30]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_SIZE, 186);
  SetProp(P_VALUE, 584);
  SetProp(P_QUALITY_DECAY, 70);
  
  SetProp(P_WC_BONUS, (["/ntrwache": 25]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:6, A_DEX:6]) );

  AddDetail( ({"stengel", "pilzstengel", "schaft"}), 
    BS("Der Schaft des Speers ist ein harter Pilzstengel.") );
  AddDetail( ({"spitze", "steinspitze"}), 
    BS("Die primitive Steinspitze des Speers ist nicht besonders scharf. ") );

}
