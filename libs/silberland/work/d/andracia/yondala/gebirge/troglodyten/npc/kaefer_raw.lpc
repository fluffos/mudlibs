//Standartkaefer

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return; 
  ::create(); 
  
  AddId(({"kaefer"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Kaefer");
  SetProp( P_LONG, "Ein langweiliger kleiner Kaefer.");
  SetProp( P_NAME, "Kaefer");
  SetProp( P_GENDER, MALE);
  // SetProp( P_ARTICLE, 0);
  SetProp( P_RACE, "Kaefer");
  SetProp( P_ALIGN, 0); 
  SetProp( P_MAX_HANDS, 6); 
  SetProp( P_HEAL, -1); 
  SetProp( P_WIMPY, 0); 
  SetProp( P_NOMAGIC, 0); 
  SetProp( P_RESISTANCE_STRENGTHS ,  
    ([DT_FIRE:      1.0, DT_WATER: -0.5, DT_AIR:   -0.5, DT_LIGHT:  0.5,
      DT_ACID:     -1.0, DT_POISON:-0.5, DT_MAGIC:  1.0 ]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "krabbelt aus einer Felsspalte.");
  SetProp( P_MMSGOUT, "verschwindet in einer Felsspalte.");
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "troglodyten_g4.lpc");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + 
    MOV_INDOORS + MOV_INCHAT + MOV_OUTDOORS);
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 })); 
  SetProp( P_DIE_MSG,  " sinkt tot zu Boden.\n");
  SetProp( P_NOCORPSE, 0 );

  SetProp( P_REJECT, ({ REJECT_DROP, 
   QueryProp(P_NAME)+"kann Deine Sachen nicht tragen.\n" }) );

  AddInfo( DEFAULT_INFO, "versteht Dich nicht.");

  AddDetail( ({"beine", "fuesse", "bein", "fuss"}), 
    BS("Der Kaefer hat 6 Beine mit denen er flink ueber den Boden krabbeln kann.") );
  AddDetail( ({"fuehler", "taster", "hoerorgan", "riechorgan"}), 
    BS("Der Kaefer hat zwei lange Fuehler die nicht nur zum Tasten verwendet "+
    "werden, sondern scheinbar auch als Riech- und Hoerorgan dienen.") );
  AddDetail( ({"kopf"}), 
    BS("Der Kopf besteht aus zwei grosse Facettenaugen, zwei Fuehlern und "+
    "unterhalb ist eine Zange aus zwei kraeftige Mandibeln.") );
  AddDetail( ({"augen", "facettenaugen"}), 
    BS("Diese Augen schillern in den Farben des Regenbogens. Richtig unheimlich.") );
  AddDetail( ({"mandibeln", "mandibel", "zange"}), 
    BS("Diese Mandibeln sind die Kauwerkzeuge und Waffen des Kaefers.") );
  AddDetail( ({"fluegel"}), 
    BS("Unterdem Panzer des Kaefers sind wohl verkuemmerte Fluegel eingefaltet, "+
    "aber zu mehr als einem leichten Bremsen bei einem tiefen Sturz sind sie "+
    "wohl nicht geeignet.") );
  AddDetail( ({"panzer"}), 
    BS("Der zweiteilige Panzer verdeckt die verkuemmerten Fluegel des Kaefers.") );
  AddDetail( ({"leib", "koerper", "thorax"}), 
    BS("Hinter dem Kopf beginnt der eigentliche Koerper, der Thorax, mit Beinen, "+
    "Panzerplatten und Afterdruese.") );
  AddDetail( ({"druese", "after", "afterdruese", "hintern"}), 
    BS("Am Ende des Thorax hat jeder Kaefer eine Druese um sich gegen Gegner zu "+
    "wehren. Meistens verspritzt diese Druese einen ekligen Geruch aber es gibt "+
    "auch Kaefer die sich mit Saeure oder Gift wehren. ") );

}

