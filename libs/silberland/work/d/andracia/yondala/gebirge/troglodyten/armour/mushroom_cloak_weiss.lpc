#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Pilzfaserumhang");
  SetProp(P_LONG,
    BS("Dieser Umhang ist aus Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. "+
    "Er ist weisslich mit einem leichten Gelbstich, was auch modisch diese "+
    "Kleidung nicht verbessert.") );
  SetProp(P_INFO, BS("Wenigstens riecht er nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "pilzumhang", "pilzfaserumhang"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 486);
  SetProp(P_VALUE, 405);
  SetProp(P_QUALITY_DECAY, 105);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

