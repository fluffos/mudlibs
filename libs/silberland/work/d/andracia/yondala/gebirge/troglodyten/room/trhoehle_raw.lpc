#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Tiefe Hoehle" );
  SetProp( P_INT_LONG,
     BS("Diese dunkle Hoehle gehoert wohl zum Reich der Troglodyten. "+
     "Sie scheint natuerlichen Ursprungs zu sein. Grobe Felsen bilden "+
     "Decke und Waende. Selten sind Tropfsteine zu sehen. Helle Moose und "+
     "kleine Pilze wachsen hin und wieder an den Waenden und auf dem Boden. "+
     "Die feuchtkuehle Luft die hier herrscht ist gut zu atmen und erfrischt." ));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND, BS(
    "Es ist sehr still hier.") );
  AddSound( ({ "stille" }), BS(
    "Du hoerst nix - Stille eben.") );
  AddSmell( DEFAULT_SMELL, BS(
    "Du kannst nichts besonderes riechen.") );

  AddDetail( ({"boden", "weg"}), BS(
    "Der Boden besteht aus normalem Fels. Selten sieht man Moose und Pilze auf "+
    "dem Boden wachsen. Der Boden ist feucht und an manchen Stellen sind kleine "+
    "Pfuetzen zu erkennen.") );
  AddDetail( ({"decke"}), BS(
    "Die Decke besteht aus einfachem Fels. Hin und wieder haengen Tropfsteine herunter, "+
    "aber zum Glueck ist dieser Gang hoch genug um trotz der Tropfsteine aufrecht zu gehen. ") );
  AddDetail( ({"waende", "wand"}), BS(
    "Normaler Fels bildet die Seiten des Gangs. Ein paar Adern im Fels lassen vielleicht "+
    "Rueckschluesse ziehen was sich so alles im Gestein verbirgt.") );
  AddDetail( ({"hoehle", "gang"}), BS(
    "Diese dunkle Hoehle gehoert wohl zum Reich der Troglodyten. "+
    "Sie scheint natuerlichen Ursprungs zu sein. Grobe Felsen bilden "+
    "Decke und Waende. Selten sind Tropfsteine zu sehen. Helle Moose und "+
    "kleine Pilze wachsen hin und wieder an den Waenden und auf dem Boden. "+
    "Die feuchtkuehle Luft die hier herrscht ist gut zu atmen und erfrischt.") );
  AddDetail( ({"reich"}), BS(
    "Dieses unterirdische Reich wird wohl von den Troglodyten beherrscht. "+
    "Vielleicht gibt es hier mehr als Fels, Wasser und Pilze.") );
  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"ursprung"}), BS(
    "Die Hoehle scheint natuerlichen Ursprungs.") );
  AddDetail( ({"felsen", "fels", "gestein"}), BS(
    "Grobe Felsen mit ein paar unscheinbaren Adern. ") );
  AddDetail( ({"tropfsteine", "tropfstein"}), BS(
    "Diese gewachsenen Felsen stehen hier hin und wieder bei sehr feuchten Stellen. "+
    "Manche stehen im Weg, andere sehr dicht an der Wand. Du kannst nichts besonderes "+
    "daran erkennen.") );
  AddDetail( ({"moose", "moos", "pflanzen"}), BS(
    "An den Waenden und auf dem Boden gibt es hin und wieder kleine Stellen mit "+
    "hellen Moosen. Diese Pflanzen scheinen auch ohne Licht aus zu kommen. ") );
  AddDetail( ({"pilz", "pilze"}), BS(
    "An vielen Stellen an Waenden und Boden der Hoehle wachsen kleine Pilze. "+
    "Diese scheinen die Grundlage allen Lebens hier unten zu sein. Manche Pilze "+
    "leuchten sogar im Dunkeln." ) );
  AddDetail( ({"luft"}), BS(
    "Die Luft ist feucht und kalt und erfrischt dicht.") );
  AddDetail( ({"rueckschluesse"}), BS(
    "Ziehe doch deine eigenen.") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({"stellen"}), BS(
    "Es gibt hier kleine Stellen mit hellem Moos, aber die sind uninteressant.") );
  AddDetail( ({"grundlage", "leben"}), BS(
    "Pilze und Moose sind hier die Grundlage allen Lebens. Warscheinlich gibt es "+
    "hier auch Tiere die wie die Troglodyten sich an das Dunkel angepasst haben.") );
  AddDetail( ({"dunkel"}), BS(
    "Im Dunkeln kann man normalerweise nichts sehen - aber das scheint die blinden "+
    "Troglodyten, die hier ihr Reich haben, nicht zu stoeren. ") );
  AddDetail( ({"bibliothek", "buecher"}), BS(
    "Da Troglodyten blind sind haben sie keine Verwendung fuer Buecher. Hier wirst Du keine "+
    "Bibliothek finden.") );
  AddDetail( ({"glueck"}), BS(
    "Glueck kann man leider nicht so einfach untersuchen.") );
  AddDetail( ({"licht"}), BS(
    "Hier tief in den Hoehlen musst Du dein eigenes Licht mitbringen.") );
  AddDetail( ({"pfuetzen", "pfuetze", "wasser", "mulden"}), BS(
    "Ein bischen Wasser steht in den Mulden des Bodens.") );
  AddDetail( ({"tiere", "kaefer", "wesen"}), BS(
    "Hier in den Hoehlen soll es vorallem Kaefer geben.") );

/*
  AddDetail( ({""}), BS(
    "") );
*/

  AddSpecialDetail( ({"adern", "ader"}), "Unt_Adern" );

}

string Unt_Adern(string str)
{
  if( TP->QueryProp(P_RACE) != "Zwerg" )
  {
    return "Feine kleine Adern mit etwas hellerem Felsgestein.";
  }
  else
  {
    return "Feine kleine Adern mit Quarz versetzem Felsgestein.";
  }
}