#include "../def.h"

inherit ROOM + "trdorf_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Eine Hoehle im Norden fuehrt aus dem Dorf hinaus.") );

  AddItem( NPC + "jutox.lpc", REFRESH_DESTRUCT );

  AddExit( "westen" , ROOM + "troglodyten_f4.lpc");
  AddExit( "norden" , ROOM + "troglodyten_g3.lpc");
  AddExit( "osten" , ROOM + "troglodyten_h4.lpc");
  AddExit( "suedosten" , ROOM + "troglodyten_h5.lpc");
  AddExit( "sueden" , ROOM + "troglodyten_g5.lpc");
  AddExit( "suedwesten" , ROOM + "troglodyten_f5.lpc");
}