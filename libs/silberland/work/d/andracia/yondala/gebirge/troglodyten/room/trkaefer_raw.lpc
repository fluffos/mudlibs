#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Kaeferzucht" );
  SetProp( P_INT_LONG, BS(
    "Dieser Bereich der Hoehle wurde zu einer Kaeferzucht ausgebaut. In mehreren Gruben sind "+
    "einige Riesenkaefer eingepfercht und dienen wohl den Troglodyten als Nahrungsquelle. "+
    "Im Dorf der Troglodyten gibt es bestimmt eine Moeglichkeit von den Bewohnern "+
    "zubereitetes Kaeferfleisch zu bekommen. "));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND, BS(
    "Die Riesenkaefer machen knackende, fuer Insekten typische Geraeusche.") );
  AddSound( ({"geraeusch", "geraeusche", "knacken" }), BS(
    "Die Geraeusche stammen von den Kaefern.") );
  AddSmell( DEFAULT_SMELL, BS(
    "Es riecht hier unangenehm nach dem typisch suesslichen Geruch von Insekten.") );
  AddSmell( ({"geruch", "gerueche"}), BS(
    "Der Geruch stammt eindeutig von den Kaefern.") );

  AddDetail( ({"boden"}), BS(
    "In den felsigen Boden sind mehrere Gruben geschlagen in denen Riesenkaefer "+
    "eingepfercht sind. ") );
  AddDetail( ({"waende", "felswaende", "wand"}), BS(
    "Normale Felswaende begrenzen diese Hoehle.") );
  AddDetail( ({"decke"}), BS(
    "Hoch ueber Dir kann man die Decke noch erahnen.") );
  AddDetail( ({"hoehle", "kaeferzucht", "zucht", "bereich"}), BS(
    "Diese Hoehle wurde zu einer Kaeferzucht ausgebaut. In mehreren Gruben sind "+
    "einige Riesenkaefer eingepfercht und dienen wohl den Troglodyten als Nahrungsquelle. "+
    "Im Dorf der Troglodyten gibt es bestimmt eine Moeglichkeit von den Bewohnern "+
    "zubereitetes Kaeferfleisch zu bekommen. ") );
  AddDetail( ({"troglodyten"}), BS(
    "Troglodyten sind aufrechtgehende, blinde, molchartige Wesen mit einem "+
    "ungewoehnlich guten Gehoer und Geruchssinn. ") );
  AddDetail( ({"gehoer", "lauschen"}), BS(
    "Wenn Lauschen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"geruchssinn", "riechen"}), BS(
    "Wenn Riechen funktioniert ist doch alles in Ordnung.") );
  AddDetail( ({"ordnung"}), BS(
    "Sowas findet man vielleicht in einer Bibliothek aber nicht hier in dieser Hoehle.") );
  AddDetail( ({"gruben"}), BS(
    "In den Gruben sind Riesenkaefer eingepfercht. Sie dienen den Troglodyten wohl "+
    "als Schlachtvieh. Die Chitinpanzer der Tiere werden bestimmt auch verwendet." ) );
  AddDetail( ({"kaefer", "riesenkaefer", "schlachtvieh", "vieh", "insekten", "tiere", "wesen"}), BS(
    "Große schwarze Kaefer mit sechs kraeftigen Beinen. Die Chitinpanzer glaenzen "+
    "im Licht. Die Troglodyten halten diese Tiere hier als Schlachtvieh.") );
  AddDetail( ({"nahrungsquelle", "nahrung", "fleisch", "kaeferfleisch"}), BS(
    "Fuer die Troglodyten sind diese Riesenkaefer die wichtigste Nahrungsquelle. "
    "Im Dorf kann man bestimmt schon zubereitetes Kaeferfleisch kaufen. ") );
  AddDetail( ({"dorf", "bewohner"}), BS(
    "Hier irgendwo in diesen Hoehlen muss das Dorf, das die Troglodyten bewohnen, "+
    "zu finden sein. ") );
  AddDetail( ({"bibliothek", "buecher"}), BS(
    "Da Troglodyten blind sind haben sie keine Verwendung fuer Buecher. Hier wirst Du keine "+
    "Bibliothek finden.") );
  AddDetail( ({"chitinpanzer"}), BS(
    "Die Kaefer mit ihrem Panzer glaenzen im Licht. Diese Panzerplatten sind wohl als "+
    "Material fuer Ruestungen geeignet.") );
  AddDetail( ({"licht"}), BS(
    "Hier tief in den Hoehlen musst Du dein eigenes Licht mitbringen.") );
  AddDetail( ({"beine"}), BS(
    "Die Kaefer haben sechs lange schwarze Beine. Mehr kannst Du aber nicht erkennen. ") );
  AddDetail( ({"moeglichkeit"}), BS(
    "Frag doch einfach einen Troglodyten.") );
  AddDetail( ({"panzerplatten", "panzer", "platten", "material", "verwendung"}), BS(
    "Die schwarzen Panzerplatten dieser Kaefer koennten gut als Material fuer Ruestungen dienen.") );
  AddDetail( ({"ruestung", "ruestungen"}), BS(
    "Als Abenteurer ist eine gute Ruestung wichtig.") );
  AddDetail( ({"abenteurer"}), BS(
    "Du bist doch einer, oder?") );

/*
  AddDetail( ({""}), BS(
    "") );
*/
}