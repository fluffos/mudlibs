#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar gruenblaue Chitinplattenbeinschienen");
  SetProp(P_LONG,
    BS("Diese Beinschienen wurden aus Panzerplatten des Scheinstutzkaefers "+
    "gefertigt. Sie sind gruenblau, schimmern leicht metallisch und haben auffaellige "+
    "Punktreihen. Ein faehiger Schneider hat diese Beinschienen mit Pilzfasereinlagen "+
    "versehen damit man sie besonders bequem tragen kann. ") );
  SetProp(P_INFO, BS("Diese Ruestung ist besonders geraeuscharm. Kein rascheln "+
    "oder klimpern wenn man damit herumlaeuft.") );
  SetProp(P_NAME, "Chitinplattenbeinschienen");
  SetProp(P_NAME_ADJ, "gruenblau");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"beinschienen", "plattenbeinschienen", "chitinbeinschienen",
           "chitinplattenbeinschienen"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 2085);
  SetProp(P_VALUE, 3414);
  SetProp(P_QUALITY_DECAY, 125);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
    ([DT_WATER:1, DT_ELECTRIC:1, DT_ACID:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

