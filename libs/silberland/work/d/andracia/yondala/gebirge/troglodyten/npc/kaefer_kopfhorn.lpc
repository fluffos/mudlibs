#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit NPC + "kaefer_raw.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(9);

  AddId(({"kopfhornkaefer"}));
  SetProp( P_SHORT, "Kopfhornkaefer");
  SetProp( P_LONG, 
    BS("Der Kopfhornkaefer ist ein grosser schwarzer Kaefer mit einem grossen Horn "+
    "auf dem Kopf. ") );
  SetProp( P_NAME, "Kopfhornkaefer");
  SetProp( P_KILL_NAME, "Kopfhornkaefer");
 
  AddDetail( ({"horn"}), 
    BS("Auf dem Kopf ist mittig ein grosses Horn. Damit kann der Kaefer gegen "+
    "seine Feinde zustossen.") );

  SetProp( P_HANDS, ({" mit seinen Mandibeln",QueryProp(P_HANDS)[1],DT_SLASH}));

  SetProp( P_SIZE, 65); //in cm
  SetProp( P_WEIGHT, 26000); //in g

  SetProp( P_SPELLRATE, 8);
  AddSpell( 6, 10+random(6),
    "Der Kopfhornkaefer stoesst mit dem Horn zu.", 
    "@WER wird vom Horn des Kopfhornkaefers getroffen.",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell( 4, 18+random(8),
    "Ploetzlich stellt sich der Kopfhornkaefer auf und bespritzt dich mit Saeure.",
    "Der kopfhornkaefer stellt sich auf und bespritzt @WEN mit Saeure.",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );

  SUID; 
  CLONEME( OBJ+"chitinplatte_schwarz.lpc" );
  CLONEME( OBJ+"chitinplatte_schwarz.lpc" );

}