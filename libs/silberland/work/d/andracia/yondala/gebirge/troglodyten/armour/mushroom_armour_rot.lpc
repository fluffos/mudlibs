#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein rotes Pilzfaserhemd");
  SetProp(P_LONG,
    BS("Dieses Hemd ist aus roten Pilzfasern gewoben. Nicht besonders weich und auch "
    "nicht besonders bequem, aber das einzige was die Hoehlenbewohner kennen. ") );
  SetProp(P_INFO, BS("Wenigstens riecht es nicht nach Pilz.") );
  SetProp(P_NAME, "Pilzfaserhemd");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "pilzhemd", "pilzfaserhemd"}) );

  SetProp( P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 22);
  SetProp(P_MATERIAL, MAT_MUSHROOM );
  SetProp(P_WEIGHT, 1080);
  SetProp(P_VALUE, 3024);
  SetProp(P_QUALITY_DECAY, 98);

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );        
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3]) );

  SetProp(P_AUTOLOADOBJ, 1);
}

