// Normalo Fritz sitzt in Raum 5d
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
inherit GIER_NPC + "gierling_standard.lpc";

	
	
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fritz der Gierling");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist Fritz. Er ist ein Gierling. Er traegt einen braunen Schlapphut, darunter "
    "schauen zottelige graue Haare hervor. An seinen Fuessen stecken braune Lederschuhe. "
    "Mit der rechten Hand stuetzt er sich auf einen Knueppel. An seine Guertel haengt ein Goldsaeckchen. "
    "Er ist recht klein fuer einen Gierling. "
    "Seine Haut ist ungewoehnlich hell und voller Sommersprossen. ");//Langbeschreibung vom GIER_NPC wenn man ihn untersucht
  SetProp(P_NAME, "Fritz");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
SetProp (P_MNPC_DEFAULTROOM, GIER_ROOM + "gierlinge_5d");
SetProp (P_MNPC_AREA, GIER_ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 5, 5}));


SetProp(P_MSGIN, "betritt den Raum");
SetProp(P_MSGOUT, "schreitet");

  AddDetail( ({ "hut", "schlapphut", "schuhe", "lederschuhe", "Kleidung" }),
    "Die Kleidung von Fritz ist verschlissen.");  
  AddDetail( ({ "haare", "haar" }),
    "Die Haare von Fritz sind grau.");  
  AddDetail( ({ "knueppel", "" }),
    "Den Knueppel braucht Fritz zum Gehen. Zur Not kann er sich damit aber auch verteidigen.");  
  AddDetail( ({ "", "" }),
    "");  
      AddDetail( ({ "", "" }),
    "");  
  AddInfo( ({ "oitl", "neffe", "grossneffe" }),
    "Oitl ist mein Grossneffe. Der arme Kleine hat keine Eltern mehr.",
    "sagt: "); 
  AddInfo( ({ "fritz" }),
    "Das bin ich.",
    "sagt: "); 
  AddId(({"fritz", "winzling", "den kleinen", "gierling"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_schlapphut.lpc");  
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc");  
  CLONEME(GIER_ARMOUR + "gierling_beinlinge.lpc");    
    
  command("trage alles");
  CLONEME(GIER_WEAPON+ "knueppel.lpc");    
	command("zuecke knueppel");
  create_default_npc(10);// Die Zahl entspricht der Spielerstufe des GIER_NPC
  SetProp(P_HANDS, ({" mit seinem Knueppel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));


  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 13000);
  SetProp(P_ALIGN, -30);

  SetProp(P_MSGIN, "humpelt herbei"); 
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "rutscht von einem Regenbogen");
  SetProp(P_MMSGOUT, "stampft dreimal auf den Boden und ist weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Fritz der Gierling");
  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");



  SetProp( P_REJECT, ({ REJECT_DROP,
   "<name> will Deine Sachen nicht tragen.\n" }) );



}


// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "Fritz zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "Fritz zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut sich um, nimmt ein Stueck Gold aus der Tasche und poliert es.",
        "schaut sich um, nimmt ein Stueck Gold aus der Tasche und poliert es.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
