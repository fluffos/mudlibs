#include <moredef.h>
#include "../def.h"
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Der Gang, in dem Du "
	"Dich befindest, macht hier einen Knick und Du kannst nach Westen oder "
	"nach Norden gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(GIER_NPC + "gierling_normalo.lpc",REFRESH_DESTRUCT);
  
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "knick" }),
    "Du kannst von hier aus nach Westen und nach Norden laufen.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "Westen" }),
    "Nach Westen fuehrt Dich der Gang Richtung Ausgang.");
  AddDetail( ({ "richtung" }),
    "Grob Richtung Westen erstmal, wenn Du raus willst, folge dem Gang.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "norden" }),
    "Noerdlich von hier liegt eine Kreuzung.");
  AddDetail( ({ "kreuzung" }),
    "Im Norden kreuzt ein anderer Gang den Gang, in dem Du Dich befindest.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");

  AddDetail( ({ "bild" }),
    "Das Bild stellt mehrere Gierlinge da, die auf einem Haufen funkelnder "
	"Edelsteinchen stehen und ihn gegen einen Schwarm Elstern verteidigen.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge auf dem Bild sehen wuetend und wild entschlossen aus. "
	"Sie bedrohen die Elstern, die kaum kleiner sind als sie selbst, mit "
	"Stoecken, einige scheinen sogar kleine Blitze auf die Elstern zu "
	"schiessen.");
  AddDetail( ({ "elstern" }),
    "Die Elstern sind schwarz und jeweils aus einem einzigen Onyx "
	"hergestellt. Mit gierigen kleinen Aeuglein starren sie den Haufen "
	"Edelsteinchen an, auf dem die Gierlinge sitzen. Eine hat sogar schon "
	"ein rotes Edelsteinchen erwischt und fliegt davon.");
  AddDetail( ({ "elster" }),
    "Die diebische Elster hat einen kleinen, roten Edelstein gestohlen. "
	"Ob es ein Jaspis oder Oktarin ist kannst Du nicht erkennen, sicher "
	"aber ist es kein Cuprit.");
  AddDetail( ({ "aeuglein" }),
    "Die schwarzen Aeuglein der Elstern druecken nur eines aus: Gier!");
  AddDetail( ({ "gier" }),
    "Alle auf diesem Bild sind gierig nach Edelsteinen.");
  AddDetail( ({ "stoecke" }),
    "Wie normale Holzstoecke sehen die Stoecke nicht aus, sie scheinen "
	"magisch zu sein, denn sie leuchten leicht, was aber auch daran "
	"liegen kann, dass sie auf dem Bild aus Opalen gefertigt wurden.");
  AddDetail( ({ "holzstoecke" }),
    "Holzstoecke findet man ja ueberall, aber die auf dem Bild sind anders, "
	"einfach magisch und nebenbei auch schoen anzusehen.");
  AddDetail( ({ "haufen" }),
    "Viele kleine Edelsteinchen sind zu einem so grossen Haufen geworden, "
	"dass mehrere ausgewachsenen Gierlinge darauf stehen koennen.");
  AddDetail( ({ "edelsteinchen" }),
    "Tatsaechlich bestehen die vielen kleinen bunten Edelsteinchen auf dem "
	"Bild aus Bruchstuecken echter Edelsteine.");
  AddDetail( ({ "bruchstuecke" }),
    "Natuerlich nur Bruchstuecke, alles auf dem Bild ist ja etwas kleiner "
	"als die Realitaet.");
  AddDetail( ({ "realitaet" }),
    "Alles um Dich herum ist die Realitaet: Der Gang, die Hoehle in der Du "
	"Dich befindest. Glaube niemals jemandem, der etwas anderes behauptet!");
  AddDetail( ({ "schwarm" }),
    "Viele Elstern zusammen ergeben einen Schwarm.");
  AddDetail( ({ "blitze" }),
    "Einige der Gierlinge schleudern wuetend Blitze auf die Elstern.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es ist alles relativ ruhig hier.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas feucht.");

  AddSmell( ({ "feuchtigkeit" }),
    "So ist das nun mal in einer Hoehle.");
  AddSmell( ({ "hoehle","hoehlen" }),
    "Hoehlen riechen manchmal feucht.");



//  AddCmd( ({ "tue" }), "command" );

  AddExit( "norden",GIER_ROOM + "gierlinge_5d" );
  AddExit( "westen",GIER_ROOM + "gierlinge_6c" );  

  

}

