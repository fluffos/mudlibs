#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein rotes Lackkleid");
  SetProp(P_LONG,
    "Ein kleines rotes Kleid, welches wohl nur Koboldfrauen passen kann. "
    "Ausserdem will eh keine Frau, die etwas auf sich haelt, so etwas tragen." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid", "lackkleid"}) );
                                 

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_COTTON ]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp (P_WEAR_RESTRICTIONS,([P_GENDER:2, P_RACE:"Kobold"]) );


}
