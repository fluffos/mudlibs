// fertig

// Bild an der Wand: Gierling mit Schuerze und Kessel
// Ueberarbeitet am 29.8.2011
// Yondala@Silberland
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus."
    "Im Norden kannst Du eine T-Kreuzung erkennen, im Suedwesten macht der "
	"Gang einen Knick, leider kannst Du nicht sehen, was dahinter ist." );
  AddItem(GIER_NPC + "gierling_norbert.lpc",REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "norden" }),
    "");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine T-Kreuzung, denn der Gang teilt sich dort in drei Richtungen, wie bei einem \"T\".");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nur in zwei Richtungen gehen: Norden und "
    "Suedwesten.");
  AddDetail( ({ "norden", "weg" }),
    ".");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");  
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen ergeben das Bild eines Gierlings in voller "
	"Lebensgroesse.");
  AddDetail( ({ "lebensgroesse" }),
    "Der abgebildete Gierling ist genauso gross, wie die Gierlinge, die "
	"in dieser Hoehle lebendig herum laufen.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge leben in dieser Hoehle. Du bist sicher schon dem ein "
	"oder anderen begegnet.");
  AddDetail( ({ "gierling","gierling in bild" }),
    "Der dargestellte Gierling ist nur mit einer riesigen Schuerze "
	"bekleidet. Er ruehrt mit beiden Armen einen staehlernen Kochloeffel "
	"durch einen schwarzen Kessel.");
  AddDetail( ({ "schuerze" }),
    "Die Schuerze des Gierlings ist dunkelgruen, sie wurde vermutlich aus "
	"Turmalinen gefertigt, die uebergangslos in einander gefuegt wurden. "
	"Die Schuerze ist so gross, dass nur der Kopf, die Arme und die Fuesse "
	"des Gierlings zu sehen sind.");
  AddDetail( ({ "kopf" }),
    "Der Kopf des Gierlings ist mit einer Maske bedeckt.");
  AddDetail( ({ "maske" }),
    "Die Maske des Gierlings deckt dessen ganzes Gesicht ab, nur durch "
    "zwei kleine Schlitze kann man seine Augen blitzen sehen und am Hals "
	"sind ein paar rote Haarspitzen zu erkennen.");
  AddDetail( ({ "gesicht" }),
    "Vom Gesicht des Gierlings sind nur seine Augen zu sehen, der Rest wird "
	"durch die Maske verborgen.");
  AddDetail( ({ "schlitze" }),
    "In die Maske sind zwei kleine, schmale Schlitze gestanzt worden. Durch "
	"sie kann der Gierling sehen, was er tut, allerdings duerfte seine Sicht "
	"ziemlich beschraenkt sein.");
  AddDetail( ({ "sicht" }),
    "Aus Deiner Sicht siehst Du sicherlich mehr, als der Gierling.");
  AddDetail( ({ "augen" }),
    "Zwei hellgruene Augen, die wie Jadeite strahlen, schauen konzentriert "
	"in den Kessel.");
  AddDetail( ({ "hals" }),
    "Ein kleines Feld des rosenquarzfarbenen Halses liegt zwischen Maske "
	"und Schuerze frei.");
  AddDetail( ({ "feld", "teil" }),
    "Nicht der ganze Hals, nur ein kleiner Ausschnitt.");
  AddDetail( ({ "ausschnitt" }),
    "Ein Ausschnitt ist ein Teil des Ganzen.");
  AddDetail( ({ "ganzen","grossen" }),
    "Im Grossen und Ganzen bist Du ein fleissiger Forscher.");
  AddSpecialDetail("forscher", "forscherdetail");
  AddDetail( ({ "rest" }),
    "Du vermutest, dass unter der Maske ein ganz normales Gesicht steckt.");
  AddDetail( ({ "farben" }),
    "Du erwartest aber nicht, dass jetzt Jemand kommt und Dir alle "
	"aufzaehlt, oder?");
  AddSpecialDetail("jemand", "jemanddetail");
  AddDetail( ({ "arme" }),
    "Die Arme, die aus unzaehligen Rosenquarzen dargestellt werden, halten "
	"einen grossen Kochloeffel.");
  AddDetail( ({ "kochloeffel" }),
    "Der Kochloeffel ist aus Silber gefertigt. Er steckt fast gaenzlich in "
	"der Fluessigkeit des Kessels.");
  AddDetail( ({ "haare","haarspitzen" }),
    "Die wenigen Haarspitzen, die unter der Maske hervorschauen, sind rot "
	"wie Granate.");
  AddDetail( ({ "kessel" }),
    "Der Kessel ist kohlrabenschwarz, er wurde aus Onyxen hergestellt. "
	"Unter dem Kessel prasselt ein munteres Feuer. Im Kessel selbst blubbert "
	"eine goldige Fluessigkeit vor sich hin.");
  AddDetail( ({ "fluessigkeit" }),
    "Die Fluessigkeit in dem Kessel scheint pures Gold zu sein. Du hast "
	"schon Geruechte gehoert, dass Gierlinge Gold herstellen koennen.\n"
	"Ob das Bild wohl der Realitaet entspricht?");
  AddDetail( ({ "geruechte" }),
    "Ob Du was auf die Geruechte gibst, musst Du selbst entscheiden.");
  AddDetail( ({ "realitaet" }),
    "Finde es heraus.");
  AddDetail( ({ "feuer" }),
    "Ein munteres Feuer, dargestellt aus leuchtenden Oktarinen und Pyriten, "
	"prasselt unter dem Kessel.");
  AddDetail( ({ "fuesse" }),
    "Die nackten Fuesse des Gierlings schauen unter der Schuerze hervor. "
	"Jeder Zeh besteht aus einem einzelnen Rosenquarz.");
  AddDetail( ({ "zeh" }),
    "Du ueberlegst besser nicht, wie wertvoll jeder einzelne Zeh dieses "
	"Gierlings ist.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "kurve" }),
    "im Nordosten geht der Gang nicht gerade weiter, sondern kruemmt sich.");
  AddDetail( ({ "weg" }),
    "Der Gang ist der Weg in dieser Hoehle.");

  AddDetail( ({ "suedwesten", "weg" }),
    "Nach Suedwesten fuehrt der Weg tiefer in die Hoehle hinein.");
  AddDetail( ({ "norden" }),
    "Im Norden liegt eine T-Kreuzung.");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");
  AddDetail( ({ "knick" }),
    "Naturgemaess kannst Du nicht sehen, was dahinter liegt, Du muesstest "
	"schon hingehen.");
  AddDetail( ({ "" }),
    "");


	


  AddExit( "norden", GIER_ROOM + "gierlinge_1e.lpc" );
  AddExit( "suedwesten", GIER_ROOM + "gierlinge_3d.lpc" );  

  

}
string forscherdetail()
{
  return TPN+".\n";
  }

string jemanddetail()
{
  if (present ("jemand",TO)) return ("Hier ist doch schon Jemand, frag ihn.\n");
  
  CLONE(GIER_NPC + "gierling_jemand.lpc", TO);
  return ("Jemand raeuspert sich.\n");
  
  }
  
  