//wird geclont, um sicher zu stellen, dass sich nur der richtige Spieler
//ducken kann

//Yondala@Silberland, 19.12.2011

#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>


void weg()
{
  tell_object(environment(TO), "Du nimmst die Haende von Deinen Ohren.\n");
  environment(TO)->SetProp(P_DEAF,0);
  remove();
 }

 void taub()
{environment(TO)->SetProp(P_DEAF,10);}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Springseil");
  SetProp(P_LONG,"Du siehst ein einfaches, aus Hanf gedrehtes Springseil." );

  SetProp(P_NAME, "Springseil");
  SetProp(P_GENDER, NEUTER);
  AddId(({"seil","springseil"}));

  SetProp(P_MATERIAL, MAT_CANNABIS );
  SetProp(P_WEIGHT, 20);

AddCmd(({"springe","spring"}),"seilspringen"); 
    
}

void springen()
{
  if(environment(TO)!=TP) 
  {
   	TP->SetProp(P_NOMOVE,0);
	return;
	}
  if(random(50)>TP->QueryAttribute(A_DEX))
  {
    write("Geschickt springst Du ueber das Seil.\n");
	say(TPN+" springt Seilchen.\n");
	call_out("springen",2);
	return;
	}
    write("Hoppla, ungeschickt stolperst Du und laesst das Seil fallen.\n");
	say(TPN+" stolpert ueber "+TP->QueryPossPronoun(NEUTER, WEN)+" Seil.\n");
	TP->SetProp(P_NOMOVE,0);
	move(environment(TP));
}


int seilspringen(string str)
{
  string grund;
  if(str=="seil"||str=="seilchen")
  {
    if(TP->QueryProp(P_USED_HANDS))
	{
	  write("Du hast nicht genuegend Haende frei.\n");
	  }
	else if(environment(TO)!=TP)
    {
	  write("Du solltest das Seil vorher nehmen.\n");
	   }
	
	else if(TP->QueryProp(P_NOMOVE))
	{
	  write(TP->QueryProp(P_NOMOVE));
	  }
	else
    { 
      write("Du greifst beide Enden des Seils und beginnst zu springen.\n");
	  say(TPN+" beginnt Seilchen zu springen.\n");
	  TP->SetProp(P_NOMOVE, "Du springst gerade Seilchen.\n");
	  call_out("springen",2);
	  }
	return 1;
	}
}





	
	
	
	
	
	
	
	
    