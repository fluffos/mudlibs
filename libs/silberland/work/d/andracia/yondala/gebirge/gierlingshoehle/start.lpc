inherit "/gilden/abenteurer";			//Gilde
inherit "std/room";								//Standardraum
inherit "std/laden";							//Laden
inherit "std/pub";								//Kneipe
inherit "std/store";							//Lager fuer Laden
//-------------------------------3.-----------------------------------------------------
#include <properties.h>						//von hier ...
#include <language.h>
#include <moving.h>
#include <verben.h>				
#include <rooms.h>								// bis hier alle Props in Standartraeumen
#include <wizlevels.h>
#include <defines.h>
#include <new_skills.h>				
#include <config.h>								//bis hier zB in Gilden
#include "../def.h"								//eigene include
#include "../wetter.lpc"
#include "../adddetail.lpc"
//-------------------------------4.-----------------------------------------------------
create(){
	::create();											//immer
    wetter();											//nur wenn zB #include "../wetter";
		detail();				
		pflasterweg();
//-------------------------------5.-----------------------------------------------------
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
SetProp(P_LIGHT, 1);				
SetProp(P_INDOORS, 1);						//0 aussen 1 innen und haus
//-------------------------------6.-----------------------------------------------------
SetProp(P_INT_SHORT, "");					//Kurzbeschreibung

SetProp(P_INT_LONG,
" "
);																//Langbeschreibung
//-------------------------------7.-----------------------------------------------------
AddDetail(({""}),				
" "
);																//normales Detail
AddReadDetail("",
" \n"	
);																//lesbare Details
AddSpecialDetail( ({"breite"}), "breit");	//breit ruft die Funktion "breit" auf
//-------------------------------8.-----------------------------------------------------
AddSound(DEFAULT_SOUND,				
" "
);																//lausche
AddSound(({"", ""}),				
" "
);																//lausche blabla
AddSmell(DEFAULT_SMELL,					
" "
);																//rieche
AddSmell(({"", ""}),				
" "
);																//rieche blabla
//-------------------------------9.-----------------------------------------------------
AddCmd(({"oeffne"}), "oeffne");			//das 2te oeffne ist der Funktionsname
//-------------------------------10.----------------------------------------------------
AddItem ( "/d/eisland/donar/vangar/npc/heidi.lpc", REFRESH_REMOVE);
																		//der absolute pfad, dann das item, dann Bedingung
//-------------------------------11.----------------------------------------------------
AddExit("westen", "./h04");					//ausgang westen zur datei h04
AddSpecialExit("turm", "tuer");			//ausgang mit funktionsaufruf "tuer"
																		//weiter unten ein Beispiel fuer 
																		//Funktionen und in diesem Fall
																		//das oeffnen einer Tuer und betreten
																		//eines anderen Raumes
AddGuardedExit("norden", "/room/weg2", "ork",
               "Der Ork laesst Dich nicht vorbei!\n");
																		//ein durch einen Ork beschuetzter Ausgang
//-------------------------------12.----------------------------------------------------
}																		//hier wird alles bisherige geschlossen
//-------------------------------13.----------------------------------------------------
tuer(){
	write(BS("Du solltest erst die Tuer oeffnen.\n"));
	return 1;
}

oeffne(str){
	notify_fail("Was moechtest Du oeffnen?\n ");
	if(str == "tuer" || str == "die tuer"){
	write(BS("Du oeffnest die Tuer und betrittst den Turm.\n"));
	
	return this_player()->move("/d/eisland/donar/vangar/room/turm_j04",M_GO, 0,
              "betritt den Turm",
              "kommt herein");
}
//-------------------------------14.----------------------------------------------------
breit(){
	write(BS("Du beginnst den Turm in seiner vollen Breite abzuschreiten."));
	say(BS(CTPN + " beginnt den Turm abzuschreiten."),TP);
	
	call_out("breit2", 3);
	
	TP->SetProp(P_PARALYZED,([  PARALYZE_TIME: -1,
	PARALYZE_MSG: "Du bist zu beschaeftig mit zaehlen.\n",
	PARALYZE_MSG_OTHER: "%s rauft sich verzweifelt die Haare.\n",
	PARALYZE_END: "Nachdem Du Dich mehrmals verzaehlt hast gibst Du entnervt auf.\n",
	PARALYZE_END_OTHER: "%s rollt mit den Augen und gibt sein Vorhaben auf.\n" ])
	);
	return "";
}
breit2(){
	write(BS("Du schreitest und schreitest..."));
	say(BS(CTPN + " schreitet und schreitet..."),TP);
	call_out("breit3", 5);
	return 1;
}
breit3(){
	TP->SetProp(P_PARALYZED, 0);
	return 1;
}
