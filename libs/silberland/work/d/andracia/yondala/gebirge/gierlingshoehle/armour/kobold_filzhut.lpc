#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Filzhut");
  SetProp(P_LONG,
    "Du siehst einen kleinen, gruenen Filzhut vor Dir, der sicherlich nur einem kleinen Wesen passen kann." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Filzhut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut", "filzhut", ""}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_FELT );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 50);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:80]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
