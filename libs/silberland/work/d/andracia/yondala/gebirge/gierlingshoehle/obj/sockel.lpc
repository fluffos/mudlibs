inherit "std/thing";

#include "properties.h"
#include "../def.h"
object erhabener;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Sockel");
  SetProp( P_LONG, BS("Ein einfacher hoelzerner Sockel. Man kann draufklettern, "+
    "und sich so ueber seine Umgebung erhaben fuehlen."));
  //SetProp( P_INFO, "Ein einfacher Sockel. /n");
  SetProp( P_NAME, "Sockel");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_WOOD ); 
  SetProp( P_SIZE, 30);
  SetProp( P_WEIGHT, 978); 
  SetProp( P_ARTICLE, 1); 
  SetProp( P_VALUE, 254); 
  SetProp( P_NOBUY, 1);
  SetProp( P_NODROP, 0);
  AddId( "sockel");

  AddCmd( ({"kletter", "klettere"}), "CmdErhaben");
  AddCmd( ({"stosse", "stoss"}), "stossen");
}


int CmdErhaben(string str) 
{
  notify_fail("Wohin willst Du klettern?\n");
  if( str == "auf sockel" )
	{
	  if( erhabener==TP )
	  { 
	    write ("Du stehst doch schon auf dem Sockel.\n");
		return 1;
		}
	if (erhabener)
	{
	  write("Auf dem Sockel ist kein Platz mehr, "+erhabener->name()+
	  " steht bereits darauf.\nDu kannst "+erhabener->QueryPronoun(WEN)+
	  " vom Sockel stossen, um selbst herauf klettern zu koennen.\n");
	  return 1;
	  }
    if(interactive(environment(TO)))
	{
	  write("Du solltest den Sockel vorher abstellen.\n");
	  return 1;
	  }
	SetProp(P_NOGET, "Solange jemand auf dem Sockel steht, kannst Du ihn nicht nehmen.\n");
    TP->SetProp( P_NOMOVE, "Du musst erst vom Sockel klettern!\n");
    erhabener=TP;
    TP->SetProp(P_SIZE, TP->QueryProp(P_SIZE)+QueryProp(P_SIZE) );
    if(TP->QueryProp(P_SIZE)>210 && environment(TP)->QueryProp(P_INDOORS) ) 
	{
      write("Du kletterst auf den Sockel und stoesst Dir den Kopf an der Decke.\n");
      say(capitalize(this_player()->name())+
        " klettert auf den Sockel und stoesst sich den Kopf an der Decke.\n");
      TP->AddHp(-2);
    } 
	else {
      write("Du kletterst auf den Sockel.\n");
      say(capitalize(this_player()->name())+ " klettert auf den Sockel.\n");
    }
    return 1;
	}
  
  
  
  if (str =="von sockel"||str=="von sockel herunter"||str=="von sockel runter")
  {
    if(TP!=erhabener)
	{
	  write("Du stehst doch gar nicht auf dem Sockel.\n");
	  return 1;
	  }
    SetProp(P_NOGET, 0);
    TP->SetProp(P_NOMOVE, 0);
    erhabener=0;
    TP->SetProp(P_SIZE, TP->QueryProp(P_SIZE)+QueryProp(P_SIZE) );
	write("Du kletterst vom Sockel.\n");
    say(capitalize(this_player()->name())+ " klettert vom Sockel herunter.\n");
    return 1;
	}
return 0;
}

int stossen(string str)
{
  string wer;
  string dummy;
  if (!str) return 0;
  if (sscanf(str, "%s von sockel%s", wer, dummy)!=2) return 0;
  if(erhabener&&capitalize(wer)==erhabener->name())
    {
	  write("Du stoesst "+erhabener->name(WEN)+" vom Sockel.\n");
	  tell_object(erhabener, TPN+" stoesst Dich von dem Sockel.\n");
	  tell_room(environment(TO), TPN+" stoesst "+erhabener->name(WEN)+" von dem Sockel.\n",({TP,erhabener}));
    SetProp(P_NOGET, 0);
    erhabener->SetProp(P_NOMOVE, 0);
    erhabener->SetProp(P_SIZE, erhabener->QueryProp(P_SIZE)+QueryProp(P_SIZE) );
	erhabener=0;
	return 1;
	}
  if(wer, environment(TO))
  {
    write(capitalize(wer)+" steht nicht auf dem Sockel.\n");
    return 1;
  }	
  if(!erhabener)
  {
    write("Es steht doch niemand auf dem Sockel.\n");
	return 1;
	}
    write(capitalize(wer)+" steht nicht auf dem Sockel.\n");
    return 1;
}  
  
void BecomesNetDead(object spieler)
{
  if (spieler==erhabener)
  {
    tell_room(environment(TO), erhabener->name()+" faellt vom Sockel herunter.\n");
    SetProp(P_NOGET, 0);
    erhabener->SetProp(P_NOMOVE, 0);
    erhabener->SetProp(P_SIZE, erhabener->QueryProp(P_SIZE)+QueryProp(P_SIZE) );
	erhabener=0;
	}
}  /*
string short() {
  string erg;
  erg = QueryProp(P_SHORT);
  if( !erhabener ) return erg;
  if( erhabener == TP) return erg + " Du stehst auf ihm.\n";
  return erg + TP->name() + " steht auf ihm. \n";
}*/

string long() {
  string erg;
  erg = QueryProp(P_LONG);
  if( erhabener == TP ) return erg + " Du stehst auf ihm.\n";
  return erg;
}
