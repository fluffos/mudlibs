#include <moredef.h>
#include "../def.h"
inherit "std/room";
inherit GIER_ROOM + "gierlinge_u_std.lpc";
int schleim = 3;

void reset()
{
	::reset();
	schleim = 3;
	}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Grotte" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer Grotte. Es ist hier recht hell, obwohl Du "
    "keine Lichtquelle entdecken kannst. Die Waende scheinen hier etwas "
	"matter zu leuchten." );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende glitzern hier weniger, denn sie werden teilweise von dickem, gelben Schleim ueberdeckt. ");
  AddDetail( ({ "schleim" }),
    "Der sieht voll ecklig aus. Aber wenn Du magst, kannst Du ja an ihm lecken.");
  AddDetail( ({ "" }),
    "");
  


  AddExit( "westen", GIER_ROOM + "gierlinge_u_1d.lpc" );
   AddCmd(({"lecke","leck"}),"leckenCmd"); 

}

int leckenCmd(string str)
{ notify_fail("Was willst Du lecken?\n");

if(str=="wand" || str=="schleim" || str=="schleim von wand" || str=="an wand")
	{
		if (schleim > 0)
				{	
					write("Du leckst den Schleim von der Wand.\n");
					say(TPN+" leckt Schleim von einer Wand.\n");
					TP->AddHp(17);
					TP->AddSp(9);
					schleim-=1;
					return 1;
	}
	else
		{
			write("Du schrammst mit der Zunge ueber den rauen Fels.\n");
			TP->do_damage(1,"Ueber einen Felsen lecken");		
			return 1;
		}
	}
}