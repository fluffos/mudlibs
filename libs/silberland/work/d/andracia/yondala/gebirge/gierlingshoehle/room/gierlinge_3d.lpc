// fertig

// Ueberarbeitet am 11.01.2011
// Yondala@Silberland
// Bilds an Wand: Gierling liegt auf einer Wiese
// EPidee: "linke seite"
// daran denken, den Gierlingen infos ueber die Waldkobolde zu geben!
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Der Gang, in dem Du "
	"Dich befindest, macht hier einen scharfen Knick und Du kannst nach "
	"Osten oder nach Nordosten gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
   AddItem(GIER_NPC + "gierling_oitl.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "knick" }),
    "Du kannst von hier aus nach Osten und nach Nordosten laufen.");

  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "osten" }),
    "Oestlich von Dir spaltet sich der Gang zu einer T-Kreuzung.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine T-Kreuzung, denn der Gang teilt sich dort in drei Richtungen, wie bei einem \"T\".");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nur in zwei Richtungen gehen: Osten und "
	"Nordosten.");
  AddDetail( ({ "nordosten", "weg" }),
    "Nach Nordosten fuehrt der Weg tiefer in die Hoehle hinein, da er dort "
	"bald eine Kurve beschreibt, siehst Du nicht, was dahinter ist.");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");  
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen ergeben das Bild eines Gierlings in voller "
	"Lebensgroesse.");
  AddDetail( ({ "lebensgroesse" }),
    "Der abgebildete Gierling ist genauso gross, wie die Gierlinge, die "
	"in dieser Hoehle lebendig herum laufen.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge leben in dieser Hoehle. Du bist sicher schon dem ein "
	"oder anderen begegnet.");
  AddDetail( ({ "gierling","gierling in bild" }),
    "Der Gierling liegt entspannt auf einer Wiese und laesst sich die "
	"Sonne auf den Bauch scheinen. Den Schlapphut hat er sich ins Gesicht "
	"geschoben. Die Arme im Nacken verschraenkt macht er vermutlich ein "
	"Nickerchen.");
  AddDetail( ({ "nickerchen" }),
    "Wie untypisch fuer einen Gierling. Die Kleidung und auch die Haltung "
	"deuten darauf hin, dass es sich auf dem Bild nicht um einen echten "
	"Gierling, sondern eher um einen Waldkobold handeln muss.");
  AddDetail( ({ "wiese" }),
    "Eine saftige, gruene Wiese wurde mit Jadeiten in die Wand gesteckt. "
	"vereinzelte bunte Edelsteine stellen unterschiedlichste Blumen dar.");
  AddDetail( ({ "blumen" }),
    "Du siehst leuchtend rote Mohnblumen, violette Veilchen und tausende "
	"von Gaensebluemchen.");
  AddDetail( ({ "mohnblumen" }),
    "Die Mohnblumen bestehen aus zusammengesetzten Rubinen.");
  AddDetail( ({ "veilchen" }),
    "Praechtige Almandine wurden verwendet, um die kleinen Veilchen dar zu "
	"stellen.");
  AddDetail( ({ "gaensebluemchen" }),
    "Unzaehlige Diaspore an der Wand bilden fast naturgetreue Abbilder von "
	"huebschen kleinen Gaensebluemchen.");
  AddDetail( ({ "abbilder" }),
    "Es sind halt keine echten, sondern sie bestehen aus Edelsteinen. Aber "
	"sie sehen echten Blumen sehr aehnlich.");
  AddDetail( ({ "sonne" }),
    "Eine etwas kitschige Sonne aus Apophylliten lacht auf den Gierling "
	"herab.");
  AddDetail( ({ "kleidung" }),
    "Obwohl die Kleidung des Gierlings - zumindest als Bild - aus reinen "
	"Edelsteinen besteht, so wirkt sie dennoch alt, zerschlissen und "
	"ausgefranst.");
  AddDetail( ({ "bauch" }),
    "Der runde Bauch des Gierlings lukt unter seinem Hemd hervor.");
  AddDetail( ({ "hemd" }),
    "Das Hemd des Gierlings hat wohl auch schonmal bessere Tage gesehen.");
  AddDetail( ({ "tage" }),
    "Dem Hemd nach zu urteilen sind diese Tage lange her.");
  AddDetail( ({ "schlapphut","hut" }),
    "Der Schlapphut des Gierlings auf dem Bild besteht aus Aventurinen. Der Hut ist an der Krempe ausgefranst und hat ein Loch an der Seite.");
  AddDetail( ({ "krempe" }),
    "Die Krempe des Hutes ist stark ausgefranst. Du vermutest, dass der dargestellte Hut recht alt ist.");
  AddDetail( ({ "seite" }),
    "An der linken Seite, um genau zu sein.");
  AddDetail( ({ "linke seite" }),
    "An der linken Seite hat der Hut des Gierlings ein Loch.");
  AddDetail( ({ "loch" }),
    "Durch das Loch schauen ein paar wuschelig-rote Haare hervor.");
  AddDetail( ({ "haare" }),
    "Die wuscheligen Haare des Gierlings schauen aus dem Loch hervor. Sie wurden von Meisterhand aus Oktarinen gefertigt.");
  AddDetail( ({ "meisterhand","meister" }),
    "Nur ein wahrer Meister seines Faches konnte die Oktarine fuer die Haare so fein bearbeiten, dass man sogar einzelne Haare erkennen kann.");
  AddDetail( ({ "fach" }),
    "Das Fach der Edelsteinverarbeitung.");
  AddDetail( ({ "edelsteinverarbeitung" }),
    "Die Edelsteine wurden sehr sorgfaeltig und detailgetreu verarbeitet.");
  AddDetail( ({ "gesicht" }),
    "Von dem rosafarbenen Gesicht, das wohl aus Rosenquarz gefertigt wurde - ist nur der rote Mund zu sehen.");
  AddDetail( ({ "mund" }),
    "Der Mund sieht entspannt aus, der Gierling laechelt. Im Mundwinkel steckt ihm ein Grashalm.");
  AddDetail( ({ "mundwinkel" }),
    "Zwischen den roten Lippen steckt ein Grashalm.");
  AddDetail( ({ "lippen" }),
    "Die Lippen des Gierlings sind hellrot. Sie wurden aus Jaspisen hergestellt. ");
  AddDetail( ({ "grashalm" }),
    "Der Gierling kaut genuesslich auf dem kleinen Grashalm herum. Vermutlich hat er ihn einfach aus der Wiese gezupft.");
  AddDetail( ({ "haltung" }),
    "Der Gierling - wenn es denn einer ist - liegt faul und entspannt auf einer gruenen Wiese");
  AddDetail( ({ "waldkobold" }),
    "Vermutlich liegt dort auf der Wiese ein kleiner Waldkobold, die Verwandten der Gierlinge.");
  AddDetail( ({ "verwandte" }),
    "Die Gierlinge sind mit den Waldkobolden verwandt. Man vermutet sogar, dass die Gierling von den Waldkobolden abstammen. Aber das ist wohl nur ein Geruecht.");
  AddDetail( ({ "geruecht" }),
    "Vielleicht fragst Du mal jemanden, der es weiss?");
  AddDetail( ({ "waldkobolde" }),
    "Hier wirst Du keine Waldkobolde finden, aber vielleicht ist der Gierling auf dem Bild ja in Wirklichkeit ein Waldkobold.");
  AddDetail( ({ "wirklichkeit" }),
    "So wirklich wie ein Bild in einem Mud sein kann :o)");
  AddDetail( ({ "mud" }),
    "Leider stellst Du fest, dass Du Dich in einem Mud und nicht in der Realitaet befindest.");
  AddDetail( ({ "realitaet" }),
    "Aber so genau nehmen wir das nicht, oder?");
  AddDetail( ({ "arme" }),
    "Der Gierling hat seine rosafarbenen Rosenquarzarme im Nacken verschraenkt, er nutzt sie als Kissen fuer seinen Kopf.");
  AddDetail( ({ "kissen" }),
    "Da kein Kissen da ist, nutzt der Gierling auf dem Bild seine Arme dafuer.");
  AddDetail( ({ "rosenquarzarme" }),
    "Die Arme des Gierlings wurden aus Rosenquarzen in die Wand gesteckt.");
  AddDetail( ({ "nacken" }),
    "Den Nacken kann man natuerlich nicht sehen, darauf liegt der Gierling ja.");
  AddDetail( ({ "nickerchen" }),
    "Das ist wirklich atypisch fuer einen Gierling. Einfach so rumliegen und nichts tun um das eigene Vermoegen zu vergroessern.");
  AddDetail( ({ "vermoegen" }),
    "Der Gierling auf dem Bild scheint kein grosses Vermoegen zu haben, sonst waere er besser gekleidet. Dennoch sieht er sehr zufrieden aus.");
  AddDetail( ({ "kopf" }),
    "Von dem Kopf siehst Du nicht viel, da er von seinem Hut verdeckt "
	"wird. Nur Mund und Kinn schauen darunter hervor.");
  AddDetail( ({ "kinn" }),
    "Das Kinn ist fast schon doppelt vorhanden, ein bisschen moppelig ist "
	"der Gierling schon.");
  AddDetail( ({ "kurve" }),
    "Im Nordosten geht der Gang nicht gerade weiter, sondern kruemmt sich.");
  AddDetail( ({ "weg" }),
    "Der Gang ist der Weg in dieser Hoehle.");

  

  

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen.");

  AddSound( ({ "rauschen" }),
    "Wenn Du bloss wuesstest, woher es kommt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ein wenig feucht.");

  AddSmell( ({ "feuchtigkeit" }),
    "Naja, Du bist ja auch in einer Hoehle.");
    
  AddExit( "nordosten", GIER_ROOM + "gierlinge_2e.lpc" );
  AddExit( "osten", GIER_ROOM + "gierlinge_3e.lpc" );  

  

}

