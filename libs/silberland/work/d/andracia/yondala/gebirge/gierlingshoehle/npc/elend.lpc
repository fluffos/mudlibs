// Ein Elend

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <npc.h>
#include "../def.h"
inherit "std/mnpc";
object ob;		
	
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Haeuflein Elend");
  SetProp(P_LONG,
    "Du siehst ein Haeuflein Elend hier rumsitzen. Es schaut Dich traurig an.");
  SetProp(P_NAME, "Haeuflein Elend");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);


  AddId(({"elend", "haeuflein", "hauflein elend"}));

  create_default_npc(3);
  SetProp(P_HANDS, ({" unmotiviert",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 13000);
  SetProp(P_ALIGN, 0);



  SetProp(P_DIE_MSG,  " stoehnt ein letztes Mal.\n");
  SetProp(P_KILL_NAME, "Ein Haeuflein Elend");

  SetChats(3, ({"Das Haeuflein Elend seufzt.\n", 
  	"Das Haeuflein Elend jammert.\n", 
  	"Das Haeuflein Elend stoehnt.\n", 
  	"Das Haeuflein Elend schaut Dich mitleidheischend an.\n"}) );



  SetProp( P_REJECT, ({ REJECT_DROP,
   "Das Haeuflein Elend will Deine Sachen nicht tragen.\n" }) );
 
  AddInfo(DEFAULT_INFO, "faengt an zu weinen.\n");
  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 1 + random(50));
  ob->move(TO, M_SILENT);

}

