//hier soll man tanken koennen, man hat 5 Sekunden Zeit um einen Tropfen zu fangen
#include <moredef.h>
#include "../def.h"
inherit GIER_ROOM + "gierlinge_u_std.lpc";
#include <properties.h>
int da = 0;

void reset()
{
	::reset();
	da = 0;
	}
void create() 
{
  ::create();

  AddRoomMessage( ({"Ein grosser Tropfen bildet sich an der Decke.\n"}),30,"tropf");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus Fels gehauen. Von der Decke tropft es ab und zu.");


  AddExit( "osten", GIER_ROOM + "gierlinge_u_1b.lpc" );
  AddCmd( ({ "fange", "fang" }), "fangenCmd" );   
}

void tropf()
{
		//say("Ein grosser Tropfen bildet sich an der Decke.\n");
	  da=1;
	  AddDetail( ({ "boden", "decke" }),
      "Boden und Decke sind aus Fels gehauen. Von der Decke haengt ein grosser Tropfen herab.");
    AddDetail( ({ "tropfen"}),
      "Du kannst versuchen ihn mit Deiner Zunge aufzufangen.");

		call_out("enttropf", 5);
		
	}


void enttropf()
{
	if(da==1)
		{			
			//write("Ein grosser Tropfen tropft von der Decke.\n");
			tell_room(TO, "Ein grosser Tropfen tropft von der Decke.\n");
			da=0;
	  	AddDetail( ({ "boden", "decke" }),
    		"Boden und Decke sind aus Fels gehauen. Von der Decke tropft es ab und zu.");
		RemoveDetail("tropfen");
		}
}	
	
	
int fangenCmd(string str )
{//hier soll ein Forscherpunkt hin
  notify_fail( "Was moechtest Du womit auffangen?\n" );
  if( str == "tropfen"|| str=="tropfen mit zunge"||str=="tropfen mit zunge auf" )
  {
  	if(da==1)
  		{
  			write("Du streckst Deine Zunge aus und faengst den grossen Tropfen geschickt auf.\n");
		    say( TPN+" faengt einen Tropfen mit der Zunge auf.\n",TP);
			TP->AddHp(5);
			da=0;
			AddDetail( ({ "boden", "decke" }),
  	  		"Boden und Decke sind aus Fels gehauen. Von der Decke tropft es ab und zu.");
			RemoveDetail("tropfen");
    	}
    else
    	{
    		write("Du streckst Deine Zunge aus, aber es ist gerade gar kein Tropfen da.\n");
    	}
    		
    return 1;
    	
  }
  return 0;
}
 