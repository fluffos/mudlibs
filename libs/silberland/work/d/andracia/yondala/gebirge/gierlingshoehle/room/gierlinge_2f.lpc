// Dampfhoehle
// alle NPCs koennen sich dort aufhalten. Sie sind nackt mit Handtuechern. 
// Vergisst der Spieler ein Handtuch zu kaufen kichern die Gierlinge und 
// zeigen mit dem Finger auf ihn. Sollte aber in die NPCs die Funktion in init
// in dem Raum soll man etwas schneller wieder zu kraeften kommen als normal
// vielleicht so schnell wie beim rasten. Aber man sollte nicht zu lange drin
// bleiben duerfen.

//Idee Eine Funktion machen die abfragt wie lange man schon da ist, dann 
//rauswerfen (freiwillig gehen, zuviel Sauna ist nicht gut fuer Dich), 
//unsichtbares Item geben, man bekommt einen Hitzeschlag, wenn man zu bald
//wieder reingeht
//15.01.2011 Yondala@Silberland Erstmal idlet man nur hoch ->funzt noch nicht

#include "../def.h"
#include <moredef.h>
inherit "std/room";
#include <properties.h>
#include <combat.h>

 void init()
 {
 ::init();
 if(interactive(TP)&&!present("saunamarker",TP)) CLONE(GIER_OBJ +"saunamarker.lpc", TP);
 }
BecomesNetAlive()
{if(interactive(TP)&&!present("saunamarker",TP)) CLONE(GIER_OBJ +"saunamarker.lpc", TP);}

int sitz_status=0;
int spiegel_beschlagen=1;
void create() 
{
  ::create();
  AddItem(GIER_NPC + "gierling_sauna_schrumpelig.lpc",REFRESH_DESTRUCT);  
  AddItem(GIER_NPC + "gierling_sauna_alt.lpc",REFRESH_DESTRUCT);
  SetProp( P_INT_SHORT, "In einer Dampfhoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Dampfhoehle der Gierlinge. Die Waende und die "
    "Decke sind mit Holz vertaefelt und rundherum an der Wand steht eine "
	"hoelzerne Bank. Dichter Dampf wabert durch den Raum." );
  SetProp( P_LIGHT, 1 );// geht da auch 0,5?
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "dampfhoehle", "sauna", "raum" }),
    "Du befindest Dich in einer Dampfhoehle.");
   AddDetail( ({ "gierlinge" }),
    "Die Gierlinge kommen ab und zu her um sich zu entspannen.");  
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind mit Holz vertaefelt, davor stehen rundherum Baenke "
	"aus Holz, an einer Wand befindet sich die Tuer, durch die Du gekommen "
	"bist. Gegenueber der Tuer haengt ein Spiegel an der Wand.");
  AddDetail( ({ "bank", "baenke" }),
    "Sie bestehen aus Holz. Man koente auf ihnen sitzen.");
  AddDetail( ({ "tuer", "tuere" }),
    "Durch diese Tuer bist Du gekommen.");
  AddDetail( ({ "Holz" }),
    "Vermutlich aus den Elfenwaeldern importiert und von Elfen hergestellt.");
  AddDetail (({"elfenwaelder", "elfenwaeldern", "elfen"}),
    "Die kennst Du doch, oder?"); 
  AddDetail( ({ "man", "jemand" }),
    "Irgendwer.");
  AddDetail (({"irgendwer"}),
  	"Du bist irgendwer.");
  AddDetail( ({ "Du", "Dich" }),
    "Guck in nen Spiegel!");
  AddDetail( ({ "spiegel" }),
    "Der haengt an einer Wand und ist beschlagen vor lauter Dampf.");
  AddDetail( ({ "dampf" }),
    "Dichter Dampf wabert durch den Raum.");
  AddDetail( ({ "wasser" }),
    "Das Wasser wird benutzt um Dampf zu erzeugen.");
  AddDetail( ({ "dampf", "dampfschwaden" }),
    "Dampf ist in Luft geloestet Wasser.");
  AddDetail( ({ "luft" }),
    "Die Luft ist voll heissen Dampfs.");
  AddDetail( ({ "steine" }),
    "Die Steine liegen auf der Feuerstelle. Auf sie kann man Wasser giessen "
    "um Dampf zu erzeugen.");
  AddDetail( ({ "feuerstelle" }),
    "Auf der Feuerstelle liegen Steine um dort erhitzt zu werden. Neben der "
    "Feuerstelle steht ein Kuebel mit Wasser.");
  AddDetail( ({ "kuebel" }),
    "In dem Kuebel ist Wasser und eine Kelle.");
  AddDetail( ({ "kelle" }),
    "Mit der Kelle kann man Wasser auf die heissen Steine schoepfen.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus Holz.");
  AddDetail( ({"aufguss" }),
    "Dem Aufguss scheinen Kraeuter beigemischt worden zu sein.");

  AddSpecialDetail( "spiegelbild", "spiegelbild");
    AddDetail( ({ "" }),
    ".");
    AddDetail( ({ "" }),
    ".");
    
  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es zischt.");

  AddSound( ({ "zischen" }),
    "Das ist wohl das Zischen von verdunstendem Wasser.");
 AddSound( ({ "wasser" }),
    "Das Wasser verdampft mit einem leisen Zischen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Kraeutern.");

  AddSmell( ({ "kraeuter", "kraeutern", "aufguss" }),
    "Dem Aufguss scheinen Kraeuter beigemischt worden zu sein.");

  AddRoomMessage( 
    ({"Es zischt. Jemand hat anscheinend wieder Wasser auf die heissen Steine gegossen.\n", 
	  "Dampfschwaden wabern durch den Raum.\n",
	  "Puh, langsam wirds Dir warm hier drin.\n"}),60,"func");

  AddExit( "norden", GIER_ROOM + "gierlinge_1f.lpc" );

  AddCmd(({"sitze","setze", "sitz"}),"sitzenCmd");
  AddCmd(({"steh","stehe"}),"aufstehenCmd");
//  AddCmd(({"norden","nord"}),"gehenCmd");
  AddCmd( ({ "schoepf", "schoepfe" }), "schoepfenCmd" );
  AddCmd( ({ "begutachte" }), "begutachten" );
  AddCmd( ({ "wische", "wisch" }), "wischenCmd" );

  }

  string spiegelbild()
  {
    if(spiegel_beschlagen) return "Der Spiegel ist beschlagen, Du kannst nichts erkennen.\n";
	else return TP->QueryProp(P_LONG);
	}


int sitzenCmd(string str)
  {  	notify_fail( "Worauf moechtest Du sitzen?\n" );
if (str!="auf bank")
  	{return 0;}
//wenn er aus irgendeinem Grund nicht laufen kann (weil er zum Beispiel gerade schon sitzt
if (this_player()->QueryProp(P_NOMOVE)) 
   {
     write (TP->QueryProp(P_NOMOVE));
	 return 1;
	 }	
	else //also wenn er noch nicht sitzt
		{
		  write ("Du setzt Dich auf die Bank.\n");
		  say (TPN+" setzt sich auf die Bank.\n", TP);
		  TP->SetProp(P_NOMOVE, "Du sitzt und solltest erst aufstehen.\n");
		return 1;}
			
}




int aufstehenCmd(string str)
  {  	
    notify_fail( "Moechtest Du vielleicht aufstehen?\n" );
    if (str!="auf")
  	{return 0;}

if (this_player()->QueryProp(P_NOMOVE)!="Du sitzt und solltest erst aufstehen.\n")

	{write ("Du sitzt doch gar nicht!\n");
	return 1;}
	
	else 
	{
	  write ("Du stehst von der Bank auf.\n");
	  say (TPN+" steht von der Bank auf.\n", TP);
      TP->SetProp(P_NOMOVE, 0);
	  return 1;
	}
			
}

int schoepfenCmd(string str )
{
  notify_fail( "Was moechtest Du auf was schoepfen?\n" );
  if( str == "wasser auf steine","wasser mit kelle auf steine", 
             "wasser auf feuerstelle", "wasser mit kelle auf feuerstelle" )
  {
    write("Du nimmst die Kelle und schoepfst etwas Wasser auf die heissen "+
	      "Steine.\nDampf steigt auf.\n");
    say( TPN+" nimmt die Kelle und schoepfst etwas Wasser auf die heissen "+
	         "Steine.\nDampf steigt auf.\n");
    return 1;
  }
  return 0;
}


int wischenCmd(string str)
{//Forscherpunkt
	if (str=="spiegel"||str=="dampf von spiegel"||str=="spiegel sauber"||str=="spiegel ab")
		{
			write("Du wischst den Dampf vom Spiegel.\n");
			say(TPN+" wischt den Spiegel.\n");
  		AddDetail( ({ "spiegel" }), 
    		"Der haengt an einer Wand und wurde scheinbar grad frish gewischt, sodass Du Dein Spiegelbild begutachten kannst.");
			call_out("beschlagen", 5);
			spiegel_beschlagen=0;
			return 1;
		}
}

int beschlagen()
{
  tell_room(TO,"Der Spiegel beschlaegt wieder.\n");
  AddDetail( ({ "spiegel" }),
    "Der haengt an einer Wand und ist beschlagen vor lauter Dampf");
}

begutachten(string str)
{
  notify_fail("Du kannst nur Dein Spiegelbild begutachten.\n");
  if(str=="spiegelbild")
  {
      if(spiegel_beschlagen) 
	  write("Der Spiegel ist beschlagen, Du kannst nichts erkennen.\n");
	  else write(TP->long());
	  return 1;
	  }
return 0;
}