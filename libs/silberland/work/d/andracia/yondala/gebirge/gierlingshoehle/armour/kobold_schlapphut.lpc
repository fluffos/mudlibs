#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein brauner Schlapphut");
  SetProp(P_LONG,
    "Ein kleiner gruener Schlapphut, der wohl nur sehr kleinen Wesen passen kann." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Schlapphut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut", "schlapphut"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_FELT );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 150);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:80]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
