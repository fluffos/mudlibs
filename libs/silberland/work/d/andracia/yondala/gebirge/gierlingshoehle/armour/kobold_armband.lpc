//QuestItem
#include <moredef.h>//"../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Armband");
  SetProp(P_LONG,
    "Du siehst ein kleines, goldenes Armband. Es glitzert und funkelt. ");
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Armband");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WORN_TEXT, "ums Handgelenk getragen");
  SetProp(P_ARTICLE, 1);
  AddId( ({"armband", "\narmband"}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([ MAT_GOLD, MAT_DIAMOND ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);


}
