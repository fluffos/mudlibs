inherit "/std/food";
#include <moredef.h>
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Lollie");
  SetProp(P_LONG,
    "Du haelst einen leuchten bunten, zuckersuessen Lollie in Deinen Haenden." );
  SetProp(P_NAME, "Lollie");
  SetProp(P_GENDER, MALE);
SetProp(P_INFO, "Dieser Lollie hebt die Stimmung und troestet in schweren Stunden.");


SetProp(P_FOOD_INFO, ([F_SOAK:5, 
											 F_HEAL:({5,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du schleckst den bunten Lollie bis er vollstaendig weg ist. Du "
											 	"fuehlst Dich nun schon viel besser.", 
											 F_MSG_ROOM: "schleckt einen Lollie und laechelt gluecklich."]));


  AddId("lollie","lutscher");

  SetProp(P_MATERIAL, ({MAT_FRUIT, MAT_SUGAR}));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 60);


 
}

