int vergleichen (string str)
{
	write("Werner sagt. Ich vergleiche nichts fuer Euch.\n");
	return 1;
	
}

void fertig (object spieler)
{
	SetProp(P_NOATTACK, 0);  
	TP->SetProp(P_NOMOVE, 0);
	write("Werner sagt: Fertig.\n");
	
}

void waffe_reparieren(object waffe, object spieler)
{
	//P_WC hoechstens 300
	if(waffe->QueryProp(P_DAMAGED)>50)
	{
		waffe->SetProp(P_DAMAGED, waffe->QueryProp(P_DAMAGED)/10*9);
		write("Werner sagt: Ganz reparieren kann ich es nicht, aber ich gebe mein Bestes.\n");
	}
	
	if(waffe->QueryProp(P_WC)<20)
	{
		waffe->SetProp(P_DAMAGED, 0);
		write("Werner sagt: Ich glaube, ich kann diese minderwertige Waffe komplett reparieren.\n");
		}
	
	call_out("fertig", 3, spieler);

}


void ruest_reparieren(object ruest, object spieler)
{

	if(ruest->QueryProp(P_DAMAGED)>50)
	{
		ruest->SetProp(P_DAMAGED, ruest->QueryProp(P_DAMAGED)/10*9);
		write("Werner sagt: Ganz reparieren kann ich es nicht, aber ich gebe mein Bestes.\n");
	}
	
	if(ruest->QueryProp(P_AC)<15)
	{
		ruest->SetProp(P_DAMAGED, 0);
		write("Werner sagt: Ich glaube, ich kann diese minderwertige Waffe komplett reparieren.\n");
		}
	
	call_out("fertig", 3, spieler);

}

void Reparatur2(object ob, object spieler)
{
	write("Werner hantiert an "+ob->name(WEM)+" herum.\n");	
	if(ob->QueryProp(P_WEAPON_TYPE)) //Es handelt sich um eine Waffe
		call_out("waffe_reparieren", 3, ob, TP);
	
	if(ob->QueryProp(P_ARMOUR_TYPE)) //Es handelt sich um eine Waffe
		call_out("ruest_reparieren", 3, ob, TP);
}

void Reparatur1(object ob, object spieler)
{
	write("Werner sagt: Dann wollen wir mal sehen.\n");	
	call_out("Reparatur2", 2, ob, TP);

}

int reparieren(string str)
{
	object ob;
	int wert;
	if(!str)
	{
		write("Werner fragt: Was soll ich denn reparieren?\n");
		return 1;
	}
	if(InFight(TO))
	{
		write("Werner hat gerade keine Zeit.\n");
		return 1;
	}
	if(QueryProp(P_NOATTACK))
	{
		write("Werner sagt: Geduld, erst repariere ich das eine, dann das andere.\n");
		return 1;
	}
	
	if(!present(str, TP))
	{
		write("Werner sagt: So etwas habt Ihr nicht dabei.\n");
		return 1;
	}
	
	ob=present(str, TP);
	if(!ob->QueryProp(P_WEAPON_TYPE)&&!ob->QueryProp(P_ARMOUR_TYPE))
	{
		write("Werner sagt: Ich kann nur Ruestungen oder Waffen reparieren.\n");
		return 1;
	}
	if(ob->QueryProp(P_DAMAGED)<=50)
	{
		write("Werner sagt: So kaputt ist "+ob->name()+ " nicht, da kann ich nichts tun.\n");
		return 1;
	}	
	
	if(!present("goldklumpen", TP))
	{
		write("Werner sagt: Ihr habt keinen Goldklumpen dabei.\n");
		write("Werner sagt: Fuer meine Dienste verlange ich einen.\n");
		return 1;
	}
	
	write("Werner schnappt sich Deinen Goldklumpen.\n");
	//present("goldklumpen", TP)->remove();
	SetProp(P_NOATTACK, "Werner repariert gerade, es waere unhoeflich, ihn jetzt anzugreifen.\n");  
	TP->SetProp(P_NOMOVE, "Werner repariert gerade etwas fuer Dich, es waere unhoeflich, jetzt zu gehen.\n");
	call_out("Reparatur1",2,ob, TP);
	return 1;
	//call_out("fertig",20,ob, TP); //als Absicherung, falls was schiefgeht
}








// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut sich um, nimmt ein Stueck Gold aus der Tasche und poliert es.",
        "schaut sich um, nimmt ein Stueck Gold aus der Tasche und poliert es.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
