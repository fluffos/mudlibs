#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int da = 3;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein zerschlissener Mantel");
  SetProp(P_LONG,
    "Was man so Mantel nennt. Es ist fast schon nur noch ein Fetzen. Der Besitzer dieses Mantels scheint wirklich arm zu sein." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Mantel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"mantel"}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_COTTON ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);
//	SetProp (P_WEAR_DESTRICTIONS, SR_INCLUDE_RACE("Kobold")P_GENDER(NEUTER));
// das wird falsch sein

//  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
  AddCmd(({"greife","greif"}),"greifenCmd");
  }

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}


greifenCmd(string str)
{ notify_fail("Worein willst du greifen?\n");


if(str=="in tasche" || str=="in manteltasche")
{	
	
if(da>=0)
{
		write("Du greifst in die Manteltasche und holst eine Klinke heraus.\n");
		say(TPN+" nimmt eine Tuerklinke aus seinem Mantel.\n");
CLONE("/d/koboldhoehle/dinge/klinke.lpc", TP);
		da-=1;
		return 1;
}

else
	write("Es ist keine Klinke mehr da.\n");
return 1;
}}