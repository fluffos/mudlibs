//Dieser Gierling sitzt in der Sauna, unterhaelt sich mit dem alten Gierling
//laestert ueber Spieler

#include <properties.h> 
#include <combat.h>
//#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <npc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
int groesse;
string groessetext;


void furzen()
{tell_room(environment(TO),"Dem schrumpeligen Gierling entweicht ein knatternder Furz.\n");
 CLONE("/obj/misc/furz", environment(TO));
 present("_furz_", environment(TO))->set_furzer(TO);}


//Dinge, die beim reset spontan gesagt werden koennen 
void spontan_sagen(string str)
{
  if(str=="herrlich")tell_room(environment(TO),"Der schrumpelige Gierling sagt: Ach, ist das herrlich heute.");
}
 
//Wird aufgerufen, wenn ein nackter Spieler da ist.
void nackter()
{
  //
  if(present("handtuch",TP))
    command("sag In der Hand ist Handtuch wenig nuetze, Ihr solltet es anziehen. "+TPN+".");
	
  return;
} 

void handtuchtraeger(object spieler)
{
  if(!present(spieler, environment(TO))) return;//Spieler ist nicht mehr da
  if(!present("handtuch",TP)->QueryWorn())return;//Spieler traegt das Handtuch nicht mehr
  if(TP->QueryArmours(({AT_ARMOUR, AT_CLOAK, AT_BELT, AT_TROUSERS }))) return;//Spieler hat noch was an
  
  if(TP->QueryProp(P_GENDER)=="MALE")
  command("sag "+TPN+" ist ein Mann.");
  }

void jemand_kommt()
{
  int i;
  int handtuch; //1=vorhanden, 2=getragen, 0=nicht vorhanden
  object *besitz;
  object *getragenes;
  string sagen;
  if(!present(TP,environment(TO))) return; //wenn der Spieler schon weg ist
  handtuch=0;  
  getragenes=TP->QueryArmours(({AT_ARMOUR, AT_CLOAK, AT_BELT, AT_TROUSERS }));
  if(present("handtuch",TP)) 
    { 
	  if(present("handtuch",TP)->QueryWorn())
	  handtuch=2; //der Spieler traegt ein Handtuch
      else handtuch=1; //der Spieler traegt kein Handtuch
    }
  
  //Spieler traegt Handtuch und noch andere Ausruestung
  if(sizeof(getragenes)>0&&handtuch==2)
  {
    tell_room(environment(TO), "Der schrumpelige Gierling kichert.\n");
    tell_room(environment(TO), "Der schrumpelige Gierling sagt: Schaut Euch das an!\n");
	sagen= TPN+ " traegt ";
    
    for(i=sizeof(getragenes);i--;i>=0)
	{
	    sagen=sagen+getragenes[i]->name(WEN);
	    if(i>=2)sagen=sagen+", ";
		else if (i==1)sagen=sagen+" und ";
	}
	sagen=sagen+" unter dem Handtuch.\n";
	tell_room(environment(TO), break_string(sagen, 80, 
	                          "Der schrumeplige Gierling sagt: "));
	tell_room(environment(TO), "Der schrumpelige Gierling fragt: Ist das "+
	                           "nicht ein bisschen warm?\n");
	
	if(present("\naltergierling",environment(TO))) 
	   call_other(present("\naltergierling",environment(TO)), "einangezogener",TP,3);
	
   }
  
  //Der Spieler traegt nur das Handtuch
  if(sizeof(getragenes)==0&&handtuch==2) 
  {
    tell_object(TP, "Der schrumpelige Gierling nickt Dir zu.\n");
    tell_room(environment(TO), "Der schrumpelige Gierling nickt "+TPN+" zu.\n");
	call_out("handtuchtraeger",15,TP);
	}
  else if(sizeof(getragenes)==0&&handtuch==1)
   {
     tell_room(environment(TO), "Der schrumpelige Gierling lacht.\n");
     command("sag In der Hand ist ein Handtuch wenig nuetze, Ihr solltet es anziehen, "+TPN+".");
	 }
	 //call_out("nackter",5,TP);
} 
void init()
{
  ::init();
  if(TP&&interactive(TP))
  call_out("jemand_kommt",2);
}
void irgendwastun()
{
  int i;
  i=random(6);
  if(i==0)
  {  tell_room(environment(TO),"Der schrumpelige Gierling beugt sich leicht zur Seite.\n");
     call_out("furzen",2);
	 }
  else if(i==1)
   {  
      tell_room(environment(TO),"Der schrumpelige Gierling streckt sich gemuetlich.\n");
      call_out("spontan_sagen",2,"herrlich");}
  else if(i==2)
   tell_room(environment(TO),"Der schrumpelige Gierling sagt: Ganz schoen trockene Luft.\n");
  else if(i==3)
   tell_room(environment(TO),"Der schrumpelige Gierling sagt: Hachja, frueher war alles besser.\n");
  else if(i==4)
  tell_room(environment(TO),"Der schrumpelige Gierling schneuzt sich in sein Handtuch.\n"); 
  else if(i==5)
  tell_room(environment(TO),"Der schrumpelige Gierling fragt: Weisst Du noch frueher?\n"); 

  
  }


void reset()
{
    ::reset();
    if(objectp(environment(this_object()))) {
        irgendwastun();
    }
 }
 
void create() {
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(5); 
  SetProp(P_NAME_ADJ, "schrumpelig");
  SetProp(P_ARTICLE, 2);
  SetProp(P_SHORT, "Ein schrumpeliger Gierling");
  SetProp(P_LONG,"");
  SetProp(P_NAME, "Gierling");
  SetProp(P_GENDER, MALE);
  AddDetail( ({ "", "" }),
    ""); 
  AddId(({"gierling", "mann", "\nschrumpeligergierling"}));
  SetProp(P_KILL_NAME, "Ein schrumpeliger Gierling");
  SetProp(P_NOATTACK,1);
  
  SUID;
  CLONEME(GIER_ARMOUR + "handtuch.lpc");
  command("trage alles");


  SetProp(P_HANDS, ({" mit seinen schrumpeligen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));



  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat



}

//wie reagiert der Gierling?
void reaktion(int i)
{
  string *reaktionen;
  reaktionen=({
"wird vorher abgefangen",                              //0
"sagt: Es sind halt schlechte Zeiten.",                //1
"seufzt.",                                             //2
"schaut entruestet.\n"+                                //3
"Der schrumpelige Gierling fragt: ICH? Warum sollte ich?",
"wehrt ab: Nein, nein, nein!"+                         //4
"\nDer schrumpelige Gierling behauptet: Ich war beim letzten Reset dran.",
"rollt mit den Augen.",                                //5
"sagt: Ein Vorschlag zur Guete: Wir machen es\n"+      //6
"Der schrumpelige Gierling sagt: gemeinsam.",
"grinst.",                                             //7
"meckert: Und diese Jugend!",                          //8
"sinniert: Mit der ist auch nichts mehr los.",         //9
"zuckt mit den Schultern.\nDer schrumpelige Gierling sagt: Ich weiss.",//10
"sagt: Ja. Auch die Frauen.",                          //11
"lacht: Sie haben uns zu Fuessen gelegen.",            //12
"seufzt: Aber heute...",                               //13
"sagt: Ja. Heute wollen die Frauen mitreden.",         //14
"sagt: Nein, Gold wollen sie haben, Abenteuer wollen\n"+//15
"Der schrumpelige Gierling sagt: sie erleben.",
"meint: Eine Schande.",
"",
""
				});
                       
 //command("sag "+reaktionen[i]);
tell_room(environment(TO),"Der schrumpelige Gierling "+reaktionen[i]+"\n");
 }

void stinker_sorry()
{
  if(random(2)) command("sag Tut mir leid, der musste raus.");
  else command("sag Ach, stell Dich nicht so an.");
}

//worauf reagiert der Gierling?
void catch_tell(string str)
{
    int i;
  string was, dummy;
  string *reaktion_auf;
  reaktion_auf=({
  "Der alte Gierling stoesst den schrumpeligen Gierling an%s.%s", //0
  "Der alte Gierling fragt: Ich soll mich nicht anstellen%s?%s", //1
  "Der alte Gierling sagt: Jaja, schon in Ordnung%s.%s",             //2
  "Der alte Gierling sagt: Du kannst gerne einen weiteren Aufguss machen%s.%s",//3
  "Der alte Gierling sagt: Weil Du dran bist%s!?%s",//4
  "Der alte Gierling sagt: Und ich die beiden Male davor%s!%s",//5
  "Der alte Gierling seufzt%s.%s",//6
  "Der alte Gierling zaehlt: Drei%s!%s",//7
  "Der alte Gierling nickt: Hoert, hoert%s.%s",//8
  "Der alte Gierling stimmt zu: Ohja, diese Jugend%s!%s",//9
  "%sDer alte Gierling sagt: Du bist ein Ferkel%s.%s",//10
  "Der alte Gierling erinnert sich: Ja, Frueher! Da war alles besser%s!%s",
  "Der alte Gierling sagt: Die Frauen, ja. Die waren auch besser%s.%s",
  "Der alte Gierling bestaetigt: Ohja, zu Fuessen%s.%s",
  "Der alte Gierling nickt: Heute ist alles anders%s.%s",
  "Der alte Gierling sagt: Da reicht nicht mehr der Herd und viele Kinder%s.%s",	
  "Der alte Gierling sagt: So ist das heute%s.%s",
  "Der alte Gierling sagt: ",
  "",
  "",
  "",
  "",
  "",
  "",
  ""
				 });        //3
  if(sscanf(str,reaktion_auf[0],was, dummy)==2)
  {call_out("stinker_sorry",3); 
	return;}
  
  for(i=sizeof(reaktion_auf)-1;i--;i>=0)
  { 
  if(sscanf(str,reaktion_auf[i],was,dummy)==2) 
     {
	 call_out("reaktion",2,i);
	  return;
	  }
   }
}

