//EPIdee: Spielsteine
//Bild an der Wand: Zwei brettspielende Gierlinge
// Ueberarbeitet am 29.8.2011
// Yondala@Silberland
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle.  Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Du befindest Dich "
	"auf einer Kreuzung und kannst nach Nordwesten, Norden und Sueden gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "sueden" }),
    "Im Sueden gabelt sich der Weg zu einer Y-Kreuzung.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nach Nordwesten, Norden und Sueden gehen.");
  AddDetail( ({ "kreuzung" }),
    "Die Kreuzung, auf der Du gerade stehst sieht aus wie ein \"Y\". Die "
	"Kreuzung suedlich von Dir sieht eher aus wie ein Pfeil.");

  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten ist ein etwas groesserer Hoehlenraum.");

  AddDetail( ({ "y" }),
    "Ein \"Y\", weisst schon.");
  AddDetail( ({ "pfeil" }),
    "Ein ->");


	
  AddDetail( ({ "weg" }),
    "Der Gang ist hier der Weg.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen ergeben ein Bild.");
  AddDetail( ({ "bild" }),
    "Das Bild stellt zwei Gierlinge dar, die an einem Tisch sitzen und "
	"konzentriert auf ein Brett blicken.");
  AddDetail( ({ "gierlinge","gierling","gierling in bild" }),
    "Die beiden Gierlinge tragen dunkelgruene Anzuege und Huete und sitzen "
	"auf kleinen Hockern vor dem Tisch.");
  AddDetail( ({ "anzuege" }),
    "Die Anzuege sind so dunkel gruen, dass sie wohl nur aus Turmalinen "
	"hergestellt werden konnten, da bist Du ziemlich sicher. Sie sind "
	"so detailgetreu, dass Du sogar die Naehte auf den Taschen erkennen "
	"kannst.");
  AddDetail( ({ "naehte" }),
    "Mit Silber wurden Naehte auf den Taschen der Anzuege angedeutet.");
  AddDetail( ({ "taschen","tasche", "anzugtasche" }),
    "Von jedem Gierling siehst Du eine Anzugtasche. Klar, sie sitzen ja "
	"seitlich von Dir.");
  AddDetail( ({ "huete","hut" }),
    "Die runden Huete sitzen auf den Koepfen der Gierlinge wie "
	"massgeschneidert.");
  AddDetail( ({ "koepfe" }),
    "Ja, die Gierlinge haben Koepfe. Und auf jedem Kopf sitzt ein runder "
	"Hut, unter dem leuchtend rote Haare hervorluken.");
  AddDetail( ({ "haare" }),
    "Die leuchtend roten Haare wurden aus Cupriten hergestellt. Du kannst "
	"sogar einzelne Straehnen erkennen.");
  AddDetail( ({ "straehnen", "haarstraehnen" }),
    "Die einzelnen Cuprite sind so fein gespalten, dass sie wie echte "
	"Haarstraehnen wirken. So viel Aufwand, fuer so ein unwichtiges Detail. "
	"Du bist erstaunt.");
  AddDetail( ({ "detail" }),
    "Ja, ja, die Details, nur darauf kommt es manchmal an.");
  AddDetail( ({ "aufwand" }),
    "Der Aufwand, dieses Bild herzustellen, muss enorm gewesen sein. An die "
	"Kosten willst Du gar nicht erst denken.");
  AddSpecialDetail( ({ "kosten" }),"kostendenker");
  AddDetail( ({ "tisch" }),
    "Ein feingearbeiteter, hoelzerner Tisch.");
  AddDetail( ({ "hocker" }),
    "Von den Hockern siehst Du nicht viel, sie werden groesstenteils von "
	"den Gierlingen, die darauf sitzen, verdeckt.");
  AddDetail( ({ "brett" }),
    "Das Brett hat ein aufwendiges Muster, ausserdem liegen einige Steine "
	"darauf.");
  AddDetail( ({ "muster" }),
    "Das Muster besteht auf symmetrischen Formen und Linien.");
  AddDetail( ({ "formen","linien" }),
    "Was die wohl zu bedeuten haben?");
  AddDetail( ({ "steine" }),
    "Du vermutest, dass es sich bei den Steinen um Diamanten handelt, die "
	"hier als Spielsteine eingesetzt sind. Sie wurden fein bearbeitet und "
	"sind ganz glatt geschliffen. Welch Dekadenz, mit Diamanten ein "
	"Brettspiel zu spielen.");
  AddDetail( ({ "spielsteine" }),
    "Was fuer ein Spiel das wohl sein mag?");
  AddDetail( ({ "spiel" }),
    "Wie koenntest Du das bloss rausfinden?");
  AddDetail( ({ "brettspiel" }),
    "Zumindest vermutest Du das.");
  AddDetail( ({ "dekadenz" }),
    "Die Gierlinge scheinen sehr wohlhabend zu sein, wenn sie sich so etwas "
	"leisten koennen.");
  AddDetail( ({ "kopf" }),
    "Pass auf, dass Du Deinen nicht verlierst.");
  AddDetail( ({ "sueden" }),
    "Suedlich von Dir ist eine Kreuzung.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");



  AddDetail( ({ "hoehlenraum" }),
    "Der Hoehlenraum im Nordwesten leuchtet gelblich. Ueber dem Eingang "
	"wurde ein Schild angebracht");
  AddDetail( ({ "schild", "eingang" }),
    "Du kannst das Schild dort lesen.");
  AddDetail( ({ "post" }),
  "In der Post kannst Du mailen und deine Briefe lesen.");
  AddDetail( ({ "briefe" }),
    "Geh doch rein und schau, ob Dir jemand geschrieben hat. Oder vielleicht "
	"schreibst Du jemandem? Das waere doch nett.");

    
  AddReadDetail( ({ "schild" }),
    "Post");
  AddDetail( ({ "" }),
    "");
 
  AddExit( "norden", GIER_ROOM + "gierlinge_1c.lpc" );
  AddExit( "nordwesten", GIER_ROOM + "gierlinge_1b.lpc" );  
  AddExit( "sueden", GIER_ROOM + "gierlinge_3c.lpc");

  

}

void kostendenker()
{
  if(TP->InFight())
  write("Dazu hast Du gerade keine Zeit, beende erst Deinen Kampf.\n");
  else
 TP->SetProp(P_PARALYZED,([PARALYZE_TIME:5, 
			PARALYZE_MSG:"Du denkst doch gerade an Kosten.\n",
			PARALYZE_MSG_OTHER: TP->name()+" denkt intensiv ueber Kosten nach.\n", 
			PARALYZE_END: "Du findenst, dass Du nun genug ueber Kosten nachgedacht hast.\n", 
			PARALYZE_END_OTHER:TP->name()+" hat genug nachgedacht.\n"]));

}