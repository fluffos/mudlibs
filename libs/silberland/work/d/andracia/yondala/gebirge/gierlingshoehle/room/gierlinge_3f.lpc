//Eine Kneipe
#include <properties.h>
//#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
#include "../def.h"

inherit "std/pub";


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im goldenen Humpen." );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Kneipe. Sie ist spaerlich, aber "
    "edel eingerichtet, zudem sehr sauber. Es gibt einige Tische mit "
	"Stuehlen, man kann aber auch am Tresen etwas bestellen. Heute sind "
	"kaum Gaeste da. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "PRUDI");
  SetProp( P_PUBKEEPER_NAME, "Der Wirt Prudi");
  SetProp( P_PUBKEEPER_GENDER, MALE);
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
     AddDetail( ({ "koboldkneipe", "kneipe", "gierlinge" }),
    "Du befindest Dich in einer kleinen Kneipe.");
  AddItem(GIER_NPC + "gierling_prudi.lpc",REFRESH_DESTRUCT);
 
  AddDetail( ({ "gierlinge" }),
    "Einige aeltere Gierlinge sitzen in einer Ecke und sikutieren angeregt "
	"miteinander, andere sitzen an Tischen an den Tischen verteilt und  "
    "speisen oder unterhalten sich.");  
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");

  AddDetail( ({ "tresen" }),
    "Der Tresen besteht aus Mahagoni und sieht sehr edel aus. Er ist "
	"sauber und jedes Getraenk steht auf einem frischen Untersetzer. Eine "
	"Speisekarte liegt gleich rechts neben Dir. Neben dem Tresen steht "
	"ein gierlingischer Floetenspieler.");
//  AddDetail( ({ "tatti", "tochter" }),
//    "Die ist grad nicht da.");
  AddDetail( ({ "uebersicht", "speisekarte" }),
    "Die Speisekarte ist in Samt eingeschlagen. Mit <menue> kannst Du sie "
	"lesen.");
  AddDetail( ({ "samt" }),
    "Der Samt sieht neu aus, kein bisschen verschlissen oder abgegriffen.");

  AddDetail( ({ "tische", "tisch", "tischen" }),
    "Man kann an den Tischen Platz nehmen.");
  AddDetail( ({ "stuhl", "stuehle", "stuehlen" }),
    "Einige Stuehle sind besetzt, auf die leeren Stuehle koennte man sich setzen.");
  AddDetail( ({ "platz" }),
    "Platz ist hier genug, schau Dich mal um.");
  AddDetail( ({ "decke" }),
    "Die Decke ist erstaunlich hoch. Und, obwohl unnoetig, hier haengt "
	"ein kleiner Kronleuchter.");
  AddDetail( ({ "kronleuchter" }),
    "Der Kronleuchter ist mit vielen kleinen Kerzen bestueckt.");
  AddDetail( ({ "kerzen" }),
    "Die Kerzen verbreiten ein flackerndes Licht.");
  AddDetail( ({ "optik" }),
    "Sieht doch auch nicht schlecht aus, oder?");
  AddDetail( ({ "gaeste", "gast" }),
    "Wenn Du hier etwas bestellst, dann bist auch Du ein Gast.");
  AddDetail( ({ "getraenk" }),
    "Vielleicht bestellst Du Dir auch eines?");
  AddDetail( ({ "untersetzer" }),
    "Die Untersetzer sehen aus, als waeren sie selbst gehaekelt worden.");
  AddDetail( ({ "mahagoni" }),
    "Ein sehr edles und teures Holz.");
  AddDetail( ({ "holz" }),
    "Nicht jeder kann sich si gutes Holz leisten.");
  AddDetail( ({ "hoehle" }),
    "Wenn Du Dich so umsiehst kannst Du kaum glauben, dass Du Dich in einer "
	"Hoehle befindest. Die Waende, die Decke und auch der Boden sind sehr "
	"gerade. Alles was hier fehlt ist ein Fenster.");
  AddDetail( ({ "fenster" }),
    "Sowas siehst Du nicht, denn Du bist in einer Hoehle.");
  AddDetail( ({ "elfen" }),
    "Jeder muss fuer sich selbst entscheiden, was er glaubt.");
  AddDetail( ({ "floetenspieler" }),
    "Der Floetenspieler spielt ganz ausgezeichnet auf seiner Floete, die "
	"schnellen Melodien stimmen Dich froh.");
  AddDetail( ({ "floete" }),
    "Die kleine Floete scheint vollstaendig aus Silber zu bestehen.");
  AddDetail( ({ "silber" }),
    "Es ist sicher sehr schwierig, so eine Floete herzustellen.");
  AddDetail( ({ "melodien" }),
    "Du lauscht ihnen verzueckt.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine sind wild auf die Waende versprenkelt, ohne erkennbares "
	"Muster.");
  AddDetail( ({ "muster" }),
    "Nunja, sie sind irgendwie symmetrisch, aber das ist auch das einzige "
	"Muster, das Du erkennen kannst.");
  AddDetail( ({ "ecke" }),
    "Die aelteren Gierlinge scheinen dort immer zu sitzen, es ist ihr "
	"Stammplatz.");
  AddDetail( ({ "stammplatz" }),
    "Da Du nicht so oft hier einkehrst hast Du auch keinen Stammplatz.");
  AddDetail( ({ "" }),
    "");


  AddSound( ({ "musik", "bestes","besten" }),
    "Die aberwitzigsten und rasantesten Melodien werden hier zum Besten gegeben.");

  AddSound( DEFAULT_SOUND,
    "Um Dich herum ist es recht laut. Es wird musiziert, an den "
    "Tischen unterhalten sich Gaeste, am Tresen diskutieren zwei angetrunkene "
    "Gierlinge lautstark.");

  AddSound( ({ "melodien" }),
    "Leider sind die Dir nicht bekannt, aber sie gefallen Dir.");
  AddSound( ({ "gaeste" }),
    "Die Gaeste unterhalten sich miteinander, Du kannst aber nichts verstehen.");
  AddSound( ({ "gierlinge", "gruppe" }),
    "Die zwei angetrunkenen Gierlinge diskutieren darueber, ob Elfen nun schwul sind oder nicht.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach den angebotenen Speisen und Getraenken.");

  AddSmell( ({ "speisen" }),
    "Du riechst Gebratenes und Gebackenes.");
  AddSmell( ({ "gebratenes","gebackenes" }),
    "Es riecht fremdartig, aber irgendwie koestlich, Du solltest unbedingt "
	"etwas bestellen.");
  AddSmell( ({ "getraenke" }),
    "Es riecht nach schwerem Wein und erfrischendem Bier.");
  AddSmell( ({ "wein" }),
    "Der Wein riecht suesslich und schmeckt bestimmt sehr gut.");
  AddSmell( ({ "bier" }),
    "Du kannst foermlich riechen, wie es Dir kuehlend den Rachen herunter "
	"perlt. Das koenntest Du nun echt gebrauchen.");
  AddSmell( ({ "rachen" }),
    "Die vorstellung, an Deinem eigenen Rachen riechen zu wollen, kommt Dir "
	"grad nicht irgendwie merkwuerdig vor, oder?");
  AddSmell( ({ "vorstellung" }),
    "War irgendwie klar.");

  AddRoomMessage( 
    ({""}),30,"func");

  AddDrink("selbstgereinigtes Wasser", ({ "wasser"}),200,50,0,8, //Preis, Lebenspunkte, Alkoholwert, Saettigungswert 
  ({ "Prudi schiebt Dir einen Krug herlich kuehlen Wasser zu.\nDu trinkst ihn auf der Stelle leer.",
       "&& trinkt einen Krug frisches Wasser."
   }) );  
    AddDrink("Glueckskleenektar", ({ "glueckskleenektar", "nektar" }),500,50,0,20,
  ({ "Prudi schenkt Dir einen Kelch Wein ein.\nDu laesst den Wein langsam Deine Kehle hinabfliessen.",
       "&& ext ein Bier."
   }) );  
   AddDrink("Goldbier", ({ "bier", "goldbier" }),200,20,1,8, //Preis, Volumen, Alk
  ({ "Prudi zapft Dir ein kuehles Blondes.\nDu trinkst das Bier auf ex.",
       "&& ext ein Bier."
   }) );

   AddDrink("Goldwein", ({ "wein", "goldwein" }),343,25,1,8, //Preis, Volumen, Alk
  ({ "Prudi schenkt Dir einen Kelch Wein ein.\nDu laesst den Wein langsam Deine Kehle hinabfliessen.",
       "&& geniesst einen goldenen Wein."
   }) );




  AddFood( "Bratwurm", ({ "bratwurm", "wurm" }), 160,20,10, //Preis, Lebenspunkte, Saettigung
    ({ "Prudi serviert Dir einen knusprig gebratenen Wurm. ",
       "&& bekommt einen knusprig gebratenen Wurm serviert. "
            }) );    

  AddFood( "Gubblbein", ({ "gubblbein", "bein" }),300,35,15, //Preis, Lebenspunkte, Saettigung
            ({ "Prudi sagt: Bitte schoen, habe ich selbst erlegt! ",
               "&& vernascht ein Gubblbein. "
            }) );   
  AddFood( "Wolbhintern", ({ "wolbhintern", "hintern" }),400,42,18, //Preis, Lebenspunkte, Saettigung
            ({ "Prudi serviert Dir einen knackigen Wolbhintern. ",
               "&& knackt einen Wolbhintern. "
            }) );   
  AddFood( "Krebilnacken", ({ "krebilnacken", "nacken" }),500,53,20, //Preis, Lebenspunkte, Saettigung
            ({ "Prudi stellt einen deftigen Krebilnacken vor Dich hin. Du verspeist ihn sofort! ",
               "&& isst einen deftigen Krebilnacken. "
            }) );   


// statt Lebenspunkte: ({5,0}) gibt dann 5 LP und 0 MP
 
 
 AddExit( "westen", GIER_ROOM + "gierlinge_3e.lpc" );


}

