// fertig

//Bild an der Wand: Ein Schmied
// Ueberarbeitet am 29.8.2011
// Yondala@Silberland
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle.  Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Du befindest Dich "
	"auf einer Kreuzung. Du kannst nach Norden, Westen und Nordwesten gehen." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(GIER_NPC + "gierling_stina.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "sueden" }),
    "Im Sueden gabelt sich der Weg zu einer Y-Kreuzung.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nach Nordwesten, Norden und Sueden gehen.");
  AddDetail( ({ "kreuzung" }),
    "Die Kreuzung, auf der Du gerade stehst sieht aus wie ein Pfeil. Die "
	"Kreuzung noerdlich von Dir sieht eher aus wie ein \"Y\".");

  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten ist ein etwas groesserer Hoehlenraum.");

  AddDetail( ({ "y" }),
    "Ein \"Y\", weisst schon.");
  AddDetail( ({ "pfeil" }),
    "Ein ->");
  AddDetail( ({ "westen" }),
    "Im Westen ist eine Sackgasse.");
  AddDetail( ({ "sackgasse" }),
    "Das bedeutet, dass der Gang dort offensichtlich endet.");


	
  AddDetail( ({ "weg" }),
    "Der Gang ist hier der Weg.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen ergeben ein Bild.");
  AddDetail( ({ "bild" }),
    "Das Bild stellt einen Gierling dar, der mit einem riesigen Hammer auf "
	"ein Stueckchen gluehendes Metall einschlaegt.");

  AddDetail( ({ "gierling","gierling in bild","gierlingsschmied" }),
    "Der dargestellte Gierling traegt eine dunkle Schuerze und eine Brille, "
	"sein Gesicht ist vor Anstrengung und Hitze geroetet. Er sieht aus, wie "
	"ein Schmied.");
  AddDetail( ({ "schuerze" }),
    "Die dunkle Schuerze des Gierlings hat ein ledriges Muster. Sie wurde "
	"aus Tigeraugen und Achaten hergestellt.");
  AddDetail( ({ "muster" }),
    "Die Tigeraugen und Achate sind so ineinander gewirkt, dass der "
	"Eindruck entsteht, die Schuerze bestende aus echtem Leder.");
  AddDetail( ({ "leder" }),
    "Wirklich, es sieht aus wie echtes Leder. Ist aber keins. Sind "
	"Tigeraugen und Achate.");
  AddDetail( ({ "eindruck" }),
    "Erstaunlich, wie realistisch das Bild doch ist.");
  AddDetail( ({ "brille", "schutzbrille" }),
    "Die Brille schuetzt die Augen des Gierlings vor Funken, die spruehen, "
	"wenn er mit dem Hammer auf das Metall schlaegt.");
  AddDetail( ({ "metall" }),
    "Was fuer ein Metall es ist kannst Du nicht sagen, hier ist es als "
	"gluehende formlose Masse dargestellt, die auf einem Amboss liegt.");
  AddDetail( ({ "masse" }),
    "Citrine und Oktarine wurden hier zu einer scheinbar gluehenden Masse "
	"zusammengefuegt.");
  AddDetail( ({ "augen" }),
    "In Diaspore eingefasste Jadeite ergeben die wunderbar funkelnden "
	"Augen des arbeitenden Gierlings.");
  AddDetail( ({ "funken" }),
    "Kleine Splitter aus Citrinen und Oktarinen verteilen sich auf dem Bild. "
	"rund um das Metall sind sie am konzentriertesten.");
  AddDetail( ({ "splitter" }),
    "Die Splitter stellen funken dar, die bei beim Schmieden entstehen.");
  AddDetail( ({ "schmieden" }),
    "Auf dem Bild siehst Du einen Schmied bei seiner Arbeit.");
  AddDetail( ({ "arbeit" }),
    "Ih, Arbeit. Gut, dass Du gerade nicht arbeiten muss, nicht wahr?");
  AddDetail( ({ "anstrengung" }),
    "Vor Anstrengung fliessen dem Gierling kleine diamantene Schweissperlen "
	"die Wangen herunter.");
  AddDetail( ({ "wangen" }),
    "Die Wangen, die eigentlich aus Rosenquarzen bestehen sind mit Jaspisen "
	"durchsetzt wodurch sie deutlich geroetet sind.");
  AddDetail( ({ "schmied" }),
    "Der Gierling ist ein Schmied bei der Arbeit. Im Hintergrund kannst Du "
	"sogar eine angedeutete Werkstatt erkennen.");
  AddDetail( ({ "hintergrund" }),
    "Hinter dem dargestellten Schmied siehst Du eine aus Edelsteinen "
	"dargestelle Werkstatt.");
  AddDetail( ({ "werkstatt" }),
    "Hinter dem Schmied sind Regale mit Werkzeugen und andere Gegenstaende, "
	"die man in einer Schmiede findet, abgebildet.");
  AddDetail( ({ "regale" }),
    "Hinter dem Schmied sind einige hoelzerne Regale in die Wand eingelassen.");
  AddDetail( ({ "werkzeuge", "werkzeug" }),
    "Unterschiedliche Werkzeuge sind in den Regalen angedeutet, sie sind "
	"jedoch nicht so fein gearbeitet wie der Schmied im Vordergrund.");
  AddDetail( ({ "vordergrund" }),
    "Im Vordergrund des Bildes steht ein kleiner Schmied, der mit einem "
	"Hammer auf gluehendes Metall einschlaegt.");
  AddDetail( ({ "amboss" }),
    "Der aus einem einzigen gigantischen Onyx gearbeitete Amboss sieht "
	"fest aus, er ist mit dem Bildboden verbunden und reicht dem Schmied bis "
	"zur Huefte.");
  AddDetail( ({ "huefte" }),
    "Der Amboss reicht dem Gierling bis zur Huefte, es ist also ein "
	"durchschnittlich sehr kleiner Amboss.");
  AddDetail( ({ "gesicht" }),
    "Das Gesicht wird von einer grossen Schutzbrille dominiert, die "
	"rosanen Wangen sind leicht geroetet, die Lippen zu einem Strich "
	"zusammengepresst.");
  AddDetail( ({ "lippen" }),
    "Vor Anstrengung sehen die Lippen des Gierlings aus wie ein Strich.");
  AddDetail( ({ "strich" }),
    "Eine duenne Linie.");
  AddDetail( ({ "linie" }),
    "__________");
  AddDetail( ({ "gegenstaende" }),
    "Das Meiste davon ist nur unscharf angedeutet. Du erkennst einiges an "
	"Werkzeug und hinten rechts ist sogar ein Feuer.");
  AddDetail( ({ "feuer" }),
    "Das Feuer ist so realistisch dargestellt, dass Du meinst, seine "
	"Hitze wirklich spueren zu koennen.");
  AddDetail( ({ "hitze" }),
    "Du meinst, die Hitze wirklich spueren zu koennen.");
  AddDetail( ({ "schweisperlen" }),
    "Die Schweisperlen funkeln wie kleine Diamanten.");
  AddDetail( ({ "hammer" }),
    "Der Hammer besteht aus einem grossen Oktarin an einem hoelzernen Stiel.");
  AddDetail( ({ "stiel" }),
    "Der Gierling haelt den Stiel des Hammers fest in seinen Haenden.");
  AddDetail( ({ "haende" }),
    "Die Haende des Gierlings sind kraeftig.");
  AddDetail( ({ "meiste","meistes" }),
    "Fast alles.");
  AddDetail( ({ "stueckchen" }),
    "Ein nicht allzu grosses Stueckchen halt.");
  AddDetail( ({ "bildboden" }),
    "Der Boden des Bildes sieht aus, wie der Boden auf dem Du stehst.");




  AddDetail( ({ "hoehlenraum" }),
    "Ueber dem Hoehlenraum im Nordwesten ist ein goldenes Schild angebracht.");
  AddDetail( ({ "schmiede" }),
    "Die Schmiede befindet sich nordwestlich von Dir.");
  AddDetail( ({ "schild" }),
    "Das Schild ueber dem Hoehlenraum scheint aus puren Gold zu bestehen.");
  AddDetail( ({ "gold", "deines" }),
    "Gold ist in dieser Hoehle sehr begehrt. Achte gut auf Deines.");
  AddReadDetail( ({ "schild" }),
    "************"+
    "* Schmiede *"+
    "************");
    

  
  


  AddSound( DEFAULT_SOUND,
    "Aus dem Nordwesten hoerst Du lautes Haemmern.");

  AddSound( ({ "haemmern" }),
    "Hoert sich an, als wuerde dort hart gearbeitet.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ein bisschen verbrannt.");

  AddSmell( ({ "" }),
    "");

 
  AddExit( "norden", GIER_ROOM + "gierlinge_2c.lpc" );
  AddExit( "westen", GIER_ROOM + "gierlinge_3b.lpc" );  
  AddExit( "nordwesten", GIER_ROOM + "gierlinge_2b.lpc" );  
  

}


