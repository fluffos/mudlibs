//Normalo Iris sitzt in Raum 1c

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Iris Gierlingsfrau");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist Iris, sie ist eine Gierlingsfrau. Sie hat lange rote Haare, die ihr wirr vom Kopf "
    "abstehen. Um ihre Nase tummeln sich unzaehlige Sommersprossen. Sie traegt ein schickes "
    "Kleid und braune Lederschuhe. Iris ist guter Dinge und pfeift ein Lied. "
    "Sie ist normal gross fuer einen Gierling. An ihrem Guertel haengt ein Goldsaeckchen");//Langbeschreibung vom GIER_NPC wenn man ihn untersucht
  SetProp(P_NAME, "Iris");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"iris", "winzling", "die kleine", "gierlingsfrau"}));
  SUID;
  CLONEME(GIER_ARMOUR + "kobold_kleid.lpc");
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  command("trage alles");

  
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  
  SetProp(P_SIZE, 65);
  SetProp(P_WEIGHT, 13500);
  SetProp(P_ALIGN, -20);


  SetProp(P_KILL_NAME, "Iris die Gierlingsfrau");
  AddDetail( ({ "haare", "haar" }),
    "Ihre Haare sind rot.");
  AddDetail( ({ "nase", "sommersprossen" }),
    "Die Nase von Iris ist voller Sommersprossen");
  AddDetail( ({ "kleid", "schuhe", "lederschuhe" }),
    "Iris ist modisch gekleidet.");
}
