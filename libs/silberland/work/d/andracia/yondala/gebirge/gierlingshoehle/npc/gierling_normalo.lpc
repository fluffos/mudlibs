#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
int groesse;
string groessetext;

 
void create() {
  if (!is_clone(TO)) return;
  ::create();
 
  groesse=random(3);//0=klein, 1=durchschnittlich, 2=gross
  if(groesse==0) groessetext="klein";
  else if (groesse==1)groessetext="durchschnittlich";
  else groessetext="gross";
  SetProp(P_NAME_ADJ, groessetext);
  if(random(2))//Mann
{  
  SetProp(P_SHORT, "Ein "+groessetext+"er Gierling");
  SetProp(P_LONG,
    "Du siehst einen "+groessetext+"en Gierling vor Dir. Er traegt Beinlinge, "
	"eine "+groessetext+"e Toga und einen Schlapphut unter dem zottelige "
	"rote Haare hervorschauen. An seinen Fuessen stecken Lederschuhe. An "
	"seinem Guertel haengt ein Goldsaeckchen. Er ist ziemlich "
	+groessetext+" fuer einen Gierling. Zwischen seinen Lippen blitzen "
	"kleine scharfe Zaehne hervor. Aber beissen tut er nur selten...");
  SetProp(P_NAME, "Gierling");
  SetProp(P_GENDER, MALE);
SetProp (P_MNPC_DEFAULTROOM, ROOM+"gierlinge_3e");
SetProp (P_MNPC_AREA, ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
  AddDetail( ({ "haar", "haare" }),
    "Die Haare von des Gierlings sind rot und zottelig."); 
  AddDetail( ({ "zaehne" }),
    "Die Zaehne des Gierlings sind sehr scharf."); 
  AddDetail( ({ "lippen", "lippe" }),
    "Die Lippen des Gierlings sind duenn. Zwischen ihnen schauen scharfe "
	"Zaehne hervor."); 
  AddDetail( ({ "", "" }),
    ""); 
  AddId(({"gierling", "mann"}));
   SetProp(P_KILL_NAME, "Ein Gierling");
 create_default_npc(10); 
  } 

else
{  
  SetProp(P_SHORT, "Eine "+groessetext+"e Gierlingsfrau");
  SetProp(P_LONG,
    "Du siehst eine recht "+groessetext+"e Gierlingsfrau vor Dir. Auf den "
	"hellroten Haaren traegt sie einen Schlapphut, gewandet ist sie in "
	"einer Toga und ihre Fuesse stecken in "+groessetext+"en Lederschuhen. "
	"An ihrer Huefte haengt ein Goldsaeckchen. Die "+groessetext+"e "
	"Gierlingsfrau schaut Dich neugierig an.");
  SetProp(P_NAME, "Gierlingfrau");
  SetProp(P_GENDER, FEMALE);
SetProp (P_MNPC_DEFAULTROOM, ROOM+"gierlinge_3e");
SetProp (P_MNPC_AREA, ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
  AddDetail( ({ "haar", "haare" }),
    "Die hellen Haare der Gerilingsfrau sind ordentlich gebuerstet."); 
  AddDetail( ({ "", "" }),
    ""); 
  AddId(({"gierling", "frau", "gierlingfrau"})); 
   SetProp(P_KILL_NAME, "Eine Gierlingfrau");
  create_default_npc(8); 
  }
 

  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_schlapphut.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc");
  CLONEME(GIER_ARMOUR + "gierling_beinlinge.lpc");    
    
  command("trage alles");
  CLONEME(GIER_WEAPON + "gierling_dolch.lpc");
  command("zuecke dolch");


  SetProp(P_HANDS, ({" mit den Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_ARTICLE, 1);

  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat



}




