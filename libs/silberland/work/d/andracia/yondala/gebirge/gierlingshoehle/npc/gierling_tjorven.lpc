#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tjorven, das Gierlingsmaedchen");
  SetProp(P_LONG,
    "Das ist Tjorven, sie ist ein kleines Gierlingsmaedchen. Sie traegt ein gruenes Kleidchen "
    "und einen grossen gelben Hut. Ihre Fuesse sind barfuss und ziemlich schmutzig. "
    "Sie hat eine helle Haut und leuchtend orangene Haare. "
    "An ihrem Guertel haengt ein Goldsaeckchen. In Ihrer Haenden haelt sie ein "
    "Springseil. Tjorven laechelt dich an." );
  SetProp(P_NAME, "Tjorven");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"tjorven", "winzling", "gierlingskind", "kind", "maedchen", "gierlingsmaedchen"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihrem Springseil",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 45);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_ALIGN, 20);

  SetProp(P_WIMPY, 5);//wann er weg rennt (bei wieviel Lebenspunkten)

  SetProp(P_MSGIN, "huepft heran"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "geht");//verlassen wird
  SetProp(P_MMSGOUT, "stampft dreimal auf den Boden und ist weg");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_NOCORPSE, 1 );// bei 0 hat er ne Leiche.
  SetProp(P_MURDER_MSG, TPN+ " ist ein Kindermoerder!!!");// die meldung auf -mörder
  SetProp(P_KILL_NAME, "Tjorven das Gierlingmaedchen");//name des tötenden npc
  SetProp(P_KILL_MSG, "Ha, leg Dich NIE mit einem Maedchen an!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat

  AddInfo(DEFAULT_INFO, "sagt: das darf ich nicht sagen.\n");
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_kleidchen.lpc");
  command("trage alles");
  CLONEME(GIER_OBJ+ "springseil.lpc");

  AddInfo( ({"quest","abenteuer, hilfe"}), 
    "Das musst Du schon alleine schaffen.",
    "sagt: "); 
     
  AddInfo( ({"mutter","eltern", "mama"}), 
    "Meine Mama laeuft hier irgendwo rum.",
    "sagt: ");    
  AddInfo( ({"springseil","seil"}), 
    "Das ist meins!",
    "sagt: "); 
  SetChats(3, ({"Tjorven springt Seilchen.\n", }) );

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bohrt in der Nase und schmiert Dir einen Popel ans Knie.",
        "bohrt in der Nase und schmiert " +TPN+ " einen Popel ans Knie..");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist fuer sowas zu jung und schubst Dich weg.",
        "ist fuer sowas zu jung und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "strahlt Dich an.",
        "strahlt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "macht grosse Augen.",
        "macht grosse Augen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "weint.",
        "weint..");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
