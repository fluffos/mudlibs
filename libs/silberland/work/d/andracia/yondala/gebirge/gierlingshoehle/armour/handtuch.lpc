#include <moredef.h>
//"../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Handtuch");
  SetProp(P_LONG,
    "Ein schoenes, weisses Handtuch." );
  SetProp(P_NAME, "Handtuch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WORN_TEXT, "um den Koerper gewickelt");
  AddId( ({"handtuch"}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([ MAT_COTTON ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);


}
