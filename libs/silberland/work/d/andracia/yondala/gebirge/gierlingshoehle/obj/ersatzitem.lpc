//
#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>//fuer die Vision
#include <ansi.h>//fuer die Farben
object besitzer;
nosave int lastHP, lastSP, aktiv=0, farbe=0;
//string aktStr;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Ersatzitem");
  SetProp(P_LONG,
  "Dies ist ein Ersatzitem.\n"
  "Sobald Yondala dazu Zeit hat wird sie auch fuer Deine Rasse ein besseres machen, versprochen.");
  SetProp(P_NAME, "Item");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"item","ersatz", "ersatzitem"}) );

  SetProp(P_MATERIAL, ({MAT_COTTON, MAT_GOLD, MAT_MISC_MAGIC }));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  //SetProp(P_NODROP, "Ohne Dein Goldsaeckchen waerst Du nur ein halber Kobold.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({ "report"}), "report");


  lastHP = lastSP = -1;
}


int report(string str)
{
	notify_fail("report ein|aus|farbe\n");
	besitzer=environment();
	if(str=="ein")
		{
			aktiv=1;
			farbe=0;
			write("Der Report ist nun einfarbig eingeschaltet.\n");
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
			return 1;
		}
	if(str=="aus")
		{
			aktiv=0;
			write("Der Report ist nun ausgeschaltet.\n");
			besitzer->RemoveHpHook(ME);
			return 1;
		}	
	if(str=="farbe")
		{
			aktiv=1;
			farbe=1;
			write("Der Report ist nun mehrfarbig eingeschaltet.\n");
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
			return 1;
		}

  if(!str)
  	{
			tell_object(besitzer,"- LP: "+besitzer->QueryProp(P_HP)+" - MP: "+besitzer->QueryProp(P_SP)+" - ");
     //Status: Wenn Frosch, blind oder taub: Anzeige: krank, sonst: gesund
		if(besitzer->QueryProp(P_POISON)||
			 besitzer->QueryProp(P_DEAF)||
			 besitzer->QueryProp(P_BLIND)) tell_object(besitzer," krank - ");
                               else tell_object(besitzer,"gesund - ");
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,"gruen -");
                               else tell_object(besitzer, besitzer->QueryProp(P_HAIR_COLOR)+ " - ");

//Kann gesepellt werden? Ja/nein
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer," zaubern:ja\n");
    else tell_object(besitzer," zaubern: nein\n");
    return 1;
    }     
	return 0;}


NotifyHpChange()
{
	  int    hp, mhp, sp, msp;
	  if(!aktiv) return;

  // Sicherheits-Check
  if (!previous_object() || !besitzer || (besitzer != previous_object()))
    return;
if(besitzer!=environment()) return;

  // Test auf Geist
  if (besitzer->QueryProp(P_GHOST)) return;

  // aktuelle Werte ermitteln
  hp = besitzer->QueryProp(P_HP);
  mhp = besitzer->QueryProp(P_MAX_HP);
  sp = besitzer->QueryProp(P_SP);
  msp = besitzer->QueryProp(P_MAX_SP);


  // Test auf Tod
  if ((hp<=0) || (!living(besitzer)))
  {
    //tell_object(besitzer, "Dein Zweig des Lebens zerfaellt.\n");
    // TO-remove();
 			aktiv=0;
			besitzer->RemoveHpHook(ME);
  }

//Anzeige:
//LP:x(+-y) - MP:x(+-y) - gesund - Haarfarbe - zaubern: ja



if(!farbe)
	{//fuer den Fall, dass Frosch, weil dann ists unter null und springt dauernd hin und her
		if(lastHP==hp&&sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0) tell_object(besitzer,"");
		
		else
			{
		//Lebenspunkte anzeigen lassen (+-Aenderung)				
		if(lastHP>hp)
			{
				lastHP=lastHP-hp;
				tell_object(besitzer,"- LP: "+hp+"(-"+lastHP+") ");
			}
		else if(lastHP==hp)
				tell_object(besitzer,"- LP: "+hp+"(+-0) ");
		else
			{
				lastHP=hp-lastHP;
				tell_object(besitzer,"- LP: "+hp+"(+"+lastHP+") ");	
			}
					

//Magiepunkte(+-Aenderung
			if(sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0)
				tell_object(besitzer,"- MP: 0(+-0) ");
			else if(lastSP>sp)
			{
				lastSP=lastSP-sp;
				tell_object(besitzer,"- MP: "+sp+"(-"+lastSP+") ");
			}
		else if(lastSP==sp)
			{
				lastSP=sp-lastSP;
				tell_object(besitzer,"- MP: "+sp+"(+-0) ");			
			}
		else
			{
				lastSP=sp-lastSP;
				tell_object(besitzer,"- MP: "+sp+"(+"+lastSP+") ");			
			}
		
//		tell_object(besitzer,"- MP: "+sp+"("+sp-lastSP+") - ");

//Status: Wenn Frosch, blind oder taub: Anzeige: krank, sonst: gesund
		if(besitzer->QueryProp(P_POISON)||
			 besitzer->QueryProp(P_DEAF)||
			 besitzer->QueryProp(P_BLIND)) tell_object(besitzer," krank - ");
                               else tell_object(besitzer,"gesund - ");
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,"gruen -");
                               else tell_object(besitzer, besitzer->QueryProp(P_HAIR_COLOR)+ " - ");

//Kann gesepellt werden? Ja/nein
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer," zaubern:ja\n");
    else tell_object(besitzer," zaubern: nein\n");
    }
}

else//in Farbe
	{ //Farbe fuer Lebenspunkte
		if(lastHP==hp&&sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0) tell_object(besitzer,"");
		
		else
			{
				tell_object(besitzer,"-");
					{
						if(lastHP>hp)
			{
				lastHP=lastHP-hp;
		    if(hp*100/mhp<21)	tell_object(besitzer,ANSI_RED+" LP: "+hp+"(-"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<41)	tell_object(besitzer,ANSI_PURPLE+" LP: "+hp+"(-"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<61)	tell_object(besitzer,ANSI_BLUE+" LP: "+hp+"(-"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<81)	tell_object(besitzer,ANSI_CYAN+" LP: "+hp+"(-"+lastHP+") "+ANSI_NORMAL);
				else tell_object(besitzer,ANSI_GREEN+" LP: "+hp+"(-"+lastHP+") "+ANSI_NORMAL);				
			}
		else if(lastHP==hp)
			{
		         if(hp*100/mhp<21)	tell_object(besitzer,ANSI_RED+" LP: "+hp+"(+-0) "+ANSI_NORMAL);
				else if(hp*100/mhp<41)	tell_object(besitzer,ANSI_PURPLE+" LP: "+hp+"(+-0) "+ANSI_NORMAL);
				else if(hp*100/mhp<61)	tell_object(besitzer,ANSI_BLUE+" LP: "+hp+"(+-0)"+ANSI_NORMAL);
				else if(hp*100/mhp<81)	tell_object(besitzer,ANSI_CYAN+" LP: "+hp+"(+-0)"+ANSI_NORMAL);
				else                    tell_object(besitzer,ANSI_GREEN+" LP: "+hp+"(+-0)"+ANSI_NORMAL);		
				}		
		else
			{
				lastHP=hp-lastHP;
		    if(hp*100/mhp<21)	tell_object(besitzer,ANSI_RED+" LP: "+hp+"(+"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<41)	tell_object(besitzer,ANSI_PURPLE+" LP: "+hp+"(+"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<61)	tell_object(besitzer,ANSI_BLUE+" LP: "+hp+"(+"+lastHP+") "+ANSI_NORMAL);
				else if(hp*100/mhp<81)	tell_object(besitzer,ANSI_CYAN+" LP: "+hp+"(+"+lastHP+") "+ANSI_NORMAL);
				else tell_object(besitzer,ANSI_GREEN+" LP: "+hp+"(+"+lastHP+") "+ANSI_NORMAL);				
			}
		if(sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0)
				tell_object(besitzer,ANSI_RED+"- MP: 0(+-0) "+ANSI_NORMAL+" - ");
			
		else if(lastSP>sp)
			{
				lastSP=lastSP-sp;
				tell_object(besitzer,"-");
		    if(sp*100/msp<21)	tell_object(besitzer,ANSI_RED+" MP: "+sp+"(-"+lastSP+") "ANSI_NORMAL);
		    else if(sp*100/msp<41) tell_object(besitzer,ANSI_PURPLE+" MP: "+sp+"(-"+lastSP+") "+ANSI_NORMAL);
		    else if(sp*100/msp<61)	tell_object(besitzer,ANSI_BLUE+" MP: "+sp+"(-"+lastSP+") "+ANSI_NORMAL);
	    	else if(sp*100/msp<81)	tell_object(besitzer,ANSI_CYAN+" MP: "+sp+"(-"+lastSP+") "+ANSI_NORMAL);
		    else tell_object(besitzer,ANSI_GREEN+" MP: "+sp+"(-"+lastSP+") "+ANSI_NORMAL);

				
				tell_object(besitzer,"- MP: "+sp+"(-"+lastSP+") ");
			}
	else if(lastSP==sp)
			{
				tell_object(besitzer,"-");
		    if(sp*100/msp<21)	tell_object(besitzer,ANSI_RED+" MP: "+sp+"(+-0) "ANSI_NORMAL);
		    else if(sp*100/msp<41) tell_object(besitzer,ANSI_PURPLE+" MP: "+sp+"(+-0) "+ANSI_NORMAL);
		    else if(sp*100/msp<61)	tell_object(besitzer,ANSI_BLUE+" MP: "+sp+"(+-0) "+ANSI_NORMAL);
	    	else if(sp*100/msp<81)	tell_object(besitzer,ANSI_CYAN+" MP: "+sp+"(+-0) "+ANSI_NORMAL);
		    else tell_object(besitzer,ANSI_GREEN+" MP: "+sp+"(+-0) "+ANSI_NORMAL);
		    }
		else
			{
				lastSP=sp-lastSP;
				tell_object(besitzer,"-");
		    if(sp*100/msp<21)	tell_object(besitzer,ANSI_RED+" MP: "+sp+"(+"+lastSP+") "+ANSI_NORMAL);
		    else if(sp*100/msp<41) tell_object(besitzer,ANSI_PURPLE+" MP: "+sp+"(+"+lastSP+") "+ANSI_NORMAL);
		    else if(sp*100/msp<61)	tell_object(besitzer,ANSI_BLUE+" MP: "+sp+"(+"+lastSP+") "+ANSI_NORMAL);
	    	else if(sp*100/msp<81)	tell_object(besitzer,ANSI_CYAN+" MP: "+sp+"(+"+lastSP+") "+ANSI_NORMAL);
		    else tell_object(besitzer,ANSI_GREEN+" MP: "+sp+"(+"+lastSP+") "+ANSI_NORMAL);
			}
				tell_object(besitzer,"- ");		

		if(besitzer->QueryProp(P_POISON)||
			 besitzer->QueryProp(P_DEAF)||
			 besitzer->QueryProp(P_BLIND)) tell_object(besitzer,ANSI_RED+" krank"+ANSI_NORMAL);
    else tell_object(besitzer,"gesund");
		
		tell_object(besitzer," - ");    
		
		if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,ANSI_GREEN+"gruen"+ANSI_NORMAL);
    else tell_object(besitzer, besitzer->QueryProp(P_HAIR_COLOR));
		
		tell_object(besitzer," - ");    
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,"zaubern:ja\n");
    else tell_object(besitzer,ANSI_RED+"zaubern: nein\n"+ANSI_NORMAL);
    }
}
}
  // neue Werte merken
  lastHP = hp; 
  lastSP = sp;

}
