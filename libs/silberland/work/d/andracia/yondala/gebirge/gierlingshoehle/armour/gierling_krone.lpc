#include <moredef.h>

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine, goldene Krone");
  SetProp(P_LONG,
    "Du siehst eine wunderschoene, goldene Krone, deren Zacken mit kleinen, roten Rubinen besetzt sind." );
  SetProp(P_NAME, "Krone");
  SetProp(P_INFO, "Die Krone ist sehr fein und duenn gearbeitet. "
  "Du hast den Eindruck, dass man sie leicht zerbrechen koennte.");
  SetProp(P_GENDER, FEMALE);
  AddId( "krone" );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_DAM_PROTECTION, DT_MIND);
  SetProp(P_MATERIAL, ([ MAT_GOLD:95, MAT_MISC_JEWEL: 5]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 1000);
  AddDetail( ({ "zacken"}),
    "Die Zacken der Krone sind mit feingearbeiteten Rubinen besetzt."); 
  AddDetail( ({ "rubine", "rubin" }),
    "Leuchtend rote, makellose Rubine sitzen in der Krone."); 
  AddCmd( ({ "zerbrich","zerbrech","zerbreche" }), "zerbrechen" ); 	
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}

int zerbrechen(string str)
{
  if(str!="krone") return 0;
  write ("Du zerbrichst die kleine Krone in ihre Einzelteile.\n");
  say(TPN+" zerbricht eine kleine Krone in ihre Einzelteil.\n");
  "/obj/gemmaster"->DistributeGem(5,0,2,TP,({"rubin"}));
  CLONE("/p/std/skills/jewelry/obj/gold", TP); 
  CLONE("/p/std/skills/jewelry/obj/gold", TP); 
  remove();
  return 1;
  }
