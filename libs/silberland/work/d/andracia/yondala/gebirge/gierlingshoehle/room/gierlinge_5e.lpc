

#include "../def.h"
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>


void create() {
  ::create();
  SetProp(P_INT_SHORT,"Im Betorium");
   AddItem(GIER_NPC + "gierling_koenig.lpc",REFRESH_DESTRUCT);
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem grossen Hoehlenraum. Die Waende glitzern "
    "und funkeln wie tausend Sterne, auf dem Boden liegen Kissen aus "
	"Samt und Seide, in der Mitte des Raumes steht ein Altar aus purem "
	"Gold.");
  AddDetail( ({ "raum", "hoehlenraum" }),
    "Du befindest Dich in einem grossen Raum in einer glitzernden Hoehle.");    
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge wohnen in dieser Hoehle, Du bist sicher schon welchen "+
	"begegnet."); 
 AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"grossen Hoehlenraum unter der Erde.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine leuchten in allen erdenklichen Farben und mit einer "
	"Intensitaet, die nur mit Magie zu erklaeren ist.");
  AddDetail( ({ "stueck" }),
    "Ziemlich weit, den Ausgang kannst Du schon lang nicht mehr sehen kannst.");
  AddDetail( ({ "ausgang" }),
    "Den einzigen Ausgang, den Du hier siehst ist der, der Dich aus dem "
	"Hoehlenraum wieder nach zu dem Gang fuehrt, aus dem Du kommst.");
  AddDetail( ({ "gang" }),
    "Der Gang ist westlich von Dir.");     
  AddDetail( ({ "westen" }),
    "Nach Westen verlaesst Du den Hoehlenraum wieder.");     
  AddDetail( ({ "kissen" }),
    "Ueberall auf dem Boden liegen grosse, weiche Kissen verteilt, die, "
	"von schlichter Eleganz, dem Raum etwas von Waerme geben.");     
  AddDetail( ({ "eleganz" }),
    "Ohne Stickereien, ohne Schnoerkel, einfach schlicht, aber hochwertig "
	"liegen die Kissen auf dem Boden, bereit, sich darauf nieder zu lassen.");     
  AddDetail( ({ "stickereien","schnoerkel" }),
    "Die Kissen kommen ohne dergleichen aus.");     
  AddDetail( ({ "waerme" }),
    "Wenn auch glitzernd, so wirkt dieser Raum doch recht kuehl. Die "
	"Kissen mindern diesen Eindruck.");     
  AddDetail( ({ "eindruck" }),
    "Du hattest ein wenig den Eindruck, dass dieser Raum kuehl ist.");     
  AddDetail( ({ "mitte" }),
    "Genau in der Mitte des Raumes, also von allen Waenden gleich weit "
	"entfernt, steht ein Altar.");     
  AddDetail( ({ "samt","seide" }),
    "Samt und Seide der Kissen sind von hervoragender Qualitaet.");     
  AddDetail( ({ "qualitaet" }),
    "Du als Stoffkenner weisst, wovon Du redest.");     
  AddDetail( ({ "stoffkenner" }),
    "Zumindest kannst Du Samt von Seide unterscheiden, das ist doch schon "
	"mal was.");     
  AddDetail( ({ "sterne" }),
    "Wie unzaehlige Sterne funkelt es von den Waenden.");     
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben.");
  AddDetail( ({ "farben", "farbe" }),
    "Jede Edelsteinsorte leuchtet hier in einer anderen Farbe.");     
  AddDetail( ({ "edelsteinsorte" }),
    "Moechtest Du wirklich eine Edelsteinsortenaufzaehlung?");     
  AddDetail( ({ "edelsteinsortenaufzaehlung" }),
    "Rubin\n"+
    "Aquamarin\n"+
    "Topas\n"+
    "Smaragd\n"+
    "Saphir\n"+
    "Opal\n"+
    "Lapislazuli\n"+
    "Onyx\n"+
    "Bernstein\n"+
    "Granat\n"+
    "Bergkristall\n"+
    "Diamant\n"+
    "Amethyst\n"+
    "Zirkon\n"+
    "Turmalin\n"+
    "Tigerauge\n"+
    "Achat\n"+
    "Almandin\n"+
    "Apatit\n"+
    "Apophyllit\n"+
    "Aventurin\n"+
    "Benitoit\n"+
    "Citrin\n"+
    "Cuprit\n"+
    "Diaspor\n"+
    "Dioptas\n"+
    "Jadeit\n"+
    "Jaspis\n"+
    "Oktarin\n"+
    "Peridot\n"+
    "Pyrit\n"+
    "Rosenquarz\n"+
    "Sugilith\n"+
    "Tuerkis\n"+
    "Calcit\n"+
	"Die brauchst Du nicht alle untersuchen, ist kein Forscherpunkt, versprochen.");     
  AddDetail( ({ "altar" }),
    "Der Altar besteht aus purem Gold. An der oberen Kante sind Rubine in "
	"einer geraden Reihe eingefasst worden. Vor dem Altar ist eine Stufe.");     
  AddDetail( ({ "stufe" }),
    "Auf diese Stufe knien sich vermutlich die Gierlinge, wenn sie etwas "
	"auf dem Altar anbeten.");     
  AddDetail( ({ "kante" }),
    "Rings um die Oberseite des Altars ist eine Kante.");     
  AddDetail( ({ "reihe" }),
    "Ordentlich in einer Reihe, schnurgerade also, wurden unzaehlige Rubine "
	"in die Kante des Altars eingepasst.");     
  AddDetail( ({ "oberseite" }),
    "Die Oberseite des Altars ist blank poliert. Sie ist fast eben, bis "
	"auf eine leichte, kaum wahrnehmbare Woelbung nach oben.");     
  AddDetail( ({ "woelbung" }),
    "Die Woelbung ist kaum zu sehen, Du bist aber sicher, dass jede "
	"Fluessigkeit auf dem Altar zum Rand hin abfliessen wuerde.");     
  AddDetail( ({ "rand" }),
    "Praktischerweise sind am Rand schmale Rillen eingelassen, durch die "
	"eine eventuelle Fluessigkeit ablaufen koennte.");     
  AddDetail( ({ "rillen" }),
    "Durch die Rillen wird jede Fluessigkeit, die sich auf dem Altar "
	"ansammeln koennte, abfliessen.");     
  AddDetail( ({ "fluessigkeit" }),
    "Der Altar ist gerade blank poliert , Du siehst keine Fluessigkeit. "
	"Aber Du darfst Dir gerne vorstellen, welche Art von Fluessigkeit auf "
	"einem Altar vergossen werden koennte.");     
  AddDetail( ({ "art" }),
    "Mir wuerden da mehrere einfallen. Den Gierlingen sicher auch.");     
  AddDetail( ({ "forscherpunkt" }),
    "Aber das war vielleicht einer :o)");     
  AddDetail( ({ "" }),
    "");     
  AddDetail( ({ "" }),
    "");     

  AddExit("westen",GIER_ROOM + "gierlinge_5d" );
  AddCmd(({"stehe","steh"}), "aufstehen"), 
  AddCmd(({"knie"}),"knien");
}

int knien(string str)
{
  if(str!="auf stufe") return 0;
  if(present("gierlingkoenig",TO))
  {
    write("Gerade, als Du Dich hinknien willst, reisst Dich der "+
	      "Gierlingskoenig von der Stufe weg.\n"+
		  "Der Gierlingskoenig schleudert einen Blitz auf Dich.\n");
	TP->AddHp(-20);	  
	
    write("Der Gierlingskoenig kreischt: Das duerfen Unglaeubige nicht!\n");
    say(TPN+ " will sich gerade auf die Stufe knien, als "+TP->QueryPronoun(WER)+
	      " vom Gierlingskoenig an den Haaren weggerissen wird.\n"+
		  "Der Gierlingskoenig schleudert einen Blitz auf "+TPN+".\n"+
		  "Der Gierlingskoenig kreischt: Das duerfen Unglaeubige nicht!\n");
		  
     present("gierlingkoenig",TO)->Attack(TP);
	 return 1;
	 }
		  
  if(TP->QueryProp(P_NOMOVE)== "Du kniest gerade auf einer Stufe und musst erst aufstehen.\n")
	 {
	 write("Du kniest doch schon auf der Stufe.\n");
	 return 1;
	 }
  else if(TP->QueryProp(P_NOMOVE))
    {
	 write(TP->QueryProp(P_NOMOVE));
	 return 1;
	 }
  else
    {
     write("Du kniest Dich auf die Stufe.\n");
     say(TPN+" kniet sich auf die Stufe.\n");
	 TP->SetProp(P_NOMOVE, 
	      "Du kniest gerade auf einer Stufe und musst erst aufstehen.\n");
	 return 1;
	 }
}

int aufstehen(string str)
{
   notify_fail("Moechtest Du vielleicht aufstehen?\n");
    if (str!="von stufe auf"&&str!="auf")return 0;
  if(TP->QueryProp(P_NOMOVE)=="Du kniest gerade auf einer Stufe und musst erst aufstehen.\n")
	 {
	   write("Du stehst wieder auf.\n");
       say(TPN+" steht wieder auf.\n");
       TP->SetProp(P_NOMOVE, 0);
	   return 1;
	 }
  else 
    {
	 write("Du kniest doch gar nicht.\n");
	 return 1;
	 }
}