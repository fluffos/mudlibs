  AddDetail( ({ "geschmack", "geschmacksache", "geschmackssache" }),
    "Ueber Geschmack laesst sich nicht streiten.");
  AddDetail( ({ "titel", "schinken" }),
    "Vom Winde verweht.");
  AddReadDetail( ({ "titel", "schinken" }),
