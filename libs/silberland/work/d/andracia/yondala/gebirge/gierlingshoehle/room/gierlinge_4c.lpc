int cmdSingen(string str)

{ 
	object *rauminhalt;
	int i, zaehler;
	notify_fail("Was willst Du singen?\n");
	
	if(str=="lied"||str=="saeugling lied vor"||str=="saeugling ein lied vor")
	{
	  write("Es sollte schon ein Schlaflied sein.\n");
	  return 1;
	  }
	
	if(str=="schlaflied"||str=="saeugling schlaflied vor"||
	   str=="saeugling ein schlaflied vor")
		{
			if(TP->InFight())
			{ 
			   write("Waehrend Du kaempfst, kannst Du nicht singen.\n");
			   return 1;
			   }
			if (schlafend ==1) 
			{
			   write("Der Saeugling schlaeft doch schon.\n");
			   return 1;
			   }
			if(TP->QueryProp(P_NOMOVE)=="Waehrend Du singst, kannst Du nicht weggehen.\n")
			{
			   write("Du singst doch schon.\n");
			   return 1;
			   }
			   
			rauminhalt=all_inventory(TO);
			zaehler=sizeof(rauminhalt);
			if(zaehler>1)//wenn mehr als ein Spieler/Objekt im Raum ist
			{ 
			  //write("Mehrere da\n");
			   for(i=zaehler;i--;i>0)
			   {
			     write(rauminhalt[i]->name()+" is da\n");
			     if(rauminhalt[i]->QueryProp(P_NOMOVE)=="Waehrend Du singst, kannst Du nicht weggehen.\n")
				 { 
				    if(rauminhalt[i]!=TP)
					  write(rauminhalt[i]->name()+" singt bereit ein Lied, das sollte reichen.\n");
					else  
					  write("Du singst doch schon.\n");
					return 1;
					}
				}
			}
			
			write("Du raeusperst Dich und beginnst ein liebliches Lied zu singen.\n");
			say(TPN+" raeuspert sich und beginnt ein liebliches Lied zu singen.\n");
			call_out("singen2",3,0);
			TP->SetProp(P_NOMOVE,"Waehrend Du singst, kannst Du nicht weggehen.\n");
			return 1;
			}
		return 0;	
}




int cmdStibitzen(string str)

{ notify_fail("Was willst Du stibitzen?\n");
	if(str=="armband")
		{
			if (schlafend == 1)	
				{ if (da == 1)
					{
						CLONE(GIER_ARMOUR +"gierling_armband.lpc", TP);
						//this_player()->AddItem(GIER_ARMOUR+"kobold_armband.lpc");
						write("Du schleichst auf Zehenspitzen zum Weidenkoerbchen.\nDer Sauegling schlaeft tief und fest.\nVorsichtig stibitzt Du ihm das Armband.\n");
						say(TPN+" schleicht auf Zehenspitzen zum Weidenkoerbchen und stibitzt "
						"dem Saeugling das Armband.\n", TP);
						da = 0;
						AddDetail( ({ "saeugling","gierlingssaeugling" }),
    					"Ein kleiner Gierlingsaeugling, der tief und fest schlaeft.");
						RemoveDetail("armband");
						
						return 1;
					}
				else
					{
						write("Der Saeugling hat kein Armband.\n");
						return 1;
						}
				}
		else
			{		
				write("Du schleichst auf Zehenspitzen zum Weidenkoerbchen.\n"
				"Der Saeugling faengt an zu Quengeln.\nSo hat das keinen Sinn, Du "
				"ziehst Dich wieder zurueck und ueberlegst, wie man den Saeugling wohl "
				"beruhigen koennte.\n");
				say(TPN+" schleicht auf Zehenspitzen zum Weidenkoerbchen und kommt "
				"ganz schnell zurueck.\nDer Sauegling quengelt.\n", TP);}
				return 1;
			}
}



int cmdWechseln(string str)

{ notify_fail("Was willst Du wechseln?\n");
if(str=="windel"||str=="windeln")
{//hier soll ein Forscherpunkt rein
	if(windel)
	{
		write("Du schaust Dich um, siehst eine frische Windel herum liegen "+
		      "und wechselst geschickt die Windel des kleinen Gierlings.\n");
		say(TPN+" wurschtelt an etwas in dem Weidenkoerbchen herum.\n");

      AddDetail( ({ "windel" }),
       "Die wurde erst kuerzlich gewechselt, sie ist ganz frisch.");
//  AddDetail( ({ "zeiten" }),
//    "Ohja, es riecht tatsaechlich nach vollgeschissener Windel.");
       AddSmell( DEFAULT_SMELL,
         "Du kannst nichts Besonderes riechen.");
       RemoveSmell( ({ "geruch", "zeiten" }));
	   RemoveDetail("zeiten");
	   windel=0;
	  return 1;
    }
else
	{
		write("Das ist nicht noetig.\n");
		return 1;
		}
}
return 0;
}