  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Wimmern.");
  AddSound( ({ "wimmern" }),
    "Es scheint aus einer Ecke zu kommen.");
  AddSound( ({ "rascheln" }),
    "Hat sich da etwas bewegt?");
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nicht gut. Aber irgendwie kommt Dir der Geruch bekannt vor.");
  AddSmell( ({ "geruch" }),
    "Er errinnert Dich an vergangenen Zeiten.");


  //AddExit( "westen",GIER_ROOM + "gierlinge_4b.lpc" );

AddCmd(({"stecke","steck"}),"cmdStecken"); 
  AddCmd(({"wechsel", "wechsle"}),"cmdWechseln"); 
  AddCmd(({"singe", "sing"}),"cmdSingen"); 
  AddCmd(({"stibitze", "stibitz"}),"cmdStibitzen"); 
  AddCmd(({"nimm"}), "nehmenCmd");
}

int nehmenCmd(string str)
{ if(str =="armband")
	{
	  write ("So einfach nehmen kannst Du es nicht. Versuche es zu "+
	         "stibitzen.\n");
	  return 1;
	}
	return 0;
}
int cmdStecken(string str)
{ 
	string was;
	string worein;
	if( !str ) return 0;

	notify_fail("Was moechtest Du worein stecken?\n");
	sscanf(str, "%s in %s", was, worein);
	if(was!="klinke"&&was!="tuerklinke")
		return 0;
	if (worein != "loch") return 0;
 
	if(!present("klinke",TP))//Wenn der Spieler keine KLinke hat
	{ 
	   write("Du hast keine Klinke.\n");
	   return 1;
	   }
    if(find_call_out("tuer_zu")>=0)
	  {
        write("Die Geheimtuer ist doch schon auf.\n");
        return 1;
        }		
	   
   		write("Du steckst die Klinke in das Loch und drehst sie leicht.\n"+
		"Es oeffnet sich eine Geheimtuer.\n"+
		"Du nimmst die Klinke wieder an Dich.\n");
   		say( TPN + " oeffnet eine Geheimtuer.\n");
   		AddExit ( "westen", GIER_ROOM + "gierlinge_4b.lpc" );
		call_other(GIER_ROOM+"gierlinge_4b","tuer_auf");
		call_out("tuer_zu",5);
		return 1;
    			
}

void singen2(int i)
{
  string *liedchen;
  liedchen=({
  "Guten Abend, gut' Nacht",
"Mit Rosen bedacht",
"Mit Naeglein besteckt",
"Schluepf unter die Deck'",
"Morgen frueh, wenn Gott will",
"Wirst Du wieder geweckt",
"Morgen frueh, wenn Gott will",
"Wirst Du wieder geweckt",
"Guten Abend, gut' Nacht",
"Von Englein bewacht",
"Die zeigen im Traum",
"Dir Christkindleins Baum",
"Schlaf nun selig und sueß",
"Schau im Traum 's Paradies",
"Schlaf nun selig und sueß",
"Schau im Traum 's Paradies",
"Guten Abend, gut' Nacht",
"Mit Rosen bedacht",
"Mit Naeglein besteckt",
"Schluepf unter die Deck'",
"Morgen frueh, wenn Gott will",
"Wirst Du wieder geweckt",
"Morgen frueh, wenn Gott will",
"Wirst Du wieder geweckt"});
//write("i: "+i+"\n");
//write("liedchen: "+sizeof(liedchen)+"\n");

if(i<sizeof(liedchen))
{ 
  write("Du singst: "+liedchen[i]+"\n");
  say(TPN+" singt: "+liedchen[i]+"\n");
  i++;
  call_out("singen2",3,i);
  if(i==1)tell_room(TO,"Der Saeugling schaut neugierig.\n");
  if(i==10)tell_room(TO,"Der Saeugling laechelt.\n");
  if(i==19)tell_room(TO,"Langsam fallen dem Saugling die Aeuglein zu.\n");
  return;
  }
    tell_room(TO,"Der Saeugling schlaeft nun tief und fest.\n");
   schlafend = 1; 
   AddDetail( ({ "saeugling","gierlingssaeugling" }),
      "Ein kleiner Gierlingsaeugling, der tief und fest schlaeft. An seinem "
	  "Aermchen scheint etwas zu glitzern.");
   TP->SetProp(P_NOMOVE,0);
}   



