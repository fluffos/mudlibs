#include "../def.h"
#include <moredef.h>

inherit "std/room";

#include <properties.h>

int schlafend=0;
int da=1;
int windel=1;

void tuer_zu()
{
  tell_room(TO, "Die Wand im Westen faellt wieder zu.\n");
  RemoveExit("westen");
  }
void tuer_auf()
{
  tell_room(TO, "Die Wand im Westen schwingt auf.\n");
  AddExit( "westen",GIER_ROOM + "gierlinge_4b.lpc" );
  call_out("tuer_zu",4);
  }



void reset()
{::reset();
	if (schlafend)
	tell_room(TO,"Der Saeugling oeffnet die Augen.\n");
	if(!da)
	tell_room(TO,"Jemand steckt etwas in die Ecke und verschwindet wieder.\n");
	da=1;
	schlafend=0;
	windel=1; //voll
  AddDetail( ({ "windel" }),
    "Von wem auch immer, die muesste wohl mal gewechselt werden.");
  AddDetail( ({ "zeiten" }),
    "Ohja, es riecht tatsaechlich nach vollgeschissener Windel.");
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nicht gut. Aber irgendwie kommt Dir der Geruch bekannt vor.");
  AddSmell( ({ "geruch" }),
    "Er errinnert Dich an vergangenen Zeiten.");
  AddDetail( ({ "saeugling","gierlingssaeugling" }),
    "Ein kleiner Gierlingssaeugling, der Dich mit grossen Augen ansieht. "
	"An seinem Aermchen scheint etwas zu glitzern.");

}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Schlafzimmer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem Schlafzimmer. Die Gierlinge, die hier "
	"leben wurden schon zu oft ueberfallen, um sich noch sicher zu fuehlen. "
	"Deswegen haben sie sich diesen versteckten Raum angelegt, damit sie "
    "nachts in Ruhe schlafen koennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//****************************
// Dies ist der Babyraum
// Quest Finale
//*****************************
  AddDetail( ({ "gierlinge" }),
    "Die wohnen hier, Du kannst aber keinen sehen.");  
  AddDetail( ({ "raum", "schlafzimmer", "gierlingschlafzimmer" }),
    "Du befindest Dich in einem versteckten Gierlingschlafzimmer.");
  AddDetail( ({ "decke", "boden" }),
    "Die Decke und der Boden wurden in den Fels gehauen.");




  AddDetail( ({ "waende", "wand" }),
    "Das Schlafzimmer hat 1, 2, 3, 4 Waende die im rechten Winkel zueinander "
	"stehen. Drei der Waende wurden in den Stein gehauen, sie leuchten, "
	"wie auch die Waende draussen es tun.");

  AddDetail( ({ "maserung" }),
    "Du betrachtest die feine Maserung, dabei faellt Dir ein kleines Loch auf.");
  AddDetail( ({ "loch" }),
    "Ein Loch in einer Holzwand. Sieht aus, als wuerde hier eine Tuerklinke "
	"fehlen. Man koennte vielleicht hindurchgucken...");
  AddDetail( ({ "holzwand" }),
    "Hm, seltsam, normalerweise sind die Waende hier doch alle aus Fels... "
    "Diese Wand jedoch besteht komplett aus Holz. Sie hat eine schoene Maserung.");
  AddDetail( ({ "maserung" }),
    "Dir faellt ein kleines Loch auf.");
  AddDetail( ({ "loch" }),
    "Durch dieses Loch siehst Du den Raum, aus dem Du kamst. Auch hier "
	"musst Du wohl eine Tuerklinke einsetzen, um die Tuer oeffnen zu koennen");
  AddDetail( ({ "wand 1", "wand2", "westwand", "wand im westen" }),
    "Eine Holzwand.");
  AddDetail( ({ "wand 2", "wand2", "nordwand", "wand im norden", "wand 4", "wand4", "suedwand", "wand im sueden" }),
    "Eine Felswand.");
  AddDetail( ({ "wand 3", "wand3", "ostwand", "wand im osten" }),
    "Eine Felswand.");
  AddDetail( ({"wand 4", "wand4", "suedwand", "wand im sueden"   }),
    "Eine Felswand.");
  AddDetail( ({"winkel" }),
    "Ja, je zwei Waende bilden einen Winkel, auch als \"Ecke\" bezeichnet.");   
  AddDetail( ({"ecken", "ecke" }),
    "Es gibt hier vier Ecken, welche meinst Du?");   
  AddDetail( ({ "ecke 1", "ecke1" }),
    "In dieser Ecke haengt ein Wandteppich.");
  AddDetail( ({ "teppich", "wandteppich" }),
    "Der war sicher teuer.");
  AddDetail( ({ "ecke 2", "ecke2" }),
    "In dieser Ecke steht ein grosses Doppelbett an der Wand.");
  AddDetail( ({ "bett", "doppelbett" }),
    "Das Bett ist ordentlich gemacht. Vor dem Bett steht ein Nachttisch.");
  AddDetail( ({ "nachtisch", "feines" }),
    "Ja, Nachtisch ist auch was Feines, aber Du meinst sicher NachTTisch, oder?");
  AddDetail( ({ "nachttisch"}) ,
    "Auf dem Nachttisch liegen ein Buch und eine Lesebrille.");  
  AddDetail( ({ "buch" }),
    "Du koenntest den Titel lesen, wenn es Dich interessiert.");
  AddDetail( ({ "lesebrille", "brille" }),
