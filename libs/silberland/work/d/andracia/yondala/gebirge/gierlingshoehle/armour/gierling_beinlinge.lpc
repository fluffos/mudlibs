#include "../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>

string farb;
int farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
farbe = random(6);
switch(farbe)
{	case 1: {      
   farb="rot";
   SetProp(P_SHORT, "Rote Beinlinge");
   break;}
  case 2: {      
   farb="gelb";
   SetProp(P_SHORT, "Gelbe Beinlinge");
	break;}
	case 3: {      
   farb="gruen";
   SetProp(P_SHORT, "Gruene Beinlinge");
	break;}
	case 4: {      
   farb= "blau";
   SetProp(P_SHORT, "Blaue Beinlinge");
	break;}
	case 5: {      
   farb="braun";
   SetProp(P_SHORT, "Braune Beinlinge");
	break;}
	default: {
  farb="schwarz";
  SetProp(P_SHORT, "Schwarze Beinlinge");
  }
}
 SetProp(P_NAME_ADJ, farb);

  SetProp(P_LONG,
    "Du siehst ein kleines Paar Beinlinge vor Dir, sie sind "+farb+"." );
  SetProp(P_NAME, "Beinlinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"beinlinge", "hose", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 130);
  SetProp(P_QUALITY_DECAY, 100);

}