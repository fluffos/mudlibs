//Mels versteckter Raum hinter der Post
#include <moredef.h>
#include "../def.h"
inherit "std/room";
#include <properties.h>

int gulli_status =0;
int moertel=1;//ob man Moertel rauspulen kann. 1=ja
void reset()
{::reset();
	gulli_status=0;
	moertel=1;
	//RemoveDetail("loch");
	}
	
	
string loch_fkt()
{ if(gulli_status==1) 
	return "Du siehst ein grosses, tiefes Loch. Ob Du hineingreifen solltest?\n"; 
	else return "Sowas siehst Du da nicht!\n"; }

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hinter der Post." );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem kleinen Hof hinter der Post der Gierlinge. " 
    "Es ist hier recht dunkel, einzig eine Strassenlaterne verbreitet schummriges Licht. "
    "Du hast das Gefuehl nicht unbedingt in der besten Gegend zu sein. Du siehst "
    "die Rueckwand der Post und eine Laterne." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  
  AddItem(GIER_NPC + "gierling_mel.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier glitzern nicht wie im Rest der Hoehle und sind aus dunklem Fels.");
  AddDetail( ({ "decke" }),
    "Die Decke ist aus Fels gehauen, sie ist zu weit ueber Dir um mehr sehen zu koennen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist aus Fels gehauen. In der Mitte des Hofs ist ein Gulli eingelassen.");
  AddDetail( ({ "hof", "hofs", "hinterhof" }),
    "Du befindest Dich auf einem Hof hinter der Post.");    
  AddDetail( ({ "gulli" }),
    "Du siehst einen ganz normalen Gulli. Er ist geschlossen und ihn anzuheben macht "
    "sicherlich keinen Sinn.");
  AddDetail( ({ "laterne","strassenlaterne" }),
    "Die Laterne ist alt und funzelt flackernd vor sich hin. Am Fuss ist sie ziemlich verbeult.");
  AddDetail( ({ "rueckwand" }),
    "Die Rueckwand der Post ist grauen Steinen gemauert. Ausserdem befindet sich dort die Tuer, "
    "durch die Du gekommen bist.");
  AddDetail( ({ "tuer" }),
    "Durch die bist Du gekommen. Sie ist offen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Die Laterne funzelt truebes Licht in den Hof.");
  AddDetail( ({"hoehle" }),
    "Du befindest Dich in einer Hoehle.");

  AddDetail( ({ "fuss" }),
    "Der Fuss der Laterne ist voller Macken und Beulen.");
  AddDetail( ({ "macken","beulen" }),
    "Sieht aus, als haette dort schon oft jemand gegen getreten.");
  AddDetail("loch", #'loch_fkt);   //'
  AddDetail( ({ "sinn" }),
    "Na, das macht sicher keinen Sinn, was koennte schon in einem Gulli versteckt sein?");
  AddDetail( ({ "steine" }),
    "Die alten, grauen Steine der Rueckwand werden von broeseligem Moertel zusammengehalten.");
  AddDetail( ({ "moertel" }),
    "Der Moertel sieht alt und broeckelig aus. Man kann sicher welchen herauspulen, wenn man denn will.");
  AddDetail( ({ "deckel","gullideckel" }),
    "Der Gullideckel ist verschlossen.");
  AddDetail( ({ "post" }),
    "Durch die bist Du herein gekommen.");
  AddDetail( ({ "gefuehl" }),
    "Aber Gefuehle koennen auch taeuschen, nicht wahr?");
  AddDetail( ({ "gefuehle" }),
    "Seinen Gefuehlen kann man nicht immer trauen.");
  AddDetail( ({ "gegend" }),
    "Wenn Du Dich so umsiehst bist Du sicher, dass Du schon bessere "
	"Gegenden gesehen hast.");
  AddDetail( ({ "gegenden" }),
    "Du hast schon bessere gesehen als diese hier. Aber auch schon bedeutend "
	"schlechtere.");
  AddDetail( ({ "mitte" }),
    "Von allen Waenden gleich weit weg.");
  AddDetail( ({ "gierlinge","reich" }),
    "Du befindest Dich hier im Reich der Gierlinge.");
  AddDetail( ({ "rest" }),
    "Alle anderen Raeume, nur nicht dieser.");
  AddDetail( ({ "raeume" }),
    "Du hast schon einige gesehen.");
  AddDetail( ({ "hoehle","gierlinghoehle" }),
    "Du befindest Dich in einer Hoehle unter der Erde.");
  AddDetail( ({ "" }),
    "");

  




  AddCmd(({"hebe","heb", "oeffne"}),"hebenCmd"),
  AddCmd(({"greife","greif"}),"greif"),
  AddCmd(({"tritt","trete","tret"}),"treten"),
  AddCmd(({"schliesse","schliess"}),"schliessen"),
  AddCmd(({"pule","pul"}),"pulen"),


  AddExit( "osten",  GIER_ROOM + "gierlinge_1b.lpc" );

}

int pulen(string str)
{
	notify_fail("Was moechtest Du wo herauspulen?\n");
	if(str!="moertel aus wand"&&str!="moertel aus wand heraus"&&
		str!="moertel aus steinen"&&str!="moertel aus steinen heraus"&&
		str!="moertel heraus"&&str!="moertel raus")return 0;
	notify_fail("Du hast Angst, dass die Wand dann zusammenbricht, also laesst Du es erstmal.\n");
	if(moertel!=1) 
	{
	  write("Du pulst an der Wand herum, leider ist kein loser Moertel da.\n");
	  return 1;
	  }//mal schauen, eventuell auch immer pulen lassen.
	
	write("Du pulst ein bisschen an der Wand herum und haelst tatsaechlich etwas Moertel in der Hand.\n");
	say(TPN+" pult an der Wand herum.\n",TP);
	CLONE(GIER_OBJ+"moertel.lpc", TP);
	moertel=0;
	return 1;
	}


hebenCmd(string str)
{ notify_fail("Was willst Du heben?\n");
if(str=="gulli" || str=="gullideckel" || str=="gulli an" || str=="gullideckel an")
  {
  	if(gulli_status==1) write("Der Gullideckel ist doch schon angehoben.\n");
  	else
  		{
  			write("Du hebst den Gullideckel an.\n");
				say(TPN+" hebt den Gullideckel an.\n");
				AddDetail( ({ "gulli" }),
					"Ein Gulli halt. Er ist geoeffnet und es gaehnt Dir ein grosses Loch entgegen.");
				gulli_status=1;
			}
        		
		return 1;
	}
return 0;
}

int schliessen(string str)
{ notify_fail("Was willst Du schliessen?\n");
if(str=="gulli" || str=="gullideckel")
  {
	write("Du schliesst den Gullideckel.\n");
	say(TPN+" schliesst den Gullideckel.\n");
    RemoveDetail("loch" );
	gulli_status=0;
	AddDetail( ({ "gulli" }),
		"Ein Gulli halt. Er ist geschlossen, aber man koennte ihn bestimmt anheben.");
	return 1;
	}
}



greif(string str)
{ //Zaubertrankversteck
	notify_fail("Worein moechtest Du greifen?\n");
	if(str=="in loch" || str=="in loch hinein"||str =="in gulli"||str=="in gulli hinein")
		{
   	  if (gulli_status==0) write("Dazu solltest Du erst den Deckel anheben.\n");
   	  else
   	  	{
   	  		if(TP->FindPotion("Du greifst in das Loch und findest einen Zaubertrank.\n")) return 1;
	    		else write("Du greifst in das Loch, findest aber leider nichts. Du bist enttaeuscht.\n");
 	    		say(TPN+" greift in ein Loch im Boden.\n",TP);
	    		}
	    return 1;
		}
	
return 0;
}


treten(string str)
{ //Forscherpunkt
	if(str=="gegen laterne" || str=="laterne")
		{
			if (QueryProp (P_LIGHT)==0)
			  {
				  SetProp( P_LIGHT, 1 );
  		 		write("Du trittst gegen die Laterne, sie geht an.\n");
					say(TPN+" tritt gegen die Laterne, sie geht an.\n",TP);
					return 1;
					}
			else
			  {
				  SetProp( P_LIGHT, 0 );
  		 		write("Du trittst gegen die Laterne, sie geht aus.\n");
					say(TPN+" tritt gegen die Laterne, sie geht aus.\n",TP);
					return 1;
					}
			}
}
