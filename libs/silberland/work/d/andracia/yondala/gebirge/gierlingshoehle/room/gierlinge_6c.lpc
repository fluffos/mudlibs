// ep Idee: Kennerblick
 
//#include <moredef.h>
#include "../def.h"
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Der Gang, in dem Du "
	"Dich befindest, macht hier einen Knick und Du kannst nach Osten oder "
	"nach Sueden gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(GIER_NPC + "gierling_normalo.lpc",REFRESH_DESTRUCT);
  
  
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "knick" }),
    "Du kannst von hier aus nach Osten und nach Sueden laufen.");

  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "osten" }),
    "Du kannst nicht wirklich sehen, was im Osten ist. Du vermutest aber, "
	"dass Du dort tiefer in die Hoehle gelangst.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");

  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen ergeben das Bild eines Gierlings in voller "
	"Lebensgroesse.");
  AddDetail( ({ "gierling","gierling in bild" }),
    "Der Gierling an der Wand wurde aus vielen kleinen Edelsteinen "
	"kunstvoll zusammen gesetzt. Er hat einen grossen, runden Kopf mit "
	"strubbeligen roten Haaren, auf denen eine gruene Melone sitzt. Das "
	"Gesicht wirkt weder freundlich, noch feindlich auf Dich. Der gruene "
	"Anzug sieht sogar als Bild edel aus und Du bist sicher, dass die "
	"kleinen, schwarzen Schuhe auch real funkeln wuerden.");
  AddDetail( ({ "kopf" }),
    "Der Kopf des Gierlings ist gross und rund, die Farbe ist eher rosa, "
	"vermutlich wurden dafuer Rosenquarze verwendet.");
  AddDetail( ({ "gesicht" }),
    "Das Gesicht ist weder freundlich, noch feindlich. Es besteht aus "
	"grossen, gruenen Augen, die Dich anzusehen scheinen, einem roten Mund "
	"und einer kleinen, knubbeligen Nase. Die Stirn verschwindet fast "
	"hinter den buschigen roten Augenbrauen.");
  AddDetail( ({ "augen" }),
    "Die Augen des Gierlings funkeln und scheinen Dich anzusehen. Vermutlich "
	"wurden sie aus Diamanten und die Iris aus Peridoten hergestellt. ");
  AddDetail( ({ "iris" }),
    "Die Iris des Gierlings strahlt so funkelnd, dass sie bestimmt aus "
	"Peridoten gesetzt wurde.");
  AddDetail( ({ "mund" }),
    "Der Mund des Gierlings ist aus einem satten Rot. Im Mundwinkel klemmt "
	"ihm eine kleine Pfeife.");
  AddDetail( ({ "rot" }),
    "So ein sattes Rot hat wohl nur ein Jaspis, bestimmt wurde der Mund "
	"daraus gemacht.");
  AddDetail( ({ "mundwinkel" }),
    "Dort klemmt eine kleine Pfeife.");
  AddDetail( ({ "pfeife" }),
    "Die Pfeife ist bronzefarben und Du hast den Eindruck, dass sie "
	"vermutlich genau daraus auch gemacht ist. Sogar kleine Rauchwoelkchen "
	"steigen aus ihr empor.");
  AddDetail( ({ "eindruck" }),
    "Ja, tatsaechlich, die Pfeife des Gierlings besteht aus echter Bronze.");
  AddDetail( ({ "rauchwoelkchen","rauch" }),
    "Die kleinen Rauchwoelkchen sehen ganz fluffig aus, bestehen aber aus "
	"winzigen grauen Splittern.");
  AddDetail( ({ "splitter" }),
    "Als Du naeher hinsiehst erkennst Du, dass die Splitter aus Diamanten "
	"und Onyxen bestehen, also tatsaechlich weiss und schwarz sind statt grau.");
   AddDetail( ({ "nase", "knubbel" }),
    "Die Nase ist ein runder Knubbel im Gesicht des Gierlings. Sie wurde "
	"aus einem einzigen Rosenquarz gefertigt.");
  AddDetail( ({ "haare" }),
    "Die feuerroten Haare des Gierlings wurden aus Rubinen gefertigt.");
  AddDetail( ({ "augenbrauen","brauen" }),
    "Die feuerroten Augenbrauen des Gierlings wurden aus Rubinen gefertigt.");

  AddDetail( ({ "melone" }),
    "Die Melone des Gierlings ist schoen rund und in einem dunklen Gruen "
	"gehalten.");
  AddDetail( ({ "gruen" }),
    "Mit Deinem Kennerblick erkennst Du sofort, dass es viele kleine "
	"Aventurine sind, die hier den Anzug und die Melone darstellen. Du bist beeindruckt, "
	"von etwas weiter weg betrachtet erkennt man gar keine Uebergaenge "
	"zwischen den einzelnen Edelsteinen.");
  AddDetail( ({ "uebergaenge" }),
    "Die sieht man wirklich nur, wenn man ganz dicht ran geht. Da wusste "
	"jemand, was er tat, als er dieses Bild fertigte.");
  AddDetail( ({ "kennerblick" }),
    "Du hast es halt drauf.");
  AddDetail( ({ "anzug" }),
    "Der Anzug ist in einem dunklen Gruen gehalten, der braune Guertel, der "
	"den Anzug ziert, hat eine goldene Schnalle.");
  AddDetail( ({ "schnalle" }),
    "Die Schnalle besteht aus echtem Gold. Gleich daneben haengt ein "
	"kleines Saeckchen.");
  AddDetail( ({ "stirn" }),
    "Die rosane Stirn des Gierlings verschwindet fast hinter den "
	"strubbeligen Haaren.");
  AddDetail( ({ "schuhe" }),
    "Die schwarzen Schuhe wirken so edel und rein, dass sie aussehen, als "
	"waeren sie frisch geputzt. Tatsaechlich bestehen sie aber aus reinem "
	"Opal.");
  AddDetail( ({ "saeckchen" }),
    "Das Saeckchen sieht aus, als sei es aus echtem Leder.");
  AddDetail( ({ "leder" }),
    "Als Du naeher hinsiehst erkennst Du, dass das Saeckchen aus Bronze "
	"besteht. Du bewunderst, wie naturgetreu es verarbeitet wurde.");

  AddDetail( ({ "gang" }),
    "Die Hoehle ist hier mehr ein Gang. Er ist eng, aber gerade breit "
	"genug, um ihn ohne Beklemmungen passieren zu koennen.");
  AddDetail( ({ "beklemmungen" }),
    "Du hast keine, zumindest nicht jetzt gerade hier in diesem Gang.");
  AddDetail( ({ "erde" }),
    "Du bist schon ein ganzes Stueck unter der Erde.");
  AddDetail( ({ "stueck" }),
    "Immerhin so weit, dass Du den Ausgang nicht mehr sehen kannst.");

  AddDetail( ({ "lebensgroesse"}),
    "Der Gierling an der Wand ist wirklich genau so gross wie ein echter, "
	"lebendiger Gierling.");
  AddDetail( ({ "guertel" }),
    "Der Guertel ist aus vielen kleinen Zirkonen gefertig, die einander "
	"gleichmaessig ueberlappen, sodass ein Schuppenmuster entsteht.");
  AddDetail( ({ "schuppenmuster" }),
    "Die Zirkone sind in duennen Scheiben gearbeitet und so angeordnent, "
	"dass sie Schuppen sehr aehnlich sehen.");
  AddDetail( ({ "schuppen" }),
    "Du bist Dir trotzdem sicher, dass es Zirkone sind, das sagt Dir Dein "
	"Kennerblick.");
  AddDetail( ({ "farbe","farben" }),
    "Das Bild an der Wand funkelt in vielen verschiedenen Farben.");
  AddDetail( ({ "scheiben" }),
    "Die Zirkone wurden zu duennen Scheiben verarbeitet und sich "
	"ueberlappend ergeben sie ein Schuppenmuster.");
  AddDetail( ({ "sueden" }),
    "Wenn Du wissen moechtest, was dort ist, dann geh doch hin.");
  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Es ist hier eigenartig still.");

//  AddSound( ({ "" }),
//    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier einfach nach nichts, die Luft ist trocken, aber nicht "
	"staubig.");
  AddSound( ({ "luft" }),
     "Die Luft hier ist trocken.");



AddExit( "osten", GIER_ROOM + "gierlinge_6d" );
AddExit( "sueden", GIER_ROOM + "gierlinge_7c" );


}


