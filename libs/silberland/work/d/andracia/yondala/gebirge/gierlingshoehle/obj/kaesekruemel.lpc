inherit "/std/food";
#include <moredef.h>
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kaesekruemel");
  SetProp(P_LONG,
    "Ein kleiner Kaesekruemel, der wohl aus einem grossen Laib herausgebroche oder genagt wurde." );
  SetProp(P_NAME, "KAesekruemel");
  SetProp(P_GENDER, MALE);
  SetProp(P_FOOD_INFO, ([F_SOAK:1, F_HEAL:({2,2}), // erst HP, MP
								 F_MSG: "Du habst den kleinen Kruemel weg wie nichts.", 
								 F_MSG_ROOM: "habst einen kleinen Kaesekruemel."]));


  AddId(({"kaese","kruemel","kaesekruemel"}));

  SetProp(P_MATERIAL, ({MAT_MISC_FOOD, MAT_SALT, MAT_MILK }));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);


 
}

