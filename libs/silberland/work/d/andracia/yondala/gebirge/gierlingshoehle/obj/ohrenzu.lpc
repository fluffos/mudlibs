//wird geclont, um sicher zu stellen, dass sich nur der richtige Spieler
//ducken kann

//Yondala@Silberland, 19.12.2011

#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>


void weg()
{
  tell_object(environment(TO), "Du nimmst die Haende von Deinen Ohren.\n");
  environment(TO)->SetProp(P_DEAF,0);
  remove();
 }

 void taub()
{environment(TO)->SetProp(P_DEAF,10);}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"OHRENZU"}));

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  call_out("weg",5);
  call_out("taub",1);
  //taub();
    
}






	
	
	
	
	
	
	
	
    