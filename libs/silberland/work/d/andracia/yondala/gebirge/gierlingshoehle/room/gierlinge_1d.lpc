// 14.1.2012: Hier tropft ein Tropfen von der Decke, den man mit der Zunge
//            auffangen kann (uebenommen aus dem Anfaengerpark(u_1a.c)

#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>
int da = 0;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Der Gang, in dem Du "
	"Dich stehst laeuft hier schnurgerade, Du kannst nach Osten und Westen "
	"gehen." );
 AddItem(GIER_NPC + "gierling_kind.lpc",REFRESH_DESTRUCT);
 SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "knick" }),
    "Im Westen macht der Gang einen Knick.");

  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "osten" }),
    "Oestlich von Dir spaltet sich der Gang zu einer T-Kreuzung.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine T-Kreuzung, denn der Gang teilt sich "
	"dort in drei Richtungen, wie bei einem \"T\".");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nur in zwei Richtungen gehen: Osten und "
	"Nordosten.");
  AddDetail( ({ "westen", "weg" }),
    "Im Westen macht der Gang einen Knick, Du kannst nicht sehen, was dahinter ist.");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");  
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Das Bild stellt einen Gierling dar, der auf dem Ruecken eines weissen "
	"Wiesels ueber einen Baumstamm springt.");
  AddDetail( ({ "gierling","gierling in bild" }),
    "Der abgebildete Gierling sitzt auf dem Ruecken eines Wiesels. Er traegt "
	"einen Anzug aus feinem Leder und kniehohe, schwarze Stiefel.");
  AddDetail( ({ "anzug" }),
    "Der Anzug besteht aus feinem Leder und sitzt wie angegossen. "
	"Wahrscheinlich wurde er fuer seinen Traeger massgeschneidert");
  AddDetail( ({ "traeger" }),
    "Der Gierling scheint wohlhabend zu sein. Dementsprechend ist auch sein "
	"Gesichtsausdruck.");
  AddDetail( ({ "gesichtsausdruck" }),
    "Der Gierling schaut hochmuetig und wenig begeistert ueber seinen "
	"rasanten Ritt.");
  AddDetail( ({ "ritt" }),
    "Der Ritt muss sehr rasant sein, kleine Streifen hinter dem Gierling "
	"und seinem Reittier deuten eine hohe Geschwindigkeit an.");
  AddDetail( ({ "geschwindigkeit" }),
    "Das Wiesel scheint -fuer seine Groesse- ziemlich schnell zu laufen.");
  AddDetail( ({ "groesse" }),
    "Das Wiesel hat genau die Groesse, die ein Reittier fuer einen Gierling "
	"haben muss.");
  AddDetail( ({ "reittier","reiten" }),
    "Eigentlich ist ein Wiesel kein Reittier. Aber wenn es wie hier "
	"gesattelt und gezaeumt wurde, dann ist es fuer einen Gierling gut "
	"genug zum Reiten.");
  AddDetail( ({ "ruecken" }),
    "Auf dem Ruecken des Wiesels sitzt ein Gierling.");
  AddDetail( ({ "sattel" }),
    "Ein wirklich praechtiger Sattel ist das. Kunstvoll gearbeitet, mit "
	"einem praechtigen schwarzen Knauf.");
  AddDetail( ({ "knauf", "sattelknauf" }),
    "Der Knauf des Sattels wurde aus einem einzigen Onyx gefertigt.");
  AddDetail( ({ "zaum", "zaumzeug" }),
    "Das Zaumzeug des Wiesels besteht aus silbernen Kettchen.");
  AddDetail( ({ "kettchen" }),
    "Die Ketten sind sehr filigran gearbeitet, Du kannst jedes einzelne "
	"Glied erkennen.");
  AddDetail( ({ "glied","glieder" }),
    "Die Kettchen besteht aus unzaehligen kleinen Gliedern.");
  AddDetail( ({ "leder" }),
    "Das gruenliche Leder wurde feinsaeuberlich aus vielen kleinen Lapislazuli "
	"zusammengesetzt. Es ist so detailverliebt gearbeitet, dass Du sogar die "
	"Struktur des Leders erkennen kannst.");
  AddDetail( ({ "struktur" }),
    "Die Struktur des mit Lapislazuli dargestellten Leders sieht echtem "
	"Leder taeuschend aehnlich.");
  AddDetail( ({ "stiefel" }),
    "Die schwarzen Stiefel - hier mit Onyxen dargestellt - sind blitzblank "
	"poliert. Sie werden mit einer kleinen goldenen Schnalle knapp unter "
	"dem Knie des Gierlings geschlossen.");
  AddDetail( ({ "knie" }),
    "Die Knie des Gierlings sind leicht angewinkelt, er steht halb in den "
	"Steigbuegeln des Wiesels.");
  AddDetail( ({ "steigbuegel" }),
    "Die Steigbuegel des Wiesels bestehen aus blitzendem Silber.");
  AddDetail( ({ "schnalle" }),
    "Je eine schwarze Schnalle aus purem Gold zieren die schwarzen Stiefel "
	"des Gierlings.");
  AddDetail( ({ "wiesel" }),
    "Das Wiesel hat ein glattes, leuchtend weisses Fell.");
  AddDetail( ({ "fell" }),
    "Das Fell des Wiesels wurde mit vielen kleinen Diamantsplittern an die "
	"Wand gebracht.");
  AddDetail( ({ "splitter","diamantsplitter" }),
    "Unzaehlige Diamanten wurden in so feine Splitter gespalten, dass sie "
	"wie echte Haare aussehen.");
  AddDetail( ({ "haare", "wieselhaare" }),
    "Die Splitter sehen so aus wie echte, feine Wieselhaare.");
  AddDetail( ({ "streifen" }),
    "Duenne Streifen aus Opalstaub deuten eine hohe Geschwindigkeit an.");
  AddDetail( ({ "opalstaub","staub" }),
    "Um die schnelle Bewegung des Wiesels mit seinem Reiter an zu deuten "
	"wurden Opale zu Staub gemahlen und hinter dem Gespann auf die Wand "
	"gebracht.");
  AddDetail( ({ "gespann" }),
    "Reiter und Wiesel.");
  AddDetail( ({ "reiter" }),
    "Der Gierling reitet das Wiesel.");
  AddDetail( ({ "baumstamm", "baum" }),
    "Der Baumstamm liegt quer auf dem Waldboden. Er wurde vermutlich "
	"gefaellt, Du kannst klar und deutlich die Jahresringe sehen.");
  AddDetail( ({ "waldboden" }),
    "Der Gierling reitet auf seinem Wiesel ueber den Waldboden.");
  AddDetail( ({ "jahresringe" }),
    "Wenn man Jahresringe zaehlt, erfaehrt man das Alter des Baumes.");
  AddDetail( ({ "alter" }),
    "Aber wozu sollte man wissen wollen, wie alt ein Baum ist?");
  AddDetail( ({ "bewegung" }),
    "Natuerlich bewegt sich auf dem Bild nicht wirklich etwas, aber die "
	"Bewegung ist angedeutet.");
  AddDetail( ({ "" }),
    "");


	

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen.");

  AddSound( ({ "rauschen" }),
    "Wenn Du bloss wuesstest, woher es kommt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ein wenig feucht.");

  AddSmell( ({ "feuchtigkeit" }),
    "Naja, Du bist ja auch in einer Hoehle.");
    
  AddExit( "westen", GIER_ROOM + "gierlinge_1c.lpc" );
  AddExit( "osten", GIER_ROOM + "gierlinge_1e.lpc" );  

  AddCmd( ({ "fange", "fang" }), "fangenCmd" );   
  AddCmd( ({ "zaehle","zaehl" }), "zaehlen");
  AddRoomMessage( ({"Ein grosser Tropfen bildet sich an der Decke.\n"}),30,"tropf");


}

int zaehlen(string str)
{
  int ringe;
  notify_fail("Was moechtest Du zaehlen?\n");
  if(str!="ringe"&&str!="jahresringe") return 0;
  ringe=20+random(10);
  write("Du zaehlst die Jahresringe und kommst auf ca. "+ringe+" Ringe.\n");
  say(TPN+" zaehlt etwas an der Wand.\n",TP);
  return 1;
}


void tropf()
{
		//say("Ein grosser Tropfen bildet sich an der Decke.\n");
	  da=1;
	  AddDetail( ({ "boden", "decke" }),
      "Boden und Decke sind aus Fels gehauen. Von der Decke haengt ein grosser Tropfen herab.");
    AddDetail( ({ "tropfen"}),
      "Du kannst versuchen ihn mit Deiner Zunge aufzufangen.");

		call_out("enttropf", 5);
		
	}


void enttropf()
{
	if(da==1)
		{			
			//write("Ein grosser Tropfen tropft von der Decke.\n");
			tell_room(TO, "Ein grosser Tropfen tropft von der Decke.\n");
			da=0;
	  	AddDetail( ({ "boden", "decke" }),
    		"Boden und Decke sind aus Fels gehauen. Von der Decke tropft es ab und zu.");
				RemoveDetail("tropfen");
		}
}	
	
	
int fangenCmd(string str )
{
  notify_fail( "Was moechtest Du womit auffangen?\n" );
  if( str == "tropfen"|| str=="tropfen mit zunge"||str=="tropfen mit zunge auf" )
  {
  	if(da==1)
  		{
  			write("Du streckst Deine Zunge aus und faengst den grossen Tropfen geschickt auf.\n");
		    say( TPN+" faengt einen Tropfen mit der Zunge auf.\n",TP);
				TP->AddHp(5);
				da=0;
			  AddDetail( ({ "boden", "decke" }),
  	  		"Boden und Decke sind aus Fels gehauen. Von der Decke tropft es ab und zu.");
				RemoveDetail("tropfen");
    	}
    else
    	{
    		write("Du streckst Deine Zunge aus, aber es ist gerade gar kein Tropfen da.\n");
    	}
    		
    return 1;
    	
  }
  return 0;
}
 