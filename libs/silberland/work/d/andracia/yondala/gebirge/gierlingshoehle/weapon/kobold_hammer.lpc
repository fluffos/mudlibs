#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hammer");
  SetProp(P_LONG,
    "Du siehst einen grossen, schweren Hammer" );
  SetProp(P_NAME, "Hammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer", ""}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp( P_MATERIAL, ([ MAT_IRON : 70, MAT_OAK : 30 ]) );
  SetProp(P_AUTOLOADOBJ, 1);                                     


  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 530);
  SetProp(P_QUALITY_DECAY, 200);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["werner": 200]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:20]) );
}

int WieldFunc(object waffe) {
  return 0;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
