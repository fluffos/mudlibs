// Der Eingang
#include <moredef.h>
#include "../def.h"
inherit "std/room";
#include <properties.h>


/*
//*******************************************************************
//Portal
#pragma strict_types
#define SAVEFILE "/d/andracia/yondala/lunia/room/lunia_5e" 

string *erlaubte;

//Langbeschreibung
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(member(erlaubte,viewer->name())>=0)
    result += "Ein steinernes Portal.\n";
  return result;
}

//Kurzbeschreibung
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  if(member(erlaubte,viewer->name())>=0)
    result += "Ein steinernes Portal.\n";
  return result;

}


  
int betreten(string str)
{
  if(member(erlaubte,TPN)<0) return 0;
  restore_object(GIER_ROOM+"lunia_5e.lpc");
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  write("Du betrittst das steinerne Portal.\n");
  say(TPN+" betritt das steinerne Portal.\n");
  TP->move( "/d/andracia/yondala/lunia/room/lunia_5e.lpc", M_NOCHECK);
  return 1;
}



string det_portal()
{
if(member(erlaubte,TPN)<0) return "Sowas siehst Du da nicht!";

return "Du siehst ein Portal aus weissem Marmor. Es besteht aus einem "+
	"Marmornbogen, der auf zwei Marmorsaeulen ruht. Ob man es betreten kann?"; 
} 

string det_bogen()
{
if(member(erlaubte,TPN)<0) return "Sowas siehst Du da nicht!";

return "In den Bogen wurde das Wort \"Lunia\" gepraegt."; 
} 
string det_saeulen()
{
if(member(erlaubte,TPN)<0) return "Sowas siehst Du da nicht!";

return "In die Saeulen wurden Namen gedruckt."; 
} 
    
string det_lunia()
{
if(member(erlaubte,TPN)<0) return "Sowas siehst Du da nicht!";

return "Was mag das nur bedeuten?"; 
} 

void create() 
{
  ::create();
  if (!restore_object(SAVEFILE))  erlaubte=({"Aginor", "Yason","Yondala"});
  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "gierlingen" }),"det_gier");
  AddSpecialDetail( ({ "saeulen","marmorsaeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");
  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );
  erlaubte=call_other("/d/andracia/yondala/lunia/room/lunia_5e", "werdarf",TPN);
  
//*************************************************************************
  */
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer Grotte" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Eingangsbereich einer Grotte unter der Hoehle "
	"der Gierlinge. Es ist hier recht hell, obwohl Du keine Lichtquelle "
	"entdecken kannst. Die Waende scheinen von sich aus zu leuchten. Du "
	"entdeckst ein kleines Schild." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
AddItem(GIER_NPC + "elend.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "faehigkeit", "faehigkeiten" }),
    "Die kannst Du hier trainieren.");
  AddDetail( ({ "welt", "Andracia" }),
    "Diese Welt heisst Andracia.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende glitzern und verbreiten ein sanftes Licht.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus Fels gehauen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen. Nur die Waende leuchten.");
  AddDetail( ({ "anfaengergrotte"}),
    "Die Anfaengergrotte ist dafuer da um Deine Faehigkeiten zu trainieren.");
  AddDetail( ({ "hoehle" }),
    "Nach oben gelangst Du zurueck in die Hoehle der Gierlinge.");
  AddDetail( ({ "eingangsbereich" }),
    "Du befindest Dich im Eingangsbereich einer Hoehle. Von hier aus "
	"gelangst Du entweder nach Norden in die Anfaengergrotte oder nach "
	"oben zurueck in die glitzernde Hoehle.");
    
  AddReadDetail( ({ "schild" }),
    " _____________________________________"+
    "|                                     |\n"+
    "| Werter Anfaenger,                   |\n"+
    "| Noerdlich von Dir befindet sich ein |\n"+
    "| kleines Uebungsgelaende fuer Dich,  |\n"+
    "| in dem Du Deine Faehigkeiten als    |\n"+
    "| Kaempfer, aber auch als Forscher    |\n"+
    "| erproben kannst.                    |\n"+
    "|_____________________________________|");

   AddDetail( ({ "anfaenger" }),
    "Wenn Du ein Anfaenger bist, dann geh doch einfach nach Norden, dort "
	"kannst Du ueben.");
   AddDetail( ({ "norden" }),
    "Im Norden scheint der Anfaengergrotte zu sein. Geh doch einfach hin "
	"und schau ihn Dir an.");
   AddDetail( ({ "anfaengergrotte", "grotte" }),
    "Der Anfaengergrotte ermoeglicht es Anfaengern ein wenig zu ueben.");
   AddDetail( ({ "gierlinge" }),
    "So wird das Koboldvolk genannt, welches in der glitzernden Hoehle "
	"ueber Dir lebt.");
   AddDetail( ({ "koboldvolk", "gierlinge" }),
    "Die Gierlinge sind ein Koboldvolk.");



  AddExit( "norden", GIER_ROOM + "gierlinge_u_7c.lpc" );
  AddExit( "oben", GIER_ROOM+"gierlinge_5d.lpc" );  

  

}

