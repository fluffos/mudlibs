// Normalo Heinz sitzt in Raum 3e

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Heinz der Gierling");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist Heinz. Er ist ein Gierling. Er traegt einen braunen Schlapphut. Darunter "
    "schauen zottelige rote Haare hervor. An seinen Fuessen stecken schwarze Lederschuhe. "
    "Er traegt Beinlinge und eine kleine Toga. An seinem Guertel haengt ein Goldsaeckchen. "
    "Er ist ziemlich gross fuer einen Gierling. Zwischen seinen Lippen blitzen kleine scharfe Zaehne hervor. "
    "Aber beissen tut er nur selten...");
  SetProp(P_NAME, "Heinz");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, MALE);
SetProp (P_MNPC_DEFAULTROOM, "/d/gierlinge/");
SetProp (P_MNPC_AREA, "/d/" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
  AddDetail( ({ "haar", "haare" }),
    "Die Haare von Heinz sind rot und zottelig."); 
  AddDetail( ({ "hut", "schlapphut" }),
    ""); 
  AddDetail( ({ "zaehne" }),
    "Die Zaehne von Heinz sind sehr scharf."); 
  AddDetail( ({ "lippen", "lippe" }),
    "Die Lippen von Heinz sind duenn. Zwischen ihnen schauen scharfe Zaehne hervor."); 
  AddDetail( ({ "", "" }),
    ""); 
  
  
  AddId(({"heinz", "winzling", "den kleinen"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_schlapphut.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc");
  CLONEME(GIER_ARMOUR + "gierling_beinlinge.lpc");    
    
  command("trage alles");
  CLONEME(GIER_WEAPON + "kobold_dolch.lpc");
  command("zuecke dolch");

  create_default_npc(30);// Die Zahl entspricht der Spielerstufe des GIER_NPC
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));



  SetProp(P_KILL_NAME, "Heinz der Gierling");//name des tötenden npc
  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat



}




