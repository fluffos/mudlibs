#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser gelber Hut");
  SetProp(P_LONG,
    "Ein grosser, gelber Hut, der einfach unbeschreiblich ist." );
//  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Hut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_FELT ]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 85);

  SetProp(P_QUALITY_DECAY, 50);
//  SetProp (P_WEAR_RESTRICTIONS,([P_RACE:"Kobold"]) );

//	SetProp (P_WEAR_DESTRICTIONS, SR_INCLUDE_RACE("Kobold")P_GENDER(NEUTER));
// das wird falsch sein

//  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_AUTOLOADOBJ, 1);                                     

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
