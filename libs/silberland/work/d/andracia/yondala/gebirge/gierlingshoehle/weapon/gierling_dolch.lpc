#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Dolch");
  SetProp(P_LONG,
    "Du siehst einen kleinen Dolch, der wohl nur von Wesen mit kleinen Haenden "
    "benutzt wird. Dennoch ist diese Waffe nicht zu unterschaetzen");

  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "kleiner dolch"}) );
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 40 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IVORY );
  SetProp(P_WEIGHT, 150);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_QUALITY_DECAY, 100);
  
	SetProp(P_WIELD_RESTRICTIONS, ([SR_MAX_SIZE:80])); 
  SetProp(P_WC_BONUS, (["kobold": 100]) );

}
