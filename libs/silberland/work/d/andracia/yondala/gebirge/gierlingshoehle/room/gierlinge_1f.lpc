// Vorraum zur dampfhoehle
// Hier wird man vom Bademeisterkobold ausgezogen und kann ein Handtuch kaufen

#include "../def.h"
#include <moredef.h>

inherit "std/room";
#include <properties.h>
int handtuch = 2;
void reset()
{
	::reset();
	handtuch = 2;
	}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Vorraum zur Dampfhoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in dem Vorraum zur Dampfhoehle der Gierlinge. "
    "Hier befindet sich ein Tresen mit Handtuechern. Nach Westen gelangst "
    "Du zurueck in die glitzernde Hoehle, nach Sueden betrittst Du "
    "die Dampfhoehle. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich im Vorraum der Dampfhoehle. Zurueck in die funkelnde "
	"Hoehle geht es nach Westen.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge kommen hier her um sich zu entspannen.");  
  AddDetail( ({ "wand", "waende" }),
    "Die Waende glitzern und verbreiten ein sanftes Licht. Vor einer Wand steht ein kleiner Korb.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus Fels gehauen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und sehr warm.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen.");
  AddDetail( ({ "raum", "vorraum" }),
    "Du befindest Dich im Vorraum der Dampfhoehle. Hier kannst und solltest "
	"Du Dich entkleiden und Dir ein Handtuch besorgen, wenn Du die "
	"Dampfhoehle betreten moechtest.");
  AddDetail( ({ "handtuecher", "handtuch" }),
    "Du kannst bei Wurz ein Handtuch kaufen.");
  AddDetail( ({ "dampfhoehle", "sauna", "sueden" }),
    "Nach Sueden gelangst Du in die Dampfhoehle der Gierlinge.");
  AddDetail( ({ "tresen", "arbeitsbereich" }),
    "Der Tresen ist Wurz' Arbeitsbereich. Hier liegen ausserdem ein paar Handtuecher.");
  AddDetail( ({ "korb" }),
    "Der Korb ist sicher fuer die schutzigen Handtuecher gedacht. Er ist "
	"aber gross genug, als dass ein Koboldkind sich darin verstecken koennte.");
  AddDetail( ({ "koboldkind" }),
    "Solltest Du ein bestimmtes suchen, so suche es doch im Korb.");
  AddDetail( ({ "sueden" }),
    "Im Sueden ist eine Tuer, durch die Du in die Dampfhoehle gelangen kannst.");
  AddDetail( ({ "tuer" }),
    "Es handelt sich dabei um eine Schwingtuer, die in beide Richtungen "
	"schwingen kann.");
  AddDetail( ({ "schwingtuer" }),
    "Durch die Schwingtuere dringt ein wenig Dampf.");
  AddDetail( ({ "dampf" }),
    "Hier ist nur wenig Dampf, hin und wieder dringt welcher durch die "
	"Tuer in den Vorraum.");
  AddDetail( ({ "fliege" }),
    "Eine kleine Fliege summselt durch den Raum.");
  AddDetail( ({ "westen" }),
    "Nach Westen verlaesst Du diesen Raum wieder.");
  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Zischen");

  AddSound( ({ "fliege" }),
    "Die Fliege summt.");
  AddSound( ({ "zischen" }),
    "Das Zischen kommt aus dem Sueden.");
  AddSound( ({ "sueden" }),
    "Mehr kannst Du nicht erlauschen, dafuer musst Du schon nach Sueden gehen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach feuchter Luft und irgendwie nach Tanne.");

  AddSmell( ({ "luft" }),
    "Kein Wunder, bei dem ganzen Dampf, der durch die Schwingtuer dringt.");
  AddSmell( ({ "wunder" }),
    "Wunder gibt es immer wieder. Aber das hier ist keins.");
  AddSmell( ({ "tanne" }),
    "Komisch. Wie kann es hier, in einer Hoehle, nach Tanne riechen?");
  AddSmell( ({ "hoehle" }),
    "Es riecht hier nach feuchter Luft und irgendwie nach Tanne.");

  AddRoomMessage( 
    ({"Ein rotgesichtiger Kobold kommt froehlich aus der Dampfhoehle, zieht sich an und geht.\n",
	  "Ein aelter Kobold kommt herein, zieht sich aus und geht durch die Schwingtuer.\n",
	  "Etwas Dampf dringt durch die Schwingtuere.\n",
	  "Die Schwingtuere schwingt auf und zwei junge Kobolddamen verlassen die Dampfhoehle.\n",
	  "Eine penetrante Fliege summt um Dich herum.\n"}),150,"func");

  AddItem(GIER_NPC + "gierling_wurz.lpc",REFRESH_DESTRUCT);
  //AddExit( "sueden", GIER_ROOM + "gierlinge_2f.lpc" );
  AddSpecialExit("sueden", "kleidungscheck");
  AddExit( "westen", GIER_ROOM + "gierlinge_1e.lpc" );
  AddCmd( ({ "nimm", "nehme" }), "nehmenCmd" );  

}

int kleidungscheck(string Dir)
{
  object *kleidung;
  int i;
  if(!interactive(TP)||!present("wurz",TO)) 
  return this_player()->move(GIER_ROOM + "gierlinge_2f.lpc", M_GO, 0,
                    "betritt die Dampfhoehle", "betritt die Dampfhoehle");
					
  kleidung = TP->QueryArmours();
  if(sizeof(kleidung)==0)
  return this_player()->move(GIER_ROOM + "gierlinge_2f.lpc", M_GO, 0,
                    "betritt die Dampfhoehle", "betritt die Dampfhoehle");
					
  //Wenn der Spieler nur das Handtuch traegt
  if(sizeof(kleidung)==1&&kleidung[i]->name()=="ein Handtuch")	
    return this_player()->move(GIER_ROOM + "gierlinge_2f.lpc", M_GO, 0,
                    "betritt die Dampfhoehle", "betritt die Dampfhoehle");
  tell_room(TO,"Wurz keift: So betretet Ihr nicht meine Dampfhoehle!\n");
  write("Wurz reisst Dir die Kleider vom Leib.\n");
  say("Wurz reisst "+TP->name(WEM)+" die Kleider vom Leib.\n",TP);
  
  for(i=sizeof(kleidung);i--;i>=0)
  {
    if(kleidung[i]->name()!="ein Handtuch")kleidung[i]->DoUnwear();
	}
  tell_room(TO,"Wurz nickt: So lasse ich Euch passieren!\n");

	return this_player()->move(GIER_ROOM + "gierlinge_2f.lpc", M_GO, 0,
                    "betritt die Dampfhoehle", "betritt die Dampfhoehle");
}	
  


int nehmenCmd(string str)


{ notify_fail("Was moechtest Du nehmen?\n");

if(str=="handtuch" || str=="ein handtuch")
{
	if(present("wurz", TO))
	{
	  write ("Wurz haut Dir auf die Finger.\nWurz sagt: Ihr duerft gerne eines bei mir kaufen.\n");
      say("Wurz haut "+TPN+" auf die Finger.\nWurz sagt: Ihr duerft gerne eines bei mir kaufen.\n",TP);
	  return 1;
	}
	if (handtuch>0)
	{
		write("Du nimmst Dir ein Handtuch.\n");
		say(TPN+" nimmt sich ein Handtuch.\n");
		handtuch-=1;
		CLONE(GIER_ARMOUR + "handtuch.lpc", TP);
	}
	else
		{write("Die Handtuecher die hier noch liegen sind alle schmutzig. Du nimmst lieber doch keines.\n");}
		
	return 1;
}
}