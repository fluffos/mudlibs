
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas Moertel");
  SetProp(P_LONG,
    "Du siehst ein bisschen broeckeligen Moertel." );

  SetProp(P_NAME, "Moertel");
  SetProp(P_GENDER, MALE);
  AddId(({"moertel"}));

  SetProp(P_MATERIAL, MAT_CONCRETE );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
 
}
