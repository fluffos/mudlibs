#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Goldsaeckchen");
  SetProp(P_LONG,
    "Ein Goldsaeckchen, welches zweifellos einem Kobold gestohlen wurde. "
    "Jemand anderes als der wahre Besitzer kann damit allerdings nichts anfangen.\n"
    "Es ist geschlossen." );
  SetProp(P_INFO, BS("Wenn Du nicht der wahre Besitzer des Goldsaeckchen bist, solltest Du nicht versuchen, es zu oeffnen.") );
  SetProp(P_NAME, "Goldsaeckchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"goldsaeckchen", "saeckchen"}));

  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 160);

 AddCmd( ({ "oeffne" }), "oeffnenCmd" ); 
 
}
int oeffnenCmd(string str )
{
  notify_fail( "Was moechtest du oeffnen?\n" );
  if( str == "goldsaeckchen", "saeckchen" )
  {
    write("Du versuchst das Saeckchen zu oeffnen. Ploetzlich zischt es und Du wirst meterweit durch die Luft geschleudert.\n");
    say( TPN+" wird von einem Blitz getroffen.\n", TP);
    TP->do_damage(20,"Gier und ein Blitz");
      		this_object()->remove();
//    return 1;
    
  }
  return 0;
}