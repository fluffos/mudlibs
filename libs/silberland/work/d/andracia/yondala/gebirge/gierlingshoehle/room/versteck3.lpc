#include "../def.h"
#include <moredef.h>
inherit "std/thing";
int a = random (4);
string *raeume = ({ GIER_ROOM + "koboldhoehle_5a",
	                  GIER_ROOM + "koboldhoehle_4c",
	                  GIER_ROOM + "koboldhoehle_3f",
	                  GIER_ROOM + "koboldhoehle_5d" });
	                  
#include <properties.h>


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "stinaversteck");
  SetProp(P_GENDER, MALE);
  AddId("versteck" );

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);

  
AddCmd(({"such stina", "suche stina"}), "suchenCmd");
AddCmd(({"wo"}), "woCmd");
}
woCmd()
{	write( "Test: "+a + "/n");
	return 1;
}
suchenCmd(string str )
{	
//	notify_fail( "Wen moechtest Du wo suchen?\n" );
//	write( "Test: "+file_name(environment(TP)) );
	
if( file_name(environment(TP)) != raeume[0] 
	&& file_name(environment(TP)) != raeume[1]
	&& file_name(environment(TP)) != raeume[2]
	&& file_name(environment(TP)) != raeume[3]) return 0; //wenn er in keinem dieser Raeume ist.

else 	
	{
		if( file_name(environment(TP)) == raeume[0] )	
			{
				if( str=="hinter Fass" || str=="hinter dem fass" || str == "hinter einem Fass" )
					{
					write("Du beugst Dich vor und schaust hinter das Fass. "+
	  			"Tatsaechlich hockt die kleine Stina dort und freut sich.\n"+
	  			"Sie freut sich so sehr, dass sie Dir einen Attributpunkt schenkt.\n");
    			say( TPN+"findet Stina.\n");
	 			  return 1;
  				}
  			else
  				{
  					write("Wo moechtest Du Stina denn suchen?\n");
  				}}
  					
  	if( file_name(environment(TP)) == raeume[1] )	
			{
				if( str=="unter bett" || str=="unterm bett" || str == "unter dem bett" )
					{
					write("Du kniest Dich hin und schaust unter das Bett. "+
	  			"Tatsaechlich liegt dort die kleine Stina dort und freut sich.\n"+
	  			"Sie freut sich so sehr, dass sie Dir einen Attributpunkt schenkt.\n");
    			say( TPN+" findet Stina.\n");
	 			  return 1;
  				}
  			else
  				{
  					write("Wo moechtest Du Stina denn suchen?\n");
  				}
  			}	
  			
  				if( file_name(environment(TP)) == raeume[2] )	
			{
				if( str=="hinter tresen" || str=="hinter dem tresen" || str == "hinter tresen" )
					{
					write("Du beugst Dich vor und schaust hinter den Tresen. "+
	  			"Tatsaechlich sitzt die kleine Stina dort und freut sich.\n"+
	  			"Sie freut sich so sehr, dass sie Dir einen Attributpunkt schenkt.\n");
    			say( TPN+" schaut hinter den Tresen und findet Stina.\n");
	 			  return 1;
  				}
  			else
  				{
  					write("Wo moechtest Du Stina denn suchen?\n");
  				}	
  			}

if( file_name(environment(TP)) == raeume[3] )	
			{
				if( str=="in werkzeugkiste" || str=="in der werkzeugkiste" )
					{
					write("Du beugst oeffnest die Werkzeugkiste und findest die kleine Stina dort ganz klein zusammengekauert. "+
	  			"Sie freut sich so sehr, dass sie Dir einen Attributpunkt schenkt.\n");
    			say( TPN+" findet Stina.\n");
	 			  return 1;
  				}
  			else
  				{
  					write("Wo moechtest Du Stine denn suchen?\n");
  				}	

  return 1;
}
}
}


