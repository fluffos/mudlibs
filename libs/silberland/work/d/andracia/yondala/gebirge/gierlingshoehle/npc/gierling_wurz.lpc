//Der Bademeister
// Er soll alles anziehen, ausser dem Handtuch.
// NPCs, die Klamotten im inv haben die sie nicht tragen soll er wieder anziehen.
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
//#include <moving.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";

object *ob;
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Wurz der Bademeister");
  SetProp(P_LONG,
    "Das ist Wurz. Er ist der Bademeister in der Gierlingsdampfhoehle. "
    "Er ist mit einem Handtuch bekleidet."
    "Fuer einen Gierling ist er durchschnittlich gross. Seine Haare sind lila. "
    "Seine Haut ist eigentlich sehr blass, im Moment aber etwas geroetet.");
  SetProp(P_NAME, "Wurz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"wurz", "gierling", "bademeister"}));
  SUID;
  CLONEME(GIER_ARMOUR + "handtuch.lpc");
  command("trage alles");

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit einem feuchten Handtuch",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  
  SetProp(P_ALIGN, -50);

  SetProp(P_MMSGIN, "rutscht von einem Regenbogen");
  SetProp(P_MMSGOUT, "stampft dreimal auf den Boden und ist weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du bekommst lebenslang Hausverbot," +TPN+ " !");
  SetProp(P_KILL_NAME, "Wurz, der Gierling");
  SetProp(P_KILL_MSG, "In meiner Sauna randalierst Du nicht!");

  AddInfo( ({"handtuch"}), 
    "Das koennt Ihr bei mir fuer nur 100 Muenzen kaufen.",
    "sagt: ");
  AddInfo( ({ "wurz" }),
    "Das bin ich.",
        "sagt: ");
  AddInfo( ({ "sauna", "dampfhoehle" }),
    "Och, das ist einfach: zieht Euch aus, wickelt Euch ein Handtuch um und geht einfach rein!",    
       "sagt: "); 
 SetChats(5, ({
    "Wurz falltet Handtuecher auf.\n","Wurz schlaegt nach einer Fliege.\n"}) );
  
 SetProp(P_SPELLRATE, 10);
 AddSpell(1,20,
              "Wurz laesst das nasse Handtuch gegen Deinen Bauch schnacken.\n",
              "Wurz laesst das nasse Handtuch gegen den Bauch von @WEM schnacken.\n",
              ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]) );
 AddSpell(1,60,
              "Wurz laesst das nasse Handtuch gegen Deinen Kopf schnacken.\n",
              "Wurz laesst das nasse Handtuch gegen den Kopf von @WEM schnacken.\n",
              ({DT_MIND}),([SP_SHOW_DAMAGE:1]) );
  
  AddCmd(({"kaufe","kauf"}),"kaufenCmd");
  
  
  
  }


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "wundert sich ueber Dich!",// in Klammern kommt die Meldung die an den Spieler geht
        "wundert sich ueber " +TPN+ "!");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
//    case "albern":
//      call_out("reaction", 0, TP,
//        "schaut Dich pikiert an und ruempft die Nase.",
//        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schaut Dich aergerlich an.",
        "schaut " +TPN+ " aergerlich an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "wischt sich den Schweiss von der Stirn.",
        "wischt sich den Schweiss von der Stirn.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}



int kaufenCmd(string str)
{ notify_fail("Was willst du kaufen?\n");


if(str=="handtuch" || str=="saunatuch")
{	
	
if(this_player()->QueryMoney() >= 100)
{
	this_player()->AddMoney(-100);
		write("Du gibst Wurz 100 Muenzen und bekommst dafuer ein Handtuch von ihm.\n");
		say(TPN+" kauft etwas bei Wurz.\n", TP);
    CLONE(GIER_ARMOUR + "handtuch.lpc", TP);
		return 1;
}

else
	command("sag Ihr habt nicht genug Geld dabei.");
return 1;
}}
