#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include "../def.h"



inherit GIER_NPC + "gierling_standard.lpc";
int a;
int muenzen;
int klauich=random(5);
object ob;
int zaehler;

void init()
{::init();	
	if(klauich==1)
		{
			call_out("dieb",5);
			}
}

void finden(object ob)
{
  if(present(ob, environment(TO)))
	command("sag Das war lustig, "+ob->name()+"!");
  ob->FindPotion("Stina drueckt Dir ein kleines Kuesschen auf die Wange.\n");
}
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Stina das Gierlingsmaedchen");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist Stina, sie ist ein kleines Gierlingsmaedchen. Sie traegt ein gruenes Kleidchen "
    "und einen grossen gelben Hut. Ihre Fuesse sind barfuss und ziemlich schmutzig. "
    "Sie hat eine helle Haut und leuchtend orangene Haare. An ihrem Guertel haengt ein Goldsaeckchen. " 
    "In Ihrer Hand haelt sie einen grossen Lollie. Stina laechelt Dich an." );//Langbeschreibung vom GIER_NPC wenn man ihn untersucht
  SetProp(P_NAME, "Stina");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, FEMALE);//Geschlecht
  SetProp(P_ARTICLE, 0);
  AddId(({"stina", "winzling", "gierlingskind", "gierlingsmaedchen","kind", "maedchen", "\nstina"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_kleidchen.lpc");
  command("trage alles");
  CLONEME(GIER_OBJ + "lutscher.lpc"); 
  create_default_npc(4);
  SetProp(P_HANDS, ({" mit ihrem Lutscher",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 20);
  SetProp(P_WIMPY, 20);

  SetProp(P_MSGIN, "huepft heran");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "purzelt von einem Regenbogen");

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, " " +TPN+ " ist ein Kindermoerder!!!");// die meldung auf -moerder
  SetProp(P_KILL_NAME, "Stina, das Gierlingmaedchen");//name des toetenden npc
  SetProp(P_KILL_MSG, "Ha, leg Dich NIE mit einem Maedchen an!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat
  SetChats(3, ({"Stina lutscht an ihrem Lutscher.\n", 
  	"Stina scheint sich zu langweilen.\n",
  	"Stina ueberlegt, ob Du wohl mit ihr spielen wuerdest.\n",
  	"Stina fragt: Moegt Ihr mit mir spielen?\n" }) );

    
  AddInfo(DEFAULT_INFO, "schaut Dich mit grossen Augen an.\n");//Wenn der GIER_NPC keine Antwort hat
   
  AddInfo( ({"mutter","eltern"}), 
    "Meine Mama laeuft hier irgendwo rum und sucht mich bestimmt.",
    "sagt: ");    
   AddInfo( ({"papa","vater"}), 
    "Mein Papa laeuft ist zu Hause.",
    "sagt: "); 
   AddInfo( ({"lollie","lutscher"}), 
    "Das ist meiner!",
    "sagt: "); 
   AddInfo( ({"spielen","spiel", "spiele"}), 
    "Ich spiele sehr gerne, Ihr auch? Wollt Ihr wissen, was mein Lieblingsspiel ist?",
    "sagt: "); 
   AddInfo( ({"lieblingsspiel"}), 
    "Mein Lieblingsspiel ist Verstecken. Moegt Ihr mit mir spielen? Ich stell aber die Bedingungen!",
    "sagt: "); 
   AddInfo( ({"bedingung","bedingungen"}), 
    "Ich versteck mich und Ihr muesst mich suchen. Ich bleibe in der Gierlingshoehle, aber ich bin irgendwo drin oder hinter oder so. Ihr muesst Euch richtig Muehe geben, hihi.",
    "sagt: "); 
   AddInfo( ({"lieblingsversteck","versteck"}), 
    "Das verrate ich Euch nicht!",
    "sagt: "); 
   AddInfo( ({"verstecken",""}), 
    "Das ist mein Lieblingsspiel.",
    "sagt: "); 
   AddInfo( ({"",""}), 
    "",
    "sagt: "); 

 AddCmd( ({ "spiel", "spiele" }), "spielenCmd" ); 

 }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bohrt in der Nase und schmiert Dir einen Popel ans Knie.",
        "bohrt in der Nase und schmiert " +TPN+ " einen Popel ans Knie..");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist fuer sowas zu jung und schubst Dich weg.",
        "ist fuer sowas zu jung und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "strahlt Dich an.",
        "strahlt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "macht grosse Augen.",
        "macht grosse Augen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "weint.",
        "weint.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int spielenCmd(string str )
{
  string dummy;
  object ob;
  notify_fail("Stina sagt: Was moechtet Ihr mit mir spielen? \n");
  if(str=="mit stina verstecken"||str=="verstecken mit stina"||str=="verstecken")
  	{
  		command ("sag Oh, prima. Zaehlt bitte bis zehn, ich verstecke mich derweil.\n");
			CLONE(GIER_OBJ +"stinaversteck.lpc", TP);
			ob=present("\nversteck",TP);
			ob->versteckmich(TO);
			zaehler=1;
			//TP->SetProp(P_PARALYZED, "Zu zaehlst gerade.\n");
			  TP->SetProp(P_PARALYZED,([PARALYZE_TIME: 10, PARALYZE_MSG:"Zu zaehlst gerade.\n", 
        PARALYZE_MSG_OTHER:"",PARALYZE_END:"", PARALYZE_END_OTHER:"" ]));

			TO->move("/players/yondala/room/muellhalde", M_GO, "davon");
			call_out("zaehlen",1);
			return 1;
		}
  return 0;
}


void dieb()
{
			 // Spieler noch da?
  		if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  		{	
  			muenzen = 2 + random(50);
  			//muenzen +=2;
  			if(this_player()->QueryMoney() >= muenzen)
					{
						this_player()->AddMoney(- muenzen);
						write("Stina stiehlt Dir ein paar Muenzen.\n");
						say("Stina stiehlt "+TPN+" ein paar Muenzen.\n", TP);
					  ob = clone_object("/obj/money.lpc");
					  ob->SetProp(P_AMOUNT, muenzen);
  					ob->move(TO, M_SILENT);

				  }
			
		}
	}
	
void zaehlen()
{
	if(zaehler==1)	
		{
			write("Du haelst Dir Die Augen zu und beginnst zu zaehlen\nDu zaehlst: Eins.\n");
			TP->SetProp(P_BLIND, 20, "Du haelst Dir gerade die Augen zu.\n");
			say(TPN+" haelt sich die Augen zu und beginnt zu zaehlen.\n"+TPN+" zaehlt: Eins.\n",TP);
		}
	else if(zaehler==2)	
		{
			write("Du zaehlst: Zwei.\n");
			say(TPN+" zaehlt: Zwei.\n",TP);
		}
	else if(zaehler==3)	
		{
			write("Du zaehlst: Drei.\n");
			say(TPN+" zaehlt: Drei.\n",TP);
		}
	else if(zaehler==4)	
		{
			write("Du zaehlst: Vier.\n");
			say(TPN+" zaehlt: Vier.\n",TP);
		}
	else if(zaehler==5)	
		{
			write("Du zaehlst: Fuenf.\n");
			say(TPN+" zaehlt: Fuenf.\n",TP);
		}
	else if(zaehler==6)	
		{
			write("Du zaehlst: Sechs.\n");
			say(TPN+" zaehlt: Sechs.\n",TP);
		}
	else if(zaehler==7)	
		{
			write("Du zaehlst: Sieben.\n");
			say(TPN+" zaehlt: Sieben.\n",TP);
		}
	else if(zaehler==8)	
		{
			write("Du zaehlst: Acht.\n");
			say(TPN+" zaehlt: Acht.\n",TP);
		}
	else if(zaehler==9)	
		{
			write("Du zaehlst: Neun.\n");
			say(TPN+" zaehlt: Neun.\n",TP);
		}
	else if(zaehler==10)	
		{
			write("Du zaehlst: Zehn.\n");
			say(TPN+" zaehlt: Zehn.\n",TP);
		}
	else //if(zaehler==11)	
		{
			write("Du rufst: Ich kooooomme.\n");
			say(TPN+" ruft: Ich kooooomme.\n",TP);
			  TP->SetProp(P_PARALYZED,([PARALYZE_TIME: 0, PARALYZE_MSG:"Zu zaehlst gerade.\n", 
			        PARALYZE_MSG_OTHER:"",PARALYZE_END:"", PARALYZE_END_OTHER:"" ]));
        TP->SetProp(P_BLIND,0);
		call_out("ende",600);//zehn Minuten suchen lassen
			return;
			}
	
	zaehler++;
	call_out("zaehlen",1);
			
	}
	
void ende()
{
	object ob;
	if (!present("\nversteck",TP)) return;
	
	TO->move(GIER_ROOM+"gierlinge_3c", M_GO, "");
	write("Stina teilt Dir mit: Das wird mir zu langweilig, ich komm wieder raus.\n");
	ob=present("\nversteck",TP);	
	ob->remove();
				
			
			}