#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"
inherit "std/mnpc";




void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Maus");
  SetProp(P_LONG,
    "Du siehst eine kleine, graue Maus ueber den Boden flitzen.");
  SetProp(P_NAME, "Maus");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);

  SetProp (P_MNPC_DEFAULTROOM, ROOM + "gierlinge_5c");
  SetProp (P_MNPC_AREA, ({
	ROOM+"gierlinge_5c", 
	ROOM+"gierlinge_5a", 
	ROOM+"gierlinge_6a", 
	ROOM+"gierlinge_6b"}));
  SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetProp (P_MNPC_WAIT, ({5, 10, 5}));



  AddInfo(DEFAULT_INFO, "quiekt",
                        "schnueffelt an Dir",
						"schaut Dich interessiert an");
     
  create_default_npc(2);
  SetProp(P_HANDS, ({" mit kleinen Zaehnchen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_SIZE, 550);
  SetProp(P_WEIGHT, 50);
  SetProp(P_ALIGN, 0);


  SetProp(P_MSGIN, "trippelt leise heran"); 
  SetProp(P_MSGOUT, "trippelt leise");

  SetProp(P_KILL_NAME, "Eine kleine Maus");
 
 SetChats(3, ({
    ".\n"}) );
  SUID;
  CLONEME(GIER_OBJ + "kaesekruemel.lpc");

 SetProp(P_SPELLRATE, 10);
 SetProp(P_WIMPY, 1000);
			  
}
 
// Was auch immer man tut, sie laeuft weg
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  string *ausgang; 
  ausgang = m_indices (environment(TO)-> QueryProp(P_EXITS));
  command(ausgang[random(sizeof(ausgang))]);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
