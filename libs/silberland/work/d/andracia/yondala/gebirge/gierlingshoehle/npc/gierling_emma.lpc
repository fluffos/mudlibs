//Die Verkäuferin im Tante Emma Laden

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
mapping verwarnte;

//Holt sich in der Init die passenden Chats
void init()
{
  if(TP->name()=="eine Maus") 
  {
  tell_room(environment(TO), "Emma kreischt: Eine MAAAAUUUSS!\n");
  Attack(TP);
}
  if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_5a")
  SetChats(3, ({
    "Emma schaut sich kurz um, schlurft zu dem Fass und trinkt ein "+
	    "Schlueckchen daraus.\n",
    "Emma sagt: So viele schoene Dinge.\n",
    "Emma wischt mit einem sauberen Lappen ueber ein Regal.\n"}) );

  if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_5b")
  SetChats(3, ({
    "Emma flucht: Gegen diese versammten Maeuse muss ich was unternehmen.\n",
    "Emma sortiert ihre Ware.\n",
    "Emma raeumt Dinge hin und her.\n"}) );

  if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_6a")
  SetChats(3, ({
    "Emma nimmt ein paar Stiefel aus dem oberen Regal und legt es nach unten.\n",
    "Emma wischt ein bisschen Staub.\n",
    "Emma stoehnt: Ach, mein Ruecken.\n"}) );

  if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_6b")
  SetChats(1, ({
    "Emma oeffnet die Schublade und legt etwas hinein.\n",
    "Emma zieht einen Sack zwischen den Waffen hervor und legt ihn zu den anderen Saecken.\n",
    "Emma poliert eine Ruestung.\n"}) );

  if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_5c")
  SetChats(3, ({
    "Emma wuselt etwas unter dem Ladentisch.\n",
    "Emma rueckt ein Glas zurecht.\n",
    "Emma wischt mit einem sauberen Lappen ueber den sauberen Ladentisch.\n"}) );
	::init();
}

void reset()
{
  verwarnte=([]);
}
void bann()
{
  call_other(GIER_ROOM+"gierlinge_5d","bann",TP);
}
void binhier(object spieler)
{
  
  //command("sag Ich bin hier und verwarne Dich.");
  if(!member(verwarnte, TP)) 
  {
     tell_room(environment(TO),"Emma schaut verwundert.\n");
	 command("sag Ich bin doch hier!");
	 verwarnte += ([ TP: 1 ]);
	 }
  
  else if (verwarnte[TP,0]==1)
  {
     tell_room(environment(TO),"Emma runzelt die Stirn.\n");
	 command("sag Diese Klingel ist kein Spielzeug, "+TPN+"!");
	 verwarnte[TP, 0] = 2;
	}
  else if (verwarnte[TP,0]==2)
  {
     tell_room(environment(TO),"Emma schaut veraergert.\n");
	 command("sag Es reicht, "+TPN+". Wenn Ihr das noch einmal macht, "+
	 "erteile ich Euch Hausverbot.");
	 verwarnte[TP, 0] = 3;
	}
 else if (verwarnte[TP,0]==3)
  {
     tell_room(environment(TO),"Emma schimpft: Nun reicht es, "+TPN+"!\n");
	 tell_room(environment(TO),"Emma wirft "+TPN+" aus ihrem Laden.\n", ({TP}));
	 tell_object(TP,"Emma wirft Dich aus ihrem Laden.\n");
	 TP->move(GIER_ROOM + "gierlinge_5d", M_GO, 0);
	 bann();
	}
     
  
}

void inladen2()
{
  move(GIER_ROOM+"gierlinge_5c",M_GO,"schlurft in den Laden.", "schlurft herein");
}
void inladen()
{
  tell_room(to_object(GIER_ROOM+"gierlinge_5c"),"Emma ruft: Ich komme gleich!\n");
  call_out("inladen2",2+random(5));
}

void jemandklingelt(object spieler)
{
    
   
   if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_5c") //sie ist im Raum mit der Klingel
     {
       if(find_call_out("binhier")>=0) remove_call_out("binhier");
	   call_out("binhier",1, spieler);
	  }
   
   else if (find_call_out("inladen")<0) 
   {
     //remove_call_out("inladen");
     call_out("inladen",1);
	 }

}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  verwarnte=([]);
  SetProp(P_SHORT, "Tante Emma");
  SetProp(P_LONG,
    "Das ist Emma, die Gierlingfrau. Sie hat kurze graue Haare, die ihr wirr vom Kopf "
    "abstehen. Ihr Gesicht ist voller Runzeln und sie scheint sehr alt zu sein. "
    "Sie wird von allen nur \"Tante Emma\" genannt. Sie traegt ein bunt gebluemtes Kleid " 
    "und einen Filzhut auf dem Kopf. An ihrem Guertel haengt ein Goldsaeckchen.");
  SetProp(P_NAME, "Emma");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);

SetProp (P_MNPC_DEFAULTROOM, GIER_ROOM + "gierlinge_5c");
SetProp (P_MNPC_AREA, ({
	GIER_ROOM+"gierlinge_5c", 
	GIER_ROOM+"gierlinge_5a", 
	GIER_ROOM+"gierlinge_5c", 
	GIER_ROOM+"gierlinge_6a", 
	GIER_ROOM+"gierlinge_6b"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));



  AddId(({"emma", "winzling", "die kleine", "gierling", "gierlingfrau", "tante"}));
  AddDetail( ({ "haare", "haar" }),
    "Emmas Haare sind grau und struppig.");
  AddDetail( ({ "runzeln", "falten" }),
    "Emma scheint wirklich alt zu sein.");  
  AddDetail( ({ "gesicht" }),
    "Emma hat ein guetiges Gesicht mit vielen Runzeln und Falten.");  
  AddDetail( ({ "haut"}),
    "Ihre Haut ist eher grau und voller Falten.");    
  AddDetail( ({ "kleid", "hut", "filzhut" }),
    "Tante Emma ist eher altmodisch gekleidet.");  
  AddDetail( ({ "", "" }),
    "");  
  AddDetail( ({ "", "" }),
    "");  
  AddDetail( ({ "", "" }),
    ""); 
     
  AddInfo( ({ "emma" }),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({ "laden" }),
    "Ich habe einen Laden. Du stehst drin, Dummerchen",
    "sagt: ");
  AddInfo( ({ "ruecken" }),
    "Mein Ruecken schmerzt.",
    "klagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
    
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit einem Besenstiel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_SIZE, 550);
  SetProp(P_WEIGHT, 11500);
  SetProp(P_ALIGN, 500);
  //SetProp(P_NOATTACK, "ist zu alt fuer sowas."); 

  SetProp(P_MSGIN, "schlurft herbei"); 
  SetProp(P_MSGOUT, "schlurft davon");

  SetProp(P_KILL_NAME, "Tante Emma");
  SetProp(P_KILL_MSG, "Bei mir kaufst du nicht mehr ein, " +TPN+ "!");
 SetChats(3, ({
    "Emma wuselt etwas unter dem Ladentisch.\n",
    "Emma rueckt ein Glas zurecht.\n",
    "Emma wischt mit einem sauberen Lappen ueber den sauberen Ladentisch.\n"}) );
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_kleid.lpc");
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_filzhut.lpc");    
  command("trage alles");
 
 SetProp(P_SPELLRATE, 10);
 AddSpell(1,20,
              "Emma pustet Dir etwas Staub in die Augen.\n",
              "Emma pustet @WEM etwas Staub in die Augen.\n",
              (DT_AIR),"stauben", ([SP_SHOW_DAMAGE:1]) );
    AddSpell(1,50,
              "Emma schreit Dir ins Ohr.\n",
              "Emma schreit @WEM ins Ohr.\n",
              ({DT_SOUND}),([SP_SHOW_DAMAGE:1]) );	
			  
}
  void stauben(object enemy, int damage, mixed dam_type) 
{
   enemy->SetProp(P_BLIND,7);
    }
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "fragt sich, warum Du Angst vor ihr hast.",
        "fragt sich, warum "+TPN+"Angst vor ihr hat.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "aergert sich ueber Dich.",
        "aergert sich ueber " +TPN+ ".");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laechelt ueber Dich.",
        "laechelt ueber " +TPN+ ".");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht dir mit dem Zeigefinger.",
        "droht " +TPN+ " mit dem Zeigefinger.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "traellert ein Liedchen.", 
        "traellert ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist zu alt fuer Dich!.",
        "findet " +TPN+ "zu jung fuer sich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt dich an.",
        "laechelt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "rauemt unter der Theke etwas auf.",
        "rauemt unter der Theke etwas auf.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
