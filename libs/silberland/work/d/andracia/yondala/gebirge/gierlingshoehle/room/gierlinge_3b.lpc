// fertig

// Hier kann man einen Diamant erst lockern, dann drehen, dann geht im 
// Sueden eine Wand auf
// Ueberarbeitet am 17.9.2011
// Yondala@Silberland
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>



int offen=0;
int locker=0;
void reset()
{::reset();
  locker=0;
  if (offen==1)
  {
	  tell_room(TO,"Eine Wand schiebt sich im Sueden lautlos vor die Wohnhoehle.\n");
	RemoveExit("sueden");
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, obwohl Du "
    "keine Lichtquelle entdecken kannst. Die Waende scheinen von sich aus zu leuchten. ");
  RemoveDetail("wohnhoehle");
  offen =0;
  }
}


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle.  Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Hier endet der Gang "
	"scheinbar. Nach Osten gelangst Du zurueck auf die Kreuzung." );
  RemoveDetail("bild");
	SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
//  AddItem(GIER_NPC + "gierling_trulla.lpc",REFRESH_DESTRUCT);
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nach Osten gehen.");

  AddDetail( ({ "gang" }),
    "Der Gang endet hier scheinbar.");  

	AddDetail( ({ "sueden" }),
    "Nach Suden kannst Du eine Wohnhoehle betreten.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier wurden in einem wirren Muster in die Waende gesetzt.");
  AddDetail( ({ "farbe","farben" }),
    "Die Edelsteine schimmern in allen Farben, die Du Dir vorstellen kannst.");
  AddDetail( ({ "muster" }),
    "Ach, ein Muster kannst Du eigentlich gar nicht erkennen. Unzaehlige "
	"Aventurine, Rosenquarze, Rubine, Aquamarine, Topas, Smaragde, Saphire, "
	"Opale, Onyxe, Lapislazuli, Bernsteine, Granate, Bergkristalle, Apatite, "
	"Almandine, Achate, Tigeraugen, Turmaline, Zirkone, Amethyste, Dioptase, "
	"Diaspore, Cuprite, Citrine, Benitoite, Aventurine, Apophyllite, "
	"Tuerkise, Sugilithe, Pyrite, Peridote, Oktarine, Jaspise, Jadeite, "
	"Calcite und ein Diamant sind wild und ungeordnet an den Waenden verteilt");
  AddDetail( ({ "diamant" }),
    "Nur ein Diamant? Du schaust genauer hin.\nTatsaechlich, unter all den "
	"unterschiedlichen Edelsteinen gibt es nur einen einzigen Diamanten. "
	"Und dieser Diamant leuchtet nicht. Ausserdem scheint er locker zu sein.");  
 

  AddDetail( ({ "kreuzung" }),
    "Die Kreuzung im Osten sieht aus wie ein Pfeil.");
  AddDetail( ({ "pfeil" }),
    "Ein ->"); 
  AddDetail( ({ "" }),
    "");




  AddExit( "osten", GIER_ROOM + "gierlinge_3c.lpc" );  
  AddCmd( ({ "ziehe", "zieh" }), "ziehen" );
  AddCmd( ({ "drehe", "dreh" }), "drehen" );
  AddCmd( ({ "lockere", "locker", "loese" }), "lockern" );
  AddCmd( ({ "druecke", "drueck" }), "druecken" );

}

int ziehen(string str)

{ notify_fail("Woran willst Du ziehen?\n");

  if(str=="an diamant" || str=="diamant")
	{
  	  write("Du ziehst wild an dem kleinen Diamanten, rutschst aber immer wieder ab.\n");
	  say(TPN+" versucht einen Edelstein aus der Wand zu ziehen.\n",TP);
	  return 1;
	}
  return 0;
}

int druecken(string str)

{ notify_fail("Was moechtest Du druecken?\n");

if(str=="diamant")
	{
  	write("Du drueckst auf dem Diamant herum, aber nichts passiert.\n");
		say(TPN+" drueckt auf einen Edelstein an der Wand.\n",TP);
		return 1;
	}
	return 0;
}

int drehen(string str)

{ notify_fail("Was willst Du drehen?\n");

if(str=="diamant")
	{
		if (locker==1)
			{  	
				write("Du drehst den kleinen Diamanten, ploetzlich gleitet "+
				      "die Wand im Sueden zur Seite.\n");
				say(TPN+" fummelt an der Wand herum. Ploetzlich gleitet die "+
				    "Wand im Sueden zur Seite.\n");
	  		    SetProp( P_INT_LONG,
                   "Du befindest Dich in einer glitzernden Hoehle.  Es ist "+
				   "hier recht hell, denn die Waende leuchten glitzernd "+
				   "von sich aus. Hier endet der Gang scheinbar. Nach Osten "+
				   "gelangst Du zurueck auf die Kreuzung. Im Sueden kannst "+
				   "Du eine Wohnhoehle betreten." );
			    AddDetail( ({ "wohnhoehle" }),
    			  "Du denkst . o O (Seltsam, sonst verstecken die Gierlinge "+
				  "doch ihre Wohnhoehlen immer.\))");
				AddExit( "sueden", GIER_ROOM + "gierlinge_4b.lpc" );
				offen=1;
				return 1;
			}
		else
			{
				write ("Du versuchst den Diamanten zu drehen, er sitzt aber "
				       "wohl noch zu fest in der Wand.\n");
				say(TPN+" fummelt an der Wand herum.\n");
				return 1;
			}
	}
	return 0;
}

int lockern(string str)

{ notify_fail("Was moechtst Du lockern?\n");

if( str=="diamant")
	{
		if (locker==0)
			{
				write("Du lockerst den Diamant ein bisschen. Er laesst "
				      "sich nun sicher leicht drehen.\n");
				say(TPN+" fummelt an der Wand herum.\n");
				locker =1;
				return 1;}
		else
			 {
				write("Eigentlich ist der Diamant schon locker genug.\n");
				return 1;
		}
}
return 0;
}
