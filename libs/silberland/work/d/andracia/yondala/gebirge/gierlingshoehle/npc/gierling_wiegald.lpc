// Normalo Wiegald

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Wiegald der Gierling");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist Wiegald. Er ist ein Gierling. Er traegt einen gruenen Schlapphut, darunter "
    "schauen zottelige rote Haare hervor. An seinen Fuessen stecken braune Lederschuhe. "
    "An seinem Guertel haengt ein Goldsaeckchen. Seine Haut ist ungewoehnlich hell. ");//Langbeschreibung vom GIER_NPC wenn man ihn untersucht
  SetProp(P_NAME, "Wiegald");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"wiegald", "winzling"}));
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_schlapphut.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_beinlinge.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc"); 
  command("trage alles");
  CLONEME(GIER_WEAPON + "kobold_dolch.lpc");
  command("zuecke dolch");

  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));


  SetProp(P_ALIGN, -50);

  SetProp(P_MSGIN, "trippelt heran"); 
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "rutscht von einem Regenbogen");
  SetProp(P_MMSGOUT, "stampft dreimal auf den Boden und ist weg");


  SetProp(P_KILL_NAME, "Wiegald der Gierling");//name des tötenden npc
  AddInfo( ({ "wiegald" }),
    "Das bin ich.",
    "sagt: ");        


}

