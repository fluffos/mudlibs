#include "../def.h"
#include <moredef.h>
inherit "std/room";
#include <properties.h>



void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Wohnhoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer sehr ordentlichen Wohnhoehle, in der "
	"vermutlich eine Gierlingsfamilie beheimatet ist. Alles ist hier "
	"schoen aufgeraeumt. Viel ist ja auch nicht da." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "wohnhoehle", "hoehle", "hause" }),
    "Du befindest Dich in einer Hoehle, in der sicherlich eine "
	"Gierlingsfamilie zu Hause ist.");
  AddDetail( ({ "gierlingsfamilie" }),
    "Die ist vermutlich gerade nicht zu Hause.");  
  AddDetail( ({ "boden" }),
    "Der Boden ist aus Fels gehauen. Auf ihm liegt ein duenner Teppich.");
  AddDetail( ({ "teppich" }),
    "Der Teppich sieht sehr edel aus und wurde mit Goldfaeden bestickt.");
  AddDetail( ({ "goldfaeden" }),
    "Der kostbare Teppich ist mit Goldfaeden durchzogen.");
  AddDetail( ({ "decke"}),
    "Die Decke ist aus Fels gehauen. Ein blinkender Kronleuchter haengt "
	"dort.");
  AddDetail( ({ "kronleuchter" }),
    "Der Kronleuchter besteht aus Gold und Brillianten. Er scheint aber nur "
	"Deko zu sein, denn Kerzen siehst Du keine.");
  AddDetail( ({ "brillianten" }),
    "Die Brillianten funkeln und glitzern.");
  AddDetail( ({ "deko" }),
    "Der einzige Sinn dieses Kronleuchters scheint es zu sein, gut "
	"auszusehen.");
  AddDetail( ({ "sinn" }),
    "Macht das Sinn?");
  AddDetail( ({ "kerzen" }),
    "Sowas siehst Du da nicht, ehrlich.");
  AddDetail( ({ "" }),
    "");
	
  AddDetail( ({ "fels", "stein", "felswand" }),
    "Der Fels ist dunkel und grau, aber sehr glatt gearbeitet.");
  AddDetail( ({ "waende", "wand" }),
    "Diese Hoehle hat 1, 2, 3, 4 Waende die im rechten Winkel zueinander "
	"stehen. Drei der Waende wurden in den Stein gehauen, sie leuchten, "
	"wie auch die Waende draussen es tun.");
  AddDetail( ({ "wand 2", "wand2", "nordwand", "wand im norden" }),
    "Huch, die Felswand im Norden ist ja gar nicht real, Du kannst wohl "
	"einfach durch sie hindurchlaufen.");
  AddDetail( ({ "wand 3", "wand3", "ostwand", "wand im osten", "ursprung" }),
    "Eine Holzwand.");
  AddDetail( ({ "holzwand" }),
    "Hm, seltsam, normalerweise sind die Waende hier doch alle aus Fels... "
    "Diese Wand jedoch besteht komplett aus Holz. Sie sieht edel aus und "
	"hat eine schoene Maserung.");
  AddDetail( ({ "maserung" }),
    "Du betrachtest die feine Maserung, dabei faellt Dir ein kleines Loch auf.");
  AddDetail( ({ "loch" }),
    "Ein Loch in einer Holzwand. Sieht aus, als wuerde hier eine Tuerklinke "
	"fehlen. Man koennte vielleicht hindurchgucken...");
  AddDetail( ({ "wand 4", "wand4", "suedwand", "wand im sueden", "wand 1", "wand1", "westwand", "wand im westen" }),
    "Eine Felswand.");
  AddDetail( ({"winkel" }),
    "Ja, je zwei Waende bilden einen Winkel, auch als \"Ecke\" bezeichnet.");   
  AddDetail( ({"ecken", "vier", "ecke" }),
    "Vier an der Zahl, welche meinst Du?");   
  AddDetail( ({ "zahl" }),
    "1,2,3,4,5,6,7,8,9,0. Und morgen lernen wir das Alphabet.");
  AddDetail( ({ "alphabet" }),
    "abcdefghijklmnopqrstuvwxyz.");
  AddDetail( ({ "ecke 1", "ecke1" }),
    "In dieser Ecke steht ein Schrank.");
  AddDetail( ({ "Schrank" }),
    "Der Schrank ist aus Holz.");
  AddDetail( ({ "Holz" }),
    "Vermutlich aus den Elfenwaeldern importiert und von Elfen hergestellt.");
  AddDetail (({"elfenwaelder", "elfenwaeldern", "elfen"}),
    "Die kennst Du doch, oder?");  
  AddDetail( ({ "ecke 2", "ecke2" }),
    "Dort stehen ein Tisch und zwei Stuehle.");
  AddDetail( ({ "tisch" }),
    "Auf ihm steht benutztes Geschirr und eine Kerze.");
  AddDetail( ({ "stuehle", "stuhl"}),
    "Die beiden Stuehle sehen stabil aus und wurden aus Holz geschnitzt."); 
//Man soll sich setzen koennen
 
  AddDetail( ({ "geschirr" }),
    "Es scheint, als haette hier kuerzlich jemand was gegessen.");
  AddDetail( ({ "kerze" }),
    "Die Kerze ist fast komplett abgebrannt.");
  AddDetail( ({ "ecke 3", "ecke3" }),
    "Nix los.");
  AddDetail( ({ "ecke 4", "ecke4" }),
    "In dieser Ecke siehst Du eine Feuerstelle.");
  AddDetail( ({ "feuerstelle" }),
    "Das Feuer ist aus, ein blanker Kessel haengt ueber den erloschenen Kohlen.");
  AddDetail( ({ "kessel" }),
    "Der Kessel ist leer und sauber.");
  AddDetail( ({ "feuer" }),
    "Das Feuer ist aus.");    
  AddDetail( ({ "kohlen" }),
    "Die Kohlen sind grau. Sie scheinen schon einmal gebrannt zu haben.");
  AddDetail( ({ "raum" }),
    "Um den Raum genau untersuchen zu koennen, musst Du wohl hinein gelangen.");
  AddDetail( ({ "tuerklinke","klinke" }),
    "Wo bekommst Du die bloss her?");
  AddDetail( ({ "gold" }),
    "Das Gold wurde filigran und liebevoll bearbeitet.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");


  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Wimmern.");

  AddSound( ({ "wimmern" }),
    "Das Wimmern scheint seinen Ursprung hinter der Wand im Osten zu haben?");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Essen.");

  AddSmell( ({ "essen" }),
    "Was das wohl war?");
  AddDetail( ({ "essen" }),
    "Es ist kein Essen mehr da.");


  AddCmd(({"stecke","steck"}),"cmdStecken"); //Funktion
  AddCmd(({"guck", "gucke", "schau", "schaue"}), "guckenCmd"), 
  AddCmd(({"oeffne"}), "oeffnen"), 
  AddCmd(({"stehe","steh"}), "aufstehen"), 
  AddCmd(({"sitze","sitz","setze","setz"}), "sitzen"), 
  AddExit( "norden", GIER_ROOM + "gierlinge_3b.lpc" );



}

int sitzen(string str)
{
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if (str!="auf stuhl")return 0;
  if(TP->QueryProp(P_NOMOVE==
     "Du sitzt auf einem Stuhl und musst erst aufstehen.\n"))
	 {
	 write("Du sitzt doch schon auf einem Stuhl.\n");
	 return 1;
	 }
  else if(TP->QueryProp(P_NOMOVE))
    {
	 write(TP->QueryProp(P_NOMOVE));
	 return 1;
	 }
  else
    {
     write("Du setzt Dich auf einen Stuhl.\n");
     say(TPN+" setzt sich auf einen Stuhl.\n");
	 TP->SetProp(P_NOMOVE, "Du sitzt auf einem Stuhl und musst erst aufstehen.\n");
	 return 1;
	 }
}

int aufstehen(string str)
{
   notify_fail("Moechtest Du vielleicht aufstehen?\n");
    if (str!="von stuhl auf"&&str!="auf")return 0;
  if(TP->QueryProp(P_NOMOVE)==
     "Du sitzt auf einem Stuhl und musst erst aufstehen.\n")
	 {
	   write("Du stehst wieder auf.\n");
       say(TPN+" steht von einem Stuhl auf.\n");
       TP->SetProp(P_NOMOVE, 0);
	   return 1;
	 }
  else 
    {
	 write("Du sitzt doch gar nicht.\n");
	 return 1;
	 }
}

void tuer_zu()
{
  tell_room(this_object(), "Die Geheimtuer faellt wieder zu.\n");
  RemoveExit("osten");  
}
void tuer_auf()
{
   AddExit ( "osten", GIER_ROOM + "gierlinge_4c.lpc" );
   call_out("tuer_zu",4);
   
}
int cmdStecken(string str)
{ 
	string was;
	string worein;
	if( !str ) return 0;

	notify_fail("Was moechtest Du worein stecken?\n");
	sscanf(str, "%s in %s", was, worein);
	if(was!="klinke"&&was!="tuerklinke")
		return 0;
	if (worein != "loch") return 0;
 
	if(!present("klinke",TP))//Wenn der Spieler keine Klinke hat
	{ 
	   write("Du hast keine Klinke.\n");
	   return 1;
	   }
    if(find_call_out("tuer_zu")>=0)
	  {
        write("Die Geheimtuer ist doch schon auf.\n");
        return 1;
        }		
	   
   		write("Du steckst die Klinke in das Loch und drehst sie leicht.\n"+
		"Es oeffnet sich eine Geheimtuer.\n"+
		"Du nimmst die Klinke wieder an Dich.\n");
   		say( TPN + " oeffnet eine Geheimtuer.\n");
   		tuer_auf();
		call_other(GIER_ROOM+"gierlinge_4c","tuer_auf");
		return 1;
    			
}




int guckenCmd(string str)
{ notify_fail("Wo willst Du durchgucken?\n");
if(str=="durch loch" || str=="in loch")
{
		write("Du schaust durch das Loch. Hinter der Wand erkennst Du einen weiteren Raum.\n");
		say(TPN+" schaut durch ein Loch in der Wand.\n");

		return 1;
}



}

int oeffnen(string str)
{ notify_fail("Was moechtest Du oeffnen?\n");

	if(str=="schrank" || str=="schrank")
		{
			write("Du zerrst wild an der Schranktuer, bist aber scheinbar "+
			"nicht stark genug.\n");
			say(TPN+" zerrt an der Schranktuer.\n");
			return 1;
		}
}