// Der Eingang
#include <moredef.h>
#include "../def.h"

inherit "std/room";

#include <properties.h>




int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_gierlinge_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein goldgesprenkeltes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  /*if(call_other("/d/andracia/yondala/lunia/room/portal_master", 
                "einzelname_pruefen", "aboriville", TPN))*/

  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein goldgesprenkeltes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  return result;

}
//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er nach Aboriville teleportiert
int betreten(string str)
{
if(!testobgemacht(TPN))	return 0;			
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal"&&str!="goldgesprenkeltes portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das goldgesprenkelte Portal.\n");
  say(TPN+" betritt das goldgesprenkelte Portal.\n");
  TP->SetProp(P_PARALYZED, 0);
  TP->move( "/d/andracia/yondala/wolken/lunia/room/portalraum_gierlinge.lpc", M_NOCHECK);
  call_other("/d/andracia/yondala/wolken/lunia/room/portalraum_gierlinge", "wirbeltext", TP, 0, 1);
  
  return 1;
}

//Details fuer das Portal
string erlaubtenamen()
{
  string alle;
  if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";
  alle=	"Auf den Saeulen wurden folgende Namen eingepraegt:\n"+ read_file("/d/andracia/yondala/wolken/lunia/portale/portal_gierlinge_zugang.lpc");
	return alle;
}

string det_portal()
{
if(!testobgemacht(TPN)) return "Sowas siehst Du da nicht!\n";
				
return break_string("Du siehst ein Portal aus festem, leuchtendem Stein, der goldgesprenkelt ist. Es besteht "+
	    "aus einem goldgesprenkeltem Bogen, der auf zwei goldgesprenkelten Saeulen ruht. Ob man es betreten kann?\n"); 
} 

string det_bogen()
{
if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "In den Bogen wurde das Wort \"Lunia\" gepraegt.\n"; 
} 
string det_saeulen()
{
	if(!testobgemacht(TPN)) return "Sowas siehst Du da nicht!\n";
	return "In die Saeulen wurden Namen gedruckt.\n"; 
} 
string det_lunia()
{
if(!testobgemacht(TPN)) return "Sowas siehst Du da nicht!\n";

return "Was mag das nur bedeuten?\n"; 
} 




void create() 
{
  ::create();
  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "lunia" }),"det_lunia");
  AddSpecialDetail( ({ "saeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );
  
  
  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer seltsamen Hoehle. Um Dich herum ist es "
	"zwar recht hell und obwohl auch von oben noch Licht herein faellt, "
	"bist Du sicher, dass die Waende von sich aus leuchten. "
    "Nach Osten gelangst Du tiefer in die Hoehle, nach oben gelangst Du ans Tageslicht zurueck." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
     AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle. Was genau Dich erwartet "
	"kannst Du von hier aus nicht erkennen. Gehe nach Osten, um sie weiter "
	"zu erkunden!");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem Material, welches Du nie zuvor gesehen "
	"hast. Es sieht eigentlich aus wie normaler Stein, allerdings geht "
	"ein leichtes Leuchten von den Waenden aus, das Dich und die naehere "
	"Umgebung in sanftes Licht taucht.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");

  AddDetail( ({ "licht" }),
    "Es faellt etwas Tageslicht von oben herein, aber auch die Waende "
	"leuchten scheinbar von sich aus.");
  AddDetail( ({ "tageslicht" }),
    "Es faellt von oben herein.");
  AddDetail( ({ "umgebung" }),
    "Viel kannst Du von hier aus nicht erkennen. Nach Osten gelangst Du "
	"tiefer in die Hoehle, nach oben kannst Du sie wieder verlassen und zum Tageslicht zurueckkehren.");

  AddDetail( ({ "gang" }),
    "Die Hoehle ist eher ein Gang, wohin er fuehrt, kannst Du nicht erkennen.");

  AddDetail( ({ "osten" }),
    "Nach Osten gelangst Du tiefer in die Hoehle.");

  AddDetail( ({ "" }),
    ".");

  AddDetail( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Ein Gierling kommt an Dir vorbei gelaufen, tippt sich an den Hut "+
	  "und verschwindet im Gang.\n",
	  "Eine Gierlingfrau laeuft auf dem Weg nach draussen an Dir vorbei.\n",
	  "Ein Gierlingkind rennt kichernd um Dich herum und verschwindet "+
	  "wieder.\n"})
	  ,250,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst von draussen ein paar Voegel zwitschern. Aus der Hoehle "
	"dringen allerdings keine Geraeusche an Dein Ohr.");

  AddSound( ({ "ohr" }),
    "Hoert sich ohrig an.");
  AddSound( ({ "geraeusche" }),
    "Aus der Hoehle dringen keine Geraeusche hervor.");
  AddSound( ({ "voegel", "tschirp" }),
    "Von draussen erklingt das Zwitschern der Voegel.");
  AddSound( ({ "zwitschern" }),
    "Tschirp tschirp.");
  AddSound( ({ "hoehle" }),
    "Die Hoehle liegt still und geheimnisvoll vor Dir.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas staubig, ansonsten ist die Luft aber recht frisch.");

  AddSmell( ({ "luft" }),
    "Die Luft hier ist frischer, als es in anderen Hoehlen oft der Fall ist.");
  AddSmell( ({ "hoehlen" }),
    "In anderen Hoehlen ist die Luft meistens abgestanden.");
  AddSmell( ({ "fall", "hoehle" }),
    "In diesem Fall ist die Luft frisch.");
  AddSmell( ({ "staub" }),
    "Der Staub riecht wie ganz normaler Staub.");

  AddItem(GIER_NPC + "gierling_scrollan.lpc",REFRESH_DESTRUCT);
AddExit( "nordostunten", GIER_ROOM + "gierlinge_7c" );
AddExit( "nordosten", GIER_ROOM + "gierlinge_7c" );
//AddExit( "oben", "/d/gebirge/yason/wege/room/weg_kobolde_d4.lpc" );

AddExit( "oben", "/d/andracia/yondala/wege/room/kreuzung_01.lpc" );


SetProp(P_HIDE_EXITS, ({"nordosten"}) );
}


