// Die Post
// hier gibt es einen hebel den man ziehen kann um eine geheime Tuer zu 
// oeffnen
#include <moredef.h>
inherit "std/post";
#include <properties.h>
#include "../def.h"

int hebel_status =0;

string tuer_fkt()
{ if(hebel_status==1) 

	return "Man koennte hindurchgehen.\n"; 
	else return "Nur die, durch die Du gekommen bist.\n"; }

void reset()
{
	::reset();
	hebel_status=0;
	tell_room(TO,"Eine Tuer faellt ins Schloss.\n");
	RemoveExit("westen");
	RemoveDetail("tuer");	
}


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In der Gierlingspost");
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer Gierlingshoehle, die recht hell ist, obwohl Du keine Lichtquelle "
    "entdecken kannst. Vielmehr scheint dieses intensive Leuchten aus den Waenden selbst zu "
    "kommen. Du siehst zwei Schreibkabinen in denen Du Deine Postgeschaefte taetigen kannst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende scheinen von sich aus zu leuchten. Sie verbreiten ein sanftes Licht.");

  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus dem blanken Fels gehauen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen, mit Ausnahme der leuchtenden Waende.");

  AddDetail( ({ "gierlingshoehle", "hoehle" }),
    "Du befindest Dich in einer Gierlingshoehle, die recht hell ist, obwohl Du keine Lichtquelle "
    "entdecken kannst. Vielmehr scheint dieses intensive Leuchten aus den Waenden selbst zu "
    "kommen. Du siehst zwei Schreibkabinen in denen Du Deine Postgeschaefte taetigen kannst.");
 AddDetail( ({ "ecke", "ecken" }),
    "Diese Hoehle hat vier Ecken.");
  AddDetail( ({ "schreibkabinen","kabinen" }),
    "Die Kabinen stehen sehr dicht aneinander, sodass nur ein sehr kleiner Zwischenraum zu sehen ist.");
  AddDetail( ({ "zwischenraum" }),
    "Der Zwischenraum zwischen den Kabinen ist so eng, dass vermutlich nicht mal eine Hand "
    "dazwischen passt.");
  AddDetail( ({ "stock" }),
    "Ist wohl doch eher ein Hebel.");
  AddDetail( ({ "hebel" }),
    "Was kann man damit bloss tun?"); 
  AddSpecialDetail("tuer", "tuer_fkt");  
  AddDetail( ({ "oder" }),
    "Da ist Etwas.");
    
  AddDetail( ({ "hand", "sinn" }),
    "Wenn Du meinst, dass es Sinn macht, kannst Du ja versuchen, Deine Hand zwischen die Kabinen "
    "zu quetschen.");
  AddDetail( ({ "hebel" }),
    "Was man damit wohl machen kann?");
  AddDetail( ({ "leuchten" }),
    "Die Waende leuchten in einem satten Gelb.");
  AddDetail( ({ "gelb" }),
    "Du scheinst wirklich und wahrhaftig in der Post gelandet zu sein.");
  AddDetail( ({ "post","postgeschaefte" }),
    "Betrete eine der Kabinen und tippe <mail>");
  AddDetail( ({ "ausnahme","ausnahmen" }),
    "Ausnahmen bestaetigen die Regel.");
  AddDetail( ({ "regel" }),
    "Das ist eine Redewendung.");
  AddDetail( ({ "redewendung" }),
    "Eine Redewendung ist etwas, was haeufig gesagt wird.");

  AddSound( DEFAULT_SOUND,
    "Stille");

  AddSound( ({ "stille" }),
    "psst.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd(({"zieh","ziehe"}),"ziehenCmd"),
  AddCmd(({"quetsche","quetschen"}),"quetschen"),
  AddExit( "suedosten", GIER_ROOM + "gierlinge_2c.lpc" );

  

}

int ziehenCmd(string str)
{ notify_fail("Was willst Du ziehen?\n");
if(str=="hebel")
{
	if(hebel_status==0)
		{
			write("Du ziehst den Hebel.\nPloetzlich oeffnet sich eine Tuer.\n");
			say(TPN+" zieht einen Hebel.\nPloetzlich oeffnet sich eine Tuer.\n");
			hebel_status=1;
			AddExit ( "westen", GIER_ROOM + "gierlinge_1a.lpc"); 
			return 1;
		}
  else
  	{
		  write("Der Hebel wurde scheinbar schon umgelegt, Du kanst ihn nicht bewegen.\n");
		  return 1;
		}
	}
return 0;
}


int quetschen(string str)
{
	notify_fail("Was moechtest Du worein quetschen?\n");
	if(str=="hand in zwischenraum"||str=="hand zwischen kabinen")
		{
			write("Du quetscht Deine Hand zwischen die Kabinen und tastest "+
			      "etwas herum.\nDu ertastest einen kleinen Hebel.\n");
			say(TPN+" quetscht "+TP->QueryPossPronoun(FEMALE,WEN)+
			     " Hand zwischen die Kabinen.\n",TP);
			return 1;
		}
	return 0;
	}


