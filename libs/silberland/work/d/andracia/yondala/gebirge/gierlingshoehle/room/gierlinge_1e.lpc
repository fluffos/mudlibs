// fertig

// Ueberarbeitet am 7.2.2011
// Yondala@Silberland
// Bild an der Wand (Gierlinge in Dampfhoehle), 
// Gerueche und Geraeusche hinzugefuegt
// Ep Idee: rieche Harz
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer T-Kreuzung in einer glitzernden Hoehle. "
	"Es ist hier recht hell, denn die Waende leuchten glitzernd von sich "
	"im Sueden macht der Gang einen Knick, nach Westen gelangst Du tiefer "
	"in die Hoehle. "
    "Aus der Hoehle im Osten wabert Dir leichter Nebel entgegen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "dampfhoehle", "dampfraum", "sauna" }),
    "Die Dampfhoehle der Gierlinge liegt oestlich von Dir.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine T-Kreuzung, denn der Gang teilt sich "
	"hier in drei Richtungen, wie bei einem \"T\".");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nach Sueden, Osten und Westen gehen.");
  AddDetail( ({ "sueden" }),
    "Im Sueden macht der Gang einen Knick.");
  AddDetail( ({ "knick" }),
    "Naturgemaess kannst Du nicht sehen, was dahinter liegt, Du muesstest "
	"schon hingehen.");
  AddDetail( ({ "westen" }),
    "Nach Westen geht der Gang einfach geradeaus weiter, Du gelangst dort "
	"tiefer in die Hoehle.");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");
  AddDetail( ({ "nebel", "nebelschub" }),
    "Aus der Hoehle im Osten wabert Dir Nebel entgegen.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Auf dem Bild erkennst Du mehrere Gierlinge, die nackt auf Baenken "
	"um einige Steine herum sitzen von denen Dampf aufsteigt. \n"
    "Ueber dem Bild ist ein kleines Schild.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge sind sehr detailgetreu dargestellt: die kleinen "
	"rosafarbenen Koerper, die roten Haare, die kleinen weissen Handtuecher, "
	"die sie um die Hueften tragen.");
  AddDetail( ({ "koerper" }),
    "Die Koerper der abgebildeten Gierlinge bestehen aus jeder aus einem "
	"einzigen Rosenquarz.");
  AddDetail( ({ "haare" }),
    "Die roten Haare der abgebildeten Gierlinge wurden vermutlich aus "
	"Oktarinen, Rubinen und Jaspisen hergestellt, denn sie leuchten in "
	"unterschiedlichen Rottoenen.");
  AddDetail( ({ "rottoene" }),
    "Manche sind eher kraeftig leuchtend, andere eher etwas matt.");
  AddDetail( ({ "handtuecher" }),
    "Die Handtuecher wurden definitiv aus Diasporen gefertigt, da bist Du "
	"Dir sehr sicher.");
  AddDetail( ({ "baenke" }),
    "Die abgebildeten Baenke sind aus dunklem Holz gefertigt und in das "
	"Bild perfekt eingepasst worden.");
  AddDetail( ({ "holz" }),
    "Das Holz ist so dunkel, dass es fast schwarz ist. Es sieht sehr edel "
	"aus.");
  AddDetail( ({ "steine" }),
    "Die Steine auf dem Bild sind graeulich rot und haben grobe Poren.");
  AddDetail( ({ "poren" }),
    "Du vermutest, dass es sich dabei um Lavasteine handelt.");
  AddDetail( ({ "lavasteine" }),
    "Du bist Dir relativ sicher.");
  AddDetail( ({ "hueften" }),
    "Die Hueften der Gierlinge sind recht rund. Es scheint ihnen gut zu "
	"gehen.");
  AddDetail( ({ "dampf" }),
    "Der Dampf umwabert die Gierlinge auf dem Bild. Es scheint ihnen zu "
	"gefallen.");
  AddReadDetail( ({ "schild" }),
    "Dampfhoehle");
  AddDetail( ({ "schild" }),
    "Es steht etwas darauf geschrieben.");
  AddDetail( ({ "wege" }),
    "Nun, er laeuft halt weiter.");
  AddDetail( ({ "gierling" }),
    "Er ist schon davon gelaufen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hin und wieder ein leises Zischen.");

  AddSound( ({ "zischen" }),
    "Es scheint aus der Hoehle im OSten zu kommen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier sehr angenehm, irgendwie harzig.");

  AddSmell( ({ "harz", "geruch", "harzgeruch" }),
    "Wo kommt dieser Geruch nur her? Hoehlen riechen doch sonst nicht "
	"nach Harz.");
  AddSmell( ({ "hoehle","hoehle", "luft" }),
    "Von der Hoehle hier riechst Du nichts, nur dieser wohlige Harzgeruch "
	"haengt in der Luft.");

  AddRoomMessage( 
    ({"Ein rotgesichtiger Gierling kommt aus der Hoehle im Osten und geht froehlich seiner Wege.\n",
	  "Ein neuer Nebelschub wabert aus der Hoehle im Osten.\n",
	  "Ein Gierling laeuft an Dir vorbei und betritt die Hoehle im Osten.\n"}),550);

  AddExit( "osten", GIER_ROOM + "gierlinge_1f.lpc" );
  AddExit( "westen", GIER_ROOM + "gierlinge_1d.lpc" );  
  AddExit( "sueden", GIER_ROOM + "gierlinge_2e.lpc" );  
  

}
