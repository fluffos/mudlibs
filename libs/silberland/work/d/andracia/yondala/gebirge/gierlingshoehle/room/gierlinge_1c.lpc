// Bild an Wand: Gierlinglehrer mit Schuelern


#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

	
  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Hier macht der Gang "
	"einen Knick. Du kannst nach Osten und nach Sueden gehen." );
 AddItem(GIER_NPC + "gierling_normalo.lpc",REFRESH_DESTRUCT);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "sueden" }),
    "Im Sueden gabelt sich der Weg zu einer Y-Kreuzung.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nur in zwei Richtungen gehen: Sueden und Osten.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine Y-Kreuzung, denn der Gang teilt sich "
	"dort in drei Richtungen, wie bei einem \"Y\".");

  AddDetail( ({ "osten" }),
    "Nach Osten fuehrt der Gang geradeaus weiter, es ist nicht hell genug, "
	"um mehr zu sehen.");

  AddDetail( ({ "y" }),
    "Ein \"Y\", weisst schon.");

  AddDetail( ({ "knick" }),
    "Der Gang macht hier einen Knick und fuehrt einerseits nach Osten, andrerseits nach Sueden.");
   
  AddDetail( ({ "weg" }),
    "Der Gang ist hier der Weg.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");
  AddDetail( ({ "bild" }),
    "Alle Edelsteine zusammen stellen eine Gruppe kleiner Gierlinge dar, "
	"die sich um einen aelteren Gierling versammelt haben.");
  AddDetail( ({ "gierling","gierling in bild","aelterer gierling", "alter gierling" }),
    "Der aeltere Gierling sitzt auf einem Felsen, sein Mund ist geoeffnet "
	"und der Zeigefinger seiner rechten Hand ist erhoben.");
  AddDetail( ({ "felsen" }),
    "Ein einfacher Felsen.");
  AddDetail( ({ "mund" }),
    "Der Mund des Gierlings ist geoeffnet Du hast den Eindruck, dass es "
	"sich um einen Lehrer handelt.");
  AddDetail( ({ "lehrer" }),
    "Wenn der aeltere Gierling der Lehrer ist, dann sind die jungen "
	"Gierlinge wohl seine Schueler.");
  AddDetail( ({ "schueler" }),
    "Die Schueler sitzen rund um ihren Lehrer auf dem Boden und lauschen "
	"gebannt den Worten ihres Lehrers.");
  AddDetail( ({ "hand" }),
    "Die Hand des Lehrers wurde definitiv aus Rosenquarz hergestellt.");
  AddDetail( ({ "zeigefinger" }),
    "Um seine Worte zu unterstreichen fuchtelt der Lehrer mit dem "
	"Zeigefinger vor den Nasen seiner Schueler herum.");
  AddDetail( ({ "nasen" }),
    "Du staunst, wie fein die rosenquarzenen Nasen der Schueler gearbeitet "
	"sind.");
  AddDetail( ({ "eindruck" }),
    "Nun, sicher bist Du nicht, aber es sieht so aus.");
  AddDetail( ({ "gruppe" }),
    "Die Gruppe besteht aus mehreren Gierlingen. Einer sitzt in der Mitte, "
	"die anderen drum herum.");
  AddDetail( ({ "mitte" }),
    "Mitten zwischen den juengeren Gierlingen sitzt ein aelterer auf einem "
	"Felsen.");
  AddDetail( ({ "gierlinge" }),
    "Du siehst mehrere Gierlinge auf dem Bild, wobei die juengeren um "
	"einen aelteren herum sitzen.");
  AddDetail( ({ "worte" }),
    "Worte kann man nicht sehen. In diesem Fall nicht einmal hoeren, weil "
	"es sich ja um ein Bild handelt.");
  AddDetail( ({ "fall" }),
    "In diesem Fall ist das so.");





/*
	
 
 
    
  AddReadDetail( ({ "" }),
    "");


  AddSound( DEFAULT_SOUND,
    "");
*/
  AddSound( ({ "worte","bild" }),
    "Es ist nur ein Bild, Du kannst die Worte nicht hoeren.");
  /*AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

*/


  AddExit( "osten", GIER_ROOM + "gierlinge_1d.lpc" );
  AddExit( "sueden", GIER_ROOM + "gierlinge_2c.lpc" );  

  

}

