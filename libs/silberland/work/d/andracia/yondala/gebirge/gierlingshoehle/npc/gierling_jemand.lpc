    "Du siehst einen Gierling, der normaler nicht sein koennte.");
  SetProp(P_NAME, "Jemand");
  SetProp(P_GENDER, MALE);
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"");
  SetProp (P_MNPC_AREA, ROOM );
  SetProp (P_MNPC_FLAGS, MOV_BACKWARDS + MOV_INDOORS);
  SetProp (P_MNPC_WAIT, ({50, 10, 5}));
  SetProp(P_WIMPY,0);
  AddInfo( ({""}), 
