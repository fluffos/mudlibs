#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tuerklinke");
  SetProp(P_LONG,
    "Eine Tuerklinke aus Metall." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Tuerklinke");
  SetProp(P_GENDER, 0);
  AddId(({"klinke","tuerklinke"}));

  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

//  AddCmd(({"stecke","steck"}),"cmdStecken"); //Funktion
}

int cmdStecken(string str)
{ 
	string was;
	string worein;
	object raum;
	int richtig;
	if( !str ) return 0;

	notify_fail("Was moechtest du worein stecken?\n");
	sscanf(str, "%s in %s", was, worein);
	if(was!="klinke"&&was!="tuerklinke")
		return 0;
	if (worein != "loch") return 0;
 
	raum = environment(this_player());
  richtig = call_other(raum, "tuer_auf");
  if(richtig == 1)
  	{
   		write("Du oeffenest die Geheimtuer.\n");
   		say( TPN + " oeffnet eine Geheimtuer.\n");
   		this_object()->remove();
   		return 1;
    	}
    else
      {
      		write("Das funktioniert hier nicht.\n");
      		return 1;
      	}
    
}
