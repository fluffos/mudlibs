#include "../def.h"
#include <moredef.h>
#include <properties.h>
#include <exploration.h> //vergibt Forscherpunkte


inherit "std/thing";
int a = random (4);
string b;
string dummy;	
object werstina; 

void stinagefunden(object spieler)
{
	    EPMASTER->GiveExplorationPoint("stinagefunden", EP_MISC);
}

void versteckmich(object ob)
{
  werstina=ob;
  }
  
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "stinaversteck");
  SetProp(P_GENDER, MALE);
  AddId(({"versteck","\nversteck"}) );

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);

  
AddCmd(({"such", "suche"}), "suchenCmd");
AddCmd(({"wo"}), "woCmd");
AddCmd(({"was"}), "wasCmd");
}

woCmd()
{	write( "Testi: "+a + " \n");
	return 1;
}

wasCmd()
{	b = file_name(environment(TP));
	write( "Test: "+ b + " \n");
	return 1;
}


int suchenCmd(string str )
{	
string text;
if(!str) return 0;
//	notify_fail( "Wen moechtest Du wo suchen?\n" );
//	write( "Test: "+file_name(environment(TP)) );
	if(str=="stina")
	{
	  write("Wo genau moechtest Du Stina denn suchen?\n");
	  return 1;
	  }
	if (sscanf(str, "stina %s", text)!=1) return 0;
	
	
	if( a==0&&file_name(environment(TP)) == GIER_ROOM+"gierlinge_5a")
	{
	    if( str=="stina hinter fass" || str=="stina hinter dem fass" || str == "stina hinter einem fass" )
	        {
 			    write("Du beugst Dich vor und schaust hinter das Fass. "+
	  			"Tatsaechlich hockt die kleine Stina dort und freut sich.\n");
				say( TPN+"findet Stina.\n");
				werstina-> move(environment(TP),M_GO);
				werstina->finden(TP);
				EPMASTER->GiveExplorationPoint("stinagefunden", EP_MISC);
				remove();
				return 1;
			}
	}
	
	else if( a == 1 && file_name(environment(TP)) == GIER_ROOM+"gierlinge_4c" ) 
	{
		if( str=="stina unter bett" || str=="stina unterm bett" || str == "stina unter dem bett" )
			{
				write("Du kniest Dich hin und schaust unter das Bett.\n"+
	  			"Tatsaechlich liegt dort die kleine Stina und freut sich.\n");
    			say( TPN+" findet Stina.\n");
				werstina-> move(environment(TP),M_GO);
				werstina->finden(TP);
				remove();
				return 1;
			}
	}			
				
					
	else if( a == 2 && file_name(environment(TP)) == GIER_ROOM+"gierlinge_3f" ) 
		{
			if( str=="stina hinter tresen" || str=="stina hinter dem tresen" || str == "stina hinterm tresen" )
				{
					write("Du beugst Dich vor und schaust hinter den Tresen.\n"+
						  "Tatsaechlich sitzt die kleine Stina dort und freut sich.\n");
					say( TPN+" findet Stina.\n");
					werstina-> move(environment(TP),M_GO);
					werstina->finden(TP);
					EPMASTER->GiveExplorationPoint("stinagefunden", EP_MISC);
					remove();
					return 1;
				}
		}		

	else if( a == 3 && file_name(environment(TP)) == GIER_ROOM+"gierlinge_2b" ) 
		{
			if( str=="stina in werkzeugkiste" || str=="stina in der werkzeugkiste" )
				{
				    write("Du oeffnest die Werkzeugkiste und findest die kleine Stina dort ganz klein zusammengekauert. \n"+
						  "Stina klettert froehlich aus der Kiste.\n");
    		        say( TPN+" findet Stina.\n");
 			        werstina-> move(environment(TP),M_GO);
			        werstina->finden(TP);
			        remove();
	 			    EPMASTER->GiveExplorationPoint("stinagefunden", EP_MISC);
					return 1;
  				    }
		}

	else 
		{
			write("Da findest Du Stina nicht.\n");	
			return 1; 
		} 
}
