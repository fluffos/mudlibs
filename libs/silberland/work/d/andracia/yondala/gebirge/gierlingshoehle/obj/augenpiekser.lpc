//wird geclont, um sicher zu stellen, dass sich nur der richtige Spieler
//vor dem Augenpieksen schuetzen kann

//Yondala@Silberland, 19.12.2011

#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>


void weg()
{remove();}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"AUGENPIEKSER"}));

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  call_out("weg",5);
}






	
	
	
	
	
	
	
	
    