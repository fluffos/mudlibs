// Das Lager
#include <moredef.h>
#include "../def.h"
inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Lager" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Lager des Kramladens von Tante Emma. Es steht "
	"allerlei Zeug herum, sodass Du Waende und auch den Boden kaum sehen "
	"kannst. Emma scheint sich schwer von Dingen trennen zu koennen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "lager", "raum" }),
    "Du befindest Dich im vollgestopfen Lager des Ladens von Tante Emma.");
  AddDetail( ({ "ladens","laden", "kramladen", "kramladens" }),
    "Der Laden liegt oestlich von hier, Du bist durch ihn gegangen um hierherzu gelangen.");
  AddDetail( ({ "wand","waende","waenden" }),
    "Die glitzernden Waende kann man kaum sehen, denn sie werden durch "
    "grosse, vollgestopfte Regale verborgen. ");
  AddDetail( ({ "zeug", "zeugs" }),
    "Hier lagern hauptsaechlich unterschiedlichste Behaelter, Taschen und "
	"Saecke aber auch Haushaltsartikel, Spiele, Kleidung, Nahrung, Waffen, "
	"Ruestungen und so weiter. Wobei die meisten Sachen nicht so aussehen, "
	"als waeren sie noch verkaufbar. Emma scheint nicht gerne von Dingen "
    "trennen zu koennen.");
  AddDetail( ({ "haushaltsartikel" }),
    "Alles, was man so zum leben braucht.");
  AddDetail( ({ "spiele" }),
    "Unterhaltsame Spiele fuer zwischendurch.");
  AddDetail( ({ "kleidung" }),
    "Damit Spieler auch ordentlich angezogen sind um sich vor Hitze, "
	"Kaelte, Blicken und Schlaegen zu schuetzen.");
  AddDetail( ({ "hitze" }),
    "In der Wueste zum Beispiel ist es sehr heiss, da benoetigt man eher "
	"luftige Kleidung.");
  AddDetail( ({ "wueste" }),
    "Die Wueste ist sehr weit weg von hier.");
  AddDetail( ({ "kaelte" }),
    "In Polarregionen braucht man warme Kleidung.");
  AddDetail( ({ "polarregionen" }),
    "Gut, dass es hier nicht so kalt ist wie in einer Polarregion.");
  AddDetail( ({ "blicke" }),
    "Nun, wenn Du nackt durch die Welt laeufst, wird man Dir schon den "
	"ein oder anderen blick zu werfen.");
  AddDetail( ({ "welt" }),
    "Das ist das, wo Du Dich gerade befindest: Die einzig wahre Welt.");
  AddDetail( ({ "blick" }),
    "Manch Blick wird luestern sein, der ein oder andere empoert oder "
	"belustigt. Dagegen hilft nur Kleidung.");
  AddDetail( ({ "schlaege" }),
    "Ohja, Schlaege gibt es haufig in dieser Welt. Deswegen ist eine gute "
	"Ruestung sehr wichtig.");
	
  AddDetail( ({ "spieler" }),
    "Du bist ein Spieler im SilberLand, derzeit in der Region Andracia.");
  AddDetail( ({ "andracia" }),
    "Schoen hier, oder?");
  AddDetail( ({ "silberland" }),
    "Do heisst diese Welt hier.");
  AddDetail( ({ "region","regionen" }),
    "Diese Welt ist unterteilt in mehrere Regionen. Diese hier nennt sich "
	"Andracia.");
	
  AddDetail( ({ "taschen", "behaelter", "saecke" }),
    "Etwas, was sich dazu eignet Dinge darin zu transportieren.");
  AddDetail( ({ "nahrung" }),
    "Nahrung ist sehr wichtig, um die eigene Lebensenergie wieder aufzutanken.");
  AddDetail( ({ "lebensenergie" }),
    "Achte stets darauf, sonst stirbst Du.");
  AddDetail( ({ "waffen" }),
    "Mit Waffen verteigt man hier Leben und Ehre.");
  AddDetail( ({ "leben", "ehre" }),
    "Dumm, wenn man eins davon verliert.");
  AddDetail( ({ "kleidung","ruestungen","ruestung" }),
    "Kleidung und Ruestungen kleiden und schuetzen die Spieler in Andracia.");
  AddDetail( ({ "dinge","sachen","dingen" }),
    "Hier alles aufzuzaehlen wuerde zu weit gehen.");
  AddDetail( ({ "emma", "tante" }),
    "Emma gehoert der Kramladen, durch den Du gekommen bist.");
  AddDetail( ({ "maus","mauese" }),
    "Auch wenn Du gerade keine siehst, bist Du sicher, dass es sie gibt.");
  AddDetail( ({ "fuss" }),
    "Dein Fuss sieht angeknabbert aus und waschen koenntest Du ihn auch "
	"mal wieder, aber ansonsten ist alles gut.");
 AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus Fels gehauen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen. Nur die Waende leuchten "
	"durch den Kram hindurch.");
  AddDetail( ({ "regal", "regale" }),
    "Die Regale sind vollgestopft mit diversem Zeugs.");    
  AddDetail( ({ "fiepen" }),
    "Meinst Du ehrlich, dass man \"Fiepen\" sehen kann?");
  AddDetail( ({ "stapel" }),
    "Die Dinge hier im Lager stapeln sich bis unter die Decke.");
  AddDetail( ({ "maeuse" }),
    "Sehen kannst Du sie nicht. Oder zumindest nur selten, wenn sich eine "
	"herauswagt und ueber den Boden flitzt.");
  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Ab und an hoerst Du ein leises Fiepen.");

  AddSound( ({ "knabber" }),
    "Sind sicher Maeuse hier unten.");
  AddDetail( ({ "maeuse", "maus" }),
    "Hin und wieder hoerst Du, wie eine Maus an irgendetwas knabbert.");
  AddSound( ({ "fiepen" }),
    "Hoert sich an, als gaebe es hier Mauese.");
  AddSound( ({ "maeuse" }),
    "Man sieht sie nicht immer, aber man hoert ihr Fiepen.");
	

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig, die Luft scheint abgestanden. Ausserdem "
	"riecht es nach Hanf.");

  AddSmell( ({ "luft" }),
    "Lueften wird auch ueberbewertet.");
  AddSmell( ({ "hanf" }),
    "Hier lagern einige Saecke und Taschen, die unter anderem aus Hanf "
	"hergestellt wurden. Daher riecht es hier danach.");
  AddSmell( ({ "taschen","saecke" }),
    "Die riechen nach Hanf. Sie sind nicht konsumierbar.");

  AddRoomMessage( 
    ({"Eine kleine Maus versucht Deinen Fuss anzuknabbern.\n", 
    	"Du hoerst ein leises Knabbern.\n",
		"Irgendwo knistert es leise.\n"}),550,"func"); 

  AddExit( "sueden", GIER_ROOM + "gierlinge_6b.lpc" );
  AddExit( "westen", GIER_ROOM + "gierlinge_5a.lpc" );
  AddExit( "suedwesten", GIER_ROOM + "gierlinge_6a.lpc" );  
  AddCmd( ({"konsumiere","konsumier"}), "konsumieren" );  


}

int konsumieren(string str)
{
  notify_fail("Was moechtest Du konsumieren?\n");
  if(str=="taschen"||str=="tasche")
  {  
    write("Du versuchst eine der Taschen zu konsumieren, scheiterst aber.\n");
	say(TPN+" macht sich an eine der Taschen zu schaffen.\n");
	return 1;
	}
 if(str=="saecke"||str=="sack")
  {  
    write("Du versuchst einen der Saecke zu konsumieren, scheiterst aber.\n");
	say(TPN+" macht sich an einem der Saecke zu schaffen.\n");
	return 1;
	}
	
  return 0;
}  



