// Bild an der Wand hinzugefuegt (Gierlinge an Tresen)
// EPIDEE: Besitzer
#include "../def.h"
#include <moredef.h>
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer T-Kreuzung in einer glitzernden Hoehle. "
	"Es ist hier recht hell, denn die Waende leuchten glitzernd von sich "
	"aus. Aus dem Osten dringt leise Musik zu Dir." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(GIER_NPC + "gierling_normalo.lpc",REFRESH_DESTRUCT);
  
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass es einen geben muss.");

  AddDetail( ({ "osten" }),
    "Im Osten ist der Eingang zu einem Hoehlenraum.");
  AddDetail( ({ "westen" }),
    "Westlich von Dir macht der Gang einen Knick, sodass Du nicht sehen "
	"kannst, was dahinter liegt.");
  AddDetail( ({ "suedwesten" }),
    "Suedwestlich von Dir macht der Gang einen Knick, sodass Du nicht sehen "
	"kannst, was dahinter liegt.");
  AddDetail( ({ "knick" }),
    "Der Gang verlaeuft nicht gerade, sodass Du nicht sehen kannst, was "
	"hinter dem Knick ist.");
  AddDetail( ({ "kreuzung" }),
    "Es handelt sich dabei um eine T-Kreuzung, denn der Gang teilt sich "
	"hier in drei Richtungen, wie bei einem \"T\".");
  AddDetail( ({ "t" }),
    "Ein \"T\", weisst schon.");
  AddDetail( ({ "richtungen" }),
    "Von hier aus kannst Du nach Suedwesten, Westen und Osten gehen.");
  AddDetail( ({ "eingang" }),
    "Ueber dem Eingang wurde ein kleines Schild befestigt.");
  AddDetail( ({ "schild" }),
    "Genau genommen ist es ein Brett, in das feinste Diamanten eingelassen "
	"wurden. Du kannst es lesen.");
  AddDetail( ({ "brett" }),
    "Das Brett ist aus Ebenholz.");
  AddDetail( ({ "ebenholz" }),
    "Edel und schwarz ist das Ebenholz, aus dem das Schild gefertig wurde.");
  AddReadDetail( ({ "schild" }),
    "\"Goldener Humpen\"");
  AddDetail( ({ "goldenen humpen", "goldener humpen", "humpen", "goldener" }),
    "Du denkst . o O ( Hoert sich irgendwie nach Kneipe an)");
  AddDetail( ({ "kneipe" }),
    "Sie scheint im Osten zu sein. Geh doch hinein.");
  AddDetail( ({ "bild" }),
    "Das Bild stellt sehr detailgetreu einige Gierlinge dar, die gemuetlich "
	"an einem Tresen sitzen und sich ein Bier schmecken lassen.");
  AddDetail( ({ "gierlinge" }),
    "Die Gierlinge sitzen allesamt auf Barhockern und haben jeder einen "
	"Krug in der Hand. Zwei stossen gerade miteinander an, die anderen "
	"schauen zufrieden vor sich hin.");
  AddDetail( ({ "hocker","barhocker" }),
    "Die Barhocker sind schmal und hoch, sodass die Gaeste mit den Fuessen "
	"baumeln.");
  AddDetail( ({ "gaeste" }),
    "Die Gierlinge sind vermutlich Gaeste in einer Kneipe.");
  AddDetail( ({ "fuesse" }),
    "Die Fuesse der auf dem Bild dargestellten Gierlinge baumeln knapp "
	"ueber dem Boden.");
  AddDetail( ({ "bier" }),
    "Das Bier in den Kruegen der Gierlinge wurde aus vielen funkelnden "
	"Apophyllit dargestellt. Es ist spritzig gelb.");
  AddDetail( ({ "hand" }),
    "Jeder Gierling auf dem Bild haelt einen Krug in der Rosenquarzhand.");
  AddDetail( ({ "rosenquarzhand", "haende" }),
    "Die Haende der Gierlinge, sowie auch der Rest ihrer Haut wurden aus "
	"rosanen Rosenquarzen gefertigt.");
  AddDetail( ({ "rest" }),
    "Alles andere auch.");
  AddDetail( ({ "haut" }),
    "Die Haut der abgebildeten Gierlinge wurde aus Rosenquarzen gefertigt.");
  AddDetail( ({ "krug","kruege" }),
    "Die Kruege auf dem Bild sind durchsichtig. Bestimmt wurden sie aus "
	"feinsten Diamanten gefertigt.");
  AddDetail( ({ "tresen" }),
    "Um den Tresen naturgetreu nachzubilden wurde echtes Holz in die "
	"Wand eingepasst. Und es sieht wirklich gut aus. Neben dem Tresen "
	"steht ein kleiner Floetespielender Gierling.");

  AddDetail( ({ "holz" }),
    "Es handelt sich dabei vermutlich um Mahagoni.");
  AddDetail( ({ "mahagoni" }),
    "Mahagoni ist ein sehr edles und teures Holz.");
  AddDetail( ({ "hoehlenraum" }),
    "Du vermutest, dass es sich dabei um eine Kneipe handelt.");
  AddDetail( ({ "kneipe" }),
    "In einer Kneipe warst Du schon lange nicht mehr. Jetzt merkst Du erst, "
	"wie durstig Du bist.");
  AddDetail( ({ "floete" }),
    "Die Floete besteht aus reinem Silber und ihr Besitzer entlockt ihr "
	"vermutlich die herrlichsten Melodien.");
  AddDetail( ({ "melodien" }),
    "Melodien kann man eher selten sehen.");
  AddDetail( ({ "besitzer","floetenspieler" }),
    "Der Floetenspieler scheint beim musizieren zu tanzen, sogar auf dem Bild "
	"nimmst Du die Bewegung war.");
  AddDetail( ({ "bewegung" }),
    "Als Du naeher hinguckst siehst Du, dass sich die Beine des "
	"Floetenspielers je nach Blickwinkel des Betrachters veraendern. Du "
	"bist also einer optischen Taeuschung aufgesessen.");
  AddDetail( ({ "blickwinkel" }),
    "Mal scheinen sie nach rechts zu schwingen, mal nach links. Wirklich "
	"meisterlich.");
  AddDetail( ({ "betrachter" }),
    "Du.");
  AddDetail( ({ "taeuschung" }),
    "Eine wirklich gut gemachte, optische Taeuschung.");
  AddDetail( ({ "kurve" }),
    "im Nordosten geht der Gang nicht gerade weiter, sondern kruemmt sich.");
  AddDetail( ({ "weg" }),
    "Der Gang ist der Weg in dieser Hoehle.");
  AddDetail( ({ "" }),
    "");

    
  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Aus dem Osten hoerst Du leise Musik");
  AddSound( ({ "musik", "osten" }),
    "Ganz verzueckt lauscht Du der Musik und wuerdest sie so gerne lauter "
	"hoeren.");
  AddSound(({"melodien", "melodie"})),
    "Also echt, das ist nur ein Bild, Du kannst die Melodie nicht "
	"wirklich hoeren.";
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier etwas muffig.");

  AddSmell( ({ "" }),
    "");


  AddExit( "osten", GIER_ROOM + "gierlinge_3f.lpc" );
  AddExit( "westen", GIER_ROOM + "gierlinge_3d.lpc" );  
  AddExit( "suedwesten", GIER_ROOM + "gierlinge_4d.lpc" );
  

}

