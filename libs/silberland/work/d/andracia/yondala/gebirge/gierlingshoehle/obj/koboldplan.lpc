void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Karte der Koboldstadt");
  SetProp(P_LONG,
    "mit \"karte\" kannst Du Dir die Karte anschauen." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Karte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"karte"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 0);

  AddCmd(({"karte"}),"karteCMD"); //Funktion
}

