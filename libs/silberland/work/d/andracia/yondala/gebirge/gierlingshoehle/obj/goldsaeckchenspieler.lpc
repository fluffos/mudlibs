int klach(string str)
{
	int i;
	object *kobolde;
	object kobold;
	if(!str)
		{
			kobolde=filter_array(users(),"check_if_kobold");//finde alle spieler
			for(i=sizeof(kobolde)-1;i>=0;i--)
				tell_object(kobolde[i], "Kobold"+koboldsex()+" "+TPN+" lacht Euch aus der Ferne zu.\n");
	
			write("Du lachst allen Kobolde aus der Ferne zu.\n");
		}
	else
		{
			if(kobold=find_living(str))
				{
					tell_object(kobold, "Kobold"+koboldsex()+" "+TPN+" lacht Dir aus der Ferne zu.\n");
