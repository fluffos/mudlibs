int check_if_kobold(object spieler)
{  
	if (spieler!=TP)
	return spieler->id("Koboldspieler");
	else return 0;
	}

int krufe(string aktStr)
{
  int i;
	object *kobolde;
	object kobold;

	notify_fail("Was moechtest Du den anderen Kobolden mitteilen?\n");
	aktStr = this_player()->_unparsed_args();	// verhindert das die mudlib den Text parsed
	if (!aktStr) return 0;
	
//	call_other("/d/tal/yondala/aboriville/obj/zweigmaster.lpc","jemandruft", aktStr, TP);//soll spaeter in den Gildenraum

	kobolde=filter_array(users(),"check_if_kobold");//finde alle spieler

			for(i=sizeof(kobolde)-1;i>=0;i--)
				tell_object(kobolde[i],"Kobold"+koboldsex()+" "+TPN+" ruft Euch zu: "+aktStr+"\n");

			write("Du rufst den Kobolden zu: "+aktStr+"\n");
	 
 	 return 1;

	}

//ab hier noch anpassen

int kknuddel(string str)
{
	int i;
	object *kobolde;
	object kobold;
	if(!str)
		{
			kobolde=filter_array(users(),"check_if_kobold");//finde alle spieler
			for(i=sizeof(kobolde)-1;i>=0;i--)
				tell_object(kobolde[i],"Kobold"+koboldsex()+" "+TPN+" knuddelt Euch aus der Ferne.\n");
			write("Du knuddelst alle Kobolde aus der Ferne.\n");
		}
	else
		{
			if(kobold=find_living(str))
				{
					tell_object(kobold, "Kobold"+koboldsex()+" "+TPN+" knuddelt Dich aus der Ferne.\n");
					write("Du knuddelst "+capitalize(str)+" aus der Ferne.\n");
				}
			else
				write("Wen moechtest Du aus der Ferne knuddeln?\n");
			}
 	 
 	 return 1;

}

