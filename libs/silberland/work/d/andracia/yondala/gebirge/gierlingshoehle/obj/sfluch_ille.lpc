// Sprachfluch des Gierlingkoenigs



#include "../def.h"

inherit "std/thing";

object owner;


void weg()
{
  if(!present("\nille 2"))
  {
    tell_object(environment(TO),"Deine Zunge loest sich wieder.\n");
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
	}
  //else tell_object(environment(TO),"Mehr als einer.\n");
    
  remove();
  }
create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,0);
SetProp(P_LONG,0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );

  AddId ( ({"\nille","NODESTRUCT","UNZERSTOERBAR"}) );
  owner=0;
  call_out("weg",300);
}

init()
{
  ::init();
  if (owner && interactive(owner))
     {
            owner->SetProp(P_PERM_STRING, 0);
            owner=0;
     }
  if (environment()==TP)
     {
           owner=TP;
           owner->SetProp(P_PERM_STRING, this_object());
     }

}

string permutate_string(string str)
{
  string *woerter;
  string transformed;

  woerter=new_explode(str,"a");
  str=implode(woerter,"alle");

  woerter=new_explode(str,"A");
  str=implode(woerter,"Alle");

  woerter=new_explode(str,"e");
  str=implode(woerter,"elle");

  woerter=new_explode(str,"E");
  str=implode(woerter,"Elle");

  woerter=new_explode(str,"i");
  str=implode(woerter,"ille");

  woerter=new_explode(str,"I");
  str=implode(woerter,"Ille");

  woerter=new_explode(str,"o");
  str=implode(woerter,"olle");

  woerter=new_explode(str,"O");
  str=implode(woerter,"Olle");

  woerter=new_explode(str,"u");
  str=implode(woerter,"ulle");

  woerter=new_explode(str,"U");
  str=implode(woerter,"Ulle");

   transformed = str;

  return transformed;
}

