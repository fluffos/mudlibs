#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>

string abbild;//mit welchem Spieler setzt sie sich in Verbindung?

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Statue");
  SetProp(P_LONG,
    "Eine Statue aus Gold." );
  SetProp(P_INFO, "Die Statue glueht foermlich vor Magie.\n"+
                  "Immer, wenn Du an der Statue reibst, setzt sie sich mit "+
				  "ihrem Abbild in Verbindung, um dessen Befinden zu "+
				  "erkunden.");
  SetProp(P_NAME, "Statue");
  SetProp(P_GENDER, FEMALE);
  AddId(({"statue"}));

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 15000);
  SetProp(P_VALUE, 5000);
  AddCmd( ({"reibe","reib"}), "reiben");
}


void namensfindung(string spielername)
{
  SetProp(P_SHORT, "Eine "+capitalize(spielername)+"statue");
  SetProp(P_LONG,
    "Du siehst eine Statue aus purem Gold. Sie ist zwar etwas kleiner als "
	"das Original, aber sie sieht genauso aus wie "+capitalize(spielername)+
	".\nWas es damit wohl auf sich hat?" ); 
  abbild=spielername;

}


/***************************************************************
Beine: Erschoepfung
Bauch: Hunger
Hals:  Durst
Ohren: taub
Augen: Blind
Ruecken:Tragestatus
Stirn: Gift? (Malaria?)

Noch moegliche Alternativen:
Haende:Waffen
Kopf:  
Arme:
Fuesse:

Brust:
Hintern:
Nase:
Kinn:
Knie:
Finger:Handschuhe
Schulter:
Leben
Magie
Mund: Sprachfluch

***************************************************************/
int reiben(string str)
{
  object abbildspieler;
  int i;
  abbildspieler=find_player(abbild);
  notify_fail("Welchen Koerperteil von welcher Statue moechtest Du denn reiben?\n");
  
//***Beine=Erschoepfungsstatus
  if(str=="bein von "+abbild+"statue"||str=="beine von "+abbild+"statue")
  { 
    write("Du reibst am Bein der Statue.\n");
	say(TPN+" reibt am Bein der Statue von "+capitalize(abbild)+".\n");
    if(abbildspieler)
	{      // Anzahl der verbleibenden Moving Points in Prozent:
	   i = 100 * abbildspieler->QueryProp(P_MV) / abbildspieler->QueryProp(P_MAX_MV);
	        if(i<5) write(capitalize(abbild)+" ist im Moment schwer erschoepft.\n");
       else if(i<15)write(capitalize(abbild)+" ist ziemlich ausser Atem.\n");
       else if(i<30)write(capitalize(abbild)+" ist etwas erschoepft.\n");
       else if(i<50)write(capitalize(abbild)+" spuert erste Anzeichen der Erschoepfung.\n");
       else         write(capitalize(abbild)+" ist topfit.\n");
		
    } 
	else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n"); //netztot
	return 1;
  }
  
//****Bauch = Saettigung
  if(str=="bauch von "+abbild+"statue")
  { 
    write("Du reibst am Bauch der Statue.\n");
	say(TPN+" reibt am Bauch der Statue von "+capitalize(abbild)+".\n");    
    if(abbildspieler)
	{
      i=100*abbildspieler->QueryProp(P_FOOD)/abbildspieler->QueryProp(P_MAX_FOOD);
	  if (i < 0) i = 0;
      
	  write("Die Statue fluestert Dir zu: ");
      if (i>99)write(capitalize(abbild)+" ist so vollgefressen, dass nichts mehr reingeht.\n");
	  else if (i>90)write(capitalize(abbild)+ " kann kaum noch essen.\n");
	  else if (i>80)write(capitalize(abbild)+ " ist sehr satt.\n");
	  else if (i>70)write(capitalize(abbild)+ " ist satt.\n");
	  else if (i>60)write(capitalize(abbild)+ " ist nicht hungrig.\n");
	  else if (i>50)write(capitalize(abbild)+ " hat schon laenger nichts gegessen.\n");
	  else write(capitalize(abbild)+" hat großen Hunger.\n");
	 }
	else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	return 1;
	}
//***Hals=Durst
  if(str=="hals von "+abbild+"statue"||str=="kehle von "+abbild+"statue")
  { 
     write("Du reibst am Hals der Statue.\n");
	 say(TPN+" reibt am Hals der Statue von "+capitalize(abbild)+".\n");   
    if(abbildspieler)
	{
      i=100*abbildspieler->QueryProp(P_DRINK)/abbildspieler->QueryProp(P_MAX_DRINK);
	  if (i < 0) i = 0;
      
	  write("Die Statue fluestert Dir zu: ");
      if (i>99)write(capitalize(abbild)+" ist so vollgetrunken, dass nichts mehr reingeht.\n");
	  else if (i>90)write(capitalize(abbild)+ " kann kaum noch etwas drinken.\n");
	  else if (i>80)write(capitalize(abbild)+ " hat schon sehr viel getrunken.\n");
	  else if (i>70)write(capitalize(abbild)+ " hat schon viel getrunken.\n");
	  else if (i>60)write(capitalize(abbild)+ " ist nicht durstig.\n");
	  else if (i>50)write(capitalize(abbild)+ " hat schon laenger nichts getrunken.\n");
	  else write(capitalize(abbild)+" hat großen Durst.\n");
	 }
	else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	return 1;
	}	
	
	
	
//****Ruecken=Traglast	
  if(str=="ruecken von "+abbild+"statue")
  { 
    write("Du reibst ueber den Ruecken der Statue.\n");
	say(TPN+" reibt ueber den Ruecken der Statue von "+capitalize(abbild)+".\n");
    if(abbildspieler)
	{       // Gewicht in Prozent ausrechnen:
      i = 100 * (abbildspieler->QueryProp(P_TOTAL_WEIGHT) - 
	      abbildspieler->QueryProp(P_WEIGHT) )
		  / abbildspieler->QueryProp(P_MAX_WEIGHT);

      if (i < 0) i = 0;
	  
        write("Die Statue fluestert Dir zu: ");
        if (i<50) write(capitalize(abbild)+" traegt kaum etwas bei sich.\n");
        else if (i<60) write(capitalize(abbild)+ " traegt einiges Gewicht mit sich herum.\n");
        else if (i<70) write(capitalize(abbild)+ " ist ziemlich beladen.\n");
        else if (i<80) write(capitalize(abbild)+ " ist schwer beladen.\n");
        else if (i<90) write(capitalize(abbild)+ " ist sehr schwer beladen.\n");
        else if (i<95) write(capitalize(abbild)+ " ist extrem schwer beladen.\n");
        else if (i<100)write("Das schwere Gewicht zwingt "+capitalize(abbild)+" fast zu Boden.\n");
        else           write(capitalize(abbild)+ " schleppt mehr, als "+QueryPronoun(abbildspieler)+" eigentlich tragen kann.\n");
        tell_object(abbildspieler, "Dein Ruecken juckt.\n");
	  }
	 
	else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	return 1;	
	}
//***Augen = Sehvermoegen

  if(str=="auge von "+abbild+"statue"||str=="augen von "+abbild+"statue")
  { 
    write("Du reibst ueber die Augen der Statue.\n");
	say(TPN+" reibt ueber die Augen der Statue von "+capitalize(abbild)+".\n");
    if(abbildspieler)	
	{
	  if(abbildspieler->CannotSee(1)==0)
	  write("Die Statue fluestert Dir zu: "+capitalize(abbild)+ " kann "+
	  abbildspieler->QueryPossPronoun(FEMALE, WEN,SINGULAR)+" Umwelt ganz genau erkennen.\n");
      else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+ " kann gerade nichts sehen.\n");
	  tell_object(abbildspieler, "Deine Augen jucken.\n");
	  
	  }
	  else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	  return 1;
	}

//Ohr=Hoervermoegen
	if(str=="ohr von "+abbild+"statue"||str=="ohren von "+abbild+"statue")
  { 
    write("Du reibst an den Ohren der Statue.\n");
	say(TPN+" reibt an den Ohren der Statue von "+capitalize(abbild)+".\n");
    if(abbildspieler)	
	{
	  if(abbildspieler->QueryProp(P_DEAF))
	  write("Die Statue fluestert Dir zu: "+capitalize(abbild)+ " kann gerade nichts hoeren.\n");
      else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+ " kann "+
	  abbildspieler->QueryPossPronoun(FEMALE, WEN,SINGULAR)+" Umwelt ganz genau hoeren.\n");
	  tell_object(abbildspieler, "Deine Ohren jucken.\n");
	  
	  }
	  else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	  return 1;
	}
//Stirn=Gift
  if(str=="stirn von "+abbild+"statue")
  { 
    write("Du reibst an der Stirn der Statue.\n");
	say(TPN+" reibt an der Stirn der Statue von "+capitalize(abbild)+".\n");
    if(abbildspieler)
	{  
      i = abbildspieler->QueryProp(P_POISON);
      write("Die Statue fluestert Dir zu: ");
      if (i>10) write(capitalize(abbild)+ " ist sehr schwer vergiftet.\n");
      else if (i>7) write(capitalize(abbild)+ " ist schwer vergiftet.\n");
      else if (i>4) write(capitalize(abbild)+ " ist vergiftet.\n");
      else if (i>1) write(capitalize(abbild)+ " ist merklich vergiftet.\n");
      else if (i==1) write(capitalize(abbild)+ " hat eine leichte Vergiftung.\n");
      else           write(capitalize(abbild)+ " geht es hervorragend.\n");
      tell_object(abbildspieler, "Deine Stirn juckt.\n");
	  }
	 
	else write("Die Statue fluestert Dir zu: "+capitalize(abbild)+" schlaeft gerade.\n");
	return 1;	
	}

	return 0;
 
}

	
	
	
	
	
	
	
	
    