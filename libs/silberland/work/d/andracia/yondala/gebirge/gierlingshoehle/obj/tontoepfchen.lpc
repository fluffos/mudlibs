int inick(string str)
{
  int i;
  object *indianer;
  object indi;
  if(!str)
    {
      indianer=filter_array(users(),"check_if_indianer");//finde alle spieler
      for(i=sizeof(indianer)-1;i>=0;i--)
        tell_object(indianer[i], sex()+" "+TPN+" nickt Euch aus der Ferne zu.\n");
  
      write("Du nickst allen Indianer aus der Ferne zu.\n");
    }
  else
    {
      if(indi=find_living(str))
        {
          tell_object(indi, sex()+" "+TPN+" nickt Dir aus der Ferne zu.\n");
          write("Du nickst "+capitalize(str)+" aus der Ferne zu.\n");
        }
      else
        write("Wem moechtest Du aus der Ferne zunicken?\n");
      }
return 1;
}     
      
      
