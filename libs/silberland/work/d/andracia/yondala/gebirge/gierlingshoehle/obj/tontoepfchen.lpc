#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>//fuer die Farben
object besitzer;
nosave int lastHP, lastSP, aktiv=0, farbe=0;
//string aktStr;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein kleines Tontoepfchen");
  SetProp(P_LONG,
  "Du haelst ein kleines Tontoepfchen in Deinen Haenden.\n"
  "In dem Toepfchen befindet sich etwas Farbe, mit der Du Dir Deine Kriegsbemalung aufzeichnen kannst.\n"
  "Wenn Du Deine Kriegsbemalung traegst siehst Du stehts Deine Lebens- und Magiepunkte. "
  "Es ermoeglicht Dir ausserdem mit den anderen Indianern zu interagieren:\n"
  "iknuddel, iwink, ilieb, ilob, ifeuer, igratulier, istrahl, ilach, ikicher, itroeste, idanke, "
  "igruesse, inick, izwick, ikuschel, istubs, igrins, irufe.\n"
  "Des Weiteren bekommst Du mit ireport ? eine kleine Hilfe.");
  SetProp(P_NAME, "Tontopefchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tontoepfchen","toepfchen", "\nindianertontoepfchen"}) );

  SetProp(P_MATERIAL, ({MAT_CERAMIC, MAT_FAT, MAT_CARBON}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Dein Tontoepfchen solltest Du nicht hergeben.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({ "zeichne"}), "izeichne");
  AddCmd( ({ "ireport"}), "ireport");
  AddCmd( ({ "wische","wisch"}), "iwischen");
 
//indianerfernverben
  AddCmd( ({ "iknuddel","iknuddle"}), "iknuddel");
  AddCmd( ({ "iwink","iwinke"}), "iwink");
  AddCmd( ({ "ilieb", "iliebe"}), "ilieb");
  AddCmd( ({ "ilob", "ilobe"}), "ilob"); 
  AddCmd( ({ "ifeuer", "ifeuere"}), "ifeuer");
  AddCmd( ({ "igratulier"}), "igratulier");   
  AddCmd( ({ "istrahl","istrahle"}), "istrahl");
  AddCmd( ({ "ilach","ilache"}), "ilach");
  AddCmd( ({ "ikicher", "ikichere"}), "ikicher");   
  AddCmd( ({ "itroeste","itroest"}), "itroeste");   
  AddCmd( ({ "idanke", "idank"}), "idanke");
  AddCmd( ({ "igruesse", "igruess"}), "igruesse");   
  AddCmd( ({ "inick", "inicke"}), "inick");
  AddCmd( ({ "izwick", "ikneif", "izwicke","ikneife"}), "izwick");
  AddCmd( ({ "ikuschel","ikuschle"}), "ikuschel");   
  AddCmd( ({ "istubs","istubse"}), "istubs");
  AddCmd( ({ "igrins","igrinse"}), "igrins");
  AddCmd( ({ "irufe", "iruf"}), "irufe");
//  AddCmd( ({ "khist"}), "khist");

  lastHP = lastSP = -1;
}
string extra_look()
{
	if (aktiv==1) return capitalize(environment()->QueryPronoun())+ " hat eine Kriegsbemalung aufgezeichnet.\n";
	return "";
}

int izeichne(string str)
{
  notify_fail("Was moechtest Du zeichnen?\n");
  besitzer=environment();
  if(str=="kriegsbemalung"||str=="bemalung")
    {
      aktiv=1;
      farbe=0;
      write("Du tunkst Deine Finger in Dein Tontoepfchen und malst Dir eine wilde Kriegsbemalung auf.\n");
      say(TPN+ "malt sich eine Kriegsbemalung ins Gesicht.\n",TP);
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
      return 1;
    }
     
  return 0;
  }

iwischen(string str)
{
  notify_fail("Was moechtest Du abwischen?\n");
  
    if(str=="bemalung ab"||str=="kriegsbemalung ab")
    {
      aktiv=0;
      write("Du wischt Dir die Kriegsbemalung aus Deinem Gesicht.\n");
      say(TPN+" wisch sich die Kriegsbemalung aus dem Gesicht.\n");
      besitzer->RemoveHpHook(ME);
      return 1;
    }
    return 0;
  }
  
int ireport(string str) 
{
  notify_fail("ireport farbe|?|alle \n");
   besitzer=environment();
     
  if(str=="farbe")
    {
      aktiv=1;
      farbe=1;
      write("Du siehst Deinen Lebenspunkte nun in Farbe.\n");
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
      return 1;
    }
  
  if (str=="alle")
    {
    	write("Du zeigst den Anwesenden Deine Lebensstand\n");
      tell_room(environment(besitzer), besitzer->name()+
      " zeigt Dir "+this_player()->QueryPossPronoun(MALE, WEN, SINGULAR)+
      " Lebensstand:\n",({besitzer}));

    
    tell_room(environment(besitzer), besitzer->name()+"Hat "+besitzer->QueryProp(P_HP)+
    " Lebenspunkte und "+besitzer->QueryProp(P_SP)+" Magiepunkte\n",({besitzer}));

    if(besitzer->QueryProp(P_POISON)>3)
      tell_room(environment(besitzer), besitzer->name()+" ist stark vergiftet.\n",({besitzer}));
    
    else if(besitzer->QueryProp(P_POISON)>3)
      tell_room(environment(besitzer), besitzer->name()+" ist vergiftet.\n",({besitzer}));
    if(besitzer->QueryProp(P_BLIND)) 
      tell_room(environment(besitzer), besitzer->name()+" ist blind.\n",({besitzer}));

    if(besitzer->QueryProp(P_DEAF))
      tell_room(environment(besitzer), besitzer->name()+" ist taub.\n",({besitzer}));
    
    if(besitzer->QueryProp(P_FROG)) tell_room(environment(besitzer), besitzer->name()+" ist ein Frosch.\n",({besitzer}));
      
      return 1;
      
      }
  
  if(str=="?")
    {
      write("**************************************************************************\n"+
            "* Dein Indianerreport                                                    *\n"+
            "* Mit <zeichne Kriegsbemalung> stellst Du Deinen Report einfarbig ein    *\n"+
            "* Mit <ireport farbe> stellst Du Deinen Report bunt ein.                 *\n"+
            "* Mit <wische kriegsbemalung ab> beendest Du die Anzeige Deines Reports. *\n"+
            "* Mit <ireport> bekommst Du Deinen aktuellen Report angezeigt.           *\n"+
            "* Mit <ireport alle> zeigst Du Deiner Umgebung Deinen Status.            *\n"+
            "*                                                                        *\n"+
            "* Der Indianerreport setzt sich wie folgt zusammen:                      *\n"+
            "*                                                                        *\n"+
            "* MAGIE                 -> kannst Du gerade zauber? ja oder nein.        *\n"+
            "* X Y                   -> Deine Lebens- und Magiepunkte                 *\n"
            "* gift / GIFT           -> leicht / stark vergiftet                      *\n"+
            "* FROSCH                -> Du bist ein Frosch.                           *\n"+
            "* BLIND                 -> Du bist blind                                 *\n"+
            "* TAUB                  -> Du bist taub                                  *\n"+
            "*                                                                        *\n"+
            "**************************************************************************\n");
      return 1;   
    }

  if(!str)
    {//--MAGIE--MP--LP---gift--FROSCH--BLIND--TAUB--
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,"--MAGIE");
    else tell_object(besitzer,"------\n");
    
    tell_object(besitzer,"--"+besitzer->QueryProp(P_HP)+"--"+besitzer->QueryProp(P_SP)+"--");

    if(besitzer->QueryProp(P_POISON)>3)tell_object(besitzer,"--GIFT");
    else if(besitzer->QueryProp(P_POISON))tell_object(besitzer,"--gift");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_BLIND)) tell_object(besitzer,"--BLIND");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_DEAF))tell_object(besitzer,"--TAUB");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,"--FROSCH--");
    else tell_object(besitzer,"----------\n");

    return 1;
    }
  
  
  
  
  }





NotifyHpChange()
{
    int    hp, mhp, sp, msp;
    if(!aktiv) return;

  // Sicherheits-Check
  if (!previous_object() || !besitzer || (besitzer != previous_object()))
    return;
if(besitzer!=environment()) return;

  // Test auf Geist
  if (besitzer->QueryProp(P_GHOST)) return;

  // aktuelle Werte ermitteln
  hp = besitzer->QueryProp(P_HP);
  mhp = besitzer->QueryProp(P_MAX_HP);
  sp = besitzer->QueryProp(P_SP);
  msp = besitzer->QueryProp(P_MAX_SP);


  // Test auf Tod
  if ((hp<=0) || (!living(besitzer)))
  {
     aktiv=0;
      besitzer->RemoveHpHook(ME);
  }


if(!farbe)
  {//fuer den Fall, dass Frosch, weil dann ists unter null und springt dauernd hin und her
    if(lastHP==hp&&sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0) tell_object(besitzer,"");
    
    else
      {
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,"--MAGIE\n");
    else tell_object(besitzer,"--warte\n");
    
    tell_object(besitzer,"--"+besitzer->QueryProp(P_HP)+"--"+besitzer->QueryProp(P_SP)+"-");

    if(besitzer->QueryProp(P_POISON)>3)tell_object(besitzer,"--GIFT");
    else if(besitzer->QueryProp(P_POISON))tell_object(besitzer,"--gift");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_BLIND)) tell_object(besitzer,"--BLIND");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_DEAF))tell_object(besitzer,"--TAUB");
    else tell_object(besitzer,"------");
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,"--FROSCH--\n");
    else tell_object(besitzer,"----------\n");
    }
}
//--MAGIE--MP--LP---gift--FROSCH--BLIND--TAUB--
else//in Farbe
  { //Farbe fuer Lebenspunkte
    if(lastHP==hp&&sp<=0&&besitzer->QueryProp(P_FROG)==1&&lastSP<=0) tell_object(besitzer,"");
    
    else
      {

 //Spellpause?
    tell_object(besitzer,"--");
    if(besitzer->QueryProp(P_NEXT_SPELL_TIME)<time()) tell_object(besitzer,ANSI_PURPLE+"MAGIE"+ANSI_NORMAL);
    else tell_object(besitzer,ANSI_RED+"warte"+ANSI_NORMAL);
    tell_object(besitzer,"--");    
    //Lebenspunkte
        if(hp*100/mhp<21) tell_object(besitzer,ANSI_RED+hp+ANSI_NORMAL);
        else if(hp*100/mhp<41)  tell_object(besitzer,ANSI_PURPLE+hp+ANSI_NORMAL);
        else if(hp*100/mhp<61)  tell_object(besitzer,ANSI_BLUE+hp+ANSI_NORMAL);
        else if(hp*100/mhp<81)  tell_object(besitzer,ANSI_CYAN+hp+ANSI_NORMAL);
        else tell_object(besitzer,ANSI_GREEN+hp+ANSI_NORMAL);        
     tell_object(besitzer,"--");    
         if(sp*100/msp<21) tell_object(besitzer,ANSI_RED+sp+ANSI_NORMAL);
        else if(sp*100/msp<41)  tell_object(besitzer,ANSI_PURPLE+sp+ANSI_NORMAL);
        else if(sp*100/msp<61)  tell_object(besitzer,ANSI_BLUE+sp+ANSI_NORMAL);
        else if(sp*100/msp<81)  tell_object(besitzer,ANSI_CYAN+sp+ANSI_NORMAL);
        else tell_object(besitzer,ANSI_GREEN+sp+ANSI_NORMAL);        
     tell_object(besitzer,"--");    
  

    if(besitzer->QueryProp(P_POISON)>3)tell_object(besitzer,ANSI_RED+"GIFT"+ANSI_NORMAL);
    else if(besitzer->QueryProp(P_POISON))tell_object(besitzer,ANSI_PURPLE+"gift"+ANSI_NORMAL);
    else tell_object(besitzer,"----");
         tell_object(besitzer,"--");    

    if(besitzer->QueryProp(P_BLIND)) tell_object(besitzer,ANSI_CYAN+"BLIND"+ANSI_NORMAL);
    else tell_object(besitzer,"----");
    	     tell_object(besitzer,"--");    

    if(besitzer->QueryProp(P_DEAF))tell_object(besitzer,ANSI_CYAN+"TAUB"+ANSI_NORMAL);
    else tell_object(besitzer,"----");
     tell_object(besitzer,"--");  
    if(besitzer->QueryProp(P_FROG)) tell_object(besitzer,ANSI_GREEN+"FROSCH"+ANSI_NORMAL);
    else tell_object(besitzer,"------");
    	     tell_object(besitzer,"--\n");    

    }

}
  // neue Werte merken
  lastHP = hp; 
  lastSP = sp;

}

string sex()//ermittelt das Geschlecht des Spielers und gibt die enstsprechende Form zurueck
{
  string sex;
  sex="Indianer";
  
  if(TP->QueryProp(P_GENDER)==FEMALE) sex="Squaw";
  return sex;
  }
 

int check_if_indianer(object spieler)
{  
  if (spieler!=TP)
  return spieler->QueryProp(P_RACE, "Indianer"); //id("indispieler");
  else return 0;
  }

int irufe(string aktStr)
{
  int i;
  object *indianer;
  object indi;

  notify_fail("Was moechtest Du den anderen Indianern mitteilen?\n");
  aktStr = this_player()->_unparsed_args(); // verhindert das die mudlib den Text parsed
  if (!aktStr) return 0;
  
//  call_other("/d/tal/yondala/aboriville/obj/zweigmaster.lpc","jemandruft", aktStr, TP);//soll spaeter in den Gildenraum

  indianer=filter_array(users(),"check_if_indianer");//finde alle spieler

      for(i=sizeof(indianer)-1;i>=0;i--)
        tell_object(indianer[i],sex()+" "+TPN+" ruft Euch zu: "+aktStr+"\n");

      write("Du rufst den Indianern zu: "+aktStr+"\n");
   
   return 1;

  }

int iknuddel(string str)
{
  int i;
  object *indianer;
  object indi;
  if(!str)
    {
      indianer=filter_array(users(),"check_if_indianer");//finde alle spieler
      for(i=sizeof(indianer)-1;i>=0;i--)
        tell_object(indianer[i],sex()+" "+TPN+" knuddelt Euch aus der Ferne.\n");
      write("Du knuddelst alle Indianer aus der Ferne.\n");
    }
  else
    {
      if(indi=find_living(str))
        {
          tell_object(indi, sex()+" "+TPN+" knuddelt Dich aus der Ferne.\n");
          write("Du knuddelst "+capitalize(str)+" aus der Ferne.\n");
        }
      else
        write("Wen moechtest Du aus der Ferne knuddeln?\n");
      }
   
   return 1;

}

