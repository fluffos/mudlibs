#include "../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>

string farb;
int farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
farbe = random(5);
switch(farbe)
{	case 1: {      
   SetProp(P_NAME_ADJ, "rot");
     SetProp(P_SHORT, "Eine rote Toga");
     	break;}
  case 2: {      
   SetProp(P_NAME_ADJ, "gelb");
   SetProp(P_SHORT, "Eine gelbe Toga");
	break;}
	case 1: {      
   SetProp(P_NAME_ADJ, "gruen");
   SetProp(P_SHORT, "Eine gruene Toga");
	break;}
	case 1: {      
   SetProp(P_NAME_ADJ, "blau");
   SetProp(P_SHORT, "Eine blaue Toga");
	break;}
	case 1: {      
   SetProp(P_NAME_ADJ, "braun");
   SetProp(P_SHORT, "Eine braune Toga");
	break;}
	default: {
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_SHORT, "Eine schwarze Toga");
}
}
farb=QueryProp(P_NAME_ADJ);

  SetProp(P_LONG,
    "Du siehst eine kleine Toga vor Dir, sie ist "+farb+" und sehr einfach "
	"verarbeitet." );
  SetProp(P_NAME, "Toga");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"toga", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 110);
  SetProp(P_QUALITY_DECAY, 100);                                  
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE_:80]) );
}

