//Norbert, der nervige gierling
//Idee: Norbert wird von den anderen Gierlingen immer vertrieben

inherit "std/npc";
#include <language.h>
#include <properties.h> 
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
void create() {

  ::create();
  CLONEME(GIER_OBJ+ "sockel.lpc");

  AddId(({"gierling", "norbert"}));
  //SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Norbert der Gierling");
  SetProp(P_LONG,
    "Das ist Norbert, der Gierling. Norbert ist sehr gebildet und steht "
    "tagaus, tagein auf seinem Sockel um alle Welt an seiner Bildung "
    "teilhaben zu lassen.\nNorbert ist nackt.");
  SetProp(P_NAME, "Norbert");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  
  create_default_npc(8);
  
  SetProp(P_RACE, "Gierling");
  SetProp(P_SIZE, 75);
  SetProp(P_WEIGHT, 16000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "stolziert herbei, stellt seinen Sockel auf den Boden und klettert hinauf"); 
  SetProp(P_MSGOUT, "nimmt seinen Sockel und stolziert ");
  SetProp(P_MMSGIN, "stolziert von einem Regenbogen, stellt seinen Sockel auf den Boden und klettert hinauf");
  SetProp(P_MMSGOUT, "nimmt seinen Sockel und entfleucht");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Norbert sagt: Was soll ich mit weltlichen Guetern?\n" }) );

  SetProp(P_DIE_MSG,  " faellt von seinem Sockel.\n");
  SetProp(P_KILL_NAME, "Norbert, der Gierling");
  SetProp(P_KILL_MSG, "Das habt Ihr selbst zu verantworten!");
  SetAttackChats( 50,
    ({"Norbert sagt: Gewalt ist keine Loesung.\n",
    	"Norbert sagt: Ich glaube, Ihr habt ein Problem mit Euren Agressionen.\n",
    	"Norbert sagt: Moechtet Ihr mit mir ueber Eure Probleme sprechen?\n",
    	"Norbert sagt: Ich bin Bluter, koennt Ihr Euer Tun verantworten?\n",
    	"Norbert sagt: Ich bin unbewaffnet, warum versucht Ihr mich zu toeten?\n"
    	
     })
  );
  
  AddDetail( ({ "sockel" }),
    "Auf diesem Sockel steht Norbert immer, um zu verbildlichen, dass er ueber den Dingen steht.");  
  AddDetail( ({ "", "" }),
    "");  
  AddDetail( ({ "", "" }),
    ""); 
  AddInfo(DEFAULT_INFO, ({
  	"sagt: Wenn ich Euch das nun erklaeren wuerde, so wuerdet Ihr es ja doch nicht verstehen.\n",
  	"sagt: Das wisst ihr nicht? Welch ein Fauxpas!\n",
  	"sagt: Koennt ihr das determinieren?\n",
  	"sagt: Das tangiert mich peripher.\n"
  }));


     
    
 SetChats(10, ({
    break_string("Immobilitaet ist mein Leben.\n",60,"Norbert sagt:"),
    break_string("Impliziert man die Introvertiertheit des Seins so radikalisiert man den egozentrischen Obskurant.\n",60,"Norbert sagt:"),
    break_string("Ein Berceuse soll manchmal Wunder wirken.\nNorbert zwinkert Dir zu.\n",60,"Norbert sagt:"),
    "Norbert sagt: Hilf den Armen und Dir wird geholfen werden.\nNorbert zwinkert Dir zu.\n",
    break_string("Jedes Geheimnis hat auch ein kleines Fensterchen und sei es nur ein kleines Loch.\n",60,"Norbert sagt augenzwinkernd:"),
    break_string("Nihilismus ist die einzig wahre Religion!\n",60,"Norbert sagt:"),
    break_string("Ich bin nicht Gott.\n",60,"Norbert sagt:"),
    break_string("Neume benutze ich faute de mieux.\n",60,"Norbert sagt:"),
    break_string("Die Nullitaet des irdischen ist keine Obsession meiner Person.\n",60,"Norbert sagt:"),
    break_string("Die Nyktalopie macht mir sehr zu schaffen.\n",60,"Norbert sagt:"),
    break_string("Allein schon beim Gedanken an Nystagmus bekomme ich ein grosses Zittern.\n",60,"Norbert sagt:"),
    break_string("Die Objektion der Nutria auf mich ist enorm.\n",60,"Norbert sagt:"),
    break_string("Ich liebe es in der Abenddaemmerung die Nyktinastie zu beobachten.\n",60,"Norbert sagt:"),
    break_string("Mein Abakus hat sich abaliniert.\n",60,"Norbert sagt:"),
    break_string("Aberration der Gedanken zeugt manchmal von Weissheit.\n",60,"Norbert sagt:"),
    break_string("Ich war eine Abdominalgraviditaet.\n",60,"Norbert sagt:"),
    break_string("Foerdert die Abecedarier!\n",60,"Norbert fordert:"),
    break_string("Die Abnegation der jungen Generation ist abnorm.\n",60,"Norbert sagt:"),
    break_string("Bonhomie entspannt die Seele.\n",60,"Norbert sagt:"),
    break_string("Bonvivanten erstreben die falschen Ziele.\n",60,"Norbert sagt:"),
    break_string("Desarmiert.\n",60,"Norbert sagt:"),
    break_string("Sei nie im Clinch mit weltlichem.\n",60,"Norbert sagt:"),
    break_string("Die Coda ist das Ende manchen Tages.\n",60,"Norbert sagt:"),
    break_string("Colla sinistra mach ich doch mit links.\n",60,"Norbert sagt:"),
    break_string("Commonsence sollte stets hoechste Prioritaet besitzen.\n",60,"Norbert sagt:"),
    break_string("Ich habe keine Deszendenten und das ist gut so.\n",60,"Norbert sagt:"),
    break_string("Lasst mich Euer Deklamator sein.\n",60,"Norbert sagt:"),
    break_string("Die Population Andracias waechst.\n",60,"Norbert sagt:"),
    break_string("Ich wuensche eine Notifikation der Ereignisse.\n",60,"Norbert sagt:"),
    break_string("Ich benutze prinzipiell keine Fremdwoerter.\n",60,"Norbert sagt:"),
    break_string("Bei Beruehrung meines Abdomens empfinde ich eine infantile Freude.\n",60,"Norbert sagt:"),
    break_string("Was schaut Ihr so dekadent?\n",60,"Norbert sagt:"),
    break_string("Der Geruchskoeffizient pekuniaerer Mittel ist permanent Null.\n",60,"Norbert sagt:"),
    break_string("Ein abruptes sinisteres Fatalfaktum tritt in den meisten Faellen nur in Kooperation mit aequivalenten Phaenomenen auf den Plan.\n",60,"Norbert sagt:"),
    break_string("Populanten von Domizilen mit fragiler, transparenter Aussenstruktur sollten sich von der Transformation von gegen Deformierung resistenter Materie distanzieren.\n",60,"Norbert sagt:"),
    break_string("Die Expansion der interranen Tuberosa steht in inverser Proportionalitaet zur intellektuellen Kapazitaet des kultivierenden Agraroekonoms.\n",60,"Norbert sagt:"),
    break_string("Die Auslotung gradientenfreier Gewaesser bereitet, messtechnisch gesehen, Schwierigkeiten.\n",60,"Norbert sagt:"),
    break_string("Lebende Humanwesen, die miteinander in profunden, emotional-positiven Beziehungsstrukturen kommunizieren, agieren parallel dazu mit einer Neigung zu unserioesen Modi der sozialen Kommunikation.\n",60,"Norbert sagt:"),
    break_string("Eine strukturell desintegrierte Finalitaet in Relation zur Zentralisationskonstellation provoziert die eskalative Realisierung destruktiver Integrationsmotivationen durch permanent lokal aggressive Individuen der Spezies Canis.\n",60,"Norbert sagt:"),
    break_string("Ich lebe nach der Devise: Es existiert ein Interesse an der generellen Rezession der Applikation relativ primitiver Methoden komplementaer zur Favorisierung adaequater komplexer Algorithmen.\n",60,"Norbert sagt:"),
    break_string("Es ist davon abzuraten ein Exemplar der Gattung Equus gegen ein anderes derselben Art einzutauschen, waehrend man von diesem durch ein fluktuierendes Quantum H2O transferiert wird.\n",60,"Norbert sagt:"),
    break_string("Bei einem Lebewesen der Gattung Equus, das man durch eine Schenkung requiriert hat, sollte man nicht visuellen Kontakt mit seiner Nahrungsaufnahmeoeffnung nehmen.\n",60,"Norbert sagt:"),
    break_string("Die visuell durchgefuehrte, orale Inspektion eines unpaarhufigen Mammaloiden der Gattung Equus konterkariert die kulturellen Konventionen des sozialen Umfeldes.\n",60,"Norbert sagt:"),
    break_string("Ein der optischen Wahrnehmung unfaehiges, gefiedertes, aber des Fliegens nicht maechtiges Haustier gelangt in den Besitz nicht naeher definierter Saemereien.\n",60,"Norbert sagt:"),
    break_string("Konsekutiv ausgefuehrte Transporte irdener Behaeltnisse zu artifiziell angelegten Wassergewinnungsanlagen implizieren die Moeglichkeit zu willkuerlicher Veraenderung der physikalischen Struktur der utilisierten Gefaesse.\n",60,"Norbert sagt:"),
    break_string("Die in grober Naeherung 365. Teilsequenz des ekliptischen Umlaufs des 3. Haupttrabanten im System Sol besitzt unter der Voraussetzung optimaler Umgebungsbedingungen zur Visualrezeption die systemimmanente Tendenz zur Reinitialisierung der Rotationsperiode.\n",60,"Norbert sagt:"),
    break_string("Minimale Dedikationen prolongieren die Permanez interpersonaler Relationen.\n",60,"Norbert sagt:"),
    break_string("Einer fruehen, genau definierten Zeitspanne wurde bei einer Dentalbehandlung ein Edelmetall verabreicht.\n",60,"Norbert sagt:"),
    break_string("Ein bestimmtes Edelmetall kann insofern mit nonverbaler Kommunikation in Zusammenhang gebracht werden, als es im Rahmen akzentuierter Rhetorik durch niedere Materialien, obzwar ebfalls Edelmetall, substituiert wird.\n",60,"Norbert sagt:"),
    break_string("Bei der intendierten Realisierung der linguistischen Simplifizierung des regionalen Idioms resultiert die Evidenz der Opportunitaet extrem apparent, den elaborierten und quantitativ opulenten Usus nicht assimilierter Xenologien konsequent zu eliminieren.\n",60,"Norbert sagt:"),
    break_string("Es ist nicht zu empfehlen ueber die Zeiteinheit zwischen der visuellen Erscheinung des Zentralkoerpers bis zu dem Austreten aus der visuellen Wahrnehmung seine positive Achtung zu aeussern, bis einwandfrei festgestellt wurde das der besagte Zentralkoerper sich nicht mehr im optischen Wahrnehmungsfeld befindet.\n",60,"Norbert sagt:"),
    break_string("Sollte eine nicht naeher benannte Person einer geringen Zahlungseinheit keine Beachtung schenken, so ist zu beachten das besagte Person zu keiner Zeit fuer eine groessere Zahlungseinheit vorgesehen ist.\n",60,"Norbert sagt:"),
    break_string("Eine antiquate amorose Relation zweier geschlechtlich getrennter Komponenten verhaelt sich oxidationsresistent.\n",60,"Norbert sagt:"),
    break_string("Eine Emission energiereicher Strahlungsquanten seitens des Zentralgestirns des Solarsystems manifestiert sich exterritorial.\n",60,"Norbert sagt:"),
    break_string("Die von Euch getroffenen Aussagen passieren mich in der analen Peripherie.\n",60,"Norbert sagt:"),
    break_string("Was tangiert mich Eure Verbalemanation ohne kommunikative Signifikanz?\n",60,"Norbert sagt:"),
    break_string("Fritz ist ein kognitiv beeintraechtigtes, maskulines Individuum der lokalen Umgebung .\n",60,"Norbert sagt:"),
    break_string("Einst sagte ich zu ihr: In meiner psychologischen Konstitution manifestiert sich eine absolute Dominanz positiver Effekte fuer eine labile existente Individualitaet Deiner Person.\n",60,"Norbert sagt:"),
    break_string("Wer sich dessen befleissigt, zwecks Benutzung durch andere Leute eine Bodenvertiefung auszuheben, wird selbst in die Lage kommen, mit der Sohle dieser Bodenvertiefung zu kollidieren.\n",60,"Norbert sagt:"),
    break_string("Das zum Transport von Diwasserstoffmonoxid oder dergleichen vorgesehene, aus Ton oder einer aehnlichen Substanz verfertigte Gefaess, legt die Strecke bis zum Ort der Wasserentnahme so haeufig zurueck, bis es der Zerstoerung anheimfaellt.\n",60,"Norbert sagt:"),
    break_string("Wem ein Nachteil an Vermoegen, Koerper, Geist oder dergleichen zugefuegt wurde, derjenige steht keineswegs vor der Erfordernis, sich um die Belaechlung des genannten Nachteils durch seine Zeitgenossen besorgt zu machen.\n",60,"Norbert sagt:"),
    break_string("Was immer man in Richtung auf das von der Forstverwaltung betreute Gebiet schreit, immer wird sich ergeben, dass das zurueckhallende Echo eine gewisse Aehnlichkeit mit dem gerufenen zeigt, sei es auch nur im Ton.\n",60,"Norbert sagt:"),
    break_string("Wer nicht gewillt ist, ein Risiko einzugehen, wird nicht damit rechnen koennen, ein wie immer geartetes guenstiges Resultat zu erzielen.\n",60,"Norbert sagt:"),
    break_string("In einem Bereich, in dem die Amplituden der elektromagnetischen Wellen wesentlich hoeher sind als normal, wird es auch Orte geben, wo diese Amplituden relativ sehr gering sind.\n",60,"Norbert sagt:"),
    break_string("Wer sich einmal bewusst so unpraezis ausdrueckt, dass der Sinn seiner Worte mit dem Gegenteil der Realitaet uebereinstimmt, wird in Zukunft vergeblich versuchen, Informationen weiterzugeben, auch wenn er darauf achtet, dass die Identitaet zwischen den Worten mit denen er ein Ereignis beschreibt, und diesem Ereignis selbst, vorhanden ist.\n",60,"Norbert sagt:"),
    break_string("Die Aussagen einer zwei- oder dreidimensionalen, visuellen Darstellung uebersteigen den Informationsgehalt von nicht weniger als zehn hoch drei Satzteilen.\n",60,"Norbert sagt:"),
    break_string("Kontinuierliche Zufuhr von Fluessigkeit, die, in kleinen Quanten abgegeben, durch Gravitationseinwirkung zum Erdmittelpunkt hin beschleunigt wird, um schliesslich auf der Oberflaeche eines geologischen Fundstuecks aufzutreffen, erzeugt durch permanente Auswaschung kleinster Materialteilchen auf Dauer eine sich immer mehr vertiefende Mulde in dem Objekt.\n",60,"Norbert sagt:"),
    break_string("Die ersten, der genau definierten Zeiteinheiten nach Sonnenaufgang haben das Element mit der Ordungszahl 79 in einer der oberen, unter anderem der Nahrungsaufnahme dienenden Koerperoeffnungen.\n",60,"Norbert sagt:"),
    break_string("Die Sichtung eines einzelnen Vertreters einer heimischen Singvogelart mit gegabeltem Schwanz, kurzen Beinen und langen, zugespitzten Fluegeln, reicht alleine nicht aus, um den Beginn der waermsten Jahreszeit zu postulieren.\n",60,"Norbert sagt:"),
    break_string("Ein schwarzer Rabenvogel nimmt davon Abstand, durch periodisches, ruckartiges Vor- und Zurueckbewegen des Schnabels, einem anderen schwarzen Rabenvogel das Sehorgan zu entfernen.\n",60,"Norbert sagt:"),
    break_string("Da die reife, pektinhaltige Frucht eines Kulturbaumes auf ihrer Flugbahn zum Erdboden in erster Linie der Gravitationskraft folgt, befindet sich ihr Aufschlagpunkt im Allgemeinen innerhalb eines geringen Radius um den Haupttrieb der Mutterpflanze.\n",60,"Norbert sagt:"),
    break_string("Wenn sich das maennliche Exemplar des fluguntuechtigen Federviehs auf der Spitze der aufgeschichteten Mischung aus gedroschenen Getreidehalmen und dickfluessigen bis festen Anteilen von Nutztierexkrementen befindet und gleichzeitig seine Stimmbander mit Hilfe von Kehlkopf und Kehlsack in rythmische Schwingungen versetzt, um die fuer seine Art typischen Lautfolgen zu erzeugen, fuehrt das im folgenden entweder zu ganz bestimmten Druck- und Temperaturveraenderungen der umgebenden Atmosphaere, oder aber zu einer Stabilisierung der derzeitigen meteorologischen Verhaeltnisse.\n",60,"Norbert sagt:"),
    break_string("Die Existenz eines fuer die mechanische Zerkleinerung verfestigter, zellulosehaltiger Floraelemente entwickelten Hilfsmittels fuehrt die Anwesenheit eines Homo Sapiens, welcher die eigenen Kenntnisse und Faehigkeiten in Richtung der Anfertigung von Holzkonstruktionen und Holzbauten aller Art vertieft hat, ad absurdum.\n",60,"Norbert sagt:"),
    break_string("Aus einem depressiv veranlagten Anus dekomprimiert nullfalls ein euphorischer Flatus.\n",60,"Norbert weiss:"),
    "Norbert hustet.\n"
