#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kleidchen");
  SetProp(P_LONG,
    "Ein kleines Kleidchen, welches wohl nur Koboldkindern passen kann." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Kleidchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid", "kleidchen", ""}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_COTTON ]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);
SetProp (P_WEAR_RESTRICTIONS,([P_GENDER:2, P_RACE:"Kobold"]) );

//	SetProp (P_WEAR_DESTRICTIONS, SR_INCLUDE_RACE("Kobold")P_GENDER(NEUTER));
// das wird falsch sein

//  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

//  AddProp(P_DAM_PROTECTION, ([DT_:]) );
//  SetProp(P_WEAR_RESTRICTIONS, ([A_:]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
