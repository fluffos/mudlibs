//oitl, Quest (verkauft Klinken), sitzt in 3d
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Oitl der Gierlingjunge");
  SetProp(P_LONG,
    "Das ist Oitl, Er ist ein Gierlingjunge. Oitl wirkt auf Dich abgerissen "
	"und armseelig. Er traegt einen zerschlissenen Mantel. Seine Fuesse sind "
	"nackt und so dreckig wie der Rest von ihm. Seine Haare sind sicherlich "
	"rot, wenn er sie mal waescht.");
  SetProp(P_NAME, "Oitl");
  SetProp(P_GENDER, MALE);
SetProp (P_MNPC_DEFAULTROOM, "/d/gebirge/gierlingshoehle/");
SetProp (P_MNPC_AREA, "/d/gebirge/gierlingshoehle" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
  SetProp(P_ARTICLE, 0);
  AddId(({"oitl", "winzling", "gierlingkind", "kind", "junge", "gierlingjunge"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_oitlmantel.lpc");
  CLONEME(GIER_OBJ + "klinke.lpc");
  command("trage alles");

  
  create_default_npc(4);// Die Zahl entspricht der Spielerstufe des GIER_NPC
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, -250);//Gesinnung. frech so zwischen -50 und -500

  SetProp(P_WIMPY, 10);//wann er weg rennt (bei wieviel Lebenspunkten)

  SetProp(P_MSGIN, "schleicht heran"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "schleicht nach");//verlassen wird

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );// bei 0 hat er ne Leiche.
  SetProp(P_KILL_NAME, "Oitl der Gierlingjunge");
  SetProp(P_KILL_MSG, "Das hast du nun davon!");

 
  AddInfo("armband", "Das von Scrollan? Sag ich nicht...","sagt: ");
  
  AddInfo(DEFAULT_INFO, "sagt: Weiss ich leider nicht, aber kannst Du mich nicht adoptieren?\n");//Wenn der GIER_NPC keine Antwort hat

   AddInfo( ({"klinke","tuerklinke"}), 
    "Ich habe Klinken. Moechtest Du eine kaufen? Kosten heute nur 200 Muenzen.",
    "sagt: ");
 
  AddInfo( ({"quest","abenteuer", "hilfe"}), 
    "Das musst Du schon alleine schaffen.",
    "sagt: "); 
     
  AddInfo( ({"mutter","eltern", "vater"}),
    "Eltern habe ich keine.",
    "sagt: ");   
  AddInfo( ({"grossmutter","grosseltern", "opa", "oma"}), 
    "Grosseltern habe ich keine.",
    "sagt: "); 
  AddInfo( ({"verwandten"}), 
    "Ich lebe bei meinem Grossonkel Fritz.",
    "sagt: "); 
  AddInfo( ({"grossonkel", "fritz"}), 
    "Nach dem Tod meiner Eltern hat er mich bei sich aufgenommen.",
    "sagt: "); 
  AddInfo( ({"tod"}), 
    "Der Tod ist schlimm.",
    "sagt: "); 
  AddInfo( ({"oitl"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({"nichtsnutz","tagedieb"}), 
    "Selber!",
    "sagt: "); 
   SetChats(5, ({
    "Oitl schaut sich vorsichtig um.\n",
    "Oitl stubst Dich an.\n", 
    "Oitl fragt Dich, ob du was kaufen moechtest.\n",
    "Oitl sagt: Psssst! Hey, Du!\n"}) );

  AddCmd(({"kaufe","kauf"}),"kaufenCmd");

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
         "schaut Dich traurig an.",
         "schaut Dich traurig " +TPN+ " an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "macht sowas nur fuer Gold und schubst Dich weg.",
        "macht sowas nur fuer Gold und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "ist dankbar fuer die Zuwendung, die Du ihm zukommen laesst.",
        "ist dankbar fuer die Zuwendung, die " +TPN+ " ihm zukommen laesst.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "macht grosse Augen.",
        "macht grosse Augen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "weint.",
        "weint.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}




int kaufenCmd(string str)
{ notify_fail("Was willst Du kaufen?\n");


if(str=="klinke" || str=="tuerklinke")
{	
	if(this_player()->QueryMoney() >= 200)
		{
			this_player()->AddMoney(-200);
			write("Du gibst Oitl 200 Muenzen. \nDieser oeffnet seinen Mantel. \nAn beiden Seiten haengen Tuerklinken "+
	    		  "in allen Groessen und Farben. \nEr waehlt eine aus und gibt sie Dir. "+
	      		"Danach schliesst er den Mantel wieder.\n");
			say(TPN+" kauft etwas bei Oitl.\n", TP);
			CLONE(GIER_OBJ +"klinke.lpc", TP);
			return 1;
		}
	else
		write("Oitl sagt: Du hast nicht genug Geld dabei.\n");
	return 1;
	}
return 0;
}

