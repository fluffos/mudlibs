void fluchen(object enemy)
{
  CLONE(GIER_OBJ+"sfluch_ille.lpc",enemy);
}

void muenzwurf(object enemy)
{
	enemy->AddMoney(10+random(100));
}

//Hand sekrecht vor Auge
//Ohren zu
int halten(string str)
{
   notify_fail("Was willst Du wie wohin halten?\n");
   if(str=="hand senkrecht vor nase")
   {
     if(present("AUGENPIEKSER",TP)&&find_call_out("augenpiekser")>=0)//Spieler wird also aktuell angegriffen
	  {
	   write("Schnell haelst Du Deine Hand senkrecht vor Deine Nase.\n"+
	         "Die Finger des Gierlingkoenigs bleiben an Deiner Handkante "+
	         "haengen.\n");
	   say(TPN+" haelt "+TP->QueryPossPronoun(FEMALE, WEN,SINGULAR)+" Hand "+
          "senkrecht vor "+TP->QueryPossPronoun(FEMALE, WEN,SINGULAR)+
	      " Nase und faengt damit die Finger des Gierlingkoenigs ab.\n",TP);
	   remove_call_out("augenpiekser");
	  }
	 
     else 
	    write("Du haelst Deine Hand senkrecht vor Deine Nase. Da das aber "+
	        "sinnlos ist, nimmst Du sie wieder runter.\n");
	return 1;
	}
	else if(str=="ohren zu")
	{
	  if(present("OHRENZU",TP))
	  {
	    write("Du haeltst Dir die Ohren doch schon zu\n");
		return 1;
		}
      write("Du haelst Dir die Ohren zu.\n");
	  say(TPN+" haelt sich die Ohren zu.\n",TP);	
      CLONE(GIER_OBJ+"ohrenzu.lpc",TP);
      return 1;
		 
	}
return 0;	
}


int ducken()
{
   if(present("DUCKER",TP)&&find_call_out("gesichttreter")>=0)//Spieler wird also aktuell angegriffen
	 {
	   write("Schnell duckst Du Dich unter dem Tritt des Gierlingkoenigs.\n");
	   say(TPN+" duckt sich unter dem Tritt des Gierlingskoenigs.\n",TP);
	   remove_call_out("gesichttreter");
	   }
   else 
	  write("Du duckst Dich. Da das aber sinnlos ist, richtest Du Dich wieder auf.\n");
	  
	  return 1;
}

void augenpiekser(object enemy)
{
  if(!present(enemy, environment(TO))) return;
  tell_object(enemy, "Der Gierlingkoenig sticht Dir in die Augen.\n");
  tell_room(environment(TO), "Der Gierlingkoenig sticht "+enemy->name(WEM)+
  " in die Augen.\n", ({enemy}));
  enemy->SetProp(P_BLIND,60+random(60));
  enemy->do_damage(20+random(10));
  //Attack(enemy);
  }

void gesichttreter(object enemy)
{
  if(!present(enemy, environment(TO))) return;
  tell_object(enemy, "Der Gierlingkoenig tritt Dir mitten ins Gesicht.\n");
  enemy->do_damage(15+random(15));
  tell_room(environment(TO), "Der Gierlingkoenig tritt "+enemy->name(WEM)+
  " mitten ins Gesicht.\n", ({enemy}));
  
  if(present("schneidezahn",enemy))return;
  tell_object(enemy, "Dir bricht ein Zahn ab.\n");
  CLONE(GIER_OBJ+"zahn.lpc",enemy);
  } 

void wirbler()
{
  object *alle_raum;
  object fluch;
  string geklont;
  int i;
  //
