// Der Koenig der Gierlinge
/*
//Spells: 
Beissen (Quetschen und reissen)
Mit Krone in den Bauch rammen (stechen)
Magie
Muenzen werfen. Er stielt dem Spieler eine Muenze und wirft dann damit
3 abwehrbare Ninjaspells per Random: 
  -Holt aus und sticht in Augen (wenn man die Hand senkrecht vor die Nase haelt, dann bricht Koenig den Angriff ab
  -Tritt ins Gesicht->Zahn rausgebrochen (siehe Moor->Lebkuchenhaus)
  -Wirbelt Faeuste, bricht das Genick-> man laeuft in die verkehrte Richtung
     ->Greift dadurch JEDEN im Raum an

opfert die Leiche des Spielers auf dem Altar 
->Macht daraus eine kleine Goldene Statue, die sich mit dem Opfer verbindet
  
heilt sich an Gold und Muenzen seiner Gegner
kann ausweichen
*/

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>
#include <npc.h>
#include "../def.h"
inherit "/std/player/moneyhandler.lpc";
inherit GIER_NPC + "gierling_standard.lpc";
inherit "/std/npc/spells";


object *begruesste;
void gruss()
{
  int i;
  string spieler;
  string andersrum;
  string *grusswort;
  string *grusswort2; 

  andersrum="";
  grusswort=({"Hallo ",
              "Seid gegruesst, ",
			  "Willkommen ",
			  "Ave ",
			  "Salve ",
			  "Heidiho ",
			  "Tagchen ",
			  "Aloha ",
			  "Ahoi ",
			  "Gruezi "});
			  
 grusswort2=({", schoen, Euch zu sehen!",
              ", wie geht es Euch?",
			  ", alter Haudegen!",
			  ", kommt herein, tretet naeher!",
			  ", lange nicht gesehen und doch wieder erkannt.",
			  ". Bonga Bonga!",
			  ", Toeroe.",
			  ", schoenes Wetter heute. Irgendwie... hoehlig."});
			  
			  
  if(interactive(TP))
  {
    spieler=lowerstring(TP->name());
	for(i=strlen(spieler);i--;i>=0)
	{
	  andersrum=andersrum+spieler[i..i];
	}
	
    command("sag "+grusswort[random(sizeof(grusswort))]+capitalize(andersrum)+grusswort2[random(sizeof(grusswort2))]) ;
  }
 }

  
void init()
{
  if(member_array(TP,begruesste)<0)
  {
    begruesste=begruesste+({TP});
    call_out("gruss",1);
  }
  ::init();  
}

void reset()
{
  begruesste=({});      // Array resetten um Groesse zu beschraenken (Woody)
  ::reset();
}


int ausweichen;

void create() {
  if (!is_clone(TO)) return;
  ::create();
  ausweichen=0;
  begruesste=({});
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_ARTICLE,1);
  SetProp(P_SHORT, "Der Koenig der Gierlinge");
  SetProp(P_LONG,
    "Du siehst einen kleinen, alten Gierling vor Dir. Er traegt eine kleine "
	"goldene Krone auf dem Kopf und eine weisse Toga um den Leib. Ab und "
	"zu kichert er, ansonsten grinst er Dich froehlich an und entbloesst "
	"dabei eine Reihe spitzer Zaehne.");
  SetProp(P_NAME, "Gierlingkoenig");
  SetProp(P_GENDER, MALE);
  AddId(({"koenig", "hoheit", "gierlin", "gierlingkoenig", "NOWIMPY"}));
  
  AddDetail( ({ "zaehne" }),
    "Die Zaehne des Gierlingkoenigs sind spitz. Du fragst Dich gerade, wie "
	"ziviliert er ist, oder ob er tatsaechlich beissen wuerde, wenn man "
	"ihn aergert."); 

  AddDetail( ({ "reihe"}),
    "Die Zaehne des Gierlings sind schoen gerade aufgereiht."); 
  AddDetail( ({ "", "" }),
    ""); 
  AddDetail( ({ "", "" }),
    ""); 
 
  SetChats(1, ({
    "Der Gierlingkoenig kichert leicht debil vor sich hin.\n",
	"Der Gierlingkoenig kniet nieder und betet.\n",
	"Der Gierlingkoenig fluestert: Gold, Gold, Gold!\n",
	"Der Gierlingkoenig lacht: Rubine sind feuerrot!\n",
	"Der Gierlingkoenig sagt: Aquamarine sind blau, wie Wasser.\n",
	"Der Gierlingkoenig reimt: Topas, gelb wie Sonne, welche Wonne.",
	"Der Gierlingkoenig singt: Dioptase, Dioptase, gruen wie Deine Nase.\n",
	"Der Gierlingkoenig sagt: Kalt, so kalt, der Saphir. Eisblau ist er, so kalt.\n",
	"Der Gierlingkoenig warnt: Nicht essen, die Smaragde! So giftig wie gruen.\n",
	"Der Gierlingkoenig traeumt: Opale, so wunderschoen magisch schimmern sie in allen Farben.\n",
	"Der Gierlingkoenig schimpft: Pfui, pfui, aetzend gruen, diese Lapislazuline.\n",   
	"Der Gierlingkoenig schaudert: Oh so furchtbar, so schrecklich schwarz, der Onyx.\n",    
	"Der Gierlingkoenig sagt: Bernstein leuchtet fast. Gelb ist er. Leuchtend.\n",
	"Der Gierlingkoenig kichert: Mein Granat ist dunkelrot.\n",  
	"Der Gierlingkoenig fragt: Wo ist er? \nDer Gierlingkoenig sagt: Der "+
	      "Bergkristall so durch, dass fast nicht sichtig.\n"+
	      "Der Gierlingkoenig kichert.\n",   
	"Der Gierlingkoenig strahlt: Diamant: weiss, wenn rein. Oder raus.\n",
	"Der Gierlingkoenig sagt: Amethyst blau, wie Prudis Stammgaeste.\n",                       
	"Der Gierlingkoenig sagt: Schau mir in die braunen Augen, Zirkon.\n",
	"Der Gierlingkoenig kreischt: Turmaline sind gruenschwarz.\n",
	"Der Gierlingkoenig ruft: ACHTUNG, ein Tigerauge!\nDer Gierlingkoenig duckt sich.\n",
	"Der Gierlingkoenig fragt: Ach, At?Der Gierlingkoenig antwortet: Braun.\n",
	"Der Gierlingkoenig kichert: Almandin, Aladin, violette Traeume Dir!\n",
	"Der Gierlingkoenig singt: Gelber Apatit, guter Apatit.\n",
	"Der Gierlingkoenig fragt: Wer gab Apophyllit diesen komischen Namen?\nDer Gierlingkoenig lacht.\n",
	"Der Gierlingkoenig fragt: Aventurin? Was soll das sein? Urin kenn ich. Aber Avent? Und dann braun?\n",
	"Der Gierlingkoenig albert: Blauer Benitoit... Bauer Blenitoit... Blau erben Idiot.\n",
	"Der Gierlingkoenig sagt: Citrine: Gelb wie Zitrone.\n",
	"Der Gierlingkoenig wird rot.\nDer Gierlingkoenig fluestert: Cuprit, nimm mich mit!\n",
	"Der Gierlingkoenig nickt wild.\nDer Gierlingkoenig sagt: Diaspor ist weiss, ich weiss, ich weiss.\n",
	"Der Gierlingkoenig sinniert: Jadeit sind gruen, wie schuen.\n", 
	"Der Gierlingkoenig ulkt: Jaspis ist rot, Ja spies mich tot.\n",
	"Der Gierlingkoenig singt: Rot, rot rot, sind alle Oktarine.\n",
	"Der Gierlingkoenig warnt: Fasse niemals meine Peridote an. Weil Gruen so schoen gruen GRUEN.\n",
	"Der Gierlingkoenig sagt: Pyrit sind so wunderbar gelb. Hihi, wie Pipi.\n",
	"Der Gierlingkoenig schwaermt: Rosig rosaner Rosenquarz. Herrlich, ich liebe Dich.\n",
	"Der Gierlingkoenig fragt: Wusstet Ihr: Sugilithe sind violett.\nDer Gierlingkoenig fragt: Ist das nicht unglaublich?\n",
	"Der Gierlingkoenig fragt: Warum sind Tuerkise blau? Warum nicht tuerkis?\n",
	"Der Gierlingkoenig reimt: Calcite, Bite. Aber in orange.\n",
	"Der Gierlingkoenig schlaget sich mit der flachen Hand gegen den Kopf.\n",
	"Der Gierlingkoenig betrachtet mit beiden Augen seine Nasenspitze.\n",
	"Der Gierlingkoenig denkt . o O (Heute ist ein schoener Tag.)\n",
	"Der Gierlingkoenig kitzelt Dich.\n",
	"Der Gierlingkoenig kitzelt sich selbst.\nDer Gierlingkoenig kichert.\n",
	"Der Gierlingkoenig brabbelt: Unwuerdig. ALLE unwuerdig.\n",
	"Der Gierlingkoenig schluchzt: Ich will mehr!\n",
	"Der Gierlingkoenig reibt sich die Haende.\n",
	"Der Gierlingkoenig schnippt mit den Fingern und haelt einen Edelstein in der Hand.\nDer Gierlingkoenig isst einen Edelstein.\n",
	"Der Gierlingkoenig sagt: Ein Wunder, in einer Zeit, in der es keine Wunder mehr gibt.\n",
	"Der Gierlingkoenig sagt: Fischers Fritze fischt frische Fische.\n",
	"Der Gierlingkoenig sagt: Fischers Fritze fischt fische Frische.\n",
	"Der Gierlingkoenig sagt: Blaukraut bleibt Blaukraut und Brautkleid bleibt Brautkleid.\n",
	"Der Gierlingkoenig sagt: Blaukraut bleibt Blaukraut und Blautkleid breibt Blautkreid.\n",
	"Der Gierlingkoenig starrt Dich an.\n",
	"Der Gierlingkoenig schaut sich gierig um.\n"}) );  


	AddId(({"gierling","koenig","gierlingskoenig","gierlingkoenig", "NOWIMPY"}));
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_krone.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc");
  
  command("trage alles");
  SetProp(P_KILL_NAME, "Der Koenig der Gierlinge");
  SetProp(P_KILL_MSG, "Ohja, Deine Leiche kann ich gut gebrauchen!");
  AddMoney(400+random(400));

