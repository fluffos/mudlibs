void fussgesund(object enemy)
{
  tell_object(enemy, "Dein Fuss tut nicht mehr ganz so doll weh, Du kannst wohl wieder auftreten.\n");
   enemy->SetProp(P_NOMOVE, 0);
}

void fusstreter(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_NOMOVE, "Dein Fuss schmerzt zu sehr, Du kannst nicht laufen.\n");
  call_out("fussgesund",3+random(5), enemy);  
}

