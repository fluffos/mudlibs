void insbetorium(string spielername)
{
  move ("/d/andracia/yondala/gierlingshoehle/room/gierlinge_5e",M_GO, "ins Betorium","ins Betorium");
  call_out("leicheopfern",2, spielername);
}


void leichenehmen(string spielername)
{
  string leichenname;
  leichenname="Spielerleiche_"+lower_case(spielername);
  //tell_room(environment(TO), spielername+"\n");
  
  present(leichenname, environment(TO))->move(TO, M_NOCHECK);
  tell_room(environment(TO), "Der Gierlingskoenig schnappt sich die Leiche.\n");
  if(file_name(environment(TO)) != 
                   "/d/andracia/yondala/gierlingshoehle/room/gierlinge_5e")
  call_out("insbetorium",1,spielername);
  
  else call_out("leicheopfern",2, spielername);
  }

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  tell_room(environment(TO), "Der Gierlingskoenig hebt die Hand.\n", ({victim}));
  SetProp(P_NOATTACK,1);
  call_out("leichenehmen",2,victim->name());
}


void die()
{
  "/obj/gemmaster"->DistributeGem(5,5,1,1);
  ::die();
}
