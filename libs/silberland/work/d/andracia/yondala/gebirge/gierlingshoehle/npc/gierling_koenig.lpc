int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  int i;
  int zaehler;
  object *besitz;
  
   if(ausweichen)
   {
      if(random(2)==1)
	  {
	    tell_object(enemy, "Der Gierlingskoenig huepft aus Deiner Reichweite.\n");
        tell_room(environment(TO),"Der Gierlingskoenig huepft aus der "+
		  "Reichweite von "+enemy->name(WEM)+".\n",({enemy}));
	    dam=0;
		}
	  else
	  {
	    dam=dam/2;
        tell_object(enemy, "Der Gierlingskoenig kann Deinen Angriff durch "+
	     "sein Rumgehuepfe abschwaechen.\n");
	    tell_room(environment(TO),"Der Gierlingkoenig kann den Angriff "+
	    "von "+enemy->name()+" durch sein Rumgehuepfe abschwaechen.\n",
		({enemy}));
		}
   }
 
 //Wenn er nicht ausweicht, heilt er sich eventuell an Muenzen oder Gold
 //seines Gegners
 else if (random(10)==1)
 { 
    i=enemy->QueryMoney();
	if(!i)
	{
	  besitz=all_inventory(enemy);
	  for(zaehler=sizeof(besitz);zaehler--;zaehler>=0)
	  {
	    if (besitz[zaehler-1]->QueryMaterial(MAT_GOLD))//QueryProp(P_MATERIAL)== gold)//noch nachgucken
		{  //Wert/100*Prozent
		  i=besitz[zaehler-1]->QueryProp(P_VALUE)/100*besitz[zaehler-1]->QueryMaterial(MAT_GOLD);
	      AddHp(i);
		  tell_room(environment(TO),"Der Gierlingkoenig heilt sich an "+besitz[zaehler-1]->name(WEM)+" von "+enemy->name(WEM)+".\n",({enemy}));
	      //tell_room(environment(TO), "hier passiert der Bug.\n");
		  tell_object(enemy, "Der Gierlingskoenig heilt sich an "+
	         besitz[zaehler-1]->name(WEM)+".\n");
		  return ::Defend(dam, dam_type, spell, enemy);
		 }
	  }
	}
	
	if(i>200) i=100+random(100);
	
	tell_room(environment(TO),"Der Gierlingkoenig heilt sich an den "
	  "Muenzen von "+enemy->name(WEM)+".\n", ({enemy}));
	tell_object(enemy, "Der Gierlingskoenig stielt Dir ein paar Muenzen "+
	  "und heilt sich daran.\n");
    AddHp(i);
	i=i*-1;
	enemy->AddMoney(i);

   }
 
return ::Defend(dam, dam_type, spell, enemy);
}

void nicht_ausweichen()
{
   //command("sag ich weiche nicht mehr aus\n");
   ausweichen=0;
}
