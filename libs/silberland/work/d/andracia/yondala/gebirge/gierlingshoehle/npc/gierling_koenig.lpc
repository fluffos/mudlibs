  //tell_room(environment(TO),"gewirbelt\n");
}

 

void kreischer()
{
  object *alle_raum;
  int i;
  //
  alle_raum=all_inventory(environment(TO));
  for(i=sizeof(alle_raum);i--;i>=0)
  
  {
 	if(interactive(alle_raum[i]))
	{
      if(alle_raum[i]->QueryProp(P_DEAF))
	  tell_object(alle_raum[i], 
	    "Du siehst, wie der Gierlingskoenig den Mund oeffnet. Gut, dass Du "+
		"gerade nicht hoeren kannst, das klingt bestimmt unangenehm.\n");
	  
	  else
	  {
	  tell_object(alle_raum[i],"Der Gierlingskoenig kreisch so laut, "+
	                           "dass Dir fast die Ohren platzen.\n");
	  alle_raum[i]->do_damage(20+random(20));
	  alle_raum[i]->SetProp(P_DEAF,20);	  
	  }
	 }
  }

}

  void kreischen(object enemy, int damage, mixed dam_type) 
{
   call_out("kreischer",3);
 }

