// Dampfhoehle
// alle NPCs können sich dort aufhalten. Sie sind nackt mit Handtüchern. 
// Vergisst der Spieler ein Handtuch zu kaufen kichern die Kobolde und 
// zeigen mit dem Finger auf ihn.
// in dem Raum soll man etwas schneller wieder zu kräften kommen als normal
// vielleicht so schnell wie beim rasten. Aber man sollte nicht zu lange drin
// bleiben dürfen.

#include <moredef.h>
inherit "std/room";
#include <properties.h>


//int sitz_status=0;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Sauna der Kobolde" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Dampfhoehle der Kobolde. Hier ist alles aus Holz. "
    "Rundherum an den Waenden stehen Holzbaenke."
    "Dichter Dampf wabert durch den Raum" );
  SetProp( P_LIGHT, 1 );// geht da auch 0,5?
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
     AddDetail( ({ "dampfraum", "dampfhoehle", "raum" }),
    "Du befindest Dich im Dampfraum der Kobolde.");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden stehen rundherum Baenke " 
    "aus Holz, nur nicht an der Wand mit der Tuer.");
      AddDetail( ({ "bank", "baenke", "holzbank", "holzbaenke" }),
    "Sie bestehen aus Holz. Man koente auf ihnen sitzen");
  AddDetail( ({ "tuer", "tuere" }),
    "Durch diese Tuer bist Du gekommen.");
  AddDetail( ({ "holz" }),
    "Vermutlich aus den Elfenwaeldern importiert und von Elfen hergestellt.");
  AddDetail (({"elfenwaelder", "elfenwaeldern", "elfen"}),
    "Die kennst Du doch, oder?"); 
  AddDetail( ({ "man", "jemand" }),
    "Irgendwer.");
  AddDetail (({"irgendwer"}),
  	"Du bist irgendwer.");
  AddDetail( ({ "du", "dich" }),
    "Guck in nen Spiegel!");
  AddDetail( ({ "spiegel" }), //Man muesste also noch einen Spiegel programmieren. Reicht ja, wenn der einem je nach Verfassung sagt wie man aussieht
    "Der ist beschlagen vor lauter Dampf");
  AddDetail( ({ "wasser" }),
    "Das Wasser wird benutzt um Dampf zu erzeugen.");
  AddDetail( ({ "dampf", "dampfschwaden" }),
    "Dampf ist in Luft geloestet Wasser.");
  AddDetail( ({ "luft" }),
    "Die Luft ist voll heissen Dampfs.");
  AddDetail( ({ "steine" }),
    "Die Steine liegen auf der Feuerstelle. Auf sie kann man Wasser giessen "
    "um Dampf zu erzeugen.");
  AddDetail( ({ "feuerstelle" }),
    "Auf der Feuerstelle liegen Steine um dort erhitzt zu werden. Neben der "
    "Feuerstelle steht ein Kuebel mit Wasser.");
  AddDetail( ({ "kuebel" }),
    "In dem Kuebel ist Wasser und eine Kelle.");
  AddDetail( ({ "kelle" }),
    "Mit der Kelle kann man Wasser auf die heissen Steine schoepfen.");
  AddDetail( ({ "" }),
    "");


  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es zischt.");

  AddSound( ({ "zischen" }),
    "Das ist wohl das Zischen von verdunstendem Wasser.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Kraeutern.");

  AddSmell( ({ "kraeuter", "kraeutern", "aufguss" }),
    "Dem Aufguss scheinen Kraeuter beigemischt worden zu sein.");

  AddRoomMessage( 
    ({"Es zischt. Jemand hat anscheinend wieder Wasser auf die heissen Steine gegossen.\n", "Dampfschwaden wabern durch den Raum.\n"}),60,"func");


  AddCmd( ({ "schoepf", "schoepfe" }), "schoepfenCmd" );
  
  
  AddExit( "norden", "/d/koboldhoehle/koboldhoehle_1f.lpc" );
  AddCmd(({"sitze","setze", "sitz"}),"sitzenCmd");
  AddCmd(({"steh","stehe"}),"aufstehenCmd");
//  AddCmd(({"norden","nord"}),"gehenCmd");
}
sitzenCmd(string str)

{ notify_fail("Worauf willst du dich setzen?\n");
if(str=="auf bank" || str=="auf holzbank")
{
		write("Du setzt Dich auf die Bank.\n");
		say(TPN+" setzt sich auf die Bank.\n");
//  SetProp( P_NOMOVE, 1 );
//P_NOMOVE ("Du solltest erst aufstehen");
		return 1;
}
}

aufstehenCmd(string str)
{ //notify_fail("Du solltest erst aufstehen.\n");

if(str=="auf")
{
		write("Du stehst auf.\n");
		say(TPN+" steht auf.\n");
//  SetProp( P_NOMOVE, 0 );

		return 1;

}
}

schoepfenCmd(string str )
{
  notify_fail( "Was moechtest du tun?\n" );
  if( str == "wasser auf steine","wasser mit kelle auf steine", "wasser auf feuerstelle", "wasser mit kelle auf feuerstelle" )
  {
    write("Du nimmst die Kelle und schoepfst etwas Wasser auf die heissen Steine.\nDampf steigt auf.\n");
    say( TPN+" nimmt die Kelle und schoepfst etwas Wasser auf die heissen Steine.\nDampf steigt auf.\n");
    return 1;
  }
  return 0;
}