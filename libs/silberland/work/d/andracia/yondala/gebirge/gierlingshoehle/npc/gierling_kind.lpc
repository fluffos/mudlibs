// 2.1.2012: Kind ist nun maennlich oder weiblich
//           hat Lutscher oder Springseil dabei
//           stiehlt Muenzen und fluechtet dann




// Funktionell ueberarbeitet am 16.01.2011
// Yondala@Silberland

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
inherit "/std/player/moneyhandler.lpc";


void dieb()
{
  string *ausgaenge;
  object *alle; 
  object opfer;
  int i;

  if (!TO) return;
  if (!environment(TO)) return;
  alle=all_inventory(environment(TO));
  opfer=alle[random(sizeof(alle))];
  if (interactive(opfer))
  { 
    if (opfer->QueryMoney()>=15)
	tell_object(opfer,capitalize(name())+" stiehlt Dir ein paar Muenzen.\n");
	tell_room(environment(TO),name()+" stiehlt "+opfer->name(WEM)+
	  " ein paar Muenzen.\n",({opfer}));
	i=5+random(10);
	opfer->AddMoney(-i);
	AddMoney(i);
    ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
    command( ausgaenge[random(sizeof(ausgaenge))] );
   }
}	
	
void init()
{
  ::init();
  if (!is_clone(TO)) return;
  call_out("dieb",5+random(10));
}

 void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  dieb();
}  


void create() {
  if (!is_clone(TO)) return;
  ::create();
  if(random(2))//Maedchen
  {
    SetProp(P_SHORT, "Ein Gierlingmaedchen");
    SetProp(P_LONG,
      "Du siehst ein kleines Gierlingsmaedchen. Es traegt ein kleines "
      "Kleidchen und einfache Sandalen. Die Haare des Kindes sind roetlich, "
      "die Haut hell und es schaut Dich mit grossen Augen neugierig an." );
    SetProp(P_NAME, "Gierlingmaedchen");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_ARTICLE, 1);
    AddId(({"gierlingkind", "kind", "maedchen", "gierlingmaedchen"}));
    create_default_npc(2);
    SetProp(P_HANDS, ({" aengstlich",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
    SetProp(P_KILL_NAME, "Ein Gierlingmaedchen");
    SetProp(P_KILL_MSG, "Ha, leg Dich NIE mit einem Maedchen an!");
    CLONEME(GIER_ARMOUR + "gierling_kleidchen.lpc");
    CLONEME("/p/armour/boots/sandalen.lpc");
    SetProp(P_SIZE, 45);
    SetProp(P_WEIGHT, 6000);
    SetProp(P_ALIGN, 20);
  }
  else
  {
    SetProp(P_SHORT, "Ein Gierlingjunge");
    SetProp(P_LONG,
      "Du siehst einen Gierlingjungen. Es traegt eine einfache Toga und "
          "flache Lederschuhe. Die Haare des Jungen sind dunkelrot, um seine "
          "Stupsnase versammeln sich unzaehlige Sommersprossen. Der Junge "
          "schaut Dich spitzbuebisch an." );
    SetProp(P_NAME, "Gierlingjunge");
    SetProp(P_GENDER, MALE);
    SetProp(P_ARTICLE, 1);
    AddId(({"gierlingkind", "kind", "junge", "gierlingjunge"}));
    create_default_npc(4);
    SetProp(P_HANDS, ({" mutig",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
    SetProp(P_KILL_NAME, "Ein Gierlingjunge");
    CLONEME(GIER_ARMOUR + "gierling_toga.lpc");
    CLONEME("/p/armour/boots/lederschuhe.lpc");
    SetProp(P_SIZE, 50);
    SetProp(P_WEIGHT, 6500);
    SetProp(P_ALIGN, 0);
  }

  SetProp(P_WIMPY, 5);

  SetProp(P_MSGIN, "huepft heran"); 
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGOUT, "stampft dreimal auf den Boden und ist weg");

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, TPN+ " ist ein Kindermoerder!!!");

  if (random(2))
    CLONEME(GIER_OBJ+ "springseil"); 
  else
    CLONEME(GIER_OBJ+ "lutscher"); 
  
  AddInfo(DEFAULT_INFO, "sagt: Das darf ich nicht sagen.\n");
  SUID;
  command("trage alles");

  AddInfo( ({"quest","abenteuer, hilfe"}), 
    "Das musst Du schon alleine schaffen.",
    "sagt: "); 
     
  AddInfo( ({"mutter","eltern", "mama"}), 
    "Meine Mama laeuft hier irgendwo rum.",
    "sagt: ");    
  AddInfo( ({"springseil","seil"}), 
    "Das ist meins!",
    "sagt: "); 
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bohrt in der Nase und schmiert Dir einen Popel ans Knie.",
        "bohrt in der Nase und schmiert " +TPN+ " einen Popel ans Knie..");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist fuer sowas zu jung und schubst Dich weg.",
        "ist fuer sowas zu jung und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "strahlt Dich an.",
        "strahlt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "macht grosse Augen.",
        "macht grosse Augen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "weint.",
        "weint.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

