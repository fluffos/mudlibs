int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_gierlinge_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Scrollan das Gierlingmaedchen");
  SetProp(P_LONG,
    "Das ist Scrollan, sie ist ein junges Gierlingsmaedchen, fast schon eine Frau. "
    "Sie traegt ein gruenes Kleid, braune Mokassins und einen grossen gelben Hut "
    "auf ihren roten Haaren. Sie hat eine helle Haut, aber tiefrote Lippen und "
    "leuchtend gruene Augen. Fuer einen Gierling mag sie sicherlich schoen "
    "aussehen. An ihrem Guertel haengt ein leeres Goldsaeckchen. " 
    "Scrollan wirkt verstoert." );
  SetProp(P_NAME, "Scrollan");//nur der Name 1. Buchstabe gro�
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
