  	GIER_ROOM+"gierlinge_7c", 
  	GIER_ROOM+"gierlinge_6c" }));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS );
SetProp (P_MNPC_WAIT, ({20, 30, 20}));
  AddId(({"scrollan", "winzling", "gierlingkind", "kind", "maedchen"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");
  SUID;
 CLONEME(GIER_ARMOUR + "gierling_kleidchen.lpc");
  CLONEME(GIER_ARMOUR + "gierling_scrollanhut.lpc");
  command("trage alles");
  CLONEME(GIER_OBJ + "goldsaeckchen.lpc");  
  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihrem Hut",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, 150);//Gesinnung. frech so zwischen -50 und -500

//  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "kommt heran"); 
  SetProp(P_MSGOUT, "geht");


  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Und ich dachte, Du wuerdest mir helfen, " +TPN+ "!");
  SetProp(P_KILL_NAME, "Scrollan das Gierlingmaedchen");
  SetProp(P_KILL_MSG, "Ha, leg Dich NIE mit einem Maedchen an!");

  AddInfo(DEFAULT_INFO, "sagt: Weiss ich leider nicht, aber koennt Ihr mir bitte helfen?\n");
  
  AddInfo("hilfe", "Ja, ich brauche dringend Hilfe. Ich bin so traurig. " 
  "Meine ueber alles geliebte Grossmutter ist vor kurzem gestorben. "
  "Wir sind sehr arm und alles, was sie mir hinterlassen hat ist ein goldenes Armband. "
  "Ich liebe dieses Armband sehr, aber es wurde mir gestohlen. Bitte hilf mir es wiederzufinden!","sagt: "); 

  AddInfo("armband", "Es wurde mir gestohlen, als ich letztens das Kind unserer Nachbarn huetete.","sagt: "); 
  AddInfo(({"nachbarn", "nachbarin", "nachbar"}), 
    "Unsere Nachbarn wohnen in der glitzernden Hoehle hier. So wie alle "
    "Gierlingswohnhoehlen ist auch ihre versteckt, aber ich kenne den Trick, "
    "wie man sie findet.","sagt: "); 
  AddInfo("hoehlentrick", "Weil ich ihr Kind huete mussten sie mir verraten "
    "wie man ihre Wohnhoehle findet. Man muss an der Wand davor einen kleinen "
	"Edelstein drehen, dann tut sich die Wand auf. Er "+
	   "klemmt allerdings manchmal etwas.","sagt: ");  
  
  AddInfo( ({"kind","nachbarkind"}), 
    "Das Kind unsere Nachbarn ist noch ganz klein, eigentlich ein Saeugling. "
    "Ich passe immer darauf auf, aber jetzt habe ich es zurueck gelassen, um mein Armband zu finden.",
    "sagt: ");
    
  AddInfo( ({"quest","abenteuer"}), 
    "Das musst du schon alleine schaffen.",
    "sagt: "); 
  AddInfo( ({"edelstein"}), 
    "Ich weiss nicht mehr genau, welcher das war.",
    "sagt: "); 
  AddInfo( ({"hoehle"}), 
    "In der glitzernden Hoehle wohnen wir Gierlinge, aber die Wohnraeume "
	"wird man nicht finden, wir trauen niemandem und tarnen sie daher gut.",
    "sagt: "); 
  AddInfo( ({"beruhigen","beruhigung","saeugling beruhigen", "saeugling"}), 
    "Der Saeugling unserer Nachbarn ist total niedlich, aber er fremdelt sehr. Ich kenne jedoch einen kleinen Trick um ihn zu beruhigen.",
    "sagt: "); 
  AddInfo( ({"saeuglingtrick", "saeuglingstrick"}), 
    "Wenn man dem Saeugling ein Schlaflied singt schlaeft er meist ein.",
    "sagt: "); 
  AddInfo( ({"trick"}), 
    "Welchen Trick meint Ihr? Den Hoehlentrick oder den Saeuglingtrick?",
    "sagt: "); 
  AddInfo( ({"klinke"}), 
    "Hm, Klinke? Oitl verkauft Klinken, soweit ich weiss.",
    "sagt: "); 
/*  AddInfo( ({"belohnung"}), 
    "Nun, jeder, der mir einmal hilft, wird von mir belohnt.",
    "sagt: "); 
  */
  AddInfo( ({"klemmen"}), 
    "Da wird Euch schon etwas einfallen.",
    "sagt: "); 
  AddInfo( ({"schlaflied"}), 
    "Ach, irgendeins, das Kleine ist nicht so anspruchsvoll.",
    "sagt: "); 
  AddInfo( ({"wohnhoehle", "gierlingswohnhoehle", "wohnhoehlen", "gierlingswohnhoehlen"}), 
    "Jeder Gierling hat eine eigene Wohnhoehle. Weil aber niemand dem "
	"anderen traut, sind fast alle Wohnhoehlen versteckt.",
    "sagt: "); 

  AddInfo( ({"scrollan"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({"belohnung"}), 
    "Viel habe ich nicht, aber wenn mir jemand hilft, so werde ich schon "
	"eine kleine Belohnung fuer ihn finden.",
    "sagt: "); 
  AddInfo( ({"portal", "portale"}), 
    "Wie in fast jedem Ort Andracias, gibt es auch in unserer Gierlingshoehle ein Portal, welches das schnelle Reisen ermoeglicht.",
    "sagt: "); 
  AddInfo( ({"reise","reisen"}), 
    "Ich verreise nicht oft.",
    "sagt: "); 
  AddInfo( ({"andracia"}), 
    "Der Kontinent, auf dem wir uns befinden, nennt sich Andracia.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
     
   AddInfo( ({"mutter","eltern", "vater"}),
    "Meine Eltern sind zuhause.",
    "sagt: ");   
   AddInfo( ({"grossmutter","grosseltern", "grossvater", "opa", "oma"}), 
    "Meine Grosseltern leben nicht mehr.",
    "sagt: "); 
 
  SetProp (P_REJECT, ({ REJECT_GIVE, "" }) );
    
// void NotifyGiveQuest(object pl, string key);

  SetChats(3, ({
    "Scrollan laeuft hin und her. Sie scheint etwas zu suchen.\n",
    "Scrollan untersucht etwas auf dem Boden.\n"}) );

//  AddCmd(({"",""}),"Cmd");

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt " +TPN+ " die Zunge raus.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
         "schaut Dich traurig an.",
         "schaut Dich traurig " +TPN+ " an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist fuer sowas zu jung und schubst Dich weg.",
        "ist fuer sowas zu jung und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "strahlt Dich an.",
        "strahlt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "macht grosse Augen.",
        "macht grosse Augen.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "weint.",
        "weint.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

//Questende

void give_notify(object ob)
{
	if(ob->id("\narmband"))
		{	
			ob->remove(); //armband zerstoeren
			write("Scrollan strahlt Dich mit grossen Augen an und drueckt "
				"das Armband an ihre Brust.\n");
			say("Scrollan strahlt "+TP->name(WEN)+"mit grossen Augen an und "+
			    "drueckt das Armband an ihre Brust.\n",TP);
				
				
			//Der Spieler hat die Quest schon gemacht
			if(testobgemacht(TPN))
			//if (call_other("/d/andracia/yondala/lunia/room/lunia_5e", "werdarf",TPN)) 
			{
			  command("sag Vielen Dank, dass Ihr mir noch einmal geholfen "+
			          "habt, "+TPN+"!\n");

			  //Wenn man das Portal und die Locke schon hat, ist hier Schluss
			  if(present("scrollanlocke",TP)) return;
			  
			  command("sag Viel besitze ich nicht, "+
				"doch will ich Euch belohnen. Nehmt eine Locke meines "
				"Haares als Dank. Es wird Euch gewiss einmal nuetzen!");
				CLONE(GIER_OBJ+"scrollanlocke", TP);
			 	write("Scrollan schenkt Dir eine Locke.\n");
			 	say("Scrollan schenkt "+TPN+" eine Locke.\n",TP);
				}
			
			else//Spieler hat das Portal noch nicht
            {				
			  command("sag Vielen Dank, dass Ihr mir geholfen habt, "+TPN+
			  "!\nViel besitze ich nicht, doch will ich Euch belohnen. "
			  "Hier in Gierlingen ist ein Portal, welches uns das schnelle "
			  "Reisen ermoeglicht. Ihr duerft es nun benutzen.");
			 //  call_other("/d/andracia/yondala/lunia/room/lunia_5e", "auchduerfen",TPN);
				write_file("/d/andracia/yondala/wolken/lunia/portale/portal_gierlinge_zugang.lpc", "\n"+TPN);
				}
				  
		}
					
				
	 else ::give_notify(ob);
}