//Der Wirt

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"

inherit GIER_NPC + "gierling_standard.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "prudi der Wirt");//Kurzbeschreibung in Klammern (Name mit titel)
  SetProp(P_LONG,
    "Das ist prudi. Er ist ein Gierling. Er traegt einen gruenen Schlapphut. Darunter "
    "schauen zottelige rote Haare hervor. Er traegt eine dunkelgruene Schuerze. "
    "Seinen Unterkoerper siehst Du nicht. Aber er hat bestimmt einen. "
    "Wie gross er ist kannst Du nicht sehen, da er hinter dem Tresen steht und Du "
    "nicht sicher bist ob da nicht doch ein Podest ist.");
  SetProp(P_NAME, "Prudi");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"prudi", "gierling", "wirt", "PRUDI", "NOWIMPY"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
  SetProp(P_NOATTACK, 1);
//  set_living_name("");

  create_default_npc(20);// Die Zahl entspricht der Spielerstufe des GIER_NPC
  SetProp(P_HANDS, ({" mit einer Schnapsflasche",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

 
  SetProp(P_ALIGN, 50);//Gesinnung. frech so zwischen 50 und 500
  SetProp(P_KILL_NAME, "Prudi der Gierling");//name des tötenden npc
  SetProp(P_KILL_MSG, "In meiner Kneipe randalierst Du nicht!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat
  SetChats(1, ({
    "Prudi spuelt ein Glas.\n",
	"Prudi wischt die Theke sauber.\n",
	"Prudi serviert einem Gast einen knusprig gebratenen Wurm.\n",
    "Ein Gast bestellt ein Gubblbein.\nPrudi sagt: Bitte schoen, habe ich selbst erlegt!\n",
    "Prudi serviert einem Gast einen knackigen Wolbhintern.\nDer Gast knackt den Wolbhintern.",          
    "Prudi bringt einen deftigen Krebilnacken an einen Tisch, wo er sofort verspeist wird.\n",
	"Prudi schenkt einen Kelch Wein ein und stellt ihn auf einen Untersetzer.\n",
    "Prudi zapft ein Bier und reicht es einem Gast.\nPrudi sagt: Prost!\n"}) );


	
  AddInfo( ({ "tatti", "tochter" }),
    "Die ist grad nicht da, kommt aber bestimmt bald wieder.",
    "sagt: ");
  AddInfo( ({ "wirt", "prudi" }),
    "Das bin ich.",
    "sagt: ");
   AddInfo( ({ "untersetzer" }),
    "Die Untersetzer hat meine Tochter fuer mich gehaekelt.",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
   AddInfo( ({ "" }),
    ".",
    "sagt: ");
  

  AddSpell(1,200,
              "Prudi wirft einen Krug nach Dir.\n",
              "Prudi wirft einen Krug nach @WEM.\n",
              ({DT_BLUDGEON, DT_WATER}), ([SP_SHOW_DAMAGE:1]) );
      AddSpell(1,100,
              "Prudi wuergt Dich mit seiner Schuerze.\n",
              "Prudi wuergt @WEN mit seiner Schuerze.\n",
              ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]) );
			  
			  
     AddSpell(1,100,
              "Prudi bespitzt Dich mit Gierlingschnaps.\n",
              "Prudi bespitzt @WEN mit Gierlingschnaps.\n",
              ({DT_WATER,DT_POISON}), "schnaps", ([SP_SHOW_DAMAGE:1]) );
   




  
  SUID;
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  CLONEME(GIER_ARMOUR + "gierling_schlapphut.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_schuerze.lpc"); 
  CLONEME(GIER_ARMOUR + "gierling_toga.lpc"); 
  command("trage alles");
  CLONEME(GIER_OBJ + "goldsaeckchen.lpc");  
  CLONEME(GIER_WEAPON + "gierling_dolch.lpc");
  command("zuecke dolch");

}


void schnaps(object enemy)
{
	enemy->AddPoison(1);
	enemy->SetProp(P_ALCOHOL, enemy->QueryProp(P_ALCOHOL)+random(5));
}
	
	
	