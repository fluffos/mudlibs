#include <moredef.h>
#include "../def.h"


inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_ROOM_MSG,0);
 AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast. Ausserdem sind die Waende mit Edelsteinen gespickt.");
  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erhellt sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "osten" }),
    "Du kannst nicht wirklich sehen, was im Osten ist. Du vermutest aber, "
	"dass Du dort tiefer in die Hoehle gelangst.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild ergeben.");


  AddDetail( ({ "gang" }),
    "Die Hoehle ist hier mehr ein Gang. Er ist eng, aber gerade breit "
	"genug, um ihn ohne Beklemmungen passieren zu koennen.");
  AddDetail( ({ "beklemmungen" }),
    "Du hast keine, zumindest nicht jetzt gerade hier in diesem Gang.");
  AddDetail( ({ "erde" }),
    "Du bist schon ein ganzes Stueck unter der Erde.");
  AddDetail( ({ "stueck" }),
    "Immerhin so weit, dass Du den Ausgang nicht mehr sehen kannst.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");


  AddDetail( ({ "farbe","farben" }),
    "Das Bild an der Wand funkelt in vielen verschiedenen Farben.");

	
//*******Metalle**********************
  AddDetail( ({ "gold" }),
    "Gold ist ein Edelmetall.");
  AddDetail( ({ "silber" }),
    "Silber ist ein Edelmetall.");
  AddDetail( ({ "bronze" }),
    "Bronze ist eine Legierung aus Kupfer und Zinn.");
  AddDetail( ({ "kupfer","zinn" }),
    "Daraus besteht Bronze.");
  AddDetail( ({ "legierung","mischung" }),
    "Eine Legierung ist eine Mischung.");
  AddDetail( ({ "edelmetalle","edelmetall" }),
    "Edelmetalle sind sehr begehrt.");
//*****************Edelsteine******************
  AddDetail( ({ "aventurine","aventurin" }),
    "Aventurine sind dunkelgruene Edelsteine.");
  AddDetail( ({ "rosenquarze", "rosenquarz" }),
    "Rosenquarze sind rosane Edelsteine.");
  AddDetail( ({ "diamanten","diamant" }),
    "Diamanten sind weisse Edelsteine.");
  AddDetail( ({ "rubine","rubin" }),
    "Rubine sind feuerrote Edelsteine.");
  AddDetail( ({ "aquamarine","aquamarin" }),
    "Aquamarine sind wasserblaue Edelsteine.");
  AddDetail( ({ "topase","topas" }),
    "Topas sind sonnengelbe Edelsteine.");
    
  AddDetail( ({ "smaragde","smaragd" }),
    "Smaragde sind giftgruene Edelsteine.");
  AddDetail( ({ "saphire","saphir" }),
    "Saphire sind eisblaue Edelsteine.");
  AddDetail( ({ "opale","opal" }),
    "Opale sind magisch in allen Farben schillernde Edelsteine.");
  AddDetail( ({ "onyxe","onyx" }),
    "Onyxe sind schwarze Edelsteine.");
  AddDetail( ({ "lapislazulis", "lapislazuli" }),
    "Lapislazuli sind gruene Edelsteine.");
  AddDetail( ({ "bernsteine","bernstein" }),
    "Bernsteine sind leuchtend gelbe Edelsteine.");
  AddDetail( ({ "granate","granat" }),
    "Granate sind dunkelrote Edelsteine.");
  AddDetail( ({ "bergkristalle","bergkristall" }),
    "Bergkristalle sind durchsichtige Edelsteine.");
  AddDetail( ({ "apatite","apatit" }),
    "Apatite sind gelbe Edelsteine.");
  AddDetail( ({ "almandine","almandin" }),
    "Almandine sind violette Edelsteine.");
  AddDetail( ({ "achate","achat" }),
    "Achate sind braune Edelsteine.");
  AddDetail( ({ "tigeraugen","tigerauge" }),
    "Tigeraugen sind braune Edelsteine.");
  AddDetail( ({ "turmaline","turmalin" }),
    "Turmaline sind gruenschwarze Edelsteine.");
  AddDetail( ({ "zirkone","zirkon" }),
    "Zirkone sind braune Edelsteine.");
  AddDetail( ({ "amethyste","amethyst" }),
    "Amethyste sind blaue Edelsteine.");
  AddDetail( ({ "dioptase","dioptas" }),
    "Dioptase sind gruene Edelsteine.");
  AddDetail( ({ "diaspore","diaspor" }),
    "Diaspore sind weisse Edelsteine.");
  AddDetail( ({ "cuprite","cuprit" }),
    "Cuprite sind rote Edelsteine.");
  AddDetail( ({ "citrine","citrin" }),
    "Citrine sind gelbe Edelsteine.");
  AddDetail( ({ "benitoite","benitoit" }),
    "Benitoite sind blaue Edelsteine.");
  AddDetail( ({ "aventurine","aventurin" }),
    "Aventurine sind braune Edelsteine.");
  AddDetail( ({ "apophyllite","apophyllit" }),
    "Apophyllite sind gelbe Edelsteine.");
	AddDetail( ({ "tuerkis", "tuerkise" }),
    "Tuerkise sind blaue Edelsteine.");
  AddDetail( ({ "sugilithe","sugilith" }),
    "Sugilithe sind violette Edelsteine.");
  AddDetail( ({ "pyrite","pyrit" }),
    "Pyrite sind gelbe Edelsteine.");
  AddDetail( ({ "peridote","peridot" }),
    "Peridote sind gruene Edelsteine.");
  AddDetail( ({ "oktarine","oktarin" }),
    "Oktarine sind rote Edelsteine.");
  AddDetail( ({ "jaspise","jaspis" }),
    "Jaspise sind rote Edelsteine.");
  AddDetail( ({ "jadeite","jadeit" }),
    "Jadeite sind gruene Edelsteine.");
  AddDetail( ({ "calcite","calcit" }),
    "Calcite sind orangefarbene Edelsteine.");
  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Es ist hier recht still.");

  AddSound( ({ "stille" }),
    "Es ist zwar still, aber auf eine angenehme Art.");

  AddSound( ({ "art" }),
    "Damit ist gemeint, dass die Stille nicht drueckend oder irgendwie "
	"unangenehm ist.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist sehr trocken.");
  AddSmell( ({ "luft" }),
    "Du bist froh, dass es hier nicht so riecht wie in manch anderer Hoehle.");
  AddSmell( ({ "hoehle","hoehlen" }),
    "Die meisten anderen Hoehlen, in denen Du schon warst riechen eher modrig und feucht.");




}


