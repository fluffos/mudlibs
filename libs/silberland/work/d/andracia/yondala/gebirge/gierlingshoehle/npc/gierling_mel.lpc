#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include "../def.h"

inherit "std/npc";

void create() {
  if (!is_clone(TO)) return;
  ::create();
  //SetProp(P_LOG_INFO, "yondalas_antworten");

  SetProp(P_SHORT, "Mel die Dorfmatratze");
  SetProp(P_LONG,
    "Das ist Mel, sie ist eine junge Gierlingsfrau. Sie traegt ein enges rotes Lackkleid. "
    "Ihre Fuesse stecken in schwarzen Pumps, die bei einem so kleinen Wesen irgendwie laecherlich aussehen. "
    "Ihre Haare sind schwarz, lang und strubbelig. Ihr Gesicht hat Mel in grellen Farben geschminkt." );
  SetProp(P_NAME, "Mel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"mel", "nutte", "flittchen", "dorfmatratze", "maedchen"}));//Dinge auf die man ihn beim untersuchen ansprechen kann
SUID;
  CLONEME(GIER_ARMOUR + "gierling_lackkleid.lpc");
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  command("trage alles");
  CLONEME(GIER_OBJ + "goldsaeckchen.lpc");
  
    AddDetail( ({ "kleid", "lackkleid" }),
    "Das Kleid war sicher mal teuer, ist aber wohl nicht mehr das neuste."); 
  AddDetail( ({ "pumps", "schuhe" }),
    "Schwarze Pumps, die zwar recht hoch sind, aber bei Mel nicht viel ausmachen."); 
  AddDetail( ({ "haare", "haar" }),
    "Mels Haare sind schwarz"); 
  AddDetail( ({ "gesicht", "schminke" }),
    "Mels Gesicht ist voller Schminke."); 
    
  AddDetail( ({ "", "" }),
    ""); 
    
    
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihrem Lolli",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "kommt rein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt daher");

  SetProp(P_DIE_MSG,  " bricht zusammen und flutscht in den Gulli.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, TPN+ " hat nicht bezahlt!!!");
  SetProp(P_KILL_NAME, "Mel");
  SetProp(P_KILL_MSG, "Tja, das kommt davon.");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat
  SetChats(3, ({
    "Mel dreht eine Haarstraehne um ihren Finger.\n","Mel macht eine Kaugummiblase\n",
    "Mel lehnt sich an die Laterne\n", "Mel macht einen Kussmund in deine Richtung.\n"}) );
    
  AddInfo(DEFAULT_INFO, "gibt keine Auskunft.\n");
   


}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "stampft auf den Boden.",
        "stampft auf den Boden.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt dich!",
        "tritt" +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift " +TPN+ ".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich an.", 
        "lacht " +TPN+ " an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "macht sowas nicht umsonst und schubst Dich weg.",
        "macht sowas nicht umsonst und schubst " +TPN+ " weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt " +TPN+ " an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "puhlt Dreck unter ihren Naegeln hervor.",
        "puhlt Dreck unter ihren Naegeln hervor.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "ist traurig.",
        "ist traurig.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
