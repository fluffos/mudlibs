// Ein Krebil

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"

inherit "std/mnpc";
	
object ob;		
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Krebil");
  SetProp(P_LONG,
    "Das ist ein Krebil. Ein Krebil ist groesser und staerker als ein Gubbl. "
    "Der Krebil ist ein kleines, schleimiges Wesen, sein Gesicht laed geradezu "
    "dazu ein reinzuschlagen. Wenn man sich nicht allzudoll ekelt...");
  SetProp(P_NAME, "Krebil");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);


  AddId(({"krebil"}));
   create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Tentakeln",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 13000);
  SetProp(P_ALIGN, -50);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Krebil");


  SetProp( P_REJECT, ({ REJECT_DROP,
   "Der Krebil will Deine Sachen nicht tragen.\n" }) );
//  SUID;
//  CLONEME(GIER_OBJ + "diamant.lpc");



  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 1 + random(12));
  ob->move(TO, M_SILENT);
}

