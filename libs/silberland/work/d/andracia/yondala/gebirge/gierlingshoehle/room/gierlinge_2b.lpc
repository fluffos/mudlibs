// Idee: Der Schmied hier soll die Goldklumpen zu einem verjuwelierbaren Goldstueck machen
// die Schmiede
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Schmiede" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Schmiede. Auch hier gibt es keine "
    "direkte Lichtquelle und es ist generell recht dunkel, da die "
    "normalerweiser leuchtenden Waende mit einer dicken Staub- und "
    "Dreckschicht bedeckt sind. Ausserdem steht noch allerlei Zeug davor." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

AddItem(GIER_NPC + "gierling_werner.lpc",REFRESH_DESTRUCT);

  AddDetail( ({ "schmiede" }),
    "Du befindest Dich in einer kleinen Schmiede. Hier ist es dunkler als draussen, weil ueber "
    "allem eine dicke Schmutzschicht liegt.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende der Schmiede sind kaum zu sehen, denn es steht allerlei "
    "Geruempel davor. Der Schmied scheint nicht sonderlich ordentlich zu sein. "
    "An einer Wand steht ein grosser Ofen, an einer anderen eine grosse Werkzeugkiste. ");
  AddDetail( ({ "boden"}),
    "Der Boden ist aus Fels gehauen. Hier liegen Reste und Dinge rum, "
    "die man wohl nie wieder braucht...");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen.");
  AddDetail( ({ "werkzeug" }),
    "Puh, verschiedenes halt.");
  AddDetail( ({ "bank", "werkbank" }),
    "Auf der Werkbank liegt allerlei Werkzeug rum.");
  AddDetail( ({ "reste", "dinge", "zeug", "geruempel" }),
    "Man koennte es auch als Muell bezeichnen.");
  AddDetail( ({ "muell" }),
    "Ja, es ist Muell.");
  AddDetail( ({ "ofen" }),
    "Der Ofen ist verhaeltnismaessig gross und es flackert ein heisses Feuer darin.");
  AddDetail( ({ "feuer" }),
    "Das Feuer ist heiss und es ist nicht empfehlenswert eine Hand reinzustecken.");
  AddDetail( ({ "staub", "dreck", "staubschicht", "dreckschicht" }),
    "Staub und Dreck zeugen davon, dass Werner nicht unbedingt sehr reinlich ist. Dafuer aber viel arbeitet.");
  AddDetail( ({ "decke" }),
    "Die Decke ist aus Fels gehauen.");
  AddDetail( ({ "hand" }),
    "Nun mal ehrlich, man muss nicht alles und jedes untersuchen. Tu nicht so, als wuesstest Du nicht, was eine Hand ist.");
  AddDetail( ({ "schmied" }),
    "Der Schmied, dem diese Schmiede gehoert, heisst Werner.");
  AddDetail( ({ "schmutzschicht" }),
    "Die Schmutzschicht zeugt davon, das hier nicht oft geputzt wird.");
  AddDetail( ({ "werkzeugkiste", "kiste" }),
    "Sie ist so gross, dass sich darin ein Kind verstecken koennte.");
  AddDetail( ({ "" }),
    "");

    
  AddReadDetail( ({ "" }),
    "");
      AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Feuer knistern.");

  AddSound( ({ "feuer","knistern","knacken" }),
    "Das Feuer knistert und knackt vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Feuer.");

  AddSmell( ({ "feuer" }),
    "Das Feuer riecht rauchig.");
  AddSmell( ({ "rauch" }),
    "*hust* lange solltest Du Dich hier nicht aufhalten. Das kann nicht "
	"gesund sein.");


  AddCmd( ({ "steck", "stecke" }), "steckenCmd" );   

  AddExit( "suedosten", GIER_ROOM + "gierlinge_3c.lpc" );


}


int steckenCmd(string str )
{//hier soll ein Forscherpunkt hin
  notify_fail( "Was willst Du wo reinstecken??\n" );
  if( str == "hand in feuer"||str== "hand in ofen" )
  {
    write("Du verbrennst Dich.\n");
    say( TPN+" verbrennt sich am Ofen.\n",TP);
//AddHp(-20);
 TP->do_damage(10,"In ein heisses Feuer greifen");
    return 1;
  }
  return 0;
}
 



