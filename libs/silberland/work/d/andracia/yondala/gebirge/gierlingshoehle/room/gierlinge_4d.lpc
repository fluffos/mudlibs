// Yondala@Silberland
// Bild an der Wand hinzugefuegt (Gierling rutscht von Regenbogen)

#include "../def.h"
#include <moredef.h>
#include "../def.h"
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
   "Du befindest Dich in einer glitzernden Hoehle. Es ist hier recht hell, "
	"denn die Waende leuchten glitzernd von sich aus. Der Gang, in dem Du "
	"Dich befindest, macht hier eine Kurve und Du kannst nach Sueden und "
    "nach Nordosten gehen." );  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass es einen geben muss.");

  AddDetail( ({ "nordosten" }),
    "Nordoestlich von Dir gabelt sich der Gang.");
  AddDetail( ({ "sueden" }),
    "Direkt im Sueden von hier ist eine Kreuzung.");
  AddDetail( ({ "kreuzung" }),
    "Der Gang, in dem Du gerade stehst, kreuzt im Sueden einen anderen, das "
	"nennt man dann Kreuzung.");
  AddDetail( ({ "bild" }),
    "Das Bild, das aus unzaehligen einzelnen Edelsteinen zusammengesetzt "
	"wurde, zeigt einen Gierling, der von einem Regenbogen rutscht.");
  AddDetail( ({ "regenbogen" }),
    "Der Regenbogen ist ein perfekter Halbkreis. Er wurde aus Rubinen, "
	"Calcit, Citrin, Smaragd, Benitoit und Sugilith hergestellt.");
  AddDetail( ({ "halbkreis" }),
    "Er ist so perfekt, dass er in der Natur selten so schoen ist.");
  AddDetail( ({ "natur" }),
    "Nun, es handelt sich ja eh nur um ein Bild, ansonsten wuerdest Du ihn "
	"fuer magisch halten, so schoen ist er.");

  AddDetail( ({ "gierling","gierling in bild" }),
    "Der Gierling an der Wand wurde aus vielen kleinen Edelsteinen "
	"kunstvoll zusammen gesetzt. Er hat einen grossen, runden Kopf mit "
	"strubbeligen roten Haaren, auf denen eine gruene Melone sitzt. Der gruene "
	"Anzug sieht sogar als Bild edel aus und Du bist sicher, dass die "
	"kleinen, schwarzen Schuhe auch real funkeln wuerden.");
  AddDetail( ({ "kopf" }),
    "Der Kopf des Gierlings ist gross und rund, die Farbe ist eher rosa, "
	"vermutlich wurden dafuer Rosenquarze verwendet. Das Gesicht des "
	"Gierlings sieht sehr froehlich aus.");
  AddDetail( ({ "gesicht" }),
    "Genau genommen strahlt der Gierling ueber alle vier Backen, die "
	"grossen, gruenen Augen leuchten und der Mund ist zu einem breiten "
	"Grinsen geworden. Die Stirn verschwindet fast "
	"hinter den buschigen roten Augenbrauen.");
  AddDetail( ({ "augen" }),
    "Die Augen des Gierlings leuchten vor Freude. Vermutlich "
	"wurden sie aus Diamanten und die Iris aus Peridoten hergestellt. ");
  AddDetail( ({ "iris" }),
    "Die Iris des Gierlings strahlt so funkelnd, dass sie bestimmt aus "
	"Peridoten gesetzt wurde.");
  AddDetail( ({ "mund" }),
    "Der Mund des Gierlings ist aus einem satten Rot und grinst froehlich.");
  AddDetail( ({ "rot" }),
    "So ein sattes Rot hat wohl nur ein Jaspis, bestimmt wurde der Mund "
	"daraus gemacht.");
  AddDetail( ({ "haare" }),
    "Die feuerroten Haare des Gierlings wurden aus Rubinen gefertigt.");
  AddDetail( ({ "augenbrauen","brauen" }),
    "Die feuerroten Augenbrauen des Gierlings wurden aus Rubinen gefertigt.");

  AddDetail( ({ "melone" }),
    "Die Melone des Gierlings ist schoen rund und in einem dunklen Gruen "
	"gehalten.");
  AddDetail( ({ "gruen" }),
    "Du erkennst sofort, dass es viele kleine Aventurine sind, die hier "
	"den Anzug und die Melone darstellen. Du bist beeindruckt, "
	"von etwas weiter weg betrachtet erkennt man gar keine Uebergaenge "
	"zwischen den einzelnen Edelsteinen.");
  AddDetail( ({ "uebergaenge" }),
    "Die sieht man wirklich nur, wenn man ganz dicht ran geht. Da wusste "
	"jemand, was er tat, als er dieses Bild fertigte.");
  AddDetail( ({ "anzug" }),
    "Der Anzug ist in einem dunklen Gruen gehalten, der braune Guertel, der "
	"den Anzug ziert, hat eine goldene Schnalle.");
  AddDetail( ({ "schnalle" }),
    "Die Schnalle besteht aus echtem Gold. Gleich daneben haengt ein "
	"kleines Saeckchen.");
  AddDetail( ({ "stirn" }),
    "Die rosane Stirn des Gierlings verschwindet fast hinter den "
	"strubbeligen Haaren.");
  AddDetail( ({ "schuhe" }),
    "Die schwarzen Schuhe wirken so edel und rein, dass sie aussehen, als "
	"waeren sie frisch geputzt. Tatsaechlich bestehen sie aber aus reinem "
	"Opal.");
  AddDetail( ({ "saeckchen" }),
    "Das Saeckchen sieht aus, als sei es aus echtem Leder.");
  AddDetail( ({ "leder" }),
    "Als Du naeher hinsiehst erkennst Du, dass das Saeckchen aus Bronze "
	"besteht. Du bewunderst, wie naturgetreu es verarbeitet wurde.");
  AddDetail( ({ "lebensgroesse"}),
    "Der Gierling an der Wand ist wirklich genau so gross wie ein echter, "
	"lebendiger Gierling.");
  AddDetail( ({ "guertel" }),
    "Der Guertel ist aus vielen kleinen Zirkonen gefertig, die einander "
	"gleichmaessig ueberlappen, sodass ein Schuppenmuster entsteht.");
  AddDetail( ({ "schuppenmuster" }),
    "Die Zirkone sind in duennen Scheiben gearbeitet und so angeordnent, "
	"dass sie Schuppen sehr aehnlich sehen.");
  AddDetail( ({ "schuppen" }),
    "Du bist Dir trotzdem sicher, dass es Zirkone sind.");
  AddDetail( ({ "farbe","farben" }),
    "Das Bild an der Wand funkelt in vielen verschiedenen Farben.");
  AddDetail( ({ "scheiben" }),
    "Die Zirkone wurden zu duennen Scheiben verarbeitet und sich "
	"ueberlappend ergeben sie ein Schuppenmuster.");
  AddDetail( ({ "backen" }),
    "Nun, zumindest zwei davon siehst Du. Ansonsten ist es einfach nur eine "
	"Redewendung.");
  AddDetail( ({ "redewendung" }),
    "Das sagt man so.");
  AddDetail( ({ "grinsen" }),
    "Es scheint Spass zu machen, einen Regenbogen runter zu rutschen.");
  AddDetail( ({ "spass" }),
    "Insgeheim denkst Du, dass Dir das auch Spass machen wuerde.");
  AddDetail( ({ "freude" }),
    "Die Freude steht dem Gierling wahrlich ins Gesicht geschrieben, fast "
	"meinst Du ihn vor Freude juchzen zu hoeren.");
  AddDetail( ({ "kurve" }),
    "Der Weg ist hier nicht gerade, sondern macht eine Kurve von Sueden "
	"nach Nordosten.");
  AddDetail( ({ "weg" }),
    "Der Gang ist der Weg, denn Du kannst ihn nicht verlassen.");



  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen.");

  AddSound( ({ "rauschen" }),
    "Wenn Du bloss wuesstest, woher es kommt.");
  AddSound( ({ "juchzen","freude","gierling","gierling in bild" }),
    "Natuerlich kommt es Dir nur so vor, weil das Bild so gut ist.");
  AddSound( ({ "" }),
    ".");
  AddSound( ({ "" }),
    ".");

  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist absolut klar und trocken.");

  AddSmell( ({ "luft" }),
    "Normale Luft, Du kannst atmen.");


  AddExit( "sueden", GIER_ROOM + "gierlinge_5d.lpc" );
  AddExit( "nordosten", GIER_ROOM + "gierlinge_3e.lpc" );  

  

}

