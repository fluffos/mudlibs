#include <moredef.h>
#include "../def.h"
inherit "std/room";
#include <properties.h>
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Grotte" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer Grotte. Es ist hier recht hell, obwohl Du "
    "keine Lichtquelle entdecken kannst. Die Waende scheinen von sich aus "
	"zu leuchten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "grotte" }),
    "Du befindest Dich in einer Grotte.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende glitzern und verbreiten ein sanftes Licht.");

  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke sind aus Fels gehauen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und kalt.");
  AddDetail( ({ "lichtquelle", "licht" }),
    "Es ist absolut keine Lichtquelle zu sehen.");

  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

    
  AddReadDetail( ({ "" }),
    "");
      AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Viel kannst Du nicht hoeren, nur ab und zu ein Trippeln und Schaben.");

  AddSound( ({ "trippeln","schaben" }),
    "Du bist Dir nicht sicher, woher es kommt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig.");



}

