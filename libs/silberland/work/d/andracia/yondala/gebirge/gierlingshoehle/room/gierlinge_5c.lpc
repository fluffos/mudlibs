// Der Tante-Emma-Laden
inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>

object tanteemma;
create(){
::create();

SetProp(P_LIGHT, 1 );
SetProp(P_INDOORS, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN:TT_HOUSE]) );

SetProp( P_INT_SHORT, "In Tante Emmas Laden." );
SetProp( P_INT_LONG,
"Du befindest Dich in einem bis unter die Decke vollgestopften Kramladen. "
"Ueberall stapeln sich Dinge, die man vielleicht irgendwann eventuell mal "
"brauchen koennte. Einiges ist neu, das meiste davon sieht allerdings "
"gebraucht aus. Trotz der Unordnung ist es eigentlich recht gemuetlich. "
"Nach Osten verlaesst Du den Laden wieder, im Suedwesten liegt scheinbar "
"ein Lagerraum." );

SetStorageRoom(GIER_ROOM + "gierlinge_lager.lpc");

SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "emma");
  SetProp(P_SHOPKEEPER_NAME, "Emma");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
 
  AddDetail( ({ "hoehle", "laden", "kramladen" }),
    "Du befindest Dich in einem vollgestopften Kramladen.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende glitzern und verbreiten ein sanftes Licht. Allerdings sieht "
	"man davon wenig, denn rundherum stehen Regale, die nur durch die zwei "
	"Tueren und durch den kleinen Ladentisch unterbrochen werden.");
  AddDetail( ({ "plakat" }),
    "Es scheint sich um eine Karte zu handeln.");
  AddDetail( ({ "karte", "landkarte", "stadtplan" }),
" ________________________ \n"+
"|                        | \n"+
"| Stadtplan: Gierlingen  | \n"+
"|________________________| \n"+
"|                        | \n"+
"|     o   o - o - o - o  |\n"+
"|      \\  |       |   |  |\n"+
"|     o   o       o   o  |\n"+
"|      \\  |     /        |\n"+
"|     o - o   o - o - o  |\n"+
"|     |         /        |\n"+
"|     o       o          |\n"+
"|             |          |\n"+
"| o - o   x - o - o      |\n"+
"| | X | /     |          |\n"+
"| o - o   o - o          |\n"+
"|________________________| \n"); 


  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");
  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");

  AddDetail( ({ "regale" }),
    "Die Regale sind vollgestopft mit allem moeglichen Kram.");
  AddDetail( ({ "kram", "dinge", "dingen" }),
   "Du siehst verschiedene Dinge, darunter Ausruestungen, Waffen, und -ja- "
   "einfach Kram, der sich so ansammelt. Mit <zeige> bekommst Du eine "
   "genauere Uebersicht.");
  AddDetail( ({ "uebersicht","waffen","ausruestungen","ruestungen" }),
    "Mit <zeige> bekommst Du eine Uebersicht.");
  AddDetail( ({ "unordnung" }),
    "Es liegt viel herum, trotzdem ist es irgendwie gemuetlich hier.");
  AddDetail( ({ "ladentisch", "tisch" }),
    "Eigentlich steht hier nie jemand hinter, denn Emma wuselt staendig "
	"herum. Auf dem kleinen Tisch steht eine kleine mechanische Kasse. "
	"Ansonsten ist er leer und blitzsauber. Der Tisch ist fest mit dem "
	"Boden verbunden. Hinter dem Tisch haengt eine Karte.");
  AddDetail( ({ "kasse" }),
    "Die Kasse ist Emma heilig. Sie ist fest mit dem Tisch verbunden. Neben "
	"der Kasse entdeckst Du eine kleine Rufklingel.");
  AddDetail( ({ "emma" }),
    "Wenn Emma nicht da ist kommt sie bestimmt gleich wieder. Vielleicht ist sie im Lager.");
  AddDetail( ({ "osten" }),
    "Im Osten ist die Tuer, durch die Du gekommen bist.");
  AddDetail( ({ "eingangstuer"}),
    "Durch die Tuer im Osten bist Du herein gekommen und durch sie kannst "
	"Du den Laden auch wieder verlassen.");
  AddDetail( ({ "suedwesten" }),
    "Im Suedwesten scheint sich ein grosser Lagerraum zu befinden.");
  AddDetail( ({ "lager","lagerraum" }),
    "Der Lagerraum liegt suedwestlich von Dir. Du kannst ihn bestimmt "
	"betreten, solltest aber moeglichst nichts anfassen.");
  AddDetail( ({ "tuer", "tueren" }),
    "Welche Tuer meinst Du? Es gibt eine Eingangstuer und eine Lagertuer.");
  AddDetail( ({ "lagertuer" }),
    "Durch die Lagertuer kommt man - wer haette es gedacht - ins Lager.");
  AddDetail( ({ "rufklingel" }),
    "Auf dem Ladentisch steht eine kleine, goldene Rufklingel. Was wohl "
	"passiert, wenn Du da drauf haust?.");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");


AddItem(GIER_NPC + "gierling_emma.lpc",REFRESH_DESTRUCT);
tanteemma=present("emma",TO);

AddExit( "suedwesten", GIER_ROOM + "gierlinge_6b.lpc" );
AddExit( "osten", GIER_ROOM + "gierlinge_5d.lpc" );
AddCmd(({"haue","hau"}),"hauen");
}


int hauen(string str)
{
  if(str!="auf klingel"&&str!="auf rufklingel") return 0;
  write("Du haust mit voller Wucht auf die kleine Rufklingel.\n");
  say(TPN+" haut mit voller Wucht auf die kleine Rufklingel.\n");
  
  call_other(GIER_ROOM+"gierlinge_5a","???");
  call_other(GIER_ROOM+"gierlinge_5b","???");
  call_other(GIER_ROOM+"gierlinge_6a","???");
  call_other(GIER_ROOM+"gierlinge_6b","???");
  tell_room(to_object(GIER_ROOM+"gierlinge_5a"),"Du hoerst ein leises klingeln.\n");
  tell_room(to_object(GIER_ROOM+"gierlinge_5b"),"Du hoerst ein leises klingeln.\n");
  tell_room(to_object(GIER_ROOM+"gierlinge_6a"),"Du hoerst ein leises klingeln.\n");
  tell_room(to_object(GIER_ROOM+"gierlinge_6b"),"Du hoerst ein leises klingeln.\n");
 if(!tanteemma)return 1;
 
  if(tanteemma->find_call_out("jemandklingelt")<0)
    tanteemma->remove_call_out("jemandklingelt");
  if(tanteemma->find_call_out("binhier")<0)
    tanteemma->remove_call_out("binhier");
  if(tanteemma->find_call_out("inladen2")<0) return 1;
  if(tanteemma->find_call_out("inladen")<0)
    tanteemma->remove_call_out("inladen");
  
  call_other(tanteemma, "jemandklingelt",TP);
  return 1;
}  






void inladen2()
{
  move(GIER_ROOM+"gierlinge_5c",M_GO,"schlurft in den Laden.", "schlurft herein");
}
void inladen()
{
  tell_room(to_object(GIER_ROOM+"gierlinge_5c"),"Emma ruft: Ich komme gleich!\n");
  call_out("inladen2",2+random(5));
}

void jemandklingelt(object spieler)
{
   if(file_name(environment(TO)) == GIER_ROOM+"gierlinge_5c") //sie ist im Raum mit der Klingel
   call_out("binhier",1, spieler);
   else call_out("inladen",2);

}