#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Knueppel");
  SetProp(P_LONG,
    "Ein Knueppel aus Holz." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Knueppel");
  SetProp(P_GENDER, MALE);
  AddId( ({"knueppel", "holzknueppel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON); 
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_BEECH );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 126);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

}
