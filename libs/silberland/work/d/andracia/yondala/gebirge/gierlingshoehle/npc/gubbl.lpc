// Ein Gubbl

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <npc.h>
#include "../def.h"
inherit "std/mnpc";

object ob;		
	
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gubbl");
  SetProp(P_LONG,
    "Das ist ein Gubbl. Du hast vermutlich noch nie vorher einen gesehen. Und "
    "vermutlich willst du auch nie wieder einen sehen, so toll sind die naemlich "
    "nicht. Mach ihn einfach platt, wenn du kannst...");
  SetProp(P_NAME, "Gubbl");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);


  AddId(({"gubbl"}));



   create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinen Pfoten",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 13000);
  SetProp(P_ALIGN, -50);



  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Gubbl");




  SetProp( P_REJECT, ({ REJECT_DROP,
   "Der Gubbl will Deine Sachen nicht tragen.\n" }) );

  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 1 + random(4));
  ob->move(TO, M_SILENT);




}

