void schoepfen()
{
   tell_room(environment(TO),"Der alte Gierling nimmt die Kelle und "+
                             "schoepft etwas Wasser auf die heissen\n"+
	                         "Steine.\n");
}
							 

void zaehler3()
{
  tell_room(environment(TO),"Der alte Gierling zaehlt: Drei!\n");
  call_out("schoepfen",1);
  }

void zaehler2()
{
  tell_room(environment(TO),"Der alte Gierling zaehlt: Zwei.\n");
  call_out("zaehler3",2);
  }
  
  
void zaehler()
{
  tell_room(environment(TO),"Der alte Gierling zaehlt: Eins.\n");
  call_out("zaehler2",2);
  }

//wie reagiert der Gierling?
void reaktion(int i)
{
  string *reaktionen;
  reaktionen=({
"stoesst den schrumpeligen Gierling an.\nDer alte Gierling "+ //0
"fragt: Sag mal spinnst Du?",                                   
"sagt: Jaja, schon in Ordnung.",                              //1
"fragt: Ich soll mich nicht anstellen?\nDer alte Gierling "+  //2
"sagt: Weil Du aus Geiz nur Zwiebeln frisst, muss ich hier\n"+
"Der alte Gierling sagt: dauernd im Gestank sitzen.",
"seufzt: Ja, ja, wem sagst Du das?",                        //3
"nickt: Woll, woll.",                                       //4
"sagt: Du kannst gerne einen weiteren Aufguss machen.",	  //5	 
"sagt: Weil Du dran bist!?",                                  //6
"sagt: Und ich die beiden Male davor!",                       //7
"seufzt.",                                                    //8
"nickt: Einverstanden. Auf drei!",				
"verschraenkt die Arme und schmollt.",//9				
"nickt: Hoert, hoert.",				
"stimmt zu: Ohja, diese Jugend!",				
"schuettelt den Kopf: Gar nichts mehr los.",				
"schuettelt sich.\nDer alte Gierling sagt: Du bist ein Ferkel.",				
"erinnert sich: Ja, Frueher! Da war alles besser!",				
"sagt: Die Frauen, ja. Die waren auch besser.",				
"bestaetigt: Ohja, zu Fuessen.",				
"nickt: Heute ist alles anders.",				
"sagt: Da reicht nicht mehr der Herd und viele Kinder.",				
"sagt: So ist das heute.",				
"echot: Ja, eine Schande.",				
"",				
"",				
"",				
"",				
"",				
""				
					   });
                       
// command("sag "+reaktionen[i]);
 tell_room(environment(TO),"Der alte Gierling "+reaktionen[i]+"\n");
}

//Worauf reagiert der Gierling?
void catch_tell(string str)
{
  int i;
  string was, dummy;
  string *reaktion_auf;
  reaktion_auf=({
"Dem schrumpeligen Gierling entweicht%s.%s",//0
"Ein schrumpeliger Gierling sagt: Tut mir leid, der musste raus%s.%s",//1
"Ein schrumpeliger Gierling sagt: Ach, stell Dich nicht so an%s.%s",//2
"Ein schrumpeliger Gierling sagt: Es sind halt schlechte Zeiten%s.%s",//3
"Ein schrumpeliger Gierling sagt: Ach, ist das herrlich heute%s.%s", //4
"Der schrumpelige Gierling sagt: Ganz schoen trockene Luft%s.%s",//5
"Der schrumpelige Gierling schaut entruestet%s.%s",//6
"Der schrumpelige Gierling wehrt ab: Nein, nein, nein%s!%s",//7
"Der schrumpelige Gierling rollt mit den Augen%s.%s",//8
"%sDer schrumpelige Gierling sagt: gemeinsam.%s",//9
"Der schrumpelige Gierling grinst%s.%s",//10
"Der schrumpelige Gierling sagt: Hachja, frueher war alles besser%s.%s",//11
"Der schrumpelige Gierling meckert: Und diese Jugend%s!%s",//12
"Der schrumpelige Gierling sinniert: Mit der ist auch nichts mehr los%s.%s",//13
"Der schrumpelige Gierling schneuzt sich in sein Handtuch%s.%s",
"Der schrumpelige Gierling fragt: Weisst Du noch frueher%s?%s",
"Der schrumpelige Gierling sagt: Ja. Auch die Frauen%s.%s",
"%sDer schrumpelige Gierling lacht: Sie haben uns zu Fuessen gelegen.%s",
"%sDer schrumpelige Gierling seufzt: Aber heute.%s",				
"Der schrumpelige Gierling sagt: Ja. Heute wollen die Frauen mitreden%s.%s",				
"%sDer schrumpelige Gierling sagt: sie erleben%s",				
"Der schrumpelige Gierling meint: Eine Schande%s.%s",				
"",				
"",				
"",				
""			
 });

 if(sscanf(str,reaktion_auf[9],was,dummy)==2)
 {
	 call_out("reaktion",2,9);
	 call_out("zaehler",4);
	  return;
	  }   
 
 for(i=sizeof(reaktion_auf);i--;i>=0)
  { 
  if(sscanf(str,reaktion_auf[i],was,dummy)==2) 
     {
	 call_out("reaktion",3,i);
	  return;
	  }
   }
     
  /*
  if(sscanf(str,reaktion_auf[0],was,dummy)==2) call_out("stinker_mecker",2); 		 
  else if(sscanf(str,reaktion_auf[1],was,dummy)==2) call_out("stinker_ok",2); 		 
  else if(sscanf(str,reaktion_auf[2],was,dummy)==2) call_out("stinker_nichtok",2); 		 
  else if(sscanf(str,reaktion_auf[3],was,dummy)==2) call_out("stinker_mecker",2); 	 
				 
  //command("sag "+str);
 /* if(sscanf(str,"Dem schrumpeligen Gierling entweicht%s.%s",was, dummy)==2)
    call_out("stinker_mecker",2); 
  else if(sscanf(str,"Ein schrumpeliger Gierling sagt: Tut mir leid, der musste raus%s.%s",was, dummy)==2)
    call_out("stinker_ok",2); 
  else if(sscanf(str,"Ein schrumpeliger Gierling sagt: Ach, stell Dich nicht so an%s.%s",was, dummy)==2)
    call_out("stinker_nichtok",2); */
	}


void einangezogener2(object spieler)
{
  object *getragenes;
  int i;
  string sagen;
  if(!present(spieler, environment(TO))) return;
  
  if(!getragenes=TP->QueryArmours(({AT_BOOT,AT_HELMET,AT_SHIELD,AT_AMULET,AT_GLOVE,AT_BRACERS}))) return;
  
  tell_room(environment(TO), "Der alte Gierling kichert auch.\n");
  sagen="Ja und ";
 for(i=sizeof(getragenes);i--;i>=0)
	{
	    sagen=sagen+ getragenes[i]->name(WER);
	    if(i>=2)sagen=sagen+ ", ";
		else if (i==1)sagen=sagen+" und ";
	}
	sagen=sagen+" sind hier auch fehl am Platz.\n";
	tell_room(environment(TO),break_string(sagen, 80, "Der alte Gierling sagt: ")); 
	
/*	if(present("\nschrumpeligergierling",environment(TO))) 
      present("\nschrumpeligergierling",environment(TO))->einangezogener(TP);*/
   }
           /*               
                     
        AT_RING  //schrumpel sagen                    
                     
                     AT_MISC      */
void einangezogener(object spieler)
{
  call_out("einangezogener2",3,spieler);
  }