//Dieser Gierling sitzt in der Sauna, unterhält sich mit dem schrumpeligen Gierling

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
//#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <npc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";
int groesse;
string groessetext;

 
void create() {
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(5); 
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_ARTICLE, 1);
  SetProp(P_SHORT, "Ein alter Gierling");
  SetProp(P_LONG,"Ein furchtbar alter Gierling sitzt hier herum. Er ist "
  "voller Runzeln und hat kaum noch Haare auf dem Kopf. Um die Hueften hat "
  "er ein Handtuch gewickelt, ansonsten ist er nackt. Der alte Gierling "
  "sieht entspannt und sehr zufrieden aus.");
  SetProp(P_NAME, "Gierling");
  SetProp(P_GENDER, MALE);
  AddDetail( ({ "", "" }),
    ""); 
  AddId(({"gierling", "mann","\naltergierling"}));
  SetProp(P_KILL_NAME, "Ein alter Gierling");
  SetProp(P_NOATTACK,"ist so feucht, dass er unter Dir wegflutscht.");

  
  SUID;
  CLONEME(GIER_ARMOUR + "handtuch.lpc");
  command("trage alles");


  SetProp(P_HANDS, ({" mit seinen alten Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));



  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat

}
