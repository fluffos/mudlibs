inherit "/std/container";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Sack");
  SetProp(P_LONG,
     "Ein Sack aus Stoff, in dem Du Sachen aufbewahren kannst."
     );
  AddId(({"sack", "\sack"}));
  SetProp(P_NAME, "Sack");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAX_WEIGHT, 15000);
  SetProp (P_MATERIAL, ([MAT_CLOTH:100]) );
}