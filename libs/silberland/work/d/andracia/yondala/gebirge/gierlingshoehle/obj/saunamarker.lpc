//Zaehlt, wie lange sich jemand in der Sauna aufhaelt

//14.12.2011 - Yondala@Silberland
#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>

int zaehler;

// bei 70: Deine Haut wird schon ganz schrumeplig
// bei 80: kein hochidlen mehr
// ab 85:  Hinweis, dass es langsam reicht
// ab 90:  runter idlen
// ab 100: Flucht
// bei 105: Warnung
// bei 109: Letzte Warnung
// bei 110: Tod (muss man sehr penetrant daemlich fuer sein)

void aufenthalt()
{
  string *erholungstext;
  //write("Zaehler: "+zaehler +"\n");
  erholungstext=({"Du fuehlst Dich einfach wohl.\n",
				  "Die Waerme tut Dir gut.\n",
				  "Du bist tief entspannt.\n",
				  "Du atmest tief ein und aus.\n",
				  "","","","","","",""});//es soll nicht immer eine 
												 //Ausgabe geben  
  if(file_name(environment(environment(TO))) != 
  "/d/andracia/yondala/gierlingshoehle/room/gierlinge_2f")
  zaehler--;   // Wenn es ein anderer Raum ist
  

  
  else//Spieler ist in Dampfhoehle
  {
  if (zaehler==70) write("Deine Haut wird schon ganz schrumpelig.\n");
  if (zaehler==85) write("Langsam fuehlst Du Dich unwohl in dem Dampf.\n");
  if (zaehler==105) write("Du wirst Sterben, wenn Du nicht damit aufhoerst.\n");
  if (zaehler==110) write("Letzte Warnung: Mach eine Pause.\n");
  if (zaehler>=100) 
  {
    write("Du musst dringend mal an die frische Luft!\n");
    TP->move( "/d/andracia/yondala/gierlingshoehle/room/gierlinge_1f", M_GO, 0,
                  "fluechtet aus der Dampfhoehle",
				  "kommt rotgesichtig aus der Dampfhoehle");
	}    


    if(zaehler>110) 
	  { write("Das war zuviel fuer Dich, Du brichst tot zusammen.\n");
		 TP->SetProp(P_KILLER, TO);
		 TP->die(3);
      }		 
	else if(zaehler>100) TP->AddHp(-5);
	else if(zaehler>95) TP->AddHp(-2);
	else if(zaehler>90) TP->AddHp(-1);
    else if(zaehler<80) 
	{
	  TP->AddHp(2);
	  write(erholungstext[random(sizeof(erholungstext))]);
	  }
    zaehler++;
	}
	

  

  if (zaehler>0) 
  call_out("aufenthalt",2);
  else
  {
    write ("Deine Haut entschrumpelt sich wieder.\n");
	remove();
	}
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  zaehler=2;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
  SetProp(P_INFO, 0);
  SetProp(P_NAME, 0);
  SetProp(P_KILL_NAME, "Hitze und penetrante Dummheit");
  SetProp(P_GENDER, 0);
  AddId(({"saunamarker"}));

  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  call_out("aufenthalt",2);
//  AddCmd(({"stecke","steck"}),"cmdStecken"); //Funktion
}

NotifyPlayerDeath()
{remove();}

BecomesNetDead()
{remove();}
