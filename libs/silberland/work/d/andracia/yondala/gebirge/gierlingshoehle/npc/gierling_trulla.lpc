// Normalo Trulla 

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"
inherit GIER_NPC + "gierling_standard.lpc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Trulla die Gierlingsfrau");
  SetProp(P_LONG,
    "Das ist Trulla, sie ist eine Gierlingsfrau. Sie hat lange rote Haare, die ihr wirr vom Kopf "
    "abstehen. Um ihre Nase tummeln sich unzaehlige Sommersprossen. Sie traegt ein franseliges, "
    "gruenes Kleid und braune Lederschuhe. In ihren Haenden haelt sie einen Weidenkorb mit Fruechten. "
    "Sie ist normal gross fuer einen Gierling. An ihrem Guertel haengt ein Goldsaeckchen.\n");
  SetProp(P_NAME, "Trulla");//nur der Name 1. Buchstabe groß
  SetProp(P_GENDER, FEMALE);//Geschlecht
  SetProp(P_ARTICLE, 0);
  AddId(({"trulla", "winzling", "die kleine", "gierlingfrau"}));
  SUID;
  CLONEME(GIER_ARMOUR + "kobold_kleid.lpc");
  CLONEME(GIER_ARMOUR + "gierling_lederschuhe.lpc");
  command("trage alles");
  SetProp(P_SIZE, 65);
  SetProp(P_WEIGHT, 13500);


SetProp (P_MNPC_DEFAULTROOM, "/d/gierlinge/");
SetProp (P_MNPC_AREA, "/d/" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_MURDER_MSG, "Irgendwie mag ich " +TPN+ " nicht...");// die meldung auf -mörder
  SetProp(P_KILL_NAME, "Trulla die gierlingin");//name des tötenden npc
  SetProp(P_KILL_MSG, "Mein Gold gehoert mir!");//die meldung wenn der GIER_NPC einen Spieler umgebracht hat
    AddInfo( ({ "trulla" }),
    "Das bin ich.",
    "sagt: ");        

}


