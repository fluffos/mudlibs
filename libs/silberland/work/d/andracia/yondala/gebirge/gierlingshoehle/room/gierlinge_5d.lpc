#include <moredef.h>

#include "../def.h"
inherit GIER_ROOM + "gierlinge_std.lpc";
#include <properties.h>
object *verbannte;
void bann(object spieler)
{
  verbannte+=({spieler});
  }

void reset()
{
::reset();
verbannte=({});
}
void create() 
{
  ::create();
  verbannte=({});
  SetProp( P_INT_SHORT, "In einer glitzernden Hoehle" );
   SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Kreuzung in einer glitzernden Hoehle. "
	"Es ist hier recht hell, denn die Waende leuchten glitzernd von sich "
	"aus. Zwei Gaenge kreuzen sich hier, sodass Du nach Norden, Sueden, "
	"Osten und Westen gehen kannst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich in einer glitzernden Hoehle, genauer gesagt in einem "
	"Gang unter der Erde.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus einem leuchtenden Material, welches Du nie "
	"zuvor gesehen hast.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus dem selben leuchtenden Material wie die "
	"Waende, allerdings ist es dort etwas dunkler.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus dem selben leuchtenden Material wie die "
	"Waende, allerdings sieht man davon nicht viel, er ist mit einem "
	"kunstvollem Mosaik belegt.");

	AddDetail( ({ "material" }),
    "Das Material sieht aus wie Stein, der leuchtet.");
  AddDetail( ({ "stein" }),
    "Du hast noch nie zuvor leuchtenden Stein gesehen.");
  AddDetail( ({ "leuchten" }),
    "Die Waende, der Boden und die Decke leuchten und tauchen die Hoehle "
	"in sanftes Licht.");


  AddDetail( ({ "licht", "lichtquelle" }),
    "Alles, was diese Hoehle erleuchtet sind die Waende, die von sich aus "
	"leuchten, ohne dass Du eine Ursache erkennen kannst.");
  AddDetail( ({ "ursache" }),
    "Die Waende leuchten und Du weisst nicht warum, damit musst Du Dich "
	"vorerst abfinden.");
  AddDetail( ({ "tageslicht" }),
    "Kein Tageslicht dringt bis hierher.");
  AddDetail( ({ "osten" }),
    "Du kannst nicht wirklich sehen, was im Osten ist. Du vermutest aber, "
	"dass Du dort tiefer in die Hoehle gelangst.");
  AddDetail( ({ "ausgang" }),
    "Du kannst ihn nicht mehr sehen, aber da Du dort her kamst, bist Du "
	"sicher, dass er sich suedlich von Dir befindet.");
  AddDetail( ({ "mosaik" }),
    "Das Mosaik besteht aus tausenden vom Edelsteinen.");
  AddDetail( ({ "edelsteine" }),
    "Die Edelsteine hier haben unterschiedliche Farben. Sie sind so "
	"gesetzt, dass sie ein Bild und vier Pfeile ergeben.");
  AddDetail( ({ "pfeile" }),
    "Jeder Pfeil zeigt in eine Richtung, in die Du auch gehen kannst.");
  AddDetail( ({ "richtung" }),
    "Du kannst nach Norden, Sueden, Osten und Westen gehen.");
  AddDetail( ({ "pfeil" }),
    "Welchen Pfeil meinst Du? Den Nordpfeil, den Ostpfeil, den Suedpfeil "
	"oder den Westpfeil?");
  AddDetail( ({ "nordpfeil" }),
    "Der Nordpfeil zeigt nach Norden. Neben dem Pfeil steht das Wort "
	"\"Dampfhoehle\".");
  AddDetail( ({ "dampfhoehle" }),
    "Laut dem Nordpfeil scheint sie sich noerdlich von Dir zu befinden. "
	"Allerdings nicht direkt, sonst koenntest Du sie ja sehen.");
  AddDetail( ({ "ostpfeil" }),
    "Der Ostpfeil zeigt nach Osten. Neben dem Pfeil steht das Wort "
	"\"Betorium\".");
  AddDetail( ({ "betorium" }),
    "Wenn Du wissen moechtest, was ein Betorium ist, solltest Du nach "
	"Osten gehen.");
  AddDetail( ({ "bild" }),
    "Auf dem Bild ist ein Kind abgebildet, das gegen merkwuerdige Monster "
	"kaempft.");
  AddDetail( ({ "kind" }),
    "Das Kind ist noch so klein, dass man nicht mal seine Rasse erkennen "
	"kann.");
  AddDetail( ({ "rasse" }),
    "Das Kind koennte jeder Rasse angehoeren.");
  AddDetail( ({ "monster" }),
    "Neben dem Loch ist ein merkwuerdig deformiertes Monster zu sehen. "
	"Es sieht irgendwie ekelig, aber nicht sonderlich gefaehrlich aus.");
  AddDetail( ({ "loch" }),
    "Du denkst . o O (Loch? Was fuer ein Loch? Das ist mir vorher gar nicht "
	"aufgefallen)\nDu denkst . o O (Ob man hier einfach nach unten gehen "
	"kann?)");

  AddDetail( ({ "suedpfeil" }),
    "Der Suedpfeil zeigt nach Sueden. Neben dem Pfeil steht das Wort "
	"\"Ausgang\".");
  AddDetail( ({ "westpfeil" }),
    "Der Westpfeil zeigt nach Westen. Neben dem Pfeil stehen die Worte "
	"\"Tante Emma\".");
  AddDetail( ({ "tante","emma","tante emma" }),
    "Wer auch immer das ist, er oder vermutlich eher sie, befindet sich "
	"so haeufig westlich von hier, dass es sich lohnt einen eigenen Pfeil "
	"dafuer auf dem Boden zu drappieren.");

	AddDetail( ({ "osten" }),
    "Im Osten scheint eine besondere Hoehle zu sein, Du spuerst Magie mit "
	"jeder Zelle Deines Koerpers, ausserdem ist der Eingang der Hoehle "
	"reich verziert.");
  AddDetail( ({ "magie" }),
    "Die Magie, die die Hoehle oestlich von Dir verstroemt laesst Dich "
	"erzittern.");
  AddDetail( ({ "zelle" }),
    "Von der Kopfhaut bist zu den Zehen spuerst Du die Magie.");
  AddDetail( ({ "kopfhaut" }),
    "Deine Kopfhaut kribbelt.");
  AddDetail( ({ "zehen" }),
    "Deine Zehen jucken.");
  AddDetail( ({ "koerper" }),
    "Ueberall an Deinem Koerper spuerst Du die Magie.");
  AddDetail( ({ "sueden" }),
    "Nach Sueden geht der Gang einfach weiter.");
  AddDetail( ({ "westen" }),
    "Im Westen tut sich eine etwas groessere Hoehle auf, allerdings haengt "
	"dort ein kleiner Vorhang, Du kannst nicht sehen, was dahinter ist.");
  AddDetail( ({ "vorhang" }),
    "Der Vorhang besteht aus vielen kleinen Kuegelchen, die an silbernen "
	"Faeden aufgereiht sind. Ueber dem Vorhang entdeckst Du ein kleines "
	"Schild.");
  AddDetail( ({ "kuegelchen" }),
    "Die Kuegelchen glitzern schoen.");
  AddDetail( ({ "faeden" }),
    "Die Faeden sehen so aus, als bestuenden sie aus purem Silber.");
  AddDetail( ({ "schild" }),
    "Du kannst es lesen.");
  AddReadDetail( ({ "schild" }),
    "Emmas Gemischtwaren");
  AddDetail( ({ "gemischtwaren" }),
    "Du folgerst aus dem Schild, dass hinter dem Vorhang ein Laden ist.");
  AddDetail( ({ "laden" }),
    "Sehr wahrscheinlich ist im Westen von Dir ein Laden. Geh einfach hin, "
	"der Vorhang wird Dich nicht aufhalten.");
  AddDetail( ({ "eingang" }),
    "Rund um den Eingang wurden viele Bilder und Zeichen mittels Edelsteinen "
	"in den Stein gesteckt.");
  AddDetail( ({ "bilder" }),
    "Die Bilder stellen hauptsaechlich kleine Wesen dar, die kaempfen oder auf Goldbergen sitzen.");
  AddDetail( ({ "goldberge","goldbergen" }),
    "Die Bewohner dieser Hoehle scheinen Gold zu moegen.");
  AddDetail( ({ "bewohner", "wesen" }),
    "Es scheint sich dabei um Gierlinge zu handeln.");
  AddDetail( ({ "gierling","gierlinge" }),
    "Du wirst hier unten bestimmt mal dem ein oder anderen begegnen.");  
	
  AddDetail( ({ "zeichen" }),
    "Es handelt sich dabei um sonderbare Runen, die Dir nicht gelaeufig sind");

  AddDetail( ({ "gang", "gaenge" }),
    "Der Gang auf dem Du bisher liefst, kreuzt hier einen anderen Gang, "
	"sodass Du von hier aus in vier Richtungen weiterlaufen kannst.");
  AddDetail( ({ "kreuzung" }),
    "Zwei Gaenge kreuzen sich hier, das nennt man dann eine Kreuzung.");
  AddDetail( ({ "runen" }),
    "Du kannst nicht sagen, was sie bedeuten. Entweder sind sie schon so "
	"alt, dass sie in Vergessenheit gerieten, oder nur ein wahrer Gierling "
	"kann sie lesen.");
  AddDetail( ({ "gierling" }),
    "Du bist kein wahrer Gierling.");
  AddDetail( ({ "vergessenheit" }),
    "Wenn niemand mehr weiss, was sie bedeuten wird es sehr schwer, es "
	"herauszufinden.");
  AddDetail( ({ "wort","worte" }),
    "Hier stehen verschiedene Worte.");
	









  AddDetail( ({ "norden" }),
    "Nach Norden geht es tiefer in die Hoehle. Was hinter der naechsten Kurve ist kannst "
    "Du nicht erkennen.");
  AddDetail( ({ "kurve" }),
    "Die Kurve beginnt im Norden. Leider siehst Du nicht, was dann kommt.");
    
    

  AddExit( "norden", GIER_ROOM + "gierlinge_4d.lpc" );
  AddExit( "osten", GIER_ROOM + "gierlinge_5e.lpc");
  //AddExit( "westen", GIER_ROOM + "gierlinge_5c.lpc" );
  AddSpecialExit("westen","westengeher");
  AddExit( "sueden", GIER_ROOM + "gierlinge_6d.lpc" );

  AddExit( "unten", GIER_ROOM + "gierlinge_u_8c.lpc" );
  SetProp(P_HIDE_EXITS, ({"unten"}) );  

}

westengeher(string Dir)
     {
       if (!member(verbannte, TP)){
        notify_fail("Du bist verbannt worden und kannst den Laden nicht mehr betreten!\n");
         return 0;
       }
       return this_player()->move(GIER_ROOM + "gierlinge_5c", M_GO, 0,
                    "nach Westen");
     }
	 
	 
	   