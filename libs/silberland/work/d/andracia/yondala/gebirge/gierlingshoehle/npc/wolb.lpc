// Ein Wolb

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>
#include "../def.h"

inherit "std/mnpc";
object ob;	
	
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wolb");
  SetProp(P_LONG,
    "Das ist ein Wolb. Er ist klein, gruen und hat schiefe Zaehne.");
  SetProp(P_NAME, "Wolb");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOCORPSE,0);

  AddId(({"wolb"}));



   create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Pfoten",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 2);
  SetProp(P_WEIGHT, 13000);
  SetProp(P_ALIGN, -50);



  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein Wolb");




  SetProp( P_REJECT, ({ REJECT_DROP,
   "Der Wolb will Deine Sachen nicht tragen.\n" }) );

//TO->AddMoney(1);
//clone money;
//  SUID;
//  CLONEME("/d/obj/money.lpc");

  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 1 + random(7));
  ob->move(TO, M_SILENT);
}

