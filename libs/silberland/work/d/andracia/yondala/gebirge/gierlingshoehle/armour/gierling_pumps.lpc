#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Pumps");
  SetProp(P_LONG,
    "Ein kleines Paar schwarzer Pumps, welches wohl nur Kobolden passen kann." );

  SetProp(P_NAME, "Pumps");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"pumps", "stoeckelschuhe"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_LEATHER ]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp (P_WEAR_RESTRICTIONS,([P_GENDER:2, P_RACE:"Kobold"]) );
 
}
