#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Scrollans Locke");
  SetProp(P_LONG,
    "Du siehst eine roetliche Locke, die goldig schimmert, wenn das Licht darauf faellt." );
  SetProp(P_INFO, "Dies ist eine ganz besondere Locke, sie stammt von einem Kobold, der sie "
                  "freiwillig hergab. Huete Sie gut, denn man sagt, sie hilft ihrem Besitzer, "
                  "wenn dieser in hoechster Not an ihr reibt.");
  SetProp(P_NAME, "Locke");
  SetProp(P_GENDER, 0);
  AddId(({"locke","scrollans locke","scrollans"}));
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_MATERIAL, MAT_HAIR );
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
//  SetProp(P_NOSELL, 1);

  AddCmd(({"reibe","reib"}),"reiben"); //Funktion
}

int reiben(string str)
{ 
	if (str == "locke" || str== "an locke" || str =="scrollans locke" || str == "an scrollans locke")
		{ 
			if(TP->InFight())
				{
					write("Die Locke reagiert nicht. Vielleicht solltest Du erst den Kampf beenden?\n");
					say(TPN+" reibt vergeblich an einer Locke.\n");
				}
			else
				{
					write("Du reibst an der Locke, ploetzlich loest sich die Welt um Dich auf.\n");
					say(TPN+" reibt an einer Locke und verschwindet ploetzlich.\n",TP);
					TP->move( GIER_ROOM+"gierlinge_5e.lpc", M_NOCHECK);
					TP->SetProp(P_HP,TP->QueryProp(P_MAX_HP));
					write("Die Locke zerfaellt.\n");
					remove();
		    }
			return 1;
     
     }
 return 0;
}