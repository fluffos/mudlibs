#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Gebirgsweg durch einen Birkenwald" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich auf einem einfachen Weg mitten durch einen Birkenwald. Die weissen "+
     "Staemme stehen weit auseinander und man kann den weiteren Verlauf des Wegs gut erkennen. "+
     "Von Nordosten bis Westen erstreckt sich ein imposantes Panorama von hohen Bergketten. "+
     "Der Birkenwald scheint sich fast endlos nach Sueden und Osten zu erstrecken. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Ein leichter Wind laesst die Blaetter der Baeume rascheln, aber neben diesen sanften "+
    "Geraeuschen kann man auch hin und wieder einen Specht klopfen hoeren. Auch ein paar Voegel "+
    "zwitschern ab und zu."));
  AddSound( ({ "rascheln" }),
    BS("Der leichte Wind bringt die Blaetter der Birken zum rascheln. "));
  AddSound( ({ "zwitschern" }),
    BS("Ein paar Voegel zwitschern in den Baumkronen. Entdecken kannst u aber gerade keinen."));
  AddSound( ({ "klopfen" }),
    BS("Sogar ein Specht klopft hier irgendwo gegen die Staemme der Birken."));
  AddSmell( DEFAULT_SMELL,
    BS("Der herbe Duft der Birken mischt sich hier mit den angenehmen Geruechen einer Wiese. "));
  AddSmell( ({ "duft", "geruch" }),
    BS("Es herrscht hier ein ganz besonderer Duft. Die Birken und das saftige Gras erzeugen eine "+
    "ungewoehnliche Mischung."));
  AddSmell( ({ "birken" }),
    BS("Vorallem derr herbe Duft der Birken haengt hier in der Luft. "));
  AddSmell( ({ "wiese" }),
    BS("Die Graeser und Blumen, die hier zwischen den Baeumen wachsen haben einen angenehmen Duft. "));

  AddDetail( ({ "boden", "weg", "spur", "verlauf" }),
    BS("Der Weg besteht aus einer niedergetrampelten Spur im spaerlichen Grasbewuchs zwischen "+
    "den licht stehenden Birken. Ein paar Felsen saeumen den Weg."));
  AddDetail( ({ "himmel", "wetter" }),
    BS("Der tiefblaue Himmel laesst vermuten dass das Wetter hier noch eine gute Weile "+
    "angenehm sonnig bleibt."));
  AddDetail( ({ "wind", "brise" }),
    BS("Eine leichte Brise streicht ueber den Wald hinweg. Die Blaetter bewegen sich und "+
    "erzeugen unstete aber trotzdem angenehme Lichtverhaeltnisse. "));
  AddDetail( ({ "blaetter" }),
    BS("Die Blaetter der Birken schaukeln im Wind und erzeugen neben dem Rascheln auch ein unstetes Licht. "));
  AddDetail( ({ "baeume", "birken", "wald", "birkenwald", "art", "waelder" }),
    BS("Die Baeume hier sind alles Birken. Ihre typisch weissen Staemme machen es einfach "+
    "diese Art Baeume zu erkennen."));
  AddDetail( ({ "geraeusche", "zwitschern", "klopfen" }),
    BS("Fuer diese Dinge kann man besser die Ohren verwenden. "));
  AddDetail( ({ "specht", "voegel", "vogel" }),
    BS("Du kannst in den hohen Baumkronen zwar keinen Vogel sehen, aber ihr zwitschern kann man weithin +"
    "hoeren. Auch das Klopfen eines Spechts kann man vernehmen. "));
  AddDetail( ({ "duft", "geruch", "geruechen" }),
    BS("Dazu empfiehlt es sich die Nase zu benutzen."));
  AddDetail( ({ "wiese" }),
    BS("Das Gras, das hier waechst, erhaelt durch die weit auseinanderstehenden Birken genug Licht "+
    "und einige Blumen strecken vereinzelt ihre Blueten zur Sonne. "));
  AddDetail( ({ "gras", "bewuchs", "grasbewuchs", "graeser" }),
    BS("Das einfache Gras, das hier zwischen den Baeumen waechst, duftet frisch und "+
    "scheint sehr saftig."));
  AddDetail( ({ "staemme", "rinde", "raender", "stellen" }),
    BS("Die Staemme der Birken sind weiss, aber an vielen Stellen ist die Rinde "+
    "geplatzt und dunkle Raender zeigen sich dort. Das scheint aber fuer diese Baeume normal zu sein."));
  AddDetail( ({ "panorama", "gebirge", "bergketten", "bergkette", "gebirgsketten", "schoenheit" }),
    BS("Das Panorama der Gebirgsketten erstreckt sich von Nordosten bis Westen. "+
    "Die vielen Berggipfel mit ihren Schneekuppen strahlen eine erhabene Schoenheit aus."));
  AddDetail( ({ "nordosten", "norden", "nordwesten", "westen" }),
    BS("Das Panorama der Gebirgsketten dominiert diese Himmelsrichtung. "));
  AddDetail( ({ "suedwesten", "sueden", "suedosten", "osten" }),
    BS("Die Waelder scheinen sich fas bis zum Horizont auszudehnen. "));
  AddDetail( ({ "baumkronen" }),
    BS("Die Baumkronen sind sehr hoch ueber Dir. Auch an den duennen, glatten Staemmen der Birken kann man "
    "nur schwer nach oben kletteren."));
  AddDetail( ({ "gipfel", "berggipfel", "schneekuppen", "schneekuppe" }),
    BS("Manche Gipfel der Gebirgsketten sind von einer Schneekuppe bedeckt. Mehr kannst Du aber "+
    "von hier nicht erkennen."));
  AddDetail( ({ "blumen", "blueten" }),
    BS("Im Gras strecken ein paar kleine Blumen ihre Blueten der Sonne entgegen. "));
  AddDetail( ({ "himmelsrichtung", "himmelsrichtungen", "richtung", "richtungen" }),
    BS("Norden, Osten, Sueden und Westen sind Himmelsrichtungen. "));
  AddDetail( ({ "horizont" }),
    BS("Hier im Wald kann man den Horizont nur erahnen. "));
  AddDetail( ({ "licht", "lichtverhaeltnisse" }),
    BS("Die Sonne scheint herab aber die, sich im Wind schaukelnden Blaetter der Baeume, erzeugen hier "+
    "unstete Lichtverhaeltnisse. "));
  AddDetail( ({ "luft", "waldluft" }),
    BS("Nur ganz normale Waldluft."));
  AddDetail( ({ "sonne" }),
    BS("Sie scheint. "));
  AddDetail( ({ "felsen" }),
    BS("Nur wenige Felsen liegen zwischen den Baeumen.  "));
  AddDetail( ({ "nase" }),
    BS("Mit einer Nase kann man riechen."));
  AddDetail( ({ "ohren" }),
    BS("Mit Ohren kann man hoeren."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddCmd( ({"kletter"}), "cmd_klettern" );
}

int cmd_klettern(string str)
{
	notify_fail("Wohin willst du klettern?\n");
	if( str != "auf baum" && str != "auf birke") return 0;
	write("Du versuchst an der naechste Birke hochzuklettern aber Du rutschst immer wieder ab.\n" );
	say(TPN+" versucht an einer Birke hochzuklettern, rutscht aber immer wieder ab.\n" );
	return 1;
}