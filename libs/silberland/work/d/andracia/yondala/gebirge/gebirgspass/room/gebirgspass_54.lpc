#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

string sache;

void reset()
{
  if( random(2) )	sache=0;
  else if( random(2) ) sache="versteinerung";
  else if( random(2) ) sache="schneckenhaus";
  else sache="edelstein";
	::reset();
}

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Ein Stein, der am Wegesrand liegt, kommt Dir komisch vor."));
  AddDetail( ({ "wegesrand" }),
    "Dieser Stein sieht irgendwie merkwuerdig aus.");
  AddSpecialDetail( ({ "stein" }),
    "det_stein");

  AddExit( ({ "nordwestoben" }),  PASS_ROOM + "gebirgspass_55.lpc" );
  AddExit( ({ "suedunten" }),  PASS_ROOM + "gebirgspass_53.lpc" );

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_55.lpc" );
  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_53.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordwesten", "sueden"}) );
}

string det_stein(string str)
{
	object ob;
	if( !sache ) return BS("Du hast dich wohl getaeuscht. Du kannst beim naeheren Hinsehen nichts besonderes an diesem Stein entdecken.");
	switch( sache )
	{
		case "versteinerung": 
    	write( BS("Du schaust Dir den Stein genau an und erkennst dass dieser Stein eine Versteinerung zeigt. "+
    	  "Eine Art Kaefer scheint dort im Stein seine Konturen hinterlassen zu haben. Aber das ist eigentlich "+
    	  "auch nur ein wertloser Stein, daher wirfst Du ihn wieder weg.") );
	    say( BS(TP->name()+" schaut sich einen Stein intensiv an, dann wirft "+TP->QueryPronoun(WEN)+" ihn aber wieder weg.") );
	    break;
	  case "schneckenhaus":
			ob=clone_object("/d/andracia/yondala/gebirge/gebirgspass/obj/schneckenhaus.lpc");
			ob->move(TP, M_GET);
    	write( BS("Du hebst den Stein auf und wunderst dich ueber sein leichtes Gewicht. Aber da erkennst Du dass es "+
    	  "sich um ein leeres Schneckenhaus handelt.") );
	    say( TP->name()+" hat ein leeres Schneckenhaus gefunden.\n" );
	    break;
		case "edelstein":
			"/obj/gemmaster"->DistributeGem(1, 0, 0, TP);
    	write( "Du findest einen Edelstein. Den muss wohl jemand verloren haben.\n" );
	    say( TP->name()+" hat einen Edelstein gefunden.\n" );
	}
	sache=0;
	return "";
}
