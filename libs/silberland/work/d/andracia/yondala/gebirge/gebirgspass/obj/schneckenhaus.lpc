inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein leeres Schneckenhaus");
  SetProp( P_LONG, BS("Ein leeres Schneckenhaus einer Weinbergschnecke. Das arme Tier "+
    "scheint schon vor langer Zeit eingegangen zu sein. Das Schneckenhaus selbst ist aber "+
    "unbeschaedigt und kann vielleicht zu einem Schmuckstueck verarbeitet werden. "+
    "Bestimmt kann man es fuer ein paar Muenzen an einen Haendler verkaufen.") );
  // SetProp( P_INFO, "Ein nutzloses Spielzeug");
  SetProp( P_NAME, "Schneckenhaus");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_LIME ); //MAT_<>
  SetProp( P_WEIGHT, 10); //in g
  SetProp( P_VALUE, 17); //Wert in Muenzen
  AddId( ({"haus", "schneckenhaus"}) );

}

