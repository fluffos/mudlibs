#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_ost.lpc";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Ein verkohler Baumstumpf ist nur hier nur wenige Schritte vom Weg entfernt."));
  AddDetail( ({"baumstumpf", "stumpf", "baum", "brand"}),
    BS("Dieser Baum ist ganz verkohlt und hat wohl vor nicht allzulanger Zeit gebrannt. Zum Glueck "+
    "gabs keinen Waldbrand. Warscheinlich ist der Blitz beim letzten Gewitter in diesen Baum eingeschlagen "+
    "und hat ihn entzuendet.") );
  AddDetail( ({"blitz", "gewitter"}),
    BS("Das letzte Gewitter hat diesen Baum wohl mit einem Blitz in Brand gesteckt. Heute ist der Himmel klar "+
    "und es ist kein Gewitter zu erwarten.") );
  AddDetail( ({"glueck", "zeit"}),
    BS("Du hast Glueck dass ich genug Zeit zum Scriptfallen programmieren gefunden habe. Los untersuche die "+
    "Scriptfalle!") );
  AddSpecialDetail( ({ "scriptfalle", "scriptfallen" }), "unt_scriptfalle" );

  AddExit( ({ "nordwestoben" }),  PASS_ROOM + "gebirgspass_38.lpc" );
  AddExit( ({ "suedunten" }),  PASS_ROOM + "gebirgspass_40.lpc" );

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_38.lpc" );
  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_40.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordwesten", "sueden"}) );
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 45+random(60), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}  