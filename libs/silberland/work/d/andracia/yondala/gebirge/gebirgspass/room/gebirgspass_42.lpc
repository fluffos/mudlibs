#include "../def.h"

//inherit PASS_ROOM + "gebirgspass_wald_ost.lpc";
inherit PASS_ROOM + "gebirgspass_wald_ost.lpc";
//inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Sueden erkennen."));

  AddDetail( ({ "kreuzung", "sueden" }),
    BS("Im Sueden liegt eine Kreuzung. "));

  AddExit( ({ "sueden" }), "/d/andracia/yondala/tal/birkenhain/room/birkenhainkreuz_1.lpc" );
  AddExit( ({ "nordoben" }),  PASS_ROOM + "gebirgspass_41.lpc" );

  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_41.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden"}) );
}

