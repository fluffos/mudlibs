#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Du hoerst den Schrei eines Adlers."));
  AddDetail( ({"adler"}),
    BS("Der Adler zieht ueber Dir am Himmel seine Kreise.") );
  AddSound( ({"schrei", "schreie", "adler"}),
    BS("Der Schrei des Adlers hat dich kurz erschreckt, aber er scheint nun woanders nach Beute zu suchen.") ); 
  AddDetail( ({"beute"}), 
    BS("Such Dir ein paar Raeuber, die Du um ihre Beute erleichtern kannst.") );
  AddDetail( ({"raeuber"}),
    BS("Hier sind keine Raeuber.") );  

  AddExit( ({ "nordoben" }),  PASS_ROOM + "gebirgspass_53.lpc" );
  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_51.lpc" );

  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_53.lpc" );
  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_51.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden", "suedwesten"}) );
}

