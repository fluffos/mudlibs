#include "../def.h"

inherit PASS_ROOM + "gebirgspass_baumgrenze.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS(""));
  */

  AddExit( ({ "nordwestoben" }),  PASS_ROOM + "gebirgspass_36.lpc" );
  AddExit( ({ "ostunten" }),  PASS_ROOM + "gebirgspass_38.lpc" );

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_36.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_38.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordwesten", "osten"}) );
}

