#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

string sache;

void reset()
{
	if( !sache )
	{
		if( !random(30) )	sache="edelstein";
		else sache="muenze";
	}
	::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Du glaubst ein Glitzern am Boden gesehen zu haben."));
  AddSpecialDetail( ({ "glitzer", "glitzern" }),
    "det_glitzern");


  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_13.lpc" );
  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_15.lpc" );

  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_13.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_15.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordosten", "suedwesten"}) );
}

string det_glitzern(string str)
{
	object ob;
	if( !sache ) return BS("Du hast dich wohl getaeuscht. Du kannst beim naeheren Hinsehen nichts besonderes entdecken.");
	switch( sache )
	{
		case "muenze": 
			ob=clone_object("/obj/money.lpc");
			ob->move(TP, M_GET);
    	write( "Du findest eine Muenze. Die muss wohl jemand verloren haben.\n" );
	    say( TP->name()+" hat eine Muenze gefunden.\n" );
	    break;
		case "edelstein":
			"/obj/gemmaster"->DistributeGem(1, 0, 0, TP);
    	write( "Du findest einen Edelstein. Den muss wohl jemand verloren haben.\n" );
	    say( TP->name()+" hat einen Edelstein gefunden.\n" );
	}
	sache=0;
	return "";
}
