#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

//#define BLUME "/d/huegelland/yason/wiese/obj/blume_margarite.lpc"

int menge_blueten;

void init()
{
  if( menge_blueten < 4 ) menge_blueten++;
  ::init();
}

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Ein paar kleine Margariten wachsen hier am Wegesrand."));
  AddDetail( ({"margarite", "margariten", "blumen", "blume", "wegesrand"}),
    BS("Ein paar Margariten wachsen hier am Wegesrand. Du koenntest Dir bestimmt welche pfluecken.") );
  menge_blueten = 4;
  AddCmd( ({ "pflueck", "pfluecke", "rupf", "rupfe" }), "pfluecken_CMD" );

  AddExit( ({ "nordwestoben" }),  PASS_ROOM + "gebirgspass_34.lpc" );
  AddExit( ({ "ostunten" }),  PASS_ROOM + "gebirgspass_36.lpc" );

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_34.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_36.lpc" );
  SetProp( P_HIDE_EXITS, ({"osten", "nordwesten"}) );
}

int pfluecken_CMD(string str)
{
  object ob;
  notify_fail("Was willst Du pfluecken?\n");
  if(str != "bluete" && str != "blueten" && str != "margarite" && str != "margariten" && str != "blume" && str != "blumen")
    return 0;
  notify_fail("Leider sind die paar schoenen Bluemchen schon alle abgepflueckt.\n");
  if(menge_blueten == 0) return 0;
  menge_blueten--;
  //ob = clone_object(BLUME);
  //if(ob->move(TP, M_GET) != 1) ob->move(environment(TP),M_SILENT);
  CLONE("/d/andracia/yondala/wiese/obj/blume_margarite", TP);
  write("Du pflueckst eine Margarite. \n");
  say(TPN + " pflueckt eine Margarite. \n");
  return 1;  
}
