#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /*
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Es ist ein kleines Stueck bis zum breiten Gipfel."));
  */

  AddExit( ({ "suedostoben" }),  PASS_ROOM + "gebirgspass_66.lpc" );
  AddExit( ({ "nordostunten" }),  PASS_ROOM + "gebirgspass_64.lpc" );

  AddExit( ({ "suedosten" }),  PASS_ROOM + "gebirgspass_66.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_64.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordosten", "suedosten"}) );
}

