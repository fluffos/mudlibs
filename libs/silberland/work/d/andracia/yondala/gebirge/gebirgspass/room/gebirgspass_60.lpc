#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS(""));
  */

  AddExit( ({ "suedoben" }),  PASS_ROOM + "gebirgspass_61.lpc" );
  AddExit( ({ "nordunten" }),  PASS_ROOM + "gebirgspass_18.lpc" );

  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_61.lpc" );
  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_18.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden", "sueden"}) );
}

