#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS(""));
  */

  AddExit( ({ "nordwestoben" }),  PASS_ROOM + "gebirgspass_56.lpc" );
  AddExit( ({ "suedostunten" }),  PASS_ROOM + "gebirgspass_54.lpc" );

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_56.lpc" );
  AddExit( ({ "suedosten" }),  PASS_ROOM + "gebirgspass_54.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordwesten", "suedosten"}) );
}

