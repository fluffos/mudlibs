inherit "std/transport";

#include "../def.h"
#include <properties.h>

//#define STARTRAUM "/d/gebirge/yason/gebirgspass/room/gebirgspass_67"
//#define ENDERAUM "/d/wolken/yondala/lunia/room/lunia_9c"

#define STARTRAUM "/d/andracia/yondala/gebirge/gebirgspass/room/gebirgspass_67"
#define ENDERAUM "/d/andracia/yondala/wolken/lunia/room/lunia_9c"

void create() 
{
  // if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "In einer fliegenden Kutsche" );
  SetProp( P_INT_LONG, BS(
    "Du sitzst in einer offenen Kutsche, die von einem niedlichem kleinen Pinguin gezogen wird.") );
  SetProp( P_SHORT, "Eine goldene Kutsche" );
  SetProp( P_LONG, BS(
    "Du siehst eine praechtige kleine Kutsche. Sie wirkt zierlich, doch scheint sie aus purem Gold zu bestehen.") );
  SetProp( P_NAME, "Pinguinkutsche" );
  AddId( ({ "kutsche", "pinguin" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_ARTICLE, 1 );

  AddDetail( "kutsche", BS(
    "Die Kutsche ist wunderbar kunstvoll gearbeitet, sie wirkt zierlich und filigran, doch das Gold, aus dem sie besteht, "+
	"sorgt fuer genuegend Stabilitaet. ") );
  AddDetail( "stabilitaet", BS(
    "Gold ist nicht unbedingt das stabilste Metall, aber es ist stabil genug fuer eine Kutsche. ") );
  AddDetail( "metall", BS(
    "Es gibt verschiedenste Metall in dieser Welt. ") );
  AddDetail( "welt", BS(
    "Du befindest Dich im SilberLand, auf dem Kontinent Andracia. ") );
  AddDetail( ({"silberland","andracia","kontinent"}), BS(
    "Dort befindest Du Dich. ") );
  AddDetail( "pinguin", BS(
    "Der kleine Pinguin traegt ein schwarz-weisses Federkleid. Er wirkt gar nicht so stark, aber offensichtlich schafft "+
	"er es, mehrmals taeglich die Kutsche hoch in den Himmel und zurueck zu befoerdern. ") );
AddDetail( ({"himmel", "erde"}), BS(
    "Diese Kutsche stellt eine Verbindung zwischen Himmel und Erde her. ") );
  AddDetail( "verbindung", BS(
    "Du wuesstest nicht, wie Du ohne diese Verbindung nach Lunia gelangen solltest. ") );
  AddDetail( ({"hauptstadt","lunia"}), BS(
    "Lunia ist die Hauptstadt Andracias. Diese Kutsche kann Dich dorthin und auch wieder zurueck bringen.") );
  AddDetail( "federkleid", BS(
    "Etwas zerzaust ist es ja schon. Trotzdem wirkt es weich und warm. Das Schwarz glitzert ein wenig. ") );
  AddDetail( "schwarz", BS(
    "Fast wirkt es so, als sei das schwarze Federkleid des kleinen Pinguins mit Diamantstaub bestaeubt. ") );
  AddDetail( "diamantstaub", BS(
    "Aber das wirkt sicher nur so. Woher soll denn bitte Diamantstaub auf einem Pinguin kommen? ") );
  AddDetail( "staub", BS(
    "Sei mal nicht so faul. Untersuche \"Diamantstaub\", wie es auch da steht! ") );
   AddDetail( "", BS(
    ". ") );

  AddDetail( "", BS(
    ". ") );
	
  SetProp( P_DEPARTMSG, ({
    "Der kleine Pinguin nimmt Anlauf, es gibt einen harten Ruck und die Kutsche hebt ab.\n", 
    "Der kleine Pinguin nimmt Anlauf und die Kutsche hebt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Es rumpelt und pumpelt und die Kutsche landet @@QueryArrived@@.\n",
    "Eine kleine, von einem Pinguin gezogene Kutsche purzelt mehr vom Himmel, als dass sie landet.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "klettert in die kleine Kutsche",
    "klettert in die kleine Kutsche"}) );
  SetProp( P_ENTERFAIL, ({
    "Die Kutsche ist nur fuer zwei Personen ausgelegt. Du musst leider warten, bis sie zurueck kommt.",
    "passt nicht mehr in die Kutsche"}) );
  SetProp( P_MAX_PASSENGERS, 2 );

  SetProp( P_LEAVEMSG, ({
    "klettert aus der Kutsche",
    "klettert aus der Kutsche"}) );
  SetProp( P_LEAVEFAIL, ({
    "Das lass mal schoen bleiben, solange die Kutsche fliegt.",
    "moechte hier oben aus der Kutsche springen"}) );

  /* Verben */
  AddCmd( ({ "besteige", "besteig", "steige" }), "rein" );
  AddCmd( ({ "springe", "spring" }), "raus" );
  AddCmd( ({ "toete" }), "toetungsversuch" );

  /* Kurs */
  AddRoute( STARTRAUM, 30, 20, "auf einem Plateau", ({"plateau", "gebirge", "boden"}), "zum Plateau im Gebirge" );
  AddMsg( "Die Kutsche steigt hoeher und hoeher.\n", 30 );
  AddMsg( "Der kleine Pinguin flattert angestrengt mit seinen kleinen Fluegeln.\n", 25 );
  AddMsg( "Ihr seid nun ueber den Wolken, der kleine Pinguin glitzert in der Sonne.\n", 20 );
  AddMsg( "Geschickt umfliegt der Pinguin eine Wolke, Du wirst ein bisschen durchgeschuettelt.\n", 15 );
  AddMsg( "In der Ferne siehst Du eine Stadt in den Wolken. Der Flug kann nicht mehr lange dauern.\n", 10 );
  AddMsg( "Der kleine Pinguin breitet seine Fluegelchen aus, die Kutsche bremst ab und setzt zur Landung an.\n", 5 );

  
  AddRoute( ENDERAUM, 30, 20, "in der Wolkenstadt Lunia", ({"wokenstadt", "lunia", "himmel"}), "zur Wolkenstadt Lunia" );
  AddMsg( "Der kleine Pinguin nimmt Anlauf und reisst die Kutsche und somit auch Dich in die Tiefe.\n", 30 );
  AddMsg( "Ihr taumelt und kreist in der Luft. Du musst Dich gut festhalten, um nicht aus der Kutsche zu fallen.\n", 25 );
  AddMsg( "Der kleine Pinguin breitet seine winzigen Fluegelchen aus und flattert angestrengt.\n", 20 );
  AddMsg( "Die Kutsche faellt langsamer und geht in einen ruhigen Sinkflug ueber.\n", 15 );
  AddMsg( "Du schaust Dich um. Unter Dir siehst Du ein riesiges Gebirge unter Dir, im Westen die Ebene bis hin zum Meer und oestlich ein grosses Tal.\n", 10 );
  AddMsg( "Ein Plateau kommt naeher und der Pinguin setzt zu einer holprigen Landung an.\n", 5);
	
 	// SHIPD->AddHarbour(TO, STARTRAUM);
 	// SHIPD->AddHarbour(TO, ENDERAUM);
 	
  Start();
}

int toetungsversuch(string str)
{
	if( str == "kutsche" || str=="pinguin" ) 
	{
		write( "Es waere schon sehr schlimm, wenn die einzige Kutsche zwischen Himmel und Erde ausfallen wuerde, findest Du nicht?\n");
		return 1;
	}
	else return 0;
}

int rein(string str)
{
  notify_fail("Was willst Du besteigen?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Willst Du aus der Kutsche springen?\n");
  if( !str ) return 0;
  if( id(str) || str=="aus der Kutsche" ) return Leave();
  else return 0;	
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( STARTRAUM, "???"));
    catch(call_other( ENDERAUM, "???"));
  }
}
