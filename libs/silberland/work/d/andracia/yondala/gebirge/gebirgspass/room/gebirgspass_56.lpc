#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

string EINGANG = "/d/andracia/yondala/gebirge/hoehlen/room/hoehlen077.lpc";

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Ein Stolleneingang befindet sich hier."));//\n DER STOLLEN IST NOCH GESCHLOSSEN. YONDALA."));
  
  AddDetail( ({"eingang", "stolleneingang"}), BS(
    "Der Pfad endet hier an einem Stolleneingang. Er ist mit Holzbalken abgestuetzt und nur ein paar "+
    "Schritte hinein herrscht schon tiefste Dunkelheit. Ohne geeignete Lichtquelle wird es schwer sich in "+
    "den Tiefen des Bergs zurechtzufinden.") );
  AddDetail( ({"holz", "holzbalken"}), BS(
    "Diese Holzbalken stuetzen den Eingang ab. Das Holz ist schon leicht verwittert und macht einen nicht "+
    "besonders stabilen Eindruck. Ob man sich wirklich in diese Hoehle wagen sollte? ") );
  AddDetail( ({"dunkel", "dunkelheit", "hoehle"}), BS(
    "Man kann kaum etwas von der Hoehle hinter dem Stolleneingang erkennen, es ist dort einfach zu dunkel.") );  
 
 // AddExit( ({ "westen" }), EINGANG );
 
  AddExit( ({ "westen" }), "/d/andracia/yondala/gebirge/hoehlen/room/hoehlen_a.lpc" );
  
  AddExit( ({ "suedostunten" }),  PASS_ROOM + "gebirgspass_55.lpc" );

  AddExit( ({ "suedosten" }),  PASS_ROOM + "gebirgspass_55.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedosten"}) );
  
}

