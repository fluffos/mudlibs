#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Es ist ein kleines Stueck bis zum breiten Gipfel."));
  

  AddExit( ({ "suedoben" }),  PASS_ROOM + "gebirgspass_67.lpc" );
  AddExit( ({ "nordwestunten" }),  PASS_ROOM + "gebirgspass_65.lpc" );

  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_67.lpc" );
  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_65.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordwesten", "sueden"}) );
}

