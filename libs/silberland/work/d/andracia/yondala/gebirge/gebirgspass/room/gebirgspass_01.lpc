#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_west.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, TO->QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Westen erkennen."));

  AddDetail( ({ "kreuzung", "westen" }),
    BS("Im Westen liegt eine Kreuzung. "));

//  AddExit( ({ "westen" }), KREUZUNG_01 );
  
  AddExit( ({ "westen" }), "/d/andracia/yondala/wege/room/kreuzung_01.lpc");
  AddExit( ({ "ostoben" }),  PASS_ROOM + "gebirgspass_02.lpc" );

  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_02.lpc" );
  SetProp( P_HIDE_EXITS, ({"osten"}) );
}

