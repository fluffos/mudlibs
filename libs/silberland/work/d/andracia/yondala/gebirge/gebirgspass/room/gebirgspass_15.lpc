#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

#define FEDER "/d/wolken/yondala/lunia/obj/feder.lpc"

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Hier liegen einige Federn wild verstreut am Wegesrand."));
  AddDetail( ({ "feder", "federn" }),
    BS("Die Federn liegen hier wild verstreut. Alles sieht so aus als haette hier jemand oder etwas "+
    "einen Vogel gerissen. Warscheinlich hat hier ein Adler seine Beute gerupft und verspeist.") );
  AddDetail( ({"adler"}),
    BS("Wenn ein Adler hier seine Beute gerupft und verspeist hat, so ist er schon seit einiger Zeit davon geflogen.") ); 
  AddDetail( ({"beute"}), 
    BS("Such Dir ein paar Raeuber die Du um ihre Beute erleichtern kannst.") );
  AddDetail( ({"raeuber"}),
    BS("Hier sind keine Raeuber.") );  
  AddCmd( ({"nimm", "nehme"}), "cmd_nehmen" );

  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_14.lpc" );
  AddExit( ({ "ostoben" }),  PASS_ROOM + "gebirgspass_16.lpc" );

  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_14.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_16.lpc" );
  SetProp( P_HIDE_EXITS, ({"osten", "suedwesten"}) );
}

int cmd_nehmen(string str)
{
	object ob;
	
	if( !str ) return 0;  
	if( str!="feder" && str!="federn" ) return 0;
	if( present("feder", TP) ) 
	{
		write( "Du hast Dir doch schon eine Feder genommen.\n");
		return 1;
	}
	ob=clone_object("/d/andracia/yondala/wolken/lunia/obj/feder.lpc");
	ob->move(TP, M_GET);
  write( "Du nimmst Dir eine der Federn.\n");
	say( TP->name()+" nimmt sich eine Feder.\n" );
	return 1;
}
