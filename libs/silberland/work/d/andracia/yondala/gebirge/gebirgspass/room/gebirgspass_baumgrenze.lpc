#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "An der Baumgrenze" );
  SetProp( P_INT_LONG,
     BS("Hier ist die Baumgrenze. Unterhalb dieser Hoehe beginnt der Wald und oberhalb sind "+
     "nur noch schroffe Felsen. Das Gebirge selbst ist aber noch um vieles hoeher und an den "+
     "Gipfeln kann man umfangreiche Schneekuppen erkennen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst ein paar Voegel zwitschern. "));
  AddSound( ({ "zwitschern" }),
    BS("Nur ein paar Voegel."));
  AddSmell( DEFAULT_SMELL,
    BS("Neben der kalten Bergluft kann man auch noch ein bischen vom unterhalb liegenden Wald "+
    "riechen. "));
  AddSmell( ({ "bergluft" }),
    BS("Kalt und frisch."));
  AddSmell( ({ "wald", "waldduft" }),
    BS("Der typische Waldduft: verrottendes Holz und feuchtes Moos."));
  AddSmell( ({ "luft" }),
    BS("Neben der kalten Bergluft kann man auch noch ein bischen vom unterhalb liegenden Wald "+
    "riechen. "));

  AddDetail( ({ "boden", "untergrund", "grund", "felsen" }),
    BS("Schroffe Felsen bilden den Untergrund. Zwischen den Felsen waechst unscheinbares Moos. "));
  AddDetail( ({ "himmel", "wetter" }),
    BS("Der tiefblaue Himmel laesst vermuten dass das gute Wetter lange anhaelt. Nur ein paar kleine "+
    "Wolken ziehen am Himmel vorrueber."));
  AddDetail( ({ "voegel", "vogel" }),
    BS("Du kannst leider keine Voegel entdecken, aber ihr zwitschern hoeren."));
  AddDetail( ({ "holz" }),
    BS("Unterhalb dieser Hoehe wachsen noch Baeume. Sieh dich doch dort um."));
  AddDetail( ({ "moos" }),
    BS("Nur ganz normales, feuchtes, guenes Moos. "));
  AddDetail( ({ "wolken", "lunia" }),
    BS("Kleine, flauschige Wolken. Es gibt Geruechte dass es in den Wolken eine Stadt mit "+
    "dem Namen Lunia geben soll. "));
  AddDetail( ({ "geruechte" }),
    BS("Es gibt viele Geruechte. In den Wirtshaeusern kannst Du viele davon hoeren."));
  AddDetail( ({ "baumgrenze", "hoehe", "wald", "baeume" }),
    BS("Hier ist die Baumgrenze. Unterhalb dieser Hoehe beginnt der Wald und oberhalb sind "+
     "nur noch schroffe Felsen. Das Gebirge selbst ist aber noch um vieles hoeher und an den "+
     "Gipfeln kann man umfangreiche Schneekuppen erkennen. "));
  AddDetail( ({ "gebirge", "berge", "bergmassiv" }),
    BS("Das Gebirge hat eine atemberaubende Hoehe. Dort in den Tiefen der Berge ist auch irgendwo "+
    "die Heimat der Zwerge."));
  AddDetail( ({ "gipfel" }),
    BS("Viele der Gipfel sind schneebedeckt."));
  AddDetail( ({ "schnee", "schneekuppen" }),
    BS("Der Schnee dort oben auf den Gipfel ist bestimmt sehr kalt."));
  AddDetail( ({ "heimat" }),
    BS("Die Berge sind die Heimat der Zwerge."));
  AddDetail( ({ "stadt", "tiefen", "zwerge" }),
    BS("Das kann man von hier aus nun wirklich nicht. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/


}
