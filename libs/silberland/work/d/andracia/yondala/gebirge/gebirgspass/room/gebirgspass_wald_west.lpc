#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Gebirgsweg durch einen Wald" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich auf einem Gebirgsweg mitten durch den Wald. Im Osten erhebt sich ein "+
     "riesiges Bergmassiv. Im Westen kann man die letzten Waldauslaeufer erkennen. Ein Stueck im "+
     "Nordwesten kann man die Burg Friedheim sehen. Die Baeume stehen hier etwas dicht aber "+
     "durch den steilen Aufstieg kann man doch sehr gut ueber die Baumkronen hinweg nach Westen schauen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst ein paar Voegel zwitschern. "));
  AddSound( ({ "zwitschern" }),
    BS("Nur ein paar Voegel."));
  AddSmell( DEFAULT_SMELL,
    BS("Hier herrscht typischer Waldduft."));
  AddSmell( ({ "duft", "waldduft" }),
    BS("Der typische Waldduft: altes Laub, verrottendes Holz und feuchtes Moos."));

  AddDetail( ({ "boden", "weg", "gebirgsweg" }),
    BS("Zwischen den Baeumen hindurch fuehrt der steile Weg vom Huegelland fort hinauf ins Gebirge. "
    "Der festgetrampelte Weg bietet genug Platz damit zwei Personen nebeneinander laufen koennen. "+
    "Fuer ein Fuhrwerk ist dieser Weg allerdings zu schmal. "));
  AddDetail( ({ "himmel", "wetter" }),
    BS("Der tiefblaue Himmel laesst vermuten dass das gute Wetter lange anhaelt. Nur ein paar kleine "+
    "Wolken ziehen am Himmel vorrueber."));
  AddDetail( ({ "waldauslaeufer", "waldstuecke" }),
    BS("Der Wald hat keine scharfe Kante an der er am Huegelland aufhoert. Ein paar Waldstuecke "+
    "reichen etwas weiter ins Land hinein. "));
  AddDetail( ({ "burg", "friedheim" }),
    BS("Die Burg Friedheim kann man noch einigermassen erkennen. Aber selbst die Burgzinnen "+
    "kann man kaum noch erahnen"));
  AddDetail( ({ "baeume", "baum", "wald", "nadelbaeume", "nadelbaum", "laubbaeume", "laubbaum", "art", "tannen" }),
    BS("Viele verschiedenste Baeume bilden hier den Wald. Neben den Laubbaeumen aller Art stehen "+
    "auch Tannen und andere Nadelbaeume. Allerdings werden die Laubbaeume je hoeher man steht immer "+
    "weniger."));
  AddDetail( ({ "aufstieg" }),
    BS("Der Weg ist hier sehr steil. "));
  AddDetail( ({ "baumkrone", "baumkronen", "baumspitze", "baumspitzen" }),
    BS("Es sind nur ganz  normale Baumspitzen. Durch den steilen Aufstieg kann man doch sehr gut "+
    "ueber die Baumkronen hinweg nach Westen schauen."));
  AddDetail( ({ "westen", "blick" }),
    BS("Im Westen kann man die letzten Waldauslaeufer erkennen. Ein Stueck im "+
     "Nordwesten kann man die Burg Friedheim sehen. Die Baeume stehen hier etwas dicht aber "+
     "durch den steilen Aufstieg kann man doch sehr gut ueber die Baumkronen hinweg nach Westen schauen."));
  AddDetail( ({ "osten" }),
    BS("Im Osten erhebt sich ein riesiges Bergmassiv. "));
  AddDetail( ({ "norden", "sueden" }),
    BS("In diese Richtung versperren Dir die Baeume die Sicht."));
  AddDetail( ({ "voegel", "vogel" }),
    BS("Du kannst leider keine Voegel entdecken, aber ihr zwitschern hoeren."));
  AddDetail( ({ "laub" }),
    BS("Es liegt nur wenig Laub am Boden. Die meissten Baeume hier sind Nadelbaeume. "));
  AddDetail( ({ "holz" }),
    BS("Dazu musst Du schon einen Baum faellen."));
  AddDetail( ({ "moos" }),
    BS("Nur ganz normales, feuchtes, guenes Moos. "));
  AddDetail( ({ "huegelland",  "land", "andracia" }),
    BS("Der Blick nach Westen zeigt einen grossen Teil des Huegellands. Im Nordwesten kann man sogar "+
    "die Burg Friedheim erkennen. "));
  AddDetail( ({ "gebirge", "berge", "bergmassiv" }),
    BS("Das Gebirge erhebt sich majestaetisch im Osten. Dort in den Tiefen der Berge ist auch irgendwo "+
    "die Heimat der Zwerge."));
  AddDetail( ({ "platz" }),
    BS("Auf diesem Weg hat leider kein Fuhrwerk Platz. Gerade mal zwei Personen koennen nebeneinander "+
    "herlaufen. "));
  AddDetail( ({ "personen", "abenteurer", "reisende", "wanderer" }),
    BS("Wanderer, Reisende und Abenteurer benutzen diesen Weg durchs Gebirge."));
  AddDetail( ({ "fuhrwerk" }),
    BS("Hier ist kein Platz fuer ein Fuhrwerk."));
  AddDetail( ({ "wolken", "lunia" }),
    BS("Kleine, flauschige Wolken. Es gibt Geruechte dass es in den Wolken eine Stadt mit "+
    "dem Namen Lunia geben soll. "));
  AddDetail( ({ "zinnen", "burgzinnen", "stadt", "tiefen", "zwerge" }),
    BS("Das kann man von hier aus nun wirklich nicht. "));
  AddDetail( ({ "geruechte" }),
    BS("Es gibt viele Geruechte. In den Wirtshaeusern kannst Du viele davon hoeren."));
  AddDetail( ({ "heimat" }),
    BS("Die Berge sind die Heimat der Zwerge."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddCmd( ({"faelle", "faell" }), "cmd_faellen" );
}

int cmd_faellen(string str)
{
	notify_fail("Was willst Du faellen?\n");
	if( str != "baum" && str != "laubbaum" && str != "nadelbaum" && str != "tanne" ) return 0;
	write(BS("Als Du anfangen willst einen Baum zu faellen, faellt Dir ein Tannenzapfen auf den Kopf. "+
	  "Der Baum will scheinbar nicht gefaellt werden. Such Dir lieber einen anderen Baum. "));
	return 1;
	// hier soll man normales Holz sich beschaffen koennen zum schnitzen
}	