// Baumgrenze Ostseite

#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_ost.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Noch ein kleines Stueck hoeher und Du hast die Baumgrenze erreicht."));
  */

  AddExit( ({ "suedunten" }),  PASS_ROOM + "gebirgspass_41.lpc" );
  AddExit( ({ "nordoben" }),  PASS_ROOM + "gebirgspass_39.lpc" );

  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_41.lpc" );
  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_39.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden", "sueden"}) );
}

