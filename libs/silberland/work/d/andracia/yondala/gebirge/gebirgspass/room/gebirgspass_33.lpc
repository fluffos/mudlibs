#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Hier zirpt eine Grille."));
  AddDetail( ({"grille"}),
    BS("Du kannst die Grille nicht sehen, nur hoeren.") );
  AddSound( ({"zirpen", "gezirpe", "zirper", "grille"}),
    BS("Du lauschst dem Zirpen, kannst aber nicht erkennen woher es kommt.") ); 

  AddExit( ({ "nordoben" }),  PASS_ROOM + "gebirgspass_32.lpc" );
  AddExit( ({ "suedostunten" }),  PASS_ROOM + "gebirgspass_34.lpc" );

  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_32.lpc" );
  AddExit( ({ "suedosten" }),  PASS_ROOM + "gebirgspass_34.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden", "suedosten"}) );
}

