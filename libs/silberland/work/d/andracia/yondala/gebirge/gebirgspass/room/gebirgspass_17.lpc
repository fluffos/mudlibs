#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

//#define BLUME "/d/andracia/yondala/wiese/obj/blume_veilchen.lpc"

int menge_blueten;

void init()
{
  if( menge_blueten < 4 ) menge_blueten++;
  ::init();
}

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Ein paar kleine Veilchen wachsen hier am Wegesrand."));
  menge_blueten = 4;
  AddDetail( ({"veilchen", "blumen", "blume", "wegesrand"}),
    BS("Ein paar Veilchen wachsen hier am Wegesrand. Du koenntest Dir bestimmt welche pfluecken.") );
  AddCmd( ({ "pflueck", "pfluecke", "rupf", "rupfe" }), "pfluecken_CMD" );

  AddExit( ({ "westunten" }),  PASS_ROOM + "gebirgspass_16.lpc" );
  AddExit( ({ "ostoben" }),  PASS_ROOM + "gebirgspass_18.lpc" );

  AddExit( ({ "westen" }),  PASS_ROOM + "gebirgspass_16.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_18.lpc" );
  SetProp( P_HIDE_EXITS, ({"westen", "osten"}) );
}

int pfluecken_CMD(string str)
{
  object ob;
  notify_fail("Was willst Du pfluecken?\n");
  if(str != "bluete" && str != "blueten" && str != "veilchen" && str != "blume" && str != "blumen")
    return 0;
  notify_fail("Leider sind die paar schoenen Bluemchen schon alle abgepflueckt.\n");
  if(menge_blueten == 0) return 0;
  menge_blueten--;
 // ob = clone_object(BLUME);
 // if(ob->move(TP, M_GET) != 1) ob->move(environment(TP),M_SILENT);
  CLONE("/d/andracia/yondala/wiese/obj/blume_veilchen", TP);
  write("Du pflueckst ein Veilchen. \n");
  say(TPN + " pflueckt ein Veilchen. \n");
  return 1;  
}