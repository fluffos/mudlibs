#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_west.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /*
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Westen erkennen."));
  */

  AddExit( ({ "westunten" }),  PASS_ROOM + "gebirgspass_06.lpc" );
  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_08.lpc" );

  AddExit( ({ "westen" }),  PASS_ROOM + "gebirgspass_06.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_08.lpc" );
  SetProp( P_HIDE_EXITS, ({"westen", "nordosten"}) );
}

