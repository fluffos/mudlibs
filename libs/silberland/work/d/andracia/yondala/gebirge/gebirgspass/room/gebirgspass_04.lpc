#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_west.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /*
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Westen erkennen."));
  */

  AddExit( ({ "westunten" }),  PASS_ROOM + "gebirgspass_03.lpc" );
  AddExit( ({ "ostoben" }),  PASS_ROOM + "gebirgspass_05.lpc" );

  AddExit( ({ "westen" }),  PASS_ROOM + "gebirgspass_03.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_05.lpc" );
  SetProp( P_HIDE_EXITS, ({"westen", "osten"}) );
}

