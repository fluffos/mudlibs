#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Du hoerst den Schrei eines Adlers."));
  AddDetail( ({"adler"}),
    BS("Der Adler zieht ueber Dir am Himmel seine Kreise.") );
  AddSound( ({"schrei", "schreie", "adler"}),
    BS("Der Schrei des Adlers hat dich kurz erschreckt, aber er scheint nun woanders nach Beute zu suchen.") ); 
  AddDetail( ({"beute"}), 
    BS("Such Dir ein paar Raeuber, die Du um ihre Beute erleichtern kannst.") );
  AddDetail( ({"raeuber"}),
    BS("Hier sind keine Raeuber.") );  

  AddExit( ({ "westunten" }),  PASS_ROOM + "gebirgspass_15.lpc" );
  AddExit( ({ "ostoben" }),  PASS_ROOM + "gebirgspass_17.lpc" );

  AddExit( ({ "westen" }),  PASS_ROOM + "gebirgspass_15.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_17.lpc" );
  SetProp( P_HIDE_EXITS, ({"westen", "osten"}) );
}

