#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem steinigen Gebirgsweg oberhalb der Baumgrenze" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich auf einem steinigen Gebirgsweg oberhalb der Baumgrenze. Ueberall "+
     "nur Felsen und nur hin und wieder ein kleines bisschen Gras. Die Luft ist kalt und ein eisiger "+
     "Wind pfeift hier ueber das Geroell. Manchmal kann man ein Geraeusch vernehmen das sich verdaechtig "+
     "nach einem rollenden Stein anhoert. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddSound( DEFAULT_SOUND,
    BS("Der Wind pfeift ueber die Felsen und nur noch selten kann man das Zwitschern eines "+
    "Vogels vernehmen. "));
  AddSound( ({ "pfeiffen", "pfiff", "pfeifen", "geraeusch" }),
    BS("Der Wind pfeift ueber die Felsen. Koennte dieser laute Pfiff eben der Warnruf eines "+
    "Murmeltiers gewesen sein?"));
  AddSound( ({ "zwitschern" }),
    BS("Hier oben sind nur noch selten Voegel zu finden. Aber ein paar Zwitscherlaute glaubst Du "+
    "vernommen zu haben."));
  AddSound( ({ "warnruf" }),
    BS("Da war schon wieder ein lauter Pfiff ganz in der Naehe. Das war bestimmt ein Murmeltier."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes an der frischen Bergluft riechen."));
  AddSmell( ({ "bergluft" }),
    BS("Frisch und kalt, sonst nichts."));

  AddDetail( ({ "boden", "weg", "gebirgsweg", "pfad" }),
    BS("Der Boden besteht aus scharfkantigen Felsen jeder Groesse. Zwischen dem Geroell waechst an "+
    "manchen Stellen ein kleines bisschen Gras."));
  AddDetail( ({ "himmel", "wetter" }),
    BS("Der tiefblaue Himmel laesst vermuten dass das gute Wetter lange anhaelt. Nur ein paar kleine "+
    "Wolken ziehen am Himmel vorrueber."));
  AddDetail( ({ "voegel", "vogel" }),
    BS("Du kannst leider keine Voegel entdecken, aber vereinzelt ihr zwitschern hoeren."));
  AddDetail( ({ "gras" }),
    BS("Nur ganz normales, guenes Gras. In dieser Hoehe wachsen scheinbar nur noch kleine, karge Grasbueschel."));
  AddDetail( ({ "wolken", "lunia" }),
    BS("Kleine, flauschige Wolken. Es gibt Geruechte dass es in den Wolken eine Stadt mit "+
    "dem Namen Lunia geben soll. "));
  AddDetail( ({ "geruechte" }),
    BS("Es gibt viele Geruechte. In den Wirtshaeusern kannst Du viele davon hoeren."));
  AddDetail( ({ "gebirge", "berge", "bergmassiv" }),
    BS("Das Gebirge hat eine atemberaubende Hoehe. Dort in den Tiefen der Berge ist auch irgendwo "+
    "die Heimat der Zwerge."));
  AddDetail( ({ "gipfel" }),
    BS("Viele der Gipfel sind schneebedeckt."));
  AddDetail( ({ "schnee", "schneekuppen" }),
    BS("Der Schnee dort oben auf den Gipfel ist bestimmt sehr kalt."));
  AddDetail( ({ "heimat" }),
    BS("Die Berge sind die Heimat der Zwerge."));
  AddDetail( ({ "grasbueschel" }),
    BS("Hier zwischen den Felsen wachsen nur kleine Grasbueschel."));
  AddDetail( ({ "baumgrenze", "hoehe" }),
    BS("Die Baumgrenze ist ein gutes Stueck tiefer."));
  AddDetail( ({ "fels", "felsen", "geroell", "stein" }),
    BS("Hier oben sind nur noch schroffe Felsen. Man muss aufpassen dass man keine Felsen des Geroells lostritt, "+
    "diese koennten eine Steinlawine ausloesen. "));
  AddDetail( ({ "murmeltier", "murmeltiere" }),
    BS("Durch den Warnruf haben sich alle wohl schon zwischen den Felsen in ihrem Bau versteckt."));
  AddDetail( ({ "stadt", "tiefen", "zwerge" }),
    BS("Das kann man von hier aus nun wirklich nicht. "));
  AddDetail( ({ "steinlawine" }),
    BS("Sei froh dass Du das gerade nicht untersuchen kannst."));
  AddDetail( ({ "bau", "murmeltierbau" }),
    BS("Du kannst leider nicht erkennen wo die Murmeltiere zwischen den Felsen ihren Bau haben."));
  AddDetail( ({ "luft", "wind" }),
    BS("Die Luft hier oben ist kalt und duenn."));

/* bischen
  AddDetail( ({ "" }),
    BS(""));
*/

}
