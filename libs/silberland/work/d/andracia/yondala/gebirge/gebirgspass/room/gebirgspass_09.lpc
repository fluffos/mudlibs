#include "../def.h"

inherit PASS_ROOM + "gebirgspass_wald_west.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Noch ein kleines Stueck hoeher und Du hast die Baumgrenze erreicht."));
  

  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_08.lpc" );
  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_10.lpc" );

  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_08.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_10.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedwesten", "nordosten"}) );
}

