#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

void create() 
{
  ::create();
   
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Eine Felsspalte die sich scheinbar durch das ganze Gebirge nach Osten fortfuehrt "+
     "hat hier ihren Anfang. Ein kleiner Gebirgspfad fuehrt nach Sueden weiter die Felsen hoch."));

  AddDetail( ({ "pfad", "gebirgspfad" }),
    BS("Ein kleiner Pfad fuehrt weiter nach Sueden die Felsen hoch."));
  

  AddExit( ({ "westunten" }),  PASS_ROOM + "gebirgspass_17.lpc" );
  AddExit( ({ "osten" }),  PASS_ROOM + "gebirgspass_19.lpc" );
  AddExit( ({ "suedoben" }),  PASS_ROOM + "gebirgspass_60.lpc" );

  AddExit( ({ "westen" }),  PASS_ROOM + "gebirgspass_17.lpc" );
  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_60.lpc" );
  SetProp( P_HIDE_EXITS, ({"westen", "sueden"}) );
}

