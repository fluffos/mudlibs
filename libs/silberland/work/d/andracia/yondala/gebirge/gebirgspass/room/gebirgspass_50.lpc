#include "../def.h"

inherit PASS_ROOM + "gebirgspass_pfad.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS(""));
  */

  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_51.lpc" );
  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_32.lpc" );

  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_51.lpc" );
  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_32.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordosten", "suedwesten"}) );
}

