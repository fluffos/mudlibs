#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

void create() 
{
  ::create();
   
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Eine Felsspalte die sich scheinbar durch das ganze Gebirge nach Westen fortfuehrt "+
     "hat hier ihren Anfang. Ein kleiner Gebirgspfad fuehrt nach Nordosten weiter die Felsen hoch."));

  AddDetail( ({ "pfad", "gebirgspfad" }),
    BS("Ein kleiner Pfad fuehrt weiter nach Nordosten die Felsen hoch."));
  

  AddExit( ({ "nordwesten" }),  PASS_ROOM + "gebirgspass_31.lpc" );

  AddExit( ({ "suedunten" }),  PASS_ROOM + "gebirgspass_33.lpc" );
  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_50.lpc" );

  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_33.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_50.lpc" );
  SetProp( P_HIDE_EXITS, ({"nordosten", "sueden"}) );
}

