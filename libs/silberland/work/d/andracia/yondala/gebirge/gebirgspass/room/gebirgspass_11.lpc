#include "../def.h"

inherit PASS_ROOM + "gebirgspass_geroell.lpc";

#include <properties.h>

void create() 
{
  ::create();
  /* 
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS(""));
  */

  AddExit( ({ "suedwestunten" }),  PASS_ROOM + "gebirgspass_10.lpc" );
  AddExit( ({ "nordostoben" }),  PASS_ROOM + "gebirgspass_12.lpc" );

  AddExit( ({ "suedwesten" }),  PASS_ROOM + "gebirgspass_10.lpc" );
  AddExit( ({ "nordosten" }),  PASS_ROOM + "gebirgspass_12.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedwesten", "nordosten"}) );
}

