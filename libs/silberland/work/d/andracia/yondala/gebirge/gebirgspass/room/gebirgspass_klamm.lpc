#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer engen Klamm" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich in einer engen Klamm. Rechts und links des Wegs erheben sich steil die Felsen in die Hoehe. "+
     "Jeder Schritt hallt zwischen den Waenden. Nur einen schmalen Streifen Himmel kannst uber Dir ausmachen. Das wenige "+
     "Licht das sich bis hier unten in die Klamm verirrt sorgt fuer ein schummriges Zwielicht. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddSound( DEFAULT_SOUND,
    BS("Hier in dieser engen Klamm hallt jedes Geraeusch von den Waenden wider. "));
  AddSound( ({ "geraeusch", "geraeusche" }),
    BS("Diese Geraeusche hast Du selbts verursacht. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes an der frischen Bergluft riechen."));
  AddSmell( ({ "bergluft" }),
    BS("Frisch und kalt, sonst nichts."));

  AddDetail( ({ "boden", "weg" }),
    BS("Der Boden besteht aus scharfkantigen Felsen jeder Groesse. "));
  AddDetail( ({ "himmel", "streifen" }),
    BS("Nur einen schmalen Streifen Himmel kannst uber Dir ausmachen. Dieser ist aber dafuer tiefblau."));
  AddDetail( ({ "waende", "hoehe", "klamm", "groesse" }),
    BS("Rechts und links des Wegs erheben sich steil die Felsen in die Hoehe. "));
  AddDetail( ({ "fels", "felsen" }),
    BS("Hier oben sind nur noch schroffe Felsen. "));
  AddDetail( ({ "licht" }),
    BS("Bis hier unten in der Klamm dringt nur wenig Licht."));
  AddDetail( ({ "zwielicht" }),
    BS("Es ist richtig unheimlich hier."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

}
