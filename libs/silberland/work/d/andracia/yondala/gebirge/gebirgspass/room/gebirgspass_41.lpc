#include "../def.h"
inherit PASS_ROOM + "gebirgspass_wald_ost";
#include <properties.h>

string abdruck;

void neuer_abdruck()
{
	switch( random(4) ) 
  {
    case 3:	abdruck="baer"; break;
    case 2:	abdruck="fuchs"; break;
    case 1:	abdruck="reh"; break;
    default: abdruck="wildschwein";
  }
}

void reset()
{
	neuer_abdruck();
  ::reset();
}

void create() 
{
  ::create();
  neuer_abdruck();
  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Dir faellt ein Fussabdruck in der weichen Erde auf. "));
	AddDetail( ({"erde", "stelle"}),
	  BS("Hier ist eine Stelle mit etwas weicher Erde und genau darin kann man einen Fussabdruck erkennen.") );
  AddSpecialDetail( ({"abdruck", "fussabdruck", "pfotenabdruck", "hufabdruck", 
  	                  "abdruecke", "fussabdruecke", "pfotenabdruecke", "hufabdruecke", 
  	                  "spur", "spuren", "form"}), "unt_abdruck" );

  AddExit( ({ "suedunten" }),  PASS_ROOM + "gebirgspass_42.lpc" );
  AddExit( ({ "nordoben" }),  PASS_ROOM + "gebirgspass_40.lpc" );

  AddExit( ({ "sueden" }),  PASS_ROOM + "gebirgspass_42.lpc" );
  AddExit( ({ "norden" }),  PASS_ROOM + "gebirgspass_40.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden", "sueden"}) );
}

string unt_abdruck()
{
	switch( abdruck )
	{
		case "baer": 
			return BS("Diese Abdruecke stammen eindeutig von einem grossen Baer. Hoffentlich laeft Dir dieses gefaehrliche Tier nicht ueber den Weg.");
		case "fuchs":
			return BS("Die Abdruecke sind nicht besonders tief und aufgrund der Form nimmst Du an dass diese Spuren von einem Fuchs stammen.");
		case "reh":
			return BS("Nach den schmalen Spuren zu urteilen, stammt dieser Abdruck von einem Reh. Es ist bestimmt schon tief in den Wald gefluechtet.");
		case "wildschwein": 
			return BS("Solche Abdruecke koennten von einem Wildschwein stammen. Ein Wildschweinbraten waere zwar ein leckere Mahlzeit, aber so ein brunftiger Eber "+
			"koennte sich doch auch als gefaehrlich erweisen.");
  }
}
