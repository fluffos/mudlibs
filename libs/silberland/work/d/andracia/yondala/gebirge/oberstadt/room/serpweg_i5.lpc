#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Foerderturm in der Zwergenfestung" );
  SetProp( P_INT_LONG,
     BS("Hier am oestlichen Rand des oberirdischen Teils "+
     "der Zwergenstadt Thumfels steht der Foerderturm der zu den "+
     "in den Tiefen gelegenen Bereichen des Zwergenreichs fuehrt. "+
     "Mit dem Foerderkorb kann man hier direkt zur Zwergenstadt Thumfels "+
     "gelangen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "untergrund" }),
    BS("Schotter bildet den Untergrund."));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind durch den Kessel pfeifen."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));

  AddDetail( ({ "foerderturm", "turm" }),
    BS("Der Foerderturm der hier am oestlichen Rand des oberirdischen Teils "+
    "der Zwergenstadt Thumfels steht dient wohl vorallem zum Transport von "+
    "Personen und Waren. Der Foerderkorb haengt an mehreren Seilen und wird "+
    "ueber eine grosse Laufrolle in den Schacht hinabgelassen beziehungsweise "+
    "hochgezogen. Ein Tretrad, das von 6 Zwergen betrieben wird, ist mit einer "+
    "besonderen Mechanik mit den Seilen verbunden und zieht den Foerderkorb. "+
    "Welch bewundernswerte Technik! " ) );
  AddDetail( ({ "transport", "fahrt" }),
    BS("Wenn Du hinab zur Zwergenstadt willst, so warte einfach auf den "+
    "Foerderkorb.") );
  AddDetail( ({ "waren", "personen", "passagiere" }),
    BS("Waren und Personen werden hier mit dem Foerderkorb hinab "+
    "beziehungweise herauf gebracht. Du kannst auch einsteigen und die Fahrt in "+
    "die Tiefe des Bergs antreten. ") );
  AddDetail( ({ "berg" }),
    BS("Dieser Kessel ist umgeben von Felswaenden und im Westen schliesst die "+
    "Wehranlage sich an. ") );
  AddDetail( ({ "kessel", "plateau", "waende", "felswaende", "gipfeln" }),
    BS("Dieses Plateau mitten in den Bergen wird eingekesselt von steilen "+
    "Felswaenden die weit nach oben bis zu den Gipfeln fuehren. Nur im Westen "+
    "ersetzt die Wehranlage den Rand des Kessels. ") );
  AddDetail( ({ "wehranlage", "anlage", "festung" }),
    BS("Dazu solltest Du weiter gen Westen gehen. Von hier aus kann man nur wenig "+
    "erkennen.") );
  AddDetail( ({ "felsen", "fels" }),
    BS("Die steile Felswaende schliessen dieses Plateau ein und bilden dadurch "+
    "einen natuerlichen Kessel. Man muss sehr waghalsig sein um diese Waende "+
    "zu erklettern. ") );
  AddDetail( ({ "seile", "seil" }),
    BS("Dicke Seile laufen ueber die grosse Laufrolle und halten den "+
    "Foerderkorb. Sie sehen sehr stabil aus und verschwinden im Schacht. Weitere "+
    "Seile fuehren zum Tretrad und eine komplizierten Mechanik. ") );
  AddDetail( ({ "laufrolle", "rolle", "gestell" }),
    BS("Eine grosse Laufrolle aus Holz wurde mit einem hoelzernen Gestell "+
    "ueberhalb des Schachts angebracht. Die Seile des Foerderkorb laufen darueber. ") );
  AddDetail( ({ "schacht", "stollen", "lichtschacht" }),
    BS("Der Schacht fuehrt tief in den Berg, direkt zur Zwergenstadt Thumfels, "+
    "und nur mit dem Foerderkorb kommt man sicher hinab. ") );
  AddDetail( ({ "tretrad", "laufrad", "betrieb", "zwerge" }),
    BS("Im Tretrad sind sechs Zwerge die immer wenn der Foerderkorb unterwegs ist "+
    "kraeftig laufen muessen. Ueber eine komplizierte Mechanik wird damit die "+
    "Laufrolle und damit der Foerderkorb angetrieben. ") );
  AddDetail( ({ "mechanik", "seilzug", "technik" }),
    BS("Ueber eine komplizierte Mechanik wird von den sechs Zwergen im Tretrad die "+
    "Laufrolle und damit der Foerderkorb angetrieben. ") );
  AddDetail( ({ "foerderkorb", "korb" }),
    BS("Der Foerderkorb ist scheinbar staendig in Betrieb um Zwerge und Waren "+
    "hinab beziehungsweise herauf zu bringen. ") );
  AddDetail( ({ "tiefen", "tiefe", "schwaerze" }),
    BS("Wenn man den Schacht hinabblickt kann man nur tiefe Schwaerze erkennen. ") );
  AddDetail( ({ "bereiche", "bereich", "rand", "teil", "teils" }),
    BS("Du befindest Dich hier im oestlichen Bereich des Kessels. ") );
  AddDetail( ({ "zwergenreich", "reich" }),
    BS("Das ist hier schon der oberirdische Teil des Zwergenreichs. Tief im Berg "+
    "aber ist die eigentliche Zwergenstadt Thumfels. ") );
  AddDetail( ({ "zwergenstadt", "stadt", "thumfels" }),
    BS("Um zur Zwergenstadt zu gelangen muss man sich dem Foerderkorb anvertrauen.") );
  AddDetail( ({ "schotter", "steine" }),
    BS("Ganz normale kleine Steine wurden hier angeschuette und bilden den Boden."));
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich."));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddSound( ({ "wind" }),
    BS("Der Wind rauscht."));
  AddSmell( ({ "bergluft", "luft" }),
    BS("Hier herrscht besonders saubere und klare Luft. "));
  AddDetail( ({"holz", "kiefernholz"}),
    BS("Es scheint sich um Kiefernholz zu handeln."));

  AddExit( ({ "westen" }), ROOM+"serpweg_h5.lpc" );

/*
  AddDetail( ({"", ""}),
    BS(""));
*/
  AddItem( OBJ + "foerderkorb.lpc", REFRESH_NONE, 1 );
}

int check_i5()
{
	return 1;
}