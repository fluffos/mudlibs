// Kaserne
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Kaserne der Zwergenfestung" );
  SetProp( P_INT_LONG,
    BS("In dieser Kaserne sind die Unterkuenfte der Zwerge. Viele kurze Betten "+
    "stehen hier und dienen den Wachen und Arbeitern, die hier an der Oberflaeche "+
    "ihrem Tagewerk nachgehen als Unterkunft. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    BS("Einfache Holzdielen bilden den Boden. "));
  AddDetail( ({ "decke" }),
    BS("Ein hoelzerner Dachstuhl traegt das Giebeldach."));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Mauern wurden mit einem hellem Verputz verkleidet was dem Raum etwas "+
    "Waerme verleiht. Durch ein paar Fenster dringt Licht in den Raum." ));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "kaserne", "unterkuenfte", "unterkunft", "raum", "schlafsaal", "saal" }),
    BS("In dieser Kaserne sind die Unterkuenfte der Zwerge. Viele kurze Betten "+
    "stehen hier und dienen den Wachen und Arbeitern, die hier an der Oberflaeche "+
    "ihrem Tagewerk nachgehen als Unterkunft. "));
  AddDetail( ({ "betten", "bett" }),
    BS("Vor jedem Bett steht eine kleine Truhe die den Zwergen zum Verstauen "+
    "ihrer persoenlichen Habseligkeiten dient. Die meisten sind gerade leer, "+
    "aber ein paar Zwerge schlafen hier auch gerade, warscheinlich die Nachtschicht "+
    "der Wachen. "));
  AddDetail( ({ "truhen", "truhe"}),
    BS("An jedem Bett steht solch eine kleine Truhe. Sie enthalten wohl die "+
    "persoenlichen Habseligkeiten der wachen und Arbeiter. Sicher sind sie "+
    "alle verschlossen. "));
  AddDetail( ({ "habseligkeiten" }),
    BS("Die Truhen sind alle verschlossen."));
  AddDetail( ({ "nachtschicht" }),
    BS("Die wenigen Zwerge die hier am Tage schlafen sind wohl die "+
    "Nachtschicht der Wachen."));
  AddDetail( ({ "holzdielen", "holzdiele", "dielen", "diele" }),
    BS("Einfach Holzdielen bilden den Boden. Du kannst nichts besonderes "+
    "daran erkennen."));
  AddDetail( ({ "dachstuhl", "dach", "giebeldach", "giebel", "steinschlag" }),
    BS("Das Giebeldach mit seinem hoelzernen Dachstuhl wird einem Steinschlag kaum "+
    "gewachsen sein. Die Zwerge scheinen aber nicht damit zu rechnen. "));
  AddDetail( ({ "mauern", "mauer", "gemaeuer", "haus" }),
    BS("Die Kaserne ist ein grosses gemauertes Haus und besteht im Grunde nur aus "+
    "den grossen Schlafsaal mit den vielen kurzen Betten. Weitere Mauern sind "+
    "nicht eingebracht."));
  AddDetail( ({ "tagewerk", "tag" }),
    BS("Die Wachen haben den ganzen Tag nichts weiter zu tun als auf der Wehranlage "+
    "nach Gefahren Ausschau zu halten. Die Kranarbeiter hingegen muessen entweder im "+
    "Laufrad den Foerderkorb antreiben oder die Waren aus dem Lagerhaus in den "+
    "Foerderkorb bringen."));
  AddDetail( ({ "verputz", "schicht" }),
    BS("Die Waende sind mit einer hellen Schicht verputzt. Dadurch wirkt der "+
    "Schlafsaal der Kaserne viel freundlicher."));
  AddDetail( ({ "fenster" }),
    BS("Durch die wenigen Fenster dringt genuegend Licht herein."));
  AddDetail( ({ "licht" }),
    BS("Das Licht, das durch die wenigen Fenster hereinkommt, reicht um sich "+
    "im Schlafsaal zurecht zu finden. "));
  AddDetail( ({"arbeiter", "kranarbeiter", "wachen", "zwerge"}),
    BS("Die hier schlafenden Zwerge sind wohl die Nachtschicht."));
  AddDetail( ({"foerderkorb"}),
    BS("Hier wirst Du keinen Foerderkorb finden."));
  AddDetail( ({"gefahren", "gefahr", "grunde", "verstauen", "ausschau"}),
    BS("Langsam laeufst Du Gefahr ueber eine Scriptfalle zu stolpern."));
  AddDetail( ({"lagerhaus", "laufrad", "waren"}),
    BS("Du befindest Dich hier in der Kaserne. Schau dich lieber woanders dafuer um."));
  AddDetail( ({"oberflaeche", "wehranlage"}),
    BS("Du befindest dich hier in der oberirdischen Wehranlage der Zwergenstadt Thumfels."));
  AddDetail( ({"waerme"}),
    BS("Durch den hellen Verputz wirkt dieser grosse Raum etwas waermer."));
  AddDetail( ({ "zwergenstadt", "stadt", "thumfels", "berg" }),
    BS("Tief im Berg liegt die eigentliche Zwergenstadt Thumfels. ") );
  AddSpecialDetail( ({ "scriptfalle" }), "unt_scriptfalle" );

/*
  AddDetail( ({"", ""}),
    BS(""));
*/
  AddExit( ({ "norden" }), ROOM+"serpweg_h5.lpc" );
}


string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 45+random(60), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}
