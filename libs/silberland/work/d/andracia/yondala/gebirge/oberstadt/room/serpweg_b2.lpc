#include "../def.h"

inherit ROOM + "serpweg_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Nordwesten erkennen."));*/

  AddExit( ({ "nordwestunten" }), ROOM+"serpweg_a1.lpc" );
  AddExit( ({ "suedoben" }), ROOM+"serpweg_b3.lpc" );

  AddExit( ({ "nordwesten" }), ROOM+"serpweg_a1.lpc" );
  AddExit( ({ "sueden" }), ROOM+"serpweg_b3.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "nordwesten"}) );
}

