#include "../def.h"

inherit ROOM + "serpweg_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Die Baumgrenze ist schon recht nah."));

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 11, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddExit( ({ "suedwestunten" }), ROOM+"serpweg_c6.lpc" );
  AddExit( ({ "nordoben" }), ROOM+"serpweg_d4.lpc" );

  AddExit( ({ "suedwesten" }), ROOM+"serpweg_c6.lpc" );
  AddExit( ({ "norden" }), ROOM+"serpweg_d4.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedwesten", "norden"}) );
}

