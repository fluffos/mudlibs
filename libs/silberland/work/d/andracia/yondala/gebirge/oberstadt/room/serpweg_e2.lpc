#include "../def.h"

inherit ROOM + "serpweg_kahl_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Hier ist eine Kehre der Serpentine."));

  AddDetail( ({"kehre", "kehren", "richtung"}),
     BS("Wenn der Weg umkehrt und nun in die andere Richtung den Hang hinauf "+
     "beziehungsweise hinunter fuehrt so nennt man diese Stellen Kehren.") );
  AddDetail( ({"stellen", "stelle"}),
     BS("Diese Stelle ist eine Kehre der Serpentine.") );

  AddExit( ({ "suedwestunten" }), ROOM+"serpweg_d3.lpc" );
  AddExit( ({ "suedostoben" }), ROOM+"serpweg_f3.lpc" );

  AddExit( ({ "suedwesten" }), ROOM+"serpweg_d3.lpc" );
  AddExit( ({ "suedosten" }), ROOM+"serpweg_f3.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedosten", "suedwesten"}) );
}

