#include "../def.h"

inherit ROOM + "serpweg_kahl_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Hier ist eine Kehre der Serpentine."));*/

  AddExit( ({ "suedoben" }), ROOM+"serpweg_f5.lpc" );
  AddExit( ({ "nordunten" }), ROOM+"serpweg_f3.lpc" );

  AddExit( ({ "sueden" }), ROOM+"serpweg_f5.lpc" );
  AddExit( ({ "norden" }), ROOM+"serpweg_f3.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "norden"}) );
}

