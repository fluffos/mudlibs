#include "../def.h"

inherit "std/room";

#include <properties.h>
//serpentine wegs winkel bergwetter
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Serpentinenweg" );
  SetProp( P_INT_LONG,
     BS("Dieser Weg windet sich in Schlangenlinien den Berghang entlang. "+
     "Dadurch wird der Weg zwar sehr lang aber die Steigung des Wegs wird "+
     "klein und damit fuer alle begehbar. Man muss nicht klettern und auch "+
     "Lasttiere koennen hier bequem den Berg erklimmen. Baeume saeumen den "+
     "steinigen Pfad. Vorallem Kiefern wachsen hier in diesem rauhen Klima. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "boden", "weg", "serpentinenweg", "pfad" }),
    BS("Du befindest Dich auf einem steinigen Serpentinenweg."));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddDetail( ({ "wand", "fels", "felsen", "gestein", "steine", "berghang", "berg" }),
    BS("Der Berghang ist hier noch bewaldet. Weiter oben scheint die Baumgrenze "+
    "zu sein. Zwischen den Wurzeln der Baeume schauen oft blanke Felsen heraus. "+
    "Rechts und links des Wegs faellt beziehungsweise steigt der Hang in einem "+
    "starken Winkel. Zum Glueck ist hier dieser Serpentinenweg um den Berg zu erklimmen. "));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind zwischen den Felsen pfeifen."));
  AddSound( ({ "wind" }),
    BS("Leise pfeift der Wind zwischen den Baumwipfeln."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));
  AddSmell( ({ "kiefern" }),
    BS("Der Duft der Kiefern bereichert die saubere, klare Luft. "));
  AddSmell( ({ "tannen" }),
    BS("Die Tannen geben der sauberen, klaren Luft ihren besonderen Duft. "));
  AddSmell( ({"duft", "geruch", "bergluft", "luft"}),
    BS("Der frische Geruch von Kiefern und Tannen liegt in der kuehlen Luft"));

  AddDetail( ({ "schlangenlinien", "schlangenlinie", "linien", "linie", "serpentine", "serpentinen"}),
    BS("Der Weg beschreibt Schlangenlinien. Eine Serpentine eben."));
  AddDetail( ({ "steigung", "hang", "winkel" }),
    BS("Rechts und links des Wegs faellt beziehungsweise steigt der Hang in einem "+
    "starken Winkel. Zum Glueck ist hier dieser Serpentinenweg zum erklimmen des "+
    "Bergs. "));
  AddDetail( ({ "lasttiere" }),
    BS("Da man hier nicht klettern muss um den Berg zu erklimmen, koennen "+
    "auch Lasttiere diese Serpentinen hochlaufen. Es scheinen gerade aber keine "+ 
    "unterwegs zu sein. "));
  AddDetail( ({ "baeume", "baum", "kiefern", "kiefernwald", "wald", "tannen" }),
    BS("Kiefern und Tannen trotzen dem rauhen Klima hier im Bergland. Sie wachsen am Hang "+
    "und versperren Dir die Aussicht. "));
  AddDetail( ({ "klima", "bergwetter", "wetter" }),
    BS("Es ist hier etwas kuehl und das Bergwetter kann schnell umschlagen. "));
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich."));
  AddDetail( ({ "baumgrenze" }),
    BS("Hier wachsen die Baume noch. Weiter oben ist das Klima zu rauh fuer die Baeume."));
  AddDetail( ({ "wurzeln" }),
    BS("Kraeftige Wurzeln verankern die Baeume am steilen Hang. Sie krallen "+
    "sich zwischen den blanken Felsen fest und sorgen dafuer dass der Berghang "+
    "nicht ins Rutschen kommt."));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddDetail( ({ "aussicht", "sicht", "umgebung", "blick" }),
    BS("Zwischen den Baumwipfeln kannst Du hin und wieder die naehere Umgebung sehen. "+
    "Im Nordwesten kann man den Marmorturm noch erkennen waehrend im Norden sich ein "+
    "riesiger Wald erstreckt. "));
  AddDetail( ({"baumwipfel", "wipfel", "baumwipfeln", "wipfeln", "baumkronen", "baumkrone"}),
    BS("Die Baumkronen verdecken nur teilweise die Aussicht nach Nordwesten. "));
  AddDetail( ({"bergland", "landschaft", "umgebung", "berghaenge", "berghang"}),
    BS("Die steilen, bewaldeten Berghaenge bilden hier die Umgebung."));
  AddDetail( ({"duft", "geruch"}),
    BS("Versuch doch sowas lieber zu riechen."));
  AddDetail( ({"luft", "bergluft"}),
    BS("Die Luft ist hier etwas huehler."));
  AddDetail( ({"turm", "marmorturm"}),
    BS("Hin und wieder kann man den einen Blick zwischen den Baumwipfeln hindurch "+
    "auf den Marmorturm erhaschen."));
    
/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 


}

