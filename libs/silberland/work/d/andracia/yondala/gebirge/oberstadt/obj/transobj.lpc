#include "../def.h"

inherit "std/thing";

#include <properties.h>

int was, det;
int menge = random(4)+3;
string apfel = "/d/huegelland/yason/zwirbelstein/obj/obst_apfel.lpc";
string birne = "/d/huegelland/yason/zwirbelstein/obj/obst_birne.lpc";
string mehl = "/d/huegelland/yason/zwirbelstein/obj/kuchen_mehl.lpc";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  switch( was=random(3) ) {
  	case 2:
      SetProp(P_SHORT, "Eine Kiste");
      SetProp(P_LONG,
        "Eine grosse hoelzerne Kiste." );
      switch( det=random(3) ) {
      	case 2:
      		SetProp(P_INFO, "Es befinden sich scheinbar Birnen in der Kiste.");
          SetProp(P_WEIGHT, 20000);
          SetProp(P_VALUE, 820);
          break;
        case 1:
      		SetProp(P_INFO, "In dieser Kiste befindet sich geraeucherter Schinken");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 1350);
          break;
        default:
      		SetProp(P_INFO, "Geraeucherter Fisch scheint in der Kiste zu sein.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 1080);
          break;
      }
      SetProp(P_NAME, "Kiste");
      SetProp(P_GENDER, FEMALE);
      AddId("kiste");
      SetProp(P_MATERIAL, MAT_WOOD );
      //AddCmd( "zerschlage" , "cmd_zerschlagen");
      break;
  	case 1:
      SetProp(P_SHORT, "Ein Fass");
      SetProp(P_LONG,
        "Ein schweres rundes Fass." );
      switch( det=random(3) ) {
      	case 2:
      		SetProp(P_INFO, "Es befinden sich wohl Wein in diesem Fass.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 1920);
          break;
        case 1:
      		SetProp(P_INFO, "Das Fass scheint mit Bier gefuellt zu sein.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 1250);
          break;
        default:
      		SetProp(P_INFO, "Dieses Fass wurde wohl mit Tran gefuellt.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 1590);
          break;
      }
      SetProp(P_NAME, "Fass");
      SetProp(P_GENDER, NEUTER);
      AddId("fass");
      SetProp(P_MATERIAL, MAT_WOOD );
      //AddCmd( "zerschlage" , "cmd_zerschlagen");
      break;
  	default:
      SetProp(P_SHORT, "Ein voller Sack");
      SetProp(P_LONG,
        "Ein prall gefuellter Sack." );
      switch( det=random(3) ) {
      	case 2:
      		SetProp(P_INFO, "Es befinden sich scheinbar Aepfel in diesem Sack.");
          SetProp(P_WEIGHT, 20000);
          SetProp(P_VALUE, 790);
          break;
        case 1:
      		SetProp(P_INFO, "Dieser Sack ist mit Mehl gefuellt.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 880);
          break;
        default:
      		SetProp(P_INFO, "In diesem Sack befinden sich Kartoffeln.");
          SetProp(P_WEIGHT, 21000);
          SetProp(P_VALUE, 780);
          break;
      }
      SetProp(P_NAME, "Sack");
      SetProp(P_GENDER, MALE);
      AddId("sack");
      SetProp(P_MATERIAL, MAT_CLOTH );
      //AddCmd( ({"greif", "greife"}) , "cmd_greifen");
      break;
  }
  AddId("\ntransobj");

  SetProp(P_NOBUY, 0);

}

int cmd_greifen(string str) {
	object ob;
	
	notify_fail("Wo willst du hineingreifen?\n");
	if( str != "in sack" ) return 0;
	if( environment(TO) != environment(TP) ) return 0;
  switch( det ) {
  	case 2:
  		menge--;
     	write(BS("Du greifst in den Sack und holst dir einen Apfel heraus."));
    	say(BS( TP->name()+" greift in den Sack und holt sich einen Apfel heraus."));
   		ob=clone_object( apfel );
   		ob->move( TP , M_SILENT );
   		if(menge==0) {
      	write(BS("Der Sack ist nun leer."));
   		  ob=clone_object(OBJ+"sack.lpc");
   		  ob->move( environment(TO), M_SILENT);
       	TO->remove();
      } 	
  		break;
  	case 1:
  		menge--;
     	write(BS("Du greifst in den Sack und holst dir ein bischen Mehl heraus."));
    	say(BS( TP->name()+" greift in den Sack und holt sich ein bischen Mehl heraus."));
   		ob=clone_object( mehl );
   		ob->move( TP , M_SILENT );
   		if(menge==0) {
      	write(BS("Der Sack ist nun leer."));
   		  ob=clone_object(OBJ+"sack.lpc");
   		  ob->move( environment(TO), M_SILENT);
       	TO->remove();
      } 	
  		break;
  	default:
  		menge--;
     	write(BS("Du greifst in den Sack und holst dir eine Kartoffel heraus."));
    	say(BS( TP->name()+" greift in den Sack und holt sich eine Kartoffel heraus."));
   		ob=clone_object( OBJ+"kartoffel.lpc" );
   		ob->move( TP , M_SILENT );
   		if(menge==0) {
      	write(BS("Der Sack ist nun leer."));
   		  ob=clone_object(OBJ+"sack.lpc");
   		  ob->move( environment(TO), M_SILENT);
       	TO->remove();
      } 	
  		break;
  }
  return 1;
}

int cmd_zerschlagen(string str) {
	object ob;
	
	notify_fail("Was willst du zerschlagen?\n");
	if( !id(str) ) return 0;
	if( environment(TO) != environment(TP) ) return 0;
  switch( was ) {
    case 2:
  		switch( det ) {
  			case 2:
        	write(BS("Du zerschlaegst die Kiste und die Birnen, die darin waren, "+
        	  "kullern ueber den Boden."));
        	say(BS( TP->name()+" zerschlaegt eine Kiste und einige Birnen kullern ueber "+
        	  "den Boden."));
        	for(; menge!=0; menge-- ) {
        		ob=clone_object( birne );
        		ob->move( environment(TO) , M_SILENT );
        	}	
        	TO->remove();
  				break;
  			case 1:
        	write(BS("Du zerschlaegst die Kiste und die Schinken, die darin waren, "+
        	  "liegen nun ueber den Boden verstreut."));
        	say(BS( TP->name()+" zerschlaegt eine Kiste und einige Schinken fallen "+
        	  "heraus."));
        	for(menge=random(2)+2; menge!=0; menge-- ) {
        		ob=clone_object( OBJ+"schinken.lpc" );
        		ob->move( environment(TO) , M_SILENT );
        	}	
        	TO->remove();
  				break;
  			default:
        	write(BS("Du zerschlaegst die Kiste und die Fische, die darin waren, "+
        	  "liegen nun wild auf dem Boden verstreut."));
        	say(BS( TP->name()+" zerschlaegt eine Kiste und geraeucherte Fische fallen "+
        	  "den Boden."));
        	for(; menge!=0; menge-- ) {
        		ob=clone_object( OBJ+"fisch.lpc" );
        		ob->move( environment(TO) , M_SILENT );
        	}	
        	TO->remove();
  				break;
  		}
    	break;
    case 1:
    	write("Du zerschlaegst das Fass und der Inhalt ergiesst sich ueber den Boden. \n  "+
    	  "Was fuer eine Sauerei. \n");
    	say(BS( TP->name()+" zerschlaegt ein Fass und der Inhalt ergiesst sich ueber den "+
    	  "Boden. Was fuer eine Sauerei."));
    	TO->remove();
    	break;
  }
  return 1;
}