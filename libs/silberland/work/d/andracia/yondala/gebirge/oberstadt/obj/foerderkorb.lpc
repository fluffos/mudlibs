#include "../def.h"

inherit "std/transport";

#include <properties.h>

string BEREICH = "/d/" REGION "/" MAGIERNAME "/";

void create() 
{
	// if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "Im Foerderkorb" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Foerderkorb. Eine Konstruktion aus Metall und Holz, "+
    "befestigt an mehreren Seilen. Er dient zum Transport zwischen der "+
    "Zwergenstadt Thumfels und der oberirdischen Festungsanlage. ") );
  SetProp( P_SHORT, "Foerderkorb" );
  SetProp( P_LONG, BS(
    "Ein Foerderkorb. Eine Konstruktion aus Metall und Holz, "+
    "befestigt an mehreren Seilen. Er dient zum Transport zwischen der "+
    "Zwergenstadt Thumfels und der oberirdischen Festungsanlage.") );
  SetProp( P_NAME, "Foerderkorb" );
  AddId( ({ "foerderkorb", "korb" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_LIGHT, 1 );
  SetProp( P_TRANSPARENT, 1 );

  AddDetail( ({"foerderkorb", "kaefig"}), BS(
    "Ein Foerderkorb. Eine Konstruktion aus Metall und Holz, "+
    "befestigt an mehreren Seilen. Er dient zum Transport zwischen der "+
    "Zwergenstadt Thumfels und der oberirdischen Festungsanlage. ") );
  AddDetail( ({"konstruktion", "metall", "holz", "seile", "seil", "boden"}),
    BS("Die Konstruktion des Foerderkorbs besteht aus einem "+
    "metallverstaerktem Kaefig der der an den Seilen des Foerderturm "+
    "befestigt ist. Eine Laterne dient als Lichtquelle wenn man den "+
    "dunklen Schacht befaehrt. ") );
  AddDetail( ({"festung", "festungsanlage", "anlage", "wehranlage"}),
    BS("Der oberirdische Zugang zur Zwergenstadt wird von einer "+
    "Wehranlage beschuezt. ") );
  AddDetail( ({"zwergenstadt", "stadt", "thumfels"}),
    BS("Tief im Berg liegt die Zwergenstadt Thumfels. Hier werden "+
    "viele Waffen und Ruestungen von zwergischen Handwerkern geschmiedet. ") );
  AddDetail( ({"laterne", "lichtquelle"}),
    BS("Eine normale Laterne die hier befestig ist laesst einen die "+
    "Fahrt in die Tiefe nicht im Dunklen durchstehen. ") );
  AddDetail( ({"berg"}),
    BS("Dieser Foerderkorb pendelt von der Oberflaeche bis tief in den Berg "+
    "zur Zwergenstadt Thumfels."));
  AddDetail( ({"foerderturm", "himmel"}),
    BS("Dazu solltest Du an der Oberflaeche aussteigen."));
  AddSpecialDetail( ({"fahrt", "schacht", "dunklen", "tiefe", "transport", "zugang", "oberflaeche"}), "unt_fahrt" );
  AddDetail( ({"waffen", "ruestungen", "handwerkern"}),
    BS("Die Zwerge sind beruehmt fuer ihre besonders guten "+
    "Waffen und Ruestungen. "));

/*
  AddDetail( ({"", ""}),
    BS(""));
*/

  SetProp( P_DEPARTMSG, ({
    "Der Foerderkorb setzt sich in Bewegung.\n", 
    "Der Foerderkorb setzt sich in Bewegung.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Der Foerderkorb kommt @@QueryArrived@@ an.\n",
    "Der Foerderkorb kommt aus dem Schacht.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "steigt in den Foerderkorb",
    "steigt in den Foerderkorb"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere in der Foerderkorb",
    "hat keinen Platz mehr im Foerderkorb"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaesst den Foerderkorb",
    "verlaesst den Foerderkorb"}) );
  SetProp( P_LEAVEFAIL, ({
    "Der Foerderkorb befindet sich aber noch mitten im Schacht",
    "schaut den Schacht hinunter"}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt", "besteige", "besteig" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  AddRoute( ROOM+"serpweg_i5", 30, 1, "an der Oberflaeche", 
     ({"oben", "oberflaeche"}), "nach oben" );
  AddMsg( "Der Foerderkorb nimmt langsam fahrt in die Tiefe auf.\n", 30 );
  AddMsg( "Der Foerderkorb kommt dem Ende des Schachts naeher.\n", 10 );
  AddFun( "retard_ausladen", 1);
  AddRoute( BEREICH+"thumfels/room/thumfels_c6", 30, 1, "in der Tiefe",
     ({"unten", "thumfels", "unterwelt", "zwergenstadt", "tiefe"}), "nach Thumfels" );
  AddMsg( "Der Foerderkorb wird langsam hochgezogen.\n", 30 );
  AddMsg( "Man kann schon das Tageslicht am oberen Ende des Schachts sehen.\n", 10 );

  AddFun( "retard_einladen", 1);

 // SHIPD->AddHarbour(TO, ROOM+"serpweg_i5");
 //	SHIPD->AddHarbour(TO, BEREICH+"thumfels/room/thumfels_c6");

  Start();
}

retard_ausladen()
{
  call_out("obj_ausladen",4);
}

retard_einladen()
{
  call_out("obj_einladen",4);
}

string unt_fahrt(string str)
{
	if( QueryArrived() == 0 )
		return BS("Du befindest dich unterwegs mit dem Foerderkorb. Die groben Felswaende "+
		  "des Schachts ziehen am Foerderkorb vorbei und die Laterne wackelt hin und her. "); 
	return BS("Gleich geht's los und der Foerderkorb faehrt durch den Schacht. "); 	  
}

void obj_einladen()
{
  object traeger, ding;
  if( !(traeger=present("\ntraeger",environment(TO) )) ) return;
  if( !(ding=present("\ntransobj", environment(TO) )) ) return;
  if( !(present("\ntransobj 4", TO)) ) {
    ding->move(TO,M_PUT,
      traeger->name()+" legt "+ding->name(WEN)+" in den Foerderkorb.");
    tell_room( ENV(TO) , traeger->Name()+" legt "+ding->name(WEN)+" in den Foerderkorb. \n");
    tell_room( TO , traeger->Name()+" legt "+ding->name(WEN)+" in den Foerderkorb. \n");
    call_out("obj_einladen", 2);
  }
  traeger->retard_new_obj(); 
  return;
}

void obj_ausladen()
{
  object traeger, ding;
  if( !(traeger=present("\ntraeger",environment(TO) )) ) return;
  if( !(ding=present("\ntransobj", TO)) ) return;
  if( !(present("\ntransobj", traeger))) {
    ding->move(traeger,M_GET,
      traeger->name()+" nimmt "+ding->name(WEN, 0)+" aus dem Foerderkorb.");
    tell_room( ENV(TO) , traeger->Name()+" nimmt "+ding->name(WEN)+" aus dem Foerderkorb. \n");
    tell_room( TO , traeger->Name()+" nimmt "+ding->name(WEN)+" aus dem Foerderkorb. \n");
    traeger->deliver_obj();
    call_out("obj_ausladen", 2);
  }
  return;
}

rein(str)
{
  notify_fail("Was willst Du besteigen?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( BEREICH+"thumfels/room/thumfels_c6.lpc", "???"));
    catch(call_other( ROOM+"serpweg_i5.lpc", "???"));
  }
}
