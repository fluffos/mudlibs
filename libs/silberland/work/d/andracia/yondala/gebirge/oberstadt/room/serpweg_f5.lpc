#include "../def.h"

inherit ROOM + "serpweg_kahl_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Du stehst hier vor einer Bergfestung mit patroullierenden Zwergen. "+
     "Von unten ist diese Anlage nicht zu erkennen. Erst wenn man hier oben "+
     "direkt vor dem Tor angekommen ist kann man alles erblicken. "));

  AddDetail( ({"bergfestung", "festung", "anlage", "zwergenfestung"}),
    BS("Rechts und links des Tors erstreckt sich ein Mauerwerk aus groben "+
    "Felsbloecken mit einer Zinnenreihe auf ihrer Oberkante. Hinter den Zinnen "+
    "kann man hin und wieder partoullierende Zwerge sehen.") );
  AddDetail( ({"zwerge", "verteidiger"}),
    BS("Da man patroullierende Zwerge hinter den Zinnen erkennen kann scheint "+
    "dies eine Zwergenfestung zu sein. Da das Tor offensteht kannst Du "+
    "eintreten und den Zwergen einen Besuch abstatten.") );
  AddDetail( ({"tor"}),
    BS("Das Tor steht offen und du kannst die Zwergenfestung betreten.") );
  AddDetail( ({"felsblock", "felsbloecke", "felsklotz", "felskloetze" }),
    BS("Die Mauer der Festung besteht aus groben Felsen die gekonnt miteinander "+
    "verfugt sind, man kann keinen Moertel entdecken.") );
  AddDetail( ({"mauer", "mauerwerk", "festungsmauer"}),
    BS("Die Mauer besteht aus groben Felsbloecken mit schmalen Fugen dazwischen. "+
    "scheinbar waren die Baumeister dieser Festung patente Steinmetze. ") );
  AddDetail( ({"zinnen", "zinnenreihe", "oberkante", "zinne"}),
    BS("An der Oberkante der Festungsmauer wurden Zinnen aufgesetzt hinter denen "+
    "sich die Verteidiger verschanzen koennen. Hin und wieder kann man "+
    "zwischen den Zinnen patroullierende Zwerge sehen. ") );
  AddDetail( ({"fugen", "fuge", "moertel"}),
    BS("Ganz schmale Fugen sind zwischen den groben Felskloetzen zu erkennen. Ob "+
    "aber Moertel die Steine zusammenhaelt kann man dadurch nicht mehr sehen. "+
    "Das muessen patente Steinmetze gewesen sein die solch ein Mauerwerk "+
    "erzeugen konnten. ") );
  AddDetail( ({"baumeister", "steinmetze", "handwerk"}),
    BS("Die schmalen Fugen lassen darauf schliessen dass die Baumeister dieser "+
    "Festung ihr Handwerk sehr gut konnten. ") );

/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 


  AddExit( ({ "nordunten" }), ROOM+"serpweg_f4.lpc" );
  AddExit( ({ "osten" }), ROOM+"serpweg_g5.lpc" );

  AddExit( ({ "norden" }), ROOM+"serpweg_f4.lpc" );
  SetProp( P_HIDE_EXITS, ({"norden"}) );
}

