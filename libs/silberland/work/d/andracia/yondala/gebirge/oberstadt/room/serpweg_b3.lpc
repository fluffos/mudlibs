#include "../def.h"

inherit ROOM + "serpweg_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /*SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Nordwesten erkennen."));*/

  AddExit( ({ "nordunten" }), ROOM+"serpweg_b2.lpc" );
  AddExit( ({ "suedoben" }), ROOM+"serpweg_b4.lpc" );

  AddExit( ({ "norden" }), ROOM+"serpweg_b2.lpc" );
  AddExit( ({ "sueden" }), ROOM+"serpweg_b4.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "norden"}) );
}

