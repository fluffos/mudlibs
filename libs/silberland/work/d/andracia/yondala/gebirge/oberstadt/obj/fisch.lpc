inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Fisch");
  SetProp(P_LONG,
     BS("Dieser Fisch wurde ausgenommen, entgraetet und gepökelt. Er schmeckt sicher vorzueglich. ")
     );
  
  AddId( ({"fisch", "\nfisch"}) );
  SetProp(P_NAME, "Fisch");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 12,12}),
        F_SOAK: 6,
        F_MSG: "Du isst den gepoekelten Fisch.",
        F_MSG_ROOM: "isst einen gepoekelten Fisch."]) );

}