inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Schinken");
  SetProp(P_LONG,
     BS("Dieser geraeucherte Schinken duftet herrlich. Er schmeckt sicher vorzueglich. ")
     );
  
  AddId( ({"schinken", "\nschinken"}) );
  SetProp(P_NAME, "Schinken");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 15,10}),
        F_SOAK: 6,
        F_MSG: "Du isst einen geraeucherten Schinken.",
        F_MSG_ROOM: "isst einen geraeucherten Schinken."]) );

}