// Zeughaus
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Lager der Zwergenfestung" );
  SetProp( P_INT_LONG,
    BS("Dies scheint ein Lager zu sein. Viele Faesser, Kisten und Saecke sind "+
    "hier gestapelt. Es handelt sich wohl um Lebensmittel die hinab zur Stadt "+
    "gebracht werden sollen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus einfachen Holzdielen. Sie sind schon sehr abgetreten, "+
    "scheinbar ist der Umschlag von Waren hier recht gross. "));
  AddDetail( ({ "decke" }),
    BS("Ein hoelzerner Dachstuhl traegt das Giebeldach."));
  AddDetail( ({ "waende", "wand" }),
    BS("Gemauerte Waende fassen den grossen Lagerraum ein. "));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "lager", "lagerraum", "raum" }),
    BS("Viele Faesser, Kisten und Saecke sind hier gestapelt. Es handelt sich "+
    "wohl um Lebensmittel die hinab zur Stadt gebracht werden sollen. "));
  AddDetail( ({ "faesser", "kisten", "saecke", "lebensmittel", "waren" }),
    BS("In den hier gestapelten Faessern, Kisten und Saecken scheinen Lebensmittel "+
    "fuer die Zwergenstadt gelagert zu werden. "));
  AddDetail( ({ "holz" }),
    BS("Der Dachstuhl und die Dielen bestehen aus normalem Holz."));
  AddDetail( ({ "holzdielen", "dielen" }),
    BS("Die Holzdielen des Bodens sind schon stark ausgetreten. Scheinbar werden "+
    "hier viele Waren umgeschlagen. Die Zwergenstadt scheint vorallem Lebensmittel "+
    "zu benoetigen. "));
  AddDetail( ({ "dachstuhl", "dach", "giebeldach", "giebel", "steinschlag" }),
    BS("Das Giebeldach mit seinem hoelzernen Dachstuhl wird einem Steinschlag kaum "+
    "gewachsen sein. Die Zwerge scheinen aber nicht damit zu rechnen. "));
  AddDetail( ({ "umschlag", "handel" }),
    BS("Viele Lebensmittel werden hier hinunter in die Stadt gebracht. Die "+
    "Holzdielen des Bodens sind schon ganz ausgetreten."));
  AddDetail( ({ "waren" }),
    BS("Vorallem Lebensmittel werden hier gelagert. Die zwergische Ruestungsschmiede "+
    "mit ihren Waffen hat ihren Verkauf wohl tief im Berg. "));
  AddDetail( ({ "ruestungsschmiede", "ruestungsschmied", "waffenschmiede", 
                "waffenschmied", "schmiede", "schmied", "waffen", "verkauf" }),
    BS("Das wirst Du wohl tief im Berg in der Zwergenstadt erst finden."));
  AddDetail( ({ "zwergenstadt", "stadt", "thumfels", "berg" }),
    BS("Tief im Berg liegt die Zwergenstadt Thumfels. Hier lagern nur Lebensmittel. ") );

/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 
  AddCmd( ({"nimm","nehme"}), "get_etwas");

  AddExit( ({ "sueden" }), ROOM+"serpweg_h5.lpc" );
  AddItem( NPC+"zwergenarbeiter_oben.lpc", REFRESH_DESTRUCT );
}

int check_h4()
{
	return 1;
}

int get_etwas(string str)
{
  if(str!="fass" && str!="kiste" && str!="sack" && str!="ware") return 0;
  write("Du laesst die Waren lieber an ihrem Platz.\n");
  return 1;
}
  