// Zwergenwache
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("\nzwache")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zwergenwache");
  SetProp(P_LONG,
    "Dieser stattliche Zwerg ist stark geruestet und verfolgt mit grimmiger Miene "+
    "seinen Wachdienst. Er wird auf alle Hilferufe in seiner Hoerweite reagieren "+
    "und allen anderen Zwergen zu Hilfe eilen.");
  SetProp(P_NAME, "Zwergenwache");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zwerg", "wache", "zwergenwache", "\nzwache", "\nzwerg"}));
//  set_living_name("");

  create_default_npc(26);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+31+random(30) );
  SetProp(P_RACE, "Zwerg"); //dwarf?
  SetProp(P_SIZE, 115+random(15)+random(15)+random(15));
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 1300);
  SetProp(P_MAX_HANDS, 2);
 /* SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );*/
  SetProp(P_MSGIN, "stapft heran");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ({ROOM+"serpweg_h", ROOM+"serpweg_g"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM+"serpweg_g4");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Zwergenwache");
  SetProp(P_KILL_MSG, "Leg dich nicht mit Zwergen an!");

  SetProp(P_LOG_INFO, "missing_answers");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Zwergenwache will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Zwergenwache schaut sich mistrauisch um.\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );
/*
  SUID;
  CLONEME(WEAPON "" );
  command("zuecke waffe");
  CLONEME(ARMOUR "" );
  command("trage alles");
*/
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(3) == 0)
  {
    tell_room(environment(TO), TO->Name()+" ruft laut: \"HILFE!\" .\n");
    walk_mapping(environment(TO)->QueryProp(P_EXITS), "ruf_hilfe", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_hilfe(string richtung, string strpfad)
{
  object ob, pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
  	{
      call_other(pfad,"???",0);
      return;
    }
  if( !ob=present("\nzwache", pfad) ) return;
  if( ob->InFight() ) return;
  tell_room(environment(ob), ob->Name()+" ruft laut: \"Ich eile zur Hilfe!\" .\n");
  //tell_room(environment(TO), ob->Name()+" reagiert auf den Hilferuf und kommt "+TO->name(WEM)+" zu Hilfe. \n ");
  ob->move(environment(TO), M_GO, "",
    "reagiert auf den Hilferuf von "+TO->name(), 
    "kommt "+TO->name(WEM)+" zu Hilfe" );
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
