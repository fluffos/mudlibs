#include "../def.h"

inherit ROOM + "serpweg_kahl_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Die Baumgrenze ist schon recht nah."));

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_MOUNTAIN]) );
  	
/*
  AddDetail( ({"", ""}),
    BS(""));
*/

  AddExit( ({ "nordostoben" }), ROOM+"serpweg_e2.lpc" );
  AddExit( ({ "suedunten" }), ROOM+"serpweg_d4.lpc" );

  AddExit( ({ "nordosten" }), ROOM+"serpweg_e2.lpc" );
  AddExit( ({ "sueden" }), ROOM+"serpweg_d4.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "nordosten"}) );
}

