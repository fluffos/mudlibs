#include "../def.h"

inherit ROOM + "serpweg_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
     BS("Am Fusse des Bergs kannst Du eine Kreuzung im Nordwesten erkennen."));

  AddDetail( ({ "kreuzung", "nordwesten" }),
    BS("Im Nordwesten liegt eine Kreuzung. "));

  AddExit( ({ "nordwesten" }), KREUZUNG_05 );
  AddExit( ({ "suedostoben" }), ROOM+"serpweg_b2.lpc" );

  AddExit( ({ "suedosten" }), ROOM+"serpweg_b2.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedosten"}) );
}

