#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eingang der Zwergenfestung" );
  SetProp( P_INT_LONG,
     BS("Du stehst direkt hinter dem Eingangstor der Zwergenfestung. Nach Norden "+
     "und Sueden fuehren hier Treppen an der Innenseite des breiten Wehrgangs "+
     "hinauf. Im Osten ist ein kleiner Platz zwischen den Gebaeuden die hier "+
     "stehen. Durch das schwere Tor im Westen kann man die Zwergenfestung verlassen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "untergrund", "grund" }),
    BS("Schotter bildet den Boden. "));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind durch das offene Tor pfeifen."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));

  AddDetail( ({ "schotter", "steine" }),
    BS("Einfacher Schotter bildet den Untergrund auf dem Du stehst."));
  AddDetail( ({ "wehrgang", "treppe", "treppen", "innenseite" }),
    BS("Die Treppen an der Innenseite der Festung fuehren hinauf zum "+
    "Wehrgang."));
  AddDetail( ({ "festung", "bergfestung", "zwergenfestung", "anlage" }),
    BS("Die Festung schliest den von steilen felsen umschlossnenen Kessel "+
    "nach Westen hin ab. Die Festung besteht daher eigentlich nur aus einem "+
    "breiten Wehrgang der die Felswand im Norden mit der Felswand im Sueden verbindet."));
  AddDetail( ({ "tor", "eingangstor" }),
    BS("Das schwere Tor, durch das man die Festung verlassen kann ist besonders "+
    "dick und schwer sowie mit vielen Runen geschmueckt."));
  AddDetail( ({ "runen", "schutzzauber" }),
    BS("Die Runen auf dem Tor sind warscheinlich Schutzzauber damit auch auf "+
    "magischem Weg die Festung nicht bezwungen werden kann."));
  AddDetail( ({ "hof", "kessel", "platz", "bereich" }),
    BS("Die Festung umschliesst zusammen mit den steilen Felsen einen kleinen Bereich "+
    "und bildet damit einen Kessel in der Bergwelt. Vom Hof direkt hinter dem Tor "+
    "kann man einen grossen Foerderturm am oestlichen Ende des Kessels erkennen. "
    "Desweiteren stehen noch zwei groessere Gebaeude im Norden und Sueden des Kessels."));
  AddDetail( ({ "bergwelt", "berge", "felswand", "felswaende", "fels", "felsen", "berg" }),
    BS("Die steilen Felsen bilden hier einen nach Westen offenen Kessel. "+
    "Diese natuerliche Anlage wurde von den Zwergen mit einem Wehrgang "+
    "geschlossen und kann daher nur schwer bezwungen werden. "));
  AddDetail( ({ "gebaeude" }),
    BS("Welches Gebaeude willst Du naeher betrachten? Das im Osten, im Norden oder "+
    "im Sueden? "));
  AddDetail( ({ "gebaeude im norden", "lager" }),
    BS("Das Gebaeude im Norden scheint ein Lager zu sein."));
  AddDetail( ({ "gebaeude im sueden", "kaserne" }),
    BS("Das Gebaeude im Norden scheint eine Kaserne zu sein."));
  AddDetail( ({ "gebaeude im osten", "foerderturm", "turm", "zwergenstadt", 
                "stadt", "thumfels", "ende", "zugang" }),
    BS("Der Foerderturm im Osten des Kessels scheint der Zugang zur Zwergenstadt "+
    "Thumfels zusein."));
  AddDetail( ({"baumeister", "steinmetze", "handwerk"}),
    BS("Die schmalen Fugen lassen darauf schliessen dass die Baumeister dieser "+
    "Festung ihr Handwerk sehr gut konnten. ") );
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich."));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddSound( ({ "wind" }),
    BS("Der Wind rauscht."));
  AddSmell( ({ "bergluft", "luft" }),
    BS("Hier herrscht besonders saubere und klare Luft. "));
  AddDetail( ({"weg"}),
    BS("Durch das Tor im Westen kommt man zurueck auf den Weg den Berg hinab."));

/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 


  AddExit( ({ "suedoben" }), ROOM+"serpweg_g6.lpc" );
  AddExit( ({ "nordoben" }), ROOM+"serpweg_g4.lpc" );
  AddExit( ({ "osten" }), ROOM+"serpweg_h5.lpc" );
  AddExit( ({ "westen" }), ROOM+"serpweg_f5.lpc" );

  AddExit( ({ "sueden" }), ROOM+"serpweg_g6.lpc" );
  AddExit( ({ "norden" }), ROOM+"serpweg_g4.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "norden"}) );
}

