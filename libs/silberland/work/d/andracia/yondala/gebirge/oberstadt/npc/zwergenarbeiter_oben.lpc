// Einladen macht der Foerderkorb

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int i_am_lost()
{
	while (remove_call_out("commandier") != -1) /* continue */ ;
  while (remove_call_out("deliver_new_obj") != -1) /* continue */ ;
	while (remove_call_out("get_new_obj") != -1) /* continue */ ;
	move( ROOM + "serpweg_h4.lpc", M_GO, "zurueck ins Lagerhaus.", "rennt");
	call_out( "get_new_obj", 3);
}

void reset()
{
  i_am_lost();
}

void init()
{
   ::init();
   if (this_player() && this_player()->id("\nzwache")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwergenarbeiter");
  SetProp(P_LONG,
    "Ein Zergenarbeiter der scheinbar den Foerderkorb mit Waren belaedt.");
  SetProp(P_NAME, "Zwergenarbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "zwergenarbeiter", "arbeiter", "\ntraeger"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "");
  SetProp(P_SIZE, 0);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  SetProp(P_LOG_INFO, "missing_answers");

  call_out("get_new_obj", 8);
  /*
  SUID;
  CLONEME(WEAPON+"axt" );
  command("zuecke axt"); // oder erst beim kampfstart zuecken?
  CLONEME(ARMOUR+"" );
  command("trage alles");
  */
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "",
        "");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "", 
        "");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void get_new_obj()
{
	object ob;
	if ( !environment(TO)->check_h4() ) {
		call_out("i_am_lost",10);
		return;
	}
	if ( !present("\ntransobj", TO)) {
	  SUID;
	  ob = clone_object( OBJ + "transobj.lpc" );
	  ob->move(TO, M_GET, TO->Name()+" nimmt sich "+ob->name(WEN,0)+". \n");
    tell_room(ENV(TO), BS(TO->Name()+" nimmt sich "+ob->name(WEN,0)+". \n"));
	}
	call_out( "commandier", 8, "sueden" );
	call_out( "commandier", 16, "osten" );
	call_out( "deliver_new_obj", 20 );
}

void deliver_new_obj()
{
  object ob, korb;
  int proceed;
	if ( !environment(TO)->check_i5() ) {
		call_out("i_am_lost",10);
		return;
	}
  if( !(ob=present("\ntransobj", TO)) ) {
    proceed = 10;
  } else {
  	proceed = 36;
  	ob->move(environment(TO), M_PUT, TO->name()+" legt "+ob->name(WEN,0)+" ab. \n");
    tell_room(ENV(TO), BS(TO->Name()+" legt "+ob->name(WEN,0)+" ab. \n"));
  }
  if( !present("\ntransobj 4", environment(TO) ) ) {
  	call_out( "commandier", proceed+4, "westen" );
	  call_out( "commandier", proceed+8, "norden" );
    call_out( "get_new_obj", proceed+12 );
  }
}

void commandier (string dir)
{
  command(dir);
}

void retard_new_obj(object traeger)
{
  if(find_call_out("get_new_obj")==-1) call_out("get_new_obj",20);
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if( random(3) == 0)
  {
    tell_room(environment(TO), TO->Name()+" ruft laut: \"HILFE!\" .\n");
    walk_mapping(environment(TO)->QueryProp(P_EXITS), "ruf_hilfe", TO);
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void ruf_hilfe(string richtung, string strpfad)
{
  object ob, pfad;
  pfad=to_object(strpfad);
  if(pfad && objectp(pfad))
    call_other(pfad,"???",0);
  if( !ob=present("\nzwache", pfad) ) return;
  if( ob->InFight() ) return;
  tell_room(environment(ob), ob->Name()+" ruft laut: \"Ich eile zur Hilfe!\" .\n");
  //tell_room(environment(TO), ob->Name()+" reagiert auf den Hilferuf und kommt "+TO->name(WEM)+" zu Hilfe. \n ");
  ob->move(environment(TO), M_GO, "",
    "reagiert auf den Hilferuf von "+TO->name(), 
    "kommt "+TO->name(WEM)+" zu Hilfe" );
}
