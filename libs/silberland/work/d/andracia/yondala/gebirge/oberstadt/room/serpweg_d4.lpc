//kiefernwald
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Serpentinenweg" );
  SetProp( P_INT_LONG,
     BS("Dieser Weg windet sich in Schlangenlinien den Berghang entlang. "+
     "Dadurch wird der Weg zwar sehr lang aber die Steigung des Wegs wird "+
     "klein und damit fuer alle begehbar. Man muss nicht klettern und auch "+
     "Lasttiere koennen hier bequem den Berg erklimmen. Du stehst genau an "+
     "der Baumgrenze. Keine Baeume wachsen ueberhalb dieser Hoehe. Unterhalb "+
     "dieser Stelle faengt der Kiefernwald an. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "weg", "serpentinenweg", "pfad" }),
    BS("Du befindest Dich auf einem steinigen Serpentinenweg."));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddDetail( ({ "wand", "fels", "felsen", "gestein", "steine", "berghang", "berg", "bergland" }),
    BS("Der felsige Berghang ist hier rechts und links des Wegs faellt "+ 
    "beziehungsweise steigt in einem starken Winkel. Zum Glueck ist hier "+
    "dieser Serpentinenweg zum erklimmen des Bergs. "));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind zwischen den Felsen pfeifen."));
  AddSound( ({ "wind" }),
    BS("Leise pfeift der Wind zwischen den Baumwipfeln."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));
  AddSmell( ({ "bergluft", "luft" }),
    BS("Hier herrscht besonders saubere und klare Luft. "));

  AddDetail( ({ "schlangenlinien", "schlangenlinie", "linien", "linie", "serpentine", "serpentinen"}),
    BS("Der Weg beschreibt Schlangenlinien. Eine Serpentine eben."));
  AddDetail( ({ "steigung", "hang", "winkel" }),
    BS("Rechts und links des Wegs faellt beziehungsweise steigt der Hang in einem "+
    "starken Winkel. Zum Glueck ist hier dieser Serpentinenweg zum erklimmen des "+
    "Bergs. "));
  AddDetail( ({ "lasttiere" }),
    BS("Da man hier nicht klettern muss um den Berg zu erklimmen, koennen "+
    "auch Lasttiere diese Serpentinen hochlaufen. Es scheinen gerade aber keine "+ 
    "unterwegs zu sein. "));
  AddDetail( ({ "baeume", "baum", "kiefern", "kiefernwald", "wald" }),
    BS("Hier oben in diesem rauhen Klima des Berglands kann sich fast kein Baum halten. "+
    "Nur Kiefern wachsen bis hier. Man hat hier eine gute Sicht. "));
  AddDetail( ({ "klima", "bergwetter", "wetter" }),
    BS("Es ist hier etwas kuehl und das Bergwetter kann schnell umschlagen. "));
  AddDetail( ({ "wurzeln" }),
    BS("Kraeftige Wurzeln verankern die wenigen Kiefern am steilen Hang. Die Baeume "+
    "krallen sich zwischen den blanken Felsen fest, trotzen dem Klima und erreichen "+
    "daher selten eine normale Groesse. "));
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich."));
  AddDetail( ({ "baumgrenze", "hoehe", "stelle" }),
    BS("Ab hier wachsen keine Baeume mehr. Weiter unten ist das Klima milder und es "+
    "beginnt der Kiefernwald. "));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddDetail( ({ "aussicht", "sicht", "umgebung", "blickfeld" }),
    BS("Tief unter Dir kannst Du die naehere Umgebung sehen. "+
    "Im Nordwesten kann man den Marmorturm noch erkennen waehrend im Norden sich ein "+
    "riesiger Wald erstreckt. Der Rest deines Blickfelds besteht nur aus Berge."));
  AddDetail( ({"baumwipfel", "wipfel", "baumwipfeln", "wipfeln", "baumkronen", "baumkrone"}),
    BS("Die Baumkronen verdecken nur teilweise die Aussicht nach Nordwesten. "));
  AddDetail( ({"turm", "marmorturm"}),
    BS("Weit unten kann man den hoch aufragenden Marmorturm sehen. Fuer Einzelheiten bist "+
    "Du aber zu weit entfernt." ));
  AddDetail( ({"einzelheiten"}),
    BS("Dafuer bist Du zu weit entfernt."));
  AddDetail( ({"", ""}),
    BS(""));


/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 


  AddExit( ({ "suedunten" }), ROOM+"serpweg_d5.lpc" );
  AddExit( ({ "nordoben" }), ROOM+"serpweg_d3.lpc" );

  AddExit( ({ "sueden" }), ROOM+"serpweg_d5.lpc" );
  AddExit( ({ "norden" }), ROOM+"serpweg_d3.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden", "norden"}) );
}

