#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hof der Zwergenfestung" );
  SetProp( P_INT_LONG,
     BS("Die Festung umschliesst zusammen mit den steilen Felsen einen kleinen Bereich "+
    "und bildet damit einen Kessel. Von diesem Hof aus "+
    "kann man einen grossen Foerderturm im Osten erreichen. "+
    "Desweiteren stehen noch zwei groessere Gebaeude im Norden und Sueden. "+
    "Im Westen kann man zum Tor der Anlage gelangen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "untergrund", "grund" }),
    BS("Schotter bildet den Boden. "));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind durch das offene Tor pfeifen."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));

  AddDetail( ({ "gebaeude im westen", "festung", "bergfestung", "zwergenfestung",
                "anlage" }),
    BS("Die Festung umschliesst zusammen mit den steilen Felsen einen kleinen Bereich "+
    "und bildet damit einen Kessel. Die Festung besteht daher "+
    "eigentlich nur aus einem breiten Wehrgang der die Felswand im Norden mit "+
    "der Felswand im Sueden verbindet."));
  AddDetail( ({ "hof", "kessel", "bereich", "felsen", "felswand" }),
    BS("Die Festung umschliesst zusammen mit den steilen Felsen einen kleinen Bereich "+
    "und bildet damit einen Kessel. Von diesem Hof aus "+
    "kann man einen grossen Foerderturm im Osten erreichen. "+
    "Desweiteren stehen noch zwei groessere Gebaeude im Norden und Sueden."));
  AddDetail( ({ "gebaeude" }),
    BS("Welches Gebaeude willst Du naeher betrachten?"));
  AddDetail( ({ "gebaeude im norden", "lager" }),
    BS("Das Gebaeude im Norden scheint ein Lager zu sein."));
  AddDetail( ({ "gebaeude im sueden", "kaserne" }),
    BS("Das Gebaeude im Norden scheint eine Kaserne zu sein."));
  AddDetail( ({ "gebaeude im osten", "foerderturm", "turm", "zwergenstadt", 
                "stadt", "thumfels", "zugang" }),
    BS("Der Foerderturm im Osten des Kessels scheint der Zugang zur Zwergenstadt "+
    "Thumfels zusein."));
  AddDetail( ({ "schotter", "steine" }),
    BS("Einfacher Schotter bildet den Untergrund auf dem Du stehst."));
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich."));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddSound( ({ "wind" }),
    BS("Der Wind rauscht."));
  AddSmell( ({ "bergluft", "luft" }),
    BS("Hier herrscht besonders saubere und klare Luft. "));
  AddDetail( ({ "tor", "eingangstor" }),
    BS("Das schwere Tor, durch das man die Festung verlassen kann befindet "+
    "sich im Westen."));
  AddDetail( ({"wehrgang", "treppen"}),
    BS("Neben dem Tor im Westen fuehren zwei Treppen hinauf auf den Wehrgang."));

/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 

  AddExit( ({ "sueden" }), ROOM+"serpweg_h6.lpc" );
  AddExit( ({ "norden" }), ROOM+"serpweg_h4.lpc" );
  AddExit( ({ "osten" }), ROOM+"serpweg_i5.lpc" );
  AddExit( ({ "westen" }), ROOM+"serpweg_g5.lpc" );

  AddItem( NPC+"zwergenwache.lpc", REFRESH_DESTRUCT );

}

