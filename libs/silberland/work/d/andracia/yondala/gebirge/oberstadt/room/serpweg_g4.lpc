#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwergenfestung, Wehrgang, noerdlicher Teil" );
  SetProp( P_INT_LONG,
     BS("Du stehst hier auf dem noerdlichen Wehrgang der Zwergenfestung. Die "+
     "Zinnen auf der Westseite sind breit und nicht allzu hoch, ideal fuer Zwerge. "+
     "Der Wehrgang selbst ist besonders breit und liefert fast schon eine Platform. "+
     "Im Norden grenzt die Festung direkt an steil hochragende Felswaende die diesen "+
     "Teil der Bergwelt einkesseln. An der Ostseite des Wehrgangs fuehrt eine "+
     "steinerne Treppe hinab vor das schwere Tor." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "felsplatten", "untergrund", "mauersteine", "steine", 
                "oberseiten", "oberseite" }),
    BS("Flache Felsplatten bilden den Untergrund. Vielleicht sind es aber auch "+
    "nur die von Steinmetzen flach geschlagenen Oberseiten der Mauersteine. Die "+
    "Fugen dazwischen sind sehr schmal und lassen darauf schliessen dass die "+
    "Baumeister besonders geschickte Steinmetze waren. "));
  AddDetail( ({ "himmel" }),
    BS("Blauer Himmel soweit das Auge reicht."));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst den Wind zwischen den Zinnen pfeifen."));
  AddSmell( DEFAULT_SMELL,
    BS("Nur frische Bergluft."));

  AddDetail( ({ "wehrgang", "platform" }),
    BS("Dieser breite Wehrgang schliesst den von steilen Felsen umschlossenen "+
    "Kessel nach Westen hin ab. Du stehst hier auf dem noerdlichen Teil der Festung. "+
    "Die Zinnen im Westen scheinen fuer Zwerge geschaffen worden zu sein. An der "+
    "Ostseite des Wehrgang fuehrt eine steinerne Treppe zurueck vor das schwere Tor. "));
  AddDetail( ({ "festung", "bergfestung", "zwergenfestung", "anlage" }),
    BS("Die Festung schliest den von steilen felsen umschlossnenen Kessel "+
    "nach Westen hin ab. Die Festung besteht daher eigentlich nur aus diesem "+
    "breiten Wehrgang der die Felswand im Norden mit der Felswand im Sueden verbindet."));
  AddDetail( ({ "zinnen", "zinnenreihe", "oberkante", "zinne", "westseite" }),
    BS("An der Westseite des Wehrgangs sind Zinnen angebracht. Von der Groesse der "+
    "Zinnen kann man erkennen dass diese Anlage fuer Zwerge geschaffen wurde."));
  AddDetail( ({ "norden" }),
    BS("An der steilen Felswand im Norden endet der Wehrgang. "));
  AddDetail( ({ "westen", "aussicht", "land", "andracia" }),
    BS("Ueber die Zinnen hinweg hat man eine grandiose Aussicht ueber das Land. "+
    "Im Nordwesten kann man den Marmorturm erkennen hinterdem ein riesiger Wald "+
    "sich bis zum Horizont erstreckt. Im Westen kann man das Reich der Termiten "+
    "ueberblicken, aber die Burg Zwirbelstein die ja dahinterliegt ist im Dunst "+
    "verborgen. "));
  AddDetail( ({ "marmorturm", "horizont", "wald", "termiten", "reich", "burg",
                "zwirbelstein", "dunst", "verborgenes" }),
    BS("Die Aussicht ist zwar gut aber um mehr zu erkennen muss man schon "+
    "dorthin reisen."));
  AddDetail( ({ "sueden" }),
    BS("Nach Sueden hin erstreckt sich der Wehrgang. "));
  AddDetail( ({ "osten", "hof", "kessel", "groesse", "teil", "bereich" }),
    BS("Hinter der Festung wird ein kleiner Bereich von steilen Felsen umschlossen "+
    "und bildet damit einen Kessel in der Bergwelt. Vom Hof direkt hinter dem Tor "+
    "kann man einen grossen Foerderturm am oestlichen Ende des Kessels erkennen. "
    "Desweiteren stehen noch zwei groessere Gebaeude im Norden und Sueden des Kessels."));
  AddDetail( ({ "gebaeude" }),
    BS("Welches Gebaeude willst Du naeher betrachten?"));
  AddDetail( ({ "gebaeude im norden", "lager" }),
    BS("Das Gebaeude im Norden scheint ein Lager zu sein."));
  AddDetail( ({ "gebaeude im sueden", "kaserne" }),
    BS("Das Gebaeude im Norden scheint eine Kaserne zu sein."));
  AddDetail( ({ "foerderturm", "turm", "zwergenstadt", "stadt", "thumfels", "ende", "zugang" }),
    BS("Der Foerderturm im Osten des Kessels scheint der Zugang zur Zwergenstadt "+
    "Thumfels zusein."));
  AddDetail( ({ "ostseite" }),
    BS("An der Ostseite des Wehrgangs fuehrt eine Treppe hinab zurueck vor das Tor."));
  AddDetail( ({ "bergwelt", "berge", "felswand", "felswaende", "kessel" }),
    BS("Die steilen Felsen bilden hier einen nach Westen offenen Kessel. "+
    "Diese natuerliche Anlage wurde von den Zwergen mit einem Wehrgang "+
    "geschlossen und kann daher nur schwer bezwungen werden. "));
  AddDetail( ({ "treppe" }),
    BS("Die steinerne Treppe an der Ostseite des Wehrgangs fuehrt wieder zurueck "+
    "vor das schwere Tor."));
  AddDetail( ({ "tor" }),
    BS("Dazu muss Du schon die Treppe wieder hinabgehen."));
  AddDetail( ({"baumeister", "steinmetze", "handwerk"}),
    BS("Die schmalen Fugen lassen darauf schliessen dass die Baumeister dieser "+
    "Festung ihr Handwerk sehr gut konnten. ") );
  AddDetail( ({ "auge" }),
    BS("Du kannst damit sehen, welch ein Glueck fuer dich. "));
  AddDetail( ({ "glueck" }),
    BS("Du suchst doch sicher danach, oder?  "));
  AddSound( ({ "wind" }),
    BS("Der Wind rauscht zwischen den Zinnen."));
  AddSmell( ({ "bergluft", "luft" }),
    BS("Hier herrscht besonders saubere und klare Luft. "));
  AddDetail( ({"fugen", "fuge"}),
    BS("Nur ganz schmale Fugen sind zu erkennen. "+
    "Das muessen patente Steinmetze gewesen sein die solch ein Mauerwerk "+
    "erzeugen konnten. ") );
  AddDetail( ({"mauer", "mauerwerk", "festungsmauer", "felsen"}),
    BS("Die Mauer besteht aus behauenen Felsen mit schmalen Fugen dazwischen. "+
    "scheinbar waren die Baumeister dieser Festung patente Steinmetze. ") );

/*
  AddDetail( ({"", ""}),
    BS(""));
*/ 
  AddItem( NPC+"zwergenwache.lpc", REFRESH_DESTRUCT );

  AddExit( ({ "suedunten" }), ROOM+"serpweg_g5.lpc" );
  AddExit( ({ "sueden" }), ROOM+"serpweg_g6.lpc" );

}

