#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Geroellfeld");
  SetProp(P_INT_LONG, 
    BS("Dieser Weg fuehrt quer ueber ein Geroellfeld weiter den Berg entlang. Etwas "+ 
    "weiter unten beginnt der Wald. Die Luft hier oben ist besonders rein aber auch "+
    "recht kalt. Die Bergkette im Osten ist inzwischen recht nah und man kann die "+
    "schneebedeckten Gipfel erkennen. Der Weg ist beschwerlich und auch nicht "+
    "ungefaehrlich da hin und wieder Felsbrocken ueber das Geroellfeld zum rollen "+
    "kommen und mit hoher Geschwindigkeit gen Tal kullern. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddSmell( DEFAULT_SMELL,
    BS("Nur frische, kuehle Luft."));
  AddSmell( ({"luft"}),
    BS("Frisch und kuehl."));
  AddSound( DEFAULT_SOUND,
    BS("Es ist sehr still in dieser Hoehe."));
  AddSound( ({"stille"}),
    BS("Die erhabene Stille die auf den Bergen herrscht."));

  AddDetail( ({"boden", "weg"}),
    BS("Nur karger Fels bildet den Untergrund."));
  AddDetail( ({"himmel"}),
    BS("Blauer Himmel ueberall."));
  AddDetail( ({"wetter"}),
    BS("Dem blauen Himmel nach zu urteilen duerfte es die naechste Zeit gutes Wetter bleiben."));
  AddDetail( ({"geroellfeld"}) ,
    BS("Du befindest dich mittendrin."));
  AddDetail( ({"berg", "berge", "gebirge", "bergkette", "osten"}) ,
    BS("Karge Felsen bauen sich im Osten auf und du kannst die Spitzen der Bergkette nicht erkennen. "));
  AddDetail( ({"wald", "tal", "baumgrenze", "hoehe" }) ,
    BS("Unter Dir kannst Du den Wald erkennen. Die befindest dich hier ueber der Baumgrenze."));
  AddDetail( ({"luft"}) ,
    BS("Die Luft ist frisch und kuehl."));
  AddDetail( ({"gipfel", "spitzen"}) ,
    BS("Der Gipfel ist noch fern. Erstaunlich wie hoch dieses Gebirge ist. "));
  AddDetail( ({"felsbrocken", "fels", "steine", "untergrund", "felsen"}) ,
    BS("Ganz normale Felsen."));
  AddDetail( ({"geschwindigkeit"}) ,
    BS("Die Geschwindigkeit reicht um sich schwer zu verletzen wenn "+
    "man von einem dieser rollenden Steine getroffen wird."));

/*
  AddDetail( ({""}),
    BS("")); 
*/
}