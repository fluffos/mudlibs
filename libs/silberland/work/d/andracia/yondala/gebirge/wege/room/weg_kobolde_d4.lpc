#include "../def.h"

inherit ROOM + "weg_kobolde_wald.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Eine kleine Hoehle fuehrt hier in den Berg hinein. \n" );
  
    
  AddExit( "suedwestunten" , ROOM + "weg_kobolde_c5.lpc");
  AddExit( "suedostoben" , ROOM + "weg_kobolde_e5.lpc" );
  AddExit( "unten" , "/d/gebirge/yondala/gierlingshoehle/room/gierlinge_8b.lpc" );

  AddExit( "suedwesten" , ROOM + "weg_kobolde_c5.lpc");
  AddExit( "suedosten" , ROOM + "weg_kobolde_e5.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedwesten", "suedosten"}) );
}
