// Baumgrenze
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Baumgrenze");
  SetProp(P_INT_LONG, 
    BS("Du stehst hier an der Baumgrenze. Ueberhalb dieser Hoehe wachsen keine Baume mehr. "+
    "Nur noch Gras und andere genuegsame Pflanzen koennen in dieser kalten Region ueberleben."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_MOUNTAIN]) );


  AddSmell( DEFAULT_SMELL,
    BS("Nur frische, kuehle Luft."));
  AddSmell( ({"luft"}),
    BS("Frisch und kuehl."));
  AddSound( DEFAULT_SOUND,
    BS("Es ist sehr still in dieser Hoehe."));
  AddSound( ({"stille"}),
    BS("Die erhabene Stille die auf den Bergen herrscht."));

  AddDetail( ({"boden", "weg"}),
    BS("Der Boden ist karg und felsig."));
  AddDetail( ({"himmel"}),
    BS("Blauer Himmel ueberall."));
  AddDetail( ({"wetter"}),
    BS("Dem blauen Himmel nach zu urteilen duerfte es die naechste Zeit gutes Wetter bleiben."));
  AddDetail( ({"baumgrenze"}) ,
    BS("Hier wachsen die letzten Baeume. Oberhalb dieser Hoehe koennen Baume sich nicht halten."));
  AddDetail( ({"baum", "baeume"}),
    BS("Nur noch unterhalb dieser Hoehe wachsen Baeume. Die letzten Baeume hier sind von ihrem Kampf gegen die "+
    "hier herrschenden Verhaeltnisse gezeichnet und koennen nur als verkrueppelt bezeichnet werden."));
  AddDetail( ({"gras"}),
    BS("Zwischen den Felsen waechst noch etwas Gras."));
  AddDetail( ({"hoehe"}),
    BS("Du befindest dich hier an der Baumgrenze. Ueberhalb sind nur noch Felsen zu sehen."));
  AddDetail( ({"kampf"}),
    BS("Die hier lebenden Baeume kaempfen gegen Wetter, Wind und Kaelte. "));
  AddDetail( ({"pflanzen"}),
    BS("hier auf dieser hoehe wachsen noch ein paar letzte verkrueppelte baeume. Ein bischen Gras kann man auch "+
    "noch zwischen den Felsen entdecken."));
  AddDetail( ({"region", "gebirge", "platz"}),
    BS("Du befindest dich hoch im Gebirge."));
  AddDetail( ({"verhaeltniss"}),
    BS("Hier in dieser Hoehe ist es kalt und windig."));
  AddDetail( ({"kaelte"}),
    BS("Hier ist es um einiges kaelter als tiefer im Wald."));
  AddDetail( ({"felsen"}),
    BS("Ganz normale Felsen."));
  AddDetail( ({"wind"}),
    BS("Kalt pfeift der Wind ueber die Felsen. Kein angenehmer Platz zum verweilen."));
  AddDetail( ({"wald"}),
    BS("Der Wald befindet sich tiefer."));
  AddDetail( ({"felsen", "fels"}),
    BS("Die grauen Felsen des Gebirges schauen ueberhalb dieserStell oefters aus dem Boden. "));

/*
  AddDetail( ({""}),
    BS(""));
*/    
  AddExit( "nordunten" , ROOM + "weg_kobolde_e5.lpc");
  AddExit( "suedwestoben" , ROOM + "weg_kobolde_d7.lpc" );

  AddExit( "norden" , ROOM + "weg_kobolde_e5.lpc");
  AddExit( "suedwesten" , ROOM + "weg_kobolde_d7.lpc" );
  SetProp( P_HIDE_EXITS, ({"suedwesten", "norden"}) );
}
