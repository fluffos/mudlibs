#include "../def.h"

inherit ROOM + "weg_kobolde_kahl.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Der Weg endet hier. \n" );
      
  AddExit( "suedunten" , ROOM + "weg_kobolde_g6.lpc");
  //AddExit( "norden" , "/d/gebirge/yondala/koboldhoehle/room/koboldhoehle_8b.lpc" );

  AddExit( "sueden" , ROOM + "weg_kobolde_g6.lpc");
  SetProp( P_HIDE_EXITS, ({"sueden"}) );
}
