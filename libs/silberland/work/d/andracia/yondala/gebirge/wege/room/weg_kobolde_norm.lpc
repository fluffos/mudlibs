#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem leicht ansteigenden Weg");
  SetProp(P_INT_LONG, 
    BS("Dieser Weg fuehrt leicht ansteigend Richtung Berge. Baeume und Gras entsprechen "+
    "hier genau den Gewaechsen die ueberall im Wald zu finden sind, aber der Anteil von "+
    "Nadelbaeumen wird immer mehr, je hoeher man kommt. Zwischen den hohen Baeumen "+
    "versperrt Dir dichtes Gestruepp den Blick. Ein leichter Wind bewegt die Blaetter "+
    "der Baume und erzeugt ein leises saeuseln. Hin und wieder kann man auch das knacken "+
    "eines Asts im Unterholz hoeren - warscheinlich Tiere. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_FOREST]) );

  AddSmell( DEFAULT_SMELL,
    BS("Der Wald hat seinen eigenen Geruch. Verrottendes Laub und die Baume selbst geben "+
    "der Luft einen ganz besonderen Geschmack. Du atmest tief ein und spuerst die "+
    "Natur um dich herum und geniesst dein Leben in vollen Zuegen. "));
  AddSmell( ({"duft", "geruch", "gerueche", "luft", "natur", "harz", "waldluft"}),
    BS("Verrottendes Laub, Harz und Rinde der Baeume, all das bildet "+
    "diesen angenehmen Duft des Waldes."));
  AddSmell( ({"laub", "baum", "baeume"}) ,
    BS("Das Laub am Boden verrottet langsam und fuegt seinen Duft der Luft zu."));

  AddSound( DEFAULT_SOUND,
    BS("Hin und wieder kann man das Knacken und Rascheln eines Tieres im Gestruepp hoeren. "));
  AddSound( ({"tier", "tiere", "natur", "gestruepp"}),
    BS("Hin und wieder kanckt und raschelt es im Gestruepp, irgendwelche Tiere des "+
    "Waldes haben diese wohl bei der Flucht tieferins Unterholz erzeugt."));
  AddSound( ({"knacken", "rascheln"}) ,
    BS("Du kannst zwar keine Tiere sehen, aber das Rascheln und Knacken im Unterholz "+
    "stammt bestimmt von welchen."));
  AddSound( ({"blaetterdach", "wind"}) ,
    BS("Hoch ueber dir bewegen sich die Blaetter der Baeume im Wind und erzeugen ein saeuseln. "));
  AddSound( ({"saeuseln"}) ,
    BS("Der Wind der sich im Blaetterdach verfaengt, laesst die Blaetter aneinander reiben. "));
  AddSound( ({"geraeusche", "geraeusch"}),
    BS("Hin und wieder kann man das Knacken und Rascheln eines Tieres im Gestruepp hoeren. "));

  AddDetail( ({"boden", "weg", "waldboden"}),
    BS("Der steinige Weg fuehrt langsam ansteigend Richtung Berge. Man kann schon "+
    "schneebedeckte Gipfel im Osten erkennen. Am Rande des Weges waechst Gras und hin "+
    "und wieder kann man das blaue Koepfchen eines Alpenveilchens erblicken." ));
  AddDetail( ({"himmel"}),
    BS("Zwischen den dichten Laub der Baume kann man hin und wieder einen Blick auf ein "+
    "kleines Stueck blauen Himmel erhaschen. Es ist angenehmes Wetter und der Wald "+
    "erzeugt seinen eigenen Duft der die Sinne betoert."));
  AddDetail( ({"wetter"}),
    BS("Das bischen das Du vom Himmel zwischen den Baeumen erblicken kann ist tiefblau und "+
    "zeugt davon dass es die naechsten Tage weiterhin schoenstes Wetter wohl geben wird. "));
  AddDetail( ({"berge", "berg", "gipfel", "osten", "gebirge"}) ,
    BS("Im Osten ragen hohe Berge hoch hinauf. Das Gebirge scheint unueberwindbar und "+
    "die schneebedeckten Gipfel lassen einen schon von weitem froesteln. "));
  AddDetail( ({"baeume", "baum", "nadelbaeume", "nadelbaum", "laubbaeume", "laubbaum", "baeumen", "wald"}) ,
    BS("Hier stehen Laub- und Nadelbaeume dicht nebeneinander und kaempfen um das bischen "+
    "Licht das die Sonne spendet. Wenn man nach oben schaut sieht man nur noch wenig vom "+
    "blauen Himmel."));
  AddDetail( ({"licht", "sonne"}) ,
    BS("Zwischen den Bauemen dingt kein direktes Sonnenlicht mehr herunter auf den Weg. "+
    "Trotzdem ist es hier unten zwischen den hochaufragenden Gewaechsen hell genug vom "+
    "gruenen Licht das die Blaetter hindurchlassen. "));
  AddDetail( ({"gras", "veilchen", "alpenveilchen"}) ,
    BS("Das Gras hier ist nicht sehr ueppig und auch die Veilchen sind selten hier. "));
  AddDetail( ({"gestruepp", "gewaechse", "unterholz", "straeucher"}) ,
    BS("Zwischen den Baeumen haben sich Straeucher und anderes Gestruepp dicht gedraengt. "+
    "Den Weg zu verlassen ist daher nicht besonders ratsam. Hin und wieder dringen "+
    "Geraeusche aus dem Unterholz an dein Ohr die wohl von Tieren stammen die sich vor "+
    "Dir fuerchten und tiefer ins Unterholz fluechten. " ));
  AddDetail( ({"blick", "ausblick"}) ,
    BS("Da die Baeume hier so dicht stehen kann man keinen Ausblick geniessen. Nur "+
    "kleine Fetzen blauen Himmels kann man im dichten Blaetterdach des Waldes erkennen. "));
  AddDetail( ({"wind", "blaetterdach"}) ,
    BS("der Wind streicht durch das Blaetterdach der Baeume und erzeugt ein leises saeuseln. "));
  AddDetail( ({"blaetter", "laub", "rand", "rande"}) ,
    BS("Abseits des Wegs liegt das Laub der Baeume und verottet. Der typische Geruch des "+
    "Waldes besteht zu einem guten Teil aus dieser Quelle. Die Baeume selbst verstroemen "+
    "zusaetzlich einen Duft von Harz und Rinde was heir einen intensiven Geruch von Natur bildet. "));
  AddDetail( ({"ast", "aeste"}) ,
    BS("Das knacken stammt wohl von Aesten, aber hier auf dem Weg sind keine herabgefallenen "+
    "Aeste die unter deinen Schritten kancken koennten. "));
  AddDetail( ({"tiere", "tiere"}) ,
    BS("die Tiere verstecken sich im Unterholz. Du hast keinen Bedarf dort hinein zukiechen. "));
  AddDetail( ({"richtung", "richtungen"}) ,
    BS("Entweder du gehst den Weg hinauf richtung Gebirge oder Du gehst hinab um wieder "+
    "das Huegelland zu durchstreifen. "));
  AddDetail( ({"duft", "geruch", "gerueche"}) ,
    BS("Da hilft riechen etwas mehr."));
  AddDetail( ({"sinne", "koepfchen", "ohr", "sinn"}) ,
    BS("Du kannst riechen, schauen, hoeren, schmecken und fuehlen. Es soll auch einen sechsten "+
    "Sinn geben aber das ist nur ein Geruecht."));
  AddDetail( ({"geschmack"}) ,
    BS("Dazu musst Du was essen."));
  AddDetail( ({"natur", "leben"}) ,
    BS("Diese Baeume, diese Luft - hier kannst Du die Natur und das Leben geniessen."));
  AddDetail( ({"bedarf"}),
    BS("Du scheinst einen Bedarf an Forscherpunkte zu haben."));
  AddDetail( ({"forscherpunkt", "forscherpunkte"}),
    BS("Vielleicht war das gerade einer."));
  AddDetail( ({"fetzen"}),
    BS("Nur blauer Himmel."));
  AddDetail( ({"geruecht"}),
    BS("Vielleicht hast Du ja diesen Sinn."));
  AddDetail( ({"harz", "baumharz"}) ,
    BS("Nachdem Du einen der Baeume mit deiner Waffe verletzt hast, rinnt ein bischen "+
    "Harz an der Rinde herab. Du kannst daran aber nichts besonderes erkennen. "));
  AddDetail( ({"rinde"}),
    BS("Die Baeume haben eine ganz normale Rinde. Nichts besonderes dran zu erkennen."));
  AddDetail( ({"huegelland"}),
    BS("Das Huegelland befindet sich den Berg hinab."));
  AddDetail( ({"quelle"}),
    BS("Die Quelle der Waldluft scheint der Waldboden zu sein."));
  AddDetail( ({"sonnenlicht", "sonnenschein", "licht", "tage", "tag"}),
    BS("Die Sonne scheint und der Himmel ist blau. Ein herrscht also sehr gutes Wetter."));
  AddDetail( ({"felsen", "fels"}),
    BS("Zwischen den grauen Felsen des Gebirges waechst Gras und auch ein paar Alpenveilchen kannst Du sehen. "));


/*
  AddDetail( ({""}),
    BS("")); 
*/
}