#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();
  	
  SetProp(P_INT_SHORT, "Auf einem ansteigenden Weg");
  SetProp(P_INT_LONG, 
    BS("Dieser Weg fuehrt durch den Wald hinauf in hoehere Regionen des Berglands "+
    "im Suedosten. Die Baume, die hier sehr dicht stehen, sind ausnahmslos "+
    "Nadelbaeume. Das Klima scheint hier doch etwas rauher zu sein als weiter "+
    "den Berg hinab."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_FOREST]) );

  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier vorallem nach dem Harz der Nadelbaeume."));
  AddSmell( ({"harz", "baeume", "baum", "bergluft", "luft", "baumharz", "duft"}),
    BS("Die frische Bergluft wird erfuellt mit dem leichten Duft von Baumharz."));
  AddSound( DEFAULT_SOUND,
    BS("Man kann hier nur das Rauschen der Waelder hoeren wenn der Wind durch die "+
    "Baumwipfel streicht."));
  AddSound( ({"rauschen", "geraeusch", "geraeusche"}) ,
    BS("Der Wind verfaengt sich in den Wipfeln der Baeume und erzeugt diese Geraeusche."));

  AddDetail( ({"boden", "weg"}),
    BS("Der Weg steigt setig an und windet sich den Berghang hinauf beziehungsweise +"
    "fuehrt den Berghang hinunter jenachdem in welche Richtung man sich wendet. Durch die "+
    "dicht stehenden Nadelbaeume kann man nur schwer erkennen wo der Weg weiterverlaeuft. "));
  AddDetail( ({"himmel", "wetter"}),
    BS("Hoch ueber Dir erstreckt sich zwischen den Baumwipfeln tiefblauer Himmel."));
  AddDetail( ({"wald", "baeume", "baum", "nadelbaeume", "nadelbaum", "waelder"}) ,
    BS("Hier im unteren Bereich des Bergs ist der Wald besonders dicht und versperrt "+
    "Dir die Sicht nach allen Seiten. Man kann auch schwer erkennen wo der Weg weiterfuehrt. " ));
  AddDetail( ({"region", "regionen", "bergland", "bereich", "bereiche"}) ,
    BS("Diese Region gehoert schon zu den Auslaeufern des Gebirges. Der Weg steigt stetig an, "+
    "beziehungsweise fuehrt den Berghang hinunter. "));
  AddDetail( ({"klima"}) ,
    BS("Es ist hier ein bischen kaelter als im flachen Huegelland das sich vom Fuss des "+
    "Bergs bis zum Ufer des Meers im Westen erstreckt."));
  AddDetail( ({"berg", "berge", "berghang", "gebirge", "osten"}) ,
    BS("Im Osten sind die Berge schon sehr nah. Dies hier sind schon die ersten "+
    "Auslaeufer des Gebirges. Der Berghang steigt gen Osten an und im Westen liegt "+
    "etwas unterhalb das flache Huegelland."));
  AddDetail( ({"baumwipfel", "wipfel", "wipfeln"}) ,
    BS("Der Wind verfaengt sich in den Baumwipfeln der Nadelbaeume und erzeuget ein "+
    "fuer diese Region typische Rauschen. "));
  AddDetail( ({"harz", "baumharz"}) ,
    BS("Nachdem Du einen der Baeume mit deiner Waffe verletzt hast, rinnt ein bischen "+
    "Harz an der Rinde herab. Du kannst daran aber nichts besonderes erkennen. "));
  AddDetail( ({"richtung", "richtungen", "seite", "seiten"}),
    BS("Der Weg fuert den Berghang hinauf oder hinab. Im Osten die Berge im Westen das "+
    "flache Huegelland, jenachdem fuer welche Richtung Du dich entscheidest. " ));
  AddDetail( ({"sicht", "aussicht"}),
    BS("Die Aussicht ist leider durch die Baeume versperrt. "));
  AddDetail( ({"auslaeufer"}),
    BS("Weiter im Osten beginnt das grosse Gebirge. Du stehst also hier auf einem der "+
    "Auslaeufer des Gebirges." ));
  AddDetail( ({"huegelland", "ufer", "meer", "westen"}),
    BS("Leider ist die Aussicht durch die Baeume versperrt, aber bis zum Meer kann "+
    "man trotz bestem Wetter bestimmt nicht sehen." ));
  AddDetail( ({"rinde"}),
    BS("Die Baeume haben eine ganz normale Rinde. Nichts besonderes dran zu erkennen."));
  AddDetail( ({"felsen", "fels"}),
    BS("Die grauen Felsen des Gebirges schauen hier nur selten aus dem Boden. "));
  
/*
  AddDetail( ({""}),
    BS("")); 
*/  
}