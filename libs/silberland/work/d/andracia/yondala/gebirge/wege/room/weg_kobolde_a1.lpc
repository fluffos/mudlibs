#include "../def.h"

inherit ROOM + "weg_kobolde_norm.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Im Nordwesten scheint eine Kreuzung zu sein. ") );

  AddDetail( ({"kreuzung", "nordwesten"}) ,
    BS("Im Nordwesten scheint sich am Rand des Waldes eine Kreuzung zu befinden. "));
    
  AddExit( "suedostoben" , ROOM + "weg_kobolde_b2.lpc");
  AddExit( "nordwesten" , KREUZUNG_01 );

  AddExit( "suedosten" , ROOM + "weg_kobolde_b2.lpc");
  SetProp( P_HIDE_EXITS, ({"suedosten"}) );
}
