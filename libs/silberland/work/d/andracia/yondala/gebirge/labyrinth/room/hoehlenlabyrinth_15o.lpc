//Hier findet man ein kleines Fass
#include "../def.h"
//inherit "std/room";
inherit LABY_ROOM + "hoehlenlabyrinth_hangelhoehle.lpc";
#include <properties.h>
int fassda;
void anfangszustand()
{
	fassda=1;
}

void create() 
{
  ::create();
  	fassda=1;
  SetProp( P_INT_SHORT, "In einer Hoehle unter der Erde" );
  SetProp( P_INT_LONG,
    "Du stehst in einer kleinen Hoehle, die offensichtlich unter dem Erdreich liegt, denn alles "
    "besteht hier aus lehnmiger Erde, die von vielen Wurzeln durchbrochen ist die wirr aus "
    "Decke und Waenden brechen." );
  AddDetail( ({ "erde" }),
    "Du bist von feuchtem Erdreich umgeben.");
  AddDetail( ({ "erdreich" }),
    "Die Erde um Dich herum besteht aus Humus und Lehm, was Du an den unterschiedlichen "
    "Farben festmachst. Es ist an vielen Stellen von Wurzeln unterbrochen.");
  AddDetail( ({ "humus" }),
    "Schwarzer Humus dominiert das Erdreich. Er sieht sehr fruchtbar aus, die Pflanzen ueber Dir "
    "muessen dut wachsen.");
  AddDetail( ({ "pflanzen","pflanze" }),
    "Pflanzen siehst Du hier nicht, die sind weit ueber Dir, draussen. Aber weil Du ihre "
    "Wurzeln sehen kannst weisst Du, dass sie da sind.");
  AddDetail( ({ "lehm" }),
    "Hellbrauner Lehm durchsetzt das Erdreich hier und da.");
  AddDetail( ({ "farben","farbe" }),
    "Du siehst schwarzen Humus und hellbraunen Lehm.");
  AddDetail( ({ "stellen" }),
    "Hier und da spriessen verschiedenste Wurzeln durch Decke und Waende.");
  AddDetail( ({ "decke" }),
    "Von der Decke haengen dicke Wurzeln herab. Sie sehen sehr stabil aus.");
  AddDetail( ({ "wurzeln" }),
    "Welche Wurzeln meinst Du? Die dicken Wurzeln unter der Decke oder die weichen Wurzeln "
    "an den Waenden?");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen wie alles hier aus einem Gemisch von Erde und Humus. Duenne, weiche "
    "Wurzeln haben sie durchbrochen und kitzeln Dich.");
  AddDetail( ({ "gemisch" }),
    "Waende, Decke und Boden bestehen aus einem Gemisch von Humus und Lehm.");
  AddDetail( ({ "boden" }),
    "Der Boden ist platt getrampelt. Du siehst einige Spuren.");
  AddDetail( ({ "spuren" }),
    "Das sieht fast nach Fussspuren aus. Sie kommen von Nordwesten und verteilen sich in der Hoehle.");
  AddDetail( ({ "fussspuren" }),
    "Wer auch immer diese Spuren hinterlassen hat, er war barfuss.");
  AddDetail( ({ "dicke wurzeln","dicke wurzel" }),
    "Die dicken Wurzeln unter der Decke sehen so stabil aus, dass man sich sogar an ihnen "
    "entlang hangeln koennte, wenn sie nicht zu weit oben waeren.");
  AddDetail( ({ "weiche wurzeln","weiche wurzel" }),
    "Die weichen Wurzeln an den Waenden kitzeln Dich sanft wenn Du an Ihnen vorbeigehst. Doch "
    "halt, was ist das Dunkle dort?");
  AddDetail( ({ "hoehle" }),
    "Die Hoehle ist nicht sehr gross und eher laenglich als rund.");
  AddDetail( ({ "dunkles","dunkle","dunkel" }),
    "Du kannst nicht erkennen, was es ist. Vielleicht kannst Du die Wurzeln beiseite schieben?");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");



  AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_15n.lpc");
  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_16p.lpc");
  AddExit("suedwesten", LABY_ROOM+"hoehlenlabyrinth_16n.lpc");
  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_15p.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_16o.lpc");
  AddCmd( ({ "schiebe", "schieb" }), "schieben" );

}


int schieben(string str)
{
	notify_fail("Was moechtest Du beiseite schieben?\n");
	if(str!="wurzeln beiseite")return 0;
	if(!fassda)
		write ("Du hast Dich wohl getaeuscht, da ist nichts.\n");
	else
		{
			write("Du schiebst die Wurzeln beiseite und ein kleines Fass kommt zum Vorschein.\n");
			say(TPN+ " schiebt die Wurzeln beiseite und ein kleines Fass kommt zum Vorschein.\n");
			CLONE(LABY_OBJ+"fass.lpc", TP);
			fassda=0;
		}
		return 1;
	}
			


