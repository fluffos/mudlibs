// Hier verlaesst man den Berg


#include "../def.h"
inherit "std/room";
#include <properties.h>

       

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem Bergspalt" );

  SetProp( P_INT_LONG,
    "Du stehst in einem Bergspalt, Dir gegenueber waechst die glatte Felswand des "
    "gegenueberliegenden Berges schier endlos in den blauen Himmel. Lediglich ein kleiner "
    "Felsvorsprung unterbricht die ansonsten glatte Wand. Du kannst ihn ueber einen Baum, der "
    "ueber dem Abgrund liegt, erreichen. Nach Suedosten gelangst Du tiefer in den Spalt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  

  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "Der kleine Felsvorsprung, ist kaum mehr als eine kleine Nase in "
    "einer ansonsten glatten Felswand und ist gerade so breit, dass man darauf stehen "
    "koennte. Darunter geht es in schwindelerregende Tiefen.");
  AddDetail( ({ "nase" }),
    "Der Felsvorsprung schaut aus der Felswand wie eine Nase aus einem Gesicht.");
  AddDetail( ({ "gesicht" }),
    "Die Felswand ist kein Gesicht, das war nur ein Vergleich.");
  AddDetail( ({ "vergleich" }),
    "Du hast den Felsvorsprung in der Felswand mit einer Nase in einem Gesicht verglichen "
    "und fandest das sehr passend.");
  AddDetail( ({ "abgrund", "tiefe","tiefen" }),
    "Der Abgrund scheint unendlich tief zu sein. Dir wird leicht schwindelig bei dem Anblick.");
  AddDetail( ({ "anblick" }),
    "Starr nicht so lange nach unten, sonst faellst Du noch.");
  AddDetail( ({ "felswand", "wand" }),
    "Die gegenueberliegende Felswand ist sehr glatt, und wird nur durch den Felsvorsprung unterbrochen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist leuchtend blau, hin und wieder siehst Du einen Vogel seine Kreise ziehen.");
  AddDetail( ({ "luft" }),
    "Du atmest ein paar mal tief ein und aus. Aaaaah, das tut gut!");
  AddDetail( ({ "boden" }),
    "Der Boden hier besteht aus Felsen und wird nach rechts und links eng durch die "
    "Waende des Felsspaltes begrenzt. Ein schmaler Weg fuehrt nach Suedosten.");
  AddDetail( ({ "suedosten" }),
    "Dorthin fuehrt Dich der Weg durch den Felsspalt.");
  AddDetail( ({ "steinchen" }),
    "Sie interessierren Dich nicht weiter als dass sie eine potenzielle Gefahr des "
    "Ausrutschens sind.");
  AddDetail( ({ "ausrutschen" }),
    "Wenn Du nicht aufpasst, rutscht Du aus und faellst unaufhaltsam in die Tiefe.");
  AddDetail( ({ "gefahr" }),
    "Gut, dass Du sie gesehen hast.");
  AddDetail( ({ "bergkluft","kluft" }),
    "Du stehst direkt in einer Kluft zwischen zwei Bergen. Du kannst den anderen "
    "Berg ueber den Baumstamm erreichen.");
  AddDetail( ({ "berge" }),
    "Eine Kluft teilt diese zwei Berge. Den, in dessen Spalt Du stehst und der mit dem "
    "Felsvorsprung, von dem Du kommst.");
  AddDetail( ({ "berg" }),
    "Du stehst auf einem von zwei Bergen. Gluecklicherweise stehst Du auf dem, von "
    "dem ein Weg abgeht.");
  AddDetail( ({ "haare" }),
    "Deine Haare wehen im Wind.");
  AddDetail( ({ "wind" }),
    "Der Wind weht kraeftig durch die Kluft. Du kannst ihm lauschen.");
  AddDetail( ({ "vogel" }),
    "Scheint ein Geier zu sein.");
  AddDetail( ({ "aasgeier","geier" }),
    "Der wartet vermutlich darauf, dass Du abstuerzt.");
  AddDetail( ({ "windboe","boe", "windboen" }),
    "Die Windboen werfen Dich fast um.");
  AddDetail( ({ "baum", "stamm", "baumstamm" }),
    "Den Baum hat vermutlich jemand abgesaegt um ueber den Abgrund gelangen zu koennen. Wie praktisch.");
 AddDetail( ({ "fels" }),
    "Der Fels ist grau, relativ glatt und kuehl.");
 AddDetail( ({ "weg" }),
    "Der Weg fuehrt zwischen den Felswaenden nach Suedosten.");
 AddDetail( ({ "waende","felswaende" }),
    "Die Felswaende stehen zwar recht eng beieinander, aber da passt Du locker durch.");
 AddDetail( ({ "kreise" }),
    "Der Vogel fliegt in ebenmaessigen Kreisen durch die Luft.");
 AddDetail( ({ "spalt", "felsspalt", "bergspalt"  }),
    "Der Berg ist gespalten und in diesem Spalt stehst Du.");
 AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist frisch und wohltuend.");
  AddSmell( ({ "luft","bergluft" }),
    "Gluecklich atmest Du die frische Bergluft ein..");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Der Wind zerrt an Deinen Haaren.\n",
    	"Hoppla, Du rutscht auf einem Steinchen aus und kannst Dich gerade noch halten.\n",
    	"Dir wird schwindelig.\n",
    	"Ein Aasgeier kreist ueber Dir.\n"
    	"Ein Steinchen kullert in die Tiefe.\n",
    	"Fast haette eine Windboe Dich vom Felsvorsprung geweht.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind durch die Kluft rauschen.");

  AddSound( ({ "wind", "" }),
    "Der Wind braust mit lautem Getoese durch die Kluft.");
  AddSound( ({ "kluft", "" }),
    "Es ist ziemlich laut hier.");
  AddSound( ({ "getoese", "" }),
    "Man kann kaum etwas anderes hoeren als den Wind.");





  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_24f.lpc");
  AddExit("baumstamm", LABY_ROOM+"hoehlenlabyrinth_22e.lpc");
	
}




