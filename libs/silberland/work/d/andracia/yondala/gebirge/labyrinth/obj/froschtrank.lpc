#include "../def.h"

inherit "std/thing";

#include <properties.h>




void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schrumpftrank");
  SetProp(P_LONG,
    "Du siehst ein kleines Reagenzglas, in dem sich eine dunkle Fluessigkeit befindet." );
  SetProp(P_NAME, "Schrumpftrank");
  SetProp(P_GENDER, MALE);
  AddId(({"glas","reagenzglas","trank","schrumpftrank","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_GLASS);
  SetProp(P_INFO, "Du kannst diesen Trank trinken. Welchen Effekt er haben wird, kannst Du allerdings nicht erkennen.\n");
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NODROP, 0);
  AddDetail( ({ "" }),
    ".");

  AddCmd(({"trinke", "trink"}),"trinken"); 
 }


int trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(!id(str)) return 0;
	write("Du trinkst den Trank und spuerst, wie sich alles in Dir zusammenzieht.\n");
	say(TPN+" trinkt einen Trank und wird ploetzlich klein und gruen.\n");
	TP->SetProp(P_FROG, 1);
	CLONE(LABY_OBJ+"entfroscher.lpc", TP);
	remove();
	return 1;
}