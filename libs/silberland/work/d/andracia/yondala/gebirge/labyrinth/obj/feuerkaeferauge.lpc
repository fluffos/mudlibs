
inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Feuerkaeferauge");
  SetProp(P_LONG,
    "Du siehst das Auge eines Feuerkaefers. Es ist klein, rund und schwarz. Leider leuchtet es nicht mehr. Du kannst es essen." );
  SetProp(P_NAME, "Feuerkaeferauge");
  SetProp(P_GENDER, NEUTER);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:2, 
											 F_HEAL:({5,5}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du schluckst ein Feuerkaeferauge herunter.", 
											 F_MSG_ROOM: "schluckt ein Feuerkaeferauge herunter."]));


  AddId(({ "auge", "feuerkaeferauge","\nlabyloeschmich" }));

  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);


 
}

