#include "../def.h"
//inherit "std/room";
inherit LABY_ROOM + "hoehlenlabyrinth_hangelhoehle.lpc";
#include <properties.h>


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem Gang unter der Erde" );
  
  SetProp( P_INT_LONG,
    "Du stehst in einem schmalen Gang der offensichtlich unter dem Erdreich liegt, denn alles "
    "besteht hier aus lehnmiger Erde, die von vielen Wurzeln durchbrochen ist die wirr aus "
    "Decke und Waenden brechen. Im Norden weitet sich der Gang zu einer Hoehle, im Sueden "
    "verliert er sich in der Dunkelheit." );

  AddDetail( ({ "gang" }),
    "Du stehst in einem schmalen, aber recht hohen Gang unter der Erde.");
  AddDetail( ({ "erde" }),
    "Du bist von feuchtem Erdreich umgeben.");
  AddDetail( ({ "erdreich" }),
    "Die Erde um Dich herum besteht aus Humus und Lehm, was Du an den unterschiedlichen "
    "Farben festmachst. Es ist an vielen Stellen von Wurzeln unterbrochen.");
  AddDetail( ({ "humus" }),
    "Schwarzer Humus dominiert das Erdreich. Er sieht sehr fruchtbar aus, die Pflanzen ueber Dir "
    "muessen gut wachsen.");
  AddDetail( ({ "pflanzen","pflanze" }),
    "Pflanzen siehst Du hier nicht, die sind weit ueber Dir, draussen. Aber weil Du ihre "
    "Wurzeln sehen kannst weisst Du, dass sie da sind.");
  AddDetail( ({ "lehm" }),
    "Hellbrauner Lehm durchsetzt das Erdreich hier und da.");
  AddDetail( ({ "farben","farbe" }),
    "Du siehst schwarzen Humus und hellbraunen Lehm.");
  AddDetail( ({ "norden" }),
    "Im Norden weitet sich der Gang und scheint in einer kleinen Hoehle zu muenden.");
  AddDetail( ({ "stellen" }),
    "Hier und da spriessen verschiedenste Wurzeln durch Decke und Waende.");
  AddDetail( ({ "decke" }),
    "Von der Decke haengen dicke Wurzeln herab. Sie sehen sehr stabil aus.");
  AddDetail( ({ "wurzeln" }),
    "Welche Wurzeln meinst Du? Die dicken Wurzeln unter der Decke oder die weichen Wurzeln "
    "an den Waenden?");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen wie alles hier aus einem Gemisch von Erde und Humus. Duenne, weiche "
    "Wurzeln haben sie durchbrochen und kitzeln Dich.");
  AddDetail( ({ "gemisch" }),
    "Waende, Decke und Boden bestehen aus einem Gemisch von Humus und Lehm.");
  AddDetail( ({ "boden" }),
    "Der Boden ist platt getrampelt. Du siehst einige Spuren.");
  AddDetail( ({ "spuren" }),
    "Das sieht fast nach Fussspuren aus. Sie fuehren von Norden nach Sueden.");
  AddDetail( ({ "fussspuren" }),
    "Wer auch immer diese Spuren hinterlassen hat, er war barfuss.");
  AddDetail( ({ "dicke wurzeln","dicke wurzel" }),
    "Die dicken Wurzeln unter der Decke sehen so stabil aus, dass man sich sogar an ihnen "
    "entlang hangeln koennte, wenn sie nicht zu weit oben waeren.");
  AddDetail( ({ "weiche wurzeln","weiche wurzel" }),
    "Die weichen Wurzeln an den Waenden kitzeln Dich sanft wenn Du an Ihnen vorbeigehst.");
  AddDetail( ({ "hoehle" }),
    "Die Hoehle im Norden sieht aus wie der Gang in dem Du stehst, nur etwas breiter. Du kannst "
    "hingehen, aber da Du dort herkommst wird es nicht sehr spannend sein.");
  AddDetail( ({ "sueden" }),
    "Du kannst dem Gang nach Sueden folgen. Allerdings siehst Du nicht, wass Dich dort erwartet.");
  AddDetail( ({ "dunkelheit" }),
    "Die Abwesenheit von Licht nennt man Dunkelheit.");
  AddDetail( ({ "licht" }),
    "Was nicht da ist, kann man nicht sehen.");
  AddDetail( ({ "abwesenheit" }),
    "Es ist keins da. Es sei denn, Du hast welches mitgebracht. Aber wirklich sehen kann man das "
    "Licht dann trotzdem nicht. Aber alles andere um Dich herum.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSmell( DEFAULT_SMELL,
    "Es riecht hier erdig.");
  AddSmell( ({ "erde" }),
    "Die Erde riecht feucht, aber nicht faulig.");

  AddRoomMessage( 
    ({"Die Wurzeln an den Waenden zucken.\n",
    	"Es raschelt ueber Dir.\n"}),60,"schnapp");

  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein leises Rascheln.");

  AddSound( ({ "rascheln" }),
    "Woher das wohl kommen mag?");


  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_19n.lpc");
  AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_17n.lpc");


}



