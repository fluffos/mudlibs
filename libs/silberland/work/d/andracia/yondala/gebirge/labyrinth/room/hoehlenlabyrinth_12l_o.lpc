//ein Loch, aus dem mach nicht rauskommt.

#include "../def.h"
inherit "std/room";
#include <properties.h>
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.

int stoepselgezogen;//wird von 12l gesetzt. Wenn man dann den Raum betritt, faellt man gleich durch.

void anfangszustand()
{
stoepselgezogen=0;
}

int jemandda()
{
	if(all_inventory())return 1;
	return 0;
}

//sollte alles, was drin ist nach unten befoerdern
int alleraus(object ob) 
{
   ob->move( LABY_ROOM + "hoehlenlabyrinth_12l.lpc", M_NOCHECK);
     return 1;
}


void allesrunter()
{
	mixed *people;
	stoepselgezogen=1;
	tell_room(TO, "Jemand dreht den Stoepsel von unten heraus, der Wasserstand sinkt, Du faellst durch das entstandene Loch nach unten.\n");
	people=filter_array( all_inventory(), #'interactive );
  map_array(people, #'alleraus);
    	
}

ertrinken_9()
{
	object anderer;
	if(present(TP,TO))
		{
      TP->SetProp(P_HP,0);
			anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
			tell_object(anderer, "[Tod:Lars] Ertrinken hat gerade "+TPN+" umgebracht.\n");
			tell_room(TO,"[Tod:Lars] Ertrinken hat gerade "+TPN+" umgebracht.\n");
			TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME: (-1),
      PARALYZE_MSG: " Dein Koerper gehorcht Dir nicht.\n",
      PARALYZE_MSG_OTHER: "%s zuckt.\n",
      PARALYZE_END: "Das Leben fliesst zurueck in Deine Adern.\n",
      PARALYZE_END_OTHER: "%s kehrt ins Leben zurueck.\n"]));
      //TP->SetProp(P_GHOST,1);

	//    call_out("ertrinken_2",120);
	   }
	}

ertrinken_8()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Dir wird schwarz vor Augen.\n");
	    call_out("ertrinken_9",3);
      TP->AddHp(-20);

	   }
	}


ertrinken_7()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Du kannst den Atem nicht mehr anhalten. Du spuerst, wie das eiskalte "+
			"Wasser in Deine Lunge fliesst.\n");
	    call_out("ertrinken_8",5);
      TP->AddHp(-50);
	   }
	}



ertrinken_6()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Dir wird schwindelig. Alles in Dir schreit nach Luft.\n");
	    call_out("ertrinken_7",5);
      TP->AddHp(-20);

	   }
	}

ertrinken_5()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Hektisch suchst Du unter Wasser nach einem Ausweg.\n");
	    call_out("ertrinken_6",10);
		  TP->AddHp(-20);

	   }
	}

//ab hier ist man dann unter Wasser, deswegen muessen sich ein paar Details etc aendern
ertrinken_4()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Du kannst nicht mehr, voellig erschoepft sinkst Du langsam nach unten.\n");
	    call_out("ertrinken_5",10);
  SetProp( P_INT_SHORT, "Unter Wasser" );
  SetProp( P_INT_LONG,
    "Du treibst langsam auf dem Grund eines grossen Beckens. Das Wasser ist eiskalt, Du bist erschoepft "
    "und kannst den Atem nicht mehr lange anhalten. Dir bleiben nur noch wenige Sekunden."
    "Lange wirst Du nicht mehr durchhalten." );
  AddDetail( ({ "grund","boden" }),
    "Du schwebst knapp ueberhalb des Grundes. Du siehst einige Bretter und etwas Seetang.");
  AddSmell( DEFAULT_SMELL,
    "Du bist unter Wasser, Du kannst hier nichts riechen.");
	RemoveSmell("nichts");
	RemoveSound(({"wasser","plaetschern"}));
	
  AddSound( DEFAULT_SOUND,
    "Du bist unter Wasser und hoerst nichts mehr, ausser Deinem rasenden Herzschlag.");

  AddSound( ({ "herz","herzschlag" }),
    "Dein Herz klopft wie verrueckt und scheint fast aus Deiner Brust springen zu wollen.");
  AddDetail( ({ "schwimmbewegungen","bewegungen" }),
    "Die hast Du aufgegeben, die Muedigkeit hat gesiegt.");
  AddDetail( ({ "leben" }),
    "Du bist nicht gewillt, Dein Leben hier zu lassen, also suchst Du verzweifelt einen Ausweg.");
  AddDetail( ({ "muedigkeit" }),
    "Die Muedigkeit hat gesiegt, Du bist zu stark erschoepft um weiter zu schwimmen.");
  AddDetail( ({ "ruhe" }),
    "Durch Deine Schwimmbewegungen hast Du das Wasser ganz schoen aufgewirbelt.");
  AddDetail( ({ "puste" }),
    "Genau genommen ist sie Dir schon ausgegangen, wenn Du nicht schnell einen Ausweg findest, "
    "wirst Du ertrinken.");
  TP->AddHp(-20);

	   }
	}

ertrinken_3()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Deine Arme und Beine fangen an zu zittern.\n");
	    call_out("ertrinken_4",15);
	   }
	}

ertrinken_2()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Langsam schwinden Deine Kraefte.\n");
	    call_out("ertrinken_3",20);
	   }
	}
ertrinken_1()
{
	if(present(TP,TO))
		{
			tell_room(TO,"Das Schwimmen wird immer anstrengender.\n");
	    call_out("ertrinken_2",20);
	   }
	}
			

durchfallen()//wenn der Stoepsel schon gezogen wurde, faellt man einfach durch
{
	write("Du plumpst in ein Becken und durch ein Loch.\n");
	
	this_player()->move(LABY_ROOM + "hoehlenlabyrinth_12l", M_GO, 0,
                  "faellt runter", "faellt aus einem Loch in der Decke");
	write("Du schlaegst hart auf dem Boden auf.\n");
	tell_room(environment(TO),TPN+" schlaegt hart auf dem Boden auf.\n",({TP}));
	TP->AddHp(-50);
}


void init()
{
	::init();
	if(stoepselgezogen) call_out("durchfallen",1);
	else 
		{
			write("Du faellst in ein Wasserbecken.\n");
			call_out("ertrinken_1",20);
		}
}
	
	

void create() 
{
  ::create();
  stoepselgezogen=0;
  SetProp( P_INT_SHORT, "In einem Wasserbecken" );
  SetProp( P_INT_LONG,
    "Du schwimmst in eisig kaltem Wasser. Du kannst nicht sehen, wo Du herkommst, noch "
    "wie Du wieder herauskommst. Da Du den Grund mit Deinen Fuessen nicht erreichen kannst "
    "schwimmst Du um Dein Leben. Lange wirst Du das nicht durchhalten." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_WATER]) );

  AddDetail( ({ "wasserbecken","becken" }),
    "Ploetzlich schwimmst Du in einem tiefen Wasserbecken. Wie bist Du hier bloss reingeraten?");
  AddDetail( ({ "grund","boden" }),
    "Der Grund ist weit unter Dir, Du kannst ihn nicht erreichen mit Deinen Fuessen. Aber sehen "
    "kannst Du ihn deutlich. Du siehst einige Bretter und etwas Seetang.");
  AddDetail( ({ "fuesse" }),
    "Deine Fuesse paddeln unter Dir herum und helfen dabei, Deinen Kopf ueber Wasser zu halten.");
  AddDetail( ({ "kopf" }),
    "Noch ist Dein Kopf ueber Wasser.");
  AddDetail( ({ "wasser" }),
    "Das Wasser ist kalt, aber ueberraschend klar. Deutlich kannst Du den Grund unter Dir "
    "erkennen.");
  AddDetail( ({ "bretter" }),
    "Die Bretter sind noch recht frisch. Vermutlich dienten sie einst als eine Art Bruecke.");
  AddDetail( ({ "art" }),
    "Sowas in der Art.");
  AddDetail( ({ "bruecke" }),
    "Eine Bruecke siehst Du hier nicht, aber Du gehst davon aus, dass die Bretter unter Dir "
    "einmal zu einer Bruecke gehoerten, die mittlerweile aber eingekracht ist.");
  AddDetail( ({ "seetang","tang" }),
    "Ein wenig Seetang hat sich in dem Becken gebildet. Durch Deine Schwimmbewegungen in seiner "
    "Ruhe gestoert, schwankt er leicht hin und her. Unter dem Seetank ist etwas Dunkles verborgen.");
  AddDetail( ({ "schwimmbewegungen","bewegungen" }),
    "Du schwimmst und paddelst um Dein Leben.");
  AddDetail( ({ "leben" }),
    "Du bist nicht gewillt, Dein Leben hier zu lassen, also schwimmst Du verzweifelt gegen "
    "Deine Muedigkeit an und suchst einen Ausweg.");
  AddDetail( ({ "muedigkeit" }),
    "Du bist schon stark erschoepft.");
  AddDetail( ({ "ausweg" }),
    "Wie kannst Du hier bloss rauskommen?");
  AddDetail( ({ "ruhe" }),
    "Durch Deine Schwimmbewegungen wirbelst Du das Wasser ganz schoen auf.");
  AddDetail( ({ "dunkles", "dunkle" }),
    "Das Dunkle sieht wie eine grosse, schwarze Scheibe aus.");
  AddDetail( ({ "scheibe" }),
    "Bei genauerer Betrachtung kommst Du zu dem Schluss, dass es sich um einen gigantischen "
    "Stoepsel handeln muss.");
  AddDetail( ({ "betrachtung" }),
    "Du solltest nicht alles so genau betrachten, Dir geht bald die Puste aus.");
  AddDetail( ({ "puste" }),
    "Wenn Dir die ausgeht, ertrinkst Du.");
  AddDetail( ({ "schluss" }),
    "Es siehst so aus, also gehst Du davon aus, dass es einer ist.");
  AddDetail( ({ "stoepsel" }),
    "Ob Du ihn rausdrehen kannst?");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sich feucht und glatt, unmoeglich an ihnen hochzuklettern.");
  AddDetail( ({ "decke" }),
    "Die Decke muss hoch ueber Dir sein, Du kannst sie nicht erkennen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),50,"func");

  AddSmell( DEFAULT_SMELL,
    "Es riecht definitiv nach nichts.");
  AddSmell( ({ "nichts" }),
    "Nichts.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst ab und an das Plaetschern von Wasser, natuerlich, Du spritzt ja auch ganz schoen "
    "damit herum.");

  AddSound( ({ "wasser","plaetschern" }),
    "Durch Deine panischen Bewegungen wirbelst Du ganz schoen viel Wasser auf.");


  AddCmd( ({ "drehe", "dreh"}), "rausdrehen" ); //ERfolgloser Versuch den Stoepsel rauszu drehen
  
}

int rausdrehen(string str)
{
	object anderer;
	notify_fail("Was moechtest Du herausdrehen?\n");
	if(str!="stoepsel raus"&&str!="stoepsel heraus") return 0;
	if(stoepselgezogen)
		{
			write("Der Stoepsel ist doch schon herausgedreht. Du solltest gar nicht hier sein.\n");
			return 1;
		}
	anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
	write("Du tauchst kurz unter und versuchst den Stoepsel zu drehen. Leider rutschen Deine "+
	"Finger immer wieder ab. Vermutlich kann man den Stoepsel nur von unten rausdrehen.\n"+
	"Hoffentlich ist da unten jemand.\n"+
	"Du denkst   . o O ("+anderer->name()+" ist doch bestimmt irgendwo da unten!)\n");
	return 1;
}
	



