// Hier kann man die Holzwand hochziehen, damit der unten durchkann
// solange sie unten ist, kann man noch zurueck


//es soll immer nur einen Ausgang geben, es sei denn, man dreht sich um

#include "../def.h"
inherit "std/room";
#include <properties.h>
int gucker;//bei 1 schaut er nach Norden
int wandda;//ist die Wand hochgezogen?
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  wandda=0;
  gucker =1;
              SetProp( P_INT_LONG,
              "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
              "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
              "drehen. Der Boden ist glatt und glitschig. Du schaust nach Suedosten." );
             AddDetail( ({ "boden" }),
               "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
               "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen.");
            RemoveDetail(({"norden", "gang","oberkante","kante","holzwand"}));
            AddSpecialExit( "norden", "nordlauf");
            RemoveSpecialExit("suedosten");

}

void nordausrichtung()//wird von den anderen Raeumen aufgerufen
{
  if(!wandda)
    {
      AddDetail( ({ "norden" }),
        "Du schaust nach Norden. Dorthin kannst Du auch kriechen, allerdings faellst Du dann "
        "wohl nach unten in den Gang zurueck.");
      AddDetail( ({ "gang" }),
        "Unten ist der Gang, durch den Du vorhin gelaufen bist.");
      AddDetail( ({ "oberkante", "kante", "holzwand" }),
        "Du siehst die Oberkante der Holzwand, sie ist rechts und links in die Waende eingelassen. "
        "Allerdings sieht sie beweglich aus, man kann sie vermutlich nach oben ziehen.");
      AddSpecialExit( "norden", "nordlauf");
       }
  else
       {
          AddDetail( ({ "norden" }),
            "Du schaust nach Norden direkt vor eine Holzwand.");
          AddDetail( ({ "holzwand" }),
            "Du starrst direkt vor eine Holzwand. Hier kommst Du sicher nicht weiter.");
          RemoveDetail(({"oberkante","kante"}));
          }
            
            
   SetProp( P_INT_LONG,
     "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
     "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
     "drehen. Der Boden ist glatt und glitschig. Du schaust nach Norden." );
   //AddSpecialExit( "norden", "nordlauf");
   RemoveSpecialExit("suedosten");
   gucker=1;

}

void suedausrichtung()
{
	            SetProp( P_INT_LONG,
              "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
              "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
              "drehen. Der Boden ist glatt und glitschig. Du schaust nach Suedosten." );
             AddDetail( ({ "boden" }),
               "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
               "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen.");
             AddDetail( ({ "suedosten" }),
               "Du kannst nach Suedosten den Schacht entlang kriechen.");

            RemoveDetail(({"norden", "gang","oberkante","kante","holzwand"}));
            RemoveSpecialExit("norden");
            AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_10m_o.lpc");
            gucker=0;
  }
      


void wandrunter()
{
  if(!gucker)//wenn er nach Suedosten guckt
    {
      tell_room(TO,"Hinter Dir rumpelt es.\n");
      wandda=0;
    }
  else
    {
      tell_room(TO,"Die Holzwand schiebt sich ploetzlich wieder nach unten.\n");
 
      SetProp( P_INT_LONG,
        "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
        "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
        "drehen. Der Boden ist glatt und glitschig. Du schaust nach Suedosten." );
      AddDetail( ({ "boden" }),
        "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
        "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen.");
      RemoveDetail(({"norden", "gang","oberkante","kante","holzwand"}));
      AddSpecialExit( "norden", "nordlauf");
      //RemoveExit("suedosten");
    }
  
  
  
}


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem engen Schacht" );
  CLONE("/obj/fackel.lpc", TO);
 
  gucker=1;
  wandda=0;
  SetProp( P_INT_LONG,
    "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
    "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
    "drehen. Der Boden ist glatt und glitschig. Du schaust nach Norden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "schacht" }),
    "Du kriechst gerade in einem sehr engen Schacht herum. Um zu sehen, was hinter Dir ist musst "
    "Du Dich umdrehen.");
  AddDetail( ({ "decke" }),
    "Die Decke ist so niedrig, dass Du kaum knien, geschweige denn stehen kannst. Auf allen "
    "Vieren kriechend stoesst Du Dir dennoch fast den Kopf.");
  AddDetail( ({ "vieren" }),
    "Die Decke hier ist so niedrig, dass Du auf allen Vieren kriechen musst.");
  AddDetail( ({ "kopf" }),
    "Deinen Kopf hast Du eingezogen, damit Du ihn Dir nicht stoesst.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind sehr eng beieinander. Mit etwas Muehe kannst Du Dich aber sicher umdrehen.");
  AddDetail( ({ "muehe" }),
    "Es ist nicht leicht, aber machbar.");
  AddDetail( ({ "boden" }),
    "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
    "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen. "
    "Direkt vor Dir siehst Du die Oberkante der Holzwand.");
  AddDetail( ({ "art" }),
    "Eine besonders schleimige Art. Kein Wunder, ist vermutlich auch nicht leicht bei der "
    "naehrstoffarmen Umgebung hier.");
  AddDetail( ({ "wunder" }),
    "Du wunderst Dich nicht.");
  AddDetail( ({ "umgebung" }),
    "Alles hier besteht aus dunklem Fels. Es gibt weder viel Platz, noch viel Sauerstoff.");
  AddDetail( ({ "platz" }),
    "Zwischen den Waenden und zwischen Decke und Boden ist nicht viel Platz, zumal ja auch noch "
    "DU dazwischen steckst.");
  AddDetail( ({ "sauerstoff" }),
    "Davon gibt es nicht viel. Und selbst wenn, so koenntest Du ihn trotzdem nicht sehen.");
  AddDetail( ({ "fels" }),
    "Decke, Boden und Waende bestehen aus dunklem Fels.");
  AddDetail( ({ "moos" }),
    "Das Moos scheint eine sehr einfache und genuegsame Art zu sein. Sonst wuerde es hier drin "
    "wohl auch kaum ueberleben.");
  AddDetail( ({ "norden" }),
    "Du schaust nach Norden. Dorthin kannst Du auch kriechen, allerdings faellst Du dann "
    "wohl nach unten in den Gang zurueck.");
  AddDetail( ({ "gang" }),
    "Unten ist der Gang, durch den Du vorhin gelaufen bist.");
  AddDetail( ({ "oberkante", "kante", "holzwand" }),
    "Du siehst die Oberkante der Holzwand, sie ist rechts und links in die Waende eingelassen. "
    "Allerdings sieht sie beweglich aus, man kann sie vermutlich nach oben ziehen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Wahrlich, es riecht nicht angenehm..");

  AddRoomMessage( 
    ({""}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Ausser Deinem Herzschlag und dem Blut, das durch Deine Schlaefen rauscht kannst Du nichts hoeren.");

  AddSound( ({ "herzschlag","schlag", "herz","brust" }),
    "Dein Herz schlaegt schnell und laut in Deiner Brust.");
  AddSound( ({ "blut", "rauschen" }),
    "So schnell Dein Herz schlaegt, so schnell rausch auch das Blut in Deinen Schlaefen.");
  AddSound( ({ "schlaefen" }),
    "Du hoerst ein stetes Rauschen.");


//  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_6m.lpc");
//  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_8l.lpc");
  AddSpecialExit( "norden", "nordlauf");
AddCmd( ({ "drehe", "dreh"}), "umdrehen" ); //sich umdrehen, um in die andere Richtung gucken zu koennen
AddCmd( ({ "ziehe", "zieh"}), "ziehen" ); //Holzwand hochziehen, damit der untere durchgehen kann.
AddCmd( ({ "druecke", "drueck", "schiebe","schieb"}), "druecken" ); //Holzwand wieder runter druecken


}
int druecken(string str)
{
	notify_fail("Was moechtest Du runterdruecken?\n");
	if(str!="wand runter"&&str!="holzwand runter") return 0;
	write("Du findest keinen Halt, die Wand laesst sich nicht bewegen.\n");

  return 1;
  }
  
  
int ziehen(string str)
{
  notify_fail("Was moechtest Du hochziehen?\n");
  if(str!="wand hoch"&&str!="holzwand hoch"&&str!="wand nach oben"&&str!="holzwand nach oben")return 0;
  if(GetExits()=="Es gibt einen sichtbaren Ausgang: norden.\n")
    {
      write("Du ziehst die Holzwand nach oben. Nun ist der Weg nach Norden versperrt.\n");
      RemoveSpecialExit("norden");
      call_other(LABY_ROOM + "hoehlenlabyrinth_8l", "wandhoch",0);//die Wand wird unten hochgezogen
      AddDetail( ({ "norden" }),
        "Du schaust nach Norden direkt vor eine Holzwand.");
      AddDetail( ({ "holzwand" }),
         "Du starrst direkt vor eine Holzwand. Hier kommst Du sicher nicht weiter.");
      RemoveDetail(({"oberkante","kante"}));

      wandda=1;
      return 1;
    }
  write("Die Wand ist doch bereits hochgezogen.\n");
  return 1;
}

int nordlauf(string dir)
{
  write("Du faellst nach unten.\n");
  TP->AddHp(-20);
  return this_player()->move(LABY_ROOM+"hoehlenlabyrinth_8l", M_GO, 0,
                  "kriecht nach Norden", "faellt herunter");
  }

int suedostlauf(string dir)
{
		//call_other(LABY_ROOM + "hoehlenlabyrinth_9l_o","nordausrichtung");

  call_other(LABY_ROOM+"hoehlenlabyrinth_10m_o","suedausrichtung");
  return this_player()->move(LABY_ROOM+"hoehlenlabyrinth_10m_o", M_GO, 0,
                  "kriecht nach Suedosten", "kommt hereingekrochen");
  }
  
  
int umdrehen(string str)
{
  notify_fail("Moechtest Du Dich umdrehen?\n");
  if(str=="um"||!str)
    {
      if(!wandda)
	  {
		  write("Du hast hier noch etwas zu erledigen, eh Du Dich umdrehst.\n");
		  return 1;
	  }
	  
	  write("Du drehst Dich muehsam um.\n");
      if(gucker==1)//wenn er nach Norden guckt
        {
            SetProp( P_INT_LONG,
              "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
              "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
              "drehen. Der Boden ist glatt und glitschig. Du schaust nach Suedosten." );
             AddDetail( ({ "boden" }),
               "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
               "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen.");
             AddDetail( ({ "suedosten" }),
               "Du kannst nach Suedosten den Schacht entlang kriechen.");

            RemoveDetail(({"norden", "gang","oberkante","kante","holzwand"}));
            RemoveSpecialExit("norden");
            AddSpecialExit( "suedosten", "suedostlauf");
             gucker=0;
          }
        else//wenn er nach Suedosten guckt
          {
            if(!wandda)
              {
                AddDetail( ({ "norden" }),
                  "Du schaust nach Norden. Dorthin kannst Du auch kriechen, allerdings faellst Du dann "
                  "wohl nach unten in den Gang zurueck.");
                AddDetail( ({ "gang" }),
                  "Unten ist der Gang, durch den Du vorhin gelaufen bist.");
                AddDetail( ({ "oberkante", "kante", "holzwand" }),
                  "Du siehst die Oberkante der Holzwand, sie ist rechts und links in die Waende eingelassen. "
                  "Allerdings sieht sie beweglich aus, man kann sie vermutlich nach oben ziehen.");
                AddSpecialExit( "norden", "nordlauf");
              }
            else
             {
                AddDetail( ({ "norden" }),
                  "Du schaust nach Norden direkt vor eine Holzwand.");
                AddDetail( ({ "holzwand" }),
                  "Du starrst direkt vor eine Holzwand. Hier kommst Du sicher nicht weiter.");

              }
            
            
              SetProp( P_INT_LONG,
              "Du kriechst hier in einem engen Schacht. Die Decke ist so niedrig, dass Du nicht stehen "
              "kannst, die Waende sind so nah beieinander, dass es Dir schwer fallen wird Dich um zu "
              "drehen. Der Boden ist glatt und glitschig. Du schaust nach Norden." );

            RemoveDetail(({"suedosten"}));
            RemoveSpecialExit("suedosten");
            gucker =1;
          }
      return 1;
    }
      
      
    return 0; 
  }



 