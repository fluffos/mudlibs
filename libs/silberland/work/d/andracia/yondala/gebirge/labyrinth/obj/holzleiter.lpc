#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Holzleiter");
  SetProp(P_LONG,
    "Du siehst eine grosse, schwere Holzleiter mit zehn Sprossen. Man kann sicher "
    "an ihr hochklettern." );
  SetProp(P_NAME, "Holzleiter");
  SetProp(P_GENDER, FEMALE);
  AddId(({"holzleiter","leiter","\nlabyloeschmich"}));
SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 0);
 AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern

}
int klettern(string str)
{
	notify_fail("Wo moechtest Du denn hinklettern?\n");
	if(str!="rauf"&&str!="hinauf"&&str!="hoch"&&str!="nach oben"&&str!="zum gang") return 0;

	if(file_name(environment(TO))==LABY_ROOM+"hoehlenlabyrinth_7d"||
		file_name(environment(TP))==LABY_ROOM+"hoehlenlabyrinth_7d")
	return 0; //Dann geht er in die Raumfunktion 
	
	write("Du kletterst die Leiter hoch, da oben aber nichts spannendes ist, kletterst Du wieder runter.\n");
	return 1;
}
		

	