
#include "../def.h"
inherit "std/room";
#include <properties.h>

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  AddSpecialExit("nordwesten","nordwestengeher");
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem finsteren Gang" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier in einem finsteren Gang. Viel kannst Du hier nicht erkennen, ausser, dass "
    "er nach Osten nach Nordwesten fuehrt. Was dort jedoch "
    "ist, kannst Du nicht sehen, die dunkelgrauen Waende scheinen jedes Licht zu verschlucken." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
     "Der Gang fuehrt Dich nach Osten nach Nordwesten. Er besteht nur aus dunklem Fels." );
  AddDetail( ({ "richtung" }),
    "Du kannst hier nach Osten nach Nordwesten gehen.");
  AddDetail( ({ "nordwesten", "osten" }),
    "Dorthin fuehrt Dich der Gang, wenn Du Dich traust einfach in die Dunkelheit zu gehen.");
  AddDetail( ({ "dunkelheit","ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich erwartet wenn Du den Gang weiter entlang gehst.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Allerdings ist er nicht natuerlich entstanden, denn "
    "Du kannst deutlich die Bearbeitungsspuren sehen.");
  AddDetail( ({ "waende" }),
    "Die Waende sind sehr dicht beieinander, fast kannst Du beide gleichzeitig beruehren.");
  AddDetail( ({ "decke" }),
    "Die niedrige Decke ist nur knapp ueber Dir. Hoffentlich stoesst Du Dir nicht Deinen Kopf.");
  AddDetail( ({ "wand" }),
    "Die beiden Waende rechts und links von Dir kommen Dir bedrohlich nahe. Oder taeuscht Dich "
    "Dein Gefuehl?");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Jemand hat diesen Gang muehsehlig in den Fels geschlagen, er ist nicht natuerlich entstanden.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, kalt und ein wenig feucht.");
  AddDetail( ({ "gefuehl" }),
    "Kannst Du Deinen Gefuehlen trauen?");
  AddDetail( ({ "kopf" }),
    "Der ruht fest auf Deinen Schultern.");
  AddDetail( ({ "schultern" }),
    "Die hast Du leicht angezogen.");
  AddDetail( ({ "licht" }),
    "Das Licht wird von den dunklen Waenden fast gaenzlich verschluckt.");
  AddDetail( ({ "druck" }),
    "Der ist zwar unangenehm, wird Dich aber vermutlich nicht umbringen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "platsch", "platschen", "tropfen" }),
    "Irgendwo tropft es, leider siehst Du nicht wo.");
  AddSound( ({ "ohren" }),
    "Deine Ohren klingen normal. Wie Ohren.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Vielleicht sollte hier mal gelueftet werden.");

  AddRoomMessage( 
    ({"Die Stille lastet schwer auf Dir.\n",
    	"Ein leichter Druck legt sich auf Deine Ohren.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Ein Tropfen faellt mit lautem *Platsch* auf den Boden.\n"}),80,"func");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");

  AddSound( ({ "totenstille","stille" }),
    "Dir ist unwohl zumute. Irgendetwas stimmt hier nicht.");


  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_20j.lpc");
  AddSpecialExit("nordwesten","nordwestengeher");
}

int nordwestengeher(string dir)
{
	RemoveSpecialExit("nordwesten");
	write("Du gehst nach Nordwesten.\nPloetzlich bewegt sich eine Wand hinter Dir. Der Durchgang ist verschlossen.\n");
	return TP->move(LABY_ROOM + "hoehlenlabyrinth_19h", M_GO,0,
	                "geht nach Nordwesten.\nPloetzlich verschiebt sich eine Wand. Der Durchgang ist verschlossen","nach nordwesten");
}

	
