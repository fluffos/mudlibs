
#include "../def.h"

inherit "std/thing";

#include <properties.h>


void weg()
{
	tell_object(environment(TO), "Das Geheimnis loest sich auf und verwandelt sich in einen Gnadenschluessel.\n");
	CLONE(LABY_OBJ + "bootschluesselgnade.lpc",(environment(TO)));
	remove();
}


geheimeinfo(string str)
{

	if(find_call_out("geheimeinfo")==-1)
	call_out("weg",30);
	return("Glueckwunsch, wenn man mit Forschen nicht weiterkommt, dann halt mit Gewalt.\n"+
    "Der Schluessel, den Ihr fuer das Boot braucht, war in einem Raum ganz am Anfang, wenn man "+
    "nach Nordosten geht und runterfaellt.\n");  
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Geheimnis");
  SetProp(P_LONG,
    "Du haelst das Geheimnis des kleinen, toten Maennleins in den Haenden." );
 /* SetProp(P_INFO,
    "Glueckwunsch, wenn man mit Forschen nicht weiterkommt, dann halt mit Gewalt.\n"+
    "Der Schluessel, den Ihr fuer das Boot braucht, war in einem Raum ganz am Anfang, wenn man "
    "nach Nordosten geht und runterfaellt." );*/
  SetProp(P_LONG,#'geheimeinfo );
  
  
  SetProp(P_NAME, "Geheimnis");
  SetProp(P_GENDER, NEUTER);
  AddId(({"geheimnis","\nlabyloeschmich"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);

}

