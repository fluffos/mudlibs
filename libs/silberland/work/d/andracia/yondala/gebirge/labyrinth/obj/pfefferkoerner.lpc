#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine handvoll Pfefferkoerner");
  SetProp(P_LONG,
    "Du haelst einige Pfefferkoerner in den Haenden." );
  SetProp(P_NAME, "handvoll Pfefferkoerner");
  SetProp(P_GENDER, FEMALE);
  AddId(({"koerner","Pfefferkoerner","pfefferkoerner", "pfeffer","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);

}

void zerstossen()
{
  SetProp(P_SHORT, "Eine handvoll zerstossene Pfefferkoerner");
  SetProp(P_LONG,
    "Du haelst einige zerstossene Pfefferkoerner in den Haenden." );

  AddId(({"\nzerstossenepfefferkoerner"}));	
}