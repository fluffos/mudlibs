#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit LABY_NPC + "zs_burgbewohner.lpc";

#define TY(x)
//#define TY(x) if(find_player("yason")) tell_object(find_player("yason"),x)
	
void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
  create_default_npc(14); //erstellt Standartwerte für LABY_NPC des Level x

  //Properties
  AddId(({"sindar", "tucher", "Sindar Tucher", "bibliothekar" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Sindar Tucher, der Bibliothekar");
  SetProp( P_LONG, 
  BS("Dies ist Sindar Tucher, der Bibliothekar. Ein aelterer Herr dessen Wissen fast unerschoepflich wirkt. "+
  "Falls man was wissen will so ist man bei ihm an der richtigen Stelle. " ));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Sindar Tucher");
  SetProp( P_MNPC_AREA, BURG + "zs_burg_og3_a" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_og3_a2" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS ); // Bewegungsmöglichkeiten
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
  SetProp( P_NOATTACK, "darf nicht sterben.");
  set_living_name("sindar");
  
  //Chats
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  //Einfuehrungsinfos
  AddInfo( ({"forschen"}), 
    "So will ich Euch ein bischen die Grundlagen des Forschens erklaeren. Wenn Ihr euch umschauen wollt "+
    "so verwendet die Syntax \'schau\'. Falls euch irgendwas besonders interessiert verwendet \'untersuche\'. "+
    "Falls ihr ein entsprechendes Buch durchlesen wollt so verwendet zum Beispiel \'hilfe schau\'. ",
    "sagt: ");
  AddInfo( ({"kommunikation"}), 
    "So will ich Euch ein bischen die Grundlagen der Kommunikation erklaeren. Wenn Ihr euch mit Personen "+
    "im gleichen Raum unterhalten wollt so verwendet \'sag\' oder ein einfaches Hochkomma vor eurem Text. Falls ihr spezielle Fragen habt so "+
    "verwendet \'frage <wen> nach <was>\'. Wenn ihr euch ueber groessere Distanz unterhalten wollt so "+
    "muesst ihr mich nach \'ebenen\' fragen. "+
    "Falls ihr ein entsprechendes Buch durchlesen wollt so verwendet zum Beispiel \'hilfe sag\'. ",
    "sagt: ");
  AddInfo( ({"reisen", "reise"}), 
    "So will ich Euch ein bischen die Grundlagen der Fortbewegung erklaeren. Wenn Ihr fortbewegen moechtet "+
    "so muesst ihr euch nur anschauen was fuer Ausgaenge Euer aktueller Standort bietet. Im Normalfall sind es "+
    "Himmelsrichtungen. Manchmal muss man aber auch klettern oder springen. Dies muesst ihr dann ueber die "+
    "entsprechende Syntax. Wenn ihr ueber groessere Distanz reisen wollt so muesst ihr ein Transportmittel "+
    "nutzen. Hier oben auf dem Dach zum Beispiel kann Euch ein Adler zur Elfenstadt bringen. "+
    "Falls ihr ein entsprechendes Buch durchlesen wollt so verwendet zum Beispiel \'hilfe reise\'. ",
    "sagt: ");
  AddInfo( ({"kampf", "kaempfen"}), 
    "Kaempfen ist in Andracia leider unerlaesslich. Es gibt viel zuviele aggressive Wesen die Euch als "+
    "potentielle Nahrung oder als Gefahr ansehen. Dagegen muesst ihr euch ruesten und Eure Kampffertigekeiten "+
    "verbessern um in diesem Land ueberleben zu koennen. Ihr koennt Waffen \'zuecken\' und Ruestungen \'anziehen\'. "+
    "Falls ihr ein entsprechendes Buch durchlesen wollt so verwendet zum Beispiel \'hilfe ziehe\'. ",
    "sagt: ");
  AddInfo( ({"ebenen", "ebene"}), 
    "Um sich ueber weite Entfernungen zu bereden werden Ebenen verwendet. Mit \'ebene\' oder - kann man sich "+
    "in den Ebenen unterhalten. Diese Kommunikationsform ist die gebraeuchlichste und man sollte immer mithoeren "+
    "was sich auf der Ebene [Allgemein] so alles tut. "+
    "Falls ihr ein entsprechendes Buch durchlesen wollt so verwendet zum Beispiel \'hilfe ebenen\'. ",
    "sagt: ");
  AddInfo( ({"buch", "buecher", "buechern"}), 
    "Ihr seid hier in einer Bibliothek mit sehr, sehr vielen Buechern. Und es ist besonders einfach diese zu lesen. "+
    "Verwendet einfach \'hilfe <thema>\' um von ueberall im Andracia das entsprechende Buch zu Euch zu rufen.",
    "sagt: ");

  AddInfo( ({"information", "informationen", "info", "infos" }),
    "Wollt Ihr wissen wie man seine Umgebung erkundet, so fragt mich nach \'forschen\'. Wollt Ihr wissen wie man "+
    "sich mit anderen unterhaelt, so fragt mich nach \'kommunikation\'. Wollt Ihr wissen wie man sich in Andracia "+
    "fortbewegt, so fragt mich nach \'reisen\'. Wollt Ihr wissen wie man in Andracia kaempft, so fragt mich nach \'kampf\'. ",
    "sagt: ");

  AddInfo( ({"nix"}), "Fragt mich doch bitte etwas sinnvolles.", "sagt: ");
  AddInfo( ({"quests", "raetsel", "arbeit", "aufgabe", "hilfe", "aufgaben"}), 
    "Dazu kann ich euch leider nichts sagen. Ich kenne die Welt da draussen nur aus meinen Buechern.", "sagt: ");
  AddInfo( ({"magiesteine", "magiestein"}), 
    "Magiesteine sind sehr selten. Aber leider weiss ich nur wenig ueber diese Steine. Zauberer muessten mehr darueber wissen.", "sagt: ");
  AddInfo( ({"rat"}), "Ich bin nur ein einfacher Bibliothekar. Ich hab mein Wissen nur aus den Buechern die Ihr hier seht. "+
    "Vielleicht kann euch Christobal, der Seefahrer, weiterhelfen, der ist schon in fast ganz Andracia gewesen.", "sagt: ");
  AddInfo( ({"christobal"}), "Christobal ist ein erfahrener Seefahrer der ganz Andracia schon besucht hat.", "sagt: ");
  AddInfo( ({"elfenahnen"}), "Ah - ja hier ist ein Buch ueber die Elfen und ihre Ahnen: Acht Elfen gruendeten Aboriville "+
    "Alyna, Lelo, Ayala, Tasinion, Almana, Belenos, Ariana, Antware.", "sagt: ");
  AddInfo( ({"alyna", "lelo", "ayala", "tasinion", "almana", "belenos", "ariana", "antware"}), 
    "Nach diesem Buch ueber Elfenahnen ist das der Name eines Gruenders der Stadt Aboriville.", "sagt: ");
  AddInfo( ({"aboriville", "elfenstadt"}), "Aboriville ist die Stadt der Elfen. Leider war ich noch nie dort.", "sagt: ");
  AddInfo( ({"wissen"}), "Mein Wissen stammt aus den Buechern hier.", "sagt: ");
  AddInfo( ({"welt", "andracia"}), "Ich hab bisher nur wenig von der Welt gesehen, wohl aber viel darueber gelesen. "+
    "Ist es wirklich so gefaehrlich durch das Land zu reisen?", "sagt: ");
  AddInfo( ({"bloedsinn"}), "Das ist das was Ihr gerade macht.", "sagt: ");
  AddInfo( ({"karte"}), 
    "Leider habe ich hier keine Karten von Andracia. Es soll aber eine magische Karte geben, die"+
    "dem Betrachter immer die naehere Umgebung zeigt.", "sagt: ");
  AddInfo( ({"einfuehrung", "einleitung"}), "", "sagt: ");
  AddInfo( ({"ausruestung"}), "Ein Abenteurer ist nur so gut wie seine Ausruestung. Wichtig ist die Waffe "+
    "mit der Ihr euch durch Andracia schlagen muesst. Um aber zu ueberleben muesst ihr eine entsprechende Ruestung "+
    "anlegen. Ich kann euch leider keine Ausruestung geben aber vielleicht bekommt ihr ja von unserem "+
    "Freiherrn etwas wenn ihr fuer ihn einen Aufgabe erfuellen wollt.", "sagt: ");
  AddInfo( ({"waffe", "waffen"}), "Es gibt sehr viele verschiedene Waffen in Andracia. Vom einfachen Knueppel "+
    "bis zum goldenen Schwert der Verdammnis. Als Zauberer ist man scheinbar staendig auf der Suche nach einem "+
    "besseren Zauberstab. Ob ihr aber mit einem Morgenstern oder einem Speer euch gegen die boesen Schergen "+
    "zur Wehr setzt auf euren Reisen bleibt euch ueberlassen.", "sagt: ");
  AddInfo( ({"ruestung", "ruestungen"}), "Um sich gegen Angriffe zu schuetzen koennt Ihr euren Koerper "+
    "in allerlei Ruestung zwaengen. Es gibt soviele verschiedenste Ruestungen dass es zu schwer ist euch "+
    "hierzu irgendetwas zu empfehlen. Aber einfache Sandalen sind bestimmt nicht so gut geeeignet als schwere "+
    "Eisenstiefel. Wenn ihr moechtet kann unser Schmied im Hof fuer euch verschiedene Ruestungen detailliert "+
    "vergleichen." , "sagt: ");
  AddInfo( ({"helm", "helme"}), "Ein Helm schuetzt euren Kopf, kann eure Wahrnehmung aber auch einschraenken. ", "sagt: ");
  AddInfo( ({"stiefel", "schuhe", "schuhwerk"}), "Ein gutes Schuhwerk sollte jeder Reisende haben. Nicht nur wenn man "+
    "ueber spitze Steine schreiten muss, auch wenn man weite Strecken zu Fuss gehen muss sind gute Schuhe unerlaesslich.", "sagt: ");

  AddInfo( ({"elfen", "elf", "elfe" }), "Elfen sind ein komisches Volk. Es gibt verschiedene Unterrassen die alle ihre eigenen "+
    "Besonderheiten haben. Blauelfen sind eins mit der Magie aber daher auch eher schwaechlich. Waldelfen sind der Natur sehr verbunden. "+
    "Auch wird von Wasserelfen berichtet die im Meer und in Seen ihre Heimat haben. Allen Elfen jedoch ist gemein dass Sie kein "+
    "Fleisch essen, sie werden davon krank." , "sagt: ");
  AddInfo( ({"menschen", "mensch"}), "Viele Menschen bevoelkern Andracia. Zwerge, Elfen und Halblinge haben in grauer "+
    "Urzeit zwar schon vor den Menschen hier gesiedelt, aber ihre Zahl ist bei weitem nicht so hoch. Auch bei den "+
    "Menschen gibt es Unterrassen neben dem einfachen Volke das hier lebt. Im Norden, im ewigen Eis leben "+
    "Eskimos, die sich an die harten Winter dort angepasst haben. Am Meer leben die Wikinger, ein Volk rauher Seefahrer. "+
    "In der Wueste koennt ihr Teiheb finden, ein wildes Raeubervolk. In den Waeldern und Steppen sind Indianer beheimatet, "+
    "aber erschreckt nicht ueber ihre ungewoehnlichen Braeuche. "  , "sagt: ");
  AddInfo( ({"zwerg", "zwerge"}), "In den Bergen und in tiefen Hoehlen kann man die Zwerge beim Schuerfen und Schmieden beobachten. ", "sagt: ");
  AddInfo( ({"fee", "feen"}), "Feen sind kleine gefluegelte Wesen. Vielleicht verirrt sich ja mal eine hier in meine Bibliothek. ", "sagt: ");
  AddInfo( ({"troglodyt", "troglodyten"}), "Wie Zwerge sind Troglodyten in Hoehlen tief in der Erde zu Hause. Sie sind blind und koennen "+
    "daher mit Buechern nichts anfangen. ", "sagt: ");
  AddInfo( ({"troll", "trolle"}), "Trolle sind grobschlaechtige Kerle mit einem Hang zu Gewalt. Wenn Euch solch ein grosser "+
    "Bewohner Andracias aus welchem Grund auch immer ans Leder will so muesst ihr mit Waffen gut umgehen koennen oder schnell davon laufen. ", "sagt: ");
  AddInfo( ({"oger"}), "Oger sind etwas kleiner als Trolle aber genauso unberechenbar und aggressiv. Ob "+
    "ein Oger vom Intellekt her mehr als ein Troll zu bieten hat kann ich nicht sagen, aber sie sprechen wenigsten.", "sagt: ");
  AddInfo( ({"inuit", "eskimos", "eskimo"}), "Eskimos leben hoch im Norden im ewigen Eis. Es ist mir ein Raetsel wovon sich dieser "+
    "Menschenschlag in dieser unwirtlichen Umgebung ernaehrt. ", "sagt: ");
  AddInfo( ({"teiheb", "wuestenmenschen"}), "Das Wuestenvolk der Teiheb ist ein besonderer Menschenschlag: Die Wueste zwingt "+
    "die dort lebenden Menschen zu einem kargen Leben und daher wurden die Teiheb zu einem rauhbeinigen Stamm mit "+
    "einigen sehr eigtenartigen Braeuchen.", "sagt: ");
  AddInfo( ({"wikinger", "nordmaenner", "nordmann"}), "Die Wikinger sind ein lustiges Volk von "+
    "muskelbepackten, nordischen Seefahrer. Allerdings wird auch davon berichtet ihre Schiffe seien ein Zeichen "+
    "einer baldigen Pluenderung. ", "sagt: ");
  AddInfo( ({"indianer", "rothaut", "rothaeute"}), "Ueber Indianer konnte ich nur wenig Buecher finden. Einzig dass Sie ungewoehnliche "+
    "Braeuche haben, im Wald leben und einen roetlichen Teint haben konnte ich herausfinden.", "sagt: ");
  AddInfo( ({"halblinge", "halbling"}), "Halblinge sind ein gemuetliches Volk, etwas kleinerer, und dem Menschen "+
    "in Aussehen und Gebahren doch sehr aehnlich. Gastfreundschaft ist fuer Halblinge etwas sehr Wichtiges. "+
    "Jeden kleinen Anlass nutzen die Halblinge als Vorwand ein ueppiges Festmahl zu veranstalten. "+
    "Auch sind Halblinge dem Alkohol und dem Rauchen nicht abgeneigt." , "sagt: ");
  AddInfo( ({"blauelfen"}), 
    "Blauelfen sind sehr merkwuerdige Geschoepfe. Sie sind der Magie so sehr nahe dass sie ihre magischen Kraefte direkt aus ihrer "+
    "Lebenskraft schoepfen. Auch wenn ihre Erscheinung eher schemenhaft ist, so erkennt man doch noch dass es Verwendte der Elfen sind.", "sagt: ");

  AddInfo( ({"forscherpunkte", "forschernatur"}), "Je mehr ihr euch umseht, eure Neugier befriedigt und Orte besucht, die man "+
    "nur schwer erreichen kann, waechst eure Erfahrung. Ihr muesst nicht jeden Stein umdrehen, aber unter dem einen oder anderen Stein "+
    "findet sich doch etwas. "  , "sagt: ");
  AddInfo( ({"zaubertrank", "zaubertraenke"}), "Ihr werdet hin und wieder kleine, ganz besondere Zaubertraenke finden. "+
    "Ihr werdet es erkennen sobald ihr einen gefunden habt. ", "sagt: ");
  AddInfo( ({"npc", "npcs"}), "Nicht jeder in Andracia ist wie ihr. Es gibt auch viele Wesen die nicht "+
    "durch die Welt reisen und Abenteur bestehen. ", "sagt: ");
  AddInfo( ({"attribute"}), "Ihr habt vier Attribute: Kraft, Ausdauer, Intelligenz und Geschicklichkeit. "+
    "Diese beschreiben im Allgemeinen wie ihr beaschaffen seid. Ob kraeftig oder geschickt, ob ausdauernd oder "+
    "schlau. ", "sagt: ");
  AddInfo( ({"attributpunkte"}), "Falls ihr euch in Abenteuern oder Kaempfen bewaehrt, erhaltet ihr "+
    "Attributpunkte, mit denen ihr jeweils ein Attribut um einen Punkt erhoehen koennt. In Tempeln und "+
    "Gilden koennt ihr dies anwenden. " , "sagt: ");
  AddInfo( ({"int", "intelligenz"}), "Intelligenz bestimmt wie gut ihr mit Magie umgehen koennt, ob Ihr einen "+
    "Mechanismus versteht oder die Folgen eurer Taten abschaetzen koennt.", "sagt: ");
  AddInfo( ({"dex", "geschicklichkeit", "ges"}), "Mit Geschicklichkeit kann man vieles beschreiben: ob ihr "+
    "einen Sprung ueber den Abgrund schafft oder die Unruh in einer Uhr einbauen koennt. Viel wichtiger ist "+
    "aber ob ihr mit eurer waffe umgehen koennt oder so geschickt seid dem Schalg eines Trolls mit seiner "+
    "Keule ausweichen koennt.", "sagt: ");
  AddInfo( ({"kon", "ausdauer", "aus"}), "Ein gewisses Mass an Ausdauer ist immer noetig, ob ihr nun einen grossen "+
    "Rucksack auf der Schulter habt, eine grosse Streck im Dauerlauf zurueck legt oder euer gestaehlter Koerper "+
    "dem Feueratem eines Drachen stand halten muss.", "sagt: ");
  AddInfo( ({"str", "kraft"}), "Seid ihr ein Meister im Steine umdrehen? Mit Kraft bekommt man so manche Tuer auf. "+
    "Auch entscheidet eure Kraft darueber ob ihr im Kampf eurem Gegner grosse Wunden beibringen koennt.", "sagt: ");
  AddInfo( ({"stufe", "stufen"}), "Stufen geben wider wie weit ihr euch schon in Abenteuern und Kaempfen bewaehrt habt. "+
    "Mit jeder neuen Stufe bieten sich euch mehr Moeglichkeiten, ihr koennt bessere Waffen verwenden und weitere "+
    "Zauber erlernen.", "sagt: ");
  AddInfo( ({"abenteuerpunkte"}), "Sobald ihr erfolgreich ein Abenteuer bestanden habt, erhaltet ihr Abenteuerpunkte. "+
    "Diese Punkte geben wider wie gut ihr euch als Abenteurer geschagen habt.", "sagt: ");
  AddInfo( ({"erfahrung", "erfahrungspunkte"}), "Jeden Gegner den ihr bekaempft, Hilfe die Ihr leistet und "+
    "Abenteuer die ihr besteht liefert euch viele Erfahrungspunkte. Sobald ihr genuegend gesammelt habt koennt "+
    "Ihr um eine Stufe aufsteigen.", "sagt: ");
  AddInfo( ({"leben", "lebenspunkte"}), "Lebenspunkte geben an wie euer aktueller Zustand ist, ob ihr verwundet seid oder "+
    "ob ihr kurz vor eurem Tod steht. Sollten eure Lebenspunkte unter Null fallen so sterbt ihr! Das ist zwar nicht das Ende "+
    "eurer Abenteuer aber trotzdem solltet ihr vermeiden dem TOD zu begegnen. ", "sagt: ");
  AddInfo( ({"tod", "sterben"}), "Falls eure Lebenspunkte unter Null fallen, so scheidet Ihr dahin und fuehrt fortan ein "+
    "Geisterdasein. Es gibt die Sage dass ein inniges Gebet im Tempel wieder neues Leben in eure Gleider fahren laesst.", "sagt: ");
  AddInfo( ({"magie", "magiepunkte"}), "Immer wenn ihr Magie wirkt, so verbraucht Ihr Magiepunkte. Falls euch nicht genuegend "+
    "Maggiepunkte zur Verfuegug stehen, so werdet ihr den jeweiligen Zauber auch nicht wirken koennen. Blauelfen, die Ihre immense "+
    "magische Kraft aus dem Leben selbst ziehen, muessen darauf achten sich durch Zauberrei nicht selbst in Gefahr zu bringen. ", "sagt: ");

  AddInfo( ({"faehigkeit", "faehigkeiten"}), "Es gibt sehr viele Faehigkeiten, die Ihr euch aneignen koennt. "+
    "Neben Zaubern, die in jeder Gilde und Zunft unterschiedlich sind, koennt ihr auch erweiternden Geschick "+
    "im Umgang mit Waffen erwerben. Auch soll man manch Handwerk erlernen koennen."  , "sagt: ");
  AddInfo( ({"gilde", "gilden", "zunft", "zuenfte", "gemeinschaften", "gemeinschaft"}), 
    "In Andracia gibt es verschiedene Gemeinschaften die besondere Faehigkeiten und Zauber vermitteln. "+
    "Die bekannteste Zunft dieser Art sind die Zauberer die Im Marmorturm ihren Sitz haben. Aber man kann "+
    "sich auch den Piraten anschliessen, oder einfach ein Abenteurer bleiben. ", "sagt: ");
  AddInfo( ({"gildenstufe", "zunftstufe"}), 
    "Fuer Abenteurer ist die Stufe und die Gildenstufe identisch. Bei Zauberern, Piraten und den anderen "+
    "Gemeinschaften beschreibt die Gilden- oder Zunftstufe welchem Rang ihr innerhalb der Zunft bekleidet. ", "sagt: ");
  AddInfo( ({"zauberer", "zaubererzunft", }), "Die Zaubererzunft hat ihren Sitz im Marmorturm. man erkennt einen Zauberer "+
    "an seinem Zauberstab. Jeder Zauberer scheint immer auf der Suche nach einem weiteren Zauberstab.", "sagt: ");
  AddInfo( ({"abenteurer"}), "Die Gemeinschaft der Abenteurer nimmt jedermann auf. Auch kann jeder dort "+
    "einige Zauber und Faehigkeiten erlernen mit denen man sich durch Andracia besser seiner Gegner "+
    "erwehren kann.", "sagt: ");
  AddInfo( ({"pirat", "piraten", "piratenmeute"}), "Piraten sind rauhe Kerle die zu derben Spaessen aufgelegt sind. "+
    "Sie nehmen jeden Rauhbein ab einer gewissen Groesse auf, Elfen sind die Piraten verhasst und ich "+
    "habe auch noch nie von einem Feenpiraten gehoert.", "sagt: ");
  AddInfo( ({"spieler"}), "Euch werden einige weitere Abenteurer auf euren Reisen begegnen. Seid freundlich und "+
    "beleidigt niemanden wenn ihr euch unterhaltet. ", "sagt: ");
  AddInfo( ({"weg", "wege", "pfade", "pfad", "strasse", "strassen"}), "Ich kann euch nur empfehlen dem "+
    "Burgherrn eure Dienste anzubieten. Er wird euch entlohnen und auch ein Ausruestung koenntet ihr euch bei "+
    "ihm erfragen." , "sagt: ");
  AddInfo( ({"kutsche", "schiffe", "transportmittel"}), "In Andracia gibt es viele Transportmittel. Von der einfachen "+
    "Kutsche, ueber grosse Schiffe, die das Meer befahren, bis zu gefluegelten Pferden die euch ueber die Wolken bringen. ", "sagt: ");
  AddInfo( ({"loeschen", "selbstloeschung", "loeschung"}), "Wenn ihr wirklich von dieser Welt ganz entschwinden wollt so "+
    "muesst ihr euch selbst loeschen. Es wuerde aber schmerzen, euch als Spieler zu verlieren.", "sagt: ");
  AddInfo( ({"pause", "spielpause"}), "Wenn ihr euch fuer eine laengere Zeit vom Spielgeschehen zurueckziehen wollt, so "+
    "verwendet 'spielpause' und all eure Erfahrung und Faehigkeiten werden gespeichert.", "sagt: ");
  AddInfo( ({"ende"}), "Ein Ende ist keine zu empfehlende Sache. Schlaft lieber ein, dann bleiben eure Sachen bei euch. ", "sagt: ");
  AddInfo( ({"speichern"}), "Immer wieder wird automatisch gespeichert. Falls ihr aber doch zu den Spielern "+
    "mit besonderem Sicherheitsbeduerfnis gehoert, so koennt ihr euren Fortschritt mit speichern speichern.", "sagt: ");
  
  AddInfo( ({"magische karte", "magischer karte"}), "Ich habe von einer magischen Karte gelesen, leider kann ich mich nicht mehr erinnern "+
    "in welchem Buch meiner Bibliothek das gestanden hat.", "sagt: ");
  AddInfo( ({"kuchen", "kirschkuchen", "pflaumenkuchen", "apfelkuchen", "birnenkuchen"}), 
    "Einen leckern Kuchen gibt es hier in der Burg schon desoefteren. Vielleicht kann Erna, die Burgkoechin, Euch dazu weiterhelfen.", "sagt: ");
  AddInfo( ({"scrollan"}), 
    "Mhm - lasst mich ueberlegen. Hoert sich zumindest wie ein Name eines Gierlings an. ", "sagt: ");
  AddInfo( ({"wald", "waelder"}), 
    "Waelder sind die Heimt von wilden Tieren jeglicher Art. Es gibt verschiedenste Baeume und in einem Wald findet sich so manch "+
    "kurioses Gehoelz. Neben Eichen und Buchen sollen im Nebelwald, das ist der Wald im Sueden von hier, auch eine magische Zypresse "+
    "befinden.", "sagt: ");
  AddInfo( ({"fleisch"}), 
    "Wenn man als Elf in die hiesigen Gasthaeuser geht muss man wohl besonders aufpassen. Fast alle Gerichte die hier "+
    "angeboten werden sind mit Fleisch. Einem Elf bekommt das aber leider nicht.", "sagt: ");
  AddInfo( ({"schmied", "schmiede"}), 
    "In einer Schmiede kann der dortige Schmied eure Ruestungen und Waffen reparieren. Auch kann er Euch dabei behilflich sein, Eure "+
    "Waffen und Ruestungen zu vergleichen. Hier im Hof hat auch ein guter Schmied seine Schmiede eingerichtet.", "sagt: ");


  /*    
  AddInfo( ({""}), "", "sagt: ");
  */
  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "brille.lpc" );
  CLONEME( ARMOUR + "leinenhemd.lpc" );
  CLONEME( ARMOUR + "leinenhose.lpc" );
  CLONEME( ARMOUR + "stoffumhang.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "stock.lpc" );
  command("zuecke stock");
  
  // Am Channel info teilnehmen
  if(CHMASTER->join("Info",TO)<0)
  	TY("Konnte mich nicht am Kanal Info anmelden.\n");
}

// Begruessen neuer Spieler
void ChannelMessage(mixed msg)
{
	string txt, spname, sprasse, dummy;

	if( !stringp(msg[2]) ) return;
	if( msg[0] != "Info" ) return;
	if( sscanf( msg[2], "%s wurde gerade geboren.%s", txt, dummy)!=2 ) return;
	if( sscanf( txt, "%s %s", sprasse, spname)!=2 ) return;
  TY("Habe den Spieler "+spname+" der Rasse "+sprasse+" erkannt.\n");
  // zu schnell ... erst muss spieler reinkommen
  call_out("greetings", 3, sprasse, spname );
}
void greetings(string sprasse, string spname)
{
	object spieler;
	
  if( !spieler=find_player(lower_case(spname)) ) return;
  tell_object(spieler,    "Sindar teilt Dir mit: Willkommen in Andracia.\n"+
                          "Sindar teilt Dir mit: Ich bin der Bibliothekar von Zwirbelstein und kann \n"+
                          "Sindar teilt Dir mit: Euch mit meinem Wissen und meiner Hilfe zur Seite \n"+
                          "Sindar teilt Dir mit: stehen. Moechtet Ihr meine Dienste in Anspruch \n"+
                          "Sindar teilt Dir mit: nehmen so kommt zu mir oder schreibt 'teile sindar \n"+
                          "Sindar teilt Dir mit: mit hilfe' und ich hole Euch in meine Bibliothek. \n");
	 
                          
  // irgendwelche Rassespezifikas? switch( sprasse )
}

// Einfuehrung neuer Spieler
void catch_tell(string str)
{
	string spname,dummy;
	object spieler;
	
	if( sscanf( str, "%s teilt Dir mit: hilfe%s", spname, dummy)==2 ) 
	{
    TY( spname+" moechte geholfen werden! \n");
    if( !spieler=find_player(lower_case(spname)) ) return;
    if( ENV(spieler) == ENV(TO) ) 
    { 
  	  tell_object(spieler,"Sindar Tucher sagt: Ihr koennt hier auch ganz normal mit mir reden. \n"+	 
                          "Sindar Tucher sagt: Verwendet hierzu \'sag\' oder \'. \n");
  	  return;
    }	
    if( spieler->QueryProp(P_LEVEL)>3 )
    {
  	  tell_object(spieler,"Sindar teilt dir mit: Ihr seid doch schon gross genug um ohne meine \n"+	 
                          "Sindar teilt dir mit: Hilfe auszukommen. \n");
      return;                      
    }
	  tell_object(spieler,  "Sindar teilt dir mit: So will ich Euch zu mir zaubern ... \n"+	 
                          "Sindar teilt dir mit: Keine Angst es geschieht Euch nichts. \n");
    tell_room(ENV(TO), BS("Sindar Tucher zeichnet mit einem Finger ungewoehnliche Figuren in die Luft. ") );
  
    call_out( "hole_spieler", 5, spieler ); 
  }
  else if( sscanf( str, "%s sagt: hilfe%s", spname, dummy)==2 )
  {
    TY( spname+" ist vorort und moechte geholfen werden! \n");
	  if( !spieler=find_player(lower_case(spname)) ) return;
    tell_room(ENV(TO),    "Sindar sagt: Ich kann Euch gerne helfen, "+spieler->name()+". \n"+	 
                          "Sindar sagt: Fragt mich einfach nach \'informationen\'. \n");
  }
	if( sscanf( str, "%s teilt Dir mit: Hilfe%s", spname, dummy)==2 ) 
	{
    TY( spname+" moechte geholfen werden! \n");
    if( !spieler=find_player(lower_case(spname)) ) return;
    if( ENV(spieler) == ENV(TO) ) 
    { 
  	  tell_object(spieler,"Sindar Tucher sagt: Ihr koennt hier auch ganz normal mit mir reden. \n"+	 
                          "Sindar Tucher sagt: Verwendet hierzu \'sag\' oder \'. \n");
  	  return;
    }	
    if( spieler->QueryProp(P_LEVEL)>3 )
    {
  	  tell_object(spieler,"Sindar teilt dir mit: Ihr seid doch schon gross genug um ohne meine \n"+	 
                          "Sindar teilt dir mit: Hilfe auszukommen. \n");
      return;                      
    }
	  tell_object(spieler,  "Sindar teilt dir mit: So will ich Euch zu mir zaubern ... \n"+	 
                          "Sindar teilt dir mit: Keine Angst es geschieht Euch nichts. \n");
    tell_room(ENV(TO), BS("Sindar Tucher zeichnet mit einem Finger ungewoehnliche Figuren in die Luft. ") );
  
    call_out( "hole_spieler", 5, spieler ); 
  }
  else if( sscanf( str, "%s sagt: Hilfe%s", spname, dummy)==2 )
  {
    TY( spname+" ist vorort und moechte geholfen werden! \n");
	  if( !spieler=find_player(lower_case(spname)) ) return;
    tell_room(ENV(TO),    "Sindar sagt: Ich kann Euch gerne helfen, "+spieler->name()+". \n"+	 
                          "Sindar sagt: Fragt mich einfach nach \'informationen\'. \n");
  }
  return;
}
void hole_spieler(object spieler)
{
  spieler->move( ENV(TO), M_GO ,0 , "verschwindet einfach", "faellt aus dem Buecherregal" );  
	tell_room(ENV(TO),      "Sindar sagt: Willkommen in meiner Bibliothek, "+spieler->name()+". \n"+	 
                          "Sindar sagt: Hier kann ich Euch alle eure Fragen beantworten. \n"+
                          "Sindar sagt: Fragt mich einfach nach \'informationen\'. \n");

}

// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lass doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich dem Burgherrn sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werd ich dem Burgherrn sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


