#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Walkuerenschwert");
  SetProp(P_LONG,
    "Du siehst ein silbernes Walkuerenschwert, welches zwar schlicht gehalten ist, doch eine "
    "ungeheuer maechtige Waffe ist." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "walkuerenschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 50 );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_SILVER );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 8500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  

  SetProp(P_WC_BONUS, (["": ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_:]) );
}

int WieldFunc(object waffe) {
  return 0;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
