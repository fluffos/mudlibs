//13.08.2022 Yondala@SilberLand: Questzeit auf 14400 (vier Stunden) gesetzt

#include <moredef.h>
#include <moving.h>
inherit "std/thing.lpc";
#include <properties.h>
#include "../def.h"
object anderer;//der jeweils andere Spieler

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  AddId(({"\nlabyrinthquestitem"}));

  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 // SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
int dauert()
{
	if(find_call_out("kurzvorende")) return find_call_out("kurzvorende")+600;
	if(find_call_out("ende")) return find_call_out("ende");
	return 0;
}
void festlegen(object spieler)//der andere Spieler wird festgelegt von Aristocal
{anderer=spieler;}

object mitteilen()
{return anderer;}

string namemitteilen()
{if (anderer)	return anderer->name();
	else return 0;}

void loeschen()
{anderer=0;}


void sagundweg2()
{		tell_object(environment(TO), "Aristocal sagt: Ich bin sehr enttaeuscht von Euch beiden!\n");
		if(present("\nlabyfloete",environment(TO)))
			{
				present("\nlabyfloete",environment(TO))->remove();
			  tell_object(environment(TO), "Wuetend wirfst Du die Floete zu Boden.\nDie Floete zerbricht.\n");
			  tell_room(environment(environment(TO)), "Wuetend wirft "+environment(TO)->name()+" eine kleine Floete auf den Boden.\nDie Floete zerbricht.\n",({environment(TO)}));
			}

		  remove();

}

void sagundweg1()
{
	  //hier noch nomove und para vorher raus
	  tell_object(environment(TO), "Ploetzlich loest sich alles um Dich herum auf.\n");
	  environment(TO)->SetProp(P_PARALYZED,0);
	  environment(TO)->SetProp(P_NOMOVE,0);
	  
 	  environment(TO)->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
               "wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
		call_other(present("aristocal",environment(environment(TO))), "allesresetten",0);
		 call_out("sagundweg2",1);
}

void ende()
{
		tell_object(environment(TO), "Aristocal teilt Euch mit: Die Zeit ist um, Ihr habt versagt.\n");
		 call_out("sagundweg1",1);
}

void kurzvorende()
{
	tell_object(environment(TO), "Aristocal teilt Euch mit: Beeilt Euch, Ihr habt nur noch wenige Minuten!\n");
  call_out("ende",600);//beendet die Quest in 10 Minuten
}

void losgehts()
{call_out("kurzvorende",144000);}
	
//Falls ein Spieler ausloggt, wird die ganze Quest abgebrochen	
void BecomesNetDead(object spieler)
{
	if(anderer)//wenn es einen anderen Spieler gibt
		{
			tell_object(spieler,"Aristocal teilt Dir mit: Schade, vielleicht helft Ihr mir ein anderes Mal!?\n");

			tell_object(anderer,"Aristocal teilt Dir mit: Leider hat "+spieler->name()+
				" das Silberland verlassen. \n"+
				"Aristocal teilt Dir mit: Da wir nicht wissen, wann "+spieler->QueryPronoun(WER)+
				" zurueck kommt muesst\n"+
				"Aristocal teilt Dir mit: Ihr nun auch abbrechen. Ich hole Euch zurueck.\n");
			spieler->SetProp(P_NOMOVE,0);
			anderer->SetProp(P_NOMOVE,0);
			spieler->SetProp(P_PARALYZED,0);
			anderer->SetProp(P_PARALYZED,0); 				
			present("\nlabyrinthquestitem",anderer)->remove();
			anderer->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
               "wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
			spieler->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
               "wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
			call_other(present("aristocal",environment(environment(TO))), "allesresetten",0);
	  		remove();
  	}
  else
  	{
  		spieler->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
               "wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
  		call_other(present("aristocal",environment(environment(TO))), "allesresetten",0);
  		remove();
  	}

}