// Forscherpunkt auf spähen
// hier muss man die Leiter runterlassen
// durchwuehle muell=> Holzstueck (um daraus eine Leiter zu bauen)

#include "../def.h"
inherit "std/room";
#include <properties.h>

int spieler;
int holzda;

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  spieler=0;
  holzda=1;
}

void create() 
{
  ::create();
  spieler=0;
  holzda=1;
  
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst an der Westseite einer grossen Hoehle. Oestlich von Dir weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst."
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du stehst an der Westseite einer grossen Hoehle. Oestlich von Dir weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst." );

  AddDetail( ({ "westseite", "seite" }),
    "Du stehst hier an der Westseite der Hoehle. Gleich neben Dir ist ein Loch im Boden, "
    "dort geht es steil hinunter, pass auf, dass Du nicht faellst.");
  AddDetail( ({ "loch" }),
    "Du siehst ein Loch gleich neben Dir. Es geht ziemlich tief nach unten, Du solltest wohl "
    "besser nicht nach Westen gehen, solange es nicht sicher ist.");
  AddDetail( ({ "westen" }),
    "Dort ist ein tiefes Loch. Du kannst nach unten spaehen.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Fels. Du siehst keinerlei Bearbeitungsspuren, die Hoehle scheint "
    "natuerlichen Ursprungs zu sein.");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Mausi, ich sag doch, es sind keine da. Dann brauchst Du das auch nicht untersuchen.");
  AddDetail( ({ "mausi" }),
    "Es kann eine grosse Gefahr bergen, wenn man zu viel untersucht.");
  AddDetail( ({ "gefahr" }),
    "Ja, es ist gefaehrlich, wenn man jeden Bloedsinn untersucht.");
  AddDetail( ({ "bloedsinn" }),
    "So wie das. Also wenn Du nun noch \" Milchsuppe \" untersuchst wirst Du vermutlich sterben.");
  AddSpecialDetail( ({ "milchsuppe" }), "milchsuppe" );

  AddDetail( ({ "ursprung" }),
    "Der Ursprung ist zwar natuerlich, der ganze Unrat hier aber eher weniger. Die Hoehle "
    "scheint relativ oft besucht zu werden.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir, sie besteht aus reinem Fels und scheint natuerlichen "
    "Ursprungs zu sein. Hier und da wird sie durch Wurzeln unterbrochen.");
  AddDetail( ({ "wurzeln" }),
    "Die Wurzeln unterbrechen die Decke hin und wieder. Sie stammen vermutlich von Baeumen, die "
    "ueber der Hoehle wachsen. Leider sind sie zu hoch um sie zu erreichen.");
  AddDetail( ({ "baeume" }),
    "Die Baeume kannst Du nicht sehen, nur deren Wurzeln.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht vermutlich aus Fels, unter dem ganzen Unrat ist er allerdings kaum zu sehen.");
  AddDetail( ({ "fels" }),
    "Da Du Dich in einer Hoehle im Gebirge befindest, besteht um Dich rum natuerlich alles aus Fels."); 
  AddDetail( ({ "gebirge" }),
    "Du befindest Dich hier im Gebirge, welches das grosse Tal umschliesst.");
  AddDetail( ({ "tal" }),
    "Draussen, vor der Hoehle, ist das Tal. Hast Du es schon erforscht? Dort gibt es einiges zu entdecken.");
  AddDetail( ({ "unrat" }),
    "Allerlei Unrat liegt hier herum. Teilweise Laub und Aeste, die wohl der Wind herein "
    "geweht haben mag, teilweise aber auch Muell, den hier wohl jemand hingeworfen hat.");
  AddDetail( ({ "laub" }),
    "Das Laub stammt vermutlich von Birken, sicher bist Du aber nicht.");
  AddDetail( ({ "birken", "birke" }),
    "Hier drinnen sind keine Birken, aber vermutlich draussen vor der Hoehle, im grossen Tal.");
  AddDetail( ({ "aeste" }),
    "Die Aeste sehen aus, als haetten sie mal zu einer Birke gehoert.");
  AddDetail( ({ "muell" }),
    "Du siehst einiges an Muell. Groesstenteils sind es Essensreste, Kleidungssstuecke und "
    "abgebrannte Fackeln die hier auf dem Boden verstreut herum liegen.");
  AddDetail( ({ "essensreste","reste" }),
    "Puh, das sieht alles nicht mehr so lecker aus.");
  AddDetail( ({ "kleidungsstuecke","kleidung","stuecke" }),
    "Die sind alle zerrissen und zerfetzt und nicht mehr zu gebrauchen.");
  AddDetail( ({ "fackeln" }),
    "Die sind wohl eher nicht mehr zu gebrauchen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist relativ trocken und staubig.");

  AddSmell( ({ "luft" }),
    "Die Luft ist relativ trocken und staubig.");
  AddSmell( ({ "staub" }),
    "Der liegt in dieser alten, unbewohnten Hoehle natuerlich ueberall.");

//  AddRoomMessage( 
  //  ({""}),30,"func");
  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind vor der Hoehle leise pfeiffen.");

  AddSound( ({ "wind" }),
    "Der weht draussen sanft an der Hoehle vorbei.");

//noch ein spezial raus machen, wenn man nach westen geht und es steht keine Leiter da faellt man
  //AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_7d.lpc");
  AddSpecialExit("westen","westgeher");
  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_7f.lpc");
  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_6f.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_8e.lpc");

  AddCmd(({"spaehe", "spaeh"}),"spaehen"); //Man kann sehen, was sich in _7d befindet
  AddCmd(({"wirf", "werfe","werf"}),"werfen"); //Man kann Dinge nach unten werfen und sollte das moeglichst auch mit der Leiter tun.
  
  
  
}
int westgeher(string dir)
{
	if(present("leiter", to_object(LABY_ROOM+"hoehlenlabyrinth_7d")))
		

	return TP->move(LABY_ROOM + "hoehlenlabyrinth_7d", M_GO,0,
	                "kommt die Leiter runter geklettert","klettert nach unten");
					
	 
	write("Du faellst in das Loch und knallst hart auf dem Boden auf.\n");
					
	TP->AddHp(-30);	
	return TP->move(LABY_ROOM + "hoehlenlabyrinth_7d", M_GO,0,
	                "faellt in das Loch","faellt aus dem Loch herunter");	
	return 1;
}
	    
int werfen(string str)
{
	string was, dummy;
	object ding;
	notify_fail("Was moechtest Du nach unten werfen?\n");
	if(sscanf(str,"%s nach unten%s", was, dummy)!=2&&sscanf(str,"%s herunter%s", was, dummy)!=2) return 0;
	
	if(!present(was, TP))
		{
			write("So etwas hast Du doch gar nicht.\n"); 	 
			return 1;
		}
	ding =present(was, TP);
	if(ding->QueryProp(P_NODROP))//Wenn man das Ding nicht ablegen kann
		{
			write(ding->QueryProp(P_NODROP));
			return 1;
		}  
  write("Du wirfst "+ding->name()+" nach unten.\n");	
	ding->move(to_object(LABY_ROOM+"hoehlenlabyrinth_7d"), M_GET);
  tell_room(to_object(LABY_ROOM+"hoehlenlabyrinth_7d"), 
            "Jemand wirft von oben "+ding->name()+" herunter.\n");
  return 1;
}

int spaehen(string str) 
{
	string raumbeschreibung; 
	notify_fail("Wohin moechtest Du spaehen?\n");
    if (str!="in loch" && str!="runter"&&str!="nach unten") return 0;
    
    raumbeschreibung = to_object(LABY_ROOM+"hoehlenlabyrinth_7d")->int_long(TP);
    
	write ("Du spaehst in das Loch und siehst:\n"+raumbeschreibung);
	write("Du denkst . o O (waere sicher lustig was nach unten zu werfen...)\n");
	say(TPN+" spaeht in das Loch.\n");
	tell_room(LABY_ROOM+"hoehlenlabyrinth_7d", TPN+" streckt kurz "+TP->QueryPossPronoun(MALE,WEN)+" Kopf ueber den Felsvorsprung.\n");
	return 1;
}
	
string milchsuppe()
{
	say(TPN+" bricht tot zusammen.\n");
	tell_room(TO, "[Tod:Lars] Eine boese Scriptfalle hat gerade "+TPN+" umgebracht.\n");
	TP->SetProp(P_PARALYZED, ([
         PARALYZE_TIME: (20),
         PARALYZE_MSG: "Dein Koerper gehorcht Dir nicht.\n",
         PARALYZE_MSG_OTHER: "%s hat letzte Todeszuckungen.\n",
         PARALYZE_END: "Du kehrst ins Leben zurueck. Lass Dir das eine Warnung sein!\n",
         PARALYZE_END_OTHER: "%s kehrt doch noch mal ins Leben zurueck.\n"]));
	return "Ich hatte Dich gewarnt!\n";
}