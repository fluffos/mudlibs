#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Rezept");
  SetProp(P_LONG,
    "Ein Rezept, Du kannst es lesen." );
  SetProp(P_NAME, "Rezept");
  SetProp(P_GENDER, NEUTER);
  AddId(({"rezept", "papier","\nfroschrezept","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_PAPER);
  //SetProp(P_INFO, "Dieses Glas kann gefuellt werden. Es ist bestimmt auch Hitze resistent.\n");
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);
  AddReadDetail( ({ "rezept","papier" }),
    "\n  ______________________________________________\n"
	" (o)                                            )\n"
    "   |Rezept zur Herstellung eines Froschzaubers  |\n"
    "   |~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|\n"
    "   |Rankensaft zentrifugieren                   |\n"
    "   |zerstossene Pfefferkoerner hinzufuegen      |\n"
    "   |Mixtur erhitzen                             |\n"
    "   |Saft von drei Ziegenbeeren hinzufuegen      |\n"
    "   |Filtern                                     |\n"
    "   |Mixtur zentrifugieren                       |\n"
    "   |erhitzen                                    |\n"
    "   |abkuehlen lassen                            |\n"
    "   |zeitnah verabreichen                        |\n"
    " (o)____________________________________________)\n"); 
}

/*
Rezept zur Anleitung eines Schrumpfzaubers
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Moossaft zentrifugieren
zerstossene Pfefferkoerner hinzufuegen
das Gemisch erhitzen
Saft von drei Ziegenbeeren hinzufuegen
Filtern
erneut zentrifugieren
erhitzen
in ein sauberes Gefaess fuellen
abkuehlen lassen
zeitnah verabreichen
*/