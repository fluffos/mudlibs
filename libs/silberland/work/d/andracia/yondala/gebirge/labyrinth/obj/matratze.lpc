#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine alte Matratze");
  SetProp(P_LONG,
    "Du siehst eine alte, durchgelegene Matratze. Sie liegt auf dem Boden herum. "
    "Drauf legen magst Du Dich nicht. Aber sie sieht immerhin weich genug aus, "
    "dass sie den Aufprall abfedern kann, wenn man von oben herunter springt." );
  SetProp(P_NAME, "Matratze");
  SetProp(P_GENDER, FEMALE);
  AddId(({"matratze","\nmatratze","\nlabyloeschmich"}));
SetProp( P_MATERIAL, MAT_FEATHER);

  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
 
}


	