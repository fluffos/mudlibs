/*Raum mit der Schuettfunktion fuer Hoehlenlabyrinth_19i und _19j

*/	
#include "../def.h"
inherit "std/room";
#include <properties.h>
int drunter;
object drunter; //wird gerade etwas unter das Loch gehalten?
string andererRaum; //entweder 19i oder 19j, in der create festlegen

object wird_was_gehalten()
{return drunter;}

/*
Stati vom Reagenzglas:
0=leer
1=verdorbener Trank
2=mit Moossaft
3=mit zentrifugiertem Moossaft
4=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern
5=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern, erhitzt
6=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft
7=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert
8=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert, zentrifugiert
9=mit zentrifugiertem Moossaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert, zentrifugiert,erhitzt

*/
int waskommtan(object ding)
{
	if(drunter)//es wird ein Reagenzglas gehalten
	{
		if(ding->id("pfefferkoerner")&&!ding->id("\nzerstossenepfefferkoerner")) //Es sind Pfefferkoerner, die nicht zerstossen wurden
		{
			switch(drunter->status_geben())
			{
				case 0: 
					tell_room(TO,"Ein paar Pfefferkoerner fallen durch das Loch in der Wand.\n");
					ding->move(TO);
					break;
					return 1;
				default:
					tell_room(TO,"Ein paar Pfefferkoerner fallen durch das Loch in der Wand in das Reagenzglas.\nDie Mixtur ist verdorben.\n");
					ding->remove();
					drunter->status_1();
					break;
					return 1;
			}
		}
		
		else if(ding->id("\nzerstossenepfefferkoerner"))
		{
			switch(drunter->status_geben())
			{
				case 0: 
					tell_room(TO,"Ein paar zerstossene Pfefferkoerner fallen durch das Loch in der Wand.\n");
					ding->move(TO);
					break;
					//return 1;
				case 3:
					tell_room(TO,"Ein paar zerstossene Pfefferkoerner fallen durch das Loch in der Wand in das Reagenzglas.\nDie Mixtur leuchtet kurz auf.\n");
					drunter->status_4();
					ding->remove();
					break;
					//return 1;
				default:	
					tell_room(TO,"Ein paar Pfefferkoerner fallen durch das Loch in der Wand in das Reagenzglas.\nDie Mixtur ist verdorben.\n");
					drunter->status_1();
					break;
			}
				
		}
		else if(ding->id("ziegenbeeren")) //Es sind Ziegenbeeren, die nirgends reingehoeren
		{
			switch(drunter->status_geben())
			{
				case 0: 
					tell_room(TO,"Ein paar Ziegenbeeren fallen durch das Loch in der Wand.\n");
					ding->move(TO);
					break;
					return 1;
				default:
					tell_room(TO,"Ein paar Ziegenbeeren fallen durch das Loch in der Wand in das Reagenzglas.\nDie Mixtur ist verdorben.\n");
					ding->remove();
					drunter->status_1();
					break;
					return 1;
			}
		}
		tell_room(TO,"Du entfernst das Reagenzglas von dem Loch.\n");
		drunter=0;
		AddDetail( ({ "loch" }),
			"Es ist ziemlich klein. Du koenntest versuchen, etwas hindurch zu stecken "+
			"oder zu schuetten, ausserdem kannst Du ein Gefaess darunter halten, um etwas "+
			"aufzufangen, was von der anderen Seite hindurchgeschuettet wird.");

		return 1;
	}	
	
	
	tell_room(TO, capitalize(ding->name())+" faellt durch das Loch in der Wand.\n");
	ding->move(TO);

	return 1;
}

void waskommtfluessigan(string str)
{
	int i;
//	tell_room(TO,"Was fluessiges kommt an.\n");
	if(!drunter)
	{
		tell_room(TO,"Eine Fluessigkeit laeuft durch das Loch in der Wand und versickert im Boden.\n");
		return;
	}

	//wenn etwas LEERES drunter ist und eine Mixtur ankommt
if(drunter->status_geben()==0)
	{
	//	i=str[strlen(str-1)];
		//i=to_int(str[strlen(str)-1..strlen(str)]);//sucht das letzte Zeichen aus str raus und speichert es in i als int
		switch (to_int(str[strlen(str)-1..strlen(str)]))
		{
			case 1: 
				tell_room(TO,"Eine verdorbene Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_1();
				//return;
				break;
			case 2:
				tell_room(TO,"Rankensaft laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_2();
				//return;
				break;
			case 3:
				tell_room(TO,"Rankensaft laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_3();
				//return;
				break;
			case 4 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_4();
				//return;
				break;
				
			case 5 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_5();
				//return;
				break;
				
			case 6 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_6();
				//return;
				break;
				
			case 7 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_7();
				
				//return;
				break;
				
			case 8 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_8();
				//return;
				break;
				
			case 9 :
				tell_room(TO,"Eine Mixtur laeuft durch das Loch in der Wand in Dein Reagenzglas.\n");
				drunter->status_9();
				break;
					
		}
		tell_room(TO,"Du entfernst das Reagenzglas von dem Loch.\n");
		drunter=0;
		AddDetail( ({ "loch" }),
			"Es ist ziemlich klein. Du koenntest versuchen, etwas hindurch zu stecken "+
			"oder zu schuetten, ausserdem kannst Du ein Gefaess darunter halten, um etwas "+
			"aufzufangen, was von der anderen Seite hindurchgeschuettet wird.");
			
		
	}
	else //ein bereits gefuelltes Glas ist unter dem Loch
	{
		tell_room(TO,"Eine Fluessigkeit rinnt durch das Loch in Dein Reagenzglas. Der Inhalt verdirbt.\n");
		tell_room(TO,"Du entfernst das Reagenzglas von dem Loch.\n");
		drunter->status_1();
		drunter=0;
		AddDetail( ({ "loch" }),
			"Es ist ziemlich klein. Du koenntest versuchen, etwas hindurch zu stecken "+
			"oder zu schuetten, ausserdem kannst Du ein Gefaess darunter halten, um etwas "+
			"aufzufangen, was von der anderen Seite hindurchgeschuettet wird.");
	}
}
void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem kleinen Raum" );
  drunter=0;
/*  if(file_name(TO)==LABY_ROOM+"hoehlenlabyrinth_19j")
		andererRaum=LABY_ROOM+"hoehlenlabyrinth_19i";
  else
		andererRaum=LABY_ROOM+"hoehlenlabyrinth_19j";
  */
  
  SetProp( P_INT_LONG,
    "Etwas irritiert schaust Du Dich um. Alles hast Du erwartet, aber nicht das, was Du hier "
    "siehst: Du stehst in einem kleinen Raum, der nicht natuerlichen Ursprungs ist. Der Boden "
	"ist glatt und wurde offenbar gefegt, zumindest lassen die Spuren auf ihm darauf schliessen. "
	"Auch die Waende sind glatt und wirken wie verputzt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

/*
  AddRoomMessage( 
    ({"Die Stille lastet schwer auf Dir.\n",
    	"Ein leichter Druck legt sich auf Deine Ohren.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Ein Tropfen faellt mit lautem *Platsch* auf den Boden.\n"}),80,"func");
*/
  AddSound( DEFAULT_SOUND,
    ".");

  AddSound( ({ "" }),
    ".");

  AddSound( ({ "" }),
    ".");

  AddCmd( ({ "halte","halt"}), "drunter_halten" );
  AddCmd( ({ "entferne","entfern"}), "glas_entfernen" );

  AddCmd( ({ "schuette","schuett","stecke","steck"}), "schuetten" );

  AddSpecialExit("norden","nordgeher");

}
int nordgeher(string dir)
{
	if(TP->QueryProp(P_FROG))

	return TP->move(LABY_ROOM + "hoehlenlabyrinth_18i", M_GO,0,
	                "huepft nach Norden","nach Norden");
					
					
	write("Du passt in Deiner jetzigen Form nicht durch die kleine Tuer.\n");	              
	return 1;
	}


int schuetten(string str)
{
	string was, dummy;
	notify_fail("Was moechtest Du wodurch schuetten?\n");
	if(!str) return 0;

    if (sscanf(str, "%s durch loch%s", was, dummy) != 2) return 0;
		if(!present(was, TP))
		{
			write("Sowas hast Du nicht.\n");
			return 1;
		}

		if(was=="ziegenbeeren"||was=="beeren"||was=="pfefferkoerner"||was=="koerner"||was=="pfeffer")
		{
			write("Du schuettest " + present(was,TP)->name(WEN) + " durch das Loch.\n");
			call_other(andererRaum, "waskommtan", present(was,TP));
			return 1;
		}

		
		if(was=="saft"||was=="rankensaft")
		{
			if(!present("\nlabyquestreagenzglas",TP))
			{
				write("Du hast nicht den richtigen Saft.\n");
				return 1;
			}				
			
			/*if(present("\nlabyquestreagenzglas",TP)->status_geben()!=2&&present("\nlabyquestreagenzglas",TP)->status_geben()!=3)
			{
				write("In Deinem Reagenzglas ist kein Rankensaft.\n");
				return 1;
			}*/
			
		

			//normal=rankensaft2, zentrifugierter Saft = rankensaft3
			call_other(andererRaum, "waskommtfluessigan", "rankensaft"+to_string(present("\nlabyquestreagenzglas",TP)->status_geben()));
			present("\nlabyquestreagenzglas",TP)->status_0();
			if(present("\nlabyquestreagenzglas",TP)->find_call_out("abgekuehlt")>1) present("\nlabyquestreagenzglas",TP)->remove_call_out("abgekuehlt");
			
			write("Du schuettest den Rankensaft durch das Loch.\n");
			return 1;
		}		
		
		if(was=="mixtur")
		{
			call_other(andererRaum, "waskommtfluessigan", "mixtur"+to_string(present("\nlabyquestreagenzglas",TP)->status_geben()));
			present("\nlabyquestreagenzglas",TP)->status_0();	
			if(present("\nlabyquestreagenzglas",TP)->find_call_out("abgekuehlt")>1) present("\nlabyquestreagenzglas",TP)->remove_call_out("abgekuehlt");	
			write("Du schuettest die Mixtur durch das Loch.\n");
			return 1;
		}			
}
int drunter_halten(string str)
{
    notify_fail("Was moechtest Du wo drunter halten?\n");
	if(!str)return 0;
	if(str!="glas unter loch"&&str!="reagenzglas unter loch") return 0;
	if(!present("\nlabyquestreagenzglas",TP))
	{
		write("Du hast nicht das passende Reagenzglas dabei.\n");
		return 1;
	}
	if(drunter)
	{
		write("Du haelst doch schon "+ drunter->name(WEN)+" unter das Loch.\n");
		return 1;
	}
	drunter=present("\nlabyquestreagenzglas",TP);
	write("Du haelst nun "+ drunter->name(WEN)+" unter das Loch.\n");
	AddDetail( ({ "loch" }),
    "Es ist ziemlich klein. Du koenntest versuchen, etwas hindurch zu stecken "+
	"Wenn jemand etwas durch das Loch schuettest, koennte es im Reagenzglas landen. "+
	"oder zu schuetten, ausserdem haelst Du gerade ein Reagenzglas darunter. " +
	"Du kannst das Glas von dem Loch entfernen.");
	return 1;
}

int glas_entfernen(string str)
{
	notify_fail("Was moechtest Du entfernen?\n");
	if(!str)return 0;
	if(!drunter)
	{
		write("Es gibt derzeit nichts zu entfernen.\n");
		return 1;
	}
	
	if(!drunter->id(str))
	{
		write("Das befindet sich nicht unter dem Loch und kann somit auch nicht entfernt werden.\n");
		return 1;
	}

	write("Du entfernst "+ drunter->name(WEN)+" von dem Loch.\n");
	drunter=0;	  
	AddDetail( ({ "loch" }),
    "Es ist ziemlich klein. Du koenntest versuchen, etwas hindurch zu stecken "+
	"oder zu schuetten, ausserdem kannst Du ein Gefaess darunter halten, um etwas "+
	"aufzufangen, was von der anderen Seite hindurchgeschuettet wird.");
	return 1;
}


	
