// Hier muessen sich beide gegen die Tuer lehnen, gelangen dann in den naechsten Raum

#include "../def.h"
inherit "std/room";
#include <properties.h>

int lehner;

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  lehner=0;
}

void create() 
{
  ::create();
  lehner=0;
  CLONE("/obj/fackel.lpc", TO);
  CLONE("/obj/fackel.lpc", TO);  
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  
  SetProp( P_INT_LONG,
    "Du stehst an der Nordseite einer grossen Hoehle. Suedlich von Dir weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst."
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du stehst an der Nordseite einer grossen Hoehle. Suedlich von Dir weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst." );

  AddDetail( ({ "nordseite", "seite" }),
    "Du stehst hier an der Nordseite der Hoehle.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Fels, die Hoehle scheint "
    "natuerlichen Ursprungs zu sein, doch huch, was ist das da an der Nordostwand?");

  AddDetail( ({ "ursprung" }),
    "Der Ursprung ist zwar natuerlich, der ganze Unrat hier aber eher weniger. Die Hoehle "
    "scheint relativ oft besucht zu werden.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir, sie besteht aus reinem Fels und scheint natuerlichen "
    "Ursprungs zu sein. Hier und da wird sie durch Wurzeln unterbrochen.");
  AddDetail( ({ "wurzeln" }),
    "Die Wurzeln unterbrechen die Decke hin und wieder. Sie stammen vermutlich von Baeumen, die "
    "ueber der Hoehle wachsen. Leider sind sie zu hoch um sie zu erreichen.");
  AddDetail( ({ "baeume" }),
    "Die Baeume kannst Du nicht sehen, nur deren Wurzeln.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht vermutlich aus Fels, unter dem ganzen Unrat ist er allerdings kaum zu sehen.");
  AddDetail( ({ "fels" }),
    "Da Du Dich in einer Hoehle im Gebirge befindest, besteht um Dich rum natuerlich alles aus Fels."); 
  AddDetail( ({ "gebirge" }),
    "Du befindest Dich hier im Gebirge, welches das grosse Tal umschliesst.");
  AddDetail( ({ "tal" }),
    "Draussen, vor der Hoehle, ist das Tal. Hast Du es schon erforscht? Dort gibt es einiges zu entdecken.");
  AddDetail( ({ "unrat" }),
    "Allerlei Unrat liegt hier herum. Teilweise Laub und Aeste, die wohl der Wind herein "
    "geweht haben mag, teilweise aber auch Muell, den hier wohl jemand hingeworfen hat.");
  AddDetail( ({ "laub" }),
    "Das Laub stammt vermutlich von Birken, sicher bist Du aber nicht.");
  AddDetail( ({ "birken", "birke" }),
    "Hier drinnen sind keine Birken, aber vermutlich draussen vor der Hoehle, im grossen Tal.");
  AddDetail( ({ "aeste" }),
    "Die Aeste sehen aus, als haetten sie mal zu einer Birke gehoert.");
  AddDetail( ({ "muell" }),
    "Du siehst einiges an Muell. Groesstenteils sind es Essensreste, Kleidungssstuecke und "
    "abgebrannte Fackeln die hier auf dem Boden verstreut herum liegen.");
  AddDetail( ({ "essensreste","reste" }),
    "Puh, das sieht alles nicht mehr so lecker aus.");
  AddDetail( ({ "kleidungsstuecke","kleidung","stuecke" }),
    "Die sind alle zerrissen und zerfetzt und nicht mehr zu gebrauchen.");
  AddDetail( ({ "fackeln" }),
    "Die sind wohl eher nicht mehr zu gebrauchen.");
  AddDetail( ({ "nordostwand" }),
    "Sieht ja fast wie eine Tuer aus.");
  AddDetail( ({ "tuer" }),
    "Ob man sie wohl oeffnen kann? Und was mag dahinter sein?");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist relativ trocken und staubig.");

  AddSmell( ({ "luft" }),
    "Die Luft ist relativ trocken und staubig.");
  AddSmell( ({ "staub" }),
    "Der liegt in dieser alten, unbewohnten Hoehle natuerlich ueberall.");

//  AddRoomMessage( 
  //  ({""}),30,"func");
  AddSound( DEFAULT_SOUND,
    "Es ist heir unheimlich still.");

  AddSound( ({ "wind" }),
    "Nicht mal den hoerst Du hier drin.");


  AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_6f.lpc");
  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_7h.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_7g.lpc");

  AddCmd(({"oeffne"}),"oeffnen"); //Kann man nicht
  AddCmd(({"lehne","lehn"}),"lehnen"); //
  AddCmd(({"richte","richt"}),"aufrichten"); //

}

int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str!="tuer") return 0;
  write("Du zerrst und ruettelst an der Tuer, bekommst sie aber nicht auf.\n"
        "Ob es hilft, wenn Du Dich dagegen lehnst?\n");
  say(TPN+" zerrt und ruettelt an der Tuer.\n");
  return 1;
}
int aufrichten(string str)
{
	notify_fail("Moechtest Du Dich vielleicht aufrichten?\n");
	if(str!="auf")return 0;
		
  if(TP->QueryProp(P_NOMOVE)!="Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n") 
  	{
  		write("Du lehnst doch gar nicht an der Tuer.\n");
  		return 1;
  	}
  TP->SetProp(P_NOMOVE,0);
  write("Du richtest Dich wieder auf.\n");
  say(TPN+" richtet sich wieder auf.\n",TP);
  lehner--;
  return 1;
}



	
int lehnen (string str)
{
	object anderer;
  anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
	notify_fail("Wo moechtest Du Dich gegen lehnen?\n");
	if (str!="gegen tuer") return 0;
	
	if(TP->QueryProp(P_NOMOVE)=="Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n")
		{
			write("Das machst Du doch schon.\n");
			return 1;
		}
	if(TP->QueryProp(P_NOMOVE))
		{
			write(TP->QueryProp(P_NOMOVE));	    
			return 1;
		}
	    
	TP->SetProp(P_NOMOVE,"Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n");
	write("Du lehnst Dich gegen die Tuer.\n");
	say(TPN+" lehnt sich gegen die Tuer.\n");
	lehner++;
	
	if (lehner==2)
		{
			tell_room(TO, "Durch Euer beider Gewicht gibt die Tuer nach und ihr zwei purzelt "+
			"in den Raum dahinter.\nDie Tuer schliesst sich.\n");
      TP->SetProp(P_NOMOVE,0);
      anderer->SetProp(P_NOMOVE,0);
      lehner=0;//man weiss ja nie

	    TP->move(LABY_ROOM+"hoehlenlabyrinth_5h", M_GO, 0,
               "faellt hin", "faellt hin");
     	anderer->move(LABY_ROOM+"hoehlenlabyrinth_5h", M_GO, 0,
               "faellt hin", "faellt hin");


			return 1;
		}
	write("Du bist nicht stark genug. Vielleicht solltest Du es mit "+anderer->name()+" zusammen versuchen?\n");//+present("\nlabyrinthquestitem",TP)->namemitteilen()+" zusammen versuchen?\n");
	return 1;
}
			


	
