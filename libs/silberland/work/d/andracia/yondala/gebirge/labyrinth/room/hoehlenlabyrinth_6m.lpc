// hier kann man in einer Spalte einmal pro Quest ein Seil finden

#include "../def.h"
inherit "std/room";
#include <properties.h>
int seilda;
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	seilda=1;
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem finsteren Gang" );
  seilda=1;
  SetProp( P_INT_LONG,
    "Du stehst hier in einem finsteren Gang. Viel kannst Du hier nicht erkennen, ausser, dass "
    "er nach Suedosten und Westen fuehrt. Was dort jedoch "
    "ist, kannst Du nicht erkennen, die schwarzen Waende scheinen jedes Licht zu verschlucken." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
     "Du stehst hier in einem finsteren Gang. Viel kannst Du hier nicht erkennen, ausser, dass "
    "er nach Nordwesten und Suedwesten fuehrt. Was dort jedoch "
    "ist, kannst Du nicht erkennen." );
  AddDetail( ({ "richtung" }),
    "Du kannst hier nach Nordwesten und Suedwesten gehen.");
  AddDetail( ({ "nordwesten", "suedwesten" }),
    "Dorthin fuehrt Dich der Gang, wenn Du Dich traust einfach in die Dunkelheit zu gehen.");
  AddDetail( ({ "dunkelheit","ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich erwartet wenn Du den Gang weiter entlang gehst.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Allerdings ist er nicht natuerlich entstanden, denn "
    "Du kannst deutlich die Bearbeitungsspuren sehen.");
  AddDetail( ({ "waende" }),
    "Nanu, die Waende waren zwar schon die ganze Zeit dunkel, nun sind sie aber pechschwarz. Gleich "
    "neben Dir kannst Du den Uebergang von Grau nach Schwarz erkennen.");
  AddDetail( ({ "decke" }),
    "Die niedrige Decke ist bedrohlich dicht ueber Dir. Hoffentlich kommt sie nicht herunter.");
  AddDetail( ({ "wand" }),
    "Die beiden Waende rechts und links von Dir kommen Dir bedrohlich nahe. Oder taeuscht Dich "
    "Dein Gefuehl?");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Jemand hat diesen Gang muehsehlig in den Fels geschlagen, er ist nicht natuerlich entstanden.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, kalt und ein wenig feucht.");
  AddDetail( ({ "gefuehl", "gefuehle" }),
    "Kannst Du Deinen Gefuehlen trauen?");
  AddDetail( ({ "zeit" }),
    "Die ganze Zeit, seit Du diesen Gang entlang laeufst. Es sei denn, Du bist durch diesen "
    "wirklich wichtigen Raum einfach so hindurchgelaufen. Dann weisst Du vielleicht schon, dass "
    "die Waende im weiteren Verlauf des Ganges schwarz bleiben. Oder auch nicht, weil Du ja "
    "dann offensichtlich kein guter Forscher waerest.");
  AddDetail( ({ "raum" }),
    "Schau Dich gut um.");
  AddDetail( ({ "verlauf" }),
    "Nun, der Gang endet hier nicht, Du kannst nach Nordwesten und Suedwesten laufen.");
  AddDetail( ({ "forscher" }),
    "Bist Du denn ein guter Forscher?");
  AddDetail( ({ "uebergang" }),
    "Im Nordwesten sind die Waende dunkelgrau, im Suedwesten sind sie schwarz und genau hier, "
    "wo du gerade stehst, gehen diese beiden Farben ineinander ueber.");
  AddDetail( ({ "farben" }),
    "Diese zwei unterschiedlichen Farben resoltieren vermutlich daraus, dass hier zwei "
    "Gesteinsarten aufeinander treffen.");
  AddDetail( ({ "arten","gesteinsarten" }),
    "Um welche Arten es sich handelt kannst Du nicht sehen. Vielmehr interessiert Dich die "
    "kleine Spalte, die sich im Uebergang gebildet hat.");
  AddDetail( ({ "spalte" }),
    "Viel sehen kannst Du nicht, sie ist fast gaenzlich im Schatten verborgen. Ob es ratsam "
    "ist hineinzugreifen?");
  AddDetail( ({ "schatten" }),
    "Wo Licht ist, ist auch Schatten. Und wo wenig Licht ist, ist halt viel Schatten. So wie hier.");
  AddDetail( ({ "licht" }),
    "Die Waende und die Decke sind so dunkel, dass sie jedes Licht zu verschlucken scheinen.");
  AddDetail( ({ "schwarz" }),
    "Im Suedwesten sind Waende und Decke schwarz.");
  AddDetail( ({ "grau" }),
    "Im Nordwesten sind Waende und Decke dunkelgrau.");
  AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");



  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Wahrlich, es riecht nicht angenehm..");

  AddRoomMessage( 
    ({"Irgendwie fuehlst Du Dich leicht unwohl.\n",
    	"Du hast das Gefuehl, dass die Waende naeher ruecken.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Irgendwo tropft etwas.\n"}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille. Ganz, ganz selten hoerst Du ein leises tropfen.");

  AddSound( ({ "tropfen" }),
    "Wo das wohl herkommen mag?");
  AddSound( ({ "totenstille","stille" }),
    "Dir ist unwohl zumute. Irgendetwas stimmt hier nicht.");


  AddExit("nordwesten", LABY_ROOM+"hoehlenlabyrinth_5l.lpc");
  AddExit("suedwesten", LABY_ROOM+"hoehlenlabyrinth_7l.lpc");
 AddCmd( ({ "greife", "greif"}), "greifen" ); //in die Spalte greifen


}


int greifen(string str)
{
	notify_fail("Worein moechtest Du greifen?\n");
	if(str!="in spalte")return 0;
	
	if(!seilda)
		{
			write("Mutig greifst Du in die Spalte. Sie ist leer.\n");
			say(TPN+" tastet an der Wand herum.\n",TP);
			return 1;
		}
	write("Mutig greifst Du in die Spalte und ziehst ein Seil heraus.\n");
	say(TPN+" tastet an der Wand herum.\n",TP);
  CLONE("/obj/seil.lpc", TP);
	seilda=0;
	return 1;
}
	
