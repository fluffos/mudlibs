
#include "../def.h"
inherit "std/room";
#include <properties.h>

int maennleinda;
void anfangszustand()


{
  if (present("\nbootaufgeschlossen",TO)) 
  	{
  		present("\nbootaufgeschlossen",TO)->remove();
	    CLONE(LABY_OBJ + "boot.lpc",environment(TO));
	  }
  if (present("maennlein",TO)) 
  {
	 present("maennlein",TO)->move("/players/yondala/room/muellhalde");
	 present("maennlein",TO)->remove(); 
  }


}

void init()
{
	 if (!present("maennlein",TO)&&!maennleinda)
	 	{
	  //nur wenn der Schluessel in 3k nicht gefunden wurde soll das Maennlein da stehen
  		if(!call_other(LABY_ROOM + "hoehlenlabyrinth_3k","schluesselgefunden",0))
		{
			AddItem(LABY_NPC+"maennlein.lpc",REFRESH_REMOVE);
			maennleinda=1;
		}
  	}
::init();
}


void create() 
{
  ::create();
  maennleinda=0;
  
  SetProp( P_INT_SHORT, "An einem reissenden Fluss" );
  
  SetProp( P_INT_LONG,
    "Du stehst am schmalen Ufer eines reissenden Flusses. Hinter Dir ist der Felsspalt, "
    "durch den Du gekommen bist, vor Dir schaukelt eine kleines Boot, festgemacht an einem "
    "Holzpflock." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

//Zu Testzwecken aufgeschlossenes boot 
   AddItem(LABY_OBJ+"boot.lpc",REFRESH_REMOVE);
//   AddItem(LABY_OBJ+"bootaufgeschlossen.lpc",REFRESH_REMOVE);
  


  AddDetail( ({ "himmel" }),
    "Der Himmel ist leuchtend blau, hin und wieder siehst Du einen Vogel seine Kreise ziehen.");
  AddDetail( ({ "luft" }),
    "Du atmest ein paar mal tief ein und aus. Aaaaah, das tut gut!");
  AddDetail( ({ "boden" }),
    "Der Boden hier besteht aus Felsen, endet aber abrupt vor Deinen Fuessen an einem "
    "reissenden Fluss.");
  AddDetail( ({ "berg" }),
    "Du stehst in dem Berg, hinter Dir der Spalt, durch den Du gekommen bist, vor Dir "
    "der reissende Fluss, der seine Quelle wohl weiter oben haben muss.");
  AddDetail( ({ "vogel" }),
    "Scheint ein Geier zu sein.");
  AddDetail( ({ "aasgeier","geier" }),
    "Der wartet vermutlich darauf, dass Du abstuerzt.");
 AddDetail( ({ "fels" }),
    "Der Fels ist grau, relativ glatt und kuehl.");
 AddDetail( ({ "weg" }),
    "Der Weg fuehrt zwischen den Felswaenden nach Suedosten.");
 AddDetail( ({ "waende","felswaende" }),
    "Die Felswaende stehen zwar recht eng beieinander, aber da passt Du locker durch.");
 AddDetail( ({ "kreise" }),
    "Der Vogel fliegt in ebenmaessigen Kreisen durch die Luft.");
 AddDetail( ({ "spalt", "felsspalt", "bergspalt"  }),
    "Durch den Felsspalt, der durch den Berg fuehrt, bist Du hierhergelangt.");
 AddDetail( ({ "fluss" }),
    "Der Fluss stroemt mit lautem Getoese an Dir vorbei.");
 AddDetail( ({ "quelle" }),
    "Du vermutest, dass sie sehr weit oben liegen muss. Du kannst sie nicht sehen, aber der "
    "Fluss ist hier schon so breit, dass er sehr viel Wasser mit sich fuehrt.");
 AddDetail( ({ "wasser" }),
    "Das Wasser des Flusses ist aufgewuehlt und unruhig. Kein Wunder, bei dieser starken "
    "Stroemung.");
 AddDetail( ({ "wunder" }),
    "Du wunderst Dich nicht.");
 AddDetail( ({ "holzpflock","pflock" }),
    "Ein Holzpflock ist hier tief in den Boden gerammt. Das Boot ist daran vertaeut.");
 AddDetail( ({ "fuesse" }),
    "Pass auf, dass sie nicht nass werden.");
 AddDetail( ({ "stroemung" }),
    "Die Stroemung ist hier recht stark. Schwimmen waere zu gefaehrlich.");
 AddDetail( ({ "schwimmen" }),
    "Das ist keine gute Idee.");
 AddDetail( ({ "idee" }),
    "Du musst eine Bessere finden.");
 AddDetail( ({ "bessere" }),
    "Es waere vermutlich eine bessere Idee in das Boot zu klettern. Wenn es hier schon so "
    "herrenlos rumliegt.");
 AddDetail( ({ "fische","fisch" }),
    "Hin und wieder siehst Du ein paar Fische im Wasser glitzern.");
 AddDetail( ({ "welle" }),
    "Viele Wellen klatschen immer wieder rythmisch ans Ufer.");
 AddDetail( ({ "insekt","insekten" }),
    "Einige Insekten summen am Uferrand.");
 AddDetail( ({ "ufer","uferrand","rand" }),
    "Du stehst am steinigen Ufer eines wilden Flusses.");
 AddDetail( ({ "boot" }),
    "Wenn Du das hier liest stimmt etwas nicht, informiere bitte einen Adeligen.");
 AddDetail( ({ "adelige","adeliger" }),
    "Hoffentlich ist einer da, wenn nicht, musst Du die Quest spaeter noch einmal versuchen.");
 AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist etwas abgestanden, kein Lueftchen regt sich.");
  AddSmell( ({ "luft","lueftchen" }),
    "Die Luft koennte besser sein, aber es ist ertraeglich.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");

//muessen mal noch welche
  AddRoomMessage( 
    ({"Eine kleine Welle schwappt bis zu Deinen Fuessen.\n",
    	"Das Boot schaukelt wild auf den Wellen.\n",
    	"Ein Fisch springt in die Luft um nach einem Insekt zu schnappen.\n",
    	"Das Wasser rauscht mit lautem Getoese an Dir vorbei.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautes Rauschen.");

  AddSound( ({ "rauschen", "" }),
    "Was das wohl ist? Es kommt aus dem Sueden.");
  AddSound( ({ "getoese", "fluss" }),
    "Der Fluss stroemt mit lautem Getoese an Dir vorbei.");





  AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_25f.lpc");
	
}




