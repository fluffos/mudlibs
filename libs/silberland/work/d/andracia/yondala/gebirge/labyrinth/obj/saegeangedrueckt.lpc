#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse Saege");
  SetProp(P_LONG,
    "Du siehst eine grosse, etwas rostige Saege, wie sie wohl Holzfaeller verwenden. Sie "
    "ist leicht in den Baumstamm gedrueckt, man koennte einen Griff ergreifen und den "
    "Baum faellen." );
  SetProp(P_NAME, "Saege");
  SetProp(P_GENDER, FEMALE);
  AddId(({"saege","\nsaegeangedrueckt","\nlabyloeschmich"}));
SetProp( P_MATERIAL, MAT_IRON);

  SetProp(P_WEIGHT, 7000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOGET, "Die Saege ist in den Baumstamm gedrueck.\n");
 
}


	