#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Haarbuerste");
  SetProp(P_LONG,
    "Du haelst eine goldene Haarbuerste in den Haenden, mit der Du Dir wunderbar die Haare "
    "kaemmen kannst." );
  SetProp(P_NAME, "Haarbuerste");
  SetProp(P_GENDER, FEMALE);
  AddId(({"haarbuerste","buerste"}));
SetProp( P_MATERIAL, MAT_GOLD);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
   AddCmd(({"kaemme","kaemm", "buerste","buerst"}),"buersten"); 
   
}

int buersten(string str)
{
	notify_fail("Was moechtest Du buersten?\n");
	if(str!="haare") return 0;
	
	write("Du faehrst Dir mit der goldenen Buerste durch die Haare.\n"+
	"Du fuehlst Dich wunderschoen.\n");
	say(TPN+" faehrt sich mit einer goldenen Haarbuerste die Haare und sieht danach wunderschoen aus.\n",TP);
	return 1;
}

	