
#include "../def.h"
inherit "std/room";
#include <properties.h>

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	RemoveExit("norden");
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem kleinen Raum" );
  
  SetProp( P_INT_LONG,
    "Etwas irritiert schaust Du Dich um. Alles hast Du erwartet, aber nicht das, was Du hier "
    "siehst: Du stehst in einem kleinen Raum, der zwar fast leer ist, aber dennoch nicht "
    "natuerlichen Ursprungs sein kann. Der Boden ist glatt und wurde vermutlich gefegt, zumindest "
    "lassen die Spuren auf ihm darauf schliessen. Auch die Waende sind glatt und wirken wie "
    "verputzt. An einer Wand steht ein seltsamer Kasten." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );


  AddDetail( ({ "raum" }),
    "Der Raum ist klein und ueberschaubar. Nur Du und ein seltsamer Kasten befinden sich darin.");
  AddDetail( ({ "ursprung" }),
    "Du hast keine Ahnung wie der Raum entstanden ist, Du warst ja nicht dabei.");
  AddDetail( ({ "ahnung" }),
    "Du hast keine.");
  AddDetail( ({ "boden" }),
    "Der Boden ist eben. Nur sehr wenig Schmutz liegt auf ihm, er scheint gereinigt worden zu "
    "sein, zumindest kannst Du einige eindeutige Spuren erkennen.");
  AddDetail( ({ "spuren" }),
    "Die Spuren, die sich durch den Schmutz auf dem Boden ziehen deuten darauf hin, dass hier "
    "einst gefegt wurde.");
  AddDetail( ({ "schmutz" }),
    "Der Schutz besteht hauptsaechlich aus Staub, dazwischen wenige kleine braune und schwarze "
    "Kluempchen.");
  AddDetail( ({ "staub" }),
    "Selbst wenn hier vor kurzem gefegt wurde, Staub kommt immer wieder und legt sich auf den Boden.");
  AddDetail( ({ "kluempchen" }),
    "Die Kluempchen sehen aus wie Erde.");
  AddDetail( ({ "erde" }),
    "Da hatte wohl jemand Erde an den Fuessen, als er hier durchlief.");
  AddDetail( ({ "fuesse" }),
    "Bei genauer Betrachtung bist Du Dir sicher, dass DU derjenige warst.");
  AddDetail( ({ "betrachtung" }),
    "Gut, dass Du alleine hier bist. So kannst Du spaeter abstreiten, etwas mit dem Schutz zu "
    "tun zu haben.");
  AddDetail( ({ "spuren" }),
    "Die Spuren lassen darauf schliessen, dass hier jemand gefegt hat.");
  AddDetail( ({ "waende" }),
    "Die Waende sind glatt und Du verputest, dass dort jemand mit Putz nachgeholfen hat.");
  AddDetail( ({ "putz" }),
    "Was fuer ein Bloedsinn, warum verputzt jemand die Waende in einem Raum so tief unter der Erde?");
  AddDetail( ({ "bloedsinn" }),
    "Sowas faellt auch nur einem Adeligen ein.");
  AddDetail( ({ "adelige","adeliger" }),
    "Tjaja, die haben meist die Zeit fuer sowas.");
  AddDetail( ({ "zeit" }),
    "Zeit ist Geld.");
  AddDetail( ({ "geld" }),
    "Geld regiert die Welt.");
  AddDetail( ({ "welt" }),
    "Diese Welt heisst Andracia.");
  AddDetail( ({ "andracia" }),
    "Du denkst . o O (Schoen hier.)");
  AddDetail( ({ "wand" }),
    "Vor einer Wand steht ein seltsamer Kasten.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    ".");
  AddSmell( ({ "" }),
    ".");


  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Surren.");

  AddSound( ({ "surren" }),
    "Es scheint von dem Kasten zu kommen.");

  AddSound( ({ "kasten" }),
    "Der Kasten surrt leise.");


  //
}
	
//wird vom Kasten im Raum aufgerufen
void ausgang()
{
	AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_18h.lpc");
}