
#include "../def.h"

inherit "std/thing";

#include <properties.h>

object wipper;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine primitive Wippe");
  SetProp(P_LONG,
    "Du siehst eine Wippe, die eigentlich nur aus einem Fass und einem alten Holzbrett "
    "besteht. Man kann sich vermutlich draufstellen." );
SetProp(P_INFO,"Mit dieser Wippe kann man sicherlich jemanden der darauf steht hoch in die Luft "
							 "katapultieren.\n");

  SetProp(P_NAME, "Wippe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wippe","\nlabyloeschmich"}));

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1500000);
  //Gewicht sollte ausreichen, damit man sie nicht nehmen kann
  //SetProp(P_NOGET, "Du kannst die Wippe nicht nehmen, sie wuerde dann kaputt gehen.\n");
  AddCmd(({"steige","steig","sitze","sitz","kletter","klettere","stehe","steh"}),"aufdiewippe");
  AddCmd(({"verlasse","verlass"}),"wippeverlassen");
  AddCmd(({"spring","springe"}),"aufwippespringen");
 
}


int aufdiewippe(string str)
{
	notify_fail("Worauf moechtest Du steigen?\n");
	if(str!="auf wippe") return 0;
	if(wipper==TP)
		{
			write("Aber Du befindest Dich doch schon auf der Wippe!\n");
			return 1;
		}
	if(wipper)
		{
			write("Aber "+wipper->name()+" befindet sich doch schon auf der Wippe!\n");
			return 1;
		}
	if(TP->QueryProp(P_NOMOVE))
		{
			write(TP->QueryProp(P_NOMOVE));
			return 1;
		}
	wipper=TP;
	wipper->SetProp(P_NOMOVE,"Du musst erst die Wippe verlassen.\n");
	write("Du steigst auf die Wippe. Hoffentlich springt nun keiner auf das Brett.\n");
	say(TPN+" steigt auf die Wippe. Wenn Du nun auf das Brett springst, kannst Du "+TP->QueryPronoun(WEN)+" nach oben befoerdern.\n",TP);
	
	return 1;
}

int wippeverlassen(string str)
{
	notify_fail("Was moechtest Du verlassen?\n");
	if(str!="wippe")return 0;
	if(TP!=wipper)
		{
			write("Du befindest Dich nicht auf der Wippe.\n");
			return 1;
		}
	write("Du verlaesst die Wippe.\n");
	say(TPN+" verlaesst die Wippe.\n");
	TP->SetProp(P_NOMOVE,0);
	wipper=0;
	return 1;
}
	
int aufwippespringen(string str)
{
	notify_fail("Worauf willst Du springen?\n");
	if(str!="auf brett"&&str!="auf wippe")return 0;
	if(TP==wipper)
		{
			write("Du springst von einer Seite der Wippe auf die andere. Viel Sinn macht das nicht, sieht aber lustig aus.\n");
			say(TPN+" springt von einer Seite der Wippe auf die andere. Sieht irgendwie lustig aus.\nVielleicht solltest DU es mal versuchen!?\n");
			return 1;
		}
	if(!wipper)
		{
			write("Du springst auf die Wippe.\n");
			say(TPN+" springt auf die Wippe.\n");
			wipper=TP;
			return 1;
		}
	 //wenn der Springer leichter ist als der, der auf der Wippe steht.
	 if(TP->QueryProp(P_WEIGHT)<wipper->QueryProp(P_WEIGHT))
	 	{
	 		write("Du springst auf die Wippe. Leider bist Du viel zu leicht um "+
	 		wipper->name(WEN)+" hochzukatapultieren.\nEnttaeuscht steigst Du wieder runter.\n");
	 		say(TPN+" springt auf die andere Seite der Wippe. Leider ist "+TP->QueryPronoun(WER)+
	 		" viel zu leicht dafuer.\nEnttaeuscht steigt "+TP->QueryPronoun(WER)+" wieder herunter.\n",TP);
	 		return 1;
	 	}
	 	wipper->SetProp(P_NOMOVE,"Du haengst in den Wurzeln und musst Dich fallen lassen um normal laufen zu koennen.\n");
	 	write("Du springst auf die Wippe und katapultierst "+wipper->name()+" nach oben zwischen die Wurzeln.\n");
	 	tell_object(wipper, TPN+" springt auf die Wippe und katapultiert Dich nach oben.\n"+
	 	"Erschreckt klammerst Du Dich an den Wurzeln fest.\n");
	 	wipper=0;
	 	return 1;
	}

	 	
	
	