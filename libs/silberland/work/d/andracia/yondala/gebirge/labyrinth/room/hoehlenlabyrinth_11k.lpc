// Man kann 1-5 Edelsteine herausbrechen

#include "../def.h"
inherit "std/room";
#include <properties.h>
int steinda;
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	steinda=1+random(4);
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem seltsamen Gang" );
	steinda=1+random(4);
  
  SetProp( P_INT_LONG,
    "Du stehst in einem breiten, hellen Gang. Obwohl die Waende recht dunkel sind, scheinen "
    "sie leicht zu leuchten, ausserdem sind sie immer wieder von feinen Aederchen unterbrochen. "
    "Hier und da siehst Du es besonders hell aufblitzen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang hier ist etwas breiter als die vorherigen Gaenge und auch nicht so dunkel.");
  AddDetail( ({ "gaenge" }),
    "Die Gaenge, durch die Du Dich vorher beinahe hast quetschen muessen liegen hinter Dir.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind, wenn auch nicht schwarz, doch relativ dunkel. Dennoch geben sie ein "
    "schwaches Leuchten ab, so dass Du ohne extra Lichtquelle genug erkennen kannst. Hin und "
    "wieder ist das dunkle Gestein von feinen Aederchen durchzogen.");
  AddDetail( ({ "leuchten" }),
    "Das Leuchten ist sicher magischen Ursprungs, eine andere Erklaerung hast Du dafuer nicht.");
  AddDetail( ({ "ursprung" }),
    "Der Ursprung muss magisch sein, warum sonst sollte Gestein leuchten?");
  AddDetail( ({ "erklaerung" }),
    "Dir faellt keine bessere ein. Ausserdem bist Du mit dieser ganz zufrieden. Magie ist "
    "schliesslich was relativ normales in Andracia.");
  AddDetail( ({ "magie" }),
    "Fast jeder Bewohner Andracias kann Magie wirken.");
  AddDetail( ({ "bewohner" }),
    "Auch Du wohnst hier.");
  AddDetail( ({ "andracia" }),
    "So heisst diese Welt.");
  AddDetail( ({ "welt" }),
    "Andracia.");
  AddDetail( ({ "lichtquelle" }),
    "Du benoetigst keine, es ist hell genug.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist recht dunkel, trotzdem leuchtet es leicht. Du kannst nicht sagen, woraus es besteht.");
  AddDetail( ({ "aederchen" }),
    "Die Aederchen scheinen aus Silber zu bestehen.");
  AddDetail( ({ "silber" }),
    "Feine Silberadern durchziehen das Gestein. Schade, dass Du nichts dabei hast um es abzubauen.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus dem selben Gestein wie die Waende. Sie ist recht hoch und gewoelbt, "
    "sodass sie nahtlos in die Waende uebergeht.");
  AddDetail( ({ "blitzen","funkeln" }),
    "Hin und wieder siehst Du kleine Edelsteine in dem Gestein stecken.");
  AddDetail( ({ "edelsteine" }),
    "Ob man vielleicht welche herausbrechen kann?");
  AddDetail( ({ "silberadern","adern" }),
    "Das Silber zieht sich in feinen Adern durch das Gestein.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit einer duennen Sandschicht bedeckt.");
  AddDetail( ({ "sandschicht","schicht", "sand" }),
    "Der Sand ist sehr fein und er glitzert. Fast so, als waere es Edelsteinstaub.");
  AddDetail( ({ "edelsteinstaub","staub" }),
    "Schade, dass Du ihn nicht mitnehmen kannst, er ist bestimmt sehr wertvoll, aber er rieselt "
    "Dir immer wieder durch die Finger, so fein ist er. Du kannst einige Spuren erkennen.");
  AddDetail( ({ "spuren" }),
    "Hier ist offenbar jemand hergelaufen. Leider weisst Du nicht, wie lange das her ist.");
  AddDetail( ({ "finger" }),
    "Ein bisschen Edelsteinstaub klebt nun an ihnen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Stein.");
  AddSmell( ({ "stein" }),
    "Keine Ahnung, wie Stein riecht.");
  AddSmell( ({ "ahnung" }),
    "Sag Du es mir!");

  AddRoomMessage( 
    ({"Etwas blinkt vor Dir auf.\n",
    	"Was funkelt denn da?\n"}),60,"func");

  AddSound( DEFAULT_SOUND,
    "Es ist hier recht still.");

  AddSound( ({ "stille" }),
    "Du hoerst nichts.");


  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_12l.lpc");
  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_10l.lpc");
  
  AddCmd(({"brich","breche","brech"}),"rausbrechen"); //Edelsteine herausbrechen.


}

int rausbrechen(string str)
{
	notify_fail("Was moechtest Du herausbrechen?\n");
	if(str=="edelsteine raus"||str=="edelsteine heraus")
		{
			write("Nana, sollte einer nicht genuegen?\n");
			return 1;
		}
	if(str=="edelstein raus"||str=="edelstein heraus"||str=="edelstein aus wand raus"||str=="edelstein aus wand heraus"
		||str=="edelstein aus wand")
		{
			if(steinda)
				{
					write("Mit grosser Muehe gelingt es Dir, einen Edelstein aus der Wand zu brechen.\n");
					say(TPN+" bricht einen Edelstein aus der Wand.\n",TP);
					"/obj/gemmaster"->DistributeGem(1, 0, 1, TP);
					steinda--;
				}
			else
				write("Leider schaffst Du es nicht einen Stein herauszubrechen, sie sitzen alle zu fest.\n");
			return 1;
		}
		return 0;
	}	
			


	
