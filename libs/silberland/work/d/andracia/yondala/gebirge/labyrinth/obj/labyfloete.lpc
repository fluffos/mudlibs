#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Panfloete");
  SetProp(P_LONG,
    "Du haelst eine kleine Panfloete in den Haenden. Sie besteht aus mehreren Roehrchenn die "
    "mit Bast miteinander verbunden sind." );
  SetProp(P_NAME, "Panfloete");
  SetProp(P_GENDER, FEMALE);
  AddId(({"panfloete","floete","\nlabyfloete","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
//zum testen noch raus
//  SetProp(P_NODROP, "Die Panfloete sollst Du doch Aristocal geben!\n");
//  SetProp(P_NEVERDROP, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 0);
//  call_out("floeteweg",7200);
}

void floeteweg()
{
	tell_object(environment(TO),"Du stolperst und laest dabei die Floete fallen.\nDie Floete zerbricht.\n");
	remove();
}


	