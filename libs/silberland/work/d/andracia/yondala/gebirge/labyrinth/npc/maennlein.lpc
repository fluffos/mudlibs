//Ein kleines Maennlein
//steht beim Boot rum und hat ein Geheimnis im Inventory, 
//wird nur geclont, wenn die Spieler den Schlüssel 
// in 3k nicht gefunden haben (fragt Raum bei init ab)

inherit "std/npc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
//#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <npc.h>

inherit "/std/npc/spells.lpc";


	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  
  SetProp(P_SHORT, "Ein Maennlein");
  SetProp(P_LONG,
    "Ein kleines, duennes Maennlein steht hier rum. Es schaut Dich misstrauisch an "
    "und kichert zwischendurch leicht irr.");


  SetProp(P_NAME, "Maennlein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"maennlein"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit seinen Haendlein",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 5300);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_AGGRESSIVE,0);

    
//  AddInfo(DEFAULT_INFO, "sagt: Mit Euch rede ich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
        
  AddInfo(DEFAULT_INFO, 
                ({ "sagt: Mit Euch rede ich nicht.\n",
				"sagt: LALALA! Ich kann Euch nicht hoeren!\n",
				"kichert irre.\n",
                "fragt: Entschuldigung, aber seid Ihr dumm?\n" }) );

  AddInfo( ({ "geheimnis" }),
    "Das verrate ich nicht.",
    "sagt: ");
  AddInfo( ({ "schluessel" }),
    "Weiss ich, sag ich aber nicht.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");

	
		SetChats(3, ({
			"Das Maennlein huetet ein Geheimnis.\n",
   		"Das Maennlein kichert.\n",
   		"Das Maennlein fluestert: Ich weiss was, was Du nicht weiss!\n",
		"Das Maennlein singt: Ein Maennlein steht im Walde...\n"}) );
   	CLONE(LABY_OBJ+"geheimnis.lpc",TO);
   	

   
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
/*    case "neutral":
      call_out("reaction", 0, TP,
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      break;*/
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}




 	 	
 	 	