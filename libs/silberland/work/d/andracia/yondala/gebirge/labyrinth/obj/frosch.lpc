#include "../def.h"

inherit "std/thing";

#include <properties.h>




void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Frosch");
  SetProp(P_LONG,
    "Du siehst einen kleinen gruenen Frosch. Er sieht lecker aus." );
  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddId(({"frosch","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_MISC_MAGIC);
  SetProp(P_INFO, "Du kannst diesen Frosch essen. Welchen Effekt er haben wird, kannst Du allerdings nicht erkennen.\n");
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NODROP, 0);
  AddDetail( ({ "" }),
    ".");

  AddCmd(({"esse","ess","iss"}),"essen"); 
 }


int essen(string str)
{
	notify_fail("Was moechtest Du essen?\n");
	if(!id(str)) return 0;
	write("Du isst den kleinen Frosch und spuerst, wie sich alles in Dir zusammenzieht.\n");
	say(TPN+" isst etwas und wird ploetzlich klein und gruen.\n");
	TP->SetProp(P_FROG, 1);
	CLONE(LABY_OBJ+"entfroscher.lpc", TP);
	remove();
	return 1;
}