// Das Reich des Hopkigo

#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem schwach erhellten Gang" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier in einem schwach erhellten Gang. Nur schemenhaft erkennst Du Deine Umgebung. "
    "Nach Norden weitet sich der Gang zu einer kleinen Hoehle, suedlich zweigt er nach "
    "Sueden und Suedosten ab und verliert sich in der Dunkelheit. Die Waende stehen nah beieinander, "
    "sie sind aus blankem Fels und voller tiefer Kratzer. Es ist recht warm hier." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
     "Der Gang fuehrt Dich nach Norden. Er besteht nur aus dunklem Fels." );
  AddDetail( ({ "richtung" }),
    "Du kannst hier nach Norden gehen.");
  AddDetail( ({ "norden"}),
    "Dorthin fuehrt Dich der Gang, wenn Du Dich traust einfach in die Dunkelheit zu gehen.");
  AddDetail( ({ "dunkelheit","ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich erwartet wenn Du den Gang weiter entlang gehst.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Allerdings ist er nicht natuerlich entstanden, denn "
    "Du kannst deutlich die Bearbeitungsspuren sehen.");
  AddDetail( ({ "waende" }),
    "Die Waende sind sehr dicht beieinander, fast kannst Du beide gleichzeitig beruehren.");
  AddDetail( ({ "decke" }),
    "Die niedrige Decke ist nur knapp ueber Dir. Hoffentlich stoesst Du Dir nicht Deinen Kopf.");
  AddDetail( ({ "wand" }),
    "Die beiden Waende rechts und links von Dir kommen Dir bedrohlich nahe. Oder taeuscht Dich "
    "Dein Gefuehl?");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Jemand hat diesen Gang muehsehlig in den Fels geschlagen, er ist nicht natuerlich entstanden.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, kalt und ein wenig feucht.");
  AddDetail( ({ "gefuehl" }),
    "Kannst Du Deinen Gefuehlen trauen?");
  AddDetail( ({ "kopf" }),
    "Der ruht fest auf Deinen Schultern.");
  AddDetail( ({ "schultern" }),
    "Die hast Du leicht angezogen.");
  AddDetail( ({ "licht" }),
    "Das Licht wird von den dunklen Waenden fast gaenzlich verschluckt.");
  AddDetail( ({ "druck" }),
    "Der ist zwar unangenehm, wird Dich aber vermutlich nicht umbringen.");
  AddDetail( ({ "kratzer" }),
    "Die Kratzer sind riesig. Welch Ungetuem die wohl verursacht hat?");
  AddDetail( ({ "ungetuem" }),
    "Dem moechtest Du wohl lieber nicht begegnen.");
  AddDetail( ({ "hoehle" }),
    "Im Norden weitet sich der Gang zu einer kleinen Hoehle.");
  AddDetail( ({ "umgebung" }),
    "Du stehst hier in einem schwach erhellten Gang. "
    "Nach Norden weitet er sich zu einer kleinen Hoehle, suedlich zweigt er nach "
    "Sueden und Suedosten ab und verliert sich in der Dunkelheit. Die Waende sind nah beieinander, "
    "sie sind aus blankem Fels und voller tiefer Kratzer. Es ist recht warm hier.");
  AddDetail( ({ "sueden","suedosten" }),
    "Der Gang verliert sich dort in der Dunkelheit.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "platsch", "platschen", "tropfen" }),
    "Irgendwo tropft es, leider siehst Du nicht wo.");
  AddSound( ({ "ohren" }),
    "Deine Ohren klingen normal. Wie Ohren.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Den Geruch hier kannst Du nicht recht einschaetzen. Es riecht nach faulem Heu und "
    "Mundgeruch.");
  AddSmell( ({ "geruch" }),
    "Irgendwie ist der Geruch genauso undefinierbar wie unangenehm.");
  AddSmell( ({ "heu" }),
    "Nun gut, faules Heu ist sicher nicht sonderlich gefaehrlich. Aber schoen riechen tut es "
    "dennoch nicht.");
  AddSmell( ({ "mundgeruch" }),
    "Ja wirklich, es riecht hier wie der schlechte Atem eines Ungetuems.");
  AddSmell( ({ "atem", "atemschub","schub" }),
    "Hin und wieder wirbelt die Luft um Dich und bringt einen neuen, fuerchterlichen Atemschub "
    "an Dich heran.");
  AddSmell( ({ "ungetuem" }),
    "Das Ungetuem kannst Du nicht riechen. Nur seinen Atem, der ihm vorrauseilt.");


  AddRoomMessage( 
    ({"Du hoerst ein leises Scharren.\n",
    	"Ploetzlich bewegt sich die Luft.\n",
    	"Was war das?\n",
    	"Du fuehlst Dich beobachtet.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein leises Scharren und auch die Luft macht leise Geraeusche, "
    "wenn sie sich bewegt.");

  AddSound( ({ "scharren" }),
    "Wer auch immer dieses Scharren verursacht scheint ganz in der Naehe zu sein.");
  AddSound( ({ "naehe" }),
    "In DEINER Naehe.");
  AddSound( ({ "luft", "geraeusche" }),
    "Du hoerst die Luft an Dir vorbei rauschen.");
  AddSound( ({ "" }),
    ".");


  AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_16h.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_18h.lpc");
  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_18i.lpc");
 }

	
