#include "../def.h"

inherit "std/thing";

#include <properties.h>

int fuell_status;

/*
Stati:
0=leer
1=verdorbener Trank
2=mit Rankensaft
3=mit zentrifugiertem Rankensaft
4=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern
5=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern, erhitzt
6=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft
7=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert
8=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert, zentrifugiert
9=mit zentrifugiertem Rankensaft und zerstossenen Pfefferkoernern, erhitzt, mit Beerensaft, gefiltert, zentrifugiert,erhitzt

*/
int status_geben()
{
	return fuell_status;
}
void status_0()
{
  fuell_status=0;
  SetProp(P_SHORT, "Ein leeres Reagenzglas");
  SetProp(P_LONG, "Du siehst ein leeres Reagenzglas." );
  SetProp(P_INFO, "Dieses Glas kann gefuellt werden. Es ist bestimmt auch Hitze resistent.\n");	
  RemoveId(({"saft","rankensaft","mixtur","trank"})); 
}
void status_1()
{
  fuell_status=1;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas. Der Inhalt ist verdorben." );
  SetProp(P_INFO, "Du siehst ein gefuelltes Reagenzglas. Der Inhalt ist verdorben und nicht mehr zu gebrauchen. Du solltest das Reagenzglas auskippen.\n");	
  AddId(({"mixtur"}));  
  RemoveId(({"saft","rankensaft","mixtur","trank"})); 
}
void status_2()
{
  fuell_status=2;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit Rankensaft gefuellt.\n");	
  AddId(({"saft","rankensaft","mixtur"}));  
}

void status_3()
{
  fuell_status=3;
    SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
	SetProp(P_INFO, "Dieses Reagenzglas wurde mit zentrifugierten Rankensaft gefuellt.\n");
  AddId(({"saft","rankensaft","mixtur"}));  
}
void status_4()
{
  fuell_status=4;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und "+
	"zerstossenen Pfefferkoernern gefuellt.\n");	
  RemoveId(({"saft","rankensaft"}));    
  AddId(({"mixtur"}));
}

void status_5()
{
  fuell_status=5;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und zerstossenen Pfefferkoernern gefuellt und danach erhitzt.\n");	
  AddId(({"mixtur"}));
  RemoveId(({"saft","rankensaft"}));
}

void status_6()
{
  fuell_status=6;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und "+
     "zerstossenen Pfefferkoernern gefuellt, danach erhitzt und mit Beerensaft gemischt.\n");
   AddId(({"mixtur"}));
   RemoveId(({"saft","rankensaft"}));
}

void status_7()
{
  fuell_status=7;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und "+
  "zerstossenen Pfefferkoernern gefuellt, danach erhitzt, mit Beerensaft gemischt und gefiltert.\n");	
  AddId(({"mixtur"}));
  RemoveId(({"saft","rankensaft"}));
}

void status_8()
{
  fuell_status=8;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und "+
  "zerstossenen Pfefferkoernern gefuellt, erhitzt, mit Beerensaft gemischt, gefiltert und zentrifugiert.\n");	
  AddId(({"mixtur"}));
  RemoveId(({"saft","rankensaft"}));
}

