void abgekuehlt()
{
	if(status_geben()!=9) return;
	
	tell_object(environment(TO),"Der Trank ist abgekuehlt und verwandelt sich in einen kleinen, gruenen Frosch.\nDer Frosch huepft aus dem Glas.\n");
	//CLONE(LABY_OBJ+"froschtrank.lpc", TP);
	CLONE(LABY_OBJ+"frosch.lpc", environment(TO));
	status_0();
}

void status_9()
{
  fuell_status=9;
  SetProp(P_SHORT, "Ein gefuelltes Reagenzglas");
  SetProp(P_LONG, "Du siehst ein gefuelltes Reagenzglas." );
  SetProp(P_INFO, "Dieses Reagenzglas wurde mit einer Mixtur aus zentrifugierten Rankensaft und "+
  "zerstossenen Pfefferkoernern gefuellt, erhitzt, mit Beerensaft gemischt, gefiltert, "+
  "zentrifugiert und erhitzt.\nPerfekt, der Trank muss nur noch etwas abkuehlen.");
  call_out("abgekuehlt", 60);  
  AddId(({"mixtur", "trank"}));
  RemoveId(({"saft","rankensaft"}));
}




void create() 
{
  if (!is_clone(TO)) return;
  ::create();
 fuell_status=0;
  SetProp(P_SHORT, "Ein Reagenzglas");
  SetProp(P_LONG, "Du siehst ein leeres Reagenzglas." );
  SetProp(P_NAME, "Reagenzglas");
  SetProp(P_GENDER, NEUTER);
  AddId(({"glas","reagenzglas","\nlabyquestreagenzglas","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_GLASS);
  SetProp(P_INFO, "Dieses Glas kann gefuellt werden. Es ist bestimmt auch Hitze resistent.\n");
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NODROP, 0);
  AddDetail( ({ "" }),
    ".");

  AddCmd(({"fuelle", "fuell","befuelle","befuell"}),"befuellen"); //man kann diverse Dinge reinfuellen
  AddCmd(({"kippe", "kipp"}),"auskippen"); 
 }


befuellen(string str)
{
	string was, dummy;
	notify_fail("Was moechtest Du in was fuellen?\n");
	if(!str) return 0;
    if (sscanf(str, "%s in glas%s", was, dummy) != 2) return 0;	
	if(!present(was,TP))
	{
		write("So etwas besitzt Du nicht.\n");
		return 1;
	}
	if(was=="pfefferkoerner"||was=="koerner")
	{
		if(present("\nzerstossenepfefferkoerner",TP))
		{
			if(status_geben()==0)
			{
				write("Eh Du die zerstossenen Pfefferkoerner in das Glas fuellst, sollte vorher etwas andere hinein.\n");
				return 1;
			}
			
			if(status_geben()==1)
			{
				write("Du schuettest die zerstossenen Pfefferkoerner in die bereits verdorbene Mixtur.\n");
				present("\nzerstossenepfefferkoerner",TP)->remove();
				return 1;
			}
			
			write("Du fuellst die zerstossenen Pfefferkoerner in das Reagenzglas.\n");
			if(status_geben()==3)
			{
				status_4();
				write("Die Mixtur im Reagenzglas leuchtet kurz auf.\n");

			}
			else
			{
				write("Du hast Dich nicht an das richtige Rezept gehalten. Die Mixtur ist verdorben.\n");
				status_1();
			}
			present("\nzerstossenepfefferkoerner",TP)->remove();
			return 1;			
		}
		//wenn die Pfefferkoerner noch nicht zerstossen sind
		else
		{
			if(status_geben()==0)
			{
				write("Eh Du die Pfefferkoerner in das Glas fuellst, sollte vorher etwas anderes passieren.\n");
				return 1;
			}
			
			if(status_geben()==1)
			{
				write("Du schuettest die Pfefferkoerner in die bereits verdorbene Mixtur.\n");
				present("\nzerstossenepfefferkoerner",TP)->remove();
				return 1;
			}
			
			write("Du fuellst die zerstossenen Pfefferkoerner in das Reagenzglas.\n");
			write("Du hast Dich nicht an das richtige Rezept gehalten. Die Mixtur ist verdorben.\n");
			status_1();
			present("pfefferkoerner",TP)->remove();
			return 1;			
		}	
			
	}
	
	return 1;
}
auskippen(string str)
{
	notify_fail("Was moechtest Du auskippen?\n");
	if(str!="glas aus"&&str!="reagenzglas aus") return 0;
	if(fuell_status==0)
	{
		write("Das Reagenzglas ist schon leer.\n");
		return 1;
	}
	write("Du kippst das Reagenzglas aus, der Inhalt versickert langsam im Boden.\n");
	status_0();
	return 1;
}

	
	
	