
#include "../def.h"
inherit "std/room";
#include <properties.h>


void rutsche_7()
{
    TP->SetProp(P_BLIND, ([
         BLIND_TIME: (7),
         BLIND_MSG:  "Du bist von dem Licht geblendet.\n",
         BLIND_END_MSG: "Deine Augen gewoehnen sich langsam an die Hellichkeit.\nDu kannst wieder sehen.\n"]));
    TP->move( LABY_ROOM + "hoehlenlabyrinth_22f.lpc", M_NOCHECK);
    	TP->SetProp(P_PARALYZED,0);

}
void rutsche_6()
{
  write("Ploetzlich siehst Du grelles Licht vor Dir.\n");
  call_out("rutsche_7",1);
}
void rutsche_5()
{
  call_out("rutsche_6",3);
  write("Allmaehlich wirst Du langsamer.\n");
}
void rutsche_4()
{
  call_out("rutsche_5",3);
write("Eine leichte Kurve wirft Dich nach rechts.\n");

}
void rutsche_3()
{
  call_out("rutsche_4",3);
write("Der Fahrtwind rauscht in Deinen Ohren.\n");

}
void rutsche_2()
{
  call_out("rutsche_3",3);
  write("Eine leichte Kurve wirft Dich nach links.\n");

}
void rutsche_1()
{
  call_out("rutsche_2",3);
  write("Du saust mit atemberaubender Geschwindigkeit in die Tiefe.\n");
}

void init()
{
  call_out("rutsche_1",2);
  TP->SetProp(P_PARALYZED, ([
         PARALYZE_TIME: (-1),
         PARALYZE_MSG:  "Die Geschwindigkeit laesst Dich vor Angst erstarren.\n",
         PARALYZE_MSG_OTHER: TPN+" wirkt panisch.\n",
         PARALYZE_END: "",//TPN+" erholt sich von dem Schreck.\n",
         PARALYZE_END_OTHER: ""]));//"Du erholst Dich von Deinem Schreck.\n"]));
  ::init();
}
      
          

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einer Rutsche");
  
  SetProp( P_INT_LONG,
    "Um Dich herum ist es dunkel. Du rutscht mit atemberaubender Geschwindigkeit eine "
    "sehr steile Rutsche herunter. Du bist starr vor Schreck." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_HIDE_EXITS, 1);



 }



