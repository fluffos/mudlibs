#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zauberstab");
  SetProp(P_LONG,
    "Du siehst einen kleinen, duennen Zauberstab. Er leuchtet in vielen bunten Farben. An seiner Spitze sitzt "
	"ein kleiner Stern und sein Stab ist ebenfalls sternfoermig." );
  SetProp(P_NAME, "Zauberstab");
  SetProp(P_GENDER, MALE);
  AddId(({"zauberstab","stab","\nlabyquestzauberstab"}));
  SetProp( P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_INFO, "Niedlicher kleiner Stab. Was wohl passiert, wenn man ihn schwingt?\n");
    AddCmd(({"schwinge", "schwing"}),"schwingen"); 
}

int schwingen(string str)
{
	notify_fail("Was moechtest Du schwingen?");
	if(str!="stab"&&str!="zauberstab") return 0;
	
	write("Das wird dereinst eine Spassfunktion sein. Fuer die Quest nicht relevant.\n"+
	"Der Stab wird an anderer Stelle benoetigt.\n");
	return 1;
}