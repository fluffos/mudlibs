#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Du haelst einen kleinen, rostigen Schluessel in den Haenden. Eigentlich hast Du ihn Dir gar nicht verdient. "+
	"Du schaemst Dich ein bisschen, weil Du so forschfaul warst. Du kannst das Boot damit oeffnen, "+
	"mehr aber nicht." );

  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId(({"schluessel","\nbootschluessel","\ngnadenschluessel","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_IRON);


  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
 
}

	