#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Boot");
  SetProp(P_LONG,
    "Ein kleines Boot ist hier festgemacht. "
    "Man kann sicherlich reinklettern und damit davon fahren." );
 AddDetail( ({ "schloss" }),
    "Ein geoeffnetes Schloss haengt nutzlos am Boot.");
 AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  SetProp(P_NAME, "Boot");
  SetProp(P_GENDER, MALE);
  AddId(({"boot"}));
  SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Das Boot ist viel zu schwer.\n");
  AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern
  AddCmd( ({ "schliesse","schliess", "sperre","sperr"}), "aufschliessen" ); 

  AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern
  AddCmd( ({ "schliesse","schliess", "sperre","sperr"}), "aufschliessen" ); 

}

int klettern(string str)
{
	notify_fail("Worein moechtest Du klettern?\n");
	if(str!="in boot"&&str!="in boot hinein"&&str!="in boot rein"&&str!="rein")return 0;
  
	this_player()->move(LABY_ROOM+"imboot", M_GO, "ins Boot", "klettert",
                                "kommt herein geklettert");
		

	return 1;
}

int aufschliessen(string str)
{
	notify_fail("Was moechtest Du aufschliessen?\n");
	if(str!="schloss auf")return 0;
	write("Das Schloss ist schon aufgeschlossen. Du kannst in das Boot klettern.\n");
	return 1;
}

	
	