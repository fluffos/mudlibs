#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine lange Holzstange");
  SetProp(P_LONG,
    "Du siehst eine lange Holzstange. Sie ist relativ gerade und hat mehrere "
    "Loecher. Was es damit wohl auf sich hat?" );
  SetProp(P_NAME, "Holzstange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"holzstange","stange","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_INFO, "Wenn Du genuegend Holzstaebe und Stangen hast kannst Du daraus "
                  "eine Leiter basteln.\n");
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 0);
  AddDetail( ({ "loecher" }),
    "Mit deren Hilfe kann man bestimmt eine Leiter basteln.");

  AddCmd(({"bastel", "bastele","bastle"}),"basteln"); //wenn man 10 Holzstaebe hat kann man eine komplette Leiter basteln
 }

object guck_ob_stab(object ding)
{if(ding->id("holzstab")) return ding;}

object guck_ob_stange(object ding)
{if(ding->id("holzstange")) return ding;}

int basteln(string str)
{
	object *staebe;
	object *stangen;
	
	int i;
	notify_fail("Was moechtest Du basteln?\n");
	if(str!="leiter") return 0;
	
	staebe=all_inventory(TP);
	staebe=filter_array(staebe, "guck_ob_stab");
	if(sizeof(staebe)<8)//wenn zu wenig Staebe da sind
		{
			write("Du hast nicht genuegend Holzstaebe.\n");
			return 1;
		}
	stangen=all_inventory(TP);
	stangen=filter_array(stangen, "guck_ob_stange");
	if(sizeof(staebe)<2)//wenn zu wenig Stangen da sind
		{
			write("Du benoetigst dafuer zwei Holzstangen.\n");
			return 1;
		}
	
	write("Du bastelst aus den Holzstaeben und den beiden Holzstangen eine Leiter.\n");	
	say(TPN+" bastelt eine Leiter.\n");
	for(i=sizeof(staebe);i--;i>0)
	{
		staebe[i]->remove();
	}


	
	CLONE(LABY_OBJ +"holzleiter.lpc", TP);
	for(i=sizeof(stangen);i--;i>0)
	{stangen[i]->remove();}

	return 1;
}
	
	
	
	