  AddDetail( ({ "fuesse" }),
    "Deine beiden Fuesse stehen relativ fest auf dem Felsvorsprung.");
  AddDetail( ({ "nase" }),
    "Der Felsvorsprung schaut aus der Felswand wie eine Nase aus einem Gesicht.");
  AddDetail( ({ "gesicht" }),
    "Die Felswand ist kein Gesicht, das war nur ein Vergleich.");
  AddDetail( ({ "vergleich" }),
    "Du hast den Felsvorsprung in der Felswand mit einer Nase in einem Gesicht verglichen "
    "und fandest das sehr passend.");
  AddDetail( ({ "abgrund", "tiefe","tiefen" }),
    "Der Abgrund scheint unendlich tief zu sein. Dir wird leicht schwindelig bei dem Anblick.");
  AddDetail( ({ "anblick" }),
    "Erschreckt drueckst Du Dich mit dem Ruecken an die Felswand.");
  AddDetail( ({ "felswand", "wand" }),
    "Die Felswand ist sehr glatt, Du siehst keinerlei Risse oder Spalten, an denen Du nach "
    "oben oder unten oder sonst irgendwohin klettern koenntest. Ein Baum hat es geschafft "
    "seine Wurzeln in den Fels zu treiben.");
  AddDetail( ({ "risse","spalten" }),
    "Leider sind keine zu sehen, die gross genug waeren, dass Du Dich an ihnen festhalten "
    "koenntest.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist leuchtend blau, welch Wohltat nach der langen Zeit in der stickigen Hoehle.");
  AddDetail( ({ "wohltat" }),
    "Es tut gut, wieder an der frischen Luft zu sein.");
  AddDetail( ({ "luft" }),
    "Du atmest ein paar mal tief ein und aus. Aaaaah, das tut gut!");
  AddDetail( ({ "hoehle" }),
    "Ganz so toll war das da drin ja nicht. Aber ob es hier, auf diesem schmalen Felsvorsprung "
    "besser ist wagst Du auch erstmal zu bezweifeln.");
  AddDetail( ({ "zeit" }),
    "Na, Du warst relativ lange in der Hoehle.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus einem kleinen Felsvorsprung, der Dich noch einen Schritt nach "
    "Osten gehen laesst. Ausserdem liegen ein paar kleine Steinchen herum und etwas Gras "
    "waechst in der Spalte zwischen Felsvorsprung und Felswand.");
  AddDetail( ({ "schritt" }),
    "Den kannst Du machen, geh einfach nach Westen.");
  AddDetail( ({ "osten" }),
    "Dort geht der Felsvorsprung noch ein Stueckchen weiter, weisst Du aber, weil Du dort herkommst.");
  AddDetail( ({ "stueckchen" }),
    "Nicht viel, der Felsvorsprung ist insgesamt nicht sonderlich breit.");
  AddDetail( ({ "steinchen" }),
    "Sie interessierren Dich nicht weiter als dass sie eine potenzielle Gefahr des "
    "Ausrutschens sind.");
  AddDetail( ({ "ausrutschen" }),
    "Wenn Du nicht aufpasst, rutscht Du aus und faellst unaufhaltsam in die Tiefe.");
  AddDetail( ({ "gefahr" }),
    "Gut, dass Du sie gesehen hast.");
  AddDetail( ({ "spalte" }),
    "In der Spalte zwischen Felsvorsprung und Felswand waechst recht hohes Gras.");
  AddDetail( ({ "gras" }),
    "Dir wird gerade bewusst, dass die Graswurzeln vermutlich auf Dauer den Halt des "
    "Felsvorsprungs loesen koennten.");
  AddDetail( ({ "halt" }),
    "Hoffentlich ist es jetzt noch nicht so weit. Waere schade, wenn Dein junges Leben hier "
    "ein so jaehes Ende finden wuerde, nicht wahr?");
  AddDetail( ({ "leben" }),
    "Schoen, dass Du am Leben bist.");
  AddDetail( ({ "ende" }),
    "Vielleicht solltest Du Dich besser etwas beeilen, um ein fruehzeitiges Ende zu vermeiden?");
  AddDetail( ({ "graswurzeln","wurzeln" }),
    "Die Wurzeln haben sich schon tief in die Spalte eingegraben.");
  AddDetail( ({ "bergkluft","kluft" }),
    "Du stehst direkt in einer Kluft zwischen zwei Bergen. Leider kannst Du den anderen "
    "Berg nicht so ohne Weiteres erreichen");
  AddDetail( ({ "weiteres" }),
    "Er ist von hier aus zu weit weg.");
  AddDetail( ({ "berge" }),
    "Die Kluft teilt diese zwei Berge. Den, auf dessen Felsvorsprung Du stehst und den, der "
    "nur wenige Meter entpfernt von Dir steht.");
  AddDetail( ({ "berg" }),
    "Dir gegenueber ist ein Berg. Wie Du da wohl hinkommst? Du kannst deutlich erkennen, dass "
    "zwischen den Felsen drueben ein Weg abgeht.");
  AddDetail( ({ "dauer" }),
    "Hoffentlich tun sie das nicht allzubald. Oder erst, wenn Du nicht mehr hier stehst.");
  AddDetail( ({ "ruecken" }),
    "Den drueckst Du fest an die Felswand, damit Du so weit wie moeglich vom Abgrund entfernt stehst.");
  AddDetail( ({ "haare" }),
    "Deine Haare wehen im Wind.");
  AddDetail( ({ "wind" }),
    "Der Wind weht kraeftig durch die Kluft. Du kannst ihm lauschen.");
  AddDetail( ({ "aasgeier","geier" }),
    "Der wartet vermutlich darauf, dass Du abstuerzt.");
  AddDetail( ({ "windboe","boe", "windboen" }),
    "Die Windboen werfen Dich fast um.");
  AddDetail( ({ "baum" }),
    "Der Baum hat es geschafft seine Wurzeln in den harten Fels zu treiben. Gesund sieht "
    "er allerdings nicht aus, er hat wenige Blaetter und sein Stamm ist grau und vertrocknet.");
  AddDetail( ({ "blaetter" }),
    "Der Baum hat nur wenige Blaetter.");
 AddDetail( ({ "stamm", "baumstamm" }),
    "Der Baumstamm ist trocken und morsch. Man koennte ihn mit Leichtigkeit durchsaegen.");
 AddDetail( ({ "leichtigkeit" }),
    "Dazu braeuchte man eine Saege.");
 AddDetail( ({ "wurzeln" }),
    "Die Wurzeln des Baumes haben es geschafft sich in den harten Fels zu graben. Sie halten "
    "den Baum an der Felswand fest.");
 AddDetail( ({ "fels" }),
    "Der Fels ist grau, relativ glatt und kuehl.");
 AddDetail( ({ "saege" }),
    "Wo kriegt man sowas bloss? Hier wird ja wohl nicht einfach eine rumliegen, oder?");
 AddDetail( ({ "felsen" }),
    "Zwischen den Felsen auf dem gegenueberliegenden Berg liegt ein Weg.");
 AddDetail( ({ "weg" }),
    "Dieser Weg scheint ein guter Ausweg von hier zu sein. Doch wie kannst Du ihn erreichen? "
    "Zum Springen ist es sicherlich zu weit. Du musst eine bessere Idee haben.");
 AddDetail( ({ "ausweg" }),
    "Den Weg auf der gegenueberliegenden Seite zu benutzen scheint Dir der beste Ausweg.");
 AddDetail( ({ "springen" }),
    "Nein, dazu ist der andere Berg wirklich zu weit weg.");
 AddDetail( ({ "idee" }),
    "Schau Dich doch ein bisschen um, Dir faellt bestimmt etwas ein, da bin ich mir sicher.");
 AddDetail( ({ "seite" }),
    "Du stehst auf einem Felsvorsprung von einem Berg. Direkt Dir gegenueber ist ein anderer "
    "Berg. Das ist mit der Seite gemeint.");
 AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist frisch und wohltuend.");
  AddSmell( ({ "luft","bergluft" }),
    "Gluecklich atmest Du die frische Bergluft ein..");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Der Wind zerrt an Deinen Haaren.\n",
    	"Hoppla, Du rutscht auf einem Steinchen aus und kannst Dich gerade noch halten.\n",
    	"Dir wird schwindelig.\n",
    	"Ein Aasgeier kreist ueber Dir.\n"
    	"Ein Steinchen kullert in die Tiefe.\n",
    	"Fast haette eine Windboe Dich vom Felsvorsprung geweht.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind durch die Kluft rauschen.");

  AddSound( ({ "wind", "" }),
    "Der Wind braust mit lautem Getoese durch die Kluft.");
  AddSound( ({ "kluft", "" }),
    "Es ist ziemlich laut hier.");
  AddSound( ({ "getoese", "" }),
    "Man kann kaum etwas anderes hoeren als den Wind.");


  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_22f.lpc");
  AddCmd( ({ "ziehe","zieh" }), "saegeziehen" );
  AddCmd( ({ "lasse","lass" }), "saegeloslassen" );
  AddCmd( ({ "druecke","drueck" }), "saegedruecken" );
  AddCmd( ({ "saege","saeg","faelle","faell" }), "baumfaellen" );
  AddCmd( ({ "ergreife","ergreif","greife","greif" }), "griffgreifen" );

 }

void baumfaellt()
{
	tell_room(TO,"Ploetzlich hoerst Du ein lautes Knarzen und der Baum neigt sich zu Seite.\n"+
	"Der Baum faellt um und verfehlt Dich dabei um Haaresbreite. Allerdings begraebt er die Saege unter sich.\n");
	present("\nsaegeangedrueckt",TO)->remove();
	linkergreifer->SetProp(P_NOMOVE,0);
	linkergreifer=0;
	rechtergreifer->SetProp(P_NOMOVE,0);
	rechtergreifer=0;
  AddDetail( ({ "baum" }),
    "Der Baum hat es geschafft seine Wurzeln in den harten Fels zu treiben. Allerdings "
    "wurde er kuerzlich abgesaegt und liegt nun ueber dem Abgrund.");
 AddDetail( ({ "wurzeln" }),
    "Die Wurzeln des Baumes haben es geschafft sich in den harten Fels zu graben. Sie hielten "
    "den Baum an der Felswand fest, ehe er abgesaegt wurde.");
 AddDetail( ({ "stamm", "baumstamm" }),
    "Der Baumstamm liegt quer ueber dem Abgrund und verbindet den Felsvorsprung mit dem "
    "Berg auf der anderen Seite. Er ist trocken und morsch, sieht aber so aus, als koennte "
    "man ihn gefahrlos passieren.");
  AddSpecialExit("baumstamm", "baumstammausgang");
 // AddExit("baumstamm", LABY_ROOM+"hoehlenlabyrinth_23e.lpc");
	
}
int baumstammausgang(string dir)
{     return this_player()->move(LABY_ROOM+"hoehlenlabyrinth_23e", M_GO, 0,
                    "klettert ueber den Baumstamm", "kommt ueber den Baumstamm");
					}
int saegeloslassen(string str)
{
	notify_fail("Was moechtest Du loslassen?\n");
	if(str=="griff los"||str=="saegegriff los"||str=="los"||str=="saege los")
		{
			if(TP==linkergreifer)
				{
					write("Du laesst den linken Saegegriff los.\n");
					say(TPN+" laesst den linken Saegegriff los.\n",TP);
					linkergreifer=0;
					TP->SetProp(P_NOMOVE,0);
					return 1;
				}
			if(TP==rechtergreifer)
				{
					write("Du laesst den rechten Saegegriff los.\n");
					say(TPN+" laesst den rechten Saegegriff los.\n",TP);
					rechtergreifer=0;
					TP->SetProp(P_NOMOVE,0);
					return 1;
				}
			write("Du haelst keinen Griff.\n");
		}
		return 0;
	}		
		


int baumfaellen(string str)
{
	notify_fail("Was moechtest Du faellen?\n");
	if(str!="baum"&&str!="baumstamm")return 0;
	
	if(present("\nsaegeangedrueckt",TO))
		{
			write("Du musst den Saegegriff dafuer ergreifen und dann an der Saege ziehen.\n");
			return 1;
		}
	
	if(present("\nsaege",TO)||present("\nsaege",TP))
		write("Du musst die Saege dafuer vorher in den Baum druecken.\n");
		
	else
		write("Du hast keine Saege dafuer.\n");
	return 1;
}

int saegedruecken(string str)
{
	notify_fail("Was moechtest Du in den Baumstamm druecken?\n");
	if(str!="saege in baumstamm"&&str!="saege in stamm"&&str!="saege in baum") return 0;
	if(present("\nsaegeangedrueckt",TO))
		{
			write("Die Saege ist bereits in den Baumstamm gedrueckt.\n");
			return 1;
		}
	if(present("\nsaege",TO))
		{
			write("Du drueckst die Saege in den Baumstamm. Nun kannst Du den Griff ergreifen.\n");
			say(TPN+" drueckt die Saege in den Baumstamm.\n");
			present("\nsaege",TO)->remove();
			CLONE(LABY_OBJ + "saegeangedrueckt.lpc",TO);
			return 1;
		}
	else if (present("\nsaege",TP))
		{		
			write("Du drueckst die Saege in den Baumstamm. Nun kannst Du den Griff ergreifen.\n");
			say(TPN+" drueckt die Saege in den Baumstamm.\n",TP);
			present("\nsaege",TP)->remove();
			CLONE(LABY_OBJ + "saegeangedrueckt.lpc",TO);
			return 1;
		}
	else
			write("Hier ist keine Saege.\n");
			return 1;
}	

int griffgreifen(string str)
{
	notify_fail("Welchen Griff moechtest Du greifen? Den linken oder den rechten?\n");


	if(str=="linken griff"||str=="linken saegegriff")
		{
			if(TP==linkergreifer)
				{
					write("Du hast den Griff doch schon. Jetzt musst Du an der Saege ziehen.\n");
					return 1;
				}
			if(TP==rechtergreifer)
				{
					write("Du hast schon den rechten Griff.\n");
					return 1;
				}
				
			if(TP->QueryProp(P_NOMOVE))
				{
					write(TP->QueryProp(P_NOMOVE));
					return 1;
				}
			if(linkergreifer)
				{
					write(linkergreifer->name()+" hat den linken Griff schon. Nimm dich den rechten.\n");
					return 1;
				}
	    if(!present("\nsaegeangedrueckt",TO))
	    	{
	    		write("Dafuer musst Du erst die Saege in den Baumstamm druecken.\n");
			    return 1;
		     }			
		  linkergreifer=TP;
	    linkergreifer->SetProp(P_NOMOVE,"Du musst erst den Griff der Saege loslassen.\n");
			write("Du ergreifst den linken Griff der Saege. Nun kannst Du ziehen um den Baumstamm durch zu saegen.\n");
			say(TPN+" ergreift den linken Griff der Saege.\n");
			return 1;
		}
				
	if(str=="rechten griff"||str=="rechten saegegriff")
		{
			if(TP==rechtergreifer)
				{
					write("Du hast den Griff doch schon. Jetzt musst Du an der Saege ziehen.\n");
					return 1;
				}
			if(TP==linkergreifer)
				{
					write("Du hast schon den linken Griff.\n");
					return 1;
				}
			if(TP->QueryProp(P_NOMOVE))
				{
					write(TP->QueryProp(P_NOMOVE));
					return 1;
				}
	    if(!present("\nsaegeangedrueckt",TO))
	    	{
	    		write("Dafuer musst Du erst die Saege in den Baumstamm druecken.\n");
			    return 1;
		     }			
			if(rechtergreifer)
				{
					write(rechtergreifer->name()+" hat den rechten Griff schon. Nimm doch den linken.\n");
					return 1;
				}			
			rechtergreifer=TP;
	    rechtergreifer->SetProp(P_NOMOVE,"Du musst erst den Griff der Saege loslassen.\n");
			write("Du ergreifst den rechten Griff der Saege. Nun kannst Du ziehen um den Baumstamm durch zu saegen.\n");
			say(TPN+" ergreift den rechten Griff der Saege.\n");
			return 1;
		}				
	return 0;
	}
   


saegeziehen(string str)
{
	notify_fail("Was moechtest Du ziehen?\n");
	if(str!="saege"&&str!="an saege")return 0;
	
	if(TP==rechtergreifer)
		{
			if(letzterzug!="rechts")//weil entweder noch nicht gezogen wurde oder der linke als letzter zog
				{
					write("Du ziehst an der Saege, sie graebt sich ein bisschen tiefer in den Baumstamm.\n");
					say(TPN+" zieht an der Saege, sie graebt sich ein bisschen tiefer in den Baumstamm.\n",TP);
					letzterzug="rechts";
					saegestatus--;
					if(saegestatus<1)baumfaellt();
					return 1;
				}
			else
				{
					write("Es muss erst an der linken Seite gezogen werden, damit weiter gesaegt werden kann.\n");
					say(TPN+" zerrt umsonst an der Saege herum. Vielleicht solltest Du an der linken Seite ziehen?\n",TP);
					return 1;
				}
			}
	if(TP==linkergreifer)
		{
			if(letzterzug!="links")//weil entweder noch nicht gezogen wurde oder der rechte als letzter zog
				{
					write("Du ziehst an der Saege, sie graebt sich ein bisschen tiefer in den Baumstamm.\n");
					say(TPN+" zieht an der Saege, sie graebt sich ein bisschen tiefer in den Baumstamm.\n",TP);
					letzterzug="links";
					saegestatus--;
					if(saegestatus<1)baumfaellt();
					return 1;
				}
			else
				{
					write("Es muss erst an der rechten Seite gezogen werden, damit weiter gesaegt werden kann.\n");
					say(TPN+" zerrt umsonst an der Saege herum. Vielleicht solltest Du an der rechten Seite ziehen?\n",TP);
					return 1;
				}
			}
	if(!present("\nsaegeangedrueckt",TO))//Wenn gar keine Saege da ist
		{
			write("Du musst natuerlich erst eine Saege in den Baum druecken.\n");
			return 1;
		}
	write("Du musst erst den Griff der Saege ergreifen.\n");
	return 1;	



}
