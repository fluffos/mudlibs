// Hier verlaesst man den Berg


#include "../def.h"
inherit "std/room";
#include <properties.h>
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.

object rechtergreifer;
object linkergreifer;
string letzterzug;//in welche Richtung wurde die Saege als letztes gezogen?
int saegestatus;
void anfangszustand()
{
	if (present("\nsaege",TO))present("\nsaege",TO)->remove();
	RemoveExit("baumstamm");
  rechtergreifer=0;
  linkergreifer=0;
  letzterzug=0;
  saegestatus=2;
  AddDetail( ({ "baum" }),
    "Der Baum hat es geschafft seine Wurzeln in den harten Fels zu treiben. Gesund sieht "
    "er allerdings nicht aus, er hat wenige Blaetter und sein Stamm ist grau und vertrocknet.");
 AddDetail( ({ "wurzeln" }),
    "Die Wurzeln des Baumes haben es geschafft sich in den harten Fels zu graben. Sie halten "
    "den Baum an der Felswand fest.");
 AddDetail( ({ "stamm", "baumstamm" }),
    "Der Baumstamm ist trocken und morsch. Man koennte ihn mit Leichtigkeit durchsaegen.");

}



void init()
{
  ::init();
}
      
          

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung" );
  rechtergreifer=0;
  linkergreifer=0;
  letzterzug=0; 
  saegestatus=20;
  SetProp( P_INT_LONG,
    "Du stehst auf einem Felsvorsprung in einer Bergkluft. Vor Dir liegt ein tiefer Abgrund, hinter "
