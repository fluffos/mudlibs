
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas Lehm");
  SetProp(P_LONG,
    "Du siehst ein bisschen hellbraunen Lehm. Ob das zu was zu gebrauchen ist?" );

  SetProp(P_NAME, "Lehm");
  SetProp(P_GENDER, MALE);
  AddId(({"lehm"}));

  SetProp(P_MATERIAL, MAT_EARTH );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);
 
}
