#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Paddel");
  SetProp(P_LONG,
    "Du siehst ein hoelzernes Paddel." );
  SetProp(P_NAME, "Paddel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"paddel","\npaddel","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
 
}


	