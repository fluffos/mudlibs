//Nur der Eingangsraum

#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();
  CLONE("/obj/fackel.lpc", TO);
  CLONE("/obj/fackel.lpc", TO);  
  SetProp( P_INT_SHORT, "In einem finsteren Gang" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier am Ende eines finsteren Ganges. Hinter Dir ist eine verschlossene "
    "Tuer, vor Dir fuert der Gang nach Nordosten, doch was dort ist kannst Du nicht erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Du stehst hier am Ende eines finsteren Ganges. Hinter Dir ist eine verschlossene "
    "Tuer, vor Dir fuehrt der Gang nach Nordosten, doch was dort ist kannst Du nicht erkennen." );

  AddDetail( ({ "tuer" }),
    "Durch diese Tuer bist Du gekommen. Erschreckt stellst Du fest, dass man sie von dieser "
    "Seite aus nicht oeffnen kann.");
  AddDetail( ({ "gang" }),
    "Du stehst am Ende des Ganges. Von hier aus kannst Du nur nach Nordosten ins Ungewisse "
    "laufen.");
  AddDetail( ({ "ende" }),
    "Du stehst am Ende des Ganges, hier geht es nur in eine Richtung weiter.");
  AddDetail( ({ "richtung" }),
    "Du kannst hier nur nach Nordosten gehen.");
  AddDetail( ({ "nordosten" }),
    "Dorthin fuehrt Dich der Gang, wenn Du Dich traust.");
  AddDetail( ({ "seite" }),
    "Tja, Du stehst wohl auf der falschen Seite der Tuer, falls Du raus moechtest.");
  AddDetail( ({ "ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich im Nordosten erwartet.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Allerdings ist er nicht natuerlich entstanden, denn "
    "Du kannst deutlich die Bearbeitungsspuren sehen.");
  AddDetail( ({ "waende" }),
    "Die Waende sind sehr dicht beieinander, fast kannst Du beide gleichzeitig beruehren.");
  AddDetail( ({ "decke" }),
    "Die niedrige Decke ist nur knapp ueber Dir. Hoffentlich haelt sie.");
  AddDetail( ({ "wand" }),
    "Es gibt drei Waende, die Dir bedrohlich nah sind. In einer Wand befindet sich eine Tuer.");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Jemand hat diesen Gang muehsehlig in den Fels geschlagen, er ist nicht natuerlich entstanden.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, kalt und ein wenig feucht.");
  AddDetail( ({ "gefuehl" }),
    "Kannst Du Deinen Gefuehlen trauen?");
  AddDetail( ({ "klinge" }),
    "Die fehlt.");
  AddDetail( ({ "angeln" }),
    "Da Du keine siehst gehst Du davon aus, dass diese auf der anderen Seite liegen muessen. "
    "Vielleicht sind sie aber auch im Fels verborgen. Jedenfalls bringt Dich das nicht weiter.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Wahrlich, es riecht nicht angenehm..");

  AddRoomMessage( 
    ({"Irgendwie fuehlst Du Dich leicht unwohl.\n",
    	"Du hast das Gefuehl, dass die Waende naeher ruecken.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Irgendwo tropft etwas.\n"}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille. Ganz, ganz selten hoerst Du ein leises tropfen.");

  AddSound( ({ "tropfen" }),
    "Wo das wohl herkommen mag?");
  AddSound( ({ "totenstille","stille" }),
    "Dir ist unwohl zumute. Irgendetwas stimmt hier nicht.");


  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_4i.lpc");

  AddCmd(({"oeffne"}),"oeffnen"); //Kann man nicht
  AddCmd(({"lehne","lehn"}),"lehnen"); //

}

int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if(str!="tuer") return 0;
  write("Du siehst keine Klinke und keine Angeln, Du hast also keine Chance sie zu oeffnen.\n"+
  "Du wirst wohl oder uebel weiter gehen muessen.\n");
  say(TPN+" sucht eine Moeglichkeit die Tuer zu oeffnen.\n");
  return 1;
}


	
int lehnen (string str)
{
	if(str!="gegen tuer") return 0;
  write("Das bringt nichts, die geht nach Innen auf. Du kommst hier nicht zurueck.\n");
  return 1;

}
			


	
