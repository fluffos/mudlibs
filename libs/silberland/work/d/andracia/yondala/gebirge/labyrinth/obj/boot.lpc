#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Boot");
  SetProp(P_LONG,
    "Ein kleines Boot ist hier festgemacht und mit einem stabilen Schloss gesichert. "
    "Man kann sicherlich reinklettern und damit davon fahren." );
 AddDetail( ({ "schloss" }),
    "Du brauchst vermutlich einen Schluessel um es aufzuschliessen.");
 AddDetail( ({ "schluessel" }),
    "Wo Du den wohl herkriegst?");
 AddDetail( ({ "" }),
    "");
  SetProp(P_NAME, "Boot");
  SetProp(P_GENDER, MALE);
  AddId(({"boot"}));
  SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Das Boot ist viel zu schwer.\n");
  AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern
  AddCmd( ({ "schliesse","schliess", "sperre","sperr"}), "aufschliessen" ); 

}

int klettern(string str)
{
	notify_fail("Worein moechtest Du klettern?\n");
	if(str!="in boot"&&str!="in boot hinein"&&str!="in boot rein"&&str!="rein")return 0;
	write("Du solltest erst das Schloss aufschliessen, sonst kannst Du mit dem Boot nicht fahren.\n");
	return 1;
}

int aufschliessen(string str)
{
	notify_fail("Was moechtest Du aufschliessen?\n");
	if(str!="schloss auf")return 0;
	if(!present("\nbootschluessel",TP))
		{
			write("Du hast nicht den richtigen Schluessel dabei.\n");
			return 1;
		}
	write("Du schliesst das Schloss am Boot auf.\n");
	say(TPN+" schliesst das Schloss am Boot auf.\n",TP);
	present("\nbootschluessel",TP)->remove();
	CLONE(LABY_OBJ+"bootaufgeschlossen.lpc",environment(TO));
	remove();
	return 1;
}

	
	