  SetProp(P_MSGIN, "kriecht herein"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "kriecht");//verlassen wird
  SetProp(P_MMSGIN, "springt kreischend herein");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "jagt kreischend davon");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " krepiert.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Hopkigo");//name des tötenden npc
//  SetProp(P_KILL_MSG, "Das hab ich nicht erwartet...");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
    
  AddInfo(DEFAULT_INFO, "kreischt wuetend\n");//Wenn der LABY_NPC keine Antwort hat

  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
        


  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");

    SetProp(P_SPELLRATE,50);
/*  AddSpell(1,0,
