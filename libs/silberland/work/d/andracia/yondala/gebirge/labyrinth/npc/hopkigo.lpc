     DT_FIRE,([SP_SHOW_DAMAGE:1]));*/

	AddSpell(5,100,
	         "Der Hopkigo kreischt Dich wild an.\n",
	         "Der Hopgiko kreischt @WEN wild an.\n",
	         ({DT_FIRE,DT_SOUND}), ([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1, 100, DS_MASS_BLIND, "Die Augen des Hopkigo leuchten kurz auf\n", "Die Augen des Hopkigo leuchten kurz auf\n");
 
  AddDefaultSpell(1, 50, DS_MASS_DEAF, "Der Hopkigo kreischt wild.\n");
