void verschwinden()
{
	if(!InFight()&&!QueryEnemies())
		{
			call_other(LABY_ROOM+"hoehlenlabyrinth_14h","anfangszustand");
			tell_room(environment(TO), "Der Hopkigo geht sich ausruhen.\n");
			remove();
			//move zu /players/yondala/room/muellhalde
		}
	else   call_out("verschwinden",300);
}
	
void lauf()
{
	string *ausgang; 
	ausgang = m_indices (environment(TO)-> QueryProp(P_EXITS));
	command(ausgang[random(sizeof(ausgang))]);
		
}
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  call_out("verschwinden",300);
  call_out("lauf",20);
  SetProp(P_SHORT, "Ein Hopkigo");
  SetProp(P_LONG,
    "Ein schauriges Wesen steht vor Dir. Es hat eine glatte, silbrig schimmernde Haut, ein "
    "flaches Gesicht, mit riesigen, vorstehenden Augen, die Dich genau beobachten. Dazwischen "
    "eine winzige Nase und darunter ein breiter, lippenloser Mund mit unzaehligen spitzen Zaehnen. "
    "Die riesigen, fledermausartigen Ohren zucken bei jedem noch so kleinen Geraeusch. Der riesige "
    "Kopf sitzt ohne Hals auf einem vergleichsweise schmaechtig wirkenden Koerper. Die lange Arme reichen "
    "fast bist zum Boden, die duerren Finger enden in langen, spitzen Krallen.");

  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");


  SetProp(P_NAME, "Hopkigo");
  SetProp(P_GENDER, MALE);
  AddId(({"hopkigo","goblin"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Goblin");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 30000);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  //SetProp(P_NOATTACK, "kann noch nicht angegriffen werden.");

SetProp (P_MNPC_DEFAULTROOM, LABY_ROOM+"hoehlenlabyrinth_14h.lpc");
SetProp (P_MNPC_AREA, LABY_ROOM );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({1, 10, 5}));
 
  /*
