

#include "../def.h"
inherit "std/room";
#include <properties.h>
int seilda;
int wandunten;//bei 1 ist sie unten.
object angebundener;
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	  AddDetail( ({ "etwas" }),
      "Sieht aus wie eine Seilwinde.");
    AddDetail( ({ "winde","seilwinde" }),
      "Man koennte sicherlich ein Seil darueber werfen, wenn man denn etwas oder jemanden nach oben ziehen moechte.");
		RemoveDetail("seil");
  AddDetail( ({ "holzwand" }),
    "Die Holzwand sieht sehr stabil aus. Ausserdem ist sie rechts und links in die Felswaende "
    "eingelassen, man kann sie also nicht aufschwenken. Allerdings ist ueber der Holzwand noch "
    "ein Hohlraum und eine Art Griff zu erkennen.");
    RemoveCmd("durchducken");
    RemoveDetail("spalt");
  AddDetail( ({ "art" }),
    "Es sieht so aus wie ein Griff.");
  AddDetail( ({ "griff" }),
    "An diesem Griff kann man die Holzwand vermutlich nach oben ziehen. Wenn man denn dran kommt.");
	  AddDetail( ({ "boden" }),
    "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
    "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen. "
    "Direkt vor Dir siehst Du die Oberkante der Holzwand.");

seilda=0;
angebundener=0;
wandunten=1;
}

//wird von hoehlenlabyrinth_9l_o aufgerufen, wenn dort jemand die Wand hochzieht.
void wandhoch()
{
	tell_room(TO,"Die Holzwand wird ein Stueck hochgezogen.\nMan kann sich nun vermutlich drunter durch ducken.\n");
  AddDetail( ({ "holzwand" }),
    "Die Holzwand sieht sehr stabil aus. Ausserdem ist sie rechts und links in die Felswaende "
    "eingelassen, man kann sie also nicht aufschwenken. Allerdings ist unter der Holzwand ein "
    "kleiner Spalt frei, Du koenntest Dich unter der Wand durchducken.");
  AddDetail( ({ "spalt" }),
    "Der Spalt ist entstanden, weil jemand die Holzwand hochgezogen hat. Wenn Du sie wieder "
    "herunter drueckst, verschwindet er wieder.");
  AddDetail( ({ "boden" }),
    "Der Boden ist feucht und offensichtlich mit einer Art schleimigen Mooses bewachsen, was "
    "ihn sehr schluepfrig macht. Gut, dass Du eh schon kriechst, so kannst Du nicht hinfallen.");
	
  RemoveDetail(({"griff","art"}));
  AddCmd( ({ "ducke", "duck"}), "durchducken" ); //wenn die Holzwand hochgezogen wurde kann man sich drunter durchducken.
	wandunten=0;
}


