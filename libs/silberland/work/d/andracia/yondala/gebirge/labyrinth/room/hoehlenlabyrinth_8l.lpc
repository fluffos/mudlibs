int durchducken(string str)
{
	notify_fail("Wodrunter moechtest Du Dich durchducken?\n");
	if(str!="unter wand durch"&&str!="unter holzwand durch") return 0;
  this_player()->move(LABY_ROOM+"hoehlenlabyrinth_9l", M_GO, 0,
                  "duckt sich unter der Wand durch", "kommt geduckt herein");
  return 1;
  }
int aufschwenken(string str)
{
	notify_fail("Was moechtest Du aufschwenken?\n");
	if(str!="holzwand auf"&&str!="wand auf") return 0;
	write ("Das ist voellig unmoeglich, da die Wand fest in den Fels gebaut wurde.\n");
  return 1;
  }
int zwaengen(string str)
{
	notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
	if(str!="durch hohlraum"&&str!="in hohlraum") return 0;
	write ("Das ist voellig unmoeglich, da Du nicht dort bist.\n");
  return 1;
  }
int runterdruecken(string str)
{
	notify_fail("Was moechtest Du herunterdruecken?\n");
	if(str!="wand"&&str!="wand herunter"&&str!="holzwand"&&str!="holzwand herunter")return 0;
	if (wandunten)
		{
			write("Die Wand ist doch schon unten.\n");
			return 1;
		}
	 write("Du drueckst die Wand nach unten, der Spalt verschwindet.\n");
	 say(TPN+" drueckt die Wand nach unten, der Spalt verschwindet.\n");
	 wandunten=1;
  AddDetail( ({ "holzwand" }),
    "Die Holzwand sieht sehr stabil aus. Ausserdem ist sie rechts und links in die Felswaende "
    "eingelassen, man kann sie also nicht aufschwenken. Allerdings ist ueber der Holzwand noch "
    "ein Hohlraum und eine Art Griff zu erkennen.");
    RemoveCmd("durchducken");
    RemoveDetail("spalt");
  AddDetail( ({ "art" }),
    "Es sieht so aus wie ein Griff.");
  AddDetail( ({ "griff" }),
    "An diesem Griff kann man die Holzwand vermutlich nach oben ziehen. Wenn man denn dran kommt.");
	call_other(LABY_ROOM+"hoehlenlabyrinth_9l_o","wandrunter");
	 return 1;
	}
	 
	




int hochziehen(string str)
{
	string opfer, dummy;
	notify_fail("Wen oder was moechtest Du hochziehen?\n");
	if(!str)return 0;	
	
	if(str=="wand hoch"||str=="holzwand hoch"||str=="wand rauf"||str=="holzwand rauf")
	{
		write("Das geht von hier aus nicht. Forsche weiter!\n");
		return 1;
	}
	if(str=="seil"||str=="an seil"||str=="seil hoch"||str=="seil nach oben")
		{
			if (seilda)
				{
					if(angebundener) 
					{
						write("Moechtest Du vielleicht "+angebundener->name()+" hochziehen?\n");
						return 1;
					}
					
					CLONE("/obj/seil.lpc", TP);
					write("Du ziehst das Seil herunter.\n");
					say("Zieht das Seil herunter.\n");
					seilda=0;
					AddDetail( ({ "etwas" }),
						"Sieht aus wie eine Seilwinde.");
					AddDetail( ({ "winde","seilwinde" }),
						"Man koennte sicherlich ein Seil darueber werfen, wenn man denn etwas oder jemanden nach oben ziehen moechte.");
					RemoveDetail("seil");
					return 1;
				}
			write("Es ist kein Seil da, Du muesstest erst eines ueber die Seilwinde werfen.\n");
			return 1;
		}
			
				
						
				
						
						
						
	//notify_fail("Wen moechtest Du hochziehen?\n");


	if(sscanf(str,"%s hoch%s",opfer, dummy)!=2&&
		 sscanf(str,"%s nach oben%s",opfer, dummy)!=2) return 0;
	/*	 {
			 write("sscanf funktioniert nicht.\n");
			
		 }*/
	if(!angebundener)
		{
			write("Du kannst nur jemanden hochziehen, der an das Seil gebunden ist.\n");
			return 1;
		}
	if(opfer!=lowerstring(angebundener->name()))
		{
			write("Du kannst nur jemanden hochziehen, der an das Seil gebunden ist.\n");
			return 1;
		}
	if(TP==angebundener)
		{
			write("Leider schaffst Du es nicht, Dich selbst hochzuziehen.\n");
			return 1;
		}
		
	 if(TP->QueryProp(P_WEIGHT)>angebundener->QueryProp(P_WEIGHT))
	 	{
	 		write("Du ziehst "+angebundener->name(WEN)+" mit aller Kraft nach oben.\n");
	 		tell_object(angebundener, TPN+" zieht Dich nach oben.\n");
			angebundener->SetProp(P_NOMOVE,0);

	 		angebundener->move(LABY_ROOM+"hoehlenlabyrinth_9l_o", M_GO, 0,
                   "loest sich von dem Seil und klettert in die Aushoehlung", "kommt von unten hochgeklettert");
	 		tell_object(angebundener, "Du loest Dich von dem Seil und kletterst in die Aushoehlung.\n");
				  CLONE("/obj/seil.lpc", TO);
			tell_room(TO,"Das Seil faellt herunter.\n");
			angebundener=0;
			return 1;
		}
	 else //angebundener ist schwerer als Zieher
	 {
		 write(angebundener->name()+" ist zu schwer fuer Dich, vielleicht solltet Ihr es anders herum versuchen.\n");
		 tell_object(angebundener, TPN+" schafft es nicht, Dich hoch zu ziehen.\n");
		 return 1;
	 }
			
		
		
}
			


int entfernen(string str)
{
	notify_fail("Was moechtest Du entfernen?\n");
	if(str!="seil")return 0;
	
	if (!angebundener)
		{
			write("Es ist niemand an ein Seil gebunden.\n");
			return 1;
		}
	
	if(angebundener==TP)
		{
			write("Du entfernst das Seil von Dir.\n");
			say(TPN+" entfernt das Seil von sich.\n",TP);
		}
	else
		{
			write("Du entfernst das Seil von "+angebundener->name()+".\n");
			say(TPN+" entfernt das Seil von Dir.\n",TP);
		}
	angebundener->SetProp(P_NOMOVE,0);
	angebundener=0;
	return 1;
			
}

int binden(string str)
{
	string opfer, dummy;
	notify_fail("Wen moechtest Du woran binden?\n");
	if(!str)return 0;
	if(sscanf(str,"%s an seil%s",opfer, dummy)!=2&&
		 sscanf(str,"%s an seil fest%s",opfer, dummy)!=2)return 0;

  if(angebundener)
  	{
  		write("Aber "+angebundener->name()+" ist doch schon an dem Seil festgebunden. Du musst es erst entfernen.\n");
  		return 1;
  	}
  		
	if(opfer=="mich")
		{
	    angebundener=TP;
			write("Du bindest Dich an das Seil.\n");
			say(TPN+" bindet sich an das Seil.\n",TP);
			TP->SetProp(P_NOMOVE, "Du muesstest erst das Seil entfernen.\n");
			return 1;
		}
		
	
	if(!present(opfer,TO))
		{
			write("So jemand/etwas siehst Du hier nicht.\n");
			return 1;
		}
	if(!living(present(opfer,TO)))
		{
			write("Es macht wohl mehr Sinn, etwas lebendiges nach oben zu ziehen.\n");
			return 1;
		}
	angebundener=present(opfer,TO);
	if (angebundener==TP)
		{
			write("Du bindest Dich an das Seil.\n");
			say(TPN+" bindet sich an das Seil.\n",TP);
			TP->SetProp(P_NOMOVE, "Du muesstest erst das Seil entfernen.\n");
			return 1;
		}
			
			write("Du bindest "+angebundener->name(WEN)+" an das Seil.\n");
			tell_object(angebundener,TPN+" bindet Dich an das Seil.\n");
			angebundener->SetProp(P_NOMOVE, "Du muesstest erst das Seil entfernen.\n");
			return 1;
		}
			
	


int werfen(string str)
{
	int zufall;
	notify_fail("Was moechtest Du worueber werfen?\n");
	if(str!="seil ueber winde"&&str!="seil ueber seilwinde")return 0;
	if(!present("seil",TP))
		{
			write("Du hast kein Seil.\n");
			return 1;
		}
	if (seilda==1)
		{
			write("An der Seilwinde haengt doch schon ein Seil.\n");
			return 1;
		}
	zufall=41-TP->QueryProp(A_DEX);//je geschickter, desto wahrscheinlicher trifft er	
	if (zufall>1) zufall=3;
	if(random(zufall)==0)
		{
			write("Du nimmst Schwung und mit all Deinem Geschick wirfst Du das Seil ueber die Seilwinde.\n");
			say(TPN+" wirft ein Seil ueber die Seilwinde an der Decke.\n",TP);
			present("seil",TP)->remove();
      AddDetail( ({ "etwas" }),
        "Sieht aus wie eine Seilwinde. Ein Seil haengt daran.");
      AddDetail( ({ "winde","seilwinde" }),
        "Ein Seil haengt an dieser Seilwinde. Man koennte sicherlich jemanden damit nach oben ziehen.");
      AddDetail( ({ "seil" }),
        "An diesem Seil kann man sicher jemanden nach oben ziehen.");
      seilda=1;		

		}
	else
		{
			write("Leider warst Du zu ungeschickt, Du verfehlst die Seilwinde und das Seil faellt zu Boden.\n"+
			"Versuche es weiter!\n");
			say(TPN+" wirft ein Seil hoch.\n",TP);
			present("seil",TP)->move(TO, M_GET);
	
		}
	return 1;
}


int machen(string str)
{
	notify_fail("Was moechtest Du machen?\n");
	if(str=="raeuberleiter")
		{
			if(TP->QueryProp(P_NOMOVE)!="Du musst erst die Raeuberleiter loesen.\n")
				{
					write("Du faltest Deine Haende und bildest damit eine Raeuberleiter.\n");
					say(TPN+" faltet "+TP->QueryPossPronoun(FEMALE, WEN,PLURAL)+" Haende zu einer Raeuberleiter\n",TP);
					TP->SetProp(P_NOMOVE,"Du musst erst die Raeuberleiter loesen.\n");
					return 1;
				}
			//wenn er also schon Raeuberleiter macht
			write("Du machst doch schon eine Raeuberleiter.\n");
			return 1;
		}
	}


int loesen (string str)
{
	notify_fail("Was moechtest Du loesen?\n");
	if(str=="raeuberleiter"||str=="haende"||str=="leiter")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst die Raeuberleiter loesen.\n")
				{
					write("Du loest Deine Haende aus der Raeuberleiter.\n");
					say(TPN+" loest "+TP->QueryPossPronoun(FEMALE, WEN,PLURAL)+" aus der Raeuberleiter\n",TP);
					TP->SetProp(P_NOMOVE,0);
					return 1;
				}
			//wenn er grad keine Raeuberleiter macht
			write("Du machst doch gar keine Raeuberleiter.\n");
			return 1;
		}
	}
	
int aufstehen(string str)
{
	object anderer;
	notify_fail("Moechtest Du vielleicht aufstehen?\n");
	if (str=="auf"||!str)
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst aufstehen.\n")
				{
					//write("Du stehst auf.\n");
					TP->SetProp(P_NOMOVE,0);
					anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
					anderer->SetProp(P_PARALYZED,0);
					//tell_object(anderer,TPN+" steht von Dir auf.\nEndlich kriegst Du wieder Luft.\n");
					return 1;
				}
			write("Du stehst doch.\n");
			return 1;
		}
		return 0;
	}
					
					
					
int klettern(string str)
{
	object anderer;
	notify_fail("Wo moechtest Du denn hinklettern?\n");
	if(str!="rauf"&&str!="hinauf"&&str!="hoch"&&str!="nach oben"&&str!="zum gang"&&
		str!="raeuberleiter hinauf"&&str!="raeuberleiter rauf"&&str!="raeuberleiter hoch") return 0;
	
	if(TP->QueryProp(P_NOMOVE))
		{
			write(TP->QueryProp(P_NOMOVE));
			return 1;
		}
	else if(present("holzleiter",TP))//wenn der Spieler die leiter im inv hat
		{
				present("holzleiter",TP)->move(TO, M_GET);
				write("Du stellst die Holzleiter auf den Boden und kletterst daran nach oben.\n"+
				"Leider ist die Leiter nicht hoch genug. Enttaeusch kletterst Du nach unten.\n");
	      
       return 1;
      }
 
			
			
	//Idee: Gar nicht mit variable, sondern einfach abfragen, ob eine im Raum ist
	else if(present("leiter", TO))//falls eine Leiter von oben runtergelassen wurde
		{
			write("Du kletterst ueber die Leiter nach oben\n"+
							"Leider ist die Leiter nicht hoch genug. Enttaeuscht kletterst Du nach unten.\n");
			say(TPN+" versucht nach oben zu klettern, was aber an der Kuerze der Leiter scheitert.\n",TP);
      return 1;
    }

//wenn es schon einen anderen mitspieler gibt
else if(present("\nlabyrinthquestitem",TP)->mitteilen())
	{
		
	//Aus dem Questitem des Spielers den anderen Spieler holen
	anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
	//gucken ob der andere gerade eine Raeuberleiter macht.
	if(anderer->QueryProp(P_NOMOVE)!="Du musst erst die Raeuberleiter loesen.\n")
		{
			write("Das geht nicht so ohne weiteres. Du brauchst eine gute Idee um hier weiter zu kommen.\n");
			return 1;
		}
	
	//der Spieler kann also laufen, der andere macht eine Raeuberleiter
	//wenn der kletternde Spieler schwerer ist als der, der unten steht
	//fallen die beiden um
	if(TP->QueryProp(P_WEIGHT)>anderer->QueryProp(P_WEIGHT))
		{
			write("Du versuchst an "+anderer->name()+" hochzuklettern.\n"+
			"Du bist zu schwer, "+anderer->name()+" kann Dich nicht halten.\nDu purzelst nach unten.\n");
	    tell_object(anderer, TPN+" versucht an Dir hoch zu klettern, aber Du kannst "+
	    TP->QueryPronoun(WEN)+" nicht halten.\nDu faellst um und "+TPN+" landet auf Dir.\n");
			TP->AddHp(-10);
			anderer->AddHp(-20);
      anderer->SetProp(P_NOMOVE,0);
      TP->SetProp(P_NOMOVE,"Du musst erst aufstehen.\n");
      anderer->SetProp(P_PARALYZED, ([
         PARALYZE_TIME: (-1),
         PARALYZE_MSG: TPN+ " sitzt auf Dir und muss erst aufstehen.\n",
         PARALYZE_MSG_OTHER: "%s versucht, sich zu bewegen, liegt aber unter Dir begraben.\n",
         PARALYZE_END: TPN+" steht von Dir auf.\nEndlich kriegst Du wieder Luft.\n",
         PARALYZE_END_OTHER: "Du stehst auf.\n"]));
       return 1;
        }

	    
			
	write("Du kletterst ueber die Raeuberleiter von "+anderer->name()+" nach oben.\n"
	"Leider kannst Du den Hohlraum nicht erreichen. Enttaeuscht kletterst Du wieder nach unten.\n");
	tell_object(anderer, TPN+" klettert ueber Deine Raeuberleiter nach oben, kann dort aber nichts "
	"ausrichten und klettert enttaeuscht wieder nach unten.\n");

	tell_object(anderer, "Du loest Deine Haende.\n");
  anderer->SetProp(P_NOMOVE,0);

  return 1;
}
			write("Das geht nicht so ohne weiteres. Du brauchst eine gute Idee um hier weiter zu kommen.\n");
return 1;
}


	
