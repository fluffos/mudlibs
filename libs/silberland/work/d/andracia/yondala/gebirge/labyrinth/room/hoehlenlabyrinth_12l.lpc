// Hier muss der schwerere Spieler den Stoepsel aus der Decke drehen

#include "../def.h"
inherit "std/room";
#include <properties.h>

int lehner;
int stoepselda;//ist der Stoepsel noch in der Decke? 1=ja;
int steinda;
object anderer;

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	steinda=1+random(5);
  lehner=0;
  stoepselda=1;
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Am Ende eines Ganges" );
	steinda=1+random(5);
    stoepselda=1;
  SetProp( P_INT_LONG,
    "Du stehst am Ende eines breiten, hellen Gangs. Obwohl die Waende recht dunkel sind, scheinen "
    "sie leicht zu leuchten, ausserdem sind sie immer wieder von feinen Aederchen unterbrochen. "
    "Hier und da siehst Du es besonders hell aufblitzen. Suedlich von Dir befindet sich eine Tuer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang hier ist etwas breiter als die vorherigen Gaenge und auch nicht so dunkel.");
  AddDetail( ({ "gaenge" }),
    "Die Gaenge, durch die Du Dich vorher beinahe hast quetschen muessen liegen hinter Dir.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind, wenn auch nicht schwarz, doch relativ dunkel. Dennoch geben sie ein "
    "schwaches Leuchten ab, so dass Du ohne extra Lichtquelle genug erkennen kannst. Hin und "
    "wieder ist das dunkle Gestein von feinen Aederchen durchzogen.");
  AddDetail( ({ "leuchten" }),
    "Das Leuchten ist sicher magischen Ursprungs, eine andere Erklaerung hast Du dafuer nicht.");
  AddDetail( ({ "ursprung" }),
    "Der Ursprung muss magisch sein, warum sonst sollte Gestein leuchten?");
  AddDetail( ({ "erklaerung" }),
    "Dir faellt keine bessere ein. Ausserdem bist Du mit dieser ganz zufrieden. Magie ist "
    "schliesslich was relativ normales in Andracia.");
  AddDetail( ({ "magie" }),
    "Fast jeder Bewohner Andracias kann Magie wirken.");
  AddDetail( ({ "bewohner" }),
    "Du bist bestimmt schon den ein oder anderem begegnet.");
  AddDetail( ({ "andracia" }),
    "So heisst dieser Kontinent.");
  AddDetail( ({ "kontinent" }),
    "Du befindet Dich in und auf Andracia.");
  AddDetail( ({ "lichtquelle" }),
    "Du benoetigst keine, es ist hell genug.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist recht dunkel, trotzdem leuchtet es leicht. Du kannst nicht sagen, woraus es besteht.");
  AddDetail( ({ "aederchen" }),
    "Die Aederchen scheinen aus Silber zu bestehen.");
  AddDetail( ({ "silber" }),
    "Feine Silberadern durchziehen das Gestein. Schade, dass Du nichts dabei hast um es abzubauen.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus dem selben Gestein wie die Waende. Sie ist recht hoch und gewoelbt, "
    "sodass sie nahtlos in die Waende uebergeht. Du siehst eine grosse, schwarze Scheibe an der "
    "Decke.");
  AddDetail( ({ "blitzen","funkeln" }),
    "Hin und wieder siehst Du kleine Edelsteine in dem Gestein stecken.");
  AddDetail( ({ "edelsteine" }),
    "Ob man vielleicht welche herausbrechen kann?");
  AddDetail( ({ "silberadern","adern" }),
    "Das Silber zieht sich in feinen Adern durch das Gestein.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit einer duennen Sandschicht bedeckt.");
  AddDetail( ({ "sandschicht","schicht", "sand" }),
    "Der Sand ist sehr fein und er glitzert. Fast so, als waere es Edelsteinstaub.");
  AddDetail( ({ "edelsteinstaub","staub" }),
    "Schade, dass Du ihn nicht mitnehmen kannst, er ist bestimmt sehr wertvoll, aber er rieselt "
    "Dir immer wieder durch die Finger, so fein ist er. Du kannst einige Spuren erkennen.");
  AddDetail( ({ "spuren" }),
    "Hier ist offenbar jemand hergelaufen. Leider weisst Du nicht, wie lange das her ist.");
  AddDetail( ({ "finger" }),
    "Ein bisschen Edelsteinstaub klebt nun an ihnen.");
  AddDetail( ({ "scheibe" }),
    "Hm, nicht bloss eine Scheibe, es scheint so etwas wie ein Stoepsel zu sein.");
  AddDetail( ({ "stoepsel" }),
    "Was wohl passiert, wenn man ihn rausdreht?");
  AddDetail( ({ "tuer" }),
    "Die Tuer sieht recht stabil aus. Ob man sie oeffnen kann?");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Stein.");
  AddSmell( ({ "stein" }),
    "Keine Ahnung, wie Stein riecht.");
  AddSmell( ({ "ahnung" }),
    "Sag Du es mir!");

  AddRoomMessage( 
    ({"Etwas blinkt vor Dir auf.\n",
    	"Was funkelt denn da?\n"}),60,"func");

  AddSound( DEFAULT_SOUND,
    "Es ist hier recht still.");

  AddSound( ({ "stille" }),
    "Du hoerst nichts.");


  AddExit("nordwesten", LABY_ROOM+"hoehlenlabyrinth_11k.lpc");

  AddCmd(({"brich","breche","brech"}),"rausbrechen"); //Edelsteine herausbrechen.
  AddCmd(({"oeffne"}),"oeffnen"); //Kann man nicht
  AddCmd(({"lehne","lehn"}),"lehnen"); //
  AddCmd(({"richte","richt"}),"aufrichten"); //
  AddCmd(({"dreh","drehe"}),"rausdrehen"); //den Stoepsel aus der Decke drehen

}

int oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str!="tuer") return 0;
  write("Du zerrst und ruettelst an der Tuer, bekommst sie aber nicht auf.\n"
        "Ob es hilft, wenn Du Dich dagegen lehnst?\n");
  say(TPN+" zerrt und ruettelt an der Tuer.\n");
  return 1;
}
int aufrichten(string str)
{
  notify_fail("Moechtest Du Dich vielleicht aufrichten?\n");
  if(str!="auf")return 0;
    
  if(TP->QueryProp(P_NOMOVE)!="Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n") 
    {
      write("Du lehnst doch gar nicht an der Tuer.\n");
      return 1;
    }
  TP->SetProp(P_NOMOVE,0);
  write("Du richtest Dich wieder auf.\n");
  say(TPN+" richtet sich wieder auf.\n",TP);
  lehner--;
  return 1;
}
int rausbrechen(string str)
{
	notify_fail("Was moechtest Du herausbrechen?\n");
	if(str=="edelsteine raus"||str=="edelsteine heraus")
		{
			write("Nana, sollte einer nicht genuegen?\n");
			return 1;
		}
	if(str=="edelstein raus"||str=="edelstein heraus"||str=="edelstein aus wand raus"||str=="edelstein aus wand heraus"
		||str=="edelstein aus wand")
		{
			if(steinda)
				{
					write("Mit grosser Muehe gelingt es Dir, einen Edelstein aus der Wand zu brechen.\n");
					say(TPN+" bricht einen Edelstein aus der Wand.\n",TP);
					"/obj/gemmaster"->DistributeGem(1, 0, 1, TP);
					steinda--;
				}
			else
				write("Leider schaffst Du es nicht einen Stein herauszubrechen, sie sitzen alle zu fest.\n");
			return 1;
		}
		return 0;
	}			




  
int lehnen (string str)
{
  object anderer;
  anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
  notify_fail("Wo moechtest Du Dich gegen lehnen?\n");
  if (str!="gegen tuer") return 0;
  
  if(TP->QueryProp(P_NOMOVE)=="Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n")
    {
      write("Das machst Du doch schon.\n");
      return 1;
    }
  if(TP->QueryProp(P_NOMOVE))
    {
      write(TP->QueryProp(P_NOMOVE));     
      return 1;
    }
      
  TP->SetProp(P_NOMOVE,"Du lehnst gerade an der Tuer und solltest Dich erst aufrichten.\n");
  write("Du lehnst Dich gegen die Tuer.\n");
  say(TPN+" lehnt sich gegen die Tuer.\n");
  lehner++;
  
  if (lehner==2)
    {
      tell_room(TO, "Durch Euer beider Gewicht gibt die Tuer nach und ihr zwei purzelt "+
      "in den Raum dahinter.\nDie Tuer schliesst sich.\n");
      TP->SetProp(P_NOMOVE,0);
      anderer->SetProp(P_NOMOVE,0);
      lehner=0;//man weiss ja nie

      TP->move(LABY_ROOM+"hoehlenlabyrinth_13k", M_GO, 0,
               "faellt hin", "faellt hin");
      anderer->move(LABY_ROOM+"hoehlenlabyrinth_13k", M_GO, 0,
               "faellt hin", "faellt hin");


      return 1;
    }
  write("Du bist nicht stark genug. Vielleicht solltest Du es mit "+anderer->name()+
        " zusammen versuchen?\n");
  return 1;
}

void wiederbeleben_4()
{
  TP->SetProp(P_PARALYZED,0);
  anderer->SetProp(P_PARALYZED,0);
  anderer->SetProp(P_GHOST,0);
  write("Du schaffst es, "+anderer->name(WEN)+" wieder zu beleben. Uff, das war knapp.\n");
    tell_object(anderer, "Du spuerst, wie das Leben in Dich zurueckkehrt. Uff, das war knapp.\n");
  tell_object(anderer, "");
}
void wiederbeleben_3()
{
  write("Beherzt kniest Du Dich hin und beatmest "+anderer->name(WEN)+".\n");
	  tell_object(anderer, TPN+" kniet sich beherzt hin und beginnt, Dich zu beatmen.");
	  call_out("wiederbeleben_4",5);
}
void wiederbeleben_2()
{
  write("Das sieht nicht gut aus, Du musst "+anderer->name(WEM)+" schnell helfen.\n");
    tell_object(anderer, TPN+ " ueberlegt fieberhaft, wie "+TP->QueryPronoun()+" Dir helfen kann.\n");
	call_out("wiederbeleben_3",3);
}

void wiederbelebung()
{
  write("Besorgt lehnst Du Dich ueber "+anderer->name()+".\n");
    tell_object(anderer, TPN+ " lehnt sich besorgt ueber Dich.\n");
	call_out("wiederbeleben_2",3);
}
	

int rausdrehen(string str)
{
	notify_fail("Was moechtest Du herausdrehen?\n");
	if(str!="stoepsel raus"&&str!="stoepsel heraus")return 0;
	
	if(!stoepselda)
		write("Der Stoepsel ist doch schon draussen.\n");
	else
		{
			write("Du drehst den Stoepsel heraus.\n");
			write("Ploetzlich ergiesst sich ein schwall kalten Wassers auf Dich.\n");
			RemoveDetail(({"stoepsel","scheibe"}));
	    AddDetail( ({ "decke" }),
        "Die Decke besteht aus dem selben Gestein wie die Waende. Sie ist recht hoch und gewoelbt, "
        "sodass sie nahtlos in die Waende uebergeht. Du siehst eie grosses Loch in der "
        "Decke.");
	    AddDetail( ({ "loch" }),
        "Leider kannst Du nicht erkennen, was dahinter ist. Und erreichen kannst Du es auch nicht.");
		
			//gibt wieder, ob jemand/etwas im Raum ist.
			if (call_other(LABY_ROOM + "hoehlenlabyrinth_12l_o","jemandda",0))
				{
				  anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
					if(present (anderer, to_object(LABY_ROOM + "hoehlenlabyrinth_12l_o")))
						if(anderer->QueryProp(P_PARALYZED))//wenn der andere Paralysiert ist.
							{
								call_out("wiederbelebung",2);
								TP->SetProp(P_PARALYZED, ([
								PARALYZE_TIME: (-1),
								PARALYZE_MSG: "Du musst Dich jetzt erstmal um "+anderer->name()+"kuemmern!\n",
								PARALYZE_MSG_OTHER: "%s schaut besorgt.\n",
								PARALYZE_END: anderer->name()+" kommt wieder zu sich.\n",
								PARALYZE_END_OTHER: "%s atmet erleichtert auf.\n"]));
							}
					anderer->move(LABY_ROOM+"hoehlenlabyrinth_12l", M_GO, 0, "faellt von oben herunter", "faellt nach unten");
					call_other(LABY_ROOM + "hoehlenlabyrinth_12l_o","allesrunter",0);
					
				}
			}
		return 1;
	}
