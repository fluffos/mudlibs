
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Fass");
  SetProp(P_LONG,
    "Du siehst ein kleines, leeres Fass vor Dir. Es sieht recht stabil aus?" );
SetProp(P_INFO,"Dieses Fass kann Dir bestimmt weiter helfen. Vielleicht kann man daraus eine "+
							 "Wippe oder aehnliches bauen?\n");

  SetProp(P_NAME, "Fass");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fass","\nlabyloeschmich"}));

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 1);
 
  AddCmd(({"baue","bau"}),"bauen");
 
}

//wippe bauen geht nicht, weil Fass (wenn da und abgelegt) immer wegrollt
//wenn man im richtigen Raum ist kriegt man den Hinweiss auf die Kuhle. Oder dort funktioniert es einfach

int bauen(string str)
{
	string *ausgaenge;
	notify_fail("Was moechtest Du bauen?\n");
	if(str!="wippe") return 0;

	if(present("brett",environment(TP)))
	 	{
	 		write("Dazu muesstest Du das Brett nehmen.\n");
	 		return 1;
	 	}
	 if (present("brett",TP))

		//wenn das Brett im Spieler ist
		{//wenns der richtige Raum ist.
		//LABY_ROOM+"hoehlenlabyrinth_16n"
		if(file_name(environment(TP))==LABY_ROOM+"hoehlenlabyrinth_16n")
		//	if(file_name(environment(TP))=="/d/gebirge/yondala/labyrinth/room/hoehlenlabyrinth_16n")
				{
					write("Du rollst das Fass in die kleine Kuhle im Boden und legst das Brett darueber.\n");
					CLONE(LABY_OBJ+"wippe.lpc", environment(TP));
					present("brett",(TP))->remove();
					remove();
					return 1;
				}
			//wenns der falsche Raum ist
			write("Du legst das Brett auf das Fass.\n"+
			"Das Fass rollt weg und das Brett faellt zu Boden.\nDu musst es woanders versuchen.\n");
			say(TPN+" legt ein Brett ueber das Fass.\nDas Fass rollt weg und das Brett faellt zu Boden.\n",TP);
			present("brett",(TP))->move(environment(TP),M_PUT);
			//Fass soll irgendwohin rollen
			ausgaenge = m_indices(environment(TP)->QueryProp(P_EXITS));
      move( environment(TP)->QueryProp(P_EXITS)[ausgaenge[random(sizeof(ausgaenge))]],M_NOCHECK );
			return 1;
		}
		write("Nur aus einem Fass kann man schlecht eine Wippe bauen. Nicht mal in einem Mud.\n");
		return 1;
		}
			
