// Standardraum fuer den Teil der Hoehle, in dem man sich an den Wurzeln weiter hangeln muss,
// diese Funktion ist hier aber nicht drin

#include "../def.h"
inherit "std/room";
#include <properties.h>

int pilz
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
		pilz=random(2);
		pilz+=2;
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Unter der Erde" );
 		pilz=random(2);
		pilz+=2; 
  SetProp( P_INT_LONG,
    "Du bist hier definitiv unter der Erde. Die Waende bestehen aus einer Art Lehm, hin und "
    "wieder entdeckst Du aber auch andere Erdschichten darin. Am Boden liegen ein paar "
    "Erdklumpen und es wachsen hier und da ein paar Pilze. Durch die Decke haben sich "
    "einige Wurzeln gegraben. Hin und wieder bricht durch ein kleines Loechlein sogar etwas "
    "Sonnenlicht." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "erde" }),
    "Du bist definitiv unter der Erde. Aber zum Glueck nicht tot, sondern einfach nur so.");
  AddDetail( ({ "glueck" }),
    "Das ist doch ein Glueck, nicht wahr?");
  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus einer Art Lehm, aber auch aus anderen Erdschichten.");
  AddDetail( ({ "lehm" }),
    "Der Lehm ist braun, ausserdem sind ein paar kleinere Steinchen sind darin eingeschlossen");
  AddDetail( ({ "steinchen" }),
    "Kleine, spitze Steinchen sind in dem Lehm eingeschlossen.");
  AddDetail( ({ "art" }),
    "Du kennst Dich nicht so gut mit Lehm aus um nun genau sagen zu koennen um welche Art "
    "Lehm es sich handelt, das ist nun aber auch nicht soooo wichtig.");
  AddDetail( ({ "erdschichten","schichten" }),
    "Immer wieder findest Du im Lehm auch andere Erdschichten in den verschiedensten Farben.");
  AddDetail( ({ "farben" }),
    "Zum Beispiel hellbraun, dunkelbraun, hellgrau, dunkelgrau, schwarz, sogar eine roetliche "
    "Schicht kannst Du erkennen.");
  AddDetail( ({ "schicht" }),
    "Was das wohl sein mag?");
  AddDetail( ({ "erdklumpen","klumpen" }),
    "Vermutlich haben die Wurzeln diese Erdklumpen aus der Decke gedrueckt.");
  AddDetail( ({ "boden" }),
    "Auf dem Boden liegen einige Erdklumpen herum.");
  AddDetail( ({ "pilze" }),
    "Es sind verschiedenste Pilze zu sehen. Du koenntest welche sammeln, wenn Du magst.");
  AddDetail( ({ "decke" }),
    "Die Decke ist ein wenig loechrig, denn einige Wurzeln haben sich von oben in diese Hoehle "
    "herein gegraben.");
  AddDetail( ({ "wurzeln" }),
    "Einige Wurzeln haben sich von aussen in diese Hoehle gefressen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht feucht und pilzig, hin und wieder weht aber ein frisches Lueftchen durch die "
    "Loecher in der Decke herein.");
  AddSmell( ({ "pilz","pilze", "boden" }),
    "Die Pilze auf dem Boden riechen irgendwie muffig.");
  AddSmell( ({ "lueftchen", "luft" }),
    "Die Luft, die durch die kleinen Loecher stroemt ist angenehm frisch.");
  AddSmell( ({ "" }),
    ".");
  AddSmell( ({ "" }),
    ".");
  AddSmell( ({ "" }),
    ".");

//  AddRoomMessage( 
  //  ({".\n"}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen.");

  AddSound( ({ "rauschen" }),
    "Das ist definitiv der Wind, der ueber Dir ausserhalb der Hoehle weht.");
  AddSound( ({ "wind" }),
    "Der Wind rauscht leise an den Loechern vorbei.");
  AddSound( ({ "" }),
    ".");
 
  AddCmd( ({ "sammel", "sammle" }), "sammeln" );

}


			
int sammeln(string str)
{
	notify_fail("Was moechtest Du sammeln?\n");
	if(str=="pilze"||str=="pilz"||str=="pilze ein"||str=="pilz ein")
		{
			if(pilz)
				{
					write("Du bueckst Dich und sammelst einen Pilz.\n");
					if(random(2)==0)CLONE(LABY_OBJ +"/d/nebelwaelder/yondala/nebel/obj/champignon.lpc", TP);
			    else CLONE(LABY_OBJ +"/d/nebelwaelder/yondala/nebel/obj/fliegenpilz.lpc", TP);
			    pilz--;
			  }
			 else write("Hier wurden schon genug Pilze gesammelt, vielleicht suchst Du besser woanders welche oder wartest, bis die hier nachgewachsen sind?\n");
			 	
			 return 1;
			}
		return 0;
}

	
