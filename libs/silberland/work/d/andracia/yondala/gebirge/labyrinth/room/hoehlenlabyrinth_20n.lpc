//Hier endet der Gang. Wenn man sich von _16n hergehangelt hat, kann man die Wand hochkurbeln
//ansonsten faengt man sich nen Splitter ein, kann versuchen ne Raeuberleiter zu machen, Lehmabbauen

#include "../def.h"
//inherit "std/room";
inherit LABY_ROOM + "hoehlenlabyrinth_hangelhoehle.lpc";
#include <properties.h>

void anfangszustand()
{
	lehmda=1+random(2);
  AddDetail( ({ "holzwand" }),
    "Die Holzwand besteht aus wenigen dicken, schweren Holzbalken.");
	RemoveDetail("Spalt");
	RemoveCmd("zwaengen");
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem Gang unter der Erde" );
  
  SetProp( P_INT_LONG,
    "Du stehst in einem schmalen Gang der offensichtlich unter dem Erdreich liegt, denn alles "
    "besteht hier aus lehnmiger Erde, die von vielen Wurzeln durchbrochen ist die wirr aus "
    "Decke und Waenden brechen. Du stehst vor einer stabilen Holzwand im Sueden und kannst hier "
    "nur nach Norden gehen." );

  AddDetail( ({ "gang" }),
    "Du stehst in einem schmalen, aber recht hohen Gang unter der Erde.");
  AddDetail( ({ "erde" }),
    "Du bist von feuchtem Erdreich umgeben.");
  AddDetail( ({ "erdreich" }),
    "Die Erde um Dich herum besteht aus Humus und Lehm, was Du an den unterschiedlichen "
    "Farben festmachst. Es ist an vielen Stellen von Wurzeln unterbrochen.");
  AddDetail( ({ "humus" }),
    "Schwarzer Humus dominiert das Erdreich. Er sieht sehr fruchtbar aus, die Pflanzen ueber Dir "
    "muessen gut wachsen.");
  AddDetail( ({ "pflanzen","pflanze" }),
    "Pflanzen siehst Du hier nicht, die sind weit ueber Dir, draussen. Aber weil Du ihre "
    "Wurzeln sehen kannst weisst Du, dass sie da sind.");
  AddDetail( ({ "lehm" }),
    "Hellbrauner Lehm durchsetzt das Erdreich hier und da.");
  AddDetail( ({ "farben","farbe" }),
    "Du siehst schwarzen Humus und hellbraunen Lehm.");
  AddDetail( ({ "norden" }),
    "Im Norden weitet sich der Gang und scheint in einer kleinen Hoehle zu muenden.");
  AddDetail( ({ "stellen" }),
    "Hier und da spriessen verschiedenste Wurzeln durch Decke und Waende.");
  AddDetail( ({ "decke" }),
    "Von der Decke haengen dicke Wurzeln herab. Sie sehen sehr stabil aus.");
  AddDetail( ({ "wurzeln" }),
    "Von der Decke haengen dicke Wurzeln herunter. Bis auf eine sind alle graugruen und ziemlich "
    "schrumpelig. Die Wurzeln an den Waenden sind feiner und auch weicher.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen wie alles hier aus einem Gemisch von Erde und Humus. Duenne, weiche "
    "Wurzeln haben sie durchbrochen und kitzeln Dich.");
  AddDetail( ({ "gemisch" }),
    "Waende, Decke und Boden bestehen aus einem Gemisch von Humus und Lehm.");
  AddDetail( ({ "boden" }),
    "Der Boden ist platt getrampelt. Du siehst einige Spuren.");
  AddDetail( ({ "spuren" }),
    "Das sieht fast nach Fussspuren aus. Sie fuehren von Norden nach Sueden.");
  AddDetail( ({ "fussspuren" }),
    "Wer auch immer diese Spuren hinterlassen hat, er war barfuss.");
  AddDetail( ({ "dicke wurzeln","dicke wurzel" }),
    "Die dicken Wurzeln unter der Decke sehen so stabil aus, dass man sich sogar an ihnen "
    "entlang hangeln koennte, wenn sie nicht zu weit oben waeren.");
  AddDetail( ({ "weiche wurzeln","weiche wurzel" }),
    "Die weichen Wurzeln an den Waenden kitzeln Dich sanft wenn Du an Ihnen vorbeigehst.");
  AddDetail( ({ "norden" }),
    "Du kannst dem Gang nach Norden folgen. Allerdings warst Du da vermutlich schon, duerfte "
    "also wenig spannend sein. Aber diese Holzwand da im Sueden... die kriegt man doch "
    "bestimmt irgendwie auf...");
/*  AddDetail( ({ "dunkelheit" }),
    "Die Abwesenheit von Licht nennt man Dunkelheit.");
  AddDetail( ({ "licht" }),
    "Was nicht da ist, kann man nicht sehen.");
  AddDetail( ({ "abwesenheit" }),
    "Es ist keins da. Es sei denn, Du hast welches mitgebracht. Aber wirklich sehen kann man das "
    "Licht dann trotzdem nicht. Aber alles andere um Dich herum.");  
  */
  AddDetail( ({ "holzwand" }),
    "Die Holzwand besteht aus wenigen dicken, schweren Holzbalken.");
  AddDetail( ({ "holzbalken","balken" }),
    "Die Balken sind mit grossen, stabilen Naegeln aneinander genagelt.");
  AddDetail( ({ "naegel" }),
    "Die Naegel sind schon ein wenig rostig, aber sehen noch sehr stabil aus. Zu stabil um sie "
    "herausziehen zu koennen.");
  AddDetail( ({ "wurzel" }),
    "Eine Wurzel sieht anders aus, irgendwie roetlich. Halt, das ist doch gar keine Wurzel, es "
    "sieht wie ein kleines Rad aus.");
  AddDetail( ({ "rad" }),
    "Tatsaechlich, zwischen den ganzen dicken Wurzeln haengt versteckt ein kleines Handrad. "
    "Ob man es drehen kann?");
  AddDetail( ({ "handrad" }),
    "Jetzt, wo Du es genauer betrachtest, faellt Dir auch der Mechanismus auf, an dem es haengt.");
  AddDetail( ({ "mechanismus" }),
    "Du bist Dir ziemlich sicher, dass sich die Holzwand im Sueden heben wird, wenn das Handrad "
    "gedreht wird.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSmell( DEFAULT_SMELL,
    "Es riecht hier erdig.");
  AddSmell( ({ "erde" }),
    "Die Erde riecht feucht, aber nicht faulig.");

  AddRoomMessage( 
    ({"Die Wurzeln an den Waenden zucken.\n",
    	"Es raschelt ueber Dir.\n"}),60,"schnapp");

  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein leises Rascheln.");

  AddSound( ({ "rascheln" }),
    "Woher das wohl kommen mag?");


   AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_19n.lpc");

  AddCmd(({"drehe","dreh"}),"drehen"); //wenn man gerade hangelt kann man das Rad drehen um die Wand zu beseitigen
  AddCmd(({"ziehe","zieh"}),"rausziehen"); //was nicht geht, man faengt sich aber nen Splitter ein und kriegt -2 HP


}


int drehen(string str)
{
	notify_fail("Was moechtest Du drehen?\n");
	if(str!="rad"&&str!="handrad") return 0;
	
	if(TP->QueryProp(P_NOMOVE)!="Du haengst in den Wurzeln und musst Dich fallen lassen um normal laufen zu koennen.\n")
		{
			write("Du kannst das Rad so nicht erreichen, es ist zu hoch oben.\n");
			return 1;
		}
	//if(GetExits()=="Es gibt einen sichtbaren Ausgang: norden.\n")
		if(!GetDetail("spalt"))//Wenn es das Detail "Spalt" nicht gibt
		{
			//AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_20n.lpc");
			write("Mit einiger Muehe drehst Du an dem kleinen Rad. Langsam hebt sich die Holzwand im "+
			"Sueden ein Stueckchen, sodass ein kleiner Spalt entsteht.\n");
			say(TPN+" dreht mit einer Muehe an dem kleinen Rad. Langsam hebt sich die Holzwand im "+
			"Sueden ein Stueckchen, sodass ein kleiner Spalt entsteht.\n",TP);
      AddDetail( ({ "holzwand" }),
        "Die Holzwand besteht aus wenigen dicken, schweren Holzbalken. Unten ist ein kleiner Spalt zu sehen.");
      AddDetail( ({ "spalt" }),
        "Durch den kannst Du Dich vermutlich hindurchzwaengen.");
      AddCmd(({"zwaenge","zwaeng"}),"zwaengen"); //man kann sich nun weiter nach Sueden begeben

			return 1;
		}
	write("Das Rad klemmt, Du kannst es nicht mehr bewegen.\n");
	return 1;
}
			
		
int zwaengen(string str)
{
	notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
	if(str!="durch spalt"&&str!="durch spalt hindurch") return 0;
	this_player()->move(LABY_ROOM+"hoehlenlabyrinth_21n", M_GO, "nach Sueden", "zwaengt sich durch den Spalt",
                                "zwaengt sich durch den Spalt");
  return 1;
	
}


rausziehen(string str)
{
	notify_fail("Was moechtest Du herausziehen?\n");
	if(str=="nagel raus"||str=="nagel"||str=="nagel heraus"||
		 str=="nagel aus holz raus"||str=="nagel aus holz"||str=="nagel aus holz heraus"||
		 str=="nagel aus holzwand raus"||str=="nagel aus holzwand"||str=="nagel aus holzwand heraus"||
		 str=="nagel aus brett raus"||str=="nagel aus brett"||str=="nagel aus holz brett"||
		 str=="nagel aus holzbrett raus"||str=="nagel aus holzbrett"||str=="nagel aus holzbrett heraus"||
	   str=="naegel raus"||str=="naegel"||str=="naegel heraus"||
		 str=="naegel aus holz raus"||str=="naegel aus holz"||str=="naegel aus holz heraus"||
		 str=="naegel aus holzwand raus"||str=="naegel aus holzwand"||str=="naegel aus holzwand heraus"||
		 str=="naegel aus brett raus"||str=="naegel aus brett"||str=="naegel aus holz brett"||
		 str=="naegel aus holzbrett raus"||str=="naegel aus holzbrett"||str=="naegel aus holzbrett heraus")
		 {
		 	  //CLONE(LABY_OBJ+"splitter.lpc", TP);
		 	  write("Du versucht einen Nagel herauszuziehen.\nAUTSCH!\nDu hast Dir einen Splitter eingefangen.\n");
		 	  TP->do_damage(2, "ein Holzsplitter");
		 	  say(TPN+" versucht einen Nagel aus der Holzwand zu ziehen.\n",TP);
		 	  return 1;
		 	}
 	return 0;
}

