//Die standartwalküre

inherit "std/mnpc";
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <moving.h>
#include <language.h>
#include "../def.h"

void create() {

  ::create();

  AddId(({"walkuere", "frau"}));//Dinge auf die man ihn beim untersuchen ansprechen kann

  SetProp(P_SHORT, "Eine Walkuere"); //Die Kurzbeschreibung
  SetProp(P_LONG, //Die Langbeschreibung
    "Du siehst eine Walkuere vor Dir. Sie ist relativ gross, schlank und sehr huebsch. Ihre "
    "langen braunen Haare werden durch ein Lederband aus der Stirn gehalten. Sie traegt ein "
    "ledernes Bustier, einen Lederrock und Mokasins an den Fuessen. Um den Hals haengt ihr ein "
    "schillerndes Amulett In einer Hand haelt sie ein grosses, silbernes Schwert, in der "
    "anderen Hand einen silbernen Schild.");
  SetProp(P_NAME, "Walkuere");//der Name
  SetProp(P_GENDER, FEMALE); //Geschlecht
  SetProp(P_ARTICLE, 1);//Soll ein Artikel vor den Namen gesetzt werden? 0=nein

SetProp (P_MNPC_DEFAULTROOM, "/d/");//ihr Aufwachraum, der Pfad sollte noch eingefuegt werden
SetProp (P_MNPC_AREA, "/d/" );//in welchem Gebiet darf sie sich bewegen?
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS); //wie und wo darf sie laufen?
SetProp (P_MNPC_WAIT, ({5, 10, 5}));//wie schnell laeuft sie?
 
  
  create_default_npc(20);//die Staerke. 20 ist sehr stark, muss man noch austesten
  
  SetProp(P_RACE, "Halbgoettin");//Rasse
  SetProp(P_SIZE, 180);//Koerpergroesse
  SetProp(P_WEIGHT, 60000);//Gewicht
  SetProp(P_ALIGN, 0);//Gesinnung zwischen -1000 und 1000; 0= neutral
  SetProp(P_MAX_HANDS, 2);//Anzahl Hände
  SetProp(P_RESISTANCE_STRENGTHS , //wogegen ist sie resistent im Kampf, worauf besonders anfaellig?
    ([DT_FIRE:      -0.5, DT_COLD:      -0.5, DT_WATER:  -0.0, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION: -0.5, DT_SOUND:  -0.5, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.0, DT_POISON: -0.0, DT_TERROR: -0.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );
// wenn man das auf 1 setzt kriegt er dadurch doppelten schaden, bei -1 ist
// er immun und bei -0,5 ist es nur halb so stark

  SetProp(P_MSGIN, "kommt leichtfuessig herbei"); //Nachricht wenn sie den Raum betritt
  SetProp(P_MSGOUT, "geht leichtfuessig");        //" verlaesst
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");//wenn sie reinteleportiert wird
  SetProp(P_MMSGOUT, "greift an ihr Amulett, schliesst die Augen und ist weg");

  SetProp(P_DIE_MSG,  " zerspringt in tausend kleine Perlen, die sich in Luft aufloesen.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_NOCORPSE, 1 );// bei 0 hat er ne Leiche.
  SetProp(P_KILL_NAME, "Eine Walkuere");//name des tötenden npc
  SetProp(P_KILL_MSG, "Das haette nicht sein muessen, "+TPN+"!");//die meldung wenn der LABY_NPC einen Spieler umgebracht hat
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
  AddDetail( ({ "", "" }),//Dinge, auf die man sie untersuchen kann
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "sagt: bereitet Euch auf die grosse Schlacht vor.\n"); //Wenn sie keine Antwort hat auf eine FRage

  AddInfo("yondala", "Lang lebe Yondala.","sagt: "); 
//wenn man sie fragt antwortet sie

    AddInfo( ({ "uebung" }),//FRage
    "Mit 'Uebe Kampf mit Walkuere' uebe ich mit Euch Eure Kampffertigkeit, wenn Ihr das wuenscht.",//Antwort
    "sagt: ");//wie sie antwortet, in diesem Fall sagt sie es einfach        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");
    
    SUID;
    CLONEME(LABY_OBJ + "amulett.lpc");//Kleidung, die sie traegt wenn wie geclont wird (noch nicht existent)
    CLONEME(LABY_OBJ + "lederbh.lpc");
    CLONEME(LABY_OBJ + "lederrock.lpc");    
    CLONEME(LABY_OBJ + "mokasins.lpc");    
    CLONEME(LABY_OBJ + "Walkuerenschwert.lpc");    
    CLONEME(LABY_OBJ + "silberschild.lpc");    
    CLONEME(LABY_OBJ + "lederhaarband.lpc");    
}


