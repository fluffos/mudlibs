//Hier wird gespeichert, wie gut ein Spieler gepaddelt hat


#include "../def.h"

inherit "std/thing";

#include <properties.h>

int punkte;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  punkte=0;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\nrichtiggemacht","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_IRON);

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
 
}

void pluspunkt()
{
	punkte++;
}

int gibPunkte()
{
	return punkte;
}