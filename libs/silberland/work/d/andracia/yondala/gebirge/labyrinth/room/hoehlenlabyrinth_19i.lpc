}

int testen(string str)
{
	int i;
	i=to_int(str[strlen(str)-1..strlen(str)]);
	write("Es ist" +i+"\n");
	return 1;
}


int moersern(string str)
{
	notify_fail("Was moechtest Du zerkleinern?\n");
	if(!str)return 0;
	if(str!="koerner"&&str!="pfefferkoerner")
	{
		write("Das kannst Du hier nicht zerkleinern.\n");
		return 1;
	}
	if(!present("pfefferkoerner",TP))
	{
		write("So etwas hast Du nicht.\n");
		return 1;
	}
	if(present("pfefferkoerner",TP)->id("\nzerstossenepfefferkoerner"))
	{
		write("Die Pfefferkoerner sind schon zerkleinert.\n");
		return 1;
	}
	
	present("pfefferkoerner",TP)->zerstossen();
	write("Du zerkleinerst die Pfefferkoerner im Moerser und nimmst sie wieder an Dich.\n");
	return 1;
	
}

int erhitzen(string str)
{
	notify_fail("Was moechtest Du erhitzen?\n");
	if(!str) return 0;
	if(!present(str,TP))
	{
		write("So etwas hast Du nicht.\n");
		return 1;
	}
	if(str=="glas"||str=="reagenzglas"||str=="mixtur")
	{
		switch (present("\nlabyquestreagenzglas",TP)->status_geben())
		{
		
			case 0: 
				write("Du erhitzt das leere Reagenzglas. Es passiert ... nichts.\n");
				return 1;
				break;
/*			case 1 .. 3:
				write("Du erhitzt das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;*/
			case 4:	
				write("Du erhitzt das Reagenzglas. Die Mixtur leuchtet kurz auf.\n");
				present("\nlabyquestreagenzglas",TP)->status_5();
				return 1;
				break;
/*			case 5 .. 7:
				write("Du erhitzt das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;	*/
			case 8:	
				write("Du erhitzt das Reagenzglas. Die Mixtur leuchtet kurz auf.\n");
				present("\nlabyquestreagenzglas",TP)->status_9();
				return 1;
				break;
			default:
				write("Du erhitzt das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;				
		}

	}
	else
		write (capitalize(present(str,TP)->name(WEN)) +" zu erhitzen macht an dieser Stelle keinen Sinn.\n");
	
	return 1;
}


int pfluecken(string str)
{
	notify_fail("Was moechtest Du pfluecken?\n");
	
	if (str=="beere"||str=="ziegenbeere"||str=="ziegenbeeren"||str=="beeren")
	{
		if(present("3ziegenbeeren",TP))
			write("Du hast schon drei Beeren, das muss reichen.\n");
		else
		{
			write("Du pflueckst Dir drei Ziegenbeeren.\n");
			CLONE(LABY_OBJ+"ziegenbeeren.lpc", TP);
		}

		return 1;
	}
	return 0;
}
	
	
int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	
	if (str=="linke schublade")
	{
		write("Du oeffnest die linke Schublade.\n");
		if(present("\nfroschrezept",TP))
			write("Sie ist leer.\n");
		else
		{
			write("In der Schublade liegt ein Blatt Papier. Du nimmst es an Dich.\n");
			CLONE(LABY_OBJ+"froschrezept.lpc", TP);
		}
		write("Die Schublade schliesst sich wieder.\n");
		return 1;
	}
	
	if (str=="rechte schublade")
	{
		write("Du oeffnest die rechte Schublade.\n");
		if(present("\nlabyquestreagenzglas",TP))
			write("Sie ist leer.\n");
		else
		{
			write("In der Schublade liegt ein Reagenzglas. Du nimmst es an Dich.\n");
			CLONE(LABY_OBJ+"reagenzglas.lpc", TP);
		}
		write("Die Schublade schliesst sich wieder.\n");
		return 1;
	}
	if(str=="tuer")
	{
		write("Meinst Du die Nordtuer oder die Suedtuer?\n");
		return 1;
	}
	if(str=="nordtuer")
	{
		write("Die Nordtuer ist doch schon offen.\n");
		return 1;
	}
	if(str=="suedtuer")
	{
		write("Du ruettelst kraeftig an der Suedtuer. Leider bekommst Du sie nicht auf.\n");
		return 1;
	}
	
	
	return 0;
		
}	


int filtern(string str)
{
	notify_fail("Was moechtest Du filtern?\n");
	
	if(!str)return 0;
	if(!present(str, TP))
		{
			write("So etwas hast Du nicht.\n");
			return 1;
		}
	if(str!="mixtur"&&str!="saft")
	{
		write("Es macht hier keinen Sinn "+present(str,TP)->name(WEN)+ " zu filtern.\n");
		return 1;
	}
	switch (present("\nlabyquestreagenzglas",TP)->status_geben())
		{
		
			case 0: 
				write("Dein Reagenzglas ist leer.\n");
				return 1;
				break;
			case 1:
				write("Es macht keinen Sinn, eine bereits verdorbene Mixtur zu filtern.\n");
				return 1;
				break;
/*     		case 2 .. 5:
				write("Du fuellst den Ziegenbeerensaft in das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;*/
			case 6:	
				write("Du filterst Deine Mixtur. Die Mixtur leuchtet kurz auf.\n");
				present("\nlabyquestreagenzglas",TP)->status_7();
				return 1;
				break;
			case 7:	
				write("Du filterst Deine Mixtur erneut. Das war unnoetig!\n");
				return 1;
				break;
			default:
				write("Du filterst die Mixtur. Die Mixtur verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;
		}
		return 1;
}


int melken(string str)
{
	notify_fail("Was moechtest Du melken?\n");
	if(str!="fruechte"&&str!="frucht"&&str!="rankenfruechte"&&str!="rankenfrucht")	return 0;
	if(!present("\nlabyquestreagenzglas",TP))
	{
		write("Du benoetigst ein passendes Gefaess.\n");
	}
		//Reagenzglas richtig fuellen
	else
	{
		if(present("\nlabyquestreagenzglas",TP)->status_geben()==2) //Reagenzglas ist mit Saft gefuellt
			write("In Deinem Reagenzglas befindet sich bereits genug Saft.\n");
		
		else if(present("\nlabyquestreagenzglas",TP)->status_geben()==0) //Reagenzglas ist leer
		{
			write("Du melkst eine der Fruechte und faengst den Saft in Deinem Reagenzglas auf.\n");
			present("\nlabyquestreagenzglas",TP)->status_2();
		}
		else
		{
			write("Du melkst eine der Fruechte und faengst den Saft in Deinem Reagenzglas auf."+
			"Der Inhalt ist nun verdorben.\n");
			present("\nlabyquestreagenzglas",TP)->status_1();
		}
		return 1;
	}
		
}