  AddDetail( ({ "gefaess" }),
    "Schau Dich um, dann findest Du sicher etwas geeignetes.");
  AddDetail( ({ "moebel","moebelstuecke" }),
    "Du siehst einen Tisch und ein kleines Regal.");
  AddDetail( ({ "unebenheiten" }),
    "Derer gibt es an der Wand wenige. Nur eine interessiert Dich ein wenig mehr als die anderen.");
  AddDetail( ({ "unebenheit" }),
    "Es scheint sich bei dieser Unebenheit um ein kleines Loch zu handeln.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    ".");
  AddSmell( ({ "" }),
    ".");
/*
  AddRoomMessage( 
    ({"Die Stille lastet schwer auf Dir.\n",
    	"Ein leichter Druck legt sich auf Deine Ohren.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Ein Tropfen faellt mit lautem *Platsch* auf den Boden.\n"}),80,"func");
*/
  AddSound( DEFAULT_SOUND,
    ".");

  AddSound( ({ "" }),
    ".");

  AddSound( ({ "" }),
