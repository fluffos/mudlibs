//wenn man hier nach Nordosten geht faellt man in ein Loch
//Man kann ein Seil befestigen, um den anderen Spieler raus zu lassen oder nach unten zu klettern

#include "../def.h"
inherit "std/room";
#include <properties.h>

int seilda;
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  seilda=0;
  AddDetail( ({ "oese" }),
    "An dieser Oese kann man sicher etwas befestigen.");
  RemoveDetail("seil");
}

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem finsteren Gang" );
  seilda=0;
  SetProp( P_INT_LONG,
    "Du stehst hier in einem finsteren Gang. Viel kannst Du hier nicht erkennen, ausser, dass "
    "er sich hier gabelt und nach Nordosten, Suedosten und Westen fuehrt. Was dort jedoch "
    "ist, kannst Du nicht erkennen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Du stehst hier in einem finsteren Gang. Viel kannst Du hier nicht erkennen, ausser, dass "
    "er sich hier gabelt und nach Nordosten, Suedosten und Westen fuehrt. Was dort jedoch "
    "ist, kannst Du nicht erkennen." );
  AddDetail( ({ "richtung" }),
    "Du kannst hier nach Osten und Westen gehen.");
  AddDetail( ({ "nordosten", "suedosten", "westen" }),
    "Dorthin fuehrt Dich der Gang, wenn Du Dich traust einfach in die Dunkelheit zu gehen.");
  AddDetail( ({ "dunkelheit","ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich erwartet wenn Du den Gang weiter entlang gehst.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Allerdings ist er nicht natuerlich entstanden, denn "
    "Du kannst deutlich die Bearbeitungsspuren sehen. Ausserdem wurde eine kleine Oese "
    "in den Boden eingelassen.");
  AddDetail( ({ "waende" }),
    "Die Waende sind sehr dicht beieinander, fast kannst Du beide gleichzeitig beruehren.");
  AddDetail( ({ "decke" }),
    "Die niedrige Decke ist nur knapp ueber Dir. Hoffentlich haelt sie.");
  AddDetail( ({ "wand" }),
    "Die beiden Waende rechts und links von Dir kommen Dir bedrohlich nahe. Oder taeuscht Dich "
    "Dein Gefuehl?");
  AddDetail( ({ "bearbeitungsspuren" }),
    "Jemand hat diesen Gang muehsehlig in den Fels geschlagen, er ist nicht natuerlich entstanden.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, kalt und ein wenig feucht.");
  AddDetail( ({ "gefuehl" }),
    "Kannst Du Deinen Gefuehlen trauen?");
  AddDetail( ({ "oese" }),
    "An dieser Oese kann man sicher etwas befestigen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Wahrlich, es riecht nicht angenehm..");

  AddRoomMessage( 
    ({"Irgendwie fuehlst Du Dich leicht unwohl.\n",
      "Du hast das Gefuehl, dass die Waende naeher ruecken.\n",
      "Hat sich da etwas bewegt?\n",
      "Irgendwo tropft etwas.\n"}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille. Ganz, ganz selten hoerst Du ein leises tropfen.");

  AddSound( ({ "tropfen" }),
    "Wo das wohl herkommen mag?");
  AddSound( ({ "totenstille","stille" }),
    "Dir ist unwohl zumute. Irgendetwas stimmt hier nicht.");


  AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_4i.lpc");
  AddExit("suedosten", LABY_ROOM+"hoehlenlabyrinth_5k.lpc");
  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_3k.lpc");
 AddCmd( ({ "loese", "loes"}), "loesen" ); //Raeuberleiter loesen
 AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach unten klettern
 AddCmd( ({ "befestige", "befestig","binde","bind"}), "befestigen" ); //an der Oese kann ein Seil befestigt werden.


}

int befestigen(string str)
{
  notify_fail("Was moechtest Du woran befestigen?\n");
  if(str!="seil an oese") return 0;
  
  if(!present("seil",TP))
    {
      write("Du hast kein Seil dabei.\n");
      return 1;
    }
  if(seilda)
    {
      write("An der Oese ist schon ein Seil befestigt.\n");
      return 1;
    }
  present("seil",TP)->remove();
  write("Du befestigst das Seil an der Oese und laesst es ins Loch hinab.\n");
  say(TPN+ "befestigt ein Seil an der Oese im Boden und laesst es ins Loch hinab.\n",TP);
  AddDetail( ({ "oese" }),
    "An der Oese ist ein Seil befestigt.");
  AddDetail( ({ "seil" }),
    "Das Seil ist an der Oese befestigt und haengt in das Loch hinab. Es sieht relativ stabil aus.");
  seilda=1;
  call_other(LABY_ROOM+"hoehlenlabyrinth_3k.lpc","seilruntergelassen",0);
  return 1;
}
  

int loesen(string str)
{
  notify_fail("Was moechtest Du loesen?\n");
  if(str!="seil"&&str!="seil von oese"&&str!="knoten")return 0;
  if(!seilda)
    {
      write("Aber an der Oese ist doch gar kein Seil befestigt.\n");
      return 1;
    }
  write("Du loest das Seil von der Oese und steckst es ein.\n");
  say(TPN+" loest das Seil von der Oese und steckt es ein.\n");
  CLONE("/obj/seil.lpc", TP);
  seilda=0;
  AddDetail( ({ "oese" }),
    "An dieser Oese kann man sicher etwas befestigen.");
  RemoveDetail("seil");
  call_other(LABY_ROOM+"hoehlenlabyrinth_3k.lpc","seilweg",0);
  return 1;
}

int klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if(str!="nach unten"&&str!="runter"&&str!="in loch"&&str!="herunter"&&str!="hinunter")return 0;
  if(!seilda)
    {
      write("Du versuchst nach unten zu klettern, stuerzt dabei aber ab.\n");
      TP->AddHp(-10);
      this_player()->move(LABY_ROOM+"hoehlenlabyrinth_3k", M_GO, 0,
                  "klettert in ein Loch", "faellt von oben herunter");
		return 1;
      }
   write("Du kletterst an dem Seil nach unten.\n");
   this_player()->move(LABY_ROOM+"hoehlenlabyrinth_3k", M_GO, 0,
                  "klettert in ein Loch", "kommt herunter geklettert");
  return 1;
}
    