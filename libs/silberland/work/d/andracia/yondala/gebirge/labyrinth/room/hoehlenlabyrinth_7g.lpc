// ziehe ast heraus => Holzstange (um daraus eine Leiter zu bauen)

#include "../def.h"
inherit "std/room";
#include <properties.h>

int holzda;

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  holzda=1;
 AddDetail( ({ "aeste" }),
    "Die Aeste sehen aus, als haetten sie mal zu einer Birke gehoert. Ein Ast sieht seltsam aus.");
  AddDetail( ({ "ast" }),
    "Einer der Aeste ist besonders gerade und gar nicht verzweigt. Ob Du ihn herausziehen kannst?");

}

void create() 
{
  ::create();
  holzda=1;
  
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in der Mitte einer grossen Hoehle. rund um Dich weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst."
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du stehst an der Suedseite einer grossen Hoehle. Oestlich von Dir weitet sie sich fast "
    "perfekt rund aus. Waende und Decke bestehen aus Fels. Der Boden vermutlich auch, "
    "allerdings liegt hier einiges an Unrat herum, sodass Du nicht viel von ihm sehen kannst." );

  AddDetail( ({ "mitte" }),
    "Du stehst hier in der Mitte der Hoehle.");
  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Fels, die Hoehle scheint "
    "natuerlichen Ursprungs zu sein.");

  AddDetail( ({ "ursprung" }),
    "Der Ursprung ist zwar natuerlich, der ganze Unrat hier aber eher weniger. Die Hoehle "
    "scheint relativ oft besucht zu werden.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir, sie besteht aus reinem Fels und scheint natuerlichen "
    "Ursprungs zu sein. Hier und da wird sie durch Wurzeln unterbrochen.");
  AddDetail( ({ "wurzeln" }),
    "Die Wurzeln unterbrechen die Decke hin und wieder. Sie stammen vermutlich von Baeumen, die "
    "ueber der Hoehle wachsen. Leider sind sie zu hoch um sie zu erreichen.");
  AddDetail( ({ "baeume" }),
    "Die Baeume kannst Du nicht sehen, nur deren Wurzeln.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht vermutlich aus Fels, unter dem ganzen Unrat ist er allerdings kaum zu sehen.");
  AddDetail( ({ "fels" }),
    "Da Du Dich in einer Hoehle im Gebirge befindest, besteht um Dich rum natuerlich alles aus Fels."); 
  AddDetail( ({ "gebirge" }),
    "Du befindest Dich hier im Gebirge, welches das grosse Tal umschliesst.");
  AddDetail( ({ "tal" }),
    "Draussen, vor der Hoehle, ist das Tal. Hast Du es schon erforscht? Dort gibt es einiges zu entdecken.");
  AddDetail( ({ "unrat" }),
    "Allerlei Unrat liegt hier herum. Teilweise Laub und Aeste, die wohl der Wind herein "
    "geweht haben mag, teilweise aber auch Muell, den hier wohl jemand hingeworfen hat.");
  AddDetail( ({ "laub" }),
    "Das Laub stammt vermutlich von Birken, sicher bist Du aber nicht.");
  AddDetail( ({ "birken", "birke" }),
    "Hier drinnen sind keine Birken, aber vermutlich draussen vor der Hoehle, im grossen Tal.");
  AddDetail( ({ "aeste" }),
    "Die Aeste sehen aus, als haetten sie mal zu einer Birke gehoert. Ein Ast sieht seltsam aus.");
  AddDetail( ({ "muell" }),
    "Du siehst einiges an Muell. Groesstenteils sind es Essensreste, Kleidungssstuecke und "
    "abgebrannte Fackeln die hier auf dem Boden verstreut herum liegen.");
  AddDetail( ({ "essensreste","reste" }),
    "Puh, das sieht alles nicht mehr so lecker aus.");
  AddDetail( ({ "kleidungsstuecke","kleidung","stuecke" }),
    "Die sind alle zerrissen und zerfetzt und nicht mehr zu gebrauchen.");
  AddDetail( ({ "fackeln" }),
    "Die sind wohl eher nicht mehr zu gebrauchen.");
  AddDetail( ({ "ast" }),
    "Einer der Aeste ist besonders gerade und gar nicht verzweigt. Ob Du ihn herausziehen kannst?");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist relativ trocken und staubig.");

  AddSmell( ({ "luft" }),
    "Die Luft ist relativ trocken und staubig.");
  AddSmell( ({ "staub" }),
    "Der liegt in dieser alten, unbewohnten Hoehle natuerlich ueberall.");

//  AddRoomMessage( 
  //  ({""}),30,"func");
  AddSound( DEFAULT_SOUND,
    "Es ist hier unheimlich still.");

  AddSound( ({ "wind" }),
    "Nicht mal den hoerst Du hier drin.");


  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_7h.lpc");
  AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_7f.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_8g.lpc");
  AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_6g.lpc");

  AddCmd(({"ziehe", "zieh"}),"herausziehen"); //Hier findet man ein Holzsstueck
}

int herausziehen(string str)
{
	notify_fail("Was moechtest Du herausziehen?\n");
	if(str!="ast"&&str!="ast heraus") return 0;
	if(holzda)
		{
	    write("Du zerrst mit aller Kraft an dem Ast. Ploetzlich gibt er nach.\n "+
	    "Der Ast entpuppt sich als loecherige Holzstange.\n");
	    say(TPN+" zieht eine Holzstange aus den restlichen Aesten.\n");
	    CLONE(LABY_OBJ +"holzstange.lpc", TP);
	    holzda=0;
	AddDetail( ({ "aeste", "ast" }),
    "Die Aeste sehen aus, als haetten sie mal zu einer Birke gehoert.");
	    return 1;
	  }
	 write("Es ist gar kein besonderer Ast mehr da.\n");
		 return 1;
	}
	    
	    
			


	
