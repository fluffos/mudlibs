//hierzweigt sich der Weg nach Nordosten zur Labyrinthquest und nach Suedosten richtung Trolle


#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_SHORT, "In einem Birkenhain" );
  SetProp( P_INT_LONG,
    "Du stehst mitten auf einer bluehenden Wiese in einem herrlichen Birkenhain der sich "
    "in fast alle Richtungen ausbreitet. Um Dich herum stehen vereinzelte Birken, in der Ferne "
    "kannst Du die Auslaeufer des Gebirges erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "birkenhain" }),
    "Du stehst mitten auf einer bluehenden Wiese in einem herrlichen Birkenhain der sich "
    "in fast alle Richtungen ausbreitet. Um Dich herum stehen vereinzelte Birken, in der Ferne "
    "kannst Du die Auslaeufer des Gebirges erkennen." );
  AddDetail( ({ "wiese" }),
    "Du stehst mitten auf einer bluehenden Wiese. Das Gras ist kniehoch und wilde Blumen stechen "
    "immerwieder bunt hervor. Ein paar Bienchen summen um Dich herum.");
  AddDetail( ({ "gras" }),
    "Das Gras ist hier durchschnittlich kniehoch und wird immer wieder von bunten Blumen unterbrochen");
  AddDetail( ({ "blumen" }),
    "Die bunten Blumen sind hier wild gewachsen und bilden zusammen mit dem gruenen Gras einen "
    "bunten Teppich.");
  AddDetail( ({ "teppich" }),
    "Die gruene Wiese sieht mit den wilden Blumen zusammen aus wie ein bunter Teppich.");
  AddDetail( ({ "birken", "birke" }),
    "Die Birken stehen vereinzelt auf der Wiese herum. Ihre Blaetter leuchten in einem "
    "froehlich hellem Gruen und die weisse Rinde vermag Dich fasst schon zu blenden.");
  AddDetail( ({ "rinde" }),
    "Die weisse Rinde der Birken strahlt schon beinahe im hellen Licht der Sonne.");
  AddDetail( ({ "licht", "kraft" }),
    "Die Sonne strahlt heute mit all ihrer warmen Kraft auf diesen Birkenhain.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht vom blauen Himmel herunter und waermt Dich.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmlisch blau und eine sonnige Sonne laechelt auf Dich herunter.");
  AddDetail( ({ "ferne" }),
    "Weit weg.");
  AddDetail( ({ "gebirge", "auslaeufer" }),
    "Das Gebirge umgibt dieses Tal vollstaendig. Im Nordosten ist es sehr nah.");
  AddDetail( ({ "tal" }),
    "Du befindest Dich in einem bewaldeten Tal.");
  AddDetail( ({ "boden" }),
    "Unter Dir ist ein schmaler Weg in die Wiese getrampelt, ansonsten siehst Du nur Gras und "
    "Blumen.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt durch die Birken hindurch, und viel mehr als Birken und entferntes "
    "Gebirge siehst Du nicht.");
  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Die gruenen Blaetter der Birken wetteifern mit dem Gras darum wer im Licht der Sonne am "
    "strahlendsten erscheint.");
  AddDetail( ({ "gruen" }),
    "Das Gruen der Birkenblaetter ist etwas heller als das der Wiese.");
  AddDetail( ({ "bienchen" }),
    "Die Bienchen summen froehlich um Dich herum.");
  AddDetail( ({ "wald", "westen" }),
    "Du meinst im Westen einen dichten Wald zu sehen.");

  AddDetail( ({ "osten" }),
    "Im Osten ragt ziemlich nah eine Felswand vor Dir auf.");

  AddDetail( ({ "felswand" }),
    "Die Felswand liegt oestlich von Dir auf. Du erkennst eine Hoehle.");

  AddDetail( ({ "hoehle" }),
    "Du muesstest naeher hingehen, von hier aus siehst Du nicht viel.");

  AddDetail( ({ "richtungen" }),
    "Ausser nach Osten.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//  AddRoomMessage( 
  //  ({""}),30,"func");
  AddSound( DEFAULT_SOUND,
    "Es ist hier angenehm ruhig. Nur selten ruf ein Kaeuzchen und ab und an hoerst Du ein Rascheln.");

  AddSound( ({ "kaeuzchen","knacken","rascheln" }),
    "Die ist ein typisches Waldgeraeusch.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald.");

  AddSmell( ({ "wald" }),
    "Du riechts Moose, Baueme und faulige Blaetter.");
  AddSmell( ({ "moose","moos","baeume","baum","blaetter","blatt" }),
    "Du riechst nur typische Waldgerueche.");
  AddSmell( ({ "" }),
    "");

 //AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_7d.lpc");
 //AddExit( "suedwesten",  "/d/andracia/yondala/tal/birkenhain/room/birkenhainkreuz_2.lpc" ); 
 
 
 
   AddSpecialExit("suedwesten","suedwestengeher");
   
 AddItem(LABY_NPC + "aristocal.lpc",REFRESH_DESTRUCT);
 AddGuardedExit("osten", LABY_ROOM+"hoehlenlabyrinth_7d.lpc", "aristocal",
                "Aristocal sagt: Dort duerft Ihr nur hinein, wenn Ihr mir Eure Hilfe anbietet!\n"); 

 }

int suedwestengeher(string dir)
{
	if(!present("\nlabyrinthquestitem",TP))
	return TP->move("/d/andracia/yondala/tal/birkenhain/room/birkenhainkreuz_2.lpc", M_GO,0,
	                "geht nach Suedwesten","nach Suedwesten");
	
	if(present("aristocal",TO))
	{
		write("Aristocal haelt Dich auf.\nAristocal sagt: Ihr muesst die Quest beenden, eh Ihr dieses Gebiet verlasst.\n");
		say("Aristocal haelt "+TPN+" auf.\nAristocal sagt: Ihr muesst die Quest beenden, eh Ihr dieses Gebiet verlasst.\n",TP);

	}
	else
		write("Du musst erst die Quest beenden, eh Du dieses Gebiet verlassen kannst.\n");
	return 1;

}