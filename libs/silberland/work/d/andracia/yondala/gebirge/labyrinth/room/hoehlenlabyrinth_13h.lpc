// Hier kann man trinken und Knochenabnagen um sich zu stärken
// FP auf "trinke" und "trink"

#include "../def.h"
inherit "std/room";
#include <properties.h>



void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer kleinen Nische" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier in einer kleinen Nische, die von der Hoehle im Sueden "
    "abgeht. Es ist hier so dunkel, dass Du kaum etwas sehen kannst. Boden "
    "und Waende sind blutverschmiert, der Gestank ist kaum auszuhalten. Ein "
    "großer Berg von Knochen liegt vor Dir. Hier ist es sogar noch waermer "
    "als in der Hoehle." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Auf dem Boden tuermen sich Knochen, die teilweise blank genagt sind, teilweise aber noch "
    "Fleischreste tragen. Um die Knochen herum schimmert eine grosse Blutlache, in einer "
    "Ecke ist ein grosser Heuhaufen.");
  AddDetail( ({ "knochen" }),
    "Die meisten Knochen sind blank abgenagt, nur an wenigen befinden sich noch "
    "Fleischreste. Du siehst Knochen verschiedenster Lebewesen.");
  AddDetail( ({ "fleischreste","reste" }),
    "Wenn Du so etwas magst, kannst Du sicher noch ein bisschen an den Knochen nagen.");
  AddDetail( ({ "blutlache", "lache" }),
    "Du stehst beinahe drin, pass auf, dass Du nicht ausrutscht.");
  AddDetail( ({ "nische" }),
    "Du stehst hier in einer kleinen Nische, die von der Hoehle im Sueden "
    "abgeht. Es ist hier so dunkel, dass Du kaum etwas sehen kannst. Boden "
    "und Waende sind blutverschmiert, der Gestank ist kaum auszuhalten. Ein "
    "großer Berg von Knochen liegt vor Dir. Hier ist es sogar noch waermer "
    "als in der Hoehle.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus rauhem Fels und sind von tiefen Kratzern bedeckt. Ausserdem "
    "sind sie fast vollstaendig mit rotem Blut bedeckt.");
  AddDetail( ({ "blut", "spritzer","blutspritzer" }),
    "Das Blut scheint relativ frisch zu sein.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier relativ hoch, Du kannst sie nicht erreichen. Sie besteht aus "
    "blankem Fels, doch auch an ihr findest Du tiefe Kratzer. Wer auch immer sie verursacht hat, "
    "er ist entweder groesser als Du, oder er kann fliegen oder zumindest sehr hoch springen. "
    "Auch hier findet sich der ein oder andere Blutspritzer.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, aber warm und trocken. An den wenigen Stellen, die nicht von Blut "
    "besudelt sind schimmert er leicht graeulich, als wuerde er "
    "Licht reflektieren, jedoch nicht genug, um ohne Hilfsmittel sehen zu koennen.");
  AddDetail( ({ "hilfsmittel" }),
    "Du wirst schon wissen, welches Du benutzt.");
  AddDetail( ({ "kratzer" }),
    "Die Kratzer sind riesig. Welch Ungetuem die wohl verursacht hat?");
  AddDetail( ({ "ungetuem" }),
    "Dem moechtest Du wohl lieber nicht begegnen.");
  AddDetail( ({ "hoehle", "sueden" }),
    "Nach Sueden gelangst Du in die Hoehle zurueck.");
  AddDetail( ({ "licht" }),
    "Das gibts es hier eigentlich nicht. Du hast vermutlich welches mit gebracht, falls "
    "Du nicht im Dunkeln sehen kannst.");
  AddDetail( ({ "dunkeln" }),
    "Normalerweise ist es hier dunkel.");
  AddDetail( ({ "lebewesen" }),
    "Auch Knochen Deiner Rasse sind dabei.");
  AddDetail( ({ "rasse" }),
    "Du schuettelst Dich. Dem Ungetuem, dass hier gespeist hat moechtest Du nicht unbedingt "
    "begegnen.");
  AddDetail( ({ "berg" }),
    "Die Knochen tuermen sich zu einem unordentlichen Berg auf.");
  AddDetail( ({ "stellen" }),
    "Fast der komplette Fels in dieser Nische ist mir Blutspritzern bedeckt.");
  AddDetail( ({ "heuhaufen","haufen" }),
    "Der Heuhaufen sieht wie eine Schlafstaette aus.");
  AddDetail( ({ "schlafstaette" }),
    "Du vermutest, dass normalerweise jemand ziemlich großes dort schlaeft. Derzeit liegt "
    "dort aber niemand.");
  AddDetail( ({ "hinter haufen","hinter heuhaufen" }),
    "Hinter dem Heuhaufen ist ein kleines Becken, in dem sich Wasser gesammelt hat.");
  AddDetail( ({ "becken" }),
    "Das Becken besteht aus Fels und wurde vermutlich dereinst vom Wasser in ihn hinein gewaschen.");
  AddDetail( ({ "wasser" }),
    "Das Wasser sieht frisch und klar aus. Ob man es trinken kann?");
  AddDetail( ({ "ecke" }),
    "Dort siehst Du erstmal nichts, ausser dem grossen Heuhaufen.");
  AddDetail( ({ "luft" }),
    "Die Luft bewegt sich grundlos um Dich herum.");
  AddDetail( ({ "augen", "traenen" }),
    "Deine Augen traenen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Der Gestank hier ist kaum auszuhalten. Es stinkt nach Tod und Verwesung.");
  AddSmell( ({ "gestank" }),
    "Dir wird uebel.");
  AddSmell( ({ "tod" }),
    "Dich schauderts und Du nimmst Dir vor, nicht durch Deinem Tod zu dem Gestank beizutragen.");
  AddSmell( ({ "verwesung" }),
    "Die Knochen und die Fleischreste verwesen vor sich hin.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Du hoerst ein leises Scharren.\n",
    	"Ploetzlich bewegt sich die Luft.\n",
    	"Was war das?\n",
    	"Du fuehlst Dich beobachtet.\n",
    	"Der Gestank treibt Dir Traenen in die Augen\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Es ist hier fast totenstill, nur ein leises Tropfen stoert diese Stille hin und wieder.");

  AddSound( ({ "stille" }),
    "Es ist hier fast vollkommen still.");
  AddSound( ({ "tropfen" }),
    "Irgendwoher hoerst Du ein leises Tropfen, dass hin und wieder sogar zu einem Plaetschern "
    "anschwillt.");
  AddSound( ({ "plaetschern" }),
    "Es scheint aus der Ecke zu stammen. Vielleicht schaust Du mal hinter dem Heuhaufen?");
  AddSound( ({ "scharren" }),
    "Wer auch immer dieses Scharren verursacht scheint ganz in der Naehe zu sein.");
  AddSound( ({ "naehe" }),
    "In DEINER Naehe.");
  AddSound( ({ "" }),
    ".");


  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_14h.lpc");
  AddCmd( ({ "trinke", "trink" }), "trinken" );
  AddCmd( ({ "nage", "nag" }), "abnagen" );

 }

trinken(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	if(str=="wasser"||!str)
		{
			if (this_player()->drink_drink(2,0))
     		{
     			write ("Du kniest Dich hin und trinkst einen kleinen Schluck Wasser aus dem Becken.\n");
		  		say(TPN+" trinkt etwas Wasser aus dem Becken.\n",TP);
      		this_player()->AddHp(15);
      		this_player()->AddSp(10);
      		return 1;   
      		}
      }
    return 0;
}

abnagen(string str)
{
	notify_fail("Was moechtest Du abnagen?\n");
	if(str=="knochen"||str=="knochen ab")
		{
			if (this_player()->eat_food(10))
     		{
     			if(TP->id("Elfenspieler"))
     				{
     					write("Du nagst an dem Knochen. Pfui, das Fleisch macht Dich krank.\n");
     					TP->AddPoison(1);
     				}
     			else
     				{
     					write("Du nagst den Knochen ab. Hmm, schmeckt gar nicht so schlecht.\n");
     			    this_player()->AddHp(20);
      		    this_player()->AddSp(5);
      		  }
      				
		  		say(TPN+" nagt einen Knochen ab.\n",TP);
      		return 1;   
      		}
      }
    return 0;
}
