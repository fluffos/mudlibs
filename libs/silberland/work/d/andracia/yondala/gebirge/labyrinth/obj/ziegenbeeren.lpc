#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Drei Ziegenbeeren");
  SetProp(P_LONG,
    "du haelst drei kleine Ziegenbeeren in den Haenden." );
  SetProp(P_NAME, "Ziegenbeeren");
  SetProp(P_GENDER, FEMALE);
  AddId(({"beeren","ziegenbeeren","3ziegenbeeren","\nlabyloeschmich"}));
  SetProp( P_MATERIAL, MAT_FRUIT);
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);

}

