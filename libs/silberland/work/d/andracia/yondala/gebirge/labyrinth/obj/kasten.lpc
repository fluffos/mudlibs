
#include "../def.h"
inherit "std/thing";
#include <properties.h>

string a1;
string a2;
string a3;
string b1;
string b2;
string b3;
string c1;
string c2;
string c3;

//gibt ein Zufallszeichen aus.
string gibzeichen()
{
  int i;
  i=random(3);
  if(i==0) return "*";
  if(i==1) return "+";
  else return "o" ;
  
  }

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
a1=gibzeichen();
a2=gibzeichen();
a3=gibzeichen();
b1=gibzeichen();
b2=gibzeichen();
b3=gibzeichen();
c1=gibzeichen();
c2=gibzeichen();
c3=gibzeichen();
  SetProp(P_SHORT, "Ein seltsamer Kasten");
  SetProp(P_LONG,
    "Ein seltsamer Kasten steht hier rum. Auf seiner Oberflaeche sind mehrere Knoepfe und neun "
    "merkwuerdige Symbole sehen, ausserdem befindet sich an der Seite ein grosser Hebel. "
    "Der Kasten ist fest am Boden verankert, da hilft auch das staerkste Ruetteln nichts. "
    "Der Kasten leuchtet schwach, sodass Du ein wenig sehen kannst." );
  AddDetail( ({ "hebel" }),
    "Den kann man vermutlich ziehen.");
  AddDetail( ({ "knoepfe" }),
    "Die Knoepfe sind mit A, B, C, X, 1, 2 und 3 beschriftet.");
/*  AddDetail( ({ "oberflaeche" }),
    "(X) (A) (B) (C)\n"+
    "(1)  +   +   +\n"+
    "(2)  +   +   +\n"+
    "(3)  +   +   +");*/
  AddDetail( ({ "seite" }),
    "An der Seite ist ein grosser Hebel angebracht.");
  AddDetail( ({ "ruetteln" }),
    "Am Kasten zu ruetteln wird ihn nicht vom Boden loesen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddSpecialDetail( ({ "symbole" }), "symbole" );
  AddSpecialDetail( ({ "oberflaeche" }), "oberflaeche" );

/*
(X) (A) (B) (C)
(1)  +   +   +
(2)  +   +   +
(3)  +   +   +

*/

  SetProp(P_NAME, "Kasten");
  SetProp(P_GENDER, MALE);
  AddId(({"kasten"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 5000000);
  SetProp(P_NOGET, "Der Kasten ist im Boden verankert.\n");
  AddCmd(({"ziehe","zieh"}),"hebelziehen"); 
  AddCmd(({"drueck","druecke"}),"knopfdruecken"); 
  AddCmd(({"ruettel","ruettle"}),"ruetteln"); 
}

int ruetteln(string str)
{
  notify_fail("Woran moechtest Du ruetteln?\n");
  if (str=="an kasten"||str=="kasten"||str=="am kasten")
    {
      write("Du ruettelst wie verrueckt an dem Kasten.\n"+
            "Der Kasten summt kurz und die Symbole leuchten auf.\n");
      a1=gibzeichen();
      a2=gibzeichen();
      a3=gibzeichen();
      b1=gibzeichen();
      b2=gibzeichen();
      b3=gibzeichen();
      c1=gibzeichen();
      c2=gibzeichen();
      c3=gibzeichen();  
      return 1;
    }
return 0;

}       

//* + o
string symbolwechsler(string str)
{
  if(str=="*") return"+";
  if(str=="+") return"o";
  if(str=="o") return"*";
}
int knopfdruecken(string str)
{
  notify_fail("Welchen Knopf moechtest Du druecken?\n");
  
  
  if(str=="knopf a")
    {
      a1=symbolwechsler(a1);
      a2=symbolwechsler(a2);
      a3=symbolwechsler(a3);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
  if(str=="knopf b")
    {
      b1=symbolwechsler(b1);
      b2=symbolwechsler(b2);
      b3=symbolwechsler(b3);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
if(str=="knopf c")
    {
      c1=symbolwechsler(c1);
      c2=symbolwechsler(c2);
      c3=symbolwechsler(c3);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
if(str=="knopf 1")
    {
      a1=symbolwechsler(a1);
      b1=symbolwechsler(b1);
      c1=symbolwechsler(c1);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
if(str=="knopf 2")
    {
      a2=symbolwechsler(a2);
      b2=symbolwechsler(b2);
      c2=symbolwechsler(c2);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
if(str=="knopf 3")
    {
      a3=symbolwechsler(a3);
      b3=symbolwechsler(b3);
      c3=symbolwechsler(c3);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
if(str=="knopf x")
    {
      a1=symbolwechsler(a1);
      b2=symbolwechsler(b2);
      c3=symbolwechsler(c3);
      write("Du drueckst den Knopf und einige Symbole veraendern sich.\n");
      return 1;
    }
return 0;
  }   
    
    

    
string oberflaeche()
{
  return "\n (X) (A) (B) (C)\n"+
         " (1)  "+a1+"   "+a2+"   "+a3+"\n"+
         " (2)  "+b1+"   "+b2+"   "+b3+"\n"+
         " (3)  "+c1+"   "+c2+"   "+c3+"\n";
        }
 

string symbole()
{
  return "\n  "+a1+"   "+a2+"   "+a3+"\n"+
         "  "+b1+"   "+b2+"   "+b3+"\n"+
         "  "+c1+"   "+c2+"   "+c3+"\n";
 }

//gibt 1 zurueck, wenn alle gleich sind
int allegleich()
{
  if(a1==a2&&a1==a3&&   
     a1==b1&&a1==b2&&a1==b3&&   
     a1==c1&&a1==c2&&a1==c3)
     return 1;
  else return 0;
}         
        
int hebelziehen(string str)
{
  notify_fail("Was moechtest Du ziehen?\n");
  if(str!="hebel") return 0;
  
  if(!allegleich())
    {
      write("Du bekommst einen furchtbaren Stromschlag.\n");
      TP->do_damage(15,TO);
      return 1;
    }   
  if(environment(TO)->GetExits())
    {
      write("Du ziehst den Hebel, nichts passiert.\n");
      return 1;
    }
  write("Du ziehst den Hebel, ploetzlich schiebt sich eine Wand zur Seite und gibt einen Ausgang frei.\n");
  environment(TO)->ausgang();
}
    
    
    