//Die Funktionen fuer schuetten, halten und entfernen sowie der Ausgang sind nun in 
//hoehlenlabyrinth_19iundj vereinigt, war eh alles gleich

/*Raum B
Hier findet man:

Nordwand: winzige Tuer
Ostwand: Tisch, 
Suedwand: verschlossene Tuer
Westwand: Loch zum durchschuetten und durchspaehen

Auf dem Tisch:

	Zentrifuge
	Saftpresse

In der linken Schublade:
	1 Reagenzglas
In der rechten Schublade:
	Pfefferkoerner

*/	

#include "../def.h"
inherit LABY_ROOM+"hoehlenlabyrinth_19iundj";
#include <properties.h>

