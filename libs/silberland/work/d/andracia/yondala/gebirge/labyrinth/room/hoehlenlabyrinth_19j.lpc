 AddCmd( ({ "teste"}), "testen" ); 

  }
  
  
void testen()
{
	tell_room(TO,"File: "+file_name(TO)+"\n");
}


int beerensaftgiessen(string str)
{
	string was, dummy;
	notify_fail("Was moechtest Du worein giessen ?\n");
	if(!str) return 0;
    if (sscanf(str, "%s in %s", was, dummy) != 2) return 0;
	if(was!="saft"&&was!="beerensaft")
		return 0;
	if(dummy!="glas"&&dummy!="reagenzglas")
		return 0;
	if(!saft_in_presse)
		{
			write("In dem Faesschen ist derzeit nichts zum giessen.\n");
			return 1;
		}
	if(!present("\nlabyquestreagenzglas",TP))
		{
			write("Du hast nicht das passende Gefaess dabei.\n");
			return 1;
		}
	else
		{
		switch (present("\nlabyquestreagenzglas",TP)->status_geben())
		{
		
			case 0: 
				write("Der Saft sollte nicht als erstes in das Glas.\n");
				return 1;
				break;
/*     		case 1 .. 4:
				write("Du fuellst den Ziegenbeerensaft in das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;*/
			case 5:	
				write("Du fuellst den Ziegenbeerensaft in das Reagenzglas. Die Mixtur leuchtet kurz auf.\n");
				present("\nlabyquestreagenzglas",TP)->status_6();
				return 1;
				break;
			default:
				write("Du fuellst den Ziegenbeerensaft in das Reagenzglas. Der Inhalt verdirbt.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				break;
		}
		//anfangszustand();
		AddDetail( ({ "faesschen" }),
			"In dem Faesschen sammelt sich der Saft, wenn man mit der Saftpresse etwas presst.");
		AddDetail( ({ "sieb" }),
			"Das Sieb trennt den Saft von Trester.");
		AddDetail( ({ "saft" }),
			"Wenn Du Saft haben willst, solltest Du etwas pressen.");
		saft_in_presse=0;
		return 1;
	}
	
		
}
int beerenpressen(string str)
{
	notify_fail("Was moechtest Du pressen?\n");
	if(!str) return 0;	
	if(!present(str,TP))
	{
		write("So etwas hast Du nicht.\n");
		return 1;
	}
	if(str=="beeren"||str=="ziegenbeeren")
	{
		if (saft_in_presse)
		{
			write("In der Presse ist bereits Saft.\n");
			return 1;
		}
		write("Du steckst die Beeren in die Presse, drehst ein paar Mal an dem Gewinde und siehst den dunklen Saft in das Faesschen laufen.\n");
		present(str,TP)->remove();
		AddDetail( ({ "faesschen" }),
          "In dem Faesschen befindet sich etwas Saft.");
        AddDetail( ({ "saft" }),
			"Wenn Du diesen Saft haben willst, kannst Du ihn in ein Reagenzglas giessen.");
		saft_in_presse=1;
		return 1;
	}
		  
	write (capitalize(present(str,TP)->name(WEN)) +" zu pressen macht an dieser Stelle keinen Sinn.\n");
	return 1;
}



int zentrifugieren(string str)
{
	notify_fail("Was moechtest Du zentrifugieren?\n");
	if(!str) return 0;

	if(!present(str,TP))
	{
		write("So etwas besitzt Du nicht.\n");
		return 1;
	}
	if(str=="saft"||str=="rankensaft")
	{
		if(!present("\nlabyquestreagenzglas",TP))
		{
			write("Das ist der falsche Saft.\n");
			return 1;
		}
		else //glas ist da
		{
			if(present("\nlabyquestreagenzglas",TP)->status_geben()==2)
			{
				write("Du schuettest den Rankensaft in die Zentrifuge, drehst ein paar Mal an der Kurbel und entnimmst den zentrifugierten Saft wieder.\n");
				//present("/nlabyquestreagenzglas",TP)->status_2();
				//return 1;
			}
			else if(present("\nlabyquestreagenzglas",TP)->status_geben()==3)
			//{
				write("Dein Saft wurde schon zentrifugiert, nochmal ist nicht noetig.\n");
				//return 1;
			//}
			present("\nlabyquestreagenzglas",TP)->status_3();
			//return 1;
		}


		return 1;
	}
	else if(str=="mixtur")
	{
		if(!present("\nlabyquestreagenzglas",TP))
			write("Das ist die falsche Mixtur.\n");
		else //glas ist da
		{
			if(present("\nlabyquestreagenzglas",TP)->status_geben()==7)
			{				
				write("Du schuettest die Mixtur in die Zentrifuge, drehst ein paar Mal an der Kurbel und "+
					"entnimmst die zentrifugierte Mixtur wieder.\n");
				present("\nlabyquestreagenzglas",TP)->status_8();
				return 1;
			}
			else if(present("\nlabyquestreagenzglas",TP)->status_geben()==8)
				write("Die Mixtur wurde schon zentrifugiert, nochmal ist nicht noetig.\n");
			
			else
			{				
				write("Du schuettest die Mixtur in die Zentrifuge, drehst ein paar Mal an der Kurbel und "+
					"entnimmst die zentrifugierte Mixtur wieder.\nDie Mixtur ist verdorben.\n");
				present("\nlabyquestreagenzglas",TP)->status_1();
				
			}
		}
		return 1;
	}		
	
}


int drehen(string str)
{
	notify_fail("Was moechtest Du drehen?\n");
	if(str!="kurbel") return 0;
	
	write("Du drehst an der Kurbel, die Zentrifuge beginnt, sich im Inneren zu drehen.\n");
	return 1;
	
}	
int oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	
	if (str=="linke schublade")
	{
		write("Du oeffnest die linke Schublade.\n");
		if(present("pfefferkoerner",TP))
			write("Sie ist leer.\n");
		else
		{
			write("In der Schublade liegen einige Pfefferkoerner. Du nimmst sie an Dich.\n");
			CLONE(LABY_OBJ+"pfefferkoerner.lpc", TP);
		}
		write("Die Schublade schliesst sich wieder.\n");
		return 1;
	}
	
	if (str=="rechte schublade")
	{
		write("Du oeffnest die rechte Schublade.\n");
		if(present("\nlabyquestreagenzglas",TP))
			write("Sie ist leer.\n");
		else
		{
			write("In der Schublade liegt ein Reagenzglas. Du nimmst es an Dich.\n");
			CLONE(LABY_OBJ+"reagenzglas.lpc", TP);
		}
		write("Die Schublade schliesst sich wieder.\n");
		return 1;
	}	
	
	if(str=="deckel"||str=="zentrifuge")
	{
		write("Du oeffnest die Zentrifuge. Du siehst, dass im Inneren Platz ist fuer "+
			  "ein Reagenzglas.\nDeine Neugier ist befriedigt, Du schliesst die Zentrifuge wieder.\n");
		return 1;
	}
	
	if(str=="tuer")
	{
		write("Meinst Du die Nordtuer oder die Suedtuer?\n");
		return 1;
	}
	if(str=="nordtuer")
	{
		write("Die Nordtuer ist doch schon offen.\n");
		return 1;
	}
	if(str=="suedtuer")
	{
		write("Du ruettelst kraeftig an der Suedtuer. Leider bekommst Du sie nicht auf.\n");
		return 1;
	}
	
	return 0;
		
}