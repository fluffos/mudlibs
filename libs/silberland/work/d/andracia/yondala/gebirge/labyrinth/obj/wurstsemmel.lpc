inherit "/std/food";
#include <moredef.h>
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wurstsemmel");
  SetProp(P_LONG,
    "Du siehst eine koestliche frische Wurstsemmel die Du am liebsten gleich verspeisen moechtest." );
  SetProp(P_NAME, "Wurstsemmel");
  SetProp(P_GENDER, FEMALE);
  


SetProp(P_FOOD_INFO, ([	F_SOAK:10,
						F_HEAL:({10,10}), // erst HP, MP
						F_MSG: "Du verputzt die koestliche Wurstsemmel in wenigen Bissen. Sie schmeckt genial.", 
						F_MSG_ROOM: "verputzt eine koestliche Wurstsemmen in wenigen Bissen."]));


  AddId("semmel","wurstsemmel");

  SetProp(P_MATERIAL, ({MAT_BREAD, MAT_FLESH, MAT_MISC_SPICE}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 60);


 
}

