// Das Reich des Hopkigo
// Hier kann man sich nach unten abseilen, wenn man ein seil hat. Oder springen, 
// was aber ungesund ist (ausser fuer Feen)

#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier in einer schwach erhellten Hoehle. Nur schemenhaft erkennst Du Deine Umgebung. "
    "Der Boden ist mit Unrat bedeckt, Du kannst ihn kaum erkennen. Die Waende der Hoehle bestehen "
    "aus blankem Fels und sind voller tiefer Kratzer. Es ist recht warm hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
     "Der Gang fuehrt Dich aus der Hoehle heraus nach Sueden. Er verliert sich bald in "
     "der Dunkelheit. Da Du dort aber herkommst, weisst Du ja, was dort ist." );
  AddDetail( ({ "dunkelheit","ungewisses","ungewisse" }),
    "Du kannst nicht sehen, was Dich erwartet wenn Du den Gang zurueck gehst.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit allerlei Unrat bedeckt. Nach Westen hin faellt er steil ab, ein tiefes "
    "Loch tut sich vor Dir auf.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende kannst Du hier nicht erreichen, Du siehst aber, dass sie aus Fels bestehen "
    "und von tiefen Kratzern bedeckt sind.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier hoeher als in dem Gang, Du kannst sie nicht erreichen. Sie besteht aus "
    "blankem Fels, doch auch an ihr findest Du tiefe Kratzer. Wer auch immer sie verursacht hat, "
    "er ist entweder groesser als Du, oder er kann fliegen oder zumindest sehr hoch springen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, aber warm und trocken. Er schimmert leicht graeulich, als wuerde er "
    "Licht reflektieren.");
  AddDetail( ({ "kratzer" }),
    "Die Kratzer sind riesig. Welch Ungetuem die wohl verursacht hat?");
  AddDetail( ({ "ungetuem" }),
    "Dem moechtest Du wohl lieber nicht begegnen.");
  AddDetail( ({ "hoehle" }),
    "Im Norden weitet sich der Gang zu einer kleinen Hoehle.");
  AddDetail( ({ "umgebung" }),
   "Du stehst hier in einer schwach erhellten Hoehle. Nur schemenhaft erkennst Du Deine Umgebung. "
    "Der Boden ist mit Unrat bedeckt, Du kannst ihn kaum erkennen. Die Waende der Hoehle bestehen "
    "aus blankem Fels und sind voller tiefer Kratzer. Es ist recht warm hier.");
  AddDetail( ({ "sueden" }),
    "Der Gang verliert sich dort in der Dunkelheit.");
  AddDetail( ({ "licht" }),
    "Es ist irgendwie da, ohne einer echten Quelle zu entspringen. Ob es aus den Waenden selbst "
    "kommt?");
  AddDetail( ({ "quelle", "lichtquelle" }),
    "Du schaust Dich um, kannst aber keine Lichtquelle entdecken.");
  AddDetail( ({ "unrat" }),
    "Viele Aeste und Blaetter liegen auf dem Boden verstreut. Hin und wieder blitzt etwas "
    "Weisses dazwischen hervor.");
  AddDetail( ({ "aeste" }),
    "Einige kleine Aeste luken zwischen den Blaettern hervor.");
  AddDetail( ({ "blaetter" }),
    "Vermutlich hat der Wind die Blaetter hereingeweht.");
  AddDetail( ({ "wind" }),
    "Du denkst . o O (Der Wind? Aber der weht hier doch gar nicht!? Merkwuerdig.)");
  AddDetail( ({ "weisses" }),
    "Was das wohl ist? Du koenntest den Unrat durchwuehlen, um es herauszufinden.");
  AddDetail( ({ "knochen" }),
    "Die Knochen sind weiss und fleischlos, sie wirken wie abgenagt. Sie scheinen von vielen "
    "verschiedenen Lebewesen zu stammen.");
  AddDetail( ({ "lebewesen" }),
    "Auch Knochen Deiner Rasse sind dabei.");
  AddDetail( ({ "rasse" }),
    "Du schuettelst Dich. Dem Ungetuem, dass hier gespeist hat moechtest Du nicht unbedingt "
    "begegnen.");
  AddDetail( ({ "loch" }),
    "Es sieht sehr tief aus. Ob Du es wagen solltest hinunter zu klettern?");
  AddDetail( ({ "westen" }),
    "Im Westen ist ein tiefes Loch.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Den Geruch hier kannst Du nicht recht einschaetzen. Es riecht nach faulem Heu und "
    "Mundgeruch.");
  AddSmell( ({ "geruch" }),
    "Irgendwie ist der Geruch genauso undefinierbar wie unangenehm.");
  AddSmell( ({ "heu" }),
    "Nun gut, faules Heu ist sicher nicht sonderlich gefaehrlich. Aber schoen riechen tut es "
    "dennoch nicht.");
  AddSmell( ({ "mundgeruch" }),
    "Ja wirklich, es riecht hier wie der schlechte Atem eines Ungetuems.");
  AddSmell( ({ "atem", "atemschub","schub" }),
    "Hin und wieder wirbelt die Luft um Dich und bringt einen neuen, fuerchterlichen Atemschub "
    "an Dich heran.");
  AddSmell( ({ "ungetuem" }),
    "Das Ungetuem kannst Du nicht riechen. Nur seinen Atem, der ihm vorrauseilt.");


  AddRoomMessage( 
    ({"Du hoerst ein leises Scharren.\n",
    	"Ploetzlich bewegt sich die Luft.\n",
    	"Was war das?\n",
    	"Du fuehlst Dich beobachtet.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein leises Scharren und auch die Luft macht leise Geraeusche, "
    "wenn sie sich bewegt.");

  AddSound( ({ "scharren" }),
    "Wer auch immer dieses Scharren verursacht scheint ganz in der Naehe zu sein.");
  AddSound( ({ "naehe" }),
    "In DEINER Naehe.");
  AddSound( ({ "luft", "geraeusche" }),
    "Du hoerst die Luft an Dir vorbei rauschen.");
  AddSound( ({ "platsch", "platschen", "tropfen" }),
    "Irgendwo tropft es, leider siehst Du nicht wo.");
  AddSound( ({ "ohren" }),
    "Deine Ohren klingen normal. Wie Ohren.");
  AddSound( ({ "" }),
    ".");


  AddExit("osten", LABY_ROOM+"hoehlenlabyrinth_16h.lpc");
  AddExit("nordosten", LABY_ROOM+"hoehlenlabyrinth_15h.lpc");

  AddCmd( ({ "durchwuehle", "durchwuehl"}), "durchwuehlen" );
  AddCmd( ({ "kletter", "klettere"}), "klettern" );
  AddCmd( ({ "seile", "seil"}), "abseilen" );
  AddCmd( ({ "springe", "spring"}), "runterspringen" );

 }

int durchwuehlen(string str)
{
	notify_fail("Was moechtest Du durchwuehlen?\n");
	if(str!="unrat"&&str!="blaetter") return 0;
	
	write("Du wuehlst in den Blaettern herum und stellst fest, dass es sich bei dem Weissen um "
	"Knochen handelt.\n");
	say(TPN+" durchwuehlt die Blaetter auf dem Boden.\n",TP);
	return 1;
}
	
int klettern(string str)
{
	notify_fail("Wohin moechtest Du klettern?\n");
	if(str!="in loch"&&str!="runter"&&str!="herunter"&&str!="nach unten"&&str!="hinunter") return 0;
	
	write("Das Loch ist zu glatt, Du kannst Dich kaum irgendwo festhalten. Es ist wohl das Beste, "+
	"wenn Du Dich mit einem Seil abseilst. Wenn Du mutig bist, kannst Du auch springen.\n");
	return 1;
}

int abseilen(string str)
{
	notify_fail("Wohin moechtest Du Dich abseilen?\n");
	if(str!="in loch ab "&&str!="ab"&&str!="nach unten ab") return 0;
	if(!present("seil",TP))
		{
			write("Du hast kein Seil dabei. Entweder besorgst Du Dir eins, oder Du springst einfach "
			"so in dieses Loch mit unbekannter Tiefe.\n");
		  return 1;
		}
	write("Muehevoll seilst Du Dich nach unten ab. Bald schon stehst Du auf festem Fels. Gut, dass "+
	"Du nicht gesprungen bist, das haette sicher weh getan.\n");
	say(TPN+" seilt sich durch das Loch nach unten ab.\n");
	TP->move(LABY_ROOM + "hoehlenlabyrinth_16f", M_GO, "");
	return 1;
}

int runterspringen(string str)
{
	notify_fail("Wohin moechtest Du springen?\n");
	if(str!="in loch"&&str!="runter"&&str!="herunter"&&str!="nach unten"&&str!="hinunter") return 0;
  write("Todesmutig nimmst Du Anlauf und springst in das Loch.\n");
  say(TPN+" nimmt Anlauf und springt todesmutig in das Loch.\n",TP);
	TP->move(LABY_ROOM + "hoehlenlabyrinth_16f", M_GO, "");
//Feen koennen unbeschadet nach unten flattern
	if(TP->QueryProp(P_RACE)!="fee")	
		{
			if(call_other(LABY_ROOM + "hoehlenlabyrinth_16f","matratzeda",0))
				{
					write("Du plumst auf eine dicke Matratze. Glueck gehabt, dass die "+
					"dort lag.\n");
					tell_room(to_object(LABY_ROOM + "hoehlenlabyrinth_16f"),
						TPN+" faellt von oben herunter und plummst auf die Matratze.\n",({TP}));
					}	 
			else
				{
					write("Du knallst hart auf die Felsen.\n");
					TP->AddHp(-(50+random(50)));
					tell_room(to_object(LABY_ROOM + "hoehlenlabyrinth_16f"),
						TPN+" knallt hart auf die Felsen.\n",({TP}));
					}
						
		}
	else 
		{
			write("Du flatterst nach unten.\n");
			tell_room(to_object(LABY_ROOM + "hoehlenlabyrinth_16f"),
						TPN+" kommt nach unten geflattert.\n",({TP}));
					}
	return 1;

}


  