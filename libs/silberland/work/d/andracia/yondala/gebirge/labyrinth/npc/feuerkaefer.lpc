//Einfach ein Feuerkaefer


inherit "std/mnpc";
#include <language.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition für Kürzel
#include <mnpc.h>

inherit "/std/npc/spells.lpc";

void init()
{
}

	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "yondalas_antworten");
  
  SetProp(P_SHORT, "Ein Feuerkaefer");
  SetProp(P_LONG,
    "Du siehst einen kleinen Feuerkaefer, der hier aufgeregt herumwuselt. Sein Panzer leuchtet "
    "feuerrot, seine kurzen, schwarzen Beine scheinen nie stillzustehen und seine dunklen "
    "Augen sowie Fuehler sind auf Dich gerichtet.");

  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");


  SetProp(P_NAME, "Feuerkaefer");
  SetProp(P_GENDER, MALE);
  AddId(({"kaefer","feuerkaefer"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
  SetProp(P_LIGHT, 1);//erhellt den Raum

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit einem Feuerstrahl",QueryProp(P_HANDS)[1],DT_FIRE}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 300);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_AGGRESSIVE,0);

SetProp (P_MNPC_DEFAULTROOM, "/d/gebirge/yondala/labyrinth/room/hoehlenlabyrinth_15e.lpc");
//SetProp (P_MNPC_AREA, "/d" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  

  SetProp(P_MSGIN, "krabbelt herein"); //Meldung wenn der Raum betreten wird
  SetProp(P_MSGOUT, "krabbelt");//verlassen wird
  SetProp(P_MMSGIN, "krabbelt aus dem Boden");//wenn er in den Raum teleportiert wird
  SetProp(P_MMSGOUT, "krabbelt davon");//wenn er rausteleportiert wird

  SetProp(P_DIE_MSG,  " loest sich in Rauch auf.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Feuerkaefer");//name des tötenden npc
//  SetProp(P_KILL_MSG, "Das hab ich nicht erwartet...");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
    
  AddInfo(DEFAULT_INFO, "zischt\n");//Wenn der LABY_NPC keine Antwort hat

  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
        


  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");


SetChats(1, ({
   "Der Feuerkaefer blaesst eine kleine Stichflamme in Deine Richtung.\n",
   "Der Feuerkaefer verschwindet kurz in einer kleinen Feuerwolke.\n",
   "Der Feuerkaefer pustet einen Rauchring in die Luft.\n"}) );
//"/obj/gemmaster"->DistributeGem(amount, rand, art, automove, typ)

   if(random(2)) "/obj/gemmaster"->DistributeGem(1, 0, 1, TO, ({ "rubin","opal","onyx" }));

  CLONEME(LABY_OBJ+"feuerkaeferauge" );
if(random(2))CLONEME(LABY_OBJ+"feuerkaeferauge" );  
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
/*    case "neutral":
      call_out("reaction", 0, TP,
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      break;*/
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}




 	 	
 	 	