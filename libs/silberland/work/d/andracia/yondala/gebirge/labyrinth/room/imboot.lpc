int aufrichten(string str)
{
	notify_fail("Moechtest Du Dich aufrichten?\n");
	if(str!="auf")return 0;
	if(TP->QueryProp(P_NOMOVE)=="Du duckst Dich gerade und musst Dich erst aufrichten.\n")
		{
			TP->SetProp(P_NOMOVE,0);
			write("Du richtest Dich wieder auf.\n");
			say(TPN+" richtet sich auf.\n",TP);
	  }
	 
	 else
	 	write("Du duckst Dich doch grad gar nicht.\n");
	  return 1;
}
	

int ducken(string str)
{
	if(TP->QueryProp(P_NOMOVE)=="Du duckst Dich gerade und musst Dich erst aufrichten.\n")
		{
			write("Du duckst Dich doch schon.\n");
			return 1;
		}
	TP->SetProp(P_NOMOVE,"Du duckst Dich gerade und musst Dich erst aufrichten.\n");
	write("Du duckst Dich.\n");
	say(TPN+" duckt sich.\n",TP);
	return 1;
}




void nicht_rechts_gepaddelt()
{
	tell_room(TO, "Das Boot kracht gegen die linke Felswand.\nDu knallst gegen die Reling und stoesst Dich stark.\n");
	aua(spieler1);
	aua(spieler2);
}


void nicht_links_gepaddelt()
{
	tell_room(TO, "Das Boot kracht gegen die rechte Felswand.\nDu knallst gegen die Reling und stoesst Dich stark.\n");
	aua(spieler1);
	aua(spieler2);
}


void nicht_geduckt2(object spieler)
{
	if(spieler->QueryProp(P_NOMOVE)!="Du duckst Dich gerade und musst Dich erst aufrichten.\n")
	{
		tell_object(spieler, "Du knallst mit voller Wucht gegen den Baumstamm.\n");
		tell_room(TO, spieler->name()+" knallt mit dem Kopf gegen den Baumstamm.\n", ({spieler}));
		aua(spieler);
	}
	else 
	{
		tell_object(spieler, "Haarscharf duckst Du Dich unter dem Stamm durch. "+
			"Das war knapp.\nErleichtert richtest Du Dich wieder auf.\n");
		tell_room(TO, spieler->name()+" duckt sich unter dem Baumstamm durch.\n", ({spieler}));	
	    spieler->SetProp(P_NOMOVE,0);
		richtiggemacht(spieler);
	}

}


void nicht_geduckt()
{
	nicht_geduckt2(spieler1);
	nicht_geduckt2(spieler2);
}



int paddeln(string str)
{
	notify_fail("Moechtest Du nach rechts oder links paddeln?\n");
	if(str=="nach rechts"||str=="rechts")
		{
			if(present("paddel",TP))
				{
					if(TP->QueryProp(P_NOMOVE))
					{
						write(TP->QueryProp(P_NOMOVE));
						return 1;
					}
					write("Du tauchst das Paddel an der rechten Seite ins Wasser und ziehst es durch.\n");
					say(TPN+ " paddelt an der rechten Seite.\n",TP);
					if (find_call_out("nicht_rechts_gepaddelt")>=0)
					{
						remove_call_out("nicht_rechts_gepaddelt");
						richtiggemacht(TP);
					}
					else
					{
						write("Du steuerst das Boot gegen die Felswand.\n");
						say(TPN+" steuert das Boot gegen die Felswand.\n",TP);
						tell_room(TO, "Du knallst gegen die Reling und stoesst Dich stark.\n");
						aua(spieler1);
						aua(spieler2);
						
					}
				}
		    else write("Du hast kein Paddel.\n");

			return 1;
		}
	if(str=="nach links"||str=="links")
		{
			if(present("paddel",TP))
				{
					if(TP->QueryProp(P_NOMOVE))
					{
						write(TP->QueryProp(P_NOMOVE));
						return 1;
					}
					write("Du tauchst das Paddel an der linken Seite ins Wasser und ziehst es durch.\n");
					say(TPN+ " paddelt an der linken Seite.\n",TP);
					if (find_call_out("nicht_links_gepaddelt")>=0)
						{
							remove_call_out("nicht_links_gepaddelt");
							richtiggemacht(TP);
						}
					else
						{
						write("Du steuerst das Boot gegen die Felswand.\n");
						say(TPN+" steuert das Boot gegen die Felswand.\n",TP);
						tell_room(TO, "Du knallst gegen die Reling und stoesst Dich stark.\n");
						aua(spieler1);
						aua(spieler2);
						}
				}
				
				else write("Du hast kein Paddel.\n");

			return 1;
		}
		return 0;
}


void bootaktion2(object spieler)
{
			tell_object(spieler, "Du knallst mit dem Kopf gegen die Reling.\n");
			tell_room(TO, spieler->name()+" knallt mit dem Kopf gegen die Reling.\n",({spieler}));
			spieler->AddHp(-random(6));
			spieler->SetProp(P_PARALYZED, ([
			PARALYZE_TIME: (naechsteschikane),
			PARALYZE_MSG: "Dir droeht der Schaedel, Du musst erst zu Dir kommen.\n",
			PARALYZE_MSG_OTHER: spieler->name()+" bewegt sich stoehnen\n",
			PARALYZE_END: "Du kommst langsam zu Dir.\nStoehnend reibst Du Dir den Schaedel.\n",
			PARALYZE_END_OTHER: spieler->name()+" kommt langsam zu sich.\n"]));	
}
void bootaktion(int nummer)
{
	if(nummer==2)
		{
			if (random(2)) bootaktion2(spieler1);
			else bootaktion2(spieler2);
		}
}


int klettern(string str)
{
	notify_fail("Wohin moechtest Du klettern?\n");
	if(str=="aus boot"||str=="aus boot raus"||str=="aus boot heraus"||str=="raus"||str=="hinaus")
		{
			write("Du versuchst aus dem Boot zu klettern, aber das ist bei dem Geschaukel nicht moeglich.\n");
			say(TPN+" versucht aus dem Boot zu klettern.\n",TP);
			return 1;
		}
	return 0;
}
	


