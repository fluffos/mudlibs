void wasserfall11()
{
	object *alle;
	int i;
	tell_room(TO,"Das Boot knallt auf den Boden auf und zerspringt in Tausend Teile.\n");
 	alle=all_inventory(TO);
	for(i=sizeof(alle)-1;i>=0;i--)
	  {
	  	alle[i]->SetProp(P_NOMOVE,0);
	  	alle[i]->AddHp(-100);
	  	alle[i]->move( LABY_ROOM + "birkenhainlaby_1.lpc", M_NOCHECK);
		alle[i]->SetProp(P_PARALYZED,0);
	     }

}



object isserspieler(object ding)//gibt Spieler zurueck
{if(ding->id("Interactive")) return ding;}


void init()
{
	if(TP->id("Interactive"))
	{
		if(spieler1&&spieler2)//es duerfen nur zwei Spieler da sein
		{
			tell_room(TO,"Hier stimmt was nicht, bitte informiere einen Magier!\n");
			if(find_call_out("wohingehts")) remove_call_out("wohingehts");
			::init();
			return;
		}
			
		if(!spieler1) spieler1=TP;
		else if(!spieler2) spieler2=TP;
		if(spieler1&&spieler2) call_out("losgehts",1);
	}

  ::init();

}


