int rumgepaddel; //wird immer weniger, man muss ne gewisse Dauer lang paddeln. Erstmal 25
int naechsteschikane;
object spieler1;
object spieler2;

object guckpaddel(object ding)
{if(ding->id("\npaddel")) return ding;}


void richtiggemacht(object spieler)
{
	if(!present("\nrichtiggemacht",spieler)) CLONE(LABY_OBJ + "richtiggemacht.lpc",spieler);
	present("\nrichtiggemacht",spieler)->pluspunkt();
}

void aua(object spieler)
{
	int i;
	i=random(10)+10;
	spieler->AddHp(-i);

/*	if(spieler->QueryProp(P_HP)>=10)
	{
		if(spieler->QueryProp(P_PARALYZED)) return;
		spieler->SetProp(P_PARALYZED, ([
		PARALYZE_TIME: (naechsteschikane/2),
		PARALYZE_MSG: "Du bist von dem Geschuettel auf dem Boot ganz benommen.\n",
		PARALYZE_MSG_OTHER: spieler->name(WESSEN)+" Bewegungen sind unkoordiniert.\n",
		PARALYZE_END: "Du kommst wieder zu Dir.\n",
		PARALYZE_END_OTHER: spieler->name()+" kommt wieder zu sich.\n"]));
	}
	else spieler->SetProp(P_PARALYZED, 0);*/
}


void anfangszustand()
{//muessen exakt zwei dasein

	object *paddel;
	int i;
	if(!present("\npaddel",TO))
		{
			 AddItem(LABY_OBJ+"paddel.lpc",REFRESH_REMOVE);
			 AddItem(LABY_OBJ+"paddel.lpc",REFRESH_REMOVE);
			}
	if(!present("\nlabyfloete",TO)) AddItem(LABY_OBJ+"labyfloete.lpc",REFRESH_REMOVE);
	
	paddel=all_inventory(TO);
	paddel=filter_array(paddel, "guckpaddel");
	if(sizeof(paddel)==1)
		{
			 AddItem(LABY_OBJ+"paddel.lpc",REFRESH_REMOVE);
		}
	else if(sizeof(paddel)>2)//wenn zuviele Paddel da sind, loesche eines und prüfe nochmal
		{
			present("\npaddel",TO)->remove();
			anfangszustand();
		}
 
 //Einstellungen
  rumgepaddel=20; //+random(10);
  SetProp( P_INT_LONG,
    "Du kauerst in einem kleinen Boot. Die Wellen werfen Dich hin und her. Gut, dass es "
    "an einem Holzpflock festgebunden ist. Wer weiss, wo Du sonst hingespuelt werden wuerdest?" );
		
	 AddDetail( ({ "holzpflock" }),
    "An dem Holzpflock ist das Boot festgemacht. Hoffentlich haelt das Seil.");
   AddDetail( ({ "seil" }),
    "Ein duennes Seil haelt das Boot an dem Holzpflock fest.");	
   AddDetail( ({ "bergwaende","waende" }),
    "Die Schlucht, in der sich das Boot befindet, wird durch hohe Bergwaende umrahmt.");
   AddDetail( ({ "schlucht" }),
    "Das Boot befindet sich in einer Schlucht.");
	}



void losgehts()
{
	tell_room(TO,"Ploetzlich reisst sich das kleine Boot los und wird sofort von den Wellen mitgerissen.\n");
  call_other(LABY_ROOM + "hoehlenlabyrinth_26f", "anfangszustand",0);
  
  SetProp( P_INT_LONG,
    "Du kauerst in einem kleinen Boot. Die Wellen werfen Dich hin und her und reissen das "
    "Boot mit atemberaubender Geschwindigkeit mit sich." );
  RemoveDetail( "holzpflock");
  AddDetail( ({ "seil" }),
    "Das duenne Seil baumelt am Boot. Es ist gerissen und zu nichts mehr zu gebrauchen."); 
 AddDetail( ({ "bergwaende","waende" }),
    "Die Schlucht, durch die das Boot rast, wird durch hohe Bergwaende umrahmt.");
 AddDetail( ({ "schlucht" }),
    "Das Boot rast durch eine Schlucht.");	
 call_out("wohingehts",naechsteschikane/2);


}


void wohingehts()
{
	int waspassiert;
	waspassiert=random(11);
	if(waspassiert==10)
		{
			tell_room(TO,"Du siehst einen Baumstamm, der quer ueber die Schlucht liegt. Ihr fahrt "+
			             "rasend schnell auf ihn zu.\nDu solltest Dich besser ducken.\n");
			call_out("nicht_geduckt",naechsteschikane-1);
		}
	else if(waspassiert>=5)
		{
			tell_room(TO,"Vor Euch liegt eine scharfe Rechtskurve, Ihr solltet schnell links paddeln!\n");
			call_out("nicht_links_gepaddelt",naechsteschikane-1);
		}			
	else
		{
			tell_room(TO,"Vor Euch liegt eine scharfe Linkskurve, Ihr solltet schnell rechts paddeln!\n");
			call_out("nicht_rechts_gepaddelt",naechsteschikane-1);
		}			



  rumgepaddel--;
  if(rumgepaddel<=0) call_out("wasserfall1",4);//um das Ende einzuleiten
  else call_out("wohingehts",naechsteschikane);

}

