// Das Reich des Hopkigo

#include "../def.h"
inherit "std/room";
#include <properties.h>



void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  
  SetProp( P_INT_LONG,
    "Du stehst hier in einer schwach erhellten Hoehle. Nur schemenhaft erkennst Du Deine Umgebung. "
    "Der Boden ist mit Unrat bedeckt, Du kannst ihn kaum erkennen. Die Waende der Hoehle bestehen "
    "aus blankem Fels und sind voller tiefer Kratzer. Es ist recht warm hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Vom Boden selbst siehst Du nicht viel, er ist mit allerlei Unrat bedeckt.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus rauem Fels und sind von tiefen Kratzern bedeckt.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier relativ hoch, Du kannst sie nicht erreichen. Sie besteht aus "
    "blankem Fels, doch auch an ihr findest Du tiefe Kratzer. Wer auch immer sie verursacht hat, "
    "er ist entweder groesser als Du, oder er kann fliegen oder zumindest sehr hoch springen.");
  AddDetail( ({ "fels" }),
    "Der Fels ist hart, aber warm und trocken. Er schimmert leicht graeulich, als wuerde er "
    "Licht reflektieren.");
  AddDetail( ({ "kratzer" }),
    "Die Kratzer sind riesig. Welch Ungetuem die wohl verursacht hat?");
  AddDetail( ({ "ungetuem" }),
    "Dem moechtest Du wohl lieber nicht begegnen.");
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer kleinen, schwach erleuchteten Hoehle.");
  AddDetail( ({ "umgebung" }),
   "Du stehst hier in einer schwach erhellten Hoehle. Nur schemenhaft erkennst Du Deine Umgebung. "
    "Der Boden ist mit Unrat bedeckt, Du kannst ihn kaum erkennen. Die Waende der Hoehle bestehen "
    "aus blankem Fels und sind voller tiefer Kratzer. Es ist recht warm hier.");
  AddDetail( ({ "sueden" }),
    "Der Gang verliert sich dort in der Dunkelheit.");
  AddDetail( ({ "licht" }),
    "Es ist irgendwie da, ohne einer echten Quelle zu entspringen. Ob es aus den Waenden selbst "
    "kommt?");
  AddDetail( ({ "quelle", "lichtquelle" }),
    "Du schaust Dich um, kannst aber keine Lichtquelle entdecken.");
  AddDetail( ({ "unrat" }),
    "Viele Aeste und Blaetter liegen auf dem Boden verstreut. Hin und wieder blitzt etwas "
    "Weisses dazwischen hervor.");
  AddDetail( ({ "aeste" }),
    "Einige kleine Aeste luken zwischen den Blaettern hervor.");
  AddDetail( ({ "blaetter" }),
    "Vermutlich hat der Wind die Blaetter hereingeweht.");
  AddDetail( ({ "wind" }),
    "Du denkst . o O (Der Wind? Aber der weht hier doch gar nicht!? Merkwuerdig.)");
  AddDetail( ({ "weisses" }),
    "Was das wohl ist? Du koenntest den Unrat durchwuehlen, um es herauszufinden.");
  AddDetail( ({ "knochen" }),
    "Die Knochen sind weiss und fleischlos, sie wirken wie abgenagt. Sie scheinen von vielen "
    "verschiedenen Lebewesen zu stammen.");
  AddDetail( ({ "lebewesen" }),
    "Auch Knochen Deiner Rasse sind dabei.");
  AddDetail( ({ "rasse" }),
    "Du schuettelst Dich. Dem Ungetuem, dass hier gespeist hat moechtest Du nicht unbedingt "
    "begegnen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");


  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Den Geruch hier kannst Du nicht recht einschaetzen. Es riecht nach faulem Heu und "
    "Mundgeruch.");
  AddSmell( ({ "geruch" }),
    "Irgendwie ist der Geruch genauso undefinierbar wie unangenehm.");
  AddSmell( ({ "heu" }),
    "Nun gut, faules Heu ist sicher nicht sonderlich gefaehrlich. Aber schoen riechen tut es "
    "dennoch nicht.");
  AddSmell( ({ "mundgeruch" }),
    "Ja wirklich, es riecht hier wie der schlechte Atem eines Ungetuems.");
  AddSmell( ({ "atem", "atemschub","schub" }),
    "Hin und wieder wirbelt die Luft um Dich und bringt einen neuen, fuerchterlichen Atemschub "
    "an Dich heran.");
  AddSmell( ({ "ungetuem" }),
    "Das Ungetuem kannst Du nicht riechen. Nur seinen Atem, der ihm vorrauseilt.");


  AddRoomMessage( 
    ({"Du hoerst ein leises Scharren.\n",
    	"Ploetzlich bewegt sich die Luft.\n",
    	"Was war das?\n",
    	"Du fuehlst Dich beobachtet.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein leises Scharren und auch die Luft macht leise Geraeusche, "
    "wenn sie sich bewegt.");

  AddSound( ({ "scharren" }),
    "Wer auch immer dieses Scharren verursacht scheint ganz in der Naehe zu sein.");
  AddSound( ({ "naehe" }),
    "In DEINER Naehe.");
  AddSound( ({ "luft", "geraeusche" }),
    "Du hoerst die Luft an Dir vorbei rauschen.");
  AddSound( ({ "platsch", "platschen", "tropfen" }),
    "Irgendwo tropft es, leider siehst Du nicht wo.");
  AddSound( ({ "ohren" }),
    "Deine Ohren klingen normal. Wie Ohren.");
  AddSound( ({ "" }),
    ".");


  AddExit("nordwesten", LABY_ROOM+"hoehlenlabyrinth_14h.lpc");
  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_16i.lpc");
  AddExit("westen", LABY_ROOM+"hoehlenlabyrinth_15h.lpc");
  AddExit("suedwesten", LABY_ROOM+"hoehlenlabyrinth_16h.lpc");

  AddCmd( ({ "durchwuehle", "durchwuehl"}), "durchwuehlen" );

 }

int durchwuehlen(string str)
{
	notify_fail("Was moechtest Du durchwuehlen?\n");
	if(str!="unrat"&&str!="blaetter") return 0;
	
	write("Du wuehlst in den Blaettern herum und stellst fest, dass es sich bei dem Weissen um "
	"Knochen handelt.\n");
	say(TPN+" durchwuehlt die Blaetter auf dem Boden.\n",TP);
	return 1;
}
	
