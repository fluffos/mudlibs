int fuettern(string str)
{
	string wen, womit;
	notify_fail("Wen moechtest Du womit fuettern?\n");
	if(!str) return 0;
    if (sscanf(str, "%s mit %s", wen, womit) != 2) return 0;
	if(!id(wen))return 0;
	if(!present(womit,TP))
	{
		write("So etwas hast Du nicht.\n");
		return 1;
	}
	if(womit!="feuerkaeferauge"&&womit!="kaeferauge"&&womit!="auge")
	{
		command("sag Ich mag "+present(womit,TP)->name(WEN)+ " nicht.");
		return 1;
	}
	if(InFight())
	{
		write("Das geht waehrend eines Kampfes nicht.\n");
		return 1;
	}
	//Da sollte er eigentlich nicht mehr existieren
	if(gefuetterteAugen<1)
	{
		write("Du versuchst den Zottelbaer mit dem Feuerkaeferauge zu fuettern.\nDer Zottelbaer lehnt ab.\n");
		say(TPN+" versucht, den Zottelbaer mit einem Feuerkaeferauge zu fuettern.\nDer Zottelbaer lehnt ab.\n",TP);
	    command("sag Puh, davon hatte ich heute genug.");
		return 1;
	}
		
	write("Du fuetterst den Zottelbaer mit dem Feuerkaeferauge.\nDer Zottelbaer schmatzt erfreut.\n");
	say(TPN+" fuettert den Zottelbaer mit einem Feuerkaeferauge.\nDer Zottelbaer schmatzt erfreut.\n",TP);
	//command("sag Puh, davon hatte ich heute genug.");
	present("feuerkaeferauge",TP)->move(TO);
	
	present("feuerkaeferauge",TO)->remove();
	gefuetterteAugen--;
//wenn er den Zauberstab hat, jetzt geben
    if(gefuetterteAugen<1)
	{
		say("Der Zottelbaer reibt sich den vollen Bauch.\n");
		command("sag Nun bin ich satt. Habt Dank.");
		write("Der Zottelbaer reicht Dir seinen Zauberstab als Dank.\n");
		say(TPN+" bekommt zum Dank vom Zottelbaer seinen Zauberstab gereicht.\n",TP);
		present("zauberstab",TO)->move(TP);
		TO->move("/players/yondala/room/muellhalde", M_GO, "davon");
		remove();
	}		
	
	return 1;
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand ängstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "zeigt mit dem Finger auf Dich und kichert.",// in Klammern kommt die Meldung die an den Spieler geht
        "zeigt mit dem Finger auf " +TPN+ " und kichert.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich pikiert an und ruempft die Nase.",
        "schaut " +TPN+ " pikiert an und ruempft die Nase.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "pfeift ein Liedchen.", 
        "pfeift ein Liedchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;
/*    case "neutral":
      call_out("reaction", 0, TP,
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
        "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      break;*/
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen, traurigen Augen an.",
        "schaut " +TPN+ " mit grossen, traurigen Augen an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}




 	 	
 	 	