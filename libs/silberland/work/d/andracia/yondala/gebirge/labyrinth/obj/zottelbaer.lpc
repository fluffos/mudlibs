ausgabe(string str)
{
	if (str=="test") return ("die ist ein test");
	return ("hilfe");
}


menge(string str)
{
	return("Heute moechte ich noch mindestens "+gefuetterteAugen+" Feuerkaeferaugen essen.");
}


void reset()
{
	if(gefuetterteAugen<32) gefuetterteAugen++;
::reset();
	
	}


