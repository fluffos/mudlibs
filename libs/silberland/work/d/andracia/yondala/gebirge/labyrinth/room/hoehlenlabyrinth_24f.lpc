
#include "../def.h"
inherit "std/room";
#include <properties.h>


void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einem Bergspalt" );

  SetProp( P_INT_LONG,
    "Du stehst in einem Bergspalt, rechts und links von Dir wachsen glatte Felswaende "
    "schier endlos in den blauen Himmel." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  

  AddDetail( ({ "felswand", "wand" }),
    "Die Felswaende bestehen, wie der Name schon sagt, aus Fels. Sie sind glatt und wachsen "
    "senkrecht in die Hoehe.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist leuchtend blau, hin und wieder siehst Du einen Vogel seine Kreise ziehen.");
  AddDetail( ({ "luft" }),
    "Du atmest ein paar mal tief ein und aus. Aaaaah, das tut gut!");
  AddDetail( ({ "boden" }),
    "Der Boden hier besteht aus Felsen und wird nach rechts und links eng durch die "
    "Waende des Felsspaltes begrenzt. Ein paar grosse Gesteinsbrocken liegen herum.");
  AddDetail( ({ "berg" }),
    "Du stehst quasi in dem Berg, denn der Spalt ist sehr tief, aber nur wenig breit. "
    "Hoffentlich kommt Dir niemand entgegen.");
  AddDetail( ({ "haare" }),
    "Deine Haare wehen im Wind.");
  AddDetail( ({ "wind" }),
    "Der Wind weht kraeftig durch die Kluft. Du kannst ihm lauschen.");
  AddDetail( ({ "vogel" }),
    "Scheint ein Geier zu sein.");
  AddDetail( ({ "aasgeier","geier" }),
    "Der wartet vermutlich darauf, dass Du abstuerzt.");
  AddDetail( ({ "windboe","boe", "windboen" }),
    "Die Windboen werfen Dich fast um.");
  AddDetail( ({ "baum", "stamm", "baumstamm" }),
    "Den Baum hat vermutlich jemand abgesaegt um ueber den Abgrund gelangen zu koennen. Wie praktisch.");
 AddDetail( ({ "fels" }),
    "Der Fels ist grau, relativ glatt und kuehl.");
 AddDetail( ({ "weg" }),
    "Der Weg fuehrt zwischen den Felswaenden nach Suedosten.");
 AddDetail( ({ "waende","felswaende" }),
    "Die Felswaende stehen zwar recht eng beieinander, aber da passt Du locker durch.");
 AddDetail( ({ "kreise" }),
    "Der Vogel fliegt in ebenmaessigen Kreisen durch die Luft.");
 AddDetail( ({ "spalt", "felsspalt", "bergspalt"  }),
    "Der Berg ist gespalten und in diesem Spalt stehst Du.");
 AddDetail( ({ "brocken","gesteinsbrocken" }),
    "Die Gesteinsbrocken sehen so aus, als seien sie von oben herunter gefallen. Ob man hier "
    "auf Steinschlag achten muss?");
 AddDetail( ({ "steinschlag" }),
    "Vielleicht solltest Du moeglichst wenig Laerm machen und schnell weitergehen?!");
 AddDetail( ({ "laerm" }),
    "Den vermeidest Du besser.");
 AddDetail( ({ "stein" }),
    "Er hat Dich nur knapp verfehlt. Hoffentlich kommt da nicht noch mehr.");
 AddDetail( ({ "" }),
    "");
 AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist etwas abgestanden, kein Lueftchen regt sich.");
  AddSmell( ({ "luft","lueftchen" }),
    "Die Luft koennte besser sein, aber es ist ertraeglich.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");

//muessen mal noch welche
  AddRoomMessage( 
    ({"Ein kleiner Stein faellt von oben runter.\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen.");

  AddSound( ({ "rauschen", "" }),
    "Was das wohl ist? Es kommt aus dem Sueden.");
  AddSound( ({ "sueden", "" }),
    "Ein leises Rauschen erreicht Dich aus dem Sueden.");





  AddExit("sueden", LABY_ROOM+"hoehlenlabyrinth_25f.lpc");
  AddExit("nordwesten", LABY_ROOM+"hoehlenlabyrinth_23e.lpc");
	
}




