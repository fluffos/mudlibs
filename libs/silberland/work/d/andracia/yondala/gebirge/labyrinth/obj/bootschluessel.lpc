


#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Du haelst einen kleinen, rostigen Schluessel in den Haenden. Wofuer der wohl ist?" );
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId(({"schluessel","\nbootschluessel"}));
  SetProp( P_MATERIAL, MAT_IRON);

  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
 
}
