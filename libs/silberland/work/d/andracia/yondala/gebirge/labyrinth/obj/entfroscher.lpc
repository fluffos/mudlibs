#include "../def.h"

inherit "std/thing";

#include <properties.h>


void entfroschen()
{
	object spieler;
	spieler=environment(TO);
	/*if(spieler->QueryProp(P_FROG))
	{
		tell_object(spieler,"Ploetzlich spuerst Du, wie Du anfaengst zu wachsen.\n");
		environment(TO)->SetProp(P_FROG, 0);
		tell_room(environment(spieler), spieler->name()+ " nimmt wieder "+spieler->QueryPossPronoun(FEMALE,WEN,SINGULAR)+ " normale Form an.\n",({spieler}));
	}
	*/
	
	
	if(environment(TO)->QueryProp(P_FROG))
	{
		tell_object(environment(TO),"Ploetzlich spuerst Du, wie Du anfaengst zu wachsen.\n");
		environment(TO)->SetProp(P_FROG, 0);
		tell_room(environment(environment(TO)),environment(TO)->name()+ " nimmt wieder "+environment(TO)->QueryPossPronoun(FEMALE,WEN,SINGULAR)+ " normale Form an.\n",({environment(TO)}));
		
	}
	
	remove();
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  call_out("entfroschen",180);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\nentfroscher"}));
  SetProp( P_MATERIAL, MAT_GLASS);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);  
 
 }

