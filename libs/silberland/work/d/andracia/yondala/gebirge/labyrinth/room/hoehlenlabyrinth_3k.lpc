// Hier faellt man quasi in ein Loch und kommt wieder nur mit Raeuberleiter raus
// der andere muss dann oben ein Seil freiforschen oder auch ein eigenes benutzen
// durchwuehle Unrat -> Schluessel
// eklig hier und kalt

// 18.11.24 BUGFIX: changed from "schluessel.lpc" to "bootschluessel.lpc" (Wraz)

#include "../def.h"
inherit "std/room";
#include <properties.h>

int seilda; //wird gesetzt, wenn von oben ein Seil herabgelassen wurde
int schluesselda;	
	
//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
	seilda=0;
	schluesselda=1;
  AddDetail( ({ "rand" }),
    "Der Rand des Lochs ist kreisrund und leider zu hoch, als dass Du ihn mit Strecken oder "
    "gar Springen erreichen koenntest. Allerdings haengt ein Seil von dort oben herunter.");
  RemoveDetail("seil");
}

void create() 
{
  ::create();
  seilda=0;
 	schluesselda=1;
 
  SetProp( P_INT_SHORT, "In einem finsteren Loch" );
  
  SetProp( P_INT_LONG,
    "Du stehst in einem finsteren Loch. Es ist so dunkel hier, dass Du so gut wie nichts "
    "erkennen kannst, ausser dem Rand des Lochs hoch ueber Dir und die dunklen Waende, die "
    "Dich umgeben. Es ist hier ziemlich kalt und es stinkt." );
  SetProp( P_LIGHT, -1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "loch" }),
    "Du steckst in einem engen, dunklen Loch fest.");
  AddDetail( ({ "rand" }),
    "Der Rand dest Lochs ist kreisrund und leider zu hoch, als dass Du ihn mit Strecken oder "
    "gar Springen erreichen koenntest.");
  AddDetail( ({ "strecken" }),
    "Es wird keinen Sinn machen, wenn Du Dich nach oben streckst. Es ist zu weit.");
  AddDetail( ({ "springen" }),
    "Selbst wenn Du noch so hoch springst, der Rand ist zu weit weg, als dass Du ihn ohne "
    "Hilfsmittel erreichen koenntest.");
  AddDetail( ({ "hilfsmittel" }),
    "Hm, was koennte das sein? Du braeuchtest dringend eine Idee.");
  AddDetail( ({ "idee" }),
    "Wie war das noch? Was muss man da machen?");
  AddDetail( ({ "sinn" }),
    "Es macht keinen Sinn, wirklich.");
  AddDetail( ({ "waende" }),
    "Die Waende, oder sagen wir: die eine Wand, weil ja rund, sind sehr glatt, es gibt nur "
    "wenige Bearbeitungsspuren, dieses Loch scheint natuerlichen Ursprungs zu sein.");
  AddDetail( ({ "bearbeitungsspuren","spuren" }),
    "Es sind keine da, weil niemand diese Wand bearbeitet hat.");
  AddDetail( ({ "wand" }),
    "Die eine Wand ist rund um Dich herum. Sie ist sehr glatt, es gibt nur "
    "wenige Bearbeitungsspuren, dieses Loch scheint natuerlichen Ursprungs zu sein.");
  AddDetail( ({ "ursprung" }),
    "Vielleicht hat sich dereinst Wasser durch die Felsen gefressen, oder eine grosse "
    "Luftblase wurde bei der Entstehung dieses Berges eingeschlossen. Man weiss es nicht. "
    "Und eigentlich ist das auch nicht so wichtig.");
  AddDetail( ({ "wasser" }),
    "Nun, fuer diese Theorie spricht zumindest, dass Deine Fuesse ziemlich feucht sind, seit "
    "Du hier in diesem Loch stehst. Allerdings kann man diese Bruehe wohl kaum als Wasser bezeichnen.");
  AddDetail( ({ "theorie", "theorien" }),
    "Zur Entstehung dieses Lochs hast Du zwei moegliche Theorien aufgestellt.");
  AddDetail( ({ "entstehung" }),
    "Alles ist irgendwann entstanden, sonst waere es nicht da.");
  AddDetail( ({ "luftblase","luft" }),
    "Vielleicht wurde eine saeulenfoermige Luftblase bei der Entstehung eingeschlossen, "
    "in dem erkalteten Fels gefangen und erst beim Bau des Ganges wieder freigelegt. ");
  AddDetail( ({ "fuesse" }),
    "Deine Fuesse sind feucht und kalt. Brrr, Du solltest machen, dass Du hier rauskommst.");
  AddDetail( ({ "decke" }),
    "Die ist so hoch ueber Dir, dass sie in der Dunkelheit verschwimmt.");
  AddDetail( ({ "dunkelheit" }),
    "Die Dunkelheit ist in diesem finsteren Loch allgegenwaertig.");
  AddDetail( ({ "bau" }),
    "Anhand der Bearbeitungsspuren stellst Du fest, dass der Gang, durch den Du gekommen bist "
    "nicht natuerlichen Ursprungs sein kann. Also wurde er wohl mal gebaut.");
  AddDetail( ({ "berg" }),
    "Du befindest Dich in einem Loch am Ende eines Ganges in einem Berg im grossen Gebirge "
    "Andracias.");
  AddDetail( ({ "gang" }),
    "Soweit Du Dich erinnerst bist Du durch einen Gang gengangen, bis Du dann ploetzlich "
    "in dieses Loch gefallen bist.");
  AddDetail( ({ "gebirge" }),
    "Der Berg in dem Du bist gehoert zu einem grossen Gebirge.");
  AddDetail( ({ "andracia" }),
    "Diese Welt, in der Du gerade bist, nennt sich Andracia.");
  AddDetail( ({ "welt" }),
    "Wenn Du nicht gerade in doofen Loechern festsitzt, ist diese Welt eigentlich ganz nett.");
  AddDetail( ({ "loecher" }),
    "In diese Richtung weiter zu forschen wird Dir nicht helfen. Denk lieber dran, dass Ihr "
    "nicht so viel Zeit habt, diese Quest zu loesen. Waere doch bloed, wenn Ihr von vorne "
    "anfangen muesstet.");
  AddDetail( ({ "richtung", "aufgabe" }),
    "Ich lenke Dich ja gerne von Deiner eigentlichen Aufgabe ab, aber nun sieh mal zu, dass "
    "Du hier rauskommst.");
  AddDetail( ({ "quest" }),
    "Du weisst schon, Aristocal helfen und so.");
  AddDetail( ({ "aristocal" }),
    "Der sitzt draussen im Sonnenschein und freut sich, weil er jemand dummes gefunden hat, der "
    "fuer ihn nun hier unten rumsitzt.");
  AddDetail( ({ "sonnenschein","sonne" }),
    "Du hast die Sonne schon sooo lange nicht gesehen. Du vermisst ihre Waerme.");
  AddDetail( ({ "waerme" }),
    "Die vermisst Du. Hier unten ists kalt und ungemuetlich.");
  AddDetail( ({ "fels" }),
    "Der Fels ist irgendwie feucht und strahlt eine Kaelte aus, die Dir bis auf die Knochen geht.");
  AddDetail( ({ "knochen" }),
    "Dir ist kalt und langsam meldet sich Dein Rheuma.");
  AddDetail( ({ "rheuma" }),
    "Tjaja, Du bist ganz schoen in die Jahre gekommen.");
  AddDetail( ({ "jahre" }),
    "Wer zu lange muddet wird alt und grau.");
  AddDetail( ({ "boden" }),
    "Du stehst bis zu den Knien in schmutzigem Wasser. Es ist irgendwie braun, stinkt abartig "
    "und kleine Broeckchen schwimmen auch noch in dieser ekligen Bruehe.");
  AddDetail( ({ "broeckchen" }),
    "Du moechtest nicht naeher darauf eingehen, was das wohl sein koennte. Ich auch nicht.");
  AddDetail( ({ "bruehe" }),
    "Die Bruehe ist ziemlich eklig und auch so dick und braun, dass Du den Grund nicht sehen kannst.");
  AddDetail( ({ "knie" }),
    "Deine Knie zittern ein wenig.");
  AddDetail( ({ "grund" }),
    "Nun, er scheint da zu sein, denn Deine Fuesse finden relativ festen Halt. Aber sehen kannst "
    "Du ihn nicht.");
  AddDetail( ({ "halt" }),
    "Trotz einiger kleiner Unebenheiten findest Du recht guten Halt. Die Gefahr auszurutschen "
    "ist wohl nicht sehr gross.");
  AddDetail( ({ "gefahr" }),
    "Na, solange Du nicht allzusehr rumhampelst sollte das mit dem Stehen schon klappen.");
  AddDetail( ({ "stehen" }),
    "Funktioniert normalerweise ganz prima bei Dir.");
  AddDetail( ({ "unebenheiten" }),
    "Im Wasser scheint ein bisschen Unrat zu sein. Nicht weiter wichtig.");
  AddDetail( ({ "unrat" }),
    "Du kannst ihn natuerlich durchwuehlen, wenn Du das moechtest. Aber, ob Dich das weiterbringt?");
  AddDetail( ({ "ende" }),
    "Der Gang ueber Dir hat mit diesem Loch ein apruptes Ende gefunden.");
  AddDetail( ({ "zeit" }),
    "Eure Zeit ist begrenzt. Viel bleibt Euch sicher nicht mehr.");
  AddDetail( ({ "kaelte" }),
    "Es ist so kalt, dass Du es bis auf Deine Knochen spueren kannst.");
  AddDetail( ({ "gefuehl" }),
    "Du fuehlst Dich unbehaglich.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach muffiger Feuchtigkeit und leichter Faeulnis.");
  AddSmell( ({ "feuchtigkeit", "faeulnis" }),
    "Wahrlich, es riecht nicht angenehm..");

  AddRoomMessage( 
    ({"Irgendwie fuehlst Du Dich leicht unwohl.\n",
    	"Du hast das Gefuehl, dass die Waende naeher ruecken.\n",
    	"Hat sich da etwas bewegt?\n",
    	"Irgendwo tropft etwas.\n"}),50,"func");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille. Ganz, ganz selten hoerst Du ein leises tropfen.");

  AddSound( ({ "tropfen" }),
    "Irgendwie scheint es von oben herunter zu tropfen?");
  AddSound( ({ "totenstille","stille" }),
    "Du hoerst kaum mehr als Deinen eigenen Atem.");
  AddSound( ({ "atem" }),
    "Du atmest stossweise ein und aus.");

 AddCmd( ({ "durchwuehle", "durchwuehl"}), "durchwuehlen" ); //Unrat durchwuehlen um den Schluessel zu finden
 AddCmd( ({ "springe", "spring"}), "springen" ); //sinnlos, nach oben springen
 AddCmd( ({ "strecke", "streck"}), "strecken" ); //sinnlos, sich nach oben strecken
 AddCmd( ({ "mache", "mach"}), "machen" ); //Raeuberleiter machen
 AddCmd( ({ "loese", "loes"}), "loesen" ); //Raeuberleiter loesen
 AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern
 AddCmd( ({ "steh", "stehe"}), "aufstehen" ); //wenn man umgefallen ist muss man aufstehen


}

void seilruntergelassen() //wird von 4j aufgerufen
{
	seilda=1;
	tell_room(TO,"Von oben laesst jemand ein Seil herunter.\n");
  AddDetail( ({ "rand" }),
    "Der Rand dest Lochs ist kreisrund und leider zu hoch, als dass Du ihn mit Strecken oder "
    "gar Springen erreichen koenntest. Allerdings haengt ein Seil von Dort oben herunter.");
  AddDetail( ({ "seil" }),
    "Das Seil haengt ueber den Rand des Lochs herunter. Du kannst daran bestimmt nach oben"
    "klettern.");
	}

void seilweg() //wird von 4j aufgerufen
{
	seilda=0;
	tell_room(TO,"Das Seil wird wieder nach oben gezogen.\n");
  AddDetail( ({ "rand" }),
    "Der Rand des Lochs ist kreisrund und leider zu hoch, als dass Du ihn mit Strecken oder "
    "gar Springen erreichen koenntest.");
  RemoveDetail("seil");


	}


int durchwuehlen(string str)
{
	notify_fail("Was moechtest Du durchwuehlen?\n");
	if (str!="unrat") return 0;
	
	if(schluesselda)
		{
			write("Du wuehlst im Unrat herum und haelst ploetzlich etwas in den Haenden.\n");
					say(TPN+" durchwuehlt den Unrat und findet etwas.\n");
					//clonen
					CLONE(LABY_OBJ +"bootschluessel.lpc", TP);
					schluesselda=0;
					return 1;
				
			}
	write("Du wuehlst ein bisschen im Unrat herum, findest aber nichts.\n");
  say(TPN+" durchwuehlt den Unrat.\n");
  return 1;
}	


int strecken (string str)
{
	notify_fail("Wohin moechtest Du Dich strecken?\n");
	if(str!="hoch"&&str!="nach oben") return 0;
	
	write("Du reckst und streckst Dich, kommst aber nichtmal in die Naehe des Rands.\n");
	say(TPN+" streckt sich nach oben, kann den Rand aber nicht erreichen.\n",TP);
	return 1;
}

int springen (string str)
{
	notify_fail("Wohin moechtest Du springen?\n");
	if(str!="hoch"&&str!="nach oben") return 0;
	
	write("Du gehst in die Hocke und springst so hoch Du kannst. Leider reicht es nicht.\n"+
	"Dafuer ratscht Du Dir Dein Kinn an der Wand auf.\nAutsch.\n");
	TP->AddHp(-5);
	say(TPN+" geht in die Hocke und springt hoch, schafft es aber nicht den Rand zu erreichen.\n",TP);
	return 1;
}





int machen(string str)
{
	notify_fail("Was moechtest Du machen?\n");
	if(str=="raeuberleiter")
		{
			if(TP->QueryProp(P_NOMOVE)!="Du musst erst die Raeuberleiter loesen.\n")
				{
					write("Du faltest Deine Haende und bildest damit eine Raeuberleiter.\n");
					say(TPN+" faltet "+TP->QueryPossPronoun(FEMALE, WEN,PLURAL)+" Haende zu einer Raeuberleiter\n",TP);
					TP->SetProp(P_NOMOVE,"Du musst erst die Raeuberleiter loesen.\n");
					return 1;
				}
			//wenn er also schon Raeuberleiter macht
			write("Du machst doch schon eine Raeuberleiter.\n");
			return 1;
		}
	}

int loesen (string str)
{
	notify_fail("Was moechtest Du loesen?\n");
	if(str=="raeuberleiter"||str=="haende"||str=="leiter")
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst die Raeuberleiter loesen.\n")
				{
					write("Du loest Deine Haende aus der Raeuberleiter.\n");
					say(TPN+" loest "+TP->QueryPossPronoun(FEMALE, WEN,PLURAL)+" aus der Raeuberleiter\n",TP);
					TP->SetProp(P_NOMOVE,0);
					return 1;
				}
			//wenn er grad keine Raeuberleiter macht
			write("Du machst doch gar keine Raeuberleiter.\n");
			return 1;
		}
	}
	
int aufstehen(string str)
{
	object anderer;
	notify_fail("Moechtest Du vielleicht aufstehen?\n");
	if (str=="auf"||!str)
		{
			if(TP->QueryProp(P_NOMOVE)=="Du musst erst aufstehen.\n")
				{
					TP->SetProp(P_NOMOVE,0);
					anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
					anderer->SetProp(P_PARALYZED,0);
					//kein write oder say rein, weil das die Paralysenachricht �bernimmt, die im anderen 
					//spieler gesetzt ist durch das hinfallen.
					return 1;
				}
			write("Du stehst doch.\n");
			return 1;
		}
		return 0;
	}
					
					
					
int klettern(string str)
{
	object anderer;
	notify_fail("Wo moechtest Du denn hinklettern?\n");
	if(str!="rauf"&&str!="hinauf"&&str!="hoch"&&str!="nach oben"&&str!="zum gang"&&
		str!="seil hinauf"&&str!="seil rauf"&&str!="seil hoch"&&str!="an seil hoch"
		&&str!="an seil hinauf"&&str!="an seil nach oben"&&str!="an seil rauf") return 0;
	
	if(TP->QueryProp(P_NOMOVE))
		{
			write(TP->QueryProp(P_NOMOVE));
			return 1;
		}
	else if(seilda)//wenn der Spieler die leiter im inv hat
		{
				write("Du kletterst an dem Seil nach oben.\n");
	      say(TPN+" klettert an dem Seil nach oben.\n",TP);
	    	this_player()->move(LABY_ROOM+"hoehlenlabyrinth_4j", M_GO, 0,
                   "klettert hoch", "kommt von unten hochgeklettert");
        return 1;
      }

//wenn es schon einen anderen mitspieler gibt
else if(present("\nlabyrinthquestitem",TP)->mitteilen())
	{
		//Aus dem Questitem des Spielers den anderen Spieler holen
	  anderer=present("\nlabyrinthquestitem",TP)->mitteilen();
	  //gucken ob der andere gerade eine Raeuberleiter macht.
	  if(anderer->QueryProp(P_NOMOVE)!="Du musst erst die Raeuberleiter loesen.\n")
		  {
			  write("Das geht nicht so ohne weiteres. Du brauchst eine gute Idee um hier weiter zu kommen.\n");
			  return 1;
		   }
	
	//der Spieler kann also laufen, der andere macht eine Raeuberleiter
	//wenn der kletternde Spieler schwerer ist als der, der unten steht
	//fallen die beiden um
	  if(TP->QueryProp(P_WEIGHT)>anderer->QueryProp(P_WEIGHT))
		  {
			  write("Du versuchst an "+anderer->name()+" hochzuklettern.\n"+
		  	"Du bist zu schwer, "+anderer->name()+" kann Dich nicht halten.\nDu purzelst nach unten.\n");
	      tell_object(anderer, TPN+" versucht an Dir hoch zu klettern, aber Du kannst "+
	      TP->QueryPronoun(WEN)+" nicht halten.\nDu faellst um und "+TPN+" landet auf Dir.\n");
			  TP->AddHp(-10);
			  anderer->AddHp(-20);
        anderer->SetProp(P_NOMOVE,0);
        TP->SetProp(P_NOMOVE,"Du musst erst aufstehen.\n");
        anderer->SetProp(P_PARALYZED, ([
         PARALYZE_TIME: (-1),
         PARALYZE_MSG: TPN+ " sitzt auf Dir und muss erst aufstehen.\n",
         PARALYZE_MSG_OTHER: "%s versucht, sich zu bewegen, liegt aber unter Dir begraben.\n",
         PARALYZE_END: TPN+" steht von Dir auf.\nEndlich kriegst Du wieder Luft.\n",
         PARALYZE_END_OTHER: "Du stehst auf.\n"]));
        return 1;
        }

	    
			
	write("Du kletterst ueber die Raeuberleiter von "+anderer->name()+" nach oben.\n");
	tell_object(anderer, TPN+" klettert ueber Deine Raeuberleiter nach oben.\n");
		this_player()->move(LABY_ROOM+"hoehlenlabyrinth_4j", M_GO, 0,
                   "klettert hoch", "kommt von unten hochgeklettert");
	tell_object(anderer, "Du loest Deine Haende.\n");
  anderer->SetProp(P_NOMOVE,0);

  return 1;
}
			write("Das geht nicht so ohne weiteres. Du brauchst eine gute Idee um hier weiter zu kommen.\n");
return 1;
}	
