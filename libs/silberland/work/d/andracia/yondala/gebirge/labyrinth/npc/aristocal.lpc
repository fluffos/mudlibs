object spieler1,spieler2;

//alle Raeume und sich selbst resetten
void allesresetten()
{
	string *alle_pfade;
	int i;
	
	spieler1=0;
	spieler2=0;

	//alle_pfade= get_dir("/d/andracia/yondala/gebirge/labyrinth/room/*");
    alle_pfade= get_dir(LABY_ROOM+"*");
/*	tell_room(environment(TO), LABY_ROOM+alle_pfade[0]+" ist ein Pfad.\n");
	tell_room(environment(TO), "Es wurden "+sizeof(alle_pfade)+" gefunden.\n");
	tell_room(environment(TO), LABY_ROOM+alle_pfade[102]+" ist Pfad 102.\n");
	*/
   //tell_room(environment(TO), alle_pfade[sizeof(alle_pfade)-1]+" gefunden.\n");
	
	for(i=sizeof(alle_pfade)-1;i>=0;i--)
	  {
		if(find_object(LABY_ROOM+alle_pfade[i])&&alle_pfade[i]!="birkenhainlaby_1.lpc")	  
			destruct(find_object(LABY_ROOM+alle_pfade[i])); 
				
		
		 
		//else tell_room(environment(TO), alle_pfade[i]+" nicht gefunden.\n");
		}  
	return;	

	     
		 
}


//zum testen

void steine()
{
	int i;
	i=present("\nrichtiggemacht",TP)->gibPunkte();
	
	if (i)
	{
		command("sag Fuer Eure Leistung im reissenden Fluss erhaltet Ihr ausserdem ein paar Edelsteine von mir, "+TP->name()+".");
		"/obj/gemmaster"->DistributeGem(i, i, 1, TP);
	}	
	
}


//Gib hier extra Edelsteine, wenn man gut gepaddel hat
//Hier noch Highscoreliste pflegen
void extrabelohnung(object spieler)
{
	int i;
	i=present("\nrichtiggemacht",spieler)->gibPunkte();
	
	if (i)
	{
		command("sag Fuer Eure Leistung im reissenden Fluss erhaltet Ihr ausserdem "+i+" ein paar Edelsteine von mir, "+spieler->name()+".");
		"/obj/gemmaster"->DistributeGem(i, i, 1, spieler);
	}
	
	present("\nrichtiggemacht",spieler)->remove();
	
}
void inventar_saeubern(object spieler)
{
	object *alle;
	int i;
	alle=all_inventory(spieler);
	for(i=sizeof(alle)-1;i>=0;i--)
	  {
	  	if(alle[i]->id("\nlabyloeschmich")) alle[i]->remove();
		//if(alle[i]->id("\nlabyrinthquestitem")) alle[i]->remove();
	     }
	present("\nlabyrinthquestitem", spieler)->remove();	 
}

void allesbeenden()
{
	if (spieler1)inventar_saeubern(spieler1);
	if (spieler2)inventar_saeubern(spieler2);
//	spieler1=0;
//	spieler2=0;
	allesresetten();
}

