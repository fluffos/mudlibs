highscore_ausgabe(string str)
{
	string ausgabe;
	int position;
//	mapping map;
//	string alle_zeiten;
//	string *zeiten_arr;
	string high_datum;
	string high_namen;
	int high_sek;
	int high_position;	
	int i;
	ausgabe="";
	//zeiten_arr=({});
	high_datum=0;
	high_namen=0;
	high_sek=0;
	high_position=0;	
	
//return "Viele";
		
	//Highscoreliste sortieren
	//write_file(LABY_LOG+"highscore.txt","\nENDE");
	command("sag Hier ist meine persoenlich gefuehrte Bestenliste:");
	for(i=1;i<=10000;i++)
	{
/*		if(read_file(LABY_LOG+"highscore.txt",i,1)=="ENDE")
		{
			//return "Ende bei "+i;
			break;
			
		}*/
		//zeiten_arr[i]=read_file(LABY_LOG+"highscore.txt",i,1);
		//zeiten_arr=zeiten_arr +({read_file(LABY_LOG+"highscore.txt",i,1)});
		if(read_file(LABY_LOG+"highscore.txt",i,1)&&read_file(LABY_LOG+"highscore.txt",i,1)!="")
		{
			if(i<10)
				tell_room(environment(TO),"   ");
			else if(i<100)
				tell_room(environment(TO),"  ");
			else if (i<1000)
				tell_room(environment(TO)," ");
			
			tell_room(environment(TO),i+": ");
			
			if(sscanf(read_file(LABY_LOG+"highscore.txt",i,1),"%d;%s;%s", high_sek, high_datum,high_namen)!=3) break;
			if(high_sek<10)
				tell_room(environment(TO)," ");
			if(high_sek<100)
				tell_room(environment(TO)," ");
			if (high_sek<1000)
				tell_room(environment(TO)," ");
			if (high_sek<10000)
				tell_room(environment(TO)," ");
			if (high_sek<100000)
				tell_room(environment(TO)," ");
			
				
			tell_room(environment(TO),high_sek+" - "+high_datum+ " ~ "+ high_namen);//+read_file(LABY_LOG+"highscore.txt",i,1));
		}
		else break;
		
	}
/*	sort_array(zeiten_arr, #'<);
	for(i=0;i<sizeof(zeiten_arr)-1;i++)
	{
	  ausgabe=ausgabe+zeiten_arr[i];	
	}*/

return "Beeindruckend, nicht wahr?";


		//alle_zeiten=read_file(LABY_LOG+"highscore.txt");
		
}



void create() {
  if (!is_clone(TO)) return;
  ::create();
  spieler1=0;
  spieler2=0;
  
  SetProp(P_SHORT, "Aristocal, der Faun");
  SetProp(P_LONG,
    "Du siehst einen Faun vor Dir, dessen Alter Du nicht abschaetzen kannst. Sein Fell, das "
    "von seiner Huefte ueber die Bocksbeine bis zu den Hufen reicht ist graubraun. Sein "
    "Oberkoerper ist nackt und sonnengebraeunt. Er schaut Dich aus wachen braunen Augen an, "
    "wenn er spricht wackelt sein Ziegenbaertchen auf und ab.");
  SetProp(P_NAME, "Aristocal");
  SetProp(P_GENDER, NEUTER);
  AddId(({"aristocal","faun"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(10);
//  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Faun");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOATTACK, 1);
  SetProp(P_AGGRESSIVE,0);

 

  SetProp(P_MSGIN, "kommt heran"); 
  SetProp(P_MSGOUT, "geht nach");
  SetProp(P_MMSGIN, "verschwindet");
  SetProp(P_MMSGOUT, "steht auf einmal neben Dir");

  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "fragt nicht soviel, helft mir lieber!\n");

  AddInfo("yondala", "Lang lebe Yondala.","sagt: ");

        


  AddInfo( ({ "hilfe" }),
    "Wollt Ihr mir helfen? Das waere nett. Mir wurde schon wieder meine Panfloete gestohlen!",
    "sagt: ");
  AddInfo( ({ "panfloete", "floete" }),
    "Meine Panfloete wurde gestohlen. Mal wieder. Und ich weiss auch, wer der Dieb war. Das "
    "Problem ist nur, dass er in diese Hoehle dort gefluechtet ist.",
    "sagt: ");
  AddInfo( ({ "dieb" }),
    "Crambel war es, dieser elende Dieb. Er hat mir schon oefters meine Panfloete gestohlen, "
    "weil er meine Musik nicht mag.",
    "sagt: ");
  AddInfo( ({ "crambel" }),
    "Crambel ist ein Nichtsnutz.",
    "sagt: ");
  AddInfo( ({ "nichtsnutz" }),
    "Davon gibt es viele. Crambel ist der schlimmste von ihnen.",
    "sagt: ");
  AddInfo( ({ "problem" }),
    "Ich habe ein Problem mit geschlossenen, engen Raeumen. Ich bin ein Faun, ich liebe die "
    "Natur und die frische Luft. Ich kann einfach nicht in diese Hoehle gehen."
    "Deshalb suche ich einen Freiwilligen, der Crambel fuer mich verfolgt.",
    "sagt: ");
  AddInfo( ({ "hoehle" }),
    "In diese Hoehle ist Crambel mit meiner Floete gelaufen, weil er genau weiss, dass ich ihm "
    "dorthin nicht folgen werde. Ich habe allerdings gehoert, dass es darin gefaehrlich "
    "sein soll und deshalb muesst Ihr Euch einen Gefaehrten suchen, der mit Euch geht.",
    "sagt: ");
  AddInfo( ({ "freiwilliger","freiwilligen","freiwillige" }),
    "Waeret Ihr so nett mir zu helfen? Dann bietet mir Eure Hilfe an. Und ich lasse Euch in die Hoehle. Es gibt aber ein paar Bedingungen.",
    "sagt: ");
  AddInfo( ({ "faun" }),
    "Ich bin ein Faun!",
    "sagt stolz: ");
  AddInfo( ({ "gefaehrte","gefaehrten" }),
    "Nur zu zweit kann man dieses Abenteuer bestehen.",
    "sagt: ");
  AddInfo( ({ "abenteuer" }),
    "Wenn Ihr mir Eure Hilfe anbietet, dann werdet Ihr eines erleben!",
    "sagt: ");
  AddInfo( ({ "belohnung" }),//spezial machen gucken ob schon vorhanden, sonst neu geben
    "Eine wirkliche Belohnung kann ich Euch nicht bieten. Vielleicht findet Ihr etwas in der Hoehle, was Euch als Lohn genuegt.",
    "sagt: ");
  AddInfo( ({ "bedingungen" }),
    "Ihr habt nur begrenzt Zeit, um meine Floete zu finden. Danach hole ich Euch aus der "
	"Hoehle und Ihr oder jemand anderes kann es erneut versuchen. Ausserdem ist das Abenteuer "
	"fuer Euch und Euren Gefaehrten vorbei, sollte einer von Euch diese Welt zwischenzeitlich verlassen.",
    "sagt: ");
  AddInfo( ({ "welt" }),
    "Eine schoene Welt, in der wir leben. Nur manchmal etwas rau und ungerecht.",
    "sagt: ");
  AddInfo( ({ "zeit" }),
    "Ein paar Stunden werdet Ihr haben. Kurz vor Ende informiere ich Euch.",
    "sagt: ");
  AddInfo( ({ "stunden" }),
    "Ein paar Stunden koennen schnell vorbei sein.",
    "sagt: ");
  AddInfo( ({ "ende" }),
    "Meine Panfloete nicht beim ersten Versuch zu finden ist nicht das Ende.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
	AddInfo( ({"punkte","bestenliste","liste","highscore"}), #'highscore_ausgabe, "sagt: ");


 
SetChats(3, ({
   "Aristocal laeuft nervoes auf und ab.\n",
   "Aristocal fragt: Wollt Ihr mir nicht helfen?\n",
   "Aristocal seufzt ungluecklich.\n",
   "Aristocal macht einen Schritt auf die Hoehle zu, dreht dann aber um.\n",
   "Aristocal kratzt sich am Kopf.\n"}) );

  AddCmd(({"biete","biet"}),"anbieten");
   //AddCmd(({"alles"}),"allesresetten");
   //AddCmd(({"steine"}),"steine");
  
}




