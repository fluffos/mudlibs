void kurzvorende()
{
	tell_object(spieler1, "Aristocal teilt Euch mit: Beeilt Euch, Ihr habt nur noch wenige Minuten!\n");
	tell_object(spieler2, "Aristocal teilt Euch mit: Beeilt Euch, Ihr habt nur noch wenige Minuten!\n");
  call_out("ende",600);//beendet die Quest in 10 Minuten

}

void zweitergehtrein()
{
	this_player()->move(LABY_ROOM+"hoehlenlabyrinth_7d", M_GO, 0,
                  "betritt die Hoehle", "kommt von draussen herein");
  tell_object(spieler1,"Aristocal teilt Dir mit: Wohlan, ich wuensche Euch und "
  +spieler2->name()+" viel Erfolg.\n"+
  "Aristocal teilt Dir mit: Wenn Ihr die Hoehle vorzeitig verlassen wollt teilt\n"+
  "Aristocal teilt Dir mit: mir einfach 'ende' mit und ich erloese Euch.\n");
  tell_object(spieler2,"Aristocal teilt Dir mit: Wohlan, ich wuensche Euch und "
  +spieler1->name()+" viel Erfolg.\n"+
  "Aristocal teilt Dir mit: Wenn Ihr die Hoehle vorzeitig verlassen wollt teilt\n"+
  "Aristocal teilt Dir mit: mir einfach 'ende' mit und ich erloese Euch.\n");
  
	CLONE(LABY_OBJ +"labyrinth_questitem.lpc", TP);
//diese Funktion uebernimmt das questitem
//	call_out("kurzvorende",6600);//beendet die Quest in zwei Stunden(minus 10 Minuten ;o) )  
	call_other(present("\nlabyrinthquestitem",spieler1), "festlegen",spieler2);
	call_other(present("\nlabyrinthquestitem",spieler2), "festlegen",spieler1);

//Die Zeit starten im Item
	call_other(present("\nlabyrinthquestitem",spieler1), "losgehts",0);
	call_other(present("\nlabyrinthquestitem",spieler2), "losgehts",0);

}

int anbieten(string str)
{
	notify_fail("Wem moechtest Du was anbieten?\n");
	if(str!="aristocal hilfe an"&&str!="faun hilfe an") return 0;
	
//Falls jemand besonders witzig sein will und schnell zurueck rennt um nochmal anzubieten
	if(TP==spieler1||TP==spieler2)
		{
			if(present("\nlabyfloete",TP))
				command("sag Seid so gut und gebt mir meine Panfloete.");
			
			return 1;
		}
	write("Du bietest Aristocal Deine Hilfe an.\n");
	say(TPN+" bietet Aristocal "+TP->QueryPossPronoun(FEMALE)+" Hilfe an.\n",TP);
	if(TP==spieler1||TP==spieler2)
	{
		command("sag Aber Ihr helft mir doch schon!");
        this_player()->move(LABY_ROOM+"hoehlenlabyrinth_7d", M_GO, 0,
                  "betritt die Hoehle", "kommt von draussen herein");
		return 1;
	}
	if(spieler1&&spieler2)
	{
		if(TP!=spieler1&&TP!=spieler2)
		{
			command("sag Tut mir leid, ich habe gerade schon zwei Abenteurer losgeschickt, Ihr"+
			" muesst Euch ein wenig gedulden.\n");
			return 1;
		}
	}
	if(!spieler1&&!spieler2)//wenn noch kein Spieler los ist
		{
			command("sag Danke, dass Ihr mir helfen wollt, "+TPN+"!");
			write("Aristocal macht einen Schritt zur Seite und laesst Dich passieren.\n");
			say("Aristocal macht einen Schritt zur Seite und laesst "+TPN+" passieren.\n",TP);
			this_player()->move(LABY_ROOM+"hoehlenlabyrinth_7d", M_GO, 0,
                  "betritt die Hoehle", "kommt von draussen herein");
			CLONE(LABY_OBJ +"labyrinth_questitem.lpc", TP);
			spieler1=TP;                  
			return 1;
		}
	if(spieler1&&!spieler2)
		{
			command("sag Danke, dass Ihr mir helfen wollt, "+TPN+"!");
			spieler2=TP;    
			zweitergehtrein();
			return 1;
			}
			

	if(!spieler1&&spieler2)
		{
			command("sag Danke, dass Ihr mir helfen wollt, "+TPN+"!");
			spieler1=TP; 
			zweitergehtrein();
			return 1;
			}
	}
				

//Wenn man ihm ende mitteilt holt er den Spieler raus
void catch_tell(string str)
{
	string spname,dummy;
	object spieler;
	//object item;
	
	if( sscanf( str, "%s teilt Dir mit: ende%s", spname, dummy)!=2 ) return;
    if( !spieler=find_player(lower_case(spname)) ) return;
//command ("sag "+TPN+" teilt mir was mit.");
// 	if(spieler==spieler1||spieler==spieler2)
	if(present("\nlabyrinthquestitem",TP))
		{
			if(spieler==spieler1)
				{
					tell_object(spieler1,"Aristocal teilt Dir mit: Wie versprochen erloese ich Euch.\n");
					spieler1->SetProp(P_NOMOVE,0);
					spieler1->SetProp(P_PARALYZED,0);
					spieler1->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
						"wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
			
					if(spieler2)
						{
							tell_object(spieler2,"Aristocal teilt Dir mit: "+spieler1->name()+" hat aufgegegen. Ich hole Euch zurueck.\n");
							spieler2->SetProp(P_NOMOVE,0);
							spieler2->SetProp(P_PARALYZED,0);
							spieler2->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
								"wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
						}
			   
			}
			
			if(spieler==spieler2)
				{
					tell_object(spieler2,"Aristocal teilt Dir mit: Wie versprochen erloese ich Euch.\n");
					spieler2->SetProp(P_NOMOVE,0);
					spieler2->SetProp(P_PARALYZED,0);
					spieler2->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
						"wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
			
					if(spieler1)
						{
							spieler1->SetProp(P_NOMOVE,0);
							spieler1->SetProp(P_PARALYZED,0);
							tell_object(spieler1,"Aristocal teilt Dir mit: "+spieler2->name()+" hat aufgegegen. Ich hole Euch zurueck.\n");
							spieler1->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
								"wird von Aristocal herausbefoerdert", "wird von Aristocal herbefoerdert");
						}
				}
		allesbeenden();		
			   
		}			
			
			
			
		

}

give_notify(object ob)//anschauen was gegeben wird
 {
  if(ob->id("\nlabyfloete"))//wenn es die Floete ist
  	{
  		if(TP==spieler1||TP==spieler2)//wenn derjenige gerade die Quest macht 
  			{
  				if (spieler1&&spieler2)
				{
					if(!present(spieler1, environment(TO)))
					{
						command("sag Ach, meine Floete, habt Dank. Doch lasst uns warten, bis "+
  				 		spieler1->name()+" auch da ist. Gebt sie mir dann nochmal!");
						write("Aristocal gibt Dir "+ob->name(WEN)+" zurueck.\n");
						say("Aristocal gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
   				 		ob->move(TP, M_GET);
						return;
					}
					
					if(!present(spieler2, environment(TO)))
					{
						command("sag Ach, meine Floete, habt Dank. Doch lasst uns warten, bis "+
  				 		spieler2->name()+" auch da ist. Gebt sie mir dann nochmal!");
						write("Aristocal gibt Dir "+ob->name(WEN)+" zurueck.\n");
						say("Aristocal gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
   				 		ob->move(TP, M_GET);
						return;
					}
					
				
					
					command("sag Habt vielen Dank, "+TP->name()+" und "+spieler2->name()+"!");
  					//command("sag Als Belohnung gebe ich Euch BLA!");
					spieler1->GiveQuest("Aristocals Floete"); //Quest als bestanden deklarieren
  					spieler2->GiveQuest("Aristocals Floete"); //Quest als bestanden deklarieren
  							 //Belohnung geben?
					if(present("\nrichtiggemacht", spieler1)) extrabelohnung(spieler1);
					if(present("\nrichtiggemacht", spieler2)) extrabelohnung(spieler2);
					highscoreeintragen();
					allesbeenden();
					return;
  				}

  			}
  		else//Wenn derjenige die Quest nicht macht
  			{
  				command("sag Was soll das sein? Ihr macht die Quest doch gerade gar nicht. "+
					"Es kann sich dabei wohl nur um eine Faelschung handeln! Ich werde dieses Ding besser vernichten!");
				say("Aristocal vernichtet die Floete.\n");
				ob->remove();
    		}
    }
    else//wenn es nicht die Floete ist
    	{
    		command("sag Was soll ich damit?");
  			write("Aristocal gibt Dir "+ob->name(WEN)+" zurueck.\n");
  			say("Aristocal gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
  			ob->move(TP, M_GET);
  		}
  	}
   		
				
  			        
