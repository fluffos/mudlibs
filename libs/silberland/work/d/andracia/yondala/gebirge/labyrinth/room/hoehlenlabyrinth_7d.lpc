// Hier der Warteraum fuer den ersten Spieler
// Der schwerere muss dem leichteren eine Raeuberleiter machen


#include "../def.h"
inherit "std/room";
#include <properties.h>
//ueber item geloest, nicht mehr noetig
//int leiterda;//wenn von oben eine Leiter heruntergleassen wurde
//int spieler;

void create() 
{
  ::create();
  //spieler=0;
  CLONE("/obj/fackel.lpc", TO);
  CLONE("/obj/fackel.lpc", TO);  
  CLONE(LABY_OBJ+"wurstsemmel.lpc", TO);  
  CLONE(LABY_OBJ+"wurstsemmel.lpc", TO);  
  
  SetProp( P_INT_SHORT, "In einer Hoehle" );
//  leiterda=0;
  SetProp( P_INT_LONG,
    "Du stehst hier in einer kleinen Hoehle. Im Westen ist der Ausgang, ein schwacher "
    "Lichtschein faellt von aussen herein. Du siehst nicht viel, um Dich herum sich blanke "
    "Felswaende, deren Erklimmen wohl nicht so einfach sein duerfte." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Du stehst hier in einer kleinen Hoehle. Im Westen ist der Ausgang, ein schwacher "
    "Lichtschein faellt von aussen herein. Du siehst nicht viel, um Dich herum sich blanke "
    "Felswaende, deren Erklimmen wohl nicht so einfach sein duerfte." );
  AddDetail( ({ "westen" }),
    "Dort ist ein Ausgang. Oder auch Eingang, denn dorther bist Du hierher gelangt.");
  AddDetail( ({ "ausgang","eingang" }),
    "Der liegt westlich von Dir.");
  AddDetail( ({ "lichtschein", "tageslicht" }),
    "Von draussen scheint helles Tageslicht in die Hoehle.");
  AddDetail( ({ "felswaende", "waende","wand" }),
    "Die Felswaende sind ziemlich glatt, Du siehst weder Rillen noch Spalten an denen Du "
    "hochklettern koenntest. Etwas ausserhalb Deiner Reichweite siehst Du einen schmalen "
    "Felsvorsprung.");
  AddDetail( ({ "rillen","spalten" }),
    "Keine da, das ist ja das Problem.");
  AddDetail( ({ "problem" }),
    "Du hast ein Problem, weil Du nicht weisst, wie Du die glatten Waende hochklettern sollst. "
    "Hoffentlich faellt Dir bald eine Loesung ein.");
  AddDetail( ({ "loesung" }),
    "Du denkst nach und Dir faellt ein, wie es die Raeuber immer machen.");
  AddDetail( ({ "raeuber" }),
    "Ja, was machen Raeuber, wenn sie keine Leiter haben?");
  AddDetail( ({ "leiter" }),
    "Du hast leider keine, Dir muss etwas anderes einfallen.");
  AddDetail( ({ "reichweite" }),
    "Leider kannst Du ihn nicht ohne weiteres erreichen.");
  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "Dort scheint ein Gang zu beginnen.");
  AddDetail( ({ "gang" }),
    "Der Gang ueber dem Felsvorsprung sieht vielversprechend aus. Doch wie kommst Du dahin? "
    "Alleine ist das sicher nicht machbar.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Felsen.");
  AddDetail( ({ "felsen", "fels" }),
    "Da Du in einer Hoehle im Gebirge bist, bist Du von Felsen umgeben.");
  AddDetail( ({ "gebirge" }),
    "Die Hoehle in der Du Dich befindest liegt im Gebirge.");
  AddDetail( ({ "staub" }),
    "Der liegt in dieser alten, unbewohnten Hoehle natuerlich ueberall.");
  AddDetail( ({ "decke" }),
    "Die Decke der Hoehle besteht aus blankem Fels.");
  AddDetail( ({ "erklimmen" }),
    "Hm, ja, wie kann man bloss nach oben kommen?");
  AddDetail( ({ "idee" }),
    "Du denkst nach und Dir faellt ein, wie es die Raeuber machen, wenn sie keine Leiter haben.");
  AddDetail( ({ "klinge" }),
    "Die fehlt.");
  AddDetail( ({ "angeln" }),
    "Da Du keine siehst gehst Du davon aus, dass diese auf der anderen Seite liegen muessen. "
    "Vielleicht sind sie aber auch im Fels verborgen. Jedenfalls bringt Dich das nicht weiter.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist relativ trocken und staubig.");

  AddSmell( ({ "luft" }),
    "Die Luft ist relativ trocken und staubig.");
  AddSmell( ({ "staub" }),
    "Der liegt in dieser alten, unbewohnten Hoehle natuerlich ueberall.");

//  AddRoomMessage( 
  //  ({""}),30,"func");
  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind vor der Hoehle leise pfeiffen.");

  AddSound( ({ "wind" }),
    "Der weht draussen sanft an der Hoehle vorbei.");
 AddCmd( ({ "mache", "mach","bilde","bild"}), "machen" ); //Raeuberleiter machen
 AddCmd( ({ "loese", "loes"}), "loesen" ); //Raeuberleiter loesen
 AddCmd( ({ "kletter", "klettere"}), "klettern" ); //nach oben klettern
 AddCmd( ({ "steh", "stehe"}), "aufstehen" ); //wenn man umgefallen ist muss man aufstehen


//  AddExit("westen", LABY_ROOM+"birkenhainlaby_1.lpc");
   AddSpecialExit( "westen", "westlauf");
 
 }
int westlauf(string dir)
{
	//entweder macht er die Quest nicht und ist wie auch immer da rein geraten
	//oder er hat die Floete bei und ist wie auch immer den Weg zurueck gekommen
	if(!present("\nlabyrinthquestitem",TP)||present("\nlabyfloete",TP))
  return this_player()->move(LABY_ROOM+"birkenhainlaby_1", M_GO, 0,
                  "verlaesst die Hoehle", "kommt aus der Hoehle");
  
  tell_object(TP,"Aristocal laesst Dich nicht raus.\n"+
  "Aristocal teilt Dir mit: Wenn Ihr die Quest abbrechen wollt, so teilt mir ende mit.\n");
  tell_room(TO,"Aristocal laesst "+TPN+" nicht raus.\n",({TP}));
	return 1;                  

  }

