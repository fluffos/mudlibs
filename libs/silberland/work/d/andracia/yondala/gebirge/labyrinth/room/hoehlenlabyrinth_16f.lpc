// Hier steht eine Matratze, die man umwerfen kann, damit jemand von oben
// (16_G) runterspringen kann


#include "../def.h"
inherit "std/room";
#include <properties.h>

//Wird von Aristocal aufgerufen wenn die Quest beendet oder abgebrochen wird.
void anfangszustand()
{
  if (present("\nmatratze",TO)) present("\nmatratze",TO)->remove();
}

//wird von 16_g abgefragt, um herauszufinden, ob der Spieler 
//auf der Matratze landet oder aua kriegt
int matratzeda()
{
	if (present("\nmatratze",TO)) return 1;
	return 0;
}

void init()
{
  if(random(10)==1)
    {
      if (random(2)==1)
        {
          write("Du verletzt Dich an einer spitzen Ecke.\n");
          say(TPN+" verletzt sich an einer spitzen Ecke.\n",TP);
          TP->AddHp(-4);
        }
      else
        {
          write("Du kratzt Dich an einer scharfen Kante.\n");
          say(TPN+" kratzt sich an einer scharfen Kante.\n",TP);
          TP->AddHp(-2);
        }
    }
  ::init();
}
      
          

void create() 
{
  ::create();
  CLONE("/obj/fackel.lpc", TO);
  CLONE("/obj/fackel.lpc", TO);  
  SetProp( P_INT_SHORT, "In einer Sackgasse" );
  
  SetProp( P_INT_LONG,
    "Du stehst am Ende eines dunklen Ganges. Die Waende hier sind tiefschwarz, "
    "ebenso die Decke und der Boden. Es sieht aus, als haette es hier "
    "gebrannt und da es sehr warm ist gehst Du davon aus, dass das noch "
    "nicht lange her sein kann." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist schwarz verkohlt und mit einer grauen Ascheschicht bedeckt.");
  AddDetail( ({ "ascheschicht", "schicht" }),
    "Was immer hier dereins war, es ist nurmehr Asche davon uebrig.");
  AddDetail( ({ "asche" }),
    "Du versuchst ein wenig Asche zu nehmen, doch sie ist so fein, dass sie "
    "Dir durch die Finger rieselt.");
  AddDetail( ({ "finger" }),
    "Gut, dass die noch alle da sind. Trotzdem schaffst Du es nicht, die "
    "Asche zu halten.");
  AddSpecialDetail( ({ "waende","wand" }), "waende" );//abhaengig davon, ob schon eine Matzratze da ist

  AddDetail( ({ "gestein" }),
    "Die Waende bestehen aus einem durchgehend dunklen Gestein.");
  AddDetail( ({ "ecken" }),
    "Viele scharfe Kanten schauen immer wieder aus den Waenden hervor. "
    "Hoffentlich verletzt Du Dich nicht.");
  AddDetail( ({ "ecken" }),
    "Einige spitze Ecken gibt es an den unebenen Waenden. Pass auf, dass "
    "Du Dich nicht kratzt.");
  AddDetail( ({ "matratze" }),
    "Die Matzratze sieht oll und durchgelegen aus. Man kann sie vermutlich umstossen.");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr hoch ueber Dir. An einer Seite siehst Du einen Vorsprung.");
  AddDetail( ({ "seite" }),
    "An der oestlichen Seite siehst Du einen Vorsprung an der Decke.");
  AddDetail( ({ "vorsprung" }),
    "Da kommst Du wohl her. Ganz schoen weit weg. Du bist ziemlich stolz, dass Du "
    "Dich das getraut hast.");
  AddDetail( ({ "ende" }),
    "Du kannst hier nur in eine Richtung gehen.");
  AddDetail( ({ "richtung", "ausgang" }),
    "Nordwesten.");
  AddDetail( ({ "nordwesten" }),
    "Dorthin kannst Du gehen.");
  AddDetail( ({ "ende" }),
    "Da dies hier eine Sackgasse ist kannst Du nur in eine Richtung gehen. "
    "Du stehst am Ende des Ganges. Meinetwegen auch am Anfang, wie Du magst.");
  AddDetail( ({ "sackgasse" }),
    "Wie in einem Sack gibt es hier auch nur einen Ausgang.");
  AddDetail( ({ "sack" }),
    "In einem Sack ist es vermutlich auch so dunkel wie hier.");
  AddDetail( ({ "gang" }),
    "Der Gang endet hier. Oder er beginnt. Wie auch immer, Du kannst nur "
    "in eine Richtung gehen.");
  AddDetail( ({ "anfang" }),
    "Das kannst Du halten, wie Du willst.");

  AddDetail( ({ "rauschwade","schwade","rauchschwaden" }),
    "Immer wieder umwehen Dich duenne Rauchschwaden.");
  AddDetail( ({ "luft" }),
    "Die Luft ist drueckend, warm und stickig, das Atmen faellt Dir schwer.");
  AddDetail( ({ "atmen" }),
    "Das Atmen faellt Dir schwer, noch geht es aber.");
  AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Es riecht hier stark verbrannt.");
  AddSmell( ({ "" }),
    ".");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Eine kleine Rauchschwade umwabert Dich.\n",
    	"Es ist sehr warm hier, Du schwitzt.\n",
    	"Bildest Du es Dir nur ein, oder wird die Luft immer stickiger?\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Knistern und hin und wieder ein kurzes Trippeln.");

  AddSound( ({ "knistern" }),
    "Das Knistern hoert sich so an, als wuerde es hier brennen.");
  AddSound( ({ "trippeln" }),
    "Du bekommst das ungute Gefuehl, dass Du hier nicht allein bist.");

  AddSound( ({ "gefuehl", "gefuehle" }),
    "BIsher konntest Du Deinen Gefuehlen meistens vertrauen.");


  AddExit("nordwesten", LABY_ROOM+"hoehlenlabyrinth_15e.lpc");
  AddCmd( ({ "stosse", "stoss" }), "umstossen" );

 }

string waende()
{
  if(present("\nmatratze",TO))
  return "Die Waende sind kohlrabenschwarz. Das Gestein, aus dem sie bestehen, "
    "ist glatt, aber uneben und voller Ecken und Kanten.";
  
  return "Die Waende sind kohlrabenschwarz. Das Gestein, aus dem sie "+
         "bestehen, ist glatt, aber uneben und voller Ecken und Kanten. "+
         "An einer Wand lehnt eine dicke, alte Matratze";
    }
    


umstossen(string str)
{
  notify_fail("Was moechtest Du umstossen?\n");
  if(str=="matratze"||str=="matratze um")
    {
      if (present("\nmatratze",TO))
        {
          write("Die Matratze liegt doch schon auf dem Boden.\n");
          return 1;
        }
      else
        {
          write("Du stoesst feste gegen die Matratze.\nDie Matratze faellt um.\n");
          say(TPN+" stoesst die Matratze um.\n");
          CLONE(LABY_OBJ + "matratze.lpc",TO);//environment(TP));
          //AddItem(LABY_OBJ + "matratze", REFRESH_NONE,1);
          return 1;
          }
       }  
    return 0;
}
