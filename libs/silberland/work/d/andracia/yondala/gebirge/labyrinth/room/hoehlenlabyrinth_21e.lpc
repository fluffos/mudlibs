// Hier verlaesst man den Berg Dazu muss ein bestimmter Zauberstab in ein Loch gesteckt und ein Knopf gedrueckt werden


#include "../def.h"
inherit "std/room";
#include <properties.h>



void init()
{
  if(random(5)==1)
    {
      if (random(2)==1)
        {
          write("Du verletzt Dich an einer spitzen Ecke.\n");
          say(capitalize(TPN)+" verletzt sich an einer spitzen Ecke.\n",TP);
          TP->AddHp(-4);
        }
      else
        {
          write("Du kratzt Dich an einer scharfen Kante.\n");
          say(capitalize(TPN)+" kratzt sich an einer scharfen Kante.\n",TP);
          TP->AddHp(-2);
        }
    }
  ::init();
}
      
int stabda;         
void anfangszustand()
{
	stabda=0;
	AddDetail( ({ "loch" }),
      "Das Loch im Boden ist klein, aber tief und wie ein Stern geformt.");
    AddDetail( ({ "stern" }),
      "Ob es hilft, etwas sternfoermiges hineinzustecken?");
	RemoveDetail("zauberstab");
}
void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "In einer Sackgasse" );
  stabda=0;
  SetProp( P_INT_LONG,
    "Du stehst am Ende eines dunklen Ganges. Die Waende von Russ geschwaerzt, "
    "ebenso die Decke und der Boden. Du kannst kaum etwas sehen, nur mit den "
	"Fuessen bemerkst Du ein kleines Loch im Boden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
  AddItem(LABY_NPC + "feuerkaefer.lpc",REFRESH_DESTRUCT);
  
  AddDetail( ({ "boden" }),
    "Der Boden ist schwarz verkohlt und mit einer grauen Ascheschicht bedeckt.");
  AddDetail( ({ "ascheschicht", "schicht" }),
    "Unter der Asche ist nichts. Nur ein kleines Loch faellt Dir auf.");
  AddDetail( ({ "asche" }),
    "Du versuchst ein wenig Asche zu nehmen, doch sie ist so fein, dass sie "
    "Dir durch die Finger rieselt.");
  AddDetail( ({ "finger" }),
    "Gut, dass die noch alle da sind. Trotzdem schaffst Du es nicht, die "
    "Asche zu halten.");
  AddDetail( ({ "gestein" }),
    "Die Waende bestehen aus einem durchgehend dunklen Gestein.");
  AddDetail( ({ "ecken" }),
    "Viele scharfe Kanten schauen immer wieder aus den Waenden hervor. "
    "Hoffentlich verletzt Du Dich nicht.");
  AddDetail( ({ "ecken" }),
    "Einige spitze Ecken gibt es an den unebenen Waenden. Pass auf, dass "
    "Du Dich nicht kratzt.");
  AddDetail( ({ "matratze" }),
    "Die Matzratze sieht oll und durchgelegen aus. Man kann sie vermutlich umstossen.");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr hoch ueber Dir. An einer Seite siehst Du einen Vorsprung.");
  AddDetail( ({ "seite" }),
    "An der oestlichen Seite siehst Du einen Vorsprung an der Decke.");
  AddDetail( ({ "vorsprung" }),
    "Da kommst Du wohl her. Ganz schoen weit weg. Du bist ziemlich stolz, dass Du "
    "Dich das getraut hast.");
  AddDetail( ({ "ende" }),
    "Du kannst hier nur in eine Richtung gehen.");
  AddDetail( ({ "richtung", "ausgang" }),
    "Nordwesten.");
  AddDetail( ({ "nordwesten" }),
    "Dorthin kannst Du gehen.");
  AddDetail( ({ "ende" }),
    "Da dies hier eine Sackgasse ist kannst Du nur in eine Richtung gehen. "
    "Du stehst am Ende des Ganges. Meinetwegen auch am Anfang, wie Du magst.");
  AddDetail( ({ "sackgasse" }),
    "Wie in einem Sack gibt es hier auch nur einen Ausgang.");
  AddDetail( ({ "sack" }),
    "In einem Sack ist es vermutlich auch so dunkel wie hier.");
  AddDetail( ({ "gang" }),
    "Der Gang endet hier. Oder er beginnt. Wie auch immer, Du kannst nur "
    "in eine Richtung gehen.");
  AddDetail( ({ "anfang" }),
    "Das kannst Du halten, wie Du willst.");

  AddDetail( ({ "rauschwade","schwade","rauchschwaden" }),
    "Immer wieder umwehen Dich duenne Rauchschwaden.");
  AddDetail( ({ "luft" }),
    "Die Luft ist drueckend, warm und stickig, das Atmen faellt Dir schwer.");
  AddDetail( ({ "atmen" }),
    "Das Atmen faellt Dir schwer, noch geht es aber.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind kohlrabenschwarz. Das Gestein, aus dem sie bestehen, "
    "ist glatt, aber uneben und voller Ecken und Kanten. An der Suedwand faellt Dir etwas auf.");
  AddDetail( ({ "suedwand" }),
    "Ein dicker roter Knopf prangt an der Suedwand.");
  AddDetail( ({ "knopf" }),
    "Hm, was macht man im Allgemeinen mit dicken, roten Knoepfen?");
  AddDetail( ({ "allgemeinen", "allgemeines" }),
    "Man drueckt sie.");
  AddDetail( ({ "loch" }),
    "Das Loch im Boden ist klein, aber tief und wie ein Stern geformt.");
  AddDetail( ({ "stern" }),
    "Ob es hilft, etwas sternfoermiges hineinzustecken?");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");



  AddSmell( DEFAULT_SMELL,
    "Es riecht hier stark verbrannt.");
  AddSmell( ({ "" }),
    ".");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    ".");


  AddRoomMessage( 
    ({"Eine kleine Rauchschwade umwabert Dich.\n",
    	"Es ist sehr warm hier, Du schwitzt.\n",
    	"Bildest Du es Dir nur ein, oder wird die Luft immer stickiger?\n"}),120,"func");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Knistern und hin und wieder ein kurzes Trippeln.");

  AddSound( ({ "knistern" }),
    "Das Knistern hoert sich so an, als wuerde es hier brennen.");
  AddSound( ({ "trippeln" }),
    "Du bekommst das ungute Gefuehl, dass Du hier nicht allein bist.");

  AddSound( ({ "gefuehl", "gefuehle" }),
    "Bisher konntest Du Deinen Gefuehlen meistens vertrauen.");


  AddExit("norden", LABY_ROOM+"hoehlenlabyrinth_20e.lpc");
  AddCmd( ({ "stecke", "steck" }), "stecken" );
  AddCmd( ({ "druecke", "drueck" }), "druecken" );
  AddCmd( ({ "entferne", "entfern" }), "entfernen" );

 }
int entfernen(string str)
{
	notify_fail("Was moechtest Du woraus entfernen?\n");
	if (str!="stab aus loch"&&str!="zauberstab aus loch") return 0;
	if(!stabda)
	{
		write("In dem Loch ist kein Stab.\n");
		return 1;
	}
	
	if(TP->QueryProp(P_NOMOVE!="Du kannst nicht laufen, waehrend Du den Zauberstab festhaelst. Entferne ihn erst aus dem Loch.\n"))
	{
		write("Du hast keinen Zauberstab in das Loch gesteckt.\n");
		return 1;
	}
	write("Du entfernst den Zauberstab aus dem Loch.\n");
	anfangszustand();
	TP->SetProp(P_NOMOVE,0);
	present("\nlabyquestzauberstab",TP)->SetProp(P_NODROP, 0);
	return 1;
	
}	
	
	
int stecken(string str)
{
    string was, worein;
	notify_fail("was moechtest Du worein stecken?\n");
	if(!str) return 0;
    if (sscanf(str, "%s in %s", was, worein) != 2) return 0;
	if(!present(was,TP))
	{
		write("So etwas hast Du nicht.\n");
		return 1;
	}
	if(worein!="loch")
	{
		write("Worein moechtest Du "+present(was,TP)->name(WEN)+" stecken?\n");
		return 1;
	}
	if (was!="stab"&&was!="zauberstab")
	{
		write (capitalize(present(was,TP)->name(WER))+" passt nicht in das Loch.\n");
		return 1;
	}
	if (!present("\nlabyquestzauberstab",TP))
	{
		write("Du hast nicht den richtigen Stab dabei.\n");
		return 1;
	}
	//Sagt Stab in Loch, Stab dabei:
	if(stabda)
	{
		write("Da steckt doch schon ein Stab.\n");
		return 1;
	}
	write("Du steckst den Stab in das Loch.\n");
	say(TPN+" steckt einen Zauberstab in ein Loch im Boden.\n",TP);
	TP->SetProp(P_NOMOVE, "Du kannst nicht laufen, waehrend Du den Zauberstab festhaelst. Entferne ihn erst aus dem Loch.\n");
	stabda=1;
    AddDetail( ({ "loch" }),
      "In dem Loch steckt ein Zauberstab, von "+TPN+" gehalten.");
    AddDetail( ({ "zauberstab" }),
      "Der steckt im Boden.");
	RemoveDetail("stern");
	present("\nlabyquestzauberstab",TP)->SetProp(P_NODROP, "Du kannst den Zauberstab jetzt nicht ablegen.\n");
	return 1;
	
}


 int alleraus(object ob) 
{
   ob->SetProp(P_NOMOVE,0);
   if(present("\nlabyquestzauberstab",ob)) present("\nlabyquestzauberstab",ob)->SetProp(P_NODROP,0);
	   
   ob->move( LABY_ROOM + "hoehlenlabyrinth_rutsche.lpc", M_NOCHECK);
     return 1;
}
   

//Idee: Hier abfragen, ob in 9C die Bedingungen (welche auch immer) erfuellt sind
druecken(string str)
{
  mixed *people;
 
	notify_fail("Was moechtest Du druecken?\n");
	if(str!="knopf") return 0;
	if(TP->QueryProp(P_NOMOVE))
	{
		write("Du kannst den Knopf nicht erreichen, waehrend Du den Zauberstab in das Loch haelst.\n");
		return 1;
	}
	if(!stabda)
	{
		write("Du drueckst den dicken roten Knopf.\nNichts passiert.\n");
		say(TPN+" drueckt den dicken roten Knopf.\nNichts passiert.\n");
		return 1;
	}
	write("Du drueckst den dicken roten Knopf.\nEine Klappe im Boden geht auf und Du "
	      "faellst in die Tiefe.\n");
	say(TPN+" drueckt den dicken roten Knopf.\nEine Klappe im Boden geht auf und Du "
	      "faellst in die Tiefe.\n");
	      
	people=filter_array( all_inventory(), #'interactive );
    map_array(people, #'alleraus);
	anfangszustand();
  
  return 1;
}
