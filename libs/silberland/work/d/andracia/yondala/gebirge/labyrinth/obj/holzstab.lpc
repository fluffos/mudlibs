#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzstab");
  SetProp(P_LONG,
    "Du siehst einen alten, schmuddeligen Holzstab. Er ist grau und staubig und an einem "
    "Ende verkohlt, vermutlich hat ihn mal jemand als Fackel benutzt." );
  SetProp(P_NAME, "Holzstab");
  SetProp(P_GENDER, MALE);
  AddId(({"holzstab","stab","\nlabyloeschmich"}));
SetProp( P_MATERIAL, MAT_MISC_WOOD);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
 
}


	