#include "../def.h"

inherit "std/room";

#include <properties.h>

string *felsen = ({ "harter Granit", "weicher Granit", "dunkler Granit", "heller Granit",
                    "schwarzer Granit", "brauner Basalt", "schwarzer Basalt",
                    "brauner Urzeitfels", "grauer Urzeitfels", "gemeiner Graufels", "gemeiner Braunfels" });
int i;

void create() 
{
  ::create();

  i=random(sizeof(felsen));
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  switch( random(3) )
  {
    case 2:
      SetProp( P_INT_LONG, BS(
        "Du befindest Dich tief im Berg in einer feuchtkalten Hoehle. Die Waende, Decke "+
        "und Boden bestehen aus groben Felsen, und nur selten kann man bequem voranschreiten. "+
        "Nischen und Spalten sind zwischen den Felsen zu finden und Vorspruenge erschweren "+
        "Dir den Weg.")); break;
    case 1:
      SetProp( P_INT_LONG, BS(
        "Hier tief im Berg bestehen Decke, Boden und Waende aus schroffen Felsen. Man "+
        "kommt nur langsam voran und nicht selten muss man klettern. Wer weiss wo diese "+
        "Hoehle nur hinfuehren mag. ")); break;
    default:
      SetProp( P_INT_LONG, BS(
        "Hier in dieser Hoehle tief im Berg herrscht eine unheimliche Stille. Felsen ueberall und "+
        "die stickige Luft riecht auch nicht besonders frisch. Auf dem unwegsamen, felsigen Boden "+
        "kommt man nur langsam voran. ")); break;
  }
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND, BS(
    "Unheimliche Stille herrscht hier."));
  AddSound( ({ "stille", "geraeusch" }), BS(
    "Nicht das kleinste Geraeusch ist zu hoeren. "));
  AddSmell( DEFAULT_SMELL, BS(
    "Die Luft riecht abgestanden und muffig. "));
  AddSmell( ({ "luft", "geruch"}), BS(
    "Der fuer eine Hoehle typisch muffige Geruch liegt in der Luft."));

  AddDetail( ({ "luft", "geruch" }), BS(
    "Hier hilft riechen wohl eher."));
  AddDetail( ({ "stille", "geraeusch" }), BS(
    "Versuch doch lieber soetwas zu erlauschen."));
  AddDetail( ({ "boden", "untergrund" }), BS(
    "Natuerliches Felsgestein bildet den unwegsamen Untergrund. Oft liegen abgebrochene "+
    "Felsbrocken und Steine in deinem Weg. "));
  AddDetail( ({ "decke" }), BS(
    "Das Felsgestein ueber deinem Kopf ist hin und wieder von kleinen Rissen durchzogen. "+
    "Oft kannst Du aufrecht gehen aber hin und wieder musst Du an tiefhaengenden Felsvorspruengen "+
    "auf deinen Kopf aufpassen."));
  AddDetail( ({ "waende", "wand" }), BS(
    "Zerkluefteter Fels bildet die Waende. Felsbrocken und grosse Steine bilden Nischen und "+
    "verborgene Winkel."));
  AddDetail( ({ "hoehle", "hoehlen" }), BS(
    "Du befindest Dich tief im Berg in einer feuchtkalten Hoehle. Die Waende, Decke "+
    "und Boden bestehen aus groben Felsen, und nur selten kann man bequem voranschreiten. "+
    "Nischen und Spalten sind zwischen den Felsen zu finden und Vorspruenge erschweren "+
    "Dir den Weg."));
  AddDetail( ({ "berg" }), BS(
    "Du befindest dich mitten im Berg."));
  AddDetail( ({ "nischen", "winkel" }), BS(
    "In den Nischen und Winkeln ist nichts als Steine und Fels zu finden."));
  AddDetail( ({ "spalten", "risse" }), BS(
    "Spalten und Risse ziehen sich durch dir Felsen. Selten breiter als ein Finger, ziehen sich diese "+
    "ueber Waende, Decke und Boden. "));
  AddDetail( ({ "felsvorspruenge", "vorspruenge", "hindernisse" }), BS(
    "Von der Decke haengend oder aus dem Boden ragend bilden diese Vorspruenge des Gestein "+
    "die groessten Hindernisse beim vorankommen in dieser Hoehle."));
  AddDetail( ({ "weg" }), BS(
    "Es ist oft schwer zu erkennen wo die Hoehle weiter begehbar ist. Nischen und Winkel koennten "+
    "weiterfuehrende Hoehlen sein. "));
  AddDetail( ({ "finger", "fingern" }), BS(
    "An deinen Fingern ist nichts besonderes zu erkennen."));
  AddDetail( ({ "kopf", "stelle" }), BS(
    "Dein Kopf befindet sich noch an der richtigen Stelle."));

/*
  AddDetail( ({ "" }), BS(
    ""));
*/

  AddSpecialDetail( ({"fels", "felsen", "felsgestein", "gestein", "steine", "granit", "felsbrocken"
                      "basalt", "urzeitfels", "graufels", "braunfels", "brocken", "felsbrocken"}), 
    "unt_felsen");
}

string unt_felsen()
{
  if( TP->QueryProp(P_RACE) == "zwerg" )
  {
    return BS("Du schaust Dir den Fels genau an und erkennst seine Sorte eindeutig als "+felsen[i]+".\n");
  }
  return "Nur ganz normales Felsgestein. \n";
}