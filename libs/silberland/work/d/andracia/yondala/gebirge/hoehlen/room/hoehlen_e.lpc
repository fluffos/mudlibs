#include "../def.h"

// die datei gibt es nicht - hactar laed mal die die alle anderen laden
// inherit HOEHLEN_ROOM + "hoehle_grob_raw.lpc";
inherit HOEHLEN_ROOM + "hoehle_abc.lpc";

#include <properties.h>

string EINGANG = "/d/andracia/yondala/gebirge/thumfels/room/thumfels_g1.lpc";

void init()
{
  ::init();
  if (interactive(this_player()))
  {
    catch(call_other( EINGANG, "???"));
  }
}


void create() 
{
  ::create();
  AddItem( THUM_NPC+"durc.lpc", REFRESH_DESTRUCT );
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Die Hoehle endet hier an einem Tor mit zwergischen Runen. "+
     "Eine hoch ueber dem Tor angebrachte Laterne erleuchtet das Tor und diesen Bereich der Hoehle.") );
  SetProp( P_LIGHT, 1 );

  AddDetail( ({ "tor", "pforte", "tuer", "eisen" }), BS(
    "Das Tor verschliesst hier die gesammte Hoehle. Es ist mit viel Eisen beschlagen und "+
    "durch ein verschliessbares Guckloch auf Zwergenhoehe kann die Wache die warscheinlich dahinter "+
    "steht, hier in die Hoehle schauen. "));
  AddSpecialDetail( ({ "runen" }), "unt_runen");
  AddDetail( ({ "laterne", "licht", "lichtquelle" }), BS(
    "Die Laterne haengt sehr hoch und Du kannst sie nicht erreichen. Sie erhellt den gesamten Bereich vor dem Tor."));
  AddDetail( ({ "wache", "waechter", "zwergenwache" }), BS(
    "Die Zwergenwache steht wohl hinter dem Tor. Klopf doch einfach mal an."));
  AddDetail( ({ "guckloch" }), BS(
    "Durch diese Guckloch kann die Zwergenwache nachschauen was hier in der Hoehle vor sich geht."));
  AddDetail( ({ "zwergenhoehe", "zwergenlaenge", "augenhoehe" }), BS(
    "Das Guckloch ist eben auf Augenhoehe eines Zwerges in dem Tor eingelassen."));
  AddDetail( ({ "bereich" }), BS(
    "Nur eine ganz normale Hoehle."));
  
/*
  AddDetail( ({ "" }), BS(
    ""));
*/    
  AddExit( "osten" , HOEHLEN_ROOM + "hoehlen_d.lpc");

  AddCmd( ({ "bitte", "ersuche", "erbitte" }), "cmd_bitte");
  AddCmd( ({ "klopfe", "klopf" }), "cmd_klopfe");
  AddCmd( ({ "frag", "frage" }), "cmd_fragen");

  AddCmd( ({ "oeffne" }), "cmd_oeffnen");

}

int cmd_oeffnen(string str)
{
	if( !str ) return 0;
  if( str!="tor" && str!="tuer" && str!="pforte" ) return 0;
	write( BS("Du schaffst es nicht, das Tor zu oeffnen. Dir kommt es so vor, als ob das Tor nur von Innen geoeffnet werden kann. ") );
	return 1;
}

int cmd_fragen(string str)
{
	string fwen, fwas;
	if( !str ) return 0;
	if( sscanf(str, "%s nach %s", fwen, fwas)!=2 ) return 0;
  if( fwen!="zwerg" && fwen!="zwergenwache" && fwen!="zwergenwaechter" && fwen!="wache" && fwen!="waechter" ) return 0;
	if( !present( "\ntorwache", to_object(EINGANG) ) ) {
		write( BS("Niemand antwortet.") );
		return 1;
	}
  switch( fwas )
  {
  	case "einlass":
  	case "eintritt":
    case "tor":
    case "tor oeffnen":
  		write( BS("Der zwergische Torwache beaeugt Dich eingehend durch das Guckloch und laesst Dich passieren.") );
	  	TP->move(EINGANG, M_GO);
		  return 1;
  	default:
  		write( BS("Der zwergische Torwache fragt: Wollt Ihr nicht lieber erst herein?") );
  }	
  return 1;	
}

int cmd_bitte(string str)
{
	notify_fail(BS("Um was willst Du bitten?"));
	if( str != "einlass" && str != "um einlass" && str !="zugang" && str != "um zugang" ) return 0;
	if( !present( "\ntorwache", to_object(EINGANG) ) ) {
		write( BS("Niemand antwortet.") );
		return 1;
	} else {
		// gibt es denn irgendwelche Gruende warum jemand nicht eingelassen wird? Zu boese?
		
		
		write("Yondala erlaubt noch nicht, dass jemand die Zwergenstadt betritt.\nBitte hab Geduld.\n");
		//write( BS("Der zwergische Torwache beaeugt Dich eingehend durch das Guckloch und laesst Dich passieren.") );
		//TP->move(EINGANG, M_GO);
		return 1;
	}
}

int cmd_klopfe(string str)
{
	notify_fail(BS("Wo willst Du klopfen??"));
	if( str != "tor" && str != "an tor" ) return 0;
	if( !present( "\ntorwache", to_object(EINGANG) ) ) {
		write( BS("Niemand antwortet.") );
		return 1;
	} else {
		write( BS("Der zwergische Torwache beaeugt Dich eingehend durch das Guckloch und fragt nach Deinem Begehr.") );
		return 1;
	}
}

string unt_runen()
{
  if( TP->QueryProp(P_RACE) == "zwerg" )
  {
    return BS("Diese Runen bedeuten eine Warnung an alle, die den Zwergen Boeses wollen.");
  }
  return "Du kannst leider nicht entschluesseln, was die Runen bedeuten. \n";
}
