// huehnerstall
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Huehnerstall" );
  SetProp( P_INT_LONG,
     BS("Du befindest Dich im Huehnerstall. Hier haben die Huehner ihre Brutnischen "+
     "und sind bei schlechtem Wetter geschuetzt."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Das Gackern der Huehner dringt an Dein Ohr. "));
  AddSound( ({ "gackern" }),
    BS("Huehner Gackern - klingt ganz normal. "));
  AddSmell( DEFAULT_SMELL,
    BS("Der typische Geruch von Huehnerdreck haengt hier in der Luft. "));
  AddSmell( ({ "geruch", "huehnerdreck", "dreck" }),
    BS("Wenn Huehner eingesperrt leben so ist das der typische Geruch der entsteht."));
  AddSmell( ({ "luft" }),
    BS("Der typische Geruch von Huehnerdreck haengt hier."));

  AddDetail( ({ "boden", "stroh" }),
    BS("Stroh bedeckt den Boden."));
  AddDetail( ({ "decke" }),
    BS("Einfache Holzlatten bilden die Decke."));
  AddDetail( ({ "waende", "wand" }),
    BS("Einfach Holzlatten bilden die Waende."));
  AddDetail( ({ "huehnerstall", "stall", "stalls", "verschlag" }),
    BS("Der Huehnerstall ist ein mannshoher Verschlag aus Holzlatten. "+
    "An den Seiten sind mehrer Nischen aus Holz in denen die Huehner "+
    "brueten und schlafen koennen. "));
  AddDetail( ({ "huehner", "huhn"}),
    BS("Schau dich um - vielleicht findest Du ja welche im Huehnergehege. "));
  AddDetail( ({ "ohr" }),
    BS("Naja - Dein Ohr eben - nichts besonderes daran."));
  AddDetail( ({ "huehnerdreck", "dreck" }),
    BS("Du kannst nicht besonderes daran entdecken - ausser dass es eklig ist."));
  AddDetail( ({ "luft" }),
    BS("Ganz normale Luft. "));
  AddDetail( ({ "nischen", "brutnischen", "nest", "nester" }),
    BS("Durch Holz abgetrennte Nischen, die mit ein bischen Stroh gefuellt sind, "+
    "sollen den Huehnern dazu dienen ihre Eier dort zu legen und zu schlafen. "));
  AddDetail( ({ "holzlatten", "holz" }),
    BS("Einfaches Holz. Es ist nichts besonderes daran zu erkennen. "));
  AddDetail( ({ "huehnergehege", "gehege", "geheges" }),
    BS("Das Gehege befindet sich im Norden des Stalls. "));
  AddDetail( ({ "wetter" }),
    BS("Es scheint schoenes Wetter draussen zu herrschen."));
  AddDetail( ({ "eier" }),
    BS("Du musst hier wohl erst nach Eiern suchen."));
  AddDetail( ({ "stroh", "nestunterlage" }),
    BS("Ein bischen Stroh dient den Huehnern als Nestunterlage in ihren Brutnischen."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
    
  AddExit( "norden", ROOM + "gehoeft_c1.lpc" );

  AddItem( NPC + "huhn.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "huhn.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "hahn.lpc", REFRESH_DESTRUCT );

  AddCmd( ({ "suche", "such" }), "eier_suchen" );
  
}

// Hier soll man sich Eier besorgen koennen.

int eier_suchen(string str)
{ 
  object ob;
  int zufall;
  notify_fail("Was willst Du suchen? \n");
  if( str != "eier" && str != "ei" && str != "ein ei" && 
  	str != "nach eier" && str != "nach einem ei" && str != "nach ei" ) return 0;
  notify_fail("Du hast Doch schon genuegend Eier! \n");
  if( present("\nei 3",TP) ) return 0;
  zufall = random(2);
  if(zufall == 0)	{
    SUID;
    ob = clone_object(OBJ + "kuchen_ei.lpc");
    ob->move(TP, M_GET);
    write("Du suchst in den Nischen nach Eiern und findest tatsaechlich eines. \n");
    say(TPN + " sucht in den Nischen nach Eiern und findet tatsaechlich eines. \n"); return 1;}
  else {
    write("Du suchst in den Nischen nach Eiern und findest leider keines. \n");
    say(TPN + " sucht in den Nischen nach Eiern und findet keines. \n"); return 1;}
}
