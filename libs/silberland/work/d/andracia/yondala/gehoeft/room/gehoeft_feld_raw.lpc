// getreidefeld
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Getreidefeld" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich in einem Getreidefeld das huefthoch mit "+
     "Weizen steht. Bald kann der Bauer es abernten."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst nur das Rauschen wie der Wind durch das Getreide streicht."));
  AddSound( ({ "rauschen", "getreide" }),
    BS("Der Wind laesst das Getreide aneinander reiben und so entsteht diesses typische Rauschen eines Felds"));
  AddSound( ({ "wind" }),
    BS("Der Wind streicht durchs Getreide."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht nach Weizen."));
  AddSmell( ({ "weizen" }),
    BS("Du stehst in einem Weizenfeld. Was erwartest Du wonach es hier riechen wird?"));

  AddDetail( ({ "himmel" }),
    BS("Tiefblauer Himmel verspricht sehr gutes Wetter fuer den Tag."));
  AddDetail( ({ "wetter", "tag" }),
    BS("Dem tiefblauen Himmel nach zu urteilen wird es heute sonnig und sehr schoen."));
  AddDetail( ({ "boden", "erde" }),
    BS("Das Getreide gedeiht in dieser dunkelbraunen Erde wohl sehr gut."));
  AddDetail( ({ "getreidefeld", "feld", "weizenfeld" }),
    BS("Du stehst mittendrin."));
  AddDetail( ({ "getreide", "weizen" }),
    BS("Huefthoh steht der Weizen und kann bald abgeerntet werden."));
  AddDetail( ({ "bauer" }),
    BS("Der Bauer hat dieses Feld gepflegt. "));
  AddDetail( ({ "wind" }),
    BS("Du spuerst nur einen leichten Wind."));
  AddDetail( ({ "huefthoehe" }),
    BS("Die Huefthoehe von Menschen ist hierbei gemeint."));
  AddDetail( ({ "menschen" }),
    BS("Das Huegelland wird vorallem von Menschen bevoelkert."));

}
