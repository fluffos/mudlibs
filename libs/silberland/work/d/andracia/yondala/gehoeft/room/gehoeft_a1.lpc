// Kuhstall
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Kuhstall" );
  SetProp( P_INT_LONG,
     BS("Du stehst in einem Kuhstall. In zwei einfachen Verschlaegen "+
     "koennen Kuehe untergebracht werden. Das einfache Dach und die "+
     "Bretterwaende schuetzen die Kuehe vor Regen und Kaelte. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst hier nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Der Duft von Kuhfladen und trockenem Stroh herrscht hier. "));
  AddSmell( ({ "duft", "kuhfladen", "fladen", "stroh", "kuhstall", "stall", "kuhstalls", "geruch" }),
    BS("Der typische Geruch eines Kuhstalls. "));

  AddDetail( ({ "boden" }),
    BS("Der steinerne Boden ist innerhalb der Verschlaege mit Stroh "+
    "bedeckt. Die Kuehe haben das Stroh schon mit ihren Ausscheidungen "+
    "stark verdreckt. Wird Zeit dass der Paechter den Stall wieder ausmistet. "));
  AddDetail( ({ "decke", "dach" }),
    BS("Man kann den Dachstuhl und die Unterseite der Schindeln sehen."));
  AddDetail( ({ "wand", "waende", "bretterwaende", "bretterwand" }),
    BS("Eine normale Scheune aus Holzbrettern. "));
  AddDetail( ({ "kuhstall", "stall", "scheune" }),
    BS("Eine einfache Konstruktion. Holzbalken bilden das Geruest und "+
    "Bretter zu den Seiten erzeugen passable Waende. "));
  AddDetail( ({ "verschlag", "verschlaege", "verschlaegen", "bereiche" }),
    BS("Mit Holzbrettern abgegrenzte Bereiche aus denen die Kuehe nicht "+
    "heraus koennen bilden zwei Verschlaege fuer die Kuehe."));
  AddDetail( ({ "kuehe" }),
    BS("Versuch es lieber mit einer einzelnen Kuh."));
  AddDetail( ({ "regen", "kaelte" }),
    BS("Wenn eine Kuh im kalten Regen steht so wird davon die Milch "+
    "bestimmt nicht besser."));
  AddDetail( ({ "stroh" }),
    BS("Wenn das Getreide geerntet und vom Korn befreit wurde, bleibt nur "+
    "das Stroh uebrig. "));
  AddDetail( ({ "ausscheidungen", "fladen", "kuhfladen", "mist" }),
    BS("Igitt - besonders richen tut es nicht. "));
 // In den Dreck greifen?
  AddDetail( ({ "zeit", "jahre" }),
    BS("Zeit vergeht ..."));
  AddDetail( ({ "paechter", "gehoeft", "lehen" }),
    BS("Dieses Gehoeft hier ist ein Lehen des Freiherrn von Zwirbelstein. "));
  AddDetail( ({ "dachstuhl", "holzgeruest" }),
    BS("Das Holzgeruest, das das Dach traegt, ist noch jung und wird noch "+
    "viele Jahre die Schindeln tragen. "));
  AddDetail( ({ "schindeln", "schiefertafeln" }),
    BS("Schiefertafeln wurden zu Schindeln geschnitten und bedecken das Dach. "));
  AddDetail( ({ "unterseite" }),
    BS("Die Schindeln sind zu hoch um deren Unterseite zu untersuchen."));
  AddDetail( ({ "holz", "bretter", "holzbretter", "balken", "holzbalken", "baustoff" }),
    BS("Normales Holz - der universelle Baustoff. "));
  AddDetail( ({ "getreide", "korn", "feld" }),
    BS("Geh doch aufs Feld und schau dich dort um. "));
  AddDetail( ({ "geruest", "konstruktion", "holzkonstruktion" }),
    BS("Dieser Kuhstall ist eine einfache Holzkonstruktion."));
  AddDetail( ({ "kuh", "milch", "kuehe" }),
    BS("Schon mal gehoert dass man Kuehe melken kann und dadurch Milch geben?"));
  AddDetail( ({ "freiherr", "zwirbelstein" }),
    BS("Dem Freiherr von Zwirbelstein gehoert diese Herberge und der Paechter betreibt sie."));
  AddDetail( ({ "herberge" }),
    BS("Das geht von hier aus nicht."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddExit( "osten", ROOM + "gehoeft_b1.lpc" );

  AddItem( NPC + "kuh.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "kuh.lpc", REFRESH_DESTRUCT );

}
