// Hof
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Hof der Herberge" );
  SetProp( P_INT_LONG,
     BS("Du bist auf dem Hof der Herberge."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    BS("Das Gegacker von Huehnern dringt aus dem Huehnerstall im Osten, waehrend man hin und wieder "+
    "das Muhen eine Kuh aus dem Nordwesten hoeren kann."));
  AddSound( ({ "gegacker", "huehner" }),
    BS("Das Gegacker scheint aus dem Huehnerstall im Osten zu kommen."));
  AddSound( ({ "muhen", "kuehe", "muhlaute" }),
    BS("Im Nordwesten steht ein Kuhstall aus welchem wohl die Muhlaute kommen."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst hier nichts besonderes riechen."));

  AddDetail( ({ "boden", "untergrund" }),
    BS("Der Boden besteht aus einfachen Steinen. "));
  AddDetail( ({ "huehner" }),
    BS("Die Huehner befinden sich im Huehnerstall. Man kann hier nur ihr Gegacker hoeren."));
  AddDetail( ({ "kuehe", "kuhstall", "kuh" }),
    BS("Ein Kuhstall im Nordwesten scheint ein paar Kuehe zu beherbergen, zumindest kann man hin und wieder "+
    "von dort Muhlaute hoeren."));
  AddDetail( ({ "huehnerstall" }),
    BS("Oestlich vom Hof steht ein einfacher Huehnerstall."));
  AddDetail( ({ "hof" }),
    BS("Du stehst auf dem steinigen Hof der Herberge zwischen Zwirbelstein und dem Hafendorf."));
  AddDetail( ({ "herberge", "gebaeude" }),
    BS("Das etwas groessere Gebaeude im Westen ist wohl die Herberge. "));
  AddDetail( ({ "weg", "pfad", "feldweg" }),
    BS("Im Suedosten fuehrt ein kleiner Feldweg zurueck zur Strasse am Waldrand."));
  AddDetail( ({ "hafendorf" }),
    BS("Wenn man der Strasse nach Westen folgt so kommt man zum nahen Hafendorf."));
  AddDetail( ({ "himmel" }),
    BS("Tiefblauer Himmel verspricht sehr gutes Wetter fuer den Tag."));
  AddDetail( ({ "wetter", "tag" }),
    BS("Dem tiefblauen Himmel nach zu urteilen wird es heute sonnig und sehr schoen."));
  AddDetail( ({ "steine", "stein" }),
    BS("Nur einfache Steine die hier den Untergrund bilden."));
  AddDetail( ({ "strasse" }),
    BS("Die Strasse im Sueden fuehrt am Waldrand entlang von Ost nach West"));
  AddDetail( ({ "zwirbelstein" }),
    BS("Wenn man der Strasse nach Osten folgt so kommt man nach Zwirbelstein."));
  AddDetail( ({ "waldrand" }),
    BS("Im Sueden ist der Wald und am Waldrand entlang verlaeuft die Strasse von Ost nach West."));
  AddDetail( ({ "wald" }),
    BS("Dazu musst Du den Wald erstmal betreten."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
}
