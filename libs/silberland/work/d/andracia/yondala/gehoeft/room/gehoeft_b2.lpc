#include "../def.h"

inherit ROOM + "gehoeft_hof_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Im Westen kann man die Herberge betreten.") );
     
  AddExit( "norden" , ROOM + "gehoeft_b1.lpc");
  AddExit( "westen" , ROOM + "gehoeft_a2.lpc" );
  AddExit( "sueden" , ROOM + "gehoeft_b3.lpc" );

  AddItem( NPC + "katze.lpc", REFRESH_DESTRUCT );

}
