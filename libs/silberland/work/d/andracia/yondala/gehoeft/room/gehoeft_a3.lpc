// Schlafsaal
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Schlafsaal" );
  SetProp( P_INT_LONG,
     BS("Das ist der Schlafsaal der Herberge. Mehrere einfache Betten stehen "+
     "hier. Gefuellt mit Stroh und mit einem Betttuch  ueber den Bettkasten gespannt, "+
     "sind die Betten schon fast komfortabel zu nennen. Ein paar Truhen stehen "+
     "an der Wand und sollen den Reisenden dazu dienen waehrend der Nacht "+
     "ihre Habe unterzubringen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst hin und wieder die Geraeusche der im Gehoeft lebenden "+
    "Tiere, also nicht besonderes. "));
  AddSound( ({ "geraeusche", "tiere", "tier" }),
    BS("Geh lieber nach draussen, da kannst Du das besser hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst hier nichts besonderes riechen."));

  AddDetail( ({ "boden", "holzbohlen", "bohlen" }),
    BS("Man geht hier auf normalen abgetretenen Holzbohlen. "));
  AddDetail( ({ "decke" }),
    BS("Die Holzbohlen des darueberliegenden Stockwerks bilden hier die Decke. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Normale, verputzte Waende - Du kannst nichts besonderes daran erkennen."));
  AddDetail( ({ "schlafsaal" }),
    BS("Mehrere einfache Betten stehen hier. Gefuellt mit Stroh und ein Betttuch "+
    "gespannt ueber den Bettkasten sind die Betten schon fast komfortabel zu "+
    "nennen. Ein paar Truhen stehen an der Wand."));
  AddDetail( ({ "herberge" }),
    BS("Hier kann man sich von seiner Reise ausruhen."));
  AddDetail( ({ "betten" }),
    BS("Gefuellt mit Stroh und ein Betttuch gespannt ueber den Bettkasten sind die "+
    "Betten schon fast komfortabel zu nennen. "));
  AddDetail( ({ "stroh" }),
    BS("Damit sind die Bettkaesten gefuellt damit die Reisenden etwas weicher liegen."));
  AddDetail( ({ "betttuch", "bettuch", "leinentuch", "leinentuecher" }),
    BS("Grobe Leinentuecher halten das Stroh der Betten im Zaum. Dadurch muessen die "+
    "Reisenden nicht direkt auf dem Stroh schlafen. "));
  AddDetail( ({ "bettkasten", "kasten", "bettkaesten", "kaesten", "holzrahmen" }),
    BS("Die Bettkaesten sind einfache Holzrahmen die mit Stroh gefuellt werden."));
  AddDetail( ({ "truhen", "truhe" }),
    BS("Die Truhen stehen an der  Wand und sollen den Reisenden dazu dienen waehrend "+
    "der Nacht ihre Habe unterzubringen. Sie sind aus Holz und haben kein Schloss."));
  AddDetail( ({ "reisende", "reisenden", "fremde" }),
    BS("Viele Reisende kehren hier ein um sich auszuruhen, zu essen oder die "+
    "Nacht zu verbringen. "));
  AddDetail( ({ "habe" }),
    BS("Wenn ein Reisender hier einkehrt kann er seine Habe in den Truhen verstauen. "+
    "Da es Dir nicht gehoert lass lieber die finger davon. "));
  AddDetail( ({ "holz", "baustoff" }),
    BS("Wichtigster Baustoff ist und bleibt Holz."));
  AddDetail( ({ "tiere", "tier" }),
    BS("Die Tiere des Gehoefts sind alle draussen in ihren Staellen."));
  AddDetail( ({ "gehoeft", "gehoefts", "ort" }),
    BS("Die Scheune, der Huehnerstall und das Wohnhaus bilden das Gehoeft. "));
  AddDetail( ({ "wohnhaus", "haus", "wohnhauses" }),
    BS("Dieser Schlafsaal ist Teil des Wohnhauses vom Gehoeft. "));
  AddDetail( ({ "huehnerstall" }),
    BS("Den Huehnerstall findet man vom Hof aus."));
  AddDetail( ({ "scheune", "staelle" }),
    BS("Sieh dich hierzu lieber auf dem Hof um."));
  AddDetail( ({ "stockwerk", "stockwerks", "erdgeschoss" }),
    BS("Du befindest dich im Erdgeschoss."));
  AddDetail( ({ "reise", "reisender" }),
    BS("Du selbst befindest dich auf einer abenteuerlichen Reise,"));
  AddDetail( ({ "schloss" }),
    BS("Die Truhen haben kein Schloss."));
  AddDetail( ({ "hof" }),
    BS("Von hier aus? Wie soll das denn gehen?"));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddExit( "norden", ROOM + "gehoeft_a2.lpc" );

}
