// huehnergehege
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Huehnergehege" );
  SetProp( P_INT_LONG,
     BS("Du stehst im Huehnergehege. Hier haben die Huehner des Gehoefts "+
     "Platz zum laufen, scharren, picken und gackern. Eine grosse Schale mit "+
     "Koernern steht in der Mitte des Geheges. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    BS("Das Gackern der Huehner dringt an Dein Ohr. "));
  AddSound( ({ "gackern", "huehnergackern" }),
    BS("Huehnergackern - klingt ganz normal. "));
  AddSmell( DEFAULT_SMELL,
    BS("Der typische Geruch von Huehnerdreck haengt hier in der Luft. "));
  AddSmell( ({ "geruch", "huehnerdreck", "dreck" }),
    BS("Wenn Huehner eingesperrt leben so ist das der typische Geruch der entsteht."));
  AddSmell( ({ "luft" }),
    BS("Der typische Geruch von Huehnerdreck haengt hier."));

  AddDetail( ({ "boden", "platz" }),
    BS("Die Huehner verhindern dass hier jemals wieder Gras waechst. Daher "+
    "liegt das braune Erdreich offen. "));
  AddDetail( ({ "huehnergehege", "gehege", "geheges" }),
    BS("Das Gehege ist ein mannshohes Brettergeruest das mit Netzen an "+
    "den Seiten abgeschlossen ist. So kann der Wind durch das Gehege "+
    "wehen aber die Huehner nicht fluechten. "));
  AddDetail( ({ "huehner", "huhn"}),
    BS("Schau dich um - vielleicht findest Du ja welche im Huehnerstall. "));
  AddDetail( ({ "schale" }),
    BS("In der Schale sind Koerner die als Futter fuer die Huehner gedacht ist."));
  AddDetail( ({ "koerner", "korn", "getreide" }),
    BS("Das ist das Futter der Huehner. "));
  AddDetail( ({ "gras" }),
    BS("Hier waechst keines."));
  AddDetail( ({ "erdreich" }),
    BS("Die Huehner haben das Erdreich platt getreten. "));
  AddDetail( ({ "ohr" }),
    BS("Naja - Dein Ohr eben - nichts besonderes daran."));
  AddDetail( ({ "huehnerdreck", "dreck" }),
    BS("Du kannst nicht besonderes daran entdecken - ausser dass es eklig ist."));
  AddDetail( ({ "luft" }),
    BS("Ganz normale Luft. "));
  AddDetail( ({ "futter" }),
    BS("Getreide und andere Koerner sind in einer Schale am Boden."));
  AddDetail( ({ "brettergeruest" }),
    BS("Das Brettergeruest umspannt das Huehnergehege. Dadurch koennen "+
    "die Huehner nicht vom Hof laufen und eine Beute des Fuchs werden. "));
  AddDetail( ({ "netz", "netze", "netzen" }),
    BS("Diese Netze wurden auf das Brettergeruest gespannt damit die Huehner "+
    "nicht aus dem Gehege entlaufen koennen. "));
  AddDetail( ({ "huehnerstall", "stall", "stalls", "bau" }),
    BS("Der Huehnerstall befindet sich im Sueden des Geheges. "));
  AddDetail( ({ "beute" }),
    BS("Wenn die Huehner frei herumlaufen koennten, waeren sie leichte Beute fuer den Fuchs."));
  AddDetail( ({ "fuchs" }),
    BS("Der Fuchs wuerde gern die Huehner als Beute zu seinem Bau schaffen."));
  AddDetail( ({ "wind", "haut" }),
    BS("Du spuerst den Wind auf Deiner Haut."));
  AddDetail( ({ "hof" }),
    BS("Dazu musst Du erst wieder heraus aus dem Huehnerstall."));
  AddDetail( ({ "gehoeft", "herberge" }),
    BS("Dieser Huehnerstall ist Teil des Gehoefts."));
  AddDetail( ({ "himmel" }),
    BS("Du siehst nur tiefblauen Himmel."));
  AddDetail( ({ "bretter" }),
    BS("Sie gehoeren zum Gehege."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddExit( "westen", ROOM + "gehoeft_b1.lpc" );
  AddExit( "sueden", ROOM + "gehoeft_c2.lpc" );

  AddItem( NPC + "huhn.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "huhn.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "huhn.lpc", REFRESH_DESTRUCT );
  

}
