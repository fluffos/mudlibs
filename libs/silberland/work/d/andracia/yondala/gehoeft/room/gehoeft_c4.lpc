// feldweg
#include "../def.h"

inherit "std/room.lpc";

#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Feldweg" );
  SetProp( P_INT_LONG,
     BS("Dieser kurze Feldweg fuehrt von der Strasse zur Herberge."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    BS("Nur das Zwitschern der Voegel liegt in der Luft."));
  AddSmell( DEFAULT_SMELL,
    BS("Du riechst frische Landluft."));
  AddSound( ({ "zwitschern", "voegel" }),
    BS("Nur das zwitschen von Voegeln ist zu hoeren."));
  AddSmell( ({ "luft", "landluft", "aroma", "geruch" }),
    BS("Es riecht nach Getreide, Gras und Kuhmist. "));
  AddSmell( ({ "getreide" }),
    BS("Im Nordosten befindet sich ein grosses Getreidefeld. Der Geruch scheint von dort zu stammen."));
  AddSmell( ({ "kuhmist" }),
    BS("Du folgst dem Aroma von Kuhmist und schliesst dass sich bei der Herberge Kuehe befinden muessen."));

  AddDetail( ({ "boden" }),
    BS("Neben dem Weg ist der Boden grasbewachsen."));
  AddDetail( ({ "himmel" }),
    BS("Tiefblauer Himmel verspricht sehr gutes Wetter fuer den Tag."));
  AddDetail( ({ "weg", "feldweg", "pfad" }),
    BS("Der Feldweg ist nur ein niedergetrampeltes Stueck Wiese."));
  AddDetail( ({ "strasse" }),
    BS("Am Waldrand entang fuehr die Strasse von Zwirbelstein im Osten zum Hafen im Westen. "+
    "Sie ist gut ausgebaut und eine Kutsche faehrt darauf."));
  AddDetail( ({ "herberge" }),
    BS("Du musst diesem Pfad nach Nordwesten folgen um zur Herberge zu kommen."));
  AddDetail( ({ "luft", "landluft" }),
    BS("Versuchs mal lieber mit riechen."));
  AddDetail( ({ "vogel", "voegel", "bahnen" }),
    BS("Du kannst die Voegel am Himmel ihre Bahnen ziehen sehen. "));
  AddDetail( ({ "wiese", "huegelland", "huegel" }),
    BS("Die Huegel des Huegellands sind mit saftig gruenem Gras bewachsen. "));
  AddDetail( ({ "gras" }),
    BS("Das Gras ist saftig gruen. "));
  AddDetail( ({ "wetter", "tag" }),
    BS("Dem tiefblauen Himmel nach zu urteilen wird es heute sonnig und sehr schoen."));
  AddDetail( ({ "stueck" }),
    BS("Was willst Du untersuchen?"));
  AddDetail( ({ "kutsche" }),
    BS("Die Kutsche, die zwischen Hafen und Zwirbelstein pendelt, kann man den Waldrand entlang fahren sehen. "));
  AddDetail( ({ "osten", "zwirbelstein", "dorf", "burg" }),
    BS("Im Osten befindet sich die Burg Zwirbelstein mit ihrem kleinen Dorf, ueber das die Burg wacht."));
  AddDetail( ({ "westen", "hafen", "hafendorf" }),
    BS("Im Westen kann man nur wenig vom Hafendorf sehen. Die Huegel des Huegelland versperren Dir die Sicht."));
  AddDetail( ({ "stueck wiese" }),
    "Du untersuchst in einem kleinen Bereich Wiese jeden Grashalm ...  \n"+
    "Du kannst aber nichts besonderes am Gras entdecken. \n");
  AddDetail( ({ "waldrand", "kreuzung" }),
    BS("Ein kleines Stueck im Sueden befindet sich eine kleine Kreuzung direkt am Waldrand."));
  AddDetail( ({ "sicht" }),
    BS("Man kann ringsum saftig gruene, grasbewachsene Huegel sehen. Im Sueden verlauft eine "+
    "Strasse dem Waldrand entlang. Im Osten kann man noch die Umrisse von Burg zwirbelstein sehen."+
    "Im Nordosten wurde ein Getreidefeld angelegt und im Nordwesten befindet sich die Herberge."));
  AddDetail( ({ "umrisse" }),
    BS("Das scheint Burg Zwirbelstein zu sein."));
  AddDetail( ({ "kuhmist" }),
    BS("Das befindet sich woanders, man kann es nur riechen. "));
  AddDetail( ({ "getreide", "getreidefeld" }),
    BS("Im Nordosten befindet sich ein grosses Getreidefeld. Dorf kannst Du dich naeher mit Getreide befassen. "));
  AddDetail( ({ "nordwesten" }),
    BS("Dort befindet sich die Herberge."));
  AddDetail( ({ "nordosten", "getreidefeld" }),
    BS("Ein Getreidefeld wurde dort im nordosten angelegt."));
  AddDetail( ({ "kuehe" }),
    BS("Es sind vielleicht welche bei der Herberge."));

/*
  AddDetail( ({ "" }),
    BS(""));

*/

  AddExit( "nordosten", ROOM + "gehoeft_d3.lpc" );
  AddExit( "nordwesten", ROOM + "gehoeft_b3.lpc" );
  AddExit( "sueden", KREUZUNG_03 );

}
