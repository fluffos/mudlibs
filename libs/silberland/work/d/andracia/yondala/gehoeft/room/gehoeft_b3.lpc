#include "../def.h"

inherit ROOM + "gehoeft_hof_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Hier fuehrt der Feldweg zurueck zur Strasse. \n" );
    
  AddExit( "norden" , ROOM + "gehoeft_b2.lpc");
  AddExit( "suedosten" , ROOM + "gehoeft_c4.lpc" );

}
