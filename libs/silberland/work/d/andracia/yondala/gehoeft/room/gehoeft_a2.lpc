// Gastraum (PUB)
inherit "std/pub.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>
 
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Gastraum des Gehoefts" );
  SetProp( P_INT_LONG,
     BS("Hier ist der Gastraum des Gehoefts. Da der Paechter sein Haus auch "+
     "als Herberge fuer Reisende anbietet, kann man in diesen Gastraum "+
     "allerlei Speisen und Getraenke bestellen. Schon fast eine Wirtschaft. "+
     "Ein paar Tische und Baenke stehen hier."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Jost Triffon");
  SetProp( P_PUBKEEPER_NAME, "der Paechter Jost Triffon");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst hin und wieder die Geraeusche der im Gehoeft lebenden "+
    "Tiere, also nicht besonderes. "));
  AddSound( ({ "geraeusche", "tiere", "tier" }),
    BS("Geh lieber nach draussen, da kannst Du das besser hoeren."));

  AddSmell( DEFAULT_SMELL,
    BS("Die Luft richt stickig nach Rauch und Staub. Man sollte hier mal "+
    "wieder lueften!"));
  AddSmell( ({ "rauch", "staub" }),
    BS("Stickig hier. "));

  AddDetail( ({ "boden", "holzbohlen", "bohlen" }),
    BS("Man geht hier auf normalen abgetretenen Holzbohlen. "));
  AddDetail( ({ "decke" }),
    BS("Die Holzbohlen des darueberliegenden Stockwerks bilden hier die Decke. "));
  AddDetail( ({ "waende", "waenden", "wand" }),
    BS("Der ehemals weisse Verputz hat scheinbar schon viele Jahre keinen "+
    "neuen Anstrich mehr bekommen. Der Rauch und Staub der Luft haben den "+
    "Waenden einen grauen Teint gegeben. "));
  AddDetail( ({ "gastraum", "wirtschaft", "raum", "raeume", "schankraum" }),
    BS("Ein paar Tische und Baenke stehen hier. Scheinbar ist diese Herberge "+
    "ein oft besuchter Ort der vorbeiziehenden Reisenden. Die Luft ist stickig "+
    "von Rauch und Staub. Scheinbar wurde hier seit langem nicht mehr gelueftet. "));
  AddDetail( ({ "gehoeft", "gehoefts", "ort" }),
    BS("Die Scheune, der Huehnerstall und das Wohnhaus bilden das Gehoeft. "));
  AddDetail( ({ "paechter", "wirt" }),
    BS("Der Paechter ist auch gleichzeitig der Wirt in diesem Gastraum."));
  AddDetail( ({ "wohnhaus", "haus", "wohnhauses" }),
    BS("Dieser Schankraum ist Teil des Wohnhauses vom Gehoeft. "));
  AddDetail( ({ "herberge" }),
    BS("Der Paechter des Gehoefts bietet Betten und Verpflegung fuer die "+
    "Reisenden an. Frag doch einfach mal was so alles als 'menue' angeboten wird. "));
  AddDetail( ({ "reisende", "reisenden", "fremde" }),
    BS("Viele Reisende kehren hier ein um sich auszuruhen, zu essen oder die Nacht "+
    "zu verbringen. "));
  AddDetail( ({ "speisen", "verpflegung", "getraenke", "bruehe" }),
    BS("Frag doch einfach mal was so alles als 'menue' angeboten wird. "));
  AddDetail( ({ "stockwerk", "stockwerks", "erdgeschoss" }),
    BS("Du befindest dich im Erdgeschoss. Die anderen Raeume sind das privat und "+
    "der Paechter moechte nicht dass Fremde dort herumschnueffeln. "));
  AddDetail( ({ "verputz", "anstrich" }),
    BS("Frueher waren die Waende wohl weiss - jetzt haben sie einen grauen Teint."));
  AddDetail( ({ "jahre" }),
    BS("Zeit kann man nicht auf diese Weise untersuchen."));
  AddDetail( ({ "rauch", "staub", "luft" }),
    BS("Die offene Feuerstelle und die Krautraucher haben ihren Teil Staub und "+
    "Rauch zur Luft hinzugefuegt. Es ist besonders stickig hier. "));
  AddDetail( ({ "teint" }),
    BS("Wessen Teint? Beschaeftige Dich lieber mit sinnvollerem."));
  AddDetail( ({ "tiere", "tier" }),
    BS("Die Tiere des Gehoefts sind alle draussen in ihren Staellen."));
  AddDetail( ({ "tische", "baenke", "tisch", "bank" }),
    BS("Die Tische und Baenke hier sind aus Holz und dienen den vorbeiziehenden "+
    "Reisenden zum hinsitzen und einnehmen ihrer Speisen. Schau doch auch mal "+
    "aufs 'menue'."));
  AddDetail( ({ "betten", "schlafsaal" }),
    BS("Im Sueden ist der Schlafsaal - da wirst Du Betten finden."));
  AddDetail( ({ "feuerstelle" }),
    BS("Ueber der offenen Feuerstelle haengt ein Topf mit Bruehe. Der Kamin "+
    "scheint nicht besonders gut zu sein denn der Rauch fuellt den Raum und "+
    "schwaengert die Luft."));
  AddDetail( ({ "holz", "baustoff" }),
    BS("Wichtigster Baustoff ist und bleibt Holz."));
  AddDetail( ({ "topf" }),
    BS("Eine Bruehe brodelt darin."));
  AddDetail( ({ "einlage" }),
    BS("Die Einlage besteht aus Huehnerfleisch. Nicht besonders viel, warscheinlich "+
    "wurde ein halbes Huhn auf den grossen Topf Bruehe verteilt. "));
  AddDetail( ({ "schmalzbrot", "brot" }),
    BS("Warscheinlich selbstgebackenes Brot."));
  AddDetail( ({ "regenwasser", "wasser" }),
    BS("Naja - die Regentonne steht draussen neben der Tuer ..."));
  AddDetail( ({ "bier" }),
    BS("Das wurde wohl selbstgebraut vom Paechter."));
  AddDetail( ({ "regentonne", "tonne" }),
    BS("Dazu musst Du schon nach draussen gehen."));
  AddDetail( ({ "huehnerstall" }),
    BS("Den Huehnerstall findet man vom Hof aus."));
  AddDetail( ({ "kamin" }),
    BS("Der Kamin spendet Waerme."));
  AddDetail( ({ "krautraucher", "raucher" }),
    BS("Frag am besten mal im Hobbitdorf nach solchen Dingen."));
  AddDetail( ({ "scheune", "staelle" }),
    BS("Sieh dich hierzu lieber auf dem Hof um."));
  AddDetail( ({ "weise", "weisheit" }),
    BS("Du sollst weise sein? nich wenn Du solche Dinge untersuchst."));
  AddDetail( ({ "dinge" }),
    BS("Hoer doch auf sinnloses Zeug zu untersuchen."));
  AddDetail( ({ "zeug" }),
    BS("Zeug wie Scriptfalle?"));
  AddSpecialDetail( ({ "scriptfalle" }), "unt_scriptfalle" );
  AddDetail( ({ "hobbitdorf" }),
    BS("Dazu musst Du dort erst hinreisen."));
  AddDetail( ({ "hof", "tuer" }),
    BS("Die Tuer im Osten fuehrt wieder hinaus zum Hof."));


/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddFood( "Gemuesebruehe mit Einlage", ({"bruehe", "gemuesebruehe"}),95, 18, 8,
         ({ "Du loeffelst deine Gemuesebruehe.",
            "&& laesst sich eine Gemuesebruehe schmecken." })  );
  AddFood( "Schmalzbrot", ({"schmalzbrot", "brot"}),65, 14, 8,
         ({ "Du isst ein leckeres Schmalzbrot.",
            "&& isst ein leckeres Schmalzbrot." }) );
  AddDrink( "Regenwasser", ({"regenwasser", "wasser"}),20, 15, 0, 3,
         ({ "Du trinkst mit einen Becher Wasser.",
            "&& laesst sich einen Becher Wasser." }) );
  AddDrink( "selbstgebrautes Bier", ({"bier"}), 85, ({10,20}), 2, 5,
         ({ "Das Bier hat einen eigenwilligen aber sehr sueffigen Geschmack.",
            "&& kippt sich einen Humpen Bier in den Rachen." }) );

  AddExit( "osten", ROOM + "gehoeft_b2.lpc" );
  AddExit( "sueden", ROOM + "gehoeft_a3.lpc" );
  
  AddItem( NPC + "jost_triffon.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "ulfried_porst.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "yuan_lupinez.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );
  
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 30+random(45), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}