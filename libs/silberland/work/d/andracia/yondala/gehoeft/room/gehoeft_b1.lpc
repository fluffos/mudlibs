#include "../def.h"

inherit ROOM + "gehoeft_hof_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Osten kann man den Huehnerstall und im Westen den Kuhstall betreten. \n" );
    
  AddExit( "osten" , ROOM + "gehoeft_c1.lpc");
  AddExit( "westen" , ROOM + "gehoeft_a1.lpc" );
  AddExit( "sueden" , ROOM + "gehoeft_b2.lpc" );

}
