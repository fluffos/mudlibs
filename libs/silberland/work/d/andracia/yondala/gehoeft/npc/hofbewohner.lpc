inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("hofbewohner")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
    
  AddId(({"hofbewohner"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Hofbewohner");
  SetProp( P_LONG, "Ein ganz normaler Hofbewohner");
  SetProp( P_NAME, "Hofbewohner");
  SetProp( P_GENDER, MALE);
  SetProp( P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 178); //in cm
  SetProp( P_WEIGHT, 78000); //in g
  SetProp( P_ALIGN, 0); //Gesinnung von -1000 bis +1000
  SetProp( P_MAX_HANDS, 2); //Anzahl Haende
  SetProp( P_HEAL, 0); //Essbarkeit von -4 bis +4
  // SetProp( P_AGGRESSIVE, ([0:0.0]); //nicht aggressiv
  SetProp( P_WIMPY, 0); //nicht flüchten
  SetProp( P_NOMAGIC, 0); //keinen Magiewiderstand
  SetProp( P_RESISTANCE_STRENGTHS ,  //Widerstand gegen Schadentypen -1 (immun) bis +1 (doppelt)
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.2, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.5, DT_SOUND: -0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.2]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmöglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Burgbewohner"); //string für Todessequenz
  SetProp( P_KILL_MSG, "HIHI - ich habe %s getoetet!");
  // SetProp( P_LOG_FILE, LOG + "npc_logfile");
  SetProp( P_LOG_INFO, "missing_answers"); // Logfile fuer unbeantwortete Fragen
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+"will Deine Sachen nicht tragen.\n" }) );
  
  //Antworten
  AddInfo( DEFAULT_INFO, ({"Da bin ich ueberfragt.", "Darauf kann ich Dir leider keine Antwort geben.", 
  	"Dazu kann ich Dir leider nichts sagen.", "Davon weiss ich leider nichts." }), "sagt: ");
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Beschuetzerin von Andracia.", "sagt: ");
  AddInfo( "nyx", "Nyx hilft Yondala und Yason.", "sagt: ");
  AddInfo( "aginor", "Aginor machte, dass in Andracia die Sonne scheint und das Leben weitergeht. Dann verschwand er.", "sagt: ");
  
  AddInfo( ({"dorlen", "dorlen zwirbelstein"}), break_string("Das ist die huebsche Tochter "+
  "des Freiherrn. ", 45),"sagt: ");
  AddInfo( ({"edorian", "edorian zwirbelstein"}), break_string("Das ist der Name unseren geliebten  "+
  "Freiherrn. ", 45),"sagt: ");
  AddInfo( ({"lara", "lara zwirbelstein"}), break_string("Das ist die Frau unseres "+
  "Freiherrn. ", 45),"sagt: ");
  AddInfo( ({"erna", "erna kollwanst"}), break_string("Das ist die Koechin auf der Burg. "+
  "Eine sehr nette Frau. ", 45),"sagt: ");
  AddInfo( ({"sindar", "sindar tucher"}), break_string("Das ist der Bibliothekar unseres "+
  "Freiherrn. ", 45),"sagt: ");
  AddInfo( ({"brin", "brin roggenfeldt"}), break_string("Das ist der Hauptmann der Burgwache auf der Burg unseres "+
  "Freiherrn. ", 45),"sagt: ");
  AddInfo( ({"yantur", "yantur leisten"}), break_string("Das ist der Burgschmied. Du kannst bei Ihm Deine "+
  "Ausruestung reparieren. ", 45),"sagt: ");
  
  AddInfo( ({"bernhelm", "bernhelm kramer"}), break_string("Dieser Bauer wohnt im Dorf Zwirbelstein. "+
  "Netter Kerl. ", 45),"sagt: ");
  AddInfo( ({"irian", "irian ilgur"}), break_string("Dieser Bauer wohnt im Dorf Zwirbelstein. "+
  "Komischer Kauz. ", 45),"sagt: ");
  AddInfo( ({"jobdan", "jobdan gerber"}), break_string("Dieser Bauer wohnt im Dorf Zwirbelstein. "+
  "Kraeftiger Bursche. ", 45),"sagt: ");

  AddInfo( ({"eslam", "eslam kremso"}), break_string("Das ist einer der Haendler im Dorf Zwirbelstein. "+
  "Du findest seinen Laden im Westen des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"rauert", "rauert arres"}), break_string("Das ist einer der Haendler im Dorf Zwirbelstein. "+
  "Du findest seinen Laden im Osten des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"gumblad", "gumblad korber"}), break_string("Das ist einer der Wirte im Dorf Zwirbelstein.. "+
  "Du findest sein Lokal im Sueden des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"radulf", "radulf buchweiz"}), break_string("Das ist einer der Wirte im Dorf Zwirbelstein.. "+
  "Du findest sein Lokal im Norden des Dorfs. ", 45),"sagt: ");

  AddInfo( ({"koenig"}), break_string("Wir haben keinen Koenig. Der Titel des Burgherrn ist "+
  "Freiherr, Freiherr Edorian von Zwirbelstein.", 45),"sagt: ");
  AddInfo( ({"hilfe"}), break_string("Ich kann Dir nur empfehlen zu Sindar Tucher, dem "+
  "Bibliothekar zu gehen. Der weiss immer Rat. Du findest ihn im 3ten Stock des Burgfrieds.", 45),"sagt: ");
  AddInfo( ({"quest"}), break_string("Tut mir leid. Ich habe keine Arbeit fuer dich. "+
  "Der Freiherr such aber immer Leute fuer alle moeglichen Aufgaben. ", 45),"sagt: ");
  AddInfo( ({"burg", "zwirbelstein"}), break_string("Die Burg Zwirbelstein ist der "+
  "Sitz des Freiherrn von Zwirbelstein. ", 45),"sagt: ");
  AddInfo( ({"welt", "aandracia"}), break_string("Diese Welt wird Andracia genannt. "+
  "Geh zu Sindar Tucher, dem Bibliothekar, der kann Dir viel ueber unsere Welt erzaehlen. ", 45),"sagt: ");
  AddInfo( ({"essen", "trinken"}), break_string("Im Gastraum bekommst Du etwas. ", 45),"sagt: ");
  AddInfo( ({"liebe"}), break_string("Die Liebe ist ein Geschenk. Halt Sie fest wenn Du sie "+
  "findest. ", 45),"sagt: ");

  AddInfo( ({"ei", "eier"}), break_string("Bei den Huehnern findet man bestimmt Eier.", 45),"sagt: ");
  AddInfo( ({"milch"}), break_string("Kuehe kann man fuer Milch melken.  ", 45),"sagt: ");

  AddInfo( ({"herberge", "unterkunft"}) , break_string("Bleib einfach hier und ruh dich aus.", 45),"sagt: ");
  
  AddInfo( ({"yann", "okenheld", "yann okenheld", "Yann Okenheld", "seiler"}), break_string(
  "Mhm - lass mich nachdenken. Ah - ich glaube Yann Okenheld ist der Seiler im Hafendorf. Du findest das "+
  "Hafendorf westlich von hier.", 45),"sagt: ");
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", "asseln", "spinnen", "maeuse", "ratten"}), 
  "Kaefer, Asseln, Spinnen, Maeuse und Ratten sind Ungeziefer. ", "sagt: ");

/*
  AddInfo( ({""}) , "", "sagt: ");
*/
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
