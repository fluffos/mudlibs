inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

/*mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 15)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}*/

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Kuh");
  SetProp(P_LONG,
    "Eine Kuh. Sie gibt viel Milch und wird taeglich gemolken.");
  SetProp(P_NAME, "Kuh");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "kuh" }));

  create_default_npc(8);

  SetProp(P_HANDS, ({" mit ihren Hufen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kuh");
  SetProp(P_SIZE, 1580);
  SetProp(P_WEIGHT, 19000);
  SetProp(P_ALIGN, 650);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 1);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "trottet herein");
  SetProp(P_MSGOUT, "trottet weg");
  SetProp(P_MMSGIN, "trottet herbei");
  SetProp(P_MMSGOUT, "rast davon");
  SetProp(P_MNPC_AREA, ({ROOM + "gehoeft_a1.lpc"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "gehoeft_a1.lpc");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS);

  SetProp(P_DIE_MSG,  " wird nie mehr Milch geben. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich armers Huftier...");
  SetProp(P_KILL_NAME, "Kuh");
  
  AddInfo(DEFAULT_INFO, "ignoriert dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kuh kann Deine Sachen nicht tragen.\n" }) );
    
  AddDetail( ({ "euter", "eutern" }), "Man kann daraus vielleich Milch melken. \n");  
    
  AddCmd( ({ "melke", "melk" }), "kuh_melken" );
  
}

int kuh_melken(string str)
{ 
  object ob;
  notify_fail("Was willst Du melken? \n");
  if( str != "kuh" && str != "eine kuh" ) return 0;
  notify_fail("Du hast Doch schon etwas Milch! \n");
  if( present("\nmilch",TP) ) return 0;
  SUID;
  ob = clone_object(OBJ + "kuchen_milch.lpc");
  ob->move(TP, M_GET);
  write("Du drueckst an den Eutern der Kuh und bekommst etwas frische Milch heraus. \n");
  say(TPN + " melkt eine Kuh. \n",TP);
  return 1;
}
