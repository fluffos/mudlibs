inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

/*mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 15)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}*/

void create() {
  int farbe;
  farbe = random(4);
  if (!is_clone(TO)) return;
  ::create();
  	
  SetProp(P_SHORT, "Ein Huhn");
  switch(farbe) {
    case 1: SetProp(P_LONG, BS("Ein weisses Huhn. Eine schoene Legehenne, "+
    	"ob sie allerdings Eier mit weisser Schale legt ist ungewiss. ")); break;
    case 2: SetProp(P_LONG, BS("Ein braunes Huhn. Eine schoene Legehenne, "+
    	"ob sie allerdings Eier mit brauner Schale legt ist ungewiss. ")); break;
    case 3: SetProp(P_LONG, "Ein rotbraunes Huhn. Vielleicht hat das Tier ja ein Ei gelegt? \n"); break;
    default: SetProp(P_LONG, BS("Ein schwarzes Huhn. Manche schwarzen Rituale "+
    	"benoetigen ein schwarzes Huhn als Opfer. "));
  }
  
  SetProp(P_NAME, "Huhn");
  SetProp(P_GENDER, NEUTER);
  AddId(({ "huhn", "henne", "legehenne" }));

  create_default_npc(4);

  SetProp(P_HANDS, ({" mit ihrem Schnabel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Huhn");
  SetProp(P_SIZE, 24);
  SetProp(P_WEIGHT, 1800);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "stakst herein");
  SetProp(P_MSGOUT, "stakst weg");
  SetProp(P_MMSGIN, "stakst herbei");
  SetProp(P_MMSGOUT, "stakst hinfort");
  SetProp(P_MNPC_AREA, ROOM + "gehoeft_c");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "gehoeft_c2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie mehr nach Koernern picken. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich armes Huhn...");
  SetProp(P_KILL_NAME, "Huhn");
  
  AddInfo(DEFAULT_INFO, "ignoriert dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Huhn kann Deine Sachen nicht tragen.\n" }) );
}
