inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

/*mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 15)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}*/

void init()
{
	 mapping wohin;
	 string *richtungen;
	 int zufall;
   ::init();
   if (this_player() && this_player()->id("fuchs")) {
   	 wohin = environment(TO)->QueryProp(P_EXITS);
   	 richtungen = m_indices(wohin);
   	 zufall = random(sizeof(richtungen));
   	 move(wohin[richtungen[zufall]],M_GO,"nach " + capitalize(richtungen[zufall]), "fluechtet", "hetzt herein");
   }	 
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Feldmaus");
  SetProp(P_LONG,
    "Eine Feldmaus. Sie sucht nach Koernern und lebt im Feld. ");
  SetProp(P_NAME, "Feldmaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "feldmaus", "maus" }));

  create_default_npc(2);

  SetProp(P_HANDS, ({" mit ihren Nagezaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Maus");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "trippelt herein");
  SetProp(P_MSGOUT, "trippelt weg");
  SetProp(P_MMSGIN, "trippelt herbei");
  SetProp(P_MMSGOUT, "verschwindet in einem Loch");
  SetProp(P_MNPC_AREA, ({ROOM + "gehoeft_d",ROOM + "gehoeft_e",ROOM + "gehoeft_f",ROOM + "gehoeft_g"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "gehoeft_g2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie mehr das Getreide stehlen. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Wer hat erlaubt dass hier arme Feldmaussaison ist ...");
  SetProp(P_KILL_NAME, "ein armselige Feldmaus");
  
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Feldmaus kann Deine Sachen nicht tragen.\n" }) );
  
  CLONEME("/d/andracia/yondala/friedheim/obj/getreidekorn.lpc");
}
