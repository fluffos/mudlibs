inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

/*mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 15)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}*/

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Katze");
  SetProp(P_LONG,
    "Eine freche Katze. Sie soll die Maeuse vom Hof fernhalten. ");
  SetProp(P_NAME, "Katze");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "katze" }));

  create_default_npc(6);

  SetProp(P_HANDS, ({" mit ihren Tatzen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 4000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht weg");
  SetProp(P_MMSGIN, "schleicht herbei");
  SetProp(P_MMSGOUT, "verschwindet schnell");
  SetProp(P_MNPC_AREA, ROOM + "gehoeft_b");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "gehoeft_b2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie mehr Maeuse jagen. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Miau?");
  SetProp(P_KILL_NAME, "Katze");
  
  AddInfo(DEFAULT_INFO, "ignoriert dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Katze kann Deine Sachen nicht tragen.\n" }) );
}
