inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

/*mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 15)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}*/

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Fuchs");
  SetProp(P_LONG,
    "Ein Fuchs auf Beutesuche. Die Huehner des Hofs locken ihn wohl.");
  SetProp(P_NAME, "Fuchs");
  SetProp(P_GENDER, MALE);
  AddId(({ "fuchs" }));

  create_default_npc(7);

  SetProp(P_HANDS, ({" mit seinem Maul",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Fuchs");
  SetProp(P_SIZE, 580);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht weg");
  SetProp(P_MMSGIN, "schleicht herbei");
  SetProp(P_MMSGOUT, "rast davon");
  SetProp(P_MNPC_AREA, ({ROOM + "gehoeft_d",ROOM + "gehoeft_e",ROOM + "gehoeft_f",ROOM + "gehoeft_g"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM + "gehoeft_e2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie mehr Huehner stehlen. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich armer Huehnerdieb ...");
  SetProp(P_KILL_NAME, "ein Fuchs");
  
  AddInfo(DEFAULT_INFO, "ignoriert dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Fuchs kann Deine Sachen nicht tragen.\n" }) );
    
  CLONEME(OBJ+"fuchsschwanz.lpc");
}
