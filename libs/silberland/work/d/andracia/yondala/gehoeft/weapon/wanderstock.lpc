#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Wanderstock");
  SetProp(P_LONG, "Ein normaler Wanderstock. Primitiv aber nuetzlich. " );
  SetProp(P_INFO, "Aeltere Leute haben meisst solch einen Gehstock. ");
  SetProp(P_NAME, "Wanderstock");
  SetProp(P_GENDER, MALE);
  AddId( ({ "stock", "wanderstock", "gehstock" }) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 67);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 680);
  SetProp(P_SIZE, 98);
  SetProp(P_VALUE, 486);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:1, A_STR:1]) );
}

