#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fuchsschwanz");
  SetProp(P_LONG,
    BS("Dieser buschige Schwanz eine Fuchs ist zwar schoen anzuschauen aber ansonsten recht nutzlos. "+
    "Man kann keine Kleider daraus fertigen und auch zum auspolstern eines Betts ist er ungeeignet.") );
  SetProp(P_NAME, "Fuchsschwanz");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schwanz","fuchsschwanz"}));

  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 68);
  SetProp(P_VALUE, 155);

}

