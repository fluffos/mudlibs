inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"etwas Milch");
  SetProp(P_LONG,
     BS("Milch von einer Kuh. ")
     );
  
  AddId( ({"milch", "\nmilch"}) );
  SetProp(P_NAME, "etwas Milch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 28);
  SetProp(P_WEIGHT, 62);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 6,6}),
        F_SOAK: 8,
        F_MSG: "Du trinkst etwas Milch.",
        F_MSG_ROOM: "trinkt etwas Milch."]) );
}