inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Huehnerei");
  SetProp(P_LONG,
     BS("Dieses Ei ist von einem Huhn gelegt worden. Man kann es bestimmt auch roh essen. ")
     );
  
  AddId( ({"ei", "huehnerei", "\nei"}) );
  SetProp(P_NAME, "Huehnerei");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 28);
  SetProp(P_WEIGHT, 62);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 4,4}),
        F_SOAK: 6,
        F_MSG: "Du schluerfst ein rohes Ei.",
        F_MSG_ROOM: "schluerft ein rohes Ei."]) );
}