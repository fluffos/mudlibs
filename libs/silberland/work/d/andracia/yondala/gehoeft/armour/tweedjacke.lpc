#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Tweedjacke");
  SetProp(P_LONG,
    "Eine Tweedjacke. Schick und in einem dunklen Braunton." );
  SetProp(P_INFO, "" );
  SetProp(P_NAME, "Tweedjacke");
  // SetProp(P_NAME_ADJ, "normal");
  // SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"jacke", "tweedjacke" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 22);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 1855);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 90, 0:75]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:3]) );
}


