#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Latzhose");
  SetProp(P_LONG, BS(
    "Eine einfache Latzhose. Nicht besonders modisch aber doch sehr "+
    "praktisch fuer die Arbeit auf dem Hof." ));
  SetProp(P_INFO, "Eine eindeutige modische Entgleisung" );
  SetProp(P_NAME, "Latzhose");
  // SetProp(P_NAME_ADJ, "normal");
  // SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "latzhose" }) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 1250);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:78]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


