#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Stiefel");
  SetProp(P_LONG, BS(
    "Ein normales Paar Stiefel. Bequem und mit der dicken Sohle zum wandern gut geeignet." ));
  SetProp(P_INFO, "" );
  SetProp(P_NAME, "Stiefel");
  SetProp(P_ARTICLE, 0);
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stiefel"}) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 840);
  SetProp(P_VALUE, 1240);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:82]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );
}


