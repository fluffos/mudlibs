#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Hose");
  SetProp(P_LONG,
    "Eine ganz normale Hose. Primitiv geschnitten und einfach vernaeht." );
  SetProp(P_INFO, "" );
  SetProp(P_NAME, "Hose");
  // SetProp(P_NAME_ADJ, "normal");
  // SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose" }) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 790);
  SetProp(P_VALUE, 456);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 90, 0:75]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


