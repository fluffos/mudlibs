#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Hemd");
  SetProp(P_LONG,
    "Ein einfaches Hemd. Das kann jeder anziehen ohne sich einer Mode zu unterwerfen. " );
  SetProp(P_INFO, "Nur ein normales Hemd ohne besondere Farbe oder besonderen Schnitt." );
  SetProp(P_NAME, "Hemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 280);
  SetProp(P_VALUE, 465);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 15, DT_POISON : 0, 0 : 50 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
