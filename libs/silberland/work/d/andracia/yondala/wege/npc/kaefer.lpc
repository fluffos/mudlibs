//Der Käfer

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Ein Kaefer");
  SetProp(P_LONG,
    "Ein Kaefer der eine kleine Mistkugel vor sicher herrollt.");
  SetProp(P_NAME, "Kaefer"); 
  SetProp(P_GENDER, MALE);

SetProp (P_MNPC_DEFAULTROOM, ROOM+"poesie_4d");
SetProp (P_MNPC_AREA, ({ROOM+"poesie",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));


  AddId(({"kaefer", "insekt"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Scheren",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");  
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 8);
  SetProp(P_ALIGN, 0);

 was =random(2);
 if (was==1) 
 	{CLONEME(OBJ "mistkugel" );
 		  SetProp(P_MSGIN, "rollt eine Mistkugel herein"); 
  SetProp(P_MSGOUT, "rollt seine Mistkugel");}

 else 
 	{
 		CLONEME(OBJ "kaeferzange" );
	  SetProp(P_MSGIN, "krabbelt herein"); 
    SetProp(P_MSGOUT, "krabbelt");
  }



  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Ein kleiner Kaefer"); 
  AddInfo(DEFAULT_INFO, "antwortet nicht.\n"); 

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kaefer laesst es wieder fallen.\n" }) );

}