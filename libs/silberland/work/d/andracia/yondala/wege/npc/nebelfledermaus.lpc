//Nebelfledermaus, nicht stark, aber macht taub

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Eine Nebelfledermaus");
  SetProp(P_LONG,
    "Du siehst eine kleine, schwarze Nebelfledermaus, die Dich misstrauisch beaeugt.");
  SetProp(P_NAME, "Nebelfledermaus"); 
  SetProp(P_GENDER, FEMALE);

SetProp (P_MNPC_DEFAULTROOM, ROOM+"nebelweg_14");
SetProp (P_MNPC_AREA, ({ROOM+"nebelweg",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");


  AddId(({"nebelfledermaus", "fledermaus"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Fledermaus");  
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 50);
  SetProp(P_ALIGN, 0);
 		CLONEME(OBJ "fledermausfluegel" );
 		CLONEME(OBJ "fledermausfluegel" );


 		
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Eine Nebelfledermaus"); 
  AddInfo(DEFAULT_INFO, "piepst.\n");  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus laesst @WEN fallen.\n" }) );

  SetProp(P_SPELLRATE, 10); 

 /*    SetChats(3, ({
       "Die Kraehe kraechzt laut.\n", 
       "Die Kraehe hackt mit ihrem Schnabel in den Boden.\n",
       "Die Kraehe sucht nach Nahrung.\n",
       "Die Kraehe schaut Dich hungrig an\n") }) ;

*/
  AddSpell(1,50,
              "Die Fledermaus kreischt Dir ins Ohr!\n",
              "Die Fledermaus kreischt @WEM ins Ohr.\n",
              DT_PIERCE, "taub", ([SP_SHOW_DAMAGE:1]) );

}

     void taub(object enemy, int damage, mixed dam_type) 
     {
       enemy->SetProp(P_DEAF, 3+random(3));
     }