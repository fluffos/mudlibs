inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

#define WAFFE "/d/huegelland/yason/zwirbelstein/weapon/knueppel_2.lpc"
#define RUESTUNG1 "/d/huegelland/yason/zwirbelstein/armour/lederweste_2.lpc"
#define RUESTUNG2 "/d/huegelland/yason/zwirbelstein/armour/lederguertel_2.lpc"
#define RUESTUNG3 "/d/huegelland/yason/zwirbelstein/armour/lederstiefel_2.lpc"
#define RUESTUNG4 "/d/huegelland/yason/zwirbelstein/armour/leinenhose.lpc"
#define RUESTUNG5 "/d/huegelland/yason/zwirbelstein/armour/lederarmschienen_2.lpc"

void create() {
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  set_living_name("wegelagerer");
  SetProp(P_SHORT, "Wegelagerer");
  SetProp(P_LONG, BS(
    "Dies ist ein Wegelagerer und Strauchdieb. Er versteckt sich hinter Bueschen und Baeumen "+
    "und ueberfaellt harmlose Reisende. "));
  SetProp(P_NAME, "Wegelagerer");
  SetProp(P_GENDER, MALE);
  AddId(({"wegelagerer", "dieb", "strauchdieb"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 178);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, ([P_LEVEL:([4:0.8, 5:0.8, 6:0.8, 7:0.8, 8:0.8]), 0:0.0]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM+"weg_zum_hafen_21.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Wegelagerer");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "interessiert sich nicht fuer deine Frage. \n");

  SetProp (P_REJECT,
         ({ REJECT_KEEP, "Der Wegelagerer steckt @WEN geschwind ein.\n" }) );
		 /*
  SUID;
  CLONEME( WAFFE );
  command("zuecke knueppel");
  CLONEME( RUESTUNG1 );
  CLONEME( RUESTUNG2 );
  CLONEME( RUESTUNG3 );
  CLONEME( RUESTUNG4 );
  CLONEME( RUESTUNG5 );
  command("trage alles");
  */
  
  ob = clone_object("/obj/money.lpc");
  ob->SetProp(P_AMOUNT, 400 + random(400));
  ob->move(TO, M_SILENT);

}





