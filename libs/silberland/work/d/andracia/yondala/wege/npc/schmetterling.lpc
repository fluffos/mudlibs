inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schmetterling");
  SetProp(P_LONG,
    "Ein Schmetterling mit gruen-blauen Fluegeln");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId(({"schmetterling", "insekt", "falter"})); 
  CLONEME(OBJ "schmetterlingsfluegel" );
  create_default_npc(1);  /* 3=Stufe */
  SetProp(P_HANDS, ({" mit seinen Fuehlern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt"); 
  SetProp(P_SIZE, 5); 
  SetProp(P_WEIGHT, 10); 
  SetProp(P_ALIGN, 0); 
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HEAL,0); 


SetProp (P_MNPC_DEFAULTROOM, ROOM+"poesie_4d");
SetProp (P_MNPC_AREA, ({ROOM+"poesie",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt hinaus");
  SetProp(P_MMSGIN, "faellt vom Himmel");
  SetProp(P_MMSGOUT, "flattert in den Himmel");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Ein niedlicher Schmetterling"); 



  AddInfo(DEFAULT_INFO, "antwortet nicht.\n");  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schmetterling laesst es wieder fallen.\n" }) );


}
