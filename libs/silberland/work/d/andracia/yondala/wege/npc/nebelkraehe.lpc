//Nebelkraehe, nicht stark, aber macht blind

inherit "std/mnpc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create() {
  int was;
  if (!is_clone(TO))return;
  ::create();

  SetProp(P_SHORT, "Eine Nebelkraehe");
  SetProp(P_LONG,
    "Du siehst eine kleine, schwarze Nebelkraehe, die Dich misstrauisch beaeugt.");
  SetProp(P_NAME, "Nebelkraehe"); 
  SetProp(P_GENDER, FEMALE);

SetProp (P_MNPC_DEFAULTROOM, ROOM+"nebelweg_15");
SetProp (P_MNPC_AREA, ({ROOM+"nebel",}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");


  AddId(({"kraehe", "nebelkraehe"}));

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihrem Schnabel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");  
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 800);
  SetProp(P_ALIGN, 0);


	CLONEME(OBJ "nebelkraehenfeder" );



  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_NAME, "Eine Nebelkraehe"); 
  AddInfo(DEFAULT_INFO, "kraechzt.\n");  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kraehe laesst @WEN fallen.\n" }) );

  SetProp(P_SPELLRATE, 10); 

     SetChats(3, ({
       "Die Kraehe kraechzt laut.\n", 
       "Die Kraehe hackt mit ihrem Schnabel in den Boden.\n",
       "Die Kraehe sucht nach Nahrung.\n",
       "Die Kraehe schaut Dich hungrig an\n" })) ;


  AddSpell(1,50,
              "Die Kraehe hackt Dir ins Auge!\n",
              "Die Kraehe hackt @WEM ins Auge.\n",
              DT_PIERCE, "blind", ([SP_SHOW_DAMAGE:1]) );

}

     void blind(object enemy, int damage, mixed dam_type) 
     {
       enemy->SetProp(P_BLIND, 3+random(3));
     }