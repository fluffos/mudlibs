int toetungsversuch(string str)
{
	if( str == "wal" ) 
	{
		write( "Der Wal ist zu gross zum toeten, ehrlich.\n");
		return 1;
	}
	else return 0;
}

int rein(string str)
{
  notify_fail("Was willst Du besteigen?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Willst Du vom Wal springen?\n");
  if( !str ) return 0;
  if( id(str) || str="vom wal" ) return Leave();
  else return 0;	
}

