#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein abgebrochener Ast");
  SetProp(P_LONG,
    "Du siehst einen morschen Ast, der irgendwo abgebrochen wurde. Viel kann man damit sicher nicht machen, aber er laesst sich sicher als Waffe benutzen." );

  SetProp(P_NAME, "Ast");
  SetProp(P_GENDER, MALE);
  AddId( ({"ast"}) );
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 40);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 40);
  SetProp(P_VALUE, 0);

  SetProp(P_QUALITY_DECAY, 100);

}
