#include "../def.h"
inherit ROOM + "nebelweg_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einem nebeligen Wald" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem nebeligen Wald. Hier ist es so dunkel, dass "
	"es kaum mehr Straeucher oder Buesche gibt, denn nur wenig Licht "
	"gelangt durch die Baeume bis auf den Boden und das bisschen Licht, "
	"dass durch die Baeume reicht wird vom Nebel fast verschluckt. "
    "Hier kannst Du wohl nicht weitergehen, der Nebel versperrt Dir die Sicht." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({ "sicht" }),
    "Du kannst absolut nichts mehr sehen, besonders im Sueden steht direkt "
	"vor Dir eine dichte Nebelwand.");
  AddDetail( ({ "nebelwand" }),
    "Du kannst nicht sehen, was dahinter ist. Eventuell koenntest Du  "
	"tasten, oder einfach weiter nach Sueden gehen, was soll schon passieren?");
  AddDetail( ({ "sueden" }),
    "Durch den Nebel kannst Du nicht sehen, was dort sein mag.");


  AddExit( "norden", "./nebelweg_15" );
  AddSpecialExit( "sueden", "sued");
  
  //Versteckt alle unsichtbaren Ausgaenge aus dem Standartraum
  SetProp(P_HIDE_EXITS, m_indices(QueryProp(P_SPECIAL_EXITS)));
  
  AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );
}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden")
	{
		write("Der Weg in diese Richtung scheint frei zu sein.\n");
		return 1;
	}
   else if(str=="nordosten"||str=="osten"||str=="suedosten"
         ||str=="suedwesten"||str=="westen"||str=="nordwesten")
		 
  	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
write("So etwas kannst Du hier nicht ertasten.\n");
return 1;
}

int sued(string dir)
     {
       return this_player()->move("/d/andracia/yondala/nebelwaelder/poesie/room/poesie_6b", M_GO, 0,
                    "wagt sich durch den Nebel", "kommt durch den Nebel");
     }
	 
