#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Du stehst auf einer Kreuzung. DER WEG NACH UNTEN IST NUR TEMPORAER HIER. YONDALA." ));

  AddDetail( ({"kreuzung"}), BS(
    "Dort befindest Du Dich. Der Weg teilt sich hier." ));
  AddDetail( ({"yondala"}), BS(
    "Teile Yondala mit: Wann machst Du den Weg zu den Gierlingen huebsch?" ));
    
  AddExit( "westen" , ROOM + "weg_zum_hafen_30.lpc");
  
  
  //eventuell noch huebsch machen, Details rein oder verstecken
    AddExit( "unten", "/d/andracia/yondala/gebirge/gierlingshoehle/room/gierlinge_8b.lpc");
	
	
  AddExit( "osten" , "/d/andracia/yondala/gebirge/gebirgspass/room/gebirgspass_01.lpc" );
  AddExit( "norden" ,"/d/andracia/yondala/friedheim/room/wege/weg_zum_dorf_b9.lpc");
 // AddExit( "suedosten" , "/d/andracia/yondala/zentralwald/room/wald_querweg_01.lpc" );
  
}
