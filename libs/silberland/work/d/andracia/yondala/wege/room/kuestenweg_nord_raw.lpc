#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Kuestenweg" );
  SetProp( P_INT_LONG,
     BS("Dies ist der noerdliche Kuestenweg. Der Weg hat sich hier von "+
     "der Steilkueste und den Klippen ins Landesinnere hinein entfernt."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "boden", "weg", "wegs", "kuestenweg" }),
    BS("Der Weg ist mit einfachen Steinen gepflastert. Nicht besonders "+
    "bequem aber bei Regen wird dieser Weg nicht schlammig. Rechts und links "+
    "des Wegs waechst hohes Schilfgras, das typisch fuer die Kuestenregion ist. "));
  AddSound( DEFAULT_SOUND,
    BS("Das Schilfgras raschelt im Wind."));

  AddSmell( DEFAULT_SMELL,
    BS("Der salzige Duft des Meers dringt in deine Nase."));


  AddDetail( ({ "stueck" }),
    BS("An diesem Stueck Weg ist nichts besonderes zu erkennen."));
  AddDetail( ({ "meer", "meers", "duft" }),
    BS("Das Meer ist nur ein kleines Stueck entfernt. Der typisch salzige "+
    "Geruch dring in deine Nase."));
  AddDetail( ({ "stein", "steine", "steinen" }),
    BS("Einfache Steine die man an den Klippen finden kann. "));
  AddDetail( ({ "regen" }),
    BS("Es regnet gerade nicht!"));
  AddDetail( ({ "schilfgras", "gras" }),
    BS("Das Gras wiegt im Wind und raschelt. Ansonsten ist nichts besonderes daran "+
    "zu erkennen."));
  AddDetail( ({ "kuestenregion", "region", "kueste", "kuesten" }),
    BS("Das Meer im Westen kennzeichnet das Ende des Festlands. Diese Region nennt "+
    "man Kuestenregion."));
  AddDetail( ({ "wind", "brise" }),
    BS("Die steife Brise laesst das Schilfgras rascheln."));
  AddDetail( ({ "nase" }),
    BS("Ein tolles Riechorgan."));
  AddDetail( ({ "riechorgan" }),
    BS("Das ist Deine Nase."));
  AddDetail( ({ "klippen", "klippe" }),
    BS("Hier ist keine Klippe."));
  AddDetail( ({ "duft" }),
    BS("Fuer sowas ist deine Nase besser geeignet."));
  AddDetail( ({ "festland", "landesinnere" }),
    BS("Du stehst drauf."));
  AddDetail( ({ "steilkueste" }),
    BS("Dazu musst du naeher an Meer gehen, dort kann es eine Steilkueste geben."));
  AddDetail( ({ "himmel" }),
    BS("Tiefblauer Himmel."));

  AddSound( ({ "rascheln" }),
    BS("Das Schilfgras raschelt im Wind."));

  AddSmell( ({ "duft", "meer", "meers", "geruch" }),
    BS("Der typsche salzige Duft des Meers herrscht hier."));


}

