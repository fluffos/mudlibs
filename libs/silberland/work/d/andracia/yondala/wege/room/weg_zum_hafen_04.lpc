#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Ein Trampelpfad fuehrt hier nach Sueden in den Wald hinein. \n" );
  AddDetail( ({ "trampelpfad" }),
    "Der Trampelpfad fuehrt tiefer in den Wald hinein. Ein kleines unscheinbares Schild wurde "+
    "direkt hier an einen Baum genagelt.");
  AddDetail( ({ "schild" }),
    "Das kleine Schild wurde an einen Baum genagelt. Es zeigt in Richtung des Trampelpfads in den Wald hinein. "+
    "Es steht etwas mit filigraner Handschrift darauf geschrieben.");
  AddDetail( ({ "richtung" }),
    "Eine Richtung, in die Du gehen kannst.");
  AddDetail( ({ "handschrift", "schrift" }),
    "Eine sehr verschnoerkelte Schrift, wie von einer Frau. Lesen macht hier mehr Sinn.");
  AddDetail( ({ "frau" }),
    "Du vermutest, dass es die Handschrift einer Frau ist.");
  AddDetail( ({ "sinn" }),
    "Ein Schild zu lesen macht immer Sinn.");
  AddReadDetail( ({ "schild", "schrift", "handschrift" }),
    "+-----------------------------+\n"+
    "| Zur Zauberstabmacherin Olga |\n"+
    "+-----------------------------+\n");


  /*
  AddDetail( ({ "" }),
    "");
  */
  
      
  AddExit( "osten" , ROOM + "weg_zum_hafen_05.lpc");
  AddExit( "westen" , ROOM + "weg_zum_hafen_03.lpc" );
  AddExit( "sueden", "/d/andracia/yondala/olga/room/olgas_turm_weg_a1.lpc" );
}
