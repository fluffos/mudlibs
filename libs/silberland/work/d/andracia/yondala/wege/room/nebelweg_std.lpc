#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
string *ausgaenge;
  ::create();
  
  SetProp( P_INT_SHORT, "In einem nebeligen Wald" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem nebeligen Wald. Hier ist es so dunkel, dass es kaum mehr "
    "Straeucher oder Buesche gibt, denn nur wenig Licht gelangt durch die Baeume bis auf den "
    "Boden und das bisschen Licht, dass durch die Baeume reicht wird vom Nebel fast verschluckt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "wald" }),
    "Du stehst ziemlich tief im Wald und kannst nicht sagen, wo er wohl enden mag. Ueberall um "
    "Dich herum sind Baeume oder Nebel. Das ganze wirkt ein bisschen gespenstisch.");
  AddDetail( ({ "nebel", "nebelschwaden","schwaden" }),
    "Der Nebel ist hier dick wie Suppe. Immer wieder siehst Du schemenhafte Gestalten um Dich "
    "herum.");
  AddDetail( ({ "baeume" }),
    "Die Baeume hier sind sehr hoch gewachsen, dennoch sehen sie irgendwie verkrueppelt aus und "
    "durch ihre dunkle Rinde wirken sie noch bedrohlicher. Ihre Aeste lassen kaum Licht auf den "
    "Boden dringen. Die Baeume saeumen den Pfad, auf dem Du Dich befindest.");
  AddDetail( ({ "rinde" }),
    "Die Rinde der Baeume ist so dunkel, dass sie fast schwarz ist.");
  AddDetail( ({ "aeste" }),
    "Die Aeste der Baeume ragen weit ueber Dir heraus. Sie sind so stark veraestelt, dass kaum "
    "Licht durch sie hindurch dringt.");
  AddDetail( ({ "licht" }),
    "Viel Licht lassen die Baeume nicht mehr herein, alles liegt im trueben Zwielicht.");
  AddDetail( ({ "zwielicht" }),
    "Du bist so tief im Wald, dass Du nicht mehr viel sehen kannst. Was das bisschen Licht erhellt "
    "wird vom Nebel verhuellt.");
  AddDetail( ({ "boden" }),
    "Den Boden kannst Du kaum sehen, er ist mit Nebel bedeckt. Aber er ist weich, Deine Schritte "
    "sind federnd und gedaempft.");
  AddDetail( ({ "moos" }),
    "Das Moos ist weich und feucht. Es daempft jeden Deiner Schritte.");
  AddDetail( ({ "schritte" }),
    "Deine Schritte werden gedaempft.");
  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du hier nicht mehr sehen.");
  AddDetail( ({ "schleier" }),
    "Duenner Nebel wabert hier herum.");
  AddDetail( ({ "feinde" }),
    "Ob sich hier welche verbergen?");
 AddDetail( ({ "gestalten" }),
    "Du bist Dir nicht sicher, ob Du alleine bist. Vielleicht spielt Dir Deine Fantasie ja auch einen Streich?");
  AddDetail( ({ "fantasie","streich" }),
    "Du weisst es einfach nicht. Vielleicht solltest Du besser schnell weiter gehen.");
  AddDetail( ({ "suppe" }),
    "Der Nebel wabert traege dahin.");
  AddDetail( ({ "buesche","straeucher" }),
    "Die gibt es hier kaum.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es herrscht gespenstische Stille.");

  AddSound( ({ "stille" }),
    "Gut, dass Du so mutig bist, sonst wuerdest Du Dich hier wohl fuerchten.");
  AddSound( ({ "schritte" }),
    "Du kannst sie kaum hoeren. Erschreckt denkst Du daran, dass Du Feinde hier wohl ebenfalls "
    "nicht hoeren wirst, wenn sie sich anschleichen.");
  AddSound( ({ "feinde" }),
    "Du lauschst angestrengt, kannst aber absolut nichts hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald, der drueckende Nebel schwaengert die Luft mit hoher Feuchtigkeit.");

  AddSmell( ({ "wald" }),
    "Du riechst die Feuchtigkeit der Luft, das Moos der Baeume und die fauligen Blaetter auf dem Boden.");
  AddSmell( ({ "feuchtigkeit","luft","luftfeuchtigkeit" }),
    "Die hohe Luftfeuchtigkeit macht das Atmen schwer.");
  AddSmell( ({ "atmen","boden" }),
    "Was erwartest Du, wenn Du an so etwas riechst?");

  AddSmell( ({ "moos" }),
    "Das Moos an den Baeumen riecht wuerzig.");
  AddSmell( ({ "baeume" }),
    "Die Baeume riechen irgendwie... hoelzern.");
  AddSmell( ({ "blaetter" }),
    "Die Blaetter verfaulen langsam auf dem Boden, wenn sie von dem Baeumen gefallen sind.");
  AddSmell( ({ "" }),
    ".");
/*
  AddRoomMessage( 
    ({""}),30,"func");
*/

 AddSpecialExit( ({"norden", "sueden", "osten", "westen","suedwesten","suedosten","nordwesten","nordosten"}), "baumlauf");

/*
 ausgaenge=m_indices(QueryProp(P_SPECIAL_EXITS));
 SetProp(P_HIDE_EXITS, ausgaenge);*/
}

int baumlauf(string dir)
{
  if(!interactive(TP)) return 1;
  if(TP->QueryProp(P_NOMOVE)) 
    {
      write(TP->QueryProp(P_NOMOVE));
      return 1;
    }
  write("Du laeufst gegen einen Baum.\n");
  say(TPN+" laeuft mit voller Wucht gegen einen Baum.\n",TP);
  TP->do_damage(10, "Ein Baum");
  return 1;
}

	