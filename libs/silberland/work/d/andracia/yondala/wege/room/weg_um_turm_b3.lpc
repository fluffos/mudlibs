#include "../def.h"

inherit ROOM + "weg_um_turm_raw.lpc";

#include <properties.h>

object *sitzende = ({});

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Hier wurde am Rande der Kieswegs eine Bank aufgestellt." ));

  /*
  AddDetail( ({"extra"}), BS(
    "extra" ));
  */
  
  AddSpecialDetail( ({"bank"}), "unt_bank" );

  AddCmd( ({"sitz", "sitze", "setze"}), "cmd_hinsitzen" );
  AddCmd( ({"steh", "stehe"}), "cmd_aufstehen" );
      
  AddExit( "sueden" , ROOM + "weg_um_turm_b4.lpc");
  AddExit( "nordwesten" , ROOM + "weg_um_turm_a2.lpc" );
}

string unt_bank() {
  string result;
  int i;
  
  result = "Eine kleine Bank aus Holz. \n";
  if( sizeof(sitzende) == 0 ) return result;
  if( member(sitzende, TP) != -1 ) {
		result += "Du sitzt ";
		if( sizeof(sitzende)>1 ) {
			result += "zusammen mit ";
			for( i=sizeof(sitzende); i>0; i--) {
				if( sitzende[i-1] != TP) {result += sitzende[i-1]->name();
				if( i > 2 ) result += ", "; else result += " ";	}
		  }	 
	  } else {
	  	result += "alleine ";
	  }
	  result += "auf der Bank. \n";
	  return result;
  } 
  if( sizeof(sitzende)>0 ) {
		for( i=sizeof(sitzende); i>0; i--) {
			result += sitzende[i-1]->name();
			if( i > 1 ) result += ", "; else result += " ";	
		}
		if( sizeof(sitzende) == 1 ) result += "sitzt darauf. \n";
		else result += "sitzen darauf. \n";
	}		  
  return result;
}

int cmd_hinsitzen(string str) {
	notify_fail("Wohin willst Du dich setzen? \n");
	if( !str ) return 0;
	if( str!= "auf bank" ) return 0;
	notify_fail("Du sitzt doch aber schon auf der Bank. \n");
  if( sizeof(sitzende) == 0 ) {
		write(BS("Du setzt dich auf die leere Bank."));
	 	say(BS(TP->name()+" setzt sich auf die Bank."));
	 	sitzende += ({TP});
	 	TP->SetProp(P_NOMOVE, "Dazu musst du aufstehen. \n");
	 	return 1; // erfolgreich auf die leere Bank gesetzt
	} 	
	if( member(sitzende, TP) == -1 ) {
		write(BS("Du machst es Dir auf der Bank bequem."));
	 	say(BS(TP->name()+" setzt sich auf die Bank."));
	 	sitzende += ({TP});
	 	TP->SetProp(P_NOMOVE, "Dazu musst du aufstehen. \n");
	 	return 1; // erfolgreich auf die Bank gesetzt
  } else {
   	return 0;
  }		  
}

int cmd_aufstehen(string str) {
	notify_fail("Was willst Du genau tun? \n");
	if( !str ) return 0;
	if( str!= "auf" ) return 0;
	notify_fail("Du sitzt doch aber garnicht auf der Bank. \n");
  if( sizeof(sitzende) == 0 )	return 0;
	if( member(sitzende, TP) == -1 ) {
  	return 0;
  } else {
		write(BS("Du stehst von der Bank auf."));
		say(BS(TP->name()+" steht von der Bank auf."));
		sitzende -= ({ TP });
		TP->SetProp(P_NOMOVE, 0);
		return 1; // erfolgreich von der Bank aufgestanden
  }		
}
