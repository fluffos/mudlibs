#include "../def.h"

inherit ROOM + "weg_um_turm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Hier endet der Kiesweg an einem Durchgang durch die parkumfassende Hecke." ));

  AddDetail( ({"durchgang"}), BS(
    "Hier kann man nach Norden hin den Park verlassen. Wildnis herrscht hinter der gepflegten Hecke." ));
      
  AddExit( "suedosten" , ROOM + "weg_um_turm_b3.lpc");
  AddExit( "norden" , ROOM + "weg_um_turm_a1.lpc" );
}
