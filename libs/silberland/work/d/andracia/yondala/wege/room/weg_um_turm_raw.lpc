#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();
  	
  SetProp(P_INT_SHORT, "Eine gepflegte Parkanlage");
  SetProp(P_INT_LONG, 
    BS("Du stehst hier am Fusse des Marmorturms in einer gepflegten Parkanlage. Die Hecken sind "+
    "besonders gerade geschnitten und die Baeume und Buesche haben exakte geometrische Formen. "+
    "Das Gras ist kurzgeschnitten und bildet eine gleichmaessig ebene Flaeche und kein Unkraut "+
    "unterbricht das saftige Gruen. Ein kleiner Kiesweg schlaengelt sich durch die Anlage." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({"weg", "kiesweg", "stelle"}),
    BS("Ein sauberer Kiesweg mit grauem Kies schlaengelt sich durch die Parkanlage und fuehrt den Wanderer "+
    "von Nord nach Sued. "));
  AddDetail( ({"himmel"}),
    BS("Kleine Schoenwetterwolken werden vom leichten Wind am tiefblauen Himmel entlang getrieben. "+
    "Du schaust dem Marmorturm empor, beobachtest ein paar Augenblicke wie die Wolken vorbeiziehen "+
    "und schon schwindelt Dir leicht. "));
  AddDetail( ({"wetter"}),
    BS("Nur kleine Schoenwetterwolken zeigen sich am Himmel. "));
  AddDetail( ({"marmorturm", "turm"}),
    BS("Der hellgraue Turm der Zaubererzunft zeigt wie ein riesiger Finger in den Himmel. Man kann die "+
    "grosse Treppe erkennen die sich um den Turm wie eine Schlange windet. "));
  AddDetail( ({"park", "parkanlage", "anlage"}),
    BS("Diese Parkanlage scheint von den Zauberern angelegt worden zu sein. So perfekt kann nur Magie die "+
    "Natur in Form zwingen. Kein Unkraut im Gras und auch kein Ast der an den Baeumen in die falsche Richtung waechst." ));
  AddDetail( ({"hecken", "hecke"}),
    BS("Die perfekt gerade geschnittenen Hecken begrenzen die Parkanlage in alle Richtungen. Dahinter ist wieder "+
    "die wilde Natur nach ihren eigenen chaotischen Regeln. " ));
  AddDetail( ({"baeume", "baum"}), 
    BS("Die wenigen Baeume hier im Park sind kerzengerade und bilden mit ihren Aesten und Blattwerk perfekte runde "+
    "Kugeln oder perfekte spitze Kegel. Es ist richtig unheimlich wie man so die Natur in Form zwingen kann. "  ));
  AddDetail( ({"buesche", "busch"}), 
    BS("Die Buesche haben wie die Baeume perfekte geometrische Formen. Aber man kann auch neben Kugeln und Kegeln, "+
    "Buesche in Form von perfekten Quadern und Wuerfeln erkennen. "));
  AddDetail( ({"formen", "geometrie", "kugeln", "kegel", "wuerfel", "quader", "form", "kugel"}), 
    BS("Buesche und Baeume wurden in diesem Park in perfekte Formen gezwungen: Kugeln, Kegel, Wuerfel und Quader. "));
  AddDetail( ({"boden", "gras", "flaeche", "ebene", "grasflaeche", "grasebene"}), 
    BS("Das saftige Gras wurde kurzgeschnitten und bildet nun eine perfekte Ebene. Es ist kein Grasbueschel zu "+
    "erkennen der die perfekte Flaeche unterbricht. Kein Unkraut liefert Farbnuancen im Gruen des Grases."));
  AddDetail( ({"unkraut"}), 
    BS("Unkraut hat hier scheinbar keine Chance."));
  AddDetail( ({"ast", "aeste", "blattwerk", "blaetter"}), 
    BS("Alle Aeste und das Blattwerk erzeugen perfekte Formen der Baeume. Ein unglaubliche Leistung von Magie "+
    "die Natur in diese Geometrie zu zwingen."));
  AddDetail( ({"farbnuancen", "gruen", "farbabweichung", "farbe"}), 
    BS("Das Gras hat durchweg diesselbe Farbe - keine einzige Farbabweichung ueber die gesamte ebene Grasflaeche "+
    "ist zu erkennen. "));
  AddDetail( ({"finger", "fuesse", "fusse", "fuss"}), 
    BS("Du tastest dich ab und findest alles an der richtigen Stelle."));
  AddDetail( ({"grasbueschel"}), 
    BS("Alle Grasbueschel haben dieselbe farbe und sind auf die gleiche Hoehe kurzgeschnitten. Sie bilden eine "+
    "perfekte Grasebene."));
  AddDetail( ({"kies", "steine"}), 
    BS("Der graue Kies besteht auf kleinen kantigen Steinen und verhindert dass Unkraut oder Gras den Weg ueberwuchern."));
  AddDetail( ({"magie"}), 
    BS("Ob Magie zum Formen der Pflanzen verwendet wurde?"));
  AddDetail( ({"natur", "pflanzen", "regeln", "bestreben"}), 
    BS("Die Natur hat eigentlich das Bestreben nach chaotischen Regeln eine Wildnis zu bilden, aber hier im Park "+
    "wurde wohl durch Magie den Baeumen und Bueschen perfekte Geometrie aufgezwungen. "));
  AddDetail( ({"schlange", "treppe"}), 
    BS("Wie eine Schlange windet sich die grosse Treppe um den Marmorturm."));
  AddDetail( ({"schoenwetterwolken", "schoenwetterwolke", "wolken", "wolke", "schaefchen"}), 
    BS("Wie kleine Schaefchen ziehen die Wolken ueber den Himmel."));
  AddDetail( ({"wind", "lueftchen"}), 
    BS("Hier herrscht nur ein ganz leichtes Lueftchen."));
  AddDetail( ({"wanderer", "abenteurer"}), 
    BS("Wer Kiesweg fuehrt den Wanderer von Nord nach Sued um den Turm durch den Park. "));
  AddDetail( ({"zaubererzunft", "zauberer", "sitz"}), 
    BS("Die Zaubererzunft hat ihren Sitz im Marmorturm. Schliesslich haben die Zauberer den Turm "+
    "ja auch mit Magie erschaffen. "));
  AddDetail( ({"wildnis"}), 
    BS("Die Wildnis befindet sich hinter den Hecken."));
  AddDetail( ({"hoehe"}), 
    BS("Der Marmorturm erreicht fast die Wolken."));


/*
  AddDetail( ({""}), 
    BS(""));
*/
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));

//  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 225 );

 
}