#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Strand" );
  SetProp( P_INT_LONG, 
    "Du befindest dich auf einem schoenen, weissen Sandstrand. Ein paar Muscheln und ein bischen Seetang "+
    "wurden angespuelt. Vielleicht findet sich ja woanders brauchbares Strandgut. Nach Westen kann man so "+
    "weit das Auge reicht nur tiefblaues Meer erkennen. Im Osten befinden sich sandige Duenen. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HILL]) );


  AddSound( DEFAULT_SOUND,
    "Du hoerst wie die Wellen am Strand brechen.");
  AddSound( ({ "wellen", "geraeusch", "rauschen" }),
    "Am Strand herrscht das Rauschen von brechenden Wellen vor.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nur den salzigen Duft des Meeres riechen.");
  AddSmell( ({ "duft", "salz", "meer" }),
    "Nur der salzige Duft des Meeres dringt in deine Nase.");

  AddDetail( ({ "boden", "weg" }),
    "Nur feiner, weisser Sand. Ein paar Muscheln und ein bischen Seetang wurden hier angespuelt. ");
  AddDetail( ({ "himmel", "wetter" }),
    "Der blaue Himmel verspricht gutes Wetter fuer diesen Tag. Nur ein paar kleine Wolken werden "+
    "vom Wind vorangetrieben.");
  AddDetail( ({ "sandstrand", "strand" }),
    "Du befindest Dich hier auf einem sehr idyllischen Sandstrand. Feiner, weisser Sand bis zum Meer. "+
    "Die Wellen laufen hier sachte aus und erfuellen die Luft mit dem Rauschen des Meers.");
  AddDetail( ({ "sand" }),
    "Der Sand ist sehr fein und hat eine besonders helle Faerbung. ");
  AddDetail( ({ "wind", "brise" }),
    "Es ist nur eine leichte Brise die Dir den Duft des Meeres an deine Nase traegt. Langsam schieben sich "+
    "kleine Wolken ueber den ansonsten blauen Himmel. " );
  AddDetail( ({ "wolke", "wolken" }),
    "Kleine Wolken werden vom Wind vorangetrieben.");
  AddDetail( ({ "meer", "westen" }),
    "Das blaue Meer erstreckt sich bis zum Horizont nach Westen. ");
  AddDetail( ({ "duenen", "osten" }),
    "Durch die Duenen hindurch kommt man in einen Wald den man kaum von hier aus erahnen kann.");
  AddDetail( ({ "farbe", "faerbung", "weiss" }),
    "Der Sand ist sehr hell, schon fast weiss.");
  AddDetail( ({ "horiziont" }),
    "So weit man sehen kann erstreckt sich das Meer gen Westen. Man kann daher nicht erkennen "+
    "was sich hinter dem Horizont befindet.");
  AddDetail( ({ "seetang", "muscheln", "strandgut" }),
    "Soweit du sehen kannst besteht das Strandgut hier nur aus losem Seetang und ein paar kleine Muscheln.");

/*
  AddDetail( ({ "" }),
    "");
*/

}

