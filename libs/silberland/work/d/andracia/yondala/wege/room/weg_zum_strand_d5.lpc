#include "../def.h"

inherit ROOM + "weg_zum_strand_duenen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Die Duenen erstrecken sich ab hier nach Westen. Der Weg selbst fuehrt hier in einen Wald nach Osten.") );

  AddDetail( ({"wald"}) ,
    BS("Der Weg fuehrt hier direkt in den Wald hinein."));
    
  AddExit( "osten" , ROOM + "weg_zum_strand_e5.lpc");
  AddExit( "suedwesten" , ROOM + "weg_zum_strand_c6.lpc");
}
