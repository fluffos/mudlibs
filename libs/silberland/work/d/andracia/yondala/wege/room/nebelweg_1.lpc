#include "../def.h"
inherit ROOM + "nebelweg_std.lpc";
#include <properties.h>
#include <language.h>
int himbeere;

void reset()
{
	::reset();
		himbeere=random(4);
		himbeere+=2;
	
	}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Waldrand" );
  SetProp( P_INT_LONG,
    "Du stehst am Rande eines schier endlosen Waldes, der sich suedlich von Dir ausbreitet. "
    "Um Dich herum ist dichtes Buschwerk, welches im Sueden aber bald nachlaesst, da es dort "
    "unter den riesigen Baeumen nicht mehr genug Licht bekommt. Nach Nordosten gelangs Du auf "
    "einen stark beanspruchten Weg." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

		himbeere=random(4);
		himbeere+=2;
  AddDetail( ({ "waldrand","rand", "rande" }),
    "Du stehst am Rande eines schier endloesen Waldes. Im Nordosten kannst Du ihn verlassen, "
    "nach Sueden gelangst Du tiefer hinein.");
  AddDetail( ({ "wald" }),
    "Hier ist der Wald noch licht, im Sueden jedoch scheint er eher finster zu werden. Auch "
    "wabert dichter Nebel zwischen den Baeumen.");
  AddDetail( ({ "nordosten" }),
    "Im Nordosten verlaeuft ein breiter Weg.");
  AddDetail( ({ "weg" }),
    "Wenn Du nach Nordosten gehst, kannst Du den Weg betreten und ihn auch entlang gehen, wenn Du moechtest.");
  AddDetail( ({ "sueden" }),
    "Im Sueden verdichtet sich der Wald, er wird finsterer und Nebel wabert zwischen den Baeumen.");
  AddDetail( ({ "nebel" }),
    "Im Sueden breitet sich dichter Nebel aus.");
  AddDetail( ({ "baeume" }),
    "Die Baeume hier sind sehr hoch gewachsen, dennoch sehen sie irgendwie verkrueppelt aus und "
    "durch ihre dunkle Rinde wirken sie noch bedrohlicher. Ihre Aeste lassen kaum Licht auf den "
    "Boden dringen.");
  AddDetail( ({ "rinde" }),
    "Die Rinde der Baeume ist so dunkel, dass sie fast schwarz ist.");
  AddDetail( ({ "aeste" }),
    "Die Aeste der Baeume ragen weit ueber Dir heraus. Sie sind so stark veraestelt, dass kaum "
    "Licht durch sie hindurch dringt.");
  AddDetail( ({ "licht" }),
    "Noch kannst Du gut sehen, doch suedlich von Dir liegt alles im trueben Zwielicht.");
  AddDetail( ({ "zwielicht" }),
    "Wenn Du tiefer in den Wald nach Sueden vordringen willst wirst Du vermutlich nicht mehr viel "
    "sehen koennen.");
  AddDetail( ({ "buschwerk" }),
    "Viele verschiedenste Buesche umgeben Dich hier. Sie stehen in sattem Gruen.");
  AddDetail( ({ "buesche" }),
    "Du siehst verschiedenste Buesche, die sich lediglich durch ihre Blaetter unterscheiden. "
    "Ein Busch allerdings traegt noch dazu saftig rote Beeren.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter hier sind allesamt gruen, variieren aber in Groesse und Form.");
  AddDetail( ({ "groesse","form" }),
    "Darin unterscheiden sich die Blaetter.");
  AddDetail( ({ "busch" }),
    "Aufgrund der Tatsache, dass an diesem Busch Himbeeren wachsen bist Du ziemlich sicher, "
    "dass es ein Himbeerbusch ist.");
  AddDetail( ({ "himbeerbusch", "himbeeren" }),
    "Du bist Dir so gut wie sicher.");
  AddDetail( ({ "beeren" }),
    "Hm, die sehen aus wie Himbeeren. Ob es welche sind? Vielleicht solltest Du mal eine pfluecken?");
  AddDetail( ({ "dornen" }),
    "Der Himbeerbusch traegt einige fiese Dornen, die es bestimmt nicht leicht machen an die "
    "Beeren zu kommen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus sandiger Erde.");
  AddDetail( ({ "erde" }),
    "Die Erde ist braun und sieht sehr fruchtbar aus.");
  AddDetail( ({ "sand" }),
    "Feiner Sand zieht sich durch die Erde. Wo der wohl herkommt?");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist mit schweren Wolken behangen, nur hin und wieder kannst Du ein wenig Blau erkennen.");
  AddDetail( ({ "wolken" }),
    "Viele dicke Wolken verhaengen den Himmel. Im Norden hingegen ist der Himmel blau. Seltsam.");
  AddDetail( ({ "blau" }),
    "Blau gibt es hier weniger.");
  AddDetail( ({ "tatsache" }),
    "So ist das.");
  AddDetail( ({ "gruen" }),
    "Es scheint den Bueschen gut zu gehen.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");



  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "pfluecke","pflueck" }), "pfluecken" );

  AddExit( "sueden", "./nebelweg_2" );
  AddExit( "nordosten", ROOM+"weg_zum_hafen_11" );
  SetProp(P_HIDE_EXITS, m_indices(QueryProp(P_SPECIAL_EXITS)));
  AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );
}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="nordosten"||str=="sueden")
	{
		write("Der Weg in diese Richtung scheint frei zu sein.\n");
		return 1;
	}
   else if(str=="norden"||str=="osten"||str=="suedosten"
         ||str=="suedwesten"||str=="westen"||str=="nordwesten")
		 
  	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
write("So etwas kannst Du hier nicht ertasten.\n");
return 1;
}
int pfluecken(string str)
{
	notify_fail("Was moechtest Du pfluecken?\n");
	if(str!="himbeere"&&str!="beere"&&str!="himbeeren"&&str!="beeren") return 0;
	if(!himbeere) 
		{
			write ("Du versuchst eine Himbeere zu pfluecken, verletzt Dich aber an den Dornen des "+
			"Busches. Gerade ist wohl keine reife Beere mehr in Reichweite.\n");
			say(TPN+" verletzt sich bei dem Versuch eine Beere zu pfluecken.\n",TP);
			TP->AddHp(-2);
			return 1;
		}
	else
		{
			write("Du pflueckst eine saftige rote Himbeere und steckst sie ein.\n");
			say(TPN+" pflueckt eine Himbeere.\n");
			CLONE(OBJ +"himbeere.lpc", TP);
			himbeere--;
			return 1;
		}
	return 0;

	
	}