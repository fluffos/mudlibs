inherit ROOM + "weg_zum_strand_strand_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Der Sandstrand endet hier. Leider ist der Strand im Norden durch schroffe Felsen, an denen sich die Wellen brechen, "+
    "unbegehbar. Ein kleiner Pfad fuehrt hier in die Duenen.") );

