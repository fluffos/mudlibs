#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>


void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
	"Ein kleiner Trampelpfad fuehrt hier nach Suedwesten in den Wald hinein. \n" );
    
  AddDetail( ({"pfad", "trampelpfad"}), 
    "Der Trampelpfad fuehrt hier in den dunklen Wald hinein.");
    
  AddExit( "osten" , ROOM + "weg_zum_hafen_12.lpc");
  AddExit( "nordwesten" , ROOM + "weg_zum_hafen_10.lpc" );

  AddExit( "suedwesten", ROOM+"nebelweg_1" );
}
