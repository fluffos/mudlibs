#include "../def.h"

inherit ROOM + "weg_zum_strand_strand_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Die Duenen im Osten schmiegen sich an eine schroffe Felswand "+
    "die ein kleines Stueck gen Sueden den Strand gegen das Festland abgrenzt.") );

  AddDetail( ({"sueden"}) ,
    BS("Hier kann man am Strand entlang nach Sueden gehen."));
  AddDetail( ({"festland"}) ,
    BS("Das Festland befindet sich im Osten. Duenen versperren Dir den direkten Weg."));
  AddDetail( ({"felswand", "klippe", "klippen"}) ,
    BS("Ein Klippe scheint im Sueden den Strand zu begrenzen."));
    
  AddExit( "norden" , ROOM + "weg_zum_strand_a9.lpc");
  AddExit( "suedosten" , ROOM + "weg_zum_strand_11.lpc");
}
