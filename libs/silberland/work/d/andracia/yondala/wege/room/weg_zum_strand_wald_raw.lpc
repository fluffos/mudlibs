#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Wald" );
  SetProp( P_INT_LONG, 
    "Dieser Weg fuehrt durch einen angenehm lichten Wald. Die Sonne scheint und kleine Wolken ziehen "+
    "zwischen den Baumwipfeln ueber den Himmel. Laub liegt auf dem Boden und federt unter jedem Deiner "+
    "Schritte. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddSound( DEFAULT_SOUND,
    "Ein paar Voegel zwitschern in der Ferne und die Blaetter der Baeume rascheln im Wind.");
  AddSound( ({ "voegel", "ferne" }),
    "Du kannst ein paar Voegel zwitschern hoeren. Leider erkennst Du nicht um welche Art von Vogel es sich handelt.");
  AddSound( ({ "rascheln", "baeume", "wind", "laub", "blaetter" }),
    "Der Wind streicht durch die Baumkronen und die Blaetter erzeugen ein leises Rascheln. ");

  AddSmell( DEFAULT_SMELL,
    "Du kannst nur den typischen Geruch des Waldbodens wahrnehmen.");
  AddSmell( ({ "geruch", "boden", "waldboden", "duft" }),
    "Verrottendes Laub und feuchte Erde, eben typischer Waldboden, verstroemt einen unverwechselbaren Duft.");
  AddSmell( ({"erde"}),    
    "Die Erde riecht ganz feucht." );
  AddDetail( ({"laub"}),    
    "Das verrottende Laub verstroemt einen starken, suesslichen Duft." );	
  AddDetail( ({ "weg", "pfad", "boden", "erde", "waldboden" }),
    "Der Pfad besteht aus festgetretener Erde und losem Laub. Man kann kaum erkennen wo dieser Weg entlang fuehrt, "+
    "aber es laeuft sich sehr bequem und die Wanderung durch den Wald hat eine beruhigende Wirkung. ");
  AddDetail( ({ "wald", "baeume", "baum" }),
    "Die Baeume stehen hier nicht allzu dicht. Die Baumkronen bilden ein unvollstaendiges Blaetterdach und die Sonne "+
    "dringt an vielen Stellen bis zum Boden durch. ");
  AddDetail( ({ "stellen" }),
    "Nicht an allen Stellen, aber an vielen.");

	AddDetail( ({ "wanderung" }),
    "Du wanderst gerade durch einen Wald. ");
  AddDetail( ({ "wirkung" }),
    "Du wirst ganz ruhig.");
  AddDetail( ({ "baumwipfel", "baumkrone", "baumkronen", "blaetterdach" }),
    "Das Blaetterdach der Baeume hat viele Luecken und Sonnenstrahlen erwaermen oft deine Haut. Man kann viel "+
    "vom blauen Himmel erkennen und die Wolken ziehen langsam dahin.");
   AddDetail( ({ "haut" }),
    "Die Sonnenstrahlen erwaermen Deine Haut. Ein schoenes Gefuehl.");
  AddDetail( ({ "gefuehl" }),
    "Wahrlich, es fuehlt sich gut an hier zu sein.");

	AddDetail( ({ "himmel" }),
    "Da die Baumwipfel weit auseinander stehen, kann man genug vom Himmel erkennen. Neben den sachte dahin ziehenden "+
    "Wolken kann man auch die hell strahlende Sonne erblicken. Geblendet schaust Du wieder zu Boden.");
  AddDetail( ({ "wolke", "wolken" }),
    "Langsam ziehen die Wolken am Himmel entlang. Gedankenversunken schaust "
	"Du den Wolken einen Moment lang zu, bis Du dich mit einem leichten "
	"Schwindelgefuehl wieder auf den Weg vor Dir konzentrieren kannst. ");
  AddDetail( ({ "moment" }),
    "Der Moment ist schon verflogen.");
  AddDetail( ({ "schwindelgefuehl" }),
    "Ein leichtes Schwindelgefuehl befiel Dich, als Du so in die Wolken "
	"starrtest, aber das ist schon wieder vorbei. Alles ist gut.");

 AddDetail( ({ "sonne" }),
    "Die Sonnenstrahlen die oft durch das lockere Blaetterdach bis zu Dir herab dringen, erwaermen deine Haut und dein Gemuet.");
  AddDetail( ({ "gemuet" }),
    "Du fuehlst Dich gut hier und bist entspannt und froehlich.");
  AddDetail( ({ "laub" }),
    "Das Laub, das auf dem Weg liegt, ist schon teilweise verrottet und erzeugt einen ganz typischen Geruch. ");
  AddDetail( ({ "schritte" }),
    "Deine Schritte werden vom Laub so weich gefedert, als wuerdest Du "
	"traumwandeld durch den Wald gehen.");

/*
  AddDetail( ({ "" }),
    "");
*/
}

