#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Westen kann man schon die ersten Gebaeude des Hafendorfs sehen. "+
      "Kurz vor dem Hafendorf scheint sich eine kleine Kreuzung zu befinden." ));

  AddDetail( ({"westen", "gebaeude", "hafendorf", "dorf"}), BS(
    "Im Westen kann man schon die ersten Gebaeude des Hafendorfs sehen." ));
  AddDetail( ({"kreuzung"}), BS(
    "Kurz vor dem Hafendorf scheint sich eine kleine Kreuzung zu befinden." ));
   
  AddExit( "osten" , ROOM + "weg_zum_hafen_02.lpc");
  AddExit( "westen" , KREUZUNG_02 );
}
