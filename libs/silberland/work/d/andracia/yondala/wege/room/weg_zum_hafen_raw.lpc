#include "../def.h"

inherit "std/room";

#include <properties.h>

int ist_da;

void reset()
{
	ist_da=1;
	::reset();
}

void create() 
{
  ::create();
  	
  ist_da=1;
  
  SetProp(P_INT_SHORT, "Auf einer Strasse am Waldrand");
  SetProp(P_INT_LONG, 
    "Diese Strasse verlaeuft von Ost nach West entlang des Waldrands. "+
    "Im Dickicht zwischen den Baeumen im Sueden koennen sich allerlei Tiere und "+
    "Raeuber verstecken. Im Norden erstreckt sich das Huegelland. Gras und "+
    "vereinzelte Buesche bestimmen hier das Bild. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );
  AddDetail( ({"sueden"}),    
    "Viel siehst Du im Sueden nicht, da das Dickicht sehr dicht ist. Was "
	"sich wohl darin verstecken mag?" );
   AddDetail( ({"ost","west","osten","westen"}),    
    "Die Strasse, auf der Du Dich befindest verlaeuft von Osten nach Westen. "
	"Oder von Westen nach Osten, wie Du magst." ); 
   AddDetail( ({"boden", "strasse", "weg"}),
    "Die Spuren von vielen Raedern und Pferden haben die Strasse ausgewaschen. "+
    "Rinnen sind entstanden, wie Schienen fuehrt der Weg dem Waldrand entlang. " );
  AddDetail( ({"himmel"}),
    "Tiefbauer Himmel mit vielen Wolken. Ein paar Voegel ziehen hoch in den "+
    "Lueften ihre Bahnen, zu hoch um sie zu jagen. ");
  AddDetail( ({"wetter"}),
    "Schoen sonnig. Regen ist in naechster Zeit nicht zu erwarten. ");
  AddDetail( ({"norden"}),    
    "Noerdlich von Dir erstreckt sich das Huegelland." );
  AddSmell( DEFAULT_SMELL,
    "Der Duft des Waldes zieht von Sueden herueber. ");
  AddSound( DEFAULT_SOUND,
    "Zirpen der Grillen und zwitschern der Voegel erfuellt die Luft. ");


  AddDetail( ({"waldrand"}),
    "Der Wald im Sueden ist dicht und dunkel. Wer weiss was so alles an Tieren "+
    "und Raeubern darin wohnt. ");
  AddDetail( ({"wald", "waldes"}),
    "Im Sueden stehen die Baeume schon recht dicht. Dir wird etwas unheimlich als Du tiefer in den Wald "+
    "spaehen willst.");
  AddDetail( ({"dickicht", "unterholz"}),
    "Zwischen den Baeumen des Waldes im Sueden stehen Straeucher und Farne, "+
    "die es verhindern, tiefer in den Wald zu blicken. ");
  AddDetail( ({"baeume", "baeumen", "baum"}),
    "Die Baeume bilden im Sueden den Wald. ");
  AddDetail( ({"tiere", "monster"}),
    "Im Unterholz des Waldes hausen bestimmt fuerchterliche Monster.");
  AddDetail( ({"raeuber"}),
    "Die Raeuber koennten im nahen Wald lauern.");
  AddDetail( ({"huegelland", "land"}),
    "Viele Senken des Huegellands kann man nicht einsehen. Buesche "+
    "und Gras wachsen auf den sanften Erhebungen. ");
  AddDetail( ({"gras"}),
    "Vor allem saftiges Gras waechst auf den Huegeln des Huegellands. ");
  AddDetail( ({"buesche", "busch"}),
    "Dazu musst Du die Strasse verlassen. ");
  AddDetail( ({"bild", "idylle"}),
    "Das sonnengeflutete Huegelland bietet das Bild einer Idylle. ");
  AddDetail( ({"spuren"}),
    "Die Kutschen und Reiter haben hier den weg schon sehr ausgetreten. ");
  AddDetail( ({"raedern", "raeder", "rad"}),
    "Kutschen und Karren brauchen Raeder um voran zukommen. ");
  AddDetail( ({"pferden", "pferde", "pferd", "weggefaehrte"}),
    "Ein Pferd ist guter Weggefaehrte. ");
  AddDetail( ({"rinnen", "schienen"}),
    "Die ausgetretene Strasse aehnelt zwei paralellen Rinnen");
  AddDetail( ({"wolken", "watte"}),
    "Wie weisse Watte ziehen die Wolken uebers Land.");
  AddDetail( ({"vogel", "voegel"}),
    "Hoch oben in den Lueften ziehen sie ihre Bahnen.");
  AddDetail( ({"luft", "lueften"}),
    "Atmen ist wichtig! ");
  AddDetail( ({"bahnen"}),
    "Du beobachtest die Bahnen die die Voegel am Himmel zeichnen. Meisst "+
    "sind es Kreise die von den Voegeln geflogen werden. ");
  AddDetail( ({"regen"}),
    "Kein Regen zu erwarten. ");
  AddDetail( ({"zeit"}),
    "Troedel nicht herum! ");
  AddDetail( ({"duft"}),
    "Rieche lieber. ");
  AddDetail( ({"strauch", "farn", "straeucher", "farne", "pflanzen"}),
    "Viele Pflanzen wachsen im Wald. ");
  AddDetail( ({"senken", "tal", "taeler"}),
    "Das Huegelland hat auch Senken. ");
  AddDetail( ({"erhebungen", "huegel"}),
    "Wenn man ueber das Huegelland schaut erkennt man vorallem die "+
    "grasbewachsenen Huegel.");
  AddDetail( ({"transport", "kutsche", "karren", "kutschen"}), 
    "Hin und wieder kommt die Kutsche hier vorbei." );
  AddDetail( ({"kreise"}), 
    "Die Voegel fliegen am Himmel und beschreiben kreisfoermige Bahnen." );
  AddDetail( ({"reiter"}), 
    "Gerade keiner da." );
  AddDetail( ({"sonne"}),    
    "Die Sonne verwoehnt das Huegelland mit ihrer Waerme." );
  AddDetail( ({"waerme"}),    
    "Es ist angenehm warm hier." );	
  AddSmell( ({"duft", "wald", "waldes", "erde", "rinde"}),
    "Der Duft des Waldes: Harz, verrottende Rinde und feuchte Erde.");
  AddSound( ({"zwitschern", "voegel"}),
    "Nett.");
  AddSound( ({"zirpen", "grillen"}),
    "Auch nett. ");
  AddSound( ({"harz"}),    
    "Harz riecht einfach unbeschreiblich." );
  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 225 );

/*
  AddDetail( ({""}),    
  "" );
*/    
  AddCmd( ({"betrete"}), "cmd_wald" );
}

int cmd_wald(string str)
{
	notify_fail("Was willst Du betreten? \n");
	if( !str || str!="wald" ) return 0;
	write( BS("Der duestere Wald kommt Dir doch zu unheimlich vor und Du verzichtest auf "+
	  "einen Ausflug ins Unterholz. ") );
	say( TP->name()+" schaut skeptisch in Richtung Wald. \n" );
	return 1;
}

void init() {
  if( TP && interactive(TP) && TP->QueryProp(P_LEVEL) >= 5 && 
      TP->QueryProp(P_LEVEL) <= 15 && !present("wegelagerer") )
  {
    if( !random(20) && ist_da ) 
    {
      call_out("ueberfall", 1);
    }
  }
  ::init();
}

void ueberfall()
{
  object ob;
	if( !present(TP) ) return;
  AddItem(NPC + "wegelagerer.lpc", REFRESH_NONE);
  write(BS("Ein Wegelagerer springt dir in den Weg!") );
  ob = present("wegelagerer");
  ob -> Kill(TP);
  ist_da=0;
}