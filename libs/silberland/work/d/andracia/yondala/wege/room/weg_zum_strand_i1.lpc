#include "../def.h"

inherit ROOM + "weg_zum_strand_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Im Norden scheint der Weg aus dem Wald hinaus zu fuehren, direkt auf eine Kreuzung." ));

  AddDetail( ({"kreuzung", "wegweiser"}) ,
    "Man kann den Wegweiser schon erkennen. Die Kreuzung ist nur ein paar Schritte gen Norden.");
  AddDetail( ({ "norden" }),
    "Noerdlich von Dir befindet sich eine Kreuzung.");

  AddExit( "norden" , KREUZUNG_02);
  AddExit( "suedwesten" , ROOM + "weg_zum_strand_h2.lpc");
}
