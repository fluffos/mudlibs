#include "../def.h"

inherit "std/room";

#define VERBINDUNG "/d/huegelland/utx/wald/room/wald_1.lpc"
#include <properties.h>

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein Pfad");
  SetProp(P_INT_LONG, 
    BS("Du stehst hier zwischen einer hohen Hecke und einem nahen Waldrand. Im Sueden ragt "+
    "der Marmorturm in die Hoehe und durch einen kleinen Durchgang durch die dichte und perfekt geschnittene "+
    "Hecke kommt man in einen gut gepflegten Park. Im Norden fuehrt der Pfad zu einem grossen, dichten Wald."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({"norden", "waldrand", "wald"}), 
    BS("Im Norden fuehrt der Weg weiter zum Wald." ));
  AddDetail( ({"sueden", "durchgang"}), 
    BS("Im Sueden kommt man durch einen Durchgang in einen Park." ));
  AddDetail( ({"hecke", "hecken"}),
    BS("Die perfekt gerade geschnittene Hecke begrenzt die Parkanlage. " ));
  AddDetail( ({"marmorturm", "turm"}),
    BS("Der hellgraue Turm der Zaubererzunft zeigt wie ein riesiger Finger in den Himmel. Man kann die "+
    "grosse Treppe erkennen die sich um den Turm wie eine Schlange windet. "));
  AddDetail( ({"zaubererzunft", "zauberer", "sitz"}), 
    BS("Die Zaubererzunft hat ihren Sitz im Marmorturm. Schliesslich haben die Zauberer den Turm "+
    "ja auch mit Magie erschaffen. "));
  AddDetail( ({"schlange", "treppe"}), 
    BS("Wie eine Schlange windet sich die grosse Treppe um den Marmorturm."));
  AddDetail( ({"hoehe"}), 
    BS("Der Marmorturm erreicht fast die Wolken."));
  AddDetail( ({"park", "parkanlage"}), 
    BS("Um in den Park zu gelangen muss man durch den Durchgang gehen."));
  AddDetail( ({"himmel"}),
    BS("Kleine Schoenwetterwolken werden vom leichten Wind am tiefblauen Himmel entlang getrieben. "+
    "Du schaust dem Marmorturm empor, beobachtest ein paar Augenblicke wie die Wolken vorbeiziehen "+
    "und schon schwindelt Dir leicht. "));
  AddDetail( ({"wetter"}),
    BS("Nur kleine Schoenwetterwolken zeigen sich am Himmel. "));
  AddDetail( ({"schoenwetterwolken", "schoenwetterwolke", "wolken", "wolke", "schaefchen"}), 
    BS("Wie kleine Schaefchen ziehen die Wolken ueber den Himmel."));
  AddDetail( ({"pfad", "weg", "boden"}), 
    BS("Der Pfad fuerht von der Hecke die den Park umgrenzt zum Waldrand im Norden. "+
    "Er ist etwas ausgetrampelt."));
  AddSpecialDetail( ({"magie"}), "zz_test"); 
  AddDetail( ({"finger", "fuesse", "fusse"}), 
    BS("Du tastest Dich ab und findest alles an der richtigen Stelle."));
    

/*
  AddDetail( ({""}), 
    BS(""));
magie,
*/    
  AddExit( "sueden" , ROOM + "weg_um_turm_a2.lpc");
//  AddExit( "norden" , VERBINDUNG );

}

string zz_test() {
	if(TP->QueryProp(P_GUILD) != "zaubererzunft") 
		return "Frag lieber nen Zauberer, die kennen sich damit aus. \n";
	return "Du solltest als Zauberer schon wissen was Magie ist. \n";	
}