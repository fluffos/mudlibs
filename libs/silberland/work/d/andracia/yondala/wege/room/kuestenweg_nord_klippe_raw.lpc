#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Kuestenweg" );
  SetProp( P_INT_LONG,
     BS("Dies ist der noerdliche Kuestenweg. Der Weg verlaeuft am oberen Rand "+
     "Klippen. Tief unter dem Weg branden die Wellen gegen die Felsen der "+
     "Steilkueste. Wenn man direkt an der Kante steht, hoert man das Schlagen "+
     "der Wellen. Geht man aber ein paar Schritte weg, so wird es ruhiger und "+
     "nur das normale Rauschen des Meers ist zu vernehmen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "boden", "weg", "wegs", "kuestenweg" }),
    BS("Der Weg ist mit einfachen Steinen gepflastert. Nicht besonders "+
    "bequem aber bei Regen wird dieser Weg nicht schlammig. Rechts und links "+
    "des Wegs waechst niedriges Schilfgras, das typisch fuer die Kuestenregion ist. "));



  AddSound( DEFAULT_SOUND,
    BS("Wenn man direkt an der Kante steht, hoert man das Schlagen "+
    "der Wellen. Geht man aber ein paar Schritte weg, so wird es ruhiger und "+
    "nur das normale Rauschen des Meers ist zu vernehmen."));
  AddSmell( DEFAULT_SMELL,
    BS("Der salzige Duft des Meers dringt in deine Nase."));

  AddDetail( ({ "rand", "kante" }),
    BS("Gleich neben dem Weg ist die Steilkueste. Dies ist das obere Ende "+
    "der hohen Felswand waehrend am unteren Ende die Brandung gegen den Fels "+
    "schlaegt. "));
  AddDetail( ({ "klippen", "steilkueste", "kueste", "kuesten", "felswand" }),
    BS("Die Steilkueste begrenzt hier Land und Meer. Hier am oberen Ende der "+
    "Felswand verlaeuft der Weg waehrend am unteren Ende die Brandung gegen "+
    "den Fels schlaegt. "));
  AddDetail( ({ "wellen", "brandung" }),
    BS("Wenn man direkt an der Kante steht, hoert man wie die Wellen gegen "+
    "das untere Ende der hohen Felswand schlagen. "));
  AddDetail( ({ "steine", "stein","felsen", "fels" }),
    BS("Ganz normaler Fels."));
  AddDetail( ({ "rauschen", "schlagen" }),
    BS("Fuer sowas sind deine Ohren besser geeignet."));
  AddDetail( ({ "meer", "meers" }),
    BS("Tief unten an der Felswand schlaegt das Meer gegen die Felsen. "+
    "Mehr kann man von hier oben nicht erkennen."));
  AddDetail( ({ "schilfgras", "gras" }),
    BS("Das Schilfgras, das typisch fuer diese Kuestenregion ist, waechst "+
    "hier nur kurz, da es vom Wind wohl staendig niedergedrueckt wird." ));
  AddDetail( ({ "duft", "geruch" }),
    BS("Fuer sowas ist deine Nase besser geeignet."));
  AddDetail( ({ "nase" }),
    BS("Ein tolles Riechorgan."));
  AddDetail( ({ "riechorgan" }),
    BS("Das ist deine Nase."));
  AddDetail( ({ "kuestenregion", "region", "land"}),
    BS("Das Meer im Westen kennzeichnet das Ende des Festlands. Diese Region nennt "+
    "man Kuestenregion."));
  AddDetail( ({ "himmel" }),
    BS("Tiefblauer Himmel."));
  AddDetail( ({ "festland", "landesinnere" }),
    BS("Du stehst drauf."));
  AddDetail( ({ "ohren", "ohr" }),
    BS("Du kannst damit hoeren."));
  AddDetail( ({ "regen" }),
    BS("Es regnet gerade nicht!"));
  AddDetail( ({ "wind", "brise" }),
    BS("Die steife Brise fegt ueber die Kante."));

  AddSound( ({ "rauschen", "schlagen" }),
    BS("Wenn man direkt an der Kante steht, hoert man das Schlagen "+
     "der Wellen. Geht man aber ein paar Schritte weg, so wird es ruhiger und "+
     "nur das normale Rauschen des Meers ist zu vernehmen."));
  AddSmell( ({ "duft", "meer", "meers", "geruch" }),
    BS("Der typsche salzige Duft des Meers herrscht hier."));

}

