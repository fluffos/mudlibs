#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Norden kann man ein kleines Gehoeft erkennen. Im Osten scheint der Weg "+
      "an eine kleine Kreuzung zu fuehren." ));

  AddDetail( ({"gehoeft", "gruppe", "haeuser"}), BS(
    "Im Norden steht eine kleine Gruppe Haeuser. Augenscheinlich ein kleines Gehoeft." ));
  AddDetail( ({"kreuzung"}), BS(
    "Die Kreuzung befindet sich im Osten." ));
    
  AddExit( "osten" , KREUZUNG_03);
  AddExit( "suedwesten" , ROOM + "weg_zum_hafen_16.lpc" );
}
