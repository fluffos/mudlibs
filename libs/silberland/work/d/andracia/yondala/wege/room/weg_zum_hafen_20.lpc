#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Norden kann man Getreidefelder erkennen. \n" );

  AddDetail( ({"getreidefelder", "felder"}), BS(
    "Im Norden wurden ein paar Acker angelegt und Getreide gedeiht darauf." ));
  AddDetail( ({"acker", "getreide"}), BS(
    "Die Getreidefelder befinden sich im Norden." ));
    
  AddExit( "suedosten" , ROOM + "weg_zum_hafen_21.lpc");
  AddExit( "nordwesten" , ROOM + "weg_zum_hafen_19.lpc" );
}
