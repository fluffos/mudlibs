#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Duenen" );
  SetProp( P_INT_LONG, BS(
    "Ein schoener Weg in den Duenen. Diese sandige Huegel sind teilweise mit verschiedensten Straeuchern bewachsen."+
    "Man kann schon das Rauschen des Meers hoeren und eine leichte Brise treibt Sand ueber den Weg. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    BS("Man kann das Rauschen des Meers hoeren."));
  AddSound( ({ "rauschen", "meer", "geraeusche" }),
    BS("Die Wellen, die sich am Srtand brechen, verursachen diese Geraeusche."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst den salzige Geruch des Meers riechen."));
  AddSmell( ({ "geruch", "meer" }),
    BS("Das Meer hat einen typisch salzigen Geruch."));

  AddDetail( ({ "boden", "weg" }),
    BS("Der Boden besteht hier nur aus normalem Sand. Ein richtiger Weg ist auch kaum erkennbar. "+
    "Aber das Rauschen des Meers oder die gruenen Wipfel der Baeume weisen Dir den Weg."));
  AddDetail( ({ "himmel" }),
    BS("Der blaue Himmel verspricht gutes Wetter fuer diesen Tag. Nur ein paar kleine Wolken werden "+
    "vom Wind vorangetrieben."));
  AddDetail( ({ "duene", "duenen", "sandduene", "sandduenen", "sandhuegel", "huegel" }),
    BS("Die sandigen Huegel sind teilweise mit verschiedensten Straeuchern bewachsen. Vorallem Schilfgras und "+
    "grosse Rosenstraeucher wachsen hier."));
  AddDetail( ({ "straeucher", "strauch", "pflanzen", "pflanze" }),
    BS("Neben Schilf und Rosenstraeuchern kann man auch vereinzelt Sanddornstraeucher erkennen."));
  AddDetail( ({ "sand" }),
    BS("Es ist nur ganz normaler Sand."));
  AddDetail( ({ "wind", "birse" }),
    BS("Der Wind laesst das Schilf sich biegen und Sand weht ueber den Weg."));
  AddDetail( ({ "meer" }),
    BS("Das Meer kann man hin und wieder durch die Straeucher hindurch erkennen. Aber das typische Rauschen "+
    "weist einem den Weg zum Strand."));
  AddDetail( ({ "strand" }),
    BS("Wenn man dem Rauschen folgt kommt man sicher zum Strand."));
  AddDetail( ({ "wipfel", "baeume", "baum" }),
    BS("Die Baumwipfel, die sich im Wind bewegen, weisen den Weg zurueck zur Strasse."));
  AddDetail( ({ "wolke", "wolken" }),
    BS("Kleine Wolken werden vom Wind vorangetrieben."));
  AddDetail( ({ "rose", "rosenstrauch", "strauch", "rosen", "rosenstraeucher", "straeucher"  }),
    BS("Zwischen dem hochwachsendem Schilfgrass und den dornenreichen Rosen wachsen auch scheinbar ein paar "+
    "Sanddornstraeucher. "));
  AddDetail( ({ "schilf", "schilfgras" }),
    BS("Das hochgewachsene Schilf biegt sich in der leichten Brise."));
  AddDetail( ({ "sanddorn", "beeren" }),
    BS("Der Sanddorn ist leicht zu erkennen an den vielen kleinen Beeren, die an ihm haengen. Leider sind diese Beeren noch "+
    "ganz gruen."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

}

