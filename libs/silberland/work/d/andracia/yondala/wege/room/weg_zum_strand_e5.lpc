#include "../def.h"

inherit ROOM + "weg_zum_strand_wald_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + 
    BS("Dies sind wohl die letzten Baeume vor den Duenen, die den Strand abgrenzen." ));

  AddDetail( ({"duenen"}) ,
    BS("Die Duenen befinden sich nur ein kleines Stueck gen Westen."));
    
  AddExit( "nordosten" , ROOM + "weg_zum_strand_f4.lpc");
  AddExit( "westen" , ROOM + "weg_zum_strand_d5.lpc");
}
