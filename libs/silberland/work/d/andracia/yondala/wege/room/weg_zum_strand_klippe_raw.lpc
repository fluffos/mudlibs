#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Strand" );
  SetProp( P_INT_LONG,
    BS("Der schoene, weisse Sandstrand wird hier von eine hohen Klippe nach Osten begrenzt. Schroffe Felsen "+
    "bilden eine hohe Wand. Ein paar kleine Felsen ragen aus dem Sand und Seetang und anderes Strandgut haengen daran." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst wie die Wellen am Strand brechen."));
  AddSound( ({ "wellen", "geraeusch", "rauschen" }),
    BS("Am Strand herrscht das Rauschen von brechenden Wellen vor."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nur den salzigen Duft des Meeres riechen."));
  AddSmell( ({ "duft", "salz", "meer" }),
    BS("Nur der salzige Duft des Meeres dringt in deine Nase."));

  AddDetail( ({ "boden", "weg" }),
    BS("Nur feiner, weisser Sand. Ein paar Muscheln und ein bischen Seetang wurden hier angespuelt. "));
  AddDetail( ({ "himmel", "wetter" }),
    BS("Der blaue Himmel verspricht gutes Wetter fuer diesen Tag. Nur ein paar kleine Wolken werden "+
    "vom Wind vorangetrieben."));
  AddDetail( ({ "sandstrand", "strand" }),
    BS("Du befindest Dich hier auf einem sehr idyllischen Sandstrand. Feiner, weisser Sand bis zum Meer. "+
    "Die Wellen brechen hier zwischen den wenigen Felsen und erfuellen die Luft mit dem Rauschen des Meers."));
  AddDetail( ({ "sand" }),
    BS("Der Sand ist sehr fein und hat eine besonders helle Faerbung. "));
  AddDetail( ({ "wind", "brise" }),
    BS("Es ist nur eine leichte Brise die Dir den Duft des Meeres an deine Nase traegt. Langsam schieben sich "+
    "kleine Wolken ueber den ansonsten blauen Himmel. " ));
  AddDetail( ({ "wolke", "wolken" }),
    BS("Kleine Wolken werden vom Wind vorangetrieben."));
  AddDetail( ({ "meer", "westen" }),
    BS("Das blaue Meer erstreckt sich bis zum Horizont nach Westen. "));
  AddDetail( ({ "klippe", "osten", "klippen", "felswand", "wand" }),
    BS("Die schroffe Felswand begrenzt den Strand nach Osten."));
  AddDetail( ({ "farbe", "faerbung", "weiss" }),
    BS("Der Sand ist sehr hell, schon fast weiss."));
  AddDetail( ({ "horiziont" }),
    BS("So weit man sehen kann erstreckt sich das Meer gen Westen. Man kann daher nicht erkennen "+
    "was sich hinter dem Horizont befindet."));
  AddDetail( ({ "seetang", "muscheln", "strandgut" }),
    BS("Soweit du sehen kannst besteht das Strandgut hier nur aus losem Seetang und ein paar kleine Muscheln."));
  AddDetail( ({ "fels", "felsen" }),
    BS("Ein paar Felsen liegen hier am Sandstrand. Scheinbar von der Klippe abgebrochene Stuecke. "));
  AddDetail( ({ "luft" }),
    BS("Die Luft ist klar."));
  AddDetail( ({ "horizont" }),
    BS("Man kann nicht erkennen was sich hinter dem Horizont befindet."));

/* 
  AddDetail( ({ "" }),
    BS(""));
*/

}

