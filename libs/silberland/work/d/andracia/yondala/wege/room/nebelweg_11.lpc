#include "../def.h"
inherit ROOM + "nebelweg_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
   SetProp( P_INT_LONG,
    "Du stehst mitten in einem nebeligen Wald. Hier ist es so dunkel, dass "
	"es kaum mehr Straeucher oder Buesche gibt, denn nur wenig Licht "
	"gelangt durch die Baeume bis auf den Boden und das bisschen Licht, "
	"dass durch die Baeume reicht wird vom Nebel fast verschluckt."
	"\nAllerdings hast Du das Gefuehl, dass westlich von Dir die Baeume nicht "
    "ganz so eng zusammenstehen." );
 AddItem( NPC+"nebelkraehe.lpc" , REFRESH_DESTRUCT);

  AddDetail( ({ "baeume" }),
    "Die Baeume hier sind sehr hoch gewachsen, dennoch sehen sie irgendwie verkrueppelt aus und "
    "durch ihre dunkle Rinde wirken sie noch bedrohlicher. Ihre Aeste lassen kaum Licht auf den "
    "Boden dringen.\nAllerdings hast Du das Gefuehl, dass westlich von Dir die Baeume nicht "
    "ganz so eng zusammenstehen.");
  AddDetail( ({ "gefuehl" }),
    "Wenn Dich Dein Gefuehl nicht taeuscht, kann man den Weg hier vielleicht verlassen.");
  AddDetail( ({ "weg" }),
    "Versuch es doch einfach, was soll schon passieren...?");


  AddSpecialExit( "westen", "westlauf");
  SetProp(P_HIDE_EXITS, ({"westen"}) );

 AddExit( "norden", "./nebelweg_10" );
 AddExit( "sueden", "./nebelweg_12" );
   //Versteckt alle unsichtbaren Ausgaenge aus dem Standartraum
  SetProp(P_HIDE_EXITS, m_indices(QueryProp(P_SPECIAL_EXITS)));
    AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );
}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden"||str=="westen")
	{
		write("Der Weg in diese Richtung scheint frei zu sein.\n");
		return 1;
	}
   else if(str=="nordosten"||str=="osten"||str=="suedosten"
         ||str=="suedwesten"||str=="nordwesten")
		 
  	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
write("So etwas kannst Du hier nicht ertasten.\n");
return 1;
}
int westlauf(string dir)
{
  return this_player()->move("/d/andracia/yondala/nebelwaelder/nebel/room/nebel_4j", M_GO, 0,
                  "verschwindet im Nebel", "tritt aus dem Nebel");
  }