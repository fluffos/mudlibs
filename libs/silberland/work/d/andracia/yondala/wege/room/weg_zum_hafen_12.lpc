#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Hier geht es erstmal noch nicht weiter. \n" );
  
    
  AddExit( "osten" , ROOM + "weg_zum_hafen_13.lpc");
  AddExit( "westen" , ROOM + "weg_zum_hafen_11.lpc" );
}
