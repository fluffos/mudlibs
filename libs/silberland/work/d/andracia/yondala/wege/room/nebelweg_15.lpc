#include "../def.h"
inherit ROOM + "nebelweg_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  
 AddExit( "norden", "./nebelweg_14" );
 AddExit( "sueden", "./nebelweg_16" );
  //Versteckt alle unsichtbaren Ausgaenge aus dem Standartraum
  SetProp(P_HIDE_EXITS, m_indices(QueryProp(P_SPECIAL_EXITS)));

  AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );
}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden")
	{
		write("Der Weg in diese Richtung scheint frei zu sein.\n");
		return 1;
	}
   else if(str=="nordosten"||str=="osten"||str=="suedosten"
         ||str=="suedwesten"||str=="westen"||str=="nordwesten")
		 
  	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
write("So etwas kannst Du hier nicht ertasten.\n");
return 1;
}