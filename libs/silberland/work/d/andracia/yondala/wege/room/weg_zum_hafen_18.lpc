#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Norden kann man Getreidefelder erkennen. Im Westen scheint der Weg "+
      "an eine kleine Kreuzung zu fuehren." ));

  AddDetail( ({"getreidefelder", "felder"}), BS(
    "Im Norden wurden ein paar Acker angelegt und Getreide gedeiht darauf." ));
  AddDetail( ({"acker", "getreide"}), BS(
    "Die Getreidefelder befinden sich im Norden." ));
  AddDetail( ({"kreuzung"}), BS(
    "Die Kreuzung befindet sich im Westen." ));

    
  AddExit( "osten" , ROOM + "weg_zum_hafen_19.lpc");
  AddExit( "westen" , KREUZUNG_03 );
}
