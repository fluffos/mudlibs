#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Westen kann man schon die ersten Gebaeude des Hafendorfs sehen." ));

  AddDetail( ({"westen", "gebaeude", "hafendorf", "dorf"}), BS(
    "Im Westen kann man schon die ersten Gebaeude des Hafendorfs sehen." ));
    
  AddExit( "suedosten" , ROOM + "weg_zum_hafen_03.lpc");
  AddExit( "westen" , ROOM + "weg_zum_hafen_01.lpc" );
}
