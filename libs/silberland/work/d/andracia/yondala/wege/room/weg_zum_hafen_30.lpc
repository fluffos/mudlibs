#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Osten scheint der Weg an einer Kreuzung zu enden." ));

  AddDetail( ({"kreuzung"}), BS(
    "Eine Kreuzung befindet sich im Osten." ));
    
  AddExit( "westen" , ROOM + "weg_zum_hafen_29.lpc");
  AddExit( "osten" , ROOM + "kreuzung_01.lpc" );
}
