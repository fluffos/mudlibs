#include "../def.h"

inherit ROOM + "weg_zum_hafen_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Norden kann man ein kleines Gehoeft erkennen. \n");

  AddDetail( ({"gehoeft", "gruppe", "haeuser"}), BS(
    "Im Norden steht eine kleine Gruppe Haeuser. Augenscheinlich ein kleines Gehoeft." ));
    
  AddExit( "nordosten" , ROOM + "weg_zum_hafen_17.lpc");
  AddExit( "suedwesten" , ROOM + "weg_zum_hafen_15.lpc" );
}
