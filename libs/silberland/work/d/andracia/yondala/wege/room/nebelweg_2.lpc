#include "../def.h"
inherit ROOM + "nebelweg_std.lpc";
#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem nebeligen Wald" );
  SetProp( P_INT_LONG,
    "Du stehst in einem nebeligen Wald. Nach Sueden hin wir er immer duesterer, etwas weiter "
    "noerdlich kannst Du ihn offensichtlich verlassen. Hier ist es so dunkel, dass es kaum mehr "
    "Straeucher oder Buesche gibt, denn nur wenig Licht gelangt durch die Baeume bis auf den Boden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  AddItem( NPC+"nebelkraehe.lpc" , REFRESH_DESTRUCT);

  AddDetail( ({ "waldrand","rand", "rande" }),
    "Der Waldrand ist noerdlich von Dir.");
  AddDetail( ({ "wald" }),
    "Du stehst ziemlich tief im Wald, zwar kannst Du im Norden den Rand noch sehen, doch "
    "ist es hier schon recht dunkel und Nebelschwaden wabern ueber den Boden.");
  AddDetail( ({ "norden" }),
    "Im Norden liegt schon der Waldrand. Dort kannst Du den finsteren Wald verlassen.");
  AddDetail( ({ "sueden" }),
    "Im Sueden verdichtet sich der Wald, er wird finsterer und noch mehr Nebel wabert dort "
    "zwischen den Baeumen.");
  AddDetail( ({ "nebel", "nebelschwaden","schwaden" }),
    "Der Nebel ist hier zwar noch recht schwach, aber dennoch praesent. Er wabert ueber den Boden. "
    "Im Sueden breitet er sich weiter aus.");
  AddDetail( ({ "baeume" }),
    "Die Baeume hier sind sehr hoch gewachsen, dennoch sehen sie irgendwie verkrueppelt aus und "
    "durch ihre dunkle Rinde wirken sie noch bedrohlicher. Ihre Aeste lassen kaum Licht auf den "
    "Boden dringen.");
  AddDetail( ({ "rinde" }),
    "Die Rinde der Baeume ist so dunkel, dass sie fast schwarz ist.");
  AddDetail( ({ "aeste" }),
    "Die Aeste der Baeume ragen weit ueber Dir heraus. Sie sind so stark veraestelt, dass kaum "
    "Licht durch sie hindurch dringt.");
  AddDetail( ({ "licht" }),
    "Viel Licht lassen die Baeume nicht mehr herein, alles liegt im trueben Zwielicht.");
  AddDetail( ({ "zwielicht" }),
    "Wenn Du tiefer in den Wald nach Sueden vordringen willst wirst Du vermutlich nicht mehr viel "
    "sehen koennen.");
  AddDetail( ({ "buschwerk" }),
    "Viele verschiedenste Buesche wachsen im Norden.");
  AddDetail( ({ "buesche" }),
    "Du siehst verschiedenste Buesche, die sich lediglich durch ihre Blaetter unterscheiden. "
    "Ein Busch allerdings traegt noch dazu saftig rote Beeren.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter hier sind allesamt gruen, variieren aber in Groesse und Form.");
  AddDetail( ({ "groesse","form" }),
    "Darin unterscheiden sich die Blaetter.");
  AddDetail( ({ "busch", "beeren" }),
    "Du muesstest nach Norden gehen, um mehr zu sehen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist moosbedeckt, ein duenner Schleier aus Nebel wabert ueber ihn hinweg.");
  AddDetail( ({ "moos" }),
    "Das Moos ist weich und feucht. Es daempft jeden Deiner Schritte.");
  AddDetail( ({ "schritte" }),
    "Deine Schritte werden durch das Moos gedaempft.");
  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du hier nicht mehr sehen, lediglich im Norden siehst Du einen kleinen "
    "Ausschnitt.");
  AddDetail( ({ "ausschnitt" }),
    "Du siehst einen kleinen, blauen Ausschnitt des Himmels im Norden.");
  AddDetail( ({ "schleier" }),
    "Duenner Nebel wabert hier herum.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "gruen" }),
    "Es scheint den Bueschen gut zu gehen.");

  AddDetail( ({ "straeucher" }),
    "Es sind kaum mehr welche zu sehen.");
  AddDetail( ({ "" }),
    "");



  AddExit( "sueden", "./nebelweg_3" );
  AddExit( "norden", "./nebelweg_1" );
  //Versteckt alle unsichtbaren Ausgaenge aus dem Standartraum
  SetProp(P_HIDE_EXITS, m_indices(QueryProp(P_SPECIAL_EXITS)));
    AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );

  AddCmd( ({ "taste", "tast","erstaste","ertast" }), "tasten" );
}

int tasten(string str)
{
	notify_fail("Was moechtest Du ertasten?\n");
	if(str=="norden"||str=="sueden")
	{
		write("Der Weg in diese Richtung scheint frei zu sein.\n");
		return 1;
	}
   else if(str=="nordosten"||str=="osten"||str=="suedosten"
         ||str=="suedwesten"||str=="westen"||str=="nordwesten")
		 
  	{
		write("Dort ertastest Du einen Baum.\n");
		return 1;
	}
write("So etwas kannst Du hier nicht ertasten.\n");
return 1;
}

