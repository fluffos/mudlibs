#include "../def.h"

inherit ROOM + "weg_um_turm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();
  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
      "Im Suedwesten endet der Park und der Kiesweg an einer Kreuzung." ));

  AddDetail( ({"kreuzung"}), BS(
    "Die Kreuzung befindet sich im Suedwesten." )); 
      
  AddExit( "suedwesten" , KREUZUNG_05 );
  AddExit( "nordosten" , ROOM + "weg_um_turm_b6.lpc" );
}
