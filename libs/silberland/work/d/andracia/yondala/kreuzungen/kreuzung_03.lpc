#include "../def.h"
#include "kreuzung_03.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  string wegweisertext;
  ::create();
  
  SetProp( P_INT_SHORT, "Kreuzung" );
  SetProp( P_INT_LONG,
    "Diese Strasse verlaeuft von dieser Kreuzung nach Ost und West am Waldrand entlang. "+
    "Im Dickicht zwischen den Baeumen im Sueden koennen sich allerlei Tiere und "+
    "Raeuber verstecken. Im Norden kann man ein kleines Gehoeft mit seinen Getreidefeldern "+
    "erkennen. Dahinter erstreckt sich das Huegelland. Gras und "+
    "vereinzelte Buesche bestimmen dort das Bild. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "wegweiser" }),
    "Du kannst darauf lesen wohin die Wege hier fuehren. \n");
  AddDetail( ({ "kreuzung" }),
    BS("Mehrere Wege treffen hier auf diese Kreuzung. Lies doch den Wegweiser um "+
    "zu erfahren, welcher Weg wohin fuehrt. "));
  AddDetail( ({"boden", "strasse", "weg"}),
    BS("Die Spuren von vielen Raedern und Pferden haben die Strasse ausgewaschen. "+
    "Rinnen sind entstanden, wie Schienen fuehrt der Weg dem Waldrand entlang. " ));
  AddDetail( ({"himmel"}),
    BS("Tiefbauer Himmel mit vielen Wolken. Ein paar Voegel ziehen hoch in den "+
    "Lueften ihre Bahnen, zu hoch um sie zujagen. "));
  AddDetail( ({"wetter"}),
    BS("Schoen sonnig. Regen ist in naechster Zeit nicht zu erwarten. "));
  AddDetail( ({"gehoeft", "gruppe", "haeuser", "herberge"}), BS(
    "Im Nordwesten steht eine kleine Gruppe Haeuser. Augenscheinlich ein kleines Gehoeft." ));
  AddDetail( ({"getreidefelder", "felder"}), BS(
    "Im Nordosten wurden ein paar Acker angelegt und Getreide gedeiht darauf." ));
  AddDetail( ({"acker", "getreide"}), BS(
    "Die Getreidefelder befinden sich im Nordosten." ));

  AddSmell( DEFAULT_SMELL,
    BS("Der Duft des Waldes zieht von Sueden herueber. "));
  AddSound( DEFAULT_SOUND,
    BS("Zirpen der Grillen und zwitschern der Voegel erfuellt die Luft. "));


  AddDetail( ({"waldrand"}),
    BS("Der Wald im Sueden ist dicht und dunkel. Wer weiss was so alles an Tieren "+
    "und Raeubern darin wohnt. "));
  AddDetail( ({"wald", "waldes"}),
    BS("Viele Baeume ergeben einen Wald. Suedlich des Weges steht einer. "));
  AddDetail( ({"dickicht", "unterholz"}),
    BS("Zwischen den Baeumen des Waldes im Sueden stehen Straeucher und Farne, "+
    "die es verhindern tiefer ind den Wald zublicken. "));
  AddDetail( ({"baeume", "baeumen", "baum"}),
    BS("Die Baeume bilden im Sueden den Wald. "));
  AddDetail( ({"tiere", "monster"}),
    BS("Im Unterholz des Waldes hausen bestimmt fuerchterliche Monster."));
  AddDetail( ({"raeuber"}),
    BS("Die Raeuber koennten im nahen Wald lauern."));
  AddDetail( ({"huegelland", "land"}),
    BS("Viele Senken des Huegellands kann man nicht einsehen. Buesche "+
    "und Gras wachsen auf den sanften Erhebungen. "));
  AddDetail( ({"gras"}),
    BS("Vorallem saftiges Gras waechst auf den Huegeln des Huegellands. "));
  AddDetail( ({"buesche", "busch"}),
    BS("Dazu musst Du die Strasse verlassen. "));
  AddDetail( ({"bild", "idylle"}),
    BS("Das sonnengeflutete Huegelland bietet das Bild einer Idylle. "));
  AddDetail( ({"spuren"}),
    BS("Die Kutschen und Reiter haben hier den weg schon sehr ausgetreten. "));
  AddDetail( ({"raedern", "raeder", "rad"}),
    BS("Kutschen und Karren brauchen Raeder um voran zukommen. "));
  AddDetail( ({"pferden", "pferde", "pferd", "weggefaehrte"}),
    BS("Ein Pferd ist guter Weggefaehrte. "));
  AddDetail( ({"rinnen", "schienen"}),
    BS("Die ausgetretene Strasse aehnelt zwei paralellen Rinnen"));
  AddDetail( ({"wolken", "watte"}),
    BS("Wie weisse Watte ziehen die Wolken uebers Land."));
  AddDetail( ({"vogel", "voegel"}),
    BS("Hoch oben in den Lueften ziehen sie ihre Bahnen."));
  AddDetail( ({"luft", "lueften"}),
    BS("Atmen ist wichtig! "));
  AddDetail( ({"bahnen"}),
    BS("Du beobachtest die Bahnen die die Voegel am Himmel zeichnen. Meisst "+
    "sind es Kreise die von den Voegeln geflogen werden. "));
  AddDetail( ({"regen"}),
    BS("Kein Regen zu erwarten. "));
  AddDetail( ({"zeit"}),
    BS("Troedel nicht herum! "));
  AddDetail( ({"duft"}),
    BS("Rieche lieber. "));
  AddDetail( ({"strauch", "farn", "straeucher", "farne", "pflanzen"}),
    BS("Viele Pflanzen wachsen im Wald. "));
  AddDetail( ({"senken", "tal", "taeler"}),
    BS("Das Huegelland hat auch Senken. "));
  AddDetail( ({"erhebungen", "huegel"}),
    BS("Wenn man ueber das Huegelland schaut erkennt man vorallem die "+
    "grasbewachsenen Huegel."));
  AddDetail( ({"transport", "kutsche", "karren", "kutschen"}), BS(
    "Hin und wieder kommt die Kutsche hier vorbei." ));
  AddDetail( ({"kreise"}), BS(
    "Die Voegel fliegen am Himmel und beschreiben kreisfoermige Bahnen." ));
  AddDetail( ({"reiter"}), BS(
    "Gerade keiner da." ));

  AddSmell( ({"duft", "wald", "waldes", "erde", "rinde"}),
    BS("Der Duft des Waldes: Harz, verrottende Rinde und feuchte Erde."));
  AddSound( ({"zwitschern", "voegel"}),
    BS("Nett."));
  AddSound( ({"zirpen", "grillen"}),
    BS("Auch nett. "));

  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 225 );

  wegweisertext = "Der Wegweiser hat folgende Schilder: \n";

  if( KREUZUNG_NORDEN_INFO     != "" ) wegweisertext += "Norden    : "+KREUZUNG_NORDEN_INFO    +"\n" ;
  if( KREUZUNG_NORDOSTEN_INFO  != "" ) wegweisertext += "Nordosten : "+KREUZUNG_NORDOSTEN_INFO +"\n" ;
  if( KREUZUNG_OSTEN_INFO      != "" ) wegweisertext += "Osten     : "+KREUZUNG_OSTEN_INFO     +"\n" ;
  if( KREUZUNG_SUEDOSTEN_INFO  != "" ) wegweisertext += "Suedosten : "+KREUZUNG_SUEDOSTEN_INFO +"\n" ;
  if( KREUZUNG_SUEDEN_INFO     != "" ) wegweisertext += "Sueden    : "+KREUZUNG_SUEDEN_INFO    +"\n" ;
  if( KREUZUNG_SUEDWESTEN_INFO != "" ) wegweisertext += "Suedwesten: "+KREUZUNG_SUEDWESTEN_INFO+"\n" ;
  if( KREUZUNG_WESTEN_INFO     != "" ) wegweisertext += "Westen    : "+KREUZUNG_WESTEN_INFO    +"\n" ;
  if( KREUZUNG_NORDWESTEN_INFO != "" ) wegweisertext += "Nordwesten: "+KREUZUNG_NORDWESTEN_INFO+"\n" ;
  if( KREUZUNG_UNTEN_INFO      != "" ) wegweisertext += "Unten     : "+KREUZUNG_UNTEN_INFO     +"\n" ;
  
  AddReadDetail( ({ "wegweiser" }), wegweisertext);

  if( KREUZUNG_NORDEN_INFO     != "" ) 
  	AddDetail( "norden",     "Der Weg im Norden fuehrt "+KREUZUNG_NORDEN_INFO +"\n");
  if( KREUZUNG_NORDOSTEN_INFO  != "" ) 
  	AddDetail( "nordosten",  "Der Weg im Nordosten fuehrt "+KREUZUNG_NORDOSTEN_INFO +"\n");
  if( KREUZUNG_OSTEN_INFO      != "" ) 
  	AddDetail( "osten",      "Der Weg im Osten fuehrt "+KREUZUNG_OSTEN_INFO +"\n");
  if( KREUZUNG_SUEDOSTEN_INFO  != "" ) 
  	AddDetail( "suedosten",  "Der Weg im Suedosten fuehrt "+KREUZUNG_SUEDOSTEN_INFO +"\n");
  if( KREUZUNG_SUEDEN_INFO     != "" ) 
  	AddDetail( "sueden",     "Der Weg im Sueden fuehrt "+KREUZUNG_SUEDEN_INFO +"\n");
  if( KREUZUNG_SUEDWESTEN_INFO != "" ) 
  	AddDetail( "suedwesten", "Der Weg im Suedwesten fuehrt "+KREUZUNG_SUEDWESTEN_INFO +"\n");
  if( KREUZUNG_WESTEN_INFO     != "" ) 
  	AddDetail( "westen",     "Der Weg im Westen fuehrt "+KREUZUNG_WESTEN_INFO +"\n");
  if( KREUZUNG_NORDWESTEN_INFO != "" ) 
  	AddDetail( "nordwesten", "Der Weg im Nordwesten fuehrt "+KREUZUNG_NORDWESTEN_INFO +"\n");
  if( KREUZUNG_UNTEN_INFO      != "" ) 
  	AddDetail( "unten",      "Das Loch im Boden fuehrt "+KREUZUNG_UNTEN_INFO +"\n");

  if( KREUZUNG_NORDEN     != "" ) AddExit( "norden",     KREUZUNG_NORDEN );
  if( KREUZUNG_NORDOSTEN  != "" ) AddExit( "nordosten",  KREUZUNG_NORDOSTEN );
  if( KREUZUNG_OSTEN      != "" ) AddExit( "osten",      KREUZUNG_OSTEN );
  if( KREUZUNG_SUEDOSTEN  != "" ) AddExit( "suedosten",  KREUZUNG_SUEDOSTEN );
  if( KREUZUNG_SUEDEN     != "" ) AddExit( "sueden",     KREUZUNG_SUEDEN );
  if( KREUZUNG_SUEDWESTEN != "" ) AddExit( "suedwesten", KREUZUNG_SUEDWESTEN );
  if( KREUZUNG_WESTEN     != "" ) AddExit( "westen",     KREUZUNG_WESTEN );
  if( KREUZUNG_NORDWESTEN != "" ) AddExit( "nordwesten", KREUZUNG_NORDWESTEN );
  if( KREUZUNG_UNTEN      != "" ) AddExit( "unten",      KREUZUNG_UNTEN );
 
}
