#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzbuckler");
  SetProp(P_LONG, BS(
    "Ein Buckler aus Holz. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Holzbuckler");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, MALE);
  AddId( ({"buckler", "holzbuckler" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1860);
  SetProp(P_VALUE, 1530);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([0:70]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:3, A_DEX:3]) );
}


