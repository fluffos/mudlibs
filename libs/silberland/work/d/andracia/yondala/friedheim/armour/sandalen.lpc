#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Sandalen");
  SetProp(P_LONG,
    "Einfache Sandalen aus Stoff und einer Ledersohle. \n" );
  SetProp(P_INFO, "Nur einfache Sandalen." );
  SetProp(P_NAME, "Sandalen");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"sandalen"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_CLOTH:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 180);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 30 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
