#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Bierschuerze");
  SetProp(P_LONG, BS(
    "Eine einfache Schuerze aus Stoff. Es binfinden sich einige Flecken darauf. Dem Geruch nach wohl altes Bier.")  );
  SetProp(P_INFO, "Dies Schuerze ist eigentlich nutzlos." );
  SetProp(P_NAME, "Bierschuerze");
  
  // AddSmell( DEFAULT_SMELL, "Diese Schuerze stinkt nach altem Bier.\n" );
  AddDetail( ({"flecken"}), "Es scheint sich um Bierflecken zu handeln.\n" );
  AddDetail( ({"bierflecken"}), "Nur ganz normale Bierflecken.\n" );
  // AddSmell( ({"flecken", "schuerze", "bierflecken", "bier"}), "Diese Schuerze stinkt nach altem Bier.\n" ); 
  
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze", "bierschuerze" }) );
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 140);
  SetProp(P_VALUE, 170);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 80, 0:60]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}


