#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine einfaches Paar Lederarmschienen");
  SetProp(P_LONG, BS(
    "Eine einfaches Paar Armschienen aus Leder. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederarmschienen");
  SetProp(P_NAME_ADJ, "einfach");
  // SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armschienen", "lederarmschienen" }) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


