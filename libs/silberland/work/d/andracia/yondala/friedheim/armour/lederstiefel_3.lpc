#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein einfaches Paar Lederstiefel");
  SetProp(P_LONG, BS(
    "Ein einfaches Paar Stiefel aus Leder. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederstiefel");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stiefel", "lederstiefel" }) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


