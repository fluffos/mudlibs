#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein guter Holzbuckler");
  SetProp(P_LONG, BS(
    "Ein guter Buckler aus Holz. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Holzbuckler");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, MALE);
  AddId( ({"buckler", "holzbuckler" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 16);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1920);
  SetProp(P_VALUE, 2030);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([0:70]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:4, A_DEX:5]) );


}


