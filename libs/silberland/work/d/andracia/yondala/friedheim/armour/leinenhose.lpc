#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Leinenhose");
  SetProp(P_LONG, BS(
    "Eine Hose aus Leinen. Ein bischen kratzig, aber ansonsten ein nettes Kleidungsstueck.") );
  SetProp(P_INFO, "Nur eine normale Hose aus Leinen." );
  SetProp(P_NAME, "Leinenhose");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hose", "leinenhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 240);
  SetProp(P_VALUE, 280);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 30 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
