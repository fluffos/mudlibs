#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Kappe");
  SetProp(P_LONG, BS(
    "Eine Kappe aus einfachem Stoff. Eine nicht allzu modische Kopfbedeckung aber gegen einen "+
    "anfliegenden Kieselstein schuetzt sie doch ein kleines bischen.") );
  SetProp(P_INFO, "Nur eine normale Kappe aus Stoff.\n" );
  SetProp(P_NAME, "Kappe");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"kappe"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 99);
  SetProp(P_VALUE, 180);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 30 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
