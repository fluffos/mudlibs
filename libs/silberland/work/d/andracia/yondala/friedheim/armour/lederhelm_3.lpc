#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Lederhelm");
  SetProp(P_LONG, BS(
    "Ein einfacher Helm aus Leder. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederhelm");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "lederhelm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


