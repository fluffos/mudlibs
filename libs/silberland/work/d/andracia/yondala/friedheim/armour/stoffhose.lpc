#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Stoffhose");
  SetProp(P_LONG,
    "Eine Hose aus Stoff. \n" );
  SetProp(P_INFO, "Nur eine normale Hose aus Stoff." );
  SetProp(P_NAME, "Stoffhose");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"hose", "stoffhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 230);
  SetProp(P_VALUE, 185);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 50 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
