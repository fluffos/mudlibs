#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gutes Paar Lederhandschuhe");
  SetProp(P_LONG, BS(
    "Ein gutes Paar Handschuhe aus Leder. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederhandschuhe");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handschuhe", "lederhandschuhe" }) );
  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 240);
  SetProp(P_VALUE, 700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );


}


