#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Brille");
  SetProp(P_LONG,
    "Eine Brille. Wenn man Sie traegt sieht man intelligenter aus.\n" );
  SetProp(P_INFO, 
    BS("Diese Brille hat die Funktion von Fensterglas - also gar keine. "+
    "Man kann durch diese Brille nicht besser sehen, sieht aber intelligenter aus. "));
  SetProp(P_NAME, "Brille");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"brille"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_MATERIAL, ([MAT_GLASS:80, MAT_IRON:20]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 280);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
