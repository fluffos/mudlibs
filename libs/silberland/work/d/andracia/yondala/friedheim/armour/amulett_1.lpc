#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein goldenes Amulett");
  SetProp(P_LONG, "Ein goldenes Amulett, welch ein Schatz! Es glitzert geheimnisvoll. \n" );
  SetProp(P_INFO, "Nur ein goldenes Amulett.\n" );
  SetProp(P_NAME, "Amulett");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett"}) );

  AddDetail( ({"glitzern"}), "War wohl nur das Licht das sich darauf gespiegelt hat.\n" );
  
  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([ MAT_GOLD ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 3900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );


}
