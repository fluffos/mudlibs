#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Stoffumhang");
  SetProp(P_LONG,
    "Ein Umhang aus Stoff. Nicht gerade modisch aber ein guter Schutz.\n" );
  SetProp(P_NAME, "Stoffumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "stoffumhang" }) );
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1520);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE:50, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}


