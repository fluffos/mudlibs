#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein bronzenes Amulett");
  SetProp(P_LONG, "Ein bronzenes Amulett, ein schöner Schatz! Es glitzert geheimnisvoll.\n" );
  SetProp(P_INFO, "Nur ein bronzenes Amulett.\n" );
  SetProp(P_NAME, "Amulett");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett"}) );

  AddDetail( ({"glitzern"}), "War wohl nur das Licht das sich darauf gespiegelt hat.\n" );
  
  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_BRONCE ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
