#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein silbernes Amulett");
  SetProp(P_LONG, "Ein silbernes Amulett, welch ein Schatz! Es glitzert geheimnisvoll.\n" );
  SetProp(P_INFO, "Nur ein silbernes Amulett.\n" );
  SetProp(P_NAME, "Amulett");
  SetProp(P_NAME_ADJ, "silbern");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett"}) );

  AddDetail( ({"glitzern"}), "War wohl nur das Licht das sich darauf gespiegelt hat.\n" );
  
  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([ MAT_SILVER ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
