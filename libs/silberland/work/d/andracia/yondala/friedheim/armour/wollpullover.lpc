#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Wollpullover");
  SetProp(P_LONG,
    "Ein Pullover aus flauschiger Wolle. Sehr hübsch und warm.\n" );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Wollpullover");
  SetProp(P_GENDER, MALE);
  AddId( ({"pullover", "Wollpullover" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 420);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE:50, 0:70]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:-4 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}


