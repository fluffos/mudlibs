#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine einfache Lederweste");
  SetProp(P_LONG, BS(
    "Eine einfache Weste aus Leder. Liefert einen ganz passablen Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederweste");
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"weste", "lederweste" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );
}


