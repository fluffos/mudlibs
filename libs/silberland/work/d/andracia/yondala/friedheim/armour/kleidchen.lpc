#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kleidchen");
  SetProp(P_LONG,
    "Ein Kleidchen aus buntem Stoff. Besonders kleidsam fuer kleine Maedchen. \n" );
  SetProp(P_INFO, "Nur ein normales Kleidchen für kleine Maedchen.\n" );
  SetProp(P_NAME, "Kleidchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleidchen", "kleid"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 20);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 30 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
