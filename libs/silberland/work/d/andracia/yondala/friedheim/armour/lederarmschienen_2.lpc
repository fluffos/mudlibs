#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Lederarmschienen");
  SetProp(P_LONG, BS(
    "Eine Paar Armschienen aus Leder. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederarmschienen");
  // SetProp(P_NAME_ADJ, "normal");
  // SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armschienen", "lederarmschienen" }) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 440);
  SetProp(P_VALUE, 950);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );
}


