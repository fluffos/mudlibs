#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Leinenhemd");
  SetProp(P_LONG,
    "Ein Hemd aus Leinen. Es kratzt ein wenig auf der Haut.\n" );
  SetProp(P_INFO, "Nur ein normales Hemd aus Leinen.\n" );
  SetProp(P_NAME, "Leinenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "leinenhemd"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 240);
  SetProp(P_VALUE, 320);
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 10, DT_POISON : 0, 0 : 30 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
