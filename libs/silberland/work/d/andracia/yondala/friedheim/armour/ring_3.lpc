#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein bronzener Ring");
  SetProp(P_LONG, "Ein bronzener Ring, ein schöner Schatz! Er glitzert geheimnisvoll. \n" );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Ring");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_BRONCE ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}
