#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine gute Lederhose");
  SetProp(P_LONG, BS(
    "Eine gute Hose aus Leder. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederhose");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "lederhose" }) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1590);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );


}


