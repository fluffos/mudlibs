#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein goldener Ring");
  SetProp(P_LONG, "Ein goldener Ring, welch ein Schatz! Er glitzert geheimnisvoll. \n" );
  SetProp(P_INFO, "" );
  SetProp(P_NAME, "Ring");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([ MAT_GOLD ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([]) );


}
