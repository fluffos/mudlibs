#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein guter Lederhelm");
  SetProp(P_LONG, BS(
    "Ein guter Helm aus Leder. Liefert einen sehr guten Schutz gegen allerlei Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederhelm");
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "lederhelm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:5]) );


}


