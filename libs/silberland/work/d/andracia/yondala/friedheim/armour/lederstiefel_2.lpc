#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Lederstiefel");
  SetProp(P_LONG,
    "Ein Paar Stiefel aus Leder. Liefert einen guten Schutz gegen viele Angriffe." );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederstiefel");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stiefel", "lederstiefel" }) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:2]) );
}


