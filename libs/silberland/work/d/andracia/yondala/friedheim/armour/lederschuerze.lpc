#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Lederschuerze");
  SetProp(P_LONG, BS(
    "Eine dicke Schuerze aus Leder.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "lederschuerze");
  
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze", "lederschuerze" }) );
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 180);
  SetProp(P_VALUE, 270);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 90, 0:70]) );
  SetProp(P_WEAR_RESTRICTIONS, ([]) );
}


