#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Lederguertel");
  SetProp(P_LONG, BS(
    "Ein Guertel aus Leder. Liefert einen guten Schutz gegen viele Angriffe.") );
  // SetProp(P_INFO, "" );
  SetProp(P_NAME, "Lederguertel");
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "lederguertel" }) );
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 350);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_BLUDGEON: 100, 0:80]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:1]) );
}


