#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Streitkolben");
  SetProp(P_LONG, "Ein Streitkolben. Damit willst Du lieber nicht getroffen werden. " );
  SetProp(P_INFO, "Kleingetier haut man damit zu Brei. ");
  SetProp(P_NAME, "Streitkolben");
  SetProp(P_GENDER, MALE);
  AddId( ({ "keule", "streitkolben", "kolben" }) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 85);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 2800);
  SetProp(P_SIZE, 90);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:3]) );
}

