#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Schmiedehammer");
  SetProp(P_LONG, "Ein Schmiedehammer. Sehr nuetzlich um Metall zu bearbeiten. " );
  SetProp(P_INFO, "Kleingetier kann man damit sicher zerquetschen. ");
  SetProp(P_NAME, "Schmiedehammer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "hammer", "schmiedehammer" }) );
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ MAT_WOOD:40, MAT_IRON:60]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:4]) );
}

