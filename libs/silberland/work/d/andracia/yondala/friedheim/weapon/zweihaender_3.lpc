#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Zweihaender");
  SetProp(P_LONG, "Ein einfacher Zweihaender mit einer langen, scharfen Klinge. Nicht das Beste am Markt aber brauchbar. " );
  SetProp(P_INFO, "Kaefer kann man damit bestimmt gut bezwingen.");
  SetProp(P_NAME, "Zweihaender");
  SetProp(P_GENDER, MALE );
  AddId( ({"schwert", "zweihaender"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 65);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 140);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:1]) );
}

