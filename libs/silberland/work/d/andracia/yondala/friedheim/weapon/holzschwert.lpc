#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzschwert");
  SetProp(P_LONG, "Ein einfaches Holzschwert. Eigentlich mehr Spielzeug als Waffe. " );
  SetProp(P_INFO, "Kleine Kaefer kann man damit bestimmt bezwingen.");
  SetProp(P_NAME, "Holzschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "holzschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE : 10, 0:100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([]) );
}
