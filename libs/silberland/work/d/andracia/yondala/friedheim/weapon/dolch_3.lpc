#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Dolch");
  SetProp(P_LONG, "Ein einfacher Dolch. Eine leicht zu Handhabende Waffe. " );
  SetProp(P_INFO, "Insekten und anderes Kleingetier kann damit bestimmt bezwungen werden. ");
  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE );
  AddId( ({ "dolch"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 45);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:1]) );
}

