#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine gute Handaxt");
  SetProp(P_LONG, "Eine gute Handaxt. Sie liegt sehr gut in der Hand. " );
  SetProp(P_INFO, "In einer starken Hand kann dies eine gefaehrliche Waffe sein. ");
  SetProp(P_NAME, "Handaxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "handaxt"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 75);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:4]) );


}

