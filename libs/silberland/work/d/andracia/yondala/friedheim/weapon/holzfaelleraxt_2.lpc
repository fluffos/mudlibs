#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Holzfaelleraxt");
  SetProp(P_LONG, "Eine Holzfaelleraxt. Liegt schwer in der Hand. " );
  SetProp(P_INFO, "Damit lassen sich bestimmt auch groessere Tiere leicht bezwingen. ");
  SetProp(P_NAME, "Holzfaelleraxt");
  SetProp(P_GENDER, FEMALE );
  AddId( ({"axt", "holzfaelleraxt"}) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 75);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:2]) );
}

