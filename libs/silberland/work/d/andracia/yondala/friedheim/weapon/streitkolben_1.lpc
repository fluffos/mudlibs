#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein guter Streitkolben");
  SetProp(P_LONG, "Ein guter Streitkolben. Mit etwas Wucht kann diese Waffe Knochen zertruemmern. " );
  SetProp(P_INFO, "Ein plazierter Schlag mit dieser Waffe laesst Knochen brechen. ");
  SetProp(P_NAME, "Streitkolben");
  SetProp(P_GENDER, MALE);
  AddId( ({ "keule", "streitkolben", "kolben" }) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 90);
  SetProp(P_VALUE, 3600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4, A_STR:4]) );


}

