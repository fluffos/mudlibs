#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Zweihaender");
  SetProp(P_LONG, "Ein Zweihaender. " );
  SetProp(P_INFO, "Grosse Kaefer kann man damit bestimmt leicht bezwingen.");
  SetProp(P_NAME, "Zweihaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"schwert", "zweihaender"}) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_SIZE, 140);
  SetProp(P_VALUE, 2800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:2]) );
}

