#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein einfacher Jagdspeer");
  SetProp(P_LONG, "Ein einfacher Jagdspeer. Leicht zu Handhabende Waffe. " );
  SetProp(P_INFO, "Insekten und anderes Kleingetier kann damit bestimmt bezwungen werden. ");
  SetProp(P_NAME, "Jagdspeer");
  SetProp(P_GENDER, MALE );
  AddId( ({ "jagdspeer", "speer"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 65);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_METAL:15, MAT_WOOD:85]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 1700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:1, A_STR:2]) );
}

