#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Dolch");
  SetProp(P_LONG, "Ein Dolch. Eine leicht zu handhabende Waffe. " );
  SetProp(P_INFO, "Insekten und anderes Kleingetier kann damit leicht bezwungen werden. ");
  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE );
  AddId( ({ "dolch"}) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 60);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 2300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:3, A_STR:2]) );
}

