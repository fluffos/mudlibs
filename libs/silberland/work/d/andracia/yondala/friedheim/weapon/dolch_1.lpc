#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein guter Dolch");
  SetProp(P_LONG, "Ein guter Dolch. Eine leicht zu handhabende Waffe. \n" );
  SetProp(P_INFO, "Insekten und anderes Kleingetier sind mit dieser Waffe kein Problem mehr. ");
  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE );
  AddId( ({ "dolch"}) );
  
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 75);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 3300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4, A_STR:3]) );


}

