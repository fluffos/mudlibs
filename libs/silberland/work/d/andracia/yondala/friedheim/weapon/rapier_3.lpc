#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein einfaches Rapier");
  SetProp(P_LONG, "Ein einfaches Rapier mit einer spitzen Klinge. Nicht das Beste am Markt aber brauchbar. " );
  SetProp(P_INFO, "Kleine Kaefer kann man damit bestimmt erstechen.");
  SetProp(P_NAME, "Rapier");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "rapier"}) );
  SetProp(P_NAME_ADJ, "einfach");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 65);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:2]) );
}

