#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein gutes Rapier");
  SetProp(P_LONG, "Ein gutes Rapier mit einer sehr spitzen Klinge. " );
  SetProp(P_INFO, "Kaefer aufzuspiessen ist hiermit bestimmt kein Problem.");
  SetProp(P_NAME, "Rapier");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "rapier"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 900);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 2300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 65);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4, A_STR:4]) );


}

