#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein guter Zweihaender");
  SetProp(P_LONG, "Ein guter Zweihaender. Geeignet um sehr tiefe Wunden zu schlagen." );
  SetProp(P_INFO, "Mit diesem Schwert kann man sich bestimmt auch an recht grosse Feinde wagen. ");
  SetProp(P_NAME, "Zweihaender");
  SetProp(P_GENDER, MALE );
  AddId( ({"schwert", "zweihaender"}) );
  SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 95);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 2400);
  SetProp(P_SIZE, 140);
  SetProp(P_VALUE, 3600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4, A_STR:3]) );


}
