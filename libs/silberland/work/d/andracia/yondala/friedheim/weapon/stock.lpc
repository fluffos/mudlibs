#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Stock");
  SetProp(P_LONG, "Ein einfacher Stock. Aeltere Leute dient dieser als Gehhilfe" );
  SetProp(P_INFO, "Kleingetier kann man damit zerquetschen. ");
  SetProp(P_NAME, "Stock");
  SetProp(P_GENDER, MALE);
  AddId( ({ "stock" }) );
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 40);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 900);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([]) );
}

