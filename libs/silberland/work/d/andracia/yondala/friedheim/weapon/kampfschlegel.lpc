#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kampfschlegel");
  SetProp(P_LONG, BS("Dieser Kampfschlegel liegt gut in der Hand und hat eiserne Beulen an seinem verdickten Schlagende. "+
    "Eine lederne Schlaufe wurde am Griff angebracht und soll verhindern dass einem diese Waffe aus der Hand gleitet.") );
  // SetProp(P_INFO, "Ein plazierter Schlag mit dieser Waffe laesst Knochen brechen. ");
  SetProp(P_NAME, "Kampfschlegel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "keule", "schlegel", "kampfschlegel" }) );
  // SetProp(P_NAME_ADJ, "gut");
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 115);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:95, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 3600);
  SetProp(P_SIZE, 90);
  SetProp(P_VALUE, 5625);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 95);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:5, A_STR:7]) );

  AddDetail( ({ "schlaufe", "lederband" }),
    BS("Die lederne Schlaufe wird um das Handgelenk gelegt und soll verhindert dass bei heftigen Schwuengen "+
    "die Waffe aus der Hand faellt. Absolute Sicherheit dass einem die Waffe nicht aus der Hand geschlagen wird, kann "+
    "dieses kleine Lederband aber nicht bieten."));

}

