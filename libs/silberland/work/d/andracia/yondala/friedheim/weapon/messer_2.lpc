#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Messer");
  SetProp(P_LONG, "Ein Messer. Leicht zu Handhaben aber nur bedingt als Waffe geeignet. " );
  SetProp(P_INFO, "Insekten und anderes Kleingetier kann damit leicht bezwungen werden. ");
  SetProp(P_NAME, "Messer");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "messer"}) );
  // SetProp(P_NAME_ADJ, "normal");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 55);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_METAL:65, MAT_WOOD:35]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_SIZE, 25);
  SetProp(P_VALUE, 1300);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2, A_STR:2]) );
}

