#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Mistgabel");
  SetProp(P_LONG, "Eine einfache Mistgabel. " );
  SetProp(P_INFO, "Insekten und anderes Kleingetier kann damit bestimmt bezwungen werden. ");
  SetProp(P_NAME, "Mistgabel");
  SetProp(P_GENDER, FEMALE );
  AddId( ({ "mistgabel", "gabel" }) );
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 40);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_METAL:15, MAT_WOOD:85]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_SIZE, 160);
  SetProp(P_VALUE, 700);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 60);
  SetProp(P_WIELD_RESTRICTIONS, ([]) );
}

