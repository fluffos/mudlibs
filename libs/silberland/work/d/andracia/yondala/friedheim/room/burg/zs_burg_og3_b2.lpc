inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Treppenhaus des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds zu Friedheim. "+
  "Im Westen scheint die Bibliothek zu liegen. Im Norden befindet sich das Spielzimmer. "+
  "Portraits schmuecken hier die Waende. "));
  
  /* Standartdetails */ 
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus massiven Holzbohlen." );
  AddDetail( ({ "waende", "steinwaende" }),
  BS("Die Waende sind alle aus Stein. Portraits wurden hier entlang der Treppe aufgeaengt. "));
  AddDetail( ({ "nordwand" }),
  BS("Hier ist eine Tuer zum Spielzimmer. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "suedwand" }),
  BS("Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "ostwand" }),
  BS("Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "westwand" }),
  BS("Hier ist eine Tuer zur Bibliothek. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddSound( DEFAULT_SOUND,
  BS("Aus dem Spielzimmer im Norden dringt Musik an Dein Ohr."));
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nichts besonderes riechen."));
  
  
  /* extra Details */ 
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "portraits", "bilder", "kunstwerke", "kunstwerk" }),  
  BS("Die in schoenen Bilderrahmen gefassten Portraits hier, zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "stein", "steine" }),  
  BS("Massive Steinwaende, die auch mehrere Treffer vom Katapult aushalten. "));
  AddDetail( ({ "treppe", "treppenhaus" }),  
  BS("Die Treppe fuehrt hier nach unten durch den gesamten Bergfried. "));
  AddDetail( ({ "spielzimmer", "bibliothek", "raeume" }),  
  BS("Geh doch einfach in einen der Raeume, um diese zu untersuchen. "));
  AddDetail( ({ "vorfahren" }),  
  BS("Alle schon laengst tot und nur noch diese Portraits erinnern an sie. "));
  AddDetail( ({ "tuer", "tueren" }),
  BS("Alle Tueren hier sind aus starken Holzbohlen gefertigt. "));
  AddDetail( ({ "ohr" }),
  BS("Damit kannst Du hoeren. "));
  AddSound( ({ "musik", "spieldose", "toene" }),
  BS("Scheinbar Toene einer Spieldose. "));
  AddDetail( ({ "holzbohlen", "bohlen"  }),  
  BS("Tueren und Boden bestehen aus massiven Holzbohlen. "));
  AddDetail( ({ "rahmen", "bilderrahmen" }),
  BS("Alle Bilderrahmen sind selbst schon filigran geschnitzte Kunstwerke."));
  AddDetail( ({ "wand", "steinwand"}),
  BS("Welche Wand willst Du denn untersuchen? Die Nordwand, Ostwand, Suedwand oder Westwand? "));
    
/*
  AddDetail( ({ "" }),
  BS(""));
*/

  // END DETAILS
  AddExit( "westen", BURG + "zs_burg_og3_a2.lpc" );
  AddExit( "norden", BURG + "zs_burg_og3_b1.lpc" );
  AddExit( "unten", BURG + "zs_burg_og2_b2.lpc" );
   
  // END EXITS
  // AddItem( "file", refresh, Props);
   
}

