#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Friedheim" );
  SetProp( P_INT_LONG, BS(
    "Dies ist der Weg nach Friedheim. Die gepflasterte Strasse "+
    "schlaengelt sich in einem grossen Bogen zum Dorf der "+
    "Burg Friedheim." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein paar Voegel zwitschern.");
  AddSound( ({ "zwitschern", "voegel" }),
    "Sehr nett.");
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse");
  AddSmell( ({ "strasse", "asphalt", "gummi", "geruch" }),
    "Also nach Asphalt und Gummi wird es nicht riechen.");

  AddDetail( ({ "strasse", "weg", "pflaster" }),
    "Der Weg ist mit groben Steinen gepflastert.");
  AddDetail( ({ "burg", "friedheim" }),
    "Eine maechtige Burg. Sie thront ueber dem gleichnamigen Dorf auf einer \n"
    "Anhoehe. Sie ist noch sehr weit Weg entfernt.");
  AddDetail( ({ "dorf", "stadt", "gruppe", "haeuser", "stadtmauer" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. \n"
    "Der Weg fuehrt direkt zum oestlichen Eingang der Stadt.");
  AddDetail( ({ "eingang", "tor" }),
    "Das Tor scheint offen zu sein.");
  AddDetail( ({ "wald" }),
    "Der Wald befindet sich im Sueden.");
  AddDetail( ({ "huegel" }),
    "Leicht geschwungen und mit kurzem Gras bewachsen");
  AddDetail( ({ "steine", "boden" }),
    "Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche.");
  AddDetail( ({"anhoehe"}), BS(
    "Die Burg Friedheim wurde auf einer Anhoehe hier im Huegelland errichtet. "+
    "Man kann sie schon im Nordwesten erkennen." ));
  AddDetail( ({"bogen"}), BS(
    "Der Weg mach hier einen Bogen. Im Sueden ist der Wald. Im Nordwesten liegt Friedheim." ));
  AddDetail( ({"kutsche", "transport"}), BS(
    "Hin und wieder kommt die Kutsche hier vorbei." ));
  AddDetail( ({"himmel"}), BS(
    "Wunderschoen blau." ));
  AddDetail( ({"huegelland"}), BS(
    "Du bist mittendrin." ));

  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 210 );
/*
  AddDetail( ({""}), BS(
    "" ));
*/

  // DETAILS END
  AddExit( "norden", WEGE + "weg_zum_dorf_d3" );
  AddExit( "sueden", WEGE + "weg_zum_dorf_d5" );
    // EXITS END
}


