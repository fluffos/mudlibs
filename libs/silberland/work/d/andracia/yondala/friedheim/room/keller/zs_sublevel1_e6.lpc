#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Ein kleines Rinnsal aus der Wand hat im Laufe der Zeit ein Becken aus "+
  "Kalkstein gebildet. Das klare Wasser steht darin etwa Handbreite tief und "+
  "laedt foermlich dazu ein es zu trinken. "));

  AddDetail( ({ "rinnsal", "fluss" }),
  BS("Es ist ein bestaendiger kleiner Fluss an klarem Wasser aus der Wand. "));
  AddDetail( ({ "becken" }),
  BS("Das Becken steht voll mit Wasser, gespeist mit dem Rinnsal aus der Wand. "));
  AddDetail( ({ "quelle" }),
  BS("Das Wasser kommt als kleines Rinnsal aus der Wand. "));
  AddDetail( ({ "lauf", "zeit" }),
  BS("Im Laufe der Zeit hat ein kleines Rinnsal dieses Becken aus Kalkstein gebildet."));

  AddCmd( ({ "trinke", "trink" }), "trinke_wasser" );

  AddExit( "osten", KELLER + "zs_sublevel1_f6.lpc" );
  AddExit( "nordwesten", KELLER + "zs_sublevel1_d5.lpc" );
  AddExit( "sueden", KELLER + "zs_sublevel1_e7.lpc" );
 
  AddItem( NPC + "kellermonster_kaefer.lpc", REFRESH_DESTRUCT );
  
}

int trinke_wasser(string str)
{
  notify_fail("Was willst Du trinken? ");
  if( str != "wasser" && str != "vom wasserfall" ) return 0;
  if( TP->drink_soft(30) ) {
  write("Du haelst deine Haende an den Wasserfall und trinkst etwas Wasser. \n");
  say( TPN + " haelt seine Haende an den Wasserfall und trinkt etwas Wasser. \n");
  TP->AddHp(10);
  TP->AddSp(10); }
  else write("Du bist nicht durstig. \n");
  return 1;
}
