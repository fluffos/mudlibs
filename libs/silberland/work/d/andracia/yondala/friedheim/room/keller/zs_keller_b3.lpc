#include "../def.h"

inherit KELLER+"zs_keller_3_raw.lpc";

#include <properties.h>
#include <language.h>

int fackel_da, neu_fackel;

void reset()
{
  ::reset();
  if(fackel_da == 0) neu_fackel--;
  if(neu_fackel == 0) {
    fackel_da = 1; 
    neu_fackel = 8;
    SetProp( P_INT_LONG ,
      BS("Du stehst in einer der Kerkerzellen von Friedheim. Die Tuer zurueck "+
      "auf den Gang ist offen. Eine Fackel an der Wand erhellt den Raum. "));
    set_light(1);
    AddDetail( ({ "wand", "waende" }),
      BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Fackel steckt hier "+
      "in einer Halterung und erhellt den Raum. Metallene Oesen sind in der Wand "+
      "eingelassen. Deliquenten koennen daran festgekettet werden. "));
    }
}

void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  fackel_da = 1;  neu_fackel = 8;
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT , "Kerker von Friedheim" );
  SetProp( P_INT_LONG ,
    BS("Du stehst in einer der Kerkerzellen von Friedheim. Die Tuer zurueck "+
    "auf den Gang ist offen. Eine Fackel an der Wand erhellt den Raum. "));

  AddDetail( ({ "wand", "waende" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Fackel steckt hier "+
    "in einer Halterung und erhellt den Raum. Metallene Oesen sind in der Wand "+
    "eingelassen. Deliquenten koennen daran festgekettet werden. "));
  AddSpecialDetail( ({ "licht", "fackel" }), "unt_licht");

  AddCmd( ({ "ziehe", "zieh" }), "zieh_fackel" );

  AddExit( "norden", KELLER + "zs_keller_b2.lpc" );
}

string unt_licht()
{
	if( fackel_da == 0)
		return "Es ist keine Fackel da. \n";  
	return "Eine Fackel steckt in der Halterung und erleuchtet den Raum. \n";
}		
    
int zieh_fackel(string str)
{ 
  object ob;
  notify_fail("Was willst Du herausziehen? \n");
  if( str != "fackel heraus" && str != "fackel raus" ) return 0;
  notify_fail("Es ist keine Fackel da zum herausziehen. \n");
  if( fackel_da == 0 ) return 0;
  SUID;
  ob = clone_object("/obj/fackel.lpc");
  ob->move(TP, M_GET);
 // //  ob->SetProp( P_FUEL, 1000); // Fackel ist gebraucht
 // ob->SetProp( P_LIGHTED, 1); ob->SetProp( P_LIGHT, 1); // Fackel ist angezuendet und hell
  ob->_set_lighted(1);
  set_light(-1) ; // Raum wird dunkel
  write("Du ziehst die Fackel aus der Halterung. \n");
  say(TPN + " zieht die Fackel aus der Halterung. \n");
  SetProp( P_INT_LONG ,
    BS("Du stehst in einem schmalen Gang der sich weiter nach Osten erstreckt. "+
    "Im Sueden sind die Kerker, in denen die gefassten Diebe und Moerder "+
    "verschimmeln sollen. "));
  AddDetail( ({ "wand", "waende" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Halterung fuer "+
    "eine Fackel ist hier angebracht. "));
  fackel_da = 0;
  return 1;
}