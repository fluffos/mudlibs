#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Friedheim" );
  SetProp( P_INT_LONG,
    "Dies ist der Weg nach Friedheim. Die gepflasterte Strasse \n"
    "schlaengelt sich in einem grossen Bogen vom Dorf Friedheim \n"
    "bis zum Wald im Sueden. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.");
  AddSound( ({ "zwitschern" }),
    "Sehr nett.");

  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse");
  AddSmell( ({ "strasse", "asphalt", "gummi", "geruch" }),
    "Also nach Asphalt und Gummi wird es nicht riechen.");

  AddDetail( ({ "strasse", "weg", "pflaster" }),
    "Der Weg ist mit groben Steinen gepflastert.");
  AddDetail( ({ "wald" }),
    "Der Wald befindet sich im Sueden.");
  AddDetail( ({ "burg", "friedheim" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg.");
  AddDetail( ({ "dorf", "stadt", "gruppe" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. \n"
    "Der Weg fuehrt direkt zum oestlichen Eingang der Stadt.");
  AddDetail( ({ "eingang", "tor" }),
    "Das Tor scheint offen zu sein.");
  AddDetail( ({ "huegel" }),
    "Leicht geschwungen und mit kurzem Gras bewachsen");
  AddDetail( ({ "steine", "pflastersteine", "steinen" }),
    "Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche.");
  AddDetail( ({ "boden" }),
    BS("Nur einfache Pflastersteine bilden den Boden."));
  AddDetail( ({ "bogen" }),
    BS("Vom Dorf Friedheim im Westen zum Wald im Sueden."));
  AddDetail( ({ "haeuser", "stadtmauer" }),
    BS("Dazu sollte man erst mal im Dorf sein."));
  AddDetail( ({ "himmel" }),
    BS("Teifblau."));
  AddDetail( ({ "sicht" }),
    BS("Von hier aus kann man schon das Dorf mit seiner Stadtmauer im Westen sehen."));
  AddDetail( ({ "voegel" }),
    BS("Du kannst hoch im Himmel ein paar Voegel ihre Kreise ziehen."));
  AddDetail( ({ "kreise" }),
    BS("Wenn man fliegen koennte ..."));
  AddDetail( ({ "kutsche", "transport"}),
    BS("Hin und wieder kommt die Kutsche hier vorbei."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 210 );

  // DETAILS END
  AddExit( "westen", WEGE + "weg_zum_dorf_a1" );
  AddExit( "suedosten", WEGE + "weg_zum_dorf_c2" );
    // EXITS END
}


