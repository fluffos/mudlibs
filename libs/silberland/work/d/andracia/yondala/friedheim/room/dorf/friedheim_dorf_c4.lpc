#include "../def.h"
#include <properties.h>
#include <language.h>

inherit DORF + "friedheim_dorf_std.lpc";



create() {
  ::create();

  SetProp( P_INT_SHORT, "Dorf Friedheim" );
  SetProp( P_INT_LONG,
    BS("Du stehst auf dem noerdlichen Teil des Dorfplatzes. "+
    "Im Norden steht eine Kapelle und bildet das Zentrum des Dorfs.")+
    BS("Ein Schild wurde hier aufgestellt.") );

	  AddDetail( ({ "dorfplatz", "dorfplatzes", "platz", "zentrum", "treffpunkt", "teil", "seite" }),
    BS("Du befindest Dich hier auf dem suedlichen Teil des Dorfplatzes. Er erstreckt sich weiter nach "+
    "Osten, Sueden und Westen. Im Sueden kannst Du ein grosses Denkmal sehen. Im Norden ist eine grosse "+
    "Kapelle."));
	
  AddDetail( ({ "denkmal" }),
    BS("Dazu must Du naeher nach Sueden herangehen."));
  AddDetail( ({ "welt", "reisen" }),
    BS("Ziehe los und erkunde die Welt, Du wagemutiger Abenteurer."));
  AddDetail( ({ "schild", "holzschild" }),
    BS("Ein ganz normales Holzschild mit Hinweisen darauf geschrieben.") );
  AddReadDetail( ({ "schild", "holzschild" }),
    "+--------------------------------------+\n"+ 
    "| Die Postkutsche haelt hier und nimmt |\n"+ 
    "| Reisende mit bis zum Hafen.          |\n"+ 
    "+--------------------------------------+\n" ); 
  AddDetail( ({ "hinweise", "hinweis" }),
    BS("Du kannst bestimmt lesen was auf dem Schild geschrieben steht. Los - versuch es einfach."));
  AddDetail( ({ "kapelle" }),
    BS("Nach Norden hin kannst Du sie betreten."));
/*	
  AddDetail( ({ "geheimnisse", "gefahren" }),
    BS("Davon gibt es viele."));
  AddDetail( ({ "monster", "wesen" }),
    BS("Vielleicht triffst Du ja noch welche auf Deinen Reisen."));
  AddSound( DEFAULT_SOUND,
    BS("Eine umfangreiche Geraeuschkulisse von Haendlern und Dorfbewohnern. "));
  AddSound( ({ "geraeuschkulisse", "geraeusche", "reden", "arbeiter", "dorfbewohner", "summe" }),
    BS("Hier herrscht reger Betrieb und das Reden und Arbeiten der Dorfbewohner bildet in Summe "+
    "diese umfangreiche Geraeuschkulisse."));
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse. ");
  AddSmell( ({ "strasse" }),
    "Hauptsaechlich riecht es nach Staub.");
  AddSmell( ({ "geruch" }),
    BS("Es riecht nach staubiger Strasse."));
  AddDetail( ({ "asphalt", "gummi" }),
    BS("Danach riecht es hier nicht."));

  AddDetail( ({ "himmel", "wetter" }),  
    BS("Schoenes Wetter heute! Du erkennst einen tiefblauen Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
    "Kleine weisse Schaefchenwolken. ");
  AddDetail( ({ "stadtmauer", "mauer" }),
    BS("Du kannst den Wehrgang und die Stadtmauer nur teilweise zwischen die "+
    "Haeuser hindurch erkennen. "));
  AddDetail( ({ "wehrgang", "gang" }),
    BS("Hier ist kein Aufgang zum Wehrgang. Eine patroullierende Wache "+
    "ist nicht zu sehen. "));
  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt? ");
  AddDetail( ({ "kapelle" }),
    BS("Die Kapelle ist prunkvoll mit vielen filigranen Steinskulpturen geschmueckt. "+
    "Sie ist der Treffpunkt von allen Abenteurern. "));
  AddDetail( ({ "strasse", "weg", "pflaster", "platz", "boden" }),
    "Der Platz ist mit groben Steinen gepflastert. ");
  AddDetail( ({ "burg" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg. ");
  AddDetail( ({ "friedheim" }),
    "Du befindest Dich im Dorf zu Friedheim. ");
  AddDetail( ({ "dorf", "stadt" }),
    BS("Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. "+
    "Du bist im suedlichen Teil des Dorfplatzes. "));
  AddDetail( ({ "steine" }),
    BS("Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche. "));
  AddDetail( ({ "abenteurer", "abenteurern" }),
    BS("Alle die in die Welt hinausziehen um Geheimnisse zu ergruenden und Gefahren zu durchstehen "+
    "nennt man Abenteurer. Du selbst bist wohl auch einer."));
  AddDetail( ({ "asphalt", "gummi" }),
    BS("Das gibt es hier nicht."));
  AddDetail( ({ "aufgang" }),
    BS("Hier ist kein Aufgang zum Wehrgang."));
  AddDetail( ({ "dorfbewohner", "dorfbewohnern", "leute" }),
    BS("Alle Leute die hier leben sind friedlich und gehen strebsam ihren Tagesgeschaeften nach."));

  AddDetail( ({ "geraeuschkulisse", "geraeusche" }),
    BS("Dazu sollte man besser lauschen."));
  AddDetail( ({ "haendler" }),
    BS("Fahrende Haendler bieten den Dorfbewohnern ihre Waren an."));
  AddDetail( ({ "waren", "beduerfnisse", "auslage" }),
    BS("Viele verschiedene Waren liegen in der Auslage, aber leider nichts was ein Abenteurer benoetiget. "+
    "Die ortsansaessigen Haendler haben sicher etwas auch fuer Deine Beduerfnisse."));
  AddDetail( ({ "haeuser", "gruppe" }),
    BS("Dicht gedraengt stehen die Haeuser der Dorfbewohner. Da hier der Dorfplatz ist, sind die Haeuser "+
    "hier besonders schoen und gehoeren wohl den reicheren Dorfbewohnern."));
  AddDetail( ({ "kutsche", "transport", "transportmittel" }),
    BS("Gerade ist kein Transportmittel da."));
  AddDetail( ({ "fasade", "steinskulpturen", "skulpturen" }),
    BS("Die Fasade der Kapelle ist besonders schoen gestaltet. Filigrane Skulpturen verschiedenster Monster "+
    "und Wesen schmuecken diese Seite der Kapelle."));
  AddDetail( ({ "arbeiten", "tagesgeschaeften", "tagesgeschaeft", "betrieb" }),
    BS("Die Dorfbewohner gehen ihren Tagesgeschaeften nach. Die werden bestimmt ungemuetlich wenn ihnen "+
    "dabei nachspioniert. "));
*/
/*
  AddDetail( ({ "" }),
    BS(""));

*/
  // DETAILS END
  
  AddExit( "osten", DORF + "friedheim_dorf_d4.lpc" );
  AddExit( "westen", DORF + "friedheim_dorf_b4.lpc" );
  AddExit( "suedosten", DORF + "friedheim_dorf_d5.lpc" );
  AddExit( "suedwesten", DORF + "friedheim_dorf_b5.lpc" );
  AddExit( "norden", "/gilden/abenteurer/friedheimgilde.lpc" );
 // AddExit( "norden", DORF + "friedheimgilde.lpc" );
 
  AddExit( "sueden", DORF + "friedheim_dorf_c5.lpc" );
  // EXITS END
  AddItem( NPC + "irian_ilgur.lpc", REFRESH_DESTRUCT );
  AddItem( OBJ + "kutsche.lpc", REFRESH_NONE, 1 );
  
}

