#include "../def.h"
#include <properties.h>
#include <language.h>

inherit "std/room";


create() {
  ::create();

  SetProp( P_INT_SHORT, "Dorf Friedheim" );
  SetProp( P_INT_LONG,
    BS("Die kleine Strasse fuehrt entlang der Innenseite der Stadtmauer. "+
    "Hier stehen Haeuser von Handwerkern und Schlossbediensteten."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    BS("Eine umfangreiche Geraeuschkulisse von Haendlern und Dorfbewohnern. "));
  AddDetail( ({ "geraeuschkulisse" }),
    BS("Geschaeftiges Treiben herrscht hier in der Gasse."));
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse. ");
  AddSmell( ({ "strasse" }),
    "Hauptsaechlich riecht es nach Staub.");
  AddSmell( ({ "staub" }),
    BS("Der Staub kitzelt Dich in der Nase."));
  AddSmell( ({ "nase" }),
    BS("Deine Nase riecht nach Dir."));


  AddDetail( ({ "himmel", "wetter" }),  
    BS("Schoenes Wetter heute! Du erkennst einen tiefblauen Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
    "Kleine weisse Schaefchenwolken. ");
  AddDetail( ({ "stadtmauer", "mauer", "mauerwerk" }),
    "Der Wehrgang und die Stadtmauer sind oestlich von Dir. " );
  AddDetail( ({ "wehrgang", "gang" }),
    BS("Hier ist kein Aufgang zum Wehrgang. Eine patroullierende Wache "+
    "ist nicht zu sehen."));
  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt? ");
  AddDetail( ({ "strasse", "weg", "pflaster", "platz" }),
    "Der Platz ist mit groben Steinen gepflastert. ");
  AddDetail( ({ "burg" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg. ");
  AddDetail( ({ "friedheim" }),
    "Du befindest Dich im Dorf zu Friedheim. ");
  AddDetail( ({ "dorf", "stadt" }),
    BS("Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. "));
  AddDetail( ({ "steine" }),
    BS("Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche. "));
  AddDetail( ({ "gasse" }),
    BS("Geschaeftiges Treiben herrscht hier in der Gasse."));
  AddDetail( ({ "asphalt", "gummi" }),
    BS("Das ist noch nicht erfunden."));
  AddDetail( ({ "aufgang" }),
    BS("Auch hier ist kein Aufgang zum Wehrgang."));
  AddDetail( ({ "boden", "untergrund" }),
    BS("Einfache Steine bilden den Untergrund."));
  AddDetail( ({ "steine" }),
    BS("An den Steinen ist nicht besonderes zu erkennen."));
  AddDetail( ({ "dorfbewohnern", "dorfbewohner", "haendler", "handwerker", "handwerkern" }),
    BS("Die Dorfbewohner gehen ihrer Arbeit nach."));
  AddDetail( ({ "arbeit", "treiben" }),
    BS("Du solltest den Dorfbewohnern lieber nicht nachspionieren."));
  AddDetail( ({ "innenseite", "baumeister" }),
    BS("Das Mauerwerk der Stadtmauer ist hier sehr massiv und wurde wohl von einem "+
    "faehigen Baumeister erstellt."));
  AddDetail( ({ "kutsche", "transport" }),
    BS("Die Kutsche hat ihre Haltestelle auf dem Dorfplatz direkt vor der Kapelle."));
  AddDetail( ({ "schlossbediensteten", "schlossbedienstete", "bedienstete" }),
    BS("Die meissten Schlossbediensteten haben hier ihre Haeuser."));
  AddDetail( ({ "geruch" }),
    BS("Riechen klappt da besser."));
  AddDetail( ({ "haeuser" }),
    BS("Die Haeuser stehen hier dicht aneinander."));
  AddDetail( ({ "bauern" }),
    BS("Auch Bauern wohnen in diesem Dorf."));
  AddDetail( ({ "gruppe" }),
    BS("Mehr als zwei."));
  AddDetail( ({ "stueck" }),
    BS("Eben nicht alles, nur ein Stueck."));
	
	/*
  AddDetail( ({ "" }),
    BS(""));
*/

}


