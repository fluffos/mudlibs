#include "../def.h"

inherit WIESE+"fallobstwiese_raw.lpc";

#include <properties.h>
#include <language.h>

int anz_obst, anz_obst_hoch;

void reset()
{
	if( anz_obst < 4 ) anz_obst++;
  if( anz_obst_hoch < 6 ) anz_obst_hoch++;
	::reset();
}

void create() 
{
  ::create();
  anz_obst = 4;
  anz_obst_hoch =6;
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
    BS("Ein Kirschbaum steht hier."));
  
  AddDetail( ({"kirschbaum"}),
    BS("Der Kirschbaum hat viele reife Kirschen die man pfluecken kann. "+
    "Etwas hoeher am Baum haengen noch weitere Kirschen ausserhalb der Reichweite deiner Arme. " ) );
  AddDetail( ({ "arme" }),
    BS("Zum Glueck hast Du welche."));
  AddDetail( ({ "glueck" }),
    BS("Ist es Dir heute hold?"));
  AddDetail( ({ "reichweite" }),
    BS("Mit einem Obstpfluecker kann man die Reichweite erhoehen. "));
  AddDetail( ({ "obstpfluecker" }),
    BS("Vielleicht hat ja Erna Kollwanst noch einen. "));
  
  AddSpecialDetail( ({"kirsche", "kirschen" }), "unt_obst");
  
  AddCmd( ({"pflueck", "pfluecke"}), "pflueck_obst");
  
  AddExit( "nordosten", WIESE + "fallobstwiese_b4.lpc" );
 
}


int pflueck_obst(string str)
{
	object ob;
	string was, womit;
        notify_fail("Was willst Du pfluecken? \n");
        if( !str ) return 0;
	if( sscanf(str, "%s mit %s", was, womit) != 2) 
		{
		  notify_fail("Was willst Du pfluecken? \n");
	    if( str!="obst" && str!="kirsche" && str!="kirschen" ) return 0;
	    notify_fail("Es gibt gerade keine reifen Kirschen in Reichweite. \n");
	    if( anz_obst == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_kirschen.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst eine handvoll roter Kirschen. \n");
      say(TPN + " pflueckt eine handvoll roter Kirschen. \n");
      anz_obst--;
      return 1;
    }
	else
		{
		  notify_fail("Was willst Du pfluecken? \n");
	    if( was!="obst" && was!="kirsche" && was!="kirschen" ) return 0;
	    notify_fail("Damit kannst Du keine Kirschen pfluecken. \n");	
	    if( womit!="obstpfluecker" && womit!="pfluecker" ) return 0;
	    notify_fail("Das hast Du nicht bei Dir. \n");
	    if( !present("/nobstpfluecker", TP) ) return 0;
		  notify_fail("Es gibt gerade keine reifen Kirschen in erweiterter Reichweite. \n");    	
	    if( anz_obst_hoch == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_kirschen.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst mit dem Obstpfluecker eine handvoll roter Kirsche. \n");
      say(TPN + " pflueckt mit einem Obstpfluecker eine handvoll roter Kirsche. \n");
      anz_obst_hoch--;
      return 1;	
	  }
}

string unt_obst(string str)
{
	if(anz_obst == 0) return "Es sind keine Kirschen in Reichweite zum Pfluecken. \n";
	if(anz_obst == 1) return "Es ist noch eine handvoll Kirsche in Reichweite zum Pfluecken. \n";
	return "Es sind noch "+anz_obst+" handvoll Kirschen in Reichweite zum Pfluecken. \n";
}
