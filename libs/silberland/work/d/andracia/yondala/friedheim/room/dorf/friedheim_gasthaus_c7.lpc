// 27.02.2019 Yondala@SilberLand: Sehr viel mehr Details, ein paar mehr RoomMessages und diese differenzieren nun zwischen hoeren und sehen.

inherit "std/pub.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>



create()
{
  ::create(); //Aktivieren
  SetProp( P_LIGHT, 1);     //entweder 1 wenn Licht an ist oder 0 wenn aus
  SetProp( P_INDOORS, 1);   //hier 1 wenn es in einem haus bzw hoehle ist 0 wenn draussen
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Gasthaus zum goldenen Schwan" ); 
  SetProp( P_INT_LONG,  
  BS("Dies ist das Gasthaus zum goldenen Schwan. Hier kann man gepflegt speisen und schlemmen. "+
  "Die Getraenke sind auch erlesen und die Gaeste wirken vornehm und wohlhabend. "));
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Gumblad Korber");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Gumblad Korber");
  SetProp( P_PUBKEEPER_GENDER, MALE);

   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
    "Die Decke besteht aus edlen Holzpaneelen, in der Mitte der Decke befindet sich ein kleiner Kronleuchter. \n");
   AddDetail( ({ "holzpaneele" }),
    BS("Die Holzpaneele an der Decke sind sauber gearbeitet und aus gutem Holz."));
  AddDetail( ({ "kronleuchter","leuchter" }),
    BS("Der Kronleuchter sieht huebsch aus, aber nicht zu pompoes fuer diesen Ort. Viele weisse Kerzen tauchen diesen Raum in angenehmes Licht."));
  AddDetail( ({ "kerzen" }),
    BS("Keine der vielen weissen Kerzen ist ganz herunter gebrannt. Hier scheint man wirklich auf jedes Detail zu achten."));
  AddDetail( ({ "detail" }),
    BS("So wie Du. Bravo."));
 AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzdielen. Frisch gefegt scheint es hier ausserdem zu sein, denn es liegt nirgendwo Schmutz herum.");
  AddDetail( ({ "holzdielen" }),
    BS("Schoen gearbeitete, glatte Holzdielen. "));
  AddDetail( ({ "schmutz" }),
    BS("Der wurde vermutlich kuerzlich erst beseitigt."));
	
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind tatsaechlich etwas spartanisch. An einer Wand ist die Tuer, durch die Du gekommen bist, sowie zwei Fenster. Drei "
	"weitere Fenster sind an der angrenzenden Wand, gegenueber haengt ein grosser Wandteppich und an der vierten Wand ist die Schwingtuer, "
	"die wohl in den Kuechenbereich fuehren wird.");
  AddDetail( ({ "tuer" }),
    BS("Durch die Tuer bist Du herein gekommen. Sie steht offen und Du kannst die Strasse dadurch sehen."));
  AddDetail( ({ "strasse" }),
    BS("Die Strasse ist draussen. Geh doch hinaus, um sie naeher zu untersuchen."));
  AddDetail( ({ "fenster" }),
    BS("Du siehst fuenf Fenster. Sie bestehen alle aus Buntglas, sodass Du nicht durchsehen kannst. Dennoch faellt etwas Licht herein. Die "
	"Fenster sind sauber und wirken teuer."));
  AddDetail( ({ "buntglas", "glas" }),
    BS("Das Buntglas war bestimmt teuer und wurde sorgfaeltig hergestellt. Es sind keine Einschluesse zu sehen. Die verschiedenen Farben "
	"ergeben bunte Muster."));
  AddDetail( ({ "farben" }),
    BS("Du siehst rotes, gelbes, gruenes, braunes, blaues, orangenes, lilanes und turkises Glas."));
  AddDetail( ({ "muster" }),
    BS("Bunte Muster erstrecken sich auf den Fenstern."));
  AddDetail( ({ "schwingtuer" }),
    BS("Die Schwingtuer kann in beide Richtungen schwingen, so kann der Wirt hindurchgehen, wenn er die Haende voll hat."));
  AddDetail( ({ "richtungen","richtung" }),
    BS("Vor und zurueck."));
  AddDetail( ({ "haende" }),
    BS("Wenn die Gaeste viel bestellen, koennen die Haende des Wirts schon mal voll werden."));
  AddDetail( ({ "gaeste", "gast" }),
    BS("Hier befinden sich mehrere Gaeste. Sie alle sehen recht vornehm aus. Wenn Du etwas bestellst, gehoerst Du automatisch dazu."));
  AddDetail( ({ "kuechenbereich" }),
    BS("Du vermutest, dass der Kuechenbereich hinter der Schwingtuer ist, sehen kannst Du ihn aber nicht."));
  AddDetail( ({ "wandteppich" }),
    BS("Der Wandteppich ist auf feiner Wolle sorgsam geknuepft. Er stellt eine Szene aus dem Leben eines Bauern dar."));
  AddDetail( ({ "szene" }),
    BS("Ein Bauer steht mit seinen Knechten auf dem Feld und bringt die Ernte ein."));
  AddDetail( ({ "knecht", "knechte" }),
    BS("Die Knechte in der Szene auf dem Wandteppich sehen eher aermlich aus."));
  AddDetail( ({ "bauer" }),
    BS("Seltsam, dass hier ein Bauer dargestellt wird, wo doch vermutlich noch nie ein Bauer hier gespeist hat."));
  AddDetail( ({ "feld", "ernte" }),
    BS("Das Feld in der Szene auf dem Wandteppich ist zur Haelfte abgeerntet."));
  AddDetail( ({ "haelfte" }),
    BS("Halb da, halb weg."));
  AddDetail( ({ "leben" }),
    BS("Sieht so aus, als wuerden die Gaeste es unterhaltsam finden, das Leben eines Bauern auf diese Weise zu betrachten."));
  AddDetail( ({ "weise" }),
    BS("Es auf andere Weise zu betrachten waere ja auch etwas anstrengend, nicht wahr? Und so schmutzig."));
  AddDetail( ({ "wolle" }),
    BS("Der Wandteppich ist aus feinster Wolle geknuepft."));
  AddDetail( ({ "mitte" }),
    BS("Von jeder Wand gleichweit entfernt."));
  AddDetail( ({ "licht" }),
    BS("Das Licht kommt hauptsaechlich von den Kerzen an der Decke, aber auch durch die Fenster kommt ein bisschen davon herein."));
  AddDetail( ({ "" }),
    BS(""));
  AddDetail( ({ "" }),
    BS(""));

	
	
  AddSound( DEFAULT_SOUND,
    "Es ist hier vornehm ruhig. Die Gespraeche finden gedaempft statt und nur hin und wieder hoerst Du das leise Klirren von Geschirr und Besteck.");
  AddSound( ({ "gespraeche" }),
    BS("Sie sind zu leise, um sie zu verstehen. Und noch angestrenter zu lauschen waere echt unhoeflich."));
  AddSound( ({ "noch angestrenter","angestrengter" }),
    BS("Du bist wirklich unhoeflich. Die anderen Gaeste gucken Dich unerfreut an."));
  AddSound( ({ "klirren", "besteck","geschirr" }),
    BS("Wenn Geschirr auf Geschirr, Geschirr auf Besteck, oder Besteck auf Besteck stossen, gibt es ein leises Klirren. Das kommt vor. Sogar hier."));
  AddSound( ({ "scherz" }),
    BS("Der ist schon vorbei, Du hast ihn verpasst. Aber so witzig war er nicht, wirklich. Das Fraeulein will nur hoeflich sein."));



  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm dezent nach Holz und warmen Speisen.");
   AddSmell( ({ "holz" }),
    BS("Das Holz riecht angenehm harzig."));

  AddSmell( ({ "speisen" }),
    BS("Die Speisen der anderen Gaeste riechen lecker. Vielleicht solltest Du auch etwas bestellen?"));

	
  /* extra Details */
  AddDetail( ({ "holz" }),
    BS("Der wichtigste Baustoff ueberhaupt. Hier wurde allerdings nur sehr hochwertiges Holz verbaut."));
  AddDetail( ({ "essen", "trinken", "speisen", "schlemmen" }),
    BS("Frag doch einfach mit 'menue' was Wirt Gumblad Korber Dir anbieten kann. "));
  AddDetail( ({ "gesindel", "diebe", "mordbuben", "trunkenbolde" }),
    BS("Diebe, Mordbuben, Trunkenbolde und sind das Gesindel das man in dieser Umgebung nur selten sieht - zum Glueck!"));
  AddDetail( ({ "gasthaus", "schwan", "ort","raum" }),
    BS("Dies ist das Gasthaus zum goldenen Schwan. Du kannst den Wirt Gumblad Korber nach seinen Angeboten "+
    "fragen indem Du 'menue' tippst." ));
  AddDetail( ({ "angebot", "angebote", "angeboten", "verfuegung", "getraenke" }),
    BS("Lass Dir einfach das Menue zeigen, das ist das Angebot das Dir hier zur Verfuegung steht."));
  AddDetail( ({ "baustoff" }),
    BS("Holz ist der meistverwendetste Baustoff in Andracia."));
  AddDetail( ({ "andracia" }),
    BS("So wird diese Welt genannt."));
  AddDetail( ({ "umgebung" }),
    BS("Hier im Gasthaus kann man nur wenig von der Umgebung erkennen. Geh lieber nach draussen um Dich "+
    "dort umzusehen."));
  AddDetail( ({ "wirt", "gumblad", "korber" }),
    BS("Der Wirt dieses Gasthauses ist Gumblad Korber. Frag ihn einfach nach seinem Menue."));
  AddDetail( ({ "glueck" }),
    BS("Entwender man hat es, oder man hat es nicht."));
  AddDetail( ({ "menue" }),
    BS("Es gibt Bier, Jasmintee und Schnaps zu trinken und Brot, Schnitzel und Braten zu essen."));
  AddDetail( ({ "welt" }),
    BS("Diese Welt wird Andracia genannt."));
  AddDetail( ({ "bier" }),
    BS("Kuehles sueffiges Nass."));
  AddDetail( ({ "nass" }),
    BS("Bier eben."));
  AddDetail( ({ "jasmintee", "tee" }),
    BS("Beruhigend und mit einem ansprechenden Aroma."));
  AddDetail( ({ "aroma" }),
    BS("Der hier angebotene Tee verstroemt ein intensives Aroma."));
  AddDetail( ({ "schnaps" }),
    BS("Ein hoellisches Zeug."));
  AddDetail( ({ "zeug" }),
    BS("Schon mal den Schnaps probiert?"));
  AddDetail( ({ "brot", "schnitzel", "braten" }),
    BS("Bestell das doch einfach."));
  AddDetail( ({ "fraeulein" }),
    BS("Das eine oder andere Fraeulein ist zu Gast in diesem Gasthaus. Allerdings nur in Begleitung."));
  AddDetail( ({ "begleitung" }),
    BS("Ohne Begleitung ist es fuer ein vornehmes Fraeulein viel zu gefaehrlich auf der Strasse."));
  AddDetail( ({ "serviette" }),
    BS("huiuiui, ganz schoen edel. Du benutzt fuer sowas ja gerne Deine Aermel."));
  AddDetail( ({ "aermel" }),
    BS("So sehen die dann auch meistens aus."));
  AddDetail( ({ "scherz" }),
    BS("Scherze kann man nicht sehen."));


/*
  AddDetail( ({ "" }),
    BS(""));
*/  
  
  /*Menu*/
  AddDrink("Bier", "bier", 52, 12, 2, 6,
         ({ "Du trinkst Dein Bier in einem Zug aus.",
            "&& leert in einem Zug ein Bierglas." }) );
  AddDrink("Jasmintee", ({"tee", "jasmintee"}) , 50, ({2,18}), 0, 5,
         ({ "Du trinkst mit Genuss Deinen Tee.",
            "&& laesst sich einen Tee schmecken." }) );    
  AddDrink("Schnaps", "schnaps" , 95, ({30,10}), 5, 3,
         ({ "Du kippst Dir Deinen Schnaps in den Hals.",
            "&& kippt sich einen Schnaps in den Hals." }) );    
  AddFood("Schnitzel", "schnitzel", 140, 35, 16, "eat_schnitzel" );
       //  ({ "Du kaust auf dem zaehen Schnitzel herum.",
       //     "&& kaut auf einem zaehen Schnitzel herum." }) );
  AddFood("Brot", "brot", 45, 15, 5,
         ({ "Du isst ein Brot.",
            "&& isst ein Brot." }) );
  AddFood("Braten", "braten", 110, 30, "eat_braten" );
       //  ({ "Ein leckerer Braten wird von Dir verputzt.",
       //     "&& verputzt einen leckeren Braten." }) );
  
  AddRoomMessage( ({ "Ein Gast bestellt ein Bier.\n",
                     ({ "Ein Haendler laesst sich geraeuschvoll einen Braten schmecken.\n", MSGFLAG_SOUND }),
					 ({ "Du beobachtest wie jemand ein Schnitzel verputzt.\n", MSGFLAG_VISUAL }),   
                     ({ "An einem der Tische prosten sich zwei Haendler zu.\n", MSGFLAG_VISUAL }),
					 ({ "Jemand bestellt einen Schnaps.\n", MSGFLAG_VISUAL }),
					 ({ "Ein paar Gaeste bezahlen Ihre Rechung und gehen.\n", MSGFLAG_VISUAL }),
					 ({ "Ein edles Fraeulein kichert leise ueber einen Scherz ihres Begleiters.\n", MSGFLAG_SOUND }),
					 ({ "Irgendwo klirrt Geschirr.\n", MSGFLAG_SOUND }),
					 ({ "Ein Glas wird etwas zu laut abgestellt.\n", MSGFLAG_SOUND }),
					 ({ "Jemand raeuspert sich leise.\n", MSGFLAG_SOUND }),
					 ({ "Ein Gast fragt nach einer Serviette.\n", MSGFLAG_VISUAL }) }),100 );

     
  /*Ausgaenge*/
  AddExit( "westen", DORF + "friedheim_dorf_b7.lpc" );
  // EXITS END
   
  /*Objekte und NPCs*/
  AddItem( NPC + "gumblad_korber.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );
}

void eat_schnitzel(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    esser->AddPoison(1); //Vergiftung
    esser->eat_food(-34,0); //nimmt das Essen fast komplett wieder raus
    tell_object(esser, 
      BS("Das Schnitzel kommt und Du isst einen kleinen Bissen davon, merkst aber dass Dir das nicht bekommt.") );
    tell_room(this_object(),
      esser->name(WER)+" isst nur ein kleines Stueck Schnitzel.",({ esser }) );       
  }
  else
  {
    esser->AddMp(35);
    esser->AddHp(35);   
    tell_object( esser, BS(
      "Du verschlingst das saftige Schnitzel.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verschlingt ein saftiges Schnitzel."),({ esser }) );
  }
}

void eat_braten(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    //esser->AddPoison(1); //keine Vergiftung
    esser->eat_food(-30,0); //nimmt das Essen komplett wieder raus
    tell_object(esser, 
      BS("Beim Anblick des Bratens wendet sich Dein Magen. Das willst Du nicht essen.") );
    tell_room(this_object(),
      esser->name(WER)+" isst seinen Braten nicht.",({ esser }) );       
  }
  else
  {
    esser->AddMp(35);
    esser->AddHp(35);   
    tell_object( esser, BS(
      "Ein leckerer Braten wird von Dir verputzt.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verputzt einen leckeren Braten."),({ esser }) );
  }
}
