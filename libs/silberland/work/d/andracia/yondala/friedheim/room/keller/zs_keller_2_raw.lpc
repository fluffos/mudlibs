#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_SHORT , "Keller von Friedheim" );
  SetProp( P_INT_LONG , "Keller von Friedheim" );
  
  AddDetail( ({ "boden" }),
    BS("Hier bildet der blanke, behauene Fels den Boden. "));
  AddDetail( ({ "decke" }),
    BS("Die steinerne Decke besteht auf grossen Steinplatten, die den in den Fels "+
    "gehauenen Gang abdecken. "));    

  AddSound( DEFAULT_SOUND,
    BS("Du vernimmst das leise Wimmern der hier unten eingesperrten Delinquenten. "));  
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier sehr muffig. "));  
  
  AddDetail( ({ "keller", "etage" }),
    BS("Du befindest dich im Keller der Burg. Die Kerkerzellen sind im Sueden."));
  AddDetail( ({ "friedheim", "burg" }),
    BS("Du befindest dich im Keller der Burg. "));
  AddDetail( ({ "gang", "osten", "westen" }),
    BS("Der Gang erstreckt sich von Westen nach Osten. Im Sueden befinden sich die "+
    "Kerkerzellen. "));
  AddDetail( ({ "kerker", "kerkerzelle", "zelle", "kerkerzellen", "sueden" }),
    BS("Die Kerkerzellen befinden sich suedlich dieses Ganges. Die Tueren sind alle "+
    "offen, schliesslich sind die Delinquenten alle fest angekettet."));
  AddDetail( ({ "diebe", "moerder", "delinquenten" }),
    BS("Wenn der Freiherr waehrend seiner Rechtsprechung den Schuldigen zum Kerker "+
    "verurteilt, so landet dieser hier und wird in den Kerkerzellen festgekettet."));

  AddDetail( ({ "fels" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. "));
  AddDetail( ({ "steinplatten", "steinplatte" }),
    BS("Steinplatten, die den Gang abdecken, bilden die Decke. "));
  AddDetail( ({ "halterung" }),
    BS("In diese Halterung passt hervorragend eine Fackel, um bestaendig den Gang "+
    "zu erhellen. Du kannst ja versuchen die Fackel heraus zu ziehen - sofern eine "+
    "Fackel vorhanden ist. "));
  AddDetail( ({ "freiherr", "burgherr" }),
    BS("Der Freiherr ist gerade nicht anwesend. Versuchs doch mal in seinem "+
    "Arbeitszimmer in der 2ten Etage."));
  AddDetail( ({ "rechtsprechung", "recht" }),
    BS("Der Freiherr ist hier dafuer zustaendig Recht zu sprechen. "));
  AddDetail( ({ "tueren", "tuer" }),
    BS("Die Tueren zu den Kerkerzellen sind offen."));
  AddDetail( ({ "kette", "ketten", "fessel", "fesseln" }),
    BS("Geh doch in eine der Kerkerzellen, um die Fesseln der Delinquenten zu untersuchen. "));
  AddDetail( ({ "arbeitszimmer" }),
    BS("Das Arbeitszimmer des Freiherrn befindet sich in der 2ten Etage. "));
  AddSound( ({ "wimmern" }),
    BS("Das leise Wimmern der hier angeketteten Delinquenten ist zu hoeren. "));  

}