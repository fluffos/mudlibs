// 28.02.2019 Yondala@SilberLand: Laden erstmal rausgenommen, unwichtig und nicht schoen

inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

reset() {
  ::reset();
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Geschaeft von Rauert Arres" ); 
  SetProp( P_INT_LONG,  BS("Dies ist das Geschaeft von Rauert Arres. Vollgepackte Regale "+
  "mit allerlei Krimskrams aber auch Dinge die jeder Haushalt braucht. Auch eine kleine "+
  "Ecke mit Waffen und Ruestungen kann man hier finden. "));
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "Rauert Arres");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( DORF+"zs_haendler_storage_e5.lpc");

   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
    "Die Decke ist aus Holz. \n");
  AddDetail( ({ "boden" }),
    "Holzbohlen bilden den Boden. \n");
  AddDetail( ({ "waende", "wand" }),
    "Du kannst nichts besonderes an den Waenden erkennen. \n");

  AddSound( DEFAULT_SOUND,
  "Du kannst nichts besonderes hoeren. \n");
  AddSmell( DEFAULT_SMELL,
  "Du riechst nichts besonderes hier. \n");
   
  /* extra Details */
  AddDetail( ({ "holz", "baustoff" }),
    BS("Der wichtigste Baustoff ueberhaupt. "));
  AddDetail( ({ "geschaeft", "laden" }),
    BS("Dies ist das Geschaeft von Rauert Arres. Er verkauft hier allerlei Waren. "+
    "Mit 'zeige' kannst Du Dir von ihm sein Sortiment anzeigen lassen. "));
  AddDetail( ({ "regale" }),
    BS("Auf den Regalen liegen die Waren die Rauert hier verkauft. "));
  AddDetail( ({ "krimskrams", "dinge", "sortiment", "waren" }),
    BS("Mit 'zeige' kannst Du Dir von Rauert Arres sein Sortiment anzeigen lassen."));
  AddDetail( ({ "haushalt" }),
    BS("Im Haushalt braucht man viele Dinge. Das meisste davon kann man hier in diesem "+
    "Laden bekommen. "));
  AddDetail( ({ "ecke" }),
    BS("In der Ecke hier liegen auch ein paar Waffen und Ruestungen die ein Abenteurer "+
    "auf seinen Reisen gut gebrauchen kann. "));
  AddDetail( ({ "waffen", "ruestungen" }),
    BS("Mit 'zeige waffen' kannst Du Dir von Rauert Arres sein Sortiment von Waffen anzeigen lassen. "+
    "Dasselbe geht auch mit Ruestungen, zum Beispiel 'zeige armschienen'. " ));
  AddDetail( ({ "rauert", "arres", "haendler" }),
    BS("Der Haendler scheint gerade nicht anwesend zu sein."));
  AddDetail( ({ "beispiel" }),
    BS("Ein anderes Beispiel waere 'zeige helme'."));
  AddDetail( ({ "reisen", "kutsche" }),
    BS("Man kann mit der Kutsche reisen oder aber zu Fuss die Welt erkunden."));
  AddDetail( ({ "fuss" }),
    BS("Damit stehst Du fest auf dem Boden."));
  AddDetail( ({ "welt", "andracia" }),
    BS("Dies ist die Welt Andracia."));
  AddDetail( ({ "abenteurer" }),
    BS("Du selbst bist doch einer, oder?"));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  
  /*Ausgaenge*/
  AddExit( "westen", DORF + "friedheim_dorf_d5.lpc" );
   
  /*Objekte und NPCs*/
  // AddItem( "file", refresh, Props);
  AddItem( NPC + "rauert_arres.lpc", REFRESH_DESTRUCT );
   
}

