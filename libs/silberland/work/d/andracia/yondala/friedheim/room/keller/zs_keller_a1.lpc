#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT , "Keller von Friedheim" );
  SetProp( P_INT_LONG ,
    BS("Du befindest Dich im Keller der Burg von Friedheim. Ein "+
    "Gang fuehrt ab hier gen Sueden und ein Durchgang im Osten fuehrt in einen "+
    "weiteren, spaerlich beleuchteten Raum. Eine schmale Treppe fuehrt hier "+
    "hinauf in die Burgkueche. " ));

  AddDetail( ({ "boden" }),
    BS("Hier bildet der blanke, behauene Fels den Boden. "));
  AddDetail( ({ "decke" }),
    BS("Die steinerne Decke besteht aus grossen Steinplatten, die den, in den Fels "+
    "gehauenen Raum abdecken. "));    
  AddDetail( ({ "wand", "waende" }),
    BS("Bis Huefthoehe bestehen die Waende aus behauenen Fels, darueber beginnt "+
    "das massive Mauerwerk der Burg."));
  AddSound( DEFAULT_SOUND,
    BS("Das Klappern der Pfannen und Toepfe dringt von oben herunter."));  
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts Besonderes riechen. "));  
  
  AddDetail( ({ "burg", "friedheim" }),
    BS("Du befindest Dich im Keller der Burg Friedheim. "));
  AddDetail( ({ "burgkoechin", "koechin" }),
    BS("Die Burgkoechin ist meistens in der Kueche zu finden. "));
  AddDetail( ({ "kueche", "burgkueche" }),
    BS("Eine Etage ueber Dir ist die Kueche zu finden. "));
  AddDetail( ({ "keller", "raum", "etage" }),
    BS("Du befindest dich im Keller der Burg von Friedheim. Ein "+
    "Gang fuehrt ab hier gen Sueden und ein Durchgang im Osten fuehrt in einen "+
    "weiteren spaerlich beleuchteten Raum. Eine schmale Treppe fuehrt hier "+
    "hinauf in die Burgkueche. "));
  AddDetail( ({ "durchgang", "osten" }),
    BS("Ein einfacher Durchgang fuehrt nach Osten in den naechsten Raum."));
  AddDetail( ({ "treppe" }),
    BS("Die Treppe fuehrt hoch in die Kueche."));
  AddDetail( ({ "gang", "sueden" }),
    BS("Der Gang im Sueden fuehrt wohl zu den Kerkern. "));
  AddDetail( ({ "fels" }),
    BS("Eine haelfte des Raums wurde direkt in den Fels gehauen. Es ist ganz normaler "+
    "Fels, wie man ihn hier ueberall finden kann."));
  AddDetail( ({ "mauerwerk", "mauer" }),
    BS("Es besteht aus normalen Steinen. "));
   AddDetail( ({ "kerker", "kerkern" }),
    BS("Diese befinden sich im Sueden."));
  AddSound( ({ "klappern", "pfannen", "toepfe" }),
    BS("Die Burgkoechin scheint gerade etwas zu kochen."));  
  AddDetail( ({ "huefthoehe", "hoehe", "huefte" }),
    BS("Das ist bei jedem anders. Hier wird der von der Hoehe einer menschlichen Huefte ausgegangen. "));
  AddDetail( ({ "steine", "steinplatten" }),
    BS("Die Steinplatten bilden hier die Decke. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/ 
  AddExit( "oben", BURG + "zs_burg_eg_a2.lpc" );
  AddExit( "sueden", KELLER + "zs_keller_a2.lpc" );
  AddExit( "osten", KELLER + "zs_keller_b1.lpc" );
  
}