#include "../def.h"

inherit KELLER+"zs_keller_3_raw.lpc";

#include <properties.h>
#include <language.h>

int fackel_da, neu_fackel, platte;

void reset()
{
  ::reset();
  if(fackel_da == 0) neu_fackel--;
  if(neu_fackel == 0) {
    fackel_da = 1; 
    neu_fackel = 8;
    SetProp( P_INT_LONG ,
      BS("Du stehst in einer der Kerkerzellen von Friedheim. Die Tuer zurueck "+
      "auf den Gang ist offen. Eine Fackel an der Wand erhellt den Raum. "));
    set_light(1);
    AddDetail( ({ "wand", "waende" }),
      BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Fackel steckt hier "+
      "in einer Halterung und erhellt den Raum. Metallene Oesen sind in der Wand "+
      "eingelassen. Deliquenten koennen daran festgekettet werden. "));
    }
  AddDetail( ({ "steinplatte" }),
    BS("Die Steinplatte verdeckt scheinbar ein Loch nur unvollstaendig. Das Geraeusch "+
    "fallender Tropfen dringt von unten herauf. Vielleicht kann man die Steinplatte "+
    "wegschieben um hinunterzuklettern. "));
  RemoveCmd( ({ "klettere", "kletter" }) );
  platte = 0;
}

void create() 
{
  ::create();
  fackel_da = 1;  neu_fackel = 8;
  platte = 0;
  SetProp( P_INT_LONG ,
    BS("Du stehst in einer der Kerkerzellen von Friedheim. Die Tuer zurueck "+
    "auf den Gang ist offen. Eine Fackel an der Wand erhellt den Raum. "));

  AddDetail( ({ "boden" }),
    BS("Unrat und Felsen bilden den Boden des Kerkers. Eine grosse Steinplatte faellt "+
    "Dir auf."));
  AddDetail( ({ "wand", "waende" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Fackel steckt hier "+
    "in einer Halterung und erhellt den Raum. Metallene Oesen sind in der Wand "+
    "eingelassen. Deliquenten koennen daran festgekettet werden. "));
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst leise das Tropfen von Wasser. "));  
  
  AddSpecialDetail( ({ "licht", "fackel" }), "unt_licht");
  AddSpecialDetail( ({ "loch" }), "unt_loch" );
  AddSound( ({ "tropfen", "geraeusch" }),
    BS("Es scheint als wuerde das Geraeusch von unten kommen."));
  
  AddSpecialDetail( ({ "steinplatte" }), "unt_platte");

  AddCmd( ({ "schiebe", "schieb" }), "schieb_platte" );
  AddCmd( ({ "ziehe", "zieh" }), "zieh_fackel" );

  AddExit( "norden", KELLER + "zs_keller_c2.lpc" );
}
string unt_licht()
{
	if( fackel_da == 0)
		return "Es ist keine Fackel da. \n";  
	return "Eine Fackel steckt in der Halterung und erleuchtet den Raum. \n";
}		

string unt_platte()
{
	if(platte == 0) 
		return BS("Die Steinplatte verdeckt scheinbar ein Loch nur unvollstaendig. Das Geraeusch "+
    "fallender Tropfen dringt von unten herauf. Vielleicht kann man die Steinplatte "+
    "wegschieben um hinunterzuklettern. ");
  else 
  	return BS("Die Steinplatte wurde zurseite geschoben. Das Geraeusch "+
    "fallender Tropfen dringt von unten herauf. ");
}
    
string unt_loch()
{
	if(platte == 0) return "Das Loch ist von einer Steinplatte fast vollstaendig verdeckt. \n";
  else return "Durch das Loch kann man hinunter klettern. \n";
}

int zieh_fackel(string str)
{ 
  object ob;
  notify_fail("Was willst Du herausziehen? \n");
  if( str != "fackel heraus" && str != "fackel raus" ) return 0;
  notify_fail("Es ist keine Fackel da zum herausziehen. \n");
  if( fackel_da == 0 ) return 0;
  SUID;
  ob = clone_object("/obj/fackel.lpc");
  ob->move(TP, M_GET);
  //  ob->SetProp( P_FUEL, 1000); // Fackel ist gebraucht
  //ob->SetProp( P_LIGHTED, 1); 
  ob->SetProp( P_LIGHT, 1); // Fackel ist angezuendet und hell
  ob->_set_lighted(1);
  set_light(-1) ; // Raum wird dunkel
  write("Du ziehst die Fackel aus der Halterung. \n");
  say(TPN + " zieht die Fackel aus der Halterung. \n");
  SetProp( P_INT_LONG ,
    BS("Du stehst in einem schmalen Gang der sich weiter nach Osten erstreckt. "+
    "Im Sueden sind die Kerker, in denen die gefassten Diebe und Moerder "+
    "verschimmeln sollen. "));
  AddDetail( ({ "wand", "waende" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. Eine Halterung fuer "+
    "eine Fackel ist hier angebracht. "));
  fackel_da = 0;
  return 1;
}

int schieb_platte(string str)
{
  notify_fail("Was willst Du wegschieben? \n");
  if( str != "platte weg" && str != "steinplatte weg" && 
  	  str != "platte zur seite"&& str != "steinplatte zur seite" &&
  	  str != "platte beiseite"&& str != "steinplatte beiseite" ) return 0;
  notify_fail("Die Steinplatte ist doch schon weggeschoben! \n");
  if( platte == 1 ) return 0; 
  platte = 1;
  AddCmd( ({ "klettere", "kletter" }), "kletter_runter" );
  write( "Du schiebst die Steinplatte zur Seite. Nun kannst Du runterklettern. \n");
  say( TPN + " schiebt die Steinplatte zur Seite. \n");
  AddDetail( ({ "steinplatte" }),
    BS("Die Steinplatte wurde zur Seite geschoben. Man kann nun hinunterklettern. \n"));
  return 1;
}

int kletter_runter(string str)
{
  notify_fail("Wohin willst Du klettern? \n");
  if( str != "runter" && str != "hinunter" && str != "nach unten") return 0;
  TP->move(KELLER+"zs_sublevel1_a2.lpc", M_GO, "nach unten", "klettert", "klettert herab");
  return 1;
}