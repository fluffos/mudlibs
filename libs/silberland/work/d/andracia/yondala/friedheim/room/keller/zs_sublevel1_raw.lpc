#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT, "Hoehle unter Burg Friedheim");
  SetProp( P_INT_LONG, 
  BS("Du befindest Dich in einer Hoehle unter Burg Friedheim. "+
  "Das Ungeziefer, das den Keller hin und wieder heimsucht, stammt aus "+
  "dieser Hoehle. Es ist eine natuerlich entstandene Tropfsteinhoehle, "+
  "und nur das platschende Geraeusch von herabfallenden Wassertropfen "+
  "unterbricht die beklemmende, kalte Stille, die hier herrscht." ));

  AddDetail( ({ "boden" }),
  BS("Der Boden besteht aus Kalksteinschichten die ueber die Jahrhunderte hinweg "+
  "die darunterliegenden normalen Steine ueberzogen hat und nun eine, wegen der "+
  "Feuchtigkeit eine sehr schluepfrige, mit unregelmaessigen Erhebungen versehene "+
  "Oberflaeche bildet. Oft wird dieser unbequeme Untergrund unterbrochen durch "+
  "die nach oben zeigenden Stalagmiten. "));
  AddDetail( ({ "decke", "hoehe" }),
  BS("Die Decke ist uebersaeht mit kleinen und grossen Stalaktiten aus Kalkstein. "+
  "Hin und wieder faellt von den Spitzen dieser Gebilde ein Tropfen Wasser herab. "+
  "Man muss aufpassen, dass man sich nicht den Kopf stoesst, an den etwas groesseren "+
  "Exemplaren. "));  
  AddDetail( ({ "waende", "wand", "kalkgestein" }),
  BS("Die Waende sind fast ueberall mit glatten Kalksteinschichten ueberzogen. "+
  "Nur vereinzelt kann man Teile des urspruenglichen Felsgesteins erkennen. "));  
  AddDetail( ({ "hoehle", "tropfsteinhoehle", "raum" }),
  BS("Du befindest Dich in einer Hoehle unter Burg Friedheim. "+
  "Es ist eine natuerlich entstandene Tropfsteinhoehle, Stalagmiten und "+
  "Stalaktiten sind hier ueber die Jahrhunderte hinweg gewachsen. "+
  "Der feuchte Kalkstein ist hier ueberall. "));
  AddDetail( ({ "burg", "friedheim" }),
  BS("Die Burg Friedheim befindet sich direkt ueber Dir. Hoffentlich findest "+
  "Du auch wieder hinaus aus dieser Hoehle. "));
  AddDetail( ({ "keller", "ausgang", "zugang" }),
  BS("Der Zugang zu dieser Hoehle ist im Keller der Burg Friedheim. Ein anderer "+
  "Ausgang aus dieser Tropfsteinhoehle ist nicht bekannt."));
  AddDetail( ({ "ungeziefer", "asseln", "kaefer", "spinnen", "maeuse", "ratten", "quelle" }),
  BS("Asseln, Kaefer, Spinnen, Maeuse und sogar Ratten suchen hin und wieder den "+
  "Keller der Burg heim. Diese Hoehle hier ist die Quelle dieser Plagen. "));
  AddDetail( ({ "luft" }),
  BS("Kalt und feucht ist die Luft hier in der Hoehle. Ganz typisch fuer eine "+
  "Tropfsteinhoehle. "));
  AddDetail( ({ "tropfen", "wassertropfen", "wasser", "feuchtigkeit" }),
  BS("Du hast einen herabfallenden Wassertropfen mit Deiner Hand aufgefangen. Du "+
  "leckst das Wasser mit Deiner Zunge auf und stellst fest dass es besonders klar ist "+
  "aber auch sehr nach Kalk schmeckt. "));
  AddDetail( ({ "stille" }),
  BS("Man sollte eher der Stille lauschen als sie zu untersuchen. "));
  AddDetail( ({ "kalksteinschichten", "schichten", "kalkstein", "kalk", "kalkschicht", "schicht", "ueberzug" }),
  BS("Der Kalkstein wurde ueber Jahrhunderte hinweg in Schichten ueber die Felsen "+
  "angelagert. Heute bildet diese Schicht einen dicken Ueberzug auf fast allen "+
  "Steinen. Durch die Feuchtigkeit wird diese Schicht besonders schluepfrig. "));
  AddDetail( ({ "jahrhunderte" }),
  BS("Solange willst Du bestimmt nicht untersuchen. "));
  AddDetail( ({ "steine", "gestein", "felsgestein", "stellen", "teile", "fels" }),
  BS("Das urspruengliche Felsgestein, die diese Hoehle bildete, kann man nur noch "+
  "an ein paar kalkfreien Stellen an der Wand sehen."));
  AddDetail( ({ "kaelte" }),
  BS("Die Waerme der Sonne dringt nicht bis hierher. Es ist kalt, feucht und dunkel "+
  "hier unten. "));
  AddDetail( ({ "erhebungen", "oberflaeche", "untergrund", "felsgesteins", "felsen" }),
  BS("Der Boden ist zwar von einer allesbedeckenden Kalkschicht ueberzogen, doch "+
  "der zerklueftete Untergrund des urspuenglichen Felsgesteins bildet sich noch "+
  "heute als unregelmaessige Erhebungen ab. "));
  AddDetail( ({ "stalagmit", "stalagmiten" }),
  BS("Die Gebilde aus Kalkgestein, die ueber Jahrhunderte vom Boden aus in die Hoehe "+
  "gewachsen sind, nennt man Stalagmiten. "));
  AddDetail( ({ "stalaktit", "stalaktiten" }),
  BS("Die Gebilde aus Kalkgestein, die ueber Jahrhunderte von der Decke aus anwachsen, nennt man Stalaktiten. "));
  AddDetail( ({ "spitzen", "gebilde", "exemplare", "tropfstein", "tropfsteine", "formen" }),
  BS("Das Wasser und der Kalk haben hier unwarscheinlich eindrucksvolle Gebilde "+
  "erschaffen. Stalagmiten und Stalaktiten in den verschiedensten Formen praegen "+
  "diese Hoehle. "));
  AddDetail( ({ "plagen", "plage" }),
  BS("Das Ungeziefer das hier haust ist die Plage derer man sich annehmen soll. "));
  AddDetail( ({ "hand", "zunge", "handbreite", "hunger", "koerper", "kopf" }),
  BS("Du kennst Deinen eigenen Koerper, sowas musst Du nicht untersuchen. "));
  AddDetail( ({ "waerme", "sonne", "strahlen" }),
  BS("An der Oberflaeche kann die Sonne mit ihren Strahlen Waerme spenden. Bis "+
  "hier herunter in die Hoehle dringt sie nicht. "));
  AddDetail( ({ "fuesse" }),
  BS("Du kannst mit deinen Fuessen herumlaufen..."));

  AddSound( DEFAULT_SOUND,
  BS("Du hoerst hin und wieder das platschende Geraeusch von herabfallenden "+
  "Wassertropfen. "));  
  AddSound( ({ "platschen", "tropfen", "geraeusch", "wassertropfen" }),
  BS("Immer wenn ein Tropfen herabfaellt und auf den Boden trifft, entsteht dieses "+
  "Geraeusch. Ueberall in dieser Hoehle kann man das vernehmen. "));  
  AddSound( ({ "stille" }),
  BS("Neben dem platschen der Wassertropfen ist noch das leise trippeln der Fuesse "+
  "der Ungeziefer zu vernehmen. Eine Richtung kannst Du aber nicht bestimmen. "));

  AddSmell( DEFAULT_SMELL,
  BS("Du riechst die saubere, feuchte Luft, die typisch fuer Tropfsteinhoehlen "+
  "ist. "));  
  AddSmell( ({ "feuchtigkeit", "luft", "tropfsteinhoehle", "hoehle", "kalk", "wasser" }),
  BS("Es herrscht hier der typisch feuchtkalte Geruch nach Kalk und Wasser. "));  
  AddSmell( ({ "geruch" }),
  BS("Kalte, klamme Luft herrscht hier unten."));

/*
  AddDetail( ({ "" }),
  BS(""));
*/
}