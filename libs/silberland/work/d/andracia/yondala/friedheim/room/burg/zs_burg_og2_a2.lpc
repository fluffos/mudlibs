//23.2.2019 Yondala@SilberLand Portal nach Lunia ist eingebaut

#include "../def.h"

#include <properties.h>
#include <moving.h>

inherit "std/room";

//********************************************************************
//Fuer das Portal


int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_friedheim_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  /*if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN))*/
	if(testobgemacht(TPN))
    result += "Ein gemauertes Portal.\n";
  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein gemauertes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  /*if(call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN))*/

  return result;

}


//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er nach Aboriville teleportiert
int betreten(string str)
{
/*if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) return 0;*/
if(!testobgemacht(TPN))	return 0;			
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das gemauerte Portal.\n");
  say(TPN+" betritt das gemauerte Portal.\n");
  TP->SetProp(P_PARALYZED, 0);
  TP->move( "/d/andracia/yondala/wolken/lunia/room/portalraum_friedheim.lpc", M_NOCHECK);
  call_other("/d/andracia/yondala/wolken/lunia/room/portalraum_friedheim", "wirbeltext", TP, 0, 1);
  
  return 1;
}

//Details fuer das Portal
string erlaubtenamen()
{
  string alle;
  if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";
  alle=	"Auf den Saeulen wurden folgende Namen eingepraegt:\n"+ read_file("/d/andracia/yondala/wolken/lunia/portale/portal_friedheim_zugang.lpc");
	return alle;
}

string det_portal()
{
if(!testobgemacht(TPN))
				return "Sowas siehst Du da nicht!\n";
				
return break_string("Das Portal wurde fachgerecht aus Bruchsteinen und Moertel gemauert. Es besteht aus einem steinernen "+
	"Bogen, der auf zwei Saeulen ruht. Ob man es betreten kann?\n"); 
} 

string det_bogen()
{
if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "In den Bogen wurde das Wort \"Friedheim\" gepraegt.\n"; 
} 
string det_saeulen()
{
 /* if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) */
if(!testobgemacht(TPN))
	return "Sowas siehst Du da nicht!\n";

return "In die Saeulen wurden Namen gedruckt.\n"; 
} 
string det_fried()
{
if(!testobgemacht(TPN)) return "Sowas siehst Du da nicht!\n";

return "Was mag das nur bedeuten?\n"; 
} 

void create() 
{
  ::create();
//*************************************************************************
//Portal

  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "friedheim" }),"det_fried");
  AddSpecialDetail( ({ "saeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );

  //***********************************************************************


  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Gemach der Burgherrin ");
  SetProp (P_INT_LONG,
    BS("Dies ist das Gemach der Burgherrin. Dieser Raum scheint der gemuetlichste in "+
    "der ganzen Burg zu sein. Man erkennt die Hand einer Frau an der Einrichtung. Ein Himmelbett und mehrere Schraenke "+
    "stehen hier. Eine Frisierkommode mit grossem Spiegel steht an der Ostwand. "));

  AddDetail( ({ "decke" }),
    BS("Die Decke wurde mit Stoff abgehaengt, daher das gemuetliche Ambiente. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende sind mit Bildern und Wandteppichen geschmueckt. Sehr gemuetlich hier."));
  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus Holz. Mehrere fein geknuepfte Teppiche liegen hier aus und"+
    "das Gehen ist besonders angenehm dadurch."));

  AddDetail( ({ "gemach", "raum", "heimstatt" }),
    BS("Dies ist das Gemach der Burgherrin. Es scheint der gemuetlichste Raum der ganzen "+
    "Burg zu sein. Teppiche liegen am Boden und das Bett und die Frisierkommode zeugen davon, "+
    "dass dieser Raum die Heimstatt von ehrbaren Frauenzimmern ist."));
  AddDetail( ({ "himmelbett", "bett" }),
    BS("Das Himmelbett ist ein Prachtstueck der Handwerkskunst. Die gedrechselten "+
    "Bettpfosten tragen einen hoelzern umrandeten Stoffhimmel ueber dem Bett. "+
    "Der Bettkasten besteht aus schoenem Holz mit Intarsienarbeiten. Bettdecke und "+
    "Kissen scheinen mit Federn gefuellt zu sein. Ein Bett wie fuer einen Koenig. "));
  AddDetail( ({ "schraenke", "schrank" }),
    BS("Die Schraenke werden wohl die Kleider der Herrschaften beinhalten. "+
    "Dort wird es nichts Interessantes zu finden geben. "));
  AddDetail( ({ "frisierkommode", "kommode" }),
    BS("Die Frisierkommode ist voll mit Puderchen, Flakons, Buersten und anderem "+
    "Zeug, das eine Frau von Adel benoetigt, um sich frisch zu machen. In einem grossen "+
    "Spiegel darueber kann sich die Dame dann davon ueberzeugen, dass ihr Makeup gelungen ist."));
  AddDetail( ({ "spiegel" }),
    BS("Ein sehr guter Spiegel, fest mit der Kommode verbunden. "));
  AddDetail( ({ "stoff" }),
    BS("Der Stoff, der die Decke verdeckt, haengt zu hoch um ihn zu untersuchen. "));
  AddDetail( ({ "ambiente", "eindruecke" }),
    BS("Alle Eindruecke eines Raumes zusammen nennt man Ambiente. "));
  AddDetail( ({ "bilder", "bild", "landschaften", "stilleben" }),
    BS("Die Bilder an den Waenden zeigen Landschaften und Stilleben. "+
    "Sehr schoen - das macht den Raum sehr gemuetlich. " ));
  AddDetail( ({ "wandteppich", "wandteppiche" }),
    BS("Die Wandteppiche zeigen schoene Muster und lassen die steinernen Waende "+
    "nicht so trostlos erscheinen. "));
  AddDetail( ({ "holz" }),
    BS("Am Holz ist nichts besonderes zu erkennen."));
  AddDetail( ({ "teppich", "teppiche", "muster" }),
    BS("Die Teppiche am Boden haben schoene, bunte Muster. Das Gehen darauf "+
    "ist sehr angenehm. "));
  AddDetail( ({ "frauenzimmer" }),
    BS("Die Burgherrin und ihre Tochter sind damit gemeint."));
  AddDetail( ({ "kunstwerk", "handwerkskunst", "feingeist", "prachtstueck" }),
    BS("Teppiche und Bilder sind schoen anzusehen und zeugen von handwerklichem Geschick, wie auch von kuenstlerischem "+
    "Feingeist. Auch die Intarsien des Himmelbetts sind unverkennbar eine Meisterarbeit." ));
  AddDetail( ({ "bettpfosten" }),
    BS("Die gedrechselte Bettpfosten tragen den Bettkasten und reichen bis hinauf zum hoelzern umrahmten "+
    "Stoffhimmel. "));
  AddDetail( ({ "stoffhimmel", "staub" }),
    BS("Der Stoffhimmel ueber dem Bett haelt Staub und andere Dinge davon ab dem Schlafenden ins Gesicht zu fallen. "));
  AddDetail( ({ "bettkasten" }),
    BS("Der Bettkasten hat schoene Intarsienarbeiten. "));
  AddDetail( ({ "intarsienarbeiten", "intarsien", "meisterarbeit" }),
    BS("Die Intarsien des Bettkastens sind meisterhaft geaerbeitet und die Muster sind schoen anzuschauen."));
  AddDetail( ({ "bettdecke", "kissen" }),
    BS("Bettdecke und Kissen sehen so weich aus - sie sind es auch. Warscheinlich mit Federn gefuellt. "));
  AddDetail( ({ "koenig" }),
    BS("Das Himmelbett ist eines Koenigs wuerdig. "));
  AddDetail( ({ "puder", "flakons", "buerste", "zeug", "buersten", "dinge", "puderchen" }),
    BS("Das benoetigt die Burgherrin. "));
  AddDetail( ({ "friedheim", "burg" }),
    BS("Dies ist die Burg Friedheim. Der Freiherr von Friedheim herrscht hier. "));
  AddDetail( ({ "adel", "herrschaften", "adelsfamilie" }),
    BS("Hier sind die Raeume des Adels. Benimm Dich hier!"));
  AddDetail( ({ "raeume", "gemaecher", "stockwerk" }),
    BS("Auf diesem Stockwerk befinden sich die Gemaecher der Adelsfamilie derer von Friedheim. "));
  AddDetail( ({ "burgherrin", "dame", "frau" }),
    BS("Die Burgherrin ist Dorlen von Friedheim. "));
  AddDetail( ({ "einrichtung", "moebel" }),
    BS("Ein Himmelbett und mehrere Schraenke stehen hier. Eine Frisierkommode mit grossem Spiegel steht an der Ostwand."));
  AddDetail( ({ "ostwand", }),
    BS("Eine Frisierkommode mit grossem Spiegel steht hier."));
  AddDetail( ({ "tochter" }),
    BS("Lara von Friedheim ist die Tochter des Hauses."));
  AddDetail( ({ "federn" }),
    BS("Bettdecke und Kissen sind so weich - die muessen wohl mit Federn gefuellt sein."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddExit ("osten", BURG "zs_burg_og2_b2");

  AddItem( NPC + "dorlen_friedheim.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "lara_friedheim.lpc", REFRESH_DESTRUCT ); 
  AddItem( NPC + "jette_linneweber.lpc", REFRESH_DESTRUCT ); 
}
