inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0); 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HILL, ENV_TEMPERATURE:20]));
  SetProp( P_INT_SHORT, "Auf dem Weg zur Burg" ); 
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich auf dem Weg vom Dorf zur Burg Friedheim. Der Weg fuehrt "+
    "vom Westeingang des Dorfs die kleine Anhoehe hinauf und endet direkt an der "+
    "Zugbruecke der Burg. " ));
    
  AddDetail( ({ "himmel", "wetter" }), BS(
    "Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar "+
    "kleine Gutwetterwolken zeigen sich. " ));
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur die Voegel zwitschern. \n" );
  AddSound( ({ "zwitschern", "voegel" }),
    "Vertraeumt lauscht Du dem zwitschern der Voegel \n" );
  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen. \n" );
   
  AddDetail( ({ "strasse", "weg", "pflaster", "boden", "westeingang", "zugbruecke" }), BS(
    "Der Weg ist mit groben Steinen gepflastert. Er fuehrt "+
    "vom Westeingang des Dorfs die kleine Anhoehe hinauf und endet direkt an der "+
    "Zugbruecke der Burg. " ));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", 
  	            "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
    "Kleine weiße Schaefchenwolken. \n" );
  AddDetail( ({ "anhoehe", "huegel" }),
    "Auf dem grossen Huegel hier steht die Burg Friedheim."  );
  AddDetail( ({ "burg", "friedheim" }), BS(
    "Eine maechtige Burg. Sie thront ueber das umliegende Huegelland auf einer "+
    "Anhoehe." ));
  AddDetail( ({ "dorf", "stadt", "gruppe", "haeuser", "stadtmauer" }),
    "Das Dorf ist nur eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. " );
  AddDetail( ({ "steine" }),
    "Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche. \n" );
  AddDetail( ({"huegelland"}), BS(
    "Grasbewachsene Huegel erstrecken sich im Sueden bis zum Waldrand." ));
  AddDetail( ({"transport", "kutsche", "haltestelle"}), BS(
    "Die Kutsche hat ihre Haltestelle im Dorf." ));
  AddDetail( ({"huegel", "gelaende"}), BS(
    "Leicht welliges Gelaende." ));
  AddDetail( ({"waldrand", "wald"}), BS(
    "Dazu musst Du schon naeher am Wald dran sein." ));

/*
  AddDetail( ({""}), BS(
    "" ));
*/
}