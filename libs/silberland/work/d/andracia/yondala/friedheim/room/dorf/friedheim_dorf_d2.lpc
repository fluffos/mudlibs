#include "../def.h"
#include <properties.h>
#include <language.h>

inherit DORF + "friedheim_dorf_std.lpc";


create() {
  ::create();

  SetProp( P_INT_SHORT, "Dorf Friedheim" );
  SetProp( P_INT_LONG,
    BS("Die kleine Strasse fuehrt entlang der Innenseite der Stadtmauer. "+
    "Hier stehen Haeuser von reichen Bauern und Handwerkern. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

/*  AddSound( DEFAULT_SOUND,
    BS("Eine umfangreiche Geraeuschkulisse von Haendlern und Dorfbewohnern. "));
  AddSound( ({"geraeuschkulisse", "geraeusche"}),
    BS("Viele verschiedenste Geraeusche."));
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse. \n");
  AddSmell( ({ "strasse", "geruch" }),
    "Hauptsaechlich riecht es nach Staub.");
  AddSmell( ({"asphalt", "gummi"}),
    BS("Da es das hier nicht gibt, kann es hier auch nicht danach riechen."));

  AddDetail( ({ "himmel", "wetter" }),  
    BS("Schoenes Wetter heute! Du erkennst einen tiefblauen Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
    "Kleine weisse Schaefchenwolken. \n");
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Der Wehrgang und die Stadtmauer sind oestlich von Dir. \n" );
  AddDetail( ({ "wehrgang", "gang" }),
    BS("Hier ist kein Aufgang zum Wehrgang. Eine patroullierende Wache "+
    "ist nicht zu sehen."));
  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt? \n");
  AddDetail( ({ "strasse", "weg", "pflaster", "platz", "boden" }),
    "Die Strasse ist mit groben Steinen gepflastert.");
  AddDetail( ({ "burg" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg. \n");
  AddDetail( ({ "friedheim" }),
    "Du befindest Dich im Dorf zu Friedheim. \n");
  AddDetail( ({ "dorf", "stadt" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. \n");
  AddDetail( ({ "haeuser", "haus" }),
    BS("Die Haeuser die hier stehen sind  gut gepflegt und teilweise sehr prunkvoll. "+
    "Sie gehoeren reichen Baueren und Handwerkern. "));
  AddDetail( ({ "handwerker", "bauer", "handwerkern", "bauern" }),
    BS("Wenn kein Handwerker und kein Bauer hier auf der Strasse steht musst Du wohl in "+
    "eins der Haeuser einbrechen um sojemanden zu untersuchen. "));
  AddDetail( ({ "innenseite", "mauerwerk" }),
    BS("Massives Mauerwerk. Nur grosse Kriegsmaschinerie kann diese Mauer zum einbrechen bringen. "));  
  AddDetail( ({ "steine" }),
    BS("Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche. "));
  AddDetail( ({"asphalt", "gummi"}),
    BS("Gibt es hier nicht."));
  AddDetail( ({"aufgang"}),
    BS("Es ist hier kein Aufgang zum Wehrgang zu sehen."));
  AddDetail( ({"dorfbewohner", "dorfbewohnern"}),
    BS("Auf dem Dorfplatz sind bestimmt mehr Dorfbewohner als hier."));
  AddDetail( ({"transport", "kutsche", "dorfplatz", "haltestelle"}),
    BS("Auf dem Dorfplatz ist eine Haltestelle fuer die Kutsche."));
  AddDetail( ({"kriegsmaschinerie"}),
    BS("Belagerungstuerme, Ballistae, Rammboecke und Katapulte sind solche Kriegsmaschinerie."));
  AddDetail( ({"belagerungstuerme", "ballistae", "Rammboecke", "katapulte"}),
    BS("Das ist Kriegsmaschinerie das bei Belagerungen verwendet wird. Aber das siehst Du hier nicht."));
  AddDetail( ({"belagerungen"}),
    BS("Hier ist alles friedlich. "));
  AddDetail( ({"haendlern", "haendler"}),
    BS("Am Dorfplatz sind die Haendler zu finden."));
*/
/*
  AddDetail( ({""}),
    BS(""));
*/  
  AddExit( "norden", DORF + "friedheim_dorf_d1.lpc" );
  AddExit( "sueden", DORF + "friedheim_dorf_d3.lpc" );
  // EXITS END
  
  AddItem( "/d/andracia/yondala/wasser/pirateninsel/npc/jonathan.lpc", REFRESH_DESTRUCT);
}


