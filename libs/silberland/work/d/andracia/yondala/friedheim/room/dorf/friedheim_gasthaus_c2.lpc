// 27.02.2019 Yondala@SilberLand: Sehr viel mehr Details. Licht ausgemacht


inherit "std/pub.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>



create()
{
  ::create(); //Aktivieren
  SetProp( P_LIGHT, 0);     //entweder 1 wenn Licht an ist oder 0 wenn aus
  SetProp( P_INDOORS, 1);   //hier 1 wenn es in einem haus bzw hoehle ist 0 wenn draussen
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Gasthaus zum rostigen Nagel" ); 
  SetProp( P_INT_LONG,  
   BS("Dies ist das Gasthaus zum rostigen Nagel. Eine schaebige Einrichtung und das Gesindel, das hier herumlaeuft, "+
   "laesst erahnen, dass dies kein gutes Gasthaus ist. Man kann hier zwar was essen und trinken, muss aber auch "+
   "damit rechnen, dass man in eine Schlaegerei verwickelt wird. "));
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Radulf Buchweiz");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Radulf Buchweiz");
  SetProp( P_PUBKEEPER_GENDER, MALE);

   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
    "Die Decke ist aus Holz. ");
  AddDetail( ({ "boden" }),
    "Holzbohlen bilden den Boden. ");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind schmutzig, die Fenster so dreckig, dass kein Licht herein dringt. ");
  AddDetail( ({ "licht" }),
    BS("Wer hier Licht sucht, muss es mitbringen. Wer das Licht scheut, ist hier genau richtig."));
  AddDetail( ({ "holzbohlen", "bohlen" }),
    BS("Die Holzbohlen sind schmutzig und schmierig. Es liegt Stroh und Dreck darauf."));
  AddDetail( ({ "stroh" }),
    BS("Du denkst   . o O (Warum liegt denn hier Stroh rum?)"));
  AddDetail( ({ "fenster" }),
    BS("Genaugenommen siehst Du keine Fenster. Nur die schmutzigen Umrisse."));
  AddDetail( ({ "umrisse" }),
    BS("anhand der Umrisse kannst Du ueberhaupt erst festellen, dass Fenster in den Waenden sind."));
  AddDetail( ({ "" }),
    BS(""));

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Gegroehle von Betrunkenen. Hin und wieder piepst irgendwo etwas, ausserdem hoerst Du ein lautes, penetrantes Saegen. ");
  AddSound( ({ "gegroehle", "betrunkene" }),
    BS("Unartikuliere Laute, aber die Stimmung scheint friedlich zu sein."));
  AddSound( ({ "stimmung" }),
    BS("Eher froehliches Gegroehle als Staenkereien."));
  AddSound( ({ "staenkereien" }),
    BS("Der ein oder andere Gast staenkert schon mal, aber grundsaetlich geht es hier gerade friedlich zu."));
  AddSound( ({ "gast" }),
    BS("Liebevoll legst Du Dein Ohr an den naechsten Gast. Er schaut Dich fragend an. Du ziehst Dich zurueck."));
  AddSound( ({ "laute" }),
    BS("Du kannst nichts verstehen."));
  AddSound( ({ "piepsen","pieps" }),
    BS("Ob es hier Maeuse gibt?"));
  AddSound( ({ "maeuse" }),
    BS("Zumindest wuerde Dich das nicht ueberraschen, so wie es hier aussieht."));
  AddSound( ({ "saegen" }),
    BS("Saegen? Nein, Du hoerst genau hin und bist ueberzeugt, dass es eher ein Schnarchen ist."));
  AddSound( ({ "schnarchen" }),
    BS("Tatsaechlich, da drueben in der Ecke ist doch tatsaechlich jemand eingepennt."));
  AddSound( ({ "ecke" }),
    BS("Aus einer Ecke ertoent lautes Schnarchen."));
  AddSound( ({ "ohr", "ohren", "rauschen" }),
    BS("In Deinen Ohren rauscht es."));
  AddSound( ({ "" }),
    BS(""));
	
	
	
	
	
	
	
	
	
	
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach abgestandenem Bier und ungewaschenen Koerpern.");
   AddSmell( ({ "bier" }),
    BS("Du kannst vermutlich eines bestellen. Aber so toll riecht es nicht."));
   AddSmell( ({ "koerper" }),
    BS("Die meisten Gaeste scheinen sich eher selten zu waschen. Es riecht nach Schweiss und Ausscheidungen."));
   AddSmell( ({ "schweiss" }),
    BS("Ein sehr strenger Geruch. Scheint aber teilweise auch von Dir selbst zu kommen."));
   AddSmell( ({ "ausscheidungen" }),
    BS("Du schnueffelst echt an allem, oder?"));
   AddSmell( ({ "gaeste" }),
    BS("Du schnupperst an einem der Gaeste. Es scheint ihm zu gefallen, er laechelt Dich an."));
   AddSmell( ({ "geruch" }),
    BS("Der Geruch ist streng."));
   AddSmell( ({ "" }),
    BS(""));
   
  /* extra Details */
  AddDetail( ({ "holz" }),
    BS("Das Holz ist schmierig und russig. "));
  AddDetail( ({ "russ" }),
    BS("Der Russ zeugt davon, dass hier schon oft Fackeln angezuendet wurden."));
	
  AddDetail( ({ "fackel","fackeln" }),
    BS("Fackeln spenden Licht. Und das ist hier auch dringend noetig."));
	
  AddDetail( ({ "einrichtung", "umgebung" }),
    BS("Die einfache Einrichtung wurde wohl erst kuerzlich erneuert. Es hat hier nur einfache "+
    "Baenke und Tische auf denen man sein Mahl einnehmen kann. "));
  AddDetail( ({ "gesindel", "diebe", "mordbuben", "trunkenbolde" }),
    BS("Diebe, Mordbuben und Trunkenbolde sind das Gesindel das sich in dieser Umgebung heimisch fuehlt. "));
  AddDetail( ({ "gasthaus", "nagel" }),
    BS("Dies ist das Gasthaus zum rostigen Nagel. Du kannst den Wirt Radulf Buchweiz nach seinen Angeboten "+
    "fragen indem Du 'menue' tippst." ));
  AddDetail( ({ "essen", "trinken" }),
    BS("Frag doch einfach mit 'menue' was Wirt Radulf Buchweiz Dir anbieten kann. "));
  AddDetail( ({ "schlaegerei", "gange", "glueck" }),
    BS("Du hast Glueck - es scheint gerade keine Schlaegerei im Gange zu sein. "));
  AddDetail( ({ "angebote", "mahl" }),
    BS("Lass Dir doch das 'menue' zeigen."));
  AddDetail( ({ "baenke", "tische" }),
    BS("Einfache Baenke und Tische aus Holz."));
  AddDetail( ({ "wirt", "buchweiz", "radulf"}),
    BS("Der Wirt scheint gerade nicht da zu sein."));
  AddDetail( ({ "bauer", "bauern" }),
    BS("Unter den Gaesten sind mehrere Bauern."));
  AddDetail( ({ "" }),
    BS(""));
  AddDetail( ({ "" }),
    BS(""));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  // DETAILS END
  
  /*Menu*/
  AddDrink("Bier", "bier", 52, 12, 2, 6,
         ({ "Du trinkst Dein Bier in einem Zug aus.",
            "&& leert in einem Zug ein Bierglas." }) );
  AddDrink("Jasmintee", ({"tee", "jasmintee"}) , 50, ({2,18}), 0, 5,
         ({ "Du trinkst mit Genuss Deinen Tee.",
            "&& laesst sich einen Tee schmecken." }) );    
  AddDrink("Schnaps", "schnaps" , 95, ({30,10}), 5, 3,
         ({ "Du kippst Dir Deinen Schnaps in den Hals.",
            "&& kippt sich einen Schnaps in den Hals." }) );    
  AddFood("Schnitzel", "schnitzel", 140, 35, 16, "eat_schnitzel");
       //  ({ "Du kaust auf dem zaehen Schnitzel herum.",
       //     "&& kaut auf einem zaehen Schnitzel herum." }) );
  AddFood("Brot", "brot", 45, 15, 5,
         ({ "Du isst ein Brot.",
            "&& isst ein Brot." }) );

  AddRoomMessage( ({ "Ein Bauer bestellt sich ein Bier.\n",
                     "Der Gast neben Dir ruelpst laut.\n",
                     "Ein Gast verschuettet sein Bier.\n" }),
                     45 );
     
  /*Ausgaenge*/
  AddExit( "westen", DORF + "friedheim_dorf_b2.lpc" );
  // EXITS END
  
  /*Objekte und NPCs*/
  AddItem( NPC + "radulf_buchweiz.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );
}

void eat_schnitzel(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    esser->AddPoison(1); //Vergiftung
    esser->eat_food(-34,0); //nimmt das Essen fast komplett wieder raus
    tell_object(esser, 
      BS("Das Schnitzel kommt und Du isst einen kleinen Bissen davon, merkst aber dass Dir das nicht bekommt.") );
    tell_room(this_object(),
      esser->name(WER)+" isst nur ein kleines Stueck Schnitzel.",({ esser }) );       
  }
  else
  {
    esser->AddMp(35);
    esser->AddHp(35);   
    tell_object( esser, BS(
      "Du verschlingst das saftige Schnitzel.\n") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verschlingt ein saftiges Schnitzel.\n"),({ esser }) );
  }
}
