#include "../def.h"

inherit WEGE+"weg_zur_burg_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Gen Suedwesten fuehrt ein kleiner Pfad zu ein paar Baeumen." ));

  AddDetail( ({"pfad"}), BS(
    "Der grasbewachsene Pfad ist sehr unscheinbar und unterscheidet sich kaum von dem Gras "+
    "das hier im Huegelland waechst." ));
  AddDetail( ({"baeume", "fallobstwiese"}), BS(
    "Es scheint sich um eine Fallobstwiese dort im Suedwesten zu handeln."));  
  AddDetail( ({"gras"}), BS(
    "Saftig gruen."));  
  AddDetail( ({"huegelland"}), BS(
    "Du stehst mittendrin."));  

  AddExit( "nordwesten", WEGE + "weg_zur_burg_b3" );
  AddExit( "osten", WEGE + "weg_zur_burg_d4" );
  
  AddExit( "suedwesten", WIESE + "fallobstwiese_d1" );
  
}
