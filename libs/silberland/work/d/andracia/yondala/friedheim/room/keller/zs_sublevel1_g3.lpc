#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

int treasure_vorhanden;

void reset()
{
  if(!present("truhe") && treasure_vorhanden == 0) treasure_vorhanden = 1;
  ::reset();
}


void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp( P_INT_LONG ) +
    BS("Zwischen den Kalksteingebilden sind viele dunkle Bereiche die du nicht auf "
    "Anhieb einsehen kannst. "));

  AddDetail( ({ "anhieb" }),
  BS("Du musst schon besser hinschauen. "));
  AddDetail( ({ "kalksteingebilde", "gebilde" }),
  BS("Stalagmiten und Stalagtiten sind solche Gebilde."));

  AddExit( "norden", KELLER + "zs_sublevel1_g2.lpc" );
  AddExit( "suedwesten", KELLER + "zs_sublevel1_f4.lpc" );

  AddSpecialDetail( ({ "bereiche", "bereich", "dunkel" }), "unt_bereich" );
  
  AddCmd( ({ "ziehe", "zieh" }), "zieh_truhe" );
  
  AddItem( NPC + "kellermonster_ratte.lpc", REFRESH_DESTRUCT );


  treasure_vorhanden = 1;

}


string unt_bereich(string str)
{
  if(treasure_vorhanden == 0)
    return BS("Du leuchtest in die dunkle Bereiche und kannst nichts interessantes entdecken.");
  else 
    return BS("Du leuchtest in die dunkle Bereiche und siehst eine kleine Truhe die in einer "+
    "Spalte eingekeilt ist. Du kannst versuchen Sie herauszuziehen.");
}

int zieh_truhe(string str)
{
  notify_fail("Was willst Du herausziehen? \n");
  if(treasure_vorhanden != 1 || str != "truhe heraus") return 0;
  write("Du ziehst die Truhe aus der Spalte heraus. \n");
  say( TPN +" zieht eine Truhe aus einer Spalte hervor. \n");
  AddItem(OBJ + "truhe.lpc", REFRESH_NONE);
  treasure_vorhanden = 0;
  return 1;
}

