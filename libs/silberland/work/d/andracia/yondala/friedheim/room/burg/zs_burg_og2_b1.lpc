#include "../def.h"

#include <properties.h>
#include <moving.h>

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Arbeitszimmer");
  SetProp (P_INT_LONG,
    BS("Du befindest Dich im Arbeitszimmer des Burgherrn. Ein grosser "+
    "Schreibtisch dominiert den Raum. Davor stehen zwei einfache Stuehle "+
    "und dahinter ein ledergepolsterter Stuhl. An den Waenden sind mehrere "+
    "Regale und Vitrinen mit allerlei Schaetzen. "));
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "decke" }),
    BS("Die Decke wurde mit Stoff abgehaengt, daher das etwas gemuetlichere Ambiente. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende sind mit Regalen und Vitrinen vollgestellt."));
  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus Holz. Mehrere fein geknuepfte Teppiche liegen hier aus und"+
    "das Gehen ist besonders angenehm dadurch."));

  AddDetail( ({ "arbeitszimmer", "zimmer", "raum" }),
    BS("Dies ist das Arbeitszimmer von Edorian von Friedheim, dem Freiherrn von "+
    "Friedheim. " ));
  AddDetail( ({ "schreibtisch", "tisch", "meisterstueck", "tischplatte" }),
    BS("Ein massiver Schreibtisch mit kleinen gedrechselten Kugelfuessen. Die Tischplatte "+
    "und die Seiten sind mit Intarsien geschmueckt. Ein eindrucksvolles Moebelstueck. "));
  AddDetail( ({ "stuehle", "sitzgelegenheit" }),
    BS("Die zwei einfachen Stuehle vor dem Schreibtisch dienen warscheinlich den Gaesten "+
    "des Freiherrn als Sitzgelegenheit. Zum hinsitzen hast Du aber keine Zeit. "));
  AddDetail( ({ "stuhl" }),
    BS("Der ledergepolsterte Stuhl hinter dem Schreibtisch ist ein Meisterstueck an Moebel. "+
    "Der Freiherr nimmt wohl darauf Platz wenn er sich mit Gaesten bespricht." ));
  AddDetail( ({ "regale", "regal" }),
    BS("Auf den Regalen sind neben vielen Buechern auch besondere Steine und Artefakte zu sehen. "));
  AddDetail( ({ "vitrine", "vitrinen" }),
    BS("In den Vitrinen werden allerlei besondere Steine und Artefakte ausgestellt. "));
  AddDetail( ({ "schaetze", "schatz", "sammlung" }),
    BS("Die Steine und Artefakte auf Regalen und in Vitrinen haben alle eine besondere Form "+
    "oder weisen irgendeine andere Besonderheit auf. Sehr eindrucksvoll diese Sammlung. "));
  AddDetail( ({ "stoff" }),
    BS("Der Stoff der die Decke verdeckt haengt zu hoch um ihn zu untersuchen. "));
  AddDetail( ({ "ambiente", "eindruecke" }),
    BS("Alle Eindruecke eines Raumes zusammen nennt man Ambiente. "));
  AddDetail( ({ "holz" }),
    BS("Am Holz ist nichts besonderes zu erkennen"));
  AddDetail( ({ "teppich", "teppiche", "muster" }),
    BS("Die Teppiche am Boden haben schoene, bunte Muster. Das Gehen darauf "+
    "ist sehr angenehm. "));
  AddDetail( ({ "friedheim", "burg" }),
    BS("Dies ist die Burg Friedheim. Der Freiherr von Friedheimn herrscht hier. "));
  AddDetail( ({ "kugelfuesse", "fuesse" }),
    BS("Der Schreibtisch steht auf schoen gedrechselten Kugelfuessen aus Holz. "));
  AddDetail( ({ "gaeste", "bauern", "haendler" }),
    BS("Sehr oft kommen Bauern oder Haendler hier her um mit dem Freiherrn ihre Probleme zu besprechen. "));
  AddDetail( ({ "intarsienarbeiten", "intarsien" }),
    BS("Die Intarsien des Schreibtischs sind meisterhaft geaerbeitet und die Muster sind schoen anzuschauen."));
  AddDetail( ({ "buecher" }),
    BS("Viele verschiedene Buecher aber keins das deine Aufmerksamkeit erregen wuerde. "));
  AddDetail( ({ "steine" }),
    BS("Einige der Steine haben die Form von Krallen, andere die Form von Schnecken ... manche haben Runen. "));
  AddDetail( ({ "artefakte", "besonderheit", "form", "krallen", "schnecken", "runen", "dinge" }),
    BS("Vieles hast Du noch nie gesehen, aber die wirklich interessanten Dinge sind in den Vitrinen verschlossen. "));
  AddDetail( ({ "probleme" }),
    BS("Ich hab keine Zeit Deine eigenen Probleme zu untersuchen. Erledig das lieber selbst!"));
  AddDetail( ({ "aufmerksamkeit" }),
    BS("Du passt auf - das sollte reichen."));
  AddDetail( ({ "moebel", "moebelstueck" }),
    BS("Ein grosser Schreibtisch dominiert den Raum. Davor zwei einfache Stuehle "+
    "und dahinter ein ledergepolsterter Sessel. An den Waenden mehrere "+
    "Regale und Vitrinen mit allerlei Schaetzen. "));
  AddDetail( ({ "sessel" }),
    BS("Der Sessel sieht unglaublich wertvoll aus."));
  // DETAILS END
/*
  AddDetail( ({ "" }),
    BS(""));
*/
  // EXITS START
  AddExit ("sueden", BURG "zs_burg_og2_b2");
  // AddExit ("westen", BURG "zs_burg_og2_a1");
  // EXITS END

  // ITEMS START
  AddItem( NPC + "edorian_friedheim.lpc", REFRESH_DESTRUCT );
  // ITEMS END

}
