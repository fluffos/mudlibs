//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:22]));
  SetProp( P_INT_SHORT, "Schmiede zu Friedheim" ); 
  SetProp( P_INT_LONG, 
  BS("Du bist in der Schmiede zu Friedheim. Die Feuerstelle und der Amboss dienen dem Schmied zum "+
  "Reparieren von Waffen und Ruestungen. Ein Holzdach ueberspannt die Schmiede. "));
   
   
  /* Sounds und Smells */
  AddSound( DEFAULT_SOUND,
  "Arbeitsgeraeusche eines Schmiedes sind zu vernehmen. \n" );
  AddSmell( DEFAULT_SMELL,
  "Etwas Rauch der Feuerstelle haengt in der Luft. \n" );
  AddSmell( ({ "feuerstelle", "rauch" }),
  "Rauch eben. \n" );
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  "Das typisch metallisch klingenden Geraeusch wenn ein Hammer warmes Eisen auf dem Amboss trifft. \n" );
  
  /* Details */
  AddDetail( ({ "himmel", "wetter", "luft" }),  
  "Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. \n" );
  AddDetail( ({ "boden", "burghof", "hof" }),
  "Der Boden ist mit groben Steinen gepflastert. \n"  );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke" }),
  "Die steinernen Waende der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. \n" );
  AddDetail( ({ "witterung", "regen", "schnee" }),
  BS("Regen und Schnee nennt man auch Witterung. ") ); 
  AddDetail( ({"steinmetz", "steinmetzen", "handwerker"}),
  BS("Die Arbeit wurde schon lange erledigt. Die Handwerker sind nicht mehr da."));
  AddDetail( ({"burgwachen", "wachen"}),
  BS("Auf dem Wehrgang laufen sie."));
  AddDetail( ({"schritt"}),
  BS("Du kannst das Gebaeude ja abschreiten und nachmessen."));
  AddDetail( ({"innenseite", "innenseiten"}),
  BS("Das Dach der Schmiede wurde daran befestigt."));
  AddDetail( ({"ohr"}),
  BS("Normalerweise kannst Du damit hoeren."));
  AddDetail( ({"angriff", "belagerung", "feinde"}), 
  BS("Gerade sind keine Feinde dabei die Burg anzugreifen oder zu belagern."));
  AddDetail( ({ "friedheim", "burg" }),
  "Du stehst doch mitten auf dem Burghof der Burg zu Friedheim. \n" );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt solch ein wehrhaftes Gebaeude zu bauen. " ));
  AddDetail( ({ "innere" }),
  "Dazu musst Du den Bergfried erst betreten. \n" );
  AddDetail( ({ "bauwerk", "gebaeude" }),
  "Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. \n" );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weisse Schaefchenwolken. \n" );
  AddDetail( ({ "hoehe", "stockwerke" }),
  BS("Der Bergfried hat wohl 4 Stockwerke. Die oberste Kante ist mit Zinnen bewehrt. "));
  AddDetail( ({ "grundriss", "seite" }),
  "der Grundriss ist annaehernd quadratisch. Eine Seite misst so 50 Schritt. \n" );
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "wehrgang" }),
  "Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. \n" );
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "dach" }),
  "Dazu musst Du erst einmal aufs Dach um das zu tun. \n" );
  AddDetail( ({ "schmiede" }),
  "Du befindest Dich in ihr. \n" );
  AddDetail( ({ "amboss" }),
  BS("Auf diesem Amboss schmiedet der Schmied dieser Burg die Schwerter und Schilde fuer die Waffenkammer."));
  AddDetail( ({ "steine" }),
  BS("Nur einfache Steine. ") ); 
  AddDetail( ({ "holzdach", "dach", "decke" }),
  BS("Das an den Innenseiten der Burgmauer angebrachte Holzdach schuetzt die Schmiede vor Regen. ") ); 
  AddDetail( ({"holz"}),
  BS("Das Holz ist tadellos intakt."));  
  
  AddDetail( ({"burgmauer"}), 
  BS("Du kannst auf der Burgmauer einen Wehrgang erkennen. Mehrere Burgwachen laufen darauf entlang."));
  AddDetail( ({"aufgang"}), 
  BS("Es befindet sich hier kein Aufgang zum Wehrgang."));
  AddDetail( ({ "belagerung" }),
  BS("Es findet gerade keine statt. "));
  AddDetail( ({ "feuerstelle" }),
  BS("Eine wirklich grosse Feuerstelle befindet sich hier. Das zu schmiedende Metall wird darin erhitzt. ") ); 
  AddDetail( ({ "waffen", "ruestungen", "ausruestungsgegenstaende", "armbrueste" }),
  BS("Gerade sind keine Ausruestungsgegenstaende zur Reparatur. ") ); 
  AddDetail( ({"metall", "eisen"}),
  BS("Hier in der Schmiede befindet sich einiges an Eisen. Es werden vorallem Waffen daraus hergestellt."));
  AddDetail( ({"hammer", "werkzeug"}),
  BS("Hammer und anderes Werkzeug ist hier in der Schmiede zu finden. "));
  AddDetail( ({"schmied", "yantur", "leisten", "yantur leisten"}),
  BS("Yantur Leisten, der Schmied, scheint gerade nicht da zu sein."));
  AddDetail( ({"schilde", "schwerter", "reparatur"}),
  BS("Bei Yantur kann man alles reparieren lassen."));
  AddDetail( ({"waffenkammer"}),
  BS("Die Waffenkammer befindet sich bestimmt im Bergfried."));
  AddDetail( ({"regen", ""}),
  BS("Gluecklicherweise regnet es gerade nicht."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
   
  // Exits
  AddExit( "sueden", BURG + "zs_burg_eg_d2" );
  AddExit( "suedwesten", BURG + "zs_burg_eg_c2" );
  AddExit( "westen", BURG + "zs_burg_eg_c1" );
  
  // END EXITS
  AddItem( NPC + "yantur_leisten.lpc", REFRESH_DESTRUCT ); 
  AddItem(OBJ + "tafel_schmiede.lpc", REFRESH_NONE );
}
