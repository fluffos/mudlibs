//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/pub";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <pub.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Erdgeschoss des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  BS("Du befindest Dich in der Kueche des Bergfrieds zu Friedheim. "+
  "Eine grosse Anrichte ist in der Mitte des Raumes und in einem Gestell darauf haengen "+
  "allerlei Toepfe und Pfannen. An der Westwand sind mehrere grosse Kochstellen an denen "+
  "ohne Probleme ausreichend Gerichte fuer eine umfangreiche Festgesellschaft gekocht werden koennen. "+
  "An der Suedwand ist eine weitere Anrichte wobei an der Wand an hoelzernen Haken grosse Messer, "+
  "Reiben und anderes Handwerkszeug der Koeche haengt. In der Ostwand fuehrt ein Durchgang in die "+
  "Eingangshalle. Daneben ist ein Abgang in den Keller mit einem hoelzernen Gelaender abgegrenzt. "+
  "Durch eine Tuer in der Nordwand kann man in die Haupthalle schreiten. "));
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Erna Kollwanst");
  SetProp( P_PUBKEEPER_NAME, "die Burgkoechin Erna Kollwanst");
  SetProp( P_PUBKEEPER_GENDER, FEMALE);
 
  /* Sounds und Smells */
  AddSound( DEFAULT_SOUND,
  BS("Es sind keine besonderen Geraeusche zu hoeren. "));
  AddSound( ({ "geraeusche" }),
  BS("Es sind wirklich keine besonderen Geraeusche zu hoeren."));
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nichts besonderes riechen. "));
  
  
  /* extra Details */ 
  AddDetail( ({ "decke" }),  
  BS("Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. "));
  AddDetail( ({ "boden" }),
  BS("Der Boden besteht aus glatten Steinen und ist schoen sauber. "));
  AddDetail( ({ "waende" }),
  BS("Welche Wand willst Du untersuchen? Ost- West, Nord- oder Suedwand? "));
  AddDetail( ({ "nordwand" }),
  BS("Durch eine Tuer in der Nordwand kann man in die Haupthalle schreiten. Rechts und links der Tuer steht "+
  "jeweils ein grosser Schrank. "));
  AddDetail( ({ "ostwand" }),
  BS("In der Ostwand fuehrt ein Durchgang in die Eingangshalle. Daneben ist ein Abgang in "+
  "den Keller mit einem hoelzernen Gelaender abgegrenzt. "));
  AddDetail( ({ "suedwand" }),
  BS("An der Suedwand ist eine weitere Anrichte wobei an der Wand an hoelzernen Haken grosse Messer, "+
  "Reiben und anderes Handwerkszeug der Koeche haengt. "));
  AddDetail( ({ "westwand" }),
  BS("An der Westwand sind mehrere grosse Kochstellen an denen ohne Probleme ausreichend Gerichte "+
  "fuer eine umfangreiche Festgesellschaft gekocht werden koennen. "));
  AddDetail( ({ "erdgeschoss" }),  
  BS("Das Stockwerk das ebenerdig zum umliegenden Gelaende ist nennt man Erdgeschoss. "));
  AddDetail( ({ "stockwerk" }),  
  BS("Du befindest Dich im Erdgeschoss. "));
  AddDetail( ({ "bergfried", "friedheim", "burg", "burgfrieds", "burgfried", "bergfrieds" }),  
  BS("Du befindest Dich im Erdgeschoss des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "gelaende" }),  
  BS("Das Gelaende ausserhalb der Burg ist huegellig. "));
  AddDetail( ({ "steine", "stein" }),  
  BS("Die Steine die den Boden bilden sind zwar kein Marmor aber bilden trotzdem eine sehr glatte Oberflaeche. "));
  AddDetail( ({ "marmor", "verschwendung" }),  
  BS("Diese Kueche komplett mit Marmor auszulegen waere Verschwendung. "));
  AddDetail( ({ "oberflaeche" }),  
  BS("Schoen glatt! "));
  AddDetail( ({ "ecke" }),  
  BS("Die Ecken dieses Raumes sind uninteressant. "));
  AddDetail( ({ "kueche", "burgkueche", "raum", "raumes" }),  
  BS("Du stehst mitten in der Burgkueche. Hier werden bei einem Fest die Speisen zubereitet. "));
  AddDetail( ({ "anrichte", "holztisch", "steinplatte" }),  
  BS("Die Anrichte ist ein grosser Holztisch mit einer Steinplatte darauf. "));
  AddDetail( ({ "gestell" }),  
  BS("Ein hoelzernes Gestell ueber der Anrichte in der Mitte. Hier kann ein Koch schnell und bequem "+
  "sich den passenden Topf oder die passende Pfanne greifen. "));
  AddDetail( ({ "toepfe", "pfannen", "kupfer", "topf", "pfanne" }),  
  BS("Alle Toepfe und Pfannen sind aus Kupfer. "));
  AddDetail( ({ "kochstellen", "kochstelle" }),  
  BS("Diese Kochstellen werden mit Holz angefeuert. Direkt neben jeder Kochstelle ist ein grosser Stapel "+
  "mit Holzscheiten aufgeschichten. "));
  AddDetail( ({ "holz", "stapel", "scheite", "holzscheite", "holzstapel" }),  
  BS("Das liegt bereit zu verfeuern wenn hier gekocht wird. "));
  AddDetail( ({ "gerichte", "gericht", "speise", "speisen" }),  
  BS("Bestimmt laesst sich der Freiherr bei einem Fest nur die feinsten Speisen zubereiten. "+
  "Vielleicht wirst Du ja mal eingeladen wenn der Burgherr Dich fuer wuerdig empfindet. "));
  AddDetail( ({ "probleme", "problem" }),  
  BS("Tja das ist der erste Schritt der Problemloesung ... aber helfen kann ich Dir dabei nicht! "));
  AddDetail( ({ "problemloesung", "schritt" }),  
  BS("Das musst Du schon selbst wissen. "));
  AddDetail( ({ "festgesellschaft", "gesellschaft" }),  
  BS("Gerade ist leider kein Fest im Gange. Vielleicht wirst Du ja zum naechsten eingeladen. "));
  AddDetail( ({ "haken" }),  
  BS("An diesen Haken haengt allerlei Handwerkszeug zum zuberieten von Speisen. Messer, Reiben und "+
  "vieles mehr. "));
  AddDetail( ({ "messer", "reiben", "reibe", "handwerkszeug" }),  
  BS("Das braucht der Koch zum zubereiten. "));
  AddDetail( ({ "koeche", "koch" }),  
  BS("Die Koeche werden hier kochen wenns ein Fest gibt. "));
  AddDetail( ({ "durchgang" }),  
  BS("Der Durchgang fuehrt in die Eingangshalle. "));
  AddDetail( ({ "eingangshalle" }),  
  BS("Dazu musst Du durch den Durchgang gehen. "));
  AddDetail( ({ "abgang", "gelaender" }),  
  BS("Der Abgang fuehrt in den Keller. Das Gelaender soll davor schuetzen, dass man nicht hinab faellt. "));
  AddDetail( ({ "keller" }),  
  BS("Dazu musst Du schon nach unten gehen. "));
  AddDetail( ({ "tuer" }),  
  BS("Die Tuer fuehrt in die Haupthalle. "));
  AddDetail( ({ "fest" }),  
  BS("Jaja - feste untersuchen... wer weiss was man so findet. "));
  AddDetail( ({ "haupthalle" }),  
  BS("Dazu musst Du schon durch die Tuer im Norden gehen. "));
  AddDetail( ({ "schraenke", "schrank" }),  
  BS("Welchen Schrank willst Du den untersuchen? Den rechten Schrank oder den linken Schrank? "));
  AddDetail( ({ "rechten schrank", "schrank rechts" }),  
  BS("Ein massiver Schrank. Leider abgeschlossen. "));
  AddDetail( ({ "linken schrank", "schrank links", "linker schrank" }),  
  BS("Ein massiver Schrank. Leider abgeschlossen. "));
  AddDetail( ({"freiherr", "freiherrn", "burgherr", "burgherrn"}),
  BS("Der Freiherr ist sicher in den oberen Etagen zu finden."));
  AddDetail( ({"mitte"}),
  BS("In der Mitte des Raumes steht eine grosse Anrichte."));
  AddDetail( ({"wand"}),
  BS("Welche Wand willst Du untersuchen? In jeder Himmelsrichtung ist eine."));
  AddDetail( ({"himmelsrichtung", "himmelsrichtungen"}),
  BS("Norden, Sueden, Osten und Westen."));
  AddDetail( ({ "erdgeschoss", "gelaende" }),  
  BS("Das Stockwerk das ebenerdig zum umliegenden Gelaende ist nennt man Erdgeschoss. "));
  AddDetail( ({ "stockwerk", "etagen", "etage", "stock" }),  
  BS("Du befindest Dich im Erdgeschoss. "));
  
  /*Menue*/
  AddDrink("Spuelwasser", ({"wasser", "spuelwasser"}), 130, 5, 0, 8,
         ({ "Du trinkst ein Glas Spuelwasser - wie eklig.",
            "&& leert in einem Zug ein Glas Spuelwasser." }) );
  AddFood("Brot", "brot", 120, 5,
         ({ "Du isst ein Brot.",
            "&& isst ein Brot." }) );
  AddFood("Hafergruetze", ({"hafer", "gruetze", "hafergruetze"}), 420, 25,
         ({ "Du isst eine dampfende Schale voll leckerer Hafergruetze.",
            "&& isst eine dampfende Schale voll leckerer Hafergruetze." }) );

/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  
  // Exits
  AddExit( "osten", BURG + "zs_burg_eg_b2.lpc" );
  AddExit( "norden", BURG + "zs_burg_eg_a1.lpc" );
  AddExit( "unten", KELLER + "zs_keller_a1.lpc" ); 
  
  // Items
  AddItem( NPC + "erna_kollwanst.lpc", REFRESH_DESTRUCT );
  RemoveItem( "/obj/topliste" );   
}

/* ueberladen von menue */

int menue()
{
  int i;

  write(BS("Erna Kollwanst kann Dir folgendes fuer ein kleines Entgeld zubereiten:"));
  for (i=0; i<sizeof(food); i++)
    printf("%-18.18s  %5.5d Muenzen\n", food[i][0], calc_price(food[i]));
  for (i=0; i<sizeof(drink); i++)
    printf("%-18.18s  %5.5d Muenzen\n",
          drink[i][0], calc_price(drink[i]),
          (drink[i][4] <= 0) ? "Nein" : " Ja ");
 
  return 1;
}
