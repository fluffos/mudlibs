#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Zugbruecke" );
  SetProp( P_INT_LONG,
    BS("Du stehst auf der Zugbruecke zur Burg Friedheim. Mit ein paar Schritten "+
    "nach Norden kommst Du in die Burg. Im Sueden beginnt der Weg zum Dorf.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel", "wetter" }),  
  BS("Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. " ));
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weiße Schaefchenwolken. \n" );
  AddDetail( ({"boden", "zugbruecke", "bruecke"}), 
  BS("Du stehst auf der Zugbruecke. Sie besteht aus grossen Holzbalken und kann ohne "+
  "Probleme eine vollbeladene Kutsche tragen. Zwei Ketten sind daran befestigt an denen sie wohl "+
  "hochgezogen werden kann. Diese Ketten verschwinden durch zwei Loechern in das Torhaus. "));
  AddDetail( ({"holzbalken", "querbalken", "balken"}), 
  BS("Die massiven Holzbalken bilden die Zugbruecke. Warscheinlich geben mehrere Querbalken "+
  "der Bruecke ihre Stabilitaet. "));
  AddSpecialDetail( ({"stabilitaet"}), "test_stability" );
  AddDetail( ({ "burg", "friedheim", "bau" }),
  BS("Nur noch ein Schritte auf der Zugbruecke gen Sueden kannst Du das Torhaus der Burg betreten. "+
  "Das Torhaus selbst nimmt dir die Sicht auf grosse Teile der Burg. Nur das oberste Stockwerk des "+
  "imposanten Bergfrieds kann man erkennen. "));
  AddDetail( ({ "torhaus" }),
  BS("Das Torhaus besteht aus einem grossen Tor und einer Wachstube darueber. Warscheinlich kann man "+
  "dort auch die Zugbruecke hochziehen oder herunterlassen. "));
  AddDetail( ({ "sicht", "teile" }),
  BS("Geh einfach auf den Burghof, da hast Du dann eine gute Sicht."));
  AddDetail( ({ "stockwerk" }),
  BS("Nur das oberste Stockwerk des Bergfrieds ist sichtbar. "));
  AddDetail( ({ "bergfried" }),
  BS("Nur das oberste Stockwerk des Bergfrieds ist sichtbar. Ein eindrucksvoller Bau."));
  AddDetail( ({ "probleme" }),
  BS("Du hast gleich einen Schwung mehr Probleme wenn Du jeden Scheiss untersuchst!"));
  AddDetail( ({ "kutsche" }),
  BS("Warte einfach ein bischen. Vielleicht faehrt ja eine vorbei."));
  AddDetail( ({ "ketten", "kette", "glieder" }),
  BS("Eiserne Glieder bilden eine Kette an denen die Zugbruecke wohl hoch gezogen werden kann. "));
  AddDetail( ({ "loch", "loecher" }),
  BS("In den Loechern des Torhauses verschwinden die Ketten."));
  AddDetail( ({"burghof"}),
  BS("Dazu musst Du erst durch das Torhaus hindurch."));
  AddDetail( ({"dorf"}),
  BS("Das Dorf kann man von hier aus im Suedosten erkennen."));
  AddDetail( ({"scheiss", "schwung"}),
  BS("Dir wird gleich der Kopff gewaschen."));
  AddDetail( ({"forschersseele", "kopf"}),
  BS("Du Forscherseele ..."));
  AddSpecialDetail( ({"kopff"}),
  "unt_scriptfalle");
  AddDetail( ({"schritte", "schritten"}),
  BS("Geh doch einfach in die Burg hinein und schau Dich um."));
  AddDetail( ({"tor", "holztor"}),
  BS("Ein massives Holztor. Es ist geoeffnet."));
  AddDetail( ({"holz"}),
  BS("Normales Holz, wie man es in der naeheren Umgebung reichlich findet."));
  AddDetail( ({"voegel"}),
  BS("Sie fliegen am Himmel."));
  AddDetail( ({"wachstube"}),
  BS("Dazu musst Du die Wachstube erstmal betreten."));
  AddDetail( ({"weg"}),
  BS("Der Weg zum Dorf endet gleich hier an der Zugbruecke."));

  AddSound( DEFAULT_SOUND,
    "Ein paar Voegel zwitschern. \n");
  AddSound( ({ "zwitschern", "voegel" }),
    "Sehr nett. \n");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen. \n" );
  AddDetail( ({"umgebung", ""}),
  BS("Da bist Du auf Deinem Weg zu dieser Burg durchgekommen."));	
	
	
/*
  AddDetail( ({"", ""}),
  BS("")); 
*/

// END DETAILS
  AddExit( "norden", BURG "zs_burg_eg_b4" );
  AddExit( "sueden", WEGE "weg_zur_burg_a1" );
// END EXITS  

}

string test_stability (string str) 
{
    write("Du springst kurz hoch und testest die Stabilitaet der Bruecke. \n");
    write("Ergebnis: Sehr stabil! \n");
    say( TPN + " springt auf und testet die Stabilitaet der Bruecke. \n");
    return "";
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 45+random(60), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}