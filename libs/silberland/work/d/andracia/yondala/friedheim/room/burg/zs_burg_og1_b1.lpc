//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Wachraum des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich in einem Wachraum des Bergfrieds zu Friedheim. "+
  "Mehrere Betten stehen hier und dienen wohl den Wachen als Nachtlager. Ein Durchgang nach "+
  "suedwesten fuehrt in den anderen Wachraum. Im Westen befindet sich die Waffenkammer und im "+
  "Sueden kommt man durch Tuer ins Treppenhaus. Durch eine schwere Tuer im Osten kannst Du "+
  "hier hinaus auf den Wehrgang. "));
   
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus massiven Holzbohlen. \n");
  AddDetail( ({ "waende", "burgmauern", "mauern", "wand", "burgmauer" }),
  BS("Die Waende bestehen alle aus groben Steinen. An der Nordwand stehen mehrere Truhen. "));
  AddDetail( ({ "nordwand" }),
  "Hier stehen mehrere Truhen. \n");
  AddDetail( ({ "suedwand" }),
  "Hier ist eine Tuer zum Treppenhaus. \n");
  AddDetail( ({ "ostwand" }),
  "Hier ist eine Tuer hinaus zum Wehrgang. \n");
  AddDetail( ({ "westwand" }),
  "Hier ist eine Tuer zur Waffenkammer. \n");
  AddSound( DEFAULT_SOUND,
  "Es sind keine besonderen Geraeusche zu hoeren.");
  AddSound( "geraeusche",
  "Du hoerst nichts besonderes.");
  AddSmell( DEFAULT_SMELL,
  "Du kannst nichts besonderes riechen.");
    
  /* extra Details */ 
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich in einem Wachraum des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "wehrgang", "wehrgaenge" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "));
  AddDetail( ({ "zinnen", "zinne", "mauerstuecke", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "truhe", "truhen", "habe" }),
  BS("Diese Truhen dienen wohl den Wachen fuer ihre persoenliche Habe. Alle sind verschlossen. "));
  AddDetail( ({ "treppenhaus" }),
  "Dazu musst Du Dich nach Sueden begeben. \n");
  AddDetail( ({ "waffenkammer" }),
  "Dazu musst Du Dich nach Westen begeben. \n");
  AddDetail( ({ "tuer" }),
  "Alle Tueren hier sind aus starken Holzbohlen gefertigt. \n");
  AddDetail( ({ "holzbohlen", "bohlen"  }),  
  BS("Tueren und Boden bestehen aus massiven Holzbohlen. "));
  AddDetail( ({ "betten", "bett", "nachtlager" }),
  BS("Die Betten bestehen aus einem Bettkasten, einer strohgefuellten Matraze und einer einfachen Decke. "
  "Im Grunde sehr bequem - in anderen Burgen sind die Unterkuenfte der wachen nicht so luxurioes."));
  AddDetail( ({ "bettkasten", "kasten" }),
  "Eigentlich nur ein einfacher rechteckiger Holzrahmen. \n");
  AddDetail( ({ "holzrahmen", "rahmen" }),
  "die Holzrahmen bilden die Bettkasten der Betten hier. \n");
  AddDetail( ({ "matrazen", "matraze", "stoffsack", "stroh" }),
  BS("Damit das Stroh des Betts nicht wild in der Gegend herumliegt wurde es in einen grossen Stoffsack gestopft und dient nun als Nachtlager der Wachen. "));
  AddDetail( ({ "decken" }),
  BS("Einfache Leinendecken um sich vor der Kaelte der Nacht zu schuetzen."));
  AddDetail( ({ "raum", "unterkuenfte", "wachraum", "wachraeume" }),
  BS("Der Raum ist schlicht und praktisch. Mehrere Betten stehen hier und dienen wohl den Wachen als Nachtlager. "+
  "An der Nordwand stehen viele Truhen. Ein Durchgang nach "+
  "Suedwesten fuehrt in den anderen Wachraum auf dieser Etage. Im Westen befindet sich die Waffenkammer und im "+
  "Sueden kommt man durch Tuer ins Treppenhaus. Durch eine schwere Tuer im Osten kannst Du "+
  "hier hinaus auf den Wehrgang. "));
  AddDetail( ({"angriff", "belagerung", "feinde"}), 
  BS("Gerade sind keine Feinde dabei die Burg anzugreifen oder zu belagern."));
  AddDetail( ({"durchgang", "gang"}),
  BS("Ein breiter Gang fuehrt hier nach suedwesten zum anderen Wachraum."));
  AddDetail( ({"stein", "steine", "steinen"}),
  BS("Grobe Steine bilden die Waende."));
  AddDetail( ({"wachen", "burgwachen"}),
  BS("Die Wachen patroullieren hier und auf den Wehrgaengen."));
  AddDetail( ({"etage"}),
  BS("Dies ist die erste Etage. Hier sind die Wachraeume und die Waffenkammer der Burg."));
  
/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  // END DETAILS
  AddExit( "osten", BURG + "zs_burg_og1_c1.lpc" );
  AddExit( "sueden", BURG + "zs_burg_og1_b2.lpc" );
  AddExit( "suedwesten", BURG + "zs_burg_og1_a2.lpc" );
  AddExit( "westen", BURG + "zs_burg_og1_a1.lpc" );
   
  // END EXITS
  AddItem( NPC + "burgschuetze.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgschuetze.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );   
}

