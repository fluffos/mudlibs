#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

// #define TY(x) if(find_player("yason")) tell_object(find_player("yason"),x)
#define TY(x)

int spinne_vorhanden;

void reset()
{
  ::reset();
  spinne_vorhanden = 1; 
}

void create() 
{
  ::create();

  spinne_vorhanden = 1;
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("In der mitte des Raums befindet sich ein Spinnennest. "+
  "Es ist eine Kugel aus wollartigem Gewebe, aufgehaengt an Spinnenfaeden. "));
 
  AddDetail( ({ "spinnenfaeden", "faeden" }),
  BS("Das Spinnennest wird durch viele Spinnenfaeden in der Luft gehalten."));
  AddDetail( ({ "gewebe", "kugel" }),
  BS("Das kugelfoermige Gebilde schein ein Spinnennest zu sein."));
  AddSpecialDetail( ({ "spinnennest", "nest", "spinne" }), "unt_spinnennest" );

  AddCmd( ({ "stochere", "stocher" }), "stocher_nest" );

  AddExit( "suedosten", KELLER + "zs_sublevel1_f2.lpc" );
  AddExit( "westen", KELLER + "zs_sublevel1_d1.lpc" );

}

string unt_spinnennest()
{ 
  write("Du schaust vorsichtig in das Nest ... \n");
  if(spinne_vorhanden == 0) return "Es scheint leer zu sein. \n";
  return BS("Eine Spinne sitzt darin. Du koenntest im Nest stochern um sie heraus "+
  "zuholen. ");
}

int stocher_nest(string str)
{
  notify_fail("Worin willst Du stochern? \n");
  TY(str+"\n");
  if( str != "in nest" && str != "in spinnennest" &&  str != "nest" && str != "spinnennest") return 0;
  notify_fail("Es ist keine Spinne vorhanden. \n");
  if(spinne_vorhanden == 0) return 0;
  write("Du stocherst im Spinnennest bis die Spinne herauspurzelt. \n");
  AddItem(NPC+"kellermonster_spinne.lpc", REFRESH_NONE);
  spinne_vorhanden = 0;
  return 1;
}