inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Dach des Turms" ); 
  SetProp( P_INT_LONG,  
  BS("Du stehst auf dem Dach des Turms. "+
  "Ueber die Zinnen hinweg hat man in westlicher und suedlicher licher Richtung eine gute Aussicht ueber das "+
  "umliegende Huegelland. eine hoelzerne Treppe fuehrt zurueck in den unteren Raeume des Turms. "));
     
  /* Standartdetails */
  AddDetail( ({ "himmel", "wetter" }),  
  BS("Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "boden" }),
  "Der Boden ist mit groben Steinen gepflastert. \n" );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke", "burgmauer", "stein", "steine" }),
  BS("Die steinernen Aussenwaende des Bergfrieds und der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. "));
  AddSound( DEFAULT_SOUND,
  "Aus dem Suedosten dringen Arbeitsgeraeusche eines Schmiedes an Dein Ohr. \n" );
  AddSmell( DEFAULT_SMELL,
  "Du kannst nur den leichten Geruch einer Feuerstelle wahrnehmen. \n" );
  
  AddDetail( ({ "friedheim", "burg" }),
  "Du bist in der Burg zu Friedheim. \n"  );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt solch ein wehrhaftes Gebaeude zu bauen. "));
  AddDetail( ({ "bauwerk", "gebaeude" }),
  "Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. \n" );
  AddDetail( ({ "innere", "raeume" }),
  "Du musst die Treppe runter um das Innere des Turms zu erkunden. \n" );
  AddDetail( ({ "turm", "tuerme" }),
  "Das Innere des Turms kannst Du mit der Treppe erreichen. \n" );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weisse Schaefchenwolken. \n" );
  AddDetail( ({ "hoehe", "stockwerke" }),
  BS("Der Bergfried hat wohl 4 Stockwerke. Die oberste Kante ist mit Zinnen bewehrt. "));
  AddDetail( ({ "grundriss", "seite" }),
  "Annaehernd quadratisch nimmst Du an. Eine Seite misst so 50 Schritt. \n" );
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "metallplatten", "platten", "beschlag" }),
  "Das Tor zum Bergfried wird dadurch einem Angriff laenger widerstehen. \n" );
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "));
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "dach" }),
  "Hier auf dem Dach des Turmes kannst Du nichts besonderes erkennen." );
  AddSmell( ({ "feuerstelle", "rauch" }),
  "Rauch eben. \n" );
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  BS("Das typisch metallisch klingenden Geraeusch wenn ein Hammer warmes Eisen auf dem Amboss trifft. "));
  AddDetail( ({ "richtung" }),
  BS("Was fuer eine Richtung auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "huegelland", "aussicht", "ueberblick" }),
  BS("Soweit das Auge reicht kannst Du nur fruchtbares Huegelland um die Burg herum erkennen."));
  AddDetail( ({ "burghof", "hof" }),
  BS("Vom Turm aus hat man einen sehr guten Ueberblick auf den Burghof. "));
  AddDetail( ({ "belagerung" }),
  BS("Zur Zeit ist keine Belagerung im Gange."));
  AddDetail( ({ "amboss", "eisen", "hammer", "schmied" }),
  BS("Das kann man alles in der Schmiede im Burghof untersuchen"));
  AddDetail( ({ "schmiede" }),
  BS("Man kann die Schmiede im Burghof sehen."));
  AddDetail( ({ "treppe" }),
  BS("Die Treppe fuehrt wieder nach unten."));
  AddSmell( ({ "geruch" }),
  BS("Man kann hier oben noch leicht den Rauch aus der Schmiede riechen."));

/*
  AddDetail( ({ "" }),
  BS(""));
*/
   
  AddExit( "unten", BURG + "zs_burg_og1_a5" );
  
}
