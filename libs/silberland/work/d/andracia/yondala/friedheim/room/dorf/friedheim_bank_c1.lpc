//Die Filiale der Lunia-Bank in Friedheim

#include "../def.h"

inherit "/room/std_bank.lpc";

#include <properties.h>

void create() 
{
  ::create();

  abhebungsgebuehr=50; // billiger ...

  SetProp( P_INT_SHORT, "In der friedheimer Filiale der Luniabank" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_INT_LONG, BS(  
    "Du stehst mitten in einer kleinen Filiale der grossen Luniabank. In der Westwand der Bank sind "+
    "zwei kleine Schalter eingelassen hinter denen Bankangestellte die Wuensche der Kunden bearbeiten. "+
    "In der Wand im Norden sind zwei gosse Fenster die viel Licht hereinlassen, im Sueden hingegen "+
    "wurde die Wand mit einem eindrucksvollen Wandteppich behaengt. ")+
    "Ein Schild haengt bei den Schaltern.\n" );

  AddSound( DEFAULT_SOUND,
    BS("Du hoerst geschaeftiges Treiben hinter der Westwand. Scheinbar sind die Bankangestellten dabei "+
    "Saecke mit Muenzen hin und her zuschleppen."));
  AddSound( ({ "treiben", "schleppen", "muenzen", "saecke", "geraeusch", "geraeusche", "geraeuschen" }),
    BS("Du kannst hoeren wie mit Muenzen gefuellte Saecke hin und her gezogen werden. Was die wohl mit den "+
    "Sparguthaben der Buerger so alles anfangen?"));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nur den trockenen, metallischen Geruch von Muenzen riechen. "));
  AddSmell( ({ "geruch", "metall", "muenzen" }),
    BS("Man kann hier foermlich riechen wie hier sich Berge von Muenzen stapeln. "));

  AddDetail( ({ "boden" }),
    BS("Einfache Holzbohlen bilden den Boden. Aussergewoehnlich ist nur dass die Spalte zwischen den Bohlen "+
    "so eng sind, damit herrunterfallende Muenzen nicht dazwischen geraten koennen. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke wurde, wie die Waende, mit einem hellen Verputz verkleidet. Zusaetzlich wurden Ornamente aus "+
    "Gips am Rand der Decke, sowie in der Mitte des Raums angebracht. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende haben mit einem hellen Verputz. Neben den Fenstern in der Nordwand, die einiges an Licht hereinlassen, "+
    "gibt es noch Schalter in der Westwand. Die Suedwand wird von einem grossen Wandteppich geziert, waehrend in der "+
    "Ostwand nur der grosse Eingang die Wand unterbricht."));
  AddDetail( ({ "filiale", "raum", "bank", "luniabank", "bankraum", "zimmer" }),
    BS("Die Filiale der Luniabank hier in Friedheim wurde zwar recht hell gestaltet aber ansonsten ist der Bankraum "+
    "doch sehr schlicht gestaltet. Bis auf die Ornamente aus Gips an der Decke und dem Wandteppich, der fast die ganze "+
    "Suedwand einnimmt, gibt es keine Moebel und die Kunden muessen ihre Geschaefte an den Schaltern im Stehen durchfuehren. "+
    "Hinter der Westwand scheinen noch weitere Zimmer zu sein aber Du kannst nicht erkennen wie man dort hinein gelangt."));
  AddDetail( ({ "westwand" }),
    BS("In der Westwand sind Schalter eingelassen, hinter denen die Bankangestellten die Wuensche der Kunden "+
    "bearbeiten. Eine Tuer die hier in die weiteren Zimmer fuehrt, kannst Du nicht erkennen. Ein Schild wurde haengt "+
    "bei den Schaltern und gibt Auskunft ueber die Preise die hier fuer die Bankgeschaefte verlangt werden."));
  AddDetail( ({ "nordwand", "fenster", "licht" }),
    BS("Die Fenster in der Nordwand sind vergleichsweise gross. Durch das Glass dingt viel Licht herein und laesst "+
    "den Raum mit seinem hellen Verputz hell erstrahlen. "));
  AddDetail( ({ "suedwand" }),
    BS("Die Suedwand wird fast vollstaendig von einem Wandteppich geziert. "));
  AddDetail( ({ "ostwand", "ausgang", "tuer", "eingang" }),
    BS("In der Ostwand befindet sich eine grosse Tuer durch die man wieder hinaus auf die Strasse kann. "+
    "Sie ist offen und man kann draussen die Bewohner des Dorfs vorbeilaufen sehen."));
  AddDetail( ({ "schalter", "durchbruch", "durchbrueche" }),
    BS("Die Schalter in der Westwand sind eigentlich nur grosse Durchbrueche mit einem breiten Brett als Sims. "+
    "Hinter den Schaltern befinden sich Bankangestellte und warten darauf dass die Buerger ihre Guthaben auffuellen. "));
  AddDetail( ({ "bankangestellte", "bankangestellter", "angestellte", "angestellter", "menschen" }),
    BS("Die Bankangestellten, die man hinter den Schaltern erkennen kann, tragen eine blaue Leinenuniform, "+
    "haben ein ungewoehnlich gepflegtes Erscheinen und selbst ihr etwas aufgesetzt wirkendes Laecheln zeigt "+
    "fast tadellos weise Zaehne. "));
  AddDetail( ({ "wunsch", "wuensche" }),
    BS("Die Bankangestellten werden alle Deine Wuensche bearbeiten. Falls Du also schon ein Sparbuch hast kannst Du "+
    "nun Muenzen einzahlen oder abheben, oder sogar Dein Sparbuch wieder aufloesen. "));
  AddDetail( ({ "kunde", "kunden" }),
    BS("Falls Du Kunde werden moechtest, musst Du hier ein Sparbuch anlegen. Oder bist Du schon ein Kunde?"));
  AddDetail( ({ "wandteppich", "teppich" }),
    BS("Der Wandteppich zeigt Lunia in ihrer vollen Pracht wie es wohl fuer einen Vogel aussehen muss. "+
    "Dir wird schon ganz schwindelig beim hinschauen."));
  AddDetail( ({ "schild", "auskunft" }),
    BS("Das Schild, das an der Westwand haengt und die Preise fuer die Bankgeschaefte auszeichnet, ist aus Schiefer "+
    "und man erkennt dass die Zahlen nur mit Kreide aufgemalt sind."));
  AddDetail( ({ "muenzen", "saecke", "muenzsaecke", "muenze" }),
    BS("Du kannst leider die riesige Berge an Muenzen die hinter der Westwand in Saecken wohl hin und hergeschleppt werden "+
    "nur von den Geraeuschen her erahnen."));
  AddDetail( ({ "sparguthaben", "guthaben", "sparbuch" }),
    BS("Falls Du ein Sparbuch hast, so lies doch einfach darin nach, wieviel Du schon angespart hast. Oder "+
    "willst Du eines anlegen?"));
  AddDetail( ({ "buerger", "bewohner" }),
    BS("Auch Du bist ein Buerger."));
  AddDetail( ({ "berg", "berge" }),
    BS("Die Berge befinden sich im Osten und irgendwo darueber schwebt die Wolkenstadt Lunia."));
  AddDetail( ({ "spalten", "spalte", "bohlen", "holzbohlen" }),
    BS("Die Spalten zwischen den Holzbohlen des Bodens sind so eng dass keine versehentlich herunterfallende "+
    "Muenze dazwischen geraten kann."));
  AddDetail( ({ "stuck", "ornamente", "gipsornamente", "deckenrand", "rand", "deckenmitte", "mitte", "pracht"
  	            "ornament", "ecke", "ecken", "gips", "leisten", "schnoerkel", "schnoerkeln", "schmuck" }),
    BS("Die Ornamente aus Gips, die den Rand der Decke schmuecken, sind einfache, gestufte Leisten die in den "+
    "Ecken mit Schnoerkeln zusammen fuehren. Das etwas groessere Ornament in der Mitte des Raums ist eine "+
    "stilisierte Blume mit vielen Blaettern. Farbe wurde aber keine verwendet und daher ist dieser Schmuck "+
    "fast in derselben Farbe wie die verputzte Decke selbst oder der Verputz der Waende. "));
  AddDetail( ({ "verputz" }),
    BS("Der Verputz ist sehr hell und laesst daher darauf schliessen dass er erst letztens frisch in weiss getuencht wurde."));
  AddDetail( ({ "moebel" }),
    BS("Hier im Bankraum wurden keine Moebel aufgestellt. Irgendwie moechtest Du auch nicht allzulange hier in "+
    "diesem hellen aber ungemuetlichen Raum verweilen."));
  AddDetail( ({ "friedheim", "dorf" }),
    BS("Draussen sind die Strassen vom Dorf zu Friedheim. Du musst schon nach draussen gehn um Dich dort umzuschauen."));
  AddDetail( ({ "strasse", "draussen" }),
    BS("Dazu musst Du schon nach draussen gehen."));
  AddDetail( ({ "aussehen", "zaehne", "erscheinen", "laecheln" }),
    BS("Die Bankangestellen werden Dir richtig unheimlich. Sie laecheln Dich starr an und zeigen ihre dabei "+
    "ihre blendent weissen Zaehne. So ein gepflegtes Erscheinen haben selbst Koenige nur selten."));
  AddDetail( ({ "koenig", "koenige" }),
    BS("Mhm - heute ist kein Koenig hier."));
  AddDetail( ({ "preise" }),
    BS("Die Preise fuer die Bankgeschaefte werden auf dem Schild, das an der Westwand haengt, ausgezeichnet."));
  AddDetail( ({ "geschaefte", "bankgeschaefte" }),
    BS("Scheinbar kann man hier ein Sparbuch anlegen, darauf dann Muenzen einzahlen oder abheben, oder sogar "+
    "das angelegte Sparbuch wieder aufloesen."));
  AddDetail( ({ "lunia", "wolkenstadt", "wolken" }),
    BS("Der Wandteppich zeigt die Wolkenstadt Lunia wie es zwischen den Wolken schwebt. Ein wirklich eindrucksvoller Wandteppich. "+
    "Vielleicht solltest Du Lunia mal besuchen."));
  AddDetail( ({ "zahlen", "kreide", "schiefer" }),
    BS("Die Zahlen auf dem Schild aus Schiefer sind nur mit Kreide aufgemalt. Scheinbar ist man hier darauf eingerichtet, "+
    "dass sich die Preise doch desoefteren aendern. "));
  AddDetail( ({ "blaetter", "blume" }),
    BS("Es ist nur eine stilisierte Blume. Man kann es nur erkennen da die vielen Bluetenblaetter ringsherum sich leicht ueberlappen."));
  AddDetail( ({ "brett", "sims" }),
    BS("Auf den Brettern die als Sims an den Schaltern angebracht wurden, koennen die Bankangestellten die Muenzen zaehlen, "+
    "die die Kunden einzahlen oder abheben."));
  AddDetail( ({ "glass" }),
    BS("Das Glass ist erstaunlich klar. So klares Glass sieht man nur selten."));
  AddDetail( ({ "farbe", "tuenche" }),
    BS("Die Waende wurden weiss getuencht und auch die Ornamente aus Gips sind sehr hell gestaltet. Ein bischen mehr Farbe wuerde "+
    "diesem Raum nicht schaden."));
  AddDetail( ({ "leinenuniform", "uniform" }),
    BS("Alle Bankangestellten, die Du durch die Schalter erkenen kannst, haben diese blaue Uniform an. Auch scheinen "+
    "Sie alle su unheimliche zu Laecheln. Nun erkennst Du auch, dass Sie alle sich fast wie ein Ei dem anderen gleichen. "+
    "Ob das normale Menschen sind?"));
  AddDetail( ({ "vogel", "voegel" }),
    BS("Hier in den Bankraum hat sich kein Vogel verirrt. Im Wald wirst Du da eher fuendig."));
  AddDetail( ({ "wald" }),
    BS("Das hier ist ein Bankraum - ein Wald sieht um einiges anders aus."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddReadDetail( ({ "schild" }),
    ("Folgende Dienste bieten wir an:\n"
     "Sparbuch anlegen:   "+anleggebuehr+" M\n"
     "Muenzen einzahlen:    0 M\n"
     "Muenzen abheben:     "+abhebungsgebuehr+" M\n"
     "Sparbuch aufloesen: "+aufloesegebuehr+" M"));
 
  AddExit( "osten", DORF + "friedheim_dorf_d1.lpc" );


}

