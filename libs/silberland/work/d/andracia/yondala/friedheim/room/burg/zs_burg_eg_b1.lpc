//23.2.2019 Yondala@SilberLand funktioniert
inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Erdgeschoss des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  BS("Du befindest Dich im oestlichen Teil der Haupthalle des Bergfrieds zu Friedheim. "+
  "Ein grosser, breiter Tisch ist in der mitte der Halle aufgebaut. Lange Baenke stehen daran und nur an der Kopfseite "+
  "stehen drei schoene Stuehle mit Lehnen. Hier wird wohl gefeiert wenn der Burgherr ein Fest gibt. "+
  "Die Nordwand wird von einem grossen offenen Kamin beherrscht. Darueber wurde ein grosses Reliefbild aus Messing "+
  "angebracht. Die Ostwand ist mit einem Wandteppich und einem Prunkschild rechts und links des Teppichs geschmueckt. "+
  "In der mitte der Suedwand ist die Tuer zur Eingangshalle. Rechts und links der Tuer sind Gemaelde aufgehaengt. "+
  "In der suedoestlichen Ecke steht eine mannshohe Vase. Die Halle selbst erstreckt sich weiter nach Westen. "));
   
  /* Smells und Sounds */
  AddSound( DEFAULT_SOUND,
  BS("Es sind keine besonderen Geraeusche zu hoeren. "));
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nichts besonderes riechen. "));
  AddSound( ({ "geraeusche" }),
  BS("Es sind wirklich keine besonderen Geraeusche zu hoeren."));
  
  /* Details */ 
  AddDetail( ({ "decke" }),  
  BS("Die Decke ist mit blau gefaerbten Leinentuechern abgehaengt. Du nimmst an, dass die Decke auch hier aus Holz ist. "));
  AddDetail( ({ "boden" }),
  BS("Der Boden besteht aus glatten Steinen."));
  AddDetail( ({ "waende" }),
  BS("Welche Wand willst Du untersuchen? Ost- West, Nord- oder Suedwand? "));
  AddDetail( ({ "nordwand" }),
  BS("Der grosse offene Kamin in der Nordwand nimmt sehr viel der Wand ein. Ein grosses Reliefbild haengt darueber. "));
  AddDetail( ({ "ostwand" }),
  BS("Ein grosser Wandteppich haengt an der Ostwand. Rechts und links davon wurden zwei Prunkschilde aufgehaengt. "));
  AddDetail( ({ "suedwand" }),
  BS("Die Tuer zur Eingangshalle befindet sich hier. Gemaelde wurden hier links und rechts der Tuer aufgehaengt. "));
  AddDetail( ({ "westwand" }),
  BS("Um die naechste Westwand zu untersuchen solltest Du den westlichen Teil der Haupthalle aufsuchen. "));
  AddDetail( ({ "erdgeschoss" }),  
  BS("Das Stockwerk das ebenerdig zum umliegenden Gelaende ist nennt man Erdgeschoss. "));
  AddDetail( ({ "stockwerk" }),  
  BS("Du befindest Dich im Erdgeschoss. "));
  AddDetail( ({ "leinentuecher" }),  
  BS("Die Leinentuecher verstecken die Decke. Leider haengen sie zu hoch um sie naeher zu untersuchen. "));
  AddDetail( ({ "bergfried", "friedheim", "burg", "bergfrieds", "burgfried", "burgfrieds" }),  
  BS("Du befindest Dich im Erdgeschoss des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "haupthalle", "halle" }),  
  BS("Du befindest Dich in der Haupthalle. "));
  AddDetail( ({ "kamin" }),  
  BS("Ein grosser steinerner offener Kamin. in den Wintermonaten kann man hier gemuetlich bei einem grossen Feuer sitzen. "));
  AddDetail( ({ "reliefbild", "messingbild", "bild", "szene" }),  
  BS("Das Reliefbild zeigt eine Szene wo ein erfolgreicher Kaempfer mit dem Kopf eines Drachen von einer jubelnden Menge "+
  "begeistert gefeiert wird. Der Drachenkopf ist besonders plastisch dargestellt. "));
  AddDetail( ({ "wandteppich", "teppich", "teppichs" }),  
  BS("Der Wandteppich zeigt eine schoene idyllische Landschaft und ein grosser Drache fliegt in der Mitte des Bilds. "));
  AddDetail( ({ "prunkschild", "schild", "prunkschilde", "schilde"  }),  
  BS("Welches Schild willst Du denn untersuchen? Das rechte oder das linke Schild? "));
  AddDetail( ({ "prunkschild rechts", "rechtes prunkschild", "schild rechts", "rechtes schild" }),  
  BS("Ein sehr schoen gearbeitets Schilde mit deinem detailreichen Wappen darauf. Es scheint das Wappen derer von Friedheim zu sein. "));
  AddDetail( ({ "prunkschild links", "linkes prunkschild",  "schild links", "linkes schild" }),  
  BS("Ein sehr massives Schild. "));
  AddDetail( ({ "tuer" }),  
  BS("Die grosse Tuer im Sueden fuehrt in die Eingangshalle zurueck. "));
  AddDetail( ({ "gemaelde" }),  
  BS("Welches Gemaelde willst Du denn untersuchen? Willst Du das rechte oder das linke Gemaelde anschauen? "));
  AddDetail( ({ "gemaelde rechts", "rechtes gemaelde" }),  
  BS("Dieses Gemaelde zeigt Bauern bei der Arbeit auf dem Feld. "));
  AddDetail( ({ "gemaelde links", "linkes gemaelde" }),  
  BS("Dieses Gemaelde zeigt Bauern die vor einem Drachen fliehen vor im Hintergrund brennender Felder "));
  AddDetail( ({ "ecke" }),  
  BS("Welche Ecke willst Du denn untersuchen? "));
  AddDetail( ({ "suedoestliche ecke", "ecke suedost", "ecke suedosten" }),  
  BS("Hier steht eine mannshohe Vase. Scheinbar die Arbeit eines Riesen. "));
  AddDetail( ({ "nordoestliche ecke", "ecke nordost", "ecke nordosten" }),  
  BS("Eine uninteressante Ecke. Nur ein Winkel den hier die Mauern bilden. "));
  AddDetail( ({ "gelaende" }),  
  BS("Das Gelaende ausserhalb der Burg ist huegellig. "));
  AddDetail( ({ "tisch" }),  
  BS("Bei Festen wird dieser Tisch wohl mit allerlei leckeren Speisen gedeckt sein, "+
  "gerade ist der Tisch aber abgeraeumt und nichts liegt darauf. "));
  AddDetail( ({ "baenke" }),  
  BS("Auf den Baenken haben viele Gaeste platz. Hier kann man gut Feste feiern. "));
  AddDetail( ({ "kopfseite" }),  
  BS("An der Kopfseite des Tischs ist nichts besonderes ausser dass hier drei belehnte Stuehle stehen. "));
  AddDetail( ({ "stuehle", "lehnen" }),  
  BS("Sehr eindrucksvolle Tischlerarbeiten. Warscheinlich nehmen hier in diesen Stuehlen der Burgherr und seine Familie Platz. "));
  AddDetail( ({ "fest" }),  
  BS("Es ist gerade keins im Gange. "));
  AddDetail( ({ "burgherr", "familie", "freiherr" }),  
  BS("Der Burgherr heisst Freiherr von Friedheim. Er hat eine sehr huebsche Gemahlin und eine Tochter. "));
  AddDetail( ({ "tischlerarbeit", "tischlerarbeiten" }),  
  BS("Die Stuehle, Baenke und der Tisch sind gut verarbeitet und werden wohl mehrere Jahrzehnte gute Dienste tun, "+
  "eben das was man von guter Tischlerarbeit erwartet. "));
  AddDetail( ({ "feuer" }),  
  BS("Der offene Kamin ist gerade nicht befeuert, schliesslich ist es zur Zeit nicht kalt. "));
  AddDetail( ({ "vase" }),  
  BS("Diese Vase ist wirklich unglaublich gross. "));
 
 // BS("Der offene Kamin ist gerade nicht befeuert, schliesslich ist es nicht kalt draussen. "));
  AddDetail( ({ "steine", "stein" }),  
  BS("Die Steine die den Boden bilden sind zwar kein Marmor aber bilden trotzdem eine sehr glatt Oberflaeche. "));
  AddDetail( ({ "marmor" }),  
  BS("Diese Halle mit Marmor auszulegen waere sehr kostspielig. "));
  AddDetail( ({ "oberflaeche" }),  
  BS("Schoen glatt, pass auf, dass Du nicht ausrutscht! "));
  AddDetail( ({"wand"}),
  BS("Welche Wand willst Du untersuchen? In jeder Himmelsrichtung ist eine."));
  AddDetail( ({"himmelsrichtung", "himmelsrichtungen"}),
  BS("Norden, Sueden, Osten und Westen."));
  AddDetail( ({"gaeste", "gast"}),
  BS("Du selbst bist auch Gast hier."));
  AddDetail( ({"gemahlin", "tochter", "burgfraeulein"}),
  BS("Du kannst die Burgfraeulein sicher in den oberen Stockwerken finden."));
  AddDetail( ({"holz"}),
  BS("Ganz normales Holz."));
  AddDetail( ({"eingangshalle"}),
  BS("Dazu musst Du durch die Tuer im Sueden."));
  AddDetail( ({"drache", "drachen", "drachenkopf", "darstellungen", "darstellung", "grund", "wappen"}),
  BS("Ueberall hier auf Burg Friedheim sind Darstellungen von Drachen zu finden. Schliesslich ist "+
  "selbst das Wappen von Friedheim ein goldener Drache auf rotem Grund."));
  AddDetail( ({"kaempfer"}),
  BS("Jeder der mit einer Waffe durch die Landschaft streift und sich seiner Haut erwehrt, ist ein Kaempfer."));
  AddDetail( ({"landschaft"}),
  BS("Du bist im Burgfried zu Friedheim, da kann man nur wenig Landschaft sehen."));
  AddDetail( ({"messing", "metall"}),
  BS("Messing ist ein leicht zu bearbeitendes Metall."));
  AddDetail( ({"winkel", ""}),
  BS("90 Grad"));  
  AddDetail( ({"grad", ""}),
  BS("Ist wohl ein rechter Winkel."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
  
  // Exits
  AddExit( "westen", BURG + "zs_burg_eg_a1.lpc" );
  AddExit( "sueden", BURG + "zs_burg_eg_b2.lpc" );
  
  // Items
  // AddItem( "file", refresh, Props);
   
}

