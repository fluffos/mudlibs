#include "../def.h"

inherit WIESE+"fallobstwiese_raw.lpc";

#include <properties.h>
#include <language.h>

int anz_obst, anz_obst_hoch;

void reset()
{
  if( anz_obst < 4 ) anz_obst++;
  if( anz_obst_hoch < 6 ) anz_obst_hoch++;
	::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
    BS("Ein Birnbaum steht hier."));
  
  AddDetail( ({"birnbaum"}),
    BS("Der Birnbaum hat einige reife Birnen die man pfluecken kann. "+
    "Etwas hoeher am Baum haengen noch weitere Birnen ausserhalb der Reichweite deiner Arme. " ) );
  AddDetail( ({ "arme" }),
    BS("Zum Glueck hast Du welche."));
  AddDetail( ({ "glueck" }),
    BS("Ist es Dir heute hold?"));
  AddDetail( ({ "reichweite" }),
    BS("Mit einem Obstpfluecker kann man die Reichweite erhoehen. "));
  AddDetail( ({ "obstpfluecker" }),
    BS("Vielleicht hat ja Erna Kollwanst noch einen. "));
  
  AddSpecialDetail( ({"birne", "birnen" }), "unt_obst");
  
  AddCmd( ({"pflueck", "pfluecke"}), "pflueck_obst");
  
  AddExit( "westen", WIESE + "fallobstwiese_d4.lpc" );

  anz_obst = 4;
  anz_obst_hoch =6;

}


int pflueck_obst(string str)
{
	object ob;
	string was, womit;
        notify_fail("Was willst Du pfluecken? \n");
        if( !str ) return 0;
	if( sscanf(str, "%s mit %s", was, womit) != 2) 
		{
		  notify_fail("Was willst Du pfluecken? \n");
	    if( str!="obst" && str!="birne" && str!="birnen" ) return 0;
	    notify_fail("Es gibt gerade keine reifen Birnen in Reichweite. \n");
	    if( anz_obst == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_birne.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst eine schoene saftige Birne. \n");
      say(TPN + " pflueckt eine schoene saftige Birne. \n");
      anz_obst--;
      return 1;
    }
	else
		{
		  notify_fail("Was willst Du pfluecken? \n");
	    if( was!="obst" && was!="birne" && was!="birnen" ) return 0;
	    notify_fail("Damit kannst Du keine Birnen pfluecken. \n");	
	    if( womit!="obstpfluecker" && womit!="pfluecker" ) return 0;
	    notify_fail("Das hast Du nicht bei Dir. \n");
	    if( !present("/nobstpfluecker", TP) ) return 0;
		  notify_fail("Es gibt gerade keine reifen Birnen in erweiterter Reichweite. \n");    	
	    if( anz_obst_hoch == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_birne.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst mit dem Obstpfluecker eine schoene saftige Birne. \n");
      say(TPN + " pflueckt mit einem Obstpfluecker eine schoene saftige Birne. \n");
      anz_obst_hoch--;
      return 1;	
	  }
}

string unt_obst(string str)
{
	if(anz_obst == 0) return "Es sind keine Birnen in Reichweite zum Pfluecken. \n";
	if(anz_obst == 1) return "Es ist noch eine Birne in Reichweite zum Pfluecken. \n";
	return "Es sind noch "+anz_obst+" Birnen in Reichweite zum Pfluecken. \n";
}
