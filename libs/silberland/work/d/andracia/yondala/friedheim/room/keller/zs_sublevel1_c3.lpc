#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

int ring_vorhanden;

void reset()
{
  int zufall;
  ::reset();
  RemoveCmd( ({"nimm", "nehme"}) );
  RemoveDetail( ({"ring"}) );
  zufall = random(10);
  if(zufall == 0) ring_vorhanden = 1;
  else ring_vorhanden = 0;
}

void create() 
{
  ::create();

  ring_vorhanden = 0; 
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Ein menschliches Skelett liegt hier zwischen den Stalagmiten. "));
  
  AddDetail( ({ "skelett", "seele", "ungluecklicher", "ungluecklichen" }),
  BS("Das Skelett scheint hier schon sehr lange zu liegen. Auf den bleichen Knochen "+
  "hat sich schon eine ganz kleine Schicht Kalk angelagert. Von Kleidung oder "+
  "Ausruestung des Ungluecklichen ist nichts mehr zu sehen. "));
  AddDetail( ({ "kleidung" }),
  BS("Die Kleidung scheint schon lange verrottet. Nur noch die blanken Knochen "+
  "sind zu sehen. "));
  AddDetail( ({ "ausruestung" }),
  BS("Keinerlei Ausruestung kannst Du an dem Skelett sehen. Entweder hatte diese "+
  "arme Seele nichts bei sich gehabt das die Zeit uebersteht oder jemand anders "+
  "war vor Dir hier und hat alles schon an sich genommen. "));
  
  AddSpecialDetail( ({ "knochen" }), "finde_ring" );
  AddSpecialDetail( ({ "zeit" }), "unt_zeit");

  AddExit( "norden", KELLER + "zs_sublevel1_c2.lpc" );
  AddExit( "osten", KELLER + "zs_sublevel1_d3.lpc" );
  AddExit( "sueden", KELLER + "zs_sublevel1_c4.lpc" );
  
  AddItem( NPC + "kellermonster_kaefer.lpc", REFRESH_DESTRUCT );

}

string unt_zeit()
{
	return "Es ist jetzt "+ctime(time())+"\n";
}	

string finde_ring()
{
  if( ring_vorhanden == 1 ) {
    AddCmd( ({ "nimm", "nehme" }), "nehme_ring" );
    AddDetail( ({ "ring" }),
    BS("Der Ring hat die Zeit ueberdauert und steckt immernoch auf dem knochigen Finger. "));
    return BS("Du findest nach genauerer Betrachtung des Skeletts an den Knochen "+
    "der linken Hand einen Ring der die Zeit unbeschadet ueberdauert hat. "); }
  else
    return BS("Alte bleiche Knochen. Was die arme Seele hier unten wollte kannst "+
    "Du leider nicht feststellen. ");
}

int nehme_ring(string str)
{
  int zufall;
  object ob;
  if( str != "ring") {
    notify_fail("Was willst Du nehmen? \n");
    return 0;
  }
  if( ring_vorhanden == 0) {
    notify_fail("Der Ring scheint nicht mehr da zu sein. \n");
    return 0;
  }
  if( TP->QueryProp(P_LEVEL) >= 8 ) {
    notify_fail("Der Ring scheint zu fest an den Knochen zu haengen. \n");
    return 0;
  }
  
  zufall = random(3);
  switch(zufall) {
  case 0: ob = clone_object(ARMOUR + "ring_3.lpc");
  case 1: ob = clone_object(ARMOUR + "ring_2.lpc");
  case 2: ob = clone_object(ARMOUR + "ring_1.lpc"); }
  ob->move(TP, M_GET); 
  write("Du ziehst den Ring vom knochigen Finger des Skeletts. ");
  say(TPN + " zieht den Ring vom knochigen Finger des Skeletts. ");
  ring_vorhanden = 0;
  RemoveCmd( ({"nimm", "nehme"}) );
  RemoveDetail( ({"ring"}) );
  return 1;
}
