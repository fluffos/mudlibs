// 26.02.2019 Yondala@SilberLand



#include "../def.h"
inherit "std/room";
#include <properties.h>
int korn;

void reset()
{
	::reset();
	korn =random(5)+10;
}

void create() 
{
  ::create();
  korn =random(5)+10;
  SetProp( P_INT_SHORT, "In einem Stall" );
  SetProp( P_INT_LONG,
    "Du betrittst einen Stall und wirst fast erschlagen vom Geruch der Dir "
    "entgegen weht. Aus den Tueren zu den einzelnen Pferdeboxen, welche im Osten liegen dringt " 
		"Dir ein Wiehern entgegen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  AddDetail( ({ "stall" }),
    "Du betrittst einen Stall und wirst fast erschlagen vom Geruch der Dir "
    "entgegen weht. Von hinter den Tueren zu den einzelnen Pferdeboxen, welche im Osten liegen dringt " 
		"Dir ein Wiehern entgegen.");
  AddDetail( ({ "tueren" }),
    "Du siehst mehrere Tueren, die offenbar zu den Boxen fuehren. Sie sind allerdings fest verriegelt.");
  AddDetail( ({ "riegel" }),
    "Die Tueren sind fest verriegelt.");
  AddDetail( ({ "pferdebox", "box","pferdeboxen","boxen"  }),
    "In den Pferdeboxen stehen vermutlich Pferde, Du kannst sie wiehern hoeren.");
  AddDetail( ({ "pferde", "pferd" }),
    "Sehen kannst Du keine, aber sie sind bestimmt in den Boxen, Du kannst sie hoeren.");
  AddDetail( ({ "osten" }),
    "Im Osten des Stalls liegen die Pferdeboxen.");

  AddDetail( ({ "geruch" }),
    "Den kann man riechen."); 
  AddDetail( ({ "pferdeaepfel" }),
    "Hier liegen einige Pferdeaepfel herum. Einer ist besonders gross.");
  AddDetail( ({ "einer", "etwas" }),
    "Gib Dir mal ein bisschen mehr Muehe.");
  AddDetail( ({ "muehe" }),
    "Na, so leicht wird es Dir nicht gemacht.");
  AddDetail( ({ "pferdeapfel","apfel" }),
    "In dem besonders grossen Apfel schimmert etwas.");
  AddDetail( ({ "schimmern" }),
    "Was es wohl ist? Sieht aus wie ein kleiner Metallgegenstand.");
  AddDetail( ({ "metallgegenstand", "gegenstand" }),
    "Sieht aus, als handele es sich um ein paar Sporen, die wohl ein Reiter verloren hat."); 
  AddDetail( ({ "sporen" }),
    "Glitzernd... sobald man sie vom Mist befreit hat. Du koenntest versuchen, sie herauszuziehen."); 

  AddDetail( ({ "wiehern" }),
    "Das kann vermutlich eher hoeren als sehen."); 
  AddDetail( ({ "boden" }),
    "Der Boden ist dreckig und voller Pferdeaepfel und Stroh. Hier hat wohl laenger niemand sauber gemacht."); 
  AddDetail( ({ "waende", "wand" }),
    "An den Waenden siehst Du sehr viele Haken, an denen allerlei Utensilien haengen. An einer Wand ist ein Becken angebracht."); 
  AddDetail( ({ "utensilien" }),
    "Alle moeglichen Dinge, die man zur Pferdepflege benoetigt."); 
  AddDetail( ({ "haken" }),
    "Kraeftige Haken sind an den Waenden angebracht worden.");
  AddDetail( ({ "pferdepflege","pflege" }),
    "Du bist nun aber nicht hier um ein Pferd zu pflegen, oder?");
  AddDetail( ({ "becken" }),
    "Was da wohl drin ist? Du koenntest Dich ueber den Rand lehnen um mehr zu sehen.");
  AddDetail( ({ "rand", "beckenrand" }),
    "Das Becken hat einen Rand, ja.");
  AddDetail( ({ "dinge" }),
    "Alles moegliche. Viele davon kennst Du gar nicht.");
  AddDetail( ({ "getreidekoerner","koerner" }),
    "Davon sind ein paar in dem Becken an der Wand. Wenn Du eines moechtest musst Du Dich zu "
    "ihm strecken.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht wie alles hier in diesem Stall aus Holz. Sie ist so dicht, dass sie den "
    "Regen abwehrt, aber leider auch den Geruch davon abhaelt nach draussen abzuziehen."); 
  AddDetail( ({ "holz" }),
    "Das Holz ist trocken, aber noch nicht morsch. Es ist in einem guten Zustand."); 
  AddDetail( ({ "zustand" }),
    "Das beruhigt Dich, denn so kannst Du sicher sein, dass der Stall nicht einfach ueber Dir "
    "zusammenbricht."); 
  AddDetail( ({ "regen" }),
    "Ob es gerade regnet kannst Du von hier aus nicht sehen. Als Du den Stall betreten hast schien "
    "jedenfalls die Sonne."); 
  AddDetail( ({ "sonne" }),
    "Waere ganz schoen eng hier, wenn die sich mit Dir und den Pferden in den Stall quetschen "
    "wuerde, findest Du nicht?"); 
  AddDetail( ({ "stroh" }),
    "Das Stroh ist braeunlich gelb und sollte mal ausgewechselt werden."); 
  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du ein Wiehern oder ein Schnauben hinter den Tueren.");
  AddSound( ({ "wiehern" }),
    "Das Wiehern klingt kraeftig und gesund. Es scheinen gute Pferde in den Boxen zu stehen.");
  AddSound( ({ "schnauben" }),
    "Das Schnauben klingt ein wenig gelangweilt.");
  AddSound( ({ "pferd","pferde" }),
    "Es muessen mehrere Pferde sein, denn Du hoerst Wiehern in verschiedenen Tonlagen.");
  AddSound( ({ "tonlagen" }),
    "Mal hoeher, mal tiefer.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Pferdeaepfeln.");

  AddSmell( ({ "pferdeaepfel", "aepfel" }),
    "Sie riechen frisch.");
  AddSmell( ({ "geruch" }),
    "Es riecht nach Stroh und Pferdemist.");
  AddSmell( ({ "pferdemist", "mist" }),
    "Ueberall siehst und vorallem riechst Du Pferdeaepfel.");
  AddSmell( ({ "stroh" }),
    "Du schnupperst am Stroh und bist ein bisschen angewiedert. Vom Stroh und von Dir, weil Du nicht nachdenkst und ekeligen Dingen viel zu nah kommst.");
  AddSmell( ({ "dinge" }),
    "Aber was tut man nicht alles, fuer einen Forscherpunkt?");
  AddSmell( ({ "forscherpunkt" }),
    "Da hier keiner ist, kannst Du natuerlich auch nicht an einem Forscherpunkt riechen. Schade.");	

  AddRoomMessage( 
    ({"Du hoerst ein lautes Wiehern.\n",
    	"Hinter einer Box schnaubt ein Pferd.\n"}),30);


  AddCmd(({"wechsel","wechlse"}), "wechseln"), 
  AddCmd(({"ziehe","zieh"}), "ziehen"), 
  AddCmd(({"lehne","lehn"}), "lehnen"), 
  AddCmd(({"strecke","streck"}), "strecken"), 


  AddItem("/d/andracia/yondala/wasser/pirateninsel/npc/pferdeknecht.lpc",REFRESH_DESTRUCT);
  AddExit( "norden", DORF + "friedheim_dorf_d6.lpc" ); 

}  
 
int wechseln(string str)
{
	notify_fail("Was moechtest Du wechseln?\n");
	if (str=="stroh"||str=="stroh aus")
		{
			write("Dafuer ist der Knecht zustaendig.\n");
			return 1;
		}
	return 0;
}

int ziehen(string str)
{
	notify_fail("Was moechtest Du woraus ziehen?\n");
	if(str=="spore aus apfel"||str=="spore aus pferdeapfel"||
		 str=="spore aus apfel raus "||str=="spore aus pferdeapfel raus"||
		 str=="spore aus apfel heraus"||str=="spore aus pferdeapfel heraus"||
		 str=="sporen aus apfel"||str=="sporen aus pferdeapfel"||
		 str=="sporen aus apfel raus "||str=="sporen aus pferdeapfel raus"||
		 str=="sporen aus apfel heraus"||str=="sporen aus pferdeapfel heraus")
		 {
		 	if(TP->FindPotion("Du ziehst an dem Metallgegenstand und haelst ploetzlich einen kleinen Zaubertrank in der Hand.\n")) return 1;

			write("Du ziehst an der vermeintlichen Spore, als sie fast draussen ist erkennst Du, dass es doch nur ein normaler Metallsplitter ist. Enttaeuscht schiebst Du ihn wieder in den Pferdeapfel.\n");
			say(TPN+" fummelt an den Pferdeaepfeln herum.\n",TP);
			return 1;
		}
	return 0;	
}
						
int lehnen(string str)
{
	notify_fail("Worueber moechtest Du Dich lehnen?\n");
	if (str!="ueber rand") return 0;
	
	write("Du lehnst Dich ueber den Beckenrand und siehst auf dessen Grund ein paar Getreidekoerner liegen.\n");
	say(TPN+ " lehnt sich ueber den Rand des Beckens.\n",TP);
	return 1;
}

int strecken(string str)
{
	notify_fail("Wohin moechtest Du Dich strecken?\n");
	if (str=="ueber rand"|| str=="ueber beckenrand"|| str=="zum korn"|| str=="zum getreidekorn"|| str=="zu korn"|| 
		  str=="zu getreidekorn"|| str=="zu getreidekoerner"|| str=="zu koerner"|| 
		  str=="zu getreidekoernern"|| str=="zu koernern"||str=="zum korn"||
		  str=="zum getreidekorn hin"|| str=="zu korn hin"|| 
		  str=="zu getreidekorn hin"|| str=="zu getreidekoerner hin"|| str=="zu koerner hin"|| 
		  str=="zu getreidekoernern hin"|| str=="zu koernern hin")
	{ 
		if(korn)
			{
					write("Du streckst Dich so lang Du kannst und erwischst tatsaechlich ein kleines Korn.\n");
					say(TPN+ " streckt sich ueber den Beckenrand und nimmt sich etwas.\n",TP);
					CLONE(OBJ +"korn.lpc", TP);
					korn--;
			}
		else
			{
					write("Du streckst Dich so lang Du kannst, leider erreichst Du kein Korn. Du musst wohl warten, bis welche nachgefuellt werden.\n");
					say(TPN+ " streckt sich ueber den Beckenrand.\n",TP);
			}
		return 1;
	}
	return 0;
}	
	
	