#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT , "Kerker von Friedheim" );

  AddDetail( ({ "boden" }),
    BS("Unrat und Felsen bilden den Boden des Kerkers. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke besteht aus behauenem Fels. "));    
  AddSound( DEFAULT_SOUND,
    BS("Du hoerst nichts Besonderes. "));  
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier sehr muffig. "));  
  
  AddDetail( ({ "keller", "etage", "raum" }),
    BS("Du befindest dich im Kerker der Burg. "));
  AddDetail( ({ "arbeitszimmer" }),
    BS("Das Arbeitszimmer des Freiherrn befindet sich in der 2ten Etage. "));
  AddDetail( ({ "kerker", "kerkerzelle", "kerkerzellen" }),
    BS("Ein kleiner, rechteckiger Raum. Der blanke, behauene Fels reicht bis unter "+
    "die Decke. Die Decke selbst besteht auch aus behauenem Fels. Metallene Oesen "+
    "sind in der Wand eingelassen. Delinquenten koennen daran festgekettet werden.  "));
  AddDetail( ({ "friedheim", "burg" }),
    BS("Du befindest dich im Kerker der Burg. "));
  AddDetail( ({ "fels", "felsen" }),
    BS("Der blanke, behauene Fels reicht bis unter die Decke. "));
  AddDetail( ({ "halterung" }),
    BS("In diese Halterung passt hervorragend eine Fackel um bestaendig den Gang "+
    "zu erhellen. Du kannst ja versuchen die Fackel heraus zu ziehen - sofern eine "+
    "Fackel vorhanden ist. "));
  AddDetail( ({ "diebe", "moerder", "delinquenten", "verbrecher", "schuldiger", "schuldige", "schuldigen" }),
    BS("Wenn der Freiherr waehrend seiner Rechtsprechung den Schuldigen zum Kerker "+
    "verurteilt so landet dieser hier und wird in den Kerkerzellen festgekettet."));
  AddDetail( ({ "freiherr", "burgherr" }),
    BS("Der Freiherr ist gerade nicht anwesend. Versuchs doch mal in seinem "+
    "Arbeitszimmer in der 2ten Etage."));
  AddDetail( ({ "rechtsprechung", "recht" }),
    BS("Der Freiherr ist hier dafuer zustaendig Recht zu sprechen. "));
  AddDetail( ({ "tueren", "tuer" }),
    BS("Die Tuer auf den Gang hinaus ist offen."));
  AddDetail( ({ "gang" }),
    BS("Durch die Tuer im Norden kommt man wieder auf den Gang hinaus."));
  AddDetail( ({ "oesen" }),
    BS("An den Oesen kann man die Ketten befestigen die die Delinquenten fesseln. "));
  AddDetail( ({ "wasser", "brot" }),
    BS("Bei Brot und Wasser muessen die Verbrecher hier darben."));
  AddDetail( ({ "ketten", "fesseln" }),
    BS("Mit Ketten werden die Verbrecher gefesselt und hier angekettet."));
  AddDetail( ({ "unrat", "stroh" }),
    BS("Dreckiges Stroh liegt auf dem Boden und die kleinen schwarzen Kugeln sehen wie Rattenkot aus - IGITT!"));
  AddDetail( ({ "kot", "rattenkot", "kugeln", "kugel" }),
    BS("Diese kleinen schwarzen Kugeln sind ekel erregend. Scheinbar knabbern auch Ratten an den Schuldigen."));
  AddDetail( ({ "ratten", "ratte" }),
    BS("Du kannst keine entdecken, aber geben muss es sie hier unten scheinbar schon."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/
}  
  