#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void init() {
  object ob;
  int zufall;
  ::init();
  if( TP && interactive(TP) && TP->QueryProp(P_LEVEL) >= 5 && 
    TP->QueryProp(P_LEVEL) <= 10 && !present("wegelagerer") ) {
    zufall = random(200); 
    if( zufall == 0 ) {
//       write(BS("Ein Wegelagerer springt dir in den Weg!"),
      ob = clone_object(NPC+"wegelagerer.lpc");
      ob -> move( TO, M_GO, "", "", "springt Dir in den Weg!" );
      ob -> attack(TP);
    }
  }
}


create() {
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Friedheim" );
  SetProp( P_INT_LONG,
    "Dies ist der Weg nach Friedheim. Die gepflasterte Strasse schlaengelt sich "+
    "in einem grossen Bogen zum Dorf bei Burg Friedheim. Der Wald liegt weiter "+
    "im Sueden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern.");
  AddSound( ({ "zwitschern", "voegel" }),
    "Sehr nett.");
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse");
  AddSmell( ({ "strasse", "asphalt", "gummi", "geruch" }),
    "Also nach Asphalt und Gummi wird es nicht riechen.");

  AddDetail( ({ "strasse", "weg", "pflaster", "boden" }),
    "Der Weg ist mit groben Steinen gepflastert.");
  AddDetail( ({ "burg", "friedheim" }),
    "Eine maechtige Burg. Sie thront ueber dem gleichnamigen Dorf auf einer \n"
    "Anhoehe. Sie ist noch ein weit entfernt.");
  AddDetail( ({ "dorf", "stadt", "gruppe" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. \n"
    "Der Weg fuehrt direkt zum oestlichen Eingang der Stadt.");
  AddDetail( ({ "eingang", "tor" }),
    "Das Tor scheint offen zu sein.");
  AddDetail( ({ "wald" }),
    "Der Wald befindet sich im Sueden.");
  AddDetail( ({ "huegel" }),
    "Leicht geschwungen und mit kurzem Gras bewachsen");
  AddDetail( ({ "steine" }),
    "Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche.");
  AddDetail( ({"anhoehe"}), BS(
    "Die Burg Friedheim ist auf einer kleinen Anhoehe erbaut, das kann man "+
    "von hier erkennen." ));
  AddDetail( ({"bogen"}), BS(
    "Der Weg beschreibt einen Bogen." ));
  AddDetail( ({"haeuser", "stadtmauer"}), BS(
    "Von hier aus? Sicher nicht!" ));
  AddDetail( ({"himmel", "wetter"}), BS(
    "Tiefblau verspricht der Himmel gutes Wetter fuer die naechsten Tage." ));
  AddDetail( ({"kutsche", "transport"}), BS(
    "Hin und wieder kommt die Kutsche hier vorbei." ));

  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 210 );

/*
  AddDetail( ({""}), BS(
    "" ));
*/

  AddExit( "nordosten", WEGE + "weg_zum_dorf_d5" );
  AddExit( "sueden", WEGE + "weg_zum_dorf_c7" );
}


