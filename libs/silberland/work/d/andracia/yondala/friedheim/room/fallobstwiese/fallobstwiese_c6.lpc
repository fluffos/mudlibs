#include "../def.h"

inherit WIESE+"fallobstwiese_raw.lpc";

#include <properties.h>
#include <language.h>

int anz_obst, anz_obst_hoch;

void reset()
{
  if( anz_obst < 4 ) anz_obst++;
  if( anz_obst_hoch < 6 ) anz_obst_hoch++;
	::reset();
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
    BS("Ein Pflaumenbaum steht hier."));
  
  AddDetail( ({"pflaumenbaum"}),
    BS("Der Pflaumenbaum hat viele reife Pflaumen die man pfluecken kann. "+
    "Etwas hoeher am Baum haengen noch weitere Pflaumen ausserhalb der Reichweite deiner Arme. " ) );
  AddDetail( ({ "arme" }),
    BS("Zum Glueck hast Du welche."));
  AddDetail( ({ "glueck" }),
    BS("Ist es Dir heute hold?"));
  AddDetail( ({ "reichweite" }),
    BS("Mit einem Obstpfluecker kann man die Reichweite erhoehen. "));
  AddDetail( ({ "obstpfluecker" }),
    BS("Vielleicht hat ja Erna Kollwanst noch einen. "));
  
  AddSpecialDetail( ({"pflaume", "pflaumen" }), "unt_obst");
  
  AddCmd( ({"pflueck", "pfluecke"}), "pflueck_obst");
  
  AddExit( "norden", WIESE + "fallobstwiese_c5.lpc" );

  anz_obst = 4;
  anz_obst_hoch =6;

}


int pflueck_obst(string str)
{
	object ob;
	string was, womit;
        notify_fail("Was willst Du pfluecken? \n");
        if( !str ) return 0;
	if( sscanf(str, "%s mit %s", was, womit) != 2) 
		{
		  notify_fail("Was willst Du pfluecken? \n");
	    if( str!="obst" && str!="pflaume" && str!="pflaumen" ) return 0;
	    notify_fail("Es gibt gerade keine reifen Pflaumen in Reichweite. \n");
	    if( anz_obst == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_pflaumen.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst eine handvoll Pflaumen. \n");
      say(TPN + " pflueckt eine handvoll Pflaumen. \n");
      anz_obst--;
      return 1;
    }
	else
		{
		  notify_fail("Was willst Du pfluecken? \n");
	      if( was!="obst" && was!="pflaume" && was!="pflaumen" ) return 0;
	    
		  notify_fail("Damit kannst Du keine Pflaumen pfluecken. \n");	
	      if( womit!="obstpfluecker" && womit!="pfluecker" ) return 0;
	   
	      notify_fail("Das hast Du nicht bei Dir. \n");
	      if( !present("\nobstpfluecker", TP) ) return 0;
		  
		  notify_fail("Es gibt gerade keine reifen Pflaumen in erweiterter Reichweite. \n");    	
	     if( anz_obst_hoch == 0 ) return 0;
  	  ob= clone_object(OBJ + "obst_pflaumen.lpc");
	    if( ob->move(TP,M_GET) != 1) ob->move(environment(TP),M_SILENT);
      write("Du pflueckst mit dem Obstpfluecker eine handvoll Pflaumen. \n");
      say(TPN + " pflueckt mit einem Obstpfluecker eine handvoll Pflaumen. \n");
      anz_obst_hoch--;
      return 1;	
	  }
}

string unt_obst(string str)
{
	if(anz_obst == 0) return "Es sind keine Pflaumen in Reichweite zum Pfluecken. \n";
	if(anz_obst == 1) return "Es ist noch eine handvoll Pflaumen in Reichweite zum Pfluecken. \n";
	return "Es sind noch "+anz_obst+" handvoll Pflaumen in Reichweite zum Pfluecken. \n";
}
