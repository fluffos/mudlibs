//23.2.2019 Yondala@SilberLand funktioniert
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Torhaus" );
  SetProp( P_INT_LONG,
    BS("Du stehst im Tor des Torhauses der Burg Friedheim. Ueber "+
    "die Zugbruecke im Sueden kannst Du zurueck auf den Weg Richtung Dorf. "+
    "Das grosse Tor ist geoeffnet und im Norden beginnt der Burghof. ") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"decke"}), 
  "Du erkennst hoch ueber dir eine gewoelbte steinerne Decke. \n"
  );
  AddDetail( ({ "pflaster", "boden" }),
  "Der Boden ist mit groben Steinen gepflastert. \n");
  AddDetail( ({ "steine" }),
  BS("Dieses steinerne Gebaeude scheint die Arbeit von faehigen Steinmetzen zu sein. "));
  AddDetail( ({"waende", "wand"}), 
  "Die Waende bestehen aus groben Steinen. \n");
  AddDetail( ({"torhaus", "gebaeude"}), 
  BS("Dieses steinerne Torhaus scheint der einzige Zugang zur Burg. "));
  AddDetail( ({"burg", "friedheim"}), 
  BS("Du kannst schon sehr viel vom Burghof erkennen. Das Tor steht offen und man kann "+
  "ungehindert auf den Burghof hinaus. "));
  AddDetail( ({"zugbruecke"}), 
  BS("Die Zugbruecke ist herabgelassen. Du kannst von hier aus ueber die Zugbruecke die Burg verlassen. "));
  AddDetail( ({"weg"}), 
  BS("Der Weg der nach der Zugbruecke beginnt scheint zum Dorf zu fuehren."));
  AddDetail( ({"dorf"}), 
  BS("Das Dorf kannst Du von hier aus nicht sehen."));
  AddDetail( ({"tor", "tuer", "zugang", "eingang"}), 
  BS("Das große Tor, welches zusaetzlich zur Zugbruecke den Eingang zur Burg verschliessen kann, ist offen."));
  AddDetail( ({"burghof", "hof"}), 
  BS("Gleich im Norden kannst Du den Burghof erkennen. Er scheint sich weiter nach Nordosten auszudehnen."));
  AddDetail( ({ "arbeit", "steinmetze" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({"voegel"}),
  BS("Es sind hier keine Voegel zu sehen."));
  AddSound( DEFAULT_SOUND, "Ein paar Voegel zwitschern.");
  AddSound( ({ "zwitschern", "voegel" }), "Sehr nett.");
  AddSmell( DEFAULT_SMELL, "Du kannst nichts besonderes riechen.");

 
// END DETAILS
  AddExit( "norden", BURG + "zs_burg_eg_b3" );
  AddExit( "sueden", BURG + "zs_burg_eg_b5" );
  // END EXITS
}


