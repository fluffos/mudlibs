inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Wehrgang" ); 
  SetProp( P_INT_LONG,  
  BS("Du stehst auf dem Wehrgang der Burg Friedheim. "+
  "Ueber die Zinnen hinweg hat man in suedoeslicher Richtung eine gute Aussicht ueber das umliegende Huegelland. "+
  "Der Burghof erstreckt sich hier von suedwesten bis nordosten. Im Norden geht der Wehrgang weiter. Im Sueden "+
  "kannst Du einen Turm betreten. "));
    
  /* Standartdetails */
  AddDetail( ({ "himmel", "wetter" }),  
  BS("Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "boden", "burghof", "hof" }),
  "Der Boden ist mit groben Steinen gepflastert. "  );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke", "stein", "steine" }),
  BS("Die steinernen Aussenwaende des Bergfrieds und der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. "));
  AddSound( DEFAULT_SOUND,
  "Aus dem Suedosten dringen Arbeitsgeraeusche eines Schmiedes an Dein Ohr. " );
  AddSmell( DEFAULT_SMELL,
  "Du kannst nur den leichten Geruch einer Feuerstelle wahrnehmen. " );
  AddSmell( ({ "geruch" }),
  BS("Rauch und heisses Eisen kann man hier riechen."));
  AddSmell( ({ "rauch", "eisen" }),
  BS("Aus der Schmiede kommt dieser Geruch."));
   
  AddDetail( ({ "friedheim", "burg" }),
  "Du stehst doch mitten in der Burg zu Friedheim. "  );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt solch ein wehrhaftes Gebaeude zu bauen. "));
  AddDetail( ({ "bauwerk", "gebaeude" }),
  "Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. " );
  AddDetail( ({ "innere" }),
  "Du musst durch die Tuer im Sueden schreiten um das Innere des Turms zu erkunden. " );
  AddDetail( ({ "turm", "tuerme" }),
  "Das Innere des Turms kannst Du durch eine Tuer erreichen. "  );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weisse Schaefchenwolken. " );
  AddDetail( ({ "hoehe", "stockwerke" }),
  BS("Der Bergfried hat wohl vier Stockwerke. Die oberste Kante ist mit Zinnen bewehrt. "));
  AddDetail( ({ "grundriss", "seite" }),
  "Annaehernd quadratisch nimmst Du an. Eine Seite misst so 50 Schritt. "  );
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "+
  "Du stehst auf einem solchen. "));
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "dach" }),
  "Dazu musst Du erst einmal aufs Dach um das zu tun. " );
  AddSmell( ({ "feuerstelle" }),
  "Rauch eben. " );
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  BS("Das typisch metallisch klingenden Geraeusch wenn ein Hammer warmes Eisen auf dem Amboss trifft. "));
  AddDetail( ({ "richtung" }),
  BS("Was fuer eine Richtung auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "huegelland", "aussicht", "ueberblick" }),
  BS("Soweit das Auge reicht kannst Du nur fruchtbares Huegelland um die Burg herum erkennen."));
  AddDetail( ({ "burghof", "hof" }),
  BS("Vom Wehrgang aus hat man einen sehr guten Ueberblick auf den Burghof. "));
  AddDetail( ({ "burgmauer" }),
  BS("Du stehst im Grunde auf dem oberen Abschluss der Burgmauer die hier den Wehrgang bildet."));
  AddDetail( ({ "belagerung" }),
  BS("Zur Zeit ist keine Belagerung im Gange."));
  AddDetail( ({ "abschluss" }),
  BS("Der obere Abschluss der Burgmauer ist mit Zinnen bewehrt."));
  AddDetail( ({ "amboss", "hammer", "eisen" }),
  BS("Das kann man in der Schmiede finden."));
  AddDetail( ({ "schmiede" }),
  BS("Die Schmiede befindet sich auf dem Burghof."));
  AddDetail( ({ "tuer" }),
  BS("Die hoelzerne Tuer im Norden fuehrt in den Turm. Sie steht offen."));

  // END DETAILS
  AddExit( "norden", BURG + "zs_burg_og1_c3" );
  AddExit( "sueden", BURG + "zs_burg_og1_c5" );

  // END EXITS
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgschuetze.lpc", REFRESH_DESTRUCT );
}
