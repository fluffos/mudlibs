  SetProp (P_INT_SHORT, "Geheimraum");
  SetProp (P_INT_LONG,
    "");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("osten", BURG "zs_burg_og2_b1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
