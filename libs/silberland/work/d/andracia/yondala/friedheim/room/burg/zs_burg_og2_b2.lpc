inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Treppenhaus des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds zu Friedheim. "+
  "Im Westen scheint das Gemach der Herrschaft zu liegen. Im Norden befindet sich das "+
  "Arbeitszimmer des Burgherrn. Portraits schmuecken hier die Waende. "));
  
  /* Standartdetails */ 
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus massiven Holzbohlen.");
  AddDetail( ({ "waende", "steinwaende" }),
  BS("Die Waende sind alle aus Stein. Portraits wurden hier entlang der Treppe aufgeaengt. "));
  AddDetail( ({ "nordwand" }),
  BS("Hier ist eine Tuer zum Arbeitszimmer des Burgherrn. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "suedwand" }),
  "Die Portraits hier zeigen die Vorfahren derer zu Friedheim. \n");
  AddDetail( ({ "ostwand" }),
  "Die Portraits hier zeigen die Vorfahren derer zu Friedheim. \n");
  AddDetail( ({ "westwand" }),
  BS("Hier ist eine Tuer zu einem Gemach. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddSound( DEFAULT_SOUND,
  "Es sind keine besonderen Geraeusche zu hoeren.");
  AddSmell( DEFAULT_SMELL,
  "Du kannst nichts besonderes riechen.");
  AddSound( ({"geraeusche", "knarren"}),
  "Nur das Knarren der Holzbohlen ist zu hoeren.");
  
  
  /* extra Details */ 
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "portraits", "bilder", "kunstwerke" }),  
  BS("Die in schoenen Bilderrahmen gefassten Portraits hier zeigen die Vorfahren derer zu Friedheim. \n"));
  AddDetail( ({ "stein", "steine" }),  
  BS("Massive Steinwaende, die auch mehrere Treffer vom Katapult aushalten. "));
  AddDetail( ({ "treppe", "treppenhaus" }),  
  BS("Die Treppe fuehrt hier von oben nach unten durch den gesamten Bergfried. "));
  AddDetail( ({ "gemach", "arbeitszimmer", "raeume" }),  
  "Geh doch einfach in einen der Raeume, um diesen zu untersuchen. \n");
  AddDetail( ({ "vorfahren" }),  
  BS("Alle schon laengst tot und nur noch diese Portraits erinnern an sie. "));
  AddDetail( ({ "tuer" }),
  "Alle Tueren hier sind aus starken Holzbohlen gefertigt. \n");
  AddDetail( ({ "holzbohlen", "bohlen"  }),  
  BS("Tueren und Boden bestehen aus massiven Holzbohlen. "));
  AddDetail( ({ "treppe" }),
  "Die Treppe fuehrt hier weiter noch oben und unten. \n");
  AddDetail( ({ "rahmen", "bilderrahmen" }),
  "Alle Bilderrahmen sind selbst schon filigran geschnitzte Kunstwerke.");
  AddDetail( ({ "herrschaft", "burgherr", "freiherr" }),
  "Der Freiherr von Friedheim ist hier der Burgherr.");
  AddDetail( ({ "wand", "steinwand"}),
  BS("Welche Wand willst Du denn untersuchen? Die Nordwand, Ostwand, Suedwand oder Westwand? "));
  
/*
  AddDetail( ({ "" }),
  BS(""));
*/
  
  // END DETAILS
  AddExit( "oben", BURG + "zs_burg_og3_b2.lpc" );
  AddExit( "westen", BURG + "zs_burg_og2_a2.lpc" );
  AddExit( "norden", BURG + "zs_burg_og2_b1.lpc" );
  AddExit( "unten", BURG + "zs_burg_og1_b2.lpc" );
   
  // END EXITS
  // AddItem( "file", refresh, Props);
   
}

