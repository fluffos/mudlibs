#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

int anz_moos;

void reset()
{
  ::reset();
  if(anz_moos < 6) anz_moos++;   
}

void create() 
{
  ::create();
  anz_moos = 6;

  SetProp( P_LIGHT, 1);
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Durch ein kleines Loch in der Decke dringt ein bischen Licht hier herein. "+
  "Ein bischen Moos hat sich hier durch das Licht gebildet. "));

  AddDetail( ({ "licht", "fackel", "lichtquelle" }),
  BS("Wenn Du Dich von hier aus weiter in die Hoehle umschauen willst, so brauchst Du eine "+
  "Lichtquelle, zum Beispiel eine Fackel. "));
  AddDetail( ({ "finsternis", "dunkel" }),
  BS("Ab hier herrscht absolute Finsternis in der Hoehle. Du brauchst eine Fackel "+
  "oder andere Lichtquelle um dich weiter zu wagen. "));  
  AddDetail( ({ "loch" }),
  BS("Ein kleines loch in der Decke laesst Licht herein. "));
  AddDetail( ({ "moose", "moos" }),
  BS("Das Moos hat nur hier etwas Licht gefunden um zu ueberlegen. Vielleicht ist "+
  "es ja essbar. "));
  AddDetail( ({ "beispiel" }),
  BS("Eine Fackel waere eine gute Lichtquelle hier unten."));


  AddCmd( ({"iss", "esse" }), "esse_moos" );

  AddExit( "westen", KELLER + "zs_sublevel1_f2.lpc" );
  AddExit( "sueden", KELLER + "zs_sublevel1_g3.lpc" );
  
  AddItem( NPC + "kellermonster_maus.lpc", REFRESH_DESTRUCT );


}

int esse_moos(string str)
{ 
  if( str != "moos" && str != "moose") {
    notify_fail("Was willst Du essen? \n");
    return 0;
  }
  if( anz_moos == 0) {
    notify_fail("Das Moos ist viel zu wenig zum essen. Warte bis sich neues bildet. \n");
    return 0;
  }
  if( TP->QueryProp(P_LEVEL) >= 8 ) {
    notify_fail("Du laesst das Moos lieber fuer kleinere Spieler liegen. \n");
    return 0;
  }
  if(TP->eat_food(15)){
  write("Du isst etwas Moos. Das hilft gegen den Hunger! \n");
  say( TPN + " isst etwas Moos. \n");
  TP->AddHp(10);
  TP->AddSp(10);
  anz_moos--;}
  return 1;
}
