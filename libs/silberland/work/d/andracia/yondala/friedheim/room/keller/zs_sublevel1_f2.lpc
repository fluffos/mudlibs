#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

int ungeziefer_vorhanden;

void reset()
{
  ::reset();
  ungeziefer_vorhanden = random(2); 
}

void create() 
{
  ::create();

  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Ein loser Stein liegt hier auf dem Boden."));
  
  ungeziefer_vorhanden = random(2); 
  
  AddSpecialDetail( ({ "stein" }), "unt_stein" );
 
  AddExit( "nordwesten", KELLER + "zs_sublevel1_e1.lpc" );
  AddExit( "osten", KELLER + "zs_sublevel1_g2.lpc" );
  
}

string unt_stein()
{ 
  int zufall;
  write("Du schaust Dir den Stein an ... \n");
  if(ungeziefer_vorhanden == 0) return "Nichts besonderes zu sehen daran. \n";
  zufall = random(2);
  say(TPN+" hat Ungeziefer gefunden! \n");
  write(BS("Du hast Ungeziefer gefunden! \n"));
  if(zufall == 0) AddItem(NPC + "kellermonster_assel.lpc", REFRESH_NONE);
  else AddItem(NPC + "kellermonster_kaefer.lpc", REFRESH_NONE);
  ungeziefer_vorhanden = 0;
  return "";
}