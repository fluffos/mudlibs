#include "../def.h"

#include <properties.h>
#include <moving.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Suedlicher Teil der Bibliothek. ");
  SetProp (P_INT_LONG,
    "Du stehst im suedlichen Teil der Bibliothek. Viele Buecher stehen "+
    "hier in den hohen Regalen. Ueber eine kleine Treppe kann man hoeher "+
    "gelegene Buecherreihen erreichen.");

  AddDetail( ({ "decke" }),  
    "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus massiven Holzbohlen.");
  AddDetail( ({ "waende", "wand" }),
    BS("Von den steinernen Waenden kann man nur noch wenig erkennen. "+
    "Alle Waende sind mit Regalen vollgestellt. " ));
  AddSound( DEFAULT_SOUND,
    "Es sind keine besonderen Geraeusche zu hoeren. \n");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nichts besonderes riechen. \n");
  AddSound( ({ "geraeusche" }),
    "Nein, nichts zu hoeren - fast absolute Stille. \n");
  
  AddDetail( ({ "bibliothek", "reich" }),
    BS("Dies ist das Reich von Sindar Tucher, dem Bibliothekar. Allein schon die Menge an "+
    "Buechern ist atemberaubend. Falls Du auf das Wissen der Buecher zurueckgreifen willst, "+
    "so frag einfach Sindar, er wird Dir dann weiterhelfen. Die Bibliothek erstreckt sich "+
    "weiter nach Norden. "));
  AddDetail( ({ "buecher" }),
    BS("Sehr viele Buecher sind hier untergebracht. Frag Sindar, den Bibliothekar, wenn "+
    "Du was Besonderes suchst, er kann Dir sicher weiterhelfen. "));
  AddDetail( ({ "regale", "regalreihen" }),
    BS("An allen Waenden wurden Regale aufgebaut. Sie sind sehr stabil, damit sie die Menge "+
    "an Buechern tragen koennen. "));
  AddDetail( ({ "treppe" }),
    BS("Diese Treppe ist eigentlich eine verschiebbare Leiter mit 5 Sprossen. "+
    "Sindar Tucher kann daran hochsteigen, um Buecher der oberen Reihen zu erreichen. "));
  AddDetail( ({ "buecherreihen", "reihen" }),
    BS("Die Regale teilen die Buecher in Reihen auf. Fuer die oberen Reihen braucht man "+
    "eine kleine Treppe oder Leiter, um sie zu erreichen. "));
  AddDetail( ({ "holzbohlen", "bohlen"  }),  
    BS("Tueren, Regale und Boden bestehen aus massiven Holzbohlen. "));
  AddDetail( ({ "bibliothekar" }),
    BS("Sindar Tucher ist hier zustaendig. Er weiss ungewoehnlich  viel falls man irgendwelche Fragen hat."));
  AddDetail( ({ "leiter" }),
    BS("Die obersten Regalreihen kann man nur schwer erreichen, aber mit der Leiter hier ist das leicht."));
  AddDetail( ({ "menge" }),
    BS("Es gibt hier eine unglaubliche Menge an Buechern."));
  AddDetail( ({ "sprossen" }),
    BS("Die Leiter hat genau fuenf Sprossen."));
  AddDetail( ({ "stille" }),
    BS("dazu sollte man eher lauschen"));
  AddSound( ({ "stille" }),
    BS("Es ist ist still."));
  AddSpecialDetail( ({ "wissen" }), "det_getfp");
  AddDetail( ({ "teil" }),
    BS("Du stehst im suedlichen Teil der Bibliothek."));
  AddDetail( ({ "sindar", "tucher" }),
    BS("Sindar Tucher ist der Bibliothekar, der die Bibliothek pflegt."));
  AddDetail( ({ "tuer", "tueren" }),
    BS("Alle Tueren hier sind aus starken Holzbohlen gefertigt. "));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit ("osten", BURG "zs_burg_og3_b2");
  AddExit ("norden", BURG "zs_burg_og3_a1");

  AddItem( NPC + "sindar_tucher.lpc", REFRESH_DESTRUCT );

}

string det_getfp()
{
	return TP->Forschung();
}