//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Erdgeschoss des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  BS("Du befindest Dich im westlichen Teil der Haupthalle des Bergfrieds zu Friedheim. "+
  "Ein grosser, breiter Tisch ist in der mitte der Halle aufgebaut und lange Baenke stehen daran. "+
  "Hier wird wohl gefeiert wenn der Burgherr ein Fest gibt. In der Suedwand befindet sich eine grosse Tuer die direkt in die Kueche fuehrt. "+
  "An der Westwand stehen drei grosse Schraenke. Die Nordwand ist mit einer eindrucksvollen Waffensammlung behangen. "+
  "Die Halle selbst erstreckt sich weiter nach Osten."));
   
  /* Smells und Sounds */
  AddSound( DEFAULT_SOUND,
  BS("Es sind keine besonderen Geraeusche zu hoeren. "));
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nichts besonderes riechen. "));
  AddSound( ({ "geraeusche" }),
  BS("Es sind wirklich keine besonderen Geraeusche zu hoeren."));
  
  /* Details */ 
  AddDetail( ({ "decke" }),  
  BS("Die Decke ist mit blau gefaerbten Leinentuechern abgehaengt. Du nimmst an, dass die Decke auch hier aus Holz ist. "));
  AddDetail( ({ "boden" }),
  BS("Der Boden besteht aus glatten Steinen. "));
  AddDetail( ({ "waende", "wand" }),
  BS("Welche Wand willst Du untersuchen? Ost- West, Nord- oder Suedwand? "));
  AddDetail( ({ "nordwand" }),
  BS("Die Nordwand ist mit einer eindrucksvollen Waffensammlung behangen. "));
  AddDetail( ({ "ostwand" }),
  BS("Um die naechste Ostwand zu untersuchen solltest Du den oestlichen Teil der Haupthalle aufsuchen. "));
  AddDetail( ({ "suedwand" }),
  BS("In der Suedwand befindet sich eine grosse Tuer die direkt in die Kueche fuehrt. Rechts und links der Tuer sind Gemaelde aufgehaengt. "));
  AddDetail( ({ "westwand" }),
  BS("An der Westwand stehen drei grosse Schraenke. Darueber ist ein Regal angebracht auf dem viele verzierte Kruege stehen. "));
  AddDetail( ({ "erdgeschoss" }),  
  BS("Das Stockwerk das ebenerdig zum umliegenden Gelaende ist nennt man Erdgeschoss. "));
  AddDetail( ({ "stockwerk" }),  
  BS("Du befindest Dich im Erdgeschoss. "));
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich im Erdgeschoss des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "tisch" }),  
  BS("Bei Festen wird dieser Tisch wohl mit allerlei leckeren Speisen gedeckt sein. "+
  "gerade ist der Tisch aber abgeraeumt und nichts liegt darauf. "));
  AddDetail( ({ "baenke" }),  
  BS("Auf den Baenken haben viele Gaeste platz. Hier kann man gut Feste feiern. "));
  AddDetail( ({ "leinentuecher" }),  
  BS("Die Leinentuecher verstecken die Decke. Leider haengen sie zu hoch um sie naeher zu untersuchen. "));
  AddDetail( ({ "haupthalle", "halle" }),  
  BS("Du befindest Dich in der Haupthalle. "));
  AddDetail( ({ "tuer" }),  
  BS("Die grosse Tuer im Sueden fuehrt in die Kueche zurueck. "));
  AddDetail( ({ "gemaelde", "meisterwerke", "meisterwerk" }),  
  BS("Welches Gemaelde willst Du denn untersuchen? Das rechte oder das linke Meisterwerk? "));
  AddDetail( ({ "gemaelde rechts", "rechtes gemaelde" }),  
  BS("Dieses Gemaelde zeigt einen Magier beim Lesen eines dicken Buchs. "));
  AddDetail( ({ "gemaelde links", "linkes gemaelde" }),  
  BS("Dieses Gemaelde zeigt einen Krieger beim ueben mit Schwert und Schild. "));
  AddDetail( ({ "ecke" }),  
  BS("Welche Ecke willst Du denn untersuchen? "));
  AddDetail( ({ "suedwestliche ecke", "ecke suedwest", "ecke suedwesten" }),  
  BS("Eine uninteressante Ecke. Nur ein Winkel den Hier die Mauern bilden. "));
  AddDetail( ({ "nordwestliche ecke", "ecke nordwest", "ecke nordwesten" }),  
  BS("Eine uninteressante Ecke. Nur ein Winkel den Hier die Mauern bilden. "));
  AddDetail( ({ "gelaende" }),  
  BS("Das Gelaende ausserhalb der Burg ist huegellig. "));
  AddDetail( ({ "steine", "stein" }),  
  BS("Die Steine die den Boden bilden sind zwar kein Marmor aber bilden trotzdem eine sehr glatt Oberflaeche. "));
  AddDetail( ({ "marmor" }),  
  BS("Diese Halle mit Marmor auszulegen waere sehr kostspielig. "));
  AddDetail( ({ "oberflaeche" }),  
  BS("Schoen glatt! "));
  AddDetail( ({ "schraenke", "schrank" }),  
  BS("Welchen Schrank willst Du den untersuchen? Den rechts, den links oder den in der mitte? "));
  AddDetail( ({ "rechten schrank", "schrank rechts" }),  
  BS("Dieser Schrank enthaelt sehr viele Messingteller. Wenn man hier in der Halle ein Fest gibt "+
  "braucht man aber bestimmt die Haelte des hier untergebrachten Geschirrs. "));
  AddDetail( ({ "linken schrank", "schrank links" }),  
  BS("Dieser Schrank enthaelt sehr viele Messingkruege. Wenn man hier in der Halle ein Fest gibt "+
  "braucht man aber bestimmt die Haelte des hier untergebrachten Geschirrs. "));
  AddDetail( ({ "mittleren schrank", "schrank mitte" }),  
  BS("Dieser Schrank enthaelt sehr viele Schalen und Platten. Desweiteren hat es im unteren Fach "+
  "offene Holzkisten mmit Messern, Gabeln und Loeffel sowie Schoepfkellen. Wenn man hier in "+
  "der Halle ein Fest gibt braucht man aber bestimmt die Haelte des hier untergebrachten Geschirrs. "));
  AddDetail( ({ "regal" }),  
  BS("Das Regal wurde ueberhalb der Schraenke angebracht. "));
  AddDetail( ({ "krug", "kruege", "deckel" }),  
  BS("Die Kruege sind gut gearbeitete Meisterwerke. Viele mit einem hochklappbaren Deckel. Leider "+
  "stehen sie hoch auf einem Regal ueber den Schraenken und Du kommst nicht an sie heran. "));
  AddDetail( ({ "waffensammlung", "waffen", "hellebarden", "schwerter" }),  
  BS("Die Waffensammlung besteht aus vielen verschiedenen Waffen. Armbrueste, Hellebarden, Schwerter "+
  "und vieles mehr. Einige davon Meisterleistung der Schmiedekunst. Vielleicht belohnt Dich ja der "+
  "Burgherr mit einem dieser Schaetze, wenn Du ihm einen Dienst erweist. "));
  AddDetail( ({ "burgherr", "familie", "freiherr" }),  
  BS("Der Burgherr heisst Freiherr von Friedheim. Er hat eine sehr huebsche Gemahlin und eine Tochter. "));
  AddDetail( ({"gemahlin", "tochter", "burgfraeulein"}),
  BS("Du kannst die Burgfraeulein sicher in den oberen Stockwerken finden."));
  AddDetail( ({"gaeste", "gast"}),
  BS("Du selbst bist auch Gast hier."));
  AddDetail( ({ "fest" }),  
  BS("Es ist gerade keins im Gange. "));
  AddDetail( ({"holz"}),
  BS("Ganz normales Holz."));
  AddDetail( ({"kueche"}),
  BS("Dazu musst Du durch die Tuer im Sueden."));
  AddDetail( ({"schmeidekunst"}),
  BS("Frag doch den Burgschmied nach seinen Diensten."));
  AddDetail( ({"burgschmied", "yantur", "leisten"}),
  BS("Yantur Leisten ist sicher in seiner Schmiede auf dem Burghof zu finden."));
  AddDetail( ({"schmiede", "burghof"}),
  BS("Dazu musst Du erst den Bergfried wieder verlassen."));
  AddDetail( ({"meisterleistung", "leistung"}),
  BS("Du bist beeindruckt."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
  
  // Exits
  AddExit( "osten", BURG + "zs_burg_eg_b1.lpc" );
  AddExit( "sueden", BURG + "zs_burg_eg_a2.lpc" );

  // Items
  AddItem( NPC + "brin_roggenfeldt.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "vitus_gesse.lpc", REFRESH_DESTRUCT ); 
}

