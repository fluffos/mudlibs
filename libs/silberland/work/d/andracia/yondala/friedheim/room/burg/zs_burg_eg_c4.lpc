//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Turm" ); 
  SetProp( P_INT_LONG,  
  BS("Du bist im unteren Stockwerk des Turms. Eine hoelzerne Treppe fuehrt in obere Etage. "+
  "Dieser Raum wird wohl als Abstellkammer benutzt. Mehrere Kisten und Faesser stehen hier herum. "+
  "Im Norden fuehrt eine Tuer zurueck in den Burghof. "));
   
   /* Sounds und Smells */
  AddSound( DEFAULT_SOUND,
  BS("Du hoerst nichts besonderes. "));
  AddSmell( DEFAULT_SMELL,
  BS("Du riechst nichts besonderes. "));
   
  /* extra Details */
  AddDetail( ({ "decke" }),  
  BS("Die Decke ist sehr hoch. Sie besteht aus Holzbalken und Holzbohlen. Die Balken sind in der "+ 
  "steinernen Wand des Turm eingelassen. "));
  AddDetail( ({ "boden" }),
  BS("Der Boden besteht aus Holzbohlen. "));
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke" }),
  BS("Die Waende bestehen aus grossen Steinbloecken und scheinen die Arbeit von faehigen Steinmetzen zu sein. "+
  "Du kannst erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt hat diesen Turm zu errichten. "));
  AddDetail( ({ "friedheim", "burg" }),
  BS("Du bist doch schon in der Burg. "));
  AddDetail( ({ "balken", "bohlen", "holz", "holzbalken", "holzbohlen" }),
  BS("Boden und Decke sind aus Holz. Die Holzbohlen werden von Balken getragen die in der Wand eingelassen sind. "));
  AddDetail( ({ "stockwerk", "etage" }),
  BS("Du bis in der unteren Etage. Eine Treppe fuehrt nach oben. Du kannst hier durch die Tuer auf den Burghof treten. "));
  AddDetail( ({ "treppe" }),
  BS("Die hoelzerne Treppe fuehrt in einem steilen Winkel nach oben in das obere Stockwerk. "));
  AddDetail( ({ "raum", "abstellkammer", "kammer" }),
  BS("Dieser Raum dient wohl als Abstellkammer. Die Faesser und Kisten beinhalten wohl alle moeglichen Sachen "+
  "die zur Zeit nicht gebraucht werden. "));
  AddDetail( ({ "kisten", "faesser", "sachen", "zeug" }),
  BS("Das Zeug gehoert Dir nicht - also lass es in Ruhe. "));
  AddDetail( ({ "tuer" }),
  BS("Sie fuehrt nach draussen auf den Burghof. "));
  AddDetail( ({ "burghof", "hof" }),
  BS("Wenn Du durch die Tuer im Norden den Turm verlaesst, kannst Du Dich auf dem Burghof umsehen. "));
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "ruhe" }),
  BS("Ja - schoen still hier. "));
  AddDetail( ({"steinmetz", "steinmetzen", "handwerker"}),
  BS("Die Arbeit wurde schon lange erledigt. Die Handwerker sind nicht mehr da."));
  AddDetail( ({"steinbloecke", "steinbloecken", "bloecke", "steine"}),
  BS("Die Mauern des Turms bestehen aus grossen Steinbloecken."));
  AddDetail( ({"winkel"}),
  BS("Sehr steil aber noch bezwingbar."));
  AddDetail( ({"zeit"}),
  BS("Die Zeit vergeht ..."));
  AddDetail( ({"turm", "turms"}),
  BS("Du bist im unteren Stockwerk des Turms. Eine hoelzerne Treppe fuehrt in obere Etage. "+
  "Im Norden fuehrt eine Tuer zurueck in den Burghof. "));

/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  AddExit( "norden", BURG + "zs_burg_eg_c3" );
  AddExit( "suedoben", BURG + "zs_burg_og1_c5" );

  // END EXITS
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );      
}
