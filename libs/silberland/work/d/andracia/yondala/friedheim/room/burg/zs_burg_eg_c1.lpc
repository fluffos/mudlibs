//23.2.2019 Yondala@SilberLand funktioniert
//Hier kann man etwas Wasser trinken ohne Effekt

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Burghof zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du stehst auf dem Burghof zu Friedheim. "+
  "Im Westen ragt der grosse Bergfried in die Hoehe. Hier ist kein Eingang ins Innere des Bergfrieds. "+
  "Der Burghof erstreckt sich weiter nach Sueden und Suedosten. Ein Brunnen wurde hier angelegt. "+
  "Im Norden versperrt Dir die Burgmauer mit Wehrgang den weiteren Weg. Im Osten steht die Burgschmiede. "));
   
   
  /* Sounds und Smells */
  AddSound( DEFAULT_SOUND,
  "Aus dem Osten dringen Arbeitsgeraeusche eines Schmiedes an Dein Ohr. \n" );
  AddSmell( DEFAULT_SMELL,
  "Du kannst nur den leichten Geruch einer Feuerstelle wahrnehmen. \n" );
  AddSmell( ({ "feuerstelle", "rauch", "geruch" }),
  "Herzhaft wuerziger Rauch. \n" );
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  "Das typisch metallisch klingenden Geraeusch wenn ein Hammer warmes Eisen auf dem Amboss trifft. \n" );
  
  /* Details */
  AddDetail( ({"steinmetz", "steinmetzen", "handwerker"}),
  BS("Die Arbeit wurde schon lange erledigt. Die Handwerker sind nicht mehr da."));
  AddDetail( ({"amboss", "eisen", "hammer"}),
  BS("Dazu musst Du nach Nordosten zur Schmiede hin."));
  AddDetail( ({"burgwachen", "wachen"}),
  BS("Auf dem Wehrgang laufen sie."));
  AddDetail( ({"schritt"}),
  BS("Du kannst das Gebaeude ja abschreiten und nachmessen."));
  AddDetail( ({"innenseite", "innenseiten"}),
  BS("Das Dach der Schmiede wurde daran befestigt."));
  AddDetail( ({"ohr"}),
  BS("Normalerweise kannst Du damit hoeren."));
  AddDetail( ({"angriff", "belagerung", "feinde"}), 
  BS("Gerade sind keine Feinde dabei die Burg anzugreifen oder zu belagern."));
  AddDetail( ({ "himmel", "wetter" }),  
  "Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. \n" );
  AddDetail( ({ "boden", "burghof", "hof", "weg" }),
  "Der Boden ist mit groben Steinen gepflastert. \n"  );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke" }),
  "Die steinernen Aussenwaende des Bergfrieds und der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. \n" );
  AddDetail( ({ "friedheim", "burg" }),
  "Du stehst doch mitten auf dem Burghof der Burg zu Friedheim. \n" );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt solch ein wehrhaftes Gebaeude zu bauen. "));
  AddDetail( ({ "innere" }),
  "Dazu musst Du den Bergfried erst betreten. \n" );
  AddDetail( ({ "bauwerk", "gebaeude" }),
  "Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. \n" );
  AddDetail( ({ "turm", "tuerme" }),
  BS("Du kannst drei Tuerme und den Bergfried sehen. Geh doch naeher an den jeweiligen Turm um ihn zu untersuchen. "));
  AddDetail( ({ "zugang", "eingang" }),
  "Der Eingang zum Bergfried ist hier nicht. \n" );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weisse Schaefchenwolken. \n" );
  AddDetail( ({ "hoehe", "stockwerke" }),
  "Der Bergfried hat wohl 4 Stockwerke. Die oberste Kante ist mit Zinnen bewehrt. \n" );
  AddDetail( ({ "grundriss", "seite" }),
  BS("Der Grundriss des Bergfrieds ist annaehernd quadratisch. Eine Seite misst so 50 Schritt. "));
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "+
  "Du kannst keinen Aufgang auf die Burgmauer hinauf erkennen . "));
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "dach" }),
  "Dazu musst Du erst einmal aufs Dach um das zu tun. \n" );
  AddDetail( ({ "schmiede", "burgschmiede" }),
  BS("Du kannst direkt in die Schmiede blicken. Nur ein Holzdach, das an den Innenseiten der Burgmauer "+
  "befestigt ist, schuetzt die Schmiede vor der Witterung. Um mehr zu sehen musst Du hingehen. "));
  AddDetail( ({ "brunnen" }),
  BS("Der Brunnen hat eine mechanische Pumpe und das Becken davor ist mit Wasser gefuellt. "));
  AddDetail( ({ "pumpe", "hebel", "hebels" }),
  BS("Die Pumpe wird mit auf- und abbewegen des Hebels betaetigt. Du musst das aber nicht tun, "+
  "da das Becken ja schon gefuellt ist mit Wasser. "));
  AddDetail( ({ "becken" }),
  "Das Becken ist mit schoenem klaren Wasser gefuellt. \n" );
  AddDetail( ({ "wasser" }),
  "Sehr klares Wasser. \n" );
  AddDetail( ({ "steine" }),
  BS("Nur einfache Steine. ") ); 
  AddDetail( ({ "holzdach" }),
  BS("Das an den Innenseiten der Burgmauer angebrachte Holzdach schuetzt die Schmiede vor Regen. ") ); 
  AddDetail( ({ "witterung", "regen", "schnee" }),
  BS("Regen und Schnee nennt man auch Witterung. ") ); 
  AddDetail( ({"burgmauer"}), 
  BS("Du kannst auf der Burgmauer einen Wehrgang erkennen. Mehrere Burgwachen laufen darauf entlang."));
  AddDetail( ({"aufgang"}),
  BS("Scheinbar kommt man nur durch die Tuerme auf den Wehrgang hinauf."));
 
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
   
  /*Exits*/
  AddExit( "osten", BURG + "zs_burg_eg_d1" );
  AddExit( "suedosten", BURG + "zs_burg_eg_d2" );
  AddExit( "sueden", BURG + "zs_burg_eg_c2" );

  
  /*Aktivierung Interaktion*/
  AddCmd( ({"trink", "trinke"}), "trinke_wasser");  
   
}
/*Deklaration Interaktion*/
int trinke_wasser(string str) 
{
  notify_fail("was willst Du trinken?");
  if( str != "wasser" )
      return 0;
  write("Du trinkst etwas Wasser und fuehlst Dich herrlich erfrischt! \n");
  say(capitalize(this_player()->name())+ " trinkt etwas Wasser. \n");
  return 1;
}
