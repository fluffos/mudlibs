#include "../def.h"

inherit "std/room";

#include <properties.h>

string unt_gestein()
{
	if( TP->QueryProp(P_RACE)=="Zwerg" ) 
		return "Es scheint sich um grauen Urzeitfels zu handeln. \n";
	else
		return "Nur ganz normales Felsgestein. \n";	
}

string unt_ufels()
{
	if( TP->QueryProp(P_RACE)=="Zwerg" ) 
		return BS("Grauer Urzeitfels laesst darauf schliessen dass so manche Bodenschaetze vielleicht hier noch zu finden sind.");
	else
		return 0;	
}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich in einer dunklen Hoehle. Ein paar Steine und Felsbrocken liegen auf dem Boden verstreut. "+
     "Die Waende sind grob und an einigen Stellen kann man Bearbeitungsspuren erkennen. "+
     "An vielen Stellen kann man aufgrund der tiefen Decke nur gebueckt gehen. "));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "boden" }),
    BS("Ein paar Steine und Felsbrocken liegen auf dem Boden."));
  AddDetail( ({ "decke", "felsdecke" }),
    BS("Die tief haengende Felsdecke zwingt Dich an vielen Stellen dieser Hoehle gebueckt zu gehen."));
  AddDetail( ({ "waende", "wand", "felswaende", "felswand" }),
    BS("Die Felswaende zeigen an manchen Stellen Bearbeitungsspuren. Scheinbar wurde an mancher Stelle hier frueher "+
    "einmal Bergbau betrieben. Ansonsten ist nur der naturgewachsene Fels zu erkennen."));
  AddDetail( ({ "raum", "hoehle", "gang" }),
    BS("Diese Hoehle befindet sich tief unter Burg Friedheim. Kleine Steine und Felsen liegen am Boden und die Waende "+
    "zeigen an ein paar Stellen Bearbeitungsspuren. Die Decke haengt tief und zwingt Dich in gebueckte Haltung. "));
  AddDetail( ({ "stein", "steine", "fels", "felsen", "felsbrocken", "brocken" }),
    BS("Fast alles hier besteht aus unscheinbarem Gestein. Lose Steine und Felsen am Boden machen jeden Schritt hier unten gefaehrlich."));
  AddDetail( ({ "stelle", "stellen", "spuren", "bearbeitung", "bearbeitungsspuren" }),
    BS("Scheinbar wurde an einigen Stellen hier unten Bergbau betrieben. Du kannst leider nicht feststellen nach "+
    "welchen Bodenschaetzen hier gegraben wurde."));
  AddDetail( ({ "bergbau", "bodenschaetze" }),
    BS("Welche Bodenschaetze hier wohl noch zu finden sind?"));
  AddDetail( ({ "burg", "friedheim", "grundmauern" }),
    BS("Irgendwo ueber Dir sind die Grundmauern der Burg. "));
  AddDetail( ({ "gestein" }),
    #'unt_gestein );
  AddDetail( ({ "urzeitfels" }),
    #'unt_ufels );

/*
  AddDetail( ({ "" }),
    BS(""));
*/
}