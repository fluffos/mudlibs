#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Friedheim" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf der Strasse und vor dir gen Westen ist das Tor zum Dorf Friedheim. Das Tor steht offen und keine "
    "Stadtwache ist zu sehen, die Dir den Eintritt versagen koennte.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein paar Voegel zwitschern.");
  AddSound( ({ "zwitschern" }),
    "Sehr nett.");
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse");
  AddSmell( ({ "strasse", "asphalt", "gummi", "geruch" }),
    "Also nach Asphalt und Gummi wird es nicht riechen.");

  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt?");
  AddDetail( ({ "strasse", "weg", "pflaster" }),
    "Der Weg ist mit groben Steinen gepflastert.");
  AddDetail( ({ "eintritt", "wegezoll", "zoll" }),
    "Nein - niemand da der Wegezoll verlangt."); 
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Die Stadtmauer ist ungefaehr vier Meter hoch und mit Zinnen bewehrt."); 
  AddDetail( ({ "zinnen" }),
    "Wenn man sich auf dem Wehrgang befindet kann man bei Belagerungen \n"
    "sich gut dahinter verschanzen."); 
  AddDetail( ({ "wald" }),
    "Der Wald befindet sich im Sueden.");
  AddDetail( ({ "burg", "friedheim" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg.");
  AddDetail( ({ "dorf", "stadt", "gruppe" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. \n"
    "Du bist am oestlichen Eingang der Stadt.");
  AddDetail( ({ "eingang", "tor" }),
    "Das Tor scheint offen zu sein.");
  AddDetail( ({ "steine", "pflastersteine" }),
    "Einfache Steine. Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche.");
  AddDetail( ({ "belagerungen", "belagerung" }),
    BS("Hier ist es sehr friedlich - keine Belagerung zur Zeit."));
  AddDetail( ({ "zeit" }),
    BS("Sie vergeht."));
  AddDetail( ({ "boden" }),
    BS("Nur einfache Pflastersteine sind zu sehen."));
  AddDetail( ({ "haeuser" }),
    BS("Dazu sollte man ins Dorf hinein gehen."));
  AddDetail( ({ "himmel" }),
    BS("Schoen blau."));
  AddDetail( ({ "kutsche", "transport" }),
    BS("Hin und wieder kommt die Kutsche hier vorbei."));
  AddDetail( ({ "meter", "laengenmass", "hoehenmass" }),
    BS("Ein Meter ist ein Laengenmass oder wie hier ein Hoehenmass."));
  AddDetail( ({ "sicht" }),
    BS("man kann die umliegenden Wiesen gut sehen. Die Burg aber ist hinter dem Dorf und "+
    "daher von hier aus nicht zu sehen."));
  AddDetail( ({ "voegel" }),
    BS("Du hoerst nur ihr zwitschern aber sehen kannst Du sie nicht."));
  AddDetail( ({ "wehrgang" }),
    BS("Der Wehrgang ist hinter den Zinnen."));
  AddDetail( ({ "wiesen" }),
    BS("Saftig gruen."));
/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 210 );

  AddExit( "westen", DORF "friedheim_dorf_e4" );
  AddExit( "osten", WEGE "weg_zum_dorf_b1" );
}


