//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Waffenkammer des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich in der Waffenkammer des Bergfrieds zu Friedheim. "+
  "Hier werden die Waffen bereitgehalten, falls es zu einer Belagerung kommt. "+
  "Einfache Schwerter, Armbrueste und Piken sind hier in Gestellen aufgereiht. "));
   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden", "bohlen", "holzbohlen" }),
  "Der Boden besteht aus massiven Holzbohlen." );
  AddDetail( ({ "waende", "wand" }),
  "Die Waende sind aus Stein. \n" );
  AddSound( DEFAULT_SOUND,
  "Es sind keine besonderen Geraeusche zu hoeren." );
  AddSound( "geraeusche",
  "Du hoerst nichts besonderes.");
  AddSmell( DEFAULT_SMELL,
  "Du kannst nichts besonderes riechen." );
  
  
  /* extra Details */ 
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich in der Waffenkammer des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "waffen", "schwerter", "schwert", "armbrueste", "ambrust", "pike", "piken" }),  
  BS("Diese Waffen werden benoetigt wenn eine Belagerung stattfindet. "));
  AddDetail( ({ "gestelle", "gestell" }),  
  BS("Die Waffen sind feinsaeuberlich in Reih und Glied auf den Gestellen aufgebahrt. "+
  "Bei einer Belagerung braucht jeder wackere Verteidiger sich im vorbeigehen nur eine Waffe "+
  "schnappen und kann die Angreifer bekaempfen. "));
  AddDetail( ({ "reih", "glied" }),  
  "Mhm - das bringt nichts! \n");
  AddDetail( ({ "belagerung" }),  
  "Zur Zeit findet keine statt. \n");
  AddDetail( ({ "verteidiger" }),  
  BS("Diejenigen, die die Burg bei einer Belagerung verteidigen eben. "));
  AddDetail( ({ "angreifer" }),  
  BS("Diejenigen, die die Burg bei einer Belagerung zu erobern versuchen. "));
  AddDetail( ({ "raum", "waffenkammer", "kammer"  }),  
  BS("Dieser Raum wird Waffenkammer genannt da die Waffen die waehrend einer "+
  "Belagerung benoetigt werden hier aufbewahrt werden." ));
  AddDetail( ({"stein", "steine", "steinen"}),
  BS("Grobe Steine bilden die Waende."));

  
/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  // END DETAILS
  AddExit( "osten", BURG + "zs_burg_og1_b1.lpc" );
  AddExit( "sueden", BURG + "zs_burg_og1_a2.lpc" );
   
   
  // END EXITS
  AddItem( NPC + "eberhelm_schroeter.lpc", REFRESH_DESTRUCT );
  
  AddCmd( ({"nimm", "nehme", "stiehl", "stehle", "klau", "klaue", "raube", "raub" }), "cmd_klauen" ); 
}

int cmd_klauen(string str)
{
	if( !str ) return 0;
	write( BS("Nach einem kurzen Zoegern kommst Du zu der Einsicht, dass hier in dieser vollbesetzten "+
	  "Burg ein offener Diebstahl doch wenig Sinn macht. Vielleicht kommst Du ja auch durch ehrliche "+
	  "Arbeit an die Schaetze dieser Burg. " ) );
	say( TP->name()+" schaut sich gierig um. \n");
	return 1;
}