#include "../def.h"

inherit WEGE+"weg_zur_burg_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS(
    "Du stehst hier direkt vor dem Westeingang des Dorfs.") );

  AddDetail( ({"ende", "westeingang", "tor"}), BS(
    "Das Tor steht offen und keine Stadtwache zu sehen die Dir den Eintritt versagen koennte."));  
  AddDetail( ({ "eintritt", "wegezoll", "zoll" }),
    "Nein - niemand da der Wegezoll verlangt."); 
  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt?");

  AddExit( "osten", DORF "friedheim_dorf_a4" );
  AddExit( "nordwesten", WEGE "weg_zur_burg_h6" );
}
