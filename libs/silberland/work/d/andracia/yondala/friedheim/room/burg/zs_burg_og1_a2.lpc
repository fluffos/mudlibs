inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Wachraum des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich in einem Wachraum des Bergfrieds zu Friedheim. "+
  "Ein hoelzerner Tisch und zwei passende Baenke stehen hier und dienen den Wachen wohl um sich "+
  "in ihrer freien Zeit auszuruhen. Ein Durchgang nach Nordosten fuehrt in den anderen Wachraum. "+
  "Im Norden befindet sich die Waffenkammer und im Osten kommt man ins Treppenhaus. "+
  "Durch eine Tuer im Sueden kannst Du hier hinaus auf den Wehrgang. "));
   
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus massiven Holzbohlen.");
  AddDetail( ({ "waende", "burgmauern", "mauern", "wand", "burgmauer" }),
  BS("Die Waende sind alle aus Stein. An der Westwand stehen mehrere Schraenke. "));
  AddDetail( ({ "westwand" }),
  "Hier stehen mehrere Schraenke. \n");
  AddDetail( ({ "ostwand" }),
  "Hier ist eine Tuer zum Treppenhaus. \n");
  AddDetail( ({ "suedwand" }),
  "Hier ist eine Tuer hinaus zum Wehrgang. \n");
  AddDetail( ({ "nordwand" }),
  "Hier ist eine Tuer zur Waffenkammer. \n" );
  AddSound( DEFAULT_SOUND,
  "Es sind keine besonderen Geraeusche zu hoeren." );
  AddSound( "geraeusche",
  "Du hoerst nichts besonderes.");
  AddSmell( DEFAULT_SMELL,
  "Du kannst nichts besonderes riechen." );
  
  /* extra Details */ 
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich in einem Wachraum des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "wehrgang", "wehrgaenge" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "));
  AddDetail( ({ "zinnen", "zinne", "mauerstuecke", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "schrank", "schraenke", "habe" }),
  BS("Diese dienen wohl den Wachen fuer ihre persoenliche Habe. Alle sind verschlossen. "));
  AddDetail( ({ "treppenhaus" }),
  "Dazu musst Du Dich durch die Tuer im Osten begeben. \n" );
  AddDetail( ({ "waffenkammer" }),
  "Dazu musst Du Dich durch die Tuer im Norden begeben. \n" );
  AddDetail( ({ "tuer" }),
  "Alle Tueren hier sind aus starken Holzbohlen gefertigt. \n" );
  AddDetail( ({ "holzbohlen", "bohlen"  }),  
  BS("Tueren und Boden bestehen aus massiven Holzbohlen. "));
  AddDetail( ({ "wachraum", "raum", "etage" }),  
  BS("Der Raum ist schlicht und praktisch. An der Westwand wurden Schraenke aufgestellt. "+
  "Ein Tisch und zwei Baenke stehen hier ebenfalls. Im Norden befindet sich die Waffenkammer "+ 
  "und durch eine Tuer im Sueden kannst Du hinaus auf den Wehrgang. "));
  AddDetail( ({ "bank", "baenke", "tisch", "holztisch", "holzbank", "holzbaenke" }),
  BS("Die Einrichtungsgegenstaende hier im Raum sind neben den Schraenken der Holztisch und die zwei Holzbaenke. "+
  "Einfach gearbeitet aber sehr praktisch. Du hast aber keine Zeit zum Hinsetzen. "));
  AddDetail( ({ "durchgang" }),  
  BS("Durch den Durchgang im Nordosten kommt man in den anderen Wachraum auf dieser Etage. "));
  AddDetail( ({ "einrichtungsgegenstaende" }),
  BS("Schraenke, ein Holztisch und zwei Holzbaenke sind zu sehen."));
  AddDetail( ({"stein", "steine", "steinen"}),
  BS("Grobe Steine bilden die Waende."));
  AddDetail( ({"wachen", "burgwachen"}),
  BS("Die Wachen patroullieren hier und auf den Wehrgaengen."));
  AddDetail( ({"angriff", "belagerung", "feinde"}), 
  BS("Gerade sind keine Feinde dabei die Burg anzugreifen oder zu belagern."));
  AddDetail( ({"hinsetzen", ""}),
  BS("Das solltest Du hier nicht tun."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  // END DETAILS
  AddExit( "osten", BURG + "zs_burg_og1_b2.lpc" );
  AddExit( "sueden", BURG + "zs_burg_og1_a3.lpc" );
  AddExit( "norden", BURG + "zs_burg_og1_a1.lpc" );
  AddExit( "nordosten", BURG + "zs_burg_og1_b1.lpc" );
   
  // END EXITS
  AddItem( NPC + "burgschuetze.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgschuetze.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );   
}

