#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

int anz_pilze; 
  
void reset()
{
  ::reset();
  if(anz_pilze < 4) anz_pilze++;   
}

void create() 
{
  ::create();
  anz_pilze = 4;
  
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Hier hat vor langer Zeit ein Einbruch stattgefunden. Etwas Erde und Fels "+
  "bildet hier Naehrboden fuer weisse, grosse Pilze. "));

  AddDetail( ({ "einbruch", "bereich" }),
  BS("Die Hoehle ist hier vor langer Zeit teilweise eingestuerzt. Erde und Felsen "+
  "kamen herab und zerstoerten in einem begrenzten Bereich der Hoehle. "));
  AddDetail( ({ "erde" }),
  BS("Weiche feuchte Erde eben. Pilze wachsen darauf."));
  AddDetail( ({ "naehrboden" }),
  BS("Die Erde die vom Einbruch herabregnete bildet hier eine der wenigen Stellen "+
  "wo Pilze geeigneten Boden zum Leben finden. "));
  AddDetail( ({ "pilze" }),
  BS("Grosse weisse Pilze wachsen hier. Du kannst gerne welche pfluecken. "));
  AddDetail( ({ "leben" }),
  BS("Auch hier tief unten gibt es Leben."));
  AddSpecialDetail( ({ "zeit" }), "unt_zeit");

  AddCmd( ({"pflueck", "pfluecke" }), "pflueck_pilz" );

  AddExit( "nordosten", KELLER + "zs_sublevel1_c6.lpc" );
  AddExit( "westen", KELLER + "zs_sublevel1_a7.lpc" );
}

string unt_zeit()
{
	return "Es ist jetzt "+ctime(time())+"\n";
}	

int pflueck_pilz(string str)
{ 
  object ob;
  if( str != "pilz" && str != "pilze") {
    notify_fail("Was willst Du nehmen? \n");
    return 0;
  }
  if( anz_pilze == 0) {
    notify_fail("Alle Pilze sind noch klein und muessen noch wachsen. \n");
    return 0;
  }
  if(TP->QueryProp(P_LEVEL) >= 8) ob = clone_object(OBJ + "giftpilz.lpc");
  else ob = clone_object(OBJ + "pilz.lpc");
  ob->move(TP, M_GET); 
  write("Du pflueckst einen schoenen weissen Pilz. \n");
  say(TPN + " pflueckt einen schoenen weissen Pilz. \n");
  anz_pilze--;
  return 1;
}