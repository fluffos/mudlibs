//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Torhaus" ); 
  SetProp( P_INT_LONG,  
  BS("Du bist im oberen Stockwerk des Torhauses. Hier fuehrt keine Treppe nach oben aufs Dach. "+
  "Man hat aus den Schiessscharten in der Suedwand ein gutes Blickfeld auf den Bereich vor dem Tor. "+
  "Im Osten und Westen kann man durch Tueren ueber ein kurzes Stueck Wehrgang in die benachbarten Tuerme. "+
  "Hier ist eine Seilwinde zum hochziehen der Zugbruecke "));   
   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
  BS("Die Decke ist sehr hoch. Sie besteht aus Holzbalken und Holzbohlen. Die Balken sind in der "+
  "steinernen Wand des Turm eingelassen. "));
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus Holzbohlen. \n" );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "mauerstueck", "mauerstuecke", "steinbloecke", "steine", "stein" }),
  BS("Die Waende bestehen aus grossen Steinbloecken und scheinen die Arbeit von faehigen Steinmetzen zu sein. "+
  "Du kannst erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt hat diesen Turm zu errichten. "));
  AddSound( DEFAULT_SOUND,
  "Du hoerst nichts besonderes. \n" );
  AddSmell( DEFAULT_SMELL,
  "Du riechst nichts besonderes. \n" );
   
  
  /* extra Details */
  AddDetail( ({ "friedheim", "burg" }),
  "Du bist doch schon in der Burg. \n" );
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man dann Wehrgang. "));
  AddDetail( ({ "schiessscharten", "schiessscharte", "scharten", "scharte", "blickfeld" }),
  "Hier kann man nach draussen schauen. \n" );
  AddDetail( ({ "balken", "bohlen", "holz", "holzbalken", "holzbohlen" }),
  BS("Boden und Decke sind aus Holz. Die Holzbohlen werden von Balken getragen die in der Wand eingelassen sind. "));
  AddDetail( ({ "stockwerk", "etage", "raum", "torhaus" }),
  BS("Du bist in der oberen Etage des Torhauses. Du kannst von hier durch eine Tuer im Westen und Osten ueber ein kurzes Stueck Wehrgang die Tuerme "+
  "erreichen. "));
  AddDetail( ({ "raum", "wachraum" }),
  "Dieser Raum dient wohl als Wachraum. Ein Holztisch und zwei einfache Baenke sind die einzigen Einrichtungsgegenstaende. \n" );
  AddDetail( ({ "bank", "baenke", "tisch", "holztisch" }),
  "Die einzige Einrichtungsgegenstaende hier im Raum sind der Holztisch und die zwei Holzbaenke. \n"
  "Einfach gearbeitet aber sehr praktisch. Du hast aber keine Zeit zum hinsetzen. \n" );
  AddDetail( ({ "tuer" }),
  "Eine fuehrt nach Westen ueber ein kurzes Stueck Wehrgang in einen Turm genauso wie die Tuer im Osten. \n" );
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  "Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. \n" );
  AddDetail( ({ "seilwinde", "winde" }),
  "Damit kann man die Zugbruecke hochziehen. Sie besteht aus einer Trommel und einer Hebelage. \n" );
  AddDetail( ({ "trommel", "hebel", "hebelage" }),
  "Lass lieber die Finger davon, sonst kommt die Burgwache und wirft Dich in den Kerker. \n" );
  AddDetail( ({ "ostwand", "westwand" }),
  BS("In dieser Wand fuehrt eine Tuer hinaus auf den Wehrgang"));
  AddDetail( ({ "suedwand" }),
  BS("Schiessscharten wurden in dieser Wand eingebracht."));
  AddDetail( ({ "nordwand" }),
  BS("Ein Fenster in der Wand ermoeglicht den Blick auf den Burghof."));
  AddDetail( ({ "bereich" }),
  BS("Was fuer einen Bereich auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "tor", "haupttor" }),
  BS("Du kannst das Haupttor von hier aus nicht sehen. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({"burgmauer"}), 
  BS("Du kannst auf der Burgmauer einen Wehrgang erkennen. Durch die Tueren im Norden und Westen kannst Du auf den Wehrgang gelangen."));
  AddDetail( ({ "stueck" }),
  BS("Was fuer ein Stueck auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "einrichtungsgegenstaende" }),
  BS("Ein Holztisch und zwei Holzbaenke sind zu sehen."));
  AddDetail( ({ "burghof", "hof" }),
  BS("Vom Fenster aus hat man einen sehr guten Ueberblick auf den Burghof. "));
  AddDetail( ({ "belagerung" }),
  BS("Zur Zeit ist keine Belagerung im Gange"));
  AddDetail( ({ "bergfried", "fenster" }),
  BS("Durch das Fenster im Norden kann man den Bergfried erkennen."));
  AddDetail( ({ "dach" }),
  BS("Von hier aus kommt man nicht aufs Dach."));
  AddDetail( ({ "kerker" }),
  BS("Der ist im Keller."));
  AddDetail( ({ "keller" }),
  BS("Dort befinden sich die Kerker."));
  AddDetail( ({ "zugbruecke" }),
  BS("Die Zugbruecke kann hier heraufgezogen und herabgelassen werden."));
  AddDetail( ({ "turm", "tuerme" }),
  BS("Im Osten und Westen vom Torhaus stehen Tuerme. Durch die Tueren im Osten und Westen kann man sie betreten."));
  AddDetail( ({ "treppe" }),
  BS("Hier gibt es keine Treppe."));

/*
  AddDetail( ({ "" }),
  BS(""));
*/ 
  // END DETAILS
  AddExit( "westen", BURG + "zs_burg_og1_a5" );
  AddExit( "osten", BURG + "zs_burg_og1_c5" );
  
  // END EXITS
  // AddItem( "file", refresh, Props);
   
}
