// 28.02.2019 Yondala@SilberLand: ein paar mehr Details

inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

reset() {
  ::reset();
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Geschaeft von Eslam Kremso" ); 
  SetProp( P_INT_LONG,  BS("Dies ist das Geschaeft von Eslam Kremso. Vollgepackte Regale "+
  "mit allerlei Krimskrams aber auch Dinge, die jeder Haushalt braucht. Auch eine kleine "+
  "Ecke mit Waffen und Ruestungen kann man hier finden.") );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "Eslam Kremso");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( DORF+"zs_haendler_storage_a5.lpc");

   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
    "Die Decke ist aus Holz. An ihr wurden einige Haken befestigt, um Stauraum fuer weitere Waren zu schaffen.");
  AddDetail( ({ "haken" }),
    BS("An den Haken haengen diverse Waren."));
  AddDetail( ({ "stauraum"}),
    BS("Hier wurde wirklich jedes bisschen Platz ausgenutzt, um Waren auszustellen."));
  AddDetail( ({ "waende", "wand" }),
    "Von den Waenden siehst Du nicht viel, sie werden groesstenteils von Regalen und Staendern verdeckt. ");  
  AddDetail( ({ "staender" }),
    BS("Auf den Staendern haengen Kleidungsstuecke, die wohl fuer den Verkauf gedacht sind."));
  AddDetail( ({ "verkauf" }),
    BS("Du kannst hier etwas kaufen, wenn Du moechtest."));
  AddDetail( ({ "kisten","kaesten" }),
    BS("Du kannst nicht sehen, was darin ist."));
  AddDetail( ({ "platz" }),
    BS("Der meiste Stauraum hier ist mit Waren belegt."));
  AddDetail( ({ "kleidungsstueck","kleidungsstuecke","kleidung" }),
    BS("Schau Dich ruhig um, vielleicht ist was fuer Dich dabei."));
  AddDetail( ({ "" }),
    BS(""));
  AddDetail( ({ "" }),
    BS(""));


  AddDetail( ({ "boden" }),
    "Holzbohlen bilden den Boden. Hier stapeln sich einige Dinge, Kisten und Kaesten stehen herum. Pass auf, dass Du nicht stolperst. ");


  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren. ");
  AddSound( ({ "" }),
    BS(""));

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier angenehm, aber nach nichts Konkretem. ");
  AddSmell( ({ "konkretem","konkretes" }),
    BS("Es riecht ein bisschen nach Kleidung, Leder, Waffenoel. So, wie es in einem Gemischtwarenladen riecht."));
   AddSmell( ({ "kleidung" }),
    BS("Die Kleidung hier riecht neu, nicht muffig oder so."));
   AddSmell( ({ "leder" }),
    BS("Einiges hier besteht aus Leder, deswegen riecht es danach."));
   AddSmell( ({ "waffenoel","waffen" }),
    BS("Die Waffen hier sind gut gepflegt, deswegen riecht es nach Waffenoel."));
   AddSmell( ({ "" }),
    BS(""));

   
   
  /* extra Details */
  AddDetail( ({ "holz", "baustoff" }),
    BS("Der wichtigste Baustoff ueberhaupt ist Holz. "));
  AddDetail( ({ "geschaeft", "laden", "gemischtwarenladen" }),
    BS("Dies ist das Geschaeft von Eslam Kremso. Er verkauft hier allerlei Waren. "+
    "Mit 'zeige' kannst Du Dir von ihm sein Sortiment anzeigen lassen. "));
  AddDetail( ({ "regale" }),
    BS("Auf den Regalen liegen die Waren die Kremso hier verkauft. "));
  AddDetail( ({ "krimskrams", "dinge", "sortiment", "waren" }),
    BS("Mit 'zeige' kannst Du Dir von Eslam Kremso sein Sortiment anzeigen lassen."));
  AddDetail( ({ "haushalt" }),
    BS("Im Haushalt braucht man viele Dinge. Das meisste davon kann man hier in diesem "+
    "Laden bekommen. "));
  AddDetail( ({ "ecke" }),
    BS("In der Ecke hier liegen auch ein paar Waffen und Ruestungen die ein Abenteurer "+
    "auf seinen Reisen gut gebrauchen kann. "));
  AddDetail( ({ "waffen", "ruestungen" }),
    BS("Mit 'zeige waffen' kannst Du Dir von Eslam Kremso sein Sortiment von Waffen anzeigen lassen. "+
    "Dasselbe geht auch mit Ruestungen, zum Beispiel 'zeige armschienen'. " ));
  AddDetail( ({ "beispiel" }),
    BS("'zeige armschienen' war das Beispiel."));
  AddDetail( ({ "eslam", "kremso", "haendler" }),
    BS("Der Haendler scheint gerade nicht da zu sein."));
  AddDetail( ({ "reisen" }),
    BS("Wohin Du willst musst Du schon selbst wissen."));
  AddDetail( ({ "abenteurer", "abenteuer", "suche" }),
    BS("Die Abenteurer sind meist auf der Suche nach Abenteuern."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  // DETAILS END
  
  /*Ausgaenge*/
  AddExit( "osten", DORF + "friedheim_dorf_b5.lpc" );
  // EXITS END 
   
  /*Objekte und NPCs*/
  // AddItem( "file", refresh, Props);
  AddItem( NPC + "eslam_kremso.lpc", REFRESH_DESTRUCT );
   
}

