  // DETAILS END  

  AddExit( "osten", DORF + "friedheim_dorf_d5.lpc" );
  AddExit( "westen", DORF + "friedheim_dorf_b5.lpc" );
  AddExit( "nordosten", DORF + "friedheim_dorf_d4.lpc" );
  AddExit( "nordwesten", DORF + "friedheim_dorf_b4.lpc" );
  AddExit( "norden", DORF + "friedheim_dorf_c4.lpc" );
  // EXITS END

  AddItem( NPC + "samson_palm.lpc", REFRESH_DESTRUCT );
