#include "../def.h"
#include <properties.h>
#include <language.h>

inherit DORF + "friedheim_dorf_std.lpc";


create() {
  ::create();

  SetProp( P_INT_SHORT, "Dorf Friedheim" );
  SetProp( P_INT_LONG,
    BS("Du stehst auf dem suedlichen Teil des Dorfplatzes. "+
    "Hier steht ein Denkmal zu Ehren von Kunibert von Friedheim. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  AddDetail( ({ "denkmal", "ehren"}),
    BS("Das Denkmal stellt einen Reiter mit einer Lanze dar, der gerade einen Drachen damit toetet. "+
    "Es ist aus Stein gemeisselt und ein grosses Schild wurde am Sockel befestigt. "));
  AddDetail( ({ "sockel" }),
    "Der Sockel ist aus Stein und wohl sehr massiv. Ein Schild wurde daran befestigt.\n");
  AddDetail( ({ "schild" }),  
    "Du kannst es lesen.");
  AddReadDetail( ({ "schild" }),
    " +---------------------------+ \n"+
    " | Kunibert von Friedheim    | \n"+
    " |   mutiger Drachentoeter,  | \n"+
    " |   Retter des Huegellands  | \n"+
    " +---------------------------+ \n");
  AddDetail( ({ "lanze" }),  
    BS("Die Lanze ist sogar hier sehr lang und spitz und vermutlich im Original toedlich gewesen."));
  AddDetail( ({ "original" }),  
    BS("Du siehst hier nur eine Nachbildung."));
  AddDetail( ({ "nachbildung" }),  
    BS("Bei der Lanze handelt es sich wohl kaum um die echte Lanze des echten Kunibert."));
  AddDetail( ({ "kunibert","reiter" }),  
    BS("Stolz und erhaben sitzt der steinerne Kunibert auf seinem steinernen Pferd."));
  AddDetail( ({ "pferd" }),  
    BS("Das Pferd scheint ein robustes Schlachtross zu sein. Es steht auf den Hinterbeinen."));
  AddDetail( ({ "schlachtross" }),  
    BS("Du bist Dir sehr sicher, dass es ein robustes und mutiges Pferd gewesen ist. Immerhin ist es im Angesicht des Drachen nicht durchgegangen."));
  AddDetail( ({ "hinterbeine" }),  
    BS("Kennst Du die Bedeutung, wenn ein Reiter auf einem Pferd dargestellt wird, das auf den Hinterbeinen steht?"));
  AddDetail( ({ "bedeutung" }),  
    BS("Es bedeutet, dass der Reiter im Kampf gestorben ist."));
  AddDetail( ({ "kampf" }),  
    BS("Ob es der dargestellte Kampf war oder ein anderer, laesst sich hier und jetzt nicht feststellen."));
  AddDetail( ({ "drache","drachen" }),  
    BS("Ein imposanter Drache, den Kunibert da angeblich getoetet hat. Du kennst zwar groessere, aber dieser hier war durchaus ein starker Gegner."));
  AddDetail( ({ "gegner" }),  
    BS("Ohne mehrfach zu tanken wuerdest DU den sicher nicht kleinkriegen."));
  AddDetail( ({ "stein" }),  
    BS("Normaler, grauer Stein, leicht verwittert, aber durchaus gepflegt und gut verarbeitet."));
  AddDetail( ({ "angesicht" }),  
    BS("Zumindest wird es hier nicht so dargestellt."));
  AddDetail( ({ "" }),  
    BS(""));
	
  AddDetail( ({ "dorfplatz", "dorfplatzes", "platz", "teil" }),  
    BS("Du stehst hier auf dem suedlichen Teil des Dorfplatzes. Ein grosses Denkmal ist hier aufgestellt. "));	
