int magic_potion( string str ) {
	notify_fail("Was willst Du herausziehen?\n");
	if( !str ) return 0;
	if( str != "ziegel" && str != "ziegelstein" && str != "ziegel heraus" && str != "ziegelstein heraus" &&
		str != "stein" && str != "stein heraus" && str != "ziegel aus mauer" && str != "ziegelstein aus mauer" &&
		str != "stein aus mauer" && str != "ziegel aus wand" && str != "ziegelstein aus wand" &&
		str != "stein aus wand" ) return 0;
  if (this_player()->FindPotion(
      BS("Du ziehst den Ziegelstein aus dem Mauerwerk und entdeckst dahinter ein kleines "+
      "Flaeschen Zaubertrank das Du sofort austrinkst.")))
    return 1;
  else {
  	write( "Du ziehst den Ziegelstein aus der Mauer. Es ist nur ein einfacher Stein.\n" );
  return 1; }
}

