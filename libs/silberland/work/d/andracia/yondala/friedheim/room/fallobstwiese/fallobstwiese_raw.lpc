#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Wiese" );
  SetProp( P_INT_LONG,
    BS("Eine schoene Wiese mit vereinzelt stehenden Baeumen. Im Norden kannst Du die "+
    "Burg Friedheim erkennen. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "boden", "wiese" }),
    BS("Du laeufst auf saftigem Gras. Alle Huegel des Huegellands sind davon bedeckt. "));
  AddDetail( ({ "himmel" }),
    BS("Schoen blau. Es wird wohl noch laenger solch ein schoenes Wetter bleiben. "));
  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Der Duft der Wiese und der Obstbaeume dringt dir in die Nase. "));

  AddDetail( ({ "gras" }),
    BS("Saftiges, gruenes Gras. "));
  AddDetail( ({ "huegel", "erhebungen", "erhebung", "anhoehe", "bild" }),
    BS("Leichte Erhebungen die dieser Landschaft das charakteristische Bild gibt."));
  AddDetail( ({ "huegelland", "landschaft", "huegellands", "zentrum" }),
    BS("Du befindest dich hier im Zentrum des Huegellands. Im Norden steht die Burg Friedheim. "));
  AddDetail( ({ "burg", "friedheim", "bauwerk" }),
    BS("Auf einer Anhoehe im Norden steht die Burg Friedheim. Ein maechtiges Bauwerk."));
  AddDetail( ({ "baum", "baeume", "baeumen", "obstbaum", "obstbaeume" }),
    BS("Vereinzelt stehen Obstbaeume hier auf der Wiese."));
  AddDetail( ({ "wetter" }),
    BS("Hoffentlich bleibt es so schoen."));
  AddDetail( ({ "nase" }),
    BS("Du hast deine Nase gefunden und popelst ein bischen darin ... "));
  AddDetail( ({ "bluetenstaub" }),
    BS("Er haengt in der Luft. "));

  AddSmell( ({ "wiese" }),
    BS("Nasses Gras eben."));
  AddSmell( ({ "duft", "geruch", "bluetenstaub" }),
    BS("Nasses Gras und Bluetenstaub der Baeume bilden den Geruch der hier herrscht."));
  AddSmell( ({ "obstbaeume", "baeume", "luft" }),
    BS("Der Bluetenstaub der Baeume haengt in der Luft."));
}
