inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Treppenhaus des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds zu Friedheim. "+
  "Nach Westen und Norden kannst Du in die Wachraeume gelangen. An den "+
  "Waenden hier sind Portraits aufgehaengt. "));
  
  /* Smells und Sounds */ 
  AddSound( DEFAULT_SOUND,
  "Es sind keine besonderen Geraeusche zu hoeren.");
  AddSound( ({ "geraeusche" }),
  BS("Es sind wirklich keine besonderen Geraeusche zu hoeren."));
  AddSmell( DEFAULT_SMELL,
  "Du kannst nichts besonderes riechen.");
    
  /* Details */ 
  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden", "holzbohlen", "bohlen" }),
  "Der Boden besteht aus massiven Holzbohlen.");
  AddDetail( ({ "waende", "steinwaende" }),
  BS("Die Waende sind alle aus Stein. Portraits wurden hier entlang der Treppe aufgeaengt. "));
  AddDetail( ({ "nordwand" }),
  BS("Hier ist eine Tuer zum Wachraum. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "suedwand" }),
  "Die Portraits hier zeigen die Vorfahren derer zu Friedheim. \n");
  AddDetail( ({ "ostwand" }),
  "Die Portraits hier zeigen die Vorfahren derer zu Friedheim. \n");
  AddDetail( ({ "westwand" }),
  BS("Hier ist eine Tuer zum Wachraum. Die Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "bergfried", "friedheim", "burg" }),  
  BS("Du befindest Dich im Treppenhaus des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "portraits", "bilder", "kunstwerke" }),  
  BS("Die in schoenen Bilderrahmen gefassten Portraits hier zeigen die Vorfahren derer zu Friedheim. "));
  AddDetail( ({ "stein", "steine" }),  
  "Massive Steinwaende die auch mehrere Treffer vom Katapult aushalten. \n");
  AddDetail( ({ "treppe", "treppenhaus" }),  
  "Die Treppe fuehrt hier von oben nach unten durch den gesamten Bergfried. \n");
  AddDetail( ({ "wachraeume", "wachraum" }),  
  "Geh doch einfach in einen der Wachraeume um diese zu untersuchen. \n");
  AddDetail( ({ "vorfahren" }),  
  "Alle schon laengst tot und nur noch diese Portraits erinnern an sie. \n");
  AddDetail( ({ "tuer" }),
  "Alle Tueren hier sind aus starken Holzbohlen gefertigt. \n");
  AddDetail( ({ "treppe" }),
  "Die Treppe fuehrt hier weiter noch oben und unten. \n");
  AddDetail( ({ "rahmen", "bilderrahmen" }),
  "Alle Bilderrahmen sind selbst schon filigran geschnitzte Kunstwerke.");
  AddDetail( ({ "wand", "steinwand"}),
  BS("Welche Wand willst Du denn untersuchen? Die Nordwand, Ostwand, Suedwand oder Westwand? "));
   
/*
  AddDetail( ({"", ""}),
  BS(""));
*/
  
  // Exits
  AddExit( "oben", BURG + "zs_burg_og2_b2.lpc" );
  AddExit( "westen", BURG + "zs_burg_og1_a2.lpc" );
  AddExit( "norden", BURG + "zs_burg_og1_b1.lpc" );
  AddExit( "unten", BURG + "zs_burg_eg_b2.lpc" );
   
  // Items
  // AddItem( "file", refresh, Props);
   
}

