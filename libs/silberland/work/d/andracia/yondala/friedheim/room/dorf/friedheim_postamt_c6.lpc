// 28.02.2019 Yondala@SilberLand: ein paar mehr Details

inherit "std/post.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>


create()
{
  ::create(); //Aktivieren
  SetProp( P_LIGHT, 1);     //entweder 1 wenn Licht an ist oder 0 wenn aus
  SetProp( P_INDOORS, 1);   //hier 1 wenn es in einem haus bzw hoehle ist 0 wenn draussen
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Postamt von Friedheim" ); 
  SetProp( P_INT_LONG,  BS("Dies ist das Postamt von Friedheim. "+
  "Hier im Postamt kannst Du Briefe an andere Spieler "+
  "schreiben und verschicken. Du kannst die Schreibkabinen "+
  "betreten, um darin ungestoert Deine Schreiben aufzugeben. Wenn Du Deine Post lesen oder "+
  "neue Briefe schreiben willst, so tippe 'post' oder 'mail', bzw. 'mail <spielername>'. "));
   
  /* Standartdetails */
  AddDetail( ({ "decke" }),  
    "Die Decke ist aus Holz. ");
  AddDetail( ({ "boden" }),
    "Holzbohlen bilden den Boden. ");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus Holz, einige Regale stehen davor.");
  AddDetail( ({"regale","regal"}),
    BS("In den Regalen stehen Kisten mit Postsendungen."));
  AddDetail( ({"sendungen","postsendungen"}),
    BS("Die Einwohner Friedheims und auch durchreisende Gaeste schicken hier fleissig ihre Post ab. Und die muss irgendwo gelagert werden."));
  AddDetail( ({"einwohner"}),
    BS("Hauptsaechlich Menschen."));
  AddDetail( ({"menschen"}),
    BS("Friedheim wird hauptsaechlich von Menschen bevoelkert."));
  AddDetail( ({"gaeste", "gast"}),
    BS("Da Du nicht in Friedheim wohnst, bist Du auch ein Gast. Wie praktisch, dass auch Gaeste hier Post verschicken koennen."));
  AddDetail( ({"kisten"}),
    BS("In den Kisten befinden sich die Postsendungen, die die Einwohner Friedheims entweder abgeschickt haben oder noch abholen muessen."));
	
  AddSound( DEFAULT_SOUND,
    "Man hoert die Federn von mehreren Leuten uebers Papier huschen. ");
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Tusche und Papier hier. ");
  AddSmell( ({ "tusche", "papier" }),
    "Typisch eben fuer ein Postamt. "  );
   
  /* extra Details */
  AddDetail( ({ "briefe" }),
    BS("Hier kannst Du Briefe schreiben und lesen. "));
  AddDetail( ({ "spieler" }),
    BS("Jeder in dieser Welt kann als Spieler bezeichnet werden sogar diejenigen "+
    "die das hier alles erschaffen haben. "));
  AddDetail( ({ "papier", "tusche", "federn" }),
    BS("Da brauchst Du Dir keine Sorgen machen, es ist genuegend davon vorhanden. "+
    "Du kannst nicht soviel Briefe schreiben, dass das Postamt in Verlegenheit kommen wuerde. "));
  AddDetail( ({ "post", "mail" }),
    BS("Du musst Deine Post nicht untersuchen, tippe 'post' oder 'mail' um Briefe zu lesen "+
    "oder zu schreiben. "));
  AddDetail( ({ "postamt" }),
    BS("Ein einfaches aber sehr wichtiges Gebaeude. Hier werden taeglich viele Briefe "+
    "gelesen, geschrieben und zugestellt. Ueber das Zustellen aber brauchst Du Dir keine "+
    "Gedanken machen. "));
  AddDetail( ({"holz"}),
    BS("Ganz normales Holz."));
  AddDetail( ({"leute", "leuten"}),
    BS("Jeder!"));
  AddDetail( ({"schreiben"}),
    BS("Dazu bist auch Du faehig."));
  AddDetail( ({"schreibkabinen"}),
    BS("Da kannst Du ganz fuer Dich alleine Deine Post abwickeln."));
  AddDetail( ({"gedanken"}),
    BS("Deine Gedanken gehoeren Dir."));
  AddDetail( ({"gebaeude"}),
    BS("Du bist hier in der Post vom Dorf Friedheim."));
  AddDetail( ({"sorgen"}),
    BS("Hast Du denn welche?"));
  AddDetail( ({"verlegenheit"}),
    BS("Niemand kommt hier in Verlegenheit. Hoechstens bei dem ein oder anderen Liebesbrief."));
  AddDetail( ({"zustellen"}),
    BS("Das erledigt die Post fuer Dich."));
  AddDetail( ({"welt"}),
    BS("Versuchs etwas kleiner. Zuviel auf einmal schadet nur."));
  AddDetail( ({"friedheim", "dorf"}),
    BS("Du befindest Dich hier in der Post von Dorf Friedheim."));
  AddDetail( ({"holzbohlen"}),
    BS("Der Boden besteht aus einfachen Holzbohlen."));
  AddDetail( ({"liebesbrief"}),
    BS("Verschick doch mal einen, damit machst Du jemandem bestimmt eine Freude."));
  AddDetail( ({"freude"}),
    BS("Es wuerde jemandem eine Freude bereiten, einen lieben Brief von Dir zu bekommen!"));/*
  AddDetail( ({""}),
    BS(""));
*/
     
  /*Ausgaenge*/
  AddExit( "osten", DORF + "friedheim_dorf_d6.lpc" );
  // EXITS END
   
  /*Objekte und NPCs*/
  AddItem( "std/postschalter.lpc", REFRESH_REMOVE );
}
