  AddDetail( ({ "geraeuschkulisse" }),
    BS("Versuchs mal lieber mit lauschen."));
  AddDetail( ({ "uhrzeit" }),
    BS("Nachmittag!"));
  AddDetail( ({ "nachmittag" }),
    BS("Hier ist das jetzt gerade so."));
*/
