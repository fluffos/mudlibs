#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Licht dringt von oben durch das Loch herein und erhellt notduerftig den Raum. "+
  "Du kannst hier dem Licht entgegenklettern, um zurueck in den Keller zu gelangen. "+
  "In welche Richtung Du Dich auch bewegst, dort wird tiefe Finsternis herrschen. "+
  "Hoffentlich hast Du eine Fackel oder andere Lichtquelle bei Dir. "));
  
  AddDetail( ({ "licht", "fackel", "lichtquelle" }),
  BS("Wenn Du von hier tiefer in die Hoehle eindringen willst so brauchst Du eine "+
  "Lichtquelle, zum Beispiel eine Fackel. "));
  AddDetail( ({ "finsternis", "dunkel" }),
  BS("Ab hier herrscht absolute Finsternis in der Hoehle. Du brauchst eine Fackel "+
  "oder andere Lichtquelle um dich weiter zu wagen. "));  
  AddDetail( ({ "burg", "friedheim" }),
  BS("Die Burg Friedheim befindet sich direkt ueber Dir. Du kannst hier "+
  "hochklettern zurueck in den Keller der Burg. "));
  AddDetail( ({ "beispiel" }),
  BS("Eine Fackel waere eine gute Lichtquelle hier unten."));
  AddDetail( ({ "loch" }),
  BS("Durch das Loch in der Decke kannst Du wieder hoch klettern."));
  
  AddCmd( ({ "klettere", "steige", "kletter", "steig" }), "klettere_hoch" );

  AddExit( "sueden", KELLER + "zs_sublevel1_a3.lpc" );
}
  
int klettere_hoch(string str)
{
  notify_fail("Wohin willst Du denn klettern? \n");
  if( str != "hoch" && str != "hinauf" && str != "dem licht entgegen" && str != "zurueck in keller" &&  str != "zurueck in den keller" ) return 0;
  write( "Du kletterst vorsichtig die Felsen hoch, zurueck in den Keller. \n");
  TP->move(KELLER + "zs_keller_c3.lpc", M_GO, "vorsichtig die Felsen hoch, zurueck in den Keller. ",
  "klettert" , "kommt heraufgeklettert");
  return 1;
}