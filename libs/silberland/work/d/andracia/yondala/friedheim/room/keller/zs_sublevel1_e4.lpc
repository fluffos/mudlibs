#include "../def.h"

inherit KELLER+"zs_sublevel1_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG) +
  BS("Der Kalkstein hat an der Wand hier ein eindrucksvolles Gebilde erzeugt: "+
  "es aehnelt einem Wasserfall mit vielen Stufen, besteht allerdings aus "+
  "Kalkstein. Wasser rieselt bestaendig daran herab. "));

  AddDetail( ({ "wasserfall" }),
  BS("Der Kalkstein hat hier einen steinernen Wasserfall erzeugt. "+
  "Wasser rieselt bestaendig daran herab. "));
  AddDetail( ({ "stufen" }),
  BS("Der steinerne Wasserfall besteht aus vielen Stufen an denen "+
  "bestaendig Wasser herab rieselt. "));
  AddDetail( ({ "wasser", "strom" }),
  BS("Das Wasser tropft hier nicht nur von der Decke sondern rieselt auch "+
  "in einem bestaendigem Strom den steinernen wasserfall herab. Du kannst "+
  "davon trinken wenn Du willst. "));
  AddCmd( ({ "trinke", "trink" }), "trinke_wasser" );

  AddExit( "nordwesten", KELLER + "zs_sublevel1_d3.lpc" );
  AddExit( "osten", KELLER + "zs_sublevel1_f4.lpc" );
  
  AddItem( NPC + "kellermonster_assel.lpc", REFRESH_DESTRUCT );

}

int trinke_wasser(string str)
{
  notify_fail("Was willst Du trinken? ");
  if( str != "wasser" && str != "vom wasserfall" ) return 0;
  if( TP->drink_soft(30) ) {
  write("Du haelst deine Haende an den Wasserfall und trinkst etwas Wasser. \n");
  say( TPN + " haelt seine Haende an den Wasserfall und trinkt etwas Wasser. \n");
  TP->AddHp(10);
  TP->AddSp(10); }
  return 1;
}
