#include "../def.h"

inherit WEGE+"weg_zur_burg_raw.lpc";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Du hast hier das Ende direkt an der Zugbruecke erreicht.") );

  AddDetail( ({"ende", "zugbruecke"}), BS(
    "Die Zugbruecke ist herabgelassen und es steht dir nichts entgegen die Burg zu betreten." ));
    
  AddExit( "norden", BURG "zs_burg_eg_b5" );
  AddExit( "sueden", WEGE "weg_zur_burg_a2" );
}
