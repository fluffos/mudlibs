inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

int kammer;

reset() {
  ::reset();
  kammer = 0; // fuer geschlossen 0 - fuer offen 1 (bei reset wieder abschliessen)
}

create()
{
  ::create();
  kammer = 0; // fuer geschlossen 0 - fuer offen 1
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));
  SetProp( P_INT_SHORT, "Erdgeschoss des Bergfrieds zu Friedheim" ); 
  SetProp( P_INT_LONG,  BS("Du befindest Dich in der Eingangshalle des Bergfrieds zu Friedheim. "+
  "In der Suedwand befindet sich das beschlagene Fluegeltor durch Du das Gebaeude verlassen kannst. "+
  "Eine breite steinerne Treppe an der Ostwand fuehrt in den ersten Stock. Die hoelzerne Decke "+
  "ist recht hoch und Fahnen haengen herunter. An der Westwand werden Prunkschilde und Waffen "+
  "ausgestellt. Auch eine kleiner Durchgang fuehrt in den Westen weiter. In der Nordwand befindet sich "+
  "eine grosse Tuer und als Schmuck sind dort rechts und links grosse Wandteppiche aufgehaengt. "));
   
  /* Sounds und Smells */
  AddSound( DEFAULT_SOUND,
  BS("Es sind keine besonderen Geraeusche zu hoeren."));
  AddSound( ({ "geraeusche" }),
  BS("Es sind wirklich keine besonderen Geraeusche zu hoeren."));
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nichts besonderes riechen."));
  
  /* Details */ 
  AddDetail( ({ "decke" }),  
  BS("Bunte Fahnen haengen von der Decke. Alle haben als Motiv das Wappen des Freiherrn von Friedheim. "));
  AddDetail( ({ "boden", "steinen", "steine" }),
  BS("Der Boden besteht aus glatten Steinen."));
  AddDetail( ({ "waende" }),
  BS("In der Suedwand befindet sich das beschlagene Fluegeltor durch Du das Gebaeude verlassen kannst. "+
  "Eine breite steinerne Treppe an der Ostwand fuehrt in den ersten Stock. An der Westwand "+
  "werden Prunkschilde und Waffen ausgestellt. Auch eine kleiner Durchgang fuehrt in den Westen "+
  "weiter. In der Nordwand befindet sich eine grosse Tuer und als Schmuck sind dort rechts und links "+
  "grosse Wandteppiche aufgehaengt. "));
  AddDetail( ({ "nordwand" }),
  BS("Die grosse Tuer scheint in einen grossen Hauptsaal zu fuehren. Die Wandteppiche rechts und links der "+
  "Tuer sind bemerkenswert. "));
  AddDetail( ({ "ostwand" }),
  BS("An dieser Wand fuehrt eine steinerne Treppe empor. Ein schoenes Gelaender soll verhindern dass man "+
  "aus versehen von der Treppe stuerzt. Unterhalb der Treppe ist alles mit Holz verkleidet. "));
  AddDetail( ({ "suedwand" }),
  BS("In der Suedwand befindet sich das beschlagene Fluegeltor das auf den Burghof fuehrt. Neben dem Tor wurden "+
  "zwei grosse Statuen aufgestellt, jeweils rechts und links des Tors steht eine. "));
  AddDetail( ({ "westwand" }),
  BS("Die Westwand ist mit vielen Schilden und Waffen behangen. Viele zeigen das Wappen derer von Friedheim. "+
  "Ein Durchgang fuehrt hier weiter. "));
  AddDetail( ({ "erdgeschoss", "gelaende" }),  
  BS("Das Stockwerk das ebenerdig zum umliegenden Gelaende ist nennt man Erdgeschoss. "));
  AddDetail( ({ "stockwerk", "etagen", "etage", "stock" }),  
  BS("Du befindest Dich im Erdgeschoss. "));
  AddDetail( ({ "statuen", "statue" }),  
  BS("Welche Statue willst Du denn untersuchen? Die linke Statue oder die rechte Statue? "));
  AddDetail( ({ "linke statue", "statue links" }),  
  BS("Die linke Statue stellt einen Krieger dar der sich auf sein Schwert stuetzt. "));
  AddDetail( ({ "rechte statue", "statue rechts" }),  
  BS("Die rechte Statue verkoerpert einen Magier mit Mantel und Hut der gerade aus einem Buch liest. "));
  AddDetail( ({ "bergfried", "friedheim", "burg", "bergfrieds", "burgfried", "gebaeude" }),  
  BS("Du befindest Dich im Erdgeschoss des Bergfrieds der Burg zu Friedheim. "));
  AddDetail( ({ "beschlag", "beschlaege" }),  
  BS("Mit mehreren Metallplatten wurde das Fluegeltor beschlagen. "));
  AddDetail( ({ "prunkschilde", "schilde" }),  
  BS("Die Schilde scheinen den Vorfahren des Freiherrn gehoert zu haben. "));
  AddDetail( ({ "waffen" }),  
  BS("Viele der Waffen sind mit allerhand Schmuck ausgefuehrt und gehoerten wohl den Vorfahren des Freiherrn. "));
  AddDetail( ({ "fahnen" }),  
  BS("Alle haben als Motiv das Wappen des Freiherrn von Friedheim. Sie haengen von der Decke. "));
  AddDetail( ({ "treppe", "steinsaeulen" }),
  BS("Die steinerne Treppe hat ein steinernes Gelaender aus schoen geformten kleinen Steinsaeulen und "+
  "einer schmalen Marmorplatte als oberen Abschluss. Unterhalb der Treppe ist alles mit Holz vekleidet. "));
  AddDetail( ({ "gelaender", "marmor", "marmorplatte", "gelaenders", "marmorplatten", "ebene" }),
  BS("Die Marmorplatten liefern eine schiefe glatte Ebene von oben die ganze Treppe herunter. Kann "+
  "man bestimmt gut herunterrutschen. "));
  AddDetail( ({ "wandteppiche", "teppiche", "wandteppich", "teppich" }),
  BS("Welchen Wandteppich willst Du denn untersuchen? Den linken Wandteppich oder den rechten Wandteppich? "));
  AddDetail( ({ "teppich links", "linken teppich", "wandteppich links", "linken wandteppich", "linker teppich", "linker wandteppich" }),
  BS("Der linke Teppich zeigt einen Krieger der mit seinem Schwert und Schild mutig einem drachenaehnlichen Monster "+
  "entgegen tritt. Der Drache ist sehr detailreich dargestellt und die besonders kleinen Knoten zeugen von einer "+
  "unglaublich fingerfertigen Handwerkskunst des Kuenstlers. "));
  AddDetail( ({ "teppich rechts", "rechten teppich", "wandteppich rechts", "rechten wandteppich", "rechter teppich", "rechter wandteppich" }),
  BS("Der rechte Teppich zeigt einen Magier der ein drachenaehnliches Wesen beschwoert. Der Drache ist sehr detailreich "+
  "dargestellt und die besonders kleinen Knoten zeugen von einer unglaublich fingerfertigen Handwerkskunst des Kuenstlers. "));
  AddDetail( ({ "tuer", "tor", "tueren", "fluegeltor" }),
  BS("Die grosse Tuer in der Nordwand fuehrt weiter in den Burgfried. Das beschlagene Tor im Sueden fuehrt "+
  "hinaus auf den Burghof. "));
  AddDetail( ({ "durchgang" }),
  BS("Der Durchgang im Westen fuehrt wohl in die Kueche. "));
  AddDetail( ({ "schmuck" }),
  BS("An der Decke sind Fahnen als Schmuck, an der Westwand schmuecken Prunkschilde und Waffen den Raum und "+
  "an der Nordwand haengen zwei Wandteppiche. "));
  AddDetail( ({ "holzverkleidnung", "verkleidung" }),
  BS("Gut versteckt in der Verkleidung kannst Du eine kleine Holztuer erkennen, durch die man wohl einen kleinen "+
  "Raum unter die Treppe erreichen kann. "));
  AddSpecialDetail( ({ "holztuer" }), "u_holztuer" ); // unterschiedlich fuer offen und geschlossen
  AddSpecialDetail( ({ "kammer" }), "u_kammer" ); // unterschiedlich fuer offen und geschlossen
  AddDetail( ({"burghof", "hof"}),
  BS("Dazu musst Du durch das Tor im Sueden gehen."));
  AddDetail( ({"abschluss"}),
  BS("Marmorplatten bilden den oberen Abschluss des Gelaenders."));
  AddDetail( ({"eingangshalle", "halle", "raum"}),
  BS("Du befindest Dich in der Eingangshalle des Bergfrieds zu Friedheim. "+
  "In der Suedwand befindet sich das beschlagene Fluegeltor durch Du das Gebaeude verlassen kannst. "+
  "Eine breite steinerne Treppe an der Ostwand fuehrt in den ersten Stock. Die hoelzerne Decke "+
  "ist recht hoch und Fahnen haengen herunter. An der Westwand werden Prunkschilde und Waffen "+
  "ausgestellt. Auch eine kleiner Durchgang fuehrt in den Westen weiter. In der Nordwand befindet sich "+
  "eine grosse Tuer und als Schmuck sind dort rechts und links grosse Wandteppiche aufgehaengt. "));
  AddDetail( ({"freiherr", "freiherrn"}),
  BS("Der Freiherr ist sicher in den oberen Etagen zu finden."));
  AddDetail( ({"hauptsaal", "saal"}),
  BS("Durch die grosse Tuer im Norden kommt man in den Hauptsaal."));
  AddDetail( ({"kueche"}),
  BS("Hinter dem kleinen Durchgang im Westen ist scheinbar in die Kueche."));
  AddDetail( ({"holz"}),
  BS("Ganz normales Holz."));
  AddDetail( ({"motiv", "wappen", "drache", "grund"}),
  BS("Das Wappen von Friedheim ist ein silberener Drache auf rotem Grund."));
  AddDetail( ({"wand"}),
  BS("Welche Wand willst Du untersuchen? In jeder Himmelsrichtung ist eine."));
  AddDetail( ({"himmelsrichtung", "himmelsrichtungen"}),
  BS("Norden, Sueden, Osten und Westen."));
  AddDetail( ({"handwerkskunst", ""}),
  BS("Wirklich beeindruckend. Du selbst wuerdest das nie hinbekommen."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
   
  /* Exits */
  AddExit( "norden", BURG + "zs_burg_eg_b1.lpc" );
  AddExit( "sueden", BURG + "zs_burg_eg_b3.lpc" );
  AddExit( "westen", BURG + "zs_burg_eg_a2.lpc" );
  AddExit( "oben", BURG + "zs_burg_og1_b2.lpc" );
   
  /*Aktivierung Interaktion*/
  AddCmd( ({"schliesse", "verschliesse", "oeffne"}), "fail");  

  
  // AddItem( "file", refresh, Props);
   
}

/*Deklaration Interaktion*/
int fail(string str) 
{
  notify_fail("Was willst Du tun?\n");
  if( str != "holztuer" && str != "kammer" ) return 0;
  kammer = 1;
  write(BS("Du hast nicht den passenden Schluessel. "));
  return 1;
}

int oeffne_tuer(string str) // soll vom Schluessel aufgerufen werden
{
  notify_fail("Was willst Du oeffnen? ");
  if( str != "holztuer" && str != "kammer" )
      return 0;
  kammer = 1;
  write(BS("Du oeffnest die kleine Holztuer. Nun kannst Du ins Innere einer kleinen Kammer blicken. "));
  say(BS(capitalize(this_player()->name())+ " verschliesst eine gut versteckte Holztuer unter der Treppe. "));
  return 1;
}

int schliesse_tuer(string str) // soll vom Schluessel aufgerufen werden
{
  notify_fail("Was willst Du abschliessen? ");
  if( str != "holztuer" && str != "kammer" )
      return 0;
  kammer = 0;
  write(BS("Du schliesst die kleine Holztuer ab. Nun kann man das Innere der kleinen Kammer nicht mehr untersuchen. "));
  say(BS(capitalize(this_player()->name())+ " oeffnet eine gut versteckte Holztuer unter der Treppe. "));
  return 1;
}

int u_holztuer(string str) 
{
  if( kammer == 1 )
  {
    write(BS("Die kleine Holztuer ist offen und man kann daher einen Blick ins Innere einer kleinen Kammer werfen. "));
    return 1;
  }
  else
  {  
    write(BS("Die kleine Holztuer ist leider abgeschlossen. "));
    return 1;
  }
}

int u_kammer(string str)  
{ 
  if( kammer == 1 ) 
  {
    write(BS("Die Kammer ist leer. ")); // mal schauen was man da einbauen kann
    return 1; 
  }
  else
  {  
    write(BS("Die kleine Holztuer zur Kammer ist leider abgeschlossen. ")); 
    return 1; 
  }
}