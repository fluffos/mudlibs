//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Dach des Bergfrieds" ); 
  SetProp( P_INT_LONG,  
  BS("Du stehst auf dem Dach des Bergfrieds. "+
  "Ueber die Zinnen hinweg hat man in westlicher und suedlicher Richtung eine gute Aussicht ueber das "+
  "umliegende Huegelland. ")+
  BS("Ein Schild wurde hier aufgestellt.") );
     
  AddDetail( ({ "himmel", "wetter" }),  
  BS("Schoenes Wetter heute! Du erkennst einen tiefblauen Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. "));
  AddDetail( ({ "boden" }),
  "Der Boden ist mit groben Steinen gepflastert. \n" );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke", "burgmauer", "steine", "stein", "burgmauern" }),
  BS("Die steinernen Aussenwaende des Bergfrieds und der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. "));
  AddSound( DEFAULT_SOUND,
  "Aus dem Osten dringen leise Arbeitsgeraeusche einer Schmiede an Dein Ohr. \n" );
  AddSmell( DEFAULT_SMELL,
  "Du kannst nur den leichten Geruch einer Feuerstelle wahrnehmen. \n" );
  
  AddDetail( ({ "friedheim", "burg" }),
  "Du bist in der Burg zu Friedheim. \n" );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen, wieviel Muehe und Aufwand an Frohnarbeit es benoetigt, solch ein wehrhaftes Gebaeude zu bauen. "));
  AddDetail( ({ "bauwerk", "gebaeude" }),
  "Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. \n" );
  AddDetail( ({ "innere" }),
  "Du musst die Treppe runter um das Innere des Turms zu erkunden. \n" );
  AddDetail( ({ "turm", "tuerme" }),
  "Das Innere des Turms kannst Du mit der Treppe erreichen. \n" );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  "Kleine weisse Schaefchenwolken. \n" );
  AddDetail( ({ "grundriss", "seite" }),
  BS("Annaehernd quadratisch, nimmst Du an. Eine Seite misst so 50 Schritt. "));
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "));
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante Deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet, wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. "));
  AddDetail( ({ "dach" }),
  "Du kannst nichts Interessantes finden. \n" );
  AddSmell( ({ "feuerstelle", "rauch" }),
  "Rauch eben. \n" );
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  BS("Das typisch metallisch klingende Geraeusch, wenn ein Hammer auf warmes Eisen auf dem Amboss trifft. "));
  AddDetail( ({ "richtung" }),
  BS("Was fuer eine Richtung auch immer .. such Dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "huegelland", "aussicht", "ueberblick" }),
  BS("Soweit das Auge reicht, kannst Du nur fruchtbares Huegelland um die Burg herum erkennen."));
  AddDetail( ({ "burghof", "hof" }),
  BS("Vom Turm aus hat man einen sehr guten Ueberblick auf den Burghof. "));
  AddDetail( ({ "belagerung" }),
  BS("Zur Zeit ist keine Belagerung im Gange."));
  AddDetail( ({ "innere", "raeume" }),
  "Du musst die Treppe runter um das Innere des Turms zu erkunden. \n");
  AddDetail( ({ "amboss", "eisen", "schmied", "hammer" }),
  BS("Das findet man im Burghof in der Burgschmiede."));
  AddDetail( ({ "schmeide", "burgschmiede" }),
  BS("Die Burgschmiede kann man von hier aus nicht sehen."));
  AddSmell( ({ "geruch" }),
  BS("Hier oben kann man noch ein bischen vom Rauch der Schmiede riechen."));
  AddDetail( ({ "treppe" }),
  BS("Die Treppe nach unten befindet sich nordoestlich."));
  AddDetail( ({ "hoehe" }),
  BS("Das Dach hat eine schwindelerregende Hoehe. Man kann von hier aus das ganze Huegelland ueberblicken."));
  AddDetail( ({ "schild", "holzschild" }),
  BS("Ein ganz normales Holzschild mit Hinweisen darauf geschrieben.") );
  AddReadDetail( ({ "schild", "holzschild" }),
    "+---------------------------------------------------+\n"+ 
    "| Der Adler, ein Gefaehrte der Elfen, nimmt ab hier |\n"+ 
    "| Reisende mit nach Poesie, dem Dorf der Blauelfen, |\n"+ 
    "| und ueber die Berge, zum Tal der Waldelfen.       |\n"+ 
    "+---------------------------------------------------+\n" ); 
  AddDetail( ({ "auge", "augen" }),
  BS("Deine Augen sind immernoch in deinem Kopf.") );
  AddDetail( ({ "zeit" }),
  BS("Die Zeit vergeht...") );
  AddDetail( ({ "schritt" }),
  BS("Ein kurzer Griff - alles noch da(oder nicht)!") );
  AddDetail( ({ "detail" }),
  BS("Welches Detail willst Du untersuchen?") );
  AddDetail( ({ "steinmetz", "steinmetze" }),
  BS("Du schaust Dich um - kein Steinmetz da!") );

/*
  AddDetail( ({ "" }),
  BS("") );
*/  
  
  AddExit( "osten", BURG + "zs_burg_dach_b2" );
  AddExit( "nordosten", BURG + "zs_burg_dach_b1" );
  AddExit( "norden", BURG + "zs_burg_dach_a1" );

  AddItem( OBJ+"adler.lpc", REFRESH_NONE, 1 );

}
