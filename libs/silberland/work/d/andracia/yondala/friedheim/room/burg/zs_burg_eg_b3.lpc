//23.2.2019 Yondala@SilberLand funktioniert
inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 0);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Burghof zu Friedheim" ); 
  SetProp( P_INT_LONG, BS("Du stehst auf dem Burghof zu Friedheim. Gleich im Sueden ist das Torhaus, "+
  "durch das Du die Burg ueber die Zugbruecke verlassen kannst. Im Norden ragt der grosse "+
  "Bergfried in die Hoehe. Ein erhoeht angebrachtes beschlagenes Fluegeltor fuehrt ins Innere "+
  "des maechtigen Bauwerks. Im Suedwesten und Suedosten stehen zwei Tuerme und rahmen das "+
  "Torhaus ein. Der Burghof erstreckt sich weiter nach Nordosten, Osten und Westen. "));
   
  AddDetail( ({"burgmauer"}), 
  BS("Du kannst auf der Burgmauer einen Wehrgang erkennen. Mehrere Burgwachen laufen darauf entlang."));
  AddDetail( ({"stockwerk"}), 
  BS("Du befindest Dich auf dem Burghof und nicht in einem Stockwerk."));
 
  AddDetail( ({"angriff", "belagerung", "feinde"}), 
  BS("Gerade sind keine Feinde dabei die Burg anzugreifen oder zu belagern."));
  AddDetail( ({ "himmel", "wetter" }),  
  BS("Schoenes Wetter heute! Du erkennst ein tiefblauer Himmel und nur ein paar kleine Gutwetterwolken zeigen sich. ")  );
  AddDetail( ({ "boden", "burghof", "hof" }),
  BS("Der Boden besteht aus groben Pflastersteinen. ")  );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke" }),
  BS("Die steinernen Aussenwaende des Torhauses und der Burgmauern scheinen die Arbeit von faehigen Steinmetzen zu sein. ")  );
  AddSound( DEFAULT_SOUND,
  BS("Aus dem Suedosten dringen Arbeitsgeraeusche einer Schmiede an Dein Ohr. ")  );
  AddSmell( DEFAULT_SMELL,
  BS("Du kannst nur den leichten Geruch einer Feuerstelle wahrnehmen. ")  );
   
  AddDetail( ({ "friedheim", "burg" }),
  BS("Du stehst doch mitten auf dem Burghof der Burg zu Friedheim. ")  );
  AddDetail( ({ "torhaus", "haus" }),
  BS("Durch das Torhaus im Sueden kann man die Burg ueber die Zugbruecke verlassen. Einen Zugang kannst Du nicht erkennen. ")  );
  AddDetail( ({ "zugbruecke", "bruecke" }),
  BS("Durch das grosse Tor im Torhaus kannst Du die Zugbruecke erkennen. Sie ist herabgelassen. ")  );
  AddDetail( ({ "bergfried" }),
  BS("Ein imposantes Bauwerk. Massive Mauern, eine beindruckende Hoehe und ein grosser Grundriss lassen "+
  "erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt solch ein wehrhaftes Gebaeude zu bauen. ")   );
  AddDetail( ({ "fluegeltor", "tor" }),
  BS("Durch das grosse Fluegeltor kann man ins Innere des Bergfrieds. Es ist mit Metallplatten beschlagen. ")  );
  AddDetail( ({ "innere" }),
  BS("Dazu musst Du den Bergfried durch das beschlagene Tor schon durchschreiten. ")  );
  AddDetail( ({ "bauwerk", "gebaeude" }),
  BS("Welches Bauwerk willst Du denn untersuchen? Es gibt hier mehrere. ")  );
  AddDetail( ({ "turm", "tuerme" }),
  BS("Die Tuerme im Suedwesten und Suedosten rahmen das Torhaus ein. Ein kleiner Wehrgang auf der Burgmauer "+
  "verbindet die jeweils oberen Stockwerke von Turm und Torhaus. ")  );
  AddDetail( ({ "zugang", "eingang" }),
  BS("Ein Zugang ins Innere des Torhauses kannst Du nicht erkennen. Der Eingang zum Bergfried ist im Norden. ")  );
  AddDetail( ({ "schoenwetterwolke", "schoenwetterwolken", "gutwetterwolke", "gutwetterwolken", "wolke", "wolken", "schaefchenwolken", "schaefchenwolke" }),
  BS("Kleine weisse Schaefchenwolken. ")  );
  AddDetail( ({ "hoehe" }),
  BS("Der Bergfried hat wohl 4 Stockwerke. Die oberste Kante ist mit Zinnen bewehrt. ")  );
  AddDetail( ({ "grundriss", "seite" }),
  BS("Einen annaehernd quadratischen Grundriss nimmst Du an. Eine Seite misst so 50 Schritt. ")  );
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "metallplatten", "platten", "beschlag" }),
  BS("Das Tor zum Bergfried wird dadurch einem Angriff laenger widerstehen. "));
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man Wehrgang. "));
  AddDetail( ({ "kante" }),
  BS("Du untersuchst die Kante deiner Waffe - pass blos auf dass Du Dich nicht schneidest. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang oder dem Dach des Bergfried eine Belagerung abwehren will. ") );
  AddDetail( ({ "dach" }),
  BS("Dazu musst Du erst einmal aufs Dach um das zu tun. "));
  AddDetail( ({"schritt"}),
  BS("Du kannst das Gebaeude ja abschreiten und nachmessen."));
  AddDetail( ({"steinmetz", "steinmetzen", "handwerker"}),
  BS("Die Arbeit wurde schon lange erledigt. Die Handwerker sind nicht mehr da."));
  AddDetail( ({"steine", "pflastersteine", "pflastersteine"}),
  BS("Ganz normale Pflastersteine."));
  AddDetail( ({"ohr"}),
  BS("Du kannst damit hoeren."));
  AddDetail( ({"schmiede"}),
  BS("Die Schmiede scheint sich im Suedosten zu befinden"));
  AddDetail( ({"burgwachen", "wachen"}),
  BS("Auf dem Wehrgang laufen sie."));
  AddDetail( ({"geruch"}),
  BS("Versuchs mal mit riechen."));
   
  AddSmell( ({"geruch"}),
  BS("Nur ein leichter Geruch einer Feuerstelle."));
  AddSmell( ({ "feuerstelle", "rauch" }),
  BS("Rauch eben. "));
  AddSound( ({ "arbeitsgeraeusche", "arbeit", "geraeusche", "arbeitsgeraeusch", "geraeusch" }),
  BS("Das typisch metallisch klingenden Geraeusch wenn ein Hammer warmes Eisen auf dem Amboss trifft. ")  );
  AddSound( ({"eisen", "amboss", "hammer"}),
  BS("Ein typisch metallisches *kloing*."));
/*
  AddDetail( ({"", ""}),
  BS(""));
*/   
   
  // END DETAILS
  AddExit( "norden", BURG + "zs_burg_eg_b2" );
  AddExit( "nordosten", BURG + "zs_burg_eg_c2" );
  AddExit( "osten", BURG + "zs_burg_eg_c3" );
  AddExit( "sueden", BURG + "zs_burg_eg_b4" );
  AddExit( "westen", BURG + "zs_burg_eg_a3" );

  // END EXITS
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT );
  AddItem( NPC + "burgwache.lpc", REFRESH_DESTRUCT ); 
}
