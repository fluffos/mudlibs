// 26.02.2019 Yondala@SilberLand: Weg freigegeben, Friedheim ist nun auch fuer Spieler zugaenglich

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Dorf Friedheim" );
  SetProp( P_INT_LONG,
    "Du stehst im Torhaus des oestlichen Eingangs zum Dorf Friedheim. "
    "Das Tor ist offen und das Fallgitter ueber Dir zeigt mit seinen metallenen "
    "Spitzen direkt auf Dich herunter. Hoffentlich laesst man es nicht "
    "herabsaussen solange Du daraunter stehst. Im Westen kannst Du den "
    "Dorfplatz erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddSound( DEFAULT_SOUND,
    "Du kannst ein paar Voegel zwitschern hoeren.");
  AddSound( ({ "zwitschern" }),
    "Sehr nett.");
 
  AddSmell( DEFAULT_SMELL,
    "Nur der staubige Geruch der Strasse. ");
  AddSmell( ({ "strasse", "geruch" }),
    "Hauptsaechlich riecht es nach Staub.");
  AddSmell( ({ "staub" }),
    BS("Der Staub kitzelt Dich in der Nase."));
  AddSmell( ({ "nase" }),
    BS("Deine Nase riecht nach Dir."));


  AddDetail( ({ "torhaus", "stadtmauer", "mauer", "haus", "mauerwerk" }),
    "Im Grunde ist das Torhaus nur ein etwas dickeres Stueck Stadtmauer " 
    "mit einem Tor darin. Ein hochgezogenes Fallgitter ist auch zu sehen.");
  AddDetail( ({ "stadtwache", "wache" }),
    "Wo sich die wohl herumtreibt?");
  AddDetail( ({ "strasse", "weg", "pflaster", "plastersteine", "steine" }),
    "Der Weg ist mit groben Steinen gepflastert.");
  AddDetail( ({ "eintritt", "wegezoll", "zoll" }),
    "Nein - niemand da, der Wegezoll verlangt."); 
  AddDetail( ({ "fallgitter" , "gitter" }),
    "Das Fallgitter besteht aus Metall und die untersten Spitzen zeigen genau "
    "auf Dich herab."); 
  AddDetail( ({ "burg", "friedheim" }),
    "Die Stadtmauer versperrt Dir die Sicht zur Burg.");
  AddDetail( ({ "dorf", "stadt", "haeuser", "gruppe" }),
    "Eine kleine Gruppe Haeuser umgeben von einer kleinen Stadtmauer. "
    "Du bist im oestlichen Eingang der Stadt.");
  AddDetail( ({ "eingang", "tor" }),
    "Das Tor ist offen.");
  AddDetail( ({ "steine" }),
    "Gerade gut genug fuer einen maessig bequemen Transport mit der Kutsche.");
  AddDetail( ({ "asphalt", "gummi" }),
    BS("Das gibt es hier sicher nicht."));
  AddDetail( ({ "boden" }),
    BS("Pflastersteine bilden bis hier ins Torhaus hinein den Boden. Unter dem "+
    "Fallgitter sind Vertiefungen im Boden zu sehen."));
  AddDetail( ({ "vertiefungen" }),
    BS("Dort wird das Fallgitter wohl reinpassen."));
  AddDetail( ({ "decke" }),
    BS("In der Decke des Torhauses kann man die untersten Spitzen eines Fallgitters sehen."));
  AddDetail( ({ "spitzen", "metall" }),
    BS("Die metallenen Spitzen des Fallgitters schauen aus der Decke."));
  AddDetail( ({ "wand", "waende" }),
    BS("Diese Torhaus ist nur ein etwas dickeres Stueck Stadtmauer und Du erkennst nur einfaches "+
    "Mauerwerk."));
  AddDetail( ({ "dorfplatz" }),
    BS("Dieses Torhaus fuehrt direkt auf den Dorfplatz. Noch ein bischen nach westen und Du "+
    "stehst schon mittendrauf."));
  AddDetail( ({ "kutsche", "transport", "reisekutsche" }),
    BS("Die Reisekutsche haelt direkt vor dem Tempel auf dem Dorfplatz. "));
  AddDetail( ({ "sicht" }),
    BS("Du stehst im Torhaus! Da ist die Sicht nun mal ein bischen eingeschraenkt."));
  AddDetail( ({ "stueck" }),
    BS("Das siehst Du hier nicht."));
  AddDetail( ({ "grunde" }),
    BS("Was untersuchst Du denn Hier?"));
  AddDetail( ({ "hier" }),
    BS("Nu lass den Quatsch!"));
  AddDetail( ({ "quatsch" }),
    BS("Gleich kommt eine Skriptfalle!"));
  AddDetail( ({ "skriptfalle" }),
    BS("Letzte Chance!"));
  AddDetail( ({ "chance", "glueck" }),
    BS("Hast Du ein Glueck, dass diese Skriptfalle hier nicht funktioniert und jetzt konzentrier Dich."));
  AddDetail( ({ "voegel" }),
    BS("Du kannst leider keine Voegel entdecken."));
  AddDetail( ({ "tempel" }),
    BS("Von hier aus siehst Du ihn nur sehr undeutlich."));

	
	
/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddRoomMessage( ({"Die Kutsche kommt vorbei.\n"}), 210 );

  AddExit( "westen", DORF + "friedheim_dorf_d4" );



  // AddSpecialExit( "osten", "weg_geschlossen" );
  AddExit( "osten", WEGE + "weg_zum_dorf_a1" );
  // EXITS END
}

int weg_geschlossen(string Dir)
{
	notify_fail( "Das Tor ist zur Zeit geschlossen! \n");
	return 0;
}

