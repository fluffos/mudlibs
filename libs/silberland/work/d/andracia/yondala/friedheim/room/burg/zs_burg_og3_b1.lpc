#include "../def.h"

#include <properties.h>
#include <moving.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Spielzimmer");
  SetProp (P_INT_LONG,
    "Du befindest Dich im Spielzimmer der Burg von Friedheim. Alle "+
    "moeglichen Musikinstrumente und Dinge zur Unterhaltung sind hier "+
    "untergebracht. Ueber eine kleine Treppe kann man von hier aus das "+
    "Dach erreichen.");

  AddDetail( ({ "decke" }),  
  "Hoch ueber Dir kannst Du eine hoelzerne Decke erkennen. \n");
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus massiven Holzbohlen. \n");
  AddDetail( ({ "waende", "wand" }),
  BS("Die Waende sind alle aus Stein. Gemaelde wurden hier aufgeaengt. "));
  AddSound( DEFAULT_SOUND,
  BS("Aus der Spieldose im Westen dringt Musik an Dein Ohr."));
  
  AddDetail( ({ "spielzimmer", "zimmer", "raum" }),
    BS("Dies ist das Spielzimmer der Burg von Friedheim. Musikinstrumente, "+
    "Spielzeuge und vieles mehr ist hier zu finden. Auf einem Tisch an der Westwand "+
    "ist eine Spieldose, die den Raum mit Musik erfuellt. "));
  AddDetail( ({ "friedheim", "burg" }),
    BS("Du bist im obersten Stockwerk des Burgfrieds zu Friedheim. "));
  AddDetail( ({ "musikinstrumente", "instrumente", "dinge", "spielzeuge" }),
    BS("Ein Spinett, eine Tuba und ein Schaukelpferd sind groesseren Dinge die "+
    "Dir auffallen. "));
  AddDetail( ({ "unterhaltung" }),
    BS("Hier kann man Musik machen, oder den Kleinen beim Schaukeln auf dem Schaukelpferd zuschauen. "));
  AddDetail( ({ "treppe" }),
    BS("Die schmale Treppe fuehrt zu einer Dachluke, die zum Dach hinauffuehrt. "));
  AddDetail( ({ "dach" }),
    BS("Dazu musst Du schon nach oben gehen. "));
  AddDetail( ({ "tisch" }),
    BS("Ein einfacher Tisch. Eine Spieldose steht darauf und macht Musik."));
  AddDetail( ({ "westwand" }),
    BS("Hier steht ein einfacher Tisch. "));
  AddDetail( ({ "spieldose" }),
    BS("Die Spieldose ist geoeffnet und spielt eine schoene Melodie. "));
  AddSound( ({ "musik", "spieldose", "dose" }),
    BS("Die Spieldose erzeugt ein schoene Melodie. "));
  AddDetail( ({ "spinett", "tuba", "musikinstrumente" }),
    BS("Mit diesen Musikinstrumenten kann man laute Musik machen. "));
  AddDetail( ({ "schaukelpferd", "pferd" }),
    BS("Als kleines Kind ist Lara von Friedheim wohl sehr oft darauf geritten. "+
    "Aus diesem Alter ist sie aber nun herausgewachsen. "));
  AddSpecialDetail( ({ "alter" }), "det_getage");
  AddDetail( ({ "burgfried" }),
    BS("Du bist im Burgfried."));
  AddDetail( ({ "dachluke", "luke" }),
    BS("Durch diese Luke kommt man nach oben aufs Dach des Burgfrieds."));
  AddDetail( ({ "holzbohlen" }),
    BS("Die Holzbohlen knarzen unter Deinen Fuessen."));
  AddSound( ({ "knarzen" }),
    BS("Dieses Geraeusch machen die Holzbohlen, wenn man auf ihnen geht."));
  AddSound( ({ "geraeusch" }),
    BS("Die Spieldose macht Musik."));
  AddDetail( ({ "melodie" }),
    BS("Dazu muss man lauschen"));
  AddSound( ({ "melodie" }),
    BS("Du lauschst vertraeumt der Melodie und fuehlst Dich ausgeglichen."));
  AddDetail( ({ "stein", "steine" }),
    BS("Die Waende bestehen aus einfachen Steinen."));
  AddDetail( ({ "stockwerk", "etage" }),
    BS("Neben diesem Spielzimmer, kann man hier auf der Etage auch noch die umfangreiche Bibliothek finden."));
  AddDetail( ({ "bibliothek" }),
    BS("Die Bibliothek ist auch auf dieser Etage zu finden."));
  AddDetail( ({ "gemaelde", "bilder" }),
    BS("Die Bilder an den Waenden zeigen verschiedene Stilleben."));
  AddDetail( ({ "stilleben" }),
    BS("Ein normales Stilleben eben."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit ("sueden", BURG "zs_burg_og3_b2");
  AddExit ("oben", BURG "zs_burg_dach_b1");

}

string det_getage()
{
	return "Du bist "+to_string(TP->QueryProp(P_AGE)/1800)+" Stunden alt. \n";
}