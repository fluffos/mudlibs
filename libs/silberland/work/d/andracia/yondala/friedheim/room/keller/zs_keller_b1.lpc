#include "../def.h"
//laesst
inherit "std/room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT , "Keller von Friedheim" );
  SetProp( P_INT_LONG ,
    BS("Du stehst im Vorratsraum der Burg. Viele Kisten und Faesser stehen hier, "+
    "mehrere Weinregale mit vielen staubigen Flaschen Wein und ein Tisch mit "+
    "reifendem Kaese. Saecke mit Salz und Getreide stehen hier und auch einen "+
    "grossen Stapel Bierfaesser kannst Du entdecken. Auch ein paar geraeucherte "+
    "Schinken wurden hier an Haken aufgehaengt. "));

  AddSound( DEFAULT_SOUND,
    BS("Durch das vergitterte Fenster im Osten kann man Arbeitsgeraeusche des "+
    "Burgschmieds vernehmen. "));  
  AddSound( ({ "geraeusche", "arbeitsgeraeusche" }),
    BS("Das typische Geraeusch, wenn heisses Metall mit dem Hammer bearbeitet wird. "));  
  AddSmell( DEFAULT_SMELL,
    BS("Die Luft hier ist kalt und trocken."));  
  AddSmell( ({ "luft" }),
    BS("Die Luft ist kalt und trocken. Auch ein bischen haengt der Geruch von Kaese "+
    "in der Luft."));  
  AddSmell( ({ "geruch", "kaese" }),
    BS("Der Kaese riecht gut gereift. "));  
  
  AddDetail( ({ "boden" }),
    BS("Hier bildet der blanke, behauene Fels den Boden. "));
  AddDetail( ({ "decke" }),
    BS("Ein gemauertes Gewoelbe ueberspannt den Raum. Durch ein vergittertes "+
    "Fenster im Osten, knapp unterhalb der Decke, dringt Licht herein. An ein "+
    "paar Haken, die in der Decke eingelassen sind, haengen geraeucherte Schinken. "));    
  AddDetail( ({ "wand", "waende" }),
    BS("Bis Huefthoehe bestehen die Waende aus behauenem Fels, darueber beginnt "+
    "das massive Mauerwerk der Burg."));
  AddDetail( ({ "vorratsraum", "raum", "keller" }),
    BS("Viele Kisten und Faesser stehen hier, "+
    "mehrere Weinregale mit vielen staubigen Flaschen Wein und ein Tisch mit "+
    "reifendem Kaese. Saecke mit Salz und Mehl stehen hier und auch einen "+
    "grossen Stapel Bierfaesser kannst Du entdecken. Durch ein vergittertes "+
    "Fenster im Osten, knapp unterhalb der Decke, dringt etwas Licht herein. "));
  AddDetail( ({ "burg", "friedheim", "etage" }),
    BS("Du befindest Dich im Keller der Burg Friedheim. "));
  AddDetail( ({ "kisten", "kiste" }),
    BS("Diese Kisten enthalten allerlei Lebensmittel und Gewuerze. "));
  AddDetail( ({ "faesser", "fass", "bierfaesser" }),
    BS("In den meissten Faesser ist Bier, es befinden sich aber auch Faesser mit "+
    "Poekelfleisch und Poekelfisch hier. "));
  AddDetail( ({ "weinregale", "regale", "weinregal", "regal"}),
    BS("Die verschiedensten Weinsorten sind hier gelagert. Rotwein, Weisswein, "+
    "Roseewein, manche trocken, viele lieblich - gut sortiert und auch so manch "+
    "klassischer Jahrgang. "));
  AddDetail( ({ "tisch" }),
    BS("Nur ein einfacher Tisch aus Holz. Es liegt einiges an Kaese darauf.") );
  AddDetail( ({ "kaese" }),
    BS("Der Kaese riecht gut gereift. "));
  AddDetail( ({ "saecke", "sack" }),
    BS("Viele Saecke sind mit Salz und andere mit Mehl gefuellt."));
  AddDetail( ({ "salz", "steinsalz" }),
    BS("Normales Steinsalz. Die Burgkoechin benoetigt das zum Kochen."));
  AddDetail( ({ "mehl" }),
    BS("Einfaches Mehl. Die Burgkoechin benoetigt das zum Kochen."));
  AddDetail( ({ "stapel" }),
    BS("Die Bierfaesser wurden hier aufgestapelt, um mehr Platz zu haben."));
  AddDetail( ({ "fels", "stein", "felsen", "steine" }),
    BS("Die Haelfte des Raums wurde direkt in den Fels gehauen. Es ist ganz normaler "+
    "Fels, wie man ihn hier ueberall finden kann."));
  AddDetail( ({ "gewoelbe", "bogen", "form" }),
    BS("Das Mauerwerk wurde in einem Bogen ueber den Raum gespannt. Die gewoelbte "+
    "Form der Decke wird daher auch als Gewoelbe bezeichnet. Es besteht aus normalen "+
    "Steinen wie das restliche Mauerwerk auch."));
  AddDetail( ({ "mauerwerk", "mauer" }),
    BS("Es besteht aus normalen Steinen. "));
  AddDetail( ({ "fenster", "gitter" }),
    BS("Durch das Fenster im Osten, knapp unterhalb der Decke, dringt Licht herein. "+
    "Das eiserne Gitter verhindert, dass Diebe oder groessere Tiere in den "+
    "Vorratsraum eindringen. "));
  AddDetail( ({ "metall", "hammer", "geraeusch", "burgschmied", "schmied", "schmiede" }),
    BS("Dazu musst Du erst in die Schmiede gehen. "));
  AddDetail( ({ "luft" }),
    BS("Kalt und trocken."));
  AddDetail( ({ "schinken", "rauchschinken", "rauchfleisch" }),
    BS("Diese geraeucherten Stuecke Rauchfleisch sehen koestlich aus - wenn man "+
    "Rauchfleisch mag. "));
  AddDetail( ({ "poekelfleisch", "poekelfisch", "fleisch", "fisch" }),
    BS("Die Faesser mit Poekelfleisch und Poekelfisch sind randvoll mit Salz. "+
    "Man muss schon ein bischen darin wuehlen um etwas davon herauszuholen." ));
  AddDetail( ({ "haken" }),
    BS("In der Decke sind ein paar Haken eingelassen. An manchen wurde geraeucherter "+
    "Schinken aufgehangen. "));
  AddDetail( ({ "platz" }),
    BS("Es hat zwar sehr viele Lebensmittel hier unten, aber der Platz dieses Raums "+
    "ist noch nicht erschoepft. "));
  AddDetail( ({ "wein", "rotwein", "weisswein", "roseewein", "wein", "rosee", "weinsorten" }),
    BS("Am besten waere eine Weinprobe, aber dazu hat Dich der Burgherr nicht "+
    "eingeladen. "));
  AddDetail( ({ "lebensmittel", "proviant" }),
    BS("Fisch, Fleisch, Kaese und alles andere hier unten benoetigt die Burgkoechin, "+
    "um die Bewohner der Burg zu versorgen."));
  AddDetail( ({ "gewuerze", "gewuerz" }),
    BS("Manche bezeichnen Salz auch als Gewuerz. Die Burgkoechin benoetigt diese zum "+
    "wuerzen. "));
  AddDetail( ({ "bewohner" }),
    BS("Alle die hier in der Burg wohnen, nennt man Bewohner der Burg. "));
  AddDetail( ({ "stuecke" }),
    BS("Es sind grosse Stuecke. "));
  AddDetail( ({ "getreide" }),
    BS("Man macht Mehl daraus. "));
  AddDetail( ({ "gang" }),
    BS("Du kannst im Westen zurueck auf den Gang. "));
  AddDetail( ({ "huefthoehe", "hoehe", "huefte" }),
    BS("Das ist bei jedem anders. Hier wird der von der Hoehe einer menschlichen Huefte ausgegangen. "));
  AddDetail( ({ "jahrgang" }),
    BS("Diese Flasche Weisswein ist ueber 20 Jahre alt!"));
  AddDetail( ({ "burgkoechin", "koechin" }),
    BS("Die Burgkoechin ist meistens in der Kueche zu finden. "));
  AddDetail( ({ "kueche" }),
    BS("Eine Etage ueber Dir ist die Kueche zu finden. "));
  AddDetail( ({ "bier" }),
    BS("In ein paar Faessern ist Bier."));
  AddDetail( ({ "diebe" }),
    BS("Diebe kommen hier nicht herein."));
  AddDetail( ({ "flasche", "flaschen" }),
    BS("Vorallem Wein ist in den Flaschen abgefuellt."));
  AddDetail( ({ "huefthoehe", "hoehe", "huefte" }),
    BS("Das ist bei jedem anders. Hier wird von der Hoehe einer menschlichen Huefte ausgegangen. "));
  AddDetail( ({ "licht" }),
    BS("Das Fenster im Osten laesst nur wenig Licht herein."));

/*
  AddDetail( ({ "" }), Fels
    BS(""));
*/

  AddExit( "westen", KELLER + "zs_keller_a1.lpc" );
  
  AddCmd( ({ "nimm", "nehme", "hol", "hole"}), "get_zeugs");
  AddCmd( ({ "wuehl", "wuehle"}), "cmd_wuehlen");
}

int get_zeugs(string str)
{ 
  object ob;
  notify_fail("Was willst Du nehmen? \n");
  if( str != "mehl" && str != "etwas mehl" ) 
  	{
  	if( str != "zucker" && str != "etwas zucker") 
  		{
  			if( str != "salz" && str != "etwas salz" ) return 0;
  			else 
  			{
  				write("Du willst Dir etwas Salz nehmen, aber weisst leider nicht wohin du es tun sollst. \n");
          return 1;
        }
      }
  	notify_fail("Du hast Doch schon genuegend Zucker! \n");
    if( present("\nzucker",TP) ) return 0;
    ob = clone_object(OBJ + "kuchen_zucker.lpc");
    ob->move(TP, M_GET);
    write("Du nimmst Dir etwas Zucker, gerade genug fuer einen Kuchen. \n");
    say(TPN + " nimmt sich etwas Zucker. \n"); return 1;
    }
  else 
  	{
    notify_fail("Du hast Doch schon genuegend Mehl! \n");
    if( present("\nmehl",TP) ) return 0;
    ob = clone_object(OBJ + "kuchen_mehl.lpc");
    ob->move(TP, M_GET);
    write("Du nimmst Dir etwas Mehl, gerade genug fuer einen Kuchen. \n");
    say(TPN + " nimmt sich etwas Mehl. \n"); return 1;
    }
}

int cmd_wuehlen(string str)
{
	notify_fail("Worin willst Du wuehlen?\n");
	if( !str ) return 0;
	if( str!="salz" && str!="in salz" && str!="im salz" ) return 0;
	// ggfs. etwas Poekelfleisch 
  write("Du wuehlst im Salz. \n");
	return 1;	
}
