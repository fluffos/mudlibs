//23.2.2019 Yondala@SilberLand funktioniert

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

reset() {
  ::reset();
}

create()
{
  ::create(); 
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1);  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp( P_INT_SHORT, "Turm" ); 
  SetProp( P_INT_LONG,  
  BS("Du bist im oberen Stockwerk des Turms. Eine hoelzerne Treppe fuehrt nach oben aufs Dach und hinunter. "+
  "Dieser Raum ist eigerichtet mit einem Holztisch und zwei einfachen Baenken. Warscheinlich ruhen sich hier "+
  "die Krieger waehrend ihrer Wache aus. Man hat aus den Schiessscharten in der Suedwand ein gutes Blickfeld "+
  "auf den Bereich vor dem Tor. Im Osten und Norden kann man durch Tueren auf den Wehrgang. "));
   
  AddDetail( ({ "decke" }),  
  BS("Die Decke ist sehr hoch. Sie besteht aus Holzbalken und Holzbohlen. Die Balken sind in der " +
  "steinernen Wand des Turm eingelassen. "));
  AddDetail( ({ "boden" }),
  "Der Boden besteht aus Holzbohlen. \n" );
  AddDetail( ({ "waende", "wand", "mauer", "mauern", "aussenwand", "aussenwaende", "mauerstueck", "mauerstuecke", "steinbloecke", "steine", "stein" }),
  BS("Die Waende bestehen aus grossen Steinbloecken und scheinen die Arbeit von faehigen Steinmetzen zu sein. "+
  "Du kannst erahnen wieviel Muehe und Aufwand an Frohnarbeit es benoetigt hat diesen Turm zu errichten. "));
  AddSound( DEFAULT_SOUND,
  "Du hoerst nichts besonderes. \n" );
  AddSmell( DEFAULT_SMELL,
  "Du riechst nichts besonderes. \n" );
   
  
  /* extra Details */
  AddDetail( ({ "friedheim", "burg" }),
  "Du bist doch schon in der Burg. \n" );
  AddDetail( ({ "dach" }),
  "Dazu musst Du erst die Treppe hoch. \n" );
  AddDetail( ({ "wehrgang" }),
  BS("Hinter den Zinnen der Burgmauer kann man entlanglaufen. Das nennt man dann Wehrgang. "));
  AddDetail( ({ "schiessscharten", "schiessscharte", "scharten", "scharte", "blickfeld" }),
  "Hier kann man nach draussen schauen. \n");
  AddDetail( ({ "balken", "bohlen", "holz", "holzbalken", "holzbohlen" }),
  BS("Boden und Decke sind aus Holz. Die Holzbohlen werden von Balken getragen die in der Wand eingelassen sind. "));
  AddDetail( ({ "stockwerk", "etage", "raum", "turm", "turms" }),
  BS("Du bist in der oberen Etage. Eine Treppe fuehrt nach oben aufs Dach und eine andere Treppe fuehrt hinab in die "+
  "untere Etage. Du kannst von hier durch eine Tuer im Norden auf den Wehrgang Richtung Bergfried und durch eine Tuer "+
  "im Osten kannst Du ueber ein kurzes Stueck Wehrgang zum oberen Stockwerk des Torhauses gelangen. "));
  AddDetail( ({ "treppe" }),
  BS("Eine hoelzerne Treppe fuehrt in einem steilen Winkel nach oben aufs Dach und ein weitere Treppe fuehrt nach unten. "));
  AddDetail( ({ "raum", "wachraum" }),
  BS("Dieser Raum dient wohl als Wachraum. Ein Holztisch und zwei einfache Baenke sind die einzigen Einrichtungsgegenstaende. "));
  AddDetail( ({ "bank", "baenke", "tisch", "holztisch", "holzbaenke" }),
  BS("Die einzige Einrichtungsgegenstaende hier im Raum sind der Holztisch und die zwei Holzbaenke. "+
  "Einfach gearbeitet aber sehr praktisch. Du hast aber keine Zeit zum hinsetzen. "));
  AddDetail( ({ "tuer" }),
  BS("Eine fuehrt nach Norden auf den Wehrgang Richtung Bergfried, die andere fuehrt ueber ein kurzes Stueck Wehrgang zum "+
  "oberen Stockwerk des Torhauses. "));
  AddDetail( ({ "muehe", "aufwand", "frohnarbeit", "arbeit" }),
  BS("Um das zu untersuchen haette man, damals als die Burg gebaut wurde, dabei sein muessen. "));
  AddDetail( ({ "nordwand", "ostwand" }),
  BS("In dieser Wand fuehrt eine Tuer hinaus auf den Wehrgang"));
  AddDetail( ({ "westwand", "suedwand" }),
  BS("Schiessscharten wurden in dieser Wand eingebracht."));
  AddDetail( ({ "bereich" }),
  BS("Was fuer einen Bereich auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "tor", "haupttor" }),
  BS("Du kannst das Haupttor von hier aus nicht sehen. "));
  AddDetail( ({ "zinnen", "zinne", "deckung" }),
  BS("Die Zinnen sind eigentlich nur erhoehte Mauerstuecke hinter denen man Deckung findet wenn man auf dem "+
  "Wehrgang eine Belagerung abwehren will. "));
  AddDetail( ({"burgmauer"}), 
  BS("Du kannst auf der Burgmauer einen Wehrgang erkennen. Durch die Tueren im Osten und Norden kannst Du auf den Wehrgang gelangen."));
  AddDetail( ({ "stueck" }),
  BS("Was fuer ein Stueck auch immer .. such dir lieber was anderes zum untersuchen."));
  AddDetail( ({ "einrichtungsgegenstaende", "einrichtung", "gegenstaende" }),
  BS("Ein Holztisch und zwei Holzbaenke sind zu sehen."));
  AddDetail( ({ "belagerung" }),
  BS("Zur Zeit ist keine Belagerung im Gange"));
  AddDetail( ({ "torhaus" }),
  BS("Das Torhaus kann man durch die Tuer im Osten erreichen."));
  AddDetail( ({ "bergfried" }),
  BS("Durch die offene Tuer im Norden kann man Stuecke des Bergfrieds erkennen."));

  // END DETAILS
  AddExit( "norden", BURG + "zs_burg_og1_a4" );
  AddExit( "osten", BURG + "zs_burg_og1_b5" );
  AddExit( "nordunten", BURG + "zs_burg_eg_a4" );
  AddExit( "oben", BURG + "zs_burg_og2_a5" );

  // END EXITS
  // AddItem( "file", refresh, Props);
   
}
