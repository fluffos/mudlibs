inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Tablett");
  SetProp( P_LONG, "Dieses einfache, hoelzerne Tablett wurde dem Wirt Radulf "+
    "Buchweiz gestohlen. Es ist sehr dreckig da es in lockerer Erde vergraben war." );
  SetProp( P_NAME, "Tablett");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_WOOD ); //MAT_<>
  SetProp( P_WEIGHT, 90); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( ({"tablett", "\ndiebesgut"}) );

}

