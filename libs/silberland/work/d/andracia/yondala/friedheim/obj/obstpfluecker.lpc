inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Obstpfluecker");
  SetProp( P_LONG, 
    BS("Ein Obstpfluecker. Er besteht aus einer langen Stange und einem "+
    "runden Metallring unter dem ein kleines Netz angebracht ist. Durch den "+
    "Ring kann man Obst in groesserer Hoehe pfluecken." ));
  SetProp( P_INFO, "Versuch doch an einem Obstbaum damit Obst zu Pfluecken.");
  SetProp( P_NAME, "Obstpfluecker");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, ([MAT_WOOD:70, MAT_IRON:20, MAT_CLOTH:10]) ); //MAT_<>
  SetProp( P_WEIGHT, 610); //in g
  SetProp( P_NODROP, "Dieser Obstpfluecker ist nur geliehen." );
  SetProp( P_NOSELL, "Dieser Obstpfluecker ist nur geliehen." );
  AddId( ({"obstpfluecker", "pfluecker", "\nobstpfluecker"}) );

}

