inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine handvoll Kirschen");
  SetProp(P_LONG,
     BS("Diese handvoll rote Kirschen sind frisch und saftig. "+
     "Es wird bestimmt ein Genuss sein sie zu verspeisen. ")
     );
  
  AddId( ({"kirschen", "\nkirschen"}) );
  SetProp(P_NAME, "Kirschen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FRUIT:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 12,12}),
        F_SOAK: 6,
        F_MSG: "Du isst die handvoll Kirschen.",
        F_MSG_ROOM: "isst eine handvoll Kirschen."]) );

}