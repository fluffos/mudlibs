inherit "std/thing";

#include <properties.h>
#include "../def.h"

string backform_inhalt;
string *option;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  backform_inhalt = "leer";
  // Properties
  SetProp( P_SHORT, "Eine Backform");
  SetProp( P_LONG, 
    BS("Eine Backform. Sie besteht aus Eisen und gibt einem Kuchen die Form beim Backen." ));
  SetProp( P_INFO, "Teig und Obst gehoeren hinein um einen Obstkuchen zu machen. ");
  SetProp( P_NAME, "Backform");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_IRON ); //MAT_<>
  SetProp( P_WEIGHT, 400); //in g
  SetProp( P_VALUE, 3);
  SetProp( P_NODROP, "Diese Backform ist nur geliehen." );
  SetProp( P_NOSELL, "Diese Backform ist nur geliehen." );

  AddId( ({"backform", "form", "\nbackform"}) );
  
  AddCmd( ({ "lege", "fuelle", "wirf", "werfe", "leg" }), "add_teig");
  AddCmd( ({ "belege", "setze", }), "add_obst");
  AddCmd( ({ "backe", "back" }), "backe_kuchen");
}

int add_teig(string str)
{
	object ob;
	string was, worein;
	notify_fail( "Was willst Du in was legen? \n");
	if( !str ) return 0;
	str=lowerstring(str);
	if (str == "backform mit teig aus") {
		worein="backform";
		was="teig";
	} else if ( sscanf(str, "%s in %s", was, worein) != 2) return 0;
	if ( worein != "backform" && worein != "form" && was != "teig" && was != "teig aus schuessel") return 0;
	notify_fail("Aber in der Backform ist doch schon mit Teig ausgelegt. \n");
	if( backform_inhalt != "leer" ) return 0;
	notify_fail("Du hast aber gar keine Teigschuessel mit Teig dabei");
	ob = present("\nteigschuessel", TP);
	if ( !ob ) return 0;
	if ( ob->QueryInhalt() == "leer") return 0; 	
	else
		{
			ob->remove(1);		
      backform_inhalt = "teig"; 		
      SetProp( P_LONG, QueryProp(P_LONG)+ "Die Backform ist mit Kuchenteig ausgelegt. \n");
      write("Du knetest den Kuchenteig passend in die Backform. \n");
      say( TPN+" knetet einem Kuchenteig passend in eine Backform. \n");
   		return 1;
    }
}

int add_obst(string str)
{
	int i;
	string was, womit;
	 
	option = ({});
	notify_fail( "Was willst mit was belegen? \n");
	if ( !str ) return 0;
	str=lowerstring(str);
	if ( sscanf(str, "%s mit %s", was, womit) != 2) return 0;
	if ( womit != "obst" && womit != "fruechte" && womit != "pflaumen" && womit != "kirschen" &&
		   womit != "birnen" && womit != "aepfel" &&
		   was != "teig" && was != "teig in backform" && was != "kuchenteig") return 0;
	notify_fail("Aber in der Backform ist doch noch gar kein Teig. \n");
	if ( backform_inhalt == "leer" ) return 0;
	notify_fail("Aber in der Backform ist doch schon mit Obst belegt. \n");
	if( backform_inhalt != "teig" ) return 0;
	else
		{
			if( present("\nkirschen 3", TP) ) option += ({ "kirschkuchen" });
			if( present("\npflaumen 3", TP) ) option += ({ "pflaumenkuchen" });
			if( present("\napfel 3", TP) ) option += ({ "apfelkuchen" });
			if( present("\nbirne 3", TP) ) option += ({ "birnenkuchen" });
			if( present("\nkirschen", TP) && present("\npflaumen", TP) &&
				  present("\napfel", TP) && present("\nbirne", TP) ) option += ({ "obstkuchen" });
			// abfrage nach option!
			notify_fail("Du hast nicht genuegend Fruechte bei dir.");
			if( sizeof(option) == 0 ) return 0;
			write("Du kannst mit deinem Obst folgende Kuchen backen: \n");
			for( i=0 ; i < sizeof(option); i++)
			  {
			  	write( "    - " + capitalize(option[i]) + " \n" );
			  }
			write("Bitte gib den entsprechenden Kuchen an: \n");   
			input_to("lege_obst", 1);
			return 1;
	  }
}

void lege_obst(string str)
{
	object ob;
	int pos;
	pos = member_array(str, option);
	if( pos == -1 )
		{
			write(BS("Dann besorg Dir eben noch mehr Obst wenn Du deinen gewuenschten "+
			"Kuchen nicht machen kannst. "));	return;
		}
	else
		{
      write("Du schneidest das Obst in passende Stuecke fuer den Kuchen. \n");
			switch(str) {
			case "kirschkuchen":
    		ob = present("\nkirschen 3", TP);
    		if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\nkirschen 2", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\nkirschen", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
  		  write( "Du belegst den Teig mit Kirschen um einen Kirschkuchen zu machen. \n"	);
        backform_inhalt = str;
				break;
			case "pflaumenkuchen":
    		ob = present("\npflaumen 3", TP);
    		if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\npflaumen 2", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\npflaumen", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
  		  write( "Du belegst den Teig mit Pflaumen um einen Pflaumenkuchen zu machen. \n"	);
        backform_inhalt = str;
				break;
			case "apfelkuchen":
    		ob = present("\napfel 3", TP);
    		if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\napfel 2", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\napfel", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
  		  write( "Du belegst den Teig mit Aepfel um einen Apfelkuchen zu machen. \n"	);
        backform_inhalt = str;
				break;
			case "birnenkuchen":
    		ob = present("\nbirne 3", TP);
    		if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\nbirne 2", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\nbirne", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
  		  write( "Du belegst den Teig mit Birnen um einen Birnenkuchen zu machen. \n"	);
        backform_inhalt = str;
				break;
			case "obstkuchen":
    		ob = present("\nkirschen", TP);
    		if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\npflaumen", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\napfel", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
        ob = present("\nbirne", TP);
  		  if(ob->remove(1) != 1) {write("Das mit dem belegen hat irgendwie nicht geklappt. \n"); return;}
  		  write( "Du belegst den Teig mit Obst um einen Obstkuchen zu machen. \n"	);
        backform_inhalt = str;
				break;
			default:
        write(BS("Dann besorg Dir eben noch mehr Obst wenn Du deinen gewuenschten "+
			  "Kuchen nicht machen kannst. "));	return;				 	
		  }	
      SetProp( P_LONG, QueryProp(P_LONG)+ "Der Teig wurde mit Obst belegt um einen "+capitalize(backform_inhalt)+" zu backen. \n");
	  }
}

int backe_kuchen(string str)
{ 
	object ob;
	notify_fail("Der Kuchen ist noch nicht fertig zum backen. \n");
	if( backform_inhalt == "leer" || backform_inhalt == "teig" ) return 0;
	say( BS(TPN+" schiebt "+TP->QueryPossPronoun(FEMALE,WEN)+" Backform in den Ofen und wartet gespannt darauf dass "+
	  TP->QueryPossPronoun(MALE,WEN)+" Kuchen fertig wird. "), TP);
	write( "Du schiebst deine Backform in den Ofen. \n" );
	TP->SetProp( P_PARALYZED, ([ 
	     PARALYZE_TIME: 20, 
		   PARALYZE_MSG: "Du schaust gebannt auf den Ofen und wartest dass Dein Kuchen fertig ist. \n",
		   PARALYZE_MSG_OTHER: "%s schaut gebannt auf den Ofen und wartet dass sein Kuchen fertig ist. \n",
		   PARALYZE_END: "Der Kuchen scheint fertig zu sein und Du nimmst ihn heraus. \n",
		   PARALYZE_END_OTHER: "%s nimmt den fertigen Kuchen aus dem Ofen. \n" ]) );			
  ob = clone_object(OBJ + backform_inhalt + ".lpc");
	if( ob->move(TP,M_GET) != 1 ) 
		{ 
			write("Du laesst den heissen Kuchen auf den Boden fallen. \n");
		  say( TPN + " laesst den heissen Kuchen auf den Boden fallen. \n");
			ob->move(environment(TP), M_SILENT);
		}	
	ob = present( "\nobstpfluecker", TP);
	if( ob ) 
	{
		if( ob->remove(1) == 1 ) write("Erna nimmt dankend dir den Obstpfluecker wieder weg. \n");
	}
  TO->remove(1);	
	return 1;
}
