inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Eine silberne Kelle");
  SetProp( P_LONG, "Eine einfache silberne Kelle. Sie ist sehr dreckig da sie in lockerer Erde vergraben war." );
  SetProp( P_NAME, "Kelle");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_SILVER ); //MAT_<>
  SetProp( P_WEIGHT, 120); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( ({"kelle", "silberkelle", "silberne Kelle", "\ndiebesgut" }) );

}

