inherit "std/thing";

#include <properties.h>
#include "../def.h"
#include <moving.h>

int richtig;
object raum;


void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  
  // Properties
  SetProp( P_SHORT, "Ein Schluessel");
  SetProp( P_LONG, "Ein kleiner eisener Schluessel. " );
  SetProp( P_INFO, "Dieser Schluessel koennte zu einer versteckten Kammer fuehren.");
  SetProp( P_NAME, "Schluessel");
  SetProp( P_NAME_ADJ, "klein");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_IRON ); //MAT_<>
  SetProp( P_WEIGHT, 25); //in g
  SetProp( P_VALUE, 0); //Wert in Muenzen
  SetProp( P_NOSELL, "kann nicht verkauft werden"); 
  AddId( "schluessel");

  /*Aktivierung Interaktion*/
  AddCmd( ({"oeffne"}), "oeffnen");
  AddCmd( ({"schliesse", "verschliesse"}), "schliessen");
}

/*Deklaration Interaktion*/
int oeffnen(string str) 
{
  notify_fail("Fehler im Raum-Zeit-Gefuege!");
  raum = environment(this_player());
  richtig = call_other(raum, "oeffne_tuer", str);
  return richtig;  
}

int schliessen(string str) 
{
  notify_fail("Fehler im Raum-Zeit-Gefuege!");
  raum = environment(this_player());
  richtig = call_other(raum, "schliesse_tuer", str);
  if(richtig == 1) return 1;
  else
  {
    write("Dieser Schluessel passt hier nicht.");
    return 0;
  }
}