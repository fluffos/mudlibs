inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Bierhumpen");
  SetProp( P_LONG, "Ein einfacher Bierhumpen. Er ist recht dreckig da er in lockerer Erde vergraben war." );
  SetProp( P_NAME, "Bierhumpen");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_CERAMIC ); //MAT_<>
  SetProp( P_WEIGHT, 190); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( ({"bierhumpen", "humpen", "\ndiebesgut"}) );

}

