inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Korn");
  SetProp(P_LONG,
    "Ein kleines Getreidekorn." );
  SetProp(P_NAME, "Getreidekorn");
  SetProp(P_GENDER, FEMALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:1, 
											 F_HEAL:({2,2}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du kaust lustlos auf dem trockenen Getreidekorn herum.", 
											 F_MSG_ROOM: "kaut lustlos auf einem trockenen Getreidekorn herum."]));


AddId(({"korn","getreidekorn"}));
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);


 
}

