inherit "std/thing";

#include <properties.h>
#include "../def.h"

mapping kerben, max_monster;

void neues_Long()
    {
      SetProp( P_LONG, 
        "Ein Kerbholz zum Notieren von getoeteten Kellermonstern: \n"
        "Asseln : " + kerben["Assel",0] + " von " + max_monster["Assel",0] + "\n" +
        "Kaefer : " + kerben["Kaefer",0] + " von " + max_monster["Kaefer",0] + "\n" +
        "Spinnen: " + kerben["Spinne",0] + " von " + max_monster["Spinne",0] + "\n" + 
        "Maeuse : " + kerben["Maus",0] + " von " + max_monster["Maus",0] + "\n" + 
        "Ratten : " + kerben["Ratte",0] + " von " + max_monster["Ratte",0] + "\n"
      );
    }

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Kerbholz");
  SetProp( P_LONG, 
  "Ein Kerbholz zum Notieren von getoeteten Kellermonstern." );
  SetProp( P_INFO, 
  BS("Auf magische Weise entstehen Kerben wenn der Besitzer ein Kellermonster "+
  "toetet. Der Freiherr wartet darauf dass die Population von Kellermonstern "+
  "klein gehalten wird - also halte dich ran und zertrete das Ungeziefer "));
  SetProp( P_NAME, "Kerbholz");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, ([MAT_MISC_WOOD:90, MAT_MISC_MAGIC:10]) ); 
  SetProp( P_WEIGHT, 50); //in g
  SetProp( P_NOSELL, 1 ); // "Du kannst das Kerbholz nicht verkaufen."
  SetProp( P_NODROP, 1 ); // "Das Kerbholz laesst sich einfach nicht wegwerfen!"
  SetProp( P_NEVERDROP, 1);
  AddId( ({"kerbholz", "holz", "\nkerbholz"}) ); //  "\nkerbholz"
  kerben      = ([ "Assel": 0, "Kaefer": 0, "Spinne": 0, "Maus": 0, "Ratte": 0 ]);
  max_monster = ([ "Assel": 6, "Kaefer": 5, "Spinne": 4, "Maus": 3, "Ratte": 2 ]);
  neues_Long();
  
}


mixed _query_autoloadobj()
    {
      return kerben;
    }

void _set_autoloadobj(mixed data)
    {
      kerben=data;
    }

int mach_kerbe(string monstername)
    { 
      notify_fail("Auf solch ein Monster ist das Kerbholz nicht vorbereitet");
      if(!member(kerben	, monstername)) return 0;
      if(kerben[monstername,0] == max_monster[monstername,0]) return 2;
      kerben[monstername]++;
      neues_Long();
      return 1;
    }

int QueryFertig()
    {
      neues_Long();
      if( kerben["Assel",0] == max_monster["Assel",0] &&
          kerben["Kaefer",0] == max_monster["Kaefer",0] &&
          kerben["Spinne",0] == max_monster["Spinne",0] &&
          kerben["Maus",0] == max_monster["Maus",0] &&
          kerben["Ratte",0] == max_monster["Ratte",0] ) return 1;
      else return 0;
    }