inherit "std/container";

#include "properties.h"
#include "container.h"
#include "../def.h"

int respawn_treasure;
int viewed_treasure;
string *treasures;

void reset()
{
  respawn_treasure--;
  if(respawn_treasure == 0) remove(); // deep_remove
  ::reset();
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  respawn_treasure = 5;
  viewed_treasure = 0;
  treasures = ({
  	WEAPON+"dolch_1.lpc",WEAPON+"dolch_2.lpc",WEAPON+"dolch_3.lpc",
  	WEAPON+"handaxt_1.lpc",WEAPON+"handaxt_2.lpc",WEAPON+"handaxt_3.lpc",
  	WEAPON+"holzfaelleraxt_1.lpc",WEAPON+"holzfaelleraxt_2.lpc",WEAPON+"holzfaelleraxt_3.lpc",
  	WEAPON+"jagdspeer_1.lpc",WEAPON+"jagdspeer_2.lpc",WEAPON+"jagdspeer_3.lpc",
  	WEAPON+"knueppel_1.lpc",WEAPON+"knueppel_2.lpc",WEAPON+"knueppel_3.lpc",
  	WEAPON+"kurzschwert_1.lpc",WEAPON+"kurzschwert_2.lpc",WEAPON+"kurzschwert_3.lpc",
  	WEAPON+"messer_1.lpc",WEAPON+"messer_2.lpc",WEAPON+"messer_3.lpc",
  	WEAPON+"rapier_1.lpc",WEAPON+"rapier_2.lpc",WEAPON+"rapier_3.lpc",
  	WEAPON+"streitkolben_1.lpc",WEAPON+"streitkolben_2.lpc",WEAPON+"streitkolben_3.lpc",
  	WEAPON+"zweihaender_1.lpc",WEAPON+"zweihaender_2.lpc",WEAPON+"zweihaender_3.lpc",
  	ARMOUR+"amulett_1.lpc",ARMOUR+"amulett_2.lpc",ARMOUR+"amulett_3.lpc",
  	ARMOUR+"holzbuckler_1.lpc",ARMOUR+"holzbuckler_2.lpc",ARMOUR+"holzbuckler_3.lpc",
  	ARMOUR+"amulett_1.lpc",ARMOUR+"amulett_2.lpc",ARMOUR+"amulett_3.lpc",
  	ARMOUR+"lederarmschienen_1.lpc",ARMOUR+"lederarmschienen_2.lpc",ARMOUR+"lederarmschienen_3.lpc",
  	ARMOUR+"lederguertel_1.lpc",ARMOUR+"lederguertel_2.lpc",ARMOUR+"lederguertel_3.lpc",
  	ARMOUR+"lederhandschuhe_1.lpc",ARMOUR+"lederhandschuhe_2.lpc",ARMOUR+"lederhandschuhe_3.lpc",
  	ARMOUR+"lederhelm_1.lpc",ARMOUR+"lederhelm_2.lpc",ARMOUR+"lederhelm_3.lpc",
  	ARMOUR+"lederhose_1.lpc",ARMOUR+"lederhose_2.lpc",ARMOUR+"lederhose_3.lpc",
  	ARMOUR+"lederstiefel_1.lpc",ARMOUR+"lederstiefel_2.lpc",ARMOUR+"lederstiefel_3.lpc",
  	ARMOUR+"lederweste_1.lpc",ARMOUR+"lederweste_2.lpc",ARMOUR+"lederweste_3.lpc",
  	ARMOUR+"ring_1.lpc",ARMOUR+"ring_2.lpc",ARMOUR+"ring_3.lpc",
  	OBJ+"wuerfel.lpc"
  });
  	
  // Properties
  SetProp( P_SHORT, "Eine Truhe");
  SetProp( P_LONG, BS("Eine alte Truhe. ") );
  SetProp( P_INFO, "Eine Schatzkiste warscheinlich. \n");
  SetProp( P_NAME, "Truhe");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_NOGET, 1);
  AddId( ({"truhe", "kiste", "schatzkiste"}) );
  SetProp( P_WEIGHT, 12000);
  


  /*Aktivierung Abschliessbarkeit*/
  add_openclose_commands();
  
}

int BeforeOpen()
{
  int anz_schaetze, zufall;
  object ob;
  
  if( viewed_treasure == 1) return 1;
  if( TP->QueryProp(P_LEVEL) > 10) {
    write("Du brauchst diese Schaetze nicht mehr. \n");
    return 0;
  }  
  if( TP->QueryProp(P_LEVEL) < 3 ) anz_schaetze =5;
  else if( TP->QueryProp(P_LEVEL) < 5 ) anz_schaetze = 3;
  else if( TP->QueryProp(P_LEVEL) < 8 ) anz_schaetze = 2;
  else anz_schaetze = 1;
  SUID;
  for(anz_schaetze ; anz_schaetze > 0; anz_schaetze--)
  {
    zufall = random(sizeof(treasures));
    ob=clone_object(treasures[zufall]);
    ob->move(TO, M_NOCHECK);
  }
  viewed_treasure = 1;
  return 1;
}

int remove() {
  object next, ob;
  for(ob=first_inventory(TO);ob;) {
    next=next_inventory(ob);
    ob->remove();
    ob=next;
  }
  return ::remove();
}