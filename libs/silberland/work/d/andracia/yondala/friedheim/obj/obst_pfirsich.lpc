inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Pfirsich");
  SetProp(P_LONG,
     BS("Dieser Pfirsich ist fest und gelb. Er schmeckt sicher vorzueglich. ")
     );
  
  AddId( ({"pfirsich", "\npfirsich"}) );
  SetProp(P_NAME, "Pfirsich");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FRUIT:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 12,12}),
        F_SOAK: 6,
        F_MSG: "Du isst den leckeren Pfirsich.",
        F_MSG_ROOM: "isst einen leckeren Pfirsich."]) );

}