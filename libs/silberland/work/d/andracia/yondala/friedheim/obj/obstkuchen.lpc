inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Obstkuchen");
  SetProp(P_LONG,
     BS("Dieser Kuchen ist belegt mit Kirschen, Pflaumen, Apfel- und Birnenstuecken. "+
     "Es wird bestimmt ein Genuss sein ihn zu verspeisen. ")
     );
  
  AddId( ({"obstkuchen", "kuchen", "\nobstkuchen"}) );
  SetProp(P_NAME, "Obstkuchen");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 425);
  SetProp(P_WEIGHT, 852);
  SetProp(P_MATERIAL, ([MAT_FRUIT:60, MAT_MISC_FOOD: 40]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 45,45}),
        F_SOAK: 22,
        F_MSG: "Du stopfst den Obstkuchen in dich hinein.",
        F_MSG_ROOM: "verputzt einen ganzen Obstkuchen."]) );
  AddDetail( ({"pflaumen"}), "Leckere Pflaumen. Mhm - das wird schmecken. \n");
  AddDetail( ({"birnenstuecken", "birnenstuecke"}), "Saftige Birnenstuecke. Mhm - das wird schmecken. \n");
  AddDetail( ({"apfelstuecken", "apfelstuecke"}), "Saftige Apfelstuecke. Mhm - das wird schmecken. \n");
  AddDetail( ({"kirschen"}), "Leckere rote Kirschen. Mhm - das wird schmecken. \n");

}