#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Spinnenseide");
  SetProp(P_LONG,
    "Du haeltst ein paar schimmernde Faeden Spinnenseide in Deinen Haenden.");
  SetProp(P_NAME, "Spinnenseide");
  SetProp(P_GENDER, FEMALE);
  AddId(({"seide","spinnenseide"}));

  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 120);

}

