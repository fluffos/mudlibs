inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Eine Armbrust");
  SetProp( P_LONG, "Eine einfache Armbrust." );
  SetProp( P_INFO, "Leider ist die Sehne gerissen und daher nutzlos. ");
  SetProp( P_NAME, "Armbrust");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_WOOD ); //MAT_<>
  SetProp( P_WEIGHT, 690); //in g
  SetProp( P_VALUE, 905); //Wert in Muenzen
  AddId( "armbrust" );

}

