inherit "std/transport";

#include "../def.h"
#include <properties.h>

#define STARTRAUM "/d/andracia/yondala/friedheim/room/burg/zs_burg_dach_a2"
#define ZWISCHENSTOP "/d/andracia/yondala/nebelwaelder/poesie/room/poesie_6b"
#define ENDERAUM "/d/andracia/yondala/tal/birkenhain/room/buchenwald_8i"

void create() 
{
  // if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Ruecken eines riesigen Adlers" );
  SetProp( P_INT_LONG, BS(
    "Du sitzst auf dem Ruecken eines riesigen Adlers.") );
  SetProp( P_SHORT, "Ein riesiger Adler" );
  SetProp( P_LONG, BS(
    "Ein riesiger Adler. Ein atemberaubender Anblick.") );
  SetProp( P_NAME, "Adler" );
  AddId( ({ "adler", "vogel" }) );
  SetProp( P_GENDER, MALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 1);
 
  
  SetProp( P_DEPARTMSG, ({
    "Der Adler breitet seine Fluegel aus und hebt ab.\n", 
    "Der Adler breitet seine Fluegel aus und hebt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Ein Adler landet @@QueryArrived@@.\n",
    "Ein Adler landet.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt den Adler",
    "besteigt den Adler"}) );
  SetProp( P_ENTERFAIL, ({
    "Nur zwei Personen koennen auf diesem Adler reiten.",
    "passt nicht mehr auf den Ruecken des Adlers"}) );
  SetProp( P_MAX_PASSENGERS, 2 );

  SetProp( P_LEAVEMSG, ({
    "springt vom Ruecken des Adlers",
    "springt vom Ruecken des Adlers"}) );
  SetProp( P_LEAVEFAIL, ({
    "Der Adler fliegt aber gerade",
    "moechte hier oben vom Adler springen"}) );
  /* Details */
  AddDetail( ({"adler", "vogel"}),
    BS("Der riesige Alder bringt dich wohlbehalten an deinen Bestimmungsort. "+
    "Du streichst ueber sein seidenglattes Federkleid. ") ); 
  AddDetail( ({"federn", "federkleid"}),
    BS("Du streichst sachte ueber das Federkleid des Adlers und bist erstaunt wie glatt es sich anfuehlt.") );
    
  /* Verben */
  AddCmd( ({ "besteige", "besteig" }), "rein" );
  AddCmd( ({ "springe", "spring" }), "raus" );
  AddCmd( ({ "toete" }), "kill_adler" );

  /* Kurs */
  AddRoute( STARTRAUM, 30, 20, "auf dem Dach der Burg", ({"burg", "friedheim"}), "zur Burg Friedheim" );
  AddMsg( "Der Adler umfliegt eine Wolke.\n", 30 );
  AddMsg( "Langsam gleitet der Adler ueber den Wald hinweg.\n", 10 );
  AddMsg( "Der Wald unter Dir wird langsam von einem undurchdringlichen Nebel verschluckt.\n", 10 );
  AddMsg( "Der Adler taucht im Nebel ein und landet zielgenau auf einem kleinen Platz.\n", 10 );
  AddRoute( ZWISCHENSTOP, 30, 20, "auf dem Platz im Dorf der Blauelfen", ({"blauelfen", "nebel", "poesie"}), "zum Dorf der Blauelfen" );
  AddMsg( "Der Adler bringt sich mit kraeftigen Fluegelschlaegen aus dem Nebel heraus in die Hoehe.\n", 30 );
  AddMsg( "Nach einer kurzen Strecke ueber den Nebel hinweg kannst Du wieder Wald unter Dir sehen.\n", 20 );
  AddMsg( "Im Gleitflug ueberquert der Adler das Gebirge.\n", 20 );
  AddMsg( "Der Adler setzt zur Landung mitten im Wald an.\n", 10 );
  AddRoute( ENDERAUM, 30, 20, "im Wald der Elfen", ({"elfen", "wald", "aboriville", "elfenwald", "tal"}), "ins Tal" );
  AddMsg( "Der Adler breitet seine Schwingen aus und erhebt sich in die Luefte.\n", 30 );
  AddMsg( "Im Gleitflug ueberquert der Adler das Gebirge.\n", 20 );
  AddMsg( "Die Burg kommt in Sicht und der Adler haelt direkt auf den Burgfried zu.\n", 10 );
	
 	// SHIPD->AddHarbour(TO, STARTRAUM);
 	// SHIPD->AddHarbour(TO, ZWISCHENSTOP);
 	// SHIPD->AddHarbour(TO, ENDERAUM);
 	
  Start();
}

int kill_adler(string str)
{
	if( str == "adler" ) 
	{
		write( "Der Adler ist ueber Deinen armseligen Angriff amuesiert und ignoriert Deine Bemuehungen.\n");
		return 1;
	}
	else return 0;
}

int rein(string str)
{
  notify_fail("Was willst Du besteigen?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Willst Du vom Adler springen?\n");
  if( !str ) return 0;
  if( id(str) || str="vom adler" ) return Leave();
  else return 0;	
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( STARTRAUM, "???"));
    catch(call_other( ZWISCHENSTOP, "???"));
    catch(call_other( ENDERAUM, "???"));
  }
}
