inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Zapfhahn");
  SetProp( P_LONG, "Ein einfacher Zapfhahn aus Holz. Er ist sehr dreckig da er in lockerer Erde vergraben war." );
  SetProp( P_NAME, "Zapfhahn");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_WOOD ); //MAT_<>
  SetProp( P_WEIGHT, 90); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( ({"zapfhahn", "\ndiebesgut"}) );

}

