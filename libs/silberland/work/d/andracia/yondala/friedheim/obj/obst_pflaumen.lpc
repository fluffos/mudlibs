inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine handvoll Pflaumen");
  SetProp(P_LONG,
     BS("Diese handvoll Pflaumen sind frisch und von schoener blauer Faerbung. "+
     "Es wird bestimmt ein Genuss sein sie zu verspeisen. ")
     );
  
  AddId( ({"pflaumen", "\npflaumen", "zwetschken"}) );
  SetProp(P_NAME, "Pflaumen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FRUIT:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 12,12}),
        F_SOAK: 6,
        F_MSG: "Du isst die handvoll Pflaumen.",
        F_MSG_ROOM: "isst eine handvoll Pflaumen."]) );

}