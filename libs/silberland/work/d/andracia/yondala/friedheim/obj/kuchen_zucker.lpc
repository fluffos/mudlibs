inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"etwas Zucker");
  SetProp(P_LONG,
     BS("Aus Zuckerrueben wurde dieser Zucker gewonnen. Man kann es bestimmt auch so essen. ")
     );
  
  AddId( ({"zucker", "\nzucker"}) );
  SetProp(P_NAME, "etwas Zucker");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 28);
  SetProp(P_WEIGHT, 62);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 6,6}),
        F_SOAK: 8,
        F_MSG: "Du laesst dir etwas Zucker auf der Zunge zergehen.",
        F_MSG_ROOM: "laesst sich etwas Zucker auf der Zunge zergehen."]) );
}