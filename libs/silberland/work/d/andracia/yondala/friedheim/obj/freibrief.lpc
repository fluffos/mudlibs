
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Freibrief");
  SetProp(P_LONG,
    "Du siehst ein Stueck Pergament auf dem etwas geschrieben steht." );
  SetProp(P_NAME, "Freibrief");
  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, MALE);
  AddId(({"brief","freibrief","pergament", "\nfreibrief"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
  AddReadDetail( ({ "brief","freibrief","pergament" }),
    "Hiermit gestatte ich dem Zwerg Durc unbehelligt mein Land zu "
    "passieren.\n");    
 

}
