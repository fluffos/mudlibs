inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Pflaumenkuchen");
  SetProp(P_LONG,
     BS("Dieser Kuchen ist belegt mit Pflaumen. "+
     "Es wird bestimmt ein Genuss sein ihn zu verspeisen. ")
     );
  
  AddId( ({"pflaumenkuchen", "kuchen", "\npflaumenkuchen"}) );
  SetProp(P_NAME, "Pflaumenkuchen");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 425);
  SetProp(P_WEIGHT, 852);
  SetProp(P_MATERIAL, ([MAT_FRUIT:60, MAT_MISC_FOOD: 40]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 42,42}),
        F_SOAK: 22,
        F_MSG: "Du stopfst den Pflaumenkuchen in dich hinein.",
        F_MSG_ROOM: "verputzt einen ganzen Pflaumenkuchen."]) );
  AddDetail( ({"pflaumen"}), "Viele leckere Pflaumen. Mhm - das wird schmecken. \n");

}