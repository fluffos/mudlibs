inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Birne");
  SetProp(P_LONG,
     BS("Diese Birne ist goldgelb und reif. Es wird bestimmt ein Genuss sein sie zu verspeisen. ")
     );
  
  AddId( ({"birne", "\nbirne"}) );
  SetProp(P_NAME, "Birne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 48);
  SetProp(P_WEIGHT, 52);
  SetProp(P_MATERIAL, ([MAT_FRUIT:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 12,12}),
        F_SOAK: 6,
        F_MSG: "Du isst die saftige Birne.",
        F_MSG_ROOM: "isst eine saftige Birne."]) );

}