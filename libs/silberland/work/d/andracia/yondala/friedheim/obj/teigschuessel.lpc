inherit "std/thing";

#include <properties.h>
#include "../def.h"

string schuessel_inhalt;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  schuessel_inhalt = "leer";
  // Properties
  SetProp( P_SHORT, "Eine Schuessel");
  SetProp( P_LONG, 
    BS("Eine Schuessel. Sie besteht aus Eisen und ist gut geeignet die Zutaten "+
    "fuer den Teig eines Kuchens aufzunehmen. " ));
  SetProp( P_INFO, "Wenn man alle Zutaten zusammen hat kann man darin den Teig anruehren. ");
  SetProp( P_NAME, "Schuessel");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_IRON ); //MAT_<>
  SetProp( P_WEIGHT, 450); //in g
  SetProp( P_VALUE, 3);
  SetProp( P_NODROP, "Diese Schuessel ist nur geliehen." );
  SetProp( P_NOSELL, "Diese Schuessel ist nur geliehen." );
  AddId( ({"schuessel", "teigschuessel", "\nteigschuessel"}) );
  
  AddCmd( ({"ruehre", "knete", "mache", "ruehr", "knet", "mach"}), "make_teig");
  
}

int make_teig(string str)
{
	object ob;
	string fail_message;
	fail_message = "";
	notify_fail("Was willst Du tun? \n");
	str=lowerstring(str);
	if( str != "teig" && str != "teig an" ) return 0;
	notify_fail("Aber in der Schuessel ist doch schon der Teig fertig. \n");
	if( schuessel_inhalt != "leer" ) return 0;
	if( !present("\nei 3", TP) ) fail_message += "Dir fehlen Eier";
  if( !present("\nmehl", TP) ) if(fail_message == "") fail_message += "Dir fehlt Mehl"; else fail_message += " und Mehl";
  if( !present("\nzucker", TP) ) if(fail_message == "") fail_message += "Dir fehlt Zucker"; else fail_message += " und Zucker";
  if( !present("\nmilch", TP) ) if(fail_message == "") fail_message += "Dir fehlt Milch"; else fail_message += " und Milch";
  if( fail_message != "" ) 
  	{
  		notify_fail(fail_message + ". \n");
  	  return 0;
  	}
  else
  	{
  		notify_fail("Das mit dem Teig hat irgendwie nicht geklappt. \n");
  		ob = present("\nei 3", TP);
  		if(ob->remove(1) != 1) return 0;
      ob = present("\nei 2", TP);
  		if(ob->remove(1) != 1) return 0;
      ob = present("\nei", TP);
  		if(ob->remove(1) != 1) return 0;
  		ob = present("\nmehl", TP);
  		if(ob->remove(1) != 1) return 0;
      ob = present("\nzucker", TP);
  		if(ob->remove(1) != 1) return 0;
      ob = present("\nmilch", TP);
  		if(ob->remove(1) != 1) return 0;
      schuessel_inhalt = "teig"; 		
      SetProp( P_LONG, QueryProp(P_LONG)+ "Die Schuessel ist mit Kuchenteig gefuellt. \n");
      write("Du wirfst die Zutaten in die Schuessel und knetest einen Kuchenteig. \n");
      say( TPN+" knetet Eier, Mehl, Milch und Zucker zu einem Kuchenteig zusammen. \n");
   		return 1;
    }
}

string QueryInhalt()
{
	return schuessel_inhalt;
}