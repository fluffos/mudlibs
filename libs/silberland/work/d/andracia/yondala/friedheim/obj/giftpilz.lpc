inherit "/std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Pilz");
  SetProp( P_LONG, "Eine weisser, fleischiger Pilz mit blauen Punkten." );
  SetProp( P_INFO, "Der sieht gar nicht lecker aus.");
  SetProp( P_NAME, "Pilz");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_MUSHROOM ); //MAT_<>
  SetProp( P_WEIGHT, 80); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( "pilz" );
  SetProp( P_FOOD_INFO, 
    ([ F_POISON: 1 , F_SOAK: 20, F_MSG: "Du isst einen Pilz.", F_MSG_ROOM: " isst einen Pilz." ]));   
}

