inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Getreidekorn");
  SetProp(P_LONG,
    "Ein kleines Getreidekorn. Zur Not kann man es bestimmt kauen." );
  SetProp(P_NAME, "Getreidekorn");
  SetProp(P_GENDER, NEUTER);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:5, 
											 F_HEAL:({4,4}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du kaust ein Getreidekorn.", 
											 F_MSG_ROOM: "kaut ein Getreidekorn."]));


  AddId("korn","getreide","getreidekorn");

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 35);


 
}

