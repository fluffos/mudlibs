inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Birnenkuchen");
  SetProp(P_LONG,
     BS("Dieser Kuchen ist belegt mit Birnenstuecken. "+
     "Es wird bestimmt ein Genuss sein ihn zu verspeisen. ")
     );
  
  AddId( ({"birnenkuchen", "kuchen", "\nbirnenkuchen"}) );
  SetProp(P_NAME, "Birnenkuchen");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 425);
  SetProp(P_WEIGHT, 852);
  SetProp(P_MATERIAL, ([MAT_FRUIT:60, MAT_MISC_FOOD: 40]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 45,45}),
        F_SOAK: 22,
        F_MSG: "Du stopfst den Birnenkuchen in dich hinein.",
        F_MSG_ROOM: "verputzt einen ganzen Birnenkuchen."]) );
  AddDetail( ({"birnenstuecken", "birnenstuecke"}), "Viele saftige Birnenstuecke. Mhm - das wird schmecken. \n");

}