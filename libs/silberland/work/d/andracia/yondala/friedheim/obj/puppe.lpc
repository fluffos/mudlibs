inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Puppe");
  SetProp( P_LONG, "Eine kleine Puppe." );
  SetProp( P_INFO, "Ein nutzloses Spielzeug");
  SetProp( P_NAME, "Puppe");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_CLOTH ); //MAT_<>
  SetProp( P_WEIGHT, 110); //in g
  SetProp( P_VALUE, 10); //Wert in Muenzen
  AddId( "puppe" );

}

