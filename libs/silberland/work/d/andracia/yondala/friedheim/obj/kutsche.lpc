inherit "std/transport";

#include "../def.h"
#include <properties.h>

#define STARTRAUM "/d/huegelland/yason/friedheim/room/dorf/friedheim_dorf_c4"
#define ENDERAUM "/d/huegelland/yason/hafen/room/hafen_g3"

void create() 
{
  // if (!is_clone(TO)) return;
  ::create();

  SetProp( P_INT_SHORT, "In einer Kutsche" );
  SetProp( P_INT_LONG, BS(
    "Du sitzst in einer Kutsche.") );
  SetProp( P_SHORT, "Eine Kutsche" );
  SetProp( P_LONG, BS(
    "Du siehst eine prunkvolle Kutsche.") );
  SetProp( P_NAME, "Kutsche" );
  AddId( ({ "kutsche" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 1);

  AddDetail( "kutsche", BS(
    "Eine wirklich prunkvolle Kutsche. Sie pendelt zwischen Hafen und Friedheim.") );
  
  SetProp( P_DEPARTMSG, ({
    "Die Kutsche rumpelt los.\n", 
    "Die Kutsche rumpelt los.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Die Kutsche haelt @@QueryArrived@@.\n",
    "Die Kutsche kommt an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt die Kutsche",
    "kommt in die Kutsche"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 4 Reisende in die Kutsche",
    "hat keinen Platz mehr in der Kutsche"}) );
  SetProp( P_MAX_PASSENGERS, 4 );

  SetProp( P_LEAVEMSG, ({
    "steigt aus der Kutsche",
    "kommt aus der Kutsche"}) );
  SetProp( P_LEAVEFAIL, ({
    "Die Kutsche ist mit voller Geschwindigkeit unterwegs",
    "moechte bei fahrende Kutsche aussteigen"}) );

  /* Verben */
  AddCmd( ({ "besteige", "besteig" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  AddRoute( STARTRAUM, 30, 20, "in Friedheim", ({"friedheim", "dorf"}), "nach Friedheim" );
  AddMsg( "Die Kutsche rumpelt in Richtung Hafen.\n", 10 );
  AddMsg( "An einer Kreuzung leitet der Kutscher die Kutsche nach Westen. \n", 10 );
  AddMsg( "Die Kutsche faehrt am Waldrand eines imposanten Wald im Sueden entlang. \n", 10 );
  AddMsg( "Die Kutsche naehert sich dem Hafen.\n", 10 );
  AddRoute( ENDERAUM, 30, 20, "im Hafendorf", ({"hafen", "hafendorf"}), "zum Hafen"  );
  AddMsg( "Die Kutsche rollt in Richtung Friedheim.\n", 10 );
  AddMsg( "Im Sueden laesst ein unheimlicher Wald Dir die Nackenhaare zu Berge stehen.\n", 10 );
  AddMsg( "Der Kutscher haelt kurz an einer Kreuzung inne und nimmt dann den Weg nach Norden. \n", 10 );
  AddMsg( "Die Kutsche ist schon fast auf dem Dorfplatz angekommen.\n", 10 );
 	
 	// SHIPD->AddHarbour(TO, STARTRAUM);
 	// SHIPD->AddHarbour(TO, ENDERAUM);
 	
  Start();
}

rein(str)
{
  notify_fail("Was willst Du besteigen?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( STARTRAUM, "???"));
    catch(call_other( ENDERAUM, "???"));
  }
}
