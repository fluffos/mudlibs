#include "../def.h"
inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine hoelzerne Tafel");
  SetProp(P_LONG,
    "Eine grosse, hoelzerne Tafel mit allerlei Informationen zu den Dienstleistungen die hier in der Schmiede "+
    "angeboten werden. Du kannst es bestimmt lesen. " );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Tafel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"tafel", "infotafel", "holztafel", "informationstafel"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );

  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.");
  AddDetail( ({"tafel", "holztafel", "infotafel", "informationstafel" }),
    BS("Ein einfache Holztafel mit vielen Informationen zu den Diensten die der Schmied anbietet. Versuch es doch mal mit lesen. "));
  AddDetail( ({ "informationen", "infos" }),
    BS("Auf der Informationstafel stehen die Dienstleistungen der Schmiede. Lesen mach hier Sinn."));
  AddDetail( ({ "sinn" }),
    BS("Es macht Sinn eine beschriebene Tafel zu lesen."));
  AddReadDetail( ({"tafel", "holztafel", "infotafel", "informationstafel" }),
    " +---------------------------------------+ \n"+
    " + Folgende Dienste stehen Euch hier     + \n"+
    " + zur Verfuegung:                       + \n"+
    " +  Reparieren     Preis je nach Aufwand + \n"+
    " +  Vergleichen    200 Muenzen           + \n"+
    " +---------------------------------------+ \n" );
}
