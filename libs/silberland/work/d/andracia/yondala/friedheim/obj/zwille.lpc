inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Eine Zwille");
  SetProp( P_LONG, "Eine einfache Zwille." );
  SetProp( P_INFO, "Damit kann man niemandem ernstlich Schade zufügen.");
  SetProp( P_NAME, "Zwille");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_MATERIAL, MAT_WOOD ); //MAT_<>
  SetProp( P_WEIGHT, 90); //in g
  SetProp( P_VALUE, 5); //Wert in Muenzen
  AddId( "zwille" );

}

