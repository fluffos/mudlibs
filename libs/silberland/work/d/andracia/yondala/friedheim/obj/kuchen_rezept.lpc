//Bugfix: Die Read Message raus, hat gebugt und stattdessen ein ReadDetail eingefuegt

inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein Rezeptzettel");
  SetProp( P_LONG, "Auf diesem Rezeptzettel steht wie man einen Kuchen backt. \n" );
  SetProp( P_INFO, "Lesen waere sicherlich sinnvoller. \n");
/*  SetProp( P_READ_MSG, "Zum Backen eines Kuchen werden folgende Zutaten benoetigt: \n"+
    "Drei Eier,\nMehl,\netwas Milch,\netwas Zucker,\nObst.\n"+
    "Man knetet Eier, Mehl, Mehl, Milch und Zucker in einer Schuessel gut durch und \n"+
    "legt damit eine Backform aus. Danach mit dem Obst belegen und im Ofen goldbraun backen. "));
*/
  AddReadDetail( ({ "rezept","zettel","rezeptzettel" }),
    "Zum Backen eines Kuchen werden folgende Zutaten benoetigt: \n"+
    "Drei Eier,\nMehl,\netwas Milch,\netwas Zucker,\nObst.\n"+
    "Man knetet Eier, Mehl, Milch und Zucker in einer Schuessel gut durch und "+
    "legt damit eine Backform aus. Danach mit dem Obst belegen und im Ofen goldbraun backen. ");


  SetProp( P_NAME, "Rezeptzettel");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_MATERIAL, MAT_PAPER ); //MAT_<>
  SetProp( P_WEIGHT, 2); //in g
  SetProp( P_VALUE, 0); //Wert in Muenzen
  AddId( ({"rezept", "rezeptzettel", "zettel", "\nrezept"}) );
  
}

