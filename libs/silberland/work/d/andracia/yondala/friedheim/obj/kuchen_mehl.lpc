inherit "std/food";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"etwas Mehl");
  SetProp(P_LONG,
     BS("Dieses Mehl ist aus gutem Weizen gemahlen. Man kann es bestimmt auch so essen. ")
     );
  
  AddId( ({"mehl", "\nmehl"}) );
  SetProp(P_NAME, "etwas Mehl");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 28);
  SetProp(P_WEIGHT, 62);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 4,4}),
        F_SOAK: 16,
        F_MSG: "Du stopfst etwas Mehl in dich.",
        F_MSG_ROOM: "stopft etwas Mehl in sich."]) );
}