// inherit "std/thing";
inherit "std/unit";

#include <properties.h>
#include "../def.h"
// #include <mordef.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  // Properties
  SetProp( P_SHORT, "Ein kleiner sechsseitiger Wuerfel");
  SetProp( P_LONG, BS(
  "Ein kleiner weisser sechseitiger Wuerfel mit schwarzen Augen. "+
  "Wenn man mit diesem Wuerfel wuerfelt wird er ein Ergebnis zwischen 1 und 6 zeigen." ));
  SetProp( P_INFO, "Er scheint nicht gezinkt zu sein.");
  SetProp( P_NAME, "Wuerfel");
  SetProp( P_NAME_ADJ, "klein");
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_MISC_SOLID );
  SetProp( P_WEIGHT_PER_UNIT, 10); //in g
  SetProp( P_VALUE_PER_UNIT, 1); //Wert in Muenzen
  SetProp( P_NOBUY, 0); 
  AddId( "wuerfel", "cube", "w6", "w-sechs");
  AddDetail( ({"augen", "punkte", "auge", "punkt"}), BS(
  "Schwarzglaenzende Punkte in verschiedener Anzahl je Seite "+
  "geben das Ergebnis an. Sie sind wohl aufgemalt in kleinen "+
  "runden Vertiefungen." ));
  AddDetail( ({"vertiefung", "vertiefungen", "farbe"}), BS(
  "Die schwarze Farbe der Augen auf dem Wuerfel wurden wohl in "+
  "die Vertiefungen aufgebracht um zu vermeiden dass durch den Gebrauch "+
  "die Punkte zuschnell abnutzen" ));
  AddDetail( ({"ergebnis", "zahl"}), BS(
  "Die Anzahl der Augen der nach dem Wuerfeln oben liegenden Seite "+
  "gibt das Ergebnis an." ));
  AddDetail( ({"anzahl"}), BS(
  "Auf jeder Seite sind unterschiedlich viele Augen. Die einzelnen Seiten "+
  "zeigen jeweils 1 bis 6 Augen. " ));
  AddDetail( ({"seite", "seiten"}), BS(
  "Auf jeder Seite sind unterschiedlich viele schwarze Augen in Vertiefungen aufgemalt. "));
  AddDetail( ({"kante", "kanten"}), BS(
  "Alle Kanten sind gerundet damit beim wuerfeln der Wuerfel schoen kullern kann. "));
  AddDetail( ({"kullern"}),
  "Dazu musst Du den Wuerfel schon wuerfeln. \n" );
  
  /*Aktivierung Interaktion*/
  AddCmd( ({"wirf", "wuerfle", "werf" }), "f_wuerfeln" );
}

/*Deklaration Interaktion*/
int f_wuerfeln(string str)
{
  string wuerfels, ausgabe;
  int anzahl_wuerfels, x, summe, ergebnis;
  notify_fail("Was willst Du tun? \n");
  if( str == "wuerfel" || str == "cube" || str == "w6" || str == "w-sechs")
  { 
    ergebnis = random(6) + 1;
    write("Du wuerfelst einen Wuerfel: \n"
    "Der Wuerfel zeigt eine " + ergebnis + ". \n");
    say(capitalize(this_player()->name())+ "wuerfelt eine " + ergebnis + ". \n");
    return 1;
  }
  else
  {
    if( sscanf(str, "%d %s", anzahl_wuerfels, wuerfels) != 2) return 0;
    if( wuerfels != "wuerfel" && wuerfels !="cube" && wuerfels !="w6" && wuerfels !="w-sechs" )
      return 0;
    if( anzahl_wuerfels > QueryProp(P_AMOUNT) )
    {
      write("Soviele Wuerfel hast Du nicht. \n");
      return 1;
    }
    write("Du wuerfelst " + anzahl_wuerfels + " Wuerfel. \n");
    say(capitalize(this_player()->name())+ " wuerfelt " + anzahl_wuerfels + " Wuerfel. \n" );
    ausgabe = "";
    for( x= anzahl_wuerfels ; x > 0 ; x-- )
    {
      ergebnis = random(6) + 1;
      ausgabe = ausgabe + ergebnis;
      if(x != 1) ausgabe = ausgabe + ", ";
      summe = summe + ergebnis;
    }
    ausgabe = ausgabe + " gewuerfelt. Summe: "  + summe + ". \n";
    write("Du hast " + ausgabe);
    say(capitalize(this_player()->name())+ " hat " + ausgabe );
  }
  return 1;
}