inherit "std/thing";

#include <moving.h>
#include <properties.h>
#include "../def.h"

#define TY(x) if(find_player("yason")) tell_object(find_player("yason"),x)

string villian;
string diebesgut;
string ort;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Questitem_Abenteurerring");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_ARTICLE, 0);

  AddId("\nabquest");
  

  switch( random(4) )
  {
  	case 3: villian="Torben"; break;
  	case 2: villian="Rukus"; break;
  	case 1: villian="Celissa"; break;
  	default: villian="Lidda"; break;
  }
  switch( random(4) )
  {
  	case 3: diebesgut="eine silberne Kelle"; break;
  	case 2: diebesgut="ein Tablett"; break;
  	case 1: diebesgut="einen Bierhumpen"; break;
  	default: diebesgut="einen Zapfhahn"; break;
  }
  switch( random(3) )
  {
  	case 2: ort="fallobstwiese_b1"; break;
  	case 1: ort="fallobstwiese_c5"; break;
  	default: ort="fallobstwiese_d4"; break;
  }

	AddCmd( ({"grab","grabe","buddel","buddele"}), "grab" );
}

grab() 
{
  if( !present("schaufel", TP) ) return 0;
  TY( "Hier heisst: "+file_name(environment(TP))+",\n" );
  TY( "sollte aber "+WIESE+ort+" heissen.\n" );
  if( file_name(environment(TP))!=WIESE+ort )
  {
  	notify_fail( BS("Du graebst ein bischen aber das scheint nicht die richtige Stelle zu sein.") );
  	return 0;
  }
  if( present("\ndiebesgut", TP) )
  {
  	notify_fail( BS("Du graebst ein bischen aber findest nichts Wertvolles mehr an dieser Stelle.") );
  	return 0;
  }
  switch( diebesgut )
  {
  	case "eine silberne Kelle": CLONE(OBJ+"silberkelle.lpc",TP);
  	case "ein Tablett": CLONE(OBJ+"tablett.lpc",TP);
  	case "einen Bierhumpen": CLONE(OBJ+"bierhumpen.lpc",TP);
  	default: CLONE(OBJ+"zapfhahn.lpc",TP);
  }
  write(BS("Du graebst ein bischen und findest "+diebesgut+".\n"));
  return 1;
}

string QueryVillian()
{
	return villian;
}

string QueryDiebesgut()
{
	return diebesgut;
}

string QueryDiebesgutPronoun()
{
  switch( diebesgut )
  {
  	case "eine silberne Kelle": return "sie";
  	case "ein Tablett": return "es";
  	default: return "ihn";
  }
}

string QueryOrt()
{
  switch( ort )
  {
  	case "fallobstwiese_b1": return "oestlich des Apfelbaums";
  	case "fallobstwiese_d4": return "westlich des Birnenbaums";
  	default: return "noerdlich des Pflaumenbaums";
  }
}
