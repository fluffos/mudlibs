inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("burgbewohner")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint such
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
    
  AddId(({"burgbewohner"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Burgbewohner");
  SetProp( P_LONG, "Ein ganz normaler Burgbewohner. \n");
  SetProp( P_NAME, "Burgbewohner");
  SetProp( P_GENDER, MALE);
  SetProp( P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 178); //in cm
  SetProp( P_WEIGHT, 78000); //in g
  SetProp( P_ALIGN, 0); //Gesinnung von -1000 bis +1000
  SetProp( P_MAX_HANDS, 2); //Anzahl Haende
  SetProp( P_HEAL, 0); //Essbarkeit von -4 bis +4
  // SetProp( P_AGGRESSIVE, ([0:0.0]); //nicht aggressiv
  SetProp( P_WIMPY, 0); //nicht fluechten
  SetProp( P_NOMAGIC, 0); //keinen Magiewiderstand
  SetProp( P_RESISTANCE_STRENGTHS ,  //Widerstand gegen Schadentypen -1 (immun) bis +1 (doppelt)
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.2, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.5, DT_SOUND: -0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.2]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Burgbewohner"); //string fuer Todessequenz
  SetProp( P_KILL_MSG, "HIHI - ich habe %s getoetet!");
  // SetProp( P_LOG_FILE, LOG + "npc_logfile");
  SetProp( P_LOG_INFO, "missing_answers"); // Logfile fuer unbeantwortete Fragen
  
  //Antworten
  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Liebste von Yason.", "sagt: ");
  AddInfo( "nyx", "Nyx hilft Yondala und Yason.", "sagt: ");
  AddInfo( "aginor", "Aginor ist der boese Teil des Hochadels.", "sagt: ");
  
  AddInfo( ({"dorlen", "dorlen friedheim", "burgherrin", "freiherrin"}), break_string("Dorlen ist die Frau unseres "+
  "Freiherrn. Du findest Sie wahrscheinlich im zweiten Stock. ", 45),"sagt: ");
  AddInfo( ({"edorian", "edorian friedheim", "freiherr", "freiherrn", "burgherr"}), break_string("Edorian Friedheim ist unser geliebter "+
  "Freiherr. Du findest Ihn warscheinlich im zweiten Stock. ", 45),"sagt: ");
  AddInfo( ({"lara", "lara friedheim", "burgfrauelein"}), break_string("Das ist die huebsche Tochter des "+
  "Freiherrn. Du findest Sie warscheinlich im zweiten Stock. ", 45),"sagt: ");
  AddInfo( ({"jette", "jette linneweber", "zofe", "zofen"}), break_string("Das ist bestimmt eine der Zofen. "+
  "Warscheinlich kannst Du sie im dritten Stock finden. ", 45),"sagt: ");
  AddInfo( ({"eberhelm", "eberhelm schroeter"}), break_string("Das ist der Taktische Berater unseres "+
  "Freiherrn. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"erna", "erna kollwanst"}), break_string("Das ist die Koechin auf der Burg. "+
  "Eine sehr nette Frau. Die ist bestimmt in der Kueche zu finden. ", 45),"sagt: ");
  AddInfo( ({"sindar", "sindar tucher", "bibliothekar"}), break_string("Das ist der Bibliothekar unseres "+
  "Freiherrn. Der ist mit grosser Sicherheit in der Bibliothek im dritten Stock. ", 45),"sagt: ");
  AddInfo( ({"vitus", "vitus gesse"}), break_string("Das ist der Knappe von Brin Roggenfeldt, "+
  "dem Hauptmann. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"brin", "brin roggenfeldt"}), break_string("Das ist der Hauptmann der Burgwache auf der Burg unseres "+
  "Freiherrn. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"yantur", "yantur leisten"}), break_string("Das ist der Burgschmied. Du kannst bei Ihm Deine "+
  "Ausruestung reparieren. In einer Ecke des Burghofs ist seine Schmiede. ", 45),"sagt: ");
  
  AddInfo( ({"bernhelm", "bernhelm kramer"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"irian", "irian ilgur"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"jobdan", "jobdan gerber"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"celissa", "celissa harzscharrer"}), break_string("Dieses Maechen wohnt hier im Dorf. "+
  "Die ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), break_string("Dieses Maechen wohnt hier im Dorf. "+
  "Die ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"rukus", "rukus karolus"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");

  AddInfo( ({"eslam", "eslam kremso"}), break_string("Das ist einer der ansaessigen Haendler. "+
  "Du findest seinen Laden im Westen des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"rauert", "rauert arres"}), break_string("Das ist einer der ansaessigen Haendler. "+
  "Du findest seinen Laden im Osten des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"gumblad", "gumblad korber"}), break_string("Das ist einer der ansaessigen Wirte. "+
  "Du findest sein Lokal im Sueden des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"radulf", "radulf buchweiz"}), break_string("Das ist einer der ansaessigen Wirte. "+
  "Du findest sein Lokal im Norden des Dorfs. ", 45),"sagt: ");

  AddInfo( ({"koenig"}), break_string("Wir haben keinen Koenig. Der Titel des Burgherrn ist "+
  "Freiherr, Freiherr Edorian von Friedheim.", 45),"sagt: ");
  AddInfo( ({"hilfe", "arbeit", "auftrag"}), break_string("Ich kann Dir nur empfehlen zu Sindar Tucher, dem "+
  "Bibliothekar zu gehen. Der weiss immer Rat. Du findest ihn im dritten Stock des Burgfrieds.", 45),"sagt: ");
  AddInfo( ({"quest", "aufgabe", "aufgaben", "arbeit"}), break_string("Tut mir leid. Ich habe keine Arbeit fuer Dich. "+
  "Der Freiherr sucht aber immer Leute fuer alle moeglichen Aufgaben. ", 45),"sagt: ");
  AddInfo( ({"burg", "friedheim"}), break_string("Die Burg Friedheim ist der "+
  "Sitz des Freiherrn von Friedheim. ", 45),"sagt: ");
  AddInfo( ({"welt", "andracia"}), break_string("Diese Welt wird Andracia genannt. "+
  "Geh zu Sindar Tucher, dem Bibliothekar, der kann Dir viel ueber unsere Welt erzaehlen. ", 45),"sagt: ");
  AddInfo( ({"essen", "trinken"}), break_string("Fuer die Verpflegeung kannst Du im Dorf die "+
  "Gasthauser aufsuchen: im Norden des Dorfs den goldenen Schwan im Sueden den rostigen Nagel. "+
  "Die Burgkoechin wird Dir auch was gegen den Hunger zubereiten wenn Du nett fragst. ", 45),"sagt: ");
  AddInfo( ({"liebe"}), break_string("Die Liebe ist ein Geschenk. Halt Sie fest wenn Du sie "+
  "findest. ", 45),"sagt: ");

  AddInfo( ({"kuchen"}), break_string("Jeder mag Kuchen. ", 45),"sagt: ");
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", "ratte", "asseln", "spinnen", "maeuse", "ratten"}), break_string(
    "Das Ungeziefer ist im Keller zu finden. Aus irgendeiner Spalte "+
    "kriechen diese Tiere herein und knabbern an unseren Vorraeten.", 45),"sagt: ");
  AddInfo( ({"keller"}), break_string("Im Keller ist sehr viel Ungeziefer. Der Freiherr bezahlt angehende "+
    "Kammerjaeger gut. Der Zugang befindet sich in der Kueche.", 45),"sagt: ");
  AddInfo( ({"kammerjaeger", "kammerjaegern"}), break_string("Frag den Freiherrn, er sucht schon lange nach Kammerjaegern. ", 45),"sagt: ");

  AddInfo( ({"fackel", "licht"}), break_string("Eine Fackel kann man sicher im Laden kaufen. ", 45),"sagt: ");

  AddInfo( ({"kerbholz"}), break_string("Dazu kann Dir der Burgherr mehr sagen. ", 45),"sagt: ");

  AddInfo( ({"tiere"}), break_string("Das Ungeziefer ist im Keller. ", 45),"sagt: ");

  AddInfo( ({"spalte"}), break_string("Ja, durch irgendeine Spalte im Keller dringt das Ungeziefer herein und vergeht sich an den Vorraeten. . ", 45),"sagt: ");

  AddInfo( ({"weinprobe"}), break_string("Der Burgherr ist mit dem Wein knauserig. Eine Weinprobe wird es nie geben hier auf Friedheim. ", 45),"sagt: ");
  AddInfo( ({"hafen", "hafendorf"}), 
  	"Das Hafendorf befindet sich ein gutes Stueck westwaerts. ", "sagt: ");
  AddInfo( ({ "kellereingang" }),
    "In der Burgkueche fuehrt eine Treppe hinab in den Keller." ,
    "sagt: ");
  AddInfo( ({ "huhn", "huehner", "huehnern" }),
    "Wir halten hier auf der Burg keine Huehner." ,
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Kobolde sind eigentlich ein friedliches Volk, wenn ihre Vorliebe fuer fremder Leute Eigentum nicht waere. " ,
    "sagt: ");
  AddInfo( ({"diebe"}), break_string("Diebe lauern leider auf den Strassen meines Reichs. Leider koennen "+
    "meine Wachleute nicht ueberall rechtzeitig zur Stelle sein. Seht Euch einfach vor. ", 45),"sagt: ");
  AddInfo( ({ "weg" }),
    "Ihr koennt die Burg nur durch das Torhaus im Sueden verlassen, wohin ihr Euch aber dann wenden wollt "+
    "kann ich Euch auch nicht sagen." ,
    "sagt: ");
  AddInfo( ({ "adler" }),
    "Der Adler landet desoefteren bei uns auf dem Dach. Er kann sogar jemand auf seinem Ruecken mitnehmen. " ,
    "sagt: ");
  AddInfo( ({ "aboriville" }),
    "Aboriville ist die Stadt der Elfen. Sie ist hinter den Bergen und ich bin dort bisher noch nie gewesen." ,
    "sagt: ");
  AddInfo( ({ "waffe", "waffen" }),
    "In den Laeden im Dorf findet Ihr vielleicht eine Bracuhbare Waffe." ,
    "sagt: ");
  AddInfo( ({ "armbrust" }),
    "Eine Armbrust ist eine hervoragende Waffe um bei Belagerungen." ,
    "sagt: ");
  AddInfo( ({ "herberge" }),
    "An der Strasse zum Hafen gbt es eine Herberge. Meint ihr vielleicht diese?" ,
    "sagt: ");
  AddInfo( ({ "reparieren", "reparatur" }),
    "Yantur Leisten, unser Schmied hier auf der Burg, kann Euch sicher bei Reparaturen weiterhelfen." ,
    "sagt: ");
  AddInfo( ({ "chitin", "chitinplatte", "chitinplatten" }),
    "Ich habe einmal davon gehoert dass Bewohner von Hoehlen und Stollen "+
    "oft Kaefer zuechten, um sie zu essen und aus ihren Chitinplatten Ruestungen zu schneidern." ,
    "sagt: ");
  AddInfo( ({ "schneider", "schneiderei" }),
    "Hier in Friedheim hat sich leider kein Schneider niedergelassen." ,
    "sagt: ");
  AddInfo( ({ "gasthaus", "nahrung", "gasthaeuser", "mahlzeit", "lokal", "kneipe" }),
    "Falls ihr etwas zu essen oder trinken benoetigt so geht zu Erna, sie kann Euch gerne etwas verkaufen." ,
    "sagt: ");
  AddInfo( ({ "schmied", "schmiede" }),
    "Yantur Leisten hat seine Schmied im Burghof eingerichtet. Vielleicht koennt Ihr ihn zu einer Reparatur "+
    "Eurer Ausruestung bewegen." ,
    "sagt: ");
  AddInfo( ({ "obstkuchen", "kirschkuchen", "pflaumenkuchen", "birnenkuchen", "apfelkuchen" }),
    "Ich mag zwar Kuchen aber gerade moechte ich keinen Essen. Vielleicht moechte das Burgfraeulein den Kuchen, die "+
    "hat einen gesunden Appetit. Aber trotzdem schafft Sie es irgendwie weiter so schlank zu sein." ,
    "sagt: ");
  AddInfo( ({ "kueche" }),
    "Die Kueche ist das Reich von Erna, unserer Burgkoechin. Normalerweise hat Sie auch fuer Gaeste immer etwas zu beissen parat, "
    "aber oft ist Sie einfach ueberarbeitet." ,
    "sagt: ");
  AddInfo( ({ "adlige" }),
    "Hier in Friedheim geastieren selten hoehere Adlige. " ,
    "sagt: ");
  AddInfo( ({ "meer", "hafendorf", "see" }),
    "Eine kutsche kann Euch vom Dorf zu Friedheim direkt zum Hafendorf bringen. Dort koennt ihr dann zur See fahren. " ,
    "sagt: ");
  AddInfo( ({ "zauberer", "marmorturm" }),
    "Die Zauberer haben ihren Sitz im Marmorturm im Osten. Leider muss man um dorthin zu gelangen durch das Gebiet das von "+
    "den Riesentermiten verseucht ist." ,
    "sagt: ");
  AddInfo( ({ "riesentermiten", "termiten" }),
    "Im Osten des Dorfs beginnt eine karge Landschaft die von den aggressiven Riesentermiten bewohnt wird. Seit vorsichtig wenn ihr "+
    "dort hindurch wollt." ,
    "sagt: ");
  AddInfo( ({ "jonatan" }),
    "Kann es sein dass Jonatan im Dorf lebt? Sucht am Besten dort." ,
    "sagt: ");
  AddInfo( ({ "pferd", "pferde" }),
    "Wir haben hier zur Zeit keine Pferde. Die Kavallerie ist zur Zeit auf einer Uebung." ,
    "sagt: ");
  AddInfo( ({ "kavallerie" }),
    "Die Kavallerie hat sich auf eine Uebung begeben." ,
    "sagt: ");


/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

// Questinfos
  AddInfo( ({"kirschen", "kirsche", "apfel", "aepfel", "pfirsich", "pfirsiche", "birne", "birnen", "pflaume", "pflaumen"
  	         "aprikose", "aprikosen", "obst" }), 
  	"Mhm - zwischen Dorf und Burg ist eine kleine Obstwiese. Vielleicht findet ihr dort was ihr sucht.", "sagt: ");
  AddInfo( ({"mehl", "zucker", "eier", "milch", "vorraete", "vorrat"}), "Fragt die Burgkoechin, die weiss wo die Vorraete sind. ", "sagt: ");
  AddInfo( ({"kerker", "kerkerzellen", "zellen", "kerkerzelle", "zelle"}), 
    "Die Kerker werden schon lange nicht mehr benutzt. In einem der Kerker "+
    "muss aber eine Spalte im Boden sein, aus der Ungeziefer unsere Vorraete anfaellt.", "sagt: ");
  AddInfo( ({"kampf"}), "Sei besser friedlich.", "sagt: ");
 
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
