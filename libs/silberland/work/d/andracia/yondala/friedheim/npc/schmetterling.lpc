inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 10)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}

void create() {
  int farbe;
  farbe = random(4);
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Schmetterling");
  switch(farbe) {
    case 1: SetProp(P_LONG, BS("Ein schillernder Schmetterling. In allen Farben des Regenbogens "+
    	"schimmern seine Fluegel. Ein wirklich wunderschoenes Exemplar.")); SetProp(P_HEAL, 1); break;
    case 2: SetProp(P_LONG, BS("Ein braun-schwarzer Schmetterling. Die unscheinbare Farbgebung "+
    	"laesst den Schmetterling langweilig erscheinen. ")); SetProp(P_HEAL, 0); break;
    case 3: SetProp(P_LONG, BS("Ein weisser Schmetterling. Dieser weisse fliegende Fleck "+
    	"faellt nur auf wenn er im Hintergrund die Baeume hat. Ein paar Fluegelsclaege hoeher und "+
    	"man koennte ihn nicht gegen den Himmel erkennen. ")); SetProp(P_HEAL, 0);break;
    default: SetProp(P_LONG, BS("Ein blauer-gruener Schmetterling. Die Fluegel haben eindrucksvolle "+
    	"Muster, die Farben sind praechtig und von weitem ist das schmucke Tier deutlich sichtbar. "));
    	SetProp(P_HEAL, -1);
  }
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId(({ "schmetterling" }));

  create_default_npc(2);

  SetProp(P_HANDS, ({" mit seinen Fluegeln",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert weg");
  SetProp(P_MMSGIN, "flattert herbei");
  SetProp(P_MMSGOUT, "flattert hinfort");
  SetProp(P_MNPC_AREA, WIESE );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, WIESE "fallobstwiese_c2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " ist zerquetscht. \n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich armer Schmetterling ...");
  SetProp(P_KILL_NAME, "Schmetterling");
  
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schmetterling kann Deine Sachen nicht tragen.\n" }) );
    
  CLONEME("/d/andracia/yondala/tal/aboriville/obj/schmetterlingsfluegel.lpc");
}
