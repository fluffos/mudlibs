void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte fuer NPC des Level x

  //Properties
  AddId(({"wache", "burgwache", "Brin Roggenfeldt", "brin", "roggenfeldt", "hauptmann"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Brin Roggenfeldt");
  SetProp( P_LONG, BS("Dies ist Brin Roggenfeldt, Hauptmann der Burgwache. "+
    "Er sorgt fuer Ruhe und Ordnung hier in der Burg. Seine stattliche Erscheinung wird durch sein "+
    "bestimmtes Auftreten unterstuetzt. Dieser Mann weiss wie man sich Respekt verschafft."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Brin Roggenfeldt");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, BURG + "zs_burg" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_og1_a1" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Brin Roggenfeldt"); //string fuer Todessequenz
  set_living_name("brin"); 
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Chats
  SetAttackChats( 5, ({"Brin Roggenfeldt bruellt: Sterbt endlich! \n",
  	                   "Brin Roggenfeldt sagt: Nehmt dass! \n",
  	                   "Brin Roggenfeldt bruellt: Ich werd Euch aufspiessen! \n",
  	                   "Brin Roggenfeldt ruft: Wachen, zu mir! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
//  AddInfo( ({"magiestein", "magiesteine"}), #'q_magiestein, "sagt: "); //#'

  AddInfo( ({ "magiestein", "magiesteine" }),
    "Bis hier Zauberer zugelassen sind, wird es noch lange dauern. " ,
    "sagt: ");


  AddInfo( ({ "respekt", "auftreten" }),
    "Man muss immer souveraen Auftreten, dann bekommt man auch den Respekt den man mit dem Amt als Hauptmann "+
    "verdient hat." ,
    "sagt: ");

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "lederarmschienen_2.lpc" );
  CLONEME( ARMOUR + "lederhelm_1.lpc" );
  CLONEME( ARMOUR + "lederstiefel_2.lpc" );
  CLONEME( ARMOUR + "lederweste_1.lpc" );
  CLONEME( ARMOUR + "holzbuckler_2.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "kurzschwert_2.lpc" );
  command("zuecke schwert");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werde ich dem Burgherrn sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werde ich dem Burgherrn sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


