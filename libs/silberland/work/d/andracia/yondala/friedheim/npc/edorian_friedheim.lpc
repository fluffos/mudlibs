//Burgherr
// Teil der Piratenquest
//Quest rausgenommen, gibt nun Geld

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_burgbewohner.lpc";

string give_equipment(string str);
string freibrief();
string gunst();
string gefallen();
string gedicht();
string unterschrift();

int belohnung;
string *equipment;

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  equipment = allocate (100);
  create_default_npc(22); //erstellt Standartwerte fuer NPC des Level x
  // Belohnung fuer Quest
  belohnung = 5000;
  //Properties
  AddId(({"edorian", "Edorian von Friedheim", "freiherr", "lehensherr" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Edorian von Friedheim");
  SetProp( P_LONG, 
    BS("Dies ist Edorian von Friedheim, der Freiherr von Friedheim. Eine stattliche Erscheinung "+
    "mit einem strengen Gesichtsausdruck. Er lenkt die Geschicke rund um die Burg, spricht "+
    "Recht und ist der Lehensherr der umliegenden Bauernhoefe. " ));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Edorian von Friedheim");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, BURG + "zs_burg_og2" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_og2_a2" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Edorian von Friedheim"); //string fuer Todessequenz
  set_living_name("edorian");
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Chats
  SetAttackChats( 5, ({"Edorian von Friedheim bruellt: Ihr seid des Todes! \n",
  	                   "Edorian von Friedheim sagt: Wie koennt Ihr Euch sowas nur erlauben! \n",
  	                   "Edorian von Friedheim sagt: Euer Leben ist verwirkt! \n",
  	                   "Edorian von Friedheim ruft: Ich werd Euch den Kopf einschlagen! \n" }) ); // rate in%

  AddInfo( ({ "hilfe", "arbeit", "auftrag" }) ,
    "Ja, ich benoetige Hilfe. Im Keller ist viel zu viel Ungeziefer. "+
    "Ich biete jedem "+belohnung+" Goldstuecke der hilft, das Ungeziefer auszumerzen. "+
    "Wenn Ihr Euch auch daran versuchen wollt, so bietet mir eure Hilfe an." ,
    "sagt: ");
  AddInfo( ({ "ausruestung", "waffe", "schwert" }), #'give_equipment, "sagt:");//'
  AddInfo( ({ "freibrief fuer durc"}), #'freibrief, "sagt:" );//'
  AddInfo( ({ "gunst"}), #'gunst, "sagt:" );//'
  AddInfo( ({ "gefallen"}), #'gefallen, "sagt:");//'
  AddInfo( ({ "gedicht", "liebesgedicht"}), #'gedicht, "sagt:");//'
  AddInfo( ({ "unterschrift", "unterschreiben"}), #'unterschrift, "sagt:");//'

  AddCmd( ({ "melde" }) , "ende_quest" );
  AddCmd( ({ "biete" }) , "start_quest" );
    
  AddInfo( QueryProp(P_IDS), "Ich bin der Freiherr von Friedheim! ", "sagt: ");

  AddInfo( ({"kerbholz", "kammerjaeger", "kammerjaegern"}), 
    "Jeder, der sich bei mir als Kammerjaeger bewirbt bekommt "+
    "ein magisches Kerbholz auf dem die Erfolge verzeichnet werden. ", 
    "sagt: ");
  AddInfo( ({"assel", "asseln", "kaefer", "maus", "maeuse", "spinne", "spinnen", "ratte", "ratten", "tiere", "tier"}),
    "Im Keller findet man Asseln, Kaefer, Maeuse, Spinnen und sogar Ratten. Ich bin "+
    "staendig auf der Suche nach faehigen Kammerjaegern die sich dem Problem annehmen. ", 
    "sagt: ");
  AddInfo( ({"freiherrn"}), 
    "Ich bin hier der Freiherr und damit auch der Richter in Friedheim. Lasst Euch "+
    "also nichts zuschulden kommen.", 
    "sagt: ");
  AddInfo( ({"problem"}), 
    "Das Ungeziefer im Keller ist mein Problem. Die fressen uns noch die ganzen Vorraete auf.", 
    "sagt: ");
  AddInfo( ({"erfolge"}), 
    "Schaut einfach Euer Kerbholz an um eure Erfolge abzulesen.", 
    "sagt: ");
  AddInfo( ({"quest", "aufgabe", "aufgaben"}), 
    "Ich benoetige kompetente Kammerjaeger die sich dem Ungeziefer im Keller annehmen. "+
    "Wollt Ihr Euch um diese Aufgabe bewerben? Oder habt Ihr etwa schon ein vollstaendiges Kerbholz bei Euch? "+
    "So meldet mir dass es fertig ist.", "sagt: ");
  AddInfo( ({ "schluessel" }),
    "Ihr braucht keinen Schluessel. Hier in der Burg sind alle Tueren offen. " ,
    "sagt: ");
  AddInfo( ({ "nebelwald", "nebelwaelder" }),
    "Im Sueden befinden sich die Nebelwaelder. Man munkelt dass dort Blauelfen hausen." ,
    "sagt: ");
    
  AddInfo( ({ "bewerbung", "bewerben" }),
    "Ja, Ihr koennt Euch als Kammerjaeger bei mir bewerben. Im Keller ist einfach zu viel Ungeziefer. "+
    "Ich biete Euch "+belohnung+" Goldstuecke wenn ihr mir helft das Ungeziefer auszumerzen. "+
    "Biete mir Eure Hilfe an, falls Ihr Euch dieser Aufgabe gewachsen fuehlt.." ,
    "sagt: ");
  AddInfo( ({ "wie", "syntax", "kommunikation", "questbefehle" }),
    "Nagut, ihr neunmalkluger Wicht. So will ich Euch die richtige Syntax nennen. \'biete hilfe an \' "+
    "um mir gegen das Ungeziefer im Keller zu helfen. \'melde kerbholz fertig\' ist die richtige "+
    "Formulierung sobald ihr genuegend Kleingetier erledigt habt." ,
    "sagt: ");
  AddInfo( ({ "belohnung" }),
    "Ich biete Euch "+belohnung+" Goldstuecke wenn ihr Euch als Kammerjaeger bei mir bewaehrt." ,
    "sagt: ");
  AddInfo( ({ "dorf" }),
    "Das Dorf zu Friedheim liegt nur ein kleines Stueck gen Osten." ,
    "sagt: ");
  AddInfo( ({ "spalt" }),
    "Ich glaube in der dritten Kerkerzelle ist irgendwo ein Spalt aus dem das Ungeziefer hereinkommt. " ,
    "sagt: ");

  AddInfo( ({"gegenleistung"}),
    "Die kann unterschiedlich sein. Kommt darauf an, fuer wen der Freibrief ist.",
    "sagt: ");
  AddInfo( ({"freibrief"}),
    "Ich verteile manchmal Freibriefe an Missetaeter um sie von ihrer Strafe zu befreien. Natuerlich "
    "nicht ohne entsprechende Gegenleistung.",
    "sagt: ");
  AddInfo( ({"gegenleistung"}),
    "Die kann unterschiedlich sein. Kommt darauf an, fuer wen der Freibrief ist.",
    "sagt: ");
  AddInfo( ({"poet","poemo", "poeten"}),
    "Poemo im Dorf der Poesie ist der groesste Poet, den ich kenne.",
    "sagt: ");
  AddInfo( ({"poesie"}),
    "Das Dorf der Poesie liegt versteckt in den Nebelwaeldern.",
    "sagt: ");
  AddInfo( ({ "tochter" }),
    "Meine Tochter Lara ist mir das liebste Kind. Leider kann Sie sich nicht dazu entschliessen einmal zu heiraten." ,
    "sagt: ");
  AddInfo( ({ "fertig", "ende", "questende" }),
    "Ihr muesst schon ein militaerisches Auftreten ueben: Meldet formell dass euer Kerbholz fertig ist. " ,
    "sagt: ");
  AddInfo( ({ "blauelfen" }),
    "Die Blauelfen leben in einem im Nebel versteckten Dorf. Es ist nicht einfach, sie zu finden." ,
    "sagt: ");
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");





/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/
    
  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "lederguertel_1.lpc" );
  CLONEME( ARMOUR + "lederhelm_1.lpc" );
  CLONEME( ARMOUR + "lederstiefel_1.lpc" );
  CLONEME( ARMOUR + "lederweste_1.lpc" );
  CLONEME( ARMOUR + "lederhandschuhe_1.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "streitkolben_2.lpc" );
  command("zuecke kolben");
}
// Questfunktionen

string give_equipment(string str)
{
  if(TP->QueryProp(P_LEVEL) <= 5 && member_array(TPN , equipment)==-1 
     && present("\nkerbholz", TP) && TP->QueryQuest("Ungeziefer auf Burg Friedheim")!=1 )  
  {
    object ob;
    equipment += ({TPN});
    SUID;
    ob = clone_object( ARMOUR + "leinenhemd.lpc"); ob->move(TP, M_GET);
    ob = clone_object( ARMOUR + "leinenhose.lpc"); ob->move(TP, M_GET);
    ob = clone_object( ARMOUR + "sandalen.lpc"); ob->move(TP, M_GET);
    ob = clone_object( WEAPON + "holzschwert.lpc"); ob->move(TP, M_GET);
    return break_string( "Ihr bekommt von mir eine Leinenhose, ein Leinenhemd und Sandalen "+
    "damit Ihr nicht nackt herumlaufen muesst. Dieses Holzschwert ist genau richtig fuer Euch. "+
    "Benutzt diese Ausruestung um der Ungezieferplage beizukommen. ", 45);
  }
  return break_string("Ihr braucht meine Ausruestung nicht mehr. Ich kann Euch doch ansehen dass "+
    "Ihr mit Eurer Erfahrung selbst zurecht kommt. ", 45);
}

int start_quest(string str)
{ 
  object ob;
  notify_fail("Was willst Du anbieten? \n");
  if( str != "hilfe an" && str != "edorian hilfe an" ) return 0;
  notify_fail(BS(TO->QueryProp (P_NAME) +" sagt: Ungeziefer zu vernichten ist doch keine Aufgabe mehr fuer Euch!"));
  if( TP->QueryQuest("Ungeziefer auf Burg Friedheim")==1 && TP->QueryProp(P_LEVEL)>10 ) return 0;
  ob = present("\nkerbholz", TP);
  notify_fail(TO->QueryProp (P_NAME) +" sagt: Arbeitet erst mal euer aktuelles Kerbholz ab. Meldet Euch sobald es voll ist.\n");
  if( !ob ) {
    tell_room(environment(TO), break_string(TO->QueryProp (P_NAME) +" sagt: Danke, "+ TP->QueryProp (P_NAME) +", hier habt Ihr ein "+
    "magisches Kerbholz das eure Erfolge verzeichnen wird. Meldet Euch wieder bei mir wenn Ihr "+
    "das Kerbholz vollstaendig mit Kerben habt. ",75));
    if(TP->QueryProp(P_LEVEL) <= 5 && member_array(TPN , equipment)==-1 && TP->QueryQuest("Ungeziefer auf Burg Friedheim")!=1) 
    write(BS( TO->QueryProp(P_NAME) +" sagt: "+
    "Ich kann Euch gerne eine einfache Ausruestung geben, mit der Ihr Euch in den Keller wagen koennt. "+
    "Fragt mich einfach nach Ausruestung. "));
    SUID;
    ob = clone_object(OBJ + "kellermonster_kerbholz.lpc");
    ob -> move(TP, M_NOCHECK);
    return 1;
    }
  else return 0;
}

int ende_quest(string str)
{
  object ob;
  ob = present("\nkerbholz",TP);
  if( !ob ) return 0;
  notify_fail("Was willst Du melden? \n");
  if( str != "fertig" && str != "Dich" && str != "kerbholz fertig" ) return 0;
  if( ob->QueryFertig() != 1 ) 
  {
    say( BS( QueryProp(P_NAME) + " sagt zu " + TPN + ": Ihr habt Euer Kerbholz leider noch "+
    "nicht fertig. "));
    return 1;
  }
  else
  {
    ob->remove();
    /*if( TP->GiveQuest("Ungeziefer auf Burg Friedheim") == 1)
    {
        write_file("/log/quests/yason_quest.log", 
        sprintf ("%s  %s hat die Quest 'Ungeziefer auf Burg Friedheim' bestanden.\n",
        dtime(time()), CAP(TP->query_real_name())));
    }*/
    /*else
    {
      write("Quest schon mal geloest!");
    }*/
    ob = clone_object("/obj/money.lpc");
    ob->SetProp( P_AMOUNT, belohnung);
    say( BS( QueryProp(P_NAME) + " sagt zu " + TPN + ": Wie ich sehe habt Ihr Euer Kerbholz "+
    "vollstaendig abgearbeitet. Danke fuer Eure Hilfe. Hier das versprochene Entgeld "+
    "von "+belohnung + " " + ob->QueryProp(P_NAME) + ". "));
    say( BS( QueryProp(P_NAME) + " gibt " + TPN + " " + belohnung + " " + ob->QueryProp(P_NAME) + ". "), TP );
    write( BS( QueryProp(P_NAME) + " gibt Dir " + belohnung + " " + ob->QueryProp(P_NAME) + ". ") );
    ob->move( TP, M_NOCHECK );
    return 1;
  }
}

// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst zu haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst zu haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr brauchst gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: He - was nehmt ihr Euch denn heraus? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - was nehmt ihr Euch denn heraus? \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderes fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderes fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

string freibrief()
{
	if(TP->QueryQuest("Befreie Hildgunde")==0&&!present("freibrief",TP))
		return "Einen Freibrief fuer Durc wollt Ihr? Wie kaeme ich denn dazu? Dafuer muesstet Ihr "+
		"schon sehr hoch in meiner Gunst stehen.";
	
	return "Den gab ich Euch doch bereits.";
}

string gunst()
{
	if(TP->QueryQuest("Befreie Hildgunde")==0&&!present("freibrief",TP))
		return "Wenn Ihr in meiner Gunst steigen wollt, muesst Ihr mir einen Gefallen tun.";
	
	return "Ihr steht hoch in meiner Gunst.";
}

string gefallen()
{
	if(TP->QueryQuest("Befreie Hildgunde")==0&&!present("freibrief",TP))
		return "Ich wuerde mich sehr freuen, wenn Ihr mir ein Liebesgedicht fuer meine Frau besorgen "
		"wuerdet. Doch gebe ich mich nur mit dem besten zufrieden!";
	
	return "Den tatet Ihr mir doch schon. Habt Dank, meine Frau liebt das Gedicht.";
}
string gedicht()
{
	if(TP->QueryQuest("Befreie Hildgunde")==0&&!present("freibrief",TP))
		return "Ich moechte meiner holden Frau ein Gedicht schenken. Aber nur von einem wahren Poeten!";
	
	return "Vielen Dank, fuer Eure Muehe, das Gedicht ist wirklich gut!";
}

string unterschrift()
{
	object ob;
	if(present("\nfreibrief",TP))	
  {
  	ob=present("\nfreibrief",TP);
		ob->remove();
	  CLONE(OBJ +"freibriefunterschrieben.lpc", TP);
		return "Na, gebt schon her.\nDa habt Ihr Eure Unterschrift.";
	}
	return "Ohne Unterschrift sind Dokumente nicht gueltig.";
}


give_notify(object ob)
{
 	if(ob->id("liebesgedicht"))
 		{
 			command("sag Ah, habt vielen Dank! Ich lese ihn am besten sofort!");
			call_out("lesen",1, ob);
			TP->SetProp(P_NOMOVE, "Du solltest auf das Urteil von Edorian warten.\n");
		}
	else
		{
		  command("sag Danke, aber das kann ich nicht gebrauchen?");
			write("Edorian gibt Dir "+ob->name(WEN)+" zurueck.\n");
			say("Edorian gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
      ob->move(TP, M_GET);
    }
}
    
void lesen(object ob)
{
	tell_room(environment(TO), "Edorian liest sich das Gedicht durch.\n");
	call_out("lesen2",1, ob);
}
	
void lesen2(object ob)
{
	tell_room(environment(TO), "Edorian wischt sich ein Traenchen aus dem Auge.\n");
	command("sag Wohlan, dies ist ein herrliches Gedicht aus der Feder eines Meisters.");
	command("sag Ich gebe Euch dafuer den versprochenen Freibrief fuer Durc und hoffe, dass er "+
					"von nun an ein ehrenwertes Leben fuehren wird.");
  write("Edorian gibt Dir ein Pergament.\n");
	say("Edorian gibt "+TPN+" ein Pergament.\n",TP);
	ob->remove();
 	CLONE(OBJ +"freibrief.lpc", TP);
	TP->SetProp(P_NOMOVE, 0);
}
