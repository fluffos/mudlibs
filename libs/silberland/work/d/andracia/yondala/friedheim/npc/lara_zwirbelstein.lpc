//Quest muss noch eingetragen werden


#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
 
inherit NPC + "zs_burgbewohner.lpc";

int x = random(4);
string *kuchen = ({ "obstkuchen", "kirschkuchen", "pflaumenkuchen", "birnenkuchen", "apfelkuchen" });

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(10); //erstellt Standartwerte fuer NPC des Level x

  //Properties
  AddId(({"lara", "Lara von Friedheim", "tochter"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Lara von Friedheim");
  SetProp( P_LONG, 
    BS("Dies ist Lara von Friedheim, die Tochter des Freiherrn. Eine wunderschoene Frau mit "+
    "langem blondem Haar. Man bezeichnet sie auch gerne als Schatz von Friedheim, aufgrund ihrer "+
    "atemberaubenden Schoenheit. Mehrere Prinzen kamen schon, um um ihre Hand anzuhalten, aber bisher hat sie "+
    "alle Anwaerter abgelehnt. "));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Lara von Friedheim");
  SetProp( P_WIMPY, 5); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, BURG + "zs_burg_og2" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_og2_a2" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Lara von Friedheim"); //string fuer Todessequenz
  SetProp (P_REJECT, ({ REJECT_GIVE, "" }) );
  set_living_name("lara");
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Chats
  SetAttackChats( 5, ({"Lara von Friedheim bruellt: Vater, steh mir bei! \n",
  	                   "Lara von Friedheim sagt: Euer Leben ist verwirkt! \n",
  	                   "Lara von Friedheim ruft: Zu Hilfe, ein Moerder! \n",
  	                   "Lara von Friedheim versucht zu fliehen. \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");


  AddInfo( ({"heiraten"}), break_string("Dazu bin ich noch nicht bereit. ", 45),"sagt: ");
  AddInfo( ({"belohnung"}), break_string("Fragt doch meinen Vater. ", 45),"sagt: ");
  AddInfo( ({"schoenheit"}), "Ich bin die Schoenste hier im Land.", "sagt: ");
  AddInfo( ({"prinzen", "anwerber", "werben"}), "Ich kann diese vielen dummen Prinzen, die um mich werben, nicht ausstehen.", "sagt: ");

  AddInfo( ({"kuchen", "vorliebe", "lieblingskuchen"}), "Ich haette gerne einen " +capitalize(kuchen[x])+ ".", "sagt: ");
  AddInfo( kuchen, "Ich haette gerne einen " +capitalize(kuchen[x])+ ".", "sagt: ");

  AddInfo( ({ "edorian", "edorian friedheim", "freiherr", "freiherrn", "burgherr", "vater" }),
    "Mein Vater, der Freiherr von Friedheim, erfuellt mir fast alle meine Wuensche. "+
    "Man sagt, er ist ein gerechter Herrscher und Kriege gabs schon lange nicht mehr." ,
    "sagt: ");
  AddInfo( ({ "dorlen", "dorlen friedheim", "burgherrin", "mutter", "freiherrin" }),
    "Meine Mutter ist manchmal etwas streng zu mir aber, dass ich noch nicht heiraten will "+
    "akzeptiert Sie. Scheinbar hat sie damals meinen Vater auch aus Liebe geheiratet." ,
    "sagt: ");

/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  //Ausruestung
      
}

give_notify(object ob)
{
	if( ob->id("\n"+kuchen[x]) ) 
		{
			write("Lara Friedheim sagt: Vielen Dank fuer den Kuchen! \n");
			ob->remove(1);
			x = random(4);
			AddInfo( ({"kuchen", "vorliebe", "lieblingskuchen"}), "Ich haette gerne einen " +capitalize(kuchen[x])+ ".", "sagt: ");
			AddInfo( kuchen, "Ich haette gerne einen " +capitalize(kuchen[x])+ ".", "sagt: ");
			if( TP->GiveQuest("Kuchen fuer das Burgfraeulein") == 1)
      {
        write_file("/log/quests/yason_quest.log", 
        sprintf ("%s  %s hat die Quest 'Kuchen fuer das Burgfraeulein' bestanden.\n",
        dtime(time()), CAP(TP->query_real_name())));
        //  Ausgabe fuer Questende 
      }
      if( TP->QueryProp(P_ALIGN) < 200 ) TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)+80);
    }
	else 
		{
			write("IHH - Nein das will ich nicht haben! \n");
	    ::give_notify(ob);	
	  }  	
}

// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich dem Burgherrn sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werd ich dem Burgherrn sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


