void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(6); //erstellt Standartwerte fuer NPC des Level x

  //Properties
  AddId(({"celissa", "harzscharrer", "Celissa Harzscharrer", "maedchen", "Celissa" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Celissa Harzscharrer, ein kleines Maedchen");
  SetProp( P_LONG, BS("Dies ist Celissa Harzscharrer, ein kleines Maedchen. Normalerweise "+
    "bleibt sie lieber zuhause. Sie sammelt allerlei Zeugs und ihre Eltern klagen darueber, "+
    "dass der Krempel in ihrem Zimmer immer mehr wird. "));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Celissa Harzscharrer");
  SetProp( P_WIMPY, 5); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Maedchen"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetAttackChats( 5, ({"Celissa Harzscharrer ruft: Zu Hilfe, ein Unhold! \n",
  	                   "Celissa Harzscharrer bruellt: AUA! \n",
  	                   "Celissa Harzscharrer stammelt: Warum wollt Ihr mir denn Boeses? \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"puppe", "pueppchen"}), "Das ist meine Puppe! ", "sagt: ");
  AddInfo( ({"eltern", "papa", "mama"}), "Meine Eltern sind gerade auf den Feldern arbeiten.", "sagt: ");

  AddInfo( ({"celissa", "celissa harzscharrer"}), break_string("Das bin ich", 45),"sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), break_string("Das ist meine beste Freundin.", 45),"sagt: ");
  AddInfo( ({"freundin"}), break_string("Meine beste Freundin heisst Lidda.", 45),"sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), break_string("Das ist mein Bruder. Der hat nur Flausen im Kopf. ", 45),"sagt: ");
  AddInfo( ({"rukus", "rukus karolus"}), break_string("Das ist der Bruder von Lidda. Der hat auch nur Unsinn im Kopf.", 45),"sagt: ");
  AddInfo( ({"kinder", "dorfkinder" }),
    "Ausser Lidda, Torben, Rukus und mich gibt es keine Kinder im Dorf. ", "sagt: ");

  AddInfo( ({"kelle", "silberne kelle", "silberkelle"}), #'q_kelle, "sagt: " );
  AddInfo( ({"tablett"}), #'q_tablett, "sagt: " );
  AddInfo( ({"bierhumpen", "humpen"}), #'q_bierhumpen, "sagt: " );
  AddInfo( ({"zapfhahn"}), #'q_zapfhahn, "sagt: " );

  AddInfo( ({"dieb", "diebe"}), "Diebe gibts hier eigentlich nicht.", "sagt: ");
  AddInfo( ({ "zeug", "zeugs", "krempel" }),
    "Ja ich sammle alles. Aber meine Mama sagt, ich soll auch mal was wegwerfen." ,
    "sagt: ");
  AddInfo( ({ "zimmer" }),
    "In meinem Zimmer hab ich viele schoen Sachen, wollt Ihr sie mal sehen?" ,
    "fragt: ");
  AddInfo( ({ "harzscharrer", "familie", "familien" }),
    "Meine Familie lebt hier im Dorf." ,
    "sagt: ");
  AddInfo( ({ "karolus" }),
    "Die Familie Karolus lebt auch hier im Dorf." ,
    "sagt: ");
  
  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "kleidchen.lpc" );
  command("trage alles");
  CLONEME( OBJ + "puppe.lpc" );
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich meiner Mama sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werd ich meiner Mama sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


