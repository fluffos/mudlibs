#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_burgbewohner.lpc";

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(16); //erstellt Standartwerte fuer NPC des Level x

  //Properties
  AddId(({"wache", "burgwache", "Eberhelm Schroeter", "eberhelm", "schroeter", "berater"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Eberhelm Schroeter");
  SetProp( P_LONG, 
    BS("Dies ist Eberhelm Schroeter, der taktische Berater des Freiherrn. Sein naechstes Projekt ist die Installation von "+
    "Pechkesseln auf den Tuermen, leider fehlen ihm die Arbeiter um dies zu realisieren. Er macht einen etwas abwesenden Eindruck "+
    "und schaut immer wieder skeptisch nach oben."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Eberhelm Schroeter");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, BURG + "zs_burg_og" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_og1_a1" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Eberhelm Schroeter"); //string fuer Todessequenz
  set_living_name("eberhelm"); 
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Chats
  SetAttackChats( 5, ({"Eberhelm Schroeter bruellt: Ihr kommt mir gerade recht! \n",
  	                   "Eberhelm Schroeter sagt: Schmeckt mein Schwert! \n",
  	                   "Eberhelm Schroeter sagt: Ihr entkommt mir nicht! \n",
  	                   "Eberhelm Schroeter bruellt: Euer Kopf wird bald die Burgzinnen schmuecken! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({ "projekt", "pechkessel" }),
    "Fragt mich besser spaeter nochmal .... " ,
    "sagt: ");

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "lederarmschienen_1.lpc" );
  CLONEME( ARMOUR + "lederhelm_2.lpc" );
  CLONEME( ARMOUR + "lederstiefel_3.lpc" );
  CLONEME( ARMOUR + "lederweste_1.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "dolch_1.lpc" );
  command("zuecke dolch");
  CLONEME( OBJ + "armbrust.lpc" );
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich dem Burgherrn sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werd ich dem Burgherrn sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


