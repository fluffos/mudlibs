inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

mixed _query_noattack()
{
  if(TP->QueryProp(P_LEVEL) > 10)
  return "ist doch viel zu klein fuer Dich. Du bist doch jetzt schon gross!";
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Maus");
  SetProp(P_LONG,
    "Eine kleine Maus. Mit ihren kleinen Knopfaugen schaut sie richtig niedlich aus. \n");
  SetProp(P_NAME, "Maus");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "maus" }));

  create_default_npc(2);

  SetProp(P_HANDS, ({" mit ihren Nagezaehnen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nagetier");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, KELLER );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, KELLER "zs_sublevel1_c3.lpc");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " ist zerquetscht. \n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich arme Maus ...");
  SetProp(P_KILL_NAME, "Maus");
  
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Maus kann Deine Sachen nicht tragen.\n" }) );

  CLONEME("/d/andracia/yondala/tal/aboriville/obj/kaesestueckchen.lpc");  
}

// Beim Tod macht das Kellermonsten noch schnell ne Kerbe ins Kerbholz:
void die(int poisondeath) {
  object killer, kerbholz;
  int ergebnis;
  killer = QueryProp(P_KILLER);
  kerbholz = present("\nkerbholz", killer);
  if(present("\nkerbholz", killer))
    {
      ergebnis = kerbholz->mach_kerbe(QueryProp(P_NAME));
      if(ergebnis == 1) 
        write("Auf wundersame Weise erscheint eine weitere Kerbe fuer Maeuse. \n");
      if(ergebnis == 2) 
        write("Von dieser Sorte Monster hast Du scheinbar schon genuegend vertilgt. \n");
    }
  ::die(poisondeath);
} 