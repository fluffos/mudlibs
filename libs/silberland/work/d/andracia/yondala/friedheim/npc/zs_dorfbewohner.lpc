inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("dorfbewohner")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
    
  AddId(({"dorfbewohner"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Ein Dorfbewohner.");
  SetProp( P_LONG, "Ein ganz normaler Dorfbewohner. \n");
  SetProp( P_NAME, "Dorfbewohner");
  SetProp( P_GENDER, MALE);
  SetProp( P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 178); //in cm
  SetProp( P_WEIGHT, 78000); //in g
  SetProp( P_ALIGN, 0); //Gesinnung von -1000 bis +1000
  SetProp( P_MAX_HANDS, 2); //Anzahl Haende
  SetProp( P_HEAL, 0); //Essbarkeit von -4 bis +4
  // SetProp( P_AGGRESSIVE, ([0:0.0]); //nicht aggressiv
  SetProp( P_WIMPY, 0); //nicht fluechten
  SetProp( P_NOMAGIC, 0); //keinen Magiewiderstand
  SetProp( P_RESISTANCE_STRENGTHS ,  //Widerstand gegen Schadentypen -1 (immun) bis +1 (doppelt)
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.2, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.5, DT_SOUND: -0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.2]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Dorfbewohner"); //string fuer Todessequenz
  SetProp( P_KILL_MSG, "HIHI - ich habe %s getoetet!");
  //  SetProp( P_LOG_FILE, LOG + "npc_logfile");
  SetProp( P_LOG_INFO, "missing_answers"); // Logfile fuer unbeantwortete Fragen

  //Antworten
  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Liebste von Yason.", "sagt: ");
  AddInfo( "nyx", "Nyx hilft Yondala und Yason.", "sagt: ");
  AddInfo( "aginor", "Aginor ist der boese Teil des Hochadels.", "sagt: ");
  
  
  AddInfo( ({"dorlen", "dorlen friedheim", "burgherrin"}), break_string("Dorlen Friedheim ist die Frau unseres"+
  "Freiherrn. Du findest Sie warscheinlich im zweiten Stock der Burg. ", 45),"sagt: ");
  AddInfo( ({"edorian", "edorian friedheim", "freiherr", "freiherrn", "burgherr"}), break_string("Edorian Friedheim ist unser geliebter  "+
  "Freiherr. Du findest Ihn warscheinlich im zweiten Stock der Burg. ", 45),"sagt: ");
  AddInfo( ({"lara", "lara friedheim", "burgfraeulein"}), break_string("Lara ist die huebsche Tochter des "+
  "Freiherrn. Du findest Sie warscheinlich im zweiten Stock der Burg. ", 45),"sagt: ");
  AddInfo( ({"jette", "jette linneweber"}), break_string("Das ist bestimmt eine der Zofen. "+
  "Geh in die Burg und frag da nach Ihr. ", 45),"sagt: ");
  AddInfo( ({"eberhelm", "eberhelm schroeter"}), break_string("Das ist der Taktische Berater unseres "+
  "Freiherrn. Geh in die Burg und frag da nach Ihm. ", 45),"sagt: ");
  AddInfo( ({"erna", "erna kollwanst"}), break_string("Das ist die Koechin auf der Burg. "+
  "Eine sehr nette Frau. ", 45),"sagt: ");
  AddInfo( ({"sindar", "sindar tucher", "bibliothekar"}), break_string("Das ist der Bibliothekar unseres "+
  "Freiherrn. Geh in die Burg und frag da nach Ihm. ", 45),"sagt: ");
  AddInfo( ({"vitus", "vitus gesse"}), break_string("Das ist der Knappe von Brin Roggenfeldt, "+
  "dem Hauptmann. Geh in die Burg und frag da nach Ihm. ", 45),"sagt: ");
  AddInfo( ({"brin", "brin roggenfeldt"}), break_string("Das ist der Hauptmann der Burgwache auf der Burg unseres "+
  "Freiherrn. Geh in die Burg und frag da nach Ihm. ", 45),"sagt: ");
  AddInfo( ({"yantur", "yantur leisten"}), break_string("Das ist der Burgschmied. Du kannst bei Ihm Deine "+
  "Ausruestung reparieren. In einer Ecke des Burghofs ist seine Schmiede. ", 45),"sagt: ");
  
  AddInfo( ({"bernhelm", "bernhelm kramer"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt hier irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"irian", "irian ilgur"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt hier irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"jobdan", "jobdan gerber"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt hier irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"celissa", "celissa harzscharrer"}), break_string("Dieses Maedchen wohnt hier im Dorf. "+
  "Die ist bestimmt hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), break_string("Dieses Maedchen wohnt hier im Dorf. "+
  "Die ist bestimmt hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"rukus", "rukus karolus"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt hier irgendwo. ", 45),"sagt: ");

  AddInfo( ({"eslam", "eslam kremso"}), break_string("Das ist einer der hier ansaessigen Haendler. "+
  "Du findest seinen Laden im Westen des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"rauert", "rauert arres"}), break_string("Das ist einer der hier ansaessigen Haendler. "+
  "Du findest seinen Laden im Osten des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"gumblad", "gumblad korber"}), break_string("Das ist einer der hier ansaessigen Wirte. "+
  "Du findest sein Lokal im Sueden des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"radulf", "radulf buchweiz"}), break_string("Das ist einer der hier ansaessigen Wirte. "+
  "Du findest sein Lokal im Norden des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"samson", "kramer", "buettel", "dorfbuettel"}), break_string("Unser Dorfbuettel Samson Palm "+
  "ist ein Veteran und hat schon so manche Schlacht geschlagen. Seinen Kampfschlegel gibt er nicht aus der "+
  "Hand aber sein verwegenes Ausshen reicht meistens schon um einen Kampf zu beenden.", 45),"sagt: ");

  AddInfo( ({"koenig"}), break_string("Wir haben keinen Koenig. Der Titel des Burgherrn ist "+
  "Freiherr, Freiherr Edorian von Friedheim.", 45),"sagt: ");
  AddInfo( ({"hilfe", "arbeit", "auftrag"}), break_string("Ich kann Dir nur empfehlen zu Sindar Tucher, dem "+
  "Bibliothekar zu gehen. Der weiss immer Rat. Du findest ihn im dritten Stock des Burgfrieds.", 45),"sagt: ");
  AddInfo( ({"quest", "aufgabe", "aufgaben", "arbeit", "auftrag"}), 
  break_string("Tut mir leid. Ich habe keine Arbeit fuer Dich. "+
  "Der Freiherr sucht aber immer Leute fuer alle moeglichen Aufgaben. ", 45),"sagt: ");
  AddInfo( ({"burg", "friedheim"}), break_string("Die Burg Friedheim ist der "+
  "Sitz des Freiherrn von Friedheim. ", 45),"sagt: ");
  AddInfo( ({"welt", "andracia"}), break_string("Diese Welt wird Andracia genannt. "+
  "Geh zu Sindar Tucher, dem Bibliothekar, der kann Dir viel ueber unsere Welt erzaehlen. ", 45),"sagt: ");
  AddInfo( ({"essen", "trinken"}), break_string("Fuer die Verpflegeung kannst Du im Dorf die "+
  "Gasthauser aufsuchen: im Norden den goldenen Schwan im Sueden den rostigen Nagel. "+
  "Die Burgkoechin wird Dir auch was gegen den Hunger zubereiten wenn Du nett fragst. ", 45),"sagt: ");
  AddInfo( ({"liebe"}), break_string("Die Liebe ist ein Geschenk. Halt Sie fest wenn Du sie "+
  "findest. ", 45),"sagt: ");

  AddInfo( ({"kuchen"}), break_string("Jeder mag Kuchen. ", 45),"sagt: ");
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", "asseln", "spinnen", "maeuse", "ratten"}), 
    "Kaefer, Asseln, Spinnen, Mauese und Ratten sind Ungeziefer. Zum Glueck haben wir hier im Dorf kein Problem damit." ,"sagt: ");
  AddInfo( ({"keller"}), break_string("Im Keller ist sehr viel Ungeziefer. Der Freiherr bezahlt angehende "+
  "Kammerjaeger gut. ", 45),"sagt: ");
  AddInfo( ({"kammerjaeger"}), break_string("Frag den Freiherrn, er sucht schon lange nach Kammerjaegern. ", 45),"sagt: ");

  AddInfo( ({"fackel", "licht"}), break_string("Eine Fackel kann man sicher im Laden kaufen. ", 45),"sagt: ");

  AddInfo( ({"nagel", "naegel"}), "Vielleicht haben ja die Haendler hier Naegel fuer Dich.", "sagt: ");
  AddInfo( ({"kirschen", "kirsche", "apfel", "aepfel", "pfirsich", "pfirsiche", "birne", "birnen", "pflaume", "pflaumen"
  	         "aprikose", "aprikosen", "obst" }), 
  	"Mhm - zwischen Dorf und Burg ist eine kleine Obstwiese. Vielleicht findet ihr dort was ihr sucht.", "sagt: ");
  AddInfo( ({"hafen", "hafendorf"}), 
  	"Das Hafendorf befindet sich ein gutes Stueck westwaerts. ", "sagt: ");
  AddInfo( ({"kampf"}), "Der Freiherr kaempft gegen das Ungeziefer in seiner Burg, oder was meint ihr sonst?", "sagt: ");
  AddInfo( ({ "huhn", "huehner", "huehnern" }),
    "Huehner kann man sicher bei der Herberge finden. " ,
    "sagt: ");
  AddInfo( ({ "kuh", "kuehe" }),
    "Kuehe kann man sicher bei der Herberge finden. " ,
    "sagt: ");
  AddInfo( ({ "kutsche" }),
    "Die Kutsche verkehrt vom Dorf hier direkt bis zum Hafen. " ,
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Dieses diebische Volk hat sich im Suedosten in einer Hoehle eingenistet. Geht da lieber nicht hin - eure Boerse "+
    "wird es Euch danken." ,
    "sagt: ");
  AddInfo( ({"kinder", "dorfkinder", "junge", "jungen", "maedchen" }),
    "Die Familien Harzscharrer und Karolus haben Kinder, die hier im Dorf ihr Unwesen treiben. "+
    "Beides mal sind es Zwillinge mit einem Jungen und einem Maedchen. Aber alle vier sind richtige Lausebengel, "+
    "immer wieder stellen sie etwas dummes an.", 
    "sagt: ");
  AddInfo( ({ "dieb", "diebe", "diebesgut", "dieben" }),
    "Radulf, der Wirt vom rostigen Nagel, hat davon geprochen dass ihm etwas gestohlen worden sei." ,
    "sagt: ");
  AddInfo( ({ "herberge" }),
    "An der Strasse zum Hafen gibt es eine Herberge. Allerdings haelt die Kutsche dort nicht." ,
    "sagt: ");
  AddInfo( ({ "obstwiese", "fallobstwiese", "obstbaum" }),
    "Die Obstwiese befindest sich ein Stueckchen unterhalb der Burg." ,
    "sagt: ");
  AddInfo( ({ "pflaumenbaum", "apfelbaum", "birnenbaum", "kirschbaum", "birnbaum" }),
    "Auf der Obstwiese befinden sich mehrere Obstbaeume. Neben einem Apfelbaum ist dort auch ein Pflaumenbaum, "+
    "ein Kirschbaum und ein Birnenbaum." ,
    "sagt: ");
  AddInfo( ({ "schaufel" }),
    "Normalerweise kann man eine Schaufel in den Laeden kaufen. Versucht es dort." ,
    "sagt: ");
  AddInfo( ({ "post" }),
    "Die Post befindet sich suedoestlich des Dorfplatzes." ,
    "sagt: ");
  AddInfo( ({ "felder", "feld" }),
    "Die Felder stehen voll im Korn. Es wird dieses Jahr eine gute Ernte geben." ,
    "sagt: ");
  AddInfo( ({ "zeug", "krempel", "dinge" }),
    "Bei den Haendlern finden man immer was brauchbares." ,
    "sagt: ");
  AddInfo( ({ "gasthaus", "kneipe" }),
    "Bei Radulf in seinem Gasthaus im Norden des Dorfs kann man gut essen, versucht es dort." ,
    "sagt: ");
  AddInfo( ({ "haendler", "laden" }),
    "Im Osten und Westen des Dorfplatzes haben sich Haendler niedergelassen." ,
    "sagt: ");
  AddInfo( ({ "weg" }),
    "Ich weiss doch gar nicht wo Ihr hinwollt, wie soll ich Euch dann den Weg erklaeren?" ,
    "sagt: ");
  AddInfo( ({ "obstpfluecker" }),
    "Soweit ich weiss hat Erna, die Burgkoechein, einen Obstpfluecker mit dem man auch hoeher wachsende Fruechte ernten kann." ,
    "sagt: ");
  AddInfo( ({ "bank" }),
    "Unsere Bank ist leider geschlossen - ich weiss auch nicht wann Sie wieder aufmacht." ,
    "sagt: ");  
  AddInfo( ({ "mehl" }),
    "Im Vorratskeller der Burg befndet sich bestimmt ein grosser Vorrat an Mehl." ,
    "sagt: ");
  AddInfo( ({ "waffe", "waffen" }),
    "Die Laeden hier im Dorf handeln mit allem. Vielleicht baen sie ja auch eine brauchbare Waffe fuer Euch." ,
    "sagt: ");
  AddInfo( ({ "uebeltaeter" }),
    "Uebeltaeter werden im Kerker von Friedheim eingesperrt." ,
    "sagt: ");
  AddInfo( ({ "milch" }),
    "Kuehe geben Milch. Bei der Herberge gibt es bestimmt ein paar Kuehe die man melken kann." ,
    "sagt: ");
  AddInfo( ({ "reparieren", "reparatur" }),
    "Der Schmied der Burg kann vielleicht Euch hierbei weiterhelfen." ,
    "sagt: ");
  AddInfo( ({ "schmied", "schmiede" }),
    "Hier im Dorf gibt es leider keine Schmied, aber in der Burg zu Friedheim hat Yantur Leisten im Burghof eine "+
    "Schmiede eingerichtet." ,
    "sagt: ");
  AddInfo( ({ "chitin", "chitinplatte", "chitinplatten" }),
    "Ich finde diese Insektenkoerper widerlich! Aber ich habe einmal davon gehoert dass Bewohner von Hoehlen und Stollen "+
    "oft Kaefer zuechten, um sie zu essen und aus ihren Chitinplatten Ruestungen zu schneidern." ,
    "sagt: ");
  AddInfo( ({ "schneider", "schneiderei" }),
    "Hier in Friedheim hat sich leider kein Schneider niedergelassen." ,
    "sagt: ");
  AddInfo( ({ "gasthaus", "nahrung", "gasthaeuser", "mahlzeit", "lokal", "kneipe" }),
    "Wir haben hier sogar zwei Gasthaeuser im Dorf. Gumblad Korber hat sein feines Gasthaus im Sueden und "+
    "Radulf Buchweiz hat seine Kneipe im Norden." ,
    "sagt: ");
  AddInfo( ({ "kueche" }),
    "In den Gasthaeuser sollte man nicht in die Kueche schauen, sonst schmeckt einem das Essen dort vielleicht nicht mehr. "+
    "Aber in der Kueche von Erna, der Burgkoechin, kann man getrost hinein schauen, sie freut sich immer ueber Besucher." ,
    "sagt: ");
  AddInfo( ({ "kuerbis", "kuerbisse", "kartoffel", "kartoffeln" }),
    "Wir bauen Kartoffeln und Kuerbisse an. Aber die meissten Felder stehen mit Getreide voll. Es wird bestimmt ein gutes "+
    "Jahr mit einer grossen Ernte." ,
    "sagt: ");
  AddInfo( ({ "dorf" }),
    "Dies ist das Dorf zu Friedheim. Was wollt ihr denn genau wissen?" ,
    "sagt: ");
  AddInfo( ({ "dorfplatz", "platz" }),
    "Im Zentrum des Dorf ist der grosse Dorfplatz. Dort findet ihr Haendler, die Kapelle und die Kutsche pendelt von dort "+
    "zum Hafendorf." ,
    "sagt: ");
  AddInfo( ({ "hafendorf" }),
    "Das Hafendorf findet ihr ein gutes Stueck gen Westen. Nehmt doch die Kutsche die vom Dorfplatz dorthin pendelt." ,
    "sagt: ");
  AddInfo( ({ "osten", "oestlich" }),
    "Die Strasse die nach Osten aus dem Dorf fuehrt, bringt Euch direkt zur Burg Friedheim. " ,
    "sagt: ");
  AddInfo( ({ "westen",  "westlich" }),
    "Wenn ihr nach Westen das Dorf verlasst kommt ihr an verschiedenen Kreuzungen vorbei, an denen aber immer die Ziele "+
    "an einem Wegweiser ausgeschildert sind. Der Freiherr hat diese erst letztes Jahr aufstellen lassen." ,
    "sagt: ");
  AddInfo( ({ "jonatan" }),
    "Jonatan ist sehr ungluecklich. Vielleicht koennt Ihr ihm ja helfen." ,
    "sagt: ");
  AddInfo( ({ "karolus" }),
    "Die Familie Karolus lebt hier im Dorf. Ihre Kinder springen hier irgendwo herum." ,
    "sagt: ");
  AddInfo( ({ "harzscharrer" }),
    "Die Familie Harzscharrer lebt hier im Dorf. Ihre Kinder springen hier irgendwo herum." ,
    "sagt: ");
  AddInfo( ({ "familie", "familien" }),
    "Es gibt viele Familien hier im Dorf Friedheim." ,
    "sagt: ");
  AddInfo( ({ "graben", "grabung" }),
    "Ohne Schaufel koennt Ihr nicht graben." ,
    "sagt: ");
  AddInfo( ({ "bibliothek" }),
    "In der Burg befindet sich eine umfangreiche Bibliothek, die meint Ihr doch, oder?" ,
    "sagt: ");
  AddInfo( ({ "bergfried" }),
    "Geht doch einfach zur Burg und schaut Euch dort den Burgfried an." ,
    "sagt: ");
  AddInfo( ({ "weg zur burg" }),
    "Ihr muesst das Dorf nach Westen verlassen und dann koennt Ihr die Burg kaum mehr verfehlen." ,
    "sagt: ");


/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
