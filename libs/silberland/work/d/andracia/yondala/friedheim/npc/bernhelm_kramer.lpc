#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_dorfbewohner.lpc";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(12); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"bernhelm", "kramer", "Bernhelm Kramer", "bauer" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Bernhelm Kramer, ein Bauer");
  SetProp( P_LONG, BS("Dies ist Bernhelm Kramer, ein Bauer. Seine Felder liefern das Korn fuer die Muehle. "+
    "Nur die Felder des Freiherrn sind groesser. Er hat einen Oberlippenbart und schaut etwas schmuddelig aus."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Bernhelm Kramer");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Bauer"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetAttackChats( 5, ({"Bernhelm Kramer bruellt: Ich ramm Dir meine Mistgabel in den Bauch! \n",
  	                   "Bernhelm Kramer ruft: Verfluchter Raufbold! \n",
  	                   "Bernhelm Kramer bruellt: Stirb Du Flegel! \n",
  	                   "Bernhelm Kramer ruft: Ihr tretet gleich vor euren Schoepfer! \n"  }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({ "korn", "kornfelder" }),
    "Ich habe grosse Kornfelder, da Ihr aber kein Mehl mahlen duerft macht es keinen Sinn, Euch mein Korn zu verkaufen." ,
    "sagt: ");
  AddInfo( ({ "muehle" }),
    "Ich bringe mein Korn immer zur Muehle des Freiherrn. " ,
    "sagt: ");

/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  AddDetail( ({"oberlippenbart", "bart", "antlitz"}), BS(
    "Der Oberlippenbart von Bernhelm Kramer gibt ihm ein etwas freundlicheres Antlitz.") );

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "stoffhose.lpc" );
  CLONEME( ARMOUR + "leinenhemd.lpc" );
  CLONEME( ARMOUR + "sandalen.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "mistgabel.lpc" );
  command("zuecke gabel");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


