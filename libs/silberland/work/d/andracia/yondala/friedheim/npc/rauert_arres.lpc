#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_dorfbewohner.lpc";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(15); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"rauert", "arres", "haendler", "Rauert Arres" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Rauert Arres, ein Haendler");
  SetProp( P_LONG, BS("Dies ist Rauert Arres, ein Haendler. Mit sich feilschen laesst er nicht, "+
    "aber seine Waren sind fast immer beste Qualitaet. Er ist gut gekleidet und seine Glatze "+
    "glaenzt richtig."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Rauert Arres");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF + "zwirbelstein_haendler_e5.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF + "zwirbelstein_haendler_e5.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Haendler"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetChats( 1, ({"Rauert Arres sagt: Qualitaet hat seinen Preis.  \n",
  	             "Rauert Arres sagt: Nicht draengeln, bitte! \n",
  	             "Rauert Arres staubt ein paar Waren ab. \n",
  	             "Rauert Arres steht hilfbereit hinter seinem Verkaufstisch und grinst. \n"}) ); //rate in %
  SetAttackChats( 5, ({"Rauert Arres bruellt: Stirb Du Dieb! \n",
  	                   "Rauert Arres schreit: Dir werd ich Mores lehren! \n",
  	                   "Rauert Arres ruft: Verschwinde Du Stoerenfried. \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"rabatt", "kredit", "rabatte", "kredite" }), 
    "Seh ich so aus als gaeb's das Hier? An meinen Preisen gibt es nichts zu verhandeln! ", 
    "sagt: ");
  AddInfo( ({"angebot", "waren", "angebote"}), 
    "Meine Waren sind alle einwandfrei. Mit 'zeige' koennt ihr Euch einen Ueberblick verschaffen. ", 
    "sagt: ");
  AddInfo( ({ "preis", "preise" }),
    "Die Preise sind nicht verhandelbar. " ,
    "sagt: ");
  AddInfo( ({ "glatze" }),
    "Ihr wollt wissen wie ich meine Glatze zum glaenzen bringe? Nein, das verrat ich Euch nicht." ,
    "sagt: ");
/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  //Ausruestung
  /* SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( "Pfad/datei" );
  command("zuecke waffe");
  CLONEME( "Pfad/datei" );
  command("trage alles");*/
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


