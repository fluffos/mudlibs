#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_burgbewohner.lpc";

mapping fieser_moep;

string get_pfluecker(string str);
string get_schuessel(string str);
string get_backform(string str);
string get_rezept(string str);

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(12); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"erna", "kollwanst", "wirt", "Erna Kollwanst", "burgkoechin", "koechin" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Erna Kollwanst, die Burgkoechin");
  SetProp( P_LONG, 
    BS("Dies ist Erna Kollwanst, die Burgkoechin. Eine gemuetliche, beleibte Frau mittleren Alters. "+
    "Ihre Kochkunst ist zwar was Deftiges und Scharfes angeht gut, aber sobald es um suesse Dinge geht "+
    "gelingt ihr nichts. "));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Erna Kollwanst");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, BURG + "zs_burg_eg_a2.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, BURG + "zs_burg_eg_a2.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Burgkoechin"); //string fuer Todessequenz
  set_living_name("erna"); 
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );

  //Chats
  SetChats( 1, ({"Erna Kollwanst sagt: Steht mir nicht im Weg! \n",
  	             "Erna Kollwanst fragt: Habt Ihr Hunger? \n",
  	             "Erna Kollwanst sagt: Kann mir denn niemand helfen? \n"}) ); //rate in %
  SetAttackChats( 5, ({"Erna Kollwanst ruft: Hilfe! \n", 
  	                   "Erna Kollwanst schreit: Mit Euch werde ich den Boden aufwischen! \n",
  	                   "Erna Kollwanst sagt: Euch koche ich nichts mehr. \n"}) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"poekelfleisch", "salz"}), "Das hab ich hier in meiner Kueche - aber davon kann ich Euch nichts geben.", "sagt: ");
  AddInfo( ({ "kochkunst", "kochkuenste", "eintopf", "huehnchen" }),
    "Meine Rezepte fuer Eintopf und Huehnchen verrate ich Euch nicht!" ,
    "sagt: ");

  //Ausruestung
  /* SUID; //Anmelden als Erzeuger von geclonten Objekten und ausfuehrenden Commands
  CLONEME( "Pfad/datei" );
  command("zuecke waffe");
  CLONEME( "Pfad/datei" );
  command("trage alles");*/

  // Questinfos
  AddInfo( ({ "hilfe", "aufgabe", "problem" }) ,
    "Ja, ich benoetige Hilfe. Das Burgfraeulein haette gerne einen Kuchen "+
    "aber leider hab ich gerade gar keine Zeit dazu einen Kuchen zu backen. Koennt Ihr "+
    "das nicht fuer mich erledigen? Wenn Ihr Euch daran versuchen wollt, so bietet mir "+
    "Eure Hilfe an." ,
    "sagt: ");

  AddInfo( ({ "kuchen" }),
    "Einen Kuchen zu backen ist sehr einfach: Zuerst muesst Ihr in einer Schuessel einen Teig aus "+
    "Mehl, Milch, Eier und Zucker herstellen. Damit legt Ihr dann eine Backform aus und belegt diesen "+
    "dann mit Obst. Das muss dann in den Ofen und nach kurzer Zeit ist der Kuchen schon fertig. " ,
    "sagt: ");
  AddInfo( ({ "teig", "zutaten" }),
    "Der Teig fuer einen Kuchen besteht aus 3 Eiern, etwas Mehl, etwas Zucker und etwas Milch. "+
    "Eine Schuessel zum Kneten der Zutaten koennt Ihr gerne von mir bekommen. " ,
    "sagt: ");
  AddInfo( ({ "mehl" }),
    "Im Keller muesste noch ein bischen Mehl zu finden sein. " ,
    "sagt: ");
  AddInfo( ({ "milch" }),
    "Frische Milch bekommt man von einer Kuh. Man muss sie nur melken. ",
    "sagt: ");
  AddInfo( ({ "eiern", "eier", "ei" }),
    "Huehner legen Eier. " ,
    "sagt: ");
  AddInfo( ({ "huehner", "huhn", "huehnern" }),
    "Huehner kann man sicher bei der Herberge finden. " ,
    "sagt: ");
  AddInfo( ({ "herberge" }),
    "Die Herberge befindet sich auf dem Weg zum Hafen. " ,
    "sagt: ");
  AddInfo( ({ "zucker" }),
    "Im Keller muesste noch ein bischen Zucker zu finden sein. " ,
    "sagt: ");
  AddInfo( ({ "kirschen", "kirsche", "apfel", "aepfel", "pfirsich", "pfirsiche", "birne", "birnen", "pflaume", "pflaumen"
  	         "aprikose", "aprikosen", "obst"  }),
    "Aepfel, Birnen, Kirschen und Pflaumen findet man in der Fallobstwiese suedlich der Burg. "+
    "Fuer einen Apfelkuchen benoetigt Ihr 3 Aepfel, fuer einen Birnenkuchen 3 Birnen, fuer einen Kirschkuchen "+
    "3 handvoll Kirschen, fuer einen Pflaumenkuchen 3 handvoll Pflaumen und fuer einen Obstkuchen einen Apfel, "+
    "eine Birne, eine handvoll Kirschen und eine handvoll Pflaumen. Ich habe auch einen Obstpfluecker falls "+
    "alles erreichbares Obst schon geerntet wurde. "  ,
    "sagt: ");
  AddInfo( ({ "ofen" }),
    "Der Ofen hier in der Kueche ist schon vorgeheizt. Ihr koennt ihn gerne benutzen. " ,
    "sagt: ");
  AddInfo( ({ "zeit" }),
    "Wenn der Kuchen erst mal im Ofen ist muesst Ihr nur noch abwarten bis er fertig ist. " ,
    "sagt: ");
  AddInfo( ({ "obstkuchen" }),
    "Fuer einen Obstkuchen benoetigt Ihr eine handvoll Pflaumen, eine handvoll Kirschen, "+
    "einen Apfel und eine Birne, aber frag das Burgfraeulein ob sie auch wirklich einen Obstkuchen will. " ,
    "sagt: ");
  AddInfo( ({ "kirschkuchen" }),
    "Fuer einen Kirschkuchen benoetigt Ihr 3 handvoll Kirschen, aber frag das Burgfraeulein "+
    "ob sie auch wirklich einen Kirschkuchen will. " ,
    "sagt: ");
  AddInfo( ({ "pflaumenkuchen" }),
    "Fuer einen Pflaumenkuchen benoetigt Ihr 3 handvoll Pflaumen, aber frag das Burgfraeulein "+
    "ob sie auch wirklich einen Pflaumenkuchen will. " ,
    "sagt: ");
  AddInfo( ({ "apfelkuchen" }),
    "Fuer einen Apfelkuchen benoetigt Ihr 3 Aepfel, aber frag das Burgfraeulein ob sie auch "+
    "wirklich einen Apfelkuchen will. ",
    "sagt: ");
  AddInfo( ({ "birnenkuchen" }),
    "Fuer einen Birnenkuchen benoetigt Ihr 3 Birnen, aber frag das Burgfraeulein ob sie auch "+
    "wirklich einen Birnenkuchen will. " ,
    "sagt: ");
  AddInfo( ({ "keller", "vorraete", "vorrat" }),
    "Alle Vorraete sind im Keller, aber dort sind mir zuviele Ungeziefer. Ich hoffe der Freiherr unternimmt mal was dagegen. " ,
    "sagt: ");
  AddInfo( ({ "kuh", "kuehe" }),
    "Kuehe kann man sicher bei der Herberge finden. " ,
    "sagt: ");
  AddInfo( ({ "burgfraeulein", "fraeulein" }),
    "Das Burgfraeulein Lara Friedheim hat einen Kuchen bestellt, aber ich finde einfach keine "+
    "Zeit ihn zu backen. Ich weiss nicht mal mehr was fuer eine Sorte Kuchen sie haben wollte. " ,
    "sagt: ");
  AddInfo( ({ "kaese" }),
    "Ich mag keinen Kaese. Ich kann den Geruch kaum ertragen. " ,
    "sagt: ");
  AddInfo( ({ "sorte" }),
    "Ihr koennt verschiedene Kuchensorten backen, aber fragt besser beim Fraeulein nach, welche Sorte sie gerne haette." ,
    "sagt: ");
  AddInfo( ({ "kochen", "backen" }),
    "Ihr koennt Euch bei mir gerne als Kuchenbaecker versuchen. Bietet mir einfach Eure Hilfe an und "+
    "schon erklaere ich Euch, wie das mit dem Kuchenbacken laeuft." ,
    "sagt: ");
  AddInfo( ({ "angebot", "waren", "angebote", "menue", "essen", "trinken", "nahrung", "mahlzeit", "lokal", "kneipe" }),
    "Ja, hier koennt Ihr etwas kleines zu essen haben. Schaut mit 'menue' was ich Euch anbieten kann "+
    "und bestellt, was Ihr haben moechtet." ,
    "sagt: ");
  AddInfo( ({ "gasthaus", "gasthaeuser" }),
    "Dies hier ist zwar kein Gasthaus aber verhungern muesst Ihr nicht." ,
    "sagt: ");
  AddInfo( ({ "kueche", "hier" }),
    "Das ist meine Kueche, also benehmt Euch und macht mir nicht zuviel Unordnung." ,
    "sagt: ");
  AddInfo( ({ "lieblingskuchen" }),
    "Ich mag eigentlich keinen Kuchen, aber das Burgfraeulein Lara wollte einen haben, aber ich weiss auch gar nicht mehr "+
    "was fuer einen. Wollt Ihr nicht dabei helfen?" ,
    "sagt: ");
  AddInfo( ({ "backzeit" }),
    "Bei meinen Ofen dauert es nicht lange bis ein Kuchen fertig ist, versucht es einfach." ,
    "sagt: ");
  AddInfo( ({ "fertig", "gebacken" }),
    "Bitte bringt den fertig gebackenen Kuchen zum Burgfraeulein Lara." ,
    "sagt: ");
  AddInfo( ({ "messer" }),
    "Ich hab hier einige Messer, Ihr koennt sie benutzen aber mitnehmen duerft Ihr sie nicht." ,
    "sagt: ");

  AddInfo( ({ "obstpfluecker", "pfluecker" }), #'get_pfluecker, "sagt: ");
  AddInfo( ({ "schuessel" }), #'get_schuessel, "sagt: ");
  AddInfo( ({ "backform", "form", "kuchenform", "blech" }), #'get_backform, "sagt: ");
  AddInfo( ({ "rezept" }), #'get_rezept, "sagt: ");

  AddInfo( ({"schrank", "schraenke"}), break_string("Geh mir bitte nicht an meine Schraenke. ", 45),"sagt: ");
  AddInfo( ({"belohnung"}), break_string("Ich bin nur eine arme Koechin. Aber Ihr koennt jederzeit wiederkommen "+
    "und fuer Euch selbst Kuchen backen.", 45),"sagt: ");
  AddInfo( ({"schluessel"}), break_string("Ich habe keinen Schluessel. ", 45),"sagt: ");
/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  AddCmd( ({ "biete" }) , "start_quest" );

}

give_notify(object ob)
{
	if( ob->id("\nobstpfluecker") ) 
		{
			write( TO->Name()+" sagt: Vielen Dank dass Du mir den Obstpfluecker zurueck bringst! \n");
			ob->remove(1);
			return;
    }
	if( ob->id("\nbackform") ) 
		{
			write( break_string("Vielen Dank dass Du mir die Backform zurueck gibst! Braucht Ihr Sie denn nicht mehr?", 78, TO->Name()+" sagt: ") );
			ob->remove(1);
			return;
    }
	if( ob->id("\nrezept") ) 
		{
			write( TO->Name()+" sagt: Behalte das Rezept, vielleicht wollt Ihr ja mal wieder einen Kuchen backen. \n");
			ob->move(TP, M_GET);
			return;
    }
	if( ob->id("\nteigschuessel") ) 
		{
			write( break_string("Vielen Dank dass Du mir die Teigschuessel zurueck gibst! Braucht Ihr Sie denn nicht mehr?", 78, TO->Name()+" sagt: ") );
			ob->remove(1);
			return;
    }
	if( ob->id("\nobstkuchen") ) 
		{
			write( break_string( "Den Kuchen muesst Ihr Lara Friedheim bringen. Aber vergewissert Euch lieber ob Sie auch wirklich einen Obstkuchen will.", 78, TO->Name()+" sagt: ") );
			ob->move(TP, M_GET);
			return;
    }
	if( ob->id("\nkirschkuchen") ) 
		{
			write( break_string( "Den Kuchen muesst Ihr Lara Friedheim bringen. Aber vergewissert Euch lieber ob Sie auch wirklich einen Kirschkuchen will.", 78, TO->Name()+" sagt: ") );
			ob->move(TP, M_GET);
			return;
    }
	if( ob->id("\npflaumenkuchen") ) 
		{
			write( break_string( "Den Kuchen muesst Ihr Lara Friedheim bringen. Aber vergewissert Euch lieber ob Sie auch wirklich einen Pflaumenkuchen will.", 78, TO->Name()+" sagt: ") );
			ob->move(TP, M_GET);
			return;
    }
	if( ob->id("\napfelkuchen") ) 
		{
			write( break_string( "Den Kuchen muesst Ihr Lara Friedheim bringen. Aber vergewissert Euch lieber ob Sie auch wirklich einen Apfelkuchen will.", 78, TO->Name()+" sagt: ") );
			ob->move(TP, M_GET);
			return;
    }
	if( ob->id("\nbirnenkuchen") ) 
		{
			write( break_string( "Den Kuchen muesst Ihr Lara Friedheim bringen. Aber vergewissert Euch lieber ob Sie auch wirklich einen Birnenkuchen will.", 78, TO->Name()+" sagt: ") );
			ob->move(TP, M_GET);
			return;
    }

  ::give_notify(ob);	
}

// Questfunktionen
int start_quest(string str)
{ 
	object ob;
  notify_fail("Was willst Du anbieten? \n");
  if( str != "hilfe an" && str != "erna hilfe an" ) return 0;
  if( !present("\nrezept", TP) ){
    tell_room(environment(TO), 
    "Erna Kollwanst sagt: Danke, "+ TP->QueryProp(P_NAME) +", ich hab einfach \n"+
    "Erna Kollwanst sagt: keine Zeit fuer sowas. Wenn Du einen Kuchen backen willst \n"+
    "Erna Kollwanst sagt: so muesst Ihr erst einen Teig kneten und diesen dann in \n"+
    "Erna Kollwanst sagt: einer Backform auslegen und mit Obst belegen. Schuessel \n"+
    "Erna Kollwanst sagt: und Backform bekommt Ihr von mir. Hier hat Ihr einen \n"+
    "Erna Kollwanst sagt: kleinen Rezeptzettel auf dem alles zum Kuchenbacken \n"+
    "Erna Kollwanst sagt: drauf steht. Das Burgfraeulein wartet schon. \n" 
    );
    say("Erna Kollwanst gibt "+ TP->QueryProp(P_NAME) +" einen Rezeptzettel. \n", TP );
    write("Erna Kollwanst gibt Dir einen Rezeptzettel. \n" );
    ob = clone_object(OBJ + "kuchen_rezept.lpc");
    ob->move(TP, M_SILENT); 
  }
  else
    tell_room(environment(TO), 
    "Erna Kollwanst sagt: Danke, "+ TP->QueryProp(P_NAME) +", ich hab einfach \n"+
    "Erna Kollwanst sagt: keine Zeit fuer sowas. Du hast doch noch das Rezept \n"+
    "Erna Kollwanst sagt: fuer Kuchen, nicht wahr? Du kannst gerne auch fuer \n"+
    "Erna Kollwanst sagt: Dich selbst einen Kuchen backen. Hauptsache das \n"+
    "Erna Kollwanst sagt: Burgfraeulein hat ihren Kuchen.\n" 
    );
  return 1;
}

string get_pfluecker(string str)
{
	object ob;
	if( TP->QueryQuest("Kuchen fuer das Burgfraeulein") ) 
	   return "Du brauchst meinen Obstpfluecker nicht mehr";
	if( present( "\nobstpfluecker", TP) ) return "Du hast meinen Obstpfluecker doch schon. ";
	ob = clone_object(OBJ + "obstpfluecker.lpc");
	if( ob->move(TP,M_GET) != 1) 
		{ ob->remove(); return "Du kannst leider meinen Obstpfluecker nicht tragen. ";}
  say("Erna Kollwanst gibt "+ TP->QueryProp(P_NAME) +" einen Obstpfluecker. \n", TP );
  write("Erna Kollwanst gibt Dir einen Obstpfluecker. \n" );
	return "Ich leihe Dir gerne meinen Obstpfluecker. Sobald dein Kuchen "+
	   "aber fertig ist, muesst Ihr ihn zuruecklegen. ";
}

string get_schuessel(string str)
{
	object ob;
	if( present( "\nteigschuessel", TP) ) return "Du hast meine Schuessel doch schon. ";
	ob = clone_object(OBJ + "teigschuessel.lpc");
	if( ob->move(TP,M_GET) != 1) 
		{ ob->remove(); return "Du kannst leider meine Schuessel nicht tragen. ";}
  say("Erna Kollwanst gibt "+ TP->QueryProp(P_NAME) +" eine Teigschuessel. \n", TP );
  write("Erna Kollwanst gibt Dir eine Teigschuessel. \n" );
	return "Ich gebe Dir gerne eine meiner Schuesseln. Du kannst deinen Teig darin anruehren. ";
}

string get_backform(string str)
{
	object ob;
	if( present( "\nbackform", TP) ) return "Du hast meine Backform doch schon. ";
	ob = clone_object(OBJ + "backform.lpc");
	if( ob->move(TP,M_GET) != 1) 
		{ ob->remove(); return "Du kannst leider meine Backform nicht tragen. ";}
  say("Erna Kollwanst gibt "+ TP->QueryProp(P_NAME) +" eine Backform. \n", TP );
  write("Erna Kollwanst gibt Dir eine Backform. \n" );
	return "Ich gebe Dir gerne eine meiner Backformen. Du kannst deinen Teig darin auslegen. ";
}

string get_rezept(string str)
{
	object ob;
	if( !TP->QueryQuest("Kuchen fuer das Burgfraeulein") ) 
		return "Bitte biete mir doch deine Hilfe an, dann kann ich Dir auch ein Kuchenrezept geben.";
  if( present("\nrezept", TP) )
  	return "Du hast Doch schon meinen Rezeptzettel. Mehr als einen braucht Ihr wirklich nicht.";

  say("Erna Kollwanst gibt "+ TP->QueryProp(P_NAME) +" einen Rezeptzettel. \n", TP );
  write("Erna Kollwanst gibt Dir einen Rezeptzettel. \n" );
  ob = clone_object(OBJ + "kuchen_rezept.lpc");
  ob->move(TP, M_SILENT); 
	return "Ich gebe Dir gerne wieder einen Rezeptzettel fuer Kuchen. Verlier ihn nicht wieder. ";
}	

// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Ihr das nochmal macht, werde ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Ihr das nochmal macht, werde ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            environment(this_object())->set_ban(getuid(this_player()), 3);
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


