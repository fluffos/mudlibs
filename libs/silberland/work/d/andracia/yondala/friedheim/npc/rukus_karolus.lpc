#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_dorfbewohner.lpc";

string q_kelle()
{
  object ob;
  if( !present("\nabring",TP) && ob=present("\nabquest",TP) )
  if( ob->QueryDiebesgut()=="eine silberne Kelle" )
  {
    if( id(ob->QueryVillian()) )
      return "Nagut - ich hab dem ollen Radulf "+ob->QueryDiebesgut()+" geklaut und "+ob->QueryOrt()+" vergraben. Hehe, bekommt er nie wieder.";
    return "Ich weiss von nix.";
  }
  return "Vielleicht kann Euch einer der Haendler sowas verkaufen.";
}

