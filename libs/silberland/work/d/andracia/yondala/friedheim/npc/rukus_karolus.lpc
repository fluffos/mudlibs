void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(7); //erstellt Standartwerte fuer NPC des Level x

  //Properties
  AddId(({"rukus", "karolus", "Rukus Karolus", "junge", "Rukus" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Rukus Karolus, ein kleiner Junge");
  SetProp( P_LONG, BS( "Dies ist Rukus Karolus, ein kleiner Junge. "+
    "Er hat nur Flausen im Kopf und hat schon manche Dummheit begangen. Er hat kurzes Schwarzes Haar und seine "+
    "blauen Augen funkeln, als ob er gerade eine Gemeinheit aushecken wuerde. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Rukus Karolus");
  SetProp( P_WIMPY, 5); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Junge"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  AddDetail( ({"zwille"}) , 
    BS("Rukus, der Lausebengel, hat damit schon manchem einen Kirschkern an den Po geschossen."));

  //Chats
  SetAttackChats( 5, ({"Rukus Karolus bruellt: Hilfe, ein Moerder! \n",
  	                   "Rukus Karolus ruft: Steht mir bei, er will mich toeten! \n",
  	                   "Rukus Karolus versucht zu entkommen! \n",
  	                   "Rukus Karolus sagt: Warum trachtet ihr mir nach dem leben? \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"eltern", "papa", "mama"}), "Meine Eltern sind gerade auf den Feldern am arbeiten.", "sagt: ");
  AddInfo( ({ "zwille" }),
    "Das ist meine Zwille, die kannst Du nicht haben. " ,
    "sagt: ");

  AddInfo( ({"rukus", "rukus karolus"}), break_string("Das bin ich", 45),"sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), break_string("Das ist mein bester Freund.", 45),"sagt: ");
  AddInfo( ({"freund"}), break_string("Meine bester Freund heisst Torben.", 45),"sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), break_string("Das ist meine Schwester. Maedchen sind einfach doof. ", 45),"sagt: ");
  AddInfo( ({"celissa", "celissa harzscharrer"}), break_string("Das ist die Schwester von Celissa. Maedchen sind einfach doof. ", 45),"sagt: ");
  AddInfo( ({"kinder", "dorfkinder" }),
    "Ausser Torben, Celissa, Lidda und mich gibt es keine Kinder im Dorf. ", "sagt: ");

  AddInfo( ({"kelle", "silberne kelle", "silberkelle"}), #'q_kelle, "sagt: " );
  AddInfo( ({"tablett"}), #'q_tablett, "sagt: " );
  AddInfo( ({"bierhumpen", "humpen"}), #'q_bierhumpen, "sagt: " );
  AddInfo( ({"zapfhahn"}), #'q_zapfhahn, "sagt: " );

  AddInfo( ({"dieb", "diebe"}), "Diebe gibts hier eigentlich nicht.", "sagt: ");
  AddInfo( ({ "streiche", "streich", "gemeinheit", "gemeinheiten", "dummheit", "dummheiten" }),
    "Ach, mir faellt immer was ein was man so machen kann." ,
    "sagt: ");
  AddInfo( ({ "karolus", "familie", "familien" }),
    "Meine Familie lebt hier im Dorf." ,
    "sagt: ");
  AddInfo( ({ "harzscharrer" }),
    "Die Familie Harzscharrer lebt auch hier im Dorf." ,
    "sagt: ");
  
  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "stoffhose.lpc" );
  CLONEME( ARMOUR + "kappe.lpc" );
  command("trage alles");
  CLONEME( OBJ + "zwille.lpc" );
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      call_out("reaction", 0, TP, 
        "sagt: Das werd ich meiner Mama sagen. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Das werd ich meiner Mama sagen.  \n"); 
      break; 
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


