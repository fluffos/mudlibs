#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_dorfbewohner.lpc";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(15); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"gumblad", "korber", "wirt", "Gumblad Korber" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Gumblad Korber, der Wirt vom Gasthaus zum goldenen Schwan");
  SetProp( P_LONG, BS("Dies ist Gumblad Korber, der Wirt vom Gasthaus zum Goldenen Schwan. "+
    "Er hat in jungen Jahren die Welt bereist und allerlei leckere Rezepte mitgebracht. "+
    "Daher sind die Gerichte die er kocht ein wahrer Gaumenschmaus. Er ist lang gewachsen und "+
    "muss daher in den Tuerrahmen aufpassen, dass er sich nicht den Kopf stoesst."));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Gumblad Korber");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF + "zwirbelstein_gasthaus_c7.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF + "zwirbelstein_gasthaus_c7.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Wirt vom goldenen Schwan"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetChats( 1, ({"Gumblad Korber sagt: Probiert mal meine Weine! \n", 
  	             "Gumblad Korber meint: Es gibt in Friedheim kein besseres Wirtshaus! \n",
  	             "Gumblad Korber sagt: Meine Kueche kann sich sehen lassen. \n",
  	             "Gumblad Korber sagt: Heute hab ich mit mit dem Essen richtig Muehe gegeben. \n"}) ); //rate in %
  SetAttackChats( 5, ({"Gumblad Korber ruft: Dir werd ichs schon zeigen! \n",
  	                   "Gumblad Korber schreit: Mit Dir werd ich Dir Theke putzen! \n",
  	                   "Gumblad Korber sagt: Du entkommst mir nicht. \n",
  	                   "Gumblad Korber sagt: Stoerenfriede haben hier nichts zu suchen. \n"}) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({ "reise", "reisen", "fremde" }),
    "Ja, ich war lange Zeit auf Reisen, aber jetzt bin ich hier sesshaft und es zieht mich nicht mehr hinaus in die Fremde. " ,
    "sagt: ");
  AddInfo( ({ "rezept", "rezepte" }),
    "Tut  mir leid, aber die verrate ich Euch nicht." ,
    "sagt: ");

  AddInfo( ({ "angebot", "waren", "angebote", "menue", "essen", "trinken", "nahrung", "mahlzeit", "lokal", "kneipe" }),
    "Ja, hier koennt Ihr fuer Euer leibliches Wohl sorgen. Schaut mit 'menue' auf meine Angebote "+
    "und bestellt bei mir, was Ihr haben moechtet." ,
    "sagt: ");

/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  //Ausruestung
  SUID; 
  CLONEME( ARMOUR + "bierschuerze.lpc" );
  CLONEME( ARMOUR + "lederstiefel_1.lpc" );
  CLONEME( ARMOUR + "leinenhemd.lpc" );
  command("trage alles");
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            environment(this_object())->set_ban(getuid(this_player()), 3);
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


