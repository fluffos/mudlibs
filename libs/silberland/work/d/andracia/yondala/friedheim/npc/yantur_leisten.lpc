#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

inherit "std/repair";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void init()
{
   ::init();
   if (this_player() && this_player()->id("burgbewohner")) AddDefender(this_player());
}


void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(17); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"yantur", "leisten", "Yantur Leisten", "schmied", "burgbewohner" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Yantur Leisten, der Schmied");
  SetProp( P_LONG, BS("Dies ist Yantur Leisten, der Schmied. Er versorgt die Burgwache mit guten Schwertern und "+
    "hat auch soviel Erfahrung im Waffenbau dass sein Armbrueste ueberall im Land begehrt sind. Sein glaenzender "+
    "Oberkoerper ist sehr muskuloes und sein langes Haar ist zu einem Zopf geflochten. Er hat braune Augen "+
    "und seine krumme, breite Nase zeugt davon dass sie wohl schon einmal gebrochen war. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Yantur Leisten");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_KILL_NAME, "Schmied"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetAttackChats( 5, ({"Yantur Leisten bruellt: Ich schlag Dir den Kopf zu Brei, Du Unhold! \n",
  	                   "Yantur Leisten sagt: Ihr werdet meine Schmiede nicht mehr lebend verlassen! \n",
  	                   "Yantur Leisten sagt: Gleich ist es aus mit Euch! \n",
  	                   "Yantur Leisten wirft mit einem Stueck gluehende Kohle. \n" }) ); // rate in%

  // Infos
  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({ "vergleichen", "vergleiche", "vergleich" }),
    "Ja, ich kann fuer Euch Ruestungen und Waffen miteinander vergleichen. Dieser Dienst kostet Euch 200 Muenzen.",
    "sagt: ");
  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Liebste von Yason.", "sagt: ");
  AddInfo( "nyx", "Nyx hilft Yondala und Yason.", "sagt: ");
  AddInfo( "aginor", "Aginor ist der boese Teil des Hochadels.", "sagt: ");
  
  AddInfo( ({"dorlen", "dorlen friedheim", "burgherrin"}), break_string("Dorlen ist die Frau unseres "+
  "Freiherrn. Du findest Sie warscheinlich im 2ten Stock. ", 45),"sagt: ");
  AddInfo( ({"edorian", "edorian friedheim", "freiherr", "freiherrn", "burgherr"}), break_string("Edorian Friedheim ist unser geliebter "+
  "Freiherr. Du findest Ihn warscheinlich im 2ten Stock. ", 45),"sagt: ");
  AddInfo( ({"lara", "lara friedheim", "burgfrauelein"}), break_string("Das ist die huebsche Tochter des "+
  "Freiherrn. Du findest Sie warscheinlich im 2ten Stock. ", 45),"sagt: ");
  AddInfo( ({"jette", "jette linneweber", "zofe", "zofen"}), break_string("Das ist bestimmt eine der Zofen. "+
  "Warscheinlich kannst Du sie im 3ten Stock finden. ", 45),"sagt: ");
  AddInfo( ({"eberhelm", "eberhelm schroeter"}), break_string("Das ist der Taktische Berater unseres "+
  "Freiherrn. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"erna", "erna kollwanst"}), break_string("Das ist die Koechin auf der Burg. "+
  "Eine sehr nette Frau. Die ist bestimmt in der Kueche zu finden. ", 45),"sagt: ");
  AddInfo( ({"sindar", "sindar tucher", "bibliothekar"}), break_string("Das ist der Bibliothekar unseres "+
  "Freiherrn. Der ist mit grosser Sicherheit in der Bibliothek im 3ten Stock. ", 45),"sagt: ");
  AddInfo( ({"vitus", "vitus gesse"}), break_string("Das ist der Knappe von Brin Roggenfeldt, "+
  "dem Hauptmann. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"brin", "brin roggenfeldt"}), break_string("Das ist der Hauptmann der Burgwache auf der Burg unseres "+
  "Freiherrn. Der ist hier irgendwo. ", 45),"sagt: ");
  AddInfo( ({"yantur", "yantur leisten"}), break_string("Das ist der Burgschmied. Du kannst bei Ihm Deine "+
  "Ausruestung reparieren. In einer Ecke des Burghofs ist seine Schmiede. ", 45),"sagt: ");
  
  AddInfo( ({"bernhelm", "bernhelm kramer"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"irian", "irian ilgur"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"jobdan", "jobdan gerber"}), break_string("Dieser Bauer wohnt hier in der Gegend. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"celissa", "celissa harzscharrer"}), break_string("Dieses Maechen wohnt hier im Dorf. "+
  "Die ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), break_string("Dieses Maechen wohnt hier im Dorf. "+
  "Die ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");
  AddInfo( ({"rukus", "rukus karolus"}), break_string("Dieser Junge wohnt hier im Dorf. "+
  "Der ist bestimmt irgendwo im Dorf. ", 45),"sagt: ");

  AddInfo( ({"eslam", "eslam kremso"}), break_string("Das ist einer der ansaessigen Haendler. "+
  "Du findest seinen Laden im Westen des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"rauert", "rauert arres"}), break_string("Das ist einer der ansaessigen Haendler. "+
  "Du findest seinen Laden im Osten des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"gumblad", "gumblad korber"}), break_string("Das ist einer der ansaessigen Wirte. "+
  "Du findest sein Lokal im Sueden des Dorfs. ", 45),"sagt: ");
  AddInfo( ({"radulf", "radulf buchweiz"}), break_string("Das ist einer der ansaessigen Wirte. "+
  "Du findest sein Lokal im Norden des Dorfs. ", 45),"sagt: ");

  AddInfo( ({"koenig"}), break_string("Wir haben keinen Koenig. Der Titel des Burgherrn ist "+
  "Freiherr, Freiherr Edorian von Friedheim.", 45),"sagt: ");
  AddInfo( ({"hilfe", "arbeit", "auftrag"}), break_string("Ich kann Dir nur empfehlen zu Sindar Tucher, dem "+
  "Bibliothekar zu gehen. Der weiss immer Rat. Du findest ihn im 3ten Stock des Burgfrieds.", 45),"sagt: ");
  AddInfo( ({"quest", "aufgabe", "aufgaben", "arbeit"}), break_string("Tut mir leid. Ich habe keine Arbeit fuer Dich. "+
  "Der Freiherr sucht aber immer Leute fuer alle moeglichen Aufgaben. ", 45),"sagt: ");
  AddInfo( ({"burg", "friedheim"}), break_string("Die Burg Friedheim ist der "+
  "Sitz des Freiherrn von Friedheim. ", 45),"sagt: ");
  AddInfo( ({"welt", "andracia"}), break_string("Diese Welt wird Andracia genannt. "+
  "Geh zu Sindar Tucher, dem Bibliothekar, der kann Dir viel ueber unsere Welt erzaehlen. ", 45),"sagt: ");
  AddInfo( ({"essen", "trinken"}), break_string("Fuer die Verpflegeung kannst Du im Dorf die "+
  "Gasthauser aufsuchen: im Norden des Dorfs den goldenen Schwan im Sueden den rostigen Nagel. "+
  "Die Burgkoechin wird Dir auch was gegen den Hunger zubereiten wenn Du nett fragst. ", 45),"sagt: ");
  AddInfo( ({"liebe"}), break_string("Die Liebe ist ein Geschenk. Halt Sie fest wenn Du sie "+
  "findest. ", 45),"sagt: ");

  AddInfo( ({"kuchen"}), break_string("Jeder mag Kuchen. ", 45),"sagt: ");
  AddInfo( ({"ungeziefer", "assel", "kaefer", "spinne", "maus", "ratte", "ratte", "asseln", "spinnen", "maeuse", "ratten"}), break_string(
    "Das Ungeziefer ist im Keller zu finden. Aus irgendeiner Spalte "+
    "kriechen diese Tiere herein und knabbern an unseren Vorraeten.", 45),"sagt: ");
  AddInfo( ({"keller"}), break_string("Im Keller ist sehr viel Ungeziefer. Der Freiherr bezahlt angehende "+
    "Kammerjaeger gut. Der Zugang befindet sich in der Kueche.", 45),"sagt: ");
  AddInfo( ({"kammerjaeger", "kammerjaegern"}), break_string("Frag den Freiherrn, er sucht schon lange nach Kammerjaegern. ", 45),"sagt: ");

  AddInfo( ({"fackel", "licht"}), break_string("Eine Fackel kann man sicher im Laden kaufen. ", 45),"sagt: ");

  AddInfo( ({"kerbholz"}), break_string("Dazu kann Dir der Burgherr mehr sagen. ", 45),"sagt: ");

  AddInfo( ({"tiere"}), break_string("Das Ungeziefer ist im Keller. ", 45),"sagt: ");

  AddInfo( ({"spalte"}), break_string("Ja, durch irgendeine Spalte im Keller dringt das Ungeziefer herein und vergeht sich an den Vorraeten. . ", 45),"sagt: ");

  AddInfo( ({"weinprobe"}), break_string("Der Burgherr ist mit dem Wein knauserig. Eine Weinprobe wird es nie geben hier auf Friedheim. ", 45),"sagt: ");
  AddInfo( ({"hafen", "hafendorf"}), 
  	"Das Hafendorf befindet sich ein gutes Stueck westwaerts. ", "sagt: ");
  AddInfo( ({ "kellereingang" }),
    "In der Burgkueche fuehrt eine Treppe hinab in den Keller." ,
    "sagt: ");
  AddInfo( ({ "huhn", "huehner", "huehnern" }),
    "Wir halten hier auf der Burg keine Huehner." ,
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Kobolde sind eigentlich ein friedliches Volk, wenn ihre Vorliebe fuer fremder Leute Eigentum nicht waere. " ,
    "sagt: ");
  AddInfo( ({"diebe"}), break_string("Diebe lauern leider auf den Strassen meines Reichs. Leider koennen "+
    "meine Wachleute nicht ueberall rechtzeitig zur Stelle sein. Seht Euch einfach vor. ", 45),"sagt: ");
  AddInfo( ({ "weg" }),
    "Ihr koennt die Burg nur durch das Torhaus im Sueden verlassen, wohin ihr Euch aber dann wenden wollt "+
    "kann ich Euch auch nicht sagen." ,
    "sagt: ");
  AddInfo( ({ "adler" }),
    "Der Adler landet desoefteren bei uns auf dem Dach. Er kann sogar jemand auf seinem Ruecken mitnehmen. " ,
    "sagt: ");
  AddInfo( ({ "aboriville" }),
    "Aboriville ist die Stadt der Elfen. Sie ist hinter den Bergen und ich bin dort bisher noch nie gewesen." ,
    "sagt: ");
  AddInfo( ({ "waffe", "waffen" }),
    "In den Laeden im Dorf findet Ihr vielleicht eine Bracuhbare Waffe." ,
    "sagt: ");
  AddInfo( ({ "armbrust" }),
    "Eine Armbrust ist eine hervoragende Waffe um bei Belagerungen." ,
    "sagt: ");
  AddInfo( ({ "herberge" }),
    "An der Strasse zum Hafen gbt es eine Herberge. Meint ihr vielleicht diese?" ,
    "sagt: ");


/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

// Questinfos
  AddInfo( ({"kirschen", "kirsche", "apfel", "aepfel", "pfirsich", "pfirsiche", "birne", "birnen", "pflaume", "pflaumen"
  	         "aprikose", "aprikosen", "obst" }), 
  	"Mhm - zwischen Dorf und Burg ist eine kleine Obstwiese. Vielleicht findet ihr dort was ihr sucht.", "sagt: ");
  AddInfo( ({"mehl", "zucker", "eier", "milch", "vorraete", "vorrat"}), "Fragt die Burgkoechin, die weiss wo die Vorraete sind. ", "sagt: ");
  AddInfo( ({"kerker", "kerkerzellen", "zellen", "kerkerzelle", "zelle"}), 
    "Die Kerker werden schon lange nicht mehr benutzt. In einem der Kerker "+
    "muss aber eine Spalte im Boden sein, aus der Ungeziefer unsere Vorraete anfaellt.", "sagt: ");
  AddInfo( ({"kampf"}), "Sei besser friedlich.", "sagt: ");
  

  //Ausruestung
  SUID;
  CLONEME( ARMOUR + "leinenhose.lpc" );
  CLONEME( ARMOUR + "lederstiefel_2.lpc" );
  CLONEME( ARMOUR + "lederschuerze.lpc" );
  command("trage alles");
  CLONEME( WEAPON + "schmiedehammer.lpc" );
  command("zuecke hammer");
  
  // befehle
  AddCmd( ({ "vergleiche","vergleich" }), "vergleichen" );

}

int vergleichen(string str)
{
  object victim1, victim2;
  
  string *damtyp1, *damtyp2, vtype, vtype2, wtype, result, vname, wname, text1, text2; 
  string *damres1, *damres2;
  //*wdamtyp, vtype, wtype, result, vname, wname, text1;
  //string *vdamtyp2, *wdamtyp2, vtype2, wtype2, result2, vname2, wname2, text2;
  mapping rues1, rues2;
  
  int zahl1,zahl2,zahl3;//vwc, wwc, vhands, whands, vwcfix, wwcfix, vqdecay, wqdecay, wcdif, suc; 

  notify_fail(TO->name()+"sagt: Was moechtet Ihr mit was vergleichen?\n");
  if(!str) return 0;

  if (TP->InFight())
  {
  	write("Du kannst waehrend dem Kampf nichts vergleichen!\n");
    return 1;
  }
  if (TO->InFight())
  {
  	write(TO->name()+" kann gerade nicht.\n");
  	return 1;
  }  
  if( sscanf(str, "%s mit %s", text1,text2 ) != 2) //wenn kein string mitgegeben
    return 0;
  if(present(text1, TP)) victim1=present(text1, TP);
  else 
  {
  	write(TO->name()+"dagt: Du hast kein "+capitalize(text1)+"!\n");
    return 1;
  }
  if(present(text2, TP)) victim2=present(text2, TP);
  else    
  {
    write("Du hast kein "+capitalize(text2)+"!\n");
    return 1;
  }
  if (victim1==victim2)
  {
    write("Du kannst einen Gegenstand nicht mit sich selbst vergleichen.\n");
    return 1;
  }   
  
  //Wenn beides Waffen sind.
  if( text1=victim1->QueryProp(P_WEAPON_TYPE)&& text2=victim2->QueryProp(P_WEAPON_TYPE) )
  {
	  say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{
			command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		  return 1;
		}
		this_player()->AddMoney(-200);
		write("Du zahlst 200 Muenzen.\n");
		say( TPN+" zahlt 200 Muenzen\n",TP);
  	write( BS(TO->name()+" vergleicht "+victim1->name(WEN)+" mit "+ victim2->name(WEM)+".\n") );
  
    switch( text1 )
    {
      case WT_SWORD    : text1="ein Schwert"; break;
      case WT_AXE      : text1="eine Axt"; break;
      case WT_CLUB     : text1="ein Knueppel"; break;
      case WT_SPEAR    : text1="ein Speer"; break;
      case WT_KNIFE    : text1="ein Messer"; break;
      case WT_WHIP     : text1="eine Peitsche"; break;
      case WT_CHAIN    : text1="ein Morgenstern"; break;
    }
    switch( text2 )
    {
      case WT_SWORD    : text2="ein Schwert"; break;
      case WT_AXE      : text2="eine Axt"; break;
      case WT_CLUB     : text2="ein Knueppel"; break;
      case WT_SPEAR    : text2="ein Speer"; break;
      case WT_KNIFE    : text2="ein Messer"; break;
      case WT_WHIP     : text2="eine Peitsche"; break;
      case WT_CHAIN    : text2="ein Morgenstern"; break;
    }

    // Waffentyp
    if( text1==text2)
      write("Beide Waffen sind "+text1+".\n");
    else 
      write(capitalize(victim1->name(WER,1))+" ist "+text1+", "+victim2->name(WER,1)+" hingegen ist "+text2+".\n");
    zahl1=victim1->QueryProp(P_NR_HANDS);
    zahl2=victim2->QueryProp(P_NR_HANDS);
  
    // Zweihaendig
    if( zahl1==zahl2)
    {
      if( zahl1==2 )
        write("Beide Waffen muessen mit zwei Haenden gefuehrt werden.\n");
      else
        write("Beide Waffen benoetigen nur eine Hand zum Fuehren.\n");
    } 
    else 
    {
      if( zahl1==2 )
        write(capitalize(victim1->name(WER,1))+" benoetigt beide Haende zum Fuehren, "+capitalize(victim2->name())+" nur eine.\n");
      else
        write(capitalize(victim2->name(WER,1))+" benoetigt nur eine Hand zum Fuehren, "+capitalize(victim1->name())+" beide.\n");
    }

    zahl1=victim1->QueryProp(P_WC) - victim2->QueryProp(P_WC);
  
    // Schaden zahl1= WC von Waffe 1 - WC von Waffe 2
    if( zahl1 < -150 )
      write(capitalize(victim1->name(WER,1))+" macht sehr viel weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -150 ) 
      write(capitalize(victim1->name(WER,1))+" macht viel weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -75 )  
      write(capitalize(victim1->name(WER,1))+" macht weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 > -30 )  
      write(capitalize(victim1->name(WER,1))+" macht etwas weniger Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  0 )
      write(capitalize(victim1->name(WER,1))+" macht etwas mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  30 )
      write(capitalize(victim1->name(WER,1))+" macht mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  75 )
      write(capitalize(victim1->name(WER,1))+" macht viel mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 >  150 )
      write(capitalize(victim1->name(WER,1))+" macht sehr viel mehr Schaden als "+victim2->name(WER,1)+".\n");
    else if( zahl1 == 0 )
      write(capitalize(victim1->name())+" macht genausoviel Schaden wie "+victim2->name(WER,1)+".\n");
    
    zahl1=victim1->QueryProp(P_QUALITY_DECAY);
    zahl2=victim2->QueryProp(P_QUALITY_DECAY);  
  
    // Abnutzung
    if( zahl1>zahl2)
      write(capitalize(victim1->name(WER,1))+" nuetzt sich langsamer ab als "+victim2->name(WER,1)+".\n");
    else if( zahl1<zahl2)
      write(capitalize(victim1->name(WER,1))+" nuetzt sich schneller ab als "+victim2->name(WER,1)+".\n");
    else
      write( "Beide Waffen nuetzen sich gleich schnell ab. \n");
    
    // Schadensart
    damtyp1=victim1->QueryProp(P_DAM_TYPE);
    damtyp2=victim2->QueryProp(P_DAM_TYPE);

    // filter nach nicht-physischen schaden
    damtyp1 -= m_indices(PHYSICAL_DAMAGE_TYPES);
    damtyp2 -= m_indices(PHYSICAL_DAMAGE_TYPES);
    if( !sizeof(damtyp1) && !sizeof(damtyp2) ) //Wenn beide nur koerperlichen Schaden machen
    {
      write("Beide Waffen verursachen nur physischen Schaden.\n");
    }   
    else 
    {
      if( sizeof(damtyp1) > 1 && sizeof(damtyp2) > 1 )
        write("Beide Waffen verursachen aussergewoehnlichen Schaden.\n");
      else 
      {  
        write(capitalize(victim1->name(WER,1)));
        if( sizeof(damtyp1) > 1 )
          write (" verursacht aussergewoehnlichen Schaden\n");
        if( sizeof(damtyp1) == 1 )//wenn er genau einen unkoerperlichen Schaden macht
        {
          switch(damtyp1[0])
          {
            case DT_FIRE:     write (" Feuerschaden"); break;
            case DT_COLD:     write (" Kaelteschaden"); break;
            case DT_ELECTRIC: write (" schockartigen Schaden"); break;
            case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
            case DT_TERROR:   write (" Angst"); break;
            case DT_HOLY:     write (" heiligen Schaden"); break;
            case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
            default:          write (" besonderen Schaden"); break;
          }
        } 
        else 
          write (" nur physischen Schaden, wohingegen "+victim2->name(WER,1));
        if( sizeof(damtyp2) > 1 )
          write(" aussergewoehnlichen Schaden");
        if( sizeof(damtyp2) == 1 )
        {
          switch(damtyp2[0])
          {
            case DT_FIRE:     write (" Feuerschaden"); break;
            case DT_COLD:     write (" Kaelteschaden"); break;
            case DT_ELECTRIC: write (" schockartigen Schaden"); break;
            case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
            case DT_TERROR:   write (" Angst"); break;
            case DT_HOLY:     write (" heiligen Schaden"); break;
            case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
            default:          write (" besonderen Schaden"); break;
          }
        } 
        else 
          write (" nur physischen Schaden verursacht.\n");
      }
    }
    
    zahl1=victim1->QueryProp(P_WC_FIX);
    zahl2=victim2->QueryProp(P_WC_FIX);

    // Abnutzung
    if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" liegt besser in der Hand als "+victim2->name(WER,1)+".\n");
    else if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" liegt nicht so gut in der Hand als "+wname+".\n");
    else
      write ("Beide Waffen liegen gleich gut in der Hand. \n");

    //Gewicht
    zahl1=victim1->QueryProp(P_WEIGHT);
    zahl2=victim2->QueryProp(P_WEIGHT);
  
    if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist schwerer als "+victim2->name(WER,1)+".\n");
    else if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist leichter als "+wname+".\n");
    else
      write ("Beide Waffen wiegen ungefaehr gleich viel. \n");
    return 1;
  }
  //Wenn beides Ruestungen sind:
  else if( text1=victim1->QueryProp(P_ARMOUR_TYPE)&& text2=victim2->QueryProp(P_ARMOUR_TYPE) )
  {
   	say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{
			command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		  return 1;
		}
		this_player()->AddMoney(-200);
		write("Du zahlst 200 Muenzen.\n");
		say(TPN+" zahlt 200 Muenzen\n",TP);
  	write( BS(TO->name()+" vergleicht "+victim1->name(WEN)+" mit "+ victim2->name(WEM)+".\n") );
    switch( victim1->QueryProp(P_ARMOUR_TYPE) )
    {
      case AT_ARMOUR:  text1="Panzer"; break;
      case AT_HELMET:  text1="Helm"; break;
      case AT_AMULET:  text1="Amulett"; break;
      case AT_RING:    text1="Ring"; break;
      case AT_GLOVE:   text1="Handschuh"; break;
      case AT_CLOAK:   text1="Umhang"; break;
      case AT_BOOT:    text1="Stiefel"; break;
      case AT_SHIELD:  text1="Schild"; break;
      case AT_TROUSERS: text1="Hosen"; break;
      case AT_BELT:    text1="Guertel"; break;
      case AT_BRACERS: text1="Armschienen"; break;
      case AT_MISC:    text1="Besonderes"; break;
    }
    switch( victim2->QueryProp(P_ARMOUR_TYPE) )
    {
      case AT_ARMOUR:  text2="Panzer"; break;
      case AT_HELMET:  text2="Helm"; break;
      case AT_AMULET:  text2="Amulett"; break;
      case AT_RING:    text2="Ring"; break;
      case AT_GLOVE:   text2="Handschuh"; break;
      case AT_CLOAK:   text2="Umhang"; break;
      case AT_BOOT:    text2="Stiefel"; break;
      case AT_SHIELD:  text2="Schild"; break;
      case AT_TROUSERS: text2="Hosen"; break;
      case AT_BELT:    text2="Guertel"; break;
      case AT_BRACERS: text2="Armschienen"; break;
      case AT_MISC:    text2="Besonderes"; break;
    }
    // Ruestungstyp
    if( text1==text2)
      write("Beide Ruestungen sind vom Typ "+text1+".\n");
    else 
      write(capitalize(victim1->name(WER,1))+" ist vom Typ "+text1+", "+victim2->name(WER,1)+" gehoert zum Typ "+text2+".\n");
    
    //Gewicht
    zahl1=victim1->QueryProp(P_WEIGHT);
    zahl2=victim2->QueryProp(P_WEIGHT);
  
    if( zahl1<zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist schwerer als "+victim2->name(WER,1)+".\n");
    else if( zahl1>zahl2 )
      write(capitalize(victim1->name(WER,1))+" ist leichter als "+victim2->name(WER,1)+".\n");
    else
      write ("Beide Ruestungen wiegen ungefaehr gleich viel. \n");

    text1=victim1->QueryProp(P_INFO);
    text2=victim2->QueryProp(P_INFO);

    if(text1&&text2) write("Beide Ruestungen scheinen ein Geheimnis zu haben.\n");
    else if(text1) write(capitalize(victim1->name(WER,1))+" scheint ein Geheimnis zu haben.\n");
    else if(text2) write(capitalize(victim2->name(WER,1))+" scheint ein Geheimnis zu haben.\n");

    zahl1=victim1->QueryProp(P_AC);
    zahl2=victim2->QueryProp(P_AC);
    zahl3=zahl1-zahl2;  
    if(zahl3>40)write(capitalize(victim1->name(WER,1))+" schuetzt unendlich viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>35)write(capitalize(victim1->name(WER,1))+" schuetzt unglaublich viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>30)write(capitalize(victim1->name(WER,1))+" schuetzt sehr viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>25)write(capitalize(victim1->name(WER,1))+" schuetzt viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>20)write(capitalize(victim1->name(WER,1))+" schuetzt um einiges besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>15)write(capitalize(victim1->name(WER,1))+" schuetzt besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>10)write(capitalize(victim1->name(WER,1))+" schuetzt etwas besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>5)write(capitalize(victim1->name(WER,1))+" schuetzt ein wenig besser als "+victim2->name(WER,1)+".\n");

    else if(zahl3<-40)write(capitalize(victim2->name(WER,1))+" schuetzt unendlich viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-35)write(capitalize(victim2->name(WER,1))+" schuetzt unglaublich viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-30)write(capitalize(victim2->name(WER,1))+" schuetzt sehr viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-25)write(capitalize(victim2->name(WER,1))+" schuetzt viel besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-20)write(capitalize(victim2->name(WER,1))+" schuetzt um einiges besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-15)write(capitalize(victim2->name(WER,1))+" schuetzt besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-10)write(capitalize(victim2->name(WER,1))+" schuetzt etwas besser als "+victim1->name(WER,1)+".\n");
    else if(zahl3<-5)write(capitalize(victim2->name(WER,1))+" schuetzt ein wenig besser als "+victim1->name(WER,1)+".\n");
    else write("Beide Ruestungen schuetzen etwa gleich gut.\n");

    text1=victim1->QueryProp(P_WEAR_RESTRICTIONS);
    text2=victim2->QueryProp(P_WEAR_RESTRICTIONS);
    if(!text1&&!text2) write("Beide Ruestungen koennen von jedem getragen werden.\n");
    else if(text1) write(capitalize(victim1->name(WER,1))+" kann nicht von jedem getragen werden.\n");
    else write(capitalize(victim2->name(WER,1))+" kann nicht von jedem getragen werden.\n");
  }
  else
   	write( TO->name()+" sagt: Eine Ruestung mit einer Waffe zu vergleichen macht keinen Sinn. \n" );
  return 1;
}
// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void InformDefend(object enemy)
{
    Kill(enemy);
}
