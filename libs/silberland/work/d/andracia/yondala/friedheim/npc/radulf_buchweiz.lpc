string q_aufgabe()
{
	object ob;
  if(!present("\nabring",TP)&&!present("\nabquest",TP))
  {
  	ob=clone_object( OBJ+"abquest" );
  	ob->move(TP, M_GET);
  	return "Ja, ich koennte eure Hilfe gebrauchen. Eines der Dorfkinder hat mir "+ob->QueryDiebesgut()+
  	  " aus der Kueche geklaut. Bringt "+ob->QueryDiebesgutPronoun()+" mir einfach zurueck. ";
  }
  if( ob=present("\nabquest",TP) )
  	return "Bitte helft mir. Wie schon gesagt: eines der Dorfkinder hat mir "+ob->QueryDiebesgut()+
  	  " aus der Kueche geklaut. Bringt "+ob->QueryDiebesgutPronoun()+" mir einfach zurueck. ";

  return "Ich kann Euch nur empfehlen zu Sindar Tucher, dem Bibliothekar zu gehen. Der weiss immer Rat. "+
    "Ihr findet ihn im 3ten Stock des Burgfrieds.";
}

string q_kinder()
{
	object ob;
  if(!present("\nabring",TP)&&ob=present("\nabquest",TP))
  {
  	if(ob->QueryVillian()=="Rukus" || ob->QueryVillian()=="Torben")
  	{
  		return "Nur die Familien Harzscharrer und Karolus haben Kinder, die als Uebeltaeter in Betracht kommen. "+
  		  "Ich glaube es war ein Junge der mich bestohlen hat. ";
  	} else {
  		return "Nur die Familien Harzscharrer und Karolus haben Kinder, die als Uebeltaeter in Betracht kommen. "+
  		  "Ich glaube es war ein Maedchen das mich bestohlen hat. ";
  	}
  }
  return "Die Familien Harzscharrer und Karolus haben Kinder, die hier im Dorf ihr Unwesen treiben. "+
    "Beides mal sind es Zwillinge mit einem Jungen und einem Maedchen. Aber alle vier sind richtige Lausebengel, "+
    "immer wieder stellen sie etwas dummes an.";
}

void create() {
  if (!is_clone(TO)) return; //Abbruch fuer Blueprint
  ::create(); //Ausfuehren von Create in Inherit "std/mnpc"
  
  create_default_npc(16); //erstellt Standartwerte fuer NPC des Level x
  fieser_moep = ([]); 

  //Properties
  AddId(({"radulf", "buchweiz", "wirt", "Radulf Buchweiz" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Radulf Buchweiz, der Wirt vom Gasthaus zum rostigen Nagel");
  SetProp( P_LONG, BS("Dies ist Radulf Buchweiz, der Wirt vom Gasthaus zum rostigen Nagel. "+
    "Etwas schmuddelig gekleidet aber ansonsten ein gemuetlicher Bursche. Mit seinen "+
    "Sommersprossen und dem roten Haar sieht er aus wie ein zu gross geratener Kobold. " ));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Radulf Buchweiz");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, DORF + "zwirbelstein_gasthaus_c2.lpc" ); // Bereichsangabe fuer Bewegung
  SetProp( P_MNPC_DEFAULTROOM, DORF + "zwirbelstein_gasthaus_c2.lpc"); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS); // Bewegungsmoeglichkeiten
  SetProp( P_KILL_NAME, "Wirt vom rostigen Nagel"); //string fuer Todessequenz
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+" will Deine Sachen nicht tragen.\n" }) );
 
  //Chats
  SetChats( 1, ({"Radulf Buchweiz ruft: Hier gibts was zu trinken! \n",
  	             "Radulf Buchweiz ruft: Nicht draengeln! \n",
  	             "Radulf Buchweiz sagt: Probiert meine Angebote. \n",
  	             "Radulf Buchweiz meint: Lasst es Euch schmecken. \n"}) ); //rate in %
  SetAttackChats( 5, ({"Radulf Buchweiz schreit: Euch werd ich's zeigen! \n",
  	                   "Radulf Buchweiz ruft: Mit Dir werd ich Dir Theke putzen! \n",
  	                   "Radulf Buchweiz ruft: Du kannst Dir schon mal nen sarg besorgen. \n"}) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  AddInfo( ({"celissa", "celissa harzscharrer"}), 
    "Dieses kleine Maedchen ist genauso frech wie ihr Bruder Torben.", "sagt: ");
  AddInfo( ({"lidda", "lidda karolus"}), 
    "Dieses kleine Maedchen ist genauso frech wie ihr Bruder Rukus.", "sagt: ");
  AddInfo( ({"torben", "torben harzscharrer"}), 
    "Dieser Lausebengel hat es faustdick hinter den Ohren.", "sagt: ");
  AddInfo( ({"rukus", "rukus karolus"}), 
    "Dieser Lausebengel hat es faustdick hinter den Ohren.", "sagt: ");
  AddInfo( ({"hilfe", "aufgabe", "quest" }),
    #'q_aufgabe, "sagt: ");
  AddInfo( ({"kinder", "dorfkinder", "jungen", "maedchen", "junge", "uebeltaeter", "dorfkind" }),
    #'q_kinder, "sagt: ");
  AddInfo( ({"kelle", "silberne kelle", "silberkelle"}), #'q_kelle, "sagt: " );
  AddInfo( ({"tablett"}), #'q_tablett, "sagt: " );
  AddInfo( ({"bierhumpen", "humpen"}), #'q_bierhumpen, "sagt: " );
  AddInfo( ({"zapfhahn"}), #'q_zapfhahn, "sagt: " );
  AddInfo( ({ "diebesgut" }),
    #'q_diebesgut, "sagt: "); // '

  AddInfo( ({ "dieb", "diebe", "dieben" }),
    "Ja, es gibt hier im Dorf Diebe die mich bestohlen haben. Wollt ihr mir nicht helfen und das "+
    "Diebesgut wiederbeschaffen?" ,
    "sagt: ");
  AddInfo( ({ "angebot", "waren", "angebote", "menue", "essen", "trinken", "nahrung", "mahlzeit", "lokal", "kneipe" }),
    "Ja, hier koennt ihr fuer euer leibliches Wohl sorgen. Schaut mit 'menue' auf meine Angebote "+
    "und bestellt bei mir was Ihr haben moechtet." ,
    "sagt: ");
  AddInfo( ({ "kueche" }),
    "Meine Kueche ist ganz sauber." ,
    "sagt: ");

/*
  AddInfo( ({ "" }),
    "" ,
    "sagt: ");
*/

  //Ausruestung
  SUID; 
  CLONEME( ARMOUR + "bierschuerze.lpc" );
  CLONEME( ARMOUR + "lederstiefel_2.lpc" );
  CLONEME( ARMOUR + "leinenhemd.lpc" );
  command("trage alles");
}

give_notify(object diebesgut)
{
	object ob;
	if( !present("\nabring",TP) && !ob=present("\nabquest",TP)) 
	{
		write(QueryProp(P_NAME)+" will Deine Sachen nicht tragen und gibt Dir "+diebesgut->name(WEN,1)+" zurueck.\n");
		diebesgut->move(TP, M_GET);
		return;
	}
	if( !diebesgut->id("\ndiebesgut") ) 
	{
		write(QueryProp(P_NAME)+" will Deine Sachen nicht tragen und gibt Dir "+diebesgut->name(WEN,1)+" zurueck.\n");
		diebesgut->move(TP, M_GET);
		return;
	}
	write( break_string("Danke dass Ihr mir "+diebesgut->name(WEN)+" zurueck gebracht habt. ", 78, TO->Name()+" sagt: " ) );
	ob->remove();
	diebesgut->remove();
	if( TP->id("Menschenspieler") )
	{
		write( break_string("Bitte nehmt diesen Ring als Belohnung fuer eure Muehe. ", 78, TO->Name()+" sagt: " ) );
		CLONE("/gilden/abenteurer/obj/ring.lpc", TP);
	} else {
		write( break_string("Bitte nehmt diese Muenzen als Belohnung fuer eure Muehe. ", 78, TO->Name()+" sagt: " ) );
		ob=clone_object("/obj/money.lpc");
		ob->AddAmount(200+random(300));
		write( TO->Name()+" gibt Dir "+ob->QueryProp(P_AMOUNT)+" Muenzen.\n" );
		if( !ob->move(TP, M_GIVE) ) ob->move(ENV(TP), M_PUT);
	}
  if( TP->GiveQuest("Diebe im Dorf zu Friedheim") == 1)
  {
    write_file("/log/quests/yason_quest.log", 
    sprintf ("%s  %s hat die Quest 'Diebe im Dorf zu Friedheim' bestanden.\n",
    dtime(time()), CAP(TP->query_real_name())));
  }
	return;
}
// Reactions (werden von aussen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Ihr braucht keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Ihr braucht gar nicht zu schimpfen, Ihr seid selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lasst doch bitte den Bloedsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lasst doch bitte den Bloedsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn Du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn Du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            environment(this_object())->set_ban(getuid(this_player()), 3);
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte sucht Euch jemand anderen fuer sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte sucht Euch jemand anderen fuer sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet Dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


