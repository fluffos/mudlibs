#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "zs_dorfbewohner.lpc";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

string q_diebesgut()
{
  object ob;
  
  if( !present("\nabring",TP) && ob=present("\nabquest",TP) )
  {
    return "Ja, mir wurde "+ob->QueryDiebesgut()+" geklaut. Bitte versucht es mir zurueck zubringen.";
  }
  return "Vielleicht kann Euch einer der Haendler sowas verkaufen.";
}

string q_kelle()
{
  object ob;
  if( !present("\nabring",TP) && ob=present("\nabquest",TP) )
  if( ob->QueryDiebesgut()=="eine silberne Kelle" )
  {
    return "Ja, mir wurde "+ob->QueryDiebesgut()+" geklaut. Bitte versucht es mir zurueck zubringen.";
  }
  return "Vielleicht kann Euch einer der Haendler sowas verkaufen.";
}

