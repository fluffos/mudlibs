#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /* In jedem Treppenabschnitt anders! Umgebung? 
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Spezial \n" );
  AddDetail( ({ "tuer" }), //falls eine Tuer vorhanden
    BS(""));
  */
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Sueden. "));
  AddDetail( ({ "umgebung", "land", "gelaende" }),
    BS("Direkt im Sueden ist eine Kreuzung zu sehen. Im Suedwesten erstreckt sich "+
    "ein weites Grasland. Im Nordwesten sind erste Bergauslaeufer zu sehen."));
  AddDetail( ({ "kreuzung" }),
    BS("Du kannst von hier aus nicht mehr erkennen als eine normale Kreuzung."));
  AddDetail( ({ "grasland" }),
    BS("Weites Grasland erstreckt sich im suedwesten."));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleinere Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erkennen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man einige Spitzen des Bergmassivs sehen."));


  AddExit( "nordostoben" , ROOM + "marmorturm_helix3_d3.lpc");
  AddExit( "westunten" , ROOM + "marmorturm_helix2_b4.lpc");

  AddExit( "nordosten" , ROOM + "marmorturm_helix3_d3.lpc");
  AddExit( "westen" , ROOM + "marmorturm_helix2_b4.lpc");
  SetProp( P_HIDE_EXITS, ({"nordosten", "westen"}) );
}
