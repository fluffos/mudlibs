// Metallwarenhandel
inherit "std/store.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

reset() {
  ::reset();
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1); 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:14]));
  SetProp( P_INT_SHORT, "Dies ist das Lager von Kirgam Frathag's Laden" ); 
  SetProp( P_INT_LONG,  "Dies ist das Lager von Kirgam Frathag's Laden. \n"
  "Hier verstaut er all sein eingekauftes Zeug." );
 
  // AddItem( "file", refresh, Props);
  AddItem( "/obj/fackel.lpc", REFRESH_REMOVE );
  // ein paar waffen, hufeisen und naegel
}

