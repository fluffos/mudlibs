#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Eine Treppe im Sueden fuehrt hinab auf die Ebene. \n" );

  AddDetail( ({ "treppe", "ebene", "ende" }),
    BS("Die Treppe fuehrt nach Sueden hinab. Du kannst eine Kreuzung nahe dem unteren "+
    "Ende der Treppe sehen. "));
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Sueden. "));
  AddDetail( ({ "umgebung", "land", "gelaende" }),
    BS("Direkt im Sueden ist eine Kreuzung zu sehen. Im Suedwesten erstreckt sich "+
    "ein weites Grasland. Im Nordwesten sind erste Bergauslaeufer zu sehen."));
  AddDetail( ({ "kreuzung" }),
    BS("Du kannst von hier aus nicht mehr erkennen als eine normale Kreuzung."));
  AddDetail( ({ "grasland" }),
    BS("Weites Grasland erstreckt sich im suedwesten."));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleine Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erahnen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man nur sehr wenige Spitzen des Bergmassivs sehen."));

/* 
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( "nordostoben" , ROOM + "marmorturm_helix1_d3.lpc");
  AddExit( "suedunten" , ROOM + "marmorturm_helix1_c5.lpc");

  AddExit( "nordosten" , ROOM + "marmorturm_helix1_d3.lpc");
  AddExit( "sueden" , ROOM + "marmorturm_helix1_c5.lpc");
  SetProp( P_HIDE_EXITS, ({"sueden", "nordosten"}) );
}
