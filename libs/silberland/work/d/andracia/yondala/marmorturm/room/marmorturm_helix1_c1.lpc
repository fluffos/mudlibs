#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Norden. "));
  AddDetail( ({ "umgebung", "land", "gelaende", "wald" }),
    BS("Von Nordwesten bis Nordosten erstreckt sich ein riesiger, dichter Wald. "));

  /* In jedem Treppenabschnitt anders! Umgebung? 
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Spezial \n" );
  AddDetail( ({ "tuer" }), //falls eine Tuer vorhanden
    BS(""));
  */

  AddExit( "westoben" , ROOM + "marmorturm_helix1_b1.lpc");
  AddExit( "suedostunten" , ROOM + "marmorturm_helix1_d2.lpc");

  AddExit( "westen" , ROOM + "marmorturm_helix1_b1.lpc");
  AddExit( "suedosten" , ROOM + "marmorturm_helix1_d2.lpc");
  SetProp( P_HIDE_EXITS, ({"westen", "suedosten"}) );
}
