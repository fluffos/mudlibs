#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Eine Tuer fuehrt hier ins Innere des Turms. Ein "+
    "hoelzernes Schild wurde ueberhalb der Tuer befestigt. Tief unter dir fuehrt eine "+
    "Treppe nach sueden hinab."));
  AddDetail( ({ "schild" }),
    BS("Es ist aus Holz und wurde ueberhalb der Tuer befestigt. "));
  AddReadDetail( ({ "schild" }),
    "+----------+\n"+
    "| Gasthaus |\n"+
    "+----------+\n" );

  AddDetail( ({ "treppe", "ebene", "ende" }),
    BS("Tief unter dir fuehrt eine Treppe nach Sueden hinab. Du kannst eine Kreuzung "+
    "nahe dem unteren Ende der Treppe sehen. "));
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Sueden. "));
  AddDetail( ({ "umgebung", "land", "gelaende" }),
    BS("Direkt im Sueden ist eine Kreuzung zu sehen. Im Suedwesten erstreckt sich "+
    "ein weites Grasland. Im Nordwesten sind erste Bergauslaeufer zu sehen."));
  AddDetail( ({ "kreuzung" }),
    BS("Du kannst von hier aus nicht mehr erkennen als eine normale Kreuzung."));
  AddDetail( ({ "grasland" }),
    BS("Weites Grasland erstreckt sich im suedwesten."));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleinere Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erkennen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man einige Spitzen des Bergmassivs sehen."));
  AddDetail( ({ "tuer", "innere" }),
    BS("Eine Tuer fuehrt hier ins innere des Turms."));
  AddDetail( ({ "holz" }),
    BS("Ganz normales Holz."));

/* 
  AddDetail( ({ "" }),
    BS(""));
*/

  AddExit( "ostoben" , ROOM + "marmorturm_helix2_c4.lpc");
  AddExit( "nordwestunten" , ROOM + "marmorturm_helix1_a3.lpc");
  AddExit( "rein", ROOM + "marmorturm_helix1_b3.lpc"); 

  AddExit( "osten" , ROOM + "marmorturm_helix2_c4.lpc");
  AddExit( "nordwesten" , ROOM + "marmorturm_helix1_a3.lpc");
  SetProp( P_HIDE_EXITS, ({"nordwesten", "osten"}) );

}
