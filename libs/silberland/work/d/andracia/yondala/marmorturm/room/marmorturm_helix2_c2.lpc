// Post

inherit "std/post.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zaubererpost" );
  SetProp( P_INT_LONG,
     BS("Dies ist die Post der Zauberer. Die blanken Marmorwaende lassen "+
     "diesen Raum sehr kuehl wirken. Das Licht das aus dem Marmor der Decke "+
     "zu kommen scheint laesst die Post auch nicht waermer erscheinen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "boden", "marmorboden" }),
    BS("Der Boden besteht aus grauweissem Marmor. "));
  AddDetail( ({ "decke", "marmordecke" }),
    BS("Die Decke aus Marmor scheint von innen heraus zu leuchten. "));
  AddDetail( ({ "waende", "marmorwaende", "wand" }),
    BS("Die kahlen Marmorwaende lassen den Raum besonders kuehl erscheinen."));
  AddDetail( ({ "post", "raum" }),
    BS("Dieser, etwas kahle Raum hat alles was man in einer Post so brauch"));
  AddDetail( ({ "marmor", "turm", "marmorturm" }),
    BS("Der ganze Turm scheint von oben bis unten aus Marmor gemacht zu sein."));
  AddDetail( ({ "licht" }),
    BS("Das Licht scheint aus dem Marmor der Decke selbst zu kommen.") );

/*
  AddDetail( ({ "" }),
    BS("") );
*/ 

  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix2_c1.lpc");

  /*Objekte und NPCs*/
  AddItem( "std/postschalter.lpc", REFRESH_REMOVE );

}
