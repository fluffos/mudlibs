// Laden unten
inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Metallwarenladen von Kirgam Frathag" );
  SetProp( P_INT_LONG,
     BS("Dies ist der Metallwarenladen von Kirgam Frathag. Neben einem umfangreichen "+
     "Sortiment an Waffen, Hufeisen und Naegeln, kann man hier alles bekommen was "+
     "das Abenteurerherz begehrt. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "Kirgam Frathag");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetStorageRoom( ROOM + "marmorturm_helix1_b2_storage.lpc");

  AddSound( DEFAULT_SOUND,
    BS("Du kannst hier nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach Metall."));
  AddSmell( ({ "metall", "geruch", "metallgeruch" }),
    BS("Typischer Metallgeruch."));

  AddDetail( ({ "boden", "marmorboden" }),
    BS("Der marmorne Boden hat schon viele Macken und Schadstellen. Warscheinlich von "+
    "heruntergefallenen Waffen oder anderen schweren Metallgegenstaenden. "));
  AddDetail( ({ "decke", "marmordecke" }),
    BS("Eine Marmordecke leuchtet von innen heraus und taucht den Laden in ein "+
    "angenehmes Ambiente."));
  AddDetail( ({ "waende", "wand" }),
    BS("An den Waenden stehen viele Regale in denen die Waren, die hier zum "+
    "Verkauf stehen, ausgestellt sind."));
  AddDetail( ({ "laden", "warenladen", "metallwarenladen", "raum" }),
    BS("Dies ist der Metallwarenladen von Kirgam Frathag. Neben einem umfangreichen "+
    "Sortiment an Waffen, Hufeisen und Naegeln, kann man hier alles bekommen was "+
    "das Abenteurerherz begehrt. An den Waenden stehen viele Regale in denen die "+
    "Waren, die hier zum Verkauf stehen, ausgestellt sind."));
  AddDetail( ({ "macken", "schadstellen", "stellen" }),
    BS("Heruntergefallene Waffen und schwere Gegenstaende koennen dazu fuehren dass in "+
    "diesem empfindlichen Marmorboden die glatte Oberflaeche rauhe Schadstellen bekommen. "));
  AddDetail( ({ "waffen", "hufeisen", "nagel", "naegel", "metallwaren", "metallgegenstaende", "sortiment", "verkauf" }),
    BS("Waffen, Hufeisen und Naegel sind hier das vorherrschende Angebot. Mit 'zeige' kannst "+
    "Du dir das Angebot des Ladens anschauen. "));
  AddDetail( ({ "abenteurerherz", "abenteurer", "herz" }),
    BS("Jeder Abenteurer hat ein Herz. Ich wuerde davon abraten sich die Brust aufzureissen "+
    "um das Herz naeher zu untersuchen. "));
  AddDetail( ({ "waren", "gegenstaende" }),
    BS("Mit 'zeige' kannst Du dir das Angebot des Ladens anschauen. "));
  AddDetail( ({ "ambiente", "licht" }),
    BS("Das Licht das aus der marmornen Decke zu kommen scheint erzeugt "+
    "ein angenehmes Ambiente. "));
  AddDetail( ({ "regale" }),
    BS("Einfache Regale. Die Waren, die hier zum Verkauf stehen, liegen darauf. "+
    "Mit 'zeige' kannst Du dir das Angebot des Ladens anschauen. "));
  AddDetail( ({ "metall" }),
    BS("Viele Dinge sind hier aus Metall. Mit 'zeige' kannst "+
    "Du dir das Angebot des Ladens anschauen."));
  AddDetail( ({ "angebot", "dinge" }),
    BS("Das Angebot ist umfangreich und vorallem Waffen, Hufeisen und Naegel liegen in den "+
    "Regalen des Ladens."));
  AddDetail( ({ "brust" }),
    BS("In deiner Brust schlaegt ein Abenteurerherz. Los! Zieh in die Ferne und erlebe "+
    "phantastische Geschichten."));
  AddDetail( ({ "geschichten", "geschichte" }),
    BS("Hier werden keine Geschichten erzaehlt."));
  AddDetail( ({ "geschichtenerzaehler" }),
    BS("Ist leider keiner hier. Such woanders."));
  AddDetail( ({ "oberflaeche", "oberflaechen", "flaeche", "flaechen" }),
    BS("Der Marmor des Turms ist fast ueberall besonders glatt. Nur die Schadstellen am "+
    "Boden unterbrechen die makellosen Flaechen."));
  AddDetail( ({ "marmor", "turm", "marmorturm" }),
    BS("Der ganze Turm besteht aus Marmor. Vorwiegend Weiss mit beigen Schlieren."));
  AddDetail( ({ "schlieren" }),
    BS("Typisch Marmor eben."));
  AddDetail( ({ "geruch", "metallgeruch" }),
    BS("Riechen waere hierbei sinnvoll."));

/* 
  AddDetail( ({ "" }),
    BS(""));
*/

  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix1_a2.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "kirgam_frathag.lpc", REFRESH_DESTRUCT );

}

