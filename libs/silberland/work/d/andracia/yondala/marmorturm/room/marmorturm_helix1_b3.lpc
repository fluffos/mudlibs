// Gasthaus unten
// Wirt Yendar Derpel
#include "../def.h"

inherit "std/pub.lpc";

#include <properties.h>
#include <language.h>
#include <pub.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Unteres Gasthaus zum Marmorturm" );
  SetProp( P_INT_LONG,
     BS("Dies ist das untere Gasthaus zum Marmorturm. Besucher und Zauberer "+
     "treffen sich hier gleichermassen. Die Speisekarte hat bodenstaendiges "+
     "Essen und Trinken parat und die gemuetliche Inneneinrichtung ist aus "+
     "Holz. Die Waende, Boden und Decke sind allerdings auch aus Marmor. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Yendar Derpel");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Yendar Derpel");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddDetail( ({ "boden" }),
    BS("Der Marmor des Bodens ist etwas dunkler als sonst. "));
  AddDetail( ({ "decke" }),
    BS("Der Marmor der Decke ist etwas dunkler als sonst. "));
  AddDetail( ({ "wand", "waende" }),
    BS("Der Marmor der Waende ist etwas dunkler als sonst. "));
  AddSound( DEFAULT_SOUND,
    BS("Lautes Stimmengewirr herrscht hier von den Gaesten des Gasthaus."));
  AddSmell( DEFAULT_SMELL,
    BS("Hier herrscht ein Geruch von Bier und vielen Menschen."));

  AddDetail( ({ "marmor" }),
    BS("Der Marmor ist hier etwas dunkler als sonst. "));
  AddDetail( ({ "gasthaus", "raum", "ort" }),
    BS("Dies ist das untere Gasthaus zum Marmorturm. Besucher und Zauberer "+
    "treffen sich hier gleichermassen. Die Waende, Boden und Decke sind "+
    "allerdings auch aus Marmor. "));
  AddDetail( ({ "einrichtung", "inneneinrichtung" }),
    BS("Tische, Stuehle und Baenke sind aus Holz. Neben den gut besuchten "+
    "Sitzgelegenheiten ist eine lange Theke mit einer Zapfanlage aus Messing "+
    "in diesem Gasthaus untergebracht. "));
  AddDetail( ({ "stuhl", "stuehle", "bank", "baenke", "sitzgelegenheit", "sitzgelegenheiten" }),
    BS("Auf den Stuehlen und Baenken sitzen viele Gaeste und unterhalten sich angeregt bei "+
    "Essen und Trinken. Sie bestehen ausnahmslos aus einfachem Holz. "));
  AddDetail( ({ "theke" }),
    BS("Die kurze Theke ist aus poliertem Holz. Fuer die etwas eiligeren Gaeste schenkt der "+
    "Wirt hier seine Getraenke aus. "));
  AddDetail( ({ "zapfanlage" }),
    BS("Auf der Theke steht eine komplizierte Zapfanlage aus Messing. Rohre fuehren "+
    "nach oben in die Decke und fuehren wohl von dort in die Faesser mit Wein und Bier. "));
  AddDetail( ({ "rohre", "rohr" }),
    BS("Mehrer Rohre fueheren von der Zapfanalge hinauf in die Decke. Sie bestehen aus "+
    "Messing. Warscheinlich fliesst Wein und Bier darin. "));
  AddDetail( ({ "faesser", "fass" }),
    BS("Hier sind keine Faesser."));
  AddDetail( ({ "tisch", "tische" }),
    BS("An den hoelzernen Tischen sitzen die Gaeste bei Essen und Trinken. "));
  AddDetail( ({ "marmorturm", "turm" }),
    BS("Du befindest dich direkt im Turm. Dies ist das untere Gasthaus."));
  AddDetail( ({ "besucher" }),
    BS("Viele Besucher staerken sich hier mit Essen und Trinken. Vorallem Menschen "+
    "sind zu sehen, aber auch ein paar Zauberer lassen es sich hier gut gehen."));
  AddDetail( ({ "speisekarte" }),
    BS("Du kannst die Speisekarte mit 'menue' anschauen."));
  AddReadDetail( ({ "speisekarte" }),
    BS("Du kannst die Speisekarte nur mit 'menue' lesen."));
  AddDetail( ({ "essen", "trinken", "getraenke", "getraenk" }),
    BS("Schau doch was die Speisekarte alles anbietet. "));
  AddDetail( ({ "holz" }),
    BS("Nur stinknormales Holz. "));
  AddDetail( ({ "messing" }),
    BS("Die Zapfanlage ist poliert und das Messing glaenzt schoen."));
  AddDetail( ({ "marmor" }),
    BS("Der ganze Turm besteht aus Marmor. "));
  AddDetail( ({ "wasser", "quellwasser" }),
    BS("Das glasklare Wasser, das hier an Weicheier ausgeschenkt wird, blubbert "+
    "leicht. "));
  AddDetail( ({ "wein", "rotwein", "troepfchen" }),
    BS("Leicht trocken und vollmundig im Geschmack. Ein gutes Troepfchen eben dieser Wein. "));
  AddDetail( ({ "pflaumenbrannt", "brannt", "rachenputzer" }),
    BS("Stark und fruchtig herb. Ein richtig guter Rachenputzer. "));
  AddDetail( ({ "saft", "kakteensaft", "maguskakteesaft" }),
    BS("Dieser Saft ist leicht gruenlich und hat einen saeuerlichen Geruch."));
  AddDetail( ({ "kaktus" }),
    BS("Diese knusprig gebratenen Kaktusscheiben die man hier zu essen bekommt, sind "+
    "gut gewuerzt und innen schoen saftig. "));
  AddDetail( ({ "bein", "huehnerbein", "snack" }),
    BS("Als Snack fuer Zwerge gedacht findet das gebratene Huehnerbein auch bei Menschen "+
    "und Zauberern als Hauptmahlzeit gefallen."));
  AddDetail( ({ "eintopf", "termiten", "termiteneintopf" }),
    BS("Der Eintopf der hier ausgegeben wird riecht sehr streng und scheint auch nicht fuer "+
    "jeden Magen geschaffen zu sein. "));
  AddDetail( ({ "haxe", "schweinshaxe", "fleisch", "schwarte" }),
    BS("So eine Schweinshaxe hat es schon in sich. Mit viel Fleisch und einer knusprigen "+
    "Schwarte wird auch ein Zwerg satt." ));
  AddDetail( ({ "magen" }),
    BS("Du musst selbst wissen was Du dir zumuen kannst."));
  AddDetail( ({ "hauptmahlzeit", "mahlzeit", "speisen", "mahl" }),
    BS("Schau doch mit 'menue' in der Speisekarte was hier so angeboten wird."));
  AddDetail( ({ "menschen" }),
    BS("Hier sind sehr viele. Die meisten sind mit ihrem Mahl beschaeftigt."));
  AddDetail( ({ "zwerge" }),
    BS("Hier im Zaubererturm findet man selten Zwerge, Zwergenzauberer findet "+
    "man gar nicht. "));
  AddDetail( ({ "zwergenzauberer" }),
    BS("Solch eine Kuriositaet hat noch niemand gesehen. "));
  AddSound( ({ "stimmen", "stimmengewirr", "gaeste" }),
    BS("Viele Gaeste hier reden und erzeugen damit ein Stimmengewirr."));
  AddSmell( ({ "geruch" }),
    BS("Es riecht hier nach Bier und Menschen."));
  AddSmell( ({ "bier", "steppenbier" }),
    BS("Das Bier riecht stark und kraeftig."));
  AddSmell( ({ "menschen" }),
    BS("Der ganz normale Geruch von Menschen wenn viele an einem Ort sind."));
  AddSmell( ({ "zwerge" }),
    BS("Der Geruch von Bier und Menschen ueberdeckt alles."));
  AddDetail( ({ "geschmack" }),
    BS("Du musst die Speisen einfach mal probieren."));
  AddDetail( ({ "wirt" }),
    BS("Lass Dir doch einfach die Speisekarte zeigen."));
  AddDetail( ({ "bier", "steppenbier" }),
    BS("Teiheb brauen ein unglaublich sueffiges Bier."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  AddDrink(  "Quellwasser",({ "quellwasser", "wasser" }),150, 5, 0, 8,
         ({ "Du trinkst Dein Wasser in einem Zug aus.",
            "&& leert in einem Zug ein Glas Quellwasser." }) );
  AddDrink(  "importierter Rotwein",({ "wein", "rotwein" }),425, 8, 4, 10,
         ({ "Du trinkst mit Genuss Deinen Rotwein.",
            "&& laesst sich ein Glas Rotwein schmecken." }));  
  AddDrink(  "Steppenbier",({ "bier", "steppenbier" }),315, 8, 2, 16,
         ({ "Ah - dieser Humpen Steppenbier erfrischt.",
            "&& erfrischt sich mit einem Humpen Steppenbier." }));  
  AddDrink(  "Pflaumenbrannt",({ "pflaumenbrannt", "brannt" }),450, ({5,8}), 9, 5,
         ({ "Du kippst Dir Deinen Pflaumenbrannt in den Hals.",
            "&& kippt sich einen Pflaumenbrannt in den Hals." }) );  
  AddDrink( "Saft der Maguskaktee",({ "saft", "kakteensaft", "maguskakteensaft" }), 
             630, ({0,25}), 2, 12,
         ({ "Du trinkst Deinen Saft in einem Zug aus.",
            "&& leert in einem Zug ein Glas mit gruenem Saft." }) );
            
  AddFood(  "gebratener Kaktus", ({ "kaktus" }),351, 10, 10,
         ({ "Du verspeist die knusprig gebratene Kaktusscheibe mit einem Haps.",
            "&& laesst sich gebratenen Kaktus schmecken." }) );
  AddFood(  "Huehnerbein",({ "bein", "huehnerbein" }), 467, 0, 15, "eat_bein" );
//         ({ "Du verschlingst das Huehnerbein.",
//            "&& verschlingt ein Huehnerbein." }) );
  AddFood(  "Termiteneintopf", ({ "eintopf", "termiten", "termiteneintopf" }),539, 0, 25, "eat_eintopf" );
//         ({ "Du schluerfst einen Termiteneintopf.",
//            "&& schluerft einen Termiteneintopf." }) );
  AddFood(  "Schweinshaxe", ({ "haxe", "schweinshaxe" }),673, 0, 35, "eat_haxe" );
//         ({ "Du verleibst Dir eine maechtige Schweinshaxe ein.",
//            "&& macht sich ueber eine Schweinshaxe her." }) );

  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix1_b4.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "yendar_derpel.lpc", REFRESH_DESTRUCT );

  RemoveItem( "/obj/topliste" );
}

// Elfen sollen kein Fleisch essen
// 
void eat_bein(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    // esser->AddPoison(1); //keine Vergiftung
    esser->eat_food(-15,0); //nimmt das Essen wieder raus
    tell_object(esser, 
      BS("Du hast ploetzlich keine Lust mehr ein totes Bein eines armen Federviehs zu verspeisen.") );
    tell_room(this_object(),
      esser->name(WER)+" reicht angewidert das Huehnerbein zurueck.",({ esser }) );       
  }
  else
  {
    esser->AddMp(15);
    esser->AddHp(15);   
    tell_object( esser, BS(
      "Du verspeist mit Wonne ein knuspriges Huehnerbein.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verspeist mit sichtlichem Vergnuegen ein Huehnerbein."),({ esser }) );
  }
}
void eat_eintopf(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    if( esser->QueryProp(P_POISON) < 2) esser->AddPoison(1); // Vergiftung um 1
    esser->eat_food(-20,0); //nimmt das Essen nicht komplett wieder raus
    tell_object(esser, 
      BS("Du isst ein bischen von dem Eintopf, als Dir aber so richtig schlecht wird.") );
    tell_room(this_object(),
      esser->name(WER)+" isst ein bischen Eintopf und bekommt eine etwas fahles Gesicht.",({ esser }) );       
  }
  else
  {
    esser->AddMp(25);
    esser->AddHp(25);   
    tell_object( esser, BS(
      "Du schluerfst einen Termiteneintopf.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" schluerft einen Termiteneintopf."),({ esser }) );
  }
}
void eat_haxe(object zahler, object esser)
{
  if (esser->id("Elfenspieler"))
  {
    // esser->AddPoison(1); //keine Vergiftung
    esser->eat_food(-35,0); //nimmt das Essen wieder raus
    tell_object(esser, 
      BS("Dir wird fast uebel als Dir die Haxe gebracht wird. Du willst davon doch lieber nichts essen.") );
    tell_room(this_object(),
      esser->name(WER)+" verschmaeht angewidert die Haxe.",({ esser }) );       
  }
  else
  {
    esser->AddMp(35);
    esser->AddHp(35);   
    tell_object( esser, BS(
      "Du verleibst Dir eine maechtige Schweinshaxe ein.") );
    tell_room(this_object(), BS(
      esser->name(WER)+" verleibt sich eine maechtige Schweinshaxe ein."),({ esser }) );
  }
}