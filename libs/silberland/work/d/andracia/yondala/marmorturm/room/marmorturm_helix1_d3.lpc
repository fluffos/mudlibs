#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Ein mannshoher Monolith aus weissem "+
    "Stein wurde hier an der Aussenseite des Turms aufgestellt. ") );
  
  AddDetail( ({ "monolith" }),
    BS("Der Monolith besteht aus weissem Stein - irgendwas ist seltsam an diesem Monolith. "));
  AddDetail( ({ "stein" }),
    BS("Scheint normaler Stein zu sein - irgendwas ist seltsam an diesem Monolith. "));
   
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Osten. "));
  AddDetail( ({ "umgebung", "land", "gelaende", "grenze" }),
    BS("Direkt im Osten ist die Grenze zwischen Wald und Bergauslaeufern zu sehen. "+
    "Im Suedosten sind erste groessere Bergauslaeufer und im Nordosten kannst Du dichten "+
    "Wald erkennen. "));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleine Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erahnen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man nur sehr wenige Spitzen des Bergmassivs sehen."));
  AddDetail( ({ "wald" }),
    BS("Im Nordosten erstreckt sich ein riesiger Wald. "));

  AddCmd( ({"teste", "testen", "beruehre", "beruehr"}), "CmdTesten");

  AddCmd( ({"benuetze","benutze","durchschreite","betrete","trete"}), "CmdTeleporter");

  AddExit( "nordoben" , ROOM + "marmorturm_helix1_d2.lpc");
  AddExit( "suedwestunten" , ROOM + "marmorturm_helix1_c4.lpc");

  AddExit( "norden" , ROOM + "marmorturm_helix1_d2.lpc");
  AddExit( "suedwesten" , ROOM + "marmorturm_helix1_c4.lpc");
  SetProp( P_HIDE_EXITS, ({"norden", "suedwesten"}) );
}

int CmdTesten(string str) 
{
  notify_fail("Was willst Du testen?\n");
  if( str != "glaette" && str != "handlauf" && str != "" && str != "stein"
      && str != "marmor" && str != "monolith" ) 
    return 0;
  if( str=="monolith" || str=="stein" )
    {
      write(BS("Du versuchst mit dem Finger ueber den Monolith zu streichen - "+
      "er bietet ja gar keinen Widerstand! Dein Finger taucht tief in den Stein."));
      say(capitalize(this_player()->name())+ " steckt seinen Finger in den Monolith. \n");
      return 1;
    }
  write("Du streichst mit dem Finger ueber den Handlauf - sehr glatt! \n");
  say(capitalize(this_player()->name())+ " streicht mit dem Finger ueber den Handlauf. \n");
  return 1;
}

int CmdTeleporter(string str) 
{
  notify_fail("Was willst Du benutzen?");
  if( str != "monolith" && str != "durch monolith" && str != "den monolith")  return 0;
  write("Du trittst in den Monolith und kommst sofort auf dem Dach des Turms heraus. \n");
  TP->move(ROOM + "marmorturm_helix3_b3.lpc", M_TPORT,
   "im Monolith","verschwindet","kommt aus dem Monolith heraus");
  return 1;
}  