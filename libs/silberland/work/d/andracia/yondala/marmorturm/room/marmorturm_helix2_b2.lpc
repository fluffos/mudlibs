// Laden mitte
inherit "std/laden.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/sys/laden.h"
#include <moredef.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Laden fuer Zauberstaebe" );
  SetProp( P_INT_LONG,
     BS("Dies ist ein Laden fuer Zauberstaebe. Auf der Theke und in den Regalen "+
     "liegen aberhunderte von laenglichen Schachteln in denen wohl die "+
     "unterschiedlichsten Zauberstaebe aufbewahrt werden. Im hinteren Bereich kannst "+
     "Du in der Werkstatt eine Drechselbank und mehrere Schraenke erkennen. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER );
  SetProp( P_SHOPKEEPER_ID, "Hugen Borax");
  SetProp( P_SHOPKEEPER_GENDER, MALE);
  SetProp( P_SPECIAL_SHOP, 
    ([1:BS("Ich kaufe nur Zauberstaebe; und diese auch erst nach eingehender Beurteilung.")]) );
  SetStorageRoom( ROOM + "marmorturm_helix2_b2_storage.lpc");
  RemoveFixedObject( 0 );

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier irgendwie komisch. Ob so Magie riecht?"));
  AddSmell( ({ "magie", "geruch" }),
    BS("Magie scheint sehr komisch zu riechen, sofern dieser Geruch hier Magie ist. "));

  AddDetail( ({ "boden" }),
    BS("Der Boden ist wie sonst auch ueberall hier im Turm aus Marmor. "));
  AddDetail( ({ "decke" }),
    BS("Der Marmor der Decke schein irgend wie aus innen heraus zu leuchten und "+
    "erhellt damit den ganzen Raum. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Auch die Waende sind aus dem allgegenwaertigen Marmor. Regale sind an den "+
    "Waenden befestigt und viele laengliche Schachteln liegen darauf.") );
  AddDetail( ({ "laden", "raum", "raeume" }),
    BS("In diesem Laden werden nur Zauberstaebe gehandelt. Auf der Theke und in den Regalen "+
    "liegen aberhunderte von laenglichen Schachteln in denen wohl die "+
    "unterschiedlichsten Zauberstaebe aufbewahrt werden. Im hinteren Bereich kannst "+
    "Du in der Werkstatt eine Drechselbank und mehrere Schraenke erkennen."));
  AddDetail( ({ "theke" }),
    BS("Eine einfache Theke aus Holz. Mehrere Schachteln und Zauberstaebe liegen darauf. "));
  AddDetail( ({ "regale" }),
    BS("Die Regale bestehen aus normalem Holz. Viele Schachteln sind auf den Regalen "+
    "gestapelt. Der Form nach zu urteilen beinhalten all diese Schachteln Zauberstaebe. "));
  AddDetail( ({ "schachteln", "schachtel" }),
    BS("Der Form nach zu urteilen beinhalten alle Schachteln Zauberstaebe."));
  AddDetail( ({ "zauberstaebe", "auswahl", "angebot" }),
    BS("Hier gibt es eine gross Auswahl. Mit 'zeige' kannst Du dir das Angebot anschauen."));
  AddDetail( ({ "bereich" }),
    BS("Hier im vorderen Bereich sind die vielen Zauberstaebe die zum Verkauf stehen. Im "+
    "hinteren Bereich ist der Raum zur Werkstatt umfunktioniert. Eine Drechselbank "+
    "steht dort."));
  AddDetail( ({ "werkstatt" }),
    BS("Die Werkstatt ist zwar aufgeraeumt aber staubig. Sie wird wohl selten benutzt. "));
  AddDetail( ({ "drechselbank" }),
    BS("Auf dieser Drechselbank kann man einen Stock rund bearbeiten."));
  AddDetail( ({ "schraenke" }),
    BS("Im hinteren Bereich stehen mehrere Schraenke die aber fuer dich total "+
    "uninteressant sind. "));
  AddDetail( ({ "turm", "marmorturm", "marmor" }),
    BS("Alle Raeume hier im Marmorturm bestehen aus Marmor. "));
  AddDetail( ({ "magie", "luft" }),
    BS("Die Luft knistert vor lauter Magie."));
  AddDetail( ({ "holz" }),
    BS("Die Regale und Theke bestehen aus Holz. Auch viele der Zauberstaebe sind hoelzern."));
  AddDetail( ({ "stock" }),
    BS("Du hast keinen bei Dir. "));
  AddDetail( ({ "form", "hoehe", "laenge", "seite", "breite" }),
    BS("Die Form der Schachteln ist allgemein sehr lang und schmal. "+
    "Ihre Hoehe ist meist genauso hoch wie ihre schmale Seite."));
  AddDetail( ({ "verkauf" }),
    BS("Hier werden wohl nur Zauberstaebe gehandelt."));


/* 
  AddDetail( ({ "" }),
    BS(""));
*/

  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix2_a2.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "hugen_borax.lpc", REFRESH_DESTRUCT ); 
  RemoveItem( "/obj/entsorg" ); // muellschluckerfrei

  /*Cmd zum Zauberstabverkauf*/
  AddCmd( "beurteile" , "zauberstab_ankauf" );
}


int zauberstab_ankauf(string str)
{
  object keeper, ob;
  notify_fail( BS("Es ist gerade niemand da der einen Zauberstab beurteilen kann. ") );
  if( !(keeper=present( "\nhugenborax")) ) return 0;
  notify_fail( BS("Hugen Borax ist gerade zu beschaeftigt um Zauberstaebe zu beurteilen. ") );
  if( keeper->InFight() ) return 0;
  notify_fail( BS("Was willst Du beurteilen lassen? ") );
  if( !str ) return 0;
  if( !(ob = present( str , TP)) ) return 0;
  notify_fail( BS("Du kannst hier nur Zauberstaebe beurteilen lassen") );
  if( !ob->id("\nwand") ) return 0;
  // bewerten und ankauf anbieten
  if( ob->QueryProp(P_WIELDED) ) {
    write(break_string("Du solltest " + ob->name(WEN,1) + " wegstecken, "
        "bevor Du " + ob->QueryPronoun(WEN) + " beurteilen lassen willst.", 78));
    return 1;
  }

  write("Du gibst Hugen Borax den Zauberstab und er haelt ihn pruefend in die Luft.\n");
  say( TP->name()+" gibt Hugen Borax einen Zauberstab zur Beurteilung.\n");
  call_out("bewertet", 2, ob, TP);
  return 1;
}

void bewertet(object staff, object seller)
{
  string prefix, str;
  int value, orivalue, i;
  string *sprueche;
  string leuchtfarbe;
  string ausgabe;

  orivalue=staff->QueryProp(P_VALUE);
  value=QuerySellValue(staff);
  if (!prefix=CheckKeeper(2)) return;

  if (str=staff->QueryProp(P_NOSELL)) {
    if (stringp(str))
      write(str);
    else
      write(break_string( "Du kannst " +
            staff->Name(WEN,1) + " nicht verkaufen!", 78, prefix));
    return;
  }
  if (orivalue <= 0)
  {
    write(break_string( staff->Name(WER,1) +" hat" +
          " keinen materiellen Wert, tut mir leid.", 78, prefix));
    return;
  }

  sprueche = staff->QueryZSpells();
  leuchtfarbe = staff->QueryLeuchtfarbe();
  if( sizeof(sprueche) ) 
  {
    ausgabe = "Dieser Zauberstab";
    if( member(sprueche, "lumini")!=-1 ) {
      ausgabe += " kann mit dem Zauberspruch Lumini in "+leuchtfarbe+" leuchten";
      sprueche -= ({"lumini"});
      if( sizeof(sprueche) ) {
      	ausgabe += " und kann desweiteren ";
      }
    } else {
     	ausgabe +=" kann ";
    }
    if(sizeof(sprueche) == 1) ausgabe += "den Zauberspruch "; 
    else ausgabe += "die Zaubersprueche ";
  	for( i=sizeof(sprueche); i>0; i-- ) {
  		ausgabe += capitalize(sprueche[i-1]);
  		if( i>2 ) ausgabe += ", ";
      else if( i==2 ) ausgabe += " und ";
    	else ausgabe+=" wirken.";
    }
    write(break_string( ausgabe, 78, prefix));
  }
  	
  if(staff->QueryProp(P_KEEP_ON_SELL)==getuid(this_player()) )
  {
    write(break_string("Ihr wolltet " + staff->name(WEN,1) + " doch behalten. "
      "Wollt Ihr " + staff->QueryPronoun(WEN) + " mir trotzdem fuer " + value +
      " Muenze" + (value == 1 ? "" : "n") + " ueberlassen? (ja/nein)\n", 78,
      prefix) + " -> ");
    input_to("ask_wand", 0, staff, value, prefix);
    return;
  }
  if( value ) {
    if( value != orivalue) {
      write(break_string(
          sprintf("Nach der aktuellen Marktlage kann ich Euch dafuer nur %d " +
            "Muenze%s bieten, obwohl %s eigentlich %d Muenze%s wert waere.",
            value, (value == 1 ? "" : "n"), staff->name(WER,1),
            orivalue, (orivalue == 1 ? "" : "n")), 78, prefix));
    } else {
      write(break_string( 
          sprintf("Ich kann Euch fuer %s %d Muenze%s anbieten.",
  	        staff->name(WER,1), value, (value == 1 ? "" : "n") ), 78, prefix));
    }
  }
  write(
    "Wollt Ihr "+staff->QueryPronoun(WEN)+" mir nun verkaufen? "+
    "(ja/nein) -> ");
  input_to("ask_wand", 0, staff, value, prefix);
}

void ask_wand(string str, object ob, int value, string prefix)
{
  str = lower_case(str);
  if (str == "ja" || str == "j")
    this_object()->do_wand(ob, value, prefix);
  else
    write(prefix + "Ok, dann behaltet "+ob->QueryPronoun(WEN)+"!\n");
  return;
}

void do_wand(object ob, int value, string prefix)
{
  if (!value) {
    write(break_string( "Ich bin absolut pleite. "
          "Tut mir aufrichtig leid.", 78, prefix));
    return;
  }
  //verkaufen
  TO->do_sell2(ob, value, prefix, 1);
}
 
mixed *GetList()
{
  object store;
  int i;
  mixed *output,tmp,str;
  string comp;
  mapping tmp2;

  output=({});
  call_other(storage, "_register_shop", this_object());
  if (!objectp(store=find_object(storage))) return output;
  tmp=fixed_obj+all_inventory(store); tmp2=([]);
  for (i=sizeof(tmp)-1;i>=0;i--)
  {
    str=({({sprintf("%'.'-50.50s%'.'7.7d",
               tmp[i]->short()[0..<3], QueryBuyValue(tmp[i])), tmp[i]})});
    comp=str[0][0][0..25];
    if (!tmp2[comp]) {
      tmp2[comp]=1;
      output+=str;
    }
  }
  return output;
}

varargs int DoList(string query_fun, string str)
{
  object ob,keeper;
  int i,j,n;
  string *output;
  string prefix,out;

  if (this_player()->InFight()) {
    write("Dazu bist Du im Moment viel zu beschaeftigt.\n");
    return 1;
  }
  if (!prefix=CheckKeeper()) return 1;
  output=GetList();
  if (!sizeof(output)) {
    write(prefix+"Im Moment sind wir leider VOELLIG ausverkauft!\n");
    return 1;
  }
  out="";
  for (i=0;i<sizeof(output);i++) {
    out+=sprintf("%3d. %s",i+1,output[i][0]);
    out+="\n";
  }
  this_player()->More(out);
  out=0;
  return 1;
}

