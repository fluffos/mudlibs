// Gasthaus oben
// Wirt xologrim_cendrasch.c
#include "../def.h"

inherit "std/pub.lpc";

#include <properties.h>
#include <language.h>
#include <pub.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Gasthaus zum Drachenfaenger" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich hier im Gasthaus zum Drachenfaenger. Vorallem "+
     "die Zauberer kehren hier gerne ein. Besonders die Drachenhautangebote "+
     "sind hier zu empfehlen. Die Tische und Stuehle sind flauschige Gebilde "+
     "aus einem hellblauen Material. Die Waende, Boden und Decke sind aus Marmor. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_PUB_FLAGS,  PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Xologrim Cendrasch");
  SetProp( P_PUBKEEPER_NAME, "der Wirt Xologrim Cendrasch");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddSound( DEFAULT_SOUND,
    BS("Du kannst nichts besonderes hoeren."));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "boden" }),
    BS("Der Boden scheint aus einfachem Marmor zu bestehen. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke besteht wohl auch aus normalem Marmor, allerdings scheint die Decke "+
    "von innen heraus zu leuchten."));
  AddDetail( ({ "wand", "waende" }),
    BS("Die Waende bestehen aus normalem Marmor."));
  AddDetail( ({ "gasthaus", "umgebung", "drachenfaenger" }),
    BS("Dies ist das Gasthaus zum Drachenfaenger. Vorallem Zauberer geniessen hier in "+
    "etwas ungewoehnlicher Umgebung ihre Mahlzeiten. Die Tische und Stuehle haben ein "+
    "gewoehnungsbeduerftiges, flauschiges Aussehen. Diese hellblaue, wolkenartige "+
    "Inneneinrichtung verwirrt sehr aber andererseits kann man in der weichen Polsterung "+
    "der Stuehle besonders bequem sitzen."));
  AddDetail( ({ "einrichtung", "inneneinrichtung", "gebilde" }),
    BS("Die Tische und Stuehle haben ein gewoehnungsbeduerftiges, flauschiges Aussehen. "+
    "Diese hellblaue, wolkenartige Inneneinrichtung verwirrt sehr aber andererseits kann "+
    "man in der weichen Polsterung der Stuehle besonders bequem sitzen."));
  AddDetail( ({ "stuhl", "stuehle", "bank", "baenke" }),
    BS("Die Stuehle bestehen aus einem unbekannten hellblauen, flauschigen Material. Man kann "+
    "sich ganz normal darauf setzen und bei seiner Mahlzeit bequem sitzen."));
  AddDetail( ({ "tisch", "tische" }),
    BS("Auch die Tische bestehen aus diesem ungewoehnlichen, flauschigen Material. Es fuehlt "+
    "sich wunderbar an aber die Teller mit Speisen versinken kaum darin."));
  AddDetail( ({ "material", "polsterung" }),
    BS("Leider kennst Du dieses Material nicht. Es ist flauschig, hellblau und laedt dazu ein, "+
    "sich darin wohl zu fuehlen."));
  AddDetail( ({ "gebilde", "aussehen" }),
    BS("Die Gebilde sind wohl Tische und Stuehle."));
  AddDetail( ({ "quellwasser", "wasser" }),
    BS("Ganz normales Quellwasser lindert den Durst, hat dafuer aber auch nur wenig Geschmack."));
  AddDetail( ({ "nebel", "nebelkonzentrat" }),
    BS("Nebelkonzentrat wird auf magische Weise aus Wolken gewonnen. Nur hier kann man diesen "+
    "ungewoehnlichen Umtrunk geniessen."));
  AddDetail( ({ "saft", "wolkensaft", "gewitterwolkensaft", "gewittersaft" }),
    BS("Wie die Zauberer eine Gewitterwolke auspressen muss eines der ungewoehnlichsten Ereignisse "+
    "hier im Marmorturm sein. Leider sind die Bestaende dieses Gasthaus sehr gross und es wird in "+
    "naechster Zukunft nicht notwendig sein eine Gewitterwolke auszupressen."));
  AddDetail( ({ "tee", "drachentee", "drachenhauttee", "hauttee"}),
    BS("Wenn ein Drache sich haeutet so bleibt doch ein kleiner Rest von Drachenmagie in seiner "+
    "abgeworfenen Haut zurueck. Ein entsprechender Tee daraus mag nicht sonderlich gut schmecken  "+
    "aber erfrischt magisch. "));
  AddDetail( ({ "steak", "wolkensteak", "scheiben", "kruste", "wolken" }),
    BS("Blaue, weiche Scheiben mit einer kleinen dunkelblauen Kruste. Zauberer haben ungewoehnliche "+
    "Essgewohnheiten."));
  AddDetail( ({ "schnitzel", "drachenschnitzel", "drachenhautschnitzel", "hautschnitzel" }),
    BS("Wenn ein Drache sich haeutet so bleibt doch ein kleiner Rest von Drachenmagie in seiner "+
    "abgeworfenen Haut zurueck. Gebratene Drachenhautschnitzel sind daher besonders erfrischend. "+
    "Vom Geschmack her allerdings ist solch ein Schnitzel eher fade."));
  AddDetail( ({ "essgewohnheiten", "essen", "mahlzeit", "mahlzeiten", "speisen" }),
    BS("Hier werden den Zauberern ungewoehnliche Mahlzeiten zubereitet. Neben konzentriertem Nebel und "+
    "Wolkensteaks kann man hier aus einem kleinen Angebot aus Drachenhaut waehlen."));
  AddDetail( ({ "teller", "tellern" }),
    BS("Die Mahlzeiten werden hier auf ganz normalen Tellern angereicht."));
  AddDetail( ({ "marmor" }),
    BS("Decke, Waende und Boden scheinen aus normalem Marmor zu bestehen."));
  AddDetail( ({ "drachenhautangebote", "drache", "drachenhaut", "drachenmagie", "haut", "rest" }),
    BS("Wenn ein Drache sich haeutet so bleibt doch ein kleiner Rest von Drachenmagie in seiner "+
    "abgeworfenen Haut zurueck. Drachenhauttee und Drachenhautschnitzel werden hier angeboten."));
  AddDetail( ({ "angebot", "umtrunk" }),
    BS("Verwende dazu bitte \'menue\'."));
  AddDetail( ({ "geschmack" }),
    BS("Bestell doch einfach etwas."));


/*
  AddDetail( ({ "" }),
    BS(""));
*/
  AddDrink( "Quellwasser",({ "quellwasser", "wasser" }),150, 5, 0, 8,
         ({ "Du trinkst Dein Wasser in einem Zug aus.",
            "&& leert in einem Zug ein Glas Quellwasser." }) );
  AddDrink( "konzentrierter Nebel",({ "nebel", "nebelkonzentrat"  }),245, 10, 0, 6,
         ({ "Du trinkst den Nebel und fuehlst dich erfrischt.",
            "&& trinkt abgefuellten konzentrierten Nebel." }) );
  AddDrink( "Gewitterwolkensaft",({ "saft", "wolkensaft", 
            "gewitterwolkensaft", "gewittersaft"}), 378, ({0,36}), 0, 12,
         ({ "Du trinkst den Wolkensaft und fuehlst deutlich den Aufruhr in deinem Bauch.",
            "&& trinkt Gewitterwolkensaft." }) );
  AddDrink( "Drachenhauttee",({ "tee", "drachentee", "drachenhauttee", "hauttee" }),
            498, ({54,26}), 0, 12,
         ({ "Du trinkst Deinen Drachenhauttee in einem Zug aus.",
            "&& leert in einem Zug einen Pott Drachenhauttee." }) );
  AddFood( "Wolkensteak", ({ "steak", "wolkensteak" }), 350, 10,
         ({ "Du verspeist ein kleines Wolkensteak mit einem Haps.",
            "&& laesst sich ein kleines Wolkensteak schmecken." }) );
  AddFood( "Drachenhautschnitzel", ({ "schnitzel", "drachenschnitzel", 
            "drachenhautschnitzel", "hautschnitzel" }), 750, 50,
         ({ "Du verspeist ein grosses, saftiges Drachenhautschnitzel.",
            "&& laesst sich ein grosses Drachenhautschnitzels schmecken." }) );
  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix3_c1.lpc");

  /*Objekte und NPCs*/
  AddItem( NPC + "xologrim_cendrasch.lpc", REFRESH_DESTRUCT );
  // Gaeste?
  RemoveItem( "/obj/topliste" );
}
