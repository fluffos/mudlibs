// Zaubererbibliothek
#include "../def.h"

inherit "std/room";

#include <properties.h>

// Steuerelemente Anzeige System
// Zeilenumbrueche in den Buechern einpflegen!
object lesepult;
string buch = "index";
mapping index = (["index":0]);
string *test;
 
string *tester()
{
  return test;
}
 
void get_index()
{
  string *filenames, name, dummy;
  int i;
  filenames = get_dir( ROOM+"buecher/*" );
  test = filenames;
  for(i=0; i<sizeof(filenames); i++)
  {
    if( sscanf(filenames[i],"%s.txt%s", name, dummy) == 2 && !member(index, name) )
    index += ([name: ROOM+"buecher/"+filenames[i] ]);
  }
}  

void init()
{
  ::init();
  get_index();
}

string index_lesen(string str)
{
  string erg, *namen;
  int i;
  if( lesepult != TP)
    return "Dazu musst Du dich vor den Pult stellen.\n";
//  namen = m_indices(index);
  namen = sort_array(m_indices(index), #'< );
  erg = "Folgende Titel stehen zur Verfuegung: \n";
  for( i=0; i<sizeof(namen); i++ ) 
    erg += capitalize( namen[i] )+" \n"; 
  return erg;
}

string buch_lesen(string str)
{
  if( lesepult != TP)
    return "Dazu musst Du dich vor den Pult stellen.\n";
  if( buch == "index" ) return index_lesen(str);
  if( file_size(index[buch])!=-1 ) {
    write(read_file(index[buch])+"\n");
    return " \n";
  }
  else {
    say( BS("Das Buch zerfaellt zwischen den Fingern von "+TP->name()+" und ist "+
    "unwiederbringlich verloren. ") );
    index -= ([buch]);
    buch = "index";
    return BS("Das Buch zerfaellt zwischen deinen Fingern und ist "+
    "unwiederbringlich verloren. ");
  }
}

int testpult(string str)
{
  if( lesepult == TP) {
    lesepult = 0;
    tell_room(TO, TP->name()+" geht vom Pult weg.");
  }
  return TP->move(ROOM + "marmorturm_helix2_b4.lpc", M_GO, "","" );
}

