  ::create();

  SetProp( P_INT_SHORT, "Zaubererbibliothek" );
  SetProp( P_INT_LONG,
     BS("Dies ist die Bibliothek der Zaubererzunft. Hier findet man viele Folianten "+
     "die sich mit Zauberstaeben, Zauberspruechen und Legenden der Zauberei beschaeftigen. "+
     "Die Menge an vollgestellten Regalen ist ueberwaeltigend. Allein findet man sich "+
     "hier nicht zurecht. Daher gibt es hier einen Bibliothekar der dir zu deinem "+
     "gewuenschten Thema innerhalb kurzer Zeit das passende Buch besorgt. "+
     "Ein Lesepult steht hier auf dem man sich die Folianten durchlesen kann. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

 // AddSpecialExit( "raus", "test_pult" );
