  get_index();
  AddReadDetail( ({ "index" }), #'index_lesen );
  AddReadDetail( ({ "buch" }), #'buch_lesen );
 
  AddItem( NPC + "bibliothekar.lpc", REFRESH_DESTRUCT);

  AddCmd( ({"stell", "stelle", "steh", "stehe"}) , "hinstellen" );
  AddCmd( ({"verlass", "verlasse"}) , "weggehen" );
  AddCmd( ({"besorg", "besorge"}) , "besorgen" );
}

int hinstellen(string str)
{
  notify_fail("Wo willst Du dich hinstellen?\n");
  if( str!="an lesepult" && str!="an pult" && str!="dich an lesepult" && str!="dich an pult" &&
      str!="auf lesepult" && str!="auf pult" && str!="dich auf lesepult" && str!="dich auf pult") return 0;
  notify_fail("Jemand anderes steht schon am Lesepult.\n");
  if( !lesepult ) {
    lesepult = TP;
    write( "Du stellst dich vor das Lesepult. \n");
    say( lesepult->name()+" stellt sich vor das Lesepult und faengt an zu lesen. \n");
    return 1; 
  }
  return 0;
}

int weggehen(string str)
{  
  notify_fail("Was willst Du verlassen?\n");
  if( str!="lesepult" && str!="pult" ) return 0;
  notify_fail("Du stehst doch gar nicht am Pult.\n");
  if( TP != lesepult ) return 0;
  write( "Du gehst ein paar Schritte vom Lesepult weg. \n ");
  say( lesepult->name()+" verlaesst den Lesepult. \n ");
  lesepult = 0;
  return 1;
}

string unt_pult(string str)
{
  string erg;
  if( lesepult == TP ) return "Du stehst direkt davor. Es besteht aus normalem Holz.\n";
  erg = "Man kann sich dort hin stellen und das ausgestellte Buch lesen.\n";
  if( !lesepult ) return erg;
  erg += capitalize(lesepult->name())+" steht davor und liest.\n";
  return erg;
}

string unt_buch(string str)
{
  if( lesepult == TP ) 
    return BS("Ein gut erhaltenes Buch mit dem Titel "+buch+" liegt vor Dir auf dem Pult. "+
    "Versuchs mal mit lesen. ");
  if( !lesepult ) 
    return "Stell dich am besten vor den Pult dazu. \n";
  return capitalize(lesepult->name())+" steht davor und liest darin. \n";
}

int besorgen(string str)
{
  object ob;
  notify_fail("Der Bibliothekar ist abkoemmlich und kann dir kein Buch besorgen.\n");
  ob=present("/nbibliothekar");
  if( !ob && !(ob->InFight()) ) return 0;
  notify_fail(BS("Du musst schon am Lesepult stehen um dem Bibliothekar Anweisungen "+
    "geben zu koennen. "));
  if( lesepult != TP ) return 0;
  notify_fail("Welchen Titel willst Du Dir vom Bibliothekar besorgen lassen?\n");
  if( str == "" ) return 0;
  notify_fail("Der Bibliothekar sucht, findet diesen Titel aber nicht. \n");
  if( !member(index, str) ) return 0;
  buch = str;
  write( BS("Der Bibliothekar bringt das Buch mit dem Titel "+capitalize(buch)+
    " und legt es auf das Lesepult. ") );
  say( lesepult->name()+" laesst sich vom Bibliothekar das Buch mit dem Titel "+
    capitalize(buch)+ " bringen. ");
  return 1;
}
