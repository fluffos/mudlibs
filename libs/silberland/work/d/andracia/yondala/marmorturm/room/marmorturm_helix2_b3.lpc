  AddDetail( ({ "staub" }),
    BS("Ganz normaler Staub."));
  AddDetail( ({ "geruch" }),
    BS("Versuchs lieber mal mit riechen."));
  AddDetail( ({ "ambiente" }),
    BS("Das angenehme Licht das aus der Decke selbst zu kommen scheint, "+
