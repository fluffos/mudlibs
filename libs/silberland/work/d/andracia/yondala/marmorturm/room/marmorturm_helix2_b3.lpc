  AddDetail( ({ "zeit", "jahre" }),
    BS("Alleine ein bestimmtes "+
    "Buch zu suchen ist so absolut zwecklos: in dieser Menge an Buechern braucht man "+
    "bestimmt Jahre."));
  AddSpecialDetail( ({ "buch" }),
    "unt_buch");
  AddSpecialDetail( ({ "lesepult", "pult" }),
    "unt_pult");
  AddDetail( ({ "marmor" }),
    BS("Der ganze Turm schein aus Marmor zu bestehen."));
  AddDetail( ({ "licht", "beleuchtung" }),
    BS("Das Licht schein aus der Decke heraus zu kommen. Der Marmor leuchtet dort "+
