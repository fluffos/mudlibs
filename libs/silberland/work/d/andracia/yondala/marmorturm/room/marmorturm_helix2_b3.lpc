    BS("Auch hier besteht der Boden aus Marmor."));
  AddDetail( ({ "decke" }),
    BS("Die Decke scheint auch aus Marmor zu bestehen. Sie leuchtet von innen heraus "+
    "und erhellt damit den Raum mit einem angenehmen Licht."));
  AddDetail( ({ "waende", "wand" }),
    BS("An den Waenden stehen viele Regale die mit dicken Buechern und Folianten "+
    "bis oben hin vollbeladen sind."));
  AddSound( DEFAULT_SOUND,
    BS("Es hier besonders still."));
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht hier nach Staub. Ein typischer Geruch fuer eine Bibliothek."));

  AddDetail( ({ "bibliothek", "raum" }),
    BS("Dies ist die Bibliothek der Zaubererzunft. Hier findet man viele Folianten "+
    "die sich mit Zauberstaeben, Zauberspruechen und Legenden der Zauberei beschaeftigen. "+
    "Die Menge an vollgestellten Regalen ist ueberwaeltigend. Allein findet man sich "+
    "hier nicht zurecht."));
  AddDetail( ({ "zaubererzunft", "sitz" }),
    BS("Die Zaubererzunft hat hier im Marmorturm irgendwo ihren Sitz. "));
  AddDetail( ({ "folianten", "buecher" }),
    BS("Die Regale sind vollgestopft damit. Falls Du ein Buch lesen willst so frag den "+
    "Bibliothekar, er bringt Dir dann das gewuenschte Buch."));
  AddDetail( ({ "zauberstaebe", "zaubersprueche", "zauberei" }),
    BS("Viele Buecher hier in der Bibliothek handeln davon."));
  AddDetail( ({ "legenden", "legende" }),
    BS("In Geschichtsbuechern stehen viele unglaubliche Geschichten von Helden und "+
    "Herrschern. Vieles liegt schon so weit zurueck in der Zeit dass nur noch "+
    "Bruchstuecke der Geschichten eine unglaubliche Legende erzeugen." ));
  AddDetail( ({ "menge" }),
    BS("Die Menge an Buechern und Folianten ist ueberwaeltigend."));
  AddDetail( ({ "regale" }),
    BS("Die Regale sind gefuellt mit unmengen an Buechern und Folianten."));
  AddDetail( ({ "bibliothekar" }),
    BS("Der Bibliothekar scheint gerade nicht hier zu sein. Alleine ein bestimmtes "+
    "Buch zu suchen ist so absolut zwecklos: in dieser Menge an Buechern braucht man "+
