#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Treppe um den Marmorturm der Zauberer" );
  SetProp( P_INT_LONG,
     BS("Diese Marmortreppe scheint aus dem Marmor des Turm direkt "+
     "herausgeschlagen worden zusein. Sie schlaengelt sich um den "+
     "Turm der Zauberer. Ein hohes Gelaender aus Marmor auf der turmabgewandten "+
     "Seite der Turmes soll verhindern dass unvorsichtige Besucher in die Tiefe "+
     "stuerzen. Ueber das Gelaender hinweg hat man eine tolle Aussicht ueber das "+
     "umliegende Land. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "boden", "marmortreppe", "treppe", "treppenstufen", "stufen" }),
    BS("Die marmornen Treppenstufen sind breit und glatt. "));
  AddDetail( ({ "wand", "turm", "marmorturm", "zaubererturm", "marmorturms"}),
    BS("Diese Treppe schlaengelt sich um den Marmorturm der Zauberer. Es ist ein "+
    "unglaublich schlanker und hoher Turm. Viele bogenreiche Fenster und Tueren "+
    "unterbrechen die glatte, marmorne Oberflaeche des Turms. Dieses Bauwerk "+
    "scheint aus einem einzigen Stueck Marmor gemeisselt worden zu sein. "));
  AddSound( DEFAULT_SOUND,
    BS("Der Wind pfeifft durch das Gelaender und erzeugt ein summendes Geraeusch. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "gelaender", "gelaenders" }),
    BS("Das Gelaender scheint zusammen mit der Treppe aus einem einzigen Stueck "+
    "Marmor zu sein. Die geschwungenen Streben und der Handlauf des Gelaenders "+
    "sind mit vielen Verzierungen versehen. " ));
  AddDetail( ({ "marmor", "marmorne", "marmorner", "bauwerk", "werk" }),
    BS("Der ganze Turm scheint aus einem einzigen Stueck Marmor zu bestehen. "+
    "Es ist ein unglaubliches Bauwerk. Der hohe schmale Turm kann nicht das "+
    "Werk von einfachen Handwerkern sein, vielmehr muss man annehmen war Magie "+
    "der Bauherr. "));
  AddDetail( ({ "seite" , "aussenseite"}),
    BS("Der glatte Marmor des Turm begrenzt die Treppe zur einen Seite, das Gelaender "+
    "zur anderen Seite verhindert dass unvorsichtige Besucher in die Tiefe stuerzen. "));
  AddDetail( ({ "besucher", "besuch", "personen", "person" }),
    BS("Viele Besucher kommen hierher. Manche wollen die Dienste eines Zauberers "+
    "in Anspruch nehmen, andere wollen selbst das schwierige Studium der Magie "+
    "hier erlernen. Aber nur wenige werden aufgenommen in den Zirkel der Zauberer. "));
  AddDetail( ({ "tiefe", "hoehe", "absturz", "hoehen" }),
    BS("Das Gelaender trennt dich vor dem Absturz in die Tiefe. Scheinbar moegen "+
    "Zauberer luftige Hoehen. "));
  AddDetail( ({ "fenster" }),
    BS("Viele Fenster mit Boegen oder anderen Schnoerkeln unterbrechen die Aussenseite "+
    "des Marmorturms. Viele Zauberer scheinen hier im Turm zu wohnen. "));
  AddDetail( ({ "tueren" }),
    BS("Hin und wieder sind Tueren entlang der Treppe zu sehen. "));
  AddDetail( ({ "oberflaeche", "flaeche" }),
    BS("Der Marmor, aus dem der ganze Turm zu bestehen scheint, ist besonders glatt und "+
    "hat vorallem weiche und runde Verzierungen. "));
  AddDetail( ({ "stueck" }),
    BS("Es gibt hier kein untersuchbares 'Stueck'. "));
  AddDetail( ({ "glaette", "glatt", "handlauf" }),
    BS("Du streichst mit dem Finger ueber den Handlauf - sehr glatt!"));
  AddDetail( ({ "breite", "breit" }),
    BS("Die Treppe ist breit genug fuer drei Personen nebeneinander. Selbst mit einem "+
    "Pferd koennte man hier bequem heraufreiten. "));
  AddDetail( ({ "streben" }),
    BS("Weiche und geschwungene Streben stuetzen den Handlauf des Gelaenders. "));
  AddDetail( ({ "verzierungen", "boegen", "schnoerkel" }),
    BS("Alles scheint hier besonders filigran und geschwungen modelliert zu sein."));
  AddDetail( ({ "handwerker", "handwerkern" }),
    BS("Handwerker waren an diesem Bauwerk eher nicht beteiligt. "));
  AddDetail( ({ "magie", "studium" }),
    BS("Wenn Du dich auch dem Studium der Magie widmen willst so musst Du dich im "+
    "Saal der Zaubererzunft anmelden und darauf hoffen dass Du angenommen wirst. "));
  AddDetail( ({ "bauherr" }),
    BS("Magie war wohl der Bauherr dieses Turms. "));
  AddDetail( ({ "dienst", "dienste", "anspruch" }),
    BS("Ein paar Zauberer bieten hier den Besuchern ihre Dienste an. Ob es sich um "+
    "den Erwerb eines speziellen Schutzamuletts oder das Brechen eines Fluchs handelt, "+
    "fuer entsprechende Bezahlung bekommt man hier alles was die Zaubererzunft "+
    "bieten kann. "));
  AddDetail( ({ "zirkel", "zaubererzunft", "zunft", "saal", "zauberer", "sitz" }),
    BS("Die Zauberer sind in einer Zaubererzunft organisiert. Wenn Du mehr darueber "+
    "erfahren willst, so begib dich doch in den Saal der Zaubererzunft. "));
  AddDetail( ({ "finger" }),
    BS("Das ist dein Finger - gut geeignet zum Testen der Glaette des Marmors."));
  AddDetail( ({ "bezahlung", "geld", "erwerb" }),
    BS("Hast Du denn genug Geld bei dir?") );
  AddDetail( ({ "brechen", "fluch", "flueche" }),
    BS("Du kannst hier bestimmt Flueche die auf Dir lasten entfernen lassen.") );
  AddDetail( ({ "himmel", "wetter", "wolke" }),
    BS("Keine Wolke zu sehen, nur blauer Himmel weit und breit.") );

  AddSound( ({ "wind" }),
    BS("Der Wind verfaengt sich im Gelaender und erzeugt eun unstetiges Summen. "));
  AddSound( ({ "geraeusch", "geraeusche", "summen", "summendes" }),
    BS("Das summende Geraeusch koennte aber auch von etwas anderes herruehren. "));
  AddSound( ({ "etwas", "anderes" }),
    BS("Nein - es scheint doch nur der Wind zu sein der sich im Gelaender verfaengt. "));
 
  AddCmd( ({"teste", "testen"}), "CmdTesten");
}

int CmdTesten(string str) 
{
  notify_fail("Was willst Du testen?");
  if( str != "glaette" && str != "handlauf" && str != "" && str != "marmor" && str != "treppe") 
    return 0;
  write("Du streichst mit dem Finger ueber den Handlauf - sehr glatt!");
  say(capitalize(this_player()->name())+ " streicht mit dem Finger ueber den Handlauf. ");
  return 1;
}

