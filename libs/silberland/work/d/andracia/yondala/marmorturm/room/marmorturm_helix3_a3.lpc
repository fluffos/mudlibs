#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /* In jedem Treppenabschnitt anders! Umgebung? 
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Spezial \n" );
  AddDetail( ({ "tuer" }), //falls eine Tuer vorhanden
    BS(""));
  */
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Westen. "));
  AddDetail( ({ "umgebung", "land", "gelaende" }),
    BS("Von Suedwesten bis Westen erstreckt sich ein weites Grasland. Mittendrin "+
    "in dem grasbewachsenen Land kannst Du die hohen Tuerme eines Termitenbaus "+
    "erkennen. Im Suedwesten beginnt ein riesiger Wald. "));
  AddDetail( ({ "grasland" }),
    BS("Weites Grasland erstreckt sich von Suedwesten bis Westen."));
  AddDetail( ({ "termitenbau", "tuerme", "termitenhuegel", "huegel" }),
    BS("Was fuer riesige Termiten muessen dort hausen wenn man von hier aus ihren "+
    "Termitenbau sehen kann."));
  AddDetail( ({ "termiten", "wanderer", "punkte", "riesentermiten" }),
    BS("Selbst die Wanderer sind nur kleine sich bewegende Punkte. Auch die Riesentermiten "+
    "die das Grasland unsicher machen sind nur kleine Punkte - es ist kaum zu unterscheiden "+
    "welche Punkte Wanderer und welche Termiten sind. "));
  AddDetail( ({ "wald" }),
    BS("Im Suedwesten beginnt ein riesiger Wald. "));

  AddExit( "suedostoben" , ROOM + "marmorturm_helix3_b4.lpc");
  AddExit( "nordunten" , ROOM + "marmorturm_helix3_a2.lpc");

  AddExit( "suedosten" , ROOM + "marmorturm_helix3_b4.lpc");
  AddExit( "norden" , ROOM + "marmorturm_helix3_a2.lpc");
  SetProp( P_HIDE_EXITS, ({"norden", "suedosten"}) );
}
