#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Eine Tuer fuehrt hier ins Innere des Turms. Ein "+
    "hoelzernes Schild wurde ueberhalb der Tuer befestigt."));
  AddDetail( ({ "schild" }),
    BS("Es ist aus Holz und wurde ueberhalb der Tuer befestigt. "));
  AddReadDetail( ({ "schild" }),
    "+--------------+\n"+
    "| Gasthaus zum |\n"+
    "|Drachenfaenger|\n"+
    "+--------------+\n" );

  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Norden. "));
  AddDetail( ({ "umgebung", "land", "gelaende", "wald" }),
    BS("Von Nordwesten bis Nordosten erstreckt sich ein riesiger, dichter Wald. "));
  AddDetail( ({ "holz" }),
    BS("Das Schild ueber der Tuer ist aus ganz normalem Holz. "));
  AddDetail( ({ "tuer", "innere" }),
    BS("Eine Tuer fuehrt hier ins Innere des Turms."));

  AddExit( "westoben" , ROOM + "marmorturm_helix3_b1.lpc");
  AddExit( "suedostunten" , ROOM + "marmorturm_helix3_d2.lpc");
  AddExit( "rein", ROOM + "marmorturm_helix3_c2.lpc"); 

  AddExit( "westen" , ROOM + "marmorturm_helix3_b1.lpc");
  AddExit( "suedosten" , ROOM + "marmorturm_helix3_d2.lpc");
  SetProp( P_HIDE_EXITS, ({"westen", "suedosten"}) );
}
