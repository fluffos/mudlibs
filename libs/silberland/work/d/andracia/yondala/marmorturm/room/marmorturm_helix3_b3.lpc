// Dach
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Dach des Marmorturms" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich auf dem obersten Punkt des Marmorturms. "+
     "Eine grosse runde Plattform bildet hier den Abschluss des Turms. "+
     "Rundum hat man hier bei gutem Wetter eine grandiose Aussicht. "+
     "Das Gelaender wird nur im Sueden durch den Beginn der Treppe "+
     "unterbrochen. Am oestlichen Rand des Daches ist ein mannshoher "+
     "Monolith aus weissem Stein aufgestellt. "));
  SetProp( P_LIGHT, 1 ); 
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "boden", "untergrund", "grund", "plattform", "dach", "daches", "abschluss" }),
    BS("Der Marmor bildet rundum den Untergrund der Plattform. In der "+
    "Mitte des Daches wurde ein Mosaik aus bunten Steinen eingepasst. "));
  AddSound( DEFAULT_SOUND,
    BS("Der Wind pfeifft durch das Gelaender und erzeugt ein summendes Geraeusch. "));
  AddSmell( DEFAULT_SMELL,
    BS("Du kannst nichts besonderes riechen."));

  AddDetail( ({ "gelaender", "gelaenders" }),
    BS("Das Gelaender scheint zusammen mit der Treppe aus einem einzigen Stueck "+
    "Marmor zu sein. Die geschwungenen Streben und der Handlauf des Gelaenders "+
    "sind mit vielen Verzierungen versehen. " ));
  AddDetail( ({ "marmor", "marmorne", "marmorner", 
    "bauwerk", "werk", "turm", "marmorturm", "turms", "marmorturms" }),
    BS("Der ganze Turm scheint aus einem einzigen Stueck Marmor zu bestehen. "+
    "Es ist ein unglaubliches Bauwerk. Der hohe schmale Turm kann nicht das "+
    "Werk von einfachen Handwerkern sein, vielmehr muss man annehmen war Magie "+
    "der Bauherr. "));
  AddDetail( ({ "tiefe", "hoehe", "absturz", "hoehen", "rand" }),
    BS("Das Gelaender trennt dich vor dem Absturz in die Tiefe. Scheinbar moegen "+
    "Zauberer luftige Hoehen. "));
  AddDetail( ({ "oberflaeche", "flaeche" }),
    BS("Der Marmor, aus dem der ganze Turm zu bestehen scheint, ist besonders glatt und "+
    "hat vorallem weiche und runde Verzierungen. "));
  AddDetail( ({ "stueck" }),
    BS("Es gibt hier kein untersuchbares 'Stueck'. "));
  AddDetail( ({ "glaette", "glatt", "handlauf" }),
    BS("Du streichst mit dem Finger ueber den Handlauf - Sehr glatt!"));
  AddDetail( ({ "streben" }),
    BS("Weiche und geschwungene Streben stuetzen den Handlauf des Gelaenders. "));
  AddDetail( ({ "verzierungen", "boegen", "schnoerkel" }),
    BS("Alles scheint hier besonders filigran und geschwungen modelliert zu sein."));
  AddDetail( ({ "handwerker", "handwerkern" }),
    BS("Handwerker waren an diesem Bauwerk eher nicht beteiligt. "));
  AddDetail( ({ "magie", "studium" }),
    BS("Wenn Du dich auch dem Studium der Magie widmen willst so musst Du dich im "+
    "Saal der Zaubererzunft anmelden und darauf hoffen dass Du angenommen wirst. "));
  AddDetail( ({ "bauherr" }),
    BS("Magie war wohl der Bauherr dieses Turms. "));
  AddDetail( ({ "zirkel", "zaubererzunft" }),
    BS("Die Zauberer sind in einer Zaubererzunft organisiert. Wenn Du mehr darueber "+
    "erfahren willst, so begib dich doch in den Saal der Zaubererzunft. "));
  AddDetail( ({ "finger" }),
    BS("Das ist dein Finger - gut geeignet zum Testen der Glaette des Marmors."));
  AddSound( ({ "wind" }),
    BS("Der Wind verfaengt sich im Gelaender und erzeugt eun unstetiges Summen. "));
  AddDetail( ({ "punkt", "satzzeichen", "zeichen", "komma", "strich" }),
    BS("Sehr schoen - jetzt faengst Du schon an Satzzeichen zu untersuchen. Los "+
    "wenn du nun auch noch ein Semikolon untersuchst ..."));
  AddDetail( ({ "beginn", "treppe"}),
    BS("Im Sueden ist der Beginn der Treppe die sich von oben bis ganz nach unten "+
    "um den Turm herumschlaengelt. "));
  AddDetail( ({ "mitte" }),
    BS("Die Mitte von was? Die Mitte von dir scheint dein Bauchnabel zu sein. "));
  AddDetail( ({ "bauchnabel" }),
    BS("Hast Du nichts besseres zu tun?"));
  AddSound( ({ "geraeusch", "geraeusche", "summen", "summendes" }),
    BS("Das summende Geraeusch koennte aber auch von etwas anderes herruehren. "));
  AddSound( ({ "etwas", "anderes" }),
    BS("Nein - es scheint doch nur der Wind zu sein der sich im Gelaender verfaengt. "));
  AddDetail( ({ "himmel", "wetter", "wolke" }),
    BS("Keine Wolke zu sehen, nur blauer Himmel weit und breit.") );
  AddDetail( ({ "aussicht" }),
    BS("von hier aus kann man bis weit ins Land schauen."));
  AddDetail( ({ "monolith" }),
    BS("Der Monolith besteht aus weissem Stein - irgendwas ist seltsam an diesem Monolith. "));
  AddDetail( ({ "stein" }),
    BS("Scheint ein normaler Stein zu sein - irgendwas ist seltsam an diesem Monolith. "));
  AddDetail( ({ "mosaik", "gebilde" }),
    BS("Das Mosaik bildet ein sinnverwirrendes Gebilde. Du kannst leider nicht erahnen was es darstellen soll. "));
  AddDetail( ({ "saal", "raeume" }),
    BS("Der Saal der Zaubererzunft und viele andere Raeume befinden sich mehrere Etagen tiefer."));
  AddDetail( ({ "etagen" }),
    BS("Du hast leider nicht gezaehlt wieviele Etagen dieser Turm hat. Aber es sind wohl sehr viele."));
  AddDetail( ({"andracia", "land"}), 
    BS("So einfach laesst sich dieses Land im gesamten nicht erforschen.") );

  AddSpecialDetail( ({ "semikolon" }), "unt_scriptfalle" );
 
  AddCmd( ({"teste", "testen", "beruehre", "beruehr" }), "CmdTesten");
  
  AddCmd( ({"benuetze","benutze","durchschreite","betrete","trete"}), "CmdTeleporter");

  AddExit("suedunten", ROOM + "marmorturm_helix3_b4.lpc" );
  
  AddItem( "/gilden/zaubererzunft/npc/zz_pralecred.lpc", REFRESH_DESTRUCT );

  AddExit("sueden", ROOM + "marmorturm_helix3_b4.lpc" );
  SetProp( P_HIDE_EXITS, ({"sueden"}) );
}

string unt_scriptfalle()
{
	TP->SetProp( P_NOMOVE, "Ein Daemon hat Deine Fuesse festgenagelt.\n");
	write(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "Deine Fuesse am Boden fest."));
	say(BS("Ein gehoernter Daemon huscht herbei und nagelt mit unglaublicher Geschwindigkeit "+
	  "die Fuesse von "+TP->name()+" am Boden fest."));
  call_out( "free_me_now" , 45+random(60), TP );
  return "";
}

void free_me_now(object opfer)
{
	opfer->SetProp( P_NOMOVE, 0);
	write(BS("Die Naegel die deine Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
	say(BS("Die Naegel die "+opfer->name()+"'s Fuesse am Boden festgenagelt haben, loesen sich in Luft auf."));
}

int CmdTesten(string str) 
{
  notify_fail("Was willst Du testen?");
  if( str != "glaette" && str != "handlauf" && str != "" 
      && str != "marmor" && str != "mosaik" && str != "monolith" ) 
    return 0;
  if( str == "monolith" )
    {
      write(BS("Du versuchst mit dem Finger ueber den Monolith zu streichen - "+
      "er bietet ja gar keinen Widerstand! Dein Finger taucht tief in den Fels."));
      say(capitalize(this_player()->name())+ " steckt seinen Finger in den Monolith. \n");
      return 1;
    }
  if( str == "mosaik" )
    {
      write( BS("Du bueckst dich und streichst mit dem Finger ueber das Mosaik - "+
      "einfach nur verfugte kleine farbige Steine."));
      say( BS(capitalize(this_player()->name())+ " bueckt sich und streicht mit "+
      "dem Finger ueber das Mosaik. "));
      return 1;
    }
  write("Du streichst mit dem Finger ueber den Handlauf - Sehr gatt! \n");
  say(capitalize(this_player()->name())+ " streicht mit dem Finger ueber den Handlauf. \n");
  return 1;
}

int CmdTeleporter(string str) 
{
  notify_fail("Was willst Du benutzen?");
  if( str != "monolith" && str != "durch monolith" && str != "den monolith")  return 0;
  write("Du trittst in den Monolith und kommst "+
    "sofort am unteren Treppenbereich des Turms heraus. \n");
  TP->move(ROOM + "marmorturm_helix1_d3.lpc", M_TPORT, 
    "im Monolith","verschwindet","kommt aus dem Monolith heraus");
  return 1;
} 