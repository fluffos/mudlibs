#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + BS("Eine Tuer fuehrt hier ins Innere des Turms. Ein "+
    "Schild wurde ueberhalb der Tuer befestigt."));

  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Osten. "));
  AddDetail( ({ "umgebung", "land", "gelaende", "grenze" }),
    BS("Direkt im Osten ist die Grenze zwischen Wald und Bergauslaeufern zu sehen. "+
    "Im Suedosten sind erste groessere Bergauslaeufer und im Nordosten kannst Du dichten "+
    "Wald erkennen. "));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleine Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erahnen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man nur sehr wenige Spitzen des Bergmassivs sehen."));
  AddDetail( ({ "wald" }),
    BS("Im Nordosten erstreckt sich ein riesiger Wald. "));

  AddDetail( ({ "schild" }),
    BS("Es wurde ueberhalb der Tuer befestigt. "));
  AddReadDetail( ({ "schild" }),
    "+---------------------+\n"+
    "| Zaubereruebungssaal |\n"+
    "+---------------------+\n" );
  AddDetail( ({ "tuer", "innere" }),
    BS("Eine Tuer fuehrt hier ins Innere des Turms."));

  AddExit( "nordoben" , ROOM + "marmorturm_helix2_d2.lpc");
  AddExit( "suedwestunten" , ROOM + "marmorturm_helix2_c4.lpc");

  // AddSpecialExit( "rein" , "zz_test");
  AddExit( "rein", ROOM+"marmorturm_helix2_c3.lpc");

  AddExit( "norden" , ROOM + "marmorturm_helix2_d2.lpc");
  AddExit( "suedwesten" , ROOM + "marmorturm_helix2_c4.lpc");
  SetProp( P_HIDE_EXITS, ({"norden", "suedwesten"}) );
}

int zz_test(string dir)
{
  if ( this_player()->QueryProp(P_GUILD) != "zaubererzunft") {
    notify_fail("Magische Kraefte verhindern dass Du den Saal betrittst. \n");
    return 0;
  }
  return this_player()->move(ROOM + "marmorturm_helix2_c3.lpc", M_GO,0,
    "geht in den Uebungssaal", "kommt herein");
}
