//Zauberuebungssaal

#include "../def.h"

inherit "std/room";

#include <properties.h>

string *ueben = ({ "analys", "feuerball", "eispfeil", "wasserhose", "balsam", "piorun" });

mapping uebungen = 
  ([    "analys":({"Du versuchst einen kleinen Dolch zu untersuchen und kommst nur maessig zurecht.",
  	               "Dein Versuch eine kleine Tomate zu analysieren endet in Tomatensaft.",
  	               "Als Du den Holzknauf untersuchst liefert Dir deine Analyse er bestehe aus Eisen.",
  	               "Die kleine Glasfigur scheint nach deiner Analyse aus Kupfer zu bestehen.",
  	               "Die kleine ausgestopfte Tarantel ist deinem Zauber zufolge Dir haushoch ueberlegen.",
  	               "Dein Zauber liefert Dir keine Erkenntnisse dabei hast Du doch nur eine kleine Feder vor Dir liegen."}),
	   "feuerball":({"Dein Feuerball trifft die anvisierte Scheibe am Rand.",
	   	             "Der kleine Feuerball entgleitet deiner Kontrolle und schlaegt rechts in der Wand ein.",
	   	             "Dein kleiner Feuerball hat die nach rechts schwebende Scheibe verfehlt und schlaegt in die Wand dahinter ein.",
	   	             "Der klitzekleine Feuerball den Du erschaffen hast, erlischt auf halben Wege.",
	   	             "Du kannst deinen Feuerball fast genau in die Mitte einer stehenden Scheibe schleudern.",
	   	             "Dein Feuerball wird recht gross und frisst zwei Scheiben auf einmal."}),
      "eispfeil":({"Dein Eispfeil trifft eine bewegliche Scheibe am Rand und vereist diese.",
	   	             "Du versuchst einen grossen Eispfeil auf eine bewegliche Scheibe zu schleuudern aber verfehlst sie. ",
	   	             "Dein Eispfeil trifft die anvisierte, stehende Scheibe fast genau in der Mitte.",
	   	             "Du schleuderst einen Eispfeil auf eine bewegliche Scheibe aber der Eispfeil sakt ab und trifft nur den Boden. ",
	   	             "Dein kleiner Eispfeil trifft genau in die Mitte einer sich bewegenden Scheibe.",
	   	             "Leider schaffst Du es nicht einen Eispfeil auf die Reise zu schicken."}),
		"wasserhose":({"Deine Wasserhose verfehlt die Scheibe und schlaegt nutzlos gegen die Wand.",
	   	             "Deine Wasserhose schafft nicht mal die halbe Strecke bis zur anvisierten Scheibe und loest sich auf.",
	   	             "Du versuchst deine erschaffene Wasserhose zu lenken aber es misslingt dir und Du musst ansehen wie dein Zauber nutzlos an der Decke zerschellt.",
	   	             "Dein Zauber misslingt und nur ein paar Tropfen Wasser kommen aus deinem Zauberstab.",
	   	             "Du versuchst deiner Wasserhose einigen Effet mitzugeben aber dadurch veraendert sie die Bahn und du verfehlst dein anvisisertes Ziel.",
	   	             "Dein Wasserhase trifft mit voller Wucht die anvisierte Scheibe. "}),
		    "balsam":({"Die Wunden der Puppe schliessen sich nur unvollstaendig.",
	   	             "Deine Versuche die Wunden der Puppe zu heilen scheitern klaeglich, nicht einmal die kleinste Wirkung hast Du erzielt.",
	   	             "Die Wunden der Puppe schliessen sich langsam, dann bricht die Wunde wieder auf. Das war kein guter Versuch. ",
	   	             "Die Verbrennungen der Puppe verschwinden und normale Haut kommt wieder zum Vorschein.",
	   	             "Die schlimme Schnittwunde der Puppe wird von deinem Zauber getroffen und pulsiert nun. Heilung ist aber keine eingetreten.",
	   	             "Die Wunden der Puppe verheilen schnell und das Ergebnis kann sich sehen lassen."}),
        "piorun":({"Die von deinem Zauber getroffene Scheibe leuchtet kurz auf. Das scheint wohl ein Treffer gewesen zu sein.",
	   	             "Dein Zauber trifft eine stehende Scheibe und sie leuchtet auf. Nach ein paar Sekunden erlischt sie wieder.",
	   	             "Du versucht deinen Blendzauber auf eine sich bewegende Scheibe zu richten aber Du hast sie wohl verfehlt.",
	   	             "Dein Blendzauber trifft eine Scheibe und bringt diese fast eine Minute lang zum Leuchten.",
	   	             "Du versuchst deinen Blendzauber auf eine bewegliche Scheibe zu richten aber bis auf ein kurzes aufleuchten der Scheibe erre3ichst Du nichts.",
	   	             "Dein Blendzauber misslingt. "}) ]);


void create() 
{
  ::create();

  // wird umgestaltet fuer Zaubereibetrieb!
  SetProp( P_INT_SHORT, "Zaubereruebungssaal" );
  SetProp( P_INT_LONG,
     BS("Du befindest dich hier im Uebungssaal fuer Zauberer. "+
     "Hier kann man als Zauberer gefahrlos seine Sprueche ueben. "+
     "Hier ist der Marmor an vielen Stellen geschwaerzt. Allerlei nuetzliches "+
     "Uebungsgeraet steht hier herum und einen Bereich mit fliegenden "+
     "Zielscheiben kannst Du auch erkennen. " ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    BS("Neben den Geraeuschen von fliegenden Zielscheiben kann man hier nichts besonderes hoeren. "));
  AddSound( ({ "zielscheiben", "geraeusche", "geraeusch", "rauschen" }),
    BS("Die fliegenden Zielscheiben erzeugen ein Rauschen der Luft."));
  AddSmell( DEFAULT_SMELL,
    BS("Der Schweissgeruch der Uebenden ueberdeckt alles."));
  AddSmell( ({ "schweissgeruch", "geruch" }),
    BS("Die Uebenden schwitzen und daher kommt dieser penetrante Geruch."));

  AddDetail( ({ "boden" }),
    BS("Der Boden besteht aus normalem Marmor. An manchen Stellen ist er geschwaerzt oder hat "+
    "Risse bekommen. Man sieht dem Marmor einfach an dass hier mit Magie geuebt wird. "));
  AddDetail( ({ "decke" }),
    BS("Die Decke besteht aus normalem Marmor. An manchen Stellen ist er geschwaerzt oder hat "+
    "Risse bekommen. Man sieht dem Marmor einfach an dass hier mit Magie geuebt wird. "));
  AddDetail( ({ "waende", "wand" }),
    BS("Die Waende besteht aus normalem Marmor. An manchen Stellen ist er geschwaerzt oder hat "+
    "Risse bekommen. Man sieht dem Marmor einfach an dass hier mit Magie geuebt wird. "));
  AddDetail( ({ "zauberer", "bewohner" }),
    BS("Viele der Bewohner des Marmorturms sind Zauberer."));
  AddDetail( ({ "sprueche" }),
    BS("Fuer die Sprueche der Zauberer muesst ihr schon einen Ausbilder fragen oder euch direkt an den Vorsteher wenden."));
  AddDetail( ({ "marmor", "stellen", "risse" }),
    BS("An manchen Stellen ist er geschwaerzt oder hat "+
    "Risse bekommen. Man sieht dem Marmor einfach an dass hier mit Magie geuebt wird. "));
  AddDetail( ({ "uebungsgeraet", "gegenstaende" }),
    BS("Neben ungewoehnlichen Gegenstaenden die man durch Zauber untersuchen muss gibt es eine "+
    "Puppe mit Wunden die man mit Zauberei heilen kann. "));
  AddDetail( ({ "zielscheiben" }),
    BS("Mit diesen Zielscheiben kann man zielgerichtete Zauber wie Feuerball oder Eispfeil ueben."));
  AddDetail( ({ "puppe", "wunden" }),
    BS("Diese Puppe hat schlimm aussehnde Wunden die man mit Zauberei heilen kann. Allerdings ist "+
    "diese Puppe als Uebungsgeraet fuer die Zauberer gedacht und die Wunden entstehen immer wieder "+
    "nachdem man sie mit Zauber versorgt hat."));
  AddDetail( ({ "bereich" }),
    BS("Es gibt hier einen Bereich mit fliegenden Zielscheiben. Dort kann man wohl zielgerichtete "+
    "Zauber ueben."));
  AddDetail( ({ "ausbilder", "stabkampfausbilder" }),
    BS("Laurenzio Furlani ist hier der Stabkampfausbilder. Er kann Dir sicher einiges beantworten."));
  AddDetail( ({ "uebenden", "platz" }),
    BS("Hier hat es genuegend Platz zum ueben."));
  AddDetail( ({ "vorsteher", "versammlungshalle", "zaubererzunft" }),
    BS("Der Vorsteher der Zaubererzunft befindet sich sicher in der Versammlungshalle."));
  AddDetail( ({ "raum", "halle", "uebungssaal", "saal", "zaubereruebungssaal" }),
    BS("Hier im Uebungssaal kann man als Zauberer gefahrlos seine Sprueche ueben. "+
     "Hier ist der Marmor an vielen Stellen geschwaerzt. Allerlei nuetzliches "+
     "Uebungsgeraet steht hier herum und einen Bereich mit fliegenden "+
     "Zielscheiben kannst Du auch erkennen. "));
  AddDetail( ({ "eispfeil", "feuerball", "zauber", "magie", "zauberei" }),
    BS("Eispfeil und Feuerball sind Zauber der Zauberer die man hier ueben kann."));
  AddDetail( ({ "marmorturm", "turm" }),
    BS("Du befindest dich hier innerhalb des Marmorturms im Uebungssaal."));

/*
  AddDetail( ({ "" }),
    BS(""));
*/

  /*Ueben*/
  AddCmd( ({"uebe", "ueben"}), "cmd_ueben" );
  // AddCmd( ({"abbruch"}), "cmd_abbruch" );

  /*Objekte und NPCs*/
  AddItem( NPC + "laurenzio.lpc", REFRESH_DESTRUCT ); // Stabkampfausbilder

  /* Exits */
  AddExit( "raus" , ROOM + "marmorturm_helix2_d3.lpc");

}

int cmd_ueben(string str)
{
	notify_fail("Ihr seid kein Zauberer der hier zaubern ueben darf.\n");
	if( TP->QueryProp(P_GUILD) != "zaubererzunft" ) return 0;
	notify_fail("Welchen Zauber wollt ihr ueben?\n");
	if( !str ) return 0;
	notify_fail("Welchen Zauber wollt ihr ueben? Folgende Zauber koennt ihr hier ueben: \n"+
	            "Analys, Feuerball, Eispfeil, Wasserhose, Balsam und Piorun.\n");
	if( member( ueben, str )==-1 ) return 0;
	notify_fail("Diesen Zauber musst Du erst einmal lernen.\n");
	if( TP->QuerySkillAbility(str)==0 ) return 0;	
	notify_fail("Diesen Zauber kannst Du hier nicht mehr verbessern.\n");
	if( TP->QuerySkillAbility(str) > 4000 ) return 0;	
	notify_fail("Du bist doch aber gerade schon mit etwas beschaeftigt.\n");
	if( TP->QueryProp(P_NOMOVE) ) return 0;
  // erstmal P_NOMOVE setzen.
 	TP->SetProp( P_NOMOVE, 
 	  BS("Du uebst doch aber gerade den Zauberspruch "+capitalize(str)+". ") );
 	  // Du kannst deine Uebungen abbrechen mit \'abbruch\'. ") );
	write("Du uebst nun den Zauberspruch "+capitalize(str)+".\n");
	say(TP->name()+" uebt den Zauberspruch "+capitalize(str)+".\n");
	// Nun Uebung starten. (4mal)
  call_out("ueben", 3, TP, str, 3);
	return 1;
}

int cmd_abbruch(string str)
{
  remove_call_out("ueben"); 
	TP->SetProp( P_NOMOVE, 0);
	write("Du hoerst auf zu ueben.\n");  
	say(TP->name()+" hoert auf zu ueben.\n");
	return 1;
}


void ueben(object uebender, string zauber, int dauer)
{
	string *liste;
	liste=uebungen[zauber];  
	tell_object(uebender,BS(liste[random(sizeof(liste))]));
	tell_room(TO, uebender->name()+" uebt den Zauber "+capitalize(zauber)+".\n",({uebender}) );
	
	if( dauer != 0 )
		call_out("ueben", 3, uebender, zauber, dauer-1);
	else
		call_out("uebung_ende", 2, uebender, zauber);
}

void uebung_ende(object uebender, string zauber)
{
  uebender->LearnSkill(zauber, 101+random(200) );
	tell_object(uebender, BS("Deine Uebungen waren erfolgreich.") );
	tell_room(TO, uebender->name()+" hoert auf zu ueben.\n",({uebender}) );
	uebender->SetProp( P_NOMOVE, 0);	
}