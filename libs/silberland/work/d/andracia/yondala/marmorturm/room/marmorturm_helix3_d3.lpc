#include "../def.h"

inherit ROOM + "marmorturm_raw.lpc";

#include <properties.h>

void create() 
{
  ::create();

  /* In jedem Treppenabschnitt anders! Umgebung? 
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Spezial \n" );
  AddDetail( ({ "tuer" }), //falls eine Tuer vorhanden
    BS(""));
  */
  AddDetail( ({ "aussicht", "sicht" }),
    BS("Du hast hier eine gute Sicht ueber die naehere Umgebung im Osten. "));
  AddDetail( ({ "umgebung", "land", "gelaende", "grenze" }),
    BS("Direkt im Osten ist die Grenze zwischen Wald und Bergauslaeufern zu sehen. "+
    "Im Suedosten sind erste groessere Bergauslaeufer und im Nordosten kannst Du dichten "+
    "Wald erkennen. "));
  AddDetail( ({ "berge", "bergauslaeufer" }),
    BS("Kleine Berge kann man von hier aus erkennen. Dahinter kann man die Spitzen "+
    "eines grossen Bergmassivs erahnen."));
  AddDetail( ({ "spitzen", "bergmassiv" }),
    BS("Von hier aus kann man nur sehr wenige Spitzen des Bergmassivs sehen."));
  AddDetail( ({ "wald" }),
    BS("Im Nordosten erstreckt sich ein riesiger Wald. "));

  AddExit( "nordoben" , ROOM + "marmorturm_helix3_d2.lpc");
  AddExit( "suedwestunten" , ROOM + "marmorturm_helix3_c4.lpc");

  AddExit( "norden" , ROOM + "marmorturm_helix3_d2.lpc");
  AddExit( "suedwesten" , ROOM + "marmorturm_helix3_c4.lpc");
  SetProp( P_HIDE_EXITS, ({"norden", "suedwesten"}) );
}
