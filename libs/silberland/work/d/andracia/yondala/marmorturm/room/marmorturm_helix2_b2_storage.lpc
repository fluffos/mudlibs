inherit "std/store.lpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

reset() {
  ::reset();
  if( sizeof(all_inventory()) < 8 )
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_random_1.lpc", REFRESH_NONE );
}

create()
{
  ::create();
  SetProp (P_LIGHT, 1);   
  SetProp (P_INDOORS, 1); 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:14]));
  SetProp( P_INT_SHORT, "Dies ist das Lager von Hugen Borax's Laden" ); 
  SetProp( P_INT_LONG,  "Dies ist das Lager von Hugen Borax's Laden. \n"
  "Hier verstaut er all sein Zauberstaebe." );
 
  // AddItem( "file", refresh, Props);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_cold.lpc", REFRESH_NONE);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_fire.lpc", REFRESH_NONE);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_heal.lpc", REFRESH_NONE);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_ore.lpc", REFRESH_NONE);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_water.lpc", REFRESH_NONE);
  AddItem( "gilden/zaubererzunft/weapon/wand_kl_shadow.lpc", REFRESH_NONE);
}
