inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void init()
{
   ::init();
   if (this_player() && this_player()->id("marmorturmbewohner")) AddDefender(this_player());
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
    
  AddId(({"marmorturmbewohner"})); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "ein Marmorturmbewohner");
  SetProp( P_LONG, "ein ganz normaler Marmorturmbewohner");
  SetProp( P_NAME, "Marmorturmbewohner");
  SetProp( P_GENDER, MALE);
  SetProp( P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_RACE, "Mensch");
  SetProp( P_SIZE, 178); //in cm
  SetProp( P_WEIGHT, 78000); //in g
  SetProp( P_ALIGN, 0); //Gesinnung von -1000 bis +1000
  SetProp( P_MAX_HANDS, 2); //Anzahl Haende
  SetProp( P_HEAL, 0); //Essbarkeit von -4 bis +4
  // SetProp( P_AGGRESSIVE, ([0:0.0]); //nicht aggressiv
  SetProp( P_WIMPY, 0); //nicht flüchten
  SetProp( P_NOMAGIC, 0); //keinen Magiewiderstand
  SetProp( P_RESISTANCE_STRENGTHS ,  //Widerstand gegen Schadentypen -1 (immun) bis +1 (doppelt)
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER: -0.2, DT_AIR:   -0.2, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.5, DT_SOUND: -0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   -0.2]) );
  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES); // Bewegungsmöglichkeiten
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MURDER_MSG, "%s hat mich getoetet!");
  SetProp( P_KILL_NAME, "Marmorturmbewohner"); //string für Todessequenz
  SetProp( P_KILL_MSG, "HIHI - ich habe %s getoetet!");
  //  SetProp( P_LOG_FILE, LOG + "npc_logfile");
  SetProp( P_LOG_INFO, "missing_answers"); // Logfile fuer unbeantwortete Fragen
  SetProp( P_REJECT, ({ REJECT_DROP, QueryProp(P_NAME)+"will Deine Sachen nicht tragen.\n" }) );
  
  //Antworten
  AddInfo( DEFAULT_INFO, "Da bin ich ueberfragt.", "sagt: ");
  AddInfo( "yason", "Yason hat mich erschaffen.", "sagt: ");
  AddInfo( "yondala", "Yondala ist die Liebste von Yason.", "sagt: ");
  AddInfo( "nyx", "Belldandy hilft Yondala und Yason.", "sagt: ");
  
  
  AddInfo( ({"edorian", "edorian zwirbelstein"}), 
    "Das ist der Name des Freiherrn von Zwirbelstein. Seine Burg steht ein gutes Stueck westwaerts. ","sagt: ");

  AddInfo( ({"hilfe"}), 
    "Ich kann Dir auch nicht helfen. ","sagt: ");
  AddInfo( ({"quest"}), 
    "Tut mir leid. Ich habe keine Arbeit fuer dich. ","sagt: ");
  AddInfo( ({"burg", "zwirbelstein"}), 
    "Die Burg Zwirbelstein ist der Sitz des Freiherrn von Zwirbelstein. ","sagt: ");
  AddInfo( ({"welt", "andracia"}), 
    "Diese Welt wird Andracia genannt. ","sagt: ");
  AddInfo( ({"essen", "trinken"}), 
    "Fuer die Verpflegung kannst Du hier im Marmorturm die Gasthaeuser aufsuchen. ","sagt: ");
  AddInfo( ({"liebe"}), 
    "Die Liebe ist ein Geschenk. Halt Sie fest wenn Du sie findest. ", "sagt: ");
  AddInfo( ({"stabkampf"}), 
    "Laurenzo Furlani kennt sich mit dem Stabkampf aus. Geht zu ihm wenn Ihr etwas darueber lernen wollt.", "sagt: ");
  AddInfo( ({"zauberstab", "zauberstaebe", "stab", "zauberstaebe"}),
    "Bei Hugen Borax kann man gute Zauberstaebe kaufen. Auch kann er Euch sagen was ein Zauberstab "+
    "alles kann und wieviel er wert ist.", "sagt: ");
  AddInfo( ({}),
    "", "sagt: ");  
}

void InformDefend(object enemy)
{
    Kill(enemy);
}