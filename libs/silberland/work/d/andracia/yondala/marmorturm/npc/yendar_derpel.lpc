// Wirt vom unteren Gasthaus
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "marmorturmbewohner.lpc";

mapping fieser_moep;
string rues = "/d/huegelland/yason/zwirbelstein/armour/";
string ruestung1 = rues+"lederweste_2.lpc";
string ruestung2 = rues+"lederhose_2.lpc"; 
string axt = "/d/gebirge/yason/thumfels/weapon/kampfaxt_2.lpc";

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"yendar", "derpel", "Yendar Derpel" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Yendar Derpel, der Wirt");
  SetProp( P_LONG, "Dies ist Yendar Derpel, der Wirt vom unteren Gasthaus im Marmorturm");
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Yendar Derpel");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM + "marmorturm_helix1_b3.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "marmorturm_helix1_b3.lpc" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Wirt"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Yendar Derpel bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");

  /*Infos zur Speisekarte*/
  AddInfo( ({"quellwasser", "wasser"}), 
    "Das koennt ihr bei mir bestellen. Es gibt nichts besseres als ein kuehles Glas Wasser nach einer "+
    "langen Reise durch die Wueste.",
    "sagt: ");
  AddInfo( ({"wein", "rotwein"}), 
    "Ich importiere meinen Rotwein von den Iberianischen Inseln.",
    "sagt: ");
  AddInfo( ({"bier", "steppenbier"}), 
    "Die Teiheb haben eine ungewoehnliche Art und Weise Bier zu brauen. Ich verstehe zwar nicht wie Sie "+
    "dieses Gebraeu herstellen, aber man muss es einfach mal probiert haben.",
    "sagt: ");
  AddInfo( ({"pflaumenbrannt", "brannt"}), 
    "Mein Onkel brennt dieses leckere Troepfchen in seinem Keller. Er wuesste sonst auch gar nicht wohin "+
    "mit seinen vielen Pflaumen.",
    "sagt: ");
  AddInfo( ({"saft", "kakteensaft", "maguskakteensaft", "kaktus"}), 
    "Die Maguskakteen sind erstaunliche Pflanzen. Ich bin meines Wissens der Einzige weit und breit der "+
    "weiss, wie man eine Maguskaktee zubereiten muss. Ob als Saft oder gebraten, der Maguskaktus ist "+
    "ein Genuss der ganz besonderen Art.",
    "sagt: ");
  AddInfo( ({"bein", "huehnerbein"}), 
    "Diese Huehnerbeine kann ich nur empfehlen. Besonders die Steppengewuerze erzeugen einen besonderen Geschmack.",
    "sagt: ");
  AddInfo( ({"eintopf", "termiten", "termiteneintopf"}), 
    "Die Termiten sind ein Plage. Warum sollten Sie nicht auch fuer was gutes wie einen Eintopf nuetze sein?",
    "sagt: ");
  AddInfo( ({"haxe", "schweinshaxe"}), 
    "Auf unserem Grill wird die Haut der Haxe besonders kross. Das duerft ihr euch nicht entgehen lassen.",
    "sagt: ");

  /*Ausruestung*/
  SUID;
  CLONEME( ruestung1 );
  CLONEME( ruestung2 );
  command("trage alles");
  CLONEME( axt );
  command("zuecke axt");
  
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
