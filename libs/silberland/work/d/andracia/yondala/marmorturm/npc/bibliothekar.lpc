// Bibliothekar
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "marmorturmbewohner.lpc";

mapping fieser_moep;

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"bibliothekar", "/nbibliothekar" })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Bibliothekar");
  SetProp( P_LONG, BS("Dies ist der Bibliothekar. Er besorgt Dir die Buecher die Du wuenschst. "));
  SetProp( P_GENDER, MALE);
  // SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Bibliothekar");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM + "marmorturm_helix2_b3.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "marmorturm_helix2_b3.lpc" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Bibliothekar"); //string für Todessequenz
 
  //Chats
  SetAttackChats( 5, ({"Der Bibliothekar bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"buch", "buecher"}), "Ja, ich kann euch diverse Buecher bringen sobald ihr am Pult steht.", "sagt: ");
  AddInfo( ({"stabkampf"}), "Ihr koennt hier im Uebungssaal den Stabkampf lernen und ueben. Laurenzio Furlani kann euch sicher weiterhelfen.", "sagt: ");
  AddInfo( ({"grundlagen", "basics"}), "Unsere Bibliothek umfasst neben Geschichtsbuechern und Romanen, vorallem theoretische Abhandlungen "+
    "ueber Andracia und die Voelker Andracias. Fuer die Buecher des taeglichen Lebens ist die Bibliothek in Zwirbelstein besser ausgestattet.", "sagt: ");
  AddInfo( ({"zauberstab", "zauberstaebe"}), "Ueberall in Andracia kann man wohl Zauberstaebe finden. Hier im Marmorturm ist auch ein Haendler "+
    "fuer Zauberstaebe. ", "sagt: ");
  AddInfo( ({"pult"}), "Ihr muesst euch vor den Pult stelle um ein Buch zu lesen. Sagt mir einfach welches Buch ich euch besorgen soll. ", "sagt: ");
  AddInfo( ({"buch", "index"}), "Schaut einfach im Index welche Buecher verfuegbar sind. Stellt Euch an den Pult und ich kann euch den Index besorgen. ", "sagt: ");
  AddInfo( ({"eskimos", "eskimo", "indianer", "wikinger", "teiheb", "zwerge", "zwerg",
  	         "waldelf", "waldelfen", "elf", "elfen", "blauelf", "blauelfen", "mensch", 
  	         "menschen", "troll", "trolle", "kobold", "kobolde", "pirat", "piraten", 
  	         "zauberer", "zaubererzunft", "oger", "gebiete", "gebiet", "andracia"}), 
  	"Mhm - ich glaube schon dass es hierfuer ein Buch in unserer Bibliothek hat. Schaut einfach im Index und ich besorge euch das entsprechende Buch.", "sagt: ");
  AddInfo( ({""}), "", "sagt: ");

  //Spells
  AddSpell(9,100,
	         "Der Bibliothekar greift Dich mit einem kleinen Feuerball an.\n",
	         "Der Bibliothekar greift @WEN mit einem kleinen Feuerball an.\n",
	         ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,180,
	         "Der Bibliothekar greift Dich mit einem riesigen Feuerball an.\n",
	         "Der Bibliothekar greift @WEN mit einem riesigen Feuerball an.\n",
	         ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
 
  /*Ausruestung
  SUID;
  CLONEME( ARMOUR + ".lpc" );
  CLONEME( ARMOUR + ".lpc" );
  command("trage alles");
  CLONEME( WEAPON + ".lpc" );
  command("zuecke haken");
  */
}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
