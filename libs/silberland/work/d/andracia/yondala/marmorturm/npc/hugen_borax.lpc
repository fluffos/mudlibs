// Wirt vom unteren Gasthaus
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

inherit NPC + "marmorturmbewohner.lpc";

mapping fieser_moep;
string zauberstab = "/gilden/zaubererzunft/weapon/wand_kl_random_1.lpc";
string ruestung1 = "/d/gebirge/yason/thumfels/armour/eisenpanzer_1.lpc";
string ruestung2 = "/d/huegelland/yason/zwirbelstein/armour/stoffumhang.lpc"; 

void reset()  {
  ::reset();
  fieser_moep = ([]); // Man ist Dir nur bis zum reset boese.
}

void create() {
  if (!is_clone(TO)) return; //Abbruch für Blueprint
  ::create(); //Ausführen von Create in Inherit "std/mnpc"
  
  create_default_npc(18); //erstellt Standartwerte für NPC des Level x

  //Properties
  AddId(({"hugen", "borax", "Hugen Borax", "\nhugenborax"  })); //Bezeichner zur Interaktion
  SetProp( P_SHORT, "Hugen Borax, Ladenbesitzer und Zauberer");
  SetProp( P_LONG, BS("Dies ist Hugen Borax. Er handelt nur mit Zauberstaeben. Er selbst ist auch ein ganz passabler Zauberer. "));
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_NAME, "Hugen Borax");
  SetProp( P_WIMPY, 0); //Fluchtschwelle an HP
  SetProp( P_MNPC_AREA, ROOM + "marmorturm_helix2_b2.lpc" ); // Bereichsangabe für Bewegung
  SetProp( P_MNPC_DEFAULTROOM, ROOM + "marmorturm_helix2_b2.lpc" ); // Startpunkt
  SetProp( P_MNPC_FLAGS, MOV_INDOORS ); // Bewegungsmöglichkeiten
  SetProp( P_KILL_NAME, "Ladenbesitzer"); //string für Todessequenz
  SetProp( P_SPELLRATE, 25);
 
  //Chats
  SetAttackChats( 5, ({"Hugen Borax bruellt: Dir werd ichs zeigen! \n" }) ); // rate in%

  AddInfo( QueryProp(P_IDS), "Das bin ich! ", "sagt: ");
  AddInfo( ({"zauberstab", "zauberstaebe", "stab", "zauberstaebe"}),
    "Nur bei mir findet ihr die wirklich guten Zauberstaebe.", "sagt: ");

  //Spells
  AddSpell(4,100,
	         "Hugen Borax greift Dich mit einem kleinen Feuerball an.\n",
	         "Hugen Borax greift @WEN mit einem kleinen Feuerball an.\n",
	         ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,180,
	         "Hugen Borax greift Dich mit einem riesigen Feuerball an.\n",
	         "Hugen Borax greift @WEN mit einem riesigen Feuerball an.\n",
	         ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
  AddSpell(4,85,
	         "Hugen Borax greift Dich mit einem kleinen Froststrahl an.\n",
	         "Hugen Borax greift @WEN mit einem kleinen Froststrahl an.\n",
	         ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
	AddSpell(1,150,
	         "Hugen Borax greift Dich mit einem harten Froststrahl an.\n",
	         "Hugen Borax greift @WEN mit einem harten Froststrahl an.\n",
	         ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

  /*Ausruestung*/
  SUID;
  CLONEME( ruestung1 );
  CLONEME( ruestung2 );
  command("trage alles");
  CLONEME( zauberstab );
  command("zuecke stab");

}


// Reactions (werden von außen gestartet)

void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, getuid(this_player()) ) )
        {
        fieser_moep+=([getuid(this_player()):1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[getuid(this_player()),0]++;
        if(fieser_moep[getuid(this_player()),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
