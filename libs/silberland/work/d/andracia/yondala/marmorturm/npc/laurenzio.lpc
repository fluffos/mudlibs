  AddInfo( ({"beitritt"}), "Unser Zunftvorsteher Goliath Kupferfeldt ist fuer Beitritte zustaendig. "+
    "Auch bringt er Euch gegebenenfalls neue Zauber in Grundlagen bei.", "sagt: ");
  AddInfo( ({"stab"}), "Mit einem Stab zu kaempfen ist nicht einfach. So manchen Knueppel "+
    "kann man auch schon als Stab bezeichnen.", "sagt: ");
  AddInfo( ({"einzelkaempfer", "kaempfer"}), 
    "Zauberer sind passable Einzelkaempfer. ", "sagt: ");

  /* Uebung
  AddInfo( ({""}), "", "sagt: ");
  */
 
  /*Ausruestung*/
  SUID;
  CLONEME( ruestung1 );
  CLONEME( ruestung2 );
  command("trage alles");
  CLONEME( zauberstab );
  command("zuecke stab");
}

// Reactions (werden von außen gestartet)
void StartReaction(string verb, string gruppe, string adverb, int touch) { 
  if (find_call_out("reaction") != -1) return; 
  switch (gruppe) { 
    case "aengstlich": 
      call_out("reaction", 0, TP,  
        "sagt: Du brauchst keine Angst haben. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst keine Angst haben. \n"); 
      break; 
    case "aergerlich": 
      call_out("reaction", 0, TP, 
        "sagt: Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Du brauchst gar nicht zu schimpfen, Du bist selbst schuld an allem. \n"); 
      break; 
    case "albern": 
      call_out("reaction", 0, TP, 
        "sagt: Lass doch bitte den Blödsinn. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Lass doch bitte den Blödsinn. \n"); 
      break; 
    case "fies":
      if( !member(fieser_moep, this_player()->name()) )
        {
        fieser_moep+=([this_player()->name():1]);
        call_out("reaction", 0, TP, 
          "sagt: Wenn du das nochmal machst, werd ich boese. \n", 
          "sagt zu " + capitalize(this_player()->name()) + ": Wenn du das nochmal machst, werd ich boese. \n"); 
        break; 
        }
      else
        {
        fieser_moep[this_player()->name(),0]++;
        if(fieser_moep[this_player()->name(),0] >= 3)
          {
          call_out("reaction", 0, TP, 
            "sagt: Das war zuviel! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Das war zuviel. \n"); 
            call_out ("Attack", 3, TP);
            break;
          }
        else
          {
          call_out("reaction", 0, TP, 
            "sagt: Letzte Warnung! \n", 
            "sagt zu " + capitalize(this_player()->name()) + ": Letzte Warnung! \n"); 
          break;
          }
        }  
    case "frech": 
      call_out("reaction", 0, TP, 
        "sagt: He - Was soll das? \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": He - Was soll das? \n"); 
      break; 
    case "froh": 
      call_out("reaction", 0, TP, 
        "grinst.",  
        "grinst."); 
      break; 
    case "intim": 
      call_out("reaction", 0, TP, 
        "sagt: Bitte such Dir jemand anderes für sowas. \n", 
        "sagt zu " + capitalize(this_player()->name()) + ": Bitte such Dir jemand anderes für sowas. \n"); 
      break; 
    case "nett": 
      call_out("reaction", 0, TP, 
        "laechelt Dir zu. \n", 
        "laechelt " + capitalize(this_player()->name()) + " freundlich an \n"); 
      break; 
    case "neutral": 
      call_out("reaction", 0, TP, 
        "zieht die Stirn kraus.", 
        "zieht die Stirn kraus."); 
      break; 
    case "traurig": 
      call_out("reaction", 0, TP, 
        "troestet dich. \n", 
        "troestet " + capitalize(this_player()->name()) + ". \n"); 
      break; 
  } 
} 

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string akteur, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+akteur));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void die(int poisondeath) {
	if( find_call_out("ueben")!=-1 ) {
		remove_call_out("ueben"); 
	  uebender->SetProp( P_NOMOVE, 0);
    tell_room(environment(TO), 
   	  BS(TO->name()+" kann die Uebung mit "+uebender->name()+ " nicht mehr abschliessen."));
  }
	if( find_call_out("ausbilden")!=-1 ) {
		remove_call_out("ausbilden"); 
	  uebender->SetProp( P_NOMOVE, 0);
    tell_room(environment(TO), 
   	  BS(TO->name()+" kann die Ausbildung mit "+uebender->name()+ " nicht mehr abschliessen."));
  }
  ::die(poisondeath);
}