  AddInfo( ({"balsam"}), break_string("Mit dem zauber Balsam koennen alle Wunden geheilt werden.", 45), "sagt: ");
  AddInfo( ({"piorun"}), break_string("Ein Zauberer der Piorun gegen einen Feind anwendet, blendet diesen Gegner "+
    "fuer eine gewisse Zeit.", 45), "sagt: ");
  // Schatten
  AddInfo( ({"schwaechezauber"}), break_string("Ein Gegner der Ziel eines Schwaechezaubers geworden ist schlaegt "+
