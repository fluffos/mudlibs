  AddInfo( ({"seelengift"}), break_string("Seelengift ist ein Zauber der dem Feind eines Zauberer langsam "+
    "seine Lebensenergie entzieht.", 45), "sagt: ");
  AddInfo( ({"teleportiere"}), break_string("Mit Teleportation kann jeder Zauberer sich an die verschiedensten Orte "+
    "in Andracia bewegen, und dass in in einer Sekunde zur anderen." , 45), "sagt: ");
  // Elementare
  AddInfo( ({"feuerelementar", "eiselementar", "wasserelementar", "erzelementar" }), break_string("Ein Elementarwesen "+
    "wird den Befehlen des Zauberers gehorchen und alles in seiner Macht stehende tun um seinen Befehlen zu genuegen. "+
    "nur wenige Zauberer schaffen es Elementare zu erzeugen. ", 45), "sagt: ");
    
  AddInfo( ({"ausbildungsstart"}), #'ausbildungsstart, "sagt: ");
  AddInfo( ({"ausbildungsstand"}), #'ausbildungsstand, "sagt: ");
  AddInfo( ({"uebung", "ueben", "lernen"}), #'uebung, "sagt: ");
  AddInfo( ({"abbruch"}), #'abbruch, "sagt: ");

  AddInfo( ({"stabkampf", "kampf", "ausbildung", "grundlagen"}), "Da seid Ihr bei mir an der richtigen Stelle. "+
    "Wenn ich Euch die Grundlagen des Stabkampfs beibringen soll, so fragt mich "+
    "einfach nach dem Ausbildungsstart. Wenn ich beurteilen soll, wie gut Ihr Euch "+
    "im Stabkampf macht, so fragt mich nach dem Ausbildungsstand. Falls Ihr mit mir ueben wollt, "+
