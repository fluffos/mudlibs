
#include "../def.h"
inherit "std/room";
#include <properties.h>

int frucht;

void init() 
{
	call_out ("warnung", 30);
  ::init();
}

void reset()
{
	frucht=random(5);
	if(frucht==0)  AddDetail( ({ "frucht" }),"Leider haengt gerade keine in Deiner Naehe."); 
	else	AddDetail( ({ "frucht" }), "Sie ist zum Greifen nah."); 
	::reset();
	}

void create() 
{
  ::create();
frucht=3;
  SetProp( P_INT_SHORT, "An einen Ast geklammert" );
  SetProp( P_INT_LONG,
    "Du befindest Dich nun mitten in der Krone eines maechtigen Baumes. Um "
    "Dich herum sind lauter Aeste und Blaetter, sonst kannst Du nicht viel "
    "erkennen. Du bist Dir sicher, dass Du Dich hier oben nicht lange halten "
    "kannst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "ast" }),
    "Du klammerst Dich fest an einen Ast um nicht herunter zu fallen.");    
  AddDetail( ({ "krone", "baumkrone" }),
    "Du befindest Dich in der Krone eines maechtigen Baumes.");    
  AddDetail( ({ "baum" }),
    "Bei dem Baum, auf welchem Du sitzt, scheint es sich um einen Obstbaum zu handeln.");    
  AddDetail( ({ "laub", "blaetter", "aeste" }),
    "Viel mehr als Aeste und Blaetter siehst Du nicht. Lediglich direkt vor "
    "Dir baumelt eine reife Frucht.");    
  AddDetail( ({ "frucht" }),
    "Sie ist zum Greifen nah.");    
  AddDetail( ({ "boden", "waldboden" }),
    "Der Waldboden ist weit unter Dir. Du kannst hinunter klettern.");    
  AddDetail( ({ "greifen" }),
    "Allerdings bist Du Dir sicher, dass Du runter faellst solltest Du den "
    "Ast loslassen. Dir bleibt wohl nicht anderes uebrig als in die Frucht zu beissen.");    

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau die Sonne blinzelt ab und zu durch die Blaetter des Baumes.");    
  AddDetail( ({ "obstbaum" }),
    "Du bist Dir ziemlich sicher, dass dies ein Obstbaum ist, denn Du kannst "
    "einige Fruechte an den Aesten haengen sehen.");    
  AddDetail( ({ "fruechte" }),
    "Die Fruechte des Baumes schillern bunt und verbreiten einen verlockenden Duft.");    
  AddDetail( ({ "sonne" }),
    "Die Sonne blinzelt nur ab und zu durch die Blaetter hindurch.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Rauschen des Meeres in der Ferne.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald, ausserdem verwoeht der suesse Duft der bunten Fruechte Deine Nase.");

  AddSmell( ({ "duft","fruechte" }),
    "Die Fruechte riechen herlich frisch und suess.");
/*  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
*/
  AddCmd( ({ "pflueck", "pfluecke", "greife","greif" }), "cmd_pfluecken" );
  AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
  AddCmd( ({ "beisse", "beiss" }), "cmd_beissen" );
}

kletternCmd(string str )
{
  notify_fail( "Wo moechtest Du hinklettern?\n" );
  if( str == "runter"||str == "hinunter" )
  {
  	TP->move(CAN_ROOM + "caniba_8g.lpc", M_GO,
  	"","klettert runter","kommt von einem Baum geklettert");
		write("Du kletterst den Baum hinunter.\n");
    //say( TPN+" kommt von einem Baum herunter geklettert.\n");
    return 1;
  }
  return 0;
}

int cmd_pfluecken(string str)
{
  notify_fail( "Was moechtest Du pfluecken?\n" );
  if( str == "frucht"||str == "fruechte"||str=="nach frucht"||str=="nach fruechte" )
  {
  	TP->move(CAN_ROOM + "caniba_8g.lpc", M_GO,
  	"","faellt vom Baum","faellt von einem Baum");
		write("Du laesst los, verlierst den Halt und faellst vom Baum.\n");
    TP->AddHp(-5);
    return 1;
  }
  return 0;
}

int cmd_beissen(string str)
{
  notify_fail( "Worein moechtest Du beissen?\n" );
  if( str == "frucht"||str=="in frucht" )
  {
  	if (frucht==0) write ("Es haengt gerade keine Frucht in Deiner Naehe.\n");
  	if(frucht>0)
  		{
  			if (this_player()->eat_food(1))//bisschen Saettigung muss sein
  				{
  					write("Du beugst Dich vor und beisst genuesslich in die leckere Frucht.\n");
    		    say( TPN+" beugt sich vor und beisst in eine Frucht.\n");
    		    TP->AddHp(10);
    		    TP->AddSp(10);
    		    frucht--;
    		    if (frucht==0)  AddDetail( ({ "frucht" }),"Leider haengt gerade keine in Deiner Naehe."); 
				    else   AddDetail( ({ "frucht" }),"Vor Dir baummelt eine angegessene Frucht. Sie ist zum Greifen nah.");
						}			
					}
   	return 1;
  }
  return 0;
}


warnung()
{
  if (TP && interactive(TP) && TO==environment(TP))
  	{
  		write("Du merkst, dass Deine Arme Dich wohl nicht mehr lange halten koennen.\n");
			call_out("plumms", 5);
		}
}

plumms()
{
	if (TP && interactive(TP) && TO==environment(TP))
	 	{
	 		TP->move(CAN_ROOM + "caniba_8g.lpc", M_GO,
  		"","faellt vom Baum","faellt von einem Baum");
			write("Du kannst Dich nicht mehr halten und faellst vom Baum.\n");
    	TP->AddHp(-5);
	} 
}