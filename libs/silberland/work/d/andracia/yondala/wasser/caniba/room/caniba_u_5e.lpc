//Idee: Hoehlenmalerei, Knochen auf dem Boden, aber Art Polster oder Thron


#include "../def.h"
inherit "std/room";
#include <properties.h>

int tierchen;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einer relativ runden Hoehle. Hier ist es sehr dunkel, aber "
    "durch Deine Lichtquelle kannst Du einiges erkennen. Die Waende bestehen "
    "aus Fels und sind an einigen Stellen mit Kratzern uebersaeht. Der Boden "
	"ist dick mit Stroh gepolstert und ueberall liegen Knochen herum und in "
	"der Mitte des Raumes brennt ein kleines Feuer.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer kleinen, runden Hoehle.");    
   AddDetail( ({ "boden" }),
    "Du stehst auf relativ weichem Stroh welches hier grosszuegig auf dem "
    "harten Fels verteilt wurde. Ausserdem liegen sehr viele Knochen herum.");    
  AddDetail( ({ "felsen","fels" }),
    "Der Fels ist grau, und hart.");    
  AddDetail( ({ "lichtquelle" }),
    "Offensichtlich besitzt Du eine. Oder Du kannst im Dunkeln sehen. Wie auch immer, Du siehst etwas.");    
  AddDetail( ({ "knochen" }),
    "Hier liegen sehr viele, hauptsaechlich grosse Knochen herum und Du "
    "ahnst, dass hier wohl sehr oft groessere Wirbeltiere verspeist werden.");    
  AddDetail( ({ "wirbeltiere" }),
    "Du siehst nur deren Knochen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen hier aus nacktem Fels, der aber einige merkwuerdige Kratzer aufweisst.");    
  AddDetail( ({ "himmel" }),
    "Den siehst Du hier sicherlich nicht.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus blankem Fels. Einige Fledermaeuse baumeln traege von der Decke.");    
  AddDetail( ({ "fledermaeuse" }),
    "Die Fledermaeuse baumeln traege von der Decke.");    
  AddDetail( ({ "kratzer" }),
    "Es sieht fast so aus, als waeren hier Krallen geschaerft worden. An einigen "
	"Stellen jedoch scheinen die Kratzer nicht willkuerlich gesetzt worden zu sein.");    
  AddDetail( ({ "dunkeln" }),
    "Hier ist es normalerweise sehr dunkel. Gut, dass Du was sehen kannst.");    
  AddDetail( ({ "stellen" }),
    "Als Du genauer hinsiehst, erkennst Du tatsaechlich Bilder und Zeichnungen an den Waenden.");    
  AddDetail( ({ "bilder" }),
    "Ganz eindeutig, es hat jemand Bilder in die Waende gekratzt. Du siehst Darstellungen "
	"verschiedener Kreaturen, Pflanzen und sogar Landschaften.");    
  AddDetail( ({ "kreaturen" }),
    "Du siehst kleine dicke Kreaturen auf zwei Beinen. Vermutlich handelt es sich dabei um die "
	"Caniber, die Dir schon auf dieser Insel begegnet sind.");    
  AddDetail( ({ "caniber" }),
    "Die Caniber an den Waenden sind in verschiedenen Szenen mit anderen Lebewesen dargestellt.");    
  AddDetail( ({ "szenen" }),
    "Du sieht einige Jagdszenen, ein paar Gemeinschaftsszenen, Essensszenen und auch "
	"Begegnungsszenen mit anderen Zweibeinern.");    
  AddDetail( ({ "jagdszenen" }),
    "In den Jagdszenen schleichen kleine dicke Kreaturen auf zwei Beinen hinter verschiedenen "
	"Tieren her. Manche Kreatur hat dabei einen Speer oder einen Knueppel dabei.");    
  AddDetail( ({ "caniber" }),
    "Die Caniber bewohnen die Insel, auf der Du Dich derzeit befindest.");    
  AddDetail( ({ "beine" }),
    "Die Caniber laufen auf zwei Beinen.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich gerade auf einer Insel, auch wenn Du das nicht siehst, weil Du Dich in "
	"einer Hoehle auf jener Insel aufhaeltst.");    
  AddDetail( ({ "darstellungen" }),
    "Du siehst diverse Tiere, Zweibeiner, Pflanzen und Landschaften dargestellt an den Waenden.");    
  AddDetail( ({ "tiere" }),
    "Die Tiere werden in den Darstellungen von Canibern gejagt.");    
  AddDetail( ({ "gemeinschaftsszenen" }),
    "In den Gemeinschaftsszenen siehst Du Caniber zusammen um ein Lagerfeuer sitzen, andere "
	"scheinen um eine Art Anfuehrer versammelt, der etwas erhoehnt steht und wieder andere "
	"schwimmen im Wasser in mitten von riesigen Fischen.");    
  AddDetail( ({ "lagerfeuer" }),
    "In einer der Gemeinschaftsszenen ist ein grosses, loderndes Lagerfeuer abgebildet, "
	"um welches sich einige Caniber versammelt haben.");    
  AddDetail( ({ "zweibeiner" }),
    "Es sind die unterschiedlichsten Rassen zu erkennen.");    
  AddDetail( ({ "rassen" }),
    "Du staunst, mit wievielen Rassen die Caniber schon Bekanntschaft gemacht haben.");    
  AddDetail( ({ "erste" }),
    "Offensichtlich waren schon einige vor Dir hier, sonst wuerden die Caniber nicht "
	"so viele verschiedene Rassen kennen und zeichnen koennen.");   
  AddSpecialDetail( ({ "bekanntschaft"  }), "bekanntschaft" );	

  AddDetail( ({ "pflanzen" }),
    "Die wenigsten der Pflanzen kannst Du wirklich identifizieren. So gut wurden sie nicht "
	"gezeichnet. Aber es sind definitiv Pflanzen.");    
  AddDetail( ({ "art" }),
    "So was in der Art. Jemand, der was zu sagen hat.");    
  AddDetail( ({ "anfuehrer" }),
    "Durch die Art der Darstellung, laesst sich dieser eine Caniber als Anfuehrer identifizieren.");    
  AddDetail( ({ "wasser" }),
    "Nun, bei dem Wasser handelt es sich vermutlich um das Wasser, welches diese Insel umgibt.");    
  AddDetail( ({ "fische" }),
    "Du vermutest, dass die Fische eher unproportional gezeichnet wurden. So grosse Fische wie sie hier "
	"dargestellt wurden, gibt es hoffentlich nicht in den Gewaessern rund um diese Insel.");    
  AddDetail( ({ "gewaesser" }),
    "Die Insel ist von Wasser umgeben.");    
  AddDetail( ({ "essensszenen" }),
    "In den Essensszenen sitzen und luemmeln die Caniber auf dem Boden und essen Obst und Fleisch.");    
  AddDetail( ({ "obst" }),
    "Ach, wie gesund die Caniber hier doch leben!");    
  AddDetail( ({ "fleisch" }),
    "So viele Tiere hast Du hier gar nicht gesehen, woher kommt also das Fleisch? Und vorallem "
	"die eine dicke Fleischkeule, die einer der Caniber in der Hand haelt?");    
  AddDetail( ({ "fleischkeule","keule" }),
    "Das sieht irgendwie wie ein Bein aus.");    
  AddDetail( ({ "bein" }),
    "Puh, sogar der Fuss ist daran zu erkennen.");    
   AddSpecialDetail( ({ "fuss"  }), "fuss" ); 
  AddDetail( ({ "hand" }),
    "Was haelt er da in der Hand?");    
  AddDetail( ({ "landschaften" }),
    "Du meinst, diese Insel zu erkennen, aber auch ein paar Waelder und andere, fremde Gegenden.");    
  AddDetail( ({ "gegenden" }),
    "Die Caniber scheinen nicht nur auf ihrer Insel zu hocken, sondern auch auf Reisen zu gehen.");    
  AddDetail( ({ "reisen" }),
    "Wenn einer eine Reise tut, dann kann er was erzaehlen. Oder, wie hier, Bilder in Waende kratzen.");    
  AddDetail( ({ "reise" }),
    "Du befindest Dich auch gerade auf einer Reise.");
  AddDetail( ({ "krallen" }),
    "Die Kratzer an den Waenden zeugen davon, dass hier schon oft Krallen gewetzt wurden. ");
  AddDetail( ({ "waelder" }),
    "Keiner der Waelder kommt Dir bekannt vor. Vermutlich sind sie nicht naturgetreu in die "
	"Waende gekratzt worden. Schade, waere interessant gewesen zu erfahren, wo die Caniber "
	"schon ueberall waren.");
  AddDetail( ({ "zeichnungen" }),
    "Nun gut, es sind eher rudimentaere Bilder, dennoch ist einiges ziemlich gut zu erkennen.");
  AddDetail( ({ "stroh" }),
    "Der Boden ist dick mit Stroh gepolstert, sodass man sehr gedaempft laeuft und auch die "
	"meisten Geraeusche werden verschluckt.");
  AddDetail( ({ "geraeusche" }),
    "Man kann keine Geraeusche sehen.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Hoehle liegt kein Stroh, dafuer brennt dort ein kleines Feuer. ");
  AddDetail( ({ "feuer" }),
    "Das Feuer ist recht klein und durch ein paar Steine von dem herumliegenden "
	"Stroh getrennt.");
  AddDetail( ({ "steine" }),
    "Einige Steine trennen das Feuer vom Stroh. Brandschutz sieht anders aus, aber "
	"es scheint ja zu funktionieren.");
  AddDetail( ({ "brandschutz" }),
    "Vermutlich haben die Caniber hier noch nie von Brandschutz gehoert.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hin und wieder hoerst Du das Prasseln des Feuers, ansonsten ist es sehr still.");

  AddSound( ({ "feuer","prasseln" }),
    "Das Feuer prasselt leise vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig, das Stroh scheint nicht mehr ganz frisch zu sein.");

  AddSmell( ({ "stroh" }),
    "Anscheinend wurde es lange nicht gewechselt.");
  AddSmell( ({ "feuer","rauch" }),
    "Das Feuer riecht angenehm rauchig.");
  AddSmell( ({ "" }),
    "");

//  AddRoomMessage( 
 //   ({""}),30,"func");

AddItem(CAN_NPC + "caniberhaeuptling.lpc",REFRESH_DESTRUCT);
AddItem(CAN_NPC + "caniber.lpc",REFRESH_DESTRUCT);
AddItem(CAN_NPC + "caniber.lpc",REFRESH_DESTRUCT);


	
AddExit( "osten", CAN_ROOM + "caniba_u_5f.lpc" ); 

}

string bekanntschaft()
{
	if (TP->QueryProp(P_GENDER)==2) return("Du bist anscheinend nicht die Erste hier.\n");
		
  return ("Du bist anscheinend nicht der Erste hier.\n");
}
string fuss()
 {
	 if(TP->QueryProp(P_RACE)=="Fee")
		return ("Sieht aus wie der Fuss von einer Fee. Dir wird ein bisschen schlecht.\n");
	 
	 return ("Sieht aus wie der Fuss von einem "+TP->QueryProp(P_RACE)+". Dir wird ein bisschen schlecht.\n");
	}
