/*Auf einem Birnbaum
  Hier kann man bis zu drei Biernen pfluecken, nach 35 Sekunden faellt man vom Baum	
*/
#include "../def.h"
inherit "std/room";
#include <properties.h>

int frucht;

void init() 
{
//	call_out ("warnung", 30);
  ::init();
}

void reset()
{
	frucht=2;

	::reset();
	}

void create() 
{
  ::create();
frucht=3;
  SetProp( P_INT_SHORT, "An einen Ast geklammert" );
  SetProp( P_INT_LONG,
    "Du befindest Dich nun mitten in der Krone eines maechtigen Birnbaums. Um "
    "Dich herum sind lauter Aeste und Blaetter, sonst kannst Du nicht viel "
    "erkennen. Du bist Dir sicher, dass Du Dich hier oben nicht lange halten "
    "kannst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "ast" }),
    "Du klammerst Dich fest an einen Ast um nicht herunter zu fallen.");    
  AddDetail( ({ "krone", "baumkrone" }),
    "Du befindest Dich in der Krone eines maechtigen Baumes.");    
  AddDetail( ({ "baum" }),
    "Bei dem Baum, auf welchem Du sitzt, scheint es sich um einen Birnbaum zu handeln. "
	"Zumindest weisen die auf ihm wachsenden Birnen darauf hin.");    
  AddDetail( ({ "laub", "blaetter", "aeste" }),
    "Du bist vom Laub umgeben, dazwischen haengen einige reife Birnen.");    
  AddDetail( ({ "birnen" }),
    "Die Birnen sehen herrlich lecker aus.");    
  AddDetail( ({ "boden", "waldboden" }),
    "Der Waldboden ist weit unter Dir. Du kannst hinunter klettern.");    

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau die Sonne blinzelt ab und zu durch die Blaetter des Baumes.");    
 
  AddDetail( ({ "fruechte" }),
    "Die Fruechte des Baumes schillern bunt und verbreiten einen verlockenden Duft.");    
  AddDetail( ({ "sonne" }),
    "Die Sonne blinzelt nur ab und zu durch die Blaetter hindurch.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Rauschen des Meeres in der Ferne.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald, ausserdem verwoeht der suesse Duft der bunten Fruechte Deine Nase.");

  AddSmell( ({ "duft","fruechte" }),
    "Die Fruechte riechen herlich frisch und suess.");
/*  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
*/
  AddCmd( ({ "pflueck", "pfluecke", "greife","greif" }), "cmd_pfluecken" );
  AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );

}

kletternCmd(string str )
{
  notify_fail( "Wo moechtest Du hinklettern?\n" );
  if( str == "runter"||str == "hinunter" )
  {
  	TP->move(CAN_ROOM + "caniba_7f.lpc", M_GO,
  	"","klettert runter","kommt von einem Baum geklettert");
		write("Du kletterst den Baum hinunter.\n");
    //say( TPN+" kommt von einem Baum herunter geklettert.\n");
    return 1;
  }
  return 0;
}

int cmd_pfluecken(string str)
{
	object ob;
	int farbe;
  notify_fail( "Was moechtest Du pfluecken?\n" );
	if(str=="birne"||str=="birnen")
	{
		if(frucht)
		{
			write("Du flueckst eine Birne und steckst sie ein.\n");
			say(TPN+" pflueckt eine Birne und steckt sie ein.\n",TP);
			ob=clone_object("/d/andracia/yondala/friedheim/obj/obst_birne");
			farbe=random(4);
			if(farbe==0) 
			{
				ob->SetProp(P_NAME_ADJ,({"roetlich"}));
				ob->SetProp(P_SHORT,"Eine roetliche Birne");
				ob->SetProp(P_LONG,BS("Diese Birne ist roetlich und reif. Es wird bestimmt ein Genuss sein sie zu verspeisen. "));
							}
			else if(farbe==1) 
			{
				ob->SetProp(P_NAME_ADJ,({"golden"}));
				ob->SetProp(P_SHORT,"Eine goldene Birne");
				ob->SetProp(P_LONG,BS("Diese Birne ist goldgelb und reif. Es wird bestimmt ein Genuss sein sie zu verspeisen. "));
     
			}
			if(farbe==2) 
			{
				ob->SetProp(P_NAME_ADJ,({"gruen"}));
				ob->SetProp(P_SHORT,"Eine gruene Birne");
				ob->SetProp(P_LONG,BS("Diese Birne ist gruen und reif. Es wird bestimmt ein Genuss sein sie zu verspeisen. "));
			}
			if(farbe==3) 
			{
				ob->SetProp(P_NAME_ADJ,({"gelb"}));
				ob->SetProp(P_SHORT,"Eine gelbe Birne");
				ob->SetProp(P_LONG,BS("Diese Birne ist gelb und reif. Es wird bestimmt ein Genuss sein sie zu verspeisen. "));
			}


			frucht--;
				ob->move(TP,M_GET);			
		}
		else write("Es ist kein Apfel in greifbarer Naehe.\n");
	
    return 1;
    
  }
  return 0;
}



warnung()
{
  if (TP && interactive(TP) && TO==environment(TP))
  	{
  		write("Du merkst, dass Deine Arme Dich wohl nicht mehr lange halten koennen.\n");
			call_out("plumms", 5);
		}
}

plumms()
{
	if (TP && interactive(TP) && TO==environment(TP))
	 	{			
		write("Du kannst Dich nicht mehr halten und faellst vom Baum.\n");
	 		TP->move(CAN_ROOM + "caniba_7f.lpc", M_GO,
  		"","faellt vom Baum","faellt von einem Baum");

    	TP->AddHp(-5);
	} 
}