inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Kakerlake");
  SetProp(P_LONG,
    "Du siehst eine kleine, schwarze Kakerlake die hier eifrig herum rennt.");
  SetProp(P_NAME, "Kakerlake");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kakerlake"}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren Armen und Beinen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ungeziefer");
  SetProp(P_SIZE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "kommt angetrippelt");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/wasser/yondala/caniba") );
  SetProp(P_MNPC_WAIT, ({ 5, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, CAN_ROOM "/d/andracia/yondala/wasser/caniba/caniba_5e.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS |MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " liegt ploetzlich auf dem Ruecken und ruehrt sich nicht mehr.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Kakerlake");

  AddInfo(DEFAULT_INFO, "piepst.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Ratte ist viel zu klein um Deine Sachen zu tragen.\n" }) );

}

// Mitloggen wenn einen Spieler den CAN_NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

