//Hier wohnt der Nachwuchs der Caniber

#include "../def.h"
inherit "std/room";
#include <properties.h>

int tierchen;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In eine kleinen Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einer kleinen, runden Hoehle. Hier ist es sehr dunkel, aber "
    "durch Deine Lichtquelle kannst Du einiges erkennen. Die Waende sind hier "
    "aus Fels. Der Boden ist dick mit Fellen gepolstert und ueberall liegen Knochen herum.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer kleinen, runden Hoehle. Sie scheint hauptsaechlich "
	"natuerlichen Ursprungs zu sein, wurde aber erweitert, sodass sie ihre "
	"jetzige, runde Form erhielt.");    
   AddDetail( ({ "boden" }),
    "Du stehst auf weichen Fellen, zwischen denen ueberall Stroh hervor guckt. "
	"Jemand hier scheint es den Bewohnern weich und gemuetlich gemacht zu haben. "
    "Ausserdem liegen sehr viele Knochen auf den Fellen verteilt.");    
  AddDetail( ({ "felsen","fels" }),
    "Der Fels ist grau und hart.");    
  AddDetail( ({ "lichtquelle" }),
    "Offensichtlich besitzt Du eine.");    
  AddDetail( ({ "knochen" }),
    "Hier liegen sehr viele, hauptsaechlich kleine Knochen herum und Du "
    "ahnst, dass hier wohl sehr oft kleinere Wirbeltiere verspeist werden.");    
  AddDetail( ({ "wirbeltiere" }),
    "Du siehst nur deren Knochen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen hier aus nacktem Fels, der aber an vielen Stellen "
	"rot gefaerbt ist.");    
  AddDetail( ({ "himmel" }),
    "Den siehst Du hier sicherlich nicht.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus blankem Fels. Einige Fledermaeuse baumeln traege von der Decke.");    
  AddDetail( ({ "fledermaeuse" }),
    "Die Fledermaeuse baumeln traege von der Decke.");    
  AddDetail( ({ "kratzer" }),
    "Es sieht fast so aus, als waeren hier Krallen geschaerft worden.");    
  AddDetail( ({ "stellen" }),
    "An einigen Stellen sind die Waende rot. Die Farbe scheint nicht willkuerlich "
	"angebracht worden zu sein, sondern Bilder zu ergeben.");    
  AddDetail( ({ "farbe" }),
    "Es scheint sich dabei um Blut zu handeln.");    
  AddSpecialDetail( ({ "blut"  }), "blut" );	
  AddSpecialDetail( ({ "blumen"  }), "blumen" );
  AddDetail( ({ "bilder" }),
    "Die Bilder an den Waenden zeigen kleine dicke Maennchen mit Tieren und Blumen.");    
  AddDetail( ({ "maennchen" }),
    "Die Maennchen sind eher rudimentaer gezeichnet, vermutlich von ungeuebten Haenden.");    
  AddDetail( ({ "haende" }),
    "Haende muessen erst lernen, wie man schoene Bilder malt. Kleine Haende koennen "
	"das nicht immer sofort.");    
  AddDetail( ({ "tiere", "tier" }),
    "Welche Tiere es genau sind, kannst Du nicht sagen. Die Meisten haben vier Beine, "
	"ein paar haben Hoerner.");    
  AddDetail( ({ "beine" }),
    "Vier Beine zu haben deutet meistens auf ein Tier hin.");    
  AddDetail( ({ "meisten" }),
    "Nun, nicht alle. Da war der Kuenstler wohl nicht sehr genau.");    
  AddDetail( ({ "kuenstler" }),
    "Wer das wohl war?");    
  AddDetail( ({ "blumen" }),
    "Du erkennst definitiv ein paar Blumen an den Waenden. Saehe huebsch aus, "
	"wenn sie nicht mit Blut gemalt worden waeren.");    
  AddDetail( ({ "form" }),
    "Die Hoehle ist nahezu perfekt rund.");    
  AddDetail( ({ "felle" }),
    "Auf dem Boden liegen weiche Felle herum. Sie sind in unterschiedlichen "
	"Stadien der Verwesung.");    
  AddDetail( ({ "stadien" }),
    "Manche der Felle sind relativ frisch, andere liegen hier schon laenger.");    
  AddDetail( ({ "verwesung" }),
    "Was lebt, das stirbt, was stirbt, das verwest. Und hier ist schon einiges "
	"gestorben beziehungsweise gestorben worden.");    
  AddDetail( ({ "stroh" }),
    "Zwischen Knochen und Fellen liegt Stroh auf dem Boden, um diesen weich "
	"zu polstern.");    
  AddDetail( ({ "ursprung" }),
    "Urspruenglich war die Hoehle wohl nicht ganz rund, da hat jemand nachgeholfen.");    
  AddDetail( ({ "hoerner" }),
    "Einige der dargestellten Tiere haben Hoerner. Aber eher willkuerlich, ohne auf "
	"eine bestimmte Gattung hinzuweisen.");    
  AddDetail( ({ "gattung","gattungen" }),
    "Du kannst keine Gattungen definieren.");    
  AddDetail( ({ "bewohner" }),
    "Die Bewohner dieser Hoehle scheinen eher jung zu sein.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hier drin ist es absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig, vermutlich zirkuliert die Luft in der Hoehle schlecht. "
	"Ausserdem riechst Du Blut, altes Stroh und gammeliges Fell.");

  AddSmell( ({ "luft" }),
    "Die Luft in der Hoehle ist sehr abgestanden.");
  AddSmell( ({ "hoehle" }),
    "Es riecht in der Hoehle etwas muffig.");
  AddSmell( ({ "felle","fell","geruch" }),
    "Die Felle riechen stark nach Verwesung.");
  AddSmell( ({ "verwesung" }),
    "Du nimmst einen suesslich-beissenden Geruch wahr.");
  AddSmell( ({ "stroh" }),
    "Das Stroh riecht nicht mehr frisch.");
  AddSmell( ({ "" }),
    "");

//  AddRoomMessage( 
 //   ({""}),30,"func");

AddItem(CAN_NPC + "caniberjunges.lpc",REFRESH_DESTRUCT);
AddItem(CAN_NPC + "caniberjunges.lpc",REFRESH_DESTRUCT);
AddItem(CAN_NPC + "caniberjunges.lpc",REFRESH_DESTRUCT);
	
AddExit( "suedosten", CAN_ROOM + "caniba_u_5f.lpc" ); 

}



string rasse()
 {
	  	return ("Du weisst aber schon, dass Du "+TP->QueryProp(P_RACE)+" bist, oder?\n");
	}

string blut()
 {
	  	if(TP->QueryProp(P_GUILD)=="rekromanten") return ("Du denkst . o (Lecker, Blut!)\n");
		return ("Du erschauerst, das ist ja widerlich!\n");
	}
string blumen()
 {
	  	if(TP->QueryProp(P_GUILD)=="rekromanten") return ("Sehen huebsch aus, diese Blumen aus Blut.\n");
		return ("Du erkennst definitiv ein paar Blumen an den Waenden. Saehe huebsch aus, "+
				"wenn sie nicht mit Blut gemalt worden waeren.\n");
	}	