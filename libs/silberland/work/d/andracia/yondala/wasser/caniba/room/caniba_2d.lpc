/*29.06.2022 Yondala@SilberLand
Man kann hier versuchen, nach oben zu klettern, entdeckt dann ein leeres Vogelnest.
*/
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem schmalen Weg, der um einen sehr hohen Berg "
    "herumfuehrt. Neben Dir schwappen die Wellen des Meeres gegen den Fels, "
    "aber die wenigsten davon sind hoch genug um den Boden zu ueberschwemmen."
    "Der Weg gabelt sich hier. Nach Suedwesten fuehrt er auf eine kleine "
    "Sandbank, nach Osten und Sueden fuehrt er weiter um den Berg herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "sandbank" }),
    "Suedwestlich von Dir befindet sich eine Sandbank.");    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind heute nicht besonders stark, sie schwappen sanft gegen "
    "die Felsen unter Dir und nur hin und wieder schafft es eine "
    "groessere Welle Deine Fuesse zu benetzen.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem schmalen, felsigen Weg, der aber nach Suedwesten hin sandig wird.");    
  AddDetail( ({ "fels" }),
    "Der Fels ist grau, hart und etwas feucht und glitschig. Pass auf, dass "
    "Du nicht ausrutscht.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich ausser nach Osten in alle Richtungen. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist hinter dem Berg verschwunden.");    
  AddDetail( ({ "osten" }),
    "Nach Osten kannst Du weiter auf dem schmalen Weg um den Berg laufen.");    
  AddDetail( ({ "sueden" }),
    "Nach Sueden kannst Du weiter auf dem schmalen Weg um den Berg laufen.");    
  AddDetail( ({ "suedosten" }),
    "Im Suedosten gelangst Du auf eine kleine Sandbank.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer felsigen Insel.");    

  AddDetail( ({ "berg" }),
    "Du stehst direkt neben einem riesiegen, steilen Berg auf einem Weg der "
    "sich eng an dessen Rand entlang schlaengelt. In der Bergwand siehst "
	"Du einige Furchen und Vertiefungen.");    
  AddDetail( ({ "weg" }),
    "Der Weg auf dem Du stehst gabelt sich hier und ist daher etwas breiter. "
    "Du kannst ihm nach Osten, Sueden und Suedosten folgen.");    
  AddDetail( ({ "seite","rand" }),
    "Du befindest Dich am unteren Rand des Berges, also an seiner Seite.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau, die Sonne allerdings ist hinter dem "
    "Berg verschwunden, deswegen ist es hier auch merklich kuehler.");    
  AddDetail( ({ "wasser" }),
    "Das Meer neben Dir besteht hauptsaechlich aus Wasser.");    
  AddDetail( ({ "furchen" }),
    "Du fragst Dich, ob diese Furchen natuerlich oder kuenstlich sind.");    
  AddDetail( ({ "vertiefungen" }),
    "Die Vertiefungen sind ganz schoen gross. Ob man an ihnen nach oben klettern kann?");    
  AddDetail( ({ "vertiefung" }),
    "In einer der Vertiefungen entdeckst Du ein kleines Vogelnest.");    
  AddDetail( ({ "vogelnest","nest" }),
    "Gut, dass Du da nicht drauf getreten bist. Es ist zwar nichts darin, aber wer weiss, "
	"ob es nicht doch bewohnt ist.");    
  AddDetail( ({ "bergwand","wand" }),
    "Die Wand des Berges ist glatt, bis auf einige Furchen und Vertiefungen.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");

  AddSound( ({ "plaetschern","wellen" }),
    "Die Wellen plaetschern leise gegen die Felswand unter Dir.");  
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
AddExit( "suedwesten", CAN_ROOM + "caniba_3c.lpc" ); 
AddExit( "sueden", CAN_ROOM + "caniba_3d.lpc" ); 
AddExit( "osten", CAN_ROOM + "caniba_2e.lpc" ); 
AddCmd( ({ "klettere","kletter", "klettre" }), "klettern" );
}

int klettern(string str)
{
	notify_fail("Woran moechtest Du nach oben klettern?\n");
	if(str!="nach oben"&&str!="hoch"&&str!="hinauf"&&str!="herauf"&&
	str!="an vertiefungen nach oben"&&str!="an vertiefungen hoch"&&
	str!="an vertiefungen hinauf"&&str!="an vertiefungen herauf")
	return 0;
	write("Gerade, als Du den Fuss in eine der Vertiefungen setzen willst, "+
	"faellt Dir \ndaran etwas auf.\nDu haelst inne.\n");
	return 1;
	
}