inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Alge");
  SetProp(P_LONG,
    "Du siehst eine kleine, glitschige Alge. Vermutlich kann man sie essen, wenn man denn will." );
  SetProp(P_NAME, "Alge");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
	SetProp(P_FOOD_INFO, ([F_SOAK:1, 
	F_HEAL:({1,1}), // erst HP, MP
	F_MSG: "Du mampfst eine kleine, glitschige Alge. Also lecker ist anders. War aber bestimmt gesund.", 
	F_MSG_ROOM: "mampft eine kleine glitschige Alge. Du bist nur maessig neidisch, lecker war die sicher nicht."]));


  AddId("alge");
 
  SetProp(P_MATERIAL, ({MAT_MISC_PLANT }));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 2);
		 
}

