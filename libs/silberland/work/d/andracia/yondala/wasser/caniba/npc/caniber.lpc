inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int wann;
int was;
int kleidung;
int waffe;

void init()
{
	wann=random(10);
	wann+=15;
	
/*	if (TP->QueryProp(P_MAX_FOOD)==TP->QueryProp(P_FOOD)&& interactive(TP))   //(!this_player()->eat_food(1,0)) 
		{
			write("Der Caniber fast Dir an den Bauch und befindet Dich fuer schlachtreif.\n");
			Kill(TP);}*/
			if(!InFight(TO)) call_out("fuettern",wann);
    
  //  14.10. 2008, Yondala:
//    	Verteidigen ist doof, erstmal raus, ist schwer genug fuer kleine Spieler
    //if (this_player() && this_player()->id("/ncaniber")) AddDefender(this_player());			
  
  ::init();
  }

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Caniber");
  SetProp(P_LONG,
    "Du siehst einen recht kleinen, haarigen Caniber vor Dir. Obwohl er fast "
    "nackt ist bedeckt sein dichtes Haar seinen kraeftigen Koerper ausreichend, "
    "Sodass Du nicht erkennen kannst ob es sich um einen Mann oder eine Frau handelt.. "
    "Der Caniber laechelt Dich aufmunternd an.");
  SetProp(P_NAME, "Caniber");
  SetProp(P_GENDER, MALE);
  AddId(({"caniber", "zwerg", "/ncaniber"}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(10);
  SetProp(P_HANDS, ({" mit grossem Apetitt",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 120);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "stapft herbei");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/wasser/yondala/caniba") );
  SetProp(P_MNPC_WAIT, ({ 5, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, CAN_ROOM "/d/andracia/yondala/wasser/caniba/caniba_3h");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Caniber");

  AddInfo(DEFAULT_INFO, "sagt: Ugga.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Caniber freut sich ueber diese Mahlzeit.\n" }) );

   SetChats(3, ({
    "Der Caniber kneift Dir in die Huefte und schuettelt den Kopf.\n",
    "Der Caniber fasst Dir an den Hintern und grinst.\n", 
    "Der Caniber schaut Dich gierig an.\n",
    "Der Caniber faengt bei Deinem Anblick an zu sabbern.\n"}) );

kleidung =random(6);
waffe=random(3);
if(kleidung==0)
    CLONEME(CAN_ARMOUR + "knochenpanzer.lpc");
if(kleidung==1)
    CLONEME(CAN_ARMOUR + "knochenschild.lpc");
if(kleidung==2)
	  CLONEME(CAN_ARMOUR + "knochenhelm.lpc");
if(kleidung==3)
	  CLONEME(CAN_ARMOUR + "knochenarmschienen.lpc");
if(kleidung==4)
	  CLONEME(CAN_ARMOUR + "knochenbeinschienen.lpc");
	 command("trage alles");

if (waffe==0)
	{CLONEME(CAN_WEAPON +"steinbeil.lpc" );
command("zuecke beil");
}
if (waffe==1)
	{CLONEME(CAN_WEAPON +"holzknueppel.lpc" );
command("zuecke knueppel");}
}

