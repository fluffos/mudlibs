fuettern()
{
	int wieviel;
	//wieviel = random(10);
	
 	
 if (!InFight(TO)) //Wenn der CAN_NPC gerade nicht kaempft
 	{
 		if (TP && interactive(TP) && environment(TO)==environment(TP))
			{
				if(this_player()->eat_food(5,1)) 
					{
						was=random(5);
						if(was==0)	write("Der Caniber steckt Dir laechelnd einen Apfel in den Mund.\n");
						if(was==1)	write("Der Caniber fuettert Dich liebevoll mit etwas Fisch.\n");
						if(was==2)	write("Der Caniber noetigt Dich dazu eine Knolle zu essen.\n");
						if(was==3)	write("Der Caniber schiebt Dir eine suesse Frucht zwischen die Zaehne.\n");
						if(was==4)	write("Der Caniber stopft Dir eine Made in den Mund.\n");
						say("Der Caniber fuettert "+TPN+".\n",TP);
						wieviel=5 +random(5);
						
						TP->AddHp(wieviel);
						TP->AddSp(wieviel);
						}
					
			else
				{
					write("Der Caniber will Dich fuettern, Du bekommst aber keinen Bissen "+
								"mehr herunter.\nDer Caniber findet, dass Du nun dick genug bist um "+
								"gegessen zu werden.\n");
								say("Der Caniber grinst "+TPN+" hungrig an.n",TP);
								Kill(TP);
					}
				

				}
	
	}
			wann= random(10)+25;
			call_out("fuettern",wann);
}
