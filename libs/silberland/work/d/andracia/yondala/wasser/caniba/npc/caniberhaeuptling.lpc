inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"
#include <moredef.h>



int wann;
int was;
int waffe;

void init()
{
	if (TP->QueryProp(P_MAX_FOOD)==TP->QueryProp(P_FOOD)&& interactive(TP))		
		{
			command("sag Du dick, ich HUNGER!\n");
			Kill(TP);}	

    if (this_player() && 
   	      ( this_player()->id("/ncaniber"))) AddDefender(this_player());			
::init();
  }

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Haeuptling der Caniber");
  SetProp(P_LONG,
    "Du siehst einen staemmigen, haarigen Caniber vor Dir. Die wenigen \""
    "Kleidungsstueck\" die er traegt verbergen weder seine wilde Natur noch "
    "seinen muskuloesen Koerperbau.");
  SetProp(P_NAME, "Caniberhaeuptling");
  SetProp(P_GENDER, MALE);
  AddId(({"caniber", "zwerg", "caniberhaeuptling", "haeuptling", "/ncaniber"}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(20);
  SetProp(P_HANDS, ({" gierig",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 125);
  SetProp(P_WEIGHT, 130000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "stapft herbei");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_MURDER_MSG, "Ich nun satt");
  SetProp(P_KILL_NAME, "der Haeuptling der Caniber");

  SetProp(P_SPELLRATE,20);
     AddSpell(8,300,
              "Der Canibaerhaeuptlich schlaegt mit kralligen Haenden nach Dir.\n",
              "Der Canibaerhaeuptlich schlaegt mit kralligen Haenden nach @WEN.\n",
              ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );
     AddSpell(2,500,
              "Der Canibaerhaeuptlich beisst Dich.\n",
              "Der Canibaerhaeuptlich beisst @WEN.\n",
              ({DT_SQUEEZE,DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );

  AddInfo(DEFAULT_INFO, "sagt: Ugga.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Caniberhaeuptling freut sich ueber diese Mahlzeit.\n" }) );

//   SetChats(1, ({
//    ".\n"}) );

    SUID;

    CLONEME(CAN_ARMOUR + "knochenpanzer.lpc");
    CLONEME(CAN_ARMOUR + "knochenschild.lpc");
	  CLONEME(CAN_ARMOUR + "knochenhelm.lpc");
    command("trage alles");

waffe=random(2);
if (waffe==0)
	{CLONEME(CAN_WEAPON +"steinbeil.lpc" );
	command("zuecke beil");}
if (waffe==1)
	{CLONEME(CAN_WEAPON +"holzknueppel.lpc" );
command("zuecke knueppel");}

}

// Mitloggen wenn einen Spieler den CAN_NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

void InformDefend(object enemy)
{
 Kill(enemy);
}