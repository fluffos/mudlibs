
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Knochenrassel");
  SetProp(P_LONG,
    "Du siehst ein kleine Knochenrassel mit der vermutlich Kinder aus unzivilisierten Voelkern spielen." );

  SetProp(P_NAME, "Knochenrassel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"rassel","knochenrassel"}));

  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 120);
  SetProp(P_ARTICLE, 1);
 
}
