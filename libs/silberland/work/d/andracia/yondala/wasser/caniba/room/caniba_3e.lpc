/*
Hier koennte ein Trank versteckt werden, wenn man versucht, einen Fisch zu fangen
*/
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem umgefallenen Baumstamm" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem alten, halbverrottetem Baumstamm der in einen "
    "klaren See endet welcher halb unter einer Grotte verborgen liegt. Hier ist "
    "es durch den Schatten, den der Berg wirft und einem feinen Wassernebel "
    "recht kuehl." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_MOUNTAIN]) );

    
  AddDetail( ({ "see" }),
    "Der kleine See in der Grotte wird durch einen Wasserfall gespeisst. Es "
    "sich um Suesswasser zu handeln. Ganz sicher "
    "kannst Du aber wohl nur sein, wenn Du daraus trinkst.");    
  AddDetail( ({ "baumstamm","baum" }),
    "Du stehst auf einem alten verotteten Baumstamm welcher ein kleines "
    "Stueck in den See hineinragt.");    
  AddDetail( ({ "boden", "uebereste", "ueberrest" }),
    "Du stehst auf den Ueberresten eines alten Baumes.");    
  AddDetail( ({ "fels" }),
    "Der Fels ist grau, hart und etwas feucht.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist hier kaum zu sehen. Wenn Du nach oben schaust siehst Du "
    "lediglich die Decke der Grotte.");    
  AddDetail( ({ "westen", "weg" }),
    "Nach Westen gelangst Du wieder auf den Weg.");    
  AddDetail( ({ "decke" }),
    "Die Decke der Grotte besteht wie die Waende auch aus Fels.");    
  AddDetail( ({ "wand", "waende" }),
    "An den felsigen Waenden der Grotte haben sich einige Moose gebildet.");    
  AddDetail( ({ "moose", "moos" }),
    "Da es hier recht feucht ist haben sich an den Waenden einige Moose "
    "gebildet. Du fragst Dich, ob diese essbar sind.");    
  AddDetail( ({ "berg" }),
    "Du stehst vor einer Grotte die das Wasser in den Berg gegraben hat.");    
  AddDetail( ({ "grotte" }),
    "Du stehst direkt vor einer Grotte, die durch einen kleinen Wasserfall "
    "in den Berg gewaschen wurde.");    
  AddDetail( ({ "wasserfall" }),
    "Das Wasser aus welchem der See besteht faellt von oben aus dem Berg und "
    "ist von einem feinen Nebel umgeben.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau.");    
  AddDetail( ({ "wasser",  }),
    "Du glaubst, dass es sich um Suesswasser handelt. Ein paar schillernde "
    "Fische gleiten durch den See.");    
  AddDetail( ({ "nebel", "troepfchen", "wassernebel" }),
    "Die kleinen Troepfchen des Wasserfalls bilden einen feinen Nebel ueber dem See.");    
  AddDetail( ({ "fische","fisch" }),
    "Ob Du einen fangen koenntest?");    
  AddDetail( ({ "suesswasser" }),
    "Wenn es sich um Suesswasser handelt koennte man es vermutlich trinken.");    
  AddDetail( ({ "schatten" }),
    "Der Berg wirft einen grossen Schatten in dem Du Dich befindest.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Rauschen des Wasserfalls.");

  AddSound( ({ "rauschen" }),
    "Es wirkt irgendwie beruhigend");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);

AddExit( "westen", CAN_ROOM + "caniba_3d.lpc" ); 
AddCmd( ({ "fang", "fange" }), "fangen" );
AddCmd( ({ "trinke", "trink" }), "trinken" );

}

trinken(string str)
{
	if(str=="wasser"||!str)
		{
			if (this_player()->drink_drink(5,0))
     		{
     			write ("Du kniest Dich hin und schoepfst mit der Hand etwas erfrischendes "+
		  		"Wasser in Deine Kehle.\n");
		  		say(TPN+" erfrischt sich am Wasser des Sees.\n",TP);
      		this_player()->AddHp(10);
      		this_player()->AddSp(10);
      		return 1;   
      		}
/*	else
		{
			write("Du kriegst keinen Schluck mehr runter.\n");
			return 1;
		}*/
	}
}
	
	
fangen(string str)
{
	if(str=="fisch"||str=="fische")
		{
			int fangerli;
			fangerli=random(5);
			if(TP->FindPotion("Ploetzlich haelst Du einen kleinen Trank in der Hand.\n"))return 1;
			if(fangerli==0)	write("Du kniest Dich nieder und lauerst einem Fisch auf. Leider gelingt "+
				"es Dir nicht einen der quirligen Leiber aus dem Wasser zu befoerdern.\n");
			if(fangerli==1)	write("Du greifst ins Wasser und schnappst Dir einen Fisch. "+
				"Gerade als Du ihn rausziehen willst entgleitet er Dir wieder.\n");
			if(fangerli==2)	write("Du setzt Dich regungslos hin und wartest auf einen "+
				"Fisch. Leider scheinen die Fische das zu ahnen und halten Abstand zu Dir.\n");
			if(fangerli==3)	write("Du springst ins Wasser und versuchst einen Fisch zu fangen. "+
				"Leider sind die Fische schneller als Du. Voellig erschoepft kletterst Du "+
				"wieder auf den Baumstamm.\n");
			if(fangerli==4)	write("Du legst Dich auf den Boden und beobachtest die Fische, "+
				"doch jedesmal, wenn Du einen greifen willst weicht er Dir aus. Enttaeuscht "+
				"stehst Du nach einiger Zeit wieder auf.\n");
			say(TPN+" scheitert bei dem Versuch einen Fisch zu fangen.\n",TP);
		return 1;
		}
		else
			{write("Was moechtest Du fangen?\n");
				return 1;
				}
	
}	
	