
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem schmalen Weg, der um einen sehr hohen Berg "
    "herumfuehrt. Neben Dir schwappen die Wellen des Meeres gegen den Fels, "
    "aber die wenigsten davon sind hoch genug um den Boden zu ueberschwemmen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_MOUNTAIN]) );

    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind heute nicht besonders stark, sie schwappen sanft gegen "
    "die Felsen unter Dir und nur hin und wieder schafft es eine "
    "groessere Welle Deine Fuesse zu benetzen.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem schmalen, felsigen Weg.");    
  AddDetail( ({ "fels" }),
    "Der Fels ist grau, hart und etwas feucht und glitschig. Pass auf, dass "
    "Du nicht ausrutscht.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt neben Dir in unendliche Weiten. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist von hier aus nicht zu sehen.");    
  AddDetail( ({ "weiten","weite" }),
    "Das Meer scheint unendlich zu sein und ausser der Insel auf der Du "
    "Dich befindest kannst Du nichts sehen als Wasser, davon aber reichlich.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer felsigen Insel.");    

  AddDetail( ({ "berg" }),
    "Du stehst direkt neben einem riesiegen, steilen Berg auf einem Weg der "
    "sich eng an dessen Rand entlang schlaengelt.");    
  AddDetail( ({ "weg" }),
    "Der Weg auf dem Du stehst gabelt sich hier und ist daher etwas breiter. "
    "Du kannst ihm folgen und so vermutlich auf die andere Seite des Berges gelangen. "
    "Im Suedosten fuehrt er leicht abschuessig auf eine Baumgruppe zu.");    
  AddDetail( ({ "seite","rand" }),
    "Du befindest Dich am unteren Rand des Berges, also an seiner Seite.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau die Sonne ist allerdings durch den Berg verdeckt.");    
  AddDetail( ({ "wasser" }),
    "Das Meer neben Dir besteht hauptsaechlich aus Wasser.");    
  AddDetail( ({ "suedosten" }),
    "Im Suedosten kannst Du einige Baeume sehen.");    
  AddDetail( ({ "baumgruppe","baeume" }),
    "Du glaubst, dass es sich um Obstbaeume handelt.");    
  AddDetail( ({ "obstbaeume" }),
    "Du solltest naeher rangehen um sicher sein zu koennen.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({""}),30,"func");




AddItem(CAN_NPC + "caniber.lpc",REFRESH_DESTRUCT);
AddExit( "norden", CAN_ROOM + "caniba_4d.lpc" ); 
AddExit( "suedosten", CAN_ROOM + "caniba_6e.lpc" ); 

}

