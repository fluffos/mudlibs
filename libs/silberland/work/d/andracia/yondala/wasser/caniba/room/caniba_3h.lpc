
#include "../def.h"
inherit "std/room";
#include <properties.h>
int stein;

void reset()
{
	stein=1;
	::reset();
	}

void create() 
{
  ::create();
stein =1;
  SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem schmalen Weg, der um einen sehr hohen Berg "
    "herumfuehrt. Neben Dir schwappen die Wellen des Meeres gegen den Fels, "
    "aber die wenigsten davon sind hoch genug um den Boden zu ueberschwemmen. "
    "Der Weg gabelt sich hier. Nach Nord- und Suedwesten kannst Du um den "
    "Berg herum laufen, nach Osten gelangst Du auf einen kleinen Felsvorsprung." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "felsvorsprung" }),
    "Nach Osten gelangst Du auf einen kleinen Felsvorsprung.");    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind heute nicht besonders stark, sie schwappen sanft gegen "
    "die Felsen unter Dir und nur hin und wieder schafft es eine "
    "groessere Welle Deine Fuesse zu benetzen.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem schmalen, felsigen Weg und ist bis auf ein paar Steinchen leer und glatt.");    
  AddDetail( ({ "fels" }),
    "Der Fels ist grau, hart und etwas feucht und glitschig. Pass auf, dass "
    "Du nicht ausrutscht.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich ausser nach Westen in alle Richtungen. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne scheint warm auf Dich herunter.");    
  AddDetail( ({ "osten" }),
    "Oestlich von Dir befindet sich ein kleiner Felsvorsprung.");    
  AddDetail( ({ "nordwesten" }),
    "Wenn Du dem Weg weiter nach Nordwesten folgst gelangst Du irgendwann "
    "auf die andere Seite des Berges.");    
  AddDetail( ({ "suedwesten" }),
    "Wenn Du dem Weg weiter nach Suedwesten folgst gelangst Du irgendwann "
    "auf die andere Seite des Berges.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer felsigen Insel.");    

  AddDetail( ({ "berg" }),
    "Du stehst direkt neben einem riesiegen, steilen Berg auf einem Weg der "
    "sich eng an dessen Rand entlang schlaengelt.");    
  AddDetail( ({ "weg" }),
    "Der Weg auf dem Du stehst gabelt sich hier und ist daher etwas breiter. "
    "Du kannst ihm nach Nord- und Suedwesten um den Berg herum folgen oder "
    "nach Osten einen kleinen Felsvorsprung betreten.");    
  AddDetail( ({ "seite","rand" }),
    "Du befindest Dich am unteren Rand des Berges, also an seiner Seite.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau und eine warme Sonne lacht Dich an.");    
  AddDetail( ({ "wasser" }),
    "Das Meer neben Dir besteht hauptsaechlich aus Wasser.");    
  AddDetail( ({ "steinchen" }),
    "Falls Du mal eines brauchen solltest koenntest Du hier eines aufklauben.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");
  AddSound( ({ "plaetschern","wellen" }),
    "Die Wellen plaetschern leise vor sich hin.");  
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({""}),30,"func");



  AddCmd(({"klaube","klaub"}), "klauben"), 

AddItem(CAN_NPC + "caniber.lpc",REFRESH_DESTRUCT);

AddExit( "nordwesten", CAN_ROOM + "caniba_2g.lpc" ); 
AddExit( "suedwesten", CAN_ROOM + "caniba_4g.lpc" ); 
AddExit( "osten", CAN_ROOM + "caniba_3i.lpc" ); 

}

int klauben(string str)
{
	notify_fail("Was moechtest Du aufklauben?\n");
	if(str=="steinchen"||str=="stein"||str=="steinchen auf"||str=="stein auf")
		{
			if (stein)
				{
					write("Du bueckst Dich und klaubst ein kleines Steinchen auf.\n");
					say(TPN+" bueckt sich und klaubt ein kleines Steinchen auf.\n",TP);
					CLONE(CAN_OBJ + "stein.lpc", TP);
					stein--;
					return 1;
				}
			else
				{
					write("Leider kannst Du kein loses Steinchen mehr entdecken.\n");
					return 1;
				}
		}
	return 0;
	
}

