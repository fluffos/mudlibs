/*
28.06.2022: Yondala@SilberLand
Wer sich im Matsch suhlt, koennte sich eine Ruestung beschmutzen, 
die dann fuer zehn Minuten schwerer wird und das Adjektiv "verschmutzt" bekommt
Der Spieler bekommt das unsichtbare Item "verdreckt" aus OBJ
Ab und zu wird man durch eine Welle in einen anderen Raum gespuelt (2c oder 3b)
*/
#include "../def.h"
inherit "std/room";
#include <properties.h>
int welche;

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Sandbank" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer kleinen, vom Meer umspuelten Sandbank. Der "
    "Boden ist pappig und Du sinkst ein wenig ein. Ausserdem riecht es "
    "unangenehm. Nach Nordosten gelangst Du wieder auf einen Weg der um den Berg "
    "herumfuehrt. Hin und wieder schwappt eine Welle ueber Deine Fuesse.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_DESERT]) );

    
  AddDetail( ({ "sandbank" }),
    "Du befindest Dich auf einer kleinen Sandbank, die aus schlammigem Sand "
    "besteht der wohl durch die Meeresstroemungen hier angeschwemmt wurde.");    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind zwar nicht hoch, schwappen aber recht haeufig ueber "
    "Deine Fuesse.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem weichen, matschigen Boden in dem Du immerwieder einsinkst. "
    "Zwischen den Sandschichten siehst Du immer wieder Seetank und auch "
    "Fischreste. Ausserdem kannst Du einige Spuren entdecken.");    
  AddDetail( ({ "sand","sandschichten" }),
    "Der Boden hier besteht aus angeschwemmten Sandschichten.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich weit vor Dir. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist hinter dem Berg verschwunden.");    
  AddDetail( ({ "nordosten" }),
    "Nach Osten gelangst Du wieder auf den schmalen Weg der um den Berg fuehrt.");    
  AddDetail( ({ "suedosten" }),
    "Im Suedosten gelangst Du auf eine kleine Sandbank.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer felsigen Insel.");    

  AddDetail( ({ "berg" }),
    "Du stehst direkt neben einem riesiegen, steilen Berg auf einem Weg der "
    "sich eng an dessen Rand entlang schlaengelt.");    
  AddDetail( ({ "weg" }),
    "Der Weg auf dem Du stehst gabelt sich hier und ist daher etwas breiter. "
    "Du kannst ihm nach Osten, Sueden und Suedwesten folgen betreten.");    
  AddDetail( ({ "seite","rand" }),
    "Du befindest Dich am unteren Rand des Berges, also an seiner Seite.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau, die Sonne allerdings ist hinter dem "
    "Berg verschwunden, deswegen ist es hier auch merklich kuehler.");    
  AddDetail( ({ "wasser" }),
    "Das Meer neben Dir besteht hauptsaechlich aus Wasser.");    
  AddDetail( ({ "seetank", "fischreste" }),
    "Wurde wohl hier angeschwemmt.");    
  AddDetail( ({ "spuren" }),
    "Die Spuren sehen so aus, als haette sich hier jemand oder etwas im Matsch gesuhlt.");    
  AddDetail( ({ "matsch" }),
    "Den schmutzigen, feuchten Sand hier kann man durchaus als Matsch bezeichnen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({"Eine kleine Welle umspuelt Deine Fuesse.\n",
			"Eine grosse Welle umspuelt Dich und wirft Dich fast um.\n",
			"Eine riesige Welle erfasst Dich und setzt Dich woanders wieder ab.\n"})
			,30,"welle");
		



//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
AddExit( "westen", CAN_ROOM + "caniba_3b.lpc" ); 
AddExit( "norden", CAN_ROOM + "caniba_2c.lpc" ); 
AddExit( "nordosten", CAN_ROOM + "caniba_2d.lpc" ); 
AddCmd( ({ "suhle", "suhl" }), "suhlen" );

}



int alleraus(object ob) 
{
	welche=random(2);
	if (welche==0)
		{
			ob->move( CAN_ROOM + "caniba_3b.lpc", M_NOCHECK);
     return 1;
    }
			ob->move( CAN_ROOM + "caniba_2c.lpc", M_NOCHECK);
     return 1;
     
}

welle(int msg)
{
	  mixed *spieler;
	if (msg==2)
		{
			  spieler=filter_array( all_inventory(), #'interactive );
			  map_array(spieler, #'alleraus);
			}
	}
	
	



void beschmutzen()
{
	object *ruestungen;
	object *alleAdjective;
	object verschmutzt;
	object invisitem;
	ruestungen=TP->QueryArmours();
	verschmutzt=ruestungen[random(sizeof(ruestungen))];
	if(member_array("verschmutzt",verschmutzt->QueryProp(P_NAME_ADJ))==-1)
	{
		write(capitalize(verschmutzt->QueryArticle(0,1,1))+ verschmutzt->QueryProp(P_NAME)+" ist nun voller Schmutz und wird dadurch deutlich schwerer.\n");
		verschmutzt->SetProp(P_WEIGHT,verschmutzt->QueryProp(P_WEIGHT)+1000);
		verschmutzt->SetProp(P_NAME_ADJ, verschmutzt->QueryProp(P_NAME_ADJ)+({"verschmutzt"}));  
		
		invisitem=clone_object(CAN_OBJ+"verdreckt");
		invisitem->verdrecken(verschmutzt);
		}


}


int suhlen(string str )
{
  notify_fail( "Worin willst Du Dich suhlen?\n" );
  if( str == "in matsch"||str == "im matsch"||str == "in sand"||str == "im sand"||str == "im boden"||str == "in boden")
  {
  	write("Du suhlst Dich im Matsch.\n");
    say( TPN+" suhlt sich im Matsch.\n", TP);
	
	if(TP->QueryArmours()!=({})) 
    return 1;
 }
  return 0;
}