inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knochenhelm");
  SetProp(P_LONG,
    "Du siehst einen bleichen Knochenhelm, welcher scheinbar der Schaedel "
    "eines Lebewesens war." );

  SetProp(P_NAME, "Knochenhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"knochenhelm", "helm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 150);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  AddProp(P_DAM_PROTECTION, ([DT_BLUDGEON]) );
	SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_SLASH:1]) );
  	
}

