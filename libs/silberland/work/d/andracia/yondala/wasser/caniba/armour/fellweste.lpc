inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Fellweste");
  SetProp(P_LONG,
    "Du siehst eine grobe, zottelige Weste aus Fell. Sie ist sicherlich kein Meisterwerk, aber "
    "sie haelt warm." );

  SetProp(P_NAME, "Fellweste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"fellweste", "weste"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 150);
  SetProp(P_AUTOLOADOBJ, 1);                                     
  SetProp(P_QUALITY_DECAY, 100);
   SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:7, T_HEAT_PROT:-2 ]) );

  //AddProp(P_DAM_PROTECTION, ([DT_BLUDGEON]) );
	//SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_SLASH:1]) );
  	
}

