inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wurm");
  SetProp(P_LONG,
    "Du siehst einen kleinen, weissen Wurm welcher sich hier herumwindet.");
  SetProp(P_NAME, "Wurm");
  SetProp(P_GENDER, MALE);
  AddId(({"wurm"}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(2);
  SetProp(P_HANDS, ({" sich windend",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 30);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht langsam");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ("/d/wasser/yondala/caniba") );
  SetProp(P_MNPC_WAIT, ({ 10, 50, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, CAN_ROOM "/d/andracia/yondala/wasser/caniba/caniba_5e");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " rollt sich zusammen und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Wurm");

  AddInfo(DEFAULT_INFO, "piepst.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wurm hat leider keine Haende mit denen er Deine Sachen tragen kann.\n" }) );

}


