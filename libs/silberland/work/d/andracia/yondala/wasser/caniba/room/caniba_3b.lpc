/*
28.06.2022: Yondala@SilberLand
Hier kann man pro reset bis zu zwei Algen ernten
Ab und zu wird man durch eine Welle in einen anderen Raum gespuelt (3c oder 2c)
*/

#include "../def.h"
inherit "std/room";
#include <properties.h>
//#include </std/living/combat.lpc>

int welche;
int algenda;


void reset()
{
  object ob;
  ::reset();
  if (algenda<2)
  {
	  tell_room(TO,"Eine Alge wird auf den Felsen gespuelt.\n");
	  algenda++;
  }
}


void create() 
{
  ::create();
	algenda=2;
  SetProp( P_INT_SHORT, "Auf einer kleinen Sandbank" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer kleinen, vom Meer umspuelten Sandbank. Der "
    "Boden ist pappig und Du sinkst ein wenig ein. Ausserdem riecht es "
    "unangenehm. Hin und wieder schwappt eine Welle ueber Deine Fuesse.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_DESERT]) );

    
  AddDetail( ({ "sandbank" }),
    "Du befindest Dich auf einer kleinen Sandbank, die aus schlammigem Sand "
    "besteht der wohl durch die Meeresstroemungen hier angeschwemmt wurde.");    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind zwar nicht hoch, schwappen aber recht haeufig ueber "
    "Deine Fuesse.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem weichen, matschigen Boden in dem Du immerwieder einsinkst. "
    "Zwischen den Sandschichten siehst Du immer wieder Seetank und auch "
    "Fischreste. Neben Dir ragt ein groesserer Fels aus dem Wasser.");    
  AddDetail( ({ "sand","sandschichten" }),
    "Der Boden hier besteht aus angeschwemmten Sandschichten.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich weit vor Dir. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist hinter dem Berg verschwunden.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich vor einer felsigen Insel auf einer kleinen Sandbank.");    

  AddDetail( ({ "berg" }),
    "Die Insel wird von einem hohen Berg dominiert.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau, die Sonne allerdings ist hinter dem "
    "Berg verschwunden, deswegen ist es hier auch merklich kuehler.");    
  AddDetail( ({ "wasser" }),
    "Das Meer neben Dir besteht hauptsaechlich aus Wasser.");    
  AddDetail( ({ "seetank", "fischreste" }),
    "Wurde wohl hier angeschwemmt.");    
  AddDetail( ({ "fels", "felsen" }),
    "Der Fels schaut aus dem Wasser heraus, nur selten schafft es eine Welle, "+
	"ueber ihn hinweg zu spuelen. Dennoch ist seine Oberflaeche niemals trocken.");    
  
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Felsen ist feucht. Ausserdem ist sie mit Algen und Muscheln bedeckt.");    
  AddDetail( ({ "algen" }),
    "Einige glitschige Algen bedecken den Felsen. Sie sehen lecker aus. Ob man sie essen kann?");    
  AddDetail( ({ "muscheln" }),
    "Zwischen den Algen erkennst Du ein paar Muscheln, die meisten davon sind aber viel "+
	"zu klein, um etwas damit anzufangen.\n");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

	AddRoomMessage( 
    ({"Eine kleine Welle umspuelt Deine Fuesse.\n",
			"Eine grosse Welle umspuelt Dich und wirft Dich fast um.\n",
			"Eine riesige Welle erfasst Dich und setzt Dich woanders wieder ab.\n"})
			,30,"welle");
		



AddItem(CAN_NPC + "caniber.lpc",REFRESH_DESTRUCT);
AddExit( "nordosten", CAN_ROOM + "caniba_2c.lpc" ); 
AddExit( "osten", CAN_ROOM + "caniba_3c.lpc" ); 

AddCmd( ({ "esse","ess", "iss" }), "essen" );
AddCmd( ({ "ernte","ernt", "pfluecke", "pflueck" }), "ernten" );

}

	
int alleraus(object ob) 
{
	welche=random(2);
	if (welche==0)
		{
			ob->move( CAN_ROOM + "caniba_2c.lpc", M_NOCHECK);
     return 1;
    }
			ob->move( CAN_ROOM + "caniba_3c.lpc", M_NOCHECK);
     return 1;
     
}
welle(int msg)
{
	  mixed *spieler;
	if (msg==2)
		{
			  spieler=filter_array( all_inventory(), #'interactive );
			  map_array(spieler, #'alleraus);
			}
	}
	
int essen(string str)
{
	if(str=="algen"||str=="alge")
	{
		write("Dazu solltest Du sie erst ernten.\n");
		return 1;
	}
	return 0;
}

int ernten(string str)
{
	if(str=="muschel"||str=="muscheln")
	{
		write("Damit kann man nichts anfangen, lass sie einfach dort.\n");
		return 1;
	}
	notify_fail("Was moechtest Du ernten?\n");
	if(str!="alge"&&str!="algen")
	return 0;
	if(!algenda)
	{
		write("Die Algen hier taugen nichts mehr, warte besser, bis neue angespuelt wurden.\n");
		return 1;
	}
	
	write("Du erntest eine Alge.\n");
    say( TPN+" erntet eine Alge.\n", TP);
	algenda--;
	TP->clone_object(CAN_OBJ+"alge");
	return 1;
}