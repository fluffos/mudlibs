
#include "../def.h"
inherit "std/room";
#include <properties.h>

int tierchen;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Gang" );
  SetProp( P_INT_LONG,
    "Du stehst in einem engen, dunklen Gang um Dich herum ist es stockdunkel und "
    "wenn Du keine Lichtquelle bei Dir haettest wuerdest Du gar nichts sehen. "
    "Die Waende des Ganges bestehen aus blankem Fels und sind sehr dicht aneinander. "
    "Auf dem Boden liegt verschiedenster Unrat herum. Der Gang gabelt sich hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "gang" }),
    "Du stehst in einem dunklen, engen Gang der sich direkt vor Dir gabelt.");    
   AddDetail( ({ "boden" }),
    "Du stehst auf hartem Fels. Ueberall liegt Unrat herum.");    
  AddDetail( ({ "felsen","fels" }),
    "Der Fels ist grau, hart und trocken.");    
  AddDetail( ({ "lichtquelle" }),
    "Offensichtlich besitzt Du eine.");    
  AddDetail( ({ "unrat" }),
    "Auf dem Boden sind kleine Aeste, Knochen und etwas Stroh verstreut.");    
  AddDetail( ({ "aeste" }),
    "Auf dem Boden liegen kleine Aeste verteilt.");    
  AddDetail( ({ "knochen" }),
    "Die Knochen die hier rumliegen erwecken in Dir den Anschein als wuerde "
    "hier oft gespeist werden. Es gibt so viele verschiedene Knochen hier, "
    "dass Du nicht sagen kannst von welchem Lebewesen sie stammen.");    
  AddDetail( ({ "wesen","lebewesen" }),
    "Dir wird mulmig bei dem Gedanken, dass auch Wesen Deiner Rasse darunter "
    "sein koennten.");
  AddSpecialDetail( ({ "rasse" }), "rasse" );
        
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen hier aus nacktem Fels.");    
  AddDetail( ({ "himmel" }),
    "Den siehst Du hier sicherlich nicht.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus blankem Fels.");    
  AddDetail( ({ "stroh" }),
    "Viel ist es nicht, es sieht eher so aus, als haette es jemand verloren.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hier drin ist es absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig.");

  AddSmell( ({ "" }),
    "");

//  AddRoomMessage( 
 //   ({""}),30,"func");


tierchen =random(3);
if(tierchen==0) AddItem(CAN_NPC + "ratte.lpc",REFRESH_DESTRUCT);
if(tierchen==1) AddItem(CAN_NPC + "kakerlake.lpc",REFRESH_DESTRUCT);
if(tierchen==2) AddItem(CAN_NPC + "wurm.lpc",REFRESH_DESTRUCT);
	
	
AddExit( "nordwesten", CAN_ROOM + "caniba_u_4e.lpc" );
AddExit( "westen", CAN_ROOM + "caniba_u_5e.lpc" );  
AddExit( "oben", CAN_ROOM + "caniba_5f.lpc" ); 
}



string rasse()
 {
	  	return ("Du weisst aber schon, dass Du "+TP->QueryProp(P_RACE)+" bist, oder?\n");
	}