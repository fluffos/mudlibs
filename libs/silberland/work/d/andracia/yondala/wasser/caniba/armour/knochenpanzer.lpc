inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knochenpanzer");
  SetProp(P_LONG,
    "Du siehst einen bleichen Knochenpanzer, welcher scheinbar aus den Rippen "
    "eines Lebewesens hergestellt wurde." );

  SetProp(P_NAME, "Knochenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"knochenpanzer", "panzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 33);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 170);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  AddProp(P_DAM_PROTECTION, ([DT_BLUDGEON]) );
	SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_SLASH:1]) );
  	
}

