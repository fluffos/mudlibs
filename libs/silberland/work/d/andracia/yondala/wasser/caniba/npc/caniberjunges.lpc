inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
//#include <moving.h>
#include <npc.h>
#include "../def.h"

void create() {
 int was;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Caniberjunges");
  SetProp(P_LONG,
    "Du siehst kleines, zappelndes Fellknaeul was irgendwie teilweise auch "
    "aus Armen und Beinen zu bestehen scheint. Du bist Dir fast sicher hier "
    "einen ganz jungen Caniber zu sehen.");
  SetProp(P_NAME, "Caniberjunges");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fellknaeul", "caniber", "caniberjunges", "junges"}));
  SetProp(P_ARTICLE, 1);


  create_default_npc(5);
  SetProp(P_HANDS, ({" mit kleinen haarigen Armen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MSGIN, "krabbelt heran");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Caniberjunges");

  AddInfo(DEFAULT_INFO, "schaut Dich treuherzig an.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Caniberjunge freut sich ueber diese Mahlzeit.\n" }) );

   SetChats(5, ({
    "Das Caniberjunge macht ein paar tappsige Schritte und faellt dann wieder auf alle Viere.\n",
    "Das Caniberjunge schaut Dich hungrig an.\n", 
    "Das Caniberjunge knabbert an Deinem Fuss.\n",
    "Das Caniberjunge macht ein Baeuerchen.\n"}) );

was=random(3);
if(was==1)  CLONEME(CAN_ARMOUR + "fellweste.lpc");
if (was==2)  CLONEME(CAN_OBJ + "knochenrassel.lpc");

    command("trage alles");
}

// Mitloggen wenn einen Spieler den CAN_NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

