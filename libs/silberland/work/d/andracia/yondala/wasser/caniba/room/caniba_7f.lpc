
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen Baeumen" );
  SetProp( P_INT_LONG,
    "Du stehst hier mitten in einer Gruppe von hohen Baeumen. Auf dem Boden "
    "liegen einige abgestorbene Aeste und trockenes Laub. Durch die maechtigen "
    "Baumkronen funkelt hin und wieder die Sonne auf Dich herunter. Im Norden "
    "steht der maechtige Berg um den Du schon herum gelaufen bist. Das Rauschen "
    "des Meeres dringt nur noch gedaempft an Deine Ohren." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

    
  AddDetail( ({ "baeume", "waldstueck" }),
    "Die Baueme um Dich herum sind recht hoch, sie stehen im vollen Laub und "
    "ihre Fruechte verbreiten einen verfuehrerischen Duft.");    
  AddDetail( ({ "laub", "blaetter" }),
    "Das Laub der Baeume leuchtet in strahlendem Gruen, teilweise liegt es aber "
    "auch schon vertrocknet auf dem Boden und raschelt unter Deinen Fuessen.");    
  AddDetail( ({ "gruen" }),
    "Man koennte es durchaus als blattgruen bezeichnen.");    
  AddDetail( ({ "boden", "waldboden" }),
    "Du stehst auf festem Waldboden der uebersaeht ist mit "
    "trockenem Laub und abgebrochenen Aesten.");    
  AddDetail( ({ "aeste" }),
    "Die Kronen der Baeume bestehen aus kraeftigen Aesten, von denen einige "
    "allerdings schon auf dem Boden liegen.");    
  AddDetail( ({ "meer" }),
    "Das Meer hoerst Du nur noch leise Rauschen.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne ist von hier aus kaum zu sehen, nur selten lugt sie durch die "
    "Baumkronen hindurch.");    
  AddDetail( ({ "norden" }),
    "Noerdlich von Dir ragt der Berg aus dem die Insel hauptsaechlich besteht "
    "in den Himmel empor.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer felsigen Insel mit einem kleinen Waldstueck.");    
  AddDetail( ({ "berg" }),
    "Der Berg ist noerdlich von Dir. Du bist schon um ihn herum gelaufen.");    


  AddDetail( ({ "aeste" }),
    "Die Kronen der Baeume bestehen aus starken Aesten an denen herrlich bunte Fruechte haengen.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau die Sonne blinzelt ab und zu durch die Blaetter der Baueme.");    

  AddDetail( ({ "kronen" }),
    "Die Kronen der Baeume bestehen aus Aesten welche unzaehlige Blaetter und viele bunte Fruechte tragen.");    
  AddDetail( ({ "fruechte" }),
    "Die Fruechte der Baeume leuchten bunt und locken Dich mit einem "
    "verfuehrerischen Duft. Ob Du welche pfluecken kannst?");    
   
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Rauschen des Meeres in der Ferne und das Knistern "
    "des trockenen Laubes bei jedem Deiner Schritte.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wald, ausserdem verwoeht der suesse Duft der bunten Fruechte Deine Nase.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
AddExit( "norden", CAN_ROOM + "caniba_6f.lpc" ); 
AddExit( "suedwesten", CAN_ROOM + "caniba_8e.lpc" ); 
AddExit( "westen", CAN_ROOM + "caniba_7e.lpc" ); 
AddExit( "sueden", CAN_ROOM + "caniba_8f.lpc" ); 
AddExit( "suedosten", CAN_ROOM + "caniba_8g.lpc" ); 

AddCmd( ({ "pflueck", "pfluecke" }), "pfluecken" );
AddCmd( ({ "kletter", "klettere" }), "klettern" );
}

klettern(string str )
{
  notify_fail( "Wo moechtest Du hinklettern?\n" );
  if( str == "auf baum"||str == "baum rauf" )
  {
  	
  	TP->move(CAN_ROOM + "caniba_baum_7f.lpc", M_GO,
  	"","klettert auf einen Baum","kommt hoch geklettert");
		write("Du kletterst den Baum hinauf.\n");
    say( TPN+" klettert auf einen Baum.\n");
    return 1;

  }
  return 0;
}
pfluecken(string str )
{
  notify_fail( "Was moechtest Du pfluecken?\n" );
  if( str == "frucht"||str == "fruechte" )
  {
  	
		write("Du reckst und streckst Dich, kannst aber keine Frucht erreichen.\n"
		"Vielleicht solltest Du versuchen auf den Baum zu klettern!?\n");
    return 1;

  }
  return 0;
}