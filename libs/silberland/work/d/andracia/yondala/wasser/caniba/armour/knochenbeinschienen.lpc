inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Knochenbeinschienen");
  SetProp(P_LONG,
    "Du siehst ein Paar relativ stabiler Knochenbeinschienen. Sie sind zwar recht primitiv "
    "verarbeitet, scheinen aber doch einiges auszuhalten." );

  SetProp(P_NAME, "Knochenbeinschienenpaar");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"knochenbeinschienen", "beinschienen","schienen", "knochenbeinschienenpaar"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 150);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  AddProp(P_DAM_PROTECTION, ([DT_BLUDGEON]) );
  	
}

