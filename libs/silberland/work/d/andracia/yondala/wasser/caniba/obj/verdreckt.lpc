// wird vom Raum caniba_2c geclont, macht ein Ruestungsteil schwer und schmutzig, entfernt sich nach zehn Minuten

#include "../def.h"
#include <moredef.h>
#include <properties.h>



inherit "std/thing";

object ruestung;



  
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "\nverdreckt");
  SetProp(P_GENDER, MALE);
  AddId(({"\nverdreckt"}) );

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
}

void entdrecken()
{
	if(!ruestung) return;
	if(interactive(environment(ruestung)))
	{
		tell_object(environment(ruestung),"Der Dreck von "+ruestung->name(WEM)+" ist nun trocken und faellt wieder ab.\n");
		//write("Der Dreck von "+ruestung->name(WEM)+" ist nun trocken und faellt wieder ab.\n");
	}
	//ruestung->RemoveAdjective("verdreckt");
	
	ruestung->SetProp(P_NAME_ADJ, ruestung->QueryProp(P_NAME_ADJ)-({"verschmutzt"}));
	
	ruestung->SetProp(P_WEIGHT,ruestung->QueryProp(P_WEIGHT)-1000);
	remove();	
}
void verdrecken(object ding)
{
	ruestung=ding;
	call_out("entdrecken",6000);
}




