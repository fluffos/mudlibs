//Das Steinbeil der Caniber. Per random 20 ist es besonders stabil und hat eine
//hoehere WC
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{

  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Steinbeil");
  SetProp(P_LONG,
    "Du siehst ein primitives Steinbeil." );
  SetProp(P_NAME, "Steinbeil");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"beil", "steinbeil"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_STONE, MAT_WOOD}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 50);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     
  SetProp(P_WC_BONUS, (["caniber": 100]) );

if(random(20)==0)
	{
		SetProp(P_SHORT, "Ein besonderes Steinbeil");
    SetProp(P_LONG,
      "Du siehst ein besonders stabiles und geschaerftes Steinbeil." );
    AddAdjective("besonders");
    SetProp(P_WC, 120);
    SetProp(P_WC_FIX, 30 );
    SetProp(P_VALUE, 500);
    SetProp(P_QUALITY_DECAY, 150);
  }
 }
