#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzknueppel");
  SetProp(P_LONG,
    "Du siehst einen einfachen Holzknueppel der wohl von einem Baum abgebrochen wurde." );
  SetProp(P_NAME, "Holzknueppel");
  SetProp(P_GENDER, MALE);
  AddId( ({"knueppel", "holzknueppel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,  MAT_WOOD );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 5);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_QUALITY_DECAY, 20);

  SetProp(P_WC_BONUS, (["caniber": 100]) );
}
