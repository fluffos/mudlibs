
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du mitten in einer kleinen Hoehle um Dich herum ist es stockdunkel und "
    "wenn Du keine Lichtquelle bei Dir haettest wuerdest Du gar nichts sehen. "
    "Die Waende der Hoehle bestehen aus blankem Fels, auf dem Boden liegt "
    "verschiedenster Unrat herum. Du kannst nach unten in einen Gang hinab gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer finsteren Hoehle deren Eingang noerdlich von Dir ist.");    
  AddDetail( ({ "eingang" }),
    "Du stehst suedlich des Eingangs. Es ist hier sehr dunkel aber Du kannst seine Umrisse deutlich sehen.");    
  AddDetail( ({ "loch", "umrisse" }),
    "Im Norden der Hoehle seihst Du deutlich die Umrisse des Lochs durch das Du gekommen bist.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf hartem Fels. Ueberall liegt Unrat herum.");    
  AddDetail( ({ "felsen","fels" }),
    "Der Fels ist grau, hart und trocken.");    
  AddDetail( ({ "lichtquelle" }),
    "Offensichtlich besitzt Du eine.");    
  AddDetail( ({ "unrat" }),
    "Auf dem Boden sind kleine Aeste, Knochen und etwas Stroh verstreut.");    
  AddDetail( ({ "aeste" }),
    "Auf dem Boden liegen kleine Aeste verteilt.");    
  AddDetail( ({ "knochen" }),
    "Die Knochen die hier rumliegen erwecken in Dir den Anschein als wuerde "
    "hier oft gespeist werden. Es gibt so viele verschiedene Knochen hier, "
    "dass Du nicht sagen kannst von welchem Lebewesen sie stammen.");    
  AddDetail( ({ "wesen","lebewesen" }),
    "Dir wird mulmig bei dem Gedanken, dass auch Wesen Deiner Rasse darunter "
    "sein koennten.");
  AddSpecialDetail( ({ "rasse" }), "rasse" );
        
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen hier aus nacktem Fels.");    
  AddDetail( ({ "himmel" }),
    "Den siehst Du hier sicherlich nicht.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus blankem Fels.");    
  AddDetail( ({ "stroh" }),
    "Das Stroh ist nicht gut verteilt. Du glaubst, dass es sich bei den "
    "Strohhaufen um Schlafplaetze handeln koennte.");    
  AddDetail( ({ "schlafplaetze","strohhaufen" }),
    "Wer da wohl schlafen mag?");    
  AddDetail( ({ "gang","suedosten" }),
    "Du kannst nicht sehen, was dort auf Dich wartet.");     
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hier drin ist es absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig.");

  AddSmell( ({ "" }),
    "");

//  AddRoomMessage( 
 //   ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);*/
AddExit( "norden", CAN_ROOM + "caniba_4f.lpc" ); 
AddExit( "nordwesten", CAN_ROOM + "caniba_4e.lpc" ); 
AddExit( "westen", CAN_ROOM + "caniba_5e.lpc" ); 
AddExit( "unten", CAN_ROOM + "caniba_u_5f.lpc" ); 

}



string rasse()
 {
	  	return ("Du weisst aber schon, dass Du "+TP->QueryProp(P_RACE)+" bist, oder?\n");
	}