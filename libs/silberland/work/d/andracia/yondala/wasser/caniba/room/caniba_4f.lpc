
#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst am Eingang einer kleinen Hoehle die in tristes Zwielicht "
    "getaucht ist. Die Waende bestehen aus blankem Fels, auf dem Boden liegt "
    "verschiedenster Unrat herum. Durch ein relativ grosses Loch in der "
	"oestlichen Wand kannst Du die Hoehle wieder verlassen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

    
  AddDetail( ({ "hoehle" }),
    "Du stehst in einer schwach erhellten Hoehle.");    
  AddDetail( ({ "eingang" }),
    "Du stehst direkt im Eingang der Hoehle, vor Dir ist deutlich das Loch "
    "zu sehen durch das Du gekommen bist.");    
  AddDetail( ({ "loch" }),
    "Durch dieses Loch kannst Du die Hoehle wieder verlassen.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf hartem Fels. Ueberall liegt Unrat herum.");    
  AddDetail( ({ "felsen","fels" }),
    "Der Fels ist grau, hart und trocken.");    
  AddDetail( ({ "zwielicht" }),
    "Durch das Loch in einer Wand schimmert ein wenig Sonnenlicht.");    
  AddDetail( ({ "sonnenlicht", "sonne" }),
    "Es scheint ein wenig Sonnenlicht herein. Weiter hinten ist die Hoehle "
    "allerdings stockdunkel.");    
  AddDetail( ({ "unrat" }),
    "Auf dem Boden sind kleine Aeste, Knochen und etwas Stroh verstreut.");    
  AddDetail( ({ "aeste" }),
    "Auf dem Boden liegen kleine Aeste verteilt.");    

  AddDetail( ({ "knochen" }),
    "Die Knochen die hier rumliegen erwecken in Dir den Anschein als wuerde "
    "hier oft gespeist werden. Es gibt so viele verschiedene Knochen hier, "
    "dass Du nicht sagen kannst von welchem Lebewesen sie stammen.");    
  AddDetail( ({ "wesen","lebewesen" }),
    "Dir wird mulmig bei dem Gedanken, dass auch Wesen Deiner Rasse darunter "
    "sein koennten.");
  AddSpecialDetail( ({ "rasse" }), "rasse" );
        
  AddDetail( ({ "waende" }),
    "Die Waende bestehen hier aus nacktem Fels. In einer Wand ist ein relativ grosses Loch.");    
  AddDetail( ({ "himmel" }),
    "Den siehst Du nicht, Du bist in einer Hoehle und Durch den Eingang faellt "
    "nur schummriges Zwielicht herein.");    
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus blankem Fels.");    
  AddDetail( ({ "stroh" }),
    "Das Stroh ist nicht gut verteilt. Du glaubst, dass es sich bei den "
    "Strohhaufen um Schlafplaetze handeln koennte.");    
  AddDetail( ({ "schlafplaetze","strohhaufen" }),
    "Wer da wohl schlafen mag?");    
  AddDetail( ({ "obstbaeume" }),
    "Du solltest naeher rangehen um sicher sein zu koennen.");    
  AddDetail( ({ "nische" }),
    "Sie scheint gross genug zu sein um sie zu betreten.");    
  AddDetail( ({ "wand" }),
    "In einer Wand ist ein Loch durch das Du die Hoehle verlassen kannst.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

/*  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
AddExit( "norden", CAN_ROOM + "caniba_4g.lpc" ); */
AddExit( "sueden", CAN_ROOM + "caniba_5f.lpc" ); 

AddCmd( ({ "verlasse", "verlass" }), "verlassen" );

}

verlassen(string str )
{
  notify_fail( "Was moechtest Du verlassen?\n" );
  if( str == "hoehle"||str == "hoehle durch loch" )
  {
  	
  	TP->move(CAN_ROOM + "caniba_5g.lpc", M_GO,
  	"","verlaesst die Hoehle","steigt aus einer Nische");
		write("Du verlaesst die Hoehle und stehst wieder im Sonnenlicht.\n");
    //say( TPN+" verlaesst die Hoehle.\n");
    return 1;

  }
  return 0;
}


string rasse()
 {
	  	return ("Du weisst aber schon, dass Du "+TP->QueryProp(P_RACE)+" bist, oder?\n");
	}