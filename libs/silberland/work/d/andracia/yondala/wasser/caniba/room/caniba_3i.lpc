// Anlegestelle fuer Schiffe auf der Kannibaleninsel
//alter Verbindungsraum: /d/andracia/yondala/hafen/room/hafen_c3
//eventuell woanders anlegen lassen?

#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen Felsvorsprung" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem kleinen Felsvorsprung. Um Dich herum "
    "schwappen die Wellen des Meeres gegen diesen natuerlichen Steg. "
    "Westlich von Dir ragt ein riesiger Berg in den Himmel hinauf. In allen "
    "anderen Richtungen schaust Du auf das offene Meer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
//catch(call_other("/d/andracia/yondala/hafen/room/hafen_c3", "???"));

    
  AddDetail( ({ "felsvorsprung" }),
    "Du befindest Dich auf einem kleinen Felsvorsprung.");    
  AddDetail( ({ "wellen","welle" }),
    "Die Wellen sind heute nicht besonders stark, sie schwappen sanft gegen "
    "den kleinen Felsvorsprung und nur hin und wieder schafft es eine "
    "groessere Welle Deine Fuesse zu benetzen.");    
  AddDetail( ({ "fuesse" }),
    "Schau mal an Dir runter, dann findest Du sie.");    
  AddDetail( ({ "an mir runter" }),
    "Da sind Deine Fuesse.");    
  AddDetail( ({ "boden" }),
    "Du stehst auf einem kleinen Felsvorsprung welcher naturgemaess aus Fels besteht.");    
  AddDetail( ({ "fels" }),
    "Der Fels ist grau, hart und etwas feucht und glitschig. Pass auf, dass "
    "Du nicht ausrutscht.");    
  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich ausser nach Westen in alle Richtungen. Es glitzert "
    "und funkelt im Sonnenschein.");    
  AddDetail( ({ "sonnenschein", "sonne" }),
    "Die Sonne scheint warm auf Dich herunter.");    
  AddDetail( ({ "richtungen" }),
    "Ausser nach Westen breitet sich das Meer in alle Richtungen aus.");    
  AddDetail( ({ "westen" }),
    "Westlich von Dir befindet sich eine kleine Insel welche von "
    "einem riesigen Berg dominiert wird.");    
  AddDetail( ({ "insel" }),
    "Nach Westen hin gelangst Du auf eine felsige Insel.");    
  AddDetail( ({ "steg" }),
    "Du stehst auf einem Felsvorsprung, der zwar natuerlichen Ursprungs ist, "
    "aber trotzdem als Steg bezeichnet werden kann. zumindest wird er als "
    "solch einer benutzt von den wenigen Schiffen die hier ab und zu anlegen.");    
  AddDetail( ({ "schiffe","schiff" }),
    "Sehr selten landen hier Schiffe mit neugierigen Wesen.");    
  AddSpecialDetail( ({ "wesen" }), "wesen" );

  AddDetail( ({ "berg" }),
    "Westlich von Dir befindet sich ein riesiger Berg den man kaum "
    "uebersehen kann. Er scheint fast die halbe Insel einzunehmen, Du "
    "meinst aber an seiner Seite einen kleinen Weg entdecken zu koennen.");    
  AddDetail( ({ "weg" }),
    "Am Rande des Berges scheint sich ein Weg zu befinden. Um mehr zu sehen "
    "musst Du aber wohl naeher rangehen.");    
  AddDetail( ({ "seite","rand" }),
    "Am unteren Rand des Berges, also an seiner Seite, befindet sich ein "
    "schmaler Weg.");    
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau und eine warme Sonne lacht Dich an.");    
  AddDetail( ({ "wasser" }),
    "Du bist von Wasser umgeben. Ausser im Westen.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern der Wellen.");
  AddSound( ({ "plaetschern","wellen" }),
    "Die Wellen plaetschern leise vor sich hin.");  
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Meer.");

  AddSmell( ({ "meer", "salz", "fisch", "seetank" }),
    "Das Meer riecht nach Salz, Fisch und Seetank.");

  AddRoomMessage( 
    ({""}),30,"func");




//AddItem(CAN_NPC + ".lpc",REFRESH_DESTRUCT);
AddExit( "westen", CAN_ROOM + "caniba_3h.lpc" ); 

}

string wesen()//soll einfach die long des Betrachters zurueckgeben
 {
 	string aussehen;
 	aussehen = TP->QueryProp(P_INT_LONG);

	  return aussehen;
	  }