inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knochenschild");
  SetProp(P_LONG,
    "Du siehst einen bleichen Schild, welcher aus vielen kleinen Knochen "
    "zusammengebaut wurde." );

  SetProp(P_NAME, "Knochenschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"knochenschild", "schild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 250);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  AddProp(P_DAM_PROTECTION, ([DT_BLUDGEON]) );
	SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_SLASH:1]) );
  	
}

