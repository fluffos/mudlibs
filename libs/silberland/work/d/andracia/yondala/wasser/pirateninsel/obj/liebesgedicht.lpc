
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Liebesgedicht");
  SetProp(P_LONG,
    "Du siehst ein Stueck Pergament auf dem etwas geschrieben steht." );
  SetProp(P_NAME, "Liebesgedicht");
  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, NEUTER);
  AddId(({"gedicht","liebesgedicht","pergament", "\nliebesgedicht","\nhildgundeitem"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 0);
  AddReadDetail( ({ "gedicht","liebesgedicht","pergament","liebesbrief" }),
    "Du liest das Gedicht und bist begeistert. Soviel Liebe, Herzschmerz und Gefuehl hast Du "
    "noch nie in Wort gefasst gelesen.");    
 

}
