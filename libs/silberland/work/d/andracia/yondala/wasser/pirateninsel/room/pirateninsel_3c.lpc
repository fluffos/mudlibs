//sl fertig
//cmd mit kletter / steige runter

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Erhebung" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem grossen Felsen der etwas hoeher liegt als die Umgebung. "
    "Rund um Dich herum ist nur Stein und Fels. Die Sonne lacht von oben auf Dich herab. "
    "Unter Dir ist eine Spalte." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden" }),
    "Du stehst auf moosbewachsenen Steinen. Ausserdem siehst Du zwischen den Steinen einen Spalt.");

  AddDetail( ({ "stein", "steine", "steinen" }),
    "Auf den Steinen waechst Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos ist mal sehr dicht, mal spaerlich.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "suedosten" }),
    "Im Suedosten ist eine leichte Erhebung.");
  AddDetail( ({ "boden" }),
    "Du stehst auf moosbewachsenen Steinen.");
  AddDetail( ({ "woelkchen" }),
    "Es ist keines zu sehen.");

  AddDetail( ({ "erhebung", "hoehe" }),
    "Du stehst auf einem Fels, der etwas hoeher ist als die Felsen drumherum.");

  AddDetail( ({ "felsen", "fels" }),
    "Die anderen Felsen sind nicht so hoch wie der, auf dem Du stehst. Nur weiter im "
    "Osten siehst Du einen, der etwa die selbe Hoehe hat.");

  AddDetail( ({ "osten" }),
    "Im Osten ist ein Fels, der die selbe Hoehe hat wie der, auf dem Du stehst. Du kannst "
    "ihn von hier aus allerdings nicht erreichen.");

  AddDetail( ({ "spalt", "spalte" }),
    "Der Spalt ist recht gross. Du kannst hinab steigen.");  
  
  AddDetail( ({ "blau" }),
    "Ein praechtiges Blau.");

  AddDetail( ({ "umgebung" }),
    "Die Umgebung liegt etwas niedriger als der Fels auf dem Du stehst.");  

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer" }),
    "Du kannst das Meer zwar gerade nicht sehen, aber es rauscht bis hierher.");
  AddSound( ({ "schrei", "moewe" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief ein und wieder aus. Herrlich, dieser Geruch.");

  

 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_2b" );
 AddExit( "unten", PIR_ROOM + "piratengrotte_3c" ); 

 
 AddCmd( ({ "steige","steig","kletter", "klettere" }), "klettern" );  

}

int klettern(string str)
{
  notify_fail("Wohin moechtest Du steigen?\n");
  if(str=="runter"||str=="hinunter"||str=="herab"||str=="hinab"||str=="nach unten")
   {
     TP->move( PIR_ROOM+"piratengrotte_3c", M_GO);
	 return 1;
	 }
   return 0;
   }
