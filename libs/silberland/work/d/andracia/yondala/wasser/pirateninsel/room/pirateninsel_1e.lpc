//Forscherpunkt auf "weniger nette Idee"
// Eine Moewenkollonie.
// Man kann einmal pro Reset ein Kueken erforschen, das man entweder platttreten oder ins Netz zuruecksetzen kann.
// Die Entscheidung beeinflusst die Gesinnung mit +- 10

//Ueberarbeitet fuer das Silberland
//Yondala@Silberland 14. April 2010

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/room";
int kueken;//1= ein Kueken ist aus dem Nest gefallen.


//Setzt alle Details so, dass das Kueken da ist
void kuekenda()
{  
	kueken=1;
	AddSound( ({ "piepsen" }),
    "Du lauscht angestrengt. Ja, Du hoerst ein trauriges Piepsen. Es scheint hinter dem grossen Stein neben "
    "Deinen Fuessen herzukommen.");
  AddDetail( ({ "stein" }),
    "Was da wohl hinter ist?");
  AddDetail( ({ "hinter stein" }),
    "Hinter dem grossen Stein liegt ein kleines Kueken, das wohl aus dem Nest gefallen ist.");
  AddDetail( ({ "kueken" }),
    "Oh, dieses arme kleine Kueken, was kannst Du bloss tun? \nDir kommen da spontan zwei Ideen.");
  AddDetail( ({ "ideen" }),
    "Du hast eine nette und eine weniger nette Idee.");
  AddDetail( ({ "idee" }),
    "Meinst Du die nette Idee oder die weniger nette Idee?");
  AddDetail( ({ "nette idee" }),
    "Du koenntest das arme kleine Kueken zurueck ins Nest setzen.\n");
  AddDetail( ({ "weniger nette idee" }),
    "Du koenntest dieses nervige Viech einfach platttreten.");
  AddDetail( ({ "viech" }),
    "Ist doch wahr. Wenn es groesser ist, klaut es Dir Dein Essen und scheisst Dich voll.");
}

//Setzt alle Details so, dass das Kueken nicht mehr da ist
void kuekenweg()
{  
	AddSound( ({ "piepsen" }),
    "Du lauscht angestrengt. Ja, hin und wieder hoerst Du das Piepsen der Jungtiere, die hungrig in ihren Nestern sitzen.");
  AddDetail( ({ "stein" }),
    "Ein Stein sieht aus wie der andere.");
  RemoveDetail(({"ideen","idee","nette idee","weniger nette idee","hinter stein","viech"}));
  AddDetail( ({ "kueken" }),
    "Im Moment sitzen alle Kueken ordnungsgemaess in ihrem Nest.");

}


void reset()
{
	::reset();
		kuekenda();
		tell_room(TO,"Ein kleines Kueken plumpst aus seinem Nest.\n");
	}
	
void create() 
{
  ::create();
kueken=1;
   SetProp( P_INT_SHORT, "Auf einer hohen Klippe" );
   SetProp( P_INT_LONG,
    "Du befindest Dich auf einer sehr hohen Klippe. Um Dich herum flattern und fliegen "
    "hunderte und tausende von Moewen und verursachen ein Geschrei, dass Du Dein eigenes "
    "Wort nicht mehr verstehen kannst. In jedem Spalt zwischen den Steinen und auf jedem "
    "noch so kleinen Fleckchen Flaeche quetscht sich ein Nest an das andere. "
    "Im Norden geht es steilabwaerts. Am strahlenden Himmel "
    "lacht die Sonne auf Dich herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer sehr hohen Klippe.");

  AddDetail( ({ "steine" }),
    "Von den Steinen siehst Du nicht viel, sie sind fast vollstaendig von Nestern und nistenden Moewen verdeckt.");

  AddDetail( ({ "spalt" }),
    "Jeder Spalt ist mit Stroh, kleinen Aesten, Federn und allem erdenklichen Baumaterial, "
    "das man braucht um ein gutes, solides Nest zu bauen.");
 
  AddDetail( ({ "stroh" }),
    "Vermutlich ist es eher Heu, Du meinst in dem Stroh das Duenengras aus dem Sueden wieder zu erkennen.");
 
  AddDetail( ({ "heu" }),
    "Heu ist getrocknetes Gras.");

  AddDetail( ({ "gras" }),
    "In diesem Fall handelt es sich um das Duenengras aus dem Sueden der Insel.");

  AddDetail( ({ "fall" }),
    "Sonst ist das auch schonmal anders.");

  AddDetail( ({ "duenengras" }),
    "Die Moewen benutzen gerne Duenengras um ihre Nester zu polstern.");

  AddDetail( ({ "sueden" }),
    "Suedlich von hier sind sandige Duenen. Du kannst sie bereits sehen.");

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand.");

  AddDetail( ({ "sand","huegel" }),
    "Geh doch einfach in den Sueden der Insel um mehr zu erfahren.");

  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer Insel.");

  AddDetail( ({ "norden" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");
 AddDetail( ({ "blau" }),
    "Es ist das schoenste Blau, dass Du heute gesehen hast.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht vermutlich aus Steinen, allerdings ist er mit einer weissen Substanz und "
    "allerhand Unrat bedeckt.");

  AddDetail( ({ "substanz" }),
    "Du vermutest, dass es sich um Moewenschiss handelt.");

  AddDetail( ({ "moewenschiss","schiss" }),
    "Ganz sicher bist Du nicht. Du koenntest ja mal daran riechen.");

 
  AddDetail( ({ "unrat" }),
    "Hauptsaechlich handelt es sich wohl um Essensreste der Moewen und Eierschalen. ");


  AddDetail( ({ "eierschalen","schalen" }),
    "Aus diesen Eierschalen sind die Moewen, die hier rumflattern, einst geschluepft.");
  AddDetail( ({ "essensreste","reste" }),
    "Ueberall auf dem Boden verstreut liegen Graeten, Krebspanzer und Muschelschalen herum.");
  AddDetail( ({ "graeten", "krebspanzer","panzer", "muschelschalen" }),
    "Das sind die Reste, die bei einer Moewenmahlzeit uebrigbleiben.");
  AddDetail( ({ "moewenmahlzeit" }),
    "Eine Moewenmahlzeit kann aus allem moeglichen bestehen. Moewen sind meist nicht waehlerisch.");
  AddDetail( ({ "woelkchen" }),
    "Keins da.");
  AddDetail( ({ "flaeche" }),
    "Freie Flaeche gibt es hier eigentlich nicht. Ueberall sind Moewennester, Unrat oder Fuesse.");
  AddDetail( ({ "fuesse" }),
    "Deine Fuesse.");
  AddDetail( ({ "fleckchen" }),
    "An jedem irgendwie moeglichen Fleckchen an dieser Klippe klebt ein Moewennest neben dem anderen. "
    "Bei einigen bist Du Dir nicht sicher, ob sie nicht von der naechsten Windboe herunter geweht werden.");
  AddDetail( ({ "wind","windboe" }),
    "Es ist wirklich sehr windig hier oben.");
  AddDetail( ({ "moewennest","nest","moewennester","nester" }),
    "Wohin Du auch siehst: ueberall tuermen sich die Nester, eins neben dem anderen. Du fragst Dich, wie die "
    "Moewen, die ja nicht grad zu den schlauen Wesen auf dieser Welt gehoeren, hier den Ueberblick behalten koennen.");
  AddDetail( ({ "wesen" }),
    "Du bist natuerlich viel schlauer als eine Moewe.");
  AddDetail( ({ "welt" }),
    "Du hast sicher schon einiges von dieser Welt gesehen.");
  AddDetail( ({ "ueberblick" }),
    "Du fragst Dich, ob wirklich jede Moewe immer in ihr eigenes Nest fliegt, oder ob es den Moewen vielleicht "
    "sogar egal ist, wessen Nachwuchs sie fuettern.");
  AddDetail( ({ "nachwuchs" }),
    "Hin und wieder siehst Du kleine, spitze Schnaebel aus den Nestern rausschnellen um die kleinen Leckerbissen "
    "zu schnappen, die die ausgewachsenen Moewen zu den Nestern bringen.");
  AddDetail( ({ "schnaebel", "schnabel" }),
    "Kleine, gierige Schnaebel, die zu Jungtieren gehoeren, die in den Nestern sitzen und einander nicht den "
    "kleinsten Bissen goennen.");
  AddDetail( ({ "leckerbissen","bissen" }),
    "Die bestehen hauptsaechlich aus Fischen.");
  AddDetail( ({ "fische" }),
    "Die Fische schwimmen im Meer und werden hin und wieder von Moewen verspeist.");
  AddDetail( ({ "jungtiere","jungtier" }),
    "In vielen der Nester hocken ein oder mehrere Jungtiere und lauern auf die Leckerbissen, die ihnen "
    "in den Schnabel gesteckt werden.");
  AddDetail( ({ "federn" }),
    "Die Federn machen ein Nest schoen weich.");
  AddDetail( ({ "aeste" }),
    "Die Aeste machen ein Nest schoen stabil.");
  AddDetail( ({ "baumaterial" }),
    "Alles, was sich irgendwie dazu eignet, haben die Moewen in ihren Nestern verbaut.");
  AddDetail( ({ "stein" }),
    "Was da wohl hinter ist?");
  AddDetail( ({ "hinter stein" }),
    "Hinter dem grossen Stein liegt ein kleines Kueken, das wohl aus dem Nest gefallen ist.");
  AddDetail( ({ "kueken" }),
    "Oh, dieses arme kleine Kueken, was kannst Du bloss tun? \nDir kommen da spontan zwei Ideen.");
  AddDetail( ({ "ideen" }),
    "Du hast eine nette und eine weniger nette Idee.");
  AddDetail( ({ "idee" }),
    "Meinst Du die nette Idee oder die weniger nette Idee?");
  AddDetail( ({ "nette idee" }),
    "Du koenntest das arme kleine Kueken zurueck ins Nest setzen.\n");
  AddDetail( ({ "weniger nette idee" }),
    "Du koenntest dieses nervige Viech einfach platttreten.");
  AddDetail( ({ "viech" }),
    "Ist doch wahr. Wenn es groesser ist, klaut es Dir Dein Essen und scheisst Dich voll.");
  AddDetail( ({ "essen" }),
    "Moewen klauen alles, dessen sie habhaft werden koennen.");
  AddDetail( ({ "moewen" }),
    "Ueberall um Dich herum flattern Moewen oder sitzen auf Steinen und Nestern und beobachten Dich.");
  AddDetail( ({ "moewe" }),
    "Die Moewen flattern so schnell und nervig um Dich herum, dass Du kaum eine laenger fixieren "
    "kannst um sie Dir genauer anzusehen.");
  AddDetail( ({ "wort" }),
    "Es ist wirklich sehr laut hier.");
 AddDetail( ({ "haare" }),
    "Hoffentlich reist der Wind sie Dir nicht aus.");
 AddDetail( ({ "ohr","ohren" }),
    "Du hast beide Ohren noch.");
 AddDetail( ({ "fluegelschlag", "ruecksicht" }),
    "Die Moewen nehmen aber auch wirklich keinerlei Ruecksicht.");
 AddDetail( ({ "krebs" }),
    "Den Krebs wird es nicht mehr lange geben.");
 AddDetail( ({ "" }),
    "");


  AddReadDetail( ({ "" }),
    "");
  AddSound( DEFAULT_SOUND,
    "Du hoerst eigentlich nichts, ausser dem Gekreische der Moewen, das jedes andere Geraeusch uebertoent.");

  AddSound( ({ "gekreische","kreischen", "geschreie", "moewen" }),
    "Das Geschreie und Gekreische der Moewen ist wirklich ohrenbetaeubend.");
  AddSound( ({ "geraeusch" }),
    "Oder war da nicht doch etwas anderes? Ein leises, klaegliches Piepsen?");
  AddSound( ({ "piepsen" }),
    "Du lauscht angestrengt. Ja, Du hoerst ein trauriges Piepsen. Es scheint hinter dem grossen Stein neben "
    "Deinen Fuessen herzukommen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier irgendwie muffig, nach Moewenschiss und Fischresten.");

  AddSmell( ({ "moewenschiss", "schiss","scheisse","moewenscheisse" }),
    "Der Moewenschiss regnet hier ja regelmaessig auf den Boden. Er riecht nicht gut.");
  AddSmell( ({ "fischreste","reste" }),
    "Das, was die Moewen uebriglassen, ist nicht viel, riecht aber um "
	"so schlimmer.");
    


  AddRoomMessage( 
    ({"Eine Moewe segelt knapp an Deinem Kopf vorbei.\n",
    	"Zwei Moewen streiten sich um einen Krebs.\n",
    	"Eine Moewe landet in ihrem Nest.\n",
    	"Der Wind weht ein Nest fast ueber die Klippe.\n",
    	"Der Wind zerrt an Deinen Haaren.\n",
    	"Eine Moewe beaeugt Dich neugierig.\n",
    	"Eine Moewe versucht, Dir etwas zu stehlen.\n",
    	"Mehrere Moewen flattern ploetzlich hoch, irgendetwas scheint sie erschreckt zu haben.\n",
    	"Ein Fluegelschlag streift Dich am Ohr.\n",
    	"Eine Moewe schiesst in die Tiefe und laesst sich ins Meer fallen.\n",
    	"Neben Dir schraubt sich eine Moewe in die Hoehe.\n",
        "Fast haette eine Moewe Dir auf den Kopf geschissen. Du kannst grad noch ausweichen.\n"		}),30);
    	

 



  AddDetail( ({ "" }),
    "");


  AddSound( ({ "geschrei" }),
    "Das laute Geschrei der Moewen ist kaum zu ertragen.");

  AddSmell( ({ "schiss","moewenschiss","substanz" }),
    "Uah, ja, angenehm ist was anderes. Das riecht ziemlich doll nach Moewenschiss.");




AddExit( "suedosten", "./pirateninsel_2f" );
AddExit( "westen", "./pirateninsel_1d" );

AddCmd(({"setze","setz"}),"zuruecksetzen");
AddCmd(({"trete","tret","tritt"}),"platttreten");


}




int zuruecksetzen(string str)
{
	int align;
	notify_fail("Was moechtest Du wohin setzen?\n");
	if (str=="kueken in nest"||str=="kueken in nest zurueck"||str=="kueken zurueck in nest"||
		  str=="kueken in moevennest"||str=="kueken in moevennest zurueck"||str=="kueken zurueck in moevennest")
		{
			if(kueken)
				{
					write("Vorsichtig nimmst Du das arme kleine Kueken und setzst es in eines der Nester.\n");
					say(TPN+" nimmt ein herausgefallenes Kueken und setzt es in eines der Nester.\n",TP);
					//align =TP->Queryprop(P_ALIGN);
					//align+=10;
					TP->SetProp(P_ALIGN, (TP->QueryProp(P_ALIGN)+10));
					kuekenweg();
					kueken=0;
				}
			else
				{
					write("Im Moment sitzen alle Kueken ordnungsgemaess in ihrem Nest.\n");
					return 1;
				}
			return 1;
	}
	return 0;
}

int platttreten(string str)
{
	notify_fail("Was moechtest Du platttreten?\n");
	if (str=="kueken"||str=="kueken platt"||str=="moewenkueken"||str=="moewenkueken platt")
		{
			if(kueken)
				{
					write("Du hebst Deinen Fuss und laesst ihn kraeftig auf das Moewenkueken stampfen.\nVorsorglich drehst "
					"Du deinen Fuss noch ein bisschen hin und her.\nDas matschende Geraeusch ist wie Musik in Deinen Ohren.\n");
	
					say(TPN+" tritt ein kleines Kueken platt.\n",TP);
					TP->SetProp(P_ALIGN, TP->Queryprop(P_ALIGN)-10);
					kuekenweg();
					kueken=0;
				}
			else
				{
					write("Im Moment sitzen alle Kueken ordnungsgemaess in ihrem Nest.\n");
					return 1;
				}
			return 1;
	}
	return 0;
}