//Yondala@Silberland 24.05.2010
// wird geclont, wenn jemand den Drachen aus obj steigen laesst. Verfolgt 
// den Spieler

//25.3.2011: P_HANDS auskommentiert und Rasse auf Drache gesetzt



#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <moredef.h>
#include <npc.h>
inherit "std/npc";

object schnur;

void schnurkriegen(object ob)
{schnur=ob;}

void verfolgen(object spieler)
{
  spieler->AddPursuer(TO);
  SetProp(P_LONG,
    "Du siehst einen kleinen, bunten Papierdrachen, der ein lustiges "
	"Gesicht und zwei niedliche Schleifchen hat. "+spieler->name()+
	" haelt seine Schnur fest.");
  SetProp(P_MSGOUT, "fliegt "+spieler->name(WEM)+" hinterher");
}  
 
 void fallengelassen()
 {
   CLONE(PIR_OBJ +"papierdrache",environment(TO));
   schnur->remove();
   remove();
 }

void create() 
{

  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(1);
  SetProp(P_SHORT, "Ein Papierdrache");
  SetProp(P_LONG,
    "Du siehst einen kleinen, bunten Papierdrachen, der ein lustiges "
	"Gesicht und zwei niedliche Schleifchen hat. Jemand haelt seine "
	"Schnur fest.");
  SetProp(P_NAME, "Papierdrache");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId(({"drache","papierdrache"}));
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOATTACK, "Der Papierdrache fliegt zu hoch.\n");
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "steigt in die Luft");
  SetProp(P_MMSGOUT, "reisst sich los");
/*NAME:
    P_TEMPERATURE_RANGE           "temperature_range"

DEFINIERT IN:
    /sys/living/life.h

BESCHREIBUNG:
    Temperaturbereich, in dem sich ein Spieler 'wohl fuehlt'.
    Fuer Spieler derzeit einheitlich ([T_RANGE_MIN:5,T_RANGE_MAX:25]),
    d.h. 5-25 Grad, fuer NPCs 0-40 Grad.
    Wenn Raumtemperatur+Temperaturschutz+Temperaturoffset nicht
    innerhalb dieses Bereichs liegen, ergeben sich Auswirkungen auf
    den Spieler.*/
	SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
	
  SetProp(P_DIE_MSG,  " faellt kaputt zu Boden.\n");
//SetProp(P_HANDS, ({"mit nichts",QueryProp(P_HANDS)[2],DT_BLUDGEON}));
  SetProp(P_RACE, "Drache");
  AddDetail( ({ "gesicht" }),
    "\n"
    "         /\\             \n"
	"        /  \\            \n"
	"       /O  O\\           \n"
	"    >>/  °   \\<<        \n"
	"      \\  V   /          \n"
	"       \\    /    _      \n"
	"        \\  /    /        \n"
	"         \\/  >><<       \n"
	"          \\__/          \n");
 
 AddDetail( ({ "schleifchen" }),
    "Rechts und links des Gesichts siehst Du zwei kleine Schleifchen");
 AddDetail( ({ "mittelstange","stange" }),
    "Die Mittelstange ist leider gebrochen");
 AddDetail( ({ "schnur" }),
    "Die Schnur baumelt an dem Drachen.");
  


}

void remove(int silent)
{
  schnur->remove();
  ::remove();
}


void die(int poisondeath)
{
 schnur->remove();
 ::die();
}
