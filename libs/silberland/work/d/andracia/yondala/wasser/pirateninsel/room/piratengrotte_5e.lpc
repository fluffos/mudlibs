#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std";
#include <properties.h>

void create() 
{
	
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Osten siehst Du den Eingang zu einer Kneipe. \n" );


  AddDetail( ({ "eingang"}),
    "Ueber dem Eingang steht geschrieben: \"Zum freien Elf\".");    
  AddDetail( ({ "elf" }),
    "Nun, der Elf wird sicher drin sein.");    
  AddDetail( ({ "kneipe" }),
    "Du kannst sie betreten.");    
  AddDetail( ({ "" }),
    "");    



AddExit( "norden", PIR_ROOM + "piratengrotte_4e" ); 
AddExit( "sueden", PIR_ROOM + "piratengrotte_6e" ); 
AddExit( "osten", PIR_ROOM + "piratengrotte_5f" ); 


}

