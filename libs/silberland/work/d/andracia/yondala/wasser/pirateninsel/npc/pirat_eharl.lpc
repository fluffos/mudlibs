void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;


      call_out("reaction", 0, TP,
        "sagt: Stoert mich nicht, bei meinen Geschaeften!",
        "sagt: Stoert mich nicht, bei meinen Geschaeften!");
  
  
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void tuerauf()
{
	say("Eharl greift sich stoehnend an den Kopf.\nDie Barriere an der Tuer verschwindet.\n");
    call_other(PIR_ROOM+"piratengrotte_4b", "tuerauf");
	call_other(PIR_ROOM+"piratengrotte_4c", "tuerauf");
}  

//Nur Piraten
int eroeffnen(string str)
{
	if (str!="konto")
	{
		write("Eharl sagt: Was moechtet Ihr eroeffnen?\n");
		return 1;
	}
	else
	{
		if (present ("\nschwarzgeldring",  TP))
		{
			write("Eharl sagt: Ihr habt doch schon ein Schwarzgeldkonto bei mir!\n");
			return 1;
		}
//noch testen
if(TP->QueryProp(P_GUILD)!="piratenmeute")
	{
		command("sag Nein, "+TPN+", Ihr seid kein Pirat, Euch gebe ich kein Konto, scherrt Euch fort!");
		return 1;
	}
		else
		{
			command("sag Wohlan, hier habt Ihr einen Ring von mir der Euch als meinen Kunden auszeichnet. Solltet Ihr ihn mal verlieren, loesche ich Euer Konto. Also gebt gut Acht!");
			CLONE(PIR_ARMOUR + "schwarzgeldring", TP);
			return 1;
		}
	}
}



void InformDefend(object enemy)
{
 Kill(enemy);
}


//anstatt zu sterben heilt sich Eharl an seinen Beschuetzern.
//Solange einer von den beiden noch lebt, kann er nicht sterben
void die()
{
 int i;
	int neuesleben;
		 if (!present ("beschuetzer", environment(this_object())))
		 	{
		 		call_out("tuerauf");
				if(sizeof(feinde))
				{
				for (i=sizeof(feinde)-1;i--;i>0)
				  {
					if(feinde[i]->QueryProp(P_PARALYZED))
					  feinde[i]->SetProp(P_PARALYZED,0);					
  		          }
				}
	
		 		::die();		
		 	}
	else //wenn noch ein Beschuetzer da ist
		{
			say("Eharl heilt sich an seinem Beschuetzer.\n");
			aussaug=present("beschuetzer", environment(this_object()));
			neuesleben=aussaug->QueryProp(P_HP);
			//this_object
			TO->AddHp(neuesleben);
			aussaug->SetProp(P_HP, 0);
			}
	
	}


void verwirrt(object enemy, int damage, mixed dam_type) 
{
	int i;
	//object *feinde;
	object *keinfeind;
	keinfeind=({});
	//wenn es irgendwie schon Feinde gibt derzeit
	if (sizeof(feinde)) return;
	
	//wenn die beiden Waechter nicht da sind	 
	 if (!present ("beschuetzer", environment(this_object())))
     {
     	feinde=PresentEnemies();
 	    command("sag Feinde jetzt: "+sizeof(feinde));
 	    keinfeind=all_inventory(environment(TO)); //alles was im Raum ist
		keinfeind=keinfeind-({TO}); //Eharl raus
		for(i=sizeof(keinfeind);i--;i>=0)
		{
		 //command("sag "+keinfeind[i]->name());
		  //alles was Spieler ist und nicht kaempft fliegt raus
		  if(interactive(keinfeind[i])&&member(feinde, keinfeind[i])==-1&&keinfeind[i]->name()!="Yondala")
		  {
		    command("sag Raus mit den Gaffern!");
       	    tell_object(keinfeind[i],"Eharl wirft Dich raus und verriegelt die Tuer hinter Dir.\n");
			keinfeind[i]->move(PIR_ROOM+"piratengrotte_4c", M_GO ,
 	                    "","fliegt im hohen Bogen aus dem Raum",
						"fliegt im hohen Bogen aus dem Raum im Westen");
		  
		   }
		 }
		


    	command("sag Nun gehoert Ihr mir!");
    	call_other(PIR_ROOM+"piratengrotte_4b", "tuerzu");
		call_other(PIR_ROOM+"piratengrotte_4c", "tuerzu");
		//i=sizeof(feinde)-1;
    	for (i=sizeof(feinde);i--;i>=0)
    	{
		
 	        //command("sag "+i);
            //command("sag u "+feinde[i]->name());
            //command("sag "+sprintf("%O",feinde[i]));
			StopHuntFor(feinde[i],0);
			feinde[i]->StopHuntFor(TO,0);
			feinde[i]->SetProp(P_PARALYZED,([PARALYZE_TIME:-1, 
			PARALYZE_MSG:"Du hast vergessen, wie man sich bewegt.\n",
			PARALYZE_MSG_OTHER: feinde[i]->name()+" zuckt.\n", 
			PARALYZE_END: "Du schuettelst Dich und fuehlst Dich ploetzlich wieder klar.\n", 
			PARALYZE_END_OTHER:feinde[i]->name()+" schuettelt sich und scheint wieder klar denken zu koennen.\n"]));
    		
			feinde[i]->AddPoison(1); //leicht vergiften, damit niemand hochidlet			
    		tell_object(feinde[i],"Eharl dringt in Deinen Geist ein.\n");
    		}
 	
			//Tuer von beiden Seiten schliessen
			call_other(PIR_ROOM+"piratengrotte_4b", "tuerzu");
			call_other(PIR_ROOM+"piratengrotte_4c", "tuerzu");
			if(find_call_out("verwirrt2")==-1) call_out("verwirrt2", 2);//, feinde);	
			else command("sag Es gibt schon einen call_out");
			}

 		

    else //wenn mindestens einer noch da ist
    	{
    		write("Eharl verwirrt Dich so sehr, dass Du vergisst, wie man zaubert.\n");
     		say("Eharl verwirrt "+enemy->name(WEN)+".\n",enemy);
     		spellpause = random(15);
     		spellpause +=15;
     		enemy->SetProp(P_NEXT_SPELL_TIME, time()+ spellpause); 

    	 	}
}

//kuerzere Version
void verwirrt2()//object *feinde)
{
 	int i;
	int was;//was passiert als naechstes?
	string text;
	i=sizeof(feinde)-1;
	was=random(6);
	if(i==-1) return; //falls keine Feinde da sind. Raeume dann noch oeffnen (falls Feind tot oder so)
	     
		 if(was==0) tell_room(environment(TO),"Eharl schaut Dir tief in die Augen.\n");
	else if(was==1) tell_room(environment(TO),"Eharl murmelt etwas.\n");
	else if(was==2) tell_room(environment(TO),"Eharl macht anmutige Gesten.\n");
	else if(was==3) tell_room(environment(TO),"Eharl scheint Dich mit seinem Blick zu durchbohren.\n");
	else if(was==4) tell_room(environment(TO),"Kleine Blitze schiessen aus Eharls Augen.\n");
	else
	{call_out("verwirrt3",4);//,feinde);
	 return;}
	call_out("verwirrt2",4);//,feinde);
}



void verwirrt3()//object *feinde)
{
	
	int i;
	//i=sizeof(feinde)-1;
  for (i=sizeof(feinde)-1;i--;i>0)
  	{
  		tell_object(feinde[i],"Du wehrst Dich verzweifelt gegen Ehalrs Gedanken.\nEharl runzelt die Stirn.\n");
  		}
	call_out("verwirrt4",4);//, feinde);
}

void verwirrt4()//object *feinde)
{
	int i;
    //i=sizeof(feinde)-1;
 	tell_room(environment(TO),"Eharl schreit wuetend auf.\n");
    for ( i=sizeof(feinde);i--;i>=0)
  	{   		
    	feinde[i]->SetProp(P_PARALYZED, 0);
		tell_room(environment(TO),"Eharl schreit wuetend auf.\n");
		if(present(feinde[i], environment(TO)))Attack(feinde[i]); 
    	}
//int auf=random(15);
//call_out("tuerauf",1);
	tuerauf();
    feinde=({});
}       
     
     
   
     
 
