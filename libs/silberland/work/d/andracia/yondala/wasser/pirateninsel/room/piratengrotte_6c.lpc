#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std";
#include <properties.h>

void create() 
{
  ::create();
   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) +"Im Westen liegt eine kleine Anlegestelle." );

  AddDetail( ({ "anlegestelle","westen" }),
    "Im Westen liegt eine kleine Anlegestelle. Du kannst sie betreten.");    
  AddDetail( ({ "" }),
    "");    





AddExit( "norden", PIR_ROOM + "piratengrotte_5c" ); 
AddExit( "westen", PIR_ROOM + "piratengrotte_6b" ); 
AddExit( "osten", PIR_ROOM + "piratengrotte_6d" ); 

}

