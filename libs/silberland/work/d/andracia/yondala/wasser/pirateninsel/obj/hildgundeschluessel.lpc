
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner rostiger Schluessel");
  SetProp(P_LONG,
    "Du haelst eine kleinen, rostigen Schluessel in den Haenden. Was mach damit wohl oeffnen kann?" );
SetProp(P_NAME_ADJ, "rostig");
  SetProp(P_NAME, "Schluessel");

  SetProp(P_GENDER, MALE);
  AddId(({"schluessel","\nhildgundeschluessel", "\nhildgundeitem"}));

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
 

}
