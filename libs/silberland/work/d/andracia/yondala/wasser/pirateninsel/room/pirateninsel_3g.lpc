#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einer Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Klippe. Der Wind tost um Dich herum und "
	"wirft Dich fast um. Der Boden besteht aus moosbewachsenen Steinen, "
	"viel mehr gibt es hier kaum. Neben Dir geht es steilabwaerts, fern "
	"im Suedwesten siehst Du eine weite Duenenlandschaft, im Nordwesten "
	"kannst Du weiter die Klippen besteigen. Ein grosser Steinhaufen "
	"liegt neben dem Weg. Am strahlenden Himmel lacht die Sonne auf Dich "
	"herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

   AddDetail( ({ "klippe", "klippen" }),
    "Du befindest Dich auf einer Klippe die vom Wind gepeinigt wird. "
	"Neben Dir geht es steil abwaerts in die Tiefe.");
  AddDetail( ({ "tiefe" }),
    "Dir wird ganz schwindelig beim runter gucken.");
  AddDetail( ({ "weg","pfad" }),
    "Nun, ein wirklicher Weg ist es nicht. Zumindest aber ist es ein "
	"Pfad zwischen den Klippen.");
  AddDetail( ({ "steinhaufen","haufen" }),
    "Der Steinhaufen tuermt sich gleich neben Dir auf. Was es damit wohl "
	"fuer eine Bewandtnis hat?");
  AddDetail( ({ "bewandtnis" }),
    "Ob es sich lohnt, in dem Steinhaufen zu wuehlen?");


  AddDetail( ({ "steine" }),
    "Die Steine sind allesamt gross und unbearbeitet. Auf manchen waechst ein bisschen Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos waechst auf einigen Stellen sehr dicht und in einem satten Gruen, an anderen ist "
    "es eher ausgetrocknet und gelb.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die scharfen Felsen unter Dir.");

  AddDetail( ({ "suedwesten" }),
    "Suedlich von Dir gehen die Felsen in Duenen ueber.");
  AddDetail( ({ "duenen", "duenenlandschaft" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Die Huegel, die Du suedwestlich von hier findest, sind aus Sand.");
  AddDetail( ({ "wind" }),
    "Der Wind blaest hier oben kraeftig, Du kannst Dich kaum auf den Beinen halten.");
  AddDetail( ({ "beine" }),
    "Noch tragen sie Dich, wohin Du willst.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");
  AddDetail( ({ "woelkchen" }),
    "Es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "boden" }),
    "Du stehst auf harten Fels.");


  AddDetail( ({ "sand", "steinchen" }),
    "Sand besteht aus winzigkleinen Steinchen.");

  AddDetail( ({ "stellen" }),
    "An den eher schattigen Stellen waechst das Moos saftiger als an den Stellen, "
    "an denen es der Sonne schutzlos ausgeliefert ist.");

  AddDetail( ({ "blau" }),
    "Wirklich, ein praechtiges Blau.");
  AddDetail( ({ "gruen" }),
    "Das Gruen des Mooses ist mal heller, mal satter.");
  AddDetail( ({ "nordwesten" }),
    "Nach Nordwesten kannst Du weiter die Klippen besteigen.");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhythmus" }),
    "Hmmmm, beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddRoomMessage( 
    ({""}),30,"func");

  

 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_2f" );
// AddExit( "sueden", PIR_ROOM + "pirateninsel_4g" );
   AddExit( "sueden", PIR_ROOM + "pirateninsel_4g" );
 AddCmd(({"wuehle","wuehl"}),"durchwuehlen");
 

}
int durchwuehlen(string str)
{
  notify_fail("Worin moechtest Du wuehlen?\n");
  if (str!="in haufen"&&str!="in steinhaufen") return 0;
  write("Du wuehlst in dem Steinhaufen herum und findest ein paar Knochen, "+
        "die verdammt menschlich aussehen.\nSchnell legst Du die Steine "+
		"wieder so hin, wie sie waren.\n");
  say(TPN+" wuehlt in einem Haufen Steine herum.\n");
  return 1;
  }