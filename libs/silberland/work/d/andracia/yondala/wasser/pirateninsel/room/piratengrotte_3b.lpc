// Iskirs Schnappsladen
// Verkauft: 	Weinflasche
// 						Fuselflasche
//						Rumfass (1*pro Reset)

inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>
void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem schummrigen Schnapsladen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Schnapsladen von Iskir Kiarson. Das Licht hier ist schummrig, "
    "denn es gibt quasi keine Lichtquellen. Nur durch die offene Tuer dringt etwas Licht "
    "herein. An den Waenden stehen Regale voller Flaschen und Faesser." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_SPECIAL_SHOP, ([1:"Iskir sagt: Tut mir leid, ich kaufe nichts an!\n"]));
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetStorageRoom(PIR_ROOM + "lagerschnapsladen");
  SetProp(P_SHOPKEEPER_ID, "ISKIR");
  SetProp(P_SHOPKEEPER_NAME, "Iskir");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "schnapsladen" }),
    "Du befindest Dich in ihm.");    
  AddDetail( ({ "licht" }),
    "Das Licht faellt durch die offene Tuer herein.");    
  AddDetail( ({ "lichtquelle", "lichtquellen", "fackeln" }),
    "Die einzige Lichtquelle sind die Fackeln draussen.");    
  AddDetail( ({ "tuer" }),
    "Die Tuer ist eigentlich immer geoeffnet.");    
  AddDetail( ({ "wand","waende","waenden" }),
    "Die Waende sind roh in den Stein gehauen. Vor den unebenen Waenden stehen grob "
    "gezimmerte Regale.");    
  AddDetail( ({ "regale","regal" }),
    "Die Regale sind aus dunklem Holz. In ihnen befinden sich mehrere Faesser und Flaschen "
    "verschiedenster Form, Farbe und Groesse.");    
  AddDetail( ({ "faesser" }),
    "In den Faesser befindet sich entweder Rum oder Wein. Aber mit Sicherheit Alkohol.");    
  AddDetail( ({ "rum","wein","sicherheit","alkohol" }),
    "Frag doch Iskir, wenn Du mehr wissen moechtest.");    
  AddDetail( ({ "flaschen" }),
    "Es gibt sie in verschiedenster Form, Farbe und Groesse.");    
  AddDetail( ({ "form" }),
    "Duenn, bauchig, eckig, rund, oval, flach...");    
  AddDetail( ({ "farbe" }),
    "Rot, gelb, gruen, blau, braun...");    
  AddDetail( ({ "groesse" }),
    "Klein, gross, mittel, riesig, winzig...");    
  AddDetail( ({ "boden", "felsboden"}),
    "Der nackte Felsboden ist mit Holzdielen bedeckt.");
  AddDetail( ({ "fels", "stein", "felsgestein" }),
    "Um Dich herum ist alles aus Felsgestein.");    
  AddDetail( ({ "decke" }),
    "Die Decke ist relativ niedrig und besteht aus blankem Fels.");    
  AddDetail( ({ "holzdielen" }),
    "Sie scheinen dort schon laenger zu liegen, sind aber recht sauber.");    
  AddDetail( ({ "falltuer" }),
    "Du koenntest schwoeren, dass Du sie gesehen hast, aber irgendwie findest Du sie nicht mehr.");    
  AddDetail( ({ "holz" }),
    "Das alte Holz ist dunkel und schlecht verarbeitet. Man muss aufpassen, dass man "
    "sich nicht daran verletzt.");    
  AddDetail( ({ "iskiar","kiarson" }),
    "Iskir Kiarson ist wohl gerade nicht hier.");    
  AddDetail( ({ "weinfass" }),
    "Ein Weinfass steht etwas abseits von den anderen. Der Deckel scheint "
	"nicht richtig geschlossen zu sein.");    
  AddDetail( ({ "deckel" }),
    "Vielleicht kannst Du das Weinfass oeffnen?");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Gluckern.");

  AddSound( ({ "gluckern" }),
    "Es scheint aus einem der Faesser zu kommen.");
  AddSound( ({ "faesser" }),
    "Du weisst nicht genau aus welchem.");
  AddSound( ({ "weinfass" }),
    "Ein unregelmaessiges Gluckern kommt aus dem Weinfass.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach wiederlichem billigen Fusel.");

  AddSmell( ({ "fusel" }),
    "Er scheint hier oft verschuettet zu werden.");

  AddRoomMessage( 
    ({""}),30,"func");




AddItem(PIR_NPC + "pirat_iskir",REFRESH_DESTRUCT);
AddExit( "osten", PIR_ROOM + "piratengrotte_3c" ); 
AddCmd("oeffne", "oeffnen");
}

int oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str!="weinfass") return 0;
  write("Du oeffnest das Weinfass und wirfst einen Blick hinein.\n"+
        "In dem Weinfass schwimmt eine aufgequollene Leiche.\n"+
		"Angeekelt laesst Du den Deckel wieder fallen.\n");
  say(TPN+" oeffnet ein Weinfass und schaut hinein.\n",TP);
  return 1;
  }
