// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 27.04.2010
// Hier findet man einen Grashalm, den man pfluecken kann
#include "../def.h"

inherit "std/room";

#include <properties.h>
int halm =1;
void reset()
{::reset();
halm =1;}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen den Duenen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten zwischen den Duenen. Der Boden auf dem Du "
	"stehst besteht aus warmem, weichem Sand. Die Sonne steht an einem "
	"strahlend blauem Himmel und lacht auf Dich herunter. Das Laufen hier "
	"ist recht muehsam, da Du immer wieder einsinkst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft salzig.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
  AddDetail( ({ "grasbueschel", "bueschel" }),
    "Das Gras waechst hier nur sehr spaerlich.");
  AddDetail( ({ "gras" }),
    "Nur sehr wenige Halme halten sich hier.");
  AddDetail( ({ "halme" }),
    "Die meisten Halme sind graeulich und trocken. Nur ein Halm sieht frisch und gruen aus.");
  AddDetail( ({ "halm" }),
    "Dem Halm scheint es gut zu gehen.");
  AddDetail( ({ "laufen" }),
    "Du schleppst Dich muehsam durch den Sand.");
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht fast nur aus Sand. Nur hin und wieder kann sich ein Grasbueschel halten.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Du kannst das Meer rauschen hoeren. Es scheint also nicht weit entfernt zu sein.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht salzig nach Meer.");

  AddSmell( ({ "meer" }),
    "Es riecht salzig.");

  AddRoomMessage( 
    ({""}),30,"func");
 
  AddCmd( ({ "pflueck", "pfluecke" }), "pflueckenCmd" );

 AddExit( "norden", PIR_ROOM + "pirateninsel_5b" );
 AddExit( "sueden", PIR_ROOM + "pirateninsel_7b" ); 
 AddExit( "osten", PIR_ROOM + "pirateninsel_6c" );

}

pflueckenCmd(string str )
{
  notify_fail( "Was moechtest du pfluecken?\n" );
  if( str == "grashalm"||str== "halm" )
	{
		if (halm ==0)
		{
			write("Du bist zu schwach um den Grashalm zu pfluecken!\nVielleicht wartest Du noch ein bisschen?!\n");
			return 1;
		}
		else
		{  
			write("Du pflueckst einen kleinen Grashalm.\n");
			say(TPN+" plueckt einen kleinen Grashalm.\n",TP);
		   CLONE(PIR_OBJ +"grashalm", TP);
		   halm=0;
				return 1;
		}
	}
}
