//Die Liste auf der steht was man fuer die Quest noch benoetigt.

#include "../def.h"

inherit "std/thing";

#include <properties.h>

string zutat_a;
string zutat_b;
string zutat_c;
string zutat_d;
string zutat_e;
string zutat_f;
string zutat_g;
//muss mal noch geschickt sortiert werden
//kann noch erweitert werden
string *gruppe_a=({"moertel","stein", "kitt", "grashalm"});
string *gruppe_b=({"apfel","pflaumen", "kirschen", "birne", "aprikose"});
string *gruppe_c=({"banane", "pfirsich", "marille"});
string *gruppe_d=({"lollie", "kaese", "pilz","buchecker"});
string *gruppe_e=({"feder", "zwergenhaar"});
string *gruppe_f=({"anis","lavendel","melisse","kerbel","pfefferminze"});
string *gruppe_g=({"schmetterlingsfluegel", "kaeferzange"});

string *zutaten; //hierdrin stehen die tatsaechlichen Zutaten.
neueliste()//erstellt die neue Liste
{
	string lesedetail;
	lesedetail=  "\nZaubertrankzutaten\n";
	zutaten=({});
	if (zutat_a) 
		{
			lesedetail=lesedetail+capitalize(zutat_a)+"\n";
			zutaten=zutaten+({zutat_a});}
	
	if (zutat_b) 
		{
			lesedetail=lesedetail+capitalize(zutat_b)+"\n";
			zutaten=zutaten+({zutat_b});}
				
	if (zutat_c) 
		{
			lesedetail=lesedetail+capitalize(zutat_c)+"\n";
      zutaten=zutaten+({zutat_c});}

	if (zutat_d) 
		{
			lesedetail=lesedetail+capitalize(zutat_d)+"\n";
			zutaten=zutaten+({zutat_d});}
				
	if (zutat_e) 
		{
			lesedetail=lesedetail+capitalize(zutat_e)+"\n";
		 zutaten=zutaten+({zutat_e});}
	
	if (zutat_f) 
		{
			lesedetail=lesedetail+capitalize(zutat_f)+"\n";
			zutaten=zutaten+({zutat_f});}
				
	if (zutat_g) 
		{
			lesedetail=lesedetail+capitalize(zutat_g)+"\n";
			zutaten=zutaten+({zutat_g});}
				
	AddReadDetail( ({ "liste","zutatenliste" }),
  lesedetail);

	}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zutatenliste");
  SetProp(P_LONG,
    "Du siehst eine kleine Liste. Du kannst sie lesen." );

  SetProp(P_NAME, "liste");
  SetProp(P_GENDER, FEMALE);
  AddId(({"liste", "\nzaubertrankzutaten"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);

 //Liste generieren
 zutat_a=gruppe_a[random(sizeof(gruppe_a))];
 zutat_b=gruppe_b[random(sizeof(gruppe_b))];
 zutat_c=gruppe_c[random(sizeof(gruppe_c))];
 zutat_d=gruppe_d[random(sizeof(gruppe_d))];
 zutat_e=gruppe_e[random(sizeof(gruppe_e))]; 
 zutat_f=gruppe_f[random(sizeof(gruppe_f))];
 zutat_g=gruppe_g[random(sizeof(gruppe_g))];     


//if zutaten= ({zutat_a, zutat_b, zutat_c, zutat_d, zutat_e, zutat_f, zutat_g});



 neueliste();
}

string *was() //gibt die Liste an Endoriel
{return zutaten;}


	

int itemweniger(string item)
{
	if(zutat_a==item) zutat_a=0;
	if(zutat_b==item) zutat_b=0;
	if(zutat_c==item) zutat_c=0;
	if(zutat_d==item) zutat_d=0;
	if(zutat_e==item) zutat_e=0;
	if(zutat_f==item) zutat_f=0;
	if(zutat_g==item) zutat_g=0;
	neueliste();
	
	if(!zutat_a&&!zutat_b&&!zutat_c&&!zutat_d&&!zutat_e&&!zutat_f&&!zutat_g) return 0; //Wenn alle erfuellt sind
		return 1;	
	}
	
	
	
	