#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_SHORT, "Zwischen den Duenen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten zwischen den Duenen. Der Boden auf dem Du stehst besteht "
    "aus warmem, weichem Sand. Die Sonne steht an einem strahlend blauem Himmel und lacht "
    "auf Dich herunter. Das Laufen hier ist recht muehsam, da Du immer wieder einsinkst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft salzig.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
  AddDetail( ({ "grasbueschel" }),
    "Das Gras waechst hier nur sehr spaerlich.");
  AddDetail( ({ "gras" }),
    "Nur sehr wenige Halme halten sich hier.");
  AddDetail( ({ "halme" }),
    "Die meisten Halme sind graeulich und trocken. Nur ein Halm sieht frisch und gruen aus.");
  AddDetail( ({ "halm" }),
    "Dem Halm scheint es gut zu gehen.");
  AddDetail( ({ "laufen" }),
    "Du schleppst Dich muehsam durch den Sand.");
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht fast nur aus Sand. Nur hin und wieder kann sich ein Grasbueschel halten.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Du kannst das Meer Rauschen hoeren. Es scheint also nicht weit entfernt zu sein.");
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");


 
  AddCmd( ({ "pflueck", "pfluecke" }), "pflueckenCmd" );

   AddExit( "norden", PIR_ROOM + "pirateninsel_6b" );
   AddExit( "suedosten", PIR_ROOM + "pirateninsel_8c" );

}

int pflueckenCmd(string str )
{
  notify_fail( "Was moechtest du pfluecken?\n" );
  if( str == "grashalm"||str== "halm" )
	{write("Du bist zu schwach um den Grashalm zu pfluecken!\n");
		return 1;
	}
}
