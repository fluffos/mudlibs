//Flasche fuer den Laden auf der Pirateninsel
//clont sich gross, klein, mittel und in verschiedenen Sorten
// Yondala@Andracia 7.3.2007

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine leere Flasche");
  SetProp(P_LONG,  "Du siehst eine leere, alte Flasche." );
  SetProp(P_NAME, "Flasche");
  AddId(({"flasche"}));
  SetProp(P_VALUE, 10);    
  SetProp(P_WEIGHT, 1000);
  AddAdjective( ({ "leer" }) );
  SetProp(P_GENDER, FEMALE);
 
  SetProp( P_MATERIAL, MAT_GLASS  );
  AddCmd(({"entsorge","entsorge"}),"entsorgen");
}

int entsorgen(string str)
{
  notify_fail("Was moechtest Du entsorgen?\n");
  if (!id(str)) return 0;
  
  write ("Du kannst die Flasche in fast jeden Laden zurueckgeben.\n");
  return 1;
  }
  