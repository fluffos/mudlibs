//Am Strand. Hier kann man eine Sandburg bauen


#include "../def.h"
inherit "std/room";
#include <properties.h>
object obj;
int burg = 0;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
    "Du bist am Strand der Pirateninsel. Hier ist es einfach himmlisch. "
    "Die Sonne lacht, die Palmen bewegen sich im Wind. Unter Deinen Fuessen "
    "knirscht leise der warme, weiche Sand. Am Ufer rollen seichte Wellen an Land." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "strand" }),
    "Du befindest Dich am Strand.");
  AddDetail( ({ "piratenisel" }),
    "Auf diese Insel bist Du gereist.");
  AddDetail( ({ "insel", "land" }),
    "Eine Insel ist vom Meer umgebenes Land.");
  AddDetail( ({ "meer", "wasser" }),
    "Das Meer umgibt die Insel.");
  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel und lacht Dich an.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau und die Sonne lacht Dich an.");
  AddDetail( ({ "sand", "sandburg", "burg" }),
    "Der Sand ist weich und weiss. Du hast ploetzlich Lust, eine Sandburg zu bauen.");
  AddDetail( ({ "palme", "palmen" }),
    "Die Palmen bewegen sich im Wind.");
  AddDetail( ({ "wind", "brise" }),
    "Du fuehlst eine leichte Brise auf deiner Haut.");
  AddDetail( ({ "haut" }),
    "Haut ist wichtig. Saehe doof aus ohne...");
  AddDetail( ({ "ufer" }),
    "Das Ufer der Insel.");
  AddDetail( ({ "wellen", "wasserbewegung" }),
    "Wasserbewegung nennt man Wellen.");
  AddDetail( ({ "fuesse", "fuessen", "beine", "bein", "ende" }),
    "Am Ende deiner Beine sind Deine Fuesse.");
  AddDetail( ({ "gebuesch" }),
    "Das Gebuesch ist sehr trocken und voller spitzer Dornen.");
  AddDetail( ({ "dornen" }),
  "Sie sind sehr spitz, man sollte nicht reingreifen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus warmen, weichen Sand.");
  AddDetail( ({ "pirateninsel" }),
    "Du befindest Dich auf einer.");
  AddDetail( ({ "lust" }),
    "Na los, mach schon!");
  AddDetail( ({ "" }),
    "");
    
  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer","rauschen" }),
    "Das Rauschen des Meeres wirkt beruhigend auf Dich. Du entspannst Dich.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
  AddCmd( ({ "bau", "baue" }), "bauenCmd" );
  AddCmd( ({ "greif", "greife" }), "greifenCmd" ); 
  AddCmd( ({ "schwimm", "schwimme" }), "schwimmenCmd" );   
  
  AddExit( "westen", PIR_ROOM + "pirateninsel_8d" );
  AddExit( "nordosten", PIR_ROOM + "pirateninsel_7f" );
}

int kletternCmd(string str )
{
  notify_fail( "Wo willst Du draufklettern?\n" );
  if( str == "auf palme" )
  {
    write("Du naeherst Dich der Palme, bemerkst dann aber, dass sie von einem stacheligem Gebuesch umgeben ist, "+
	"also gibst Du Dein Vorhaben schnell auf.\n");
    say( TPN+" versucht auf eine Palme zu klettern, scheitert aber.\n");
    return 1;
  }
}


bauenCmd(string str )
{
int i;
int burgen;
object *alledinge;
  notify_fail( "Was moechtest Du bauen?\n" );
  if( str == "burg"||str== "sandburg" )
  {
    if(TP->InFight())
	{
	  write("Dazu hast Du jetzt gerade keine Zeit.\n");
	  return 1;
	  }
	  
    alledinge=all_inventory();
    for(i=sizeof(alledinge);i--;i>0)
	{
	  if(alledinge[i]->name()=="eine Sandburg") burgen++;
	  if(burgen>=3)
	  {
	  write("Hier sind doch schon so viele Burgen.\n");
	  return 1;
	  }
	 }
	
	TP->SetProp(P_PARALYZED,([PARALYZE_TIME:-1, 
			PARALYZE_MSG:"Du bist ganz in den Bau Deiner Sandburg vertieft.\n",
			PARALYZE_MSG_OTHER: TPN+" formt Sand.\n", 
			PARALYZE_END: "Entzueckt betrachtest Du Dein Werk.\n", 
			PARALYZE_END_OTHER:TPN+" betrachte zufrieden "+TP->QueryPossPronoun(NEUTER,WEN)+" Werk.\n"]));
    write("Du beginnst mit dem Bau einer Sandburg.\n");
    say( TPN+" beginnt eine Sandburg zu bauen.\n");
    call_out("bauen2",2);

     return 1;
  }

else
return 0;
}

void bauen2()
{
   write("Erstmal schaufelst Du ganz viel Sand auf einen Haufen.\n");
   call_out("bauen3",4);
}

void bauen3()
{
   write("Du glaettest die Seiten Deiner Burg.\n");
   call_out("bauen4",3);
}



void bauen4()
{
   write("Liebevoll formst Du Tuerme und Erker.\n");
   call_out("bauen5",3);
}


void bauen5()
{
   write("Zum Schluss graebst Du noch einen kleinen Burggraben um die Burg.\n");
   call_out("bauen6",3);
}
 
void bauen6()
{
   write("Als kroenenden Abschluss ritzt Du Deinen Namen in den Torbogen.\n");
   call_out("bauen7",3);
}

void bauen7()
{
  object ob;
  TP->SetProp(P_PARALYZED,0);
  ob=clone_object(PIR_OBJ +"sandburg");
  ob->move(TO);
  ob->namensgebung(TP);
  //AddItem( PIR_OBJ +"sandburg", REFRESH_DESTRUCT,
    //      ([ P_SHORT  : "Eine von "+TP->name()+" gebaute Sandburg"]) );

}

int greifenCmd(string str )
{
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "in dornen"||str=="in dorne"||str=="in gebuesch" )
  {
    write("Du greifst in die Dornen und piekst Dich ganz fuerchterlich.\n");
    say( TPN+" greift in Dornen und piekst sich ganz fuerchterlich.\n");
TP->do_damage(5,"Dornen");
    return 1;
  }
  return 0;
}

 
int schwimmenCmd(string str )
{
 
  notify_fail( "Wo willst Du hin schwimmen?\n" );
  if( str == "zur kleinen insel" || str== "zur kleinen insel hin"||str == "zur kleinen insel hinueber" || str== "zur kleinen insel rueber" ||
  str == "zur anderen insel" || str== "zur anderen insel hin"||str == "zur anderen insel hinueber" || str== "zur anderen insel rueber"||
  str == "zur insel" || str== "zur insel hin"||str == "zur insel hinueber" || str== "zur insel rueber"||
  str== "herueber"||str == "hinueber" || str== "rueber"||
  str == "zu kleiner insel" || str== "zu kleiner insel hin"||str == "zu kleiner insel hinueber" || str== "zu kleiner insel rueber" ||
  str == "zu anderer insel" || str== "zu anderer insel hin"||str == "zu anderer insel hinueber" || str== "zu anderer insel rueber"||
  str == "zu insel" || str== "zu insel hin"||str == "zu insel hinueber" || str== "zu insel rueber")

  { 
    
    write("Du watest ins Wasser und schwimmst los.\n");
    say( TPN+" schwimmt los.\n",TP);
	if (random(20)==1) TP->move(PIR_ROOM+"pirateninsel_wal", M_GO);//TP->move( "/d/wasser/yondala/pirateninsel/room/pirateninsel_wal", M_GO);
	else               TP->move(PIR_ROOM+"pirateninsel_10c", M_GO);//TP->move("/d/wasser/yondala/pirateninsel/room/pirateninsel_10c", M_GO);
			 
    return 1;  	
  	 }
    return 0;
}