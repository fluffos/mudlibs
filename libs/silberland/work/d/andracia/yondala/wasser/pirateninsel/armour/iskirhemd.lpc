#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine grosses Hemd");
  SetProp(P_LONG,
    "Ein grosses Hemd, welches zwar nicht zammelig ist, aber dennoch schon bessere Tage "
    "gesehen haben mag, denn von der urspruenglichen Farbe kann man nur noch erahnen, das es mal weiß war." );
  SetProp(P_NAME, "Hemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 150);
  SetProp(P_QUALITY_DECAY, 100);
  //SetProp(P_AUTOLOADOBJ, 1);                                     

SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE : 180,
                                   P_GENDER    : MALE]) );

}
