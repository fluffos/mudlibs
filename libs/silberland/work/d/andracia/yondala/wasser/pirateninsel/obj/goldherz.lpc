
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Herz aus Gold");
  SetProp(P_LONG,
    "Du haelst ein kleines, goldenes Herz in Deiner Hand. Es liegt warm in Deiner Hand und "
    "scheint leicht zu pulsieren." );
SetProp(P_NAME_ADJ, "golden");
  SetProp(P_NAME, "Herz");

  SetProp(P_GENDER, NEUTER);
  AddId(({"herz","goldherz", "\nhildgundeitem"}));
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100000);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NEVERDROP, 0);
 

}
