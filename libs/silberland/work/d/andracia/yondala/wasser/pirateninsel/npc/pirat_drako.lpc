// Kapitaen Drako, gehoert zur Schatzsucherquest, man muss ihm ein Holzbein bringen
// wenn man keine Medaille hat laeuft er davon
// haelt sich in drei Raeumen am Strand der Pirateninsel auf (8c, 8d, 8e)

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
inherit PIR_NPC + "pirat_std.lpc";


object obj;
int da = 1;	
object *begruesste;//hier speichert Drako die Namen derer, die er schon angesprochen hat. Das nervt sonst.

	
	
	flucht()
{
	 string *ausgaenge;

	  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
    if (!present("/nschutzmedaillepiraten",TP)&&TP->QueryProp(P_GUILD)=="piratenmeute") 
    {
      command ("sag Ihr seid ein Feind! Meine Freunde erkenne ich an der Medaille!");
   	 	ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
  		command( ausgaenge[random(sizeof(ausgaenge))] );
		return;
  	}
  	else
	{
	
  		if(member(begruesste, TP)!=-1) return;
        command("sag Seid gegruesst, "+TPN+"!");
		begruesste=begruesste+({TP});
		}
		
  	}
}

void init()
{::init();
		//call_out("flucht",1);
flucht();
}	


void create() 
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  begruesste=({});

  SetProp(P_SHORT, "Drako der Piratenkapitaen");
  SetProp(P_LONG,
    "Das ist Drako. Er ist der Kapitaen eines grossen Piratenschiffs das ueberall "
    "gefuerchtet wird. Sagt er. Aber diese Zeiten sind lang vorbei. Sein Schiff "
    "wurde zerstoert und er verlor dabei ein Bein. Nun muss er sich auf Kruecken "
    "fortbewegen.");
  SetProp(P_NAME, "Drako");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"drako", "kapitaen", "pirat"}));
  //  SetProp(P_ARTICLE, 0);
//  set_living_name("");
SetProp (P_MNPC_DEFAULTROOM, PIR_ROOM+"pirateninsel_8c");
SetProp (P_MNPC_AREA, ({PIR_ROOM+"pirateninsel_8c", 
	                    PIR_ROOM+"pirateninsel_8d", 
	                    PIR_ROOM+"pirateninsel_8e"}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);
SetProp (P_MNPC_WAIT, ({20, 30, 20}));

  SetProp(P_MSGIN, "humpelt heran");
  SetProp(P_MSGOUT, "humpelt von dannen");

  create_default_npc(10); 
  SetProp(P_HANDS, ({"mit seinen Kruecken",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");

  SetProp(P_ALIGN, -150);
  SetProp(P_KILL_NAME, "Drako der Piratenkapitaen");
  SetChats(1, ({"Drako sagt: Wei, wei, wei, wenn ich nur das richtige finden wuerde.\n",
   	            "Drako stolpert und faellt beinahe hin.\n",
              	"Drako aechzt.\n"})); 

  AddInfo( ({ "drako", "piratenkapitaen" }),
    "Das bin ich.",
    "sagt: ");
    AddInfo( ({ "schatzkarte" }),
    "Tja, es gab mal eine Schatzkarte. Aber wir haben den Schatz nie gefunden, "+
    "also haben wir die Karte in vier Teile geteil und jeder von uns hat einen "+
    "Teil behalten, bis ein mutiger Abenteurer kommt und die Schatzsuche beginnen moechte.",
    "sagt: ");  
    AddInfo( ({ "teile", "kartenteile" }),
    "Meine Freunde und ich haben die Schatzkarte damals in vier Teile geteilt.",
    "sagt: ");  
    AddInfo( ({ "teil", "kartenteil" }),
    "Ich habe auch noch einen Kartenteil.",
    "sagt: ");  
    AddInfo( ({ "wir" }),
    "Meine Freunde und ich.",
    "sagt: ");  
    AddInfo( ({ "bloedsinn", "narren" }),
    "Nun, meine Freunde und ich sind da anderer Meinung.",
    "sagt: ");  
    AddInfo( ({ "freunde" }),
    "Jann, Hein und Piet sind meine Freunde.", //Namen der Freunde.
    "sagt: ");  
    AddInfo( ({ "jann" }),
    "Jann ist einer meiner Freunde. Er besitzt die kleine Hafenkneipe im Norden.",
    "sagt: ");    
  AddInfo( ({ "hein" }),
    "Hein ist einer meiner Freunde. Er ist der Leuchtturmwaechter.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist einer meiner Freunde. Er besitzt einen kleinen Laden.",
    "sagt: ");
  AddInfo( ({ "karte" }),
    "Was fuer eine Karte?",
    "sagt: ");
  AddInfo( ({ "holzbein" }),
    "Ich brauche ein Holzbein um wieder laufen zu koennen. Ihr koennt es aus einem Stueck Holz schnitzen.",
    "sagt: ");
    AddInfo( ({ "holz" }),
    "Ach, da bin ich nicht mehr waehlerisch, Strandgut wuerde reichen. Vielleicht liegt hier irgendwo etwas vergraben, sodass Ihr mir ein Bein daraus schnitzen koenntet?",
    "sagt: ");  
   AddInfo( ({ "messer","schnitzmesser" }),
    "Ich habe leider kein Schnitzmesser. Vielleicht kann Euch aber einer meiner Freunde weiterhelfen?",
    "sagt: ");  
   AddInfo( ({ "medaille" }),
    "An der erkenne ich, wer Freund und wer Feind ist.",
    "sagt: ");  
   AddInfo( ({ "feind" }),
    "Jeder, der nicht die Medaille traegt, ist ein Feind.",
    "sagt: ");  
   AddInfo( ({ "freund" }),
    "Ich habe nur wenige Freunde.",
    "sagt: ");  
   AddInfo( ({ "hilfe" }),
    "Ich braeuchte Hilfe, ja. Wuerdet Ihr mir ein Holzbein besorgen? Ich wuerde Euch dafuer meinen Kartenteil ueberlassen.",
    "sagt: ");  
   AddInfo( ({ "schnitzen" }),
    "Ihr koennt mit einem geeigneten Messer aus einem Stueck Holz ein Bein fuer mich schnitzen.",
    "sagt: ");  
   AddInfo( ({ "stueck" }),
    "Leider habe ich keines.",
    "sagt: ");  
   AddInfo( ({ "bein" }),
    "Das Bein habe ich bei einem Kampf gegen einen grossen, weissen Wal verloren.",
    "sagt: ");  
   AddInfo( ({ "wal" }),
    "Der Wal schwimmt immernoch vor der Insel herum. Passt auf, dass er Euch beim schwimmen nicht auffrisst.",
    "sagt: ");  
   AddInfo( ({ "schwimmen" }),
    "Ich wuerde hier sicher nicht mehr schwimmen.",
    "sagt: ");  
    AddInfo( ({ "roger","roger schwarzbart","schwarzbart" }),
    "Roger Schwarzbart ist der Anfuehrer der Piraten. Frueher waren wir "
    "Konkurrenten, aber das ist lang vorbei, er hat mich geschlagen.",
    "sagt: "); 
 AddInfo( ({ "broud", "sklaventreiber" }),
    "Broud war der Sklaventreiber auf meinem Schiff. Nun handelt er mit Sklaven.",
    "sagt: ");
    AddInfo( ({ "roger","roger schwarzbart","schwarzbart" }),
    "Roger Schwarzbart ist der neue Anfuehrer der Piraten. Frueher waren "
	"wir Konkurrenten, aber das ist lang vorbei.",
    "sagt: ");        
	AddInfo( ({ "" }),
    "",
    "sagt: ");  
   AddInfo( ({ "" }),
    "",
    "sagt: ");  
   


 AddCmd( ({ "bitte" }), "bittenCmd" );
 AddCmd(({"tausche","tausch"}),"tauschenCmd");
  SUID;
  ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
  ob->zahlkriegen(2);
  ob->move(TO);
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/club/knueppel" );
  command("zuecke saebel");  
}






int bittenCmd(string str )
{
	notify_fail("Wen moechtest Du um was bitten?\n");
	if (str == "drako um kartenteil"||str == "drako um teil"||str=="drako um karte")
		 {
		 	if(this_player()->QueryQuest("Finde den Piratenschatz")||present("KARTE2",TP))
  		{
  			command("sag Den hab ich Euch doch schon laengst gegeben.");
  			return 1;
  		}
  		command("sag Einfach geben werde ich ihn Euch nicht, aber ich wuerde meinen"+
							" Kartenteil gegen ein neues Holzbein eintauschen.\n");
			return 1;
		}
	}


void zufrieden(object spieler)
{
			command("sag Wohlan, ich halte mein Wort, hier habt Ihr die Karte. Vielen Dank nochmal.\n");
 			write("Drako gibt Dir ein Stueck Papier.\n");
 			say("Drako gibt "+spieler->name(WEM)+" ein Stueck Papier.\n",TP);
 			tell_room(environment(TO), "Drako schnallt sich sein neues Bein an.\n");
	        move("/room/npcasylraum", M_GO);
            remove();
			}

int tauschenCmd(string str )
{
  object ob;
  notify_fail("Was moechtest gegen was tauschen?\n");
	if (str == "holzbein gegen karte"
		||str == "holzbein gegen kartenteil"
		||str == "holzbein gegen teil" 
        ||str == "bein gegen karte"
		||str == "bein gegen kartenteil"
		||str == "bein gegen teil" 		
		||str == "karte gegen holzbein"
        ||str == "karte gegen bein"
		||str == "kartenteil gegen holzbein"
		||str == "kartenteil gegen bein"
		||str == "teil gegen holzbein"
		||str == "teil gegen bein")
	{

	if(present("holzbein",  TP)) //wenn der Spieler das fertige Holzbein hat
		{
		  obj = present("holzbein",  TP);
		  write("Du gibst Drako das Holzbein und er haendigt Dir dafuer ein Stueck Papier aus.\n");
          say(TPN+" tauscht etwas mit Drako.\n",TP);
          present("KARTE2")->move(TP, M_NOCHECK);
		  obj->remove(); //entferne Holzbein
          zufrieden(TP);        
		  }

	else //wenn kein holzbein da
		write("Drako sagt: Ihr wollt mich wohl betruegen? Beim "+
		      "Kabautermann, ihr habt doch gar kein Holzbein bei Euch!\n");

	return 1;
}
return 0;
}

give_notify(object ob)
 {
   object karte;
 	if(!this_player()->QueryQuest("Finde den Piratenschatz")&&ob->name()=="ein Holzbein")
 	  {
  	      present("KARTE2")->move(TP, M_NOCHECK);
		  ob->remove(); //entferne Holzbein
 		  zufrieden(TP);
 
     }
  else//wenn er die Quest schon hat oder das Objekt kein Holzbein ist.
   {
    command("sag Was soll ich damit?");
    ob->move(TP, M_GET);
    }
 }
void die()
{
   object ob;
   ob=QueryProp(P_KILLER);
   if(!present("KARTE2",TO)) 
   {::die();
    return;}
	if(ob->QueryQuest("Finde den Piratenschatz")||!interactive(ob)||present("KARTE2",ob))
		{
			present("KARTE2",TO)->remove();
			tell_room(environment(TO),"Drako zerreisst mit letzter Kraft ein Stueck Papier.\n");
			
			}
	   else present("KARTE2",TO)->move(ob, M_NOCHECK);
  	::die();
}