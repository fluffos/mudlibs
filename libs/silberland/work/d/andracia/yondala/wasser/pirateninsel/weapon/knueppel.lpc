#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Kruecke");
  SetProp(P_LONG,
    "Eine Kruecke aus Holz, die Verwundete stuetzen kann." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Kruecke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kruecke", "holzkruecke"}) );
  //SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_BEECH );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 243);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

}

int WieldFunc(object waffe) {
  return 0;
}

int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}
