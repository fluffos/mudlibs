
inherit "/std/food";
#include "../def.h"
#include <properties.h>
#include <food.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Banane");
  SetProp(P_LONG,
    "Eine reife, leuchtend gelbe Banane." );
  SetProp(P_NAME, "Banane");
  SetProp(P_GENDER, FEMALE);

//SetProp(P_FOOD_STATE, F_RAW); //weil sie roh ist

SetProp(P_FOOD_INFO, ([F_SOAK:5, 
											 F_HEAL:({10,10}), // erst HP, MP
											// F_HEAL:10, 
											 F_MSG: "Du verspeist eine koestliche Banane.", 
											 F_MSG_ROOM: "verspeist eine koestliche Banane."]));


  AddId("banane");
 SetProp(P_NAME_ADJ, "lecker");
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 60);


 
}

