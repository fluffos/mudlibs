// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 28.04.2010
// Die Kneipe von Pirat Jann frueher Henk

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Hafenkneipe." );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer Hafenkneipe. Sie ist spaerlich eingerichtet "
    "und Du erwartest hier sicherlich keinen kulinarischen Hochgenuss, aber "
    "besser als nichts. Es gibt keine Sitzgelegenheit, man kann seine "
    "Getraenke an der Theke bestellen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "JANN");
  SetProp( P_PUBKEEPER_NAME, "Der Wirt Jann");
  SetProp( P_PUBKEEPER_GENDER, MALE);
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
     AddDetail( ({ "hafenkneipe", "kneipe" }),
    "Du befindest Dich in einer.");
  AddItem(PIR_NPC + "pirat_jann",REFRESH_DESTRUCT);

  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier bestehen aus blankem Fels. In einer Ecke stehen ein paar grobe "
    "Faesser, an einer Wand steht eine kleine, schiefe Theke.");
  AddDetail( ({ "fels" }),
    "Die Hoehle, in der sich die Kneipe befindet, scheint direkt in den Fels geschlagen "
    "worden zu sein.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus blankem Fels. Es liegen ein paar alte Teppiche herum.");
  AddDetail( ({ "teppiche" }),
    "Die Teppiche sind alt und zerfranst und passen so gar nicht hier her.");
  AddDetail( ({ "decke" }),
    "An der felsigen Decke verbreitet eine kleine Lampe schummriges Licht.");
  AddDetail( ({ "lampe" }),
    "Es handelt sich um eine kleine Oellampe, die an einer Kette haengend mit einem Haken "
    "in der Decke verankert ist.");
  AddDetail( ({ "licht" }),
    "Das Licht ist hell genug, sodass Du alles sehen kannst.");
  AddDetail( ({ "oellampe" }),
    "Die Oellampe flackert leicht.");
  AddDetail( ({ "kette" }),
    "Die Oellampe haengt an einer groben Kette von der Decke herab.");
  AddDetail( ({ "haken" }),
    "Der Haken ist fest im Fels verankert.");
  AddDetail( ({ "hafenkneipe", "kneipe", "hoehle" }),
    "Du befindest Dich in einer.");
  AddDetail( ({ "theke" }),
    "Die Theke scheint nur behelfsmaessig zusammengezimmert. Sie ist alt, dreckig und "
    "schaebig. Dahinter steht ein Regal mit Glaesern.");
  AddDetail( ({ "glaeser","glaesern" }),
    "Die sehen nicht so sehr sauber aus. Hoffentlich holen sich die Gaeste hier keine Krankheiten.");
  AddDetail( ({ "regal" }),
    "Das Regal steht sehr schief. Wirklich ein Wunder, dass die Glaeser nicht rausfallen.");
  AddDetail( ({ "faesser", "fass", "ecke","ecken" }),
    "Nun, da es hier keine Tische und Stuehle gibt, muss man sein Getraenk wohl an einem "
    "der Faesser in der Ecke zu sich nehmen.");
  AddDetail( ({ "tische", "stuehle", "sitzgelegenheit" }),
    "Die gibt es hier nicht, wie gesagt. Man muss sich wohl mit einem Fass begnuegen.");
  AddDetail( ({ "getraenk", "liste", "getraenke" }),
    "Mit <menue> bekommst Du eine Liste der angebotenen Getraenke.");
  AddDetail( ({ "wunder" }),
    "Glaubst Du an Wunder?");
  AddDetail( ({ "gaeste","gast" }),
    "Du fragst Dich, ob sich wohl oft ein Gast hierher verirrt.");
  AddDetail( ({ "krankheiten" }),
    "Hoffentlich faengst Du Dir keine ein, wenn Du hier etwas trinkst.");
  AddDetail( ({ "hochgenuss" }),
    "Den wirst Du hier weder erwarten, noch finden.");



  AddDrink("Bier", ({ "bier", "" }),500,50,5,8, //Preis, Volumen, Alk
  ({ "Jann zapft Dir ein kuehles Blondes. "
     "Du trinkst das Bier auf ex.",
       "&& ext ein Bier."
   }) );
     AddDrink("Wein", ({ "wein", "" }),650,50,7,8, //Preis, Volumen, Alk
  ({ "Jann bringt Dir einen Becher Wein, den Du genuesslich austrinkst. ",
       "&& geniesst einen Becher Wein."
   }) );
  AddDrink("Rum", ({ "rum", "" }),700,50,10,8, //Preis, Volumen, Alk
  ({ "Jann schiebt Dir ein kleines Glas trueben Rums zu. Du schliesst Deine Augen und kippst ihn runter. ",
       "&& kippt einen Rum in sich."
   }) );

  AddFood( "Fisch", ({ "fisch", "" }), 60,6,2,
            ({ "Du bekommst einen Fisch. Er sieht nicht mehr ganz frisch aus, "
            	"aber da Du keinen Aerger willst isst Du ihn brav auf. ",
                        "&& isst einen Fisch. "
            }) );    

  AddFood( "Schiffszwieback", ({ "zwieback", "" }), 60,6,2,
            ({ "Jann wirft Dir ein trockenes, broeseliges Ding zu. Du kaust drauf rum "
            	"und faengst fuerchterlich an zu husten, weil das trockene Zeug Dir in den "
            	"Hals staubt.",
                        "&& wuergt einen trockenen Zwieback runter. "
            }) );    


  AddSound( DEFAULT_SOUND,
    "Du hoerst draussen das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Von draussen kannst Du das Meer rauschen hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig muffig hier, was wohl von den Teppichen herruehrt.");

  AddSmell( ({ "teppich","teppiche" }),
    "Du beugst Dich runter und schnupperst an einem Teppich. "+
    "Puh, ja, eindeutig, er riecht muffig. Schnell richtest Du Dich wieder auf.");

  AddRoomMessage( 
    ({""}),30,"func");

RemoveItem("/obj/topliste");

AddExit( "osten", PIR_ROOM + "pirateninsel_steg" );


}

