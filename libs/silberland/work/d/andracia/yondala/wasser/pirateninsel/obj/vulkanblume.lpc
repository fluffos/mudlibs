#include "../def.h"

inherit "std/thing";
#include <properties.h>
int nutzen = 4;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Vulkanblume");
  SetProp(P_LONG,
    "Die Vulkanblume ist schwarz und sehr zerbrechlich. Du musst sehr "
    "vorsichtig mit ihr umgehen um sie nicht zu zerstoeren." );
  SetProp(P_INFO, "Diese Vulkanblume birgt ein Geheimnis, das kannst Du "
  "deutlich spueren. Du hast das starke Beduerfnis die Vulkanblume zu "
  "konsumieren.\n");
  SetProp(P_NAME, "Vulkanblume");
  SetProp(P_GENDER, FEMALE);
  AddId(({"vulkanblume", "blume", "VULKANBLUME"}));

  SetProp(P_MATERIAL, MAT_MISC_MAGIC );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);  
 AddCmd( ({ "zieh", "ziehe" }), "ziehenCmd" ); 
  AddCmd( ({ "iss", "kau", "kaue" }), "essenCmd" );
  AddCmd( ({ "konsumier", "konsumiere" }), "konsumierenCmd" ); 
 AddCmd( ({ "knabber", "knabbere" }), "knabbernCmd" ); 
 AddCmd( ({ "leck", "lecke" }), "leckenCmd" ); 
}

int ziehenCmd(string str )
{
  notify_fail( "Was moechtest Du ziehen?\n" );
	
  if( str == "vulkanblume durch die nase"||str == "vulkanblume durch nase")
  {
     write("Du zerreibst die Vulkanblume zwischen den Fingern und ziehst "+
	 "sie Dir durch die Nase.\n");
     TP->Addhp(50);
     remove();
    return 1;
  } 
  return 0;
}

int leckenCmd(string str )
{
  notify_fail( "An was moechtest Du lecken?\n" );
	
  if( str == "an vulkanblume" )
  {
	write("Du leckst an der Vulkanblume.\n");
    say( TPN+" leckt an etwas.\n", TP);
    TP->AddHp(25);
    TP->AddSp(25);
    nutzen-=1;
   
 if (nutzen < 1)
 {	write ("Die Vulkanblume zerbricht zu Staub, der vom Wind fortgeweht "+
           "wird.\n");
    this_object()->remove();
    return 1;
    }
      	
  return 1;
  
 }
return 0;
}  

int knabbernCmd(string str )
{ notify_fail( "An was moechtest du knabbern?\n" );
  if( str == "an vulkanblume" )
	{
		write("Du knabberst an der Vulkanblume.\n");
    say( TPN+" knabbert an etwas.\n", TP);
		if (nutzen >=2)
		{
			TP->AddHp(50);
			TP->AddSp(50);
		}
		else
		{
			TP->AddHp(25);
			TP->AddSp(25);
		}

nutzen-=2;
 if (nutzen <= 0)
 	{	
 		write ("Du hast die Vulkanblume aufgebraucht.\n");
    this_object()->remove();
    return 1;
  }
  return 1;
 }
return 0;
}  

int konsumierenCmd(string str )
{
  notify_fail( "Was moechtest Du konsumieren?\n" );
  if( str == "vulkanblume" )
  {   write("Du glaubst doch nicht im Ernst, dass ich es Dir so einfach "
      "mache? Aber immerhin, netter Versuch. Nun denk mal nach, was es "
      "noch fuer Moeglichkeiten gibt.\n");
      say( TPN+" macht sich laecherlich.\n", TP);
			return 1;
	}
return 0;
	} 
 
 int essenCmd(string str )
{
  notify_fail( "Was moechtest Du essen?\n" );
	if( str == "vulkanblume" )
    {
   	write("Du isst die Vulkanblume.\n(Also na gut, das war zwar nicht "+
	"die richtige Syntax, aber 1 Punkt kriegste.)\n");
    say( TPN+" isst etwas.\n", TP);
	TP->AddHp(1);
	TP->AddSp(1);
    remove();
	  return 1;
 	 } 
} 