#include "../def.h"
inherit "std/thing";
#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schluessel");
  SetProp(P_LONG,
    "Du siehst einen kleinen, silbernen Schluessel." );
  SetProp(P_INFO, "Der Schluessel scheint zu einer Schatztruhe zu gehoeren.");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId("schluessel", "piratenschatztruhenschluessel");
  SetProp(P_MATERIAL, MAT_SILVER );
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 10);

}
