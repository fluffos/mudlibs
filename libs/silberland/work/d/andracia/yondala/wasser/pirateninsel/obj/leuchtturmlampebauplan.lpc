#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Plan");
  SetProp(P_LONG,
    "Auf diesem Plan steht geschrieben, wie man eine Lampe herstellen kann." );
  SetProp(P_NAME, "Plan");
  SetProp(P_GENDER, MALE);
  AddId( ({"plan", "bauplan", "\nlampeplan"}) );

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddReadDetail( ({ "plan" }), 
 		"\n ___________________________________________\n"+
 		"|  Anleitung zum Bau einer Leuchtturmlampe  |\n"+
 		"| - schmiede ein Lampengestell aus Eisen    |\n"+
 		"| - blase das Glas ueber der Feuerstelle    |\n"+
 		"| - passe das Glas in das Lampengestell     |\n"+
 		"| - kitte das Glas im Gestell fest          |\n"+
		"| - stecke eine Kerze in die fertige Lampe  |\n"+
 		"|___________________________________________|" );
}
