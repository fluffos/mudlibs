#include "../def.h"

inherit "std/thing";

#include <properties.h>
void namensgebung(object ob)
{
  AddDetail( ({ "name","namen" }),
  "Jemand hat \""+    ob->name()+"\" in den Torbogen geritzt. Vermutlich der Erbauer selbst."); 
  AddDetail( ({ "erbauer" }),
  "Du vermutest, dass "+ob->name()+" der Erbauer dieser Burg ist."); 

	}
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Sandburg");
  SetProp(P_LONG,
    "Hier steht eine wirklich praechtige Sandburg. Voller Staunen betrachtest Du dieses Meisterwerk aus Sand: "
	"Du siehst viele kleine Tuerme und Erker, die taeuschend echt einer richtigen Burg nachempfunden wurden. Die "
	"Burgmauer hat sogar ein angedeutetes Mauerwerk als Muster. Sogar einen Torbogen entdeckst Du. "
	"Um die Burg herum befindet sich ein richtiger kleiner Burggraben, fast erwartest Du einen Drachen oder wenigstens "
	"ein paar Krokodile darin zu finden." );
  SetProp(P_INFO, "Du kannst die Sandburg zertreten.");
  SetProp(P_NAME, "Sandburg");
  SetProp(P_GENDER, FEMALE);
  AddId(({"sandburg", "burg"}));

  SetProp(P_MATERIAL, MAT_MISC_STONE );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOGET, "Die Sandburg wuerde zerfallen, wenn Du sie hochhebst.\n");
   AddCmd( ({ "zertrete", "zertritt", "zertrampel", "zertrample", "zerstoere","zerstoer", "zerstampfe","zerstampf" }), "zertretenCmd" ); 
  AddDetail( ({ "seiten" }),
    "Die Seiten der Sandburg sind schoen glatt.");    
  AddDetail( ({ "tuerme" }),
    "Die Sandburg hat mehrere kleine runde Tuerme, die einer richtigen Burg sehr gut nachempfunden sind.");    
  AddDetail( ({ "erker" }),
    "Wenn die Erker nicht so klein waeren, wuerdest Du sie glatt fuer echt halten.");    
  AddDetail( ({ "burggraben","graben", "ganze" }),
    "Ein kleiner Graben umschliesst die Burg. Sehr realistisch das Ganze.");    
  AddDetail( ({ "burgmauer","mauer" }),
    "In die Burgmauer wurde ein Muster geritzt.");    
  AddDetail( ({ "torbogen","bogen" }),
    "Auf den Torbogen hat jemand seinen Namen hinterlassen.");    
  AddDetail( ({ "muster" }),
    "Im Muster der Burgmauer sind Mauersteine angedeutet.");    
  AddDetail( ({ "steine","mauersteine" }),
    "Sie sind nicht echt da, nur angedeutet.");    
  AddDetail( ({ "krokodile","drachen" }),
    "Sowas siehst Du natuerlich nicht.");    
  AddDetail( ({ "" }),
    ".");    
   

}




int zertretenCmd(string str)
{  
  notify_fail( "Was moechtest Du zertreten?\n" );
  if( str == "burg"||str== "sandburg" )
  	{
  		write("Du trittst gegen die Sandburg und springst auf ihr herum bis sie vollkommen weg ist.\n");
    	say( TPN+" macht die Sandburg dem Erdboden gleich.\n", TP);
		TO->remove();
		return 1;
		}
return 0;
}