// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 08.05.2010
// hier kann man in den Vulkan hinab steigen
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Vulkan" );
  SetProp( P_INT_LONG,  "Du befindest Dich genau in der Mitte der kleinen Insel. "
  "Wie Du bereits vermutet hast, stehst Du auf einem Vulkan." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer kargen, steinigen Insel.");

  AddDetail( ({ "pirateninsel" }),
    "Im Norden kannst Du in einer Entfernung die Pirateninsel erkennen.");
  AddDetail( ({ "entfernung" }),
    "Weit weg halt.");
  AddDetail( ({ "sandstrand" }),
    "Den gibt es hier leider nicht und Du denkst wehmuetig an den warmen weichen Sand der Pirateninsel.");
  AddDetail( ({ "sand" }),
    "Sand besteht aus ganz vielen winzigkleinen Steinen.");
  AddDetail( ({ "steine", "steinen" }),
    "Hier gibt es nichts ausser hartem Gestein.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist hart, kalt und schwarz.");
  AddDetail( ({ "palmen" }),
    "Hier gibt es leider keine Palmen. Eigentlich gibt es hier fast nichts.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht auch hier aus hartem Gestein. Vor Dir ist ein Loch im Boden.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau, die Sonne lacht.");
  AddDetail( ({ "loch" }),
    "Ein Loch im Gestein. Du koenntest Dich sicher hindurchzwaengen und hinunterklettern.");
  AddDetail( ({ "vulkan" }),
    "Diese Insel besteht aus einem (hoffentlich) erloschenen Vulkan.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");
  AddDetail( ({ "mitte" }),
    "Du befindest Dich genau auf dem Mittelpunkt der kleinen Insel, was "
	"an sich nicht schwierig ist, da sie nur aus 5 Raeumen besteht und "
	"symmetrisch ist.");
  AddDetail( ({ "punkt","mittelpunkt" }),
    "Ja, so ist das.");
  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Stille.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht stark nach Schwefel.");

  AddSmell( ({ "schwefel" }),
    "Der Schwefelgeruch scheint aus dem Loch unter Dir zu kommen.");
  AddSmell( ({ "loch" }),
    "Das Loch riecht nach Justavius.");
  AddSmell( ({ "justavius" }),
    "Justavius? Achja, der wollte ja dieses riechbare Detail haben.");
  AddSmell( ({ "detail" }),
    "Ja, auch an dieses Detail hab ich gedacht :o)");


  AddRoomMessage( 
    ({""}),30,"func");

   AddCmd( ({ "zwaenge", "zwaeng", "kletter", "klettere" }), "zwaengenCmd" ); 

 AddExit( "nordosten", PIR_ROOM + "pirateninsel_10e" );
 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_10c" ); 
 AddExit( "suedosten", PIR_ROOM + "pirateninsel_12e" );
 AddExit( "suedwesten", PIR_ROOM + "pirateninsel_12c" );

}



zwaengenCmd(string str )
{
  notify_fail( "Wo moechtest Du Dich durchzwaengen?\n" );
  if( str == "durch loch"||str=="in loch"||str=="hinunter"||str=="rein"||str=="hinein"||str=="nach unten" )
  {
    this_player()->move(PIR_ROOM+"pirateninsel_u1", 
    M_GO, "zwaengst Dich durch ein sehr schmales Loch", "zwaengt sich durch ein Loch im Boden",
    			"zwaengt sich herein");
    return 1;
  }
}
