#include "../def.h"
#include <moredef.h>
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Stock");
  SetProp(P_LONG,
    "Ein alter, ranziger Stock." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Stock");
  SetProp(P_GENDER, MALE);
  AddId( ({"stock"}) );
 // SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 20 );//wie geschickt man mit der Waffe ist (normal 30)
//  SetProp(P_DAM_TYPE, DT_ );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 150);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 10);// haelt nicht lang
  
 }
