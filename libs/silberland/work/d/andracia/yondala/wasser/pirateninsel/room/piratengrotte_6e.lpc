#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std";
#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Im Osten siehst Du den Eingang zu einem grossen Raum. \n" );

  AddDetail( ({ "osten","raum" }),
    "Um mehr zu sehen musst Du nach Osten gehen.");    
  AddDetail( ({ "eingang" }),
    "Wie das bei einem Eingang so ist, kannst Du einfach durchgehen.");    


 

AddExit( "norden", PIR_ROOM + "piratengrotte_5e" ); 
AddExit( "westen", PIR_ROOM + "piratengrotte_6d" ); 
AddExit( "osten", PIR_ROOM + "piratengrotte_6f" ); 


//ausgeschaltet, damit niemand den Piraten beitreten kann
//AddExit( "osten", "/gilden/piratenmeute" ); 



}

