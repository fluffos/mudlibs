#include <moredef.h>

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein zerfetzter Sack");
  SetProp(P_LONG,
    "Du siehst einen zerfetzten Sack. Jemand hat Loecher reingeschnitten, damit man ihn "
    "als Kleid tragen kann." );
  SetProp(P_NAME, "Sack");
  SetProp(P_GENDER, MALE);
  AddId( ({"sack"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 10);


  AddDetail( ({ "loecher", "kleidungsstueck" }),
    "Die Loecher machen den Sack zu einem Kleidungsstueck.");
}
