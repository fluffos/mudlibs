#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein silberner Saebel");
  SetProp(P_LONG,
    "Ein besonders schoen verarbeiteter Saebel. Er ist sehr scharf und leicht und liegt auch "
    "gut in der Hand. Mit ihm kann man sicher sehr gut kaempfen." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Saebel");
  SetProp(P_GENDER, MALE);
  AddId( ({"saebel", "waffe"}) );
  //SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 35 );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_SILVER );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 1200);
  SetProp(P_QUALITY_DECAY, 150);
  
}
