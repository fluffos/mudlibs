#include "../def.h"

inherit "std/thing";

#include <properties.h>

int alk = 1;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine volle Rumflasche");
  SetProp(P_LONG,
    "Du siehst eine alte, gefuellte Rumflasche. Der Rum wurde wohl irgendwo schwarz "
    "gebrannt. Nur wer mutig ist, sollte daraus trinken." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Rumflasche");
  SetProp(P_GENDER, FEMALE);
  AddId(({"flasche", "rumflasche"}));

  SetProp( P_MATERIAL, ([ MAT_GLASS : 20, MAT_ALCOHOL : 80 ]) );

  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 500);
  AddCmd(({"trink","trinke"}),"trinkenCmd");

}



trinkenCmd(string str)
{ 


if(str=="rum" || str=="rum aus flasche")
{		
	     if ((alk > 0) && this_player()->drink_drink(5,5))
     {
       write("Du trinkst die Flasche in einem Zug leer.\n");
       this_player()->heal_self(10);
       SetProp(P_SHORT, "Eine leere Rumflasche");
  		 SetProp(P_LONG,
    		"Du siehst eine alte, leere Flasche, in der sich wohl mal Rum befunden hat." );
  		 SetProp( P_MATERIAL, MAT_GLASS);
			 SetProp(P_WEIGHT, 200);
  		 SetProp(P_VALUE, 50);

       alk--;
       return 1;
     }
	
}
}


