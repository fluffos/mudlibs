#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std.lpc";
//inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Aus dem Westen funkelt und glitzert es.\n" );

  AddItem(PIR_NPC + "pirat_normalo",REFRESH_DESTRUCT);

  AddDetail( ({ "westen" }),
    "Ob dort wohl Schaetze und Reichtuemer zu finden sind?");    
  AddDetail( ({ "schaetze", "reichtuemer" }),
    "Ob Du so etwas wohl findest, wenn Du nach Westen gehst?");    
  AddDetail( ({ "glitzern" }),
    "Was da wohl glitzert? Und ob Du es wirst mitnehmen duerfen?");    
  AddDetail( ({ "" }),
    "");    

AddExit( "norden", PIR_ROOM + "piratengrotte_3c" ); 
AddExit( "sueden", PIR_ROOM + "piratengrotte_5c" ); 
AddExit( "westen", PIR_ROOM + "piratengrotte_4b" );  
 

}

 void tuerzu()
 {
 	RemoveExit("westen");
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen, duesteren Grotte. Unter Deinen "
    "Fuessen befindet sich ein morscher Steg dessen Planken sich unter "
    "Deinem Gewicht aechzend biegen. Der Weg nach Westen ist magisch blockiert.");
  AddDetail( ({ "weg", "westen" }),
    "Der Weg nach Westen ist magisch blockiert.");    
    
 	}
 	
void tuerauf()
{
AddExit( "westen", PIR_ROOM + "piratengrotte_4b" );  
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen, duesteren Grotte. Unter Deinen "
    "Fuessen befindet sich ein morscher Steg dessen Planken sich unter "
    "Deinem Gewicht aechzend biegen. Aus dem Westen funkelt und glitzert es.");
  AddDetail( ({ "westen" }),
    "Ob dort wohl Schaetze und Reichtuemer zu finden sind?");    
	
  RemoveDetail( ({ "weg" }));    
	}