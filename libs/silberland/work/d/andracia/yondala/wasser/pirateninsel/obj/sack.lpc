inherit "std/container";

#include "properties.h"
#include "container.h"
#include "../def.h"

int respawn_treasure;
int viewed_treasure;
string *treasures;



void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT, "Ein Sack");
  SetProp( P_LONG, BS("Ein gewoehnlicher, kleiner Sack. ") );
  SetProp( P_NAME, "Sack");
  SetProp( P_ARTICLE, 1);
  SetProp( P_GENDER, MALE);
  SetProp( P_MATERIAL, MAT_COTTON);
  AddId( ({"sack"}) );
  SetProp( P_WEIGHT, 100);
  SetProp( P_VALUE, 120);
  SetProp(P_MAX_WEIGHT,3000);

 
}
