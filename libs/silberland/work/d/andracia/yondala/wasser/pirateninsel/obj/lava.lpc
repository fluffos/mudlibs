#include "../def.h"

inherit "std/thing";

#include <properties.h>


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kochende Lava fliesst langsam durch den Raum");
  SetProp(P_LONG,
    "Kochende Lava fliesst langsam durch den Raum." );
  SetProp(P_NAME, "Lava");
  SetProp(P_NAME_ADJ, "kochend");
  SetProp(P_GENDER, FEMALE);
  AddId("lava");
  SetProp( P_MATERIAL, ([ MAT_FLESH : 55, MAT_SKIN: 15, MAT_BONE: 30 ]) );

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Du wuerdest sofort sterben, wenn Du die Lava nimmst.\n");
  SetProp(P_NOBUY, 1);

}


