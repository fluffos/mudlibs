// Der Schwarzgeldring, an dem ausgelesen werden kann wie hoch der Kontostand ist.

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int anzahl=0;
int guthaben= 0;
string dummies;

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein goldener Ring");
  SetProp(P_LONG,
    "Du siehst den feinen goldenen Ring, den Dir Eharl gegeben hat. Du kannst an der Innenseite eine Inschrift erkennen." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Goldring");
  SetProp(P_GENDER, MALE);
  AddId( ({"goldring", "ring", "\nschwarzgeldring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_GOLD  );
  SetProp(P_WEIGHT, 5);
 
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
	SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 100);
  AddDetail( ({ "inschrift", "innenseite" }),
    "Du kannst die Inschrift auf der Innenseite lesen.");    

  AddReadDetail( ({ "inschrift" }),
    "0");
	AddCmd( ({ "zahle", "zahl" }), "einzahlen" );
 AddCmd( ({ "loesche","loesch"}), "loeschen" );
 AddCmd( ({ "hebe","heb"}), "abheben" );

}

mixed _query_autoloadobj()
    {
      return guthaben;
    }

void _set_autoloadobj(mixed data)
    {
      guthaben=data;
    }


einzahlen(string str)
{
	if (!present("eharl", environment(TP)))//==0))
	return 0;
	//if(!"eharl" present environment(TP)) //wenn Eharl nicht da ist
	//return 0;


	notify_fail("Eharl sagt: Was wollt Ihr einzahlen?\n");
	
	if (!str)
		{
			//write ("Eharl sagt: Was wollt Ihr einzahlen?\n");
			return 0;
			}
	if (sscanf (str,"%d muenzen %s", anzahl, dummies)!=2)
			{return 0;}

//notify_fail("Eharl sagt: So viele Muenzen habt Ihr nicht dabei.\n");
//if(TP->QueryDeepMoney()<anzahl)

	if(this_player()->QueryMoney() <anzahl)
	{
		write("Eharl sagt: So viele Muenzen habt Ihr nicht dabei.\n");
		return 1;
		}
		
else
		{	
			TP->AddMoney(-anzahl);
			anzahl = anzahl/10;
			//nun soll im Raum die Funktion "mehrmuenzen" aufgerufen werden
			//heisst, "anzahl" wird zuaddiert
      call_other(to_object("/d/wasser/yondala/pirateninsel/room/piratengrotte_4b.lpc"), "mehrmuenzen", anzahl);

			anzahl = anzahl*9;
			guthaben+=anzahl;	
		  AddReadDetail( ({ "inschrift" }),
		   "Guthaben: "+guthaben+"\n");
      SetProp(P_VALUE, guthaben);
      write("Eharl sagt: Wohlan, nach Abzug der Gebuehren betraegt Euer neuer Kontostand "+
      "Eharl sagt: "+guthaben+" Muenzen.\n");
      return 1;
}
	
}
	
	
	loeschen(string str)
{
	if (!present("eharl", environment(TP)))//==0))
	return 0;

	if (str!="konto")
	{
		write("Eharl sagt: Wollt Ihr Euer Konto loeschen?\n");
		return 1;
	}
	else
	{
		if (!present ("\nschwarzgeldring",  TP))
		{
			write("Eharl sagt: Ihr habt doch gar kein Schwarzgeldkonto bei mir!\n");
			return 1;
		}

		else
		{
			write("Eharl sagt: Wohlan, Euer Konto ist nun geloescht.\nEharl sagt: Den Ring braucht Ihr ja nun nicht mehr.");
			write("Eharl nimmt Dir den Ring ab.\n");
			this_player()->AddMoney(guthaben);
			this_object()->remove();
			//obj=present ("\nschwarzgeldring",  TP);
			//obj->remove();
			return 1;
		}


	}
}


abheben(string str)
{
	if (!present("eharl", environment(TP)))//==0))
	return 0;

	if (sscanf (str,"%d muenzen %s", anzahl, dummies)!=2)
			{write("Eharl sagt: Wieviele Muenzen moechtet Ihr abheben?\n");
			return 1;}
			
			if(anzahl>guthaben)
			
			{write ("Eharl sagt: So viel habt Ihr nicht auf Eurem Konto!\n");
				return 1;}
			
			guthaben-=anzahl;
			this_player()->AddMoney(anzahl);
      SetProp(P_VALUE, guthaben);
			return 1;
}

// zu testzwecken aufladbar
int _set_guthaben(int wert)
{
	guthaben += wert;
	write( "Der Schwarzgeldring wurde geladen! Guthaben nun "+guthaben+" Muenzen." );
  SetProp(P_VALUE, guthaben);
	return guthaben;
}