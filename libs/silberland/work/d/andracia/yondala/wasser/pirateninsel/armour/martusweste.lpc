#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine verblichene Weste");
  SetProp(P_LONG,
    "Eine alte Weste, die scheinbar mal blau war, mittlerweile aber nur noch grau." );
  SetProp(P_NAME, "Weste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"weste", "alte weste", ""}) );
 // SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 100);

}
