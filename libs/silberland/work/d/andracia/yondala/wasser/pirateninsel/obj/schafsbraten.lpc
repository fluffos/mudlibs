#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schafsbraten");
  SetProp(P_LONG,
    "Du siehst einen koestlichen Schafsbraten vor Dir." );
  SetProp(P_NAME, "Schafsbraten");
  SetProp(P_GENDER, MALE);


  AddId(({"braten","schafsbraten"}));
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 60);
  
  AddCmd(({"iss","ess","esse"}), "essen");


 
}

int essen(string str)
{
	notify_fail("Was moechtest Du essen?\n");
	if (str=="braten"||str=="schafsbraten")
		{
					
     if (this_player()->eat_food(25))
     {
       write("Du stopfst einen ganzen Schafsbraten in Dich rein.\n");
       say(TPN+" stopft einen ganzen Schafsbraten in sich rein.\n",TP);
      	if(TP->id("Elfenspieler"))
				 {
				 	write("Dir wird schlecht.\n");
          say(TPN+" wird ploetzlich ganz blass.\n",TP);
          TP->AddPoison(5);
					this_player()->eat_food(-50,1);
				}
				 else this_player()->heal_self(90+random(20));
       }
      remove();
      return 1;
      }
return 0;
}      
     