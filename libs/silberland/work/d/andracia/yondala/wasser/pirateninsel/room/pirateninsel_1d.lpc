#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer hohen Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer sehr hohen Klippe. Um Dich herum siehst Du nur "
    "moosbewachsene Steine. Im Norden geht es steil abwaerts. Am strahlenden Himmel "
    "lacht die Sonne auf Dich herunter. Im Osten ist die Klippe ein bisschen hoeher "
    "als hier und schier tausende Moewen flattern dort herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer sehr hohen Klippe.");

  AddDetail( ({ "steine" }),
    "Auf den Steinen waechst Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos ist mal sehr dicht, mal spaerlich.");

  AddDetail( ({ "norden" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");


  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "blau" }),
    "Es ist das schoenste Blau, dass Du heute gesehen hast.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "osten" }),
    "Im Osten ist die Klippe ein bisschen hoeher als hier und sehr viele Moewen tummeln sich auf ihr.");
  AddDetail( ({ "boden" }),
    "Du stehst auf moosbewachsenen Steinen.");

  AddDetail( ({ "moewen" ,"moewe"}),
    "Oestlich von hier flattern, sitzen und fliegen unzaehlige Moewen. Ob "
	"sie dort ihren Nistplatz haben?");
  AddDetail( ({ "nistplatz" }),
    "Du musst schon nach Osten gehen, um das herauszufinden.");
  AddDetail( ({ "woelkchen" }),
    "Es ist keines zu sehen.");
  AddDetail( ({ "rhythmus" }),
    "Den kannst Du nicht sehen, nur hoeren.");
  AddDetail( ({ "steine" }),
    "Auf den Steinen waechst Moos.");


  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer","tosen" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe", "gekreische" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhythmus" }),
    "Hmmmm, beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddRoomMessage( 
    ({"Eine Moewe saust an Dir vorbei.\n",
    	"Du hoerst lautes Gekreische.\n",
    	"Das Tosen des Meeres wird etwas lauter.\n",
    	"Das Tosen des Meeres wird etwas leiser.\n"}),1,"func");



AddExit( "osten", "./pirateninsel_1e" );
AddExit( "westen", "./pirateninsel_1c" );


}

