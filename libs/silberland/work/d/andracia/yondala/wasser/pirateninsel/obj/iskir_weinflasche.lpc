//Weinflasche aus dem Laden der Pirateninsel

//heilt 5 HP und 5 MP, fuellt um 5 und alkoholisiert um 5

//*** Yondala@Silberland 11. April 2010 ***

#include "../def.h"

inherit "std/thing";

#include <properties.h>

int alk = 1;
string fuelle = "volle";
int sorte=random(5);
int groesse=random(3);
int voll=8;//wie sitt macht das Getraenk?
int alko;//wieviel Alk ist drin?
int heilung=50; //wieviel heilt die Flasche?
int blindmach=random(10);
int fusel=0;


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Weinflasche");
  SetProp(P_LONG,
    			"Du siehst eine alte, gefuellte Rumflasche. Der Rum wurde wohl irgendwo schwarz "
    			"gebrannt. Nur wer mutig ist, sollte daraus trinken." );
  SetProp(P_NAME, "Weinflasche");
  AddId(({"weinflasche", "wein","flasche"}));
  SetProp(P_VALUE, 500);    			
	SetProp(P_WEIGHT, 500);
  SetProp(P_GENDER, FEMALE); 
  SetProp( P_MATERIAL, ([ MAT_GLASS : 20, MAT_ALCOHOL : 80 ]) );
  AddAdjective( ({ "klein" }) );
  AddCmd(({"trink","trinke", "saufe","sauf"}),"trinkenCmd");

}



trinkenCmd(string str)
{ notify_fail("Woraus moechtest Du trinken?\n");

if (str=="flasche"||str=="aus flasche"||str=="flasche aus"||str=="weinflasche"||str=="aus weinflasche"||str=="weinflasche aus"
	str=="wein"||str=="wein aus flasche"||str=="wein aus")
	{
		if (this_player()->drink_drink(5,5))
     {
       write("Du setzt die Flasche an und trinkst sie in einem Zug leer.\n Schmeckt gar nicht so schlecht.\n");
       say(TPN+" trinkt eine Weinflasche aus.\n");
       //this_player()->heal_self(heilung);
       TP->AddHp(5);
       TP->AddSp(5);
       TO->remove();
       return 1;
       
     }
	//muesste unnoetig sein, weil das schon drink_drink ausgibt
	//else
		//{write ("So viel kannst Du nicht trinken.\n");}
	return 1;
	}
}

