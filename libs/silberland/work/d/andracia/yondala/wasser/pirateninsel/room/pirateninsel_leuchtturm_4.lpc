#include "../def.h"

inherit "std/room";

#include <properties.h>
object obj;
string str;
//int questgeschafft;

void reset()
{::reset();
	if(GetDetail("lampe"))
	tell_room(TO,"Jemand schleicht herein, nimmt die Lampe vom Haken und "+
	             "fluechtet.\n");
				 
	AddDetail( ({ "haken" }),
		"An dem Haken koennte man etwas befestigen.");
    RemoveDetail("lampe");
	
}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Leuchtturm" );
  SetProp( P_INT_LONG,
       "Du befindest Dich in der vierten Etage des Leuchtturms. Du kannst nach unten gehen. "
     "Dieser Raum ist leer, bis auf die Treppe, die nach unten fuehrt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "leuchtturm", "leuchtturms" }),
    "Ein Leuchtturm weisst Schiffen den sicheren Weg. Auch wenn sie gar nicht hierher wollen.");
  AddDetail( ({ "schiff","schiffe","schiffen", "piratenschiff","piratenschiffe" }),
    "Schiffe, die zu dieser Insel wollen.");
  AddDetail( ({ "insel" }),
    "Meistens sind das Piratenschiffe.");
  AddDetail( ({ "weg" }),
    "Den Weg hierher.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier bestehen rundherum aus Glas. Du kannst schier unendlich weit sehen.");
  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Wendeltreppe fuehrt nach unten.");
  AddDetail( ({ "glas" }),
    "Das Glas, aus dem die Waende sind, ist relativ sauber. Seltsam.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier nur aus der Treppe, ueber die Du nach oben gelangt bist.");
  AddDetail( ({ "decke" }),
    "An der Decke ist ein grosser, schmiedeeiserner Haken befestigt.");
  AddDetail( ({ "etage", "raum" }),
    "Du befindest Dich auf der obersten Etage des Leuchtturms.");
  AddDetail( ({ "leuchtturm", "leuchtturms" }),
    "Ein Leuchtturm weisst Schiffen den sicheren Weg.");
  AddDetail( ({ "schiff","schiffe","schiffen", "piratenschiff","piratenschiffe" }),
    "Schiffe, die zu dieser Insel wollen.");
  AddDetail( ({ "insel" }),
    "Meistens sind das Piratenschiffe.");
  AddDetail( ({ "haken" }),
    "An dem Haken koennte man etwas befestigen.");
  AddDetail( ({ "sinne" }),
    "Auch in keinem anderen Sinne.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Es ist absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");





AddExit( "unten", PIR_ROOM + "pirateninsel_leuchtturm_3"  );
  AddCmd(({"befestige"}),"befestigenCmd");
}



int befestigenCmd(string str)
{ notify_fail("Was moechtest Du wo befestigen?\n");

if(str=="lampe an haken")
{	
	if(!present("\nleuchtturmlampe",  TP))
{	write("Du hast keine fertige Lampe bei Dir.\n");}

else
	{
		write("Du haengst die Leuchtturmlampe an ihren Platz.\n");
		say(TPN+" haengt eine Lampe auf.\n", TP);
    AddDetail( ({ "haken" }),    "An dem Haken haengt eine grosse Lampe.");		
    AddDetail( ({ "lampe" }),    "Die Lampe ist funktionstuechtig und scheint vor kurzem ausgetauscht worden zu sein.");		

		obj=present ("\nleuchtturmlampe",  TP);
		CLONE(PIR_OBJ +"invislampe", TP);
//		questgeschafft =1;
		obj->remove();
		return 1;
		}



return 1;
}}