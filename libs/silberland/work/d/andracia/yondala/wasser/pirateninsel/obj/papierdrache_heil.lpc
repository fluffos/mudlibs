// spaeter kann man ihn dann evtl wirklich stiegen lassen.
// Idee: Ein folgender PIR_NPC, nicht angreifbar, den man fangen und damit 
// klauen kann ->dann wieder Item.

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Papierdrache");
  SetProp(P_LONG,
    "Du siehst einen kleinen, bunten Papierdrachen, der ein lustiges "
	"Gesicht und zwei niedliche Schleifchen hat. Eine Schnur baumelt "
	"an ihm herunter. Ob man ihn steigen lassen kann?" );
  SetProp(P_NAME, "Papierdrache");

  SetProp(P_GENDER, MALE);
  AddId(({"drache","papierdrache", "drachen","papierdrachen"}));

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 150);

  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 0);

  AddDetail( ({ "gesicht" }),
    "\n"
    "         /\\             \n"
	"        /  \\            \n"
	"       /O  O\\           \n"
	"    >>/  °   \\<<        \n"
	"      \\  V   /          \n"
	"       \\    /    _      \n"
	"        \\  /    /        \n"
	"         \\/  >><<       \n"
	"          \\__/          \n");
 
 AddDetail( ({ "schleifchen" }),
    "Rechts und links des Gesichts siehst Du zwei kleine Schleifchen.");
 AddDetail( ({ "mittelstange","stange" }),
    "Die Mittelstange ist leider gebrochen, sie wurde aber notduerftig verklebt.");
 AddDetail( ({ "schnur" }),
    "Die Schnur baumelt an dem Drachen.");
AddCmd(({"lasse","lass"}),"steigenlassen");
}

int steigenlassen(string str)
{
  object ob,ob2;
  notify_fail("Was willst Du steigen lassen?\n");
  if(str!="drachen steigen"&&str!="drache steigen"&&str!="papierdrache steigen"&&str!="papierdrachen steigen")return 0;
  write("Du wickelst die Schnur ein Stueckchen ab und laesst den Drachen steigen.\n");
  say(TPN+" laesst einen Drachen steigen.\n");
  ob=clone_object(PIR_NPC+"papierdrache_fliegend");
  ob->verfolgen(TP);
  ob->move(environment(TP),M_GO);
  CLONE(PIR_OBJ +"papierdrachenschnur",TP);
  ob->schnurkriegen(present("drachenschnur",TP));
  present("drachenschnur",TP)->drachekriegen(ob);
  
  /*ob2=clone_object(PIR_OBJ +"drachenschnur");
  ob2->drachekriegen(ob);
  ob2->move((TP),M_SILENT);*/
  remove();
  return 1;
  }