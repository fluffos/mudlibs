//Farbe=random

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

string farb;
int farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
farbe = random(6);
switch(farbe)
{	case 1: {      
   farb="rot";
     SetProp(P_SHORT, "Ein rotes Hemd");
     	break;}
  case 2: {      
   farb="gelb";
   SetProp(P_SHORT, "Ein gelbes Hemd");
	break;}
	case 3: {      
   farb="gruen";
   SetProp(P_SHORT, "Ein gruenes Hemd");
	break;}
	case 4: {      
   farb= "blau";
   SetProp(P_SHORT, "Ein blaues Hemd");
	break;}
	case 5: {      
   farb="braun";
   SetProp(P_SHORT, "Ein braunes Hemd");
	break;}
	default: {
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_SHORT, "Ein schwarzes Hemd");
}
}
 SetProp(P_NAME_ADJ, farb);

  SetProp(P_LONG,
    "Du siehst ein altes, zerrissenes Hemd vor Dir, welches sicher mal "+farb+" war." );
  SetProp(P_NAME, "Hemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 50);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE:150]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}