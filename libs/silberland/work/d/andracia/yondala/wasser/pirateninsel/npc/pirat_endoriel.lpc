//Hier beginnt und endet die Quest "Sammle die Zaubertrankzutaten"
//Man bekommt eine Liste die man abarbeiten muss.


//11.09.2022, Yondala: Quest debuggt, gibt jetzt elfenpirat_questliste aus
//					   Infos zu den gesuchten Items gegeben
//12.05.2010, Yondala: Traegt nun Standardruestung
//01.05.2010, Yondala: Ueberarbeitet fuer das Silberland
//14.10.2008, Yondala: Endoriel gibt nun seinen Saebel als Belohnung, immerhin.
//14.10.2008, Yondala: Questbelohnung ist nun das Portal nach Lunia


#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"
inherit PIR_NPC + "pirat_std.lpc";

string liste()
{
		if(this_player()->QueryQuest("Der einsame Elfenpirat")) //Wenn die Quest schon beendet wurde
		return "Ihr habt mir schon einmal geholfen, doch habt Ihr mir kein Glueck gebracht, "
		"kurz, nachdem Ihr weg wart verwandelte sich Ronaria wieder in Stein.\n "+
		"Ich warte lieber auf jemand anderen, danke.\n";

 	if(present("\nzaubertrankzutaten",TP))//Wenn die Quest schon begonnen wurde
		return "Ihr habt die Liste doch bereits. Wenn Ihr eine der Zutaten habt, so gebt sie mir einfach.\n";


  CLONE(PIR_OBJ +"elfenpirat_questliste", TP);
		return "Hier habt Ihr die Liste, bitte bringt mir die Zutaten, die darauf stehen.\n";
	
	}


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Endoriel");
  SetProp(P_LONG,
    "Du siehst einen grossen, selbst fuer einen Elf sehr duennen Mann vor Dir. "
    "Es scheint ihm nicht gut zu gehen, seine Haut ist sehr blass und unter seinen "
    "Augen breiten sich dunkle Ringe aus. Seine Kleidung zeugt von seiner elfischen "
    "Herkunft, doch sie ist alt und abgetragen.");
  SetProp(P_NAME, "Endoriel");
  SetProp(P_GENDER, MALE);
  AddId(({"endoriel", "elf", "pirat", "ENDORIEL"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Rondaria, ich komme!");
  SetProp(P_KILL_NAME, "Endoriel");
//  SetProp(P_KILL_MSG, "");

  AddInfo(DEFAULT_INFO, "schuettelt traurig den Kopf.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"statue","frau"}),
    "Die Statue dort, das ist meine Frau, Rondaria. Oder zumindest ist "
	"es das, was von ihr uebrig ist.",
    "sagt: ");
  AddInfo( ({"rondaria",""}),
    "Rondaria wurde von einem boesen Fluch getroffen und dadurch in Stein "
	"verwandelt. Ich weiss aber, dass es eine Moeglichkeit gibt, sie "
	"zurueck zu verwandeln.",
    "sagt: ");
  AddInfo( ({"moeglichkeit",""}),
    "Es heisst, man kann einen Zaubertrank brauen und wenn man den dann "
	"ueber die Statue kippt, dann wird sie wieder lebendig.",
    "sagt: ");
  AddInfo( ({"zaubertrank","trank"}),
    "Leider kenne ich das Rezept nicht.",
    "sagt: ");
  AddInfo( ({"hilfe",""}),
    "Ich kann Euch das Rezept geben, um den Zaubertrank herzustellen.",
    "sagt: ");
  AddInfo( ({"endoriel","piratenelf"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({"kessel",""}),
    "In dem Kessel ist Suppe. Mit Magie halte ich diese warm, denn ein "
	"Feuer waere hier verheerend.",
    "sagt: ");
  AddInfo( ({"suppe","algensuppe","schiffszwieback","zwieback", "fisch",
             "hecht","seehecht","wein","elfenwein","vulkanblume","wasser",
			 "schaum","blut","haiblut","elfenwein", "angebot"}),
    "Mit <menue> koennt Ihr sehen, was ich Euch an Speisen und Getraenken biete.",
    "sagt: ");
  AddInfo( ({"fluch"}),
    "Die anderen Elfen haben Rondaria verflucht als Strafe fuer mich, der ich "
    "abtruennig wurde und aus Abenteuerlust mich der Meute der Piraten anschloss.",
    "sagt: ");
  AddInfo( ({"elfen",""}),
    "Die Elfen aus Aboriville haben mich verbannt und meine Frau in Stein verwandelt.",
    "sagt: ");
  AddInfo( ({"aboriville","elfenstadt"}),
    "Da komm ich her, doch ach, ich kann nie mehr zurueck.",
    "sagt: ");
  AddInfo( ({"kneipe",""}),
    "Ihr steht in meiner Waldkneipe.",
    "sagt: ");
  AddInfo( ({"waldkneipe","wurzeln","wurzel"}),
    "Ich habe mir diese Kneipe mittels meiner Magie wie einen Wald eingerichtet, weil ich meine Heimat so sehr vermisse.",
    "sagt: ");
  AddInfo( ({"heimat",""}),
    "Ich stamme aus Aboriville, der Elfenstadt.",
    "sagt: ");
  AddInfo( ({"meerwasser",""}),
    "Nun, dieses Wasser ist besonders gesund, sagt man.",
    "sagt: ");
  AddInfo( ({"magie",""}),
    "Mit meiner Magie erschuf ich diese Kneipe. Sie erinnert mich an meine "
    "Heimat. Ich verlasse sie nie, denn die Steine und das Meer draussen kann "
    "ich nicht mehr ertragen. Das ganze hier am Leben zu erhalten kostet mich viel Kraft.",
    "sagt: ");
  AddInfo( ({"meer","steine"}),
    "Alles, was ich will ist in Frieden in der Natur leben.",
    "sagt: ");
  AddInfo( ({"natur",""}),
    "Wir Elfen leben im Einklang mit der Natur.",
    "sagt: ");
  AddInfo( ({"frieden","friede"}),
    "Meinen Frieden werde ich wohl nie mehr finden.",
    "sagt: ");
  AddInfo( ({"kraft",""}),
    "Ich habe sehr viel Kraft. Doch die meiste davon verwende ich, um "
	"mir meine Illusion zu erhalten.",
    "sagt: ");

  AddInfo( ({"feuer",""}),
    "Ein Feuer waere hier sehr schlimm, es wuerde meine Kneipe vernichten.",
    "sagt: ");
  AddInfo( ({"strafe",""}),
    "Ich bin gestraft genug.",
    "sagt: ");
  AddInfo( ({"abenteuerlust",""}),
    "Frueher war ich voller Abenteuerlust. Doch die ist mir vergangen, "
	"seit meine Frau nicht mehr bei mir ist.",
    "sagt: ");

  AddInfo( ({"rezept"}),
    "Das Rezept ist ziemlich kompliziert. Es reicht, wenn Ihr mir die Zutaten auf der Liste bringt.",
    "sagt: ");
  AddInfo( ({"zutaten"}),
    "Die Zutaten stehen auf einer Liste.",
    "sagt: ");

//Gruppe a ({"banane","eisen", "grashalm", "kitt", "pferdehaar","sack","vulkanblume"});

  AddInfo( ({"banane","bananen"}),
    "Bananen wachsen da, wo es warm ist. Sogar hier auf der Insel.",
    "sagt: ");  
  AddInfo( ({"eisen"}),
    "Eisen bekommt man bei einem Schmied. Oder bei Piraten.",
    "sagt: ");
  AddInfo( ({"grashalm","gras"}),
    "Gras waechst ja fast ueberall. Sogar hier auf der Insel.",
    "sagt: ");
  AddInfo( ({"kitt"}),
    "Kitt braucht man hin und wieder. Fragt mal Trogurt danach.",
    "sagt: ");
  AddInfo( ({"pferdehaar"}),
    "Das Haar eines Pferdes bekommt Ihr bei einem Pferd. Auf dieser Insel gibt es keine Pferde. Vielleicht irgendwo auf dem Festland?",
    "sagt: ");
  AddInfo( ({"sack"}),
    "Der ein oder andere Wanderer hat sicher einen dabei.",
    "sagt: ");
  AddInfo( ({"wanderer"}),
    "Wanderer erkunden die Welt und bleiben nie lange an einem Ort.",
    "sagt: ");
  AddInfo( ({"vulkanblume"}),
    "Vulkanblumen wachsen in Vulkanen. Es ist allerdings hoechst gefaehrlich, in einen hinab zu steigen.",
    "sagt: ");
//Gruppe b ({"apfel","pflaume", "kirschen", "birne", "aprikose", "obstkuchen"});  
  AddInfo( ({"apfel","pflaume","kirschen","birne"}),
    "Dieses Obst waechst leider nicht auf unserer Insel. Ich meine aber, dass Hildgunde mir von den Obstgaerten in ihrer Heimat erzaehlt hat.",
    "sagt: ");
  AddInfo( ({"obstkuchen"}),
    "Ihr koenntet ihn irgendwo kaufen. Oder am besten selbst einen backen. Leider gibt es hier keine Backstube.",
    "sagt: ");
  AddInfo( ({"backstube"}),
    "Auf dieser Insel ist leider keine. Schaut Euch bei den Menschen um, die backen doch recht gerne.",
    "sagt: ");
//Gruppe c({"stein", "kaulquappe", "wurmhaut", "wurzel", "korn", "mistkugel", "bluemchen", "elfenkraut", "raupenseide", "schinken"});
 AddInfo( ({"stein"}),
    "Einen Stein zu finden duerfte nicht so schwierig sein. Es gibt viele Steine auf der Welt. "
	"Hier und da. Am liebsten waere mir allerdings ein Stein aus den Nebelwaeldern, die sind so schoen fluffig.",
    "sagt: ");
  AddInfo( ({"kaulquappe"}),
    "Oh, die Kaulquappen sind schwierig zu bekommen. Am besten sind jene, die man in Wasserpfuetzen in nebeligen Waeldern findet.",
    "sagt: ");
  AddInfo( ({"wurmhaut"}),
    "Eine Wurmhaut erhaelt man, in dem man einen Wurm haeutet. Am leichtesten geht es mit Wuermern "
	"aus dem Nebelwald. Zur Not tut es aber auch jede andere Wurmhaut.",
    "sagt: ");
  AddInfo( ({"wurzel"}),
    "Bei Wurzeln bin ich nicht waehlerisch. Irgendeine. Die schmackhaftesten gibt es im Nebelwald "+
	"auf dem Festland. Aber auf den Geschmackt kommt es nicht an, hauptsache, der Trank wirkt, nicht wahr?",
    "sagt: ");
  AddInfo( ({"korn"}),
    "Ein Korn findet man sicher in der Naehe eines Bauernhofes, nicht wahr?",
    "sagt: ");
  AddInfo( ({"mistkugel"}),
    "Mistkugeln kann man viele finden, ich brauche aber eine, die von einem Mistkaefer gedreht wurde.",
    "sagt: ");
  AddInfo( ({"mistkaefer"}),
    "Auf der Insel gibt es keine. Versucht es in einem grossen, hellen Wald.",
    "sagt: ");
  AddInfo( ({"bluemchen"}),
    "Irgendein Bluemchen werden Ihr schon finden.",
    "sagt: ");
  AddInfo( ({"elfenkraut"}),
    "Das Elfenkraut koennt Ihr bei den Faunen in der Naehe meiner Heimat finden.",
    "sagt: ");
  AddInfo( ({"heimat","aboriville"}),
    "Ich stamme aus Aboriville.",
    "sagt: ");
  AddInfo( ({"raupenseide"}),
    "Toetet einfach eine Raupe und klaut ihre Seide.",
    "sagt: ");
  AddInfo( ({"schinken"}),
    "Guten Schinken hatte ich lange nicht mehr. Ich esse auch eigentlich kein Fleisch, aber bei dem "
	"Schinken aus Friedheim bin ich doch mal schwach geworden.",
    "sagt: ");
//({"lollie", "kaese", "klinke","moertel", "seil", "zahn", "zwergenhaar"});
 
 AddInfo( ({"lollie"}),
    "Kinder essen gerne Lollies. Hier gibt es keine Kinder.",
    "sagt: ");
  AddInfo( ({"kaese"}),
    "Kaese ist etwas gutes. Manchmal importiere ich welchen aus der alten Welt. Manchmal aber auch aus Friedheim.",
    "sagt: ");
  AddInfo( ({"alte welt"}),
    "Alles, was nicht zum Kontinent Andracia gehoert, nennen wir die alte Welt.",
    "sagt: ");
  AddInfo( ({"kontinent","andracia"}),
    "Wir befinden uns hier auf dem Kontinent Andracia.",
    "sagt: ");
  AddInfo( ({"welt"}),
    "Welche? Die alte oder die neue Welt?",
    "fragt: ");
  AddInfo( ({"neue welt"}),
    "Als neue Welt bezeichnen wir den Kontinent Andracia, weil er erst spaeter entdeckt wurde als die alte Welt.",
    "sagt: ");
  AddInfo( ({"moertel"}),
    "Moertel findet man ja ueberall dort, wo etwas kuenstlich geschaffen wurde. Ich brauche aber "
	"speziellen Moertel, den nur die Gierlinge Andracias verwenden.",
    "sagt: ");
  AddInfo( ({"klinke"}),
    "Verrueckt, was eine Klinke in einem Zaubertrank zu suchen hat. Schaut Euch bei den Gierlingen um, "
	"ich hoerte, dass man dort welche erstehen kann.",
    "sagt: ");
  AddInfo( ({"gierlinge"}),
    "Die Gierlinge sind eine Art von Kobolden. Nur selten bekommt man welche zu Gesicht. "
	"Ich hoerte aber, dass es im Gebirge im Osten Andracias ein Dorf von ihnen gibt, das nicht ganz so gut versteckt ist.",
    "sagt: ");
  AddInfo( ({"seil"}),
    "Nun, ein gewoehnliches Seil werdet Ihr wohl auftreiben koennen, nicht wahr?",
    "fragt: ");
  AddInfo( ({"zahn"}),
    "Schlagt einfach jemanden oder etwas einen Zahn aus. Gerne kleinen Nagetieren.",
    "sagt: ");
  AddInfo( ({"nagetiere"}),
    "Die findet man ueberall.",
    "sagt: ");
  AddInfo( ({"zwergenhaar"}),
    "Zwergenhaar ist etwas feines. Wenn man es richtig behandelt, wird es ganz weich. Wir Elfen lieben es.",
    "sagt: ");

//gruppe_e=({"ei", "champignon", "fledermausfluegel", "himbeere", "fliegenpilz"});
   AddInfo( ({"ei"}),
    "Voegel legen Eier. Am einfachsten bekommt man Eier von Huehnern.",
    "sagt: ");
  AddInfo( ({"huehner"}),
    "Hier gibt es keine Huehner. Versucht es auf einen Bauernhof.",
    "sagt: ");
  AddInfo( ({"bauernhof"}),
    "Der einzigen Bauernhof, den ich kenne, befindet sich in der Naehe von Friedheim, der Menschensiedlung.",
    "sagt: ");
  AddInfo( ({"menschensiedlung"}),
    "Friedheim ist die einzige Menschensiedlung, die mir bekannt ist. Von dieser Insel mal abgesehen.",
    "sagt: ");
  AddInfo( ({"champignon"}),
    "Champignons wachsen da, wo es feucht und lichtarm ist. Ich wuerde es mal in einem Nebelwald versuchen.",
    "sagt: ");
  AddInfo( ({"fledermausfluegel"}),
    "Wenn Ihr den Fluegel einer Fledermaus braucht, solltet Ihr sie toeten. Freiwillig gibt sie den bestimmt nicht her.",
    "sagt: ");
  AddInfo( ({"fledermaus"}),
    "Fledermaeuse leben in Hoehlen. Da kenne ich mich nicht aus.",
    "sagt: ");
  AddInfo( ({"hoehlen"}),
    "Hoehlen gibt es viele. Da wo Berge sind, aber auch sonst oft. Sogar im Nebelwald soll eine sein.",
    "sagt: ");
  AddInfo( ({"himbeere","himbeeren"}),
    "Ich mag Himbeeren. Die besten wachsen im Nebelwald in der neuen Welt.",
    "sagt: ");
  AddInfo( ({"fliegenpilz"}),
    "Vorsicht, Fliegenpilze sind giftig, man muss sie gut dosieren, wenn man sie verwenden will. Die wirksamsten "
	"Fliegenpilze wachsen im Nebelwald in der neuen Welt. Zur Not tut es aber auch ein Fliegenpilz von einem anderen Ort.",
    "sagt: ");
//gruppe_f=({"hasenpfote", "margarite", "mohn", "veilchen", "eis", "liebesapfel", "popcorn","zuckerstange"});
  AddInfo( ({"hasenpfote"}),
    "Wenn Ihr die Pfote eines Hasen haben moechtet, so solltet Ihr ihn vorher toeten. Ist sonst unmenschlich. Aber freiwillig "
	"geben die Viecher ihre Pfoten nicht her.",
    "sagt: ");
  AddInfo( ({"hasen"}),
    "Hasen gibt es viele. Die besten gibt es im Wald der Faune, sagte man mir.",
    "sagt: ");
  AddInfo( ({"margarite"}),
    "Margariten wachsen gerne auf freien Wiesen. Versucht Euer Glueck doch in der Naehe der Menschensiedlung.",
    "sagt: ");  
  AddInfo( ({"veilchen"}),
    "Veilchen wachsen gerne auf freien Wiesen. Versucht Euer Glueck doch in der Naehe der Menschensiedlung.",
    "sagt: ");
  AddInfo( ({"glueck"}),
    "Glueck kann man nicht lernen oder kaufen. Es kommt und geht, wie es ihm gefaellt. Mal hat man es, mal nicht.",
    "sagt: ");
   AddInfo( ({"mohn"}),
    "Mohn waechst gerne auf freien Wiesen. Versucht Euer Glueck doch in der Naehe der Menschensiedlung.",
    "sagt: ") ;
  AddInfo( ({"eis"}),
    "Eis ist eine tueckische Sache. Man muss damit extrem schnell sein, sonst ist es auch schon wieder weg."
	"Das beste Eis gibt es in Lunia. Vielleicht findet Ihr jemanden, der es Euch schnell bringen kann?",
    "sagt: ");
  AddInfo( ({"liebesapfel"}),
    "Liebesaepfel gibt es viel zu selten. Sie sind so suess und koestlich. In Lunia gibt es welche, hoerte ich.",
    "sagt: ");
  AddInfo( ({"lunia", "hauptstadt"}),
    "Lunia ist die Hauptstadt Andracias. Ich war noch nie dort und werde auch nie mehr dort hingelangen.",
    "sagt: ");
  AddInfo( ({"popcorn"}),
    "Ha, Popcorn ist eine lustige Sache. Erst kleine goldene Kuegelchen und *popp* schon ein leckerer Snack. "
	"Angeblich gibt es welches in Lunia.",
    "sagt: ");
  AddInfo( ({"zuckerstange"}),
    "Zucker ist sehr ungesund und ich weiss nicht, welcher kranke Geist diesen dann auch noch in "
	"stangenform pressen musste. Sowas faellt auch nur Lunianern ein.",
    "sagt: ");
  AddInfo( ({"lunianer"}),
    "So nennt man die Einwohner Lunias.",
    "sagt: ");
  AddInfo( ({"einwohner"}),
    "Da wo jemand wohnt, ist er Einwohner. Logisch, oder?",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
//string *gruppe_g=({"schmetterlingsfluegel", "kaeferzange", "kerze","treibholz", "pilz", "elfenfrucht", "wolle", "gluehwuermchen", "nuss"});

  AddInfo( ({"schmetterlingsfluegel"}),
    "Um an den Fluegel eines Schmetterlings zu kommen, muesst Ihr diesen toeten. Sonst gibt er ihn nicht her. Die "
	"besten Schmetterlingsfluegel gibt es im Nebelwald. Ich nehme aber auch jeden anderen.",
    "sagt: ");
  AddInfo( ({"kaeferzange"}),
    "Um an die Zange eines Kaefers zu kommen, muesst Ihr diesen toeten. Freiwillig gibt er die nicht her. "
	"Passt aber auf, dass Euch die Elfen dabei nicht erwischen, die moegen es nicht, wenn man andere "
	"Lebewesen angreift.",
    "sagt: ");
  AddInfo( ({"kerze"}),
    "Sofern Ihr nicht in der Kunst des Kerzenziehens bewandert seid, koennt Ihr die Kerze auch einfach irgendwo kaufen.",
    "sagt: ");
  AddInfo( ({"treibholz"}),
    "Treibholz wird immer mal wieder an den Strand gespuelt. Selbst hier kommt das ab und an vor.",
    "sagt: ");
  AddInfo( ({"pilz"}),
    "Pilze wachsen da, wo es feucht und lichtarm ist. Ich wuerde es mal in einem Nebelwald versuchen. "
	"Oder da, wo Menschen sind.",
    "sagt: ");
  AddInfo( ({"elfenfrucht","elfenfruechte"}),
    "Elfenfruechte wachsen dort, wo Elfen leben. Oder anders herum. Niemand weiss mehr, was zuerst da war.",
    "sagt: ");
  AddInfo( ({"wolle"}),
    "Diverse Tiere geben Wolle. Am besten ist die Wolle eines Schafes.",
    "sagt: ");
  AddInfo( ({"schaf","schafe"}),
    "Schafe gibt es ueberall. Fragt mal einen Teiheb, die sind die besten Schafzuechter der neuen Welt.",
    "sagt: ");
  AddInfo( ({"teiheb"}),
    "Ich habe gehoert, dass dies die besten Schafzuechter sind. Begegnet ist mir noch keiner. Angeblich "
	"sind sie Nomaden, die durch die neue Welt ziehen. Einer hat sich wohl im Tal bei den Elfen niedergelassen.",
    "sagt: ");
  AddInfo( ({"gluehwuermchen"}),
    "Die sind echt ueberall. Am besten sehen kann man sie allerdings in dunklen Tannenwaeldern.",
    "sagt: ");
  AddInfo( ({"tannenwald","tannenwaelder"}),
    "Tief im Osten Andracias soll ein dunkler Tannenwald sein. Ich war dort noch nie, denn dort ist kein Hafen.",
    "sagt: ");
  AddInfo( ({"nuss","nuesse"}),
    "Nuesse findet man in Waeldern. Mir wurden mal welche aus einem Faunenwald mitgebracht, die waren "
	"ganz vorzueglich. Es tut aber auch jede andere Nuss.",
    "sagt: ");
  AddInfo( ({"faunenwald"}),
    "Der liegt angeblich ganz im Osten Andracias, ich selbst war dort noch nie und kann Euch "
	"nicht sagen, ob an dem Geruecht etwas dran ist.",
    "sagt: ");
  AddInfo( ({"geruecht","seemannsgarn"}),
    "Man weiss nie, ob das, was man hoert, aber nicht selbst sieht, nun wahr, oder doch bloss Seemannsgarn ist.",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");

  // SetProp(P_LOG_INFO, "yondala");

  AddInfo( ({"liste"}), #'liste, "sagt: ");
 /* AddInfo( ({"liste"}),
    "Die Quest ist derzeit deaktiviert, bitte hab etwas Geduld und frag Yondala immer wieder, wann es wieder geht, das hilft bestimmt.",
    "sagt: ");
*/
  SetProp(P_SPELLRATE,10);
    AddSpell(9,400,
              "Endoriel beschwoert ein Magiefeld herauf.\n",
              "Endoriel beschwoert ein Magiefeld ueber @WEN.\n",
              ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
     AddSpell(1,1000,
              "Endoriel sammelt seine Kraft und beschwoert ein riesiges Magiefeld herauf.\n",
              "Endoriel sammelt seine Kraft und beschwoert ein riesiges Magiefeld ueber @WEN.\n",
              ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );


//noch erweitern
  SetChats(1, ({
    "Endoriel seufzt.\n",
	"Endoriel schaut sich mutlos um.\n"}) );
//  SetAttackChats(10, ({
//    ".\n"}) );

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");  
  CLONEME(PIR_WEAPON +"endoriel_saebel" );
  command("zuecke saebel");    
}

// Mitloggen wenn einen Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



give_notify(object ob)//anschauen was gegeben wird
 {
 	/*string *zutaten;
	object liste;
	int i;
	string item;//Die id eines Items was fuer die Quest benoetigt wird.
	*/
	if(present("\nzaubertrankzutaten",TP))//Wenn die Quest schon begonnen wurde
  	{
  		//if(present("\nzaubertrankzutaten",TP)->wirdgebraucht(lower_case(ob->QueryProp(P_NAME)))) 
		if(present("\nzaubertrankzutaten",TP)->itemtest(ob)) 
		{
			command("sag Habt Dank, "+TPN+"!");
			//ob->remove();
			if(!present("\nzaubertrankzutaten",TP)->listenlaenge())//Liste leer, Quest erfuellt
			{
				present("\nzaubertrankzutaten",TP)->remove();
  		 		questende(TP);
			}
		}
		else
		{
			command("sag Das benoetige ich nicht, "+TPN+"!");
			ob->move(TP, M_GET);//gibt zurueck
		}
	}

	else //wenn der Spieler die Quest nicht macht
    {
  		command("sag Was soll ich damit, "+TPN+"?");
  	    ob->move(TP, M_GET);//gibt zurueck
  	 }
  }
  	
  	
void questende()
{
	command("sag Habt Dank, "+TPN+", dieses war die letzte Zutat, ich kann nun mit dem "+
	"Trank beginnen und meine geliebte Rondaria zurueckholen in das Reich der Lebenden.");
	call_out("questende1", 3);	
	}
void questende1()
{
	tell_room(environment(TO), "Endoriel holt einen Kessel hervor und wirft die Zutaten und "+
	                           "noch ein paar andere Dinge hinein.\n");
	call_out("questende2", 2);	
	}	

void questende2()
{
	tell_room(environment(TO), "Endoriel zaubert ein Feuer unter den Kessel.\n");
	call_out("questende3", 4);	
	}	

void questende3()
{
	tell_room(environment(TO), "Langsam beginnt das Gemisch im Kessel zu blubbern.\n");
	call_out("questende4", 3);	
	}	
	
void questende4()
{
	tell_room(environment(TO), "Endoriel murmelt ein paar magische Worte, dann nimmt er den "+
	"Kessel.\nDas Feuer erlischt.\n");
	call_out("questende5", 3);	
	}			
void questende5()
{
	tell_room(environment(TO), "Endoriel besprenkelt die Statue mit dem Gebraeu.\n");
	call_out("questende6", 5);	
	}	

void questende6()
{
	tell_room(environment(TO), "Nichts passiert.\n");
	call_out("questende7", 5);	
	}	

void questende7()
{
	tell_room(environment(TO), "Ploetzlich beginnt die Statue zu broeckeln.\n");
	call_out("questende8", 3);	
	}	

