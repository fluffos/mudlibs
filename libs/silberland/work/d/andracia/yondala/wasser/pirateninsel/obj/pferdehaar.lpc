
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pferdehaar");
  SetProp(P_LONG,
    "Du siehst ein langes, schwarzes Haar aus dem Schweif eines Pferdes." );
  SetProp(P_NAME, "Pferdehaar");

  SetProp(P_GENDER, NEUTER);
  AddId(({"haar","pferdehaar", "\nhildgundeitem"}));

  SetProp(P_MATERIAL, MAT_HAIR);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
 

}
