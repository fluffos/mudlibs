#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std.lpc";
#include <properties.h>

void create() 
{
  ::create();


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen, duesteren Grotte. Vor Dir liegt "
    "ein Steg, der hier ueber der Wasserflaeche angelegt wurde. Du kannst "
    "ihn betreten oder wieder nach oben an die frische Luft klettern.\n"
    "Oestlich von Dir ist ein kleiner Laden, den Du betreten kannst." );

  AddDetail( ({ "laden" }),
    "Wenn Du etwas kaufen oder verkaufen moechtest solltest Du ihn betreten.");    
  AddDetail( ({ "" }),
    "");    





AddExit( "sueden", PIR_ROOM + "piratengrotte_4e" ); 
AddExit( "oben", PIR_ROOM + "pirateninsel_3e" ); 
AddExit( "osten", PIR_ROOM + "piratengrotte_3f" ); 

}

