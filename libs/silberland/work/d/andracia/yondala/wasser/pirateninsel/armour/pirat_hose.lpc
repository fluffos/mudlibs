//clont sich in einer durch random bestimmten Farbe

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

string farb;
int farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
farbe = random(6);
switch(farbe)
{	case 1: {      
   farb="rot";
   SetProp(P_SHORT, "Eine rote Hose");
   break;}
  case 2: {      
   farb="gelb";
   SetProp(P_SHORT, "Eine gelbe Hose");
	break;}
	case 3: {      
   farb="gruen";
   SetProp(P_SHORT, "Eine gruene Hose");
	break;}
	case 4: {      
   farb= "blau";
   SetProp(P_SHORT, "Eine blaue Hose");
	break;}
	case 5: {      
   farb="braun";
   SetProp(P_SHORT, "Eine braune Hose");
	break;}
	default: {
  farb="schwarz";
  SetProp(P_SHORT, "Eine schwarze Hose");
  }
}
 SetProp(P_NAME_ADJ, farb);

  SetProp(P_LONG,
    "Du siehst eine alte, verblichene "+farb+"e Hose vor Dir." );
  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE:150]) );
}

int WearFunc(object me) {
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}