//Ueberarbeitet fuer das Silberland
//Yondala@Silberland 14.04.2010

#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Klippe. Der Wind tost um Dich herum und "
    "wirft Dich fast um. Der Boden besteht aus moosbewachsenen Steinen, "
	"viel mehr gibt es hier kaum. Neben Dir geht es steilabwaerts, fern "
	"im Sueden siehst Du die Felsen in eine weite Duenenlandschaft "
	"uebergehen, im Nordwesten kannst Du weiter die Klippen besteigen. "
	"Nach Suedwesten zweigt ein schmaler Weg ab. "
    "Am strahlenden Himmel lacht die Sonne auf Dich herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );
AddItem(PIR_NPC + "moewe",REFRESH_DESTRUCT);

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer Klippe.");

  AddDetail( ({ "steine" }),
    "Die Steine sind allesamt gross und unbearbeitet. Auf manchen waechst ein bisschen Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos waechst auf einigen Stellen sehr dicht und in einem satten Gruen, an anderen ist "
    "es eher ausgetrocknet und gelb.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");


  AddDetail( ({ "suedwesten" }),
    "Suedlich von Dir gehen die Felsen in Duenen ueber.");
  AddDetail( ({ "duenen", "duenenlandschaft" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Die Huegel, die Du suedwestlich von hier findest, sind aus Sand.");
  AddDetail( ({ "wind" }),
    "Der Wind blaest hier oben kraeftig, Du kannst Dich kaum auf den Beinen halten.");
  AddDetail( ({ "beine" }),
    "Noch tragen sie Dich, wohin Du willst.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "sand", "steinchen" }),
    "Sand besteht aus winzigkleinen Steinchen.");

  AddDetail( ({ "stellen" }),
    "An den eher schattigen Stellen waechst das Moos saftiger als an den Stellen, "
    "an denen es der Sonne schutzlos ausgeliefert ist.");

  AddDetail( ({ "blau" }),
    "Wirklich, ein praechtiges Blau.");



  AddDetail( ({ "osten", "norden" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");


  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten Blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "suedwesten" }),
    "Dort fuehrt ein kaum wahrnehmbarer Weg zu einer leichten Erhebung.");
  AddDetail( ({ "boden" }),
    "Du stehst auf moosbewachsenen Steinen.");

  AddDetail( ({ "erhebung" }),
    "Es ist zwar kein ausgebauter Weg da, aber Du bist Dir sicher, relativ gefahrlos dorthin gehen zu koennen.");

  AddDetail( ({ "weg" }),
    "Eigentlich ist keiner da, aber einige Spuren zeugen davon, dass hier ab und zu jemand hergeht.");
 
  AddDetail( ({ "spuren" }),
    "Fussabdruecke im Moos, ein paar Schleifspuren an den Steinen.");

  AddDetail( ({ "fussabdruecke" }),
    "Hier scheint erst kuerzlich jemand hergegangen zu sein.");

  AddDetail( ({ "schleifspuren" }),
    "Jemand scheint hier etwas schweres entlang gezogen zu haben.");
  AddDetail( ({ "jemand" }),
    "Dieser Jemand ist gerade nicht hier.");
  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten ist die Klippe ein bisschen hoeher als hier und sehr viele Moewen tummeln sich auf ihr.");
  AddDetail( ({ "moewen" }),
    "Nordwestlich von hier flattern, sitzen und fliegen unzaehlige Moewen. Ob sie dort ihren Nistplatz haben?");
  AddDetail( ({ "nistplatz" }),
    "Du musst schon nach Nordwesten gehen, um das herauszufinden.");

  AddDetail( ({ "gruen" }),
    "Ein sattes, kraeftiges Gruen.");
  AddDetail( ({ "woelkchen","wolke" }),
    "Es ist kein Woelkchen zu sehen.");
  AddDetail( ({ "sueden" }),
    "Fern im Sueden siehst Du die Felsen in eine weite Duenenlandschaft "
	"uebergehen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer","tosen","meeresrauschen" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe","gekreische" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhytmus" }),
    "Hmmmm, beruhigend.");
  AddSound( ({ "wind" }),
    "Der Wind blaest mit ohrenbetaeubendem Getoese um Dich herum.");
  AddSound( ({ "getoese" }),
    "Du kannst kaum das Meeresrauschen oder das Gekreische der Moewen "
	"hoeren, so laut ist der Wind.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddRoomMessage( 
    ({"Eine Moewe saust an Dir vorbei.\n",
    	"Du hoerst lautes Gekreische.\n",
    	"Das Tosen des Meeres wird etwas lauter.\n",
    	"Das Tosen des Meeres wird etwas leiser.\n"}),1,"func");

  
 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_1e" );
 AddExit( "suedwesten", PIR_ROOM + "pirateninsel_3e" );
 AddExit( "suedosten", PIR_ROOM + "pirateninsel_3g" );

}
