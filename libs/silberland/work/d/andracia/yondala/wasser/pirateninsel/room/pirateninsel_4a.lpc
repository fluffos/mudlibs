// 27.04.2010: Nun kann man hier einmal pro reset nen Papierdrachen finden
// ausserdem kann man Holz einsammeln
// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 27.04.2010

#include "../def.h"
inherit "std/room";
#include <properties.h>
int holzda;
void reset()
{
::reset();
  if(!GetDetail("drache"))
  tell_room(TO,"Ein kleiner Papierdrache wird herangeweht und verfaengt "+
  "sich in den Zweigen des Baumes.\n");
  
  AddDetail( ({ "zweig" }),
    "Der eine Zweig hat so viele Blaetter, dass Du fast den kleinen "
	"Papierdrachen uebersehen haettest, der sich darin verfangen hat.");
  AddDetail( ({ "drache","drachen","papierdrache", "papierdrachen" }),
    "Ein kleiner bunter Papierdrache haengt in dem Zweig. Ob er herunter "
	"faellt, wenn man den Baum schuettelt?");
  if(!holzda) tell_room(TO,"Der Wind reisst etwas Holz aus dem Baum.\n");
  holzda=1;
  }
void create() 
{
  ::create();
  holzda=1;
  SetProp( P_INT_SHORT, "Auf einer Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Klippe. Um Dich herum siehst Du fast nur "
	"moosbewachsene Steine. Im Westen geht es steilabwaerts, im Suedosten "
	"siehst Du eine weite Duenenlandschaft. Ein verkrueppelter Baum steht "
    "neben Dir. Am strahlenden Himmel lacht die Sonne auf Dich herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer Klippe.");

  AddDetail( ({ "steine" }),
    "Auf den Steinen waechst Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos ist mal sehr dicht, mal spaerlich.");

  AddDetail( ({ "westen" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");

  AddDetail( ({ "suedosten" }),
    "Suedlich von Dir beginnen die Duenen.");
  AddDetail( ({ "duenen", "duenenlandschaft" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "boden" }),
    "Teilweise besteht er aus Sand, teilweise aus Fels. Ein paar trockene "
	"Aeste liegen herum.");

  AddDetail( ({ "aeste", "holz" }),
    "Falls Du mal trockenes Holz brauchst, koenntest Du hier welches "
	"aufklauben.");


  AddDetail( ({ "sand", "steinchen" }),
    "Sand besteht aus winzigkleinen Steinchen.");
  AddDetail( ({ "woelkchen" }),
    "Es ist keines zu sehen.");

  AddDetail( ({ "baum" }),
    "Ein verkrueppelter Baum steht hier und staemmt sich tapfer gegen den "
	"Wind, der schon so manchem seiner vertrockneten Aeste abgebrochen hat.");

  AddDetail( ({ "aeste" }),
    "Viele der Aeste sind bereits abgebrochen, die, die noch da sind, "
	"sind vertrocknet und nur an wenigen Zweigen wachsen noch ein paar "
	"gruene Blaetter.");

  AddDetail( ({ "blaetter" }),
    "Auch die meisten Blaetter sind vertrocknet. Nur sehr wenige sind noch "
	"gruen und sehen einigermassen gesund aus.");

  AddDetail( ({ "zweige" }),
    "Die Zweige sind fast alle vertrocknet. Nur ein Zweig scheint gesund "
	"und voller Leben zu sein.");

  AddDetail( ({ "zweig" }),
    "Der eine Zweig hat so viele Blaetter, dass Du fast den kleinen "
	"Papierdrachen uebersehen haettest, der sich darin verfangen hat.");
  AddDetail( ({ "drache","drachen","papierdrache", "papierdrachen" }),
    "Ein kleiner bunter Papierdrache haengt in dem Zweig. Ob er herunter "
	"faellt, wenn man den Baum schuettelt?");
  AddDetail( ({ "stamm" }),
    "Der Stamm des Baumes ist grau.");
  AddDetail( ({ "leben" }),
    "Gesund und voller Leben regt sich der Zweig zum Himmel.");

	
	
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhythmus" }),
    "Hmmmm, beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddRoomMessage( 
    ({""}),30,"func");

  

  AddExit( "norden", PIR_ROOM + "pirateninsel_3a" );
  AddExit( "suedosten", PIR_ROOM + "pirateninsel_5b" );
  AddCmd(({"schuettel","schuettle","schuettele"}),"baumschuetteln");
  AddCmd(({"klaube","klaub","sammel","sammele"}),"holzklauben");

}


int holzklauben(string str)
{
  notify_fail("Was moechtest Du aufklauben?\n");
  if (str!="holz"&&str!="holz auf"&&str!="trockenes holz"&&
      str!="trockenes holz auf"&&str!="aeste"&&str!="aeste auf") return 0;
  if(!holzda)
  {
  write("Das Holz, das noch da liegt ist voellig unbrauchbar.\n");
  return 1;
  }  
  write("Du bueckst Dich und sammelst etwas von dem trockenen Holz auf.\n");
  say(TPN+" bueckt sich und sammelt etwas von dem trockenen Holz auf.\n",TP);
  CLONE(PIR_OBJ +"trockenesholz", TP);
  holzda=0;
  return 1;
  }
int baumschuetteln(string str)
{
  notify_fail("Was moechtest Du schuetteln?\n");
  if(str!="baum") return 0;
  write("Du greifst mit beiden Haenden an den Stamm und schuettelst den "+
        "Baum.\n");
  say(TPN+" greift mit beiden Haenden an den Stamm und schuettelt den "+
        "Baum.\n");
  if(!GetDetail("papierdrache"))
  { 
     write("Nichts passiert.\n");
	 say("Nichts passiert.\n");
	 return 1;
	 }
  AddDetail( ({ "zweig" }),
    "An einem Zweig sind besonders viele Blaetter.");
   
  RemoveDetail( ({ "drache","drachen","papierdrache", "papierdrachen" }));
     write("Ein kleiner Papierdrache faellt aus dem Baum.\n");
	 say("Ein kleiner Papierdrache faellt aus dem Baum.\n");  
	 CLONE(PIR_OBJ +"papierdrache", TO);
	 return 1;
	 }