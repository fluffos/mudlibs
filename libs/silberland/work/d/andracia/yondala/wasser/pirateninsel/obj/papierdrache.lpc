// spaeter kann man ihn dann evtl wirklich stiegen lassen.
// Idee: Ein folgender PIR_NPC, nicht angreifbar, den man fangen und damit 
// klauen kann ->dann wieder Item.

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Papierdrache");
  SetProp(P_LONG,
    "Du siehst einen kleinen, bunten Papierdrachen, der ein lustiges "
	"Gesicht und zwei niedliche Schleifchen hat. Leider ist die "
	"Mittelstange gebrochen und die Schnur ist abgerissen, sonst koennte "
	"man ihn wohl steigen lassen." );
  SetProp(P_NAME, "Papierdrache");

  SetProp(P_GENDER, MALE);
  AddId(({"drache","papierdrache", "drachen","papierdrachen"}));

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 50);

  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 0);

  AddDetail( ({ "gesicht" }),
    "\n"
    "         /\\             \n"
	"        /  \\            \n"
	"       /O  O\\           \n"
	"    >>/  °   \\<<        \n"
	"      \\  V   /          \n"
	"       \\    /    _      \n"
	"        \\  /    /        \n"
	"         \\/  >><<       \n"
	"          \\__/          \n");
 
 AddDetail( ({ "schleifchen" }),
    "Rechts und links des Gesichts siehst Du zwei kleine Schleifchen.");
 AddDetail( ({ "mittelstange","stange" }),
    "Die Mittelstange ist leider gebrochen.");
 AddDetail( ({ "schnur" }),
    "Nur ein kleines Restchen Schnur haengt noch an dem Drachen.");
AddCmd(({"lasse","lass"}),"steigenlassen");
AddCmd(({"repariere","reparier"}),"drache_reparieren");
}

int drache_reparieren(string str)
{
  notify_fail("Was moechtest Du reparieren?\n");
  if(str!="drache"&&str!="drachen"&&str!="papierdrache"&&str!="papierdrachen") return 0;
  write("Du knotest die Schnur wieder fest und mit ein bisschen Spucke "+
        "verklebst Du die Mittelstange. Das wird schon halten....\n");
  say(TPN+" repariert einen Papierdrachen notduerftig.\n",TP);
  CLONE(PIR_OBJ +"papierdrache_heil", TP);
  remove();
  return 1;
  }
  
int steigenlassen(string str)
{
  notify_fail("Was willst Du steigen lassen?\n");
  if(str!="drachen steigen"&&str!="papierdrachen steigen")return 0;
  write("Du kannst den Drachen nicht steigen lassen, er ist kaputt.\n");
  return 1;
  }