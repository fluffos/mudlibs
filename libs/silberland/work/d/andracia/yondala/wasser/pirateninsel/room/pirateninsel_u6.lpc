#include "../def.h"

inherit "std/room";

#include <properties.h>
int da = 1;

void reset()
{
da=1;
	::reset();
	}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Vulkan" );
  SetProp( P_INT_LONG,  "Du befindest Dich am tiefsten Punkt des Vulkans. "
  "Um Dich herum ist alles schwarz. Ausserdem ist es ziemlich warm." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 46, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "vulkan", "vulkans" }),
    "Du befindest Dich in einem engen, dunklen Vulkan.");
  AddDetail( ({ "steine", "steinen" }),
    "Hier gibt es nichts ausser hartem Gestein.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist hart, kalt und schwarz.");
 AddDetail( ({ "boden" }),
    "Der Boden besteht aus hartem, dunklem Gestein. Du siehst eine Unebenheit.");
  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du von hier nicht erkennen.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind sehr dicht beieinander und bestehen aus dunklem Gestein.");
  AddDetail( ({ "unebenheit" }),
    "Bei genauerem hinsehen findest Du, dass es schwarze Blumen sein koennten.");
  AddDetail( ({ "blumen" }),
    "Tatsaechlich sind es gleich mehrere der seltenen Vulkanblumen.");
  AddDetail( ({ "vulkanblumen", "vulkanblume" }),
    "Vulkanblumen sind sehr wertvoll, man sagt ihnen magische Faehigkeiten nach.");
  AddDetail( ({ "faehigkeiten", "faehigkeit" }),
    "Du koenntest eine Vulkanblume abbrechen um ihre Faehigkeiten herauszufinden.");
  AddDetail( ({ "punkt" }),
    "Du bist ganz unten angekommen.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus dunklem Gestein.");
  AddDetail( ({ "" }),
    ".");
  AddSound( DEFAULT_SOUND,
    "Stille.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Schwefel.");

  AddSmell( ({ "schwefel","geruch" }),
    "Schwefel riecht nicht sehr angenehm, ausserdem laesst dieser Geruch "
	"nichts Gutes verheissen.");
  AddSmell( ({ "gutes" }),
    "Deswegen solltest Du hier unten nicht allzulange verweilen. Sonst "
	"vergiftest Du Dich noch...");

  AddRoomMessage( 
    ({""}),30,"func");

  
 AddCmd( ({ "brich", "brech", "breche" }), "brechenCmd" );

 AddExit( "oben", PIR_ROOM + "pirateninsel_u5" );

 

}
brechenCmd(string str )
{
  notify_fail( "Was moechtest Du abbrechen?\n" );
  if( str == "vulkanblume ab" )
  {  
  	if (da > 0)
  	{
    write("Du brichst die Vulkanblume ab. \nDurch das dadurch entstandene Loch fliesst "
    "kochende Lava in den Raum.\n");
    say( TPN+" bricht eine Vulkanblume ab.\nDurch das dadurch entstandene Loch fliesst "
    "kochende Lava in den Raum.\n", TP);
    CLONE(PIR_OBJ +"vulkanblume", TP);
		da=0;	
  SetProp( P_INT_LONG,  "Du befindest Dich am untersten Grund des Vulkans. "
  "Um Dich herum ist alles schwarz. Ausserdem ist es sehr heiss. Gluehende Lava fliesst "
  "um Deine Fuesse." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 100, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "fuesse" }),
    "Pass lieber auf, dass Du sie Dir nicht verbrennst.");
  AddDetail( ({ "" }),
    ".");
		
		
		call_out("lava",10);
		call_other(PIR_ROOM + "pirateninsel_u5", "startlava");
		call_out("weglava",300);		
		  	    CLONE(PIR_OBJ +"lava", TO);
				return 1;
	}
else
	{    write("Leider bist Du wohl nicht stark genug um die Blume abzubrechen...\n");}
	    return 1;
  }
  return 0;
}

	
void weglava()
{
  SetProp( P_INT_LONG,  "Du befindest Dich am tiefsten Punkt des Vulkans. "
  "Um Dich herum ist alles schwarz. Ausserdem ist es ziemlich warm." );
	tell_room(TO,"Die Lava zieht sich zurueck.\n");
	SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 43, ENV_TERRAIN: TT_CAVE]) );	    
	present("lava",TO)->remove();
	}