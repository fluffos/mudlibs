// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 30.04.2010
// Uebergang von Duenen in Felsen und Weg zum Steg

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen Klippen und Duenen" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_DESERT]) );

 SetProp( P_INT_LONG,
    "Du befindest Dich genau auf dem Uebergang von Klippen zu den Duenen. Der Boden unter "
    "Deinen Fuessen ist sandig, doch immer wieder liegen grosse Steine dazwischen. Du "
    "solltest aufpassen, dass Du nicht umknickst. Das Laufen hier ist recht muehsam, da "
    "Du immer wieder leicht einsinkst. Unter Dir befindet sich ein Steg." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen", "duene" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden. Sie liegen suedlich von Dir.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft salzig. Sehen kannst Du das Meer von "+
    "hier aus aber nur, wenn Du Dich weit ueber die Klippe lehnst.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
/*  AddDetail( ({ "grasbueschel" }),
    "Das Gras waechst hier nur sehr spaerlich.");
  AddDetail( ({ "gras" }),
    "Nur sehr wenige Halme halten sich hier.");
  AddDetail( ({ "halme" }),
    "Die meisten Halme sind graeulich und trocken.");
*/
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden", "fuesse","fuessen" }),
    "Der Boden besteht fast nur aus Sand. Nur hin und wieder liegen ein paar Steine dazwischen.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "klippen", "felsgestein","gestein", "klippe" }),
    "Die Klippen bestehen aus hartem teilweise moosbewachsenem Fels. So richtig beginnen sie erst noerdlich von Dir.");
  AddDetail( ({ "fels" }),
    "Harter Stein.");
  AddDetail( ({ "moos" }),
    "Das Moos ist dunkelgruen, es scheint ihm hier gut zu gehen.");
  AddDetail( ({ "stein","steine" }),
    "Die Steine liegen vereinzelt im Sand. Pass auf, dass Du nicht umknickst, wenn Du auf einen trittst.");
  AddDetail( ({ "steg" }),
    "Der Steg ist alt und klapprig, dennoch landen ab und zu Schiffe hier.");
  AddDetail( ({ "schiff","schiffe" }),
    "Bist Du nicht auch irgendwann mal mit einem Schiff hier gelandet?");
  AddDetail( ({ "uebergang" }),
    "Hier gehen die Duenen in Felsgestein ueber.");

  AddDetail( ({ "sand", "steinchen" }),
    "Sand besteht aus winzigkleinen Steinchen.");

  AddReadDetail( ({ "klippe" }),
    "Du stehst fast schon auf einer Klippe.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres, das hin und wieder von dem Schrei einer Moewe unterbrochen wird.");

  AddSound( ({ "rauschen", "meer" }),
    "Das Rauschen des Meeres ist recht laut hier.");
  AddSound( ({ "moewe","schrei" }),
    "Vermutlich ist eine in der Naehe.");
  AddSound( ({ "naehe" }),
    "Zumindest ist sie nah genug um sie zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht salzig.");
  AddSmell( ({ "salz" }),
    "Du atmest tief ein und spuerst, wie die salzige Luft Dich belebt.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht salzig.");

 
 AddExit( "unten", PIR_ROOM + "pirateninsel_steg" );
 AddExit( "nordosten", PIR_ROOM + "pirateninsel_4g" );
 AddExit( "sueden", PIR_ROOM + "pirateninsel_6f" );
 
 AddCmd( ({ "lehne", "lehn" }), "lehnen" );
 AddCmd( ({ "trete", "tret","tritt" }), "treten" );

}
int treten(string str)
{
  int bewegung;
  notify_fail("Worauf moechtest Du treten?\n");
  if(str!="auf stein") return 0;
  say(TPN+" tritt auf einen Stein.\n",TP);
  
  if(random(5)==1)
  { 
    write("Du trittst auf einen Stein und verstauchst Dir den Fuss.\n"+
	"Autsch, davon muss Du Dich erstmal erholen.\n");
	bewegung=TP->QueryProp(P_MAX_MV);
	bewegung=bewegung/2;
	TP->do_exhaust(bewegung);
	return 1;
	}
  write ("Du trittst auf einen Stein.\n");
  return 1;
  }
int lehnen(string str)
  {
  	notify_fail( "Worueber moechstest Du Dich lehnen?\n" );
  if (str == "ueber klippe"|| str == "ueber klippen")
  	{
		write ("Du lehnst Dich vorsichtig ueber die Klippe. Unter Dir "+
		       "erblickst Du das Meer.\n"+
		"Schnell ziehst Du Dich zurueck, um nicht herunter zu fallen.\n");
		say(TPN+" lehnt sich vorsichtig ueber die Klippe und betrachtet "+
		        "das Meer.\n",TP);
		return 1;
	}
}