//An dieser Medaille erkennen ein paar Piraten, wer Freund und wer Feind ist. Sonst kann sie eigentlich nichts.

//#include "../def.h"
#include <moredef.h>
inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Medaille");
  SetProp(P_LONG,
    "Du siehst eine goldigschimmernde Medaille, auf beiden Seiten wurde ein grinsender "
    "Totenkopf eingepraegt. Man kann sie um den Hals tragen." );
  SetProp(P_INFO, BS("An dieser Medaille erkannten sich einst die Piraten, die auf Drakos Seite stehen.") );
  SetProp(P_NAME, "Medaille");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"medaille", "schutzmedaille", "/nschutzmedaillepiraten"}) );
  AddDetail( ({ "totenkopf" }),
    "Ein grinsender Totenkopf befindet sich auf beiden Seiten der Medaille.");  
  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 5 );
  SetProp(P_MATERIAL, ([ MAT_GOLD]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 100);
}
