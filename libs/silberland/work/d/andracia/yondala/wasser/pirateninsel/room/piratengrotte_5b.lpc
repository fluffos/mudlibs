#include "../def.h"

inherit "std/room";

#include <properties.h>
void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen, feuchten Raum" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem kleinen Raum. Die Luft ist sehr warm und feucht, das "
    "Atmen faellt Dir schwer. Die Waende hier sind russig-feucht. In der Mitte des "
    "Raumes steht ein grosses Fass." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
  AddItem(PIR_NPC + "sklavin_hildgunde",REFRESH_DESTRUCT);

  AddDetail( ({ "raum", "raumes" }),
    "Du befindest Dich in einem ziemlich warmen Raum.");    
  AddDetail( ({ "luft" }),
    "Die Luft hier ist sehr dick, sie ist voller Rauch und Wasserdampf.");    
  AddDetail( ({ "rauch" }),
    "Der Rauch kommt von den Fackeln an der Wand und dem Feuer unter dem Fass.");    
  AddDetail( ({ "fackeln", "fackel" }),
    "Die Fackeln sind mit eisernen Halterungen an der Wand befestigt.");    
  AddDetail( ({ "halterungen" }),
    "Die Halterungen sehen sehr stabil aus. Es wird Dir sicher nicht "
    "gelingen eine Fackel daraus heraus zu brechen.");    
  AddDetail( ({ "wand", "waende", "waenden" }),
    "Die Waende sind einerseits russig, andererseits feucht durch den "
	"Wasserdampf was insgesammt eine schwarze, schleimige Matsche gibt "
	"die ueberall an den Waenden klebt. In einer Ecke steht ein kleiner "
	"Schrank, ausserdem befinden sich noch einige Fackeln in Halterungen "
	"an den Waenden.");    
  AddDetail( ({ "wasserdampf" }),
    "Der Wasserdampf entsteigt dem Fass in der Mitte des Raumes.");    
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes befindet sich ein grosses Fass.");    
  AddDetail( ({ "atmen" }),
    "Das Atmen faellt Dir hier schwer.");    
  AddDetail( ({ "fass" }),
    "Das Fass ist unterhalb mit Eisen beschlagen. In ihm blubbert eine dunkle "
    "Fluessigkeit vor sich hin. Unter dem Fass brennt ein kleines Feuer.");    
  AddDetail( ({ "fluessigkeit" }),
    "Du kannst nicht sagen, was es ist. Riecht jedenfalls seltsam.");    
  AddDetail( ({ "eisen" }),
    "Das Fass ist wohl mit Eisen beschlagen, damit es dem Feuer standhalten kann.");    
  AddDetail( ({ "feuer" }),
    "Das Feuer unter dem Fass erhitzt die Fluessigkeit.");    
  AddDetail( ({ "matsche", "matsch" }),
    "Diese Matsche ist wirklich nicht schoen.");    
  AddDetail( ({ "boden" }),
    "Der Boden in diesem Raum ist sehr schmutzig und voller Matsche, deren Ursprung Du "
    "Dir erschliessen kannst. Es sind ueberall Spuren zu sehen.");    
  AddDetail( ({ "ursprung", "gemisch" }),
    "Die Matsche scheint ein Gemisch aus Russ und Fluessigkeit zu sein.");    
  AddDetail( ({ "spuren" }),
    "Die Spuren ziehen sich durch den ganzen Raum. Eine Spur faellt Dir besonders auf.");    
  AddDetail( ({ "spur" }),
    "Um genau zu sein, sind es zwei Spuren nebeneinander, die sich durch den Raum ziehen. "
    "Sieht so aus, als wuerde jemand mit einer Kette zwischen den Fuessen staendigt durch "
    "die Matsche schlurfen.");    
  AddDetail( ({ "kette", "fuesse","fuessen" }),
    "Nur Sklaven laufen mit Ketten zwischen den Fuessen herum.");    
  AddDetail( ({ "sklaven", "sklavin", "sklave" }),
    "Piraten halten sich oft Sklaven.");    
  AddDetail( ({ "russ" }),
    "Der Russ kommt von dem Feuer unter dem Fass und den Fackeln an der Wand.");    
  AddDetail( ({ "decke" }),
    "Die Decke ist russig und feucht. Ab und zu tropft ein bisschen Matsch auf Dich herunter.");    
  AddDetail( ({ "augen" }),
    "Deine Augen brennen von dem Rauch.");    
  AddDetail( ({ "schrank" }),
    "Ein kleiner, sehr dreckiger Schrank steht in der Ecke.");    
  AddDetail( ({ "piraten" }),
    "Die Piraten leben hier unten in der Grotte.");    
  AddDetail( ({ "pirat" }),
    "Ist wohl gerade keiner da.");    
  AddDetail( ({ "grotte" }),
    "Du bist in einer Grotte, die teilweise natuerlich entstanden, "
	"teilweise erschaffen wurde.");    
  AddDetail( ({ "geschirr" }),
    "Das Geschirr steht im Schrank.");    
   AddDetail( ({ "lumpen" }),
    "Die Lumpen sind im Schrank.");    
  AddDetail( ({ "ecke" }),
    "In der Ecke steht ein kleiner Schrank.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur ein Blubbern aus dem Fass und das Knistern des Feuers.");

  AddSound( ({ "blubbern" }),
    "Blubblub.");
  AddSound( ({ "knistern", "feuer" }),
    "Wenn es hier nicht so ungemuetlich waere, wuerde es fast heimelich klingen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Rauch, und irgendetwas undefinierbarem.");

  AddSmell( ({ "rauch" }),
    "Der Rauch erschwert Dir das Atmen sehr.");
  AddSmell( ({ "undefinierbares" }),
    "Koennte eine Mischung aus Kohl und Seife sein.");
  AddSmell( ({ "kohl","seife", "fluessigkeit" }),
    "Du bist Dir nicht sicher wonach es riecht.");
  AddSmell( ({ "" }),
    "");
  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({"Deine Augen brennen ein bisschen.\n",
    	"Du musst husten.\n",
    	"Etwas tropft auf Dich herunter.\n"}),30,"func");



  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "brich", "brech", "breche" }), "brechenCmd" );


  AddExit( "osten", PIR_ROOM + "piratengrotte_5c" ); 

}

brechenCmd(string str)
  {
  	notify_fail( "Was moechtest Du woraus brechen?\n" );
  if (str == "fackel aus halterung"|| str == "fackel aus halterung heraus"||str=="fackel heraus"){
		write ("Du versuchst eine Fackel aus ihrer Verankerung zu brechen, bist aber nicht stark genug.\n");
		say(TPN +" versucht eine Fackel aus ihrer Halterung zu brechen, scheitert aber.\n",TP);
		return 1;
	}

}

int oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str=="schrank"||str=="schranktuer")
  {
    write("Du oeffnest den Schrank. In ihm liegt etwas schmutziges "
	"Geschirr und ein paar Lumpen. Angeekelt schliesst Du den Schrank "
	"wieder.\n");
    say(TPN+" oeffnet kurz den Schrank in der Ecke und schaut hinein.\n",TP);		  
    return 1;
   }

return 0;
}	