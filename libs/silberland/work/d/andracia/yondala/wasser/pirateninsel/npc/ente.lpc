// Diese Ente wird mit dem Grashalm gerufen den man auf der Pirateninsel pfluecken kann.
// verfolgt den Spieler und verschwindet nach 5 minuten

inherit "std/mnpc";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void init()
{
   ::init();
}
object liebling;
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Ente");
  SetProp(P_LONG,
    "Du siehst eine kleine dicke Ente, die etwas zu suchen scheint.");
  SetProp(P_NAME, "Ente");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ente"}));

  SetProp(P_ARTICLE, 1);
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihrem Schnabel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "watschelt herein");
  SetProp(P_MSGOUT, "watschelt");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert davon");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Eine Ente");
 	
  AddInfo(DEFAULT_INFO, "quakt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Ente hat keine Arme und kann daher nichts tragen.\n" }) );


//  SetChats(3, ({
//    ".\n"}) );

  SUID;
  CLONEME(PIR_OBJ "entenfeder" );//noch machen, kann auch bei der Sammelquest genutzt werden
  call_out("verschwinde", 300);
}

void verfolger(object spieler)//wird vom Grashalm aufgerufen. Ente verfolgt denjenigen, der blaest
{
	spieler->AddPursuer(TO);
	  SetProp(P_LONG,
    "du siehst eine kleine dicke Ente, die "+spieler->name()+" zu suchen scheint.");

	   SetChats(2, ({
    "Die Ente quakt laut.\n",
    "Die Ente zwickt Dich ins Knie.\n"}) );
    call_out("liebe",5);
    liebling=spieler;
	}	

void liebe()
{
	if (present(liebling, environment(TO)))
		tell_object(liebling, "Die Ente schaut Dich verliebt an.\n");
		tell_room(environment(TO),"Die Ente schaut "+liebling->name()+" verliebt an.\n",(({liebling})));
	    call_out("liebe",30);
	}
void verschwinde()
{
  if(InFight()) call_out("verschwinde",10);
  else
  {
    tell_room(environment(TO), "Die Ente flattert enttaeuscht davon, nur eine einzelne Feder bleibt zurueck.\n");
	remove();
	}
}