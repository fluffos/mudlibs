#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein altes Paar Lederschuhe");
  SetProp(P_LONG,
    "Du siehst ein altes, durchgelaufenes Paar Lederschuhe." );
  SetProp(P_INFO, BS(".") );
  SetProp(P_NAME, "Paar Lederschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schuhe", "lederschuhe"}) );
 // SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_LEATHER ]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 50);


}

