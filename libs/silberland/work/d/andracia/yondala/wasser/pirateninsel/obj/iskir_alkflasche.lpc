//13.05.2010: Beim trinken wird nun eine leere Flasche geclont

//Flasche fuer den Laden auf der Pirateninsel
//clont sich gross, klein, mittel und in verschiedenen Sorten
// Yondala@Andracia 7.3.2007



// Bearbeitet fuers SL als Balanceanpassung fuer die Zechpreller
// Yondala@Silberland 11.04.2010



/*************************************************************************
In Abstimmung mit Gwenshara:

                    Kosten/Heilung/Alkohol
        Wein         Fusel         Rum           Schnaps        Grog
klein   500/10/5     600/15/15     700/15/10     800/20/12      900/25/7
mittel  750/15/7     900/20/15     1050/20/12    1200/25/15     1350/30/10
gross   1000/20/9    1200/25/20    1400/25/15    1600/30/20     1800/35/13

Gewicht/Saettigung
 500/5
1000/7
1500/9

***************************************************************************/
#include "../def.h"

inherit "/std/food";
#include <properties.h>
#include <food.h>


int alk = 1;
//string fuelle = "volle";
int sorte=random(5);
int groesse=random(3);
int voll;//wie sitt macht das Getraenk?
int alkgehalt;//wieviel Alk ist drin?
int heilung; //wieviel heilt die Flasche?

BeimEssen()
{
   if(QueryProp(P_NAME)== "Fuselflasche")
   {
      if(random(5)==1) 
	  {  
	     TP->SetProp(P_BLIND, 50+random(50));
         write("Uah, irgendwas stimmte mit dem Fusel nicht. Du kannst "+
		 "ploetzlich nichts mehr sehen.\n");
		 }
	}
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create( ({"trink","trinke"}) );





//Bestimmt die Sorte Wein, Fusel, Rum, Schnaps, Grog mit den Grundwerten 
//von Gewicht und Heilung
switch (sorte)
{
	case 0:
		{
			//SetProp(P_SHORT, "Eine volle Weinflasche");
		  SetProp(P_LONG,
		   "Du siehst eine dunkle, bauchige Flasche in der wuerziger, "+
		   "dunkler Wein schwappt. Er riecht eigentlich nicht schlecht." );
		    SetProp(P_NAME, "Weinflasche");
			AddId(({"weinflasche", "wein"}));
			SetProp(P_VALUE, 500);  			
			alkgehalt = 5;
			heilung=10;
			break;
		}		
	case 1:
		{
			  //SetProp(P_SHORT, "Eine volle Flasche mit Fusel");
  			SetProp(P_LONG,
    		  "Du siehst eine volle Flasche mit irgendeinem Fusel drin." );
  		    SetProp(P_NAME, "Fuselflasche");
  			AddId(({"fuselflasche", "fusel"}));
  			SetProp(P_VALUE, 600);
  			//fusel=1;
  			alkgehalt = 15;
  			heilung=15;
  			break;
				
		}			
	case 2:
		{
			  //SetProp(P_SHORT, "Eine volle Rumflasche");
  			SetProp(P_LONG,
    		   "Du siehst eine alte, gefuellte Rumflasche. Der Rum wurde "+
			   "wohl irgendwo schwarz gebrannt. Nur wer mutig ist, "+
			   "sollte daraus trinken." );
  		    SetProp(P_NAME, "Rumflasche");
  			AddId(({"rumflasche", "rum"}));
  			alkgehalt = 10;
			SetProp(P_VALUE, 700);    			
			heilung=15;
			break;
		}		
	case 3:
		{
			  //SetProp(P_SHORT, "Eine volle Schnapsflasche");
  			SetProp(P_LONG,
    			"Du siehst eine gefuellte Schnapsflasche. Der Schnaps "+
				"wurde wohl irgendwo schwarz gebrannt. Nur wer mutig "+
				"ist, sollte daraus trinken." );
  		    SetProp(P_NAME, "Schnapsflasche");
  			AddId(({"schnapsflasche", "schnaps"}));
			SetProp(P_VALUE, 800);				
  			alkgehalt = 12;
			heilung=20;
			break;
		}				
	case 4:
		{
			  //SetProp(P_SHORT, "Eine volle Grogflasche");
  			SetProp(P_LONG,
    			"Du siehst eine alte, gefuellte Grogflasche. Warm ist er "+
				"bestimmt besser, aber Du bist ja nicht waehlerisch." );
  		    SetProp(P_NAME, "Grogflasche");
  			AddId(({"grogflasche", "grog"}));
  			SetProp(P_VALUE, 900);
  			alkgehalt = 7;
			heilung=25;
			break;
		}				
			
 
	}

//bestimmt ganz allein das Gewicht und die Trinksaettigung
//erhoeht Heilung bei mittel um 5, bei gross um 10
//erhoeht Preis bei mittel um 150%, bei gross um 200%
//Alkgehalt wird individuell gesetzt
switch(groesse) 
{
	case 0: 
		{  
			AddAdjective( ({ "gross" }) );
	        SetProp(P_NAME_ADJ, "gross");
			SetProp(P_WEIGHT, 1500);
			voll=9;
			heilung+=10;
			SetProp(P_VALUE, QueryProp(P_VALUE)*2);  			
 		  break;
 		  if(QueryProp(P_NAME)== "Weinflasche") alkgehalt+=4;
		  if(QueryProp(P_NAME)== "Fuselflasche") alkgehalt+=5;
		  if(QueryProp(P_NAME)== "Rumflasche") alkgehalt+=5;
		  if(QueryProp(P_NAME)== "Schnapsflasche") alkgehalt+=8;
		  if(QueryProp(P_NAME)== "Grogflasche") alkgehalt+=6;
		}
	case 1:   
		{
			AddAdjective( ({ "mittler" }) );
	    SetProp(P_NAME_ADJ, "mittler");
			voll=7;
      SetProp(P_WEIGHT, 10000);
			heilung+=5;				
			SetProp(P_VALUE, QueryProp(P_VALUE)*1,5);  			
		  if(QueryProp(P_NAME)== "Weinflasche") alkgehalt+=2;
		  if(QueryProp(P_NAME)== "Rumflasche") alkgehalt+=2;
		  if(QueryProp(P_NAME)== "Schnapsflasche") alkgehalt+=3;
		  if(QueryProp(P_NAME)== "Grogflasche") alkgehalt+=3;
			break;
			}
	case 2:
		{
			AddAdjective( ({ "klein" }) );
			SetProp(P_NAME_ADJ, "klein");
			voll=5;
			SetProp(P_WEIGHT, 500);
	    SetProp(P_NAME_ADJ, "klein");
		  break;
			}	
}

  SetProp(P_GENDER, FEMALE);
  AddId(({"flasche"}));
  SetProp (P_FOOD_INFO, ([
      F_HEAL     : ({heilung,heilung}),              
      F_DRINK:voll, F_ALCOHOL:alkgehalt,  
      F_MSG      : "Du trinkst "+name(WEN)+" ganz aus. Dir wird ein "+
	               "bisschen schummrig.",
      F_MSG_ROOM : "trinkt "+name(WEN)+" aus.",
      F_VERB     : "trinken" ]) );
  
  
  SetProp(P_SHORT, name());
 
  SetProp( P_MATERIAL, ([ MAT_GLASS : 20, MAT_ALCOHOL : 80 ]) );


}



second_life(object pl)
{
  object ob;
  ob=clone_object(PIR_OBJ +"iskir_alkflasche_leer");
  ob->SetProp(P_SHORT, "Eine leere "+QueryProp(P_NAME));
  ob->SetProp(P_LONG, "Du siehst eine leere, alte "+QueryProp(P_NAME)+
                      " mit der man wohl nichts mehr machen kann, ausser "+
					  "sie umweltgerecht zu entsorgen." );
  ob->SetProp(P_NAME, QueryProp(P_NAME));
  ob->AddId(lower_case(QueryProp(P_NAME)));
  ob->move(pl);
  return 0;
  
}