//Hier kriegt man den Hinweis, wie man an die armwachssalbe kommt. 
//Ausserdem gibt er einen Zaubertrank

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
inherit PIR_NPC + "pirat_std.lpc";

void init() {
    SetProp(P_HP,5);
}

void create() 
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein armseliger Pirat");
  SetProp(P_LONG,
    "Du siehst einen armseligen Piraten vor Dir. Seine Kleidung ist "
	"zerfetzt, er blutet aus mehreren Wunden und statt seines rechten "
	"Armes hat er nur einen blutigen Stummel.");
  SetProp(P_NAME, "Pirat");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_HP,5);
  AddId(({"pirat", "PIRATARMAB", "armer pirat", "armseliger pirat","armseliger", "armer"}));
  AddAdjective("armselig");
  //  SetProp(P_ARTICLE, 0);
//  set_living_name("");
SetProp (P_MNPC_DEFAULTROOM, PIR_ROOM+"pirateninsel_8c");
SetProp (P_MNPC_AREA, ({PIR_ROOM}));
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);
SetProp (P_MNPC_WAIT, ({5, 10, 10}));

  SetProp(P_MSGIN, "schleppt sich heran");
  SetProp(P_MSGOUT, "schleppt sich");

  create_default_npc(1); 
  SetProp(P_HANDS, ({"mit seiner Hand",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP,20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK,1);
  SetProp(P_ALIGN, 0);
  SetProp(P_KILL_NAME, "Ein armseliger Pirat");
  SetChats(20, ({"Der armselige Pirat jammert.\n",
                "Der armselige Pirat stoehnt.\n",
				"Der armselige Pirat verliert viel Blut.\n",
				"Der armselige Pirat fleht: Bitte, helft mir!\n",
				"Der armselige Pirat aechzt: Ich kann nicht mehr.\n",
				"Der armselige Pirat weint leise.\n",})); 

  AddInfo(DEFAULT_INFO, "fleht: So hoert doch auch zu fragen und helft mir!\n");

   AddInfo( ({ "hilfe" }),
    "Bitte, ich brauche dringend Hilfe! Roger Schwarzbart hat mir meinen "
	"Arm abgeschlagen, als ich es wagte einem seiner Befehle nicht nach "
	"zu kommen. Bitte, bringt mir ein Heilmittel!",
    "aechzt: ");  
   AddInfo( ({ "arm" }),
    "Mein Arm ist ab, ich brauche dringend ein Heilmittel, BITTE!",
    "fleht: ");  
   AddInfo( ({ "heilmittel" }),
    "Ich weiss, dass es eins gibt, es muss einfach eines geben. Man "
	"faengt Geruechte auf und ich bete, dass sie stimmen.",
    "stoehnt: ");  
   AddInfo( ({ "geruechte" }),
    "Die Geruechte besagen, es gaebe eine Salbe, die Gliedmassen nach "
	"wachsen laesst.",
    "fluestert: ");  
    AddInfo( ({ "salbe" }),
    "Ich weiss nicht, wo es die Salbe gibt. Auf dieser Insel sicher nicht. "
	"Vielleicht kann jemand auf dem Festland sie zusammen mischen?",
    "hofft: ");  
   AddInfo( ({ "festland" }),
    "Dort war ich lang nicht mehr, man sieht uns Piraten dort nicht gern.",
    "sagt: ");  
    AddInfo( ({ "piraten", "pirat" }),
    "Jaja, ich bin ein Pirat, bitte, helft mir doch, ich verblute!",
    "sagt: ");  
   AddInfo( ({ "" }),
    "",
    "sagt: ");  
    AddInfo( ({ "" }),
    "",
    "sagt: ");  
   AddInfo( ({ "" }),
    "",
    "sagt: ");  
   



   
}


void gerettet4()
{
  SetProp(P_MSGOUT, "laeuft von dannen");
  move("/room/npcasylraum", M_GO);
  remove();
  }

	   
string gerettet3()
{
  say("Der Pirat gibt "+TPN+" etwas.\n",TP);
  
  if (this_player()->FindPotion("Der Pirat drueckt Dir etwas in die Hand.\n"))   
    {
	   call_out("gerettet4",1);
	  return "Der Pirat nickt Dir zu.\n";  
	  }
                   
   else
      {
	  "/obj/gemmaster"->DistributeGem(1, 0, 3, TO);
	  call_out("gerettet4",1);
	  return "Der Pirat drueckt Dir etwas kleines in die Hand.\n";
	  }
 
  
  }
	   
void gerettet2()
{
  command("sag Habt Dank, "+TPN+", Ihr habt mich gerettet.");
  call_out("gerettet3",2);
  }
 void gerettet1()
{
  tell_room(environment(TO), "Auf wundersame Art und Weise waechst der Arm "+
                             "des Piraten nach.\n");
  call_out("gerettet2",2);
  } 
void gerettet()
{
  tell_room(environment(TO), "Der Pirat schmiert sich die Salbe auf seine Wunde.\n");
  call_out("gerettet1",2);
  }





void give_notify(object ob)
 { 
   if(ob->name()=="eine kleine Salbentube")
     {
	   tell_room(environment(TO), "Der Pirat faellt auf die Knie.\n");
	   call_out("gerettet",1);

		}


  else//wenn er die Quest schon hat oder das Objekt kein Holzbein ist.
   {
    command("sag Das hilft mir nicht. Ich brauche die Salbe!");
    ob->move(TP, M_GET);
    }
 }
