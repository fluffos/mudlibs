// Dies ist der versteckte Laden der Piratengilde

inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>



void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Hinterzimmer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Hinterzimmer des Hauptquartiers der Piraten. " 
    "Der Raum ist spaerlich beleuchtet und ausser einem Ladentisch und "
    "einem Regal mit allerhand Waffen gibt es keine weiteren "
    "Einrichtungsgegenstaende in dem Raum."
    ""
    ""
       );

SetStorageRoom(PIR_ROOM + "piratengrotte_lagergilde");

SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "jockel");
  SetProp(P_SHOPKEEPER_NAME, "Jockel");
  SetProp(P_SHOPKEEPER_GENDER, MALE);


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  
  AddItem(PIR_NPC + "messer_jockel",REFRESH_DESTRUCT);
  //AddItem("/gilden/piratenmeute/npc/messer_jockel",REFRESH_DESTRUCT);

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzdielen und ist wie alles andere in dieser "
    "Grotte ueber dem Wasser angelegt worden.");
  AddDetail( ({ "holzdielen" }),
    "Holzdielen bestehen aus Holz.");
  AddDetail( ({ "holz" }),
    "Ganz normales Holz.");
  AddDetail( ({ "wasser" }),
    "Du kannst Wasser durch die Ritzen der Holzdielen am Boden sehen.");
  AddDetail( ({ "ritzen", "furchen" }),
    "Die Holzdielen liegen dort schon lang, mittlerweile haben sie viele Ritzen und Furchen.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus Holz und sind verrusst, an einer Wand steckt eine Fackel.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus normalen Holz. Sie ist stark verrusst, "
    "denn hier unten scheint nie die Sonne und es muss immer kuenstliches "
    "Licht herrschen.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint hier unten nie.");
  AddDetail( ({ "licht" }),
    "Das Licht hier unten ruehrt von einer Fackel in der Wand.");
  AddDetail( ({ "fackel" }),
    "Die Fackel scheint fest an der Wand verankert. Sie spendet Licht in diesem Zimmer.");
  AddDetail( ({ "tisch","ladentisch" }),
    "Ueber diesen Tisch wechselte schon so manche Waffe ihren Besitzer.");
  AddDetail( ({ "waffe", "waffen" }),
    "Hier gibt es fuer Piraten die besten Waffen zu kaufen.");
  AddDetail( ({ "besitzer" }),
    "Derjenige, dem etwas gehoert, ist der Besitzer");
  AddDetail( ({ "regal" }),
    "In diesem Regal lagern Waffen aller Art.");
  AddDetail( ({ "art" }),
    "Diese und jene.");
  AddDetail( ({ "einrichtungsgegenstaende" }),
    "Es gibt keine, ausser einem Regal und einem Tisch. Der Raum ist eh sehr klein.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "hinterzimmer", "zimmer", "raum" }),
    "Dieses Zimmer ist hinter dem Hauptquartier der Piraten");
  AddDetail( ({ "hauptquartiers","hauptquartier" }),
    "Da bist Du sicherlich durchgekommen auf dem Weg hierrein.");
  AddDetail( ({ "weg" }),
    "Der Weg, den du zurueckgelegt hast.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht muffig.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");



//AddExit( "westen", PIR_ROOM +"piratengrotte_6f" ); 

AddExit( "westen", "/gilden/piratenmeute" ); 

}

