//
// Der Papagei plappert alles, was man sagt, nach. Beispiel fuer catch_tell.
//
//=========================================================================

#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Papagei");
  SetProp(P_LONG,
    "Ein Papagei, dessen praechtiges Gefieder in kraeftigen Farben leuchtet."
  );

  SetProp(P_NAME, "Papagei");
  SetProp(P_GENDER, MALE);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );
  AddId( ({ "papagei", "vogel" }) );

  AddDetail( ({ "gefieder" }),
    "Der Papagei hat ein leuchtend buntes Gefieder."
  );

  create_default_npc(4);

  SetProp( P_HANDS, ({ " mit seinem Schnabel", 100 , DT_PIERCE}) );
  SetProp( P_RACE, "Vogel" );

//-------------------------------------------------------------------------
// Man sollte auch eine Klasse angeben. Verfuegbare Klassen finder man
// unter /sys/class.h
// Der papagei ist ein Vogel/Tier *und* etwas fliegendes
//-------------------------------------------------------------------------

  AddClass( ({CL_ANIMAL, CL_FLYING}) );

  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 100 );
  SetProp(P_MAX_HANDS, 4 );

//  SetProp( P_DIE_MSG, " gibt endlich Ruhe.\n" );

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" ist an @WEM nicht interessiert.\n" }) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");

//-------------------------------------------------------------------------
// Der Papagei fliegt ueberall in, allerdings nur in OUTDOOR Raeume
//-------------------------------------------------------------------------

  SetProp(P_MNPC_AREA, ({PIR_ROOM}) );
  SetProp(P_MNPC_DEFAULTROOM, PIR_ROOM "wiese_050");
  SetProp(P_MNPC_WAIT, ({ 10, 35, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp( P_KILL_NAME, "Ein Papagei" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"kraechzt nur.\n"
     ,"guckt Dich kurz mit einem dummen Blick an.\n"
     }) );
}

//-------------------------------------------------------------------------
// Der Papagei soll alles nachplappern was ein Spieler sagt
//
// Dabei muss man aufpassen, das man den Papagei nicht das nachplappern
// laesst was er selbst sagt. Denn sonst gibt es eine nette Endlosschleife
//-------------------------------------------------------------------------

void catch_tell(string str)
{
  string who, what;
  object room;

//-------------------------------------------------------------------------
// Wenn der Papagei keine Umgebung hat oder sich im Kampf befindet, dann
// tun wir nichts
//-------------------------------------------------------------------------

  if(!(room=ENV(TO))) return;
  if(InFight())       return;

//-------------------------------------------------------------------------
// Fuer alles, was uns erreicht, schauen wir nach, ob es in das Muster
// "Spielername sagt: irgendwas", passt, und wiederholen das
//-------------------------------------------------------------------------

  if(sscanf(str,"%s sagt: %s", who, what)==2)
  {
//-------------------------------------------------------------------------
//  Achtung, what enthaelt noch ein \n, welches entfernt werden muss
//-------------------------------------------------------------------------
    what = what[0..<2];

    tell_room(room, "Der Papagei kraechzt: "+what+".\n", ({ TO }) );
  }

  return;
}

