void init()
{::init();
		call_out("check",0);

}	
	
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Iskir Kiarson");
  SetProp(P_LONG,
    "Du siehst einen grossen, schlanken Mann vor Dir. Er traegt ein zu "
	"weites Leinenhemd durch das man seine hellhaeutige, kraeftige Brust "
	"sehen kann und noch weitere Hosen, die von einer alten Kordel "
	"gehalten werden. Er hat unnatuerlich hellblaue Augen und blond-"
	"graue Haare. Seine wenigen Falten machen ihn irgendwie attraktiv.");
  SetProp(P_NAME, "Iskir");
  SetProp(P_GENDER, MALE);
  AddId(({"iskir", "iskir kiarson", "kiarson", "ISKIR", "NOWIMPY"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("Iskir");
  create_default_zechpreller(30, 7, 1500);
  //create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",
                     QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 195);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt durch eine verstecke Falltuer herein.");
  SetProp(P_MMSGOUT, "steigt durch eine verstecke Falltuer.");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
 
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Iskir");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "brummt Dich genervt an.\n");
  AddInfo("", ".","sagt: ");

  AddInfo( ({"iskir",""}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"schnapsladen",""}),
    "Ich besitze einen Schnapsladen.",
    "sagt: ");

  AddInfo( ({"alkohol",""}),
    "Ich verkaufe die verschiedensten Sorten Alkohol.",
    "sagt: ");
  AddInfo( ({"sorten","uebersicht", "angebot"}),
    "Mit <zeige> bekommt Ihr eine Uebersicht meines Angebots.",
    "sagt: ");
  AddInfo( ({"gold","liebe"}),
    "Ich liebe Gold",
    "sagt: ");
  AddInfo( ({"essen","trinken","tanken"}),
    "Geht zum Wirt.",
    "sagt: ");
  AddInfo( ({ "wirt" }),
    "Jann ist der Wirt in der Hafenkneipe und Endoriel verkauft auch"+
"	Speisen in der Grotte.",
    "sagt: ");
  AddInfo( ({ "hafenkneipe", "kneipe" }),
    "Die ist am Hafen.",
    "sagt: ");
  AddInfo( ({ "pirat", "piraten" }),
    "Piraten? Kenn ich nicht!",
    "sagt: ");
  AddInfo( ({ "haende", "hand" }),
    "Haende hab ich zwei.",
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Auf dieser Insel gibt es nur einen Kobold. Seine Name ist Eharl.",
    "sagt: ");
  AddInfo( ({ "laden" }),
    "Ja, sowas gibt es hier.",
    "sagt: ");
  AddInfo( ({ "sex", "poppen", "quickie", "ficken", "blowjob" }),
    "haut dir eine runter");

  AddInfo( ({ "leuchtturm" }),
    "Der Leuchtturm steht in der Mitte der Insel.",
    "sagt: ");        
  AddInfo( ({ "narren", "narr" }),
    "Da koennt Ihr nur Jann, Piet, Drako und Hein mit meinen.",
    "sagt: ");
  AddInfo( ({ "schatzkarte", "schatz" }),
    "Das ist doch Bloedsinn. Nur Narren suchen nach all den Jahren noch "+
	"nach dem Schatz.","sagt: ");  
  AddInfo( ({ "drako" }),
    "Drako war mein Kapitaen, doch sein Schiff ging zu Bruch. Er verlor "+
	"dabei sein Bein und seine Wuerde. Ich hab ihn als Fuehrer "+
	"abgesetzt. Nur wenige halten noch zu ihm. Seine "
    "Freunde erkennt Ihr an den albernen Medallien, die sie tragen.", 
    "sagt: ");  
  AddInfo( ({ "jann" }),
    "Jann besitzt die kleine Hafenkneipe am Steg. Ihr seid ihm sicher "+
	"schon begegnet.",
    "sagt: ");    
  AddInfo( ({ "hein", "leuchtturmwaechter" }),
    "Hein ist der Leuchtturmwaechter dieser Insel.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist der Ladenbesitzer hier.",
    "sagt: ");
  AddInfo( ({ "iskir" }),
    "Iskir besitzt einen kleinen Schnapsladen.",
    "sagt: ");
  AddInfo( ({ "broud", "sklaventreiber" }),
    "Broud war der Sklaventreiber auf Drakos Schiff. Nun handelt er mit "+
	"Sklaven.",
    "sagt: ");
  AddInfo( ({ "eharl" }),
    "Eharl ist ein listiger kleiner Kobold, wir haben ihn einst "+
	"gefangengenommen auf einer unserer Kaperfahrten, doch der kleine "+
	"Kerl hat gewaltige Zauberkraefte und wurde bald "
    "einer von uns. Nun lebt er davon, dass er Schwarzgelder verwaltet.",
    "sagt: ");
  AddInfo( ({ "endoriel" }),
    "Endoriel ist ein sehr stolzer Elf. Er wurde aus seiner Heimat "+
	"vertrieben. Da er gut kaempfen kann und sehr viel Mut besitzt "+
	"nahmen wir ihn bei uns auf. Aber er scheint nicht gluecklich zu "+
	"sein.",
    "sagt: ");
  AddInfo( ({ "trogurt" }),
    "Trogurt ist der Staerkste von uns. Er ist der Schmied auf dieser "+
	"Insel, auch wenn er nicht mehr viel zu tun hat. Beim ihm koennen "+
	"unerfahrene Piraten ihre Ausruestung reparieren lassen.",
    "sagt: ");
  AddInfo( ({ "hildgunde" }),
    "Das ist die Sklavin, die uns alle bedient. Sie gehoert aber "+
	"eigentlich Broud.",
    "sagt: ");
  AddInfo( ({ "martus" }),
    "Martus ist ein alter Mann, der nie richtig kaempfen konnte. Er lebt"+
    " nun davon, Medaillen an Abenteurer zu verkaufen.",
    "sagt: ");
  AddInfo( ({ "reichtuemer" }),
    "Bei uns Piraten ist es Brauch, dass wir unsere Schaetze vergraben "+
	"um in kargen Zeiten davon leben zu koennen. Ausserdem verwahrt "+
	"Eharl unsere Muenzen.",
    "sagt: ");  
  AddInfo( ({ "schnapsladen" }),
    "In der Grotte gibt es einen kleinen Schnapsladen.",
    "sagt: ");        
  AddInfo( ({ "sklaven" }),
    "Sklaven koennt Ihr bei Broud kaufen. Fragt ihn danach",
    "sagt: ");        
  AddInfo( ({ "schnapsladen" }),
    "Es gibt auf dieser Insel einen kleinen Schnapsladen, welcher von "+
	"Iskir betrieben wird.",
    "sagt: ");        
  AddInfo( ({ "kneipe","hafenkneipe" }),
    "Am Hafen gibt es eine kleine Kneipe und in der Grotte ebenfalls.",
    "sagt: ");        
  AddInfo( ({ "silberland" }),
    "Das ist doch Seemansgarn!",
    "sagt: ");        
  AddInfo( ({ "insel","pirateninsel" }),
    "Ich lebe schon lange auf dieser Insel.",
    "sagt: ");        
  AddInfo( ({ "roger","roger schwarzbart","schwarzbart" }),
    "Roger Schwarzbart ist der Anfuehrer der Piraten. Frueher waren er "+
	"und Drako Konkurrenten, aber das ist lang vorbei.",
    "sagt: ");        
  AddInfo( ({ "konkurrenten", "konkurrenz" }),
    "Seit Drakos Schiff unterging, hat Roger Schwarzbart keine Konkurrenz mehr.",
    "sagt: ");  
  AddInfo( ({ "gluckern" }),
    "Achja, das kommt wohl aus dem Weinfass.",
    "sagt: "); 
  AddInfo( ({ "leiche" }),
    "Tja, da hat einer versucht, mich zu bestehlen. Und schon ist er "
	"eine Zutat geworden.",
    "sagt: "); 
  AddInfo( ({ "zutat", "zutaten" }),
    "In meinen Faessern sind manchmal ganz besondere Zutaten.",
    "sagt: "); 
	
	
	
//  SetProp(P_LOG_INFO, "yondala");
  SetProp(P_SPELLRATE,30);
  SUID;
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");  
  CLONEME(PIR_ARMOUR + "iskirhemd");
  CLONEME(PIR_ARMOUR + "iskirhose");
  CLONEME("/p/armour/boots/lederschuhe");
  CLONEME("/obj/fackel");
  command("trage alles");
    
 /* SetChats(3, ({
    ".\n"}) );*/
  SetAttackChats(5, ({
    "Iskir nimmt einen Schluck aus einer Flasche.\n"}) );


}

// Mitloggen wenn ein Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }
void raus(object spieler)
{
      command("sag Raus mit Euch, "+TPN+", Ihr geht mir auf die Nerven!\n");
      spieler->move( PIR_ROOM + "piratengrotte_3c", M_GO,
  	       "","wird von Iskir rausgeworfen.","fliegt im hohen Bogen aus dem Laden.");
		   }
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht schallend.",
        "lacht schallend.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt genervt.",
        "brummt genervt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "zwinkert Dir zu.",
        "zwinkert "+TP->name(WEM)+" zu.");
      break;
    case "fies":
	   raus(TP);
      break;
    case "frech":
      raus(TP);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "nickt Dir zu.", 
        "nickt "+TP->name(WEM)+" zu.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Auf Euer Angebot komme ich gerne zurueck, "+TPN+".",
        "sagt: Auf Euer Angebot komme ich gerne zurueck, "+TPN+".");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN)+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "blickt in die Ferne.",
        "blickt in die Ferne.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void check()
{
  // Spieler noch da?
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
    if (present("/nschutzmedaillepiraten",TP))  // Medaille dabei?
    {
      //say("Ein Pirat sagt: Hallo "+
        command("sag Seid gegruesst, "+ TPN+"!");
    }
    else        // Keine Medaille dabei...
    {
      //say("Ein Pirat schreit: Ein Feind, auf ihn!\n");
      command("sag Ihr tragt keine Medaille, Ihr seid ein Feind, "+TPN+"!");
      Attack(TP);
    }
  }
}	
