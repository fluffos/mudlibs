#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Leuchtturm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Erdgeschoss des Leuchtturms. Du kannst ihn verlassen oder weiter nach oben gehen. "
    " Dieser Raum ist leer, bis auf die Treppe, die nach oben fuehrt und einem Stuhl." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddItem(PIR_NPC + "pirat_hein",REFRESH_DESTRUCT);

  AddDetail( ({ "wand", "waende" }),
    "Eigentlich nur eine Wand, denn diese ist rund. Es gibt keine Ecken. "
	"Die Wand wird lediglich durch die Tuer unterbrochen.");
  AddDetail( ({ "ecken" }),
    "Wirklich, es gibt keine. Denk doch mal nach!");
  AddDetail( ({ "treppe" }),
    "Die Treppe fuehrt nach oben.");
  AddDetail( ({ "erdgeschoss","leuchtturms","leuchtturm", "raum" }),
    "Du befindest Dich im Erdgeschoss des Leuchtturms.");
  AddDetail( ({ "stuhl" }),
    "Der Stuhl gehoert Hein. Hier sitzt er fast immer und bedauert sein Leben.");
  AddDetail( ({ "leben" }),
    "Zurecht. Sonderlich gut hat er es nicht gefuehrt.");
  AddDetail( ({ "boden", "lehm" }),
    "Der Boden besteht aus plattgetrampeltem Lehm.");
  AddDetail( ({ "tuer" }),
    "Die Tuer besteht aus Holz und haengt ein bisschen schief in den "
	"Angeln. ");
  AddDetail( ({ "angeln" }),
    "Die Angeln sind schon sehr rostig. Vermutlich kann man sie gar nicht "
	"mehr schliessen. Aber warum auch? Hier ist nichts zu holen.");
  AddDetail( ({ "decke" }),
    "Eine Decke in dem Sinne gibt es hier nicht. Nur die Treppe, die nach "
	"oben fuehrt.");
  AddDetail( ({ "sinne" }),
    "Auch in keinem anderen Sinne.");
  AddDetail( ({ "holz" }),
    "Das Holz der Tuer scheint schon sehr alt und morsch zu sein.");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst den Wind leise pfeifen.");

  AddSound( ({ "wind" }),
    "Irgendwo scheint hier etwas undicht zu sein, der Wind pfeift leise.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nicht gut. Feucht, muffig und irgendwie so, als "
	"wuerde die Wand ab und zu mit einer Toilette verwechselt.");

  AddSmell( ({ "wand" }),
    "Das laesst Du lieber, die riecht nicht gut.") ; 
  AddSmell( ({ "toilette" }),
    "Hier ist keine.");

  AddRoomMessage( 
    ({""}),30,"func");




AddExit( "oben", PIR_ROOM + "pirateninsel_leuchtturm_1" ); 
AddExit( "raus", PIR_ROOM + "pirateninsel_6d" );
AddCmd(({"schliesse","schliess"}), "schliessen");

}
int schliessen(string str)
{
  notify_fail("Was moechtest Du schliessen?\n");
  if (str!="tuer") return 0;
  write("Du ruckelst an der Tuer herum, sie laesst sich aber nicht "+
        "bewegen.\nGenervt gibst Du auf.\n");
  say(TPN+" versucht die Tuer zu schliessen.\n");
  return 1;
  }
  
