//Der Standartpirat mit den Infos
//Achtung: Jede Aenderung hier muss auch in pirat_iskir vollzogen werden. Jener kann diesen hier nicht inheriten
#include "../def.h"
inherit "std/mnpc";

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
//#include <moredef.h>//Definition fuer Kuerzel
#include <moving.h>
#include <language.h>
void create() {

  ::create();


  AddInfo( ({"gold","liebe"}),
    "Ich liebe Gold.",
    "sagt: ");
  AddInfo( ({"essen","trinken","tanken"}),
    "Geht zum Wirt.",
    "sagt: ");
  AddInfo( ({ "wirt" }),
    "Jann ist der Wirt in der Hafenkneipe und Endoriel verkauft auch Speisen in der Grotte.",
    "sagt: ");
  AddInfo( ({ "hafenkneipe", "kneipe" }),
    "Die ist am Hafen.",
    "sagt: ");
  AddInfo( ({ "pirat", "piraten" }),
    "Piraten? Kenn ich nicht!",
    "sagt: ");
  AddInfo( ({ "haende", "hand" }),
    "Haende hab ich zwei.",
    "sagt: ");
  AddInfo( ({ "kobold", "kobolde" }),
    "Auf dieser Insel gibt es nur einen Kobold. Seine Name ist Eharl.",
    "sagt: ");
  AddInfo( ({ "laden" }),
    "Ja, sowas gibt es hier.",
    "sagt: ");
  AddInfo( ({ "sex", "poppen", "quickie", "ficken", "blowjob" }),
    "haut dir eine runter");

  AddInfo( ({ "leuchtturm" }),
    "Der Leuchtturm steht in der Mitte der Insel.",
    "sagt: ");        
  AddInfo( ({ "narren", "narr" }),
    "Da koennt Ihr nur Jann, Piet, Drako und Hein mit meinen.",
    "sagt: ");
  AddInfo( ({ "schatzkarte", "schatz" }),
    "Das ist doch Bloedsinn. Nur Narren suchen nach all den Jahren noch nach dem Schatz.","sagt: ");  
  AddInfo( ({ "drako" }),
    "Drako war mein Kapitaen, doch sein Schiff ging zu Bruch. Er verlor dabei sein Bein und "
    "seine Wuerde. Wir haben ihn als Fuehrer abgesetzt. Nur wenige halten noch zu ihm. Seine "
    "Freunde erkennt Ihr an den albernen Medaillen, die sie tragen.", 
    "sagt: ");  
  AddInfo( ({ "jann" }),
    "Jann besitzt die kleine Hafenkneipe am Steg. Ihr seid ihm sicher schon begegnet.",
    "sagt: ");    
  AddInfo( ({ "hein", "leuchtturmwaechter" }),
    "Hein ist der Leuchtturmwaechter dieser Insel.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist der Ladenbesitzer hier.",
    "sagt: ");
  AddInfo( ({ "iskir" }),
    "Iskir besitzt einen kleinen Schnapsladen.",
    "sagt: ");
  AddInfo( ({ "broud", "sklaventreiber" }),
    "Broud war der Sklaventreiber auf Drakos Schiff. Nun handelt er mit Sklaven.",
    "sagt: ");
  AddInfo( ({ "eharl" }),
    "Eharl ist ein listiger kleiner Kobold, wir haben ihn eins gefangengenommen auf einer "
    "unserer Kaperfahrten, doch der kleine Kerl hat gewaltige Zauberkraefte und wurde bald "
    "einer von uns. Nun lebt er davon, dass er Schwarzgelder verwaltet.",
    "sagt: ");
  AddInfo( ({ "endoriel" }),
    "Endoriel ist ein sehr stolzer Elf. Er wurde aus seiner Heimat vertrieben. Da er gut "
    "kaempfen kann und sehr viel Mut besitzt nahmen wir ihn bei uns auf. Aber er scheint "
    "nicht gluecklich zu sein.",
    "sagt: ");
  AddInfo( ({ "trogurt" }),
    "Trogurt ist der Staerkste von uns. Er ist der Schmied auf dieser Insel, auch wenn er "
    "nicht mehr viel zu tun hat. Beim ihm koennen unerfahrene Piraten ihre Ausruestung reparieren lassen.",
    "sagt: ");
  AddInfo( ({ "hildgunde" }),
    "Das ist die Sklavin, die uns alle bedient. Sie gehoert aber eigentlich Broud.",
    "sagt: ");
  AddInfo( ({ "martus" }),
    "Martus ist ein alter Mann, der nie richtig kaempfen konnte. Er lebt nun davon, Medaillen "
    "an Abenteurer zu verkaufen.",
    "sagt: ");
  AddInfo( ({ "reichtuemer" }),
    "Bei uns Piraten ist es Brauch, dass wir unsere Schaetze vergraben um in kargen Zeiten "
    "davon leben zu koennen. Ausserdem verwahrt Eharl unsere Muenzen.",
    "sagt: ");  
    AddInfo( ({ "schnapsladen" }),
    "In der Grotte gibt es einen kleinen Schnapsladen.",
    "sagt: ");        
  AddInfo( ({ "sklaven" }),
    "Sklaven koennt Ihr bei Broud kaufen. Fragt ihn danach",
    "sagt: ");        
    AddInfo( ({ "schnapsladen" }),
    "Es gibt auf dieser Insel einen kleinen Schnapsladen, welcher von Iskir betrieben wird.",
    "sagt: ");        
    AddInfo( ({ "kneipe","hafenkneipe" }),
    "Am Hafen gibt es eine kleine Kneipe und in der Grotte ebenfalls.",
    "sagt: ");        
    AddInfo( ({ "silberland" }),
    "Das ist doch Seemans Garn!",
    "sagt: ");        
    AddInfo( ({ "insel","pirateninsel" }),
    "Ich lebe schon lange auf dieser Insel.",
    "sagt: ");        
    AddInfo( ({ "roger","roger schwarzbart","schwarzbart" }),
    "Roger Schwarzbart ist der Anfuehrer der Piraten. Frueher waren er und Drako Konkurrenten, aber das ist lang vorbei.",
    "sagt: ");        
    AddInfo( ({ "konkurrenten", "konkurrenz" }),
    "Seit Drakos Schiff unterging, hat Roger Schwarzbart keine Konkurrenz mehr.",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");        
    AddInfo( ({ "" }),
    "",
    "sagt: ");
    
    
    
}


