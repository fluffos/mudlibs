//Flasche fuer den Laden auf der Pirateninsel
//clont sich gross, klein, mittel und in verschiedenen Sorten
// Yondala@Andracia 7.3.2007

#include "../def.h"

inherit "std/thing";

#include <properties.h>

int alk = 1;
string fuelle = "volle";
int sorte=random(5);
int groesse=random(3);
int voll=8;//wie sitt macht das Getraenk?
int alko;//wieviel Alk ist drin?
int heilung=50; //wieviel heilt die Flasche?
int blindmach=random(10);
int fusel=0;


void create() 
{
  if (!is_clone(TO)) return;
  ::create();



switch (sorte)
{
	case 0:
		{
			  SetProp(P_SHORT, "Eine volle Rumflasche");
  			SetProp(P_LONG,
    			"Du siehst eine alte, gefuellte Rumflasche. Der Rum wurde wohl irgendwo schwarz "
    			"gebrannt. Nur wer mutig ist, sollte daraus trinken." );
  		  SetProp(P_NAME, "Rumflasche");
  			AddId(({"rumflasche", "rum"}));
  			alko = 8;
			  SetProp(P_VALUE, 600);    			
				break;
				}		
	case 1:
		{
			  SetProp(P_SHORT, "Eine volle Weinflasche");
  			SetProp(P_LONG,
    			"Du siehst eine dunkle, bauchige Flasche in der wuerziger, dunkler Wein schwappt." );
  		  SetProp(P_NAME, "Weinflasche");
  			AddId(({"weinflasche", "wein"}));

			  SetProp(P_VALUE, 200);  			
  			alko = 2;
				break;
				
				}			
	case 2:
		{
			  SetProp(P_SHORT, "Eine volle Schnapsflasche");
  			SetProp(P_LONG,
    			"Du siehst eine gefuellte Schnapsflasche. Der Schnaps wurde wohl irgendwo schwarz "
    			"gebrannt. Nur wer mutig ist, sollte daraus trinken." );
  		  SetProp(P_NAME, "Schnapsflasche");
  			AddId(({"schnapsflasche", "schnaps"}));
			  SetProp(P_VALUE, 400);				
  			alko = 7;
				break;
				}				
	case 3:
		{
			  SetProp(P_SHORT, "Eine volle Grogflasche");
  			SetProp(P_LONG,
    			"Du siehst eine alte, gefuellte Grogflasche. Warm ist er bestimmt besser, aber Du bist ja nicht waehlerisch." );
  		  SetProp(P_NAME, "Grogflasche");
  			AddId(({"grogflasche", "grog"}));
  			SetProp(P_VALUE, 300);
  			alko = 6;
				break;
				}				
	case 4:
		{
			  SetProp(P_SHORT, "Eine volle Flasche mit Fusel");
  			SetProp(P_LONG,
    			"Du siehst eine volle Flasche mit irgendeinem Fusel drin." );
  		  SetProp(P_NAME, "Fuselflasche");
  			AddId(({"fuselflasche", "fusel"}));
  			SetProp(P_VALUE, 200);
  			fusel=1;
  			alko = 5;
  			break;
				}				
	
	}
switch(groesse)
{
	case 0: 
		{  
			AddAdjective( ({ "gross" }) );
			//SetProp(P_NAME_ADJ, "gross");
			SetProp(P_WEIGHT, 1000);
			break;
		}
		case 1:   
			{
				AddAdjective( ({ "mittel" }) );
				//SetProp(P_NAME_ADJ, "mittel");
				voll=voll-2;
				alko=alko-2;
			SetProp(P_WEIGHT, 800);
			heilung -=10;				
			break;}
		case 2:
				{
					AddAdjective( ({ "klein" }) );
					//SetProp(P_NAME_ADJ, "klein");
					voll=voll-4;
					alko=alko-1;
			SetProp(P_WEIGHT, 600);
			heilung -=20;
			break;
					}	
}


  SetProp(P_GENDER, FEMALE);
  AddId(({"flasche"}));
 
  SetProp( P_MATERIAL, ([ MAT_GLASS : 20, MAT_ALCOHOL : 80 ]) );
 SetProp(P_NAME_ADJ, "voll");

  AddCmd(({"trink","trinke"}),"trinkenCmd");

}



trinkenCmd(string str)
{ notify_fail("Woraus moechtest Du trinken?\n");

if (str=="flasche"||str=="aus flasche"||"flasche aus"||str==QueryProp(P_NAME)||str=="aus "+QueryProp(P_NAME)||str==QueryProp(P_NAME)+" aus")

{		
	     if ((alk > 0) && this_player()->drink_drink(voll,alko))
     {
       write("Du trinkst die Flasche in einem Zug leer.\n");
       say(TPN+" trinkt eine Flasche aus.\n");
       this_player()->heal_self(heilung);
       SetProp(P_SHORT, "Eine leere Flasche");
  		 SetProp(P_LONG,
    		"Du siehst eine alte, leere Flasche, leider weisst Du nicht, was darin war." );
  		 SetProp( P_MATERIAL, MAT_GLASS);
			 SetProp(P_WEIGHT, 200);
  		 SetProp(P_VALUE, 50);
  		 SetProp(P_NAME_ADJ, "leer");
  		  SetProp(P_NAME, "Flasche");
			RemoveAdjective("voll");
       alk--;
       if(fusel==1&&blindmach==1)
       	{
       		TP->SetProp(P_BLIND, 5);
       	}
       
     }
	else
		{write ("Die Flasche ist leer.\n");}
	return 1;
	}
}

