#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
    "Du bist am Strand der Pirateninsel. Hier ist es einfach himmlisch. "
    "Die Sonne lacht, die Palmen bewegen sich im Wind. Unter Deinen Fuessen "
    "knirscht leise der warme, weiche Sand. Am Ufer branden seichte Wellen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "strand", "pirateninsel" }),
    "Du befindest Dich am Strand der Pirateninsel.");
  AddDetail( ({ "piratenisel" }),
    "Auf diese Insel bist du gereist.");
  AddDetail( ({ "meer" }),
    "Das Meer umgibt die Insel.");
  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel und lacht Dich an.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau und die Sonne lacht Dich an.");
  AddDetail( ({ "sand" }),
    "Der Sand ist weich und weiss. Die Sonne hat ihn aufgewaermt.");
  AddDetail( ({ "palme", "palmen" }),
    "Die Palmen sind von dichten Bueschen umgeben.");
  AddDetail( ({ "wind", "brise" }),
    "Du fuehlst eine leichte Brise auf deiner Haut.");
  AddDetail( ({ "haut" }),
    "Haut ist wichtig. Saehe doof aus ohne...");
  AddDetail( ({ "ufer" }),
    "Das Ufer der Insel.");
  AddDetail( ({ "wellen", "wasserbewegung", "welle" }),
    "Wasserbewegung nennt man Wellen.");
  AddDetail( ({ "fuesse", "fuessen", "beine", "bein", "ende" }),
    "Am Ende Deiner Beine sind Deine Fuesse.");
  AddDetail( ({ "wasser" }),
    "Im Sueden kannst Du weit weg eine kleine Insel erkennen.");

  AddDetail( ({ "kleine insel", "sueden" }),
    "Um mehr erkennen zu koennen muesstest Du hinschwimmen.");
  AddDetail( ({ "insel" }),
    "Meinst Du die kleine Insel oder die Pirateninsel?");
  AddDetail( ({ "buesche","bueschen","dornenbuesche","gebuesch" }),
    "Die Buesche haben dicke Dornen.");
  AddDetail( ({ "dorne","dornen" }),
    "Fass sie lieber nicht an!");
  AddDetail( ({ "kleine Insel" }),
    "Die kleine Insel ist relativ nah, Du kannst versuchen hinzuschwimmen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Sand.");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Das Meer rauschen.");

  AddSound( ({ "meer" }),
    "Es wirkt sehr beruhigend auf Dich.");
  AddSound( ({ "moewe", "geschrei" }),
    "Immer wieder hoerst Du das heisere Geschrei einer Moewe.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist herrlich frisch.");

  AddSmell( ({ "luft" }),
    "Haaaach, Du atmest tief durch. Einfach herrlich.");

  AddRoomMessage( 
    ({"Du hoerst das Meer rauschen.\n", 
    	"Die Palmen wiegen sich im Wind.\n",
    	"Eine Moewe kreischt ganz in Deiner Naehe.\n"}),50,"func");
  AddCmd( ({ "bau", "baue" }), "bauenCmd" );

  AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
  AddCmd( ({ "greif", "greife", "fass","fass" }), "greifenCmd" ); 
  AddCmd( ({ "schwimm", "schwimme" }), "schwimmenCmd" );   
  AddExit( "osten", PIR_ROOM + "pirateninsel_8e" );
  AddExit( "westen", PIR_ROOM + "pirateninsel_8c" );

//  AddItem( "item" , REFRESH_DESTRUCT);
}

int bauenCmd(string str )
{
  notify_fail( "Was moechtest du bauen?\n" );
  if( str == "burg"||str== "sandburg" )
  {

	  write("Der Sand eignet sich hier nicht dazu eine Burg zu bauen.\n");
	  return 1;
	  }
return 0;
}
int kletternCmd(string str )
{
  notify_fail( "Wo willst du draufklettern?\n" );
  if( str == "auf palme" )
  {
    write("Du naeherst Dich der Palme, bemerkst dann aber, dass ein "+
	      "stacheliges Gebuesch die Palme umgibt, also gibst du dein "+
		  "Vorhaben schnell auf.\n");
    say( TPN+" versucht auf eine Palme zu klettern, scheitert aber.\n",TP);
        return 1;
  }
  return 0;
}



int greifenCmd(string str )
{
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "in dornen"||str=="in dorne"||str=="in gebuesch"||
      str == "dornen an"||str=="dorne an"||str=="gebuesch an"   )
  {
    write("Du greifst in die Dornen und piekst Dich ganz fuerchterlich.\n");
    say( TPN+" greift in Dornen und piekst sich ganz fuerchterlich.\n",TP);
    TP->do_damage(5,"Dornen");
    return 1;
  }
  return 0;
}


int schwimmenCmd(string str )
{
 
  notify_fail( "Wo willst Du hin schwimmen?\n" );
  if( str == "zur kleinen insel" || str== "zur kleinen insel hin"||str == "zur kleinen insel hinueber" || str== "zur kleinen insel rueber" ||
  str == "zur anderen insel" || str== "zur anderen insel hin"||str == "zur anderen insel hinueber" || str== "zur anderen insel rueber"||
  str == "zur insel" || str== "zur insel hin"||str == "zur insel hinueber" || str== "zur insel rueber"||
  str== "herueber"||str == "hinueber" || str== "rueber"||
  str == "zu kleiner insel" || str== "zu kleiner insel hin"||str == "zu kleiner insel hinueber" || str== "zu kleiner insel rueber" ||
  str == "zu anderer insel" || str== "zu anderer insel hin"||str == "zu anderer insel hinueber" || str== "zu anderer insel rueber"||
  str == "zu insel" || str== "zu insel hin"||str == "zu insel hinueber" || str== "zu insel rueber")

  { 
    
    write("Du watest ins Wasser und schwimmst los.\n");
    say( TPN+" schwimmt los.\n",TP);
	if (random(20)==1) TP->move(PIR_ROOM+"pirateninsel_wal", M_GO);
	else               TP->move(PIR_ROOM+"pirateninsel_10c", M_GO);
			 
    return 1;  	
  	 }
    return 0;
}