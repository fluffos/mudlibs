#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzbein");
  SetProp(P_LONG,
    "Ein Holzbein. Das kann vermutlich nur jemand brauchen, der nur ein "
	"eigenes Bein hat." );

  SetProp(P_NAME, "Holzbein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"bein","holzbein"}));

  SetProp(P_MATERIAL, MAT_OAK );
  SetProp(P_WEIGHT, 4500);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);

}