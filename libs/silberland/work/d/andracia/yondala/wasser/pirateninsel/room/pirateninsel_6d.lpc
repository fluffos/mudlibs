// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 27.04.2010
// Hier kann man den Leuchtturm betreten

#include "../def.h"

inherit "std/room";

#include <properties.h>
int halm =1;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen den Duenen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten zwischen den Duenen. Der Boden auf dem Du stehst besteht "
    "aus warmem, weichem Sand. Die Sonne steht an einem strahlend blauem Himmel und lacht "
    "auf Dich herunter. Noerdlich von Dir steht ein grosser Leuchtturm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft salzig.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
  AddDetail( ({ "grasbueschel" }),
    "Das Gras waechst hier nur sehr spaerlich.");
  AddDetail( ({ "gras" }),
    "Nur sehr wenige Halme halten sich hier.");
  AddDetail( ({ "halme" }),
    "Die meisten Halme sind graeulich und trocken.");
  AddDetail( ({ "halm" }),
    "Dem Halm scheint es gut zu gehen.");
  AddDetail( ({ "laufen" }),
    "Du schleppst Dich muehsam durch den Sand.");
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht fast nur aus Sand. Nur hin und wieder kann sich ein Grasbueschel halten.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "leuchtturm", "turm" }),
    "Er ist sehr hoch, hat nur wenige Fenster und ist rotweissgestreift angemalt."
    "\nDu kannst ihn betreten.");
  AddDetail( ({ "fenster" }),
    "Die Fenster scheinen blind zu sein.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Du kannst das Meer rauschen hoeren. Es scheint also nicht weit entfernt zu sein.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht salzig nach Meer.");

  AddSmell( ({ "meer" }),
    "Es riecht salzig und fischig.");
  AddSmell( ({ "luft", "salz" }),
    "Die salzige Luft tut Dir gut, Du atmest tief ein und wieder aus.");
 

   AddExit( "osten", PIR_ROOM + "pirateninsel_6e" );
   AddExit( "westen", PIR_ROOM + "pirateninsel_6c" );
   AddCmd(({"betrete","betritt"}),"betretenCmd");
 
}




betretenCmd(string str)

{
  notify_fail("Was moechtest du betreten?\n" );
  if (str=="leuchtturm"||str=="turm")
  {
  	
  	TP->move(PIR_ROOM + "pirateninsel_leuchtturm_eg", M_GO,
  	"","betritt den Leuchtturm","kommt herein");

    return 1;

  }
  return 0;
}