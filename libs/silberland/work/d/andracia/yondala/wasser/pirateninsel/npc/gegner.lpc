//Ein Gegner nur fuer Rambo :o)

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"


void nerven()
{
object spieler;
if(find_player("rambo"))
{
  //command("sag Opfer, ich komme!");
  spieler=find_player("rambo");
  TO->move(environment(spieler),M_GO);
  spieler->AddPursuer(TO);

  }
 }
void create() {
  if (!is_clone(TO)) return;

 ::create();

	  
  SetProp(P_SHORT, "Ein Gegner");
  SetProp(P_LONG,
    "Du siehst einen Gegner, hau ihn um!");
  SetProp(P_NAME, "Gegner");
  SetProp(P_GENDER, MALE);
  AddId(({"gegner"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit Forschfaulheit",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 168);
  SetProp(P_WEIGHT, 45000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  AddInfo(DEFAULT_INFO, "sagt: Frag nicht, hau mich um.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Gegner will nichts tragen.\n" }) );
  SetChats(3, ({
    "Der Gegner sagt: Hau mich um!\n"
    }) );
 nerven();

 }

