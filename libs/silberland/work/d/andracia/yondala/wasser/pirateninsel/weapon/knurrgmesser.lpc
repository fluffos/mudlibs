#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein besonderes Messer");
  SetProp(P_LONG,
    "Du siehst ein Messer, welches ein wahrer Meister hergestellt haben muss. Es ist glatt "
    "poliert und scheint sehr robust und auch sehr scharf zu sein." );
  SetProp(P_NAME_ADJ, "besonder");
  //SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_NAME, "Messer");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "\nknurrgsmesser", "\nhildgundeitem"}) );
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 20 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_TITANIUM );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 2200);

  SetProp(P_QUALITY_DECAY, 200);
  
}


