void reset()
     {
		 haben =1;
		 	 }

string kitt()
{
	 if(TP->QueryQuest("Such den Piratenschatz")||present("kitt",TP)) 
	 	return "sagt: Sowas habe ich Euch schon einmal gegeben.\n";
		if(!haben)
			return "sagt: Das habe ich schon weggegeben, kommt spaeter wieder.\n";
			
	write("Trogurt drueckt Dir etwas in die Hand.\n");
	say("Trogurt drueckt "+TPN+" etwas in die Hand.\n", TP);	
	CLONE(PIR_OBJ +"kitt", TP);		
	haben=0;
 	return "sagt: Das sollte Euch reichen.\n";
	}	
	

	
