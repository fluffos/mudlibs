// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht Dich aus.",
        "lacht "+TP->name(WEN)+" aus.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "droht Dir mit seinem Hammer.",
        "droht "+TP->name(WEM)+ "mit seinem Hammer.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt.",
        "schmunzelt.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schimpft ueber Dich.",
        "schimpft ueber " +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "huestelt kuenstlich.",
        "huestelt kuenstlich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "singt ein raues Lied.", 
        "singt ein raues Lied.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
//    case "neutral":
//      call_out("reaction", 0, TP,
  //      ".",
    //    ".");
      //break;
    case "traurig":
      call_out("reaction", 0, TP,
        "wird sentimental.",
        "wird sentimental.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
 
 
}


riechenCmd(string str)
  {
  if (str == "trogurt"||str=="an trogurt")
	{write ("Trogurt stinkt!\n");
	return 1;
	}
	return 0;
	}
	
	
	
	kaufenCmd(string str)
{ notify_fail("Was willst Du kaufen?\n");


if(str=="bauanleitung" || str=="anleitung")
{	
	if(this_player()->QueryMoney() >= 200)
		{
			this_player()->AddMoney(-200);
			write("Du gibst Trogurt 200 Muenzen.\n"
			"Trogurt gibt Dir dafuer ein schmuddeliges Blatt Papier.\n");
			say(TPN+" kauft etwas bei Trogurt.\n", TP);
			CLONE(PIR_OBJ +"leuchtturmlampebauplan", TP);
			return 1;
			}
	else
		{
			write("Trogurt sagt: Ihr habt doch gar nicht genug Geld dabei. Elendes Pack!\n"+
			"Trogurt pack Dich am Kragen und wirft Dich aus seiner Schmiede.");
	  	TP->move( PIR_ROOM + "piratengrotte_4e", M_GO);
			say("Trogurt wirft "+TPN+" aus seiner Schmiede.\n", TP);
			return 1;
		}
	}
if(str=="glas" || str=="glasrohling")
	{	
	
		if(this_player()->QueryMoney() >= 500)
			{
				this_player()->AddMoney(-500);
				write("Du gibst Trogurt 500 Muenzen, dieser gibt Dir dafuer ein Stueck Glas.\n");
				say(TPN+" kauft etwas bei Trogurt.\n", TP);
				CLONE(PIR_OBJ +"glasrohling", TP);
				return 1;}
		else
			{
				write("Trogurt sagt: Ihr habt doch gar nicht genug Geld dabei. Elendes Pack!\n"+
				"Trogurt pack Dich am Kragen und wirft Dich aus seiner Schmiede.");
	  		TP->move( PIR_ROOM + "piratengrotte_4e", M_GO);
				say("Trogurt wirft "+TPN+" aus seiner Schmiede.\n", TP);
				return 1;
			}
		
	}
}

int vergleichen(string str)
{
  object victim1, victim2;
  
  string *damtyp1, *damtyp2, vtype, vtype2, wtype, result, vname, wname, text1, text2; 
  string *damres1, *damres2;
  //*wdamtyp, vtype, wtype, result, vname, wname, text1;
  //string *vdamtyp2, *wdamtyp2, vtype2, wtype2, result2, vname2, wname2, text2;
  mapping rues1, rues2;
  
  int zahl1,zahl2,zahl3;//vwc, wwc, vhands, whands, vwcfix, wwcfix, vqdecay, wqdecay, wcdif, suc; 

notify_fail("Was moechtet Ihr mit was vergleichen?\n");
if(!str) return 0;

  if (TP->InFight())
  {write("Du kannst waehrend dem Kampf nichts vergleichen!\n");
    return 1;}
  if (TO->InFight())
  	{write("Trogurt kann gerade nicht.\n");
  	return 1;}  
    
  if ( sscanf(str, "%s mit %s", text1,text2 ) != 2) //wenn kein string mitgegeben
    return 0;
      
  if(present(text1, TP)) victim1=present(text1, TP);
  else 
    {write("Du hast kein "+capitalize(text1)+"!\n");
    return 0;}

  if(present(text2, TP)) victim2=present(text2, TP);

  else    
    {
      write("Du hast kein "+capitalize(text2)+"!\n");
      return 0;
    }

if (victim1==victim2)
  {
    write("Du kannst einen Gegenstand nicht mit sich selbst vergleichen.\n");
    return 1;
  }   
  //Wenn beides Waffen sind.
if( text1=victim1->QueryProp(P_WEAPON_TYPE)&& text2=victim2->QueryProp(P_WEAPON_TYPE) )
{
	say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		return 1;}
		
		this_player()->AddMoney(-200);
		write("Du zahlst 200 Muenzen.\n");
		say(TPN+" zahlt 200 Muenzen\n",TP);
  	write( BS("Trogurt vergleicht "+victim1->name(WEN)+" mit "+ victim2->name(WEM)+".\n") );
  

  

  //if ((suc=SpellSuccess(TP,sinfo)) <= 0)
    //return MISSERFOLG;
/*
  vname= victim->name();
  wname= waffe->name();*/

   
  switch( text1 )
  {
    case WT_SWORD    : text1="ein Schwert"; break;
    case WT_AXE      : text1="eine Axt"; break;
    case WT_CLUB     : text1="ein Knueppel"; break;
    case WT_SPEAR    : text1="ein Speer"; break;
    case WT_KNIFE    : text1="ein Messer"; break;
    case WT_WHIP     : text1="eine Peitsche"; break;
    case WT_CHAIN    : text1="ein Morgenstern"; break;
  }
  switch( text2 )
  {
    case WT_SWORD    : text2="ein Schwert"; break;
    case WT_AXE      : text2="eine Axt"; break;
    case WT_CLUB     : text2="ein Knueppel"; break;
    case WT_SPEAR    : text2="ein Speer"; break;
    case WT_KNIFE    : text2="ein Messer"; break;
    case WT_WHIP     : text2="eine Peitsche"; break;
    case WT_CHAIN    : text2="ein Morgenstern"; break;
  }

  // Waffentyp
  if( text1==text2)
    write("Beide Waffen sind "+text1+".\n");
  else 
    write(capitalize(victim1->name(WER,1))+" ist "+text1+", "+victim2->name(WER,1)+" hingegen ist "+text2+".\n");
  
  zahl1=victim1->QueryProp(P_NR_HANDS);
  zahl2=victim2->QueryProp(P_NR_HANDS);
  
  // Zweihaendig

  if( zahl1==zahl2)
  {
    if( zahl1==2 )
      write("Beide Waffen muessen mit zwei Haenden gefuehrt werden.\n");
    else
      write("Beide Waffen benoetigen nur eine Hand zum Fuehren.\n");
  } 
  
  else 
    {
    if( zahl1==2 )
      write(capitalize(victim1->name(WER,1))+" benoetigt beide Haende zum Fuehren, "+capitalize(victim2->name())+" nur eine.\n");
    else
      write(capitalize(victim2->name(WER,1))+" benoetigt nur eine Hand zum Fuehren, "+capitalize(victim1->name())+" beide.\n");
  }



  zahl1=victim1->QueryProp(P_WC) - victim2->QueryProp(P_WC);


  
  // Schaden zahl1= WC von Waffe 1 - WC von Waffe 2
  if( zahl1 < -150 )
    write(capitalize(victim1->name(WER,1))+" macht sehr viel weniger Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 > -150 ) 
    write(capitalize(victim1->name(WER,1))+" macht viel weniger Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 > -75 )  
    write(capitalize(victim1->name(WER,1))+" macht weniger Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 > -30 )  
    write(capitalize(victim1->name(WER,1))+" macht etwas weniger Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 >  0 )
    write(capitalize(victim1->name(WER,1))+" macht etwas mehr Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 >  30 )
    write(capitalize(victim1->name(WER,1))+" macht mehr Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 >  75 )
    write(capitalize(victim1->name(WER,1))+" macht viel mehr Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 >  150 )
    write(capitalize(victim1->name(WER,1))+" macht sehr viel mehr Schaden als "+victim2->name(WER,1)+".\n");
  else if( zahl1 == 0 )
    write(capitalize(victim1->name())+" macht genausoviel Schaden wie "+victim2->name(WER,1)+".\n");

  zahl1=victim1->QueryProp(P_QUALITY_DECAY);
  zahl2=victim2->QueryProp(P_QUALITY_DECAY);  

  
  // in der handliegen
  if( zahl1>zahl2)
    write(capitalize(victim1->name(WER,1))+" liegt besser in der Hand als "+victim2->name(WER,1)+".\n");
  else if( zahl1<zahl2)
    write(capitalize(victim1->name(WER,1))+" liegt schlechter in der Hand als "+victim2->name(WER,1)+".\n");
  else
    write( "Beide Waffen liegen gleich in der Hand. \n");
    
 // write(result);
  // Schadensart


  damtyp1=victim1->QueryProp(P_DAM_TYPE);
  damtyp2=victim2->QueryProp(P_DAM_TYPE);

  // filter nach nicht-physischen schaden
  damtyp1 -= m_indices(PHYSICAL_DAMAGE_TYPES);
  damtyp2 -= m_indices(PHYSICAL_DAMAGE_TYPES);
  if( !sizeof(damtyp1) && !sizeof(damtyp2) ) //Wenn beide nur koerperlichen Schaden machen
  {
    write("Beide Waffen verursachen nur koerperlichen Schaden.\n");
  } 
  
  else 
    {
    if( sizeof(damtyp1) > 1 && sizeof(damtyp2) > 1 )
      write("Beide Waffen verursachen aussergewoehnlichen Schaden.\n");
    
    else 
      {  
       write(capitalize(victim1->name(WER,1)));
      if( sizeof(damtyp1) > 1 )
        write (" verursacht aussergewoehnlichen Schaden\n");
      
      if( sizeof(damtyp1) == 1 )//wenn er genau einen unkoerperlichen Schaden macht
      {
        switch(damtyp1[0])
        {
          case DT_FIRE:     write (" Feuerschaden"); break;
          case DT_COLD:     write (" Kaelteschaden"); break;
          case DT_ELECTRIC: write (" schockartigen Schaden"); break;
          case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
          case DT_TERROR:   write (" Angst"); break;
          case DT_HOLY:     write (" heiligen Schaden"); break;
          case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
          default:          write (" besonderen Schaden"); break;
        }
      } else 
        write (" nur physischen Schaden, wohingegen "+victim2->name(WER,1));
      if( sizeof(damtyp2) > 1 )
        write(" aussergewoehnlichen Schaden");
      if( sizeof(damtyp2) == 1 )
      {
        switch(damtyp2[0])
        {
          case DT_FIRE:     write (" Feuerschaden"); break;
          case DT_COLD:     write (" Kaelteschaden"); break;
          case DT_ELECTRIC: write (" schockartigen Schaden"); break;
          case DT_ACID:     write (" Schaden der wie Saeure brennt"); break;
          case DT_TERROR:   write (" Angst"); break;
          case DT_HOLY:     write (" heiligen Schaden"); break;
          case DT_UNHOLY:   write (" fluchartigen Schaden"); break;
          default:          write (" besonderen Schaden"); break;
        }
      } else 
        write (" nur physischen Schaden verursacht.\n");
    }
    
  }
  zahl1=victim1->QueryProp(P_WC_FIX);
  zahl2=victim2->QueryProp(P_WC_FIX);


  // Abnutzung
  if( zahl1<zahl2 )
    write(capitalize(victim1->name(WER,1))+" nuetzt sich schneller ab als "+victim2->name(WER,1)+".\n");
  else if( zahl1>zahl2 )
    write(capitalize(victim1->name(WER,1))+" nuetzt sich langsamer ab als "+wname+".\n");
  else
    write ("Beide Waffen nutzen sich gleich schnell ab. \n");

//Gewicht
  zahl1=victim1->QueryProp(P_WEIGHT);
  zahl2=victim2->QueryProp(P_WEIGHT);
  
  if( zahl1<zahl2 )
    write(capitalize(victim1->name(WER,1))+" ist schwerer als "+victim2->name(WER,1)+".\n");
  else if( zahl1>zahl2 )
    write(capitalize(victim1->name(WER,1))+" ist leichter als "+wname+".\n");
  else
    write ("Beide Waffen wiegen ungefaehr gleich viel. \n");
 return 1;
 }
  
  
  //Wenn beides Ruestungen sind:
 else if( text1=victim1->QueryProp(P_ARMOUR_TYPE)&& text2=victim2->QueryProp(P_ARMOUR_TYPE) )
  {
   	say(TPN+" moechte etwas verglichen haben.\n",TP);
	
		if(this_player()->QueryMoney() < 200)
		{command("sag Ihr habt nicht genug Geld dabei, "+TPN+".");
		return 1;}
		
