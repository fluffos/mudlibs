    else if(zahl3>35)write(capitalize(victim1->name(WER,1))+" schuetzt unglaublich viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>30)write(capitalize(victim1->name(WER,1))+" schuetzt sehr viel besser als "+victim2->name(WER,1)+".\n");
    else if(zahl3>25)write(capitalize(victim1->name(WER,1))+" schuetzt viel besser als "+victim2->name(WER,1)+".\n");
