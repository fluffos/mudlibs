    write(capitalize(victim1->name(WER,1))+" ist vom Typ "+text1+", "+victim2->name(WER,1)+" gehoert zum Typ "+text2+".\n");
  
  
    //Gewicht
  zahl1=victim1->QueryProp(P_WEIGHT);
  zahl2=victim2->QueryProp(P_WEIGHT);
  
