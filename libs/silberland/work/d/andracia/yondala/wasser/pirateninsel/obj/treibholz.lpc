// Questitem fuer Schatzsuche

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Treibholz");
  SetProp(P_LONG,
    "Das Treibholz besteht aus altem Holz, das vom Meer angespuelt wurde." );
  SetProp(P_NAME, "Treibholz");
  SetProp(P_GENDER, NEUTER);
  AddId(({"treibholz", "holz", "treibgut"}));

  SetProp(P_MATERIAL, MAT_OAK );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  //SetProp(P_NODROP, "Das Treibholz brauchst Du vielleicht noch.\n");
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);

AddCmd( ({ "schnitz", "schnitze" }), "schnitzenCmd" );
}


int schnitzenCmd (string str)
{
	notify_fail("Was moechtest Du schnitzen?\n");
  if( str == "holzbein"||str=="bein")
{
	if(present("messer", TP)) 	
	{
	    write ("Du schnitzt an dem Stueck Treibholz herum bist es aussieht wie ein Holzbein.\n");
		say (TPN+" schnitzt ein Holzbein.\n");
	    CLONE(PIR_OBJ +"holzbein", TP);
        remove();
		
	}

	else write ("Du hast nichts bei Dir womit Du aus dem Treibholz ein Holzbein schnitzen koenntest!\n");
	return 1;
		
	
	}
	return 0;
}