// Yondala@Silberland 30.04.2010

// Auf einem Steg
// Hier sollte das Piratenschiff landen.
// Moeglicher FP auf Lutschen

#include "../def.h"
#include <moredef.h>

inherit "std/room";

#include <properties.h>

int bootda;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Anlegestelle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer kleinen Anlegestelle. Hier hat immer maximal "
    "ein Boot Platz. Das reicht aber auch, denn so beliebt ist diese Insel "
    "nicht. Nach oben kannst Du auf die Insel klettern. Im Westen siehst Du den Eingang "
    "zu einer Hoehle.\nEin kleines Schild wurde hier angebracht." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "anlegestelle" }),
    "Du befindest Dich auf einer kleinen Anlegestelle. Sie besteht aus Holzplanken, die "
    "auf, aus dem Wasser ragenden, Pfaehlen befestigt sind.");
  AddDetail( ({ "boot", "boote" }),
    "Die Boote verbinden die Insel mit dem Festland.");
  AddDetail( ({ "insel", "festland" }),
    "Du befindest Dich auf einer Insel.");
  AddDetail( ({ "schild" }),
    "Lies es!");
  AddDetail( ({ "platz" }),
    "Die Anlegestelle ist recht klein, der Platz reicht nur fuer ein Boot.");
  AddDetail( ({ "westen" }),
    "Im Westen siehst Du den Eingang zu einer Hoehle.");
  AddDetail( ({ "eingang" }),
    "Der Eingang liegt westlich von Dir.");
  AddDetail( ({ "hoehle", "ursprung", "ursprungs" }),
    "Die Hoehle scheint nicht natuerlichen Ursprungs zu sein. Du siehst "
    "Bearbeitungsspuren am Fels. Ausserdem scheint innen eine Lichtquelle zu sein.");
  AddDetail( ({ "bearbeitungsspuren","spuren" }),
    "Jemand scheint die Hoehle in den Fels geschlagen zu haben.");
  AddDetail( ({ "fels", "felsen" }),
    "Der Fels ist hart und rau. Im Bereich der Hoehle weisst er viele Bearbeitungsspuren auf.");
  AddDetail( ({ "lichtquelle", "lichtschein" }),
    "Ein Lichtschein flackert aus der Hoehle.");
  AddDetail( ({ "jemand" }),
    "Finde es heraus!");
  AddDetail( ({ "bereich" }),
    "Im Bereich der Hoehle weisst der Fels viele Bearbeitungsspuren auf.");
  AddDetail( ({ "holzplanken", "planken", "holzplanke" }),
    "Die Planken sind nicht gerade vertrauenserweckend. Du kannst durch sie hindurch "
    "das Wasser sehen.");
  AddDetail( ({ "wasser", "welle", "wellen" }),
    "Das Wasser schaeumt unter Dir und schlaegt rhythmisch gegen die Felsen.");
  AddDetail( ({ "pfaehlen", "pfaehle" }),
    "Die Pfaehle tragen die Anlegestelle. Allerdings fragst Du Dich, wie lange sie das "
    "noch machen, denn sie sehen sehr morsch aus und sind mit Algen und Muscheln ueberzogen.");
  AddDetail( ({ "muscheln" }),
    "Kleine weisse Muscheln zieren die Pfaehle.");
  AddDetail( ({ "algen" }),
    "Ob man an ihnen lutschen kann?");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzplanken.");
  AddDetail( ({ "ohren" }),
    "Puh... denk mal drueber nach: Kann man die eigenen Ohren sehen?");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau und die Sonne lacht auf Dich herunter.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");
  AddDetail( ({ "boot" }),
    "Es ist derzeit kein Boot zu sehen.");
  AddDetail( ({ "meer" }),
    "Du hast einen unverstellten Blick auf das freie Meer.");
  AddDetail( ({ "blick","anblick" }),
    "Ein herrlicher Anblick.");


  AddReadDetail( ({ "schild" }),
    " _____________________________\n"
    "|  Warnung an jeden Fremden,  |\n"
    "|  der sich hier ungefragt    |\n"
    "|  aufhaelt. Reist lieber     |\n"
    "|  sofort zurueck, Ihr seid   |\n"
    "|  hier nicht erwuenscht!     |\n"
    "|_____________________________|\n");

  AddSound( DEFAULT_SOUND,
    "Die Brandung droehnt in Deinen Ohren.");

  AddSound( ({ "brandung" }),
    "Die Wellen schlagen laut gegen die Felsen.");
  AddSound( ({ "moewe", "schrei" }),
    "Ab und zu hoerst Du den Schrei einer Moewe. Sehen kannst Du allerdings keine.");
  AddSound( ({ "felsen" }),
    "Die Felsen sind stumm.");
  AddSound( ({ "wellen" }),
    "Die Wellen klatschen immer wieder laut krachend gegen die Felsen.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist herrlich frisch.");

  AddSmell( ({ "luft" }),
    "Du atmest tief ein, herrlich.");

  AddRoomMessage( 
    ({"Eine besonders grosse Welle brandet gegen die Felsen.\n",
    	"Irgendwo kreischt eine Moewe.\n",
    	"Eine Holzplanke knarrt unter Dir.\n"}),30,"func");

  

 AddExit( "oben", PIR_ROOM + "pirateninsel_5f" );
 AddExit( "westen", PIR_ROOM + "pirateninsel_jannskneipe" );
 AddCmd( ({ "lutsch", "lutsche" }), "lutschenCmd" );


}

int lutschenCmd(string str)
  {
  	notify_fail( "Woran moechtest Du lutschen?\n" );
    if (str == "algen"|| str == "an algen"){
		write ("Du beugst Dich hinab und lutschst tatsaechlich an den "+
		       "Algen herum.\nBaeh, bist Du eklig!\n");
		say(TPN+" beugt sich hinab und lutscht ein paar Algen von den "+
		        "Pfaehlen der Anlegestelle. Dir wird schlecht.\n",TP);
		return 1;
	}
    return 0;
}
