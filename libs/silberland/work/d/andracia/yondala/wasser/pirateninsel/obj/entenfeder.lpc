#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Entenfeder");
  SetProp(P_LONG,
    "Du siehst eine gruenschimmernde Entenfeder." );
  SetProp(P_NAME, "Entenfeder");
  SetProp(P_GENDER, FEMALE);
  AddId(({"feder","entenfeder"}));
  SetProp(P_MATERIAL, MAT_FEATHER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);

}

