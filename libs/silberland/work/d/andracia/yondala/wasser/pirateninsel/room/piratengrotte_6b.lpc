#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Anlegestelle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer kleinen, scheinbar sehr alten "
    "Anlegestelle. Die Bretter sind nur noch lose miteinander "
    "verbunden und schwanken stark. Westlich von Dir ist eine "
    "Ausbuchtung der Hoehle, die jedoch in einer Kurve zu enden "
    "scheint. Ansonsten ist hier nur dunkles Wasser." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(PIR_NPC + "pirat_broud",REFRESH_DESTRUCT);

  AddDetail( ({ "anlegestelle" }),
    "Die Anlegestelle scheint sehr alt zu sein. Die Planken sehen sehr alt aus. Es "
    "scheint, als wuerde sie selten oder gar nicht mehr genutzt.");    
  AddDetail( ({ "bretter", "brettern" }),
    "Die Bretter, aus denen die Anlegestelle besteht sind nur noch lose miteinander "
    "verbunden. Die meisten Naegel sind scheinbar schon weggerostet. Zwischen den "
    "Brettern schwappt immer wieder etwas Wasser hindurch.");    
  AddDetail( ({ "naegel" }),
    "Die meisten Naegel sind schon vom Rost zerfressen. Die wenigen "
	"verbliebenen halten die Bretter norduerftig zusammen.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus wackeligen Brettern.");    
  AddDetail( ({ "wasser" }),
    "Das Wasser ist dunkel. Es befindet sich unter den Planken, schwappt aber auch ab und zu darauf.");    
  AddDetail( ({ "rost" }),
    "Der Rost hat die Naegel bald allesamt zerfressen.");    
  AddDetail( ({ "ausbuchtung" }),
    "Die Ausbuchtung ist sehr tief, sie scheint um eine Kurve zu gehen. Was da ist "
    "siehst Du nicht.");    
  AddDetail( ({ "kurve" }),
    "Du kannst nicht erkennen was hinter der Kurve ist. Allerdings scheint es dort etwas "
    "heller zu sein. Wo das Licht wohl herkommt?");    
  AddDetail( ({ "licht" }),
    "Du reckst und streckst Dich, kannst es aber nicht erkennen.");
   // hier soll mal noch irgendwie was hin. Mal sehen.    
  AddDetail( ({ "" }),
    "");    

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leises Klatschen vom Wasser, das gegen die Hoehlenwaende prallt.");

  AddSound( ({ "wasser","hoehlenwaende","klatschen" }),
    "Das Wasser fliesst in die Hoehle und wieder zurueck, dabei macht es ein leises Geraeusch, welches nicht weiter stoert.");
  AddSound( ({ "geraeusch" }),
    "Das stoert Dich nicht weiter.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht muffig.");


AddExit( "osten", PIR_ROOM + "piratengrotte_6c" ); 

}

