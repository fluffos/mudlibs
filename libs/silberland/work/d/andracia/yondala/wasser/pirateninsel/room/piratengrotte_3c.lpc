#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std.lpc";
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen, duesteren Grotte. Vor Dir liegt "
    "ein Steg, der hier ueber der Wasserflaeche angelegt wurde. Wenn Du nach "
    "Sueden gehst, betrittst Du ihn. Nach oben gelangst Du zurueck an die frische Luft. "
    "Aus dem Raum im Westen stroehmt penetranter Alkoholgeruch heraus."	);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "raum","westen" }),
    "Geh doch hinein, wenn Du wissen willst, was dort ist.");    
  AddDetail( ({ "alkoholgeruch" }),
    "Der Alkoholgeruch raubt Dir fast den Atem.");    
  AddDetail( ({ "atem" }),
    "Zum Glueck nur fast.");    
  AddDetail( ({ "glueck" }),
    "Da hast Du wirklich Glueck gehabt.");   
  AddDetail( ({ "sueden" }),
    "Suedlich von Dir beginnt der Steg.");   



  AddSmell( ({ "alkohol","alkoholgeruch","geruch" }),
    "Der Alkoholgeruch ist wirklich umwerfend.");

AddExit( "sueden", PIR_ROOM + "piratengrotte_4c" ); 
AddExit( "oben", PIR_ROOM + "pirateninsel_3c" ); 
AddExit( "westen", PIR_ROOM + "piratengrotte_3b" ); 

}

