//06.05. 2010 Yondala@Silberland
// Diese Salbe laesst Arme nachwachsen, wenn man 1 Arm hat kann man sie selbst auftragen, wenn man keinen Arm hat nicht.
// kaufbar bei der Alchemistin in Knargh


#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Salbentube");
  SetProp(P_LONG,
    "Du haelst eine kleine Tube in der Hand. Sie ist weiss und mit roter Schrift beschrieben" );
  SetProp(P_INFO,"Die Salbe kann auf eigene oder fremde Wunden, die durch den Verlust von Koerperteilen entstanden sind, aufgetragen werden.\n"+
  "Syntax: Trage Salbe auf Wunde von <person> auf");
  SetProp(P_NAME, "Salbentube");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  AddId(({"salbe","tube","salbentube"}));
  SetProp( P_MATERIAL, ([ MAT_FLESH : 5, MAT_SKIN: 5, MAT_BONE: 5, MAT_MISC_HERBAL: 20, MAT_MISC_DRUG: 20, MAT_MISC_MAGIC: 45  ]) );

  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 0);

 AddDetail( ({ "schrift" }),
    "Die Schrift ist leuchtend rot. Du kannst sie lesen.");

  AddReadDetail( ({ "schrift" }),
    "Unterstuetzt die Selbstheilungskraefte des Koerpers, schliesst Wunden und laesst Gliedmassen nachwachsen.");
  AddCmd( ({ "trage", "trag" }), "auftragencmd" );  

  }

  int auftragencmd(string str)
  {
     string wen, dummy;
	 object ob, zuheilender;
	 
	 notify_fail("Was moechtest Du worauf auftragen?\n");
	 if(!str) return 0;
	 if(sscanf(str, "salbe auf wunde von %s auf%s", wen, dummy)!=2) return 0;
	 if(wen=="pirat"&&present("PIRATARMAB",environment(TP)))
	   {
	     write("Der armselige Pirat sagt: Gebt mir bitte die Salbe!\n");
		 return 1;
	   }
	 if(wen==TPN||wen=="mir")
	   {
	     if(TP->QueryProp(P_MAX_HANDS)==2)
		    {
			   write("Du hast keine Wunden, die Du mit der Salbe behandeln koenntest.\n");
			   return 1;
			   }
	    else if(TP->QueryProp(P_MAX_HANDS)==0)
		    {
			   write("Wie willst Du denn ohne Arme die Salbe auf Deine Wunden auftragen? Da musst Du schon jemand anderen drum bitten.\n");
			   return 1;
			   }
		 
		ob=present("\narm_invis",TP);
		write("Du traegst die Salbe auf Deine Wunden auf.\nSofort spuerst Du eine deutliche Linderung.\n");
		say(TPN+" traegt eine Salbe auf "+TP->QueryPossPronoun(FEMALE,WEN, PLURAL)+" Wunden auf.\n",TP);
	    ob->auaweg();
		remove();
		return 1;
		}
	else if(zuheilender=present(wen, environment(TP)))
	{//anderen heilen
	   if(zuheilender->QueryProp(P_MAX_HANDS)==2)
	   {
	      write(zuheilender->name()+" hat keine Wunden, die Du mit der Salbe behandeln koenntest.\n");
	      return 1;
	   }
	   else
	   {
		write("Du traegst die Salbe auf "+zuheilender->name(WESSEN)+" Wunden auf.\n");
		tell_room(environment(TP),TPN+" traegt eine Salbe auf "+zuheilender->name(WESSEN)+" Wunden auf.\n",({TP,zuheilender}));
	   	tell_object(zuheilender,TPN+" traegt eine Salbe auf Deine Wunden auf.\nSofort spuerst Du eine deutliche Linderung.\n");
	   	ob=present("\narm_invis",zuheilender);
		ob->auaweg();
		remove();
		return 1;
		}

	   
	   
	
	
	
	}
		 
}
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
	 