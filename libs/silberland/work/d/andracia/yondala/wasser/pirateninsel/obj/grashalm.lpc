//Grashalm ruft manchmal eine Ente 
//Zaubertrank waere nett

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grashalm");
  SetProp(P_LONG,
    "Du siehst einen gruenen Grashalm. Er scheint relativ stabil zu sein. Irgendwie musst "
    "Du dabei an Deine Kindheit denken." );
  SetProp(P_INFO, "Es waere sicher lustig, auf ihm zu blasen.");
  SetProp(P_NAME, "Grashalm");
  SetProp(P_GENDER, MALE);
  AddId(({"halm", "grashalm"}));
  AddDetail( ({ "kindheit" }),
    "Was hat man damals noch mit einem Grashalm versucht?");

  SetProp(P_MATERIAL, MAT_STRAW);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
 	AddCmd(({"blase", "blas"}), "blasen"); 

}

void entekomm(object spieler)
{
	object ente;
	write("Du hast mit Deinem Gequietsche eine Ente angelockt.\n");
	say (TPN+" hat mit dem Gequietsche eine Ente angelockt.\n",TP);
	ente=clone_object(PIR_NPC+"ente");
	ente->move(environment(spieler),M_GO);
	ente->verfolger(spieler);
 
}
int blasen(string str)
{

	int passiert;
	passiert=random(10);
	
	notify_fail("Worauf moechtest Du blasen?\n");
	if(str=="auf grashalm"||str=="auf halm")
		{
			write ("Du klemmst den Grashalm zwischen Deine Finger und blaest kraeftig dagegen.\n"
			"Ein schreckliches Geraeusch entsteht.\n");
			say(TPN+" erzeugt ein schreckliches Geraeusch mit einem Grashalm.\n");
			//if(TP->FindPotion("Ploetzlich haelst Du einen kleinen Trank in Deinen Haenden.\n")) return 1;
	    		
			if(passiert==1)
				{
					call_out("entekomm",2,TP);
					}
			
			if (passiert>3)
				{
					write ("Der Grashalm reisst.\n");
					TO->remove();
				}
			return 1;
		}
	return 0;
}

			
	
	
	