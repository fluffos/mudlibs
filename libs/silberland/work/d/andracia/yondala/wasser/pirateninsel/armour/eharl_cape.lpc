//Dieser Umhang soll sehr gut schuetzen und hp hochsetzen, dafuer schnell kaputt gehen
// so und das funktioniert, auf Anhieb, beim ersten Versuch. Ich bin toll.
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gruenschillernder Umhang");
  SetProp(P_LONG,
    "Du siehst einen praechtigen Umhang der in allen vorstellbaren "+
	"Gruentoenen schillert." );
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "", ""}) );
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6 );
  SetProp(P_MATERIAL, ([ MAT_SILK: 70, MAT_MISC_MAGIC:30 ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);

SetProp(P_M_HEALTH_MOD,([P_HP:5, P_SP:0]));
  AddProp(P_DAM_PROTECTION, ([DT_FIRE, DT_HOLY]) );
  AddDetail( ({ "gruentoene","gruentoenen" }),
    "Alle, die Du Dir vorstellen kannst.");    


}


