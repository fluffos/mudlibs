//Hier haust Eharl mit seinen beiden Beschuetzern.
//Wenn Eharl tot ist, kann man einen Tresor oeffnen und erhaelt 5000-15000 Muenzen

#include "../def.h"
inherit "std/room";
#include <properties.h>
object ob;
int muenzen = 0;
int tresoroffen=0;
void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
void reset()
{
	::reset();
	if (tresoroffen==1)
		{
			tresoroffen = 0;
			tell_room(TO, "Die Tresortuer faellt zu.\n");
			AddDetail( ({ "tresor", "tresortuer" }),
    			"Die Tresortuer ist geschlossen.");   
      	    AddDetail( ({ "mitte", "schimmern" }),
    			"Es scheint ein Tresor zu sein. Er ist geschlossen.");  
    		RemoveDetail("hebel");
    	}  
     muenzen=random(10000)+5000;

}



void create() 
{
  ::create();
  muenzen=random(10000)+5000;
  SetProp( P_INT_SHORT, "In einem glitzernden Grottenraum" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem seltsamen Raum, der so gar nicht zu den anderen Raeumen "
    "dieser Insel passen will. Die Waende sind zwar auch aus Stein, allerdings scheinen "
    "die Waende von sich aus zu leuchten. An der Suedwand steht ein kleines Bett, die "
    "Westwand wird von einem grossen Tisch dominiert. An der Nordwand ist ein Fenster mit "
    "gebluemten Vorhaengen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "raum", "grottenraum" }),
    "Der Raum ist anders als die anderen Raeume in dieser Grotte.");    
  AddDetail( ({ "wand","waende" }),
    "Die Waende scheinen von sich aus zu leuchten.");    
  AddDetail( ({ "stein", "steine", "steinen" }),
    "Die Steine, aus denen Boden, Waende und Decke bestehen scheinen von sich aus zu leuchten.");    
  AddDetail( ({ "boden" }),
    "Auch der Boden schimmert und funkelt. Er ist allerdings glatter als die Waende und die Decke.");    
  AddDetail( ({ "decke" }),
    "Die Decke wurde in den Fels gehauen, sie funkelt mit den Waenden um die Wette.");    
  AddDetail( ({ "wette" }),
    "Wetten, dass Eharl Dir sagen kann, was es mit den funkelden Steinen auf sich hat?");    
  AddDetail( ({ "suedwand" }),
    "An der Suedwand steht ein kleines Bett.");    
  AddDetail( ({ "bett" }),
    "Das Bett ist so klein, dass nur jemand sehr kleines hier schlafen kann. Oder ein Kind.");    
  AddDetail( ({ "kind", "kinder" }),
    "Wo Du jetzt so drueber nachdenkst: Kinder scheint es auf dieser Insel keine zu geben.");    
  AddDetail( ({ "westwand" }),
    "An der Westwand steht ein grosser, aufgeraeumter Schreibtisch.");    
  AddDetail( ({ "tisch","schreibtisch" }),
    "Der Schreibtisch ist im Verhaeltnis zum Bett ueberproportional groesser. Ausserdem "
    "ist er sehr sauber und ordentlich, es liegt nur eine Feder exakt parallel zu einem "
    "Tintenfaesschen da.");    
  AddDetail( ({ "verhaeltnis" }),
    "Na, der Tisch ist halt \"normal\" gross, das Bett jedoch sehr klein.");    
  AddDetail( ({ "feder", "tintenfaesschen" }),
    "Damit notiert Eharl seine Geschaefte.");    
  AddDetail( ({ "geschaeft","geschaefte" }),
    "Frag Eharl doch einfach danach.");    
  AddDetail( ({ "fenster", "nordwand" }),
    "Beim genauerem Hinsehen erkennst du, dass es sich dabei nicht wirklich um ein "
    "Fenster handelt. Es ist wohl ein Holzrahmen, an dem rechts und links Vorhaenge "
    "haengen. In der Mitte schimmert es himmelblau.");    
  AddDetail( ({ "holzrahmen", "hinsehen" }),
    "Der Holzrahmen sieht einem Fenster ziehmlich aehnlich. Das soll wohl so sein.");    
  AddDetail( ({ "vorhaenge", "vorhaengen" }),
    "Sie sind rosaweiss gebluemt. Nunja. Muss ja nicht jedem gefallen.");    
  AddDetail( ({ "mitte", "schimmern" }),
    "Es scheint ein Tresor zu sein. Er ist geschlossen.");    
  AddDetail( ({ "fels" }),
    "Der Fels glitzert und funkelt.");    
  AddDetail( ({ "grotte" }),
    "Aus der Grotte bist Du hereingekommen.");    
  AddDetail( ({ "insel" }),
    "Du befindest Dich in einer Grotte unter einer Insel.");    
  AddDetail( ({ "raeume","raeumen" }),
    "Hier sieht es anders aus als in den anderen Raeumen.");    
  AddDetail( ({ "tresor", "tresortuer" }),
    "Die Tresortuer ist geschlossen.");    


  AddDetail( ({ "wand", "waende", "licht" }),
    "An den Waenden sind Fackeln angebracht, die ein schummriges Licht verbreiten.");
  AddDetail( ({ "fackeln" }),
    "Die Fackeln verbreiten ein schumriges Licht. Sie sind fest in der Wand verankert.");    
  AddDetail( ({ "ostwand" }),
    "An dieser Wand ist nichts ausser einer Tuer.");    
  AddDetail( ({ "tuer" }),
    "durch diese Tuer bist Du gekommen.");    
  AddDetail( ({ "eharl" }),
    "Der ist wohl gerade nicht hier.");    
 AddDetail( ({ "" }),
    "");    
 AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Hier ist es absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht irgendwie sauber.");

  AddSmell( ({ "" }),
    "");




AddItem(PIR_NPC + "pirat_eharl",REFRESH_DESTRUCT);
AddItem(PIR_NPC + "pirat_beschuetzer",REFRESH_DESTRUCT);
AddItem(PIR_NPC + "pirat_beschuetzer",REFRESH_DESTRUCT);
AddCmd( ({ "oeffne" }), "oeffnen" );
AddCmd( ({ "ziehe","zieh" }), "ziehen" );

AddExit( "osten", PIR_ROOM + "piratengrotte_4c" ); 

}


int	oeffnen(string str)
{
	notify_fail("Was moechtest Du oeffnen?\n");
	if (str=="tresor"||str=="tresortuer")
		{
			if (present("eharl", environment(TP)))
				{
					write("Eharl haut Dir auf die Finger.\n");
					say("Eharl haut "+TPN+" auf die Finger.\n",TP);
					return 1;
				}
			else //Wenn Eharl nicht da ist
				{
					if (tresoroffen==1)
                       {
						 write("Der Tresor ist doch schon offen.\n");
						 return 1;
						}
					else
						{
							write("Du oeffnest den Tresor.\n");
							say(TPN+" oeffnet den Tresor.\n",TP);
						    AddDetail( ({ "mitte", "schimmern" }),
    							"Es scheint ein Tresor zu sein. Er ist geoeffnet.");    
							AddDetail( ({ "tresor", "tresortuer" }),
    							"Die Tresortuer ist geoeffnet. Im Tresor siehst Du nur einen Hebel.");   
							AddDetail( ({ "hebel" }),
    							"Du koenntest ihn ziehen.");   
    						tresoroffen=1;
							return 1;
									
						}
				}
		}
	return 0;
	}
					

int ziehen(string str)
{
	if (tresoroffen==0)
		return 0;
		
	notify_fail("Was moechtest Du ziehen?\n");
	if (str=="hebel")
		{
		  if(muenzen)
		  {
			write("Du ziehst an dem Hebel, ploetzlich oeffnet sich ueber Dir eine Luke und einige Muenzen fallen herunter.\n");
			say(TPN+" zieht an dem Hebel, ploetzlich oeffnet sich ueber Dir eine Luke und einige Muenzen fallen herunter.\n",TP);
			  ob = clone_object("/obj/money");
  			ob->SetProp(P_AMOUNT, muenzen);
  			ob->move(TO, M_SILENT);
  			muenzen =0;
				tell_room(TO, "Die Luke schliess sich wieder und passt sich nahtlos an die Decke an.\n");
  			//say("Die Luke schliesst sich wieder.\n");
			}
		else
		{
			write("Du ziehst an dem Hebel.\nNichts passiert.\n");
			say(TPN+" zieht an dem Hebel.\nNichts passiert.\n",TP);
			}

  			return 1;
  		}
 return 0;
 }
 
 
 
 void mehrmuenzen(int anzahl)
 {
 	muenzen += anzahl/2;
 }
 
 
 void tuerzu()
 {
 	RemoveExit("osten");
 	  AddDetail( ({ "tuer" }),
    "durch diese Tuer bist Du gekommen, sie ist magisch verriegelt.");    

 	}
 	
void tuerauf()
{
	AddExit( "osten", PIR_ROOM + "piratengrotte_4c" ); 
  AddDetail( ({ "tuer" }),
    "durch diese Tuer bist Du gekommen.");    
	}