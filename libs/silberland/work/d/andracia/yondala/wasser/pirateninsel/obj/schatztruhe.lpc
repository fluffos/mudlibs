//Die Schatztruhe

#include "../def.h"
inherit "std/thing";
#include <properties.h>

string loesung;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Schatztruhe");
  SetProp(P_LONG,
    "Du sieht eine grosse, hoelzerne Schatztruhe. Sie sieht sehr alt und morsch aus, scheint "
    "zu, aber nicht verschlossen zu sein." );
  SetProp(P_NAME, "Schatztruhe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"truhe", "schatztruhe"}));

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 80000);
//  SetProp(P_NOGET, 1);


AddCmd( ({ "oeffne" }), "oeffnenCmd" );
}



oeffnenCmd(string str)
  { 	notify_fail( "Was moechtest Du oeffnen?\n" );
  if (str == "truhe"||str=="schatztruhe")
  	{write ("Du oeffnest die Schatztruhe. Leider bist Du dabei nicht vorsichtig "
  		"genug und die Schatztruhe zerfaellt zu Staub.\nDu nimmst den Inhalt schnell an Dich.\n");}
	say (TPN+" oeffnet die Schatztruhe. Leider zerfaellt diese dabei zu Staub.\n");
TP->AddMoney(1000);
      this_object()->remove();
      return 1;
	}