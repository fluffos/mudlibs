// Yondala@Silberland 27.04.2010
// Uebergang von Duenen in Felsen
// Hier mal schnell die Idee fuer einen anderen Raum:
// Bemalte Felswaende, so wie von Neandertalern oder Aborigines
#include "../def.h"

inherit "std/room";

#include <properties.h>


void reset()
{
 ::reset();
    if(GetDetail("holz")=="Etwas trockenes Holz liegt in der Mitte "+
	                      "des Steinkreises.") 
	  return; //wenn da nur Holz liegt, das nicht brennt, kann alles bleiben
	  
	if(GetDetail("holz"))
  tell_room(TO,"Das Feuer erlischt.\n");	
  RemoveDetail("holz");	  
  AddDetail( ({ "kreis","steinkreis" }),
    "Was mag dieser Steinkreis bedeuten? Der Boden in der Mitte des "
	"Steines ist schwarz, ausserdem liegt dort ein wenig Asche.");
  AddDetail( ({ "asche" }),
    "Du vermutest, dass dort jemand ein Feuer entzuendet haben muss.");
  AddDetail( ({ "feuer" }),
    "Das ist aber schon lange her, die Asche ist kalt und schon fast komplett "
	"verweht.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_DESERT]) );
  
	}

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen Klippen und Duenen" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_DESERT]) );

 SetProp( P_INT_LONG,
    "Du befindest Dich genau auf dem Uebergang von Klippen zu den Duenen. Der Boden unter "
    "Deinen Fuessen ist sandig, doch immer wieder liegen grosse Steine dazwischen. Du "
    "solltest aufpassen, dass Du nicht umknickst. Das Laufen hier ist recht muehsam, da "
    "Du immer wieder einsinkst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen wurden. Sie liegen suedlich von Dir.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft salzig.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
  AddDetail( ({ "grasbueschel" }),
    "Das Gras waechst hier nur sehr spaerlich.");
  AddDetail( ({ "gras" }),
    "Nur sehr wenige Halme halten sich hier.");
  AddDetail( ({ "halme" }),
    "Die meisten Halme sind graeulich und trocken.");
  AddDetail( ({ "laufen" }),
    "Du schleppst Dich muehsam durch den Sand.");
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden" }),
    "Auf dem sandigen Boden liegen einige Steine zu einem Kreis. Da rum "
	"sind nur ein paar Grasbueschel zu sehen, sonst ist hier nichts.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "klippen", "felsgestein","gestein" }),
    "Die Klippen bestehen aus hartem teilweise moosbewachsenem Fels. Sie "
	"liegen noerdlich von Dir.");
  AddDetail( ({ "fels" }),
    "Harter Stein.");
  AddDetail( ({ "stein","steine" }),
    "Die Steine liegen vereinzelt im Sand. Wenige von Ihnen wurden zu "
	"einem Kreis zusammengefuegt.");
  AddDetail( ({ "uebergang" }),
    "Hier gehen die Duenen in Felsgestein ueber.");
  AddDetail( ({ "fuesse" }),
    "Du stehst mit beiden Fuessen fest auf dem Boden.");
  AddDetail( ({ "kreis","steinkreis" }),
    "Was mag dieser Steinkreis bedeuten? Der Boden in der Mitte des "
	"Steines ist schwarz, ausserdem liegt dort ein wenig Asche.");
  AddDetail( ({ "mitte" }),
    "Der Boden in der Mitte des Steinkreises ist schwarz.");
  AddDetail( ({ "asche" }),
    "Du vermutest, dass dort jemand ein Feuer entzuendet haben muss.");
  AddDetail( ({ "feuer" }),
    "Das ist aber schon lange her, die Asche ist kalt schon fast komplett "
	"verweht.");
  AddDetail( ({ "moos" }),
    "Ueberall, wo es sich halten kann, hat sich Moos auf den Steinen gebildet.");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Du kannst das Meer rauschen hoeren. Es scheint also nicht weit entfernt zu sein.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  

 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_4a" );
 AddExit( "sueden", PIR_ROOM + "pirateninsel_6b" );
 AddCmd(({"entzuende","entzuend"}),"feuerentzuenden");
 AddCmd(({"lege","leg"}),"holzlegen");
 

}

int holzlegen(string str)
{
  notify_fail("Was moechstest Du wohin legen?\n");
  if(str!="holz in steinkreis"&&str!="holz in kreis"&&
     str!="trockenes holz in steinkreis"&&str!="trockenes holz in kreis")
	 return 0;
  if(!present("trockenes holz",TP))
  {
  write("Du hast kein geeignetes Holz dabei.\n");
  return 1;
  }
    if(GetDetail("holz")=="Etwas trockenes Holz liegt in der Mitte des Steinkreises.\n")
	{write("Es liegt schon Holz in dem Steinkreis.\n");
	return 1;}
	
	write("Du legst das trockene Holz in die Mitte des Steinkreises.\n");
  present("trockenes holz",TP)->remove();
  AddDetail( ({ "holz" }),
      "Etwas trockenes Holz liegt in der Mitte des Steinkreises.");
  AddDetail( ({ "kreis","steinkreis" }),
    "Was mag dieser Steinkreis bedeuten? Der Boden in der Mitte des "
	"Steines ist schwarz, ausserdem liegt dort ein wenig trockenes Holz.");
  return 1;
  }
	 

int feuerentzuenden(string str)
{
  notify_fail("Was moechtest Du entzuenden?\n");
  if(str!="feuer") return 0;
  if(GetDetail("feuer")=="Das ist aber schon lange her, die Asche ist "+
                         "kalt schon fast komplett verweht.\n")
  { 
    write("Du muesstest erst etwas trockenes Holz in den Steinkreis legen.\n");
  }
  if(GetDetail("feuer")=="Ein waermendes Feuer flackert lustig in dem "+
                         "Steinkreis.\n")
  {
    write("Das Feuer brennt doch schon");
    return 1;
	}
	
  if(GetDetail("holz"))
  {
    if(TP->QueryProp(P_SP)<5)
    {write("Du hast nicht genuegend Magiepunkte zum Anzuenden.\n");
    return 1;}
   	
	TP->AddSp(-5);
    write("Mit einem kleinen Feuerball zuendest Du das Feuer an.\n");
	say(TPN+"zuendet das Feuer mit einem kleinen Feuerball an.\n",TP);
    AddDetail( ({ "kreis","steinkreis" }),
      "Mitten im Steinkreis brennt ein Feuer.");
    AddDetail( ({ "feuer" }),
      "Ein waermendes Feuer flackert lustig in dem Steinkreis.");
    AddDetail( ({ "holz" }),
      "Das Holz brennt.");
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_DESERT]) );
    return 1;
  }
  return 0;
 }
  
  
  
  
  
  
  
  
  