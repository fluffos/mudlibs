// Kann nicht getoetet werden, wenn Eharl da ist und nicht kaempft
// kann nur bei jedem 5. Versuch getoetet werden, wenn Eharl da ist.

// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 24.04.2010

inherit "std/npc";

#include <properties.h>
#include <combat.h>
//#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <moredef.h>


init()
{
  ::init();
  if (this_player() && this_player()->id("schwarzgeldler")) 
    AddDefender(this_player());
}


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eharls Beschuetzer");
  SetProp(P_LONG,
    "Du siehst ein grosses Wesen vor Dir, welches Dich aus trueben Augen dumm "
    "anglotzt. Es gehoert zu keiner Dir bekannten Rasse und Du kannst es nicht "
    "einordnen. Irgendwie scheint es weggetreten zu sein. Sein haariger Koerper "
    "ist nackt bis auf einen silbernen Panzer.");
  SetProp(P_NAME, "Beschuetzer");
  SetProp(P_GENDER, MALE);
  AddId(({"beschuetzer", "pirat", "schwarzgeldler"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(30);
    SetProp(P_HANDS, ({" mit seinen grossen, haarigen Haenden", 150, DT_BLUDGEON}) );

//  SetProp(P_HANDS, ({" mit seinen grossen Haenden",QueryProp(P_HANDS)[10],DT_BLUDGEON}));
  SetProp(P_RACE, "Ogerbaer");
  SetProp(P_SIZE, 270);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_COLD:      -0.5,  DT_TERROR: -1.0,
      DT_HOLY:      0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  0.0, DT_MIND:   -1.0]) );

	SetProp(P_DEFENDERS, (({"eharl", "beschuetzer"})));
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht zu Boden.\n");
  SetProp(P_MURDER_MSG, "Ich tot!");
  SetProp(P_KILL_NAME, "Ein Beschuetzer Eharls");
  SetProp(P_KILL_MSG, "Du nicht greifen Meister an!");

  AddInfo(DEFAULT_INFO, "glotzt Dich dumm an.\n");

  
	SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE,30);

      AddSpell(2,400,
              "Der Beschuetzer beisst Dich.\n",
              "Der Beschuetzer beisst @WEN.\n",
              ({DT_PIERCE,DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]) );
     AddSpell(2,800,
              "Der Beschuetzer rammt Dir seine Faust in den Bauch.\n",
              "Der Beschuetzer rammt @WEN seine Faust in den Bauch.\n",
              ({DT_BLUDGEON,}), ([SP_SHOW_DAMAGE:1]) );

     AddSpell(1,500,
              "Der Beschuetzer bruellt Dich an, dass Dir hoeren und sehen vergeht.\n",
              "Der Beschuetzer bruellt @WEN an.\n",
              ({DT_SOUND, DT_AIR}), "blind", ([SP_SHOW_DAMAGE:1]) );


 
//   SetAttackChats(10, ({
//    ".\n"}) );

  SUID;
  CLONEME(PIR_ARMOUR "beschuetzer_panzer" );
  CLONEME(PIR_ARMOUR "donnerhelm" );
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
}

     void blind(object enemy, int damage, mixed dam_type) 
     {
       enemy->SetProp(P_BLIND, 3+random(3));
       enemy->SetProp(P_DEAF, 3+random(3));
     }
     
     
void InformDefend(object enemy)
{
 Kill(enemy);
}

void die()
{ object heiler;
  if (present("eharl", environment(TO)))//heiler definieren
  {
    heiler=present("eharl", environment(TO));
    tell_room(environment(TO),"Der Ogerbaer faellt auf die Knie.\nDer Ogerbaer bruellt: Heile mich, Meister!\n");
	if(heiler->InFight())//(present("eharl",environment(TO)->InFight()))
	{
	   if(random(5)==0)
	   {
	     tell_room(environment(TO),"Eharl schafft es nicht, seinen Beschuetzer zu heilen.\n");
	     ::die();
	     return;
	   }
	tell_room(environment(TO),"Eharl heilt seinen Beschuetzer.\n");
	SetProp(P_HP,QueryProp(P_MAX_HP)/2);
	return;	   
	}
	tell_room(environment(TO),"Eharl heilt seinen Beschuetzer vollstaendig.\n");
	SetProp(P_HP,QueryProp(P_MAX_HP));
	return;
	}
	::die();
}
	  
	