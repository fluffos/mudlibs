//Broud, ehem. Sklaventreiber von Drako, nun Sklavenhaendler.
//Piraten sollen spaeter bei ihm Sklaven kaufen koennen

//Er haelt Hildgunde gefangen, weil deren Vater ihm was gestohlen hat. Er gibt den Schluessel 
//fuer Hildgundes Ketten, wenn man ihm das goldene Herz gibt.


#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <moredef.h>

#include <npc.h>
inherit PIR_NPC + "pirat_std.lpc";
inherit "/std/npc/spells";

object *aergerer;
void create() {
  if (!is_clone(TO)) return;
  ::create();
  aergerer=({});
  SetProp(P_SHORT, "Broud, der Sklavenhaendler");
  SetProp(P_LONG,
    "Broud ist ein grosser, schwerer Mann, der Ork und Mensch in sich vereint. Er hat ein "
    "grobes Gesicht mit einer sehr breiten Nase und dichten Augenbrauen. Seine Haut ist "
    "braun und scheint von Wind und Wetter gegerbt worden zu sein. Er traegt ein dickes "
    "rotes Wams und eine weite weisse Hose.");
  SetProp(P_NAME, "Broud");
  SetProp(P_GENDER, MALE);
  AddId(({"broud", "sklavenhaendler", "mann", "ork","\n_broud"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Halbork");
  SetProp(P_SIZE, 199);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_HOLY:      0.5, DT_MAGIC:  0.5]) );

  SetProp(P_MSGIN, "stampft herbei");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Broud der Sklavenhaendler");
  SetProp(P_KILL_MSG, "Schade, lebendig waert Ihr mir lieber gewesen.");

  AddInfo(DEFAULT_INFO, "sagt: Schert Euch fort, mit Euren Fragen!\n");

  AddInfo( ({"yondala","yason","aginor" }),
    "Pah, Adelspack.",
    "sagt: ");

  AddInfo( ({"sklaven"}),
    "Ich habe gerade nur eine Sklavin.",
    "sagt: ");
  AddInfo( ({"sklavin"}),
    "Hildgunde ist meine einzige Sklavin im Moment. Sie dient mir und meinen Kameraden. "
    "Ich wuerde sie nie verkaufen.",
    "sagt: ");
  AddInfo( ({"gold"}),
    "Es gibt nichts begehrenswerteres als Gold, findet Ihr nicht auch?",
    "sagt: ");
  AddInfo( ({"hildgunde"}),
    "Hildgunde ist meine Sklavin.",// und meine Geisel.",
    "sagt: ");
  AddInfo( ({"schluessel"}),
    "Ich besitze den einzigen Schluessel fuer das Schloss an Hildgundes Ketten. Ich wuerde ihn "+
    "ausser fuer mein goldenes Herz fuer nichts auf der Welt tauschen.",
    "sagt: ");
  AddInfo( ({"herz"}),
    "Hildgundes Vater hat es mir gestohlen. Ich will es zurueck.",
    "sagt: ");
  AddInfo( ({"hildgundes vater"}),
    "Ein elender Dieb ist er. Und ein Dummkopf noch dazu. Mich zu bestehlen war das duemmste, was er tun konnte. Nun habe ich seine Tochter.",
    "sagt: ");
  AddInfo( ({"dummkopf"}),
    "Dieser Dummkopf meinte, dass er ungeschoren davon kaeme, wenn er mir mein wertvollstes nimmt.",
    "sagt: ");
  AddInfo( ({"wertvollstes"}),
    "Das wertvollste, was ich besass, war mein goldenes Herz. Bringt es mir und ihr sollt dafuer belohnt werden!",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({""}),
    ".",
    "sagt: ");
  AddInfo( ({"ketten"}),
    "Ketten sichern mir meinen Besitz.",
    "sagt: ");
  AddInfo( ({"besitz"}),
    "Viel besitze ich nicht, drum sichere ich das, was ich habe.",
    "sagt: ");
  AddInfo( ({"welt"}),
    "Ihr wisst schon, wie diese Welt heisst.",
    "sagt: ");
  AddInfo( ({"festland"}),
    "Dort kommt Ihr vermutlich her. Ihr koennt mit dem Schiff dorthin zurueckkehren.",
    "sagt: ");
  AddInfo( ({"schiff"}),
    "Ich habe kein Schiff.",
    "sagt: ");
  AddInfo( ({"lacnaia"}),
    "Die Lacnaia ist untergegangen.",
    "sagt: ");
  AddInfo( ({"schloss"}),
    "Ich habe Hildgunde Ketten angelegt und diese mit einem Schloss gesichert.",
    "sagt: ");

   //SetProp(P_LOG_INFO, "yondala");

	AddSpell(1,600,
              "Broud reisst Dir fast die Haut vom Leib.\n",
              "Broud reisst @WEM fast die Haut vom Leib.\n",
              (DT_AIR),  ([SP_SHOW_DAMAGE:1]) );
			  
	 AddDefaultSpell(1, 550, DS_MASS_DAMAGE, "Broud laesst seine Peitsche durch den Raum zischen.\n",
	                                         "Broud laesst seine Peitsche durch den Raum zischen.\n");
	 AddDefaultSpell(1, 550, DS_SLOW, "Broud wickelt seine Peitsche um Deinen Hals.\ndDu bekommst kaum noch Luft.\n",
	                                  "Broud wickelt seine Peitsche um @WESSEN Hals\n");


  SUID;
  CLONEME(PIR_WEAPON +"piratenpeitsche" );
  command("zuecke peitsche");
  CLONEME("/p/armour/boots/lederschuhe");
  CLONEME(PIR_ARMOUR +"broudwams" );
  CLONEME(PIR_ARMOUR +"broudhose" );
  command("trage alles");
}

// Mitloggen wenn einen Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }
void geaergert(object spieler)
{
  if (member(aergerer, spieler)!=-1)
     {
       command("sag Nun reicht es mir mit Euch, "+spieler->name()+"!");
       Attack(spieler);
       } 
     else
     {command("sag Mich koennt Ihr nicht provozieren, "+spieler->name()+".");
       aergerer=aergerer+({spieler});}
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht Dich schallend aus.",
        "lacht "+TP->name(WEN)+" schallend aus.");
      break;
    case "aergerlich":
	    call_out("geaergert", 0, TP);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TP->name(WEN)+" nicht.");
      break;
    case "fies":
      call_out("geaergert", 0, TP);
      break;
    case "frech":
      call_out("geaergert", 0, TP);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "grunzt gelangweilt etwas unverstaendliches.", 
        "grunzt gelangweilt etwas unverstaendliches.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "wehrt Dich ab: Dafuer habe ich Hildgunde.",
        "wehrt "+TP->name(WEN)+" ab: Dafuer habe ich Hildgunde.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "herrscht Dich an: Das koennt Ihr euch sparen!",
        "herrscht "+TP->name(WEN)+" an: Das koennt Ihr Euch sparen!");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dir ins Gesicht.",
        "lacht "+TP->name(WEM)+" ins Gesicht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void give_notify(object ob)
 {
 	if(ob->id("goldherz")&&TP->QueryQuest("Befreie Hildgunde")==0)
 		{
 			command("sag Ah, endlich, mein Herz!");
 			command("sag So sei es denn, hier habt Ihr als Dank den Schluessel, Hildgunde ist eh kaum mehr brauchbar fuer mich.");
 			write("Broud gibt Dir einen Schluessel.\n");
 			say("Broud gibt "+TPN+" einen Schluessel.\n",TP);
 			CLONE(PIR_OBJ +"hildgundeschluessel", TP);
 			ob->remove();
 		}
    else
      {             
        command("sag Was soll ich damit?");
        ob->move(TP, M_GET);
      }
    }
