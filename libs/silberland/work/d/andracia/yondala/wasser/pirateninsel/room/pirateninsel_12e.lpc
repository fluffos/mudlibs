#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Insel" );
  SetProp( P_INT_LONG,  "Du befindest Dich auf einer kleinen Insel. "
  "Hier ist es allerdings nicht so schoen wie auf der Pirateninsel, "
  "denn es gibt weder Sandstrand noch Palmen, sondern nur hartes Gestein. "
  "Nordwestlich von Dir siehst Du eine Erhebung." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer kargen, steinigen Insel.");

  AddDetail( ({ "pirateninsel" }),
    "Im Norden kannst Du in einer Entfernung die Pirateninsel erkennen.");
  AddDetail( ({ "entfernung" }),
    "Weit weg halt.");
  AddDetail( ({ "sandstrand" }),
    "Den gibt es hier leider nicht und Du denkst wehmuetig an den warmen weichen Sand der Pirateninsel.");
  AddDetail( ({ "sand" }),
    "Sand besteht aus ganz vielen winzigkleinen Steinen.");
  AddDetail( ({ "steine", "steinen" }),
    "Hier gibt es nichts ausser hartem Gestein.");
  AddDetail( ({ "gestein" }),
    "Das Gestein ist hart, kalt und schwarz.");
  AddDetail( ({ "palmen" }),
    "Hier gibt es leider keine Palmen. Eigentlich gibt es hier fast nichts.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hartem Gestein.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau. Die Sonne scheint.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "erhebung" }),
    "Es scheint sich dabei um einen Vulkan zu handeln.");
  AddDetail( ({ "vulkan" }),
    "Um sicher zu sein muesstest Du hingehen.");
  AddDetail( ({ "wellen" }),
    "Die Wellen schlagen rhythmisch gegen das Gestein.");
  AddDetail( ({ "moewen" }),
    "Du kannst keine Moewen sehen, nur hoeren.");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");
  AddDetail( ({ "" }),
    ".");

  AddSound( DEFAULT_SOUND,
    "Du hoerst die Wellen gegen die Insel schlagen und vereinzelt ein paar schreiende Moewen.");

  AddSound( ({ "wellen" }),
    "Die Wellen schlagen rhythmisch gegen die Insel. Etwas ermuedend.");
  AddSound( ({ "moewen" }),
    "Die Moewen kreischen laut, doch sehen kannst Du sie nicht.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Schwefel.");


  AddSmell( ({ "schwefel","geruch" }),
    "Schwefel riecht nicht sehr angenehm, ausserdem laesst dieser Geruch nichts Gutes verheissen.");

  AddRoomMessage( 
    ({""}),30,"func");

  
 AddExit( "nordwesten", PIR_ROOM + "pirateninsel_11d" );
 

}


