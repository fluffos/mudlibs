#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std.lpc";
#include <properties.h>

void create() 
{
  ::create();
   SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) +"Nach Norden gelangst Du zum Ausgang der Grotte, "
    "oestlich von Dir steht eine kleine Schmiede, die Du betreten kannst.") ;
  AddItem(PIR_NPC + "pirat_normalo",REFRESH_DESTRUCT);

  AddDetail( ({ "ausgang", "norden" }),
    "Im Norden kannst Du die Grotte verlassen.");    
  AddDetail( ({ "schmiede" }),
    "Du kannst sie betreten.");    
  AddDetail( ({ "" }),
    "");    

AddExit( "norden", PIR_ROOM + "piratengrotte_3e" ); 
AddExit( "sueden", PIR_ROOM + "piratengrotte_5e" ); 
AddExit( "osten", PIR_ROOM + "piratengrotte_4f" ); 


}

