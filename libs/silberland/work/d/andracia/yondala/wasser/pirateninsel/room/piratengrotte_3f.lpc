// Der Piraten Laden
inherit "std/laden";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <laden.h>
#include <moving.h>

void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
create(){
::create();

SetProp(P_LIGHT, 1 );
SetProp(P_INDOORS, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10, ENV_TERRAIN:TT_CAVE]) );

SetProp( P_INT_SHORT, "Ein kleiner Laden" );
SetProp( P_INT_LONG,
"Du befindest Dich in einem kleinen, vollgestopften Laden. Nur mit Muehe "
"erkennst Du einen kleinen Ladentisch mit einer sehr alten Kassentruhe "
"hinter all dem Kram, der hier angeboten wird. Die Luft ist stickig.");

SetStorageRoom(PIR_ROOM + "lagerladen");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "PIET");
  SetProp(P_SHOPKEEPER_NAME, "Piet");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "laden", "raum" }),
    "Du befindest Dich in einem kleinen Laden, der bis unter die Decke mit allerhand Zeug "
    "vollgestellt ist.");    
  AddDetail( ({ "decke", "stein" }),
    "Die Decke, so wie Waende und Boden, bestehen aus Stein.");    
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen auch in diesem Raum aus Stein. Nimmst Du zumindest an, denn bei "
    "all den vielen Waren hier sind die Waende kaum zu sehen.");    
  AddDetail( ({ "muehe" }),
    "Mit Muehe erkennst Du zwischen all den Waren einen kleinen Ladentisch.");    
  AddDetail( ({ "ladentisch", "ladentischs", "tisch" }),
    "Mitten zwischen den Waren erkennst Du einen kleinen Ladentisch. Er sieht aus, als "
    "sei er nur behelfsmaessig zusammengezimmert worden. Aber die relativ glatte "
    "Oberflaeche laesst darauf schliessen, dass hier einige Geschaefte abgeschlossen "
    "werden. Auf dem Tisch steht eine kleine Truhe.");    
  AddDetail( ({ "oberflaeche", "geschaefte" }),
    "Die Oberflaeche des Ladentischs ist so blank poliert, dass man annehmen kann, dass "
    "oft Waren auf ihr hin und her geschoben werden.");    
  AddDetail( ({ "truhe","kasse","kassentruhe" }),
    "In dieser Kassentruhe bewahrt Piet seine Muenzen auf.");    
  AddDetail( ({ "piet" }),
    "Piet gehoert dieser Laden.");    
  AddDetail( ({ "luft" }),
    "Die Luft hier ist sehr stickig. Was verstaendlich ist, denn man kann hier unten nur "
    "schlecht lueften.");    
  AddDetail( ({ "waren", "zeug", "kram" }),
    "Waren jeder Art gibt es hier. Altes und neues. Werkzeuge, Lebensmittel, Schiffsbedarf aber auch "
    "Dinge, die so aussehen als seien sie am Strand angespuelt worden. Alles zusammen "
    "stellt den kleinen Laden ziemlich voll, der Kram stapelt sich bis unter die Decke.");    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Stein, von dem man allerdings nicht viel sieht, denn er ist "
    "ziemlich zugestellt mit allerhand Zeug.");    
  AddDetail( ({ "werkzeug","werkzeuge", "schiffsbedarf", "lebensmittel" }),
    "Alles, was man zum leben als Pirat braucht.");    
  AddDetail( ({ "dinge" }),
    "Es scheint sich tatsaechlich um Strandgut zu handeln.");    
  AddDetail( ({ "strandgut" }),
    "Strandgut sind Dinge die am Strand angespuelt wurden. Hauptsaechlich ist das dann "
    "Schiffsbedarf.");    
  AddDetail( ({ "muenzen" }),
    "Piets Muenzen sind in der Kasse.");    
  AddDetail( ({ "strand" }),
    "Den findest Du in dieser Grotte kaum, geh mal nach oben auf die Insel, wenn Du welchen finden willst.");    
  AddDetail( ({ "art" }),
    "So ziemlich alles.");    
  AddDetail( ({ "pirat" }),
    "Hier ist wohl grad keiner.");    
  AddDetail( ({ "grotte" }),
    "Du bist in einer Grotte unter einer Insel.");    
  AddDetail( ({ "insel" }),
    "Mehr von der Insel siehst Du, wenn Du die Grotte verlaesst.");    
  AddDetail( ({ "" }),
    "");    
  AddDetail( ({ "" }),
    "");    

  AddSound( DEFAULT_SOUND,
    "Du hoerst von draussen das Knarren der Planken, ansonsten ist es ruhig.");

  AddSound( ({ "planken","knarren", "bewegung" }),
    "Die Planken knarren bei jeder Bewegung.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht muffig. Kein Wunder, hier wird wohl sehr selten gelueftet.");

  AddSmell( ({ "wunder" }),
    "Wunder gibt es immer wieder.");

AddItem(PIR_NPC + "pirat_piet",REFRESH_DESTRUCT);
AddCmd(({"oeffne"}),"oeffnen");
AddExit( "westen", PIR_ROOM + "piratengrotte_3e" ); 
}

int oeffnen(string str)
{
   notify_fail("Was moechtest Du oeffnen?\n");
   if(str!="kasse"&&str!="truhe"&&str!="kassentruhe") return 0;
   if(present("piet", TO))
   {
      write("Du versuchst die Kassentruhe zu oeffnen.\n"+
	        "Piet haut Dir auf die Finger.\n"+
			"Piet sagt: Pfoten weg!\n");
      say(TPN+" versucht die Kassentruhe zu oeffnen.\n"+
	        "Piet haut "+TPN+" auf die Finger.\n"+
			"Piet sagt: Pfoten weg!\n",TP);
			}
	else
	{
	  write("Du versuchst die Kassentruhe zu oeffnen.\n"+
	        "Die Kasse klemmt.\n");
	  say(TPN+" versucht die Kassentruhe zu oeffnen.\n"+
	        "Die Kasse klemmt.\n",TP);
			}
	return 1;
	}
		
						
