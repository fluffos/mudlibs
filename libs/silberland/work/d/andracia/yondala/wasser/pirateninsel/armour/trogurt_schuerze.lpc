//Schuerze, die sich per random in einer Farbe clont

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

string farb;
int farbe;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
farbe = random(6);
switch(farbe)
{	case 1: {      
   farb="rot";
   SetProp(P_SHORT, "Eine rote Schuerze");
     	break;}
  case 2: {      
   farb="gelb";
   SetProp(P_SHORT, "Eine gelbe Schuerze");
	break;}
	case 3: {      
   farb="gruen";
   SetProp(P_SHORT, "Eine gruene Schuerze");
	break;}
	case 4: {      
   farb="blau";
   SetProp(P_SHORT, "Eine blaue Schuerze");
	break;}
	case 5: {      
   farb="braun";
   SetProp(P_SHORT, "Eine braune Schuerze");
	break;}
	default: {
  farb= "schwarz";
  SetProp(P_SHORT, "Eine schwarze Schuerze");
}
}
 SetProp(P_NAME_ADJ, farb);

  SetProp(P_LONG,
    "Du siehst ein schwere "+farb+"e Schuerze, sie besteht aus dickem, "+
	"widerstandsfaehigen Leder." );
  SetProp(P_NAME, "Schuerze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze"}) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 690);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_PROTECTION, DT_FIRE);
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE:170]) );
}

