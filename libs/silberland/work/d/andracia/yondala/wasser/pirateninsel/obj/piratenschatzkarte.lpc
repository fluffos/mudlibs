int graben(string str)
{ 
	object ob;
	int muenzen;
	muenzen =5000+random(5000);
	notify_fail("Moechtest Du im Boden graben?\n");
	if (str!="in boden" && str!="im boden") return 0;
	
	//write("Raum "+to_string(raum)+"\n");
	//write("Umgebung "+to_string(environment(TP))+"\n");
	if (to_string(environment(TP))==raum)
	  {
	    TP->GiveQuest("Finde den Piratenschatz");
		//if( TP->GiveQuest("Such den Piratenschatz") == 1)
		  //{
		say(TPN+" findet einen Schatz.\n",TP);
		write ("Du graebst im Boden herum und tatsaechlich, Du "+
		       "findest einen Schatz.\n");
		//TP->AddMoney(muenzen);

		ob= clone_object("/obj/money");
		ob->AddAmount(muenzen);
		if(ob->move(TP))
		{
		  write("Schnell steckst Du all die Muenzen und Edelsteine ein.\n"+
			   "Leider hast Du nicht aufgepasst und die Schatzkarte "+
			   "fallen gelassen. Sie wird vom Wind davongetragen.\n");
          "/obj/gemmaster"->DistributeGem(10, 10, 3, TP);
			   }
		else
		{
	      write("Leider kannst Du die vielen Muenzen und Edelsteine nicht "+
		        "mehr tragen.\n"+
			    "Du hast nicht aufgepasst und die Schatzkarte "+
			    "fallen gelassen. Sie wird vom Wind davongetragen.\n");
          ob->move(environment(TO));
		  "/obj/gemmaster"->DistributeGem(10, 10, 3, environment(TP));
		}
		if(present("\ninvislampe",TP)) present("\ninvislampe",TP)->remove();
		if(present("\nlampeplan",TP)) present("\nlampeplan",TP)->remove();
		remove();
		return 1;
			//}

	  }
	else
	  {
		write("Du graebst, findest aber nichts. Ob Du hier richtig bist?\n");
		return 1;
		}
	}
	
