#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Donnerhelm");
  SetProp(P_LONG,
    "Du siehst einen kleinen, leichten Helm vor Dir der eigentlich recht "
    "unscheinbar und nicht sonderlich stabil aussieht, wenn er nicht diese "
    "schwache Aura haette. An beiden Seiten des Helms sind kleine Hoerner befestigt." );
  SetProp(P_INFO, BS(	"Dieser kleine, leichte Helm schuetzt besonders gut gegen "
  "magische Attacken. Er passt sich immer der Groesse seines Traegers an.") );
  SetProp(P_NAME, "Donnerhelm");
  SetProp(P_NAME_ADJ, "leicht"); 
  SetProp(P_NAME_ADJ, "klein"); 
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "donnerhelm", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 100);

//SetProp(P_M_ATTR_MOD,([A_INT:-2,A_STR:3]));
SetProp(P_DAM_PROTECTION, DT_WATER);
 SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );

}
