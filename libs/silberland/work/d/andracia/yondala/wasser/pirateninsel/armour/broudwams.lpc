#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein rotes Wams");
  SetProp(P_LONG,
    "Du siehst ein rotes Wams. Es hat goldene Knoepfe und ein paar bunte "
	"Stickereien an der Seite. Es mag mal einem wohlhabenden Mann gehoert "
	"haben. Das ist aber schon etwas her." );

  SetProp(P_NAME, "Wams");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"wams"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10 );
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 320);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

}
