//Soll: Hier kann man einen Lemming freiforschen, der sich erschreckt ueber die Klippe stuerzt

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_SHORT, "Auf einer hohen Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer sehr hohen Klippe. Um Dich herum siehst Du nur wenig Vegetation. "
	"Noerdlich und westlich geht es steilabwaerts. Nach Osten kannst Du "
    "weiter auf der Klippe entlangwandern, suedwestlich gehst Du auf eine "
	"Duenenlandschaft zu. "
    "Am strahlenden Himmel lacht die Sonne auf Dich herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer sehr hohen Klippe.");

  AddDetail( ({ "steine" }),
    "Auf den Steinen waechst Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos ist mal sehr dicht, mal spaerlich.");

  AddDetail( ({ "norden" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels","gestein" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");


  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "suedosten" }),
    "Im Suedosten ist eine leichte Erhebung.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht hauptsaechlich aus moosbedeckten Steinen.");
  AddDetail( ({ "vegetation" }),
    "Lediglich ein kleiner Busch krallt seine Wurzeln in der Hoffnung auf einen Halt mitten in die Steine.");
  AddDetail( ({ "busch" }),
    "Der kleine Busch krallt sich zwischen die Steine. Viel Wasser scheint er dort nicht zu bekommen und die "
	"Sonne tut ihm offenbar auch nicht so gut, denn seine duennen Aestchen sehen ganz vertrocknet aus und nur "
	"wenige gruene Blaetter zieren noch seine Zweige.");
  AddDetail( ({ "wasser" }),
    "Obwohl die Insel von Wasser umgeben ist, findet der kleine Busch hier zwischen den Steinen nur wenig davon.");
  AddDetail( ({ "aestchen" }),
    "Die Aestchen des Busches sind ganz grau und vertrocknet.");
  AddDetail( ({ "blaetter" }),
    "Die meisten der Blaetter sind aschgrau und wirken knusprig. Nur sehr wenige sind gruen und tragen noch Leben in sich.");
  AddDetail( ({ "insel" }),
    "Du befindest Dich auf einer Insel. Einer sehr schoenen noch dazu.");
  AddDetail( ({ "leben" }),
    "Im Normalfall ist alles vorbei, wenn man sein Leben verliert.");
  AddDetail( ({ "normalfall" }),
    "Du als Mudder weisst es natuerlich besser. Kleiner Besuch bei Lars und schon gehts weiter, was?");
  AddDetail( ({ "mudder" }),
    "Du weisst schon, dass das hier nicht real ist, oder?");
  AddDetail( ({ "besuch", "lars" }),
    "Wenn Du ihn mal wieder besuchen willst untersuche doch auch noch WEIHNACHTSBAUM und guck, was passiert.");
  AddDetail( ({ "weihnachtsbaum" }),
    "Ja gut, ok, war geblufft. Ich bin ja nicht Dante.");
  AddSpecialDetail("dante", "faketod");

  AddDetail( ({ "hoffnung" }),
    "Die sollte man nie aufgeben.");
  AddDetail( ({ "wurzeln" }),
    "Du fragst Dich, wie der kleine Busch es wohl schafft seine duennen Wurzeln in den harten Untergrund zu treiben.");
 AddDetail( ({ "untergrund" }),
    "Als Du genauer hinguckst, entdeckst Du einen kleinen Spalt im Gestein, aus dem der kleine Busch spriest.");
  AddDetail( ({ "spalt" }),
    "Unterhalb der Wurzeln entdeckst Du ein Loch.");
 AddDetail( ({ "loch" }),
    "Was darin ist erkennst Du nicht. Vielleicht koenntest Du ja mal darin pulen?");
  AddDetail( ({ "halt" }),
    "Muehsam klammern sich die Wurzeln in den Fels.");
  AddDetail( ({ "zweige" }),
    "Tapfer streckt der kleine Busch seine Zweige nach oben. Die meisten davon hat die Sonne aber schon ausgetrocknet.");
  AddDetail( ({ "woelkchen" }),
    "Weit und breit keines zu sehen.");
  AddDetail( ({ "osten" }),
    "Wenn Du nach Osten gehst wanderst Du weiter auf der Klippe herum.");
  AddDetail( ({ "duenenlandschaft" }),
    "Suedwestlich von Dir beginnt eine sandige Duenenlandschaft.");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhythmus" }),
    "Hmmmm, beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");
  AddRoomMessage( 
    ({""}),30,"func");



AddItem(PIR_NPC + "pirat_martus",REFRESH_DESTRUCT);
AddExit( "osten", PIR_ROOM + "pirateninsel_1d" ); 
AddExit( "suedwesten", PIR_ROOM + "pirateninsel_2b" );
AddCmd(({"pule","pul"}),"pulen");

}

void lemming6()
{
tell_room(TO,"Du reibst Dir die Augen, hast Du das gerade wirklich gesehen?\n");

}
void lemming5()
{
tell_room(TO,"Nun ist alles wieder ruhig.\n");
call_out("lemming6",3);
}
void lemming4()
{
tell_room(TO,"Ein ganzer Pulk Lemming rast an Dir vorbei und springt ueber die Klippe dem sicheren Tod entgegen.\n");
call_out("lemming5",5);
}
void lemming3()
{
tell_room(TO,"Die Erde beginnt zu zittern.\n");
call_out("lemming4",1);
}
void lemming2()
{
tell_room(TO,"Zwei weitere Lemminge rennen dem ersten Lemming hinterher und stuerzen sich ueber die Klippe.\n");
call_out("lemming3",5);
}

void lemming1()
{
tell_room(TO,"Ploetzlich sausst ein Lemming aus dem Loch hervor und springt in Panik ueber die Klippe.\n");
call_out("lemming2",4);
}

int pulen(string str)
{
   notify_fail("Worin moechtest Du pulen?\n");
   if(str!="in spalt"&&str!="in loch") return 0;
   
   write("Du pulst in dem Loch herum.\n");
   say(TPN+" pult in einem Loch herum.\n");
   
   if(find_call_out("lemming1")>=0) return 1;
   if(find_call_out("lemming2")>=0) return 1;
   if(find_call_out("lemming3")>=0) return 1;
   if(find_call_out("lemming4")>=0) return 1;
   if(find_call_out("lemming5")>=0) return 1;
   if(find_call_out("lemming6")>=0) return 1;
   
   call_out("lemming1",2);
   return 1;
   }


string faketod()
{
  return "[Tod:Lars] Dante hat gerade "+TPN+" umgebracht.\n"+
         "[Tod:Dante] Gib zu, Du hast Dich erschreckt!\n";
		 }