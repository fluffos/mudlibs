
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas Kitt");
  SetProp(P_LONG,
    "Du siehst ein bisschen schleimigklebrigen Kitts." );

  SetProp(P_NAME, "Kitt");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kitt"}));

  SetProp(P_MATERIAL, MAT_SLIME );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 0);
 
}
