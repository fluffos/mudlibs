give_notify(object ob)
 {
 	if(ob->id("goldherz"))command("sag Nein, gebt es Broud, ich bin zu alt um zu reisen!");
 	else if(ob->id("\nhildgundeschluessel"))command("sag Bitte befreit mit diesem Schluessel meine Tochter!");
 	else command("sag Was soll ich damit?");
  ob->move(TP, M_GET);
 }
