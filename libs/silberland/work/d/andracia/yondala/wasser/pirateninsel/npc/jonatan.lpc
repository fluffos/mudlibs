
//Gehoert zur Tauschquest. Der Vater von Hildgunde. Hat das Herz nicht, es wurde ihm vom 
//zwergischen Dieb gestohlen

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

string hilfe()//Info, startet die Quest
{
 
  if(TP->QueryQuest("Befreie Hildgunde")) //Wenn die Quest schon beendet wurde
    return "sagt: Aber Ihr habt mir doch schon einmal geholfen!\n";
	if(present("\nhildgundeitem",TP))
		return("Ihr helft mir ja schon.\n");
	if(present("\ngoldherz",TP))
		return("Ah, Ihr habt das Herz! Bitte, bring es Broud und befreit meine Tochter!\n");
  
  return "sagt: Bitte, findet den kleinen Dieb und holt Euch das Herz!\n";
}
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Jonatan");
  SetProp(P_LONG,
    "Du siehst einen alten, gebrochenen Mann, der Dich aus leeren Augen traurig anschaut. "
    "Er ist schaebig bekleidet, abgemargert und seine Haut, sowie sein Haar ist grau. "
    "Er scheint grossen Kummer zu haben.");
  SetProp(P_NAME, "Jonatan");
  SetProp(P_GENDER, MALE);
  AddId(({"jonatan", "mann"}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit wenig Elan",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "ist dafuer zu muede.");

  SetProp(P_MSGIN, "schleppt sich muede herein");
  SetProp(P_MSGOUT, "schleppt sich muede");
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Wer befreit nun meine Tochter?");
  SetProp(P_KILL_NAME, "Jonathan");
  SetProp(P_KILL_MSG, "Haettest Du mir lieber geholfen.");
//  SetProp(P_LOG_INFO, "yondala");


  AddInfo(DEFAULT_INFO, "seufzt: Das weiss ich leider nicht.\n");

  AddInfo( ({"broud"}),
    "Broud ist der miese Sklaventreiber, der meine Tochter entfuehrt hat.",
    "sagt: ");
  AddInfo( ({"sklaventreiber",""}),
    "Ich kenne nur einen und der heisst Broud.",
    "sagt: ");
  AddInfo( ({"herz","goldherz"}),
    "Ach, das goldene Herz ist es, was mein Leben und das meiner Tochter zerstoerte. "
    "Haette ich doch bloss nicht so eine Dummheit begannen damals.",
    "sagt: ");
  AddInfo( ({"tochter",""}),
    "Der Name meiner Tochter ist Hildgunde.",
    "sagt: ");
  AddInfo( ({"hildgunde","hilde"}),
    "Ach, meine liebe Hilde, sie war alles, was ich noch hatte, bis Broud sie mir genommen hat.",
    "sagt: ");
  AddInfo( ({"dummheit",""}),
    "Vor langer Zeit habe ich dem Piraten Broud ein Kleinod gestohlen. Wir waren arm und ich "
    "wollte so gerne meine Familie ernaehren. Broud fand heraus, dass ich es war, der sein "
    "Herz genommen hat. Er entfuehrte meine Tochter um mich zur Herrausgabe des Herzens zu "
    "zwingen. Ich machte mich sofort auf, es ihm zurueck zu bringen, doch auf dem Weg zum Hafen "
    "wurde ich selbst ueberfallen. Ein kleiner baertiger Mann stahl mir das Herz.",
    "sagt: ");
  AddInfo( ({"kleinod",""}),
    "Ein Herz aus Gold war es.",
    "sagt: ");
  AddInfo( ({"mann",""}),
    "Es war ein sehr kleiner Mann, er ging mir gerade bis zum Guertel. Er war sehr haarig, hatte "
    "einen langen, wilden Bart.",
    "sagt: ");
  AddInfo( ({"herrausgabe","herrausgeben"}),
    "Wie gerne wuerde ich Broud das Herz zurueckgeben und meine Tochter wieder in die Arme "
    "nehmen zu koennen. Doch kann ich es nicht.",
    "sagt: ");
  AddInfo( ({"kummer",""}),
    "Ach, mein Kummer ist so gross. Meine Tochter habe ich verloren an Broud, mein Hab und Gut "
    "habe ich verloren bei dem Versuch meine Tochter zu erloesen. Nun habe ich nichts mehr und "
    "brauche dringend Hilfe.",
    "sagt: ");
  AddInfo( ({ "hilfe", "helfen"}), #'hilfe);//'

  AddInfo( ({"kleiner mann","kleinen mann","kleinem mann", "maenner","kleine maenner"}),
    "Wenn ich bloss wuesste, wo man kleine Maenner findet.",
    "sagt: ");
  AddInfo( ({"dieb",""}),
    "Ein kleiner, baertiger Mann hat mir das goldene Herz gestolen.",
    "sagt: ");
  AddInfo( ({"hafen",""}),
    "Der Hafen ist entfernt von hier, doch eine Kutsche kann Euch hinbringen.",
    "sagt: ");
  AddInfo( ({"kutsche",""}),
    "Es faehrt regelmaessig eine Kutsche von hier zum Hafen und zurueck.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


//   SetProp(P_LOG_INFO, "yondala/jonatan/");


 /* SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));*/

  SetChats(3, ({
    "Jonatan seufzt laut.\n",
    "Jonatan sagt: Wenn ich nur wuesste, wo der Dieb ist.\n",
    "Jonatan seufzt: Alles habe ich verloren.\n",
    "Jonatan weint: Meine arme Tochter!\n"

    }) );
 

}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

