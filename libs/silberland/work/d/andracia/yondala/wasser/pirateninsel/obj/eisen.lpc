
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas Eisen");
  SetProp(P_LONG,
    "Ein Stueck Eisen, aus dem man sicher etwas schmieden koennte." );

  SetProp(P_NAME, "Eisen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"eisen", "\neisen"}));

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 500);
 

}
