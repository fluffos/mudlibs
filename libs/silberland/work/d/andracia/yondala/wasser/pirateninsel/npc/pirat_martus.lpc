//inherit "/players/yondala/wasser/yondala/pirateninsel/pirat_std.lpc";
inherit PIR_NPC+"pirat_std.lpc";


object *begruesste;//hier speichert Martus die Namen derer, die er schon angesprochen hat. Das nervt sonst.
void init()
{::init();
	if(member(begruesste, TP)!=-1) return;
	
	if(TP && interactive(TP))
	
	call_out("check",1);

}	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  begruesste=({});
  SetProp(P_SHORT, "Martus");
  SetProp(P_LONG,
    "Martus ist ein kleines, duennes Maennlein. Er scheint schon recht alt zu sein, "
    "dennoch bewegt er sich recht drahtig. Martus macht einen sehr armen Eindruck, er "
    "ist irgendwie schmutzig und seine Kleidung ist offenbar sehr alt.");
  SetProp(P_NAME, "Martus");
  SetProp(P_GENDER, MALE);
  AddId(({"martus", "maennlein", ""}));
  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 156);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK,1);

SetProp (P_MNPC_DEFAULTROOM, PIR_ROOM+"pirateninsel_1c");
SetProp (P_MNPC_AREA, PIR_ROOM+"pirateninsel" );
SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
SetProp (P_MNPC_WAIT, ({5, 10, 5}));
 
  

  SetProp(P_MSGIN, "schleicht herein"); 
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MMSGOUT, "erbleicht ploetzlich und fluechtet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_NAME, "Martus");
  SetProp(P_KILL_MSG, "Das hab ich nicht erwartet...");
//  SetProp(P_LOG_INFO, "yondala");
/*  SetAttackChats( 3,
    ({"kaempft.\n"
     ,"schreit.\n"
     })
  );*/
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    
  AddInfo(DEFAULT_INFO, "weiss keine Antwort.\n");//Wenn der PIR_NPC keine Antwort hat

  AddInfo("yondala", "Lang lebe Yondala.","sagt: "); 

        
  AddInfo( ({ "medaille", "piratenmedaille", "schutzmedaille", "schutzmedaillen" }),
    "Die Medaille tragen alle Freunde der Piraten. Da ich aber lange kein Schiff mehr "
    "gefunden habe, auf dem ich anheuern kann, verkaufe ich nun diese Medaillen, um mich "
    "ueber Wasser zu halten. Auch wenn ich damit meinem Kapitaen in den Ruecken falle.",
    "sagt: ");        
  AddInfo( ({ "schiff" }),
    "Ja, einst diente ich unter Kapitaen Drako auf seinem wunderbaren Schiff, der Lacneia. "
    "Auch wenn ich nicht stark war, so war ich doch nuetzlich. Nun suche ich schon so "
    "lange nach Arbeit auf einem anderen Schiff. Doch hier ist schon lange keins mehr "
    "gewesen, auf dem ich haette Arbeit finden koennen.",
    "sagt: ");
  AddInfo( ({ "nutzen" }),
    "Ich war der Ausgucker, auf der Lacneia, denn ich bin klein und flink.",
    "sagt: ");
  AddInfo( ({ "lacneia" }),
    "Das war das stolze Schiff von Kapitaen Drako.",
    "sagt: ");
  AddInfo( ({ "drako", "kapitaen" }),
    "Drako war lange Jahre lang mein Kapitaen, doch seit sein Schiff an den Klippen "
    "zerschellte, ist er ein gebrochener Mann.",
    "sagt: ");
  AddInfo( ({ "klippen" }),
    "Die Klippen rund um die Insel sind tueckisch. Und weil staendig jemand die "
    "Leuchtturmlampe von Hein stielt, zerschellen immerwieder Schiffe daran.",
    "sagt: ");
  AddInfo( ({ "leuchtturmlape", "leuchtturm", "dieb" }),
    "Da fragt mal lieber Hein zu.",
    "sagt: ");
  AddInfo( ({ "hein", "leuchtturmwaechter" }),
    "Hein war einst der Steuermann auf der Lacneia. Heute ist er der Leuchtturmwaechter "
    "dieser Insel.",
    "sagt: ");
  AddInfo( ({ "arbeit" }),
    "Arbeit gibt es wenig. Ich suche Arbeit als Ausguck auf einem Schiff. Bis dahin "
    "verkaufe ich Schutzmedallien an Abenteurer.",
    "sagt: ");
  AddInfo( ({ "abenteurer" }),
    "Jeder Abenteurer sollte eine Piratenmedallie bei sich tragen, denn daran erkennen die Piraten ihre Freunde.",
    "sagt: ");
  AddInfo( ({ "piraten" }),
    "Die Piraten dieser Insel sind rauhe Gesellen, denen das Schicksal "
	"uebel mitgespielt hat. Wir haben uns hierher zurueckgezogen, als "
	"unser Schiff unterging. Viele sind mittlerweile alt und verwirrt.",
    "sagt: ");
  AddInfo( ({ "schicksal" }),
    "Das Schicksal hat uns Piraten der Lacneia hart getroffen.",
    "sagt: ");
  AddInfo( ({ "preis","preis fuer medaille", "medaillenpreis" }),
    "Eine Medaille kostet Euch nur 200 Muenzen.",
    "sagt: ");
  AddInfo( ({ "nachname","nachnamen" }),
    "Hm, ich hatte mal einen, kann mich aber nicht mehr erinnern, tut mir leid.",
    "sagt: ");
  AddInfo( ({ "angst" }),
    "Wovor soll ich noch Angst haben?",
    "seufzt: ");
  AddInfo( ({ "magier","magiern","adelige","adel" }),
    "Von denen schert sich niemand um unser Schicksal.",
    "sagt: ");
  AddInfo( ({ "geld", "muenzen" }),
    "Davon habe ich nur wenig.",
    "sagt: ");
  AddInfo( ({ "ruecken" }),
    "Mein Ruecken ist auch nicht mehr das, was er mal war.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
 
   SUID;
  CLONEME("/p/armour/armour/weste");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");  
  SUID;

SetChats(3, ({
   "Martus haelt nach einem Schiff Ausschau.\n",
   "Martus hustet.\n",
   "Martus fragt: Habt Ihr zufaellig Arbeit fuer mich?\n"}) );

   AddCmd(({"kaufe","kauf"}),"kaufenCmd");
   
}


void check()
{
  // Spieler noch da?
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
    if (present("/nschutzmedaillepiraten",TP))  // Medaille dabei?
    {
      write("Martus nickt Dir zu.\n");
	  say ("Martus nickt "+TPN+" zu.\n",TP);
	  }
    
    else        // Keine Medaille dabei...
    {
		 command("sag "+TPN+", es waere besser, wenn Ihr auch eine Medaille bei Euch haettet!"); 
		 //say ("Martus sagt: "+TPN+", es waere besser, wenn Ihr auch eine Medaille bei Euch haettet!\n");
    }
	begruesste=begruesste+({TP});
  }
}	


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "denkt . o O  (Also vor mir hatte schon lange niemand mehr Angst)",
        "denkt . o O  (Also vor mir hatte schon lange niemand mehr Angst)");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "seufzt: Ich moechte auch noch mal jung sein!",
        "seufzt: Ich moechte auch noch mal jung sein!");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "spuckt Dir vor die Fuesse.",
        "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich misstrauisch an.",
        "schaut " +TPN+ " misstrauisch an.");
      break;

  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int kaufenCmd(string str)
{ notify_fail("Was willst Du bei wem kaufen?\n");


if(str=="medaille bei martus" || str=="schutzmedaille bei martus"|| str=="piratenmedaille bei martus"||
	str=="medaille" || str=="schutzmedaille"|| str=="piratenmedaille")
{	
	
if(this_player()->QueryMoney() >= 200)
{
	this_player()->AddMoney(-200);
	bswrite("Du gibst Martus 200 Muenzen.\nMartus gibt Dir eine kleine, glaenzende Medaille.\n");
	say(TPN+" kauft etwas bei Martus.\n", TP);
    CLONE(PIR_ARMOUR + "piratenschutzmedaille", TP);
	return 1;
}

else
	write("Martus sagt: Ihr habt nicht genug Geld dabei.\n");
return 1;
}}	