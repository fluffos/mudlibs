//wird geclont, wenn man von Roger nen Arm abgehackt bekommt
//soll Der Arm von xy heissen.
//Idee. Rasse mit einbauen

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void namekriegen(object wessen)
{
  SetProp(P_SHORT, wessen->name(WESSEN)+" Arm");
}
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Arm");
  SetProp(P_LONG,
    "Du siehst einen abgetrennten Arm. Er sollte schnellstens wieder angenaeht werden." );
  SetProp(P_NAME, "Arm");
  SetProp(P_NAME_ADJ, "abgetrennt");
  SetProp(P_GENDER, MALE);
  AddId("arm");
  SetProp( P_MATERIAL, ([ MAT_FLESH : 55, MAT_SKIN: 15, MAT_BONE: 30 ]) );

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  call_out("verwesung",3600);
}

void verwesung()
{
  tell_object(environment(TO),"Der Arm verwest.\n");
  remove();
  }
