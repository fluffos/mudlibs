#include "../def.h"
inherit "std/thing";
#include <properties.h>


object obj;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse Lampe");
  SetProp(P_LONG,
    "Eine grosse Lampe in der keine Kerze steckt." );
  SetProp(P_NAME, "Lampe");
  SetProp(P_GENDER, FEMALE);
  AddId("lampe");

    SetProp( P_MATERIAL, ([ MAT_GLASS : 60, MAT_IRON : 40 ]) );

  SetProp(P_WEIGHT, 1150);
  SetProp(P_VALUE, 263);

 AddCmd( ({ "steck", "stecke" }), "steckenCmd" ); 

}

steckenCmd(string str )
{
  notify_fail( "Was moechtest du worein stecken?\n" );
  if( str=="kerze in lampe" )
  {	if(present("kerze",  TP))
    write("Du steckst die Kerze in die Lampe.\n");
    say( TPN+" steckt eine Kerze in eine Lampe.\n", TP);
    CLONE( PIR_OBJ +"leuchtturmlampemitkerze", TP);
   if(present("\nlampeplan",TP)) 
   {
     present("\nlampeplan",TP)->remove();
	 write("Du wirfst den Bauplan weg.\n");
	 }
obj = present("kerze",  TP);
obj->remove();
 		this_object()->remove();
    return 1;
    
  }
  return 0;
}