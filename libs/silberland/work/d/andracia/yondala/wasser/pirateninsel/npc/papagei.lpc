//Der Papagei fliegt umher und plappert nach, was Spieler sagen. Er kann
//sich 10 Saetze merken. Wenn er etwas Neues lernt, vergisst er einen Satz.

//wenn man ihn aergert beisst er zu und zieht 5 HP ab

#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <moving.h>// er kann sich bewegen (rumlaufen)
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
#include "../def.h"
inherit "std/mnpc";
#include <language.h>

string *nachgeplapper;


void create() {

  ::create();
  if(!is_clone(this_object())) return;
   create_default_npc(4); 
  SetProp(P_SHORT, "Ein Papagei");
  SetProp(P_LONG,
     "Du siehst einen ausgewachsenen Papagei, dessen praechtiges Gefieder in kraeftigen Farben leuchtet. "
     "Sein Schnabel sieht scharf und sehr kraeftig aus. Neugierig mustert er Dich aus kleinen Knopfaugen.");
  SetProp(P_NAME, "Papagei");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);

  AddId( ({ "papagei", "vogel" }) );

  AddDetail( ({ "gefieder" }),
    "Der Papagei hat ein leuchtend buntes Gefieder."  );
  AddDetail( ({ "schnabel" }),
    "Mit diesem scharfen Schnabel kann er Dir sicher sehr weh tun, Du solltest ihn nicht provozieren."  );
  AddDetail( ({ "knopfaugen","augen" }),
    "Der Papagei hat kleine, schwarze Augen, die Dich neugierig mustern."  );
  AddDetail( ({ "fluegel", "fluegeln" }),
    "Die Fluegel des Papageis sind leuchtend rot.");
  AddDetail( ({ "", "" }),
    "");
  AddDetail( ({ "", "" }),
    "");
    


  SetProp( P_HANDS, ({ " mit Krallen und Schnabel", 100 , DT_PIERCE}) );
  SetProp( P_RACE, "Vogel" );


  SetProp (P_MNPC_DEFAULTROOM, PIR_ROOM+"pirateninsel_6c");
  SetProp (P_MNPC_AREA, "/d/andracia/yondala" );
  SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS +MOV_OUTDOORS);
  SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_SIZE, 25);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);


  SetProp(P_MSGIN, "flattert herbei");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herbei");
  SetProp(P_MMSGOUT, "flattert davon");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");//die letzte Meldung wenn er stirbt
  SetProp(P_KILL_NAME, "Ein Papagei");

  AddInfo(DEFAULT_INFO, "kraechzt.\n");//Wenn der PIR_NPC keine Antwort hat
  
  SetChats(3, ({"Der Papagei flattert aufgeregt mit den Fluegeln.\n",
  							"Der Papagei kraechzt: Wissen ist Macht.\n",
								"Der Papagei kraechzt: Irren ist menschlich.\n",
								"Der Papagei kraechzt: Ein Sturm zieht auf.\n",
								"Der Papagei kraechzt: Des einen Freud ist des anderen Leid.\n",
								"Der Papagei kraechzt: Fuenfzig Mann auf des totens Manns Kist.\n",
								"Der Papagei kraechzt: Nachts ist es kaelter als draussen.\n",
								"Der Papagei kraechzt: In der Ruhe liegt die Kraft.\n",
								"Der Papagei kraechzt: Seemannsgarn.\n",
								"Der Papagei kraechzt: hicks\n",
								"Der Papagei kraechzt: Wissen ist Macht.\n"}) );

 
 
 
 
nachgeplapper= ({	
								"Der Papagei kraechzt: Wissen ist Macht.\n",
								"Der Papagei kraechzt: Irren ist menschlich.\n",
								"Der Papagei kraechzt: Ein Sturm zieht auf.\n",
								"Der Papagei kraechzt: Des einen Freud ist des anderen Leid.\n",
								"Der Papagei kraechzt: Fuenfzig Mann auf des totens Manns Kist.\n",
								"Der Papagei kraechzt: Nachts ist es kaelter als draussen.\n",
								"Der Papagei kraechzt: In der Ruhe liegt die Kraft.\n",
								"Der Papagei kraechzt: Seemannsgarn.\n",
								"Der Papagei kraechzt: hicks\n",
								"Der Papagei kraechzt: Wissen ist Macht.\n"});
							
 }

void verzoegertsagen(string str)
{
  tell_room(environment(TO),str);
}
//Sobald jemand etwas sagt, vergisst der Papagei einen Satz und merkt sich den neuen
void catch_tell(string str)
{
	int i;
	string dummy, text, str2;
	str2=str;
	//um zu starkes Scrollen zu vermeiden werden nur einzeilige Saetze angenommen
	if(strlen(str)>70) return;

//um den Namen noch rauszufiltern:
if(sscanf(str, "%s sagt: %s", dummy, text)!=2)
{ 
   if (sscanf(str, "%s fragt: %s", dummy, text)!=2) 
   return;
   }
		text="Der Papagei kraechzt: "+ text;
		call_out("verzoegertsagen",1,text);
		nachgeplapper[random(10)]=text;
	//einmalige Ausgabe des Textes sofort.
	/*call_out("verzoegertsagen",1,"Der Papagei kraechzt: "+ text);
	i=random(10);

	nachgeplapper[random(10)]="Der Papagei kraechzt: "+text+"\n";*/
	SetChats(3,({"Der Papagei flattert aufgeregt mit den Fluegeln.\n",
		nachgeplapper[0],
		nachgeplapper[1],
		nachgeplapper[2],
		nachgeplapper[3],
		nachgeplapper[4],
		nachgeplapper[5],
		nachgeplapper[6],
		nachgeplapper[7],
		nachgeplapper[8],
	    nachgeplapper[9]}));
	
		
}
void beissen(object spieler)
{
	TP->do_damage(5);
	write("Der Papagei beisst Dich in die Nase.\n");
	say("Der Papagei beisst "+spieler->name(WEN)+" in die Nase.\n",TP);
	
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich"://wenn jemand aengstlich (zb mit zittern) auf npc reagiert
      call_out("reaction", 0, TP, 
        "beaeugt Dich neugierig.",// in Klammern kommt die Meldung die an den Spieler geht
        "beaeugt "+TP->name(WEN)+" neugierig.");// Was alle anderen im Raum sehen
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "plustert sich auf.",
        "plustert sich auf.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "keckert Dich froehlich an.",
        "keckert "+TPN+" froehlich an.");
      break;
    case "fies":
      beissen(TP);
	  //call_out("reaction", 0, TP,
       // "spuckt Dir vor die Fuesse.",
       // "spuckt " +TPN+ " vor die Fuesse.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "reibt gurrend seinen Kopf an Deinem Bauch.",
        "reibt gurrend seinen Kopf an "+TP->name(WESSEN)+" Bauch.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "kraechzt erfreut.",
        "kraechzt erfreut.");
      break;

  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

