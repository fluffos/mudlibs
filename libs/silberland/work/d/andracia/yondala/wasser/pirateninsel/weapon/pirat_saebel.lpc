#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Saebel");
  SetProp(P_LONG,
    "Du siehst einen eisernen Saebel vor Dir, der zwar nicht mehr ganz neu ist, "
    "dafuer aber recht gut in der Hand liegt und noch relativ scharf ist." );
  SetProp(P_NAME, "Saebel");
  SetProp(P_GENDER, MALE);
  AddId( ({"saebel", "waffe"}) );
  //SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 80);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 60);
  SetProp(P_VALUE, 200);
  SetProp(P_QUALITY_DECAY, 100);
 
  SetProp(P_WC_BONUS, (["pirat": 50]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_SIZE:150]) );
}
