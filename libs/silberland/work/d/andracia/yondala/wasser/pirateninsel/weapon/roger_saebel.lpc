//Die Waffe von Roger Schwarzbart mit Bonus fuer jenen
//erstmal so von /p/weapon/sword/flamberge.c uebernommen
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Saebel");
  SetProp(P_LONG,
    "Du siehst einen praechtigen Saebel vor Dir, der auesserst scharf zu sein scheint. Ausserdem hat er kaum "
	"Kratzer, er wurde vermutlich nur wenig benutzt oder sehr gut gepflegt. Die Schneide ist lang und glatt, "
	"der Griff ist vergoldet und mit Edelsteinen bestueckt." );
  SetProp(P_NAME, "Saebel");
  SetProp(P_GENDER, MALE);
  AddId( ({"saebel", "waffe"}) );
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 235);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Roger":265]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_GOLD:10]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 3000);
  SetProp(P_SIZE, 165);
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:19, P_SIZE:155]) );  
}
