#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine weisse Hose");
  SetProp(P_LONG,
    "Eine weisse Hose, die an der Huefte und den Fussgelenken sehr eng ist, ansonsten aber sehr weit faellt." );
  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 254);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);
}
