//Dieser Raum soll sicher sein wie ein seherhaus (niemand kann unsichtbar rein)
//Questbelohnung: Man kann das Portal nach Lunia freischalten 
#include "../def.h"
inherit "std/room";
#include <properties.h>

void init()
{::init();
//call_out("check",0);
    if (TP->Query_Prop(P_INVIS )==1)  // Ist er unsichtbar?
    {write("Auch wenn Du unsichtbar bist, wurdest Du beim hochklettern gesehen.");
      say("Jemand betritt den Raum!\n",TP);
    }
}


//********************************************************************
//Fuer das Portal


int testobgemacht(string name)
{
	string daten;
	string einname;
	int ende;
	int i;
	ende=0;
	i=0;
	daten= read_file("/d/andracia/yondala/wolken/lunia/portale/portal_piraten_zugang.lpc");
	einname="";
	
	for(ende=0;ende<=strlen(daten);ende++)
	{
		if(daten[ende]==10 || ende == strlen(daten))
		{
			if(einname==capitalize(name)) return 1;
			i++;
			einname="";
		}		
		else einname=einname+daten[ende..ende];			
		
	}
	return 0;
}

//Hier wird in der Langbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_LONG);
   result += GetExits(viewer);
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);

	if(testobgemacht(TPN))
    result += "Ein knoechernes Portal.\n";
  return result;
}

//Hier wird in der Kurzbeschreibung geprueft, ob der Spieler das Portal
//sehen kann. Wenn ja, so sieht es aus wie ein Item, das im Raum steht	
string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  string result;
  result = QueryProp(P_INT_SHORT);
  result += "\n";
  result += GetExits(viewer);
	if(testobgemacht(TPN))
    result += "Ein knoechernes Portal.\n";  
  result += make_invlist(viewer, all_inventory(ME)-({viewpoint}), shortflag);
  return result;

}


//Es wird geprueft, ob der Spieler das Portal benutzen kann
//Wenn ja, wird er nach Aboriville teleportiert
int betreten(string str)
{
/*if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) return 0;*/
if(!testobgemacht(TPN))	return 0;			
				
  notify_fail("Was moechtest Du betreten?\n");
  if(str!="portal") return 0;
  //An dieser Stelle noch SP abziehen, fuer Spieler: SP=Level
 // fuer Seher: SP=5+random(5)  
  
  write("Du betrittst das knoecherne Portal.\n");
  say(TPN+" betritt das knoecherne Portal.\n");
  TP->SetProp(P_PARALYZED, 0);
  TP->move( "/d/andracia/yondala/wolken/lunia/room/portalraum_piraten.lpc", M_NOCHECK);
  call_other("/d/andracia/yondala/wolken/lunia/room/portalraum_piraten", "wirbeltext", TP, 0, 1);
  
  return 1;
}

//Details fuer das Portal
string erlaubtenamen()
{
  string alle;
  if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";
  alle=	"Auf den Saeulen wurden folgende Namen eingepraegt:\n"+ read_file("/d/andracia/yondala/wolken/lunia/portale/portal_piraten_zugang.lpc");
	return alle;
}

string det_portal()
{
if(!testobgemacht(TPN))
				return "Sowas siehst Du da nicht!\n";
				
return "Du siehst ein Portal aus verwitterten Knochen. Es besteht aus einem knoechernen "+
	"Bogen, der auf zwei knoechernen Saeulen ruht. Ob man es betreten kann?\n"; 
} 

string det_bogen()
{
if(!testobgemacht(TPN)) 
				return "Sowas siehst Du da nicht!\n";

return "In den Bogen wurde das Wort \"Lunia\" gepraegt.\n"; 
} 
string det_saeulen()
{
 /* if(!call_other(LUNIA_ROOM + "portal_master", 
                "einzelname_pruefen", "aboriville", TPN)) */
if(!testobgemacht(TPN))
	return "Sowas siehst Du da nicht!\n";

return "In die Saeulen wurden Namen gedruckt.\n"; 
} 
string det_luni()
{
if(!testobgemacht(TPN)) return "Sowas siehst Du da nicht!\n";

return "Was mag das nur bedeuten?\n"; 
} 

void create() 
{
  ::create();
//*************************************************************************
//Portal

  AddSpecialDetail( ({ "portal" }),"det_portal");
  AddSpecialDetail( ({ "bogen" }),"det_bogen");
  AddSpecialDetail( ({ "lunia" }),"det_luni");
  AddSpecialDetail( ({ "saeulen" }),"det_saeulen");
  AddSpecialDetail( ({ "namen" }),"erlaubtenamen");

  AddCmd( ({ "betrete","betret","betritt"}), "betreten" );

  //***********************************************************************


  SetProp( P_INT_SHORT, "Zwischen Ranken" );
  SetProp( P_INT_LONG,
    "Du haengst mehr oder weniger bequem zwischen einigen Ranken. Allerdings glaubst Du "
    "Dich hier ziemlich sicher, denn hierhoch wird sicher niemand unbemerkt klettern koennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "ranken" }),
    "Ranken, Ranken, ueberall nur Ranken. Sonst siehst Du nichts.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur ein leises Rascheln.");

  AddSound( ({ "rascheln","ranken" }),
    "Die Ranken reiben aneinander.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht gruen.");

  AddSmell( ({ "gruen" }),
    "Kuehe koennen nicht fliegen.");
  AddSmell( ({ "kuehe" }),
    "Muh.");

  AddRoomMessage( 
    ({""}),30,"func");

 AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );

//       AddExit( "unten", "/d/pirateninsel_8c" );

}




kletternCmd(string str )
{
  notify_fail( "Wo willst Du hin klettern?\n" );
  if( str == "runter" )
{
  	TP->move(PIR_ROOM + "piratengrotte_5f", M_GO,
  	"","klettert runter","kommt herab geklettert");
    return 1;

  }
  return 0;
}


void check()
{
  // Spieler noch da?
  if (TP && interactive(TP) && (environment(TO)==environment(TP)))
  {
    if (TP->Query_Prop(P_INVIS )==1)  // Ist er unsichtbar?
    {write("Auch wenn Du unsichtbar bist wurdest Du beim hochklettern gesehen.");
      say(TPN+" betritt den Raum!\n",TP);
    }
   
  }
}	