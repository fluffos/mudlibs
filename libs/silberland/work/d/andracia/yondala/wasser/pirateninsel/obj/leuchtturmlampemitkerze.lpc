#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse Lampe");
  SetProp(P_LONG,
    "Eine grosse Lampe in der eine Kerze steckt." );
  SetProp(P_NAME, "Lampe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lampe", "\nleuchtturmlampe"}));

    SetProp( P_MATERIAL, ([ MAT_GLASS : 60, MAT_IRON : 40 ]) );

  SetProp(P_WEIGHT, 1150);
  SetProp(P_VALUE, 263);

 AddCmd( ({ "hol", "hole", "nimm" }), "holenCmd" ); 

 
}



int holenCmd(string str )
{
  notify_fail( "Was moechtest du woraus holen?\n" );
  if( str == "kerze aus laterne"||str == "kerze aus lampe" )
  {
    write("Du nimmst die Kerze aus der Laterne.\n");
    say( TPN+" nimmt eine Kerze aus einer Laterne.\n", TP);
      CLONE( PIR_OBJ +"leuchtturmlampeohnekerze", TP);
      CLONE( PIR_OBJ +"kerze", TP);
 		this_object()->remove();
    return 1;
    
  }
  return 0;
}