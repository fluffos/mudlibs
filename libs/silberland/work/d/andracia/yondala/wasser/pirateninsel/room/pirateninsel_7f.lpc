// Ueberarbeitet fuer das Silberland
// Yondala@Silberland 27.04.2010
#include "../def.h"
inherit "std/room";

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Zwischen den Duenen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten zwischen den Duenen. Der Boden auf dem Du "
	"stehst besteht aus warmem, weichem Sand. Die Sonne steht an einem "
	"strahlend blauem Himmel und lacht auf Dich herunter. Das Laufen hier "
	"ist recht muehsam, da Du immer wieder einsinkst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "duenen" }),
    "Duenen sind Huegel aus Sand, die von Wind und Meer angetragen "
	"wurden.");
  AddDetail( ({ "huegel", "huegeln" }),
    "Du befindest Dich zwischen Huegeln aus Sand.");
  AddDetail( ({ "wind" }),
    "Du bist hier durch die Duenen relativ windgeschuetzt.");
  AddDetail( ({ "meer" }),
    "Du kannst das Meer rauschen hoeren. Ausserdem schmeckt die Luft "
	"salzig.");
  AddDetail( ({ "ferne" }),
    "Es kann nicht mehr weit sein.");
  AddDetail( ({ "sand" }),
    "Du stehst auf ihm.");
  AddDetail( ({ "laufen" }),
    "Du stakst ueber den Sand. Das ist sehr anstrengend.");
  AddDetail( ({ "grasbueschel", "gras" }),
    "Das Gras waechst hier nur sehr spaerlich.");

  AddDetail( ({ "laufen" }),
    "Du schleppst Dich muehsam durch den Sand.");
  AddDetail( ({ "luft" }),
    "Die Luft ist warm.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht fast nur aus Sand. Nur hin und wieder kann sich "+
	"ein Grasbueschel halten.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint warm auf Dich herab.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer", "rauschen" }),
    "Du kannst das Meer rauschen hoeren. Es scheint also nicht weit "+
	"entfernt zu sein.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht salzig nach Meer.");

  AddSmell( ({ "meer" }),
    "Es riecht salzig und fischig.");
  AddSmell( ({ "luft", "salz" }),
    "Die salzige Luft tut Dir gut, Du atmest tief ein und wieder aus.");

  AddExit( "norden", PIR_ROOM + "pirateninsel_6f" );
  AddExit( "suedwesten", PIR_ROOM + "pirateninsel_8e" );

}

