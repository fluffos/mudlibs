//Christobal, der alles weiss.

#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
inherit "std/npc";



void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Christobal, der Weltenbummler");
  SetProp(P_LONG,
    "Du siehst einen Mann mittleren Alters. Sein wettergegerbtes Gesicht wird von "
    "braunen Haaren umrahmt, die an den Schlaefen schon leicht ergraut sind. Christobal "
    "scheint sehr viel zu reisen und hat daher sicherlich ein grosses Wissen ueber diese Welt." );
  SetProp(P_NAME, "Christobal");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
   AddId(({"christobal","mann","weltenbummler","chris"}));
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit heiliger Macht",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
	SetProp(P_LOG_INFO,"christobal");
  
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, 200);

  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);

  SetProp(P_MSGIN, "kommt an"); 
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " sackt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt: Das weiss ich noch nicht, kommt doch spaeter wieder.\n");

//***************************************
//**** INFOS********************
//Gemischstes
  AddInfo( ({"stadt","staedte"}), 
    "Welche Stadt meint Ihr? Es gibt derer viele in Andracia.",
    "sagt: "); 
  AddInfo( ({"andracia"}), 
    "Das ist das Land, in dem Ihr Euch befindet.",
    "sagt: "); 
  AddInfo( ({"land"}), 
    "Ihr befindet Euch in dem wunderbaren Land Andracia.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
//****Zwirbelstein
//******Zauberer
  AddInfo( ({"goliath kupferfeld","goliath","kupferfeld"}), 
    "Goliath Kupferfeld ist der Vorsteher des Zaubererzirkels.",
    "sagt: "); 

  
//****************************
// Elfen
  AddInfo( ({"elfen", "elfenrassen"}), 
    "Es gibt zwei Elfenrassen: Die Waldelfen und die Blauelfen.",
    "sagt: ");
//Waldelfen
  AddInfo( ({"waldelfen"}), 
    "Die Waldelfen leben in einem grossen Tal, welches von maechtigen Bergen umgeben ist. Sie "
    "nennen ihre Stadt Aboriville.",
    "sagt: ");
  AddInfo( ({"aboriville"}), 
    "So heisst die Stadt der Waldelfen.",
    "sagt: ");
  AddInfo( ({"stammbaum"}), 
    "Ayala moechte einen Stammbaum all ihren Nachkommen anfertigen, vielleicht koenntet Ihr ihr "
    "helfen?",
    "sagt: "); 
  AddInfo( ({"zweig","zweig des lebens"}), 
    "Waldelfen tragen den Zweig des Lebens mit sich. Er verbindet sie untereinander und hilft "
    "ihnen dabei ihre Lebenspunkte und Magie besser im Auge zu behalten.",
    "sagt: "); 
//  AddInfo( ({ "schwur", "schwoeren"}), #'schwur);//'
//*****Gierlinge
  AddInfo( ({"gierlinge"}), 
    "Die Gierlinge gehoeren zur Familie der Kobolde. Sie sind hauptsaechlich im Gebirge anzutreffen.",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 



//******************************
//Quests  
  AddInfo( ({"quests"}), 
    "Quests kenne ich mehrere in Andracia, welche meint Ihr denn?",
    "sagt: "); 
  AddInfo( ({"scrollan"}), 
    "Scrollan in ein Gierlingsmaedchen, dass dringend hilfe dabei braucht ihr Armband wieder zu finden.",
    "sagt: "); 
  AddInfo( ({"kuchen","kuchen fuer das burgfraeulein","burgfraeulein"}), 
    "Erna Kollwanst benoetigt Eure Hilfe um fuer das Burgfraeulein einen Kuchen zu backen.",
    "sagt: "); 
  AddInfo( ({"erna","erna kollwanst"}), 
    "Erna Kollwanst ist die Koechin auf Burg Zwirbelstein.",
    "sagt: "); 
  AddInfo( ({"ungeziefer","ungeziefer auf burg zwirbelstein"}), 
    "Edorian von Zwirbelstein ist auf der Suche nach einem Kammerjaeger der ihm hilft seiner Ungezieferplage Herr zu werden.",
    "sagt: "); 
  AddInfo( ({"edorian","edorian von zwirbelstein"}), 
    "Edorian von Zwirbelstein ist der Freiherr der gleichnamigen Burg.",
    "sagt: "); 
  AddInfo( ({"der besondere magiestein","besonderer magiestein","besonderen magiestein"}), 
    "Prallecred hat einen Botengang zu vergeben. Vielleicht koennte Ihr ihm helfen?",
    "sagt: "); 
  AddInfo( ({"prallecred"}), 
    "Prallecred ist der Verwalter der Zaubererzunft.",
    "sagt: "); 
  AddInfo( ({"kranke elfe","kranker elfe","hilf der kranken elfe"}), 
    "In Aboriville lebt eine Elfe die derzeit sehr krank ist. Sie liegt sicher gerade in ihrem Bett, vielleicht koennt Ihr ihr den ein oder anderen Dienst erweisen?",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 

     
 
  SetProp (P_REJECT, ({ REJECT_GIVE, " moechte das nicht haben" }) );
    

  
  

}
	
	
void gift(object enemy, int damage, mixed dam_type) 
{
	enemy->AddPoison(random(2));
}




