void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Fetzen Pergament");
  SetProp(P_LONG,
    "Der Fetzen sieht aus wie ein Stueck von einer Karte, leider kannst "
    "Du die Zeichen nicht entziffern, Du musst wohl erst alle Teile zusammenfuegen." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Papier");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kartenteil", "papier", "fetzen", "pergament"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddDetail( ({ "stueck" }),
    "Keine ganze.");    
  AddDetail( ({ "zeichen" }),
    "Wirre Linien und abgetrennte Buchstaben, Du kannst keinen Sinn erkennen.");    
  AddDetail( ({ "sinn" }),
    "Du kannst leider keinen erkennen, dazu musst Du wohl erst die ganze "
    "Karte zusammen gesetzt haben.");    
  AddDetail( ({ "linien", "buchstaben" }),
    "Du siehst keinen Sinn darin."); 
 

	  AddCmd( ({ "fuege", "fueg", "setze","setz" }), "setzenCmd" ); 	    
 }
  
setzenCmd(string str )

{	
	object ob;
	notify_fail( "Was moechtest Du aneinander fuegen?\n" );
	
	if(str=="teile aneinander"||str=="teile zusammen"||str=="karte zusammen"||
	str=="kartenteile aneinander"||str=="kartenteile zusammen")
	if(id("KARTE1")&&present("KARTE2", TP) && present("KARTE3",TP) &&present("KARTE4",  TP))
	{
	  write("Du haeltst die vier Teile aneinander. Wie durch ein Wunder "+
	        "fuegen Sie sich zu einer ganzen Karte zusammen.\n");
      say( TPN+" setzt eine Karte zusammen.\n",TP);
	  CLONE(PIR_OBJ +"piratenschatzkarte", TP);
	  present ("KARTE2", TP)->remove();
	  present ("KARTE3", TP)->remove();
	  present ("KARTE4", TP)->remove();	  
	  remove(); 
	 return 1;
	 }
	else if(id("KARTE2")&&present("KARTE1", TP) && present("KARTE3",TP) &&present("KARTE4",  TP))
	{
	  write("Du haeltst die vier Teile aneinander. Wie durch ein Wunder "+
	        "fuegen Sie sich zu einer ganzen Karte zusammen.\n");
      say( TPN+" setzt eine Karte zusammen.\n",TP);
	  CLONE(PIR_OBJ +"piratenschatzkarte", TP);
	  present ("KARTE1", TP)->remove();
	  present ("KARTE3", TP)->remove();
	  present ("KARTE4", TP)->remove();	  
	  remove(); 
	 return 1;
	 }
	else if(id("KARTE3")&&present("KARTE1", TP) && present("KARTE2",TP) &&present("KARTE4",  TP))
	{
	  write("Du haeltst die vier Teile aneinander. Wie durch ein Wunder "+
	        "fuegen Sie sich zu einer ganzen Karte zusammen.\n");
      say( TPN+" setzt eine Karte zusammen.\n",TP);
	  CLONE(PIR_OBJ +"piratenschatzkarte", TP);
	  present ("KARTE1", TP)->remove();
	  present ("KARTE2", TP)->remove();
	  present ("KARTE4", TP)->remove();	  
	  remove(); 
	 return 1;
	 }
    else if(id("KARTE4")&&present("KARTE1", TP) && present("KARTE2",TP) &&present("KARTE3",  TP))
	{
	  write("Du haeltst die vier Teile aneinander. Wie durch ein Wunder "+
	        "fuegen Sie sich zu einer ganzen Karte zusammen.\n");
      say( TPN+" setzt eine Karte zusammen.\n",TP);
	  CLONE(PIR_OBJ +"piratenschatzkarte", TP);
	  present ("KARTE1", TP)->remove();
	  present ("KARTE2", TP)->remove();
	  present ("KARTE3", TP)->remove();	  
	  remove(); 
	 return 1;
	 }

	else 
	{write ("Du hast noch nicht alle Kartenteile zusammen.\n"); 
	return 1;
	}
			return 0;
}