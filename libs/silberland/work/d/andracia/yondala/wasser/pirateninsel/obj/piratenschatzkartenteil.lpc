// Wenn ein Spieler 4 Teile hat fuegen die sich zur kompletten Karte zusammen



#include "../def.h"
inherit "std/thing";
#include <properties.h>

object obj1;
object obj2;
object obj3;

void zahlkriegen(int i) 
{
  AddId(({"KARTE"+i}));
    SetProp(P_SHORT, "Ein Fetzen Pergament <"+i+">");

}
