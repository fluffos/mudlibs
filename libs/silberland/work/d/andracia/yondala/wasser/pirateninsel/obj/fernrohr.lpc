#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Fernrohr");
  SetProp(P_LONG,
    "Du siehst ein hoelzernes Fernrohr, es ist blank poliert und besitzt zwei Linsen." );
  SetProp(P_INFO, BS("Mit \"suche *spielername*\" kannst Du andere Spieler beobachten.") );
  SetProp(P_NAME, "Fernrohr");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fernrohr", "rohr"}));

  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_GLASS}));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 5000);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);

 AddCmd( ({ "suche" }), "suchen" ); 
 
}
int suchen(string str )
{
	object gesuchter, raum;
	object rauminhalt;
	string umgebung;
  notify_fail( "Wen moechtest Du suchen?\n" );
  if( !str ) return 0;
  if(find_player(str))
  	{
  		gesuchter = find_player(str);
  		if(TP->QueryProp(P_SP)<5)
  			{
  				write("Dazu hast Du nicht genug Magie.\n");
  				return 1;
  			}
  		TP->AddSp(-5);
  		if(query_wiz_level(gesuchter)>9)
  			{
  				write("Die Adeligen moechten nicht beobachtet werden.\n");
  				return 1;
  			}
  		else
  			{
  				raum=environment(gesuchter);
  				umgebung=raum->QueryProp(P_INT_LONG);
  				umgebung += raum->GetExits(gesuchter);
  				for(rauminhalt=first_inventory(raum);rauminhalt;rauminhalt=next_inventory(rauminhalt)) 
        		{
         			umgebung+=capitalize(rauminhalt->name())+".\n";  
        			}
  				write("Du suchst "+ gesuchter->name(WEN)+" und siehst folgendes:\n"+umgebung+"\n");
  				if(gesuchter->CanNotSee(1)==0)
  					tell_object(gesuchter, "In der Ferne blitzt irgendwo ein Fernglas auf.\n");
  					
  				return 1;
  			}
  		}
  else
  	{
  		write("So jemanden siehst Du nicht.\n");
  		return 1;
  	}

  
  return 0;
}