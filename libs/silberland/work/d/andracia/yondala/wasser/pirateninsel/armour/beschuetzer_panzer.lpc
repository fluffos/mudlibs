#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein schwerer, silberner Panzer");
  SetProp(P_LONG,
    "Du siehst eine schwere, silberne Ruestung vor Dir. Sie ist an den "
    "Raendern leicht verziert und hat weder Dellen noch Kratzer." );
  SetProp(P_NAME, "Panzer");
  SetProp(P_NAME_ADJ, "schwer"); 
  SetProp(P_NAME_ADJ, "silbern"); 
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "ruestung", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 32);
  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 6000);
  SetProp(P_QUALITY_DECAY, 100);


  SetProp(P_DAM_PROTECTION, DT_WATER);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );
  SetProp(P_M_ATTR_MOD,([A_INT:-2,A_STR:3]));
}

