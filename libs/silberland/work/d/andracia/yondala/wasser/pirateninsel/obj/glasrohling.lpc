
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Glasrohling");
  SetProp(P_LONG,
    "Ein Glasrohling, aus dem man sicher noch etwas machen kann." );

  SetProp(P_NAME, "Glasrohling");
  SetProp(P_GENDER, MALE);
  AddId(({"glasrohling", "\glasrohling"}));

  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100);
 
AddCmd( ({ "blas", "blase" }), "blasenCmd" ); 

}
int blasenCmd(string str )
{
  notify_fail("Was moechtest Du worueber blasen?\n");
	if (str == "glasrohlig ueber feuer"||str == "glas ueber feuer"||
	str == "glasrohlig ueber feuerstelle"||str == "glas ueber feuerstelle")
	{
      if( file_name(environment(TP)) == PIR_ROOM+"piratengrotte_4f") 
	  {
	    write("Du steckst den Glasrohling auf ein Blasrohr, haeltst ihn ins "
			"Feuer und beginnst zu blasen.\n");
      CLONE(PIR_OBJ +"glashuelle", TP);
	  remove();
	  return 1;
	}

	else //wenn raum nicht stimmt
	  write("Hier ist keine geeignete Feuerstelle. Du solltest Trogurts "+
	        "Schmiede aufsuchen.\n");
    return 1;
   }
return 0;
}

