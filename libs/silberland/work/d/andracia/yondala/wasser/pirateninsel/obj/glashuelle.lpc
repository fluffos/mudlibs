
#include "../def.h"

inherit "std/thing";

#include <properties.h>
object obj;
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Glashuelle");
  SetProp(P_LONG,
    "Eine Glashuelle, die zum Bau von Laternen benoetigt wird." );

  SetProp(P_NAME, "Glashuelle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"glashuelle", "\nglashuelle"}));

  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 290);
  SetProp(P_VALUE, 150);
 
AddCmd(({"passe", "pass"}), "passenCmd"); 
}



passenCmd(string str )
{
  notify_fail("Was moechtest Du worein passen?\n");
  if (str == "glas in gestell"||str == "glashuelle in gestell"||
	str == "glas in lampengestell"||str == "glashuelle in lampengestell"||
	str == "glashuelle in lampengestell ein")
	{
	if(present("lampengestell",  TP)) //wenn denn das Lampengestell da ist
		{
		  obj = present("lampengestell",  TP);
		  write("Du fuegst den Glasrohling in das Lampengestell ein. "+
			    "Es passt zwar genau, ist aber noch nicht fest genug.\n");
          CLONE(PIR_OBJ +"leuchtturmlampeohnekitt", TP);
	      obj->remove(); //entferne lampengestelle
		  this_object()->remove(); //entferne dich selbst
			return 1;
		}

		else //wenn kein Lampengestell da
			write("Du hast kein Lampengestell.\n");
return 1;
}}

