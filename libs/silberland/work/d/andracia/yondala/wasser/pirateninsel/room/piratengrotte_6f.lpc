#include "../def.h"

inherit "std/room";

#include <properties.h>


void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}


void reset()
{
  AddDetail( ({ "wachs" }),
    "Das Wachs tropft hin und wieder herunter. Jetzt, wo Du genau hin "
	"siehst entdeckst Du einen kleinen Wachsklecks auf dem Teppich.");
  AddDetail( ({ "wachsklecks","klecks" }),
    "Das sieht wirklich unschoen aus. Man sollte ihn abknibbeln.");
  tell_room(TO,"Etwas Wachs tropft von einer Kerze auf den Teppich.\n");
  ::reset();
  }
void create() 
