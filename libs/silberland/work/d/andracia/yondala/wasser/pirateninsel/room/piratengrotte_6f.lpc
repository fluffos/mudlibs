AddExit( "westen", PIR_ROOM + "piratengrotte_6e" ); 


}
int sitzen(string str)
{
  notify_fail("Worauf moechtest Du sitzen?\n");
  if(str=="auf schemel")
  { 
    write("Du setzt Dich kurz auf den Schemel. Da er aber recht unbequem "+
	      "ist stehst Du wieder auf.\n");
    say(TPN+" setzt sich kurz auf den kleinen Schemel.\n",TP);
	return 1;
	}
  if(str=="auf stuhl"||str=="auf thron")
  {
      write("Gerade als Du Dich setzen willst, kommt Dir der Gedanke, "+
	  "dass das dem Besitzer des Stuhls wohl nicht recht waere. Und da "+
	  "Du heute keinen Streit anfangen willst, verzichtest Du lieber.\n");
	  return 1;
   }
  notify_fail("Worauf moechtest Du sitzen?\n");
  if(str=="auf bank"||str=="auf sitzbank")
  { 
    write("Du setzt Dich kurz auf die Sitzbank.\nJa, recht bequem. Aber "+
	      "langweilig. Du stehst wieder auf.\n");
    say(TPN+" setzt sich kurz auf eine Sitzbank.\n",TP);
	return 1;
	}

  }
//koennen Spieler, aber auch Sklavin Hildgunde machen
int knibbeln(string str)
{
 notify_fail("Was moechtest Du abknibbeln?\n");
 if(str=="wachs ab"||str=="wachsklecks ab"||str=="wachsklecks ab")
 {
   if(!GetDetail("klecks"))
   {
     write("Hier ist kein Wachsklecks.\n");
	 return 1;
	 }
    write("Du kniest Dich hin und knibbelst solange an dem Wachsklecks "+
	      "herum, bis er nicht mehr zu sehen ist.\n");
    say(TPN+" kniet sich hin und knibbelt einen Wachsklecks vom Teppich.\n");	 
	 AddDetail( ({ "wachs" }),
    "Das Wachs tropft hin und wieder herunter. Komisch, dass Du keinen "
	"Wachsklecks auf dem Teppich siehst. Vermutlich reinigt hier jemand "
	"regelmaessig.");
    RemoveDetail( ({ "wachsklecks","klecks" }));
    return 1;
 }
 return 0;
}

int oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str=="schrank"||str=="schraenke"||str=="schranktuer"||
     str=="schranktueren"||str=="tuer"||str=="tueren")
  {
    write("Du ruettelst an der Schranktuer. Leider ist der Schrank fest "+
	      "verschlossen.\n");
    say(TPN+" ruettelt an einer Schranktuer, bekommt sie aber nicht "+
           "auf.\n",TP);		  
    return 1;
   }
  if(str=="truhe"||str=="schloss")
  {
    write("Das Schloss hindert Dich daran, die Truhe zu oeffnen.\n");
	say(TPN+" macht sich an der Truhe zu schaffen.\n");
	return 1;
	}
  if(str=="truhe mit schluessel"||str=="schloss mit schluessel")
  {
    write("Du hast nicht den richtigen Schluessel dabei.\n");
	say(TPN+" macht sich an der Truhe zu schaffen.\n");
	return 1;
	}
return 0;
}
		  
		  
		  
		  
		  
		  
		  
		  
