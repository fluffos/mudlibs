#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int sorte=random(4);
int quali=random(4);
int welcher=random(2);
int hpdazu =1;
int spdazu =1;
string qualistring;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
switch (quali)
{
	case 0:
		{
			  SetProp(P_AC,1 );
  			SetProp(P_QUALITY_DECAY, 50);
 			  qualistring="schlecht";
				//AddAdjective( ({ "schlecht" }) );
				SetProp(P_VALUE, 1000);
				switch(welcher)
				{
					case 1:{				
						SetProp(P_M_HEALTH_MOD,([P_HP:1]));
						break;}
						case 0:{						
							SetProp(P_M_HEALTH_MOD,([P_HP:1]));
							break;}
						}

				break;
			}
	case 1:
		{
			  SetProp(P_AC, 2);
  			SetProp(P_QUALITY_DECAY, 75);
 			  qualistring="mittelmaessig";
				SetProp(P_VALUE, 1500);
				hpdazu+=2;
				switch(welcher)
				{
					case 1:{				
						SetProp(P_M_HEALTH_MOD,([P_HP:3]));
						break;}
						case 0:{						
							SetProp(P_M_HEALTH_MOD,([P_HP:3]));
							break;}
						}
						break;

			}
	case 2:
		{
			  SetProp(P_AC, 3);
  			SetProp(P_QUALITY_DECAY, 100);
 			  qualistring="gut";
				SetProp(P_VALUE, 2000);
				hpdazu+=4;
				switch(welcher)
				{
					case 1:{				
						SetProp(P_M_HEALTH_MOD,([P_HP:5]));
						break;}
					case 0:{						
				  	SetProp(P_M_HEALTH_MOD,([P_HP:5]));
						break;}
						}
break;
			}
	case 3:
		{
			  SetProp(P_AC, 4);
  			SetProp(P_QUALITY_DECAY, 125);
 			  qualistring="sehr gut";
			  SetProp(P_VALUE, 2500);
				hpdazu+=6;
				switch(welcher)
				{
					case 1:{				
						SetProp(P_M_HEALTH_MOD,([P_HP:7]));
						break;}
					case 0:{						
						SetProp(P_M_HEALTH_MOD,([P_HP:7]));
						break;}
						}
break;
			}

	}
			  SetProp(P_NAME_ADJ, qualistring);				

switch (sorte)
{
	case 0:
		{
			SetProp(P_SHORT, "Ein "+qualistring+"er Diamantring");
  		SetProp(P_LONG,
    		"Du siehst einen schoenen, glaenzenden Diamantring." );
//  		SetProp(P_INFO, BS(".") );
  		SetProp(P_NAME, "Diamantring");
  		AddId( ({"diamantring", "ring", ""}) );
      SetProp(P_MATERIAL, ([ MAT_GOLD:80, MAT_DIAMOND:20 ]) );
		  AddProp(P_DAM_PROTECTION, ([DT_EXPLOSION]) );  		
			
			switch(quali)
			{
				case 0:
				{
					SetProp(P_M_ATTR_MOD,([A_STR:-1]));
					break;
					}
					
				case 1:
				{
					SetProp(P_M_ATTR_MOD,([A_STR:1]));
					break;
					}
				case 2:
				{
					SetProp(P_M_ATTR_MOD,([A_STR:2]));
					break;
					}
				case 3:
				{
					SetProp(P_M_ATTR_MOD,([A_STR:4,A_DEX:-1]));
					break;
					}
break;
}
		}
	case 1:
		{
			SetProp(P_SHORT, "Ein "+qualistring+"er Rubinring");
  		SetProp(P_LONG,
    		"Du siehst einen schoenen, glaenzenden Rubinring." );
//  		SetProp(P_INFO, BS(".") );
  		SetProp(P_NAME, "Rubinring");
  		AddId( ({"rubinring", "ring", ""}) );
      SetProp(P_MATERIAL, ([ MAT_GOLD:80, MAT_RUBY:20 ]) );
		  AddProp(P_DAM_PROTECTION, ([DT_FIRE]) );  

			switch(quali)
			{
				case 0:
				{
					SetProp(P_M_ATTR_MOD,([A_INT:-1]));
					break;
					}
					
				case 1:
				{
					SetProp(P_M_ATTR_MOD,([A_INT:1]));
					break;
					}
				case 2:
				{
					SetProp(P_M_ATTR_MOD,([A_INT:2]));
					break;
					}
				case 3:
				{
					SetProp(P_M_ATTR_MOD,([A_INT:4,A_STR:-1]));
					break;
					}

		}		
			break;
		}
	case 2:
		{
			SetProp(P_SHORT, "Ein "+qualistring+"er Smaragdring");
  		SetProp(P_LONG,
    		"Du siehst einen schoenen, glaenzenden Smaragdring." );
 // 		SetProp(P_INFO, BS(".") );
  		SetProp(P_NAME, "Smaragdring");
  		AddId( ({"smaragdring", "ring", ""}) );
      SetProp(P_MATERIAL, ([ MAT_GOLD:80, MAT_EMERALD:20 ]) );
		  AddProp(P_DAM_PROTECTION, ([DT_POISON]) );  		
			switch(quali)
			{
				case 0:
				{
					SetProp(P_M_ATTR_MOD,([A_CON:-1]));
					break;
					}
					
				case 1:
				{
					SetProp(P_M_ATTR_MOD,([A_CON:1]));
					break;
					}
				case 2:
				{
					SetProp(P_M_ATTR_MOD,([A_CON:2]));
					break;
					}
				case 3:
				{
					SetProp(P_M_ATTR_MOD,([A_CON:4,A_INT:-1]));
					break;
					}

		}		
			break;
		}
	case 3:
		{
			SetProp(P_SHORT, "Ein "+qualistring+"er Saphirring ");
  		SetProp(P_LONG,
    		"Du siehst einen schoenen, glaenzenden Saphirring." );
 			SetProp(P_NAME, "Saphirring");
  		AddId( ({"saphirring", "ring", ""}) );
      SetProp(P_MATERIAL, ([ MAT_GOLD:80, MAT_SAPPHIRE:20 ]) );
		  AddProp(P_DAM_PROTECTION, ([DT_COLD]) );  		
			switch(quali)
			{
				case 0:
				{
					SetProp(P_M_ATTR_MOD,([A_DEX:-1]));
					break;
					}
					
				case 1:
				{
					SetProp(P_M_ATTR_MOD,([A_DEX:1]));
					break;
					}
				case 2:
				{
					SetProp(P_M_ATTR_MOD,([A_DEX:2]));
					break;
					}
				case 3:
				{
					SetProp(P_M_ATTR_MOD,([A_DEX:4,A_CON:-1]));
					break;
					}

		
			break;
		}
	}
}

  SetProp(P_GENDER, MALE);

  SetProp(P_ARMOUR_TYPE, AT_RING );




	//1 - 7 hp dazu

  //SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEIGHT, 15);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );                     

// Nur fuer Seher
  SetProp(P_WEAR_RESTRICTIONS, SR_SEER );
}

int WearFunc(object me) {

  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}
