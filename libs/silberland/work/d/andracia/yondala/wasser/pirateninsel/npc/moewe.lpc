void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  string *ausgang; //Durch den * wirds zum array
  ausgang = m_indices (environment(TO)-> QueryProp(P_EXITS));
  command(ausgang[random(sizeof(ausgang))]);
  
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

object guck_ob_essbar(object ding)
{if(ding->QueryProp(P_FOOD_INFO))/*
	||ding->QueryMaterial(MAT_MISC_FOOD)
	||ding->QueryMaterial(MAT_BREAD)
	||ding->QueryMaterial(MAT_FRUIT)
	||ding->QueryMaterial(MAT_MUSHROOM)
	||ding->QueryMaterial(MAT_MISC_SPICE)
	||ding->QueryMaterial(MAT_PEPPER)
	||ding->QueryMaterial(MAT_SALT)
	||ding->QueryMaterial(MAT_SUGAR)
	||ding->QueryMaterial(MAT_CANNABIS)
	) */
	return ding;
	}

void schnapp()
{
	object *zeug;//alles, was er bei hat
	object ding;//das eine, auserwaehlte teil, das gegessen wird
	string *ausgaenge;
	
	if(TP&&interactive(TP)&&environment(TP)==environment(TO)&&!InFight())
	  {
		zeug =all_inventory(TP);
	    zeug=filter_array(zeug, "guck_ob_essbar");
	    if(sizeof(zeug)==0)return;
	    ding=zeug[random(sizeof(zeug))];
	    if(!ding) return;//Wenn sie nichts gefunden hat.
	    	
		 	say("Die Moewe kraechzt: MEINS!? \n");	
	 		write("Die Moewe stuerzt sich kreischend auf Dich und stiehlt Dir "+ding->name(WEN)+".\n"); 
	 		say("Die Moewe stuerzt sich kreischend auf "+TP->name(WEN)+" und stiehlt "+
	 		TP->QueryPronoun(WEM)+" "+ding->name(WEN)+".\n",TP); 
	 		ding->remove(1);
	 		ausgaenge = m_indices(environment(TO)->QueryProp(P_EXITS));
      command( ausgaenge[random(sizeof(ausgaenge))] );

	 	}
	}	

