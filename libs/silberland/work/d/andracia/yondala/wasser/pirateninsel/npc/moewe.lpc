//Die Moewe schaut, wer im Raum ist und stiehlt Nahrungsmittel aus dem Inventar und fliegt weiter
//nimmt Nahrung die im Raum liegt

//Ueberarbeitet fuers Silberland
//Yondala@Silberland 14. April 2010

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <food.h>
#include <thing/language.h>


void dieb()
{
  object *zeug;//alles, was er bei hat
	object ding;//das eine, auserwaehlte teil, das gegessen wird
	
		zeug =all_inventory(environment(TO));
	    zeug=filter_array(zeug, "guck_ob_essbar");
	    if(sizeof(zeug)==0)return;
	    ding=zeug[random(sizeof(zeug))];	    	
		//say("Die Moewe kraechzt: MEINS!? \n");	
	 	tell_room(environment(TO),"Die Moewe kraechzt: MEINS!?\n"+
		    "Die Moewe schnappt sich "+ding->name(WEN)+" und verspeisst "+
		    ding->QueryPronoun(WEN)+".\n"); 
	 	ding->remove(1);

	}
void init() {
  if( TP && interactive(TP) && random(5)==0 ) 
    call_out("schnapp", random(8), TP );
  dieb();
}	
	
void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Seemoewe");
  SetProp(P_LONG,
    "Du siehst eine kleine, gefraessige Seemoewe vor Dir. Behalte Deine Nahrungsmittel "
    "im Auge, denn Seemoewen sind sehr listig, wenn sie Hunger haben.");
  SetProp(P_NAME, "Seemoewe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"moewe", "seemoewe", ""}));
  SetChats(3, ({
    "Die kleine Seemoewe beaeugt Dich neugierig.\n", 
    "Die kleine Seemoewe flattert um Dich herum.\n",
    "Die kleine Seemoewe kraechzt laut.\n",}) );



 if (random(2)==1)
 	{
 		SetProp(P_NAME_ADJ, "gross");
    SetProp(P_SHORT, "Eine grosse Seemoewe");
  SetProp(P_LONG,
    "Du siehst eine grosse, gefraessige Seemoewe vor Dir. Behalte Deine Nahrungsmittel "
    "im Auge, denn Seemoewen sind sehr listig, wenn sie Hunger haben.");
  SetChats(3, ({
    "Die grosse Seemoewe beaeugt Dich neugierig.\n", 
    "Die grosse Seemoewe flattert um Dich herum.\n",
    "Die grosse Seemoewe kraechzt laut.\n",}) );

   create_default_npc(2);
  }
  else create_default_npc(1);
  
 

  SetProp(P_ARTICLE, 1);
  SetProp(P_HANDS, ({" mit ihrem spitzen Schnabel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 25);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "faellt vom Himmel");
  SetProp(P_MMSGOUT, "schwingt sich in die Luefte");
  SetProp(P_MNPC_AREA, (PIR_ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, PIR_ROOM "");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Kraaaaah!");
  SetProp(P_KILL_NAME, "Eine kleine Seemoewe");
  SetProp(P_KILL_MSG, "Kraah!");

  AddInfo(DEFAULT_INFO, "kann nicht sprechen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Seemoewe kann Deine Sachen nicht tragen.\n" }) );

}
