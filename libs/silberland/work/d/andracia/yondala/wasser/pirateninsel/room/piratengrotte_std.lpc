#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
void create() 
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp( P_INT_SHORT, "In einer Grotte" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen, duesteren Grotte. Unter Deinen "
    "Fuessen befindet sich ein morscher Steg dessen Planken sich unter "
    "Deinem Gewicht aechzend biegen.");
  AddDetail( ({ "grotte" }),
    "Eine Grotte ist eine natuerliche Hoehle, die von Menschen kuenstlich erweitert wurde.\n");
  AddDetail( ({ "hoehle" }),
    "Diese Grotte ist eine Hoehle.");
  AddDetail( ({ "menschen", "fall" }),
    "In diesem Fall Piraten. Obwohl es natuerlich auch Piraten gibt, die nicht zur Rasse Mensch gehoeren.");
  AddDetail( ({ "piraten" }),
    "Die Piraten haben diese Grotte erweitert und so weit ausgebaut, dass "
    "ein ganzes, schwimmendes Dorf darin Platz hat.");
  AddDetail( ({ "dorf" }),
    "Das Dorf ist unter der Insel gut getarnt und dient den Piraten als Versteck.");
  AddDetail( ({ "versteck" }),
    "Die Piraten muessen sich gut verstecken, denn sie werden gejagt um "
    "fuer ihre Verbrechen zu buessen.");
  AddDetail( ({ "verbrechen" }),
    "Piraten sind boese Menschen, sie morden und stehlen wie es ihnen beliebt.");
  AddDetail( ({ "rasse", "rassen" }),
    "In diesem Land gibt es viele verschiedene Rassen, die den Menschen teilweise sehr aehnlich sind.");
  AddDetail( ({ "land" }),
    "Dieses Land heisst Andracia.");
  AddDetail( ({ "andracia" }),
    "Schoen hier, nicht wahr?");
  AddDetail( ({ "steg" }),
    "Die Piraten haben diesen Steg einst angelegt. Er fuehrt im Innenkreis "
    "des Dorfes entlang und macht keinen all zu stabilen Eindruck.");
  AddDetail( ({ "innenkreis" }),
    "Das Dorf schwimmt auf der Wasseroberflaeche und ist fast kreisfoermig "
    "angeordnet. Innen liegt der Steg ueber den man jedes Haus erreichen kann");
  AddDetail( ({ "eindruck" }),
    "Ach, aber was schon so lange haelt wird jetzt sicher auch noch halten, oder?");
  AddDetail( ({ "dorfes", "dorf" }),
    "Die Piraten haben hier in der Grotte ein verstecktes Dorf angelegt.");
  AddDetail( ({ "wasseroberflaeche", "wasser", "wasserflaeche" }),
    "Das ganze Dorf ist auf dem Wasser schwimmend angelegt.");
  AddDetail( ({ "luft" }),
    "Du weisst schon: Sauerstoff und so.");
  AddDetail( ({ "sauerstoff" }),
    "Sauerstoff ist sehr wichtig fuer alle Lebewesen.");
  AddDetail( ({ "lebewesen" }),
    "Du bist eins. Ich nicht.");
  AddDetail( ({ "ich", "programm" }),
    "Ich bin ein Programm.");
  AddDetail( ({ "boden", "decke" }),
    "Boden, Waende und Decke wurden vom Meer in den Fels gewaschen.");

  AddDetail( ({ "wand", "waende", "licht" }),
    "An den Waenden sind Fackeln angebracht, die ein schummriges Licht verbreiten.");
  AddDetail( ({ "fackeln" }),
    "Die Fackeln verbreiten ein schummriges Licht. Sie sind fest in der Wand verankert.");    
  AddDetail( ({ "fels" }),
    "Der Fels fuehlt sich kalt an und irgendwie etwas feucht.");    
  AddDetail( ({ "meer","falle" }),
    "Steter Tropfen hoehlt den Stein. In diesem Falle hat sich das Meer tausende von Jahren "
    "lang immer weiter in den Fels gegraben.");    
  AddDetail( ({ "tropfen","stein" }),
    "Das ist ein Sprichwort.");    
  AddDetail( ({ "sprichwort" }),
    "Steter Tropfen hoehlt den Stein.");    
  AddDetail( ({ "jahren","jahre" }),
    "Schon immer. Und niemand weiss, wann es enden wird. Und ob diese Grotte nicht "
    "irgendwann hinfort gespuelt wird.");    
  AddDetail( ({ "mensch", "abenteurer","verstossene" }),
    "Urspruenglich gehoerten nur Menschen zur Meute der Piraten. Nach und nach schlossen "
    "sich immer mehr Abenteurer und Verstossene anderer Rassen der Meute an.");    
  AddDetail( ({ "meute" }),
    "So nennt man die zusammengeschlossenen Piraten.");    
  AddDetail( ({ "haus", "haeuser" }),
    "Nun, es handelt sich nicht wirklich um Haeuser, es sind weitere "
	"Hoehlen. Teilweise kuenstlich, teilweise natuerlich.");    
  AddDetail( ({ "platz" }),
    "Wirklich viel Platz ist da nicht, aber er reicht.");    
  AddDetail( ({ "fuesse","fuessen" }),
    "Die Planken knarren und schwanken unter Deinen Fuessen.");    
  AddDetail( ({ "gewicht" }),
    "Ach was, so dick bist Du nicht, was soll schon passieren?");    
  AddDetail( ({ "hoehlen" }),
    "Die Hoehlen, die hier mit dem schwankenden Steg verbunden sind, sind "
	"sehr unterschiedlich. Geh doch einfach hinein um sie zu erkunden.");   
  AddDetail( ({ "planken", "planke" }),
    "Du stehst auf schwankenden Planken.");    

  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Knarren der Planken und das Wasser darunter.");

  AddSound( ({ "planken","knarren" }),
    "Die Planken knarren unter Deinen Fuessen.");

  AddSound( ({ "gurgeln", "wasser", "schmatzen" }),
    "Das Wasser unter den Planken gurgelt und schmatzt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht muffig.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({"Die Planken schwanken unter Deinen Fuessen.\n"}),50,"func");




}

