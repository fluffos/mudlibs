#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <moredef.h>
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse Lampe");
  SetProp(P_LONG,
    "Du siehst eine grosse, ausgebrannte Lampe." );
  SetProp(P_NAME, "Lampe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lampe", "kaputtelampe"}));

  SetProp( P_MATERIAL, ([ MAT_GLASS : 60, MAT_IRON : 40 ]) );
  SetProp(P_WEIGHT, 1150);
  SetProp(P_VALUE, 263);

}


