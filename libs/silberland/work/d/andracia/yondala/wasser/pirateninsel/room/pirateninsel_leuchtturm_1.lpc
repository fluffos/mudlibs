#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Leuchtturm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der ersten Etage des Leuchtturms. Du kannst nach unten oder weiter nach oben gehen. "
    " Dieser Raum ist leer, bis auf die Treppe, die nach oben bzw. unten fuehrt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "wand", "waende" }),
    "Eigentlich nur eine Wand, denn diese ist rund. Es gibt keine Ecken. Ein kleines "
    "Fenster ist in die Wand eingelassen.");
  AddDetail( ({ "ecken" }),
    "Wirklich, es gibt keine. Denk doch mal nach!");
  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Wendeltreppe fuehrt nach oben und nach unten.");
  AddDetail( ({ "fenster" }),
    "Das Fenster ist recht schmutzig. Vielleicht kann man durchsehen?");
  AddDetail( ({ "durch fenster" }),
    "Du erkennst alles nur schemenhaft, das Fenster ist einfach zu schmutzig.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier nur aus Treppe. Du kannst sehen, wo Du herkamst.");
  AddDetail( ({ "decke" }),
    "Die Decke ist weit entfernt ueber Dir, hier ist die Treppe quasi die Decke.");
  AddDetail( ({ "etage", "raum" }),
    "Du befindest Dich auf der ersten Etage des Leuchtturms.");
  AddDetail( ({ "leuchtturm", "leuchtturms" }),
    "Ein Leuchtturm weisst Schiffen den sicheren Weg. Auch wenn sie gar nicht hierher wollen.");
  AddDetail( ({ "schiff","schiffe","schiffen", "piratenschiff","piratenschiffe" }),
    "Schiffe, die zu dieser Insel wollen.");
  AddDetail( ({ "insel" }),
    "Meistens sind das Piratenschiffe.");
  AddDetail( ({ "weg" }),
    "Den Weg hierher.");
  AddDetail( ({ "decke" }),
    "Eine Decke in dem Sinne gibt es hier nicht. Nur die Treppe, die nach "
	"oben fuehrt.");
  AddDetail( ({ "sinne" }),
    "Auch in keinem anderen Sinne.");
  AddDetail( ({ "schmutz" }),
    "Hier ist sicher lange nicht geputzt worden.");

  AddSound( DEFAULT_SOUND,
    "Es ist absolut still.");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht etwas muffig.");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");




AddExit( "oben", PIR_ROOM + "pirateninsel_leuchtturm_2" ); 
AddExit( "unten", PIR_ROOM + "pirateninsel_leuchtturm_eg"  );


}

