#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <moredef.h>
void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Lampengestell");
  SetProp(P_LONG,
    "Ein Lampengestell welches zum Bau von Leuchtturmlampen benoetigt wird." );
  SetProp(P_NAME, "Lampengestell");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lampe", "lampengestell"}));

    SetProp( P_MATERIAL, ([ MAT_GLASS : 60, MAT_IRON : 40 ]) );

  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 600);

AddCmd(({"passe", "pass"}), "passenCmd"); 
}



passenCmd(string str )
{notify_fail("Was moechtest Du worein passen?\n");
	if (str == "glashuelle in lampengestell"||str == "glashuelle in lampengestell ein")
	{
	if(!present("glashuelle",  TP)) //wenn denn das Lampengestell da ist
		{
			write("Du hast keine Glashuelle um sie einzupassen.\n");
		}
else
	if(present("glasrohling", TP))
		{write("Du hast keine Glashuelle dabei. Aber mit dem Rohling laesst "+
						"sich sicher was anfangen...\n");}
	

}}

