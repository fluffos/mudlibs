    "fluestert: ");
  AddInfo( ({"obstkuchen",""}),
    "In Friedheim gab es den besten Obstkuchen, den man sich nur vorstellen kann.",
    "fluestert: ");
  AddInfo( ({"",""}),
    ".",
    "fluestert: ");
  AddInfo( ({"",""}),
    ".",
    "fluestert: ");
  AddInfo( ({"",""}),
    ".",
    "fluestert: ");
  AddInfo( ({"",""}),
    ".",
    "fluestert: ");

   //SetProp(P_LOG_INFO, "yondala");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Hildgunde darf nichts annehmen.\n" }) );
  SetChats(3, ({
    "Hildgunde schwankt und stuetzt sich an der Wand ab.\n",
    "Hildgunde ruehrt mit ihrem Stock in dem Fass.\n",
    "Hildgunde fluestert: Befreit mich bitte.\n",
    "Hildgunde hoert ein Geraeusch und faehrt in sich zusammen.\n",
    "Hildgunde fragt: Seid Ihr gekommen um mich zu befreien?\n",
    "Hildgunde hustet.\n",
    "Hildgunde fast sich an die Huefte und stoehnt vor Schmerz.\n",
    "Hildgunde versucht ihren Ruecken grade zu richten, scheitert aber mit schmerzverzerrtem Gesicht.\n",
    "Hildgunde fragt aengstlich: Habt Ihr Broud gesehen?\n"
    }) );
 
 AddCmd(({"hebe","heb"}), "heben");
 AddCmd(({"befreie","befrei"}), "befreien");
 
  SUID;
  CLONEME("/p/weapon/club/holzstock" );
  command("zuecke stock");
  CLONEME(PIR_ARMOUR +"zerfetztersack" );
  command("trage alles");

}

int befreien(string str)
{
notify_fail("Wen oder was moechtest Du denn befreien?\n");
if(str!="hildgunde") return 0;

//***********************************************************
//Den Teil rausnehmen, sobald Quest frei ist.
//write("Das geht leider noch nicht.\n");
//return 1;
//***********************************************************

if(!present("\nhildgundeschluessel", TP))
{
	write("Du brauchst den passenden Schluessel, um Hildgunde befreien zu koennen.\n");
	return 1;
}
write("Du schliesst die Ketten von Hildgunde auf.\n");
say(TPN+" schliesst die Ketten von Hildgunde auf.\n",TP);
command("sag Habt Dank, "+TPN+"! Ich werde nun zu meinem Vater zurueckkehren!");
TO->move("/players/yondala/room/muellhalde.lpc", M_GO);
present("\nhildgundeschluessel",TP)->remove();
TP->GiveQuest("Befreie Hildgunde");
//Quest geben
remove();
return 1;
}



// Mitloggen wenn einen Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "laechelt Dich schuechtern an.",
        "laechelt "+TPN+" schuechtern an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "seufzt muede.",
        "seufzt muede.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laechelt schwach.",
        "laechelt schwach.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "zuckt mit den Schultern.",
        "zuckt mit den Schultern");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Ihr seid auch nicht schlimmer als Broud, "+TPN+".",
        "sagt: Ihr seid auch nicht schlimmer als Broud, "+TPN+".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "denkt . o O (Wie gerne waere ich auch wieder so unbeschwerrt wie "+TPN+".", 
        "denkt . o O (Wie gerne waere ich auch wieder so unbeschwerrt wie "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Scherrt Euch fort, nur Broud muss ich gefaellig sein!",
        "sagt: Scherrt Euch fort, nur Broud muss ich gefaellig sein!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich argwoehnisch an.",
        "schaut "+TP->name(WEN)+" argwoehnisch an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "erschreckt sich und bekommt einen Hustenanfall.",
        "erschreckt sich und bekommt einen Hustenanfall.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "kann verstehen, wie Du Dich fuehlst.",
        "kann verstehen, wie "+TPN+" sich fuehlt.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int heben(string str)
{
	notify_fail("Was moechtest Du heben?\n");
	if(str=="kugel"||str=="kugel an"||str=="eisenkugel"||str=="eisenkugel an")
		{
			write("Du versuchst die schwere Eisenkugel anzuheben. Sie ist zu schwer.\n");
			say(TPN+" versucht Hildgundes Eisenkugel anzuheben und scheitert dabei.\n",TP);
			return 1;
			}
	return 0;
	
}

