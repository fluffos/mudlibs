  AddInfo( ({"heimat",""}),
    "Ich stamme aus Friedheim und ich will dorthin zurueck.",
    "fluestert: ");
  AddInfo( ({"vater"}),
    "Mein Vater Jonathan und ich lebten in Friedheim. Das ist so weit fort.",
