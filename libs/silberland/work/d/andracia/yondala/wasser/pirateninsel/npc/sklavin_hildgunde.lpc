#include "../def.h"
int befreit;
object retter;
string *weg;//der Weg, den sie ablaeuft.
int grund;//weswegen sie unterwegs ist.

void zurueck_gehen()
{
   string raum;
   raum=file_name(environment(TO));
   if(raum==PIR_ROOM+"piratengrotte_5b")
   {   
      SetChats(3, ({
        "Hildgunde schwankt und stuetzt sich an der Wand ab.\n",
        "Hildgunde ruehrt mit ihrem Stock in dem Fass.\n",
        "Hildgunde fluestert: Befreit mich bitte.\n",
        "Hildgunde hoert ein Geraeusch und faehrt in sich zusammen.\n",
        "Hildgunde fragt: Seid Ihr gekommen um mich zu befreien?\n",
        "Hildgunde hustet.\n",
        "Hildgunde fasst sich an die Huefte und stoehnt vor Schmerz.\n",
        "Hildgunde versucht ihren Ruecken grade zu richten, scheitert "+
		"aber mit schmerzverzerrtem Gesicht.\n",
        "Hildgunde fragt aengstlich: Habt Ihr Broud gesehen?\n"
        }) );
      return;
   }

   if(raum==PIR_ROOM+"piratengrotte_5c")
   command("westen");
   if(raum==PIR_ROOM+"piratengrotte_6c")
   command("norden");
   if(raum==PIR_ROOM+"piratengrotte_6d")
   command("westen");
   if(raum==PIR_ROOM+"piratengrotte_6e")
   command("westen");
   if(raum==PIR_ROOM+"piratengrotte_6f")
   command("westen");
   call_out("zurueck_gehen",2);
}
void putzen4()
{
     tell_room(environment(TO), "Hildgunde denkt   . o O (Das sollte "+
	                            "fuer heute reichen)\n");
	 call_out("zurueck_gehen",2);
	 }


void putzen3()
{
     command("knibbel wachs ab");
	 call_out("putzen4",4);
	 }

void putzen2()
{
     tell_room(environment(TO), "Hildgunde wischt Staub.\n");
	 call_out("putzen3",4);
	 }
void putzen()
{
     tell_room(environment(TO), "Hildgunde poliert die Goldbeschlaege "+
	                            "der Truhe.\n");
	 call_out("putzen2",4);
	 }


void essendochnichtbringen()
{
  tell_room(environment(TO),"Hildgunde zuckt mit den Schultern\n");
  zurueck_gehen();
}
void essenbringen()
{
  if(present("roger",environment(TO)))
  tell_room(environment(TO), "Hildgunde drueckt Roger eine Schale in "
                             "die Hand.\n");
  present("roger",environment(TO))->essenbekommen();
  call_out("zurueck_gehen",2);
}

void angekommen()
{
  if(grund==1) //Roger hat Hunger
   { 
     if(present("roger",environment(TO)))
	 {
	   command("sag Hier hast Du Deinen Frass!\n");
	   call_out("essenbringen",1);
	   }
	 else
	 {
	   command("sag Nu isser weg.\n");
	   call_out("essendochnichtbringen",1);
	   }
	 }
  if(grund==2) //Roger hat Hunger
   {
     tell_room(environment(TO), "Hildgunde faengt an zu putzen.\n");
	 call_out("putzen",3);
	 }
 }
void hin_gehen()
{
   string raum;
   raum=file_name(environment(TO));
   if(raum==PIR_ROOM+"piratengrotte_5b")
   command("osten");
   if(raum==PIR_ROOM+"piratengrotte_5c")
   command("sueden");
   if(raum==PIR_ROOM+"piratengrotte_6c")
   command("osten");
   if(raum==PIR_ROOM+"piratengrotte_6d")
   command("osten");
   if(raum==PIR_ROOM+"piratengrotte_6e")
   command("osten");
   if(raum==PIR_ROOM+"piratengrotte_6f")
   {
   //command("sag angekommen");
   call_out("angekommen",2);
   return;
   }
   call_out("hin_gehen",2);
}


void kochen7()
{
  command("sag Dann bring ich ihm jetzt mal seine Suppe");
  call_out("hin_gehen",4);
}
void kochen6()
{
  tell_room(environment(TO),"Hildgunde grinst.\n");
  call_out("kochen7",4);
}
void kochen5()
{
  tell_room(environment(TO),"Hildgunde spuckt in die Suppe.\n");
  call_out("kochen6",4);
}
void kochen4()
{
  tell_room(environment(TO),"Hildgunde schaut sich um.\n");
  if (!present("pirat"), environment(TO)) call_out("kochen5",4);
  else call_out("kochen5",4);
}
void kochen3()
{
  tell_room(environment(TO),"Hildgunde fuellt etwas Suppe (?) in die Schale.\n");
  call_out("kochen4",4);
}
void kochen2()
{
  tell_room(environment(TO),"Hildgunde nimmt eine Schale aus dem Schrank.\n");
  call_out("kochen3",4);
}
void kochen()
{
  SetChats(0,"");
  tell_room(environment(TO),"Hildgunde ruehrt noch einmal kraeftig in dem Fass.\n");
  call_out("kochen2",4);
}
//wird vom Raum aufgerufen, der sie als Angesprochene identifiziert hat	  
void duwirstgerufen2(string text, string rufer)
{
   object *raeume;
   string rufername;
   rufername=name();
   raeume=({});
   if(rufer=="Roger Schwarzbart")
  {
    if(text=="HILDGUNDE!")
	{
      command("sag Der schon wieder.");
	  tell_room(environment(TO),"Hildgunde ruft zurueck: Was willst Du?\n");
      environment(TO)->einruf("Was willst Du?",rufername, "roger", raeume);

	  }
	 if(text=="Bring mir was zu Essen, Weib!")
	 {
	   tell_room(environment(TO),"Hildgunde rollt mit den Augen.\n");
	   grund=1;
	   call_out("kochen",1, text, rufer);

	 }
	 if(text=="Komm putzen!")
	 {
	   tell_room(environment(TO),"Hildgunde seufzt.\n");
	   grund=2;
	     call_out("hin_gehen",2);//Staubwedel nehmen, hinlaufen starten
	 }	 
	 }
}
	
void duwirstgerufen(string text, string rufer)
{
  tell_room(environment(TO),"Hildgunde hebt den Kopf.\n");
  call_out("duwirstgerufen2",1, text, rufer);
 }


void create() {
  if (!is_clone(TO)) return;
  ::create();
  befreit=0;
 weg=({PIR_ROOM+"piratengrotte_5b",
