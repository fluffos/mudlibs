//Einfach was "teures" als Belohnung, wenn man Eharl schafft.


#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein feiner Anzug");
  SetProp(P_LONG,
    "Du siehst einen kleinen, massgeschneiderten Anzug. Er besteht aus "+
    "edelstem Stoff, die Knoepfe wurden aus purem Gold gefertigt. Dieser "+
	"Anzug war sicherlich sehr, sehr teuer." );
  SetProp(P_NAME, "Anzug");
  SetProp(P_NAME_ADJ, "fein"); 
  SetProp(P_GENDER, MALE);
  AddId( ({"anzug"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 10);

SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 50,
                                   P_GENDER    : MALE]) );
  SetProp(P_DAM_PROTECTION, DT_MAGIC);
}

