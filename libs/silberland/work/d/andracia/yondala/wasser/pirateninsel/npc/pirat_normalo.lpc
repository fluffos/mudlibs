//ein Normalopirat, per random unterschiedlich gross, sonst nichts.

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
inherit PIR_NPC + "pirat_std.lpc";	



int groesse = random(3);
int rasse= random(4);	
void create() {
  if (!is_clone(TO)) return;
  ::create();
 

switch(groesse)
{	case 1: {      
	SetProp(P_SHORT, "Ein kleiner Pirat");
  SetProp(P_NAME_ADJ, "klein");
	create_default_npc(10);
  SetProp(P_LONG,
    "Du siehst einen Pirat vor Dir, der zwar klein ist, aber dennoch sehr "
    "gefaehrlich aussieht und Dich mit grimmigen Augen ansieht. Du solltest "
    "Ihn besser nicht provozieren.");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 85000);

	break;}

	case 2: {
	SetProp(P_SHORT, "Ein grosser Pirat");
  SetProp(P_NAME_ADJ, "gross");
	create_default_npc(12);
  SetProp(P_LONG,
    "Du siehst einen recht grossen Pirat vor Dir der sehr gefaehrlich und genervt "
    "aussieht und Dich mit grimmigen Augen anschaut. Du solltest "
    "Ihn besser nicht provozieren.");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 90000);
	break;}

	default: {
    SetProp(P_SHORT, "Ein sehr grosser Pirat");
  SetProp(P_NAME_ADJ, "sehr gross");
  create_default_npc(14);
  SetProp(P_LONG,
    "Du siehst einen sehr grossen Pirat vor Dir der sehr gefaehrlich und genervt "
    "aussieht und Dich mit grimmigen Augen anschaut. Du solltest "
    "Ihn besser nicht provozieren.");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 95000);

}}



  SetProp(P_NAME, "Pirat");
  SetProp(P_GENDER, MALE);
  AddId(({"pirat", "\npirati"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

switch(rasse)
{  case 1: {SetProp(P_RACE, "Mensch");
		break;}
	case 2: {SetProp(P_RACE, "Elf");
		break;}
	case 3: {SetProp(P_RACE, "Oger");
		break;}		
	default: {SetProp(P_RACE, "Troll");
		break;}
}

  SetProp(P_ALIGN, -550);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir.");
  SetProp(P_MMSGOUT, "verschwindet.");
  SetProp(P_DIE_MSG,  " faellt ueber die Reling.\n"); 
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Pirat");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");
  SetProp (P_MNPC_DEFAULTROOM, PIR_ROOM+"/piratengrotte_6d");
  SetProp (P_MNPC_AREA, "/d/wasser/yondala/pirateninsel" );
  SetProp (P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetProp (P_MNPC_WAIT, ({5, 20, 15}));

 if(random(3))   CLONEME(PIR_OBJ +"sack");
  AddInfo(DEFAULT_INFO, "funkelt Dich feindselig an.\n");

  // SetProp(P_LOG_INFO, "yondala");

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");  


}

// Mitloggen wenn einen Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
      Attack(TP);  
}




	

