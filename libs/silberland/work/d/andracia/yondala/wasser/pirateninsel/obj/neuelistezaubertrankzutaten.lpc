read_liste()
{
	string lesedetail;
	lesedetail=  "\nZaubertrankzutaten\n";

	if (zutat_a) lesedetail=lesedetail+capitalize(zutat_a)+"\n";
	
	if (zutat_b) lesedetail=lesedetail+capitalize(zutat_b)+"\n";
				
	if (zutat_c) lesedetail=lesedetail+capitalize(zutat_c)+"\n";

	if (zutat_d)lesedetail=lesedetail+capitalize(zutat_d)+"\n";
				
	if (zutat_e)lesedetail=lesedetail+capitalize(zutat_e)+"\n";
	
	if (zutat_f)lesedetail=lesedetail+capitalize(zutat_f)+"\n";
				
	if (zutat_g)lesedetail=lesedetail+capitalize(zutat_g)+"\n";
				
	return lesedetail;
	}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zutatenliste");
  SetProp(P_LONG,
    "Du siehst eine kleine Liste. Du kannst sie lesen." );

  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, FEMALE);
  AddId(({"liste", "\nzaubertrankzutaten"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
SetProp(P_AUTOLOADOBJ, 1);
SetProp(P_NODROP, 1);
SetProp(P_NEVERDROP, 1);

 //Liste generieren
 zutat_a=gruppe_a[random(sizeof(gruppe_a))];
 zutat_b=gruppe_b[random(sizeof(gruppe_b))];
 zutat_c=gruppe_c[random(sizeof(gruppe_c))];
 zutat_d=gruppe_d[random(sizeof(gruppe_d))];
 zutat_e=gruppe_e[random(sizeof(gruppe_e))]; 
 zutat_f=gruppe_f[random(sizeof(gruppe_f))];
 zutat_g=gruppe_g[random(sizeof(gruppe_g))];     
//	AddReadDetail( ({ "liste","zutatenliste" }),lesedetail);
    AddReadDetail( ({ "liste","zutatenliste" }),#'read_liste);

	
 //neueliste();
}

string *was() //gibt die Liste an Endoriel
{return zutaten;}


	

int itemweniger(string item)
{
	if(zutat_a==item) zutat_a=0;
	if(zutat_b==item) zutat_b=0;
	if(zutat_c==item) zutat_c=0;
	if(zutat_d==item) zutat_d=0;
	if(zutat_e==item) zutat_e=0;
	if(zutat_f==item) zutat_f=0;
	if(zutat_g==item) zutat_g=0;

	zutaten=({});
	if(zutat_a) zutaten=zutaten+({zutat_a});
	if(zutat_b) zutaten=zutaten+({zutat_b});
	if(zutat_c) zutaten=zutaten+({zutat_c});
	if(zutat_d) zutaten=zutaten+({zutat_d});
	if(zutat_e) zutaten=zutaten+({zutat_e});
	if(zutat_f) zutaten=zutaten+({zutat_f});
	if(zutat_g) zutaten=zutaten+({zutat_g});
	
	//if(!zutat_a&&!zutat_b&&!zutat_c&&!zutat_d&&!zutat_e&&!zutat_f&&!zutat_g) return 0; //Wenn alle erfuellt sind
	if(!sizeof(zutaten)) return 0;
	
	return 1;	
	}
	


