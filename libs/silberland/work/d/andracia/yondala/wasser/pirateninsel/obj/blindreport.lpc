//
#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>//fuer die Vision
#include <ansi.h>//fuer die Farben
object besitzer;
nosave int lastHP, lastSP, aktiv=0;
//string aktStr;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
 SetProp(P_SHORT, "Ein provisorischer Report");
  SetProp(P_LONG,
    "Dies ist ein provisorischer Report, Du kannst ihn mit \"provi ein\" "
	"einschalten und mit \"provi aus\" ausschalten. Mit \"provi weg\" "
	"vernichtest Du Deinen Report.");
  SetProp(P_NAME, "Report");
  SetProp(P_GENDER, MALE);
  AddId("report");

  SetProp(P_MATERIAL, ({ MAT_MISC_MAGIC }));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Das ist Dein Report, den kannst Du nicht ablegen.\n");
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  AddCmd( ({ "provi"}), "provi_report");

  lastHP = lastSP = -1;

}

int provi_report(string str)
{
	notify_fail("provi ein oder aus?\n");
	besitzer=environment();
	if(str=="ein")
		{
			aktiv=1;
	
			write("Report ist nun eingeschaltet.\n");
      lastHP = besitzer->QueryProp(P_HP);
      lastSP = besitzer->QueryProp(P_SP);
      besitzer->AddHpHook(ME);
			return 1;
		}
	if(str=="aus")
		{
			aktiv=0;
			write("Report ist nun ausgeschaltet.\n");
			besitzer->RemoveHpHook(ME);
			return 1;
		}	
	if(str=="weg")
		{
		 write("Du vernichtest Deinen Report.\n");
		 remove();
		 return 1;
		 }

		return 0;
}	



NotifyHpChange()
{
	  int    hp, mhp, sp, msp;
	  if(!aktiv) return;

  // Sicherheits-Check
  if (!previous_object() || !besitzer || (besitzer != previous_object()))
    return;
if(besitzer!=environment()) return;

  // Test auf Geist
  if (besitzer->QueryProp(P_GHOST)) return;


  hp = besitzer->QueryProp(P_HP);

  sp = besitzer->QueryProp(P_SP);

		tell_object(besitzer,"LP "+hp+" MP "+sp+"\n");



}
