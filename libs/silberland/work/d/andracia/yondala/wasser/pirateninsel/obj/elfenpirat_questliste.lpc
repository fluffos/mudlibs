int listenlaenge()
{
	//return sizeof(zutaten)-1;
	if(sizeof(zutaten)==1) return 0;
	return 1;
}
//Teste ob Item auf der Liste ist, wenn ja, loesch es und gib 1 aus, sonst 0
int itemtest(object ob)
{
	int i;
	for(i=0;i<sizeof(zutaten);i++)
	{
		if(ob->id(zutaten[i]))
		{
			//tell_room(environment(environment(this_object())), zutaten[i]+"\n");
			zutaten-=({zutaten[i]});
			ob->remove();
			return 1;
		}
	}
	return 0;
}