//Die Liste auf der steht was man fuer die Quest "Der einsame Elfenpirat" noch benoetigt.

#include "../def.h"
inherit "std/thing";
#include <properties.h>

string *zutaten; //hierdrin stehen die tatsaechlichen Zutaten.


//muss mal noch geschickt sortiert werden
//kann noch erweitert werden
string *gruppe_a=({"banane","eisen", "grashalm", "kitt", "pferdehaar","sack","vulkanblume"});
string *gruppe_b=({"apfel","pflaume", "kirschen", "birne", "obstkuchen"});
string *gruppe_c=({"stein", "kaulquappe", "wurmhaut", "wurzel", "korn", "mistkugel", "bluemchen", "elfenkraut", "raupenseide", "schinkenstueckchen"});
string *gruppe_d=({"lollie", "kaesestueckchen", "klinke","moertel", "seil", "wurmhaut", "zahn", "zwergenhaar"});
string *gruppe_e=({"ei", "champignon", "fledermausfluegel", "himbeere", "fliegenpilz"});
string *gruppe_f=({"hasenpfote", "margarite", "mohn", "veilchen", "eis", "liebesapfel", "popcorn","zuckerstange"});
string *gruppe_g=({"schmetterlingsfluegel", "kaeferzange", "kerze","treibholz", "pilz", "elfenfrucht", "wolle", "gluehwuermchen", "nuss"});


read_liste()
{
	string lesedetail;
	int i;
	//lesedetail=  "\nZaubertrankzutaten\n";
	lesedetail="";
	for(i=0;i<sizeof(zutaten);i++)
	{
		lesedetail=lesedetail+capitalize(zutaten[i])+"\n";
	}
			
	return lesedetail;
	}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zutatenliste");
  SetProp(P_LONG,
    "Du siehst eine kleine Liste. Du kannst sie lesen." );

  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, FEMALE);
  AddId(({"liste", "\nzaubertrankzutaten"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
SetProp(P_AUTOLOADOBJ, 1);
SetProp(P_NODROP, 1);
SetProp(P_NEVERDROP, 1);



//	AddReadDetail( ({ "liste","zutatenliste" }),lesedetail);
    AddReadDetail( ({ "liste","zutatenliste" }),#'read_liste);

zutaten=({});

 //Liste generieren
zutaten += ({"Zaubertrankzutaten:",
		   gruppe_a[random(sizeof(gruppe_a))],
		   gruppe_b[random(sizeof(gruppe_b))],
		   gruppe_c[random(sizeof(gruppe_c))],
		   gruppe_d[random(sizeof(gruppe_d))],
		   gruppe_e[random(sizeof(gruppe_e))],
		   gruppe_f[random(sizeof(gruppe_f))],
		   gruppe_g[random(sizeof(gruppe_g))]
		   });



}

string *was() //gibt die Liste an Endoriel
{return zutaten;}


