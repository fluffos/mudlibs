#include "../def.h"
inherit PIR_ROOM + "piratengrotte_std";
#include <properties.h>

void create() 
{
  ::create();
  SetProp( P_INT_LONG, 
    TO->QueryProp( P_INT_LONG ) + "Duenner Dampf wabert aus dem Raum im Westen.\n" );


  AddDetail( ({ "dampf" }),
    "Er riecht merkwuerdig.");    
  AddDetail( ({ "westen","raum" }),
    "Wenn Du mehr sehen willst, musst Du nach Westen gehen.");    
  AddDetail( ({ "" }),
    "");    

  AddReadDetail( ({ "" }),
    "");
   AddSmell( DEFAULT_SMELL,
    "Es riecht hier merkwuerdig.");

  AddSmell( ({ "dampf" }),
    "Er riecht merkwuerdig, allerdings kannst Du nicht sagen wonach. Ob "
	"es ratsam ist mal nach zu sehen?");  




AddExit( "norden", PIR_ROOM + "piratengrotte_4c" ); 
AddExit( "sueden", PIR_ROOM + "piratengrotte_6c" ); 
AddExit( "westen", PIR_ROOM + "piratengrotte_5b" ); 


}

