  AddDetail( ({ "meerwasser" }),
    "Frag doch Endoriel, was es damit auf sich hat.");    
  AddDetail( ({ "kessel" }),
    "In dem Kessel dampft eine dunkelgruene Fluessigkeit. Du kannst "+
