  AddDetail( ({ "fluessigkeit" }),
    "Es scheint eine Suppe zu sein.");    
  AddDetail( ({ "suppe" }),
    "Du bist Dir ziemlich sicher, dass es sich um eine Suppe handelt. Du "+
	"kannst sicherlich eine kaufen.");    
  AddDetail( ({ "feuer" }),
    "Seltsam, wie wird der Kessel wohl erhitzt?");    
  AddDetail( ({ "endoriel" }),
    "Der ist wohl gerade nicht da.");    
  AddDetail( ({ "aehnlichkeit" }),
    "Sie sehen Pilzen zum verwechseln aehnlich.");    
  AddDetail( ({ "tat" }),
