//Endoriels Kneipe
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <pub.h>
inherit "std/pub";
void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Kneipe" );
  SetProp( P_INT_LONG,
    "Du stehst in einer kleinen, gruenen Kneipe. Ueberall um Dich herum "
	"sind gruene Blaetter. Du fuehlst Dich, als saesst Du in der Krone "
	"eines Baumes. An der Nordwand steht eine kleine Theke, die ganz aus "
	"dunklem Holz gearbeitet wurde. An der Suedwand stehen zwei Tische "
	"mit je vier Stuehlen daran. Vor der Ostwand steht eine weisse Statue."
	);
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "ENDORIEL");
  SetProp( P_PUBKEEPER_NAME, "Endoriel");
  SetProp( P_PUBKEEPER_GENDER, MALE);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  AddItem(PIR_NPC + "pirat_endoriel",REFRESH_DESTRUCT);



  AddDrink("reines Wasser", ({ "wasser"}),10,5,0,1, //Preis, Lebenspunkte, Alkoholwert, Saettigungswert 
  ({ "Endoriel reicht Dir einen Krug Wasser, den Du sofor leerst. ",
       "&& trinkt einen Krug reines Wasser."
   }) );  
    AddDrink("Meerschaum", ({ "meerschaum", "schaum","meer" }),20,10,0,1,
  ({ "Endoriel schoepft aus einem Fass mit schmuddeligen Wasser den Schaum ab "
  	"und fuellt ihn in einen Becher. Zoegernd trinkst Du ihn aus.",
       "&& bekommt einen Becher mit Meerschaum."
   }) );  
   AddDrink("Haiblut", ({ "haiblut", "blut" }),200,20,0,8, //Preis, Volumen, Alk
  ({ "Endoriel holt einen toten Hai aus dem Regal und zapft ihm etwas Blut ab. "
     "Du trinkst es und schauderst.",
       "&& bestellt und trinkt Haiblut."
   }) );

   AddDrink("Elfenwein", ({ "wein", "elfenwein" }),400,50,1,8, //Preis, Volumen, Alk
  ({ "Endoriel geht an ein kleines Fass und zapft Dir ein kleines Glaesschen Wein.",
       "&& geniesst einen exclusiven Wein."
   }) );

 



     // Schiffszwieback der durstig macht, weil so trocken.
     //muss noch gestestet werden
       AddFood("Schiffzwieback", ({ "schiffzwieback", "schiffszwieback",
	           "zwieback","back" }),70, 10, 5, "zwieback" );
     
  AddFood( "Algensuppe", ({ "suppe", "algen" }),200,25,5, //Preis, Lebenspunkte, Saettigung
            ({ "Endoriel sagt: Endlich jemand, der keine toten Tiere essen will.\n"
            	"Endoriel reicht Dir laechelnd einen Teller heisser Suppe.",
               "&& bekommt vom laechelnden Endoriel eine heisse Suppe gereicht. "
            }) );   


  AddFood( "Seehecht", ({ "seehecht", "hecht" }),300,35,15, //Preis, Lebenspunkte, Saettigung
            ({ "Endoriel bereitet einen Fisch frisch fuer Dich zu und "+
			   "serviert ihn Dir. Er schmeckt koestlich ",
               "&& verspeist einen frischen Seehecht. "
            }) );   
  AddFood( "frittierte Vulkanblume", ({ "vulkanblume", "vulkan","blume" }),
            800,100,10, //Preis, Lebenspunkte, Saettigung
            ({ "Endoriel reicht Dir eine knusprige Vulkanblume. ",
               "&& knuspert eine Vulkanblume. "
            }) );   


  AddDetail( ({ "kneipe", "raum" }),
    "Du befindest Dich in einer kleinen Kneipe, die vollstaendig mit "+
