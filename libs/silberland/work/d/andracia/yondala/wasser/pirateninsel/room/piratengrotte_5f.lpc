  AddDetail( ({ "lebewesen" }),
    "Du bist eins. Ich nicht.");
  AddDetail( ({ "ich", "programm" }),
    "Ich bin ein Programm.");
  AddDetail( ({ "boden" }),
    "Boden, Waende und Decke wurden vom Meer in den Fels gewaschen.");

  AddDetail( ({ "wand", "waende", "licht" }),
    "An den Waenden sind Fackeln angebracht, die ein schummriges Licht "+
	"verbreiten.");
  AddDetail( ({ "fackeln" }),
    "Die Fackeln verbreiten ein schumriges Licht. Sie sind fest in der "+
	"Wand verankert.");    
  AddDetail( ({ "meer" }),
    "Das Meer findest Du hier drin nicht, dazu muesstest Du raus aus der "+
	"Grotte.");    
  
  AddDetail( ({ "moos" }),
    "Saftiges Moos bedeckt den Boden.");    

  AddReadDetail( ({ "schrift" }),
    "Zwieback");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
        
  AddSound( DEFAULT_SOUND,
    "Du hoerst die Blaetter leise rascheln.");

  AddSound( ({ "blaetter" }),
    "Als ob ein leichter Wind sie bewegen wuerde, rascheln die Blaetter "
	"vor sich hin.");
  AddSound( ({ "wind" }),
    "Du bist fast sicher, den Wind leise singen zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich frisch, nach Wald, Moos und Sonnenschein.");

  AddSmell( ({ "wald" }),
    "Wie ein natuerlicher Wald riecht dieser Raum. Du bist fasziniert.");
  AddSmell( ({ "moos" }),
    "Das Moos riecht... ja, es riecht wie echtes Moos.");
  AddSmell( ({ "sonnenschein", "sonne" }),
    "Obwohl die Sonne hier wohl noch nie schien kannst Du sie foermlich "
	"riechen.");



 AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );

AddExit( "westen", PIR_ROOM + "piratengrotte_5e" ); 

}

kletternCmd(string str )
{
  notify_fail( "Wo willst du raufklettern?\n" );
  if( str == "ranken rauf"||str == "rauf"||str == "ranken hoch"||
      str == "an ranken rauf"||str == "an ranken hoch"||str == "hoch" )
  {
  	
  	TP->move(PIR_ROOM + "piratengrotte_ranke", M_GO,
  	"","klettert an einer Ranke nach oben","kommt herauf geklettert");
	write("Du kletterst an einer Ranke hoch.\n");
    say( TPN+" klettert an einer Ranke hoch.\n");
    return 1;

  }
  return 0;
}


     zwieback(object zahler, object esser)
     {
       tell_object(esser, "Endoriel nimmt einen Schiffszwieback aus einer Kiste "+
       "und reicht ihn Dir.\nDu kaust das staubige Ding "+
    	 "und hast ploetzlich einen furchtbaren Durst...\n");
       tell_room(this_object(), esser->name(WER)+" isst einen droegen Schiffszwieback.\n",
                 ({ esser }) );
        if(esser->QueryProp(P_DRINK) > 0)
        esser->SetProp(P_DRINK, esser->QueryProp(P_DRINK)-10);

     }
     
