// 21.05.2010 Yondala@Silberland
// spaeter kann man ihn dann evtl wirklich stiegen lassen.
// Idee: Ein folgender PIR_NPC, nicht angreifbar, den man fangen und damit 
// klauen kann ->dann wieder Item.

#include "../def.h"

inherit "std/thing";

#include <properties.h>
object drache;

void init()
{
 ::init();
 if(!interactive(environment(TO)))
 {
   tell_room(environment(TO), "Der Drache stuerzt ab.\n");
   drache->fallengelassen();
   remove();
   return;
   }
   
  drache->verfolgen(environment(TO));
 }
 
 //wird vom obj Papierdrache aufgerufen
 void drachekriegen(object welcher)
 {
 drache=welcher;
 }
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  drache=TO;
  SetProp(P_SHORT, "Eine Schnur");
  SetProp(P_LONG,
    "Du haelst ein Stueckchen Schnur in der Hand, an der ein kleiner "
	"Papierdrache schwebt. Du kannst sie wieder aufwickeln oder auch "
	"weitergeben." );
  SetProp(P_NAME, "Schnur");

  SetProp(P_GENDER, FEMALE);
  AddId(({"schnur", "drachenschnur","DRACHENSCHNUR"}));

  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 150);
  SetProp(P_MAX_HP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Du kannst die Schnur nicht ablegen, solange der "+
                    "Drache fliegt.\n");
  AddCmd(({"wickel","wickle"}),"aufwickeln");
}

int aufwickeln(string str)
{
  notify_fail("Was moechtest Du aufwickeln?\n");
  if(str!="schnur auf"&&str!="drachenschnur auf") return 0;
//   if(!present(drache,environment(TP)))
   if(!drache)
   {
     write("Da Dein Drache weg ist, wirfst Du die Schnur weg.\n");
	 remove();
	 return 1;
	 }
   
   
   write("Du wickelst die Drachenschnur auf und nimmst den Papierdrachen "+
  "wieder an Dich.\n");
  say(TPN+" wickelt die Drachenschnur auf und nimmt den Papierdrachen "+
  "wieder an sich.\n",TP);
  
 
  CLONE(PIR_OBJ +"papierdrache_heil.lpc",TP);
  drache->remove();
  remove();
  return 1;
  }

