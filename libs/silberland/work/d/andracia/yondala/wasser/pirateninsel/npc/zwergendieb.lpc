give_notify(object ob)
 {
 	if(ob->id("\nfreibriefunterschrieben"))
 		{
 			command("sag Ah, habt Dank!");
 			command("sag Hier nun wie abgemacht das goldene Herz.");
			write("Der Zwerg gibt Dir ein goldenes Herz.\n");
			say("Der Zwerg gibt "+TPN+ " ein goldenes Herz.\n",TP);
			ob->remove();
 			CLONE(PIR_OBJ +"goldherz.lpc", TP);
 		}
	else if(ob->id("\nfreibrief"))
 		{
 			command("sag WAS SOLL ICH DENN DAMIT?!");
 			command("sag Da ist keine Unterschrift drauf, der Wisch ist voellig wertlos!");
			say("Der Zwerg zerreisst wuetend das Pergament.\n");
			ob->remove();
  		}
   else
     {             
       command("sag Was soll ich damit?");
			 write("Der Zwerg gibt Dir "+ob->name(WEN)+" zurueck.\n");
			 say("Der Zwerg gibt "+TPN+" "+ob->name(WEN)+" zurueck.\n",TP);
       ob->move(TP, M_GET);
      }
    }
