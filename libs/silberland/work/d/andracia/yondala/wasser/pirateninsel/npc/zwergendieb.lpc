
//Gehoert zur Tauschquest. Hat das Herz und will einen Freibrief bei den Menschen
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein zwergischer Dieb");
  SetProp(P_LONG,
    "Du siehst einen kleine, schmutzigen Zwerg vor Dir. Er traegt nur Lumpen und hat offenbar Laeuse "
    "denn er kratzt sich staendig am ganzen Koerper. Pass auf, dass er Dich nicht bestiehlt.");
  SetProp(P_NAME, "Dieb");
  SetProp(P_NAME_ADJ, "zwergisch");
  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, MALE);
  AddId(({"zwerg", "dieb", "zwergendieb"}));
//  set_living_name("");

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit dreckigen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "stiehlt sich herein");
  SetProp(P_MSGOUT, "stiehlt sich");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
 
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein zwergischer Dieb");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");


  AddInfo(DEFAULT_INFO, "sagt: Das geht Euch nicht an.\n");
  AddInfo( ({"broud","hildgunde"}),
    "Kenn ich nicht, ist mir auch egal.",
    "sagt: ");
  AddInfo( ({"herz",""}),
    "Ohja, ein schoenes Goldherz hab ich wohl. Wollt Ihr es etwa? Ich wuerde es Euch sogar "
    "ueberlassen, wenn Ihr mir dafuer etwas fuer mich tut. Was haltet Ihr von einem Geschaeft?",
    "fragt: ");
  AddInfo( ({"geschaeft",""}),
    "Nun, ich bin durch gewisse Taten bei den Menschen in Ungnade gefallen, daher sind die "
    "Soldaten von Edorian hinter mir her. Erwirkt bei ihm einen Freibrief fuer mich, so ist das "
    "Herz Euer.",
    "sagt: ");
  AddInfo( ({"freibrief",""}),
    "Der Freibrief gestattet es mir das Reich der Menschen wieder zu betreten. Fragt ihn nach "
    "\"Freibrief fuer Durc\", er weiss schon wer ich bin. Aber er muss den Freibrief unbedingt "
    "unterschreiben, sonst ist er fuer mich wertlos. Vergesst das nicht!",
    "sagt: ");
  AddInfo( ({"menschen",""}),
    "Bei den Menschen kann ich mich zur Zeit nicht blicken lassen.",
    "sagt: ");
  AddInfo( ({"unterschrift",""}),
    "Die Unterschrift ist verdammt wichtig!",
    "sagt: ");
  AddInfo( ({"taten","tat", "reiche", "arme"}),
    "Ich nehme den Reichen und gebe den Armen. Naemlich mir. Das scheint den Menschen nicht "
    "zu gefallen.",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");


   SetProp(P_LOG_INFO, "yondala");


 /* SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));*/

  SetChats(3, ({
    "Der diebische Zwerg schaetzt, ob es lohnt Dich zu ueberfallen.\n",
    "Der diebische Zwerg sucht ein Opfer.\n",

    }) );
 

}

// Mitloggen wenn einen Spieler den PIR_NPC killt:
void die(int poisondeath) {
  write_file(PIR_LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(PIR_LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

