//Der Pirat Piet
//Teil der Schatzsuchequest
//Tauscht einmal pro reset seinen Kartenteil gegen eine Vulkanblume

#include <moving.h>
#include "../def.h"
#include <properties.h> //
#include <combat.h>//Kampfeigenschaften
#include <new_skills.h>//Zauberfertigkeiten bzw sonstige Fertigkeiten
#include <moredef.h>//Definition fuer Kuerzel
inherit PIR_NPC + "pirat_std.lpc";
int da = 1;
object obj;
void check(object wen)
{
   	if (present("/nschutzmedaillepiraten",TP))  // Medaille dabei?
        command("sag Ah, Ihr tragt Drakos Medaille, Ihr seid ein Freund, "+TPN+".");
    
    else        // Keine Medaille dabei...
    {
      command("sag Raus mit Euch, "+TPN+", Ihr seid der Feind!\n");
	  tell_object(TP,"Piet wirft Dich aus seinem Laden.\n");
      TP->move( PIR_ROOM + "piratengrotte_3e", M_GO,
  	       "","wird von Piet rausgeworfen.","fliegt im hohen Bogen aus dem Laden.");
    }
		
}		
void init()
{
  ::init();
  if (interactive(TP))call_out("check",0,TP);
}

void reset()
{
  object ob;
  if (!is_clone(TO)) return;
  ::reset();
  if(!present("KARTE3",TO))
  {
    ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
    ob->zahlkriegen(3);
    ob->move(TO);
    ob=0;
    if(ob=present("vulkanblume",TO))
    { 
      tell_room(environment(TO), "Piet zerbroeselt die Vulkanblume und "+
                                 "zieht sie sich durch die Nase.\n");
      ob->remove();
    }
  }

  AddInfo( ({ "vulkanblume" }),
    "Ich sammle Vulkanblumen, das ist alles, was ich noch habe im Leben. Aber "
    "ich komme kaum mehr dazu welche zu pfluecken, zumal es auch sehr gefaehrlich ist.",
    "sagt: ");
  AddInfo( ({ "teile", "kartenteile", "karte","schatzkarte" }),
    "Meine Freunde und ich haben die Schatzkarte damals in vier Teile geteilt.",
    "sagt: ");  
}
	
void create() 
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();
 
  SetProp(P_SHORT, "Piet der Ladenbesitzer");
  SetProp(P_LONG,
    "Du siehst einen mueden, alten Piraten vor Dir. Piet ist duenn und blass, "
    "seine Augen sind eingefallen, blicken Dich aber dennoch einschaetzend an. "
    "Piet traegt alte, schmuddelige Kleidung und macht einen traurigen Eindruck.");
  SetProp(P_NAME, "Piet");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"piet", "pirat", "PIET"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");

  SetProp(P_ALIGN, 50);
  SetProp(P_KILL_NAME, "Piet");
  SetProp(P_KILL_MSG, "In meinem Laden randalierst Du nicht!");
  //SetProp(P_LOG_INFO, "yondala");
 
  SetChats(3, ({
    ""}) );
  AddInfo(DEFAULT_INFO, "brummt etwas Unverstaendliches.\n");

  AddInfo( ({ "piet"}),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({ "schatzkarte", "karte" }),
    "Tja, es gab mal eine Schatzkarte. Aber wir haben den Schatz nie gefunden, "+
    "also haben wir die Karte in vier Teile geteil und jeder von uns hat einen "+
    "Teil behalten, bis ein mutiger Abenteurer kommt und die Schatzsuche beginnen moechte. "+
	"Letztendlich glaube ich aber nicht mehr an den Schatz.",
    "sagt: ");  
  AddInfo( ({ "teile", "kartenteile" }),
    "Meine Freunde und ich haben die Schatzkarte damals in vier Teile geteilt.",
    "sagt: ");  
  AddInfo( ({ "teil", "kartenteil" }),
    "Ich habe auch noch einen Kartenteil. Da ich ihn aber nicht brauche, "
    "wuerde ich ihn gegen eine Vulkanblume eintauschen.",
    "sagt: ");  
  AddInfo( ({ "wir" }),
    "Meine Freunde und ich.",
    "sagt: ");  
  AddInfo( ({ "freunde" }),
    "Drako, Hein und Jann", //Namen der Freunde.
    "sagt: ");  
  AddInfo( ({ "drako" }),
    "Drako ist einer meiner Freunde. Er war mal der Kapitaen eines stolzen Schiffes.",
    "sagt: ");    
  AddInfo( ({ "hein" }),
    "Hein ist einer meiner Freunde. Er ist der Leuchtturmwaechter.",
    "sagt: ");
  AddInfo( ({ "jann" }),
    "Jann ist einer meiner Freunde. Er besitzt die kleine Kneipe an der Anlegestelle, Du kennst ihn sicher.",
    "sagt: ");
  AddInfo( ({ "vulkanblume" }),
    "Ich sammle Vulkanblumen, das ist alles, was ich noch habe im Leben. Aber "
    "ich komme kaum mehr dazu welche zu pfluecken, zumal es auch sehr gefaehrlich ist.",
    "sagt: ");
  AddInfo( ({ "vulkan" }),
    "Im Sueden der Insel gibt es einen Vulkan. Man muss aber vorsichtig sein, "
    "eine falsche Bewegung dort unten drin kann ihn zum Ausbruch bringen.",
    "sagt: ");
  AddInfo( ({ "ausbruch" }),
    "Wenn der Vulkan ausbricht sollte man nicht drin sein.",
    "sagt: ");
  AddInfo( ({ "messer", "schnitzmesser" }),
    "Ich habe leider kein Messer, fragt doch wen anderen, waere doch gelacht, wenn hier niemand ein Messer haette!",
    "sagt: ");
  AddInfo( ({ "schatz" }),
    "Den Schatz haben wir nie gefunden.",
    "sagt: ");
  AddInfo( ({ "abenteurer","abenteuer" }),
    "Ich bin schon lange kein Abenteurer mehr.",
    "sagt: ");
  AddInfo( ({ "schatzsuche" }),
    "Ich habe die Schatzsuche laengst aufgegeben.",
    "sagt: ");
  /*
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  */

  AddCmd( ({ "bitte" }), "bittenCmd" );
  AddCmd( ({ "tausche", "tausch" }), "tauschenCmd" );

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");  
  ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
  ob->zahlkriegen(3);
  ob->move(TO);  
}

void die()
{
   object ob;
   ob=QueryProp(P_KILLER);
   if(!present("KARTE3",TO)) 
   {::die();
    return;}
	if(ob->QueryQuest("Finde den Piratenschatz")||!interactive(ob)||present("KARTE3",ob))
		{
			present("KARTE3",TO)->remove();
			tell_room(environment(TO),"Piet zerreisst mit letzter Kraft ein Stueck Papier.\n");
			
			}
	else 
	   {
	     present("KARTE3",TO)->move(ob, M_NOCHECK);
		 tell_object(ob,"Schnell nimmst Du den Kartenteil an Dich.\n");
		 }
  	::die();
}

bittenCmd(string str)
  {notify_fail( "Um was moechtest Du wen bitten?\n" );
  if (str == "piet um kartenteil")
	{if(da==1)
		{write ("Piet sagt: Hm, da ich ihn nicht mehr brauche wuerde ich ihn "
					"Euch schon geben, allerdings nicht umsonst.\nPiet sagt: Bringt "
					"mir eine Vulkanblume, dann tausche ich diese gegen meinen Kartenteil!\n");
	return 1;
	}
	else
		{write("Piet sagt: Ich habe meine Karte breits mit einem Abendteurer getauscht.\n");}
	
}}
	
int tauschenCmd(string str)
{
    object ob;
    notify_fail("Was moechtest Du gegen was tauschen?\n");
	if (  str == "blume gegen karte"
		||str == "blume gegen kartenteil"
		||str == "blume gegen schatzkarte"
		||str == "blume gegen schatzkartenteil"
		||str == "vulkanblume gegen karte"
		||str == "vulkanblume gegen kartenteil"
		||str == "vulkanblume gegen schatzkarte"
		||str == "vulkanblume gegen schatzkartenteil"	
		||str == "karte gegen blume"
		||str == "karte gegen vulkanblume"
		||str == "kartenteil gegen blume"
		||str == "kartenteil gegen vulkanblume"
		||str == "schatzkarte gegen blume"
		||str == "schatzkarte gegen vulkanblume"
		||str == "schatzkartenteil gegen blume"
		||str == "schatzkartenteil gegen vulkanblume")
	{
		if (present("KARTE3",TO))
		{
	         if(present("vulkanblume",  TP)) //wenn der Spieler eine Vulkanblume hat
		        {
				if(TP->QueryQuest("Finde den Piratenschatz"))//wenn die Quest schon gemacht wurde tauscht er nicht noch einmal
				{
				write("Piet sagt: Wir haben doch schon einmal getauscht.\n");
				return 1;
				}
				//obj = present("vulkanblume",  TP);
			    write("Du gibst Piet die Vulkanblume und er haendigt Dir dafuer ein Stueck Papier aus.\n");
                say(TPN+" tauscht etwas mit Piet.\n",TP);
                present("KARTE3",TO)->move(TP, M_NOCHECK);
				/*ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
				ob->zahlkriegen(3);
				ob->move(TP);*/
				//CLONE(PIR_OBJ +"piratenschatzkarte_3", TP);
			    
				present("vulkanblume", TP)->move(TO);
			    //da = 0;
                AddInfo( ({ "teil", "kartenteil" }),
                   "Ich habe meinen Kartenteil mit einem Abenteurer gegen eine Vulkanblume getauscht.",
                   "sagt: ");  
                AddInfo(({"vulkanblume"}),
                   "Ich habe eine wunderschoene Vulkanblume gegen einen Kartenteil getauscht.",
                   "sagt: ");
				}

		    else //wenn keine Vulkanblume da
			    write("Piet sagt: Ihr wollt mich wohl betruegen? Beim "+
				      "Kabautermann, ihr habt doch\n"+
			          "Piet sagt: gar keine Vulkanblume bei Euch!\n");
            return 1;
        }
		else
	    write("Piet sagt: Ich habe bereits eine Vulkanblume und das Stueck Karte "
		"ist\nPiet sagt: nicht mehr in meinem Besitz.\n");
	     return 1;
    }
}

give_notify(object ob)
 {
   command("sag Oh, danke, mir hat schon lange niemand mehr etwas geschenkt.");
 }

