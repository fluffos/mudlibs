#include "../def.h"
inherit "std/room";
#include <properties.h>

void create() 
{
  ::create();

   SetProp( P_INT_SHORT, "Auf einer Klippe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Klippe. Um Dich herum siehst Du nur moosbewachsene Steine. "
    "Im Osten und Norden geht es steilabwaerts, nach Suedosten kannst Du einen noch hoeheren "
    "Fels besteigen. Am strahlenden Himmel lacht die Sonne auf Dich herunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "klippe" }),
    "Du befindest Dich auf einer Klippe.");

  AddDetail( ({ "steine" }),
    "Auf den Steinen waechst Moos.");

  AddDetail( ({ "moos" }),
    "Das Moos ist mal sehr dicht, mal spaerlich.");

  AddDetail( ({ "osten", "norden" }),
    "Dort geht es steil runter. Unten siehst Du das Meer gegen die Felsen schlagen.");

  AddDetail( ({ "meer" }),
    "Das rauschende Meer schlaegt rhythmisch gegen die Felsen unter Dir.");

  AddDetail( ({ "felsen", "fels" }),
    "Die Klippe, auf der Du stehst, besteht aus hartem Fels.");


  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt im schoensten blau, die Sonne lacht und es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne lacht Dich an.");

  AddDetail( ({ "suedosten" }),
    "Im Suedosten ist eine leichte Erhebung.");
  AddDetail( ({ "boden" }),
    "Du stehst auf moosbewachsenen Steinen.");

  AddDetail( ({ "erhebung" }),
    "Es ist zwar kein ausgebauter Weg da, aber Du bist Dir sicher, relativ gefahrlos dorthin gehen zu koennen.");

  AddDetail( ({ "weg" }),
    "Eigentlich ist keiner da, aber einige Spuren zeugen davon, dass hier ab und zu jemand hergeht.");

  AddDetail( ({ "spuren" }),
    "Fussabdruecke im Moos, ein paar Schleifspuren an den Steinen.");

  AddDetail( ({ "fussabdruecke" }),
    "Hier scheint erst kuerzlich jemand hergegangen zu sein.");

  AddDetail( ({ "schleifspuren" }),
    "Jemand scheint hier etwas schweres entlang gezogen zu haben.");
  AddDetail( ({ "woelkchen" }),
    "Es ist kein Woelkchen zu sehen.");

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres und hin und wieder den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer" }),
    "Das Meer ist tief unter Dir und rauscht in einem beruhigendem Rhythmus.");
  AddSound( ({ "schrei", "moewe" }),
    "Hin und wieder ertoent der schrille Schrei einer Moewe.");
  AddSound( ({ "rhythmus" }),
    "Hmmmm, beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");
    
    
  AddRoomMessage( 
    ({""}),30,"func");

  
AddExit( "nordosten", PIR_ROOM + "pirateninsel_1c" );
AddExit( "suedosten", PIR_ROOM + "pirateninsel_3c" );
AddExit( "suedwesten", PIR_ROOM + "pirateninsel_3a" );


}




