#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

int da = 3;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein blaues Hemd");
  SetProp(P_LONG,
    "Du siehst ein blaues Hemd, das zwar sehr schlicht ist, aber dennoch gut gearbeitet zu sein scheint." );
  SetProp(P_NAME, "Hemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([ MAT_CLOTH ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 50);
                                  

}


