void create() 
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hein der Leuchtturmwaerter");
  SetProp(P_LONG,
    "Du siehst einen alten, armseligen Mann vor Dir. Hein ist schmuddelig und scheinbar "
    "stark angetrunken. Er schaut Dich traurig an. Er scheint Hilfe zu gebrauchen.");
  SetProp(P_NAME, "Hein");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"hein", "waerter", "leuchtturmwaerter" "HEIN"}));
//  SetProp(P_ARTICLE, 0);
//  set_living_name("");

  create_default_npc(10);
  SetProp(P_HANDS, ({" schwankend",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");

  SetProp(P_ALIGN, -200);
  SetProp(P_KILL_NAME, "Hein der Leuchtturmwaerter");
  AddInfo(DEFAULT_INFO, "ruelpst.\n");
  SetChats(3, ({
    "Hein nimmt einen Schluck aus einer Rumflasche.\n",
    "Hein ruelpst.\n",
    "Hein seufzt: Solch ein Elend.\n",}) );
 // SetProp(P_LOG_INFO, "yondala");

  AddInfo( ({ "hein", "leuchtturmwaerter" }),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({ "schatzkarte" }),
    "Tja, es gab mal eine Schatzkarte *hick* aber wir haben den Schatz nie "+
	"gefunden, also haben wir die Karte in vier Teile geteilt und jeder von "+
	"uns hat einen Teil behalten *hick* bis ein mutiger Abenteurer kommt und "+
	"die Schatzsuche beginnen moechte.",
    "sagt: ");  
  AddInfo( ({ "teile", "kartenteile" }),
    "Meine Freunde und ich haben die Schatzkarte damals in vier Teile geteilt.",
    "sagt: ");  
  AddInfo( ({ "teil", "kartenteil" }),
    "Ich habe auch noch einen Kartenteil. *hicks* dabei brauch ich den "
	"eigentlich gar nicht. Wenn Ihr mir einen kleinen Gefallen tut, koennt "+
	"Ihr ihn gerne haben.",
    "sagt: ");  
  AddInfo( ({ "gefallen" }),
    "Nun, wisst Ihr, Die Lampe meines Leuchtturms wurde gestohlen. Seid so gut "+
	"und baut eine neue und haengt sie auf. Sagt mir einfach, wenn Ihr fertig seid und "+
	"Ihr sollt Eure Belohnung erhalten!",  
    "sagt: "); 
  AddInfo( ({ "wir" }),
    "Meine Freunde und ich.",
    "sagt: ");  
  AddInfo( ({ "freunde" }),
    "Meine Freunde heissen Drako, Jann und Piet", //Namen der Freunde.
    "sagt: ");   
  AddInfo( ({ "drako" }),
    "Drako ist einer meiner Freunde. Er war mal der Kapitaen eines stolzen "+
	"Schiffes.",
    "sagt: ");    
  AddInfo( ({ "jann" }),
    "Jann ist einer meiner Freunde. Er ist der Wirt in der Hafenkneipe.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist einer meiner Freunde. Er besitzt einen kleinen Laden.",
    "sagt: ");
   AddInfo( ({ "piet" }),
    "Mein Freund Piet besitzt einen kleinen Laden.",
    "sagt: ");
  AddInfo( ({ "abmachung" }),
    "Es gilt als abgemacht, dass Ihr meinen Kartenteil bekommt, wenn ihr "+
	"meine Lampe erneuert habt!",
    "sagt: ");
  AddInfo( ({ "hilfe" }),
    "Ich koennte in der Tat Hilfe gebrauchen. Es geht dabei um meinen "+
	"Leuchtturm.",
    "sagt: ");
  AddInfo( ({ "leuchtturm" }),
    "*hicks* die Lampe meines Leuchtturms wurde gestohlen. Und ich schaffe "+
	"es *hicks* nicht eine neue zu bauen. Wollt Ihr mir nicht Eure Hilfe "
	"anbieten? Ich haette dann auch eine Belohnung fuer Euch.",
    "sagt: ");
  AddInfo( ({ "lampe","leuchtturmlampe" }),
    "Die Lampe wurde gestohlen als ich bes... aeh... *hicks* muede war.",
    "sagt: ");
  AddInfo( ({ "karte" }),
    "Was fuer eine Karte?",
    "sagt: ");
  AddInfo( ({ "elend" }),
    "Achja, ein Elend ist das. Jemand hat mir meine Leuchtturmlampe gestohlen.",
    "sagt: ");
  AddInfo( ({ "gestell", "lampengestell", "eisen","glas","glasrohling","kitt" }),
    "Fragt Trogurt danach! *hicks* Das ist sein Metier.",
    "sagt: ");
  AddInfo( ({ "trogurt" }),
    "Trogurt ist ein Schmied.",
    "sagt: ");
  AddInfo( ({ "schmied" }),
    "Schmied? Wie, Schmied? Was ist das fuer eine be*hicks*te Frage?",
    "sagt: ");
  AddInfo( ({ "schmiede" }),
    "Ich kenn nur eine Schmiede. Und das ist die von Trogurt. Aber wo die ist, das sag ich Euch nicht.",
    "sagt: ");
  AddInfo( ({ "dieb" }),
    "Ich weiss nicht, wer es war, ich habe geschlafen.",
    "sagt: ");
  AddInfo( ({ "abenteurer" }),
    "Seid ihr ein Abenteurer? Ihr seht mir nicht danach aus.",
    "sagt: ");
  AddInfo( ({ "schatz" }),
    "Ich glaube nicht mehr an den Schatz.",
    "sagt: ");
  AddInfo( ({ "schatzsuche" }),
    "Zeitverschwendung!",
    "sagt: ");
  AddInfo( ({ "rum" }),
    "Das ist meiner, davon bekommt Ihr nichts!",
    "sagt: ");
  AddInfo( ({ "tausch" }),
    "Wenn Ihr mir einen Gefallen tut, dann gebe ich Euch meinen Kartenteil.",
    "sagt: ");
  AddInfo( ({ "iskir" }),
    "Iskir ist auch ein guter Freund von mir. Er besitzt einen kleinen Schnapsladen.",
    "sagt: ");
  AddInfo( ({ "schnapsladen" }),
    "Ich kenn nur den von Iskir. Dort kaufe ich immer meinen Rum.",
    "sagt: ");
  AddInfo( ({ "kerze" }),
    "Sowas bekommt Ihr im Laden.",
    "sagt: ");
  AddInfo( ({ "belohnung" }),
    "Als Belohnung koennte ich Euch meinen Teil der Schatzkarte anbieten, die meine Freunde und "
    "ich damals in vier Teile teilten.",
    "sagt: ");
  AddInfo( ({ "metier", "leuchtturmbewachung" }),
    "Mein Metier ist Leuchtturmbewachung.",
    "sagt: ");
  AddInfo( ({ "messer", "schnitzmesser" }),
    "Ich habe leider kein Messer, fragt doch mal Jann, den habe ich letztens mit einem gesehen.",
    "sagt: ");
    
 AddCmd(({"fertig"}),"fertigCmd");     
 AddCmd( ({ "biete","biet" }), "helfenCmd" );
 AddCmd( ({ "bitte" }), "bittenCmd" );

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");    
  obj=clone_object(PIR_OBJ +"piratenschatzkartenteil");
  obj->zahlkriegen(4);
  obj->move(TO);
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht.",
        "lacht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt einen Fluch.",
        "brummt einen Fluch.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt.",
        "schmunzelt.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schimpft ueber Dich.",
        "schimpft ueber " +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "brummt einen Fluch.",
        "brummt einen Fluch.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "singt ein raues Lied.", 
        "singt ein raues Lied.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
//    case "neutral":
//      call_out("reaction", 0, TP,
  //      "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
    //    "prudi zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      //break;
    case "traurig":
      call_out("reaction", 0, TP,
        "wird sentimental.",
        "wird sentimental.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
 
 
}

void die()
{
   object ob;
   ob=QueryProp(P_KILLER);
   if(!present("KARTE4",TO)) 
   {::die();
    return;}
   if(ob->QueryQuest("Finde den Piratenschatz")||!interactive(ob)||present("KARTE4",ob))
		{
			present("KARTE4",TO)->remove();
			tell_room(environment(TO),"Hein zerreisst mit letzter Kraft ein Stueck Papier.\n");
			
			}
	   else 
	   {
	     present("KARTE4",TO)->move(ob);
		 tell_object(ob,"Schnell nimmst Du den Kartenteil an Dich.\n");
		 }
  	::die();
}


int helfenCmd(string str )
{ 
	notify_fail( "Wem moechtest Du Deine Hilfe anbieten?\n" );
  if (str == "hein hilfe an")
  {	
  	write ("Du bietest Hein Deine Hilfe an.\n");
  	say(TPN+" bietet Hein Hilfe an.\n",TP);
  	
  	if(this_player()->QueryQuest("Finde den Piratenschatz"))
  		{
  			command("sag Ihr habt mir doch schon einmal geholfen, lasst gut sein.");
  			return 1;
  		}
  	if(present("\nlampeplan",TP))
  		{
  			command("sag Ihr helft mir doch schon, "+TPN+".");
  			return 1;
  		}	
  			  
  	command("sag Vielen Dank. Da ich keine neue Lampe besitze, muesst Ihr wohl eine fuer mich bauen. *hicks* "+
	"Trogurt, der Schmied, ist Euch dabei sicher behilflich.");    
    	write("\nHein gibt Dir ein Stueck Papier.\n"+
		"Hein fluestert Dir zu: Wenn Ihr die Lampe ausgetauscht habt, so kommt zu mir und schreibt 'fertig' "+
		"dann sprechen wir wieder ueber unsere Abmachung.\n");
    	say("Hein gibt "+TPN+" ein Stueck Papier und fluestert "+TPN+" etwas zu.\n",TP);
    	CLONE(PIR_OBJ +"leuchtturmlampebauplan", TP);
    	return 1;
		} 
}


int bittenCmd(string str)
  {
  	notify_fail( "Wen moechtest Du um was bitten?\n" );
  	if (str == "hein um kartenteil"||str=="hein um teil")
		{
			write ("Du bittest Hein um seinen Kartenteil.\n");
  			say(TPN+" bitten Hein um dessen Kartenteil.\n",TP);
            command("sag Ich wuerde Euch meinen Kartenteil geben, wenn Ihr mir dafuer einen Gefallen tut!\n");
	  		return 1;
			}
	}
	
	
void catch_tell(string str)
{ 
  string dummy, text;
  object spieler;
  object ob;
  ob=0;
  if(sscanf(str, "%s sagt: fertig%s", dummy, text)!=2) return;
  spieler=present(lower_case(dummy), environment(TO));
  if(spieler==TO)return;
 // command("sag "+spieler->name());

  //if(!ob)
	if(!present("\ninvislampe",spieler))
	{	
	  say("Hein groehlt: ELENDER LUEGNER!\n");
	  Attack(spieler);
	  return;
	}

else
	{
	 	command("sag Vielen Dank. Ich habe es mir anders ueberlegt. Hier "+
		      "habt Ihr zum Lohn eine Muenze. Und nun scherrt Euch fort!");    
		write("Hein gibt Dir eine Muenze.\n");
		say("Hein gibt "+spieler->name(WEM)+" eine Muenze.\n",TP);
		spieler->AddMoney(1);

		ob=present("\ninvislampe",spieler);
		ob->remove();
		}
		return;
  
  
  }
  

int fertigCmd()//(string str)
{
	object ob;

	if(!present("\ninvislampe",TP))
	{	
	  say("Hein groehlt: ELENDER LUEGNER!\n");
	  Attack(TP);
	}

else
	{
	 	command("sag Vielen Dank. Ich habe es mir anders ueberlegt. Hier "+
		      "habt Ihr zum Lohn eine Muenze. Und nun scherrt Euch fort!");    
		write("Hein gibt Dir eine Muenze.\n");
		say("Hein gibt "+TPN+" eine Muenze.\n",TP);
		this_player()->AddMoney(1);

		ob=present("\ninvislampe",TP);
		ob->remove();
		}
		return 1;
 }

give_notify(object ob)
 {
   tell_room(environment(TO),"Hein laest "+ob->name(WEN)+" fallen.\n");
   ob->move(environment(TO));
 }


