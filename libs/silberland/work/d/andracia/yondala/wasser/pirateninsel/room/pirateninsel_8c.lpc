//Am Strand. Hier kann man auf eine Palme klettern
//und hier liegt das Stueck Treibolz fuer die Schatzsuchequest

#include "../def.h"
inherit "std/room";
#include <properties.h>

int treibholzda;
void reset()
{
	treibholzda=1;
	::reset();
}

void create() 
{
  ::create();
treibholzda=1;
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
    "Du bist am Strand der Pirateninsel. Hier ist es einfach himmlisch. "
    "Die Sonne lacht, die Palmen bewegen sich im Wind. Unter Deinen Fuessen "
    "knirscht leise der warme, weiche Sand. Am Ufer rollen seichte Wellen an Land." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );
AddItem(PIR_NPC + "pirat_drako",REFRESH_DESTRUCT);

  AddDetail( ({ "strand" }),
    "Du befindest Dich am Strand.");
  AddDetail( ({ "piratenisel" }),
    "Auf diese Insel bist Du gereist.");
  AddDetail( ({ "insel", "land" }),
    "Eine Insel ist vom Meer umgebenes Land.");
  AddDetail( ({ "meer","wasser" }),
    "Das Meer umgibt die Insel.");
  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel und lacht Dich an.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau und die Sonne lacht Dich an.");
  AddDetail( ({ "sand" }),
    "Der Sand ist weich und weiss. Die Sonne hat ihn aufgewaermt. Ein "
    "Stueckchen Holz schaut heraus.");
  AddDetail( ({ "palmen" }),
    "Die Palmen bewegen sich im Wind. Eine Palme ist etwas groesser als die anderen.");
  AddDetail( ({ "wind", "brise" }),
    "Du fuehlst eine leichte Brise auf deiner Haut.");
  AddDetail( ({ "haut" }),
    "Haut ist wichtig. Saehe doof aus ohne..");
  AddDetail( ({ "ufer" }),
    "Das Ufer der Insel.");
  AddDetail( ({ "wellen", "wasserbewegung", "welle" }),
    "Wasserbewegung nennt man Wellen.");
  AddDetail( ({ "fuesse", "fuessen", "beine", "bein", "ende" }),
    "Am Ende deiner Beine sind Deine Fuesse.");
  AddDetail( ({ "palme" }),
    "Auf diese Palme koennte man sicher klettern.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus warmen, weichen Sand.");
  AddDetail( ({ "pirateninsel" }),
    "Du befindest Dich auf einer.");
  AddDetail( ({ "holz", "stueckchen" }),
    "Wenn Du grad Holz brauchst koenntest Du ein bisschen im Sand buddeln und schauen, ob Du was findest.");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");
  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Meeres. Hin und wieder vernimmst Du den Schrei einer Moewe.");

  AddSound( ({ "rauschen","meer","meeres" }),
    "Es hat etwas beruhigendes.");
  AddSound( ({ "moewe", "schrei" }),
    "Ein widerliches Geraeusch.");
  AddSound( ({ "geraeusch" }),
    "Du schauderst.");
  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier herrlich nach Meer und frischer Luft.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig und fischig.");
  AddSmell( ({ "salz","fisch", "geruch" }),
    "Der typische Geruch des Meeres.");
    
  AddSmell( ({ "luft" }),
    "Du atmest tief aus und ein. Herrlich, dieser Geruch.");

  AddRoomMessage( 
    ({"Du fuehlst eine leichte Brise auf der Haut.\n", 
    	"Irgendwo kreischt eine Moewe.\n", 
    	"Eine Welle umspuelt Deine Fuesse.\n",
    	"Die Palmen wiegen sich sanft im Wind.\n"}),30,"func");

  AddCmd( ({ "bau", "baue" }), "bauenCmd" );
  AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );
  AddCmd( ({ "buddel", "buddle","buddele" }), "buddeln" );
  AddCmd( ({ "schwimm", "schwimme" }), "schwimmenCmd" );   

     AddExit( "nordwesten", PIR_ROOM + "pirateninsel_7b" );
     AddExit( "osten", PIR_ROOM + "pirateninsel_8d" );
}

int kletternCmd(string str )
{
  notify_fail( "Wo willst Du draufklettern?\n" );
  if( str == "auf palme" )
  {
  	TP->move(PIR_ROOM + "pirateninsel_palme", M_GO,
  	"","klettert auf die Palme","kommt herauf geklettert");
//		TP->move (PIR_ROOM + "pirateninsel_palme");
		//write("Du kletterst auf eine Palme.\n");
    //say( TPN+" klettert auf eine Palme.\n");
    return 1;

  }
  return 0;
}

int bauenCmd(string str )
{
  notify_fail( "Was moechtest Du bauen?\n" );
  if( str == "burg"||str== "sandburg" )
  {

	  write("Der Sand eignet sich hier nicht dazu eine Burg zu bauen.\n");
	  return 1;
	  }
return 0;
}

int buddeln(string str )
{
  notify_fail( "Worin willst Du buddeln?\n" );

 
  if( str == "in sand"||str =="im sand" )
  {
  	   if (treibholzda)
		   //if (!present("treibholz",TP)&&!this_player()->QueryQuest("Finde den Piratenschatz"))//wenn Holz da ist und der Spieler die Quest noch nicht gemacht hab
  	  {
		    write("Du buddelst im Sand und haelst ploetzlich ein Stueck Treibholz in den Haenden.\n");
            CLONE(PIR_OBJ +"treibholz", TP);	
			treibholzda=0;
	    }
   else
   	{
   		write("Du buddelst im Sand, findest aber nichts.\n");
       }
	say( TPN+" buddelt im Sand.\n",TP);
   return 1;
  }
  return 0;
}


int schwimmenCmd(string str )
{
 
  notify_fail( "Wo willst Du hin schwimmen?\n" );
  if( str == "zur kleinen insel" || str== "zur kleinen insel hin"||str == "zur kleinen insel hinueber" || str== "zur kleinen insel rueber" ||
  str == "zur anderen insel" || str== "zur anderen insel hin"||str == "zur anderen insel hinueber" || str== "zur anderen insel rueber"||
  str == "zur insel" || str== "zur insel hin"||str == "zur insel hinueber" || str== "zur insel rueber"||
  str== "herueber"||str == "hinueber" || str== "rueber"||
  str == "zu kleiner insel" || str== "zu kleiner insel hin"||str == "zu kleiner insel hinueber" || str== "zu kleiner insel rueber" ||
  str == "zu anderer insel" || str== "zu anderer insel hin"||str == "zu anderer insel hinueber" || str== "zu anderer insel rueber"||
  str == "zu insel" || str== "zu insel hin"||str == "zu insel hinueber" || str== "zu insel rueber")

  { 
    
    write("Du watest ins Wasser und schwimmst los.\n");
    say( TPN+" schwimmt los.\n",TP);
	if (random(20)==1) TP->move(PIR_ROOM+"pirateninsel_wal", M_GO);
	else               TP->move(PIR_ROOM+"pirateninsel_10c", M_GO);
			 
    return 1;  	
  	 }
    return 0;
}