  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd(({"schmiede"}), "schmiedenCmd");


AddExit( "westen", PIR_ROOM + "piratengrotte_4e" ); 

}

int schmiedenCmd(string str)
{ notify_fail("Was moechtest Du woraus schmieden?\n");

if(str=="lampengestell aus eisen")
{	
//wenn er Eisen hat	
	if(present("eisen",  TP))
	{
		write("Du bearbeitest das Eisen und formst daraus ein Lampengestell.\n");
		say(TPN+" schmiedet ein Lampengestell.\n", TP);
		CLONE(PIR_OBJ +"leuchtturmlampegestell", TP);

obj = present("eisen", TP);
obj->remove();
		return 1;
	}

else
	{write("Du hast kein Eisen bei Dir.\n");}
	
return 1;
}
}

int blasenCmd(string str)
{ notify_fail("Was moechtest Du worueber blasen?\n");

if(str=="glasrohling ueber feuerstelle")
{	

	if(present("\nglasrohling",  TP))
	{
		write("Du steckst den Glasrohling auf ein langes Rohr und faengst an zu blasen.\n");
		say(TPN+" blaest an einem Glasrohling herum.\n", TP);
		CLONE(PIR_OBJ +"glashuelle", TP);
		TP->command_me("\nwegrohling");
		return 1;
	}

else
	{write("Du hast keinen Glasrohling bei Dir.\n");}
	
return 1;
}
}


	   string metallfinder(string key)
     {
       if (present("\nlampeplan", TP))
	   {
	   	if (present("\neisen",TP))
	   		{return "Du findest ein Stueck Eisen, da Du aber schon eins hast laesst Du es liegen.\n";}
			else
				{
					CLONE(PIR_OBJ +"eisen", TP);
		   		return"Du findest ein Stueck Eisen und steckst es ein.\n";
		   	}
	   }


       else
         return"Normales, altes Metall, welches Du im Moment nicht gebrauchen kannst.\n";
        
     }