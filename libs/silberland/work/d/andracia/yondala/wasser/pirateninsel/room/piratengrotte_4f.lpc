  AddDetail( ({ "piratenschiffs", "piratenschiff" }),
    "Das Piratenschiff wurde vor Jahren von einem grossen Wal zerstoert.");   
  AddDetail( ({ "jahren", "jahre" }),
    "Lang, lang ists her.");   
  AddDetail( ({ "wal", "wale" }),
    "Wale schwimmen vor der Kueste im Meer.");   
  AddDetail( ({ "kueste", "rand" }),
