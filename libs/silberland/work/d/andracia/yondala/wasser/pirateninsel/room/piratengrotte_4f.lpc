//Die Piratenschmiede
#include "../def.h"
#include <moredef.h>
inherit "std/room";
#include <properties.h>

void einruf(string text, string rufer, string gerufener, object *raeume)
{
  string *ausgaenge;
  int i;
  if(member(raeume, TO)!=-1) return;
  if(!present(rufer,TO))
  tell_room(TO, "Du hoerst "+rufer+" \""+text+
                "\" bruellen.\n");
				
  if(present(gerufener, TO)) present(gerufener)->duwirstgerufen(text, rufer);
  raeume=raeume+({TO});
  ausgaenge=m_values(QueryProp(P_EXITS));
  for(i=sizeof(ausgaenge);i--;i>=0)
     {
		ausgaenge[i]->einruf(text,rufer, gerufener, raeume);
		}
}
object obj;
object planda;
void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Schmiede" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Schmiede der Piraten. Viel Einrichtung gibt "
    "es hier nicht, denn die Glanzzeit der Piraten ist lange her. Aber "
    "Trogurt versteht sein Handwerk und die wenigen Auftraege die er noch "
    "bekommt erledigt er gewissenhaft, wenn er den Kunden mag." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  AddItem(PIR_NPC + "pirat_trogurt",REFRESH_DESTRUCT);
  AddDetail( ({ "schmiede" }),
    "Du befindest Dich in der Schmiede der Piraten.");   
