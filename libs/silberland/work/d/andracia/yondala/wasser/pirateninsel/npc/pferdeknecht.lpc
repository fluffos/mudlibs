inherit "std/npc";
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <npc.h>
	

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pferdeknecht");
  SetProp(P_LONG,
    "Du siehst einen jungen Mann, der kaum dem Kindesalter entwachsen scheint, aber dennoch "
    "den Eindruck eines Greises macht. Er muss vermutlich sehr hart arbeiten. Seine Kleidung "
    "ist von mittlerer Qualitaet, allerdings durch die Arbeit im Stall sehr schmutzig." );
  SetProp(P_NAME, "Pferdeknecht");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
   AddId(({"pferdeknecht", "knecht", "mann"}));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit einer Mistgabel",QueryProp(P_HANDS)[1],DT_MAGIC}));
//  SetProp (P_MNPC_DEFAULTROOM, "/d/huegelland/yason/zwirbelstein/room/dorf/zwirbelstein_dorf_d7");
  
  SetProp(P_SIZE, 185);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);

  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_KILL_NAME, "Ein Pferdeknecht");

  AddInfo(DEFAULT_INFO, "sagt: Keine Ahnung, Mann, Ich bin nur 'n Knecht.\n");

  AddInfo( ({"haar"}), 
    "Was fuer ein Haar meint Ihr?",
    "fragt: "); 
  AddInfo( ({"pferdehaar", "pferdehaare", "rosshaar"}), 
    "Pferdehaare hab ich viele. Ihr koennt gerne eines haben, doch bitte ich Euch dafuer um "
    "einen kleinen Gefallen.",
    "sagt: "); 
  AddInfo( ({"gefallen"}), 
    "Ich benoetige dringend ein ganz besonderes Messer, welches nur ein bestimmter Zwergenschmied "
    "herzustellen vermag.",
    "sagt: "); 
  AddInfo( ({"zwergenschmied","zwergenschmiede"}), 
    "Derer gibt es viele. Der beste von Ihnen heisst Knurrg.",
    "sagt: "); 
  AddInfo( ({"knurrg"}), 
    "Knurrg ist ein Zwerg, allerdings ist er ausgewandert und ich weiss nicht genau wohin, "
    "aber ich habe gehoert, man sieht ihn ab und an im grossen Tal im Gebirge.",
    "sagt: "); 
  AddInfo( ({"messer"}), 
    "Gebt mir ein von Knurrg gefertigtes Messer und ich gebe Euch ein Pferdehaar.",
    "sagt: "); 
  AddInfo( ({"zwerg", "zwerge"}), 
    "Es gibt viele Zwerge.",
    "sagt: "); 
  AddInfo( ({"pferde","pferd"}), 
    "Ja, auf Pferde pass ich auf, da kenn ich mich mit aus.",
    "sagt: "); 
  AddInfo( ({"buerste","striegel"}), 
    "Ich striegel meine Pferde immer regelmaessig.",
    "sagt: "); 
  AddInfo( ({"pflege","pferdepflege"}), 
    "Ich bin der Knecht, ich kuemmer mich um die Pferdepflege.",
    "sagt: "); 
  AddInfo( ({"knecht", "pferdeknecht"}), 
    "Das bin ich.",
    "sagt: "); 
  AddInfo( ({"hilfe"}), 
    "Ach, Hilfe brauch ich nicht, ich bin recht zufrieden. Einen Gefallen koenntet Ihr mir "
    "tun, doch kann ich Euch nicht viel dafuer geben.",
    "sagt: "); 
  AddInfo( ({"tal"}), 
    "Im Gebirge ist ein grosses, gruenes Tal. Aber das ist weit weg. Ein Knecht wie ich kommt da nie hin.",
    "sagt: "); 
  AddInfo( ({"gebirge","berge"}), 
    "Oestlich von hier beginnt das Gebirge.",
    "sagt: "); 
  AddInfo( ({"schmied","schmiede"}), 
    "Es gibt viele Schmiede, aber die Zwergenschmiede sind die wahren Meister.",
    "sagt: "); 
  AddInfo( ({"meister"}), 
    "Ein Meister kann alles.",
    "sagt: "); 
  AddInfo( ({"haar","haare"}), 
    "Ich hab die Haare schoen!", "sagt: ");
     
   SUID;

/*  SetChats(3, ({
    ".\n",
    ".\n"}) );
*/
//  AddCmd(({"",""}),"Cmd");




/*  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );
  

  CLONEME(PIR_ARMOUR "elfentunika" );
  CLONEME(PIR_ARMOUR "elfenseidenschuhe" );
  CLONEME(PIR_ARMOUR "elfenguertel" );
  CLONEME(PIR_ARMOUR "aura" );
  command("trage alles");*/
  
//   SetProp(P_LOG_INFO, "yondala");


}

void give_notify(object ob)
 {
 	if(ob->id("\nknurrgsmesser"))
 		{
 			command("sag Vielen Dank. Wie abgemacht, hier habt Ihr das Haar!");
		  write("Der Knecht gibt Dir ein Pferdehaar.\n");
			say("Der Knecht gibt "+TPN+" ein Pferdehaar.\n",TP);
			ob->remove();
 			CLONE(PIR_OBJ +"pferdehaar", TP);
 		}
	else
			command("sag Oh, danke.");

    }