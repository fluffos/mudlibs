#include <properties.h>
#include <language.h>
//#include <moving.h>
#include <npc.h>

#include <moredef.h>
#include "../def.h"
inherit PIR_NPC + "pirat_std.lpc";

void reset()
{
  object ob;
  ::reset();
  if(present("KARTE1",TO)) return;
  ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
  ob->zahlkriegen(1);
  ob->move(TO);
}
	
create(){
object ob;
	if (!is_clone(this_object())) return;
	::create();
 	
  SetProp(P_SHORT, "Jann der Wirt");
  SetProp(P_LONG,
    "Du siehst einen staemmigen, aelteren Mann vor Dir. Er ist recht ungepflegt und irgendwie "
    "schmierig.");
  SetProp(P_NAME, "Jann");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"jann", "wirt", "JANN"}));
  set_living_name("Jann");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit einer Schnapsflasche",QueryProp(P_HANDS)[2],DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");

  SetProp(P_ALIGN, 50);
  SetProp(P_KILL_NAME, "Jann der Wirt");
  SetProp(P_KILL_MSG, "In meiner Kneipe randalierst Du nicht!");
  SetChats(3, ({
    "Jann poliert ein Glas.\n",
    "Jann trinkt einen Schluck Rum.\n",
    "Jann seufzt: Waere ich doch bloss nicht so dumm gewesen die Karte zu teilen.\n"}) );

  AddInfo( ({ "jann", "wirt" }),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({ "schatzkarte", "karte" }),
    "Tja, es gab mal eine Schatzkarte. Aber wir haben den Schatz nie gefunden, "+
    "also haben wir die Karte in vier Teile geteilt und jeder von uns hat einen "+
    "Teil behalten, damit keiner von uns den Schatz alleine finden kann. Aber das ist "
    "ewig her und ich glaube nicht mehr daran.",
    "sagt: ");  
  AddInfo( ({ "teile", "kartenteile" }),
    "Meine Freunde und ich haben die Schatzkarte damals in vier Teile geteilt.",
    "sagt: ");  
  AddInfo( ({ "teil", "kartenteil" }),
    "Ich habe auch noch einen Kartenteil. Aber er ist mir unnuetz, ich wuerde Ihn Euch geben, wenn Ihr ein kleines Spiel mit mir wagt.",
    "sagt: ");  
    AddInfo( ({ "bedingung", "bedingungen" }),
    "Ihr setzt 300 Muenzen, ich setze was Ihr begehrt. Wir wuerfeln beide "
    "einmal. Ist meine Zahl hoeher oder haben wir beide das selbe Ergebnis "
    "gewinne ich. Ist Eure Zahl hoeher, dann gewinnt Ihr.\n",
    "sagt: ");  
    AddInfo( ({ "wir" }),
    "Meine Freunde und ich.",
    "sagt: ");  
    AddInfo( ({ "freunde" }),
    "Drako, Hein und Piet", //Namen der Freunde.
    "sagt: ");  
    AddInfo( ({ "drako" }),
    "Drako ist einer meiner Freunde. Er war mal der Kapitaen eines stolzen Schiffes.",
    "sagt: ");    
  AddInfo( ({ "hein" }),
    "Hein ist einer meiner Freunde. Er ist der Leuchtturmwaechter.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist einer meiner Freunde. Er betreibt einen kleinen Laden.",
    "sagt: ");
  AddInfo( ({ "bier" }),
    "Bier koennt Ihr hier kriegen.",
    "sagt: ");
  AddInfo( ({ "malzbier" }),
    "Malzbier erfrischt und hat keinen Alkohol.",
    "ruft: ");
  AddInfo( ({ "gratisbier", "freibier" }),
    "Gratisbier? Na, das fehlt mir noch! Allerdings wuerde ich mit Dir um Malzbier wuerfeln.",
    "sagt: ");
  AddInfo( ({ "laden" }),
    "Im geheimen Dorf der Piraten ist ein kleiner Laden. Er gehoert meinem Freund Piet.",
    "sagt: ");
  AddInfo( ({ "dorf" }),
    "Meinst Du das Piratendorf?",
    "sagt: ");
  AddInfo( ({ "piratendorf" }),
    "Vergesst es, ich traue Euch nicht.",
    "sagt: ");
  AddInfo( ({ "frau" }),
    "Wir haben eine Frau auf der Insel. Hildgunde, die Sklavin von Iskir versorgt uns mit allem.",
    "sagt: ");
      
  AddInfo( ({ "schatz" }),
    "Es gibt schon lange das Geruecht, dass auf dieser Insel ein Schatz "
    "vergraben sei. Meine Freunde und ich besassen sogar mal eine Karte "
    "dafuer. Doch das ist lange her.",
    "sagt: ");
      
  AddInfo( ({ "glas", "angebot", "alkohol" }),
    "Moechtet Ihr etwas trinken? Mit <menue> seht Ihr mein Angebot.",
    "sagt: ");
      
  AddInfo( ({ "schatzsuche" }),
    "Die Schatzsuche werden wir wohl irgendwann aufgeben muessen.",
    "sagt: ");
      
  AddInfo( ({ "abenteurer", "abenteuer" }),
    "Seid ihr gewillt, dieses Abenteuer zu bestreiten?",
    "sagt: ");
  AddInfo( ({ "spiel", "spielchen", "spielen" }),
    "Wie waere es mit einem kleinen Wuerfelspiel?",
    "sagt: ");
  AddInfo( ({ "wuerfelspiel","wuerfeln","wuerfel" }),
    "Ich spiele fuer mein Leben gerne mit Wuerfeln. Setzt Euren Einsatz "
	"und wir wuerfeln darum, allerdings zu meinen Bedingungen.",
    "sagt: ");
  AddInfo( ({ "einsatz" }),
    "Ihr setzt 300 Muenzen und macht einen Vorschlag was mein Einsatz sein soll.",
    "sagt: ");
  AddInfo( ({ "vorschlag" }),
    "Schreibt einfach so etwas wie \"Wuerfel mit Jann um bier\".",
    "sagt: ");
  AddInfo( ({ "papier" }),
    "Meint Ihr meinen Teil der Karte?",
    "sagt: ");
  AddInfo( ({ "geruecht" }),
    "Ich glaube schon, dass da etwas dran ist.",
    "sagt: ");
  AddInfo( ({ "holzbein" }),
    "Na, ich habe zum Glueck noch beide Beine. Mein Freund Drako braucht allerdings ein neues.", 
    "sagt: ");
  AddInfo( ({ "messer","schnitzmesser" }),
    "Ich habe eines uebrig und wuerde mit Euch darum spielen.",
    "sagt: ");
  AddInfo( ({ "blume" }),
    "Blumen gibt es hier nur wenige.",
    "sagt: ");
  AddInfo( ({ "vulkanblume" }),
    "Die sind sehr selten. Und wie der Name schon sagt wachsen sie nur tief in Vulkanen.",
    "sagt: ");
  AddInfo( ({ "vulkane","vulkan" }),
    "Ich kenn nur einen Vulkan. Er ist nicht weit weg, sondern befindet "
	"sich auf einer kleinen Insel suedlich unserer Insel.",
    "sagt: ");
  AddInfo( ({ "kleine insel" }),
    "Dort kann man vom Strand aus hinschwimmen.",
    "sagt: ");
  AddInfo( ({ "strand" }),
    "Der Strand hier ist herrlich, nicht wahr?",
    "sagt: ");
  AddInfo( ({ "kapitaen" }),
    "Einst war Drako mein Kapitaen. Nun bin ich sesshaft geworden.",
    "sagt: ");
  AddInfo( ({ "muenzen" }),
    "Davon habe ich nicht viele.",
    "sagt: ");
  AddInfo( ({ "schiff" }),
    "Ich war schon lange auf keinem Schiff mehr. Frueher segelte ich mit "
	"auf der Lacneia.",
    "sagt: ");
  AddInfo( ({ "lacneia" }),
    "Die Lacneia war einst Drakos Schiff. Sie ist aber vor vielen Jahren "
	"unter gegangen.",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
  AddInfo( ({ "" }),
    "",
    "sagt: ");
      
 AddCmd( ({ "wuerfel", "wuerfle" }), "wuerfelnCmd" );
 AddCmd( ({ "bitte" }), "bittenCmd" );

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/hose");
  CLONEME("/p/armour/boots/lederschuhe");  
  command("trage alles");
  CLONEME("/p/weapon/sword/saebel" );
  command("zuecke saebel");  
  	ob=clone_object(PIR_OBJ +"piratenschatzkartenteil");
	ob->zahlkriegen(1);
	ob->move(TO); 
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "lacht.",
        "lacht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schlaegt mit der Faust auf den Tresen.",
        "schlaegt mit der Faust auf den Tresen.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt.",
        "schmunzelt.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schimpft ueber Dich.",
        "schimpft ueber " +TPN+ ".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "klopft Dir auf die Schulter.\nJann brummt: Recht so, nur nie zu nett zu anderen.",
        "klopft "+TP->name(WEM)+"auf die Schulter.\nJann brummt: Recht so, nur nie zu nett zu anderen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "groehlt etwas Unflaetiges.", 
        "groehlt etwas Unflaetiges.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "laesst das voellig kalt.",
        "laesst das voellig kalt.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
//    case "neutral":
//      call_out("reaction", 0, TP,
  //      "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.",
    //    "zieht ein riesiges Taschentuch aus dem Aermel und schneuzt sich gereuschvoll.");
      //break;
    case "traurig":
      call_out("reaction", 0, TP,
        "wird sentimental.",
        "wird sentimental.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  	{
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int wuerfelnCmd(string str )
{  	int a;
  	int b;
	object ob;
if(this_player()->QueryMoney() >= 300)
{  notify_fail( "Mit wem moechtest Du um was wuerfeln?\n" );

  if( str == "mit jann um kartenteil"|| str == "mit jann um karte"
    ||str == "mit jann um teil"  )
  { 
    if(TP->QueryQuest("Finde den Piratenschatz")||present("KARTE1",TP))
	{
	   write("Jann sagt: Ihr habt meinen Kartenteil doch bereits bekommen!\n");
	   return 1;
	   }
  	if (present("KARTE1",TO))
	{ this_player()->AddMoney(-300);
  	write("Du setzt legst 300 Muenzen auf den Tresen, Jann legt seinen Kartenteil daneben.\n" );
    say( TPN+" startet ein Wuerfelspiel mit Jann.\n", TP);
  	a = random (5);
  	a+=1;
    write("Jann wuerfelt eine "+a+".\n");
b = random (5);
b+=1;
    write("Du wuerfelst eine "+b+".\n");
 if (a>=b)
 	{write("Jann sagt: Ha, ich hab gewonnen!\nJann nimmt sich die Muenzen " +
 		"und steck seinen Kartenteil wieder ein.\n");
 		return 1;}
 	
 	else  
  {
  	write("Jann sagt: Wohlan, Ihr habt gewonnen, hier habt Ihr meinen Kartenteil!\n"+
  	"Jann gibt Dir das Stueck Papier. Du nimmst es und steckst auch Deine Muenzen wieder ein.\n");
    say("Jann gibt "+TPN+" ein Stueck Papier.\n",TP);	
  	this_player()->AddMoney(300);
    present("KARTE1",TO)->move(TP, M_NOCHECK);
	}
    return 1;
  }
//  return 0;
else
	{write("Jann sagt: Tut mir leid, das habe ich schon verspielt.\n");
return 1;}
 }// Ende mit Jann um Kartenteil

if   ( str == "mit jann um malzbier"||str=="mit jann um bier" )
	{ 
		this_player()->AddMoney(-300);
  	write("Du legst 300 Muenzen auf den Tresen, Jann stellt ein Malzbier daneben.\n" );
    say( TPN+" startet ein Wuerfelspiel mit Jann.\n", TP);
  	a = random (5);
  	a+=1;
    write("Jann wuerfelt eine "+a+".\n");
		b = random (4);
		b+=1;
    write("Du wuerfelst eine "+b+".\n");
 if (a>=b)
 		{
 			write("Jann sagt: Ha, ich hab gewonnen!\nJann nimmt Deine Muenzen und trinkt das Bier.\n");
 			return 1;
 		}
 	
 	else  
  {
  	write("Jann sagt: Wohl an, Ihr habt gewonnen. Hier habt Ihr ein Bier!\n"+
  	"Jann schiebt Dir das Malzbier zu, Du trinkst es sofort und nimmst auch Deine Muenzen zurueck.\n");
   	say("Jann gibt "+TPN+" ein Malzbier.\n",TP);	
		this_player()->AddMoney(300);
		TP->AddHp(20);
		TP->AddSp(21);
  	return 1;
  }
} //Ende um malzbier

    if( str == "mit jann um schnitzmesser"||str=="mit jann um messer" )
  { 
    this_player()->AddMoney(-300);
  	write("Du legst 300 Muenzen auf den Tresen, Jann legt ein Schnitzmesser daneben.\n" );
    say( TPN+" startet ein Wuerfelspiel mit Jann.\n", TP);
  	a = random (5);
  	a+=1;
    write("Jann wuerfelt eine "+a+".\n");
		b = random (5);
		b+=1;
    write("Du wuerfelst eine "+b+".\n");
 
 if (a>=b)
 		{
 		write("Jann sagt: Ha, ich hab gewonnen!\n");
 		return 1;
 		}
 	
 	else  
  {
  	write("Jann sagt: Nun denn, Ihr habt gewonnen, hier ist das Schnitzmesser!\n"+
  	"Du nimmst das Messer und steckst auch Deine Muenzen wieder ein.\n");
   	say("Jann gibt "+TPN+" ein Schnitzmesser\n",TP);	
  	this_player()->AddMoney(400);
  	CLONE("/p/weapon/knife/messer", TP);

  	}
    return 1;
  
} //Ende um Schnitzmesser

}//Ende wenn er genug Geld hat
else
	{	
		write("Jann sagt: Ihr habt nicht genug Geld dabei. Schert Euch fort!\n");
		return 1;
	}

}//ende wuerfelnCmd


int bittenCmd(string str)
  {
  	notify_fail( "Um was moechtest Du wen bitten?\n" );
  if (str == "jann um kartenteil"|| str == "jann um schnitzmesser"||str == "jann um karte"|| str == "jann um messer"||str == "jann um teil")
  	{
		write ("Jann sagt: Ich wuerde darum mit Dir wuerfeln. Allerdings zu meinen Bedingungen.\n");
		say(TPN+"bittet Jann um etwas, bekommt aber nichts.\n", TP);
		return 1;
	}

}


void die()
{
   object ob;
   ob=QueryProp(P_KILLER);
   if(!present("KARTE1",TO)) 
   {::die();
    return;}
	if(ob->QueryQuest("Finde den Piratenschatz")||!interactive(ob)||present("KARTE1",ob))
		{
			present("KARTE1",TO)->remove();
			tell_room(environment(TO),"Jann zerreisst mit letzter Kraft ein Stueck Papier.\n");
			
			}
	else 
	   {
	     present("KARTE1",TO)->move(ob, M_NOCHECK);
		 tell_object(ob,"Schnell nimmst Du den Kartenteil an Dich.\n");
		 }
  	::die();
}