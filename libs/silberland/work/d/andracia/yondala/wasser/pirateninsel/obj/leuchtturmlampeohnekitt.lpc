#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <moredef.h>

object obj;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse, wackelige Lampe");
  SetProp(P_LONG,
    "Diese Lampe besteht aus einem Lampengestell und einer Glashuelle. Beides muesste noch "
    "miteinander verkittet werden." );
  SetProp(P_NAME, "Lampe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lampe"}));

    SetProp( P_MATERIAL, ([ MAT_GLASS : 60, MAT_IRON : 40 ]) );

  SetProp(P_WEIGHT, 1150);
  SetProp(P_VALUE, 263);

 AddCmd( ({ "kitte" }), "kittenCmd" );  
}


int	kittenCmd(string str)
{ notify_fail("Was moechtest Du aneinander kitten?\n");
//mit und an noch einfuegen
if(str=="glashuelle und lampengestell"
   ||str=="glashuelle und lampengestell aneinander"
   ||str=="glas an gestell fest"
   ||str=="glas in gestell"
   ||str=="glas an gestell"
   ||str=="glas an lampengestell"
   ||str=="glas im gestell fest"
   ||str=="glas mit gestell"
   ||str=="glas in lampengestell fest"
   ||str=="glas in lampengestell")
{	

	if(present("kitt",  TP))
	{
		write("Du kittest die Glashuelle an das Lampengestell.\n");
		say(TPN+" kittet eine Lampe.\n", TP);
		CLONE(PIR_OBJ +"leuchtturmlampeohnekerze", TP);
obj = present("kitt",  TP);
obj->remove();
    this_object()->remove();
		return 1;
	}

else
	{write("Du hast keinen Kitt bei Dir.\n");}
	
return 1;
}
}