//7.6. Stoppt nun, wenn der Spieler offline geht und macht weiter, wenn 
//er wieder einloggt
//Yondala@Silberland 9.5.2010
//wird geclont, wenn man von Roger nen Arm abgehackt bekommt
//zieht langsam LPs ab und gibt chats aus.
//unsichtbar
//kann nicht abgelegt werden
//Zieht 28 Kraft ab

//ACHTUNG: es sollte die Funktion void wiederheile() aufgerufen werden, wenn z.B. ein PIR_NPC den Arm annaeht



#include "../def.h"

inherit "std/thing";

#include <properties.h>
string *nachrichten;
int blutend; //blutet der Spieler?
void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  blutend=1;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0 );
  SetProp(P_NAME, "Blutverlust");
  SetProp(P_GENDER, MALE);
  AddId("\narm_invis");
  SetProp(P_AUTOLOADOBJ,1);
 // SetProp( P_MATERIAL, ([ MAT_FLESH : 55, MAT_SKIN: 15, MAT_BONE: 30 ]) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_X_ATTR_MOD,([A_STR:-28]));
  call_out("blutverlust", 1);
 nachrichten=({"Blut tropft aus Deiner Wunde.\n",			
			"Du spuerst, wie Dir langsam die Kraefte schwinden.\n",
			"Der Blutverlust macht Dir langsam zu schaffen.\n",
			"Du blutest.\n",
			"Du ueberlegst wo das naechste Spital ist.\n",
			"Deine Knie zittern.\n",
			"Du wirst ploetzlich soooooo muede.\n",
			"Du halluzinierst.\n",
			"Du ueberlegst, ob es im Freien Waende gibt.\n",
			"Deine Wunde schmerzt.\n",
			"Dir ist kalt.\n"});
}

 void NotifyPlayerDeath(object victim, object killer, int lost_xp)
 {
    if(victim==environment(TO)) remove();
	}

void blutverlust()
{
	int zeit;
	int nachricht;
	nachricht=random(10);
    if(!blutend) return;
	zeit=random(10);
	zeit+=15;
	environment(TO)->do_damage(random(10),"Blutverlust");

	tell_object(environment(TO), nachrichten[random(sizeof(nachrichten)-1)]);


  call_out("blutverlust", zeit);

}


void wiederheile()//kann auch beim annaehen aufgerufen werden
{
  if(environment(TO)->QueryProp(P_MAX_HANDS)<2) 
  {
    tell_object(environment(TO),"Dein Koerper ist endlich wieder vollstaendig.\n");
    environment(TO)->SetProp(P_MAX_HANDS,2);
	blutend=0;
	}

remove();
}
int auaweg()
{
    if (find_call_out("blutverlust"))remove_call_out("blutverlust");
	if (environment(TO)->QueryProp(P_MAX_HANDS)==1)	tell_object(environment(TO),"Deine Wunden schliessen sich.\nGanz langsam waechst Dein Arm nach.\n");
	else tell_object(environment(TO),"Deine Wunden schliessen sich.\nGanz langsam wachsen Deine Arme nach.\n");
	call_out("wiederheile",1800);//mal sehen , ob 30 Minuten gut sind
	blutend=0;
	}
	
	
void BecomesNetDead(object spieler)
{
  if(spieler!=environment(TO)) return;
      if (find_call_out("blutverlust"))
	  {
	    remove_call_out("blutverlust");
		blutend=1;
		}
}

BecomesNetAlive(object spieler)
{
  if(spieler!=environment(TO)) return;
  if(blutend)  blutverlust();
  }