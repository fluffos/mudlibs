#include "../def.h"

inherit "std/room";
#include <moredef.h>
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wal" );
  SetProp( P_INT_LONG,  "Um Dich herum ist es fast dunkel. Der Raum, in dem Du Dich "
  "befindest ist rund. Die Waende, wenn man sie denn so nennen kann, sind rosarot. Der "
  "Raum scheint hinter Dir kein Ende zu finden, waehrend vor Dir eine gelbliche Mauer ist. "
  "Als Du Dich naeher umschaust, kommst Du zu der Feststellung, dass Du im Magen des Wals "
  "gefangen sein musst." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wal", "raum" }),
    "Du bist in einem Wal gefangen.");
  AddDetail( ({ "boden" }),
    "Was man so Boden nennt. Du stehst auf einer gigantischen Zunge.");
  AddDetail( ({ "zunge" }),
    "Die Zunge des Wals, der Dich verschluckt hat.");
  AddDetail( ({ "wand", "waende" }),
    "Die \"Waende\" des Wals sind rechts und links von Dir, vorne " +
    "siehst Du eine gelbliche Mauer, hinter Dir geht es "+
    "weiter in den Wal hinein, dort kannst Du allerdings nichts erkennen.");
  AddDetail( ({ "mauer" }),
    "Die Mauer scheinen die Zaehne des Wals zu sein.");
  AddDetail( ({ "zaehne" }),
    "Grosse, gelbe, gefaehrliche Zaehne. An denen kommst Du nicht vorbei.");
  AddDetail( ({ "decke" }),
    "Der Rachen des Wals bildet die \"Decke\" hier.");
  AddDetail( ({ "rachen" }),
    "Der Rachen eines Wals ist sehr empfindlich. Hinter Dir haengt das gigantische "
    "Zaepfchen des Wals, etwas vor Dir siehst Du ein Loch im Rachen.");
  AddDetail( ({ "zaepfchen" }),
    "Es vibriert leicht und sieht sehr empfindlich aus.");
  AddDetail( ({ "ende" }),
    "Dort wirst Du sicherlich nicht herauskommen. Du musst Dir einen anderen Weg ausdenken.");
  AddDetail( ({ "weg" }),
    "Denke gut nach, denn lange haelst Du es hier sicher nicht aus.");
  AddDetail( ({ "feststellung" }),
    "Nun, diese Feststellung war sicher nicht schoen.");
  AddDetail( ({ "magen" }),
    "Du befindest Dich scheinbar darin.");
  AddDetail( ({ "loch" }),
    "Es scheint das Atemloch des Wals zu sein, denn das Loch oeffnet und schliesst sich "
    "regelmaessig und es stroemt frische Luft dadurch herein.");
  AddDetail( ({ "atemloch","loch" }),
    "Durch dieses Loch befoerdert der Wal Luft und andere unliebsame Dinge nach draussen.");
  AddDetail( ({ "dinge" }),
    "Bist Du vielleicht auch ein unliebsames Ding, das nach draussen gehoert?");
  AddDetail( ({ "luft" }),
    "Ab und zu stroemt frische Luft an Dir vorbei.");
  AddDetail( ({ "ding" }),
    "Wie stellst Du das bloss an, dass der Wal Dich rausblaest?");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautest Grummeln.");

  AddSound( ({ "grummeln" }),
    "Es scheint um Dich herum zu entstehen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Fisch.");

  AddSmell( ({ "fisch" }),
    "Allerdings riecht es nicht nach frischem Fisch...");


  AddRoomMessage( 
    ({"Das Loch an der Decke oeffnet sich und frische Luft stroemt herein.\n"}),50,"func");

  


  AddCmd( ({ "kitzel", "kitzle" }), "kitzelnCmd" );   
 
call_out("saeure",5); //fuehrt alle 5 Sekunden "saeure aus"
}

int alleraus(object ob) 
{
   ob->move( PIR_ROOM + "pirateninsel_10c", M_NOCHECK);
     return 1;
}


int kitzelnCmd(string str )
{
  mixed *people;
  notify_fail( "Wen oder was willst du kitzeln?\n" );
  if( str == "rachen von wal"||str== "den walrachen"||str== "wal an rachen"||str=="zaepfchen" )
  {
  	write("Du kitzelst den Wal am Rachen.\nErst tut sich nichts, doch "+
    "als Du etwas fester reibst faengt alles um Dich herum an zu vibrieren.\n"+
    "Ploetzlich zieht sich alles um Dich herum zusammen, die Waende kommen "+
    "immer naeher, Du fuerchtest zerquetscht zu werden. Doch dann aufeinmal "+
    "wirst Du nach oben gedrueckt.\nDieses seltsame Gefuehl hast Du seit "+
    "Deiner Geburt nicht mehr verspuert. Du fuehlst, wie Du durch die Luft "+
    "wirbelst. Nach unendlich langen Sekunden prallst Du mit voller Wucht "+
    "auf harten Stein. Du bist auf einer kleinen Insel gelandet.\n");
    
    say(TPN +" kitzelt den Wal am Rachen.\nErst tut sich nichts, doch "+
    "als" +TPN+ " etwas fester reibt faengt alles um Dich herum an zu vibrieren.\n"+
    "Ploetzlich zieht sich alles um Dich herum zusammen, die Waende kommen "+
    "immer naeher, Du fuerchtest zerquetscht zu werden. Doch dann aufeinmal "+
    "wirst Du nach oben gedrueckt.\nDieses seltsame Gefuehl hast Du seit "+
    "Deiner Geburt nicht mehr verspuert. Du fuehlst nun, wie Du durch die Luft "+
    "wirbelst. Nach unendlich langen Sekunden prallst Du mit voller Wucht "+
    "auf harten Stein. Du bist auf einer kleinen Insel gelandet.\n");

  people=filter_array( all_inventory(), #'interactive );
  map_array(people, #'alleraus);
	TP->AddHp(-50);
    return 1;
  }
  return 0;
}


void saeure()//hier soll jedem Spieler 2HP abgezogen werden alle x sec.
{
  object ob, next;
	for(ob=first_inventory(TO);ob;)
	{next=next_inventory(ob);
		if(living(ob))
			{write("Saeure tropft von oben auf Dich herab und veraetzt Deine Haut.\n");
				ob->do_damage(2,"Magensaeure");}
			ob=next;
			}
	call_out("saeure", 5);		
	}