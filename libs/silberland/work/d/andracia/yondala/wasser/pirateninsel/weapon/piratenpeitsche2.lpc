// mal sehen. Die soll heftig schaden machen, aber nicht so gut in der Hand liegen
// Ausserdem koennen nur boese, grosse Spieler die zuecken
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine neunschwaenzige Peitsche");
  SetProp(P_LONG,
    "Du siehst eine neunschwaenzige Peitsche. Es gibt kaum ein grausameres Schlagwerkzeug "
    "als dieses. Diese Waffe erzeugt besonders schlimme Wunden. Sie wird oft von miesen "
    "Sklaventreibern benutzt." );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "neunschwanz"}) );
  SetProp(P_AUTOLOADOBJ, 1);                                     

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40 );//wie geschickt man mit der Waffe ist (normal 30)
//  SetProp(P_DAM_TYPE, DT_ );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 3620);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 150);// haelt lang
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

//  SetProp(P_WC_BONUS, (["\n_broud":200])); //soll heissen, dass die Peitsche besonders gut von Broud gefuehrt werden kann
//  SetProp(P_WIELD_RESTRICTIONS, ([A_:]) );
}


     int WieldFunc(object waffe)
     {

       if (this_player()->QueryProp(P_SIZE) <= 150)
            {	write( "Du bist zu klein um die Peitsche zu zuecken.\n");
							return 0;}
			 if (this_player()->QueryProp(P_ALIGN)>=200)
			 	{write("Du bist viel zu gut um solch eine boese Waffe benutzen zu wollen.\n");
			 		return 0;}
			else
       return 1;
     }



int UnwieldFunc(object waffe) {
  return 1;
}

int HitFunc( object enemy ) {
  return 0;
}




