#include "../def.h"

inherit "std/room";

#include <properties.h>
int da = 3;

void reset()
{::reset();
		da=3;
}	

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Palme" );
  SetProp( P_INT_LONG,
    "Du sitzt hoch oben auf den Blaettern einer Palme am Strand der "
	"Pirateninsel. Von hier oben hast Du einen sagenhaften Ausblick auf "
	"die Insel und das Meer, von dem sie umgeben ist." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "blaettern", "blaetter" }),
    "Zwischen den Blaettern entdeckst Du ein paar Bananenstauden.");
  AddDetail( ({ "bananenstauden", "stauden", "bananen" }),
    "Zwischen ihnen sind bestimmt ein paar Bananen, die man pfluecken kann.");
  AddDetail( ({ "banane" }),
    "Hm, lecker, Banane.");
  AddDetail( ({ "aussicht", "ausblick", "sicht" }),
    "Die Aussicht hier oben ist herrlich, Du kannst die ganze Insel "
	"ueberblicken.");
  AddDetail( ({ "insel", "pirateninsel" }),
    "Die Insel erstreckt sich von Osten nach Westen und von Norden bis "
	"zum Strand unter Dir.");
  AddDetail( ({ "osten", "westen" }),
    "Oestlich und westlich von Dir erheben sich zwei kleine Huegel.");
  AddDetail( ({ "huegel" }),
    "Es gibt zwei davon.");
  AddDetail( ({ "norden" }),
    "Im Norden steht der alte Leuchtturm.");
 AddDetail( ({ "osten" }),
    "Hinter dem Huegel kannst Du den Steg "+
    "mit der kleinen Kneipe erkennen.");
	AddDetail( ({ "kneipe", "steg" }),
    "Sieht winzig aus von hier.");
  AddDetail( ({ "leuchtturm" }),
    "Der Leuchtturm ist rot weiss gestreift und ragt hoch in den Himmel.");
  AddDetail( ({ "sueden" }),
    "Suedlich endet die Insel. Allerdings kannst Du in keiner grossen " +
    "Entfernung eine kleine Insel sehen, zu der man vielleicht herueber " +
    "schwimmen koennte.");
  AddDetail( ({ "kleine Insel" }),
    "Auf der kleinen Insel glaubst Du einen Vulkan sehen zu koennen.");
  AddDetail( ({ "vulkan" }),
    "Leider siehst Du nicht, ob er noch aktiv ist.");
  AddDetail( ({ "meer" }),
    "Das Meer umgibt die Insel. Weit hinten auf dem Meer siehst Du ein paar dunkle Punkte.");
  AddDetail( ({ "punkte" }),
    "Du glaubst, dass es durchaus moeglicherweise eventuell tatsaechlich Wale sein koennten.");
  AddDetail( ({ "wale", "tiere" }),
    "Solange man nicht IN einem Wal ist sind es wahrlich nette Tiere.");
  AddDetail( ({ "wal" }),
    "Es soll wirklich gefaehrliche Wale geben.");
  AddDetail( ({ "boden" }),
    "Der Boden ist weit unter Dir. Pass auf, dass Du nicht runter faellst.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber Dir ist blau, die Sonne lacht auf Dich herunter.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht.");
  AddDetail( ({ "palme" }),
    "Du sitzt zwischen vielen grossen Blaettern auf einer Palme.");
  AddDetail( ({ "strand", "sandstrand" }),
    "Schoener, weisser Sandstrand liegt unter Dir.");
  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");

  AddSound( ({ "meer","rauschen" }),
    "Das Rauschen des Meeres wirkt so friedlich und beruhigend.");
  AddSound( ({ "moewen","moewe" }),
    "Die Moewen scheinen nicht weit weg zu sein, Du kannst sie immer "
	"wieder schreien hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Du riechst salzige Seeluft und suesse Bananen.");

  AddSmell( ({ "bananen" }),
    "Hmm, das riecht koestlich.");

  AddRoomMessage( 
    ({""}),30,"func");

//  AddCmd( ({ "tue" }), "command" );

 AddCmd( ({ "pflueck", "pfluecke" }), "pflueckenCmd" );
 AddCmd( ({ "kletter", "klettere" }), "kletternCmd" );

//       AddExit( "unten", "/d/pirateninsel_8c" );
       
  //AddItem( "item" , REFRESH_DESTRUCT);
}



pflueckenCmd(string str )
{
  notify_fail( "Was moechtest Du pfluecken?\n" );
  if( str == "bananen" )
  {
    write("Nicht so gierig, immer nur eine.\n");
	return 1;
	}
  if( str == "banane" )
  {  
  	if (da > 0)
  	{
    write("Du pflueckst eine Banane.\n");
    say( TPN+" pflueckt eine Banane.\n", TP);
    CLONE(PIR_OBJ +"banane", TP);
		da-=1;	
	}
else
	{    write("Du suchts, findest aber keine reife Banane mehr.\n");}
	    return 1;
  }
  return 0;
}

kletternCmd(string str )
{
  notify_fail( "Wo willst du hin klettern?\n" );
  if( str == "runter" )
{
  	TP->move(PIR_ROOM + "pirateninsel_8c", M_GO,
  	"","klettert von der Palme herunter","kommt von einer Palme herab geklettert");
    return 1;

  }
  return 0;
}