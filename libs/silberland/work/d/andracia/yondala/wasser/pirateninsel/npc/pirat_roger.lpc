	"sie gegen sein Leben einzutauschen.",
    "sagt: ");
    AddInfo( ({ "derlim" }),
    "Derlim ist eine Stadt im Westen der Silberlandes.",
    "sagt: ");
    AddInfo( ({ "stadt","staedte" }),
