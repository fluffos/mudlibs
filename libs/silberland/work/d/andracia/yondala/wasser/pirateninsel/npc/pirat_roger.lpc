inherit PIR_NPC + "pirat_std.lpc";
inherit "/std/npc/spells";


object *aergerer; //speichert, wer ihn geaergert hat
int ausweichen; //weicht er aus? Wird per Spell gesetzt
int grund; //bei reset wird entschieden, warum er handelt
/*
1=Hunger
2=Muss geputzt werden

*/
void essennicht()
{
  tell_room(environment(TO),"Roger Schwartbart wirft die Schale hinter "+
                            "Hildgunde her.\n");
}
void essenja()
{
  tell_room(environment(TO),"Roger Schwartbart schluerft die Suppe auf ex.\n");
}
void essen3()
{
  if(InFight())return;
  if(random(2)==1)
  {
     //
    command("sag Pfui Teufel, das ist ja widerlich!");
	call_out("essennicht",1);
	return;
	}
    command("sag Na, heute gehts ja.");
	call_out("essenja",1);
} 
void essen2()
{
  if(InFight())return;
  tell_room(environment(TO),"Roger Schwartbart schnuppert an der Schale.\n");
  call_out("essen3",2);
 }
void essenbekommen()
{
  if(InFight())return;
  call_out("essen2",3);
}
void aufwachen_schreck2()
{
   if(InFight()) return;
   command ("sag Oh, Ihr seid es, "+TPN+", Ihr habt mich erschreckt.\n");
   call_out("aufwachen5",5); 
   }
void aufwachen_schreck()
{
  write("Roger springt mit einem Satz aus der Haengematte und haelt Dir "+
       "seinen Saebel an die Kehle.\n");  
  say("Roger springt mit einem Satz aus der Haengematte und haelt "+
       TP->name(WEM)+" seinen Saebel an die Kehle.\n",TP);  
  command("sag Was wollt Ihr, Elendiger?");
   SetProp(P_SHORT, "Roger Schwarzbart");
  SetProp(P_LONG,
    "Das ist Roger Schwarzbart. Er ist der Anfuehrer der Piratenmeute. "
    "Ihm obliegt es, einen Anwaerter anzunehmen oder ihm ein Piratenleben zu verwehren. "
    "Schwarzbart traegt ein Leinenhemd und eine Leinenhose. Auf dem Kopf traegt er einen "
    "Kapitaenshut. An seinen Haenden traegt er mehrere dicke Ringe. Ausserdem erkennt "
    "man auf den ersten Blick, woher er seinen Namen hat.");					  
  call_out("aufwachen_schreck2",5);
  	SetChats(1, ({""}) );
	RemoveCmd(({"frage","frag"}));
	SetProp(P_NOATTACK,0);
  }

void aufwachen5()
{
    if(!InFight())
	tell_room(environment(TO),"Roger nimmt die Haengematte ab und "+
	"verstaut sie wieder in der Truhe.\n");
    environment(TO)->RemoveDetail("haengematte");
    environment(TO)->RemoveDetail("matte");
	}
void aufwachen4()
{
    command("sag Haaach, das tat mal wieder gut.\n");
	SetProp(P_NOATTACK,0);
	call_out("aufwachen5",3);
}
void aufwachen3()
{
    tell_room(environment(TO),"Roger steigt aus seiner Haengematte.\n");
	call_out("aufwachen4",3);
}
void aufwachen2()
{
    tell_room(environment(TO),"Roger streckt sich.\n");
	call_out("aufwachen3",3);
}


void aufwachen()
{
    tell_room(environment(TO),"Roger oeffnet die Augen.\n");
	SetProp(P_NOATTACK, "liegt noch in seiner Haengematte. Warte "+
	                    "wenigstens, bis er aufgestanden ist.");
	RemoveCmd(({"frage","frag"}));
  SetChats(1, ({""}) );
  SetProp(P_SHORT, "Roger Schwarzbart");
  SetProp(P_LONG,
    "Das ist Roger Schwarzbart. Er ist der Anfuehrer der Piratenmeute. "
    "Ihm obliegt es, einen Anwaerter anzunehmen oder ihm ein Piratenleben zu verwehren. "
    "Schwarzbart traegt ein Leinenhemd und eine Leinenhose. Auf dem Kopf traegt er einen "
    "Kapitaenshut. An seinen Haenden traegt er mehrere dicke Ringe. Ausserdem erkennt "
    "man auf den ersten Blick, woher er seinen Namen hat.");					  
	call_out("aufwachen2",3);
}
void schlafen8()
{
  //if(InFight()) return;
  tell_room(environment(TO),"Roger schliesst die Augen.\n");
  AddCmd(({"frage","frag"}), "fragen_abfangen");						  
SetProp(P_NOATTACK, "schlaeft. Vielleicht solltest Du ihn wecken, eh "+
                      "Du ihn angreifst!? Alles andere waere feige.");
  SetChats(1, ({"Roger schnarcht leise.\n",
                 "Die Haengematte schaukelt sanft hin und her.\n"}) );
  SetProp(P_SHORT, "Roger Schwarzbart liegt in einer Haengematte und schlaeft");
  SetProp(P_LONG,
    "Das ist Roger Schwarzbart. Er ist der Anfuehrer der Piratenmeute. "
    "Ihm obliegt es, einen Anwaerter anzunehmen oder ihm ein Piratenleben "
	"zu verwehren. Schwarzbart traegt ein Leinenhemd und eine Leinenhose. "
	"Auf dem Kopf traegt er einen Kapitaenshut. An seinen Haenden traegt "
	"er mehrere dicke Ringe. Ausserdem erkennt man auf den ersten Blick, "
	"woher er seinen Namen hat. Im Moment liegt er aber schlafend in "
	"seiner Haengematte.");

  }
void schlafen7()
{
  //if(InFight()) return;
  tell_room(environment(TO),"Roger gaehnt.\n");
  call_out("schlafen8", 5);
  }
void schlafen6()
{
  if(InFight()) return;
  tell_room(environment(TO),"Roger laesst sich unelegant in die "
                            "Haengematte fallen.\n");
 	SetProp(P_NOATTACK, "liegt doch in seiner Haengematte. Warte "+
	                    "wenigstens, bis er aufgestanden ist.");  
						
  call_out("schlafen7", 5);
  }
  
void schlafen5()
{
  if(InFight()) return;
  tell_room(environment(TO),"Roger spannt die Haengematte von einer "+
                            "Wand zur anderen.\n");
  
  environment(TO)->AddDetail(({"haengematte","matte"}),
     "Eine einfache Haengematte wurde hier von Wand zu Wand gespannt.\n");

  call_out("schlafen6", 5);
  }

void schlafen4()
{
  if(InFight()) return;
  tell_room(environment(TO),"Roger oeffnet die Truhe und nimmt eine "
                            "Haengematte heraus.\n");
  call_out("schlafen5", 5);
  }

  
void schlafen3()
{
  if(InFight()) return;
  command("sag Zeit fuer ein Nickerchen!\n");
  call_out("schlafen4", 5);
  }

  
void schlafen2()
{
  if(InFight()) return;
  tell_room(environment(TO),"Roger streckt und reckt sich, dass die "+
                            "Knochen knacken.\n");
  call_out("schlafen3", 5);
  }

void schlafen()
{
  if(InFight()) return;
  tell_room(environment(TO),"Roger gaehnt.\n");
  call_out("schlafen2", 5);
  }
 
 
 void hildgunderuf2()
 { 
   object *raeume;
   string rufername;
   rufername=name();
   raeume=({});
   tell_room(environment(TO), "Roger bruellt: HILDGUNDE!\n");
   //call_out("hunger3", 10);
   environment(TO)->einruf("HILDGUNDE!",rufername, "hildgunde", raeume);
   }
 
 void hildgunderuf()
 {
   grund=(random(2))+1;
   if(grund==1) tell_room(environment(TO), "Rogers Magen knurrt.\n");
   if(grund==2) tell_room(environment(TO), "Roger denkt   . o O ("+
                    "Hier koennte auch mal wieder geputzt werden)\n");
   
   call_out("hildgunderuf2", 5);
   
   }
 
 void duwirstgerufen2(string text, string rufer)
{
   object *raeume;
   string rufername;
   rufername=name();
   raeume=({});
   if(rufer=="Hildgunde")
  {
    if(text=="Was willst Du?")
	{
      if(grund==1)//Hunger
	  {
	    tell_room(environment(TO),"Roger bruellt: Bring mir was zu "+
		                          "Essen, Weib!\n");
        environment(TO)->einruf("Bring mir was zu Essen, Weib!",
		                 rufername, "hildgunde", raeume);

	  }
	  if(grund==2)
	  {
	    tell_room(environment(TO),"Roger bruellt: Komm putzen!\n");
        environment(TO)->einruf("Komm putzen!",
		                 rufername, "hildgunde", raeume);
		}
	  
	 }
   }
}
void duwirstgerufen(string text, string rufer)
{
  call_out("duwirstgerufen2",1, text, rufer);
 }
 
void reset()
{
  int lust;
  ::reset();

  if(!is_clone(this_object())) {
    return;
  }

  if(QueryProp(P_NOATTACK))//bedeutet, dass er schlaeft
  { 
     if(random(2)) aufwachen();
	 return;
	 }
	if (InFight()) return;

	//Hat er Lust etwas zu tun? 
  lust=random(5);
  if(lust==1) schlafen();
  else if (lust==2) hildgunderuf();
	
  //else if (lust==3) stuhl();//erst wenn es P_NOMOVE gibt
 
  }

  
  

void create() 
{

  if (!is_clone(TO)) return;
  ::create();
  ausweichen =0;
  aergerer=({});
  grund=0;
  create_default_npc(50);
  SetProp(P_SHORT, "Roger Schwarzbart");
  SetProp(P_LONG,
    "Das ist Roger Schwarzbart. Er ist der Anfuehrer der Piratenmeute. "
    "Ihm obliegt es, einen Anwaerter anzunehmen oder ihm ein Piratenleben zu verwehren. "
    "Schwarzbart traegt ein Leinenhemd und eine Leinenhose. Auf dem Kopf traegt er einen "
    "Kapitaenshut. An seinen Haenden traegt er mehrere dicke Ringe. Ausserdem erkennt "
    "man auf den ersten Blick, woher er seinen Namen hat.");
  SetProp(P_NAME, "Roger Schwarzbart");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"roger", "roger schwarzbart", "schwarzbart", "pirat", "NOWIMPY",
          "Roger Schwarzbart"}));//letztere fuer die ruf-Funktion in Grotte
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 9500);
  SetProp(P_ALIGN, -800);
  SetProp(P_MSGIN, "kommt an und baut sich vor Dir auf");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt aus dem Hinterzimmer");
  SetProp(P_MMSGOUT, "verschwindet ins Hinterzimmer");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Piraten, vereinigt Euch gegen den Feind!");
  SetProp(P_KILL_MSG, "So solls sein!");
  SetProp(P_HANDS, ({"mit seinem ganzen Hass",QueryProp(P_HANDS)[2],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_KILL_NAME, "Roger Schwarzbart, der Anfuehrer das Piratenmeute");
 //geht in players nicht
 // SetProp(P_LOG_INFO, "yondala");
  
  
  //Kann ja mal noch was cooleres rein.
  //SetChats(1, ({"Roger poliert seinen Saebel.\n","Roger spaziert auf und ab.\n"}) );
  
  AddDetail( ({ "bart" }), 
    "Der Bart von Roger Schwarzbart ist scharz, daher sein Name.");
  AddDetail( ({ "name" }), 
    "Roger Schwarzbart.");
  AddInfo( ({ "roger", "schwarzbart", "roger schwarzbart", "anfuehrer" }),
    "Das bin ich.",
    "sagt: ");
  AddInfo( ({ "schatzkarte", "schatz" }),
    "Das ist doch Bloedsinn. Nur Narren suchen nach all den Jahren noch nach dem Schatz.",
	 "sagt: ");  
  AddInfo( ({ "drako" }),
    "Drako war mein Kapitaen, doch sein Schiff ging zu Bruch. Er verlor dabei sein Bein und "
    "seine Wuerde. Ich hab ihn als Fuerer abgesetzt. Nur wenige halten noch zu ihm. Seine "
    "Freunde erkennt Ihr an den albernen Medallien, die sie tragen.", 
    "sagt: ");  
  AddInfo( ({ "jann" }),
    "Jann besitzt die kleine Hafenkneipe am Steg. Ihr seid ihm sicher schon begegnet.",
    "sagt: ");    
  AddInfo( ({ "hein" }),
    "Hein ist der Leuchtturmwaechter dieser Insel.",
    "sagt: ");
  AddInfo( ({ "piet" }),
    "Piet ist der Ladenbesitzer hier.",
    "sagt: ");
  AddInfo( ({ "iskir" }),
    "Iskir besitzt einen kleinen Schnapsladen.",
    "sagt: ");
  AddInfo( ({ "broud" }),
    "Broud war der Sklaventreiber auf Drakos Schiff. Nun handelt er mit Sklaven.",
    "sagt: ");
  AddInfo( ({ "eharl" }),
    "Eharl ist ein listiger kleiner Kobold, wir haben ihn eins gefangengenommen auf einer "
    "unserer Kaperfahrten, doch der kleine Kerl hat gewaltige Zauberkraefte. Nun lebt er "
    "davon, dass er Schwarzgelder verwaltet.",
    "sagt: ");
  AddInfo( ({ "endoriel" }),
    "Endoriel ist ein sehr stolzer Elf. Er wurde aus seiner Heimat vertrieben. Da er gut "
    "kaempfen kann und sehr viel Mut besitzt nahmen wir ihn bei uns auf.",
    "sagt: ");
  AddInfo( ({ "trogurt" }),
    "Trogurt ist der Staerkste von uns. Er ist der Schmied auf dieser Insel, auch wenn er "
    "nicht mehr viel zu tun hat. Bei ihm koennen unerfahrene Piraten ihre Ausruestung reparieren lassen.",
    "sagt: ");
  AddInfo( ({ "hildgunde" }),
    "Das ist die Sklavin, die uns alle bedient. Sie gehoert aber eigentlich Broud.",
    "sagt: ");
  AddInfo( ({ "martus" }),
    "Martus ist ein alter Mann, der nie richtig kaempfen konnte. Er lebt nun davon, Medaillen "
    "an Abenteurer zu verkaufen.",
    "sagt: ");
  AddInfo( ({ "reichtuemer" }),
    "Bei uns Piraten ist es Brauch, dass wir unsere Schaetze vergraben um in kargen Zeiten "
    "davon leben zu koennen. Ausserdem verwahrt Eharl unsere Muenzen.",
    "sagt: ");
  AddInfo( ({ "schwarzgelder","schwarzgeld" }),
    "Bei Eharl koennen wir Piraten ein Schwarzgeldkonto eroeffnen",
    "sagt: ");
  AddInfo( ({ "schiff" }),
    "Ich fahre nur noch selten mit dem Schiff.",
    "sagt: ");
  AddInfo( ({ "lacnaia" }),
    "Die Lacnaia war das Schiff von Drako.",
    "sagt: ");

//*********************************************************
// Infos, die sich durch den Raum (Hauptquartier, piratengrotte_6f) ergeben
  AddInfo( ({ "schraenke" }),
    "In den Schraenken bewahre ich meinen Besitz auf.",
    "sagt: ");
   AddInfo( ({ "meister" }),
    "Ich bin ein Meister.",
    "sagt: ");
   AddInfo( ({ "andracia" }),
    "Andracia? Viele halten es fuer Seemannsgarn, doch es ist meine Heimat, dort bin "
    "ich geboren und aufgewachsen!"+
    "Ein ganzer Kontinent ist es, doch er ist weit weg und die Reise ist beschwerlich.",
    "sagt: ");
   AddInfo( ({ "kontinent","kontinent" }),
    "In dieser Welt gibt es viele Kontinente.",
    "sagt: ");
   AddInfo( ({ "welt" }),
    "Das Silberland und noch viel mehr, als Du Dir vorstellen kannst.",
    "sagt: ");
   AddInfo( ({ "silberland" }),
    "Das Silberland ist meine zweite Heimat.",
    "sagt: ");
   AddInfo( ({ "heimat" }),
    "Meine Heimat war einst Andracia.",
    "sagt: ");
   AddInfo( ({ "reise" }),
    "Ich reise nicht mehr viel, da ich mich auf dieser Insel zur Ruhe "+
	"gesetzt habe.",
    "sagt: ");
   AddInfo( ({ "karten","karte" }),
    "Ich habe noch ein paar Karten von frueher aufbewahrt. Hin und wieder "
	"schaue ich sie mir noch mal an.",
    "sagt: ");
   AddInfo( ({ "ruhe" }),
    "Ja, es ist wirklich schoen ruhig hier, seit ich kein Ausbilder mehr "+
	"bin. Hin und wieder landet noch ein Piratenschiff hier um uns zu "
	"versorgen, ab und an geh ich auch noch auf Kaperfahrt, aber mehr aus "
	"Vergnuegen denn aus Notwendigkeit.",
    "sagt: ");
   AddInfo( ({ "ausbilder" }),
    "Frueher habe ich die angehenden Piraten hier ausgebildet. Es war ein "
