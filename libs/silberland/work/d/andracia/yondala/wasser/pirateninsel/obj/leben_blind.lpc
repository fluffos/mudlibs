NotifyHpChange()
{
	  int    hp, mhp, sp, msp;
	  if(!aktiv) return;

  // Sicherheits-Check
  if (!previous_object() || !besitzer || (besitzer != previous_object()))
    return;
if(besitzer!=environment()) return;

  // Test auf Geist
  if (besitzer->QueryProp(P_GHOST)) return;

  // aktuelle Werte ermitteln
  hp = besitzer->QueryProp(P_HP);
  mhp = besitzer->QueryProp(P_MAX_HP);
  sp = besitzer->QueryProp(P_SP);
  msp = besitzer->QueryProp(P_MAX_SP);


  // Test auf Tod
  if ((hp<=0) || (!living(besitzer)))
  {
 			aktiv=0;
			besitzer->RemoveHpHook(ME);
  }

//Anzeige:
//LP:x(+-y) - MP:x(+-y) - gesund - Haarfarbe - zaubern: ja

//fuer den Fall, dass Frosch, weil dann ists unter null und springt dauernd hin und her

if(lastHP>hp||lastHP<hp+5||lastSP>sp||lastSP<sp+5) //Wenn weniger oder mehr als 5 groesser
  {
    tell_object(besitzer,"LP: "+hp+"  SP: "+sp+"\n");
	lasthp=hp;
	lastsp=sp;
	}
