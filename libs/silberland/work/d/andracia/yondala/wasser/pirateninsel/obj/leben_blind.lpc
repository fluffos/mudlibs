//
#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>//fuer die Vision
#include <ansi.h>//fuer die Farben
object besitzer;
nosave int lastHP, lastSP, aktiv=0, farbe=0;
//string aktStr;
void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Der Ohrring des Lebens");
  SetProp(P_LONG,
  "Du siehst einen kleinen, goldenen Ohring. Wenn Du ihn in Dein Ohr "
  "steckst, berichtet er ueber Deinen Gesundheitszustand.");

  AddId( ({"ohrring","ohrring des lebens"}) );
  SetProp(P_INFO, "Du erkennst, dass Du den Report mit dem Befehl <ohrring> "+
                  "ein oder aus schalten kannst.\n");

  
  
  
    SetProp(P_NAME, "Ohrring des Lebens");
  SetProp(P_GENDER, MALE);
 
  SetProp(P_MATERIAL, ({MAT_SILVER, MAT_MISC_MAGIC }));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, "Den Ohrring moechtest Du nicht missen.\n");
  SetProp(P_NEVERDROP, 1);

	SetProp(P_WORN_TEXT, "ins Ohr gesteckt");
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
  
  
  
  
  
  
  
  
  
  
  

  AddCmd( ({ "ohrring"}), "ohrringreport");


  lastHP = lastSP = -1;
}


int ohrringreport(string str)
{
	notify_fail("Ohrring ein oder aus?\n");
	besitzer=environment();
	if(str=="ein")
		{
			aktiv=1;
			write("Der Report ist nun eingeschaltet.\n");
            lastHP = besitzer->QueryProp(P_HP);
            lastSP = besitzer->QueryProp(P_SP);
            besitzer->AddHpHook(ME);
			return 1;
		}
	if(str=="aus")
		{
			aktiv=0;
			write("Der Report ist nun ausgeschaltet.\n");
			besitzer->RemoveHpHook(ME);
			return 1;
		}	
