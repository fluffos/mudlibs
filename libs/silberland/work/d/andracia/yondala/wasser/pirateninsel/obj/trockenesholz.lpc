#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Trockenes Holz");
  SetProp(P_LONG,
    "Etwas trockenes Holz." );
  SetProp(P_NAME, "Holz");
  SetProp(P_GENDER, NEUTER);
  AddId(({"trockenes holz", "holz"}));

  SetProp(P_MATERIAL, MAT_OAK );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
}


