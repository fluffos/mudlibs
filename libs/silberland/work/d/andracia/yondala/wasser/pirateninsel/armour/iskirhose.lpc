#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse Hose");
  SetProp(P_LONG,
    "Eine grosse, gruene Hose." );
  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "grosse hose", ""}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 100);
                                     

SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE : 180,
                                   P_GENDER    : MALE]) );

}
