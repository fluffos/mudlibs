inherit "/std/lightsource";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "../def.h"
#include <lightsource.h>
create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("kerze");
  SetProp(P_NAME,"Kerze");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Kerze");
  SetProp(P_LONG,
      "Eine ganz normale Kerze aus Wachs.\n"
      "Man kann sie anzuenden und wieder loeschen.\n");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,1000);
  SetProp(P_MATERIAL, MAT_WAX );
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,2000);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );


}

