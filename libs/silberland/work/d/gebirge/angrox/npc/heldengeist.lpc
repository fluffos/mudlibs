inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <player.h>
#include <moving.h>
#include <new_skills.h>

#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  
  AddId ( ({"geist", "heldengeist", "geist eines heldes"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Geist");
  SetProp (P_NAME, "Heldengeist");
  SetProp (P_SHORT, "Der Geist eines Helden");

  SetProp (P_LONG,BS(
              "Eine ueberirdisch leuchtende Gestalt mit einer erhabenen Aura der Macht, die "
             +"fast koerperlich zu spueren ist.\n"));
                

  create_default_npc(19);
  SetProp (P_ALIGN, 0);
  SetProp (P_BODY, 200);
  SetProp (P_HP, 800);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit ueberirdischem Licht ", 200, DT_LIGHT}) ); 
  set_living_name("heldengeist");  
  SetProp (P_RESISTANCE, ({ PHYSICAL_DAMAGE_TYPES }) );
  // SetProp (P_VULNERABILITY, ({ DT_MAGIC,  }) );
  SetProp (P_NOCORPSE, 1);
  SetProp(P_SPELLRATE,50);
  SetProp(P_MURDER_MSG, "Angrox .... MACH MICH BESSER!");
  SUID;
  CLONEME(OBJ("lkeule"));
  

  AddSpell(4,120,
	"Der Geist huellt dich in gleissendes Licht.\n",
	"Der Geist huellt @WEN in gleissendes Licht.\n",
        DT_LIGHT, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,180,
	"Der Geist dringt in deine Gedanken ein und durchwuehlt sie ...\n",
	"Der Geist macht irgendwas mit @WEN.\n",
        DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
	"Der Geist blickt dich erhaben und pruefend an.\n",
	"Der Geist laechelt.\n" }) );
    
  SetProp (P_DIE_MSG,BS(
               " ruft:\"Du bist wahrlich wuerdig. Nimm nun was Dir zusteht!\"\n"));
 
  AddInfo ("angrox",
	"sagt:\"Angrox ist mein Schoepfer!\"\n");

  

  SetProp( P_REJECT, ({ REJECT_DROP, 
	"sagt:\"Ich kann nichts Materielles mehr nehmen!\"\n" }) );


 }

