inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <player.h>
#include <moving.h>
#include <new_skills.h>

#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"geist","zwergengeist"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Geist");
  SetProp (P_NAME, "Zwergengeist");
  SetProp (P_SHORT, "Der Geist eines Zwerges");

  SetProp (P_LONG, "Die durchscheinende Gestalt hat das Aussehen eines Zwerges.\n"
				+  "Die Gestalt strahlt eine entsetzliche Traurigkeit aus.\n");

  create_default_npc(15);
  SetProp (P_ALIGN, 0);
  SetProp (P_SIZE, 136);
//  SetProp (P_XP, 200000);
  SetProp (P_BODY, 200);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit einem eiskalten Windhauch", 100, DT_COLD}) );
  SetProp (P_RESISTANCE, ({ PHYSICAL_DAMAGE_TYPES }) );
  SetProp (P_VULNERABILITY, ({ DT_MAGIC, DT_FIRE }) );
  SetProp (P_NOCORPSE, 1);
  SetProp(P_SPELLRATE,40);
  SetProp(P_LOG_INFO, LOGFILE);
  AddSpell(4,100,
	"Der Geist schiesst einen kleinen Blitz auf sich ab.\n",
	"Der Geist schiesst einen kleinen Blitz auf @WEN ab.\n",
        DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3,150,
	"Der Geist entzieht dir mit einem Schlag deine gesamte Koerperwaerme.\n",
	"Die Haut von @WEN ueberzieht sich ploetzlich mit Reif.\n",
        DT_COLD, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,170,
	"Der Geist beschwoert Todesnebel auf dich herab.\n",
	"Der Geist beschwoert Todesnebel @WEN herab.\n",
        DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));



  SetAttackChats(10, ({
	"Der Geist jault:\"BUUHHHUAAA!!!\"\n",
	"Der Geist flackert kurz.\n"
	    			 }) );


  SetChats(5, ({
	"Der Geist jammert vor sich hin.\n",
	"Der Geist wandert durch die Wand und kommt durch eine andere wieder.\n"
			   }) );

  SetProp (P_DIE_MSG," loest sich auf.\n");

  SetProp (P_DEFAULT_INFO,
	"jammert etwas unverstaendliches von \"Frieden finden\".\n");

  AddInfo ("angrox",
	"sagt:\"Angrox ist mein Schoepfer!\"\n");

  AddInfo ("frieden",
	"jammert:\"Ach koennte ihn doch nur finden ...\"\n");

  AddInfo (({"helfen", "hilfe"}),
         "Ach - mir kann niemand mehr helfen. Aber jemand "
         "anderes braucht Hilfe... suche den Weisen der Weisen und "
         "hilf ihm... buahh....", "jammert: ");

  AddInfo ("weiser", BS(
         "heult:\"Suche ihn .. finde ihn ... hilf ihm \"\n"));

//  SetProp( P_REJECT, ({ REJECT_DROP, 
//	"jammert:\"Ich kann nichts Materielles mehr nehmen!\"\n" }) );


 }
