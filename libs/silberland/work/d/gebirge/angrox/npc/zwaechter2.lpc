inherit "std/mnpc";
inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <inpc.h>
#include <new_skills.h>
#include "../files.h"

#define ZMASTER "d/gebirge/angrox/zwergmaster"

create()
{
  object cash;
  object ob;
  
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"Zwerg","zwergenwaechter","zwerg","waechter"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_NAME, "Zwergenwaechter");
  SetProp (P_SHORT, "Ein Zwergenwaechter");

  SetProp (P_LONG,
      "Der Zwergenwaechter ist eine kleine, aber sehr staemmige und erfahren "
     +"wirkende Gestalt. Er ist gut geruestet und gewappnet. Sein Vollbart "
     +"ist sehr stattlich. Er sorgt hier fuer Ruhe und Ordnung und es ist "
     +"sicher besser fuer dich, dich auch daran zu halten.\n");

    
  create_default_npc(19);
  SetProp (P_ALIGN, 100);
//  SetProp (P_BODY, 100);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit gestaehlten Haenden", 100, DT_BLUDGEON}) );
  SetProp (P_SIZE, 134);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_WATER: 0.3, DT_MAGIC: 0.2, DT_FIRE: -0.5, DT_POISON: -0.5]) );

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, (random(200)+100));
  cash->move(ME);
  CLONEME(OBJ("kettenhemd"));
  CLONEME("/p/armour/boots/lederstiefel");
  if( !random(3)) CLONEME("/d/gebirge/dusty/zwerge/armour/kettenzeug");
  command ("trage alles");
  CLONEME(OBJ("zwergenaxt"));
  command ("zuecke zwergenaxt");
  CLONEME(OBJ("schluessel_r20"));


  SetProp(P_SPELLRATE,25);

  AddSpell(9,300,
	"Der Zwergenwaechter trifft dich unglaublich hart.\n",
	"Der Zwergenwaechter trifft @WEN unglaublich hart.\n",
        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,400,
	"Der Zwergenwaechter zerbroeselt dich in kleine Stueckchen.\n",
	"Der Zwergenwaechter zerbroeselt @WEN in kleine Stueckchen.\n",
        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(40, ({
	"Der Zwergenwaechter bruellt Dich an: \"Du wirst sterben, hoerst du? STERBEN!!!\"\n",
	"Der Zwergenwaechter bruellt: \"ALARM!! Ein Eindringling!!\"\n",
	"Der Zwergenwaechter spuckt Dir ins Gesicht.\n"
					 }) );


  SetChats(5, ({
	"Der Zwergenwaechter beobachtet dich genau.\n",
	"Der Zwergenwaechter sagt: \"He, du! Lungere hier nicht herum!\"\n",
	"Der Zwergenwaechter vertreibt einen Stoerenfried.\n",
	"Der Zwergenwaechter nickt kurz ein, ist aber gleich wieder wach.\n"
			   }) );

  SetProp (P_DIE_MSG,
	" bricht mit einem Schrei in sich zusammen.\n");

  SetProp (P_DEFAULT_INFO,
	"scheint dich nicht zu beachten.\n");

  AddInfo ("angrox",
	"sagt:\"Angrox ist mein Schoepfer!\"\n");

  AddInfo ("name", BS(
	"sagt:\"Mein Name tut hier nichts zur Sache.\"\n"));

  AddInfo ( ({"aufgabe", "beruf" }), BS(
	"sagt:\"Ich beschuetze meine Heimat mit all meiner Kraft.\"\n"));

  AddInfo ( ({"heimat", "felonia" }),
	"sagt:\"Meine Heimat ist Felonia.\"\n");

  AddInfo ("stadt", BS(
          "sagt:\"Unsere Stadt liegt weiter im Westen und tiefer im Berg.\"\n"));

  AddInfo("berg", BS(
          "Hier liegt unsere Heimat.\n"));

  AddInfo ( ({"elf", "elfen" }), BS(
	"grummelt:\"Diese Baumhangler sollen sich bloss von "
       +"hier fernhalten...\"\n"));

  AddInfo ( ({"zwerg", "zwerge"}),BS(
        "sagt stolz:\"Wir sind die Krone der Schoepfung ... unbeugsam "
   +    "und stark, stets bereit unsere Heimat gegen anstuermende Horden "
   +    "zu verteidigen! Wir helfen aber auch den anderen Rassen, damit "
        "sie auch ueberleben...\"\n")
          );

  AddInfo ( ({"hobbit", "hobbits"}),BS(
        "grummelt:\"Wen? Diese kleinen Menschen ...\"\n"));

  
  AddInfo ( ({ "mensch", "menschen" }),BS(
        "grummelt:\"Ach, diese plumpen Grosslinge ...\"\n"));

  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
	"Der Zwergenwaechter faehrt dich an:\"Ich bin unbestechlich!!!\"\n" }) );


  
  // Er rennt in allen Raeumen beginnend mit "/d/ebene/Midas/room/room" rum.
  // also zum Beispiel NICHT am Wachweg (".../wachweg*.lpc")
  SetProp (P_MNPC_AREA, ROOM("bergwerk"));

  // Bevor er sich das erste Mal bewegt, wartet er 30 heartbeats,
  // bei jedem weiteren Mal 60 + random (120)
  SetProp (P_MNPC_WAIT, ({ 30, 60, 120 }));

  // sollte sich der arme Kerl mal verirren, wird er in einen
  // bestimmten Default Room teleportiert (so dieser geladen ist...)
  SetProp (P_MNPC_DEFAULTROOM, ROOM("bergwerk_r6"));

  // Schliesslich werden noch einige Eigenschaften gesetzt: Er soll sich
  // fortbewegen (MOV_MOVES), das allerdings nur im Freien (MOV_OUTDOORS)
  // die einzelnen MOV_* Konstanten einfach aufaddieren, siehe /sys/mnpc.h
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  ///// MOVING NPC PROPERTIES END ------------------------------------------

  
  add_select_commands();


  ZMASTER->add_zwerg();
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    ZMASTER->ruf_um_hilfe(enemy);
    return ::Defend(dam, dam_type, spell, enemy);
  }



Attack(object enemy)
{
  int i;
  object ob; string raum;
  mapping exits; string *ausgaenge;
  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for (i = sizeof(ausgaenge)-1; i>=0; i--)
  {
  for (ob=first_inventory(exits[ausgaenge[i]]);ob;ob=next_inventory(ob))
      if (living(ob) && !query_once_interactive(ob) &&
        ob->QueryProp(P_RACE)=="WZwerg")
      {
        raum = environment(this_player());
        ob->move(raum,M_TPORT,
        "zueckt eine Axt und stuerzt mit einem Kampfschrei davon",
        "stuerzt mit einem Kampfschrei herein");
        ob->Kill(enemy);
      return ::Attack(enemy);
      }
  }

  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->QueryProp(P_RACE)=="WZwerg")
          ob->Kill(enemy);
  return ::Attack(enemy);

}

remove(int arg)
  {
    ZMASTER->remove_zwerg(this_object());
    ::remove(arg);
  }


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("trage_beste_ruestungen");
  command_me("trage alles");
}

