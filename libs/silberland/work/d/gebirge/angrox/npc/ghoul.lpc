inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include <new_skills.h>
#include "../files.h"

#define UMASTER "/d/gebirge/angrox/untotmaster"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Ghoul");
  SetProp(P_LONG, bs(
    "Waeh... ein schleimiges Wesen mit uebelriechenden Gestank. Du siehst weg.\n"));
  SetProp(P_NAME,"Ghoul");
  AddId("ghoul");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Untot");
  create_default_npc(15);
  SetProp(P_AGGRESSIVE, ([P_GUILD: (["nekromanten":0.0, 0:1])]) );
  SetProp(P_BODY, 200);
  SetProp(P_HANDS, ({" mit schleimigen Krallen", 130, DT_RIP}));
  SetProp(P_ALIGN, -650);
  SetProp(P_SIZE, 150);
  //  SetProp(P_XP, 100*5000);
  SetProp(P_RESISTANCE, ({DT_COLD, DT_POISON}));
  SetProp(P_NOCORPSE, 1);
  AddDetail ("flaemmchen", BS(
        "Sie fuehren in den Augen einen wilden Tanz auf. Auesserst "
         +"beunruhigend...\n"));  
 
  SetProp( P_REJECT, ({ REJECT_DROP, "Das Ghoul laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " zerfliesst.\n");
  SetProp( P_KILL_MSG, "ahhhhhh .... futter ... *grunz* ... *mampfmampf*");
  
  SetProp(P_MSGIN, "kommt schlurfenden Schrittes herein");
  SetProp(P_MMSGIN, "verzieht sich");
  SetProp(P_MMSGOUT, "schlurft hinaus");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_SPELLRATE, 1);
  AddClass(CL_UNDEAD);
  AddSpell(15,400,
	" Der Ghoul beisst Dich.\n",
	" Der Ghoul beisst @WEN.\n",
        DT_PIERCE, ([SP_SHOW_DAMAGE:1]));


  SetProp(P_MNPC_AREA, EBENE4("ebene4"));
  SetProp(P_MNPC_WAIT, ({ 10, 40, 40 }));
  SetProp (P_MNPC_DEFAULTROOM, EBENE4("ebene4_x3y2"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  UMASTER->add_untote();

}

void Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    UMASTER->ruf_um_hilfe(enemy);
    ::Defend(dam, dam_type, spell, enemy);
  }

Attack(object enemy)
{
  int i;
  object ob; string raum;
  mapping exits; string *ausgaenge;
  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for (i = sizeof(ausgaenge)-1; i>=0; i--)
  {
  if (!objectp(enemy)) return;
  for (ob=first_inventory(exits[ausgaenge[i]]);ob;ob=next_inventory(ob))
      if (living(ob) && !query_once_interactive(ob) &&
        ob->QueryProp(P_RACE)=="Untot")
      {
        raum = environment(this_player());
        ob->move(raum,M_TPORT,0,
        "schlurft zielstrebig weg",
        "schlurft herein");
        catch(ob->Kill(enemy));
      return ::Attack(enemy);
      }
  }

  if (!objectp(enemy)) return;
  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->QueryProp(P_RACE)=="Untot")
          ob->Kill(enemy);
  return ::Attack(enemy);

}

remove(int arg)
  {
    UMASTER->remove_untote(this_object());
    ::remove(arg);
  }


void die(int poisondeath) {
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(10, TP))     
    item->SetVar(item->GetVar()+1);
  ::die(poisondeath);
}

