inherit "p/std/dragons/dragon";

#include "/gilden/bardengilde/barden_extern.h"
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include <moredef.h>
#include "../files.h"

create()
{ int zufall;
  object ob;
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(4,5,0,15);
  SetProp(P_SHORT, "Qexyypbmizox, der blaue Drache");
  SetProp(P_NAME, "Qexyypbmizox");
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_WATER: 0.3]));
  AddId("qexyypbmizox");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, 
      "Qexyypbmizox, der Blitzschleuderer, ist ein gewaltiger "
      "blauer Drache mit gefaehrlichen Faengen und Zaehnen so gross "
      "wie Schwerter. Um seinen Koerper zucken staendig kleine Blitze. "
      "Er mustert Dich mit seinen handtellergrossen Augen, die Dich "
      "gnadenlos anstarren und bis in den Innerstes zu blicken scheinen. ");
  SetProp(P_SPELLRATE, 30);
  
  //    Beschreibung
 
//    -------------
//    create_default_dragon(a,b,c,d);
//    a...DrachenLevel  Wert:1-5
//    b...DrachenAlter  Wert:1-12
//    c...Alignment     Wert:0/1
//    d...Schuppen      Wert:0-..
//   --------------  
//   
//   zu a,c:
//   
//   Die DrachenLevel sind Alignmentabhaengig (gut/boese) unterteilt in:
//    
//       |   # Gut         |    # Boese
//    *1 | Kupfer Drachen  | Schwarzer Drachen  
//    *2 | Bronze Drachen  | Weisser Drachen
//    *3 | Messing Drachen | Gruener Drachen
//    *4 | Silber Drachen  | Blauer Drachen
//    *5 | Gold Drachen    | Roter Drachen
//  
//     *...Wert a    #...Wert c
//   -------------- 
//   
//   zu b:
//   
//   Weiters gibt es noch 12 Altersabstufungen, und zwar:
//    
//                kundig erfahren weise
//    jung      |   1   |   2    |  3   |
//    erwachsen |   4   |   5    |  6   |
//    alt       |   7   |   8    |  9   |
//    steinalt  |  10   |  11    | 12   | 
//   --------------
//   
//   zu d:
//   
//   Dieser Wert legt fest wieviele Drachenschuppen ein Drache
//   bei sich traegt. (..werden benoetigt um bei Schmieden versch.
//   DrachenRuestungsTeile fertigen zu lassen.)
//  
//   Momentan Beschraenkungen noch nicht festgelegt!
//   (mal schaun...)
//   ----------------
//   
//   Es werden jetzt allerhand Props festgelegt, die auf den Drachen
//   abgestimmt sind. Eigentlich sollte man nur mehr (wenn man will)
//   Die P_LONG umsetzen. 
//   Sollte man Ruestungsteile reinclonen?! Mal ueberlegen...
//   Geld kann man reinclonen wenn man will...
 
 
}


die(int poisondeath)
{
  object ob;
  if (ob = present("\nzechpreller_quest_11",TP)) {
    ob->Mark(poisondeath);
  }

  if(this_player()->QueryProp(P_BARD_GROUP) == BARD_GROUP_KORRIAX && 
      this_player()->QuerySkill("also sprach qexyypbmizox") == 0) {
        LearnBardSpell(this_player(), "also sprach qexyypbmizox", 
        "Im Todesschrei des Drachen hoerst du ein Musikstueck, das dich "
        "die Macht ueber Blitz und Donner gebieten laesst!",
        "spiele 'also sprach qexyypbmizox'");
  }

  write_file(LOG("dragon.kills"),
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Drachen.\n");
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG ("dragon.kills"),
        sprintf( ctime()+": Der Drache hat gerade "+CAP(getuid(player))
          +" umgebracht - %d EP!\n", lostexp));
  ::NotifyPlayerDeath(player, killer, lostexp);
}
