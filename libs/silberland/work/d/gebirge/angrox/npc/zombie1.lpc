inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include <new_skills.h>
#include "../files.h"


#define UMASTER "/d/gebirge/angrox/untotmaster"

create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Zombiezwerg");
  SetProp(P_LONG, bs(
    "Faulige Fleischfetzen haengen ueberall von dem Zombie herunter, wahrlich kein "
   +"schoener Anblick. Nach de Groesse nach zu urteilen war dieser Zombie mal ein "
   +"Zwerg. Er traegt nichts bei sich ausser Fetzen von Kleidung.\n"));
  SetProp(P_NAME,"Zombiezwerg");
  AddId(({"zombie", "zombiezwerg", "zwerg"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Untot");
  create_default_npc(12);
  SetProp(P_AGGRESSIVE, ([P_GUILD: (["nekromanten":0.0, 0:1])]) );
  SetProp(P_BODY, 110);
  SetProp(P_HANDS, ({" mit fauligen Klauen", 110,DT_RIP}));
  SetProp(P_ALIGN, -250);
  SetProp(P_SIZE, 150);
//  SetProp(P_XP, 400000);
  set_living_name("untoter");
  SetProp (P_RESISTANCE, ({ DT_COLD, DT_POISON, DT_TERROR}) );
  SetProp (P_VULNERABILITY, ({ DT_MAGIC, DT_FIRE, DT_LIGHTNING }) );
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Zombie laesst es dumpf fallen.\n" }) );
  SetProp( P_DIE_MSG, " faellt dumpf zu Boden.\n");
  SetProp( P_KILL_MSG, " *grunz* *zombiegrins*");
  SUID;
  CLONEME (HOME("quest/feder.lpc")); 
 
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft hinaus");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_SPELLRATE, 5);
  AddClass(CL_ZOMBIE);
  AddSpell(1,210,
	"Der Zombiezwerg beisst Dich.\n",
	"Der Zombiezwerg beisst @WEN.\n",
        DT_PIERCE, ([SP_SHOW_DAMAGE:1]));


  SetProp(P_MNPC_AREA, EBENE4("ebene4"));
  SetProp(P_MNPC_WAIT, ({ 10, 40, 40 }));
  SetProp (P_MNPC_DEFAULTROOM, EBENE4("ebene4_x3y2"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  UMASTER->add_untote();

}

void Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    UMASTER->ruf_um_hilfe(enemy);
    ::Defend(dam, dam_type, spell, enemy);
  }

Attack(object enemy)
{
  int i;
  object ob; string raum;
  mapping exits; string *ausgaenge;
  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for (i = sizeof(ausgaenge)-1; i>=0; i--)
  {
  if (!objectp(enemy)) return;
  for (ob=first_inventory(exits[ausgaenge[i]]);ob;ob=next_inventory(ob))
      if (living(ob) && !query_once_interactive(ob) &&
        ob->QueryProp(P_RACE)=="Untot")
      {
        raum = environment(this_player());
        ob->move(raum,M_TPORT,0,
        "schlurft zielstrebig weg",
        "schlurft herein");
        ob->Kill(enemy);
      return ::Attack(enemy);
      }
  }

  if (!objectp(enemy)) return;
  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->QueryProp(P_RACE)=="Untot")
          ob->Kill(enemy);
  return ::Attack(enemy);

}

remove(int arg)
  {
    UMASTER->remove_untote(this_object());
    ::remove(arg);
  }

