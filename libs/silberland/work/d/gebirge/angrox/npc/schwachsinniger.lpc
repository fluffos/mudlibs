inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"
#include "../steintafelquest.h"
#define PlayerRace TP->QueryProp(P_RACE)
int stein;

create()
{
   if (!is_clone(this_object())) return;  // (return on BP)
  stein=1;
  ::create();
  AddId ( ({"zwerg","verrueckter"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_NAME, "Zwerg");
  SetProp (P_SHORT, "Ein verrueckter Zwerg");

  SetProp (P_LONG, BS(
         "Der Zwerg ist in voellig nackt und starrt gerade so von Schmutz. "
        +"An einigen Stellen der Haut haben sich grosse Pusteln entwickelt - "
        +"echt ecklig. Du fragst Dich wirklich, wie er hier ohne Nahrung und "
        +"Wasser ueberlebt hat. Er blickt wirr um sich, Speichel tropft aus "
        +"seinen Mund."));

  create_default_npc(20);
  SetProp (P_ALIGN, 800);
  SetProp (P_XP, 100000);
  SetProp(P_SIZE, 136);
  SetProp (P_BODY, 200);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit wahnsinnig kraeftigen Haenden", 400, DT_BLUDGEON}) );

  SetProp(P_LOG_INFO, LOGFILE);
  set_living_name("verrueckter");

  SetProp(P_SPELLRATE,25);

  AddSpell(9,300,
	" Der verrueckte Zwerg treibt Dich zum Wahnsinn.\n",
	" Der verrueckte Zwerg treibt @WEN zum Wahnsinn.\n",
        DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(40, ({
	"Der verrueckte Zwerg spuckt Dich an.\n",
	"Der verrueckte Zwerg kratzt Dich im Gesicht.\n"
						 }) );

  SetChats(8, ({
	BS("Der Zwerg schreit: \"Kleiner Stein ganz gross, ward zum\n -hihihi- Todeslos.\n"),
	BS("Der verrueckte Zwerg brabbelt:\"Der Tod traegt rot ... DER TOD TRAEGT ROT!\"\n"),
	BS("Der Zwerg stammelt: \"Der STEIN, der STEIN ...\"\n")
           }));
  SetProp (P_DIE_MSG,
	" bricht mit einem Schrei in sich zusammen.\n");

  SetProp (P_DEFAULT_INFO,
	"brabbelt unverstaendliches.\n");

  
  AddInfo("stein",
         "Du musst Dich sputen, Du Diener des Guten,\n" 
        +"sonst werden die Boesen mein Raetsel loesen.\n"
        +"Ich kann Dir Weisheit schenken,\ndoch vermagst Du zu denken?\n"
        +"Kleiner Stein ganz gross, ward zum Todeslos...", "brabbelt: ");
      			

  AddDetail("pusteln", BS(
        "Grosse, rote Pusteln. Sieht ansteckend aus.\n"));
 
  AddInfo ("angrox",
	"AHHHHHHHHHHHHHHHHHHH!!!!", "schreit: ");

  AddInfo("osten",
        "verkriecht sich angsterfuellt in einer Ecke.\n");
 
  AddInfo("peraine",
         "Suche die Weisheit des Weisen!", "kichert: ");
  AddInfo(({"rot", "tot"}),
        "Der Tod traegt rot. Der Tod traegt rot. DER TOD "
       +"TRAEGT ROT!!!!!", "stammelt verstoert: ");
 
  AddInfo(({"todeslos", "tod"}),
         "rastet aus und schreit:\"DER TOD - TRAEGT ROT!!!!!\"\n");

 AddInfo("gestalt",
         "kreischt:\"ER IST DER TOD!\"\n");
 AddInfo ( "raetsel",
           "@@raetsel@@" 
          +"Geh, sieh diesen Stein so kalt,\n"
          +"bedenke dann, das Wort ist alt.\n"
          +"Um die verborg'ne Macht zu kennen.\n"
          +"musst laut der Kerze Opfer nennen.\n"
          +"Doch Vorsicht vor der Worte Spiel,\n"
          +"der Tempel Glanz fuehrt nicht zum Ziel.\n"
          +"Der Peraine Fruehlingswort, hilft Dir hier an diesem Ort.\n"
          +"Doch formen muss @@welche_lunge@@\n"
          +"der Goettin Ruf nach Zwergenzunge,\n"
          +"und ist's mit Bedacht zurueckgesprochen,\n"
          +"dann ist die Zaubermacht gebrochen.","spricht klar: ");
 
 SetProp( P_REJECT, ({ REJECT_DROP,
	"Der verrueckte Zwerg sabbert es voll und laesst es schliesslich fallen.\n" }) );

}


reset()
{
 stein=1;
 ::reset();
}



string raetsel()
{
 object ob;
 if (!present(QUESTSTEIN, TP))
  {
   if(stein)
     {
       ob = clone_object(QUEST1("runenstein.lpc"));
       write("Der Zwerg steckt Dir etwas zu.\n");
       ob->move(TP, M_NOCHECK);
       stein=0;
     }
   else
     {
      write(BS("Der Zwerg moechte Dir wohl etwas zustecken, "
              +"scheint aber nichts zu finden, was er Dir "
              +"geben kann. Vielleicht solltest Du spaeter "
              +"nochmal vorbeischauen?\n"));
     }
           
  }
 return "";
}


string welche_lunge()
{
  if (PlayerRace == "Zwerg")
     return "Deine Lunge";
  if (PlayerRace == "Hobbit")
     return "die Hobbitlunge";
  return "die "+PlayerRace+"enlunge";
}




