inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"
#include "/d/dschungel/feyaria/dorf/quest.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();

  AddId ( ({"bergwerksarbeiter","arbeiter", "zwerg"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_NAME, "Bergwerksarbeiter");
  SetProp (P_SHORT, "Ein Bergwerksarbeiter");

  SetProp (P_LONG, "Der Bergwerksarbeiter ist ein rauher Zwerg, der in seinem Leben\n"
				  +"viele Muehen auf sich genommen hat.\n");

  create_default_npc(17);
  SetProp (P_ALIGN, 100);
  SetProp (P_SIZE, 132);  
  SetProp (P_MAX_HP, 400);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit gestaehlten Haenden", 140, DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_WATER: 0.3, DT_MAGIC: 0.2, DT_FIRE: -0.5, DT_POISON: -0.5]) );

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Ausruestung
 // Fackel, Spitzaxt, Schutzgewand oder so was

  CLONEME("/p/weapon/axe/spitzhacke");
  command ("zuecke spitzhacke");
  CLONEME("/obj/fackel");
  CLONEME("/p/armour/cloak/lederschuerze");
  command ("trage schuerze");
  CLONEME(OBJ("nugget"));

  SetProp(P_SPELLRATE,10);

  AddSpell(1,90,
	"Der Bergwerkarbeiter wirft einen Goldnugget nach Dir.\n",
	"Der Bergwerkarbeiter wirft einen Goldnugget nach @WEN.\n",
  DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(30, ({
	"Der Bergwerksarbeiter bettelt um Gnade.\n",
	"Der Bergwerksarbeiter schreit laut um Hilfe.\n"
					 }) );
  SetChats(5, ({
	"Der Bergwerksarbeiter ruft:\"Gold, GOLD!\"\n",
	"Der Bergwerksarbeiter graebt weiter nach Gold.\n",
	"Der Bergwerksarbeiter graebt und graebt und graebt ...\n"
			  }) );

  SetProp (P_DIE_MSG,
	" wird nie wieder nach Gold suchen...\n");

  SetProp (P_DEFAULT_INFO,
	"ist vom Goldrausch besessen und bemerkt dich nicht.\n");

  AddInfo ("angrox",
	"sagt:\"Angrox ist mein Schoepfer!\"\n");

  AddInfo ("name",
	"sagt:\"Mein Name tut hier nichts zur Sache.\"\n");

  AddInfo ( ({"aufgabe", "beruf" }),
	"sagt:\"Gold. Ich grabe nach Gold!\"\n");

  AddInfo ( ({"heimat", "felonia" }),
	"sagt:\"Meine Heimat ist Felonia.\"\n");

  AddInfo ("gold",
	"seufzt:\"Wenn ich nur mehr finden wuerde...\"\n");

  AddInfo( ({"stahl"}),
    "Was fuer einen Stahl meinst Du? Ich kenn da mindestens 20 verschiedene "
    "Sorten.", "erklaert Dir: ");
  AddInfo( ({"zwergenstahl"}), "@@zwergenstahl@@");
  

  // Er rennt in allen Raeumen beginnend mit "/d/ebene/Midas/room/room" rum.
  // also zum Beispiel NICHT am Wachweg (".../wachweg*.lpc")
  SetProp (P_MNPC_AREA, ROOM("bergwerk"));

  // Bevor er sich das erste Mal bewegt, wartet er 30 heartbeats,
  // bei jedem weiteren Mal 60 + random (120)
  SetProp (P_MNPC_WAIT, ({ 30, 60, 120 }));

  // sollte sich der arme Kerl mal verirren, wird er in einen
  // bestimmten Default Room teleportiert (so dieser geladen ist...)
  SetProp (P_MNPC_DEFAULTROOM, ROOM("bergwerk_r6"));

  // Schliesslich werden noch einige Eigenschaften gesetzt: Er soll sich
  // fortbewegen (MOV_MOVES), das allerdings nur im Freien (MOV_OUTDOORS)
  // die einzelnen MOV_* Konstanten einfach aufaddieren, siehe /sys/mnpc.h
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  ///// MOVING NPC PROPERTIES END ------------------------------------------

  
  SetProp( P_REJECT, ({ REJECT_KEEP,
	"Der Bergwerksarbeiter bedankt sich recht freundlich.\n" }) );

  if(!random(5)) {
    CLONEME("/p/std/skills/reading/books/buffs/sk_digging_1");
  } else if(!random(5)) {
    CLONEME("/p/std/skills/reading/books/buffs/sk_prospect_1");
  }

 }

string zwergenstahl()
{
  object quest;
  if( (quest=present(BOGENQUESTID, TP)) && !deep_present(QUEST_STAHL, TP) && 
      !deep_present(QUEST_SPITZE, TP) && !deep_present(QUEST_PFEIL, TP) )
  {
    clone_object(BOGENQUEST_DIR "obj/zwergenstahl")->move(TP, M_NOCHECK);
    quest->quest_teil(BQ_ZWERGENSTAHL);
    tell_object(TP, BS(TO->Name(WER) + " gibt Dir ein Stueck Zwergenstahl."));
    tell_room(ENV(ME), BS(TO->Name(WER) + " gibt " + TP->name(WEM) + " etwas."), ({ TP }));
    return "laechelt.\n";
  }
  return "sagt: Ich habe leider keinen Zwergenstahl.\n";
}

