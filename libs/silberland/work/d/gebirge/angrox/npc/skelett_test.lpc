inherit "/p/std/npc/nekro_npc_new";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include <new_skills.h>
#include "../files.h"

#define UMASTER "/d/gebirge/angrox/untotmaster"

create()
{
  object ob;
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, bs(
    "Ein voellig fleischloses Skelett. Es traegt ein roestiges Kettenhemd. "
    "In den dunklen Augenhohlen dieses Untoten flackern zwei blutrote Flaemmchen.\n"));
  SetProp(P_NAME,"Skelett");
  AddId("skelett", "angroxtestskel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_RACE, "Untot");
  create_default_npc(15);
  SetProp(P_AGGRESSIVE, ([P_GUILD: (["nekromanten":0.0, 0:1])]) );
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit Knochenkrallen", 130, DT_RIP}));
  SetProp(P_ALIGN, -550);
  SetProp(P_SIZE, 150);
  SetProp(P_XP, 0);
  set_living_name("skelett");
  AddClass(CL_SKELETON);
  SetProp(P_RESISTANCE_STRENGTHS, ([
      DT_COLD:-0.5, DT_POISON:-0.5, DT_RIP:-0.5, DT_FIRE:-0.5, DT_HOLY:0.5]));

  SetProp(P_NOCORPSE, 1);
  AddDetail ("flaemmchen", BS(
          "Sie fuehren in den Augen einen wilden Tanz auf. Auesserst "
         +"beunruhigend...\n"));  
 SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);
  CLONEME(OBJ("kettenhemd_rost"));
  command ("trage kettenhemd");
  if(!random(2))
    CLONEME("/p/std/skills/sewing_tanning/obj/stoffreste");
  SetProp( P_REJECT, ({ REJECT_DROP, "Das Skelett laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " klappert zusammen.\n");
  SetProp( P_KILL_MSG, "*stampf* *hack* *nixlebengut*");
  
  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MMSGIN, "klappert herein");
  SetProp(P_MMSGOUT, "klappert hinaus");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_SPELLRATE, 10);
  AddSpell(1,270,
	" Das Skelett rammt seine Knochenfinger in Dich hinein.\n",
	" Das Skelett rammt seine Knochenfinger in @WEN hinein.\n",
        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



  UMASTER->add_untote();

}

void Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    UMASTER->ruf_um_hilfe(enemy);
    ::Defend(dam, dam_type, spell, enemy);
  }


remove(int arg)
  {
    UMASTER->remove_untote(this_object());
    ::remove(arg);
  }


void die(int poisondeath) {
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(10, TP)) 
    item->SetVar(item->GetVar()+1);
  ::die(poisondeath);
}
    
