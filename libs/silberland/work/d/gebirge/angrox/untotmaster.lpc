  object *untote;

  create()
  {
    if (is_clone(this_object())) return 0;
    untote = ({});
  }

  add_untote()
    {
    untote += ({ previous_object() });
    }

  ruf_um_hilfe(object spieler)
    {
    int u;
    object *w;
    w=untote;
    for (u=sizeof(w)-1;u>=0;u--)
      if (catch(w[u]->InsertEnemy(spieler)))
        untote -= ({ w[u] });
    }

  remove_untote()
    {
    untote -= ({ previous_object() });
    }
    

