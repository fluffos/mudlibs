inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"dose", "puderdose"}));
  SetProp (P_SHORT, "Wuschels Puderdose");
  SetProp (P_LONG, bs(
           "Das ist eine rosarote Puderdose. Auf dem Deckel steht in grossen "
          +"Buchstaben \"Wuschel\". Offenbar gehoert ihr diese Dose. Das Puder "
          +"in der Dose ist ganz fein und weich, so richtig fuer suesse, kleine "
          +"Babys. Da sich hier alle ohnehin wie kleine Kinder auffuehren, ist "
          +"das Puder sicherlich recht nuetzlich, damit sich die kleinen "
          +"Rabauker nichts wundreiben.\n"));
  SetProp (P_NAME, "Puderdose");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 0);
  SetProp (P_MATERIAL, MAT_MISC);
  SetProp (P_INFO, BS("Diese Puderdose wurde exklusiv fuer Wuschel angefertigt. Mit dem "
                    +"Kommando \"pudere <name> ein\" kann man das Gesicht von jemanden "
                    +"einpudern. Dieses Exemplar sollte fest in den Haenden von Wuschel sein. "
                    +"Sollte es jedoch einmal wo anderes landen, so wird der Finder "
                    +"gebeten, es Wuschel zurueckzubringen.\n"));
  AddCmd("pudere", "einpudern");
}


einpudern(string str)
{
 string nam;
 object ob, pud_ob;
 notify_fail ("Wen willst du einpudern?\n");
 if (!str) return 0;
 if (sscanf(str, "%s ein", nam))
  {
   if (!ob=find_player(nam))
    return notify_fail (bs("Ein Spieler namens "+CAP(nam)+
      " existiert nicht oder ist gerade nicht im Spiel!")), 0;
  if (ob==TP)
    return notify_fail ("Du willst Dich nicht selbst einpudern!\n"), 0;
  notify_fail (bs("Du musst schon im selben Raum wie "+CAP(nam)+" stehen, "+
    "um "+ob->QueryPronoun(WEM)+" einzupudern."));
  if (ENV(TP)!=ENV(ob)) return 0;
  write (bs("Du puderst "+ob->name(WEM)+" das Gesicht ein. Du quietscht dabei vergnuegt. "));
  tell_object (ob,
    bs(CAP(getuid(TP))+" pudert Dir Dein Gesicht ein und quietscht dabei vergnuegt. "+
    "Hihi... das kitzelt in der Nase!!!"));
   tell_room (ENV(TP),
    bs(CAP(getuid(TP))+" pudert "+ob->name(WEM)+" das Gesicht ein.\n"), ({TP,ob}));


  pud_ob=CLONEOB(HOME("misc/puder.lpc"));
  pud_ob->move (ob, M_NOCHECK);
  return 1;
  
  }
 return 0;
}




