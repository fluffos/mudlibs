inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"



void create() 
{
  if (!is_clone(TO) )  return;
       
  ::create();

  SetProp(P_SHORT, "Ein Sechseck");
  SetProp(P_LONG, BS(  
    "Das Sechseck ist perfekt geformt. Es ist vollkommen "
   +"glatt und weist keinerlei Besonderheit auf.\n"));
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Sechseck");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "sechseck", SECHSECK }) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 700);
  SetProp(P_NOBUY, 1);
}

void init()
{
  ::init();
   switch (QueryProp(P_SECHSECK_STEIN))
  {
    case 1: 
            AddId("rubinsechseck"); 
            SetProp(P_MATERIAL, MAT_RUBY);
            break;
    case 2: 
            AddId("smaragdsechseck");
            SetProp(P_MATERIAL, MAT_EMERALD);
            break;
    case 3:
            AddId("saphirsechseck");
            SetProp(P_MATERIAL, MAT_SAPPHIRE);
            break;
    case 4:  
            AddId("diamantsechseck");              
            SetProp(P_MATERIAL, MAT_DIAMOND);
            break;
    default: 
            AddId("steinsechseck");            
            SetProp(P_MATERIAL, MAT_STONE);
            break;
  }
}

string short()
{
  string s;
  switch (QueryProp(P_SECHSECK_STEIN))
  {
    case 1: s="Rubin";
            break;
    case 2: s="Smaragd";
            break;
    case 3: s="Saphir";
            break;
    case 4: s="Diamant"; 
            break;
    default: s="Stein"; 
            break;
  }
  return "Eine Sechseck aus "+s+".\n";
}

string long()
{
  string s;
  switch (QueryProp(P_SECHSECK_STEIN))
  {
    case 1: s="Rubin"; break;
    case 2: s="Smaragd"; break;
    case 3: s="Saphir"; break;
    case 4: s="Diamant"; break;
    default: s="Stein"; break;
  }
  return BS("Das Sechseck aus "+s+" ist perfekt geformt. "
           +"Es ist vollkommen glatt und weist keinerlei "
           +"Besonderheit auf.\n");
}

int _set_sechseckstein(int x)
{
  string *s;
  switch (x)
  {
    case 1: s=({"rubinrote"}); 
            
            break;
    case 2: s=({"smaragdgruene"}); 
           
            break;
    case 3: s=({"saphirblaue"});
           
            break;
    case 4: s=({"diamantklare"});
            
            break;
    default: s=({"steingrau"});
           
            break;
  }
  
  SetProp(P_ADJECTIVES, s);
  return Set(P_SECHSECK_STEIN, x);
}
