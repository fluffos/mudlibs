/*
// /d/gebirge/angrox/4elem/obj/weapon/blitzschwert.c
// 28-02-97  Angrox@SilberLand 
// Zweihaender +20 vs Golems 
// Update 

*/

#include "../../4elem.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../../4elem.h"
create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein steinerner Zweihaender");
  SetProp(P_LONG, BS( 
    "Dieser Zweihaender ist eine riesige Waffe, geschaffen aus "
   +"einem seltsamen steinernen Material. Trotz seiner Groesse "
   +"ist diese Waffe erstaunlich leicht.") );
  SetProp(P_INFO, "Der Zweihaender ist erstaunlich leicht. Er "
                +"besitzt die Eigenschaft, aeusserst effektiv "
                +"gegen Golems zu sein.\n");
   SetProp(P_NAME_ADJ, "steinern"); 
  SetProp(P_NAME, "Zweihaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"zweihaender", "steinzweihaender"}) );
  SetProp(P_MAGIC,1); 
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 175);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STONE:50, MAT_MISC_MAGIC:50]));
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 16, A_STR:16]));
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

}

int WieldFunc(object waffe)
{
  return 1;
}

int UnwieldFunc(object waffe)
{
  return 1;
}

int HitFunc( object enemy )
{
  if( enemy->id("golem"))
    return 60; // WC-Steigerung um 60
  return 0;
}
