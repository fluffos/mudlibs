// Gargylkralle fuer den Gargyl der Steinkathedrale



#include "../../4elem.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Gargylenkralle");
  SetProp(P_LONG, BS( 
    "Die Kralle eines Gargylen ist eine gefaehrliche "
   +"Waffe. Sie ist sehr scharf und nahezu unzerbrechlich.") );
  SetProp(P_NAME, "Gargylenkralle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kralle", "gargylenkralle"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC,130);
  SetProp(P_DAM_TYPE, DT_RIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
 // SetProp(P_HIT_FUNC, TO );

}

int WieldFunc(object waffe)
{
  return 1;
}

int UnwieldFunc(object waffe)
{
  return 1;
}
