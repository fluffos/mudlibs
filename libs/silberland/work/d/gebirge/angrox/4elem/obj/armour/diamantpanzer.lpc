#include "../../4elem.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Diamantpanzer");
  SetProp(P_LONG, BS( 
    "Der Diamantpanzer ist aus haertestem Diamant gefertigt und "
   +"wird Dir einen vorzueglichen Schutz bieten. Er ist von einem "
   +"blauen Schimmer umgeben."));
  AddDetail("schimmer", 
    "Der Schimmer laesst den Diamantpanzer magisch erstrahlen.");
  SetProp(P_INFO, BS("Der Diamantpanzer schuetzt Dich vor einigen "
    "magischen Schaden.\n"));
  SetProp(P_NAME, "Diamantpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "diamantpanzer"}) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC,30);
  SetProp (P_MAGIC, 1);
  SetProp(P_MATERIAL, MAT_DIAMOND);
  SetProp(P_WEIGHT, 3000);  
  SetProp(P_VALUE, 6500+random(501));
  SetProp(P_NOBUY, 1); 
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR: 20, P_LEVEL:35,
                                 SM_RACE: (["Golem": ([P_LEVEL:1]) ]),
                                 SR_EXCLUDE_RACE:"Elf", 
                                 SR_EXCLUDE_RACE:"Dunkelelf"]));

  SetProp(P_DEFEND_FUNC, ME);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object traeger1;
  traeger1=this_object()->QueryProp(P_WORN);  
   if ((member(dam_type, DT_FIRE) != -1) || 
        (member(dam_type, DT_LIGHTNING) != -1) || 
        (member(dam_type, DT_EXPLOSION) != -1) ||
        (member(dam_type, DT_SOUND) != -1) || 
        (member(dam_type, DT_LIGHT) != -1) ||
        (member(dam_type, DT_ELECTRIC) != -1) || 
        (member(dam_type, DT_MAGIC) != -1)) 
    {
      tell_object (traeger1, BS("Um Deinen Diamantpanzer zucken "
            +"knisternd ein paar Blitze.\n"));
      tell_room(environment(traeger1), BS(sprintf(
              "Um die Ruestung von %s zucken ein paar Blitze.\n",  
           traeger1->QueryProp(P_NAME))),({traeger1}));
      return 12;
    }
  return 0; 
}






