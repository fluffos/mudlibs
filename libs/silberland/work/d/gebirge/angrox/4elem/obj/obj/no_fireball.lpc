// No_fireball ... verhindert Rein-Feuerball-Raus
// 

#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
 
  SetProp(P_GENDER, NEUTER);
  AddId("no_fireball");
  SetProp(P_NAME, "Irgendwas");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd("feuerball", "no");
  call_out("weg", 8);
}

no()
{
 tell_object(TP, BS("Soordhin wehrt den Feuerball ab."));
 tell_room(ENV(TP), BS("Soordhin wehrt den Feuerball von " 
	 +TP->QueryProp(P_NAME)+" ab."), ({TP}));
  TP->restore_spell_points(-20);
 return 1;
}

weg()
{
 ME->remove();
}
