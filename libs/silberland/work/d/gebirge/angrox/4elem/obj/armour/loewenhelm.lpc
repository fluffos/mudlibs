//
// der Loewenhelm
//




inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../../4elem.h"

object traeger;
create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der Loewenhelm");
  SetProp(P_LONG, BS( 
   "Der Loewenhelm ist ein mit einem stilisierten Loewen verzierter "
  +"Helm. Er ist aus einem orangefarbenen Metall gefertigt. Von "
  +"der Groesse her koennte er Dir sehr gut passen.")); 
  
  AddDetail("metall", 
   "Du hast keine Ahnung was das fuer ein Metall ist.");
  AddDetail("loewe", 
   "Der Loewe ziert die Vorderseite des Helmes.");
  SetProp(P_INFO, BS("Der Loewenhelm besitzt die Eigenschaft "
   "der zufaelligen Spruchabwehr gewisser Schadenstypen.\n") );
  SetProp(P_NAME, "Loewenhelm");
  SetProp(P_MAGIC, 1);
  SetProp(P_GENDER, MALE);
  AddId(({"helm", "loewenhelm"}));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC,12);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:35, MAT_MISC_MAGIC:50, MAT_GOLD:15]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 4600+random(1111));
  SetProp(P_NOBUY, 0);
  SetProp(P_WEAR_RESTRICTIONS,([P_LEVEL:50, A_INT:24, A_DEX:20,
                                SM_RACE: (["Golem": ([P_LEVEL:1]) ]),
                                ]));
  
  SetProp(P_DEFEND_FUNC, ME);  
}

#define DEFEND_DAM_TYPES ({DT_AIR, DT_LIGHTNING, DT_EXPLOSION, DT_SOUND, DT_LIGHT, DT_ELECTRIC})
#define COST 5

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  traeger = QueryProp(P_WORN);  
  if (spell && sizeof(dam_type & DEFEND_DAM_TYPES))
  {
    if (!random(8))
    {  
      tell_object (traeger, 
          "Dein Loewenhelm wehrt den Zauber ab.\n");
      tell_room(environment(traeger), BS(
              sprintf("Der Loewenhelm von %s wehrt den Zauber ab.\n", 
            traeger->name(WEM))),({traeger}));
      traeger->AddSp(-1 - random(COST));
      return 9999;
    }
  }
  return 0; 
}




