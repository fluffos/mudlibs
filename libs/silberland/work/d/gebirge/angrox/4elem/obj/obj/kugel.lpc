// /d/gebirge/angrox/4elem/obj/obj/kugel.c
// 
// Angrox Zauberwerkstatt
// 
// Kugel fuer Turm, Obergeschoss 1
// 


#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine steinerne Kugel");
  SetProp(P_LONG, BS( 
    "Diese Kugel besteht aus einem weissen Stein, der sich warm "
   +"anfuehlt und ganz schwach glimmt. Trotz ihrer Groesse ist "
   +"sie erstaunlich leicht.") );
  SetProp(P_INFO, "");
  SetProp(P_NAME_ADJ, "steinern");
  SetProp(P_NAME, "Kugel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kugel", "steinkugel", "\nsteinkugel"}));

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

}
