#include <properties.h>
#include <combat.h>
#include <attributes.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
inherit "std/armour";
 
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"guertel", "staerkeguertel", 
          "guertel der staerke", "lederguertel"}));
  SetProp(P_SHORT, "Ein Lederguertel");
  SetProp(P_LONG,
    "Dieser Guertel ist ein ganz normaler, fester Lederguertel "
   "mit einer silbernen Schnalle.");
  SetProp(P_NAME, "Guertel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_LEATHER:95, MAT_SILVER:5])); 
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 5000+random(500));
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:50,
                                 SM_RACE: (["Golem": ([P_LEVEL:1]) ]),
                                 ]));
  SetProp(P_QUALITY_DECAY, 300 );
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO,
    "Dieser Guertel hebt Deine Staerke an. Er wird auch \""
   "Guertel der Staerke\" genannt.\n");
  SetProp (P_M_ATTR_MOD, ([ A_STR:2, A_CON:1 ]) );
}


