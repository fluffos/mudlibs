// 
// Kubus fuer Turm, Obergeschoss 1
// 
// 29-05-1997


#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein steinerner Kubus");
  SetProp(P_LONG, BS( 
    "Dieser Kubus besteht aus einem weissen Stein, der sich warm "
   +"anfuehlt und ganz schwach glimmt. Trotz seiner Groesse ist "
   +"er erstaunlich leicht.") );
  SetProp(P_INFO, "");
  SetProp(P_NAME_ADJ, "steinern");
  SetProp(P_NAME, "Kubus");
  SetProp(P_GENDER, MALE);
  AddId(({"kubus", "steinkubus", "\nsteinkubus"}));

  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

}
