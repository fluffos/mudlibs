#include "../../4elem.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein steinerner Helm");
  SetProp(P_LONG, BS( 
   "Der Helm ist ziemlich schwer, und doch scheint er, aufgrund "
  +"seiner Schwere, einiges an Schutz zu bieten.\n")); 
  
  SetProp(P_INFO, BS("Es gibt nichts besonders an diesem Helm.\n") );
  SetProp(P_NAME, "Steinhelm");

  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "steinhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC,7);
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);

}

