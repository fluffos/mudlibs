#include "../../4elem.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Steinkeule");
  SetProp(P_LONG, BS( 
    "Diese riesige Steinkeule ist eine fuerchterliche Waffe. "
   +"Sie ist ueber und ueber mit spitzen Dornen versehen, "
   +"um beim Gegner den groesstmoeglichen Schaden anzurichten.\n") );
 
  AddDetail("dornen", "Die Dornen sind spitz und sehen sehr "
   +"gefaehrlich aus.");     
 
  SetProp(P_INFO, "Voellig normal. Nichts auffaelliges an dieser "
       +"Keule.");
  SetProp(P_NAME, "Steinkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "steinkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 180);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 0);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:19]));
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

}

int WieldFunc(object waffe)
{
    return 1;
}

int UnwieldFunc(object waffe)
{
  return 1;
}

int HitFunc( object enemy )
{
  
  return 2*(16-((TP->QueryProp(P_ATTRIBUTES))["str"]));
  
}


