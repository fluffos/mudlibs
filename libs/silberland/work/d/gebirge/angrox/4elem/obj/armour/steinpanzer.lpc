#include "../../4elem.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein steinerner Plattenpanzer");
  SetProp(P_LONG, BS( 
    "Der Plattenpanzer ist aus steinernen Platten zusammengesetzt. "
   +"Er sieht sehr rubust aus und bietet Dir sicherlich einen "
   +"hervorragenden Schutz.\n"));

  AddDetail("platten", "Die Platten, aus denen sich der Panzer "
   +"zusammensetzt, sind sechseckig. Sie sind sehr dick und bieten "
   +"einen hervorragenden Schutz.");  
   
  SetProp(P_INFO, BS("Es gibt nichts besonders an diesem Plattenpanzer.\n") );
   SetProp(P_NAME_ADJ, "steinern");
  SetProp(P_NAME, "Plattenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "plattenpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC,35);
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:23]));
}

