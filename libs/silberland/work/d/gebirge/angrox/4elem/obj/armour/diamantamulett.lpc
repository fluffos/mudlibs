#include "../../4elem.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Diamantamulett");
  SetProp(P_LONG,
      "Das Diamantamulett ist relativ schlicht gehalten: Eine einfache Kette "
      "haelt eine flache und unverzierte Scheibe aus Diamant. Keine Gravierungen noch "
      "sonstige Symbole sind zu finden.");
  SetProp(P_INFO, "Das Diamantamulett kann Zauber reflektieren.");
  SetProp(P_NAME, "Diamantamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "diamantamulett"}) );
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC,2);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, MAT_DIAMOND);
  SetProp(P_WEIGHT, 500);  
  SetProp(P_VALUE, 6000+random(501));
  SetProp(P_NOBUY, 1); 
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT: 20, P_LEVEL:33,
                                 SM_RACE: (["Golem": ([P_LEVEL:1]) ]),
                                 ])); 

  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_WEAR_FUNC, this_object());
}

int DefendFunc (mixed dam_type, mixed spell, object enemy) {
  object pl;
  int reflect;
  pl=QueryProp(P_WORN); 
  if(mappingp(spell) && member(spell,SI_SKILLDAMAGE) && (!random(10) || 
        !interactive(pl))) 
    {
    tell_object(pl, 
        "Das Diamantamulett wirft einen Teil der Attacke zurueck.\n");
    pl->AddSp(-random(5));
    reflect = spell[SI_SKILLDAMAGE] / 4;
    if(ENV(pl))
      tell_room(ENV(pl), BS(sprintf("Das Diamantamulett von %s wirft "
         "einen Teil der Attacke zurueck.\n", pl->name(WEM))), ({pl}));
    enemy->Defend(reflect, dam_type, ([SP_SHOW_DAMAGE: 1, 
         SP_NAME:"diamantamulett"]), pl);
    if(!random(3093)) { // Gruss an Anatol :P
      call_out("remove", 0);
      tell_object(pl, "Das Diamantamulett loest sich auf.\n");
    }
    return reflect / 5;
  } 
  return 0;
}


int WearFunc(object ruest,int silent) {
  if(TP->QueryProp(P_GUILD) != "druidenzirkel") {
    write(BS("Dieses Amulett koennen nur Druiden tragen!"));
    return 0;
  }
  return 1;
}
