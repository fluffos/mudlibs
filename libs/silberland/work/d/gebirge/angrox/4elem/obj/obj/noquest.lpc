// 
// Damit kann die quest 10 resets lang nicht 
// gespielt werden.
//  
*/ 

#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int anz_resets=0;

create()
{
  if (!is_clone(TO) )  return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_GENDER, MALE);
  AddId(NO_QUEST);
  SetProp(P_NAME, "Irgendetwas");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetPRop(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
}

reset()
{
 anz_resets++;
 ::reset();
 if(anz_resets>20)
   {
    write("Du kannst nun wieder zu Cailleac'h.\n");
    ME->remove();
   }
}

