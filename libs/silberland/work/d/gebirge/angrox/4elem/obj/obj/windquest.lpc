#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
 
  SetProp(P_GENDER, MALE);
  AddId(W_Q_ITEM);
  SetProp(P_NAME, "windquest");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);


}
