inherit "std/thing";

#include <properties.h>
#include <wizlevels.h>
#include "../../4elem.h"

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp (P_IDS, ({"\nlaehmung"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 20);
  AddCmd ("", "no", 1);
} 

int no()
{
  if(IS_LEARNER(this_player()))
     return 0;     
  write (BS("Du kannst Dich im Moment nicht bewegen.\n"));
  return 1;
}





