// 
// Das Brandmal des Buches im Turm des
// endlosen Aufstieges
// 

#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
 
  SetProp(P_GENDER, MALE);
  AddId(({"brandmal", "mal", B_MAL}));
  SetProp(P_NAME, "Brandmal");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);
  AddDetail(({"brandmal", "mal"}), "Es hat die Form einer Spirale.");
  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		 +"\"Luft\". Sie ist auf der Stirn von "+TPN+" einbrannt.");
  AddDetail("stirn", "Auf der Stirn von "+TPN+" ist ein Brandmal!");
}

string extra_look()
{
  if(environment()->QueryProp(P_GENDER)==FEMALE)
     return BS("Sie hat ein gruenliches Brandmal auf der Stirn!\n");
  return BS("Er hat ein gruenliches Brandmal auf der Stirn!\n");  

}
