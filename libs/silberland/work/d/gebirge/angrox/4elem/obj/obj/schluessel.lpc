#include "../../4elem.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein steinerner Schluessel");
  SetProp(P_LONG, BS( 
    "Der Schluessel besteht aus Stein. Wo der wohl reinpassen "
    +"mag.\n") );
  SetProp(P_INFO, "Du erkennst ... der Schluessel stammt aus "
      +"der Steinstadt.");
  SetProp(P_NAME_ADJ, "steinern");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schluessel", "steinschluessel", "\nwindschluessel"}));
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

}
