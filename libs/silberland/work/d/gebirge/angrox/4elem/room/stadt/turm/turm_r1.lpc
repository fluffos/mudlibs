inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Im Steinturm");
  SetProp(P_INT_LONG, "Das Innere des Turmes ist durchaus "
		+"adrett moebiliert, allerdings ist alles aus Stein: "
		+"Den Boden schmueckt ein Teppich, an der Wand stehen "
		+"Regale mit Buechern, ein Tisch und mehrere Sessel "
		+"vervollstaendigen die Einrichtung. Eine Treppe fuehrt "
		+"in oberen Stockwerke. Es ist hier definitiv waermer "
		+"als ausserhalb des Turmes, der allgegenwaertige Wind "
		+"ist hier nur schwach zu spueren.");




  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail(({"raum","turm"}), "Du befindest Dich im Inneren eines Turmes.");

  AddDetail("inneren", "Da befindest Du Dich.");

  AddDetail("decke", "Alles besteht hier aus hartem Fels.");

  AddDetail("boden", "Ein Teppich, der ebenfalls aus Stein, "
		   +"besteht, ziert den Boden.");

  AddDetail("stein", "Der Stein hier ist reinweiss und fuehlt "
		   +"sich warm an.");

  AddDetail("teppich", "Man koennte den Teppich vom Aussehen her "
		   +"sicherlich als weich bezeichnen, jedoch besteht er, "
		   +"so wie alles hier, aus Stein. Der Teppich zeigt als "
		   +"Motiv ein seltsames Symbol.");

  AddDetail("motiv", "Ein seltsames Symbol ist auf dem Teppich zu "
		   +"sehen.");

  AddDetail("symbol", "Das Symbol stellt eine stellt eine Spirale mit "
		   +"eineinhalb Windungen dar, die von ihnen nach aussen "
		   +"groesser werden.");

  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		   +"\"Luft\".");

  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");

  AddDetail(({"wand", "waende"}), "Die Waende sind mit Regalen vollgeraeumt.");

  AddDetail( ({ "regale", "regal" }), "Die Regale bestehen aus Stein und sind mit "
		   +"unzaehligen Buechern vollgeraeumt.");

  AddDetail(({"buecher", "buechern"}), "Es sind unzaehlig viele Buecher "
		   +"in den Regalen. Leider bestehen auch die Buecher aus Stein "
		   +"und es ist Dir unmoeglich, auch nur ein Buch aus den "
		   +"Regalen zu nehmen. Aber immerhin einige Titel auf den "
		   +"Einbaenden kannst du lesen.");

  AddDetail("einbaende", "Ja, die Buecher sind eingebunden. Offenbar "
		   +"waren diese Einbaende mal aus Holz und sind im Laufe der "
		   +"Zeit versteinert.");

  AddDetail("titel", "Du kannst sie lesen.");

  AddReadDetail("titel", "Einige Titel kannst Du entziffern: "
		   +"\"Die Macht der Elemente\", \"Das Grosse "
		   +"Elementarium - Kompendium der elementaren Beschwoerungen\""
		   +", \"Magie im Kampf - Kaempfende Magie\", \"Das ewige "
		   +"Licht - Zauber, die niemals vergehen\", \"Tractatus "
		   +"Septelementaricum\"");

  AddDetail("tisch", "Der Tisch ist gross genug fuer mindestens "
		   +"fuenf Personen. Ansonsten ist nichts Auffaelliges an "
		   +"ihm.");

  AddDetail(({"sessel","polstersessel", "polster"}), 
                 "Die Polstersessel sind ebenfalls aus Stein. "
		   +"Eigentlich schade, denn sie sehen sehr gemuetlich aus.");

  AddDetail("einrichtung", "Die Einrichtung besteht aus mehreren "
		   +"Sessel, einigen Regalen, einem Teppich und einem "
		   +"Tisch.");

  AddDetail("treppe", "Die Treppe fuehrt nach oben.");

  AddDetail("stockwerke", "Du weisst nicht, wieviele Stockwerke "
		   +"der Turm hat.");



  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");


  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist gedaempft "
		   +"zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist leise.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("raus", "nach draussen#"+STADT("stadt_f5"));
  AddExit("oben", "die Treppe nach oben#"+STADT("turm/turm:1"));

}


