inherit "/d/gebirge/angrox/4elem/room/wald/wald.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"\bZwischen den vielen "
    +"Versteinerungen kannst Du im Boden ein Loch erkennen. Es scheint "
    +"tief nach unten zu fuehren.");

  AddDetail( "versteinerungen",
	     "Die sind hier ueberall.");
  AddDetail( "loch",
	     "Das Loch fuehrt gaehnend weit nach unten. Du kannst von hier "
            +"aus keinen Boden erkennen, nur gaehnende Finsternis. Die "
            +"Waende scheinen ziemlich griffig und kantig zu sein, Du "
            +"koenntest vielleicht versuchen, hinunterzuklettern.");
  AddDetail( "finsternis"
	     "Du kannst nur gaehnende Finsternis im Loch erkennen.");
  AddDetail( "waende",
             "Die Waende des Loches scheinen sehr unregelmaessig zu sein. "
            +"Sie bieten bestimmt guten Halt beim Klettern.");

  AddCmd( ({"kletter", "klettere"}), "runter");

  AddExit("suedwesten", WALD("wald_l2"));
 
}

int i;

init()
{
  ::init();
  i=0;
}

runter( str )
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="runter"||str=="nach unten"||str=="in loch")
    {
    write(BS("Du kniest Dich hin und laesst Dich langsam in das Loch "
            +"hinein, wobei Du Dich krampfhaft festklammerst, und beginnst "
            +"zu klettern.\n"));
    say(BS(CAP_TPN+" klettert langsam in das Loch im Boden hinein.\n"));
    clone_object("/d/gebirge/thor/hoehlenquest/obj/ohnmacht")->move(TP, M_NOCHECK);
    call_out("klettern1", 3);
    return 1;
    }
  else
    return 0;
}

klettern1()
{
  write(BS("Und Du kletterst...\n"));
  call_out("klettern2", 3);
}

klettern2()
{
  if(find_call_out("klettern2"))
    remove_call_out("klettern2");
  if(i<3)
    {
    write("und kletterst...\n");
    i++;
    call_out("klettern2", 3);
    }
  else
    call_out("klettern3", 3);
}

klettern3()
{
  write(BS("Du beginnst schon bedenklich zu keuchen. Hat denn dieser bloede "
          +"Schacht ueberhaupt kein Ende?\n"));
  call_out("klettern4", 5);
}

klettern4()
{
  write(BS("Der Schweiss rinnt Dir ueber das Gesicht und Deine Kraefte drohen "
          +"Dich schon beinahe zu verlassen. Du darfst gar nicht daran denken, "
          +"wie tief dieser Schlund unter Dir noch sein mag.\n"));
  call_out("klettern5", 7);
}



klettern5()
{
  write(BS("In dem Moment, wo Du die Felswand schon fast losgelassen "
          +"haettest, fuehlst Du festen Boden unter Deinen Fuessen. "
          +"Erschoepft laesst Du die Felswand los und bleibst erschoepft "
          +"liegen.\n"));
  call_out("bewegen", 5);
}

bewegen()
{
  TP->move("/d/gebirge/thor/hoehlenquest/labyrinth/wind1.lpc", M_GO, "", "ist in "
          +"dem Loch verschwunden", "kommt heruntergeklettert ");
          
}


