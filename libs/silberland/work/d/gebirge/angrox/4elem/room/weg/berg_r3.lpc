inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INT_LONG, "Du gehst auf einem schlecht ausgetretenen "
		   +"Gebirgspfad. Einige Pflanzen, einige davon in "
		   +"eigentuemlicher grauer Farbe, wuchern auf dem Weg. "
		   +"Links und rechts des Pfades befinden sich einige "
		   +"Buesche. Ein eigentuemlicher Wind weht aus Richtung "
		   +"Norden.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE:5]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail("gras", "Das Gras sieht verdorrt aus und weist teilweise eine "
		   +"unnatuerlich graue Farbe auf.");

  AddDetail("buesche", "Neben dem Pfad wachsen ein paar Buesche. Einige "
		   +"Aeste haben eine eigentuemliche graue Farbe "
		   +"angenommen.");

  AddDetail(({"pfad", "weg", "boden"}), "Der Pfad ist wohl schon lange nicht "
		   +"mehr benutzt worden, denn einige Steine und "
		   +"Pflanzen liegen, bzw. wachsen auf ihm. ");
  AddDetail("aeste", "Die Aeste haben eine seltsame graue Farbe und "
                   +" sind steinhart.");

  AddDetail(({"grau", "farbe", "graues"}), "Das ist Stein! Das Gras und "
		   +"ein Teil der Buesche ist ganz deutlich versteinert!");

  AddDetail("wurzeln", "Sie sind so gut wie versteinert.");

  AddDetail("wind", "Der Wind weht von Norden her. Du empfindest diesen "
		   +"Wind als sehr belebend, so als wuerde die Urwuechsigkeit "
		   +"und Kraft der Elemente mitschwingen.");
   AddDetail("steine", 
           "Einige kleine Steine liegen auf dem Pfad, auf dem Du gehst.");
  AddDetail("pflanzen", "Auf dem Gebirgspfad wachsen einige Pflanzen, vor "
                   +"allem Gras und einige kleine Buesche.");
   AddDetail("gras", "Trotz der Hoehe und der Kaelte hier oben sieht das "
                   +"Gras saftig aus.");
  AddDetail("hoehe", 
            "Hier bist Du schon um einiges hoeher, die Luft "
           +"ist auch duenn.");
  AddDetail("luft", 
            "Obwohl sie schon so duenn ist, kannst Du problemlos "
           +"atmen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");
   AddDetail("luft", 
            "Obwohl sie schon so duenn ist, kannst Du problemlos "
           +"atmen.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

    AddDetail("fels", "Der Fels ist hart und grau.");
  AddDetail(({"felsstuecke", "stuecke"}), 
            "Die liegen am Pfad.");
  AddDetail("kaelte", 
            "Naja, es ist schon kalt.");
  AddDetail(({"gebirge", "berg"}),
           "Da befindest Du Dich. Majestaetische Gipfel ragen hoch auf.");
  AddDetail("gipfel", 
            "Sie sind schneebedeckt und majestaetisch schoen.");
  

  AddSound(DEFAULT_SOUND, "Der Wind verursacht ein leises Pfeifen.");

  AddSound("pfeifen", "Obwohl das Pfeifen vom Wind kommt, scheint "
				   +"doch eine eigentuemliche, nicht zu erklaernde "
				   +"Vitalitaet mitzuschwingen.");
  AddSmell(DEFAULT_SMELL, "Hmmm ... frische Gebirgsluft.");
  AddSmell(({"luft", "gebirgsluft"}), "Die Luft ist kalt und duenn.");

  AddExit("norden", WEG("berg_r4"));
  AddExit("sueden", WEG("berg_r2"));

}

