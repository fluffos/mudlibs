inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Eine Kaverne");
  SetProp(P_INT_LONG, "Du befindest Dich am noerdlichen "
		   +"Ende der Kaverne. Von ueberall her scheint ein "
		   +"starker Wind auf Dich einzudringen, so dass Du "
		   +"Dich kaum noch auf den Beinen halten kannst. ");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"waende", "boden"}), "Alles besteht hier aus "
		   +"hartem Fels.");
  AddDetail(({"fels","felsgestein", "gestein"}), "Der Fels ist hart und kalt"); 
  AddDetail(({"kaverne", "felskaverne", "hoehle"}), "Die Kaverne besteht "
		   +"vollkommen aus grauem Felsgestein.");

  AddDetail("decke", "Du blickst zur Decke hinauf und erkennst "
		   +"einen grossen Kristall, der an der Decke zu wachsen "
		   +"scheint.");

  AddDetail("kristall", "Der Kristall reflektiert Dein Licht und "
		   +"produziert dabei viele Farben. Durch die graue "
		   +"Einoede hier drinnen blenden Dich die Farben beinahe "
		   +"und Du fuehlst Dich ein bisschen besser als vorher.");
  AddDetail("licht", "Das, welches Du bei Dir traegst.");
  AddDetail("farben", "Der Kristall bricht das Licht in all seine "
		   +"Farben auf.");
  AddDetail("einoede", "Naja, es ist schon oed hier ... es erinnert "
            +"Dich irgendwie an Mainz.");
  AddDetail("mainz", "Da ist es allerdings noch oeder ... oed zum "
            +"Quadrat. Hmm ... woher kommt Dir das jetzt nur "
            +"so bekannt vor? ;-) Frag am Besten mal Angrox, Woody, "
            +"Thor oder Creative.");
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail("luft", "Die Luft ist hier erfrischend.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
	  +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

   AddItem(NPC("steinspinne"), REFRESH_DESTRUCT);

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("osten", HOEHLE("hoehle_l7"));
  AddExit("sueden", HOEHLE("hoehle_k8"));
  AddExit("westen", HOEHLE("hoehle_j7"));


}

