inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"
#include "../../labyrinth.h"



void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"In den Tiefen der Steinstadt");
  SetProp(P_INT_LONG, "Du bist irgendwo mitten in der Steinstadt. "
		   +"Du blickst Dich um und erkennst neben einigen "
		   +"Steinhaeusern viele Gassen und Wege, die in alle "
		   +"Richtungen fuehren. Einige sind davon mit Felsbrocken "
		   +"verschuettet. Ueber einem Steinhaus, welches groesser "
		   +"als die anderen sind, erkennst Du eine Art Tafel, die "
		   +"mit seltsamen Zeichen versehen ist. Auch hier blaest "
		   +"der seltsame Wind, der so unnaetuerlich erfrischend "
		   +"ist.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"waende", "boden"}), "Alles besteht hier aus hartem Fels.");

  AddDetail("hoehle", "Die Hoehle muss gewaltige Ausmasse haben, denn "
		 +"Du kannst ihre Decke im Schein deiner Lichquelle nicht "
		 +"ausmachen. Alles hier besteht aus Fels.");

  AddDetail("decke", "Du kannst sie nicht sehen.");

  AddDetail("lichtquelle", "Die hast Du bei Dir.");

  AddDetail("schein", "Jaja, genau. Durch den Schein Deiner Lichtquelle "
		 +"ist es hier hell.");

  AddDetail("tiefen", "Du musst schon gut aufpassen, damit Du Dich "
		 +"hier nicht verirrst.");

  AddDetail("ausmasse", "Die Hoehle hat gewaltige Ausmasse.");

  AddDetail("fels", "Der Fels ist voellig grau und kalt.");

  AddDetail("tiefen", "Die Stadt ist ziemlich verwinkelt, da musst Du "
		 +"aufpassen, dass Du Dich nicht verirrst.");

  AddDetail("stadt", "Kein Zweifel, dass hier ist eine riesige Stadt "
		 +"aus Stein. Du siehst etliche Steinhaeuser und eine Menge "
		 +"von kleinen, verwinkelten Gassen, die teilweise durch "
		 +"Felsbrocken blockiert sind.");

  AddDetail("stein", "Unglaublich. Offenbar sind die Haeuser "
		 +"buchstaeblich aus dem Fels geschaffen worden, denn Du siehst "
		 +"keine Bearbeitungsspuren. ");

  AddDetail(({"spuren", "bearbeitungsspuren"}), "Es sind keine zu sehen "
		 +"... Du kannst Dir vorstellen, dass eine maechtige Magie "
		 +"dies alles hier erschaffen hat.");

  AddDetail(({"gassen", "wege"}), "Die Gassen fuehren weiter die "
		 +"Steinstadt. Es scheint alles sehr verwinkelt zu sein.");

  AddDetail(({"brocken", "felsbrocken"}), "Die Felsbrocken machen "
		 +"einige Gassen unpassierbar. Sie sind so gross, dass Du "
		 +"nicht darueber hinweg klettern kannst.");

  AddDetail(({"haeuser", "steinhaeuser"}), "Die Haeuser scheinen direkt "
		 +"aus dem Fels gewachsen zu sein. Leider kannst Du weder "
		 +"Tueren noch Fenster erkennen, so dass Du sie wohl nicht "
		 +"betreten kannst.");

  AddDetail(({"tueren", "fenster"}), "Keine zu sehen. Wie diese Haeuser "
		 +"wohl betreten werden?");

  AddDetail(({"steinhaus", "haus"}), "Das Haus ist um einiges "
		 +"groesser als die anderen. Ueberhalb einer schemenhaft "
		 +"angedeuteten Tuer befindet sich eine Tafel, auf der "
		 +"seltsame Schriftzeichen angebracht.");

  AddDetail("tuer", "Die Tuer ist nur schemenhaft angedeutet. "
		 +"In ihrer Mitte befindet sich eine sechseckige Einbuchtung "
		 +"Es sieht so aus, als waere hier etwas entfernt worden.");

  AddDetail("einbuchtung", "Die Einbuchtung ist sechseckig. Wenn "
		 +"Du etwas hast, was Du da hineinstecken willst, dann "
		 +"kannst Du da mittels \"stecke <gegenstand> in "
		 +"Einbuchtung\".\n");

  AddDetail("tafel", "Die Tafel ist ueberhalb der Tuer befestigt. "
		 +"Auf ihr stehen seltsame Zeichen.");

  AddDetail(({"zeichen", "schriftzeichen"}), "Leider kannst Du sie "
		 +"nicht uebersetzen.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		 +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		 +"mitschwingen. Das Gefuehl dieser Kraft ist hier unten "
		 +"noch um einiges staerker.");

  AddDetail("gefuehl", "Du kannst dieses Gefuehl nicht genau beschreiben, "
		 +"es ist einfach ... anders.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		 +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		 +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		 +"\"Luft\" zugeordnet.");

 
  AddCmd(({"stecke", "steck"}), "reinstecken");
  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft",
      "Du atmest ein paar mal durch und fuehlst Dich gleich besser.");

  AddItem(NPC("steingolem"), REFRESH_DESTRUCT);
}


void init()
{
  mapping richtung_map, gebiet_map;
  int i;

  if(!query_once_interactive(TP)) return ::init();
  richtung_map=RICHTUNG;
  gebiet_map=GEBIET;
  RemoveExit(0);
  for(i=0;i<=random(9);i++)
          AddExit(richtung_map[random(7)+1], gebiet_map[random(20)+1]);
  AddExit("westen", STADT("stadt_h7"));
  ::init();
}

int reinstecken(string str)
{
  object ob;
  string was, wo;

  // parse the command line
  if (!stringp(str)) return 0;
  if (sscanf(str, "%s in %s", was, wo) != 2)
      return 0;

  // look for the item
  if (! ob = present(was, TP))
    return 0;                    // not found - let put_and_get complain

  // check if it is a "six-corner" ;)
  if (!ob->id(SECHSECK))
    return 0;                    // let put_and_get do the work

  if (wo != "einbuchtung")
  {
    write("Da kannst Du nichts hinlegen.\n");
    return 1;
  }

  // no quest-item -> sulk
  if (!present(W_Q_ITEM, TP))
  {
    write("Seltsam, nichts passiert. Dabei warst Du Dir so sicher...\n");
    return 1;
  }

  // Must be the wrong one...
  if ((ob->QueryProp(P_SECHSECK_STEIN)) != 3)
  {
    write(BS("Du legst das Sechseck in die Einbuchtung."
      " Nichts passiert. "
      "Vielleicht war ein anderes Sechseck gemeint."));
    say(TP->Name() + " legt etwas in die Einbuchtung an der Tuer.\n");
    return 1;
  }

  // messages
  write(BS("Du legst das Saphirsechseck in die Einbuchtung ... "
        "es sitzt perfekt! Blitzschnell beginnt es sich aufzuloesen, "
        "setzt eine blaeuliche Wolke frei, die sich auf dich "
        "zubewegt!\n"));
  say(BS(TPN+" legt etwas in die Einbuchtung. Urploetzlich entsteht eine "
        "blaeuliche Wolke, die sich auf "+TP->name(WEN,1)+" zubewegt.\n"));

  // get rid of object
  ob->remove();

  // give TP a ride...
  call_out("teleport", 2, TP);
  return 1;
}

void teleport(object pl)
{
  if (!objectp(pl)) return;     // player has vanished?!

  write("Die Wolke erreicht Dich und huellt Dich ein. Du verlierst "
      "die Orientierung...\n");
  say(BS("Die Wolke huellt "+pl->name(WEN)+
        " ein. Nachdem die Wolke verschwunden ist, ist auch "+
        pl->name(WER,1)+" verschwunden."));
  pl->move(STADT("haus_2"), M_GO|M_SILENT);
}

