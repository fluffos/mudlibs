inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

//int *inhalt=({0,1,1,0});
int *inhalt=({0,0,0,0});
int reset_var=0;
int ertasten;
int sechseck_in_maul;
int *sechseck_vorhanden=({0,0,0,0});
create()
{
  ::create();
  ertasten=0;
  sechseck_in_maul=0;
  SetProp( P_INT_SHORT, "In einer Katakombe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer Katakombe. Der Boden, die Decke "
   +"und die Waende sind vollstaendig mit weissen Steinplatten "
   +"ausgelegt. Am Boden hat sich bereits eine Menge Staub "
   +"angesetzt. An der Wand befindet sich eine Nische. Eine "
   +"riesige Steinstatue, die wohl einen Drachen repraesentieren "
   +"soll steht an der suedlichen Wand. Neben dem Drachen steht "
   +"ein kleiner Sockel. Die Luft hier ist sehr "
   +"abgestanden... und es ist totenstill.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 5]) );

  AddDetail("staub", 
  "Ihhh ... Staub ... hust!!");  
  AddDetail("katakombe", 
    "Du befindest Dich hier in einer Katakombe, ja!");
  AddDetail("raum", 
    "Du stehst mittendrin."); 
  AddDetail(({"waende", "decke"}), 
    "Alles ist hier mit diesen Steinplatten ausgelegt.");
  AddDetail("boden", 
    "Der Boden ist mit weissen Steinplatten ausgelegt. Eine "
   +"dicke Staubschicht liegt darauf.");
  AddDetail(({"platten", "steinplatten"}),
    "Die Steinplatten sind kalt und mit einer Staubschicht "
   +"bedeckt, ansonsten ist nichts besonderes an ihnen zu "
   +"erkennen.");
  AddDetail(({"staubschicht", "schicht"}), 
    "Die Staubschicht weisst darauf hin, dass hier schon lange "
   +"keiner mehr war. Unter der Staubschicht ist eine Vertiefung "
   +"im Boden.");
  AddDetail("wand", 
    "Die Waende sind hier mit diesen weissen Steinplatten "
   +"ausgelegt. Eine Nische befindet sich an einer Wand.");      
  AddSpecialDetail("nische", "nische"); 
  AddDetail(({"steinstatue", "statue", "drache", "steindrachen", "drachen"}), 
    "Die Statue stellt einen riesigen Drachen dar. Sein Maul ist "
   +"weit geoeffnet, seine Augen leuchten in einem feurigen Rot, "
   +"die spitzen Zaehne gut ersichtlich. Seine "
   +"Fluegel sind gespreitzt, der Ruecken mit einem stacheligen "
   +"Hornkamm verziert. Der Drache stuetzt sich vornueber auf seinen "
   +"maechtigen Klauen ab."); 
  AddDetail("ruecken", 
    "Der Ruecken des Drachen ist mit einem Hornkamm besetzt.");
  AddDetail(({"kamm", "hornkamm"}), 
    "Der Hornkamm sieht SEHR gefaehrlich aus...");
  AddDetail("fluegel",
    "Die Fluegel des Drachens sind weit gespreizt, so als wollte er jeden "
   +"Moment abheben."); 
  AddSpecialDetail(({"krallen", "klauen"}), "klauen");
  AddDetail("maul",
    "Das Maul des Drachen ist gewaltig: Unzaehlige spitze Zaehne "
   +"zieren das Maul, das wie bereit zum Zuschnappen in Stein "
   +"erstarrt ist. Nur die Mutigsten wuerden es wagen, in das "
   +"Maul zu greifen, obwohl vom Steindrachen sicherlich keine "
   +"Gefahr ausgeht.");
  AddDetail("zaehne", 
    "Die Zaehne des Drachens sehen gefaehrlich scharf aus.");
  AddDetail(({"mutigste", "mutigsten"}), 
    "Das sind die Leute, die keine Angst haben.");
  AddDetail("angst",
    "Hast Du denn Angst????");
  AddDetail("augen",
    "Seine Augen sind zwei formvollendete Rubine, die in einem "
   +"feurigen Rot erstrahlen.");
  AddDetail(({"rot", "feuer"}), 
    "Das Rot strahlt feurig und klar, so als wuerden die Rubine "
   +"taeglich geputzt werden...");
  AddDetail("rubine", 
    "Die Rubine erstrahlen in rotem Feuer.");
  AddDetail("gefahr", 
    "Von ihm geht ganz sicherlich keine Gefahr aus ... er ist "
   +"ja aus Stein.");
  AddDetail(({"kamm ", "hornkamm"}), 
    "Der Hornkamm des Drachens verleiht ihm ein unheimliches "
   +"Aussehen.");
  
  AddSpecialDetail("sockel", "sockel");
  AddSpecialDetail("vertiefung", "vertiefung");
  AddSpecialDetail("klauen", "klauen");
 
  AddSmell(DEFAULT_SOUND, 
    "Die Luft riecht muffig.");
  AddSmell("luft", 
    "Sie riecht sehr abgestanden und muffig.");
  AddSound(DEFAULT_SOUND, 
    "Es ist absolut still.");
  
  AddCmd(({"greif", "greife"}), "maul_greifen");
  AddCmd(({"ertaste", "ertast"}), "drachenmaul");
  AddCmd(({"lege", "leg"}), "steck_sechseck_in_maul");
  AddExit("westen", STADT("kathedr_2"));
}

init()
{
  ::init();
  ertasten=0;
}

reset()
{
  ::reset();
  switch(reset_var) {
    case 0: inhalt=({0,1,1,0}); break;
    case 1: inhalt=({1,1,1,0}); break;
    case 2: inhalt=({0,1,1,1}); break;
    default: inhalt=({0,1,1,0}); 
  }
  reset_var++;
  if(reset_var > 2)
    reset_var=0;
  set_next_reset(3600+random(900));  
}

sechseck_nehmen(int welches)
{
 int ret;
 object sechseck;
 sechseck=clone_object(OBJ2("sechseck"));
 sechseck->SetProp(P_SECHSECK_STEIN, 0);
 switch (welches)
   {
   case 0:  sechseck->SetProp(P_SECHSECK_STEIN, 1);
           break;
   case 1:  sechseck->SetProp(P_SECHSECK_STEIN, 2);
           break;
   case 2:  sechseck->SetProp(P_SECHSECK_STEIN, 3);
           break;
   case 3:  sechseck->SetProp(P_SECHSECK_STEIN, 4);
   } 
 ret = sechseck->move(this_player());
 if (ret == ME_TOO_HEAVY)
   {
   write("Du versuchst das Sechseck an Dich zu nehmen, aber "
         "es ist Dir zu schwer. Du laesst es liegen.\n");
   sechseck->remove();
   return 1;
   }
 inhalt[welches]=0;
 write("Du nimmst das Sechseck an Dich.\n");
 say(BS("Huch! Du hast einen Moment nicht aufgepasst, aber "
      +"Dir war so, als haette "+TPN+" etwas an sich genommen.\n"));
 return 1;
}

string nische()
{
 if (!inhalt[0])
   return BS("Die Nische befindet sich in der Wand. "
            +"Sie ist vollkommen leer. Was da wohl "
            +"drinnen gelegen hat. Vielleicht solltest Du spaeter "
            +"nocheinmal kommen und nachschauen.\n");
 write(BS("Die Nische ist in die Wand eingelassen. In "
         +"ihr liegt ein rubineres Sechseck.")); 
 sechseck_nehmen(0);
 return "";
}

string vertiefung()
{
 if (!inhalt[1])
   return BS("Die Vertiefung am Boden ist vollkommen "
            +"mit Staub aufgefuellt. Du wuehlst ein "
            +"bisschen darin herum, findest aber nichts "
            +"interessantes. Komisch das da nichts drinnen "
            +"liegt... Vielleicht solltest Du spaeter "
            +"nocheinmal kommen und nachschauen.\n");
 write(BS("Die Vertiefung am Boden ist vollkommen "
         +"mit Staub aufgefuellt. Als Du ein bisschen "
         +"darin herumwuehlst, findest Du etwas, dass "
         +"Du sofort herausnimmst. Es handelt sich dabei "
         +"um ein Sechseck, dass aus einem Smaragd zu "
         +"bestehen scheint. "));
 sechseck_nehmen(1);
 return "";   
}

string sockel()
{
 if (!inhalt[2])
   return BS("Dieser kleine Sockel, der sich neben der "
           +"Statue befindet, besteht aus weissem Stein. "
          +"Ansonsten ist absolut nichts besonderes daran "
          +"zu erkennen. Eigentlich hattest Du Dir da etwas "
          +"erwartet. Vielleicht solltest Du spaeter "
            +"nocheinmal kommen und nachschauen.\n");
 write(BS("Dieser kleine Sockel, der sich neben der "
         +"Statue befindet, besteht aus weissem Stein. Auf "
         +"dem Sockel liegt ein Saphirsechseck."));  
 sechseck_nehmen(2);
 return "";   
}

string klauen()
{
 if (!inhalt[3])
   return BS("Die Klauen des Drachen sind besonders scharf "
         +"und sehen sehr gefaehrlich aus. Du hast das "
         +"unbestimmte Gefuehl, dass bei den Klauen "
         +"irgendetwas gelegen haben muss...  Vielleicht "
         +"solltest Du spaeter nocheinmal kommen und "
         +"nachschauen.\n");
   write(BS("Die Klauen des Drachen sind besonders scharf "
         +"und sehen sehr gefaehrlich aus. Zwischen den "
         +"Klauen liegt ein wunderschoenes Diamantsechseck."));
 sechseck_nehmen(3);
 return "";   
}


maul_greifen(string str)
{
 notify_fail("Was moechtest Du denn greifen?\n");
 if(!str) return 0;
 notify_fail("Wo moechtest du reingreifen?\n");
 if(str!="in maul" && str!="in drachenmaul") return 0;
 if(!random(2))
   {
    write(BS("Du nimmst Deinen ganzen Mut zusammen, und "
            +"willst in das Maul der Drachenstatue "
            +"greifen ... doch im letzten Moment zuckst "
            +"Du zurueck..."
            +"Irgendwie schaemst Du Dich ob Deiner Feigheit. "
            +"Vielleicht solltest Du es nocheinmal versuchen?\n"));
    say(BS(TPN+" will wohl mit einer Hand in das Maul des "
            +"Steindrachens greifen, aber "
	   +PlayerGender =="FEMALE"? "sie":"er"+" traut sich "
            +"wohl nicht so richtig und zuckt zurueck.\n"));
    return 1;
   }
 write(BS("Ohne Furcht greifst Du in das Maul des Drachens ... "
         +"Au ... jetzt hast Du Dich an den spitzen Zaehnen "
         +"gestochen. Du tastest noch ein bisschen im Maul herum, "
         +"und Du scheinst da eine Art Einbuchtung zu ertasten. "
         +"Vielleicht solltest Du diese genauer ertasten?\n"));
 TP->do_damage(5);
 say(BS(TPN+" grabbelt im Maul des Drachens herum.\n")); 
 ertasten=1;
 return 1;
}

drachenmaul(string str)
{
  notify_fail("Was willst Du denn ertasten?\n");
  if(!str || !ertasten) return 0;
  notify_fail("Wo willst Du eine Einbuchtung untersuchen?\n");
  if(str=="einbuchtung") return 0;
  notify_fail("Was willst Du denn ertasten?\n");
  if(str!="einbuchtung in maul" && str!="einbuchtung in drachenmaul")
     return 0;
  write("Du tastest weiter herum ... Es scheint sich um eine "
       +"Einbuchtung zu handeln, die in ihrer Form "
       +"sechseckig ist. Was da wohl reingehoert?\n");
  say(BS(TPN+" grabbelt im Maul des Drachens herum.\n"));
  return 1;
}

steck_sechseck_in_maul(string str)
{
  string *neuer_string;
  string wohin;
  object ob;
  
  /*Lege sechseck in einbuchtung*/
  
  notify_fail("Was willst Du wohin legen?\n");
  if(!str) return 0;
  neuer_string=new_explode(str, " ");
 
  if (sizeof(neuer_string)<3) 
    {
      write("Was willst Du wohin legen?\n");
      return 1;
    }
  wohin=implode(({neuer_string[1], neuer_string[2]}), " "); 
  if(wohin!="in einbuchtung")
    {
      write("Da kannst Du nichts hinlegen!\n");
      return 1;
     }  
  ob=deep_present(neuer_string[0], TP);  
  if(!ob) 
    {
     write("Das hast Du ja gar nicht!\n");
     return 1;
    }  
  notify_fail("Welches Sechseck meinst Du jetzt?\n");
  if(deep_present("sechseck 2") && neuer_string[0]=="sechseck")
    {
     write("Welches Sechseck meinst Du jetzt?\n");
     return 1;
    }
  if(ob->id("rubinsechseck") || ob->id("smaragdsechseck") 
     || ob->id("saphirsechseck") || ob->id("diamantsechseck"))   
      {
      
        if(ob && ob->id("diamantsechseck") && sechseck_in_maul< 3)
          {
          write(BS("Du legst das Sechseck vorsichtig in "
            +"die Einbuchtung im Drachenmaul. Ploetzlich "
            +"gibt es einen Knall, und Du verpuerst einen "
            +"fuerchterlichen Schmerz, als das Diamantsechseck "
            +"zerbirst.\n"));

          say(BS(TPN+ "legt etwas in das Maul des Drachen. "
            +"Ploetzlich gibt es einen Knall, und "+TPN
            +" wird zurueckgeschleudert, offenbar schwer "
            +"verletzt.\n"));
          ob->remove();
          sechseck_in_maul=0;
          sechseck_vorhanden=({0, 0, 0, 0});
          TP->do_damage(20+random(21));
          return 1;
         
          }
        write(BS("Du legst das Sechseck vorsichtig in "
          +"die Einbuchtung im Drachenmaul. Ein helles "
          +"Leuchten erfuellt den Raum. Als das Licht "
          +"nachlaesst, ist das Sechseck verschwunden. "
          +"Du hast das Gefuehl, dass Du noch mehr machen "
          +"musst..\n"));
        say(BS(TPN+" legt etwas ins Drachenmaul. Ein helles "
          +"Leuchten erfuellt kurz den Raum, ehe es wieder "
          +"verschwindet.\n"));
        if (!sechseck_vorhanden[(ob->QueryProp(P_SECHSECK_STEIN))-1]) 
            sechseck_in_maul++; 
        sechseck_vorhanden[(ob->QueryProp(P_SECHSECK_STEIN))-1]=1; 
        ob->remove(); 
      }
  if(sechseck_in_maul>=4)  
   {
    tell_room(environment(TP),BS("Die Augen des Drachens beginnen "
     +"zu gluehen..."));
    sechseck_in_maul=0;
    sechseck_vorhanden=({0, 0, 0, 0});
    call_out("hole_gegner", 1);
    return 1;
   } 
return 1;
}

hole_gegner()
{
  object ob;
  int i;

  if (!find_living("soordhin"))
  {
    ob=CLONEOB(NPC("ritter"));
    ob->move(ME, M_TPORT);
    ob->Kill(TP);
  }
  for(i=0;i<=2;i++) {
    ob=CLONEOB(NPC("steingolem"));
    ob->move(find_object(STADT("stadt_g8")), M_GO);
  }
}

