inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"
#include "../../labyrinth.h"



void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"In den Tiefen der Steinstadt");
  SetProp(P_INT_LONG, "Du befindest dich mitten in der Steinstadt. "
              +"Rings um Dich herum stehen Haeuser aus Stein, zahlreiche "
              +"Wege fuehren in die Tiefen der Steinstadt. Der Boden "
              +"ist mit Steinplatten gepflastert. Das Ganze gleicht hier "
              +"einer Art kleinerem Platz, auch einige Steinkloetze, die "
              +"wie Baenke aussehen, stehen am Rand dieses Platzes. "
              +"Hier weht ueberall ein starker Wind, er erstaunlich "
              +"erfrischend ist.");
                
                

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  
  AddDetail(({"waende", "boden"}), "Alles besteht hier aus hartem Fels.");
  AddDetail("hoehle", "Die Hoehle muss gewaltige Ausmasse haben, denn Du kannst "
                     +"ihre Decke im Schein deiner Lichquelle nicht ausmachen. "
                     +"Alles hier besteht aus Fels.");
  AddDetail("steinstadt", "Du befindest Dich inmitten dieser verwinkelten "
                     +"Stadt ... hoeffentlich verirrst Du Dich nicht ...");
  AddDetail("lichtquelle", "Die hast Du bei Dir.");
  AddDetail("schein", "Jaja, genau. Durch den Schein Deiner Lichtquelle ist es hier "
                     +"hell.");
  AddDetail("decke", "Die Decke kannst Du nicht erkennen.");
  AddDetail("fels", "Der Fels ist voellig grau und kalt.");
  AddDetail("stadt", "Kein Zweifel, dass hier ist eine riesige Stadt aus Stein. "
                     +"Du siehst etliche Steinhaeuser und eine Menge von kleinen, "
                     +"verwinkelten Gassen, die teilweise durch Felsbrocken blockiert "
                     +"sind. Hier ist eine Art Platz mit Steinbaenken.");
  AddDetail("stein", "Unglaublich. Offenbar sind die Haeuser buchstaeblich aus dem "
                     +"Fels geschaffen worden, denn Du siehst keine Bearbeitungsspuren. ");
  AddDetail(({"spuren", "bearbeitungsspuren"}), "Es sind keine zu sehen ... Du "
                   +"kannst Dir vorstellen, dass eine maechtige Magie "
                   +"dies alles hier erschaffen hat.");
  AddDetail("gassen", "Die Gassen und Wege fuehren weiter die Steinstadt. Es scheint "
                   +"alles sehr verwinkelt zu sein.");
  AddDetail(({"brocken", "felsbrocken"}), "Die Felsbrocken machen einige Gassen "
                   +"unpassierbar. Sie sind so gross, dass Du nicht darueber "
                   +"hinweg klettern kannst.");
  AddDetail(({"haeuser", "steinhaeuser"}), "Die Haeuser scheinen direkt aus dem "
                   +"Fels gewachsen zu sein. Leider kannst Du weder Tueren noch "
                   +"Fenster erkennen, so dass Du sie wohl nicht betreten kannst."
                   +"Obwohl ... bei einem der Haeuser kannst Du eine Ritze "
                   +"erkennen, die die Form einer Tuer besitzt.");
  AddDetail("ritze", "Sie besitzt die Form einer Tuer.");
  AddDetail("form", "Die Ritze hat die Form einer Tuer.");
  AddDetail("tuer", "Du suchst nach einer Moeglichkeit, diese Tuer zu oeffnen, "
                   +"doch Du scheiterst. Von hier aus wirst Du diese Tuer nie "
                   +"aufbekommen."); 
  AddDetail(({"tueren", "fenster"}), "Keine zu sehen. Wie diese Haeuser wohl "
                   +"betreten werden?");
  AddDetail("rand", "Am Rand des Platzes stehen einige Steinkloetze, die "
                   +"wie Sitzbaenke aussehen.");
  AddDetail(({"steinplatten", "platten"}), "Die Platten bedecken den Boden. "
                   +"Sie wurden wohl erst nachtraeglich verlegt und scheinen "
                   +"nicht, so wie sonst alles hier, mittels Magie "
                   +"erschaffen worden zu sein.");
  AddDetail("magie", "Du glaubst doch nicht etwa sie zu sehen, oder?");
  AddDetail("platz", "Auf diesem Platz befindet sich nichts ausser mehreren "
                   +"Steinkloetzen.");
  AddDetail(({"kloetze", "steinkloetze"}), "Die Steinkloetze stellen wohl sowas "
                   +"wie eine Art Sitzbank dar.");
  AddDetail(({"bank", "baenke", "sitzbaenke", "klotz", "sitzbank"}), 
                    "Der Klotz ist wohl so eine "
                   +"Art Sitzbank. Er hat sogar eine Lehne. Die Baenke stehen "
                   +"vereinzelt um den Platz herum.");
  AddDetail("lehne", "Die Lehne besteht ebenfalls aus Stein.");
  
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen. Das Gefuehl dieser Kraft ist hier unten "
                   +"noch um einiges staerker.");   
  AddDetail("gefuehl", "Du kannst dieses Gefuehl nicht genau beschreiben, "
                   +"es ist einfach ... anders.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  
  
  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");
 
 
}


init()
{
 mapping richtung_map, gebiet_map;
 int i;
 if(!query_once_interactive(TP)) return ::init();
 richtung_map=RICHTUNG;
 gebiet_map=GEBIET;
 RemoveExit(0);
 for(i=0;i<=random(7);i++)
     AddExit(richtung_map[random(7)+1], gebiet_map[random(20)+1]);

 AddExit("osten", STADT("stadt_g6"));
 AddExit("norden", STADT("stadt_f5"));
 AddExit("suedwesten", STADT("stadt_e7"));
 ::init();
}  
      

