#include "../../4elem.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
int geld=0;
int max_gargyls=30;
int max_heal_pool=10000;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Kathedrale" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich nun innerhalb der Kathedrale. Der Innenraum "
   +"ist riesig, weit vorne am Ende der Kathedrale ist ein Altar "
   +"auf einer Erhebung zu erkennen. Links und rechts des Hauptschiffes "
   +"sind zwei Seitenschiffe, die mittels Saeulen vom Hauptschiff getrennt "
   +"sind. Hinter dem Altar befindet sich ein riesiger Wandteppich, der von "
   +"der Decke haengt."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 5]) );
  AddDetail("kathedrale", "Du befindest Dich in ihr."); 
  AddDetail("decke", 
      "Die Decke ist mit Fresken verziert.");
  AddDetail("innenraum", "Du befindest Dich ja in der Kathedrale.");
  AddDetail(({"fresken", "freske"}), 
      "Die Fresken zeigen verschiedene Bilder aus der Stadt.");
  AddDetail(({"bilder", "szenen"}), 
      "Die Bilder an der Decke zeigen mehrere Szenen "
     +"aus der Steinstadt. Eine Szene sticht Dir besonders ins Auge.");
  AddDetail("szene", 
      "Die Szene zeigt ein Steinhaus, eine Vertiefung im Boden und "
     +"zwei sechseckige Gegenstaende");
  AddDetail(({"steinstadt", "stadt"}), 
      "Du befindest Dich in dieser Stadt!!!");
  AddDetail(({"steinhaus", "haus"}),
      "Das Steinhaus kommt Dir irgendwie bekannt vor ... eine Tafel "
     +"haengt an diesem Haus.");
  AddDetail("tafel", 
      "Du kannst leider nichts genauers an der Tafel erkennen.");
  AddDetail("vertiefung", 
      "Die Vertiefung ist vor dem Haus und scheint, so wie der "
     +"abgebildete Gegenstand, sechseckig zu sein.");
  AddDetail("gegenstaende", 
      "Bei den Gegenstaenden handelt es sich wohl um Juwelen. "
     +"Sie scheinen in eine sechseckige Form geschliffen worden zu sein.");

  AddDetail(({"juwelen", "steine"}),
      "Leider kannst Du nicht erkennen, um welche "
     +"es sich handelt. Lediglich die gruene und blaue Farbe, in "
     +"der die Steine abgebildet sind, laesst vermuten, dass es sich "
     +"dabei um einen Smaragd und einen Saphir handelt.");
  AddDetail("farbe", 
      "Die Farbe des einen Juwels ist gruen, die des anderen blau.");
  AddDetail(({"smaragd", "saphir"}),
      "Nur eine Vermutung, ok?");
  AddDetail("form", 
    "    ----    \n"
   +"  /      \\  \n"
   +" /        \\ \n"
   +"/          \\\n"
   +"\\          /\n"
   +" \\        / \n"
   +"  \\      /  \n"
   +"    ----    \n");
  AddDetail("boden", 
      "Der Boden ist mit Platten aus weissem Stein gepflastert, "
     +"von denen ein sanftes Glimmen ausgeht.");
  AddDetail(({"platten", "steinplatten", "stein"}),
      "Die Platten am Boden bestehen aus weissem Stein, von dem "
     +"ein sanftes Glimmen ausgeht.");
  AddDetail("glimmen", 
      "Das Glimmen erhellt die gesamte Kathedrale.");
  AddDetail("waende", 
      "Die Waende sind mit verschiedenen Ornamenten geschmueckt.");
  AddDetail("ornamente", 
      "Die Ornamente sind verschlungene Gebilde, "
     +"deren Linien man fast endlos mit dem Finger folgen koennte.");
  AddDetail("linien", 
      "Die Linien sind in den weissen Stein eingelegt.");
  AddDetail("gebilde", "Naja, Du wirst aus den Ornamenten nicht "
     +"ganz schlau...");
  AddDetail(({"hauptschiff","halle", "schiff"}), 
      "Das Hauptschiff ist eine riesige Halle, die vollkommen "
    + "mit weissen Steinplatten ausgelegt ist. Am oberen Ende "
    + "steht ein Altar auf einer Erhebung.");
  AddDetail(({"erhebung","stufe"}), 
       "Die Erhebung ist nur eine Stufe, dann geht der Boden wieder eben weiter.");
  AddDetail("altar", 
      "Der Altar ist ein prunkvoll verzierter Steintisch, der mit dem Symbol "
     +"der Spirale verziert ist. Dieses Symbol ist mit Gold in den Altar eingelegt. "
     +"Nach vorne hin ist der Altar mit einem Teppich behangen, auf der hinteren "
     +"Seite ist der Altar frei. Auf dem Altar steht eine Schale.");
  AddDetail(({"schale","opferschale"}),
      "Die Schale sieht einer Opferschale sehr aehnlich, und scheint nur fuer "
     +"Muenzen geeignet zu sein. Du koenntest ja mal was opfern...");
  AddDetail("muenzen", 
      "Na hoffentlich hast Du welche bei Dir...");
  AddDetail("gold", 
      "Hmmm ... scheint definitiv Gold zu sein. Du kannst ja versuchen, "
     +"dass Gold herauszukratzen...");
  AddDetail("seite", 
      "Die hintere Seite ist frei, d.h. es haengt kein Teppich "
     +"dort, sodass es moeglich ist, unter den Altar zu schauen.");
  AddDetail("unter altar", 
      "Na sowas! Unter dem Altar ist eine Oeffnung, durch die Du klettern "
     +"koenntest!");
  AddDetail("oeffnung", "Wer weiss was da unter lauert?");
  AddDetail("teppich", 
      "Der Teppich besteht ebenfalls aus dem weissen Stein und zeigt das "
     +"Spiralensymbol.");
  AddDetail("steintisch", "Der Steintisch ist ein Altar!!!");
  AddDetail(({"symbol", "spiralensymbol"}), 
      "Das Symbol stellt eine Spirale mit eineinhalb "
     +"Windungen dar, die von ihnen nach aussen groesser werden.");
  AddDetail("spirale", 
      "Diese Spirale gilt als das Symbol des Elementes \"Luft\".");
  AddDetail("windungen", 
      "Eineinhalb Windungen bilden die Spirale.");
  AddDetail("wandteppich", "Der Wandteppich haengt von der Decke bis herab "
     +"auf den Boden. So wie alles hier, ist der Wandteppich auch aus Stein, jedoch "
     +"scheint dieser staerker zu glimmen als alles andere hier. Ein riesiges "
     +"Symbol, das eine Spirale darstellt, ist auf ihm abgebildet.");
  AddDetail("saeulen", 
      "Die Saeulen, die das Hauptschiff von den Seitenschiffen trennt, sind "
     +"voellig schmucklos und weisen augenscheinlich nichts besonderes auf.");
  AddDetail(({"seitenschiffe","seitenschiff"}), 
      "Die Seitenschiffe sind durch die Saeulen vom "
     +"Hauptschiff getrennt. Ansonsten gleichen sie dem Hauptschiff.");
       
     
  AddCmd(({"opfer", "opfere"}), "opfere_geld");    
  AddCmd(({"kletter", "klettere"}), "runterklettern");
  AddCmd(({"kratz", "kratze"}), "gold_kratzen");
  AddSpecialExit("raus", "nach_draussen");
}

int nach_draussen()
{
  if(present("gargyl", environment(TP)))
  {
    write(BS("Der Gargyl laesst Dich nicht heraus!"));
    return 1;
  }
  TP->move(STADT("stadt_g8"), M_GO, "nach draussen", "geht", 
      "verlaesst gerade die Kathedrale");
  return 1;
}


opfere_geld(string str)
{
  string was; 
  object ob;
  int menge, tat_menge;
  
  notify_fail("Was willst Du opfern?\n");
  if(!str) return 0;

  notify_fail("Das kannst Du nicht opfern!\n");
  if(sscanf(str, "%d %s", menge, was)!=2) return 0;
  // if(was!="muenzen") return 0;
  if(menge!=1 && was!="muenzen") return 0;      // is zwar eigtl. relativ egal,
  if(menge==1 && was!="muenze") return 0;       // aber grammatisch besser

  notify_fail("Du hast ja gar keine Muenzen!\n");
  // if(!(ob=present(was, TP))) return 0;       // argl, so a kaese!
  tat_menge=TP->QueryMoney();
  if (!tat_menge) return 0;                     // besser so.

  notify_fail("Soviele Muenzen hast Du nicht!\n");
  if(menge>tat_menge) return 0;
  // ob->AddAmount(-menge);     // kaese (GRATISVOLLHEILUNG!)
  TP->AddMoney(-menge);         // _VIEL_ besser so! (wozu gaebs das sonst?)

  // Anm.: Bugfixes by Woody, weil Angrox seit 2 Monaten
  // (nachweislich) von dem Bug weiss, aber nix getan hat
  // und derzeit auf Urlaub weilt :-(

  geld+=menge;
   if(present("gargyl", environment(TP)))
    {
     write(BS("Zuerst den Altar schaenden und dann noch "
          +"opfern wollen ... SO NICHT!"));
     return 1;
    }
  if(!interactive(TP)) {
    TP->heal_self(menge/10);
    max_heal_pool+=menge/10;
    return 1;
  }
  if(max_heal_pool < 1) {
     write(BS("Du opferst ein paar Muenzen, aber nichts passiert! Du "
           "fuehlst Dich dennoch gut etwas geopftert zu haben!"));
     say(BS(TPN+" opfert ein paar Muenzen."));
     return 1;
  }
  if(max_heal_pool < (menge/10)) {
    TP->heal_self(max_heal_pool);
    max_heal_pool=0;
  }
  else {
    TP->heal_self(menge/10);
    max_heal_pool-=menge/10;
  }
  TP->do_exhaust(menge/5);
  TP->SetProp(P_DISABLE_ATTACK, 10);
  write(BS("Du opferst ein paar Muenzen und fuehlst Dich sofort geheilt "
    +"und gestaerkt!"));
  say(BS(TPN+" opfert ein paar Muenzen und scheint sich kurz darauf um einiges "
    +"besser zu fuehlen."));
  return 1;  

}


gold_kratzen(string str)
{
  object ob;
  int i;
  notify_fail("Was willst Du kratzen?\n");
  if(!str) return 0;

  if(str=="gold heraus" || str=="gold")
    {
      write(BS("Willst Du das wirklich tun? Wenn ja, dann kannst "
         +"Du das Gold mittels \"kratze gold trotz warnung heraus\" "
         +"herauskratzen.\n"));
      return 1;
    }
  if(str=="gold trotz warnung heraus")
    {
      if( present("gargyle") )
      {
        write("Ein Gargyl hindert Dich daran.\n");
        return 1;
      }
      if (max_gargyls > 0) 
      {
        write(BS("Trotz aller Warnungen beginnst Du damit, dass "
           +"Gold aus dem Altar herauszukratzen ... Irgendwie "
           +"kannst Du nicht gerade viel herauskratzen ... aber "
           +"ploetzlich hoerst Du Fluegelschlaege, und zahlreiche "
           +  "Gargylen attackieren Dich!!!"));
        say(BS(TPN+" kratzt irgendwie am Altar herum, als ploetzlich "
           +"zahlreiche Gargylen auftauchen!!"));
        for(i=(random(3)+1);i>=1;i--) {
          max_gargyls--;
          ob=CLONEOB(NPC("gargyl"));
          ob->move(environment(TP), M_GO);
          if(!IS_LEARNER(TP))
            ob->Kill(TP);
        }
        return 1;
      }
      else {
         write(BS("Du kratzt herum aber nichts passiert."));
         return 1;
      }
    }     
  return 0;
}


runterklettern(string str)
{
  notify_fail("Wo willst Du klettern?\n");
  if(!str) return 0;
  notify_fail("Da kannst Du nicht klettern.\n");
  if(str!="runter" && str!="durch oeffnung" &&
     str!="oeffnung") return 0;

  if(present("gargyl")) {
    write("Der Gargyl laesst Dich nicht hinunter!\n");
    return 1;
  }

  TP->move(STADT("kathedr_2"), M_GO, "nach unten", 
        "klettert durch die Oeffnung", "kommt herein");
  return 1;
}

void reset()
{
  object ob;
  ::reset();
  max_gargyls=30;
  max_heal_pool=10000;
  while( ob=present("gargyl") )
  {
    ob->remove();
    tell_room(TO, "Ein Gargyl zerbroeselt zu Staub.\n");
    if(ob=present("gargylenkralle"))
      ob->remove();
  }
}

