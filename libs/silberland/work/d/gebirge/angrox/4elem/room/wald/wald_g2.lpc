inherit "/d/gebirge/angrox/4elem/room/wald/wald.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"

int betasten;

void create()
{
  ::create();
  betasten=0;
  AddDetail(({"baeume", "steinbaeume"}),
      GetDetail("baeume")+BS("Ein grosser Baum faellt Dir auf."));
  AddDetail("baum",
    "Der Baum ist irgendwie anders. Seine Wurzeln stehen ganz leicht "
   +"hervor und Du vermeinst eine Bewegung der Wurzeln auszumachen. "
   +"Auch die Rinde scheint anders zu sein.");
  AddDetail("rinde", 
    "Die Rinde des Baumes scheint ganz leicht zu glaenzen, auch "
   +"scheint der Wind genau von hier auszugehen. Und obwohl Du "
   +"so nah an der Quelle steht, ist der Wind gleichstark.");
  AddDetail("glanz", 
    "Die Rinde scheint zu glaenzen.");
  AddDetail("quelle"
    "Hmmm ... vielleicht solltest Du die Rinde abtasten?");
  AddDetail("wurzeln", 
    "Die Wurzeln stehen ganz leicht hervor und scheinen sich zu "
   +"bewegen. Vielleicht solltest Du sie mal abtasten.");
  AddDetail("bewegung",  
    "Vielleicht hast Du Dich aber auch getaeuscht...");     
  AddCmd(({"tast", "taste"}), "abtasten");
  AddExit("norden", WALD("wald_g1"));
 
}

init()
{
  int q;
  ::init();
  if(present(B_MAL, TP))
    call_out("aufleuchten", 1);
  if(present("\nharfe der winde", TP) && 
      call_other(QUESTMASTER,"AllowQuest",TP, TP->QueryProp(P_AGE)) && 
      !TP->QueryQuest(WIND_QUEST))
  {  
    q = TP->GiveQuest(WIND_QUEST);
    if (q == 1)
    {
      write_file (WIND_LOG,
          sprintf ("%s  %s hat die Harfe der Winde gefunden.\n",
            dtime(time()), capitalize(TP->query_real_name())));
    }
    else
      if (q != -1)
        return
          write (sprintf("Unbekannter Fehler, bitte den "
                +"zustaendigen Magier verstaendigen!"
                +"\nFehlercode: %d\n", q)), 1;
  }
  if (!present("\nharfe der winde", TP) && TP->QueryQuest(WIND_QUEST))
    call_out("give_harfe",0);
}

void give_harfe()
{
  write("Cailleac'h, die Hueterin dieses Waldes, erscheint.\n"+
      break_string("Es sieht so aus, als ob Du die Harfe noch brauchen wirst. "
      "In Deinen Haenden ist sie sehr gut aufgehoben, kleine"+
      (TP->QueryProp(P_GENDER)==FEMALE?"":"r")+" "+TP->_query_racestring()[0]+".", 
      78, "Cailleac'h sagt: ")+
      "Cailleac'h gibt Dir die Harfe der Winde.\n"
      "Cailleac'h zieht sich wieder in ihren Baum zurueck.\n"
      );
  CLONE( WEAP("harfe"), TP);
}

aufleuchten()
{
 tell_object(TP, BS("Dein Brandmal leuchtet ploetzlich leicht auf."));
}

abtasten(string str)
{
 string was;
 object ob;

 notify_fail("Was willst Du er/be/abtasten?\n");
 if (!str) return 0;
 if(sscanf(str, "%s ab", was)!=1) return 0;

 if(was=="rinde")
   {
     write(BS("Du tastest Die Rinde ab ... sie ist warm ... "
       +"Du spuerst, wie die Rinde leicht erbebt.\n"));
     say(BS(TPN+" grabbelt an einem Baum rum.\n"));
     betasten++;
     }
 if(was=="wurzeln")
   {
     write(BS("Deine Haende gleiten ueber den Baum ... "
           +"es scheint Dir so, als wuerde der Baum "
           +"Deine Beruehrung geniessen.\n"));
      say(BS(TPN+" grabbelt an einem Baum rum.\n"));
     betasten++;
   }
 if (betasten>=2)
   {
    if(!present(B_MAL, TP))
      {
       tell_room(ENV(TP), BS("Eine dumpfe Stimme ertoent: \""
         +"Kehre zurueck in die Steinstadt und suche das Buch "
         +"der Weisheit. Aus ihm vermagst Du zu lernen!\""));
       return 1;
      }
    betasten=0;
    if(call_other(QUESTMASTER,"AllowQuest",TP, TP->QueryProp(P_AGE)))
      {
	if (TP->QueryQuest(WIND_QUEST)) //Cailleac'h's Harfe
        {
         write("Du hast die Quest schon geloest!\n");
         return 1;
	}
        else
	{
          write(BS("Urploetzlich oeffnet sich ein Spalt "
                +"im Baum und zieht Dich hinein!!!\n"));
          say(BS("Ploetzlich oeffnet sich ein Spalt im "
                +"Baum und zieht "+TPN+" hinein.\n"));
          ob=CLONEOB(OBJ2("laehmung"));
          ob->move(TP, M_NOCHECK); 
          TP->move(WALD("baum:"+getuid(TP)), M_GO, "wird vom "
                    +"Baum verschlungen");
        }     
      }
    else write(BS("Du kannst die Quest noch nicht loesen. Du warst "
            +"bereits einmal hier und hast Dich verfuehren lassen."));
   
     
     return 1;
    
   }    

return 1;
}


