inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Eine Kaverne");
  SetProp(P_INT_LONG, "Du befindest Dich am nordwestlichen "
		   +"Ende der Kaverne. Von ueberall her scheint ein "
		   +"starker Wind auf Dich einzudringen, so dass Du "
		   +"Dich kaum noch auf den Beinen halten kannst. An "
		   +"der Nordwand ist eine kleine Vertiefung in der "
		   +"Wand zu sehen.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"wand", "waende", "decke", "boden"}), "Alles besteht hier aus "
		   +"hartem Fels.");
  AddDetail(({"fels", "felsgestein"}), "Der Fels ist kalt und hart.");
  AddDetail(({"kaverne", "felskaverne", "hoehle"}), "Die Kaverne besteht "
		   +"vollkommen aus grauem Felsgestein.");
  AddDetail("nordwand", "Eine kleine Vertiefung befindet sich an "
           +"der Nordwand.");
  AddDetail("vertiefung", "Die Vertiefung ist etwa so gross wie Deine "
		   +"Handflaeche. Sie ist leer. Eine kleine, runde "
		   +"Einbuchtung am Boden der Vertiefung faellt Dir auf.");

  AddDetail("handflaeche", "Ja, Deine Hand.");

  AddDetail("einbuchtung", "Die kreisrunde Einbuchtung hat etwa "
		   +"einen Durchmesser von 2 Fingern. Offenbar hat hier "
		   +"mal etwas gestanden.");

  AddDetail("durchmesser", "Er betraegt 2 Finger.");
  AddDetail("finger", "Na, Du hast doch noch mindestens zwei Finger, "
            +"oder?");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
	     +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");
 

   AddItem(NPC("steinspinne"), REFRESH_DESTRUCT);

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("osten", HOEHLE("hoehle_k7"));
  AddExit("sueden", HOEHLE("hoehle_j8"));


}

