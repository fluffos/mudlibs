inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Ein kleiner Gang");
  SetProp(P_INT_LONG, "Du befindest Dich in einem kleinem "
		  +"Gang, der vollkommen aus grauem, kalten Fels "
		  +"besteht. Im Gang blaest ein starker Wind, der "
		  +"gleichermassen erfrischend wie belebend ist, und "
		  +"welcher von einem unheimlichen Loch im Boden kommt.");



  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  SetProp (P_KILL_NAME, "Ein harter Aufprall");
  SetProp (P_KILL_MSG, "Ich denke ja eher es war eine Komplettloesung "
      "*schmoll*");

  AddDetail(({"waende", "decke"}), "Alles besteht hier aus "
		   +"hartem Fels.");
  AddDetail("gang", "Der Gang besteht aus Felsgestein. Ansonsten "
		   +"ist hier nichts Besonderes zu erkennen.");
  AddDetail("boden", "Der Boden besteht aus kaltem Fels. Inmitten des Bodens "
                   +"ist ein Loch, dass in unbekannte Tiefen fuehrt und sehr gefaehrlich aussiehst . Der Wind "
                   +"blaest aus dem Loch.");
  AddDetail(({"tiefen","tiefe"}), "Was da unten wohl lauert?");
  AddDetail("fels", "Der Fels ist hart und rauh.");    
  AddDetail("loch", "Das Loch fuehrt in unbekannte Tiefen. Du kannst ja "
              +"versuchen, mit oder ohne Kletterhilfe runterzuklettern.");
  AddDetail("kletterhilfe", 
      "Hmm, was koenntest Du da wohl nehmen. Du siehst Dir das Loch nocheinmal "
      "genauer an, vor allem die Waende. Oha, da haettest Du ja fast etwas "
      "uebersehen: Die Waende scheinen seltsam glatt zu sein, Da wuerdest Du niemals "
      "Halt finden und in den _sicheren_ Tod stuerzen.");
  AddDetail( "tod", 
      "Das willst Du doch nicht, oder?");
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen. Der Wind blaest direkt aus dem Loch im "
		   +"Boden.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");


  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren - "
				 +"und zwar SEHR laut.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");


  AddCmd(({"klettere", "kletter"}), "klettern");  
  AddExit("westen", STADT("stadt_h6"));


}


klettern(string str)
{
 mapping attrib;
 int geschick;

 notify_fail("Wohin moechtest Du klettern?\n");
 if (!str) return 0;
 if (str=="runter")
   {
     if(TP->QueryQuest(WIND_QUEST)) {
       write(BS("Hoppala! Hier runterklettern wuerde Dein Ende bedeuten! "
            "Versuch es lieber wo anders."));
      return 1; 
     }
     write(BS("Du nimmst all Deinen Mut zusammen und beginnst, "
	 +"in die unbekannte Tiefe zu klettern ...\n"));
     write(BS("Ploetzlich, als Du nach einem festen Halt "
	+"suchst, gleitet Deine Hand aus ... Du versuchst "
	+"Dich noch festzuhalten, aber zu spaet ... Du "
	+"faellst in die Tiefe ... dann ein kurzer "
	+"Schmerz ...\n"));
     say(TPN+BS(" klettert in die Tiefe ... ploetzlich ist "
	+"ein Schrei zu hoeren ... dann Stille.\n"));
     TP->move(WALD("wald_d3"), M_TPORT|M_SILENT);
     TP->die();
     return 1;
   }

 notify_fail("Damit geht das nicht!\n");
 return 0;
}
