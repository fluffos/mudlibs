inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "../../4elem.h"
#include "/p/daemon/skillmaster/skillmaster.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Ein kleiner Gang");
  SetProp(P_INT_LONG, "Der Gang, in dem Du Dich jetzt befindest, "
		   +"ist schmal. Am Ende des Ganges ist ein fast "
		   +"zwei Schritt grosser Schacht im Boden, der "
                   +"senkrecht nach unten abfaellt. Am Boden, unweit "
		   +"des Schachtes ist eine Art Haken in den Boden "
                   +"eingelassen. Ein starker Wind blaest aus dem "
                   +"Schacht.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  SetProp (P_KILL_NAME, "9.81 m/s^2");
  SetProp (P_KILL_MSG, "Tja, auch ich kann gefaehrlich sein.");

  AddDetail("Der Boden des Ganges besteht aus Fels. Nahe dem Schacht ist "
                   +"eine Art Haken eingelassen.");
  AddDetail(({"wand", "waende", "decke"}), "Alles besteht hier aus "
		   +"hartem Fels.");
   AddDetail(({"fels","felsgestein"}), "Der Fels ist hart und kalt"); 
  AddDetail("gang", "Der Gang besteht aus Felsgestein. Am Boden "
		   +"befindet sich ein grosses Loch und eine Art Haken.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen. Der Wind blaest direkt aus dem Loch im "
		   +"Boden.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  AddDetail("boden", "Direkt im Boden befindet sich ein zwei Schritt "
		   +"grosses Loch und gleich daneben ein Haken, der in den "
		   +"Boden eingelassen ist.");

  AddDetail(({"loch", "schacht"}), "Das Loch hat einen Durchmesser von knapp "
		   +"zwei Schritt und fuehrt geradewegs in die Tiefe. "
		   +"Den Boden des Schachtes kannst Du nicht erkennen. Die "
		   +"Waende im Schacht weisen Vertiefungen auf, die wohl "
		   +"als Kletterhilfe dienen. Du kannst vermutlich auch "
		   +"runterklettern, allerdings ist das ohne Kletterhilfe "
		   +"doch etwas gefaehrlich. Du kannst Dir ausmalen, dass "
		   +"Du einen Sturz wohl nicht ueberleben wuerdest.");

  AddDetail(({"vertiefung","vertiefungen", "kletterhilfen", "hilfen"}), 
                    "Es ist "
		   +"wohl tatsaechlich moeglich, hier runterzuklettern. "
		   +"Wenn Du einfach so versuchen moechtest, dann kannst "
		   +"Du mit \"klettere ohne kletterhilfe todesmutig runter\" versuchen. "
           +"Wenn Du eine "
		   +"bestimmte Kletterhilfe benutzen moechtest, dann "
		   +"kletterst Du mit \"klettere mit <kletterhilfe> "
		   +"runter\".");
  AddDetail("durchmesser",
            "Der Durchmesser des Schachtes betraegt 2 Schritt.");
  AddDetail("haken", "Der Haken ist wohl dafuer gedacht, etwas "
		   +"zu befestigen.");
  AddDetail("kletterhilfe", 
            "Was koenntest Du da wohl verwenden???");
  AddDetail("tiefe", "Wenn Du da runter faellst, bist du garantiert tot.");
  AddDetail("sturz", "Den wuerdest Du nicht ueberleben.");
  AddDetail("schritt", "1 Schritt = 1 Meter.");
  AddDetail("luft", "Du koenntest mal riechen ...");

  AddCmd(({"klettere", "kletter"}), "klettern");


  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");


  AddExit("westen", HOEHLE("hoehle_l8"));


}


int klettern(string str)
{
  object ob;
  int geschick, zufall;
  /*
     if(!IS_LEARNER(TP) && !(TP->QueryProp(P_TESTPLAYER)))
     {
     notify_fail("Das geht noch nicht!\n");
     return 0;
     }
     */
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!str) return 0;
  // if( present("seil", TP) && str== "runter" )
  //   str=="mit seil runter";
  // Idde von Feyaria, dann benutzt man das seil automatisch :)
  if (str=="runter")
  {
    if(!TP->do_exhaust(300)) return 0; 
    write(BS("Du nimmst all Deinen Mut zusammen und beginnst, "
          +"in die unbekannte Tiefe zu klettern ...\n"));
    geschick=TP->QueryAttribute(A_DEX);
    zufall=random(35);
    if(geschick<zufall)
    {
      if(SKILLMASTER->UseSkill(TP, SK_LUCK) < 0) {
        write(BS("Ploetzlich, als Du nach einem festen Halt "
            +"suchst, gleitet Deine Hand aus ... Du versuchst "
            +"Dich noch festzuhalten, aber zu spaet ... Du "
            +"faellst in die Tiefe ... dann ein kurzer "
            +"Schmerz ...\n"));
        say(TPN+BS(" klettert in die Tiefe ... ploetzlich ist "
            +"ein Schrei zu hoeren ... dann Stille.\n"));
        TP->move(HOEHLE("hoehlentod.lpc"), M_TPORT|M_SILENT);
        TP->die();
        //Die Leiche und die Items muessen verschwinden !!!
        return 1;
      }
      else
        write(BS("Hoppala, fast haettest Du den Halt verloren und waerst "
              "in die Tiefe gestuerzt. Doch nun hast Du Dich gefangen und "
              "kletterst sicher hinunten!"));
    }
    write(BS("Du kletterst sicher hinunter, ist ja auch ein "
          +"Kinderspiel fuer Dich. Nach einiger Zeit siehst "
          +"Du einen seitlichen Abgang in dem Schacht. "
          +"Schnell kletterst Du hinein, denn wer weiss, wie "
          +"lange Dein Kletterglueck noch anhaelt.\n"));
    say(TPN+BS(" klettert in die Tiefe.\n"));
    ob=CLONEOB(OBJ2("scriptfalle"));
    ob->move(TP, M_NOCHECK);
    TP->move(STADT("stadt_d7.lpc"), M_TPORT|M_SILENT);
    return 1;
  }

  notify_fail("Damit geht das nicht!\n");
  if(str!="mit seil runter") return 0;
  notify_fail("Du hast ja gar kein Seil!\n");
  if(!present("seil", TP)) return 0;
  notify_fail(""); // Zu erschoepft, not. ausm Player
  if(!TP->do_exhaust(300)) return 0;
  write(BS("Du seilst Dich an und kletterst runter. Nun ist es "
        +"wirklich ein Kinderspiel. Obwohl Du ein paar Mal "
        +"den Halt verlierst, kommst Du unbeschadet zu einem "
        +"seitlichen Abgang des Schachtes. Du kletterest rein, "
        +"und auf wundersame Weise faellt genau in dem Moment "
        +"das Seil herunter, welches Du dann wieder "
        +"einschiebst.\n"));
  say(TPN+BS(" seilt sich an und klettert runter.\n"));
  ob=CLONEOB(OBJ2("scriptfalle"));
  ob->move(TP, M_NOCHECK);
  TP->move(STADT("stadt_d7"), M_TPORT|M_SILENT);
  return 1;

}




