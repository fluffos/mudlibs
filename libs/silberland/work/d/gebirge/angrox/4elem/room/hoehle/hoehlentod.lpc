inherit "std/room";  


#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Du bist ...tot");
 SetProp(P_INT_LONG, "Du bist ...tot.\n");
 
        
}	

GetExits()
{
 return "";
}

int check_items(object ob) {
  if(!interactive(ob)) return 1;
  if(!living(ob)) return 1;
  return 0;
}

void reset() {
  call_out("equip_teleport", random(20)+20);
  return ::reset();
}


void equip_teleport() {
  object *inv;
  int i, nr, old_curse;
  string str, *rooms, *w_rooms,rr;
  inv=filter_array(all_inventory(ME), "check_items");
  rooms=({});
  w_rooms=({"/d/dschungel/feyaria/felseninsel/room/strand4",
         "/d/gebirge/angrox/room/ebene4/ebene4_x7y4",
         "/d/ebene/Midas/room/lagerraum",
         "/d/polar/lamuerte/eishoehle/dorf/rooms/kneipe",
         "/d/ebene/Midas/room/kanal/kanal_g7",
         "/d/ebene/lamuerte/burg/mauer/5x12y",
         "/d/polar/thor/xandim/room/lagerraum",
         "/gilden/paladine/room/burg_schatzkammer",
         "/gilden/paladine/room/burg_unten",
         "/d/kristallwald/sargola/insel/room/3",
         "/d/dschungel/feyaria/dorf/room/dorf-016",
         "/d/huegelland/feyaria/weg/room/0515",
         "/d/unterwelt/amazora/dimension/room/kneipe",
         "/d/wasser/stahldorn/knarkh/room/dorf_a7",
         "/d/dschungel/dante/stein/room/stein13",
         "/d/dschungel/dante/stein/room/stein20",
         "/d/gebirge/dante/room/kvio",
         "/d/polar/thor/berge/room/bergweg1",
         "/d/ebene/ronja/feenquest/room/verlies2",
         "/d/wasser/lupus/mauritius/room/strand24",
         "/d/unterwelt/vernichtung/eingang3",
         "/d/dschungel/dante/hoehle/room/farm",
         "/d/kristallwald/sargola/wald/room/huette",
         "/d/ebene/creative/feldlager/room/zelte/a7_a0_g",
         "/d/wasser/woody/fischerdorf/room/hinterhof", 
         "/d/dschungel/feyaria/dorf/room/lich-016",
         "/d/unterwelt/nekromanten/room/acid_lake/buchinsel",
         "/d/unterwelt/nekromanten/room/yaq-monoq/e4",
         "/d/wasser/angrox/zyklopenfels/room/fels_r1",
         "/d/unterwelt/nekromanten/room/yaq_monoq/h3",
         "/d/kristallwald/chivas/hochebene/room/hoch18",
         "/gilden/paladine",
         "/gilden/berserker",
         "/gilden/druiden",
         "/gilden/zechpreller",
         "/gilden/nekromanten"
   });
  for(i=sizeof(w_rooms)-1;i>=0;i--) {
    if(!catch(call_other(w_rooms[i], "???", 0))) rooms+=({w_rooms[i]});
   }
  for(i=sizeof(inv)-1;i>=0;i--) {
    rr=rooms[random(sizeof(rooms))];
    inv[i]->move(rr, M_NOCHECK|M_SILENT);
    if((inv[i]->QueryProp(P_AMOUNT))>1) str="en";
    else str="t"; 
    tell_room(find_object(rr), sprintf("Ploetzlich materialisier%s sich %s "
           +"im Raum!\n", str, inv[i]->name(WER)));
  }
}
