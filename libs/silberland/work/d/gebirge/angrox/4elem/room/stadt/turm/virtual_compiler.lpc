#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../../../4elem.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, STADT("turm/") );
  SetProp(P_STD_OBJECT, STADT("turm/turm_r2"));
  SetProp(P_VALID_NAME, ({"turm"}) );
}


string Validate(string file)
{
  string path, name;
  int which;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d", name, which) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, STADT("turm/"+name+"_r2"));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo;
  int which;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d",foo,which)!=2)
    return 0;
  previous_object()->AddExit("oben",STADT("turm/turm:"+(which+1)));
  if (which==1)
     previous_object()->AddExit("unten",STADT("turm/turm_r1"));
  else
     previous_object()->AddExit("unten",STADT("turm/turm:"+(which-1)));
  return 1;
}



