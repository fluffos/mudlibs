inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"
#include "../../labyrinth.h"
int stat=4;


void create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Vor einer Steinkathedrale");
  SetProp(P_INT_LONG, "Du traust Deinen eigenen Augen nicht "
		 +"mehr: Hier steht auf einem geraeumigen "
		 +"Platz eine riesige, steinerne Kathedrale. Der "
		 +"ganze Boden rundum ist mit weissen Steinplatten "
		 +"ausgelegt, welche sanft in einem weissen Licht "
		 +"glimmen. Auch hier ist der erfrischende Wind "
		 +"allgegenwaertig, der in Verbindung mit dem "
		 +"erhabenen Anblick der Kathedrale wie ein "
		 +"Adrenalinstoss wirkt.");



  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail("waende", "Alles besteht hier aus hartem Fels.");

  AddDetail("hoehle", "Die Hoehle muss gewaltige Ausmasse haben, denn Du kannst "
		 +"ihre Decke im Schein deiner Lichquelle nicht ausmachen. "
		 +"Alles hier besteht aus Fels.");

  AddDetail("decke", "Die Decke kannst Du nicht erkennen.");
  AddDetail("boden", "Der Boden ist mit weissen Steinplatten "
		 +"ausgelegt, die in einem sanft Licht glimmen.");
  AddDetail("lichtquelle", "Die hast Du bei Dir.");
  AddDetail("schein", "Jaja, genau. Durch den Schein Deiner Lichtquelle ist es hier "
		 +"hell.");

  AddDetail("ausmasse", "Die Hoehle hat gewaltige Ausmasse.");

  AddDetail(({"stein", "fels"}), "Der Fels ist voellig grau und kalt.");

  AddDetail(({"steinplatten", "platten"}), "Die Steinplatten sind "
		 +"weiss wie Schnee und scheinen von Innen heraus zu "
		 +"gluehen. Sie sind angenehm warm.");

  AddDetail("innen", "Die Platten gluehen von Innen heraus.");

  AddDetail("kathedrale", "Die Kathedrale besteht, wie alles hier, "
		 +"aus Stein. Sie ist riesig und ueber und ueber mit den "
		 +"verschiedesten Verzierungen verziert. Der Turm der "
		 +"Kathedrale ragt so weit nach oben, dass Du die Spitze "
		 +"im Schein Deiner Lichtquelle nicht ausmachen kannst. "
		 +"Das Portal, welches in die Kathedrale fuehrt, steht "
		 +"offen.");

  AddDetail("turm", "Der Turm der Kathedrale ist ueber und ueber mit "
                 +"Gargylen verziert. Er ragt bis hoch in die Hoehle "
                 +"auf, seine Spitze kannst Du nicht erkennen.");

  AddDetail("spitze", "Die Spitze des Turmes kannst Du im Schein deiner "
                 +"Lichtquelle nicht ausmachen ...");

  AddDetail("portal", "Das Portal ist mit Ornamenten verziert und "
		 +"etwa 3 Schritt gross. Es steht offen. Mit \"betrete "
		 +"kathedrale\" kannst Du in die Kathedrale gehen.");

  AddDetail(({"ornamente", "ornamenten", "linien"}), "Die Ornamente sind verschlugene "
                 +"Linien. Du folgst ihnen mit den Fingern, gibst "
                 +"dann aber nach einiger Zeit auf.");

  AddDetail("verzierungen", "Die ganze Kathedrale ist in "
		 +"mittelalterlicher Gargylenarchitektur erbaut worden. "
		 +"Erbaut ist irgendwie der falsche Ausdruck, denn es sind "
		 +"keinerlei Bearbeitungsspuren ersichtlich. Die Architektur "
		 +"wird, wie der Name schon sagt, von Gargylenstatuen "
		 +"beherrscht. Fenster sind nur durch steinerne Aequivalente "
		 +"angedeutet.");

  AddDetail(({"spuren", "bearbeitungsspuren"}), "Es sind keine zu sehen "
		 +"... Du kannst Dir vorstellen, dass eine maechtige Magie "
		 +"dies alles hier erschaffen hat.");

  AddDetail(({"architektur", "gargylenarchitektur", "baustil"}), "Durch diese "
		 +"architektonischen Baustil wirkt die Kathedrale etwas "
		 +"unheimlich.");

  AddDetail(({"fenster","aequivalente"}),  "Die \"Fenster\" sind "
		 +"auch als Stein, also nur stilistisch angedeutet und "
		 +"tatsaechlich nutzlos.");

  AddDetail(({"statuen", "gargylen", "gargylenstatue", "ungeheuer", "gargylenstatuen"}), 
                  "Die Statuen "
		 +"zeigen steinerne Ungeheuer: Gefluegelte Gestalten mit "
		 +"Hoernern, die Fluegel mit den scharfen Krallen an den "
		 +"Koerper angelegt oder weit gespreizt. Du bist erleichtert, "
		 +"dass das nur Statuen sind. Oder? Huch ... Dir ist so, "
		 +"als haette sich eine Statue leicht bewegt?");
  AddDetail("fluegel", "Die Fluegel des Gargyl sehen sehr kraeftig "
                 +"aus. Sie enden in scharfe Krallen.");

  AddDetail("krallen", "Die Krallen sehen SEHR gefaehrlich aus.");

  AddDetail("gestalten", "Die Gargylen sehen ECHT unheimlich aus.");

  AddDetail("hoerner", "Die Hoerner errinnern Dich an Daemonen.");

  AddDetail("daemonen", "HE! Sie _errinnern_ Dich daran. Da ist kein "
		 +"Daemon, ok?");

  AddDetail("krallen", "Wow ... die Krallen sehen scharf und SEHR "
		 +"gefaehrlich aus.");

  AddDetail("koerper", "Die Koerper der Gargylen sehen recht sehnig "
		 +"aus.");

  AddSpecialDetail(({"gargyl", "statue", "gargylstatue"}), "gargylen");

 
    AddDetail(({"rune", "symbol"}), "Das Symbol stellt eine stellt eine Spirale mit "
		 +"eineinhalb Windungen dar, die von ihnen nach aussen "
		 +"groesser werden. Das Symbol ist in den Felsboden "
		 +"eingelassen.");

  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		 +"\"Luft\". Sie ist in den Fels eingelassen.");

  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		 +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		 +"mitschwingen. Das Gefuehl dieser Kraft ist hier unten "
		 +"noch um einiges staerker.");
  AddDetail("gefuehl", "Du kannst dieses Gefuehl nicht genau beschreiben, "
		 +"es ist einfach ... anders.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		 +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		 +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		 +"\"Luft\" zugeordnet.");

  AddDetail("anblick", "Die Kathedrale bietet einen ueberwaeltigenden "
                 +"Anblick.");

  AddDetail("platz", "Der Platz, auf dem die Kathedrale steht, ist sehr "
                 +"geraeumig.");   

  AddDetail("licht", "Das Licht der Platten ist beruhigend sanft.");

  AddCmd(({"betrete", "betritt"}), "kathedrale");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		 +"und fuehlst Dich gleich besser.");

  AddItem(NPC("steingolem"), REFRESH_DESTRUCT);

}


init()
{
 mapping richtung_map, gebiet_map;
 int i;
 if(!query_once_interactive(TP)) return ::init();
 richtung_map=RICHTUNG;
 gebiet_map=GEBIET;
 RemoveExit(0);
 if((random(3)+1)==1)
   {
     for(i=0;i<=random(9);i++)
	 AddExit(richtung_map[random(7)+1], gebiet_map[random(20)+1]);
   }
 AddExit("nordwesten", STADT("stadt_f7"));
 AddExit("osten", STADT("stadt_h8"));
 AddExit("sueden", STADT("stadt_g9"));
 ::init();
}



string gargylen()
{
  object ob;
  if(!stat) 
    return BS("Du untersuchst die Statue, findest aber nix.\n");
  ob=clone_object(NPC("gargyl"));
  ob->SetProp(P_XP, ob->QueryProp(P_XP)*random(100)/150);  
  ob->move(environment(TP), M_GO);
  ob->Kill(TP);
  stat--;
 return BS("Als Du die Statue untersuchst, springt der "
	   +"Gargyl von seinem Platz und attackiert Dich!\n");
}

kathedrale (string str)
{
 notify_fail("Was moechtest Du betreten?");
 if(!str) return 0;
 notify_fail("Das kannst Du nicht betreten.");
 if(str!="kathedrale") return 0;
 TP->move(STADT("kathedr_1"), M_GO, "die Kathedrale", "betritt",
			"kommt herein");
 return 1;
}

reset()
{
 stat=4;
 ::reset();
}
