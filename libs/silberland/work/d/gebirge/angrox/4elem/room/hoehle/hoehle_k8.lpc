inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Eine Kaverne");
  SetProp(P_INT_LONG, BS("Vor Dir erstreckt sich eine Felskaverne. "
		   +"Auf dem Boden vor Dir ist ein Symbol in den Boden "
		   +"eingelassen, welches eine gewunde Spirale zeigt. "
		   +"Die Kaverne erstreckt sich nach Norden, Osten und "
		   +"Westen und scheint ziemlich gross zu sein, da "
		   +"Du das Ende der Hoehle nicht ausmachen kannst. "
		   +"Der Wind braust in der Kaverne, so dass seine "
		   +"Richtung nicht zu bestimmen ist.\n"));

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"wand", "waende", "decke"}), "Alles besteht hier aus "
		   +"hartem Fels.");
  AddDetail(({"fels","felsgestein"}), "Der Fels ist hart und kalt.");

  AddDetail(({"kaverne", "felskaverne", "hoehle"}), "Die Kaverne besteht "
		   +"vollkommen aus grauem Felsgestein. Am Boden der "
		   +"Kaverne ist eine Spirale in den Fels eingelassen.");

  AddDetail(({"boden", "felsboden"}), "In den Boden ist das "
	       +"Symbol einer Spirale in den Fels eingelassen.");

  AddDetail("symbol", "Das Symbol stellt eine stellt eine Spirale mit "
		   +"eineinhalb Windungen dar, die von ihnen nach aussen "
		   +"groesser werden. Das Symbol ist in den Felsboden "
		   +"eingelassen.");

  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		   +"\"Luft\". Sie ist in den Fels eingelassen.");

  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
	    +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  AddDetail("luft", "Die Luft hier ist kuehl und erfrischend.");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("norden", HOEHLE("hoehle_k7"));
  AddExit("osten", HOEHLE("hoehle_l8"));
  AddExit("sueden", HOEHLE("hoehle_k9"));
  AddExit("westen", HOEHLE("hoehle_j8"));

}

