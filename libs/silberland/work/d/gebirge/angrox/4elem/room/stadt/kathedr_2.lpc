// Unterhalb der Kathedrale
//

#include "../../4elem.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Katakombe" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Katakombe. Sie ist "
   +"ebenfalls mit diesen weissen Steinplatten ausgelegt, "
   +"jedoch scheinen diese erloschen. Ein dicke Staubschicht "
   +"belegt diese Platten, und nichts deutet darauf hin, dass "
   +"diese Katakombe vor kurzem betreten wurde. Die Luft hier ist "
   +"muffig."); 
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 5]) );
  
  AddDetail("katakombe", 
    "Du befindest Dich hier in einer Katakombe, ja!");
  AddDetail("raum", 
    "Du stehst mittendrin."); 
  AddDetail(({"wand", "waende", "decke"}), 
    "Alles ist hier mit diesen Steinplatten ausgelegt.");
  AddDetail("boden", 
    "Der Boden ist mit weissen Steinplatten ausgelegt. Eine "
   +"dicke Staubschicht liegt darauf.");
  AddDetail(({"platten", "steinplatten"}),
    "Die Steinplatten sind kalt und mit einer Staubschicht "
   +"bedeckt, ansonsten ist nichts besonderes an ihnen zu "
   +"erkennen.");
  AddDetail(({"staubschicht", "schicht", "staub"}), 
    "Die Staubschicht weisst darauf hin, dass hier schon lange "
   +"keiner mehr war.");
  AddDetail("luft", "Du koenntest mal schnuppern...");

  AddSmell(DEFAULT_SOUND, 
    "Die Luft riecht muffig.");
  AddSmell("luft", 
    "Sie riecht sehr abgestanden und muffig.");
  AddSound(DEFAULT_SOUND, 
    "Es ist absolut still.");
  
  AddExit("osten", STADT("kathedr_3"));
  AddExit("oben", "nach oben#"+STADT("kathedr_1"));
}












