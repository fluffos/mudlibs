inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Ein kleiner Gang");
  SetProp(P_INT_LONG, "Du befindest Dich in einem kleinen Gang. "
                    +"An der westlichen Wand befindet sich der Einstieg "
                    +"in den Schacht, der nach oben in die Hoehle "
                    +"fuehrt. Der Wind kommt aus Osten, wo sich schon "
                    +"nach wenigen Schritten eine Hoehle mit scheinbar "
                    +"gewaltigen Dimensionen auftut. Mehr kannst Du "
                    +"allerdings nicht erkennen, da der Schein Deiner "
                    +"Lichtquelle das nicht mehr erhellt.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  
  AddDetail("wand", "In der Westwand ist ein Schacht nach oben.");
  AddDetail(({"waende", "decke", "boden"}), "Alles besteht hier aus "
		   +"hartem Fels.");
  AddDetail("gang", "Der Gang besteht aus Felsgestein. An der Westwand befindet "
                   +"sich der Ausstieg nach oben.");
  AddDetail("westwand", "An der Westwand befindet sich der Aufstieg nach oben.");
  AddDetail("lichtquelle", "Die hast Du bei Dir.");
  AddDetail("hoehle", "Davon kannst Du von hier nicht viel erkennen.");
  AddDetail("schacht", "Der Schacht fuehrt nach oben zu der Hoehle, von der aus "
                   +"Du hier herunter gekommen bist.");
  AddDetail(({"einstieg", "aufstieg", "ausstieg"}), "Von da bist Du gekommen. Mit "
                   +"\"klettere rauf\" kannst Du wieder nach oben gelangen.");
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  AddDetail("dimensionen", "Sie scheint gewaltig gross zu sein.");

  AddDetail(({"fels", "gestein", "felsgestein"}), "Der Fels ist kalt und grau.");
  AddDetail("luft", "Du koenntest mal riechen...");
  AddCmd(({"klettere", "kletter"}), "klettern");


  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");
 
  AddExit("osten", STADT("stadt_e7"));

}


klettern(string str)
{
 object ob;
 notify_fail("Wohin moechtest Du klettern?\n");
 if (!str) return 0;
 if (str=="rauf")
   {
     if(!TP->do_exhaust(300)) return 0;
      if(ob=present("antiscript", TP))
        ob->remove();
      write(BS("Du kletterst ohne Probleme nach oben.\n"));
      TP->move(HOEHLE("hoehle_m8"), M_GO, "hinauf", "klettert", "von unten herauf");
      return 1;
   }
 return 0;
}




