inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"
#include "../../labyrinth.h"



void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"In der Steinstadt");
  SetProp(P_INT_LONG, "Du befindest Dich in einer riesigen Hoehle, die "
		 +"so gross ist, dass Du ihre Ausmasse gar nicht "
		 +"erfassen kannst. Hier befindet sich eine Stadt aus "
		 +"Stein, inmitten der Hoehle!!! Haeuser, die scheinbar "
		 +"direkt aus dem Fels gearbeitet wurden, stehen ringsum. "
		 +"Zahlreiche Wege fuehren von hier aus in die Tiefen der "
		 +"Steinstadt, einige sind "
		 +"von Gesteinsbrocken blockiert, andere sind frei passierbar. "
		 +"Der Weg nach Westen fuehrt zu dem Durchgang nach oben. "
		 +"Hier weht ueberall ein starker Wind, der erstaunlich "
		 +"erfrischend ist.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"wand", "waende", "boden"}), "Alles besteht hier aus hartem Fels.");
  AddDetail("hoehle", "Die Hoehle muss gewaltige Ausmasse haben, denn "
		 +"Du kannst ihre Decke im Schein deiner Lichtquelle nicht "
		 +"ausmachen. Alles hier besteht aus Fels.");
  AddDetail("lichtquelle", "Die hast Du bei Dir.");
  AddDetail("schein", "Jaja, genau. Durch den Schein Deiner Lichtquelle "
		 +"ist es hier hell.");
  AddDetail("ausmasse", "Die Hoehle hat gewaltige Ausmasse.");
  AddDetail("fels", "Der Fels ist voellig grau und kalt.");
  AddDetail("tiefen", "Die Stadt ist ziemlich verwinkelt, da musst Du "
		 +"aufpassen, dass Du Dich nicht verirrst.");
  AddDetail("stadt", "Kein Zweifel, dass hier ist eine riesige Stadt "
		 +"aus Stein. Du siehst etliche Steinhaeuser und eine Menge "
		 +"von kleinen, verwinkelten Gassen, die teilweise durch "
		 +"Felsbrocken blockiert sind.");
  AddDetail("stein", "Unglaublich. Offenbar sind die Haeuser "
		 +"buchstaeblich aus dem Fels geschaffen worden, denn Du "
		 +"siehst keine Bearbeitungsspuren. ");
  AddDetail(({"spuren", "bearbeitungsspuren"}), "Es sind keine zu "
		 +"sehen ... Du kannst Dir vorstellen, dass eine maechtige "
		 +"Magie dies alles hier erschaffen hat.");
  AddDetail(({"gassen", "wege"}), "Die Gassen fuehren weiter in die Steinstadt. Es "
		 +"scheint alles sehr verwinkelt zu sein.");
  AddDetail(({"gesteinsbrocken", "brocken", "felsbrocken"}), "Die Felsbrocken "
                +"machen einige Gassen "
		+"unpassierbar. Sie sind so gross, dass Du nicht darueber "
		+"hinweg klettern kannst.");
  AddDetail(({"haeuser", "steinhaeuser"}), "Die Haeuser scheinen direkt aus dem "
				   +"Fels gewachsen zu sein. Leider kannst Du weder Tueren noch "
				   +"Fenster erkennen, so dass Du sie wohl nicht betreten kannst.");
  AddDetail(({"tueren", "fenster"}), "Keine zu sehen. Wie diese Haeuser wohl "
				   +"betreten werden?");
  AddDetail("durchgang", "Im Westen, ja?");
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen. Das Gefuehl dieser Kraft ist hier unten "
				   +"noch um einiges staerker.");
  AddDetail("gefuehl", "Du kannst dieses Gefuehl nicht genau beschreiben, "
				   +"es ist einfach ... anders.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");
  
  AddDetail("luft", "Du koenntest mal riechen...");
  AddDetail(({"weg", "westen"}), "Vom Westen bist du hergekommen.");
  AddDetail("steinstadt", "Die Steinstadt scheint riesig zu sein...");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");
 
}


init()
{
 mapping richtung_map, gebiet_map;
 int i;
 if(!query_once_interactive(TP)) return ::init();


     richtung_map=RICHTUNG;
     gebiet_map=GEBIET;
     RemoveExit(0);
     for(i=0;i<=random(7);i++)
       AddExit(richtung_map[random(7)+1], gebiet_map[random(20)+1]);

     AddExit("westen", STADT("stadt_d7"));
     AddExit("sueden", STADT("stadt_e8"));
     AddExit("nordosten", STADT("stadt_f6"));
 
::init();
}  
      

