#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include "../../4elem.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, WALD("") );
  SetProp(P_STD_OBJECT, WALD("std_baum"));
  SetProp(P_VALID_NAME, ({"baum"}) );
}


string Validate(string file)
{
  string path, name, who;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, WALD("std_"+name));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo,who;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",foo,who)!=2)
    return 0;
  return 1;
}
