inherit "/d/gebirge/angrox/4elem/room/wald/wald.lpc";
#include <properties.h>
#include <language.h>
#include "../../4elem.h"
#include <moving.h>

void create()
{
  ::create();
  AddDetail("decke", "An der Decke ist ein Loch, durch das "
     +"Du nach oben klettern kannst.");
  AddDetail("loch", "Da kannst Du raufklettern.");
  AddCmd(({"klettere", "kletter"}), "klettern");
  AddExit("sueden", WALD("wald_d4"));
}

klettern(string str)
{
 object ob;
 notify_fail("Wohin moechtest Du klettern?\n");
 if (!str) return 0;
 if (str=="rauf")
   {
    
      write(BS("Du kletterst ohne Probleme nach oben.\n"));
      TP->move(STADT("stadt_i9"), M_GO, "hinauf", "klettert", "klettert von unten herauf");
      return 1;
   }
 return 0;
}





