inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"
#include "../../labyrinth.h"



void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"In den Tiefen der Steinstadt");
  SetProp(P_INT_LONG, "Du befindest Dich inmitten einer riesigen "
	 	   +"Steinstadt. Ein riesiger Platz erstreckt sich "
        	   +"vor Dir, in dessen Mitte ein kreisrunde "
		   +"Erhebung, die etwa einen halben Schritt hoch "
		   +"ist. Viele Wege fuehren hier in alle "
		   +"Himmelsrichtung in die Tiefen der Stadt "
		   +"hinein. Ein sehr erfrischender Wind blaest "
		   +"weht hier ueber den Platz.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail("waende", "Alles besteht hier aus hartem Fels.");

  AddDetail("boden", "Der Boden besteht aus hartem Fels.");

  AddDetail("hoehle", "Die Hoehle muss gewaltige Ausmasse haben, denn "
		 +"Du kannst ihre Decke im Schein deiner Lichquelle nicht "
		 +"ausmachen. Alles hier besteht aus Fels.");

  AddDetail("platz", "Du stehst auf einem riesigen Platz, welcher in "
		 +"etwa kreisrund ist. Etwa in der Mitte des Platzes ist eine "
		 +"Erhebung zu sehen.");

  AddDetail("erhebung", "Die Erhebung ist etwa einen halben Schritt "
		 +"hoch und hat eine kreisrunde Form, auch sie besteht "
		 +"vollkommen aus Stein. In der Mitte der Erhebung ist eine "
		 +"rechteckige Vertiefung.");

  AddDetail("vertiefung", "Die Vertiefung ist rechteckig. Du hast "
		 +"keine Ahnung, was da mal gestanden ist.");


  AddDetail("decke", "Du kannst sie nicht sehen.");

  AddDetail("lichtquelle", "Die hast Du bei Dir.");

  AddDetail("schein", "Jaja, genau. Durch den Schein Deiner Lichtquelle "
		 +"ist es hier hell.");

  AddDetail("tiefen", "Du musst schon gut aufpassen, damit Du Dich "
		 +"hier nicht verirrst.");

  AddDetail("ausmasse", "Die Hoehle hat gewaltige Ausmasse.");

  AddDetail("fels", "Der Fels ist voellig grau und kalt.");

  AddDetail("tiefen", "Die Stadt ist ziemlich verwinkelt, da musst Du "
		 +"aufpassen, dass Du Dich nicht verirrst.");

  AddDetail("stein", "Alles hier besteht aus diesem harten Fels, und es "
                 +"sind nirgends Bearbeitungsspuren zu sehen.");

  AddDetail(({"spuren", "bearbeitungsspuren"}), "Es sind keine zu sehen "
		 +"... Du kannst Dir vorstellen, dass eine maechtige Magie "
		 +"dies alles hier erschaffen hat.");

  AddDetail(({"gassen", "wege"}), "Die Gassen fuehren weiter die "
		 +"Steinstadt. Es scheint alles sehr verwinkelt zu sein.");

  AddDetail(({"brocken", "felsbrocken"}), "Die Felsbrocken machen "
		 +"einige Gassen unpassierbar. Sie sind so gross, dass Du "
		 +"nicht darueber hinweg klettern kannst.");

  AddDetail(({"steinstadt", "stadt"}), "Du befindest Dich inmitten dieser verwinkelten "
                     +"Stadt ... hoffentlich verirrst Du Dich nicht ...");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		 +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		 +"mitschwingen. Das Gefuehl dieser Kraft ist hier unten "
		 +"noch um einiges staerker.");

  AddDetail("gefuehl", "Du kannst dieses Gefuehl nicht genau beschreiben, "
		 +"es ist einfach ... anders.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		 +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		 +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		 +"\"Luft\" zugeordnet.");


  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		 +"und fuehlst Dich gleich besser.");
  
  AddItem(NPC("steingolem"), REFRESH_DESTRUCT);
}


init()
{
 mapping richtung_map, gebiet_map;
 int i;
 if(!query_once_interactive(TP)) return ::init();
 richtung_map=RICHTUNG;
 gebiet_map=GEBIET;
 RemoveExit(0);
 for(i=0;i<=random(7);i++)
	 AddExit(richtung_map[random(7)+1], gebiet_map[random(20)+1]);
 AddExit("sueden", STADT("stadt_f9"));
 ::init();
}











































































