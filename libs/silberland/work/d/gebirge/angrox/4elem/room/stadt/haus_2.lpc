inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"


void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"In einem Steinhaus");
  SetProp(P_INT_LONG, "Das Innere des Hauses ist erstaunlich "
		  +"geraeumig. Irgendwie kommt es Dir hier herinnen "
		  +"groesser vor als von draussen. Zahlreiche "
		  +"Einrichtungsgegenstaende befinden sich hier: Ein "
		  +"Tisch mit mehreren Stuehlen, mehrere Regale, die "
                  +"ueber und ueber mit Buechern vollgestopft sin, "
                  +"eine massiv wirkende "
		  +"Truhe, welche mit einem Schloss gesichert ist und "
                  +"ein Wandteppich. Der allgegenwaertige "
		  +"Wind ist auch hier zu spueren. Ein gleissendes "
                  +"Portal ist an einer Wand zu sehen.");



  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail("raum", "Du befindest Dich innerhalb eines Steinhauses.");
  AddDetail(({"steinhaus", "haus"}), "Du befindest Dich darin!");
  AddDetail(({"einrichtungsgegenstaende", "einrichtung"}), "Mehrere "
           +"Regale und ein "
           +"Wandteppich zieren den Raum, eine Truhe, mehrere "
           +"Stuehle und ein Tisch komplettieren die Einrichtung.");
  AddDetail(({"wand", "waende"}), "Die Waende des Hauses bestehen aus "
                +"Stein und sind "
                +"durch einige Regale verstellt, die ueber und ueber mit "
                +"Buecher gefuellt sind.");
  AddDetail("decke", "Die Decke des Hauses ist aus Stein. Es ist keine "
            +"Lampe oder aehnliches zu erkennen. Nur ein Kristall waechst "
            +"in der Mitte der Decke."); 
  AddDetail("boden", "Der Boden des Hauses besteht aus Stein.");
  AddDetail("lampe", "Es ist keine zu sehen.");
  AddDetail("kristall", "In der Mitte der Decke haengt ein wundervoller, "
            +"blauer Kristall. Sein Schliff bricht das Licht in allen "
            +"Farben und erhellt so den Raum.");
  AddDetail("licht", "Das Licht Deiner Lichtquelle wird durch den "
            +"Kristalle an der Decke in viele bunte Farben gebrochen.");
  AddDetail("lichtquelle", "Die hast Du doch bei Dir!!");
  AddDetail(({"regenbogenfarben", "farben"}), "Der Kristall an der "
            +"Decke bricht das Licht Deiner in viele bunte, lustige "
            +"Farben: rot, blau, gruen, orange, gelb, violett, rosa, "
            +"tuerkis, magenta, cyan, und noch viele, viele mehr.");
  AddDetail("schliff", "Der Schliff der Kristalls bricht das Licht in alle "
            +"Farben und laesst den ansonsten grauen Raum freundlich und warm "
            +"aussehen.");
  AddDetail("farben", "Alle Regenbogenfarben.");
  AddDetail("Regale", "Die Regale stehen an den Waenden. Sie sind ueber "
            +"und ueber mit Buechern vollgestopft, die, wie es scheint, "
            +"ebenfalls aus Stein bestehen.");
  AddDetail("buecher", "Die Buecher sind leider allesamt versteinert, so "
            +"dass Du sie nicht oeffnen kannst. Auf dem Umschlag sind "
            +"leider keine Schriftzeichen zu erkennen.");
  AddDetail("schriftzeichen", "Du kannst keine erkennen.");
  AddDetail("umschlag", "Der Umschlag der Buecher ist ebenfalls aus Stein "
            +"und voellig glatt. Nur bei einem Buch erkennst du einen "
            +"gemusterten Umschlag.");
  AddDetail("buch", "Ein Buch hat einen gemusterten Umschlag. Vielleicht "
            +"kannst Du es ja herausziehen?");
  AddDetail("truhe", "Die Truhe ist etwa einen halben Schritt gross und "
            +"wirkt schon auf den ersten Blick sehr stabil. Dieser "
            +"Eindruck wird durch das massive Schloss, welches die Truhe "
            +"ziert, noch sehr verstaerkt.");
  AddDetail("schloss", "Das Schloss, welches die Truhe versperrt, macht einen "
            +"sehr stabilen Eindruck. Du glaubst nicht, dass Du es ohne "
            +"den dazugehoerigen Schluessel oeffnen kannst.");
  AddDetail("tisch", "Der Tisch fuellt fasst den halben Raum aus und "
            +"ist leer. Neben dem Tisch stehen fuenf Stuehle.");
  AddDetail("stuehle", "Fuenf Stuehle stehen neben dem Tisch. Sie sehen "
            +"recht bequem aus, doch da sie aus Stein sind, truegt wohl "
            +"dieser erste Eindruck.");
  AddDetail("stein", "Alles in diesem Raum besteht aus Stein. Der Stein "
            +"ist kalt und grau ... so richtig oed.");
  AddDetail(({"wandteppich", "teppich"}), "Der Wandteppich zeigt eine "
            +"grosse Rune, die wie eine Spirale aussieht.");
   AddDetail(({"rune", "symbol"}), "Das Symbol stellt eine stellt eine Spirale mit "
		 +"eineinhalb Windungen dar, die von ihnen nach aussen "
		 +"groesser werden."); 

  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		 +"\"Luft\".");

  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");
  AddDetail("portal", "Das Portal scheint aus Licht zu bestehen. Vermutlich "
             +"ist es der Teleporter nach draussen. Du koennest es "
             +"betreten.");
  AddDetail("teleporter", "Ausprobieren, ausprobieren ...:)");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist gedaempft "
		   +"zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist leise.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddCmd(({"ziehe", "zieh"}), "buch_heraus");
  AddCmd("oeffne", "oeffne_truhe");
  AddCmd(({"betrete", "betret"}), "portal");


}


init()
{
 
  ::init();
 
  if(!present("gargyl"))
    {
     gargyl();
   
    }

}

gargyl()
{
  object ob;
 ob=CLONEOB(NPC("gargyl"));
 ob->move(environment(TP), M_GO);
  call_out("attackieren", 1, ob);
}

attackieren(object ob)
{
 write("Der Gargyl attackiert Dich!\n");
 ob->Kill(TP);
}


GetExits()
{
 return "";
}



buch_heraus(string str)
{
 object ob;
 string x;
 int groesse;
 x=explode(str, " ");
 groesse=sizeof(x);
 notify_fail("Was moechtest Du ziehen?\n");
 if(!str) return 0;
 notify_fail("Das kannst Du nicht ziehen.\n");
 if(x[0]!="buch") return 0;
 
 notify_fail("So geht das nicht!\n");
 if(groesse != 2) return 0;
 if(x[1]!="heraus") return 0;
  if(present("gargyl", environment(TP)))
   {
    write("Der Gargyl laesst Dich nicht!");
    return 1;
   }
 write(BS("Du ziehst das Buch vorsichtig heraus. Es ist ziemlich schwer. "
         +"Du kannst es nicht oeffnen, also steckst Du es zurueck."));
 say(BS(TPN+" zieht ein Buch aus einem der Regale und stellt es wieder "
         +"zurueck."));

 return 1;  
}


oeffne_truhe(string str)
{
object ob;
notify_fail("Was willst Du oeffnen?\n");
if (!str && str !="truhe") return 0;

 if(present("gargyl", environment(TP)))
   {
    write("Der Gargyl laesst Dich nicht!\n");
    return 1;
   }     
  if(ob=deep_present(("\nwindschluessel"), TP))
    {
     write(BS("Als Du den Schluessel im Schloss umdrehst, bricht er ab. "
      +"Du oeffnest die Truhe, und darin liegt ein steinerner "
      +"Kubus, den Du an Dich nimmst."));
     say(BS(TPN+" oeffnet die Truhe und nimmt was heraus."));
     ob->remove();
     ob=CLONEOB(OBJ2("kubus"));
     ob->move(TP, M_NOCHECK);  
     return 1;
     }
  write (BS("Du hast keinen passenden Schluessel bei Dir.\n"));
  say (BS(TPN+" versucht vergeblich, eine Truhe zu oeffnen."));
  return 1;
}


portal(string str)
{
 if(!str || str!="portal")
   {
     write(BS("Was moechtest Du betreten.\n"));
     return 1;
   }
  if(deep_present("saphirsechseck", TP) && 
        deep_present("\nsteinkubus", TP))
    call_out("nojuwel", 1); 
 TP->move(STADT("stadt_i7"), M_TPORT, "im Portal", "verschwindet", 
        "erscheint ploetzlich");
 return 1;
}


nojuwel()
{
 object ob;
 ob=deep_present("saphirsechseck", TP);
 write(BS("Dein Saphirsechseck loest sich auf!"));
 ob->remove();
}












