inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Ein Felsgang");
  SetProp(P_INT_LONG, "Du bist in einem schmalen Felsgang. So wie "
       +"es aussieht, ist dieser Gang natuerlichen Ursprungs. "
       +"An der noerdlichen Wand hangt ein ein Gobelin. Am Boden "
       +"des Ganges liegen einige Steine. "
       +"Es starker Wind blaest durch den Gang. Es ist kuehl.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"waende", "boden", "decke"}), "Alles besteht hier aus "
  			 +"hartem Fels.");
  AddDetail("fels", "Der Fels ist hart und kalt.");
  AddDetail(({"gang", "felsgang"}), "Der Gang scheint natuerlichen "
			 +"Ursprungs zu sein, da keinerlei Spuren von "
			 +"Bearbeitung zu sehen sind. Am Boden liegen einige "
			 +"Steine. ");
  AddDetail("spuren", 
            "Hmmm ... seltsam, es sind keine zu sehen. Wie dieser "
           +"Gang wohl entstanden ist?");  

  AddDetail(({"wand", "nordwand", "noerdliche wand"}), 
            "An der Nordwand haengt ein Gobelin - und zwar aus Fels!"); 

  AddDetail("steine", "Die Steine liegen am Boden.");
  AddDetail("ursprung", "Genau kannst Du es auch nicht sagen, "
			 +"aber da keine Spuren von Bearbeitung im ganzen "
			 +"Gang zu sehen ist, muss er wohl natuerlichen "
			 +"Ursprungs sein, oder?");
  AddDetail("wind", "Du empfindest diesen "
		   +"Wind als sehr belebend, so als wuerde die Urwuechsigkeit "
		   +"und Kraft der Elemente mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
    +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
    +"anders ist als sonstwo.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");
  AddDetail(({"gobelin", "wandteppich", "teppich"}), BS("Der Wandteppich, "
      +"denn ein Gobelin ist ein solcher, haengt an der noerdlichen "
      +"Wand des Ganges. Der Teppich hat eine merkwuerdig graue "
      +"Farbe und bewegt sich nicht im Wind. Erst auf den zweiten "
      +"Blick faellt Dir auf, das der ganze Teppich versteinert "
      +"ist! Da das feine Gewebe des Stoffes trotzdem zu sehen ist, "
      +"bedeutet das wohl, das Irgendetwas - oder Irgendwer - diesen "
      +"Teppich nachtraeglich versteinert hat.\nDas Motiv auf dem "
      +"Goblin zeigt einen dichten Wald.\n"));
  AddDetail(({"gewebe","stoff", "gestein"}), 
       "Es ist deutlich zu sehen. Irgendwann "
      +"bestand dieser Teppich aus Stoff - aber jetzt ist er massives "
     +"Gestein.");
  AddDetail(({"wald", "motiv"}), 
       "Ueber dem Wald auf dem Gobelin ist eine Art Decke "
      +"abgebildet. Sollte dieser abgebildete Wald etwa einen "
      +"untersilberlaendischen Wald darstellen? Ein Symbol, welches "
      +"sich in der Mitte des Goblins befindet, faellt Dir auf.");
  AddDetail("symbol", "Das Symbol stellt eine stellt eine Spirale mit "
      +"eineinhalb Windungen dar, die von ihnen nach aussen "
      +"groesser werden.");
  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
      +"\"Luft\".");
  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");
  AddDetail("farbe", 
       "Eine merkwuerdige graue Farbe.");
  AddDetail("mitte", 
      "Na, in der Mitte halt. :)");
  AddDetail("luft", 
      "Die Luft ist wundersam berauschend.");


  AddItem(NPC("steinspinne"), REFRESH_DESTRUCT);
  
  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");


  AddExit("norden", HOEHLE("hoehle_k8"));
  AddExit("osten", HOEHLE("hoehle_l9"));

}

