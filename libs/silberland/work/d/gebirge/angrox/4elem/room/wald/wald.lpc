** Steinwald - Main description
**
*/

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../../4elem.h"
#include "../../wald.h"

nosave int kraut=2;

#define KRAUTMASTER WALD("wald")

int herb=0;

int set_herb();
int remove_herb();

create()
{ 
  mapping MAP;
  string langbeschreibung;
  int i;
  
  ::create();
  langbeschreibung="";
  for(i=1;i<=5;i++)
    {
      switch(i)
	{
	case 1:  MAP=LANG_1;
                 break;
        case 2:  MAP=LANG_2;
                 break;
        case 3:  MAP=LANG_3;
                 break;
        case 4:  MAP=LANG_4;
                 break;
        case 5:  MAP=LANG_5;
        }
      langbeschreibung+=MAP[random(6)+1];
    }

  SetProp( P_INT_SHORT, "Im Steinwald");
  SetProp( P_INT_LONG,BS(langbeschreibung));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );

 MAP=D_GEWAECHSE;
  AddDetail("gewaechse", MAP[random(2)+1]);
 MAP=D_STEINWALD;
  AddDetail(({"steinwald", "wald"}), MAP[random(2)+1]);
 MAP=D_BAEUME;
  AddDetail(({"baeume", "steinbaeume"}), MAP[random(2)+1]);
 MAP=D_BUESCHE;
  AddDetail("buesche", MAP[random(2)+1]);  
 MAP=D_PFLANZEN;
  AddDetail("pflanzen", MAP[random(2)+1]);
 MAP=D_GRAS;
  AddDetail(({"gras", "graeser"}), MAP[random(2)+1]);
 MAP=D_WIND;
  AddDetail("wind", MAP[random(2)+1]);
 MAP=D_BODEN;
  AddDetail("boden", MAP[random(2)+1]);
 MAP=D_DECKE;
  AddDetail("decke", MAP[random(2)+1]);
 MAP=D_HOEHLE;
  AddDetail("hoehle", MAP[random(2)+1]);
 MAP=D_SCHEIN;
  AddDetail("schein", MAP[random(2)+1]);
 MAP=D_LICHTQUELLE;
  AddDetail("lichtquelle", MAP[random(2)+1]);
 MAP=D_STADT;
  AddDetail(({"steinstadt","stadt"}), MAP[random(2)+1]);
 MAP=D_STEIN;
  AddDetail(({"gestein, stein"}), MAP[random(2)+1]);
 MAP=D_FLAIR;
  AddDetail("flair", MAP[random(2)+1]);
 MAP=D_EINDRUCK;
  AddDetail(({"eindruck", "szenerie"}), MAP[random(2)+1]);
 MAP=D_ANGST;
  AddDetail("angst", MAP[random(2)+1]);
 MAP=D_BLAETTER;
  AddDetail("blaetter", MAP[random(2)+1]);
 MAP=D_VORSICHT;
  AddDetail("vorsicht", MAP[random(2)+1]);
 MAP=D_VERSTEINERUNG;
  AddDetail("versteinerung", MAP[random(2)+1]);
 MAP=D_AESTE;
  AddDetail("aeste", MAP[random(2)+1]);
 MAP=D_STEIN;
  AddDetail("stein", MAP[random(2)+1]);

 AddCmd(({"n", "o", "s", "w", "norden", "osten", 
	    "sueden", "westen"}), "schaden"); 
 AddCmd( ({"pfluecke", "pflueck"}), "get_herb");
 if(!random(5) && call_other(KRAUTMASTER, "check_kraut")) {
   if(call_other(KRAUTMASTER, "set_kraut")) {
     set_herb();
   }
 }
}


schaden()
{
  int geschick;
  geschick=TP->QueryAttribute(A_DEX);
  if(random(35)>geschick)
    {
       write(BS("Als Du weitergehst, verletzt Du Dich an einem "
        +"der scharfen Blaetter."));
       TP->do_damage(random(5)+1);
    }
   return 0;
}


int check_kraut() {
  if(PO != ME) {
    return kraut;
  }
  return 0;
}

int set_kraut() {
  if(kraut > 0) {
    kraut--;
    if(kraut < 0 ) kraut=0;
    return 1;
  }
  return 0;
}

int set_herb() {
  string det_gras;
  mapping MAP;
  herb=1;
  MAP=D_GRAS;
  det_gras=MAP[random(2)+1]+" Eine kleine Pflanze scheint "
    "jedoch nicht aus Stein zu sein. Du koenntest sie pfluecken.";
  AddDetail("pflanze", "Eine Pflanze ist nicht versteinert. Seltsam. "
      "Vielleicht solltest Du sie pfluecken.");
  AddDetail(({"gras", "graeser"}), det_gras);
  return 1;
}

int remove_herb() {
  mapping MAP;
  MAP=D_GRAS;
  AddDetail(({"gras", "graeser"}), MAP[random(2)+1]);
  RemoveDetail("pflanze");
  herb=0;
  return 1;
}

void reset() {
  ::reset();
  kraut=2;
  if(herb)
    remove_herb();
  if(!random(2) && call_other(KRAUTMASTER, "check_kraut")) {
    if(call_other(KRAUTMASTER, "set_kraut")) {
      set_herb();
    }
  }

}

int get_herb(string str) {
  object ob;
  if(!herb) return 0;
  if(str != "pflanze") {
    write("Was moechtest Du pfluecken?\n");
    return 1;
  }
  if(!random(2))
    ob=clone_object("/p/magic/luftkraut");
  else
    ob=clone_object("/p/magic/magiekraut");
  if(ob->move(TP, M_GIVE)==ME_TOO_HEAVY) {
    ob->remove();
    write(BS("Du bist Dir nicht sicher ob Du das Kraut noch tragen "
          "kannst. Du beschliesst es nicht zu pfluecken."));
    return 1;
  }
  write(BS("Du pflueckst die Pflanze und schiebst sie ein."));
  say(BS(sprintf("%s pflueckt eine kleine Pflanze und schiebst sie ein.",
          TP->Name(WER))));
  remove_herb();
  write_file(LOG("kraut.log"), sprintf("%s: %s pflueckt %s (%s).\n",
          dtime(time()), CAP(getuid(TP)), ob->name(), file_name(ME)));
  herb=0;
  return 1;
}



