inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Eine Kaverne");
  SetProp(P_INT_LONG, "Du befindest Dich am suedwestlichen "
		   +"Ende der Kaverne. Von ueberall her scheint ein "
		   +"starker Wind auf Dich einzudringen, so dass Du "
		   +"Dich kaum noch auf den Beinen halten kannst. Am "
		   +"Boden ist eine Gesteinsformation zu sehen, die "
		   +"wie eine Blume aussieht.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"waende", "decke"}), "Alles besteht hier aus "
		   +"hartem Fels.");

  AddDetail(({"fels","felsgestein"}), "Der Fels ist hart und kalt"); 

  AddDetail(({"kaverne", "felskaverne", "hoehle"}), "Die Kaverne besteht "
		   +"vollkommen aus grauem Felsgestein.");

  AddDetail("boden", "Eine seltsame Gesteinsformation, die wie eine "
		   +"Blume aussieht, genauergesagt wie eine Rose, ist mit dem "
		   +"Boden fest verankert.");

  AddDetail(({"blume", "rose", "formation", "gesteinsformation", "steinrose"}),
		    "Die Gesteinsformation in Form einer Rose sieht perfekt "
		   +"gearbeitet aus. Alle Einzelheiten einer echten Rose "
		   +"wurden beruecksichtigt. Als Du Dir sie so ansiehst, "
		   +"bist Du Dir auf einmal nicht mehr sicher, ob dies "
		   +"ein Werk aus der Hand eines Kuenstlers, eine "
		   +"natuerlich gewachsene und danach versteinerte, oder "
		   +"eine echte, \"lebende\" Steinrose ist.");

  AddDetail("einzelheiten", 
            "In allen Einzelheiten gleicht diese Steinrose einer echten "
           +"Rose.");
  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
	      +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
	      +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  AddDetail("luft", "Die Luft hier ist erfrischend.");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("norden", HOEHLE("hoehle_j7"));
  AddExit("osten", HOEHLE("hoehle_k8"));


}

