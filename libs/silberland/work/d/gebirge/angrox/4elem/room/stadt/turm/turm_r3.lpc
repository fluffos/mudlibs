inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../../4elem.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

void create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Steinturm");
  SetProp(P_INT_LONG, "Dieses Obergeschoss wird durch ein "
             +"pulsierendes, gruenes Licht spaerlich erhellt. "
             +"Der Raum ist leer - leer bis auf einen Steinblock "
             +"im hinteren Teil des Obergeschosses, von dem das "
             +"Leuchten ausgeht. Eine Treppe fuehrt nach unten, "
             +"eine andere nach oben. Das leise Rauschen des "
             +"Windes ist zu hoeren.");

  SetProp(P_KILL_NAME, "Ein Brandmal");
  SetProp(P_KILL_MSG, "Was hast Du auch SO wenig Hitpoints?????");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail("raum", "Du befindest Dich im Inneren eines Turmes.");

  AddDetail("turm", "Da bist du in einem Obergeschoss.");

  AddDetail("inneren", "Da befindest Du Dich.");

  AddDetail(({"decke", "boden", "decke", "waende", "wand"}), "Alles besteht hier "
		   +"aus hartem Fels.");

  AddDetail("leuchten", "Das gruene Leuchten geht von dem Steinblock "
            +"im Raum aus."); 

  AddDetail("fels", "Der Fels hier ist reinweiss und fuehlt "
		   +"sich warm an.");

  AddDetail("treppe", "Eine Treppe fuehrt zu den oberen Stockwerken, "
		   +"die andere zu den Unteren.");

  AddSpecialDetail(({"block", "steinblock"}), "steinblock");

  AddSpecialDetail("buch", "buch");

  AddDetail("stockwerke", "Du weisst nicht, wieviele Stockwerke "
		   +"der Turm hat.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  // AddCmd auskommentiert da Funktion "lesen" nicht existiert...
  // woody - 16.8.2003
  // AddCmd(({"lies", "lese"}), "lesen");

  //AddItem(NPC("golem"), REFRESH_DESTRUCT);

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist gedaempft "
		   +"zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist leise.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("runter", "die Treppe nach unten#"+STADT("turm/turm:2"));
 AddExit("oben", "die Treppe nach oben#"+STADT("turm/turm:48"));

}

init()
{
   
  ::init();
  if(!present("waechtergolem"))
    {
     golem();
     
    /*
    if(ob=deep_present("\nsteinkugel", TP))
      {
       ob->remove();
       write("Deine Steinkugel hat sich aufgeloest.");
    */
      }    
}
        
golem()
{
 object ob;
 ob=CLONEOB(NPC("golem"));
 ob->move(environment(TP), M_GO);
}
string steinblock()
{

  if(present("golem", environment(TP)))
    {
      write(BS("Der Golem laesst Dich nicht vorbei !!!!\n"));
      say(TPN+BS(" versucht am Golem vorbeizukommen, doch der "
        +"laesst "+(PlayerGender == FEMALE ? "sie":"ihn")+" "
        +"nicht vorbei!\n"));
      return "";
    }
  return BS("Der Block besteht aus weissem Fels und wird "
     +"von einem gruenen, pulsierenden Leuchten eingehuellt. "
     +"Auf dem Block liegt ein Buch.\n");
}


string buch()
{
  object ob;
  if(present("golem", environment(TP)))
    {
      write(BS("Der Golem laesst Dich nicht vorbei !!!!\n"));
      say(TPN+BS(" versucht am Golem vorbeizukommen, doch der "
        +"laesst "+(PlayerGender == FEMALE ? "sie":"ihn")+" "
        +"nicht vorbei!\n"));
      return "";
    }
  if(!present(B_MAL, TP))
    {
      if(ob=deep_present("\nsteinkugel", TP))
      {
       ob->remove();
       write("Deine Steinkugel hat sich aufgeloest.");
      }
      ob=CLONEOB(OBJ2("brandmal"));
      ob->move(TP, M_NOCHECK);
      TP->do_damage(10);
      return BS("Das Buch ist mit Leder gebunden und liegt auf dem "
        +"Steinklotz. Als Du naeherkommst, und es lesen willst, "
        +"schiesst ein gruener Lichtstrahl auf Dich zu verbrennt "
        +"Dich an der Stirn.\n");
    }
  return BS("Du durchblaetterst das Buch... Du findest darin zahlreiche "
        +"Zeichnungen. Eine davon sticht Dir besonders ins Auge: "
        +"Es zeigt einen Abenteurer, der in einem Wald steht, mit "
        +"einem gluehenden Brandmal auf der Stirn. Seltsam ... denn "
        +"Dein Brandmal glueht nicht... Du legst das Buch wieder "
        +"zurueck.\n");
}
