inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INT_LONG, "Du gehst auf einem schlecht ausgetretenen "
		   +"Gebirgspfad. Links und rechts von Dir zieren einige "
		   +"Buesche den Wegesrand, links steht ein einzelner, "
		   +"verkrueppelter Baum. Das Vorankommen faellt Dir "
		   +"aufgrund der schlechten Beschaffenheit des Pfades "
		   +"schwer.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE:5]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail("beschaffenheit", "Auf dem Gebirgspfad wachsem einige "
	    +"Pflanzen, vor allem Gras und einige kleine Buesche. "
            +"Vereinzelt ist auch ein Stein auf dem Weg zu sehen.");

  AddDetail("gras", "Trotz der Hoehe und der Kaelte hier oben sieht das "
	    +"Gras saftig aus.");
  AddDetail("buesche", "Die Buesche wachsen neben dem Pfad, aber das er "
	 +"schon laengere Zeit nicht mehr benutzt worden zu sein "
	+"scheint, wachsen auch einige auf dem Weg.");
  AddDetail(({"steine","stein"}), 
         "Die Steine liegen auf dem Pfad. Du kannst leicht "
        +"ueber sie hinwegsteigen.");
  AddDetail(({"pfad", "weg", "boden", "gebirgspfad"}), 
       "Der Pfad ist wohl schon "
       +"lange nicht mehr benutzt worden, denn einige "
       +"Steine und Pflanzen liegen, bzw. wachsen auf ihm. ");

  AddDetail("baum", "Die Aeste dieses Baumes sind voellig verdreht und "
       +"verkrueppelt. Von Natur aus ist es wohl nicht moeglich, "
       +"dass ein Baum so waechst. Irgendwas scheint diesem Baum "
      +"schweren Schaden zugefuegt zu haben.");
  AddDetail("schaden", 
       "Verkrueppelte und unnatuerlich verdrehte Aeste. An der "
      +"Rinde in der Naehe des Bodens befindet sich etwas Graues.");
  AddDetail(({"rinde", "grau", "graues"}), "Hmm ... offenbar hat sich etwas "
      +"Kalkgestein an der Rinde abgelagert.");
  AddDetail(({"kalk", "kalkgestein", "gestein"}), "Ein paar kleinere Wurzeln "
      +"scheinen schon voellig aus dem Kalkgestein zu bestehen.");
  AddDetail("wurzeln", "Sie sind so gut wie versteinert.");
  AddDetail("pflanzen", "Auf dem Gebirgspfad wachsen einige Pflanzen, vor "
                   +"allem Gras und einige kleine Buesche.");
  AddDetail("hoehe", 
            "Hier bist Du schon um einiges hoeher, die Luft "
           +"ist auch duenn.");
  AddDetail("luft", 
            "Obwohl sie schon so duenn ist, kannst Du problemlos "
           +"atmen.");
  AddDetail("natur", 
            "Die Natur ist um Dich herum."); 
   AddDetail("fels", "Der Fels ist hart und grau.");
  AddDetail(({"felsstuecke", "stuecke"}), 
            "Die liegen am Pfad.");
  AddDetail("kaelte", 
            "Naja, es ist schon kalt.");
  AddDetail(({"gebirge", "berg"}),
           "Da befindest Du Dich. Majestaetische Gipfel ragen hoch auf.");
  AddDetail("gipfel", 
            "Sie sind schneebedeckt und majestaetisch schoen.");



  AddSound(DEFAULT_SOUND, "Der Wind pfeift sanft.");
  AddSound("wind", "Der Wind verursacht ein sanftes Pfeifen.");
  AddSound("pfeifen", "Obwohl das Pfeifen vom Wind kommt, scheint "
				   +"doch eine eigentuemliche, nicht zu erklaernde "
				   +"Vitalitaet mitzuschwingen.");
  AddSmell(DEFAULT_SMELL, "Hmmm ... frische Gebirgsluft.");
  AddSmell(({"luft", "gebirgsluft"}), "Die Luft ist kalt und duenn.");

  AddExit("norden", WEG("berg_r3"));
  AddExit("sueden", WEG("berg_r1"));

}

