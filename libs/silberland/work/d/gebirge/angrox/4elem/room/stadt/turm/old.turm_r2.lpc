inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../../4elem.h"
int zufall=0;
void create()
{
   if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Im Steinturm");
  SetProp(P_INT_LONG, "Dieses Obergeschoss ist vollkommen "
			+"leer, abgesehen von einer kleinen Vertiefung "
			+"nahe der Treppe nach oben. Eine andere Treppe "
			+"fuehrt nach unten. Ein leichter Wind ist zu "
			+"verspueren.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail("raum", "Du befindest Dich im Inneren eines Turmes.");

  AddDetail("turm", "Da bist du in einem Obergeschoss.");

  AddDetail("inneren", "Da befindest Du Dich.");

  AddDetail(({"decke", "boden", "decke", "waende", "wand"}), "Alles besteht hier "
		   +"aus hartem Fels.");

 

  AddDetail("vertiefung",
              "Die Vertiefung ist kaum noch zu erkennen.");  

  AddSpecialDetail(({"form", "halbkugel"}), "halbkugel");

  AddDetail("fels", "Der Fels hier ist reinweiss und fuehlt "
		   +"sich warm an.");

  AddDetail("treppe", "Eine Treppe fuehrt zu den oberen Stockwerken, "
		   +"die andere zu den Unteren.");

  AddDetail("stockwerke", "Du weisst nicht, wieviele Stockwerke "
		   +"der Turm hat.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");
  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
		   +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");
  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");

  AddCmd(({"leg", "lege"}), "reinlegen");

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist gedaempft "
		   +"zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist leise.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");
  previous_object()->CustomizeObject();
}


string halbkugel()
{
 if(!present("\nsteinkugel", TP))
  return BS("Hmm ... wenn Du nur was haettest, was Du da "
		   +"reinstecken koenntest...\n");
 return BS("Vielleicht kannst Du ja steinerne Kugel "
		   +"reinlegen...\n");
}


reinlegen(string str)
{

 notify_fail("Was willst Du wo reinlegen?\n");
 if(!str) return 0;
 notify_fail("Das funktioniert so nicht.\n");
 if(str!="steinkugel in vertiefung" && str!="kugel in vertiefung")
       return 0;
 notify_fail("Das hast Du ja gar nicht!\n");
 if(!present("\nsteinkugel", TP)) return 0;
 write(BS("Du bueckst Dich und legst die Kugel in die "
	   +"Vertiefung. Du hoerst ein leises klicken und "
	   +"Du nimmst die Kugel wieder an Dich.\n"));
 say(TPN+BS("steckt eine Kugel in die Vertiefung und "
	   +"nimmt sie dann gleich wieder mit.\n"));
 RemoveExit(0);
 AddExit("oben", "die Treppe nach oben#"+STADT("turm/turm_r3"));
 return 1;
}

init()
{
 int stockwerke;
 ::init();
 if(file_name(TO)==STADT("turm/turm:50"))
    {
      tell_object(this_player(), BS("Du stuerzt und stolperst etliche "
          +"Stockwerke nach unten...\n"));
      stockwerke=random(40)+1;
      TP->reduce_hit_points(50-stockwerke);
      TP->move(STADT("turm/turm:"+stockwerke), M_GO, "", "verliert das "
            +"Gleichgewicht und stolpert nach unten", "stolpert von "
            +"oben herein");
       TP->do_damage((random(2))+50-stockwerke);
     }
 if(!zufall)
    zufall=random(48+1); 
 if(file_name(TO)==STADT("turm/turm:"+zufall))
   {
     if(present("\nsteinkugel", TP))
       call_out("vibrieren", 2);
     AddDetail("vertiefung", "Die Vertiefung hat eine die Form einer "
		   +"Halbkugel.");
     AddSpecialDetail(({"form", "halbkugel"}), "halbkugel");
     AddCmd(({"leg", "lege"}), "reinlegen");
   }

}


vibrieren()
{
 tell_object(TP, BS("Die Steinkugel vibriert leicht."));
}




