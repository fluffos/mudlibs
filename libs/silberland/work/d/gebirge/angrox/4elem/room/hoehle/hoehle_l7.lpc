inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../4elem.h"

void create()
{
  ::create();
  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Eine Kaverne");
  SetProp(P_INT_LONG, "Du befindest Dich am nordoestlichen "
		   +"Ende der Kaverne. Von ueberall her scheint ein "
		   +"starker Wind auf Dich einzudringen, so dass Du "
		   +"Dich kaum noch auf den Beinen halten kannst. "
		   +"An der noerdlichen Wand haengt ein grauer "
		   +"Wandteppich.");


  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));

  AddDetail(({"waende", "boden", "decke"}), "Alles besteht hier aus "
		   +"hartem Fels.");
   AddDetail(({"fels","felsgestein"}), "Der Fels ist hart und kalt"); 
  AddDetail(({"kaverne", "felskaverne", "hoehle"}), "Die Kaverne besteht "
		   +"vollkommen aus grauem Felsgestein.");

  AddDetail(({"wand", "nordwand"}), "An der Nordwand haengt ein "
		   +"grosser Wandteppich.");

  AddDetail(({"wandteppich", "teppich"}), "Der Wandteppich ist "
		   +"vollkommen aus Stein und reicht von der Decke "
		   +"bis zum Boden. Darauf abgebildet ist eine Frau, "
		   +"die auf einer Harfe spielt.");

  AddDetail("frau", "Die Frau wirkt sehr lebensecht, vor allem ihre "
		   +"Augen. Alles in allem ist sie recht huebsch. In ihren "
		   +"Haenden haelt sie eine Harfe.");

  AddDetail("haende", "Da haelt sie eine Harfe.");

  AddDetail("augen", "Die Augen strahlen etwas Faszinierendes aus. "
		   +"Du kannst nur schwer deinen Blick von diesen Augen "
		   +"abwenden.");

  AddDetail(({"faszinierendes", "faszination"}), "Es ist so als "
		   +"wuerden diese Augen direkt in Dich hineinblicken.");

  AddDetail(({"harfe", "kunstwerk"}), 
                    "Die Harfe ist wahrlich ein Kunstwerk. "
		   +"Sie besteht aus zwoelf Saiten, und sie traegt das "
		   +"Spiralen-Symbol.");
  AddDetail("saiten", 
            "Die Harfe hat zwoelf Saiten..."); 

  AddDetail(({"symbol", "spiralen-symbol"}), "Das Symbol stellt "
		   +"eine Spirale mit eineinhalb Windungen "
		   +"dar, die von ihnen nach aussen groesser werden. ");

  AddDetail("spirale", "Diese Spirale gilt als das Symbol des Elementes "
		   +"\"Luft\". Sie ist in den Fels eingelassen.");

  AddDetail("windungen", "Eineinhalb Windungen bilden die Spirale.");

  AddDetail("wind", "Du empfindest diesen Wind als sehr belebend, so "
		   +"als wuerde die Urwuechsigkeit und Kraft der Elemente "
		   +"mitschwingen.");

  AddDetail(({"urwuechsigkeit", "kraft"}), "Du kannst es nicht genau "
	     +"beschreiben, aber Du spuerst deutlich, dass dieser Wind hier "
		   +"anders ist als sonstwo.");

  AddDetail(({"elemente", "element"}), "Der Wind ist wohl dem Element "
		   +"\"Luft\" zugeordnet.");



  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist zu hoeren.");
  AddSound("brausen", "Das Brausen des Windes ist laut.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  AddSmell("luft", "Du atmest ein paar mal durch "
		   +"und fuehlst Dich gleich besser.");

  AddExit("sueden", HOEHLE("hoehle_l8"));
  AddExit("westen", HOEHLE("hoehle_k7"));


}

