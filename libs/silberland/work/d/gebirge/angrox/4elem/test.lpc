

#include "../../4elem.h"
#include "../../wald.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

mapping PLANG_1, PLANG_2;

create()
{ 
  ::create();
  PLANG_1=LANG_1;
  PLANG_2=LANG_2;
  SetProp( P_INT_SHORT, "Im Steinwald" );
  SetProp( P_INT_LONG,BS( 
     PLANG_1[random(7)]+PLANG_2[random(7)]));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15]) );
 // AddExit( "norden", "nach Norden#" + "./room2" );
}
