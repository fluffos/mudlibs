**
** Baum der Cailleac'h
**
*/


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../4elem.h"


#define TR(x) tell_room(environment(this_player()), "\n"+x+"\n")

int sequenz=0;
int annahme=0;
int part_one=0;
int frage=0;
int zeit=0;
string spielername;
object spieler;
void create()
{
  ::create();
  
  SetProp(P_INT_LONG, "");
  SetProp(P_LIGHT,-1);
  SetProp(P_INT_SHORT,"In einem Baum");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5]));
  AddExit("raus", WALD("wald_g2"));
  previous_object()->CustomizeObject();
}


init()
{
  ::init();
 if(!sequenz)
   {
     sequenz=1;
     spieler=TP;
     spielername=TP->QueryProp(P_NAME);
     call_out("sequenz_part_one", 1);
   }
} 


sequenz_part_one()
{
 if(ENV(TP)!=TO) return;
 part_one++;
 switch(part_one)
   {
   case 1: TR(BS("Es ist dunkel..."));
           zeit=4;
           break;
   case 2: TR(BS("Du siehst keinen einzigen Lichtpunkt. Es ist "
           +"vollkommen und absolut dunkel. Seltsam ... Du hast eine "
           +"Lichtquelle, doch diese erhellt nicht den kleinsten "
           +"Fleck."));
           zeit=5;
           break;
   case 3: TR(BS("Als Du Dich bewegen willst, gehorcht Dir Dein "
           +"Koerper nicht. Trotz aller Anstrengungen kannst Du "
           +"nicht den kleinsten Muskel bewegen." )); 
           zeit=5;
           break; 
   case 4: TR(BS("Irgendwie kommt Dir Diese Situation sehr "
           +"bekannt vor. Allerdings ist hier nichts in "
           +"Grossbuchstaben, und so beschliesst Du, erst "
           +"mal ganz ruhig zu bleiben.")); 
           zeit=10; 
           break; 
   case 5: TR(BS("Nichts passiert ...")); 
           zeit=7;
           break;
   case 6: TR(BS("Lange Zeit nichts ..."));
           zeit=15;
           break;
   case 7: TR(BS("Dann ploetzlich vernimmst Du eine leise "
           "Stimme in deinem Kopf."));
           zeit=5;
           break;
   case 8: TR(BS("\"Sei gegruesst, Sterblicher!\""));
           zeit=5;
           break;
   case 9: TR(BS("\"Ich bin Cailleac'h, die Hueterin dieses "
           +"Waldes, Abgesandte der Feen und Hueterin der "
           +"Harfe der Winde.\""));
           zeit=5;
           break;
   case 10: TR(BS("Ploetzlich wirst Du in ein sanftes Licht "
          +"getaucht. Du kannst jetzt endlich Deine Umgebung "
          +"erkennen. Du befindest Dich offenbar im Inneren "
          +"des steinernen Baumes, der wohl ausgehoehlt ist. "
          +"Alles hier besteht aus glaenzenden Kristallen, "
          +"von denen das sanfte Licht auszugehen scheint."));
          zeit=8;
          break;
   case 11: TR(BS("Und dann siehst Du sie ... "));
          zeit=5;
          break;
   case 12: TR(BS("Du siehst eine halbdurchsichtige Gestalt im "
          +"hinteren Teil des Raumes. Sie ist in leichte, "
          +"fliessende Gewaender gehuellt und scheint Dich mit "
          +"Interesse zu mustern."));
          zeit=4;
          break;
   case 13: TR(BS("Du versuchst zu sprechen, aber es gelingt Dir "
          +"nicht."));
          zeit=5;
          break;
   case 14: TR(BS("Cailleac'h beginnt mit sanfter Stimme zu sprechen: "
          +"\"Ich weiss wer Du bist, "+spielername+". Ich habe Deinen "
          +"Weg hierher verfolgt.\""));
          zeit=5;
          break;
   case 15: TR(BS("Cailleac'h sagt: \"Ich weiss auch, warum "
          +"Du hier bist, "+spielername+". Du bist auf der Suche "
          +"nach der Harfe der Winde.\""));
          zeit=5;
          break;
   case 16: TR(BS("Uups ... Woher weiss sie das? Naja, Du wirst sie "
          +"schon ueberzeugen koennen...\n"));
          zeit=5;
          break;
   case 17: TR(BS("Cailleac'h faehrt fort: \"Nun, wisse, dieses "
          +"ueberaus maechtige Artefakt wuerde in den falschen "
          +"Haenden schreckliches bewirken. An Deinem Stirnmal "
          +"erkenne ich, dass Du die Gefahren der Steinstadt "
          +"gemeistert hast.\""));
          zeit=6;
          break;
   case 18: TR(BS("Cailleac'h sagt: \"Ich weiss, Du hast viele "
          +"Strapazen hinter Dir, und ich weiss auch, dass "
          +"Du viel riskiert hast, um bis hierher zu kommen. "
          +"Bedenke jedoch, dass die Harfe hier am Sicherten "
          +"aufgehoben ist.\""));
          zeit=5;
          break;
   case 19: TR(BS("Cailleac'h erklaert weiter: \"Hoere nun, "
          +"Sterblicher, ich kann Dich nicht aufhalten, da "
          +"Du das Brandmal traegst, aber sei Dir im Klaren "
          +"darueber, dass Du damit die Welt in Gefahr bringst. "
          +"Geh ohne die Harfe und ich biete Dir als "
          +"Entschaedigung 20000 Muenzen.\""));
          frage=1;
          sequenz++;
          break;
   case 20: TR(BS("Cailleac'h :\"Nun, vielleicht 40000 Muenzen?\""));
          sequenz++;
          break;
   
   case 21: TR(BS("Cailleac'h sagt: \"Mein letztes Angbot: 50000 "
          +"Muenzen und eine maechtige Waffe, das Blitzschwert.\""));   
          sequenz++;
          break;
   case 22: TR(BS("Cailleac'h fluestert: So sei es...\""));
          sequenz++;
          break;
  }

 if(sequenz==5)
  {
     call_out("sequenz_part_two", 2);
     return;
   }
 
 if (sequenz && !annahme && !frage)
   {
     call_out("sequenz_part_one", zeit);
     return;
   }
 if(annahme && frage)
   {
    call_out("sequenz_part_two", 3);
    return;
   }
 write(BS("Nimmst Du an? (Antworte mit ja oder nein.): ")); 
 input_to("question");
 return; 
} 


question(string str)
{
 if (str=="nein")
   {
    annahme=0;
    call_out("sequenz_part_one", 1);
    return ;
   }
 part_one=21;
 annahme=1; 
 call_out("sequenz_part_one", 1);
 return;    
}


sequenz_part_two()
{
 object ob, ob1;
 int q;
 frage=0;
 if(ob=present("\nlaehmung", TP))
      ob->remove();
 if(ob=present(B_MAL, TP))
      ob->remove();
 if(ob=present(W_Q_ITEM, TP))
      ob->remove();
 ob=CLONEOB("/obj/money");
 switch(sequenz)
   {
   case 2: ob->SetProp(P_AMOUNT, 20000);
           call_other(QUESTMASTER, "ForbidQuest", spieler, 
                      spieler->QueryProp(P_AGE));
           break;
   case 3: ob->SetProp(P_AMOUNT, 40000);
           QUESTMASTER->ForbidQuest(spieler, spieler->QueryProp(P_AGE)); 
           break;
   case 4: ob->SetProp(P_AMOUNT, 50000);
           QUESTMASTER->ForbidQuest(spieler, spieler->QueryProp(P_AGE));
           ob1=CLONEOB(WEAP("blitzschwert"));
           break;
   case 5: ob=CLONEOB(WEAP("harfe"));
           ob->move(TP, M_NOCHECK);
           q = TP->GiveQuest(WIND_QUEST);
           if (q == 1)
            {
              write_file (WIND_LOG,
               sprintf ("%s  %s hat die Harfe der Winde gefunden.\n",
               dtime(time()), capitalize(TP->query_real_name())));
            }
          else
            if (q != -1)
              return
                 write (sprintf("Unbekannter Fehler, bitte den "
                   +"zustaendigen Magier verstaendigen!"
                  +"\nFehlercode: %d\n", q)), 1;
           break;
   }
 if(ob)
    ob->move(WALD("wald_g2"), M_NOCHECK);
 if(ob1)
    ob1->move(WALD("wald_g2"), M_NOCHECK);
 spieler->move(WALD("wald_g2"), M_TPORT);
 return ;
}
             













