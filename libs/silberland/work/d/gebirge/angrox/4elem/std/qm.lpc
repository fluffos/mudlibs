#include "../4elem.h"

mixed saveload;
nosave mapping forbid=([ ]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
  if (restore_object(QUESTMASTERLOG))
     forbid=saveload;
}


int ForbidQuest(object pl, int age)
{
  forbid+=([getuid(pl):age]);
  saveload=forbid;
  save_object(QUESTMASTERLOG);
  saveload=0;
  return 1;
}

int AllowQuest(object pl, int age)
{ 
  if (member(forbid, getuid(pl))) {
    if (forbid[getuid(pl)] > age)
      return 0;
    forbid=m_delete(forbid, getuid(pl));
    saveload=forbid;
    save_object(QUESTMASTERLOG);
    saveload=0;
  }
  return 1;
}

query_prevent_shadow() { return 1; }
