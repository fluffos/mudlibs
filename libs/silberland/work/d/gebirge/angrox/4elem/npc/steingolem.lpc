// /d/gebirge/angrox/<gebiet>/npc/   
// 
// Angrox Zauberwerkstatt
//
// Ein Steingolem der Steinstadt
// 27-10-1996  
//
// Updates: 
//

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../4elem.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steingolem");
  SetProp(P_LONG, BS(
    "Der Steingolem ist eine drei Schritt hohe Steinstatue, die durch Magie "
   +"zum Leben erweckt wurde. Kalte, leblose Augen starren auf Dich herab, und "
   +"bist Dir sicher, dass der Golem im Kampf keine Gnade kennt"));

  AddDetail("augen", "Die Augen des Golems sind leer, kalt, leblos.");
  SetProp(P_NAME, "Steingolem");
  SetProp(P_GENDER, MALE);
  AddId(({"golem", "steingolem"}));
 

  create_default_npc(16);
  // P_LEVEL   = 16
  // P_SP/P_HP = x*8+42        =170
  // P_HANDS   = x*10          =160 
  // P_BODY    = x*20/3        =106  
  // P_XP      = HP*HANDS*50   = 136000  // 1/100 davon als Killbonus
  SetAttribute(A_STR, 30);
  SetAttribute(A_DEX, 25);
  SetProp(P_HANDS, ({"mit steinernen Faeusten",160,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 300); 
  SetProp(P_HP, 300);
  SetProp(P_BODY, 160);
  SetProp(P_XP, QueryProp(P_XP)+10*100); // Bonus fuer Spells
  SetProp(P_RACE, "golem");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,-1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({PHYSICAL_DAMAGE_TYPES })); 
  SetProp(P_VULNERABILITY, ({ DT_AIR }));
  SetProp(P_NOMAGIC,0);
  
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stapft weiter");
  SetProp(P_MMSGIN, "waechst aus der Erde");
  SetProp(P_MMSGOUT, "versinkt im Boden");
  SetProp(P_MNPC_AREA, STADT("stadt"));
  SetProp(P_MNPC_WAIT, ({ 5, 10, 5 }));
  SetProp(P_MNPC_DEFAULTROOM, STADT("stadt_g8"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
                   
  SetProp(P_DIE_MSG,  " zerbricht in 1000 Stuecke.\n");
  SetProp(P_NOCORPSE, 1 );
  //SetProp(P_MURDER_MSG, "I");
  SetProp(P_KILL_NAME, "Ein Steingolem");
  SetProp(P_KILL_MSG, "Ich hab Dich!");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich.\n");
  //SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Golem laesst Deine Sachen fallen.\n" }) );

  SetProp(P_SPELLRATE,7);
  AddSpell(1,400,
    "Der Steingolem vernichtet Dich mit einem einzigen Schlag.\n",
    "Der Steingolem vernichtet @WEN mit einem einzigen Schlag.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,800,
    "Der Steingolem stampft Dich in Grund und Boden.\n",
    "Der Steingolem stampft @WEN in Grund und Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200,
    "Der Steingolem zermalmt Dich zwischen seinen Fingern.\n",
    "Der Steingolem zermalmt @WEN zwischen seinen Fingern.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
  "Der Steingolem stapft im Raum umher.\n", 
  "Der Steingolem starrt Dich an.\n", 
  "Der Steingolem verharrt regungslos.\n"}) );

  SUID;
  CLONEME(WEAP("steinkeule"));
  command("zuecke steinkeule");
  CLONEME(ARMO("steinpanzer"));
  command("trage alles");

}

init()
{
  call_out("getit", 0);
  ::init();
}


getit()
{
 command_me("nimm alles");
}


varargs void die( int poisondeath ) {
    object ob,pl;
    pl=QueryProp(P_KILLER);
    if(!random(20) && pl && pl->QueryProp(P_GUILD)=="druidenzirkel") {
      ob=clone_object("/gilden/druidenzirkel/obj/elementarsphaere");
      ob->init_sphere("erz");
      ob->move(ME, M_NOCHECK);
    }
    return ::die(poisondeath);
}


