inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../4elem.h"



create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Steinspinne");
  SetProp(P_LONG, BS("Die Steinspinne ist ein Wesen, welches vollkommen "
           +"aus Stein besteht. Sie krabbelt erstaunlich leichtfuessig "
           +"mit ihren Steinfuesschen umher.\n"));
   
  SetProp(P_NAME,"Steinspinne");
  AddId(({"spinne", "steinspinne"}));
  SetProp(P_GENDER, FEMALE);
  set_living_name("steinspinne");
  create_default_npc(12);
  // P_LEVEL   = 10
  // P_SP/P_HP = 10*8+42   = 122
  // P_HANDS   = 10*10     = 100
  // P_BODY    = 10*20/3   = 66
  // P_XP      = 162*10*50 = 81000  // 1/100 davon als Killbonus
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HANDS, ({" mit Steinzangen", 100}));
  SetProp(P_BODY, 120);
  SetProp(P_ALIGN, 20);
  SetProp(P_SIZE, 40);
  SetProp(P_RACE, "Spinne");
  
 
  SetProp(P_RESISTANCE, ({DT_COLD, DT_PIERCE}));
  SetProp(P_VULNERABILITY, ({DT_AIR}));
  SetProp(P_NOCORPSE, 1);
  SetProp( P_REJECT, ({ REJECT_DROP, "Die Spinne beachtet es nicht.\n" }) );
  SetProp( P_DIE_MSG, " zerfaellt zu Steinbroeckchen.\n");
  
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "klappert hinaus");
  SetProp(P_MSGOUT, "krabbelt");

  SetChats(3, ({
    "Die Spinne knabbert am Felsen.\n",
    "Die Spinne krabbelt unruhig umher.\n"}) );

  SetProp(P_SPELLRATE, 20);
  AddSpell(1,250,
	" Die Spinne beisst Dich in eine ungeschuetzte Stelle.\n",
	" Die Spinne beisst @WEN in eine ungeschuetzte Stelle.\n",
          DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,200, 
        " Die Spinne schleudert Dir ein Steinnetz ins Gesicht.\n", 
        " Die Spinne schleudert Dir ein Steinnetz ins Gesicht.\n",
          DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetProp(P_MNPC_AREA, HOEHLE("hoehle"));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, HOEHLE("hoehle_l9"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
}

varargs void die( int poisondeath ) {
    object ob,pl;
    pl=QueryProp(P_KILLER);
    if(!random(40) && pl && pl->QueryProp(P_GUILD)=="druidenzirkel") {
      ob=clone_object("/gilden/druidenzirkel/obj/elementarsphaere");
      ob->init_sphere("erz");
      ob->move(ME, M_NOCHECK);
    }
    return ::die(poisondeath);
}

