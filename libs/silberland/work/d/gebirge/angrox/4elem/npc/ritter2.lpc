string AttackBlast()
{
 object en;
 if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Soordhin vernichtet "
      + capitalize(en->name()) + " ohne Gnade."), ({en}));
    tell_object(en, "Soordhin vernichtet Dich ohne Gnade.\n");
    en->Defend(500+random(300), DT_SLASH,
        ([SP_NAME:"Blast", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

nosave int RandomizeResistances() {
  // Physischer Schaden
  AddRes(DT_SLASH, -1.2+(random(8)/10.0));
  AddRes(DT_BLUDGEON, -1.2+(random(8)/10.0));
  AddRes(DT_PIERCE, -1.2+(random(8)/10.0));
  AddRes(DT_SQUEEZE, -1.2+(random(8)/10.0));
  AddRes(DT_WHIP, -1.2+(random(8)/10.0));
  AddRes(DT_RIP, -1.2+(random(8)/10.0));
  AddRes(DT_SQUEEZE, -1.2+(random(8)/10.0));
  // Magischer Schaden
  AddRes(DT_MIND, -1.2+(random(5)/10.0));
  AddRes(DT_STONE,-1.2+(random(6)/10.0));
  AddRes(DT_COLD, -0.8+(random(8)/10.0));
  AddRes(DT_FIRE, -0.2+(random(5)/10.0));
  AddRes(DT_WATER, -0.2+(random(5)/10.0));
  AddRes(DT_AIR, (random(5)/10.0));
  AddRes(DT_LIGHTNING, -0.3+(random(5)/10.0));
  AddRes(DT_EXPLOSION, (random(5)/10.0));
  AddRes(DT_SOUND, (random(3)/10.0));
  AddRes(DT_LIGHT, -0.5+(random(5)/10.0));
  AddRes(DT_ELECTRIC, (random(5)/10.0));
  AddRes(DT_ACID, (random(5)/10.0));
  AddRes(DT_ELECTRIC, (random(5)/10.0));
  AddRes(DT_POISON, -1.1+(random(5)/10.0));
  AddRes(DT_TERROR, 0.1+(random(3)/10.0));
  AddRes(DT_HOLY, 0.1+(random(3)/10.0));
  AddRes(DT_UNHOLY, 0.1+(random(3)/10.0));
  AddRes(DT_MAGIC, 0.1+(random(3)/10.0));
}
