// /d/gebirge/angrox/4elem/npc/anvar.c   
// Anvar, das "Questorakel" der 4elem - quest 
// 27-10-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../4elem.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Anvar, der Druide");
  SetProp(P_LONG, BS(
    "Anvar ist eine grosse, hagere Gestalt, dessen Gesicht hinter der "
   +"Kapuze seines grauen Mantels versteckt ist. Er strahlt eine "
   +"innere Ruhe aus, der Du Dich nicht entziehen kannst. Er traegt "
   +"einen langen Stab bei sich, auf welchen er sich stuetzt."));
  AddDetail("mantel", "Der Graue Kapuzenmantel laesst Anvar unheimlich "
   +"wirken...");
 
   SetProp(P_NAME, "Anvar");
  SetProp(P_GENDER, MALE);
  AddId(({"anvar", "druide", "anvar"}));
  set_living_name("anvar");

  create_default_npc(100);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({"mit blossen Haenden",300,DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,100);
  SetProp(P_NOATTACK, BS("ignoriert Deinen Angriff. Du triffst ihn zwar, "
          +"kannst ihn aber nicht verletzen. Anvar blickt Dich traurig "
          +"an..."));
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Anvar");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, 
       ({"blickt Dich traurig an...\n", 
         "scheint Dich zu ignorieren.\n",
         "gruebelt vor sich hin.\n",
         "spricht: Das Gleichgewicht der Elemente ist in Gefahr.\n",  
         "sagt: Darueber weiss ich nichts.\n"}));
  AddInfo(({"angrox", "creative"}), 
         "Creative und Angrox haben mich erschaffen.", "sagt: ");
  AddInfo(({"druide", "druiden"}), 
         "Die Druiden sind die Weisen des Waldes. Wir versuchen "
        +"die Natur und ihre Elemente zu verstehen und mit ihr "
        +"im Einklang zu leben.", "belehrt Dich: ");
  AddInfo(({"wald", "waelder"}), 
         "Die Waelder sind die Zuflucht derer, die mit der Natur "
        +"in Einklang leben.", "erklaert: ");
  AddInfo("woody", 
         "Woody ... ja, hier im Wald ist man Woody sehr nahe.", "spricht: ");
  AddInfo("feyaria", 
         "Feyaria ... eine Erzmagierin, oder? Sehr maechtig. Sehr weise.", "schaetzt: ");
  AddInfo("eros", 
         "Eros ist einer der Herren ueber das Element Erz ... repraesentiert durch seine "
          +"Herrschaft im Gebirge.", "sagt: ");   
  AddInfo("natur", 
         "Die Natur lehrt uns Vieles, auch die Beherrschung der "
        +"Elemente feallt darunter.", "sagt: ");       
  AddInfo("elemente", 
         "Dero Elemente gibt es sechs: Luft, Feuer, Erz, Wasser, Humus "
        +"und Eis. Leider ist das Gleichgewicht der "
        +"Elemente gestoert.", "spricht ernst: ");
  AddInfo("beherrschung", 
         "Die Beherrschung der Elemente liegt in der Beschwoerung von "
        +"minderen Elementargeistern und Dschinnen.", "belehrt Dich: ");
  AddInfo("beschwoerung",   
         "Die Beschwoerung der Elemente ist ein gefaehrliches Unterfangen, "
        +"nichtsdesdotrotz wird sich hier bald ein Druidenzirkel "
        +"ansiedeln.", "sagt: ");
  AddInfo("druidenzirkel", 
         "Bald, sehr bald ...", "orakelt: ");
  AddInfo("elementargeister", 
         "Die Elementargeister koennen niedere Dienste verrichten "
        +"und verfuegen natuerlich ueber die Faehigkeiten ihres "
        +"Elementes.", "spricht: ");  
  AddInfo("dschinnen", 
         "Dschinne sind sehr maechtig. Sie koennen ueber einen "
        +"gewissen Zeitraum dienen.");
  AddInfo("feuer", 
         "Feuer ist ein maechtiges Element und der Gegensatz "
        +"zu Wasser. Seine primaere "
        +"Eigenschaft ist Waerme.", "spricht: ");
  AddInfo("luft", 
         "Luft ist das Element, dass uns alle umgibt. Seine primaeren "
        +"Eigenschaften sind Fluechtigkeit und Bewegung. Das "
        +"Komplementaerelement zu Luft ist Erz.", "sagt: ");
  AddInfo("erz",
         "Erz ist die Schwere als primaere Eigenschaft zugeordnet. "
        +"Das Gegensaetzliche Element zu Erz ist Luft. ", "erklaert Dir: ");
  AddInfo("wasser", 
         "Dem Wasser wird als primaere Eigenschaft die Heilung "
         +"zugesprochen, der Gegensatz dazu ist das Feuer.", "sagt: ");
  AddInfo("humus", 
         "Fuer manche, wie fuer mich, ist Humus eines der wichtigsten "
        +"Elemente, denn es repraesentiert das Leben als "
        +"primaere Eigenschaft. Dem Humus entgegengsetzt ist das "
        +"Eis.", "spricht: ");          
  AddInfo("eis", 
         "Die primaere Eigenschaft von Eis ist die Kaelte. Einige "
        +"behaupten, das Eis waere der Feind jeglichen Lebens, "
        +"und somit dem Stillstand und dem Tod zugeordnet. Der "
        +"Gegensatz zu Eis ist Humus.", "sagt: "); 
  AddInfo("gleichgewicht", 
         "Das Gleichgewicht der Elemente Feuer, Wasser, Wind und "
        +"Humus ist gestoert. Einige maechtige Artefakte, in die "
        +"die Macht der Elemente verankert wurden, werden "
        +"benoetigt, um das Gleichgewicht wieder herzustellen.", 
         "spricht ernst: ");
  AddInfo("artefakte", 
         "Die Artefakte wurden einst geschaffen, um den Missbrauch "
        +"der Kraft, die heute als Magie bekannt ist, zu verhindern. "
        +"Wenn der Missbrauch durch skrupellose Magiebegabte "
        +"ueberhand nimmt, so wird die Welt vernichtet werden.", "sagt: ");
  AddInfo("missbrauch", 
         "Ich fuerchte, das Schreckliche ist eingetreten, und es ist "
        +"nur mehr eine Frage der Zeit, bis der prophezeite Untergang "
        +"stattfindet. Nur mit der Hilfe der Artefakte ist es moeglich, "
        +"das Chaos zu stoppen...wenn diese mit Hilfe eines "
        +"Mutigen gefunden werden.", "fluestert: " );
  AddInfo("untergang", 
         "Die Welt wird nicht dann nicht mehr so existieren, wie wir "
        +"sie kennen. Das Chaos wird ueberall sein, und keiner kann "
        +"dem Boesen dann noch entkommen.", "sagt: ");
  AddInfo(({"chaos", "boesem"}), 
          "Wenn erst das Chaos die Ueberhand gewinnt, dann ist die "
         +"Welt verloren.", "erklaert: ");
  AddInfo("welt", 
          "Die Welt, in der wir leben, wird von vielen Kraeften "
         +"kontrolliert. Eine davon ist die Kraft der Elemente.", 
          "erklaert: ");
  AddInfo("magiebegabte", 
          "Alle Rassen sind heute in der Lage, die Magier nach ihren "
         +"Wuenschen zu benutzen.", "sagt: ");
  AddInfo("rassen", 
          "Ja, alle Rassen.", "sagt: ");
  AddInfo("hilfe", 
         "Hmmm ... Du wuerdest mit helfen? Nun, wenn Du mir wirklich "
        +"Deine Hilfe anbietest, dann bedenke, dass dies eine Quest "
        +"von grossem Ausmass sein wird.", "erlaeutert: ");
  AddInfo("quest",  
          "@@queste@@", "sagt: ", "Anvar erzaehlt etwas, das Du "
         +"nicht verstehen kannst.\n"); 
  AddInfo(({"kelch", "schwert", "stab"}), 
          "Darueber muss ich erst Informationen sammeln. Komme "
         +"zu einem spaetern Zeitpunkt wieder.", "meint: ");
  AddInfo("harfe", "@@harfen_info@@", "sagt: ", "Anvar spricht leise, "
          +"sodass Du ihn nicht verstehst.\n");  
  AddInfo("hueterin", 
          "Es heisst, sie ist sehr gerissen!", "warnt Dich: ");
  SetProp(P_LOG_INFO, "anvar.fragen.qst");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Anvar sagt: Behalte Deine Sachen.\n" }) );
}

string queste()
{
 object ob;
 if(!present(W_Q_ITEM, TP) && !(TP->QueryQuest(WIND_QUEST)))
   {
     ob=CLONEOB(OBJ2("windquest"));
     ob->move(TP, M_NOCHECK);
     return "Gut, mein Freund, so hoere. Vier Artefakte wurden einst "
       +"geschaffen, um die prophezeite Katastrophe abzuwenden: "
       +"Die Harfe der Winde, der Kelch des Wassers, das Schwert "
       +"des Feuers und der Stab der Erde. Diese Artefakte "
       +"wurden gut versteckt, und nur die Tapfersten, Mutigsten und "
       +"Kluegsten koennen diese Artefakte bergen. Nun, Deine "
       +"Aufgabe besteht nun darin, die Harfe der Winde zu suchen. "
       +"Die Legenden berichten, dass sie in einer sagenhaften "
       +"unterirdischem Steinwald verborgen ist, der sich irgendwo im "
       +"Gebirge befindet und von einer "
       +"Hueterin bewacht wird. Finde diese Harfe und kehre mit ihr "
       +"zurueck. Den richtigen Ort, wo dieser Wald zu finden ist, erkennst "
       +"Du an Versteinerungen in der Pflanzenwelt. "
       +"Ich muss erst die Verstecke der anderen Artefakte "
       +"lokalisieren, ich hoffe jedoch, sie bald zu erfahren."; 
   }
 if(present(W_Q_ITEM, TP))
   {
    return "Du hilfst mir bereits.";
   }
 if(!present(SW_Q_ITEM) && TP->QueryQuest(WIND_QUEST));
   {
    return "Sehr gut! Leider weiss ich den Aufenthalt des "
          +"Stabes der Erde noch nicht. Komm spaeter nocheinmal "
          +"vorbei.";
   }
 
}

string harfen_info()
{
  if(!present(W_Q_ITEM, TP))
     return "Darueber kann ich Dir nichts sagen!!!!";
  return "Die Harfe der Winde liegt wird von einer Hueterin "
        +"bewacht. Pass gut auf, auf dass sie Dich nicht "
        +"verfuehrt!";
}

