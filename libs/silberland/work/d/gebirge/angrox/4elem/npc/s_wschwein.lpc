inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../4elem.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinwildschwein");
  SetProp(P_LONG, BS(
    "Ein gefaehrlich wirkendes Steinwildschwein. Es schnaubt Dich an."));
  SetProp(P_NAME, "Steinwildschwein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schwein", "wildschwein", "steinwildschwein"}));

  create_default_npc(17);
  // P_LEVEL   = 15
  // P_SP/P_HP = 15*8+42        =~160
  // P_HANDS   = 15*10          =150 
  // P_BODY    = 15*20/3        =~80
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({"mit scharfen Steineckzaehnen",300,DT_BLUDGEON}));
  SetProp(P_BODY, 80);
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "wildschwein");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,-4);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({PHYSICAL_DAMAGE_TYPES})); 
  SetProp(P_VULNERABILITY, ({ DT_MAGIC, DT_AIR }));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "schnueffelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, WALD("wald"));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, WALD("wald_h3"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Verwandten im Silberwald sagen immer, "
                      +"dass ihnen bei Thor so etwas nicht passiert.");
  SetProp(P_KILL_NAME, "Steinwildschwein");
  SetProp(P_KILL_MSG, "Hmm ... bist Du mit Thor verwandt?");

  AddInfo(DEFAULT_INFO, "grunzt Dich an.\n");
 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Steinwildschwein will Deine Sachen nicht tragen.\n" }) );

 
}


varargs void die( int poisondeath ) {
    object ob,pl;
    pl=QueryProp(P_KILLER);
    if(!random(20) && pl && pl->QueryProp(P_GUILD)=="druidenzirkel") {
      ob=clone_object("/gilden/druidenzirkel/obj/elementarsphaere");
      ob->init_sphere("erz");
      ob->move(ME, M_NOCHECK);
    }
    return ::die(poisondeath);
}

