// /d/gebirge/angrox/4elem/npc/gargyl.c   
//
//
// 04-03-1996  Angrox@SilberLand
//
// Ein Gargyl der Steinkathedrale 
//
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../4elem.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gargyl");
  SetProp(P_LONG, BS(
    "Der Gargyl ist ein steinernes Ungeheuer. Es sieht "
   +"aus wie eine riesige Fledermaus mit scharfen Krallen "
   +"an den Fluegeln."));

  AddDetail("fluegel", "Die Fluegel sind gross und wuchtig.");
  AddDetail("krallen", "Die Krallen sehen sehr gefaehrlich aus.");
     
  SetProp(P_NAME, "Gargyl");
  SetProp(P_GENDER, MALE);
  AddId("gargyl");
 

  create_default_npc(15+random(4));
  // P_LEVEL   = 17
  // P_SP/P_HP = 10+lvl*lvl   = 159+random 
  // P_HANDS   = x*10         = 170
  // P_BODY    = x*4          = 68 -> da aus stein >100
  // P_XP      = HP*HANDS*5   = 151300  // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit scharfen Krallen",200,DT_RIP}));
  
  SetProp(P_MAX_HP, 200);
  SetProp(P_BODY, 130);
  SetProp(P_XP, QueryProp(P_XP)+6*100); // Bonus fuer Spells
  SetProp(P_RACE, "gargyl");
  SetAttribute(A_DEX, 20);
  SetAttribute(A_STR, 25);
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_SLASH, DT_TERROR, DT_POISON, DT_AIR })); 
  SetProp(P_VULNERABILITY, ({ DT_COLD }));
  SetProp(P_NOMAGIC,2);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "huepft aus der Steinsaeule");
  SetProp(P_MMSGOUT, "erstarrt zu Stein");

  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich erwische Dich beim naechsten Mal!");
  SetProp(P_KILL_NAME, "Ein Gargyl");
 

  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Gargyl laesst es fallen.\n" }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(6,300,
    "Der Gargyl zerfetzt Dein Gesicht.\n",
    "Der Gargyl zerfetzt @WESSEN Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(6,300,
    "Der Gargyl wirft Dich zu Boden.\n",
    "Der Gargyl wirft @WEN zu Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200,
    "Der Gargyl beisst Dich voller Hass.\n",
    "Der Gargyl beisst @WEN voller Hass.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,500,
    "Der Gargyl zerfetzt Dich.\n",
    "Der Gargyl zerfetzt @WEN.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  

  SUID;
  if(!random(3))
    CLONEME(WEAP("gargylkralle" ));
   
}


varargs void die( int poisondeath ) {
    object ob,pl;
    pl=QueryProp(P_KILLER);
    if(!random(40) && pl && pl->QueryProp(P_GUILD)=="druidenzirkel") {
      ob=clone_object("/gilden/druidenzirkel/obj/elementarsphaere");
      ob->init_sphere("erz");
      ob->move(ME, M_NOCHECK);
    }
    return ::die(poisondeath);
}

