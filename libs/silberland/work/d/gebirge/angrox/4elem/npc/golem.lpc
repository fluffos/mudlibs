//inherit "std/npc";
inherit "std/inpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include <inpc.h>
#include "../4elem.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Waechtergolem");
  SetProp(P_LONG, BS(
    "Der Golem besteht vollkommen aus grauem Fels, ist zwei Schritt "
   +"gross und wirkt mit seinem bulligen Aussehen bedrohlich. Seine Augen "
   +"gluehen in einem unheimlichen roten Licht.")); 

  AddDetail("augen", "Die Augen des Golems gluehen in einem "
           +"unheimlichen roten Licht ...");

  AddDetail("licht", "Die Augen des Golems gluehen in roten "
           +"Licht ... es wirkt unheimlich ... SEHR unheimlich!");



  SetProp(P_NAME, "Waechtergolem");
  SetProp(P_GENDER, MALE);
  AddId(({"golem", "waechtergolem"}));
  set_living_name("waechtergolem");

  create_default_npc(25,300);
  // P_LEVEL   = 25
  // P_SP/P_HP = x*8+42        =242 -> 500
  // P_HANDS   = x*10          =250 -> 250
  // P_BODY    = x*20/3        =160 -> 170 
  // P_XP      = HP*HANDS*5    =~450000   // 1/100 davon als Killbonus
  SetAttribute(A_STR, 35);
  SetAttribute(A_DEX, 25);
  SetProp(P_HANDS, ({" mit steinernen Faeusten",200,DT_BLUDGEON}));
  SetProp(P_BODY, 100);
  SetProp(P_XP, 0);
  SetProp(P_RACE, "golem");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,-4);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_SLASH, DT_POISON, DT_TERROR, DT_LIGHT, 
                           DT_PIERCE })); 
  SetProp(P_VULNERABILITY, ({ DT_AIR, DT_ACID, DT_MAGIC}));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stapft weiter");
  SetProp(P_MMSGIN, "waechst aus der Erde");
  SetProp(P_MMSGOUT, "versinkt im Boden");
  
                     
  SetProp(P_DIE_MSG, " faellt in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meister! Ich habe versagt!");
  SetProp(P_KILL_NAME, "Ein Waechtergolem");
  SetProp(P_KILL_MSG, "Meister, ich habe Deine Befehle befolgt!");

  AddInfo(DEFAULT_INFO, "starrt Dich mit rotgluehenden Augen an.\n");
  //SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Waechtergolem laesst Deine Sachen fallen.\n" }) );

  SetProp(P_SPELLRATE,15);

  AddSpell(4,300,
    "Der Waechtergolem vernichtet Dich mit einem einzigen Schlag.\n",
    "Der Waechtergolem vernichtet @WEN mit einem einzigen Schlag.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(6,200,
    "Der Waechtergolem stampft Dich in Grund und Boden.\n",
    "Der Waechtergolem stampft @WEN in Grund und Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(6,300,
    "Der Waechtergolem zermalmt Dich zwischen seinen Fingern.\n",
    "Der Waechtergolem zermalmt @WEN zwischen seinen Fingern.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400, 
    "Eine Feuerlanze aus den Augen des Golems streckt Dich nieder.\n",
    "Eine Feuerlanze aus den Augen des Golems streckt @WEN nieder.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1])); 

AddSpell(1,400, 
    "Der Waechtergolem zerblaest Deine Ruestung!\n",
    "Der Waechtergolem zerblaest @WESSEN Ruestung!\n",
     DT_BLUDGEON, "spell_armour");


  SetChats(3, ({
  "Der Waechtergolem beobachtet Dich.\n", 
  "Der Waechtergolem knirscht mit seinen Zaehnen.\n", 
  "Der Waechtergolem verharrt regungslos.\n"}) );


  AddWeapon("zweihaender", WEAP("stein2haender"));
  AddArmour("panzer", ARMO("steinpanzer"));
  AddArmour("steinhelm", ARMO("steinhelm"));
}


void spell_armour(object enemy, int damage, mixed dam_type)
{
 int groesse;
 object* ob;
 ob=enemy->QueryProp(P_ARMOURS);
 groesse=sizeof(ob);
 if(groesse)
    ob[random(groesse)]->remove();
 
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 command("nimm waffen aus leiche");
 command("zuecke_beste_waffe");
 command("nimm ruestungen aus leiche");
 command("trage_beste_ruestungen");
}

varargs void die( int poisondeath ) {
  object ob,pl;
  pl=QueryProp(P_KILLER);
  if(!random(20) && pl && pl->QueryProp(P_GUILD)=="druidenzirkel") {
    ob=clone_object("/gilden/druidenzirkel/obj/elementarsphaere");
    ob->init_sphere("erz"); 
    ob->move(ME, M_NOCHECK);
  }
  return ::die(poisondeath);
}
