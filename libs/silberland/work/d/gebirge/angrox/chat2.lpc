/*
**
** Angrox Zauberwerkstatt
** 06.06.1996 by Angrox@Silberland
** 
*/                            

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "/d/gebirge/angrox/files.h"
int allowed=0;
string *owners=({"angrox", "clementine"});

void create()
{
  string WIZNAME;

  ::create();
  WIZNAME = capitalize(getuid(this_object()));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In der Schwerelosigkeit des Seins");
  SetProp( P_INT_LONG,	  
      "Du schwebst hier in einem Spiel aus Licht und Schatten. Obwohl "
      +"Du jegliche Orientierung verloren hast, hast Du keine Angst "
      +"hier zu sein. Alle Schwere scheint von deinem physischen Sein "
      +"zu schwinden, hier kannst Du Dich auf Dein Innerstes - auf Dein "
      +"Ich, Deine Gefuehle und Deine Gedanken - konzentrieren.");
      /*
      "Du bist hier in der Einsamkeit. Die Kaelte kriecht bis in den "
      +"letzten Deiner Knochen. Alles hier ist Grau. "
      +"Es ist totenstill, nur Deine eigenen Gedanken sind zu hoeren "
      +"und quaelen Dich mit Erinnerungen. "
      "Und vor allem,");
      */
  
//  AddExit("gilde","in die Gilde#/gilden/abenteurer");
//  AddExit("osten","in das Schlafzimmer#/players/angrox/bedroom.lpc");
//  AddExit("unten","in das Testgebiet#/players/woody/room/test_a4");
//  AddExit("westen", "in den Portalraum#/players/angrox/portal.lpc");
  AddCmd("gilde", "gilde");
  AddCmd("lock", "lock");
  AddCmd("unlock", "unlock");
  AddCmd("door", "room_status");
}

int gilde()
{
 TP->move("/gilden/druidenzirkel", M_TPORT);
 return 1;
}


void init()
{
  object pl;
  ::init();
  if (this_interactive() || previous_object())
    if (getuid(TP)!="angrox" && getuid(TP)!="clementine")
      if (!allowed) {
          tell_object(TP, "Du darfst diesen Raum nicht"
                      +" betreten.\n");

          TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_GO|M_SILENT|M_NO_SHOW);
          if (pl=find_player("angrox"))
            tell_object(pl, CAP(getuid(TP))+" wollte Chat betreten.\n");
        }
      else {
        if (pl=find_player("angrox"))
          if (!present("angrox"))
           tell_object(pl, CAP(getuid(TP))+" betrat Chat.\n");
        if (pl=find_player("clementine"))
          if (!present("clementine"))
           tell_object(pl, CAP(getuid(TP))+" betrat Chat.\n");
      }
}


int room_status()
{
 if(!allowed) {
   write(BS("Der Raum ist locked.\n"));
 }
 else write(BS("Der Raum ist unlocked.\n"));
 return 1;
}


int lock()
{
  if (getuid(TP)=="angrox" ||
      getuid(TP)=="clementine")  {
    allowed=0;
    write("Locked.\n");
    say(TPN+" locked den Raum.\n");
    return 1;
  }
  return 0;
}

int unlock()
{
  if (getuid(TP)=="angrox" ||
      getuid(TP)=="clementine") {
    allowed=1;
    write("Unlocked.\n");
    say(TPN+" unlocked den Raum.\n");
    return 1;
  }
  return 0;
}

