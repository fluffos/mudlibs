//
// Ok, das ist mein Ruheraum im SL, und ich dokumentier ihn ein 
// bisschen fuer dich!
//


inherit "std/room"; // Das inherit vererbt diesem Objekt hier alle Klassen aus 
                    // dem Objekt std/room, also alle wichitge Funktionen fuer
                    // einen Raum.

#include <properties.h> // headerdateien, die in sys/ stehen, werden mit < > 
                        // miteingebunden...
#include <moving.h>
#include "./files.h"    // ... eigene mit " " und  Pfadangabe.

// Nun werden ein paar globale Variablen definiert. Diese koennen von 
// jeder Funktion in diesem File veraendert werden. Die Variablen koennen
// auch gleich initisaliesiert werden.
int allowed=1;
string *owners=({"angrox", "eve"});

// Create ist die Hauptfunktion, mit der der Raum erzeugt wird. In einem Raum
// wird die Funktion ueberschrieben, damit wir ihn auf unsere Beduerfnisse 
// anpassen koennen.
void create()
{
  ::create(); 
  SetProp( P_LIGHT, 1 ); // Es ist hell
  SetProp( P_INT_SHORT, "In der Schwerelosigkeit des Seins"); //Kurzbeschr.
  SetProp( P_INT_LONG,	  //Langbeschr.
      "Du schwebst hier in einem Spiel aus Licht und Schatten. Obwohl "
      +"Du jegliche Orientierung verloren hast, hast Du keine Angst "
      +"hier zu sein. Alle Schwere scheint von deinem physischen Sein "
      +"zu schwinden, hier kannst Du Dich auf Dein Innerstes - auf Dein "
      +"Ich, Deine Gefuehle und Deine gedanken - konzentrieren.");
  // und ein paar Kommandos :)
  AddCmd("gilde", "gilde");
  AddCmd("lock", "lock");
  AddCmd("unlock", "unlock");
  AddCmd("door", "room_status"); // Wenn ein Spieler "door" eingibt, wird die
                                // Funktion "room_status" ausgefuehrt
}

// Hier nun beginnen die Unterfunktionen
int gilde()
{
 TP->move("/gilden/druidenzirkel", M_TPORT); // TP=this_player() wird in den 
                                             // Druidenzirkel gemovt
 return 1;
}


void init()
{
  object pl;
  int i;
  ::init();
  if(this_interactive() || previous_object()) { // Hier wird abgefragt, ob
       // das ausloesende objekt ueberhaupt ein objekt war, oder halt ein 
      // interactive
    if(member(owners, getuid(TP))==-1) {  // wenn die uid von this_player() ind
      // der Variable owners nicht vorkommt, dann net :)
      if(!allowed) {
        tell_object(TP, "Du darfst diesen Raum nicht"
                      +" betreten.\n"); // msg an this_player()
        TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_GO|M_SILENT|M_NO_SHOW);
          // tp zurueck an den ort, wo er das letzte kommando eingeg. hat
        for(i=sizeof(owners)-1;i>=0;i--) {
          if (pl=find_player(owners[i]))
             tell_object(pl, CAP(getuid(TP))+" wollte Chat betreten.\n");
        }
      }
      else {
        for(i=sizeof(owners)-1;i>=0;i--) 
          if (pl=find_player(owners[i])) 
            if (!present(owners[i]))
              tell_object(pl, CAP(getuid(TP))+" betrat Chat.\n");
      }
    }
  }
}


int room_status()
{
 if(!allowed) {
   write(BS("Der Raum ist locked.\n"));
 }
 else write(BS("Der Raum ist unlocked.\n"));
 return 1;
}


int lock()
{
  if(member(owners, getuid(TP))!=-1) {
    allowed=0;
    write("Locked.\n");
    say(TPN+" locked den Raum.\n");
    return 1;
  }
  return 0;
}

int unlock()
{
  if(member(owners, getuid(TP))!=-1) {
    allowed=1;
    write("Unlocked.\n");
    say(TPN+" unlocked den Raum.\n");
    return 1;
  }
  return 0;
}

kick_out()
{
  int i;
  object *inv;
  inv=filter_objects(all_inventory(ME), #'interactive);

  for(i=sizeof(inv)-1;i>=0;i--) {
    tell_object(inv[i], "Du wirst rausgeworfen.\n");
    inv[i]->move("/gilden/druidenzirkel", M_TPORT);
  }
  return 1;
}

