inherit "/d/gebirge/angrox/room/std_bergwerk_new";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, 
	     "Ein grob aus dem Stein gehauener Stollen");
  SetProp( P_INT_LONG,
	     "Hier wurde ein grob behauener Stollen in den Fels gegraben. Der "
	 +   "gesamte Gang ist mit starken Balken auf beiden Seiten gegen "
	 +   "Einstuerzen gesichert. Ueberall auf dem Boden liegen kleinere "
	 +   "Felsbrocken herum, die das Vorkommen erschweren. Weiter im Osten "
	 +   "hoerst du haemmernde Geraeusche, die durch das Echo verzerrt "
         +   "werden. Vom Westen faellt Licht in den Stollen, weiter im Osten "
         +   "ist aber alles dunkel. Nach Sueden klafft ein stattlicher Spalt im sonst recht massiven Fels.");
  SetProp( P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
	     "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren."));
  AddDetail ( ({"spuren", "schuerfspuren"}),
	     "Die Zwerge haben hier nach Gold gegraben.");
  AddDetail ( "gold",
	     "Hier haben sie es wohl aufgegeben.");
  AddDetail ( "boden",BS(
	     "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken "
	 +   "uebersaeht."));
  AddDetail ( "fels",
	     "Der Fels ist rauh und fuehlt sich kalt an.");
  AddDetail ( ({"brocken", "steine", "felsbrocken"}),BS(
	     "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
          +  "Du beschliesst mehr aufzupassen, um dir nicht wehzutun."));
  AddDetail ( "balken",BS(
	     "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus Holz."));
  AddDetail ( "holz",
	     "Es sieht noch sehr robust aus.");
  AddDetail( ({"seiten", "wand" "seitenwand"}), "Stein. Was sonst?");

  AddDetail("licht", "Es kommt von Westen.");

  AddDetail("spalt", "Jemand hat sich hier wohl mit schwerem Werkzeug einen Weg gebahnt.");

  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddSound ( DEFAULT_SOUND,
	     "Das Haemmern klingt weit entfernt und kommt von Osten.");
  AddSound ( "echo", "ECHO ... Echo .... echo ...");
  AddSound ("haemmern", "BUMM ... bumm ... BUMM ... bumm ...");
  
  AddExit( "osten", EBENE1("bergwerk_r2"));
  AddExit( "westen", ROOM("gang2"));
  AddItem("/d/gebirge/angrox/obj/topliste", REFRESH_DESTRUCT);
         
}






