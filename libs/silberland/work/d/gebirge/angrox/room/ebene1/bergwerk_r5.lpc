#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Ein grob aus dem Stein gehauener Stollen"
	 );
  SetProp( P_INT_LONG,BS(
		 "Hier liegt ein riesiger Steinhaufen im Gang. Unzaehlige kleine "
	 +   "und grosse Steine aufeinander. Der Gang wird durch starke Balken "
	 +   "gegen das Einstuerzen abgestuetzt. Laute Klopfgeraeusche kommen "
	 +   "aus dem Osten.")
         );



  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.")
		);
  AddDetail("decke", "Besteht aus Stein");
  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge haben hier nach Gold gegraben."
		);

  AddDetail ( "gold",
		 "Hier haben sie es wohl aufgegeben."
		);

  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlen Fels. Auf dem Boden tuermen sich "
	 +   "unzaehlige Steine zu einem grossen Haufen.")
		);
 
  AddDetail ("haufen",BS(
             "Der Haufen besteht aus kleinen und grossen Steinen."));

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( "steine",BS(
		 "Die Felsbrocken sind eigentlich ganz schoen gross und gefaehrlich "
	 +	 "kantig. Du beschliesst mehr aufzupassen, um dir nicht wehzutun.")
		);

  AddDetail ( ({"brocken", "felsbrocken"}),BS(
                 "Uii - wenn dir ein solcher auf den Kopf faellt, na dann gute "
                +"Nacht. Vorsichtig blickst du nach oben, aber da scheint alles "
                +"stabil zu sein."));



  AddDetail ( "balken",BS(
		 "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus Holz.")
		);

  AddDetail ( "holz",
		 "Es sieht noch sehr robust aus."
		);

  AddSound ( DEFAULT_SOUND,
		 "Das Haemmern ist sehr laut. Es kommt von Osten."
	   );


  AddExit( "osten", EBENE1("bergwerk_r6.lpc"));
  AddExit( "westen", EBENE1("bergwerk_r4.lpc"));
}
