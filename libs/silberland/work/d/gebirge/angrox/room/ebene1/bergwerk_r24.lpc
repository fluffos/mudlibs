inherit "/d/gebirge/angrox/room/std_bergwerk_new";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"
#include "../../steintafelquest.h"


void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Ein grosse Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Diese grosse Hoehle ist ueber und ueber mit Marmor ausgelegt. Am "
	 +   "suedlichsten Ende der Hoehle kannst du eine grosses Tor erkennen, "
	 +   "welches eine kleinere Manntuer besitzt. Grosse Fackelhalter an den "
         +   "Waenden lassen diese Hoehle fast wie im Tageslicht erstrahlen. Auch "
         +   "hier eilen geschaefige Zwerge hin und her, meist beladen mit grossen "
         +   "Rucksaecken voll von Gold oder Edelsteinen. An den Waenden sind "
         +   "seltsame Symbole angebracht. "
         +   "Von ueberall scheint Klopfen an Dein Ohr zu dringen."));

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle ist vollkommen mit Marmor ausgelegt. Fackeln an den "
                +"Waenden erhellen diese Hoehle.")); 
	


  AddDetail ( ({"boden", "steine"}), 
		 "Der Boden ist aufwendig mit Marmor gepflastert."
	 );

  AddDetail ( ({"marmor", "faeden"}),
            "Der Marmor ist von silberen Faeden durchzogen."
         );
           
  AddDetail ("decke",
		 "Du siehst die Decke ueber dir."
	 );

  AddDetail ( "mamor",
		 "Der Mamor ist wunderschoen gearbeitet."
		);

  AddDetail ( ({"arbeiter","zwerge"}),BS(
                 "Die Zwerge wuseln hier hin und her und schleppen Rucksaecke voll von " 
                +"Schaetzen mit sich."));


  AddDetail ( "fackeln",BS(
		 "Die Fackeln strahlen ein beruhigendes, warmes Licht und flackern "
	 +   "leicht. Sie sind an Fackelhaltern befestigt.")
	 );

  AddDetail ( ({"halter", "fackelhalter"}),BS(
		 "Die Fackelhalter sind fix an der Wand befestigt. In ihnen stecken "
	 +   "Fackeln."));


  AddDetail("rucksaecke",BS(
            "Die haben die Zwerge, nicht Du."));
             
  AddDetail( ({"wand", "waende"}),BS(
            "Die Waende sind mit Marmor verkleidet. Seltsame, scheinbar uralte Symbole zieren "
         +  "diesen Marmor."));
  
  AddDetail(({"schriftzeichen", "symbole"}), BS(
            "Die Symbole sollen wohl eine Art Symbolschrift darzustellen. Anscheinend handelt "
         +  "es sich um Relikte der Ur-zwergischen Schrift. Ein Symbol sticht aus den Unmengen "
         +  "heraus, denn es taucht immer wieder auf."));
 
  AddDetail("symbol", BS(
            "Das Symbol zeigt eine gebueckte Gestalt, die eine Peitsche oder etwas Aehnliches "
         +  "gen Himmel haelt. Die Gestalt weisst am Kopf zwei Hoerner auf. Das ganze kommt "
         +  "Dir recht unheimlich vor."));
  AddDetail("aehnliches", "Naja, etwas Aehnliches halt! :)");
  
  AddDetail ( ({"gold", "edelsteine", "schaetze"}),BS(
                "Die Schaetze der Erde. Sie verheissen Reichtum und Macht. Die Zwerge sind die "
               +"Hueter dieser Schaetze. Man sieht es ihnen an..."));
  AddDetail("gestalt", 
            "Die Gestalt wirkt SEHR unheimlich!");
  AddDetail("kopf", 
           "Der Kopf der Gestalt hat 2 Hoerner ... wie ein Stier ... oder ein Daemon."); 
  AddDetail("peitsche", 
            "Die Gestalt schwingt die Peitsche.");
  AddDetail("hoerner", 
            "Die Hoerner sehen ... daemonisch aus.");
  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");

  AddItem(QUEST1("tschubax.lpc"), REFRESH_DESTRUCT);
  
  AddExit("sueden", EBENE1("bergwerk_r23.lpc"));
  AddExit("norden", EBENE1("bergwerk_r25.lpc"));
  AddExit("osten", EBENE1("bergwerk_r22"));

}

