#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Ein Gang");

  SetProp( P_INT_LONG,BS(
        "Dieser Gang ist Richtung Sueden vermauert. An der Wand sind Schriftzeichen "
        "eingraviert. Der Boden ist hier mit einer dicken Staubschicht "
        "zugedeckt. Einige Stuetzbalken stuetzen den Gang.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail( ({ "wand", "waende" }), 
                "Die Waende bestehen aus rohem Fels." );
  AddDetail( ({ "staub", "staubschicht", "schicht" }), 
                "Mit deinen Schritten *hust* wirbelst du den "+
                "*hust* Staub auf." );
  AddDetail ( ({"raum", "stollen", "gang"}),
		 "Die Hoehle ist ganz aus kahlem Fels. Es ist unnatuerlich hier. Die "
	 	 "suedlichste Wand ist vermauert."
	 );

  AddDetail("decke", "Die Decke besteht auch aus Fels.");

  AddDetail ( "boden",
        "Der Boden besteht aus kahlen Fels und ist mit einer Staubschicht "
        "bedeckt. Einige zerbrochene Balken liegen am Boden."
	 );

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
	 );

  AddDetail (({"balken", "stuetzbalken"}), 
		 "Die Balken bestehen aus morschem Holz.");

  AddDetail ( "holz",
		 "Es sieht sehr morsch aus."
			);


  AddDetail ( "mauer",
		 "An der Mauer befinden sich Schriftzeichen."
	 );

  AddDetail ( ({"zeichen", "schriftzeichen"}),
		 "Wegen akuter Einsturzgefahr geschlossen."
	 );
  AddReadDetail (({"zeichen", "schriftzeichen"}),
		 "Wegen akuter Einsturzgefahr geschlossen.");

  AddDetail("suedwand", 
      "Die Suedwand ist vermauert. An ihr befinden sich Schriftzeichen.");

  AddItem(NPC("zwaechter2"), REFRESH_DESTRUCT);
 
  
  AddExit( "norden", EBENE1("bergwerk_r3.lpc"));

  AddExit( "nordosten",EBENE1("bergwerk_r4.lpc"));
}
