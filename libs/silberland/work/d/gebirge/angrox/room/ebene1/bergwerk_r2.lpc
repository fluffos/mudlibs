#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
	     "Ein grob aus dem Stein gehauener Stollen"
	 );
  SetProp( P_INT_LONG,BS(
	     "Der Stollen fuehrt weiter in den Berg. Die Stuetzbalken sind "
	 +   "hier weit massiver ausgelegt als weiter oben. Ueberall auf dem " 
	 +   "Boden liegen kleinere Felsbrocken herum, die das Vorkommen erschweren. " 
	 +   "Im Norden und im Sueden fuehren kleinere Seitengaenge ab, die weiter "
	 +   "in den Berg fuehren. Aus dem Osten sind jetzt deutlich Klopfgerauesche " 
	 +   "zu vernehmen.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
	     "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.")
	    );

  AddDetail ( ({"spuren", "schuerfspuren"}),
	     "Die Zwerge haben hier nach Gold gegraben."
	    );

  AddDetail("berg",
      "Du bist in ihm.");
  
  AddDetail ( "gold",
	     "Hier haben sie es wohl aufgegeben."
	    );

  AddDetail ( "boden",BS(
	     "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken "
	 +   "uebersaeht.")
	    );

  AddDetail ( "fels",
	     "Der Fels ist rauh und fuehlt sich kalt an."
	    );

  AddDetail ( ({"brocken", "steine", "felsbrocken"}),
		 "Die Felsbrocken sind eigentlich ganz schoen gross und gefaehrlich."
	 +   "kantig. Du beschliesst mehr aufzupassen, um dir nicht wehzutun."
	    );

  AddDetail ( "balken",BS(
	     "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus Holz.")
	    );

  AddDetail ( "holz",
	     "Es sieht noch sehr robust aus."
	    );

  AddSound ( DEFAULT_SOUND,
	     "Das Haemmern klingt weit entfernt und kommt von Osten."
	   );

  AddSound ( ({"haemmern", "klopfgeraeusche"}),
                "BUMM ... BUMM ... BUMM ... BUMM ...");
  
  AddExit( "norden", EBENE1("bergwerk_r10.lpc"));	
  AddExit( "sueden", EBENE1("bergwerk_r13.lpc"));
  AddExit( "osten", EBENE1("bergwerk_r3.lpc"));		 
  AddExit( "westen", EBENE1("bergwerk_r1.lpc"));
}
