inherit "/d/gebirge/angrox/room/std_bergwerk_new";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Ein Gang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Dieser Gang scheint Teil eines sehr alten Gangsystems zu sein. "
                +"Es sind weder Bearbeitungsspuren noch Stuetzbalken, die den Gang "
                +"stuetzen sollten, zu sehen. Andererseits ist das Gestein hier sehr "
                +"hart. Einige silbrige Faeden durchziehen das Gestein. Auch hier "
                +"arbeiten ueberall Zwerge. Von ueberall her ist Haemmern zu hoeren. "
                +"Von Osten kommt Dir ein kuehler Lufthauch entgegen.")); 

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  AddDetail ( ({"raum", "gang"}),BS(
		 "Der Gang besteht vollkommen aus hartem Fels, welches von silbrigen "
                +"Faeden durchzogen ist."));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein.");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergweoehnlich hart."));

  AddDetail ( ({"arbeiter","zwerge"}),BS(
                 "Die Zwerge wuseln hier hin und her und schleppen Rucksaecke voll von " 
                +"Schaetzen mit sich."));

  AddDetail("rucksaecke",BS(
            "Die haben die Zwerge, nicht Du."));

  AddDetail("faeden",BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair."));
  
  AddDetail ( ({"gold", "edelsteine", "schaetze"}),BS(
                "Die Schaetze der Erde. Sie verheissen Reichtum und Macht. Die Zwerge sind die "
               +"Hueter dieser Schaetze. Man sieht es ihnen an..."));
  AddDetail("lufthauch", "Er ist kuehl.");

  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");

  AddExit("westen", EBENE1("bergwerk_r32.lpc"));
  AddExit("osten", EBENE1("bergwerk_r34.lpc"));
}












