inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Ein breiter Felsgang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Dieser breite Gang ist hell von Fackeln erleuchtet. Der Boden ist "
	 +	 "mit Steinen gepflastert. Die Fackeln sind an Fackelhaltern an der "
	 +	 "Wand befestigt. Der Gang sieht reichlich frequentiert aus, denn der "
	 +   "Boden ist makellos sauber. Von Sueden her sind Klopfgeraeusche zu "
	 +   "vernehmen.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Der Boden ist mit "
	 +   "Steinen gepflastert. An den Waenden haengen Fackeln.")
	 );


  AddDetail ( ({"boden", "steine"}),
		 "Der Boden ist aufwendig mit Marmor gepflastert."
	 );

  AddDetail ("decke",
		 "Du siehst die Decke ueber dir."
	 );
  
  AddDetail(({"waende", "wand"}), 
            "Die Waende bestehen aus Marmor.");
  
  AddDetail ( "marmor",
		 "Der Mamor ist wunderschoen gearbeitet."
		);

  AddDetail ( "fackeln",BS(
		 "Die Fackeln strahlen ein beruhigendes, warmes Licht und flackern "
	 +   "leicht. Sie sind an Fackelhaltern befestigt.")
	 );

  AddDetail ( ({"halter", "fackelhalter"}),BS(
		 "Die Fackelhalter sind fix an der Wand befestigt. In ihnen stecken "
	 +   "Fackeln.")
	 );
  
  AddDetail("waenden", "An den felsigen Waenden haengen Fackeln.");

  AddSound ( DEFAULT_SOUND,
		 "Vom Sueden kommt ein Haemmern."
	 );


  AddExit( "norden", EBENE1("bergwerk_r20.lpc"));
  AddExit( "sueden", EBENE1("bergwerk_r18.lpc"));
      
}




