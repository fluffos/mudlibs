inherit "/d/gebirge/angrox/room/std_bergwerk_new";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Ein grosse Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Diese grosse Hoehle ist ueber und ueber mit Marmor ausgelegt. Am "
	 +   "suedlichsten Ende der Hoehle kannst du eine grosses Tor erkennen, "
	 +   "welches eine kleinere Manntuer besitzt. Grosse Fackelhalter an den "
         +   "Waenden lassen diese Hoehle fast wie im Tageslicht erstrahlen. Auch "
         +   "hier eilen geschaeftige Zwerge hin und her, meist beladen mit grossen "
         +   "Rucksaecken voll von Gold oder Edelsteinen. Die Luft hier ist etwas "
         +   "stickiger als im letzten Raum. Von ueberall scheint Klopfen an Dein "
         +   "Ohr zu dringen."));

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle ist vollkommen mit Marmor ausgelegt. Sie wird von "
                +"Fackeln erhellt. An der Suedwand befindet sich ein Tor."));
	
 
  AddDetail ( ({"boden", "steine"}), 
		 "Der Boden ist aufwendig mit Marmor gepflastert."
	 );

  AddDetail ( ({"marmor", "faeden"}),
            "Der Marmor ist von silberen Faeden durchzogen."
         );
           
  AddDetail ("decke",
		 "Du siehst die Decke ueber dir."
	 );

  AddDetail ( "marmor",
		 "Der Mamor ist wunderschoen gearbeitet."
		);

  AddDetail ( ({"arbeiter","zwerge"}),BS(
                 "Die Zwerge wuseln hier hin und her und schleppen Rucksaecke voll von " 
                +"Schaetzen mit sich."));


  AddDetail ( "fackeln",BS(
		 "Die Fackeln strahlen ein beruhigendes, warmes Licht und flackern "
	 +   "leicht. Sie sind an Fackelhaltern befestigt.")
	 );

  AddDetail ("licht", 
             "Das Licht ist warm und beruhigend.");
             
  AddDetail ( ({"halter", "fackelhalter"}),BS(
		 "Die Fackelhalter sind fix an der Wand befestigt. In ihnen stecken "
	 +   "Fackeln."));


  AddDetail("rucksaecke",BS(
            "Die haben die Zwerge, nicht Du."));
             
  
 AddDetail ("tor",BS(
		 "Das Tor besteht vollkommen aus Eisen und sieht schwer gepanzert aus. "
	 +   "Das Tor besitzt eine Manntuer.")
	 );
  AddDetail("eisen", 
            "Es sieht SEHR massiv aus. Du streichst mit der Hand ueber das Eisen; es "
           +"fuehlt sich kuehl und glatt an.");

  AddDetail ( ({"tuer", "manntuer"}),
		 "Die Manntuer ist ca. 1.50 hoch, also auf Zwergengroesse ausgelegt."
	 );

  
  AddDetail ( ({"gold", "edelsteine", "schaetze"}),BS(
                "Die Schaetze der Erde. Sie verheissen Reichtum und Macht. Die Zwerge sind die "
               +"Hueter dieser Schaetze. Mann sieht es ihnen an..."));

  AddDetail("suedwand", "An der Suedwand befindet sich ein grosses Tor.");  

  AddDetail("waende", 
            "Die Waende sind mit Marmor verkleidet. Fackelhalter sind "
           +"auch an der Wand befestigt.");
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);


 
  NewDoor("sueden", EBENE1("bergwerk_r20"),
             ({"manntuer", "tuer" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
	     D_LONG, "Das Eisentor oeffnet den Blick auf einen Hain.",
	     D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Manntuer.",
	     D_NAME, "Manntuer",
            
              }) );
	     
  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");
  
  AddExit("norden", EBENE1("bergwerk_r22.lpc"));
  AddExit("westen", EBENE1("bergwerk_r23.lpc"));

}









