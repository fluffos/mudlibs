inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <player.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine kleine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Du stehst in einer kleinen Hoehle. Die Waende bestehen aus Fels. "
	 +   "Die Hoehle ist kuenstlich und wurde von den Zwergen aus dem Fels "
	 +   "geschlagen. Die vielen Schuerfspuren weisen darauf hin, dass an "
	 +   "dieser Stelle noch fleissig nach Gold gegraben wird. In einer Ecke "
	 +   "liegt eine zerbrochene Spitzhacke.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Der Hoehle ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.")
		);

  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Gold."
		);

  AddDetail ( "gold",
		 "Vielleicht findest du was, wenn du nur danach graebst."
		);

  AddDetail ( "boden",
		 "Der Boden besteht aus kahlen Fels."
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( "ecke",BS(
              "Das ist eine Ecke. Es gibt hier viele Ecken und das ist eine davon. "
             +"In ihr liegt eine zerbrochene Spitzhacke."));

  AddDetail ( ({ "hacke", "spitzhacke" }),BS(
		 "Der Fels ist hier wohl sehr hart. Schade um das schoene Stueck.")
			);
  AddDetail("stelle", "Na hier halt.");
  AddDetail(({"decke","waende"}), "Alles aus Fels."); 

  AddExit( "suedwesten", EBENE1("bergwerk_r10.lpc"));
}



