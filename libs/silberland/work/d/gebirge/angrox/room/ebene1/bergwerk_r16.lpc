inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include "../../files.h"

int dreieck;
string mitnehmen;

void create()
{
  
  ::create();

  dreieck = 1;
    
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Eine Hoehle" );

  SetProp( P_INT_LONG,BS(
	     "Diese Hoehle ist weitaus kaelter als die anderen. Irgendeine "
	 +   "spaehrische Praesenz scheint sich hier aufzuhalten. Dich froestelt. "
	 +   "Die Schatten, die durch deine Lichtquelle hervorgerufen werden, "
	 +   "werfen unheimliche, bizarre Schatten an die Waende. Hier stimmt "
	 +   "etwas ganz und gar nicht... "
	 +   "An der suedlichsten Wand scheinen sich vor langer Zeit einige "
	 +   "Felsbrocken von der Wand geloest zu haben. Und unter dem Steinhaufen "
	 +   "kannst Du zu deinem Entsetzen ein Skelett entdecken...")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:0]));
  
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Die Waende sind aus grauem Fels und "+
                "empfindlich kalt.", 78 ) );
  AddDetail( ({ "staub", "schicht", "staubschicht" }), 
                break_string( "*HUST*", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Sie ist sehr gross und erstaunlich kalt.", 78 ) );
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Die Hoehle ist ganz aus kahlem Fels. Es ist unnatuerlich hier. An "
	 +	 "der suedlichsten Wand kannst du einen Steinhaufen erkennen, unter dem "
	 +       "ein Skelett liegt.")
	 );



  AddDetail ( "boden",BS(
	      "Der Boden besteht aus kahlen Fels und ist mit einer Staubschicht "
	 +   "bedeckt. Einige zerbrochene Balken liegen am Boden. Unter einem "
	 +   "Steinhaufen liegt ein Skelett.")
	 );

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
	 );

  AddDetail ( "balken",BS(
	      "Die Balken scheinen den Bereich gestuetzt zu haben, unter dem das "
	 +   "Skelett liegt. Es ist zu erkennen, das einer der Balken Spuren einer "
	 +   "Saege aufweist.")
			);

  AddDetail ( "holz",
		 "Es sieht sehr morsch aus."
			);


  AddDetail ( ({"spuren", "saegespuren"}),BS(
		 "Der Einsturz war wohl kein Unfall, wie diese Sabotagespuren zeigen.")
         	);


  AddSpecialDetail ("skelett","toter_zwerg");
		 

  AddDetail ("schatten",BS(
		 "BUAHHH, richtig gruselig. Sie scheinen sich zu bewegen und dich zu "
	 +	 "fixieren...")
	 );


  AddDetail ( ({"haufen", "steinhaufen"}),BS( 
                 "Der Steinhaufen befindet sich an der Nordwand. Er stammt wohl von einem "
         +       "Steinschlag.")
            );


  AddDetail("nordwand", "Da ist die Decke eingestuerzt.");
  AddDetail ("schaedel",BS(
                 "Der arme Zwerg muss sofort gestorben sein, nach der Verletzung des "
         +       "Schaedels zu urteilen.")
            );

  AddItem ("/d/gebirge/angrox/npc/zgeist", REFRESH_DESTRUCT);

  AddExit( "nordwesten", EBENE1("bergwerk_r15.lpc"));
}

reset()
{
    ::reset();
    dreieck = 1;
}

create_dreieck()
{
    object a;
    a = clone_object(OBJ("steindreieck"));
    return a;
}


toter_zwerg()
{   
       if (!dreieck)
	
        return(BS("Das Skelett scheint einstmals ein stattlicher Zwerg gewesen "
             +"zu sein. Offenbar ist er einem Steinschlag zu Opfer gefallen, "
             +"denn er liegt mit zertruemmertem Schaedel unter einem grossen "
             +"Steinhaufen."));
              
                
        dreieck_nehmen();
       
        return(BS("Das Skelett scheint einstmals ein stattlicher Zwerg gewesen "
             +"zu sein. Offenbar ist er einem Steinschlag zu Opfer gefallen, "
             +"denn er liegt mit zertruemmertem Schaedel unter einem grossen "
             +"Steinhaufen. Bei dem Skelett liegt ein steinernes Dreieck."
             + mitnehmen));     
}


dreieck_nehmen()
  {
    object a;
    int ret;
    a = create_dreieck();
    ret = a->move(this_player());
    if (ret == ME_TOO_HEAVY)
    {
      mitnehmen="Du versuchst das Steindreieck zu nehmen, aber er ist Dir zu "+
      "schwer.";
      say(TPN+"scheint etwas beim Skelett gefunden zu haben.");
      a->remove();
      return 1;
    }
    else
    {  
     mitnehmen="Sicherheitshalber nimmst du es gleich mit.";
     say(TPN+" scheint etwas beim Skelett gefunden zu haben.");
     dreieck = 0;
     return 1;
    }

  }


