inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <moving.h>
#include <player.h>

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine alter Gang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Luft in diesem Gang riecht extrem modrig, der Felsboden "
		+"ist mit Staub und Gesteinsbrocken uebersaet. Einige "
		+"verrottete Bretter liegen herum. Dieser Gang sieht aus, als "
		+"haettem ihn seit Ewigkeiten keiner mehr betreten. Hier "
		+"herrscht eine unwirkliche Stille. Es ist kalt hier.\n"));




  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:10]));
  AddDetail ( "gang",BS(
		 "Der Gang ist aus dem Fels gehauen worden. Von den Waenden "
		+"und von der Decke sind bereits einige Felsbrocken "
		+"herabgestuerzt und weisen darauf hin, dass der Gang schon "
		+"lange nicht mehr instandgesetzt wird.\n"));

  AddDetail ( "fels",BS(
		 "Der graue, kalte Fels fuehlt sich rauh an.\n"));

  AddDetail (({"waende", "wand"}), BS(
		 "Die Waende sind aus grauem, kalten, rauhen Fels. Einige "
		+"Felsbrocken sind schon aus der Wand gebrochen.\n"));

  AddDetail ( "decke", BS(
		 "Die Decke weist schon einige Risse auf, einige Felsbrocken "
		+"sind schon heruntergefallen. Wer weiss, wie lange der Gang "
		+"dem Druck von einigen tausend Tonnen Gestein noch aushaelt "
		+"...\n"));

  AddDetail ( "boden", BS(
		 "Der Boden ist mit einer Staubschicht bedeckt. Einige Steine "
		+"liegen herum, ebenso wie einige verottete Bretter.\n"));

  AddDetail ( ({"staub", "staubschicht"}),BS(
		 "Ihh - STAUB! Kommt denn - HUST! - hier niemand zum Putzen "
		+"her?!?!?!\n"));

  AddDetail ( "risse", BS(
		 "Die Risse ziehen sich wie ein Gespinst von Spinnenweben durch "
		+"die Decke.\n"));

  AddDetail ( ({"steine", "brocken", "felsbrocken", "gestein"}),BS(
		 "Zahlreiche Felsbrocken liegen am Boden.\n"));

  AddDetail ( "bretter", BS(
		 "Die am Boden liegenden Bretter sehen ziemlich vermodert und "
		+"verrottet aus. Du beschliesst, sie liegenzulassen, da sie "
		+"kaum zu irgendetwas zu gebrauchen sind.\n"));

  AddSound ( DEFAULT_SOUND,BS(
		 "Du lauscht ... Totenstille ...\n"));
  AddSmell (DEFAULT_SMELL, BS("Es riecht modrig hier.\n"));

  AddExit( "osten", EBENE3("ebene3_r3.lpc"));
  AddExit( "westen", EBENE3("bergwerk_e3_r1.lpc"));


}





