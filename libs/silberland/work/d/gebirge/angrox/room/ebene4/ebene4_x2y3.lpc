inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();

  AddDetail("treppe", BS(
                "Die Treppe ist aus seltsamen, fremdartigen Basalt. Sie fuehrt "
               +"hinauf.\n"));
  AddDetail ( "basalt",BS(
		 "Der Basalt ist tiefschwarz und fuehlt sich eiskalt an.\n"));

  AddExit( "oben", EBENE3("ebene3_r9.lpc"));
  AddExit( "sueden", EBENE4("ebene4_x2y2.lpc"));
  AddExit( "suedwesten", EBENE4("ebene4_x1y2.lpc"));
  AddExit("suedosten", EBENE4("ebene4_x3y2.lpc"));
}

string weiteres()
 {
  return "Eine Treppe fuehrt hier nach oben.";
 }

string weiteres1()
 {
  return "Eine Treppe fuehrt hier nach oben.";
 }




