inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"
#include "../../steintafelquest.h"


void create()
{
  ::create();
   AddDetail ("symbol", BS(
              "Das Symbol zeigt eine gehoernte Fratze.\n"));
   AddDetail ("fratze", BS(
                "Echt ecklig!\n"));
   AddDetail("symbol", "Das Symbol zeigt einen Pfeil nach unten.");
   AddDetail("boden", "Am Boden sind seltsame Schriftzeichen eingraviert. "
              +"Vielleicht kannst Du sie ja lesen?");
   AddReadDetail(({"schrift", "schriftzeichen"}), "Hmm ... leider kannst Du "
              +"sie nicht entziffern, aber wenn Du was zum Schreiben haettest, dann "
              +"koenntest Du sie Dir notieren, und sie jemanden zeigen, der sie "
              +"uebersetzen kann.");
   AddCmd("notiere", "notiere");

  NewDoor("westen", EBENE4("ebene4_x9y4"),
             ({"silberportal", "portal" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
	     D_LONG, "Das Silberportal ist ohne jegliche Verzierungen.\n",
	     D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Silberportal.\n",
	     D_NAME, "Silberportal",
	     
              }) );
 
   NewDoor("osten", EBENE4("ebene4_x11y4"),
             ({"goldtuer", "tuer" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG, "An der Tuer befindet sich ein Symbol.\n",
	     D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Goldtuer.\n",
	     D_NAME, "Goldtuer",
	     
              }) );
 

}
string weiteres()
{
return "Im Osten ist eine goldene Tuer, im Westen ein silbernes Portal.";
}

notiere(string str)
{
 object ob1, ob2, ob3, ob;
 notify_fail("Was willst Du notieren?\n");
 if (!str) return 0; 
 notify_fail("Du hast nichts zum Schreiben.\n");
 if (!(ob1=present("feder", TP))) return 0;
 notify_fail("Du hast nichts zum Draufschreiben dabei.\n");
 if(!(ob2=present("pergament", TP))) return 0;
 notify_fail("Hmm ... Dir fehlt noch etwas Tinte fuer die Feder.\n");
 if(!(ob3=present("tintenfaesschen", TP))) return 0;
 notify_fail("Das kannst Du nicht notieren.\n");
 if(str!="schriftzeichen" && str!="schrift2" && str!="zeichen") return 0;
 write(BS("Du nimmst Feder und Pergament und notierst Dir die Schriftzeichen. "
      +"Leider bricht Dir genau nach dem letzten Wort die Feder ab, und "
      +"das Faesschen faellt auch auf den Boden. Ach ... wirklich ungeschickt. "
      +"Wenn Du jemanden das Pergament uebersetzen laesst, dann weisst Du sicher, "
      +"wie Du hier weiterkommst."));
 say(TPN+BS(" schreibt irgendwas auf ein Pergament"));
 ob1->remove();
 ob2->remove();
 ob3->remove();
 ob=CLONEOB(QUEST1("pergament1"));
 ob->move(TP, M_NOCHECK);
 return 1;
}

