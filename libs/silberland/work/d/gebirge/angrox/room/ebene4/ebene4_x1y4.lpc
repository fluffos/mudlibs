inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"

int zufall;
int probiert;
int schluessel_da;
string wasdas;
void create()
{
  
  ::create();
  schluessel_da = 1;
  probiert = 0;
  zufall = random(3);
  AddDetail("oeffnung", BS(
            "Die Oeffnung ist kreisrund und befindet sich am Boden. Glasklares "
           +"Wasser befindet sich etwas in 4 Meter Tiefe."));
  AddDetail ("wasser", BS(
            "Wer weiss, vielleicht ist ja was im Wasser. Wenn da etwas unten "
           +"laege... hmm ... vielleicht solltest Du hier mal angeln!\n"));
   AddCmd(({"angle", "angel"}), "angeln");
   AddItem (NPC("zombie"), REFRESH_DESTRUCT);
  AddItem (NPC("skelett"), REFRESH_DESTRUCT);
  AddExit( "sueden", EBENE4("ebene4_x1y3.lpc"));

 
}

string weiteres()
{
return "In der Mitte des Raumes ist eine kreisrunde Oeffnung im Boden.";
}



reset()
  {
    ::reset();
    schluessel_da = 1;
  }

create_schluessel()
  {
    object a;
    a = clone_object(OBJ("key_eb4x8y4.lpc"));
    return a;
  }

angeln(str)
  {
    object angelrute;
    notify_fail("Worin moechtest Du angeln?\n");
    if (!(angelrute=present("angel", TP)))
     {
      write ("Du hast keine Angel dabei.\n");
      return 1;
     }
    if ((str == "im Wasser") || (str == "im wasser") || (str == "in oeffnung")
       || (str == "in Oeffnung") || (str == "in wasser") || (str == "im Wasser"))
      {
      if (!schluessel_da)
        {
          write("Irgendwie kommst Du Dir jetzt bloed vor. Da war gar nichts\n"
               +"drinnen. Nur die uebliche Paranoia.\n");
          say(BS(TPN+" haelt "+(PlayerGender==FEMALE ? "ihre" : "seine")+
                     " Angel ins Wasser. Kurz darauf zieht "
                    +(PlayerGender==FEMALE ? "sie" : "er")+" die Angel aus "
                    +"dem Wasser und steckt sie weg.\n"));
          return 1;
        }
      if (zufall < probiert)
        {
          write (BS("Du wirfst die Angel aus und kannst tatsaechlich etwas "
            +"ergattern, was Du sofort einschiebst! Aber ... oops ... wie "
            +"ungeschickt ... die Angel faellt Dir ins Wasser.\n"));
          say(BS(TPN+" haelt "+(PlayerGender==FEMALE ? "ihre" : "seine")+
                     " Angel ins Wasser. Kurz darauf zieht "
                    +(PlayerGender==FEMALE ? "sie" : "er")+" die Angel aus "
                    +"dem Wasser, schiebt etwas blinkendes ein. Dabei faellt "
                    +"die Angel ins Wasser. So ein Pech. Du grinst.\n"));
          angelrute->remove();
          schluessel_nehmen();
          probiert = 0;
          return 1;
          
        }
      else
        {
          write(("Du wirfst die Angel aus und kannst tatsaechlich etwas "
            +"ergattern, aber als Du die Angel aus dem Wasser ziehst, faellt "
            +"das Etwas von der Angel. So ein Pech...\n"));
          say(BS(TPN+" haelt "+(PlayerGender==FEMALE ? "ihre" : "seine")+
                     " Angel ins Wasser. Kurz darauf zieht "
                    +(PlayerGender==FEMALE ? "sie" : "er")+" die Angel aus "
                    +"dem Wasser und scheint sich fuerchterlich zu aergern.\n"));
          probiert++;
          return 1;
        }
    } 
 }


schluessel_nehmen()
  {
    object a;
    int ret;
    a = create_schluessel();
    ret = a->move(this_player());
    if (ret==ME_TOO_HEAVY)
    {
      write("Du versuchst den Schluessel zu nehmen, aber er ist zu schwer.\n");
      say (TPN+"wirft den Gegenstand zurueck in die Oeffnung!");
      a->remove();
      return 1;
    }
    else 
    {
     schluessel_da = 0;
     return 1;
    }
  }

       




