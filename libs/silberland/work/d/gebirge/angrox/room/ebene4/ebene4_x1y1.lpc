inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <defines.h>
#include <moredef.h>
#include "../../files.h"


void create()
{
  ::create();

  AddExit( "norden", EBENE4("ebene4_x1y2.lpc"));
  AddExit( "osten", EBENE4("ebene4_x2y1.lpc"));
  AddSpecialExit( "sueden", "drachenraum");
}

string weiteres()
{
return "";
}


drachenraum()
{
 if(TP->QueryProp(P_LEVEL) > 30) { 
 TELL("angrox", sprintf("EBENE4 BERGWERK: %s versucht alten Drachenraum zu "
       "erreichen!\n",
       TP->Name(WER)));
 TP->AddHP(-10);
 TP->do_exhaust(500);
 write(BS("BONK! Du bist gegen eine unsichtbare Mauer gelaufen, die laut "
     "scheppert! Jetzt hast Du sicher alle idelnden Magier geweckt und "
     "auf Dich aufmerksam gemacht! Du fuehlst Dich total fertig!"));
 }
 else {
   write(BS("Eine unbekannte Macht haelt Dich ab hier zu passieren!"));
 }
 return 1;
}
