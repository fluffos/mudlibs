inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Ein dunkler Gang");
  SetProp( P_INT_LONG,
		 "Du befindest Dich in einem Gang, der aus den Fels gehauen "
                +"wurde. Der ganze Gang ist ueber und ueber mit dunkelvioletten "
                +"Steinplatten ausgelegt. Jede Platte ist auf das kunstvollste "
                +"verziert - nun, wenn diese Verzierungen nicht so abgrundtief "
                +"abstossende Motive enthalten wuerden. Nicht nur wegen der Temperatur "
                +"laufen Dir hier eiskalte Schauer ueber den Ruecken. Die Angst kriecht "
                +"in Deine hintersten Gedanken. "
                 +"@@weiteres@@");

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:05]));
  AddDetail ( "gang",BS(
		 "Der Gang ist vollkommen mit violetten Steinplatten ausgelegt. "
                +"Diese sind mit abscheulichen Motiven verziert.\n"));
    
  AddDetail (({"boden", "waende", "decke"}), BS(
                "Alles hier besteht aus diesen violetten Steinplatten.\n"));
             
  AddDetail (({"platten", "steinplatten"}), BS(
                 "Diese Platten sind aus einem Dir unbekannten, violetten Material "
                +"gefertigt. Graessliche Motive sind in die Platten eingelegt.\n"));

  AddDetail("material", "Du weisst nicht, was das ist.");
  
  AddDetail (({"motive", "verzierungen"}), BS(
                "Wer immer diese Motive geschaffen hat, war geistig sehr "
               +"krank. Die meisten Motive zeigen Opferungen von verschiedenen "
               +"Lebewesen auf einem Altar. Immer wieder ist auch eine Gestalt "
               +"mit einer Peitsche zu sehen, die sich immer in der Naehe von "
               +"Motiven mit dem Altar befindet.\n"));

  AddDetail ( ({"farbe", "violett", "dunkelviolett"}), BS(
              "Das dunkle Violett wirkt sehr bedrohlich hier ...\n"));

  AddDetail("gestalt", BS(
                "Die Gestalt ist gebueckt, scheint eine Robe mit einem Symbol zu tragen, "
               +"haelt eine Peitsche in der Hand und haelt diese Richtung Himmel.\n"));
    
  AddDetail ("symbol", BS(
                "Du kannst es leider nicht richtig erkennen.\n"));
 
  AddDetail (({"peitsche","flammen"}), BS(
                "Die Peitsche scheint von Flammen umwabert zu sein.\n"));
  AddDetail( "altar", BS(
                "Auf dem Altar werden die Lebewesen geopfert.\n"));         
  AddSound ("lebewesen", BS(
             "Elfen, Menschen, Zwerge, Hobbits.\n"));
  AddSound ( DEFAULT_SOUND,BS(
		 "Du lauscht ... Totenstille ...\n"));
  AddSmell ( DEFAULT_SMELL, BS("Die Luft ist SEHR abgestanden.\n"));

}







