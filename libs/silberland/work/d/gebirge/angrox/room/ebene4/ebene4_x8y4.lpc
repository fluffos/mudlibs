inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <rooms.h>
#include "../../files.h"
#include "../../steintafelquest.h"


void create()
{
  ::create();
 
  
 
  AddDetail("gestalt", BS(
                "Die Gestalt ist gebueckt, scheint eine Robe mit einem Symbol zu tragen, "
               +"haelt eine Peitsche in der Hand und haelt diese Richtung Himmel.\n"));
  
  AddDetail ("symbol", BS(
                "Das Symbol zeigt einen gehoernte Fratze.\n"));
  AddDetail ("fratze", BS(
                "Echt ecklig!\n"));
 
  AddDetail ("peitsche", BS(
                "Die Peitsche scheint von Flammen umwabert zu sein.\n"));

  NewDoor("osten", EBENE4("ebene4_x9y4"),
             ({"bronzetor", "tor" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG, "Das Bronzetor ist mit verschiedenen Ornamenten verziert, in der Mitte des Tores ist eine Gestalt mit einer Peitsche abgebildet.\n",
	     D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Bronzetor.",
	     D_NAME, "Bronzetor",
	     
              }) );
 
   AddItem (NPC("zombie"), REFRESH_DESTRUCT);
  AddExit( "suedosten", EBENE4("ebene4_x9y3.lpc"));
}
string weiteres()
{
return "Im Osten ist ein Bronzetor.";
}


void init()
{
  object ob;
  ::init();
 
  if (present(QUESTSTEIN, TP))
   {
     if ((ob=present("bronzeschluessel", TP)))
       ob->remove();
     if ((ob=present("silberschluessel", TP)))
       ob->remove();
     if ((ob=present("goldschluessel", TP)))
       ob->remove();
     if ((ob=present(QUESTPERG1, TP)))
       ob->remove();
     if ((ob=present(TAFELQUESTPERGAMENT, TP)))
       ob->remove();
     write(BS("Einige kleine Objekte haben sich in deinem Inventory aufgeloest.\n"));
   }
 ::init();
}


