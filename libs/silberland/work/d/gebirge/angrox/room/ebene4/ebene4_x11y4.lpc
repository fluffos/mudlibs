inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();
 
  AddDetail ("symbol", BS(
              "Das Symbol zeigt eine gehoernte Fratze.\n"));
   AddDetail ("fratze", BS(
                "Echt ecklig!\n"));

 
   NewDoor("westen", EBENE4("ebene4_x10y4"),
             ({"goldtuer", "tuer" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
	     D_LONG, "An der Tuer befindet sich ein Symbol.\n",
	     D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Goldtuer.\n",
	     D_NAME, "Goldtuer",
	     
              }) );
 

  AddExit( "osten", EBENE4("ebene4_x12y4"));
  
  }
string weiteres()
{
return "Im Westen ist eine goldene Tuer.";
}

