#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();
  SetProp (P_INT_LONG, QueryProp(P_INT_LONG)+
    "Eine toedliche Messerspitze steht aus einer Wand hervor. Wer sie "+
    "genauer untersucht, wird wohl eine schmerzliche Erfahrung machen...\n");

   AddSpecialDetail ("messerspitze", "d_messerspitze");
   SetProp (P_KILL_NAME, "Ein Untersuchescript (oder wars Neugier?)");
   // SetProp (P_KILL_NAME, "Eine Messerspitze");

   AddExit( "nordwesten", EBENE4("ebene4_x7y4.c"));
   AddExit( "sueden", EBENE4("ebene4_x8y2.c"));
}

string weiteres()
{
return "";
}

string d_messerspitze()
{
  this_player()->do_damage(150);
  return "AUA!! Die Messerspitze war scharf... Das Blut spritzt aus Deinen Fingern...\n";
}
