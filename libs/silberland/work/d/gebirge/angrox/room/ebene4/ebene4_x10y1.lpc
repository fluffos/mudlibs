    return a;
  }
*/

schluessel_fall()
  {
      object ob, room;
     
      if (!schluessel_da || present("\ngoldi", TP))
        {
          write("Die Decke besteht aus diesen violetten Steinplatten. In einer der Platten\n"
               +"ist ein Loch.\n");
          return "";
        }
      if (!(present(TAFELQUESTPERGAMENT, TP)))
        {
          write("Die Decke besteht aus diesen violetten Steinplatten. In einer der Platten\n"
               +"ist ein Loch. Woher wusstest Du nur, dass da was an der Decke ist...\n");
          return "";
        }
      write (BS("Die Decke besteht aus diesen violetten Steinplatten. In einer der Platten "
            +"ist ein Loch. Du denkst Dir, was nicht alles hier passieren koennte. "
            +"Wie leicht koennte der Gegenstand, der soeben vom Loch herausfaellt "
            +"jemanden verletzen, der so unvorsichtig ist und sich unter das Loch stellt "
            +"und nach oben sieht, nur um zu sehen, was das Loch wohl ist. Tststs. "
            +"Du verspuerst wie etwas hart auf Deinen Kopf aufschlaegt und klimpernd zu "
            +"zu Boden faellt. Du verlierst kurz die Besinnung und faellst zu Boden. Als " 
            +"Du wieder aufstehst, bemerkst Du, dass das Pergament zerfallen ist. "
            +"Es war wohl doch schon recht alt. Du nimmst den Schluessel.\n"));    
      say(BS(TPN+" schaut zur Decke. "+(PlayerGender==FEMALE ? "Sie" : "Er")+
                 " verharrt einen Moment lang in Gedanken versunken, als ploetzlich "
                 +"ein Gegenstand - offenbar ein Schluessel - auf "
                 +(PlayerGender==FEMALE ? "ihren" : "seinen")+ " Kopf faellt und "
                 +"klirrend am Boden aufschlaegt. "+TPN+" faellt zu Boden, steht "
                 +"jedoch gleich wieder auf und nimmt den Schluessel.\n"));
      ob=CLONEOB(OBJ("goldkey_eb4x10y4"));
      ob->move(TP, M_NOCHECK);
      ob=present(TAFELQUESTPERGAMENT, TP);
      ob->remove();
      TP->do_damage(10, TO);
      
      schluessel_da=0;
      return "";
 } 

