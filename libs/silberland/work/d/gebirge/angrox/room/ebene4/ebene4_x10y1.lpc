inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"
#include "../../steintafelquest.h"
int schluessel_da;

void create()
{
  ::create();

  schluessel_da=1; 
  SetProp(P_KILL_NAME, "Ein Blick nach oben");
  SetProp(P_KILL_MSG, "Blicke koennen toeten, ok?");
  AddDetail("loch", BS(
            "Das Loch hat die Form eines Schluessels. Hmmm ... seltsam, oder?\n")); 
  AddSpecialDetail("decke", "schluessel_fall");

  AddExit( "norden", EBENE4("ebene4_x10y2.lpc"));
}

string weiteres()
{
return "";
}



reset()
  {
    ::reset();
    schluessel_da = 1;
  }
