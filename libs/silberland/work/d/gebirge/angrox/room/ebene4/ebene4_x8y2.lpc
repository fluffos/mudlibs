inherit "/d/gebirge/angrox/room/ebene4/ebene4";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"
#include "../../steintafelquest.h"
int schluessel_da;

void create()
{
  ::create();
  schluessel_da = 1;
  AddDetail (({"steinhaufen", "haufen"}), BS(
               "Der Steinhaufen an der Suedwand besteht aus vielen, vielen "
              +"Steinbrocken, die wohl von der Decke gekommen sind.\n"));

  AddDetail ("steinbrocken", BS(
              "Die Steinbrocken sind eigentlich gar keine grosse Brocken, sondern "
             +"nur normalgrosse Steine, die sich zu einem riesigen Haufen "
             +"auftuermen.\n"));
  AddDetail (({"suedwand", "wand"}),BS(
             "An der Suedwand endet der Gang. Ein grosser Steinhaufen liegt da.\n"));
  AddDetail ("decke",BS(
             "Ja, tatsaechlich. Hier war ein Einsturz.\n"));
  AddDetail (({"steine", "brocken", "steinbrocken"}), BS(
              "Sie bilden mit ein bisschen Erdreich einen riesigen Haufen.\n"));
  AddDetail ("erdreich", BS(
              "Das Erdreich liegt recht locker da. Vielleicht ist es moeglich, "
             +"darin zu graben?"));
  AddCmd (({"grabe", "grab"}), "graben");
  AddItem(NPC("ghoul.lpc"), REFRESH_DESTRUCT);
  AddItem(NPC("skelett1.lpc"), REFRESH_DESTRUCT);
  AddExit( "norden", EBENE4("ebene4_x8y3"));
}

string weiteres()
{
return "An der suedlichsten Wand befindet sich ein riesiger Steinhaufen.";
}


reset()
  {
    ::reset();
    schluessel_da = 1;
  }

create_schluessel()
  {
    object a;
    a = clone_object(OBJ("silverkey_eb4x9y4.lpc"));
    return a;
  }


graben(str)
  {  
    
     if ((str == "in haufen") || (str == "in steinhaufen") || 
	(str == "in erdreich"))
       {
        if (!present("schaufel", TP) && present("spitzhacke", TP))
          {
           write("Mit einer Spitzhacke wird das wohl nicht gehen. Du brauchst "
                +"etwas, womit Du das Zeug wegrauemen kannst.\n" );
           return 1;
          }
        if(!present("schaufel", TP))
          {
           write("Du hast ja nichts zum Graben dabei!\n");
           return 1;
          }
        if(!schluessel_da)
          {
           write("Du graebst im Steinhaufen, findest aber nichts. Aber dafuer\n"
                +"bist Du jetzt schmutzig. Paranoia ist schoen, gell?\n");

           say(BS(TPN+" zueckt eine Schaufel und beginnt zu Graben. Nach "
		     +"einiger "
                     +"Zeit gibt "+(PlayerGender==FEMALE ? "sie" : "er")
                     +" entnervt auf.\n"));  
           return 1;
          }
        write ("Du beginnst zu Graben ... *aechz* ... Arbeit ... aber halt!\n"
              +"Da ist ein silberner Schluessel. Du bueckst Dich und nimmst\n"
              +"ihn.\n");
        say(BS(TPN+" zueckt eine Schaufel und beginnt zu graben. Nach einiger "
                     +"Zeit bueckt sich "+TPN+" und hebt etwas auf.\n"));
        schluessel_nehmen();
        return 1;   
       }
  write(BS("Wo oder in was willst Du denn graben?\n"));
  return 1;
 }   
                

schluessel_nehmen()
  {
    object a;
    int ret;
    a = create_schluessel();
    ret = a->move(this_player());
    if (ret==ME_TOO_HEAVY)
    {
      write("Du merkst, der Schluessel ist zu schwer. Sicherheitshalber\n"
           +"graebst Du den Schluessel wieder ein.\n");
      say (BS(TPN+"bueckt sich, legt das Gefundene zurueck und schaufelt "
             +"Erde und Steine darauf!"));
      a->remove();
      return 1;
    }
    else 
    {
     write("Du betrachtest ihn kurz und schiebst ihn ein.\n");
     say (BS(TPN+" steckst das Gefundene ein.\n"));
     schluessel_da = 0;
     return 1;
    }
  }
        
        
