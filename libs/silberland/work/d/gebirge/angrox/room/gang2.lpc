inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs (
               "Du stehst in einem kleinen Gang aus grauem Stein. Alles hier "
         +     "ist aus grauem Stein. Wie langweilig. Vom Osten faellt ein "
         +     "schwacher Lichtschein herein und es ist etwas ganz leise zu "
         +     "hoeren.\n")
        );   
        
	

  AddDetail( ({ "wand", "waende", "steinwand", 
                "steinwaende", "steinmauern", "steinmauer", 
                "mauer", "mauern" }), 
                break_string( "Im Norden und Sueden befinden sich "+
                "Steinmauern. Sie sind trocken und kuehl.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst in einem kleinen Gang.", 78 ) );
  AddDetail( ({ "stein" }),                                                    
              break_string( "Stein, Stein, Stein, alles Stein im Berg! ",78));    
                                                        

  AddDetail( ({ "dunkelheit", "finsternis" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein und ist kalt.\n",78 ) );
               
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       


  AddDetail( ({"licht", "lichtschein"}),
           "Es kommt von Osten.\n"
           );

  AddSound (DEFAULT_SOUND, "Es klingt wie entferntes Haemmern.\n");

  AddExit("osten", EBENE1("bergwerk_r1.lpc"));
  AddExit("westen", ROOM("gang1.lpc"));
}
