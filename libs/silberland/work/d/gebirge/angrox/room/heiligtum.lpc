int gib_keule(string wort)
{
  if (keule)
  {  
    geist_erscheinen(wort);
    return 1;
  }
  write(BS("Du murmelst das Wort \""+wort+"\" und wirst ploetzlich von einem leuchtenden "
        +"Glosen eingehuellt. Nie gekannte Zuversicht erfuellt Dich.\n"));

  say(TPN+ "murmelt etwas, und ploetzlich wird "+(PlayerGender==FEMALE ?
        "sie" : "er")+" von dem sanften Licht eingehuellt.\n");   
}


void geist_erscheinen(string wort)
{

  object ob, ob2;

  write(BS("Du murmelst das Wort \""+wort+"\" und wirst ploetzlich erscheint vor deinen Augen "
        +"Eine ueberirdische Gestalt. Die Gestalt spricht in einem erhabenen Tonfall: "
        +"\"Halte dich bereit fuer die letzte Pruefung!\". Sie attackiert Dich!!\n"));

  say(BS(TPN+" murmelt etwas, und ploetzlich erscheint vor "+(PlayerGender==FEMALE ?
          "ihr" : "ihm")+" eine leuchtende Gestalt. Die Gestalt spricht in einem erhabenen Tonfall:"
        +"\"Halte dich bereit fuer die letzte Pruefung!\". Sie attackiert "+TPN+"!!\n"));

  if (!present("heldengeist") && !present("lichtkeule", TP)) 
  {
    (ob=clone_object(NPC("heldengeist")))->move(TO, M_GO);
    ob->Kill(TP);
    if(ob2=present("lichtkeule", ob)) {
      ob2->SetProp("lkeule_gefunden", getuuid(TP));
    }
  }
  keule = 0;
}



string zustand()
{
  if (PlayerAlign<0) 
    return "Du fuehlst Dich hier ausgesprochen unwohl.\n";
  return "Du fuehlst Dich hier wohl.\n";
}













