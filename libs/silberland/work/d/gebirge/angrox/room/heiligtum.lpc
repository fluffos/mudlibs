inherit "std/room";

#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include "../files.h"



int keule, zufall;

int gib_keule(string wort);
void geist_erscheinen(string wort);

void create()
{
  ::create();

  keule = 1;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
      "Ein hell erleuchtete Hoehle" );
  SetProp( P_INT_LONG,BS(
        "Die Hoehle besteht vollkommen aus pulsierend leuchtenden, fast "
        +"durchsichtigen Gestein. Am Ende der Hoehle steht ein grosser Altar, "
        +"der in einem silbrigen Licht leuchtet. Die ganze Hoehle strahlt eine "
        +"Aura unbeschreiblichen Lebens aus. Es scheint ein uralter Ort der "
        +"Macht zu sein, wo vor undenklichen Zeiten den Goettern des Lichts "
        +"gehuldigt wurde.\n")+"@@zustand@@");

  SetProp(P_INDOORS,1);

  AddDetail ( ({"raum", "hoehle"}),BS(
        "Die ganze Hoehle pulsiert in einem weichen Licht. Die Ausstrahlung ist "
        + "ueberwaeltigend. Ein Altar steht im ansonsten leeren Raum.\n"));



  AddDetail ("boden", 
      "Der Boden pulsiert im Licht und scheint durchscheinend zu sein.\n");


  AddDetail ("altar",BS(
        "Der Altar pulsiert sanft im Licht des Raumes. Erst auf den zweiten "
        + " Blick bemerkst du erstaunt, dass der gesamte Altar aus Glas oder einem aehnlichen "
        + "Material besteht. Eine Inschrift ist zu erkennen.\n"));

  AddDetail ("glas",BS(
        "Der gesamte Altar besteht aus durchsichtigem Glas. Ein atemberaubender "
        +"Anblick... es scheint hier zweifelsohne richtig am Platz zu sein.\n"));

  AddDetail ( ({"schrift", "inschrift"}),BS(
        "Hmmm ... Es ist in einer seltsamen Schrift geschrieben. Vielleicht kannst "
        +"Du es ja lesen...\n"));

  AddReadDetail ( ({"inschrift", "schrift"}),BS(
        "Tja, es scheint in einer vertrauten Sprache geschrieben zu sein. Um "
        +"es zu *uebersetzen* muesstest du aber nahe an den Altar ran...gefaehrlich, "
        +"oder??\n"));

  AddDetail ("decke",
      "Selbst die Decke pulsiert in dem Licht.\n");

  AddDetail ("gestein",BS(
        "Ein solches Gestein hast du noch nie gesehen. Es ist leicht "
        +"durchscheinend und pulsiert in einem sanften Licht."));

  AddDetail ("licht",
      "Das Licht ist weich und pulsiert.\n");

  AddSound (DEFAULT_SOUND, "Eine vollkommene Stille erfuellt den Raum.\n");
  AddSound ("stille", "Die Stille ist wahrlich vollkommen.\n");



  AddCmd ("uebersetze", "translate");

  AddCmd ("ueberlege", "thinking");
  zufall=random(4)+1;
  switch(zufall)
  {
    case 1: AddCmd ("stillschweigen", "still");
            break;
    case 2: AddCmd ("vielleicht", "viel");
            break;
    case 3: AddCmd ("glas", "glas");
            break;
    case 4: AddCmd ("alt", "alt");
            break;
  }

  AddExit( "sueden",
      "/d/gebirge/angrox/room/heilig2");

}


reset()
{
  ::reset();
  keule = 1;
}



translate ( str )
{
  notify_fail("Was willst du den uebersetzen?\n");

  if (str == "runen" || str == "inschrift" || str == "schrift")
  {
    if (PlayerAlign<0)
    {
      write("Als Du dich dem Altar naeherst, faehrt ein Blitz auf Dich\n"
          +"zu und trifft dich hart.\n");
      say(TPN+" bueckt sich zum Altar hinunter. Ploetzlich wird "+PlayerGender==FEMALE?
          "sie" : "er"+" !!!!!\n");
      TP->do_damage(10,TO);
      return 1;
    }  
    switch(zufall)
    { 
      case 1: write("Du kannst folgendes uebersetzen:\n\n"
                  +"Mein Erstes sollst Du sein, wenn Du mein Letztes liest,\n"
                  +"das Ganze ist vorueber, sobald du Antwort gibst!\n");
              break;
      case 2: write("Du kannst folgendes uebersetzen:\n\n"
                  +"Mein Erstes ist nicht wenig, mein Zweites ist nicht schwer,\n"
                  +"mein Ganzes gibt Dir Hoffnung, doch trau dem nicht zusehr.\n");
              break;
      case 3: write("Du kannst folgendes uebersetzen:\n\n"
                  +"Geboren wird es aus der Glut,\n"
                  +"ein starker Atem formt es gut.\n"
                  +"Wie Wasser ist's, so klar und rein,\n"
                  +"und doch so hart wie Stahl und Stein.\n"
                  +"Was mag das fuer ein Ding wohl sein?\n");
              break;
      case 4: write("Du kannst folgendes uebersetzen:\n\n"
                  +"Was will ein jeder werden, \n"
                  +"was will keiner sein?\n");
    }       

    return 1;
  }
  return 0;
}



thinking( str )
{
  write("Du ueberlegst ... hmm ... wenn denken nur nicht\n"
      +"so schwer waere ... es muss sich wohl um ein Raetsel\n"
      +"handeln ... so was bloedes ... wenn Du nur die Loesung\n"
      +"wuestest, dann ... ja dann ... dann wuerdest du die Loesung\n"
      +"einfach...einfach... ja was eigentlich? Vielleicht wuerdest\n"
      +"du einfach die Loesung ...hmm... eingeben?\n");
  return 1;
}



object create_keule()
{
  object a;
  a = clone_object(OBJ("lkeule"));
  a->SetProp("lkeule_gefunden", getuuid(TP));
    return a;
}


int still()
{ 
  if (PlayerAlign<0)
  {
    write(BS("Du murmelst das Wort \"Stillschweigen\", und ploetzlich wirst Du "
          +"von einem grellen, schmerzenden Gleissen eingehuellt. Du "
          +"schreist vor Schmerz auf und verfluchst die Goetter des "
          +"Lichts...\n"));

    say(TPN+ "murmelt etwas, doch ploetzlich wird "+(PlayerGender==FEMALE ?
          "sie" : "er")+" von einem grellen Gleissen einghuellt. "+(PlayerGender==FEMALE ? "Sie" : "Er")+
        " schreit auf und verflucht die "
        +"die Goetter des Lichts ...\n"); 
    TP->do_damage(20,TO);
    return 1;
  }
  gib_keule("Stillschweigen");
  return 1;
}



