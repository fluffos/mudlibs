

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include <defines.h>
#include "../../files.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";


create()
{
  ::create();
  SetProp(P_COMPILER_PATH, EBENE2("") );
  SetProp(P_STD_OBJECT, EBENE2("ebene2_r13"));
  SetProp(P_VALID_NAME, ({"ebene2_r13"}));
}


string Validate(string file)
{
  string name, wer;
  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, wer) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, EBENE2("ebene2_r13"));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo,wer;
  if (!(name = ::CustomizeObject())) return 0;
  if(sscanf(name,"%s:%s",foo,wer)!=3) return 0;
  //check_room(foo+":"+x+":"+y);
  //TELL("angrox", sprintf("%O\n", loaded_rooms));
  return 1;
}

