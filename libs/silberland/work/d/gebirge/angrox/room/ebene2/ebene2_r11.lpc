inherit "/d/gebirge/angrox/room/std_bergwerk_new";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Ein Gang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Felswaende dieses Ganges sind offenbar voellig unbehauen und wirken "
                +"sehr alt. Mehrere leere Fackelhalter, die an den Waenden befestigt sind, "
                +"sind der einzige Schmuck dieses Ganges. Einige silbrige Faeden durchziehen "
                +"das Gestein. Ueberall am Boden verstreut "
                +"liegen zwergische Skelette, welche in verrostete Ruestungen gehuellt "
                +"sind. Zerborstene, verrostete Waffen liegen neben ihnen. Hier scheint "
                +"vor Urzeiten ein moerderischer Kampf stattgefunden zu haben.\n")); 

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  AddDetail ( ({"raum", "gang"}),BS(
		 "Der Gang besteht vollkommen aus hartem Fels, welcher von silbrigen "
                +"Faeden durchzogen ist.\n"));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein, von silbernen Faeden durchzogen.\n");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergweoehnlich hart.\n"));

  AddDetail( ({"faeden", "einschluesse"}),BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair.\n"));
  
  AddDetail( ({"fackelhalter", "halter"}),BS(
            "Die Fackelhalter bestehen aus bestem Stahl (rostfrei). Sie sind an der Wand "
           +"befestigt, allerdings befinden sich keine Fackeln in ihnen.\n"));

  AddDetail(({"schmuck", "flair"}),BS(
            "Jo, diese Einschluesse sehen wirklich gut aus.\n"));

  AddDetail(({"skelett", "skelette"}),BS(
            "Die Skelette stellen die sterblichen Ueberreste der Zwerge da, die im Kampf "
           +"gegen - ja gegen was eigentlich - gefallen sind. Einige Brustkoerbe "
           +"der Skelette scheinen von innen heraus geborsten zu sein.\n"));
 
  AddDetail(({"ruestung", "ruestungen"}),BS(
            "Die Ruestungen sind alt und verrostet. Sie weisen keinerlei Besonderheit auf.\n"));

  AddDetail("waffen",BS(
            "Die Waffen - fast nur Aexte - sind verrostet und teilweise zerbrochen.\n"));
   AddDetail ("brustkoerbe", BS(
             "Unglaublich, aber wahr. Einige scheinen von INNEN heraus geborsten zu sein.\n"));

  AddDetail("aexte", BS(
            "Die Aexte mochten frueher einaml sicherlich fuerchterliche Waffen "
           +"gewesen sein, heute jedoch sind sie alt und verrostet, teilweise "
           +"sogar zerbrochen.\n"));
  AddSound(DEFAULT_SOUND,BS("Es ist totenstill.\n"));
 
  AddExit("suedwesten", EBENE2("ebene2_r10"));
  AddExit("suedosten", EBENE2("ebene2_r12"));
}


