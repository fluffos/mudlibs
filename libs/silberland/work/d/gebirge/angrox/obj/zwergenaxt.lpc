inherit "/std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include "../files.h"


create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId (({"axt", "zwergenaxt"}));     // Definition der Identifikation
  SetProp (P_SHORT, "Eine Zwergenaxt");    //Kurzbeschreibung
  
  SetProp (P_LONG, 
      "Diese Zwergenaxt wird von den besten Zwergenkaempfern\n"
     +"zweihaendig gefuehrt. Eine maechtige Waffe.\n");

  SetProp (P_INFO, 
       "Die Zwergenaxt kann nur von Zwergen effektiv genutzt werden.\n"
      +"Alle anderen Rassen koennen diese Waffe nicht effektiv fuehren.\n");

  SetProp (P_NAME, "Zwergenaxt"); 
  SetProp (P_GENDER, FEMALE);   // Geschlechtsspezifische Einordnung

  SetProp (P_VALUE,1400 );    // Wert der Waffe
  SetProp (P_WEIGHT, 1750);   // Gewicht in Gramm
  
  SetProp(P_WC,160);
  SetProp(P_WC_FIXFACTOR, 0.2);
  SetProp (P_WEAPON_TYPE, WT_AXE);  // Waffenart
  SetProp (P_DAM_TYPE, DT_SLASH);   // Art des Schadens
  
  SetProp (P_NR_HANDS, 2);  // Haende zum Fueheren der Waffe
  SetProp (P_MATERIAL, ([MAT_STEEL:80, MAT_OAK:20]));   // Material der Waffe
  SetProp (P_WC_BONUS, (["Zwerg":40, "Zwergenspieler":20, "zwerg": 40,
        "zwergenberserker": 100, "brueckenwaechter":100,
        "Axtkaempfer":30, "Axtexperte":90, "Axtmeister":250 ]));
}


