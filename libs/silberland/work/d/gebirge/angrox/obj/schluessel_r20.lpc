/*
** Der Schluessel zum Manntor
** 
** 23-06-1996  Angrox@SL
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein schwerer Eisenschluessel");
  SetProp (P_LONG, BS(
               "Der Schluessel besteht aus massivem Eisen. Was er wohl "
               "aufsperren mag...\n"));
  SetProp (P_NAME, "Eisenschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_IRON);
  AddId (({"schluessel", "eisenschluessel"}));
  AddDetail( "eisen",   // woody war fad also hat er dieses detail gemacht ;)
    "Der Schluessel besteht doch tatsaechlich aus Eisen, welch Ueberraschung.");
}

string QueryDoorKey()
{
  return EBENE1("bergwerk_r20")+":"+EBENE1("bergwerk_r21");
}
