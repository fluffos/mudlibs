/*
** Die magischen Wunderstiefel.
** 18-11-96 Angrox@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"stiefel","wunderstiefel"}));
  SetProp (P_SHORT, "Ein Paar magische Wunderstiefel");
  SetProp (P_LONG, BS("Die Stiefel bestehen aus feinstem Leder. Ein "
                  +"grosser Schriftzug ist auf ihnen aufgedruckt.\n"));
  SetProp (P_NAME, "Paar magische Wunderstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 350);
  SetProp (P_VALUE, 500);
  SetProp (P_INFO, BS("Das ist ein ganz normales, billiges Werbegeschenk. "
                  +"Sie schuetzen auf magische Weise gegen Fusspilz.\n")); 
  SetProp (P_ARMOUR_TYPE, AT_BOOT);  // siehe sys/combat.h
  SetProp (P_AC, 1);
  SetProp (P_MATERIAL, MAT_LEATHER);
  AddDetail(({"schrift", "schriftzug"}), BS(
          "Du kannst die Schrift lesen, wenn Du lesen kannst.:)\n"));
  AddReadDetail(({"schrift", "schriftzug"}), BS(
          "Da steht: Werbegeschenk der Midas-Fusskulturgesellschaft e.V.\n"));
}
