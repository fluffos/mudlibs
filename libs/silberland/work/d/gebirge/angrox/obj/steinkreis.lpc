inherit "std/thing";

#include <properties.h>     // Properties definieren
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"kreis", "steinkreis"}));     // Definition der Identifikation
  SetProp (P_SHORT, "Ein steinerner Kreis");    //Kurzbeschreibung
  SetProp (P_LONG,BS("Der Steinkreis besteht vollkommen aus Stein, genauer gesagt "
                    +"aus mit Silberfaeden durchzogenen Marmor.\n"));
  SetProp (P_NAME, "Steinkreis");
  SetProp (P_GENDER, MALE);  // Geschlechtsspezifische Einordnung
  SetProp (P_VALUE, 20);    // Wert
  SetProp (P_WEIGHT, 500);   // Gewicht in Gramm
  SetProp (P_NOBUY, 1);      // Nicht mehr zu kaufen wenn verkauft
  SetProp (P_MATERIAL, MAT_MARBLE);   // Material=Gold
  AddDetail("stein",BS(
            "Der Kreis besteht aus Marmor.\n"));
  
  AddDetail("marmor",BS(
            "Der Marmor, aus dem der Kreis besteht, ist von schwarzer Farbe und "
           +"mit Silberfaeden durchzogen. Irgendwie scheint von dem Kreis eine "
           +"eigentuemliche Aura auszugehen.\n"));
  
  AddDetail( ({"faeden", "silberfaeden"}),BS(
            "Der Marmor ist damit durchzogen.\n"));

  AddDetail("aura",BS(
            "Ja, meinst du etwa du kannst sie sehen ????\n")); 

}

