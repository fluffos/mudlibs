inherit "std/thing";

#include <properties.h>
#include <language.h> 
#include <defines.h>
#include <moredef.h>
#include "../files.h"

nosave int nummer=0;
nosave int diamonds=0;
nosave int ring=0;
nosave int speichern=0;
nosave int entladen=0;
nosave int pool=0;
nosave int used=0;
nosave int reboot=10;
nosave int reboot_dia=0;
nosave object pl;
nosave string secrets();
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SUID;
//  write_file(LOG("o_schale.log"), sprintf("%s: PO: %O, UID: %s, TO: %O\n", 
//      dtime(time()), previous_object(), getuid(previous_object()), TO));
  AddId (({"schale", "obsidianschale"}));   
  SetProp(P_NOBUY, 1);
  SetProp (P_SHORT, "Eine Obsidianschale");
  SetProp (P_LONG, 
      "Die kleine Schale besteht aus einer glasaehnlichen Substanz. "
      +"Ihr Rand ist ueber und ueber mit geheimnisvollen Symbolen "
      +"verziert.\n"); 
  SetProp (P_NAME, "Obsidianschale");
  SetProp (P_GENDER,FEMALE); 
  SetProp (P_VALUE, 30000);  
  SetProp (P_WEIGHT, 200); 
  SetProp (P_NOBUY, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_OBSIDIAN); 
  SetProp (P_AUTOLOADOBJ, 10);
  AddDetail("symbole", 
      "Du kannst den Sinn der Symbole nicht entziffern. Noch nicht ...");
  AddCmd(({"lege", "leg"}), "InSchale");
  AddCmd("lobryx", "Speichern");
  AddCmd("bylorx", "Entladen");
}

reset() {
  ::reset();
  if(reboot)
    reboot--;
}
/*
mixed QueryProp(string name) {
 if(name==P_INFO) return secrets();
 else return ::Query(name);
}
*/
string info() {
  string text;
  text="";
  if(!objectp(pl)) 
    pl=TP;
  if(TP!=pl) {
    pl=TP;
    nummer=0;
    speichern=0;
    entladen=0;
    pool=0;
    diamonds=0;
    ring=0;
  }
  if(TP->QueryProp(P_GUILD) == "berserker") {
    return BS("Das ist keine Axt, damit kannst Du nichts anfangen!");
  }
  if(nummer>=0)
    text+="Als Du die Schale untersuchst, stellst Du fest, dass "
      +"sie offenbar hochmagisch ist. ";
  if(nummer>=2)
    text+="Die magischen Muster, die Du um die Schale herum siehst, stammen "
     +"aus dem Bereich der Metamagie. ";
  if(nummer>=3)
    text+="Sie formen am Boden der Schale zwei Symbole. ";
  if(nummer>=4)
    text+="Die Symbole haben verschiedene Formen. ";
  if(nummer>=5)
    text+="Das eine Symbol sieht wie ein Ring aus. ";
  if(nummer>=6)
    text+="\b\b, dass andere wie ein kleiner Stein. ";
  if(nummer>=7) 
    text+="Vielleicht solltest Du einen Ring und einen Stein "
      +"in die Schale legen? ";
  if(nummer>=8)
    text+="Du bist Dir ziemlich sicher, dass es sich bei dem Stein "
      +"vermutlich um einen Edelstein handeln muss. ";
  if(nummer>=9) 
    text+="\b\b, und zwar um einen Diamanten. ";
  if(nummer>=11 && nummer<=14) {
    switch(random(4)){
      case 0: text+="Nein, nicht einen, es muessen mehr sein... ";
              break;
      case 1: text+="Nicht nur ein Diamant, sondern mehrere! ";
              break;
      case 2: text+="Vermutlich musst Du sogar mehrere Diamanten in "
              +"Schale legen. ";
              break;
      case 3: text+="Es gehoeren mehrere Diamanten in die Schale!\n";
              break;
    }
  }
  if(nummer>=15)
    text+="Du musst in Summe 20 Diamanten in die Schale legen. ";
  if(nummer>=16 && nummer<=19 && diamonds<20)
    text+="Du kannst nicht erkennen, wie der Ausloeser funktioniert! ";
  if(diamonds>=20 && ring && nummer>=16) { 
    text+="Du entzifferst die Symbole auf der Schale: Mit 'lobryx' "
      +"kannst Du Magiepunkte in der Schale speichern. ";
    speichern=1;
  }
  if(speichern && nummer<19)
    text+="Mehr erkennst Du momentan nicht. ";
  if(speichern && nummer>=19) {
    text+="\b\b, und mit 'bylorx' uebertraegt Dir die Schale einen Teil ihrer "
      +"gespeicherten Energie. ";
    entladen=1;
    //write_file("../log/o_schale.log", sprintf("%s: Schale entschluesselt! PO: "
    //    +"%O, UID: %s, TO: %O\n", dtime(time()), previous_object(), 
    //    getuid(previous_object()), TO));
  }
  if(entladen && nummer>=25)
    text+="Fuer je 3 weitere Diamanten kannst Du die Schale fuer eine gewisse "
      +"Zeit rebootsicher machen. ";
  nummer++;
  return BS(text);
}


nosave int InSchale(string str) {
  string was, wo;
  object ob;
  if(nummer<6) return 0;
  if(!str) return 0;
  if(sscanf(str, "%s in %s", was, wo)!=2) return 0;
  if(TP->QueryProp(P_GUILD) == "berserker") return 0;
  if(member(({"schale", "obsisdianschale"}), wo)==-1)
    return 0;
  if(!ob=present(was, TP)) return 0;
  if(!ob->id("ring")&&(!ob->id("diamant")||nummer<9)) {
    write(sprintf("Nichts passiert. Du nimmst %s wieder aus der "
        +"Schale.\n", ob->Name(WEN)));
    return 1;
  }
  if(ob->id("ring") && !ob->id("astralring")) {
    write(BS("Du legst den Ring in die Schale. Jedoch nichts "
        +"passiert, ausser das sich der Ring aufloest.\n"));
    ob->remove();
    return 1;
  }
  else if(ob->id("astralring")) {
    write(BS("Du legst den Astralring in die Schale. Er loest sich "
        +"unter farbigem Licht auf und seine Substanz geht auf die "
        +"Schale ueber."));
    say(BS(sprintf("%s legt einen Astralring in eine Schale, die %s bei sich "
        +"traegt.", TP->Name(WER), TP->QueryPronoun(WER))));
    ring=1;
    ob->remove();
    return 1;
  }
  else {
    write(BS("Du legst den Diamant in die Schale und er loest sich auf."));
    say(BS(sprintf("%s legt einen Diamanten in eine Schale, die %s bei sich "
        +"traegt.", TP->Name(WER), TP->QueryPronoun(WER))));
    diamonds++;
    if(diamonds>20 && nummer>=25 && entladen) {
      reboot_dia++;
      if(reboot_dia>=3) {
        if(QueryProp(P_AUTOLOADOBJ))
          write(BS("Die Schale ist schon rebootsicher!"));
        else {
          write(BS("Die Schale ist nun rebootsicher!"));
          reboot++;
          reboot_dia=0;
          diamonds-=3;
        }
      }
    }
    if(ob->QueryProp(P_AMOUNT)>1) 
      ob->SetProp(P_AMOUNT, ob->QueryProp(P_AMOUNT)-1);
    else ob->remove();
    return 1;
  }
  if(diamonds>=20 && ring && nummer>=15) {
    write(BS("Ploetzlich leuchtet die Schale grell auf. Vielleicht solltest "
        +"Du sie nun nocheinmal magisch untersuchen?"));
    say(BS(sprintf("%s Schale leuchtet ploetzlich grell auf!\n", 
        TP->Name(WESSEN))));
  }
  return 1;
}

nosave int Speichern() {
 if(!speichern) return 0;
 if(TP->QueryProp(P_SP)<20) {
   write("Du hast nicht genug Magie!\n");
   return 1;
 }
 if(pool==TP->QueryProp(P_MAX_SP)) {
   write("Die Schale ist bereits voll aufgeladen!\n");
   return 1;
 }
 pool+=20;
 if(pool>=TP->QueryProp(P_MAX_SP)) {
   pool=TP->QueryProp(P_MAX_SP);
   write("Die Schale ist nun voll aufgeladen!\n");
 }
 else write("Du speicherst 20 Magiepunkte in die Schale.\n");
 TP->SetProp(P_SP, TP->QueryProp(P_SP)-20);
 return 1;
}

nosave int Entladen() {
 int rnd;
 if(!entladen) return 0;
 if(!pool) {
   write("Die Schale hat keine Energie mehr!\n");
   return 1;
 }
 if(used>50) {
   if(!random(1000-used)) {
     write("Die Schale loest sich in einer lautlosen Lichtexplosion "
       +"auf!\n");
     say(BS(sprintf("Irgendetwas von %s Ausruestung loest sich in einer "
       +"lautlosen Lichtexplosion auf!\n", TP->Name(WESSEN))));
     TP->restore_spell_points(pool);
     ME->remove();
     return 1;
   }
 }
 write("Die Schale uebertraegt Dir ihre komplette Magie!\n");
 say(BS(sprintf("%s Schale leuchtet auf. %s scheint sich nun "
     +"maechtiger zu fuehlen!", TP->Name(WESSEN), 
     CAP(TP->QueryPronoun(WER)))));
 used++;
 pool=(2*pool/3)-10+random(5);
 if(pool<1) pool=1;
 TP->restore_spell_points(pool);
 pool=0;
 return 1;
}

string QueryVariables() {
  return sprintf("Nummer: %d, Diamonds: %d, Ring: %d, Speichern: %d, "
      +"Entladen: %d, Pool: %d, Used: %d\n",nummer,diamonds,ring, 
      speichern,entladen,pool,used);
}

// Hier wird das Mapping wieder in die Properties eingetragen
mixed _set_autoloadobj(mixed data)
{
  if(mappingp(data) && sizeof(data)==6 && reboot){
    diamonds=data["diamonds"];
    ring=data["ring"];
    used=data["used"];
    nummer=data["nummer"];
    speichern=data["speichern"];
    pl=find_player(data["spieler"]);
  }
  return 0 ;
}

// Und hier wird gespeichert
mixed _query_autoloadobj()
{
  if(reboot)
    return (["diamonds": diamonds, 
             "used": used,
             "ring": ring,
             "speichern": speichern,
             "nummer":nummer,
             "spieler": (objectp(pl)?getuid(pl):"")]); 
  return 0;
}
