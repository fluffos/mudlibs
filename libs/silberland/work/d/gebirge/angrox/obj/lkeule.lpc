inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include <class.h>
#include "../files.h"
//#define PlayerAlign this_player()->QueryProp(P_ALIGN)
//#define PlayerLevel this_player()->QueryProp(P_LEVEL)

#define ABS(x) (x>0?x:-x)

int doppelt=0;
int hitcounter=0;
create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
 
  SetProp(P_SHORT, "Eine Lichtkeule");    //Kurzbeschreibung
  SetProp(P_LONG, 
     "Die Keule ist gut und gern so lang wie dein Unterarm und von einem "
     "seltsamen, weissen Glosen umgeben. An einigen Stellen leuchtet die "
     "Keule heller, und es scheint als wuerden dort Runen zu sehen sein.\n ");  
  SetProp(P_INFO, BS(
      "Die Lichtkeule ist ein Artefakt der Goetter des Lichts. "
      "Nur Lebewesen mit guter Gesinnung koennen sie fuehren. "
      "Der Schaden der Waffe steigt mit der Gesinnung. "
      "VORSICHT! Der Gesundheitsmagier warnt: "
      "Das Besitzen von mehr Exemplaren dieser Waffe gefaehrdet Ihre "
      "Gesundheit."));
  AddId( ({"keule", "lichtkeule"}) );       // IDs
  SetProp(P_NAME, "Lichtkeule");
  SetProp(P_GENDER, FEMALE);  
  SetProp(P_VALUE, 2000+random(1001)); 
  SetProp(P_WEIGHT, 1000); 
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, ({DT_LIGHT, DT_BLUDGEON})); 
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WC,230);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_MISC_MAGIC);
  SetProp(P_KILL_NAME, "Diabolisches Verhalten"); 
  SetProp(P_KILL_MSG, "HAHA, wieder ein FREVLER weniger. ;>");  
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:18, A_STR:15]) );
  SetProp(P_WIELD_FUNC,TO);
  SetProp(P_UNWIELD_FUNC, TO);
  SetProp(P_HIT_FUNC,TO);
  AddDetail("runen",BS(
  	"Die Runen leuchten in einem ueberirdischen Leuchten. Sie scheinen "
        "uralt zu sein und mit einem Mal ueberkommt dich das Gefuehl, eine "
        "Waffe in den Haenden zu halten, die schon vor den heute bekannten "
        "Rassen existiert hat ...\n"));

}


WieldFunc() {
  int align;
  object ob;
  if (PlayerAlign<=0) {
    write("Du versuchst die Keule zu zuecken. Als du es probierst,\n"
	"umhuellt dich die Aura der Keule und verspuerst einen\n"
	"fuerchterlichen Schmerz!\n");
    say (TPN+" wird von einer gleissenden Aura eingehuellt und schreit\n"
            +"furchtbar auf.\n");
    TP->do_damage(10+ABS(PlayerAlign/10),TO);
    return 0;
  }
  if(doppelt)
     SetProp(P_WC, 5);
  if((TP->QueryProp(P_MAX_HANDS)-TP->QueryProp(P_USED_HANDS))>0)
    SetProp(P_LIGHT, 1);
	return 1;
}

UnwieldFunc() {
  SetProp(P_LIGHT, 0);
  if(PlayerAlign < 0) {
    TP->do_damage(5+ABS(PlayerAlign/10),TO); 
    write("Die Waffe verbrennt Dir Die Handflaeche !!!!!!!!!!\n");
  }
  return 1;
}

int HitFunc(object enemy) {
  int ea;
  int dam;
  object user;
  dam=0;
  hitcounter++;
  user=previous_object()->QueryProp(P_WIELDED);
  if(hitcounter > 100) {
      tell_object(user, "Die Lichtkeule strahl auf wie die Sonne.\n");
      dam+=200+random(50);
      hitcounter=0;
  }
  ea=enemy->QueryProp(P_ALIGN);
  if(ea<-1000) ea=-1000;
  if(PlayerAlign<-50) {
    write("Die Waffe wird gluehend heiss und verbrennt dich schwer!\n");
    TP->do_damage(5,TO);
    return -130;
  }
  if(enemy->is_class_member(CL_UNDEAD))
  {
    if( random(11)<hitcounter ) {
      tell_object(user,
        "Die Magie der Lichtkeule wendet sich gegen "+enemy->name(WEN,1)+".\n");
      dam+=random(100)+100;
      user->AddHP(random(20));
      user->AddSP(random(20));
      hitcounter=0;
    }
    dam+=50;
  }
  if(ea>500) {
    write("Die Waffe weigert sich richtig zuzuschlagen!\n");
    return -ea/3;
  }
  if(ea<-500)
    dam+=PlayerAlign/20 - ea/15;
  if(ea<0)
     dam+=PlayerAlign/20;
  return dam;   
}
