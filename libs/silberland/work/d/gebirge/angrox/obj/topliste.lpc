inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "/p/daemon/skillmaster/skillmaster.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine steinerne Tafel");
  SetProp(P_LONG,"Auf der Tafel sind die besten Graeber und die besten "
      "Schuerfer festgehalten. Mit 'topgraeber 1-100' und 'topschuerfer 1-100'"
      " kannst Du Dir diese Listen ansehen.");
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,20);
  AddId( ({"tafel", "steintafel"}) );
  SetProp(P_NAME,"Steintafel");
  SetProp(P_NOGET,"Die Steintafel ist an der Wand befestigt.\n");
  seteuid(getuid(this_object()));
  AddCmd("topgraeber", "tg_func");
  AddCmd("topschuerfer", "ts_func");
}

int tg_func(string str){
  int i;
  string output;
  notify_fail("Kommando: topgraeber <1-100>\n");
  if(!str) return 0;
  i=to_int(str);
  if(i<1 || i>100) return 0;
  output=SKILLMASTER->QueryTopList(i,SK_DIGGING);
  tell_object(TP, "                    TOPGRAEBER\n");
  TP->More(output);
  return 1;
}

int ts_func(string str){
  int i;
  string output;
  notify_fail("Kommando: topschuerfer <1-100>\n");
  if(!str) return 0;
  i=to_int(str);
  if(i<1 || i>100) return 0;
  output=SKILLMASTER->QueryTopList(i,SK_PROSPECT);
  tell_object(TP, "                    TOPSCHUERFER\n");
  TP->More(output);
  return 1;
}
