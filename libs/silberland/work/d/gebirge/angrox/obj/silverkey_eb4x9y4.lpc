/*
** Der Schluessel zum Bronzetor
** 
** 08-10-1996  Angrox@SL
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Silberschluessel");
  SetProp (P_LONG, BS(
               "Der Schluessel besteht aus Silber. Was er wohl "
               "aufsperren mag...\n"));
  SetProp (P_NAME, "Silberschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  AddId (({"silberschluessel", "schluessel"}));
  
}

string QueryDoorKey()
{
  return EBENE4("ebene4_x10y4")+":"+EBENE4("ebene4_x9y4");
}











