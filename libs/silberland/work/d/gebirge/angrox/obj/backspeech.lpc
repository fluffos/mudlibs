inherit "std/thing";

#include <properties.h>
#include "../files.h"

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst rueckwaerts.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"backspeech", "\nbackspeech", "\nsprachfluch"}));
  owner=0;
}


reset()
{ 
  ::reset();
  dauer++;
  if (dauer>=5)
    {
      dauer=0;
      ME->remove();
    }  
}


init()
{
  ::init();
  if (owner && interactive(owner))
     {
            owner->SetProp(P_PERM_STRING, 0);
            owner=0;
     }
  if (environment()==TP)
     {
           owner=TP;
           owner->SetProp(P_PERM_STRING, this_object());
     }
   
}

string permutate_string (string str)
{
 string transformed, coo;
 string sign;
 int i,j,k,l, string_length, pos, abzug;
 transformed=str;
 coo=str;
 sign=str;
 j=0;
 pos=0;
 abzug=1;
 string_length=strlen(coo);

 
 for (i=0;i<=string_length; i++)
   {
	 if (coo[i]==' '||(i==string_length))
	   {
		 for (l=i-1;l>=pos;l--)
		   {
			  if(coo[l]=='.' ||coo[l]=='!'
			   ||coo[l]=='?' ||coo[l]==',')
				{
				   sign[abzug-1]=coo[l];
				   abzug++;
				}
		   }
		 if(coo[pos]>='A' && coo[pos]<='Z' && coo[i-abzug]>='a'
		   &&coo[i-abzug]<='z')
		   {
			  coo[pos]=coo[pos]+32;
			  coo[i-abzug]=coo[i-abzug]-32;
		   }
		 for(k=i-abzug; k>=pos;k--)
		   {
			  transformed[j++]=coo[k];
		   }
		 if (abzug>1)
		   {
			  for (l=0;l<=abzug-2;l++)
				   transformed[j++]=sign[l];
			  abzug=1;
		   }
		 if(i<string_length)
			  transformed[j++]=' ';
		 pos=i+1;

	   }
   }

 return transformed;
}



string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
        return bs ("Sie ist verflucht und kann nicht mehr richtig sprechen.\n");
  else
        return bs ("Er ist verflucht und kann nicht mehr richtig sprechen.\n");
}
