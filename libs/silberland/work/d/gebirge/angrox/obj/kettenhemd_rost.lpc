inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId ("kettenhemd");  
  AddAdjective( ({"rostiges", "rostig"}) );
  SetProp (P_SHORT, "Ein rostiges Kettenhemd");
  SetProp (P_LONG, BS(
                  "Das Kettenhemd ist ueber und ueber mit Rostspuren bedeckt, hier "
                 +"da siehst du auch eine tiefe Scharte.\n"));
  SetProp (P_NAME, "Kettenhemd");
  SetProp (P_NAME_ADJ, "rostig");
  SetProp (P_GENDER, NEUTER);  
  SetProp (P_WEIGHT, 1550);  
  SetProp (P_VALUE, 500);   
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 12);
  SetProp (P_DAMAGED, 14);
  SetProp (P_MATERIAL, ([MAT_STEEL:80, MAT_MISC_METAL:20])); 
  AddDetail (({"rostspuren", "spuren"}), BS(
         "Scheint lange niemand geputzt zu haben. An einigen Stellen "
        +"ist es schon fast durchgerostet.\n"));
  AddDetail ("scharten", BS(
         "Es hat wohl schon viele Kaempfe hinter sich.\n"));
}
