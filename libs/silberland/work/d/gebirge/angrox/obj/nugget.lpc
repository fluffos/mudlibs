inherit "std/thing";

#include <properties.h>     // Properties definieren
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"nugget", "goldnugget"}));     // Definition der Identifikation
  SetProp (P_SHORT, "Ein Goldnugget");    //Kurzbeschreibung
  SetProp (P_LONG, "Dieser Goldnugget ist sicherlich viel wert.\n");
  SetProp (P_NAME, "Goldnugget");
  SetProp (P_GENDER, MALE);  // Geschlechtsspezifische Einordnung
  SetProp (P_VALUE, 150);    // Wert
  SetProp (P_WEIGHT, 50);   // Gewicht in Gramm
  SetProp (P_NOBUY, 1);      // Nicht mehr zu kaufen wenn verkauft
  SetProp (P_MATERIAL, MAT_GOLD);   // Material=Gold
}

