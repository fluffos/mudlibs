/*
** Der Schluessel zum Goldtor
** 
** 08-10-1996  Angrox@SL
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Goldschluessel");
  SetProp (P_LONG, BS(
               "Der Schluessel besteht aus purem Gold. Was er wohl "
               "aufsperren mag...\n"));
  SetProp (P_NAME, "Goldschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_GOLD);
  AddId (({"goldschluessel", "schluessel", "\ngoldi"}));
  
}

string QueryDoorKey()
{
  return EBENE4("ebene4_x10y4")+":"+EBENE4("ebene4_x11y4");
}











