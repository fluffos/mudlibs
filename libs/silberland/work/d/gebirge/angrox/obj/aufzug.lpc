inherit "std/transport";

#include <properties.h>
#include <language.h>
#include "../files.h"
create()
{
   
  ::create();
  
  SetProp( P_NAME, "Aufzug" );
  AddId( ({ "aufzug", "lift" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_INT_SHORT, "In einem mechanischen Aufzug" );
  SetProp( P_INT_LONG,BS(
	  "Du befindest Dich in einem unkomfortablen, rumpelnden Aufzug. Er "
         +"befoerdert Dich (hoffentlich) sicher in die Tiefen des Bergwerks "
         +"und wieder zurueck.\n"));
	 
  SetProp( P_SHORT, "Ein mechanischer Aufzug" );
  SetProp( P_LONG,BS(
          "Der Aufzug ist eine zwergische Konstruktion, die ueber eine "
         +"komplizierte Konstruktion von Seilen, Umlenkrollen und "
         +"Dampfkesseln sich hier in diesem Schacht aufwaerts und abwaerts "
         +"bewegen kann.\n"));
	  
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,0);  
  SetProp( P_DEPARTMSG, ({
    "Der Aufzug setzt sich in Bewegung.\n", 
    "Der Aufzug faehrt ab.\n"}) );  
  SetProp( P_ARRIVEMSG, ({
    "Der Aufzug naehert sich @@QueryArrived@@ und bleibt stehen.\n",
    "Ein Aufzug kommt an.\n"}) );
  // Die erste Meldung ist fuer Leute auf der Wolke.
  // Die zweite fuer Leute in dem Raum, aus dem die Wolke abreist.    
  SetProp( P_ENTERMSG, ({
    "betritt den Aufzug",
    "kommt herein"}) );  
  SetProp( P_LEAVEMSG, ({
    "verlaesst den Aufzug",
    "kommt aus dem Aufzug"}) );
  SetProp( P_LEAVEFAIL, "Du kannst den Aufzug nicht verlassen, wenn er sich bewegt" );
  SetProp( P_ENTERFAIL, "Es passen nur 5 Passagiere in den Aufzug" );
 
  SetProp( P_MAX_PASSENGERS, 5 );
  
  /* Verben */
  AddCmd("betrete", "betrete" );
  AddCmd("verlasse", "verlasse");

  /* Kurs */
  AddRoute(EBENE1("bergwerk_r34"), 25, 7, "Ebene 1", ({"ebene 1", "1. ebene",
        "ersten ebene"}), "zur Ebene 1");
  AddMsg( "Der Aufzug faehrt nach Ebene 2.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  AddRoute(EBENE2("bergwerk_e2_r1"), 25, 7, "Ebene 2",({"ebene 2", "2. ebene",
        "zweiten ebene"}), "zur Ebene 2");
  AddMsg( "Der Aufzug faehrt nach Ebene 3.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  AddRoute(EBENE3("bergwerk_e3_r1"), 25, 7, "Ebene 3",({"ebene 3", "3. ebene",
        "dritten ebene"}), "zur Ebene 3");
  AddMsg( "Der Aufzug faehrt nach Ebene 2.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  AddRoute(EBENE2("bergwerk_e2_r1"), 25, 7, "Ebene 2",({"ebene 2", "2. ebene",
        "zweiten ebene"}), "zur Ebene 2");
  AddMsg( "Der Aufzug faehrt nach Ebene 1.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  Start();
 
  AddDetail("boden",BS(
            "Der Boden besteht aus massivem Holz.\n"));

  AddDetail( ({"wand", "waende"}),BS(
            "Die Waende bestehen aus Holz.\n"));

  AddDetail("decke", BS(
            "Die Decke ist aus Holz.\n"));
 
  AddDetail("holz",BS(
            "Das Holz ist aus Holz. Es sieht sehr stabil aus.\n"));


  AddDetail("aufzug", 
            "Du befindest Dich darin.");
}

betrete(str)
{
 notify_fail("Was willst Du denn betreten?\n");
 if (str=="aufzug")
   return Enter();
 return 0;
}

verlasse(str)
{
 notify_fail("Was willst du denn verlassen?\n");
 if (str=="aufzug")
   return Leave();
 return 0;
}
 
