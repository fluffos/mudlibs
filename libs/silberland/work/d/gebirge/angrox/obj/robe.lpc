** Robe
** ---
** 27-06-1996 by Angrox@Silberland
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("robe" );
  SetProp (P_SHORT, "Eine leichte Robe");
  SetProp (P_LONG, "Dies ist eine leichte Robe aus schwarzem Leinen.\n "
          );
  SetProp (P_NAME, "Robe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 200);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);
  SetProp (P_MATERIAL, MAT_COTTON);
}
