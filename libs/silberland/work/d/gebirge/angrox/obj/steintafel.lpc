inherit "std/thing";

#include <properties.h>     
#include <language.h>       
#include <wizlevels.h>       
#include "../files.h"

int archset=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({"tafel", "steintafel"}));     
  SetProp (P_SHORT, "Eine steinerne Tafel");   
  SetProp (P_LONG,BS("Die Tafel besteht aus einer Art Marmor. Sie fuehlt sich "
                    +"angenehm warm an. Sie ist ueber und uber mit Symbolen, "
                    +"die in den Stein eingraviert sind.\n"));
  SetProp (P_NAME, "Steintafel");
  SetProp (P_GENDER, FEMALE);  
  SetProp (P_VALUE, 20);    
  SetProp (P_WEIGHT, 900);   
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);     
  SetProp (P_MATERIAL, ([MAT_MARBLE:98, MAT_SILVER:2]));   
  AddDetail("marmor",BS(
            "Der Marmor, aus dem die Tafel besteht, ist von reinweisser Farbe und "
           +"mit Silberfaeden durchzogen. Irgendwie scheint von der Tafel eine "
           +"wohltuende Aura auszugehen.\n"));
  
  AddDetail( ({"faeden", "silberfaeden"}),BS(
            "Der Marmor ist damit durchzogen.\n"));

  AddDetail("aura",BS(
            "Ja, meinst du etwa du kannst sie sehen ????\n")); 
  AddDetail ("symbole", BS("Vielleicht kannst Du sie lesen?\n"));
  AddReadDetail("symbole", BS("Leider kannst Du sie nicht entziffern.\n"));
}


void set_arch(int value) {
  if(IS_ARCH(TP)) {
   archset=value;
  }
  return;
}

int arch_set() {
   return archset;
}
