inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "../files.h"

#define ABS(x) (x>0?x:-x)
#define PlayerRace this_player()->QueryProp(P_RACE)

create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  AddId (({"peitsche", "flammenpeitsche"}));       // IDs
  SetProp(P_SHORT, "Eine Flammenpeitsche");    //Kurzbeschreibung
  SetProp(P_LONG, BS(
               "Diese fast zwei Meter lange Peitsche wird fast "
              +"vollstaendig von schwarzen Flammen umwabert. Lediglich "
              +"der Griff liegt frei und ermoeglicht es Dir, die Waffe "
              +"gefahrlos zu ergreifen. Der Griff der Peitsche scheint "
              +"aus einer Art Leder zu bestehen.")); 
             
  AddDetail(({"leder", "griff"}), BS(
               "Das Leder des Griffes ist schwarz verfaerbt. Es kommt Dir "
              +"so vor, als ob dieses Leder aus Elfenhaut "
              +"besteht ... \n")); 
  AddDetail("flammen", BS(
               "Die schwarzen Flammen verstroemen beissende Kaelte...\n"));
  SetProp(P_INFO, BS(
               "Du spuerst wie Waffe vor Gier nach Opfern pulsiert ...\n"));

  SetProp (P_NAME, "Flammenpeitsche"); 
  SetProp (P_GENDER, FEMALE);  
  SetProp (P_VALUE, 2000+random(1001)); 
  SetProp (P_WEIGHT, 700); 
  SetProp (P_MAGIC, 1);
  SetProp (P_WEAPON_TYPE, WT_WHIP);
  SetProp (P_DAM_TYPE, ({DT_WHIP, DT_FIRE})); 
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 189);
  SetProp (P_WC_FIX, 10);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_SKIN:50, MAT_FIRE:25, MAT_SHADOW:25]));
  SetProp (P_KILL_NAME, "Immer-Lieb-und-Nett-sein"); 
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 16]));
  SetProp (P_WC_BONUS, (["NPC":50]));
  SetProp(P_HIT_FUNC,TO);
  SetProp(P_WIELD_FUNC,TO);

}

int HitFunc(object enemy)
{
   int ea;
   ea=enemy->QueryProp(P_ALIGN);
   if (ea>500)
      return  random(ABS(ea/10)+PlayerAlign/20);
   if (ea>0)
      return random(ABS(ea/20));
   if ( ea<0 ) 
      return ea/5; // negativ gegen boese Gegner
   return 0;   
}


WieldFunc()
{
if (PlayerAlign>=0)
 {
  write(BS("Du versuchst die Peitsche zu zuecken. Als du es probierst, "+
	"umhuellen Dich die Flammen der Peitsche und verspuerst einen "+
	"fuerchterlichen Schmerz!\n"));
  say (TPN+BS(" wird von Flammen eingehuellt und schreit furchtbar auf.\n"));
	TP->do_damage(10+ABS(PlayerAlign/10),TO);
 }
return 1;
}










