inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"hemd","kettenhemd"}));  // ID des Gegenstandes
  AddAdjective( ({"zwergisch", "zwergisches"}) );
  
  SetProp (P_SHORT, "Ein zwergisches Kettenhemd");
  SetProp (P_LONG, "Dieses hervorragend gearbeitete, stahlgrau schimmernde Meisterwerk\n"
                  +"zwergischer Schmiedekunst bietet einen sehr guten Schutz.\n");
  SetProp(P_INFO, break_string(
    "Dieses Kettenhemd ist eine feine Schmiedearbeit und von Zwergen nur fuer "
    "Zwerge gemacht. Sicher nutzt es sich kaum ab, denn es scheint schon sehr "
    "alt zu sein."),78);
    
  SetProp (P_NAME, "Kettenhemd");
  SetProp (P_NAME_ADJ, "zwergisch"); 
  SetProp (P_GENDER, NEUTER);  // DAS Kettenhemd = neutral
  
  SetProp (P_WEIGHT, 1550);  // Gewicht
  SetProp (P_VALUE, 1300);   // Wert 

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // Lege Ruestungsteil fest
  SetProp (P_AC, 30);  // Ruestungschutz 30

  SetProp (P_MATERIAL, ([MAT_STEEL:100])); // aus Eisen, was sonst :)
  SetProp (P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:"Zwerg"]) );
  SetProp (P_QUALITY_DECAY, 280); 
}

