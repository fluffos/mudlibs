inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"umhang", "feuerumhang"}));
  SetProp (P_SHORT, "Ein Feuerumhang");
  SetProp (P_LONG, 
          "Dieser Umhang scheint aus reinen Flammen zu bestehen. "
         +"Verbrenn Dich bloss nicht. Eine boese Aura scheint von "
         +"ihm auszugehen."); 
  SetProp (P_NAME, "Feuerumhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 2000);
  SetProp (P_MATERIAL, ([MAT_FIRE:80, MAT_MISC_MAGIC:20]));
  SetProp (P_INFO, "Der Feuerumhang schuetzt gegen Feuer.");
  SetProp (P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:2]));
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:-5]) );
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 8);
  SetProp("itemd_elemental_value", (["feuer":2+random(3)]) );
}
