inherit "std/room";
#include <properties.h>
#include <language.h>
#include <player.h>
#include "../stadt.h"


void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Ein schmaler Gebirgspfad");
  SetProp( P_INT_LONG,BS(
		 "Der Bergpfad, auf dem Du Dich befindest, windet sich "
                +"schlangengleich durch das Gebirge. Da er recht schmal "
                +"ist, musst du schon aufpassen, wo Du hintrittst. Er scheint "
                +"auch nicht oft benutzt zu werden. Auf dem Pfad liegen auch "
                +"recht grosse Steinbrocken herum, die Du aber mit Leichtigkeit "
                +"ueberwinden kannst. Link und Rechts neben des Pfades waechst "
                +"etwas Gras und ein paar Buesche. Der Himmel ober Dir erstrahlt "
                +"in einem kraeftigen Blau, die Sonne lacht ... wahrhaft ein "
                +"schoener Tag fuer eine Wanderung durchs Gebirge. @@weiteres@@")); 
                

  SetProp(P_INDOORS,0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  
  AddDetail(({"pfad", "gebirgspfad", "weg"}), BS(
                 "Der Pfad selbst ist uebersaeht von grossen und kleinen "
                +"Steinen. Du musst teilweise aufpassen, dass Du Dir nicht "
                +"wehtust.\n"));

  AddDetail(({"steine", "brocken", "steinbrocken"}), BS(
                 "Die kleineren Steine bilden sozusagen den Pfad. Die "
                +"groesseren liegen ab und zu mitten auf dem Pfad, so dass "
                +"Du sie fast ueberklettern musst.\n"));
 
  AddDetail("himmel", BS(
                 "Der wolkenlose Himmel erstrahlt in einem kraeftigen Blau. "
                +"Die Sonne scheint herunter und waermt Dich ... ach - ein "
                +"herrlicher Tag.\n"));
  
  AddDetail("sonne", BS(
                 "IIIIIIhhhks - die Sonne blendet Dich und bunte Flecken "
                +"tanzen vor deinen Augen einen flotten Jive.\n"));

  AddDetail("blau", BS(
                 "Eine schoene Farbe, gell?\n"));

  AddDetail(({"gebirge", "berge"}), BS(
                 "Die Berge tuermen sich hier hoch auf. Majestaetische "
                +"Gipfel rauben Dir vor Schoenheit fast den Atem.\n"));

  AddDetail("gipfel", BS(
                 "Die Berggipfel sind meist schneebedeckt.\n"));
 
  AddDetail("schnee", BS(
                 "Da oben waers toll zum Skifahren.\n"));

  AddDetail("gras", BS(
                 "Das Gras waechst neben dem Pfad.\n"));

  AddDetail("buesche", BS(
                 "Die Buesche sind hart und dornig, an die rauhe "
                +"Umgebung angepasst.\n"));

  AddDetail("voegel", BS(
                 "Du kannst ab und zu ein paar ausmachen.\n"));

  AddSmell(DEFAULT_SMELL, BS(
                 "Du saugst die frische Bergluft tief in Deine Lungen.\n"));

  AddSmell(({"bergluft", "luft"}), BS(
                 "Ahhh - erfrischend.\n"));

  AddSound(DEFAULT_SOUND, BS("Vogelzwitschern dringt an Dein Ohr.\n"));
  AddSound("vogelzwitschern", BS("Wirklich schoen.\n"));

}
