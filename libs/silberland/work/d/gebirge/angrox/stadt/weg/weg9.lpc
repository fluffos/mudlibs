inherit  "/d/gebirge/angrox/stadt/weg/weg.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../stadt.h"


void create()
{
  ::create();

  AddDetail(({"felswand", "wand"}), BS(
		 "Die Wand geht steil nach oben. Aufgrund Deiner Hoehenangst "
                +"verscheuchst Du Deine Gedanken, da hinauf zu klettern.\n"));
  AddExit( "suedostunten", WEG("weg8"));
}

string weiteres()
{
return ("\n"+BS("Eine steile Felswand macht das Weiterkommen nach oben unmoeglich."));
}



