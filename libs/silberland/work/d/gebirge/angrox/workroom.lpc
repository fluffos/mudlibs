
  AddCmd("lock", "lock");
  AddCmd("unlock", "unlock");

void init()
{
  object pl;

  ::init();
  if (this_interactive() || previous_object())
    if (getuid(this_player())!="angrox" && getuid(this_player())!="eve")
      if (!allowed) {
          tell_object(this_player(), "Du darfst diesen Raum nicht"
                      +" betreten.\n");
          
          this_player()->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_GO|M_SILENT|M_NO_SHOW);
          if (pl=find_player("angrox"))
            tell_object(pl, capitalize(getuid(this_player()))+" hat Chat betreten.\n");
        }
      else
        if (pl=find_player("angrox"))
          if (!present("angrox"))
           tell_object(pl, capitalize(getuid(this_player()))+" betrat Chat.\n");
}

int lock()
{
  if (getuid(this_player())=="angrox" ||
      getuid(this_player())=="eve") {
    allowed=0;
    write("Locked.\n");
    return 1;
  }
  return 0;
}

int unlock()
{
  if (getuid(this_player())=="angrox" ||
      getuid(this_player())=="eve") {
    allowed=1;
    write("Unlocked.\n");
    return 1;
  }
  return 0;
}
