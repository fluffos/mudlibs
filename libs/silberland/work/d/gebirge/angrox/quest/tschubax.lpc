inherit "std/npc";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "/gilden/bardengilde/barden_extern.h"

#include "../files.h"
#include "../steintafelquest.h"

int ring_menge=5;

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();

  AddId ( ({"tschubax","gelehrter","zwergengelehrter", "zwerg"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_NAME, "Tschubax");
  SetProp (P_SHORT, "Tschubax, der Zwergengelehrte");
  SetProp (P_ARTICLE, 0);
  SetProp (P_LONG,BS("Der Gelehrte ist eine wuerdevoller, alter Zwerg. Er vereinigt das Wissen "
                    +"vieler Generationen in sich. Trotz seines Alters ist sein Geist noch "
                    +"der eines jungen Mannes, wie seine vor Wissen bitzenden Augen verraten. "
                    +"Er beschaeftigt sich mit den Schriftzeichen an der Wand.\n"));

  create_default_npc(17);
  SetProp (P_ALIGN, 200);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HP, 600);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit toetlichen Zaubern", 130, DT_MAGIC}) );
  SetProp (P_LOG_INFO, LOGFILE);
  set_living_name( "tschubax" );

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;
  CLONEME(OBJ("robe"));
  command("trage robe");
  CLONEME(OBJ("wunderstiefel"));
  command("trage stiefel");
  SetProp(P_SPELLRATE,20);
  AddSpell(1,100,
	"Der Gelehrte verflucht Dich mit uralten zwergischen Zaubern.\n",
	"Der Gelehrte verflucht @WEN mit uralten zwergischen Zaubern.\n",
        DT_MAGIC, "fluch");

  AddSpell(1,500,
	" Tschubax wirft einen gruenen Blitz nach Dir.\n",
	" Tschubax wirft einen gruenen Blitz nach @WEN.\n",
          DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(30, ({
	"Der Gelehrte bettelt um Gnade.\n",
	"Der Gelehrte bettelt flehentlich nach Gnade.\n"
					 }) );

  SetProp (P_DIE_MSG,
	" stirbt mit unendlichen Wissen...\n");

  SetProp (P_DEFAULT_INFO,
	"brummelt was vor sich hin.\n");

  AddInfo ("angrox",
	"sagt:\"Angrox ist mein Schoepfer!\"\n");
  
  AddInfo (({"dusty", "woody"}),
        "Dusty? Woody? Figuren aus der zwergischen Mythologie. Angeblich "
       +"sollen sie die Welt erschaffen haben.", "erklaert: ");

  AddInfo (({"name","tschubax"}),
	"Mein Name ist Tschubax, Sohn des Tugul.", "sagt :");
 
  AddInfo ("tugul",
        "Das ist mein Vater.", "sagt :");

  AddInfo ( ({"aufgabe", "beruf" }),
	"Ich versuche hier die altzwergische Schrift zu uebersetzen.","sagt :" );

  AddInfo ( ({"heimat", "felonia" }),
	"Meine Heimat ist Felonia.", "sagt :");

  AddInfo (({"schrift","schriftzeichen", "symbole", "zeichen"}),
	"Ich bin erst am Anfang meiner Studien, aber ich bin jetzt "
       +"schon so weit, dass ich einige einfache Worte ins altzwergische " 
       +"uebersetzen kann. Es gibt Steintafeln, mit denen eine Uebersetzung "
       +"leichter ginge, doch leider fehlt mir die entscheidende Tafel.",
       "seufzt: ");

  AddInfo (({"tafeln","tafel"}), "Eine fehlt mir..."
                  +"wenn mir nur jemand helfen koennte...", "seufzt: ");

  AddInfo("peraine",
          "Peraine ist die Goettin des Wachstums und des Gedeihens.", "sagt: ");

  AddInfo("uebersetzung", "Wenn Du mir was mit \"uebersetze <wort> oder <pergament>\" "
         +"sagst, dann uebersetze ich es dir.", "sagt: ");
  AddInfo("tinte", "@@tinte@@", "sagt: ");

  AddInfo (({"hilfe", "helfen", "aufgabe"}), "@@aufgabe@@", "sagt: ");

  AddInfo ("uebersetzen",
        "Wenn du mir sagst, was ich uebersetzen soll, dann ich kann ich "
       +"es ja mal versuchen...", "sagt: ");
  AddInfo(({"fluch", "sprachfluch"}), 
        "Ja, ich beherrsche einen altzwergischen Sprachfluch. Ich kann ihn "
       +"auch von Dir entfernen, allerdings brauche ich dazu Gold im Wert "
       +"von 77777 Muenzen.", "sagt: ");
  
  AddInfo(({"stiefel", "wunderstiefel"}),
        "Schoen, nicht wahr? Es sind zauberkreftige Stiefel, die mir schon oft "
       +"geholfen haben.\n", "sagt: ");
    
  AddInfo ( ({"gestalt", "unheimlicher", "symbol"}),
        "Hmm... diese Gestalt repraesentiert einen uralten Feind unsere "
       +"Volkes. Selbstverstaendlich ist dieses Boese nur im mythologischen "
       +"Sinne zu verstehen. Die Sagen berichten vom Kampf unserer Vorfahren "
       +"gegen ein daemonisches Wesen in den tiefen der Berge. Aber da es keinen "
       +"Hinweis auf die Existenz dieses Wesens gibt, muss das wohl als eine "
       +"Sage angesehen werden.", "belehrt Dich: ");

  AddInfo ( "sage","Nur Mythologie.", "sagt: ");

  AddInfo( ({"zwergenstahl"}),
    "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  AddInfo("astralring", "@@check_astralring@@", "sagt: ");

  // Gwenshara 10.09.2021 - Bardenquest
  AddInfo( ({"der fruehling", "der herbst", "der winter", "der sommer", "jahreszeiten",
             "vier jahreszeiten", "konzert", "konzert der vier jahreszeiten"}), 
    "@@barden_gs6_lied@@", "sagt: ");

  AddInfo( ({"barden", "bardengilde", "korriax", "sarrian", "tirena", "alestra"}),
    "Ja, ich kenne die Grossen Vier der Barden. Mit Korriax habe ich einst ein "
    "altes zwergisches Ahnenlied entschluesselt. Ausserdem besitze ich noch die "
    "originalen Urschriften des Konzertes der vier Jahreszeiten, das alle Vier "
    "gemeinsam komponiert haben.", "sagt: ");
  
  AddCmd("uebersetze", "uebersetze");

  /* SetProp( P_REJECT, ({ REJECT_KEEP,
                  "Der Gelehrte bedankt sich recht freundlich.\n" }) );
  */
 }

 public string barden_gs6_lied() {
   string str;

   if(this_player()->QueryProp(P_GUILD) != "bardengilde") {
     return "Ach, das ist nur was fuer Barden. DU kannst damit nichts anfangen!.";
   }

   if(this_player()->QueryProp(P_GUILD_LEVEL) < 6) {
     return "Ich glaube, das koenntest du noch gar nicht verstehen. Komm wieder, wenn du "
            "mehr gelernt hast.";
   }

   str = "In der Tat besitze ich dir Originalkomposition dieses Konzerts! Jeder der "
         "vier Gildengruender hat jeweils einen Teil, eine Jahreszeit, des Konzerts "
         "der vier jahreszeiten komponiert. Diesen Lieder wohnt Magie inne, welche "
         "den Zuhoerer zu Erholung und Regeneration verhilft.\n";

   if(!this_player()->QueryQuest(TAFELQUEST)) {
     return str + "Wenn du mir hilfst die letze Tafel, die mir zur Uebersetzung der Runen "
            "noch fehlt zu finden, zeige ich dir die Lieder gerne!";
   }

   call_out("barden_regenerationslied_lernen", 1, this_player());
   return str + "Da du mir geholfen hast zeige ich dir nun die Aufzeichnungen zum Konzert "
          "der vier Jahreszeiten.";
 }

 public void barden_regenerationslied_lernen(object pl) {
  string song, title;

  switch(this_player()->QueryProp(P_BARD_GROUP)) {
      case BARD_GROUP_ALESTRA:
          song = "der fruehling";
          title = "Der Fruehling";
          break;
      case BARD_GROUP_TIRENA:
          song = "der sommer";
          title = "Der Sommer";
          break;
      case BARD_GROUP_KORRIAX:
          song = "der winter";
          title = "Der Winter";
          break;
      case BARD_GROUP_SARRIAN:
          song = "der herbst";
          title = "Der Herbst";
          break;
      default:
          song = "alle meine entchen";
          title = "Alle Meine Entchen - Fehler";
          break;
  }

  if(this_player()->QuerySkill(song) != 0) {
      write("Da du das Konzert schon kennst, lernst du nichts Neues.\n");
      return;
  }

  write(BS("Tschubax zeigt dir die Sonette und Noten nach denen das Konzert komponiert wurde."));
  tell_room(environment(this_object()), BS("Tschubax zeigt " + this_player()->Name(WEM) + " alte Aufzeichnungen."), ({pl}));

  LearnBardSpell(this_player(), song, "Mit dieser Komposition regenerieren sich deine Zuhoerer.",
          sprintf("spiele '%s'", song));
 }


uebersetze(str)
{
  object ob;
  if (!str || str=="")
   {
    write("Tschubax fragt Dich: \"WAS soll ich Dir uebersetzen?\"\n");
    return 1;
   }
  if (str == "pergament")
   {
    if (!(ob=present(QUESTPERG1, TP)))
     {
      write(break_string("Du hast nichts dabei, was ich uebersetzen "
                        +"koennte.\n", 78, "Tschubax sagt: "));
      return 1;
     }
    ob->remove();
    ob=clone_object(QUEST1("pergament2.lpc"));
    ob->move(TP, M_NOCHECK);
    write(break_string("Ja, interessant. Ah - ich habs. Hier ich habe die Uebersetzung "
            +"hier aufgeschrieben, auf diesem Pergament.\n",78, " Tschubax fluestert: "));
    write(BS("Tschubax gibt Dir die Uebersetzung.\n"));
    say ("Tschubax gibt "+TP->name(WEM)+" etwas.\n", ({TP}) );
    return 1;
   }
     
  write ("Du bittest Tschubax um die Uebersetzung von \""+str+"\".\n");
  say (capitalize(TPN)+" fragt Tschubax etwas.\n", ({TP}) );
  if (str=="wachse" || str=="wachs'")
    write("Tschubax fluestert Dir zu: "+
      "\"Wachse oder wachs' heisst auf alt-zwergisch roglm !\"\n");
  else
    write("Tschubax fluestert Dir zu:\"Das weiss ich leider nicht...\"\n");

  say ("Tschubax fluestert "+TP->name(WEM)+" etwas zu.\n", ({TP}) );
  return 1;
}


string aufgabe ()
{
  object ob;

  if(present(QUESTRING, TP))
    return "Ja, Du hilfst mir bereits. Hast Du die Tafel schon?";

  SUID;
  ob = clone_object (QUEST1("siegelring.lpc"));
  ob->move(TP, M_NOCHECK);
  return
    "Du wuerdest mit helfen? Es koennte gefaehrlich "
   +"werden, aber Du schaffst das schon. Um die ganze Sprache uebersetzen "
   +"zu koennen, benoetige ich alle alten Schrifttafeln. Ich habe alle - "
   +"bis auf Eine. Wahrscheinlich liegt sie irgendwo in den unteren Ebenen, "
   +"einige wurden ja aufgelassen, bzw. vor langer Zeit verschuettet. Wenn Du "
   +"sie gefunden hast, dann bring sie mir bitte. Eine Belohnung fuer Deine "
   +"Dienste ist Dir selbstverstaendlich gewiss... Hier ist mein Siegelring, "
   +"als Zeichen dafuer, dass Du in meinem Auftrag unterwegs bist. Vergiss "
   +"jedoch nicht, sollte sie Tafel bewacht werden, so ist auch essenziell "
   +"das Du den Waechter selbst besiegst. Nur so kann eine eventuelle '"
   +"Verunreinigung' beseitigt werden.";
}
 

string tinte()
{
  object ob;
  if(present("tinte", TP))
    return "Du hast doch schon ein Tintenfaesschen!";
  if(!present(QUESTFEDER, TP))
    return "Ja, ich habe Tinte, aber wozu brauchst Du sie? Du hast "
          +"ja noch nicht einmal eine Schreibfeder?";

  ob=clone_object (QUEST1("tinte.lpc"));
  ob->move (TP, M_NOCHECK);
  return "Ja, fuer diese Feder habe ich Tinte. Da, nimm.";
}


give_notify(object obj)
{
  int q,blvl;  
  object ob, next;
  string *cloner_string;
  if(obj->id("muenzen")) {
    if(!(ob=present("\nbackspeech", TP))) {
      tell_room(environment(), BS(
          "Tschubax Augen blitzen auf, als er das Gold in den Haenden haelt. "
         +"Er zaehlt die Muenzen schnell nach, laeuft "
         + "davon und kommt ohne das Gold wieder.\n "
         + "Er sagt: Wieder mehr fuer meinen Schatz! Danke!\n"));
      obj->remove();
      return ;
    }
    if((obj->QueryProp(P_GIVEN_AMOUNT)<77777)) {
      tell_room(environment(), BS(
          "Tschubax Augen blitzen auf, als er das Gold in den Haenden haelt. "
         +"Er zaehlt die Muenzen schnell nach, ruempft die Nase, laeuft schnell "
         + "davon und kommt ohne das Gold wieder.\n "
         + "Er sagt: Tja, leider zu wenig, aber trotzdem danke!\n"));
      obj->remove();  
      return ;

    }       
    write( BS(
       "Tschubax nimmt das Gold. Nachdem er es sorgsam gezaehlt hat und "
         +"es vor Dir auf einen Stapel geordnet hat, hebt er die linke Hand "
         +"und macht eine abwinkende Bewegung. Unter einem Blitz loest sich "
         +"das Gold auf, und Du fuehlst, wie sich Deine Zunge wieder nach Deinem "
         +"Willen bewegen laesst.\n"));
    tell_room (ENV(TP), bs(
          "Tschubax nimmt das Gold. Nachdem er es sorgsam gezaehlt hat und "
         +"es vor "+TPN+" auf einen Stapel geordnet hat, hebt er die linke Hand "
         +"und macht eine abwinkende Bewegung. Unter einem Blitz loest sich "
         +"das Gold auf, und "+TPN+" fuehlt sich scheinbar erleichert.\n"), 
        ({TP}));
    obj->remove();
    ob->remove();
    return;
  } 
  if(obj->id("steintafel")) {
    blvl=obj->QueryProp("balrog_level");
    if(!(ob=present(QUESTRING,TP))) {
      tell_room(environment(),
         break_string( "Nanu? Du hast ja nicht meinen Siegelring? "
           +"Dann ist diese Tafel hier sicher eine Faelschung. Ich werde "
           +"sie sicherheitshalber zerstoeren.", 78, "Tschubax staunt: "));
      obj->remove();
      return 1;
    }
    cloner_string=explode(obj->QueryProp(P_CLONER), ":");
    if(!obj->arch_set() && (sizeof(cloner_string) < 2 || 
          cloner_string[1]!=getuid(TP))) 
    {
      tell_room(environment(),
      break_string( "Nanu? Diese Tafel ist sicher eine Faelschung. "
           +"Ich werde "
           +"sie sicherheitshalber zerstoeren.", 78, "Tschubax staunt: "));
      obj->remove();
      return 1;
    }
    if(!ob->query_balrog_killed()) {
      command_me("sag Hmm. Diese Tafel scheint noch mit dem Fluch des "
          "Boesen belegt zu sein. Ich kann sie leider nicht "
          "gebrauchen.");
      command_me("gib tafel an "+TP->name(WEN));
      return 1;
    }
    q = TP->GiveQuest(TAFELQUEST);
    if(q==1) {
      tell_room(environment(),
         "Tschubax sagt: Du hast die fehlende Tafel besorgt. Hab "
         "vielen Dank!\nTschubax laechelt.\n");
      write_file (TAFELQUESTLOG,
      sprintf ("%s  %s hat den Zwergen die Tafel zurueckgebracht.\n",
          dtime(time()), capitalize(TP->query_real_name())));
      ring_menge++;
    }
    else if(q!=-1) {
      write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
           "verstaendigen!\nFehlercode: %d\n", q));
      return ;
    }
    ob = present(QUESTRING, TP);
    ob->remove(1);
    write("Du gibst Tschubax seinen Siegelring zurueck.\n");
    if(ring_menge > 0) {
      tell_room(environment(), break_string(
         "Hier, als Belohnung bekommst Du zwei zwergische "
         "Artefakte. Der Ring ist ein magisches Artefakt, aber das Geheimnis "
         "des Rechtecks musst Du selbst herausfinden.", 78, "Tschubax sagt: "));
      write(BS("Tschubax geht eilig mit der Tafel fort und kommt "
            "gleich wieder."));
     
      ob=clone_object(OBJ("astralring"));
      ob->SetOwner(getuid(TP));
      if(!random(300) && blvl > 45) {
        ob->SetMystical();
        write_file(LOG("astralring"), sprintf("%s: %s -> mystical ring\n", 
              dtime(time()), getuid(TP)));
      }
      if(blvl > 1 && blvl < 40) {
        ob->SetProp("ring_damage", random(5)+3);
      }
      ob->move(TP, M_NOCHECK);
      ob=clone_object(OBJ("steinrechteck.lpc"));
      ob->move(TP, M_NOCHECK);
      ob->SetOwner(getuid(TP));
      ring_menge--;
    }
    else {
      tell_room(ENV(ME), break_string(
         "Hier, als Belohnung bekommst Du ein zwergisches "
         "Artefakt.", 78, "Tschubax sagt: "));
      write(BS("Tschubax geht eilig mit der Tafel fort und kommt "
            "gleich wieder."));
      ob=clone_object(OBJ("steinrechteck.lpc"));
      ob->move(TP, M_NOCHECK);
    }
    for(ob=first_inventory(this_object());ob;) {
      next=next_inventory(ob);
      ob->remove(1);
      ob=next;
    }
    return;
  } 
  command_me("sag Was soll ich damit?");
  command_me(sprintf("gib %s an %s", lower_case(obj->name(RAW)), 
        getuid(TP)));
  return ::give_notify(obj);
}

void fluch(object enemy, int damage, mixed dam_type)
{
 object ob;
 if (!present("\nbackspeech", enemy))
   {
     ob=CLONEOB(HOME("misc/backspeech.lpc"));
     ob->move(enemy, M_NOCHECK);
   }
}

void reset() {
  ::reset();
  ring_menge=5;
}

string check_astralring() {
  string str;
  str="Ein Astralring ist ein maechtiger Gegenstand. Er kann einen "
    "Teil Deiner Lebensessenz in Magie umwandeln.";
  switch(ring_menge) {
     case 1: str+=" Leider habe ich nur noch einen Ring bei mir."; break;
     case 2: str+=" Ich habe noch zwei dieser Ringe bei mir."; break;
     case 3: str+=" Ich habe drei dieser Ringe bei mir."; break;
     case 4: str+=" Ich habe ganze vier dieser Ringe hier bei mir."; break;
     case 5: str+=" Ich habe fuenf dieser Ringe mit mir."; break;
     default: "Leider habe ich keinen dieser Ringe bei mir.";
  }

  return str;

}

