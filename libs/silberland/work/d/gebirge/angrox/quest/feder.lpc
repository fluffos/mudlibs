inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../files.h"
#include "../steintafelquest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"feder", "schreibfeder", QUESTFEDER}));
  SetProp (P_SHORT, "Eine Schreibfeder");
  SetProp (P_LONG, bs(
           "Ein ganz normale Schreibfeder. Mit etwas Tinte kannst Du damit schreiben.\n"));
  SetProp (P_NAME, "Schreibfeder");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 0);
  
  SetProp (P_MATERIAL, MAT_FEATHER);
 
}
