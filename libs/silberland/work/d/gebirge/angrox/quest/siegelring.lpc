/*
** Siegelring (QUESTOBJEKT!!!)
** 10.10.1996 Angrox@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../files.h"
#include "../steintafelquest.h"

#include <defines.h>
#include <moredef.h>

nosave string queststring="";

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({ "ring", "siegelring", QUESTRING, "QUESTOBJ", "NODESTRUCT" }));
  SetProp (P_SHORT, "Tschubax' Siegelring");
  SetProp (P_LONG, bs("Tschubax' Siegelring ist aus Gold und traegt das Wappen "
                     +"seiner Familie."));
  SetProp (P_NAME, "Siegelring");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 3500);
  SetProp (P_NOBUY, 0);
  SetProp (P_NOSELL, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MAGIC, 1);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 0);
  SetProp (P_MATERIAL, ([MAT_GOLD:90, MAT_SILVER:10]));
  SetProp(P_INFO, BS("Ein ganz normaler Siegelring.\n"));
  AddDetail("wappen", BS(
            "Das Wappen zeigt zwei gekreutze Haemmer ueber einem Amboss.\n"));
}

int _query_damaged() {
    return 0;
}

int set_balrog_killed() {
    queststring=set_bit(queststring, 0);
    return 1;
}

int query_balrog_killed() {
    return test_bit(queststring,0);
}
