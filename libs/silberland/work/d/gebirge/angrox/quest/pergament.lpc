inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("pergament");
  SetProp (P_SHORT, "Ein Pergament");
  SetProp (P_LONG, bs(
           "Ein ganz normales Pergamentblatt. Es ist unbeschrieben.\n"));
  SetProp (P_NAME, "Pergament");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 40);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  
  SetProp (P_MATERIAL, MAT_PERGAMENT);
 
}
