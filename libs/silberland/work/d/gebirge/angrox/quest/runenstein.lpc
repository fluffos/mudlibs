inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../steintafelquest.h"
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"runenstein", "stein", QUESTSTEIN}));
  SetProp (P_SHORT, "Ein kleiner Runenstein");
  SetProp (P_LONG, bs(
           "Eine exakte Kopie des grossen Runensteins.\n"));
  SetProp (P_NAME, "Runenstein");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NODROP, "Den willst Du nicht weggeben.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_MISC_MAGIC);
}
