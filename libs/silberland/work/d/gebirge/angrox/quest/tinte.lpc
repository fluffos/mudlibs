/*
** Ein Tintenfaesschen
** 20-10-1996 Angrox@SL
**
** */


inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"faesschen", "tintenfaesschen", "tinte"}));
  SetProp (P_SHORT, "Ein Tintenfass");
  SetProp (P_LONG, bs(
           "Die Tinte in diesem Faesschen braucht man um mit einer Feder zu schreiben.\n"));
  SetProp (P_NAME, "Tintenfaesschen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);  
  SetProp (P_MATERIAL, ([MAT_GLASS:60, MAT_INK:40]));
  AddDetail("tinte", BS("Koenigsblau ... einfach schoen.\n"));
  AddDetail("faesschen", BS("Da ist die Tinte drin.\n"));
}
