inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../files.h"
#include "../steintafelquest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"pergament", QUESTPERG1}));
  SetProp (P_SHORT, "Ein Pergament");
  SetProp (P_LONG, bs(
           "Ein ganz normales Pergamentblatt. Es ist beschrieben. Vielleicht kannst "
          +"Du ja die Schrift lesen.\n"));

  SetProp (P_NAME, "Pergament");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 40);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  
  SetProp (P_MATERIAL, ([MAT_PERGAMENT:99, MAT_INK:1]));
  AddDetail("schrift", BS("Vielleicht kannst Du sie lesen.\n"));
  AddReadDetail("schrift", BS("Dieselben Runen wie am Boden des Raumes, wo Du es gefunden "
                             +"hast. Leider kannst Du sie nicht uebersetzen\n"));
}
