#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
		 "Ein Gang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Dieser Gang ist wohl der Weg zu den Grabungsstellen der Zwerge. Der ganze "
                +"Gang ist mit Stuetzbalken gesichert. Einige Schuerfspuren sind an den "
                +"ansonsten unbearbeiteten Felswaenden zu sehen."));

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.")
		);

  AddDetail ( ({"spuren", "schuerfspuren"}),BS(
		 "Die Zwerge haben hier nach Gold und Edelsteinen gegraben."));

  AddDetail ( ({"gold", "edelsteine"}),BS(
		 "Hier haben sie es wohl aufgegeben."));

  AddDetail ( "boden",
		 "Der Boden besteht aus kahlen Fels."
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( ({ "balken", "stuetzbalken" }),BS(
		 "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus Holz.")
		);

  AddDetail ( "holz",
		 "Es sieht noch sehr robust aus."
		);

  AddItem(NPC("zwaechter2"), REFRESH_DESTRUCT);
 
  AddExit("nordwesten", EBENE1("bergwerk_r26.lpc"));
  AddExit("nordosten", EBENE1("bergwerk_r27.lpc"));
  AddExit("sueden", EBENE1("bergwerk_r24.lpc"));  

 }
