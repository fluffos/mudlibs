#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
		 "Ein Seitenstollen"
	 );
  SetProp( P_INT_LONG,BS(
		 "Der Stollen ist so schmal, dass man sich nur unter groessten Muehen "
	 +	 "durch ihn hindurchzwingen kann. Nur Zwerge koennen hier aufrecht "
	 +   "hindurch, alle anderen muessen sich buecken. Auch dieser Gang ist "
	 +   "durch Stuetzbalken gesichert.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.")
		);

  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge haben hier nach Gold gegraben."
		);

  AddDetail ( "gold",
		 "Hier haben sie es wohl aufgegeben."
		);

  AddDetail ( "boden",
		 "Der Boden besteht aus kahlen Fels."
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( ({ "balken", "stuetzbalken" }),BS(
		 "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus Holz.")
		);

  AddDetail ( "holz",
		 "Es sieht noch sehr robust aus."
		);

  AddItem("/d/gebirge/angrox/npc/zwaechter2", REFRESH_DESTRUCT);
 
  

  AddExit( "nordwesten", EBENE1("bergwerk_r11.lpc"));
  AddExit( "nordosten", EBENE1("bergwerk_r12.lpc"));
  AddExit( "sueden", EBENE1("bergwerk_r2.lpc"));
}











