#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
	     "Ein grob aus dem Stein gehauener Stollen"
	 );
  SetProp( P_INT_LONG,BS(
	     "Der Stollen fuehrt weiter in den Berg. Die Stuetzbalken sind "
	 +   "hier weit massiver ausgelegt als weiter oben. Ueberall auf dem " 
	 +   "Boden liegen kleinere Steine herum, die das Vorankommen erschweren. " 
	 +   "Im Sueden fuehrt ein kleiner Stollen weiter. Nach Nordosten ist "
	 +   "ebenfalls ein Seitengang zu erkennen. Aus dem Osten sind jetzt "
	 +   "deutlich Klopfgeraeusche zu vernehmen.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  AddDetail ( ({"raum", "stollen", "gang"}),
	     "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	    "man Schuerfspuren, so als ob jemand nach Gold und Edelsteine "
      "gegraben haette.");
  AddDetail("seitengang", 
      "Der Seitengang zweigt nach Nordosten ab.");
  AddDetail(({"klopfgeraeusche", "haemmern"}),
      "Du koenntest lauschen.");
  AddDetail ( ({"spuren", "schuerfspuren"}),
	     "Hier wurde eindeutig nach Gold und Edelsteine gegraben.");
  AddDetail("berg", "Du bist in ihm.");
  AddDetail (({ "gold", "edelsteine"}),
	     "Hmm. Ob man hier vielleicht noch was finden koennte?");
  AddDetail ( "boden",
	     "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken und "
       "Steine uebersaeht. Pass bloss auf, dass Du Dir nicht weh "
       "tust!");
  AddDetail ( "fels",
	     "Der Fels ist rauh und fuehlt sich kalt an. Er ist sehr hart, und "
       "es ist erstaunlich, dass man in so hartem Gestein graben kann.");
  AddDetail("gestein", 
      "Das Gestein hier ist vorwiegend harter Granit.");
  AddDetail("granit", 
      "Der graue Granit scheint sehr hart zu sein. Dennoch wurde hier "
      "ohne unterlassen gegraben.");
  AddDetail("decke", 
      "Die Decke ist ueber Dir, und wird mit Stuetzbalken gestuetzt.");
  AddDetail("vorankommen", 
      "Das Vorankommen faellt Dir schwer.");
  AddDetail ( ({"brocken", "steine", "felsbrocken"}),
		 "Die Felsbrocken sind eigentlich gar nicht so gross, aber sie sind "
     "ziemlich kantig und teilweise sehr scharf. Du beschliesst mehr "
     "ausfzupassen, um Dir nicht wehzutun.");
  AddDetail (({ "balken", "stuetzbalken"}),
	     "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	     "bestehen aus Holz.");
  AddDetail ( "holz",
	     "Es sieht sehr alt aus, und scheint dennoch sehr robust zu sein.");

  AddSound ( DEFAULT_SOUND,
	     "Das Haemmern klingt weit entfernt und kommt von Osten."
	   );

  
  AddExit( "nordosten",EBENE1("bergwerk_r18.lpc"));
  AddExit( "sueden", EBENE1("bergwerk_r17.lpc"));  
  AddExit( "osten", EBENE1("bergwerk_r4.lpc"));
  AddExit( "westen",EBENE1("bergwerk_r2.lpc"));

}
