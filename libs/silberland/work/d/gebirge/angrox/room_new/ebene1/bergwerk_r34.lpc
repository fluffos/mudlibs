inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
 
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Hoehle besteht vollkommen aus Fels. Silbrige Faeden im Fels "
                +"reflektieren das Licht der Fackeln und tauchen die Hoehle in ein "
                +"fast unwirkliches Spiel von Licht und Schatten. Die Hoehle ist fast "
                +"vollstaendig von einem grossen, hoelzernen Bauwerk ausgefuellt. Von "
                +"dem Gestell haengt ein dickes, straffes Seil in ein Loch im Boden. "
                +"Das Loch befindet sich inmitten der Hoehle. Von ihm kommt ein kuehler "
                +"Lufthauch aus dem Inneren des Berges. Ein Schild liegt am Boden."));

 
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  AddDetail ( ({"raum", "gang"}),BS(
		 "Der Gang besteht vollkommen aus hartem Fels, welcher von silbrigen "
                +"Faeden durchzogen ist."));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein.");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergewoehnlich hart."));

  AddDetail("faeden",BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair."));
  
  AddDetail("seil",BS(
            "Das Seil haengt an einer Art Umlenkrolle und fuehrt direkt in das Loch im "
           +"Boden. Da es straff gespannt ist, haengt wohl eine grosse Last an ihm."));

  AddDetail(({"umlenkrolle", "rolle"}), BS(
            "Die Umlenkrolle ist Teil der hoelzernen Konstruktion in der Hoehle."));

  AddDetail( ({"geruest", "holzgeruest", "konstruktion", "holzkonstruktion",
               "holzbauwerk", "bauwerk", "gestell"}), BS(
            "Die hoelzerne Konstruktion besteht aus mehreren, in sich abgeschlossenen "
           +"Konstruktionen, offenbar soll das ganze aber eine Art Aufzug darstellen. Auch eine "
           +"Art Laufrad ist zu sehen."));

  AddDetail ("laufrad", BS("In dem Laufrad bewegen sich einige Gestalten, um den Aufzug zu "
                         +"bewegen."));

  AddDetail ("gestalten", "Bei den Gestalten, die im Laufrad laufen, handelt es sich um Elfen.");
  AddDetail ("elfen", "Zerlumpte, spitzohrige Gestalten, die wohl die Zwerge SEHR veraergert haben. :.");

  
  AddDetail( "loch",BS(
             "Das Loch ist ziemlich gross und fuehrt nach unten. Aus ihm kommt ein kuehler "
            +"Lufthauch. Welche Geheimnisse wohl da unten darauf warten entdeckt zu werden."));
  AddDetail ("schild","Da steht was drauf.");
   
  AddDetail("lufthauch", "Der Lufthauch kommt von unten.");
  AddDetail("licht", BS("Das Licht kommt von Fackeln und taucht die Hoehle in ein Spiel "
                      +"von Licht und Schatten."));

  AddDetail("schatten", "Die Schatten formen schoene Muster an den Waenden.");
  AddDetail("muster", BS("Schoen ... Du versinkst in Gedanken, doch dann wendest "
                        +"Du Dich wieder dem Ernst des Lebens zu."));
  AddDetail("holz", "Du pochst daran. Ist stabil.");
             
  AddReadDetail("schild",
             " ----------------."
            +"| betrete aufzug  ."
            +"| verlasse aufzug ."
            +" ----------------."
            +"        | ."); 

  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");
  
// if (objectp(find_object(OBJ("aufzug")))==0)
       AddItem(OBJ("aufzug"), REFRESH_DESTRUCT, 1);
   
  AddExit("westen", EBENE1("bergwerk_r33.lpc"));
  
}
