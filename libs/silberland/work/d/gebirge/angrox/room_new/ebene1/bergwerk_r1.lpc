inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"

void create() {
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, 
	     "Ein grob aus dem Stein gehauener Stollen");
  SetProp( P_INT_LONG,
	     "Hier wurde ein grob behauener Stollen in den Fels gegraben. Der "
	     "gesamte Gang ist mit starken Balken auf beiden Seiten gegen "
	     "Einstuerzen gesichert. Ueberall auf dem Boden liegen kleinere "
	     "Felsbrocken herum, die das Vorankommen erschweren. Zwei kleine "
       "Hocker stehen hier herum. Weiter im Osten "
	     "hoerst du haemmernde Geraeusche, die durch das Echo verzerrt "
       "werden. Vom Westen faellt Licht in den Stollen, weiter im Osten "
       "ist aber alles dunkel. ");
  SetProp( P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail (({"raum", "stollen", "gang"}),
	     "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
	     "man Schuerfspuren.");
  AddDetail("decke", 
      "Die Decke besteht, so wie alles hier, aus Fels. Du kannst nichts "
      "besonderes an ihr erkennen.");
 
  AddDetail (({"spuren", "schuerfspuren"}),
	     "Die Zwerge haben hier nach Gold gegraben. Offenbar war das Ganze "
       "hier nicht sehr erfolgreich");
  AddDetail("ganze", 
      "Tja, hier haben sie es aufgegeben. Aber vielleicht findet man "
      "doch noch was?");
  AddDetail("vorankommen", 
      "Durch die Steine ist es ganz schoen schwer, hier ohne Blessuren "
      "vorranzukommen.");
  AddDetail("blessuren", 
      "Noch hast Du Dir hier nicht wehgetan.");
  AddDetail("geraeusche", 
      "Lausche doch mal!");
  AddDetail ( "gold",
	     "Hier haben sie es wohl aufgegeben.");
  AddDetail ( "boden",
	     "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken "
	     "uebersaeht. Di siehst zwei Hocker");
  AddDetail("hocker", 
      "Die zwei grob gehauenen Hocker dienen wohl als Sitzplatz.");
  AddDetail("sitzplatz", 
      "Du koenntest Dich ja hinsetzen.");
  AddDetail ( "fels",
	     "Der Fels ist rauh und fuehlt sich kalt an.");
  AddDetail ( ({"brocken", "steine", "felsbrocken"}),
	     "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
       "Du beschliesst mehr aufzupassen, um dir nicht wehzutun.");
  AddDetail ( "balken",
	     "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	    "bestehen aus Holz.");
  AddDetail ( "holz",
	     "Es sieht noch sehr robust aus.");
  AddDetail( ({"seiten", "wand" "seitenwand"}), "Stein. Was sonst?");

  AddDetail("licht", "Es kommt von Westen.");

  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddSound ( DEFAULT_SOUND,
	     "Das Haemmern klingt weit entfernt und kommt von Osten.");
  AddSound ( "echo", "ECHO ... Echo .... echo ...");
  AddSound (({"haemmern", "gerraeusche"})
      , "BUMM ... bumm ... BUMM ... bumm ...");
   
  AddExit( OSTEN, EBENE1("bergwerk_r2"));
  AddExit( WESTEN, ROOM("gang2"));
 
  AddCmd(({"sitz", "sitze"}), "hocker");
}

int hocker(string str) {
  notify_fail("Auf was moechtest Du Dich sitzen?\n"); 
  if(!str) return 0;
}





