#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
		 "Ein Seitenstollen"
	 );
  SetProp( P_INT_LONG,BS(
		 "Der Stollen ist so schmal, dass man sich nur unter groessten Muehen "
	 +	 "durch ihn hindurchzwingen kann. Nur Zwerge koennen hier aufrecht "
	 +   "hindurch, alle anderen muessen sich buecken. Auch dieser Gang ist "
	 +   "durch Stuetzbalken gesichert. Der Boden ist mit einer Staubschicht "
	 +   "bedeckt. Hier war wohl schon lange niemand mehr.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Der Boden ist mit "
	 +   "einer Staubschicht bedeckt.")
		);

  AddDetail ( ({"staub", "schicht", "staubschicht"}),BS(
		 "HAATSCHI! Ja, die Staubschicht ist hier - HAATSCHI - einige Zentimeter "
	 +    "hoch. Danach zu urteilen war hier schon lange keiner mehr.")
			);


  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlen Fels und ist mit einer Staubschicht "
	 +   "bedeckt.")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( ({ "balken", "stuetzbalken" }),BS(
		 "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus morschen Holz.")
		);

  AddDetail ( "holz",
		 "Es sieht sehr morsch aus."
		);

  
  AddSound (DEFAULT_SOUND, "Von Irgendwo kommt ein Klopfen her.");
  AddSound ("klopfen", "BUMM... BUMM...KLOPF...KLOP.");

  AddExit( "norden", EBENE1("bergwerk_r2.lpc"));
  AddExit( "sueden", EBENE1("bergwerk_r14.lpc"));
}
