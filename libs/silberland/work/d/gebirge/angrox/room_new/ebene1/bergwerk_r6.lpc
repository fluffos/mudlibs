inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create() {
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Eine Hoehle");
  SetProp( P_INT_LONG,
      "Diese Felshoehle ist von Fackeln hell erleuchtet. Die ganze Hoehle "
      "ist offenbar Teil eines unterirdischen Spaltes. Der Boden der "
      "besteht aus stabilen Holzdielen. Die Klopfgerauesche sind jetzt SEHR "
      "laut und kommen aus Osten, Nord- und Suedosten und seltsamerweise "
      "auch von unten. Im Raum befindet sich noch ein grobschlaechtiger Tisch. "
      "Ein Schrank steht an der Wand.")
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail(({"raum", "hoehle", "felshoehle"}),
      "Die natuerlich wirkende Hoehle ist offenbar Teil eines Spaltes im "
      "Berg. Die Decke ist trotz der Fackeln nicht zu erkennen. Der Boden "
      "besteht aus Holzdielen, die sehr stabil wirken.")

  AddDetail ("waende", "Besteht aus Stein.");
  AddDetail ( "boden",
		 "Der Boden besteht aus stabilen Holzdielen. Sie scheinen relativ "
	 +   "neu zu sein.")

  AddDetail (({"dielen", "holzdielen"}),
               "Die Dielen sehen sehr stabil aus.");
  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an.");

  AddDetail (({"spalt", "spalte"}),
		 "Der Spalt geht nach oben und nach unten weiter, deshalb also ein "
	 +   "Holzboden. Nach Oben hin ist keine Decke zu erkennen.");


  AddDetail ( "holz",
		 "Es sieht sehr robust aus. Du glaubst nicht, dass es jemals nachgeben wird.")
		);

  AddDetail ("fackeln", BS(
             "Die Fackeln erhellen die Hoehle."));
  AddDetail ( "tisch", BS(
              "Der Tisch besteht aus roh bearbeitetem Holz. Das Holz sieht robust "
         +    "aus."));

  AddDetail ( ({"ausruestung", "bergwerksausruestung"}),BS(
              "Die Ausruestung besteht aus einigen Spitzhacken und Schaufeln. Sie befinden "
         +    "sich in einem vergitterten Schrank.")
            );

 
  AddDetail ("schrank",
             "Der Schrank ist vergittert und mit einem schweren Schloss gesichert."
            );
 
  AddDetail ("schloss",
             "Es sieht sehr stabil aus."
            );

   
  AddSound ( DEFAULT_SOUND,BS(
		 "Das Haemmern ist sehr, sehr laut. Es kommt von Osten, Nord- und "
	 +	 "Suedosten und komischerweise auch von unten. Offenbar gibt es "
	 +   "mehrere Bergswerkebenen.")
	   );

  AddCmd ("oeffne", "oeffne_etwas"); 

  AddExit( "nordosten", EBENE1("bergwerk_r7.lpc"));


  AddExit( "osten", EBENE1("bergwerk_r8.lpc"));
  AddExit( "westen", EBENE1("bergwerk_r5.lpc"));
  AddExit( "suedosten", EBENE1("bergwerk_r9.lpc"));
		

}


oeffne_etwas ( str )
{
  notify_fail ("Was willst du denn oeffnen.");
  if (str == "schrank")
    {
     write("Das Schloss ist zu stabil. Du bekommst es nicht auf.");
     say(TPN+" zerrt verzweifelt an dem Schrank und gibt schliesslich entnervt auf.");
     return 1;
   }
  return 0;
}
