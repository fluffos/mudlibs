inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <player.h>
#include <moving.h>



void create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,"Eine Hoehle");
  SetProp( P_INT_LONG,BS(
		 "Hier schuerfen die Zwerge nach Edelsteinen und den anderen Schaetzen "
	 +   "der Erde. Die ganze Hoehle ist von Fackeln hell erleuchtet. Der "
	 +   "Boden ist mit Staub und kleinen Steinchen uebersaeht. Hier und da "
	 +   "vermeinst Du ein rotes Funkeln zu sehen, und auch hier ist der Fels "
         +   "mit silberenen Faeden durchzogen. Es ist hier empfindlich kalt. "
         +   "Irgendetwas stimmt hier nicht... ein kaltes Schaudern laeuft Dir "
         +   "ueber den Ruecken..."));
	       

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp(P_INDOORS,1);

  AddDetail ( ({"raum", "hoehle", "felshoehle"}),BS(
		 "Die Hoehle wurde von Zwergen aus dem Fels herausgebrochen. Hier scheinen "
                +"sie noch aktiv nach Edelsteinen zu graben."));
	      
  AddDetail("staub", "Du malst gelangweilt ein paar Isokaeder in den Staub.");
  AddDetail("isokaeder", "Rat mal ... ;)");  
  AddDetail("waende", "Die Waende sind aus Fels.");
  
  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Edelsteinen."
		);

  AddDetail ( "funkeln",
		 "Hmm ... dieses rote Funkeln... vielleicht ein Edelstein."
		);


  AddDetail ( "edelsteine",BS(
		 "Wenn du nur die richtige Ausruestung haettest, dann koenntest "
	 +   "du durchaus nach Edelsteinen graben ...")
			);

  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlem Fels und ist mit Felsbrocken "
	 +   "uebersaeht.")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an. Er ist mit silbernen "
                +"Faeden durchzogen. An einigen Stellen funkelt es bunt.");

  AddDetail ( ({"brocken", "steine", "felsbrocken"}),BS(
		 "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
	  +  "Du beschliesst mehr aufzupassen, um Dir nicht wehzutun. Unter den Brocken "
          +  "fallen Dir, in den Boden eingelassen, ein paar Symbole auf."));
  
  AddDetail ("symbole", BS(
             "Die Symbole zeigen eindeutig arkane Schutzsymbole, jedoch scheinen sie "
          +  "ihre Wirkung schon vor langer Zeit verloren haben, denn der Zahn der Zeit "
          +  "hat schon seine Spuren an ihnen hinterlassen. Unter den verschiedenen "
          +  "Zeichen sticht besonders das Symbol einer unheimlichen Gestalt hervor."));

  AddDetail(({"zeichen", "zeug"}),
            "Die Zeichen stellen fuer Dich nur wirres Zeug dar.");
  
  AddDetail(({"gestalt","symbol"}), BS(
            "Das Symbol zeigt eine gebueckte Gestalt, die eine Peitsche oder etwas aehnliches "
         +  "gen Himmel haelt. Die Gestalt weisst am Kopf zwei Hoerner auf. Das ganze kommt "
         +  "Dir recht unheimlich vor."));
  AddDetail("kopf", "Auf dem Kopf der Gestalt sitzen zwei Hoerner.");
  AddDetail("peitsche", "Die Peitsche sieht sehr gefaehrlich aus.");
  AddDetail("fackeln", "Die erleuchten die Hoehle.");  
  AddDetail("hoerner", "Die Hoerner sehen gefaehlich aus."); 
  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");


  AddExit( "norden", EBENE1("bergwerk_r29.lpc"));
}
