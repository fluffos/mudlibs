inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <player.h>
#include <moving.h>


void create()
{

  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Hier schuerfen die Zwerge nach Edelsteinen und den anderen Schaetzen "
	 +   "der Erde. Die ganze Hoehle ist von Fackeln hell erleuchtet. Der "
	 +   "Boden ist mit Staub und kleinen Steinchen uebersaeht. Hier und da "
	 +   "vermeinst Du ein rotes Funkeln zu sehen, und auch hier ist der Fels "
         +   "mit silbernen Faeden durchzogen. Es ist hier empfindlich kalt."));
	       

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp(P_INDOORS,1);

  AddDetail ( ({"raum", "hoehle", "felshoehle"}),BS(
		 "Die Hoehle wurde von Zwergen aus dem Fels herausgebrochen. Hier scheinen "
                +"sie noch aktiv nach Edelsteinen zu graben."));
	       
  
  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Edelsteinen."
		);

  AddDetail ( "funkeln",
		 "Hmm ... dieses rote Funkeln... vielleicht ein Edelstein."
		);


  AddDetail ( "edelsteine",BS(
		 "Wenn du nur die richtige Ausruestung haettest, dann koenntest "
	 +   "du durchaus nach Edelsteinen graben ...")
			);

  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlem Fels und ist mit Felsbrocken "
	 +   "uebersaeht.")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an. Er ist mit silbernen "
                +"Faeden durchzogen. An einigen Stellen funkelt es bunt.");

  AddDetail ( ({"brocken", "steine", "felsbrocken"}),BS(
		 "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
	  +  "Du beschliesst mehr aufzupassen, um Dir nicht wehzutun."));

  AddSound(DEFAULT_SOUND,"Von ueberall ist ein Haemmern und Klopfen zu hoeren.");
  AddSound( ({"klopfen", "haemmern"}),"BUMM...BUMM...KLOPF...KLOPF...");


  AddExit( "sueden", EBENE1("bergwerk_r29.lpc"));
}


