inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
		 "Ein Seitenstollen"
	 );
  SetProp( P_INT_LONG,BS(
		 "Der Stollen verbereitert sich hier so, dass man wieder bequem aufrecht "
         +   "begehen kann. Der Gang ist durch Stuetzbalken gesichert. Einige "
	 +   "dieser Balken liegen schon zerborsten am Boden. Es ist wohl nur eine "
	 +   "Frage der Zeit, bis dieser Stollen einstuerzen wird. Auch hier ist der "
	 +   "mit einer Staubschicht bedeckt. Der Gang im Sueden ist voellig "
	 +   "eingestuerzt, jedoch wurde auf der Suedostseite weitergegraben.")
		 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "stollen", "gang"}),BS(
		 "Der Stollen ist aus dem Fels geschlagen worden. Der Boden ist mit "
	 +   "einer Staubschicht bedeckt.")
		);

  AddDetail ( ({"staub", "schicht", "staubschicht"}),BS(
		 "HAATSCHI! Ja, die Staubschicht ist hier - HAATSCHI - einige Zentimeter "
	 +    "hoch. Danach zu urteilen war hier schon lange keiner mehr.")
			);

  AddDetail("decke", "Die Decke ist ueber Dir und besteht aus ... Fels!");

  
  AddDetail(({"wand", "waende"}), "Die Waende bestehen aus Fels.");
  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlen Fels und ist mit einer Staubschicht "
	 +   "bedeckt. Einige zerbrochene Balken liegen am Boden.")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( ({ "balken", "stuetzbalken" }),BS(
		 "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
	  +  "bestehen aus morschen Holz. Einige davon liegen zerbrochen "
	  +  "am Boden. Um diesen Abschnitt scheint sich keiner mehr zu "
	  +  "kuemmern.")
		);

  AddDetail ( "holz",
		 "Es sieht sehr morsch aus."
		);


  AddExit( "norden", EBENE1("bergwerk_r13.lpc"));
  AddExit( "suedosten", EBENE1("bergwerk_r15.lpc"));
  
}
