inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <player.h>
#include <moving.h>


void create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Hier schuerfen die Zwerge nach Gold und den anderen Schaetzen "
	 +   "der Erde. Die ganze Hoehle ist von Fackeln hell erleuchtet. Der "
	 +   "Boden ist mit Staub und kleinen Steinchen uebersaet. Hier und da "
	 +   "vermeinst Du ein goldenes Funkeln zu erkennen. Ein kleiner, "
	 +   "schmaler Spalt fuehrt weiter nach Osten. Dort haben sich die Zwerge "
	 +   "weitergearbeitet, und von dort kommt auch das ohrenbetaeubende "
	 +   "Klopfen.")
		 );


  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle", "felshoehle"}),BS(
		 "Die Hoehle wurde von Zwergen aus dem Fels herausgebrochen. Ein "
	 +	 "kleiner Spalt fuehrt nach Osten weiter, woher auch das laute "
	 +	 "Haemmern kommt. Der Spalt ist sehr klein und gehoert schon einiges "
	 +   "an Mut dazu, um da durchzukommen.")
		);
  
  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Gold."
		);

  AddDetail ( "funkeln",
		 "Hmm ... dieses Funkeln koennte durchaus Gold sein."
		);


  AddDetail ( "gold",BS(
		 "Wenn du nur die richtige Ausruestung haettest, dann koenntest "
	 +   "du durchaus nach Gold graben ...")
			);

  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlem Fels und ist mit Felsbrocken "
	 +   "uebersaeht.")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an."
		);

  AddDetail ( ({"brocken", "steine", "felsbrocken"}),BS(
		 "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
	  +  "Du beschliesst mehr aufzupassen, um Dir nicht wehzutun.")
		);


  AddDetail ("spalt",BS(
		 "Der Spalt geht nach Osten weiter. Wie du ihn so betrachtest bist "
	 +   "du dir sicher: DA wirst Du NIEMALS und um nichts in der Welt "
	 +   "durchklettern.")
			);




  AddSound ( DEFAULT_SOUND,
		 "WAS? WAS HAST DU GESAGT."
	 +   "ACHSO, JA, RICHTIG. DAS HAEMMERN HIER IST OHRENBETAEUBEND."
		   );
  AddSound("haemmern", "ECHT LAUT!");

  AddItem("/d/gebirge/angrox/npc/zarbeit", REFRESH_DESTRUCT);


  AddExit( "suedwesten", EBENE1("bergwerk_r6.lpc"));



}




