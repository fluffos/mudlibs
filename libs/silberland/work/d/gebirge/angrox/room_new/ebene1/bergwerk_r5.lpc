#pragma strong_types

inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Ein grob aus dem Stein gehauener Stollen");
  SetProp( P_INT_LONG,
        "Du befindest Dich hier in einem kleinen Gang. Die Waende, die Decke, "
        "alles besteht aus Fels. Am Boden des Ganges liegt ein riesiger "
        "Steinhaufen; unzaehlige kleine und grosse Steine erschweren das "
        "Vorankommen. Der Gang wird durch starke Balken "
	"gegen das Einstuerzen abgestuetzt. Laute Klopfgeraeusche kommen "
	"aus dem Osten.");
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  
  AddDetail("boden",
       "Der Boden besteht aus kahlen Fels. Auf dem Boden tuermen sich "
       "unzaehlige Steine zu einem grossen Haufen.");
  AddDetail(({"haufen", "steinhaufen"}),
       "Der Haufen besteht aus kleinen und grossen Steinen.");
  AddDetail("vorankommen", 
      "Das Vorankommen wird durch die Felsbrocken am Boden ganz schoen "
      "erschwert.");
  AddDetail( "steine",
       "Die Felsbrocken sind eigentlich ganz schoen gross und gefaehrlich "
       "kantig. Du beschliesst mehr aufzupassen, um dir nicht wehzutun.");

  AddDetail(({"brocken", "felsbrocken"}),
       "Uii - wenn dir ein solcher auf den Kopf faellt, na dann gute "
       "Nacht. Vorsichtig blickst du nach oben, aber da scheint alles "
       "stabil zu sein.");
  AddDetail("kopf", 
      "Du siehst hier keinen Kopf.");
  AddDetail(({"nacht", "ende"}),
      "Das waere wohl Dein Ende.");
  AddDetail(({"raum", "stollen", "gang"}),
        "Der Stollen ist aus dem Fels geschlagen worden. Hier und da sieht "
        "man Schuerfspuren, so als ob jemand nach Gold und Edelsteine "
        "gegraben haette.");
  AddDetail("gang", 
      "Der kleine Gang fuehrt Richtung Suedwesten ab.");
  AddDetail("seitengang", 
      "Der groessere Gang geht Richtung Norden.");
  AddDetail("klopfgeraeusche", 
      "Du koenntest lauschen.");
  AddDetail(({"spuren", "schuerfspuren"}),
      "Hier wurde eindeutig nach Gold und Edelsteine gegraben.");
  AddDetail("berg", "Du bist in ihm.");
  AddDetail(({ "gold", "edelsteine"}),
       "Hmm. Ob man hier vielleicht noch was finden koennte?");
  AddDetail(({"waende", "wand"}),
      "Die Waende hier besteht aus angenehm kuehlen Fels.");
  AddDetail( "boden",
       "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken und "
       "Steine uebersaeht. Pass bloss auf, dass Du Dir nicht weh "
       "tust!");
  AddDetail( "fels",
       "Der Fels ist rauh und fuehlt sich kalt an. Er ist sehr hart, und "
       "es ist erstaunlich, dass man in so hartem Gestein graben kann.");
  AddDetail("gestein", 
      "Das Gestein hier ist vorwiegend harter Granit.");
  AddDetail("granit", 
      "Der graue Granit scheint sehr hart zu sein. Dennoch wurde hier "
      "ohne unterlassen gegraben.");
  AddDetail("decke", 
      "Die Decke ist ueber Dir, und wird mit Stuetzbalken gestuetzt.");
  AddDetail("vorankommen", 
      "Das Vorankommen faellt Dir schwer.");
  AddDetail(({ "balken", "stuetzbalken"}),
       "Die Balken stuetzen den Gang, um nicht einzustuerzen. Sie "
       "bestehen aus Holz.");
  AddDetail( "holz",
       "Es sieht sehr alt aus, und scheint dennoch sehr robust zu sein.");
  AddSound(DEFAULT_SOUND,
       "Das Haemmern ist SEHR laut und scheint von Osten zu kommen.");
  AddSound ( ({"haemmern", "klopfgeraeusche"}),
                "Das Haemmern ist nun sehr laut.");
  AddExit( "osten", EBENE1("bergwerk_r6.lpc"));
  AddExit( "westen", EBENE1("bergwerk_r4.lpc"));
}
