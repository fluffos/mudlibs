inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Ein grosse Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Diese grosse Hoehle ist ueber und ueber mit Marmor ausgelegt. Am "
	 +   "nordlichsten Ende der Hoehle kannst du ein grosses Tor erkennen, "
	 +   "welches eine kleinere Manntuer besitzt. In der Mitte der Hoehle ist ein "
	 +   "grosses, kreisrundes Loch, und du kannst einen Arbeiter beobachten, "
	 +   "wie er Gold hineinleert. Offenbar fuehrt der Schacht wohl zur "
	 +   "Giesserei oder zur Muenzpraege. Die ganze Hoehle wird von Fackeln "
	 +   "erhellt.")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail( ({ "dreieck", "kreis", "rechteck" }), 
                break_string( "Dieses Symbol befindet an der Wand, in den "+
                "Marmor eingelassen.", 78 ) );
  AddDetail( ({ "symbole" }), 
                break_string( "Die Symbole zeigen ein Dreieck, ein Rechteck "+
                "und einen Kreis.", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "An den Waenden sind 3 Symbole abgebildet.", 78 ) );
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle ist vollkommen mit Marmor ausgelegt. Im Norden ist ein "
	 +   "grosses Tor, in der Mitte der Hoehle ein kreisrundes Loch.")
	 );


  AddDetail ( ({"boden", "steine"}), 
		 "Der Boden ist aufwendig mit Marmor gepflastert."
	 );

  AddDetail ( ({"marmor", "faeden"}),
            "Der Marmor ist von silberen Faeden durchzogen."
         );
           
  AddDetail ("decke",
		 "Du siehst die Decke ueber dir."
	 );

  AddDetail ( "mamor",
		 "Der Mamor ist wunderschoen gearbeitet."
		);

  AddDetail ( "arbeiter",
                 "Die Arbeiter werfen das Geld in das Loch.");


  AddDetail ( "fackeln",BS(
		 "Die Fackeln strahlen ein beruhigendes, warmes Licht und flackern "
	 +   "leicht. Sie sind an Fackelhaltern befestigt.")
	 );

  AddDetail ( ({"halter", "fackelhalter"}),BS(
		 "Die Fackelhalter sind fix an der Wand befestigt. In ihnen stecken "
	 +   "Fackeln.")
	 );


  AddDetail("gold",BS(
           "Das Gold wird in das Loch gekippt. Du ueberlegst nachzuspringen, doch du "
        +  "kannst deine Goldgier unterdruecken.")
           );  

AddDetail ("tor",BS(
		 "Das Tor besteht vollkommen aus Eisen und sieht schwer gepanzert aus. "
	 +   "Das Tor besitzt eine Manntuer.")
	 );

 AddDetail("eisen", "SEHR stabil, das Eisen.");


  AddDetail ( ({"tuer", "manntuer"}),
		 "Die Manntuer ist ca. 1.50 hoch, also auf Zwergengroesse ausgelegt."
	 );

  AddDetail ( ({"giesserei", "praegerei", "muenzpraege"}),
                 "Tja, aber von hier kannst du sie nicht sehen."
            );

  AddDetail ( ({"loch", "schacht", "abgrund"}),BS(
		 "Du blickst vorsichtig ueber den Rand des Loches, aber du kannst keinen "
	 +   "Boden erkennen. Du beschliesst dich diesem toedlichen Abgrund nicht mehr "
	 +   "zu naehern und gehst einige Schritte zurueck.")
	 );

  AddDetail("rand", 
      "Geh bloss nicht weiter, sonst faellst Du noch runter.");
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/angrox/npc/zwaechter2", REFRESH_DESTRUCT);


 
  NewDoor("norden", EBENE1("bergwerk_r21"),
             ({"manntuer", "tuer" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG, "Die Manntuer sieht sehr stabil aus.",
	     D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Manntuer.",
	     D_NAME, "Manntuer",
	     
              }) );
	     

  
 // AddCmd ("oeffne", "oeffne_etwas");
  
  AddExit( "sueden", EBENE1("bergwerk_r19.lpc"));

}

init()
{
  ::init();
 if (present("steinkreis", TP) && present("steindreieck", TP)  && present("steinrechteck", TP))
   teleportieren();
}


teleportieren()
{
 object ob;
    write("Als du die Hoehle betrittst, beginnen ploetzlich di."
         +"drei Steinsymbole zu leuchten. Du wirst von einer gleissende."
         +"Aura umhuellt und deine Sinne schwinden.");
   
    say (BS(TPN+" betritt die Hoehle. Ploetzlich flammt eine Aura um "
         +(PlayerGender==FEMALE ? "sie" : "ihn")+" auf und huellt "+TPN+" voellig "
         +"ein. Nachdem die Aura verschwunden ist, ist auch von "+TPN+ " keine "
         +"Spur mehr zu sehen."));


    TP->move(ROOM("heilig1.lpc"), M_TPORT, "wird von einer Aura umhuellt und verschwindet.");
    if (present("lichtkeule", TP))
      {
        ob=present("steinkreis",TP);
        ob->remove();
        ob=present("steindreieck",TP);
        ob->remove();
        ob=present("steinrechteck",TP);
        ob->remove();
      }
    return 1;
}
