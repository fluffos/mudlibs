inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <moving.h>
#include <player.h>

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine kleine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Du betrittst eine kleine, muffig riechende Hoehle. Auch "
		+"hier liegen Unmengen kleinerer Steinbrocken am verstaubten "
		+"Boden herum. Im Sueden befindet sich ein grosser "
		+"Geroellhaufen, der bis zur Decke der Hoehle reicht. Unter "
		+"dem Haufen liegen die Ueberreste eines Ungluecklichen, der "
		+"das Pech hatte, hier zu sein, als die Decke auf einen Besuch "
		+"vorbeikam. Es ist kalt.\n"));



  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:10]));
  AddDetail ( "hoehle",BS(
		 "Die Hoehle besteht vollkommen aus Fels: Boden, Waende, "
		+"Decke, einfach alles! Die Schatten an den Waenden, "
		+"verursacht durch Deine Lichtquelle, scheinen einen "
		+"spoettischen, grotesken Tanz aufzufuehren, was die "
		+"unheimliche Atmosphaere noch verstaerkt. Im Sueden "
		+"der Heohle befindet sich ein grosser Geroellhaufen.\n"));


  AddDetail ( "fels",BS(
		 "Der graue, kalte Fels fuehlt sich rauh an.\n"));

  AddDetail (({"waende", "wand"}), BS(
		 "Die Waende sind aus grauem, kalten, rauhen Fels. Einige "
		+"Felsbrocken sind schon aus der Wand gebrochen.\n"));

  AddDetail ( "decke", BS(
		 "Die Decke weist schon einige Risse auf, einige Felsbrocken "
		+"sind schon heruntergefallen. Wer weiss, wie lange die Hoehle "
		+"dem Druck von einigen tausend Tonnen Gestein noch aushaelt "
		+"...\n"));
  AddDetail ( "boden", BS(
		 "Der Boden ist mit einer Staubschicht bedeckt. Einige Steine "
		+"liegen herum, ebenso wie einige verottete Bretter.\n"));

  AddDetail("bretter", 
                 "Die Bretter, die am Boden liegen, sind total verrottet und zu "
                +"nichts mehr zu gebrauchen.");
 
  AddDetail ( ({"staub", "staubschicht"}),BS(
		 "Ihh - STAUB! Kommt denn - HUST! - hier niemand zum Putzen "
		+"her?!?!?!\n"));

  AddDetail ( "risse", BS(
		 "Die Risse ziehen sich wie ein Gespinst von Spinnenweben durch "
		+"die Decke.\n"));

  AddDetail ( ({"steine", "brocken", "felsbrocken", "gestein"}),BS(
		 "Zahlreiche Felsbrocken liegen am Boden.\n"));

  AddDetail (({"geroellhaufen", "geroell", "haufen"}), BS(
                "Der Geroellhaufen besteht aus kleinen, mittleren und riesigen "
               +"Steinen. Darunter liegen einige zwergische Skelette. Ein Stein "
               +"kommt Dir etwas locker vor.\n"));
  AddDetail("stein", BS(
                "Tatsache! Unter dem Stein befindet sich ein Loch, gerade gross genug, "
               +"dass Du durchklettern kannst!\n"));
  AddDetail("loch", BS(
                "Das Loch scheint nach Sueden zu fuehren... was da wohl alles lauern "
               +"mag?\n"));
  AddDetail(({"ungluecklicher", "skelett"}), "Er liegt fast voellig unter dem Schutt "
               +"begraben. Du kannst nichts auffaelliges an ihm entdecken.");
  AddDetail(({"ueberreste","ueberrest"}), "Die Ueberreste sind vollkommen von Schutt "
              +"bedeckt, so dass Du nicht mehr viel sehen kannst.");
  AddDetail("schutt", "Ziemlich viel Gestein ist von der Decke runtergekommen. Unter "
            +"dem Schutt siehst Du die Ueberreste des Ungluecklichen, der zu dem "
            +"Zeitpunkt darunterstand.");
  AddDetail("zeitpunkt", "Na, wann das halt passiert ist."); 

  AddSound ( DEFAULT_SOUND,BS(
		 "Du lauscht ... Totenstille ...\n"));
  AddSmell ( DEFAULT_SMELL, BS("Es riecht muffig hier.\n"));

  AddCmd(({"klettere", "kletter"}), "durch_loch");

  AddExit( "osten", EBENE3("ebene3_r4.lpc"));
  
}


durch_loch( str )
{
     notify_fail("Wo willst Du klettern?\n");
     if (str == "durch loch" || str == "durch Loch" || str=="in loch")
      {
        write("Du zwaengst Dich durch das enge Loch.\n");
        say (BS(TPN+" untersucht den Geroellhaufen und verschwindet dort in einem "
                   +"Loch.\n")); 
        TP->move(EBENE3("ebene3_r6"), M_GO, "klettert durch ein Loch.");
        return 1;
      }
     return 0;
}     












