inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <moving.h>
#include <player.h>

void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine grosse Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Du befindest dich im nordwestlichen Teil einer grossen, aus "
                +"schwarzem Basalt bestehenden Hoehle. Offenbar ist diese "
                +"Hoehle keineswegs natuerlichen Ursprungs, wie die vielen "
                +"Fratzen, die die Waende zieren, durchaus bestaetigen koennen. "
                +"Leider reicht dein Licht nicht aus, um die ganze Hoehle zu "
                +"beleuchten. In der Hoehle ist es kalt, die Luft ist "
                +"abgestanden.\n"));


  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:10]));
  AddDetail ( "hoehle",BS(
		 "Die Hoehle besteht vollkommen aus Basalt: Boden, Waende, "
		+"einfach alles! Und da das ganze eine dunkelschwarze "
		+"Farbe hat, kommt Dir das ganze so richtig gruselig vor. "
		+"Die Fratzen, die an den Waenden abgebildet sind, tun "
                +"ihr uebriges, und Du musst Dich schon zusammenreissen, "
                +"um nicht angsterfuellt alles wegzuwerfen und wegzurennen. "
                +"Im Norden der Hoehle ist ein Loch.\n"));
             
  AddDetail ( "basalt",BS(
		 "Der Basalt ist tiefschwarz und fuehlt sich eiskalt an.\n"));

  AddDetail (({"waende", "decke"}), BS(
		 "Alles vollstaendig aus schwarzem Basalt und "
                +"mit widerlichen Fratzen uebersaet.\n"));

 
  AddDetail ( "boden", BS(
		 "Der Boden ist mit einer Staubschicht - halt! Der Boden ist "
                +"definitiv NICHT mit einer Staubschicht bedeckt. Seltsam, oder?\n"));
		

  AddDetail ( ({"staub", "staubschicht"}),BS(
		 "Keine zu sehen. Offenbar wir dieser Raum reingehalten. Oder " 
                +"sollte eine andere Macht dahinterstecken?\n"
                +"Dich froestelt auf einmal.\n"));
 
  AddDetail("fratzen", BS(
                "Die Fratzen zeigen widerliche, gehoernte Figuren, die wie "
               +"Daemonen aussehen. Eine Gestalt, die eine Peitsche gen Himmel "
               +"haelt, ist ziemlich oft zu sehen.\n"));

  AddDetail("figuren", 
               "Die Figuren sehen wie Daemonen aus.");
  
  AddDetail("gestalt", BS(
                "Die Gestalt ist als einzige nicht nur als Gesicht zu sehen. "
               +"Sie ist gebueckt, scheint eine Robe mit einem Symbol zu tragen, "
               +"haelt eine Peitsche in der Hand und haelt diese Richtung Himmel.\n"));
   
  AddDetail("robe", "Die traegt die Gestalt.");
  AddDetail("flammen", "Sie umwabbern die Peitsche.");
  AddDetail("loch", BS(
                "Das Loch fuehrt nach Norden. Von dort kamst Du her.\n"));
  
  AddDetail ("symbol", BS(
                "Du kannst es leider nicht richtig erkennen.\n"));
 
  AddDetail ("peitsche", BS(
                "Die Peitsche scheint von Flammen umwabbert zu sein.\n"));
  AddSound ( DEFAULT_SOUND,BS(
		 "Du lauscht ... Totenstille ...\n"));
  AddSmell ( DEFAULT_SMELL, BS("Die Luft ist abgestanden.\n"));

 

  AddExit( "norden", "durch das Loch#"+EBENE3("ebene3_r5.lpc"));
  AddExit( "sueden", EBENE3("ebene3_r8.lpc"));
  AddExit( "osten", EBENE3("ebene3_r7.lpc"));
  AddExit( "suedosten", EBENE3("ebene3_r9.lpc"));
  
}







