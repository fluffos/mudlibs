inherit "std/room";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Hoehle besteht vollkommen aus Fels. Silbrige Faeden im Fels "
                +"reflektieren das Licht der Fackeln und tauchen die Hoehle in ein "
                +"fast unwirkliches Spiel von Licht und Schatten. Die Hoehle ist fast "
                +"vollstaendig von einem grossen, hoelzernen Bauwerk ausgefuellt. "
                +"Das Loch befindet sich inmitten der Hoehle an der Decke. Von ihm "
                +"kommt ein kuehler Lufthauch aus dem Inneren des Berges.\n"));


  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle besteht vollkommen aus hartem Fels, welches von silbrigen "
                +"Faeden durchzogen ist.\n"));
	
  AddDetail ( ({"felsboden", "boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein.\n");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergweoehnlich hart.\n"));

  AddDetail("faeden",BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair.\n"));

  AddDetail( ({"geruest", "holzgeruest", "konstruktion", "holzkonstruktion",
               "holzbauwerk", "bauwerk"}), BS(
            "Die hoelzerne Konstruktion besteht aus mehreren, in sich abgeschlossenen "
           +"Konstruktionen, offenbar soll das ganze aber eine Art Aufzug darstellen.\n"));
  
  AddDetail( "loch",BS(
             "Das Loch ist ziemlich gross und fuehrt nach oben. Aus ihm kommt ein kuehler "
            +"Lufthauch. Welche Geheimnisse wohl da oben darauf warten entdeckt zu werden?\n"));
  
  AddDetail("licht", BS("Das Licht kommt von Fackeln und taucht die Hoehle in ein Spiel "
                      +"von Licht und Schatten.\n"));

  AddDetail("schatten", BS("Die Schatten formen schoene Muster an die Wende.\n"));
  AddDetail("muster", BS("Schoen ... Du versinkst in Gedanken, doch dann wendest "
                        +"Du Dich wieder dem Ernst des Lebens zu.\n"));
  AddDetail("holz", BS("Du pochst daran. Ist stabil.\n"));
 AddDetail("berg", "Du befindest Dich in ihm.");

  AddSound(DEFAULT_SOUND,BS("Von ueberall ist ein Haemmern und Klopfen zu hoeren.\n"));
  AddSound( ({"klopfen", "haemmern"}),BS("BUMM...BUMM...KLOPF...KLOPF..."));

  AddItem(OBJ("aufzug"), REFRESH_DESTRUCT, 1);
   
  AddExit("osten", EBENE3("ebene3_r2.lpc"));
  AddExit("westen", EBENE3("ebene3_r4.lpc"));
  
}
















