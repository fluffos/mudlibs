inherit "std/room";  

#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include "../files.h"


create()
{
::create();

 
 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Eine kleine Hoehle");
 SetProp(P_INT_LONG, bs (
            "Du befindest dich in in einer kleinen Hoehle aus blanken Fels. Die "
          + "gesamte Hoehle scheint aus dem Gestein geschmolzen worden zu sein, "
          + "denn es sind keine Spuren von Bearbeitung zu entdecken. Die Hoehle "
          + "ist hell erleuchtet, obwohl keine Fackeln und keine anderen Beleuchtungskoerper "
          + "zu entdecken sind. Das Licht scheint irgendwie direkt aus dem Fels zu "
          + "kommen - seltsam ...  An der Nordwand befindet sich ein offenes Portal, "
          + "durch dem weiches, pulsierendes Licht faellt. @@zustand@@\n"));
	
 



 AddDetail( "hoehle",BS(
            "Diese Hoehle scheint uralt zu sein.\n"));

 AddDetail( ({"fels", "gestein"}),BS(
            "Der Fels ist voellig glatt und weist keine Spuren von Bearbeitung auf. " 
          + "Irgendeine Macht muss diese Hoehle aus dem Berg erschaffen haben.\n"));

 AddDetail( "licht",BS(
            "Das Licht scheint aus dem Fels zu kommen. Es ist schwach pulsierend. " 
          + "Ein Teil des Lichtes faellt aus dem geoeffneten Portal.\n"));

 AddDetail( "portal",BS(
            "Das Portal ist ein Wunderwerk der Schmiedekunst. Es scheint vollkommen aus "
          + "Platin zu bestehen. Es ist mit verschiedenen Zeichen und Symbolen bedeckt. "
          + "Aus dem Raum hinter dem Portal faellt pulsierendes Licht herein.\n"));

 AddDetail( ({"zeichen", "symbole"}),BS(
            "Die Zeichen scheinen uralt zu sein. Du spuerst, dass eine positive Aura von "
           +"ihnen ausgeht. Sie scheinen schwach zu Glimmen.\n"));
            
 AddSound( DEFAULT_SOUND, "Eine beruhigende Stille herrscht hier.\n");


 AddExit("norden", ROOM("heiligtum"));
 AddExit("sueden", ROOM("heilig1" ));
}

init()
{
  object ob;
  ::init();
 if (present("steinkreis", TP) && present("steindreieck", TP)  && present("steinrechteck", TP)
     && present("lichtkeule", TP))
  {
        ob=present("steinkreis",TP);
        ob->remove();
        ob=present("steindreieck",TP);
        ob->remove();
        ob=present("steinrechteck",TP);
        ob->remove();
   }
   
}

string zustand()
{
 if (PlayerAlign<0) 
    return "Du fuehlst Dich hier ausgesprochen unwohl.\n";
 return "Du fuehlst Dich hier wohl.\n";
}








