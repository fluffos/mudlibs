inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <wizlevels.h>
#include "../../files.h"


void create()
{
  ::create();
   //SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+
   //     "Dir faellt ein Loch am Boden auf.");
   AddDetail (({"platten", "steinplatten"}),
        "Diese Platten sind aus einem Dir unbekannten, violetten Material "
       +"gefertigt. Graessliche Motive sind in die Platten eingelegt."
       +"In einer der Bodenplatten ist ein Loch, welches nach unten "
       +"fuehrt.");
   AddDetail(({"bodenplatten", "bodenplatte"}), 
        "Eine der Bodenplatten ist offenbar von unten her aufgebrochen "
       +"worden. An ihrer Stelle klafft nun ein dunkles, schwarzes Loch, "
       +"welches nach unten in die ungewisse Tiefe fuehrt.");
   AddDetail("loch", 
        "Das Loch ist breit genug, um nach unten zu klettern.");
   AddDetail("tiefe", 
        "Was mag da unten wohl lauern?");
  
  AddExit( "nordosten", EBENE4("ebene4_x7y2.lpc"));
  AddCmd(({"kletter", "klettere"}), "downwards");
}

string weiteres()
{
return "Dir faellt ein Loch am Boden auf.";
}

int downwards(string str)
{
 notify_fail("Wohin moechtest Du klettern?\n");
 if(!str) 
   return 0;
// if(!IS_WIZARD(TP)) return 0;
 if(str!="loch" && str!="loch" && str!="nach unten") 
   return 0;
 TP->move("/d/unterwelt/connect/central/room/00+11+12", M_GO, 
          "", "klettert in die ungewisse Tiefe", 
           "kommt von oben durch das Loch hereingeklettert");
 return 1;
}
