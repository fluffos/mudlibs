inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <rooms.h>
#include "../../files.h"


void create()
{
  ::create();
   
  AddDetail("gestalt", BS(
                "Die Gestalt ist gebueckt, scheint eine Robe mit einem Symbol zu tragen, "
               +"haelt eine Peitsche in der Hand und haelt diese Richtung Himmel.\n"));
  AddDetail ("ornamente",BS(
                "Die Ornamente weben eine schier endlose Linie.\n"));
  AddDetail ("symbol", BS(
                "Das Symbol zeigt einen gehoernte Fratze.\n"));
  AddDetail ("fratze", BS(
                "Echt ecklig!\n"));
 
  AddDetail ("peitsche", BS(
                "Die Peitsche scheint von Flammen umwabert zu sein.\n"));

  NewDoor("westen", EBENE4("ebene4_x8y4"),
             ({"bronzetor", "tor" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
	     D_LONG, "Das Bronzetor ist mit verschiedenen Ornamenten verziert, in der Mitte des Tores ist eine Gestalt mit einer Peitsche abgebildet.\n",
	     D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Bronzetor.\n",
	     D_NAME, "Bronzetor",
	     
              }) );

   NewDoor("osten", EBENE4("ebene4_x10y4"),
             ({"silberportal", "portal" }), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG, "Das Silberportal ist ohne jegliche Verzierungen.\n",
	     D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Silberportal.\n",
	     D_NAME, "Silberportal",
	     
              }) );
 
}
string weiteres()
{
return "\nIm Westen ist ein Bronzetor, im Osten ein Silberportal.";
}






