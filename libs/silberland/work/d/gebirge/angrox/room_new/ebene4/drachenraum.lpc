inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();
   SetProp(P_INT_LONG, BS(
  "Du befindest Dich in einem Raum, der aus den Fels gehauen wurde. "
 +"Der ganze Raum ueber und ueber mit dunkelvioletten Steinplatten "
 +"ausgelegt. Jede Platte ist auf das kunstvollste verziert - nun, "
 +"wenn diese Verzierungen nicht so abgrundtief abstossende Motive "
 +"enthalten wuerden. Nicht nur wegen der Temperatur laufen Dir hier "
 +"eiskalte Schauer ueber den Ruecken. Die Angst kriecht in Deine "
 +"hintersten Gedanken.\n"));
 
  AddDetail("raum", "Du befindest Dich darin.");  

  AddItem(NPC("bergwerk_drache"), REFRESH_DESTRUCT);
  AddExit( "norden", EBENE4("ebene4_x1y1"));
 
}

string weiteres()
{
return "";
}
