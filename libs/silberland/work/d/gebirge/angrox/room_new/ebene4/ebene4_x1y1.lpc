inherit "/d/gebirge/angrox/room/ebene4/ebene4.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../../files.h"


void create()
{
  ::create();

  AddExit( "norden", EBENE4("ebene4_x1y2.lpc"));
  AddExit( "osten", EBENE4("ebene4_x2y1.lpc"));
  AddSpecialExit( "sueden", "drachenraum");
}

string weiteres()
{
return "";
}


drachenraum()
{
 if(TP->QueryProp(P_LEVEL)<20)
    {
      write(BS("Du traust Dich nicht nach Sueden zu gehen. "
        +"Du fuehlst Dich dazu nicht erfahren genug.\n"));
      say(BS(TPN+" scheint sich nicht nach Sueden zu trauen.\n"));
      return 1;
    }
 TP->move(EBENE4("drachenraum"), M_GO, "nach Sueden");
 return 1;
}
