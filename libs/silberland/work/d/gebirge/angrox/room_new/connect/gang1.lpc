inherit "std/room";  

#include "../files.h"
#include <properties.h>

create() {
  ::create();
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0);
  SetProp(P_INT_SHORT, "Hoehle");
  SetProp(P_INT_LONG, 
      "Du stehst in einer kleinen Hoehle. Der Boden, die Waende, die Decke, "
      "alles besteht aus grauem Granit. Vereinzelt sind ein paar silberne "
      "Sprenkel im Granit zu sehen. Im Osten erweitert sich die Hoehle, nach "
      "Westen hin verengt sich die Hoehle zu einem Gang.");
  AddDetail(({"wand", "waende", "granitwand", "granitwaende", "granitmauern", 
      "granitmauer", "mauer", "mauern" }), 
      "Die Granitwaende im Norden und im Sueden sind kuehl. Vereinzelt sind "
      "im Granit silbene Sprenkel zu sehen.");
  AddDetail("hoehle", 
      "Du stehst in einer kleinen Hoehle.");
  AddDetail("gang",
      "Der ist im Westen.");
  AddDetail("stein",                                                    
      "Stein, Stein, Stein, alles aus Stein im Berg! ");    
  AddDetail(({ "dunkelheit", "finsternis" }), 
      "Ziemlich finster hier.");
  AddDetail("boden", 
      "Der Boden besteht aus Granit und ist kalt.");
  AddDetail("decke", 
     "Die Decke ist - WoodyseiDank - ueber Dich. Du atmest auf.");
  AddDetail("woodyseidank", 
      "Ja, danke Woody, dass nicht bei allen nichtexistenten Woertern eine "
      "Skriptfalle ist.");
  AddSpecialDetail(({"woody", "woertern", "skriptfalle", "danke", "eintrag", 
      "skriptlog", "ihren"}),
      "Script1");
  AddDetail(({"staub", "staubschicht", "schicht"}),                        
     "Du malst gelangweilt einige Kreise in den Staub.");       
  AddDetail("granit", 
      "Hier besteht alles aus Granit. Der Granit ist ein grauer Stein, der "
      "ein paar silberne Sprenkel eingeschlossen hat.");
  AddDetail("sprenkel", 
      "Im Granit sind silberene Sprenkel eingeschlossen. Koennte das Silber "
      "sein?");
  AddDetail("silber", 
      "Hmmmja, das koennte wirklich Silber sein.");
  AddDetail("berg", 
      "Ja, der Berg. Da befindest Du Dich. Mittendrinnen.");
  AddExit(OSTEN, ROOM("gang2")); 
  AddExit(WESTEN, "/d/gebirge/dusty/zwerge/room/hoehle3");
}

string Script1() {
  int i;
  string *cmds;
  cmds=({"nimm alles aus beutel", "osten", "osten","lass alles fallen", 
      "westen", "westen", "tanze",
      sprintf("rufe %s ist ein OBERLULU!", 
          users()[random(sizeof(users()))]->Name(WER)),
      "rufe ICH BIN EIN SKRIPTER!",
      "rufe WARUM ERWISCHENS IMMER MICH!",
      "rufe ABER EGAL, ICH HAB EH NEUE SCRIPTS!"});
  for(i=0;i<=sizeof(cmds)-1;i++)
   TP->command_me(cmds[i]);
  return "Danke fuer Ihren Eintrag in das Skriptlog!\n";
}

