inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"



void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Hoehle besteht wie alles hier aus massivem Fels, welcher mit silbernen "
                +"Einschluessen durchzogen ist. Mehrere Fackelhalter, in denen hell lodernde "
                +"Fackeln stecken, erhellen den Raum. Der Boden ist mit grob gehauenen Steinen "
                +"gepflastert. Im nordoestlichsten Teil der Hoehle stehen ein Tisch und mehrere "
                +"Hocker. Von den Gaengen im Norden und im Sueden ist ein lautes Haemmern zu "
                +"vernehmen, waehrend aus dem Gang im Osten kein einziges Geraeusch zu vernehmen "
                +"ist. Oberhalb des oestlichen Ganges ist ein Schild angebracht.\n")); 

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle besteht vollkommen aus hartem Fels, welches von silbrigen "
                +"Faeden durchzogen ist.\n"));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein, von silbernen Faeden durchzogen.\n");

  AddDetail("gang", "Dort ist es seltsam ruhig.");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergwoehnlich hart.\n"));

  AddDetail( ({"faeden", "einschluesse"}),BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair.\n"));
  
  AddDetail( ({"fackelhalter", "halter"}),BS(
            "Die Fackelhalter bestehen aus bestem Stahl (rostfrei). Sie sind an der Wand "
           +"befestigt.\n"));

  AddDetail("fackeln", "Sie lodern hell.");

  AddDetail("schmuck",BS(
            "Jo, diese Einschluesse sehen wirklich gut aus.\n"));

  AddDetail("hocker",BS(
            "Um den Tisch herum stehen diese dreibeinigen Holzhocker. Es sind sieben Stueck, "
           +"aber das ist wahrscheinlich nur ein bloeder Zufall.\n"));

  AddDetail("tisch",BS(
            "Der Tisch besteht aus Holz. Auf dem Tisch befinden sich Teller, Besteck "
           +"und einige Essensreste.\n"));

  AddDetail("teller",BS(
            "Ganz normale Holzteller.\n"));
  
  AddSpecialDetail("besteck", "besteck");
           

  AddDetail(({"essensreste", "reste"}),BS(
            "Brot, Speck, Wurst, Kaese, Butter, Eier und ein halber Hamburger.\n"
           +"Ein Hamburger? - Hmm...wo der wohl herkommt?\n"));

  AddDetail(({"brot", "speck", "wurst", "kaese", "butter", "eier"}),BS(
            "Ziemlich angenagt. Du beschliesst das nicht anzufassen.\n"));

  AddDetail("hamburger",BS(
            "IHHHHHH -- EIN HAMBURGER !!!!! Vermutlich sogar von McKotz. Du ekelst Dich.\n"));

  AddDetail("schild",BS(
            "Da steht was drauf. Du glaubst, du koenntest es schaffen, es zu lesen.\n"));

  AddReadDetail("schild",
            "\n"
           + "------------------------\n"
           +"| Das Arbeiten in diesem |\n"
           +"| Abschnitt ist bis auf  |\n"
           +"|      weiteres zu       |\n"
           +"|      unterlassen       |\n"
           +" ------------------------\n");
          
                   
  AddSound(DEFAULT_SOUND,BS("Von ueberall ist ein Haemmern und Klopfen zu hoeren.\n"));
  AddSound( ({"klopfen", "haemmern"}),BS("BUMM...BUMM...KLOPF...KLOPF..."));

  AddExit("westen", EBENE2("bergwerk_e2_r1"));
  AddExit("osten", EBENE2("rebene2_r4"));
  AddExit("norden", EBENE2("ebene2_r6"));
  AddExit("sueden", EBENE2("ebene2_r8"));
}



besteck()
{
  return BS("Als Du das Besteck so betrachtest, fallen Dir die Worte Deiner Mutter ein:\""
         +"Messer, Gabel, Schere, Licht, sind fuer "
         +(PlayerGender==FEMALE ? "die kleine":"den kleinen")+" "+TPN+" nichts!\"\n");

}



