inherit "/d/gebirge/angrox/room/std_bergwerk";

#include <properties.h>
#include <language.h>
#include "../../files.h"
#include <player.h>
#include <moving.h>


void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, 
		 "Eine kleine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Du stehst in einer kleinen Hoehle. Die Waende bestehen aus Fels. "
	 +   "Die Hoehle ist kuenstlich und wurde von den Zwergen aus dem Fels "
	 +   "geschlagen, welcher auch hier diese wunderschoenen silbernen Einschluesse "
         +   "hat. Die vielen Schuerfspuren weisen darauf hin, dass an "
	 +   "dieser Stelle noch fleissig nach den Schaetzen der Erde gegraben wird.\n")
	 );

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Der Hoehle ist aus dem Fels geschlagen worden. Hier und da sieht "
	 +   "man Schuerfspuren.\n")
		);

  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Gold.\n"
		);

  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles aus hartem Stein, von silbernen Faeden durchzogen.\n");  
  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergweoehnlich hart. "
           +"Vielleicht wuerde es sich auszahlen hier zu graben?\n"));

  AddDetail( ({"faeden", "einschluesse"}),BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair.\n"));

  AddDetail ( "boden",
		 "Der Boden besteht aus kahlen Fels.\n"
		);

  
  AddItem (NPC("zarbeit1"));
  AddCmd ("grabe", "grabe");

  AddExit( "sueden", EBENE2("ebene2_r6"));


}

grabe( str )
{   

    notify_fail("Nach was willst du graben?\n");
    if (!present("spitzhacke",TP))
      {
       write("Du hast nichts zum Graben dabei.\n");
       return 1;
      }
    if (str == "nach gold")
      {
       
        write("Du graebst und graebst, findest aber nichts.\n");
        say(TPN+" graebt und graebt ...");
        return 1;
      }
          
     
    return 0;
}

