inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"
int tafel;


void create()
{
  ::create();
  tafel = 1;
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Eine Hoehle");
  SetProp( P_INT_LONG,BS(
		 "Diese fast kreisrunde Hoehle ist uber und ueber mit blutroten Steinen "
                +"ausgelegt. Am hinteren Ende der Hoehle steht ein Altar, der "
                +"vollkommen mit Blut besudelt ist. Der Gestank des Blutes schwaengert die "
                +"gesamte Hoehle und macht das Atmen beinahe unmoeglich. Ein leises "
                +"Pochen ist zu hoeren.\n"));

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  AddDetail ( ({"raum", "hoehle"}),BS(
		 "Die Hoehle ist fast kreisrund und ist ueber und ueber mit "
                +"blutroten Steinen bedeckt.\n"));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende"}), 
		 "Alles mit diesen Blutroten Steinen bedeckt.\n");

  AddDetail( "altar", BS(
                "Der Altar besteht vollkommen aus einem tiefschwarzen Gestein, welches "
               +"das Licht voellig verschluckt. Er ist vollkommen mit Blut besudelt. An "
               +"der Vorderseite des Altars befindet sich eine Nische.\n"));
  
  AddSpecialDetail("nische", "nische");
  AddDetail( "gestein", BS(
                "Es ist tiefschwarz und scheint das Licht zu verschlucken. Irgendwie "
               +"glaubst Du nicht, das das Gestein natuerlichen Ursprungs ist.\n"));

  AddDetail( "Blut", BS(
                "Es ist ueberall auf dem Altar. Vermutlich wurden hier intelligente "
               +"Lebewesen geopfert - zu wem auch immer...\n"));
  AddSound(DEFAULT_SOUND, BS("Es ist ein dumpfes Pochen zu hoeren.\n"));
  AddSound("pochen", BS("Wie das Haemmern eines Herzens...\n"));
  AddSmell(DEFAULT_SMELL, BS("Die Luft stinkt nach Blut.\n"));
  AddSmell ("blut", BS("Echt eklig, wie es danach stinkt.\n"));
  AddExit("sueden", EBENE2("ebene2_r13"));
}


reset()
  {
    ::reset();
    tafel = 1;
  }

create_tafel()
  {
    object a;
    a = clone_object(OBJ("steintafel"));
    return a;
  }

nische()
  {
    if (!tafel)
    return "Oops. Warum ist diese Nische leer?\n";
    write(BS("In der Nische liegt ein Steintafel, die mit Symbolen uebersaet ist.\n"));
    tafel_nehmen();
    return "";
  }

tafel_nehmen()
  {
    object a;
    int ret;
    a = create_tafel();
    ret = a->move(this_player());
    if (ret==ME_TOO_HEAVY)
    {
      write("Du versuchst die Steintafel zu nehmen, aber Sie ist zu schwer.\n");
      a->remove();
      return "";
    }
    write("Du nimmst die Steintafel.\n");
    say(capitalize(this_player()->name())+" nimmt etwas vom Altar.\n");
    tafel = 0;
    return "";
  }
       





