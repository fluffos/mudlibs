inherit "/d/gebirge/angrox/room/std_bergwerk";
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include <rooms.h>
#include "../../files.h"
#include "../../steintafelquest.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,
		 "Ein Gang"
	 );
  SetProp( P_INT_LONG,BS(
		 "Die Felswaende dieses Ganges sind offenbar voellig unbehauen und wirken "
                +"sehr alt. Mehrere leere Fackelhalter, die an den Waenden befestigt sind, "
                +"sind der einzige Schmuck dieses Ganges. Einige silbrige Faeden durchziehen "
                +"das Gestein. Am oestlichsten Ende des Ganges wird der Weg durch einen "
                +"grossen, schwarzen Runenstein blockiert. Vom Westen ist ein Haemmern zu "
                +"hoeren. Hier ist es unnatuerlich kuehl.\n")); 

  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  AddDetail ( ({"raum", "gang"}),BS(
		 "Der Gang besteht vollkommen aus hartem Fels, welcher von silbrigen "
                +"Faeden durchzogen ist.\n"));
	
  AddDetail ( ({"boden", "steine", "decke", "wand", "waende", "felswaende"}), 
		 "Alles aus hartem Stein, von silbernen Faeden durchzogen.\n");

  AddDetail ( "fels",BS(
            "Der Fels ist von silberen Faeden durchzogen und aussergweoehnlich hart.\n"));

  AddDetail( ({"faeden", "einschluesse"}),BS(
            "Die Faeden sind metallische Einschluesse im Fels. Sie sehen sehr schoen aus "
           +"und verleihen dem Ganzen ein wundervolles Flair.\n"));
  
  AddDetail( ({"fackelhalter", "halter"}),BS(
            "Die Fackelhalter bestehen aus bestem Stahl (rostfrei). Sie sind an der Wand "
           +"befestigt, allerdings befinden sich keine Fackeln in ihnen.\n"));
  AddDetail("stahl", "Der Stahl ist rostfrei.");
  AddDetail(({"schmuck", "flair"}),BS(
            "Jo, diese Einschluesse sehen wirklich gut aus.\n"));

  AddDetail(({"runenstein", "stein"}),BS(
            "Dieser Stein besteht vollkommen aus einem tiefschwarzem Material. Mehrere "
           +"seltsame Runen sind in ihm eingraviert. Es scheint so, als wuerde dieser "
           +"Stein den Durchgang zu tieferen Geheimnissen des Berges blockieren. Eine "
           +"koerperlich zu fuehlende Aura der Macht geht von ihm aus.\n"));

  AddDetail(({"runen", "rune"}),BS(
            "Die Runen scheinen in alt-zwergisch zu sein. Eine Rune sticht besonders "
           +"hervor: Sie zeigt eine bedrohlich aussehende Gestalt mit mehreren Hoernern, "
           +"welche eine Art Peitsche schwingt.\n"));

  AddDetail("gestalt",BS(
            "Diese Gestalt sieht irgendwie bedrohlich aus. Du versuchst die Rune genauer "
           +"zu betrachten, doch es ist Dir unmoeglich, sie laenger als ein paar "
           +"Augenblicke im Auge zu behalten.\n"));

  AddDetail("peitsche",BS(
            "Die Gestalt schwingt diese Waffe.\n"));

  AddDetail("material",BS(
            "Das Material scheint eine Art Metall zu sein. Es ist voellig blank poliert und "
           +"weist, bis auf die eingravierten Runen, keinerlei Unregelmaessigkeiten auf. "
           +"Noch nicht einmal der kleinste Kratzer ist auf dem Metall zu sehen.\n"));
  AddDetail("hoerner", BS("Die Hoerner sehen gefaehrlich aus.\n"));
  AddCmd("mlgor", "stein_weg");
  

  AddSound(DEFAULT_SOUND,BS("Vom Westen ist ein Haemmern und Klopfen zu hoeren.\n"));
  AddSound( ({"klopfen", "haemmern"}),BS("BUMM...BUMM...KLOPF...KLOPF..."));

  AddExit("westen", EBENE2("rebene2_r4"));
}

init()
{
 int i;
 string test;
 test=TP->QueryProp(P_QUESTS);
 if(TP->QueryQuest(TAFELQUEST))
          call_out("info", 1, TP);
 ::init();
 }


info(object player)
{
 tell_object(player,BS("Irgendwie weisst Du, dass Du einfach mit dem "
         +"magischen Wort ueber den Stein steigen kannst, "
         +"da Du dass ja schon mal gemacht hast."));
 
}

 
stein_weg()
{
 if(!present(QUESTSTEIN, TP) && !TP->QueryQuest(TAFELQUEST))
  {
    write(BS("Du sprichst das alt-zwergische Wort fuer \"wachse\" rueckwaerts aus. "
         +"Du wartest ... wartest ... wartest. Nichts passiert. Offenbar hast Du "
         +"irgendwas vergessen...\n"));
    return 1;
  }
 write(BS("Du sprichst das alt-zwergische Wort fuer \"wachse\" rueckwaerts aus, "
         +"als urploetzlich der Runenstein zu schrumpfen beginnt und den Blick "
         +"in einen weiterfuehrenden Gang freigibt. Du weisst nicht genau wie "
         +"lange der Stein so klein bleibt und wagst den Sprung nach vorne...\n"));
 
 say(TPN+BS(" spricht etwas in einer fremden Sprache, als der Stein ploetzlich "
        +"zu schrumpfen beginnt. "+(PlayerGender==FEMALE ? "Sie":"Er")+" kann gerade noch "
        +"nach vorne springen, als ploetzlich der Stein wieder zu wachsen beginnt.\n"));
 TP->move(EBENE2("ebene2_r10"), M_GO, "ueber den geschrumpften Stein");
 say(BS("Urploetzlich beginnt der Runenstein zu schrumpfen, bis er nur noch\n"
    +"faustgross ist. Durch diese Oeffnung kommt "+TPN+" herein.\n"
    +"Als "+(PlayerGender==FEMALE ? "sie":"er")+" den Stein passiert hat, beginnt\n"
    +"dieser auf seine urspruengliche Groesse zu wachsen.\n"));
 return 1;

}





