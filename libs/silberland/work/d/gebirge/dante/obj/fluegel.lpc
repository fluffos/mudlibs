//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"FLUEGEL", "fluegel"}));
   SetProp(P_NAME, "Geisterfluegel");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Die Fluegel eines Geisteradlers" );
   SetProp(P_LONG, BS(
  "Das sind die Fluegel eines Geisteradlers. Ob man mit ihnen fliegen kann?"));
    SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_FEATHER:100]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_WEIGHT,10 );
}
