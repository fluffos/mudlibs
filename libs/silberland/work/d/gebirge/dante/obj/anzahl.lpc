//zaehlt die geister
inherit "std/npc";             
#include <properties.h>    
#include "files.h"      
#include <moving.h>


int nummer=0;
 create()
   {
       if (is_clone(this_object()))
       {
         destruct(this_object());   
        return 1;
       }
        seteuid(getuid(this_object()));    
}

einermehr()
    {object ob;
    nummer++;
    ob=clone_object("d/gebirge/dante/npc/sgeist");
    ob->SetProp(P_SHORT, "Der satanische Geist Nummer "+nummer+"");
    ob->SetProp(P_LONG, BS(
    "Das ist der satanische Geist Nummer "+nummer+". Er ist boesartig "
    "und will nur eines, Dich sofort toeten!"));
    ob->SetProp(P_NAME, ({
    "der satanische Geist Nummer "+nummer+"",
    "des satanischen Geiste "+nummer+"",
    "dem satanischen Geist Nummer "+nummer+"",
    "den satanischen Geist Nummer "+nummer+""}));
    ob->move("d/gebirge/dante/room/altar",M_SILENT+ M_TPORT);      
    }
            