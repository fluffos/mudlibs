//traum fuer quest auf nageblbrett

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>
string oldtitle;

object player;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"TRAUM"}));
call_out("sta", 3);


 AddCmd ("", "no", 1);
   player=0;//unfug
SetProp(P_WEIGHT, 0);
}

int no()
{
write("Aber Du traeumst doch!\n");
return 1;
}

void init()
{
  ::init();
 if( !interactive(TP) )
    call_out("weg",0);
}



sta()
  {
   oldtitle=TP->QueryProp(P_TITLE);
  TP->SetProp(P_TITLE, "(schlafend auf einem Nagelbrett)\n");
//  player=this_player;//weg damit
  write("Wirr surren die letzen Ereignisse um Dich herum.\n");
  call_out("stb", 5);
  }
  
 stb()
   {
   write("Langsam formen sich Bilder in Deinem Kopf.\n");
   call_out("stc", 5);
   }
   stc()
   {
   write("Du siehst die verfluchten Katakomben.\n");
   call_out("std", 5);
   }
   std()
   {
   write("Vlad grinst Dich boesartig an.\n");
   call_out("ste", 5);
   }
   ste()
   {
   write("Du wandelst im Traum in den Katakomben umher.\n");
   call_out("stf", 5);
   }
   stf()
   {
   write("Ploetzlich wirst Du von einem Zoakon attackiert.\n"
   "Der Zoakon trifft Dich hart.\n");
   call_out("stg", 5);
   }
   stg() 
  {
  write("Glueck gehabt ist ja nur ein Traum!\n");
  call_out("sth", 5);
  }
  sth()
  {
  write("Du wanderst weiter durch die Katakomben!\n");
  call_out("sti", 5);
  }
  sti()
  {
  write("Du bleibst aus irgendeinem Grund in einem Raum ploetzlich stehen.\n");
  call_out("st1", 5);
  }
    
 st1()

 {
 write(
   "Du traeumst von einem Raum, in dem ein weisses Kreuz am Boden gezeichnet "
   "ist.\n");
 call_out("st2",5);

  }

st2()
  {
 write("Ein Mann murmelt seltsam Worte.\n");
      call_out("st3",5);
       }

 st3()
 {
   write(
     "Du verstehst sie sehr schlecht, aber Du glaubst er murmelt\n"
     "Sesam oeffne Dich, nein das wars nicht...\n");
  call_out("story4", 5);
  }
  
  story4()
  {
   write(
   "Nun verstehst Du ihn besser. Er murmelt: Verschlinge mich .\n");
  call_out("story5", 5);
  }
  
  story5()
  {
  write(
  "Sekunden spaeter wird er von irgendetwas verschlungen...\n");
  call_out("story6", 5);
  }
  story6()
{
 object ob; 
write(
   "Du erwachst aus Deinem Traum auf und fuehlst Dich frisch und erholt.\n");
  TP->heal_self(300);
     ob=clone_object("d/gebirge/dante/obj/tallow");
     
     if(!present("TALLOW", TP))
     {
     ob->move(TP, M_GO);
     }
     
  call_out("weg", 1);
  }

   
  weg()
   {
   TP->SetProp(P_TITLE, oldtitle);
   remove();
   }
   