//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein kleiner, runder Knochen");
  SetProp(P_LONG,BS(
  "Dieser Knochen hat nur einen Sinn. Er dient Deiner Rettung.\n"));
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Knochen");
  SetProp(P_MATERIAL, ({MAT_BONE}));
  AddId(({"knochen","playbone"}));
  SetProp(P_NOBUY, 1);
  
}
