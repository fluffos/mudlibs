 st1()

 {


 player=this_player();
 write(
       "Dir wird schwindlig und Du taumelst umher.\n");
  say(capitalize(player->name())+" taumelt umher.\n");

 call_out("st2",10);

  }

st2()
 { say(capitalize(player->name())+" leidet am Orkvirus.\n");
  TP->AddPoison(1);
 write("Du leidest am Orkvirus.\n");
 TP->reduce_hit_point(10);
      call_out("st3",10);
       }

 st3()
 {
  say(capitalize(player->name())+" bruellt: Ich bin ein Virenork.\n");
   write(
        "Du bruellst: Ich bin ein Virenork.\n");
  call_out("story4", 10);
  }
  story4()
  {
   say(capitalize(player->name())+" sagt: Viren, Viren, immer Viren.\n");
   write(
        "Du bist total infiziert mit Orkviren.\n");
        TP->reduce_hit_point(10);
  call_out("story5", 10);
  }
  story5()
  {  say(capitalize(player->name())+" kratzt sich wund...\n");
  write(
        "Die Viren erreichen Dein Hirn.\n");
  call_out("story6", 10);
    say(capitalize(player->name())+" leidet am Orkvirus.\n");
  }
  story6()
  {  say(capitalize(player->name())+" taumelt verseucht umher.\n");
  write(
        "Du spuerst die Viren in Dir.\n");
        TP->reduce_hit_point(20);
  call_out("story7", 10);
  }
  story7()
  {  say(capitalize(player->name())+" waelzt sich am Boden.\n");
  write(
        "Du waelzt Dich am Boden.\n");
  call_out("story8", 10);
  }

  story8()
  { write(
        "Die Viren verlassen Dich! Glueck gehabt!\n");
  say(CAP_TPN+" ueberlebt die Orkviren!\n");
  TO->remove();
  }
