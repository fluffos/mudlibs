inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>


object player;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"orkv","/norkv"}));
call_out("st1", 60);

SetProp(P_WEIGHT, 0);
}

