//obj fuer quest by dante
inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"


      int    antwHi;
      void   SetAntwHi();
      int    QueryAntwHi();
      void   RestoreAntwHi();



create()

{
 if(!is_clone(this_object())) return;
  
  ::create();
  seteuid( getuid(this_object()));  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"\nhoehlenquestbydante"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 
}

void SetAntwHi()
{
  antwHi++;
      }

//hoffentlich geht des

int QueryAntwHi()
{
  return antwHi;
  }
  
 
   void RestoreAntwHi()
     {
         antwHi=0;
               }
                      