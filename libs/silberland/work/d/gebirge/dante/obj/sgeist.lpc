// dante@SilberLand //monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
object pa;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  

  SetProp(P_GENDER, MALE);
  AddId(({"geist","satanischer geist"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(20);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen satanischen Klauen",200,DT_TERROR}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " loest sich in Luft auf!\n");
   
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");

  SetProp(P_SPELLRATE,70);
  
  AddSpell(3,300,
   "Der satanische Geist verflucht Dich!\n",
   "Der satanische Geist verflucht @WEN!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,400,
     "Der satanische Geist murmelt eine dunkle Formel!\n",
   "Der satanische Geist murmelt eine dunkle Formel!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

 AddSpell(2,100,
     "Der satanische Geist versucht teufliches Feuer zu erzeugen!\n",
   "Der satanische Geist versucht teufliches Feuer zu erzeugen!\n",
  DT_FIRE    , "spell_get");

  } 


void spell_get(object enemy, int damage, mixed dam_type)
{ 
int magie;
object ob;
magie=3+random(3);
ob=clone_object("d/gebirge/dante/npc/tfire");
if(magie)
  {
  tell_object(enemy,
  "Der satanische Geist schafft es Teufelsfeuer zu erzeugen.\n");        
   ob->move("d/gebirge/dante/room/altar", M_TPORT);
   magie--;
   }
   if(!magie)
      {
   tell_object(enemy,
   "Der satanische Geist hat keine Magie mehr.\n");
          }
      }
   
   
   reset()
   {
   ::reset();
   pa=present("gpan", TO);
  if(pa)   pa->remove(1);
   tell_object(environment(TO),
   "Der satanische Geist faehrt wieder zurueck in die Hoelle!\n");
   remove();
   }

  die(arg)
  {int i;
   object *feuer;
   feuer=({present("tfire", environment(TO))});
   for (i=sizeof(feuer)-1;i>=0;i--)               
   feuer[i]->remove();
//   tell_room("d/gebirge/dante/room/altar",
//   "Das Teufelsfeuer eilt seinem Herrn in die Hoelle nach!\n");
  write_file("/d/gebirge/dante/log/npc.kills",
             ctime()+": "
                  +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
                     +" killt den Geist.\n");
                     ::die(arg);
    }
       

  
   void NotifyPlayerDeath(object player, object killer, int lostexp)
         {
         command("nimm alles aus leiche");
         command("friss leiche");
         shout(""+player->name()+" hat gerade "+lostexp+" Eps verloren.\n"
         "Danke lieber, satanischer Geist!\n");
    write_file("d/gebirge/dante/log/npc.deads",
    ctime()+":"
    "Der Geist hat "+CAP_TPN+" getoetet.\n");
    TO->heal_self(500);
    }
         