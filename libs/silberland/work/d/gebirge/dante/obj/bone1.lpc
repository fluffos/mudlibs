//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"gebeine", "knochen","schaedel","totenschaedel", "BONE1"}));
   SetProp(P_NAME, "Noerds Schaedel");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 0 );
   SetProp(P_SHORT, "Noerds Schaedel" );
   SetProp(P_LONG, BS(
   "Das ist der Totenschaedel von Noerd. Besonders aufregend sieht er nicht aus."));
    SetProp(P_MATERIAL, ([MAT_BONE:100, MAT_MAGIC:10]));
   SetProp(P_NOGET, 0);   
   SetProp(P_NODROP, 1);
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,100 );
}


