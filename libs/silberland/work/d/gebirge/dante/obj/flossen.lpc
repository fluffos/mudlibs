//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"FLOSSEN", "flossen"}));
   SetProp(P_NAME, "Geisterflossen");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Die Flossen eines Geisterfisches" );
   SetProp(P_LONG, BS(
  "Das sind die Flossen eines Geisterfisches. " 
  "Ob man mit ihnen schwimmen und tauchen kann?"));
    SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_MISC_DEAD:100]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_WEIGHT,10 );
}
