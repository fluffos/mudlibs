//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"stein","figur","steinfigur","gate"}));
   SetProp(P_NAME, "Stein");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine kleine Steinfigur" );
   SetProp(P_LONG, BS(
   "Diese kleine Steinfigur stellt ein seltsames Wesen dar. Auf seinem "
   "Ruecken traegt es viele, winzige Kreuze, an die ein jeweils ein Opfer "
   "geschlagen wurde."));
   AddSpecialDetail("opfer", "d_s");
   AddDetail(({"wesen"}),
   "Seltsam sieht es aus.");
   AddDetail("ruecken",
   "Er ist krumm.");
   AddDetail(({"kreuz","kreuze"}),
   "Sie sind winzig.");


SetProp(P_MATERIAL, MAT_STONE);



   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL, ({MAT_STONE}));   
   SetProp(P_VALUE,500);
   SetProp(P_WEIGHT,100 );
}
  string d_s()
  {
  write("Das Opfer bist Du, "+CAP_TPN+"!\n");
  return "";
  }
  