//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"nagel", "NAGEL","eisennagel","gate2"}));
   SetProp(P_NAME, "Eisennagel");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein rostiger Eisennagel" );
   SetProp(P_LONG, BS(
   "Dierser Nagel ist vollkommen normal. Rostig, verbogen, alt. Nur seine "
   "Spitze faellt Dir auf."));
   AddDetail(({"spitze"}),
   "Du siehst getrocknetes Blut an ihr.");
   AddDetail("blut",
   "Irgendjemand wurde damit gekreuzigt.");
  SetProp(P_INFO, ("Mit diesem Nagel kann man jemanden kreuzigen!\n"));


    SetProp(P_MATERIAL, ([MAT_IRON:100, MAT_BLOOD:10]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,100);
   SetProp(P_WEIGHT,10 );
}
