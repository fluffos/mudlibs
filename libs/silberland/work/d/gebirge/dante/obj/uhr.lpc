//sanduhr by dante sl 98

inherit "std/thing";
#include <properties.h>
#include "files.h"

create()
{
	::create();
	SetProp(P_SHORT,"Eine kleine Sanduhr");
	SetProp(P_LONG,BS(
	"Diese kleine Sanduhr besteht aus Holz und seltenen Erden und "
	"Metallen. Ihr Inneres schimmert bunt und wechselt oft die Farbe. "
	"Mit <stime> zeigt sie Dir die Zeit an und mit <scol> die momentan "
	"vorherrschende Farbe."));

AddDetail("holz",
"Schoenes, hellbraunes Holz.");
AddDetail(({"erde","erden"}),
"Seltene Erden aus allesn Teilen des Landen!");
AddDetail(({"metalle", "metall"}),
"Harte, weiche, bunte...");
AddDetail("farbe",
"Sie kann sehr viele Farben haben!");
AddDetail(( {"inneres","innerem", "inneren"}),
	"Schau rein mit <scol>.");
	AddDetail("zeit",
	"Na mach doch einfach <stime>.");
	
	AddId("sanduhr");
	AddId("uhr");
	SetProp(P_NAME, "Sanduhr");
	SetProp(P_GENDER, FEMALE);
	SetProp(P_NODROP, 1);
	SetProp(P_NEVERDROP, 0);
	SetProp(P_VALUE, 1000);
	SetProp(P_ARTICLE, 0);
        SetProp(P_AUTOLOAD, 1);	
	SetProp(P_WEIGHT, 200);
        SetProp(P_MATERIAL, ([MAT_GLASS:30, MAT_METAL:10, MAT_SAND:10,
        MAT_EARTH:10, MAT_MISC_MINERAL:10, MAT_EBONY:20]));
        SetProp(P_NOBUY, 1);   
        SetProp(P_MAGIC, 1);
        SetProp(P_INFO, "Du bist stolz so eine Sanduhr zu besitzen!\n");
        AddCmd("stime", "uhr");
        AddCmd("scol","farbe");
}

uhr()
   {
write("Du betrachtest das Innere und in Deinem Kopf formt sich ein Gedanke:\n"
      "Es ist nun genau "+dtime(time())[19..]+".\n");  
	return 1;
     }

farbe()
{
	string *colo;
		int i;

	colo=({"gruen", "rot", "gelb", "blau", "schwarz", "orange"});
	i=random(sizeof(colo));
	write("Das Innere der Sanduhr ist gerade "+colo[i]+".\n");
	return 1;
}


