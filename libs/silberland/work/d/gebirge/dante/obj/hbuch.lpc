//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"


int kills;
create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein altes, verfallenes Ritualbuch");
  SetProp(P_LONG,BS(
  "Aus diesem Buch hat man frueher seltsame Rituale gelesen. Angeblich "
  "dienten sie der Abwehr von Untoten und Geistern die keine "
  "Ruhe finden..."));
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Buch");
  SetProp(P_MATERIAL, ({MAT_PAPER}));
  AddId(({"buch","hbuch", "ritualbuch"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Du kannst aus diesem Buch ein Ritual lesen.\n");
  SetProp(P_NEVERDROP, 1);
  kills=5;
  AddCmd(({"lies", "lese"}), "rut");
}
   int rut(string str)
     {
     int althp;
      notify_fail("Was willst Du aus dem Buch lesen?\n");
      if (!str) return 0;
      if (str=="ritual aus buch")
          {
          
        if(!present("\nhoehlenquestbydante", TP))
           {
            write("Du kannst aus diesem Buch nichts lesen!\n");
            return 1;
            }
            
      if(present("\nhoehlenquestbydante", TP))      
         {

           if(!kills)
           {
           write("Das Buch wird zu einem Geist und fliegt davon!\n");
           remove();
           return 1;
            }
         
         if(!present("wgeist", environment(TP)))
           {
           kills--;
         write("Du liest ein altes Ritual, aber nichts passiert.\n");
         return 1;
         }
    
          if(kills)
          {kills--;
            
      write("Du liest ein altes Ritual aus dem Buch, Blitze zucken "
      "aus dem Himmel herab und zerfetzen den Geist!\n");
   call_other("d/gebirge/dante/npc/wgeist", "pain", TPN);
      
      return 1;
      }
    return 0;
      }
      
   return 0;
  }
 return 0;
 }
