//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein silbernes Kreuz");
  SetProp(P_LONG,BS(
  "Das Kreuz ist sehr schlicht und besteht aus purem Silber."));
  SetProp(P_VALUE,1000);
  SetProp(P_WEIGHT,50);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Kreuz");
  SetProp(P_MATERIAL, ({MAT_SILVER}));
  AddId(({"cross","kreuz"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
}
