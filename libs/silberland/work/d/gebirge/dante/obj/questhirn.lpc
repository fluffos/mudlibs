//hirn fuer quest dante
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"HIRN", "hirn","gehirn"}));
   SetProp(P_NAME, "Idiotengeisthirn");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Das Hirn eines Idiotengeistes" );
   SetProp(P_LONG, BS(
   "Das ist das kuemmerliche Hirn eines Idiotengeistes, der schon zu Lebzeiten "
   "einer war. Damit kann man rein gar nichts anfangen. Vielleicht verbloedet es "
   "Dich sogar.")),
   SetProp(P_INFO, "Brav, Du identifizierst ja wirklich alles!\n");
     SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_MISC_DEAD:100]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_WEIGHT,10 );
}
