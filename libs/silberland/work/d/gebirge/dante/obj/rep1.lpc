//reporter den man fuer quest die bilderquest killen muss
//rennt rum im sl, wird per random irgendwohin getranst
//man kann aber mit teile mit festestteln wo er is dante sl98


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>

object cash;
void create()
{
 
  if (!is_clone(this_object())) return;
     ::create();

                                              
  SetProp(P_SHORT, "Razzi Baba");
  SetProp(P_LONG, BS(
  "Das ist Razzi Baba, der rasende Reporter, immer auf der Suche nach "
  "Neuigkeiten und Geruechten, die er schonungslos verbreitet. Luegen sind "
  "ihm auch nicht fremd. Viel Zeit um sich mit Dir zu unterhalten..."));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Razzi Baba");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  AddId(({"baba","razzi", "razzi baba", "reporter"}));
  
  SetProp(P_WIMPY,50);
  
  SetProp(P_INFO, ("Razzi Baba hat die gestohlenen Bilder.\n "));
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinen Haenden",110+random(30),({DT_BLUDGEON}) }));
  SetProp(P_BODY, 20+random(10));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, 0);//nuur im mom so
  SetProp(P_MSGIN, "rast neugierig herein");
  SetProp(P_MSGOUT, "rast auf der Suche nach Neuigkeiten");
  SetProp(P_MMSGIN, "rast neugierig herein");
  SetProp(P_MMSGOUT, "rast neugierig davon");
  SetProp(P_MNPC_AREA, ("/d/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS +MOV_SPECIAL+ MOV_MOVES +MOV_INDOORS +MOV_INFIGHT);
  SetProp(P_MNPC_WAIT, ({1, 5, 5}));
  SetProp(P_MNPC_DEFAULTROOM, ("/d/ebene/Midas/room/room_d5"));

  SetProp(P_DIE_MSG,  " schreit sterbend: Na, wenn das keine Schlagzeilen gibt!\n");
  SetProp(P_NOCORPSE, 0 );
  AddInfo("dante",
  "Dante ist angeblich der tollste hier.\n","lacht bloed: ");
  AddInfo(({"bild","bilder"}),
  "Du meinst die Nacktbilder?", "lacht: ");
  AddInfo(({"nacktbild","nacktbilder"}),
  "Hehehe, die geb ich nicht her!\n", "lacht: ");
  AddInfo("zeitung",
  "Fuer die arbeite ich!", "sagt: ");
  AddInfo("post",
  "Du meinst die miese Dschungelpost...", "sagt: ");
  AddInfo("dschungelpost",
  "Diese Armleuchter....!", "sagt: ");
  AddInfo(({"slp","SLP"}),
  "Viel zu serioes, keine Nacktbilder, kaum Skandale...", "schimpft: ");
  AddInfo("reporter",
  "Ich bin einer und Du willst einer sein...", "grinst: ");
  AddInfo("pu",
  "Der Idiot kann nichts!", "sagt: ");
  AddInfo("litza",
  "Hehe, ein Stuemper, hab ihm Nacktbilder gestohlen!", "lacht: ");
  
  
  AddInfo(DEFAULT_INFO,({        
   "sagt: Sorry, muss recherchieren.\n",
   "sagt: Keine Zeit, ich recherchiere grad.\n",
   "sagt: Hmm, weiss nicht...\n",
   "sagt: Frag einen anderen Spieler.\n",
   "sagt: Nichts ist so alt wie die zeitung von gestern!\n",
   "sagt: Weisst Du was neues?\n",
   "sagt: Los, erzaehl mir Neuigkeiten!\n",
   "sagt: Stimmt es, dass der Balrog schwul ist?\n",
   "sagt: Angeblich ist Dante ein Wurtmagier...\n",
   "sagt: Los, gib mir News, ich zahle gut?\n"}));
    
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Razzi sagt: Danke, aber keine Zeit.\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(1,250,
    "Razzi tritt Dich nieder.\n",
    "Razzi tritt @WEN nieder.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
AddSpell(2, 200,
   "Razzi verbreitet boese Geruechte ueber Dich.\n",
   "Razzi verbreitet boese Geruechte ueber @WEN.\n",
        DT_TERROR,([SP_SHOW_DAMAGE:1]));    

  AddSpell(1,250,
    "Razzi rammt Dich nieder.\n",
    "Razzi rammt @WEN nieder.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
     "Razzi stolpert.\n"
     "Razzi sagt: Tschuess.\n",
     "Razzi ruelpst.\n",
     "Razzi sagt: Ich brauche Skandale!\n",
     "Razzi sagt: Weisst Du etwas ueber Dustys Liebe?\n",
     "Razzi sagt: Stimmt  es, dass Midas abgebrannt ist?\n",
     "Razzi sagt: Hmm, was is los?\n",
     "Razzi sagt: Gibts eine neue Quest?\n"}));
set_living_name("razzi");
     
  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(300)); 
  cash->move(ME);     
    
    
      
  CLONEME ("/d/ebene/lamuerte/wwald/obj/sschuhe");
  CLONEME("/d/ebene/obj/ruestung/otterfell");
  command("trage alles");

}



 catch_tell(string str)
    {
            string dum1,dum2,dum3;
      if(sscanf(str,"%s teilt Dir mit: %s",dum1,dum2))   
      { call_out("back",2,dum1,dum2);}
                        }

   back(string dum1,string dum2)
     {  string dum3;
        object ob;
   object env;
   string *path;
   string ans;               
 dum3=explode(dum1," ");
   dum3=dum3[sizeof(dum3)-1];
  ob=find_player(lower_case(dum3));
             
    if(strstr(dum2,"wo bist du")!=-1 || strstr(dum2,"Wo bist du")!=-1)
  {
 path=explode(file_name(env),"/");
   if (path[0]=="d")
     {
         switch(path[1])
             {
    case "dschungel":
     case "gebirge":
    case "kristallwald":
   case "huegelland":  
      ans="im "+capitalize(path[1]);        
      break;
         case "polar":
     ans="im Polargebiet";
     break;
   case "wasser":
           ans="am Wasser";
      break;
     case "ebene":
    switch(path[2])
    {
    case "Gaffos":
     ans="bei den Gaffos";
  break;
  case "Silberwald":
     case "Park":
   ans="im "+path[2];  
   break;
      case "Midas":
     ans="in Midas";
       break;
       default:
     ans="in der Ebene";
    } 
     break;
    case "wueste":
     case "tundra":
       case "unterwelt":
     ans="in der "+capitalize(path[1]);
    break;
     case "wahnsinn":
  
     ans="in einer verrueckten Umgebung";
             break;
     default:
             ans="werweisswo ..";
      }
          ans="Ich bin "+ans+".\n";
            }
 if (path[0]=="players")
  ans="Ich hab mich verlaufen - ich schaetze, "+capitalize(path[1])+
  " hat was damit zu tun ...\n";               
 if (path[0]=="gilden")
     ans="Ich bin in einer Gilde.\n";
   }
         
  tell_object(ob,
  "Razzi Baba teilt dir mit: Ich bin "+ans+"!!! \n");
  }
  
  else
  {
  switch(random(5))
     {
     case 0:
     tell_object(ob,
     "Razzi Baba teilt Dir mit: RUHE! Ich recherchiere!\n");
     break;
     case 1:
        tell_object(ob, 
        "Razzi Baba teilt Dir mit: Sorry, keine Zeit fuer Dich! \n");
        break;
        case 2:
        tell_object(ob,
    "Razzi Baba teilt Dir mit: Bin an einer brandheissen Sache dran!\n");    
    break;
     case 3:
        tell_object(ob, 
    "Razzi Baba teilt Dir mit: Hast Du neue Geruechte fuer mich?!?!?\n");
    break;
    case 4:
       tell_object(ob, 
       "Razzi Baba teilt Dir mit: Stimmt es, dass Du dumm bist?\n");
       break;
       default:tell_object(ob,
       "BUG!\n!");
      }
  }    
       
}
               








 Defend(int dam, string dtype, int spell, object enemy)   
 {
 if(!present("KILLREP", enemy))
 {
 write("Razzi zieht Dir eine ueber den Schadel und bruellt dann laut:\n"
 ""+CAP_TPN+" macht noch in die Windeln!\n");
 shout("Razzi Baba bruellt: "+CAP_TPN+" macht noch in die Windeln!\n");
        enemy->StopHuntFor(ME);
                StopHuntFor(enemy);
 
    }
    else
       return::Defend(dam, dtype,spell, enemy); 
       
    }
       
  
  
  die(arg)
    {
    object ob;
    ob=clone_object("d/dschungel/dante/news/obj/porno");
    ob->move(TP, M_NOCHECK);
    if(present("KILLREP", TP))
      {
       ob->move(TP, M_NOCHECK);
      write("Sterbend wirft Dir Razzi Baba die Nacktbilder zu!\n");
      }
   ::die(arg);
   }
           
    
    

 void init()
{
 ::init();

 if (interactive(TP)) call_out("hallo", 0);
 }
 
 
 
 void hallo()
    {
    if(present("NEWS", TP))
      {
write("Razzi sagt: "+CAP_TPN+", hau ab, das sind meine Schlagzeilen!\n");
      }
      if(present("ELEF", TP))
      {
write("Razzi sagt: "+CAP_TPN+", suchst wohl den weissen Elefanten!!!\n");
      }
   if(present("KILLREP", TP))
   {
   write("Razzi sagt: "+CAP_TPN+", hau bloss ab!!!\n");
   }
      
    else
    {
    write("Razzi sagt: "+CAP_TPN+", was gibts Neues!?\n");
    }
   }
      
          
