#include "../def.h"   
inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"


int count;
create()

{
 if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
count = 0;

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"TUB"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 call_out("a", 30);
}
   
   a()
   {
   write("Ploetzlich scheinen Deine Lungen zu schmerzen.\n");   
   call_out("b", 15);
   }
   
    b()
   {
   write("Du hustest auf einmal sehr stark.\n");
   call_out("c", 15);
   }
   
   c()
   {
    if (count>=random(8)+(5))
       {
    call_out("ende", 10);
        }
    else
        {
    
    switch(random(7))
         {
      case 0:
     write("Deine Lungen schmerzen sehr.\n");
             count++;
             break;
      case 1:
       write("Du hustest stark.\n");
      count++;
      break;       
      case 2:
      write("Waeh! Du spuckst ekligen Schleim hoch.\n");
      count++;
      break;
      case 3:
      write("Du hustest wie ein Kettenraucher.\n");
      count++;
      break;
      case 4:
     write("Ekliger Auswurf wird von Dir rausgehustet.\n");
      count++;
      break;
      case 5:
      write("Deine Lungen stechen brutal.\n");
      count++;
      break;
      case 6:
      count++;
      write("Tja, Du hast Tuberkulose.\n");
      break;
      default:write("BUG!\n");
      }
      call_out("c", random(5)+(8));
      
     }
   }
     
     
    void ende()
     {
     if(present("noerd", environment(TP)))
      {
      write("Deine Tuberkulose scheint vorbei zu sein.\n");
     remove(TO);
     }
      
      if(!deep_present("hfl2", TP))
     {
     call_out("nix", 0);
     }
    
      
      if(!deep_present("BONE3", TP))
     {
     call_out("nix", 0);
     }
      
      if(!deep_present("BONE4", TP))
     {
     call_out("nix", 0);
     }
    
      
      if(!deep_present("BONE2", TP))
     {
     call_out("nix", 0);
     }
      
      if(!deep_present("gebeinsarg", TP))
     {
     call_out("nix", 0);
     }
    
if(file_name(environment(TP))!=("/d/gebirge/dante/room/ngrab"))
   {
   write("Der Geist von Noerd teilt Dir mit: Hier kannst Du mir nicht helfen!\n");
   remove();
   }    
     
     
     if(!present("noerd", environment(TP)))
     {
     write("Ploetzlich beginnt es zu surren und flimmern.\n"
     "Ein Geist scheint sich Dir zu naehern.\n"
     "Du bekommst es mit der Angst zu tun!\n");
     call_out("come", 10);
     }

    if(!deep_present("BONE1", TP))
      {
      call_out("nix", 0);
      }

     
     
     
     
     }
          
   void come()
     {
     object ob;
     ob=clone_object("d/gebirge/dante/npc/noerd");
     ob->move("d/gebirge/dante/room/ngrab", M_GO+M_SILENT);
      ob->SetOwner(getuid(TP));
     write("Huch! Du erschreckst Dich!\n");
     write("Der Geist von Noerd kommt aus seinem Versteck hervor.\n"
     "Der Geist von Noerd sagt: Wer hustet da so eklig herum!\n");
     remove();
     }
     
     
     void nix()
     {
     
 write("Der Geist von Noerd teilt Dir mit: Hmm, noch kannst Du mir nicht\n"
       "Der Geist von Noerd teilt Dir mit: helfen, komm spaeter wieder.\n");    
     remove();
     }     