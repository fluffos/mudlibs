//knochen fuer quest dante sl 98
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"gebeine", "knochen","beine",
   "schenkel","oberschenkelknochen", "BONE2"}));
   SetProp(P_NAME, "Noerds Oberschenkelknochen");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 0 );
   SetProp(P_SHORT, "Noerds Oberschenkelknochen" );
   SetProp(P_LONG, BS(
  "Das sind Noerds Oberschenkel. Sie sind recht kurz, er muss wohl eher ein Zwer gewesen sein."));
    SetProp(P_MATERIAL, ([MAT_BONE:100, MAT_MAGIC:10]));
   SetProp(P_NOGET, 0);   
   SetProp(P_NODROP, 1);
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,100 );
}


