//master fuer mund


 create()
   {
       if (is_clone(this_object()))
       {
         destruct(this_object());   
        return 1;
       }
        seteuid(getuid(this_object()));    
}

start()
  {
  call_out("machauf", 10);
   }
   
 machauf()
 {
  tell_room("d/gebirge/dante/room/mund",
  "Der Mund oeffnet sich.\n");
  call_out("zu", 10);
  call_other("d/gebirge/dante/room/mund", "open");
  }
  
  
  zu()
{
     call_other("d/gebirge/dante/room/mund", "schliessen");
    tell_room("d/gebirge/dante/room/mund",
      "Der Mund schliesst sich.\n");
      call_out("machauf", 10);
      }
          