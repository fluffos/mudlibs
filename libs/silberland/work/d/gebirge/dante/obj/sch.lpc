//spezialschaufel by dante fuer hoehlenquest
inherit "/std/thing";
#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Schaufel");
  SetProp(P_LONG,BS("Diese Schaufel gehoerte einst dem Totengraeber. "
  "Eigentlich sieht sie ja ganz normal aus, irgendwas scheint aber "
  "doch besonders an ihr zu sein."));
  AddId(({"schaufel","\ndanteschaufel"}));
  SetProp(P_NAME, "Schaufel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 50);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO,
  "Die Schaufel ist irgendwie magisch, denn nur mit ihr kann man "
  "am Friedhof graben...\n");
  SetProp(P_WEIGHT, 500);
  SetProp(P_MATERIAL, ({MAT_MISC_MAGIC, MAT_STEEL}));
  }

