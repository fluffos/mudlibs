inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"
//absichtlich no und nerverdrop nicht!!!
//kann eh keiner was anfangen damit

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"NSEELE","seele","rest"}));
   SetProp(P_NAME, "Seelenrest");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Der Rest von Noerds Seele" );
   SetProp(P_LONG, BS(
   "Das ist der kuemmerliche Rest der von Noerds Seele uebrigblieb. Nicht "
   "viel..."));
    SetProp(P_MATERIAL, ([MAT_GHOST:1, MAT_MAGIC:99]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,1);
   SetProp(P_WEIGHT,1 );
}
