//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"gebeine","oberarmknochen", "knochen","oberarme","arme", "BONE3"}));
   SetProp(P_NAME, "Noerds Oberarmknochen");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 0 );
   SetProp(P_SHORT, "Noerds Oberarmknochen" );
   SetProp(P_LONG, BS(
  "Das sind Noerds Oberarmknochen. Kurz und plumb."));
    SetProp(P_MATERIAL, ([MAT_BONE:100, MAT_MAGIC:10]));
   SetProp(P_NOGET, 0);   
   SetProp(P_NODROP, 1);
   SetProp(P_VALUE,1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,100 );
}


