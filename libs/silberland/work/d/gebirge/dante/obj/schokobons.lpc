inherit "std/thing";

#include <properties.h>
#include <language.h>
int stat=0, inhalt=15+random(5);

#include "files.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Saeckchen mit leckeren Schokobons");
  SetProp(P_NAME, "Saeckchen mit leckeren Schokobons");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG, ("Dieses Saeckchen mit leckeren Schokobons stammt aus Dantes "
  "magischer Kondotorei, denn er liebt nicht nur Pilze. Lass sie Dir schmecken."));
  AddId("saeckchen");
  AddId(({"bons","schokobons","schoko"}));
  SetProp(P_WEIGHT, 50); 
  SetProp(P_VALUE, 300);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_MAGIC);
}
  


init()
{
  ::init();
  add_action("eat","nimm");
  add_action("rip","reiss");
  add_action("rip","reisse");
  add_action("rip", "oeffne");
}

rip(str)
{
  notify_fail("Was moechtest Du aufreissen oder oeffnen?\n");
  if (str=="saeckchen auf" || str=="saeckchen" || str=="schoko auf" || str=="schoko"
   || str=="bons auf" || str=="schokobons")
  {
    if (!stat)
    {
      write("Du reisst mit Genuss das Saeckchen mit den leckeren Schokobons auf.\n");
      say(capitalize(getuid(this_player()))+" reisst mit Genuss das Saeckchen mit den leckeren Schokobons auf.\n");
      stat++;
    }
    else write("Das Saeckchen mit den leckeren Schokobons ist doch schon offen!\n");
    return 1;
  }
  else return 0;
}

eat(str)
{
  notify_fail("Was moechtest Du aus dem Saeckchen nehmen?\n");
  if (str=="bons" || str=="schokobons" || str== "schoko" || str=="bon" || str== "schokobon aus saeckchen",
  str=="schokobon aus saeckchen" || str=="bons aus saeckchen" || str=="schokobons aus saeckchen" || str== "schoko aus saeckchen" || str=="bon aus saeckchen")
  {
    if (stat)
    
      if (inhalt)
      {
        write("Du nimmst ein leckeres Schokobons aus dem Saeckchen.\n");
        say(capitalize(getuid(this_player()))+" nimmt ein leckeres Schokobons aus dem Saeckchen.\n");
        CLONE("/d/gebirge/dante/obj/bons", TP);
        inhalt--;
      }
      else 
      {
        write("Das Saeckchen ist leider schon leer. Du schmeisst es weg.\n");
        say(capitalize(getuid(this_player()))+" schmeisst das leere Schokobons-Saeckchen weg und schaut Dich traurig an.\n");
        this_object()->remove();
      }

    else write("Das Saeckchen ist noch zu. Reiss es erst auf!\n");
  return 1;
  }
  else return 0;
}