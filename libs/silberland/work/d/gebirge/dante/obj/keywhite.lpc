
//dante sl 98
//testschleussel
inherit "std/thing";


#include <properties.h>
#include "files.h"
#include <ansi.h>

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, ""+ANSI_BOLD+ANSI_WHITE+"Ein Kopf eines weissen Schluesselwesens");
  SetProp (P_LONG, BS(
  ""+ANSI_BOLD+ANSI_WHITE+"Dieser Kopf gehoerte einst einem weissen Schluesselwesen."));
  SetProp (P_NAME, ""+ANSI_WHITE+ANSI_BOLD+"Schluesselwesenkopf");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 1);
  SetProp (P_WEIGHT, 20);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  SetProp(P_INFO, "Dieser Kopf eroeffnet neue Gedanken?!?!?!?!?\n");
  AddId (({"KWHITE","schluessel","schluesselkopf","schluesselwesenkopf", "kopf"}));
SetProp(P_MATERIAL, ([MAT_FLESH:90, MAT_MAGIC:10]));
}


