//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"HAMMER", "hammer","kreuzigungshammer","gate2"}));
   SetProp(P_NAME, "Kreuzigungshammer");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein schwerer Kreuzigungshammer" );
   SetProp(P_LONG, BS(
  "Das ist ein alter, schwerer Kreuzigungshammer. Ideal zum einschlagen "
  "von Naegeln in seine Opfer. Etwas Blut klebt auch noch dran."));
  AddDetail("blut",
  "Du singst 'Hammer, bloody hammer!'");
    SetProp(P_MATERIAL, ([MAT_IRON:100, MAT_BLOOD:10]));
   SetProp(P_NOGET, 0);   
   SetProp(P_NODROP, 1);
   SetProp(P_INFO, "Was wird man mit diesem Hammer wohl tun koennen?\n");
   SetProp(P_NEVERDROP, 1);
   SetProp(P_VALUE,10);
   SetProp(P_WEIGHT,100 );
}
