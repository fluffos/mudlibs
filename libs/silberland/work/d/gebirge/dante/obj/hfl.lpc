//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine leere Flasche");
  SetProp(P_LONG,BS(
"Diese Flasche ist leider leer. Wozu sie dient, weisst Du auch nicht. "
"Trotzdem, irgendeinen Sinn hat sie sicher..."));
  
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,30);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Flasche");
  SetProp(P_MATERIAL, ({MAT_GLASS}));
  AddId(({"hfl","flasche"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
}
