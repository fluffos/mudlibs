//spezialschaufel by dante fuer hoehlenquest

#include <properties.h>
#include <language.h>
inherit "/std/container";  
#include <moving.h>
#include "files.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Sarg");
  SetProp(P_LONG,BS(
  "Dieser kleine Sarg ist eher eine Kiste, in die man Gebeine legen kann.\n"));
   SetProp(P_MAX_WEIGHT, 5000);  
  AddId(({"kiste","sarg","gebeinsarg"}));
  SetProp(P_NAME, "Sarg");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_INFO,
  "Solltest Du alle Gebeine haben und am richtigen Ort sein, so "
  "schuette das magische Wasser auf den Sarg. Natuerlich muss auch "
  "Noerds Geist anwesend sein!\n");
    
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_MATERIAL, ({MAT_MISC_MAGIC, MAT_MISC_WOOD}));
  }
