//dante sl 98-99


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"
#include <mnpc.h>

int da=1;

create()
{
  ::create();

  v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
        "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
        "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
        "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
        "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
        "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
        "alle Kreaturen, die das Licht scheuen."));

  AD("staub",
      "Der Staub sammelt sich am Boden und man sieht Abdruecke darin. "
      "Doch hier liegt viel mehr Staub. Es koennte leicht ein Hebel im "
      "Staub versteckt sein.");
  AD("hebel",
      "Nein! Keiner! Aber vielleicht ein Knopf?!");
  AD("knopf",
      "Auch keiner. Hmm, untersuch doch lieber das Seil, das da von der "
      "Decke baumelt.");
  AD("seil",
      "Das Seil baumelt von der Decke herab. Es ist schwarz und kaum zu "
      "sehen. Seltamerweise ist es voller Wachs?!");
  AD("wachs",
      "Hmm, wozu das wohl dient?! Welchen Sinn das hat?!");

  AD("sinn",
      "Zieh daran! Am Seil, nicht am Sinn.");




  AddExit("norden", "./loch6");

  AIT(FN"vrat", REFRESH_DESTRUCT, ([
        P_MNPC_FLAGS: MOV_INDOORS]));
  AIT(FN"vrat", REFRESH_DESTRUCT, ([
        P_MNPC_FLAGS: MOV_INDOORS]));
  AIT(FN"vrat", REFRESH_DESTRUCT, ([
        P_MNPC_FLAGS: MOV_INDOORS]));

  AIT(FN"vrat", REFRESH_DESTRUCT);
  AIT(FN"vrat", REFRESH_DESTRUCT);
  AIT(FN"vrat", REFRESH_DESTRUCT);
  //3 bleiben 3 laufen weg

  ACD(({"zieh","ziehe"}), "pull");
}

int pull(string str)  {
  NF("Woran willst Du ziehen?!\n");
  if(str=="seil"||str=="am seil"||str=="an seil")  {

    if(present("ratte", TO))  {
      write(BS(
            "Die Vampirratte haelt Dich fest."));
      return 1; }   

      if(!da)  {
        write(BS(
              "Du ziehst am Seil, doch nichts passiert."));
        say(BS(
              CAP_TPN+" zieht an einem Seil."));

        return 1; }

        if(da)  {
          write(BS(
                "Du ziehst am Seil und hoerst aus dem Norden ein leises Geraeusch!"));
          say(BS(
                CAP_TPN+" zieht an einem Seil."));
          da--;
          call_other("/d/gebirge/dante/gruft/room/loch13", "kerze_burn",TP);
          return 1; }

          return 0; }

          return 0; }


          reset()  {
            ::reset();
            da=1; }


