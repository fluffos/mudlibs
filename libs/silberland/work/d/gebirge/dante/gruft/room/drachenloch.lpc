//dante sl 99 98 

#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int da=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter dem Friedhof" );
  SetProp( P_INT_LONG, BS(
"Du steckst nun in einer sehr engen, schmalen Hoehle unter dem Grab. "
"Die Waende erdruecken Dich fast. Im Osten klafft ein Loch darin, "
"das wohl weiterfuehrt. Alles hier ist "
     "voller Schleim, Blut und den Ueberresten von Opfern. Es riecht nach "
     "Verwesung und Tod."));

AD(({"loch","loecher", "osten"}),
"Das Loch fuehrt Dich weiter in die Hoehle. Ein Loch klafft in der Decke.");
     
    AD("hoehle",
    "Die Hoehle ist hier sehr beengend.");
     
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  AddDetail(({"reste","ueberreste"}),
   "Hier liegen die Ueberreste unvorsichtiger Spieler, die es gewagt haben, "
   "den Vampirdrachen zu stoeren.");
   AddDetail("spieler",
   "Keiner entkommt dem Vampirdrachen!");
   AddDetail(({"drache","vampirdrache"}),
   "Der Vampirdrache lebt hier irgendwo...");  
  AddDetail(("blut"),
  "Sogar die Decke ist bluttriefend.");
  AddDetail(("decke"),
  "Von der Decke tropft Blut! Ein Loch fuehrt nach oben.");
 AD("schleim",
 "Der Schleim ist am Boden, an den Waenden, an der Decke...");
 AD("verwesung",
 "Es stinkt hier bestialisch.");
 AddSmell("verwesung",
 "WAEHHH!!!");
 
  AddDetail(({"opfer","opfern"}),
  "Zerfetzt und zerrissen stapeln sich hier ihre Leichen.");
  AddDetail(({"leiche","leichen"}),
  "Die Leichen liegen hier alle wild verstreut umher.");
  
  AddDetail("tod",
  "Du wirst ihm bald begegnen...");
  AddDetail( ("boden"),
  "Am Boden liegen Leichen, aber das bist Du ja bereits gewohnt. "
  "Viel interessanter ist ein eingemeiseltes Kreuz!");
  AddDetail("kreuz",
  "Das Kreuz ist schwarz und und weist eine kleine Erhebung auf.");
  AddDetail("erhebung",
  "Es ist ein blutroter Rubin.");
  AddDetail("rubin",
  "Der Rubin funkelt und leuchtet hell. Sein Licht blendet Dich fast!");
  AddDetail("licht",
  "Das Licht ist ebenfalls blutrot. Du haettest den Rubin sehr gerne, "
  "aber so einfach nehmen geht ja wohl kaum. Gewalt muss her!");
  AddDetail("gewalt",
  "LOS!!! Hol Dir den Rubin!");

  AddDetail(({"wand","waende"}),
  "Die Waende sind blutbespritzt. Interessant ist die Nordwand!");
  AD("nordwand",
  "Du siehst eine Klappe.");
  AD("klappe",
  "Hmm, kann man sie oeffnen?!");
  
  AddDetail(({"stein","naturstein"}),
   "Hier hat man frueher Stein sehen koennen, aber nun ist alles "
   +"blutverschmiert.");
  AddDetail(("leben"),
  "Dein Gewissen raet Dir schnell von hier zu verschwinden...");
  AddDetail(("grab"),
  "In Gedanken siehst Du Dein Grab schon vor Dir... ");
  AddDetail(("ort"),
  "Dieser Ort ist Dir nicht ganz geheuer.");
 
  AddSound( DEFAULT_SOUND,
    "Hier glaubt man den Tod zu hoeren.");
AddItem(FN"vamp6", REFRESH_DESTRUCT);    
 
    AD(({"gedanken","gedanke"}),
    ". o O 'Angst, Panik'!");
    
    
 AddCmd(({"brich","breche","reiss","reisse","schlage","trete"}), "ghul");

AddGuardedExit("osten", FR"ghul", "vampir",
"Der Vampir haelt Dich auf.\n");
AE("oben", "/d/gebirge/dante/friedhof/room/loch");

ACD(({"oeffne"}), "open");
  AddSmell( DEFAULT_SMELL,
    "Hier stinkt es grauslich.");
 }
 
 
 int open(string str)  {
 NF("Was willst Du oeffnen?!\n");

 if(str=="klappe")  {
 write(BS(
 "Du oeffnest die Klappe einen Spalt, doch ploetzlich "
"reisst ein Vampirghul die Klappe von der anderen Seite zu! "
 "Vielleicht kann man die Klappe ja wo anders gebrauchen..."));

 say(BS(
 CAP_TPN+" oeffnet eine Klappe, doch ploetzlich reisst ein "
 "Vampirghul die Klappe von der anderen Seite wieder zu."));
 return 1; }
 return 0; }
 
 
 int ghul(string str)
   {object ob;
   notify_fail("Was willst Du mit dem Rubin machen?!\n");
   
   if(member(({"rubin aus", "rubin aus kreuz","rubin raus","rubin heraus"}),str)!=-1)
      {
   if(present("vampir", environment(TP)))
     {
     say(CAP_TPN+" versucht es mit Gewalt!\n");
     write("Du versuchst es mit Gewalt, doch der Vampir haelt Dich zurueck!\n");
     return 1;
     }

if(!da)  {
	
     
     write("Du versuchst den Rubin mit Gewalt zu bekommen, doch schaffst Du es nicht.\n");
     return 1;
           }
if(da)  {
write(BS(
"Du reisst mit aller Gewalt den Rubin aus dem Kreuz!"));
	    
ob=CLONEOB(FO"vrubin");
ob->move(TP, M_GET);
da--; return 1; }
return 0; }
return 0; }
