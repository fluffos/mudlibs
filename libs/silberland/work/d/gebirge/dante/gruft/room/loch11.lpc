inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"

int heile=5;

reset(){
::reset(); 
heile=5;
}


create()
{
  ::create();


v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen. Im Osten sieht man ein grosses Tor und "
 "im Westen ein noch viel groesseres Portal! In einer der Ecken liegt eine Leiche."));
 

 AD(({"ecke","ecken"}),
 "Die Leiche liegt dort herum und verfault.");
 AD("leiche",
 "Sie ist eigenartig verkruemmt. Ihre Hand scheint irgendwie seltsam zu sein.");
      
     
  AddDetail( ({ "mama" }), 
    "Nana!!!" );
  AddDetail( ({ "angst", "todesangst" }), 
    "Du zitterst und willst zu Mama!" );
     AddDetail("osten",
     "Im Osten kann man durch ein grosses Tor treten!");
     AddDetail("gutes",
     "Nein, hier sicher nicht!");
     AddDetail("zeichen",
     "Von den Zeichen geht eine boese Aura aus.");
     AddDetail("aura",
     "Die Aura wirkt sehr bedrohlich und warnt Dich!");
     


  AddDetail(("hand"),
  "Die Hand sieht lecker aus. Koste sie doch....");

  AddDetail("staub",
  "Im Staub hat jemand Etwas geschrieben. Lies es!");
  AD("etwas",
  "LESEN!!!");
  AddReadDetail("etwas",
  "Vor langer Zeit legte ich fuer Dich diesen Fluchtweg an. Das Zauberwort ist\n"
  "<vampirflucht>. Ich hoffe es kann Dir etwas im Kampf gegen das Boese helfen!\n"
  "Achja, hmm, Du musst es murmeln...\n"
  "\nDein Merlin.\n");
  AD("merlin",
  "Der gute, alte Merlin!");
  
 

AddItem(FN"vamp7", REFRESH_DESTRUCT);

AddCmd(({"koste","kost"}), "heilen");
AddCmd(({"murmle", "murmel"}), "weg");
AddDetail("westen",
"Im Westen sieht man ein gigantisches blutrotes Portal!\n");

 NewDoor("osten", (FR"loch9"),
  ({"tor"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das blutrote Tor sieht sehr unheimlich und bedrohend aus. "
              "Seltsame Zeichen umrahmen es. Dich erwartet hier sicher nichts Gutes.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Tor.",
                 D_NAME, "Tor",
                  } ));    
 

 NewDoor("westen", (FR"loch12"),
  ({"portal"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das blutrote Portal ist gigantisch gross und macht Dir Todesangst. "
              "Seltsame Zeichen umrahmen es. Dich erwartet hier sicher nichts Gutes.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Portal.",
                 D_NAME, "Portal",
                  } ));    
 
    
    
    
 }


  int heilen(string str)
   {
   notify_fail("Was willst Du hier kosten?!\n");
   if(str=="hand")
     {
     if(heile)
         {
         say(CAP_TPN+" frisst Leichenteile!\n");
         write("Du kostest die Hand, hmm lecker!!!\n");
         TP->heal_self(50);
         heile--;
         return 1;
         }
      if(!heile)
        {
        say(CAP_TPN+" frisst Leichenteile!\n");
        write("Du kostest die Hand, wah eklig!\n");
        return 1;
        }
    return 0;
    }
  return 0;
  }
     
     
     int weg(string str)
       {
       notify_fail("Was willst Du hier murmeln!\n");
       if(str=="vampirflucht")
         {
      /*
         if(present("vampir", environment(TP)))
            {
            say(CAP_TPN+" murmelt etwas...\n");
            write("Du murmelst `vampirflucht`, doch der Vampir haelt Dich fest!\n");
            }
            else
      
      
            {
     */ 
      
            write("Du murmelst `vampirflucht`...\n");
            say(CAP_TPN+" murmelt etwas...\n");
            TP->move("/d/gebirge/dante/friedhof/room/pfad1", M_GO+M_SILENT);
