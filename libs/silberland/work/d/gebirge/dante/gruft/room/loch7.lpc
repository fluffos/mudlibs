//dante sl 99 98

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"

int mon=1;

create()
{
  ::create();
v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen."));


AD(({"wand","waende"}),
"Die Waende sind aus Stein, der auch von Moder ueberzogen ist. "
"Ab und zu scheint ein Knochen aus der Wand zu ragen. Doch da ist noch "
"was anderes. Ein Kreuz, gebildet aus Knochen, wurde hier an der "
"Wand befestigt. Du solltest Dich davor hueten, denn es strahlt "
"eine unglaublich boese Aura aus!!!");
AD("aura",
"Untersuche es besser nicht genauer!!!");

  
  AddSpecialDetail("kreuz", "come");
     AddExit("osten", "./loch10");
   AddExit("westen", "./loch9");
   AddExit("sueden","./loch6"); 
  AE("norden", "./loch13");
  
AIT(FN"vamp5", REFRESH_DESTRUCT);
 AIT(FN"vrat", REFRESH_DESTRUCT);
    
 }


reset(){
::reset();
mon=1;
}

  string come()
     {
     object ob;
     
     
     if(present("vampir", environment(TP)))
       {
       
       write(BS(
       "Der Vampir tritt Dich nieder!"));
       }
       
       if(!mon)  {
       write("Du betrachtest das Kreuz genauer.\n"
       "Darunter steht Dein Name, "+CAP_TPN+"!\n");
       }
       
       if(!present("vampir", environment(TP))&&(mon))
       {
       write("Du betrachtest das Kreuz und...\n"
       "Ein Vampir steht ploetzlich vor Dir und grinst!\n"
       "Der Vampir sagt: Hallo! "+CAP(getuid(TP))+"!\n"
       "Der Vampir sagt: Mich wirst Du nie wieder los!\n");
       
       ob=clone_object(FN"vamp4");
       ob->move(environment(TP), M_TPORT+ M_SILENT);
       ob->SetProp(P_SHORT, CAP(getuid(TP))+"s` Todesvampir");
       ob->SP(P_LONG, BS(
       "Diesen Vampir hat "+CAP(getuid(TP))+" gerufen. Er wird "
       ""+TP->QueryPronoun(WEN)+" verfolgen bis entweder der Vampir oder "
       ""+CAP(getuid(TP))+" von dieser Welt verschwunden sind! Finster und "
       "blutruenstig grinst er Dich an. Du schauderst als Du seine scharfen, "
       "blutigen Zaehne erkennst."));
       ob->SP(P_NAME, ""+CAP(getuid(TP))+"'s Todesvampir");
       TP->AddPursuer(ob);
       //ob->Kill(TP);
       mon--;
        }
     
     return "";
     }
        