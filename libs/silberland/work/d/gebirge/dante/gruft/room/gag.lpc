//dante sl 99

#include "../gruft.h"

inherit "std/room";
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#define NIX  if(environment(TP)!=TO) return 0;    


create()
{
  ::create();
     AddCmd ("", "no", 1);   

SP(P_INT_SHORT, "Im freien Fall");

SP(P_INT_LONG, BS(
"Im freien Fall durch ein Loch nach unten."));

  SetProp( P_LIGHT, 0 );
    SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]));


AddRoomMessage(({
"Du faellst und faellst immer tiefer.\n",
"Du faellst immer weiter in das Loch!\n",
"Das Fallen wird langsam fad!\n",
"Du fluchst laut ueber dieses verdammte Loch!\n",
"Das Loch scheint keinen Boden zu haben! Fluchen waere hier angebracht.\n",
"Du segelst immer tiefer nach unten. Verflucht!!!\n",
"Du solltest wirklich laut fluchen! Das Loch hat keinen Boden!\n",
"Du faellst und faellst und faellst...\n",
"Du willst fluchen! Du faellst und faellst...\n",
"Du faellst und faellst ohne Ende! Langweilig!\n",
"Du faellst und faellst...\n"}),10);

}
                                               
BecomesNetDead(object pl)  {
	pl->move("d/gebirge/dante/gruft/room/loch10", M_GO+M_SILENT+
	M_NO_SHOW);  }
                                                                                               
 int no(string str)
 {
 
 if(IS_WIZARD(TP))   {
 return 0; }
 
 else 
 
 if(query_verb()=="fluche"||query_verb()=="fluch")  {
 write(BS(
 "Du fluchst extrem laut und ploetzlich saugt Dich irgendeine "
 "Kraft wieder nach oben! Du landest sanft am Absprungsort."));
 TPM("/d/gebirge/dante/gruft/room/loch10", M_GO,
 "von einer unsichtbaren Kraft nach oben geschleudert", "wird",
 "wird aus dem Loch geschleudert");
 return 1; }
 else		
   write (
"Konzentrier Dich lieber auf das Fallen!!!\n");
   return 1;
   }
     
