//ghulraum
//dante sl 99
#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei den Vampirghulen" );
  SetProp( P_INT_LONG, BS(
   "Du hast nun endlich zu den sagenumwobenen Vampirghulen gefunden. "
   "Aber freundlich sieht es hier natuerlich auch nicht aus. Die Hoehle "
   "ist hier schmal und sehr niedrig. Der Boden ist schlammbedeckt und "
   "von der Decke tropft schmutziges, stinkendes Wasser. "));
   
   AD("raum",
   "Bei den Vampirghulen");
  AD("moment",
  "Warte einfach hier...");
    AD(({"ghul","vampirghul"}),
    "Hier leben also die Vampirghule. Im Moment scheint keiner hier zu sein.");
   AD("hoehle",
   "Die Hoehle ist hier viel enger und irgendwie fuehlst Du Dich sehr eingeengt.");
   AD(({"wand","waende"}),
   "An den Waenden rinnt schmutziges, stinkendes Wasser herunter und sammelt "
   "sich am Boden als brauner Schlamm an.");
   AD("wasser",
   "Das Wasser rinnt die Waende entlang zu Boden. Du findest eine "
   "verborgene Klappe, die man durch das Wasser erkennen kann.");
   AD("klappe",
   "Diese Klappe fuehrt hinaus aus der Hoehle der Vampirghule.");
  AD("boden",
  "Der Boden ist mit einer dicken Schicht aus Schlamm bedeckt. Er blubbert und "
  "dampft unheimlich. Hier scheint der Schlamm aber anders zu sein.");
  
  AD("schicht",
  "Hmm, ob man darin versinken kann...");
  AD("schlamm",
  "Der Schlamm ist giftig. Ab und zu macht er BLUBB. Ob es gut ist, "
  "hier zu lange zu verweilen...");
   AD("decke",
   "Von der Decke tropft eine eklige Bruehe.");
   ASD("bruehe","gift");
   
AIT(FN"vamp10", REFRESH_DESTRUCT);        
        
        
        
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  
    
   AddExit("osten","./ghul2"); 

   AddSound(DEFAULT_SOUND,
   "Es blubbert irgendwo...");    
  AddSmell( DEFAULT_SMELL,
    "Hier stinkt es eklig...");
 
 ACD(({"oeffne"}), "out");
 
 
 
 }

int out(string str)
   {
   NF("Was willst Du oeffnen?\n");
   if(str=="klappe")
     {
     write("Du oeffnest die Klappe und steigst durch.\n");
     TP->move(FR"drachenloch", M_GO,
     "durch eine Klappe aus der Hoehle", "klettert", "kommt von irgendwo herein");
     return 1;
     }
  return 0;
  }
          


   string gift() {
write(
  "Die Bruehe trifft Dich voll im Gesicht!\n");
  TP->AddPoison(2);
  return "";
  }
