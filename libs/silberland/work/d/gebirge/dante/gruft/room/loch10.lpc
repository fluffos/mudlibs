//dante sl 98-99


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"


create()
{
  ::create();

v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen. Im Boden siehst Du ausserdem "
 "ein gewaltiges Loch!!!"));


AD("loch",
"Das Loch ist recht gross und sehr dunkel. Du kannst den Grund "
"nicht erkennen.");
AD("grund",
"Man sieht ihn nicht, er muss wohl sehr weit unten sein! "
"Du kannst aber durch das Loch nach unten klettern, aber ob das klug ist.");


AE("westen", "./loch7");    
 AddExit("sueden", "./loch8");
AIT(FN"vamp3", REFRESH_DESTRUCT);
AIT(FN"idv", REFRESH_DESTRUCT);
ACD(({"kletter","klettern"}), "down");
 }

int down(string str)  {
NF("Wo willst Du runter klettern?\n");
if(str=="runter"||str=="loch"||str=="druch loch runter"||
str=="nach unten" )  {
write(BS(
"Du kletterst nach unten."));
TPM(FR"gag", M_GO, "nach unten", "klettert", "kommt heruntergeflogen");
return 1; }
return 0; }
