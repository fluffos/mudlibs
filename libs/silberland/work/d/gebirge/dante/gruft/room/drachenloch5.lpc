//dante sl 99

#include "files.h"

inherit "std/room";
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <moving.h>

object ob;
int heile=1+random(3);
int anzahl, i;

init()  {
  ::init();


  if(interactive(TP))  {
    if(  (find_living("skyta")) && (!IS_WIZARD(TP))  )  {

      write(BS(
            "Skyta bruellt und tobt unter Dir, sodass Du nach unten faellst!")); 
      TP->move("/d/gebirge/dante/gruft/room/drachenloch3", M_GO,
          "nach unten geschleudert", "wird", "wird von oben hereingeschleudert");
    } 
  }


  if(interactive(TP)  && (heile))
  {
    TP->heal_self(300);
    write("Als Du diesen Teil der Hoehle betrittst, umhuellt Dich auf einmal der\n"
        "Wind und heilt Dich total!\n");
    heile--;
  }
}




reset()
{
  object muenze;
  ::reset();
  heile=1+random(3);
  if( (ob = present("geld")) && ob->QueryProp(P_AMOUNT) < 111111)
  {
    i=random(100000);
    if(i<ob->QueryProp(P_AMOUNT) )
      ob->SetProp(P_AMOUNT, ob->QueryProp(P_AMOUNT)+i/10);
    else
      ob->SetProp(P_AMOUNT, i);    
  }      
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei Skyta" );
  SetProp( P_INT_LONG, BS(
        "Dieser Teil der Hoehle ist um vieles groesser und hoeher. Auch "
        "liegen keine Leichen am Boden herum. Nackter, kalter Stein ist alles "
        "was man hier sehen kann. Ab und zu blaest der Wind durch ein Loch "
        "im Boden herein, was Dich auch etwas verwundert..."));


  AddDetail( ({ "tod" }), 
      "Scheinbar hast Du den Tod besiegt." );
  AddDetail("teil",
      "Dieser Teil der Hoehle wird von normalen Vampiren nicht bewohnt.");
  AddDetail("vampire",
      "Keiner hier.");
  AddDetail("hoehle",
      "Die Hoehle ist hier viel geraeumiger und sauberer als draussen bei den "
      "Vampiren.");

  AddDetail("wind",
      "Seltsamerweise blaest der Wind aus einem Loch im Boden nach oben "
      "und scheint in einem weiteren Loch in der Decke zu verschwinden.");
  AddDetail(({"loch","loecher"}),
      "Hier gibt es 2 sehr grosse Loecher. Eines in der Decke, eines im "
      "Boden.");


  AddDetail(({"skyta"}),
      "Hmm, Skyta ist nicht da..."); 

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 0,ENV_TERRAIN:TT_CAVE]) );
  AddDetail("raum",
      "Du zitterst wie Espenlaub...");
  AddDetail(({"drache","vampirdrache"}),
      "Der Vampirdrache lebt hier irgendwo...");  
  AddDetail("decke",
      "Die Decke ist hier sehr hoch ueber Dir. Du entdeckst ein grosses Loch, "
      "das scheinbar nach oben fuehrt.");
  AddDetail(({"espenlaub","laub"}),
      "Auch dafuer gibts sicher keine Fps...");
  AddDetail(({"fp","fps"}),
      "Dafuer auch nicht.");




  AddDetail(({"leiche","leichen"}),
      "Keine.");
  AddDetail( "boden",
      "Der Boden ist glatt und sehr sauber. Das liegt daran, das Skyta seine "
      "Opfer total verspeist.");
  AddDetail("opfer",
      "Du wirst auch eines!");

  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus nacktem, schwarzen Stein. Ab und zu "
      "entdeckt man einige tiefe Kratzer.");
  AddDetail("kratzer",
      "Sie stammen von einer unglaublich gefaehrlichen Waffe.");
  AddDetail("waffe",
      "Diese Waffe lernst Du bald kennen.");


  AddDetail(({"stein","stein"}),
      "Der Stein ist aeusserst kalt. Ueberhaupt herrscht hier eine sehr eisige "
      "Stimmung.");
  AddDetail("stimmung",
      "Die Stimmung ist hier auf dem absoluten Nullpunkt. Es hat hier Null Grad!");
  AddDetail(({"grad","null","nullpunkt"}),
      "Wenn Du ganz genau schaust, siehst Du Deinen eigenen Atem!");
  AddDetail("atem",
      "Du keuchst ziemlich...");

  switch(random(3))  {
    case 0:
      "obj/gemmaster"->DistributeGem(2, 3,1, 1);
      break;

    case 1:
      "obj/pearlmaster"->DistributePearl(2, 3,1, 1);
      break;

    case 2:
      break;
    default:
  }

  AddItem( "/obj/money", REFRESH_REMOVE, ([P_AMOUNT:20000+random(20000)]));  


  AddSound( DEFAULT_SOUND,
      "Hier glaubt man den Tod zu hoeren.");
  AddSpecialExit("oben", "up");
  AddExit("unten","./drachenloch3");

  AddSmell( DEFAULT_SMELL,
      "Hmm, Du riechst nichts. Es ist zu kalt..");
}



int up()
{

  write("Der Wind heult: Nein, hier kann nur mehr ich weiter...\n");
  return 1;
}

