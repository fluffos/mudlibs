//ghulraum
//dante sl 99

#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int mon=3;


reset(){
  ::reset();
  mon=3;
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei den Vampirghulen" );
  SetProp( P_INT_LONG, BS(
        "Du hast nun endlich zu den sagenumwobenen Vampirghulen gefunden. "
        "Aber freundlich sieht es hier natuerlich auch nicht aus. Die Hoehle "
        "ist hier schmal und sehr niedrig. Der Boden ist schlammbedeckt und "
        "von der Decke tropft schmutziges, stinkendes Wasser. In der Mitte "
        "des Raumes steht eine gigantische Statue."));

  SP(P_KILL_NAME, "Eine Vampirdrachenstatue");

  AD("statue",
      "Die Statue stellt Vampirghule dar, die einen gigantischen "
      "Drachen anbeten!");
  AD("drache",
      "Es handelt sich um einen Vampirdrachen!!! Die Augen des "
      "Drachen leuchten wild. Du entdeckst ein kleines Schild.");
  ARD("schild",
      "Ich erwarte Dich!");
  AD("schild",
      "Lesen.");

  ASD(({"auge","augen"}), "come_mon");

  AD(({"vampirdrache","vampirdrachen"}),
      "Von den Vampirdrachen hast Du schon gehoert, aber noch nie einen gesehen!");


  AD("raum",
      "Bei den Vampirghulen");
  AD("moment",
      "Warte einfach hier...");
  AD(({"ghul","vampirghul"}),
      "Hier leben also die Vampirghule. Im Moment scheint keiner hier zu sein.");
  AD("hoehle",
      "Die Hoehle ist hier viel enger und irgendwie fuehlst Du Dich sehr eingeengt.");
  AD(({"wand","waende"}),
      "An den Waenden rinnt schmutziges, stinkendes Wasser herunter und sammelt "
      "sich am Boden als brauner Schlamm an. Im Suedwesten siehst Du in der Wand "
      "ein Loch.");
  AD("loch",
      "Durch das Loch kannst Du sicher nach Suedwesten klettern!");
  AD("suedwesten",
      "Das Loch fuehrt wieder zurueck nach Suedwesten.");

  AD("wasser",
      "Das Wasser ist giftig, also trink ruhig davon!");
  AD("boden",
      "Der Boden ist mit einer dicken Schicht aus Schlamm bedeckt. Er blubbert und "
      "dampft unheimlich.");
  AD("schicht",
      "Hmm, ob man darin versinken kann...");
  AD("schlamm",
      "Der Schlamm ist giftig. Ab und zu macht er BLUBB. Ob es gut ist, "
      "hier zu lange zu verweilen...");
  AD("decke",
      "Von der Decke tropft eine eklige Bruehe.");
  ASD("bruehe","gift");



  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AIT(FN"vrat", REFRESH_DESTRUCT);
  AIT(FN"vamp8", REFRESH_DESTRUCT);  

  AddExit("norden","./ghul4");
  AddExit("westen", "./ghul5");

  AddDetail( ({ "mitte" }), 
      "Naja, eben mittendrin." );
  AddSound(DEFAULT_SOUND,
      "Es blubbert irgendwo...");    
  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es eklig...");
  ACD(({"kletter","klettere"}),"out");


}

int out(string str)
{
  NF("Wo willst Du raus klettern?!\n");

  if(!str) return 0;

  if(member(({"durch loch","durch loch raus","durch loch hinaus"}),str)!=1)
  {
    write("Du kletterst durch das Loch wieder raus.\n");
    TP->move(FR"ghul", M_GO,
        "durch ein Loch raus","klettert", "kommt hereingeklettert");
    return 1;
  }
  return 0;
}


string come_mon()
{
  object ob;
  if(!mon)
  {
    write("Ploetzlich schiesst ein Blitz aus den Augen und trifft Dich!\n");
    TP->do_damage(random(50));
  }
  if(mon)
  {
    write(BS("Du betrachtest die Augen des Vampirdrachen und ploetzlich "
          "springt etwas auf Dich zu...\n"));
    ob=clone_object(FN"vamp2");
    ob->move(environment(TP), M_TPORT+M_SILENT);
    ob->Kill(TP);
    mon--;
  }
  return "";
}


string gift() {
  write(
      "Die Bruehe trifft Dich voll im Gesicht!\n");
  TP->AddPoison(2);
  return "";
}
