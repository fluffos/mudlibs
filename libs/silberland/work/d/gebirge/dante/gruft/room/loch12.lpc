inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"

create()
{
  ::create();


v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen. Im Osten liegt das Portal und im "
 "Norden fuehrt ein Tor weiter."));
 

      
  AddDetail( ({ "gutes" }), 
    "Sicher nicht." );
     AddDetail("norden",
     "Im Norden ist die Gruft der Vampire!");
     AddDetail("gruft",
     "Die unheimliche Gruft der Vampire liegt im Norden!");
     AD("osten",
     "Da ist das Portal.");
     
AddDetail("marmor",
"Er schimmert schwarz und unheimlich!");
     
     AddDetail("zeichen",
     "Von den Zeichen geht eine boese Aura aus.");
     AddDetail("aura",
     "Die Aura wirkt sehr bedrohlich und warnt Dich!");
     

 AddItem(FN"vamp7", REFRESH_DESTRUCT);
 AddItem(FN"vamp7", REFRESH_DESTRUCT);




 NewDoor("norden", (FR"gruft1"),
    ({"tor"}),
    
          ({
                    D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
                     D_LONG,
                     "Das Tor ist aus schwarzem Marmor gefertigt. Man sieht kein Schloss, also braucht man auch keinen Schluessel dafuer!",
                            D_GENDER, NEUTER,
                                 D_SHORT, "Ein %ses Tor.",
                                          D_NAME, "Tor",
                                                                    } ));
                                                                    
                                                                    

 NewDoor("osten", (FR"loch11"),
  ({"portal"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das blutrote Portal sieht sehr unheimlich und bedrohend aus. "
              "Seltsame Zeichen umrahmen es. Dich erwartet hier sicher nichts Gutes.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Portal.",
                 D_NAME, "Tor",
                  } ));    
 
 }
