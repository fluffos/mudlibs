
//dante sl 99
#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

int burn=0;
int open=0;
int vamp=0;
create()
{
  ::create();


  SP(P_INT_SHORT, "In der Gruft der Vampire");
  SP(P_INT_LONG, BS(
        "Duester und unheimlich liegt die Gruft der Vampire vor Dir. Kalter schwarzer Marmor "
        "verbreitet eine kalte, lebensfeindliche Atmosphaere. Doch hier muss etwas besonders "
        "Bedrohliches sein. Am Boden stehen hunderte, wenn nicht tausende schwarze Kerzen, "
        "die Dir nichts Gutes verheissen. In ihrer Mitte prunkt ein grosser Sarkophag, der Dich "
        "sogleich in seinen todbringenden Bann zieht. Im Sueden kannst Du diesen Raum "
        "verlassen, oder auch nicht..."));

  AD("gutes",
      "Die Kerzen muessen irgendeinen Sinn haben.");
  AD("sinn",
      "Welchen...");


  AD("bedrohliches",
      "Es zieht Dich magisch in seinen Bann.");

  AD("gruft",
      "Du stehst mitten drin.");
  AD(({"kraft","kraefte"}),
      "Umheimliche, magische Kraefte.");
  AD("marmor",
      "Der Marmor ist kalt und ist eigentlich Vampirstein.");

  AD("bann", 
      "Angeblich soll Nosferatu, der Fuerst der Vampire, alle in seinen Bann ziehen.");
  AD("fuerst",
      "Nosferatu ist der Fuerst aller Vampire.");
  AD(({"vampir","vampire"}),
      "Hier herrschen die Vampire, und Nosferatu ist ihr Fuerst!");
  AD("mitte",
      "In der Mitte des Raumes steht ein schwarzer Sarkophag. Blutrote Schriftzeichen "
      "verzieren seinen schweren Deckel.");
  AD("deckel",
      "Der Deckel besteht ebenfalls aus Marmor. Irgendjemand hat unheimliche "
      "Schriftzeichen in ihn eingemeiselt.");
  AD(({"zeichen","schriftzeichen"}),
      "Die Zeichen gehoeren zu einer alten Schrift.");
  AD("schrift",
      "Die Schrift ist uralt und laengst vergessen: Trotzdem hier die gebrochene Uebersetzung "
      "dieser alten Schrift von Dante. (Fuer die Richtigkeit gibt's keine Garantie) : \n"
      "Hier tut ruhen Nosferatu, das Fuerst von die Vampire sehr alt und boese ist.");
  AD("garantie",
      "Eben nicht.");
  AD("richtigkeit",
      "Dem Sinn nach stimmt es...");

  AD("nosferatu",
      "Der ist nicht hier.");
  AD("dante",
      "Du denkst . o O`Uebersetzen kann der nicht...'");

  AD(({"uebersetzung","uebersetzen"}),
      "Naja, etwas holprig.");

  AD("sueden",
      "Fluchtrichtung: sueden");
  AD("boden",
      "Der Boden besteht aus dunkelrotem Stein. Uerberall stehen schwarze Kerzen.");
  AD("stein",
      "Es gibt hier zwei davon: Vampirstein und Blutstein.");
  ASD("sarkophag","sarko");

  AD("blutstein",
      "Der Blutstein leuchtet hier besonders hell, was Dir nicht behagt... ");
  AD("decke",
      "Die Decke ist gewoelbt. Aber hier haengen keine Spinnweben mehr. Hier scheint ueberhaupt nichts mehr zu leben....");
  AD(({"spinnweben","weben","spinnen"}), "Nicht einmal die Spinnen wagen sich hier her.");
  AD("atmosphaere",
      "Kalt und lebensfeindlich, bedrohlich und unheimlich wirkt diese Gruft auf Dich. ");
  AD(({"wand","waende"}),
      "Die Waende bestehen aus purem Marmor. Es handelt sich um Vampirstein.");
  AD("atmosphaere",
      "Kalt und lebensfeindlich, bedrohlich und unheimlich wirkt diese Gruft auf Dich. ");
  AD(({"wand","waende"}),
      "Die Waende bestehen aus purem Marmor. Es handelt sich um Vampirstein.");
  ASD(({"kerze","kerzen"}), "brennen");
  AD("vampirstein",
      "Den Vampirstein gibt es nur hier. Er soll sehr, sehr wertvoll sein und auch magische "
      "Kraefte haben. Du haettest gerne etwas von dem kostbaren Vampirstein. ");
  ACD(({"zuende","zuend"}), "do_burn");
  ACD(({"oeffne"}), "do_open");

  AE("sueden", "./gruft1");


  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]));
  AD("raum",
      "Eine Gruft.");


  AIT("/d/gebirge/dante/gruft/npc/vamp2", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));
  AIT("/d/gebirge/dante/gruft/npc/vamp6", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));



}

int do_open(string str)
{object ob;

  NF("Was willst Du hier oeffen?\n");
  if(str=="sarkophag")
  {

    if(present("vampir", environment(TP)))  {
      write(BS(
            "Der Vampir schlaegt Dich nieder!"));
      TP->do_damage(5);  
      return 1; }



      if(!burn) {
        write("Du versuchst den Sarkophag zu oeffnen, doch schaffst es nicht.\n");
        return 1;
      }  
      else
        if(present("NOSFERATU", environment(TP)))
        {
          write("Du willst Nosferatus Sarkophag oeffnen, doch das geht nun nicht.\n");
          return 1;
        }
      if(open)  {
        write("Der Sarkophag ist doch schon offen.\n");
        return 1;
      }
      if(!open)
      {
        if(!vamp)

        {  write("Du oeffnest den Sarkophag und...\n");
          vamp=1;
          ob=clone_object(FN"nos");
          ob->move(TO, M_TPORT);

          open=1;
          return 1;
        }
        if(vamp)
        {
          write("Du oeffnest den Sarkophag, doch der Sarkophag ist leer.\n"
              "Dann schliesst Du ihn wieder.\n");
          open=0;
          //nur zur sicherheit
          return 1;
        }
        return 0;
      }
      return 0;
  }
  return 0;}


int do_burn(string str)
{
  NF("Was willst Du anzuenden?\n");
  if(str=="kerze an")  {
    write("Hier gibt es viele Kerzen, so wirst Du nie fertig.\n");
    return 1; }
    if(str=="kerzen an") {
      if(burn)  { write("Die Kerzen brennen bereits.\n"); return 1; }
      if(!burn) {
        write("Du zuendest die schwarzen Kerzen an. Ploetzlich hoerst Du ein "
            "Rumpeln im Sarkophag. Angst...\n");
        burn=1; 
        return 1; 
      }
      return 0;
    }
    return 0;
}




reset(){
  ::reset();
  vamp=0;
  open=0;
  burn=0;
}

string sarko()
{
  if(open)
    return ("Der unheimliche Sarkophag ist geoffnet.\n");
  else
    return ("Der unheimliche Sarkophag ist noch fest verschlossen.\n");
}


string brennen()
{
  if(burn)
    return BS("Die schwarzen Kerzen brennen hell und tauchen die Gruft in ein "
        "unheimliches Licht. Irgendjemand muss sie angezuendet haben.\n");
  if(!burn)
    return ("Die unheimlichen, schwarzen Kerzen brennen nicht.\n");
}





