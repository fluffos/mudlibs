//dante sl 98-99


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"

int da=0;
int heile=2; //von 4 auf 2 runter!!!!!!!


create()
{
  ::create();

  v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
        "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
        "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
        "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
        "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
        "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
        "alle Kreaturen, die das Licht scheuen. Mitten im Raum steht "
        "ein schlichter Altar."));


  AD("raum",
      "Ein Grab.");

  AD("altar",
      "Der Altar besteht aus schwarzem Marmor. Seine Oberflaeche "
      "ist ueberzogen mit Wachs.");
  AD("marmor",
      "Der Marmor scheint schon sehr verblasst zu sein. Er ist voller "
      "Wachs.");
  AD("oberflaeche",
      "Die Oberflaeche ist voller Wachs.");
  AD("wachs",
      "Das Wachs ist schon kalt und hart. Scheinbar hat jemand hier "
      "eine Kerze aufgestellt und angezuendet.");

  ASD(({"schwarze kerze","kerze"}), "d_kerze");





  AddExit("sueden", "./loch7");
  AIT(FN"vamp6", REFRESH_DESTRUCT);
  AIT(FN"vamp2", REFRESH_DESTRUCT);
  ACD(({"zuende","zuend"}), "burn");

}




kerze_burn()  {
  if(da)  return ;
  if(!da)  {
    da=1;
    tell_room("d/gebirge/dante/gruft/room/loch13",
        "Ploetzlich steht eine Kerze am Altar!\n");  
  }  
}


int burn(string str)  {
  NF("Was willst Du anzuenden?\n");
  if(str=="kerze an"||str=="schwarze kerze an"||str=="kerze")  {

    if(present("vampir", TO))  {
      write(
          "\nDer Vampir tritt Dich aus dem Raum!\n");
      TPM(FR"loch7", M_GO+M_NO_SHOW, "von einem Vampir aus dem Raum getreten",
          "wird", "wird von eine Vampir hierher getreten");
      return 1; 
    }



    if(!da)  {
      write(BS(
            "Da ist keine Kerze, die Du anzuenden kannst."));
      return 1; 
    }

    if(da)  {

      say(BS(
            CAP_TPN+" zuendet eine schwarze Kerze an."));


      if(TP->FindPotion())  {
        da--;
        write(BS("Du zuendet die schwarze Kerze an."
              " Die Kerze brennt auf einmal extrem schnell ab und nur etwas "
              "Wachs bleibt uebrig."));
        return 1; 
      }
      else {
        if(heile)  {
          write(BS(
                "Die schwarze Kerze brennt extrem schnell ab und Du fuehlst Dich "
                "gut!"));
          TP->heal_self(25+random(25));
          heile--;
          return 1; 
        }

        if(!heile)  {
          write(BS(
                "Die schwarze Kerze brennt extrem schnell ab. Sonst passiert nichts."));
          return 1; 
        }
        return 0; 
      }
      return 0;
    }
    return 0;
  }
  return 0; 
}



reset()  {
  ::reset();

  heile=2;
  da=0;

}




d_kerze()  {
  if(!da)  {
    return BS(
        "Es steht keine Kerze am Altar.");  
  }
  if(da)  {
    return BS(
        "Eine schwarze Kerze steht am Altar.");  
  }  
}

