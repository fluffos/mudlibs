//dante sl 99 98

#include "../gruft.h"


void v_details()
{


  AD("moder",
      "Langsam aber sicher vermodert hier alles.");
  AD("umgebung",
      "Hier in der Dunkelheit fuehlen sie sich wohl und lauern auf Dich.");


  AD(({"wand","waende"}),
      "Die Waende sind aus Stein, der auch von Moder ueberzogen ist. "
      "Ab und zu scheint ein Knochen aus der Wand zu ragen.");
  AD("knochen",
      "Fein saeuberlich abgenagt...");

  AD(({"seite","seiten"}),
      "Rechts und links von Dir stehen alte Grabsteine aus grobem "
      "Stein, der schon recht bruechig wirkt.");

  AD(({"grabsteine","grabstein","steine"}),
      "Die Grabsteine stehen recht schief herum. Teilweise scheinen "
      "sie schon zu versinken und zu verfallen. Andere wiederum sind "
      "noch recht gut erhalten. Manche Inschrift kann man vielleicht "
      "sogar noch entziffern.");

  ASD(({"inschrift","inschriften"}), "show");
  AD("stein",
      "Der Stein ist uralt und wird bald zu Staub zerfallen.");
  AD("staub",
      "Der Staub sammelt sich langsam am Boden und Du hinterlaesst "
      "darin Abdruecke.");
  AD("boden",
      "Der Boden ist mit Staub bedeckt und man erkennt darin Abdruecke.");
  AD(({"abdruck","abdruecke"}),
      "Du bist Dir nicht mehr sicher ob sie von Dir oder doch "
      "von einer der hiesigen Kreaturen sind.");
  AD(({"kreatur","kreaturen"}),
      "Hier leben vor allem Vampire.");
  AD(({"vampir","vampire"}),
      "Du triffst sie sicher.");
  AD("decke",
      "Die Decke ist sehr niedrig und aus Stein. Staub segelt langsam herab und "
      "sammelt sich am Boden.");

  AD(({"richtungen","richtung"}),
      "Schau Dich doch um. Jeder Gang fuehrt irgendwohin, das ist sicher.");

  AD(({"gang","gaenge"}),
      "Die Gaenge verzweigen sich in mehreren Richtungen und verlaufen sich "
      "in der Dunkelheit. Wo sie genau hinfuehren, ist nicht zu erkennen.");
  AD("dunkelheit",
      "Von oben faellt hier kein Licht herab. Die Kreaturen, die hier hausen, "
      "scheuen das Licht.");
  AD("licht",
      "Sei froh, dass Du etwas erkennen kannst.");


  AD("friedhof",
      "Der Friedhof liegt direkt ober Dir. Dort war Dir noch wohler...");


  AD(({"grab","graeber"}),
      "Die Graeber scheinen ein unterirdisches System zu bilden.");
  AD("system",
      "Wer es erschaffen und wer hier liegt ist laengst vergessen.");


  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );



  AddSound( DEFAULT_SOUND,
      "Hier glaubt man den Tod zu hoeren.");
  AddSound("tod",
      "Er ruft Dich...");    
  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es grauslich nach Verwesung...");
  AddSmell("verwesung",
      "Es stinkt brutal.");
}


string show()  {
  return BS(
      "Seltsam, egal welche Inschrift Du auch liest, jede, aber auch wirklich jede, "
      "enthaelt das Wort "+TPN+", was Dich nicht gerade froh stimmt.");
}

