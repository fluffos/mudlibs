//dante sl 99 98


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"
#include <mnpc.h>

int heile=3;

create()
{
  ::create();

  v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
        "Grab. Scheinbar liegt unter dem Friedhof ein System von begehbaren "
        "Graebern, denn Gaenge verlaufen von hier in die Dunkelheit. "
        "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
        "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
        "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
        "alle Kreaturen, die das Licht scheuen."));

  AddItem(FN"vamp6", REFRESH_DESTRUCT,
      ([
       P_MNPC_AREA: "/d/dschungel/dante/hoehle/room/loch",
       P_MNPC_DEFAULTROOM: FR "loch8",
       P_MNPC_FLAGS: MOV_MOVES +MOV_INDOORS + MOV_BACKWARDS ]));



  AddItem(FN"vrat", REFRESH_DESTRUCT);

  AD("boden",
      "Der Boden ist mit Staub bedeckt und man sieht Abdruecke. Einer "
      "der Abdruecke ist mit Blut gefuellt.");
  AD("blut",
      "Es sieht aus wie eine Blutlache.");
  AD(({"blutlache","lache"}),
      "Hmm, man sollte aus ihr trinken, zumindest machen das Vampire so.");


  AE("oben", "/d/gebirge/dante/friedhof/room/abstieg");

  AddExit("westen", "./loch6");
  AddExit("norden", "./loch10");


  AddCmd(({"trink", "trinke"}), "heilen");
}

int heilen(string str)
{
  notify_fail("Was willst Du hier trinken?!?!\n");
  if(str=="blut"||str=="aus lache"||str=="aus blutlache"||str=="blut aus lache")
  {
    if (heile)
    {
      write("Du trinkst Blut aus der Lache und bist nun frisch gestaerkt! Eklig!\n");
      TP->heal_self(50);
      say(CAP_TPN+" trinkt Blut!\n");
      heile--;
      return 1;

    }
    if(!heile)
    {
      write("Du trinkst aus der Lache!!! EKLIG!!!\n");
      say(CAP_TPN+" trinkt Blut!\n");
      return 1;
    }
    return 0;
  }
  return 0;
}


reset()
{
  ::reset();
  heile=3;
}

