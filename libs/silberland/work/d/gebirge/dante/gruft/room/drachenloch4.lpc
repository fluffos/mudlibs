//dante sl 98 98

#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Vampirdrachen" );
  SetProp( P_INT_LONG, BS(
        "Dieser Teil der Hoehle ist um vieles groesser und hoeher. Auch "
        "liegen keine Leichen am Boden herum. Nackter, kalter Stein ist alles "
        "was man hier sehen kann. Ab und zu blaest der Wind durch ein Loch "
        "im Boden herein, was Dich auch etwas verwundert..."));


  AddDetail( ({ "tod" }), 
      "Der Tod ist weiter oben." );
  AddDetail("teil",
      "Dieser Teil der Hoehle wird von normalen Vampiren nicht bewohnt.");
  AddDetail("vampire",
      "Keiner hier.");
  AddDetail("hoehle",
      "Die Hoehle ist hier viel geraeumiger und sauberer als draussen bei den "
      "Vampiren.");

  AddDetail("wind",
      "Seltsamerweise blaest der Wind aus einem Loch im Boden nach oben "
      "und scheint in einem weiteren Loch in der Decke zu verschwinden. "
      "Der Wind ist hier so stark, dass man mit ihm sicher nach oben segeln kann.");
  AddDetail(({"loch","loecher"}),
      "Hier gibt es 2 sehr grosse Loecher. Eines in der Decke, eines im "
      "Boden.");


  AddDetail(({"skyta"}),
      "Hmm, Skyta ist nicht da..."); 

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 0,ENV_TERRAIN:TT_CAVE]) );
  AddDetail("raum",
      "Du zitterst wie Espenlaub...");
  AddDetail(({"drache","vampirdrache"}),
      "Der Vampirdrache lebt hier irgendwo...");  
  AddDetail("decke",
      "Die Decke ist hier sehr hoch ueber Dir. Du entdeckst ein grosses Loch, "
      "das scheinbar nach oben fuehrt.");
  AddDetail(({"espenlaub","laub"}),
      "Auch dafuer gibts sicher keine Fps...");
  AddDetail(({"fp","fps"}),
      "Dafuer auch nicht.");

  AddDetail(({"leiche","leichen"}),
      "Keine.");
  AddDetail( "boden",
      "Der Boden ist glatt und sehr sauber. Das liegt daran, das Skyta seine "
      "Opfer total verspeist.");
  AddDetail("opfer",
      "Du wirst auch eines!");

  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus nacktem, schwarzen Stein. Ab und zu "
      "entdeckt man einige tiefe Kratzer.");
  AddDetail("kratzer",
      "Sie stammen von einer unglaublich gefaehrlichen Waffe.");
  AddDetail("waffe",
      "Diese Waffe lernst Du bald kennen.");


  AddDetail(({"stein","stein"}),
      "Der Stein ist aeusserst kalt. Ueberhaupt herrscht hier eine sehr eisige "
      "Stimmung.");
  AddDetail("stimmung",
      "Die Stimmung ist hier auf dem absoluten Nullpunkt. Es hat hier Null Grad!");
  AddDetail(({"grad","null","nullpunkt"}),
      "Wenn Du ganz genau schaust, siehst Du Deinen eigenen Atem!");
  AddDetail("atem",
      "Du keuchst ziemlich...");




  AddItem(FN"vfled", REFRESH_DESTRUCT);
  AddItem(FN"vfled", REFRESH_DESTRUCT);
  AddItem(FN"vfled", REFRESH_DESTRUCT);

  AddSound( DEFAULT_SOUND,
      "Hier glaubt man den Tod zu hoeren.");
  AddSpecialExit("oben", "up");
  AddSpecialExit("unten","down");
  AddCmd(({"schwebe","segel","segle","schweb"}), "go");    
  AddSmell( DEFAULT_SMELL,
      "Hmm, Du riechst nichts. Es ist zu kalt..");
}


int go(string str)
{
  notify_fail("Womit willst Du nach oben segeln?\n");
  if(str=="mit wind nach oben"||str=="mit wind rauf"||str=="mit wind hinauf")
  {
    write("Du segelst mit dem starken Wind nach oben!\n");
    TP->move(FR"drachenloch2",
        M_GO, "mit dem Wind nach oben", "segelt",
        "schwebt im Wind von unten herauf");
    return 1;
  }
  return 0;
}



int up()
{
  write
    ("Du versuchst nach oben zu gelangen, aber so kommst Du hier nicht hoch.\n");
  return 1;
}


int down()
{
  write(BS
      ("Du versuchst nach unten zu gelangen, aber der Wind aus dem Loch ist zu "
       "stark und treibt Dich immer wieder nach oben!\n"));
  return 1;
}


