//dante sl 99-98
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"
int i;

int heilen=3;

reset() {
	::reset();
	heilen=3;
     }	

create()
{
  ::create();

v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen."));


for(i=0;i<6+random(6);i++)  { 
AddItem("/d/gebirge/dante/gruft/npc/werwolf", REFRESH_DESTRUCT);
}



 AE("suedoben", "./loch6");

AD("boden",
"Im Boden steckt ein Griff.");
AD("griff",
"Ein alter morscher Griff.");

ACD(({"ziehe", "zieh"}), "pull");
 }

 int pull(string str)  {
 
 if(str=="griff"||str=="am griff")  {
 	
 	
       if(heilen)  {
       		
       write(BS(
       "Du ziehst am Griff. Ploetzlich ertoent leise Musik von irgendwoher. "
       "Die Untoten schreien laut und es rumpelt laut. Du fuehlst Dich besser!"));

TP->heal_self(50+random(50));
heilen--;
      return 1;  }

else

  write(BS(
  "Du ziehst am Griff. Nichts!"));
  return 1;  }

      }
  
  	
