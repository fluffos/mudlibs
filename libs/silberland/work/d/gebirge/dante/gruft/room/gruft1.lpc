//dante sl 99

#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


int mon=3;

int open=0;
int open2=0;


create()
{
  ::create();
  

SP(P_INT_SHORT, "In der Gruft der Vampire");

SP(P_INT_LONG, BS(
"Duester und unheimlich liegt die Gruft der Vampire vor Dir. Kalter schwarzer Marmor "
"verbreitet eine kalte, lebensfeindliche Atmosphaere. In die Waende sind grosse, dunkle "
"Nischen eingelassen, aus denen der Atem des Todes zu Dir weht.  Die Gruft erstreckt sich "
"hier nach Norden. Im Sueden kannst Du sie durch ein Tor "
"verlassen."));
  SetProp( P_LIGHT, 0 );
    SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]));




AD(({"norden"}),
"Im Norden breitet sich die Gruft aus.");
 AD("sueden",
 "Im Sueden ist das Tor, das Dich retten koennte.");
 AD("atem",
 "Du spuerst den Atem des Todes direkt hinter Dir.");
 AD("boden",
 "Der Boden besteht aus dunkelrotem Stein.");
 AD("stein",
 "Es gibt hier zwei davon. Vampirstein und Blutstein.");
 AD("blutstein",
 "Der Blutstein leuchtet ab und zu rot auf. ");
 AD("decke",
 "Die Decke ist gewoelbt. Grosse, graue Spinnweben haengen herab.");
 ASD(({"spinnweben","weben","webe","spinnwebe"}), "come_mon");
 AD("atmosphaere",
 "Kalt und lebensfeindlich, bedrohlich und unheimlich wirkt diese Gruft auf Dich. ");

 AD("atmosphaere",
 "Kalt und lebensfeindlich, bedrohlich und unheimlich wirkt "
 "diese Gruft auf Dich. ");
 AD(({"wand","waende"}),
 "Die Waende bestehen aus purem Marmor. Es handelt sich um Vampirstein. Unheimliche "
 "Nischen gaehnen dunkel wie Maeuler eines unersaettlichen Monsters, bereit Dir den Tod "
 "zu bringen.");
 AD("vampirstein",
 "Den Vampirstein gibt es nur hier. Er soll sehr, sehr wertvoll sein und auch magische "
 "Kraefte haben. Du haettest gerne etwas von dem kostbaren Vampirstein.");
 AD(({"kraft","kraefte"}),
 "Das musst Du schon selbst herausfinden.");
 
 ASD("grosser sarg", "grsarg");
 ASD("kleiner sarg", "klsarg");
 


SP(P_KILL_NAME, "Neugier, Dante und ein Witz");
SP(P_MURDER_MSG, "Humor ist wenn man trotzdem lacht!");
     
     
     AD("monster",
     "Irgendwo lauert es sicher auf Dich!");
     AD(({"nische","nischen"}),
     "Die Nischen sind sehr dunkel, aber man kann trotzdem ganz deutlich einen grossen und "
     "einen kleinen Sarg erkennen.");
     AD(({"sarg","saerge"}),
     "Hier gibt es 2 Saerge, einen kleinen Sarg und einen grossen Sarg!");
     AD(({"maul","maeuler"}),
     "Bereit Dich zu verschlingen.");
     
                   
     ASD("tod","deads");
     AD("gruft",
    "Die Gruft der Vampire ist kalt und unheimlich. Alles ist mit schwarzem Marmor "
     "ausgekleidet, der das Klopfen Deines aengstlichen Herzens reflektiert.");
      AD(({"vampir","vampire"}),
        "Scheint keiner da zu sein...");
                   AD("marmor",
                   "Der Marmor glaenzt schwarz und unheimlich. Manchmal glaubst Du eine schmenhafte "
                   "Reflektion eines Vampirs zu erkennen.");
                   AD("reflektion",
                   "Hinter Dir taucht ein Vampir auf!\n"
                   "Der Vampir greift Dich mit seinen Vampirkrallen an!\n"
                   "Der Vampir pulverisiert Dich!\n");
                   AD("klopfen",
                   "BUMM BUMM BUMM BUMM!!!");
                   
        ASD(({"herz","herzen"}), "puls");
    ACD(({"oeffne"}), "do_open");
                   AE("norden", "./gruft4");
                   


 NewDoor("sueden", ( FR"loch12"),
   ({"tor"}),
   
      ({
          D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
 D_LONG, 
"Das Tor ist aus schwarzem Marmor gefertigt.",
       D_GENDER, NEUTER,
     D_SHORT, "Ein %ses Tor.",
         D_NAME, "Tor",
                          } ));
                           
                                                                                                
 
}

reset(){
::reset();
  open=0;
 open2=0;
 mon=3;
 }
 
 
 string grsarg()
   {
   if(open)
   return ("Der grosse Sarg wurde bereits geoeffnet.\n");
   else
   return ("Der grosse Sarg schaut bedrohlich und unheimlich aus. Er ist geschlossen.\n");
   }
   
   
   string klsarg()
     {
     if(open2)
     return ("Der kleine Sarg wurde bereits geoeffnet.\n");
     else
     return ("Der kleine Sarg ist noch geschlossen.\n");
     }
     
     
     
     init()  {
     ::init();
     if(interactive(TP)) call_out("tag", 5);
     }
     
     void tag(){
     	if(TO!=environment(TP)) return;
     	
     write(BSA(
     "Willkommen in meiner Gruft, "+CAP_TPN+"! Frisches Blut ist uns immer willkommen!",
     "Nosferatu, der Fuerst der Vampire teilt Dir mit: "));
     }
     
                   
                   int do_open(string str)
                   {
                   object ob1, ob2;
                   NF("Was willst Du oeffnen?!\n");
                   if(str=="sarg")
                    {
                    write("Welchen Sarg?!\n"); 
                    return 1;
                    }


 if(str=="grossen sarg"||str=="grosser sarg")
                      {
                      if(open)  {
        write("Der grosse Sarg ist schon geoeffnet.\n");
                      return 1;
                      }
       
     if(present("vampir", environment(TP))) {

     	write(BS(
     "Der Vampir tritt Dich nieder!"));
     return 1; }
     	    
    else {  
  write(BS(
"Du oeffnest den grossen Sarg. Es knirscht laut und Dir wird Angst und Bang! "
"Ein grosser Blutvampir steigt aus dem Sarg!!!"));
   say(BS(
   CAP_TPN+" oeffnet den grossen Sarg!"));
    write(BSA(
    "Willkommen, "+TPN+"! Gib mir Dein Blut!",
    "Der grosse Blutvampir sagt: "));
    
    ob1=clone_object(FN"grv");
     ob1->move(TO, M_TPORT+M_SILENT);
     ob1->SetProp(P_SHORT, "Ein grosser Blutvampir erweckt von "+CAP_TPN+"");
                        open=1;
                        return 1;
                        }
                        return 0;
                }
                
                
                
                
        if(str=="kleiner sarg"||str=="kleinen sarg")
                        {

if(open2)   {
	write(BS(
"Der kleine Sarg ist schon geoeffnet."));	
                            return 1;
                            }


     if(present("vampir", TP))
                            {
write(BS(
"Der Vampir schlaegt Dich!"));
return 1; }

else {
write(BS(
"Du oeffnest den kleinen Sarg!"));
say(BS(
CAP_TPN+"oeffnet den kleinen Sarg!"));
write(BS(
"Die schoene Vampira klettert aus dem Sarg heraus!"));

write(BSA(
"Hallo! "+TPN+"! Umarme mich!",
"Die schoene Vampira sagt: "));
open2=1;
                            ob2=clone_object(FN"klv");
                            ob2->move(TO, M_TPORT+M_SILENT);
                            return 1;
                            }
                            return 0;
                        }
                        
            return 0;
           }
                            
                       
                            
  string come_mon()
             {
          object ob;
      if(present("vampirspinne", environment(TP)))
      {
  write(BS(
   "Dir faellt eine Spinnwebe genau in Die Augen. Das Licht verschwindet langsam."));
                              
                              TP->SetProp(P_BLIND, 10+random(20));
                     return "";
                              }
                              
                              
                              
                              if(mon)  
                              
                              {
                              write( "Du starrst in die Spinnweben und...\n");
                              ob=clone_object(FN"vspi");
                              ob->move(environment(TP), M_TPORT);
                              ob->Kill(TP);
  ob->SetProp(P_SHORT,  "Eine Vampirspinne namens "+CAP_TPN+"");
                              //kleiner spass
                              mon--;
                           return "";
                              }
                              
                     if(!mon)  {

  write(BS(
   "Dir faellt eine Spinnwebe genau in Die Augen. Das Licht verschwindet langsam."));
                              
                              TP->SetProp(P_BLIND, 10+random(20));
                             return "";
                             
                              }                         
                              
                              
                              
                              return "";
                              }
                              
                              
   string  deads()
      {
         write(BSA(
           CAP_TPN+", Du bist ja erst "+TP->QueryProp(P_DEADS) +" mal gestorben! "
             "Was macht da ein Tod mehr, also hoer auf zu Winseln!\n", 
             "Eine dunkle Stimme  sagt: "));
TP->SetProp(P_GHOST, 1);
TPM("/room/death/death_room", M_GO+M_NO_SHOW,
"einen boesartigen Faketod!", "stirbt");
                 return "";}
                                     


                                       
              string puls()
      {
      int beat;
      beat=130+random(80);
      return 
 "Dein Herz schlaegt "+beat+" mal in der Minute.\n"
 " Du solltest wohl etwas kuerzer treten.\n";
      }
                                       
                                       