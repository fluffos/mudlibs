//ghulraum
//dante


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../gruft.h"
int mon=1;


reset(){
::reset();
mon=1;
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei den Vampirghulen" );
  SetProp( P_INT_LONG, BS(
   "Du hast nun endlich zu den sagenumwobenen Vampirghulen gefunden. "
   "Aber freundlich sieht es hier natuerlich auch nicht aus. Die Hoehle "
   "ist hier schmal und sehr niedrig. Der Boden ist schlammbedeckt und "
   "von der Decke tropft schmutziges, stinkendes Wasser. Im "
   "Osten scheint die Hoehle groesser und trockener zu werden."));
   
   AD("osten",
   "Dort kannst Du hingehen!");
   
   AD("raum",
   "Bei den Vampirghulen");
  AD("moment",
  "Warte einfach hier...");
    AD(({"ghul","vampirghul"}),
    "Hier leben also die Vampirghule. Im Moment scheint keiner hier zu sein.");
   AD("hoehle",
   "Die Hoehle ist hier viel enger und irgendwie fuehlst Du Dich sehr eingeengt.");
   AD(({"wand","waende"}),
   "An den Waenden rinnt schmutziges, stinkendes Wasser herunter und sammelt "
   "sich am Boden als brauner Schlamm an.");
   AD("wasser",
   "Das Wasser ist giftig, also trink ruhig davon!");
  AD("boden",
  "Der Boden ist mit einer dicken Schicht aus Schlamm bedeckt. Er blubbert und "
  "dampft unheimlich.");
  AD("schicht",
  "Hmm, ob man darin versinken kann...");
  AD("schlamm",
  "Der Schlamm ist giftig. Ab und zu macht er BLUBB. Ob es gut ist, "
  "hier zu lange zu verweilen...");
   AD("decke",
   "Von der Decke tropft eine eklige Bruehe.");
   ASD("bruehe","gift");
   
AIT(FN"vamp8", REFRESH_DESTRUCT);        
        
        
        
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  
    
   AddExit("westen","./ghul"); 
AE("osten", "./drachenloch2");
   AddSound(DEFAULT_SOUND,
   "Es blubbert irgendwo...");    
  AddSmell( DEFAULT_SMELL,
    "Hier stinkt es eklig...");
 
 
 
 }


   string gift() {
write(
  "Die Bruehe trifft Dich voll im Gesicht!\n");
  TP->AddPoison(2);
  return "";
  }
