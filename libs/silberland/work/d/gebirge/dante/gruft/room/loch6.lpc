//dante sl 99-98
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./v_inh.lpc"
create()
{
  ::create();

v_details();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
 "Du bist nun in einem uralten, laengst vergessenen, unterirdischen "
 "Grab. Scheinbar liegt unter dem Friedhof eine System von begehbaren "
 "Graebern, denn Gaenge verlaufen sich von hier in der Dunkelheit. "
 "Zu beiden Seiten stehen alte Grabsteine, deren Inschriften "
 "nicht mehr zu entziffern sind. Die Waende bestehen aus gemauertem "
 "Stein, der von Moder ueberzogen ist. Eine ideale Umgebung fuer "
 "alle Kreaturen, die das Licht scheuen."));

 
 AddItem(FN"vamp2", REFRESH_DESTRUCT);
 AE("sueden", "./loch14");
   AddExit("norden", "./loch7");
   AddExit("osten","./loch8"); 
//ACD(({"kreuzfluch"}), "check");

AddExit("nordunten", "./kreuzraum");

AddSmell(({"werwolf","werwoelfen"}),
"Hmm, verdaechtig! Es riecht hier nach Werwoelfen!!!");


 }

