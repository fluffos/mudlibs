//ghulraum

#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int heile=5;

void reset()  {
  ::reset();
  heile=5;
}

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei den Vampirghulen" );
  SetProp( P_INT_LONG, BS(
        "Du hast nun endlich zu den sagenumwobenen Vampirghulen gefunden. "
        "Aber freundlich sieht es hier natuerlich auch nicht aus. Die Hoehle "
        "ist hier schmal und sehr niedrig. Der Boden ist schlammbedeckt und "
        "von der Decke tropft schmutziges, stinkendes Wasser. "));

  AD("raum",
      "Bei den Vampirghulen");
  AD("moment",
      "Warte einfach hier...");
  AD(({"ghul","vampirghul"}),
      "Hier leben also die Vampirghule. Im Moment scheint keiner hier zu sein.");
  AD("hoehle",
      "Die Hoehle ist hier viel enger und irgendwie fuehlst Du Dich sehr eingeengt.");
  AD(({"wand","waende"}),
      "An den Waenden rinnt schmutziges, stinkendes Wasser herunter und sammelt "
      "sich am Boden als brauner Schlamm an.");
  AD("wasser",
      "Das Wasser ist hier geniessbar!!! Trink davon!!!");
  AD("boden",
      "Der Boden ist mit einer dicken Schicht aus Schlamm bedeckt. Er blubbert und "
      "dampft unheimlich.");
  AD("schicht",
      "Hmm, ob man darin versinken kann...");
  AD("schlamm",
      "Der Schlamm ist giftig. Ab und zu macht er BLUBB. Ob es gut ist, "
      "hier zu lange zu verweilen...");
  AD("decke",
      "Von der Decke tropft eine eklige Bruehe.");
  ASD("bruehe","gift");

  AIT(FN"vamp9", REFRESH_DESTRUCT);        
  AIT(FN"vrat", REFRESH_DESTRUCT);        



  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );



  AddExit("sueden","./ghul2"); 

  AddSound(DEFAULT_SOUND,
      "Es blubbert irgendwo...");    
  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es eklig...");

  ACD(({"trink","trinke"}), "water");

}

int water(string str)  {
  NF("Was willst Du trinken?!\n");
  if(str=="wasser")  {
    say(BS(
          CAP_TPN+" trinkt etwas von dem Wasser."));	

    if(heile)  {
      write(BS(
            "Du trinkst etwas Wasser und fuehlst Dich gut!"));
      TP->heal_self(25+random(25));		
      heile--;
      return 1; }
      if(!heile)  {
        write(BS(
              "Das Wasser schmeckt nur fad!"));
        return 1; 
      }
      return 0;
  }
  return 0; 
}



string gift() {
  write(
      "Die Bruehe trifft Dich voll im Gesicht!\n");
  TP->AddPoison(1);
  return "";
}
