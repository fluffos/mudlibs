//ghulraum
//dante sl 99


#include "../gruft.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int open=0;

reset(){
::reset();
open=0;
RemoveExit("nordosten", "./ghul2");                  
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei den Vampirghulen" );
  SetProp( P_INT_LONG, BS(
   "Du hast nun endlich zu den sagenumwobenen Vampirghulen gefunden. "
   "Aber freundlich sieht es hier natuerlich auch nicht aus. Die Hoehle "
   "ist hier schmal und sehr niedrig. Der Boden ist schlammbedeckt und "
   "von der Decke tropft schmutziges, stinkendes Wasser. "
   "Auffallend ist die grosse Kugel, die an einer Wand des Raumes liegt. "
   "Im Westen kommt man wieder zurueck und im Osten kommt man irgendwohin..."));
   
   
   AD("westen",
   "Da geht es zu den Vampiren zurueck.");
   AD("osten",
   "Geh doch hin...");
   
   AD("raum",
   "Bei den Vampirghulen");
   ASD("kugel","wo_kugel");
   
   
  
   AD("schlammkugel",
    "Die Kugel wurde an die Wand gerollt. Du erkennst nun auch Spuren "
    "im Schlamm, die durch das Rollen entstanden sind.");
    AD(({"spur","spuren"}),
    "Die Spuren beweisen, dass man die Kugel bewegen kann. Oder zumindest "
    "irgendjemand kann es...");
    AD("rollen",
    "Die Vampirghule haben die Kugel hierher gerollt.");
        
  
  AD("moment",
  "Warte einfach hier...");
    AD(({"ghul","vampirghul"}),
    "Hier leben also die Vampirghule. Im Moment scheint keiner hier zu sein.");
   AD("hoehle",
   "Die Hoehle ist hier viel enger und irgendwie fuehlst Du Dich sehr eingeengt.");
   AD(({"wand","waende"}),
   "An den Waenden rinnt schmutziges, stinkendes Wasser herunter und sammelt "
   "sich am Boden als brauner Schlamm an.");
   AD("wasser",
   "Das Wasser ist giftig, also trink ruhig davon!");
  AD("boden",
  "Der Boden ist mit einer dicken Schicht aus Schlamm bedeckt. Er blubbert und "
  "dampft unheimlich.");
  AD("schicht",
  "Hmm, ob man darin versinken kann...");
  AD("schlamm",
  "Der Schlamm ist giftig. Ab und zu macht er BLUBB. Ob es gut ist, "
  "hier zu lange zu verweilen...");
   
   AD("decke",
   "Von der Decke tropft eine eklige Bruehe.");
   ASD("bruehe","gift");
   
        
        
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  
    
   AddExit("osten","./ghul3"); 
  ASE("westen", "nix");
   AddSound(DEFAULT_SOUND,
   "Es blubbert irgendwo...");    
  AddSmell( DEFAULT_SMELL,
    "Hier stinkt es eklig...");
 
   ACD(({"rolle","roll"}), "raus");
 
 
AIT(FN"vamp9", REFRESH_DESTRUCT); 
AIT(FN"vamp9", REFRESH_DESTRUCT); 
 ASD("loch", "wo_loch");
 }

int nix()  {
	NF(BS(
"Eine Hand schnellt aus dem Boden hervor und haelt Dich fest!"));
}	

string wo_loch()
  {
  if(open)
     {
     write("Das Loch fuehrt nach Nordosten.\n");
     }
     if(!open)
      {
      write("Sowas siehst Du da nicht!\n");
            }
    return "";
       }
            
            
string wo_kugel()
  {
  if(!open)
    {
write(BS(
   "Die Kugel besteht aus gehaertetem Schlamm, den man gepresst hat. "
   "Daher nennt man sie auch Schlammkugel."));
     }
     if(open)
     {
     write(BS(
   "Die Kugel besteht aus gehaertetem Schlamm, den man gepresst hat. "
   "Daher nennt man sie auch Schlammkugel. Irgendjemand hat die Kugel "
   "weggerollt und so ein Loch in einer der Waende freigelegt."));
     }
    return "";
    }
     
  
     
     
 int raus(string str)
   {
   notify_fail("Was willst Du hier rollen?\n");
   if(member(({"kugel weg","kugel", "schlammkugel weg","schlammkugel"}),str)!=-1)
      {
      if(open)
         {
         say(CAP_TPN+" rollt die Schlammkugel vor das Loch!\n");
         write("Du rollst die Kugel vor das Loch!\n");
         open=0;
           RemoveExit("nordosten", "./ghul2");                  
         return 1;
         }
       if(!open)
         {
          AddExit("nordosten", "./ghul2");         
         write("Du rollst die Kugel zur Seite und entdeckst ein Loch!\n");
         open=1;
         return 1;
         }
    return 0;
    }
 return 0;
 }
           


  string gift()
  {
  write("Du schaust nach oben und WUMM!!!\n"
  "Die Bruehe trifft Dich voll im Gesicht!\n");
  TP->AddPoison(2);
  return "";
  }
