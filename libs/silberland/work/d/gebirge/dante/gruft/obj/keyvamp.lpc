//vampir tor schluessel dante sl 98-99
inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein blutroter Schluessel");
  SetProp (P_LONG,BS (
  "Dieser Schluessel sieht bedrohlich und boese aus. Er hat die Form eines "
  "umgedrehten Kreuzes."));  
  AD(({"form","kreuz"}),
  "Nur angedeutet.");
  SetProp (P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "blutrot");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  AddId (({"\nkeyvamp", "schluessel"}));
  
  SetProp(P_INFO, "Der blutrote Schluessel koennte Dich ins Verderben fuehren.\n");  
SetProp(P_MATERIAL, ([MAT_IRON:10, MAT_BLOOD:10, MAT_MISC_LIVING:10]));
}
string QueryDoorKey()
{
return ("/d/gebirge/dante/gruft/room/loch11")+":"+("/d/gebirge/dante/gruft/room/loch9");   
}



