//eines der beiden kreue das man braucht


inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../gruft.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein heiliger Pfahl");
  SetProp(P_LONG,BS(
"Dieser Pfahl ist an einem Ende zugespitzt. Er wurde einst "
"vor langer Zeit erschaffen um Nosferatu zu toeten. Die Vampire "
"sollten ihn bewachen!!!"));

AD("ende",
"Es ist spitz und sehr hart. Damit kann man Nosferatu sicher "
"pfaehlen!");

  SP(P_MAGIC, 1);
  SetProp(P_VALUE,5000);
  SetProp(P_WEIGHT,500);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Pfahl");
  SetProp(P_MATERIAL, ([MAT_OAK:50, MAT_MISC_MAGIC:50]));
  SetProp(P_INFO, BS("Der Pfahl alleine ist nicht genug! Du brauchst auch "
  "einen Hammer dazu! Einen ganz speziellen Hammer!"));
  
  
  AddId(({"pfahl","VAMPIRPFAHL"}));
  SetProp(P_NOBUY, 1);

}

