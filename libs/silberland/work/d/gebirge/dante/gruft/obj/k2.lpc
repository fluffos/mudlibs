//der hammer fuer nosferatu
//dante sl 98-99

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../gruft.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein heiliger Hammer");
  SetProp(P_LONG,BS(
"Das ist der heilige Hammer, den man benoetigt um Nosferatu zu "
"toeten! Die Vampire sollten ihn eigentlich bewachen!"));


  SP(P_MAGIC, 1);
  SetProp(P_VALUE,5000);
  SetProp(P_WEIGHT,500);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Hammer");
  SetProp(P_MATERIAL, ([MAT_STEEL:40,MAT_OAK:10, MAT_MISC_MAGIC:50]));
  SetProp(P_INFO, BS("Der Hammer alleine ist nicht genug! Du brauchst auch "
  "einen Pfahl dazu! Einen ganz speziellen Pfahl!"));
  
  
  AddId(({"hammer","VAMPIRHAMMER"}));
  SetProp(P_NOBUY, 1);

}

