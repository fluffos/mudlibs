//ding fuer quest!!!!
//einsiedler sucht es

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../gruft.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Die Fluegel einer Vampirfledermaus");
  SetProp(P_LONG,BS(
  "Das sind die Fluegel einer Vampirfledermaus. Welchen Sinn die wohl haben..."));
  
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Vampirfledermausfluegel");
  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:100]));
  SetProp(P_INFO, ("Diese Fluegel koennen Dich erheben!\n"));
  
  AddId(({"VFLUEGEL","fledermausfluegel","fluegel","vampirfluegel","vampirfledermausfluegel"}));
  SetProp(P_NOBUY, 1);

}

