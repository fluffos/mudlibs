//vampir tor schluessel dante sl 98
inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein blutroter, grosser, Schluessel");
  SetProp (P_LONG,BS (
  "Dieser Schluessel sieht bedrohlich und boese aus. Er hat die Form eines "
  "umgedrehten Kreuzes. Er aehnelt dem Schluessel fuer das erste Tor, ist aber viel groesser."));  
  AD(({"form","kreuz"}),
  "Nur angedeutet.");
  SetProp (P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, ({"blutrot", "gross"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 500);
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  AddId (({"\nkeyvamp2", "schluessel"}));
  
  SetProp(P_INFO, "Der blutrote, grosse Schluessel koennte Dich ins Verderben fuehren.\n");  
SetProp(P_MATERIAL, ([MAT_IRON:10, MAT_BLOOD:10, MAT_MISC_LIVING:10]));
}

string QueryDoorKey()
{
return ("/d/gebirge/dante/gruft/room/loch11")+":"+("/d/gebirge/dante/gruft/room/loch12");   
}



