//dante sl 99

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../gruft.h"

int dunkel=0;

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Vampirrubin");
  SetProp(P_LONG,BS(
    "Der Vampirrubin glaenzt unheimlich rot und schwarz. Er soll "
    "irgendwelche magischen Kraefte haben."));
   
  SetProp(P_VALUE,5000);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Vampirubin");
  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:100]));
  SetProp(P_INFO, BS("Der Vampirrubin kann, wenn Du ihn vorher reibst, "
                     "grosse Dunkelheit erzeugen!"));
 
  AddId(({"rubin","vampirrubin", "vrubin"}));
  SetProp(P_NOBUY, 1);
  ACD(({"reibe","reib"}), "becomes_dark");
}

int becomes_dark(string str)  {
	string wer;
	wer="+TO->id()+";
	NF("Was willst Du reiben?!\n");
	if(!str) return 0; 
if(str==""+wer+"")
write(BS(
"Du reibst den Vampirrubin."));   
say(BS(
CAP_TPN+" reibt einen Vampirrubin."));
	{
	
if(deep_present("vrubin 2", TP))  {
  write(BS(
  "Deine Vampirrubine koennen nur funktionieren, wenn sie keinen anderen "
  "Vampirrubin in ihrer Naehe haben!"));
  return 1; }
  
  	
	
if(!dunkel)  {

write(BS("Der Rubin wird dunkler!"));
	dunkel=1;
	SP(P_LIGHT, -1-(random(2)));
	return 1; }
	
	
if(dunkel)  {
write(BS(
"Der Vampirrubin wird heller."));
dunkel=0;
SP(P_LIGHT, 0);

return 1; }
return 0; }
return 0; }



reset()  {
  ::reset();
  SP(P_LIGHT, 0);
  if(dunkel) {
    dunkel=0; 
    if(interactive(environment(TO)))  {
      tell_object(environment(TO),
        "Dein Vampirrubin leuchtet hell auf.\n");
    }	
  }	
}

