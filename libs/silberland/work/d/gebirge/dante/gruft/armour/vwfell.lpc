// Vampirwolffell.....
// dante sl 97 jaaen danke feyaria

#include "/players/dante/myowndefine.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Vampirwolffell");
  SetProp(P_LONG, BS(
  "Das ist ein Vampirwolffell. Es ist schwarz, hat blutrote Streifen. "
  "Sieht irgendwie boese aus. Trotzdem ist es schoen anzusehen. "
  "Und Gerben macht damit besonders viel Spass, angeblich..."));
    
  SetProp(P_NAME, "Vampirwolffell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolffell", "wolfsfell","vampirwolffell"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 237+random(50));
  SetProp(P_VALUE, 400+random(100));
}

