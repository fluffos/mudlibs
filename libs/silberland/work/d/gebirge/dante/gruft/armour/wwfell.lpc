// Werwolffell.....
// dante sl 97 jaaen danke feyaria

#include "/players/dante/myowndefine.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Werwolffell");
  SetProp(P_LONG, BS(
  "Das ist ein Werwolffell. Es ist total schwarz und recht dick. "
  "Sicher ein recht guter Schutz."));
    
  SetProp(P_NAME, "Werwolffell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolffell", "werwolffell"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 299+random(70));
  SetProp(P_VALUE, 500+random(100));
}

