//skytas krallen
//coooooles sache dante sl 98

inherit "/std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../gruft.h"
#include <thing/material.h>
#include <new_skills.h>

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Skytas Vampirdrachenkralle");
  SetProp(P_LONG,BS(
    "Das ist die Kralle vom Vampirdrachen Skyta. Eigentlich sind es ja "
    "zwei Krallen. Sie sind nicht nur ein guter Schutz, "
    "sondern haben auch magische Kraefte, die Dich im Kampf unterstuetzen koennen."));
  SetProp(P_NAME, "Vampirdrachenkralle");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,1);
  SetProp(P_INFO, "Die Vampirdrachenkrallen sind beeindruckend gut!\n");
  AddId(({"krallen","kralle"}));
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:0 ]) ); 
  AddId(({"drachenkrallen", "vampirdrachenkrallen"}));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000+random(1000));
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 8);
  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
      ([DT_UNHOLY:1, DT_FIRE:1, DT_TERROR:1, DT_HOLY:1, DT_COLD:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:25, A_STR:15, SR_SEER:1]) );
  SetProp(P_MATERIAL,([MAT_HORN:20,MAT_ANIMAL:70,MAT_MISC_MAGIC:10]));
}

void attack_enemy(object enemy) {
  object pl;

  if (!objectp(enemy) || !living(enemy)) return;
  if (enemy->QueryProp(P_NAME)=="Skyta") return;
  pl=QueryWorn();
  if (!objectp(pl)) return;
  if (query_once_interactive(pl) && !interactive(pl)) return;
  if (enemy==pl) return;
  if (interactive(enemy) && (enemy->QueryProp(P_GHOST))) return;
  if (environment(enemy)!=environment(pl)) return;
  if (pl->QueryProp(P_PARALYZED) || pl->QueryProp(P_DISABLE_ATTACK)) return;
  if (pl->QueryProp(P_NAME)!="Skyta" && random(100)<30) return;
  if (pl->QueryProp(P_SP)<10) return;
  tell_object(pl,"  Die Vampirdrachenkrallen versetzen "+
			  enemy->name(WEM)+" einen harten Schlag.\n");
  say("  "+capitalize(pl->name(WESSEN))+
	  " Vampirdrachenkrallen versetzen "+enemy->name(WEM)+" einen harten Schlag.\n",
	  ({pl,enemy}));
  pl->AddSp(-10);
  enemy->Defend(100+random(100), DT_BLUDGEON,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Vampirdrachenkrallen"]), pl);
}


//ende hitfunc


int DefendFunc(mixed dtype,object enemy) {
  object pl;

  if (!enemy) enemy=TP;
  if (!pointerp(dtype)) dtype=({dtype});
  if(random(10)==3 && find_call_out("attack_enemy")==-1) 
    call_out("attack_enemy",0,enemy);
  pl=QueryWorn();
  if (objectp(pl) && pl->QueryProp(P_NAME)=="Skyta") return 50;
  if (member(dtype,DT_TERROR)>=0 ||
      member(dtype,DT_UNHOLY)>=0 || 
      member(dtype,DT_COLD)>=0 ) 
    //ob das geht..hmmm

  {
    if (objectp(enemy) && enemy->QueryProp(P_NAME)!="Skyta") return 0;
    return 15;
  }
  return 0;
}

