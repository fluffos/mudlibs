//dante sl 99

//ring kann kraft erhoehen!!!

#include "../gruft.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int pow, heal;

void wie();

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"ring", "kraftring", "ring der kraft",
      "stahlring","vampirring"}));
  SetProp(P_SHORT, "Ein blutroter Vampirring");
  SetProp(P_LONG,BS(
  "Dieser Ring sieht sehr unheimlich und boesartig aus. Bei naeherer "
  "Betrachtung erkennst Du blutrote Zeichen, die jemand in den glatten Stahl "
  "eingeritzt hat. Angeblich soll dieser Ring seltsame Auswirkungen auf den "
  "Traeger haben..."));
  SetProp(P_NAME, "Vampirring");
  AddDetail("stahl",
  "Grau, hart, irgendwie zeitlos.");
  AddDetail(({"zeichen"}),
  "Du kannst sie nicht entziffern, aber sie faszinieren Dich trotzdem. "
  "Hmmm, es scheint so als ob sie sich bewegen, nein, die rote Farbe "
  "bewegt sich!\n");
  AddDetail("farbe",
  "Die Farbe erweist sich als Blut, echtes Blut, das fliesst!\n");
  AddSpecialDetail("blut", "d_heal");
  heal=1;
  

  
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 3);

  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 7600+random(1000));
  SetProp(P_MATERIAL, ([MAT_BLOOD:100]));
  SetProp(P_MAGIC,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:20]) );
  SetProp(P_QUALITY_DECAY, ([ DT_BLUDGEON : 0, DT_TERROR : 0, 0 : 50 ]) );
  SetProp(P_INFO, BS(
    "Dieser Ring verleiht seinem Traeger moeglicherweise zusaetzliche "
    "Kraft und kann ihn in gewissen Abstaenden auch heilen."));
  
  wie();

  SetProp(P_CURSED,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP, 1);  

  SetProp(P_M_ATTR_MOD, ([ A_STR:pow]) );  
  SetProp(P_REMOVE_FUNC, this_object() );
}

int RemoveFunc(object ruest,int silent)
{
  heal = 0;
  return 1;
}    

string d_heal()
{
  if(heal>=1)
  {
    write("Die blutroten Runen leuchten!\n");
    if (time() - QueryProp(P_EQUIP_TIME) > 600) {
      write("Der Anblick des Blutes gibt Dir neue Kraft!\n");
      say(CAP_TPN+" wird von einem blutroten Strahl getroffen!\n");
      TP->heal_self(50+random(50));
      //stark herabgesetzt dante!!!
      heal=0;
    }
    return "";
  }
  if(!heal)
  {
    write("Die Runen wirken irgendwie blass.\n");
    return "";
  }
}
   
   
void reset()
{
  object pl;

  ::reset();
  if (heal!=1 && objectp(pl = QueryProp(P_WORN)) && interactive(pl)) {
    heal=1;
    tell_object(pl,
        "Die Runen an Deinem Vampirring leuchten kurz blutrot auf!\n");
  }
}

void wie()
{
  switch(random(100))
    {
    case 0 .. 2:
    pow=-1; // hehe, zordan
    case 3 .. 40:
    pow=0;
    break;
    case 41 .. 70:
    pow=1;
    break;
    case 71..90:
    pow=2;
    break;
    case 91 ..99:
    pow=3;
    break;
    default: write("BUG!\n");
}


   }
    

