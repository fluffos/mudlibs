//halsband by dante 97 etwas anders 98
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../gruft.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  
  AddId (({"VKREUZ","kreuz","vampirkreuz","vampirdrachenkreuz","drachenkreuz"}));
  SetProp (P_SHORT, "Ein Vampirdrachenkreuz");
  SetProp (P_LONG, BS(
  "Dieses Kreuz stellt einen symbolisierten Vampirdrachen dar. "
  "Es ist sehr klein, trotzdem scheint es irgendeine Macht zu haben! "
  "Mit der Kette kannst Du es bequem um Deinen Hals haengen."));
  AD("kette",
  "Sie ist recht kurz, aber es geht sich aus.");
  AddDetail("vampirdrache",
  "Hmm, er sieht aus wie Skyta!");
  AddDetail("skyta",
  "Hmm, wozu gibts dieses Kreuz?!\n");
      
  SetProp (P_NAME, "Vampirdrachenkreuz");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 2600+random(400));
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, MAT_GOLD);
}
