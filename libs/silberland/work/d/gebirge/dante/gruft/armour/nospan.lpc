#include "/players/dante/myowndefine.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

int last_attack;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Nosferatus Panzer");
  SetProp(P_LONG, BS( 
        "Dieser Panzer gehoerte einst dem Fuerst und Herrscher ueber alle Vampire! "
        "Der Panzer schimmert schwarz und blutrot und strahlt eine boese Aura aus. "));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Nosferatus Panzer");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, BS(
        "Dieser Panzer hat ein Eigenleben. Er wird Dir im Kampf gegen gute Monster "
        "helfen. Er koennte Dich aber auch bestrafen..."));

  AddId( ({"panzer", "nosferatus panzer", "vampirpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 38);
  SetProp(P_MATERIAL, ([ MAT_MAGIC:50, MAT_BLOOD:50]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_DEFEND_FUNC, TO);

}


//LICHT!!!!!!!!!!!!!!!!!!!! schadet der rue sehr !!!!!!!!

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object traeger;
  int x;

  if(!objectp(traeger = QueryProp(P_WORN))) return 0;
  if ((member(dam_type, DT_LIGHT) != -1))
  {
    if (random(10))
    {
      tell_object(traeger, BS(
            "Die boese Magie von Nosferatus Panzer wird etwas weniger!!!"));
      if (QueryProp(P_AC) > 0) 
        Damage(random(2)+1);
    }
    return (-20 - random(20));
    tell_object(traeger, BS(
          "Nosferatus Panzer ist dieser Art von Angriff nur schlecht gewachsen!\n"));
  }
  else
  {
    //gute gegner tun sich aber weh!!! sehr gute gegner  mehr 
    if (!random(3) && 
        enemy->QueryProp(P_ALIGN) >= 300 + random(500) &&
        last_attack != time()) 
    {
      SetProp (P_KILLER, traeger->name());
      tell_object(enemy, BS(
            "Die boese Magie von Nosferatus Panzer schaedigt Dich!")); 
      tell_object(traeger, BS(
            "Die boese Magie von Nosferatus Panzer fuegt "+ enemy->name(WEM) +" Schaden zu.") );
      say( BS("Die boese Magie von "
            ""+traeger->Name(WESSEN)+" Panzer fuegt "+ enemy->name(WEM) +
            " schwere Verletzungen zu."), traeger );
      // Schaden jetzt abhaengig davon ,wie gut der Panzer noch ist.
      x=10+QueryProp(P_AC)*random(enemy->QP(P_ALIGN)/8)/VALID_ARMOUR_CLASS[AT_ARMOUR];
      enemy->Defend(x, DT_UNHOLY, ([SP_NAME:"nosferatus Panzer", 
                    SP_SHOW_DAMAGE:1]), traeger);
      last_attack = time();
    }
  }
  //und wenn der traeger  gut ist tut er sich weh
  if(traeger->QP(P_ALIGN)>100+random(500))
  {
    SetProp(P_KILLER, "Nosferatus Panzer");
    tell_object(traeger, BS(
          "Nosferatus Panzer wendet seine boese Magie gegen Dich! Du bist zu gut!!!"));
    say(traeger->Name()+" wird von Nosferatus Panzer verletzt.\n", traeger);
    traeger->do_damage(5 + random(5));//erhoeht!!!
  }
  return 0;
}

