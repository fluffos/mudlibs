//dante sl 99
//vampirspeer

#include "../gruft.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Vampirspeer");
  SetProp(P_LONG, BS( 
  "Der Vampirspeer ist nachtschwarz und wirkt sehr unheimlich auf Dich. "
  "Seine Spitze leuchtet blutrot und funkelt ab und zu."));
  AddDetail("spitze",
  "Rot wie Dein Blut!");
  
  SetProp(P_NAME,"Vampirspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer","vampirspeer", "\nvampirspeer"}) );
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC,240);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_PIERCE,DT_TERROR, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_SIZE, 300);
  SetProp(P_INFO, "Dieser Speer hasst alles Gute!\n");
  
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_BLOOD:10]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_MAGIC, 0);
  SetProp(P_VALUE,3000+random(300));
  SetProp(P_NOBUY, 1);
    SetProp(P_HIT_FUNC, this_object());               
    SetProp (P_WC_FIX, 50);    
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10, A_INT:15, A_DEX:15]));  
}


 int HitFunc(object enemy)  
 {
 int enal;
 enal=enemy->QueryProp(P_ALIGN);
 if(enal <= -500) {
 write("Dein Vampirspeer kann "+enemy->name(WEN)+" nicht treffen!\n");
 return -300;
 }
  if( (enal > -500) && ( enal < 0) ) {
   return -100; }
 
    if( (enal >= 0) && ( enal < 500) ) {
       return 1; }  
       
    if (enal > 500) {
    write("Dein Vampirspeer freut sich "+enemy->name(WEN)+" bekaempfen zu duerfen!\n");
       return 50; }     
       
}
           