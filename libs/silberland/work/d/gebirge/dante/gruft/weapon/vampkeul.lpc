//dante sl 99

//vampirdolch

#include "../gruft.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>


create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Vampirkeule");
  SetProp(P_LONG, BS( 
  "Diese Vampirkeule besteht aus schwarzem Metall. Sie ist gross, klobig "
  "und wenn sie Dich trifft, wirst Du es sicher spueren."));
  SetProp(P_NAME,"Vampirkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"vampirkeule","keule", "\nvampirkeule"}) );
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC,170);
  SetProp(P_DAM_TYPE,({DT_BLUDGEON, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 180);
  SetProp(P_MATERIAL, ([MAT_STEEL:99, MAT_MAGIC:1]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MAGIC, 0);

  SetProp(P_VALUE,1500+random(300));
  SetProp(P_NOBUY, 0);
}

