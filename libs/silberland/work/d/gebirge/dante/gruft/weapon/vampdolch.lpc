//vampirdolch
//dante sl 99

#include "../gruft.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <weapon.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein nachtschwarzer Vampirdolch");
  SetProp(P_LONG, BS( 
  "Der Vampirdolch besteht aus nachtschwarzem Stahl, der irgendwie blutrot "
  "glaenzt. Eine unheimliche Waffe. Die Klinge laeuft gewellt nach oben "
  "und endet in einer sehr scharfen Spitze, die hell aufblinkt."));
  AddDetail("spitze",
  "Sie glaenzt hell und bedrohlich!");
  AddDetail("stahl",
  "Nachtschwarz. Manchmal glaenzt er blutrot...");
  AddDetail("waffe",
  "Eine unheimliche Waffe.");
  AddDetail("klinge",
  "Sie laueft gewellt nach oben.");
  SetProp(P_NAME,"Vampirdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"vampirdolch","dolch", "\nvampirdolch"}) );
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC,110);
  
  SP(P_NAME_ADJ, "nachtschwarz");
  
  SetProp(P_INFO, "Der Vampirdolch erkennt geschwaechte Gegner!\n");
  SetProp(P_DAM_TYPE,({DT_RIP,DT_PIERCE, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 50);
  SetProp(P_MATERIAL, ([MAT_STEEL:99, MAT_MAGIC:1]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_MAGIC, 0);
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:15, SR_SEER:1]) );
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_QUALITY_DECAY, 50);

  SetProp(P_VALUE,4500+random(300));
  SetProp(P_NOBUY, 1);
}

int HitFunc(object enemy)
{
  int schaden;
  int wiemax, wiemom;
  wiemax=enemy->QueryProp(P_MAX_HP);
  wiemom=enemy->QueryProp(P_HP);
   
  if(((wiemom*12)<=wiemax)&&(!random(5)) )    
  {
    tell_object(environment(TO),
        BS("Dein Vampirdolch erkennt wie schwach "+enemy->name()+" bereits ist "
           "und bohrt sich extrem brutal in "+enemy->QueryPronoun(WEN)+" hinein."));
    //zuviel des boesen:)
    // enemy->AddPoison(1);
    TO->TakeFlaw(50);
    return random(100)+100;
  } 
  return 0;
}

