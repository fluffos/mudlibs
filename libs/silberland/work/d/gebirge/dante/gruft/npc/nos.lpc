
//dante sl 98 99
/*
   nosferatu der fuerst der vampire
   extrem gut, aber auf normale art nicht zu besiegen, sondern
   nur mit hammer und pfahl
   */


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Nosferatu, der Fuerst der Vampire");
  SetProp(P_LONG, BS(
        "Vor Dir steht Nosferatu der Fuerst der Vampire. Er ist der aelteste "
        "und staerkste aller Vampire. Eigentlich sieht er nur aus wie ein "
        "altes, verrunzeltes, boesartiges Maennchen, doch davon solltest "
        "Du Dich nicht taeuschen lassen. Seine Macht ist mir normalen "
        "Mitteln kaum zu brechen!!!"));
  SP(P_ARTICLE, 0);

  AddClass(CL_UNDEAD);
  SetProp(P_RACE, "Vampir");
  SetProp(P_NAME, "Nosferatu");
  SetProp(P_GENDER, MALE);
  AddId(({"vampir", "nosferatu"}));
  create_default_npc(99);
  SetProp(P_HANDS, ({" mit seinen langen Vampirkrallen", 1000,({DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -999);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  //  
  SetProp(P_NOMAGIC, 20);

  SP(P_INFO, BS(
        "Mit normalen Mitteln ist Nosferatu fuer Dich unbesiegbar!"));


  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.1,
DT_HOLY:0.1, DT_UNHOLY:-1.0]));

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "steigt aus dem Sarkophag");
  SetProp(P_MMSGOUT, "verschwindet im Nichts");
  SetProp(P_DIE_MSG,  BS(" bruellt auf und zerfaellt augenblicklich "
        "zu Staub! Er wurde erfolgreich gepfaehlt!"));

  SP(P_KILL_NAME, "Nosferatu, der Fuerst aller Vampire");
  SP(P_KILL_MSG, "Ich, Nosferatu, Meister aller Vampire, lebe ewig!!!");

  SP(P_MURDER_MSG, "Verflucht sei "+CAP(getuid(TP))+", "+CAP(getuid(TP))+" hat mich gepfaehlt!!!");

  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));


  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,100,
      "Nosferatu verflucht alle Lebenden!\n",
      "Nosferatu verflucht alle Lebenden!\n",
      DT_TERROR,"spell_all");

  SUID;
  if(!random(50))
    CLONEME(FO"vst");
  CLONEME(FA"nospan");

  "obj/pearlmaster"->DistributePearl(3, 4,1, 1);

  SP(P_TRANSPARENT, 0);


  ACD(({"pfaehle", "pfaehl"}), "try_kill");
  SetProp(P_AGGRESSIVE, 1);
}


init()  {
  ::init();
  if(interactive(TP)) {
    call_out("tag", 1); }}

    tag()  {
      if(environment(TO)!=environment(TP)) return;
      write(BSA(
            "Gegruesset seist Du, "+TPN+", die Sonne erblickst Du nie mehr!",
            "Nosferatu sagt: "));
    }



int try_kill(string str)  {
  object ha, p;
  NF("Wen willst Du pfaehlen?!\n");
  ha=present("VAMPIRHAMMER", TP);
  p=present("VAMPIRPFAHL", TP);
  if( (!ha)||(!p))  {
    write(
        "So kannst Du Nosferatu nie pfaehlen!\n"
        "Nosferatu zerfetzt Dich fast!\n");
    TP->do_damage(100);
    say(BS(
          TP->Name()+"wird von Nosferatu fast zerfetzt!"));
    return 1; }

    if(TP->QP(P_GHOST))  {
      write(BS(
            "Nein, als Geist geht das nicht!"));
      return 1; }
      if(TP->QP(P_FROG))  {
        write(BS(
              "Nein, als Frosch geht das nicht!"));
        return 1; }	

        if(str=="nosferatu"||str=="vampir")  {

          if(ha) {
            ha->remove();  }
          if(p)  {
            p->remove();  }
          write(BS(
                "Du setzt den Pfahl genau an der Brust von Nosferatu an und "
                "schlaegst dann mit aller Gewalt mit dem Hammer auf den Pfahl!!!"
                " Du triffst exakt das Herz und Blut schiesst in einer wilden "
                "Fontaene aus dem Vampir!!!"));

          tell_room(environment(TP),
              CAP_TPN+" setzt den Pfahl genau an der Brust von Nosferatu an und "
              "schlaegt\ndann mit aller Gewalt mit dem Hammer auf den Pfahl!!!\n"

              ""+CAP_TPN+" trifft exakt das Herz und Blut schiesst in einer wilden "
              "Fontaene aus dem Vampir!!!\n", ({TP}));
          say("\n");
          die();
          return 1; }
          return 0; }



          /*
             reset() {
             ::reset();
             say(BS(
             "Nosferatu verschwindet wieder woher er kam."));   	
             TO->move("/players/dante/workroom", M_GO+M_SILENT);
             remove();
             }	

*/


die(arg)
{
  write_file("/d/gebirge/dante/gruft/log/nosferatu",
      ctime()+": "+CAP(getuid(PL))+" killt Nos.\n");
  domainshout(BS(
        CAP_TPN+" hat den Fuerst aller Vampire, Nosferatu, gepfaehlt!!!"));
  ::die(arg);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;
  string r;
  if(killer!=TO) return;
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Ein Vampir");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+". "
        "Er wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId("vampir");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  r=player->QueryPrayRoom();
  if(!r || r=="" || r==0)
    r="/d/ebene/Midas/room/kapelle";
  ob->SetPrayRoom(r);
  ob->move(r,M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2





void spell_all(object enemy,int damage,mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=random((1000)+1000);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Nosferatu zerfetzt Dich in kleine Stueckchen!!!\n"));
  for(i=sizeof(inv)-1;i>=0;i--)
  {
    tell_object(inv[i], "Dein Ende ist nahe!!!\n");
    inv[i]->Defend(damage, dam_type,
        ([SP_SHOW_DAMAGE:1,SP_NAME:"Nosferatu"]), this_object());
  }
}

