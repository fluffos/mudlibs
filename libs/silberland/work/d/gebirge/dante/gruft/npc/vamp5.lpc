//dante sl 98 10
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein daemonischer Vampir");
  SetProp(P_LONG, BS(
        "Dieser Vampir ist zum Teil auch ein Daemon. Wie so ein Unwesen entsteht, "
        "weiss keiner niemand ausser seinem Schoepfer. Boesartig grinst er Dich an, "
        "der Vampir, nicht der Schoepfer."));
  AddClass(CL_UNDEAD);
  SetProp(P_NAME_ADJ, "daemonisch"); 
  SetProp(P_NAME, "Vampir");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Vampir");
  AddId(({"vampir"}));
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen daemonischen Vampirkrallen", 240+random(30) ,({DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_NOMAGIC, 10+random(3));



  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3, DT_UNHOLY:-1.0]));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");
  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,90);

  AddSpell(5,400,
      "Der Vampir spuckt Blut auf Dich.\n",
      "Der Vampir spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,700+random(100),
      "Der Vampir saugt Blut aus Dir.\n",
      "Der Vampir saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
      "Der Vampir versucht Dich zu zerfetzen.\n",
      "Der Vampir versucht @WEN zu zerfetzen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
      "Der Vampir schlaegt seine Zaehne in Deinen Hals.\n",
      "Der Vampir schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
      "Der Vampir schreit: BOESES BLUT.\n",
      "Der Vampir Schreit: BOESES BLUT.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
      "Der Vampir schreit: PROGRESSIVE PARALYSE.\n",
      "Der Vampir schreit PROGRESSIVE PARALYSE.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
        "Der Vampir schreit: ICH SAUGE DICH LEER !!!\n",
        "Der Vampir bruellt: Dein Blut ist mein!!!\n",
        "Der Vampir laeuft rot an...\n"}) );

  SUID;
  CLONEME(FO"keyvamp");
  CLONEME("/d/ebene/ronja/feenquest/obj/sball");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

