
//vampir mit dolch
//dante sl 98 10
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"


void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein roter, schleimiger Vampirghul");
  SetProp(P_LONG, BS(
        "Dieser Vampirghul ist ueber und ueber mit rotem Schleim bedeckt."));
  AddDetail("schleim",
      "Eklig!");
  SetProp(P_NAME_ADJ, ({"rot","schleimig"})); 
  SetProp(P_NAME, "Vampirghul");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Vampir");
  AddId(({"vampir","ghul","vampirghul"}));
  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen roten Vampirghulkrallen", 100+random(30) ,
        ({DT_POISON,DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  AddClass(CL_UNDEAD);
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 2+random(3));



  SetProp( P_RESISTANCE_STRENGTHS,([DT_UNHOLY:-1.0, DT_HOLY:0.7,
DT_COLD:-1.0]));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");
  SetProp(P_DIE_MSG,  " zerfaellt zu gruenem Schleim.\n");
  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  AI("klappe",
      "lacht Dich aus und grinst frech!");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,200,
      "Der Vampirghul spuckt Blut auf Dich.\n",
      "Der Vampirghul spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200+random(100),
      "Der Vampirghul saugt Blut aus Dir.\n",
      "Der Vampirghul saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,200,
      "Der Vampirghul versucht Dich zu zerfetzen.\n",
      "Der Vampirghul versucht @WEN zu zerfetzen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Vampirghul schlaegt seine Zaehne in Deinen Hals.\n",
      "Der Vampirghul schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,200,
      "Der Vampirghul schreit: BOESES BLUT.\n",
      "Der Vampirghul schreit: BOESES BLUT.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));


  SetAttackChats(10, ({
        "Der Vampirghul schreit: ICH SAUGE DICH LEER !!!\n",
        "Der Vampirghul bruellt: Dein Blut ist mein!!!\n",
        "Der Vampirghul laeuft rot an...\n"}) );
  ACD("oeffne", "nix", 1);
  SUID;
  CLONEME("/d/ebene/ronja/feenquest/obj/sball");
}


int nix()
{
  write("Der Vampirghul tritt Dich!\n");
  return 1;
}

