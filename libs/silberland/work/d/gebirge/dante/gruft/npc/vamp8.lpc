//dante sl 98 10
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp(P_SHORT, "Ein verwesender Vampirghul");
  SetProp(P_LONG, BS(
        "Der Vampirghul ist eine abscheuliche, halbverfaulte Kreatur, die "
        "niemals ihre Hoehlen verlaesst und jedes Licht scheut."));
  SetProp(P_NAME_ADJ, "verwesend"); 
  SetProp(P_NAME, "Vampirghul");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Vampir");
  AddId(({"vampir","ghul","vampirghul"}));
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen verwesten Vampirghulkrallen", 160+random(30) ,
        ({DT_POISON,DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_NOMAGIC, 5+random(3));



  SetProp( P_RESISTANCE_STRENGTHS,([DT_UNHOLY:-1.0, DT_HOLY:0.3,
DT_COLD:-1.0, DT_LIGHT:0.7]));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");
  SetProp(P_DIE_MSG,  " zerfaellt zu braunem Schleim.\n");
  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,300,
      "Der Vampirghul spuckt Blut auf Dich.\n",
      "Der Vampirgul spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300+random(100),
      "Der Vampirghul saugt Blut aus Dir.\n",
      "Der Vampirghul saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,200,
      "Der Vampirghul versucht Dich zu zerfetzen.\n",
      "Der Vampirghul versucht @WEN zu zerfetzen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Vampirghul schlaegt seine Zaehne in Deinen Hals.\n",
      "Der Vampirghul schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
      "Der Vampirghul schreit: BOESES BLUT.\n",
      "Der Vampirghul schreit: BOESES BLUT.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));


  SetAttackChats(10, ({
        "Der Vampirghul schreit: ICH SAUGE DICH LEER !!!\n",
        "Der Vampirghul bruellt: Dein Blut ist mein!!!\n",
        "Der Vampirghul laeuft rot an...\n"}) );

  AddInfo("skyta",
      "tritt Dich!\n");
  AddInfo(({"kreuz","vampirkreuz","vampirdrachenkreuz"}),
      "Das bekommst Du nur ueber meine Leiche, was ein Problem wird, "
      "denn ich bin ja bereits tot!\n", "lacht laut: ");

  SUID;
  CLONEME(FA"vkreuz");
  command("zieh alles an");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  command("iss leiche");
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

