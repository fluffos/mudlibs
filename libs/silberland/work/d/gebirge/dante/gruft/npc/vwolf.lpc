inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"


void init()  {
  ::init();
  if(!interactive(TP)) return;

  if(TP->QP(P_ALIGN)>800) {
    if(!random(2))  {
      write(BS(
            "Der Vampirwolf erkennt Deine gute Gesinnung und "
            "stuerzt sich auf Dich!"));
      Kill(TP);
    }
  }  
}

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp (P_SHORT, "Ein Vampirwolf");
  SetProp (P_LONG, BS(
        "Vor Dir steht nun einer der gefuerchteten Vampirwoelfe! Er fletscht seine "
        "langen, spitzen Zaehne und will nur eines, Dich toeten!"));

  SetProp (P_NAME, "Vampirwolf");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Vampir");
  AddId (({"wolf","vampirwolf"}));
  create_default_npc (16+random(3));
  SetProp (P_SIZE, 170);
  SetProp (P_HEAL, 5);




  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3]));

  SetProp(P_MSGIN, "schleicht zaehnefletschend herein");
  SetProp(P_MSGOUT, "schleicht zaehnefletschend");
  SetProp(P_MMSGIN, "schleicht knurrend herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/"));
  SetProp(P_MNPC_DEFAULTROOM, FR"pfad1");
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS+ MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({10, 5, 25}));  

  SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 160+random(20), ({DT_POISON,DT_RIP,DT_PIERCE}) }));
  SetProp (P_ALIGN, -500);

  SetChats(5, ({
        "Der Vampirwolf knurrt laut.\n",
        "Der Vampirwolf fletscht seine Zaehne.\n",	
        "Der Vampirwolf schleicht um Dich herum.\n",
        "Der Vampirwolf schnuppert nach Dir.\n",
        "Der Vampirwolf wuehlt im Boden.\n",
        "Der Vampirwolf kratzt sich.\n",
        "Der Vampirwolf sucht nach einem Opfer.\n" }) );


  AddSpell(5,200,
      "Der Vampirwolf will seine Zaehne in Dein Bein schlagen!\n",
      "Der vampirwolf will seine Zaehne in @WESSEN Bein schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));


  AddSpell(3,300,
      "Der Vampirwolf will seine Zaehne in Deinen Arm schlagen!\n",
      "Der vampirwolf will seine Zaehne in @WESSEN Arm schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));                                                                     

  SUID;
  CLONEME("/d/gebirge/dante/gruft/armour/vwfell.lpc");
  command("ziehe alles an");

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

