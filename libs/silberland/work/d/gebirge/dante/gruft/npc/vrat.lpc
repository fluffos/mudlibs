inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"


create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp (P_SHORT, "Eine Vampirratte");
  SetProp (P_LONG, BS(
        "Das ist eine der ekelhaften Vampirratten."));

  SetProp (P_NAME, "Vampirratte");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Vampir");
  AddId (({"ratte","vampirratte"}));
  create_default_npc (10);
  SetProp (P_SIZE, 100);
  SetProp (P_HEAL, -1-random(3));




  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3]));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in ihre Hoehle zurueck");
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/"));
  SetProp(P_MNPC_DEFAULTROOM, FR"loch8");
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS+ MOV_MOVES +MOV_INDOORS + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({30, 5, 35}));  

  SetProp (P_HANDS, ({" mit ihren Krallen", 70+random(20), ({DT_POISON,DT_RIP,DT_PIERCE}) }));
  SetProp (P_ALIGN, -500);

  SetChats(5, ({
        "Die Vampirratte huscht an Dir vorueber.\n",
        "Die Vampirratte schnuppert nach Dir.\n",
        "Die Vampirratte pinkelt Dir auf die Fuesse.\n",
        "Die Vampirratte wuehlt im Boden.\n",
        "Die Vampirratte kratzt sich.\n",
        "Die Vampirratte sucht nach Nahrung.\n" }) );

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

