//dante sl 98

inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <class.h>

int silverhit = 0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp(P_SHORT, "Ein Werwolf");
  SetProp(P_LONG, BS(
        "Vor Dir steht nun einer der gefuerchteten Werwoelfe! Er fletscht seine "
        "langen, spitzen Zaehne und will nur eines, Dich toeten!"));

  SetProp(P_NAME, "Werwolf");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Wolf");
  AddId (({"wolf","werwolf"}));
  create_default_npc (18+random(3));
  SetProp(P_SIZE, 170);
  SetProp(P_HEAL, 5);
  SetProp(P_HP_DELAY, 0);

  SetProp(P_AGGRESSIVE,([P_GUILD:(["Paladine":0.7, 0:0.3]) ]));

  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3, DT_HOLY:0.3]));

  SetProp(P_MSGIN, "schleicht zaehnefletschend herein");
  SetProp(P_MSGOUT, "schleicht zaehnefletschend");
  SetProp(P_MMSGIN, "schleicht knurrend herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");

  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/gruft/room/"));
  SetProp(P_MNPC_DEFAULTROOM, "/d/gebirge/dante/gruft/room/kreuzraum");
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS+ MOV_MOVES +MOV_INDOORS + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({5, 5, 25}));  


  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", 160+random(20), 
        ({DT_POISON,DT_RIP,DT_PIERCE}) }));
  SetProp(P_ALIGN, -500);

  SetChats(5, ({
        "Der Werwolf knurrt laut.\n",
        "Der Werwolf fletscht seine Zaehne.\n",	
        "Der Werwolf schleicht umd Dich herum.\n",
        "Der Werwolf schnuppert nach Dir.\n",
        "Der Werwolf wuehlt im Boden.\n",
        "Der Werwolf kratzt sich.\n",
        "Der Werwolf sucht nach einem Opfer.\n" }) );

  AddSpell(5,200,
      "Der Werwolf will seine Zaehne in Dein Bein schlagen!\n",
      "Der Werwolf will seine Zaehne in @WESSEN Bein schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,300,
      "Der Werwolf will seine Zaehne in Deinen Arm schlagen!\n",
      "Der Werwolf will seine Zaehne in @WESSEN Arm schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));                                                                     

  SUID;
  CLONEME("/d/gebirge/dante/gruft/armour/wwfell.lpc");
  command("ziehe alles an");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{ 
  object weapon;
  if (!spell)
  { 
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
    {
      dam*=2;
      silverhit = 1;
    }
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

void heart_beat()
{
  ::heart_beat();
  if (!silverhit)
    AddHp(1 + random(QueryProp(P_LEVEL)));
}
