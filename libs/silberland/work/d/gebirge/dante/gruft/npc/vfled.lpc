// fledermaus
//dante sl 99 98 
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../gruft.h"
#include <class.h>

#include <new_skills.h>

#include "check_bard_item.h"

create()
{

  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp(P_SHORT, "Eine grosse, schwarze, Vampirfledermaus");
  SetProp(P_LONG, BS(
        "Die Vampirfledermaus ist ein gefaehrlicher Blutsauger."));
  SetProp(P_NAME, "Vampirfledermaus");
  SetProp(P_RACE, "Vampir");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"gross", "schwarz"}));
  AddId(({"fledermaus","vampirfledermaus","vampir"}));

  create_default_npc(12+random(4));
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen",130,({DT_RIP,DT_POISON,DT_PIERCE}) }));
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0, T_RANGE_MAX:45]));   
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "verschwindet in der Dunkelheit");
  SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY:0.3,DT_COLD:-1.0,DT_UNHOLY:-1.0,
DT_TERROR:-1.0]));

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Vampirfledermaus will Deine Sachen nicht.\n" }) );


  SUID;
  CLONEME(FO"vflu");

  SetProp(P_SPELLRATE,30);
  AddSpell(5, 250,
      "Die Vampirfledermaus zerkratzt Dein Gesicht.\n",
      "Die Vampirfledermaus zerkratzt @WESSEN Gesicht.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
      "Die Vampirfledermaus schlaegt ihre spitzen Zaehne in Deinen Hals.\n",
      "Die Vampirfledermaus schlaegt ihre spitzen Zaehne in @WESSEN Hals.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
        "Die Vampirfledermaus schwirrt um Dich herum.\n",
        "Die Vampirfledermaus haengt von der Decke herab.\n",
        "Die Vampirfledermaus stoesst schrille Laute aus.\n",
        "Die Vampirfledermaus bleckt ihre spitzen Zaehne.\n",
        "Die Vampirfledermaus faengt eine kleine Spinne.\n",
        "Die Vampirfledermaus scheint Dich zu beobachten.\n",
        "Die Vampirfledermaus flattert aufgeregt umher.\n"}) );

  SetAttackChats(10, ({
        "Die Vampirfledermaus versucht sich in Dein Haar zu krallen.\n",
        "Die Vampirfledermaus stoesst schrille Laute aus.\n",
        "Die Vampirfledermaus will Dein Gesicht zerfetzen.\n",
        "Die Vampirfledermaus stuerzt sich von oben auf Dich.\n"}) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

