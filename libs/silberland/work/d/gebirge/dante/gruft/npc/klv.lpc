//dante sl 98 99
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die schoene Vampira");
  SetProp(P_LONG, BS(
        "Vor Dir siehst Du Vampira. Einen weiblichen Vampir. Sie sieht "
        "sehr schoen aus und betoert Dich fast. Du hast Skrupel sie "
        "zu toeten, doch wenn Du es nicht tust, wird sie Dich toeten!"));
  SP(P_ARTICLE, 0);

  AddClass(CL_UNDEAD);
  SetProp(P_RACE, "Vampir");
  SetProp(P_NAME_ADJ, "wunderschoen"); 
  SetProp(P_NAME, "Vampira");
  SetProp(P_GENDER, FEMALE);
  AddId(({"vampir", "vampira"}));
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren schoenen Vampirkrallen", 170+random(30) ,({DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_NOMAGIC, 5);



  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3, DT_UNHOLY:-1.0]));

  SetProp(P_MSGIN, "wandelt bezaubernd herein");
  SetProp(P_MSGOUT, "wandelt bezaubernd");
  SetProp(P_MMSGIN, "steigt aus dem Sarg");
  SetProp(P_MMSGOUT, "steigt in ihren Sarg hinein");
  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,90);

  AddSpell(5,400,
      "Vampira spuckt Blut auf Dich.\n",
      "Vampira spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500+random(100),
      "Vampira saugt Blut aus Dir.\n",
      "Vampira saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
      "Vampira versucht Dich zu zerfetzen.\n",
      "Vampira versucht @WEN zu zerfetzen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
      "Vampira schlaegt seine Zaehne in Deinen Hals.\n",
      "Vampira schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
      "Vampira schreit: BOESES BLUT.\n",
      "Vampira schreit: BOESES BLUT.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
        "Vampira schreit: ICH SAUGE DICH LEER !!!\n",
        "Vampira bruellt: Dein Blut ist mein!!!\n",
        "Vampira ist wunderschoen!\n",
        "Vampira sagt: Komm! Ich kuesse Dich!\n",
        "Du liebst Vampira!\n",
        "Vampira macht Dir schoene Augen!\n"}) );

  SUID;
  CLONEME(FO"k1");

}


reset() {
  ::reset();
  say(BS(
        "Vampira verschwindet wieder woher sie kam."));   	
  remove();
}	



