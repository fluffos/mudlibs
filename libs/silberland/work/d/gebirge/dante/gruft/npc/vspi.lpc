//dante sl 98

inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>

#include "check_bard_item.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp (P_SHORT, "Eine Vampirspinne");
  SetProp (P_LONG, BS(
        "Das ist eine der ekelhaften Vampirspinnen."));

  SetProp (P_NAME, "Vampirspinne");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Vampir");
  AddId (({"vampirspinne","spinne"}));
  create_default_npc (10);
  SetProp (P_SIZE, 100);
  SetProp (P_HEAL, -1-random(3));




  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3]));

  SetProp(P_MSGIN, "krabbelt lauernd herein");
  SetProp(P_MSGOUT, "krabbelt lauernd");
  SetProp(P_MMSGIN, "krabbelt lauernd herein");
  SetProp(P_MMSGOUT, "krabbelt in ihre Hoehle zurueck");
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/gruft/room/"));
  SetProp(P_MNPC_DEFAULTROOM, FR"gruft1");
  SetProp(P_MNPC_FLAGS, MOV_MOVES +MOV_INDOORS + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({10, 5, 5}));  

  SetProp (P_HANDS, ({" mit ihren Zangen", 70+random(20), ({DT_POISON,DT_RIP,DT_PIERCE}) }));
  SetProp (P_ALIGN, -100);

  SetChats(5, ({
        "Die Vampirspinne beobachtet Dich.\n",
        "Die Vampirspinne krabbelt herum.\n",
        "Die Vampirspinne krabbelt naeher an Dich heran.\n",
        "Die Vampirspinne wuehlt im Boden.\n",
        "Die Vampirspinne kratzt sich.\n",
        "Die Vampirspinne sucht nach Nahrung.\n" }) );

}
