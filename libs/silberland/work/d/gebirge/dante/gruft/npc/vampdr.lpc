//vampirdrache hat ring
//dante sl 98 -99

inherit "/p/std/dragons/dragon";
#include <wizlevels.h>       
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../gruft.h"

/*
   Dieser Drache mag nicht so stark und ausdauernd sein wie z.b der skeldrache
   oder der zombiedrache, aber seine spells habens in sich!!!
   */


void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  create_default_dragon(3,9+random(2),0,27+random(10));            
  SetProp(P_SHORT, "Skyta, der Vampirdrache");
  SetProp(P_LONG, BS(
        "Das ist der beruehmte Vampirdrache Skyta, ein hinterhaeltiges Wesen. "
        "Er hat die Form eines grossen Vampirs, nur der Kopf ist der "
        "eines Drachen. Er zuckt ruckartig vor Dir hin und her und koennte "
        "jeden Moment angreifen..."));
  SetProp(P_NAME, "Skyta");

  set_living_name("skyta");

  AddSpecialDetail(({"kopf","koerper","wesen"}), "d_kill");
  AddId(({"drache", "vampirdrache","skyta", "vampir"}));
  SetProp(P_ARTICLE, 0);
  SP(P_NAME_ADJ, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0, T_RANGE_MAX:30]));
  SetProp(P_INFO, "Skytas Ring ist sehr maechtig!\n");
  SetProp( P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_HOLY:0.2,DT_COLD:-1.0,DT_UNHOLY:-1.0,
     DT_TERROR:-1.0, DT_SLASH: 0.2, DT_LIGHT:0.4]));

  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0.4);
  SetProp(P_MSGIN, "kriecht fauchend herein");
  SetProp(P_MSGOUT, "kriecht fauschend");
  SetProp(P_MMSGIN, "kriecht fauchend herein");
  SetProp(P_MMSGOUT, "schlaengelt davon");

  SetProp(P_DIE_MSG,  " zuckt noch einmal auf und stirbt dann laut bruellend!\n");


  AddClass(CL_UNDEAD);

  SetProp(P_MURDER_MSG, "Verflucht sei alles Leben!!! Und Du auch!");
  SetProp(P_KILL_NAME, "Skyta, der Vampirdrache");
  SetProp(P_KILL_MSG, "Wieder ein Lebender weniger! Der naechste bitte! Ich bin in Topform, ihr Penner!\n");

  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  SUID;
  CLONEME(FA"vampring");
  CLONEME(FA"vkrallen");

  AddInfo(DEFAULT_INFO, "zischt laut!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
        "Was soll Skyta damit?!\n" }) );


  "obj/pearlmaster"->DistributePearl(2, 4,1, 1);

  SP(P_SPELLRATE, 50);

  AddSpell(3,100,
      "Skyta macht eine seltsame Bewegung um Dich herum.\n",
      "Skyta macht eine seltsame Bewegung um @WEN herum.\n",
      DT_MAGIC,"spell_magic");

  AddSpell(2, 300,
      "Skyta macht seine Todesrolle.\n",
      "Skyta macht seine Todesrolle.\n",
      DT_UNHOLY, "spell_all");

  AddSpell(2, 100,
      "Skyta fixiert Dich mit seinen Augen!!!\n",
      "Skyta fixiert @WEN mit seinen Augen!!!\n",
      DT_TERROR, "spell_para");
  AddSpell(2, 1,
      "SKYTA MACHT SEINEN ULTIMATIVEN TODESANGRIFF!!!\n",
      "SKYTA MACHT SEINEN ULTIMATIVEN TODESANGRIFF auf @WEN!\n",
      DT_TERROR, "spell_die"); 
  AddClass(CL_UNDEAD);
  SetAttackChats(5,({
        "Skyta baut sich vor Dir auf.\n",
        "Du weichst ein Stueck zurueck.\n",
        "Skyta schlaengelt wild umher.\n",
        "Skyta zuckt schnell herum.\n",
        "Skyta speit etwas Feuer.\n",
        "Skyta grinst Dich boese an.\n"}));


} 



void spell_para(object enemy,int damage,mixed dam_type)
{

  if(!random(4))  {
    tell_object(enemy,    
        "Skyta trifft Dich genau am Kopf!\n"
        "Dir schwinden die Sinne!\n");
    enemy->SetProp(P_PARALYZED, ([
          PARALYZE_TIME: random(8),
          PARALYZE_MSG: "Aber Du bist doch bewusstlos!\n",
          PARALYZE_MSG_OTHER: "",
          PARALYZE_END: "Du erwachst wieder aus Deiner Bewusstlosigkeit.\n",
          PARALYZE_END_OTHER: "%s erwacht wieder aus "
            +TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)
            +" Bewusstlosigkeit.\n"]));
  }
  else  {
    tell_object(enemy,
        "Du widerstehst den Blicken Skytas!\n");  }}



void spell_die(object enemy, int damage, mixed dam_type)
{
  object rue;
  rue=present("VKREUZ", enemy);

  if ((rue)&&(rue->QueryProp(P_WORN)==enemy))
  {
    tell_object(enemy,
        BS("Dein Vampirdrachenkreuz rettet Dich vor dem sicheren Tod und schenkt "
          "Dir etwas neue Kraft!!!"));
    enemy->heal_self(25+random(25));
  }
  else
  {

    switch(random(10))  {
      case 0:
        tell_object(enemy,
            "Deine Ausruestung ist nicht in der Lage diesen Angriff abzuwehren!\n"
            "Irgendetwas fehlete da wohl...\n"
            "Skytas Angriff toetet Dich sofort!\n");

        enemy->die();
        shout("Skytas ultimativer Todesangriff hat "+enemy->name()+" zerfetzt!\n");
        break;
      case 1..9:
        tell_object(enemy,
            BS("Skytas Todesabgriff geht hauchduenn an Dir vorbei! Dir scheint "
              "etwas wichtiges zu fehlen!!! Du hattest enormes Glueck!!!"));
        break;
      default: write("\n");
    }
  }

}


void spell_all(object enemy,int damage,mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=random(900)+900;
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Skyta zerfetzt Dich in kleine Stueckchen!!!\n"));
  for(i=sizeof(inv)-1;i>=0;i--)
  {
    tell_object(inv[i], "Dein Ende ist nahe!!!\n");
    inv[i]->Defend(damage, dam_type,
        ([SP_SHOW_DAMAGE:1,SP_NAME:"Skyta"]), this_object());
  }
}



string d_kill()
{
  write("Skyta hasst es, betrachtet zu werden!\n"
      "Bruellend stuerzt er sich auf Dich!\n");
  say(CAP_TPN+" begeht einen Fehler!\n");
  TO->Kill(TP);
  return "";
}




die(arg)
{
  write_file("/d/gebirge/dante/gruft/log/skyta.kills",
      ctime()+": "+CAP(getuid(PL))+" killt Skyta.\n");

  write("Skytas Blut spritzt genau in Dein Gesicht!\n"
      "Welch Wunder! Es heilt Dich total!\n");
  say(CAP_TPN+" wird mit Skytas Blut besudelt.\n");
  TP->heal_self(300);
  ::die(arg);
}


int Defend(int dam, string* dtype, int spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (sizeof(dtype & ({ DT_COLD }) ))

  {
    tell_room(environment(), "Skyta lacht Dich aus!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  }         

  /*


     if (sizeof(dtype & ({ DT_SLASH }) ))

     {
     tell_room(environment(), "Skyta macht das wenig aus!!!!\n");
     return ::Defend(0, dtype, spell, enemy);
     }         


*/


  if (sizeof(dtype & ({ DT_UNHOLY }) ))

  {
    heal_self(dam*3);
    tell_room(environment(), "Skyta fraut sich sehr!!!\n");
    return ::Defend(0, dtype, spell, enemy);
  }         


  return ::Defend(dam, dtype, spell, enemy);
}





void spell_magic(object enemy,int damage,mixed dam_type)

{
  switch(random(30))
  {
    case 0:
      tell_object(enemy,
          "Ploetzlich brennen Deine Augen!\n");
      enemy->SetProp(P_BLIND, 60);
      break;
    case 1: 
      tell_object(enemy,
          "Du fuehlst Dich sehr, sehr schwach!\n");
      enemy->AddPoison(random(3));
      break;
    case 2:
      enemy->SetProp(P_FROG, 1);
      tell_object(enemy,
          "Du schrumpfst auf einmal zusammen und wirst gruen!\n");
      break;
    case 3:
      tell_object(enemy,
          "Du bist unglaublich feige!\n");
      enemy->SetProp(P_WIMPY, 200);
      break;
    case 4:
      tell_object(enemy,
          "Willst Du fluechten?\n");
      enemy->command("fluchtrichtung tot");
      break;
    case 5:
      tell_object(enemy,
          "Skyta heilt sich selbst ein wenig!\n");
      TO->heal_self(75);
      break;
    case 6:
      tell_object(enemy,
          "Skyta heilt sich selbst!\n");
      TO->heal_self(150);
      break;
    case 7:
      enemy->restore_spell_points(-50);
      tell_object(enemy,
          "Deine Magie schwindet!\n");
      break;
    case 8:
      tell_object(enemy,
          "Deine Magie loest sich total auf.\n");
      enemy->restore_spell_points(-1000);
      break;
    case 9:
      tell_object(enemy,
          "Etwas Blut spritzt von Skyta auf Dein Gesicht!\n"
          "Welch Wunder! Es heilt Dich!\n");
      enemy->heal_self(100);
      break;
    case 10..29:
      tell_object(enemy,
          "Du widerstehst dem Angriff von Skyta!!!\n");
      break;
    default:write("BUG!\n");
  }
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;  
  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SP(P_NAME,  "Vampir "+CAP(getuid(player))+"");
  ob->SP(P_ARTICLE, 1);
  ob->SP(P_SHORT, "Der Vampir "+CAP(getuid(player))+"");
  ob->SP(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+", "
        ""+player->QueryPronoun(WER)+" wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SP(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SP(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SP(P_BODY, player->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  ob->move("/d/ebene/Midas/room/kapelle",M_GO,
      "", "", "steigt aus der Erde heraus");
}
