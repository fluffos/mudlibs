/*
   das geruest fuer den spielervampir


*/


inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>
#include <npcmaster.h>

string pray_room;

#include "check_bard_item.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Vampir");
  AddId (({"vampir", "plv"}));
  create_default_npc(10);//eh egal

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "steigt in die Erde hinab");
  SetProp(P_MNPC_AREA, ("/"));
  SetProp(P_MNPC_DEFAULTROOM, "/d/gebirge/dante/friedhof/room/pfad2");
  SetProp(P_MNPC_FLAGS, MOV_MOVES +MOV_OUTDOORS+MOV_SPECIAL+
      MOV_INDOORS + MOV_BACKWARDS+MOV_INFIGHT);
  SetProp(P_MNPC_WAIT, ({10, 10, 10}));  
  SetProp (P_ALIGN, -500);
  SetProp(P_ARTICLE, 0);
  pray_room="/d/ebene/Midas/room/kapelle";


  SetProp(P_KILL_NAME, "Der Vampir eines toten Spielers");
  SetProp(P_MURDER_MSG, "Wir Untoten sterben nie! Alles ist nur Illusion! Nosferatu wird mich raechen!");
  SetProp(P_KILL_MSG, "Ich wurde geboren durch den Tod eines Spielers und toete nun selbst Spieler!");
  SetProp(P_NO_SCORE, 1);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;
  string r;
  if(killer!=TO) return;

  write_file("/d/gebirge/dante/friedhof/log/text.lpc",
      ctime()+": "+TO->QP(P_SHORT)+" ermordete "+CAP(getuid(player))+"! R.I.P.\n");
  TO->heal_self(1000);
  ob=clone_object("/d/gebirge/dante/gruft/npc/plv");
  ob->SetProp(P_NAME,  "Vampir");
  ob->SetProp(P_ARTICLE, 1);
  ob->SetProp(P_SHORT, "Ein Vampir");
  ob->SetProp(P_LONG, BS("Das ist der untote Vampir von "+CAP(getuid(player))+". "
        "Er wurde von "+TO->name(WEM)+" umgebracht und muss nun "
        "hier fuer immer herumlaufen!"));
  ob->SetProp(P_ATTRIBUTES, player->QP(P_ATTRIBUTES));
  ob->SetProp(P_LEVEL, player->QP(P_LEVEL)/2);
  ob->SetProp(P_HANDS, player->QP(P_HANDS));
  ob->AddId(""+getuid(player)+"");
  ob->SetProp(P_BODY, player->QP(P_LEVEL)*2);
  ob->SetProp(P_MAX_HP, player->QP(P_MAX_HP)*2);
  //vor anschlusss aendern!!!!!!!!!!
  r=player->QueryPrayRoom();
  if(!r || r=="" || r==0)
    r="/d/ebene/Midas/room/kapelle";
  ob->SetPrayRoom(r);
  ob->move(r,M_GO,
      "", "", "steigt aus der Erde heraus");
  NAL1
}
NAL2

string SetPrayRoom(string str)
{
  pray_room=str;
}

string QueryPrayRoom()
{
  if (pray_room) return pray_room;
  else return "/d/ebene/Midas/room/kapelle";
}

_set_max_hp(int max_hp)
{
  Set(P_MAX_HP, max_hp);
  SetProp(P_XP, QP(P_HANDS)[1]*max_hp*5);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
      dam= 3*dam/2;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

