inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../gruft.h"
#include <mnpc.h>
#include <class.h>
#include <wizlevels.h>

#include "check_bard_item.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SP(P_NAME, "Vampir");
  SP(P_SHORT, "Ein Vampir");

  AddClass(CL_UNDEAD);
  SetProp(P_RACE, "Vampir");
  SetProp(P_GENDER, MALE);
  AddId(({"vampir"}));
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Vampirkrallen", 180+random(30) ,({DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_NOMAGIC, 5+random(3));



  SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
DT_HOLY:0.3, DT_UNHOLY:-1.0]));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");


  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);
  AddInfo(DEFAULT_INFO, "sagt: STIRB!!!!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Ich will nur Dein Blut!!! Und nicht @WEN!!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,200,
      "Der Vampir spuckt Blut auf Dich.\n",
      "Der Vampir spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300+random(100),
      "Der Vampir saugt Blut aus Dir.\n",
      "Der Vampir saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,200,
      "Der Vampir versucht Dich zu zerfetzen.\n",
      "Der Vampir versucht @WEN zu zerfetzen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Vampir schlaegt seine Zaehne in Deinen Hals.\n",
      "Der Vampir schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
        "Der Vampir schreit: ICH SAUGE DICH LEER !!!\n",
        "Der Vampir bruellt: Dein Blut ist mein!!!\n",
        "Der Vampir laeuft rot an...\n"}) );


}

init()  {
  ::init();

  if(interactive(TP))  {
    if(TP->QP(P_INVIS)==0)  {
      SP(P_NAME, ""+CAP_TPN+"vampir");
      SP(P_SHORT, "Ein "+CAP_TPN+"vampir");
      SP(P_LONG, BS( "Dieser Vampir sieht "+TPN+" verdammt aehnlich. Seltsam?!"));
    }}

}

