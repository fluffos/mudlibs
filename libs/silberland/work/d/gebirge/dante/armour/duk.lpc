//dukantha schaedel
inherit "std/armour";

#include "files.h"
#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schaedel", "totenschaedel","dukanthas schaedel"}));
  SetProp (P_SHORT, "Der Schaedel einer Dukantha");
  SetProp (P_LONG,BS(
  "Das ist der Schaedel einer Dukantha. Man kann ihn aufsetzen."));
  SetProp (P_NAME, "Dukanthaschaedel");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_VALUE, 4000);
  SetProp(P_RESISTANCE, ({DT_TERROR, DT_BLUDGEON}));
  SetProp (P_INFO, ("Der Schaedel hilft gegen Schreckensangriffe.\n"));
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
    SetProp (P_MATERIAL, MAT_BONE); 
  SetProp (P_AC, 14);
}

