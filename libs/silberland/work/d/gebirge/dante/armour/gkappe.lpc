//geisterkappe fuer quest

inherit "std/armour";

#include "files.h"
#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"kappe", "geisterkappe","gkappe"}));
  SetProp (P_SHORT, "Eine Geisterkappe");
  SetProp (P_LONG, BS(
  "Das ist eine echte Geisterkappe. Sie ermoeglicht es Lebenden ins Reich "
  "der Geister vorzudringen. Diese Kappe gehoerte einst dem Geist von Krath, "
  "der sie einem ungluecklichen Abenteurer abgenommen hat."));
  SetProp (P_NAME, "Geisterkappe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 1);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
    SetProp (P_MATERIAL, MAT_MAGIC); 
  SetProp (P_AC, 1);
  SetProp(P_NEVERDROP, 1);
}


