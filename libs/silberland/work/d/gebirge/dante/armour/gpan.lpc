//
inherit "std/armour";
#include <attributes.h>    
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "files.h"
#include <new_skills.h>     
#include <combat.h>     

object wer;
int krunden, vrunden,zufall2, zufall;

create()
{
  if (!is_clone(this_object()))
     return;
   ::create();
krunden=0;
vrunden=0;
zufall=random(10)+10;
zufall2=random(15)+15;
  AddId (({"gpan","satanischer helm","geisterhelm","helm"}));
  SetProp (P_SHORT, "Ein satanischer Geisterhelm");
  SetProp (P_LONG, BS(
  "Das ist einer der beruehmten und beruechtigen santanischen Geisterhelme. "
  "Er besteht aus schwarzem Metall, das ab und zu blutrot aufblitzt. Irgendwie "
  "scheint das Metall lebendig zu sein, denn machmal glaubst Du, dass es sich bewegt "
  "und traege hin und her fliesst."));
  SetProp (P_NAME, ({"der satanische Geisterhelm",
  "des satanischen Geisterhelm", 
  "dem satanischen Geisterhelm",
  "den satanischen Geisterhelm"}));
  SetProp (P_GENDER, MALE);
   SetProp (P_ARMOUR_TYPE, AT_HELMET);  
    SetProp(P_WC, 0);
  SetProp(P_ARTICLE, 0);
  SetProp (P_WEIGHT, 600);
 SetProp(P_INFO, ("Der satanische Geisterhelm wehrt ab und zu Schlaege ab und "
"manchmal koennen auch blutrote Lichtblitze die Gegner seines Traegers treffen.\n"));
  
  SetProp (P_VALUE, 6000);
  SetProp (P_MATERIAL,({ MAT_MAGIC, MAT_TITANIUM, MAT_CHROMIUM, MAT_MISC_LIVING,
  MAT_GHOST}));
    SetDefendFunc (TO);   
  SetProp (P_AC, 15);
  SetProp(P_RESISTANCE, ({DT_AIR,DT_FIRE,DT_TERROR,DT_MAGIC}));
  SetWearFunc (TO); 
  }
  
  int WearFunc()
  {
  wer=TP;
  return 1;
  }
  
  
   DefendFunc (string *dtype,mixed spell, object enemy)
    {
    object spieler;
     if(!objectp(spieler = MENV)) return 0;   
    vrunden++;
    krunden++;
    if(krunden>=zufall2)
    {
    tell_object(wer,
    "Der Helm blitzt auf und grelle Blitze treffen "+enemy->name(WEM, RAW)+"!\n");
     enemy->Defend( random(1500) ,DT_LIGHTNING, 
     ([SP_NAME: "ein satanischer Geisterhelm", SP_SHOW_DAMAGE:1]),
    spieler);
    SetProp(P_KILLER, "Ein satanischer Geisterhelm!\n");
    call_out("neu2", 0);
    }

    if(vrunden>=zufall)
      {
      call_out("neu", 0);
      tell_object(wer,
      "Der Helm blitzt auf und vernichtet den Angriff von "+enemy->name(WEM, RAW)+"!\n");
      return 1000;
      }
    else
    return 0;
    }
               
void neu()
{
vrunden=0;
zufall=random(10)+10;
}

void neu2()
{
krunden=0;
zufall2=random(15)+15;
}

 