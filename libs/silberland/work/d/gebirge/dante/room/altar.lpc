
//im altar

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


int hier=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Altar" );
  SetProp( P_INT_LONG, BS(
"Du bist nun im Inneren des hohlen Altar. Alles besteht aus Blutmarmor. Die "
"Waende, die Decke, der Boden. Ein sehr kleines Portal fuehrt wieder zurueck "
"auf den kleinen Friedhof."));

AddDetail("altar",
"Du bist im Altar...");
AddDetail("portal",
"Das Portal fuehrt Dich wieder auf den Friedhof zurueck.");
AddDetail(({"inneres", "innen","inneren"}),
"Du stehst hier im hohlen Altar, der mittem am kleinen Friedhof steht.");
AddDetail("friedhof",
"Der Friedhof ist drausse.");
AddDetail(({"blutmarmor","marmor"}),
"Der Blutmarmor is kuehl und glatt. Rote Linien durchziehen ihn.");
AddDetail(({"linie","linien"}),
"Die Linien scheinen ein Muster zu bilden.");
AddDetail("decke",
"Die Decke besteht aus Blutmarmor.");
AddDetail("boden",
"Der Boden besteht aus weissem Blutmarmor.");
AddDetail(({"wand","waende"}),
"Die Waende bestehen aus Marmor. Rote Linien durchziehen den Marmor.");
AddDetail("muster",
"Das Muster sieht irgendwie einem Geist aehnlich.");
AddDetail("geist",
"Der Geist is kein gewoehnlicher Geist. Es handelt sich hierbei um "
"einen sehr boesen und maechtigen Geist. Angeblich soll er "
"alles Boese dieser Welt verkoerpern...");
AddDetail("boese",
"Nun erst bemerkst Du ein Flimmern in der Luft.");
AddDetail("luft",
"Hier ist es kuehl und irgendwie doch voller Spannung.");
AddDetail("spannung",
"Du kannst das Boese direkt fuehlen!");
AddDetail("flimmern",
"Die Luft surrt und flimmert vor Dir hin und her. Vielleicht solltest "
"Du diese Luft einmal tief einatmen?!");
AddDetail("welt",
"Unsere Welt!");

  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );//cave aendern
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Blut.");
AddExit("raus", "./k0");
AddCmd(({"atme"}), "come");
}

int come(string str)
  {
  notify_fail("Was willst Du hier einatmen?!\n");
  if(str=="luft" ||str=="luft ein"||str=="luft tief ein")
    {
    if(present("TG", environment(TP) ) )
      {
      write("Der satanische Geist lacht Dich aus!\n");
      return 1;
      }
  
  if(!hier)
    {
    write("Du atmest die Luft tief ein, aber nichts passiert...\n");
    return 1;
    }
    if(hier)
    {
    hier--;
     call_other("d/gebirge/dante/obj/anzahl", "einermehr");
     write("Du atmest die Luft tief ein und vor Dir erscheint...\n");
    return 1;
    }
   return 0;
   }
return 0;
}
    
reset()
  {
  ::reset();
  hier=1;
  }
      