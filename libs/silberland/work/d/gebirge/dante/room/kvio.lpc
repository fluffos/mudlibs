//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>
int frage;

create()
{
  ::create();
  
frage=random(5)+1;
  
  SetProp( P_INT_SHORT, ""+ANSI_BOLD+ANSI_PURPLE+"In einer violetten Kammer" );
  SetProp( P_INT_LONG, BS(
   ""+ANSI_BOLD+ANSI_PURPLE+"Hier ist alles violett, aber das ist ja "
   "nichts neues fuer Dich. Wand, Decke und Boden. Alles violett."));

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst alles sehr violett.");
AddItem("d/gebirge/dante/npc/kmvio", REFRESH_DESTRUCT);
    AddDetail("kammer",
    "Die violette Kammer.");
    AddDetail("decke",
    "Die Decke ist violett.");
    AddDetail("boden",
    "Violett.");
    AddDetail(({"wand", "waende"}),
    "Die Waende sind violett. ");
    
    AddCmd("raetsel", "show");
    AddCmd("loesung", "loesung");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach violett...");
    AddSpecialExit("sueden", "nix");
 }


    int show()
       {
       write("syntax: loesung <antwort>\n");
       if(frage==1)
       {
       write("Ich bin aus Holz und hier der Boss.\n");
       return 1;
       }
       
       if(frage==2)
       {
       write("Ich bin der hoechste, maennliche Zwerg.\n");
       return 1;
       }
   
       if(frage==3)
       {
       write("Ich bin der hoechste, weibliche Zwerg.\n");
       return 1;
       }
   
       if(frage==4)
       {
       write("Ich bin sehr staubig und Deine Chefin.\n");
       return 1;
       }
       
       if(frage==5)
       {
       write("Ich bin der attraktivste in dieser Welt.\n");
       return 1;
       }
  return 0;
  }                                

    int loesung(string str)
       {
       notify_fail("Nein, leider falsch! Probiers weiter!\n");
       if (!str) return 0;
       
       if((str=="woody")&&(frage==1))
       {
       call_out("out");
       return 1;
       }
       
       if((str=="angrox")&&(frage==2))
       {
       call_out("out");
       return 1;
       }
        
       if((str=="dusty")&&(frage==3))
       {
       call_out("out");
       return 1;
       }
    
       if((str=="dusty")&&(frage==4))
       {
       call_out("out");
       return 1;
       }
      
       if((str=="eros")&&(frage==5))
       {
       call_out("out");
       return 1;
       }
   return 0;
   }
   
   void out()
     {
     frage=random(5)+1;
     TP->move("d/gebirge/dante/room/k14", M_GO+M_SILENT);
     }
    
    
    reset()
      {
      ::reset();
      frage=random(5)+1;
      }
            

  string nix()
    {
    notify_fail("Als Du die Kammer verlassen willst, sagt eine Stimme:\n"
    "Nein, so einfach kommst Du hier nicht raus!\n"
    "Zuerst spielen wir ein Spiel, und zwar: Wer bin ich?\n"
    "Tippe: raetsel\n");
    return 0;
    }
    
    