//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer geheimen Kammer" );
  SetProp( P_INT_LONG, BS(
  "Du stehst in einer extrem kleinen Kammer, umgeben von kaltem Stein. "
  "Die Decke ist so niedrig, das sie Dich fast erdrueckt. Die Waende "
  "scheinen zusammenruecken zu wollen, um Dich fuer immer zu begraben.\n"
  "Eine schwarze Tafel.\n"));
// AddSpecialDetail("tafel", "who");
//hier kommt ne arthighscore hin wer wie tief runter kommt

  AddDetail(({"wand", "waende"}),
  "Du bekommst Angst, hier zerquestscht zu werden.");
  AddDetail("angst",
  "Brauchst Du nicht haben!");
  AddDetail("stein",
  "Kalt, grau und hart. In gewissen Abstaenden siehst Du seltsame "
  "Umrisse.");
  AddDetail(({"abstand", "abstaende"}),
  "Hmm, schwer abzuschaetzen...");
  AddDetail("boden",
  "Der Boden ist hart und teilweise schwarz verbrannt.");
  AddDetail("decke",
  "Die Decke ist extrem niedrig und auch aus Stein.");
  AddDetail("kammer",
  "Du stehst drinnen.");
  
  AddDetail(({"umriss", "umrisse"}),
  "Die sehen eher wie Schatten aus.");
  AddDetail("schatten",
  "Die Schatten haben sich in den Stein gebrannt. Ab und zu werden hier "
  "naemlich Spieler aus der Tiefe durch den Stein hervorgedrueckt. "
  "Einer der Schatten sieht wie grosses schwarzes Loch aus.");
  AddDetail("loch",
  "Das Loch ist gross und dunkel. Hmm, irgendwie kann man da rein...");
  
  AddDetail("spieler",
  "Die Spieler ersparen sich so einen grossen Umweg.");
  AddDetail("umweg",
  "Aus der Tiefe hierher...");
  AddDetail("tiefe",
  "Die Hoehlen hier sollen extrem tief sein.");
  AddDetail(({"hoehlen", "hoehle"}),
  "Du stehst mitten drin.");
    
  

  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Eigentlich riecht es hier nach nichts.");
    
  AddExit("sueden", "./fkammer");
  AddItem("/d/gebirge/dante/npc/kmt", REFRESH_DESTRUCT);
  
  AddCmd(({"betritt","springe","betrete","kletter","steige","spring"}), "weg");  
 }

 int weg(string str)
  {
  notify_fail("Wo willst Du durch oder hinein?\n");
  if(!str) return 0;
  if(str=="in loch"||str=="durch loch")
     {
  if(!present("\nhoehlenquestbydante", TP))
      {
      write("Du willst in das Loch, schaffst es aber so sicher nicht. "
      "Such zuerst den Totengraeber auf.\n");
      return 1;
      }
    if(present("\nhoehlenquestbydante", TP))                  
      {
      write("Du schaffst es in das Loch zu gelangen!\n");
      TP->move("/d/gebirge/dante/room/kwhite", M_GO+M_SILENT);
      return 1;
      }
   return 0;
     }
  return 0;
   }
   
      