//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem lebendigem Organismus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten in einer grossen, hell erleuchteten Halle. "
  "Du wunderst Dich wo das Licht herkommt, und schauderst als Du erkennst, "
  "das an den Waenden ueberall Gekreuzigte haengen. Teilweise ausgebrannt und "
  "verkohlt, andere brennen noch hell und bruellen um ihr Leben!!! "
  "Genaues kannst Du nicht erkennen, den unzaehlige Saeulen versperren "
  "Dir die Sicht."));
  
  
  AddDetail(({"fallbeil","beil"}),
  "Es ist schon weg! Sei froh!");
  AddDetail(({"saugnaepfe"}),
  "Sie suchen Blut!");
  
  AddDetail(({"saeulen","saeule"}),
  "Die Saeulen ragen vom Boden bis zur Decke und werfen unheimliche Schatten. "
  "Manche Saeulen sind rund, anderen viereckig und dreieckig.");
  AddDetail("schatten",
  "Gespenstisch zucken sie am Boden hin und her.");
  AddDetail(({"runde saeule","runde saeulen"}),
  "Die Runden Saeulen sind blutrot und scheine auch zu pulsieren. Sie stellen "
  "die grossen Gefaesse dieses seltsamen Organismus dar.");
  AddDetail(({"gefaess","gefaesse"}),
  "BUMM!!!BUMMM!!! Das Blut pumpt durch den Organismus.");
  AddDetail("organismus",
  "Scheinbar ist das alles hier ein grosser, uralter Organismus.");
  AddDetail(({"dreieckige saeulen","dreieckige saeule"}),
  "Die dreieckigen Saeulen scheinen sich nicht oder nur kaum zu bewegen. "
  "Manchmal glaubst Du einen Laut aus ihnen vernehmen zu koennen. Manchmal "
  "scheinen sie Dich auch anzublinseln. Hmm, sind das etwa die Augen, Ohren und der Mund "
  "dieses Organismus...");
  AddDetail(({"auge","augen"}),
  "Hat Dich da nicht etwas angeschaut?");
  AddDetail(({"ohr","ohren"}),
  "Wirst Du hier belauscht?");
  AddDetail(({"mund"}),
  "Sollte Dich der Mund fressen wollen?");
  AddDetail(({"viereckige saeule", "viereckige saeulen"}),
  "Diese Saeulen sind sehr dick und scheinen eine seltsame Art von "
  "Knochengeruest darzustellen!");
  AddDetail(({"knochen","knochengeruest","geruest"}),
  "Sie scheinen das alles zu tragen und zu halten.");
  AddDetail("boden",
  "Schwarzrotes Gewebe ueberzieht den gesamten Boden und scheint hin und "
  "her zu kriechen. Eklig!");
  AddDetail("gewebe",
  "Es kriecht und schluepft und ab und zu spritzt ein Tropfen Blut heraus.");
  AddDetail("tropfen",
  "Plitsch!!!");
 AddDetail("decke",
 "Die Decke ist recht weit oben, doch in diesem hellen Licht gut zu erkennen."
 " Du freust Dich, dass die Gekreuzigten so schoen brennen. Lange, schwarze "
 "Tentakel haengen von ihr herab und saugen Blut aus dem Gewebe am Boden.");
 AddDetail("tentakel",
 "Die Tentakel schnellen rauf und runter.");
 AddDetail("licht",
 "Die Gekreuzigten spenden ein gespentisches Licht!");
 AddDetail("sicht",
 "Die Saeulen versperren Dir etwas die Sicht, und Du bist nicht ungluecklich "
 "darueber...");
 
  
  
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus blankem, schwarzen Stein. In kurzen Abstaenden "
  "haengen die Gekreuzigten an der Wand. An der Suedwand faellt Dir eine Malerei auf.");
  AddDetail("suedwand",
  "An der Suedwand ist eine Malerei.");
  AddDetail("malerei",
  "Du siehst eine kleine Steinfigur, die von jemandem zum oeffnen einer Tuere "
  "verwendet wird.");
  AddDetail(({"figur","steinfigur"}),
  "Sie ist sehr klein und unscheinbar...");
  AddDetail(({"tuer","tuere"}),
  "Sie scheint sehr tief unter der Erde zu sein.");
  AddDetail("erde",
  "Du steckst mitten drin.");
  
  AddDetail(({"abstand","abstaende"}),
  "Hau doch endlich ab!!");
  AddDetail(({"gekreuzigte","gekreuzigter"}),
  "Die armen, gepeinigten Gekreuzigten haengen tot oder halbtot an den "
  "Waenden. Einige bruellen noch, ihr Geschrei ist kaum auszuhalten, "
  "anderen sind bereits verkohlt und glimmen still vor sich hin!");
  AddDetail("geschrei",
  "AHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH!!!!!!");
  AddDetail("leben",
  "Angeblich wohnt hier ein Wesen, das mehrere Leben hat.");
  AddDetail("wesen",
  "Hmm, wo das wohl ist...");
  
  AddDetail("halle",
  "Die Halle weist eine enorme Groesse auf. Wer hat sie wohl errichtet? "
  "Eigentlich ist alles aus Stein und sehr schlicht.");
  AddDetail("stein",
  "Der Stein ist dunkelgrau bis schwarz und weist rote Adern auf.");
  AddDetail(({"ader","adern"}),
  "Durch die Adern pulsiert Blut!!! Der Stein lebt!!!");
  AddDetail("blut",
  "Deines gerinnt vor Angst und das des Steines pocht dunkel dahin.");
  AddDetail("angst",
  "Sie steigt und steigt!");
  
  AddDetail("groesse",
  "Kaum anzuschaetzen, aber auf jeden Fall sehr gross.");
  AddDetail("fall",
  "UAH!!! Irgendjemand hat ein Fallbeil ober Dir ausgeloest!!! Es verfehlt "
  "Dich nur knapp!");
  

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "AHHHHHHH!!!!!!!!!!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verkohltem Fleisch!");
   
   AddItem("/d/gebirge/dante/npc/km4", REFRESH_DESTRUCT); 
  AddExit("westen", "./k5");
  AddExit("osten", "./k3");
    
   }
