//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int was;

#define DENKEN (member(denken, getuid(this_player()))!=-1)
 string *denken=({});


create()
{
//was=0;
  ::create();
  SetProp( P_INT_SHORT, "In Hirn des Wesen" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun im Hirn des gigantischen Wesen und was Du hier vorfindest, "
  "erstaunt Dich doch. Das Hirn ist sehr klein, und vor allem ist hier nichts, rein "
  "gar nichts. Das Wesen hat also wirklich nichts im Kopf; ist aber sicher nicht "
  "alleine damit. Wo sind die Gedanken des Wesen?"));

AddDetail("wesen",
"Das Wesen scheint sehr doof zu sein.");
AddDetail("hirn",
"Du stehst mitten im Hirn des Wesen.");
AddDetail("kopf",
"Du kletterst schon seit geraumer Zeit im Kopf des Wesen herum.");
AddDetail("zeit",
"Die Zeit steht hier still.");
AddDetail(({"gedanke","gedanken"}),
"Hmm, ja wo sind sie? An irgendetwas muss ja auch diese Kreatur denken?");
AddDetail("kreatur",
"Hmm, gross ist sie sicher, aber ist sie auch wirklich so bloed?");
AddDetail(({"etwas","irgendetwas"}), 
"Doch, das Wesen denkt bestimmt...");
AddDetail("boden",
"Der Boden besteht hier aus weichem, weissen Material. Ein kleines Loch ist zu sehen.");
AddDetail("material",
"Hmm, Nervengewebe...");
AddDetail(({"gewebe","nervengewebe"}),
"Damit sollte das Wesen denken, aber tut es das auch?");
AddDetail(({"nerven","nerv"}),
"Dicke Nerven ziehen an den Waende nach unten und nach oben. Irgendwie "
"haben die Nerven seltsame Formen.");
AddDetail(({"form","formen"}),
"Sie sehen aus wie ein Mensch, ein Troll, ein Oger, ein Zwerg, eine Fee, "
"ein Dunkelelf, ein Hobbit und ein Elf.");
AddDetail(({"mensch","elf", "troll","oger","fee","hobbit","dunkelelf","zwerg"}),
"Die Nerven sehen wirklich genau so aus. Irgendwie wuerdest Du sie gerne fressen...");

AddDetail(({"wand","waende"}),
"Die Waende bestehen ebenfalls aus Nervengewebe.");
AddDetail("loch",
"Das Loch fuehrt nach unten.");
AddDetail("decke",
"Die Decke ist recht nieder und besteht ebenfalls aus dem weichen, weissen Gewebe. "
"Nur ist hier der Zustand etwas anders.");
AddDetail("zustand",
"Irgendjemand hat hier cogito ergo ap geschrieben. Was soll das heissen? Kann der "
"Depp kein Latein?");
AddDetail("latein",
"Si tacuisses, scripter mansisses...");
AddDetail("depp",
"Du bist heute aber eher unhoeflich...");


  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst wie das Hirn arbeitet.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier neurologisch? haeh?");
  SetProp(P_NO_TPORT, NO_TPORT_OUT);     
AddCmd(({"friss","fresse"}), "eat");
AddCmd(({"kletter", "klettere"}), "out");
AddCmd(({"denke","denk"}), "gedanken");
 }


int eat(string str) {
  string ob;
  ob=TP->QueryProp(P_RACE);
  notify_fail("Was willst Du hier fressen? Das doch sicher nicht...\n");
  if(member(({"mensch","elf", "troll","oger","fee","hobbit","dunkelelf",
      "zwerg"}), lower_case(str))!=-1)
  {
    if(!DENKEN) {
      write("Du kannst so einfach hier nichts fressen...\n");
      return 1;
    }
    else if((was==1)&&(ob=="Mensch")) {
       call_out("dais", 0);
       return 1;
    }
    else if((was==2)&&(ob=="Hobbit")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==3)&&(ob=="Zwerg")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==4)&&(ob=="Elf")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==5)&&(ob=="Oger")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==6)&&(ob=="Troll")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==7)&&(ob=="Dunkelelf")) {
      call_out("dais", 0);
      return 1;
    }
    else if((was==8)&&(ob=="Fee")) {
     call_out("dais", 0);
     return 1;
    }
    else {
     write("Hmm, nein irgendwie willst du das doch nicht fressen!\n");
     return 1;
    }
    return 0;
  }
  return 0;
}
   
    
    
    
  void dais()
  {
  object bone;
  remove_call_out("t1");
  remove_call_out("t2");
  remove_call_out("t3");
  remove_call_out("t4");
  remove_call_out("t5");
  remove_call_out("t6");
  remove_call_out("t7");
  remove_call_out("t8");
  bone=clone_object("d/gebirge/dante/obj/bone4");
    write("Du willst also wirklich ein Mitglied Deiner Rasse fressen!\n"
    "Das Wesen teilt Dir mit: Kannibale, pfui!\n"
    "Das Wesen teilt Dir mit: Hier nimm die Gebeine von Noerd und hau ab!\n"
    "Das Wesen teilt Dir mit: Mit sojemanden will ich nichts zu tun haben!\n");
    bone->move(TP, M_GO);
   }
     
      
      
 gedanken()
  {
    if(DENKEN)
      {
      write("Du bist ja bereits in den Gedanken des Wesen!\n");
      return 1;
      }
      else
      {
       denken += ({getuid(this_player())});        
  write("Du beginnst zu denken und ploetzlich glaubst Du die "
  "Gedanken des dummen Wesen irgendwie zu erkennen...\n");
  call_out("t1", 5);
  return 1;
  }
 return 0;
 }
 
 
void t1() {
 int was;
 was=1;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran wie gut ein Mensch schmecken wuerde.\n");
   call_out("t2", 5);
}
   
 
 void t2()
 {
 was=2;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran wie lecker Hobbits sind.\n");
   call_out("t3", 5);
   }
  
  
 void t3()
 {
 was=3;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran, dass es wieder einmal einen Zwerg fressen will.\n");
   call_out("t4", 5);
   }
 
  
  
 void t4()
 {
 was=4;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran, das gebratene Elfen gut schmecken.\n");
   call_out("t5", 5);
   }
  
  
 void t5()
 {
 was=5;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran, das fette Oger auch nicht zu verachten sind.\n");
   call_out("t6", 5);
   }
 
 void t6()
 {
 was=6;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst daran, das ein frittierter Troll lecker waere.\n");
   call_out("t7", 5);
   }
 
  
 void t7()
 {
 was=7;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst an gefuellte Dunkelelfen.\n");
   call_out("t8", 5);
   }
  
   
 void t8()
 {
 was=8;
   if(!present(getuid(TP)) || environment(TP)!=TO || !TP) return 0;   
   write("Das Wesen denkst an knusprige Feen.\n");
   call_out("t1", 5);
   }
 
   
int out(string str)
   {
   notify_fail("Wo willst Du hinein klettern?\n");
   
   if(str=="in zyste"||str=="durch loch")
     {
//
//hier muss noch rein, dass das denken wegkommt wenn der spieler aus dem raum
//geht, sonst geht er rein denkt raus und kriegt dann wenn er wieder kommt,
//keine gedanken mehr mit....bzw er muss ne zeit warten und wieder denken usw
//     if(DENKEN)
     
     write("Du kletterst durch das Loch in die Zyste nach unten!\n");
     TP->move("d/gebirge/dante/room/mund3", M_GO+M_SILENT+M_NO_SHOW);
     return 1;
     }
  return 0;
  }
  
  
  init()
    {
    ::init();
   if(!deep_present("HIRN", TP))
     {
     write("Du kannst so hier nicht bleiben, denn so bist Du zu klug "
     "fuer diese Umgebung!\n");
     TP->move("d/gebirge/dante/room/mund3", M_GO+M_SILENT+M_NO_SHOW);
       }
    }
         
