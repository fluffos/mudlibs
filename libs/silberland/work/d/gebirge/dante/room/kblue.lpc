//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>
create()
{
  ::create();
  
  
  SetProp( P_INT_SHORT, ""+ANSI_BOLD+ANSI_BLUE+"In einer blauen Kammer" );
  SetProp( P_INT_LONG, BS(
  ""+ANSI_BLUE+ANSI_BOLD+"Du stehst nun in einem Raum, der voellig blau ist. Nein, nicht betrunken "
  "wie Du dauernd bist, sondern in dem die Farbe Blau vorherrschend ist. "
  "Alles, wirklich alles ist blau."));
  AddDetail("farbe",
  ""+ANSI_BLUE+ANSI_BOLD+"Alles hier ist blau.");
  AddDetail("blau",
  "Naja, wie sieht hier alles aus?");
AddDetail("nordwand",
"An der Nordwand ist eine Zeichnung.\n");  
  AddDetail("decke",
  "Die Decke ist ebenfalls total blau angemalt.");
  AddDetail("boden",
  "Der Boden besteht aus blauem Stein. Eine blaue Treppe fuehrt "
  "nach unten.");
  
  AddDetail("stein",
  "Der Stein ist blau, haha, und hart.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind rauh und aus Stein. Achja, und blau. "
  "An der Nordwand erkennst Du eine Zeichung.");
  AddDetail("zeichung",
  "Du siehst ein Tor und einen kleinen Schluessel.");
  AddDetail("tor",
  "Das Tor ist blau und scheint geschlossen zu sein.");
  AddDetail("schluessel",
  "Der Schluessel ist auch blau, wie originell, und scheint zum "
  "Tor zu gehoeren.");
  
AddDetail("treppe",
"Die Treppe fuehrt nach"+ANSI_INVERS+" unten!");

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst alles sehr blau.");
AddItem("d/gebirge/dante/npc/kmblu", REFRESH_DESTRUCT);
AddSpecialExit("unten", "colorme");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach blau...");
    
 }

  int colorme()
  {
 
       return this_player()->move("/d/gebirge/dante/room/k18", M_GO,
                ""+ANSI_NORMAL+"nach unten", "geht", "kommt von oben herab");
                }//lass das!!!
                