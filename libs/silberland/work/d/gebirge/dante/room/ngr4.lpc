//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int bone, flasche;

create()
{
  ::create();

bone=5+random(5);
  flasche=1;
  SetProp( P_INT_SHORT, "In einem Grab unter der Huette des Totengraebers");
  SetProp( P_INT_LONG, BS(
  "Hier ist es schon viel weiter und heller, als in den engen und stickigen "
  "Graebern, durch die Du Dich hindurchgequealt hast. Von oben dringt "
  "Licht durch einen kleinen Spalt. Irgendwie kommt Dir dieser Raum "
  "ueberhaupt nicht wie ein Grab vor..."));
  AddDetail("raum",
  "Hier ist es hell und trocken. Die Waende sehen glatt und stabil aus.");
  AddDetail(({"wand", "waende"}),
  "Irgendjemand hat diese Waende gebaut, sie sind sicherlich kein Produkt "
  "der Natur.");
  AddDetail(({"natur","smog","produkt"}),
  "Sei froh, dass es hier (noch) keinen Smog gibt.");
  AddDetail("boden",
  "Der Boden besteht aus Erde, ist ebenfalls glatt und voellig eben. Wenn man genau hinsieht "
  "sieht man eine schmale Spur, die direkt auf eins ehr kleines Loch fuehrt.");
  AddDetail("spur",
  "Die Spur ist eine Bahn, und zwar keine Eisenbahn, sondern eine Bahn zum spielen. "
  "Aehnlich einer Kegelbahn. Nur spielt man hier mit kleinen runden Knochen. "
  "Es geht darum, die Knochen in das Loch zu rollen. Der Sieger darf dann diesen "
  "Raum verlassen. Der Verlierer wird zum Spielzeug...");
  AddDetail(({"eisenbahn", "kegelbahn"}),
  "Naja, so aehnlich, nur machen die Knochen sicher nicht tutut.");
  AddDetail("loch",
  "Hier musst Du die kleinen Knochen hineinwerfen. Es hat uebrigens keinen Sinn "
  "sich dem Loch zu naehern, ueber eine am Boden gezogene Linie kommst Du nicht. "
  "Wenn Du lebensmuede bist, probiere <uebertrete linie>.");
AddDetail("knochen",
"Die Knochen liegen hier irgendwo herum...");
  
  AddDetail("erde",
  "Die Erde ist locker und weich...");
AddDetail("bahn",
"Die Bahn fuehrt direkt zu einem kleinen Loch.");
AddDetail("decke",
"Die Decke ist hoch ueber Dir. Licht faellt durch sie zu Boden.");
AddDetail("licht",
"Durch die Decke faellt etwas Licht herab. Es strahlt genau einen Punkt am Boden an.");
AddDetail(({"grab","graeber"}),
"Dieser Raum sieht nicht wie ein typisches Grab aus.");
AddDetail("punkt",
"Hmm, der Punkt sieht normal aus. Du erkennst auch Fussspuren am Boden...");
AddDetail("linie",
"Eine boese Stimme fluestert: Uebertritt die Linie, uebertritt sie!\n");
AddDetail("sieger",
"Mit etwas Glueck gewinnst Du.");
AddDetail("glueck"
"Wer wagt, gewinnt.");
AddDetail(({"fussspur","fussspuren", "fusspuren","fusspur"}),
"Sieht so aus, als ob hier jemand gestanden waere.");
AddDetail("spielzeug",
"Vielleicht wirst Du ja zu kleinen Knochen verarbeitet...");
AddDetail("stimme",
"Du hoerst sie nicht mehr.");

AddDetail("spalt",
"Ober Dir ist ein Spalt, durch den man vielleicht hier raus kann...");
AddDetail("sinn",
"Der Sinn des Spiels ist es, hier wieder lebend raus zu kommen.");
AddDetail("verlierer",
"Der Verlierer bleibt hier und verfault.");
AddDetail("spiel",
"Das Spiel sollte Dir klar sein...");
AddDetail("spielergeist",
"Scheint nicht hier zu sein.");

  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
  
  
 AddItem("d/gebirge/dante/npc/kdead2", REFRESH_DESTRUCT);   
 AddCmd(({"wuehle","grabe","grab","wuehl"}), "bones");   
AddCmd(({"uebertrete","uebertritt"}),"dam");
AddCmd(({"rolle", "roll"}), "try");
AddCmd(({"stehe","tritt","stelle","steh","betrete"}), "get");
}

int get(string str)
   {
   object t;
   notify_fail("Wo willst Du Dich hinaufstellen?\n");
   if (!str) return 0;
   if (str=="auf punkt"||str="auf fusspur"||str=="auf fusspuren"||
   str=="auf fussspuren"||str=="auf fussspur")
      {
      if(flasche)
          {
          t=clone_object("/d/gebirge/dante/obj/hfl.lpc");
          t->move(TP, M_GO);
          flasche--;
          write("Du stellst Dich genau auf den Punkt und ploetzlich "
          "faehrt eine gigantische hand aus dem Boden, gibt Dir eine "
          "Flasche und verschwindet wieder.\n");
          return 1;
          }
          if(!flasche)
          {
          write("Du stellst Dich auf den Punkt, aber nichts passiert.\n");
          return 1;
          }
    return 0;
       }
    return 0;
    }
             
   int try(string str)
  {
  object ob;
  object here;
   ob=present("playbone", TP);
  notify_fail("Was willst Du wohin rollen? <rolle knochen zu loch>\n");
     if (!str) return 0;
     
     if(str=="knochen zu loch")
         {
          if (!present("playbone", TP))
             {
           write("Du hast keinen Knochen zum spielen.\n");
            return 1;
             }
       
     if(present("playbone", TP))
          {
           switch(random(10))
               {
               case 0..2:
               write("Du rollst den Knochen zum Loch.\n"
               "Er kullert um das Loch herum, faellt aber nicht heinein.\n"
               "Danach loest er sich auf einmal in Luft auf.\n");
              ob->remove();
              break;
              case 3..4:
              ob->remove();
              write("Du rollst den Knochen zum Loch.\n"
              "Er rollt weit am Loch vorbei. Schwache Leistung!\n"
              "Eine tiefe Stimme sagt: "+TPN+", das war mies. Dafuer bestrafe "
              "Ich Dich!\n"
              "Ein Blitz faehrt aus der Erde genau in DICH! WUMMMMM!!!!!\n");
              TP->do_damage(5)+random(5);
              break;
               case 5:
               write("Du rollst den Knochen zum Loch.\n"
               "Er rollt um das Loch herum und SCHWUPSSS faellt er hinein!\n"
               "Eine veraergerte Stimme sagt: Verschwinde, "+TPN+"!\n");
               while(here=present("playbone", TP))
               {
               write("Alle Knochen loesen sich in Luft auf.\n");
               here->remove();
               }
               write("Du wirst von einer gigantischen Hand nach oben befoerdert.\n");
               TP->move("d/gebirge/dante/room/k0", M_GO + M_SILENT);
               break;       
               
               case 6..7:
               write("Du rollst den Knochen, er beschleunigt auf einmal enorm, "
               "prallt gegen die Wand und dann gegen Deinen Kopf!\n"
               "Eine boesartige Stimme lacht Dich aus.\n");
               TP->do_damage(10)+random(10);
               ob->remove();
               break;
                case 8..9:
                 write("Du rollst den Knochen zum Loch.\n"
                 "Leider bleibt er kurz vor dem Loch stehen und loest sich dann in Luft auf.\n"
                 "Aus Wut schlaegst Du Deinen Kopf gegen die Wand!\n");
                 ob->remove();
                 TP->do_damage(5)+random(5);
                 break;
                 default:write("BUG!\n");
                 }
           return 1;
           }    
       return 0;
       }
    return 0;
    }
               
               
               
               
               
               
               
int bones(string str)
  {
  object ob;
  notify_fail("Wo willst Du hier graben?\n");
  if (!str) return 0;
  if (str=="in erde"||str=="erde")
     {
     if(bone) 
      {
      write("Du wuehlst in der Erde und findest einen kleinen, runden Knochen.\n");
      ob=clone_object("d/gebirge/dante/obj/playbone");
      ob->move(TP, M_GO);
      bone--;
      return 1;
      }
    if(!bone)
      {
      write("Du wuehlst in der Erde, findest aber nichts.\n");
      return 1;
      }
   return 0;
   }
  return 0;
 }
            

 reset()
 {
 ::reset();
 flasche=1;
 bone=7+random(5);
 }
 

int dam(string str)
  {
  notify_fail("Was willst Du uebertreten?\n");
  if(str=="linie")
    {
    write("Du hast auf die Warnung nicht gehoert!\n"
    "Eine gigantische Hand faehrt aus dem Boden und reisst Dich in die Tiefe.\n");
    TP->move("d/gebirge/dante/room/dead", M_GO+M_SILENT);
    return 1; 
    }
    
    return 0;
    }
