//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Grab" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun in einem scheinbar frischaus gehobenen Grab. "
  "Ausser Erde ist hier nichts zu sehen. Durch ein Loch kannst "
  "Du wieder nach oben zurueck."));
  AddDetail("boden",
  "Braune Erde.");
  AddDetail("decke",
  "In der Decke ist ein Loch. Sonst bestehtsie nur aus Erde.");
  AddDetail("loch",
  "Durch das Loch usw...");
  AddDetail("erde",
  "Braune, weiche Erde.");
  AddDetail(({"wand", "waende"}),
  "Die Waende bestehen ebenfalls nur aus Erde. In der Nordwand siehst "
  "Du ein Tor.");
  AddDetail("nordwand",
  "Die Nordwand ist im Norden! WOW!!!");
  AddDetail("norden",
  "Im Norden ist die Nordwand");
  AddDetail("tor",
  "Durch dieses Tor kommst Du in den Bereich der Graeber, "
  "in dem nur Geister leben...");
  AddDetail(({"grab", "graeber"}),
    "Du stehst eigentlich in einem.");
    AddDetail(({"geist", "geister"}),
    "Die Geister leben hier unten.");
    
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
    
  AddExit("oben", "./k0");
  AddSpecialExit("norden", "go");
    
 

}
   int go()
   {
   object rue;
   rue=present("gkappe", TP);
  if ((rue)&&(rue->QueryProp(P_WORN)==TP))
    {
    return TP->move("d/gebirge/dante/room/g1", M_GO);
    }
    else
    write("Du als Lebender kannst hier so einfach nicht durch!\n");
   return 1;
     }
       
   