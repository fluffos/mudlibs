//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
  ::create();



  SetProp( P_INT_SHORT, "Im Nichts" );
  SetProp( P_INT_LONG, BS(
  "Du bist im absoluten Nichts."));
AddDetail("nichts", "Nichts");


  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Du riechts nichts!");
  
  AddExit("raus", "./k13");
  
 AddItem("/d/gebirge/dante/npc/km15", REFRESH_DESTRUCT);


 }

