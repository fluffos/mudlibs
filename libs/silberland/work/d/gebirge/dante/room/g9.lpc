//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int auf;

create()
{
  ::create();
auf=0;

AddSpecialDetail(({"wand", "waende"}), "show");

//AddItem("d/gebirge/dante/npc/bgeist", REFRESH_DESTRUCT);
AddExit("sueden", "./g6");
AddExit("westen", "./g7");
AddExit("norden", "./g3");
AddDetail("flaeche",
"Dunkel, unheimlich.");
AddDetail("ostwand",
"In der Ostwand siehst Du eine dunkle Flaeche.");



}



  string show()
    {
    if(auf==0)
      {
      write("In der Ostwand siehst Du eine dunkle Flaeche. "
      "Ob man hier weiter gehen kann?\n");
       }
    if(auf==1)
      {
      write("In der Ostwand ist eine dunkle Flaeche, durch die man "
      "gehen kann.\n");
      }
      return "";
      }
               

  open_door()
    {
    
     AddExit("osten", "./gprie");
     auf =1;   
    return 1;
    }

  void close()
    {
    auf=0;
       RemoveExit("osten", "./zelle1");
    }
             

  reset()
    {
    ::reset();
    call_out("close", 0);
    }
            