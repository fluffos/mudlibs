//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>


create()
{
  ::create();


  SetProp( P_INT_SHORT, ""+ANSI_GREEN+ANSI_BOLD+"In einem dunklen Schacht" );
  SetProp( P_INT_LONG, BS(
   ""+ANSI_GREEN+ANSI_BOLD+"Du steckst in einem Schacht, der aus blanken Stein gehauen wurde. "
   "Er fuehrt tief nach unten in die Dunkelheit. Die Waende sind ueber und "
   "ueber mit seltsamen Zeichen bemalt."));
AddDetail("stein",
"Der Stein ist recht glatt und schwarz. Er ist ueber und ueber mit Runen "
"bedeckt.");
AddDetail("dunkelheit",
"Tja, wie das eben so mit der Dunkelheit ist, man sieht nicht viel in ihr...");
AddDetail("schacht",
"Du steckst mjitten drinnen.");

   AddDetail("raum",
   "Der Raum scheint vollkommen rot zu sein, aber viel kann man nicht "
   "erkennen.");
AddDetail("decke",
  "Naja, sowas wie eine Decke sieht man hier natuerlich nicht, "
  "aber ein Loch durch das man nach oben kann...");
  AddDetail("loch",
  "Das Loch fuehrt nach oben.");
  AddDetail("boden",
  "Im Boden entdeckst Du ein Loechlein, mehr ist das nicht.");
  AddDetail("loechlein",
  "Das Loechlein ist wirklich sehr klein, wer da durchkommt, "
  "muss entweder winzigst sein, oder von unten kommen.");
  
  AddDetail(({"wand", "waende"}),
  "Die Waende sind glatt, manchmal ein Kratzer oder eine kleine Erhebung, "
  "aber was Dich wirklich interessiert sind die seltsamen Zeichen an der Wand.");
  AddDetail("zeichen",
  "Die Zeichen sind Runen, und sind ueberall.");
  AddDetail(({"rune", "runen"}),
  "Kunstvoll sind sie teils eingemeiselt, teils an die Wand gemalt. Leider "
  "sagen sie Dir nichts. Oder doch? Probier halt eine Rune zu lesen...");
  AddReadDetail("rune",
  "Hmm, Du glaubst folgendes zu entziffern:\n"
  "Fremder, sei auf der Hut, Du betritst das Reich der Runenmaenner.\n");
  AddDetail("kratzer",
  "Laenglich oder auch nur kurz fuehren sie ueber die Waende.");
  AddDetail("erhebung",
  "Die Erhebungen sind auch nicht viel interessanter.");
     
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen unter Dir.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
  AddItem("/d/dschungel/dante/weg/npc/dschlange.lpc", REFRESH_DESTRUCT);  
  AddExit("oben", "./k20"); 
  AddSpecialExit("unten", "nix");
 }

  string nix()
  {
  notify_fail("Du willst durch das Loechlein, schaffst es aber nicht.\n");
  return 0;
  }
  
