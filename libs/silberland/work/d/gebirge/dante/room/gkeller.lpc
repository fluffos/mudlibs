//rumpel
#include "files.h"
#include <moving.h>
    
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <player.h>

nosave int bon;
 int frage, hier;

create()
{
  ::create();
 
hier=1;
frage=random(20)+1;
 
 
  SetProp( P_INT_SHORT, "Dantes Rumpelkammer" );
  SetProp( P_INT_LONG, (
    "Hier wirft Dante all das herein, war er im Moment nicht brauchen kann. "
    "Ueberall liegt Schrott und unnuetzes Zeug. Es ist auch ziemlich staubig hier, "
    "denn Dantes Putzfrau ist im Streik, weil er sie zu schlecht bezahlt. "
    "Aber vielleicht kannst Du ja aufraeumen..."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("boden"),
  "Der Boden ist so schmutzig und ueberfuellt, dass man ihn kaum erkennen kann. "
  "Es liegt soviel Muell herum und man muss aufpassen, dass man nicht stolpert.");
  AddDetail(("streik"),
  "Dante teilt Dir mit: Ne, dieses faule Aas bekommt nicht mehr Geld!");
  AddDetail(("muell"),
  "Hier sollte man wirklich einmal sauber machen...");
  AddDetail(("frau"),
  "Du meinst sicher die Putzfrau.");
  AddDetail(({"kammer","rumpelkammer"}),
  "Du denkst . o 0 'So wohnen also Magier...'");
  AddDetail(("titel"),
  "In Oesterreich sind Titel sehr wichtig, denn ohne einen bist Du nichts.");
  AddDetail(("oesterreich"),
  "Hmmm, ist das was zu essen, wir leben doch im Silberland, oder?");
  AddDetail(("silberland"),
  "Unsere schoene Heimat!");
  AddDetail(("putzfrau"),
  "Dantes Putzfrau hies Erna und wollte Staubmanagerin gennant werden.");
  AddDetail(("erna"),
  "Du singst 'Erna, die fette Erna...'");
  AddDetail(("staub"),
  "Ueberall liegt hier Staub herum. Du selbst bist schon ganz staubig.");
  AddDetail(({"managerin","staubmanagerin"}),
  "Ein daemlicher Titel!");
  AddDetail(("decke"),
  "Die Decke haengt voller Spinnweben...");
  AddDetail(({"wand", "waende"}),
  "An den steht etwas geschrieben.");
  AddDetail(("etwas"),
  "Du kannst es lesen.");
  AddReadDetail(("etwas"),
  "Bin im Streik und ruehre keinen Finger fuer Dante, diesen kapitalistischen Ausbeuter!");
  AddDetail(("schrott"),
  "Wofuer braucht Dante all dieses sinnlose Zeug?");
  AddDetail(("zeug"),
  "Eigentlich ist der Muell ziemlich uninteressant, nur die Kiste gefaellt "
  "Dir ganz gut.");
  AddDetail(("kiste"),
  "Hmmm, die Kiste hast Du zuerst voellig uebersehen. Eigentlich ist es "
  "ja keine Kiste, nur der Geist einer Kiste...");
  AddDetail("geist",
  "Geist oder nicht, das ist hier die Frage?");
  AddDetail("frage",
  "Tja, Du solltest die Kiste vielleicht etwas genauer untersuchen, "
  "denn man kann einige Buchstaben auf ihr erkennen.");
  AddSpecialDetail(({"buchstaben", "buchstabe"}), "fragen");
AddDetail(({"spinnweben","spinnwebe"}),
"Grau und gross haengen sie hier ueberall. Du ekelst Dich direkt.");
  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach billigem Nuttenparfum.");
    bon=1;
 
AddCmd(({"oeffne"}), "open");
AddItem("/d/dschungel/dante/weg/obj/dhirn", REFRESH_REMOVE);
AddItem("/d/dschungel/dante/weg/obj/dpilz", REFRESH_REMOVE);
AddItem("/d/dschungel/dante/weg/obj/dj", REFRESH_REMOVE);
AddItem("d/dschungel/dante/weg/obj/schoko1", REFRESH_REMOVE);
AddItem("/d/dschungel/dante/weg/obj/jojo", REFRESH_REMOVE);

AddExit("oben", "./g2");


 AddCmd(({"loesung"}), "go");

  AddCmd(({"raeum","raeume","mach","mache"}), "clean");
}

 int go(string str)
   {
   notify_fail("Wie ist die Loesung?\n");
   if(!str) return 0;
   
   
   if(!hier)
     {
     write("Sorry, im Moment kann ich fuer Dich leider nichts tun!\n");
     return 1;
     }


   
      if((frage==1)&&(str=="wind"))
          {
         
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
          }
          
       if((frage==2)&&(str=="nichts"))   
          {
           
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 
          
       if((frage==3)&&(str=="alles"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;

         } 
            
       if((frage==4)&&(str=="wasser"))   
          { 
          call_out("g", 0);
          hier--;
          call_out("neuefrage", 0);
          return 1;
         } 
           
       if((frage==5)&&(str=="luege"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 
          
       if((frage==6)&&(str=="spiegel"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 
          
       if((frage==7)&&(str=="abend"))   
          { 
          call_out("g", 0);
       hier--;
       call_out("neuefrage", 0);
       return 1;

         } 
          
       if((frage==8)&&(str=="frage"||str=="fragen"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==9)&&(str=="muaddib"||str=="muadib"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==10)&&(str=="zordan"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 


          
       if((frage==11)&&(str=="stuhl"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==12)&&(str=="baum"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 


          
       if((frage==13)&&(str=="fisch"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==14)&&(str=="tor"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==15)&&(str=="schlange"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==16)&&(str=="uhrzeiger"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==17)&&(str=="schlau"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==18)&&(str=="asche"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==19)&&(str=="schnee"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
       if((frage==20)&&(str=="wortspiel"))   
          { 
          call_out("g", 0);
       hier--;
          call_out("neuefrage", 0);
          return 1;
         } 

          
        else
       {
    write("Nein, falsch! Probiers nochmal!\n");
    return 1;
       }
           return 0;
    }

 void g()
    {
    object ob;
    ob=clone_object("d/gebirge/dante/obj/sarg");
    if(deep_present("gebeinsarg", TP))
      {
      write("Aber Du hast bereits einen Sarg!\n");
      }
      else
      {
      write("Die Kiste sagt: "+TPN+", ich bin erstaunt! Dass haette ich\n "
            "Die Kiste sagt: mir von Dir nicht gedacht! Hier deine Belohnung!\n"
            "Die Kiste geht auf und ein grosser Gegenstand fliegt genau in Deine "
            "Arme!\n");
      ob->move(TP, M_GO);
      }
   }
      

    void neuefrage()
    {
    frage=random(20)+1;
    }
      

   string fragen()
     {
     
     write("Die Buchstaben surren hin und her und ploetzlich formen sie "
     "folgendes:\n"
     " syntax: loesung <antwort>\n\n");
     
     if(frage==1)
        {
   
    write("Ein alter Mann, der gerne schreitet,\n"
    "dem Ruhe nur Verdruss bereitet.\n"
    "In Sanftmut er vermag zu ruehren, \n"
    "was sein Toben wird zu Bruche fuehren.'\n");
        }
     if(frage==2)
        {
   write("Meine Haut ist Zeichen meines Seins. Bin ich von nichts\n"
    "umgeben, so bin ich grenzenlos.\n");
        }
      if(frage==3)
      {
      write("Nimm fort was Du magst, und ich bin nicht mehr ich.\n");
      }
      if(frage==4)
      {
      write("Dein Inneres ist ohne mich demselben Schicksal ausgeliefert\n"    
      "wie Dein Aeusseres in meiner tiefsten Umarmung.\n");  
       }
       if(frage==5)
       {
 write("Der Schwester mit dem reinen Kleid, "
 "gilt ihr Blick voll Uebelkeit.\n"
 "Ihr Name ist der Worte Schand', "
 "aus deren Laut der Geist entschwand.\n");
      }
 
  if(frage==6)
  {
write("Viele Gesichter habe ich, befragst Du mich, zeige ich Dir"
" eines von ihnen.\n");
    }
    if(frage==7)
    {
    write("Rostig wird des Gueldenen Speer, "
    "Nur kurz sein Flug, des Armes schwer. "
    "Der schwarze Ritter treibt zur Flucht,"
    "des Schlachtfelds Namen sei gesucht.\n");
    }
    if(frage==8)
    {
    write("Wer sie hat duerstet nach andrem, \n"
    "wer sie erhaelt, muss geben.\n"
    "Wem es an ihr fehlt, bleibt der Mangel fremd.\n");
    }
    
    if(frage==9)
    {
    write("Mein erstes ist wie das Geraeusch einer Kuh.\n"
    "Mein 2. nimmt Dir etwas weg!\n"
    "Wer bin ich?\n");
    }
    
    if(frage==10)
     {
     write("Mein erstes sind die ersten 3 Buchstaben eines maskierten Helden.\n"
     "Mein 2.tes is ein Rang im Karate.\n"
     "Wer mag ich sein?\n");//zordan
     }
     
     if(frage==11)
     {
     write("Ich habe Beine, doch geh ich nie.\n"
     "Ich habe einen Ruecken, doch buecke ich mich nie.\n"
     "Ich habe Arme, doch arbeite ich nie!\n"
     "Wer bin ich?\n");//stuhl
     }
     
     if(frage==12)
     {
     write("Ich bin im Winter nackt,\n"
     "im Sommer dicht und voll,\n"
     "im Herbst sehr bunt.\n");//baum
         }
         if(frage==13)
         {
    write("Atemlos lebt es,\n"
    "Kalt wie der Tod lebt es,\n"
    "Fuehlt keinen Durst,  und doch trinkt es,\n"
    "Traegt ein Kettenhemd, und nie klingt es!\n");//fisch
    }
    if(frage==14)
      {
      write("Als Vorzug vor dem Dorfe hat\n"
      "mich in der Regel jede Stadt.\n"
      "Doch ists kein Glueck fuer eine Stadt,\n"
      "wenn sie in andrem Sinne\n"
      "dergleichen viel in ihrer Mitte hat.\n");//tor
      }
    if(frage==15)
      {
      write("In Edens Garten schon bekannt,\n"
      "als ein beruehmter Stab genannt,\n"
      "als Rettungszeichen aufgerichtet,\n"
      "zu meiner Klugheit ihr verpflichtet,\n"
      "doch bin ich Eurem Hass geweiht,\n"
      "als Sinnbild der Verdorbenheit!\n");//schlange
      }  
      if(frage==16)
      {
      write("Es wandert ohne Rast und Ruh\n"
      "im Kreis herum, dem Ziele zu.\n"
      "Hats immer und hats nie erreicht,\n"
      "obwohl aus seiner Bahn es nie abweicht.\n"
      "Dem Traegen laeuft es stest zu traeg,\n"
      "dem Fleissgen oft zu schnell hinweg!\n");//uhrzeiger
      }
      if(frage==17)
      {
      write("Spricht man vom Ganzen, so gebuehret,\n"
      "Dir oh Fuchs, von allen Tieren, der Preis!\n"
      "Doch muss es die 3 ersten Lettern missen, \n"
      "ists weder kalt noch heiss!\n");//schlau
      }
      if(frage==18)
       {
       write("Meine mUtter ist das Feuer.\n"
       "Wer mich beruehrt wird wie die Nacht!\n");//asche
       }
       if(frage==19)
       {
       write("Ich bin wie die Unschuld,\n"
       "doch baut man auch Maenner aus mir.\n");//schnee
        }
        if(frage==20)
        {
        write("Mein 1.tes brechen viele Leute\n"
        "viel lieber als ein Bein!\n"
        "Das 2.te bringt bald gute Beute\n"
        "bald Leid, bald Aerger ein!\n"
        "Das Ganze soll zum Scherze auch hier getreiben sein!\n"); //wortspiel
        }
        
           
    
     return "";
     }  






int open(string str)
  {
  object mon;
  notify_fail("Was willst Du oeffnen?\n");
  if(str=="kiste"||str=="geisterkiste")
    {
    write("Du oeffnest die Kiste und heraus kommt...\n");
    mon=clone_object("/d/gebirge/dante/npc/kdead");
    mon->move(environment(TP), M_SILENT +M_GO);
    mon->Kill(TP);
    return 1;
    }
  return 0;
  }
         

reset()
{
  ::reset();
    bon=1;
    call_out("neuefrage", 0);
    }
     

 clean (str )
{ 

  notify_fail("Was willst Du hier machen?\n");
   if (( str=="sauber" || str=="auf")  && ( !bon))  
   
   {
   write("Du versuchst die Rumpelkammer aufzuraeumen, gibst aber bald wieder auf.\n");
  say(""+TPN+" versucht vergeblich die Rumpelkammer aufzuraeumen.\n");
 return 1;
 }
     if (( str=="sauber" || str=="auf")  && ( bon))
{
write("Du versuchst die Rumpelkammer aufzuraeumen, gibst aber bald auf.\n"
      "Als Belohnung bekommst Du dafuer Etwas sehr leckeres......\n");
      bon--;
     clone_object("/d/dschungel/dante/weg/obj/schokobons.lpc")->move(TP);
       
      return 1;
      }
      return 0;
      }
      
      
      
void init()
{object ob;
  ::init();
  if(!present("staub", TP))
    {
  ob=clone_object("d/gebirge/dante/obj/staub");
  ob->move(TP, M_GO);
        } 
    }
              