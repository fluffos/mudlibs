//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int nails;

create()
{
  ::create();
nails=0;

  SetProp( P_INT_SHORT, "In einem lebenden Organismus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten in einer grossen, hell erleuchteten Halle. "
  "Du wunderst Dich wo das Licht herkommt, und schauderst als Du erkennst, "
  "das an den Waenden ueberall Gekreuzigte haengen. Teilweise ausgebrannt und "
  "verkohlt, andere brennen noch hell und bruellen um ihr Leben!!! "
  "Genaues kannst Du nicht erkennen, den unzaehlige Saeulen versperren "
  "Dir die Sicht. Eine verfallene Leiter scheint durch ein Loch nach unten "
  "zu fuehren."));
  AddDetail("leiter",
  "Die Leiter sieht nicht besonders stabil aus, aber sie wird wohl halten...");
  AddDetail("loch"
  "Das Loch sieht nicht gerade vertrauensvoll aus.");
AddDetail(({"beil","fallbeil"}),
"Alles nur Einbildung!");
AddDetail("einbildung",
"Du siehst einen Fehler im Denk-Gefuege!");
AddDetail("fehler",
"Krepier!");
  
  
  AddDetail(({"saugnaepfe"}),
  "Sie suchen Blut!");
  
  AddDetail(({"saeulen","saeule"}),
  "Die Saeulen ragen vom Boden bis zur Decke und werfen unheimliche Schatten. "
  "Manche Saeulen sind rund, anderen viereckig und dreieckig.");
  AddDetail("schatten",
  "Gespenstisch zucken sie am Boden hin und her.");
  AddDetail(({"runde saeule","runde saeulen"}),
  "Die Runden Saeulen sind blutrot und scheine auch zu pulsieren. Sie stellen "
  "die grossen Gefaesse dieses seltsamen Organismus dar.");
  AddDetail(({"gefaess","gefaesse"}),
  "BUMM!!!BUMMM!!! Das Blut pumpt durch den Organismus.");
  AddDetail("organismus",
  "Scheinbar ist das alles hier ein grosser, uralter Organismus.");
  AddDetail(({"dreieckige saeulen","dreieckige saeule"}),
  "Die dreieckigen Saeulen scheinen sich nicht oder nur kaum zu bewegen. "
  "Manchmal glaubst Du einen Laut aus ihnen vernehmen zu koennen. Manchmal "
  "scheinen sie Dich auch anzublinseln. Hmm, sind das etwa die Augen, Ohren und der Mund "
  "dieses Organismus...");
  AddDetail(({"auge","augen"}),
  "Hat Dich da nciht etwas angeschaut?");
  AddDetail(({"ohr","ohren"}),
  "Wirst Du hier belauscht?");
  AddDetail(({"mund"}),
  "Sollte Dich der Mund fressen wollen?");
  AddDetail(({"viereckige saeule", "viereckige saeulen"}),
  "Diese Saeulen sind sehr dick und scheinen eine seltsame Art von "
  "Knochengeruest darzustellen!");
  AddDetail(({"knochen","knochengeruest","geruest"}),
  "Sie scheinen das alles zu tragen und zu halten.");
  AddDetail("boden",
  "Schwarzrotes Gewebe ueberzieht den gesamten Boden und scheint hin und "
  "her zu kriechen. Eklig!");
  AddDetail("gewebe",
  "Es kriecht und schluepft und ab und zu spritzt ein Tropfen Blut heraus.");
  AddDetail("tropfen",
  "Pliiiiiitsch!!!");
 AddDetail("decke",
 "Die Decke ist recht weit oben, doch in diesem hellen Licht gut zu erkennen."
 " Du freust Dich, dass die Gekreuzigten so schoen brennen. Lange, schwarze "
 "Tentakel haengen von ihr herab und saugen Blut aus dem Gewebe am Boden.");
 AddDetail("tentakel",
 "Sie sind zwar sehr lang aber nur recht duenn. Kleine Saugnaepfe suchen "
 "unentwegt Blut am Boden");
 AddDetail("licht",
 "Die Gekreuzigten spenden ein gespentisches Licht!");
 AddDetail("sicht",
 "Die Saeulen versperren Dir etwas die Sicht, und Du bist nicht ungluecklich "
 "darueber...");
 
  
  
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus blankem, schwarzen Stein. In kurzen Abstaenden "
  "haengen die Gekreuzigten an der Wand.");
  AddDetail(({"abstand","abstaende"}),
  "Du solltest von dieser Gegend besser Abstand halten!");
  AddDetail("gegend",
  "Naja, schau Dich um...");
  
  AddDetail(({"gekreuzigte","gekreuzigter"}),
  "Die armen, gepeinigten Gekreuzigten haengen tot oder halbtot an den "
  "Waenden. Einige bruellen noch, ihr Geschrei ist kaum auszuhalten, "
  "anderen sind bereits verkohlt und glimmen still vor sich hin! Einer der "
  "Gekreuzigten schaut seltsam aus, sein Koerper haegt ziemlich lasch herum...");
  AddSpecialDetail("koerper", "shownails");
  AddDetail("geschrei",
  "AHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH!!!!!!");
  AddDetail("leben",
  "Angeblich wohnt hier ein Wesen, das mehrere Leben hat.");
  AddDetail("wesen",
  "Such es!!! Oder besser nicht...");
  
  AddDetail("halle",
  "Die Halle weist eine enorme Groesse auf. Wer hat sie wohl errichtet? "
  "Eigentlich ist alles aus Stein und sehr schlicht.");
  AddDetail("stein",
  "Der Stein ist dunkelgrau bis schwarz und weist rote Adern auf.");
  AddDetail(({"ader","adern"}),
  "Durch die Adern pulsiert Blut!!! Der Stein lebt!!!");
  AddDetail("blut",
  "Deines gerinnt vor Angst und das des Steines pocht dunkel dahin.");
  AddDetail("angst",
  "Sie steigt und steigt!");
  
  AddDetail("groesse",
  "Kaum anzuschaetzen, aber auf jeden Fall sehr gross.");
  

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "AHHHHHHH!!!!!!!!!!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verkohltem Fleisch!");
  AddExit("osten", "./k9");
  AddExit("sueden", "./k7");
    
    AddDetail(({"arme","fuesse"}),
    "Die Arme und Fuesse des Gekreuzigten gehoeren immer auch festgenagelt! "
    "Merke Dir das fuer Dein weiteres Leben!");
   AddDetail("kreuzigungsgruppe",
   "Tja, aus welchem Film koennte das wohl stammen...");
   AddDetail("film",
   "Verrate ich hier nicht, nur auf persoenliche Anfrage.");
    AddDetail(({"untersucheallesidiot","anfrage","idiot"}),
    "Stirb, dummer Untersucheallesidiot!");
    
    
 // AddGuardedExit("unten", "/d/gebirge/dante/room/k10", "tentakel",
 // "Der Tentakel haelt Dich einfach fest.\n"); 
AddSpecialExit("unten", "godown");
AddCmd(({"schlag","schlage","kreuzige"}), "donail");

AddItem("/d/gebirge/dante/npc/tent", REFRESH_DESTRUCT);    
 }
 
int donail(string str)
{
  object ob;
  object k;
  k=clone_object("d/gebirge/dante/obj/kallow");
  ob=present("NAGEL", TP);
      
  notify_fail("Was willst Du hier schlagen, annnagel...\n");
  if (!str) return 0;
  if(member(({"nagel in koerper","nagel mit hammer in koerper",
              "mit nagel", "mit hammer und nagel"}),str)!=-1)
    {
      if(!present("\nhoehlenquestbydante", TP))
        {
          write("Du bist nicht in der Lage hier irgendwas zu bewerkstelligen!\n"
                "Such den Totengraeber auf!\n");
          return 1;
        }
   
      if(!present("NAGEL", TP))
        {
          write("Ohne Naegel wird das ein Problem, oder willst Du Deine "
                "Zehennaegel in den Koerper schlagen?! \n");
          return 1;
        }
      
      if(!present("HAMMER", TP))
        {
          write("Hmm, mir den blossen Haenden wird das nichts. Man braucht "
                "dazu einen...\n");   
          return 1;
        }

      if((present("HAMMER", TP))&&(present("NAGEL", TP)))
        {
          nails++;
          if(nails==4)
            {
              ob->remove();
              write("Du schlaegst den letzen Nagel in den Koerper und "
                    "irgendwie fuehlst Du Dich nun wie ein echter Meister des "
                    "Kreuzigens.\n"
                    "Seltsam, aber die Naegel loesen sich einfach auf.\n");
              k->move(TP, M_GO);
              nails=0;
              return 1;
            }
       
          if((!nails)||(nails==1)||(nails==2)||(nails==3))
            {
              ob->remove();
              write("Du schlagst einen Nagel in den Koerper.\nSeltsam, "
                    "aber der Gekreuzigte freut sich!!!\n");
              return 1;
            }
          return 1;       
        }
      return 0;
    }
  return 0;
}

      
 int godown()
   { 
   if(present("tentakel", TO))
   {
   write("Der Tentakel laesst Dich nicht vorbei!\n");
   return 1;
   }
   else
   {
   return this_player()->move("/d/gebirge/dante/room/k10", M_GO,
   "nach unten", "geht", "kommt von oben herab");
   }
 }
   
   reset()
     {
     ::reset();
     nails=0;
     }
   
   
   string shownails()
     {
     if(!nails)
     {
     write("Der Koerper ist nur mit einem Nagel, der mitten durch "
     "die Brust geschlagen wurde befestigt. Hmm, das ist nicht korrekt!"
     " Sollte man aendern! Seine beiden Arme und Fuesse haengen schlaff "
     "herunter. Und wir, die Kreuzigungsgruppe, wollen doch ein schoenes "
     "Bild abgeben!\n");
     }
      
     if(nails==1)
       {
       write("Der Koerper ist mit 2 Naegeln befestigt. Da fehlt noch einiges, "
       "fuer eine korrekte Kreuzigung!\n");
        }
    if (nails==2)
      {
      write("Der Koerper ist mir 3 Naegeln befestigt. Schon recht passabel.\n");
      }
      if(nails==3)
      {
      write("Der Koerper ist mit 4 Naegeln befestigt. Fast eine korrekte "
      "Kreuzigung!\n");
      }
      if(nails==4)
      {
      write("WOW! Du machst Dich! 5 Naegel! Das ist eine korrekte Kreuzigung!\n");
      }
     return "";
     }
           
      
