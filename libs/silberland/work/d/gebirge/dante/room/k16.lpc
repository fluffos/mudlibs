   string show1()
     {
     if(present("TALLOW", TP))
       {
       write("Der Boden ist versaut wie sonst auch. Ein weisses Kreuz "
       "leuchtet Dich an!\n");
       }
      else
      {
      write("Der Boden ist fuer DICH noch uninteressant.\n");
      }
   return "";
   }
   string show2()
     {
       if(present("TALLOW", TP))        
       {
       write("Das Kreuz leuchtet hell und einladend.\n");
       }
       else{
       write("Das siehst Du nicht.\n");}
       return "";
       }
           
 
  string d_u()
  {
  write("Du siehst die Leiche von "+CAP_TPN+"!\n"
  "Hoppla! Das bist ja Du!\n");
  return"";
  }
  string d_a()
  {
  write("Dein Angstlevel liegt momentan bei:\n");
  switch(random(10))
  {
  case 0:
  write("Totaler Hosenscheisser.\n");
  break;
  case 1:
  write("Heulsuse!\n");
  break;
  case 2:
  write("Jammerlappen!\n");
  break;
  case 3:
  write("Weichei!\n");
  break;
  case 4:
  write("Mammas Liebling!\n");
  case 5:
  write("Wurstseher!\n");
  break;
  case 6:
  write("Superfeigling!\n");
  break;
  case 7:
  write("Warmduscher!\n");
  break;
  case 8:
  write("Windelbenutzer!\n");
  break;
  case 9:
  write("Dante!\n"
  "Haeh, was soll das heissen?!\n");
  break;
  default:write("Geh nach Midas!\n");
  }
  return "";
 }
  
