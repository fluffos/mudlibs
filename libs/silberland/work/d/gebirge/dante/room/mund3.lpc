//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>



init()
{
::init();

if(!deep_present("FLOSSEN", TP))
  {
  write("\nDu tauchst in die Zyste, kannst aber so hier nicht schwimmen, "
  "daher tauchst Du sofort wieder hinaus!\n\n");
  TP->move("d/gebirge/dante/room/mund2", M_GO+M_SILENT+M_NO_SHOW);         
}
else

if (query_once_interactive(this_player()))      
  {
  
  write("Deine Flossen beginnen sich auf einmal zu bewegen und Du kannst "
  "ohne Probleme hier schwimmen und tauchen! Kajubo hilft Dir hier aber nicht!\n");
call_out("drown", 30);
  }
}

create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einer Zyste" );
  SetProp( P_INT_LONG, BS(
  "Du bist hier in einer wassergefuellten Zyste ober dem Maul des Wesen. "
  "Es blubbert und gluckst und das Wasser ist sehr trueb. Du bist froh, dass "
  "Du soetwas nicht im Kopf hast, oder doch?"));
  
  
  AddDetail("decke",
  "An der Decke ist ein kleiner, heller Fleck. "
  "Die Decke ist die Wand der Zyste.");
  AddDetail(({"wand","waende"}),
  "Die Wand der Zyste ist grau und sehr dehnbar.");
  AddDetail("fleck",
  "Der Fleck scheint eine kleine Oeffnung zu sein, durch die man, tja, "
  "was macht man im Wasser?");
  AddDetail("oeffnung",
  "Durch sie kommt man ins Gehirn des Wesen.");
  AddDetail("boden",
  "Am Boden ist auch ein kleines Loch, durch das Du gekommen bist.");
  AddDetail("loch",
  "Tja, da gehts zum Maul.");
  AddDetail("gehirn",
  "Das Gehirn des Wesen ist ober Dir. Interessant...");
  AddDetail("wasser",
  "Das Wasser hier ist trueb und warm. Unangenehm. Du fuehlst Dich wieder "
  "wie in Bauch Deiner Mutter.");
  AddDetail("bauch",
  "Deiner wird immer fetter.");
  AddDetail(({"mutter","muetter"}),
  "Ja, Muetter, die beste Erfindung der Welt.");
  AddDetail("welt",
  "Silberland.");
  AddDetail("silberland",
  "Unsere Welt. ");
  AddDetail("erfindung",
  ":-)");
  
  AddDetail("maul",
  "Das Maul ist unter Dir, das Gehirn ober Dir.");
  AddDetail("zyste",
  "Du bist mitten drin.");
  AddDetail("kopf",
  "Du bist im Kopf des Wesen. Und die Zyste ist auch im Kopf. Du bist sozusagen "
  "in der Zyste, die Im kopf des Wesens ist.");
  AddDetail("wesen",
  "Wesen, Wesen, immer ist hier die Rede von einem Wesen. Was fuer ein Wesen? "
  "Wie heisst es ? Was tut es?");
  AddDetail("rede",
  "Lange Rede, kurzer Sinn.");
  AddDetail("sinn",
  "Keiner.");
  
  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Wasser blubbern.");
    
  AddSmell( DEFAULT_SMELL,
    "Das Wasser riecht eklig");


AddCmd(({"schwimm","schwimme","tauch","tauche"}), "out");  
 }
 
 
 out (string str)
   {
   notify_fail("Wohin willst Du tauchen?\n");
   if(str=="nach oben"||str=="in oeffnung"||str=="durch oeffnung")
     {
     write("Du tauchst durch die Oeffnung an der Decke nach oben.\n");
     TP->move("d/gebirge/dante/room/mund5", M_GO+M_SILENT);
     return 1;
     }
     if(str=="nach unten"||str=="in loch"||str=="durch loch")
     {
     write("Du tauchst durch das Loch Richtung Maul.\n");
       TP->move("d/gebirge/dante/room/mund2", M_GO+M_SILENT);         
    return 1;
    }
  
  return 0;
  }
    
   void drown()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Du solltest hier nicht ewig bleiben, denn Deine Luft wird knapp.\n");
   call_out("drown2", 60);
   }
   
 
   void drown2()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Deine Luft wird langsam knapp.\n");
   call_out("drown3", 60);
   }
   
   
   void drown3()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Deine Luft wird knapp.\n");
   call_out("drown4", 60);
   }
 
   void drown4()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Deine Luft wird immer weniger.\n");
   call_out("drown5", 60);
   }
 
   void drown5()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Deine Luft wird extrem knapp. Los raus hier!!!\n");
   call_out("drown6", 30);
   }
 
   void drown6()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Deine Luft wird extrem knapp. Los raus hier!!! SCHNELL!!!!!!\n");
   call_out("drown7", 10);
   }
 
   void drown7()
  {
   if(environment(TP)!=TO || !TP) return 0;        
   write("Du erstickst elendiglich!!!\n");
   TP->do_damage(10000);
   SetProp(P_KILL_MSG, "Mangel an Luft");
   }
 