//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

nosave int loesung, cross, fin, untkratzer, untrille, beul, krat;

create() {
  ::create();
  untrille=0;
  untkratzer=0;

  fin=random(10)+7;
  beul=random(25)+10;
  krat=random(10)+10;
  loesung=fin*beul*krat;
  cross=1;
  SetProp( P_INT_SHORT, "In der Huette des Totengraebers" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun in der Huette des Totengraebers. Sie ist karg eingerichtet, "
  "aber von einem Totengraeber erwartet man wohl kaum Prunk und Luxus. "
  "Ein altes Bett, ein Tisch und eine Bank, mehr ist hier nicht zu sehen. "
  "Viel interessanter hingegen, ist ein langes Regal, auf dem der Totengraeber "
  "besonders verunstaltete Knochen aufbewahrt."));
  
  AddDetail("regal",
  "Das Regal ist lange und aus Holz. Auf ihm bewahrt der Totengraeber "
  "seltsame Knochen auf.");
  AddDetail(({"fundstueck", "fundstuecke"}),
  "Du findest ein, nein, nichts...");
  AddDetail("knochen",
  "Grausige Fundstuecke lagern auf diesem Regal. "
  "Ein voellig deformierter Schaedel, ein kreisrunder Oberschenkel, "
  "eine Hand mit zu vielen Fingern, eine wellenfoermige Rippe...");
  AddDetail("rippe",
  "~~~~~~~~~~~~~~~~~~~~~~~~~~");
  AddDetail(({"oberschenkel","schenkel"}),
  "Der Oberschenkel ist fast so rund wie ein Kreis. Wer wohl damit "
  +"gehen musste?");
  AddDetail("kreis",
  "O");
  AddDetail("hand",
  "Die Hand weist zuviele Finger auf. Wem hat sie gehoert?");
  AddDetail("finger",
  "Es sind "+fin+" Finger.");
  AddDetail("schaedel",
  "Der Schaedel ist voellig deformiert. Er weist zahlreiche Krater und Beulen "
  "auf.");
  AddDetail(({"beule","beulen"}),
  "Die Beulen sehen lustig aus. Es sind "+beul+" Beulen.");
  AddDetail("krater",
  "Einer der Krater hat einen Kratzer. Insgesamt sind es "+krat+" Krater.");
  AddSpecialDetail("kratzer", "showkra");


  
  AddDetail("decke",
  "Die Decke ist niedrig und schwarz. Lampe siehst Du keine.");
  AddDetail("lampe",
  "Oh, da ist ja doch eine Lampe."); 
  AddDetail("boden",
  "Der Boden besteht aus langen, dunklen Holzplanken. Er ist sehr sauber.");
  AddDetail(({"planken","holzplanken","planke","holzplanke"}),
  "Zwischen den Planken ist kein Schmutz. Die Rillen sind sauber.");
  AddDetail("schmutz",
  "Nein, eben keiner...");
  AddDetail(({"rille","rillen"}),
  "Die Rillen sind recht tief. Manche noch tiefer und eine ist besonders tief, "
  "sozusagen am tiefsten.");

  AddSpecialDetail("tiefste rille", "showhebel");
  AddSpecialDetail("holzstab", "showstab");


  AddItem("d/gebirge/dante/npc/tgr", REFRESH_DESTRUCT);

  
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus Holz und kahl, bis auf eine Zeichung und ein langes "
  "Regal.");
  AddSpecialDetail("zeichung", "show");
  AddDetail("totengraeber",
  "Der Totengraeber ist wohl nicht da.");
  AddDetail("luxus",
  "Der einzige Luxus den sich der Totengraeber leistet, ist dann und wann "
  "ein gutes Glas Kreuzbier.");
  AddDetail(({"bier","kreuzbier"}),
  "Tja, frag ihn danach...");
  AddDetail("prunk",
  "Siehst Du eben nicht!");
  AddDetail("bett",
  "Das Bett ist schmal und hart. Eine alte Matratze liegt auf ihm.");
  AddDetail("matratze",
  "Die Matratze muss mindestens so alt wie das Silberland sein, so zerlumpt "
  "ist sie.");
  AddDetail("silberland",
  "Kenn ich nicht.");
  AddDetail("tisch",
  "Der Tisch ist aus Holz und ebenfalls uralt.");
  AddDetail("holz",
  "Wurmstichig und morsch.");
  AddDetail("bank",
  "Die Bank ist windschief, mann sollte sich nicht draufsetzen.");
  
  AddDetail("huette",
  "Die Huette ist klein und sehr bescheiden. Licht gibt es hier nur wenig. "
  "Es faellt durch ein schmales Fenster herein.");
  AddDetail("licht",
  "Hier ist es gerade so hell, das man etwas erkennen kann.");
  AddDetail("fenster",
  "Das Fenster liegt gegenueber der Tuer und ist wirklich sehr schmal. Es hat "
  "auch keine Glasscheiben.");
  AddDetail("tuer",
  "Die Tuer fuehrt zurueck auf den Friedhof.");
  AddDetail("friedhof",
  "Der Friedhof liegt draussen.");
  AddDetail(({"glas","scheibe","scheiben","glasscheiben","glasscheibe"}),
   "Es hat keine Scheiben mehr, was gut ist...");
     
     
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Knarren und Schaben.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
    
  AddExit("raus", "./k0");
  AddCmd(({"setze","sitz"}), "no");    
  AddCmd(({"kletter","klettere","steige","steig","spring","springe"}), "goout");
  AddCmd(({"zieh","ziehe","druecke","drueck","bewege","beweg"}), "godown");
}


int gibloesung(int versuch) {
  object ob;
  if(loesung==versuch) return 1;
  else return 0;
}
// Nur ne testfunktion, kann entfernt werden  
int GetSolution() {
  return loesung;
}

 int no(string str)
   {
   object ob;
   notify_fail("Worauf willst Du Dich setzen?\n");
   
   if (str=="auf bank")
       {
       if(!present("\nhoehlenquestbydante", TP))
         {
         write("Du setzt Dich auf die Bank, faellst zu Boden und tust Dir weh!\n");
         TP->do_amage(10);
         return 1;
         }
         if (present("\nhoehlenquestbydante", TP))
           {
           if(cross)
             {
           write("Du setzt Dich auf die Bank, faellst zu Boden, und "
           "findest am Boden ein kleines Kreuz.\n");
           ob=clone_object("d/gebirge/dante/obj/cross");
           ob->move(TP, M_GO);
           cross--;
           return 1;
           }
           if(!cross)
           {
           write("Du setzt Dich auf die Bank, faellst zu Boden und "
           "irgendetwas sagt Dir, das Du einfach warten solltest.\n");
           return 1;
           }
         return 0;
         }
      return 0;
      }
   return 0;
   }
              
          
          

   string showkra()
   {
   write("Der Kratzer weist zum Fenster...\n");
   untkratzer=1;
   return "";
   }
   

  int godown(string str)
   {
   notify_fail("Was willst Du tun?\n");
   if(!str) return 0;
   
   if(str=="holzstab"||str=="am holzstab"||str=="an holzstab")
      {
        if(!present("\nhoehlenquestbydante", TP))
          {
      write("Nein! Der Totengraeber erlaubt das nicht!\n");
      return 1;
          }
         if(!untrille)
           {
         write("Sowas siehst Du nicht.\n");
         return 1;
           }    
         if(present("\nhoehlenquestbydante", TP))
           {
           write("Du machst Dich am Holzstab zu schaffen, der Boden "
           "oeffnet sich und verschluckt Dich lautlos.\n");
           TP->move("d/gebirge/dante/room/ngr2.lpc", M_SILENT +M_GO);
           return 1;
           }
       return 0;
       }
    return 0;
    }       

  int goout(string str)
   {
   notify_fail("Was willst Du tun?\n");
   if(!str) return 0;
   
   if(member(({"aus fenster", "beim fenster raus","durch fenster","fenster"}),str)!=-1)
      {
        if(!present("\nhoehlenquestbydante", TP))
          {
      write("Nein! Der Totengraeber erlaubt das nicht!\n");
      return 1;
          }
         if(!untkratzer)
           {
         write("Das geht hier nicht.\n");
         return 1;
           }    
         if(present("\nhoehlenquestbydante", TP))
           {
        write("Du springst behende durch das Fenster.\n"),
        TP->move("d/gebirge/dante/room/hu2", M_SILENT +M_GO);
            return 1;//
           }
       return 0;
       }
    return 0;
    }       

  string show()
  {
  write("Die Zeichung zeigt den Totengraeber, wie er "+CAP_TPN+" verbuddelt. "
  "Hoppla, das bist ja DU! Na sowas...\n");
  return "";
  }
  
  string showhebel()
  {
write
("Du entdeckst in der tiefsten der tiefen Rillen einen kleinen Holzstab.\n");
  untrille=1;
  return "";
  }
  
  string showstab()
  {
  if(!untrille)
     {
  write("Sowas siehst Du nicht!\n");
     }
  if(untrille)
     {
  write("Du entdeckst einen kleinen Holzstab. Hmm, was kann man mit dem "
  "wohl machen.\n");
     }
  return "";
  }
  
  
  reset()
  {
  ::reset();
  untrille=0;
  cross=1;
  krat=10+random(10);
  untkratzer=0;
  fin=random(10)+7;
  beul=random(25)+10;
  loesung=fin*beul*krat;
  //call_out("gibloesung", 0);
  }
  
