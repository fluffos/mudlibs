//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>
int abgru;

create()
{
  ::create();
  
  
  SetProp( P_INT_SHORT, ""+ANSI_BOLD+ANSI_RED+"In einem roten Raum" );
  SetProp( P_INT_LONG, BS(
  ""+ANSI_BOLD+ANSI_RED+"Du stehst nun in einem Raum, der voellig rot ist. "
  "Rot, wie Dein Blut"+ANSI_RED+" das bald fliessen wird. "
  "Alles, wirklich alles ist rot."));
  AddDetail("farbe",
  ""+ANSI_BOLD+ANSI_RED+"Alles hier ist rot.");
  AddDetail("rot",
  "Rot, wie der Tod.");
  AddDetail("tod",
  "Kommt sofort...");
  AddDetail("decke",
  "Die Decke ist ebenfalls total rot angemalt.");
abgru=0;

  AddDetail("boden",
  "Der Boden besteht aus rotem Stein. Du findest einen kleinen Knopf.");
  AddDetail("knopf",
  "Hmm, sollte man ihn druecken?");
  AddDetail("blut",
  "Du siehst etwas Blut am Boden.");
  AddDetail("stein",
  "Der Stein ist blutrot.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind glatt und aus rotem Stein. "
  "In der Nordwand ist eine Tuer.");
  AddDetail("nordwand",
  "Du kannst den Raum durch eine Tuer in der Nordwand verlassen.");
  AddDetail("raum",
  "Du stehst mitten in einem total roten Raum.");
   AddDetail("tuer",
   "Die Tuere fuehrt nach Norden.");
   AddSpecialDetail(({"abgrund","norden"}),"show");
   
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst alles sehr rot.");
AddItem("d/gebirge/dante/npc/kmred", REFRESH_DESTRUCT);
AddSpecialExit("norden", "colorme");
AddCmd(({"drueck", "druecke"}), "go");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blut...");
    
 }

int go(string str)
  {
    notify_fail("Was willst Du mit dem Knopf machen?\n");
      if(!str) return 0;
           if(str=="knopf")
                    {
    if(!abgru)
{
           write("Du drueckst den Knopf und auf einmal "
                      "schliesst sich der Abgrund von alleine.\n");
                                 abgru=1;
                   call_other("d/gebirge/dante/room/k20", "open");              
                                            return 1;
                  }
   
           if(abgru)
                     {
          write("Du drueckst den Knopf und der Abgrund oeffnet sich wieder.\n");
                        abgru=0;
             call_other("d/gebirge/dante/room/k20", "close");
             tell_room("d/gebirge/dante/room/k20",
             "Der Abgrund oeffnet sich wieder.\n");
                                         
                        return 1;
            }
            return 0;
        }
        return 0;
     }
     
   reset()
   {
   ::reset();
   abgru=0;
   
   tell_room("d/gebirge/dante/room/k20",
   "Der Abgrund oeffnet sich wieder.\n");
   
   tell_room("d/gebirge/dante/room/kred",
   "Der Abgrund oeffnet sich!\n");
   call_other("d/gebirge/dante/room/k20", "open");
   }
   
   close()
    {
    abgru=1;
    }
    
    open()
    {
    abgru=0;
    }
    
string show()
   {
   if(!abgru)
     {
   write("Im Norden tut sich ein tiefer Abgrund auf.\n");
      }
   if(abgru)
     {
   write("Hmm, der Abgrund ist nicht mehr da.\n");
     }
   return"";
   }


int colorme()
    {
    if(!abgru)
    {
    return TP->move("/d/gebirge/dante/room/dead2",M_GO,
    "in den Abgrund", "stuerzt","kommt von weot oben herabgeflogen");
    }
    if(abgru)
    {
    return TP->move("d/gebirge/dante/room/k20",M_GO,
    "nach Norden", "geht", "kommt aus dem Sueden");
    }
 }
                                                                    