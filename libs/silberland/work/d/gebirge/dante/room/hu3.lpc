//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int buch;

create()
{
  ::create();
  buch=1;
  SetProp( P_INT_SHORT, "In einer sehr kleinen Luecke" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun hier in diese winzige Luecke gefluechtet. Kein Licht "
  "dringt hier herein und ohne eine Lichtquelle ist es stockdunkel. "
  "Die Waende stehen hier still, hier droht Dir keine Gefahr. Direkt "
  "ober Dir liegen viele Tonnen Gestein, vor Dir die Luecke, die Dir "
  "Dein Leben gerettet hat."));
  AddDetail("luecke",
  "Durch sie kommst Du wieder zurueck.");
  AddDetail("licht",
  "Wenn Du das untersuchen kannst, hast Du Licht.");
  AddDetail("boden",
  "Nackter Fels.");
  AddDetail("decke",
  "Tonnen von Gestein liegen ueber Dir.");
  AddDetail("gestein",
  "Schwer, grau, dunkel...");
  AddDetail("fels",
  "Ringsum Dich nur Fels!");
  AddDetail("gefahr",
  "Hier bist Du vorerst sicher.");
  AddDetail(({"tonnen","tonne"}),
  "Hmm, sicher sehr viele. Nun erst endeckst Du ober Dir eine Malerei.");
  AddDetail("malerei",
  "**********************\n"
  "*                    *\n"
  "* Freitznghgtzetzr   *\n"
  "*        x           *\n"
  "* Bswertughlbneedn   *\n"
  "*        x           *\n"
  "* Kayripaqatcvebnr   *\n"
  "*        =           *\n"
  "* Lscofgevbsjkuwuntzg*\n"
  "*                    *\n"
  "**********************\n"
  "\n\n"
  "Ein kleiner Tip: systax: raetsel <antwort>\n");
     
  AddDetail("lichtquelle",
  "Die beste Lichtquelle ist die Papaya in Tijara.");
  AddDetail(({"papaya", "tijara"}),
  "Solltest Du kennen!");
  
  AddDetail(({"wand", "waende"}),
  "An den Waenden auch nur blanker Fels. Manchmal rinnt ein Tropfen "
  "Wasser herunter.");
  AddDetail("wasser",
  "Kuehl und feucht.");
  AddDetail("tropfen",
  "Hmmm, unter den Tropfen erkennst Du eine seltsame Apparatur.");
  AddDetail("apparatur",
  "Die Apparatur besteht aus vielen kleinen Steinen.");
  AddDetail(({"steine", "stein"}),
  "Du siehst Steine mit Kratern, Steine mit Beulen und"
   " Steine mit Rillen.");
  AddDetail(({"beulen", "beule"}),
  "Ja, manche Steine haben Beulen.");
   AddDetail(({"krater","kratern"}),
   "Auch Krater siehst Du auf den Steinen.");
   AddDetail(({"rille", "rillen"}),
   "Auch Steine duerfen Rillen haben. Irgendwie sehen diese Rillen wie "
   "Finger aus.");
   AddDetail("finger",
   "Ja genau, sie sehen wie Finger aus.");
   
    
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_MOUNTAIN]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das Droehnen des Gesteins.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
AddCmd(({"krieche","kriech", "zwaenge","fluechte"}), "out2");
AddCmd(({"raetsel"}), "zahlen");
}
   
reset() {
  ::reset();
  buch=1;
}
   
int korrekt() { 
   object ob;

    write("Tief aus dem Felsen spricht eine dunkle Stimme:\n"
    ""+TPN+", waer haette das gedacht. So dumm wie alle hier sagen, "
    "bist Du doch gar nicht. Hier ist Deine Belohnung!\n");
    ob=clone_object("d/gebirge/dante/obj/hbuch");
    ob->move(TP, M_GO|M_NOCHECK);
    buch=0;
    return 1;
 }
 
int falsch() {
   write("Nein, das ist leider falsch!\n"
   "Ein Fels ober Dir wackelt, kleine Truemmer treffen genau Deinen Kopf!\n"
   "WUMMMM!!! Das tut weh!\n");
   TP->do_damage(10);
   return 1; 
 }
      
int zahlen(string str) {
  int zahl, richtig;
  notify_fail("Nein, leider falsch!\n");
  if (!str) return 0;
  zahl=to_int(str);
  richtig=call_other("d/gebirge/dante/room/hu", "gibloesung", zahl);
  if(richtig) 
    korrekt();
  else 
    falsch();
  return 1;
}
      


  int out2(string str)
    {
    notify_fail("Wie willst Du hier fluechten?\n");
    if (str=="durch luecke"||str=="in luecke")
      {
      write("Du machst Dich ganz klein und kriechst durch die Luecke!\n");
      TP->move("d/gebirge/dante/room/hu3", M_GO+M_SILENT);
      return 1;
      }
  return 0;
  }    





