//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>



int heal;

create()
{
  ::create();
heal=2+random(3);

AddDetail("erde",
"Die Erde ist hier rot. Blutrot. Irgendjemand muss hier verblutet sein. "
"Man sieht teilweise noch das Blut im Boden versickern...");
AddDetail("blut",
"Hmm, man muesste Vampir sein...");
AddDetail("vampir",
"Sei froh, hier ist keiner, oder doch...");

AddCmd(({"trink", "trinke"}), "heilen");
 
 AddItem("d/gebirge/dante/npc/igeist", REFRESH_DESTRUCT);
 
 AddItem("d/gebirge/dante/npc/wag", REFRESH_DESTRUCT);
AddExit("sueden", "./g2");
AddExit("westen", "./g8");
AddExit("osten", "./g9");

}

int heilen (string str)
   {
   notify_fail("was willst Du hier trinken!?\n");
   if (!str) return 0;
      if (heal)
         {
         TP->heal_self(15+random(20));
         write("Du schluerfst etwas Blut vom Boden. Hmmm, Vampire habens gut!\n");
         domainshout(""+TPN+" schluerft Blut wie ein Vampir!\n");
         heal--;
         return 1;
         }
     if (!heal)
        {
        write("Du trinkst vom Blut, waeh, ist das eklig!\n");
        return 1;
        }
    return 0;
    }
   
   
   reset()
     {::reset();
     heal=2+random(3);
     }
                      