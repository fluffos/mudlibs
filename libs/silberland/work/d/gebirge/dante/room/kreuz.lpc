//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>

int open;

int schlafend;
string schlaf;

create()
{
  ::create();
open=0;
schlafend=0;

  SetProp( P_INT_SHORT, "Im Wohnraum von Zok und Zak" );
  SetProp( P_INT_LONG, BS(
  "Hier wohnen die beiden Gehilfen von Vlad, Zok und Zak. Wie "
  "Du unschwer erkennen kannst, sind die beiden faul und schlampig. "
  "Haemmer, Naegel, fertige und unfertige Kreuze liegen wild verstreut "
  "im Raum herum. Zak und Zok schlafen beide auf dem Nagelbrett, das "
  "in einer der Ecken steht. Eine grosse "+ANSI_BOLD+ANSI_PURPLE+"violette Kiste"
   ""+ANSI_NORMAL+" steht noch herum, mehr besitzen die beiden nicht."));
  
  AddSpecialDetail(({"nagelbrett","brett"}),"t");
  
  
  AddDetail("igel",
  ":)");
  AddDetail("spiesse",
  "Die Spiesse, hier ohne scharfem s, ragen aus dem Brett hervor und sehen "
  "einladend aus.");
  AddDetail(( {"ecke","ecken"}),
  "Es gibt derer 4 und in einer steht eine grosse Kiste.");
  AddDetail("kiste",
   ""+ANSI_BOLD+ANSI_PURPLE+"Die Kiste sieht enorm interessant aus. "
   "Sie ist sicher extrem wichtig. "
  "Nur Zak und Zok lassen Dich sicher nicht ran. Wenn Du Vlad waerst, wuerden "
  "sie kuschen, aber so..."+ANSI_NORMAL+"");
  AddDetail("boden",
  "Der Boden ist auch uebersaeht mit Naegeln und Dreck.");
  AddDetail("dreck",
  "Naja, sauber ist es hier nicht.");
  AddDetail("decke",
  "An der Decke haengt eine alte Lampe.");
  AddDetail("lampe",
  "Die Lampe wurde aus einem Becken gemacht. Irgendwie reflektiert sie etwas.");
  AddDetail("becken",
  "Es handelt sich um das Becken einer Zwergenfrau.");
  AddDetail(({"frau","zwerg","zwergenfrau"}),
  "Sie hies Dusty , hmm oder so aehlich.");
  AddDetail("dusty",
  "Mail ihr das sofort!");
  AddDetail("etwas",
  "Ja, das etwas ist eine Reflexion.");
  AddDetail("reflexion",
  "Sie reflektiert den Deckel der Kiste.\n");
  AddSpecialDetail("deckel","show");
  AddDetail(({"nagel","naegel"}),
  "Die Naegel dienen zum annageln der Opfer. Auch klar...");
  AddDetail("opfer",
  "Hmm, vielleicht wirst ja Du auch eines.");
  
  AddDetail(({"wand","waende"}),
  "An der Wand haengen Haemmer und Kreuze. In der Westwand ist ein Tor.");
  AddDetail("tor",
  "Tor, Tor, i werd narrisch!");
  AddDetail("westwand",
  "Die Westwand weist ein Tor auf das nach Westen fuehrt:)))");
  AddDetail("westen",
  "Nach Westen kannst Du gehen!");
  AddDetail(({"hammer","haemmer"}),
  "Die Haemmer dienen einerseits zum fertigen der Kreuze, andererseits zum "
  "einschlagen der Naegel, aber das weisst Du ohnehin schon.");
  AddDetail(({"kreuze","kreuz"}),
  "Die Kreuze dienen zum kreuzigen, logisch, manche sind schon fertig, "
  "andere erst in Arbeit.");
  AddDetail("arbeit",
  "Die wird von Zok und Zak getan.");
  
  AddDetail("raum",
  "Das ist der Wohnraum von Zak und Zok.");
  AddDetail(({"gehilfen","gehilfe"}),
  
  "Zak und Zok sind die beiden Gehilfen von Vlad.");
  AddDetail("vlad",
  "Vlad der Pfaehler, solltest Du kennen.");
  AddDetail("pfaehler",
  "Naja, was tut der wohl.");
  AddDetail("wohnraum",
  "In dem befindest Du Dich!");
  AddDetail("zak",
  "Scheint nicht da zu sein!");
  AddDetail("zok",
  "Ist scheinbar nicht anwesend.");
  


AddItem("/d/gebirge/dante/npc/zak", REFRESH_DESTRUCT);
AddItem("/d/gebirge/dante/npc/zok", REFRESH_DESTRUCT);



  SetProp( P_LIGHT, 1);
    SetProp( P_INDOORS, 1 );
      SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
        AddSound( DEFAULT_SOUND,
            "Du hoerst das Bruellen von Gekreuzigten!");
        AddSmell( DEFAULT_SMELL,
            "Es riecht nach Zok und Zak.\n");    


AddExit("westen", "./k6");
   AddCmd(({"lege","lieg","schlaf","schlafe"}), "sleep");         
AddCmd(({"oeffne"}), "op");
AddCmd(({"kletter","steig"}), "go");
AddCmd(({"schliesse","schliess"}), "zu");

 }
 
 int sleep(string str)
   {object ob;
   notify_fail("Wo willst du schlafen, liegen?\n");
   
   
   if(str=="nagelbrett"||str=="brett"||str=="auf brett"||str=="auf nagelbrett")
   {
   if(schlafend)
     {
     write("Nein, das geht nicht im Moment liegt "+schlaf+" auf dem Nagelbrett.\n");
     return 1;
     }
     if(!schlafend)
     {
     write("Du legst Dich auf das Nagelbrett, seltsam es ist sehr gemuetlich.\n"
     "Du schlaefst augenblicklich ein und beginnst zu traeumen...\n");
    schlaf= this_player()->name()  ; 
     
    ob=clone_object("d/gebirge/dante/obj/traum");
    ob->move(TP, M_GO);
    schlafend++;
    call_out("erwacht", 80);
    return 1;
          }
    return 0;
       }
     return 0;
    }
    
       erwacht()
       {
       schlafend=0;
       }
       //frueher mit nem call_other aber egal
         
 
 int zu(string str)
    {
    notify_fail("Was willst Du schliessen?\n");
    if(open)
      {
      write("Du schliesst die Kiste.\n");
      open=0;
      return 1;
      }
      if(!open)
      {
      write("Die Kiste ist schon geschlossen.\n");
      return 1;
      }
   return 0;
   }
      
    
    
    
int go(string str)
   {
   notify_fail("Wo willst Du hineinsteigen!\n");
   if(!str) return 0;
  if((str=="in kiste")&&(!open))   
    {
    write("Du willst in die geschlossene Kiste klettern, faellst dabei "
    "aber genau aufs Nagelbrett. AUA!!!\n");
    TP->do_damage(10);
    return 1;
    }
    if((str=="in kiste")&&(open))    
      {
      
      if(!present("keyvio", TP))
        {
        write("Du willst in die Kiste steigen, aber irgendetwas fehlt Dir.\n");
        return 1;
        }
        else
        {
        
      open=0;
      write("Du steigst in die grosse Kiste. Hinter Dir faellt der Deckel zu.\n");
      TP->move("d/gebirge/dante/room/kiraum", M_GO+M_SILENT);
      return 1;
      }
   return 0;
   }
return 0;
}



   string show()
       {
       if(open)
          {
          write("Der Deckel der Kiste ist hochgeklappt.\n");
          }
          if(!open)
          {
          write("Der Deckel der Kiste ist geschlossen.\n");
          }
   return "";
   }
   
   
   
  int op(string str)
    {
    notify_fail("Was willst Du hier oeffnen?n");
    if(!str) return 0;
    if(open)
      {
      write("Die Kiste ist bereits geoeffnet.");
      return 1;
      }
      if(!open)
      {
      write("Du oeffnest die Kiste und klappst den Deckel hoch.\n");
      open++;
      return 1;
      }
   return 0;
   }
      
reset()
   {
   ::reset();
   open=0;
   }
   
   
   
   
   string t()
     {
     if(!schlafend) 
  {
write("Auf dem Nagelbrett schlafen Zok und Zak, angenehm kann das nicht sein. "
  "Viele kleine Spiesse ragen heraus, sieht irgendwie einem flachen Igel "
  "aehnlich. Im Moment liegt niemand oben.\n");
  }
  
  if(schlafend!=0)
    {
    write(
  "Auf dem Nagelbrett schlafen Zok und Zak, angenehm kann das nicht sein. "
  "Viele kleine Spiesse ragen heraus, sieht irgendwie einem flachen Igel "
  "aehnlich. Im Moment liegt aber "+schlaf+" oben.\n");
  }
    return "";
    }
    