//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int da,wieoft,q, gefragt;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Grab unter der Huette des Totengraebers");
  SetProp( P_INT_LONG, BS(
  "Du steckst hier mitten in einem Haufen modriger, stinkender Leichen. "
  "Ueberall liegen sie herum. Auf Dir, unter Dir, neben Dir. Fast musst "
  "Du Dich uebergeben. Manche sind halbverwest, andere recht frisch. "));
  
  AddDetail("decke",
  "Die Decke besteht ebenfalls aus Leichen.");
  AddDetail("haufen",
  "Dieser Haufen aus Leichen hat sich mit der Zeit hier angesammelt. "
  "Kreuz und quer liegen die Toten herum. ");
  AddDetail("zeit",
  "Zu spaet fuer Dich!");
  AddDetail(({"leiche","leichen"}),
  "Ueberall liegen sie verstreut umher. Manche sind frisch, andere uralt. "
  "Eine der Leichen grinst. Was soll das? Lacht sie Dich aus?!");
  AddDetail(({"grinsen", "lachen"}),
  "Das Grinsen der Leiche scheint boesartig zu sein. Lass Dir das nicht gefallen, "
  "noch dazu wo diese Leiche die Leiche eines Idioten ist.");
  AddDetail("idiot",
  "Irgendwie will Dich der Idiot was fragen, aber kann nicht? Also "
  "musst es wohl Du tun?!\n");
  
  AddDetail("boden",
  "Der Boden besteht aus Leichen. Erde kann man hier nicht erkennen.");
  AddDetail("erde",
  "Nein, keine Erden.");
  AddDetail(({"wand","waende"}),
  "Die Waende bestehen ebenfalls aus Leichen. Sie sind einfach ueberall, naja "
  "wie das halt so ist in Massengraebern.");
  AddDetail(({"massengrab","massengraeber"}),
  "Dutzende Tote wurden hier verbuddelt, angeblich aus weniger Tote. "
  "Irgendein boeser Magier soll hier Spieler bei lebendigem Leib vergraben "
  "haben...");
  AddDetail(({"tote","toter"}),
  "Einer der Toten liegt sehr seltsam da. Sein Koerper wirkt voellig erhalten.");
  AddDetail("leib",
  "Schrecklich muss das gewesen sein...");
  AddSpecialDetail("magier", "cry");
  
  AddDetail("spieler",
  "Naja, diese Spieler waren wohl frech.");
  AddDetail("koerper",
  "Der Koerper scheint frisch zu sein. Irgendwie lecker.");
  
  
  da=1;
  gefragt=0;
  wieoft=0;
  q=random(5)+10;
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddDetail("gelbe leiche",
  "Auf ihrer Stirn hat jemand etwas eingebrannt.");
  AddDetail("stirn",
  "Das steht etwas. Lies es.");
  AddReadDetail("etwas",
  "Liebe Spieler! Wehrte Seher!\n"
  "Solltest Du hier raus wollen, geht das einfach mir <mirreichts>.\n"
  "Euer Dante\n");
    
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Leichen. Eine der Leichen sieht schon ganz gelb aus.");
  
  
 AddItem("d/gebirge/dante/npc/kmade2.lpc", REFRESH_DESTRUCT);   


 AddCmd("mirreichts", "raus");   
AddCmd(({"frag","frage"}),"get");
AddCmd(({"koste","iss","friss","kost", "beisse","beiss"}),"out"); 
AddCmd("loesung", "come");
}

  raus()
  {
  write("Dir reichts, verstehe ich.\n");
  TP->move("d/gebirge/dante/room/ngr2", M_GO+M_SILENT);
  return 1;
  }
  


  int out(string str)
   {
   notify_fail("Was willst Du hier kosten?!\n");
   if(!str) return 0;
   
   if(member(({"koerper", "in koerper"}),str)!=-1)
     {
     write("Du kostest den Koerper und vor lauter Ekel springst "
     "Du aus dem Leichenhaufen heraus.\n");
     TP->move("/d/gebirge/dante/room/ngr4.lpc", M_SILENT+ M_GO);
     return 1;
     }
  return 0;
  }
     
   
  int come(string str)
    {
    object ob;
  notify_fail("Was ist die Loesung?\n");
  if (!str) return 0;
    
    if(!da)
    {
    write("Der Idiot sagt: Lass mich in Ruhe, komm spaeter wieder.\n");
    return 1;
    }
    if(present("gi", environment(TP)))
      {
      write("Der Idiot sagt: Aber mein Geist ist doch schon hier!\n");
      return 1;
      }
           
     if(!gefragt)
       {
       write("Was willst Du hier beantworten?\n");
       return 1;
       }
     
     if(gefragt)
        {
        if(str=="aufdieseskannkeinerkommen")
           {
           write_file("/d/gebirge/dante/log/betrug",
    ctime()+": "+capitalize(getuid(PL))+" kennt den Code.\n");
      write("Hmm, richtig aber nuetzt Dir nix.\n");
      //eigentlich sinlos
      return 1;
           }
           
     if(str!="aufdieseskannkeinerkommen")
       {
       if(wieoft < q)
           {
       write("Der Idiot grinst und sagt spoettisch:\n"
       "Du bist ja zu bloed fuer alles. So ein Idiot wie Du muss "
       "sicher alles 1000mal probieren.\n");
       wieoft++;
       return 1;
       }
       

       if(str!="aufdieseskannkeinerkommen")
              {
            if(wieoft>=q)   
                {
        write("Der Idiot grinst und sein Geist erscheint.\n");        
        da--;
        wieoft=0;
        ob=clone_object("/d/gebirge/dante/npc/gi.lpc");
        ob->move(environment(TP), M_NOCHECK);
        return 1;
        }
     return 0;
     }
  return 0;
    }
  return 0;
  }      
return 0;
}
 
 
 
 
      
string cry()
  {
  shout(""+CAP_TPN+" ruft: Magier sind bloed und stinken!\n");
  return "";
  }

reset()
{
::reset();
da=1;
q=random(5)+10;
gefragt=0;
}

int get(string str)
    {
    object ob;
    notify_fail("Was willst Du beruehren?\n");
    if(!str) return 0;
    
    if(member(({"idiot","idiot was","idiot frage"}),str)!=-1)
       {
    
         
     if(!da)         
         {
         write("Du fragst den Idioten, aber er grinst nur dumm. Wie Idioten "
         "eben so sind.\n");
         return 1;
           }
    if(da)
         {
         gefragt++;
        write("Du fragst den Idioten und grinsend fragt er Dich:\n");
        write("3 Idioten gehen in eine Bar. Der 1. bestellt einen "
        "Traktor auf Weissbrot. Der 2. fragt nach seinem Namen, der "
        "3. sabbert den Wirt an. Der Wirt, ein Glas Erde, sagt: "
        "Ja, meine Frau, der Ofen, meint das auch oft.\n"
        "Wie alt ist der 3. Idiot, wo ist die Bar und warum "
        "rede ich soviel Mist? Multipliziere die Ergebnisse und teile sie "
        "durch die Anzahl der Haare der Wirtin!\n"
        "loesung <antwort>\n");
        return 1;
        }
    return 0;
    }    
  return 0;
  }      
                   
         
