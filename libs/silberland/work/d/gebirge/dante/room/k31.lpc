//im reich der runenmaenner, hmm 3 EBENE der katakomben oder 4?

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"




create()
{
  ::create();


  SetProp( P_INT_SHORT, "In einem dunklen Schacht" );
  SetProp( P_INT_LONG, BS(
   "Du steckst in einem Schacht, der aus blanken Stein gehauen wurde. "
   "Er fuehrt tief nach unten in die Dunkelheit. Die Waende sind ueber und "
   "ueber mit seltsamen Zeichen bemalt."));

AddDetail("schacht",
"Schmal, dunkel und unfreundlich.");
AddDetail("stein",
"Der Stein ist recht glatt und schwarz. Er ist ueber und ueber mit Runen "
"bedeckt.");
AddDetail("dunkelheit",
"Tja, wie das eben so mit der Dunkelheit ist, man sieht nicht viel in ihr...");
AddDetail("decke",
  "Naja, sowas wie eine Decke sieht man hier natuerlich nicht, "
  "aber ein Loch durch das man nach oben kann...");
  AddDetail("loch",
  "Das Loch fuehrt nach oben.");
  AddDetail("boden",
  "Boden gibt es hier auch kaum, wenn schon einen sehr schiefen, der steil nach unten fuehrt.");
  AddDetail(({"wand", "waende"}),
  "Die Waende sind glatt, manchmal ein Kratzer oder eine kleine Erhebung, "
  "aber was Dich wirklich interessiert sind die seltsamen Zeichen an der Wand. "
  "Fackeln erhellen den Schacht und tauchen alles in ein gespentisches Licht!");
  AddDetail("licht",
  "Dunkle Schatten tanzen an den Waenden.");
  ASD(({"schatten"}), "come_shadow");
  AddDetail("zeichen",
  "Die Zeichen sind Runen, und sind ueberall.");
  AddDetail(({"rune", "runen"}),
  "Kunstvoll sind sie teils eingemeiselt, teils an die Wand gemalt. Leider "
  "sagen sie Dir nichts. Oder doch? Probier halt eine Rune zu lesen...");
  AddReadDetail("rune",
  "Hmm, Du glaubst folgendes zu entziffern:\n"
  "Fremder, sei auf der Hut, Du betritst das Reich der Runenmaenner.\n");
  AddDetail("kratzer",
  "Laenglich oder auch nur kurz fuehren sie ueber die Waende.");
  AddDetail("erhebung",
  "Die Erhebungen sind auch nicht viel interessanter.");
     
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen unter Dir.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
  
  AddExit("oben", "./k30"); 
  AddSpecialExit("unten", "nix");
  
 }

  int nix()
 {
 write("Du wagst Dich nicht nach unten!\n");
 return 1;
 }
 

  string come_shadow()
    {
    object ob;
        if(present("schatten", environment(TP)))
        {
        write("Ein Schatten huscht um Dich herum!\n");
        }
        else
        {
        ob=clone_object("/d/gebirge/dante/npc/schatten");
        ob->move(TO, M_NOCHECK);
        ob->Kill(TP);
        write("Ein Schatten stuerzt sich ploetzlich auf Dich!\n");
        }
   return "";
   }
        
