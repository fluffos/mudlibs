//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
int heal;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer geheimen Kammer" );
  SetProp( P_INT_LONG, BS(
   "Du stehst mitten in dem grauen Felsen in einer geheimen Kammer. "
   "Um Dich herum nichts als Stein. Die Waende scheinen Dich fast zu erdruecken "
   "und Du bekommst Atemnot. Eine verfallene Treppe fuehrt nach unten, "
   "doch ob es klug ist sie zu benutzen..."));
   AddDetail("treppe",
   "Sie scheint noch benutzbar zu sein. Wohin sie fuehrt, kann man allerdings "
   "nicht erkennen...");
   AddDetail(({"not","atemnot"}),
   "Eng und beklemmend ist es hier.");
     
AddSpecialDetail("kopf", "d_wumm");
AddDetail("stein",
"Hier scheint alles aus Stein zu sein. Kalt, grau und hart.");
  
  AddDetail("decke",
  "Die Decke ist so niedrig, dass man sich leicht den Kopf anstossen kann.");
  AddDetail("boden",
  "Am Boden liegt nur etwas Staub, sonst scheint er sauber zu sein.");
  AddDetail("staub",
  "Der Staub ist grau und schwer und liegt wie ein Mantel des Todes "
  "ueber dieser Kammer.");
  AddDetail("mantel",
  "Wird er auch Dich umhuellen?");
  AddDetail("tod",
  "Der Tod koennte Dich bald ereilen.");
  AddDetail("kammer",
  "Du stehst mitten in ihr drinnen.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus grobem Stein, wie halt felsen so sind. An der Nordwand "
  "faellt Dir etwas auf. Die Suedwand scheint auch interessant zu sein. In "
  "der Ostwand siehst Du ein kleines Tor, das irgendjemand in den Fels "
  "geschlagen hat.");
  AddDetail(({"fels","felsen"}),
  "Du stehst mitten in dem grossen, grauen Felsen. Man koennte auch sagen, "
  "Du bist von Fels umgeben. Andere nennen das auch eingeschlossen von Fels.");
  AddDetail("ostwand",
  "In der Ostwand siehst Du ein kleines Tor.");
  AddDetail("tor",
  "Du bist einer und siehst eines. Spassig was?!");
   
  
  AddDetail("suedwand",
  "Die Suedwand hat weder Runen noch Tueren, doch erkennt man eine "
  "kleine Zeichung.");
  AddDetail(({"tuere","tuer"}),
  "NEIN!");
  AddDetail("zeichung",
  "Du siehst ein Kreuz, auf das irgendjemand genagelt wurde.");
  AddDetail("kreuz",
  "Das Kreuz scheint so plastisch zu sein. Irgendwie real. Der Gekreuzigte "
  "scheint zu flehen...");
  AddDetail(({"gekreuzigter","gekreuzigter"}),
  "Hmm, vielleicht, nein, das waere ja zu dumm. Hmm, doch, hilf doch "
  "irgendwie dem Gekreuzigten!");
  AddDetail(({"nordwand","etwas"}),
  "Seltsame Runen aus laengst vergangenen Tagen sind kaum mehr zu erkennen.");
  AddDetail(({"tage","tag"}),
  "Dieser wird Dein letzter sein!");
  AddDetail(({"runen","rune"}),
  "Du kannst sie lesen!");
  AddReadDetail(({"runen","rune"}),
  "TkrZ Ghtz loKIuT HGVIm RutuZReW");
  
  

  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Eigentlich riecht es hier nach nichts.");
    
AddCmd(({"rette","befreie","befrei","erloese","erloes"}), "out");
  AddExit("osten", "./k0");
  AddItem("/d/gebirge/dante/npc/km8", REFRESH_DESTRUCT);
  AddExit("westen", "./fkammer");
    
  AddGuardedExit( "unten", "/d/gebirge/dante/room/k2", "lehmfigur",
  "Die Lehmfigur sagt freundlich aber bestimmt:\n"
  "Nein, tut mir leid! Das ist zu gefaehrlich fuer Dich!\n"
  "Ich meine es nur gut mit Dir, glaub mir bitte!\n");
 }




  out(string str)
{
notify_fail("Was willst Du hier tun?\n");
if (!str) return 0;
   if (str=="gekreuzigtem"||str=="gekreuzigter")
   {
   if(heal)
   {
   write("Du willst dem Gekreuzigtem helfen, doch alles ist nur ein "
   "Trugbild. Trotzdem, Dein guter Wille wird belohnt. Du bekommst "
   "als Dank etwas Lebensenergie!\n");
   heal--;
   TP->heal_self(random(10)+25);
 return 1;
       }
       if(!heal)
       {
       write("Du wilslt dem Gekreuzigtem Helfen, doch alles ist nur ein Trugbild. "
       "Du solltest besser zu einem Psychiater...\n");
       return 1;
       }
       
       return 0;
    }
 return 0;
 }
    
 


string d_wumm()
  {
  write("WUMMM!!!Und schon hast Du Dir den Kopf angeschlagen!\n");
  say(CAP_TPN+" schlaegt sich den Kopf an!\n");
  TP->do_damage(5);
  return "";
  }


reset()
  {
  ::reset();
  heal=random(3)+3;
  }