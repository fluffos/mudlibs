//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Grab" );
  SetProp( P_INT_LONG, BS(
  "Hier ist es auch nicht viel aufregender. Erde, Erde nichts Erde. "
  "Die Waende, der Boden, die Decke, nur Erde."));
  
    
  AddDetail("boden",
  "Braune Erde.");
  AddDetail("decke",
  "Sie nur aus Erde.");
  AddDetail("erde",
  "Braune, weiche Erde.");
  AddDetail(({"wand", "waende"}),
  "Die Waende bestehen ebenfalls nur aus Erde.");
  AddDetail(({"grab", "graeber"}),
    "Du stehst eigentlich in einem.");
    AddDetail(({"geist", "geister"}),
    "Die Geister leben hier unten.");
    
  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
  
  AddItem("/d/gebirge/dante/npc/pgeist", REFRESH_DESTRUCT);
    
  AddExit("sueden", "./gprie");
  

}
