//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


int way;

create()
{
::create();
way=1+random(4);
AddExit("norden", "./g8");
AddExit("osten", "./g2");
AddExit("westen", "./g6");
AddExit("sueden", "./g4");
AddDetail(({"weg", "wege"}),
"Die Wege fuehren hier in 4 Richtungen.");
AddSpecialDetail(({"richtungen","richtung"}), "get");
AddCmd(({"verneige", "verbeuge", "verneig", "verbeug"}), "get2");
}

  int get2(string str)
     {
     notify_fail("Wohin willst Du Dich verneigen?!\n");
     if (!str) return 0;
     
     if((way==1)&&(str=="nach norden"||str=="norden"))
        {
        write("Du verneigst Dich nach Norden, und hoerst ein "
        "lautes Rumpeln. Wo genau das herkam, weisst Du nicht.\n");
        call_other("d/gebirge/dante/room/g2", "open_door");
        return 1;
        }
        
 
     if((way==2)&&(str=="nach sueden"||str=="sueden"))
        {
        write("Du verneigst Dich nach Sueden, und hoerst ein "
        "lautes Rumpeln. Wo genau das herkam, weisst Du nicht.\n");
        call_other("d/gebirge/dante/room/g2", "open_door");
        return 1;
        }
        
      
     if((way==3)&&(str=="nach westen"||str=="westen"))
        {
        write("Du verneigst Dich nach Westen, und hoerst ein "
        "lautes Rumpeln. Wo genau das herkam, weisst Du nicht.\n");
        call_other("d/gebirge/dante/room/g2", "open_door");
        return 1;
        }
     
     if((way==4)&&(str=="nach osten"||str=="osten"))
        {
        write("Du verneigst Dich nach Osten, und hoerst ein "
        "lautes Rumpeln. Wo genau das herkam, weisst Du nicht.\n");
        call_other("d/gebirge/dante/room/g2", "open_door");
        return 1;
        }
     else
       {
       write("Keine Deiner Handlungen bewirkt irgendwas...\n");
       return 1;
       }
   return 0;
   }
          
        
        
    
        
        
   
        

  string get()
   {
    if(way==1)
      {
      write("Der Norden scheint Dir besonder zu gefallen. Zolle im Respekt!\n");
      }
      
      if(way==2)
      {
      write("Der Sueden ist was ganz besonderes. Verehrer Ihn!\n");
      }
      
      if(way==3)
      {
      write("Der Westen ist was ganz besonderes. Verehrer Ihn!\n");
      }
        
      if(way==4)
      {
      write("Der Osten ist besonders gut. Zeig ihm Deine Hochachtung!\n");
      }
    return "";
    }
      
 reset()
   {
   ::reset();
   way=1+random(4);
   }
   