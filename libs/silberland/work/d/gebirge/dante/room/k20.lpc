//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>

int abgru;

create()
{
  ::create();


  SetProp( P_INT_SHORT, ""+ANSI_GREEN+ANSI_BOLD+"In einem dunklen Schacht" );
  SetProp( P_INT_LONG, BS(
   ""+ANSI_GREEN+ANSI_BOLD+"Du steckst in einem Schacht, der aus blanken Stein gehauen wurde. "
   "Er fuehrt tief nach unten in die Dunkelheit. Die Waende sind ueber und "
   "ueber mit seltsamen Zeichen bemalt. Im Sueden kann man durch eine "
   "schmale Tuer einen Raum betreten."));

AddDetail("schacht",
"Schmal, dunkel und unfreundlich.");
AddDetail("stein",
"Der Stein ist recht glatt und schwarz. Er ist ueber und ueber mit Runen "
"bedeckt.");
AddDetail("dunkelheit",
"Tja, wie das eben so mit der Dunkelheit ist, man sieht nicht viel in ihr...");
AddDetail("sueden",
"Im Sueden fuehrt eine Tuer in einen Raum.");
AddDetail("tuer",
"Die Tuer ist vollkommen rot. Doch etwas anderes ist viel interessanter. "
 "Du glaubst einen Abgrund vor der Tuer entdeckt zu haben.");
 AddSpecialDetail("abgrund", "goornot");
   AddDetail("raum",
   "Der Raum scheint vollkommen rot zu sein, aber viel kann man nicht "
   "erkennen.");
AddDetail("decke",
  "Naja, sowas wie eine Decke sieht man hier natuerlich nicht, "
  "aber ein Loch durch das man nach oben kann...");
  AddDetail("loch",
  "Das Loch fuehrt nach oben.");
  AddDetail("boden",
  "Boden gibt es hier auch kaum, wenn schon einen sehr schiefen, der steil nach unten fuehrt.");
  AddDetail(({"wand", "waende"}),
  "Die Waende sind glatt, manchmal ein Kratzer oder eine kleine Erhebung, "
  "aber was Dich wirklich interessiert sind die seltsamen Zeichen an der Wand.");
  AddDetail("zeichen",
  "Die Zeichen sind Runen, und sind ueberall.");
  AddDetail(({"rune", "runen"}),
  "Kunstvoll sind sie teils eingemeiselt, teils an die Wand gemalt. Leider "
  "sagen sie Dir nichts. Oder doch? Probier halt eine Rune zu lesen...");
  AddReadDetail("rune",
  "Hmm, Du glaubst folgendes zu entziffern:\n"
  "Fremder, sei auf der Hut, Du betritst das Reich der Runenmaenner.\n");
  AddDetail("kratzer",
  "Laenglich oder auch nur kurz fuehren sie ueber die Waende.");
  AddDetail("erhebung",
  "Die Erhebungen sind auch nicht viel interessanter. Doch der Hebel neben "
  "ihnen gefaellt Dir.");
  AddDetail("hebel",
  "Tja, wofuer der wohl dient...");
     
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen unter Dir.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
  
  AddSpecialExit("sueden", "sou");
  AddExit("oben", "./k19"); 
  AddExit("unten", "./k21");
  AddCmd(({"zieh", "ziehe","drueck","druecke","bewege","beweg","betaetige"}),
  "down");
  
  abgru=0;
 }


int down(string str)
  {
  notify_fail("Was willst Du mit dem Hebel machen?\n");
  if(!str) return 0;
     if(str=="hebel")
         {
         if(!abgru)
           {
           write("Du betaetigst den Hebel und auf einmal "
           "schliesst sich der Abgrund von alleine.\n");
            call_other("d/gebirge/dante/room/kred", "close");     
           abgru=1;
           return 1;
           }
        if(abgru)
          {   
          write("Du betaetigst den Hebel und der Abgrund oeffnet sich wieder.\n");
          abgru=0;
           call_other("d/gebirge/dante/room/kred", "open");     
          return 1;
          }
       return 0;
       }
     return 0;
     }
           
 reset()
  {
  ::reset();
  tell_room("d/gebirge/dante/room/k20",
  "Der Abgrund schliesst sich wieder.\n");
  tell_room("d/gebirge/dante/room/kred",
  "Der Abgrund schliesst sich wieder.\n");
  call_other("d/gebirge/dante/room/kred", "open");
  abgru=0;
  }
  
  
  close()
    {
    abgru=0;
    }
    
    open()
    {
    abgru=1;
    }
    
  
  int sou()
  {
  if(!abgru)
      {
      return TP->move("/d/gebirge/dante/room/dead2", M_GO,
      "in den Abgrund", "stuerzt", "kommt von oben herabgestuerzt");
      }
  if(abgru)
    {
    return TP->move("/d/gebirge/dante/room/kred", M_GO,
    "nach Sueden", "geht", "kommt von Norden herein");
    }
  }   
   
         
  string goornot()
    {
    if(!abgru)
      {
      write("Der Abgrund gaehnt vor Dir. Er fuehrt tief nach unten!\n");
      }
      if(abgru)
      {
      write("Seltsam, aber da ist kein Abgrund.\n");
      }
      return "";
      }
      