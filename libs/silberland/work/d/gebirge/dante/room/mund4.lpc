//magen des riesensteinmauls

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int messer;

create()
{

  ::create();
  
  SetProp( P_INT_SHORT, "In Magen des Wesens" );


messer=random(20)+20;
   SetProp(P_NO_TPORT, NO_TPORT_OUT);   
SetProp(P_INT_LONG, BS(
  "Du bist nun im Magen des gigantischen Wesen. Aber was Du hier siehst, "
  "erstaunt Dich vollkommen. Hier ist weder Magensaeure noch findet man hier "
  "Bakterien. Du siehst eine grosse Anzahl rotierender Messer, die hin und "
  "herfahren und alles zerkleinern, was sich ihnen in den Weg stellt. "
  "Ab und zu saust ein gigantischer Block von oben herab und zerquetscht "
  "alles zu Brei. In Deinem Magen wird es bei diesem Anblick auch ungemuetlich..."));


AddDetail("boden",
"Am Boden ist alles voller Brei und Matsch.");
AddDetail("decke",
"Decke gibts hier nicht. Nur ein Loch, aus dem ein seil herabhaengt.");
AddDetail("loch",
"Das Loch ist die Speiseroehre.");
AddDetail("speiseroehre",
"Du wirst hungrig.");
AddDetail(({"wand","waende"}),
"Tippe: detail , wand ,waende fehlen");

AddDetail("messer",
"Die Messer sind extrem scharf und rasen rotierend herum.");
AddDetail("weg",
"Tja, Weg gibt es hier keinen, aber man kann hier natuerlich irgendwie hinaus.");
AddDetail("block",
"Der Block saust herunter und zerquetscht alles. Nur die Messer natuerlich nicht. "
"Er ist an einem langen Seil befestigt.");
AddDetail("seil",
"Das Seil fuehrt nach oben. Wo genau es hinfuehrt sieht man nicht.");
AddDetail("brei",
"MATSCH!!");
AddDetail("matsch",
"Tja, das wird hier aus Dir.");
AddDetail("anblick",
"Du kannst waehlen:\n"
"1. erstaunlich\n"
"2. spassig\n"
"3. eklig\n"
"4. irritierend\n"
"5. unvorstellba\n"
"6. brechreizfoerdernd\n"
"7. einfach dante\n"
"8. appettitanregend\n"
"9. saubloed\n"
"10. altruistisch\n");






 AddDetail("magen", 
 "Du bist im Magen des gigantischen Wesen.");
 AddDetail("wesen",
 "Das Wesen scheint sehr komisch zu sein, bei diesem Magen...");
 AddDetail(({"saeure","magensaeure"}),
 "Eben nicht.");
 AddDetail("bakterien",
 "Auch nicht.");
 AddDetail("anzahl",
 "Es sind "+messer+" Messer, die schnell rotierend herumrasen. In kuerzester Zeit, "
 "werden sie auch Dich zerhacken.");
 AddDetail("zeit",
 "KURZ!!!");



 AddCmd(({"ende","schlafe ein","schlaf","schlafe","schlaf ein","quit"}),"no", 3);


  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:40]));      
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
   AddSmell( DEFAULT_SMELL,
   "Es riecht zerhacktem Fleisch.\n");
     AddSound( DEFAULT_SOUND,
"Die Messer surren, der Block macht: WUMMMMMMM!!!\n");

AddCmd(({"kletter","klettere","steige","steig"}), "nixda");
AddCmd(({"waehle","waehl"}), "spass");                  
 }

int nixda(string str)
   {
   notify_fail("Womit willst Du wohinsteigen?\n");
   if(member(({"mit seil hoch","mit seil rauf",
   "mit seil hinauf", "mit seil raus", "an seil raus",
   "am seil hoch", "mit seil nach oben", "am seil hinauf",
   "an seil hinauf","an seil nach oben","an seil rauf"}),str)!=-1)
     {
     write("Du kletterst am Seil nach oben und bist froh, dass Du "
     "dem Magen entkommen bist.\n"
     "Irrtum! Das Seil ist glitschig und Du rutscht wieder runter!\n");
     return 1;
     }
   return 0;
   }
     

int spass(string str)
  {
  notify_fail("Was willst Du waehlen? NUMMER!\n");
  if(str=="1"||str=="2"||str=="3"||str=="4"||str=="5"||
  str=="6"||str=="8"||str=="9"||str=="10")
     {
     switch(random(10))
       {
       case 0:
       write("Gute Wahl!\n");
       break;
       case 1:
       write("Schlechte Wahl!\n");
       break;
       case 2:
       write("Wie kannst Du das nur glauben!?\n");
       break;
       case 3:
       write("Dante teilt Dir mit: Hehe, gleich wirst zerhackt!\n");
       break;
       case 4:
       shout(""+TPN+" ist ein Wurstie!\n");
       break;
       case 5:
       write("Angrox teilt Dir mit: Sorry, wir muessen das Mud rebooten!\n");
       break;
       case 6:
       write("Vorzuegliche Idee!\n");
       break;
       case 7:
       write("Tja, sowas dummes kann ja nur von Dir kommen!\n");
       break;
       case 8:
       write("Du hoerst wie das Wesen ruelpst.\n");
       break;
       case 9:
       write("Das war leider falsch!\n"
       "Du hast noch 3 Lebenspunkte und 4 Magiepunkte.\n");
       break;
       default: write("BLOEDSINN\n");
       }
    return 1;
    }   

   if(str=="7")
    {
    write("Genau richtig gewaehlt.\n"
    "Das Wesen ruelpst und Dich schleudert es hoch.\n");
    TP->move("d/gebirge/dante/room/mund", M_GO +M_SILENT);
    return 1;
    }
  return 0;
  }
    

int no()
{
write("Nein, Du wirst hier verhackt!\n");
return 1;
}


void init()
{
::init();
 if (query_once_interactive(this_player()))
 {
call_out("hammer", 55);       
call_out("time", 27);   
   }
 }
 
 void hammer()
 {
 if(environment(TP)!=TO || !TP) return 0;         
  switch(random(100))
    {
    case 0.. 30:
    write("Der Hammer rast knapp neben Dir zu Boden und wird dann nach oben gezogen!\n");
    break;
    case 31 ..57:
    write("Der Hammer rast voll auf Dich zu!!! WUMMMMMMMMMMMMMMMMMM!!!!\n");
    TP->do_damage(50);
    break;
    case 58 ..74:write
 ("Der Hammer rast herunter. Daneben!!! Dann wird er wieder hochgezogen!\n");
    break;
    case 75..98:
     write("Der Hammer rast herunter und streift Dich!\n");
    TP->do_damage(10);
    break;
    case 99:
    write("Der Hammer saust auf Dich zu!!WUMMMMMMMMMMMMMMMMMMMMMMM\n"
    "Der Hammer zerquestcht Dich!\n");
    TP->do_damage(1000000);
    break;
    default: write("Der Hammer macht Unfug.\n");
    }
    call_out("hammer", 33);
    }
 
  void time()
   {
    if(environment(TP)!=TO || !TP) return 0;      
    write("Die Messer rasen heran.\n");
    call_out("time2", 17);
    }
    
   void time2()
   {
    if(environment(TP)!=TO || !TP) return 0;         
    switch(random(7))
      {
      case 0:
      write("Die Messer rotieren knapp an Dir vorbei!\n");
      break;
      case 1:
      write("Ein rotierendes Messer streift Dich!AUA!!!\n");
      TP->do_damage(10);
      break;
      case 2:
      write("Ein rotierendes Messer trifft Dich voll. Blut spritzt!!!\n");
      TP->do_damage(30);
      break;
      case 3:
      write("Die Messer entfernen sich etwas von Dir!\n");
      break;
      case 4:
      write("Die Messer naehern sich Dir!\n");
      break;
      case 5:
      write("Ein Messer schlitzt Dich auf.\n");
      TP->do_damage(20);
      break;
      case 6:
      write("Ein Messer rast knapp an Dir vorbei!\n");
      break;
      default: write("Die Messer sind buggy.\n");
      }
      call_out("time2", 27);
   }
     