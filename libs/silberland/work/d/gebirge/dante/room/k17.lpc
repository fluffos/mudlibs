//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int obj;

create()
{
  ::create();


  obj=5;

  SetProp( P_INT_SHORT, "In einer Hoehle aus faulem Fleisch" );
  SetProp( P_INT_LONG, BS(
  "Du stehst in einer grossen Hoehle aus faulendem, stinkendem Fleisch. "
  "Ueberall liegen haufenweise verfaulte Koerper herum. Stapel von Aas "
  "tuermen sich rings um Dich. Ein ekliger Anblick. Du wendest Dich mit "
  "Grausen ab, als Du erkensst, dass sich hie und da noch etwas regt. "
  "Von der Decke tropft Blut, das sich am Boden zu Pfuetzen sammelt."));
  AddDetail(({"rassen","rasse"}),
  "Alles was Du kennst und noch viel mehr, fault hier unten vor sich hin.");
  AddDetail("kopf",
  "Plitsch! Volltreffer!\n");
  AddDetail("licht",
  "Von hoch oben, irgendwoher, scheint es herab, und taucht diese Hoehle "
  "in ein gespenstisches Licht...");
  AddDetail("unkenntlichkeit",
  "Viel kann man bei den meisten Koerpern nicht mehr erkennen. Teilweise "
  "weisen sie grosse Bisspuren auf. Manche scheinen auch zerfetzt worden "
  "zu sein.");
  AddDetail(({"biss","bisspuren","bisspur"}),
  "Einer Leiche fehlt der halbe Kopf, appetitlich...");
  AddDetail(({"spur","spuren"}),
  "Gewaltige Zaehne oder Klauen muessen das bewerkstelligt haben.");
  AddDetail(({"zahn","zaehne"}),
    "Du lernst sie schon noch kennen, keine Angst!");
    AddDetail(({"klaue","klauen"}),
    "Dich werden sie auch zerfetzen!\n");
    
  AddDetail("hoehle",
  "Die Hoehle ist sehr geraeumig und ueberfuellt mit verwesenden Koerpern");
  AddDetail("fleisch",
  "Faules, stinkendes Fleisch tuermt sich ueberall auf. Dir wird uebel, als "
  "Du die Maden und Wuermer erkennst, die sich in den Koerpern tummeln.");
  AddDetail(({"wand","waende"}),
  "Waende sind hier keine zu erkennen. Die Stapel von Aas versperren jede Sicht.");
  AddDetail("sicht",
  "Der blutrote Regen raubt die restliche Sicht.");
  AddDetail(({"made","maden"}),
  "Die Maden krabbeln in und auf den Koerpern herum und fressen das, was "
  "die anderen Wesen dieser Hoehle uebriggelassen haben. Vielleicht "
  "schmecken die Leichen Dir ja auch...");
  AddDetail("wesen",
  "Schreckliche Wesen. Du wirst sie treffen...");
  AddDetail(({"wuermer","wurm"}),
  "Die Wuermer bohren sich tief in die Leichen. Sie wuseln ueberall herum...");
  AddSpecialDetail(({"leiche","leichen"}), "d_u");
  AddDetail("regen",
  "Dicht und schwer prasselt das Blut von der Decke. Ab und zu glaubst Du "
  "ein schreckliches Monster ober Dir fliegen zu sehen.");
  AddDetail("monster",
  "Hmm, oder hast Du Dich getaeuscht? Die Angst scheint Dir einen Streich "
  "zu spielen!");
  AddSpecialDetail("angst", "d_a");
  AddDetail("streich",
  "Tja, mit 7 auf einen Streich wirds hier wohl nichts werden...");
  AddDetail("koerper",
  "Die Koerper aller Rassen verfaulen hier. Manche sind bis zur Unkenntlichkeit "
  "entstellt, andere hingegen sind noch recht gut erhalten.");
  AddDetail("stapel",
  "Die Stapel reichen weit ueber Deinen Kopf bis zur Decke.");
  AddDetail("aas",
  "Ueberall liegt Aas herum. Maden und Wuermer erfreuen sich daran.");
  AddDetail("anblick",
  "Dir wird uebel bei diesem Anblick.");
  AddDetail("grausen",
  "Schaurig, eklig, geschmacklos...");
  AddDetail("decke",
  "Die Decke ist hoch oben, Du kannst sie nicht erkennen. Blut tropft herab "
  "und Du glaubst in einem eklig-grausigen blutroten Regen zu stehen.");
  AddDetail("boden",
  "Der Boden ist uebersaeht mit Koerpern und faulem Fleisch. Zwischen den Stapeln "
  "sammelt sich das von der Decke tropfende Blut zu grossen, roten Pfuetzen.");
  AddDetail("pfuetzen",
  "Blutrot schimmert das Licht, das von irgendwo hoch oben kommt, in den "
  "Pfuetzen. Teilweise stehst du knoecheltief im Blut.");
  AddDetail("blut",
   "Tiefrot und stinkend...");

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst direkt wie das Fleisch fault.");
    
  AddSmell( DEFAULT_SMELL,
    "Es stinkt erbaermlich!");
  
  AddExit("westen", "./k19");
  
   AddGuardedExit( "norden", "/d/gebirge/dante/room/k18", "km",
     "Du wirst einfach festgehalten!\n");
  
   
  AddExit("sueden", "./k15");
  
 AddItem("/d/gebirge/dante/npc/kmade", REFRESH_DESTRUCT);
  

 AddCmd(({"koste", "friss","iss", "esse"}), "get");

 }
 
 int get(string str)
   {
   object ob;
   notify_fail("Was willst Du hier kosten?\n");
   if (!str) return 0;
   
   
    if(str=="leiche"||str=="leichen")                
   {
   
   if(!present("\nhoehlenquestbydante", TP))
     {
     write("Du beisst in die Leichen, aber nichts passiert. "
     "Scheint nicht fuehr Dich zu sein!\n");
     return 1;
     }
     
     else
     
   
   if(obj)
       {
       write("Du beisst herzhaft in die Leichen hinein, spuckst aber "
       "sofort wieder aus und findest dabei ein seltsames Ding.\n");
       ob=clone_object("/d/gebirge/dante/obj/nagel");
       ob->move(TP, M_TPORT);
       obj--;
         return 1;
            }
          if(!obj)
            {
            write("Du kostest eine Leiche, hmm, schmeckt nicht uebel.\n");
            return 1;
            }
          return 0;
          }
  return 0;
  }
              
 
 reset()
   {
   ::reset();
   obj=5;
   }
   
 
 
  string d_u()
  {
  write("Du siehst die Leiche von "+CAP_TPN+"!\n"
  "Hoppla! Das bist ja Du!\n");
  return"";
  }
  string d_a()
  {
  write("Dein Angstlevel liegt momentan bei:\n");
  switch(random(10))
  {
  case 0:
  write("Totaler Hosenscheisser.\n");
  break;
  case 1:
  write("Heulsuse!\n");
  break;
  case 2:
  write("Jammerlappen!\n");
  break;
  case 3:
  write("Weichei!\n");
  break;
  case 4:
  write("Mammas Liebling!\n");
  case 5:
  write("Wurstseher!\n");
  break;
  case 6:
  write("Superfeigling!\n");
  break;
  case 7:
  write("Warmduscher!\n");
  break;
  case 8:
  write("Windelbenutzer!\n");
  break;
  case 9:
  write("Dante!\n"
  "Haeh, was soll das heissen?!\n");
  break;
  default:write("Geh nach Midas!\n");
  }
  return "";
 }
  
   
