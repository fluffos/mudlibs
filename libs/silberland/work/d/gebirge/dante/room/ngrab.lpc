//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Noerds Grab" );
  SetProp( P_INT_LONG, BS(
  "Endlich hast Du Dein Ziel erreicht. Du stehst nun in Noerds Grab, "
  "in dem er seine letze Ruhe finden soll. Der Bedauernswerte muss "
  "aber auf alle Ewigkeit hier herumspucken und spucken, denn Noerd "
  "hatte Tuberkulose. Die Waende bestehen hier aus Marmor,"
  " auch die Decke besteht aus Marmor, und "
  "so muss Noerd auf alle Zeit in einem marmorenen Gefaengniss bleiben."));
 
 AddDetail("geist",
 "Der Geist von Noerd ist nur einer von vielen hier unten. Scheinbar ist, "
 "er nicht hier...");
 
 AddDetail("grube",
  "Die Grube ist in der Mitte des Grabes. Sie ist nicht besonders tief "
  "und auch nicht besondern lang oder breit.");
  AddDetail("decke",
  "Auch die Decke besteht aus Marmor, nur ist dieser nicht schwarz, "
  "sondern eher roetlich. Du erkennst eine kleine Inschrift.");
  AddDetail("inschrift",
  "Lies sie.");
  AddReadDetail("inschrift",
  "Lieber Noerd!\n"
  "Ich hoffe Du steckt bis in alle Ewigkeit hier unten fest.!\n"
  "Dein Dante.\n");
    AddDetail("gefaengniss",
    "Sicher nicht angenehm, hier zu wohnen...");
 
 AddDetail("arsch",
 "Du Ferkel! Sowas untersucht man nicht.");
 AddDetail("ferkel",
 "OINK OINK!\n");
 AddDetail("marmor",
 "Der Marmor ist kalt und glatt.");
 
 AddSpecialDetail("zeit", "wiespaetis");
 AddDetail("mitte",
 "In der Mitte des Grabes ist eine kleine Grube.");
    
 AddDetail("ziel",
 "Du bist im Grab von Noerd.\n");
 AddDetail("grab",
 "Hier gibt es viel davon, aber das ist fuer Dich das wichtigeste.");
 AddDetail("noerd",
 "Der Geist von Noerd spuckt hier herum. Manchmal versteckt er sich auch.");
 AddDetail("ruhe",
 "Ruhe kannst nur Du dem armen Noerd bringen.");
 AddDetail("bedauernswerte",
 "Wuerdest Du gerne auf ewig hier unten vegetieren wollen?");
 AddDetail("ewigkeit",
 "Angeblich ist die Ewigkeit unendlich. Aber wissen kann das keiner. "
 "Lange ist sie auf jeden Fall.");
 AddDetail("fall",
 "Jemandem der soetwas untersucht, gehoert in jedem Fall in den Ars.. "
 "getreten.");
 AddSpecialDetail("tuberkulose", "get");
 AddDetail(({"wand","waende"}),
 "Die Waende bestehen aus schwarzem Marmor. Dieses Grab muss sehr teuer "
 "gewesen sein.");
 AddDetail("boden",
 "Der Boden besteht aus fester, schwarzer Erde. In der Mitte siehst "
 "Du eine kleine Grube.");
 AddDetail("erde",
 "Die Erde am Boden ist eine Scheibe, ach Unsinn.");
 AddDetail(({"unsinn","scheibe"}),
 "Dante teilt Dir mit: Glaub doch nicht alles.");
 
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Tuberkulose.");
 }

  string get()
    {
    object ob;
    if(present("TUB", TP))
       {
    write("Aber Du hast doch schon Tuberkulose. Was willst Du mehr!\n");
       }
    
    if((!present("TUB", TP)) && (present("noerd", TO)))
    {
    write("Sei froh, dass Du keine Tuberkulose hast.\n");
    }
    
    if((!present("TUB", TP))&&(!present("noerd", TO)))
    {
    write("Du denkst zuviel ueber Tuberkulose nach, das kann "
    "ins Auge bzw auf die Lunge gehen.\n");
    ob=clone_object("d/gebirge/dante/obj/tub");
    ob->move(TP, M_GO);
    }
    return "";
    }
    
    
    


 string wiespaetis()
   {
   write("Es ist genau "+dtime(time())[19..]+", oder so...\n");
   return "";
   }
   