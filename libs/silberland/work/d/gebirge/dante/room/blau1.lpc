//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>


create()
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Kammer" );
  SetProp( P_INT_LONG, BS(
   "Du steckst hier in einer winzigen Kammer, die voellig leer ist. "));
  AddDetail("kammer",
  
  "So leer scheint die Kammer doch nicht zu sein, denn Du entdeckst in der "
  "Decke ein kleines Loch.");
  AddDetail("loch",
  "Durch das Loch kann man sicher nach oben kommen...");
  AddDetail("decke",
  "Hmm, die Decke ist ober Dir. Vielleicht kann man ja mit ihrer Hilfe, "
  "hier irgendwie raus klettern.");
  AddDetail("hilfe",
  "Wo stehst Du hier?");
  AddDetail("boden",
  "Der Boden ist sandig und ab und zu erkennt man feine Spuren.");
  AddDetail("sand",
  "Tja, Sand liegt hier natuerlich auch herum.");
       AddDetail(({"spuren","spur"}),
       "Die Spuren fuehren nach Nordwesten.");
       AddDetail("He! Im Nordwesten ist ja ein Tor!");
    AddDetail("tor",
   "Im Nordwesten sieht man ein "+ANSI_BOLD+ANSI_BLUE+"blaues Tor."
   ""ANSI_NORMAL+"");
    AddDetail(({"wand", "waende"}),
    "Die Waende weisen unzaehlige Details auf.");
    AddDetail(({"detail", "details"}),
    "Wenn Du willst, schreib sie Dir selbst. Ich bin dafuer zu faul!");
    
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen...");
    
  AddSmell( DEFAULT_SMELL,
     "Es riecht nach nichts.");
   AddCmd(({"kletter","steig","klettere","steige"}), "go"); 
   SetProp(P_HIDE_EXITS,({"nordwesten"}));      
   AddSpecialExit("nordwesten", "try"); 
}

string try()
    {
    if(!deep_present("KBLAU", TP))
       {
       notify_fail("Du kommst hier so noch nicht durch!\n"
       "Vielleicht fehlt Dir etwas!\n");
       return 0;
       }
     else  
return this_player()->move("/d/gebirge/dante/room/blau2", M_GO+M_SILENT);      
     }
       

int go(string str)
   {
   notify_fail("Wo willst Du hinaufsteigen?\n");
   if (!str) return 0;
   if(str=="in loch"||str=="durch loch"||str=="durch loch rauf"||
   str=="durch loch nach oben")
       {
       write("Du kletterst geschickt durch das Loch nach oben.\n");
       TP->move("d/gebirge/dante/room/k21", M_GO+M_SILENT);
       return 1;
       }
   return 0;
   }
       