//wesen fuer quest
//keien ahnung ob das so geht

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"
#include <combat.h>   
#include <new_skills.h>     
#include <npc.h>        


#define QUEST_STATS    present("\nhoehlenquestbydante", TP);
#define NO_QUEST_STATS   "Tut mir leid, aber Du kannst das nicht spielen!\n"
inherit "/std/npc";

void spiel(int nr, int to_go);
int lsg, anz;


     


create()
{
  ::create();
  SetProp(P_SHORT, "3 seltsame Wesen");
  SetProp(P_LONG,BS(
  "Das sind die 3 seltsamsten Wesen, die Du je gesehen hast. "
   "Es gibt derer 3 und alle 3 zusammen besitzen nur einen Mund. "
  "Wenn sie etwas sagen wollen, geben sie den Mund einfach weiter. Der Mund ist "
  "so klein und so gut versteckt am Koerper dieser Wesen, dass man ihn kaum erkennen kann. "
  "Irgendwie sind sie auch gemeinsam ein einziges Wesen, aber das kann Dir egal sein, "
  "schliesslich zuechtet Dante solche Monster."));
  AddDetail("monster",
  "Naja, fuer ein Monster zu nett.");
  
  AddDetail("mund",
  "Du bist Dir nicht sicher, ob der Mund gerade bei diesem der 3 Wesen ist.");
  AddDetail("koerper",
  "Irgendwie sieht alles wie Mund aus, irgendwie aber auch nicht...");
  
  
  
  SetProp(P_NAME, "Wesen");
  create_default_npc(19);
  SetProp(P_RACE, "monster");
  SetProp(P_DEFAULT_INFO, "sagen: Davon haben wir keine Ahnung.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Die Wesen wuerde lieber mit Dir ihrem Hobby nachgehen.\n"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Die seltsamen Wesen haben ein Hobby!\n");
  SetProp(P_ALIGN, 0);
  SetProp(P_GENDER, FEMALE);//absicht
  AddId( ({"wesen", "wesen1"}) );
  AddCmd( ({"antworte"}), "antw");
  SetProp(P_NOATTACK, "lachen Dich nur aus!\n");   
  AddInfo( ({"spiel", "spielen"}), "@@do_it@@");
  AddInfo( ({"syntax", "regeln", "antwort","regel"}), 
    "Du kannst uns mit 'antworte <linkes wesen|mittleres wesen|rechtes wesen>' sagen, wo Du den Mund vermutest. ",
    "sagen: ");
    AddInfo("hobby",
 "Tja, mach ein Spielchen mit uns. Wenn Du 3 mal hintereinander gewinnst,"
 " geben wir Dir Noerds Gebeine!"
    "", "sagen: ");
   AddInfo("spielchen",
   "Tja, wie Du siehst haben wir 3 nur einen Mund! Errate wo er ist und wir geben "
   "Dir die Gebeine von Noerd dafuer, zumindest einen Teil davon!"
   "Frag uns einfach nach Spiel!", "sagen: ");

  AddInfo("noerd",
  "Tja, denn kennen wir. Wir haben sogar seine Gebeine!", "lachen: ");
  AddInfo("gebeine",
  "grinsen heimtueckisch.");
  AddInfo("knochen",
  "lachen Dich aus.");

 }

void spiel(int nr, int to_go)
{
  object qs;
  int zeit;
  
      if(file_name(environment(TP))!="/d/gebirge/dante/room/wesenr2") 
  {
    lsg=0;
    write(
      "Die seltsamen Wesen teilen Dir mit: Weglaufen ist keine Loesung. Jetzt musst Du wieder\n"
    + "Die seltsamen Wesen teilen Dir mit: von vorne anfangen.\n");
    qs=QUEST_STATS;
    if(!qs) 
    {
      write(NO_QUEST_STATS);
      return;
    }
    qs->RestoreAntwHi();
    return;
  }
  
  if(find_call_out("spiel")!=-1) return;
  if(!to_go) nr=-1;
  switch(nr)
  {
    case 0: { 
      write("Das mittlere Wesen zeigt Dir den Mund.\n");
      lsg=2; break; }
    case 1: { 
      write("Das linke und das rechte Wesen tauschen die Plaetze.\n");
      if(lsg==1) lsg=3;
      
      else if(lsg==3) lsg=1;
      break; }
    case 2: { 
      write("Das linke und das mittlere Wesen vertauschen die Plaetze.\n");
      if(lsg==1) lsg=2;
      else if(lsg==2) lsg=1;
      break; }
    case 3: { 
      write("Das mittlere und das rechte Wesen vertauschen die Plaetze.\n");
      if(lsg==2) lsg=3;
      else if(lsg==3) lsg=2;
      break; }
    case 4: { 
      write("Das rechte Wesen schwebt nach links aussen.\n");
      lsg++;
      if(lsg==4) lsg=1;
      break; }
    case 5: { 
      write("Das linke Wesen schwebt nach rechts aussen.\n");
      lsg--;
      if(lsg==0) lsg=3;
      break; }
      
      case 6: {
      write("Das mittlere Wesen bleibt in der Mitte.\n");
      break;}
      
      case 7: {
      write("Das linke Wesen bewegt sich nicht nach rechts aussen.\n");
      break;}
      
      case 8: {
      write("Das rechte Wesen bewegt sich nicht in die Mitte.\n");
      break;}
      
      case 9: {
      write("Das rechte Wesen und das mittlere Wesen tauschen nicht ihre Plaetze.\n");
      break;}
      
      
      
      
    default: {
      write("Die Wesen sagen: Antworte, aber die Zeit is begrenzt.\n");
      call_out("schade", 25);
      return; }
  }
  call_out("spiel", 2, random(9)+1, to_go-1);
}

antw(str)
{
object fl;
  object qs;
  int ant, l;
  string tx;
  
  notify_fail("Was moechtest Du antworten?\n");
  if(!str) return 0;
  if(find_call_out("spiel")!=-1)
  {
    write("Die Wesen sagen: Warte! Ich bin noch nicht fertig!\n");
    return 1;
  }
  if(find_call_out("schade")==-1)
  {
    write("Die Wesen sagen: Deine Zeit is um! Verloren!\n");
    return 1;
  }
  qs=QUEST_STATS;
  if(!qs)
  {
    write(NO_QUEST_STATS);
    return 1;
  }
  l=-1;
  if(str=="linkes wesen") l=1;
  else if(str=="mittleres wesen") l=2;
  else if(str=="rechtes wesen") l=3;
  while(remove_call_out("schade")!=-1){}
  if(l==lsg)
  {
    qs->SetAntwHi();
    ant=qs->QueryAntwHi();
    write("Die Wesen sagen: JAWOHL!!! Korrekt!!!\n");
    if(ant==1)//aendern
    
    {
      if(deep_present("bone1", TP))
      {
        write("Die Wesen sagen: Aber Du hast doch schon diese Gebeine bei Dir.\n");
      }
      else
      {
      fl=clone_object("/d/gebirge/dante/obj/bone1");
      fl->move(TP,M_NOCHECK);    
        write(
          "Die Wesen sagen: Ok, hier hast Du die Gebeine Baldrian.\n");
      }
    }
    return 1;
  }
  else
  {
    if(lsg==1) tx="linke";
    else if(lsg==2) tx="mittlere";
    else if(lsg==3) tx="rechte";
    write("Das "+tx+" Wesen sagt: Nein! Ich hatte den Mund!\n");  
   qs->RestoreAntwHi();
    return 1;
  }
}

do_it()
{
  spiel(0, 20);
  return "grinsen seltsam hinterlistig.\n";
}

schade()
{
  object qs;
  
  qs=QUEST_STATS;
  if(!qs)
  {
    return;
  }
  write("Die Wesen sagen: Zu lange gewartet! Deine Zeit ist um!\n");
  qs->RestoreAntwHi();
}
