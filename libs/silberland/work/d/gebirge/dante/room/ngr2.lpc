//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int da, waffe;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Grab unter der Huette des Totengraebers");
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten in einem uralten, laengst vergessenem Grab. "
  "Sogar der Totengraeber weiss nicht, das er seit vielen Jahren direkt "
  "auf einem Stapel modriger Gebeine schlaeft. Es ist kuehl und still, "
  "nur manchmal hoert man die Stimme des Totengraebers von oben herab.")); 

da=3;
waffe=1;

AddDetail("decke",
"Die Decke ist direkt ober Dir. Niedrig und teilweise aus Erde und "
"teilweise aus Holz.");
AddDetail("holz",
"Das Holz ist der Boden der Huette ober Dir.");
AddDetail(({"leichen", "leiche"}),
"Leichen sieht man hier keine, aber wer weiss...");
AddDetail(({"wand", "waende"}),
"Aus den Waenden ragen Knochen und kommen Dir bedrohlich nahe. "
"Pass bloss auf, das Dich kein Knochen beruehrt.");
  AddDetail("stimme",
  "Hmm, oder taeuscht Du Dich?");
  AddDetail("totengraber",
  "Der wohnt ober Dir, schon vergessen?");
  AddDetail(({"jahre", "jahren"}),
  "Der Totengraber wohnt schon seit vielen Jahren in der Huette ober "
  "Dir.");
  AddDetail("huette",
  "Ober Dir.");
  AddDetail("stapel",
  "Ueberall sieht man hier Knochen und Gebeine. Irgendwie scheinen sie ein "
  "Muster zu bilden.");
  AddDetail("muster",
  "Hmm, das Muster gefaellt Dir nicht. Irgendwie will es Dir was sagen, "
  "aber, so verstehst Du es nicht. Vielleicht kann man es ja aendern...");
 AddDetail("totengraeber",
 "Der Totengraeber wohnt ober Dir. Vielleicht kann er Dich hier rausholen?");
  
  AddDetail("grab",
  "Du stehst sozusagen mitten drinnen. Duester und irgendwie makaber. "
  "Vielleicht trampelst Du ja gerade auf den Gebeinen eines alten, ehemaligen "
  "Freundes herum...");
  AddDetail("gebeine",
  "Manche ragen aus der Erde am Boden, andere strecken sich wie Fuehler aus "
  "den Waenden zu Dir.");
  AddDetail("erde",
  "Die Erde hier ist dunkelbraun und weist einige Loecher auf.");
  AddSpecialDetail(({"loch", "loecher"}), "mon");
AddDetail("boden",
"Der Boden hier ist weich und besteht aus Erde. Ideal zum Spieler vergraben.");
AddSpecialDetail(({"spieler","freund","freunde"}), "showfriend");  
AddDetail("fuehler",
"UI! Schon bist Du an einem Knochen angestrift. Eklig.");
AddDetail("knochen",
"Sie ragen aus dem Boden, aus den Waenden, einfach ueberall...");
  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
  
  
 AddItem("d/gebirge/dante/npc/kwurm2.lpc", REFRESH_DESTRUCT);   
    
AddCmd(({"beruehre","beruehr"}),"get");
AddCmd(({"klopfe", "klopf"}),"up");
 
AddCmd(({"aender","aendere"}),"go");

}


int up(string str)
  {
  notify_fail("Wo willst Du klopfen?\n");
  if(str=="auf holz")
    {
    write("Hmm, Holz ist gut, aber etwas anderes waer noch besser...\n");
    return 1;
    }
    if (str=="auf kopf" ||str=="auf holzkopf")
    {
    write("Der Totengraeber oeffnet eine Geheimlucke ober Dir und "
    "zieht Dich nach oben.\n");
    TP->move("d/gebirge/dante/room/hu.lpc", M_GO+M_SILENT);
    return 1;
    }
 return 0;
 }
    

int get(string str)
    {
    object ob;
    notify_fail("Was willst Du beruehren?\n");
    if(!str) return 0;
    
    if(member(({"knochen"}),str)!=-1)
       {
    
         
     if(!waffe)         
         {
         write("Du beruehrst einen Knochen, zitterst leicht, aber sonst "
         "passiert nichts. Eine Stimme sagt: Geduld, "+CAP_TPN+"!\n");
         return 1;
           }
    if(waffe)
         {
     write("Du beruehrst einen Knochen, und er bricht ab.\n");
     ob=clone_object("d/gebirge/dante/weapon/mbone");
     ob->move(environment(TP), M_NOCHECK);
     waffe--;
     return 1;
         }
    return 0;
    }
  return 0;
  }
           
         
         
  int go(string str)
  {
  notify_fail("Was willst Du aendern?\n");
  if(!str) return 0;
  switch(random(5))
     {
  case 0:
  write("Du aenderst das Muster und irgendwie formen sich seltsame Zeichen, "
  "die in der Wand verschwinden. Aufgeregt folgst Du ihnen durch die "
  "Wand!!! Wie gehst das denn?!?!?\n");
  TP->move("/d/gebirge/dante/room/ngr3", M_SILENT+M_GO);
  break;
  case 1..3:
  write("Du aenderst das Muster, aber nichts passiert.\n");
  break;
  case 4:
  write("Du aenderst das Muster, die Knochen schlagen aus!\n"
  "Aua! Das tut weh!\n");
  TP->do_damage(5);
  break;
  default: write("Bug!\n");
     }
     return 1;
   }


  string showfriend()
  {
    string *namen;
      int i;
  
write("Du schaust Dich um und wirst aufeinmal ganz traurig. Traenen "
"rinnen Dir von den Wangen und Du brichst nieder.\n");
      
namen = TP->QueryProp("friends");
 if(!sizeof(namen))
 write("Naja, welche Freunde von Dir sollen da schon liegen? Dich will "
 "ja keiner.\n");
  
  else
  {
   for (i=sizeof(namen)-1;i>=0;i--)
  write(sprintf( "%s", capitalize(namen[i]))+(i==0?" !":", "));
 write(" Sie alle liegen hier verbuddelt, grausam verstuemmelt und "
 "hingeschlachtet, geschaendet von Dante! Oder ist alles nur eine boese "
 "Illusion!?\n");

    }
 return "";
 }  
  
  
  string mon()
  {
  object ob;
  
  if(!da)
    {
    write("Du schaust in die Loecher, naja , was erwartest Du Dir davon?\n");
    }
    
   if(da)
   {
   write("Du schaust zu lange in die Loecher und...\n");
   ob=clone_object("d/gebirge/dante/npc/kmade.lpc");
   ob->move(environment (TP), M_TPORT);
   ob->Kill(TP);
    da--;
    }
   return "";
   }
   
  reset()
  {
  ::reset();
  da=3;
  }
    