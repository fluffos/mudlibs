//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int open;

create()
{
  ::create();
   AddItem("d/gebirge/dante/npc/hgeist", REFRESH_DESTRUCT);
AddExit("norden", "./g6");
open=0;
AddDetail("boden",
"Der Boden ist hier noch weicher. Kleine Erdhaufen sehen recht amuesant aus.");
AddDetail(({"erdhaufen", "haufen"}),
"Du schaust Dir den Erdhaufen genauer an, und entdeckst einen grossen Geisterpilz.");
AddDetail(({"geisterpilz", "pilz"}),
"Der Geisterpilz ist der Geist eines giftigen Pilzes, der irgendwann irgendjemanden vergiftete hat.");


AddExit("westen", "./g1");
AddExit("osten", "./g4");
AddCmd(({"pfluecke", "pflueck"}), "open");

}
 int open (string str)
   {
   notify_fail("Was willst Du hier pfluecken?\n");
  if (!str) return 0;
      if (str=="geisterpilz"||str=="pilz")
         {
         if(open==0)
              {
              call_other("d/gebirge/dante/room/g9", "open_door");
              open=1;
              write("Du hoert ein Surren aus der Ferne.\n");
              return 1;
              }
          if (open!=0)
          {
          call_other("d/gebirge/dante/room/g9", "close");
                 open=0;
              write("Du hoert ein Surren aus der Ferne.\n");
               return 1;      
            }
          return 0;
          }
      return 0;
      }
            