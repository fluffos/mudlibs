//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int da;

create()
{
  ::create();

 AddDetail("boden","Der Boden ist hier sehr feucht. Du erkennst eine kleine "
 "Lache.");
//AddItem("d/gebirge/dante/npc/bgeist", REFRESH_DESTRUCT);
AddExit("norden", "./g9");
AddExit("westen", "./g2");
da=1;
AddDetail("lache",
"Die Lache ist eher ein sehr, kleiner Teich.");
AddDetail("teich",
"Der Teich ist nicht allzu tief. Du entdeckst einen Fisch.");
AddDetail("fisch",
"Ein grosser, weisser Fisch.");
AddExit("osten", "./g5");
AddCmd(({"fange","fang"}), "get");
AddExit("sueden", "./g3");
}

int get(string str)
  {object ob;
  ob=clone_object("d/gebirge/dante/obj/flossen");
  notify_fail("Was willst Du fangen?\n");
  if(str=="fisch")
    {
    if(!da)
      {
      write("Du versuchst den Fisch zu fangen, aber er ist zu schnell fuer Dich!\n");
      return 1;
      }
   if(da)
     {
     write("Du versuchst den Fisch zu fangen, erwischt aber nur seine Flossen, "
     "die Du ihm ruckartig ausreist. TIERQUAELER!\n");
     ob->move(TP, M_GO);
     da--;
     return 1;
     }
   return 0;
   }
return 0;
}
   
   reset()
   {
   ::reset();
   da=1;
   }
        
      