//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int auf;
create()
{
  ::create();
auf=0;
  SetProp( P_INT_SHORT, "In einem riesigen Maul" );
  SetProp( P_INT_LONG, BS(
  "Nun bist Du in dem riesigen Maul, das Dich verschluckt hat. "
  "Gigantische Zaehne ragen um Dich herum auf. Es stinkt gewaltig nach "
  "unverdauten Spielern. Vor Dir tut sich ein gewaltiger Abgrund auf, "
  "die Speisseroehre. Luftroehre kannst Du keine erkennen. "));
  
  AddDetail("abgrund",
  "Der Abgrund ist scheinbar unendlich tief. Ein schwarzes, grosses "
  "Loch.");
  AddDetail("loch",
  "Hinter dem Loch sieht man eine kleine Erhebung.");
  AddDetail("erhebung",
  "Es scheint ein kleiner Platz zu sein, auf dem man stehen koennte...");
  AddDetail("platz",
  "Wie kommt man da bloss hin...");
  AddDetail("roehre",
  "Welche Roehre?");
  AddDetail("speiseroehre",
  "Die Speiseroehre ist der schwarze Abgrund, der sich vor Dir auftut.");
  AddDetail("luftroehre",
  "Siehst Du nicht, aber Du bemerkst, dass ein Wind blaesst.");
  AddDetail("wind",
  "Der Wind blaesst ueber den Abgrund hinweg...");
  AddDetail("boden",
  "Der Boden ist weich und warm. Er endet einerseits am Abgrund, andererseits "
  "an der Mundoeffnung.");
  AddSpecialDetail(({"mund", "mundoeffnung"}),"show");
  AddDetail("decke",
  "Die decke ist der Gaumen.");
  AddDetail("gaumen",
  "Der Gaumen ist weit ober Dir.");
  AddDetail(({"wand", "waende"}),
  "Die Waende sind sozusagen die Backen.");
  AddDetail(({"backe","backen"}),
  "Feucht, weich und warm.");
  
  
  AddDetail("maul",
  "Du steckst im Maul, das Dich verschluckt hat. ");
  AddDetail(({"zahn","zaehne"}),
  "Die Zaehne sind etwas so gross wie Du. Manche sind spitz andere etwas "
  "kleiner und eher stumpf. An einem Zahn erkennst Du eine schwarze Stelle.");
  AddDetail("stelle",
  "Die Stelle erweist sich als Karies.");
  AddDetail("karies",
  "Der Besitzer dieses Mauls sollte einmal zum Zahnarzt.");
  AddDetail("besitzer",
  "Wer das wohl ist, er muss gigantisch gross sein.");
  AddDetail(({"arzt", "zahnarzt"}),
  "Welcher Arzt sollte denn so ein gigantisches Maul reparieren?");
  AddDetail(({"spieler"}),
  "Sie wurden alle gleich wie Du verschluckt...");
  
  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst direkt wie das Fleisch fault.");
    
  AddSmell( DEFAULT_SMELL,
    "Es stinkt erbaermlich!");
  
  AddSpecialExit("norden", "go");
AddItem("d/gebirge/dante/npc/kpara", REFRESH_DESTRUCT);
call_other("d/gebirge/dante/obj/mundmaster", "start");
AddCmd(({"kletter", "klettere"}), "out");
AddCmd(({"spring","springe"}), "drueber");
 }

int drueber(string str)
  {
  notify_fail("Wo willst Du drueber springen!?\n");
   
   if(str=="ueber abgrund"||str=="ueber roehre"||str=="ueber loch"||
   str=="ueber speiseroehre")
   {
   if(present("FLUEGEL", TP))
     {
     write("Du nimmst Anlauf und springst los!!!\n"
     "Deine Fluegel beginnen zu schlagen und auf einmal fliegst Du ueber "
     "die Speiseroehre drueber und landest sicher an der anderen Seite.\n");
     TP->move("d/gebirge/dante/room/mund2", M_GO+M_TPORT);
     return 1;
     }
 else
     {
  write("Du nimmst Anlauf und ....\n"
  "Dein Sprung ist viel zu kurz. Du faellst in die Speiseroehre und saust "
  "nach unten!\n");
  TP->move("/d/gebirge/dante/room/mund4", M_GO+M_TPORT);
  return 1;
     }
return 0;
  }
 return 0;
 }
      
     

 int out(string str)
  {
  notify_fail("Wo willst du raus klettern?\n");
  
  if(str=="durch mund"||str=="durch mund raus"||str=="aus mund")
    {
    if(!auf)
      {
      write("Du kannst nicht durch den Mund raus klettern, er ist geschlossen.\n");
      return 1;
      }
    
       if(auf)
       {
    write("Du kletterst durch den Mund raus.\n");
    TP->move("d/gebirge/dante/room/k16", M_GO+M_SILENT);
    return 1;
       }
      return 0;
      }
    return 0;
    }
      

 open()
   {
   auf=1;
   }
   
   schliessen()
   {
   auf=0;
   }
   

string show()
  {
  if(auf==1)
    {
    write("Der Mund ist gerade offen.\n");
    }
    if(auf==0)
    {
    write("Der Mund ist gerade geschlossen.\n");
    }
    return "";
    }
    
    