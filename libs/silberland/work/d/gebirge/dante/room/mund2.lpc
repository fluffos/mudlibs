//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


string *wer;
int i;


create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einem riesigen Maul" );
  SetProp( P_INT_LONG, BS(
"Du stehst nun auf einem kleinen Vorsprung direkt ueber der Speiseroehre "
"dieses gigantischen Wesen. Vor dir gaehnt der Abgrund, hinter Dir "
"die Wand des Rachen. Keine rosigen Aussichten..."));

AddDetail("vorsprung",
"Du stehst auf einer kleinen Schleimhautfalte. Es koennte sein, dass Du "
"ausrutscht.");
AddDetail("falte",
"Du stehst darauf.");
AddDetail("schleimhaut",
"Sie ist hier ueberall. Glitschig, feucht. Das Epithel ist mehrschichtig und "
"unverhornt.");
AddDetail("epithel",
"Tja, medizinisch ungebildet, was?");
AddDetail("schleimhautfalte",
"Du stehst auf einer...");
AddDetail(({"aussicht","aussichten"}),
"Tja, keine rosigen...");
AddDetail("rachen",
"Mein ist die Rachen, eh , hmm, nein...");
AddDetail("decke",
"Die Decke ist direkt ober Dir, man koennte es auch als Gaumen bezeichnen.");
AddDetail("gaumen",
"Der Gaumen ist hier weich und rosafarben. Du erkennst eine kleine Spalte.");
AddDetail("spalte",
"Die Spalte ist sehr klein und irgendwie verwachsen. Fluessigkeit "
"tropft heraus. Hmm, ob man in die Spalte rein kann...");
AddDetail("fluessigkeit",
"Die Fluessigkeit tropft aus einer grossen Zyste, die direkt ober dem Rachen sitzt.");
AddDetail("zyste",
"Eklig ist das. Das Wesen weiss nicht einmal, dass es eine Zyste hat.");
AddDetail(({"wand","waende"}),
"Die Waende sind hier eigentlich nur hinter Dir. Und das ist die Wand des Rachen.");

AddDetail("boden",
"Boden ist hier nicht viel.");
AddDetail("mund",
"Der Mund ist auf der anderen Seite, jenseits der Speiseroehre.");
AddDetail("seite",
"Hier und dort.");
AddDetail("roehre",
"Speiseroehre.");
AddDetail("speiseroehre",
"Sie beginnt direkt unter Dir...");
AddDetail("wesen",
"Keine Ahnung wer oder was das ist.");
AddDetail("ahnung",
"Hmm, vielleicht kann man ja irgendwie tiefer in das Wesen vordringen.");
AddDetail("abgrund",
"Der Abgrund ist die Speiseroehre. Ein tiefes, schwarzes Loch.");
AddDetail("loch",
"Vor Dir oeffnet sich die Speiseroehre. Du glaubst in der Tiefe etwas zu sehen.");
AddDetail("tiefe",
"Sehr tief, sehr, sehr tief.");
AddSpecialDetail(({"etwas"}),"spass");
  
  
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst direkt wie das Fleisch fault.");
    
  AddSmell( DEFAULT_SMELL,
    "Es stinkt erbaermlich!");
AddItem("d/gebirge/dante/npc/kpara", REFRESH_DESTRUCT);  

AddCmd(({"kletter", "klettere"}), "out");
AddCmd(({"spring","springe"}), "drueber");
 }


int out(string str)
   {
   notify_fail("Wo willst Du hinein klettern?\n");
   
   if(str=="in zyste"||str=="durch spalte"||str=="in spalte")
     {
     
     write("Du springst hoch, und ziehst Dich in die Spalte!\n");
     TP->move("d/gebirge/dante/room/mund3", M_GO+M_SILENT);
     return 1;
     }
  return 0;
  }
  
  
  init()
    {
    ::init();
     if(!random(5))
        {
        write("\nDu rutscht an der schluepfrigen Schleimhaut aus und saust schon "
        "die Speiseroehre hinunter.\n\n");
        TP->move("d/gebirge/dante/room/mund4", M_GO+M_SILENT+M_NO_SHOW);
        }//no show lassen!
    }       
     
   
int drueber(string str)
  {
  notify_fail("Wo willst Du drueber springen!?\n");
   
   if(str=="ueber abgrund"||str=="ueber roehre"||str=="ueber loch"||
   str=="ueber speiseroehre")
   {
   if(present("FLUEGEL", TP))
     {
     write("Du nimmst Anlauf und springst los!!!\n"
     "Deine Fluegel beginnen zu schlagen und auf einmal fliegst Du ueber "
     "die Speiseroehre drueber und landest sicher an der anderen Seite.\n");
     TP->move("d/gebirge/dante/room/mund", M_GO+M_TPORT);
     return 1;
     }
 else
     {
  write("Du nimmst Anlauf und ....\n"
  "Dein Sprung ist viel zu kurz. Du faellst in die Speiseroehre und saust "
  "nach unten!\n");
  TP->move("d/gebirge/dante/room/mund4", M_GO+M_SILENT);
  return 1;
     }
return 0;
  }
 return 0;
 }
      
   
    string spass()
    {
    wer=({"Dante","Angrox", "Muaddib","den Balrog","Stahldorn",
    "Brezel","Titania","Lars", "Anvar","Kronangs Leiche", "Nostromo","Azrael","Max","Merlin"});
     i=random(sizeof(wer));
     write("Du glaubst dort unten "+wer[i]+" zu sehen!\n"); 
     return "";
     }
     
     