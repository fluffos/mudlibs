//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <exploration.h>     


int zufall, tafel;

object d;
create()
{
  ::create();

 

  SetProp( P_INT_SHORT, "In einem tiefen Abgrund" );
  SetProp( P_INT_LONG, BS(
   "Du bist nun, dumm wie Du nun einmal bist, in diesen tiefen Abgrund gefallen. "
   "Nun stehst Du am Grund und weisst nicht was Du tun sollst. Ringsum "
   "Dich herum steigen die Waende steil empor und ihr Ende "
   "ist kaum zu erkennen."));
zufall=random(11);
tafel=0;

//d=find_living("dante");
//tell_object(d,
//""+zufall+"\n");

AddDetail("ende",
 "Hmm, besser Du machst Ende!");
 AddDetail(({"waende", "wand"}),
 "Die Waende sind enorm rutschig und steil. Rauf komst Du sicher nie mehr!");
   AddDetail("decke",
   "Wo soll die hier sein?!");
   AddDetail("boden",
   "Der Boden ist sandig, was Dein Glueck war. Der Sand hate Deinen Aufprall "
   "enorm gelindert...");
   AddDetail("sand",
   "Der Sand ist braun und schwarz und grob und uninteressant.");
   AddDetail("glueck",
   "Hmm, hast Du hier sicher nicht...");
   AddDetail("aufprall",
   "Der Aufprall war hart, aber Du hast ihn ueberlebt.");
   
   AddDetail("abgrund",
   "Der Abgrund ist enorm tief, oder von Deiner Warte aus sehr hoch...");
   AddDetail("grund",
   "Der Grund fuer Deinen Absturz war Deine Dummheit. Der Grund des Abgrunds "
   "ist um Dich herum. Freundlich sieht es hier nicht gerade aus.");
   AddDetail("absturz",
   "Ich hoffe, er hat Dir gefallen!");
   AddSpecialDetail("dummheit", "showd");
AddDetail("warte",
"Tja, sieht nicht gut fuer Dich aus!\n");

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen...");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verfaulten Abenteurern!");
 
AddSpecialDetail(({"tafel", "hebel", "hebel 1", "hebel 2"}), "no"); 
  
  
  
AddCmd(({"grabe", "grab"}),"comeout");
AddCmd(({"ziehe", "zieh"}), "comin");  

   }


  int comin(string str)
    {
    
    object ob;
    
    notify_fail("Was willst Du hier ziehn?\n");
    if (!str) return 0;
    if(tafel)
      {
    if(member(({"hebel","am hebel", "an hebel"}),str)!=-1)
           {
         write("Welchen Hebel willst Du ziehen? 1 oder 2?\n");
         return 1;
           }
           
        if(member(({"hebel 1", "am hebel 1", "am hebel 1"}),str)!=-1)             
             {
             if(zufall>4)
                {
                write("Du hast Glueck, hinter Dir geht eine Tuer "
                "in der Wand auf. Jemand zieht Dich nach draussen und Du "
                "bist frei!\n");
                TP->move("d/gebirge/dante/room/blau1", M_GO+M_SILENT);
                return 1;
                }
              if(zufall<=4)
              {
              write("WAH!!!Bist Du sterbensmuede!\n");
              ob=clone_object("d/gebirge/dante/npc/kdead2");
              ob->move("/d/gebirge/dante/room/dead2", M_GO);
              ob->Kill(TP);
              return 1;
              }
          return 0;
          }
              
          if(member(({"hebel 2", "an hebel 2", "am hebel 2"}),str)!=-1)                         
                 {
                 if(zufall>4)
                   {
                   
              write("Willst Du sterben!!!\n");
              ob=clone_object("d/gebirge/dante/npc/kdead2");
              ob->move("/d/gebirge/dante/room/dead2", M_GO);
              ob->Kill(TP);
                  return 1;
                  }
                if(zufall <=4)
                {
                write("Du hast Glueck, hinter Dir geht eine Tuer "
                "in der Wand auf. Jemand zieht Dich nach draussen und Du "
                "bist frei!\n");
                TP->move("d/gebirge/dante/room/blau1", M_GO+M_SILENT);
                return 1;
                 }
            return 0;
            }
         return 0;
       }
   return 0;
       }
            


  string no()
  {
  if(tafel)
     {
     write("Du siehst eine Tafel auf der 2 Hebel sind. "
     "Hebel 1 und Hebel 2.\n");
     }
     if (!tafel)
        {
        write("Sowas siehst Du hier nicht.\n");
        }
        return "";
    }
        

  int comeout(string str)
    {
    notify_fail("Wo willst Du hier graben?!\n");
    if (!str) return 0;
       if (str=="in sand"||str=="im sand"||str=="sand")
           {
           if(!tafel)
              {
              write("Ploetzlich schiesst eine Tafel aus dem Sand.\n");
              tafel=1;
              return 1;
              }
          if(tafel)
          {
          write("Nein, da ist nix mehr versteckt...\n");
          return 1;
          }
       return 0;
       }
      return 0;
    }
       
   
   
   
        
  reset()
  {
  ::reset();
  tafel=0;
  zufall=random(11);
  }
  
  
              
              
  string showd()
  {
  switch(random(6))
     {
     case 0:
     write("Du bist enorm doof.\n");
     break;
     case 1:
     write("Du bist superdumm.\n");
     break;
     case 3:
     write("Du siehst ein, dass keiner hier so daemlich ist wie Du!\n");
     break;
     case 4:
     write("Enorm verbloedet bist DU!\n");
     break;
     case 5:
     write("Weltmeister der Dummheit ist "+TPN+"!\n");
     break;
     default:write(""+TPN+" ist ultradumm!\n");
     }
  return "";
  }
  
     