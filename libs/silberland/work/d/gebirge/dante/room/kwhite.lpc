//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>
create()
{
  ::create();
  
  
  SetProp( P_INT_SHORT, ""+ANSI_BOLD+ANSI_WHITE+"In einer weissen Kammer" );
  SetProp( P_INT_LONG, BS(
  ""+ANSI_BOLD+ANSI_WHITE+"Du stehst nun in einem Raum, der voellig weiss ist. "
  "Hell und strahlend, Du wirst fast geblendet. "
  "Alles, wirklich alles ist hier weiss."));
  AddDetail("farbe",
  ""+ANSI_BLUE+ANSI_WHITE+"Alles hier ist weiss.");
  AddDetail("weiss",
  "Naja, wie sieht hier alles aus?");
  AddDetail("raum", 
  "Das hier ist sozusagen, der weisse Raum.");
  AddDetail("decke",
  "Die Decke ist ebenfalls total weiss angemalt.");
  AddDetail("boden",
  "Der Boden besteht aus weissem Stein.");
  
  AddDetail("stein",
  "Der Stein ist weiss, haha.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind rauh und aus weissem Stein.");
  
  AddDetail(({"wand","waende"}),
  "Die Waende sind alle weiss, total weiss und hell. Die Westwand ist weisser, "
  "als die Ostwand.");
  AddDetail("westwand",
  "In der Westwand erkennst Du eine gezeichnete Figur.");
  AddDetail("figur",
  "Die Figur ist weiss.");
  AddDetail("ostwand",
  "Die Ostwand ist weniger weiss als die Westwand. Irgendwie erkennt man einen "
  "Fleck.");
  AddDetail("fleck",
  "Hmm, etwas weniger weiss, als die ohnehin schon wenig weise Ostwand. "
  "Das stoert Dich, Du willst das aendern!");
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst alles sehr weiss.");
 AddItem("d/gebirge/dante/npc/kmwhite", REFRESH_DESTRUCT);
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach weiss...");
    AddCmd(({"beseitige", "loesche","beseitig","wische", "wisch", "saeuber",
    "saeubere", "entfern", "entferne"}), "out");
 }
   int out(string str)
     {
     notify_fail("Was willst Du mit dem Fleck machen?\n");
     if(member(({"fleck", "fleck weg", "fleck auf"}), str)!=-1)
     {
     write(""+ANSI_BOLD+ANSI_GREEN+" Du willst den Fleck "
     "entfernen, faellst aber dabei einfach durch die Mauer!\n");
     TP->move("d/gebirge/dante/room/trans", M_GO + M_SILENT);
     return 1;
     }
  return 0;
  }
     