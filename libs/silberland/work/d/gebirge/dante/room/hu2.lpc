//anfangsraum der hoehlen von dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

void init()
{
  ::init();
    if (query_once_interactive(this_player()))
        call_out("a1", 0);
        }

create()
{
  ::create();
 SetProp(P_NO_TPORT, NO_TPORT_OUT);    
  SetProp( P_INT_SHORT, "Hinter der Huette des Totengraebers" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun hinter der Huette des Totengraebers, eingesperrt in "
  "einen engen Spalt. Es war scheinbar nicht klug, einfach beim Fenster "
  "hinaus zu springen, ohne zu wissen, was sich hier verbirgt. "
  "Rings um Dich herum nur Felsen und die Hinterwand der Huette..."));
  AddDetail("huette",
  "Du bist hinter der Huette, in einem schmalen Spalt eingeklemmt...");
  AddDetail("spalt",
  "Der Spalt scheint immer enger zu werden...");
  AddDetail("boden",
  "Blanker Fels.");
  AddDetail("decke",
  "Gibt es hier nicht, hur Himmel.");
  AddDetail("himmel",
  "Der Himmel sieht von hier aus dunkel und bedrohlich aus.");
  AddDetail("totengraeber",
  "Der Totengraeber koennte Dir vielleicht helfen...");
  AddDetail("fenster",
  "Das Fenster ist viel zu weit oben, so kommst Du hier nicht mehr raus.");
  AddDetail("wand",
  "Felswaende sperren Dich ein, die Hinterwand der Huette versperrt Dir den "
  "Weg auf den Friedhof.");
  AddDetail("weg",
  "Tja, wo ist der...");
  AddDetail(({"felswand","felswaende"}),
  "Sie erdruecken Dich fast...");
  AddDetail("hinterwand",
  "Sie ist direkt neben Dir. Sie hat auch ein Fenster.");
  AddDetail("waende",
  "Hmm, wie kommst Du hier wieder raus...");
    
  AddDetail("fels",
  "Rundherum um Dich nichts als blanker Fels.");
  AddDetail("felsen",
  "Die Felsen ruecken naeher und naeher, beeile Dich! UI! Da ist ja eine "
  "kleine Luecke...");
  AddDetail("luecke",
  "Durch die Luecke kann man sicher fliehen, aber wohin und wie...");
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_MOUNTAIN]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Knarren und Schaben.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
  AddCmd(({"teile", "teil"}), "out");
  AddCmd(({"fluechte", "fluecht"}), "out2");   
}



  int out2(string str)
    {
    notify_fail("Wie willst Du hier fluechten?\n");
    if (str=="durch luecke"||str=="in luecke")
      {
      write("Du machst Dich ganz klein und fluechtest durch die Luecke!\n");
      TP->move("d/gebirge/dante/room/hu3", M_GO+M_SILENT);
      return 1;
      }
  return 0;
  }    
  int out(string str)
    {
    notify_fail("Was willst Du wem mitteilen?\n");
    if(member(({"totengraeber mit hilfe", "totengraeber mit Hilfe",
    "totengraeber mit hilf mir"}), str)!=-1)
      {
      write("Der Totengraeber teilt Dir mit: Oeekttarfy, iedczuh kwsotzmuimzhe!\n"
      "Sekunden spaeter zieht er Dich durch das Fenster in seine Huette zurueck.\n");
      TP->move("/d/gebirge/dante/room/hu", M_GO+M_SILENT);
      return 1;
      }
      return 0;
      }
     
     
     void a1()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("Die Felswaende ruecken immer naeher...\n");
     call_out("a2", 60);
     }
     
     void a2()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("Hau lieber ab! Die Waende zerquetschen Dich sonst.\n");
     call_out("a3", 60);
     }
     void a3()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("Die Waende beginnen Dich zu beruehren!!!\n"); 
     TP->do_damage(10);
     call_out("a4", 60);
     }
     void a4()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("Du wirst bald zerquestscht!!!\n");
     TP->do_damage(15);
     call_out("a5", 60);
     }
     void a5()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("In einer Minute wirst Du zerquetscht!!!\n");
     TP->do_damage(25);
     call_out("a6", 60);
     }
     void a6()
     {
     if(environment(TP)!=TO || !TP) return 0;        
     write("DIE FELSWAENDE ZERQUETSCHEN DICH!!!\n");
     TP->do_damage(10000);
     domainshout(""+TPN+" wurde gerade von einer Felswand zerquetscht.\n");
      SetProp(P_KILL_MSG, "Eine boesartige Felswand");  
     }
     
         