//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <exploration.h>     
int zufall, t,x, mon;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem lebendem Organismus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten in einer grossen, hell erleuchteten Halle. "
  "Du wunderst Dich wo das Licht herkommt, und schauderst als Du erkennst, "
  "das an den Waenden ueberall Gekreuzigte haengen. Teilweise ausgebrannt und "
  "verkohlt, andere brennen noch hell und bruellen um ihr Leben!!! "
  "Genaues kannst Du nicht erkennen, denn unzaehlige Saeulen versperren "
  "Dir die Sicht. Ein seltsam geformtes Objekt kannst Du trotzdem gut betrachten."));
  zufall=random(20)-random(20)+1;
  AddDetail("stelle",
  "Untersuch nicht jeden Unsinn!");
  AddDetail("unsinn",
  "Unsinn!");
    
  AddDetail("objekt",
  "Es handelt sich um einen Kokon aus Glas.");
  AddDetail("glas",
  "WAEH!!!Das ist kein Glas, sondern durchsichtiger Schleim!");
  AddDetail("schleim",
  "Der Schleim scheint in Bewegung zu sein. Er blubbert und blubbert.");
  AddDetail("bewegung",
  "Er blubbert hin und her.");
   AddDetail("kokon",
  "Der Kokon schimmert hell und weisslich. Er weisst die Form eines Zylinders auf. "
  "In seinem Inneren scheint ein Koerper zu schwimmen.");
  AddDetail(({"form","zylinder"}),
  "Gross, oval.");
  AddDetail(({"inneres","innen","innerem"}),
  "Ein blaser Koerper scheint im Kokon umherzuschwimmen.");
  AddDetail("koerper",
  "Der Zylinder ist mit irgendeiner Fluessigkeit gefuellt. Drinnen schwimmt ein "
  "blaser, weisslicher Koerper umher. Der Koerper scheint leblos zu sein...");
  AddDetail(({"fluessigkeit"}),
  "Die Fluessigkeit ist gelblich bis weiss. Hmm, wie koennte man an sie rankommen? "
  "Soll man, nein, zu riskant!");
  
  t=3;
  
  AddDetail(({"fallbeil","beil"}),
  "Eigentlich wollte ich ja Dich an dieser Stelle sofort umbringen, "
  "dann Dir einen Forscherpunkt geben.");
  AddDetail(({"saugnaepfe"}),
  "Sie suchen Blut!");
  AddSpecialDetail(({"fp","fps","forscherpunkt","forscherpunkte"}), "show");  
  AddDetail(({"saeulen","saeule"}),
  "Die Saeulen ragen vom Boden bis zur Decke und werfen unheimliche Schatten. "
  "Manche Saeulen sind rund, anderen viereckig und dreieckig.");
  AddDetail("schatten",
  "Gespenstisch zucken sie am Boden hin und her.");
  AddDetail(({"runde saeule","runde saeulen"}),
  "Die Runden Saeulen sind blutrot und scheine auch zu pulsieren. Sie stellen "
  "die grossen Gefaesse dieses seltsamen Organismus dar.");
  AddDetail(({"gefaess","gefaesse"}),
  "BUMM!!!BUMMM!!! Das Blut pumpt durch den Organismus.");
  AddDetail("organismus",
  "Scheinbar ist das alles hier ein grosser, uralter Organismus.");
  AddDetail(({"dreieckige saeulen","dreieckige saeule"}),
  "Die dreieckigen Saeulen scheinen sich nicht oder nur kaum zu bewegen. "
  "Manchmal glaubst Du einen Laut aus ihnen vernehmen zu koennen. Manchmal "
  "scheinen sie Dich auch anzublinseln. Hmm, sind das etwa die Augen, Ohren und der Mund "
  "dieses Organismus...");
  AddDetail(({"auge","augen"}),
  "Hat Dich da nicht etwas angeschaut?");
  AddDetail(({"ohr","ohren"}),
  "Wirst Du hier belauscht?");
  AddDetail(({"mund"}),
  "Sollte Dich der Mund fressen wollen?");
  AddDetail(({"viereckige saeule", "viereckige saeulen"}),
  "Diese Saeulen sind sehr dick und scheinen eine seltsame Art von "
  "Knochengeruest darzustellen!");
  AddDetail(({"knochen","knochengeruest","geruest"}),
  "Sie scheinen das alles zu tragen und zu halten.");
  AddDetail("boden",
  "Schwarzrotes Gewebe ueberzieht den gesamten Boden und scheint hin und "
  "her zu kriechen. Eklig!");
  AddDetail("gewebe",
  "Es kriecht und schluepft und ab und zu spritzt ein Tropfen Blut heraus.");
  AddDetail("tropfen",
  "Plitsch!!!");
 AddDetail("decke",
 "Die Decke ist recht weit oben, doch in diesem hellen Licht gut zu erkennen."
 " Du freust Dich, dass die Gekreuzigten so schoen brennen. Lange, schwarze "
 "Tentakel haengen von ihr herab und saugen Blut aus dem Gewebe am Boden.");
 AddSpecialDetail("tentakel", "d_come");
 AddDetail("licht",
 "Die Gekreuzigten spenden ein gespentisches Licht!");
 AddDetail("sicht",
 "Die Saeulen versperren Dir etwas die Sicht, und Du bist nicht ungluecklich "
 "darueber...");
 
  
  
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus blankem, schwarzen Stein. In kurzen Abstaenden "
  "haengen die Gekreuzigten an der Wand.");
  AddDetail(({"abstand","abstaende"}),
  "Du solltest von diesem Ort besser Abstand halten!");
  AddDetail("ort",
  "Ein netter, gemuetlicher Ort.");
  
  AddDetail(({"gekreuzigte","gekreuzigter"}),
  "Die armen, gepeinigten Gekreuzigten haengen tot oder halbtot an den "
  "Waenden. Einige bruellen noch, ihr Geschrei ist kaum auszuhalten, "
  "anderen sind bereits verkohlt und glimmen still vor sich hin!");
  AddDetail("geschrei",
  "AHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH!!!!!!");
  AddDetail("leben",
  "Angeblich wohnt hier ein Wesen, das mehrere Leben hat.");
  AddDetail("wesen",
  "Such es!!! oder besser nicht...");
  
  AddDetail("halle",
  "Die Halle weist eine enorme Groesse auf. Wer hat sie wohl errichtet? "
  "Eigentlich ist alles aus Stein und sehr schlicht.");
  AddDetail("stein",
  "Der Stein ist dunkelgrau bis schwarz und weist rote Adern auf.");
  AddDetail(({"ader","adern"}),
  "Durch die Adern pulsiert Blut!!! Der Stein lebt!!!");
  AddDetail("blut",
  "Deines gerinnt vor Angst und das des Steines pocht dunkel dahin.");
  AddDetail("angst",
  "Sie steigt und steigt!");
  
  AddDetail("groesse",
  "Kaum anzuschaetzen, aber auf jeden Fall sehr gross.");
  AddDetail("fall",
  "UAH!!! Irgendjemand hat ein Fallbeil ober Dir ausgeloest!!! Es verfehlt "
  "Dich nur knapp!");
  

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "AHHHHHHH!!!!!!!!!!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verkohltem Fleisch!");
  
  
  mon=1;
  AddExit("westen", "./k4");
  AddExit("osten", "./k2");
   AddCmd(({"steche","stich","reisse","reiss","brich","breche"}), "tot");


    
   }
  //ich will das hier der spieler fps kriegt?!
  
  string show()
    {
    
    write("Du hast im Moment "+TP->QueryProp(P_EP_NUM)+" Forscherpunkte. Ich ziehe "
    "Dir nun aber "+TP->QueryProp(P_EP_NUM)*0.5+" davon ab!\n"); 
  say(CAP_TPN+" schaut dumm aus der Waesche.\n");
  return "";
  }
  
  
 tot(string str)
   {
   object k;
   notify_fail("Was willst Du mit dem Kokon machen?\n");
   if (!str) return 0;
   if(str=="kokon auf"||str=="kokon an"||str="in kokon")
      {
      if(mon)
      {
    write("Du machst Dich an den Kokon zu schaffen und ein grausiges Wesen "
    "schiesst blitzschnell aus dem Kokon hervor.\n");
    say(CAP_TPN+" macht sich an dem Kokon zu schaffen.\n");
    k=clone_object("/d/gebirge/dante/npc/km1.lpc");
    k->move(environment(TP), M_TPORT +M_SILENT);
    k->Kill(TP);
    mon--;
    return 1;
    }
    if (!mon)
       {
    write("Du machst Dich an dem Kokon zu schaffen, aber nichts passiert.\n");
    say(CAP_TPN+" macht sich an dem Kokon zu schaffen.\n");
    return 1;
        }
     return 0;
     }
   return 0;
   }
        
   
   
  string d_come()
     {
     object ob;
     if(t)
       {
       write("Ein grosser Fehler! Sofort stuerzt sich ein Tentakel auf Dich!\n");
       say(CAP_TPN+" ein Tentakel greift Dich an!\n");
       ob=clone_object("/d/gebirge/dante/npc/tent.lpc");
       ob->move(environment(TP), M_TPORT);
       t--;
       return "";
       }
       if (!t)
       {
       return "Die Tentakel schnellen auf und ab!\n";
       }
  }
      
      
  void reset()
    {
    ::reset();
    t=3;
    mon=1;
    }
         