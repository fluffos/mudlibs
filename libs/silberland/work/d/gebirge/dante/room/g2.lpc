//anfangsraum der hoehlen von dante
//unter der huette des totengraebers
#include "files.h"
inherit  "d/gebirge/dante/room/g_i";          


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int auf;


create()
{
  ::create();

AddItem("d/gebirge/dante/npc/fegeist", REFRESH_DESTRUCT);
auf=0;
AddDetail("boden",
"Der Boden hat hier eine duenne Staubschicht.");
AddDetail("staub",
"Was macht Staub denn hier?");
AddDetail("schicht",
"Staubschicht.");
AddDetail("staubschicht",
"Unter der Staubschicht ist eine Luke!");
AddSpecialDetail("luke","show");

AddExit("norden", "./g7");
AddExit("westen", "./g5");

AddExit("sueden", "./g1");
AddExit("osten", "./g6");

}


  string show()
    {
    if(auf==0)
      {
      write("Die Luke ist leider geschlossen.\n");
      }
      if(auf!=0)
      {
      write("Die Luke ist geoeffnet.\n");
      }
      return "";
      }
      
      
      
        open_door()
            {
            
                 AddExit("unten", "./gkeller");
                      auf=1;
               return 1;
               }
      
      
      void close()
          {
              auf=0;
        RemoveExit("unten", "./gkeller1");               
       }
   
   
     reset()
         {
             ::reset();
                 call_out("close", 0);
                     }                    