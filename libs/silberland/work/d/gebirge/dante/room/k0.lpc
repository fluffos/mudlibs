//anfangsraum der hoehlen von dante
//eingaNG ZU HUETTE

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int  hier, da;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Eingang in eine Hoehle" );
  SetProp( P_INT_LONG, BS(
  "Seltsam, hier aendert sich Deine Umgebung total. Der steinige Gebirgspfad "
  "endet hier in einem kleinen, sehr stillen Friedhof. Grabsteine und Kreuze "
  "stehen scheinbar wahlos um einen Altar herum. Der ganze Ort wirkt so friedlich "
  "und fast heilig. Im Westen liegt ein enorm grosser Felsblock, ja fast "
  "ein kleiner Berg. Ein kleines schmiedeeisernes Tor fuehrt direkt hinein."));
  
hier=1;
da=1;

AddDetail(({"kreuze","kreuz"}),
"Die Kreuze sind verwahrlost, andere scheinen gepflegter zu sein. "
"Die meisten Kreuze bestehen aus Holz, einige wenige aus Metall.");
AddDetail("holz",
"Das Holz ist Buchenholz.");
AddDetail("buchenholz",
"Hart.");
AddDetail("metall",
"Eisen.");
AddDetail(({"grabstein", "grabsteine"}), 
  "Die Grabsteine sind aus Granit gehauen und stehen wahllos "
  "um den Altar herum. An einem kann man eine Schrift erkennen.");
  AddDetail("schrift",
  "Lies sie.");
  AddDetail(({"grab", "graeber"}),
  "Die Graeber liegen verstreut um den Altar herum. Manche scheinen uralt zu sein, "
  "andere hingegen frisch. Eines der Graeber weisst frische Spuren auf.");
  AddDetail(({"spur", "spuren"}),
  "Hmm, irgendjemand hat hier gegraben.");
  
  AddReadDetail("schrift",
  "Hier liegt Noerd, der Unglueckselige.\n"
  "\n"
  "Darunter siehst Du einen kleinen, eingravierten Totenschaedel.");
 AddDetail(({"totenschaedel", "schaedel"}),
 "Der Schaedel scheint Dich anzugrinsen. Seine Augen blitzen Dich an.");
 AddSpecialDetail(({"augen", "auge"}), "ghost"); 
  AddDetail(({"fels", "felsbloecke", "felsblock"}),
  "Eigentlich wird der Friedhof von Felsbloecken umringt. Nur im Sueden "
  "kann man ungehindert diesen Ort verlassen. Der gigantische Felsblock "
  "im Westen, einfacherweise mit <gigantischerfelsblockderimwestenliegt> "
  "zu unteruschen, scheint sehr interessant zu sein.");
  AddDetail("gigantischerfelsblockderimwestenliegt",
  "Dein Fleiss wird belohnt! Durch ein Tor kann man in sein Inneres gelangen, "
  "oder wusstest Du das schon?!");
  AddDetail("fleiss",
  "Ohne Fleiss kein Preis blabla bla bla.");
  AddDetail("preis",
  "Ohne Preis...hmm mir faellt nichts bloedes ein...");
  AddDetail("boden",
  "Der Boden besteht aus brauner, weicher Erde.");
  AddDetail("erde",
  "Die Erde ist weich, ideal um Deinen Kadaver drin zu verscharren.");
  AddDetail("kadaver",
  "Baeh, der stinkt...");
  AddDetail("himmel",
  "Der Himmel ist wolkenlos, aber auch nicht strahlendblau, irgendwie indifferent. "
  "Ueberhaupt das Wetter hier im Gebirge schlaegt ja so leicht um.");
  AddDetail("gebirge",
  "Da befindest Du Dich, glaube ich ...");
  AddSpecialDetail("wetter", "come");
    
  AddDetail("umgebung",
  "Im Sueden war der Pfad noch steinig. Hier sieht man ausser einigen "
  "grossen Felsbloecken keinen einzigen Stein.");
  AddDetail("sueden",
  "Im Sueden liegt der Gebirgspfad.");
  AddDetail(({"gebirgspfad","pfad"}),
  "Der Gebirgspfad endet hier.");
  AddDetail("ansammlung",
  "Wahllos wurde ein Grab nach dem anderen gegraben.");
  AddDetail("altar",
  "Der Altar besteht aus weissem Marmor und ist teilweise mit Moos und Flechten "
  "ueberzogen. Man kann auch eine verblichene Inschrift erkennen. Der "
  "Altar ist eigentlich fast zu gross fuer diesen kleinen Friedhof. "
  "Irgendwie wirkt er hohl. Seine Ecken interessieren Dich.");
  AddDetail(({"ecken","ecke"}),
  "Die Ecken sehen recht seltsam aus. Weder rund noch eckig, kann man sowas "
  "ueberhaupt Ecken nennen ?  Egal, das kleine Portal ist sowieso "
  "interessanter...");
  AddDetail("portal",
  "Gut versteckt hinter einem Busch scheint es direkt in "
  "den Altar zu fuehren. Es ist schmal, aber Du passt sicher rein.");
  AddDetail("busch",
  "Der Busch ist genauso plaziert, dass er das kleine Portal verdeckt. "
  "Sicher mit Absicht...");
  AddDetail("absicht",
  "Wer das wohl war...");
  
  AddDetail("moos",
  "Kleines, gruenes Moos.");
  AddDetail(({"flechte", "flechten"}),
  "Die Flechten kleben direkt am Marmor.");
  AddDetail("marmor",
  "Es handelt sich um weissen Blutmarmor.");
  AddDetail("blutmarmor",
  "Der Blutmarmor heisst Blutmarmor, weil er mit duennen roten Linien "
  "durchzogen ist.");
  AddDetail(({"linien", "linie"}),
  "--------------------------------- so z.b.");
  AddDetail("inschrift",
  "Wie immer, lesen...");
  AddReadDetail("inschrift",
  "Gewidmet den zahllosen Ungluecklichen, die in den Hoehlen "
  "einen grausamen\n Tod fanden. Friede ihren verdammten Seelen!\n"
  "\n"
  "                             R.I.P.\n");
   
  AddDetail(({"stein","steine"}),
  "Steine sieht man hier nicht. Aber dafuer grosse, graue Felsbloecke.");
  AddDetail("friedhof",
  "Der Friedhof scheint eine willkuerliche Ansammlung von Graebern und Kreuzen "
  "zu sein. Einen Altar sieht man auch noch.");
  AddDetail("ort",
  "Hier ist es still, fast unheimlich. Doch der wahre Schrecken beginnt im Westen.");
  AddDetail("westen",
  "Im Westen liegt ein gigantischer Felsblock. Ein Tor fuehrt in ihn hinein.");
  AddDetail("berg",
  "1. Du befindest Dich auf einem Berg.\n"
  "2. Der Felsblock im Westen ist fast so gross wie ein kleiner Berg.\n");
  AddDetail("tor",
  "Das Tor im Felsblock schaut alt und sehr mitgenommen aus. Es besteht aus "
  "geschmiedetem Eisen. Rost scheint es zu zerfressen. Was aber interessanter ist, "
  "ist die Tatsache, das es nur angelehnt ist und man ohne Probleme in "
  "den Felsblock kann.");
  AddDetail("eisen",
  "Das Eisen wird langsam vom Rost zerfressen. Vom ehemals prunkvollen Muster "
  "ist kaum etwas zu erkennen. Irgendjemand hat am Eisen einen kleinen "
  "Zettel angebracht.");
  AddDetail("zettel",
  "Es handelt sich um keinen Zettel!!! Irgendein geschmackloser Typ hat "
  "hier die Haut eines Hobbit als Zettel verwendet, und eine "
  "Nachricht hinterlassen.");
  AddDetail("typ",
  "Es war der Totengraeber.");
  AddDetail("totengraeber",
  "Hmm, scheint nicht hier zu sein.");
  AddDetail("haut",
  "Die Haut ist duenn und getrocknet.");
  AddSpecialDetail("hobbit", "race");
  AddDetail("nachricht",
  "Lies sie!");
  AddReadDetail("nachricht",
  "+-----------------------------------+\n"
  "| Bin in meiner Huette, komme bald! |\n"
  "| Der Totengraeber                  |\n"
  "+-----------------------------------+\n");
   AddDetail("huette",
   "Hmm, Huette findest Du keine, aber eine kleine Holztuer.");
   AddDetail("holztuer",
   "An der Holztuer erkennst Du Buchstaben.");
   AddDetail(({"buchstaben","buchstabe"}),
  "Hmmm, Du kanns ein A, ein k ein o und ein n erkennen. Sonst nichts mehr.");    
  AddDetail("muster",
  "°+°+°+°+°+°+°+°\n"
  "o-o-o-o-o-o-o-o\n"
  "*I*I*I*I*I*I*I*\n"
  "Du denkst Dir 'Wow! Dante ist ein begnadeter Kuenstler!\n"
  "Ich muss ihm eine Mail schreiben und gratulieren!\n");
  AddDetail("rost",
  "Der Rost zersetzt langsam das Eisen. Irgendwann wird es total zerfallen.");
  AddDetail("tatsache",
  "Tatsache ist, das Dir dieser raum enorm gut gefaellt.");
  AddDetail(({"probleme", "problem"}),
  "Die wahren Probleme beginnen erst im Inneren des Felsblocks...");
  AddDetail(({"innerem", "inneren"}),
  "Geh doch hinein, Feigling!");
  AddSpecialDetail("feigling", "d_u");
  AddDetail("schrecken",
  "Los, versuche Dein Glueck im Westen!\n");
  AddDetail("glueck",
  "Nein, nicht immer bekommt man etwas , wenn man Glueck untersucht.");
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 0 );//cave aendern
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_MOUNTAIN]) );
  AddSound( DEFAULT_SOUND,
    "Hier ist es voellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Leichen.");
  AddCmd(({"betritt", "betrete","kriech","krieche","geh","steige","steig"}),
  "portal");  
  AddExit("westen", "./k1");
  AddExit("sueden", "./");//hier anschluss an eros blabla
  AddCmd(({"klopf", "klopfe"}), "in");   
  AddCmd(({"grabe", "grab"}), "down");
}

 int portal(string str)
    {
    if(str=="in portal"||str=="durch portal"||str=="portal"||
    str=="in altar"||str=="altar")
    {
    if(IS_WIZARD(TP))
      {
      write("Du als Magier(in) betrittst durch das Portal das Innere des Altars.\n");
      TP->move("d/gebirge/dante/room/altar", M_GO +M_SILENT);
      return 1;
      }
   if(TP->QueryQuest("Erloese Noerds Geist"))
     {
        write("Du betrittst durch das Portal das Innere des Altars.\n");
         TP->move("d/gebirge/dante/room/altar", M_GO +M_SILENT);
         return 1;
         }
     else
     {
     write("Du kannst noch nicht in das Innere des Altars.\n");
     return 1;
     }
     return 0;
     }
    return 0;
    }
            
    

 int in(string str)
   {
   notify_fail("Wo willst Du anklopfen?\n");
   if(!str) return 0;

     if
     (str=="an holztuer"||str=="an tuere"||str=="an tuer"||str=="an holztuere")
        {
      write("Du klopfst an die Holztuere.\n"
      "Die Holztuere wird von Innen geoeffnet und Du betrittst die Huette.\n");
      TP->move("/d/gebirge/dante/room/hu",M_GO, M_SILENT);
      return 1;
        }
     return 0;
     }



int down(string str)
  {
    notify_fail("Wo willst Du hier graben?\n");
      if(!str) return 0;
        if(member(({"in grab", "im grab", "loch in grab", "in spur"}),str)!=-1)
          {

 if(deep_present("\nhoehlenquestbydante", TP))
     {
     
          if(!present("schaufel", TP))
                 {
                        write("Mit blossen Haenden kommst Du nicht weit!\n");
                               return 1;
                                      }
                                      
       
       if(present("\ndanteschaufel", TP))
         {
         write("Du graebst ein Loch in das Grab und ploetzlich fuehlst "
         "Du Dich enorm in das Loch gezogen. Schliesslich saugt Dich das Loch "
         "in die Erde und schliesst sich ueber Dir!\n");
         TP->move("/d/gebirge/dante/room/ngr.lpc", M_TPORT,
         "in ein Grab gezogen", "wird",
         "erscheint ploetzlich vor Dir");
         return 1;
         }
         
     if(present("schaufel", TP))
       {
       write("Du graebst mit einer Schaufel, aber kommst auch nicht weit!\n");
       return 1;
       }
 
       return 0;
       }
       
if (!deep_present("\nhoehlenquestbydante", TP))
        {
        write("Du graebst und graebst, aber immer, wenn Du glaubst "
        "etwas Erde weggeschauffelt zu haben, faellt sie wie von Geisterhand "
        "bewegt wieder in das Loch zurueck. Gib es auf!\n");
        return 1;
        }
     return 0;
     }
   return 0;
   }

 string race()
   {
   int ras;
   ras=TP->QueryProp(P_RACE);
   if(TP->QueryProp(P_RACE)=="Hobbit")
      {
      write("Du zuckst zusammen, da Du doch selbst ein Hobbit bist.\n");
      }
      
      else
         {
         write("Dir als "+ras+" ist das voellig egal!\n");
         }
    return "";
    }          

 string ghost()
  {
  object ob;
  
  if(present("kgeist", environment(TP)))
     {
     write("Aber der Geist ist doch schon hier.\n");
     return "";
     }
     
  
  if(!present("\nhoehlenquestbydante", TP))
  {
  write("Du schaust die Augen an, aber etwas scheint Dir zu fehlen.\n");
  return "";
  }
  
     
  if(!hier)
    {
    write("Die Augen schauen enorm gefaehrlich aus!\n"
    "Aber es scheint nicht der richtige Zeitpunkt zu sein.\n");
    }
   
  if(hier)
     {
     write("Du schaust die Augen an und ploetzlich...\n");
     ob=clone_object("/d/gebirge/dante/npc/kgeist.lpc");
     ob->move("/d/gebirge/dante/room/k0.lpc", M_GO);
     ob->SetOwner(getuid(TP));        
     hier--;
     }
   
    
 return "";
 }
 
 
 reset()
 {
 ::reset();
 hier=1;
 da=1;
 }      
 
 
string come()
  {
  object fl, fl2;
  fl=present("hfl", TP);
  fl2=clone_object("d/gebirge/dante/obj/hfl2");
  switch(random(4))
  {
  object ob;
  case 0:
  write("Du schaust gen Himmel und ploetzlich beginnt es leicht und kurz zu "
  "regnen. Wirklich interessant das Wetter hier.\n");
  break;
  case 1:
 write("Du schaust gen Himmel und ploetzlich schiesst ein Blitz herab!\n"
 "WUMMMMMMM!!! Genau in Deinen Kopf!!! Verzage nicht...\n");
 TP->do_damage(10);
 break;
 case 2:
 write("Die Sonne scheint auf einmal herab, verschwindet aber bald wieder.\n"
 "Das Wetter hier interessiert Dich enorm.\n");
 break;
 case 3:
 if(deep_present("\nhoehlenquestbydante", TP))
   {
   
    if((da)&&(!present("hfl", TP))) 
       {
        write("Du schaust in den Himmel und ploetzlich regnet es kurz auf "
        "Dich herab! Das kostbare Nass versiegt sofort im Boden!\n"
        "Irgendetwas fehlt Dir, aber was...\n");
        }
    if((da)&&(present("hfl", TP))) 
       {
        write("Du schaust in den Himmel und ploetzlich regnet es kurz auf "
        "Dich herab!\n"
        "Etwas von dem kostbaren Nass faellt genau in Deine Flasche!\n");
        fl->remove();
        fl2->move(TP, M_GO);
          }
    if(!da)
       {
       write("Der Himmel scheint noch nicht bereit zu sein, was immer das auch "
       "heissen mag...\n");
       }
    }   
   else
   {
write
("Der Himmel sieht fuer Dich im Moment ziemlich uninteressant aus. Tja, Pech!\n");    
   }
   break;
              
 default: write("Das Wetter hier ist enorm doof.\n");
   }
   return "";
   
 }
 
 

string d_u()
  {
  write("Der Feigling bist Du, "+CAP_TPN+"!\n");
  say(CAP_TPN+" ist ein Feigling\n");
  return "";
  }

