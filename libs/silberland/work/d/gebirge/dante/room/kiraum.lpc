//raUM in der stadtmauer von tijara
//eher ne gruft was wess ich

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>

#define WARNED (member(gewarnt, getuid(this_player()))!=-1)
 string *gewarnt=({});


init()
{
::init();
if(!present("\nhoehlenquestbydante", TP))
  {
  write("SORRY! Ohne Questobjekt ist hier nix!\n");
  TP->move("d/gebirge/dante/room/k0", M_GO);
  }
}
  

int open, knochen;
create()
{
  ::create();
open=0;
knochen =1;
   SetProp(P_NO_TPORT, NO_TPORT_OUT);    


  SetProp( P_INT_SHORT, "Im der Kiste von Zok und Zak" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun in die Kiste von Zok und Zak geklettert. Ob das klug war, "
  "weisst Du nicht, denn der Deckel ist hinter Dir zugefallen. Angeblich "
  "sollen Zak und Zok hier des oefteren dumme Abenteurer einsperren, sie "
  "faulen lassen, und dann wenn sie so richtig schoen stinken, kreuzigen. "
  "Naja, viel Spass."));
  
  AddDetail("decke",
  "Decke gibt es hier eher nicht, eher einen Deckel der die Decke ist.");
  
  AddDetail("boden",
  "Der Boden ist ebenso aus Holz und eher hart. Eine Dinge liegen in der Kiste "
  "herum.");
  AddDetail(({"ding","dinge"}),
  "Naja, nichts aufregendes. Ein Zettel, ein Erzmagier, eine Zaubertrankliste, "
  "ein Stahldornpanzer, ein Wasserring...");
  AddDetail("zettel",
  "Lies den Zettel.");
  
  AddReadDetail("zettel",
  "Achtung! Ich, der unbekannte Erzmagier schlafe. RUHE!");
  AddDetail(({"erzmagier", "magier"}),
  "Du kannst den Erzmagier nicht genau erkennen, es ist zu dunkel hier.");
  AddDetail(({"liste", "zaubertrankliste"}),
  "Lies sie.");
  AddReadDetail(({"zaubertrankliste","liste"}),
  "1. Frag Wassergeist nach Zaubertrank\n"
  "2. Toete Balrog mit blossen Haenden\n"
  "3. Spucke einen Erzmagier an\n"
  "4. Toete eine Level 1 Spieler\n");
  AddDetail(({"panzer","stahldornpanzer"}),
  "Tja, Du glaubst doch nicht im ernst, dass Du den so leicht bekommst.");
  AddDetail(({"ring","wasserrig"}),
  "Naja, hier ist natuerlich kein Ring. Naja, hier ist doch einer, und "
  "zwar haengt einer vom Deckel herab. Wir nennen ihn Deckelring.");
  AddDetail("deckelring",
  "Hmm, der haengt einfach vom Deckel herab. Was Du erst jetzt endeckst ist, "
  "das der Deckel ein Geheimfach hat.");
  AddDetail("geheimfach",
  "Tja, wie kriegt man das auf.");
  
  AddDetail("spass",
  "Der Spass ist bald vorbei!\n");
  AddDetail("wand",
  "Die Wand ist fad und uninteressant. Eben Holz.");
  AddDetail("waende",
  "An den Waenden hat jemand eine kleine Notiz hinterlassen.");
  AddDetail("notiz",
  "Lies sie.");
  
  AddReadDetail("notiz",
  "Voller Name: Noerd\n"
  "Rasse: Mensch, Gilde: Idiotengilde, Geschlecht: maennlich\n"
  "Alter: 4d 12:16:50, Spielerlevel: 25, Seher\n\n"
  "Tja, was soll das wohl heissen?\n");
  
  AddDetail("balrog",
  "Balrog siehst Du hier keinen, aber einen schwarzen Fleck am Deckel.");
  AddDetail("fleck",
  "Lieber Gefangener!\n"
  "Auch ich , Noerd, war hier einmal gefangen. Der Chef von Zak und Zok hat "
  "mir aber rausgeholfen! "
  "Ich habe ihn einfach gefragt...\n "
  "Viel Glueck!\n");
  AddDetail(({"ring","wasserring"}),
  
  "Frag den Wassergeist danach.");
  AddDetail(({"geist","wassergeist"}),
  "Der Wassergeist teilt Dir mit: Komm mich mal besuchen!\n");
  
 AddDetail("kiste",
 "Die Kiste ist sehr gross und geraeumig. Man kann sie fast als Raum "
 "im Raum bezeichnen.");
 AddDetail("raum",
 "Der Raum besteht aus stabilen Holz, aufbrechen kann man hier sicher nichts.");
 AddDetail("holz",
 "Das Holz ist hart und dick. Keine Loecher, keine Spalten.");
 AddDetail(({"loch","loecher"}),
 "Keine Loecher.");
 AddDetail(({"spalte","spalten"}),
 "Du siehst viele Spalten. Nein KEINE!");
 AddDetail("deckel",
 "Der Deckel ist schwer und geschlossen.");
 AddDetail(({"zok","zak"}),
 "Die beiden haben sich ja gerade umgebracht, oder doch nicht. Vielleicht lachen "
 "sie ja draussen ueber Dich?!");
 AddDetail("abenteurer",
 "Tja, es kann auch Druiden erwischen.");
 AddDetail(({"druiden", "druide"}),
 "Tja, die Druiden auch.");
  
  SetProp( P_LIGHT, 0);
    SetProp( P_INDOORS, 1 );
      SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
        AddSound( DEFAULT_SOUND,
            "Du hoerst das Bruellen von Gekreuzigten!");
        AddSmell( DEFAULT_SMELL,
            "Es riecht nach Zok und Zak.\n");    

AddCmd(({"zieh","ziehe"}), "try");
AddCmd(({"oeffne"}), "op");
AddCmd(({"spuck","spucke"}), "dumm");
 }


int try(string str)
  {
  object ob;
  notify_fail("So nicht!\n");
  if(!str) return 0;
  
    if(str=="an deckelring"||str=="deckelring")
      {
      if(knochen)
          {
          write("Du ziehst am Deckelring und dabei geht das Geheimfach auf.\n"
          "Heraus faellt der Balrog, nein, der natuerlich nicht, sondern Knochen.\n");
          ob=clone_object("d/gebirge/dante/obj/bone3");
          ob->move(TP, M_GO);
          knochen--;
          return 1;
          }
      if(!knochen)
        {
        write("Du ziehst am Deckelring, es macht PLOPP!!!\n");
        return 1;
        }
    return 0;
    }
    return 0;
    }        
  
  getout(ob)
  {
  tell_object(ob,
  "Vlad oeffnet den Deckel, zieht Dich raus und verschwindet wieder.\n");
  ob->move("d/gebirge/dante/room/kreuz", M_GO+M_SILENT);
  }
  
   
  int dumm(string str)
    {
    int i;
    notify_fail("Welche Dummheit willst Du hier machen?\n");
     
     if(str=="erzmagier"||str=="magier"||str=="erzmagier an"||str=="magier an")
     {
       if(!WARNED)  
     {
     write("Du spuckst den Erzmagier das erstemal an. Hmm, nichts passiert, "
     "aber Du solltest wissen, dass beim zweitenmal etwas passieren wird. "
     "Du kannst auf diese Art aus der Kiste raus, aber hmm, vielleicht "
     "ist es gefaehrlich!\n");
      gewarnt += ({getuid(this_player())});    
     return 1;
     }
     if(WARNED)
     {
     write("Du spuckst den Erzmagier ein zweitesmal an. Er wacht auf, denn "
     "die meiste Zeit schlafen Erzmagier, ruelpst und sagt dann arrogant:\n"
     ""+TPN+" stoer doch meinen Schoenheitsschlaf nicht. Ich progge doch "
     "im Schlaf.\n"
     "Dann tritt er Dich weit weg!\n");
     TP->command_me("ziehe alles aus");
     TP->command_me("wirf alles weg");
     TP->move("d/dschungel/dante/hoehle/room/loch5", M_GO+M_NO_SHOW);
     return 1;
     }
   return 0;
   }
   return 0;
   }  
     
     
     
     
   
  int op(string str)
    {
    notify_fail("Was willst Du hier oeffnen?n");
    if(!str) return 0;
    if(str=="deckel"||str=="kiste")
      {
      write("Du oeffnest die Kiste. Hurra!\n");
      call_out("hihi", 3);
      return 1;
      }
    if(str=="geheimfach"||str=="fach")
      {
      write("Nein, so einfach geht das nicht.\n");
      return 1;
      }
        
      
     return 0;
     }
   
 void hihi()
   {
     if(environment(TP)!=TO || !TP) return 0;          
     write("Der Deckel faellt zu, und Dir genau auf den Kopf!\n"
     "WUMMMMMMMMMM!!!!!!!!AUA!!!!!!!\n");
     TP->do_damage(5);
     }
     
    
             