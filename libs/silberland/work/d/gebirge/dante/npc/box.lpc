// 97 dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


int z1, z2, z3, z4;
int antwort;
int t;



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  z1=3+random(7);
  z2=3+random(7);
  z3=3+random(7);
  z4=3+random(7);
    
  antwort=1+z1+z1*z2+z1*z2*z3+z1*z2*z3*z4;
 t=random(200)+antwort-random(200);
  SetProp(P_SHORT, "Ein Schachtelmonster");
  SetProp(P_LONG, BS(
   "Das ist das Schachtelmonster. Es hat die Form einer grossen Schachtel "
   "und ist auch eine alte Schachtel."));
   
  SetProp(P_NAME, "Schachtelmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({ "monster", "schachtelmonster"}));

  create_default_npc(13);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen starken Armen",130+random(20),DT_BLUDGEON}));
  SetProp(P_MAX_HP, 200+random(50));
  SetProp(P_BODY, 50+random(10));
 // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "waechter");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " verschachtelt sich und verschwindet.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");
  AddInfo("noerd",
  "Hehe! Du willst Noerds Gebeine, kannst Du haben! Frag "
  "mich einfach nach Raetsel.\n","sagt: ");
  AddInfo("schachtel",
  "Wuschel ist eine alte Schachtel!", "sagt: ");
  AddInfo(({"gebeine", "knochen"}),
  "Du meinst die Knochen von Noerd...");
  

AddSpell(3, 200,
  "Das Schachtelmonster wirft mit Schachteln nach Dir.\n",
  "Das Schachtelmonster wirft Schachteln nach @WEM.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));         


AddSpell(1, 300,
  "Das Schachtelmonster will Dich in eine Schachtel stopfen.\n",
  "Das Schachtelmonster will @WEN in eine Schachtel stopfen.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));         


AddCmd(({"schaetze"}), "test3");
AddCmd(({"raetsel"}), "test");
AddCmd(({"loesung"}), "test2");
}






test3()
  {
  
  write("\n"
  "Das Schachtelmonster sagt: Die Zahl ist ca. bei "+t+"!\n");
  return 1;
  }
  
test()
{
write("Das Schachtelmonster sagt: Ich habe eine Schachtel! In dieser Schachtel "
"befinden sich "+z1+" weitere Schachteln! In jeder dieser Schachteln sind "
"wiederum "+z2+" Schachteln! Und in diesen Schachteln habe ich "+z3+" Schachteln! "
"Und wiederum hab ich in diesen Schachteln "+z4+" Schachteln! Tja, wieviel "
"Schachteln hab ich nun???? tippe: loesung <zahl>\n");

return 1;
}

  test2(int was)
{object ob;
ob=clone_object("d/gebirge/dante/obj/schachtel");

  if (!was || was == "")
      return 0;
    
        
  if(was==""+antwort+"")
    {
    ob->move(TP, M_GO);
    write(
   "Das Schachtelmonster sagt: JA! Stimmt, Du Depp hast wohl gedacht, "
   "dass Du nun Noerds Gebeine bekommst, Irrtum, zuerst musst Du mich "
   "umlegen!\n");
    call_out("new", 0);
   return 1;
   
    }
  else
  {
  write("Das Schachtelmonster sagt: Falsch! Richtig waere: Sag ich nicht!\n");
  write("Eine kleine Hilfe: Tippe einmal schaetze!\n");  
  call_out("new", 0);
  return 1;
      }
return 0;
}

  void new()
  {
  t=0;
  antwort=0;
  z1=3+random(7);
  z2=3+random(7);
  z3=3+random(7);
  z4=3+random(7);
  antwort=1+z1+z1*z2+z1*z2*z3+z1*z2*z3*z4;
  t=random(200)+antwort-(200);
  return;
      
  }
  
  
  
    die(arg)
      {
        object ob;
          ob=clone_object("d/gebirge/dante/obj/bone2");
            ob->move(TP, M_TPORT);
     write("Das Schachtelmonster wirft Dir sterbend Noerds Gebeine zu "
     "und bruellt: Ich hoffe Du wirst gluecklich damit!\n");
     ::die(arg);
     }
     
     

 Defend(int dam, string dtype, int spell, object enemy)       
    {
    if(!present("SCHACHTEL", TP))
       {
       tell_object(enemy,
       "Du kannst das Schachtelmonster nicht treffen!\n"
       "Das Schachtelmonster tritt Dir voll ins Gesicht!\n");
       enemy->do_damage(10);
         enemy->StopHuntFor(ME);
         StopHuntFor(enemy);
        return 0;
        }
    else
     return::Defend(dam, dtype,spell, enemy);          
     }
     
                  