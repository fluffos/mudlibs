// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"




void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Folterknecht");
  SetProp(P_LONG, BS(
  "Das ist Dantes Folterknecht. Er ist schon sehr alt und schwach vom vielen "
  "Foltern. Trotzdem, wer weiss, was er so alles kann..."));  
  SetProp(P_NAME, "Folterknecht");
  SetProp(P_GENDER, MALE);
  AddId(({"knecht", "folterknecht"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(13);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Folterhaenden",150,DT_BLUDGEON}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);

AddCmd(({"folter","foltere","befreie","befrei","entfessle",
"entfessel","fessel","fessle"}), "noget", 1);      

  SetProp(P_INFO, "Der Folterknecht ist staerker als Du denkst!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  

  SetProp(P_DIE_MSG,  " sagt: Du Sadist!\n");
  
  
// SUID;
// for(i=0;i<random(3)+1;i++)      
// CLONEME("/d/gebirge/dante/obj/tdrink");
   
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Folterknecht damit?!\n" }) );
SetChats(5,({
 "Der Folterknecht sagt: Los foltere jemanden!\n",
 "Der Folterknecht sagt: Schmerzen bereiten ist gut!\n",
 "Der Folterknecht ruelpst laut.\n",
 "Der Folterknecht sagt: Ich werde Dich fesseln!\n",
 "Der Folterknecht schaerft einen Spiess.\n"}));
  SetProp(P_SPELLRATE,70);
  
  AddSpell(5,200,
   "Der Folterknecht will Dir Schmerzen bereiten!\n",
   "Der Folterknecht will@WEM Schmerzen bereiten!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,200,
   "Der Folterknecht foltert Dich!\n",
   "Der Folterknecht foltert Dich!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
    
  AddSpell(4,200,
   "Der Folterknecht bereitet Dir Schmerzen!\n",
   "Der Folterknecht bereitet Dir Schmerzen!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 
  AddSpell(2,300,
   "Der Folterknecht bereitet Dir Schmerzen!\n",
   "Der Folterknecht bereitet Dir Schmerzen!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 
 
  AddSpell(2,100,
   "Der Folterknecht versucht Dich zu fesseln!\n",
   "Der Folterknecht versucht Dich zu fesseln!\n",
     DT_MAGIC, "spell_t");


AddInfo("folterkammer",
"Die Folterkammer ist mein reich!", "sagt: ");
AddInfo("kammer",
"Hier foltere Ich Dich!\n");
 AddInfo("folter",
 "Folter macht Spass!", "lacht: ");
  enable_commands();
  
  set_living_name("folterknecht");
  
  }
  
  int noget()
    {
 write("Der Folterknecht bruellt: HE! Das mache nur ich!\n");
    return 1;
    }
    
   
   
  spell_t(object enemy,int damage,mixed dam_type)
    {
    switch(random(4))
      {
      case 0:
      tell_object(enemy,
      "Du hast Glueck, der Folterknecht schafft es nicht Dich zu fesseln!\n");
      break;
      case 1..3:
        enemy->StopHuntFor(ME);
        StopHuntFor(enemy);
call_other(("/d/gebirge/dante/room/fkammer"),"bondage", enemy);      
       break;
       default: write("BUG!\n");
       }
   }                   