// dante@SilberLand
//tentakel fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <wizlevels.h>   
int luegen;

init()
{
::init();
if(interactive(TP))
   {
  if(IS_WIZARD(TP))
    {
    write("Zak sagt: "+TPN+", wieder so ein daemlicher Magier...\n");
    }

if((!present("KALLOW", TP))&&(!IS_WIZARD(TP)))
  {
  write("Zak bruellt Dich an: HE, "+TPN+" verschwinde!\n");
  write("Zak tritt Dich wieder hinaus!\n");
  TP->move("d/gebirge/dante/room/k6", M_GO+M_SILENT);
  }
  if(present("KALLOW", TP))
  {
  write("Zak sagt: "+TPN+", sei gegruesst.\n");
  }
 }
  }
  

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Zak, der Gehilfe von Vlad");
  SetProp(P_LONG, BS(
  "Das ist Zak, einer der beiden Gehilfen von Vlad. Er ist dumm, aber extrem "
  "stark und brutal. Zak ist etwas klueger als Zok, aber auch noch "
  "sehr bloede."));
  SetProp(P_NAME, "Zak");
  SetProp(P_GENDER, MALE);
  AddId(({"zak", "ZAK", "gehilfe"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(75);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit brutalen Haenden",1000,DT_BLUDGEON}));
  SetProp(P_BODY, 400);
  luegen=0;
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
 set_living_name(({"zak","ZAK"}));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_FIRE:0.1, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "trampelt davon");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "trampelt davon");
  
  AddCmd(({"oeffne","kletter","steig","steige","lege","lieg"}), "nix", 1);
  
  SetProp(P_DIE_MSG,  " sagt: He! Du doofer Zok!\n");

 SetChats(9,({
  "Zak sagt: He, Zok, arbeite schneller.\n",
  "Zak sagt: Vlad wird wieder fluchen!\n",
  "Zak ruelpst extrem laut.\n",
  "Zak sagt: Du Wurm, was willst DU hier!\n",
  "Zak flucht laut.\n",
  "Zak sagt: Zok, Du Trottel!\n",
  "Zak tritt Zok.\n",
  "Zak sagt: Zok , Du stinkst.\n",
  "Zak wuergt Zok.\n",
  "Zak stosst Zok.\n"}));
     
  
  
  AddInfo(DEFAULT_INFO, "sagt: Frag Vlad!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Zak sagt: Danke, Du Trottel?!\n" }) );

  SetProp(P_SPELLRATE,60);

  
  AddSpell(2,1000,
  "Zak pruegelt wie irr auf Dich ein.\n",
  "Zak pruegelt wie irr auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

AddInfo("vlad",
"sagt: Das ist unser Boss.", "sagt: ");


AddInfo("kiste",
"Die Kiste lass ja in Ruhe!","sagt: ");
AddInfo("noerd",
"HEHE! Der Idiot Noerd!", "sagt: ");
AddInfo("gebeine",
"lacht ueber Deine Naivitaet!");
AddInfo("knochen",
"Ich sage Dir nix!", "grinst: ");
AddInfo("nagelbrett",
"Das ist unser Bett!", "sagt: ");
 
  AddSpell(3,1500,
  "Zak schlaegt brutal auf Dich ein.\n",
  "Zak schlaegt brutal auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,2000,
     "Zak schlaegt Dir fast den Schadel ein.\n",
     "Zak schlaegt @WEN fast den Schaedel ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,3000,
     "Zak pruegelt die ZENSUR aus Dir raus.\n",
     "Zak pruegelt die ZENSUR aus @WEM raus.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
            

AddCmd(({"lueg","luege"}), "k");
  
  } 

int k(string str)
   {
   object ob;
   ob=present("zok", environment(TO));
   notify_fail("Zak schaut Dich nur dumm an.\n");
     
      if(member(({"zak zok sagt du bist feig"}),str)!=-1)
         {
                   
         
  if(present("zok", environment(TP)))
            {
         if(luegen>=3)
            {
            luegen++;
         write("Du verraetst Zak, dass Zok sagt er sei ein Feigling.\n");
   write("Zak sagt: He, ZOK, was habe ich gehoert, Du bloeder %&&/%&$%!!!\n");
         Kill(ob);
           luegen==0;     
            return 1;
            }
            if(luegen<3)
              {
              luegen++;
         write("Du verraetst Zak, dass Zok sagt er sei ein Feigling.\n");
       write("Zak sagt: Ich bin kein Feigling, aber ich glaube Dir nicht.\n");
       return 1;
           }
           
           
           
       else
          {
       write("Zak sagt: Glueck fuer Zok, dass er nicht da ist!\n");
       return 1;
          }
    return 0;
    }
  return 0;
  }
return 0;
}
         

  die(arg)
 {
 object ob;
 ob=present("zok", environment(TO));
 if(ob)
   {
   ob->remove();
     tell_room("d/gebirge/dante/room/kreuz",
      "Zak schlaegt mit einem letzen toedlichen Streich auf Zok ein.\n"
      "Zak und Zok explodieren beide in einer gewaltigen Feuerwolke!\n");
   }
    ::die(arg);
    }

  
      

int nix()
   {
   write("Zak stoesst Dich brutal zu Boden!\n");
   return 1;
   }
   

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_FIRE }) ))
          
                  {
                     tell_room(environment(), "Zok freut sich sehr!\n");
                           heal_self(dam/2);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

          if (sizeof(dtype & ({ DT_MAGIC }) ))
          
                  {
                     tell_room(environment(), "Zok freut sich sehr!\n");
                           heal_self(dam/2);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  
  return ::Defend(dam, dtype, spell, enemy);
         }
   
   
   reset()
   {
   ::reset();
   luegen=0;
   }
         