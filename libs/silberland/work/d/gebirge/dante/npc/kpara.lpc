// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"




void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
 AddCmd(({"kletter","klettere","steig","steige"}), "nehmen", 1);
  SetProp(P_SHORT, "Ein Orkparasit");
  SetProp(P_LONG, BS(
   "Dieser Ork wohnt hier und ernaehrt sich von Speiseresten des Wesen.\n"));
  SetProp(P_NAME, "Orkparasit");
  SetProp(P_GENDER, MALE);
  AddId(({"ork","orkparasit","parasit"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(10);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen stinkenden Krallen",120,DT_ACID}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  
  SetProp(P_DIE_MSG, " bricht bruellend nieder!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
   "Der Orkparasit sagt: Hau ab!?!\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(2,300,
   "Der Orkparasit pruegelt auf Dich ein!\n",
   "Der Orkparasit pruegelt auf @WEN ein!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,200,
   "Der Orkparasit will Dich aussaugen!\n",
   "Der Orkparasit will @WEN aussaugen!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

    
  AddSpell(1, 100,
   "Der Orkparasit will Dich runter stossen\n",
   "Der Orkparasit will @WEN runter stossen\n",
    DT_TERROR, "spell_down");
  SetChats(10,({
  "Der Orkparasit grummelt Dich an!\n",
  "Der Orkparasit grinst Dich dumm an!\n",
  "Der Orkparasit sagt: Los, fressen wir das Wesen auf!\n",
  "Der Orkparasit beisst in die Wand.\n",
  "Der Orkparasit stinkt sehr.\n"}));
AddInfo("wesen",
"Deutet auf die Waende und sagt: FRESSEN!\n");



  } 
  
int nehmen()
  {
  write("Der Orkparasit tritt Dich runter!\n");
  TP->move("d/gebirge/dante/room/mund4", M_GO+M_NO_SHOW);
  return 1;
  }
  
  

 
   init()
   {
   ::init();
   if(interactive(TP))
       {
       write("Willkommen, "+CAP_TPN+", Du Parasit!\n");
       
       }
  }
  
    void spell_down(object enemy, int damage, mixed dam_type)
    {
    switch(random(2))
       {
       case 0:
       tell_object(enemy,
       "Der Orkparasit schafft es Dich runter zu stossen!\n");
       enemy->move("d/gebirge/dante/room/mund4", M_GO+M_NO_SHOW);
       break;
       case 1:
       tell_object(enemy,
       "Der Orkparasit schafft es nicht Dich runter zu stossen!\n");
       break;
       default: write("BUG!\n");
       }
    }
       
                        