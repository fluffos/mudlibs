// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Aaszombie");
  SetProp(P_LONG, BS(
  "Dieser kleine Zombie ernaehrt sich ausschliesslich von Aas. Das heisst, er erschlaegt "
  "Dich, laesst Dich dann verfaulen, und wenn Dein Kadaver schon stinkt, frisst "
  "er Dich auf!"));  

  SetProp(P_NAME, ({ "Aaszombie" , "Aaszombie", "Aaszombie", "Aaszombie"}));
  //der faelle wegen!
  SetProp(P_GENDER, MALE);
  AddId(({"km","zombie","aaszombie"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(12);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen stinkenden Krallen",150,DT_ACID}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Zombies ist nur eines: BOESE!!!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  
  SetProp(P_DIE_MSG, " verfault ploetzlich!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Aaszombie damit?!\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,200,
    "Der Aaszombie sticht Dir in den Bauch.\n",
    "Der Aaszombie sticht @WEM in den Bauch.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Der Aaszombie schlaegt Dir eine ueber den Schaedel.\n",
    "Der Aaszombie schlaegt @WEM eine ueber den Schaedel.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,300,
    "Der Aaszombie versucht Dir die Zunge abzubeissen.\n",
    "Der Aaszombie versucht @WEM die ZUnge auszureissen.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
    "Der Aaszombie atmet genau in Dein Gesicht.\n",
    "Der Aaszombie atmet genau in @WESSEN Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 
 
  
  SUID;
 // CLONEME(WEAPON"pfahl");
 // command("zuecke holz");
SetChats(7,({
  "Der Aaszombie will Dich schlachten.\n",
  "Der Aaszombie sagt: Los verfaule!\n",
  "Du faulst etwas.\n",
  "Der Aaszombie stinkt unglaublich.\n",
  "Der Aaszombie wuehlt in den Leichen herum.\n",
  "Der Aaszombie frisst ein verfaultes Bein!\n",
  "Du ekelst Dich vor dem Aaszombie.\n"}));
  
  
  } 
