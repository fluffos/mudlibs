

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Geist eines Waechters");
  SetProp(P_LONG, BS(
  "Das ist der Geist eines Waechters, der auch hier Wache haelt. "
  "Etwas anderes kann er nicht, aber das kann er dafuer gut."));
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({"waechter","geist","wgeist", "waechtergeist"}) );
  set_living_name("wgeist");
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit einem magischen Angriff", 100+random(20), ({DT_MAGIC})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 200, 
   "Der Geist blaest Dir Feuer ins Gesicht.\n",
    "Der Ggeist blaest @WEM Feuer ins Gesicht.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 300, 
    "Der Geist wirft Dich mit einer Feuerwolke fast um.\n",
    "Der Geist wirft @WEN mit einer Feuerwolke fast um.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
    "Der Geist entfacht einen Wirbelwind ueber Dir.\n",
    "Der Geist entfacht einen Wirbelwind ueber @WEM.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));



AddSpell(2, 300,
   "Der Geist will Dich ueberfluten.\n",
       "Der Geist will @WEN ueberfluten.\n",
            DT_WATER, ([SP_SHOW_DAMAGE:1]));
 SetChats(4, ({
    "Der Geist schwebt nach oben...\n",
    "Der Geist schwebt nach unten...\n",
    "Der Geist scheint voellig durchsichtig zu sein.\n",
    "Der Geist grinst Dich boese an.\n",
    "Der Geist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Geist sagt: Magst Du Feuer ?\n",
    "Der Geist schimmert roetlich...\n"}));
}


    Defend(int dam, string dtype, int spell, object enemy)     
       {
       tell_room(environment(),
       "Deine Angriffe fuegen dem Geist eines Waechters keinen Schaden zu.\n");
       heal_self(dam);
       return ::Defend(0, dtype, spell, enemy);
       }
   
   void pain()
     {
     object ob;
     ob=find_living("wgeist");
     ob->SetProp(P_AGGRESSIVE, 1);
     ob->do_damage(90);
     write("Der Geist zuckt zusammen und kruemmt sich vor Schmerzen!\n"
     ""+TPN+", Du bringst mich damit um!!\n");
        
     }
   
