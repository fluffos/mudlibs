// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


string owner;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boeser Geist namens Krath");
  SetProp(P_LONG, BS(
  "Aus irgendwelchen Gruenden hast Du nicht den Geist von Noerd gerufen, "
  "sondern einen anderen, viel boeseren Geist. Er weiss aber einiges ueber "
  "Noerd..."));  

  SetProp(P_NAME, ({"der Geist von Krath",
  "des Geist von Krath", "dem Geist von Krath",
  "den Geist von Krath"}));
  
  SetProp(P_GENDER, MALE);
  AddId(({"geist","krath", "kgeist"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(20);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen eiskalten Haenden",200,DT_TERROR}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Willst Du die Quest loesen, musst Du Kraths Geist besiegen!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " loest sich urploetzlich fluchend auf!\n");
  
  
  
  AddInfo(DEFAULT_INFO,({
  "sagt: Dir helfe ich Doch nicht!\n"}));
     
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll ein Geist damit?!\n" }) );


  SetProp(P_SPELLRATE,70);
  
call_out("weg", 900);  
  
  
 AddInfo("totengraeber",
 "Du meinst den alten Emil...", "sagt: ");
 AddInfo("noerd",
 "Noerd der Idiot, ging alleine in die Katakomben. "
 "Nun muss er auf ewig herumspuken und hat keine Ruhe.", "sagt: "); 
  
  AddInfo("krath",
  "Das war ich einmal, aber auch mich haben die Wesen "
  "der Katakomben verflucht. Ich muss dafuer sorgen, dass nirmand "
  "Noerd erloesen kann...", "sagt: ");
 
 AddInfo("geist",
 "Naja, ich bin einer, Du bist bald einer, was solls...","sagt: ");
 
AddInfo("friedhof",
"Wir Geister wohnen hier.", "sagt: ");
  
AddInfo("geisterkappe",
"Tja, die haettest Du wohl gerne, nix da!", "sagt: ");

AddInfo("kappe",
"Du meinst die Geisterkappe?", "lacht: ");

  
  
AddInfo("katakomben",
"Hier ist erst der Beginn der Katakomben. Dreh lieber um!"
"Dante hat sie gemacht und Du solltest wissen, dass er "
"Spieler, Seher und auch andere Magier gerne krepieren sieht!","sagt: ");

SetChats(5,({
 "Der Geist von Krath lacht Dich aus.\n",
 "Der Geist von Krath droht Dir.\n",
 "Der Geist von Krath fragt: Kennst Du die Geisterkappe?\n",
  "Der Geist von Krath sagt: Was willst Du Wurm!\n",  
  "Der geist von Krath sagt: Tja, ne Geisterkappe muesste man haben...\n",
  "Der Geist von Krath schwebt nach oben.\n",
  "Der Geist von Krath schwebt nach unten.\n"}));
  
  
  AddSpell(3,300,
    "Der Geist von Krath verflucht Dich.\n",
    "Der Geist von Krath verflucht @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  
  AddSpell(2,200,
    "Der Geist von Krath speit Wasser auf Dich.\n",
    "Der Geist von Krath speit Wasser auf @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));


  AddSpell(3,300,
    "Der Geist von Krath speit Feuer auf Dich.\n",
    "Der Geist von Krath speit Feuer auf @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

AddSpell(1, 300,
"Der Geist von Krath sagt: BUHHHH!!!\n",
"Der Geist von Krath sagt zu @WEM: BUUUHHHH!!!\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  } 



  void weg()
    {
    write("Der Geist von Krath grinst geisterhaft und verschwindet wieder.\n");
    TO->remove();
    }
    
void SetOwner(string str) {
  owner=str;
  }
  
  
  
  string QueryOwner() { return owner; }
  
  
  mixed _query_noattack()
  {
    if ((QueryOwner() != getuid(TP)) && (TP != ME))
        return "ist von Dir nicht zu treffen!";
          return 0;
          }


   init()
   {
   ::init();
   if(interactive(TP))
       {
        write("Der Geist von Krath sagt: Was willst DU, "+CAP_TPN+"!\n");
       }
  }



void die(int poisondeath)
{
 clone_object("d/gebirge/dante/armour/gkappe")->move(TP, M_NOCHECK);     
 write("Ploetzlich hast Du eine Geisterkappe in der Hand!\n");
   ::die(poisondeath);
                   }                    
                       