

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Feuergeist");
  SetProp(P_LONG, BS(
  "Das ist einer der seltenen Feuergeister. Sie sind aggressiv und boese."));  
  SetProp(P_NAME, "Feuergeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "feuergeist"}) );
  SetProp(P_AGGRESSIVE, 1);
    
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit einem kleinen Feuerstoss", 100+random(20), ({DT_FIRE})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Feuergeist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
   SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/g"));
     SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS );
       SetProp(P_MNPC_WAIT, ({10+random(10), 20, 15}));
 SetProp(P_MNPC_DEFAULTROOM, "d/gebirge/dante/room/g2");
  
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 200, 
   "Der Feuergeist blaest Dir Feuer ins Gesicht.\n",
    "Der Feuergeist blaest @WEM Feuer ins Gesicht.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 300, 
    "Der Feuergeist wirft Dich mit einer Feuerwolke fast um.\n",
    "Der Feuergeist wirft @WEN mit einer Feuerwolke fast um.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
    "Der Feuergeist entfacht einen Wirbelwind ueber Dir.\n",
    "Der Feuergeist entfacht einen Wirbelwind ueber @WEM.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));

 SetChats(4, ({
    "Der Feuergeist schwebt nach oben...\n",
    "Der Feuergeist schwebt nach unten...\n",
    "Der Feuergeist scheint voellig durchsichtig zu sein.\n",
    "Der Feuergeist grinst Dich boese an.\n",
    "Der Feuergeist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Feuergeist sagt: Magst Du Feuer ?\n",
    "Der Feuergeist schimmert roetlich...\n"}));
}
