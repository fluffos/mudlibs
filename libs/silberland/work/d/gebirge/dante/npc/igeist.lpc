// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Idiotengeist");
  SetProp(P_LONG, BS(
   "Das ist ein Geist eines Idioten, also, wenn Du mal tot bist z.b., wirst "
   "Du auch sowas werden. Sinnvolles kann er Dir sicher nicht sagen.\n"));  
  SetProp(P_NAME, "Idiotengeist");
  SetProp(P_GENDER, MALE);
  AddId(({"gi", "geist", "idiotengeist"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(12);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seiner Idiotie",150,DT_TERROR}));
  SetProp(P_BODY, 30);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Geist teilt Dir mit: Du Idiot!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
   AddInfo("hirn",
   "Was soll ich damit anfangen?", "sagt: ");
   AddInfo("gehirn",
   "Das ist mir nicht bekannt!", "sagt: ");
   SUID;
   CLONEME("d/gebirge/dante/obj/questhirn");
   
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "schwebt dumm grinsend");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "schnellt davon");
  SetProp(P_MNPC_WAIT, ({1, 1, 5}));
  SetProp(P_MNPC_DEFAULTROOM, "d/gebirge/dante/room/g7");
    SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/g"));
         SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS+
         MOV_INFIGHT);        

  SetProp(P_DIE_MSG,  " loest sich langsam in Dummheit auf!\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Ja, hurra und sowieso!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Idiotengeist damit?!\n" }) );
SetChats(5,({
  "Der Geist schwebt herum und lacht bloed.\n",
  "Der Geist schwebt durch Dich und grinst.\n",
  "Der Geist bohrt in der Nase.\n",
  "Der Geist sagt: Ja, das sage ich Dir!\n",
  "Der Geist kichert dumm.\n",
  "Der Geist sagt: Idiot mal zwei gleich Magier.\n"}));
  
  } 

      

init()
  {
  ::init();
  if(interactive (TP))
    {
    write("Hallo, "+CAP_TPN+", Du Idiot!\n");
    }
 }
    