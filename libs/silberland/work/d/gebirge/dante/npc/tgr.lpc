int runden;
void create()
{
  runden=0;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Emil, der Totengraeber");
  SetProp(P_LONG, BS(
  "Das ist Emil, der Totengraeber. Er lebt hier schon seit unzaehligen "
  "Jahren und hat seine Eigentuemlichkeiten. Viel Hilfe kannst Du Dir "
  "von ihm nicht erwarten, trotzdem ohne Emil, geht hier sicher nichts."));  

  SetProp(P_NAME, "Emil");
  SetProp(P_GENDER, MALE);
  AddId(({"emil", "totengraeber"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
