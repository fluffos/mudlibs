int go()
    {
    object ob;
    if(!present("\nhoehlenquestbydante", TP))
       {
       write("Emil freut sich und sagt: Erriggn Teditgp nsdotrctgh, "
       "iddm Frtrrfetziujedfn, swscedhrfatgu nsdaedctrh owdbtgefdn!\n"
       "Danach dreht sich Emil wieder von Dir weg!\n");
       ob=clone_object("/d/gebirge/dante/obj/hoehlenquest");
       ob->move(TP, M_GO);
       return 1;
       }
    if(present("\nhoehlenquestbydante", TP))
    {
    write("Emil sagt: Drru Dgtezhprep, wwsarfs wrfitgltgltgszht " 
    "Dreu swscbbhjkoujn wedirfetgdtgepor!\n");
    return 1;
    }
  }     

 Defend(int dam, string dtype, int spell, object enemy)
   {
   runden++;
   if(runden==3)
     {
    enemy->StopHuntFor(ME);
        StopHuntFor(enemy);
            
    enemy->move("d/gebirge/dante/room/dead", M_GO);
    runden=0;
    tell_object(enemy,
    "Emil bruellt: Deru wdfotzlhjlzutkledssgft jera neriercrthtzt hrtortezurzzeddn!\n");
        return::Defend(dam, dtype,spell, enemy);            
    }
    if(runden<3)
      {
      tell_object(enemy,
      "Emil sagt: Sfgtjkohjp!!!\n");
      return::Defend(dam, dtype, spell, enemy);
      }
    }  
    
    
   void give_notify(object ob)
    {
    if((ob->id("+CAP_TPN+SEELE")))
      {
      
      write("Der Totengraeber grinst und sagt auf einmal in verstaendlicher "
      "Sprache:\n"
      ""+CAP_TPN+", ich danke Dir, der arme Noerd hat nun seine Ruhe!\n");
      //give_quest blabla
      ob->remove();
      return;
      }
            
      else
      {
      ob->remove();
      write("Emil sagt: Derartnerkdfe!\n");
      return;
      }
      
      
     ::give_notify(ob);
   }
   
