// 97 dante@SilberLand
//waechter am anfang des dschungels
//laesst gewisse spieler nicht vorbei; selbst schuld:)))

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"





void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
} 
           

void create()
{
 
 
    if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Der Waechter des Dschungels");
  SetProp(P_LONG, BS(
   "Dieser kraeftige Waechter sorgt fuer Ruhe und Ordnung in Dantes "
   "Reich. Wenn Du Pech hast, laesst er Dich nie mehr in den Dschungel! "
   "Wenn dies der Fall ist, so hat das seinen Grund. Falls Du Dich ungerecht "
   "behandelt fuehlst, dann heul, jammer oder schreib an Dante. Angreifen solltest "
   "Du als Ausgeperrter den Waechter jedoch nie! Merk Dir das! Aber wie solltest Du das auch je schaffen..."));
  SetProp(P_NAME, "Waechter");
  SetProp(P_GENDER, MALE);
  AddId(({ "waechter"}));

  create_default_npc(75);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen starken Armen",130+random(20),DT_BLUDGEON}));
  SetProp(P_MAX_HP, 20000+random(50));
  SetProp(P_BODY, 1000+random(10));
  SetProp(P_RACE, "waechter");
  SetProp(P_SIZE, 10000);
  SetProp(P_NOATTACK, "lacht Dich nur aus!\n");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,99);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );
  
  AddInfo("malaria",
  "Willst Du eine Impfung kaufen?", "fragt: ");
  AddInfo("impfung",
  "Wenn Du geimpft werden willst, so tippe <impfung>. Es kostet aber "
  "etwas Geld.", "sagt: ");
  AddInfo( ({"geld", "kaufen"}),
  "Die Impfung kostet "+100*TP->QueryProp(P_LEVEL)+".", "antwortet: ");
  
  AddInfo(DEFAULT_INFO, "sagt: Hier herrscht Ruhe und Ordnung!\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");
  AddInfo(({"kneipe","haus","mini","schneckenhaus","tausendfuessler"}),
  "Wenn Du dorthin willst dann tipp < tausendfuessler > und ich bringe "
  "Dich sofort dorthin! Der Tausendfuessler wandert naemlich im ganzen "
  "Dschungel herum.", "sagt: ");  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Waechter sagt: Nein, auch so bekommst Du nichts von mir!\n" }) );


   AddCmd("impfung", "imp");

// AddCmd(({"destruct", "zap","remove","move"}), "no");
 AddCmd(({"tausendfuessler"}), "letsgo");
}


   imp()
   {
   object ob;
   int lev;
   lev=TP->QueryProp(P_LEVEL);
   if(TP->QueryMoney()<=100*lev)
   {
   write("Der Waechter sagt: Sorry, aber Du hast zu wenig Muenzen!\n");
   return 1;
   }
   if(present("\nimp", TP))
   {
   write("Der Waechter sagt: Nein! Du bist ja bereits geimpft!\n");
   return 1;
   }
   else
    {
    write("Der Waechter zueckt einen langen Stachel eines Insekts und "
    "bohrt in Dir mitten in den Bauch! Aua! Und das soll eine "
    "Impfung gewesen sein?\n");
    ob=clone_object("/d/dschungel/dante/weg/obj/imp.lpc");
    ob->move(TP, M_NOCHECK);
    TP->AddMoney(-lev*100);
    "/p/daemon/zentralbank"->PayIn(lev*100, 100);
    return 1;
    }
    return 0;
 } 
   
   
   
 letsgo()
   {
   write("Der Waechter sagt freundlich zu Dir:\n"
   "Okay, wie Du willst!!! Los gehts.\n"
   "Dann holt er aus und befoerdert Dich mit einem Kinnhaken ins Schneckenhaus.\n");
   TP->move("/d/dschungel/dante/weg/room/fak2", M_TPORT,
   "vom Waechter mit einem Kinnhaken wegbefoerdert","wird",
   "wird vom Waechter hereingepruegelt");
   return 1;
   }
   
   
/*
 no()
 {
  if (getuid(this_player())!="dante")          
   {
   write("Tja, Dein Pech!\n");
   TP->move("/room/jail.lpc");
   }
 }
*/   
   
   
 hallo()
{
  if(environment(TP)!=environment(TO))
    return;
 if (getuid(this_player())=="dante")
 {
 
 say(
 "Der Waechter verbeugt sich tief, laechelt und sagt danach: \n"
  "Keine Vorkommnisse, oh Dante! Alles in Ordnung!\n");
  return;
  }
           
  
   if (getuid(this_player())=="immomentkeinerweilkeinerbloedwar")
      {
   
   write(
   "Der Waechter des Dschungels lacht Dich aus und sagt hoehnisch spottend:\n"
   ""+TPN+", tja Pech gehabt! Du darfst auf Anordnung von Dante den Dschungel nicht mehr betreten!\n"
   "Darauf hin tritt er Dir ins Gesicht und Du fliegst wieder zurueck!\n");
   
   say("Der Waechter des Dschungels lacht "+TPN+" aus!!!\n"
   "Danach tritt er "+TPN+" wieder zurueck nach Tijara!\n");
   
   TP->move("d/dschungel/feyaria/tijara/room/tor_d7.lpc", M_GO ,
   "sich unter Heulen und Jammern wieder nach Tijara zurueck", "schleicht",
   "wird vom Waechter des Dschungel hier hergetreten");
   
         }

  
   if (getuid(this_player())=="fenris")
      {
    shout("Der Waechter des Dschungels bruellt extrem laut:\n"
    "Fenris, du altes Seicherl. Geh lieber in den Anfaengerpark!\n");
           
  write("Der Waechter sagt zu Dir: Ist ja nur ein Spass, Seicherl.\n");
  return;
  }
  
   if (getuid(this_player())=="trintrasil")
      {
      say("Der Waechter grinst dreckig wie ein Zug aus Wien und sagt:\n"
      "Hi, Trintrasil, als Chemiestudent solltest Du doch eher bei der \n"
      "chemischen Reinigung arbeiten. Und noch was, Mopeds sind keine "
      "idealen Schlafplaetze!\n");
      return;
      
      }
   if (getuid(this_player())=="skunk")
      {
      say("Der Waechter laechelt Skunk dumm an und sagt: Hi, Skunk! Alte Beutelratte!\n"
      "Wie gehts dem Beutelland?\n");
      return;
  }
  
  
   if (getuid(this_player())=="dings")
      {
    say("Der Waechter grinst genauso so dumm wie Dings und sagt dann:\n"
    "Hi Dings! Heute wieder Unfug treiben im Dschungel? Tja, da wird "
    "sich Dein Chef Amnenion aber nicht freuen. Ach, uebrigens, was ist das "
    "komische Dings da auf Deiner Nase, ein Pickel? Ih, eklig. Das kommt "
    "sicher vom saufen...\n");
     return; 
     }
  
   if (getuid(this_player())=="verdandi")
    {
  
   say("Der Waechter zuckt zusammen und sagt dann schuechtern:\n"
   "Hi, Verdandi, bitte spalte mich nicht, ich mag das gar nicht gerne.\n"
   "Dann schaut er hoehnisch und richtet ihr schoene Gruesse vom Ykath aus.\n");
    return;
  }
  
  
   if (getuid(this_player())=="chiara")
    {
    
    say("Der Waechter schaut freundlich und sagt zu Chiara:\n"
    "Hi, Chiara, sei froh, dass Du nicht Amnion oder Chorion heisst.\n"
    "Und noch was, alkoholfreies Bier hat seine Vorteile.\n");
    return;
  }
  
  
  
  
   if (getuid(this_player())=="amnenion")
    {
    sagt("Der Waechter salutiert und sagt dann zackig zu Friedl:\n"
    "Du, Amnenion, ich verrate Dir ein ein Geheimniss. Das Passwort von Dante "
    "ist doch nicht DuBloedeSau, sondern eher DantesHumoristdoof...\n");
    return;
    }
  
  
   if (getuid(this_player())=="eve")
      {
      say("Der Waechter schaut Eve an und sagt dann grinsend:\n"
      "Clautschi, Hallo! Bist Du einer Meinung mit mir, wenn ich behaupte, "
      "dass Brezel ein Spinner ist?\n");
      return;
        } 



  
   if (getuid(this_player())=="ovid")
      {
  say("Der Waechter grinst boese und sagt dann zu Ovid:\n"
   "Wappler, was testest denn wieder...\n");
    return;
      }

  
   if (getuid(this_player())=="vader")
      {
  say("Der Waechter grinst boese und sagt dann zu Vader:\n"
  "Hi, Vader, bitte leg Brezel noch mal um!\n");
    return;
      }
   else
        {
   write("Der Waechter des Dschungels nickt freundlich und sagt:\n"
   "Freut mich, dass Du wieder einmal vorbeischaust, "+TPN+"!\n");
   return;
   
        }
   }
   
