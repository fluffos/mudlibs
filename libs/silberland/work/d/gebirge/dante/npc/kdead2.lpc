// dante@SilberLand
//tentakel fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"




void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  AddCmd(({"nimm", "wuehle", "wuehl","roll","rolle","grab","grabe"}), "notake", 1);
  SetProp(P_SHORT, "Ein kleiner Zoakon");
  SetProp(P_LONG, BS(
 "Das ist ein sehr kleiner, sehr junger Zoakon. Eigentlich nicht gefaehrlich, wenn "
 "er alleine ist, das ist er aber sehr selten!\n"));
  SetProp(P_NAME, "Zoakon");
  SetProp(P_GENDER, MALE);
  AddId(({"zoakon", "mon"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(5);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit Saeurekrallen",100,DT_ACID}));
  SetProp(P_BODY, 25);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Greife den Zoakon nie mit Saeure oder Gift an!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_FIRE:0.1, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "kriecht blitzschnell");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "schnellt davon");
  
  SetProp(P_DIE_MSG,  " zerfaellt einfach!\n");

 SetChats(3,({
 "Der Zoakon schnellt ploetzlich vor.\n",
 "Der Zoakon schaut enorm giftig aus.\n",
 "Der Zoakon lacht Dich aus.\n",
 "Der Zoakon sagt: Verschwinde!\n",
 "Der Zoakon schleicht um Dich herum.\n"}));
   
  
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Zoakon damit?!\n" }) );

  SetProp(P_SPELLRATE,60);

  
  AddSpell(3,150,
    "Der Zoakon versucht Dich in den Kokon zu zerren.\n",
    "Der Zoakon versucht @WEM in den Kokon zu zerren.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
    "Der Zoakon zieht Dir eine Saeurekralle durchs Gesicht.\n",
    "Der Zoakon zieht @WEM eine Saeurekralle durchs Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));


  AddSpell(1,300,
    "Der Zoakon will Deinen Bauch aufreissen.\n",
    "Der Zoakon will @WESSEN Bauch aufreissen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,200,
    "Der Zoakon will Deinen Schadel knacken.\n",
    "Der Zoakon will @WESSEN Schaedel knacken.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  
  } 

  int notake()
    {
    write("Der kleine Zoakon hindert Dich daran!\n");
    return 1;
    }
    
