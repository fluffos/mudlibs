

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
int runden;

create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  runden=0;
  
  SetProp(P_SHORT, "Ein Geist eines Priesters");
  SetProp(P_LONG, BS(
  "Das ist ein ehemaliger Priester. Was er hier tut ist unklar. "
  "Aber so unfreundlich wie die anderen Geister ist er sicher nicht.\n"));
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist","priester", "priestergeist", "pgeist"}) );
  SetProp(P_INFO, "Der Geist eines Priesters sieht harmlos aus, "
  "Du solltest ihn aber trotzdem nie angreifen!\n");
  create_default_npc(12);
  SetProp(P_HANDS, ({" mit einem heiligen Angriff", 100+random(20), ({DT_HOLY})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  

AddInfo("geist",
"Ich bin einer.\n", "sagt: ");
AddInfo("priester",
"Tja, vor langer Zeit war ich einmal einer.\n", "sagt: ");
AddInfo("grab",
"Naja, Du bist in einem.\n", "sagt: ");
AddInfo("friedhof",
"Der Friedhof ist ueber uns.\n", "sagt: ");
AddInfo("noerd",
"Tja, der arme Noerd muss hier herumspuken. Irgendwie kann man ihn "
"angeblich erloesen. Wie weiss ich nicht, aber ich kenne seine letze "
"Ruhestaette.\n", "sagt: ");
AddInfo("kreuz",
"Mein Silberkreuz?\n", "sagt: ");

AddInfo("silberkreuz",
"Der Totengraeber hast mir gestohlen und irgendwo versteckt. Brings mir "
"wieder und ich bringe Dich zu Noerds Grab!\n", "sagt: ");
AddInfo("totengraeber",
"flucht laut.");
AddInfo("ruhestaette",
"Ich bringe Dich zu Noerds letzter Ruhestaette, wenn Du mir mein Silberkreuz "
"gibst. Wenn Du es hast, gibs mir und ich bringe Dich sofort hin." ,"sagt: ");


 SetChats(4, ({
    "Der Geist schwebt nach oben...\n",
    "Der Geist schwebt nach unten...\n",
    "Der Geist betet.\n",
    "Der Geist sagt: Kannst Du mir helfen?\n",
    "Der Geist sagt: Wo ist denn nur mein Kreuz!?\n",
    "Der Geist scheint voellig durchsichtig zu sein.\n",
    "Der Geist verschwindet, taucht aber hinter Dir wieder auf.\n"}));
}


   void give_notify(object ob)
        {
                 if( (ob->id("cross") ) )
          {
          write("Der Geist eines Priesters freut sich sehr und grinst "
          "gespenstisch. Dann macht er eine ausholende Bewegung mit den Armen, "
          "murmelt ein paar Worte, und Dir schwinden die Sinne.\n");
          ob->remove();
          TP->move("d/gebirge/dante/room/ngrab", M_SILENT+M_NO_SHOW+M_GO);
          return;
          }
             ::give_notify(ob);
                }
                                        


 Defend(int dam, string dtype, int spell, object enemy)
    {
   runden++;
   
   if(runden==3)
     {
        enemy->StopHuntFor(ME);
                StopHuntFor(enemy);
   enemy->move("d/gebirge/dante/room/dead", M_GO);
   write("Der Geist bruellt: Stirb!\n");
  runden=0;
 return::Defend(dam, dtype,spell, enemy);
             }
             
       if(runden<3)
          {
          write("Der Geist sagt: Lass das lieber!\n");
          return::Defend(dam, dtype,spell, enemy);
          }
       }
                                 