//wurm fuer katakomben dante

inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Leichenmade");
  SetProp(P_LONG, BS(
  "Die Leichenmaden leben am liebsten in Leichen. In Deiner sicher auch bald.\n"));
  
  SetProp(P_NAME, "Leichenmade");
  SetProp(P_GENDER, FEMALE);
  AddId(({"km","made", "leichenmade"}));
  
  create_default_npc(4);
  SetProp(P_HANDS, ({" mit ihren giftigen Saugern", 40, DT_POISON}));
  SetProp(P_RACE, "Made");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, -100);

  SetProp(P_MSGIN, "kriecht faulig herein");
  SetProp(P_MSGOUT, "kriecht faulig");
  SetProp(P_MMSGIN, "kriecht aus einer Leiche heraus");
  SetProp(P_MMSGOUT, "kriecht wieder in eine Leiche zurueck");
  SetProp(P_DIE_MSG,  " kriecht in eine Leiche zurueck.\n");
  SetProp(P_DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Leichenmade kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_MAX_HANDS, 0);

}
