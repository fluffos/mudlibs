// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <ansi.h>
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, ""+ANSI_BOLD+ANSI_PURPLE+"Ein violettes Schluesselwesen");
  SetProp(P_LONG, BS(
  ""+ANSI_PURPLE+ANSI_BOLD+"Das ist eines der seltenen Schluesselwesen. "
  "Es gbt sie in mehreren Farben. Dieses hier ist violett. Sein Kopf hat "
  "die Form eines Schluessels."));
  AddDetail("kopf",
  ""+ANSI_PURPLE+ANSI_BOLD+"Der Kopf des Schluesselwesens sieht wie ein Schluessel aus.");
  AddDetail("schluessel",
  "Der Kopf sieht wie einer aus...");
  AddDetail(({"farben","farbe"}),
  "Angeblich sind es 4 Farben, oder auch mehr...");
  
  SetProp(P_NAME, "Schluesselwesen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"wesen","schluesselwesen"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen violetten Haenden",160,DT_MAGIC}));
  SetProp(P_BODY, 45);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Kopf des Wesen ist wirklich ein Schluessel.\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_MAGIC:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  
  SetProp(P_DIE_MSG, " loest sich in violetten Dunst auf!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "sagt: Ich liebe Violett!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Schluesselwesen sagt: Nein, danke!\n" }) );
AddInfo(({"farben","farbe"}),
"Hmm, ich mag die Farbe Violett am liebsten!", "sagt: ");
AddInfo("violett",
"Violett ist nett!", "freut sich: ");
AddInfo("kopf",
"Mein Kopf bleibt dran!", "sagt: ");
  SetProp(P_SPELLRATE,60);
  AddInfo("schluessel",
  "Hmm, das ist mein Kopf und der bleibt dran!", "sagt: ");
  
  
  
  
  
  AddSpell(3,300,
  "Das Schluesselwesen huellt Dich in violetten Dunst ein.\n",
  "Das Schluesselwesen huellt @WEN in violetten Dunst ein.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 
  
  AddSpell(1,400,
  "Das Schluesselwesen schuettet violette Farbe ueber Deinen Kopf.\n",
  "Das Schluesselwesen schuettet violette Farbe ueber @WESSEN Kopf.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 
  
  AddSpell(1,300,
  "Das Schluesselwesen rammt seinen violetten Kopf in Dich.\n",
  "Das Schluesselwesen rammt seinen violetten Kopf in @WEN.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 
 
  
SetChats(7,({
   "Das Schluesselwesen sagt: VIOLETT!\n",
   "Das Schluesselwesen sprueht violette Farbe an die Wand.\n",
   "Das Schluesselwesen sieht violette Veilchen.\n",
   "Das Schluesselwesen sagt: Magst Du Violett?\n",
   "Das Schluesselwesen redet violett.\n"}));
     
  
  } 


  die(arg)
  {
  object ob;
  ob=clone_object("d/gebirge/dante/obj/keyvio");
  ob->move(TP, M_TPORT);
  write("Der Kopf des Schluesselwesens genau in Deine Haende!\n");
  ::die(arg);
  }
  