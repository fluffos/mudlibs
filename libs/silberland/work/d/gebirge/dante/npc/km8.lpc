// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Figur aus Lehm");
  SetProp(P_LONG, BS(
  "Vor Dir siehst Du eine kleine, lebende Figur, geschaffen aus Lehm. "
  "Es ist ein genaues Ebenbild von Dante, oder wie er angeblich aussieht. "
  "Nur eben viel, viel kleiner und freundlicher. Er will nicht, dass Du "
  "die Katakomben betrittst, weil er weiss, dass Du dann sicher bei Lars "
  "vorbeischaust. Er hat seine guten Gruende dafuer..."));    

  SetProp(P_NAME, "Lehmfigur");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lehmfigur","figur"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(6);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen kleinen Lehmhaenden",70,DT_BLUDGEON}));
  SetProp(P_BODY, 20);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: -1.0, DT_TERROR:1.0]));
AddInfo("skyta",
"Wenn Du direkt hin willst, tippe <skyta>. Es kostet aber etwas Magie!",
"sagt: ");
AddCmd("skyta", "go");   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "entsteht aus Lehm");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "entsteht aus Lehm");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " zerbroeselt zu Staub!\n");
  
  SetProp(P_INFO, "Frag die Lehmfigur nach Skyta!\n");
  
  
 
 
  AddInfo(DEFAULT_INFO,({
  "zuckt nur mit den Schultern.\n",
  "sagt: Hmm, frag lieber Skyta.\n",
  "sagt: Keine Ahnung!\n",
  "sagt: Dante war sehr faul. Ich bin dumm.\n",
  "grinst wissen.\n",
  "sagt: Bla Bla!\n",
  "sagt: Tja, das fragten viele schon.\n"}));
 
 
 
 
  AddInfo("dante", "Dante, mein Meister!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Lehmfigur sagt: Danke!\n" }) );

AddInfo("katakomben",
"Huete Dich davor!", "sagt: ");
AddInfo("lehm",
"Daraus bin ich erschaffen.","sagt: ");
AddInfo("katakombe",
"Geh nicht runter!", "sagt: ");
AddInfo("eingang",
"Das bewache ich!", "sagt: ");
AddInfo("tor",
"Ich lasse keinen vorbei!", "sagt: ");

  SetProp(P_SPELLRATE,50);
  
  AddSpell(3,80,
  "Die Lehmfigur rammt Dich ins Knie.\n",
  "Die Lehmfigur rammt @WEN ins Knie.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Die Lehmfigur springt Dir ins Gesicht.\n",
    "Die Lehmfigur springt @WEM ins Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
SetChats(5,({
"Die Lehmfigur sagt: Halt!\n",
"Die Lehmfigur sagt: Dreh um!\n",
"Die Lehmfigur zerbroeselt etwas.\n",
"Die Lehmfigur laechelt freundlich.\n",
"Die Lehmfigur sagt: Der Anfaengerpark ist fuer Dich geeigneter.\n",
"Die Lehmfigur sagt: Hmm, bring lieber Bienen um.\n",
"Die Lehmfigur sagt: Pass doch besser auf Deine Xps auf.\n"}));

  
  
  
  
  } 

  go()
    {
    object ob;
    
    if(TP->QueryProp(P_SP)<=20)
      {
      write("Die Lehmfigur sagt: Nein! Du hast zu wenig Magie!\n");
      return 1;
      }
      else
      {
     ob=find_living("skyta");
     
     if(objectp(ob))
     {
     write("Die Lehmfigur schaut Dich seltsam an und...\n");
     TP->move(environment(ob), M_TPORT);
     TP->restore_spell_points(-20);
     return 1;
     }
     else
     {
     write("Die Lehmfigur sagt: Skyta ist tot!\n");
     return 1;
     }
     
     return 0;
     }
  return 0;
  }
  