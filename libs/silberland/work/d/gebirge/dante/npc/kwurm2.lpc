//wurm fuer katakomben dante

inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Aaswurm");
  SetProp(P_LONG, BS(
"Das ist ein ekliger Aaswurm. Woher er seinen Namen hat ist klar, er will Dich, "
"wenn Du bald tot bist, fressen!"));  
  SetProp(P_NAME, "Aaswurm");
  SetProp(P_GENDER, MALE);
  AddId(({"km","wurm", "aaswurm"}));
  
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen winzigen faulen Zaehnchen", 30, DT_POISON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, -100);

  SetProp(P_MSGIN, "kriecht faulig herein");
  SetProp(P_MSGOUT, "kriecht faulig");
  SetProp(P_MMSGIN, "kriecht aus einer Leiche heraus");
  SetProp(P_MMSGOUT, "kriecht wieder in eine Leiche zurueck");
  SetProp(P_DIE_MSG,  " kriecht in eine Leiche zurueck.\n");
  SetProp(P_DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Aaswurm kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_MAX_HANDS, 0);

}
