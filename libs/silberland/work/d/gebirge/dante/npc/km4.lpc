// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


int dukantha;
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Dukantha");
  SetProp(P_LONG, BS(
  "Die Dukantha hat 2 Koepfe auf denen lange Hoerner wachsen!"));
  AddDetail(({"koepfe","kopf"}),
  "Zwei!");
  AddDetail(({"horn","hoerner"}),
  "1, 2, 3, 4, 5, 6, 7, 8!");  
  SetProp(P_NAME, "Dukantha");
  SetProp(P_GENDER, FEMALE);
  AddId(({"dukantha"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(16);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
 // SetProp(P_HANDS, ({" mit seinem Feueratem",250,DT_FIRE}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_INFO, "Die Dukantha hasst alles!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0.3);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "schiesst herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "schiesst herein");
  SetProp(P_MMSGOUT, "schiesst davon");
  
  SetProp(P_DIE_MSG,  " bricht bruellend nieder!\n"
  "Ein Kopf zerplatzt, der andere bleibt liegen!\n");
  SetProp(P_TRANSPARENT, 1);
  
  SUID;
  CLONEME("/d/gebirge/dante/armour/duk");
  //absichtlkich net anzogen:) 
  
  
    
  AddInfo(DEFAULT_INFO, "bruellt laut!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll die Dukantha damit?!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(3,300,
    "Die Dukantha stoesst mit einem Horn nach Dir.\n",
    "Die Dukantha stoest mit einem Horn nach @WEM.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,400,
    "Die Dukantha schnappt mit ihrem linkem Kopf nach Dir.\n",
    "Die Dukantha schnappt mit ihrem linkem Kopf nach @WEM.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,400,
    "Die Dukantha schnappt mit ihrem rechtem Kopf nach Dir.\n",
    "Die Dukantha schnappt mit ihrem rechtem Kopf nach @WEM.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,600,
    "Die Dukantha stoesst ein Horn in Dein Bein.\n",
    "Die Dukantha stoesst ein Horn in @WESSEN Bein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,500,
    "Die Dukantha rammt Dich brutal.\n",
    "Die Dukantha rammt Dich brutal.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

SetChats(15,({
//absichtlich hoch
 "Der rechte Kopf der Dukantha dreht sich zu Dir.\n",
 "Der linke Kopf der Dukantha dreht sich zu Dir.\n",
 "Die Hoerner sehen ziemlich bedrohlich aus.\n",
 "Die Dukantha bedraengt Dich.\n",
 "Die Dukantha bruellt auf einmal laut auf.\n",
 "Die Dukantha grunzt angressiv.\n"}));
 
  SetProp(P_TRANSPARENT, 0);
  //absichtlich sieht man nix weil ja nur ein schedel in ihr is...aber im long
  //steht das es 2 sin:)
  
  } 

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_AIR }) ))
          
                  {
                     tell_room(environment(), "Die Dukantha freut sich sehr!\n");
                           heal_self(dam);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  


  
          if (sizeof(dtype & ({ DT_RIP }) ))
          
                  {
                     tell_room(environment(), "Die Dukantha bruellt vor Schmerz!\n");
                           heal_self(2*dam);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

 return ::Defend(dam, dtype, spell, enemy);
          }

  
  heart_beat()
  {
    ::heart_beat();
        return ::heart_beat();
          }



Attack(object enemy)
{
SetProp(P_HANDS,({" mit dem "+((dukantha=!dukantha)?"linkem":"rechtem")+" Kopf",
 170+random(20),({DT_RIP,DT_UNHOLY}) }));
    return ::Attack(enemy);
    }          

