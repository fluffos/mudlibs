// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

int i;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Idiotengeist");
  SetProp(P_LONG, BS(
   "Das ist ein Geist eines Idioten, also, wenn Du mal tot bist z.b., wirst "
   "Du auch sowas werden. Sinnvolles kann er Dir sicher nicht sagen.\n"));  
  SetProp(P_NAME, "Idiotengeist");
  SetProp(P_GENDER, MALE);
  AddId(({"gi", "geist", "idiotengeist"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seiner Idiotie",150,DT_TERROR}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Geist teilt Dir mit: Du Idiot!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "schnellt davon");
  

  SetProp(P_DIE_MSG,  " loest sich langsam auf!\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Frag mich alles was Du willst!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Idiotengeist damit?!\n" }) );
SetChats(5,({
  "Der Geist schwebt herum und lacht bloed.\n",
  "Der Geist schwebt durch Dich und grinst.\n",
  "Der Geist bohrt in der Nase.\n",
  "Der Geist sagt: Ja, das sage ich Dir!\n",
  "Der Geist kichert dumm.\n",
  "Der Geist sagt: Idiot mal zwei gleich Magier.\n"}));
  
  } 



Defend(int dam, dam_type)
{
 object enemy, schl;

   if(!(enemy = QueryEnemy()))
          enemy = TP ;

  if(schl = present("mbone", enemy))
      {
  if(schl -> QueryWielded())          
 return ::Defend(dam, dam_type) ;     

else
   tell_object(enemy,
   "Der Idiotengeist erschrickt als er den Knochen sieht.\n");
   }
   
 tell_object(enemy,
           "Der Idiotengeist lacht: Mit der Waffe willst Du mich angreifen?\n"
           "Der Idiotengeist tritt Dir ins Gesicht!\n");
           
      enemy->do_damage(10);     
    StopHuntingMode() ;
  enemy->StopHuntingMode() ;
 }
                                  
   



   die(arg)
    {
    object ob;
    if(present( "\nhoehlenquestbydante", TP))
        {
      ob=clone_object("/d/gebirge/dante/obj/sch");
      ob->move(TP, M_NOCHECK);
      write("Der Idiotengeist wirft sterbend mit einem Gegenstand nach Dir.\n");
        }
      ::die(arg);
      }
      

init()
  {
  ::init();
  if(interactive (TP))
    {
    write("Hallo, "+CAP_TPN+", Du Idiotenfreund!\n");
    }
 }
    