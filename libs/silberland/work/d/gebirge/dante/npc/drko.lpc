//kopf fuer drachen

inherit "std/npc";
#include "files.h"
#include <combat.h>
#include <properties.h>

#define TV(x) if(find_player("dante")) tell_object(find_player("dante"), "Kopf["+x+"]\n")

mapping ausgaenge;

create()
{
  ::create();
  SetProp(P_SHORT, "Ein Kopf des Drachen");
  SetProp(P_LONG, BS(
  "Ein Testdrachenkopf."));
  
  SetProp(P_NAME, "Drachenkopf");
  AddId(({"drachenkopf", "kopf", "drache"}));
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_KILL_MSG, "hssssss\n");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 450);
  SetProp(P_LEVEL, 20);
  SetProp(P_ALIGN, -500);
  SetProp(P_RACE, "Drache");
  SetProp(P_MAX_HP, 400);
  SetProp(P_HP, 400);
  SetProp(P_RESISTANCE, ({DT_MAGIC,DT_SLASH,DT_FIRE,DT_ACID}));
 // SetProp(P_XP, 5*320*QueryProp(P_MAX_HP));
  SetProp(P_HANDS, ({ " mit seinem fuerchterlichen Gebiss ", 320}));
  SetProp(P_BODY, 300);
  SetProp(P_MSGIN, "schlaengelt sich pruefend umblickend herein");
  SetProp(P_MSGOUT, "verschwindet zischend");
  AddCmd(({"w", "w", "w", "o","o","o"}), "block");
  
  enable_commands();
  set_living_name("drachenkopf");
  SetAttackChats(45, ({"@@nimm_dies@@"}));
}


 die()
 {
  object dr;
  if (dr=find_object("/d/gebirge/dante/npc/testdrache"));
  
    dr->return_death(this_object(),
    // get_killer_object(),
      10+random(5));
  return ::die();
}



nimm_dies()
{
  object *enemies, *inhalt;
  int i, staerke;

  staerke=0;
  enemies=({});
  inhalt=all_inventory(environment(this_object()));
  for(i=0;i<sizeof(inhalt);i++)
  {
    if(interactive(inhalt[i]))
      enemies+=inhalt[i];
    if(inhalt[i]->id("drachenkopf"))
      staerke++;
  }
  if(enemies && staerke)
  {
    if(staerke>1)
      tell_room(environment(this_object()), "Die Drachenkoepfe speien einen giftigen, gruenen Nebel in den Raum.\n");
    else
      tell_room(environment(this_object()), "Der Drachenkopfspeit einen giftigen, gruenen Nebel in den Raum.\n");
    for(i=0;i<sizeof(enemies);i++)
      enemies[i]->Defend((60*staerke), DT_ACID, 0, this_object());
  }
  return "";
}

return_dummy(){ return ausgaenge;}

block()
{

  object *inhalt;
  int i, enemies, koepfe;
  string wohin;

  wohin=query_verb();
  ausgaenge=environment(this_object())->QueryProp(P_EXITS) || (["test":"test1"]);
TV(wohin);
  if(!member(ausgaenge, wohin))
    return 0;
  if(!present(find_living("testdrache"), ausgaenge[wohin, 0])
    || present(find_living("testdrache"), environment(this_object())))
    return 0;
  enemies=0; koepfe=0;
  inhalt=all_inventory(environment(this_object()));
  for(i=0;i<sizeof(inhalt);i++)
  {
    if(interactive(inhalt[i]))
      enemies++;
    if(inhalt[i]->id("drachenkopf"))
      koepfe++;
  }
  if(enemies>koepfe)
    return 0;
  write("Der Drache versperrt Dir den Weg.\n");
  tell_room(environment(this_object()), this_player()->name()
    +" versucht sich vergeblich an dem Drachen vorbeizuschmuggeln.\n",
    ({this_player()}));
  return 1;
}




catch_tell(str)
{
  string wer, bla;
  object att;

  if(!str)
    return 0;
  if(sscanf(str,"  %s greift den Drachen%s",wer,bla)!=2)
    return 0;
  att=find_player(lower_case(wer));
  if( att && present(att, environment()))
    Kill(att);
  return 1;
}
