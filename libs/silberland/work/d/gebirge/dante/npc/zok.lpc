// dante@SilberLand
//tentakel fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Zok, der Gehilfe von Vlad");
  SetProp(P_LONG, BS(
  "Das ist Zok, einer der beiden Gehilfen von Vlad. Er ist dumm, aber extrem "
 "stark und brutal.  Wahrscheinlich ist der duemmer aber auch etwas brutaler als Zak."
  " Huete Dich vor ihm..."));
  SetProp(P_NAME, "Zok");
  SetProp(P_GENDER, MALE);
  AddId(({"zok", "ZOK", "gehilfe"}));
  set_living_name(({"ZOK", "zok"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(75);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit gewaltigen Haenden",1000,DT_BLUDGEON}));
  SetProp(P_BODY, 500);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_FIRE:0.1, DT_TERROR:-1.0]));
      
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "trampelt davon");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "trampelt davon");
  
  SetProp(P_DIE_MSG,  " sagt: He! Du doofer Zak!\n");

 SetChats(9,({
  "Zok sagt: He, Zak, arbeite schneller.\n",
  "Zok sagt: Vlad wird wieder fluchen!\n",
  "Zok ruelpst extrem laut.\n",
  "Zok sagt: Du Wurm, was willst DU hier!\n",
  "Zok flucht laut.\n",
  "Zok sagt: Zak, Du Trottel!\n",
  "Zok tritt Zak.\n",
  "Zok sagt: Zak , Du stinkst.\n",
  "Zok wuergt Zak.\n",
  "Zok stosst Zak.\n"}));
     
  
  
  AddInfo(DEFAULT_INFO, "sagt: Frag Vlad!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Zok sagt: Danke, Du Trottel?!\n" }) );

AddInfo("vlad",
"sagt: Das ist unser Boss.", "sagt: ");


AddInfo("kiste",
"Die Kiste lass ja in Ruhe!","sagt: ");
AddInfo("noerd",
"HEHE! Der Idiot Noerd!", "sagt: ");
AddInfo("gebeine",
"lacht ueber Deine Naivitaet!");
AddInfo("knochen",
"Ich sage Dir nix!", "grinst: ");
AddInfo("nagelbrett",
"Das ist unser Bett!", "sagt: ");

  SetProp(P_SPELLRATE,60);

  
  AddSpell(2,1000,
  "Zok pruegelt wie irr auf Dich ein.\n",
  "Zok pruegelt wie irr auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 
  AddSpell(3,1500,
  "Zok schlaegt brutal auf Dich ein.\n",
  "Zok schlaegt brutal auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,2000,
     "Zok schlaegt Dir fast den Schadel ein.\n",
     "Zok schlaegt @WEN fast den Schaedel ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,3000,
     "Zok pruegelt die ZENSUR aus Dir raus.\n",
     "Zok pruegelt die ZENSUR aus @WEM raus.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddCmd(({"oeffne","kletter","steig","steige","lege","lieg"}), "nix", 1);
                
  
  } 

  die(arg)
       {
      object ob;
      ob=present("zak",environment(TO));
      if(ob)
      {
      ob->remove();       
     tell_room("d/gebirge/dante/room/kreuz",
     "Zok schlaegt mit einem letzen brutalen Streich auf Zak ein.\n"
     "Zok und Zak explodieren beide in einer gewaltigen Feuerwolke!\n");
     }
    ::die(arg);
    }


int nix()
   {
   write("Zak stoesst Dich brutal zu Boden!\n");
   return 1;
   }


 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_FIRE }) ))
          
                  {
                     tell_room(environment(), "Zok freut sich sehr!\n");
                           heal_self(dam/2);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

          if (sizeof(dtype & ({ DT_MAGIC }) ))
          
                  {
                     tell_room(environment(), "Zok freut sich sehr!\n");
                           heal_self(dam/2);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  
  return ::Defend(dam, dtype, spell, enemy);
         }
         