// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tzlu, die lebende Saeure");
  SetProp(P_LONG, BS(
  "Das ist Tslu, die lebende Saeure. Er besteht aus giftigen Saeuren. "
  "Wenn Du ihn nicht toeten willst, ist seine Saeure aber nicht gefaehrlich fuer Dich!"));
    

  SetProp(P_NAME, "Tzlu");
  SetProp(P_GENDER, MALE);
  AddId(({"tzlu","saeure"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(16);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Saeurehaenden",200,DT_ACID}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " loest sich einfach auf!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "schaut sauer!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll Tzlu damit?!\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,300,
    "Tzlu beruehrt Dich am Arm.\n",
    "Tzlu beruehrt @WEM am Arm.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,400,
    "Tzlu fasst in Dein Gesicht.\n",
    "Tzlu fasst in @WESSEN Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,300,
    "Tzlu beruehrt Dich am Bein.\n",
    "Tzlu beruehrt @WEM am Bein.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,500,
    "Tzlu drueckt Dich an sich.\n",
    "Tzlu drueckt @WEN an sich.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  
  
  
 // SUID;
//  CLONEME(OBJ"prune");
  
SetChats(5,({
"Tzlu sagt: Umarme mich!\n",
"Tzlu will Dich beruehren!\n",
"Tzlu sagt: Komm zu mir!\n",
"Tzlu lacht sauer!\n",
"Tzlu spritzt etwas Saeure nach Dir!\n",
"Tzlu will Dich knuddlen.\n"}));

  
  
  
  
  } 

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_ACID }) ))
          
                  {
                     tell_room(environment(), "Tzlus freut sich enorm!\n");
                           heal_self(dam);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

  
  return ::Defend(dam, dtype, spell, enemy);
         }

                        