

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Geist eines Adlers");
  SetProp(P_LONG, BS(
  "Das ist der Geist eines Adlers. Warum er hier ist, weiss keiner so genau. "
  "Angeblich aus reiner Magierwillkuer. Seine Fluegel gefallen Dir!"));  
  SetProp(P_NAME, "Geist");
  AddDetail("fluegel",
  "Die Fluegel sehen sehr interessant aus. Sie schimmern irgendwie magisch.");
  
  SetProp(P_GENDER, MALE);
  AddId( ({"adler","geist","vogel"}) );
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 80+random(20), ({DT_BLUDGEON})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist eines Adlers faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
    
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/g"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS);
  SetProp(P_MNPC_WAIT, ({1+random(5), 5, 5}));
   SetProp(P_MNPC_DEFAULTROOM, "d/gebirge/dante/room/g9");
  
  
  
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt davon");
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  AddInfo("fluegel",
  "Tja, wie geht der dumme Spruch. Nur ueber meine Leiche!", "kraechzt: ");
  AddInfo("geist",
  "Bin ich.", "sagt: ");
  AddInfo("adler",
  "War ich einmal.", "sagt: ");
  SetProp(P_NOMAGIC, 0);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 100, 
   "Der Geist eines Adlers hackt auf Dich ein.\n",
    "Der Geist eines Adlers hackt auf @WEN ein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 300, 
   "Der Geist eines Adlers will Dich zerhacken.\n",
   "Der Geist eines Adlers will @WEN zerhacken.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

SetChats(15,({   
    "Der Geist eines Adlers kraechzt.\n",
    "Der Geist eines Adlers scheint voellig durchsichtig zu sein.\n",
    "Der Geist eines Adlers flattert nervoes.\n",
    "Der Geist eines Adlers flattert herum.\n",
    "Der Geist eines Adlers schaut Dich neugierig an...\n"}));

SUID;
CLONEME("d/gebirge/dante/obj/fluegel");

}

