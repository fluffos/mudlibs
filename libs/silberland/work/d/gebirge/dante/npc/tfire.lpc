// dante@SilberLand
//tentakel fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein teuflisches Feuer");
  SetProp(P_LONG, BS(
"Das ist eines der beruehmten, aber selten gesehenen Teufelsfeuer.\n"));
   SetProp(P_NAME, "Teufelsfeuer");
  SetProp(P_GENDER, NEUTER);
  AddId(({"feuer", "teufelsfeuer", "t_fire", "tfire"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 45]));
  create_default_npc(7);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit enormer Hitze",100,DT_FIRE}));
  SetProp(P_BODY, 30);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_FIRE:0.1, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "rast herein");
  SetProp(P_MSGOUT, "rast blitzschnell");
  SetProp(P_MMSGIN, "rast herein");
  SetProp(P_MMSGOUT, "rast davon");
  
  SetProp(P_DIE_MSG,  " explodiert in einer Feuerwolke!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,150,
  "Das Teufelsfeuer umhuellt Dich!\n",
  "Das Teufelsfeuer umhuellt @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,250,
"Das Teufelsfeuer sprueht Feuerregen auf Dich!\n",
"Das Teufelsfeuer sprueht Feuerregen auf @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  } 

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_FIRE }) ))
          
                  {
                     tell_room(environment(), "Du staerkst das Teufelsfeuer nur!\n");
                           heal_self(dam/2);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

          if (sizeof(dtype & ({ DT_COLD }) ))
          
                  {
                     tell_room(environment(), "Das Teufelsfeuer wird kleiner!\n");
                                return ::Defend(2*dam, dtype, spell, enemy);
                                        }         
  
  return ::Defend(dam, dtype, spell, enemy);
         }
  
  
    reset()
    {
    ::reset();
    tell_room("d/gebirge/dante/room/altar",
    "Das Teufelsfeuer folgt seinem Herrn in die Hoelle!\n");
    remove();
    }
    
