

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wassergeist");
  SetProp(P_LONG, BS(
  "Das ist Wassergeist. Sie sind aggressiv und boese."));  
  SetProp(P_NAME, "Wassergeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "wassergeist"}) );
  
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit einem Wasserstrahl", 100+random(20), ({DT_WATER})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Wasergeist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Wasser auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
  SetProp(P_AGGRESSIVE, 1);  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
   SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/g"));
     SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS );
       SetProp(P_MNPC_WAIT, ({10+random(10), 20, 15}));
 SetProp(P_MNPC_DEFAULTROOM, "d/gebirge/dante/room/g6");
  
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 200, 
   "Der Wassergeist schiesst Dir Wasser an den Kopf.\n",
    "Der Wassergeist schiesst @WEM Wasser an den Kopf.\n",
    DT_WATER, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 300,
   "Der Wassergeist will Dich ueberfluten.\n",
    "Der Wassergeist will @WEN ueberfluten.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
    "Der Wassergeist entfacht einen Wassersturm ueber Dir.\n",
    "Der Wassergeist entfacht einen Wassersturm ueber @WEM.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]));

 SetChats(4, ({
    "Der Wassergeist schwebt nach oben...\n",
    "Der Wassergeist schwebt nach unten...\n",
    "Der Wassergeist scheint voellig durchsichtig zu sein.\n",
    "Der Wassergeist grinst Dich boese an.\n",
    "Der Wassergeist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Wassergeist sagt: Magst Du Wasser ?\n",
    "Der Wassergeist schimmert blau...\n"}));
}
