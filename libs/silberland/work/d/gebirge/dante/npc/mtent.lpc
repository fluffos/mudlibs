// dante@SilberLand
//tentakel fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein abgerissener Tentakel");
  SetProp(P_LONG, BS(
  "Diesen Tentakel hat irgendein Monster dem Organismus wohl ausgerissen. "
  "Er schnellt und zuckz herum, und greift alles an!"));
  SetProp(P_NAME, ({"ein abgerissener Tentakel",
  "eines abgerissenen Tentakel","einem abgerissenen Tentakel",
   "einen abgerissenen Tentakel"}));
  
  SetProp(P_GENDER, MALE);
  AddId(({"tentakel","abgerissener tentakel"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(5);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit giftigen Saugnaepfen",100,DT_POISON}));
  SetProp(P_BODY, 20);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0,
   DT_ACID:-1.0, DT_POISON:-1.0]));
     
  SetProp(P_MSGIN, "schnellt herein");
  SetProp(P_MSGOUT, "schnellt");
  SetProp(P_MMSGIN, "schnellt herein");
  SetProp(P_MMSGOUT, "schnellt hoch");
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/k"));
    SetProp(P_MNPC_FLAGS, MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS );
      SetProp(P_MNPC_WAIT, ({1, 15, 10}));
        SetProp(P_MNPC_DEFAULTROOM,  "/d/gebirge/dante/room/k7");
  
  
  
  
    
  SetProp(P_DIE_MSG,  " verfault blitzschnell!\n");
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  AddInfo("dante", "Dante, hmm, der war mal mein bester Gast.","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Tentakel damit?!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(3,100,
    "Der Tentakel saugt sich an Dir fest.\n",
    "Der Tentakel saugt sich an @WEM fest.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,150,
    "Der Tentakel saugt an Deinem Auge.\n",
    "Der Tentakel saugt an Deinem Auge.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));


  AddSpell(1,200,
    "Der Tentakel spritzt Dir Saeure ins Gesicht.\n",
    "Der Tentakel spritzt @WEM Saeure ins Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

  
  } 
