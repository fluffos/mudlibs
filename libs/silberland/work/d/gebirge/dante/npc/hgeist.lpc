

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Geist eines Schmiedes");
  SetProp(P_LONG, BS(
  "Das ist der Geist eines Schmiedes. Er ist alt und schwach. Als er noch "
  "lebte, war er ein grosser Betrueger. Was ihm uebel bekam. Er wurde von "
  "Vlad gekreuzigt."));
  
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({"hgeist","geist","schmied"}) );
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit einem haemmernden Angriff", 80+random(20), ({DT_BLUDGEON})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_RIP,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
    
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/g"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS);
  SetProp(P_MNPC_WAIT, ({10+random(10), 10, 10}));
   SetProp(P_MNPC_DEFAULTROOM, "d/gebirge/dante/room/g8");
  
  
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  AddInfo("geist",
  "Bin ich.", "sagt: ");
  AddInfo("vlad",
  "flucht laut.");
  AddInfo("kreuzigung",
  "Kein Vergnuegen...","sagt: ");
  
  AddInfo("kreuzigungshammer",
  "Den willst Du, so so...", "sagt: ");
  AddInfo("hammer",
  "Zja, nur ueber meine Geisterleiche!", "sagt: ");
  SetProp(P_NOMAGIC, 0);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 100, 
   "Der Geist eines Schmiedes blaest Dir Feuer ins Gesicht.\n",
    "Der Geist eines Schmiedes blaest @WEM Feuer ins Gesicht.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 200, 
    "Der Geist eines Schmiedes wirft Dich mit einer Feuerwolke fast um.\n",
    "Der Geist eines Schmiedes wirft @WEN mit einer Feuerwolke fast um.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));

SetChats(15,({   
    "Der Geist schwebt nach unten...\n",
    "Der Geist scheint voellig durchsichtig zu sein.\n",
    "Der Geist grinst Dich boese an.\n",
    "Der Geist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Geist schimmert roetlich...\n"}));

SUID;
CLONEME("d/gebirge/dante/obj/ham");

}

