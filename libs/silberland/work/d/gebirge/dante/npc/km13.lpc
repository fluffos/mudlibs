// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wuergetroll");
  SetProp(P_LONG, BS(
 "Das ist ein gewalttaetiger Wuergetroll. Was er will ist klar, Dich erwuergen!"));
 
  SetProp(P_NAME,  "Wuergetroll");
  SetProp(P_GENDER, MALE);
  AddId(({"wuergetroll","troll"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(19);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Wuergeklauen",230,DT_SQUEEZE}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Wuergtroll will Dich erwuergen!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0, DT_SQUEEZE:-1.0]));
   
  SetProp(P_HEAL,-5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "hetzt herein");
  SetProp(P_MSGOUT, "hetzt sabbernd");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
/* SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/k1"));
     SetProp(P_MNPC_FLAGS, MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS );
           SetProp(P_MNPC_WAIT, ({1, 15, 10}));
                   SetProp(P_MNPC_DEFAULTROOM,  "/d/gebirge/dante/room/k13");  
*/  
  
  SetProp(P_DIE_MSG, " erwuergt sich selbst!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "bruellt nur: Ich erwuerge Dich!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Wuergetroll damit!\n" }) );

  SetProp(P_SPELLRATE,70);
  
  AddSpell(4,400,
"Der Wuergetroll versucht Dich zu wuergen!\n",
"Der Wuergetroll versucht @WEN zu wuergen!\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,500,
 "Der Wuergetroll wuergt Dich am Hals!\n",
 "Der Wuergetroll wuergt @WEN am Hals!\n",
 
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,500,
"Der Wuergetroll geht Dir an die Kehle!\n",
"Der Wuergetroll geht @WEM an die Kehle!\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,600,
 "Der Wuergetroll drueckt Dir die Luft ab!\n",
 "Der Wuergetroll drueckt Dir die Luft ab!\n",
 
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,600,
"Der Wuergtroll will Dich zu Tode wuergen!\n",
"Der Wuergetroll will @WEN zu Tode wuergen!\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
     
 AddSpell(1,200,
"Der Wuergetroll holt zu einem Rundumwuerger aus!\n",
"Der Wuergetroll holt zu einem Rundumwuerger aus!\n",
     DT_MAGIC, "spell_all");
 
 
  
  SUID;
 CLONEME("/d/gebirge/dante/weapon/trku");
 CLONEME("/d/gebirge/speedy/trollager/weapon/trollschwert");
 CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung");
command("zieh alles an");
command("zuecke schwert");


SetAttackChats(7,({
  "Der Wuergetroll bruellt!\n",
  "Der Wuergetroll sagt: Wuergen!\n",
  "Der Wuergtroll schaut Deine Kehle an!\n",
  "Der Wuergetroll kommt naeher!\n",
  "Der Wuergetroll stinkt!\n"}));  
  } 
  
spell_all(object enemy, int damage, mixed dam_type)
   {
   int i;
   object *inv;
  inv=PresentEnemies();
       damage=random((50)+50);//hmm wie hoch????
            damage/=sizeof(inv);
     tell_room(ENV(ME), BS("Du erstickst fast!!!\n"));
           for(i=sizeof(inv)-1;i>=0;i--)   
           {
        tell_object(inv[i], "Du kannst kaum atmen!\n");
   inv[i]->Defend(damage, dam_type,
             ([SP_SHOW_DAMAGE:1,SP_NAME:"Wuergetroll"]), this_object());           
     }
  }
                   