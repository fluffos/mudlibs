// dante@SilberLand
//monster fuer katakomben
    
inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Drachentroll");
  SetProp(P_LONG, BS(
  "Dieses Wesen ist eine absurde Mischung aus einem kleinen Drachen und "
  "einem Troll. Es ist abscheulich eklig und Dir graust vor ihm!\n"));
  SetProp(P_NAME,  "Drachentroll");
  SetProp(P_GENDER, MALE);
  AddId(({"drache","drachentroll","troll"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(21);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Wuergeklauen",230,DT_SQUEEZE}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Dolch des Drachentroll ist interessant!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0, DT_BLUDGEON:-1.0]));
   
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "poltert herein");
  SetProp(P_MSGOUT, "poltert sabbernd");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
/* SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/k1"));
     SetProp(P_MNPC_FLAGS, MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS );
           SetProp(P_MNPC_WAIT, ({1, 15, 10}));
                   SetProp(P_MNPC_DEFAULTROOM,  "/d/gebirge/dante/room/k13");  
 */ 
  
  SetProp(P_DIE_MSG, " stuerzt bruellend zu Boden!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Drachentroll damit!\n" }) );

  SetProp(P_SPELLRATE,80);
  
  AddSpell(6,400,
"Der Drachentroll speit Feuer auf Dich!\n",
"Der Drachentroll speit Feuer auf @WEN!\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,500,
 "Der Drachentroll rammt Dir seinen Dolch in den Leib!\n",
 "Der Drachentroll rammt Dir seinen Dolch in den Leib!\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 
  
  AddSpell(4,500,
"Der Drachentroll sticht Dir seinen Dolch ins Gesicht!\n",
"Der Drachentroll sticht Dir seinen Dolch ins Gesicht!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,600,
 "Der Drachentroll rammt Dir seinen Dolch in Dein Herz!\n",
 "Der Drachentroll rammt Dir seinen Dolch in Dein Herz!\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
   
  AddSpell(3,500,
"Der Drachentroll umhuellt Dich mit Feuer!\n",
"Der Drachentroll umhuellt Dich mit Feuer!\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
 "Der Drachentroll sticht Dir seinen Dolch ins Auge!\n",
 "Der Drachentroll sticht Dir seinen Dolch ins Auge!\n",
     DT_RIP, "spell_blind");

  
  SUID;
 CLONEME("/d/gebirge/dante/weapon/trku");
 CLONEME("/d/gebirge/dante/weapon/trodo");
 CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung");
command("zieh alles an");
command("zuecke dolch");


SetAttackChats(7,({
  "Der Drachentroll bruellt!\n",
  "Der Drachentroll sagt: Wuergen!\n",
  "Der Drachentroll schaut Deine Kehle an!\n",
  "Der Drachentroll kommt naeher!\n",
  "Der Drachentroll stinkt!\n"}));  
  } 
  
spell_blind(object enemy, int damage, mixed dam_type)
   {
   int x;
   x=enemy->QueryProp(P_BLIND);
   
   switch(random(16))
      {
      case 0..2:
      enemy->SetProp(P_BLIND, 100+x);
      break;
      case 3..4:
      enemy->SetProp(P_BLIND, 200+x);
      break;
      case 5..6:
       enemy->SetProp(P_BLIND, 300+x);
      break;
      case 7..8:
       enemy->SetProp(P_BLIND, 500+x);
      break;
      case 9:
       enemy->SetProp(P_BLIND,-1);
      break;
      case 10..15:
      enemy->do_damage(random(10)+5);
      tell_object(enemy,
      "Du hast Glueck nicht zu erblinden!\n");
      break;
      default:write("BUG!\n");
      }
  }
                      