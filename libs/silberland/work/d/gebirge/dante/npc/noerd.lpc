//noerds geist

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


string owner;

create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Der Geist von Noerd");
  SetProp(P_LONG, BS(
   "Das ist also der Geist von Noerd, den Du solange gesucht hast, Beeindruckend "
   "sieht er ja nicht gerade aus. Klein, schwach. Aber welcher Geist, der hier "
   "eingesperrt ist ohne seine Geisterfreunde, waere schon in besserer Form. "
   "Ueberhaupt, haben Geister eine Form ? Vor allem, Noerds Geist will ja gar "
   "kein Geist mehr sein, aber wenn Du das bishier her nicht weisst, bist Du "
   "entweder doof, oder Du hast Dir von einem Magier helfen lassen..."));
    
   
   
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist","noerd","noerdsgeist"}) );
  SetProp(P_INFO, "Bring ihm endlich seine ersehne Ruhe!\n");
  create_default_npc(5);
  SetProp(P_NOATTACK, ("Du willst ihm doch nicht so seine letzte Ruhe geben.\n"));
  
  SetProp(P_HANDS, ({" mit einem heiligen Angriff", 100+random(20), ({DT_HOLY})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
 
  AddInfo(DEFAULT_INFO,({       
  "von Noerd sagt: Ich weiss nix, sorry.\n",
  "von Noerd sagt: Hmm, interessant.\n",
  "von Noerd lacht bloed.\n",
  "von Noerd sagt: UI, wie schlau!\n",
  "von Noerd meint: Nein, das glaub ich nicht.\n"}));
  
  
AddInfo("hilfe",
"Suche und bestatte meine Gebeine!", "sagt: ");

AddInfo("geist",
"Ich bin einer.\n", "sagt: ");
AddInfo("priester",
"Tja, den kenne ich nicht, war ja immer hier eingesperrt.\n", "sagt: ");
AddInfo("grab",
"Naja, Du bist in meinem. Ich will hier meine letze Ruhe haben.\n", "sagt: ");
AddInfo("friedhof",
"Der Friedhof ist ueber uns.\n", "sagt: ");
AddInfo("noerd",
"Tja, das bin ich. Der Geist von Noerd sozusagen.\n");
AddInfo("totengraeber",
"Als ich noch lebte, kannte ich ihn.", "sagt: ");
AddInfo("ruhestaette",
 "Das hier soll meine letze Ruhestaette sein. Um mir meine Ruhe zu geben, "
 "musst Du meine Gebeine hier beisetzen oder so aehnlich...\n");
 AddInfo(({"knochen","gebeine"}),
 "Tja, meine Gebeine wurden von den boesen Monstern der Katakomben "
 "versteckt. Such sie! Vlad weiss mehr!", "sagt: ");
 AddInfo("sarg",
 "Hmm, irgendwo muss einer sein.", "sagt: ");
 AddInfo("vlad",
 "Der wohnt in den Katakomben, frag ihn aus.", "sagt: ");
 AddInfo("katakomben",
 "Huete Dich davor...", "sagt: ");
 AddInfo("ruhe",
 "Ich will meine letze Ruhe haben!", "sagt: ");
 AddInfo("tuberkulose",
 "Tja, die hatte ich einmal, du ja auch!", "grinst: ");
 AddInfo("grube",
 "Tja was weiss ich...");
 

 SetChats(4, ({
    "Der Geist von Noerd schwebt nach oben...\n",
    "Der Geist von Noerd schwebt nach unten...\n",
    "Der Geist von Noerd jammert.\n",
    "Der Geist von Noerd sagt: Kannst Du mir bitte helfen?\n",
    "Der Geist von Noerd sagt: Erloese mich!\n",
    "Der Geist von Noerd sagt: Hilf mir!\n",
    "Der Geist von Noerd ist ein Nerd.\n",
    "Der Geist von Noerd sagt: Nun loes schon die Quest, Penner!\n",
    "Der Geist von Noerd sagt: Verflucht seien die Katakomben.\n",
    "Der Geist verschwindet, taucht aber hinter Dir wieder auf.\n"}));


   call_out("weg", 600);

AddCmd(({"schuett","schuette"}), "done");





}
   
    
 
 void SetOwner(string str) {
   owner=str;
     }
     
   string QueryOwner() { return owner; }
   
     






void weg()
  {
write("Der Geist von Noerd verschwindet wieder.\n");
    remove();
    }
    

int done(string str)
  {
   object ob1, ob2, ob3, ob4, obn, obfl,obs, obq;
   ob1=deep_present("BONE1", TP);
 ob2=deep_present("BONE2", TP);
 ob3=deep_present("BONE3", TP);
 ob4=deep_present("BONE4", TP);
 obs=deep_present("gebeinsarg", (TP));
 obn=present("noerd", environment(TP));
 obfl=deep_present("hfl2", TP);
 obq=clone_object("d/gebirge/dante/obj/nseele");



 
   notify_fail("Was willst Du hier worauf schuetten!\n");
   if(str=="wasser auf sarg")
     {
     
     if((QueryOwner() != getuid(TP)) && (TP != ME))
     {
     write("Der Geist von Noerd teilt Dir mit: Du kannst mir nicht helfen!\n");
     return 1;
     }
     
     if(!present("hfl2", TP))
       {
       write("Aber Du hast keine geeignete Flasche!\n");
       return 1;
       }
       
       
       
    if (!present("BONE1", TP))
      {
      write("Aber Dir fehlt doch noch der Schaedel von Noerd.\n");
      return 1;
      }
    
       
    if (!present("BONE2", TP))
      {
      write("Aber Dir fehlen doch noch die Oberschenkelknochen von Noerd.\n");
      return 1;
      }
    
       
    if (!present("BONE3", TP))
      {
      write("Aber Dir fehlen doch noch die Oberarmknochen von Noerd.\n");
      return 1;
      }
    
       
    if (!present("BONE4", TP))
      {
      write("Aber Dir fehlen doch noch die Rippen von Noerd.\n");
      return 1;
      }
                
if(!deep_present("gebeinsarg", TP))
   {
   write("Aber Du hast dock keinen Sarg!\n");
   return 1;
   }
          
      
      
if(file_name(environment(TP))!=("/d/gebirge/dante/room/ngrab"))
   {
   write("Aber der Ort passt doch nicht!\n");
   return 1;
   }
       
   

      
   if(!present("\nhoehlenquestbydante", TP))
     {
     write("So sicher nicht!\n");
     remove();
     return 1;
     }
     
   else
   
   {
   if(ob1) ob1->remove();
   if(ob2) ob2->remove();
   if(ob3) ob3->remove();
   if (ob4) ob4->remove();
   if(obfl) obfl->remove();
   if(obs) obs->remove();
   
   write("Du schuettest etwas magisches Wasser auf den Sarg.\n"
   "Der Sarg leuchtet hell auf, die Gebeine schweben in den Sarg!!!\n"
   "Der Sarg schwebt aus Deinen Haenden in die Grube und loest sich dann "
   "vor Deinen Augen in Luft auf.\n"
   "Der Geist von Noerd dankt Dir und ist endlich erloest!\n"
   "Ein Lichtblitz erhellt den Raum und Du hoerst die Wesen der "
   "Katakomben fluchen!!!\n");
   shout(CAP_TPN+" hat Noerds Geist erloest!!!\n");
   write("Der karge Rest von Noerds Seele schwebt ober Dir und sinkt "
   "dann genau auf Dich herab!\n");
   obq->SetProp(P_INFO, "Dieser Rest gehoert "+CAP_TPN+"\n");
   obq->SetProp(P_IDS, ({"NSEELE","seele","rest","+CAP_TPN+SEELE"}));
   obq->move(TP, M_GO);
   remove();
   
   return 1;
   }
 return 0;
 }
  return 0;
  }
