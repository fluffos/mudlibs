// dante@SilberLand
//monster fuer katakomben

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Virenork");
  SetProp(P_LONG, BS(
   "Das ist ein brutaler Virenork. Er durchsetzt die Opfer mit Viren, damit "
   "sie schneller verwesen und so um so koestlicher werden."));
  SetProp(P_NAME,  "Virenork");
  SetProp(P_GENDER, MALE);
  AddId(({"ork","virenork"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(13);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen verseuchten Klauen",170,DT_ACID}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Virenork hasst Feuer und liebt Schokolade!!!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0, DT_FIRE:2.0]));
   AddInfo("schokolade",
   "Ich liebe sie!", "sagt: ");
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "krallt herein");
  SetProp(P_MSGOUT, "krallt sabbernd");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
 SetProp(P_MNPC_AREA, ("/d/gebirge/dante/room/k1"));
     SetProp(P_MNPC_FLAGS, MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS );
           SetProp(P_MNPC_WAIT, ({1, 15, 10}));
                   SetProp(P_MNPC_DEFAULTROOM,  "/d/gebirge/dante/room/k13");  
  
  
  SetProp(P_DIE_MSG, " bricht bruellend nieder!\n");
  
  
  
  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Virenork?!\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,300,
    "Der Virenork spuckt Dich an.\n",
    "Der Virenork spuckt @WEN an.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,400,
   "Der Virenork zerkratzt Dein Gesicht.\n",
   "Der Virenork zerkratzt @WESSEN Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,400,
   "Der Virenork laesst Viren auf Dich los.\n",
   "Der Virenork laesst Viren auf @WEN los.\n",
     DT_ACID,"spell_gift");
     //ich weiss geht auch ganz anders ich machs aber lieber so
     
 AddSpell(3,300,
"Der Virenork springt Dich brutal an!\n",
"Der Virenork springt @WEN brutal an!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 
 
  
  SUID;
  CLONEME("/d/gebirge/dante/obj/schokobons");
  
SetAttackChats(7,({
  "Der Virenork bruellt laut.\n",
  "Der Virenork sagt: Du ekliges GOPHBPP IH!\n",
  "Der Virenork ist so eklig...\n",
  "Viren springen herum!\n",
  "Der Virenork sagt: Du mieser G)ZBUBUH!\n"}));
  
  } 
  
spell_gift(object enemy, int damage, mixed dam_type)
   {
   object ob;
   ob=clone_object("/d/gebirge/dante/obj/orkv");
   switch(random(10))
     {
     case 0 ..1:
     tell_object(enemy,
     "Die Viren verfehlen Dich! Du hast Glueck!\n");
     break;
     case 2..3:
     tell_object(enemy,
    "Die Viren streifen Dich ein wenig!\n");
    enemy->AddPoison(1);
    break;
    case 4..6:
     tell_object(enemy,
    "Die Viren erwischen Dich!\n");
    enemy->AddPoison(2);
    break;
    case 7..8:
     tell_object(enemy,
    "Die Viren erwischen Dich voll!\n");
    enemy->AddPoison(3);
    break;
    case 9:
    tell_object(enemy,
    "Du geraetst in eine Virenwolke! Renne um Dein Leben!\n");
      enemy->AddPoison(5);
       break;
    default:write("Dante kann nix!\n");
    }
 }
 
  die(arg)
  {
  if(!present("orkv", TP))
  {
  write("Sterbend spuckt Dich der Virenork noch einmal an!\n");
  clone_object("/d/gebirge/dante/obj/orkv")->move(TP, M_NOCHECK);
  }
  else
  {write("Der Virenork tritt Dir sterbend in den Unterleib!\n");
  //boeser ork:)
  
  TP->do_damage(10);
  }
  
  ::die(arg);
  }
                