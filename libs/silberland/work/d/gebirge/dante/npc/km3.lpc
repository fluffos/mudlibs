// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Vlad, der Pfaehler");
  SetProp(P_LONG, BS(
  "Das ist Vlad, der Pfaehler. Seine Aufgabe ist es die Opfer an die Kreuze zu "
  "schlagen. Sonst ist er aber sehr liebenswert!!!"));
  

  SetProp(P_NAME, "Vlad");
  SetProp(P_GENDER, MALE);
  AddId(({"vlad","pfaehler"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(30);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen eiskalten Haenden",200,DT_TERROR}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Vlad will Dich pfaehlen!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
AddInfo(({"naegel","nagel"}),
"Hmmm, ja koennte ich gebrauchen!", "sagt: ");   
AddInfo("kreuzigen",
"Hmm macht Spass, muss man aber lernen!", "sagt: ");
AddInfo("zok",
"Zok ist einer meiner schwachsinnigen Gehilfen. Er und sein Bruder "
"Zak koennen nichts, naja kreuzigen. Die beiden koennen sich nicht leiden. "
"Streiten die ganze Zeit. Eines Tages werde ich sie mir mal vornehmen. "
"Macht Spass sie gegeneinander auszuspielen, gibt immer eine "
"praechtige Pruegelei. Sag Zak doch einfach, dass Zok sagt, er sei ein "
"Feigling. syntax: <luege zak zok sagt du bist feig>", "sagt: ");
AddInfo("zak",
"Zak, der Bruder von Zok. Die beiden sind meine Gehilfen, extrem doof. "
"Pruegeln sich die ganze Zeit." , "lacht: ");
AddInfo(({"gehilfen", "gehilfe"}),
"Die beiden Idioten Zok und Zak?!", "grinst: ");
  
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " bruellt noch einmal auf!\n");
  
  AddInfo("totengraber",
  "Der alte Emil, den krieg ich auch noch!", "lacht: ");
  AddInfo("katakomben",
  "Tja, mein, unser Reich!", "grinst: ");
  AddInfo("hilfe",
  "tja, kann ich Dir geben", "lacht: ");
  AddInfo("noerd",
  "Hmm, Noerd hatte wohl etwas Pech, wir haben seinen Geist "
  "verflucht. Du kannst ihm aber helfen. Zuerst musst Du aber mir helfen. "
  "Ich brauch dringend einen speziellen Naegel, um ein paar Leute zu "
  "kreuzigen. Brings sie mir, und ich helfe Dir. Die restlichen "
  "Naegel solltest Du aber behalten!", "sagt: ");
  
    AddInfo("emil",
    "Der alte Emil. Tja, er spricht in Raetsel, aber hier ein kleiner "
    "Tip: In Emils Sprache wuerde meine Name zum Beispiel Vwelerahjd "
    "lauten", "sagt: ");
    AddInfo("totengraeber",
    "Du meinst den altem Emil.", "sagt: ");
    
  
  AddInfo(DEFAULT_INFO,({
  "sagt: Hmm, sterben ist schoener!\n",
  "lacht ueber Dich!\n",
  "sagt: Nein, sicher nicht!\n",
  "sagt: Dante war sehr faul, ich weiss kaum etwas.\n",
  "droht Dir mit seinem Pfahl.\n"}));
   
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll Vlad damit?!\n" }) );

  SetProp(P_SPELLRATE,70);
  
  AddSpell(3,400,
    "Vlad rammt seinen Pfahl in Dich.\n",
    "Vlad rammt seinen Pfahl in @WEM.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,500,
    "Vlad bohrt seinen Pfahl in Deinen Leib.\n",
    "Vlad bohrt seinen Pfahl in @WESSEN Leib.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

AddInfo("vlad",
"Das bin ich Du Depp!","sagt: ");
AddInfo("pfahl",
"Den werde ich Dir ins Herz rammen!", "sagt: ");
AddInfo("katakomben",
"Hier ist erst der Beginn der Katakomben. Dreh lieber um!"
"Dante hat sie gemacht und Du solltest wissen, dass er "
"Spieler, Seher und auch andere Magier gerne krepieren sieht!","sagt: ");

SetChats(9,({
"Vlad zeigt Dir seinen Pfahl.\n",
"Vlad sagt: Geh lieber wieder ans Tageslicht!\n",
"Vlad grinst Dich eiskalt an.\n",
"Vlad lacht ueber Deine Ausruestung.\n",
"Vlad murmelt eine seltsame Formel.\n",
"Vlad spitzt seinen Pfahl zu.\n",
"Vlad sagt: Verschwinde von hier!\n",
"Vlad sagt: Stop! Hier ist es zu brutal fuer Dich!\n"}));
  
  SUID;
  CLONEME("/d/gebirge/dante/weapon/pfahl");
  command("zuecke pfahl");
  
  
  AddSpell(1,700,
    "Vlad sagt: TuiZT ZreKT zu Dir.\n",
    "Vlad sagt zu @WEM TuiZT ZreKT.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,650,
    "Vlad ruft die Kaelte des Todes.\n",
    "Vlad legt die Kaelte des Todes auf @WEN.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,800,
    "Vlad vereist Dein Herz.\n",
    "Vlad vereist @WESSEN Herz.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Kalte Luft stroemt auf Dich zu.\n",
    "Kalte Luft stroemt auf @WEN zu.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));


  
  } 

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_COLD }) ))
          
                  {
                     tell_room(environment(), "Vlad sagt: Danke!\n");
                           heal_self(dam);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

  
  return ::Defend(dam, dtype, spell, enemy);
         }


   init()
   {
   ::init();
   if(interactive(TP))
   
       {
       call_out("hallo", 0);
       
       }
    }
    
    
    void hallo()
      {
       if (getuid(this_player())=="dante")  
         {
         say("Vlad sagt: Dante, mein Schoepfer! Du hast mir neue Opfer\n"
         "Vlad sagt: versprochen, mir wird fad! Los fang ein paar ein!\n");
         return ;
         }
         
          if (getuid(this_player())=="angrox")
     {
     say("Vlad sagt: Angrox, ich hoffe, Dante hat nicht wieder zu viele\n"
     "Vlad sagt: Bugs fabriziert. Ich glaube irgendwie hat er die Ueber-\n"
     "Vlad sagt: sicht verloren. Naja. viel Spass beim Testen!\n");
     return;
     }
     
      if (getuid(this_player())=="muaddib")
      
      {
      say("Vlad sagt: UI, Muaddib, alter Moechtegernhobbit und Spielkind.\n"
      "Vlad sagt: Schoenen Gruss von Dante und verzerifel nicht beim testen.\n");
      return ;
      }
      
               
         
   else
   {  write("Vlad sagt: "+CAP_TPN+", wollkommen in den Katakomben!\n"
       "Vlad sagt: Willst Du gleich sterben oder etwas spaeter!\n");
       }
  }




  
      void give_notify(object ob)
              {
                               if( (ob->id("NAGEL") ) )
                               {
                               
             write("Vlad, grinst und sagt: Fein, die kann ich gut "
             "gebrauchen.\n"
             "Dann zeigt er mit Deinem Pfahl auf Dich und "
             "Dir wird schwarz vor Augen.\n");
             ob->remove();
             TP->move("d/gebirge/dante/room/wesenr", M_GO+M_SILENT);
             return;
             }
             ::give_notify(ob);
                             }


  catch_tell(string str)   
   {
        string dum1,dum2,dum3;
                if(sscanf(str,"%s teilt Dir mit: %s",dum1,dum2))
                        {
             call_out("back",2,dum1,dum2);
                 }
        }
   
   back(string dum1,string dum2)       
  {  
     string dum3;
             object ob;
     dum3=explode(dum1," ");
       dum3=dum3[sizeof(dum3)-1];
     ob=find_player(lower_case(dum3));
    if(strstr(dum2,"Hilf mir")!=-1||strstr(dum2,"hilf mir")!=-1|| 
     strstr(dum2,"Hilfe")!=-1 || strstr(dum2,"hilfe")!=-1)        
      {
   tell_object(ob,
    "Vlad teilt Dir mit: Ich helfe dir gern, aber ich will 1 Information "
    "von Dir haben!!! In welcher Gilde war Noerd!\n");return 1;
    }



    
    if( strstr(dum2, "idiot")!=-1||strstr(dum2, "Idiot")!=-1||
    strstr(dum2, "Idiotengilde")!=-1||strstr(dum2, "idiotengilde")!=-1)
   {  
   
   if(file_name(environment(ob))==("/d/gebirge/dante/room/kiraum"))
   {
tell_object(ob,
"Vlad teilt Dir mit: Stimmt! Ich komme!\n");
call_other("/d/gebirge/dante/room/kiraum.lpc", "getout", ob);  
return 1;
  }
  else
  {
  tell_object(ob,
  "Vlad teilt Dir mit: Denkst Du ich bin so bloed und fall darauf rein!\n\n"
  "Darauf siehst Du einen Pfahl durch die Luft rasen, der Sekunden spaeter\n"
  "mit voller Wucht in Deinen Bauch rast!!!\n");
  TP->do_damage(50);
  return 1;
  }
return 0;
}
  
  
    else
    {
    
    switch(random(6))
     {
     case 0:
    tell_object(ob,
    "Vlad teilt Dir mit: Stehl mir meine Zeit nicht!\n");
   break;
     case 1:
     tell_object(ob,
     "Vlad teilt Dir mit: Frag nicht so dumm!\n");
     break;
     case 2:
     tell_object(ob,
     "Vlad teilt Dir mit: Ein Pfahl im Herz freut auch ungemein!\n");
     break;
     case 3:
     tell_object(ob,
     "Vlad teilt Dir mit: Dante, wollte dass ich so dummes Zeug rede.\n");
     break;
     case 4:
     tell_object(ob,
     "Vlad teilt Dir mit: Noch so was und Du stirbst!\n");
     break;
     case 5:
     tell_object(ob,
     "Vlad teilt Dir mit: Moment bitte, muss gerade jemand pfaehlen!\n");
     break;
     default:tell_object(ob,
     "Vlad sagt: BUG!\n");
     }
     return 1;
     }
     
   
   }
   
   
   
   
   
   
