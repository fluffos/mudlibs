//gimliys messer schneidet ohren ab..dann taub....
//dante

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>
#include <moving.h>

#define TIME 60
#define ALLOWED 5

int hits=0;

reset()  {
	::reset();
	hits=0;
  }	

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Rasiermesser");
SetProp (P_GENDER, NEUTER);
SP(P_NAME_ADJ, "scharf");
SetProp (P_VALUE, 1000+random(100));
SetProp (P_WEIGHT, 100);
SetProp(P_SIZE, 15);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieses Rasiermesser hat eine aeusserst scharfe Klinge aus Stahl und einen "
"wunderschoenen, verzierten Griff aus Perlmutt. Man kann mit ihm anderen "
"Spielern die Ohren abschneiden. syntax: schneid(e) wem ohren ab"));
AD("klinge",
"Sie blitzt Dich direkt an.");
AD("stahl",
"Hart und erbarmungslos.");
AD(({"griff"}),
"Der Griff besteht aus Perlmutt und Du siehst eine schoene Gravur.");
AD("perlmutt",
"Es glaenzt herrlich.");
AD("gravur",
"Da steht:\n"
"Dieses Messer gehoert GIMLIY!\n");

AddId(({"rasiermesser","messer"}));

SP(P_SHORT, "Ein sehr scharfes Rasiermesser");

SetProp (P_DAM_TYPE, ({ DT_RIP}));
SetProp (P_WC, 100);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:70, MAT_PEARL:30]));

ACD(({"schneid","schneide"}), "cut_ears");
}

int cut_ears(string str)  {
	object ob, get;
	string vic;
	NF("Wem willst Du die Ohren abschneiden?!\n");
if(!str)  { return 0;  }

 if(sscanf(str, "%s ohren ab", vic))
      {
     
      if(!ob=present(vic,environment(TP)))
        {
        write(CAP(vic)+" ist doch nicht hier!\n");
        return 1;
        }
     
      if (!interactive(ob))
        {
        write("Nein! Das geht leider nicht!\n");
        
        return 1;
       }

if(!QueryWielded() )  {
	write(BS(
	"Zuecken waere gut..."));
	return 1;  }
	


if(IS_WIZARD(ob) )  {
	write("Nein! "+(capitalize(vic))+" ist leider zu magisch!\n");
        tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
        return 1;
  }

if(ob->QP(P_GHOST) )  {
	write("Nein! "+(capitalize(vic))+" ist leider ein Geist!\n");
        tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
        return 1;
  }


if(ob->QueryGuest() )  {
	write("Nein! "+(capitalize(vic))+" ist doch ein Gast!\n");
        tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
        return 1;
  }

if(ob->QP(P_FROG) )  {
	write("Nein! "+(capitalize(vic))+" ist leider ein Frosch!\n");
        tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
        return 1;
  }


if(ob->QP(P_GHOST) )  {
	write("Nein! "+(capitalize(vic))+" ist ein Gast!\n");
        return 1;
  tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
  }


if(ob->QP(P_DEAF) )  {
        	tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
        write("Nein! "+(capitalize(vic))+" ist schon taub!\n");
        return 1;
        }
	
if(hits > ALLOWED )   {
	tell_object(ob,
CAP_TPN+" wollte Dir die Ohren abschneiden, hat es aber nicht geschafft.\n");
	write(BS(
	"Du hast schon zu vielen Opfern die Ohren abgetrennt. Warte ein wenig!"));
	return 1;  }

if(getuid(TP)==getuid(ob) )  {
	write(BS(
	"Nein, so doof bist nicht einmal DU!"));
	return 1;
}

		
	   else

        {
        
        get=clone_object("/d/gebirge/dante/friedhof/obj/rohren");
        get->set_opfer(getuid(ob), getuid(TP));
        get->move(environment(ob), M_NOCHECK);
       
       
       
        
ob->SP(P_DEAF, ([
DEAF_TIME: TIME,
DEAF_MSG: "%s hat momentan keine Ohren. "+CAP_TPN+" hat sie abgeschnitten!\n",
 DEAF_END_MSG: "Deine Ohren wachsen auf einmal von alleine nach.\n"]));
        
        
                   
        write(BS(
        "Blitzschnell schneidest Du mit zwei geschickten Schnitten die Ohren von" 
             " "+(capitalize(vic))+" ab! "+(capitalize(vic))+" erschrickt furchtbar und schaut "
             "Dich dann mit schmerzverzzerrtem Gesicht an."));

ob->reduce_hit_point(5);

tell_object(ob, BS(
"Ploetzlich blitzt ein sehr scharfes Messer vor Dir auf und Du kannst gerade noch erkennen, "
"wie "+TPN+" mit zwei geschickten Schnitten Dir die Ohren abtrennt und dann boese grinst."));


tell_room(environment(TP), BS(
"Ploetzlich blitzt ein sehr scharfes Messer vor "+(capitalize(vic))+" auf und Du kannst gerade noch erkennen, "
"wie "+TPN+" "+(capitalize(vic))+" mit zwei geschickten Schnitten die Ohren abtrennt und dann boese grinst."
" " +(capitalize(vic))+" erschrickt furchtbar und schaut "
             "Dich dann mit schmerzverzzerrtem Gesicht an."), ({TP, ob}));
             
             
hits++;
        return 1;
        }

      }
    }


