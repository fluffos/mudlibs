//dante sl 

inherit "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

#include <language.h>
#include "../global.h"     
#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Schwarze, erregende Seidenstrapse");
  SetProp(P_LONG,
  "Diese Seidenstrapse gehoerten einst Lola, der kessesten Barfrau dieser "
  "Welt. Ihr standen sie unglaublich gut, was man von Dir nicht unbedingt "
  "behaupten kann. Deine Beine sind wohl etwas zu fett dafuer...");
  SetProp(P_NAME, "Seidenstrapse");
  AddId(({"seidenstrapse","strapse"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,100);
  SetProp(P_VALUE,300);
  SetProp(P_AC, 2);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, ({"schwarz","erregend"}));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp("underwear_type", "Struempfe");
}
