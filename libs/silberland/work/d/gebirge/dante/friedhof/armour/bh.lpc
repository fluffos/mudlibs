//dante sl 99

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "../global.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"bh","buestenhalter","wonderbra","bra"}));
  SetProp (P_SHORT, "Lolas geiler Wonderbra");
  SetProp (P_LONG, BS("Dieser Buestenhalter ist kein gewoehnlicher BH, er ist "
  "ein Wonderbra der Marke Supermelon! Der Traum jeder Frau!"));
  SetProp (P_NAME, "Wonderbra");
  SP(P_NAME_ADJ, "geil");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 400);;
  SetProp (P_MATERIAL, MAT_CLOTH);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 4);
   SetProp (P_MATERIAL, ([MAT_SILK:100]));
}
