//higheels von lola
//dante

inherit "std/armour";
#include "../global.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"highheels","high", "heels"}));
  SetProp(P_SHORT, "Ein Paar supergeile, rote Highheels");
  SetProp(P_LONG, "Diese Stiefel gehoerten einst der scharfen Lola. Sie sah "
  "umwerfend darin aus.");
  SetProp(P_NAME, "Paar Highheels");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 400);
  SetProp(P_NAME_ADJ, ({"supergeil","rot"}));
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 3);
  SetProp(P_EFFECTIVE_WC, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}
