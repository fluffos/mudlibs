//wuschel dante sl 
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"bergstiefel", "stiefel","paar"}));
  SetProp (P_SHORT, "Ein Paar robuster Bergstiefel");
  SetProp (P_LONG, (BS ("Die Bergstiefel sind aus Leder und "
			"sehr gut verarbeitet. Sie haben eine "
			"dicke Sohle und stuetzen die Fuesse sicher "
			"sehr gut ab, wenn man mal einen Berg "
			"besteigen moechte.\n")));
  SetProp (P_NAME,"das Paar Bergstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 1500);
  SetProp (P_NOBUY, 0);
  SetProp (P_ARTICLE, 0);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
 SP(P_AC, 4);
  AddDetail("leder",
	    BS(
	       "Echtes Leder! Die Stiefel waren sicher nicht billig.\n"));
  AddDetail("sohle",
	    BS(
	       "Die Sohle ist richtig schoen dick - da kann einem so "
	       "schnell kein Stein etwas anhaben.\n"));
}
