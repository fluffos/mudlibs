//dante sl

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"magnetguertel", "guertel"}));
  SetProp (P_SHORT, "ein Magnetguertel");
  SetProp (P_LONG, (BS ("An diesem Lederguertel sind kleine Taschen "
			"befestigt, in denen sich zahlreiche Magneten "
			"befinden. Deswegen ist der Guertel auch so "
			"schwer. Wahrlich ein originelles Accessoire "
			"fuer Modebewusste.\n")));
  SetProp (P_NAME,("Magnetguertel"));
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_VALUE, 1500);
  SetProp (P_NOBUY, 0);
  SetProp (P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
SP(P_MATERIAL, ([MAT_IRON: 100]));
  AddDetail(({"magneten", "magnet"}),
	    BS(
	       "Die sind ziemlich schwer und in kleinen Taschen "
	       "an dem Guertel befestigt.\n"));
  AddDetail(({"taschen", "tasche"}),
	    BS(
	       "In den Taschen, die an dem Guertel befestigt sind, "
	       "befinden sich Magneten.\n"));
  AddDetail("accessoire",
	    BS(
	       "Modischer Schnickschnack.\n"));
}
