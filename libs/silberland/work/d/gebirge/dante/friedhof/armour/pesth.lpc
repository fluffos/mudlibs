/*
** pesthandschuhe fuer meinen daemon
** dante 97-2001
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe","pestdaemonhandschuhe", "daemonenhandschuhe"}));
  SetProp(P_SHORT, "Ein Paar Pestdaemonhandschuhe");
  SetProp(P_LONG, "Diese Handschuhe gehoerten einst einem maechtigen "
      "Pestdaemon. Er trug sie selbst als Schutz vor seiner toedlichen Krankheit.");
  SetProp(P_NAME, "Pestdaemonhandschuhe");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, MALE);

  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2900+random(300));
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);  
  SetProp(P_AC, 8+random(2));
  SetProp(P_MATERIAL, ([MAT_MISC_POISON:50, MAT_LEATHER:30, MAT_MISC_MAGIC:20]));
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:2 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:17]) );
  SetProp(P_NOBUY, 1);
}

