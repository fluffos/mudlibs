//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#define PlayerGender this_player()->QueryProp(P_GENDER)
#include <moving.h>

int tor_auf=0;
int da=1;

#define WARNED (member(warned, getuid(this_player()))!=-1)

string *warned=({});



create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein schauriger Platz" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );


  SetProp (P_INT_LONG, "\t"+BS(
        "Du stehst auf einem kleinen Platz, der von riesigen Eichen "
        "umgeben ist. Die Atmosphaere ist duester, es riecht modrig. "
        "Der Pfad scheint sich hier aufzugabeln. Im Norden kannst Du "
        "ein kleines Haus erkennen. "
        "Eine kleine, seitlich gelegene Treppe fuehrt nach unten in eine Gruft. "
        "Durch die Nebelschwaden kannst Du "
        "einen Zaun erkennen, direkt vor Dir siehst Du ein grosses, "
        "schmiedeeisernes Tor.")+"@@tor@@");


  AD("gruft",
      "Die Gruft ist von hier nicht zu sehen. Es handelt sich um Gimliys Gruft.");
  AD("treppe",
      "Eine schmale Treppe fuehrt durch ein Loch im Boden nach unten.");
  AD("loch",
      "Es sieht nicht sehr einladend aus.");
  AD("gimliy",
      "Liegt er da unten begraben?!");



  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail("platz",
      BS(
        "Der Platz ist rund und umgeben von riesigen Eichen.\n"));
  AddDetail(({"eichen", "eiche"}),
      BS(
        "Die Eichen wirken ausladend und bedrohlich. So grosse "
        "Baeume hast Du wirklich noch nie gesehen.\n"));
  AddDetail(({"baum", "baeume"}),
      BS(
        "Es handelt sich hierbei um Eichen.\n"));
  AddDetail("atmosphaere",
      BS(
        "Brrrrr, Du schuettelst Dich, weil es hier so unheimlich ist.\n"));
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
      BS(
        "Die Nebelschwaden nehmen Dir die Sicht.\n"));
  AddDetail("sicht",
      BS(
        "Du kannst wegen der Nebelschwaden nicht weit sehen.\n"));
  AddDetail("zaun",
      BS(
        "Der Zaun ist, wie das Tor, aus Eisen und ziemlich hoch.\n"));
  AddDetail(({"eisen", "schmiedeeisen"}),
      BS(
        "Das Eisen wirkt sehr stabil.\n"));

  /*  AddDetail("tor",
      BS(
      "Das Tor haengt schief in den Angeln.\n"));

*/

  AddDetail(({"angeln", "angel"}),
      BS(
        "Daran ist das Tor befestigt.\n"));
  AddDetail("himmel",
      BS(
        "Den Himmel kannst Du vor lauter Nebelschwaden "
        "nicht sehen.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSound(DEFAULT_SOUND,
      "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht irgendwie modrig.\n");
  AddDetail("moos",
      BS (
        "Dunkelgruenes Moos hat den Pfad ueberwachsen. "
        "Es wuchert hier wild. Viel mehr als sonst. Vielleicht "
        "sollte man darin einmal wuehlen."));

  AddDetail("pfad",
      "Der Pfad scheint nach Westen, Norden und Sueden zu fuehren.");
  AD("westen",
      "Da kommst Du her.");
  AD("norden",
      "Im Norden ist das Haus von Humfrey.");
  AD("haus",
      "Es ist nicht allzu gross. Es gehoert Humfrey. Besuch ihn doch einmal.");
  AD("humfrey",
      "Er ist Magier, ein ganz spezieller Magier.");
  AD("magier",
      "Nein, kein Magier wie die anderen Magier...");

  AD("sueden",
      "Im Sueden liegt das Tor.");


  AddCmd(({"oeffne","oeffnen"}), "oeffne_tor");
  AddCmd(({"schliesse","schliessen","schliess"}), "schliesse_tor");

  AE("norden", "./arbeit");
  AIT(FO"kuerbis", REFRESH_REMOVE);
  ACD(({"wuehle","wuehl","wuehlen"}), "get_schlegel");

  AIT(FN"blockd", REFRESH_DESTRUCT);

  AddExit( "westen", "./pfad2");

  /*
     AddGuardedExit("unten", "/d/gebirge/dante/friedhof/room/gigrab",
     "stahlblock", "Du kommst an dem Stahlblock nicht vorbei!\n");
     */

  ASE("unten", "check_unten");
  ASD("tor","tor");
  AIT("/d/gebirge/dante/gruft/npc/vwolf", REFRESH_DESTRUCT);
}

int check_unten()  {

  if(present("stahlblock", TO))  {
    write(BS(
          "Du kommst an dem Stahlblock nicht vorbei!"));
    return 1;  }

    if(!WARNED)   {
      write(BS(
            "ACHTUNG! Dort unten kann es sehr gefaehrlich werden und fuer das "
            "Abenteuer 'Die verlorene Seele' musst Du dort auch nicht hinunter!!!"));
      warned+=({getuid(TP)});
      return 1;	
    }


    if(WARNED)   {
      TPM("/d/gebirge/dante/friedhof/room/gigrab", M_GO,
          "mutig nach unten", "geht", "kommt von oben herab");
      return 1;  }	

}


string tor()
{
  if (tor_auf==0)
    return "Es ist geschlossen und haengt schief in den Angeln.\n";
  else
    return "Es ist geoeffnet und haengt schief in den Angeln.\n";
}







int get_schlegel(string str)  
{
  object ob;
  NF("Wo willst Du wuehlen?!\n");
  if(str=="moos"||str=="in moos"||str=="im moos")  {
    write(BS("Du wuehlst im Moos."));
    say(BS(CAP_TPN+" wuehlt im Moos."));
    if(!da)  {
      write(BS("Leider ist da nichts."));
      return 1; 
    }
    if(da)  {
      write(BS("Du findest einen Schlegel darin! Nimm ihn doch!"));
      ob=CLONEOB(FO"schlegel");
      ob->move(TO, M_NOCHECK);
      da--;
      return 1;
    }
    return 0;
  }
}

oeffne_tor(string str)

{
  int result;
  result = 0;
  notify_fail ("Was willst Du oeffnen?\n");
  if (str && str=="tor")
  {
    if (tor_auf==0)
    {

      write (BS ("Du ziehst mit all Deiner Kraft an dem Eisentor. "
            "Mit einem quietschenden Geraeusch geht es einen "
            "spaltbreit auf.\n"));
      say (BS (TPN+ " zieht mit all "
            + (PlayerGender == FEMALE ? "ihrer" : "seiner") + 
            " Kraft an dem Eisentor. Mit einem quietschenden "
            "Geraeusch geht es einen spaltbreit auf.\n"));
      tor_auf=1;
      AddExit( "sueden", "./soldfried");

    }
    else
      write (BS ("Das Tor ist doch schon offen.\n"));
    result=1;
  }
  return result;
}

schliesse_tor(string str)

{
  int result;
  result = 0;
  notify_fail ("Was willst Du schliessen?\n");
  if (str && str=="tor")
  {
    if (tor_auf)
    {
      write (BS ("Du ziehst mit all Deiner Kraft an dem Eisentor. "
            "Mit einem quietschenden Geraeusch schliesst "
            "es sich.\n"));
      say (BS (TPN+ " zieht mit all "
            + (PlayerGender == FEMALE ? "ihrer" : "seiner") + 
            " Kraft an dem Eisentor. Mit einem quietschenden "
            "Geraeusch schliesst es sich.\n"));
      tor_auf=0;
      RemoveExit( "sueden", "./soldfried");

    }
    else
      write (BS ("Das Tor ist doch schon geschlossen.\n"));
    result=1;
  }
  return result;
}

reset()  {
  ::reset();
  tor_auf=0;	 
  say(BS("Ein kraeftiger Windstoss laesst das Tor erzittern.\n"));
  RemoveExit("sueden", "./soldfried");
  da=1;
}










