//das haus des babydrachens


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Hoehle eines Babydrachens" );
  SetProp( P_INT_LONG, BS(
"Du bist nun in einer kleinen, aber gemuetlichen Hoehle eines Babydrachens. "
"Die Waende sind aus groben Stein und der Boden ist ueber und ueber mit weichem "
"gemuetlichen Moos bedeckt. Babydrachen haben es naemlich gerne bequem wenn sie "
"schlafen. Im Sueden kannst Du die Hoehle wieder verlassen."));


AD("hoehle",
"Die Hoehle ist klein und mit Moos ausgepolstert.");
AD("moos",
"Das Moos ist weich und gruen.");
AD(({"drache","babydrache","drachen"}),
"Babydrachen sind suesse kleine Drachen.");
AD("boden",
"Der Boden ist mit gruenem Moos ausgelegt.");
AD(({"wand","waende"}),
"Die Waende bestehen aus Stein.");
AD("stein",
"Kalter und ungemuetlicher Stein.");
AD("decke",
"Die Decke besteht auch aus Stein.");
AD("sueden",
"Da kann man wieder hinaus gehen.");







  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nichts.");
  AddSmell( DEFAULT_SMELL,
  "Hmm, es riecht nach Drachen.");
  AddSmell(({"drache","drachen"}),
  "Hmm, naja wie eben Drachen so riechen.");
  
  AIT("d/gebirge/dante/friedhof/npc/babydrache", REFRESH_DESTRUCT,
   ([P_MNPC_FLAGS: 0]));
   
  
    
AE("sueden", "./pfad1");

}

       		
