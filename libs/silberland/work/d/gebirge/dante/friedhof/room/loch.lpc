//dante sl 99
inherit "std/room";

#include <properties.h>

#include <moving.h>
#include "global.h"
#include <player.h>
#include <mnpc.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein Loch");
  SetProp( P_INT_LONG,BS( 
"Du stehst in einem tiefen, rechteckigen Loch. "
"Es riecht nach Erde und ist ziemlich dunkel. "
"Wenigstens gibt es hier keine Nebelschwaden. "
"Trotzdem fuehlst Du Dich hier nicht allzu wohl, denn aus "
"der Tiefe dringt eine boese Aura."));

AD("tiefe",
"Es geht noch weiter nach unten.");
AD("aura",
"Angsteinfloessend und boese druchdringt sie Dich.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );  
  AddDetail( ({ "decke" }), 
    "Gibt es nicht. Wie auch." );
  AddDetail("loch",
	    BS(
	       "Eigentlich gibt es hier nicht viel zu sehen. "
	       "Trotzdem untersuchst Du das Loch ganz genau - "
	       "und tatsaechlich, Du siehst eine kleine Mulde. "
	       "Das Loch fuehrt nach unten."));
  AddDetail("mulde",
	    BS(
	       "Hmmm, was sich dort wohl verbergen mag? Du koenntest mal "
	       "versuchen, darin zu graben.\n"));
  AddDetail("erde",
	    BS(
	       "Sie umgibt Dich ueberall.\n"));
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
	    BS(
	       "Die gibt es hier gluecklicherweise nicht.\n"));
  AddDetail("himmel",
	    BS(
	       "Du bist zu tief unten, um den Himmel erkennen zu "
	       "koennen.\n"));
  AddDetail("boden",
	    BS(
	       "Du stehst auf lockerer Erde. Ein Loch fuehrt in die Tiefe.\n"));
	       
  AddSound(DEFAULT_SOUND,
	   "Es ist unheimlich still.\n");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht nach Erde und ist kuehl.\n");
AD("luft",
"Stickig und schwuel...");
AD(({"wand","waende"}),
"Die Waende bestehen ebenfalls aus Erde.");
  
  AddCmd(({"grabe","grab","graben"}), "get_f1");
AE("unten", "/d/gebirge/dante/gruft/room/drachenloch");


AIT("/d/gebirge/dante/gruft/npc/vrat", REFRESH_DESTRUCT, 
([P_MNPC_FLAGS: MOV_MOVES]));


//AIT("/d/unterwelt/dante/skel/skel", REFRESH_DESTRUCT,
//([P_MNPC_FLAGS: MOV_MOVES]));
 
 
  AddExit("oben", "./grab");
}


		
init()  {
	::init();
if(interactive(TP)) {call_out("tag", 5); }}

tag()  {
	if(TO!=environment(TP)) return ;
	write(BSA(
	"Weiter unten sind sicher keine Flaschen mehr. Du "
	"musst also nicht weiter runter gehen, wenn Du die "
	"Flaschen suchst!",
"Humfrey teilt Dir mit: "));	
}


int get_f1(string str)  {
	object ob;
	NF("Wo willst Du graben?!\n");
if(!str) return 0; 
if(str=="mulde"||str=="in mulde")  {
	if(!deep_present("H_BOX", TP))  {
write(BS(
"Du graebst in der Mulde, gibst aber wieder auf."));
return 1; }

if(deep_present("BlauF", TP))  {
	write(BS(
"Du graebst in der Mulde, gibst aber wieder auf."));


return 1; }
	
	else  {
ob=CLONEOB(FO"f1");
ob->move(TP, M_NOCHECK);
write(BS(
"Du graebst in der Mulde und findest eine Flasche."));
return 1; }
return 0; }
return 0; }
	