//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
#include <player.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Ein Friedhof");
  SetProp(P_INT_LONG, BS(
"Du stolperst ueber eine Wurzel und drohst "
"umzufallen. Zum Glueck kannst Du Dich im letzten "
"Moment noch an einem grossen, steinernen Gebilde "
"festhalten. Hier wirkt der Friedhof sehr merkwuerdig und "
"ist total mit Nebelschwaden verhuellt. Durch ein schmiedeeisernes Tor im Osten kannst "
"du den Vorgarten einer gruseligen Villa betreten."));




  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  AddDetail("wurzel",
	    BS(
	       "Diese Wurzel haette Dich fast zum Fallen gebracht.\n"));

	AddDetail( ({ "tor"}),
	"Das schmiedeeiserne Tor ist alt und verrostet. Es ist mit gruseligen Verzierungen versehen, "
	"die perfekt zum duesteren Ambiente passen."
	);

	AddDetail( ({ "vorgarten" }),
	"Der Vorgarten erstreckt sich mysterioes vor dir. Er wirkt vernachlaessigt und von Nebelschwaden umhuellt. "
	"Einige verkrueppelte Buesche und modriges Gras deuten darauf hin, dass er schon laenger nicht mehr gepflegt wurde."
	);

	AddDetail( ({ "villa" }),
	"Die gruselige Villa erhebt sich finster im Hintergrund. Sie scheint aus einer anderen Zeit zu stammen und "
	"verleiht der Umgebung einen unheimlichen Charme."
	);

	AddDetail( ({ "verzierungen" }),
    "Die gruseligen Verzierungen auf dem schmiedeeisernen Tor zeigen groteske Gesichter und duestere Symbole, "
    "die das morbide Ambiente verstaerken."
	);

	AddDetail( ({ "ambiente" }),
		"Das Ambiente hier ist duester und unheimlich. Die Nebelschwaden verleihen der Szenerie eine gespenstische Atmosphaere."
	);

	AddDetail( ({ "nebelschwaden" }),
		"Dichte Nebelschwaden umhuellen die Umgebung und verleihen ihr eine geheimnisvolle Aura."
	);

	AddDetail( ({ "buesche" }),
		"Die verkrueppelten Buesche im Vorgarten wirken vernachlaessigt und tragen zum gespenstischen Charme bei."
	);

	AddDetail( ({ "gras" }),
		"Das modrige Gras im Vorgarten sieht aus, als haette schon lange niemand mehr seinen Rasen gemaeht."
	);

	AddDetail( ({ "hintergrund" }),
		"Die finstere Villa im Hintergrund bildet einen duesteren Hintergrund fuer diese gespenstische Szenerie."
	);

	AddDetail( ({ "zeit" }),
		"Es ist, als ob die Zeit hier stillgestanden waere, und die Umgebung wirkt, als waere sie aus einer laengst vergangenen Zeit."
	);

	AddDetail( ({ "umgebung" }),
		"Die gespenstische Umgebung hier verstaerkt das unheimliche Ambiente und traegt zur mysterioesen Atmosphaere bei."
	);

	AddDetail( ({ "charme" }),
		"Der unheimliche Charme dieser Szenerie zieht dich in seinen Bann und weckt deine Neugier auf die gruselige Villa."
	);


AD("fallen",
"Aua!");
AD("glueck",
"Du hast sowieso Glueck, das Du hier sein darfst.");

AD("untersuchen",
"Du uebertreibst.");
AD("friedhof",
"Der Friedhof ist hier irgendwie stiller und noch seltsamer.");

  AddDetail("moment",
	    BS(
	       "Ein bisschen spaeter, und Du waerst auf Deine vier "
	       "Buchstaben gefallen!\n"));
  AddDetail(({"buchstaben", "buchstabe"}),
	    BS(
	       "Du kannst Deinen Kopf nicht so weit drehen.\n"));
  AddDetail("kopf",
	    BS(
	       "Uebertreibst Du das Untersuchen nicht ein wenig?\n"));
  AddDetail("gebilde",
	    BS(
	       "Du betrachtest das Gebilde genauestens. "
	       "Es sieht wie ein Durchgang aus, Du glaubst, Stufen "
	       "sehen zu koennen, die nach unten fuehren. Wahrscheinlich "
	       "ist das der Eingang zu einer Gruft.\n"));
AD("gruft",
"Du wirst wohl runter klettern muessen.");

  AddDetail("durchgang",
	    BS(
	       "Du koenntest ja mal runter gehen.\n"));
  AddDetail(({"stufen", "stufe"}),
	    BS(
	       "Die Stufen fuehren hinunter. Eine davon "
	       "scheint sehr locker zu sein! Sie weisst einen "
	       "grossen Riss auf. Du kannst nach unten klettern!"));
AD("riss",
"Hmm, ob man an der Stufe ruetteln kann...");
	       
  AddDetail("eingang",
	    BS(
	       "Du koenntest ja mal runter klettern.\n"));
  AddDetail("himmel",
	    BS(
	       "Den Himmel kannst Du vor lauter Nebelschwaden "
	       "nicht sehen.\n"));

AD(({"nebel","schwaden","nebelschwaden"}),
"Hier ist alles voller Nebel. Man sieht kaum etwas.");
  AddDetail("boden",
	    BS(
	       "Der Boden ist mit Moos ueberwachsen.\n"));
	       
	   AD("moos",
	"Das Moos ist hier eher braun.");       
  AddSound(DEFAULT_SOUND,
	   "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
	   "Es riecht modrig.\n");
  
  

  AddExit("norden", "./ehren");
  AddExit("osten", "/d/gebirge/gwenshara/geisterhaus/room/vorgarten");

ACD(({"kletter","klettere","klettern"}), "down");
ACD(({"ruettel", "ruettle","ruetteln"}), "get_f3");
AIT(FN"togr", REFRESH_DESTRUCT);

}


int get_f3(string str)  {
	object ob;
	NF("Was willst Du ruetteln?!\n");
if(!str) return 0; 
if(str=="an stufe"||str=="stufe")  {
	if(!deep_present("H_BOX", TP))  {
write(BS(
"Du ruettelst an der Stufe, doch nichts passiert."));
return 1; }

if(deep_present("GruenF", TP))  {
	write(BS(
"Du ruettelst an der Stufe, doch nichts passiert."));	


return 1; }
	
	else  {
ob=CLONEOB(FO"f3");
ob->move(TP, M_NOCHECK);
write(BS(
"Du ruettelst an der Stufe und ploetzlich springt eine Flasche "
"aus dem Riss!"));
return 1; }
return 0; }
return 0; }
		
			

down(string str)
{
  notify_fail("Wohin willst Du klettern?\n");

  if (str=="runter" ||str=="nach unten")  {
    
write(BS(
"Du kletterst nach unten."));
      TP->move(FR"tiefe", M_GO,"nach unten", "klettert" ,
      "kommt herab gestiegen");
      return 1;
      }
  return 0;
}



