public void special_essen() {
    object task;

    write(BS("Du wagst es und bestellst Dantes Special. Ploetzlich stuermen mehrere "+
    "Waechter herein, halten Dich fest, stecken Dir einen riesengrossen "+
    "Trichter in den Mund und beginnen Dir einen dickfluessigen, bitteren "+
    "Brei einzufloessen. Sie hoeren nicht auf und Du glaubst platzen zu muessen."+
    " Nach einer Zeit ist das Martyrium beendet und Du sinkst erschoepft zu Boden."));

    say(BS(TPN+"  bestellt Dantes Special und um mehr zu erfahren musst Du das wohl oder uebel selbst bestellen!"));
  
    if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
      task->MarkFood(7);
    }
  }


int set_miete(string pl, int monat, int jahr)
{
  if (!member(m_daten, pl))
    m_daten += ([ pl: monat; jahr ]);
  else
    {
      m_daten[pl, 0] = monat;
      m_daten[pl, 1] = jahr;
    }

  return 1;  

}


int calc_miete(string pl)
{
  int i;
  int monat, jahr;
  int rueckstand;
  string *xdate;

  if (!member(m_daten, pl)) return 12500;

  xdate = explode(regreplace(ctime(), "  *", " ", 1), " ");

  monat = member(MONATE, xdate[1])+1;
  jahr = to_int(xdate[4]);

  rueckstand = 0;

  for (i=m_daten[pl, 1]; i < jahr; i++)
      rueckstand += 12;

 rueckstand += (monat - m_daten[pl, 0]);

 return rueckstand;

}



int zahlen(string what)
{
  int miete;
  int cm;
  int monat, jahr;
  string *xdate;

  notify_fail("Was moechtest Du zahlen? Etwa Miete?\n");
  if (what != "miete") return 0;

  notify_fail("Aber Lola ist doch gar nicht da!\n");
  if (!present("lola")) return 0;

  notify_fail("Du hast doch kein Zimmer hier!\n");
  if (member(MIETER, getuid(TP)) == -1)
    return 0;

  cm = calc_miete(getuid(TP));

  miete = cm == 12500 ? 12500 : cm*MIETE;

  notify_fail("Du hast doch nicht genuegend Geld dabei!\n");
  if (TP->QueryMoney() < miete) return 0;

  notify_fail("Lola sagt: Aber Du hast doch schon bezahlt!\n");
  if (miete <= 0) return 0;

  tell_object(TP, BS("Du gibst Lola " + miete + " Muezen."));
  tell_room(ME, BS(TP->Name(WER) + " gibt Lola " + miete 
    + " Muenzen."), ({ TP }));

  tell_room(ME, "Lola sagt: Danke, " + TP->name(WER) + "!\n");

  TP->AddMoney(-miete);

  xdate = explode(regreplace(ctime(), "  *", " ", 1), " ");

  monat = member(MONATE, xdate[1])+1;
  jahr = to_int(xdate[4]);


  set_miete(getuid(TP), monat, jahr); 

  save_object(file_name(ME));

  return 1;
}




int miete()
{
  string pl;
  object lola;
  int rueckstand;

  if (member(MIETER, (pl = getuid(TP))) == -1)
    return 1;

  if (!(lola = present("lola"))) return 1;
  if (!member(m_daten, pl))
    {
      tell_room(ME, break_string("Aah, der neue Mieter. Ich habe "
        "bereits alles hergerichtet. Ich kriege noch 12500 Muenzen, "
        "und schon kannst Du einziehen. Die Miete fuer das erste "
        "Monat ist dann schon dabei.", 78, "Lola sagt: "));
      return 0;
    }

  rueckstand = calc_miete(pl);

 // Bis das Jahr aktuelles Jahr ist
  if (rueckstand > 0)
    {

      tell_room(ME, break_string(CAP(pl) + ", Du bist mit der Miete "
        + rueckstand + (rueckstand > 1 ? " Monate " : " Monat ")
        + "im Rueckstand. Ich kriege noch " + (rueckstand*MIETE)
            + " Muenzen von Dir.", 78, "Lola sagt: "));

      return 0;
     }

  return 1;

}




int gong (string str)
{ object ob;

  notify_fail("Was oder worauf willst Du hier schlagen ?\n");


  if ((!present ("schlegel",TP)) && ( str == "auf glocke" || str == "auf granitglocke" ||
        str == "glocke" || str == "granitglocke")) 
  {
    write (BS("Du schlaegst mit voller Wucht auf die gewaltige Granitglocke, "
          "was Du wohl besser nicht getan haettest.\n"
          "Die Glocke beginnt zu droehnen, wird immer lauter und lauter. "
          "Du versuchst Dein Gehoer mit Hilfe Deiner Haende zu schuetzen, aber "
          "das nuetzt alles nichts. Als Du glaubst Dein Kopf platzt, klingt "
          "das unglaubliche Droehnen langsam ab, aber..."));
    say(BS(CAP_TPN+" geht zur Granitglocke und schlaegt mit voller Wucht gegen sie. "
          "Die Glocke beginnt sehr laut zu droehnen und "+TPN+" haelt sich die Ohren zu."));
    TP->SP(P_DEAF, 180);
    TP->SetProp(P_DISABLE_SPELLS, 180);

    //CLONE(FO"def", TP);
    return 1;
  }

  if((present("schlegel",TP)) && ( str == "auf glocke" || str == "auf granitglocke"||       
        str == "glocke" || str == "granitglocke"))
  {
    write("Du schlaegst mit dem Schlegel hart auf die Glocke!!!\n"
        "Die Glocke beginnt unglaublich zu droehnen, Du versuchst Deine Ohren "
        "zu schuetzen, doch nichts hilft!\n"
        "Dir schwinden die Sinne!\n");
    write(BS(
          "Du erwachst wieder und fuehlst Dich weiser!"));

    say(CAP_TPN+" schlaegt auf die Glocke.\n"
        ""+TPN+" faellt kurz um. Steh aber dann wieder auf.");
    //
    //EPMASTER blabla!!!!
    //bitte!

    while(ob=deep_present("schlegel", TP))
    {
      write("Der Schlegel zerbricht in 100000 Stuecke!\n");
      ob->remove();
    }

    return 1;
  }
  return 0;
}

