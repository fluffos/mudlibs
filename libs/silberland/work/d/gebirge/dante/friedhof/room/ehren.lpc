//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
#include <mnpc.h>


string *text;
int i;

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein Friedhof" );
  SetProp( P_INT_LONG, BS(
        "Als eine besonders maechtige Nebelschwade an Dir "
        "vorbeigezogen ist, siehst Du, wo Du Dich befindest. "
        "Praechtige Steinstatuen saeumen Deinen Weg, nicht "
        "mehr allzu frische Blumen sind darum verstreut. "
        "Das hier duerften die Ehrengraeber sein. "
        "Im Osten siehst Du eine sehr kleine Huette."));


  AD("osten",
      "Du kannst sie betreten.");
  AD("huette",
      "Die Huette ist wirklich sehr klein und nicht gerade schoen.");			  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );


  AD(({"dinger","nerven","ding"}),
      "Immer nur Nebelschwaden.");

  AddDetail(({"blumen", "blume"}),
      BS(
        "Sie sind schon etwas verwelkt.\n"));  
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
      BS(
        "Langsam gehen Dir die Dinger auf die Nerven.\n"));
  AddDetail("weg",
      BS(
        "Immer noch ein Pfad.\n"));
  AddDetail(({"ehrengraeber", "ehrengrab", "graeber", "grab"}),
      BS(
        "Die wurden zu Ehren von Verstorbenen errichtet und waren ganz "
        "schoen teuer.\n"));

  AD(({"ehre","ehren"}),
      "Ob die Verstorbenen das wert waren!?");


  AddDetail(({"steinstatuen", "steinstatue", "statue", "statuen"}),
      BS(
        "Du bewunderst die feine Arbeit des Steinmetzes. Du siehst "
        "einen steinernen Fraggle, einen Zwerg aus Stein, einen kleinen, "
        "versteinerten Rok, einen Oger und einen Gaffo.\n"));

  AD(({"arbeit","steinmetz"}),
      "Er hat wirklich gute Arbeit geleistet.");

  AddDetail("stein",
      BS(
        "Ganz schoen hart.\n"));
  AddDetail("fraggle",
      BS(
        "Unterhalb des steinernen Fraggles steht geschrieben: "
        "\"Unsere Trauer kann man nicht in Worte fassen. Warum sind "
        "wir bloss in diese schreckliche Stadt gezogen?\"\n"));

  AD(({"stadt","trauer","worte"}),
      "Den Fraggle in der Stadt solltest Du kennen...");

  AddDetail(({"rok","roks"}),
      BS(
        "Eine Inschrift auf der Statue besagt: "
        "\"Roks aller Laender, vereinigt Euch! Unsere toten Freunde "
        "werden nicht ungeraecht bleiben!\"\n"));
  AD(({"freund","freunde"}),
      "Unzaehlige Roks.");
  AD("inschrift",
      "Sie ist schon alt und verblichen.");

  AD("laender",
      "Hier gibt es viele...oder doch nur eines.");

  AddDetail(({"zwerg","zwerge", "text"}),
      BS(
        "An der Statue ist ein Text angebracht: "
        "\"Die Zwerge betrauern ihre "
        "im Dienst gefallenen Kollegen. Haltet durch, das wird schon "
        "wieder.\"\n"));
  AD("dienst",
      "Die faulen, dummen Zwerge kriechen eh nur im Dreck herum.");
  AD("dreck",
      "Da leben die Zwerge, oder?!");
  AD("pfad",
      "Der Pfad fuehrt hier ueberall hin.");
  AD(({"verstorbene","verstorbenen"}),
      "Hier liegen die reichen Verstorbenen.");



  AD(({"kollege","kollegen"}),
      "PAH! Zwerge! Stinken und sind dumm!");	       
  AddDetail("oger",
      BS(
        "Ungeschickt gemeisselt ist an dem steinernen Oger zu lesen: "
        "\"Oft hat man Pech.\"\n"));

  AD("pech",
      "Dieser Oger hatte scheinbar zu viel davon.");

  AddDetail("gaffo",
      BS(
        "Die Statue des Gaffo scheint Dich unverschaemt anzugaffen. Angewidert "
        "wendest Du den Blick ab.\n"));

  AD("blick",
      "Du solltest den Gaffo einfach treten!!!");







  AddDetail("himmel",
      BS(
        "Den Himmel kannst Du vor lauter Nebelschwaden "
        "nicht sehen.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSound(DEFAULT_SOUND,
      "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht frisch.\n");
  AD("moos",
      "Hier ist es sehr gruen.");


  AddExit( "westen", "./soldfried");
  AddExit( "norden", "./grab");
  AddExit( "sueden", "./gruft");
  AE("osten", "./kueche");

  ACD(({"tritt", "trete"}), "get_f4");

  AIT("/d/gebirge/dante/gruft/npc/vwolf", REFRESH_DESTRUCT);

  AIT("/d/gebirge/dante/gruft/npc/vrat", REFRESH_DESTRUCT,
      ([P_MNPC_AREA: FR,
        P_MNPC_DEFAULTROOM: FR"ehren",
        P_MNPC_FLAGS: MOV_MOVES+MOV_BACKWARDS+MOV_OUTDOORS]));

  text=({
      "Angrox","Dante","Thor","Woody","Zordan","Eros","Feyaria","Dusty",
      "Verdandi","Charon","Cirion","Stahldorn","Iwo","Cirion","Ronja",
      "Protheg","Zaknafein","Lamuerte",
      "Nostromo","Xorgan","Anatol","Monimor","Brezel"});


}


int get_f4(string str)  {
  object ob;

  NF("Wen willst Du treten?!\n");
  if(!str) {
    i=random(sizeof(text));  

    write(BS(
          "Treten ist gut, doch wen genau?! Etwa "+text[i]+"!"));
    return 1; }


    if(str=="gaffo")  {

      if(!deep_present("H_BOX", TP))  {
        write(BS(
              "Du trittst den Gaffo, doch nichts passiert."));
        return 1; }

        if(deep_present("RotF", TP))  {

          write(BS(
                "Du trittst den Gaffo, doch nichts passiert."));
          return 1; }

        else  {
          ob=CLONEOB(FO"f4");
          ob->move(TP, M_NOCHECK);
          write(BS(
                "Du trittst den Gaffo und er wirft eine Flasche nach Dir!"));
          return 1; }
          return 0; }
          return 0; }

