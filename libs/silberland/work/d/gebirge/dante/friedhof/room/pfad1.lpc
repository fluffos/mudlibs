//dante sl 99


inherit "std/room";
#include <properties.h>
#include "global.h"
#include <moving.h>


#define ANSCHLUSS "/d/gebirge/impulz/paladinweg/room/weg_4"      

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein unheimlicher Pfad" );
  SetProp( P_INT_LONG, BS( 
        "Hier aendert sich die Umgebung abrupt! "
        "Du befindest Dich auf einem kleinen, "
        "anscheinend selten benutzten Pfad. Dir "
        "ist ein wenig unheimlich zumute, denn "
        "wegen der dicken Nebelschwaden kannst Du "
        "von der Umgebung wenig erkennen. Wegen der "
        "klammen Luft beginnst Du zu frieren. "
        "Es ist beaengstigend still und Du denkst an den Tod. "
        "Im Westen liegt ein massiver, grosser, dunkler Felsen, durch den "
        "Du wieder zurueck auf den schmalen Weg nahe "
        "des Abgrundes kommst. Im Norden sieht man im Fels einen "
        "Eingang in eine kleine Hoehle."));

  AD("norden",
      "Da ist eine kleine Hoehle.");
  AD(({"eingang","hoehle"}),
      "Dort wohnt ein Babydrache.");
  AD(({"babydrache","drache"}),
      "babydrachen sind sehr freundlich und nett. Doch ihre Mutter kann sehr boese werden...");
  AD("mutter",
      "Die Mutter fuerchtest Du nicht!!!");


  AD(({"felsen", "fels"}),
      "Der Fels wirkt bedrohlich und dunkel. Durch eine natuerliche Oeffnung "
      "kann man wie durch ein grosses Tor hindurchtreten.");
  AD("tor",
      "Hoffentlich stuerzt der Felsen nicht ein.");
  AD("oeffnung",
      "Angeblich hat die Macht von Nosferatu diese Oeffnung in den Fels "
      "gesprengt.");
  AD("macht",
      "Dieser Vampir soll sehr maechtig sein und hier irgendwo hausen!");
  AD("nosferatu",
      "Er soll der Meister aller Vampire sein!");
  AD("meister",
      "Er regiert hier mit brutaler Macht!");
  AD(({"vampir","vampire"}),
      "Angeblich leben sie hier unter der Erde in zwei unterirdischen Gruften.");
  AD(({"gruft","grufte"}),
      "Du kannst sie suchen und auch finden!");


  AD("westen",
      "Im Westen liegt hinter dem Felsen der schmale Weg.");
  AD("abgrund",
      "Den Abgrund sieht man von hier nicht mehr.");
  AD("weg",
      "Der Weg liegt im Westen.");

  AD("tod",
      "Der Nebel umhuellt Dich totengleich.");


  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

  AddDetail("pfad",
      BS (
        "Hier kommt offensichtlich selten jemand vorbei, denn der "
        "Pfad ist fast komplett mit Moos ueberwachsen.\n"));
  AddDetail("moos",
      BS (
        "Dunkelgruenes Moos hat den Pfad ueberwachsen.\n"));
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
      BS (
        "Die Nebelschwaden nehmen Dir die Sicht.\n"));
  AddDetail("sicht",
      BS (
        "Du kannst wegen der Nebelschwaden nicht weit sehen.\n"));
  AddDetail("luft",
      BS (
        "Die Luft ist kalt und feucht.\n"));
  AddDetail("umgebung",
      BS (
        "Es ist so nebelig, dass Du nichts erkennen kannst.\n"));
  AddDetail("himmel",
      BS(
        "Den Himmel kannst Du vor lauter Nebelschwaden "
        "nicht sehen.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSound(DEFAULT_SOUND,
      "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht nach feuchter Erde.\n");
  AddSmell("erde",
      "Die Erde ist hier sehr feucht.");
  AIT(FN"harpyie", REFRESH_DESTRUCT);

  AIT("/d/gebirge/dante/gruft/npc/vwolf", REFRESH_DESTRUCT);
  AIT("/d/gebirge/dante/gruft/npc/vwolf", REFRESH_DESTRUCT);
  AddExit( "westen", ANSCHLUSS);
  AddExit( "osten", "./pfad2");

  ASE("norden", "warnung");
}


int warnung()  {

  write(BS(
        "Du gehst nach Norden in die Hoehle! Sei vorsichtig und achte darauf wen "
        "Du angreifst."));
  TPM("d/gebirge/dante/friedhof/room/babyhoehle", M_GO,
      "nach Norden in die Hoehle", "geht", "kommt von draussen herein");
  return 1; }




