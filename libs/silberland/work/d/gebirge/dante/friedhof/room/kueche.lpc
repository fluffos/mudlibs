//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
create()
{
  ::create();
  SetProp( P_INT_SHORT, "Eine Kueche");
  SetProp( P_INT_LONG,BS( 
        "Du stehst in einer Kueche. Hier findet sich "
        "so ziemlich alles, was in eine gute Kueche "			
        "gehoert. An den Waenden befinden sich Schraenke, "			
        "ueber einem kleinen Feuer im Ofen haengt ein "
        "Kessel, in dem eine Suppe vor sich hin kocht. "			
        "In der Mitte des Raumes steht ein weisser "
        "Holztisch, auf dem wiederum eine Platte mit "
        "Kaese plaziert ist. Um den Tisch herum sind "
        "vier Holzsessel verteilt."));

  AD("mitte",
      "Mittendrin.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  AddDetail(({"raum", "kueche", "zimmer"}),
      BS(
        "Du stehst mittendrin.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist gefliest.\n"));
  AD("fliesen",
      "Sie sind braun und schwarz und immer sehr sauber.");

  AddDetail("decke",
      BS(
        "Die Decke ist weiss gestrichen.\n"));
  AddDetail(({"wand", "waende"}),
      BS(
        "An den Waenden sind Schraenke angebracht.\n"));
  AddDetail(({"schrank", "schraenke"}),
      BS(
        "Die Schraenke dienen wohl dazu, die zum Kochen "
        "notwenigen Utensilien aufzubewahren. Vielleicht "
        "kann man ja mal schauen was so alles drinnen ist."));


  AD("utensilien",
      "Alles was man so kennt.");

  AddDetail("feuer",
      BS(
        "Das Feuer flackert lustig vor sich hin und "
        "soll wohl die Suppe in dem Kessel darueber "
        "warmhalten.\n"));
  AddDetail("ofen",
      BS(
        "In dem Ofen brennt ein Feuer, damit man besser "
        "kochen kann.\n"));
  AddDetail("kessel",
      BS(
        "In dem kupfernen Kessel befindet sich eine "
        "appetitlich riechende Suppe.\n"));
  AddDetail("suppe",
      BS(
        "Hmmm, das sieht aber gut aus. Eine echte "
        "Pilzkaesecremesuppe!\n"));
  AD(({"pilzkaesecremesuppe","cremesuppe","pilzsuppe"}),
      "Hmm, ob man die kosten soll?");




  AddDetail(({"tisch", "holztisch"}),
      BS(
        "Der Holztisch ist weiss angemalt und steht in "
        "der Mitte des Raumes. Auf ihm befindet sich eine "
        "Platte mit Kaese.\n"));
  AddDetail("platte",
      BS(
        "Die silberne Platte ist geradezu ueberladen mit "
        "koestlich aussehendem Kaese. Offensichtlich wird "
        "das in diesem Haushalt gerne gegessen.\n"));
  AddDetail("kaese",
      BS(
        "Diese Kaesesorte hast Du bisher noch nirgenwo "
        "gesehen. Es muss sich wohl um eine seltene "
        "Spezialitaet handeln.\n"));


  AD("haushalt",
      "Wer wohl hier wohnt?!");

  AD(({"kaesesorte","sorte"}),
      "Du kennst sie nicht, oder doch...");
  AD("spezialitaet",
      "Es gibt sie angeblich nur hier.");
  AD(({"essenszeit","zeit"}),
      "Die beste von allen.");

  AddDetail(({"sessel", "holzsessel"}),
      BS(
        "Darauf kann man sitzen. Wahrscheinlich sind um die "
        "Essenszeit alle Plaetze besetzt.\n"));
  AD(({"plaetze","platz"}),
      "Momentan sind sie aber alle leer. Nimm doch auch Platz.");
  AD("mund",
      "HMMMMMMMMM!!!");

  AddSmell(DEFAULT_SMELL,
      "Du schnupperst. Dir laeuft das Wasser im Mund zusammen, denn "
      "Du riechst eine sehr nahrhaft duftende Suppe.\n");
  AD("wasser",
      "Lecker!");
  AD("kochen",
      "Hier wird gerne gekocht!");

  AE("westen", "./ehren");

  AddItem(FN"gorgone", REFRESH_DESTRUCT);
  AddItem(FO"gorgonzola", REFRESH_REMOVE);

  /*
     platz nehmen
     suppe kosten
     schraenke oeffnen

*/	  

  ACD(({"koste","kost","kosten"}), "get_f7");
  ACD(({"nimm", "nehme","setze","sitz","nehmen","setzen","sitzen"}), "nix");
  ACD(({"oeffne", "oeffnen"}), "get_f8");
}

int nix(string str)  {
  NF("Was willst Du tun?! Platz nehmen?! In den Sessel setzen?\n");
  if(str=="platz"||str=="in sessel")  {

    switch(random(3))   {
      case 0:	
        write(BS(
              "Du nimmst an einem der Sessel Platz, doch irgendwie "
              "ist das langweilig. So stehst Du wieder auf."));
        break;
      case 1:
        write(BS(
              "Du setzt Dich in den Sessel. AUA! Irgendetwas sticht Dich! Du "
              "springst wieder auf!"));
        TP->do_damage(5);
        break;
      case 2:
        write(BS(
              "Du nimmst in einem Sessel Platz! Ploetzlich schnellt ein Skorpion "
              "hervor und sticht Dich! Dann laeuft er geschwind davon!"));
        TP->AddPoison(1+random(2));
        break;
    } 
    return 1; 
  }
  return 0; 
}


int get_f7(string str)  {
  object ob;
  NF("Was willst Du kosten?!\n");
  if(!str) return 0; 
  if(str=="pilzsuppe"||str=="suppe" ||
      str=="pilzkaesecremesuppe"||str=="kaesecremsuppe")

  {

    if(!deep_present("H_BOX", TP))  {
      write(BS(
            "Du kostest die Suppe, doch sie schmeckt Dir nicht."));
      return 1;
    }

    if(deep_present("WeissF", TP))  {
      write(BS(
            "Du kostest die Suppe, doch sie schmeckt Dir nicht."));

      return 1;
    }

    else  {
      ob=CLONEOB(FO"f7");
      ob->move(TP, M_NOCHECK);
      write(BS(
            "Du kostest die Suppe und findest dabei eine Flasche."));

      return 1;
    }
    return 0; 
  }
  return 0; 
}





int get_f8(string str)  {
  object ob;
  NF("Was willst Du oeffnen?!\n");
  if(!str) return 0; 
  if(str=="schraenke"||str=="schrank")  {
    if(!deep_present("H_BOX", TP))  {
      write(BS(
            "Der Schrank scheint verklemmt zu sein..."));
      return 1; 
    }

    if(deep_present("TuerkisF", TP))  {
      write(BS(
            "Der Schrank scheint verklemmt zu sein..."));


      return 1; 
    }

    else  {
      ob=CLONEOB(FO"f8");
      ob->move(TP, M_NOCHECK);
      write(BS(
            "Du oeffnest den Schrank und findest darin eine Flasche. Dann "
            "schliesst Du den Schrank wieder."));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

