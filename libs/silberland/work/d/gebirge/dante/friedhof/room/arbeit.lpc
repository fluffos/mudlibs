//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
#include <player.h>
#include <language.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)


init()  {
  ::init();

  if( (!interactive(TP)) && (TP->id("ratte")))  {

    TP->move("/d/gebirge/dante/friedhof/room/platz", M_GO,
        "rasch wieder hinaus","trippelt",
        "kommt aus Humfreys Haus");
  }
}



create()
{
  ::create();
  SetProp( P_INT_SHORT, "Humfreys Arbeitszimmer" );
  SetProp( P_INT_LONG,BS( 
        "Dies ist das Arbeitszimmer des Magiers "
        "Humfrey. Die Waende des hohen Raumes sind bis zur "
        "Decke mit Regalen bedeckt, in denen sich Buecher "
        "in allen nur denkbaren Groessen und Farben befinden. "
        "Auf einem Hocker steht eine Reihe von "
        "kleinen Flaschen, auf dem Boden liegen stapelweise "
        "zerknuellte Notizzettel. Humfrey scheint wirklich "
        "ein vielbeschaeftigter Mann zu sein.\n"));

  AddDetail(({"raum", "zimmer", "arbeitszimmer"}),
      BS(
        "Du befindest Dich mittendrin.\n"));
  AddDetail(({"wand", "waende"}),
      BS(
        "An den Waenden stehen ueberall Regale, in denen Buecher "
        "aufbewahrt werden.\n"));
  AddDetail("boden",
      BS(
        "Auf dem Boden liegen haufenweise zerknuellte "
        "Notizzettel.\n"));
  AddDetail("decke",
      BS(
        "Die Decke ist sehr hoch - ansonsten aber voellig "
        "uninteressant.\n"));
  AddDetail(({"buch", "buecher"}),
      BS(
        "Du kannst Dir nicht vorstellen, dass Humfrey diese "
        "vielen Buecher wirklich alle gelesen hat!\n"));

  ARD(({"buch","buecher"}),
      "Du beginnst eines der Buecher zu lesen. Naja, nicht gerade interessant. "
      "Das zweite ist auch nicht besser, also laesst Du es sein.");


  AddDetail(({"groesse", "groessen"}),
      BS(
        "Grosse Buecher, kleine Buecher, dicke Buecher, "
        "duenne Buecher...\n"));
  AddDetail(({"farbe", "farben"}),
      BS(
        "Sehr leuchtend sehen die Farben der Buecher ja nicht mehr "
        "aus. Es wird Zeit, das hier mal jemand ordentlich Staub "
        "wischt.\n"));
  AD("zeit",
      "Naja, oder auch nicht.");
  AD("mann",
      "Humfrey ist 100% maennlich.");

  AddDetail("staub",
      BS(
        "Davon liegt hier ueberall ziemlich viel rum.\n"));
  AD("reihe",
      "Es sind einige...");

  AddDetail(({"regal", "regale"}),
      BS(
        "In den Regalen befinden sich unzaehlbar viele "
        "Buecher.\n"));
  AddDetail(({"zettel", "notizzettel"}),
      BS(
        "Bei den zerknuellten Notizzetteln handelt es sich "
        "offensichtlich um Informationen, die Humfrey nicht "
        "mehr braucht.\n"));
  AD("tag",
      "Er ist enorm fleissig.");
  AD(({"umstaende","umstaenden"}),
      "Frag ihn einfach aus...");
  AD(({"magier","informationsmagier"}),
      "Humfrey weiss sehr viel ueber den Friedhof...");
  AD("friedhof",
      "Frag ihn danach.");

  AddDetail(({"informationen", "information"}),
      BS(
        "Damit beschaeftigt sich Humfrey den ganzen Tag. "
        "Unter Umstaenden koennte sich das fuer Dich als "
        "ganz nuetzlich erweisen.\n"));
  AddDetail(({"hocker","holzhocker"}),
      BS(
        "Auf dem etwas wackelig wirkenden Holzhocker stehen "
        "kleine, staubige Flaschen, die mit Korken zugestoepselt "
        "sind.\n"));
  AddDetail("holz",
      BS(
        "Daraus besteht der Hocker.\n"));

  AD("humfrey",
      "Humfrey lebt hier.");

  AddDetail("korken",
      BS(
        "Damit sind die kleinen Flaschen alle fest verschlossen. Sie sehen sehr interessant aus.\n"));
  AddDetail(({"flasche", "flaschen"}),
      BS(
        "Du kannst es nicht genau erkennen, aber irgendetwas scheint "
        "sich in den Flaschen zu befinden.\n"));


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  AddItem(FN"humfrey", REFRESH_DESTRUCT);

  AddExit( "sueden", "./platz");
}




