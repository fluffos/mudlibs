//dante sl 99
inherit "std/room";

#include <properties.h>

#include <moving.h>
#include "global.h"
#include <player.h>

void init()  {
  ::init();
  if(interactive(TP))  {
    call_out("tag", 2); }}


    tag()  {
      if(environment(TP)!=TO) return ;	
      write(BSA(
            "Willkommen auf dem Friedhof. Hast Du Dante, das Gfrast gesehen?!",
            "Wuschel sagt befehlsgewohnt: "));
    }



void create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein Friedhof");
  SetProp( P_INT_LONG,BS( 
        "Dieser Teil des Friedhofes scheint Dir "
        "besonders unheimlich zu sein, denn er ist, "
        "abgesehen von einem grossen Loch und einem "
        "frischem Erdhaufen, leer. Du fuehlst Dich einsam und "
        "bist veraengstigt und verwuenscht die "
        "Nebelschwaden, die die unheimliche Stimmung nur "
        "verstaerken. Naja, eine grosse Statue, die am Ende des Pfades steht "
        "faellt Dir noch auf."));

  AD("stimmung",
      "Du beginnst zu weinen...");

  AD("pfad",
      "Der Pfad endet hier.");
  AD("ende",
      "Hier scheint der kleine Friedhof zu enden.");
  AD("friedhof",
      "Der Friedhof ist hier sehr leer. Naja, bis auf das Loch und "
      "die Statue.");
  AD("statue",
      "Die Statue ist aus purem Diamant und stellt Wuschel dar.");
  AD("diamant",
      "Er ist dunkelblau und gruen und leuchtet extrem hell.");
  AD("wuschel",
      "Wuschel schaut Dich enorm frech an, immer bereit eine "
      "Gemeinheit los zu werden. Ihre Haare kringeln sich wild herum "
      "und ihre kleine Stupsnase verleiht ihr ein fast boesartiges "
      "Aussehen. Ihre Augen leuchten hell wie ein Smaragd. "
      "Sie ist die geistige Mutter dieses Friedhofes und "
      "hat ihren gutmuetigen Sklaven Dante gezwungen das hier zu vollenden. "
      "Dafuer wurde Dante auch reichlich belohnt. Womit? Nein, dass "
      "erfaehrst Du sicher nicht. Aber Du kannst ja die beiden einmal "
      "getrennt von einander befragen.");

  AD("smaragd",
      "Gruen und schmalzig wie schlechte Volksmusik ist das hier...");
  AD(({"musik","volksmusik"}),
      "TRAE TREA TEE..Holladrio...Jodelidio");

  ASD(({"auge","augen"}), "hit");

  AD(({"nase","stupsnase"}),
      "Die Nase ist das beste an ihr.");
  AD("mutter",
      "Ob Wuschel bald Mutter wird?!");
  AD("sklave",
      "Wen Du wuesstest was der arme Dante alles erdulden muss!!!");
  AD("dante",
      "Er ist wirklich nicht zu beneiden...");

  AD("gemeinheit",
      "Naja, eigentlich ist sie ja eh ganz nett.");
  AD("haare",
      "Ihre Haare verleihen ihr ein abenteuerliches Aussehen. Zieh sie "
      "einfach mal an den Haaren!");


  AD("aussehen",
      "Naja, so wie ein Wuschel eben aussieht.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );  
  AddDetail("loch",
      BS(
        "Das Loch hat eine rechteckige Form und ist ziemlich tief. "
        "Es scheint sich um ein noch unfertiges Grab zu handeln - "
        "fuer wen das wohl sein mag? Du koenntest ja einmal "
        "hineinspringen.\n"));
  AddDetail("grab",
      BS(
        "Es ist noch nicht fertig.\n"));
  AddDetail("form",
      BS(
        "Sieht ziemlich rechteckig aus.\n"));

  AD("moos",
      "Das Moos ist hier braun.");
  AD("teil",
      "Dieser Teil ist eher karg.");


  AD("erde",
      "Die Erde ist braeunlich und feucht.");

  AddDetail(({"erdhaufen", "haufen"}),
      BS(
        "Das ist die Erde, die man aus dem Loch herausgeschaufelt "
        "hat.\n"));
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
      BS(
        "Wo kommt der ganze Nebel nur her?\n"));
  AddDetail("himmel",
      BS(
        "Den Himmel kannst Du vor lauter Nebelschwaden "
        "nicht sehen.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSound(DEFAULT_SOUND,
      "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht nach feuchter Erde.\n");
  AddSmell("erde",
      "Waeh!");


  AddItem(FO"seele", REFRESH_REMOVE);


  AddCmd(({"springe", "spring"}), "springe_loch");

  AddExit( "sueden", "./ehren");

  ACD(({"zieh","ziehe"}), "get_f2");
}



int get_f2(string str)  {
  object ob;
  NF("Was willst Du ziehen?!\n");
  if(!str) return 0; 
  if(str=="an haar"||str=="haare"||str=="haar"||str=="haare"||
      str=="wuschel an haar"||str=="an haaren"||str=="wuschel an haaren")  {
    if(!deep_present("H_BOX", TP))  {
      write(BS(
            "Wuschel weicht Dir einfach aus und tritt Dich dann ins Loch!"));
      TPM(FR"loch", M_GO, "von Wuschel ins Loch nach unten",
          "getreten", "wird von Wuschel hierher getreten");

      return 1; 
    }

    if(deep_present("GelbF", TP))  {
      write(BS(
            "Wuschel weicht Dir einfach aus und tritt Dich dann ins Loch!"));
      TPM(FR"loch", M_GO, "von Wuschel ins Loch nach unten",
          "getreten", "wird von Wuschel hierher getreten");

      return 1; 
    }

    else  {
      ob=CLONEOB(FO"f2");
      ob->move(TP, M_NOCHECK);
      write(BS(
            "Du ziehst an Wuschels Haaren und aus den wilden, unzaehmbaren "
            "Gestruepp auf ihrem Kopf faellt eine Flasche."));
      return 1; 
    }
    return 0;
  }
  return 0; 
}

string hit()  {
  return BS(
      "Ein Blitz schiesst aus Wuschels Augen hervor und trifft Dich mit "
      "einer Gemeinheit. So ist sie eben...");
  TP->do_damage(10);  }


springe_loch(string str)
{
  int result;
  result=0;
  notify_fail("Wo willst Du reinspringen?\n");
  if (str && (str=="loch" || str=="in loch" || str=="ins loch"))
  {
    write(BS("Du nimmst all Deinen Mut zusammen und springst "
          "in die ungewisse Tiefe.\n"));
    TP->move(FR"loch", M_GO, "in das Loch", "springt",
        "kommt herabgesprungen");

    result=1;
  }
  return result;
}
