//dante sl 99

inherit "std/room";

#include <properties.h>

#include "global.h"
#define PlayerGender this_player()->QueryProp(P_GENDER)
#include <moving.h>

int da=3;
void reset()  {
  ::reset();
  da=3; 
}

void create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein Friedhof" );

  SetProp( P_INT_LONG, BS( 
        "Du stehst auf einem Friedhof. Du erkennst "
        "unzaehlige, identisch aussehende Graeber mit "
        "lieblos aufgestellten, morschen Holzkreuzen, "
        "die keine Inschrift tragen. Rechts von Dir steht "
        "eine Statue. Ein Windstoss bringt "
        "das geoeffnete Tor hinter Dir zum wackeln, die "
        "Scharniere geben ein unheimliches Quietschen "
        "von sich. Du bekommst es mit der Angst zu tun. "
        "Im Westen siehst Du einen sehr grossen Felsen."));

  AD("westen",
      "Der Felsen ist wirklich gigantisch gross. Man kann ihn betreten.");
  AD("felsen",
      "Der Felsen beherbergt eine Kneipe.");
  AD("kneipe",
      "Du solltest einfach nach Westen gehen.");



  AD("angst",
      "Feig wie Du nun mal bist.");
  AD("inschrift",
      "Naja, eine Inschrift ist hier. Aber nicht auf den Kreuzen, sondern auf der "
      "Marmortafel! Sie ist den Soldaten gewidmet!");



  ARD("inschrift",
      "Ach, untersuch lieber die Marmortafel.");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

  AddDetail("friedhof",
      BS(
        "Du weisst wirklich nicht, was ein Friedhof ist?\n"));
  AddDetail(({"grab", "graeber"}),
      BS(
        "Seltsamerweise sehen alle Graeber gleich aus.\n"));
  AddDetail(({"holzkreuz", "holzkreuze", "kreuz", "kreuze"}),
      BS(
        "Die Holzkreuze haben alle dieselbe Groesse.\n"));
  AddDetail("groesse",
      BS(
        "Standard-Holzkreuzgroesse.\n"));
  AD(({"standard","holzkreuzgroesse","kreuzgroesse"}),
      "Ungefaehr so gross wie ein Zwerg.");
  AD("zwerg",
      "Also nicht so gross...");

  AddDetail("statue",
      BS(
        "Die Statue stellt einen Soldaten dar, der gen "
        "Himmel blickt und sein Schwert hoch erhoben hat. "
        "Sie steht auf einem Sockel, auf dem eine kleine "
        "Marmortafel angebracht ist.\n"));
  AddDetail("soldat",
      BS(
        "Der Soldat ist fuer den Kampf geruestet. Er wirkt "
        "allerdings etwas steif.\n"));


  ASD("kampf", "come_npc");

  AD("nebel",
      "Der Nebel zieht unheimlich umher.");

  AddDetail("himmel",
      BS(
        "Du kannst den Himmel nicht erkennen, weil es so "
        "nebelig ist.\n"));
  AddDetail("schwert",
      BS(
        "Ein steinernes Schwert, das sehr klobig ist.\n"));
  AddDetail("sockel",
      BS(
        "Auf dem Sockel befindet sich eine kleine Marmortafel.\n"));
  AddDetail(({"marmortafel", "tafel"}),
      BS(
        "Auf der Marmortafel befindet sich eine gemeisselte "
        "Inschrift: \"Zum immerwaehrenden Gedenken an die "
        "tapferen Soldaten, die bei der Verteidigung der Stadt "
        "Midas ihr Leben lassen mussten. Wir werden euch nie "
        "vergessen.\"\n"));
  AD("gedenken",
      "Du besinnst Dich kurz.");

  AD(({"midas", "stadt", "leben"}),
      "Midas, die groesste Stadt hier, ist voller Leben.");
  AD("verteidigung",
      "Wirst Du auch brauchen...");

  AddDetail("windstoss",
      BS(
        "Das ist Luft, die sich bewegt.\n"));
  AddDetail("tor",
      BS(
        "Das Tor haengt schief in den Angeln. Hier scheint es total "
        "verrostet zu sein, so dass man es nicht bewegen kann! Trotzdem "
        "scheint ein kleiner Spalt nach Norden zu fuehren!"));

  AD(({"norden","spalt"}),
      "Das Tor laesst sich von hier scheinbar nicht bewegen. Egal, denn durch den "
      "Spalt kommt man nach Norden!");


  AD(({"angel", "angeln"}),
      "Sie sind auch schon sehr alt.");
  AD("luft",
      "Die Luft ist hier sehr kuehl.");

  AddDetail(({"scharniere", "scharnier"}),
      BS(
        "Die Scharniere sind verrostet und wurden schon "
        "lange nicht mehr geoelt.\n"));
  AddDetail("boden",
      BS(
        "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSmell(DEFAULT_SMELL,
      "Es riecht nach feuchter Erde.\n");
  AddSound(DEFAULT_SOUND,
      BS(
        "Das Tor quietscht.\n"));
  AddSmell(({"erde","feuchte erde"}),
      "Sie ist recht feucht.");
  AD("moos",
      "Das Moos ist gruen und frisch.");
  AD("erde",
      "Die Erde ist nass und rutschig.");

  AddSound("quietschen",
      "IHHH!!! Unangenehm!");



  AIT(FN"maedel", REFRESH_DESTRUCT);

  ASE( "norden", "go_nord");

  AddExit( "osten", "./ehren");
  AddExit( "sueden", "./aufbahr");
  AE("westen", "./bar");

  AddCmd (({"oeffne","oeffnen","schliess","schliesse"}), "nix_tor");
}

int go_nord(string dir)  {
  return TP->move(FR"platz",M_GO, "sich durch das Tor nach Norden",
      "zwaengt sich", "kommt durch das Tor aus dem Sueden herein");

}


string come_npc()  {
  object ob;
  if((!da) ||(present("soldat", TO)))
  {
    return BS(
        "Der Soldat scheint bereit zu sein!");  }

  else  {
    ob=clone_object(FN"soldat");
    ob->move(TO, M_TPORT);
    da--;
    return BS(
        "Der Kampf kann beginnen!");
  }}



nix_tor(string str)
{
  int result;
  result = 0;
  notify_fail ("Was willst Du schliessen/oeffnen?\n");
  if (str && str=="tor")
  {

    write (BS ("Du ziehst mit all Deiner Kraft an dem Eisentor. "
          "Das Tor laesst sich nicht bewegen, es hat sich wohl"
          "verkeilt. Vielleicht laesst es sich von der anderen "
          "Seite bewegen."));
    say (BS (TPN+ " zieht mit all "
          + (PlayerGender == FEMALE ? "ihrer" : "seiner") + 
          " Kraft an dem Eisentor. Das Tor laesst sich nicht "
          "bewegen, es hat sich wohl verkeilt.\n"));
    result=1;
  }
  return result;
}







