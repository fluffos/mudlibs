//dante sl 99
inherit "std/room";

#include <properties.h>
#include "global.h"
#include <moving.h>
#include <player.h>
#include <language.h>
#include <mnpc.h>

#define PUNKT (member(punkt, getuid(this_player()))!=-1)

 string *punkt=({});
 
int rand1, rand2;

init() { ::init();

if(interactive(TP))  { call_out("tag", 2);  }
}


tag()  {
	if(TO!=environment(TP))  return;

            if(getuid(TP)!="gimliy")  {	
	write(BSA(
	"Hallo "+TPN+"! Willkommen in Gimliys Gruft!",
	"Eine unheimliche Stimme sagt: "));
                 }	

  if(getuid(TP)=="gimliy")  {	
write(BSA(
"Hallo Gimliy! Willkommen in Deiner Gruft!",
"Eine unheimliche Stimme sagt: "));

     }

}


reset()  {
	::reset();

rand1=5000+random(5000);
rand2=100+random(100);
}
	

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Gimliys Gruft");

rand1=5000+random(5000);
rand2=100+random(100);

  SetProp(P_INT_LONG, BS(
 "Du stehst nun in der Gruft von Gimliy. Er hat sie als Belohnung "
 "fuer seine Heldentaten, "
 "seinen Mut und seine unermuedlichen Erforschungen dieser Welt erhalten. "
 "Hier ist es merklich kuehler als oben und Du fuehlst Dich hier nicht "
 "sonderlich sicher. Irgendetwas scheint hier zu lauern. Die Waende bestehen "
 "aus kalten, schwarzen Marmor, der nur stellenweise durch blutrote, "
 "unregelmaessige Linien unterbrochen wird. An einer Wand steht eine hohe "
 "Marmorbueste, die Gimliy darstellt. Sie scheint Dich boese anzugrinsen. "
 "Der Boden besteht aus festem Lehm, der nicht sonderlich interessant aussieht. "
 "Mittels der kleinen Treppe kommst Du wieder nach oben."));


AD("bewohner",
"Du bist auch einer davon.");
AD("decke",
"Die Treppe fuehrt durch ein Loch in der Decke nach oben."),
AD("loch",
"Es ist gross genug um durchzukommen.");
AD("treppe",
"Die Treppe sieht sehr rutschig aus.");

AD(({"bueste","marmorbueste"}),
"Die Bueste stellt Gimliy dar. Er grinst boese. Teilweise sieht man einige "
"unschoene Kratzer am Marmor.");

ASD("kratzer", "monster_comes");



AD("boden",
"Der Boden besteht aus Lehm.");
AD("lehm",
"HE! Im Lehm steckt eine Todesaxt!!!");

AD(({"axt","todesaxt"}),
"JA! Da steckt eine echte, voellig unbeschaedigte magische Todesaxt! "
"Reiss sie aus dem Boden!");

AD("welt",
"Eine schoene, aber auch gefaehrliche Welt.");
AD(({"wand","waende"}),
"Die Waende sind marmorvertaefelt und wirken nicht gerade gemuetlich."),
AD("marmor",
"Der Marmor ist dunkelschwarz und nur von roten Linien unterbrochen."),
AD(({"linie","linien"}),
"Die Linien laufen alle an einem Punkt zusammen."),
AD("punkt",
"Der Punkt scheint sich zu bewegen. Seltsam! Von ihm geht eine "
"anziehende Wirkung aus."),
AD("wirkung",
"Der Punkt scheint Magie zu haben! Positive Magie!");

ASD("magie", "get_out");

AD(({"tat","taten","heldentaten","heldentat"}),
"Er fand die versteckten Werwoelfe.");
AD("mut",
"Es gehoerte viel Mut dazu sich den Werwoelfen zu stellen.");
AD(({"erforschungen","erforschung"}),
"Gimliy hat momentan "+rand1+" Forscherpunkte.");

AD(({"punkte","forscherpunkte"}),
"Du hast leider nur "+rand2+" Forscherpunkte! Eher mies!");



AD("gruft",
"Die Gruft wirkt bedrohlich auf Dich.");
AD("belohnung",
"Gimliy hat sie sich redlich verdient, als er die versteckten Werwoelfe fand."),
AD(({"werwolf","werwoelfe","wolf"}),
"Keiner hier. Oder?!");
AD("gimliy",
"Gimliy, ein Bewohner dieser Welt, gehoert diese Gruft.");


AddItem("d/gebirge/dante/gruft/npc/vrat",
 REFRESH_DESTRUCT,([P_MNPC_FLAGS: 0]));
  
  

AddItem("d/gebirge/dante/gruft/npc/vrat",
 REFRESH_DESTRUCT,([P_MNPC_FLAGS: 0]));
 
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN:TT_CAVE]) );

  AddSound(DEFAULT_SOUND,
	   "Du hoerst eigentlich nichts.\n");
  AddSmell(DEFAULT_SMELL,
	   "Es ist kuehl und trocken.\n");
  ASE( "oben", "nix");

SP(P_KILL_NAME, "Ein Treppensturz");

ACD(({"reiss","reisse","reissen"}), "njet");
}


int njet(string str)  {
	NF("Was willst Du aus dem Boden reissen!?\n");

if(str=="axt aus"||str=="axt aus boden"||str=="axt aus lehm heraus"||
str=="axt aus boden raus"||str=="axt aus lehm raus"||
str=="axt aus boden heraus"||
str=="todesaxt aus"||str=="todesaxt aus boden"||
str=="todesaxt aus lehm heraus"||
str=="todesaxt aus boden raus"||str=="todesaxt aus lehm raus"||
str=="todesaxt aus boden heraus" )     {
	

write(BS(
"Du reisst mit aller Gewalt an der Axt. Nichts! Du bist zu schwach dazu!"));
say(BS(
CAP_TPN+" schafft es nicht die Todesaxt aus dem Boden zu reissen!!!"));

return 1;   }

return 0;
}	

string monster_comes()  {
object ob;

if(present("ratte", TO))  {
	write(BS(
"Die Ratte lacht Dich aus! Toete sie!"));
	return "";  }


if(present("pestdaemon", TO))  {
	write(BS(
	"Der Pestdaemon lacht laut auf!"));
	return "";  }

else

    {
    ob=clone_object("d/gebirge/dante/friedhof/npc/pestdaemon");
    write(BS(
    "Ein Pestdaemon entsteht aus dem Nichts!"));
   say(
    CAP_TPN+" betrachtet die Bueste.\n"
    "Ein Pestdaemon entsteht aus dem Nichts!\n");
    ob->move(TO, M_NOCHECK+M_SILENT);
      return "";
      }    
}
	

int nix()  {

if(!PUNKT) 

   {
	write(BS(
	"Du willst nach oben, rutscht aber auf der Treppe aus "
	"und schlaegst Dir den Kopf an."));
	TP->do_damage(10+random(10));
return 1;
    }	
    
  
   else
   
   TPM("d/gebirge/dante/friedhof/room/platz", M_GO,
   "ueber die Treppe nach oben", "geht",
   "kommt von unten ueber die Treppe herauf");
   return 1;
            } 
    



   string get_out()  {
 

  
  if(!PUNKT)  {
  	 punkt += ({getuid(this_player())});   
  return BS(
  "Die Magie huellt Dich ein und wird Dir helfen!");
 
            }   
   if(PUNKT)  {
 	return BS(
 	"Die Magie ist Dir gut gesinnt.");
     }
  
  }