//dante sl 99


inherit "std/room";
#include <properties.h>
#include "global.h"

#define ANSCHLUSS " was hier reinkommt musst Du eben einfuegen":))

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein unheimlicher Pfad" );
  SetProp( P_INT_LONG, BS( 
 "Du befindest Dich auf einem kleinen, "
"anscheinend selten benutzten Pfad. Dir "
"ist ein wenig unheimlich zumute, denn "
"wegen der dicken Nebelschwaden kannst Du "
"von der Umgebung wenig erkennen. Wegen der "
"klammen Luft beginnst Du zu frieren. "
"Es ist beaengstigend still und Du denkst an den Tod. "
"Am Rande des Pfades steht eine gewaltige Marmorstatue auf einem "
"noch massiveren Sockel."));

AD(({"rand","rande"}),
"Seitlich des Pfades.");
AD("marmor",
"Der Marmor ist poliert und glaenzt hell.");
AD("sockel",
"Der Sockel ist quadratisch und traegt die Statue. Du erkennst eine "
"Inschrift aus Gold.");
AD("gold",
"Es ist eingelegt und schon etwas verblichen.");
AD(({"statue","marmorstatue"}),
"Die Statue ist sicher an die fuenf Meter hoch. Sie stellt einen Drachen "
"dar.");
AD("meter",
"Mindestens fuenf Meter, wenn nicht sechs.");
ASD("inschrift", "show_text");
AD(({"drache","drachen"}),
"Der Drache ist ein Vampirdrache und sieht sehr gefaehrlich aus. Wo er wohl lebt?");
AD("vampirdrache",
"Der Vampirdrache ist der staerkste aller Vampire. Er gehorcht nur "
"Nosferatu, dem Fuerst der Vampire.");
AD(({"vampir","vampire"}),
"Nosferatu lebt tief unter der Erde in einer Gruft und soll mit "
"normalen Mitteln unbesiegbar sein.");
AD("nosferatu",
"Er ist der Fuerst aller Vampire.");
AD("fuerst",
"Er ist unschlagbar.");
AD("gruft",
"Nicht weit von hier.");
AD(({"mittel", "mitteln"}),
"Du wirst Dich schon durchkaempfen und denken muessen um herauszufinden, "
"um welche Mittel es sich hierbei handelt.");

ARD("inschrift",
"Untersuchen reicht hier.");


AD("tod",
"Der Nebel umhuellt Dich totengleich.");


  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

  AddDetail( ({ "erde" }), 
    "Die Erde ist hier feucht und weich." );
  AddDetail("pfad",
    BS (
	"Hier kommt offensichtlich selten jemand vorbei, denn der "
	"Pfad ist fast komplett mit Moos ueberwachsen.\n"));
  AddDetail("moos",
    BS (
	"Dunkelgruenes Moos hat den Pfad ueberwachsen.\n"));
  AddDetail(({"nebelschwaden", "nebelschwade", "schwade", "schwaden", "nebel"}),
	    BS (
		"Die Nebelschwaden nehmen Dir die Sicht.\n"));
  AddDetail("sicht",
	    BS (
		"Du kannst wegen der Nebelschwaden nicht weit sehen.\n"));
  AddDetail("luft",
	    BS (
		"Die Luft ist kalt und feucht.\n"));
  AddDetail("umgebung",
	    BS (
		"Es ist so nebelig, dass Du nichts erkennen kannst.\n"));
  AddDetail("himmel",
	    BS(
	       "Den Himmel kannst Du vor lauter Nebelschwaden "
	       "nicht sehen.\n"));
  AddDetail("boden",
	    BS(
	       "Der Boden ist mit Moos ueberwachsen.\n"));
  AddSound(DEFAULT_SOUND,
	   "Es ist unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach feuchter Erde.\n");
AddSmell("erde",
"Die Erde ist hier sehr feucht.");


 AIT("/d/gebirge/dante/gruft/npc/vrat", REFRESH_DESTRUCT);


  AddExit("osten", "./platz");
  AddExit( "westen", "./pfad1");
  AddExit("norden", "/d/gebirge/gwenshara/festung/room/weg_1");
}


string show_text()  {
write(
"Im Gedenken an die Opfer Nosferatus und der Vampire. Wir vergessen Euch nie!\n\n");
	TP->more("/d/gebirge/dante/friedhof/log/text.lpc");
return "";	
}
