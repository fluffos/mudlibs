//
// Wohnraeume in der Pension vom Seelenfriedhor
// 2003 Iwo@SL
//

#pragma strong_types

#include <defines.h>
#include <moredef.h>
#include <properties.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Obergeschoss der 'Granitglocke'");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kleinen Gang im Obergeschoss "
    "der 'Granitglocke'. Hier hat der Besitzer einige Zimmer "
    "eingerichtet, um bei Bedarf Gaeste unterbringen zu koennen. "
    "Das schwummrige Licht einer Oel-Lampe taucht das ganze "
    "Stockwerk in ein mattes Gelb. Die Waende sind mit einem "
    "graesslichen Muster bemalt. Ein paar Tueren fuehren in die "
    "Zimmer der Gaeste. Ein kleine, hoelzerne Treppe fuehrt "
    "zurueck in die Bar. Ausserdem siehst du eine Leiter, die nach "
    "oben fuehrt.");

  AddDetail( ({ "gang" }),
    "Der Gang ist nicht sonderlich breit - gerade so, dass zwei "
    "Personen schoen aneinander vorbei kommen.");
  AddDetail( ({ "personen" }),
    "Tja, wenn welche hier sind, dann kannst Du sie sehen.");
  AddDetail( ({ "obergeschoss" }),
    "In dem befindest Du Dich.");
  AddDetail( ({ "granitglocke" }),
    "So heisst das Lokal hier.");
  AddDetail( ({"stockwerk", "lokal"}),
    "Du befindest Dich im oberen Stockwerk des Lokals 'Granitglocke'.");
  AddDetail( ({ "besitzer" }),
    "Vielleicht ist er ja in der Bar unten?");
  AddDetail( ({ "zimmer" }),
    "Die Zimmer hier kann man anmieten.");
  AddDetail( ({ "bedarf" }),
    "Brauchst Du ein Zimmer?");
  AddDetail( ({ "gaeste" }),
    "Du bist einer der Gaeste.");
  AddDetail( ({ "licht" }),
    "Das gelbliche Licht kommt von einer Oel-Lampe.");
  AddDetail( ({ "lampe", "oel-lampe" }),
    "Die kleine Lampe flackert froehlich vor sich hin, und "
    "taucht das Stockwerk in schwummriges, gelbes Licht.");
  AddDetail( ({ "waende", "wand", "farbe", "blumen", "muster" }),
    "Die Waende wurden mit ekliger, gelblicher Farbe gestrichen "
    "und mit riesigen, abscheulichen, braunen Blumen verziert.");
  AddDetail( ({ "tuer", "tueren" }),
    "Die Tueren sind aus dunklem Holz und fuehren in die Zimmer der "
    "Gaeste.");
  AddDetail( ({ "holz" }),
    "Das Holz ist dunkelbraun und wohl schon ziemlich alt.");
  AddDetail( ({ "bar" }),
    "Du koenntest runter gehen, und sie besuchen.");
  AddDetail( ({ "treppe" }),
    "Die klein, hoelzerne Treppe fuehrt nach unten in die Bar.");
  AddDetail( ({ "leiter" }),
    "Die kleine Leiter aus altem, dunkelbraunen Holz fuehrt durch ein "
    "kleines Loch in einen weiteren Raum oberhalb von dir.");
  AddDetail( ({ "loch" }),
    "Du passt wohl gerade noch durch.");
  AddDetail( ({ "raum" }),
    "Man kann auch Zimmer dazu sagen.");
  AddDetail( ({ "boden", "teppich" }),
    "Der Boden ist mit einem abscheulichem, braunen Teppich ausgelegt.");
  AddDetail( ({ "decke" }),
    "Die Decke ist schon ziemlich vergilbt.");
  AddSound(DEFAULT_SOUND, "Du hoerst etwas Laerm aus der Bar.");
  AddSmell(DEFAULT_SMELL, "Es riecht ein bisschen miefig hier."); 

  AddExit("unten", "./bar");

  //AddExit("sueden", "./wohn2");

SetProp( P_HIDE_EXITS, ({ "oben" }) );
}
