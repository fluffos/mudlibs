//dante sl 99

inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
#include <player.h>
#include <mnpc.h>

int gewischt;

#define PlayerGender this_player()->QueryProp(P_GENDER)

#define STAUB  (member(staub, getuid(this_player()))!=-1)
 string *staub=({});

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Eine Gruft");
  SetProp(P_INT_LONG, BS(
	"Es ist duester und unheimlich staubig in "
"dieser Gruft. So ziemlich alles hier scheint "
"aus dunkelgrauem Stein zu sein. In der Mitte "
"des Raumes siehst Du eine futuristisch "
	"anmutende, grosse Kapsel liegen.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail(({"Wand", "waende"}),
	    BS(
	       "Die Waende sind aus dunkelgrauem Stein.\n"));
	       
	     AD("idee",
"Eine gute Idee waere es, wenn Du Dir mal den Abdruck am Boden ansiehst.");
AD("abdruck",
"Er ist recht gross und sieht einem Fuss aehnlich.");
AD("fuss",
"Der Fuss muss gewaltig stark gewesen sein, um hier einen "
"Abdruck zu hinterlassen. Hmm, ob Du das auch kannst?! Probier es!");



	       
  AddDetail("decke",
	    BS(
	       "Genauso wie die Waende aus dunkelgrauem Stein.\n"));
  AddDetail("stein",
	    BS(
	       "Du hast nicht die geringste Idee, wo der Stein "
	       "herkommen koennte.\n"));
  AddDetail("boden",
	    BS(
	       "Du stehst darauf.\n"));
  AddDetail("mitte",
	    BS(
	       "In der Mitte des Raumes liegt eine grosse Kapsel.\n"));
  AddDetail("raum",
	    BS(
	       "Du bist tief unten in einer Gruft.\n"));
  AddDetail("gruft",
	    BS(
	       "Koennte es sein, das in einer Gruft jemand "
	       "begraben liegt?\n"));
  AddDetail("kapsel",
	    BS(
	       "Diese futuristisch aussehende Kapsel ist ueber "
	       "und ueber mit Staub bedeckt.\n"));
  AddDetail("staub",
	    BS(
	       "Du koenntest ja mal versuchen, den Staub "
	       "wegzuwischen.\n"));
	    
  AddSound(DEFAULT_SOUND,
	   "Es ist immer noch unheimlich still.\n");
  AddSmell(DEFAULT_SMELL,
	   "Die Luft ist etwas abgestanden.\n");
AddSmell("luft",
"Stickig.");

  AddExit( "rauf", "./gruft");
  
  AddCmd(({"wische","wischen", "wisch"}), "wische_staub");


AIT("/d/gebirge/dante/friedhof/npc/lringgeist", REFRESH_DESTRUCT);




  
 
ACD(({"hinterlasse","hinterlass"}), "get_f10");
}



int get_f10(string str)  {
	object ob;
	NF("Was willst Du hinterlassen?!\n");

if(str=="abdruck in boden"||str=="abdruck")  {
	
	
	
	if(!deep_present("H_BOX", TP))  {
write(BS(
"Du drueckst Deinen Fuss mit aller Gewalt in den Boden, bist "
"aber viel zu schwach."));
return 1; }

if(deep_present("GrauF", TP))  {
	
	write(BS(
"Du drueckst Deinen Fuss mit aller Gewalt in den Boden, bist "
"aber viel zu schwach."));

return 1; }


if(!STAUB)  {
	write(BS(
"Du willst schon einen Abdruck hinterlassen, doch dann stoert "
"Dich der viele Staub, der hier herumliegt!!!"));
return 1; }
	
	
	else  {
ob=CLONEOB(FO"f10");
ob->move(TP, M_NOCHECK);
write(BS(
"Du drueckst Deinen Fuss mit aller Gewalt in den Boden. "
"Es scheint so als ob Du wirklich einen Abdruck hinterlassen hast. "
"Nein, das war kein Abdruck, sondern eine Flasche, die da am "
"Boden herumlag. Du nimmst sie."));

return 1; }
return 0; }
return 0; }
		



wische_staub(string str)
{
  notify_fail("Was moechtest Du wegwischen?\n");
  if (str && (str=="staub weg"))
    {
      if (!STAUB)
	{
	  write(BS("Du ziehst den Aermel Deines Gewandes ueber das "
		   "Handgelenk und wischt auf der Kapsel rum. "
		   "Ah, jetzt kannst Du die Inschrift entziffern, die sich "
		   "auf ihr befindet. Du liest: \"Alle, die ihn kannten, "
		   "liebten ihn. Alle, die ihn liebten, kannten ihn. "
		   "Alle die ihn nicht kannten, verehrten ihn.\"\n"
		   "Sofort legt sich wieder eine Staubschicht ueber die Kapsel!"));
	  say(BS(TPN+ " zieht sich den Aermel "
		 +((this_player()->QueryProp(P_GENDER)==FEMALE)?"ihres":"seines")+
		 " Gewandes ueber das Hangelenk und wischt auf der "
		 "Kapsel rum. " + TPN + " beugt sich ueber die Kapsel und "
		 "scheint konzentiert etwas zu entziffern.\n"));
   staub +=({getuid(this_player())});
return 1;
	}
      else
	write("Aber Du hast den Staub doch bereits einmal weggewischt.\n");
return 1;
      }
  return 0;
}
