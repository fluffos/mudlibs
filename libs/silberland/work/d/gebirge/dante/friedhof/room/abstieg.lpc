//dante sl 99
inherit "std/room";

#include <properties.h>

#include "global.h"
#include <moving.h>
#include <player.h>
#include <language.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Unter der Aufbahrungshalle");
  SetProp(P_INT_LONG, BS(
  "Du steckst nun in einem kalten, dunklen Gang, der weiter in die "
  "Tiefe fuehrt. Sollst Du wirklich nach unten gehen? Ist das "
  "nicht zu gefaehrlich fuer Dich? Von der Aufbahrungshalle ueber "
  "Dir faellt etwas Licht durch das Mosaik herunter."));
  
  AD("gang",
  "Der unheimliche Gang fuehrt steil nach unten.");
  AD("tiefe",
  "Du weisst nicht wie weit es hier nach unten geht.");
  AD("mosaik",
  "Von unten betrachtet sieht das Mosaik sehr seltsam aus. "
  "Irgendwie aehnelt es einem Stern.");
  
  AD("stern",
  "Der Stern leuchtet hell. Zu hell! Schliesse Deine Augen!!!");
  AD(({"auge","augen"}),
  "Schliesse sie!");
  AD("decke",
  "Durch den Spalt in der Decke kommst Du wieder nach oben.");
  AD("licht",
  "Wenig, aber es reicht.");
  AD(({"wand","waende"}),
  "Die Waende sind kalt und blank.");
  AD(({"halle","aufbahrungshalle"}),
  "Die Halle ist direkt ueber Dir.");
  
  AD("spalt",
  "Der Spalt ist klein, aber man kommt durch.");
  
  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail("boden",
	    BS(
"Der Boden fuehrt steil nach unten."));
  AddSound(DEFAULT_SOUND,
	   "Du hoerst eigentlich nichts.\n");
  AddSmell(DEFAULT_SMELL,
	   "Es ist kuehl und trocken.\n");
  AddExit( "oben", "./aufbahr");
  AddExit( "unten", "/d/gebirge/dante/gruft/room/loch8");
ACD(({"schliesse","schliess"}), "get_f9");


}

int get_f9(string str)  {
	object ob;
	NF("Was willst Du schliessen?!\n");

if(str=="auge"||str=="augen")  {
	if(!deep_present("H_BOX", TP))  {
write(BS(
"Du schliesst die Augen. Na toll. Du oeffnest sie wieder."));
return 1; }

if(deep_present("BraunF", TP))  {
write(BS(

"Du schliesst die Augen. Na toll. Du oeffnest sie wieder."));	
	
return 1; }
	
	else  {
ob=CLONEOB(FO"f9");
ob->move(TP, M_NOCHECK);
write(BS(
"Du schliesst die Augen. Du oeffnest sie wieder und hast "
"ploetzlich eine Flasche in der Hand."));
return 1; }
return 0; }
return 0; }
		
init()  {
	::init();
if(interactive(TP)) {call_out("tag", 5); }}

tag()  {
	if(TO!=environment(TP)) return ;
	write(BSA(
	"Weiter unten sind sicher keine Flaschen mehr. Du "
	"musst also nicht weiter runter gehen, wenn Du die "
	"Flaschen suchst!",
"Humfrey teilt Dir mit: "));	
}
		