//dante sl 99
inherit "std/room";

#include <properties.h>
#include "/gilden/bardengilde/barden_extern.h"

#include "global.h"
#include <moving.h>
#include <player.h>
#include <language.h>
#include <mnpc.h>


#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  ::create();
  SetProp(P_INT_SHORT, "In der Aufbahrungshalle");
  SetProp(P_INT_LONG, BS(
"Dies ist die Aufbahrungshalle des Friedhofes. "
"Die Waende sind mit einer wunderschoenen, "
"weissen Marmorschicht bedeckt, goldene "
"Kerzenhalter sind daran befestigt. In den "
"Ecken stehen leere Blumenvasen mit fremdartigen "
"Mustern. Kleine, schmale Fenster nahe der Decke "
"lassen nur wenig Licht herein. Auf dem Boden "
"ist ein Mosaik.\n"));

AD("moment",
"Kurz.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  AddDetail(({"aufbahrungshalle", "halle"}),
	    BS(
"Hier werden Verstorbene aufgebahrt. Im Moment ist sie "
"allerdings leer.\n"));

AD(({"verstorbene","verstorbener"}),
"Ob Du auch mal hier liegst.");
ASD("du", "wer");

  AddDetail("friedhof",
	    BS(
"Du befindest Dich immer noch auf dem Friedhofsgebiet.\n"));
  AddDetail(({"gebiet","friedhofsgebiet"}),
	    BS(
	       "Ein Friedhof.\n"));
  AddDetail(({"marmorschicht", "marmor", "schicht"}),
	    BS(
	       "Wunderschoen gemusterter Marmor - Du hast "
	       "Dich schon immer gefragt, wie sowas aussieht.\n"));
  AddSpecialDetail(({"kerzenhalter", "halter"}), "det_kerzenhalter");
  AddSpecialDetail(({"kerzen", "kerze"}), "det_kerzen");
  AddDetail(({"blumenvasen", "blumenvase", "vasen", "vase"}),
	    BS(
	       "Grosse, leere Blumenvasen stehen in den Ecken.\n"));
  AddDetail(({"ecken", "ecke"}),
	    BS(
	       "In den Ecken stehen Blumenvasen.\n"));
  AddDetail("muster",
	    BS(
	       "Auf den Vasen ist ein fremdartig wirkendes Muster. "
	       "Vielleicht spaete Dantedynastie?\n"));
	       
AD(({"dynastie","dantedynastie"}),
"Du kennst Dich da nicht aus, aber sie wirkt sehr seltsam. "
"Ob man nicht versuchen sollte hineinzugreifen?!");

/*

greifen in vase 


*/
	       
  AddDetail("fenster",
	    BS(
	       "Die Fenster sind sehr klein, deswegen lassen sie "
	       "wenig Licht herein.\n"));
  AddDetail("licht",
	    BS(
	       "Davon gibt es hier sehr wenig.\n"));
  AddDetail("decke",
	    BS(
	       "Hoch und weiss gestrichen.\n"));
  AddDetail("boden",
	    BS(
	       "Der Boden ist mit einem Mosaik bedeckt.\n"));
  AddDetail("mosaik",
	    BS(
	       "Das Mosaik bedeckt den groessten Teil des Bodens. "
	       "Im hinteren Teil der Halle allerdings scheint es "
	       "unterbrochen zu sein.\n"));
  AddDetail("teil",
	    BS(
	       "Du untersuchst den hinteren Teil der Halle genauer. "
	       "Der wunderschoene Boden wird hier von einer "
	       "Glasscheibe unterbrochen, die in den Boden eingelassen "
	       "ist.\n"));
  AddDetail(({"glasscheibe","glas", "scheibe"}),
	    BS(
	       "Das Glas ist spiegelblank geputzt, doch darunter ist "
	       "es so dunkel, dass Du nicht hindurchschauen kannst. "
	       "Du bemerkst allerdings, dass die Scheibe nicht exakt "
	       "in ihrer Halterung liegt - Du siehst einen kleinen "
	       "Spalt, den sie freilaesst.\n"));
  AddDetail("halterung",
	    BS(
	       "Damit ist die Glasscheibe im Boden festgemacht.\n"));

AIT(FO"tafel", REFRESH_REMOVE);


AIT("/d/gebirge/dante/gruft/npc/vrat", REFRESH_DESTRUCT, 
([P_MNPC_FLAGS: MOV_MOVES]));


//AIT("/d/unterwelt/dante/skel/skel", REFRESH_DESTRUCT,
//([P_MNPC_FLAGS: MOV_MOVES]));  
 
  AddDetail("spalt",
	    BS(
	       "Wenn Du Deinen Bauch ganz stark einziehst, koenntest "
	       "Du unter Umstaenden hindurchklettern.\n"));
ASD(({"bauch","umstaenden","umstaende"}), "gewicht");	       


  AddDetail(({"wand", "waende"}),
	    BS(
	       "Marmor und Kerzenhalter.\n"));
  AddSound(DEFAULT_SOUND,
	   "Stille.\n");
  AddSmell(DEFAULT_SMELL,
	   "Es ist kuehl und trocken.\n");
  AddExit( "norden", "./soldfried");

  AddCmd(({"klettere", "kletter", "klettern"}), "kletter_spalt");

  ACD(({"greif","greife","greifen"}), "get_f5");

  AddCmd( ({"nimm", "nehme"}), "cmd_bard_kerzen");
}

public int cmd_bard_kerzen(string str) {
	if(TP->QueryProp(P_GUILD) == "bardengilde" && 
	   call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_ALESTRA &&
	   TP->QuerySkill("haette ich ein herz") == 0) {
		if(TP->QueryProp(P_GUILD))
		if(str != "kerze" && 
		str != "kerze aus leuchter" &&
		str != "kerze aus kerzenleuchter") return 0;

		write(BS("Gerade als du eine Kerze nehmen willst, springt ein Schatten hervor und reisst dir "
				"die Kerze aus der Hand! Nach kurzem Gerangel entkommt dir der Schatten und verschwindt "
				"unter dem Mosaik! Es muss sich um einen der verfluchten Vampire handeln!!!"));
		return 1;
	}
	return 0;
}

public string det_kerzenhalter() {
	string str;
	str = "Die goldenen Kerzenhalter duerften sehr wertvoll sein.\n";
	if(TP->QueryProp(P_GUILD) == "bardengilde" && 
	   call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_ALESTRA &&
	   TP->QuerySkill("haette ich ein herz") == 0) {
		   str += " Rote Kerzen stecken im Kerzenleuchter.\n";
	}
	return str;
}

public string det_kerzen() {
	if(TP->QueryProp(P_GUILD) == "bardengilde" && 
	   call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_ALESTRA &&
	   TP->QuerySkill("haette ich ein herz") == 0) {
		return "Die roten Kerzen sehen genau aus, wie solche, die die kleine Hexe Larva sucht. "
		       "Vielleicht solltest du sie dir einfach nehmen?\n";
	} else {
		return "Momentan sind keine Kerzen in den Haltern.\n";
	}
}

int get_f5(string str)  {
	object ob;
	NF("Wo willst Du reingreifen?!\n");

if(str=="in vase"||str=="in vase hinein")  {
	if(!deep_present("H_BOX", TP))  {
write(BS(
"Du greifst in die Vase, doch die Vase ist leer."));
return 1; }

if(deep_present("ViolettF", TP))  {
	
	write(BS(
"Du greifst in die Vase, doch die Vase ist leer."));
return 1; }
	
	else  {
ob=CLONEOB(FO"f5");
ob->move(TP, M_NOCHECK);
write(BS(
"Du greifst in die Vase und findest eine Flasche!"));
return 1; }
return 0; }
return 0; }
		
	
				
string gewicht()  {
	int ge, to;
ge=TP->QP(P_WEIGHT);
to=TP->QP(P_TOTAL_WEIGHT);	
	return BS(
"Immerhin wiegst Du momentan "+ge/1000+" kg ohne Ausruestung "
"und "+to/1000+" kg mit.");
}
	

string wer()  {
	return (BS(
"Das ist meistens "+TP->QP(P_PRESAY)+""+TPN+" "+TP->QP(P_TITLE)+"!")); 
}

init()  {
	::init();
	if(interactive(TP)) {
	call_out("tag", 5);  }}
	
	tag()  {
		if(environment(TP)!=TO) return;
	if(!random(2))  {
	write(BS(
"Das Mosaik am Boden fasziniert Dich."));  }   }
			

kletter_spalt(string str)
{
  notify_fail("Wodurch willst Du klettern?\n");

  if (str=="durch spalt" ||str=="runter"||str=="nach unten")  {
    
      write(BS("Du ziehst Deinen Bauch ein und zwaengst Dich "
	       "muehselig durch den Spalt.\n"));
      TP->move(FR"abstieg", M_GO,"sich durch einen Spalt", "zwaengt" ,
      "kommt herein");
      return 1;
      }
  return 0;
}