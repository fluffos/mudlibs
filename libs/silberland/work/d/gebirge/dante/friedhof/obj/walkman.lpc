//dante &wuschel sl 99
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

int walkman_auf;
int song_count;
int song_act;
string *song_list;

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  walkman_auf=0;
  AddId ("walkman");
  SetProp (P_SHORT, "Ein Walkman");
  SetProp (P_LONG, (BS ("Mit einem Walkman kann man Musik hoeren. Du koenntest "
	   "versuchen, den Walkman aufzusetzen und ihn dann einzuschalten.\n")));
  SetProp (P_NAME, "Walkman");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 250);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_METAL);
  song_count=10;
  song_list=allocate (song_count);
  song_list[0]="die Titelmelodie von StarTrek";
  song_list[1]="An der Nordseekueste";
  song_list[2]="Humba, Humba, Taetaerae";
  song_list[3]="Haenschen klein";
  song_list[4]="Highway to hell";
  song_list[5]="Fuer Elise";
  song_list[6]="Eine kleine Nachtmusik";
  song_list[7]="Should I stay or should I go";
  song_list[8]="Ich gehe mit meiner Laterne";
  song_list[9]="Always look on the bright side of life";
  song_act=random(song_count);

   AddCmd ("setze", "setze_walkman"); 
   AddCmd ("schalte", "schalte_walkman");
}

string extra_look()
{
  if (walkman_auf)
    {
      if (environment()->QueryProp(P_GENDER)==FEMALE)
	return BS ("Sie hat Kopfhoerer auf den Ohren.\n");
      else
	return BS ("Er hat Kopfhoerer auf den Ohren.\n");
    }
}

setze_walkman (string str)
{
  int result;
  result = 0;
  if (str && str=="walkman auf")
    {
      if (!walkman_auf)
	{
	  write (BS ("Du nimmst die Kopfhoerer Deines Walkmans und setzt sie Dir "
		     "auf den Kopf.\n"));
	  say (BS (TPN+ " nimmt die Kopfhoerer "
		   + (PlayerGender == FEMALE ? "ihres" : "seines") + " Walkmans "
		   "und setzt sie auf den Kopf.\n"));
	  walkman_auf=1;
	}
      else
	write (BS ("Du hast den Walkman doch schon auf.\n"));
      result = 1;
    }
  else if (str && str=="walkman ab")
    {
      if (walkman_auf)
	{
	  write (BS ("Du nimmst die Kopfhoerer Deines Walkmans ab.\n"));
	  say (BS (TPN+ " nimmt die Kopfhoerer "
		   + (PlayerGender == FEMALE ? "ihres" : "seines") + " Walkmans "
		   "und setzt sie ab.\n"));
	  walkman_auf=0;
	}
      else
	write (BS ("Du hast den Walkman gar nicht auf.\n"));
      result = 1;
    }
  return result;
}

schalte_walkman (string str)
{
  int result;
  result=0;
  if (str && str=="walkman ein")
    {
      if (walkman_auf)
	{
	  song_act=random(song_count);
	  write (BS ("Du schaltest Deinen Walkman ein und hoerst "
		    + song_list[song_act]+".\n"));
	  say(BS (TPN+" schaltet "+ (PlayerGender == FEMALE ? "ihren" : "seinen")+
		  " Walkman ein. Aus den Kopfhoerern klingt leise die Melodie von "
		  + song_list[song_act]+".\n"));
	}
      else
	write("Du musst den Walkman zuerst aufsetzen.\n");
      result=1;
    }
  return result;
}
