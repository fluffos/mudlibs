//dante sl 99

inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({"stinkblaeschen", "blase", "blaeschen"}));
  SetProp (P_SHORT, "Ein Stinkblaeschen");
  SetProp (P_LONG, BS ("Dieses Stinkblaeschen ist ekelhaft wabbelig und "
        "glibberig. Was wird wohl passiern, wenn Du es wirfst?\n"));
  SetProp (P_NAME, "Stinkblaeschen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 50);
  SetProp (P_NOBUY, 1);
  SP(P_MATERIAL, ([MAT_MISC_DEAD:100]));
  AddCmd ("wirf", "wirf_blase");
}

wirf_blase (string str)
{
  int result;
  result = 0;
  notify_fail ("Was willst Du denn werfen?\n");
  if (str && id(str))
  {   
    write (BS("Du wirfst ein Stinkblaeschen. Das Blaeschen platzt mit "
          "einem schmatzenden Geraeusch auf. Sofort verbreitet sich "
          "ein unertraeglicher Gestank. Dir wird schlecht.\n"));
    say (BS(TPN+ " wirft ein Stinkblaeschen. Das Blaeschen platzt mit "
          "einem schmatzenden Geraeusch auf. Sofort verbreitet sich "
          "ein unertraeglicher Gestank. Dir wird schlecht.\n"));
    remove();
    result=1;
  }
  return result;
}
