//dante sl 99
inherit "std/thing";

#include <moving.h>
#include <properties.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 1);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, FEMALE);
	SetProp(P_NOGET, 1);
	SetProp (P_SHORT, "Eine Seele");
	SetProp (P_LONG, BS(
			    "Die Seele wird von einem uebernatuerlich "
			    "schoenen Strahlen umgeben. Sie ist so zart und "
			    "durchscheinend, dass Du Dich fast nicht traust, "
			    "sie anzufassen.\n"));
	SetProp (P_NAME, "Seele");

	AddId ("seele");
	AddDetail("strahlen",
		  BS(
		     "Ein weisses Strahlen huellt die Seele ein.\n"));
SP(P_MATERIAL, ([MAT_MISC_MAGIC: 100]));

	AddCmd("nimm","nimm_seele");
	AddCmd("fasse","fasse_seele");
}

nimm_seele(string str)
{
  int result;
  result=0;
  notify_fail("Was moechtest Du nehmen?\n");
  if (str && id(str))
    {    
      write (BS("Du versuchst, ganz vorsichtig nach der Seele zu "
		"greifen. In dem Moment, als Du sie beruehren willst, "
		"erlischt das Strahlen und die Seele ist verschwunden.\n"));
      say (BS(TPN+ " versucht, ganz vorsichtig nach der Seele zu "
	      "greifen. In dem Moment, als" + TPN + " sie beruehren "
	      "will, erlischt das Strahlen und die Seele ist verschwunden.\n"));
      remove ();
	result=1;
    }
  return result;
}

fasse_seele(string str)
{
  int result;
  result=0;
  notify_fail("Was moechtest Du anfassen?\n");
  if (str && str=="seele an")
    {    
      write (BS("Du versuchst, ganz vorsichtig nach der Seele zu "
		"greifen. In dem Moment, als Du sie beruehren willst, "
		"erlischt das Strahlen und die Seele ist verschwunden.\n"));
      say (BS(TPN+ " versucht, ganz vorsichtig nach der Seele zu "
	      "greifen. In dem Moment, als" + TPN + " sie beruehren "
	      "will, erlischt das Strahlen und die Seele ist verschwunden.\n"));
      remove ();
	result=1;
    }
  return result;
}


































