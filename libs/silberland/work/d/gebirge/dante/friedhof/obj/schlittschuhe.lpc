inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>

#include "global.h"


#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"schlittschuhe", "schuhe"}));
  SetProp (P_SHORT, "Ein Paar Schlittschuhe");
  SetProp (P_LONG, (BS ("Es handelt sich hierbei um ein Paar alte Schlittschuhe. "
	   "Die Kufen sind schon etwas rostig, nichtsdestotrotz kann man "
           "sie sicher noch benutzen.\n")));
  SetProp (P_NAME,({"die Schlittschuhe", "der Schlittschuhe", "den Schlittschuhen",
		      "die Schlittschuhe"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 400);
  SetProp (P_NOBUY, 0);
  SetProp (P_ARTICLE, 0);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);

  AddDetail(({"kufen", "kufe"}),
	    BS(
	       "Die Kufen sind schon ein bisschen "
	       "rostig.\n"));
SP(P_MATERIAL, ([MAT_MAGIC:100]));
}







