//dante sl
inherit "std/thing";

#include <moving.h>
#include <properties.h>

#include "global.h"
#include <player.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)
int da=2;

reset()  {
	::reset();
	da=2; }
	
create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 2000000);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, MALE);
	SetProp(P_NOGET, 1);
	SetProp (P_SHORT, "Ein Kuerbis");
	SetProp (P_LONG, BS(
			    "Der Kuerbis scheint Dich irgendwie magisch "
			    "anzuziehen. Er ist von einer feinen "
			    "Kristallschicht umgeben und glitzert "
			    "geheimnisvoll.\n"));
	SetProp (P_NAME, "Kuerbis");
SP(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
	AddId ("kuerbis");
	AddDetail(({"kristallschicht","schicht"}),
		  BS(
		     "Die Kristallschicht umgibt den Kuerbis. Sie ist "
		     "hauchduenn und ganz glatt - allerdings glaubst Du, "
		     "eine kleine Unebenheit erkennen zu koennen.\n"));
	AddDetail("unebenheit",
		  BS(
		     "Du gehst ganz nah an den Kuerbis heran und schaust "
		     "genau. Ah, Du kannst ein kleines Loch in der "
		     "Kristallschicht erkennen. Dir wird ein wenig "
		     "schwindlig.\n"));

AD("loch", "Betrachte das Loch doch!!!");
ACD(({"betrachte","betracht"}), "schau_loch");
}



schau_loch(string str)
{
  object ob;

 

  notify_fail("Was willst Du denn anschauen?\n");
  if (str=="loch") {
  	
    if(da) {
    	
    	
    	if(deep_present("schalk", TP))  {
    		write(BS(
    		"Dein Schalk lacht Dich nur aus und tritt Dich dann!!!"));
    		say(BS(
    		"Wird vom Schalk getreten!"));
    		return 1; }
    	if(present("schalk", environment(TP)))  {
    		write(BS(
    		"Der Schalk lacht Dich aus und deutet Dir, das Du ihn nehmen sollst!"));
    		say(BS(
    		"Der Schalk will unbedingt, dass "+TPN+" ihn nimmt!"));
    		return 1; }
    			
    	else
    	
    	
    	
    	 ob=CLONEOB(FO"schalk");
      write(BS("Du schaust in das kleine Loch auf der Vorderseite des "
	       "Kuerbisses. Ploetzlich dreht sich alles um Dich und Du "
	       "merkst, dass Du nicht mehr wegschauen kannst. Du bist "
	       "einem Hypnokuerbis in die Falle gegangen! Du hast "
	       "das Gefuehl, dass Dich kalte Haende packen und in die "
	       "Tiefe ziehen. Dir wird schwarz vor Augen und "
	       "ploetzlich liegt eine Puppe vor Dir."));
	       ob->move(environment(TP), M_NOCHECK);
      da--;
      return 1;
    }

    if(!da)  {
      write(BS("Du schaust Dir das kleine Loch an, doch nichts passiert. "
               "Komm etwas spaeter wieder. Es lohnt sich immer!!!"));
      return 1;
    } 
  
  return 0;
}
return 0; }
