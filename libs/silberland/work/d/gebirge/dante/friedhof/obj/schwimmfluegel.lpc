//dante wuschel
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"schwimmfluegel", "fluegel"}));
  SetProp (P_SHORT, "gelb-rot-gepunktete Schwimmfluegel");
  SetProp (P_LONG, (BS ("Diese Schwimmfluegel sind wirklich niedlich, "
			"sowas hast Du seit Deiner Kleinkinderzeit nicht "
			"mehr gesehen. Sie sind gelb-rot gepunktet, aus "
			"Gummi und sogar schon aufgeblasen - also fertig "
			"zum Gebrauch!\n")));
  SetProp (P_NAME,({"die Schwimmfluegel", "der Schwimmfluegel", "den Schwimmfluegeln",
		      "die Schwimmfluegel"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 80);
  SetProp (P_VALUE, 150);
  SetProp (P_NOBUY, 0);
  SetProp (P_ARTICLE, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
SP(P_MATERIAL, ([MAT_MAGIC:100]));
}



