//dante sl
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

create()

{ 
   if (!is_clone(this_object())) return;

   ::create();

   AddId ("tafel");
   SetProp(P_SHORT, "Eine Tafel");
   SetProp(P_LONG, BS(
                   "Auf dieser Tafel scheint etwas geschrieben zu stehen. "
		   "Am Besten, Du liest sie einfach mal.\n ")
           );
   SetProp(P_NAME, "Tafel");
   SetProp(P_GENDER, FEMALE);
   SetProp(P_WEIGHT, 500);
   SetProp(P_VALUE, 0);
   SetProp(P_NOGET, 1);
   AddCmd ("lies", "lies_tafel");
SP(P_MATERIAL, ([MAT_OAK:100]));
}

lies_tafel (string str)
{
  int result;
  result=0;
  notify_fail("Was moechtest Du lesen?\n");
  if(str && id(str))
    {
      write("Auf der Tafel steht geschrieben:\n"
      "In dieser Halle werden all diejenigen aufgebahrt die den\n"
      "Vampiren, Vampirghulen, Drachen, Zombies, Daemonen und all\n"
      "den anderen Kreaturen der Finsternis zum Opfer fallen.\n"
      "Friede ihren Seelen und moege der Tod gnaedig gewesen sein!\n");
      
          
      result=1;
    }
  return result;
}
