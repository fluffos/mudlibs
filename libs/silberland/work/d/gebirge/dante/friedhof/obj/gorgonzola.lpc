//dante sl 99

inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 0);
  SetProp(P_GENDER, MALE);
  SetProp (P_SHORT, "Ein Gorgonzola");
  SetProp (P_LONG, BS( "Es handelt sich hierbei um einen "
        "ausserst seltenen Kaese, den nur die Gorgone "
        "mit ihrem alles versteinernden Blick herstellen "
        "kann. Wahrhaftig, ein richtiges Schmankerl!\n"));
  SetProp (P_NAME, "Gorgonzola");

  AddId (({"gorgonzola"}));
  SP(P_MATERIAL, ([MAT_MISC_FOOD:100]));

  AddCmd(({"essen","iss"}), "iss_torte");
}

int iss_torte (string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if ( str && id(str))
  {
    write (BS("Du isst den Gorgonzola. Ein sehr "
          "eingenwilliger Geschmack, aber Gourmets wissen "
          "ihn vielleicht zu schaetzen.\n"));
    say (BS(TPN+ " isst einen Gorgonzola.\n"));
    remove();
    return 1;
  }
  return 0;
}
