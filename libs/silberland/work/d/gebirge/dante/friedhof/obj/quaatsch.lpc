//dante sl 99 wuschel
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

create()

{ 
   if (!is_clone(this_object())) return;

   ::create();

   AddId (({"quaatsch", "stoffente","ente"}));
   SetProp(P_SHORT, "Eine Stoffente namens Quaatsch");
   SetProp(P_LONG, BS(
                   "Du kannst es gar nicht fassen, wie suess diese Ente ist. "
		   "Sie heisst Quaatsch und gehoert Wuschel. "
                   "Quaatschens Haare stehen wild von seinem Kopf ab und "
		   "sehen so aus, als kitzeln sie, wenn man mit "
                   "ihnen in Beruehrung kommt. Der Koerper der Ente ist "
		   "gaaaaaaanz weich.\n"
                     )
           );
   SetProp(P_NAME, "Quaatsch");
   SetProp(P_GENDER, MALE);
   SetProp(P_WEIGHT, 200);
   SetProp(P_VALUE, 1000);
   SetProp(P_NOBUY, 0);
SP(P_MATERIAL, ([MAT_COTTON:100]));
   AddCmd (({"kuschel", "kuschle"}), "kuschel_quaatsch");
   AddCmd (({"streichel", "streichle"}), "streichel_quaatsch");
   AddCmd (({"wuschel", "wuschle"}), "wuschel_quaatsch");
   AddCmd (({"knuddel", "knuddle"}), "knuddel_quaatsch"); 
}

kuschel_quaatsch (string str)
{
  notify_fail ("Womit moechtest Du denn kuscheln?");
  if (str && id (str)) {
    write (BS("Du drueckst die Stoffente begeistert an Dich. Aber "
	      "nicht zu fest, sonst wird Quaatsch boese!\n"));
    say (BS(this_player()->name(WER,2)+" drueckt "
	    "die Stoffente begeistert an sich. Quaatsch laechelt - "
	    "sofern man das mit einem Schnabel kann.\n"));
    return 1;
  };
  return 0;  
}

streichel_quaatsch (string str)
{
  notify_fail ("Was willst Du denn streicheln?");
  if (str && id (str)) {
    write (BS("Du streichelst Quaatsch vorsichtig. Es macht den Eindruck, "
	      "als wollte er lieber mit Dir kuscheln.\n"));
    say (BS(this_player()->name(WER,2)+" streichelt "
	    "Quaatsch. Die Ente macht den Eindruck, als wuerde sie lieber mit "
	    +(this_player()->name(WER,2))+" kuscheln.\n"));
    return 1;
  };
  return 0;
}

wuschel_quaatsch (string str)
{
  notify_fail ("Wen willst Du wuscheln?");
  if (str && id (str)) {
    write (BS("Du wuschelst Quaatsch durch seine Haare. Er ist etwas pikiert, "
	      "weil Du ihm seine Frisur zerstoert hast.\n"));
    say (BS(this_player()->name(WER,2)+" wuschelt "
	    "Quaatsch. Die Ente ist etwas pikiert, weil "
	    +(this_player()->name(WER,2))+" ihre Frisur zerstoert hat.\n"));
    return 1;
  };
  return 0;

}

knuddel_quaatsch (string str)
{
  notify_fail ("Wen willst Du denn knuddeln?");
  if (str && id (str)) {
    write (BS("Du nimmst die Ente in Deine Arme und knuddelst sie so richtig durch. "
	      "Quaatsch japst nach Luft.\n"));
    say (BS(this_player()->name(WER,2)+" nimmt die Ente in "+
	    ((this_player()->QueryProp(P_GENDER)==FEMALE)?"ihre":"seine")+
	    " Arme und knuddelt sie so richtig durch. Quaatsch japst nach Luft.\n"));
    return 1;
  };
  return 0;

}

