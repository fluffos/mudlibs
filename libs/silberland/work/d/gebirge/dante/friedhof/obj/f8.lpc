//dante sl 98 wuschel
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"
string c="tuerkis";

create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 15);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, FEMALE);
        SP(P_NAME_ADJ, ""+c+"");
	SetProp (P_SHORT, "Eine "+c+"e Flasche");
        SP(P_LONG, BS(
"Das ist eine der kleinen Flaschen die Humfrey benoetigt um "
"Wynnes Seele wieder zu bekommen. Diese hier ist "+c+"."));
	SetProp (P_NAME, "Flasche");

	AddId (({""+c+"e flasche", "flasche", ""+CAP(c)+"F"}));
	SP(P_MATERIAL, ([MAT_MISC_MAGIC:50, MAT_GLASS:20, MAT_MISC_FLUID:30]));
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
SP(P_AUTOLOADOBJ, 1);
}
