//dante wuschel sl 97 98 99
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "global.h"

int seele_drin;


create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 20);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, FEMALE);
	SetProp(P_NODROP, 1); 
	SetProp (P_SHORT, "Eine kleine Schachtel");
SP(P_LONG, "");
	SetProp (P_NAME, "Schachtel");
SP(P_MATERIAL, ([MAT_MAGIC:100]));
	AddId (({"schachtel", "musicbox", "box", "H_BOX"}));
	SP(P_NEVERDROP, 1);
	SP(P_AUTOLOADOBJ, 1);
	SP(P_MAGIC, 1);
	AddCmd("oeffne", "oeffne_schachtel");
}

oeffne_schachtel (string str)
{
  int result;
  result=0;
  notify_fail ("Was willst Du oeffnen?\n");
  if (str && id(str))
    {
      if (!seele_drin)
	{
 if (environment(this_player())==find_object(FR"tiefe"))
	    {
	      write(BS(
		       "Du oeffnest die Schachtel. Du kannst leise Soulmusic "
		       "hoeren und wippst im Takt mit. Ploetzlich siehst Du eine "
		       "strahlende Seele naeher kommen, die offensichtlich von "
		       "der Musik angelockt wird. Die Seele schwebt immer naeher "
		       "auf Dich zu und verschwindet schliesslich in der "
		       "Schachtel. Hurtig machst Du die Schachtel wieder zu, "
		       "damit die Seele nicht mehr hinaus kann.\n"));
	      seele_drin=1;
AddId("BOX_SOUL");
	      
	    }
	  else
	    write(BS(
		     "Du kannst die Schachtel hier nicht aufmachen. "
		     "Probier es doch mal woanders. Zum "
		     "Beispiel an einem Ort, der unter der Oberflaeche liegt "
		     "und geheimnissvoll ist und wo Staub liegt."));
		     
	}
      else
	write(BS(
		 "Du kannst die Schachtel nicht mehr aufmachen, "
		 "sonst fliegt die Seele wieder weg.\n"));
      result=1;
    }
  return result;
}




 _query_long()
{
  if (!seele_drin)
      return (BS("In diese Schachtel kann man eine Seele stecken. "
          " Besser gesagt, man muss sie fangen...\n"));
    
            else
    
    return (BS("In dieser Schachtel befindet sich eine Seele.\n"));
                }
                
