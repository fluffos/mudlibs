// dante sl wuschel
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "global.h"

int cry_count;
int cry_act;
string *cry_list;

int genommen;

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()

{ 
   if (!is_clone(this_object())) return;

   ::create();

   AddId ("schalk");
   SetProp(P_SHORT, "Ein Schalk");
   SetProp(P_LONG, BS(
                   "Verwundert schuettelst Du den Kopf - dass es sowas "
		   "ueberhaupt geben kann! Der Schalk sieht aus wie eine "
                   "kleine Holzpuppe, Arme und Beine sind mit winzigen "
		   "Oesen an dem hoelzernen Koerper befestigt. "
                   "Aufgemalte Augen, Nase, Mund und Haare aus gelber "
		   "Wolle wirken irgendwie selbstgebastelt. Ploetzlich "
		   "erschrickst Du - hat Dir der Schalk gerade etwa "
		   "zugezwinkert? Aber Puppen leben doch nicht!"
                     )
           );
   SetProp(P_NAME, "Schalk");
   SetProp(P_GENDER, MALE);
   SetProp(P_WEIGHT, 300);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_MATERIAL, MAT_WOOD);
   SetProp(P_NODROP, 1); 
   cry_count=9;
   SP(P_NEVERDROP, 1);
   cry_list=allocate (cry_count);
   cry_list[0]="Der Schalk verdreht die Augen und kichert.\n";
   cry_list[1]="Der Schalk lacht laut.\n";
   cry_list[2]="Der Schalk erzaehlt einen geschmacklosen Witz.\n";
   cry_list[3]="Der Schalk schreit: Humor ist, wenn man trotzdem lacht!\n";
   cry_list[4]="Der Schalk macht seltsame Gesten.\n";
   cry_list[5]="Der Schalk haelt sich vor Lachen den Bauch.\n";
   cry_list[6]="Der Schalk bombadiert Dich mit Limericks.\n";
   cry_list[7]="Der Schalk ruft: Mich wirst Du nie wieder los!\n";
   cry_list[8]="Der Schalk tritt wild um sich.\n";
   cry_act=random(cry_count);

   
   AddCmd(({"knuddel", "knuddle",
   "kuesse","kuess","druecke","drueck","umarme","umarm",
   "liebe","lieb","knutsche","knutsch",
   "streichel","streichle"}), "knuddel_schalk");
   AddCmd(({"tritt","trete"}), "tritt_schalk");
}

     




string extra_look()
{
  if (genommen)
     return BS ("Der Schalk sitzt "+ environment()->QueryPronoun(WEM)+
            " im Nacken.");
}



init()  {
	::init();
	 if(!environment(TO)) { remove(); }
	
	if(interactive(environment(TO)))  { 
        call_out("wegmit", 1);  }
}


wegmit()  {
	if(!interactive(environment(TO)))  { remove();  }

	if(deep_present("schalk 2", environment(TO)))  {
		tell_object(environment(TO), BS(
		"Der zweite Schalk vertraegt sich mit dem ersten nicht und "
		"springt sofort wieder weg!"));
	TO->move(environment(TP), M_GO);
      return ;
        }
        


	  write(BS("Du nimmst die Holzpuppe. Mit einem "
		   "triumphierenden Aufschrei krabbelt der "
		   "Schalk an Deinem Ruecken hoch, schlingt seine "
		   "hoelzernen Beine um Deinen Hals und krallt "
		   "sich in Deinen Haaren fest. Oh Gott, Dir "
		   "sitzt nun der Schalk im Nacken!\n"));
	  say(BS(TPN+ " nimmt die Holzpuppe. Mit einem "
		 "triumphierenden Aufschrei krabbelt der Schalk "
		 "an " +TPN+ "s Ruecken hoch, schlingt seine "
		 "hoelzernen Beine um "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+
		 " Hals und krallt sich in "+TP->QueryPossPronoun(FEMALE,WEM,PLURAL)+
		 " Haaren fest. Oh Gott, " +TPN+ " sitzt nun der "
		 "Schalk im Nacken!\n"));
	  call_out("aergern", 2+random(5));  		
       }








knuddel_schalk(string str)
{
  
  notify_fail("Wen willst Du denn knuddeln?\n");
  if (str && id(str))
        {
      
	
	  write(BS("Du hast den Schalk ja so gerne! "
		   "Zufrieden ruft er: Bei Dir will ich immer "
		   "bleiben!\n"));
	  say(BS(TPN+ " knuddelt den Schalk aufs Herzlichste. "
		 "Zufrieden ruft der Schalk: Bei " +TPN+ " will "
		 "ich immer bleiben!\n"));
return 1;
	      }
      } 
     
     
     
     
     
     

tritt_schalk(string str)
{
  int result;
  result=0;
  notify_fail("Was oder wen willst Du denn treten?\n");
  if (str && id(str))
    {
      if(environment(TO)==TP)
	{
	  write(BS("Du trittst aergerlich nach dem Schalk. "
		   "Eine wahrhaft akrobatische Meisterleistung, "
		   "wenn man bedenkt, dass er Dir im Nacken sitzt. "
		   "Der Schalk schreit veraergert auf, zieht noch "
		   "einmal an Deinen Haaren und verschwindet.\n"));
	  say(BS(TPN+ " tritt den Schalk. Eine wahrhaft akrobatische "
		 "Meisterleisung, wenn man bedenkt, dass er in "
		 +TPN+ "s Nacken sitzt. Der Schalk schreit veraergert "
		 "auf, zieht noch einmal an " +TPN+ "s Haaren "
		 "und verschwindet.\n"));
	  remove();
	}
      else
	{
	  write(BS("Du trittst den Schalk. Er scheint Dir einen "
		   "bitterboesen Blick zuzuwerfen und springt dann auf Dich zu.\n"));
		    say(BS(TPN+ " tritt den Schalk. Dieser scheint " +TPN+ " einen "
		 "bitterboesen Blick zuzuwerfen.\n"));
	TO->move(TP, M_NOCHECK);
	}
      result=1;
    }
  return result;
}


void aergern()
{
  tell_object(environment(), cry_list[random(cry_count)] );
  call_out("aergern", 2+random(5) );
}


void remove()
{
  while( remove_call_out("aergern")!=-1 ) ;
  ::remove();
}
