inherit "std/food";
#include <properties.h>
#include <moving.h>
#include <food.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

string opfer="";
string taeter="";
set_opfer(string wem, string wer);
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SP(P_PLURAL, 2);
  SP(P_NAME, "Ohren");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT, 1);
  AddId  (({"ohren", "ohr"}));
  SP(P_MATERIAL, ([MAT_MISC_DEAD:100]));
 SetProp(P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 1, F_ALCOHOL: 0,F_POISON: 0]));
SP(P_ARTICLE, 1);
ACD("test123", "test123");
}

 _query_short()  {
	return BS(
	"Die abgeschnittene Ohren von "+CAP(opfer)+"");
        }
 
  _query_long()   {

       return BS( 
  "Das sind die abgeschnittenen Ohren von "+CAP(opfer)+". "+CAP(taeter)+" "
  "hat sie mit einem Rasiermesser einfach abgetrennt.");
      }

int test123()  {
	write(" opfer "+opfer+"  taeter "+taeter+"\n");
	return 1;  }


set_opfer(string wem, string wer)  {
  opfer=wem;
 taeter=wer; 
 
   }
 
		

BeimEssen()  {
write(BS(
"Du verschlingst die Ohren mit einem Bissen!!! Lecker!"));
say(BS(CAP_TPN+" verschlingt zwei Ohren mit einem Bissen und schaut dann angeekelt drein!"));
return::BeimEssen();   }
	
	
reset()  {
	::reset();
	write(QueryProp(P_SHORT)+" verfaulen gaenzlich...\n");	
	remove();
	}