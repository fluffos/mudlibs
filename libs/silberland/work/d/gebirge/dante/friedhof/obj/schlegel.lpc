//dante sl

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../global.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein schwerer Schlegel");
  SetProp(P_LONG,BS(
"Dieser Schlegel gehoert zur Granitglocke! Mit ihm kann man sie schlagen."));

  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,2000);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schlegel");
  SetProp(P_MATERIAL, ([MAT_IRON:100]));
  
  AddId(({"schlegel"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  SP(P_NAME_ADJ, "schwer");

}

