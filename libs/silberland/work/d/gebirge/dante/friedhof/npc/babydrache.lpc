/*
basierend auf stahldorns babydrachen

nur etwas gemeiner:-)  


*/

inherit "std/mnpc";

#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

#define SCHUPPENPATH "/p/std/dragons/obj/"

void create()
{
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein niedlicher Babydrache");
  SetProp(P_LONG, BS(
    "Der kleine Babydrache sieht Dich lieb und treuherzig aus grossen "
    "runden Kulleraugen heraus an. Alles an ihm scheint zu sagen: "
    "'Tu mir nichts!' Der Babydrache ist erst ein paar Monate alt. "
    "Das merkst Du an seiner laecherlich geringen Groesse und daran, "
    "dass er noch nicht ganz stubenrein zu sein scheint. Wie dieses "
    "suesse Ding wohl hier herkommt? Na, seine Mama ist sicher in der Naehe "
    "und besorgt grad Futter fuer den Kleinen. Worauf Du Gift nehmen kannst."));
    
  SetProp (P_NAME, "Babydrache");
  SetProp(P_GENDER, MALE);
  AddId(({ "drache", "babydrache", "baby", "NOWIMPY" }));
  create_default_npc(15);
  SetProp(P_NAME_ADJ, "niedlich");
  
  SetProp(P_HANDS, ({" mit Drachenzaehnchen", 110, 
      ({ DT_PIERCE }) }));
  SetProp(P_XP, QueryProp(P_XP) + 15000 );
  SetProp(P_RACE, "Drache" );
  SetProp(P_SIZE, 150 + random(20));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_DIE_MSG,  " quiekt noch einmal und verendet dann.\n");



  SetProp(P_MSGIN, "kommt froehlich herein");
  SetProp(P_MSGOUT, "taenzelt grinsend");
  SetProp(P_MMSGIN, "fliegt singend hierher");
  SetProp(P_MMSGOUT, "fliegt schnell weiter");
  SetProp(P_MNPC_AREA, ("/d/gebirge/dante/friedhof/room"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({10, 10, 10}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/gebirge/dante/friedhof/room/babayhoehle");

  SetProp(P_SPELLRATE, 40);
  
  AddSpell(2,170,
    "Der Babydrache spuckt ein wenig Feuer auf Dich.\n",
    "Der Babydrache spuckt ein bisschen Feuer auf @WEN.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE: 1]) );

  AddSpell(1,270,
    "Der Babydrache schnauft eine kleine Giftwolke.\n",
    "Der Babydrache huellt @WEN in ein Giftwoelkchen ein.\n",
     DT_POISON, ([SP_SHOW_DAMAGE: 1]) );

  SUID;
  ob=clone_object(SCHUPPENPATH "schuppe");
  ob->move(TO);
  ob->AddAmount(random(3)); //kommt die boese mama und die sperrt randommaessig die exits:-))) dante
  
}




void die(int arg)
{
  object mama;
  if(!interactive(TP))  {
    return ;  }

  if(interactive(TP))  {

    if(!present("mamadrache", environment(TO)))  {
      mama=clone_object("/d/gebirge/dante/friedhof/npc/drachenmutter");
      mama->move(environment(TP), M_TPORT+M_NOCHECK);
      mama->AddKiller(TP);	
      TP->AddPursuer(mama);
    }
  }
  ::die(arg);
}

