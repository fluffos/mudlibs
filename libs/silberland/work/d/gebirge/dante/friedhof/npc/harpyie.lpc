//dante sl
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "global.h"

create()
{ 
  object ob;

  if (!is_clone(this_object())) return;

  ::create();
 create_default_npc( 17);
  SetProp (P_SHORT, "Eine Harpyie");
  SetProp (P_LONG, (BS ("Diese Harpyie ist einfach widerlich. "
			"An ihrem Koerper sind Fluegel, die "
			"sich unruhig auf und abbewegen und einen "
			"unertraeglichen Gestank verbreiten. "
			"Die Haare der Harpyie sind verfilzt, "
			"ihre Augen haben einen irren Blick.\n")));
	   
  SetProp (P_NAME, "Harpyie");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_BODY, 60);


SP(P_HANDS, ({" mit ihrem spitzen Schnabel", 160, DT_PIERCE}));

  SetProp(P_MSGIN,"flattert herein");
  SetProp(P_MSGOUT,"fliegt in einer Gestankswolke");  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, -400);
  SetProp(P_RACE, "Fluegelungeheuer");
  SetProp (P_DIE_MSG,
	   " kraechzt das schlimmste Schimpfwort, das sie kennt, "
	   "sinkt zu Boden und geht mitsamt ihres fuerchterlichen "
	   "Gestanks in die ewigen Jagdgruende ein.\n");
  SetChats(5, ({
          "Die Harpyie beschimpft Dich ganz fuerchterlich.\n",
	  "Die Harpyie ruft: Du Schleimbeutel, Dich mache ich fertig!\n",
          "Die Harpyie stochert mit den Fingernaegeln in ihren Zaehnen herum.\n",
          "Die Harpyie lacht schrill.\n",
	  "Pfui, warum stinkt es hier so?\n"
        }) );

 

 
 SetProp (P_MNPC_AREA, "/d/gebirge/dante/friedhof/room/pfad");
  SetProp (P_MNPC_WAIT, ({ 10+random(20),20, 20 }));
  SetProp (P_MNPC_FLAGS, MOV_MOVES+MOV_OUTDOORS+MOV_BACKWARDS);
  SetProp (P_MNPC_DEFAULTROOM, FR"pfad1");
 
  
  
SUID;
CLONEME(FO"blaeschen");
CLONEME(FO"blaeschen");
CLONEME(FO"blaeschen");
  
  AddId(({"harpyie", "vogel"}));	  

SP(P_SPELLRATE, 70);
SP(P_NOMAGIC, 5);

AddSpell(5, 200,
"Die Harpyie hackt Dir ins Bein!\n",
"Die Harpyie hackt @WEM ins Bein!\n",
DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));



AddSpell(2, 300,
"Die Harpyie hackt Dir ins Gesicht!\n",
"Die Harpyie hackt @WEM ins Gesicht!\n",
DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

AddDefaultSpell(1, 300,DS_BLIND,
"Die Harpyie hackt Dir ins Auge!\n",
"Die Harpyie hackt @WEM ins Auge!\n");


}
