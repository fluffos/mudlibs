//dante sl 99

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "./global.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein steinerner Soldat");
  SetProp(P_LONG, BS (
        "Ein Soldat aus purem Stein. Irgendwie lebt er aber."));

  SetProp(P_NAME, "Soldat");
  SetProp(P_GENDER, MALE);
  AddId( ("soldat") );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit steinernen Klauen", 260, DT_BLUDGEON}));
  SetProp(P_BODY,100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "schaut Dich nur stumm an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Was soll der Soldat damit?!\n"}));

  SetProp(P_DIE_MSG, " zerplatzt in 1000 Teilchen.\n");
  SetProp( P_MURDER_MSG, ({ "schaut stumm dumm herum.", MSG_EMOTE }) );

  SP(P_KILL_MSG,
      "Ich bin eben haerter als Du Seicherl!\n");
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 60);
  SP(P_NOCORPSE, 1);


  AddSpell(5, 200, 
      "Der steinerne Soldat rammt Dir einen Fuss in den Bauch.\n",
      "Der steinerne Soldat rammt @WEM einen Fuss in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));      


  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "erscheint vor Dir");
  SetProp(P_MMSGOUT, "marschiert davon");



  SetChats(4, ({
        }));



}


void init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); 
  }
}

void tag()  {
      if(environment(TO)!=environment(TP))  return ;
      write(BSA(
            "Was willst Du von mir, "+TPN+"!",
            "Der steinerne Soldat sagt: "));
}  

varargs void die(int arg) {
  object ob;
  if( (deep_present("H_BOX", TP))&&(!deep_present("SchwarzF", TP)))  {
    ob=clone_object(FO"f6");
    ob->move(TP, M_GET);
    write("Du durchwuehlst die Leiche und findest eine Flasche!\n");
  }
  ::die(arg);
}

