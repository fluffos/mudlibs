//dante sl 99

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <player.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

 
  init(){
    ::init();
      if(interactive(TP)){
      	call_out("tag", 1); }}
      	
      	tag()  {
      		if(environment(TO)!=environment(TP))  return ;
write(BSA(
"Hast Du meine Seele gesehen, "+TPN+"?",
"Wynne klagt: "));
    }  

create()
{ 
  object ob;

  if (!is_clone(this_object())) return;

  ::create();
 create_default_npc( 10 );
  SetProp (P_SHORT, "Das arme, unschuldige Maedchen Wynne");
  SetProp (P_LONG, (BS ("Das Maedchen Wynne schaut Dich mit grossen, "
			"unglaublich traurigen Augen an. "
			"Eine Traene rinnt ueber ihre zarte "
			"Wange, als sie den Blick schuechtern "
			"wieder von Dir abwendet.\n")));
	   
  SetProp (P_NAME, "Maedchen");
  SetProp (P_GENDER, NEUTER);
  SetProp(P_BODY, 20);
  SetProp(P_HANDS, ({"mit ihren kleinen, zarten Haenden", 60, DT_BLUDGEON}));
  SetProp(P_MSGIN,"kommt weinend herein");
  SP(P_MMSGIN, "kommt weinend herein");
  SP(P_MMSGOUT, "laeuft weinend weg");
  
  SetProp(P_MSGOUT,"geht enttaeuscht und mit haengenden Schultern");  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE, "Mensch");
  SetProp(P_REJECT, ({REJECT_GIVE,
			   "Das Maedchen Wynne stammelt schluchzend: "
			   "Nein danke, das kann mir nicht helfen.\n"}));
  SetProp (P_DIE_MSG,
	   " seufzt herzzerreissend traurig und fluestert sterbend: "
	   "Warum ich?\n");
  SetChats(5, ({
        "Das Maedchen Wynne wischt sich die Traenen aus den Augen.\n",
	"Das Maedchen Wynne zittert am ganzen Koerper.\n",
	"Das Maedchen Wynne blickt aengstlich um sich.\n",
	"Das Maedchen Wynne schluchzt.\n",
	"Das Maedchen Wynne ruft verzweifelt: Keiner kann mir helfen!\n",
	"Das Maedchen Wynne seufzt: Was soll ich nur tun?\n",
	"Das Maedchen Wynne sagt traurig: Ich bin verloren.\n",
        }) );

 

  AddInfo( DEFAULT_INFO, ({
          "beginnt hemmungslos zu weinen.\n",
        }) );
  AddInfo( "wuschel",
          "sagt: Oh, die hat so eine schoene, gelbe Haarschleife.\n" );


  SetProp (P_MNPC_AREA, "/d/gebirge/dante/friedhof/room/");
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 30, 30 }));
  SetProp (P_MNPC_FLAGS, MOV_BACKWARDS+MOV_MOVES+MOV_OUTDOORS);
  SetProp (P_MNPC_DEFAULTROOM, FR"ehren");

SP(P_NOATTACK, BS(
"Wynne sagt: HE! Du sollst mir helfen und mich nicht toeten!"));

  
  AddId(({"maedchen", "wynne"}));	  

}

die(arg)  {
	heal_self(300);
	return 1; }
	

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  
   switch(gruppe) 
     {
         case "fies":
      call_out("react", 0, "sagt: Du bist gemein!",
     "sagt: "+TP->name(WER)+" ist gemein!");
          break;
     case "aergerlich":
      call_out("react", 0, "fragt: Warum aergerst Du Mich, "+TPN+"?",0);
 break;
    case "albern":
   call_out("react", 0, "kichert.",0);
    break;
   case "neutral":
  call_out("react", 0, "grinst Dich an.", "grinst "+TP->name(WEN)+" an.");
   break;
     case "intim":
      call_out("react", 0, "kuesst Dich.", "kuesst "+TP->name(WEN)+".");
       break;
   case "froh":
  call_out("react", 0, "laechelt Dich froehlich an.",
         "laechelt "+TP->name(WEN)+" froehlich an.");
        break;
               case "aengstlich":
        call_out("react", 0, "floesst Dir neuen Mut ein.",
          "floesst "+TP->name(WEM)+" neuen Mut ein.");
           break;


case "traurig":
      call_out("react", 0, "troestet Dich.",
      "troestet "+TP->name(WEN)+"!");
      break;
    case "frech":
     call_out("react", 0, "fiept Dich an.", "fiept "+TP->name(WEN)+" an.");
           break;
 
 
   case "nett":
         call_out("react", 0, "knuddelt Dich.", "knuddelt "+TP->name(WEN)+".");
               break;
                           
        }     
}





   
   
   void StartReactionAll(string verb, string gruppe, string adverb, int touch)
   {
     return StartReaction(verb, gruppe, adverb, touch);
     }
     
   
   
   
   void react(string victim, string others)
   {
     if (present(TP, ENV(TO))) 
       {
           if( !others ) others = victim;
               tell_object(TP, BS(Name(WER, 1) + " "+victim) );
        tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
     }
      }
                                                                                                                                                                                               