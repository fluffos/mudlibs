//dante sl 99

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "./global.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Totengraeber");
  SetProp(P_LONG, BS (
        "Dieser Totengraeber betreut hier die Graeber. Er arbeitet schon sehr "
        "lange hier."));


  AI(({"maedel", "wynne"}),
      "Die Arme hat ihre Seele verloren!", "sagt: ");
  AI("seele",
      "HMM, ich weiss das wirklich nicht wo die ist...", "sagt: ");
  AI(({"grab","graeber","friedhof"}),
      "Naja, ich sorge dafuer, dass hier alles sauber und in Ordnung ist.",
      "sagt: ");
  AI("humfrey",
      "Hmm, der weiss sicher mehr ueber das alles hier.", "sagt: ");
  AI("gorgone",
      "Die Frau von Humfrey, recht nett.", "sagt: ");
  AI("schaufel",
      "Naja, die brauch ich zum graben.", "sagt: ");
  AI("totengraeber",
      "Das bin ich!", "sagt: ");
  AI("lola",
      "Die arbeitet da in der Kneipe.", "sagt: ");
  AI(({"gruft","vampire","vampir"}),
      "Ich war da niemals unten, aber es soll Vampire geben, ja!", "sagt: ");


  SetProp(P_NAME, "Totengraeber");
  SetProp(P_GENDER, MALE);
  AddId( ("totengraeber") );
  SP(P_NAME_ADJ, "alt");
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit starken, knochigen Haenden", 160, DT_BLUDGEON}));
  SetProp(P_BODY, 50);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "schaut Dich nur stumm an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Was soll der Totengraeber damit?!\n"}));

  SetProp(P_DIE_MSG, " sinkt tot nieder.\n");
  SetProp(P_SPELLRATE, 60);

  AddSpell(5, 200, 
      "Der alte Totengraeber versucht Dich zu Boden zu werfen.\n",
      "Der alte Totengraeber versucht Dich zu Boden zu werfen.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));      


  SetProp(P_MSGIN, "kommt langsam herein");
  SetProp(P_MSGOUT, "geht langsam");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht langsam davon");


  SetProp (P_MNPC_AREA, "/d/gebirge/dante/friedhof/room/");
  SetProp (P_MNPC_WAIT, ({ 30+random(30), 30, 30 }));
  SetProp (P_MNPC_FLAGS, MOV_BACKWARDS+MOV_MOVES+MOV_OUTDOORS);
  SetProp (P_MNPC_DEFAULTROOM, FR"grab");         


  SetChats(4, ({
        "Der alte Totengraeber stuetzt sich auf seine Schaufel.\n",
        "Der alte Totengraeber seufzt laut.\n",
        "Der alte Totengraeber sagt: Diese verdammten Ratten!\n",
        "Der alte Totengraeber stoehnt laut.\n",
        "Der alte Totengraeber begutachtet alles.\n",
        "Der alte Totengraeber sagt: Diese arme Wynne!\n",
        "Der alte Totengraeber dreht sich kurz um.\n",
        "Der alte Totengraeber sagt: Ich bin sehr muede.\n",
        "Der alte Totengraeber bueckt sich und hebt etwas auf.\n"}));


  SUID;
  CLONEME("obj/schaufel");

}


void init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); 
  }
}

tag()  {
      if(environment(TO)!=environment(TP))  return ;
      write(BSA(
            "Willst Du ein Grab besuchen, "+TPN+"?",
            "Der alte Totengraeber sagt: "));
}  


