// dante sl 99
//debugged 20 juni!!!

/*
   dieser npc hat infos und ist der start fuer das beschaffen der seele
   er is auch das ende sozusagen...
   10 flaschen

*/

inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <player.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

#define QUESTKEY "Die verlorene Seele"

#define GEFRAGT  (member(gefragt, getuid(this_player()))!=-1)
string *gefragt=({});

int wert;

object belohnung;
string t="zehn";
string info_korken(string str);
string info_flasche(string str);
string info_belohnung(string str);



init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); }}

    tag()  {
      if(environment(TO)!=environment(TP))  return ;


      if(deep_present("musicbox", TP))  {		
        write(BSA(
              "Hast Du schon alle Flaschen gefunden, "+TPN+"?",
              "Humfrey fragt: "));
        return;
      }  

      else  {
        write(BSA(
              "Guten Tag, "+TPN+", was kann ich fuer Dich tun?",
              "Humfrey fragt: "));	
      }
    }

create()
{ 
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp (P_SHORT, "Der Magier Humfrey");

  SetProp (P_LONG, (BS (
          "Der Magier Humfrey sitzt an seinem Schreibtisch "
          "und scheint Dich zu ignorieren. Er ist sehr klein, sein "
          "Gesicht und seine Haende sind von Runzeln und "
          "Falten uebersaeht. Seine weissen Haare sind ungekaemmt, "
          "hin und wieder kratzt er sich abwesend den langen "
          "Bart. Wenn Du Humfrey bereits geholfen hast und Deine "
          "Belohnung verloren hast, kannst Du sie mit 'golem' hier wieder bekommen.")));


  create_default_npc( 35 );

  SetProp (P_NAME, "Humfrey");
  SetProp(P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit seinen runzeligen, magischen Haenden", 200, DT_BLUDGEON}));
  SetProp(P_MSGIN,"schlurft abwesend herein");
  SetProp(P_MSGOUT,"brummelt etwas Unverstaendliches und verlaesst kopfschuettelnd den Raum");  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 130);
  SetProp(P_REJECT, ({REJECT_GIVE,
        "Humfrey sagt aergerlich: Was soll ich "
        "mit dem Kram anfangen? \n"}));
  SetProp (P_DIE_MSG,
      " sagt: DAS war das Einzige, was ich noch nicht "
      "wusste.\n"
      "Dann faellt er tot um!\n");



  SP(P_KILL_MSG, "Das passiert, wenn man sich mit einem Magier anlegt!\n");
  SP(P_MURDER_MSG, "Wie konnte ich nur von %s, dieser Niete umgebracht werden!Ich?!\n");

  SP(P_MSG_FLAGS, ([P_KILL_MSG: 0, P_MURDER_MSG:0]));

  SetChats(5, ({
        "Humfrey blaettert in Rekordgeschwindigkeit einige Buecher durch.\n",
        "Humfrey zwirbelt abwesend seinen Bart.\n",
        "Humfrey murmelt irgendetwas.\n",
        "Humfrey greift zur Feder und notiert etwas.\n",
        "Humfrey scheint angestrengt zu ueberlegen.\n",
        "Humfrey blickt durch Dich hindurch.\n",
        "Humfrey kratzt sich am Kopf.\n",
        }) );


  SP(P_SPELLRATE, 70);
  SP(P_NOMAGIC, 10);


  AI(({"nosferatu","vampir","vampire","vampirdrache","drachen","drache"}),
      "UI!!! Unter diesem Friedhof hausen angeblich in einer Gruft Vampire! "
      "Angefuehrt von Nosferatu, ihrem Herrscher und einem Vampirdrachen! Mehr aber "
      "musst Du selbst herausfinden!", "sagt: ");


  AI(({"aufgabe","quest"}),
      "Frag mich lieber nach Wynne!!!", "sagt: ");

  AI("totengraeber",
      "Jaja, der alte Totengraeber, ein netter Kerl! Bisschen ruhig!",
      "sagt: ");

  AddDefaultSpell(3, 300, DS_POISON,
      "Humfrey schuettet eine Flasche ueber Dir aus.\n",
      "Humfrey schuettet eine Flasche ueber @WEM aus.\n");


  AddDefaultSpell(1, 600, DS_PARALYZE,
      "Humfrey leert eine Flasche in Deinen Mund.\n",
      "Humfrey leert eine Flasche in @WESSEN Mund.\n");


  AddSpell(8, 300,
      "Humfrey murmelt boese Worte!\n",
      "Humfrey murmelt boese Worte.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddInfo( DEFAULT_INFO, 
      ({
       "ignoriert Dich.\n",
       "starrt ins Leere.\n",
       "faucht: Ruhe, ich muss mich konzentrieren.\n",
       "murmelt etwas von einer Schachtel!\n",
       "sagt: Wuschel ist eine faszinierende Frau!\n",
       "sagt: Informationen, ich brauche Informationen!\n",
       "murmelt: Lass mich mit diesen Nebensaechlichkeiten in Ruhe.\n",
       "schlaegt genervt die Haende ueber dem Kopf zusammen.\n",
       }) );
  AddInfo( "wuschel",
      "murmelt: Die geht mir nicht so auf die Nerven wie Du.\n" );
  AddInfo("gorgone",
      "laechelt und sagt: Ja, meine Frau sorgt wirklich gut fuer mich.\n");

  //infos!!!

  AddInfo(({"seelen", "seele"}),
      "Ja, Wynne hat ihre Seele verloren. Wenn Du sie wiederfinden "
      "willst und mir und ihr helfen, dann frag mich einfach bisschen weiter.",
      "sagt: ");

  AddInfo("maedchen",
      "Du meinst wohl die arme Wynne. Naja, sie hat ihre Seele "
      "verloren. Die schwirrt hier irgendwo herum. Aber man kann "
      "sie einfach nicht fassen.", "sagt: ");

  AI("wynne",
      "Wynne hat ihre Seele verloren, um sie wieder zu bekommen, "
      "muss man "+t+" kleine Flaschen finden. Zuerst aber muss man "
      "die Seele einfangen. Das geht nur an einem sehr bestimmten Ort, "
      "wo man den Behaelter oeffnen muss. Wenn Du alle Flaschen hast "
      "und den Behaelter mit der Seele, dann komm wieder zu mir zurueck "
      "und frag mich nach <belohnung>!!! "
      "Noch was! Du kannst diese Aufgabe erst beginnen wenn Du den Behaelter "
      "hast!!!",
      "sagt: ");



  AI("ort",
      "Hmm, den kenne ich leider nicht so genau. Man munkelt, das er unter der Erde "
      "sei in einer Gruft oder einem Grab oder...",
      "sagt: ");

  AI("behaelter",
      "Den Behaelter kann ich Dir geben, aber nur wenn Du mich "
      "nach den richtigen Dingen fragst.", "sagt: ");

  AI(({"dinge","ding","dingen"}),
      "Naja, schau Dich mal hier um.", "sagt: ");

  AI("friedhof",
      "Der Friedhof ist ein stiller Ort. Er ist auch nicht allzu "
      "gefaehrlich. Die Gruft hingegen ist schon etwas boesartiger.",
      "sagt: ");
  AI("gruft",
      "Hmm, es soll dort unten nicht ganz ungefaehrlich sein! Ich werde Dir"
      " mitteilen, wenn Du Dich an einen Ort begibst der fuer diese Aufgabe nicht "
      "mehr relevant ist.",
      "sagt: ");





  AddInfo("silberland",
      "Ja, dort kann man noch "
      "richtige Abenteuer erleben und wirkliche Helden treffen!",
      "sagt: ");

  AddInfo("abenteuer",
      "seufzt: Als ich jung war, musste man nicht nach sowas fragen.\n");
  AddInfo(({"helden", "held"}),
      "sagt resignierend: Also Du solltest noch was fuer Deinen Ruf tun.\n");
  AddInfo("dusty",
      "laechelt verklaert und saeuselt: Sie ist ein grosser Fan von mir.\n");
  AddInfo("feyaria",
      "murmelt bedauernd: Oh, eine Elfin. Leider ist sie schon vergeben.\n");

  AddInfo("nostromo",
      "kichert: Ohja, Bianca ist sein ein und alles.\n");

  AddInfo("dante",
      "seufzt: Dieser Kindskopf bereitet mir schlaflose Naechte.\n");



  AddInfo(({"zettel", "notizzettel"}),
      "ruft aergerlich: Finger weg von meinen Sachen!\n");
  AddInfo(({"buch", "buecher"}),
      "sagt: Na, was glaubst Du wohl, wofuer die gut sind?\n");
  AddInfo("magie",
      "sagt: Magie ist ziemlich nuetzlich, wenn man zaubern will.\n");

  set_living_name ("humfrey");

  SUID;
  // CLONEME(FA"guertel");
  // CLONEME(FO"walkman");
  // CLONEME(FA"stiefel");

  //nicht noetig!!!  

  AddInfo( ({"korken"}), #'info_korken, "sagt: "); 
  AI(({"flasche", "flaschen"}), #'info_flasche, "sagt: ");
  AI(({"belohnung"}), #'info_belohnung, "sagt: ");

  AI("schachtel",
      "Na damit muss man die Seele fangen. An dem bestimmten Ort, Du weisst schon! "
      "Du kannst diese Aufgabe erst beginnen, wenn Du die Schachtel "
      "auch wirklich besitzt!!! Merke Dir das bitte!!!", "sagt: ");




  command("zieh alles an");


  AddId(({"humfrey", "magier", "informationsmagier"}));

  AddDetail(({"magier", "informationsmagier"}),
      "Jaja, Humfrey ist wahnsinnig weise und weiss irrsinnig viel.\n");
  AddDetail(({"schreibtisch", "tisch"}),
      "Dort sitzt Humfrey und arbeitet.\n");
  AddDetail(({"gesicht", "haende", "hand"}),
      "Humfreys Gesicht und seine Haende sind ueber und ueber bedeckt mit "
      "Runzeln und Falten.\n");
  AddDetail(({"runzeln", "runzel", "falten", "falte"}),
      "Das kriegst Du auch mal wenn Du so alt wirst wie er!\n");
  AddDetail(({"haare", "haar"}),
      "Humfreys Haare sind schneeweiss und schon ein bisschen duenn. "
      "Sie wirken ungekaemmt - Humfrey hat wohl keine Zeit fuer sowas.\n");
  AddDetail("zeit",
      "Davon hat Humfrey offensichtlich nie genug.\n");

  AddDetail("bart",
      "So einen langen, weissen Bart hast Du wohl noch nie gesehen.\n");


  ACD("golem", "get_golem");
}


int get_golem()  {



  if(TP->QueryQuest(QUESTKEY))  {



    if(!deep_present("PLAYER_NOTIZ", TP))  {

      belohnung=clone_object("d/dschungel/dante/golem/pln");
      belohnung->move(TP, M_NOCHECK);
      write(BSA(
            "HE! Hier hast Du einen neuen Marmorgolem!",
            "Humfrey sagt: "));
      return 1;
    }

    if(deep_present("PLAYER_NOTIZ", TP))  {

      write(BSA(
            "Aber Du hast ja einen Marmorgolem!", "Humfrey sagt: "));	
      return 1;  }

  }

  if(!TP->QueryQuest(QUESTKEY))  {

    write(BSA(
          "Aber Du musst doch zuerst das Abenteuer bestehen!",
          "Humfrey sagt: "));
    return 1;  }

} 	






string info_belohnung(string str)  {
  object box, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10;
  box=present("BOX_SOUL", TP);
  f1=present("SchwarzF", TP);	
  f2=present("ViolettF", TP);
  f3=present("GruenF", TP);
  f4=present("GelbF", TP);
  f5=present("BlauF", TP);
  f6=present("RotF", TP);		
  f7=present("WeissF", TP);
  f8=present("GrauF", TP);
  f9=present("TuerkisF", TP);
  f10=present("BraunF", TP);	



  if(!present("H_BOX", TP))  {
    return(
        "Aber "+TPN+", Du weisst viel zuwenig, und ausserdem fehlt "
        "Dir doch der Behaelter. Also frage mich weiter. "
        "Achja, OHNE Behaelter kannst Du nichts finden!!!");  }

  if(!box)  {
    return (
        "Du hast doch die Seele noch nicht gefangen. Komm spaeter wieder.");  }

  if( !f1 || !f2 || !f3 || !f4 || !f5 || !f6 ||
      !f7 || !f8 || !f9 || !f10)  {

    return(
        "Du hast doch noch nicht alle "+t+" Flaschen gefunden! Such weiter und "
        "frag mich dann noch einmal.");
  }

  else  {

    write(BSA(
          "HE!!! Gratuliere "+TPN+"! Du hast die Seele und alle "+t+" Flaschen! "
          "Endlich kann ich Wynne helfen!!! Danke sehr! Moment mal!!",
          "Humfrey sagt: "));

    write(BS(
          "Humfrey nimmt Dir die Schachtel und die Flaschen weg und "
          "beginnt in seinen Buechern zu lesen. Dann mischt er irgendetwas "
          "zusammen und freut sich!"));
    box->remove();

    f1->remove();f2->remove();f3->remove();f4->remove();f5->remove();
    f6->remove();
    f7->remove();f8->remove();f9->remove();f10->remove();

    write("\n");




    wert=TP->GiveQuest(QUESTKEY);

    if (wert != 1)  {

      write("FEHLER: "+wert+", bitte Magier verstaendigen...\n");
    }

    if(wert==1)  {
      this_player()->GiveQuest(QUESTKEY);
      write_file("/log/quests/wynneseele",
          dtime(time())+": "+capitalize(getuid(this_player()))+ " loest die Quest.\n");



      if(!deep_present("PLAYER_NOTIZ", TP))  {

        belohnung=clone_object("d/dschungel/dante/golem/pln");
        belohnung->move(TP, M_NOCHECK);
        write(BSA(
              "HE! Hier hast Du einen echten Marmorgolem als Belohnung!",
              "Humfrey sagt: "));
      }
    }




    return (
        "Ich muss schnell zu Wynne gehen und ihr ihre Seele wiedergeben!");
  }}



string info_flasche (string str)
{
  if(!GEFRAGT)  {
    gefragt += ({getuid(this_player())});	
    return (("In den Flaschen sind Daemonen, die bei "
          "mir einen Jahresdienst ableisten. "
          "Diese Daemonen koennen mir helfen Wynnes Seele wieder zu "
          "erlangen. Doch leider fehlen mir genau die richtigen "
          ""+t+" Flaschen."));


  }

  if(GEFRAGT)  {
    return(
        "Kannst Du Dir denn ueberhaupt nichts merken?");
  }} 	



string info_korken(string str)  	{
  object ob;



  if(!GEFRAGT)  {
    return ("Naja, ich kann Dir schon was darueber erzaehlen, "
        "aber zuerst musst Du mich nach anderen Dingen fragen. "
        "Dann werde Ich Dir Auskunft darueber geben.");
  }
  if(deep_present("H_BOX", TP))  {
    return(
        "Hoer mir einfach besser zu wenn ich Dir etwas erzaehle. "
        "Ich habe keine Zeit Dir alles immer und immer wieder zu sagen.");
  }



  if(!deep_present("H_BOX", TP))  {

    ob=clone_object("/d/gebirge/dante/friedhof/obj/musicbox");
    ob->move(TP, M_NOCHECK);
    write_file("/log/quests/wynneseele",
        dtime(time())+": "+capitalize(getuid(this_player()))+ " beginnt die Quest.\n");


    write (BS("Der Informationsmagier entfernt bei einer Flasche "
          "den Korken und murmelt eine Beschwoerungsformel. "
          "Blauer Rauch steigt aus der Flasche empor, eine kleine, "
          "durchscheinende Gestalt erscheint und macht wichtig "
          "wirkende Bewegungen mit den Haenden. Ploetzlich "
          "entsteht eine uninteressant aussehende Kiste auf Humfreys "
          "Schreibtisch. Der Magier deutet auf die Flasche, und "
          "sogleich verschwindet die Gestalt darin. "
          "Der Magier steckt den Korken wieder in die Oeffnung "
          "und gibt Dir eine Schachtel."));
    return("Na, zufrieden?!\n");	   
  }

}

