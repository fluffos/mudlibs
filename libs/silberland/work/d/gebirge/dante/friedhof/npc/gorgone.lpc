//dante sl 99
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <player.h>
#include <new_skills.h>

#include "global.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)
 
void init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); 
  }
}

tag()  {
  if(environment(TO)!=environment(TP))  return ;
  write(BSA(
        "Hallo! Na, Lust auf Kaese, "+TPN+"?",
        "Die Gorgone sagt: "));
}  


void create()
{ 
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Gorgone");
  SetProp(P_LONG, (BS ("Die Gorgone ist eine ziemlich gefaehrliche Frau, "
          "denn alles, was sie anschaut, verwandelt sich sofort "
          "in Stein. Aus diesem Grund ist ihr Gesicht mit einem "
          "Schleier verhuellt, den sie nur entfernt, um ihren "
          "beruehmten Gorgonzolakaese herzustellen - oder wenn "
          "jemand allzu aufdringlich wird. Ganz besonders "
          "ungewoehnlich sind ausserdem ihre Haare, die sich zu "
          "bewegen scheinen.\n")));

  AddId(({"frau","gorgone"}));
  AddDetail("frau",
      "Bei der Gorgone handelt es sich unzweifelhaft um ein Wesen "
      "weiblichen Geschlechts.\n");
  AddDetail(({"haare", "haar"}),
      "Aber das sind ja gar keine richtigen Haare! Auf dem Kopf der "
      "Gorgone ringeln sich viele kleine Schlangen.\n");
  AddDetail(({"schlangen", "schlange"}),
      "Du ueberlegst, was das fuer ein Gefuehl sein muss, Schlangen "
      "auf dem Kopf zu tragen und bist froh, dass Du mehr oder weniger "
      "ganz normale Haare hast.\n");
  AddDetail("kopf",
      "Auf dem Kopf der Gorgone wachsen Schlangen statt Haare.\n");
  AddDetail("gesicht",
      "Zum Glueck kannst Du das Gesicht der Gorgone nicht sehen, denn "
      "es wird von einem Schleier bedeckt.\n");
  AddDetail("schleier",
      "Der Schleier schuetzt die Gorgone davor, irrtuemlich jemanden "
      "oder etwas zu versteinern.\n"); 	    

  create_default_npc( 15 );

  SetProp(P_NAME, "Gorgone");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_BODY, 50);
  SetProp(P_HANDS, ({" mit ihren spitzen Fingernaegeln", 130, DT_PIERCE}));
  SetProp(P_MSGIN,"betritt ihren Schleier haltend den Raum");
  SetProp(P_MSGOUT,"fixiert ihren Schleier und geht");  
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 130);
  SetProp(P_REJECT, ({REJECT_GIVE,
			   "Die Gorgone sagt: Das kann ich nicht "
			   "gebrauchen.\n"}));
  SetProp (P_DIE_MSG,
	   " seufzt sterbend: Aber ich wollte doch nur Kaese "
	   "machen.\n");

  SP(P_SPELLRATE, 60);
  AddSpell(5, 150,
      "Die Gorgone tritt nach Dir.\n",
      "Die Gorgone tritt nach @WEM.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 250,
      "Die Gorgone schaut Dir in die Augen.\n",
      "Die Gorgone schaut @WEM in die Augen.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE: 1]));

  AddInfo( DEFAULT_INFO, 
      ({
       "lueftet kurz ihren Schleier und starrt auf ein Stueck Kaese.\n",
       }) );
  AddInfo(({"ente","quaatsch","stoffente"}),
      "Quaatsch bekommst Du nie!!!", "sagt: ");
  AddInfo( "wuschel",
      "sagt beleidigt: Pah, die mag keinen Gorgonzola.\n" );
  AddInfo("humfrey",
      "Er ist zwar etwas grummelig, aber ein "
      "guter Mann. Ausserdem weiss er ziemlich viel.", "sagt: ");
  AddInfo("dante",
      "Wenn der weiterhin so frech ist, werde ich ihm wohl "
      "mal tief in die Augen blicken muessen.", "sagt: ");
  AddInfo("kaese",
      "schwaermt: Kaese esse ich am liebsten.\n");
  AddInfo("wynne",
      "sagt bedauernd: Dabei kann ich Dir nicht helfen.\n");
  AddInfo("suppe",
      "ruft: Finger weg von unserem Mittagessen!!!\n");

  SUID;
  CLONEME(FO"quaatsch");
}

