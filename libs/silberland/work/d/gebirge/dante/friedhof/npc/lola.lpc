// dante@SilberLand

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../global.h"
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Lola, die Bardame");
  SetProp(P_LONG, BS(
  "Das ist Lola, die kesseste Bardame des Silberlands. Mit ihren ueppigen "
  "Rundungen und ihrem neckischen Augenaufschlag animiert sie die meist "
  "maennlichen Kunden aehem, die Gaeste zu uebermaessigem Alkoholgenuss..."));
  SetProp(P_NAME, "Lola");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bardame", "lola"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(22);
  SetProp(P_HANDS, ({" mit ihrem kessen Augenaufschlag",170,DT_MAGIC}));
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY, 60);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 177);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  set_living_name("lola");
  
  SetProp(P_MSGIN, "stolziert aufzreizend herein");
  SetProp(P_MSGOUT, "stolziert aufreizend");
  SetProp(P_MMSGIN, "stolziert aufreizend herein");
  SetProp(P_MMSGOUT, "stolziert kess davon");
  
  SetProp(P_DIE_MSG,  " sinkt mit Hueftwackeln zu Boden!\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Ach was, trink lieber mehr!\n");
  AddInfo("dante", "Dante, hmm, der war mal mein bester Gast.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Lola fluestert in Dein Ohr: Danke...\n" }) );

  SetProp(P_SPELLRATE,70);
  
  AddSpell(3,150,
    "Lola schaut Dir charmant in die Augen.\n",
    "Lola schaut @WEM charmant in die Augen.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,150,
    "Lola wirft ihren Lippenstift nach Dir.\n",
    "Lola wirft ihren Lippenstift nach @WEM.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
  "Lola sieht so sexy aus.\n",
  "Du wuerdest Lola gerne kuessen.\n",
  "Lola zwinkert Dir zu.\n",
  "Du sabberst hinter Lola her.\n",
  "Lola kneift Dir in den Po.\n",
  "Lola sagt: Noch was zu trinken?\n",
  "Lola saeuselt: Hast Du Feuer, Liebling\n",
  "Lola schiebt sich den Wonderbra zurecht.\n",
  "Lola zieht ihre Strapse zurecht.\n",
  "Lola schwingt die Hueften.\n",
  "Du findest Lola so attraktiv!\n",
  "Lola leckt an Ihren Fingern.\n",
  "Lola wackelt mit ihrem Po!\n"}) );
  

  SUID;
    CLONEME(FA "bh" );
   CLONEME(FA "strapse");
CLONEME("d/dschungel/dante/weg/obj/alko");
     
     switch(random(2))  {
     case 0:
     CLONEME(FA "high");
     break;
     case 1:
      CLONEME(FA "high_normal.lpc");
      break;
      default:  CLONEME(FA "high");
     }

   command("zieh alles an");  
  
  AddCmd(({"liebe","umarme",
  "kuesse","knuddle" }),"lieb");
  //ich weiss soulreaction gibts auch
  } 

int lieb(string str)
{
  write(BS(
        "Lola laechelt Dich an und Du verliebst Dich in sie! "
        "Danach wirst Du rot und schaust verlegen zu Boden!"));
  //fps????

  return 0;
}

void init()
{
  ::init();
  if(TP && interactive(TP) && !TP->QueryProp(P_INVIS)) call_out("hallo",0);
}                


void hallo()
{ 
  if(environment(TP)!=environment(TO))
  return;
  command("emote saeuselt suess: "+ TP->name(RAW) +", mein Lieblingsgast!\n");
}

