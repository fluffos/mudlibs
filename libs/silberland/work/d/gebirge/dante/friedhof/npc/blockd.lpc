inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


  if (!is_clone(TO)) return;
  ::create();

  AD("ding",
      "Hmm, verdaechtig.");
  AD("stahl",
      "Dunkel und hart.");
  AD(({"oeffnungen","oeffnung"}),
      "Hmm, man kann nichts genaues erkennen.");
  AD(({"schlitz","schlitze"}),
      "Die Schlitze scheinen sich zu bewegen.");
  AD("oberflaeche",
      "Die Oberflaeche scheint zu pulsieren.");



  SetProp(P_NAME,"Stahlblock");
  SetProp(P_NOGET, "Du kannst den schwarzen Stahlblock nicht aufheben!\n");
  SetProp(P_GENDER, MALE);
  SP(P_NAME_ADJ, "schwarz");
  AddId(({"stahlblock","daemon","block", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Stahlkrallen", 200, DT_RIP}));
  SetProp(P_BODY, 500);
  SetProp(P_SIZE, 25000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Stahlblock ist sehr verdaechtig.\n");
  SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -1.0, DT_TERROR:-1.0,
    DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.4, DT_COLD:-0.5]));

  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "waechst aus dem Boden heraus");
  SetProp(P_MSGOUT, "waelzt sich");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verschwindet im Boden");

  SetProp(P_MURDER_MSG, "Der Stahldaemon zerfaellt zu Metallstaub");
  SetProp(P_KILL_NAME, "Ein Stahldaemon");
  SetProp(P_KILL_MSG, "Ich schweige!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  SetProp(P_RACE, "Daemon");





}


_query_material() {       
  write("Der Stahlblock besteht aus Stahl, oder...\n");
  return ""; }




  _query_short(){
    if(!InFight())return "Ein schwarzer Stahlblock";
    else
      return "Ein Stahldaemon";
  }

_query_long(){
  if(!InFight()) return BS(

      "Der Block wurde aus haertestem Stahl geformt. Seine Oberflaeche ist rauh und "
      "weist seltsame Schlitze und Oeffnungen auf. Das Ding kommt Dir sehr verdaechtig vor.");


  else

    return "Der Stahlblock scheint ja doch ein Stahldaemon zu sein!\n";
}



_query_name()  {
  if(!InFight())return "Stahlblock";
  else
    return "Stahldaemon";
}

/*InFight()  {
  SP(P_NAME, "Stahldaemon");

  }
  */       





Defend(int dam, string dtype, mixed spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_TERROR }) ))
  {

    tell_object(enemy,
        "Der Stahlblock lacht Dich aus!!!!\n");
    heal_self(dam/5);
    return ::Defend(0, dtype, spell, enemy);

  }


  if (sizeof(dtype & ({ DT_BLUDGEON }) ))
  {

    tell_room(environment(TO),
        ""+enemy->name()+" wird von einem abprallenden Angriff getroffen!\n",
        ({enemy}));

    tell_object(enemy,
        "Dein Angriff prallt vom Stahlblock ab und trifft Dich selbst.\n");
    enemy->Defend(dam, DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]), TO);
    return ::Defend(0, dtype, spell, enemy);
  }
  return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/gebirge/dante/friedhof/log/stahl",
      ctime()+": Stahl hat "+CAP(getuid(player))+" umgebracht.\n");
  NAL1
}

NAL2

die(arg)
{
  write_file("/d/gebirge/dante/friedhof/log/stahl",
      ctime()+": Stahl wurde von "+CAP(getuid(PL))+" umgebracht.\n");
  ::die(arg);
}


