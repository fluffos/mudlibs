//trinker von dante mit guter flasche

/*
   einer meiner ersten npcs uralt.....
   38 mal angepasst*lach*
   wie das mit seiner flasche ist..keine ahnung.......
   ob man die erlaubt

*/

#include <mnpc.h>  
inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../global.h"
#include <new_skills.h>

void create()
{
  object cash;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein ekliger, versoffener Trinker");
  SP(P_NAME_ADJ, ({"eklig","versoffen"}));

  AddId  (({"trinker","alkoholiker"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Trinker");

  SetProp (P_LONG, "Der Trinker sieht sehr ungesund aus. Seine Haut hat "
      "bereits eine typische gelbliche Farbe angenommen. "
      "Ein Symptom fuer den katastrophalen Zustand seiner "
      "Leber. Da wo frueher mal seine Nase war, wuchert "
      "nun ein geradezu monstroeses Rhinophym. Ueberhaupt "
      "ist sein ganzes Gesicht schwer gezeichnet vom jahre- "
      "langen uebermaessigen Alkoholkonsum. Seine Zaehne, "
      "oder das, was vor langer Zeit einmal Zaehne waren, "                
      "spotten jeder Beschreibung. Es sind wohl eher faule, "
      "schwarze, karioese Stummel. Sein ganzer Koerper wirkt "
      "ausgemergelt durch den jahrelangen Raubbau. "
      "Er wird wohl nicht mehr lange leben.");

  create_default_npc( 18);

  SetProp (P_ALIGN, -100);
  SetProp (P_BODY, 40);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_SMELL, ("Der Trinker riecht wie ein Dutzend besoffener Matrosen!\n"));
  SetProp (P_HEAL, -20);
  SetProp (P_WIMPY, 70);
  SetProp (P_RACE, "Mensch");
  SetProp (P_HANDS, ({" mit seinen Gichtkrallen", 190, DT_BLUDGEON}));
  SetProp (P_MAX_HP, 500);
  SetProp (P_SPELLRATE,70);
  SetProp (P_WEIGHT, 70000);
  SetProp (P_SIZE, 180);
  SetProp(P_NOMAGIC, 10);

  /*
     SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC:-1.0, DT_ACID: -1.0, DT_TERROR:-1.0,
DT_POISON:-1.0, DT_HOLY: 2.0, DT_SLASH:0.5, DT_FIRE:-1.0, DT_WHIP:2.0]));
*/


  SetProp(P_MSGIN, "torkelt laut groehlend herein");
  SetProp(P_MSGOUT, "torkelt laut groehlend");
  SetProp(P_MMSGIN, "torkelt laut singend");
  SetProp(P_MMSGOUT, "torkelt im Kreis und dann laut groehlend davon");

  SetProp(P_MNPC_AREA, (FR));
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS+ MOV_INDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({30, 20, 20}));

  SetProp(P_MNPC_DEFAULTROOM, FR"bar");            


  SetChats(3, ({
        "Der Trinker schreit: He, DU da, spendier mir nen Drink!\n",
        "Der Trinker lallt wirres Zeug....\n",
        "Der Trinker kotzt genau vor Deine Beine.\n",
        "Du wendest Dich angeekelt vom Trinker ab.\n",
        "Der Trinker erzaehlt von seiner Jugend.\n",
        "Der Trinker schreit: Auf alle meine Freunde!\n",
        "Der Trinker will Dich umarmen.\n",
        "Der Trinker wird immer aggressiver!\n",
        "Nun beginnt der Trinker auch noch zu singen....\n",
        "Jetzt wird er sentimental und beginnt zu heulen.\n",
        "Der Trinker will sich noch nen Schnaps erschnorren.\n",
        "Der Trinker saeuft noch nen Whiskey.\n"}));

  AddInfo("dante",
      "sagt: Er hat mich erschaffen. Sollte Dir doch zu denken geben!\n");
  AddInfo("alkohol",
      "sagt: Ich liebe ihn bis in den Tod!!!\n");
  AddInfo("leber",
      "sagt: Meine Leber ist mir voellig egal!\n");
  AddInfo("koenig",
      "sagt: MEIN Koenig heisst Alkohol. \n");
  AddInfo("moppy",
      "sagt: Die ist ja Antialkoholikerin, oder...\n");                      
  AddInfo("bier",
      "sagt: Fuer den Anfang recht gut, aber zu schwach!\n");
  AddInfo("zaehne",
      "schreit: Zaehne, wozu brauch ich Zaehne?!\n");        
  AddInfo("tod",
      "singt:Im Himmel gibts kein Bier, drum trinken wir es hier!\n");

  AddInfo("jugend",
      "lallt: Ich war mal ein junger, huebscher Mann...\n");
  AddInfo("wirt",
      "sagt: Der Wirt ist ein geiziger Sack!\n");
  AddInfo("elfen",
      "flucht: Die miesen Elfen glauben sie sind was besseres.\n");                
  AddInfo("stahldorn",
      "sagt: Der hat ja nen Vogel....\n");
  AddInfo("woody",
      "sagt: Ach, mein Gott ist fluessig!\n");
  AddInfo("flasche",
      "sagt: Ja, die haettest Du wohl gerne...\n");                
  AddInfo("schnaps",
      "fleht: JA, davon will ich mehr...\n");
  AddInfo("whiskey",
      "sagt: Der geht runter wie Honig...\n");        
  AddInfo("wuschel",
      "lacht: Ich sag nur The Balvenies...\n");

  AddSpell (3, 300,
      "Der Trinker haucht Dich mit seinem schlechten Atem an.\n",
      "Der Trinker haucht @WEN mit seinem schlechten Atem an.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell (3, 250,
      "Der Trinker ruelpst Dich extrem laut und eklig an.\n",
      "Der Trinker ruelpst @WEN extrem laut und eklig an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));         
  AddSpell (2,400,
      "Der Trinker kotzt Dich voll.\n",
      "Der Trinker kotzt @WEN voll.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell (2,400,
      "Der Trinker fleht Bacchus um Hilfe gegen Dich an.\n",
      "Der Trinker fleht Bacchus um Hilfe gegen @WEN an.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
        "Der Trinker spuckt Dich an.\n",
        "Der Trinker bruellt: Du elender Hurensohn.\n",
        "Der Trinker zieht Dir eine Flasche ueber den Schaedel.\n",
        "Der Trinker tritt Dir zwischen die Beine.\n",
        "Der Trinker schreit: Dich saufe ich leicht unter den Tisch.\n"}));

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   

  SetProp (P_INFO, ("Der Trinker ist ein mieses, verkommenes Subjekt. \n"));
  SetProp (P_KILL_MSG, ("Koenig Alkohol gab mir die Kraft dazu!"));
  SetProp (P_DIE_MSG, " haucht sein jaemmerliches Leben aus.\n");
  SetProp (P_DEFAULT_INFO,"sagt: Halts Maul und kauf mir ALKOHOL.\n");
  SetProp ( P_REJECT, ({ REJECT_KEEP, "Der Trinker sagt: Ich brauche viel Geld fuer Alkohol.\n"}));
  SetProp(P_KILL_NAME, "Ein mieser, verkommener Trinker");      
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));     
  SP(P_MURDER_MSG, "Ich saufe weiter!");



  AddDetail (({"nase", "rhinophym"}),
      "Durch den jahrelangen Alkoholkonsum hat sich ein gewaltiges "
      "Rhinophym gebildet. Eine Wucherung des Gewebes, Knollen- oder "
      "auch Weinnase genannt. Publius Ovidius Naso, den man uns in "
      "der Schule als grossen Dichter gepriesen hat, hatte ebenfalls "
      "ein gewaltiges Rhinophym und seinen Namen daher nicht unver"
      "dient. Es ensteht durch eine Veraenderung des PH-Wertes der "
      "Haut verursacht durch den Alkohol. Du solltest vielleicht mal "
      "Deine Nase einer kritischen Betrachtung unterziehen!\n");

  AddDetail (("gesicht"),
      "Das Gesicht des Alkoholikers ist nur noch eine Farce eines "
      "ehemals bluehenden Antlizes. Die Wangen sind eingefallen, "
      "tiefe Falten zeugen von der fuerchterlichen Zerstoerungs- "
      "kraft des Alkohols. Die vielen Schrammen und Narben weisen "
      "auf unzaehlige Stuerze und Verletzungen hin, die der Mann "
      "sich im Suff zugezogen hat. Er ist wahrlich ein trauriger "
      "Anblick. Fast bekommst Du Mitleid mit ihm.\n");

  AddDetail (({"zaehne","stummel","beschreibung"}),
      "Welche Zaehne? Du siehst nur schwarze, verfaulte Stummel, "
      "die Dich aus einem stinkenden, verzerrten Mund angrinsen. "
      "Dieser abscheuliche Anblick laesst Ekel und Abscheu in Dir "
      "hochkommen. Du kannst den schlechten Atem auch aus einiger "
      "Entfernung riechen.\n");

  AddDetail(({"leber","haut","farbe","symptom"}),
      "Die Haut des Trinkers ist grau mit einem leichtem Gelbton. "
      "Seine Leber muss steinhart, vernarbt und kurz vorm dem "
      "kollabieren sein. Wenn Du an das arme Organ denkst, hoerst "
      "Du seine Leber laut schreien!!! Was hat Koenig Alkohol "
      "nur aus diesem einst hoffnungsvollen Menschen gemacht...\n");          

  AddDetail(({"koerper","zustand"}),
      "Der Trinker ist so wie alle Alkoholiker in einem jaemmer"
      "lichen Zustand. Sein ausgemergelter, vergifteter Koerper "
      "ist kaum noch in der Lage sich aufrecht zu halten und "
      "trotzdem fordert er immer mehr und mehr Alkohol...\n");

  AddDetail(({"raubbau","alkoholkonsum"}),
      "Ja, so wird man wenn man den suessen Sirenenrufen von "
      "Koenig Alkohol all zu oft nachgibt. Er gibt vor ein "
      "Freund zu sein, doch in Wirklichkeit ist er Dein "
      "groesster Feind! Er ist wie eine Geliebte die Dich "
      "langsam und quallvoll vergiftet. Zu guter letzt, wenn "
      "Du schon schwach und suechtig bist, zeigt er Dir zum "
      "Hohn noch sein wahres Gesicht...huete Dich vor ihm!!!\n");

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(500));
  cash->move(ME);
  if( !random(2)) CLONEME(FO"dflasche");

}

void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo", 3);
}



void hallo()
{
  if(environment(TP)!=environment(TO))
    return;
  command("emote lallt: Hallooh "+TP->name(RAW)+", spendier mir Alohol!!!");
}

int _query_alcohol() { return 100; }
