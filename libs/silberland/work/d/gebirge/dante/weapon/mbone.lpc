//waffe fuer mon fuer hoehlenquesbydante 98

#include "files.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein spitzer Knochen");
  SetProp(P_LONG, BS(
  "Diesen Knochen hat Irgendjemand abgebrochen. Eines seiner Enden ist sehr "
  "spitz, das andere schaut eher wie ein Griff aus."));
  AddDetail("griff",
  "Naja, halten kann man den Knochen damit.");
  AddDetail(({"ende", "enden"}),
  "Eines > das andere eher =.\n");
  
  SetProp(P_NAME, "Knochen");
  SetProp(P_INFO, BS(
  "Der Knochen wirkt irgendwie magisch..."));
  
  SetProp(P_GENDER,MALE);
  SetProp(P_WEAPON_TYPE, WT_MAGIC );
  SetProp(P_DAM_TYPE, DT_MAGIC);
  SetProp(P_WC, 70);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({ MAT_BONE, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 4);
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:3]) );
  SetProp(P_HIT_FUNC, TO);
  AddId(({"knochen","mbone"}));
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->id("gi") )
  {
    schaden=random(300);
    if( schaden>200)
      write("Der Knochen zischt und wendet seine Magie gegen "+
       enemy->name(WEN)+".\n");
    return 3*enemy->QueryProp(P_LEVEL)+schaden;
  }
  write(CAP(enemy->name(WER) )+" ist mit dem Knochen nicht zu verwunden.\n");
  return -250;      
}
