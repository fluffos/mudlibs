inherit "/std/weapon";


//#include "def.h"
#include "files.h"
#include <properties.h>                    
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <attributes.h>
#include <new_skills.h>

#define X_ATTACK_SKILL "x_attack_skill"
  
create() {
  if (!is_clone(this_object())) return;
  weapon::create();

  SetProp(P_SHORT,"Eine Katatxuka");
  SetProp(P_LONG,BS(
  "Die Katatxuka ist ein ganz besonderes Schwert. Eine lange, messerscharfe "
  "Klinge windet sich schlangenfoermig nach unten und endet dann in einem "
  "Griff, der die Form eines laenglichen Totenschaedels aufweisst. An der "
  "Spitze der Klinge zucken ab und zu grellgelbe Blitze."));
  
  AddDetail("schwert",
  "Die Katatxuka ist ein Schwert.");
  AddDetail("klinge",
  "Die Klinge ist schlangenfoermig gewunden und messerscharf. "
  "Manchmal leuchten helle Blitze von ihrer Spitze auf.");
  AddDetail(({"blitz","blitze"}),
  "Grellgelb zucken sie durch die Luft!");
  AddDetail("griff",
  "Der Griff hat die Form eines laenglichen Totenschaedels.");
  AddDetail("spitze",
  "Die Spitze ist so duenn, dass man sie kaum sehen kann. Trotzdem ist sie "
  "sehr stabil. Dann und wann faehrt ein heller Blitz von der Spitze gen "
  "Himmel!");
  AddDetail(({"form","schaedel","totenschaedel"}),
  "Der Griff hat nicht nur die Form, es ist ein laenglicher Totenschaedel "
  "einer Rasse die vor Urzeiten den Dschungel bevoelkert hat! "
  "Schaurig grinsen Dich die Augen an!");
  AddSpecialDetail(({"auge","augen"}), "d_look");
  
  AddDetail(({"rasse","dschungel"}),
  "Tja, das alles ist lange her."); 
  SetProp(P_NAME,"Katatxuka");
  SetProp(P_GENDER,FEMALE);
  AddId(({"schwert","katatxuka"}));
  SetProp(P_MATERIAL,([MAT_BONE:30,MAT_CHROMIUM:50, MAT_STEEL:100, MAT_TITANIUM:20]));
   
  
  SetProp(P_WEIGHT,400); 
  SetProp(P_VALUE,4000);
  SetProp(P_NR_HANDS, 1);

  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP,DT_ELECTRIC, DT_LIGHTNING}));
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC,250);
  SetProp(P_WC_FIXFACTOR, 0.6);
  
  SetHitFunc(ME);
  
}

 string d_look()
{
write("Die Augen schauen Dich, "+CAP_TPN+", boese an!\n");
return "";
}


init() {
  weapon::init();
}

varargs int DoUnwield(int silent, int rek) {
  int res;

  res=(::DoUnwield(silent));
  return res;
}


int HitFunc(object enemy)
 {
  object pl;
  int sk,dex,bonus;
  
  if (!objectp(pl=QueryProp(P_WIELDED)))
    return 0;

  sk=pl->QueryProp(X_ATTACK_SKILL);
  dex=pl->QueryAttribute(A_DEX);
  bonus=random(dex*(5000+sk))/3000;
      
    if (bonus>90)
    {
      bonus=90;
  }
  if (sk>random(10000))
    return random(bonus);

    sk+=random(2);
  if (sk>10000)
    sk=10000;
  pl->SetProp(X_ATTACK_SKILL,sk);
  pl->Set(X_ATTACK_SKILL,SAVE,F_MODE_AS);
  return random(bonus);
}

string valtostr(int val)
 {
  switch(val) {
    case 0..200: return "mieser als mies";
    case 201..500: return "katastrophal schlecht";
    case 501..700: return "sehr schlecht";
    case 701.. 1000: return "ziemlich schlecht";
    case 1001..1500: return "schlecht";
    case 1501..2000: return "sehr weit entfernt von mittelmaessig";
    case 2001.. 2500: return "weit entfernt von mittelmaessig";
    case 2501.. 3000: return "fast mittelmaessig";
    case 3001.. 3500: return "mittelmaessig"; 
    case 3501.. 4000: return "sehr weit entfernt von gut";
     case 4001.. 4500: return "weit entfernt von gut";
     case 4501.. 5000: return "fast gut";
    case 5001.. 5500: return "gut";
    case 5501.. 6000: return "sehr weit entfernt von sehr gut";
     case 6001.. 6500: return "weit entfernt von sehr gut"; 
    case 6501.. 7000: return "fast sehr gut";  
    case 7001.. 750: return "sehr gut";
     case 7501.. 8000: return "sehr weit entfernt von exzellent";
      case 8001.. 8500: return "weit entfernt von exzellent";
       case 8501.. 9000: return "fast exzellent";
   case 9001.. 9500: return "exzellent";
   case 9501 .. 10000: return "sehr weit entfernt von perfekt";
    case 10001.. 12500: return "weit entfernt von perfekt";
     case 12501.. 15000: return "fast perfekt";
     case 15001.. 20000: return "perfekt";   
    default: return "unuebertrefflich, meisterhaft , genial";
  }
}

_query_info() {
  return break_string("Im Moment beherrscht Du die Katatxuka "+
		      valtostr(TP->QueryProp(X_ATTACK_SKILL))+
		      "!\n");
}
