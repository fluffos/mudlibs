//peitscjhe fuer gnom by dante

inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "files.h"


create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  AddId (({"hammer", "zombiehammer"}));       // IDs
  SetProp(P_SHORT, "Ein Zombiehammer");    //Kurzbeschreibung
  SetProp(P_LONG, BS(
  "Der Zombiehammer besteht aus schwarzem Metall. Er ist wuchtig und haut "
  "sicher gewaltig zu. Komischerweise fuehlt er sich eiskalt an."));
  AddDetail("metall",
  "Schwarz und eiskalt.");             
  SetProp(P_INFO, "Der Zombiehammer macht Kaelteschaden!\n");
  SetProp (P_NAME, "Zombiehammer"); 
  SetProp (P_GENDER, MALE);  
  SetProp (P_VALUE, 1000+random(101)); 
  SetProp (P_WEIGHT, 900); 
  SetProp (P_MAGIC, 1);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, ({DT_BLUDGEON, DT_COLD})); 
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 200);
  SetProp (P_WC_FIXFACTOR, 0.5);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_ICE:10, MAT_STEEL: 90]));
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 15]));

}







