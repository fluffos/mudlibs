//trolldolch
//macht verschieden schaden mals ehn

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <new_skills.h>
#include "files.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Trollgiftdolch");

  SetProp (P_LONG,BS( 
  "Dieser Dolch ist kurz, aber enorm scharf. Seine Klinge ist gebogen "
  "und weist seltsame Rillen auf."));
  AddDetail("klinge",
  "Die Klinge ist enorm scharf.");
  AddDetail(({"rillen", "rille"}),
  "In den Rillen fliest Gift!");
  AddDetail("gift",
  "Ein sehr starkes Gift!");
  SetProp (P_NAME, "Trollgiftdolch");
  SetProp (P_GENDER, MALE);

  AddId (({"dolch", "giftdolch","trolldolch","trollgiftdolch"}));

  SetProp (P_VALUE, 1800+random(200));
  SetProp(P_WEIGHT, 200);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, ({DT_SLASH,DT_POISON}));
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 150+random(10));
  SetProp(P_MATERIAL, ({MAT_STEEL,MAT_MISC_DRUG,MAT_BLOOD}));
  SetProp (P_NR_HANDS, 1);
    SetProp(P_HIT_FUNC, this_object());   
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:15]) );  
  SetProp(P_INFO, BS("Der Trollgiftdolch kann Deine Gegner vergiften.\n"));
}


HitFunc(enemy)
{
   if (!random(10))
      {
      tell_object(environment(),
      "Gift spritzt aus den Rillen hervor!\n");
      enemy->AddPoison(random(1)+1);
      }
    }
      
      