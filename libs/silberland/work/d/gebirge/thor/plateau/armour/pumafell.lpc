// Thor@SilberLand 
// Ein Pumafell
// 1997-03-11

#include "../plateau.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <material.h>

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Pumafell");
  SetProp(P_LONG, BS( 
    "Das Fell eines Pumas.") );
  SetProp(P_NAME, "Pumafell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "pumafell","\nfell_is_gerb_able"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_FUR);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);
}
