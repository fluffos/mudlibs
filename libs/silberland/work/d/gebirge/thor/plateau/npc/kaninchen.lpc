// Thor@SilberLand 
// Ein Kaninchen
// 1997-03-05

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include <moving.h>
#include "../plateau.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Kaninchen");
  SetProp (P_LONG, "Ein Kaninchen, das froehlich herumhoppelt. Wenn Du es genauer "
        +"betrachtest, denkst Du Dir, dass es eigentlich einen hervorragenden "
        +"Hasenbraten abgeben muss.");
  SetProp (P_NAME, "Kaninchen");
  SetProp (P_GENDER, NEUTER);
  AddId ( "kaninchen" );
  AddDetail( ({"braten", "hasenbraten"}),
             "Dazu muesstest Du es wohl erst einmal toeten.");
  create_default_npc (5);
  SetProp (P_HANDS, ({" mit seinen Hasenzaehnchen", 50}));
  SetProp (P_ALIGN, 50);
  SetProp (P_WEIGHT, 800);
  SetProp (P_CORPSE, OBJ("totkan"));
  SetProp (P_MSGIN, "hoppelt herein");
  SetProp (P_MSGOUT, "hoppelt");
  SUID;
 
  SetProp(P_MNPC_AREA, ROOM(""));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("plat3"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  ActivateMove (1);

}





  


