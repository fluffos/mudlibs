// Thor@SilberLand   
// Ein Puma
// 1997-03-07

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../plateau.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Puma");
  SetProp(P_LONG, BS(
    "Der Puma ist ein gefaehrliches Raubtier, das in den Bergen lebt. Seine Augen "
   +"funkeln Dich wuetend an und er faucht so furchterregend, dass Dir das Blut "
   +"in den Adern gefriert."));
  SetProp(P_NAME, "Puma");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Raubkatze");
  AddId( "puma");
  
  create_default_npc(23);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 300, DT_RIP}));
  SetProp(P_MAX_HP, 700);
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "springt Dich an");
  SetProp(P_MSGOUT, "schleicht");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  /* SetProp(P_MURDER_MSG, "Das wagst Du kein zweites Mal, "+TPN+"!");*/
  SetProp(P_KILL_NAME, "Ein Puma");

  AddInfo(DEFAULT_INFO, "faucht Dich wuetend an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "schlaegt mit seinen Pranken nach Dir.\n" }) );

  
  SetChats(3, ({
  "Der Puma faucht Dich wuetend an.\n",
  "Der Puma fletscht seine Zaehne.\n" }) );
  SetProp(P_SPELLRATE,30);
  AddSpell(6,200,
           "Der Puma schlaegt mit einer Pranke nach Dir.\n",
           "Der Puma schlaegt mit einer Pranke nach @WEN.\n",
           DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,500,
           "Der Puma springt Dir an den Hals.\n",
           "Der Puma springt @WEN an den Hals.\n",
           DT_RIP,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME(WEAPON("rgebiss"));
  CLONEME(ARMOUR("pumafell") );
  command("trage pumafell");
}













