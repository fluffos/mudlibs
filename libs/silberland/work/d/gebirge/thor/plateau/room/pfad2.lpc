// Thor@SilberLand
// Gebirgsplateau - Pfad 2
// 1997-03-14

#include "../plateau.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein felsiger Weg" );
  SetProp( P_INT_LONG,
    "Der felsige Weg, auf dem Du bist, fuehrt nach Norden weiter. Westlich von Dir "
   +"liegt der Gebirgspfad. Die Landschaft hier ist felsig und unfreundlich. Es "
   +"tuermen sich riesige Gebirgsmassen rund um Dich auf. Nur vereinzelt siehst "
   +"Du noch ein paar Baeume und Straeucher aus der unfreundlichen Felslandschaft "
   +"hervorspriessen. Der Boden ist noch spaerlich mit etwas Gras bewachsen. Rings "
   +"um Dich liegen einige Felsbrocken herum. Es blaest Dir ein kuehler Wind um "
   +"die Ohren. Wenn Du weiter nach Osten blickst, glaubst Du eine schroffe "
   +"Felswand zu erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( "fels",
             "In dieser Gegend hier ist so ziemlich alles aus Fels.");
  AddDetail( ({ "gebirgspfad", "pfad" }),
             "Der Gebirgspfad liegt ein Stueckchen weiter westlich von Dir.");
  AddDetail( "weg",
             "Der Weg ist sehr steinig und das Vorankommen ist gar nicht so einfach.");
  AddDetail( "vorankommen",
             "Es ist ziemlich muehselig, sich zwischen den Felsbrocken durchzukaempfen.");
  AddDetail( ({"felsbrocken", "brocken"}),
             "Rings um Dich liegen einige grosse Felsbrocken herum, die Dir das "
            +"Vorankommen erschweren.");
  AddDetail( "osten",
             "Richtung Osten fuehrt Dich dieser Weg ins Ungewisse. Du scheinst etwas "
            +"weiter entfernt von hier eine schroffe Felswand zu erkennen.");
  AddDetail( "wind",
             "Dir blaest ein kuehler Wind um die Ohren.");
  AddDetail( "ohren",
             "Deine Ohren sind schon ganz rot vom Wind.");
  AddDetail( ({"felslandschaft", "landschaft"}),
             "Die Landschaft hier ist nur spaerlich bewachsen. Selten sieht man einen Baum "
            +"oder ein paar Graeser aus dem Boden spriessen.");
  AddDetail( ({"baum", "baeume"}),
             "Nur vereinzelt ragen noch ein paar Baeume aus der Felslandschaft hervor.");
  AddDetail( ({"graeser", "gras"}),
             "Der Boden ist nur mehr spaerlich mit etwas Gras bewachsen.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige verdoerrte Buesche stehen noch vereinzelt herum.");
  AddDetail( ({"wand", "felswand"}),
             "Weiter im Osten kannst Du in der Ferne eine Felswand erkennen. Wenn Du sie "
            +"Dir genauer anschauen moechtest, musst Du aber schon naeher rangehen.");
  AddDetail( ({"massen", "gebirgsmassen"}),
             "Die riesigen Gebirgsmassen lassen Dich ehrfuehrchtig die wilde Natur hier "
            +"bewundern.");
  AddDetail( ({"natur", "naturgewalten", "gewalten"}),
             "Die Naturgewalten hier sind beinahe schon furchteinfloessend.");
  AddDetail( "boden",
             "Der Boden ist steinig und felsig. Nur selten sieht man etwas Gras "
            +"hervorspriessen.");
  AddDetail( "himmel",
             "Ueber Dir siehst Du den strahlend blauen Himmel.");
  AddSmell( DEFAULT_SMELL, "Du atmest tief die frische Bergluft ein.");
  AddSound( DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");
  AddExit( "suedwesten", ROOM("pfad1"));
  AddExit( "norden", ROOM("pfad3"));
}






