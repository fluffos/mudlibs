// Thor@SilberLand
// Gebirgsplateau - Ein verwachsener Pfad
// 1997-03-05

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein verwachsener Pfad");
  SetProp( P_INT_LONG,
    "Der Pfad fuehrt weiter nach Nordosten. Er scheint schon lange nicht mehr "
   +"benutzt worden zu sein, denn durch das Gebuesch links und rechts von Dir "
   +"ist der Pfad beinahe schon ganz zugewachsen. Wenn Du Dich umsiehst, kannst "
   +"Du nur mehr dichtes Gestruepp hinter Dir erkennen. Richtung Suedwesten "
   +"muesstest Du zu der Senke zurueckkommen. Die Vegetation hier ist "
   +"sehr viel dichter als am Felsplateau oben. Die Straeucher sind zwar nicht "
   +"sehr dicht bewachsen, aber sehr zahlreich vorhanden. Der Boden ist etwas "
   +"grasbewachsen und Du kannst den Pfad nur mehr schwer erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 8]) );

  AddDetail( "pfad" ,
             "Ein schmaler, verwachsener Pfad. Er muss schon seit Jahren nicht "
            +"mehr benutzt worden sein, denn er ist kaum noch zu erkennen. Wo "
            +"er Dich wohl hinfuehren mag?");
  AddDetail( ({"jahre", "jahre"}),
             "Es muss schon Jahre her sein, dass jemand diesen Pfad benutzt hat.");
  AddDetail( "nordosten",
             "Du musst schon weitergehen, wenn Du wissen willst, was sich dort "
            +"so verbirgt.");
  AddDetail( "suedwesten",
             "In Richtung suedwesten liegt die kleine Senke mit der Feuerstelle.");
  AddDetail( ({"senke", "stelle", "feuerstelle"}),
             "Die kannst Du von hier aus nicht mehr erkennen.");
  AddDetail( ({"felsplateau", "plateau"}),
             "Dich froestelt, wenn Du an das kalte und windige Felsplateau, das "
            +"ein Stueckchen weiter westlich von Dir liegt, denkst.");
  AddDetail( "gestruepp",
             "Hinter Dir siehst Du nur mehr dichtestes Gestruepp.");
  AddDetail( "gebuesch",
             "Das Gebuesch ist dicht verwachsen. Es kostet Dich einige Muehe, Dich "
            +"durch das Unterholz durchzukaempfen.");
  AddDetail( "muehe",
             "Hier voranzukommen ist ziemlich muehselig.");
  AddDetail( ({"unterholz", "holz"}),
             "Dicht gewachsene Straeucher erschweren Dir das Vorankommen.");
  AddDetail( "vorankommen",
             "Muehselig kaempfst Du Dich durch das Buschwerk durch.");
  AddDetail( ({"straeucher", "buschwerk", "werk"}),
             "Das Buschwerk ist sehr dicht, obwohl die Straeucher weder ausladend "
            +"noch von sattem Gruen sind. Sie haben eher verkrueppelte Aeste, die "
            +"ineinander verhakt sind.");
  AddDetail( "gruen",
             "Schoene Farbe, Sargola gefaellt sie besonders gut.");
  AddDetail( "sargola",
             "Netter Magier im SilberLand");
  AddDetail( "silberland",
             "Da bist Du gerade.");
  AddDetail( ({"magier", "farbe"}),
             "Glaubst Du nicht, dass Du jetzt ein bisschen zu weit vom Wesentlichen "
            +"abschweifst...");
  AddDetail( "aeste",
             "Die Aeste der Straeucher sind alt und verkrueppelt.");
  AddDetail( "vegetation",
             "Es gedeiht hier wesentlich mehr als am kargen Felsplateau oben.");
  AddDetail( "boden",
             "Am Boden wachsen einige Grasbueschel. Der Pfad am Boden ist nur "
            +"mehr schwer zu erkennen.");
  AddDetail( ({"bueschel", "gras", "grasbueschel"}),
             "Vereinzelt wachsen einige Grasbueschel am Boden.");
  AddDetail( "himmel",
             "Durch das Gestruepp siehst Du den blauen Himmel durchschimmern.");

  AddSmell( DEFAULT_SMELL, "Du atmest tief die frische Bergluft ein und fuehlst "
                          +"Dich sogleich besser.");

  AddExit( "nordosten", ROOM("plat13"));
  AddExit( "suedwesten", ROOM("plat11"));
  
}







