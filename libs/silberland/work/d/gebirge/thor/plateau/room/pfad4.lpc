// Thor@SilberLand
// Gebirgsplateau - Pfad 4
// 1997-03-14

#include "../plateau.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein felsiger Weg" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einem schmalen, steinigen Weg. Rings um Dich tuermen sich "
   +"die riesigen Felsmassen des Gebirges auf. Die Landschaft hier ist karg, felsig "
   +"und unfreundlich. Links und rechts von Dir wachsen einige verkrueppelte "
   +"Baeume und Straeucher aus dem Felsboden heraus. Es liegen einige Felsbrocken am "
   +"Weg, die das Vorankommen erschweren. Der Boden ist noch spaerlich mit etwas Gras "
   +"bewachsen und es blaehst ein kuehler Wind um Deine Ohren. Gleich vor Dir im "
   +"Nordosten ist die steile Felswand, die Du schon von Weitem erkennen konntest. "
   +"Du bist Dir nicht sicher, ob der Weg Dich dort noch irgendwo hinfuehren wird.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( "fels",
             "In dieser Gegend hier ist so ziemlich alles aus Fels.");
  AddDetail( "weg",
             "Der Weg ist sehr steinig und das Vorankommen ist gar nicht so einfach.");
  AddDetail( "vorankommen",
             "Es ist ziemlich muehselig, sich zwischen den Felsbrocken durchzukaempfen.");
  AddDetail( ({"felsbrocken", "brocken"}),
             "Rings um Dich liegen einige grosse Felsbrocken herum, die Dir das "
            +"Vorankommen erschweren.");
  AddDetail( "nordosten",
             "Nordoestlich von Dir kannst Du eine hohe Felswand erkennen.");
  AddDetail( "wind",
             "Dir blaest ein kuehler Wind um die Ohren.");
  AddDetail( "ohren",
             "Deine Ohren sind schon ganz rot vom Wind.");
  AddDetail( ({"felslandschaft", "landschaft"}),
             "Die Landschaft hier ist nur spaerlich bewachsen. Links und rechts von Dir "
            +"siehst Du ein paar verkrueppelte Baeume und Straeucher.");
  AddDetail( ({"baum", "baeume"}),
             "Den Weg entlang siehst Du noch einige Baeume. Irgendwie sehen sie "
            +"unheimlich aus mit ihren verkrueppelten Aesten.");
  AddDetail( "aeste",
             "Die verkrueppelten Aeste erwecken fast den Eindruck, als wuerden sie "
            +"nach Dir greifen.");
  AddDetail( ({"graeser", "gras"}),
             "Der Boden ist nur mehr spaerlich mit etwas Gras bewachsen.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige verdoerrte Buesche stehen noch vereinzelt herum.");
  AddDetail( ({"wand", "felswand"}),
             "Im Nordosten ist die schroffe Felswand, die Du schon von weitem gesehen "
            +"hast. Du bist schon neugierig, was dort wohl sein mag.");
  AddDetail( ({"massen", "felsmassen"}),
             "Die riesigen Felsmassen des Gebirges lassen Dich ehrfuerchtig die "
            +"wilde Natur hier bewundern.");
  AddDetail( "gebirge",
             "Da befindest Du Dich gerade.");
  AddDetail( ({"natur", "naturgewalten", "gewalten"}),
             "Die Naturgewalten hier sind beinahe schon furchteinfloessend.");
  AddDetail( ({"boden", "felsboden"}),
             "Der Boden ist steinig und felsig. Nur selten sieht man etwas Gras "
            +"hervorspriessen.");
  AddDetail( "himmel",
             "Ueber Dir siehst Du den strahlend blauen Himmel.");
  AddSmell( DEFAULT_SMELL, "Du atmest tief die frische Bergluft ein.");
  AddSound( DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");
  AddExit( "nordosten", ROOM("pfad5"));
  AddExit( "westen", ROOM("pfad3"));
}















