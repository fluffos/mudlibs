// Thor@SilberLand
// Felsplateau - Plateau 7
// 1997-03-23

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau");
  SetProp( P_INT_LONG,
    "Richtung Westen hin erstreckt sich vor Dir ein kleines Felsplateau. Westlich von Dir sind "
   +"die beiden Felsbloecke und die Felswand, die Du heraufgeklettert bist. Dir weht ein kuehler "
   +"Wind um die Ohren, sodass Du ein wenig froestelst. Das Felsplateau ist nur sehr karg "
   +"bewachsen. Da und dort sieht man einen einzelnen Baum oder einige Straeucher aus der "
   +"felsigen Landschaft herausragen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( ({"felsplateau", "plateau"}),
             "Vor Dir erstreckt sich nach Westen hin ein kleines Felsplateau. Es ist nur spaerlich "
            +"mit einigen Baeumen und Straeuchern bewachsen.");
  AddDetail( ({"bloecke", "felsbloecke"}),
             "Nordwestlich hinter Dir sind die beiden Felsbloecke, durch die Du gekommen bist. "
            +"Rings um Dich herum liegen noch einige kleinere Felsbloecke und jede Menge Geroell. "
            +"Du solltest also lieber aufpassen, wo Du hintrittst.");
  AddDetail( "geroell",
             "Es liegt ziemlich viel Geroell herum. Pass lieber auf, wo Du hintrittst, damit Du "
            +"nicht stolperst.");
  AddDetail( ({"wand", "felswand"}),
             "Die steile Felswand liegt westlich von Dir. Du kannst sie von hier aus nicht mehr "
            +"sehen.");
  AddDetail( "wind",
             "Ein kuehler Wind weht Dir hier oben um die Ohren. Du beginnst, ein wenig zu froesteln.");
  AddDetail( "ohren",
             "Sie sind schon ganz rot von dem kalten Wind hier oben. Du gehst lieber rasch weiter, "
            +"bevor Du Dir noch einen Schnupfen holst.");
  AddDetail( ({"baum", "baeume"}),
             "Manchmal wachsen noch einige Baeume aus der oeden Felslandschaft empor. Sie haben aber "
            +"nur ganz wenige und verkrueppelte Aeste und sehen dadurch irgendwie unheimlich aus.");
  AddDetail( "aeste",
             "Die Aeste der Baeume sind ganz verkrueppelt durch das unfreundliche Wetter hier oben.");
  AddDetail( "wetter", 
             "Das Wetter hier oben ist nicht gerade einladend.");
  AddDetail( "straeucher",
             "Einige duerre Straeucher gedeihen noch auf dem felsigen Boden hier. Ihre duennen "
            +"Zweige sehen aus wie knochige Finger. Du hast ein unangenehmes Gefuehl bei diesem "
            +"Gedanken.");
  AddDetail( "zweige",
             "Die Zweige der Straeucher sind ganz duerr und kaum mit Blaettern bewachsen.");
  AddDetail( ({"finger", "skelett"}),
             "Die duerren Zweige der Straeucher erinnern Dich an die Finger eines Skelettes.");
  AddDetail( ({"blaetter", "blatt"}),
             "Nur da und dort ist ein vereinzeltes Blatt auf den Straeuchern oder Baeumen zu finden.");
  AddDetail( ({"felslandschaft", "landschaft"}),
             "Die oede Felslandschaft hier oben ist nur spaerlich bewachsen. Hauptsaechlich liegen "
            +"einige Felsbrocken und etwas Geroell am Boden herum.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Einige Felsbrocken liegen am Boden herum. Pass lieber auf, das Du ueber keinen "
            +"darueberstolperst.");
  AddDetail( "boden",
             "Auf dem felsigen Boden liegen jede Menge Geroell und einige kleinere Felsbrocken herum.");
  AddDetail( "himmel",
             "Ueber Dir siehst Du den wolkenlosen, blauen Himmel.");

  AddSound( DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");
  AddSmell( DEFAULT_SMELL, "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich gleich "
           +"besser.");

  AddExit( "nordwesten", ROOM("plat2"));
  AddExit( "osten", ROOM("plat8"));

 }

