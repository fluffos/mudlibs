// Thor@SilberLand
// Felsplateau - Ein Baum
// 1997-04-12

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <living.h>

int ast;

create()
{
  ::create();

  ast=1; 

  SetProp( P_INT_SHORT, "Ein alter Baum");
  SetProp( P_INT_LONG,
    "Du befindest Dich auf dem Baum. Rings um Dich siehst Du nur die verkrueppelte Aeste. "
   +"Sie sind kaum mit Blaettern bewachsen. Ein Stueckchen weiter unter Dir siehst Du den "
   +"felsigen Boden des Felsplateaus.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( "baum",
             "Darauf befindest Du Dich gerade.");
  AddDetail( "blaetter",
             "Der Baum ist nur sehr spaerlich mit Blaettern bewachsen.");
  AddDetail( "boden",
             "Der Boden ist etwas weiter unter Dir. Pass besser auf, dass Du nicht vom Baum "
            +"runterfaellst. Die Landung auf dem felsigen Boden waere wohl doch ziemlich unsanft.");
  AddDetail( ({"plateau", "felsplateau"}),
             "Das befindet sich unter Dir.");
  AddSpecialDetail( "aeste", "unt_aeste" );
  AddSpecialDetail( "ast", "unt_ast");
  
  AddCmd( ({"kletter", "klettere"}), "runter");
  AddCmd( ({"brich", "breche"}), "ast");

}

int ast=1;

runter (str)
{
  notify_fail("Wo willst Du hinklettern?\n");
  if(str=="runter")
    {
    write(BS("Du kletterst vom Baum hinunter.\n"));
    TP->move(ROOM("plat16"), M_GO, "","klettert vom Baum hinunter","kommt von "
   +"einem Baum geklettert");
    return 1;
    }
  else
    return 0;
}

reset()
{
  ::reset();
  ast=1;
}




ast (str)
{
  object ob;
  int weight;
  notify_fail("Was willst Du abbrechen?\n");
  if(str=="ast ab")
    {
    if(ast==0)
      {
      write(BS("Den Ast hat doch schon jemand vor Dir abgebrochen.\n"));
      return 1;
      } 
    else
      {
      ob=clone_object(OBJ("ast"));
      weight=ob->move(this_player(),M_GET);
      if(weight==ME_TOO_HEAVY)
        {
        write(BS("Du versuchst, den Ast aufzuheben, Du kannst ihn aber leider "
                +"nicht mehr tragen.\n"));
        ob->remove();
        return 1;
        }
      else
        {
        write(BS("Du brichst den Ast ab und nimmst ihn sogleich an Dich. "
                +"Vielleicht kannst Du ihn ja noch fuer etwas gebrauchen.\n"));
        say(BS(capitalize(TPN)+" bricht einen Ast ab.\n"));
        ast=0;
        return 1;
        }
      }
    }
  else
    return 0;
}

string unt_aeste()
{
  if(ast==0)
    {
    return BS("Die Aeste des Baumes sind ganz verkrueppelt. Von hier aus kannst "
             +"Du erkennen, dass den kerzengerade gewachsenen Ast leider schon "
             +"jemand vor Dir abgebrochen hat.\n");
    }
  else
    {
    return BS("Die Aeste des Baumes sind ganz verkrueppelt, bis auf einen, "
             +"der wie durch ein Wunder kerzengerade gewachsen ist.\n");
    }
}

string unt_ast()
{
  if(ast==0)
    return BS("Den Ast hat schon jemand vor Dir abgebrochen.\n");
  else
    return BS("Von hier aus koenntest Du versuchen, den Ast abzubrechen.\n");
}















