// Thor@SilberLand
// Gebirgsplateau - Pfad 1
// 1997-03-14

#include "../plateau.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein felsiger Weg" );
  SetProp( P_INT_LONG,
    "Du befindest Dich etwas abseits vom Gebirgspfad. Wenn Du Richtung Westen gehst, "
   +"kommst Du wieder dorthin zurueck. Der felsige Pfad hier fuehrt nach Osten weiter. "
   +"Die Gegend hier ist ziemlich eintoenig. Nur vereinzelt siehst Du noch ein paar "
   +"Baeume und Straeucher aus der unfreundlichen Felslandschaft hervorspriessen. "
   +"Rings um Dich liegen einige Felsbrocken herum. Die Tiere und Pflanzen, die hier "
   +"noch wachsen, haben bestimmt kein leichtes Leben bei diesem rauhen Klima.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( "fels",
             "In dieser Gegend hier ist so ziemlich alles aus Fels.");
  AddDetail( ({ "gebirgspfad", "pfad" }),
             "Wenn Du Dich umdrehst, kannst Du ihn noch erkennen.");
  AddDetail( "richtung",
             "In Richtung Westen liegt der Gebirgspfad, dieser schmale Weg hier fuehrt "
            +"oestlich weiter.");
  AddDetail( "weg",
             "Der Weg ist sehr steinig und das Vorankommen ist gar nicht so einfach.");
  AddDetail( "vorankommen",
             "Es ist ziemlich muehselig, sich zwischen den Felsbrocken durchzukaempfen.");
  AddDetail( ({"felsbrocken", "brocken"}),
             "Rings um Dich liegen einige grosse Felsbrocken herum, die Dir das "
            +"Vorankommen erschweren.");
  AddDetail( "westen",
             "Im Westen liegt der Gebirgspfad.");
  AddDetail( "osten",
             "Richtung Osten fuehrt Dich dieser Weg ins Ungewisse.");
  AddDetail( "gegend" ,
             "Die Gegend hier wirkt ziemlich unfreundlich. Ein kuehler Wind blaest "
            +"Dir um die Ohren und Dir laeuft kurz ein kalter Schauer ueber den Ruecken.");
  AddDetail( "wind",
             "Dir blaest ein kuehler Wind um die Ohren.");
  AddDetail( "ohren",
             "Deine Ohren sind schon ganz rot vom kuehlen Wind.");
  AddDetail( ({"schauer", "ruecken"}),
             "Dir laeuft ein kalter Schauer ueber den Ruecken. Es ist doch etwas kuehl hier.");
  AddDetail( ({"felslandschaft", "landschaft"}),
             "Die Landschaft hier ist nur spaerlich bewachsen. Selten sieht man einen Baum "
            +"oder ein paar Graeser aus dem Boden spriessen.");
  AddDetail( ({"baum", "baeume"}),
             "Nur vereinzelt ragen noch ein paar Baeume aus der Felslandschaft hervor.");
  AddDetail( ({"graeser", "gras"}),
             "Der Boden ist nur mehr spaerlich mit etwas Gras bewachsen.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige verdoerrte Buesche stehen noch vereinzelt herum.");
  AddDetail( ({"zeug", "gruenzeug", "pflanzen"}),
             "Nur wenig Gruenzeug vegetiert in dieser felsigen Landschaft.");
  AddDetail( ({"tier", "tiere", "lebewesen"}),
             "Die Tiere hier duerften kein leichtes Leben fuehren. Sie muessen um jeden "
            +"Bissen Beute kaempfen.");
  AddDetail( ({"beute", "bissen"}),
             "Die Tiere hier muessen um jeden Bissen Beute kaempfen, um ueberleben zu "
            +"koennen.");
  AddDetail( "leben",
             "Das Leben hier oben im Gebirge ist bestimmt nicht einfach.");
  AddDetail( "gebirge",
             "Da befindest Du Dich gerade.");
  AddDetail( "klima",
             "Das Klima hier in den Bergen ist sehr rauh. Nur die zaehsten Lebewesen haben "
            +"hier eine Chance, zu ueberleben.");
  AddDetail( ({"berg", "berge"}),
             "Rings um Dich tuermen sich hohe Gebirgsmassen auf.");
  AddDetail( ({"massen", "gebirgsmassen"}),
             "Die riesigen Gebirgsmassen lassen Dich erfuehrchtig die wilde Natur hier "
            +"bewundern.");
  AddDetail( ({"natur", "naturgewalten", "gewalten"}),
             "Die Naturgewalten hier sind beinahe schon furchteinfloessend.");
  AddDetail( "boden",
             "Der Boden ist steinig und felsig.");
  AddDetail( "himmel",
             "Ueber Dir siehst Du den strahlend blauen Himmel.");
  AddSmell( DEFAULT_SMELL, "Du atmest tief die frische Bergluft ein.");
  AddSound( DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");
  AddExit( "suedwesten", "/d/gebirge/dusty/weg/l27.lpc");
  AddExit( "nordosten", ROOM("pfad2"));
}

