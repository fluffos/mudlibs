// Thor@SilberLand
// Felsplateau - Plateau 5
// 1997-03-22

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau");
  SetProp( P_INT_LONG,
    "Das Felsplateau erstreckt sich vor Dir nach Westen hin. Nur mehr selten sieht man einige "
   +"verkrueppelte Baeume und Straeucher aus dem felsigen Boden wachsen. Ausser dem Felsgeroell, "
   +"das massenhaft am Boden herumliegt, gibt es hier nicht viel zu sehen. Nordwestlich "
   +"von Dir steht ein einzelner, verkrueppelter Baum. Irgendetwas an ihm erweckt Deine "
   +"Aufmerksamkeit. Hoch ueber Dir hoerst Du einen Adler im Himmel kreischen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( ({"felsplateau", "plateau"}),
             "Du stehst auf einem kleinen Felsplateau. Ausser einigen verkrueppelten, alten "
            +"Baeumen und Straeuchern gibt es hier nicht viel zu sehen.");
  AddDetail( "baeume",
             "Manchmal wachsen noch einige vereinzelte Baeume aus dem felsigen Boden. Ein Baum "
            +"nordwestlich von Dir erweckt besonders Deine Aufmerksamkeit.");
  AddDetail( "baum",
             "Der Baum hat ganz verkrueppelte Aeste. Du muesstest schon naeher ran gehen, um "
            +"etwas genaueres zu erkennen.");
  AddDetail( ({"irgendetwas", "aufmerksamkeit", "etwas"}),
             "Du muesstest schon naeher rangehen, wenn Du wissen moechtest, was es mit diesem "
            +"Baum auf sich hat.");
  AddDetail( "aeste",
             "Die Aeste der Baeume sind ganz verkrueppelt durch das unfreundliche Wetter hier "
            +"oben.");
  AddDetail( "wetter",
             "Das Wetter hier oben ist rauh und unfreundlich.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige karge Buesche mit duennen Zweigen lockern die Felslandschaft ein wenig auf.");
  AddDetail( "zweige",
             "Die Buesche haben nur sehr wenige und duenne Zweige."); 
  AddDetail( ({"landschaft", "felslandschaft"}),
             "Ja, die Landschaft auf einem Felsplateau ist felsig.");
  AddDetail( ({"geroell", "felsgeroell"}),
             "Am Boden liegt jede Menge Felsgeroell herum. Pass besser auf, dass Du nicht "
            +"darueber stolperst.");
  AddDetail( "boden",
             "Der Boden ist karg und felsig. Manchmal sieht man einige Grashalme zwischen dem "
            +"Geroell hervorspriessen.");
  AddDetail( ({"halme", "grashalme"}),
             "Zwischen dem vielen Felsgeroell sieht man manchmal einige Grashalme herauswachsen.");  
  AddDetail( "himmel",
             "Du schaust ueber Dich in den strahlend blauen Himmel. Ueber Dir zieht ein Adler "
            +"seine Kreise.");
  AddDetail( ({"adler", "kreise"}),
             "Hoch ueber Dir siehst Du einen Adler seine Kreise ziehen.");
  AddSmell(DEFAULT_SMELL, "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich "
                         +"besser.");
  AddSound(DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes. Ueber Dir kreischt ein Adler "
                         +"im Himmel.");
  AddSound("adler", "Du hoerst einen Adler hoch ueber Dir kreischen.");

  AddExit( "westen", ROOM("plat5"));
  AddExit( "nordwesten", ROOM("plat16"));
  AddExit( "osten", ROOM("plat9"));
 }
