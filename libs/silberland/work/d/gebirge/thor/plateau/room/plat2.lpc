// Thor@SilberLand
// Felsplateau - Plateau 2
// 1997-03-22

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau");
  SetProp( P_INT_LONG,
    "Vor Dir erstreckt sich ein kleines Felsplateau. Suedwestlich von Dir sind die beiden Felsbloecke, "
    "durch die Du gekommen bist. Der kuehle Wind pfeift Dir hier noch heftiger um die Ohren "
    "und hier oben siehst Du kaum mehr etwas, das Dir Schutz davor bieten koennte. Man sieht "
    "nur mehr sehr selten einige verkrueppelte Baeume und Straeucher aus dem felsigen Boden "
    "wachsen. Ausser dem Felsgeroell, das massenhaft am Boden herumliegt, gibt es hier nicht "
    "viel zu sehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( ({"felsplateau", "plateau"}),
             "Du stehst am Rand eines kleinen Felsplateaus. Im Suedwesten sind die beiden "
             "Felsbloecke, durch die Du gekommen bist. Ausser einigen verkrueppelten, alten "
             "Baeumen und Straeuchern gibt es hier nicht viel zu sehen.");
  AddDetail( ({"bloecke", "felsbloecke"}),
             "Suedwestlich von Dir sind die beiden Felsbloecke, wo Du die Felswand wieder "
             "hinunterklettern kannst.");
  AddDetail( "rand",
             "Du befindest Dich hier am Rand eines Felsplateaus.");
  AddDetail( ({"wand", "felswand"}),
             "Hinter den beiden Felsbloecken suedwestlich von Dir ist wieder die Felswand, die "
             "Du hinunterklettern kannst.");
  AddDetail( "wind",
             "Ein kuehler Wind weht Dir um die Ohren. Dich froestelt, daher gehst Du besser "
             "schnell weiter, bevor Dir noch zu kalt wird, vom vielen Herumstehen.");
  AddDetail( "ohren",
             "Du hast schon ganz rote Ohren vom kalten Wind.");
  AddDetail( "schutz",
             "Nur einige Baeume oder Straeucher koennen Dir noch etwas Schutz vor dem Wind "
             "bieten.");
  AddDetail( ({"baeume", "baum"}),
             "Du siehst manchmal noch einen alten Baum aus dem felsigen Boden herausragen. "
             "Die Baeume sind klein und haben ganz verkrueppelte Aeste.");
  AddDetail( "aeste",
             "Die Aeste der Baeume sind ganz verkrueppelt durch das unfreundliche Wetter hier "
             "oben.");
  AddDetail( "wetter",
             "Das Wetter hier oben ist rauh und unfreundlich.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige karge Buesche mit duennen Zweigen lockern die Felslandschaft ein wenig auf.");
  AddDetail( "zweige",
             "Die Buesche haben nur sehr wenige und duenne Zweige."); 
  AddDetail( ({"landschaft", "felslandschaft"}),
             "Ja, die Landschaft auf einem Felsplateau ist felsig.");
  AddDetail( ({"geroell", "felsgeroell"}),
             "Am Boden liegt jede Menge Felsgeroell herum. Pass besser auf, dass Du nicht "
             "darueber stolperst.");
  AddDetail( "boden",
             "Der Boden ist karg und felsig. Manchmal sieht man einige Grashalme zwischen dem "
             "Geroell hervorspriessen.");
  AddDetail( ({"halme", "grashalme", "gras"}),
             "Zwischen dem vielen Felsgeroell sieht man manchmal einige Grashalme herauswachsen.");
  AddDetail( "himmel",
             "Du schaust ueber Dich in den strahlend blauen Himmel. Er ist wunderschoen, stellst "
             "Du fest.");
  AddSmell(DEFAULT_SMELL, "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich "
                          "besser.");
  AddSound(DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");

  AddExit( "norden", ROOM("plat3"));
  AddExit( "suedosten", ROOM("plat7"));
  AddExit( "suedwesten", ROOM("plat1"));
 }
