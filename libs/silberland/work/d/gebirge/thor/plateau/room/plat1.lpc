// Thor@SilberLand
// Felsplateau - Plateau 1
// 1997-03-02

#include "../plateau.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau" );
  SetProp( P_INT_LONG, BS(
    "Du bist hier am oberen Rand der Felswand angekommen. Du blickst Dich um, "
   +"kannst allerdings nur einige riesige Felsbloecke rings um Dich herum sehen, die "
   +"Dir den Ausblick versperren. Hier weht der Wind noch ein wenig kaelter als unten am "
   +"Weg. Die Landschaft hat sich kaum veraendert, nur das alles noch ein wenig felsiger "
   +"erscheint. Direkt vor Dir siehst Du zwei grosse Felsbloecke, die vor Dir in den "
   +"Himmel ragen. Zwischen den Felsbloecken ist ein schmaler Spalt, durch den "
   +"Du Richtung Nordosten hindurchgehen kannst.\n") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 3]) );

  AddDetail( "rand",
             "Du gehst besser nicht zu nahe an den Rand der Felswand. Dir wird schon "
            +"allein beim Gedanken an die Kletterei ganz schwindlig.");
  AddDetail( "kletterei",
             "Schwieriges Unterfangen, Felswaende hinaufzusteigen.");
  AddDetail( ({"felswand", "wand"}),
             "Du stehst am Rand der Felswand, an der Du gerade heraufgeklettert bist. "
            +"Wenn Du Dich umdrehst und daran hinunterblickst, wird Dir fast schwindlig. "
            +"Du beschliesst, dass es wohl besser ist, wenn Du Dich wieder umdrehst.");
  AddDetail( "wind",
             "Hier oben blaest der Wind noch ein bisschen schaerfer, als unten. "
             "Es ist ausserdem noch um einiges kuehler.");
  AddDetail( ({"weg", "knie"}),
             "Du bekommst jetzt schon weiche Knie, wenn Du an die Kletterpartie nach unten "
            +"denkst.");
  AddDetail( ({"partie", "kletterpartie"}),
             "Das Runterklettern duerfte wohl genauso schwierig werden, wie das Raufklettern. "
             "Du bekommst schon ganz weiche Knie, wenn Du nur daran denkst.");
  AddDetail( ({"runterklettern", "klettern"}),
             "Du denkst besser nicht naeher darueber nach, wie Du von der Felswand wieder "
            +"runterkommst.");
  AddDetail( ({"landschaft", "vergleich"}),
             "Die Landschaft hat sich im Vergleich zu unten nicht sehr veraendert. Es ist "
            +"nur noch ein wenig unfreundlicher hier oben.");
  AddDetail( "boden",
             "Am Boden liegen nur Geroell und Steine herum, hie und da siehst Du ein paar "
             "Graeser aus dem Boden spriessen.");
  AddDetail( ({"geroell", "steine"}),
             "Das Geroell, das am Boden herumliegt, ist vermutlich von den Felsbloecken "
            +"abgesplittert.");
  AddDetail( ({"gras", "graeser", "halme", "grashalme"}),
             "Nur ein paar Grashalme wachsen noch hier oben.");
  AddDetail( ({"felsbloecke", "bloecke"}),
             "Zwei maechtige Felsbloecke ragen vor Dir in den Himmel hinauf. Zwischen den "
            +"beiden Bloecken kannst Du einen schmalen Spalt erkennen, der nach Nordosten "
            +"fuehrt.");
  AddDetail( "spalt",
             "Der Spalt fuehrt weiter Richtung Nordosten. Er ist gerade breit genug, dass "
            +"Du bequem durchgehen kannst.");
  AddDetail( "himmel",
             "Ueber Dir ist der strahlend blaue Himmel.");
  AddDetail( "ausblick",
             "Der wird Dir von zwei grossen Felsbloecken vor Dir versperrt.");

  AddSmell(DEFAULT_SMELL, "Du atmest einmal kraeftig die frische Bergluft ein und "
                         +"fuehlst Dich sogleich besser.");
  AddSound(DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");

  AddExit( "nordosten", ROOM("plat2"));
  AddCmd(({"kletter", "klettere"}), "runter");
}  

runter(str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="runter" || str=="hinunter")
    {
    write(BS("Du kletterst die Felswand hinunter.\n"));
    TP->move(ROOM("pfad5"), M_GO, "","klettert die Felswand hinunter","kommt die Felswand "
            +"heruntergeklettert");
    return 1;
    }
  else
    return 0;
}















