// Thor@SilberLand
// Felsplateau - Plateau 3
// 1997-03-22

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau");
  SetProp( P_INT_LONG,
   "Das Felsplateau erstreckt sich vor Dir nach Westen hin. Nur mehr selten sieht man einige "
   +"verkrueppelte Baeume und Straeucher aus dem felsigen Boden wachsen. Es liegt hier etwas "
   +"weniger Geroell am Boden herum, als weiter westlich. Suedoestlich von Dir fuehrt ein "
   +"kurzer Abhang zu einer kleine Senke hinunter.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( ({"felsplateau", "plateau"}),
             "Du stehst auf einem kleinen Felsplateau. Ausser einigen verkrueppelten, alten "
            +"Baeumen und Straeuchern gibt es hier nicht viel zu sehen.");
  AddDetail( ({"baeume", "baum"}),
             "Du siehst manchmal noch einen alten Baum aus dem felsigen Boden herausragen. "
             "Die Baeume sind klein und haben ganz verkrueppelte Aeste.");
  AddDetail( "aeste",
             "Die Aeste der Baeume sind ganz verkrueppelt durch das unfreundliche Wetter hier "
            +"oben.");
  AddDetail( "wetter",
             "Das Wetter hier oben ist rauh und unfreundlich.");
  AddDetail( ({"straeucher", "buesche"}),
             "Einige karge Buesche mit duennen Zweigen lockern die Felslandschaft ein wenig auf.");
  AddDetail( "zweige",
             "Die Buesche haben nur sehr wenige und duenne Zweige."); 
  AddDetail( ({"landschaft", "felslandschaft"}),
             "Ja, die Landschaft auf einem Felsplateau ist felsig.");
  AddDetail( ({"geroell", "felsgeroell"}),
             "Es liegt hier nicht mehr so viel Felsgeroell am Boden herum. Der Weg ist hier "
            +"wesentlich begehbarer als zuvor.");
  AddDetail( "weg",
             "Es wird zusehens einfacher, dem Weg zu folgen. Es liegt wesentlich weniger "
            +"Geroell herum, auf dass man achten muss.");
  AddDetail( "boden",
             "Der Boden ist karg und felsig. Manchmal sieht man einige Grashalme zwischen dem "
            +"Geroell hervorspriessen.");
  AddDetail( ({"halme", "grashalme"}),
             "Zwischen dem vielen Felsgeroell sieht man manchmal einige Grashalme herauswachsen.");
  AddDetail( "himmel",
             "Du schaust ueber Dich in den strahlend blauen Himmel. Er ist wunderschoen, stellst "
            +"Du fest.");
  AddDetail( "abhang",
             "Gleich suedoestlich von Dir fuehrt ein kurzer Abhang zu einer kleinen Senke hinunter.");
  AddDetail( "senke",
             "Suedoestlich von Dir siehst Du eine kleine Senke. Wenn Du etwas Genaueres erkennen "
            +"moechtest, musst Du allerdings schon naeher rangehen.");
  AddSmell(DEFAULT_SMELL, "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich "
                         +"besser.");
  AddSound(DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");

  AddExit( "suedosten", ROOM("plat14"));
  AddExit( "westen", ROOM("plat6"));
  
 }
