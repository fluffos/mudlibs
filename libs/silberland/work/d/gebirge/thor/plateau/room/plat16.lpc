// Thor@SilberLand
// Felsplateau - Plateau 16
// 1997-03-23

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Felsplateau");
  SetProp( P_INT_LONG,
    "Das Felsplateau erstreckt sich vor Dir nach Westen hin. Nur mehr selten sieht man einige "
    "verkrueppelte Baeume und Straeucher aus dem felsigen Boden wachsen. Ausser dem Felsgeroell, "
    "das massenhaft am Boden herumliegt, gibt es hier nicht viel zu sehen. Gleich links neben "
    "Dir steht ein einzelner, verkrueppelter Baum, rechts von Dir siehst Du einige karge Buesche.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( ({"felsplateau", "plateau"}),
             "Du stehst auf einem kleinen Felsplateau. Ausser einigen verkrueppelten, alten "
             "Baeumen und Straeuchern gibt es hier nicht viel zu sehen.");
  AddDetail( "baeume",
             "Manchmal wachsen noch einige vereinzelte Baeume aus dem felsigen Boden. Ein Baum "
             "gleich neben Dir erweckt besonders Deine Aufmerksamkeit.");
  AddDetail( ({"geroell", "felsgeroell"}),
             "Am Boden liegt jede Menge Felsgeroell herum. Pass besser auf, dass Du nicht "
             "darueber stolperst.");
  AddDetail( ({"boden", "felsboden"}),
             "Der Boden ist karg und felsig. Manchmal sieht man einige Grashalme zwischen dem "
             "Geroell hervorspriessen.");
  AddDetail( ({"halme", "grashalme", "gras"}),
             "Zwischen dem vielen Felsgeroell sieht man manchmal einige Grashalme herauswachsen.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Suedlich von Dir versperren Dir einige groessere Felsbrocken den Weg.");
  AddDetail( "weg",
             "Der Weg, auf dem Du Dich befindest, ist ganz felsig und voller Geroell.");             
  AddDetail( "himmel",
             "Du schaust ueber Dich in den strahlend blauen Himmel. Er ist wunderschoen, stellst "
             "Du fest.");
  AddDetail( ({"busch", "strauch", "straeucher", "buesche"}),
             "Rechts von Dir wachsen einige Buesche aus dem Felsboden heraus. Nur selten waechst "
             "ein gruenes Blatt auf den verkrueppelten Zweigen.");
  AddDetail( ({"blatt", "blaetter", "zweige"}),
             "Die Buesche haben zum Grossteil karge Zweige. Nur manchmal wachsen noch einige "
             "Blaetter darauf.");
  AddDetail( "baum",
             "Ein niedriger, verkrueppelter Baum steht links von Dir. Er hat zum Grossteil "
             "ganz krumme Aeste, nur ein Ast ist kerzengerade gewachsen.");
  AddDetail( "aeste",
             "Die Aeste des Baumes sind ganz verkrueppelt, bis auf einen, der wie durch ein "
             "Wunder kerzengerade gewachsen ist. ");
  AddDetail( "ast",
             "Der Ast ist ganz gerade und nicht vertrocknet, wie die anderen. Wenn Du "
             "rankommst, koenntest Du ihn vielleicht abbrechen.");
  AddSmell(DEFAULT_SMELL, "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich "
                          "besser.");
  AddSound(DEFAULT_SOUND, "Du hoerst das Pfeifen des Windes.");

  
  AddCmd( ({"kletter", "klettere"}), "baum");
  AddCmd( ({"brich", "breche"}), "ast");

  AddExit( "suedwesten", ROOM("plat4"));
  AddExit( "sueden", ROOM("plat5"));
  AddExit( "suedosten", ROOM("plat6"));
}


baum (str)
{
  notify_fail("Wo willst Du hinklettern?\n");
  if (str=="auf baum"||str=="baum"||str=="auf baum hinauf"||str=="baum hoch")
    {
    write(BS("Du kletterst auf den Baum.\n"));
    TP->move(ROOM("baum"),M_GO,"","klettert auf den Baum", "klettert herauf");
    return 1;
    }
  else
    return 0;

}

ast (str)
{
notify_fail("Was willst Du abbrechen?\n");
  if (str=="ast ab")
    {
    write(BS("Du kommst von hier an den Ast nicht ran.\n"));
    return 1;
    }
  else
    return 0;
}


