// Thor@SilberLand
// Felsplateau - Abhang
// 1997-03-19

#include "../plateau.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kurzer Abhang" );
  SetProp( P_INT_LONG, 
    "Du bist an einem kleinen Abhang angelangt. Nordoestlich von Dir "
    "ist eine kleine Senke und nach Westen erstreckt sich das Felsplateau. "
    "Hier am Abhang hat der Wind ein wenig nachgelassen. Es ist etwas "
    "waermer als am Felsplateau und es beginnen wieder einige Graeser am "
    "Boden zu wachsen. Gleich neben Dir steht ein kleiner Baum der etwas "
    "sonderbar aussieht. In der Senke sind einige groessere Flecken Gras "
    "und ein paar Buesche und Straeucher zu erkennen. Du siehst von hier "
    "aus einen kleinen, dunklen Fleck in der Mitte der Senke." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 12]) );

  AddDetail( "abhang",
             "Du bist bei einem kleinen Abhang, der zu einer Senke "
             "hinunterfuehrt. Es ist hier etwas angenehmer, als oben am " 
             "Felsplateau und es beginnen auch wieder einige Pflanzen zu "
             "spriessen.");
  AddDetail( "pflanzen",
             "Das Gras beginnt hier am Abhang wieder zu wachsen und im Sueden "
             "steht sogar ein kleiner Baum.");
  AddDetail( "senke",
             "Der Abhang fuehrt zu einer kleinen Senke im Osten. Die Senke "
             "scheint ziemlich windgeschuetzt zu sein. In der Mitte kannst "
             "Du einen kleinen, dunkeln Fleck erkennen.");
  AddDetail( ({"plateau", "felsplateau"}),
             "Das Felsplateau ist ein bisschen weiter im Nordwesten. Dir "
             "gefaellt es hier aber eigentlich besser, vor allem, weil es "
             "spuerbar waermer ist, und daher entschliesst Du Dich, Dich noch "
             "etwas genauer umzusehen.");
  AddDetail( "wind",
             "Nur noch ein etwas staerkeres Lueftchen ist spuerbar, der "
             "Abhang ist doch recht gut vor dem Wind geschuetzt.");
  AddDetail( "lueftchen",
             "Im Gegensatz zum Felsplateau weht hier nur noch ein schwacher "
             "Wind.");
  AddDetail( ({"graeser", "grasbueschel", "bueschel"}),
             "Die Grasbueschel spriessen hier wieder etwas zahlreicher aus "
             "dem kargen Boden.");
  AddDetail( ({"gras", "flecken"}),
             "In der Senke ist das Klima wieder freundlicher, sodass sie "
             "sogar etwas grasbewachsen ist.");
  AddDetail( "klima",
             "Es wird wieder zusehens waermer hier und der Wind weht ebenfalls "
             "nicht mehr so scharf.");
  AddDetail( "baum", 
             "Gleich neben Dir steht ein kleiner Baum. Er sieht "
             "irgendwie lustig aus, so wie er gewachsen ist. An der Seite, "
             "die dem Felsplateau zugekehrt ist, hat er nur einige kurze, "
             "verkrueppelte, kahle Aeste. Auf der anderen Seite jedoch hat "
             "er weit ausladende Aeste. Er erinnert Dich an einen "
             "Wegweiser der nach Nordosten zeigt.");
  AddDetail( "aeste", 
             "Der Baum hat auf einer Seite nur kurze, verkrueppelte Aeste, "
             "auf der anderen dafuer aber umso laengere.");
  AddDetail( ({"wegweiser", "weiser"}),
             "Der Baum sieht aus wie ein Wegweiser, der Richtung Nordosten "
             "zeigt. Dort scheint sich wohl irgendein Geheimnis zu verbergen. "
             "Was Dich da wohl erwarten mag?");
  AddDetail( ({"buesche", "straeucher"}),
             "In der Senke wachsen sogar wieder einige Buesche und Straeucher. "
             "Alles wirkt wieder wesentlich freundlicher hier unterhalb des "
             "Plateaus.");
  AddDetail( ({"fleck", "mitte"}),
             "In der Mitte der Senke siehst Du einen kleinen, dunklen Fleck. "
             "Es sieht aus, als haette dort jemand vor kurzem ein Feuer "
             "angezuendet, mehr kannst Du von hier allerdings nicht erkennen.");
  AddDetail( "boden", 
             "Der Boden ist mit zahlreichen Grasbuescheln bewachsen, "
             "allerdings liegen auch noch eine ganze Menge Steine herum. "
             "Du solltest aufpassen, dass Du den Abhang nicht "
             "hinunterstolperst.");
  AddDetail( "himmel", 
             "Der Himmel ueber Dir ist strahlend blau und fast wolkenlos.");
  AddDetail( ({"steine", "menge"}),
             "Du solltest aufpassen beim Hinuntergehen, damit Du nicht ueber "
             "einen der Steine, die am Boden liegen, stolperst.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst das Wispern des Windes noch vom Felsplateau herunter.");
    
  AddSmell(DEFAULT_SMELL,
    "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich "
    "etwas besser.");

  AddExit( "nordosten", ROOM("plat10"));
  AddExit( "nordwesten", ROOM("plat17"));
}













