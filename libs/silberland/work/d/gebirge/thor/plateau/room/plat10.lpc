// Thor@SilberLand
// Gebirgsplateau - Eine Senke
// 1997-03-05

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>
#include <lightsource.h>
#include <moving.h>
#include <living.h>


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Senke");
  SetProp( P_INT_LONG,
    "Du bist hier in einer kleinen Senke. Es ist etwas waermer hier. Das kommt warscheinlich "
    "daher, weil man hier vor dem kuehlen Wind geschuetzt ist. Hier wirkt alles etwas "
    "freundlicher, der Boden ist grasbewachsen und weiter Richtung Osten kannst Du einige "
    "Straeucher erkennen. Richtung Westen kommst Du wieder auf das Gebirgsplateau zurueck. "
    "In der Mitte der Senke, an einer besonders windgeschuetzten Stelle, siehst Du eine "
    "Feuerstelle." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 8]) );
  SetProp(P_HOLZ, 0);

  AddDetail( ({"senke", "vertiefung"}),
             "Du befindest Dich in einer Vertiefung des Felsplateaus. Es ist hier "
             "wesentlich angenehmer als oben auf der windigen Ebene.");
  AddDetail( ({"westen", "felsplateau", "gebirgsplateau", "plateau", "ebene"}),
             "Richtung Westen kommst Du wieder auf das Felsplateau zurueck.");
  AddDetail( "wind",
             "Hier unten ist man sehr gut windgeschuetzt und es ist auch etwas waermer. "
             "Daher wachsen warscheinlich auch etwas mehr Pflanzen als oben.");
  AddDetail( "boden",
             "Der Boden ist nicht mehr so felsig als auf der Ebene. Es waechst Gras, "
             "manchmal liegen einige Steine herum.");
  AddDetail( "steine",
             "Einige groessere Steine liegen in der Senke verstreut. Wahrscheinlich sind "
             "sie aus den Felsen herausgebrochen.");
  AddDetail( "felsen",
             "Die Senke ist bei weitem nicht so felsig wie das Gebirgsplateau.");
  AddDetail( ({"gras", "pflanzen"}),
             "Der Boden ist grasbewachsen und im Osten ist eine kleine Gruppe von "
             "Straeuchern. Es waechst hier etwas mehr als auf der Ebene.");
  AddDetail( ({"gruppe", "straeucher", "osten"}),
             "Wenn Du weiter nach Osten schaust, kannst Du etwas Gebuesch erkennen.");
  AddDetail( "gebuesch",
             "Bei genauerem Hinsehen scheinst Du einen verwachsenen Pfad zwischen den "
             "Straeuchern zu erkennen.");
  AddDetail( "pfad",
             "Es scheint ein schmaler Pfad zwischen den Straeuchern durchzufuehren. Er muss "
             "lange nicht mehr benutzt worden sein, er ist schon ganz verwachsen.");
  AddDetail( "mitte",
             "In der Mitte der Senke ist eine verloschene Feuerstelle.");
  AddDetail( ({"zeit", "tag"}),
             "Es kann hoechstens einen Tag her sein, dass jemand dieses Feuer entfacht hat.");
  AddDetail( ({"holzstuecke", "stuecke"}),
             "Die Holzstuecke in der Feuerstelle sind ganz verkohlt. Sie duerften kaum mehr "
             "brennen.");
  AddDetail( ({"geaest", "zunder"}),
             "Das Geaest neben der Feuerstelle ist knochentrocken. Wenn man es anzuendet, "
             "muesste es brennen wie Zunder.");
  AddDetail( "hunger",
             "Dir knurrt der Magen.");
  AddDetail( "magen",
             "Er knurrt.");
  AddDetail( "himmel",
             "Ueber Dir siehst Du den strahlend blauen Himmel.");

  AddSound( DEFAULT_SOUND,
            "Du hoerst ein unheimliches Knurren, das aus oestlicher Richtung zu kommen "
            "scheint.");
  AddSound( "knurren",
	    "Es klingt sehr dumpf und verspricht nur Unheil.");
  AddSmell( DEFAULT_SMELL, "Du atmest die frische Bergluft ein und fuehlst Dich "
                           "sogleich besser.");

  AddSpecialDetail( ({"stelle", "feuerstelle"}), "unt_feuerstelle");
  AddSpecialDetail( "feuer", "unt_feuer");

  AddExit( "norden", ROOM("plat14"));
  AddExit( "suedosten", ROOM("plat11"));
  AddExit( "suedwesten", ROOM("plat15"));

  AddCmd( "zuende", "feuer");
  AddCmd( "brate", "braten");
  
  AddRoomMessage( ({"Nicht allzuweit entfernt hoerst Du ein unheimliches Knurren.\n"}),25);
}

int holz=0;
int feuer=0;
object nix;
object obj;

int feuer (string str)
{
  object ob, holzgestruepp;
  notify_fail("Was willst Du womit anzuenden?\n");
  if(str=="feuer an")
    {
    if(TO->QueryProp(P_HOLZ)==1)
      {
      write(BS("Wie waers, wenn Du das Holzgestruepp anzuendest?\n"));
      holz=1;
      return 1;
      }
    else
      {
      write(BS("Dazu brauchst Du wohl etwas Holzgestruepp.\n"));
      return 1;
      }
    } 

  if(str=="gestruepp an"||str=="holzgestruepp an")
    {
    if(TO->QueryProp(P_HOLZ)==1)
      {
      write(BS("Womit willst Du das Holzgestruepp anzuenden?\n"));
      holz=1;
      return 1;
      }
    if(holzgestruepp=present("gestruepp",TP))
      {
      write(BS("Du musst das Gestruepp zuerst in die Feuerstelle legen.\n"));
      return 1;
      }
    else
      write(BS("Du hast ja gar kein Gestruepp, das Du anzuenden koenntest.\n"));
      return 1;
    }

  if(str=="gestruepp mit fackel an"||str=="holzgestruepp mit fackel an")
    {
    if(ob=present("fackel",TP))
      {
      if(ob->QueryProp(P_LIGHTED))
        {
        if(TO->QueryProp(P_HOLZ)==1)
          {
          holz=1;
          write(BS("Du zuendest das Feuer an. Es beginnt froehlich zu flackern.\n"));
          say(BS(TPN+" zuendet ein Feuer an, das froehlich zu flackern beginnt.\n"));
          feuer=1;
          call_out("loeschen", 200);
          return 1;
          }
          else
            write(BS("Aber da liegt ja gar kein Holzgestruepp in der Feuerstelle, das Du "
                     "anzuenden koenntest.\n"));
            return 1;
        }
        else
          write(BS("Aber Deine Fackel brennt ja gar nicht.\n"));
          return 1;
       } 
      else
         write(BS("Du hast ja gar keine Fackel zum anzuenden.\n"));
         return 1;
    }
  else
    return 0;
}



int braten (string str)
{
  object ob, objc;
  notify_fail("Was willst Du wo braten?\n");
  if(str=="kaninchen")
     {
     if(ob=present("kaninchen auf spiess",TP))
	{
        if(feuer==1)
          {
          write(BS("Du braetst das Kaninchen ueber dem Feuer. Ein leckerer Duft steigt auf, "
                  "der Dir das Wasser im Munde zusammenrinnen laesst. Du kannst gar nicht "
                  "erwarten, das Kaninchen zu verspeisen.\n"));
          say(BS(TPN+" braet ein Kaninchen ueber dem Feuer. Es riecht wirklich lecker, "
                 "sodass Dir das Wasser schon im Mund zusammenrinnt. Am liebsten wuerdest "
                 "Du auch so ein Kaninchen zum braten haben.\n"));
          nix=clone_object(OBJ("nixtun"));
          nix->move(TP, M_NOCHECK);
          call_out("rascheln", 6);
          call_out("puma", 15);
          ob->remove();
          clone_object(OBJ("hbraten"))->move(TP, M_NOCHECK);
          return 1;
	  }
        else
          write(BS("Aber das Feuer brennt ja gar nicht.\n"));
          return 1;
	}
      else if(objc=present("totes kaninchen",TP))
	{
        write(BS("Du musst das Kaninchen schon auf einen Spiess spiessen, um es braten "
                 "zu koennen.\n"));
        return 1; 
        }
      else
        write(BS("Aber Du hast ja; gar kein Kaninchen, dass Du braten koenntest.\n"));
        return 1;
      }    
    else
      return 0;
}

void rascheln()
{
  write(BS("Du hoerst ein unheimliches Rascheln aus dem Gebuesch hinter Dir. Hier "
           "scheint sich irgendein Tier zu verbergen. Dir wird schon Angst und "
           "Bange.\n"));
}

void puma()
{
  object ob;
  nix->remove();
  if(!present("hquest", TP) && !present("\nquestliste", TP))
    {
      if(ob=present("puma", environment(TP)))
	ob->Kill(TP);
      else
	{
	(ob=clone_object(NPC("puma")))->move(TO, M_GO);
	ob->Kill(TP);
	}
    }
  else
    {
    write(BS("Du haeltst einen saftigen Hasenbraten in Deinen Haenden. Dir "
             "laeuft das Wasser im Mund zusammen.\n"));
    }
}

void loeschen()
{
  if(feuer==1)
    {
    feuer=0;
    holz=0;
    SetProp(P_HOLZ, 0);
    }
}


string unt_feuerstelle()
{
  if(feuer==0 && (TO->QueryProp(P_HOLZ))==1)
    return BS("In der Feuerstelle liegt ein kleiner Haufen trockenes Gestruepp.\n");
  if((feuer==0) && (holz==0))
    {
    return BS("Vor nicht allzulanger Zeit muss jemand hiergewesen sein, der dieses Feuer "
             "angezuendet hat. Einige verkohlte Holzstuecke liegen noch darin, daneben "
             "liegt noch etwas trockenes Geaest. Du verspuerst ploetzlich etwas Hunger. "
             "Wenn Du das Feuer wieder anzuenden koenntest, kannst Du Dir vielleicht etwas "
             "braten.\n");
    }
  if((feuer==1) && (holz==1))
    return BS("In der Feuerstelle flackert ein froehliches Feuer.\n");
}

string unt_feuer()
{
  if(feuer==0)
    return BS("Es ist erloschen. Du koenntest ja versuchen, das Feuer wieder anzuzuenden.\n");
  else
    return BS("In der Feuerstelle flackert ein froehliches Feuer.\n");
}


