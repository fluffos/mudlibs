// Thor@SilberLand
// Gebirgsplateau - Ein Hoehleneingang
// 1997-03-11

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <living.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein verwachsener Hoehleneingang");
  SetProp( P_INT_LONG,
    "Hier ist der verwachsene Pfad zu Ende. Vor Dir ist der grosse Gestruepphaufen, den "
   +"Du schon von weitem erkennen konntest. Wenn Du ihn genauer betrachtest, scheint er "
   +"den Eingang einer Hoehle zu verdecken. Das Gestruepp ist fest verschlungen und "
   +"durch die Jahrzehnte der Verwitterung zu einer undurchdringbaren Barriere "
   +"verwachsen. Am Rande des Hoehleneinganges kannst Du zwischen dem Gestruepp einige "
   +"seltsame Symbole im Felsen erkennen. In der linken unteren Ecke des verwachsenen "
   +"Hoehleneinganges ist ein kleines Loch im Gestruepp. Links und rechts vom Eingang "
   +"wachsen einige Buesche und Straeucher und einige kleine Haeufchen trockenes "
   +"Holzgestruepp liegen am Boden herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 8]) );

  AddDetail( "pfad",
             "Der verwachsene Pfad, dem Du bis hier her gefolgt bist, ist hier zu "
            +"Ende. Vor Dir scheint der verwachsene Eingang einer Hoehle zu sein. "
            +"Hinter der Hoehle beginnt sich das maechtige Gebirge wieder aufzutuermen.");
  AddDetail( "gebirge",
             "Da befindest Du Dich gerade.");
  AddDetail( ({"haufen", "gestruepphaufen"}),
             "Der Haufen hat den Eingang zu der Hoehle fast vollkommen verschlossen. "
            +"Die einzelnen Aeste und Zweige sind durch die Verwitterung fest "
            +"miteinander verwachsen. Links unten ist ein kleines Loch im Gestruepp. "
            +"Wenn Du hindurch blickst, kannst Du allerdings nichts in der Hoehle "
            +"erspaehen, ausser der gaehnenden Schwaerze im Inneren der Hoehle.");
  AddDetail( ({"aeste", "zweige"}),
             "Die Aeste und Zweige des Gestruepphaufens sind ineinander verschlungen "
            +"und verwachsen.");
  AddDetail( ({"schwaerze", "finsternis"}),
             "Wenn Du durch das kleine Loch am Boden des Gestruepphaufens hindurchspaehst"
            +", kannst Du nur tiefste Finsternis in der Hoehle erkennen.");
  AddDetail( ({"eingang", "hoehleneingang"}),
             "Der Eingang zu der Hoehle ist fast vollkommen durch das Gestruepp "
            +"verwachsen. Du koenntest es wahrscheinlich nicht einmal mit einem Schwert "
            +"zerschlagen. Links und rechts vom Eingang wachsen einige Buesche und "
            +"Straeucher.");
  AddDetail( "hoehle",
             "Du bist neugierig, was diese Hoehle wohl zu verbergen hat. Irgendwie "
            +"strahlt dieser Hoehleneingang eine seltsame Aura aus. Dich erfuellt ein "
            +"Gefuehl der Ehrfurcht.");
  AddDetail( ({"gefuehl", "Ehrfurcht"}),
             "Ein Gefuehl der Ehrfurcht ueberkommt Dich, wenn Du diesen Hoehleneingang "
            +"so betrachtest. Diese Hoehle muss wohl ein grosses Geheimnis in sich "
            +"bergen.");
  AddDetail( "geheimnis",
             "Es scheint, als ob diese Hoehle ein grosses Geheimnis in sich birgt. Ob "
            +"Du es wohl jemals lueften kannst?");
  AddDetail( ({"aura", "anziehungskraft"}),
             "Eine seltsame Aura scheint von dem Hoehleneingang auszugehen. Sie uebt "
            +"fast eine magische Anziehungskraft auf Dich aus.");
  AddDetail( "gestruepp",
             "Das Gestruepp vor der Hoehle ist so dicht verwachsen, dass Du unmoeglich "
            +"durchkommen kannst.");
  AddDetail( ({"verwitterung", "jahrzehnte"}),
             "Jahrzehnte der Verwitterung haben das Gestruepp so fest verwachsen lassen, "
            +"bis es nun zu einer unueberwindbaren Barriere geworden ist.");
  AddDetail( "barriere",
             "Das Gestruepp ist so fest verwachsen, dass es zu einer unueberwindbaren "
            +"Barriere wurde.");
  AddDetail( "rand",
             "Am Rand des Hoehleneinganges sind seltsame Symbole in den Fels eingraviert. "
            +"Sie wirken bei genauerem Betrachten sehr alt und mystisch.");
  AddDetail( ({"fels", "felsen"}),
             "Im Fels rund um den Hoehleneingang sind seltsame Symbole eingraviert.");
  AddDetail( "symbole",
             "Die Symbole im Fels wirken sehr geheimnisvoll. Du wuerdest zu gerne ihre "
            +"Bedeutung erfahren. Sie deuten wahrscheinlich darauf hin, was sich im "
            +"Inneren dieser Hoehle verbirgt.");
  AddDetail( ({"bedeutung", "neugierde"}),
             "Ob Du wohl jemals die Bedeutung dieser Symbole erfahren wirst? Brennende "
            +"Neugierde plagt Dich.");
  AddDetail( ({"ecke", "loch", "spalt"}),
             "In der linken unteren Ecke des Gestruepps ist ein kleiner Spalt, gerade "
            +"gross genug, dass sich vielleicht ein geschicktes Raubtier noch "
            +"hindurchzwaengen kann.");
  AddDetail( "raubtier",
             "Der Spalt ist gerade so gross, dass sich ein geschicktes Raubtier "
            +"hindurchzwaengen koennte.");
  AddDetail( ({"buesche", "straeucher"}),
             "Links und rechts vom Pfad um vom Hoehleneingang wachsen ein paar Buesche "
            +"und Straeucher.");
  AddDetail( ({"haeufchen", "holzgestruepp"}),
             "Es liegen einige Haeufchen Holzgestruepp am Boden herum.");
  AddDetail( "boden",
             "Am Boden ist mit Gras bewachsen und es liegt etwas Holzgestruepp herum.");   
  AddDetail( "gras",
             "Der Boden ist etwas grasbewachsen.");
  AddDetail( "himmel",
             "Durch das Gestruepp siehst Du den blauen Himmel durchschimmern.");
  AddItem( OBJ("gestruepp"), REFRESH_REMOVE);  
  AddExit( "westen", ROOM("plat13"));
  AddExit( "osten", "/d/gebirge/thor/hoehlenquest/room/hoehle/hoehle1");
 
}







