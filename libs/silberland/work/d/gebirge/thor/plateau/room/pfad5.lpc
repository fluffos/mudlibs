// Thor@SilberLand
// Gebirgsplateau - Pfad 5
// 1997-03-14

inherit "std/room";

#include "../plateau.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Felswand");
  SetProp( P_INT_LONG,
    "Der steinige Weg, dem Du bis hier her gefolgt bist, ist hier zu Ende. Vor Dir ragt "
    "eine steile Felswand in den Himmel hinauf. Die schroffen Zacken am oberen Rand "
    "machen Dich ganz neugierig, was da oben wohl sein mag. Die Felswand ist links und "
    "rechts von Dir spaerlich mit einigen Straeuchern und Grasbueschel bewachsen. Am Boden "
    "liegen einige Steine herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN, ENV_TEMPERATURE: 5]) );

  AddDetail( "fels",
             "In dieser Gegend hier ist so ziemlich alles aus Fels.");
  AddDetail( "weg",
             "Der Weg, dem Du gefolgt bist, endet nun hier von dieser steilen Felswand. "
             "Du beginnst Dich langsam zu fragen, wie Du hier noch vorankommen sollst.");
  AddDetail( ({ "wand", "felswand" }),
             "Die Felswand ragt hoch in den Himmel hinauf. Sie ist sehr zerklueftet und "
             "Du kannst einige Ritzen darin erkennen. Am oberen Rand siehst Du einige "
             "schroffe Zacken.");
  AddDetail( "himmel",
             "Die Felswand vor Dir ragt hoch in den blauen Himmel hinauf.");
  AddDetail( ({"ritze", "ritzen"}),
             "Die Felswand ist durch zahlreiche Ritzen zerklueftet. Du koenntest ja versuchen, "
             "die Felswand hinaufzuklettern. Das wird allerdings einiges an Geschick erfordern.");
  AddDetail( "geschick",
             "Du bist Dir noch unschluessig, ob Du geschickt genug bist, um an dieser Wand "
             "hochzuklettern.");
  AddDetail( "zacken",
             "Die spitzen Zacken am Rand der Felswand scheinen irgendetwas verbergen zu wollen. ");
  AddDetail( "rand",
             "Du blickst nach oben und Dir wird schon allein bei dem Gedanken schwindlig, da "
             "raufzuklettern.");
  AddDetail( "gedanke",
             "Du machst Dir besser keine genaueren Gedanken, was alles passieren koennte, wenn "
             "Du da nach oben kletterst.");
  AddDetail( ({"strauch", "straeucher"}),
             "Links und rechts von Dir wachsen ein paar Straeucher aus dem Boden.");
  AddDetail( "boden",
             "Der Boden hier ist ziemlich steinig, wie koennte es im Gebirge auch anders sein.");
  AddDetail( ({"weg", "pfad"}),
             "Der steinige Weg ist hier zu Ende. Vor Dir siehst Du nur die steile Felswand in "
             "den Himmel ragen.");
  AddDetail(  "gebirge",
              "Da, wo Du Dich gerade befindest.");
  AddDetail( ({"grasbueschel", "bueschel", "gras"}),
              "Einige Grasbueschel wachsen noch am Boden und aus den Ritzen der Felswand heraus.");
  AddDetail( "steine", 
             "Am Boden liegen ein paar groessere Steine herum, die wohl aus der Felswand "
             "herausgebrochen sind.");
  AddSound( DEFAULT_SOUND, 
           "Du hoerst das sanfte Wispern des Windes.");
  AddSmell( DEFAULT_SMELL,
           "Du atmest einmal tief die frische Bergluft ein und fuehlst Dich sogleich besser.");
  AddExit( "suedwesten", ROOM("pfad4"));
  AddCmd( ({"kletter", "klettere"}), "kletter");
 }

kletter( str )
{
  notify_fail("Wo willst Du raufklettern?\n");
  if(str=="auf felswand" || str=="auf wand" || str == "rauf" || str == "hinauf" ||
      str=="nach oben" || str=="hoch")
    {
    if (random(10) * (TP->QueryAttribute(A_DEX)) > 25)
      {
      write(BS("Mit all Deinem Geschick kletterst Du flink die Felswand hinauf.\n"));
      TP->move(ROOM("plat1"), M_GO, "","klettert geschickt die Felswand hinauf", "kommt "
                "die Felswand heraufgeklettert");
      return 1;
      }
    else
      {
      write(BS("Mit all Deiner Geschicklichkeit versuchst Du die Felswand "
               "hinaufzuklettern, doch ploetzlich verlassen Dich all Deine Kraefte "
               "und Du stuerzt klaeglich ab.\n"));
      say(BS(TPN+" versucht, die Felswand zu erklimmen, stuerzt jedoch ploetzlich "
                 "von "+((TP->QueryProp(P_GENDER))==FEMALE ? "ihren":"seinen")
                +" Kraeften verlassen ab.\n"));
      TP->do_damage(10);
      return 1;
      }
    }      
  else
    return 0;
}







