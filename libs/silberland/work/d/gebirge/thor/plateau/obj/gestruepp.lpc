// Thor@SilberLand
// Ein Haufen Holzgestruepp
// 1997-03-30

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../plateau.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Haufen Holzgestruepp");
  SetProp (P_LONG, 
    "Das Holzgestruepp ist knochentrocken. Es muesste brennen wie Zunder, wenn man "
   +" es anzuendet.");
  SetProp (P_NAME, "Haufen Gestruepp");
  SetProp (P_GENDER, MALE);
  AddId ( ({"gestruepp", "holzgestruepp", "haufen"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_WOOD);

  AddDetail( "zunder",
             "Wenn man das Gestruepp anzuendet, muesste es lichterloh brennen.");
  AddCmd(({"zuende", "zuend"}), "anzuenden");
  AddCmd(({"leg", "lege"}), "reinlegen");
}


anzuenden (str)
{
  notify_fail("Was willst Du anzuenden?\n");
  if (str=="gestruepp an"||str=="holzgestruepp an")
    {
    write(BS("Du muesstest das Gestruepp zuerst in eine Feuerstelle legen.\n"));
    return 1;
    }
  else
    return 0;
}



reinlegen (str)
{
  object ob, obj;
  string raum;

  ob=environment(TP);
  raum=file_name(ob);
  notify_fail("Wo willst Du das hinlegen?\n");
  if (str=="gestruepp in feuerstelle"||str=="holzgestruepp in feuerstelle")
    {
    if(raum==ROOM("plat10"))
      {
      write(BS("Du legst das Holzgestruepp in die Feuerstelle.\n"));
      say(BS(TPN+" legt etwas Holzgestruepp in die Feuerstelle.\n"));
      ob->SetProp(P_HOLZ, 1);
      ME->remove();
      return 1;
      }
    else
      {
      write(BS("Du siehst hier keine Feuerstelle, wo Du das Gestruepp hineinlegen koenntest.\n"));
      return 1;
      }
    
    }
  else
    return 0;
}


