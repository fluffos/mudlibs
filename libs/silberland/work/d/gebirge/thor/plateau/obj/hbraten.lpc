// Thor@SilberLand
// Ein Hasenbraten
// 1997-04-12


inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../plateau.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Hasenbraten");
  SetProp (P_LONG, "Ein saftiger, duftender Hasenbraten. Dir laeuft "
                  +"das Wasser im Mund zusammen, wenn Du ihn so betrachtest.");
  SetProp (P_NAME, "Hasenbraten");
  SetProp (P_GENDER, MALE);
  AddId ( ({"braten", "hasenbraten"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 800);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, bs("Der Hasenbraten sieht aeusserst lecker aus. Du "
                     +"wuerdest ihn am liebsten auf der Stelle verspeisen."));
  SetProp (P_MATERIAL, MAT_FOOD);
  call_out("gut", 1);
}

int stand=0;


gut()
{
  SetProp (P_FOOD_INFO, ([F_HEAL:40+random(10), F_SOAK:4, F_ALCOHOL:0, F_POISON:0]));
  stand=1;
  call_out("alt", 250);
}

alt()
{
  SetProp (P_FOOD_INFO, ([F_HEAL:25+random(10), F_SOAK:4, F_ALCOHOL:0, F_POISON:0]));  
  stand=2;
  call_out("schlecht", 250);
}

schlecht()
{
  SetProp (P_FOOD_INFO, ([F_HEAL:10+random(10), F_SOAK:4, F_ALCOHOL:0, F_POISON:0]));
  stand=3;
  call_out("verdorben", 250);
}

verdorben()
{
  SetProp (P_FOOD_INFO, ([F_HEAL:-20, F_SOAK:4, F_ALCOHOL:0, F_POISON:0]));
  write(BS("Oje, der Hasenbraten ist jetzt verdorben.\n"));
  stand=4;
}


BeimEssen()
{
  switch(stand)
    {
    case 1:
            write(BS("Du verspeist mit Genuss den Hasenbraten.\n"));
            say(BS(TPN+" verspeist einen duftenden Hasenbraten. Dir laeuft "
              +"das Wasser im Munde zusammen, wenn Du bloss zusiehst.\n"));
	    break;
    case 2:
	    write(BS("Du isst den Hasenbraten auf, er schmeckt jedoch nicht "
                    +"mehr so besonders.\n"));
            say(BS(TPN+" isst einen Hasenbraten, schaut daraufhin allerdings "
                    +"nicht sehr begeistert aus. Trotzdem haettest Du ihn "
                    +"gerne gekostet.\n"));
	    break;
    case 3:
            write(BS("Du isst den Hasenbraten auf, verziehst aber sogleich "
                    +"unwillkuerlich das Gesicht. Er schmeckt schon ziemlich "
                    +"scheusslich.\n"));
            say(BS(TPN+" isst einen Hasenbraten, verzieht daraufhin aber "
                    +"das Gesicht. Du beneidest ihn eigentlich nicht um den "
                    +"Braten.\n"));
            break;
    case 4:
	    write(BS("Du beisst in den Hasenbraten hinein, faengst aber "
                   +"sofort an zu wuergen. Uaaaeeehhhh... er schmeckt "
                   +"wirklich scheusslich.\n"));
            say(BS(TPN+" beisst in einen Hasenbraten hinein und wird "
                   +"ploetlich ganz gruen im Gesicht. Der Braten scheint "
                   +"wirklich ekelhaft zu schmecken.\n"));
            break;
  }
}
