// Thor@SilberLand
// Ein totes Kaninchen
// 1997-03-05

inherit "std/thing";

#include <properties.h>
#include "../plateau.h"
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein totes Kaninchen");
  SetProp (P_LONG, 
    "Daraus liesse sich ein hervorragender Hasenbraten machen.");
  SetProp (P_NAME, "Kaninchen");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"kaninchen", "totes kaninchen"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 800);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC);

  AddDetail( ({"hasenbraten", "braten"}),
             "Dir laeuft bei dem Gedanken das Wasser im Mund zusammen.");
  
  AddCmd( ({"spiess", "spiesse"}), "aufspiessen");
  AddCmd( ({"brat", "brate"}), "braten");
}

aufspiessen (str)
{
  object ob;
  notify_fail("Wo willst Du das aufspiessen?\n");
  if( str == "kaninchen auf spiess" || str == "kaninchen auf holzspiess" )
    { 
    if( ob=deep_present("holzspiess", TP))
      
	 {
          ob->remove();
          write(BS("Du steckst das Kaninchen auf den Holzspiess.\n"));
          say(BS(TPN+" steckt ein Kaninchen auf einen Holzspiess.\n"));
          clone_object(OBJ("braten"))->move(TP,M_NOCHECK);
          ME->remove();
          return 1;
         }
          else
            notify_fail("Du hast ja gar keinen Holzspiess.\n");
      
    }
    
  else
    return 0;
}

braten (str)
{
  notify_fail("Was willst Du braten?\n");
  if( str == "kaninchen" )
    {
    write(BS("Dazu muesstest Du es wohl erst einmal auf einem Holzspiess aufspiessen.\n"));
    return 1;
    }
  else
    return 0;
}


