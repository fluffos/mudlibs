// Thor@SilberLand
// Ein Holzspiess
// 1997-03-04

inherit "std/thing";

#include <properties.h>
#include <weapon.h>
#include "../plateau.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Holzspiess");
  SetProp (P_LONG, 
    "Ein Holzspiess, mit dem Du vielleicht etwas braten kannst.");
  SetProp (P_NAME, "Spiess");
  SetProp (P_GENDER, MALE);
  AddId ( ({"spiess", "holzspiess"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 250);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_WOOD);

}

