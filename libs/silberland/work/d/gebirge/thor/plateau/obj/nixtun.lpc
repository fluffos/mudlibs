// Thor@SilberLand
// Ein Objekt, das jegliche Kommandos des Spielers ignoriert
// 1997-03-11

#include "../plateau.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "nixtun");
  SetProp(P_GENDER, MALE);
  AddId("nix");

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  AddCmd("","nix",1);
}

nix()
{
  write(BS("Das kannst Du jetzt nicht machen, Du braets ja gerade das Kaninchen.\n"));
  return 1;
}
