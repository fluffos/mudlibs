// Thor@SilberLand
// Ein Ast
// 1997-03-04

inherit "std/thing";

#include <properties.h>
#include <weapon.h>
#include <moving.h>
#include "../plateau.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein duenner Ast");
  SetProp (P_LONG,BS( 
          "Ein duenner, saftiger Ast. Das Holz ist noch ganz frisch. "
         +"Du nimmst ihn besser mit - wer weiss, wofuer man ihn noch "
         +"gebrauchen kann.\n"));
  SetProp (P_NAME, "Ast");
  SetProp (P_GENDER, MALE);
  AddId ( "ast" );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_WOOD);

  AddDetail( "holz",
             "Das Holz ist ideal zum Schnitzen geeignet.");
  
  AddCmd( ({"schnitze", "schnitz"}), "spiess");

}

spiess (str)
{
  object ob;
  notify_fail("Was willst Du schnitzen?\n");
  if( str == "spiess" || str == "holzspiess" )
  { 
    if( ob=present("messer", TP) )
      {
      if( ob->QueryProp(P_WIELDED) )
        {        
        write("Du schnitzt Dir einen Holzspiess aus dem Ast.\n");
        say((TPN) +" schnitzt einen Holzspiess.\n");
		clone_object(OBJ("spiess"))->move(TP, M_NOCHECK);
        ME->remove();
		return 1;
        }
      else
        write(BS("Du musst das Messer vorher zuecken.\n"));
      }  
    else
      write(BS("Du brauchst schon ein Messer, um Dir einen Spiess "  
              +"zu schnitzen.\n"));
      return 1; 
 }
  else
    return 0;
}
