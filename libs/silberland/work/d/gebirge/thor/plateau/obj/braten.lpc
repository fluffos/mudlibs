// Thor@SilberLand
// Ein totes Kaninchen
// 1997-03-05

inherit "std/thing";

#include <properties.h>
#include "../plateau.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Kaninchen auf einem Holzspiess");
  SetProp (P_LONG, 
    "Du solltest schleunigst schauen, dass Du es wo braten kannst, bevor es "
   +"verdirbt.");
  SetProp (P_NAME, "Kaninchen");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"kaninchen", "kaninchen auf spiess"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 2250);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, ({MAT_FLESH, MAT_WOOD}));
}
















































































