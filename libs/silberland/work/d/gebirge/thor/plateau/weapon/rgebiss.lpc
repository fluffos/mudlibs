// Thor@SilberLand
// Ein Raubtiergebiss (Puma)
// 1997-03-11

#include "../plateau.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Raubtiergebiss");
  SetProp(P_LONG, BS( 
    "Das Raubtiergebiss eines Pumas.") );
  SetProp(P_NAME, "Raubtiergebiss");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gebiss", "raubtiergebiss"}) );

  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
}








