#include "../quest.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Kristallschwert");
  SetProp(P_LONG,
    "Das Kristallschwert ist zu einem Grossteil durchsichtig und es "
   +"funkelt und glitzert im Licht. Die Klinge ist hart wie Stahl und im "
   +"Knauf sind kunstvolle Muster eingraviert. Das Kristallschwert ist eine "
   +"maechtige Waffe. Sie ist bis jetzt nur in den Haenden der "
   +"Kristallwaechter gewesen, die stets um Friede und Gerechtigkeit bemueht "
   +"waren. Benuetze die Waffe daher mit Bedacht!");
  SetProp(P_INFO, "Das Schwert wird Dir vor allem im Kampfe mit boesen "
	         +"Wesen gute Dienste erweisen.");
  SetProp(P_NAME, "Kristallschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "kristallschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 210);
  SetProp (P_WC_BONUS, (["Kwaechter1":300]) ); 
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 70 );
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
}

int WieldFunc(object waffe)
{
  if((TP->QueryProp(P_ALIGN))<(-199))
    {
    write(BS("Das Kristallschwert ist zu maechtig, als dass es in boese "
	    +"Haende gelangen darf, daher zerbroeckelt es zwischen Deinen "
	    +"Fingern.\n"));
    TP->reduce_hit_points(10+random(10));
    TO->remove();
    return 0;
    }
  else
    return 1;
}

int HitFunc(object enemy)
{
  return enemy->QueryProp(P_ALIGN)/-10;
}
