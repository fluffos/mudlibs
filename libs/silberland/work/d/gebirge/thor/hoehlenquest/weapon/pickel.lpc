#include "../quest.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Pickel");
  SetProp(P_LONG,
    "Ein Pickel, der etwa einen Meter lang ist. Man kann damit bestimmt "
   +"groessere Brocken Gestein oder Metall herausschlagen.");
  SetProp(P_INFO, "Der Stiel besteht aus Holz und die Hacke ist schon ein "
	         +"wenig verrostet. Das sollte seiner Funktion allerdings "
	         +"keinen grossen Nachteil bringen.");
  SetProp(P_NAME, "Pickel");
  SetProp(P_GENDER, MALE);
  AddId( ({"pickel", "\npickel"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 120);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BEECH:50,MAT_IRON:50]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
}
