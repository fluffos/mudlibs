#include "../quest.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

string func();

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein gluehendes Schwert");
  SetProp(P_LONG,
    "Das Schwert scheint frisch aus der Esse zu kommen. Das Metall ist "
   +"beinahe noch weiss gluehend.");
  SetProp(P_NAME, "gluehendes Schwert");
  SetProp(P_GENDER, NEUTER);
  AddId("schwert");

  SetProp(P_MATERIAL, ([MAT_STEEL:50, MAT_FIRE:50]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_WC_BONUS, (["Zyklop":300]));
  SetProp(P_DAM_TYPE, DT_FIRE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "");  // Wir geben im move() selber einen Text aus
  SetProp(P_KILL_NAME, "Ein heisses Eisen");
}

varargs int move(mixed dest, int method)
{
  if (objectp(dest) && interactive(dest) && (method & M_GET))
  {
    tell_object(dest, BS("Du verbrennst Dir ganz fuerchterlich die Haende, "
		     +"als Du versuchst, das Schwert aufzunehmen. Das "
                     +"Schwert faellt Dir dabei in die Lava.\n"));
    tell_room(environment(dest), BS(CAP_TPN+" greift nach dem gluehenden "
	             +"Schwert und verbrennt sich dabei fuerchterlich die "
	             +"Hand. Das Schwert faellt in die Lava.\n"), ({dest}));
    dest->do_damage(50);        // Aua :-)
    call_out("remove",0);       // remove verzoegert!!
    return ::move(dest,method); // inherited Methode verwenden,
                                // die wg. P_NOGET fehlschlaegt
  }
  else return ::move(dest,method);
}

