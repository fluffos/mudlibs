**************************/


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zyklop");
  SetProp(P_LONG,
    "Vor Dir steht ein riesiger Zyklop. Er hat eine gluehend rote Hautfarbe "
   +"und starrt Dich mit seinem einzelnem Auge boese an. Es sieht so aus, "
   +"als koennte er jeden Moment ausrasten. Du weisst nicht, ob es "
   +"so gut ist, wenn Du noch laenger hier herumstehst...");
  SetProp(P_NAME, "Zyklop");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:30,T_RANGE_MAX:60]));
  AddId(({"zyklop", "zyklope"}));

  set_living_name("zyklop");

  create_default_npc(20);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit gluehenden Haenden", 300, DT_FIRE}));
  SetProp(P_MAX_HP, 600);
  SetProp(P_BODY, 100);
  SetProp(P_XP, QueryProp(P_XP)+500*100); // Bonus fuer Spells
  SetProp(P_RACE, "Zyklop");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_FIRE:-0.5]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, LAVA("") );
  SetProp(P_MNPC_WAIT, ({ 10, 40, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, LAVA("lava15"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " bricht zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Zyklop");
  SetProp(P_KILL_MSG, "Wo bleibt der naechste?");

  AddInfo(DEFAULT_INFO, "funkelt Dich nur einaeugig an.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Zyklop schlaegt mit der Faust nach Dir.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(3,400,
    "Der Zyklop rammt Dich in ungespitzt in den Boden.\n",
    "Der Zyklop rammt @WEN in ungespitzt in den Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,600,
    "Der Zyklop schleudert einen Lavaklumpen nach Dir.\n",
    "Der Zyklop schleudert einen Lavaklumpen nach @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,700,
    "Der Zyklop spuckt Dir Feuer ins Gesicht.\n",
    "Der Zyklop spuckt @WEN Feuer ins Gesicht.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));	   

  SetAttackChats(10, ({
  "Der Zyklop bruellt: Wage es nicht noch einmal!.\n"}) );
}


