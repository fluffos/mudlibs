// Thor@SilberLand  
// Ein Hoehlenwurm - wurm.c
// 1997-05-02

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlenwurm");
  SetProp(P_LONG,
    "Der Hoehlenwurm hat eine hellgraue Farbe, ist etwa 1,5 Meter lang und "
   +"ziemlich dick. Er scheint sich hier drinnen sehr wohl zu fuehlen und "
   +"robbt gemaechlich am Boden dahin.");
  SetProp(P_NAME, "Hoehlenwurm");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId(({"wurm", "hoehlenwurm"}));
  set_living_name("hoehlenwurm");

  create_default_npc(10);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 90, DT_RIP}));
  SetProp(P_MAX_HP, 100+random(60));
  SetProp(P_BODY, 30);
//  SetProp(P_XP, 150*100); // Bonus fuer Spells
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE,1);

  SetProp(P_MSGIN, "robbt herein");
  SetProp(P_MSGOUT, "robbt weiter");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, LAB(""));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, LAB("laby37"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);

  SetProp(P_DIE_MSG,  " zuckt noch ein letztes Mal und bleibt dann tot liegen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Hoehlenwurm");

  AddInfo(DEFAULT_INFO, "robbt einfach weiter.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hoehlenwurm beachtet Dich gar nicht.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(3, 140,
    "Der Hoehlenwurm wickelt sich um Deine Beine.\n",
    "Der Hoehlenwurm wickelt sich um die Beine von @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 180,
    "Der Hoehlenwurm beisst Dir ins Knie.\n",
    "Der Hoehlenwurm beisst @WEN in das Knie.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 
}












