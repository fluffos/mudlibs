// Thor@SilberLand  
// Ein roter Hoehlenwurm - rwurm.c
// 1997-05-02

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein roter Hoehlenwurm");
  SetProp(P_LONG,
    "Dieser Hoehlenwurm hat seltsamerweise eine dunkelrote Farbe und ist auch "
   +"um einiges groesser als die anderen Exemplare, die Du bis jetzt gesehen "
   +"hast. Er kriecht aus einem Loch in der Felswand heraus, allerdings "
   +"verlaesst er dieses sonderbarer Weise nie ganz.");
  SetProp(P_NAME, "Hoehlenwurm");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "rot");
  AddId(({"wurm", "hoehlenwurm", "rwurm"}));
  set_living_name("rhoehlenwurm");

  create_default_npc(11);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 110, DT_RIP}));
  SetProp(P_MAX_HP, 130+random(30));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, 250*100); // Bonus fuer Spells
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_DIE_MSG,  " zuckt noch ein letztes Mal und bleibt dann tot liegen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein roter Hoehlenwurm");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hoehlenwurm beachtet Dich gar nicht.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(3, 160,
    "Der Hoehlenwurm wickelt sich um Deine Beine.\n",
    "Der Hoehlenwurm wickelt sich um die Beine von @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 200,
    "Der Hoehlenwurm beisst Dir ins Knie.\n",
    "Der Hoehlenwurm beisst @WEN in das Knie.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 
}












