inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kristallwaechter");
  SetProp(P_LONG,
    "Vor Dir steht ein wahrlicher Riese aus Kristall. Bei jedem seiner "
   +"Bewegungen scheint der Kristall sich zu veraendern und zu fliessen. "
   +"Seine Augen sind nur ein rotes Gluehen, die Dich boese anstarren. "
   +"Es war vielleicht doch nicht so gut, hier in sein Reich vorzudringen.");
  SetProp(P_NAME, "Kristallwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "kristallwaechter", "riese", "Kwaechter2"}));

  create_default_npc(22);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit kristallenen Faeusten", 200, DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
  SetProp(P_BODY, 180);
  SetProp(P_XP, QueryProp(P_XP)+600*100); // Bonus fuer Spells
  SetProp(P_RACE, "kristallwesen");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0.5, DT_FIRE:-0.5, DT_WHIP:-1.0]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Kristallwaechter");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal, mich zu stoeren!");

  AddInfo(DEFAULT_INFO, "knurrt dumpf.\n");
  AddInfo("thor", "Thor hat mich erschaffen.","sagt stolz: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kristallwaechter blickt Dich nur finster an.\n" }) );

  SetProp(P_SPELLRATE, 15);
  AddSpell(2, 400,
    "Der Kristallwaechter schlaegt Dir seine steinharte Faust ins Gesicht.\n",
    "Der Kristallwaechter schlaegt @WEN seine steinharte Faust ins "
   +"Gesicht.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800,
    "Der Kristallwaechter schleudert einen Blitz nach Dir.\n",
    "Der Kristallwaechter schleudert einen Blitz nach @WEN.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
  "Die Augen des Kristallwaechters gluehen rot auf.\n"}) );

  SUID;
  CLONEME(ARMOUR("kpanzer"));
  command("trage kristallpanzer");
}

die(int poisondeath)
{
    write_file("/d/gebirge/thor/hoehlenquest/log/waechter_kills",
               dtime(time())+": "+CAP(getuid(TP))+" toetet Waechter2.\n");
    ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
   if( killer == TO )
     write_file("/d/gebirge/thor/hoehlenquest/log/waechter_kills",
                sprintf( ctime()+": Waechter2 hat gerade "+CAP(getuid(player))
               +" umgebracht - %d EP!\n", lostexp));
   return ;
}
