// Thor@SilberLand
// Ein steinerner Bandersnatch - bsnatch.c
// 1997-05-23

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Bandersnatch");
  SetProp(P_LONG,
    "Voller Entsetzen starrst Du die etwa drei Meter grosse Bestie an, die "
   +"vor Dir steht und Dich mit gluehend roten Augen ansieht. Seine Augen "
   +"sind das einzig farbige an ihm, ansonsten besteht er aus hellem "
   +"Kalkstein. An seinem Gebiss siehst Du langen Reisszaehnen und aus "
   +"seinem Maul dringt heisser Geifer. Seine langen Pranken sind mit "
   +"grossen Krallen bewehrt, die nach Dir schlagen.");
  SetProp(P_NAME, "Bandersnatch");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "steinern");
  AddId(({"snatch", "bandersnatch"}));
  
  create_default_npc(28);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" seinen riesigen Pranken",400 ,DT_RIP}));
  SetProp(P_MAX_HP, 800);
  SetProp(P_BODY, 90);
  SetProp(P_XP, 1800000); // Bonus fuer Spells
  SetProp(P_RACE, "Bandersnatch");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt mit einem markerschuetternden Bruellen tot zu "
                     +"Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "GRROOAARH!!! Das naechste mal gehoerst Du mir, %s!");
  SetProp(P_KILL_NAME, "Bandersnatch");
//  SetProp(P_KILL_MSG, "");

  AddInfo(DEFAULT_INFO, " bruellt Dich laut an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Bandersnatch schlaegt nur mit einer Pranke nach Dir.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1, 900,
    "Der Bandersnatch schleudert einen riesigen Felsbrocken nach Dir.\n",
    "Der Bandersnatch schleudert einen riesigen Felsbrocken nach @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 600,
    "Der Bandersnatch schlitzt Dich mit seinen Krallen beinahe auf.\n",
    "Der Bandersnatch schlitzt @WEN mit seinen Krallen beinahe auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Der Bandersnatch knurrt laut.\n",
  "Der Bandersnatch schlaegt ein Stueck Fels aus der Wand.\n"}) );
  SetAttackChats(10, ({
  "Der Bandersnatch bruellt Dich mit einem markerschuetternden Schrei an.\n"}) );

}


die(int poisondeath)
{
    write_file("/d/gebirge/thor/hoehlenquest/log/bsnatch_kills",
              dtime(time())+": "+CAP(getuid(TP))+" toetet den Snatch.\n");
    ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
   if( killer == TO )
   write_file("/d/gebirge/thor/hoehlenquest/log/bsnatch_kills",
              sprintf( ctime()+": Der Snatch hat gerade "+CAP(getuid(player))
             +" umgebracht - %d EP!\n", lostexp));
  return ;
}

