inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlenwolf");
  SetProp(P_LONG,
    "Der Hoehlenwolf hat ein stumpes, raeudiges Fell. Trotz seines "
   +"haesslichen Aussehens ist er im Kampf jedoch auf keinen Fall zu "
   +"unterschaetzen. Er hat ein riesiges, weiss blitzendes Kiefer mit langen, "
   +"scharfen Zaehnen und macht einen aeusserst kraeftigen Eindruck.");
  SetProp(P_NAME, "Hoehlenwolf");
  SetProp(P_GENDER, MALE);
  AddId(({"wolf", "hoehlenwolf"}));

  create_default_npc(17);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit scharfen Zaehnen", 200, DT_RIP}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
  SetProp(P_XP, QueryProp(P_XP)+200*100); // Bonus fuer Spells
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "streunt herein");
  SetProp(P_MSGOUT, "streunt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, TROPFST("") );
  SetProp(P_MNPC_WAIT, ({ 10, 40, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, TROPFST("thoehle2"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Hoehlenwolf");

  AddInfo(DEFAULT_INFO, "knurrt laut.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hoehlenwolf schnappt mit seinen Zaehnen nach Dir.\n" }) );

  SetProp(P_SPELLRATE,2);
  AddSpell(1,400,
    "Der Hoehlenwolf schnappt nach Deiner Kehle.\n",
    "Der Hoehlenwolf schnappt nach @WESSEN Kehle.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Der Hoehlenwolf graebt seine Krallen in Deinen Oberschenkel.\n",
    "Der Hoehlenwolf graebt seine Krallen in @WESSEN Oberschenkel.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
  "Der Hoehlenwolf wandert unruhig auf und ab.\n",
  "Der Hoehlenwolf knurrt leise.\n"}) );

  SUID;
  CLONEME(ARMOUR("wfell"));
  command("trage alles");
}
