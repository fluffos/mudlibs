// Thor@SilberLand  
// Artox, der Zwergenschmied
// 1997-04-21

inherit "std/repair";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <questmaster.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Artox, der Zwergenschmied");
  SetProp(P_LONG,
    "Artox ist ein bulliger, aeussert kraeftig wirkender Zwerg. Er hat eine "
   +"lange Maehne und einen dichten Bart. Sein Gesicht wirkt verschlossen und "
   +"es ist etwas russig. In seiner rechten Hand haelt er einen grossen "
   +"Hammer, mit dem er ein Stueck Metall auf dem Amboss vor ihm bearbeitet. "
   +"Als er Dich erblickt, haelt er in seiner Arbeit inne und mustert "
   +"Dich misstrauisch.");
  SetProp(P_NAME, "Artox");
  SetProp(P_INFO,
    "Artox ist ein aeusserst kraeftiger Zwerg. Er wirkt etwas verschlossen, "
   +"das kommt warscheinlich daher, weil er schon lange niemanden mehr "
   +"gesehen hat.");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"zwerg", "schmied", "zwergenschmied", "artox", "Schmied"}));
  set_living_name("artox");

  create_default_npc(17);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit einem Hammer", 200, DT_BLUDGEON}));
  SetProp(P_MAX_HP, 500+random(100));
  SetProp(P_BODY, 50);
  SetProp(P_XP, 400*100);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 125);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_DIE_MSG,  " sackt tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Artox");
  SetProp(P_KILL_MSG, "Auf ewig sollst Du in der Hoelle schmoren!");
  SetProp(P_NOATTACK, "bruellt wuetend: Verschwinde hier!");

  AddDetail( "maehne",
             "Eine lange Maehne waechst ihm den Ruecken hinunter.");
  AddDetail( "bart",
             "Ein dichter Bart laesst nur wenig von seinem Gesicht erkennen.");
  AddDetail( "gesicht",
             "Es wirkt verschlossen und misstrauisch. Artox hat wohl schon "
            +"lange mit keinem Menschen mehr gesprochen. Das Gesicht ist ein "
            +"wenig russig von dem grossen Feuer in der Esse.");

  AddInfo(DEFAULT_INFO, "blickt Dich nur fragend an.\n");
  AddInfo( ({"lebenswerk", "werk"}), "Ich werde es wohl nie vollenden ...",
           "seufzt: ");
  AddInfo( "symbole", "Die Symbole am Eingang haben eine laengst vergessene "
          +"Bedeutung. Nur die Zwerge, die vor Hunderten von Jahren in den "
          +"Tiefen dieser Hoehle gelebt haben, kennen sie.","sagt: ");
  AddInfo( "hoehle",
           "Schon seit langen Zeiten hat niemand mehr diese Hoehle betreten. "
          +"Sie fuehrt angeblich weit in die Tiefe hinab und birgt ungeahnte "
          +"Geheimnisse in sich. Frueher hat ein altes Zwergenvolk dort unten "
          +"ihre wertvollsten Schaetze versteckt. Daher huete Dich vor der "
          +"Hoehle! Sie birgt unzaehlige Fallen und Verstecke in sich.",
           "fluestert Dir zu: ");
  AddInfo( ({"volk", "zwergenvolk"}),
           "Ein uraltes Zwergenvolk, das nun aber schon seit hunderten von "
          +"Jahren ausgestorben ist, hat frueher mal in einigen Teilen dieser "
          +"Hoehlen gelebt und in anderen Teilen ihre wertvollsten Schaetze "
          +"versteckt. Sie wurden allerdings gut behuetet, denn die Zwerge "
          +"haben mit einigen gefaehrlichen Fallen dafuer gesorgt, dass die "
          +"Schaetze nicht in falsche Haende fallen. Schon so mancher ist "
          +"auf der Suche nach Reichtum und Ruhm an den kniffligen Fallen "
          +"gestorben.", "sagt: ");
  AddInfo( "fallen",
           "Huete Dich vor den uralten Fallen der Zwerge in den Tiefen der "
          +"Hoehle! Sie sind oft an ungeahnten Orten.", "sagt: ");
  AddInfo( ({"geheimnisse", "geheimnis"}),
           "Niemand kennt die Geheimnisse dieser Hoehle. Nur ein mutiger "
          +"Abenteurer wuerde sich warscheinlich tiefer in die Hoehle hinein "
          +"wagen, und dann waere es wohl nicht gewiss, ob er jemals lebend "
          +"wiedergesehen wird.", "fluestert: ");
  AddInfo( "metall",
           "Ach, ich braeuchte da ein ganz bestimmtes, damit ich meinen "
          +"Gegenstand hier fertig schmieden kann. Es soll angeblich tief in "
          +"der Hoehle hier unten verborgen sein, jedoch keiner weiss genau, "
          +"wo. Ich bin leider nicht mehr jung genug dazu, dort hinunter zu "
          +"steigen, sonst wuerde ich ihn mir ja selber suchen.", 
           "sagt traurig: ");
  AddInfo( "gegenstand",
           "Alles brauchst Du wieder auch nicht zu wissen. Wenn Du mir jedoch "
          +"hilfst, ihn fertigzustellen, koennte ich mich vielleicht als "
          +"dankbar erweisen.","erwidert misstrauisch: ");
  AddInfo( "abenteurer",
           "Na ich weiss nicht so recht, ob Du einer bist.", "mustert Dich "
          +"geringschaetzig und meint dann: ");
  AddInfo( "hammer",
           "Mein bestes Stueck! Den bekommt keiner!", "zueckt seinen Hammer "
          +"und sagt: ");
  AddInfo( "amboss",
           "Ja, den brauche ich zum Schmieden.", "erklaert: ");
  AddInfo( "schmieden"
           "Wunderbares Handwerk. Ich habe mein Leben lang nichts anders "
          +"getan und beherrsche es nun schon perfekt.", "sagt stolz: ");
  AddInfo( ({"zwerge", "zwerg"}),
           "Wunderbares Volk! Ich bin stolz, ein Zwerg zu sein.", "schlaegt "
          +"sich auf die Brust und meint stolz: ");
  AddInfo( ({"elfen", "elf"}),
           "Komm mir bloss nicht mit diesen spitzohrigen Baumhanglern. "
          +"Jeder, der spitze Ohren hat, fuehrt eine hinterhaeltige "
          +"Gemeinheit im Schilde.", "bruellt lauthals: ");
  AddInfo( "gold",
           "WO! Sofort alles zu mir!", "beginnt zu Sabbern und ruft: ");
  AddInfo( "schaetze",
           "Viele Schaetze waren einst in den Tiefen dieser Hoehle versteckt. "
          +"Wer sich jedoch heute hier nach unten wagt, laeuft Gefahr, sich "
          +"hoffnungslos zu verirren. Das Hoehlensystem dort unten ist "
          +"groesser, als man vielleicht auf den ersten Blick annehmen "
          +"wuerde.", "erzaehlt: ");
  AddInfo( ({"system", "hoehlensystem"}),
           "Das Hoehlensystem hier in den Tiefen des Gebirges ist "
          +"Jeder, der mit den unzaehligen Gaengen dort unten nicht bestens "
          +"vertraut ist, wird sich hoffnungslos verlaufen und in der "
	  +"ewigen Dunkelheit elend einen langsamen Tod erleiden.", 
	   "erzaehlt: ");
  AddInfo( "thor",
           "Ach, hab sie schon lange nicht mehr gesehen. Frueher hat sie mich "
          +"ja oefters besucht, aber jetzt... Naja, sie ist wirklich lieb, "
          +"die kleine, nur eben immer viel zu uebermuetig. Ausserdem treibt "
          +"sie sich immer mit diesem Angrox herum... also ich weiss nicht "
          +"recht, mir ist der irgendwie unsympatisch.", "meint: ");
  AddInfo( "angrox",
           "Naja, eigentlich ist er ein maechtiger Zwerg, nur fuehrt er immer "
          +"Bloedsinn im Schilde. Also ich mag ihn eigentlich nicht "
          +"besonders.", "ruempft die Nase und sagt: ");
  AddInfo( ({"woody", "dusty"}),
            "faellt auf die Knie und faengt untertaenigst an zu beten.");
  AddInfo( ({"quelle", "wasser"}),
           "An der Quelle in der Hoehle hole ich immer mein Wasser. Das beste "
          +"Wasser, das es gibt weit und breit... Naja, eigentlich ja auch "
          +"das einzige.", "sagt: ");
  AddInfo( "pickel",
	   "Einen Pickel... hm. Nein, tut mir leid, Pickel habe ich keinen.",
	   "sagt nachdenklich: ");
  AddInfo( ({"hilfe", "helfen"}), "@@quest@@", "sagt: ");
  AddInfo ( ({"lohn", "belohnung", "questbelohnung", "bund", "schluesselbund"}),
            "@@info_bund@@",
            "sagt: ");
  
  SetProp(P_LOG_INFO, "thor/artox.log");

  SetProp(P_SPELLRATE,20);
  AddSpell(1,500,
    "Artox wirft ein gluehendes Stueck Eisen nach Dir.\n",
    "Artox wirft ein gluehendes Stueck Eisen nach @WEM.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
    "Artox schlaegt mit einer Zange auf Dich ein.\n",
    "Artox schlaegt mit einer Zange auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  SetChats(4, ({
    "Artox jammert: Das Metall, das Metall...\n",
    "Artox seufzt: Wo bekomme ich es nur her?\n",
    "Artox blickt traurig und sagt: Wie soll ich es nur fertigschmieden?\n",
    "Artox sagt: Wenn ich nur etwas juenger waere, um in die Hoehle hinabzusteigen.\n"
    "Der Zwergenschmied schlaegt mit dem Hammer auf den Amboss.\n"
    "Artox blickt Dich misstrauisch an.\n"}) );
  SetAttackChats(10, ({
  "Artox bruellt Dich lauthals an.\n"}) );

  SUID;
  CLONEME("/p/weapon/club/schmiedehammer");
  command("zuecke hammer");
}

string quest()
{
  object ob;
  if(deep_present("\nhquest", TP))
    return "Na, hast du das Metall schon gefunden?";

  SUID;
  ob=clone_object(OBJ("hquest"));
  ob->move(TP, M_NOCHECK);
  return
   "Du wuerdest wirklich fuer mich auf die Suche nach dem Metall gehen? "
   "Gelobet seien die Goetter! Ich werde Dir alles sagen, was ich ueber "
   "das Metall weiss... Nach den Legenden ist es in den tiefsten Tiefen "
   "dieser Hoehle hier versteckt, doch der Platz ist laengst in "
   "Vergessenheit geraten. Ein weiser Zwergenkoenig hat angeblich in einer "
   "Kristallhoehle tief unten einen Plan versteckt, der zu dem maechtigen "
   "Metall fuehrt. Aber selbst diese Kristallhoehle ist verschollen und Du "
   "musst wohl das ganze Hoehlensystem durchsuchen, um sie zu finden. Sie ist "
   "von unendlicher Schoenheit und nach der Legende hat sie schon seit "
   "unzaehligen Jahren niemand mehr betreten. Die alten Geschichten sagen, "
   "das tief unten in der Hoehle vier Gegenstaende versteckt sind, die einem "
   "den Weg in die Kristallhoehle oeffnen... Mehr weiss ich leider auch "
   "nicht. Nun aber mach Dich auf den Weg. Ich wuensche Dir alles Glueck "
   "des Silberlandes... Du wirst es brauchen! Und vergiss nicht... huete "
   "Dich vor den Fallen, die die Zwerge ueberall erbaut haben. Die Hoehlen "
   "haben unzaehlige Verstecke!";
}

give_notify( object ob )
{
  int q;
  object obj, qob, pick;

  if(ob->id("endurium"))
    {
    if(!qob=present("\nhquest", TP) || 
      (explode(ob->QueryProp(P_CLONER), ":"))[1]!=getuid(TP)) 
      {
      write("Artox sagt: Hmm... dieses Metall sieht nicht so aus, als "
	   +"wuerde es mir viel nutzen.\n\nEr wirft es sogleich einfach "
	   +"nur ins Feuer der Esse.\n");
      say(BS(CAP_TPN+" gibt Artox einen Klumpen Metall. Dieser meint nur, "
            +"das diesem Metall ihm nicht viel nutze und wirft es sogleich "
            +"ins Feuer.\n"));
      return 1;
      }
    q = TP->GiveQuest("Artox' Lebenswerk");
    if (q == 1)
      {
      tell_room(environment(),
		"Artox jubelt: Du hast das Metall gefunden! Woody sei Dank! "
		"Dies ist wohl der schoenste Tag in meinem Zwergenleben!\n");
      qob->remove();
      write_file ("/log/quests/artoxquest",
      sprintf ("%s  %s hat Artox' Endurium gefunden.\n",
      dtime(time()), capitalize(TP->query_real_name())));
     }
     else
       if (q != -1)
         return
         write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
           "verstaendigen!\nFehlercode: %d\n", q)), 1;
    if(obj=present("kristallplatte", TP))
      {
      write(BS("Artox nimmt Dir die Kristallplatte ab, damit "
	      +"er vielleicht nun auch selber das Metall holen kann.\n"));
      tell_room(environment(TP), BS("Artox nimmt "+TPN+" eine Kristallplatte "
				+"ab.\n"), ({TP}));
      obj->remove();
      }
    if(pick=present("\npickel", TP))
      {
      write(BS("Den Pickel nimmt Dir Artox auch noch ab, den braucht er ja "
              +"schliesslich auch.\n"));
      tell_room(environment(TP), BS("Artox nimmt "+TPN+" einen Pickel "
				   +"ab.\n"), ({TP}));
      pick->remove();
      }
    if(qob=present("\nhquest", TP)) qob->remove();
    }
   else
     {
     tell_room(environment(TP), "Artox bedankt sich artig.\n");
     return ::give_notify(obj);
     }
}

int rep_auswahl(object ob)
{
  if(ob->QueryProp(P_ARMOUR_TYPE))
  {
    write("Artox sagt: Ich repariere keine Ruestungen.\n");
    return 0;
  }
  if(ob->QueryProp(P_WEAPON_TYPE)!=WT_CLUB )
  {
    write("Artox sagt: Ich repariere nur Haemmer und Keulen!\n");
    return 0;
  }
  return 1;
}
string info_bund()
{
  if (TP->QueryGuest())
    return "Lass mich doch in Ruhe ...";
  
  if (TP->QueryQuest("Artox' Lebenswerk")) {
    if (!present("\nschluesselbund",TP)) {
      tell_room(environment(TO), "Artox ueberreicht "+TP->name(WEM)+" einen "
                                 "Schluesselbund.\n",
               ({ ME,TP }) );
      tell_object(TP, "Artox ueberreicht Dir einen Schluesselbund.\n");
      clone_object(OBJ("schluesselbund"))->move(TP, M_NOCHECK);
      return "Du warst mir eine unentbehrliche Hilfe! Du solltest Deinen "
             "Lohn bekommen, fuer die Gefahren, die Du fuer mich auf Dich "
             "genommen hast.";
    }
    else
      return "Aber Du hast Deine Belohnung doch schon erhalten!";
  }
  else if (present("\nhquest", TP))
    return "Du wirst Deine Belohnung schon noch bekommen, aber erst, "
           "nachdem Du Deine Aufgabe beendet hast!";
    else
      return "Lass mich doch in Ruhe ...";
}

