inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Feuergeist");
  SetProp(P_LONG,
    "Der Feuergeist ist ein kleines, etwa ein Meter grosses Wesen, das nur "
   +"aus Flammen zu bestehen scheint. Es ist in staendiger Bewegung und "
   +"strahlt eine unglaubliche Hitze aus. Mit langen Feuerschlingen scheint "
   +"es dauernd nach Dir zu greifen.");
  SetProp(P_NAME, "Feuergeist");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:30,T_RANGE_MAX:60]));
  AddId(({"geist", "feuergeist"}));

  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit einem Feuersturm", 150, DT_FIRE}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Feuergeist");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_FIRE:-1.0, DT_WATER:1.0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "wabert herein");
  SetProp(P_MSGOUT, "wabert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, LAVA("") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, LAVA("bruecke8"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein Feuergeist");

  AddInfo(DEFAULT_INFO, "flimmert nur vor sich hin.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Feuergeist flimmert nur vor sich hin.\n" }) );

  SetProp(P_SPELLRATE, 25);
  AddSpell(3,300,
    "Der Feuergeist huellt Dich in breite Flammenschlingen.\n",
    "Der Feuergeist huellt @WEN in breite Flammenschlingen.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,400,
    "Der Feuergeist spuckt eine Flammenkugel nach Dir.\n",
    "Der Feuergeist spuckt eine Flammenkugel nach @WEN\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));


  SetChats(4,
  "Der Flammengeist flackert leicht.\n" );
}

die()
{
  clone_object(OBJ("fperle.lpc"))->move(environment(TO), M_NOCHECK);
  ::die();
}





