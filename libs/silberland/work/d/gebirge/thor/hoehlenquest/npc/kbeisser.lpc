*************************************/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kristallbeisser");
  SetProp(P_LONG,
    "Der Kristallbeisser ist ein rundes, pelziges Knaeul, von dem ausser "
   +"Zaehnen fast nichts zu sehen ist. Seine langen, scharfen Zaehne sehen "
   +"fast aus wie Diamant, und Du willst sie nicht wirklich zu spueren "
   +"bekommen.");
  SetProp(P_NAME, "Kristallbeisser");
  SetProp(P_GENDER, MALE);
  AddId(({"kristallbeisser", "beisser"}));

  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit diamanternen Zaehnen", 250, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+200*100); // Bonus fuer Spells
  SetProp(P_RACE, "Kristallbeisser");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kullert herein");
  SetProp(P_MSGOUT, "kullert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bleibt tot liegen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Kristallbeisser");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kristallbeisser kullert ein Stueckchen weiter weg.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,300,
    "Der Kristallbeisser schlitzt Dir die Arme auf.\n",
    "Der Kristallbeisser schlitzt @WEN die Arme auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
}
