inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Fledermaus");
  SetProp(P_LONG,
    "Eine kleine, schwarze Fledermaus. Sie starrt Dich durch ihre "
   +"stecknadelgrossen, blinden Augen an. Ihre haeuternen Fluegel schlagen "
   +"unablaessig auf und ab und sie schwirrt wirr um Dich herum. Du hast "
   +"Angst, dass sie sich in Deinen Haaren verfaengt, obwohl Du weisst, "
   +"dass sie sich mit ihrem Gehoer perfekt orientieren kann.");
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"maus", "fledermaus"}));

  create_default_npc(5);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit ihren Zaehnchen", 50+random(40), DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)); // Bonus fuer Spells
  SetProp(P_RACE, "Fledermaus");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, TROPFST("") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, TROPFST("thoehle7"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Fledermaus");
 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus flattert nervoes auf und ab.\n" }) );

}

