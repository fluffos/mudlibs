******************************/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlenbaer");
  SetProp(P_LONG,
    "Vor Dir ragt ein ziemlich grosser, verdutzt dreinschauender Baer auf. "
   +"Er scheint nicht so viele Lebewesen zu sehen, sonst wuerde er wohl "
   +"kaum so ueberrascht dreinschauen. Lass Dich von ihm allerdings nicht "
   +"taeuschen. Er scheint doch ein aeusserst kraeftiger Kerl zu sein.");
  SetProp(P_NAME, "Hoehlenbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"baer", "hoehlenbaer", "hbaer"}));

  create_default_npc(18);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit riesigen Pranken", 300, DT_RIP}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
  SetProp(P_XP, QueryProp(P_XP)+200*100); // Bonus fuer Spells
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "tappst herein");
  SetProp(P_MSGOUT, "tappst");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, HOEHLE("") );
  SetProp(P_MNPC_WAIT, ({ 10, 50, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, HOEHLE("hoehle6"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Hoehlenbaer");

  AddInfo(DEFAULT_INFO, "brummt nur leise.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hoehlenbaer dreht Dir nur den Hintern zu.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(2,500,
    "Der Hoehlenbaer bruellt Dich in Grund und Boden.\n",
    "Der Hoehlenbaer bruellt @WEN in Grund und Boden.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
   AddSpell(1,800,
    "Der Hoehlenbaer zerquetscht Dich.\n",
    "Der Hoehlenbaer zerquetscht @WEN.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1])); 

  SetChats(5, ({
  "Der Hoehlenbaer brummt leise.\n",
  "Der Hoehlenbaer tappst unruhig hin und her.\n"}) );

  CLONEME(ARMOUR("bfell"));
  command("trage alles");
}


