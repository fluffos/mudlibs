inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Fledermaus");
  SetProp(P_LONG,
    "Eine kleine, schwarze Fledermaus. Sie starrt Dich durch ihre "
   +"stecknadelgrossen, blinden Augen an. Ihre haeuternen Fluegel schlagen "
   +"unablaessig auf und ab und sie schwirrt wirr um Dich herum. Du hast "
   +"Angst, dass sie sich in Deinen Haaren verfaengt, obwohl Du weisst, "
   +"dass sie sich mit ihrem Gehoer perfekt orientieren kann.");
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"maus", "fledermaus", "fleder"}));

  create_default_npc(4);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit ihren Zaehnchen", 50+random(40), DT_RIP}));
  SetProp(P_RACE, "fledermaus");
  SetProp(P_BODY, 8);
  SetProp(P_SIZE, 12);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  set_living_name("fledermaus");
//  TP->AddPursuer(TO);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus flattert nervoes auf und ab.\n" }) );
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  object *inv;
  int i;

  if( killer == TO ) {
    inv=player->QueryPursuers();
    for(i=0; i < sizeof(inv); i++)
      if(inv[i]->id("fledermaus"))
        player->RemovePursuer(inv[i]);
  }
  call_out("remove", 0);
}
