inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../quest.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gnom");
  SetProp(P_LONG,
    "Ein aeusserst verdreckter Gnom. Er ist auf und auf mit Schmutz und "
   +"teilweise auch mit Exkrementen beschmiert. Dich ekelt es schon allein "
   +"beim Ankucken von diesem fuerchterlichem Lebewesen. Er stinkt wie "
   +"eine ganze Jauchengrube - ein Wunder irgendwie, wie sehr so ein kleines "
   +"Haeufchen Dreck stinken kann. Sein Gesicht ist kaum zu erkennen durch "
   +"das wirre, zerfiltze Haar, das in schmutzigen Straehnen herunterhaengt. "
   +"Er scheint ziemlich ausgehungert zu sein, denn die dreckigen Lumpen, "
   +"die er an hat, haengen nur schlaff herab. In seinen kleinen Haenden "
   +"haelt er einen Pickel.");
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:5,T_RANGE_MAX:60]));
  AddId( "gnom" );
  set_living_name("gnom");

  create_default_npc(10);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
//  SetProp(P_HANDS, ({" ",,DT_}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 70);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOATTACK, BS("tritt Dir nur einmal kraeftig auf die Zehen "
	             +"und huscht so flink zwischen Deinen Beinen durch, "
	             +"dass Du gar nicht weisst, wie Dir geschieht."));
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Gnom");

  AddInfo(DEFAULT_INFO, "Red keinen Bloedsinn!\n");
  AddInfo("thor", "Hae? Wer solln das sein?","sagt: ");
  AddInfo("pickel", "Meinen Pickel willst Du haben? Niemals! Das ist meiner "
	 +"meiner meiner und nochmal meiner! Hmm... ausser es gaebe da ein "
	 +"Geschaeft...", "laestert: ");
  AddInfo("geschaeft", "Nun ja... die bloeden Einaeugigen haben mich auf "
	 +"einem harmlosen Streifzug durch die Hoehlen hier aufgegabelt und "
	 +"mich einfach hier ausgesetzt. Kannst Du Dir das vorstellen? "
	 +"Ich bin zu klein zum rueberspringen hier, sonst waere ich ja "
	 +"schon lange abgehauen. Wenn Du mich aus dieser Hoelle hier, "
	 +"rausbringst, koennte ich mich vielleicht zu einer kleinen "
	 +"Gegenleistung ueberreden lassen.", "ueberlegt: ");
  AddInfo(({"einaeugige", "zyklopen", "zyklop", "einaeugiger",
	    "einaeugigen"}), "Mann, das "
         +"sind vielleicht doofe Typen. Die koennen nichts als grunzen. "
         +"Sind zu keiner normalen Konversation faehig.", "grummelt: ");
  AddInfo("streifzug", "Geht Dich ueberhaupt nichts an, was ich hier "
	 +"gemacht habe!", "bruellt: ");
  AddInfo(({"hoehlen", "hoehle"}), "Mir gefaellt es manchmal ganz gut hier "
         +"unten in den Hoehlen. Nur hier ist es mir doch ein bisschen zu "
         +"warm.", "sagt schwitzend: ");
  AddInfo(({"leistung", "gegenleistung"}), "Naja, vielleicht koennte ich "
         +"mich ueberreden lassen, Dir einen Gefallen zu tun.", "meint "
         +"vorsichtig: ");
  AddInfo("gefallen", "Darueber reden wir dann spaeter! Nimm mich einfach "
	 +"mal huckepack und bring mich aus dem Lavazeugs raus! Sags mir, "
	 +"wenn wir aus dieser gottverdammten Lavahoehle draussen sind.", 
	  "sagt nur schroff: ");
  AddInfo("quelle", "In der Tropfsteinhoehle muss irgenwo eine sein.\n", 
	  "brummt: ");

  SetChats(5, ({
  "Der Gnom pickt mit dem Pickel auf den Boden.\n",
  "Der Gnom zwickt Dich.\n",
  "Der Gnom gibt ein irres Lachen von sich.\n"}) );

  AddCmd( "nimm", "rauf");
  AddCmd( "sag", "raus");
  AddCmd( ({"beuge", "beug"}), "trinken");

  SUID;
  CLONEME(WEAPON("pickel"));
}

int up=0, drink=0, out=0;

rauf( str )
{
  string raum;
  raum=file_name(environment(TP));
  notify_fail(BS("Der Gnom schreit: Waaah!!! Bist Du sogar zu bloed, dass Du "
	     +"mich einfach nur Huckepack nimmst?\n"));
  if(str=="gnom huckepack")
    {
    if(raum!="/d/gebirge/thor/hoehlenquest/room/lavasee/fbrocken")
      {
      write(BS("Der Gnom schreit: Fummel nicht an mir rum!\n"));
      return 1;
      }
    else
      {
      tell_object(TP, BS("Du zerrst den Gnom auf Deine Schultern, wo er sich "
	    +"sofort wie verrueckt festklammert. Aua! Nicht so fest! Nicht in "
	    +"die Schulter zwicken! Nicht an den Haaren reissen! Argl, "
	    +"das kann ja was werden.\n"));
      tell_room(environment(TP), BS(CAP_TPN+" nimmt den laestigen Gnom auf "
	    +"die Schultern. Hm, warum denn bloss?\n"), ({TP}));
      TO->move(TP, M_NOCHECK|M_SILENT);
      //    call_out("chats", 5);
      up=1;
      return 1;
      }
    }
  else
    return 0;
}

void catch_tell( string str ) 
{ 
  object ob;
  string wo, wo2, raum;

  raum=file_name(environment(TP));

  wo = efun::implode(efun::explode(raum,"/")[0..<2], "/");
  wo2 = efun::implode(efun::explode(raum,"/")[0..<4], "/");

  if ((strstr(str, "sagt: ") != -1) && (strstr(str, "draussen") != -1))
    {
    if(wo!="/d/gebirge/thor/hoehlenquest/room/lavasee")
      {
      tell_room(environment(TP), break_string("Ah! Fein! Hm, aber "
	    +"eigentlich hab ich noch fuerchterlichen Durst. Ich hatte "
	    +"schon tagelang nichts mehr zu trinken. Stell Dir das nur "
	    +"vor! Ich bin viel zu schwach, um selber irgendwo hinzugehen. "
	    +"Von meinen Besuchen hier unten, weiss ich, dass es hier in "
	    +"der Naehe eine Quelle geben muss. Bring mich noch dort hin, "
	    +"oder es wird nichts aus unserem Geschaeft! Wenn wir da sind, "
	    +"sag einfach: \"wasser\".\n", 78, "Der Gnom "
	    +"sagt erfreut: "));
      }

    else
      {
      tell_room(environment(TP), break_string("Red doch keinen Bloedsinn! "
	    +"Wenn Du mich weiter so zum Narren haeltst, wird es nichts aus "
	    +"unserem Geschaeft!\n", 78, "Der Gnom grunzt: "));
      }
    }
  if ((strstr(str, "sagt: ") != -1) && (strstr(str, "wasser") != -1))
    {
    if(raum!="/d/gebirge/thor/hoehlenquest/room/tropfstein/thoehle8")
      {
      tell_room(environment(TP), break_string("Ich sagte, Du sollst mich "
	    +"zur Quelle in der Tropfsteinhoehle bringen, Du Dummkopf! "
            +"Du bist aber wirklich auch zu gar nichts zu gebrauchen! Wie "
	    +"bist Du nur hier runter gekommen?", 78, "Der Gnom "
	    +"quiekt: "));
      write("Der Gnom tritt Dir einmal heftig ins Kreuz.\n");
      tell_room(environment(TP),"Der Gnom tritt "+TPN+" einmal heftig ins "
           +"Kreuz.\n", ({TP}));
      }
    else
      {
      tell_room(environment(TP), break_string("Aaah! Wasser! Schnell! Beug "
	    +"Dich hinunter, damit ich etwas trinken kann! Nun mach doch "
	    +"schon!\n", 78, "Der Gnom sagt ungeduldig: "));
      }
    }
  if ((strstr(str, "sagt: ") != -1) && (strstr(str, "tageslicht") != -1)) 
    {    
    if(wo2!="/d/gebirge/thor/hoehlenquest") 
      {
      if(drink!=1)
 	{ 
	tell_room(environment(TP), BS("Der Gnom laestert: Was soll ich hier? "
            +"ICH HAB DURST, BESORG MIR GEFAELLIGST WAS ZU TRINKEN!\n"));
	}
      else
	{
	tell_room(environment(TP), break_string("Mmmh! Sonne! Waerme! Ist das "
            +"wunderbar! Hach, was bin ich Dir dankbar. War wirklich nett "
            +"von Dir, mich hier rauszubringen. Allerdings... einen Gefallen "
            +"koenntest Du mir noch tun. Ich hab fuerchterlichen Hunger! "
            +"Und ich liebe Kaninchen! Koenntest Du mir nicht noch schnell "
            +"ein Kaninchen braten und mir dann geben? Danach kannst Du dann "
            +"von mir aus meinen Pickel auch haben. Wenn Du fertig bist "
            +"mit braten, sag einfach: \"essen ist fertig\"\n", 78, 
             "Der Gnom sagt: "));
	out=1;
	}
      }
    else if(drink!=1)
      {
      tell_room(environment(TP), BS("Der Gnom meint nur: Was redest Du da "
	    +"fuer nen Bloedsinn?!\n"));      
      }
    else
      {
      tell_room(environment(TP), break_string("Ich hab doch gesagt, Du "
            +"sollst mich ans TAGESLICHT bringen! Es scheint mir hier aber "
            +"noch ziemlich finster zu sein! Also nun mach schon, hopp "
            +"hopp!\n", 78, "Der Gnom sagt ungehalten: "));
      }
    }
  if ((strstr(str, "sagt: ") != -1) && (strstr(str, "essen ist fertig") != -1))
    {
    if(drink!=1||out!=1)
      {
      tell_room(environment(TP), BS("Der Gnom meint nur: Was redest Du da "
	    +"fuer nen Bloedsinn?!\n"));      
      }
    else if(!present("hasenbraten", TP))
      {
      tell_room(environment(TP), BS("Der Gnom sagt: Laber da nicht rum, "
	    +"ich sehe noch nichts, das irgendwie essbar aussieht.\n"));
      }
    else
      {
      TO->move(environment(TP), M_GO|M_SILENT);
      tell_object(TP, BS("Der Gnom klettert von Deinem Ruecken "
	     +"herunter.\n"));
      tell_room(environment(TP), BS("Der Gnom klettert von "+TP->name(WESSEN, 1)
	     +" Ruecken herunter.\n"), ({TP}));
      tell_room(environment(TP), BS("Der Gnom sagt: Nun gib schon her, "
             +"gib mir den Braten!\n"));
      up=0;
      }
    }
  else
    return 0;
}

trinken( str )
{
  string raum;
  raum=file_name(environment(TP));

  if(up!=1)
    {
    write("Wie bitte?\n");
    return 1;
    }

  notify_fail(BS("Der Gnom aetzt: Welchen Bloedsinn hast Du denn jetzt wieder "
	     +"vor? Lass das gefaelligst!!\n"));
  if(raum!="/d/gebirge/thor/hoehlenquest/room/tropfstein/thoehle8")
    return 0;
  if(str=="hinunter")
    {
    write("Du beugst Dich ein Stueckchen zu dem Brunnen hinunter.\n");
    tell_room(environment(TP), BS(CAP_TPN+" beugt sich mit einem Gnom auf "
	    +"dem Ruecken zur Quelle hinunter.\n"), ({TP}));
    tell_room(environment(TP), BS("Der Gnom kreischt: Tiefer! So komme ich "
	    +"nicht ran!\n"));
    return 1;
    }    
  if(str=="tief hinunter"||str=="tiefer hinunter")
    {
    write(BS("Du beugst Dich so tief zum Brunnen hinunter, dass Du beinahe "
	    +"vorne ueberkippst und hineinplatscht.\n"));
    tell_room(environment(TP), BS(CAP_TPN+" beugt sich mit einem Gnom auf "
	    +"dem Ruecken zur Quelle hinunter, so tief, dass "
	    +TP->QueryPronoun()+" fast in den "
	    +"Brunnen hineinplumpst.\n"), ({TP}));
    tell_room(environment(TP), BS("Der Gnom jauchzt erfreut und trinkt in "
            +"grossen, heftigen Schlucken.\n"));
    call_out("tageslicht", 4);
    drink=1;
    return 1;  
    }   
  return 0;
}

tageslicht()
{
  tell_room(environment(TP), break_string("Ah, das tat gut! So, nun zu "
        +"unserem Geschaeft. Allerdings... wenn ich es mir so recht "
        +"ueberlege, bin ich noch viieel zu schwach um hier alleine "
        +"rauszukommen. Und ich wuerd wirklich gerne wieder aus dieser "
        +"riesigen Hoehle raus, zumindest nur in die Naehe des Tageslichtes. "
	+"Also bring mich gefaelligst raus hier, ans Tageslicht! Sobald wir "
        +"draussen sind, sag doch einfach: \"tageslicht\"\n", 78,
	 "Der Gnom sagt gefinkelt: "));
}

give_notify(object ob)
{
  object obj, next, pick;
  if(member(ob->QueryProp(P_IDS), "hasenbraten")!=-1)
    {
    TO->move(environment(TP), M_NOCHECK|M_SILENT);
    write(BS("Der Gnom futtert genuesslich den Hasenbraten auf und fuehlt "
	    +"sich scheinbar sichtlich gestaerkt. Darauf ruempft er kurz "
            +"noch die Nase, drueckt Dir ungehalten den Pickel in die Hand "
            +"und stapft schnurstracks davon.\n"));
    tell_room(environment(TP), BS("Der Gnom futtert genuesslich einen "
	  +"Hasenbraten auf und fuehlt sich scheinbar sichtlich gestaerkt. "
	  +"Darauf ruempft er kurz noch die Nase, drueckt "+TPN+" ungehalten "
	  +"den Pickel in die Hand und stapft schnurstraks davon.\n"), ({TP}));
    if(pick=present("\npickel", TO))
      pick->move(TP, M_NOCHECK);
    else
      write(BS("Unbekannter Fehler! Bitte Magier verstaendigen!\n"));
    for(obj=first_inventory(this_object());obj;) 
      {
      next=next_inventory(obj);
      obj->remove(1);
      obj=next;
      }
    ME->remove();
    return 1;
    }
  else
    {
    write(BS("Der Gnom meint: Mal sehen. Ja, nicht so schlecht. Danke!\n"));
    return ::give_notify(ob);
    }
}

