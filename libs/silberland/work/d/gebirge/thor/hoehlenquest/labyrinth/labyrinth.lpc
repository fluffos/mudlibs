// Thor@SilberLand
// Ein Labyrinth - laby5.c
// 1997-05-05

#include "../quest.h"
#include "../labyrinth.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

mapping MAP;
string lang;
int i;


create()
{
 
  ::create();

  SetProp( P_INT_SHORT, "Ein Labyrinth" );
  SetProp( P_INT_LONG, "");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  MAP=D_DUNKEL;
    AddDetail( ({"dunkelheit", "finsternis"}), MAP[random(2)+1]);
  MAP=D_GAENGE;
  AddDetail( ({"hoehlengaenge", "gaenge", "gang", "hoehlengang"}),
               MAP[random(2)+1]);
  MAP=D_FACKEL;
    AddDetail( ({"fackel", "fackeln", "licht"}), MAP[random(2)+1]);
  MAP=D_FELS;
  AddDetail( ({"fels", "gestein", "felsen", "steine"}), MAP[random(2)+1]);
  MAP=D_UMGEBUNG;
    AddDetail( ({"umgebung", "naehe"}), MAP[random(2)+1]);
  MAP=D_WAENDE;
  AddDetail( ({"waende", "wand", "hoehlenwaende", "hoehlenwand"}),
               MAP[random(2)+1]);
  MAP=D_LOECHER;
    AddDetail( ({"loecher", "loch"}), MAP[random(2)+1]);
  MAP=D_BROCKEN;
    AddDetail( ({"felsbrocken", "brocken", "gesteinsbrocken"}), 
               MAP[random(2)+1]);
  MAP=D_BODEN;
    AddDetail( ({"boden", "felsboden"}), MAP[random(2)+1]);
  MAP=D_KNOCHEN;
  AddDetail( ({"knochen", "gebeine", "gebein"}),
               MAP[random(2)+1]);
  MAP=D_FUESSE;
    AddDetail( ({"fuesse", "beine"}), MAP[random(2)+1]);
  MAP=D_GEFUEHL;
    AddDetail( ({"gefuehl", "orientierung", "bauch"}),
               MAP[random(2)+1]);
  MAP=D_TOTENKOPF;
    AddDetail( ({"totenkopf", "kopf", "totenschaedel", "schaedel"}),
               MAP[random(2)+1]);
  MAP=D_ZACKEN;
  AddDetail( ({"zacken", "decke"}), MAP[random(2)+1]);
  MAP=D_SKELETT;
    AddDetail( "skelett", MAP[random(2)+1]);
  MAP=D_ZWERG;
  AddDetail( "zwerg", MAP[random(2)+1]);
  MAP=D_BRUSTKORB;
    AddDetail( ({"korb", "brustkorb", "brust"}), MAP[random(2)+1]);
  MAP=D_WURM;

  AddDetail( ({"hoehlenwurm", "wurm"}), MAP[random(2)+1]);
  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Du hoerst nicht das geringste Geraeusch.");





}

init()
  {
  ::init();

  lang="";
  for(i=1; i<5; i++)
    {
    switch(i)
      {
      case 1: MAP=LANG_1;
              break;
      case 2: MAP=LANG_2;
              break;
      case 3: MAP=LANG_3;
              break;
      case 4: MAP=LANG_4;
              break;
      case 5: MAP=LANG_5;
      }
    lang=lang+MAP[random(5)+1];
    }  
}       

string int_long(mixed x, mixed y, int z)
{
  return BS(lang)+::int_long(x,y,z);
}














