// #include <config.h>

#include "../quest.h"

mixed saveload;
nosave mapping tport=([ ]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
  if (restore_object(TELEPORTER))
     tport=saveload;
}

query_prevent_shadow() { return 1; }


/* Neuen Player hinzufuegen */
int AddPlayer(object pl)
{
 if(member(tport, getuid(pl)))
      return 0;
 tport+=([getuid(pl):0;0]);
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

/* Player loeschen */
int DeletePlayer(object pl)
{
 if(!pl) return -1;
 if(!member(tport, getuid(pl)))
   return -1;
 tport=m_delete(tport, getuid(pl));
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

/* Finden eines Teleporters */
int InsertaSymbol(object pl, int insert)
{
 if(!pl || insert<0 || insert>1) return -1;
 //tell_object(pl, sprintf("%O\n",));
 tport[getuid(pl), insert]=1;
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

CheckPlayers()
{
return tport;
}

/* Ueberpruefen der Teleporter */
int CheckTport(object pl)
{
 int i;
 if(!pl) return -1;
 
   if(tport[getuid(pl), 0]==1 &&
      tport[getuid(pl), 1]==1)
     return 1; 
   else
     return 0;
}








