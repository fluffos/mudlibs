#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Schacht" );
  SetProp( P_INT_LONG,
    "Du stehst in einem Raum, der einfach nur senkrecht nach oben fuehrt. "
   +"Der Schacht ueber Dir scheint beinahe endlos lang zu sein. Ausser "
   +"schwaerzester Finsternis kannst Du nichts erkennen. Du bist einerseits "
   +"neugierig, wo Dich dieser Schacht wohl hinfuehren wird, andererseits aber "
   +"auch ein wenig skeptisch, ob er Dich nicht etwa von Deiner "
   +"eigentlichen Aufgabe ablenkt.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );
  SetProp(P_NO_MNPC, 1);

  AddDetail( "schacht",
	     "Ueber Deinem Kopf fuehrt ein schier endlos langer Schacht "
            +"nach oben.");
  AddDetail( ({"kopf", "koepfchen"}),
	     "Jaja, ein huebsches Koepfchen hast!");
  AddDetail( "raum",
	     "Raum ist vielleicht nicht die richtige Bezeichnung. Es ist "
            +"einfach nur ein Schacht.");
  AddDetail( "finsternis",
	     "Ja, es ist aeusserst dunkel hier.");
  AddDetail( "aufgabe",
	     "Du solltest vielleicht besser hier unten bleiben.");
  AddDetail( ({"wand", "waende"}),
	     "Die Waende nach oben sind aeusserst unregelmaessig und zackig. "
            +"Es waere zwar fuerchterlich anstrengend, Du kannst aber "
	    +"durchaus mal versuchen, hinaufzuklettern.");
  AddDetail( "boden",
	     "Der Boden ist von Geroell ueberhaeuft.");
  AddDetail( "geroell",
	     "Das viele Geroell am Boden scheint vom Schacht "
	    +"heruntergestuerzt zu sein. Hoffentlich faellt Dir nichts auf "
            +"den Kopf.");
  AddDetail( "decke",
	     "Die Decke ist so hoch ueber Dir, dass Du sie nicht erkennen "
	    +"kannst.");

  AddCmd( ({"kletter", "klettere", "klettre"}), "rauf");

  AddExit( "osten", LAB("laby49"));
}

int i=0;

init()
{
  ::init();
  i=0;
}

rauf( str )
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="rauf"||str=="hinauf"||str=="nach oben"||str=="hoch")
    {
    write(BS("Du klammerst Dich an die Felswand und beginnst zu "
	    +"klettern...\n"));
    say(BS(CAP_TPN+" klammert sich an die Felswand und beginnt, nach oben zu "
	  +"klettern.\n"));
    TP->SetProp(P_PARALYZED, ([
          PARALYZE_TIME: 20,
          PARALYZE_MSG: "Du kletterst gerade wie ein Wahnsinniger.\n",
          PARALYZE_MSG_OTHER: "",
          PARALYZE_END: "",
          PARALYZE_END_OTHER: ""
          ]));
    call_out("klettern1", 3);
    return 1;
    }
  else
    return 0;
}

klettern1()
{
  write(BS("Und Du kletterst...\n"));
  call_out("klettern2", 3);
}

klettern2()
{
  if(find_call_out("klettern2"))
    remove_call_out("klettern2");
  if(i<3)
    {
    write("und kletterst...\n");
    i++;
    call_out("klettern2", 3);
    }
  else
    call_out("klettern3", 3); 
}

klettern3()
{
  write(BS("Du beginnst schon bedenklich zu keuchen. Hat denn dieser bloede "
	  +"Schacht ueberhaupt kein Ende?\n"));
  call_out("klettern4", 5);
}

klettern4()
{
  write(BS("Der Schweiss rinnt Dir ueber das Gesicht und Deine Kraefte drohen "
          +"Dich schon beinahe zu verlassen. Wenn Du an den abgrundtiefen "
	  +"Schlund unter Dir denkst, wird Dir dabei ganz uebel.\n"));
  call_out("klettern5", 7);
}

klettern5()
{
  write(BS("In dem Moment, wo Du die Felswand schon fast losgelassen "
	  +"haettest, fuehlst Du eine Kante ueber Dir. Mit letzter Kraft "
          +"ziehst Du Dich hoch und bleibst erschoepft am Boden liegen.\n"));
  call_out("bewegen", 2);
}

bewegen()
{
  TP->move("/d/gebirge/angrox/4elem/room/wald/wald_m1", M_GO, "", "ist in "
	  +"dem Schacht verschwunden", "kommt aus einem Loch "
	  +"heraufgeklettert");
  TP->do_exhaust(400);
}
