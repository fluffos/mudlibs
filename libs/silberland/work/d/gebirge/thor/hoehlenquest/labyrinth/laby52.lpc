// Thor@SilberLand
// Ein Labyrinth - laby5.c
// 1997-05-05

#include "../quest.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
 
  ::create();

  SetProp( P_INT_SHORT, "Ein Labyrinth" );
  SetProp( P_INT_LONG,
    "Rund um Dich siehst Du nur dunkle Hoehlenwaende. Alles sieht gleich "
   +"aus und Du hast mittlerweile nicht mehr die geringste Ahnung, wo Du "
   +"bist. Gleich vor Dir in einer Hoehlenwand siehst Du ein Loch, gerade zu "
   +"klein, um den Kopf hineinstecken zu koennen. Irgendwie hast Du "
   +"allerdings keine Lust dazu, in dem Loch herumzufummeln.");
  SetProp( P_LIGHT, 0 ); 
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"waende", "hoehlenwaende"}),
	     "Die Hoehlenwaende bestehen aus einem merkwuerdigem, dunklem "
	    +"Gestein.");
  AddDetail( ({"fels", "gestein"}),
	     "Der Fels hier ueberall ist aeusserst dunkel. Du hast so ein "
	    +"Gestein noch nie zuvor gesehen.");
  AddDetail( "ahnung",
	     "Du hast keinen Schimmer, wo Du Dich befinden koenntest.");
  AddDetail( "schimmer",
	     "Davon hast Du nicht den geringsten.");
  AddDetail( ({"wand", "hoehlenwand"}),
	     "In der Hoehlenwand gleich vor Dir siehst Du ein Loch.");
  AddDetail( "loch",
	     "Das Loch ist gerade zu klein dazu, um den Kopf hineinstecken "
            +"zu koennen. Irgendwie hast Du keinen Bock darauf, jetzt in "
            +"dem Loch herumzufummeln.");
  AddDetail( "kopf",
	     "Kein Wunder, dass Du mit so einem Wasserschaedel nirgends "
	    +"reinpasst.");
  AddDetail( ({"schaedel", "wasserschaedel"}),
	     "Na schau Dich doch mal in den Spiegel ;)");
  AddDetail( ({"lust", "bock"}),
	     "Du hast jetzt besseres zu tun, als in dem Loch herumzufummeln.");
  AddDetail( "decke",
	     "Die Decke ueber Dir besteht aus schwarzem Gestein.");
  AddDetail( "boden",
	     "Auch der Boden ist dunkel und felsig.");

  AddCmd( ({"fummel", "fummle"}), "loch");

  AddExit( "suedosten", LAB("laby57"));
  AddExit( "suedwesten", LAB("laby48"));
  AddExit( "nordwesten", LAB("laby53"));
}

int done;

reset()
{
  ::reset();
  done=0;
}

loch( str )
{
  notify_fail("Wo willst Du herumfummeln?\n");
  if( str=="in loch"||str=="in loch herum" )
    {
    if(done==0)
      {
      int i;
      write(BS("Du kreischt laut auf, als ploetzlich ein riesiger Schwarm "
            +"Fledermaeuse aus dem Loch herausstroemt und sich in Deinen "
            +"Haaren verfangen. Sie sehen irgendwie ein wenig sauer aus, "
            +"Du haettest sie wohl besser nicht aus ihrem Schlaefchen wecken "
	    +"sollen. Tja, das hast Du nun davon.\n"));
      say(BS(CAP_TPN+" fummelt in einem Loch in der Wand herum. Urploetzlich "
            +"stroemt ein riesiger Schwarm Fledermaeuse aus dem Loch "
	    +"heraus und stuerzt sich auf "+TPN+".\n"));
      for(i=0; i<5+random(5); i++)
        {
        object ob;
	(ob=clone_object(NPC("fmaus")))->move(environment(TP), M_NOCHECK);
	TP->AddPursuer(ob);
	}
      done=1;
      return 1;
      }
    else
      {
      write(BS("Du fummelst ein wenig um Loch herum, findest aber nichts "
	      +"ausser ein wenig Dreck und Schleim und ziehst angeekelt "
	      +"Deine Hand wieder heraus.\n"));
      say(BS(CAP_TPN+" fummelt in einem Loch herum und zieht seine Hand "
	    +"dann wieder mit einem angeekelten Gesichtsausdruck heraus.\n"));
      return 1;
      }
    }
  else
    return 0;
}









