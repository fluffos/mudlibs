#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Hoehlengang" );
  SetProp( P_INT_LONG,
    "Du gehst einen Hoehlengang entlang. Die Waende der Hoehle sind schwarz "
    "und glatt, nur ab und zu sieht man ein Loch, wo ein Felsbrocken "
    "herausgebrochen ist, der nun am Boden liegt. Du nimmst an, das die "
    "Hoehle natuerlichen Ursprungs ist, es wuerde schliesslich kaum jemand "
    "auf die Idee kommen, so tief unter der Erde ein Hoehlensystem in den "
    "Fels zu schlagen. Gleich links von Dir siehst Du eine grosse, runde "
    "Erhebung.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({ "gang", "hoehlengang" }),
             "Da bist Du gerade.");
  AddDetail( ({"felswaende", "waende", "hoehlenwaende"}),
             "Die Hoehlenwaende sind schwarz und glatt, hie und da ist ein "
             "wenig Gestein daraus herausgebrochen.");
  AddDetail( ({"loch", "loecher"}),
             "In den Hoehlenwaenden sind einige Loecher, wo etwas Gestein "
             "herausgebrochen ist.");
  AddDetail( ({"gestein", "fels"}),
             "Der Fels ist pechschwarz gefaerbt.");
  AddDetail( ({"hoehle", "system", "hoehlensystem"}),
             "Dir kommt der Gedanke, dass Du hier nicht nur in einer simplen "
             "Hoehle, sondern in einem ganzen Hoehlensystem tief unter der "
             "Erde bist.");
  AddDetail( ({"erde", "oberflaeche", "erdoberflaeche"}),
             "Du bist zweifelsohne hier sehr sehr sehr tief unter der "
             "Erdoberflaeche.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Am Boden liegen einige wenige Felsbrocken herum, die aus den "
             "Felswaenden herausgebrochen sind.");
  AddDetail( "boden",
             "Er besteht aus schwarzem Fels und Du siehst manchmal ein paar "
             "Felsbrocken herumliegen.");
  AddDetail( "decke",
             "Die Decke ueber Dir ist ziemlich niedrig.");
  AddDetail( "ursprung",
             "Die Hoehle muss wohl natuerlichen Ursprungs sein, denn die "
             "Waende sind ziemlich glatt. Es sieht nicht so aus, als waeren "
             "sie mit Werkzeugen bearbeitet worden.");
  AddDetail( "erhebung",
	     "Die Erhebung hat einen Durchmesser von etwa einem Meter und "
	     "ist etwa zwanzig Zentimeter hoch. Du koenntest Dich ja "
	     "mal daraufstellen.");

  AddSound( DEFAULT_SOUND,
    "Eine unheimliche Stille erfuellt den Hoehlengang.");
  AddSound( "stille",
    "Es ist absolut nichts zu hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist erstaunlich frisch hier unten.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Du atmest einmal tief die kuehle Hoehlenluft ein.");

  AddCmd( ({"stelle", "stell", "steige", "steig"}), "teleporter");
//  AddCmd( "deleteme", "loeschen");

  AddExit( "nordosten", LAB("laby5"));
  AddExit( "suedosten", LAB("laby3"));
}

teleporter( str )
{
  int test;
  notify_fail("Wo willst Du Dich draufstellen?\n");
  if(str=="auf erhebung")
    {
    if(call_other(TPORTMASTER, "CheckTport", TP)==0)
      {
      write(BS("Du stellst Dich auf die Erhebung, jedoch passiert absolut "
	       "gar nichts. Enttaeuscht steigst Du wieder herunter.\n"));
      say(BS(CAP_TPN+" stellt sich auf die Erhebung drauf, steigt dann "
	     "allerdings mit traurigem Gesicht wieder herunter.\n"));
      return 1;
      }
    else
      {
      write(BS("Du stellst Dich auf die Erhebung und ploetzlich faengt sie "
	     "unter Dir golden an zu schimmern. Ploetzlich scheint sich "
	     "Dein Koerper aufzuloesen und Du verlierst die Orientierung.\n"));
      say(BS(CAP_TPN+" stellt sich auf die Erhebung und beginnt ploetzlich "
	     "vor Deinen Augen zu verschwimmen.\n"));
      call_other(TPORTMASTER, "FindTport", TP, 0);
      }
    if((call_other(TPORTMASTER, "CheckTport", TP))<1)
      {
      write(BS("Unbekannter Fehler! Bitte sofort Magier verstaendigen!\n"));
      return 1;
      }
    TP->move(TROPFST("khoehle1"), M_TPORT);
    return 1;
    }
  else
    return 0;
}

deleteme()
{
  write("Deleted!\n");
  call_other(TPORTMASTER, "DeletePlayer", TP);
}
