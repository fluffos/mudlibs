// Thor@SilberLand
// Ein Labyrinth - lab_amb
// 1997-08-15

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Labyrinth" );
  SetProp( P_INT_LONG,
    "Vor Dir ist der Hoehlengang zu Ende. Du siehst nur eine massive "
    "Felsmauer vor Dir. Dieser Raum hier scheint allerdings irgendetwas "
    "besonderes an sich zu haben. Vom Aussehen unterscheidet er sich kaum "
    "von all den anderen. Der Fels ist schwarz, der Boden ganz blank, wie "
    "sonst auch ueberall. Aus den Felswaenden scheint allerdings eine Art "
    "magische Aura hervorzugehen. In der linken Felswand sind ein paar "
    "Ritzen zu erkennen. Sie haben in etwa die Form von einem Viereck. ");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gang", "hoehlengang"}),
             "Er hoert hier auf.");
  AddDetail( "ende",
	     "Na hier hoert der Gang auf.");
  AddDetail( ({"mauer", "felsmauer"}),
             "Vor Dir ragt eine massive Felsmauer bis zur Decke hinauf. "
             "Hier kommst Du wohl nicht mehr weiter.");
  AddDetail( "raum", 
             "Der Raum hier scheint eine besondere Ausstrahlung zu haben. ");
  AddDetail( "aussehen",
             "Hier sieht es gleich aus, wie in den unzaehligen Raeumen. "
             "Das muesstest Du jetzt ja eh schon zur Genuege kennen. ");
  AddDetail( ({"raeume", "raum", "genuege"}),
	     "Na die Raeume hier kennst Du eh schon zur Genuege.");
  AddDetail( ({"fels", "gestein"}),
             "Auch hier ist das Gestein pechschwarz gefaerbt. ");
  AddDetail( "boden",
             "Der Boden sieht aus, als sei er glatt poliert. ");
  AddDetail( ({"aura", "ausstrahlung"}),
             "Die schwarzen Felswaende scheinen eine merkwuerdige "
             "Ausstrahlung zu haben. ");
  AddDetail( "decke",
             "Von der Decke haengen einige schroffe Zacken herab. ");
  AddDetail( "zacken",
             "Einige Zacken haengen von der Decke herab, die aussehen, "
             "als koennten sie jeden Augenblick herunterbrechen.");
  AddDetail( "augenblick",
	     "Lieber schnell weg, bevor da was herunterbricht.");
  AddDetail( "ritzen",
             "Du erkennst einige tiefe Ritzen in der Felswand. Sie haben "
             "die Form eines Vierecks. Es scheint, als waere hier eine "
             "kleine Aushoehlung im Fels verborgen.");
  AddDetail( "aushoehlung",
             "Du raetselst, wie Du diese Aushoehlung wohl oeffnen koenntest.");
  AddDetail( "viereck",
             "Die Ritzen haben in etwa die Form eines Vierecks.");
  AddDetail( "form",
	     "Die Form sieht aus wie ein Viereck.");
  AddSpecialDetail( ({"waende", "felswaende", "wand", "felswand"}),
             "unt_waende");
  AddSpecialDetail( "loch", "unt_loch");
  AddSpecialDetail( "woelbung", "unt_woelbung");
  AddSpecialDetail( "oeffnung", "unt_oeffnung");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Na Du hoerst ganz einfach nichts.");

  AddCmd( ({"greife", "greif"}), "loch" );
  AddCmd( ({"ertaste", "taste"}), "abtasten" );
  AddCmd( ({"druecke", "drueck"}), "woelbung" );
  AddCmd( ({"fasse", "fass"}), "oeffnung");

  AddItem( NPC("rwurm"), REFRESH_REMOVE);

  AddExit( "norden", LAB("laby27"));
}

int loch=0;
int symb=1;
object ob;

string unt_waende()
{
  if(present("rwurm", environment(TP)))
    {
    return BS("In einer der Felswaende ist ein Loch mit etwa 20 cm "
            "Durchmesser. Ein roter Hoehlenwurm kriecht aus dem Loch "
            "heraus, sonderbarer Weise verlaesst er es allerdings nie ganz. "
            "Neben dem Hoehlenwurm siehst Du einige Ritzen in der Wand "
            "in der Form eines Vierecks.\n");
    }
  else
    {
    return BS("Bei genauerer Betrachtung kannst Du ein etwa 20 cm dickes "
              "Loch erkennen, das in den Fels hineinfuehrt. Neben dem "
              "Loch sind ein paar Ritzen im Fels.\n");
    }
}

string unt_loch()
{
  if(present("rwurm", environment(TP)))
    {
    return BS("Ein Hoehlenwurm kriecht aus dem Loch heraus, er verlaesst es "
              "allerdings nie ganz. Irgendwie macht Dich das Loch "
              "neugierig.\n");
    }
  else
    {
    return BS("Das Loch scheint etwas tiefer in den Fels hineinzufuehren. "
              "Du koenntest ja mal versuchen, hineinzugreifen.\n");
    }
}

string unt_woelbung()
{
  if(!present("rwurm", environment(TP)))
    return BS("Du kannst die Woelbung ja einmal ertasten.\n");
}

string unt_oeffnung()
{
  if(loch==1)
    return BS("Du kannst ja mal hineinfassen.\n");
}

loch( str )
{
  notify_fail("Wo willst Du hineingreifen?\n");
  if(str=="in loch"||str=="in loch hinein")
    {
    if(present("rwurm", environment(TP)))
      {
      write(BS("Der Hoehlenwurm zuckt nach vorne und beisst Dich in die "
               "Hand. Du schreist vor Schmerz laut auf.\n"));
      say(BS(CAP_TPN+" will in das Loch in der Wand hineingreifen, wird dann "
             "aber von dem Hoehlenwurm gebissen. "+CAP_TPN+" schreit vor "
             "Schmerz laut auf.\n"));  
      TP->do_damage(20);
      return 1;
      }
    else
      {
      write(BS("Du greifst tief in das Loch. Es fuehrt ca. 40 cm tief in den "
               "Fels hinein. Mit Deinen Fingerspitzen kannst Du gerade noch "
               "eine kleine Woelbung im Fels erkennen.\n"));
      say(BS(CAP_TPN+" greift tief in ein Loch in der Felswand hinein.\n"));
      return 1;
      }
    }
    return 0;
}    

abtasten( str )
{
  notify_fail("Was willst Du ertasten?\n");
  if(str=="woelbung")
    {
    if(!present("rwurm", environment(TP)))
      {
      write(BS("Du tastest an der Woelbung im Fels herum. Dir scheint, als "
               "waere der Fels hier ein wenig nachgiebig. Du koenntest ja "
               "mal versuchen, in die Woelbung hineinzudruecken.\n"));
      say(BS(CAP_TPN+" fingert in einem Loch in der Felswand herum.\n"));
      return 1;
      }
    }
   else
    return 0;
}

woelbung( str )
{
  notify_fail("Was willst Du druecken?\n");
  if(str=="in woelbung"||str=="woelbung"||str=="in woelbung hinein")
    {
    if(!present("rwurm", environment(TP)))
      {
      write(BS("Du drueckst in die Woelbung im Loch hinein und ploetzlich "
               "oeffnet sich bei den Ritzen neben dem Loch eine kleine "
               "Oeffnung.\n"));
      say(BS(CAP_TPN+" fummelt in einem Loch herum und ploetzlich oeffnet "
               "sich eine kleine Oeffnung im Fels bei den Ritzen.\n"));
      loch=1;
      return 1;
      }
    }
  else
    return 0;
}

oeffnung( str )
{
  notify_fail("Wo willst Du hineinfassen?\n");
  if(str=="in oeffnung"||str=="in oeffnung hinein")
    {
    if(loch!=1)
      return 0;

    if(symb==1 && present("\nhquest", TP) && !present("amboss-symbol", TP))
      {
      write(BS("Du greifst in die Oeffnung hinein und ertastest eine runde, "
               "metallische Platte. Sie ist kuehl und schwer und Du nimmst "
               "sie sogleich an Dich. Als Du die Hand aus der Oeffnung wieder "
               "herausziehst, schliesst sie sich sogleich wieder.\n"));  
      say(BS(CAP_TPN+" zieht rasch etwas aus einer Oeffnung im Fels heraus, "
               "die sich daraufhin sogleich wieder schliesst.\n"));
      ob=clone_object(OBJ("symb_amboss"));
      ob->move(TP, M_NOCHECK);
      symb=0;
      return 1;
      }
    else
      {    
      write(BS("Du greifst in die Oeffnung hinein und tastest ein wenig "
	       "darin herum. Als Du nichts finden kannst, ziehst Du die Hand "
               "enttaeuscht wieder zurueck. Du hast Dich anscheinend "
               "getaeuscht in der magischen Ausstrahlung der Hoehle.\n"));
      say(BS(CAP_TPN+" greift in eine Oeffnung in der Felswand hinein, zieht "
               "dann allerdings die Hand wieder enttaeuscht zurueck.\n"));
      return 1;
      }     
    }
  else
    return 0;
}      


reset()
{
  ::reset();
  symb=1;
  loch=0;
}









