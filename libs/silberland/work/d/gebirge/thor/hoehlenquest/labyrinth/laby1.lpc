// Thor@SilberLand
// Ein Hoehlengang - laby1.c
// 1997-04-30

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Hoehlengang" );
  SetProp( P_INT_LONG,
    "Du stehst in einem Hoehlengang, der kurz vor Dir einen Knick macht und "
   +"Richtung Westen weiterfuehrt. Hinter Dir fuehrt der Abgrund in die "
   +"Tiefe, Du hast allerdings keine grosse Lust, Dich die Treppe wieder "
   +"hinauf zu quaelen. Der Fels ist immer noch schwarz und Du bist Dir "
   +"ziemlich sicher, dass die Hoehle auch hier natuerlichen Ursprungs ist.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({ "gang", "hoehlengang" }),
             "Der Gang vor Dir macht einen Knick nach Westen und fuehrt dann "
            +"weiter.");
  AddDetail( "knick",
             "Der Gang macht einen Knick nach Westen.");
  AddDetail( "abgrund",
             "Der ist hinter Dir. Du bist froh, wieder auf sicherem Boden "
            +"zu stehen.");
  AddDetail( "tiefe",
             "Du hast wohl noch mal Glueck gehabt, Du bist heil hier "
            +"angekommen.");
  AddDetail( "lust",
             "Die Lust, sich die Treppe wieder hinaufzuquaelen, haelt sich in "
            +"Grenzen.");
  AddDetail( "treppe",
             "Die hast Du woodyseidank hinter Dir.");
  AddDetail( "fels",
             "Auch hier ist der Fels pechschwarz gefaerbt.");
  AddDetail( "hoehle",
             "Die Waende der Hoehle sind ueberall eher glatt, daher bist Du "
            +"Dir ziemlich sicher, dass sie natuerlichen Ursprungs ist.");
  AddDetail( "ursprung",
             "Der Gang ist nicht roh aus dem Fels herausgehauen, daher wird "
            +"die Hoehle wohl natuerlichen Ursprungs sein.");
  AddDetail( ({"waende", "wand"}),
             "Die Waende sind relativ glatt, sie scheinen nicht mit "
            +"Werkzeugen aus dem Fels herausgeschlagen worden zu sein.");
  AddDetail( "decke", 
             "Die Decke besteht aus schwarzem Fels.");
  AddDetail( "boden",
             "Der Boden ist hier wieder fest, stabil und felsig. Du bist "
            +"froh, wieder sicher stehen zu koennen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht immer noch Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Wenn alles still ist, hoert man normalerweise nix.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ueberraschend frisch hier unten.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "norden", LAB("laby2"));
  AddExit( "sueden", HOEHLE("loch10"));
}
