// 2004-12-29  angrox: umgebaut auf getuuid()

// #include "/secure/wizlevels.h"
// #include <language.h>
// #include <config.h>

#include "../quest.h"

mixed saveload;
nosave mapping tport=([ ]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
  if (restore_object(TELEPORTER))
     tport=saveload;
}

query_prevent_shadow() { return 1; }


/* Neuen Player hinzufuegen */
int AddPlayer(object pl)
{
 if(member(tport, getuuid(pl)))
      return 0;
 tport+=([getuuid(pl):0;0]);
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

/* Player loeschen */
int DeletePlayer(object pl)
{
 if(!pl) return -1;
 if(!member(tport, getuuid(pl)))
   return -1;
 tport=m_delete(tport, getuuid(pl));
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

/* Finden eines Teleporters */
int FindTport(object pl, int insert)
{
 if(!pl || insert<0 || insert>1) return -1;
 //tell_object(pl, sprintf("%O\n",));
 tport[getuuid(pl), insert]=1;
 saveload=tport;
 save_object(TELEPORTER);
 saveload=0;
 return 1;
}

CheckPlayers()
{
return tport;
}

/* Ueberpruefen der Teleporter */
int CheckTport(object pl)
{
 int i;
 if(!pl) return -1;

 return tport[getuuid(pl), 0] +
        tport[getuuid(pl), 1] +
        tport[getuid(pl), 0] +
        tport[getuid(pl), 1];   // eleganteste Loesung... (woody 15.2.2005)

   if(tport[getuid(pl), 0]==0 &&  // nicht sinnvoll das auf getuuid() aendern
      tport[getuid(pl), 1]==1)    // wen nda schon 400 leuten drinnen stehen und
     return 1;                    // die die quest nochmal machen muessen

   if(tport[getuid(pl), 0]==1 &&
      tport[getuid(pl), 1]==1)
     return 2; 
   else
     return 0;
}

