// 2004-12-29  angrox: umgebaut auf getuuid()

// #include "/secure/wizlevels.h"
// #include <language.h>
// #include <config.h>

#include "../quest.h"

mixed saveload;
nosave mapping symbols=([ ]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
  if (restore_object(SYMB_INSERT))
     symbols=saveload;
}

query_prevent_shadow() { return 1; }


/* Neuen Player hinzufuegen */
int AddPlayer(object pl)
{
 if(member(symbols, getuuid(pl)))
      return 0;
 symbols+=([getuuid(pl):0;0;0;0;0]);
 saveload=symbols;
 save_object(SYMB_INSERT);
 saveload=0;
 return 1;
}

/* Player loeschen */
int DeletePlayer(object pl)
{
 if(!pl) return -1;
 if(!member(symbols, getuuid(pl)))
   return -1;
 symbols=m_delete(symbols, getuuid(pl));
 saveload=symbols;
 save_object(SYMB_INSERT);
 saveload=0;
 return 1;
}

/* Einsetzen eines Symbols in die Wand */
int InsertaSymbol(object pl, int insert)
{
 if(!pl || insert<0 || insert>4) return -1;
 //tell_object(pl, sprintf("%O\n",));
 symbols[getuuid(pl), insert]=1;
 saveload=symbols;
 save_object(SYMB_INSERT);
 saveload=0;
 return 1;
}

int DeleteSymbols(object pl)
{
 int i;
 if(!pl) return -1;
 for(i=1;i<=4;i++)
   symbols[getuuid(pl), i]=0;
 saveload=symbols;
 save_object(SYMB_INSERT);
 saveload=0;
 return 1;
}

/* Einsetzen des _korrekten_ Symbols in die Wand */
int InserttrueSymbol(object pl, int insert)
{
 if(!pl || insert<0 || insert>4) return -1;
 //tell_object(pl, sprintf("%O\n",druids));
 symbols[getuuid(pl), insert]=2;
 saveload=symbols;
 save_object(SYMB_INSERT);
 saveload=0;
 return 1;
}

CheckPlayers()
{
return symbols;
}

/* Ueberpruefen der Symbole */
int CheckSymbols(object pl)
{
 int i;
 if(!pl) return -1;
   for(i=1;i<=4;i++)
     {
     if(symbols[getuuid(pl), i]==0)
       return 0;
     }
   if(symbols[getuuid(pl), 1]==2 &&
      symbols[getuuid(pl), 2]==2 &&
      symbols[getuuid(pl), 3]==2 &&
      symbols[getuuid(pl), 4]==2)  
     return 2; 
   if(symbols[getuuid(pl), 1]>0 &&  
      symbols[getuuid(pl), 2]>0 &&
      symbols[getuuid(pl), 3]>0 &&
      symbols[getuuid(pl), 4]>0)
     return 1;
   return 0;
}

int CheckCorner(object pl, int corner)
{
  if(!pl) return -1;
  if(symbols[getuuid(pl), corner]>0)
    return 1;
}

/* Ueberpruefen, ob alles hingehauen hat und der Exit geoeffnet werden kann */
int CheckExit(object pl)
{
  if(!pl) return -1;
  if(symbols[getuuid(pl), 0]==1)
    return 1;
  return 0;
}








