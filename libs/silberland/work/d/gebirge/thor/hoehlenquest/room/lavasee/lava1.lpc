#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Lavabrocken" );
  SetProp( P_INT_LONG,
    "Dir verschlaegt es beinahe den Atem bei der Hitze, die Dich trifft, wie "
    "ein gewaltiger Hammer, und bei dem Anblick, der sich Dir bietet. Vor "
    "Dir breitet sich ein gewaltiger Lavasee aus, alles glueht in roter, "
    "hoellischer Magma. Etwa zehn Meter unter Dir brodelt die gluehende, "
    "heisse Lava und heisse Schwefelboeen wehen Dir entgegen. Nach einiger "
    "Zeit hast Du Dich zumindest soweit an die hoellische Hitze gewohnt, "
    "sodass Du wieder ein wenig atmen kannst. Von dem kleinen, erstarrten "
    "Lavabrocken, auf dem Du stehst, fuehren zwei Bruecken ueber die Lava "
    "hinweg. Eine geht Richtung Nordwesten, die andere Richtung Norden.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( "atem",
             "Die gluehende Hitze schnuert Dir die Kehle zu und Du kannst nur "
             "mit aeusserster Anstrengung Luft holen.");
  AddDetail( "kehle",
             "Die ist trocken und zugeschnuert.");
  AddDetail( ({"anstrengung", "luft"}),
	     "Nur mit aeusserster Anstrengung gelingt es Dir, etwas Luft zu "
             "holen.");
  AddDetail( "hitze",
             "Die Hitze von dem Hoellenfeuer, das unter Dir glueht, ist "
             "unertraeglich. Am liebsten wuerdest Du einfach wieder umdrehen "
             "und nach oben in die kuehlen Hoehlen zuruecklaufen.");
  AddDetail( ({"hoellenfeuer", "feuer"}),
             "Unter Dir brodelt ein gluehendes Hoellenfeuer.");
  AddDetail( "hoehlen",
             "Du sehnst Dich nach den kuehlen Hoehlen, die ein wenig weiter "
             "ueber Dir liegen.");
  AddDetail( "hammer",
             "Die Hitze erschlaegt Dich beinahe, wie ein riesiger Hammer.");
  AddDetail( "anblick",
             "Dir scheint, als seist Du in der sprichwoertlichen Hoelle.");
  AddDetail( "hoelle",
             "Wenn es tatsaechlich eine gibt, dann muss sie wohl hier sein.");
  AddDetail( ({"see", "lavasee"}),
             "Ein See aus reinstem Magma, der tief unter Dir brodelt und "
             "kocht.");
  AddDetail( ({"magma", "lava"}),
             "Unter Dir brodelt und kocht die rot gluehende Lava und weht Dir "
             "den aetzenden Geruch von Schwefel um die Nase.");
  AddDetail( ({"geruch", "schwefel"}),
	     "Du solltest vielleicht besser einmal riechen.");
  AddDetail( "nase",
             "Die ist bereits aeusserst beunruhigt.");
  AddDetail( ({"schwefelboeen", "boeen"}),
             "Die wehen Dir entgegen und veraetzen Dir beinahe die "
             "Schleimhaeute Deiner Nase.");
  AddDetail( ({"schleimhaeute", "haeute"}),
             "Sie schmerzen schon bedenklich.");
  AddDetail( ({"lavabrocken", "brocken"}),
	     "Wenn Du Dich so in dieser riesigen Lavahoehle umsiehst, siehst "
             "Du mehrere solcher grossen, erstarrten Lavabrocken, die "
             "miteinander durch Bruecken verbunden sind.");
  AddDetail( ({"hoehle", "lavahoehle"}),
             "Die Hoehle breitet sich Richtung Norden aus.");
  AddDetail( "bruecken",
             "Die Lavabrocken sind durch gewaltige Bruecken verbunden. Von "
             "hier fuehrt eine Richtung Nordwesten, eine andere Richtung "
             "Norden weg.");
  AddDetail( ({"waende", "wand"}),
             "Die Wand hinter Dir ist gluehend heiss.");
  AddDetail( "decke",
             "Ueber Dir siehst Du eine dunkelfaerbige Decke aus Lava.");
  AddDetail( "boden",
             "Der Boden ist so heiss, dass Deine Fussohlen heiss brennen.");
  AddDetail( ({"fussohlen", "sohlen"}),
             "Sie schmerzen Dich jetzt schon.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Blubbern der Lava.");
  AddSound( ({"blubbern", "lava"}),
    "Dir kommt es fast vor, als wuerdest Du bei lebendigem Leibe gekocht.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht scharf nach Schwefel.");
  AddSmell( "schwefel",
    "Der Schwefel riecht aetzend scharf und eklig.");

  AddExit( "norden", LAVA("bruecke3"));
  AddExit( "nordwesten", LAVA("bruecke1"));
  AddExit( ({"osten", "ostoben"}), LAVA("gang2"));
  SetProp( P_HIDE_EXITS, ({"osten"}));
}

