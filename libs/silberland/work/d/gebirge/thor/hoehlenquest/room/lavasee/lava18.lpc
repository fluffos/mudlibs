#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf der nordoestlichen Ecke eines Lavablocks. Von hier "
   +"aus scheint der Lavablock viereckig zu sein. Gleich neben Dir im " 
   +"Norden ragt die felsige Hoehlenwand hoch. Dies hier scheint das "
   +"noerdlichste Ende der Lavahoehle zu sein. Ein Stueckchen weiter "
   +"westlich erkennst Du ein dunkles Loch in der Wand. Es koennte sich "
   +"vielleicht um einen Gang handeln, sicher bist Du Dir dabei allerdings "
   +"nicht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"ecke", "eck"}),
	     "Das ist die nordoestliche Ecke des Lavablocks.");
  AddDetail( ({"block", "lavablock"}),
	     "Der Lavablock scheint ziemlich genau viereckig zu sein. Direkt "
            +"vor Dir im Norden ragt die Hoehlenwand in die Hoehe.");
  AddDetail( ({"wand", "hoehlenwand"}),
	     "Du stehst hier direkt vor der Hoehlenwand. Ein kleines "
            +"Stueckchen weiter westlich erkennst Du ein grosses, dunkles "
	    +"Loch in der Wand.");
  AddDetail( "loch",
	     "Es koennte sich bei dem Loch um einen Gang handeln, Du bist "
	    +"Dir von dieser Entfernung allerdings nicht sicher.");
  AddDetail( "entfernung",
	     "Da die Luft durch die enorme Hitze permanent flimmert, kannst "
            +"Du nicht mit Sicherheit sagen, worum es sich bei dem "
            +"grossen, dunkeln Loch in der Hoehlenwand handelt.");
  AddDetail( "luft",
	     "Durch die Hitze wird die Luft in ein dauerhaftes Flirren "
            +"versetzt.");
  AddDetail( "flirren",
	     "Die Luft flirrt durch die Hitze.");
  AddDetail( "hitze",
	     "Es ist immer noch unglaublich heiss hier drinnen.");
  AddDetail( ({"ende", "teil"}),
	     "Du scheinst hier im noerdlichsten Teil der Hoehle angelangt "
            +"zu sein, denn gleich vor Dir ragt die Hoehlenwand "
            +"in die Hoehe.");
  AddDetail( ({"hoehle", "lavahoehle"}),
	     "Ja, das hier scheint der noerdlichste Lavablock der Hoehle "
	    +"zu sein, sofern Du das von hier beurteilen kannst.");
  AddDetail( "sicherheit",
	     "Nein, sicher bist Du nicht.");
  AddDetail( "gang",
	     "Du kannst von hier nicht genau erkennen, ob es sich um "
            +"einen Gang handelt oder nicht, kannst Dir allerdings nicht "
            +"vorstellen, was es sonst sein sollte.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss.");
  AddDetail( ({"fuesse", "fuss"}),
	     "Sie brennen schmerzhaft.");
  AddDetail( ({"waende", "hoehlenwaende", "decke"}),
	     "Waende und Decke bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( ({"lava", "magma"}),
	     "Die Magma brodelt zwanzig Meter unter Dir vor sich hin.");

  AddSound( DEFAULT_SOUND,
            "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
            "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
            "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
            "Atme lieber nicht zu tief ein.");

  AddExit( "sueden", LAVA("lava16"));
  AddExit( "westen", LAVA("lava19"));
  AddExit( "suedwesten", LAVA("lava17"));
}
