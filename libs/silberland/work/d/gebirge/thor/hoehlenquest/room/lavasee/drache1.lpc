***********************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein duesterer Gang" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einem finsterem Hoehlengang. Deine Lichtquelle "
   +"beleuchtet Deine Umgebung nur spaerlich und laesst das dunkle, "
   +"zackige Lavagestein unheimlich aussehen. Von Sueden her dringt etwas "
   +"Licht herein, denn da kannst Du den Gang wieder verlassen. Am Boden "
   +"entdeckst Du einige lange Schleifspuren, Du kannst allerdings nicht "
   +"erkennen, wo sie wohl herkommen moegen. Der Gang fuehrt weiter nach "
   +"Nordwesten und aus dieser Richtung nimmst Du auch einige unheimliche "
   +"Geraeusche wahr.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_NO_MNPC, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 40]) );

  AddDetail( ({"gang", "hoehlengang"}),
	     "Der Gang fuehrt weiter nach Nordwesten.");
  AddDetail( ({"quelle", "lichtquelle"}),
	     "Deine Lichtquelle ist nicht stark genug um den ganzen "
	    +"duesteren Gang auszuleuchten.");
  AddDetail( "umgebung",
	     "Es ist sehr duester hier. Durch das dunkle Lavagestein wird "
	    +"ein Grossteil des Lichtes verschluckt.");
  AddDetail( ({"lavagestein", "gestein"}),
	     "Rund um Dich herum ist nur dunkles Lavagestein.");
  AddDetail( ({"licht", "schimmer", "lichtschimmer"}),
	     "Im Sueden ist ein Lichtschimmer, denn da kommst Du wieder aus "
            +"dem Gang hinaus.");
  AddDetail( ({"spuren", "schleifspuren"}),
	     "Du siehst lange Schleifspuren am Boden, hast allerdings nicht "
	    +"die geringste Idee, wo sie wohl herkommen moegen. Die Spuren "
	    +"lassen Dich ein wenig stutzig werden und Du ueberlegst, ob "
	    +"es nicht besser waere, umzukehren.");
  AddDetail( "idee",
	     "Du kannst Dir nicht vorstellen, wo die Schleifspuren herkommen "
	    +"koennten.");
  AddDetail( "geraeusche",
	     "Von Nordwesten her dringen einige sonderbare Geraeusche an Dein "
	    +"Ohr. Es hoert sich so aehnlich an wie ein Scharren und dumpfes "
	    +"Knurren.");
  AddDetail( "ohr",
	     "Dein Ohr vernimmt einige unheimliche Geraeusche.");
  AddDetail( ({"scharren", "knurren"}),
	     "Vielleicht solltest Du mal lauschen?");
  AddDetail( "boden",
	     "Du siehst einige sonderbare Schleifspuren am Boden.");
  AddDetail( ({"wand", "waende", "decke"}),
	     "Waende und Decke bestehen aus dunklem Lavagestein.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst merkwuerdige Geraeusche von Nordwesten her.");
  AddSound( ({"geraeusche", "geraeusch"}),
    "Es hoert sich fast an wie ein Scharren und Knurren.");
  AddSound( "scharren",
    "Es ist nicht sehr laut, aber es scheint aus Nordwesten zu kommen.");
  AddSound( "knurren",
    "Ein dumpfes, grollendes Knurren. Dir laeuft dabei eine Gaensehaut "
   +"ueber den Ruecken.");
    
  AddSmell( DEFAULT_SMELL,
    "Ein leichter Schwefelgeruch weht noch vom Lavasee herein.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
    "Ganz hat sich der Schwefelgeruch noch nicht verzogen.");

  AddExit( "nordwesten", LAVA("drache2"));
  AddExit( "sueden", LAVA("lava19"));
}


