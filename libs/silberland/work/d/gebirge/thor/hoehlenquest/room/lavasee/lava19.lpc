*  Thor@SilberLand           *
*  Ein Lavablock - lava18.c  *
*  1997-08-17                *
*****************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf der nordwestlichen Ecke eines Lavablocks. Von hier "
    "aus scheint der Lavablock viereckig zu sein. Dies hier scheint das "
    "noerdlichste Ende der Lavahoehle zu sein. Hier erkennst Du nun, dass "
    "es sich bei dem dunkeln Loch wirklich um einen Gang gehandelt hat. "
    "Gleich vor Dir ist in der Hoehlenwand ein grosser Durchlass. Am Boden "
    "kannst Du einige Schleifspuren entdecken, weiter siehst Du allerdings "
    "nicht in den Gang hinein, dazu ist er zu dunkel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"ecke", "eck"}),
	     "Das ist die nordwestliche Ecke des Lavablocks.");
  AddDetail( ({"block", "lavablock"}),
	     "Der Lavablock scheint ziemlich genau viereckig zu sein.");
  AddDetail( ({"wand", "hoehlenwand"}),
	     "Du stehst hier direkt vor der Hoehlenwand. In der Wand ist "
             "ein breiter Durchlass, allerdings kannst Du Dir nicht im "
	     "geringsten vorstellen, wo der hinfuehren koennte.");
  AddDetail( "loch",
	     "Es hat sich bei dem Loch tatsaechlich um einen Hoehlengang "
	     "gehandelt. Am besten, Du siehst einfach mal nach, wo er "
	     "hinfuehrt.");
  AddDetail( "luft",
	     "Durch die Hitze wird die Luft in ein dauerhaftes Flirren "
             "versetzt.");
  AddDetail( "flirren",
	     "Die Luft flirrt durch die Hitze.");
  AddDetail( "hitze",
	     "Es ist immer noch unglaublich heiss hier drinnen.");
  AddDetail( ({"ende", "teil"}),
	     "Du scheinst hier im noerdlichsten Teil der Hoehle angelangt "
             "zu sein, denn gleich vor Dir ragt die Hoehlenwand mit einem "
	     "grossen Durchgang mitten drinnen in die Hoehe.");
  AddDetail( ({"hoehle", "lavahoehle"}),
	     "Ja, das hier scheint der noerdlichste Lavablock der Hoehle "
	     "zu sein, sofern Du das von hier beurteilen kannst. Es ist "
	     "immer noch hoellisch heiss hier drinnen und Luft flirrt "
	     "unablaessig durch die unmenschliche Hitze.");
  AddDetail( ({"durchlass", "gang", "hoehlengang", "durchgang"}),
	     "Der Gang fuehrt nach Norden weiter. Das einzige, was Du "
	     "erkennen kannst, sind ein paar Schleifspuren hier am Anfang "
	     "des Ganges. Hmm, irgendwie ist Dir die Sache nicht "
	     "ganz geheuer.");
  AddDetail( "anfang",
	     "Hier ist der Anfang des Hoehlengangs.");
  AddDetail( ({"spuren", "schleifspuren"}),
	     "Die Schleifspuren am Boden lassen Dir das ganze nicht "
	     "geheuer vorkommen. Du ueberlegst schon, ob Du nicht besser "
	     "umkehren solltest.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss. Du siehst "
	     "ausserdem noch einige Schleifspuren am Boden.");
  AddDetail( ({"fuesse", "fuss"}),
	     "Sie brennen schmerzhaft.");
  AddDetail( ({"waende", "hoehlenwaende", "decke"}),
	     "Waende und Decke bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( ({"lava", "magma"}),
	     "Die Magma brodelt zwanzig Meter unter Dir vor sich hin.");

  AddSound( DEFAULT_SOUND,
            "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
            "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
            "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
            "Atme lieber nicht zu tief ein.");

  AddExit( "sueden", LAVA("lava17"));
  AddExit( "osten", LAVA("lava18"));
  AddExit( "suedosten", LAVA("lava16"));
  AddExit( "norden", LAVA("drache1"));
}
