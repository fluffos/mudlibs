#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Kristallsaeule" );
  SetProp( P_INT_LONG,
    "Rund um Dich herum siehst Du nur Kristall. Du bist eins damit geworden, "
   +"der Kristall ist allerdings nicht starr, wie Du vermutet hast, sondern "
   +"Du kannst Dich ganz langsam bewegen, Dir ist es, als seist Du in einer "
   +"zaehen Fluessigkeit eingeschlossen. Alles erscheint Dir wie pure Magie. "
   +"Gleich neben Dir siehst Du eine runde Metallplatte.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );
  
  AddCmd( ({"unt", "untersuche"}), "look");
}

init()
{
  ::init();
  if(!present("pickelsymbol", TO))
    clone_object(OBJ("symb_pickel"))->move(TO, M_NOCHECK);
}

look()
{
  write(BS("Hier besteht alles einfach nur aus Kristall. Er wirkt allerdings "
          +"wie eine zaehe Fluessigkeit, die Dich umgibt."));
  return 1;
}

varargs int PreventLeave(object ob)
{
  if((member(ob->QueryProp(P_IDS), "pickel-symbol"))!=-1)
    {    
    write(BS("Ploetzlich beginnt sich alles um Dich herum zu verhaerten und "
          +"die Kristallsaeule spuckt Dich einfach wieder aus. Verbluefft "
          +"schuettelst Du nochmal Deinen Kopf.\n"));
    say(BS(CAP_TPN+" verschwindet urploetzlich vor Deinen Augen aus der "
	      +"Kristallsaeule.\n"));
    TP->move(TROPFST("khoehle11"), M_GO|M_SILENT); 
    }  
  return ::PreventLeave(ob);
}









