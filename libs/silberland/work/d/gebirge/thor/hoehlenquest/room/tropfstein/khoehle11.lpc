#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Der Weg rund um die Kristallsaeule fuehrt hier Richtung Suedwesten und "
    "Suedosten weiter. Die Saeule ragt gleich suedlich von Dir bis zur Decke "
    "hoch. Sie ist wirklich ein gigantisches Werk der Natur. Es braucht "
    "wahrscheinlich einige tausend Jahre, um so etwas Gewaltiges entstehen zu "
    "lassen. Ehrfuerchtig blickst Du die Saeule von oben bis unten an. Die "
    "verschiedenen, kristallinen Formen, die ueberall herauswachsen, brechen das "
    "Licht funkelnd und glitzernd.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );
  
  AddDetail( "weg",
             "Er fuehrt nach Suedwesten und Suedosten.");
  AddDetail( ({"saeule", "kristallsaeule"}),
             "Die Kristallsaeule ragt etwa vier Meter zur Decke hoch. Sie "
             "ist am Boden und an der Decke, wo sie festgewachsen ist, etwas "
             "dicker als in der Mitte. Du stehst noch immer mit offenem Mund "
             "vor der Saeule und bewunderst ihre Pracht.");
  AddDetail( "decke",
	     "Von der Decke haengen zahlreiche groessere und kleinere "
             "Kristalle herunter.");
  AddDetail( "boden",
             "Sogar am Boden sieht man einige Kristalle funkeln.");
  AddDetail( ({"kristall", "kristalle", "bergkristalle"}),
             "Die Bergkristalle funkeln in den verschiedensten Farben.");
  AddDetail( "farben",
             "Das Licht wird in den Farben des Regenbogens gebrochen.");
  AddDetail( ({"regenbogen", "bogen"}),
             "Wenn Du erwartest, hier unten einen zu sehen, dann wirst Du wohl "
             "lange warten muessen.");
  AddDetail( "mitte",
             "Die Saeule ist in der Mitte duenner als an den Stellen, wo sie "
             "festgewachsen ist.");
  AddDetail( ({"stellen", "stelle"}),
             "Die Kristallsaeule ist am Boden und an der Decke festgewachsen.");
  AddDetail( "mund",
             "Vielleicht solltest Du ihn doch wieder mal zumachen.");
  AddDetail( "werk",
             "Solch ein fantastisches Werk kann wohl nur Mutter Natur "
             "vollbringen.");
  AddDetail( ({"natur", "mutter"}),
             "Jaja, die Natur vollbringt schon tolle Sachen.");
  AddDetail( "sachen",
             "Na z.B. die Saeule vor Dir.");
  AddDetail( "jahre",
             "Es hat wahrscheinlich Tausende von Jahren gedauert, um solch ein "
             "Werk entstehen zu lassen.");
  AddDetail( ({"formen", "kristallformen"}),
             "Die vielen Kristallformen brechen das Licht in allen nur "
             "erdenklichen Variationen.");
  AddDetail( "licht",
             "Es wird in allen Farben gebrochen.");
  AddDetail( ({"variation", "variationen."}),
             "Das Licht wird in allen Variationen gebrochen.");
  AddDetail( ({"waende", "wand"}),
             "An den Waenden wachsen ueberall ganze Bueschel von Kristallen "
             "heraus.");
  AddDetail( ({"bueschel", "kristallbueschel"}),
             "An den Waenden sind die Kristalle meistens schon zu ganzen "
             "Buescheln zusammengewachsen.");
  AddSpecialDetail( "pracht", "unt_pracht");
  AddSpecialDetail( "loch", "unt_loch");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Krachen Deiner Schritte auf den Kristallen am "
    "Boden.");
  AddSound( ({"schritte", "schritt"}),
    "Pass lieber auf, dass Du nicht zuviel zusammentrittst.");
  AddSmell( DEFAULT_SMELL,
    "Es ist angenehm kuehl hier drinnen.");

  AddCmd( ({"mache", "mach"}), "mund" );
  AddCmd( ({"stecke", "steck"}), "crystal");

  AddItem( NPC("kbeisser"), REFRESH_REMOVE);

  AddExit( "suedwesten", TROPFST("khoehle7"));
  AddExit( "suedosten", TROPFST("khoehle12"));
}

int kristall=0;

reset()
{
  ::reset();
  kristall=0;
}

mund( str )
{
  notify_fail("Was willst Du zumachen?\n");
  if(str=="mund zu")
    {
    write(BS("KLAPP!... Wurde aber langsam auch Zeit. Man koennte ja schon fast "
             "meinen, Du waerst ein Fisch.\n"));
    say(BS(CAP_TPN+" macht "
          +((TP->QueryProp(P_GENDER))==MALE?"seinen":"ihren")+" Mund zu.\n"));
    return 1;
    }
  else
    return 0;
}

crystal( str )
{
  object ob;

  notify_fail("Was willst Du wo hineinstecken?\n");
  if(kristall==1)
    {
    write(BS("Hier kannst Du nirgends was hineinstecken. Vielleicht "
             "solltest Du ja spaeter nochmal kommen.\n"));
    return 1;
    }

  if(str=="kristall in saeule"||str=="bergkristall in saeule"||str=="kristall in kristallsaeule"||str=="bergkristall in kristallsaeule"||str=="kristall in loch"||str=="bergkristall in loch")
    {
    if(ob=present("bergkristall", TP))
      {
      if(present("\nhquest", TP) && !present("pickel-symbol", TP))
	{
	write(BS("Du steckst den Bergkristall in das Loch hinein und ... ja! "
	       "Er passt wie angegossen. Jedoch... Was ist das? Ploetzlich "
               "beginnt der Kristall sich auszudehnen, oder Du wirst in den "
               "Kristall hineingezogen, Du bist Dir nicht ganz sicher, was "
               "genau mit Dir geschieht. Der Kristall dehnt sich immer weiter "
               "um Dich aus, bis er Dich schliesslich gaenzlich "
	       "umschliesst.\n"));
	say(BS("Du traust Deinen Augen nicht! Vor Dir wird "+TPN+" in die "
               "Kristallsaeule hineingezogen! Immer weiter dehnt sich der "
               "Kristall um "+TPN+" aus, bis er ihn schliesslich gaenzlich "
               "umschliesst und "+TPN+" schliesslich verschwunden ist.\n"));
	call_out("bewegen", 4);
	ob->remove();
	kristall=1;
	return 1;
	}
      else
	{
	write(BS("Du steckst den Bergkristall in das Loch hinein... und es "
		 "passiert nicht das geringste... Hm, sonderbar.\n"));
	say(BS(CAP_TPN+" steckt einen Bergkristall in die Kristallsaeule, es "
	         "passiert allerdings nichts.\n"));
	ob->remove();
	kristall=1;
	return 1;
	}
      }
    else
      {
      write(BS("Aber Du hast doch gar keinen Bergkristall!\n"));
      return 1;
      }
    }
  else
    return 0;
}

bewegen()
{
  TP->move(TROPFST("ksaeule"), M_GO|M_SILENT);
}

string unt_pracht()
{
  if(kristall==0 && !present("pickel-symbol", TP))
    {
    return BS("Du stehst einfach nur da und bewunderst die Pracht der "
           "Kristallsaeule. Doch... hoppla! Was ist das? Mitten in der "
           "Saeule ist ein kleines Loch. Irgendwie passt es ueberhaupt nicht "
           "zu dieser makellosen Pracht.\n");
    }
  else
    {
    return BS("Du stehst einfach nur da und bewunderst die Pracht der "
           "Kristallsaeule.\n");
    }
}

string unt_loch()
{
  if(kristall==0 && !present("pickel-symbol", TP))
    {
    return BS("Das Loch ist fuenfeckig und geht gute zwanzig Zentimeter tief "
	   "in die Kristallsaeule hinein. Hmm... was da wohl hineingehoeren "
	   "mag?\n");
    }
  else
    return 0;
}



