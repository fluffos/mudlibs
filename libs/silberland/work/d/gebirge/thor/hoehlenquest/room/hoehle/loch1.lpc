// Thor@SilberLand
// Ein Loch in die Tiefe - loch1.c
// 1997-04-24

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Loch in die Tiefe" );
  SetProp( P_INT_LONG,
    "Du erschrickst fuerchterlich, als Du gerade noch das Gleichgewicht "
    "behalten kannst, damit Du nicht in den Abgrund, der direkt vor Deinen "
    "Fuessen in die Tiefe fuehrt, hinunterstuerzt. Hinter Dir ist der schmale "
    "Spalt in der Felswand, durch den Du gekommen bist und vor Dir fuehrt nur "
    "ein scheinbar bodenloses, pechschwarzes Loch in die Tiefe. Der Fels ist "
    "hier zur Gaenze schwarz gefaerbt. Im Loch fuehrt eine Treppe die Wand "
    "entlang hinunter in die Tiefe. Die Treppe ist aus dem Stein "
    "herausgemeisselt und fuehrt spiralfoermig nach unten.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gewicht", "gleichgewicht"}),
             "Uff, noch mal Glueck gehabt. Du kannst Dich gerade noch auf "
             "den Beinen halten, sodass Du gerade nochmal einem Sturz in die "
             "Tiefe entkommen bist.");
  AddDetail( "beine",
             "Deine Beine sind noch ziemlich weich von dem Schreck.");
  AddDetail( "schreck",
             "Er sitzt noch ziemlich tief in Dir.");
  AddDetail( "sturz",
             "Von Dir waere wahrscheinlich nicht mehr viel uebrig, wenn Du da "
             "wirklich hinuntergefallen waerst.");
  AddDetail( "tiefe",
             "Der Schlund vor Dir scheint endlos in die Tiefe zu gehen.");
  AddDetail( ({"loch", "schlund"}),
             "Du kannst keinen Boden in dem Schlund vor Dir erkennen. Nur am "
             "Rand fuehrt den Waenden entlang eine Treppe nach unten, die "
             "spiralfoermig in den Fels gehauen wurde.");
  AddDetail( "treppe",
             "Die Treppe fuehrt spiralfoermig den Waenden entlang nach unten. "
             "Sie ist aus dem Fels herausgehauen, wirkt allerdings nicht mehr "
             "gerade vertrauenserweckend. Die Stufen sind alt und verfallen, "
             "an manchen Stellen sind sie schon gaenzlich zersplittert.");
  AddDetail( "stufen",
             "Die Stufen der Treppe sind teilweise schon zerbroeckelt und "
             "sehr verfallen. Du bekommst ein mulmiges Gefuehl im Bauch, bei "
             "dem Gedanken, da hinunterzusteigen.");
  AddDetail( ({"gefuehl", "bauch", "gedanken"}),
             "Du hast ein aeusserst unangenehmes Gefuehl im Bauch, wenn Du "
             "naeher darueber nachdenkst, da hinunterzusteigen.");
  AddDetail( "abgrund",
             "Vor Dir fuehrt ein scheinbar bodenloser Abgrund in die Tiefe "
             "hinab.");
  AddDetail( ({"fuesse", "rand"}),
             "Du stehst genau am Rande des Abgrunds. Ein paar Zentimeter "
             "weiter, und Du muesstest Dir keine Gedanken mehr ueber Deine "
             "weitere Zukunft machen.");
  AddDetail( "zukunft",
             "Eine solche haettest Du wohl nicht mehr, waerst Du nur einige "
             "Zentimeter weiter vorne gestanden.");
  AddDetail( "spalt",
             "Hinter Dir ist der Spalt, durch den Du wieder zurueck kannst.");
  AddDetail( ({"wand", "felswand"}),
             "Hinter Dir in der Felswand ist der schmale Spalt, durch den "
             "Du gekommen bist.");
  AddDetail( "fels",
             "Der Fels ist hier nun zur Gaenze schwarz gefaerbt. Hier wirkt "
             "alles noch dunkler, als in der Hoehle zuvor.");
  AddDetail( "stein",
             "Eine Treppe ist in den Stein hineingemeisselt.");
  AddDetail( "waende",
             "Die Waende entlang ist eine Treppe in den Fels "
             "hineingemeisselt.");
  AddDetail( "boden",
             "Davon hast Du nur sehr wenig unter den Fuessen.");
  AddDetail( "decke",
             "Die Decke ueber Dir besteht aus schwarzem Fels.");
  AddDetail( "hoehle",
             "Die liegt westlich von Dir.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht eine erdrueckende Stille hier.");
  AddSound( "stille",
    "Du hoerst absolut nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus der Tiefe dringt ein kuehler Luftzug herauf.");
  AddSmell( "luftzug",
    "Er wirkt irgendwie angenehm.");

  AddCmd( ({ "zwaenge", "zwaeng" }), "spalt" );

  AddExit( "suedosten", HOEHLE("loch2"));
}

spalt( str )
{
  notify_fail( "Wo willst Du Dich durchzwaengen?\n" );
  if( str == "durch spalt" || str == "durch spalt hindurch" ||
      str == "durch spalte"|| str == "durch spalte hindurch" ||
      str == "spalt" || str == "spalte")
  {
    write(BS("Du machst Dich so duenn Du kannst und zwaengst Dich muehsam "
          "durch den schmalen Spalt in der Wand hindurch.\n"));
    TP->move(HOEHLE("hoehle10"), M_GO, "", "zwaengt sich durch einen schmalen "
	  "Spalt in der Wand hindurch und ist verschwunden", 
	  "kommt durch einen Spalt herein");
    return 1;
  }
  return 0;
}


