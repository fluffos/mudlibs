// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle6.c
// 1997-05-15

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einem Gang der Hoehle, der Richtung Norden "
   +"weiterfuehrt. Einige kleine Tropfsteine haengen noch von der Decke "
   +"herunter. Ab und zu tropft ein Wassertropfen von der Decke herab und "
   +"faellt Dir auf die Nase. In einem so engen Gang wirkt die hohe "
   +"Feuchtigkeit irgendwie erdrueckend. Die Waende glaenzen nass vom Licht "
   +"Deiner Fackel.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "gang",
             "Der Gang, in dem Du stehst, fuehrt weiter nach Norden.");
  AddDetail( "hoehle",
             "Die Hoehle hat sich hier zu einem Gang verengt.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Von der Decke haengen einige kleinere Tropfsteine herab, von "
            +"denen etwas Wasser heruntertropft.");
  AddDetail( "decke",
             "Es haengen einige Tropfsteine davon herab.");
  AddDetail( ({"wasser", "wassertropfen"}),
             "Ab und zu faellt Dir ein Wassertropfen von oben auf die Nase. "
            +"Hihi... Das kitzelt! :)");
  AddDetail( "nase",
             "Sie ist schon ganz feucht.");
  AddDetail( "feuchtigkeit",
             "Es ist ziemlich nass hier in diesem Gang.");
  AddDetail( "waende",
             "Die Waende schimmern glaenzend vom Licht Deiner Fackel.");
  AddDetail( ({"licht", "fackel"}),
             "Das Licht Deiner Fackel wird von den feuchten Waenden "
            +"reflektiert. Sie schimmern daher glaenzend.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers.");
  AddSound( ({"wasser", "tropfen"}),
    "*tropf* *tropf* *tropf*");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist angenehm kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddRoomMessage( 
    ({"Ein Wassertropfen tropft Dir auf die Nase.\n"}),30);

  AddExit( "norden", TROPFST("thoehle7"));
  AddExit( "osten", TROPFST("thoehle5"));
  AddExit( "suedosten", TROPFST("thoehle4"));
}
