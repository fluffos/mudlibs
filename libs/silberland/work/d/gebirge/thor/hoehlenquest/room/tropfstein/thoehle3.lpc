// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle3.c
// 1997-05-14

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Dir bietet sich ein atemberaubender Anblick. Vor Dir breitet sich eine "
    "riesige Tropfsteinhoehle aus. Ueberall haengen lange Stalaktiten von "
    "der Decke herab und am Boden haben sich Stalagmiten gebildet. Der Fels "
    "schimmert ueberall feucht und glaenzend und gibt der Hoehle ein "
    "maerchenhaftes Aussehen. Zwischen den unzaehligen Stalagmiten fuehren "
    "zwei Durchgaenge weiter. Einer fuehrt nach Norden, der andere wendet "
    "sich Richtung Westen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "anblick",
             "Der Anblick, der sich Dir bietet, ist wirklich "
             "ueberwaeltigend. Dir scheint es, als wuerde ein steinener Wald, "
             "der aus langen, duennen Baeumen besteht, von der Decke "
             "herunterwachsen.");
  AddDetail( "decke",
             "Die Decke ist mit unzaehlig vielen Stalaktiten bewachsen, die "
             "Dich an einen versteinerten Wald erinnern.");
  AddDetail( ({"tropfsteinhoehle", "hoehle"}),
             "Vor Dir breitet sich eine gewaltige Tropfsteinhoehle aus.");
  AddDetail( ({"stalaktiten", "stalaktite", "stalaktit"}),
             "Stalaktiten der verschiedensten Groessen und Formen haengen "
             "von der Decke herab.");
  AddDetail( ({"baeume", "wald", "tropfstein", "tropfsteine"}),
             "Die zahlreichen Stalaktiten, die von der Decke herabhaengen, "
             "erinnern irgendwie an lange, duenne, steinerne Baeume in einem "
             "geheimnisvollen Wald.");
  AddDetail( ({"groessen", "formen"}),
             "Die Stalaktiten und Stalagmiten haben die verschiedensten Formen "
             "und Groessen.");
  AddDetail( "boden",
             "Am Boden ragen teils kleinere, teils groessere Stalagmiten in "
             "die Hoehe.");
  AddDetail( "fels",
             "Der feuchte Fels schimmert glaenzend im schwachen Licht Deiner "
             "Fackel.");
  AddDetail( ({"licht", "fackel"}),
             "Das Licht Deiner Fackel verleiht der feuchten Hoehle ein "
             "wirklich maerchenhaftes Aussehen.");
  AddDetail( ({"aussehen", "umgebung"}),
             "Du bist fasziniert von Deiner schimmernden Umgebung.");
  AddDetail( ({"stalagmiten", "stalagmite", "stalagmit"}),
             "Zwischen den Stalagmiten am Boden kannst Du zwei Durchgaenge "
             "erkennen.");
  AddDetail( "durchgaenge",
             "Der eine fuehrt nach Norden, der andere nach Westen, weiter "
             "durch die Hoehle durch.");
  AddDetail( "waende",
             "Die feuchten Waende schimmern im Licht Deiner Fackel.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst leise etwas Wasser von der Decke heruntertropfen.");
  AddSound( ({"wasser", "tropfen", "geraeusch"}),
    "Ein beruhigendes Geraeusch.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft in der Hoehle ist feucht und kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief die frische Luft ein.");

  AddExit( "norden", TROPFST("thoehle4"));
  AddExit( "westen", TROPFST("thoehle9"));
  AddExit( "sueden", TROPFST("thoehle2"));
}

