#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Kristallhoehle" );
  SetProp( P_INT_LONG,
    "Atemlos siehst Du Dich in der Hoehle um, die Du gerade betreten hast. "
    "Ueberall siehst Du nur funkelndes Glitzern, dass Deine Augen "
    "beinahe ein wenig blendet. Die Waende, der Boden, alles, leuchtet hier "
    "in einem sanften, blauen Schimmer. Die Hoehle in der Du stehst, ist "
    "nicht sehr gross, dafuer aber unglaublich hoch. Du kannst die Decke nur "
    "als leichtes Glitzern hoch oben erkennen. Alles hier besteht aus "
    "Kristall, es ist nichts anderes zu erkennen. Links und rechts von "
    "Dir siehst Du je drei Saeulen aus dem Bergkristall herausgemeisselt. "
    "In der Mitte der Hoehle siehst Du ein Gebilde, das Dich an einen "
    "Altar erinnert. Links und rechts davon stehen zwei riesige Gestalten, "
    "die vollkommen zu Kristall erstarrt sind. In einer Ecke siehst Du einen "
    "kleinen Haufen Kristallstaub.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );
 
  AddDetail( ({"hoehle", "kristallhoehle"}),
	     "Die Hoehle ist mit einem Wort... wundervoll! Alles ist mit "
	     "einem sanften, blauen Licht erleuchtet und der Kristall "
	     "funkelt und glitzert so maerchenhaft schoen, dass Du "
	     "einen Moment nur atemlos dastehst und dieses Wunder hier "
	     "mit offenem Mund bestaunst.");
  AddDetail( "wort",
	     "Ich sagte doch: wundervoll!");
  AddDetail( ({"licht", "leuchten", "schimmern", "schimmer"}),
	     "Das Licht, das der ganzen Hoehle einen blaeulichen Schimmer "
	     "verleiht, kommt direkt aus dem Kristall selbst. Die eigentliche "
	     "Quelle jedoch ist unergruendlich.");
  AddDetail( ({"kristall", "bergkristall"}),
	     "Alles in dieser Hoehle besteht aus wunderbarem, klarem "
	     "Bergkristall. Von dem Kristall selbst geht ein sanftes, blaues "
	     "Licht aus, das die Hoehle in eine ueberirdische und irgendwie "
	     "unwirkliche Schoenheit taucht.");
  AddDetail( "quelle",
	     "Es ist Dir unmoeglich, die Quelle des sanften, blauen Leuchtens "
	     "zu bestimmen.");
  AddDetail( "schoenheit",
	     "Die Schoenheit der Hoehle ist unbeschreiblich.");
  AddDetail( "moment",
	     "Du haelts atemlos inne.");
  AddDetail( "wunder",
	     "Die Hoehle erscheint Dir wie ein Wunder.");
  AddDetail( "mund",
	     "Dein Mund steht immer noch offen.");
  AddDetail( ({"funkeln", "glitzern"}),
	     "Das blaeuliche Licht laesst die Kristalle funkeln und "
	     "glitzern.");
  AddDetail( "augen",
	     "Deine Augen sind ein wenig geblendet durch das vielfach "
	     "reflektierte Licht.");
  AddDetail( ({"wand", "waende", "boden"}),
	     "Alles besteht hier aus Kristall, auch Waende und Boden.");
  AddDetail( ({"kristalle", "formen", "form"}),
	     "Die Kristalle haben die bizarrsten Formen und geben der Hoehle "
	     "eine wundervolle Schoenheit.");
  AddDetail( "decke",
	     "Du kannst die Decke kaum erkennen, so hoch oben ist sie. Das "
	     "einzige, was Du siehst, ist ein schwaches Glitzern.");
  AddDetail( ({"saeulen", "saeule"}),
	     "Drei riesige Saeulen ragen links und rechts bis zur Decke "
	     "hoch. Sie sind wunderschoen verziert und man kann auch "
	     "einige Zeichnungen und Symbole darauf sehen.");
  AddDetail( ({"zeichnungen", "symbole", "symbol"}),
	     "Sie scheinen die Geschichte des Silberlandes darzustellen, Du "
	     "kannst sie jedoch nicht genau deuten. Nur eine Zeichnung "
	     "scheint ein seltsames Ritual darzustellen...");
  AddDetail( "geschichte",
	     "Die ganze Geschichte des Silberlandes ist auf den Saeulen "
	     "eingemeisselt.");
  AddDetail( "silberland",
	     "Na ich hoffe ja doch, dass Du weisst, was das ist ;)");
  AddDetail( "zeichnung",
	     "Die Zeichnung stellt ein seltsames Ritual an einem Altar dar.");
  AddDetail( "ritual",
	     "Ein Zwerg steht mit erhobenen Haenden vor dem Altar und von "
	     "oben herab brennen sich schmale Lichtstrahlen in die "
	     "Oberflaeche des Altars.");
  AddDetail( ({"strahlen", "lichtstrahlen"}),
	     "Die Lichtstrahlen scheinen sich in die Oberflaeche des Altars "
	     "hineinzubrennen.");
  AddDetail( ({"flaeche", "oberflaeche"}),
	     "Du kannst leider nichts genaueres auf der Zeichnung erkennen.");
  AddDetail( "zwerg",
	     "Ein Zwerg steht vor dem Altar und streckt die Haende in "
	     "einer rituellen Zeremonie nach oben. Er scheint irgendetwas "
	     "zu beschwoeren.");
  AddDetail( "haende",
	     "Der Zwerg streckt die Haende nach oben.");
  AddDetail( "zeremonie",
	     "Du hast keine Ahnung, was sie zu bedeuten hat.");
  AddDetail( "ahnung", 
	     "Davon hast Du sowieso meistens keine.");
  AddDetail( ({"mitte", "raum"}),
	     "In der Mitte der Hoehle steht ein grosses Gebilde, vollkommen "
	     "aus dem Kristall herausgemeisselt.");
  AddDetail( "gebilde",
	     "Das Gebilde scheint ein Altar zu sein.");
  AddDetail( "altar",
	     "Der Altar in der Mitte des Raums ist vollkommen aus dem "
	     "Kristall herausgemeisselt. Er wurde direkt aus dem Boden "
	     "herausgehauen, da Du keine Unterbrechung zwischen Boden und "
	     "Altar feststellen kannst. Auf der oberen Platte des Altars "
	     "siehst Du eine lange, viereckige Erhebung.");
  AddDetail( "unterbrechung",
	     "Der Altar ist aus dem Kristall herausgemeisselt, denn es "
	     "gibt keine Unterbrechung zwischen Altar und Boden.");
  AddDetail( "mechanismus",
	     "Die Sockel scheinen zu einem Mechanismus zu gehoeren. "
	     "Man kann sie hineindruecken.");
  AddDetail( ({"gestalten", "gestalt", "kristallgestalt"}),
	     "Die Gestalten sind wahre Riesen. Sie sind etwa drei Meter "
	     "gross. Die eine haelt ein langes, funkelndes Schwert in den "
	     "Haenden, die andere hat einen stark gepanzerten Oberkoerper. "
	     "Sie sehen aus wie die geborenen Krieger. Du bist froh, dass "
	     "sie hier ganz still und fuer alle Ewigkeiten erstarrt "
	     "herumstehen, Du moechtest eigentlich keine naehere "
	     "Bekanntschaft mit ihnen machen.");
  AddDetail( ({"ewigkeiten", "ewigkeit"}),
	     "Die Gestalten scheinen fuer alle Ewigkeiten erstarrt zu sein.");
  AddDetail( "bekanntschaft",
	     "Es ist wohl besser, wenn diese beiden Gestalten zu Kristall "
	     "erstarrt bleiben.");
  AddDetail( ({"riesen", "riese"}),
	     "Die Gestalten sind gute drei Meter gross und ragen vor Dir "
	     "ewig zu Kristall erstarrt hoch.");
  AddDetail( "schwert",
	     "Das Schwert funkelt in den Haenden der Kristallgestalt. "
	     "Es ist wunderschoen und scheint sehr maechtig zu sein. "
	     "Dich juckt es bereits in den Fingern, aber das Schwert ist "
	     "leider fest mit den Haenden der Gestalt verbunden.");
  AddDetail( "finger",
	     "Es juckt Dich in Deinen Fingern, irgendwie an dieses "
	     "Schwert ranzukommen.");
  AddDetail( "krieger",
	     "Die Gestalten waren einstmals wohl grosse Krieger.");
  AddDetail( "haende",
	     "Das Schwert liegt in den Haenden der Gestalt.");
  AddDetail( ({"koerper", "oberkoerper"}),
	     "Der Oberkoerper der zweiten Gestalt ist stark gepanzert. "
	     "Gut, dass er hier erstarrt ist, er waere sonst wahrscheinlich "
	     "kaum zu besiegen.");
  AddDetail( ({"staub", "kristallstaub", "haufen", "haeufchen"}),
	     "Ein kleiner Haufen Kristallstaub liegt in einer Ecke. Er "
	     "funkelt und glitzert wunderschoen. Du kannst ja mal ein "
	     "bisschen was davon nehmen.");
  AddDetail( "ecke",
	     "In einer Ecke liegt ein ein Haeufchen Kristallstaub.");

  AddSpecialDetail( "sockel", "unt_sockel");
  AddSpecialDetail( ({"platte", "altarplatte"}), "unt_platte");
  AddSpecialDetail( "erhebung", "unt_erhebung");
  AddSpecialDetail( ({"zeichen", "schriftzeichen"}), "unt_zeichen");
  AddSpecialDetail( "kristallplatte", "unt_kristallplatte");
	     
  AddCmd( "nimm", "staub");
  AddCmd( ({"fuell", "fuelle"}), "einfuellen");
  AddCmd( ({"druecke", "drueck"}), "sockel");
  AddCmd( ({"lege", "leg"}), "mechanismus");

  AddSpecialExit( "westen", "westen");

  previous_object()->CustomizeObject();
}

int links=0, rechts=0, platte=1;
 
westen()
{
  return TP->move(TROPFST("khoehle14:"+getuid(TP)), M_GO, "nach Westen");
}

reset()
{
  ::reset();
  if (links || rechts)
    tell_room(this_object(),
        "Dir war es als haetten sich die Sockel bewegt. Seltsam...\n");
  if (!platte)
    tell_room(this_object(),
        "Wie aus dem Nichts erscheint eine Kristallplatte.\n");
  links=rechts=0;
  platte=1;
}

staub( str )
{
  notify_fail("Was willst Du nehmen?\n");
  if(str=="kristallstaub"||str=="staub")
    {
    write(BS("Du streckst Deine Hand nach dem Kristallstaub aus, er rieselt "
	     "jedoch einfach durch Deine Finger. Vielleicht solltest Du ihn "
	     "besser wo hineinfuellen?\n"));
    return 1;
    }
  else
    return 0;
}

einfuellen( str )
{
  object ob;
  string was, wohin;
  
  notify_fail("Was willst Du wo hineinfuellen?\n");
  if(!str)
    return 0;
  if(sscanf(str, "%s in %s", was, wohin)!=2)
    return 0;
  if(was!="staub" && was!="kristallstaub")
    {
    write(BS("Das kannst Du nirgends hineinfuellen.\n"));
    return 1;
    }
  if(!ob=present(wohin, TP))
    {
    write(BS("Sowas hast Du ja gar nicht!\n"));
    return 1;
    }
  if(member(ob->QueryProp(P_IDS), "beutel")==-1)
    {
    write(BS("Das ist wohl nicht das Richtige, um etwas Staub "
	     "hineinzufuellen... Versuchs doch lieber mit etwas anderem.\n"));
    return 1;
    }
  if(present("kristallstaub", ob))
    {
    write(BS("Du hast doch schon Kristallstaub in Deinem Beutel!\n"));
    return 1;
    }
  if(all_inventory(ob)!=({}))
    {
    write(BS("Nimm besser das Zeug aus dem Beutel, bevor Du da den Staub "
	     "hineinfuellst.\n"));
    return 1;
    }
	
  write(BS("Du fuellst etwas Kristallstaub in den Lederbeutel hinein.\n"));
  clone_object(OBJ("kstaub"))->move(ob, M_NOCHECK);
  
  return 1;
}

sockel( str )
{
  notify_fail("Was willst Du hineindruecken?\n");
  if(str=="sockel hinein" || str=="sockel")
    {
    write(BS("Du drueckst den Sockel in den Altar hinein, bis er "
	     "eben mit der Platte ist. Du hoerst ein kurzes Klicken, dann "
	     "schiebt sich der Sockel allerdings wieder in seine vorherige "
	     "Position. Es waere vielleicht besser, wenn Du etwas "
	     "darauflegen wuerdest...\n"));
    return 1;
    }
  else
    return 0;
}

mechanismus( str )
{
  string was, wohin;
  object ob, obj, test;
  notify_fail("Was willst Du wohin legen?\n");
  if(!str)
    return 0;
  if(sscanf(str, "%s auf %s", was, wohin)!=2)
    return 0;
  if(!ob=present(was, TP))
    {
    write("Sowas hast Du ja gar nicht!\n");
    return 1;
    }
  if(member(ob->QueryProp(P_IDS), "beutel")==-1)
    {
    write(BS("Du solltest vielleicht doch irgendetwas anderes benutzen...\n"));
    return 1;
    }
  if(wohin!="sockel"&&wohin!="sockel 1"&&wohin!="sockel 2"&&
     wohin!="linken sockel"&&wohin!="rechten sockel")
    {
    write("Da kannst Du nichts hinlegen.\n");
    return 1;
    }
  if(wohin=="sockel")
    {
    write("Welchen Sockel meinst Du denn?\n");
    return 1;
    }
  if(!obj=present("kristallstaub", ob))
    {
    write(BS("Du solltest den Beutel vielleicht vorher noch mit der RICHTIGEN "
	     "Sache fuellen...\n"));
    return 1;
    }
  /*  if((test=all_inventory(ob))!=({obj}))
    {
    write(BS("Vielleicht solltest Du keine Sachen im Beutel lassen, die Du "
	     "noch brauchst.\n"));
    return 1;
    }
    */
  if(wohin=="sockel 1"||wohin=="linken sockel")
    {
    write(BS("Du legst den Beutel mit dem Kristallstaub auf den linken "
	     "Sockel. Der Sockel bewegt sich nach unten und gibt ein lautes "
	     "*KLICK* von sich.\n"));
    filter_objects(deep_inventory(ob), "remove");
    ob->remove();
    links=1;
    if(rechts==1)
      call_out("platte", 3);
    return 1;
    }
  if(wohin=="sockel 2"||wohin=="rechten sockel")
    {
    write(BS("Du legst den Beutel mit dem Kristallstaub auf den rechten "
	     "Sockel. Der Sockel bewegt sich nach unten und gibt ein lautes "
    	     "*KLACK* von sich.\n"));
    filter_objects(deep_inventory(ob), "remove");
    ob->remove();
    rechts=1;
    if(links==1)
      call_out("platte", 3);
    return 1;
    }
}
  
platte()
{
  write(BS("Die Kristallplatte in der Mitte des Altars faengt ploetzlich "
	    "rot zu gluehen an. Ein greller, schmaler Lichtstrahl faehrt "
	    "von der Decke herab und brennt sich den Kanten der Platte "
	    "entlang in den Kristall. Der Lichtstrahl verschwindet "
	    "sogleich wieder hoch ueber Dir und alles ist so wie vorher. "
	    "Nur die Kristallplatte liegt jetzt lose auf dem Altar. Du "
	    "nimmst sie sogleich an Dich. Ploetzlich ueberkommt Dich ein "
	    "unheimliches Gefuehl. Links und rechts von Dir hoerst Du ein "
	    "sonderbares Knistern und Knacken. Was koennte das bloss "
	    "sein?\n"));
  platte=0;
  if(!present("kristallplatte", TP))
    if(present("\nhquest", TP))
      clone_object(OBJ("kplatte"))->move(TP, M_NOCHECK);
  call_out("npcs", 7);
}

npcs()
{
  object ob1, ob2;
  write(BS("Da! Einer der Kristallriesen hat gerade eine Hand bewegt! "
           "Und ploetzlich gibt es ein lautes Krachen als die beiden "
           "Kristallwaechter wieder zum Leben erwachen und auf Dich "
           "hereinstuerzen...\n"));
  if(!ob1=present("Kwaechter1", environment(TP)))
    {

    (ob1=(clone_object(NPC("kwaechter1"))))->move(TO, M_GO);
    ob1->Kill(TP);
    }
  else
    ob1->Kill(TP);

  if(!ob2=present("Kwaechter2", environment(TP)))
    {
    (ob2=(clone_object(NPC("kwaechter2"))))->move(TO, M_GO);
    ob2->Kill(TP);
    }
  else
    ob2->Kill(TP);   
}
  
string unt_sockel()
{
  if(rechts==1&&links==1)
    return BS("Auf den beiden Sockel liegen zwei Lederbeutel und durch das "
	      "Gewicht werden die Sockel in die Altarplatte gedrueckt.\n");
  if(rechts==1||links==1)
    return BS("Auf einem der Sockel liegt ein Lederbeutel und dadurch ist "
	      "der Sockel auch in die Altarplatte hineingedrueckt.\n");
  else
    return BS("Die Sockel scheinen beweglich zu sein. Wie es scheint, "
	      "gehoeren sie zu irgendeinem Mechanismus.\n");
} 

string unt_platte()
{
  if(platte==1)
    return BS("Auf der oberen Platte des Altars ist eine grosse, viereckige "
	      "Erhebung.\n");
  else
    return BS("Die Altarplatte ist spiegelglatt.\n");
}

string unt_erhebung()
{
  if(platte==1)
    return BS("Die Erhebung ist etwa zwei Zentimeter hoch und 30 "
	      "Zentimeter lang und breit. Es scheinen Schriftzeichen darauf "
	      "eingraviert zu sein. Links und rechts von der Erhebung siehst "
	      "Du zwei kleine Sockel.");
  else 
    return 0;
}

string unt_zeichen()
{
  if(platte==1)
    return BS("Du kannst sie nicht genau erkennen. Der dicke Kristall "
	      "der Altarplatte laesst sie vor Deinen Augen verschwimmen. "
	      "Du muesstest die Kristallplatte, auf der sie eingraviert "
	      "sind, irgendwie vom Altar herunterbekommen.");
  else
    return 0;
}

string unt_kristallplatte()
{
  if(platte==1)
    return BS("Sie ist fest mit dem Altar verschmolzen.");
  else 
    return 0;
}
