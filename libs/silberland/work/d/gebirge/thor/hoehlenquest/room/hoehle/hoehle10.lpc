// Thor@SilberLand
// Eine verschollene Hoehle - hoehle10.c
// 1997-04-21

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle scheint hier endgueltig zu Ende zu sein. Vor Dir ist eine "
    "zerklueftete Wand, hinter Dir fuehrt der Weg wieder Richtung "
    "Nordwesten zurueck. Ganz versteckt kannst Du jedoch in der "
    "unregelmaessigen Wand einen schmalen Spalt erkennen. Der Fels hier ist "
    "noch ein bisschen dunkler als zuvor, Du wunderst Dich ueber die "
    "sonderbare Farbe des Gesteins.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"hoehle", "ende"}),
             "Die Hoehle scheint nun hier wirklich zu Ende zu sein. Nur in "
             "der Felswand vor Dir ist ein schmaler Spalt zu erkennen.");
  AddDetail( ({"wand", "felswand"}),
             "Die Wand vor Dir ist aeusserts zerklueftet und hat viele Zacken "
             "und Spalten.");
  AddDetail( "zacken",
             "Einige scharfe Zacken sind an der Wand. Das Gestein hier "
             "scheint aeusserst hart zu sein.");
  AddDetail( "spalten",
             "Die Wand ist durch einige Spalten sehr zerklueftet. Ein Spalt "
             "scheint etwas groesser zu sein.");
  AddDetail( "weg",
             "Hinter Dir fuehrt der Weg Richtung Nordwesten wieder zurueck.");
  AddDetail( "spalt",
             "Versteckt in der hintersten Ecke siehst Du einen etwas "
             "groesseren Spalt in der Wand. Er ist gross genug, dass Du Dich "
             "vielleicht hindurchzwaengen koenntest.");
  AddDetail( "ecke",
             "In der hintersten Ecke kannst Du einen Spalt erkennen.");
  AddDetail( "fels",
             "Der Fels hat hier eine aeussert dunkle Faerbung, beinahe schon "
             "schwarz.");
  AddDetail( ({"farbe", "faerbung"}),
             "Das Gestein scheint hier irgendeine besondere Zusammensetzung "
             "zu haben, die dem Gestein eine so dunkle Farbe gibt.");
  AddDetail( "gestein",
             "Das Gestein ist sehr dunkel und scheint aeusserst hart zu sein. "
             "Das liegt wahrscheinlich an einer besonderen Zusammensetzung.");
  AddDetail( "zusammensetzung",
             "So geologisch bewandert bist Du leider nicht, um erkennen zu "
             "koennen, woraus das Gestein hier zusammengesetzt ist.");
  AddDetail( "boden",
             "Der Boden besteht aus dunklem Fels.");
  AddDetail( "waende",
             "Die Waende sind aeusserst zerklueftet und von Spalten "
             "durchzogen.");
  AddDetail( "decke",
             "Die Decke ist aeusserst grob aus dem Fels herausgehauen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Die Hoehlenluft ist angenehm erfrischend.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Du atmest tief die kuehle Hoehlenluft ein und fuehlst Dich sogleich "
    "etwas frischer.");

  AddCmd( ({ "zwaeng", "zwaenge" }), "spalt" );

  AddExit( "nordwesten", HOEHLE("hoehle9.lpc"));
}

spalt( str )
{
  notify_fail( "Wo willst Du Dich durchzwaengen?\n" );
  if( str == "durch spalt" || str == "durch spalt hindurch" ||
      str == "durch spalte"|| str == "durch spalte hindurch" ||
      str == "spalt" || str == "spalte")
  {
    write(BS("Du machst Dich so duenn Du kannst und zwaengst Dich muehsam "
          "durch den schmalen Spalt in der Wand hindurch.\n"));
    TP->move(HOEHLE("loch1"), M_GO, "", "zwaengt sich durch einen schmalen "
	     "Spalt in der Wand hindurch und ist verschwunden", 
	     "kommt durch einen Spalt herein");
    return 1;
  }
  return 0;
}


