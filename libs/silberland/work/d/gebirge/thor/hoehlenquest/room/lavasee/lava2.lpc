#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem der grossen Lavabloecke, die in der ganzen Hoehle "
   +"verstreut sind. Du stehst hier am Ostrand des Lavabrockens und kannst "
   +"weiter nach Westen gehen. Das Gestein, auf dem Du stehst, ist sehr "
   +"heiss, aber nicht ganz so heiss wie der Boden der Bruecke. Deine "
   +"brennenden Fussohlen beginnen sich wieder zu beruhigen. Etwas weiter "
   +"neben Dir siehst Du eine rot gluehende Einsenkung mitten im "
   +"Lavabrocken.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"brocken", "lavabrocken", "lavabloecke", "bloecke", "block", "lavablock"}),
	     "Du stehst auf einem der grossen Lavabloecke im Lavasee.");
  AddDetail( ({"see", "lavasee"}),
             "Der Lavasee breitet sich rund um Dich aus und erfuellt die "
            +"Hoehle mit einer enormen Hitze.");
  AddDetail( "hitze",
             "Die Hitze ist beinahe unertraeglich.");
  AddDetail( "hoehle",
             "In der Hoehle herrscht eine fuerchterliche Hitze.");
  AddDetail( ({"rand", "ostrand"}),
             "Du bist am Ostrand des Lavabrockens und kannst nach Westen "
            +"weitergehen.");
  AddDetail( ({"gestein", "lavagestein"}),
             "Die Lavabloecke bestehen aus dunkelfaerbigem, erstarrten "
            +"Lavagestein.");
  AddDetail( "bruecke",
             "Der Boden hier ist nicht ganz so heiss wie er es auf der "
            +"Bruecke gewesen ist.");
  AddDetail( ({"sohlen", "fussohlen"}),
             "Deine Fussohlen schmerzen nicht mehr ganz so schlimm.");
  AddDetail( ({"senke", "senkung", "einsenkung"}),
	     "Geh doch mal naeher ran.");
  AddDetail( "boden",
             "Er ist hier etwas kuehler, aber Du spuerst die Hitze immer noch "
            +"auf Deinen Fussohlen.");
  AddDetail( "decke",
             "Die Decke ueber Dir besteht aus dunklem Lavagestein.");
  AddDetail( ({"waende", "wand", "hoehlenwaende", "hoehlenwand"}),
             "Du kannst an den Hoehlenwaenden gelegentlich Spuren eines "
            +"Dir unbekannten Metalls erkennen.");
  AddDetail( ({"spuren", "metallspuren"}),
             "Nur ein leichtes Glaenzen hier und da, das ist alles.");
  AddDetail( "glaenzen",
             "Die Metallspuren an den Waenden verleihen diesen ein leichtes "
            +"Glaenzen.");
  AddDetail( "metall",
             "Das selbe Metall, aus dem die Bruecken bestehen. Du kannst Dich "
            +"nicht erinnern, es jemals zuvor gesehen zu haben.");
  AddDetail( ({"lava", "magma"}),
             "Tief unter Dir schlaegt die Lava blubbernd grosse Blasen.");
  AddDetail( ({"blasen", "lavablasen"}),
             "Mit einem lauten \"BLUBB!\" zerplatzen sie.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddExit( "suedosten", LAVA("bruecke2"));
  AddExit( "westen", LAVA("lava3"));
  AddExit( "suedwesten", LAVA("lava5"));
}

