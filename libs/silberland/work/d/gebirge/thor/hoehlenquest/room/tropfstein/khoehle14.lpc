#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Hier scheint der schmale Gang zu Ende zu sein. Er hat sich hier zum "
   +"Schluss noch mal ausgeweitet, jetzt stehst Du jedoch vor einer "
   +"grossen, massiven Kristallwand. Im Glitzern und Leuchten dieser "
   +"glasklaren und doch fuer Blicke undurchdringbare Wand faellt Dir jedoch "
   +"etwas merkwuerdiges auf. In den vier Ecken der Wand sind vier runde "
   +"Vertiefungen. Du stehst stutzig vor der Wand und gruebelst, was diese "
   +"Vertiefungen wohl zu bedeuten haben...");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gang", "hoehlengang"}),
	     "Tja, hier scheint der Hoehlengang wohl ein Ende zu haben.");
  AddDetail( "ende",
	     "Nein, eindeutig... hier gibt es kein Weiterkommen mehr.");
  AddDetail( "weiterkommen",
	     "Glaubst Du es immer noch nicht? Hier ist es AUS!");
  AddDetail( "schluss",
	     "Der Gang ist hier nochmal etwas weiter geworden, und Du stehst "
	    +"jetzt vor einer ziemlich grossen, massiven Wand aus Kristall.");
  AddDetail( "kristall",
	     "Alles besteht hier gaenzlich aus Kristall. Nicht mal mehr am "
	    +"Boden sind einige kleinere Felsflecken zu entdecken.");
  AddDetail( ({"flecken", "felsflecken", "felsfleck", "fleck", "gestein", "fels", "felsgestein"}),
	     "Nicht mal das kleinste Anzeichen von irgendeinem Felsgestein "
	    +"ist hier mehr zu erkennen.");
  AddDetail( ({"anzeichen", "zeichen"}),
	     "Nirgends ist mehr ein Anzeichen von Fels zu sehen. Alles "
	    +"besteht nur aus funkelndem Kristall.");
  AddDetail( ({"wand", "kristallwand"}),
	     "Vor Dir ragt eine riesige, massive Kristallwand bis zur Decke "
	    +"hoch. Du bist zwar ueberwaeltigt von der schieren Schoenheit "
	    +"der Wand, wie sie das Licht bricht und reflektiert und so die "
	    +"Luft in Bewegung zu versetzten scheint, allerdings weisst Du "
	    +"noch nicht so recht, wie Du hier weiterkommen sollst...");
  AddDetail( "schoenheit",
	     "Die Kristallwand scheint durch das viele Funkeln und Glitzern "
	    +"schon fast in Bewegung versetzt zu sein, und verleiht ihr so "
	    +"eine beinahe ueberirdische Schoenheit.");
  AddDetail( ({"licht", "lichtquelle"}),
	     "Das Licht Deiner Lichtquelle wird von der Kristallwand "
	    +"tausendfach gebrochen.");
  AddDetail( ({"luft", "bewegung"}),
	     "Durch das dauernde Funkeln und Glitzern scheint es fast so, "
	    +"als wuerde die Luft in Bewegung versetzt.");
  AddDetail( ({"funkeln", "glitzern", "leuchten"}),
	     "Das gebrochene und reflektierte Licht laesst die ganze Hoehle "
	    +"in unendlicher Schoenheit funkeln.");
  AddDetail( "hoehle",
	     "Alles in der Hoehle besteht aus Kristall und funkelt und "
	    +"glitzert in strahlendem Licht.");
  AddDetail( ({"blick", "blicke"}),
	     "Obwohl der Kristall der Wand glasklar ist, ist es Dir "
	    +"unmoeglich, durch sie durchzublicken. Das kommt daher, weil "
	    +"sie das Licht in allen nur erdenklichen Varianten bricht und "
	    +"umlenkt.");
  AddDetail( ({"ecken", "ecke"}),
	     "In den Ecken der Wand siehst Du vier kreisrunde Vertiefungen "
	    +"eingepraegt.");
  AddDetail( "vertiefungen",
	     "Die Vertiefungen sind kreisrund, haben einen Durchmesser "
	    +"von etwa 10 cm und sind etwa 1 cm tief. In ihnen siehst Du "
	    +"verschiedene Zeichen eingepraegt.");
  AddDetail( "durchmesser",
	     "Ich sagte doch, etwa 10 cm.");
  AddDetail( "zeichen",
	     "Du kannst sie nicht sofort erkennen, denn das Licht laesst "
	    +"hier alles ein wenig anders aussehen, aber nach laengerer "
	    +"Betrachtung stellst Du fest, dass es sich bei den Zeichen wohl "
	    +"um einen Amboss, einen Hammer und um einen Pickel handeln muss. "
	    +"In der vierten Vertiefung ist eine Flamme eingepraegt.");
  AddDetail( "waende",
	     "Die Waende bestehen vollkommen aus Kristall.");
  AddDetail( "decke",
	     "Von der Decke ragen spitze Kristallzacken heruntern.");
  AddDetail( ({"zacken", "kristallzacken"}),
	     "Die haengen von der Decke herunter. Hoffentlich faellt keiner "
	    +"herunter und spiesst Dich auf.");
  AddDetail( "boden",
	     "Der Boden besteht aus glattem Kristall, es ist kein "
	    +"Felsfleck mehr darauf zu erkennen.");
  AddDetail( "vertiefung",
	     "Welche Vertiefung moechtest Du denn untersuchen? Die linke "
	    +"obere, die rechte obere, die linke untere oder die rechte "
	    +"untere?");
  AddDetail( ({"platte", "metallplatte"}),
	     "Du siehst die Metallplatte, die Du bereits in die Vertiefung "
            +"gelegt hast.");
  AddSpecialDetail( "amboss", "unt_amboss");
  AddSpecialDetail( "hammer", "unt_hammer");
  AddSpecialDetail( "pickel", "unt_pickel");
  AddSpecialDetail( "flamme", "unt_flamme");
  AddSpecialDetail( "linke obere vertiefung", "lo");
  AddSpecialDetail( "rechte obere vertiefung", "ro");
  AddSpecialDetail( "linke untere vertiefung", "lu");
  AddSpecialDetail( "rechte untere vertiefung", "ru");
  
  AddSound( DEFAULT_SOUND,
     "Es herrscht eine unheimliche Totenstille.");
  AddSound( ({"stille", "totenstille"}),
     "Die Stille hier drinnen ist irgendwie unheimlich. Dieser Raum "
    +"scheint irgendein Geheimnis zu verbergen...");
  AddSmell( DEFAULT_SMELL,
     "Die Luft ist erstaunlicherweise frisch und kuehl.");
  AddSmell( "luft",
     "Du atmest tief durch.");

  AddCmd( ({"lege", "leg"}), "mauer");
  AddCmd( "deleteme", "loeschen"); 
  AddExit( "norden", TROPFST("khoehle13"));
  AddSpecialExit( "osten", "osten");

  previous_object()->CustomizeObject();
}

init()
{
  ::init();
 
  if((call_other(SYMBOLMASTER, "CheckCorner", TP, 0)!=1)&& interactive(TP))
    SetProp(P_HIDE_EXITS, ({"osten"}));
}


int osten(string dir)
{ 
  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 0)==1)
    {
    write(BS("Die Wand oeffnet sich direkt vor Dir und Du kannst nach "
	    +"Osten passieren.\n"));
  if(!interactive(TP)) return 0;
  tell_object(TP,BS(
    "Du gehst nach Osten."));
  tell_room(TO,BS(
    TP->Name()+" geht nach Osten."),({TP}));
  TP->move(TROPFST("khoehle15:"+getuid(TP)),M_SILENT|M_NOCHECK);
  tell_room(ENV(TP),BS(
    TP->Name()+" kommt herein."),({TP}));
  return 1;

    }
  else
    return 0;
}

string lo()
{
  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 1)==1)
    {
    return BS("In der linken, oberen Vertiefung siehst Du eine "
	     +"Metallplatte eingebettet.\n");
    }
  else
    {
    return BS("In der linken, oberen Vertiefung erkennst Du das Zeichen "
	     +"eines Amboss eingepraegt.");
    }
}

string ro()
{
  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 2)==1)
    {
    return BS("In der rechten, oberen Vertiefung siehst Du eine "
	     +"Metallplatte eingebettet.\n");
    }
  else
    {
    return BS("In der rechten, oberen Vertiefung erkennst Du das Zeichen "
	     +"eines Hammers eingepraegt.");
    }
}

string lu()
{
  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 3)==1)
    {
    return BS("In der linken, unteren Vertiefung siehst Du eine "
	     +"Metallplatte eingebettet.\n");
    }
  else
    {
    return BS("In der linken, unteren Vertiefung erkennst Du das Zeichen "
	     +"einer Flamme eingepraegt.");
    }
}

string ru()
{
  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 4)==1)
    {
    return BS("In der rechten, unteren Vertiefung siehst Du eine "
	     +"Metallplatte eingebettet.\n");
    }
  else
    {
    return BS("In der rechten, unteren Vertiefung erkennst Du das Zeichen "
	     +"eines Pickels eingepraegt.");
    }
}

string unt_amboss()
{
  if(present("amboss-symbol", TP))
    return "Von irgendwoher kommt Dir dieses Zeichen bekannt vor...\n";
  else
    return "Du weisst nicht recht, was Du mit diesem Zeichen anfangen sollst.\n";
}

string unt_hammer()
{
  if(present("hammer-symbol", TP))
    return "Von irgendwoher kommt Dir dieses Zeichen bekannt vor...\n";
  else
    return "Du weisst nicht recht, was Du mit diesem Zeichen anfangen sollst.\n";
}

string unt_pickel()
{
  if(present("pickel-symbol", TP))
    return "Von irgendwoher kommt Dir dieses Zeichen bekannt vor...\n";
  else
    return "Du weisst nicht recht, was Du mit diesem Zeichen anfangen sollst.\n";
}

string unt_flamme()
{
  if(present("feuer-symbol", TP))
    return "Von irgendwoher kommt Dir dieses Zeichen bekannt vor...\n";
  else
    return "Du weisst nicht recht, was Du mit diesem Zeichen anfangen sollst.\n";
}

mauer( str )
{
  object ob;
  string was, wohin;
  string lo, ro, lu, ru;
  string *platteID, *ecke;

  platteID=({"amboss", "hammer", "feuer", "ambosssymbol", "hammersymbol", "pickelsymbol", "feuersymbol", "amboss-symbol", "hammer-symbol", "pickel-symbol", "feuer-symbol"});
  ecke=({"linke obere vertiefung", "rechte obere vertiefung", "linke untere vertiefung", "rechte untere vertiefung"});
  notify_fail("Was willst Du wohin legen?\n");
  if(!str)
    return 0;
  if(sscanf(str, "%s in %s", was, wohin)!=2)
    return 0;

  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 0)==1)
    {
    write(BS("Deine Aufgabe ist hier schon erledigt, Du kannst ungehindert "
	    +"passieren.\n"));
    return 1;
    }
  if(was=="pickel") was="pickel-symbol";
  if(!(ob=present(was, TP)))
     {
     write("Sowas hast Du ja gar nicht!\n");
     return 1;
     }
  if(was=="symbol")
    {
    write("Welches meinst Du denn?\n");
    return 1;
    }
  if(was=="platte"||was=="metallplatte")
    {
    write("Welche meinst Du denn?\n");
    return 1;
    }
  if(member_array(was, platteID)==-1)
    {
    write("Das kannst Du da nicht hineinlegen!\n");
    return 1;
    }

  if(member_array(wohin, ecke)==-1)
    {
    write("Da kannst Du nichts hineinlegen!\n");
    return 1;
    }
  if(wohin=="vertiefung")
    {
    write(BS("Welche Vertiefung meinst Du denn? Die linke obere, die "
	    +"rechte obere, die linke untere oder die rechte untere?\n"));
    return 1;
    }
  if(member(call_other(SYMBOLMASTER, "CheckPlayers"), getuid(TP))==-1)
    call_other(SYMBOLMASTER, "AddPlayer", TP);

  switch(wohin)
    {
    case "linke obere vertiefung":   if(call_other(SYMBOLMASTER, "CheckCorner", TP, 1)==1)
                                       {
                                       write(BS("Hier hast Du schon ein Symbol "
					       +"hineingelegt!\n"));
				       break;
				       }
                                     if(member_array("amboss", ob->QueryProp(P_IDS))==-1)
                                       call_other(SYMBOLMASTER, "InsertaSymbol", TP, 1);
                                     else
				       call_other(SYMBOLMASTER, "InserttrueSymbol", TP, 1);
                                     write(BS("Du legst das "+CAP((ob->QueryProp(P_IDS))[1])
					     +"-Symbol in "
					     +"die linke, obere Vertiefung.\n"));
				     ob->remove();
                                     break;
    case "rechte obere vertiefung":  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 2)==1)
                                       {
                                       write(BS("Hier hast Du schon ein Symbol "
					       +"hineingelegt!\n"));
				       break;
				       }
                                     if(member_array("hammer", ob->QueryProp(P_IDS))==-1)
                                       call_other(SYMBOLMASTER, "InsertaSymbol", TP, 2);
                                     else
				       call_other(SYMBOLMASTER, "InserttrueSymbol", TP, 2);
                                     write(BS("Du legst das "+CAP((ob->QueryProp(P_IDS))[1])
					     +"-Symbol in "
					     +"die rechte, obere Vertiefung.\n"));
				     ob->remove();
                                     break;
    case "linke untere vertiefung":  if(call_other(SYMBOLMASTER, "CheckCorner", TP, 3)==1)
                                       {
                                       write(BS("Hier hast Du schon ein Symbol "
					       +"hineingelegt!\n"));
				       break;
				       }
                                     if(member_array("feuer", ob->QueryProp(P_IDS))==-1)
                                       call_other(SYMBOLMASTER, "InsertaSymbol", TP, 3);
                                     else
				       call_other(SYMBOLMASTER, "InserttrueSymbol", TP, 3);
                                     write(BS("Du legst das "+CAP((ob->QueryProp(P_IDS))[1])
					     +"-Symbol in "
					     +"die linke, untere Vertiefung.\n"));
				     ob->remove();
                                     break;
    case "rechte untere vertiefung": if(call_other(SYMBOLMASTER, "CheckCorner", TP, 4)==1)
                                       {
                                       write(BS("Hier hast Du schon ein Symbol "
					       +"hineingelegt!\n"));
				       break;
				       }
                                     if(member_array("pickel", ob->QueryProp(P_IDS))==-1)
                                       call_other(SYMBOLMASTER, "InsertaSymbol", TP, 4);
                                     else
				       call_other(SYMBOLMASTER, "InserttrueSymbol", TP, 4);
                                     write(BS("Du legst das "+CAP((ob->QueryProp(P_IDS))[1])
					     +"-Symbol in "
					     +"die rechte, untere Vertiefung.\n"));
				     ob->remove();
                                     break;
    }
  if(call_other(SYMBOLMASTER, "CheckSymbols", TP)==1)
    {
    write(BS("Die Symbole leuchten im Kristall kurz auf, zerfallen jedoch dann "
	    +"sogleich zu Staub. Irgendwas scheinst Du wohl falsch gemacht zu "
	    +"haben...\n"));
    call_other(SYMBOLMASTER, "DeleteSymbols", TP);
    }
  if(call_other(SYMBOLMASTER, "CheckSymbols", TP)==2)
    {
    write(BS("Die vier Symbole leuchten gluehend rot in der Kristallwand "
	    +"auf und ploetzlich oeffnet sich ein breiter Durchgang nach "
            +"Osten hin.\n")); 
    call_other(SYMBOLMASTER, "InsertaSymbol", TP, 0);
    SetProp(P_HIDE_EXITS, 0);
    }
  return 1;
}

loeschen()
{
  if(!IS_LEARNER(TP))
    {
    write(BS("Is leider nur fuer Magier!\n"));
    return 1;
    }
  else
    {
    call_other(SYMBOLMASTER, "DeletePlayer", TP);
    write(BS("Du bist im Mapping geloescht.\n"));
    return 1;
    }
}






