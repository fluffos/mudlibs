// Thor@SilberLand
// Ein unterirdischer See - wasser1.c
// 1997-05-29

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>
#include "/sys/thing/material.h"


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein unterirdischer See" );
  SetProp( P_INT_LONG, "");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_UNDERWATER, ENV_TEMPERATURE: 30]) );

  AddDetail( "wasser",
             "Es ist ueberall um Dich herum. Man koennte auch sagen, Du "
            +"schwimmst mitten drin.");
  AddDetail( "decke",
             "Ueber Dir ist die Decke voll mit Tropfsteinen.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Sie haengen von der Decke.");
  AddDetail( "leuchten",
             "Ein sonderbares, rotes Leuchten erkennst Du tief unter Dir "
            +"im Wasser.");
  AddDetail( "see",
             "Darin befindest Du Dich gerade.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Tropfen des Wasser.");
  AddSound( ({"tropfen", "wasser"}),
    "Es hoert sich angenehm an...");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist feucht und kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({"tauche", "tauch"}), "tiefe" );

  AddSpecialExit( "raus", "hoehle");
}

object dive;

init()
{
  ::init();

  if(T_LOAD > MAX_T_LOAD)
    {
    call_out("tot", 2);
    call_out("raum", 2);
    }

}

raum()
{
  say(BS(CAP_TPN+" wird von "+((TP->QueryProp(P_GENDER)==FEMALE) ? "ihrer" : "seiner")+" schweren Ausruestung unter Wasser gezogen und beginnt, voller Panik "
     +"zu strampeln.\n"));
}
string int_long(mixed x, mixed y, int z)

{
  if(T_LOAD < MAX_T_LOAD)
    {
    return BS("Du schwimmst im Wasser des kleinen Sees herum. Das merkwuerdige "
        +"rote Schimmern tief unten wirkt eine magische Anziehungskraft "
        +"auf Dich aus. Du wuerdest gerne mal ein Stueckchen "
        +"hinuntertauchen, vielleicht kannst Du ja dann mehr erkennen, was "
        +"es mit diesem Leuchten auf sich hat.")+::int_long(x,y,z);
    }
  else
    {
    return BS("Es war vielleicht doch keine so gute Idee, mit soviel Ausruestung "
        +"in den See hineinzuspringen. Das Gewicht derselbigen zerrt Dich "
        +"naemlich bereits nach unten, tiefer in das Wasser hinein.")
        +::int_long(x,y,z);
    }
}

varargs int PreventInsert(object ob)
{
  if(ob->QueryMaterialGroup(MATGROUP_SWIMABLE) && !living(ob) && 
      !query_once_interactive(ob) )
    call_out("weg", 1, ob);
  return ::PreventInsert(ob);
}

weg(object ob)
{
  if(ob && environment(ob)==this_object())
    {
    write(BS("Langsam versinkt "+((ob->QueryProp(P_GENDER)==FEMALE) ? "Deine" : "Dein")
            +" "+(ob->QueryProp(P_NAME))+" in der Tiefe.\n"));
    say(BS(CAP(this_player()->name(WESSEN, 1))+" "+(ob->QueryProp(P_NAME))+" sinkt "
            +"langsam in die Tiefe.\n"));
    ob->move(TROPFST("zeugs"), M_NOCHECK);
  }
}


hoehle()
{

  int hinaus;
  int frei;

  if(dive=present("tauchen",TP))
    {
    write(BS("Das magische Leuchten unter Dir hat Dich gefesselt... Du bist "
            +"nicht faehig, umzudrehen und wieder aufzutauchen, irgendetwas "
            +"zwingt Dich, weiterzutauchen.\n")+"\n");
    return 1;
    }

  hinaus=(T_LOAD/(10*((int)(TP->QueryAttribute(A_STR))+((int)TP->QueryAttribute(A_DEX)))));
  
  if(T_LOAD < MAX_T_LOAD)
    {
    TP->move(TROPFST("thoehle17"), M_GO, "", "sucht sich wieder festen Boden "
                                  +"unter den Fuessen", "kommt aus dem See "
                                  +"heraus");
    return 1;
    }
  else
    {
    frei=hinaus+random(hinaus);

    if(frei<(hinaus+15))
      {
      write(BS("Du kannst Dich gerade noch aus dem Wasser herausstrampeln.\n"));
      TP->move(TROPFST("thoehle17"), M_GO, "", "strampelt sich mit groesster "
              +"Muehe aus wieder aus dem Wasser heraus", "kommt erschoepft "
              +"aus dem See heraus");
      return 1;
      }
    else
      {
      write(BS("Voller Panik strampelst Du wild im Wasser herum, kommst "
          +"allerdings nicht hoch... Deine Ausruestung ist einfach zu "
          +"schwer.\n"));
      return 1;
      }  
    }
}

tot()
{ 
  object ob;

  TP->do_damage(2);
  if (environment(TP)==TO && T_LOAD > MAX_T_LOAD &&
      ob=!present("kajuboknospe", TP))
    {
    write("Blubb...\n");
    call_out("tot", 2);
    }
  if(ob=present("kajuboknospe", TP))
    {
    write(BS("Du isst schnell Deine Kajuboknospe und hast Dich somit von "
            +"Deiner Atemnot befreit. Deine schwere Ausruestung zieht Dich "
            +"jedoch weiterhin tiefer nach unten in den Schlund.\n"));
    ob->remove();
    }
}


tiefe( str )
{
  notify_fail("Wohin willst Du tauchen?\n");
  if(str=="hinunter"||str=="in tiefe"||str=="in die tiefe"||str=="runter")
    {
    if(T_LOAD > MAX_T_LOAD)
      {
      write(BS("Du ersaeufst doch sowieso gerade!\n"));
      return 1;
      }
    else if(dive=present("tauchen", TP))
      {
      write(BS("Du tauchst ja bereits.\n"));
      return 1;
      }
    else
      {
      write(BS("Du holst einmal tief Luft und beginnst, in die scheinbar "
            +"unendliche Tiefe des kleinen Sees hinunterzutauchen, dem "
            +"unheimlichen Leuchten entgegen.\n")+"\n");
      say(BS(CAP_TPN+" holt tief Luft und taucht nach unten.\n"));
      TP->SetProp(P_PARALYZED, ([
            PARALYZE_TIME: 16,
            PARALYZE_MSG: "Du bist gerade mit Tauchen beschaeftigt!\n",
            PARALYZE_MSG_OTHER: "",
            PARALYZE_END: "",
            PARALYZE_END_OTHER: ""]));
      call_out("runter1", 3);
      dive=clone_object(OBJ("tauchen"));
      dive->move(TP, M_NOCHECK);
      return 1;
      }
    }
  else
    return 0;
}

runter1()
{
  if(environment(TP)==TO) 
    {  
    write(BS("Du strampelst kraeftig mit den Fuessen und bist nun schon etwa "
          +"fuenf Meter unter der Wasseroberflaeche. Noch kannst Du keine "
          +"Veraenderung an dem Leuchten erkennen, und Du hast auch noch "
          +"reichlich Luft, daher tauchst Du weiter.\n")+"\n");
    call_out("runter2", 6);
    }
}

runter2()
{
  if(environment(TP)==TO) 
    { 
    write(BS("Obwohl Du nun bereits ein klein wenig Atemnot hast, tauchst Du "
          +"weiter... Das Leuchten uebt eine magische Anziehungskraft auf "
          +"Dich aus.\n")+"\n");
    TP->do_damage(2);
    call_out("runter3", 6);
    }
}

runter3()
{
  if(environment(TP)==TO)
    {
    write(BS("Du bist wie gefesselt von dem dumpfen, roten Leuchten in der Tiefe. "
          +"In Deinen Lungen ist kaum noch Luft und Du wuerdest jetzt alles "
          +"fuer einen tiefen Atemzug geben, aber die magische Anziehungskraft "
          +"des Lichtes zwingt Dich dazu, weiterzutauchen.\n")+"\n");
    TP->do_damage(5);
    call_out("runter4", 8);
    }
}

runter4()
{   
  if(environment(TP)==TO)
    {  
    write(BS("Deine Lungen scheinen schon beinahe zu bersten. Dir wird schon "
          +"schwarz vor Augen, doch da! Du erblickst im letzten Moment ein "
          +"grosses Loch in der Wand. Du tauchst durch einen schmalen Gang "
          +"und ploetzlich oeffnet sich unter Wasser eine kleine Hoehle. "
          +"Als Du nach oben blickst, erkennst Du ein silbriges Schimmern.\n")+"\n");
    TP->do_damage(10);
    call_out("runter5", 6);
    }
}
  
runter5()
{  
  if(environment(TP)==TO)
    {
    write(BS("Du tauchst nach oben und ploetzlich durchstoesst Dein Kopf die "
          +"Wasseroberflaeche und Du atmest koestlichen Sauerstoff ein. "
          +"Beinahe hast Du schon geglaubt, dieses Wasserloch waere Dein Tod.\n")
          +"\n");
    call_out("bewegen", 3);
    }
}

bewegen()
{
  if(objectp(dive))
    dive->remove();
  if(TP && environment(TP)==TO)
    {
    TP->move(TROPFST("wasser2"), M_GO, "", "ist verschwunden", 
	     "taucht ploetzlich neben Dir auf");
    }
}










