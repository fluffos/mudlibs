// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle8.c
// 1997-05-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Hier scheint eine Sackgasse zu sein. Vor Dir breitet sich ein kleiner, "
    "runder Raum aus. An den Waenden sind dicke Wuelste von Tropfsteinen "
    "heruntergewachsen, die nun aussehen, wie Saeulen aus Kalk. Das Wasser "
    "verleiht ihnen ein schimmerndes Glaenzen. An der Nordwand des Raumes "
    "kannst Du eine Hervorwoelbung im Fels erkennen. Darin scheint etwas "
    "Wasser zu sein.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gasse", "sackgasse"}),
             "Du bist gerade in einer solchen.");
  AddDetail( "raum",
             "Du stehst in einem runden Raum, wo ueberall das Wasser von den "
             "Felswaenden und der Decke tropft.");
  AddDetail( ({"waende", "felswaende"}),
             "An den Felswaenden sind Saeulen von Tropfsteinen, die im "
             "schimmernden Licht Deiner Fackel wirklich beeindruckend "
             "aussehen.");
  AddDetail( ({"licht", "fackel"}),
             "Das Licht Deiner Fackel laesst die feuchte Hoehle glaenzend "
             "schimmern.");
  AddDetail( "hoehle",
             "Du stehst mitten in einer kleinen Hoehle.");
  AddDetail( "wuelste",
             "Die Tropfsteine, die bereits von der Decke zum Boden "
             "gewachsen sind, sehen aus wie maechtige Saeulen.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Manche Tropfsteine sind schon so gross, dass sie von der Decke "
             "bis zum Boden reichen.");
  AddDetail( ({"saeulen", "steinsaeulen"}),
             "Die Steinsaeulen wirken wirklich beeindruckend.");
  AddDetail( ({"kalk", "fels"}),
             "Hier besteht so ziemlich alles aus Kalk.");
  AddDetail( "glaenzen",
             "Im Licht Deiner Fackel glaenzt Deine ganze Umgebung.");
  AddDetail( "umgebung",
             "Sie ist ziemlich beeindruckend.");
  AddDetail( "nordwand",
             "In der Nordwand kannst Du eine Hervorwoelbung erkennen.");
  AddDetail( ({"woelbung", "hervorwoelbung"}),
             "An der Nordwand der kleinen Hoehle kannst Du eine "
             "Hervorwoelbung erkennen, die vom Boden weg einen guten Meter in "
             "die Hoehe geht. Bei genauerer Betrachtung scheint es ein Becken "
             "voll Wasser zu sein.");
  AddDetail( "becken",
             "Das Becken ist randvoll mit Wasser gefuellt. Es scheint "
             "etwas tiefer zu sein, als man zuerst vielleicht annehmen "
             "wuerde. Du kannst gerade noch den Grund erkennen.");
  AddDetail( "grund",
             "Am Grund des Beckens siehst Du ein goldernes Schimmern.");
  AddDetail( "schimmern",
             "Du siehst einige Muenzen am Boden des Beckens liegen. "
             "Vielleicht solltest Du mal ein paar hineinwerfen. Es heisst "
             "ja allgemein, dass dies Glueck bringen sollte, und das kannst "
             "Du hier hier unten auf jeden Fall gut gebrauchen.");
  AddDetail( "muenzen",
             "Einige Muenzen liegen am Grund des Beckens. Vielleicht sollst "
             "Du auch mal ein paar hineinwerfen.");
  AddDetail( "wasser",
             "Das Wasser ist glasklar, und laesst Dich so den Grund des "
             "kleinen Beckens erblicken.");
  AddDetail( "decke",
             "Von der Decke tropft gelegentlich etwas Wasser herab.");
  AddDetail( "boden",
             "Der Boden ist nass und schluepfrig.");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers.");
  AddSound( ({"tropfen", "wasser", "geraeusch"}),
    "Es ist irgendwie ein beruhigendes Geraeusch.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft hier ist angenehm kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "wirf", "werfe" }), "heilung" );
  AddCmd( ({"trinke", "trink"}), "wasser" );
  AddCmd( ({"beuge", "beug"}), "cmd_beugen");

  AddExit( "sueden", TROPFST("thoehle7"));
}

heilung ( string str )
{
  string ort, kohle, heilung;
  int geld, besitz;

  if(!str)
    return 0;

  if(str=="muenzen in becken") {
    write("Du musst schon sagen, wie viele Muenzen Du in das Becken werfen "
        "willst.\n");
    return 1;
  }

  if(str=="muenze in becken" || str=="1 muenze in becken")
  {
    if(!present("geld", TP))
    {
      write("Du hast doch gar kein Geld!\n");
      return 1; 
    }
    geld=1;
    write(BS("Du wirfst eine Muenze in das Becken, allerdings passiert nicht "
          "viel. Vielleicht solltest Du es mit einem etwas groesserem Betrag "
          "versuchen."));
    say(CAP_TPN+" wirft etwas in das Becken hinein.\n");
    TP->AddMoney(-geld);
    "/p/daemon/zentralbank"->PayIn(geld, 100); 
    return 1;
  }
  
  if(sscanf(str, "%d %s in %s", geld, kohle, ort)!=3)
    return 0;
  if(kohle!="muenzen" && ort!="becken")
    {
    write(BS("Was willst Du wohin werfen?\n"));
    return 1;
    }

  if(kohle!="muenzen" && ort=="becken")
    {
    write(BS("Das kannst Du da nicht hineinwerfen!\n"));
    return 1;
    }
  
  if(kohle=="muenzen" && ort!="becken")  
    {
    write(BS("Wo willst Du die Muenzen hineinwerfen?\n"));
    return 1;
    }
  if(!present(kohle, TP))
    {
    write(BS("Du hast ja gar keine Muenzen dabei!\n"));
    return 1;
    }

  besitz=TP->QueryMoney();
  if(besitz<geld)
    {
    write(BS("Soviele Muenzen hast Du ja gar nicht!\n"));
    return 1;
    }
  else
    {
    write(BS("Du wirfst ein paar Muenzen in das Becken und ploetzlich scheint "
             "sich fuer einen kurzen Augenblick eine Art magische Aura von "
             "dem Becken ueber Dich auszubreiten. Du fuehlst Dich sonderbarer "
             "Weise sogleich erheblich besser und gestaerkt.\n"));
    say(BS(CAP_TPN+" wirft etwas in das Becken hinein und scheint sich "
             "sogleich viel besser zu fuehlen.\n"));
    heilung=geld/10;
    TP->heal_self(heilung);
    TP->AddMoney(-geld);
    "/p/daemon/zentralbank"->PayIn(geld, 100); 
    return 1;
    }

}

wasser (str)
{
  notify_fail("Was willst Du trinken?\n");
  if(str=="wasser")
    {
    write(BS("Du trinkst einen Schluck von dem Wasser. Es schmeckt irgendwie "
             "sonderbar, und im selben Moment kommt Dir der Gedanke, ob "
             "dieses Wasser wohl zu etwas anderem bestimmt ist als zum "
             "Trinken.\n"));
    say(BS(CAP_TPN+" trinkt etwas von dem Wasser und hat daraufhin einen ganz "
             "nachdenklichen Gesichtsausdruck.\n"));
    return 1;
    }
  else
    return 0;
}

int cmd_beugen(string str)
{
  object ob;
  if (ob = present("gnom", TP))
    return ob->trinken(str);
  else
    return 0;
}

