// Thor@SilberLand
// Ein Loch in die Tiefe - loch5.c
// 1997-04-25

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Die Treppe fuehrt immer tiefer in den Abgrund hinab. Du wirst schon "
   +"etwas misstrauisch, bei dem Gedanken, wo Du da wohl hingelangen wirst. "
   +"Die Stufen werden auch immer bruechiger und Du denkst bereits darueber "
   +"nach, ob Du nicht besser umkehren solltest. Zu Deiner Rechten siehst Du "
   +"eine Inschrift in den Fels der Wand eingraviert.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "treppe",
             "Die Treppe fuehrt immer noch weiter nach unten und wird von "
            +"Schritt zu Schritt baufaelliger.");
  AddDetail( "abgrund",
             "Der Abgrund neben Dir scheint kein Ende zu nehmen.");
  AddDetail( "ende",
             "Der Abgrund erscheint Dir endlos.");
  AddDetail( "schritt",
             "Von Schritt zu Schritt wird der Boden unter Deinen Fuessen "
            +"unsicherer.");
  AddDetail( "gedanke",
             "Du denkst darueber nach, ob es nicht besser waere, umzukehren.");
  AddDetail( "stufen",
             "Die Stufen, auf denen Du hinunter gehst, werden immer "
            +"bruechiger und wackeliger.");
  AddDetail( ({"schrift", "inschrift"}),
             "Du kannst sie lesen.");
  AddDetail( ({"fels", "wand", "felswand"}),
             "In die Felswand ist eine Inschrift eingraviert.");
  AddDetail( "waende",
             "Die Waende sind aus schwarzem Gestein.");
  AddDetail( "gestein",
             "Es ist pechschwarz.");
  AddDetail( "boden",
             "Der Boden unter Dir wird immer unsicherer.");
  AddDetail( "decke",
             "Du kannst von hier aus die Decke nicht mehr erkennen.");

  AddReadDetail( ({ "schrift", "inschrift" }),
    "\n"
   +" WER HIER SICH TIEFER WAGT IN DIE HOEHLE HINEIN\n"
   +"\n"
   +" AUF EWIG VERDAMMT DORT UNTEN SOLL ER SEIN.\n"
   +"\n"
   +" SO LAUSCHE DER WEISEN ZWERGEN WORTE\n"
   +"\n"
   +" HALTE DICH FERN VON DIESEM ORTE!\n"
   +"\n");

  AddSound( DEFAULT_SOUND,
    "Es herrscht tiefste Stille.");
  AddSound( "stille",
    "Du hoerst nichts.");
  AddSound( ({"worte", "zwerge"}),
    "So woertlich war das nun auch wieder nicht gemeint ;)");
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmes einmal kraeftig durch.");

  AddExit( "suedwestoben", HOEHLE("loch4"));
  AddExit( "nordwestunten", HOEHLE("loch6"));
  AddExit( "suedwesten", HOEHLE("loch4"));
  AddExit( "nordwesten", HOEHLE("loch6"));
  SetProp (P_HIDE_EXITS, ({"nordwesten", "suedwesten"}) );

}
