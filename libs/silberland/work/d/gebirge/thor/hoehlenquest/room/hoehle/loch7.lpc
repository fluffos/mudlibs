// Thor@SilberLand
// Ein Loch in die Tiefe - loch7.c
// 1997-04-29

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Du wunderst Dich, wie weit es hier wohl noch in die Tiefe gehen mag. "
    "Ueber und unter Dir siehst Du nur gaehnende Finsternis. Das schwarze "
    "Gestein rund um Dich herum bringt auch nicht gerade etwas Licht in "
    "Deine Umgebung. Du beginnst schon zu gruebeln, ob Du wohl genug Fackeln "
    "bei Dir hast.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"tiefe", "treppe"}),
             "Der Schlund, in dem Du stehst, scheint endlos in die Tiefe "
             "hinab zu reichen. Du kannst von hier aus immer noch keinen "
             "Boden erkennen.");
  AddDetail( "schlund",
             "Dich ueberkommt ein mulmiges Gefuehl, wenn Du daran denkst, wie "
             "tief unter der Erde Du jetzt wohl schon sein magst.");
  AddDetail( "erde",
             "Du bist bestimmt schon einige hundert Meter tief unter der "
	      "Erde.");
  AddDetail( "gefuehl",
             "Dir ist etwas flau im Magen.");
  AddDetail( ({"finsternis", "dunkelheit"}),
             "Deine Fackel leuchtet nur einige Meter weit in der absoluten "
             "Dunkelheit der Hoehle.");
  AddDetail( ({"fackel", "fackeln"}),
             "Du hoffst, dass Du genuegend Fackeln dabei hast.");
  AddDetail( ({"gestein", "fels"}),
             "Der schwarze Fels um Dich herum verschluckt das meiste Licht "
             "Deiner Fackel.");
  AddDetail( "licht",
             "Deine Fackel leuchtet nur ein paar Meter weit.");
  AddDetail( "umgebung",
             "Deine Umgebung ist nur ein paar Meter rund um Dich von dem "
             "schwachen Licht Deiner Fackel erleuchtet.");
  AddDetail( "boden",
             "Der Boden, auf dem Du stehst, ist aeusserst unsicher und "
             "bruechig.");
  AddDetail( "waende",
             "Die Waende bestehen aus schwarzem Fels.");
  AddDetail( "decke",
             "Die Decke kannst Du von hier aus nicht mehr erkennen.");
  AddDetail( "hoehle",
             "Immer tiefer steigst Du in die Finsternis der Hoehle hinab.");  

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");    

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordostoben", HOEHLE("loch6"));
  AddExit( "suedostunten", HOEHLE("loch8"));
  AddExit( "nordosten", HOEHLE("loch6"));
  AddExit( "suedosten", HOEHLE("loch8"));
  SetProp (P_HIDE_EXITS, ({"nordosten", "suedosten"}) );

}
