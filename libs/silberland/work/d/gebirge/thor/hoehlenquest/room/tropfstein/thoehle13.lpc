// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle13.c
// 1997-05-24

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Zu Deiner Verblueffung stehst Du hier direkt vor einem kleinen See. "
    "Naja, See waere vielleicht zu viel gesagt, es ist einfach eine kleine "
    "Wasserflaeche, die allerdings ziemlich weit in die Tiefe zu fuehren "
    "scheint. Das Wasser scheint von irgendwo tief unten erhitzt zu werden, "
    "denn es dampft ein wenig. Obwohl der See die Hoehle noch maerchenhafter "
    "macht, kommt er Dir trotzdem reichlich unheimlich vor. Von der Decke "
    "tropfen manchmal einige Wassertropfen herunter und brechen die "
    "unheimliche Stille.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "verblueffung",
             "Staunend stehst Du vor einem kleinen See in der Hoehle.");
  AddDetail( ({"tropfsteinhoehle", "hoehle"}),
             "Der Weg durch die Hoehle fuehrt weiter Richtung Nordwesten und "
             "Suedwesten, rund um den kleinen See herum.");
  AddDetail( "weg",
             "Er fuehrt weiter nach Nordwesten und Suedwesten, rund um den "
             "kleinen See herum.");
  AddDetail( "see",
             "See ist vielleicht nicht ganz der richtige Ausdruck, es ist "
             "eher eine kleine Wasserflaeche.");
  AddDetail( ({"wasserflaeche", "flaeche"}),
             "Das Wasser scheint ziemlich tief zu sein, Du kannst keinen "
             "Grund erkennen. Es scheint von tief unten erhitzt zu werden, "
             "denn es steigt ein wenig Dampf von der Oberflaeche auf.");
  AddDetail( "grund",
             "Der See ist zwar sehr klein, scheint dafuer aber umso tiefer "
             "zu sein. Du kannst keinen Grund erkennen.");
  AddDetail( ({"wasseroberflaeche", "oberflaeche"}),
             "Der Dampf, der von der Wasseroberflaeche aufsteigt, bietet "
             "einen sonderbaren Anblick in dieser Hoehle.");
  AddDetail( "anblick",
             "Der See mit der dampfenden Wasseroberflaeche bietet einen "
             "seltsamen Anblick.");
  AddDetail( "wasser",
             "Das Wasser scheint sonderbarer Weise sehr warm zu sein. Du "
             "wuerdest einmal gerne hineingreifen, um zu sehen, wie warm es "
             "wirklich ist.");
  AddDetail( "dampf",
             "Etwas Dampf steigt von der Wasseroberflaeche auf. Das ist "
             "ein sonderbarer Anblick in einer so kuehlen Hoehle...");
  AddDetail( ({"tropfen", "wassertropfen"}),
             "Von der Decke tropfen gelegentlich einige Wassertropfen "
             "herunter.");
  AddDetail( "decke",
             "Auch hier haengen Tropfsteine von der Decke, von denen manchmal "
             "ein Wassertropfen herunterfaellt und in den See tropft.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Von den Tropfsteinen an der Decke tropfen gelegentlich einige "
             "Wassertropfen herunter.");
  AddDetail( ({"wassertropfen", "tropfen"}),
             "Manchmal faellt ein Wassertropfen von der Decke in den See "
             "hinein.");
  AddDetail( ({"stille", "totenstille"}),
             "Das Tropfen des Wassers durchdringt die Totenstille ein wenig.");
  AddDetail( "Wenn nicht das Tropfen des Wassers waere, wuerde in dieser "
             "Hoehle tiefste Totenstille herrschen.");
  AddDetail( ({"waende", "wand"}),
             "Von den Waenden rinnt ein wenig Wasser herunter.");
  AddDetail( "boden",
             "Der Boden hoert gleich vor Dir auf, wo der See anfaengt.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst, wie die Wassertropfen in den kleinen See tropfen.");
  AddSound( ({"tropfen", "wassertropfen", "echo"}),
    "Das Echo der Wassertropfen hallt durch die Hoehle.");
  AddSound( ({"stille", "totenstille"}),
    "Das Tropfen des Wasser durchdringt die Stille ein wenig.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "greif", "greife" }), "wasser" );
  AddCmd( ({"springe", "spring"}), "see");

  AddExit( "nordosten", TROPFST("thoehle12"));
  AddExit( "nordwesten", TROPFST("thoehle14"));
  AddExit( "sueden", TROPFST("thoehle19"));
  AddExit( "suedwesten", TROPFST("thoehle18"));
}

wasser( str )
{
  notify_fail( "Wo willst Du hineingreifen?\n" );
  if( str == "in wasser" || str=="in wasser hinein")
  {
    write(BS("Du greifst vorsichtig mit einem Finger in das Wasser hinein und "
             "stellst fest, dass es angehnem warm ist. Es waere sogar warm "
             "genug, um hineinzuspringen, Du bist allerdings noch etwas "
             "unschluessig.\n"));
    say(BS(CAP_TPN+" greift in das Wasser hinein, und bleibt dann etwas "
             "unentschlossen vor dem Ufer stehen.\n"));
    return 1;
  }
  return 0;
}

see( str )
{
  notify_fail( "Wo willst Du hineinspringen?\n" );
  if( str=="in wasser" || str=="in wasser hinein")
    {
    write(BS("Du ueberlegst eine Zeit lang, ob Du da wirklich hineinspringen "
             "sollst, laesst es dann aber doch besser bleiben.\n"));
    return 1;
    }
  return 0;
}

