*  Thor@SilberLand           *
*  Ein Lavablock - lava14.c  *
*  1997-08-21                *
*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Der Lavablock, auf dem Du stehst, breitet sich weiter "
    "Richtung Norden und Westen aus. Nach Osten kommst Du wieder "
    "zurueck zu einer Bruecke, die zu einem weiteren Lavablock "
    "fuehrt. Wie es scheint, bist Du hier ziemlich in der Mitte "
    "der Lavahoehle angelangt. In allen Richtungen siehst Du "
    "weiter entfernt andere Lavabloecke aus der Magma herausragen, "
    "nur im Nordosten siehst Du weithin bis zu den Hoehlenwaenden "
    "nur rot-gelb gluehende Lava bis zu den Hoehlenwaenden hin.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"block", "lavablock"}),
	     "Er fuehrt weiter Richtung Norden und Westen.");
  AddDetail( "bruecke",
	     "Im Osten ist wieder eine Bruecke, die Richtung "
	     "Suedosten zu fuehren scheint.");
  AddDetail( ({"mitte", "hoehle", "lavahoehle"}),
	     "Wenn Du Dich so in der Hoehle umblickst, kommst Du "
	     "zu dem Schluss, dass Du hier ziemlich in der Mitte "
	     "der Hoehle sein musst... Sofern die flirrende und "
	     "flimmernde Luft nicht enorme Taeuschungen "
	     "hervorruft.");
  AddDetail( "hoehle",
	     "Du bist hier in der Mitte der Hoehle.");
  AddDetail( "schluss",
	     "Nein, das ist nicht der Schluss, das ist die Mitte. "
	     "Das sagte ich doch schon.");
  AddDetail( "luft",
	     "Die Luft flirrt und flimmert andauernd durch die "
	     "immer noch hoellische Hitze. Ein genaues Erkennen "
	     "von Entfernungen wird dadurch nahezu unmoeglich.");
  AddDetail( "hitze",
	     "Die Hitze ist auch hier um nichts geringer, als sie "
	     "sonst ueberall in der Hoehle ist.");
  AddDetail( ({"taeuschungen", "entfernungen", "entfernung", "taeuschung"}),
	     "Die flimmernde Luft taeuscht Dein Auge und daher kannst "
	     "Du auch Entfernungen nicht genau einschaetzen.");
  AddDetail( ({"auge", "augen"}),
	     "Deine Augen brennen von der Hitze.");
  AddDetail( ({"bloecke", "lavabloecke"}),
	     "In allen Richtungen siehst Du weiter weg andere "
	     "Lavabloecke aus der Magma herausragen, nur Richtung "
	     "Nordosten nicht.");
  AddDetail( ({"magma", "lava"}),
	     "Im Nordosten ist die Lava beinahe schon gelblich "
	     "gluehend. Es scheint dort tausende Grade zu haben. "
	     "Kein Wunder, dass sich da kein Fels mehr halten kann. "
	     "Bei dieser Hoellenglut schmilzt wahrscheinlich alles "
	     "auf Erden bekannte Material.");
  AddDetail( ({"grad", "grade"}),
	     "Im Nordosten, wo Du weithin nur gelb gluehende Lava "
	     "erkennen kannst, hat es wohl etwas mehr als ein paar "
	     "hundert Grad.");
  AddDetail( "wunder",
	     "Es ist wirklich kein Wunder, das bei einer solchen "
	     "alles einfach dahinschmilzt.");
  AddDetail( "material",
	     "Bei diesen Temperaturen schmilzt wahrscheinlich jedes "
	     "bekannte Material."); 
  AddDetail( "fels",
	     "Selbst der Fels schmilzt bei solchen Temperaturen "
	     "einfach dahin.");
  AddDetail( ({"temperaturen", "temperatur"}),
	     "Die Temperaturen hier sind wohl heisser als in der "
	     "Hoelle.");
  AddDetail( "hoelle",
	     "In der Hoelle ist es wohl kuehler als hier.");
  AddDetail( ({"glut", "hoellenglut"}),
	     "Die brodelt etwa zwanzig Meter unter Dir.");
  AddDetail( ({"waende", "hoehlenwaende", "wand", "hoehlenwand"}),
	     "Du bist hier ziemlich weit weg von den "
	     "Hoehlenwaenden.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss.");
  AddDetail( "fuesse",
	     "Sie brennen ganz fuerchterlich.");
  AddDetail( "decke",
	     "Die Decke besteht aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddExit( "norden", LAVA("lava15"));
  AddExit( "osten", LAVA("bruecke11"));
  AddExit( "westen", LAVA("lava13"));

}
