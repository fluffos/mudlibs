// Thor@SilberLand
// Eine verschollene Hoehle - hoehle3.c
// 1997-04-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einer Hoehle, die, wie es scheint, schon lange von keinem "
    "Wesen mehr betreten wurde. An den Waenden liegt etwas Geroell herum, wie "
    "es scheinbar aus den Fels herausgebroeckelt ist. In einer Ecke liegen "
    "einige abgenagte Knochen herum. Die Nordwand sieht etwas ungewoehnlich "
    "aus. Hier fuehrt eine in den Stein gehauene Treppe steil nach oben, und "
    "das Gestein an der Decke ist mit Erde und Wurzeln durchsetzt.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"nordwand", "wand", "norden"}),
             "Hier wurde eine Treppe in den Stein gemeisselt. Ausserdem ist "
             "die Wand nicht so felsig wie der Rest der Hoehle, sie ist etwas "
             "mit Erde durchsetzt.");
  AddDetail( "rest",
             "Der Rest der Hoehle ist doch ziemlich felsig, wie es sich fuer "
             "eine ordentliche Hoehle auch gehoert.");
  AddDetail( "treppe",
             "Die Treppe scheint auch nicht mehr die juengste zu sein. Sie "
             "ist nur noch ansatzhalber als solche zu erkennen. Die Stufen "
             "sind schon ziemlich abgenuetzt und von Rissen und Spalten "
             "durchzogen.");
  AddDetail( ({"riss","risse","spalte","spalten","spalt"}),
             "Die tiefsten Risse wurden ausgebessert. Jemand scheint Wert "
             "darauf zu legen, die Treppe begehbar zu halten.");
  AddDetail( "wert",
             "Nicht zuviel allerdings ...");
  AddDetail( ({"stufen","stufe"}),
             "Man kann sie gerade noch als begehbar bezeichnen. "
             "Erstaunlicherweise sind die schlimmsten Maengel in den Stufen "
             "ausgebessert worden. Irgendjemand scheint sich doch manchmal "
             "um die Treppe zu kuemmern, wenn auch nicht besonders intensiv.");
  AddDetail( ({"mangel","maengel"}),
             "Die schlimmsten wurden beseitigt, sodass man die Treppe doch "
             "noch relativ gefahrlos begehen kann.");
  AddDetail( ({"jemand","irgendjemand"}),
             "Du kannst Dir im Moment nicht vorstellen, wer das ist.");
  AddDetail( "moment",
             "Vielleicht im naechsten? Du koenntest ja mal die Treppe "
             "raufgehen, das koennte Aufschluss geben ...");
  AddDetail( "aufschluss",
             "Nein, hier brauchst Du nichts aufzuschliessen.");
  AddDetail( ({"erde","decke","hoehlendecke"}),
             "Die Hoehlendecke scheint hier nicht sonderlich dick zu sein, "
             "sie ist von Erde und Wurzeln durchsetzt.");
  AddDetail( ({"wurzel","wurzeln"}),
             "An der Oberflaeche scheint ein grosser Baum zu stehen, anders "
             "kannst Du Dir die dicken, starken Wurzeln nicht erklaeren.");
  AddDetail( ({"flaeche","oberflaeche"}),
             "Die kannst Du vermutlich ueber die Treppe erreichen.");
  AddDetail( "baum",
             "Der muss wahrlich ein Prachtexemplar sein, wenn seine Wurzeln "
             "so tief reichen.");
  AddDetail( ({"exemplar", "prachtexemplar"}),
             "Schau ihn Dir doch einfach selbst an.");
  AddDetail( "hoehle",
             "Die Hoehle scheint sehr alt zu sein. Wahrscheinlich hat schon "
             "lange niemand mehr einen Fuss hier hereingesetzt. Der Boden "
             "ist mit einer duennen Staubschicht bedeckt.");
  AddDetail( "fuss",
             "Ausser Dir natuerlich.");
  AddDetail( "wesen",
             "Der Staub am Boden ist nicht angeruehrt, man kann keinerlei "
             "Spuren erkennen.");
  AddDetail( "spuren",
             "Es scheint lange niemand mehr in dieser Hoehle gewesen zu sein. "
             "Es sind im Staub keine Spuren zu entdecken.");
  AddDetail( ({"staub", "staubschicht"}),
             "Am Boden ist eine duenne, unberuehrte Staubschicht.");
  AddDetail( "boden",
             "Am Boden liegt etwas Staub und an den Waenden ist einiges "
             "Geroell zu Boden gebroeckelt.");
  AddDetail( "geroell",
             "Das Gestein in den Waenden hat sich teilweise etwas gelockert. "
             "Manchmal ist ein wenig daraus heruntergebrochen und liegt nun "
             "am Boden herum.");
  AddDetail( ({"fels", "gestein", "stellen", "stein"}),
             "Das Gestein scheint an einigen Stellen schon etwas locker. ");
  AddDetail( "waende",
             "Bei den Waenden liegt etwas Geroell herum, das "
             "herausgebroeckelt ist.");
  AddDetail( ({"zacken", "felszacken"}),
             "Sie sehen aus, wie unheimliche, lange Finger.");
  AddDetail( "finger",
             "Irgendwie sehen die Felszacken unheimlich aus.");
  AddDetail( "ecke",
             "In einer Ecke der Hoehle liegen einige bleiche, abgenagte "
             "Knochen herum.");
  AddDetail( "knochen",
             "Es scheint, als habe frueher hier einmal ein Raubtier gelebt, "
             "das seine Opfer hier gefressen hat.");
  AddDetail( ({"opfer", "angst"}),
             "Wahrscheinlich ist das Raubtier schon tot oder umgezogen, Du "
             "brauchst also keine Angst haben, eines der Opfer zu werden.");
  AddDetail( ({"raubtier", "tier", "raubkatzen", "katzen"}),
             "Im Gebirge soll es ja auch einige gefaehrliche Raubkatzen "
             "geben.");
  AddDetail( "gebirge",
             "Du bist gerade mitten drin.");
  AddDetail( ({"luft", "hoehlenluft"}),
             "Den kannst Du nicht sehen, nur spueren.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Vom Inneren der Hoehle kommt ein kuehler Luftzug heraus.");
  AddSmell( ({"zug", "luftzug"}),
    "Du atmes einmal tief die angenehme Hoehlenluft ein.");
 
  AddCmd( ({"schliess","schliesse"}), "schliessen");
  AddCmd( ({"kuemmere","kuemmer"}), "kuemmern");
  AddCmd( ({"bessere","besser"}), "ausbessern");

  AddExit( "osten", HOEHLE("hoehle5"));
  AddExit( "suedosten", HOEHLE("hoehle6"));
  AddExit( "sueden", HOEHLE("hoehle4"));
  AddExit( "suedwesten", HOEHLE("hoehle2"));
}

schliessen( str )
{
  write(BS("Du suchst ganz verzweifelt etwas zum auf-, zu- oder sonstwie "
           "schliessen, leider jedoch vergeblich. So sehr Du Dich auch "
           "bemuehst, Du findest nichts.\n"));
  return 1;
}

kuemmern( str )
{
  notify_fail( "Worum willst Du Dich kuemmern?\n" );
  if( str=="um treppe"||str=="treppe"||str=="stufen"||str=="um stufen")
  {
    write(BS("Kuemmere Dich lieber um Deine eigenen Angelegenheiten! "
             "Ausserdem kennst Du Dich doch gar nicht mit Treppen aus.\n"));
    return 1;
  }
  else if( str=="um eigene angelegenheiten"||str=="eigene angelegenheiten" )
  {
    write(BS("Artig wendest Du Dich von der Treppe ab und kuemmerst Dich um "
             "Deine eigenen Angelegenheiten.\n"));
    return 1;
  }
  return 0;
}


ausbessern( str )
{
  notify_fail( "Was willst Du ausbessern?\n" );
  if( str=="risse aus"||str=="riss aus"||str=="spalten aus"||str=="spalte aus")
  {
    write(BS("Eine bessere Welt waere wichtiger als eine bessere Spalte ...\n"));
    return 1;
  }
  else if( str=="welt"||str=="welt aus" )
  {
    write(BS("Du nimmst Dir fest vor, die Welt zu verbessern. Puh, ein ganz "
             "schoen grosses Projekt ...\n"));
    return 1;
  }
  return 0;
}

