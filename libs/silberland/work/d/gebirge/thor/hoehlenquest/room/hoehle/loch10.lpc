// Thor@SilberLand
// Ein Loch in die Tiefe - loch10.c
// 1997-04-30

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Neben Dir in der Felswand ist hier eine Oeffnung, die beinahe aussieht, "
   +"wie ein Tunnel. Du kannst nicht erkennen, wo der Tunnel hinfuehrt, die "
   +"Treppe vor Dir kannst Du auf jeden Fall nicht mehr entlanggehen. Die "
   +"Stufen vor Dir sind teilweise schon ganz weggebrochen, sodass nur noch "
   +"ein gaehnender Abgrund in die Tiefe fuehrt, wo man keinerlei Halt mehr "
   +"findet.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );

  AddDetail( ({"wand", "felswand"}),
             "In der Felswand auf der rechten Seite ist eine tunnelgrosse "
            +"Oeffnung, wo ein Gang weiterfuehrt. Deine Fackel leuchtet jedoch "
            +"nicht weit genug, sodass Du erkennen koenntest, was sich "
	    +"darin verbirgt.");
  AddDetail( "oeffnung",
             "Auf der rechten Seite der Felswand ist eine tunnelgrosse "
            +"Oeffnung, die in den Fels hineinfuehrt.");
  AddDetail( ({"tunnel", "gang"}),
             "Du kannst nicht erkennen, wo der Gang hinfuehrt. Dafuer "
            +"leuchtet Deine Fackel nicht weit genug.");
  AddDetail( ({"fackel", "licht"}),
             "Das meiste Licht von Deiner Fackel wird von dem schwarzen Fels "
            +"verschluckt.");
  AddDetail( "treppe",
             "Vor Dir sind einige Teile der Treppe schon ganz weggebrochen, "
            +"sodass nur mehr die Felswand steil nach unten fuehrt.");
  AddDetail( "stufen",
             "Die Stufen sind schon voellig verfallen und kurz vor Dir schon "
            +"ueberhaupt nicht mehr vorhanden.");
  AddDetail( "abgrund",
             "Dort, wo die Stufen schon weggebrochen sind, fuehrt nur mehr "
            +"ein gaehnender Abgrund in die Tiefe.");
  AddDetail( ({"tiefe", "loch"}),
             "Das Loch scheint tatsaechlich bodenlos zu sein, denn sogar hier "
            +"kannst Du immer noch kein Ende erkennen.");
  AddDetail( "ende",
             "Der Abgrund scheint keinen Boden zu haben.");
  AddDetail( "halt",
             "Wo die Treppe weggebrochen ist, findet man nichts mehr, dass "
            +"einem Halt gebieten koennte.");
  AddDetail( "boden",
             "Du gehst wohl besser schnell in den Gang hinein, wo Du wieder "
            +"einigermassen sicheren Boden unter den Beinen hast.");
  AddDetail( "beine",
             "Sie sind schon etwas weich und wackelig.");
  AddDetail( "waende",
             "Die Waende bestehen aus schwarzem Fels.");
  AddDetail( ({"fels", "gestein"}),
             "Das Gestein ist pechschwarz gefaerbt.");
  AddDetail( "decke",
             "Die kannst Du von hier aus wirklich nicht mehr erkennen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "suedostoben", HOEHLE("loch9"));
  AddExit( "suedosten", HOEHLE("loch9"));
  AddExit( "norden", LAB("laby1"));
  SetProp (P_HIDE_EXITS, ({"suedosten"}) );

}

