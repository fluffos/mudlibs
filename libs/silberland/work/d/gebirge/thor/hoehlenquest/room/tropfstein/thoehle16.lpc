// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle16.c
// 1997-05-26

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "An den Waenden neben Dir wachsen sonderbare, kleine Tropfsteintuerme "
    "in die Hoehe. Die etwa einen Meter hohen Stalagmiten sehen bizarr aus, "
    "mit den Tropfsteinwulsten, aus denen die Tuerme bestehen. Einige sind "
    "schon mit der Wand zusammengewachsen, andere stehen wie ein kleines "
    "Waeldchen am Boden dicht nebeneinander. Es ist irgendwie ein "
    "geisterhafter Anblick mit dem dampfenden See neben Dir.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "waende",
             "Bei den Waenden wachsen bizarre, kleine Tropfsteintuerme in "
             "die Hoehe.");
  AddDetail( ({"tuerme", "tropfsteintuerme", "tuermchen", "tropfsteintuermchen"}),
             "Die Stalagmiten sehen aus, wie kleine, wulstige "
             "Tropfsteintuerme, die in die Hoehe ragen.");
  AddDetail( "stalagmiten",
             "Sie sind ein aeusserst bizarrer Anblick.");
  AddDetail( "anblick",
             "Der Anblick Deiner Umgebung ist unheimlich aber auch "
             "irgendwie fesselnd.");
  AddDetail( ({"umgebung", "hoehle", "tropfsteinhoehle"}),
             "Die Tropfsteinhoehle ist von einer fremdartigen Schoenheit.");
  AddDetail( "schoenheit",
             "Obwohl die Hoehle etwas unheimlich erscheint, ist sie doch "
	     "von atemberaubender Schoenheit erfuellt.");
  AddDetail( ({"wulste", "tropfsteinwulste"}),
             "Die kleinen Tuerme aus Kalkgestein sehen aus, wie aufeinender "
             "gestapelte Tropfsteinwulste.");
  AddDetail( "wand",
             "Einige Tropfsteintuerme sind schon mit der Wand zusammenge"
             "wachsen.");
  AddDetail( "waeldchen",
             "Die niedrigen, duennen Tuermchen erinnern an ein kleines, "
             "steinernes Waeldchen, das aus dem Boden herauswaechst.");
  AddDetail( "boden",
             "Es wachsen einige Tropfsteintuermchen daraus herauf.");
  AddDetail( "see",
             "Der dampfende See neben Dir macht Deine Umgebung noch sonder"
             "barer und geheimnisvoller.");
  AddDetail( "decke",
             "Auch von der Decke haengen unzaehlige Tropfsteine in den "
             "verschiedensten Formen und Groessen herab.");
  AddDetail( ({"steine", "tropfsteine", "formen", "groessen"}),
             "Die Tropfsteine haben die verschiedensten Formen und "
             "Groessen.");
  AddDetail( "waende",
             "Die Waende sind feucht und etwas Wasser tropft daran herab.");
  AddDetail( "wasser",
             "Es ist allgegenwaertig in einer Tropfsteinhoehle.");
  AddDetail( "dampf",
             "Der Dampf des Sees wirkt irgendwie fehl am Platze.");
  AddDetail( "kalkgestein",
             "Daraus besteht die ganze Hoehle.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise das Tropfen vom Wasser."); 
  AddSound( ({"tropfen", "wasser", "geraeusch"}),
    "Das Tropfen ist ein beruhigendes Geraeusch, findest Du.");
   
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordosten", TROPFST("thoehle15"));
  AddExit( "osten", TROPFST("thoehle14"));
  AddExit( "sueden", TROPFST("thoehle17"));
}
