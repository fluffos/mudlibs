#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

//int verschuettet(void);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Der Weg fuehrt hier um eine grosse Kristallsaeule herum Richtung "
    "Nordosten und Nordwesten. Die Saeule steht direkt vor Dir im "
    "Norden und macht einen wahrlich gewaltigen Eindruck. Sie hat einen "
    "Umfang von etwa fuenf Meter und sie ragt vier Meter hoch bis zur "
    "Decke hinauf. Oben, wo die Saeule an der Decke angewachsen ist, haengt "
    "eine Vielzahl von Kristallen herunter.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "weg",
             "Er fuehrt weiter Richtung Nordosten und Nordwesten.");
  AddDetail( "hoehle",
             "Die Hoehle funkelt und glitzert im reflektierten Licht der "
             "vielen Kristalle.");
  AddDetail( ({"kristallsaeule", "saeule"}),
             "Die Kristallsaeule vor Dir ist von gigantischem Ausmasse. Sie "
             "hat einen Umfang von etwa fuenf Meter und ragt vier Meter bis "
             "zur Decke hoch.");
  AddDetail( "ausmass",
             "Ja, die Saeule ist ziemlich gross.");
  AddDetail( "decke",
             "Oben an der Decke, wo die Saeule festgewachsen ist, haengen "
             "zahlreiche, groessere Kristalle herunter. Sie sehen nicht "
             "allzu stabil aus, sie koennten leicht herunterbrechen. Du "
             "solltest besser nicht dagegenschlagen.");
  AddDetail( ({"kristalle", "kristall", "bergkristalle", "bergkristall"}),
             "Sie haengen von der Decke herunter und sind auch sonst ueberall "
             "festgewachsen. Die Kristalle brechen das Licht in vielen Farben "
             "und tauchen so die Hoehle in ein wunderschoenes Funkeln und "
             "Glitzern.");
  AddDetail( ({"funkeln", "glitzern"}),
	     "Die Kristalle glitzern maerchenhaft schoen und lassen so die "
             "ganze Hoehle funkeln.");
  AddDetail( "farben",
             "Das von den Kristallen gebrochene Licht wird in vielfaeltigen "
             "Farben reflektiert.");
  AddDetail( "licht",
             "Das Licht wird durch die verschiedenen, geometrischen Formen "
             "der Kristalle hundertfach gebrochen.");
  AddDetail( "formen",
             "Die Kristalle sind zu den verschiedensten, geometrischen "
             "Formen zusammengewachsen.");
  AddDetail( "eindruck",
             "Du kannst Deinen Blick kaum von der gewaltigen Kristallsaeule "
             "abwenden.");
  AddDetail( "umfang",
             "Die Saeule hat einen Umfang von etwa fuenf Metern.");
  AddDetail( "vielzahl",
             "Die Vielzahl der Kristalle ist beinahe schon unglaublich.");
  AddDetail( "boden",
             "Du hoerst das leise Knirschen Deiner Schritte auf den kleinen "
             "Kristallen am Boden.");
  AddDetail( "schritte",
             "Sie knirschen leise.");
  AddDetail( ({"waende", "wand"}),
             "Auch aus den Waenden wachsen zahlreiche Bergkristalle heraus.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Knirschen Deiner Schritte, wie Du die kleinen "
    "Kristalle am Boden zertrittst.");
  AddSound( ({"knirschen", "schritte", "kristalle"}),
    "Es hoert sich beinahe so an, wie auf frischem Schnee.");
    
  AddCmd( ({"schlag", "schlage", "hau", "haue" }), "saeule" );

  AddExit( "nordosten", TROPFST("khoehle12"));
  AddExit( "nordwesten", TROPFST("khoehle7"));
  AddExit( "westen", TROPFST("khoehle8"));
}

saeule( str )
{
  int i;
  object ob, inv;

  notify_fail( "Wo willst Du dagegenschlagen?\n");
  if(str=="gegen saeule"||str=="gegen kristallsaeule")
    {
    write(BS("Du haelts inne, ob es nicht doch klueger waere, die Saeule "
             "nicht allzu grob zu beruehren. Wenn Du dennoch dagengeschlagen "
             "moechtest, dann versuche \"schlage mit voller wucht gegen "
             "saeule\". Bedenke jedoch: es koennte gefaehrlich werden.\n"));
    return 1;
    }

  if(str=="mit voller wucht gegen saeule"||str=="mit voller wucht gegen kristallsaeule")
    {
    ob=TP->QueryProp(P_WEAPON);
    if(ob==0)
      {
      if((TP->QueryProp(P_HANDS)[1])<500)
	{
        write(BS("Du schlaegst mit Deinen Faeusten so fest gegen die "
               "Kristallsaeule, wie Du nur irgendwie kannst. Ausser, dass "
               "Du Dir blutige Faeuste holst, passiert allerdings nicht "
               "viel.\n"));
        say(BS(CAP_TPN+" schlaegt wie verrueckt auf eine Kristallsaeule "
               "ein. Nach einer Weile haelt "+TPN+" inne und betrachtet "
               "stutzig seine blutigen Faeuste.\n"));
	TP->do_damage(random(10));
        return 1;
        }
      else
        {
        write(BS("Du kannst kein normaler Spieler sein, wenn Du so stark "
                  "mit Deinen blossen Faeusten zuhaust. Ich glaube, Du hast "
                  "besseres zu tun, als hier auf eine Kristallsaeule wie "
                  "verrueckt einzudreschen.\n"));
        return 1;
        }
      }
    else if(ob->QueryProp(P_WC)<150)
      {
      if(ob->QueryMaterial(MAT_MAGIC)>0 || ob->QueryProp(P_MAGIC) || ob->QueryMaterial(MAT_MISC_MAGIC))
        {
	write(BS("Du holst weit mit "+ob->Name(WEM,1)+" aus, ueberlegst Dir dann "
                 "allerdings, ob es nicht besser waere, mit einer anderen "
                 "Waffe zuzuschlagen.\n"));
	say(BS(CAP_TPN+" holt weit mit " + ob->name(WEM,0) + 
                 " aus, haelt dann aber doch "
                  "inne. Er wird schon wissen, warum...\n"));
        return 1;
        }
      else
        {
	write(BS("Du schlaegst so fest Du nur kannst mit "
              +ob->name(WEM,1)+" gegen die Kristallsaeule. "
               "Deine Waffe scheint allerdings viel zu schwach dazu zu sein "
               "und zerbroeckelt in Deinen Haenden.\n"));
        say(BS(CAP_TPN+" schlaegt mit voller Wucht mit " + 
              ob->name(WEM,0) + " gegen die Kristallsaeule. "
               "Die Waffe zerbroeckelt " +TP->QueryPronoun(WEM)+" jedoch in "
               "den Haenden.\n"));
        ob->DoUnwield(1);
        ob->remove();
        return 1;
        }
      }
    else
      {
      write(BS("Du schlaegst so fest Du nur kannst mit "
              +ob->name(WEM,1)+" gegen die Kristallsaeule, wie es "
               "nur irgendwie geht. Ploetzlich beginnen die Kristalle von "
               "der Decke herunterzubroeckeln. Die Saeule wird an der Decke "
               "oben auch immer bruechiger und ploetzlich brechen einige "
               "riesige Kristallbrocken herab und begraben Dich unter sich. "
               "Es war vielleicht doch nicht so klug, Dich an der Saeule "
               "zu schaffen machen.\n"));
      say(BS(CAP_TPN+" schlaegt mit voller Wucht mit "
              +ob->name(WEM,0)+" gegen die Kristallsaeule. "
               "Ploetzlich beginnen einige groessere Kristallbrocken von der "
               "Saeule herunterzubrechen und begraben Dich und "+TPN+" unter "
               "sich.\n"));
      ob->Damage(10);
      TP->do_damage(20+random(10));
      inv=all_inventory(find_object(TROPFST("khoehle10")));
      for (i=0;i<sizeof(inv);i++) 
        inv[i]->move(TROPFST("verschuettet"), M_GO|M_SILENT);
      SetProp(P_LOST, 1);
      return 1;
      }
    }
}

int verschuettet()
{
  return QueryProp(P_LOST);
}

