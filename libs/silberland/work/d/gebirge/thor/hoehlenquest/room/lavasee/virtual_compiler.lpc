inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../quest.h"

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, LAVA("") );
  SetProp(P_STD_OBJECT, LAVA("mhoehle"));
}

string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
     ("mhoehle"==name) &&
     (who==lower_case(who)))
    {
    SetProp(P_STD_OBJECT, LAVA(name));
    return file;
    }
}

int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",foo,who)!=2)
    return 0;
  return 1;
}




