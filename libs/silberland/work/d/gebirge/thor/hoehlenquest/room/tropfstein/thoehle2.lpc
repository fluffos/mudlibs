// Thor@SilberLand
// Eine Hoehle - thoehle2.c
// 1997-05-13

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Der Fels hier hat nun wieder eine gaenzlich normale Farbe. Er ist sogar "
   +"etwas heller, als man normalerweise annehmen wuerde. Das Gestein scheint "
   +"ziemlich kalkhaltig zu werden. Die Hoehlenwaende sind rund und glatt und "
   +"etwas feucht. An manchen Stellen tropft etwas Wasser von der Decke "
   +"herunter und Dir auf die Nase.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "fels",
             "Der Fels hat seine dunkle Faerbung hier nun entgueltig verloren "
            +"und scheint nun sogar ziemlich hell zu werden.");
  AddDetail( ({"farbe", "faerbung"}),
             "So wie der Fels zuvor aeusserst dunkel war, wird er jetzt umso "
            +"heller. Soweit Du erkennen kannst, kommt relativ viel Kalk in "
            +"dem Gestein hier vor.");
  AddDetail( ({"kalk", "gestein"}),
             "Du bist zwar kein Geologe, aber soweit Du erkennen kannst, "
            +"scheint das Gestein hier sehr kalkhaltig zu sein.");
  AddDetail( "geologe",
             "Weisst Du ueberhaupt, was das ist?");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Die Hoehlenwaende sind etwas feucht und ziemlich glatt. Es "
            +"sind keinerlei Risse oder Zacken zu erkennen.");
  AddDetail( ({"risse", "zacken"}),
             "Du kannst nichts dergleichen sehen.");
  AddDetail( "wasser",
             "Es ist ziemlich feucht hier. Manchmal tropft etwas Wasser von "
            +"der Decke herunter.");
  AddDetail( "nase",
             "Sie ist schon ganz feucht.");
  AddDetail( "decke",
             "Ein wenig Wasser tropft davon herunter.");
  AddDetail( "boden",
             "Auch der Boden ist feucht und schluepfrig. Pass besser auf, "
            +"dass Du nicht ausrutscht.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein wenig Wasser heruntertropfen.");
  AddSound( ({"wasser", "tropfen"}),
    "Es wirkt irgendwie beruhigend.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ziemlich feucht hier.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddItem( NPC("hwolf"), REFRESH_DESTRUCT);

  AddExit( "osten", TROPFST("thoehle1"));
  AddExit( "nordwesten", TROPFST("thoehle9"));
  AddExit( "norden", TROPFST("thoehle3"));
}
