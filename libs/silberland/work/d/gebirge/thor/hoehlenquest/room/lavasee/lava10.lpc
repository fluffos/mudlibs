*  Thor@SilberLand           *
*  Ein Lavablock - lava10.c  *
*  1997-08-08                *
*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Ein weiterer Lavablock erstreckt sich hier vor Dir. "
    "Richtung Suedosten fuehrt die Bruecke wieder zurueck, "
    "Richtung Westen und Nordosten kannst Du noch ein paar "
    "Schritte weiter gehen. Durch das heisse Lavagestein "
    "brennen Dir Deine Fussohlen und Du kommst Dir in "
    "dieser gluehenden Hitze vor, wie in einem Kochkessel. "
    "Allerdings waere es jetzt dann mal Zeit, die Flamme "
    "ein wenig zurueckzudrehen, denn schoen langsam bist "
    "Du dann naemlich schon gar.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"lavablock", "block", "lavabrocken", "brocken"}),
	     "Darauf stehst Du.");
  AddDetail( "bruecke",
	     "Das ist die Bruecke, die Du auch gekommen bist.");
  AddDetail( "schritte",
	     "Die Lavabrocken sind nicht RIESIGGROSS, aber nach "
	     "Westen und Nordosten kannst Du schon noch ein "
	     "wenig weitergehen.");
  AddDetail( ({"lavagestein", "gestein"}),
	     "Du kommst Dir beinahe vor, wie in einem gigantischen "
	     "Steinofen.");
  AddDetail( ({"ofen", "steinofen"}),
	     "\"Wuerde vielleicht einmal jemand so nett sein und "
	     "eine Stufe niedriger schalten?!\", denkst Du Dir.");
  AddDetail( ({"sohlen", "fussohlen"}),
	     "Sie haben bestimmt schon rote Brandblasen... AUA!");
  AddDetail( ({"blasen", "brandblasen"}),
	     "Es ist vielleicht besser, wenn Du Dir Deine Fuesse "
	     "woanders ankuckst.");
  AddDetail( "fuesse",
	     "Ja, sie tun weh! Aber jetzt sei nicht gleich so "
	     "verweichlicht!");
  AddDetail( ({"stufe", "flamme"}),
	     "Hallo! Jemand da, der die Hitze vielleicht mal ein "
	     "wenig zurueckdrehen koennte?");
  AddDetail( "hitze",
	     "Selbst eine halb so grosse Hitze wuerde immer noch "
	     "viel zu viel sein fuer Deinen Geschmack.");
  AddDetail( ({"kessel", "kochkessel"}),
	     "Ja, eigentlich muesstest Du jetzt schon gut durch "
	     "sein.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist hoellisch heiss.");
  AddDetail( ({"waende", "wand", "decke"}),
	     "Waende und Decke bestehen aus dunklem Lavagestein.");
  AddDetail( "lava",
	     "Die Lava brodelt tief unter Dir, wie ein schreckliches "
	     "Hoellenfeuer.");
  AddDetail( ({"hoellenfeuer", "feuer"}),
	     "Pass bloss auf, dass Du von dem Lavablock nicht "
	     "runterfaellst.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddExit( "westen", LAVA("lava11"));
  AddExit( "nordosten", LAVA("lava12"));
  AddExit( "suedosten", LAVA("bruecke7"));

}
