*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Die ganze Hoehle wird immer dichter von Kristallen bewachsen. An "
   +"Waenden und Decke siehst Du immer mehr Kristalle, nur noch selten "
   +"ist ein groesseres Stueckchen Fels zwischen den Buescheln von "
   +"Bergkristallen zu erkennen. Gleich neben Dir, im Osten, siehst Du eine "
   +"riesige Saeule bis zur Decke hinaufragen. Sie besteht gaenzlich aus "
   +"Kristall und hat einen Umfang von etwa fuenf Metern. Es erweckt den "
   +"Anschein, als wuerde sie beinahe die gesamte Decke hier stuetzen. "
   +"Obwohl die Kristalle der Saeule glasklar sind, kannst Du nicht durch "
   +"sie hindurchsehen, weil sie in den verschiedensten geometrischen Formen "
   +"zusammengewachsen sind und so das Licht auf die verschiedensten Weisen "
   +"brechen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Immer mehr Kristalle siehst Du an den Hoehlenwaenden und der "
            +"Decke. Selten schimmert noch ein groesserer, grauer Felsfleck "
            +"durch die funkelnde Pracht durch.");
  AddDetail( ({"gestein", "fels", "felsfleck", "stueckchen"}),
             "Ab und zu siehst Du noch ein Stueckchen Gestein an den Waenden, "
            +"ansonsten ist alles ueberfuellt mit praechtigen "
            +"Bergkristallen.");
  AddDetail( "pracht",
             "Die vielen Bergkristalle tauchen die Hoehle in eine "
            +"maerchenhafte, glitzernde Pracht.");
  AddDetail( ({"waende", "hoehlenwaende", "decke"}),
             "Waende und Decke sind fast vollkommen mit Kristallen bedeckt.");
  AddDetail( ({"boden", "hoehlenboden"}),
             "Sogar am Hoehlenboden siehst Du vereinzelt einige "
            +"Kristallbueschel festgewachsen.");
  AddDetail( ({"kristalle", "bergkristalle"}),
             "Die Bergkristalle sind glasklar. An den meisten Stellen sind "
            +"sie bereits zu ganzen Buescheln zusammengewachsen.");
  AddDetail( "stellen",
             "Fast ueberall sind die vielen Kristalle zu ganzen "
            +"Kristallbuescheln zusammengewachsen.");
  AddDetail( ({"bueschel", "kristallbueschel"}),
             "Die Kristallbueschel reflektieren das Licht in den "
            +"verschiedensten Farben und verleihen so der Hoehle ein buntes "
            +"Funkeln.");
  AddDetail( ({"farben", "funkeln"}),
             "Durch die Kristalle funkelt die Hoehle in den verschiedensten "
            +"Farben.");
  AddDetail( ({"saeule", "kristallsaeule"}),
             "Die Kristallsaeule neben Dir hat einen Umfang von etwa fuenf "
            +"Metern. Sie ragt etwa vier Meter bis zur Decke hinauf und "
            +"scheint auch einen Grossteil dieser zu tragen. Sie besteht aus "
            +"Hunderten von Kristallen, die ueber Jahrhunderte, vielleicht "
            +"sogar Jahrtausende zusammengewachsen sind. Die vielen Kristalle "
            +"brechen das Licht auf komplexe Art und Weise, darum kannst Du "
            +"auch nicht durch die Saeule durchsehen, obwohl die Kristalle "
            +"glasklar sind.");
  AddDetail( "kristall",
             "Die Saeule besteht vollkommen aus Kristall.");
  AddDetail( "umfang",
             "Die Kristallsaeule hat einen Umfang von etwa fuenf Metern.");
  AddDetail( "anschein",
             "Die riesige Kristallsaeule erweckt beinahe den Anschein, dass "
            +"ohne sie fast die gesamte Decke einstuerzen wuerde.");
  AddDetail( "grossteil",
             "Ein Grossteil der Decke hier scheint von der Kristallsaeule "
            +"getragen zu werden.");
  AddDetail( ({"jahrhunderte", "jahrtausende", "jahre"}),
             "Es braucht bestimmt Hunderte, wenn nicht sogar Tausende von "
            +"Jahren, um ein solch beeindruckendes, natuerliches Werk "
            +"entstehen zu lassen.");
  AddDetail( ({"werk", "natur"}),
             "Selbst die Natur braucht fuer ein solch gigantisches Werk "
            +"wahrscheinlich Tausende von Jahren.");
  AddDetail( ({"formen", "form"}),
             "Die unzaehligen Kristalle in der Saeule sind zu allen nur "
            +"erdenklichen geometrischen Formen zusammengewachsen.");
  AddDetail( ({"licht", "variationen"}),
             "Das Licht wird von der Kristallsaeule in hunderten von "
            +"Variationen gebrochen und laesst so die Hoehle maerchenhaft "
            +"funkeln.");
  

  AddSound( DEFAULT_SOUND,
    "Du hoerst einige kleine Kristalle unter Deinen Sohlen knirschen.");
  AddSound( ({"kristalle", "sohlen"}),
    "Pass besser auf, das Du nicht zuviel von all der Pracht zertrittst.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl hier in der Hoehle.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd(({"raeume", "raeum"}), "befreiung");

  AddExit( "nordosten", TROPFST("khoehle11"));
  AddSpecialExit( "suedosten", "haufen");
  AddExit( "sueden", TROPFST("khoehle8"));
  AddExit( "suedwesten", TROPFST("khoehle6"));
}

int haufen()
{
  int schutt;

  schutt=(int)call_other("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc", "verschuettet");
  if(schutt==0)
    return this_player()->move(TROPFST("khoehle10"), M_GO);
  else
    {
    write(BS("Der Weg nach Suedosten ist durch einen riesigen Kristallhaufen "
            +"versperrt. Du glaubst, leise Stimmen daraus hoeren zu "
            +"koennen. Vielleicht kannst Du den Weg ja wieder "
            +"freiraeumen.\n"));
    return 1;
    }
}

befreiung(str)
{
  object ob, inv;
  int i;
  ob=find_object("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc");

  notify_fail("Was willst Du freiraeumen?\n");
  if(str=="weg frei"||str=="haufen weg"||str=="kristallhaufen weg")
    {
    if((ob->QueryProp(P_LOST))==0)
      {
      write(BS("Hier gibt es nichts zum wegraeumen.\n"));
      return 1;
      }
    else
      {
      write(BS("Mit all Deinen Kraeften beginnst Du, den grossen Kristallhaufen "
              +"wegzuraeumen. Stueck fuer Stueck wird der Haufen kleiner und "
              +"schliesslich ist der Weg nach Suedosten wieder frei.\n"));
      say(BS(CAP_TPN+" raeumt den grossen Kristallhaufen weg, der den Weg nach "
              +"Suedosten versperrt hat.\n"));
      inv=all_inventory(find_object(TROPFST("verschuettet")));
      for (i=0;i<sizeof(inv);i++)
	{
	tell_object(inv[i], "Ploetzlich hoerst Du "
        +"Geraeusche von aussen, es sieht fast so aus, als wuerde Dich "
        +"jemand befreien. Ja, tatsaechlich! Schnell kletterst Du aus dem Rest "
        +"des Haufens heraus.\n"); 
        inv[i]->move(TROPFST("khoehle10"), M_GO|M_SILENT);
        }
      ob->SetProp(P_LOST, 0);
      return 1;
      }
    }
  else
    return 0;
}

