******************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst hier an der oestlichen Seite der Kristallsaeule. Sie ist "
   +"ziemlich glatt auf dieser Seite, nur ab und zu sieht man einige "
   +"Kristalle aus der glatten, kristallinen Oberflaeche herausragen. Auch "
   +"das restliche Bild der Hoehle wird immer maerchenhafter. Immer dichter "
   +"sind die Waende mit dicken, grossen Kristallen bewachsen, und man sieht "
   +"kaum mehr graue Felsflecke dazwischen. Lediglich am Boden ueberwiegt "
   +"noch der Fels, aber selbst da siehst Du immer mehr Kristalle. Richtung "
   +"Suedosten zweigt ein schmaler Gang ab.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "seite",
             "Du stehst auf der oestlichen Seite der Kristallsaeule, das "
            +"heisst, die Saeule ist westlich von Dir.");
  AddDetail( ({"saeule", "kristallsaeule"}),
             "Die Kristallsaeule ist hier ziemlich glatt, nur manchmal "
            +"ragen einige Kristalle aus der Oberflaeche hervor.");
  AddDetail( ({"oberflaeche", "flaeche"}),
             "Die Oberflaeche der Kristallsaeule besteht, so wie auch "
            +"der Rest davon, aus Kristall.");
  AddDetail( ({"kristalle", "bergkristalle", "kristall"}),
             "An Waenden und Decke siehst Du beinahe nur noch Bergkristalle, "
            +"nur ganz wenig graues Gestein ist zwischen den Buescheln von "
            +"Kristallen zu entdecken.");
  AddDetail( ({"bueschel", "kristallbueschel"}),
             "Die Kristalle sind meistens zu grossen Buescheln "
            +"zusammengewachsen.");
  AddDetail( ({"bild", "eindruck"}),
             "Die Hoehle macht einen wirklich maerchenhafen Eindruck.");
  AddDetail( "hoehle",
             "Du weisst schon gar nicht mehr, wo Du hinsehen sollst, vor "
            +"lauter Schoenheit.");
  AddDetail( "schoenheit",
             "Die Schoenheit dieser Hoehle ist wirklich atemberaubend.");
  AddDetail( ({"felsflecke", "flecke", "gestein", "fels", "fleckchen"}),
             "Nur manchmal sieht man zwischen den vielen Kristallen ein "
            +"kleines, graues Fleckchen Gestein.");
  AddDetail( "boden",
             "Am Boden ist vorwiegend doch noch mehr Fels als Kristall.");
  AddDetail( "decke",
             "Von der Decke haengen unzaehlige grosse Kristalle herab.");
  AddDetail( ({"waende", "wand"}),
             "Die Waende sind dicht mit Kristallen bewachsen.");
  AddDetail( "gang",
             "Er fuehrt nach Suedosten.");
  AddSpecialDetail( ({"kristallhaufen", "haufen"}), "unt_haufen");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Knirschen, wie Du einige Kristalle am Boden "
   +"beim Gehen zusammentrittst.");
  AddSound( "knischen",
    "Pass lieber auf, dass Du nicht zu viele zusammentrittst.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl hier drinnen.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd(({"raeume", "raeum"}), "befreiung");

  AddExit( "nordwesten", TROPFST("khoehle11"));
  AddSpecialExit( "suedwesten", "haufen");
  AddExit( "suedosten", TROPFST("khoehle13"));
}

int haufen()
{
  int schutt;

  schutt=(int)call_other("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc", "verschuettet");
  if(schutt==0)
    return this_player()->move(TROPFST("khoehle10"), M_GO);
  else
    {
    write(BS("Der Weg nach Suedwesten ist durch einen riesigen Kristallhaufen "
            +"versperrt. Du glaubst, leise Stimmen daraus hoeren zu "
            +"koennen. Vielleicht kannst Du den Weg ja wieder "
            +"freiraeumen.\n"));
    return 1;
    }
}

string unt_haufen()
{
  int schutt;

  schutt=(int)call_other("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc", "verschuettet");
  if(schutt==0)
    return "Sowas siehst Du hier nicht!\n";
  else
    return "Der Weg nach Suedwesten ist durch einen grossen Kristallhaufen "
          +"versperrt.\n";
}

befreiung(str)
{
  object ob, inv;
  int i;
  ob=find_object("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc");

  notify_fail("Was willst Du freiraeumen?\n");
  if(str=="weg frei"||str=="haufen weg"||str=="kristallhaufen weg")
    {
    if((ob->QueryProp(P_LOST))==0)
      {
      write(BS("Hier gibt es nichts zum wegraeumen.\n"));
      return 1;
      }
    else
      {
      write(BS("Mit all Deinen Kraeften beginnst Du, den grossen Kristallhaufen "
              +"wegzuraeumen. Stueck fuer Stueck wird der Haufen kleiner und "
              +"schliesslich ist der Weg nach Suedwesten wieder frei.\n"));
      say(BS(CAP_TPN+" raeumt den grossen Kristallhaufen weg, der den Weg nach "
              +"Suedwesten versperrt hat.\n"));
      inv=all_inventory(find_object(TROPFST("verschuettet")));
      for (i=0;i<sizeof(inv);i++)
	{
	tell_object(inv[i], "Ploetzlich hoerst Du "
        +"Geraeusche von aussen, es sieht fast so aus, als wuerde Dich "
        +"jemand befreien. Ja, tatsaechlich! Schnell kletterst Du aus dem Rest "
        +"des Haufens heraus.\n"); 
        inv[i]->move(TROPFST("khoehle10"), M_GO|M_SILENT);
        }
      ob->SetProp(P_LOST, 0);
      return 1;
      }
    }
  else
    return 0;
}








