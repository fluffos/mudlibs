// Thor@SilberLand
// Ein Loch in die Tiefe - loch6.c
// 1997-04-29

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Je weiter Du die Stufen hinuntersteigst, umso baufaelliger werden sie. "
    "Am Fusse der Wand auf der rechten Seite liegt ziemlich viel Geroell "
    "herum, sodass die Treppe immer schmaeler wird. Auch auf den Stufen "
    "selber liegen Felsbrocken herum und es wird immer schwieriger, dem Weg "
    "nach unten zu folgen, ohne in die Tiefe zu stuerzen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "stufen",
             "Die Stufen werden immer baufaelliger und Du musst immer mehr "
             "achtgeben, um nicht zu stolpern.");
  AddDetail( ({"wand", "fuss", "fusse", "felswand"}),
             "Am Fusse der Wand liegt etwas Geroell herum, wodurch die Treppe "
             "noch ein wenig schmaeler wird, als sie es ohnehin schon ist.");
  AddDetail( "geroell",
             "Etwas Geroell, das sich ueber den Lauf der Jahrhunderte "
             "angehaeuft hat, liegt am Fusse der Felswand.");
  AddDetail( "jahrhunderte",
             "Die Hoehle hier unten ist bestimmt schon uralt, einige "
             "Jahrhunderte werden da wahrscheinlich nicht ausreichen.");
  AddDetail( "hoehle",
             "Die Hoehle hier ist bestimmt aelter als Du.");
  AddDetail( "seite",
             "An der Wand auf der rechten Seite liegt etwas Geroell herum.");
  AddDetail( "treppe",
             "Die Treppe wird immer bruechiger, je weiter Du in die Tiefe "
             "steigst. Durch das Geroell auf der Seite ist sie noch ein wenig "
             "schmaeler geworden, als sie vorhin schon war.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Auf den Stufen liegen einige Felsbrocken herum. Der Abstieg "
             "wird dadurch immer schwieriger und Du musst wirklich aufpassen, "
             "damit Du nicht stolperst und in den Abgrund stuerzt.");
  AddDetail( ({"tiefe", "abgrund"}),
             "Der Abgrund neben Dir scheint kein Ende zu nehmen. Pass lieber "
             "auf, dass Du auf den baufaelligen Stufen nicht stolperst und "
             "hinunterfaellst. Es wuerde wahrscheinlich nicht sehr viel von "
             "Dir uebrig bleiben.");
  AddDetail( "boden",
             "Der Boden unter Dir ist auesserst unsicher.");
  AddDetail( "waende",
             "Die Waende sind aus schwarzem Fels.");
  AddDetail( "fels",
             "Hier besteht alles aus schwarzem Fels.");
  AddDetail( "decke",
             "Die kannst Du von hier aus nicht mehr erkennen.");
  AddDetail( "weg",
             "Der Weg nach unten wird immer unbegehbarer.");
  AddDetail( "abstieg",
             "Der Abstieg in die Tiefe erweist sich als schwieriger als "
             "erwartet.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht tiefste Stille.");
  AddSound( "stille",
    "Du hoerst absolut nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "suedwestunten", HOEHLE("loch7"));
  AddExit( "suedostoben", HOEHLE("loch5"));
  AddExit( "suedwesten", HOEHLE("loch7"));
  AddExit( "suedosten", HOEHLE("loch5"));
  SetProp (P_HIDE_EXITS, ({"suedosten", "suedwesten"}) );

}

