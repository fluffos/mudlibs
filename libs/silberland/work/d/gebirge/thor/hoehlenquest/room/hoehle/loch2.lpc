// Thor@SilberLand
// Ein Loch in die Tiefe - loch2.c
// 1997-04-24

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Du bist hier auf der Treppe, die ein gutes Stueck in die Tiefe fuehrt. "
   +"Die Stufen unter Deinen Fuessen sind bruechig und alles andere als "
   +"sicher zu betreten. Du bist etwas beunruhigt, weil Du nirgends auch nur "
   +"den geringsten Halt mit Deinen Haenden finden kannst.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "treppe",
             "Die Treppe fuehrt die Waende entlang spiralfoermig in die "
            +"Tiefe.");
  AddDetail( ({"stueck", "tiefe"}),
             "Du kannst von hier aus nicht erkennen, wie weit nach unten "
            +"diese Treppe hier fuehrt.");
  AddDetail( "stufen",
             "Die Stufen unter Deinen Fuessen sind ziemlich unsicher. Es ist "
            +"wohl besser, wenn Du rasch nach unten gehst, bevor noch etwas "
            +"von den Stufen abbroeckelt.");
  AddDetail( "fuesse",
             "Du stehst auf ziemlich unsicherem Boden.");
  AddDetail( ({"halt", "haende"}),
             "Du kannst nicht den geringsten Halt mit den Haenden an der Wand "
            +"finden.");
  AddDetail( ({"wand", "waende"}),
             "Die Waende sind ziemlich glatt und bestehen aus schwarzem Fels. "
            +"Die Hoehle scheint hier nicht mehr kuenstlich geschaffen zu "
            +"sein sondern ab hier einen natuerlichen Ursprung zu haben.");
  AddDetail( "ursprung",
             "Die Waende sind glatt und nicht mehr so rauh, wie in der Hoehle "
            +"zuvor. Die Hoehle ist ab hier wohl natuerlichen Ursprungs.");
  AddDetail( "fels",
             "Der Fels ist pechschwarz und die Dunkelheit wird dadurch noch "
            +"erdrueckender als sie es zuvor schon war.");
  AddDetail( ({"dunkelheit", "finsternis"}),
             "Deine Fackel leuchtet nur einige Meter weit, dann wird der "
            +"Lichtschimmer von dem schwarzen Gestein verschluckt.");
  AddDetail( "fackel",
             "Sie leuchtet nur so weit, dass Du Deine naechste Umgebung "
            +"erkennen kannst.");
  AddDetail( "umgebung",
             "Sie ist ziemlich finster.");
  AddDetail( "gestein",
             "Das Gestein scheint hier sehr hart zu sein. Trotzdem sind die "
            +"Stufen teilweise zerbroeckelt und verfallen.");
  AddDetail( "decke",
             "Die Decke ueber Dir besteht aus schwarzem Fels.");
  AddDetail( "boden",
             "Du stehst auf aeusserst unsicherem Boden. Es ist wohl besser, "
            +"wenn Du rasch weiter gehst, bevor noch mehr von der Treppe "
            +"abbroeckelt.");
  AddDetail( "hoehle",
             "Die Hoehle hier scheint nun natuerlichen Ursprungs zu sein. ");
  AddDetail( ({"schimmer", "lichtschimmer"}),
             "Der Lichtschimmer der Fackel wird nach einigen Metern von der "
            +"Finsternis verschluckt.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht tiefste Stille.");
  AddSound( "stille",
    "Du hoerst absolut nichts.");
  
  AddSmell( DEFAULT_SMELL,
    "Aus der Tiefe dringt ein kuehler Luftzug herauf.");
  AddSmell( ({"luftzug", "luft"}),
    "Du atmest tief die kuehle Luft ein.");

  AddExit( "nordwesten", HOEHLE("loch1"));
  AddExit( "suedwestunten", HOEHLE("loch3"));
  AddExit( "suedwesten", HOEHLE("loch3"));
  SetProp (P_HIDE_EXITS, ({"suedwesten"}) );

}

