#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst hier am oestlichen Rand der Lavahoehle. Rings um Dich "
    "siehst Du teils groessere, teils kleinere Lavabrocken aus der "
    "Magma herausragen. Ein Stueckchen weg von dem Block, auf dem Du "
    "gerade stehst, ragt ein groesserer Lavabrocken hervor. Er ist "
    "zwar ziemlich weit weg, aber Du koenntest es vielleicht schaffen, "
    "hinueberzuspringen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 50]) );

  AddDetail( "rand",
	     "Das hier ist der oestliche Rand der Lavahoehle. Die "
	     "Hoehlenwand ist nicht allzuweit weg, durch die Hitze "
	     "jedoch ist sie ganz verschwommen. Gleich vor Dir faellt "
	     "der Felsblock jaeh in die Lava hinab. Pass besser auf, "
	     "dass Du da nicht runterfaellst.");
  AddDetail( ({"hoehlenwand", "wand", "waende"}),
	     "Die Ostwand der Hoehle ist nicht allzuweit weg von hier.");
  AddDetail( "ostwand",
	     "Welche Ueberraschung! Sie ist oestlich von Dir.");
  AddDetail( "hitze",
	     "Die unglaubliche Hitze laesst alles ganz verschwommen "
	     "erscheinen hier.");
  AddDetail( ({"stueckchen", "stueck"}),
	     "Ein Stueck weiter weg ragt ein groesserer Felsbrocken aus der "
	     "Lava heraus.");
  AddDetail( ({"hoehle", "lavahoehle"}),
	     "Da bist Du gerade.");
  AddDetail( ({"block", "felsblock", "lavablock"}),
	     "Gleich neben dem Lavablock, auf dem Du stehst, ragt ein "
	     "etwas groesserer Felsbrocken aus der Lava heraus.");
  AddDetail( ({"brocken", "lavabrocken", "felsbrocken"}),
	     "Rings um Dich siehst Du einige Lavabrocken aus der Magma "
	     "herausragen. Es scheint fast so, als seien von diesem Block "
	     "hier einmal kleinere Teile abgesplittert. Ein besonders "
	     "grosser liegt gleich in Deiner Naehe. Es koennte sich gerade "
	     "noch ausgehen, hinueberzuspringen.");
  AddDetail( ({"lava", "magma"}),
	     "Die brodelt tief unter Dir.");
  AddDetail( "teile",
	     "Es sind wohl einmal kleinere Teile von dem Lavablock hier "
	     "abgesplittert und nun liegen sie unten in der Magma herum.");
  AddDetail( "naehe",
	     "In Deiner Naehe ist ein etwas groesserer Felsbrocken. Du "
	     "koenntest mal versuchen, hinueberzuspringen.");
  AddDetail( "boden",
	     "Der Boden besteht aus dunkelfaerbigem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkles Lavagestein, nichts besonderes.");
  AddDetail( "decke",
	     "Die Decke hoch ueber Dir ist durch die Hitze ganz verschwommen. "
	     "Du kannst nichts genaueres daran erkennen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddCmd( ({"springe", "spring"}), "brocken");

  AddExit( "nordwesten", LAVA("lava9"));
  AddExit( "westen", LAVA("lava6"));
}

brocken( str )
{
  notify_fail("Wo willst Du hinspringen?\n");
  if(str=="auf felsbrocken"||str=="zu felsbrocken"
     ||str=="auf brocken"||str=="zu brocken"||str=="zu brocken hinueber")
    {
    write(BS("Du nimmst ein wenig Anlauf und springst kraeftig von der "
	    +"Kante weg. Einen Augenblick bleibt Dir das Herz stehen, "
	    +"doch dann hast Du wieder festen Boden unter den Fuessen.\n"));
    TP->move(LAVA("fbrocken"), M_GO, "", "nimmt Anlauf und springt mit einem "
	  +"grossen Satz zu einem nahegelegenem Felsbrocken", 
	  "plumpst auf den Boden");
    return 1;
    }
  else
    return 0;
}










