#include "../quest.h"

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "raeume"

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, LAVA(""));
  SetProp(P_STD_OBJECT, LAVA("mhoehle"));
  SetProp(P_ROOMS, ({"mhoehle"}));
}

string Validate(string file)
{
  string path, name, wer;

  file=::Validate(file);
  if((sscanf(file, "%s:%s", name, wer)==2) &&
     (member(QueryProp(P_ROOMS), name)!=-1))
    {
    SetProp(P_STD_OBJECT, LAVA(name));
    return file;
    }
}

int CustomizeObject()
{
  string name, raum, wer;

  if(!(name=::CustomizeObject())||sscanf(name, "%s:%s", raum, wer)!=2)
    return 0;
//  if(raum=="khoehle15")
//    previous_object()->AddExit("westen", TROPFST("khoehle14:"+wer));
  return 1;
}




