****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Du stehst hier auf dem oestlichsten Lavablock der Hoehle. "
    "Suedwestlich von Dir geht eine Bruecke weg, die wohl wieder "
    "zurueck zum Eingang der Lavahoehle fuehrt. Der Lavablock, "
    "auf dem Du stehst, scheint ziemlich gross zu sein. Die "
    "enorme Hitze hier macht Dir schwer zu schaffen und das "
    "Atmen faellt Dir durch die aeusserst schwefelhaltige Luft "
    "ziemlich schwer.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"block", "lavablock"}),
	     "Wenn Du Dich in der Hoehle ein wenig umblickst, siehst "
	     "Du hier und da einige grosse Lavabloecke aus dem Magma "
	     "herausragen. Du stehst hier auf einem davon.");
  AddDetail( ({"lavabloecke", "bloecke"}),
	     "Die sind in der ganzen Hoehle verstreut.");
  AddDetail( ({"lavahoehle", "hoehle"}),
	     "Wohin Du in dieser Hoehle nur blickst, Du siehst nur "
	     "heisse, brodelnde Lava, die sich etwa zwanzig Meter "
	     "unter Dir befindet.");
  AddDetail( ({"magma", "lava"}),
	     "Das Magma brodelt gluehend heiss tief unter Dir.");
  AddDetail( "bruecke",
	     "Ueber die Bruecke im Suedwesten kommst Du wohl wieder "
             "zum Eingang der Hoehle zurueck.");
  AddDetail( "eingang",
	     "Der befindet sich suedwestlich von Dir.");
  AddDetail( "hitze",
	     "Du weisst nicht, wie Du diese Hitze ueber einen laengeren "
             "Zeitraum hinweg aushalten solltest.");
  AddDetail( ({"zeit", "zeitraum"}),
	     "Ueber kurz oder lang wirst Du in dieser Hitze wahrscheinlich "
             "ohnmaechtig werden.");
  AddDetail( "atmen",
	     "Die schwefelhaltige Luft brennt Dir in der Kehle und den "
             "Lungen und macht Dir dadurch das Atmen zur Qual.");
  AddDetail( "kehle",
	     "Deine Kehle ist ganz trocken und rauh. Was wuerdest Du "
             "jetzt nur fuer einen Tropfen kuehlen Nass geben.");
  AddDetail( ({"tropfen", "nass", "wasser"}),
	     "Ja, ein Tropfen Wasser, das waere jetzt etwas feines.");
  AddDetail( ({"lunge", "lungen"}),
	     "Deine Lungen schmerzen durch die scharfe, schwefelhaltige "
             "Luft bei jedem Atemzug.");
  AddDetail( "atemzug",
	     "Jeder einzelne Atemzug ist eine Qual.");
  AddDetail( "qual",
	     "Warum tust Du Dir soetwas an? Dreh doch besser einfach um.");
  AddDetail( "luft",
	     "Durch den vielen Schwefel erscheint Dir die Luft so dick, "
	      "dass man sie beinahe schneiden kann.");
  AddDetail( "schwefel",
	     "Der Schwefel ist scharf und stinkt erbaermlich.");
  AddDetail( "boden",
	     "Der Boden brennt heiss unter Deinen Fuessen.");
  AddDetail( "fuesse",
	     "Sie schmerzen furchtbar.");
  AddDetail( ({"decke", "waende", "wand"}),
	     "Decke und Waende bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddExit( "nordwesten", LAVA("lava8"));
  AddExit( "osten", LAVA("lava7"));
  AddExit( "suedwesten", LAVA("bruecke5"));
  AddExit( "norden", LAVA("lava9"));

}
