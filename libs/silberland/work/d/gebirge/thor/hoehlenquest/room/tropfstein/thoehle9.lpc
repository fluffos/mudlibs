// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle9.c
// 1997-05-21

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Du gehst tiefer in die Tropfsteinhoehle hinein. Du bist ueberwaeltigt "
   +"von dem Anblick, der sich Dir bietet. Die Hoehle sieht aus, wie ein "
   +"riesiger, steinerner Wald, von dem die Baeume nicht nur von unten nach "
   +"oben, sondern auch von oben nach unten wachsen. Alles schimmert und "
   +"glitzert von der Feuchtigkeit, und laesst Dich mit offenem Mund "
   +"dastehen und staunen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"tropfsteinhoehle", "hoehle"}),
             "Die Tropfsteinhoehle breitet sich noch weiter nach Westen aus.");
  AddDetail( ({"anblick", "umgebung"}),
             "Der Anblick, der sich Dir bietet, ist wirklich atemberaubend. "
            +"Alles schimmert und glaenzt und gibt Dir das Gefuehl, in einem "
            +"Maerchen zu stehen.");
  AddDetail( ({"maerchen", "gefuehl"}),
             "Du hast das Gefuehl, in einem wunderschoenen Maerchen zu sein, "
            +"so fasziniert bist zu von Deiner Umgebung.");
  AddDetail( "wald",
             "Du stehst staunend in einem Wald von Stalagmiten und "
            +"Stalaktiten. Die Tropfsteine sind so dicht gewachsen, dass "
            +"nur hie und da ein Durchgang moeglich ist.");
  AddDetail( ({"gang", "durchgang"}),
             "Du kannst Richtung Westen weitergehen.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Sie erinnern Dich an lange, duenne Baeume.");
  AddDetail( "baeume",
             "Die Stalaktiten und Stalagmiten sehen aus, wie lange, duenne "
            +"Baeume.");
  AddDetail( "stalagmiten",
             "Die Stalagmiten wachsen von unten nach oben.");
  AddDetail( "stalaktiten",
             "Die Stalaktiten wachsen von oben nach unten.");
  AddDetail( ({"feuchtigkeit", "licht"}),
             "Durch die Feuchtigkeit in der ganzen Hoehle schimmert und "
            +"glaenzt alles im Licht.");
  AddDetail( "mund",
             "Jetzt kannst ihn mal wieder zumachen.");
  AddDetail( "decke",
             "Von der Decke wachsen unzaehlige Stalaktiten herab.");
  AddDetail( "boden",
             "Er ist ganz feucht und glitschig.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Die Hoehlenwaende glaenzen ganz feucht.");
  AddDetail( "wasser",
             "Manchmal tropft etwas Wasser von der Decke herab."); 

  AddSound( DEFAULT_SOUND,
    "Leise hoerst Du das Tropfen des Wassers.");
  AddSound( ({"wasser", "tropfen"}),
    "*tropf* *tropf* *tropf*");  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm feucht.");
  AddSmell ("luft",
    "Du atmest einmal tief durch.");

  AddExit( "osten", TROPFST("thoehle3"));
  AddExit( "nordosten", TROPFST("thoehle4"));
  AddExit( "suedosten", TROPFST("thoehle2"));
  AddExit( "westen", TROPFST("thoehle10"));
  AddExit( "suedwesten", TROPFST("thoehle11"));
}

