*  Thor@SilberLand               *
*  Ein Hoehlengang - khoehle2.c  *
*  1997-06-15                    *
*********************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Hoehlengang" );
  SetProp( P_INT_LONG,
    "Der Gang, in dem Du Dich befindest, ist noch nicht allzu breit und "
   +"hoch, er scheint sich jedoch Richtung Nordosten zunehmend zu erweitern. "
   +"Waende und Decke sind ziemlich glatt, man kann keinerlei schroffe "
   +"Felszacken oder Ritzen im Gestein erkennen. Der Boden ist sogar beinahe "
   +"glaenzend blank. Vor Hunderten von Jahren scheinen hier viele Zwerge "
   +"darueber gelaufen zu sein.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gang", "hoehlengang"}),
             "Der Hoehlengang scheint sich Richtung Nordosten hin zu "
            +"erweitern.");
  AddDetail( "hoehle",
             "Es waere vielleicht ein bisschen uebertrieben, zu sagen, Du "
            +"waerst hier in einer Hoehle. Hoehlengang waere da schon etwas "
            +"zutreffender.");
  AddDetail( ({"waende", "hoehlenwaende", "felswaende"}),
             "Die Waende sehen ziemlich glatt aus. Sie erwecken nicht den "
            +"Eindruck, als waeren sie aus dem Fels herausgeschlagen, sondern "
            +"scheinen eher natuerlichen Ursprungs zu sein.");
  AddDetail( "eindruck",
             "Du hast nicht den Eindruck, als waere dieser Gang hier von "
            +"Zwergenhand erschaffen worden.");
  AddDetail( "ursprung",
             "Der Hoehlengang ist eindeutig natuerlichen Ursprungs. Dies "
            +"ist ja auch nicht weiter verwunderlich, denn wer wuerde schon "
            +"auf die Idee kommen, so tief unten ein derart weitlaeufiges "
            +"Hoehlensystem aus dem Fels zu schlagen.");
  AddDetail( ({"system", "hoehlensystem"}),
             "Du fragst Dich, wieviel Du wohl schon von dem ganzen "
            +"Hoehlensystem gesehen hast. Hoffentlich findest Du wieder den "
            +"Weg zurueck.");
  AddDetail( ({"weg", "rueckweg"}),
             "Den ganzen Weg wieder zurueckzulaufen wird wohl ziemlich "
            +"muehselig werden.");
  AddDetail( "decke",
             "Die Decke ueber Dir ist ziemlich glatt und regelmaessig, so "
            +"wie die Waende auch.");
  AddDetail( ({"felszacken", "zacken"}),
             "Du kannst nirgends irgendwelche Unregelmaessigkeiten im "
	     +"Gestein erkennen.");
  AddDetail( "ritzen",
             "Decke, Waende und Boden sind an keiner ersichtlichen Stelle "
            +"von Ritzen oder dergleichen durchzogen.");
  AddDetail( "unregelmaessigkeiten",
             "Ich sagte doch schon, dass Du nirgends welche erkennen kannst.");
  AddDetail( ({"gestein", "fels"}),
             "Das Gestein hat ein graue bis dunkelgraue Farbe.");
  AddDetail( "farbe",
             "Das Gestein ist hier etwas heller als im Labyrinth.");
  AddDetail( "labyrinth",
             "Du denkst noch nicht naeher ueber den Rueckweg durch das "
            +"oede Labyrinth nach.");
  AddDetail( "boden",
             "Der Boden ist aeusserst glatt, so als ob vor vielen Jahren "
            +"hier viele Leute hin und her gelaufen waeren.");
  AddDetail( "leute",
             "Du haettest nichts gegen ein wenig Gesellschaft einzuwenden, "
            +"die Totenstille so tief unten ist doch etwas erdrueckend.");
  AddDetail( "zwerge",
             "Bestimmt haben sich vor langer Zeit hauptsaechlich Zwerge hier "
            +"unten aufgehalten.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Du hoerst absolut nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl hier unten.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "westen", TROPFST("khoehle1"));
  AddExit( "nordosten", TROPFST("khoehle3"));
}

