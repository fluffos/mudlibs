// Thor@SilberLand
// Ein Loch in die Tiefe - loch4.c
// 1997-04-25

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Die Treppe, die Du entlang gehst, wird nicht gerade stabiler, je weiter "
    "Du nach unten kommst. Immer mehr Risse durchziehen die Stufen und Du "
    "musst immer mehr aufpassen, wo Du hintrittst, um nicht zu stolpern. Die "
    "Waende neben Dir sind schwarz und glatt, sodass sie keinerlei Halt "
    "bieten.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "treppe",
             "Die Treppe wird nicht gerade angenehmer zu begehen, je weiter "
             "Du in die Tiefe gehst. Immer unregelmaessiger werden die Stufen "
             "und Du musst grosse Acht geben, damit Du nicht ausrutscht und "
             "in die Tiefe stuerzt.");
  AddDetail( "stufen",
             "Die Stufen werden von immer groesseren Rissen durchzogen und "
             "auch immer mehr lockeres Gestein liegt am Boden herum.");
  AddDetail( "risse",
             "Die Risse in den Stufen werden immer tiefer.");
  AddDetail( "tiefe",
             "Neben Dir fuehrt ein Abgrund in die Tiefe. Es ist nicht zu "
             "erahnen, wie weit es hier noch hinuntergehen mag.");
  AddDetail( "abgrund",
             "Pass bloss auf, dass Du nicht hinunterstuerzt.");
  AddDetail( "acht",
             "Du gibst besser grosse Acht, damit Du nicht den Halt mit den "
             "Beinen verlierst und hinunter stuerzt.");
  AddDetail( "beine",
             "Der Boden unter Deinen Beinen ist nicht sehr sicher.");
  AddDetail( "halt",
             "Die Waende neben Dir sind ziemlich glatt, sodass sie Dir "
             "keinerlei Halt bieten.");
  AddDetail( "waende",
             "Die Waende sind glatt und bestehen aus schwarzem Fels.");
  AddDetail( ({"fels", "gestein"}),
             "Der Fels ist hier ueberall schwarz gefaerbt. Trotz der "
             "bruechigen Stufen ist er doch sehr hart.");
  AddDetail( "boden",
             "Du hast nur sehr wenig Boden unter Deinen Beinen, und auch "
             "dieser ist nicht sehr sicher.");
  AddDetail( "decke",
             "Du kannst die Decke von hier aus kaum mehr erkennen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Du hoerst nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und riecht nach gar nichts.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordostunten", HOEHLE("loch5"));
  AddExit( "nordosten", HOEHLE("loch5"));
  AddExit( "nordwestoben", HOEHLE("loch3"));
  AddExit( "nordwesten", HOEHLE("loch3"));
  SetProp (P_HIDE_EXITS, ({"nordwesten", "nordosten"}) );

}

