// Thor@SilberLand
// Ein Loch in die Tiefe - loch3.c
// 1997-04-25

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Die Treppe, auf der Du stehst, ist hier noch einigermassen begehbar. "
   +"Trotzdem solltest Du doch aufpassen, wo Du hintrittst, denn die Stufen "
   +"sind doch schon ziemlich verfallen und Du koenntest leicht stolpern. "
   +"Neben Dir fuehrt ein scheinbar bodenloser Abgrund in die Tiefe hinab. Er "
   +"wirkt wie ein grosses, schwarzes Loch.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "stufen",
             "Obwohl man hier noch ohne groessere Gefahr nach unten gehen "
            +"kann, sollte man doch besser aufpassen, wo man hintritt. "
            +"Teilweise sind die Stufen ja doch schon ziemlich verfallen.");
  AddDetail( "gefahr",
             "In diese geraetst Du bestimmt noch.");
  AddDetail( "treppe",
             "Die Treppe ist vielleicht einen Meter breit, daneben ragt auf "
            +"der einen Seite die Felswand in die Hoehe, auf der anderen "
            +"Seite fuehrt ein Abgrund in die Tiefe.");
  AddDetail( "abgrund",
             "Zu Deiner Linken fuehrt ein schwarzer Abgrund in die Tiefe.");
  AddDetail( "tiefe",
             "Ja, die scheint ziemlich tief zu sein.");
  AddDetail( "loch",
             "Pass bloss auf, dass Du nicht stolperst und hineinfaellst.");
  AddDetail( ({"felswand", "wand", "felswaende", "waende"}),
             "Die Felswaende sind glatt und bestehen aus schwarzem Gestein.");
  AddDetail( ({"fels", "gestein"}),
             "Der Fels ist schwarz gefaerbt und scheint ziemlich hart zu "
            +"sein.");
  AddDetail( "boden",
             "Der ist etwas unsicher unter Dir. Pass besser auf, dass Du "
            +"nicht stolperst.");
  AddDetail( "decke",
             "Die Decke ist ein Stueckchen ueber Dir. Auch sie besteht aus "
            +"schwarzem Fels.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "suedostunten", HOEHLE("loch4"));
  AddExit( "suedosten", HOEHLE("loch4"));
  AddExit( "nordostoben", HOEHLE("loch2"));
  AddExit( "nordosten", HOEHLE("loch2"));
  SetProp (P_HIDE_EXITS, ({"nordosten", "suedosten"}) );

}

