******************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Einige kleinere Lavabrocken liegen hier am Boden herum. Pass besser "
   +"auf, dass Du nicht stolperst und dann auch noch in die Lava "
   +"stuerzt. Alles, was von Dir uebrig bleiben wuerde, waere wohl ein "
   +"kleines Rauchwoelkchen. Richtung Westen fuehrt von hier eine "
   +"weitere Bruecke weiter zu einem Lavablock nordwestlich von Dir. "
   +"Kurz weht eine heisse Schwefelboe von der Lava herauf, sodass es "
   +"Dir fuer einen Moment den Atem verschlaegt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"lavablock", "block"}),
	     "Darauf stehst Du und nordwestlich von Dir ist noch einer.");
  AddDetail( ({"brocken", "lavabrocken"}),
	     "Am Boden liegen jede Menge Lavabrocken herum. Am besten "
	    +"gibst Du bei jedem Schritt genau acht, wo Du hintrittst. "
	    +"Ein Stolpern koennte hier naemlich toedlich enden.");
  AddDetail( "menge",
	     "Jede Menge Lavabrocken liegen hier herum.");
  AddDetail( "schritt",
	     "Gib Acht bei jedem Schritt, sonst stuerzt Du noch in "
	    +"die Lava hinab.");
  AddDetail( "lava",
	     "Tief unter Dir brodelt die Lava, tausende Grade heiss. "
	    +"Solltest Du wirklich da hinunterstuerzen, waere wohl nicht "
	    +"mehr viel uebrig von Dir.");
  AddDetail( ({"rauchwoelkchen", "woelkchen"}),
	     "Viel mehr als ein kleines Rauchwoelkchen bliebe von Dir "
	    +"wohl nicht uebrig, wenn Du da hinunterfallen wuerdest.");
  AddDetail( "bruecke",
	     "Im Nordwesten ist ein weiterer Lavablock, den Du wieder ueber "
	    +"eine Bruecke erreichen kannst.");
  AddDetail( ({"schwefelboe", "boe"}),
	     "Eine scharfe Schwefelboe weht von der Lava zu Dir herauf und "
	    +"Dir stockt fuer einen Moment der Atem.");
  AddDetail( "moment",
	     "Na jetzt kannst Du schon wieder weiteratmen.");
  AddDetail( "atem",
	     "Der scharfe Schwefelgestank verschlaegt Dir kurz den Atem.");
  AddDetail( ({"gestank", "schwefelgestank", "schwefel"}),
	     "Die Luft hier ist aeusserst schwefelhaltig und stinkt daher "
	    +"ganz fuerchterlich. Du musst Dich zu jedem Atemzug "
	    +"ueberwinden.");
  AddDetail( "atemzug",
	     "Jeder Atemzug wird zur Qual bei dieser heissen, scharfen Luft.");
  AddDetail( ({"qual", "lungen"}),
	     "Deine Lungen schmerzen schon fuerchterlich.");
  AddDetail( "luft",
	     "Die Luft hier drinnen ist fuerchterlich heiss und scharf.");
  AddDetail( "boden",
	     "Einige Lavabrocken liegen am Boden herum. Pass auf, dass Du "
	    +"nicht stolperst.");
  AddDetail( ({"decke", "waende", "wand"}),
	     "Decke und Waende bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddExit( "westen", LAVA("bruecke10"));
  AddExit( "osten", LAVA("lava9"));
  AddExit( "suedosten", LAVA("lava6"));
}













