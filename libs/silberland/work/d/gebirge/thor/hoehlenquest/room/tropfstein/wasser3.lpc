// Thor@SilberLand
// Tief in den Felsen - wasser3.c
// 1997-06-02

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Tief in den Felsen" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer breiten Felsnische neben dem tiefen, unterirdischen "
    "See, den Du heruntergetaucht bist. Aus den Felsen geht ein seltsamen, "
    "dumpfes, pulsierendes rotes Leuchten hervor. Es sieht fast so aus, als "
    "wuerde er von Innen vergluehen, aber wenn Du ihn anfasst, ist er kuehl, "
    "so wie jeder andere Fels auch. An der linken Wand plaetschert ein "
    "kleiner Wasserfall aus dem Gestein heraus und fliesst dann in einem "
    "kleinen Baechlein in den See hinein.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"nische", "felsnische"}),
             "Die Nische ist in etwa drei Meter breit und 8 Meter lang.");
  AddDetail( "see",
             "Neben Dir ist der See, durch den Du heruntergetaucht bist. "
             "Wohl oder uebel musst Du auch denselben Weg zuruecknehmen.");
  AddDetail( "weg",
             "Wenn Du hier unten nicht versauern willst, musst Du wohl den "
             "selben Weg zurueck nehmen, den Du auch gekommen bist.");
  AddDetail( ({"felsen", "fels"}),
             "Die Felsen strahlen ein sonderbares, pulsierendes Leuchten "
             "aus.");
  AddDetail( ({"leuchten", "licht"}),
             "Ein dumpfes, rotes Licht, das von den Felsen ausgeht, erfuellt "
             "die kleine Hoehle. Es scheint staerker und schwaecher zu "
             "werden, es pulsiert. Der Anblick erscheint Dir fast, als "
             "waerst Du hier im Herzen des SilberLandes, und Du siehst "
             "es pumpen und pulsieren.");
  AddDetail( ({"hoehle", "anblick"}),
             "Ein so seltsamer und doch schoener Anblick hat sich Dir noch "
             "niemals zuvor geboten.");
  AddDetail( "herz",
             "Dir scheint es, als seist Du im Herzen des SilberLandes "
             "angelangt... Der rote, pulsierende Fels ist beinahe schon "
             "hypnotisierend.");
  AddDetail( "wand",
             "Aus der linken Wand plaetschert ein kleiner Wasserfall aus "
             "dem Gestein heraus.");
  AddDetail( "gestein",
             "Es leuchtet rot.");
  AddDetail( "wasserfall",
             "In der linken Wand ist ein kleines Loch, aus dem ein "
             "Wasserfall herausplaetschert.");
  AddDetail( "loch",
             "Das Loch macht Dich neugierig. Du koenntest ja mal "
             "hineingreifen.");
  AddDetail( "wasser",
             "Das Wasser von dem kleinen Wasserfall rinnt in einem Baechlein "
             "am Rand der Nische in den See hinein.");
  AddDetail( "baechlein",
             "Es fliesst an der linken Wand entlang und plaetschert dann in "
             "den See.");
  AddDetail( "boden",
             "Selbst der Boden scheint von Innen her roetlich zu leuchten.");
  AddDetail( "decke",
             "Die Decke ist etwa drei Meter ueber Dir.");
  AddDetail( "waende",
             "Sie sind aus schroffem Fels, der allerdings in einem dumpfen "
             "Rot leuchtet.");
  AddDetail( "rot",
             "Es ist sonderbar und geheimnisvoll.");

  AddSound( DEFAULT_SOUND,
    "Du hoest das Plaetschern des Wassers.");
  AddSound( ({"wasser", "wasserfall", "baechlein", "plaetschern"}),
    "Das Plaetschern wirkt irgendwie angehem beruhigend.");  
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({"greife", "greif"}), "wasserfall" );
  AddCmd( ({"fass", "fasse"}), "fels");
  AddCmd( ({"springe", "spring"}), "see");
}

int symbole=1;

fels( str )
{
  notify_fail("Was willst Du anfassen?\n");
  if( str=="fels an"||str=="felsen an"||str=="gestein an")
    {
    write(BS("Das Gestein ist ganz kalt.\n"));
    say(BS(CAP_TPN+" betastet den Felsen.\n"));
    return 1;
    }
  else
    return 0;
}

see( str )
{
  notify_fail("Wo willst Du hineinspringen?\n");
  if(str=="in wasser"||str=="in see"||str=="in wasser hinein"||str=="in see hinein")
    {
    TP->move(TROPFST("wasser2"), M_GO, "", "springt in den See hinein", "platscht herein");
    return 1;
    }
  else
    return 0;
}

wasserfall( str )
{
  object ob;
  
  notify_fail("Wo willst Du hineingreifen?\n");
  if(str=="in wasserfall"||str=="in loch")
    {
    write(BS("Du tastest in dem kleinen Wasserfall herum und bemerkst, dass "
             "das Wasser von oben kommt und unterhalb noch ein kleiner "
             "Hohlraum ist. Vielleicht solltest Du einmal versuchen, "
             "noch tiefer hineinzugreifen.\n"));
    say(BS(CAP_TPN+" greift mit verbissenem Gesichtsausdruck bei den "
             "Felsen im Wasserfall herum.\n"));
    return 1;
    }
  if(str=="tiefer in wasserfall hinein"||str=="tiefer in loch hinein"||str=="tiefer in loch"||str=="tiefer in wasserfall")
    {
    if(present("\nhquest", TP) && symbole && !present("hammer-symbol", TP))
      {
      write(BS("Du steckst Deinen Arm bis zum Schultergelenk in das Loch "
	        "hinein und tastest in dem Hohlraum unter dem Wasserfall "
	        "herum. Ploetzlich meinst Du, etwas glattes, metallisches zu "
	        "ertasten und ziehst es sogleich aus der Hoehle heraus.\n"));
      say(BS(CAP_TPN+" hat den Arm nun schon bis zur Schulter in den Fels "
	      "gesteckt zieht ihn nach einiger Zeit dann jedoch ueberrascht "
	      "wieder heraus.\n"));
      ob=clone_object(OBJ("symb_hammer"));
      ob->move(TP, M_NOCHECK);
      symbole=0;
      return 1;
	}
    else
      {
	write(BS("Du steckst Deinen Arm bis zum Schultergelenk in das Loch "
	      "hinein und tastest in dem Hohlraum unter dem Wasserfall "
	      "herum. Du kannst leider nichts besonderes finden und ziehst "
	      "den Arm enttaeuscht wieder heraus. Vielleicht solltest Du ja "
	      "etwas spaeter nochmal wiederkommen.\n"));
	say(BS(CAP_TPN+" hat den Arm nun schon bis zur Schulter in den Fels "
	      "gesteckt zieht ihn nach einiger Zeit dann jedoch mit einem  "
	      "enttaeuschten Gesichtsausdurck wieder heraus.\n"));
	return 1;
      }
    }
   
  return 0;
}

reset()
{
  ::reset();
  symbole=1;
}





