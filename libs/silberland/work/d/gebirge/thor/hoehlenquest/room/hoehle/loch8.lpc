// Thor@SilberLand
// Ein Loch in die Tiefe - loch8.c
// 1997-04-29

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Deine Umgebung sieht immer noch gleich aus, wie zuvor. Die Stufen werden "
   +"nicht stabiler, der Boden ist auch hier von Gesteinsbrocken uebersaeht "
   +"und das Gestein um Dich herum ist immer noch schwarz. Nur in der "
   +"Felswand neben Dir kannst Du ein Loch erkennen, das etwa die Groesse von "
   +"drei Faeusten besitzt.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "umgebung",
             "Die Umgebung wird keineswegs freundlicher hier und ist auch "
            +"nicht sehr abwechslungsreich.");
  AddDetail( ({"stufen", "treppe"}),
             "Die Stufen sind auch hier verschoben, wackelig und bruechig.");
  AddDetail( ({"brocken", "gesteinsbrocken"}),
             "Einige Gesteinsbrocken liegen am Boden herum, ueber die Du "
            +"leicht stolpern koenntest.");
  AddDetail( ({"gestein", "fels"}),
             "Der Fels hier ist tief schwarz gefaerbt.");
  AddDetail( ({"wand", "felswand"}),
             "In der Felswand ist ein kleines Loch, in etwa so gross wie drei "
            +"Faeuste.");
  AddDetail( "loch",
             "Das Loch ist so gross, dass man hineingreifen kann.");
  AddDetail( "faeuste",
             "Das Loch hat die Groesse von drei Faeusten.");
  AddDetail( "boden",
             "Am Boden liegen einige groessere Gesteinsbrocken herum.");
  AddDetail( "waende",
             "Die Waende bestehen aus schwarzem Fels.");
  AddDetail( "decke",
             "Die kannst Du schon lange nicht mehr erkennen.");
  AddSpecialDetail( "ding", "unt_ding");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");    

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "greife", "greif" }), "loch" );
  AddCmd( ({ "ziehe", "zieh" }), "knochen");

  AddExit( "nordwestoben", HOEHLE("loch7"));
  AddExit( "nordostunten", HOEHLE("loch9"));
  AddExit( "nordwesten", HOEHLE("loch7"));
  AddExit( "nordosten", HOEHLE("loch9"));
  SetProp (P_HIDE_EXITS, ({"nordwesten", "nordosten"}) );

}

int schaedel=1;

loch( str )
{
  notify_fail( "Wo willst Du hineingreifen?\n" );
  if( str == "in loch" ||str=="loch" )
    {
    if(schaedel==1)
      {
      write(BS("Vorsichtig tastest Du mit der Hand in das Loch hinein. Du "
            +"fuehlst irgendein Ding, von dem Du aber nicht genau sagen "
            +"kannst, was es ist. Es fuehlt sich hart an, aber nicht wie "
            +"Stein. Das Ding scheint oben rund zu sein, fast so wie ein "
            +"Ball, unten allerdings ist es kantig und unregelmaessig.\n"));
      say(BS(CAP_TPN+" fummelt mit einem angestrengten Gesichtsausdruck in "
            +"einem Loch in der Felswand herum.\n"));
      return 1;
      }
    else
      {
      write(BS("Du tastest in dem Loch herum, kannst aber nichts darin "
            +"entdecken.\n"));
      say(BS(CAP_TPN+" steckt seine Hand in ein Loch in der Felswand, zieht "
            +"sie jedoch dann wieder enttaeuscht zurueck.\n"));
      return 1;
      }
    }
  else  
  return 0;
}

knochen( str )
{
  notify_fail( "Was willst Du herausziehen?\n");
  if( schaedel==1)
    {
    if(str=="ding heraus"||str=="ding aus loch"||str=="ding aus loch heraus")
      {
      write(BS("Vorsichtig ziehst Du das Ding aus dem Loch in der Felswand "
            +"heraus. Als Du es in Deinen Haenden haeltst und es betrachtest, "
            +"siehst Du ploetzlich, was es ist. Du haeltst einen alten, "
            +"teilweise zernagten Totenschaedel in den Haenden, dem bereits "
            +"einige Zaehne fehlen. Der Schaedel riecht abstossend verfault. "
            +"Du erschrickst so sehr, dass Du einen lauten Schrei ausstoesst "
            +"und Dir vor Schreck der Schaedel sofort aus den Haenden gleitet "
            +"und in den Abgrund faellt.\n"));
      say(BS(CAP_TPN+" zieht ein rundliches Etwas aus der Felswand heraus und "
            +"stoesst sogleich vor Schreck einen markerschuetternden Schrei "
            +"aus. Du konntest leider nicht erkennen, was es war, denn "
            +TPN+" glitt es sofort aus den Haenden und nun ist es im Abgrund "
            +"verschwunden.\n"));
      schaedel=0;
      TP->command_me("rufe IGIIIITTHH!!! HILFE!");
      return 1;
      }
   }
  else
    return 0;
}

string unt_ding()
{
  if(schaedel==1)
    {
    return(BS("Es ist nicht zu erkennen, was es ist. Du koenntest ja "
          +"versuchen, es herauszuziehen.\n"));
    }
}

reset()
{
  ::reset();
  schaedel=1;
}





