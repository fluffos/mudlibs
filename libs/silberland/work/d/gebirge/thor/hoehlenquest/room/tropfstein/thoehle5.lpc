// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle5.c
// 1997-05-15

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle scheint hier um einiges enger zu werden. Die beeindruckende "
    "Atmosphaere von der weiten Hoehle ist hier nicht mehr ganz so "
    "maerchenhaft wie zuvor. Links und rechts von Dir sind die hellen, "
    "nassen Kalkwaende, an denen etwas Wasser herunter rinnt. Richtung Westen "
    "kannst Du noch ein Stueck weiter gehen, ein Gang fuehrt hier weiter.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Die Hoehle verengt sich hier noch weiter. Richtung Westen ist "
             "nur noch ein Gang zu erkennen.");
  AddDetail( "atmosphaere",
             "Dadurch, dass die Hoehle hier um einiges enger wird, sind "
             "die Tropfsteine nur mehr ziemlich klein und Deine Umgebung "
             "wirkt jetzt nicht mehr so gewaltig.");
  AddDetail( "umgebung",
             "Alles wirkt nicht mehr so riesig und gewaltig, als am Beginn "
             "der Hoehle.");
  AddDetail( ({"hoehlenwaende", "kalkwaende", "waende"}),
             "Die Hoehlenwaende ist feucht und glitschig. Das Gestein ist "
             "ziemlich hell, wegen dem hohen Kalkgehalt. Etwas Wasser "
             "rinnt an den Waenden herunter.");
  AddDetail( ({"fels", "gestein"}),
             "Der Fels ist sehr hell, wegen dem hohen Kalkgehalt im Gestein "
             "hier.");
  AddDetail( "kalkgehalt",
             "Ja, der ist in einer Tropfsteinhoehle fuer gewoehnlich ziemlich "
             "hoch.");
  AddDetail( "tropfsteinhoehle",
             "Da befindest Du Dich gerade.");
  AddDetail( "wasser",
             "An den Waenden rinnt etwas Wasser herunter und sie sind dadurch "
             "ziemlich glitschig.");
  AddDetail( "gang",
             "Richtung Westen fuehrt ein Gang weiter.");
  AddDetail( "boden",
             "Der Boden ist feucht und ziemlich schluepfrig. Pass lieber auf, "
             "dass Du nicht ausrutscht.");
  AddDetail( "decke",
             "Von der Decke haengen nur noch einige kleine Tropfsteine "
             "herunter.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Die Tropfsteine sind hier bei weitem nicht mehr so gross, wie "
             "an anderen Stellen der Hoehle.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise etwas Wasser von der Decke heruntertropfen.");
  AddSound( ({"wasser", "tropfen"}),
    "*tropf* *tropf* *tropf*");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist feucht und kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "westen", TROPFST("thoehle6"));
  AddExit( "sueden", TROPFST("thoehle4"));
}
