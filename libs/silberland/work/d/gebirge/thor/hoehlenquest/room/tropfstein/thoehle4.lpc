// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle4.c
// 1997-05-14

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Rund um Dich herum siehst Du den feuchten Fels von der Decke zum Boden "
   +"herunterwachsen. Die steinernen Gewaechse sind hier noch nicht so "
   +"gross, wie sie es vielleicht in der Mitte der Hoehle sein moegen. "
   +"Die Hoehle scheint hier ausserdem etwas enger zu werden. Weiter nach "
   +"Norden wird sie dann nochmal um ein gutes Stueck schmaeler.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "fels",
             "Der Fels schimmert glaenzend im Licht Deiner Fackel.");
  AddDetail( ({"licht", "fackel"}),
             "Das Licht Deiner Fackel verleiht der Hoehle ein funkelndes "
            +"Aussehen.");
  AddDetail( "decke",
             "Es gibt bestimmt noch groessere Stalaktiten in dieser Hoehle, "
            +"als hier von der Decke herunterhaengen.");
  AddDetail( "boden",
             "Der feuchte Boden unter Deinen Beinen ist etwas schluepfrig.");
  AddDetail( "beine",
             "Pass auf, dass Du nicht ausrutscht.");
  AddDetail( "gewaechse",
             "Die Stalaktiten und Stalagmiten erinnern an steinerne "
            +"Gewaechse.");
  AddDetail( ({"stalaktiten", "stalagmiten",}),
             "Sie sind hier noch nicht von ueberwaeltigender Groesse. In der "
            +"Mitte der Hoehle wirst Du wohl noch wesentlich groessere "
            +"finden, als hier.");
  AddDetail( "hoehle",
             "Die Hoehle wird nach Norden hin etwas enger.");
  AddDetail( "waende",
             "An den Waenden rinnt ein wenig Wasser herab.");
  AddDetail( "wasser",
             "Etwas Wasser rinnt von den Waenden herab und tropft auch von "
            +"der Decke.");
            
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers von der Decke.");
  AddSound( ({"tropfen", "wasser"}),
    "Ein beruhigendes Geraeusch, findest Du.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist feucht und kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief die angenehme Luft ein.");

  AddExit( "norden", TROPFST("thoehle5"));
  AddExit( "sueden", TROPFST("thoehle3"));
  AddExit( "suedwesten", TROPFST("thoehle9"));
  AddExit( "nordwesten", TROPFST("thoehle6"));
}
