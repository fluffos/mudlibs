// Thor@SilberLand
// Eine verschollene Hoehle - hoehle2.c
// 1997-04-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Vor Dir erstreckt sich in oestliche Richtung eine scheinbar sehr alte, laengst "
   +"vergessene Hoehle. Sie ist grob aus dem Stein herausgehauen, manchmal sieht man "
   +"einige kleinere Felsbrocken am Boden herumliegen. Die suedliche Wand scheint etwas "
   +"feucht zu sein, ansonsten scheint alles eher trocken, fast etwas staubig.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"richtung", "osten"}),
             "Richtung Osten erstreckt sich vor Dir die Hoehle. Du kannst sehr weit "
            +"sehen, die Finsternis ist fast erdrueckend.");
  AddDetail( "hoehle",
             "Die Hoehle scheint doch etwas groesser zu sein. Man hoert das Echo der "
            +"Schritte am steinernen Boden.");
  AddDetail( ({"echo", "schritte"}),
             "Wenn man einen Fuss vor den anderen setzt, hoert man ein leises Echo von "
            +"den Hoehlenwaenden.");
  AddDetail( "fuss",
             "Ja, davon hat man gewoehnlich zwei.");
  AddDetail( ({"stein", "fels"}),
             "Die Hoehle scheint nicht natuerlichen Ursprungs zu sein. Sie ist "
            +"grob aus dem Fels herausgehauen.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Am Boden liegen einige kleine Felsbrocken herum. Sie sind wahrscheinlich "
            +"aus der Decke herausgebrochen. Diese Hoehle scheint wirklich schon lange "
            +"niemand mehr betreten zu haben.");
  AddDetail( "decke",
             "In der Decke sind einige Loecher zu erkennen. Dort hat sich wahrscheinlich "
            +"das Gestein etwas gelockert und ist heruntergebroeckelt. Das erklaert auch "
            +"die Felsbrocken am Boden.");
  AddDetail( ({"loecher", "ursprung"}),
             "Die Loecher in der Decke scheinen der Ursprung der Felsbrocken am Boden "
            +"zu sein.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "An der suedlichen Wand troepfelt etwas Wasser herab, ansonsten liegt nur "
            +"etwas Geroell bei den Waenden herum.");
  AddDetail( "geroell",
             "Auch aus den Waenden ist etwas Gestein herausgebrochen, das nun am Boden "
            +"herumliegt.");
  AddDetail( "gestein",
             "Das Gestein scheint teilweise schon etwas locker zu sein. Du passt besser "
            +"auf, dass Dir nichts auf den Kopf faellt.");
  AddDetail( "kopf",
             "Waer doch schade darum, vielleicht kannst Du ihn noch gebrauchen.");
  AddDetail( "wand",
             "Die suedliche Wand ist etwas feucht. Vielleicht ist hier ja irgendwo eine "
            +"Quelle.");
  AddDetail( "wasser",
             "Ein wenig Wasser troepfelt an der suedlichen Wand herab.");
  AddDetail( "quelle",
             "Die feuchte Wand laesst auf eine Quelle irgendwo hier in der Naehe "
             "schliessen.");
  AddDetail( "boden",
             "Von einigen kleineren Felsbrocken abgesehen ist der Boden eben und felsig "
            +"und teilweise mit etwas Staub bedeckt.");
  AddDetail( ({"staub", "staubschicht", "schicht"}),
             "Der Boden ist mit einer duennen Staubschicht bedeckt.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise das Wasser von der suedlichen Wand tropfen.");
  AddSound( "wasser",
    "*tropf* *tropf* *tropf* ... Faszinierend!");
  AddSound( ({"echo", "schritte"}),
    "Wenn Du gehst, hoerst Du das Echo Deiner Schritte aus der Tiefe der Hoehle "
   +"widerhallen.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft hier in der Hoehle riecht angenehm frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief die angenehme Hoehlenluft ein.");

  AddExit( "suedwesten", HOEHLE("hoehle1"));
  AddExit( "nordosten", HOEHLE("hoehle3"));
  AddExit( "osten", HOEHLE("hoehle4"));
}
