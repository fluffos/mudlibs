// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle18.c
// 1997-05-27

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp(P_INT_LONG,
    "Der Dampf, der in dem kleinen See neben Dir aufsteigt, sieht aus, wie "
    "eine kleine Nebelwand und laesst die Hoehle hier noch etwas unheimlicher "
    "erscheinen. Lange, duenne Tropfsteine, die von der Decke haengen, "
    "scheinen wie die Finger eines Skelettes nach Dir greifen zu wollen. "
    "Wenn Du laenger stehen bleibst und naeher darueber nachdenkst, kommt es "
    "Dir nach einer Zeit wohl sogar so vor, als wuerden sich all die "
    "bizarren Tropfsteinskulpturen wirklich zu Bewegen beginnen. Dir laeuft "
    "bei diesem Gedanken ein kalter Schauer ueber den Ruecken.");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "dampf",
             "Der Dampf, der im kleinen See aufsteigt, erinnert an eine "
             "Nebelwand.");
  AddDetail( ({"nebel", "nebelwand", "wand"}),
             "Die Nebelwand laesst die Hoehle nur noch etwas unheimlicher und "
             "sonderbarer erscheinen.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Obwohl sie von maerchenhafter Schoenheit ist, ueberkommt Dich "
             "von Zeit zu Zeit ein unheimlicher Schauer.");
  AddDetail( "schoenheit",
             "Die Hoehle ist maerchenhaft schoen und mit all ihren "
             "Geheimnissen wirkt sie beinahe ueberirdisch.");
  AddDetail( "geheimnisse",
             "Davon hat die Hoehle sicherlich genug.");
  AddDetail( ({"tropfsteine", "steine"}),
             "Die duennen Tropfsteine, die von der Decke haengen, erinnern "
             "an bleiche, knoecherne Finger.");
  AddDetail( "finger",
             "Wenn Du sie Dir laenger anschaust, erscheinen sie fast so, als "
             "wuerden sie nach Dir greifen.");
  AddDetail( "skelett",
             "Da ist kein Skelett, die Tropfsteine erinnern nur an die "
             "Finger eines solchen.");
  AddDetail( ({"skulpturen", "tropfsteinskulpturen"}),
             "Die Tropfsteine sind manchmal zu sonderbaren, bizarren "
             "Skulpturen gewachsen.");
  AddDetail( "gedanken",
             "Bei dem Gedanken, dass die steinernen Finger ploetzlich laenger "
             "werden und wirklich nach Dir greifen, laeuft Dir ein kalter "
             "Schauer ueber den Ruecken.");
  AddDetail( "schauer",
             "Er laeuft Dir ueber den Ruecken.");
  AddDetail( "ruecken",
             "Darauf ist schon eine Gaensehaut.");
  AddDetail( ({"gaensehaut", "haut"}),
             "Wird Dir nicht schon langweilig von dem ewigen Untersuchen?");
  AddDetail( "decke",
             "Gelegentlich tropft ein Wassertropfen von der Decke in den "
             "See hinein.");
  AddDetail(  ({"wassertropfen", "tropfen"}),
             "Ein Wassertropfen plitscht manchmal von der Decke herab.");
  AddDetail( "see",
             "Das Wasser in dem See neben Dir scheint ziemlich warm zu sein. "
             "Ein merkwuerdiger Dampf steigt davon auf.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig. Pass besser auf, dass Du "
             "nicht ausrutscht.");
  AddDetail( "waende",
             "Von den Waenden rinnt ein wenig Wasser herab.");
  AddDetail( "wasser",
             "Das Wasser scheint sonderbarer Weise sehr warm zu sein. Du "
             "wuerdest einmal gerne hineingreifen, um zu sehen, wie warm es "
             "wirklich ist.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers.");
  AddSound( ({"wasser", "tropfen", "geraeusch"}),
    "Es ist irgendwie ein angenehmes Geraeusch.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "greif", "greife" }), "wasser" );
  AddCmd( ({"springe", "spring"}), "see");
 
  AddExit( "osten", TROPFST("thoehle19"));
  AddExit( "nordosten", TROPFST("thoehle13"));
  AddExit( "nordwesten", TROPFST("thoehle17"));
}

int wasser( string str )
{
  notify_fail( "Wo willst Du hineingreifen?\n" );
  if( str == "in wasser" || str=="in wasser hinein")
  {
    write(BS("Du greifst vorsichtig mit einem Finger in das Wasser hinein und "
             "stellst fest, dass es angenehm warm ist. Es waere sogar warm "
             "genug, um hineinzuspringen, Du bist allerdings noch etwas "
             "unschluessig.\n"));
    say(BS(CAP_TPN+" greift in das Wasser hinein, und bleibt dann etwas "
             "unentschlossen vor dem Ufer stehen.\n"));
    return 1;
  }
  return 0;
}

int see( string str )
{
  notify_fail( "Wo willst Du hineinspringen?\n" );
  if( str=="in wasser" || str=="in wasser hinein")
    {
    write(BS("Du ueberlegst eine Zeit lang, ob Du da wirklich hineinspringen "
             "sollst, laesst es dann aber doch besser bleiben.\n"));
    return 1;
    }
  return 0;
}  


