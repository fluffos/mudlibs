#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle wird hier wieder wesentlich breiter. Sie erstreckt sich von "
   +"hier weiter Richtung Sueden. Nach Westen fuehrt ein Gang wieder zum "
   +"Labyrinth zurueck. Auch hier sind Waende, Decke und Boden ganz glatt und "
   +"regelmaessig, keine Risse, keine herumliegenden Gesteinsbrocken. Im "
   +"Sueden siehst Du nun tatsaechlich ein permanentes, helles Funkeln, Du "
   +"bist Dir nun sicher, dass es sich um keine Taeuschung mehr handeln "
   +"kann.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Die Hoehle breitet sich hier weiter Richtung Sueden und "
            +"Suedosten aus.");
  AddDetail( "gang",
             "Richtung Westen fuehrt ein Gang zu dem Labyrinth zurueck.");
  AddDetail( "labyrinth",
             "Durch das musst Du wohl wieder durch, wenn Du hier lebendig "
            +"wieder zurueck moechtest.");
  AddDetail( "waende",
             "Die Waende sind ziemlich glatt und regelmaessig, man kann "
            +"keinerlei Risse darin erkennen. Der Fels hat eine eher "
            +"dunkle Farbe und scheint ziemlich hart zu sein."),
  AddDetail( "decke",
             "Die Decke ist hier wieder etwas hoeher. Sie weisst keinerlei "
            +"Unregelmaessigkeiten auf.");
  AddDetail( "boden",
             "Du siehst keine Gesteinsbrocken am Boden herumliegen, wie "
            +"zuvor schon so oft. Der Boden sieht aus, als waere er glatt "
            +"poliert.");
  AddDetail( ({"brocken", "gesteinsbrocken"}),
             "Es liegen nirgendwo welche herum.");
  AddDetail( ({"unregelmaessigkeiten", "risse",}),
             "Du kannst nirgends welche entdecken.");
  AddDetail( ({"fels", "gestein"}),
             "Das Gestein hat eine graue bis dunkelgraue Farbe. Es scheint "
            +"ziemlich hart zu sein.");
  AddDetail( "farbe",
             "Das Gestein ist grau an manchen Stellen auch dunkelgrau.");
  AddDetail( "stellen",
             "An manchen Stellen ist das Gestein etwas dunkler als an den "
            +"anderen.");
  AddDetail( "funkeln",
             "Im Sueden kannst Du nun deutlich ein helles, leuchtendes "
            +"Funkeln erkennen. Wo das wohl herkommen mag?");
  AddDetail( "taeuschung",
             "Du bist Dir nun sicher, dass es sich bei dem Funkeln um keine "
            +"Taeuschung mehr handeln kann.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Die Stille ist schon beinahe erdrueckend.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief durch und fuehlst Dich gleich etwas besser.");

  AddExit( "westen", TROPFST("khoehle3"));
  AddExit( "sueden", TROPFST("khoehle5"));
  AddExit( "suedosten", TROPFST("khoehle6"));
}
