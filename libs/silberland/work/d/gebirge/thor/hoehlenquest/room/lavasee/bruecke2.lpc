*  Thor@SilberLand            *
*  Eine Bruecke - bruecke1.c  *
*  1997-08-06                 *
******************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bruecke" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einer Bruecke, etwa zehn Meter ueber der gluehenden, "
   +"kochenden Lava. Du kannst nur mit aeusserster Anstrengung atmen und "
   +"die Luft ist erfuellt von einem aetzenden Schwefelgeruch. Das Material "
   +"der Bruecke scheint irgendein dunkles, fremdartiges Metall zu sein, das "
   +"eine unglaubliche Hitzeresistenz zu haben scheint. Die Bruecke stellt "
   +"eine Verbindung mit dem Felsblock, der direkt vor Dir im Nordwesten "
   +"ist, dar.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"bruecke", "bruecken"}),
             "Die Bruecke, auf der Du stehst, besteht aus einem sonderbaren "
            +"Metall.");
  AddDetail( "lava",
             "Die Lava tief unter Dir brodelt hoellisch heiss. Ab und zu "
            +"schlaegt sie grosse Blasen und einige Lavaspritzer spritzen "
            +"bis zu Dir hoch.");
  AddDetail( ({"blasen", "lavablasen"}),
             "Die Lava schlaegt gelegentlich riesige Blasen, die dann "
            +"zerplatzen.");
  AddDetail( ({"spritzer", "lavaspritzer"}),
             "Wenn die Lavablasen zerplatzen, spritzt gelegentlich etwas "
            +"Lava bis zu Dir hoch. Sieh Dich besser vor, dass Dich nicht "
            +"mal so ein Spritzer erwischt!");
  AddDetail( ({"anstrengung", "atmen"}),
             "Es kostet Dich grosse Anstrengung, hier Luft zu holen.");
  AddDetail( "luft",
             "Du sehnst Dich nach einem kuehlen Plaetzchen.");
  AddDetail( "plaetzchen",
             "Tja, ein kuehles Plaetzchen... das haettest Du wohl gerne. Aber "
            +"das ist jetzt weit, weit weg.");
  AddDetail( ({"geruch", "schwefelgeruch", "schwefel"}),
             "Der Schwefel in der Luft macht das Atmen nur noch schwerer und "
            +"qualvoller.");
  AddDetail( "material",
             "Die Bruecke scheint aus irgendeinem sonderbaren Metall zu "
            +"bestehen.");
  AddDetail( "metall",
             "Das Metall hat eine dunkle Faerbung. Es scheint ausserdem eine "
            +"enorme Hitzeresistenz zu besitzen, denn an den Hoehlenwaenden "
            +"kannst Du teilweise auch Spuren dieses Metalls erkennen, es "
            +"scheint allerdings in der gluehend heissen Lava nicht zu "
            +"schmelzen.");
  AddDetail( ({"farbe", "faerbung"}),
	     "Das Metall hat eine seltsame, dunke Farbe.");
  AddDetail( ({"hitzeresistenz", "resistenz"}),
             "Das Metall muss eine enorme Hitzeresistenz haben, denn es "
            +"scheint trotz der heissen Lava nicht zu schmelzen.");
  AddDetail( ({"hoehlenwaende", "hoehlenwand", "waende", "wand"}),
             "An den Waenden der Hoehle sind Spuren des Metalls, aus dem die "
            +"Bruecke gemacht ist, zu erkennen. Man kann allerdings von "
            +"nirgends daran rankommen.");
  AddDetail( "hoehle",
             "Die Hoehle streckt sich rund um Dir aus. Es herrscht eine "
            +"enorme Hitze.");
  AddDetail( "hitze",
             "Die Hitze in der Hoehle ist fast unertraeglich.");
  AddDetail( ({"spuren", "spur"}),
             "An den Waenden sind nur geringe Spuren des Metalls zu erkennen. "
            +"Da die ganzen Bruecken allerdings daraus gemacht sind, muss "
            +"es wohl irgendwo noch ein groesseres Vorkommen geben...");
  AddDetail( "vorkommen",
             "Es gibt bestimmt irgendwo ein groesses Vorkommen an diesem "
            +"dunklen Metall.");
  AddDetail( "boden",
             "Der Boden unter Deinen Fuessen ist so heiss, dass Dir die "
            +"Fussohlen schon brennen.");
  AddDetail( ({"fuss", "fuesse"}),
             "Denen ist ziemlich heiss.");
  AddDetail( ({"fussohlen", "sohlen"}),
             "Sie schmerzen bereits bedenklich.");
  AddDetail( "decke",
             "Die Decke ueber Dir besteht aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
             "Es ist ziemlich dunkel.");
  AddDetail( ({"block", "felsblock"}),
             "Die Bruecke ist die Verbindung zu diesem Felsblock. Du kannst "
            +"ja mal ein Stueckchen weiter gehen.");
  AddDetail( "verbindung",
             "Die Bruecken verbinden die Felsbloecke miteinander.");
  AddDetail( ({"bloecke", "felsbloecke"}),
             "Zahlreiche Felsbloecke ragen aus der Lava heraus.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
    "Blubb... BlubbBlubb... Blubb");
    
  AddSmell( DEFAULT_SMELL,
    "Der scharfe Schwefelgeruch sticht Dir aetzend in Nase.");
  AddSmell( ({"schwefel", "schwefelgeruch", "geruch"}),
    "Du atmest besser nicht zu tief ein.");

  AddExit( "nordwesten", LAVA("lava2"));
  AddExit( "sueden", LAVA("bruecke1"));
}



