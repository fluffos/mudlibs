*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Hier scheinst Du so ziemlich am westlichsten Teil "
    "der Hoehle angelangt zu sein. Einige Meter vor Dir "
    "siehst Du die Hoehlenwand und kannst daher nun auch "
    "deutlicher die Metallspuren daran erkennen. Das "
    "Metall glaenzt in der Glut der Lava, es erweckt aber "
    "an keiner Stelle den Anschein, dass es schmelzen "
    "wuerde. Die Luft flirrt durch die Hitze und verleiht "
    "so den Hoehlenwaenden den Eindruck, als wuerden sie "
    "sich fortwaehrend bewegen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( "teil",
	     "Dies ist wohl der westlichste Teil der Hoehle "
	     "weil die Hoehlenwand gleich einige Meter vor "
	     "Dir aufragt.");
  AddDetail( "hoehle",
	     "Du bist hier im Westen der Hoehle.");
  AddDetail( ({"hoehlenwand", "hoehlenwaende", "waende", "wand"}),
	     "An der Hoehlenwand vor Dir kannst Du nun die "
	     "Metallspuren etwas deutlicher erkennen.");
  AddDetail( ({"spuren", "metallspuren", "metall"}),
	     "Das Metall schmilzt tatsaechlich nicht, nichtmal "
	     "da, wo es von der Lava beruehrt wird. Hier kannst "
	     "Du nun erkennen, dass es wirklich das selbe Metall "
	     "ist, aus dem auch die Bruecken gemacht sind. Es ist "
	     "unglaublich, wie widerstandsfaehig dieses Metall "
	     "gegen die Hitze ist.");
  AddDetail( ({"bruecken", "bruecke"}),
	     "Die Bruecken sind aus dem selben Metall gemacht, "
	     "das in Spuren an den Hoehlenwaenden vorhanden ist.");
  AddDetail( ({"glut", "lavaglut"}),
	     "Die enorm heisse Lavaglut scheint dem Metall nicht "
	     "das geringste auszumachen.");
  AddDetail( ({"lava", "magma"}),
	     "Die Magma brodelt etwa zwanzig Meter unter Dir.");
  AddDetail( ({"stelle", "anschein"}),
	     "Du siehst nicht eine Stelle, wo das Metall eine "
	     "roetlich-gluehende Farbe hat.");
  AddDetail( "farbe",
	     "Das Metall ist aeusserst dunkel, beinahe schon "
	     "schwarz.");
  AddDetail( "hitze",
	     "Durch die enorme Hitze beginnt die Luft zu flirren. "
	     "Du bildest Dir beinahe schon ein, sogar die "
	     "einzelnen Luftpartikel sehen zu koennen, wie sie "
	     "sich auf und ab bewegen.");
  AddDetail( ({"luft", "bewegung"}),
	     "Die Luft scheint wegen der fuerchterlichen Hitze in "
	     "dauerhafter Bewegung zu sein.");
  AddDetail( ({"partikel", "luftpartikel"}),
	     "Das muss wohl an der Hitze liegen, dass Du Dir nun "
	     "schon solche Sachen einbildest.");
  AddDetail( "eindruck",
	     "Durch die flirrende Luft sieht es fast so aus, als "
	     "wuerden sich die Hoehlenwaende bewegen und staendig "
	     "ineinander fliessen. Sieh besser nicht zu lange "
	     "hin, es verwirrt Dich sonst nur noch mehr.");
  AddDetail( "decke",
	     "Die Decke ueber Dir besteht aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( "boden",
	     "Wenn Dir nicht so heiss waere, wuerdest Du am liebsten "
	     "auf der Stelle auf und ab huepfen, nur um dem brennend "
	     "heissen Boden wenigstens kurzzeitig zu entkommen.");


  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddCmd( ({"tauche", "tauch"}), "glut");
  AddCmd( ({"springe", "spring"}), "lava"); 

  AddExit( "osten", LAVA("lava10"));
}

glut( str )
{
  write("Hier kannst Du nirgends hintauchen, hoechstens springen.\n");
  say(BS(CAP_TPN+" hat scheinbar irgendeinen Bloedsinn vor.\n"));
  return 1;
}

lava( str )
{
  object ob;

  notify_fail("Wohin willst Du springen?\n");
  if(str=="in lava"||str=="in glut")
    {
    write(BS("Du stehst unentschlossen am Rand des Lavablocks... Du "
	     "ueberlegst und ueberlegst, nimmst Dir schliesslich aber "
	     "ein Herz und springst von dem Lavablock weg. Alles "
	     "geschieht wie in Zeitlupe. Es wird heisser und heisser, "
	     "die Lava unter Dir kommt immer naeher, naeher, naeher... \n"));
    say(BS("Du traust Deinen Augen nicht, als "+TPN+" ploetzlich vor Dir "
           "einfach vom Felsblock wegspringt und in die Lava taucht.\n"));
    if(!ob=present("kristallplatte", TP))
      {
      call_out("tod", 5);
      return 1;
      }
    if((ob->QueryProp(P_JUMP))!=1)
      {
      call_out("tod", 5);
      return 1;
      }
    call_out("leben", 5);
    return 1;
    }
  else
    return 0;
}

tod()
{
  write(BS("Es war wohl keine so gute Idee, hier runterzuspringen. Wie kann "
	   "man auch nur so bloed sein, anzunehmen, dass man einen Sprung "
	   "in die Lava ueberleben koennte ... Du spuerst nur noch, wie "
	   "Dein Koerper von ueberwaeltigender Hitze eingeschlossen wird, "
	   "und dann...\n"));
  TP->die();
}

leben()
{
  write(BS("Du hast panische Angst. Die Lava kommt immer naeher und es "
	   "wird immer heisser. Dann taucht Dein Koerper in die Lava ein "
	   "und Du hast das Gefuehl, als wuerdest Du bei lebendigem Leibe "
	   "schmelzen. Ploetzlich jedoch ist unter Dir nur Luft und Du "
	   "faellst noch ein kleines Stueckchen, bis Du einen harten Aufprall "
	   "spuerst.\n"));
  TP->reduce_hit_point(100);
  call_out("move", 5);
}

move()
{
  TP->move(LAVA("mhoehle:"+getuid(TP)), M_GO);
} 




