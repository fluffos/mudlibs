#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Hoehlengang" );
  SetProp( P_INT_LONG,
    "Der Hoehlengang scheint hier nun merklich weiter zu werden. Richtung "
    "Osten hin kann man beinahe schon wieder von einer Hoehle sprechen, die "
    "Waende weiten sich naemlich aus und auch die Decke wird merklich "
    "hoeher. Dir schien es soeben, als haettest Du im Suedosten etwas "
    "glitzern gesehen. Du gruebelst eine Weile, kommst dann aber zu dem "
    "Schluss, dass dies wahrscheinlich nur eine Taeuschung war.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"gang", "hoehlengang"}),
             "Der Hoehlengang wird wesentlich weiter hier.");
  AddDetail( "hoehle",
             "Im Osten und Suedosten scheint sich die Hoehle weiter "
             "auszudehnen.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Die Waende verbreitern sich zunehmends.");
  AddDetail( "decke",
             "Die Decke wird wieder etwas hoeher ueber Deinem Kopf.");
  AddDetail( "boden",
             "Der Boden unter Deinen Fuessen ist ganz glatt und glaenzend. "
             "Trotz Hunderten von Jahren scheint sich kaum Staub hier "
             "angesammelt zu haben.");
  AddDetail( ({"jahre", "zwergengedenken"}),
             "Diese Hoehle gib es bestimmt schon seit Zwergengedenken.");
  AddDetail( "staub", 
             "Nur hie und da ist ein wenig Staub in der Hoehle zu sehen.");
  AddDetail( "etwas",
             "Dir war, als haette da im Suedosten etwas kurz aufgefunkelt.");
  AddDetail( "glitzern",
             "Hmm... es war wohl doch nur eine Taeuschung.");
  AddDetail( "weile",
             "Du stehst eine Weile da und kratzt Dich am Kopf.");
  AddDetail( "kopf",
             "Ja, Du hast so etwas, obwohl Du es nur selten benutzt.");
  AddDetail( "taeuschung",
             "Du hast Dir das Glitzern wahrscheinlich nur eingebildet. Du bist "
             "anscheinend schon zu lange hier unten.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"totenstille", "stille", "laut"}),
    "Du hoerst nicht den geringsten Laut.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddItem( NPC("fmaus2"), REFRESH_DESTRUCT);

  AddExit( "suedwesten", TROPFST("khoehle2"));
  AddExit( "osten", TROPFST("khoehle4"));
  AddExit( "suedosten", TROPFST("khoehle5"));
}
