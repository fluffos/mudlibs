******************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Die Lava tief unter Dir brodelt leise vor "
    "sich hin und schlaegt grosse Blasen, die dann mit einem lauten "
    "BLUBB! zerplatzen und das Magma davonspritzen lassen. Manchmal sind "
    "die Blasen sogar so gross, dass das Magma bis zu Dir hochspritzt. "
    "Es waere vielleicht besser, wenn Du wieder rasch von hier "
    "verschwinden wuerdest, bevor Dir ein solcher Spritzer noch ein "
    "Andenken fuers Leben ins Gesicht brennt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"lava", "magma"}),
	     "Zwanzig Meter unter Dir brodelt die gluehende Lava.");
  AddDetail( ({"lavablasen", "blasen", "blase", "lavablase"}),
	     "Die brodelnde Lava schlaegt gelegentlich grosse Blasen, "
	     "die zerplatzen und die Lava hochspritzen lassen.");
  AddDetail( ({"spritzer", "lavaspritzer"}),
	     "Pass bloss auf, dass Dich kein solcher Spritzer erwischt! "
	     "Das koennte naemlich ziemlich ungesund werden und Dir "
	     "einige bleibende Merkmale hinterlassen...");
  AddDetail( ({"merkmale", "andenken"}),
	     "Sollte Dich so ein Lavaspritzer im Gesicht treffen, hast "
	     "Du damit bestimmt ein Andenken fuers Leben.");
  AddDetail( ({"gesicht", "gesichtchen"}),
	     "Du willst doch Dein schoenes Gesichtchen nicht entstellen, "
	     "oder?");
  AddDetail( "leben",
	     "Es gibt einstweilen noch keine Schoenheitschirurgen im "
	     "SilberLand, die solch haessliche Narben wegmachen "
	     "koennten.");
  AddDetail( ({"narbe", "narben"}),
	     "So ein Lavaspritzer wuerde bestimmt eine huebsche Narbe "
	     "in Deinem Gesicht hinterlassen.");
  AddDetail( ({"chirurg", "schoenheitschirurg"}),
	     "Du kannst ja einen proggen ;)");
  AddDetail( "hoehle",
	     "Die Hitze in der Hoehle is unertraeglich.");
  AddDetail( "hitze",
	     "Du wuenscht Dir nicht sehnlicher, als ein kuehles Plaetzchen.");
  AddDetail( "plaetzchen",
	     "Na dann verschwinde von hier und such Dir doch eins!");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss.");
  AddDetail( "fuesse",
	     "Sie brennen schon ganz fuerchterlich.");
  AddDetail( ({"waende", "wand", "decke"}),
	     "Waende und Decke bestehen aus dunkelfaerbigem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkels Lavagestein, nichts besonderes.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddCmd( ({"tauche", "tauch"}), "glut");
  AddCmd( ({"springe", "spring"}), "lava");

  AddItem( NPC("zyklop"), REFRESH_DESTRUCT);

  AddExit( "suedwesten", LAVA("lava10"));
}

glut( str )
{
  write("Hier kannst Du nirgends hintauchen, hoechstens springen.\n");
  say(BS(CAP_TPN+" hat scheinbar irgendeinen Bloedsinn vor.\n"));
  return 1;
}

lava( str )
{
  object ob;

  notify_fail("Wohin willst Du springen?\n");
  if(str=="in lava"||str=="in glut")
    {
    write(BS("Du stehst unentschlossen am Rand des Lavablocks... Du "
	     "ueberlegst und ueberlegst, nimmst Dir schliesslich aber "
	     "ein Herz und springst von dem Lavablock weg. Alles "
	     "geschieht wie in Zeitlupe. Es wird heisser und heisser, "
	     "die Lava unter Dir kommt immer naeher, naeher, naeher... \n"));
    say(BS("Du traust Deinen Augen nicht, als "+TPN+" ploetzlich vor Dir "
           "einfach vom Felsblock wegspringt und in die Lava taucht.\n"));
    if(!ob=present("kristallplatte", TP))
      {
      call_out("tod", 5);
      return 1;
      }
    if((ob->QueryProp(P_JUMP))!=2)
      {
      call_out("tod", 5);
      return 1;
      }
    call_out("leben", 5);
    return 1;
    }
  else
    return 0;
}

tod()
{
  write(BS("Es war wohl keine so gute Idee, hier runterzuspringen. Wie kann "
	   "man auch nur so bloed sein, anzunehmen, dass man einen Sprung "
	   "in die Lava ueberleben koennte ... Du spuerst nur noch, wie "
	   "Dein Koerper von ueberwaeltigender Hitze eingeschlossen wird, "
	   "und dann...\n"));
  TP->die();
}

leben()
{
  write(BS("Du hast panische Angst. Die Lava kommt immer naeher und es "
	   "wird immer heisser. Dann taucht Dein Koerper in die Lava ein "
	   "und Du hast das Gefuehl, als wuerdest Du bei lebendigem Leibe "
	   "schmelzen. Ploetzlich jedoch ist unter Dir nur Luft und Du "
	   "faellst noch ein kleines Stueckchen, bis Du einen harten Aufprall "
	   "spuerst.\n"));
  TP->reduce_hit_point(100);
  call_out("move", 5);
}

move()
{
  TP->move(LAVA("mhoehle:"+getuid(TP)), M_GO);
} 












