#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf der suedwestlichen Ecke eines Lavablocks. Von hier "
    "aus scheint der Lavablock viereckig zu sein. Im Norden grenzt er sogar "
    "an die felsige Hoehlenwand an. Dies hier scheint das noerdlichste Ende "
    "der Lavahoehle zu sein. Geradeaus, ein Stueckchen weiter im Norden, "
    "siehst Du ein dunkles Loch in der Wand. Es koennte sich vielleicht um "
    "einen Gang handeln, sicher bist Du Dir dabei allerdings nicht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]) );

  AddDetail( ({"ecke", "eck"}),
	     "Das ist die suedwestliche Ecke des Lavablocks.");
  AddDetail( ({"block", "lavablock"}),
	     "Der Lavablock scheint ziemlich genau viereckig zu sein. Im "
             "Norden grenzt er an die Hoehlenwand.");
  AddDetail( ({"wand", "hoehlenwand"}),
	     "Der Lavablock grenzt im Norden an die Hoehlenwand an. In der "
             "Wand erkennst Du ein grosses, dunkles Loch.");
  AddDetail( "loch",
	     "Es koennte sich bei dem Loch um einen Gang handeln, Du bist "
	     "Dir von dieser Entfernung allerdings nicht sicher.");
  AddDetail( "entfernung",
	     "Da die Luft durch die enorme Hitze permanent flimmert, kannst "
             "Du nicht mit Sicherheit sagen, worum es sich bei dem "
             "grossen, dunkeln Loch in der Hoehlenwand handelt.");
  AddDetail( "luft",
	     "Durch die Hitze wird die Luft in ein dauerhaftes Flirren "
             "versetzt.");
  AddDetail( "flirren",
	     "Die Luft flirrt durch die Hitze.");
  AddDetail( "hitze",
	     "Es ist immer noch unglaublich heiss hier drinnen.");
  AddDetail( ({"ende", "teil"}),
	     "Du scheinst hier im noerdlichsten Teil der Hoehle angelangt "
             "zu sein, weil ein Stueckchen weiter vor Dir die Hoehlenwand "
             "in die Hoehe ragt.");
  AddDetail( ({"hoehle", "lavahoehle"}),
	     "Ja, das hier scheint der noerdlichste Lavablock der Hoehle "
	     "zu sein, sofern Du das von hier beurteilen kannst.");
  AddDetail( "sicherheit",
	     "Nein, sicher bist Du nicht.");
  AddDetail( "gang",
	     "Du kannst von hier nicht genau erkennen, ob es sich um "
             "einen Gang handelt oder nicht, kannst Dir allerdings nicht "
             "vorstellen, was es sonst sein sollte.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss.");
  AddDetail( ({"fuesse", "fuss"}),
	     "Sie brennen schmerzhaft.");
  AddDetail( ({"waende", "hoehlenwaende", "decke"}),
	     "Waende und Decke bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( ({"lava", "magma"}),
	     "Die Magma brodelt zwanzig Meter unter Dir vor sich hin.");

  AddSound( DEFAULT_SOUND,
            "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
            "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
            "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
            "Atme lieber nicht zu tief ein.");

  AddCmd( ({"tauche", "tauch"}), "glut");
  AddCmd( ({"springe", "spring"}), "lava");

  AddItem( NPC("zyklop"), REFRESH_DESTRUCT);

  AddExit( "norden", LAVA("lava19"));
  AddExit( "osten", LAVA("lava16"));
  AddExit( "nordosten", LAVA("lava18"));
}

glut( str )
{
  write("Hier kannst Du nirgends hintauchen, hoechstens springen.\n");
  say(BS(CAP_TPN+" hat scheinbar irgendeinen Bloedsinn vor.\n"));
  return 1;
}

lava( str )
{
  object ob;

  notify_fail("Wohin willst Du springen?\n");
  if(str=="in lava"||str=="in glut")
    {
    write(BS("Du stehst unentschlossen am Rand des Lavablocks... Du "
	     "ueberlegst und ueberlegst, nimmst Dir schliesslich aber "
	     "ein Herz und springst von dem Lavablock weg. Alles "
	     "geschieht wie in Zeitlupe. Es wird heisser und heisser, "
	     "die Lava unter Dir kommt immer naeher, naeher, naeher... \n"));
    say(BS("Du traust Deinen Augen nicht, als "+TPN+" ploetzlich vor Dir "
           "einfach vom Felsblock wegspringt und in die Lava taucht.\n"));
    if(!ob=present("kristallplatte", TP))
      {
      call_out("tod", 5);
      return 1;
      }
    if((ob->QueryProp(P_JUMP))!=3)
      {
      call_out("tod", 5);
      return 1;
      }
    call_out("leben", 5);
    return 1;
    }
  else
    return 0;
}

tod()
{
  write(BS("Es war wohl keine so gute Idee, hier runterzuspringen. Wie kann "
	   "man auch nur so bloed sein, anzunehmen, dass man einen Sprung "
	   "in die Lava ueberleben koennte ... Du spuerst nur noch, wie "
	   "Dein Koerper von ueberwaeltigender Hitze eingeschlossen wird, "
	   "und dann...\n"));
  TP->die();
}

leben()
{
  write(BS("Du hast panische Angst. Die Lava kommt immer naeher und es "
	   "wird immer heisser. Dann taucht Dein Koerper in die Lava ein "
	   "und Du hast das Gefuehl, als wuerdest Du bei lebendigem Leibe "
	   "schmelzen. Ploetzlich jedoch ist unter Dir nur Luft und Du "
	   "faellst noch ein kleines Stueckchen, bis Du einen harten Aufprall "
	   "spuerst.\n"));
  TP->reduce_hit_point(100);
  call_out("move", 5);
}

int move(string dir)
{
  if(!interactive(TP)) return 0;
  TP->move(LAVA("mhoehle:"+getuid(TP)),M_SILENT|M_NOCHECK);
  return 1;
} 
