// Thor@SilberLand
// Die Wohnung eines Zwergenschmiedes - zwerg_wohnung.c
// 1997-04-21

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Wohnung eines Zwergenschmiedes" );
  SetProp( P_INT_LONG,
    "Zu Deiner Verblueffung stehst Du hier in einer kleinen, geraeumigen "
    "Wohnhoehle. In der linken, hinteren Ecke steht ein aus Gusseisen "
    "geschmiedeter Herd mit einigen, eher verschmutzten Toepfen und Schalen, "
    "die rundherum an Haken in der Wand haengen. In der rechten, hinteren "
    "Ecke steht ein kleines, unordentliches Bett. Der Grossteil des Raumes "
    "jedoch wird von einer Esse, in der ein gluehendes Feuer brennt, "
    "eingenommen. In der Mitte des Raumes steht ein grosser Amboss mit einem "
    "Stueck gluehenden Metalles darauf. Davor steht ein bulliger, aeusserst "
    "kraeftig aussehender Zwerg, der mit einem massiven Hammer geschickt dem "
    "gluehenden Eisen eine Form gibt. An den Waenden links und rechts haengt "
    "eine Vielzahl verschiedenster Werkzeuge und in der rechten vorderen Ecke "
    "ist ein grosser Haufen Kohlen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 25]) );

  AddDetail( "verblueffung",
             "Du bist aeusserst erstaunt, hier in dieser verlassenen Hoehle "
             "eine kleine Wohnung zu finden.");
  AddDetail( ({"wohnung", "wohnhoehle", "hoehle", "raum"}),
             "Die Wohnhoehle ist ziemlich geraeumig, jedoch mit allerlei "
             "Geraetschaften angefuellt. Am besten, Du siehst Dich etwas "
             "naeher um.");
  AddDetail( "geraetschaften",
             "Links und rechts an den Waenden haengen die verschiedensten "
             "Werkzeuge.");
  AddDetail( ({"ecke", "ecken"}),
             "Links hinten steht ein gusseisener Herd, gegenueber siehst Du "
             "ein eher unordentliches Bett und in der rechten, vorderen Ecke "
             "liegt ein grosser Haufen Kohlen.");
  AddDetail( "gusseisen",
             "Der Herd ist aus massivem Gusseisen geschmiedet.");
  AddDetail( "herd",
             "Der Herd ist sehr sorgfaeltig aus Gusseisen geschmiedet. Es "
             "brennt kein Feuer darin, rund herum liegt etwas Brennholz "
             "aufgestapelt und an der Wand daneben haengen einige Toepfe und "
             "Schalen.");
  AddDetail( ({"holz", "brennholz"}),
             "Neben dem Herd ist etwas Brennholz aufgestapelt.");
  AddDetail( ({"toepfe", "schalen"}),
             "Die Toepfe und Schalen, die an der Wand haengen, sind etwas "
             "verschmutzt, jemand hat sich hier wohl keine grosse Muehe "
             "gemacht, sie zu saeubern. Die Toepfe sind aus Eisen gefertigt, "
             "die Schalen sind aus Holz.");
  AddDetail( ({"wand", "haken"}),
             "In die Waende sind ueberall Haken eingeschlagen, an denen die "
             "verschiedensten Dinge haengen.");
  AddDetail( "waende",
             "Die Waende sind ganz russig von dem riesigen Feuer, das in der "
             "Esse brennt. Rundherum sind einige Haken eingeschlagen, an "
             "denen verschiedene Dinge haengen.");
  AddDetail( "dinge",
             "Toepfe, Schalen und Werkzeuge haengen an den Haken in der "
             "Wand.");
  AddDetail( "bett",
             "Das Bett in der rechten, hinteren Ecke ist zerwuehlt und "
             "unordentlich. Eine rote Decke liegt zusammengeknuellt am "
             "Fussende.");
  AddDetail( "fussende",
             "Am Fussende liegt eine rote, zusammengeknuellte Decke.");
  AddDetail( "esse",
             "An der rechten Wand steht eine grosse Esse, in der ein "
             "gleissendes Feuer brennt. Ein Haufen gluehender Kohlen liegt "
             "darauf und darinnen liegen einige Stuecke gluehenden Eisens. "
             "Von der Esse geht eine gewaltige Hitze aus und Waende und "
             "Decke sind schon ganz russig vom Feuer.");
  AddDetail( "feuer",
             "In der Esse brennt ein heisses Feuer, von dem eine beinahe "
             "unertraegliche Hitze ausgeht.");
  AddDetail( "hitze",
             "Wegen des Feuers in der Esse ist es sehr heiss im Raum. Dir "
             "rinnt bereits der Schweiss von der Stirn.");
  AddDetail( "schweiss",
             "Mit einer laessigen Handbewegung wischst Du ihn weg.");
  AddDetail( "stirn",
             "Dir rinnt der Schweiss daran herunter.");
  AddDetail( "amboss",
             "In der Mitte des Raumes steht ein grosser, massiver Amboss, auf "
             "dem ein Stueck gluehendes Metall liegt. Vor dem Amboss steht "
             "ein bulliger Zwerg, der mit einem Hammer das Metall "
             "bearbeitet.");
  AddDetail( "mitte",
             "In der Mitte des Raumes steht ein grosser Amboss. Davor steht "
             "ein bulliger Zwerg.");
  AddDetail( "stuecke",
             "In der Esse liegen einige Stuecke gluehenden Eisens.");
  AddDetail( "eisen",
             "Das Eisen in der Esse ist gelblich gluehend. Es ist besser, "
             "wenn Du es nicht anfasst.");
  AddDetail( ({"metall", "stueck"}),
             "Der Zwerg bearbeitet das gluehende Stueck Metall geschickt mit "
             "einem Hammer.");
  AddDetail( "hammer",
             "Mit einem bereits ziemlich abgenutzen Hammer schlaegt der Zwerg "
             "auf das Stueck Metall ein und formt es so geschickt zu einem "
             "bislang noch unerkennbaren Gegenstand.");
  AddDetail( "gegenstand",
             "Man kann noch nicht erkennen, was aus dem Stueck Metall werden "
             "soll.");
  AddDetail( "form",
             "Man wuerde dem Zwerg auf den ersten Blick nicht so viel "
             "Geschicklichkeit zuerkennen, mit der er dem Metall eine Form "
             "gibt.");
  AddDetail( "geschicklichkeit",
             "Trotz seines bulligen Aussehens ist der Zwerg aeusserst "
             "geschickt.");
  AddDetail( "aussehen",
             "Sei lieber besorgt um Dein eigenes Aussehen.");
  AddDetail( "vielzahl",
             "Eine Vielzahl verschiedenster Werkzeuge haengt an Haken an den "
             "Waende.");
  AddDetail( ({"werkzeug", "werkzeuge"}),
             "Haemmer, Zangen und andere Werkzeuge, die man zur Bearbeitung "
             "von Metall braucht, haengen an den Waenden.");
  AddDetail( "bearbeitung",
             "Ja, man braucht zur Bearbeitung von Metall verschiedene "
             "Werkzeuge. Mit blossen Haenden wuerde sich das ja doch etwas "
             "schwierig gestalten.");
  AddDetail( "haende",
             "Pass bloss auf, damit Du sie Dir nicht schmutzig machst.");
  AddDetail( ({"haemmer", "zangen"}),
             "Haemmer in den verschiedensten Groessen haengen an Haken an den "
             "Waenden und dazwischen auch lange Zangen, um das gluehende "
             "Eisen aus dem Feuer zu holen.");
  AddDetail( "haufen",
             "In der rechten, vorderen Ecke liegt ein grosser Haufen Kohlen.");
  AddDetail( "kohlen",
             "Die Kohlen sind wohl dazu da, um das gleissende Feuer in der "
             "Esse zu schueren.");
  AddDetail( "decke",
             "Die Decke ist schon ganz russig von dem grossen Feuer.");
  AddDetail( "boden",
             "Der Boden besteht aus festgestampfter Erde.");
  AddDetail( "erde",
             "Der Zwerg muss sie wohl hier hereingebracht haben.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Knistern des flackernden Feuers in der Esse.");
  AddSound( ({"feuer", "knistern"}),
    "Das leise Knistern des Feuers erfuellt den Raum.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft in der Wohnhoehle ist stickig und heiss.");
  AddSmell( "luft",
    "Die Luft hier drinnen ist ziemlich heiss.");

  AddCmd( ({ "fass", "fasse", "greif", "greife" }), "eisen" );

  AddItem( NPC("artox") , REFRESH_REMOVE);

  AddExit( "sueden", HOEHLE("hoehle8"));
}

eisen( str )
{
   notify_fail( "Was willst Du anfassen?\n" );
  if( str == "eisen an" )
    {
    write(BS("Du greifst mit Deiner Hand in das Feuer hinein und schreist "
             "vor Schmerz laut auf. Sofort ziehst Du die Hand wieder "
             "zurueck, allerdings sind einige dicke Brandblasen darauf.\n"));
    say(BS( CAP_TPN+" greift mit der Hand in das Feuer, schreit laut auf "
             "und zuckt sofort wieder zurueck.\n"));
    TP->do_damage(40+random(20));
    return 1;
    }
  else
    return 0;
}


