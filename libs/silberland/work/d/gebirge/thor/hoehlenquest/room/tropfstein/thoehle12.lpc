// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle12.c
// 1997-05-22

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Die Schoenheit der Hoehle wird mit jedem Schritt ueberwaeltigender. "
    "Links neben Dir ist ein maechtiger Wall aus dem Fels herausgewachsen. "
    "Die riesige Anhaeufung von Kalkgestein erinnert Dich an einen gewaltigen "
    "Wasserfall. Es scheint, als waere er waehrend des Herunterdonnerns aus "
    "der Decke versteinert worden. Es ist wirklich eine beeindruckende "
    "Erscheinung.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "schoenheit",
             "Die Hoehle wird mit jedem Schritt schoener.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Du bist immer noch fasziniert von dem Anblick der Hoehle.");
  AddDetail( "anblick",
             "Er ist ueberwaeltigend.");
  AddDetail( "wall",
             "Ein riesiger Wall von Tropfstein ist aus der suedlichen Wand "
             "herausgewachsen.");
  AddDetail( ({"tropfstein", "tropfsteine"}),
             "Die Tropfsteine an der suedlichen Wand sind zu einem gewaltigen "
             "Wasserfall zusammengewachsen.");
  AddDetail( "wand",
             "Die suedliche Wand ist aeusserst beeindruckend. Es scheint ein "
             "steinerner Wasserfall hier festgehalten zu sein.");
  AddDetail( ({"fels", "gestein", "kalkgestein"}),
             "Hier ist alles aus Kalkgestein.");
  AddDetail( "anhaeufung",
             "Die Anhaeufung von Kalkgestein erinnert an einen gewaltigen "
             "Wasserfall.");
  AddDetail( "wasserfall",
             "An der suedlichen Wand scheint ein gewaltiger Wasserfall fuer "
             "ewig im Fels festgehalten zu sein. Er waechst ganz oben, etwa "
             "15 Meter ueber Dir, an der Wand heraus und erweckt den "
             "Eindruck, durch den Boden weiter in die Tiefe zu stuerzen. Du "
             "hast selten zuvor etwas derartig wunderbares gesehen.");
  AddDetail( ({"eindruck", "erscheinung"}),
             "Du stehst voller Bewunderung vor dem gewaltigen steinernen "
             "Wall.");
  AddDetail( "decke",
             "Der Wasserfall scheint kurz unter der Decke aus der Wand zu "
             "wachsen.");
  AddDetail( "waende",
             "Die Waende schimmern feucht.");
  AddDetail( "boden",
             "Es erweckt den Eindruck, als wuerde der Wasserfall einfach "
             "durch den Boden hindurchdonnern, wenn er nicht versteinert "
             "waere.");
            
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Tropfen des Wassers.");
  AddSound( ({"wasser", "tropfen", "geraeusch"}),
    "Ein beruhigendes Geraeusch.");  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddItem( NPC("hwolf"), REFRESH_DESTRUCT);
 
  AddExit( "suedosten", TROPFST("thoehle10"));
  AddExit( "suedwesten", TROPFST("thoehle13"));
}
