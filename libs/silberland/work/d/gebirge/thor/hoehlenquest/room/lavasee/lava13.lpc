#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Du bist hier auf der westlichen Ecke eines Lavablocks. "
    "Richtung Suedwesten kommst Du wieder auf eine Bruecke. "
    "Dir bietet sich hier der gleiche Anblick wie sonst ueberall "
    "in dieser Hoehle auch. Die brodelnde Lava unter Dir, die "
    "unertraegliche Hitze, der brennend heisse Boden unter "
    "Deinen Fuessen, dunkles Lavagestein, fuerchterlicher "
    "Schwefelgestank und soweit das Auge reicht nur rot "
    "gluehende Magma.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"ecke", "eck"}),
	     "Das ist das westliche Eck des Lavablocks.");
  AddDetail( ({"block", "lavablock"}),
	     "Darauf stehst Du gerade.");
  AddDetail( "bruecke",
	     "Im Suedwesten ist wieder eine Bruecke.");
  AddDetail( "anblick",
	     "Du hast schoen langsam genug von dem hoellischen "
	     "Anblick.");
  AddDetail( "hoehle",
	     "Eigentlich sieht die Hoehle ueberall gleich aus.");
  AddDetail( ({"lava", "magma"}),
	     "Etwa zwanzig Meter unter Dir brodelt die Lava.");
  AddDetail( "hitze",
	     "Du willst endlich raus aus dieser Hitze.");
  AddDetail( "boden",
	     "Der Boden unter Deinen Fuessen ist gluehend heiss.");
  AddDetail( "fuesse",
	     "Sie brennen fuerchterlich.");
  AddDetail( ({"lavagestein", "gestein"}),
	     "Wie ueberall... dunkel und heiss.");
  AddDetail( ({"schwefel", "gestank", "schwefelgestank"}),
	     "Der Schwefel stinkt auch hier fuerchterlich.");
  AddDetail( "auge",
	     "Soweit Du nur sehen kannst, siehst Du bis auf die "
	     "vereinzelten Lavabloecke nur Magma und Lava und "
	     "Magma und Lava und nochmal Magma und nochmal Lava, "
	     "bis zu den Hoehlenwaenden hin.");
  AddDetail( ({"lavabloecke", "bloecke"}),
	     "Hier und da ragen einige Lavabloecke aus der Magma heraus.");
  AddDetail( ({"decke", "waende", "wand", "hoehlenwaende", "hoehlenwand"}),
	     "Die Decke und die Hoehlenwaende bestehen aus dunklem "
	     "Lavagestein.");


  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddCmd( ({"tauche", "tauch"}), "glut");
  AddCmd( ({"springe", "spring"}), "lava");

  AddExit( "nordosten", LAVA("lava15"));
  AddExit( "osten", LAVA("lava14"));
  AddExit( "suedwesten", LAVA("bruecke9"));

}

glut( str )
{
  write("Hier kannst Du nirgends hintauchen, hoechstens springen.\n");
  say(BS(CAP_TPN+" hat scheinbar irgendeinen Bloedsinn vor.\n"));
  return 1;
}

lava( str )
{
  object ob;

  notify_fail("Wohin willst Du springen?\n");
  if(str=="in lava"||str=="in glut")
    {
    write(BS("Du stehst unentschlossen am Rand des Lavablocks... Du "
	     "ueberlegst und ueberlegst, nimmst Dir schliesslich aber "
	     "ein Herz und springst von dem Lavablock weg. Alles "
	     "geschieht wie in Zeitlupe. Es wird heisser und heisser, "
	     "die Lava unter Dir kommt immer naeher, naeher, naeher... \n"));
    say(BS("Du traust Deinen Augen nicht, als "+TPN+" ploetzlich vor Dir "
           "einfach vom Felsblock wegspringt und in die Lava taucht.\n"));
    if(!ob=present("kristallplatte", TP))
      {
      call_out("tod", 5);
      return 1;
      }
    if((ob->QueryProp(P_JUMP))!=6)
      {
      call_out("tod", 5);
      return 1;
      }
    call_out("leben", 5);
    return 1;
    }
  else
    return 0;
}

tod()
{
  write(BS("Es war wohl keine so gute Idee, hier runterzuspringen. Wie kann "
	   "man auch nur so bloed sein, anzunehmen, dass man einen Sprung "
	   "in die Lava ueberleben koennte ... Du spuerst nur noch, wie "
	   "Dein Koerper von ueberwaeltigender Hitze eingeschlossen wird, "
	   "und dann...\n"));
  TP->die();
}

leben()
{
  write(BS("Du hast panische Angst. Die Lava kommt immer naeher und es "
	   "wird immer heisser. Dann taucht Dein Koerper in die Lava ein "
	   "und Du hast das Gefuehl, als wuerdest Du bei lebendigem Leibe "
	   "schmelzen. Ploetzlich jedoch ist unter Dir nur Luft und Du "
	   "faellst noch ein kleines Stueckchen, bis Du einen harten Aufprall "
	   "spuerst.\n"));
  TP->reduce_hit_point(100);
  call_out("move", 5);
}

move()
{
  TP->move(LAVA("mhoehle:"+getuid(TP)), M_GO);
} 
