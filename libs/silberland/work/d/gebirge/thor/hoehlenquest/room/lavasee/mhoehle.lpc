#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle unter der Lava" );
  SetProp( P_INT_LONG,
    "Du bist hier tief unter der Lava in einer kleinen Hoehle. "
    "Erstaunlicherweise ist es hier gar nicht so heiss, wie erwartet. "
    "Eine starke, magische Aura scheint die Hoehle zu erfuellen und "
    "umgibt sie mit einem blaeulichen Schimmern. Als Du Dich so umsiehst, "
    "merkst Du, dass alles hier drinnen aus Metall ist. Es ist schwarz, doch "
    "das blaeuliche Licht hier drinnen verleiht ihm einen glaenzenden "
    "Schimmer. Dies muss wohl der Ort sein, den Du schon so lange "
    "gesucht hast: die Hoehle des Endurium.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 30]) );
 
  AddDetail( "lava",
             "Wenn Du nach oben schaust, siehst Du eine Decke aus fluessiger "
	     "Lava. Ein unheimlicher Anblick! Nur die Magie in dieser Hoehle "
	     "scheint zu verhindern, dass sich die Hoehle einfach mit "
	     "Lava fuellt, wie es normalerweise sein sollte.");
  AddDetail( "decke",
	     "Ueber Dir siehst Du eine Decke aus Lava.");
  AddDetail( "anblick",
	     "Der Anblick ueber Dir laesst Dich schaudern.");
  AddDetail( "magie", 
	     "Die Hoehle hier muss randvoll mit Magie gefuellt sein. Anders "
	     "kann man sich das nicht erklaeren.");
  AddDetail( "hoehle",
	     "Die Hoehle besteht gaenzlich aus dem schwarzen Metall.");
  AddDetail( "aura",
	     "Die Hoehle ist von einer starken, magischen Aura erfuellt. "
	     "Selbst Du kannst die Magie foermlich spueren.");
  AddDetail( ({"licht", "schimmer", "schimmern"}),
	     "Das blaeuliche Licht, dass die Hoehle erfuellt, laesst die "
	     "Hoehle mit dem glaenzenden Metall hell schimmern.");
  AddDetail( "metall",
	     "Das Metall ist ueberall spiegelglatt, wie blankpoliert und "
	     "schwarz wie die Nacht. Es muss sich dabei wohl um das "
	     "geheimnisvolle Endurium handeln, das schon auf der "
	     "Kristallplatte erwaehnt war.");
  AddDetail( ({"platte", "kristallplatte"}),
	     "Die hast Du immer noch bei Dir.");
  AddDetail( ({"nacht", "farbe"}),
	     "Das Metall ist schwarz wie die Nacht.");
  AddDetail( "endurium",
	     "Endurium ist ein kostbares, laengst vergessen geglaubtes "
	     "Metall aus der zwergischen Kultur. Es ist haerter als "
	     "jedes andere bekannte Metall und hat starke magische "
	     "Eigenschaften. Du koenntest ja ein Stueck heraushauen.");
  AddDetail( "kultur",
	     "Das Endurium war ein wertvolles Metall in der frueheren, "
	     "zwergischen Kultur.");
  AddDetail( "eigenschaften",
	     "Das Endurium hat starke magische Eigenschaften. Das muss "
	     "genau das Richtige fuer den Zwergenschmied sein!");
  AddDetail( ({"richtige", "schmied", "zwergenschmied"}),
	     "Danach muss der Zwergenschmied die ganze Zeit gesucht haben!");
  AddDetail( "stueck",
	     "Haue schnell ein Stueck von dem Metall heraus und bring "
	     "es dem Schmied!");
  AddDetail( ({"waende", "wand"}),
	     "Die Waende bestehen so wie alles hier aus Endurium. In einer "
	     "Ecke siehst Du eine kleine Erhebung.");
  AddDetail( "ecke",
	     "In einer Ecke faellt Dir eine kleine Erhebung auf. Vielleicht "
	     "solltest Du sie Dir mal naeher ansehen.");
  AddDetail( "erhebung",
	     "Die Erhebung ist etwa zehn Zentimeter hoch, rund, und hat "
	     "einen Durchmesser von zirka einem Meter. Sonderbarerweise "
	     "schimmert sie nicht blaeulich, so wie alles hier, sondern "
	     "roetlich. Du haettest Lust, Dich einfach mal daraufzustellen.");
  AddDetail( "durchmesser",
	     "Der Durchmesser der Erhebung ist etwa ein Meter.");
  AddDetail( "boden",
	     "Auch der Boden besteht hier aus Endurium.");
  AddDetail( "ort",
	     "Das muss der Ort sein, nach dem Du so lange schon gesucht "
	     "hast.");

  AddCmd( ({"stelle", "stell", "steige", "steig"}), "teleporter");
  AddCmd( ({"schlage", "schlag", "haue", "hau"}), "metall");

  previous_object()->CustomizeObject();
}


teleporter( str )
{
  notify_fail("Wo willst Du Dich hinstellen?\n");
  if(str=="auf erhebung"||str=="auf teleporter")
    {
    write(BS("Du stellst Dich auf die runde Erhebung drauf. Ploetzlich "
	     "verstaerkt sich das rote Leuchten unter Dir und die magische "
	     "Aura verdichtet sich so sehr, dass es Dir den Atem abschnuert. "
	     "Dann wirst Du mit Urgewalten nach oben aus der Hoehle " 
	     "geschleudert und findest Dich ganz wo anders wieder ...\n"));
    call_out("move", 5);
    return 1;
    }
  else
    return 0;
}

move()
{
  TP->move(LAVA("lava1"), M_TPORT);
}

metall( str )
{
  object ob;

  notify_fail("Was willst Du herausschlagen?\n");
  if(str=="metall heraus"||str=="endurium heraus")
    {
    if(present("endurium", TP) || present("endurium", TO))
      {
      write(BS("Du hast doch schon einen Klumpen Endurium.\n"));
      return 1;
      }
    if(!ob=present("\npickel", TP))
      {
      write(BS("Du brauchst wohl noch einen Pickel um das Metall "
	       "herauszuschlagen.\n"));
      return 1;
      }
//    if((ob->QueryProp(P_WIELDED))==0)
//      {
//      write("Du musst den Pickel vorher zuecken.\n");
//      return 1;
//      }
    else
      {
      write(BS("Du holst weit mit dem Pickel aus und beginnst, ein grosses "
	       "Stueck aus dem Endurium herauszuschlagen. Es ist ziemlich "
	       "anstrengend, denn es ist auch nicht gerade kuehl hier unten. "
	       "Nach einer Weile liegt schliesslich doch ein grosser Klumpen "
	       "schwarzes Endurium vor Dir. Zufrieden betrachtest Du Dein "
	       "Werk. Nun kannst Du es aufheben und mitnehmen! Du denkst Dir, dass Du "
               "das nicht vergessen solltest!"));
      clone_object(OBJ("endurium.lpc"))->move(environment(TP), M_NOCHECK);
      return 1;
      }
    }
  else
    return 0;
}
    
