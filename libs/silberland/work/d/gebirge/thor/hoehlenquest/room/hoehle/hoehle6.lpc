// Thor@SilberLand
// Eine verschollene Hoehle - hoehle6.c
// 1997-04-19

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst hier mitten in der alten Hoehle. Suedlich von Dir ist eine "
    "kleine Nische in der Hoehle, aus der ein leises Plaetschern an Dein "
    "Ohr dringt. Das Gestein scheint hier etwas stabiler zu werden, Decke "
    "und Waende sind nicht mehr so zerklueftet und es liegen auch weniger "
    "Felsbrocken am Boden herum.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Du stehst hier in der Mitte der Hoehle. In suedlicher "
             "Richtung ist eine kleine Nische in der Hoehle.");
  AddDetail( "mitte",
             "Du stehst mitten in der Hoehle.");
  AddDetail( "nische",
             "Aus der Nische dringt ein sanftes Plaetschern.");
  AddDetail( "plaetschern",
             "Es hoert sich an, als ob hier irgendwo Wasser fliessen wuerde.");
  AddDetail( "wasser",
             "Du kannst es hoeren.");
  AddDetail( "gestein",
             "Das Gestein ist hier etwas stabiler als im westlichen Teil der "
             "Hoehle. Es sind kaum noch Risse im Fels zu erkennen.");
  AddDetail( ({"risse","riss"}),
             "Nur ab und zu ist der Fels mit einem Riss durchzogen.");
  AddDetail( "fels",
             "Er ist wesentlich kompakter und nicht mehr so bruechig.");
  AddDetail( ({"brocken", "felsbrocken"}),
             "Nur noch wenige Felsbrocken liegen am Boden herum.");
  AddDetail( "boden",
             "Der Boden ist mit etwas Staub bedeckt, vereinzelt liegen auch "
             "einige Felsbrocken herum.");
  AddDetail( ({"staub", "staubschicht", "schicht"}),
             "Der Boden ist mit einer duennen Staubschicht bedeckt.");
  AddDetail( "decke",
             "In der Decke siehst Du nur noch ganz wenige Loecher, wo etwas "
             "Gestein herausgebroeckelt ist.");
  AddDetail( "loecher",
             "Es sind fast keine mehr in der Decke zu sehen.");
  AddDetail( "waende",
             "Die Waende sind nicht mehr so zerklueftet wie im westlichen "
             "Teil der Hoehle. Sie wirken hier viel kompakter.");

  AddSound( DEFAULT_SOUND,
    "Aus dem Sueden hoerst Du ein sanftes Plaetschern.");
  AddSound( ({"wasser", "plaetschern"}),
    "Ein angenehm, beruhigendes Plaetschern dringt an Dein Ohr.");
  
  AddSmell( DEFAULT_SMELL,
    "Du atmest die kuehle Hoehlenluft ein.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Sie ist angenehm erfrischend.");

  AddItem( NPC("hbaer"), REFRESH_DESTRUCT );

  AddExit( "norden", HOEHLE("hoehle5"));
  AddExit( "osten", HOEHLE("hoehle9"));
  AddExit( "sueden", HOEHLE("hoehle7"));
  AddExit( "westen", HOEHLE("hoehle4"));
  AddExit( "nordwesten", HOEHLE("hoehle3"));
}
