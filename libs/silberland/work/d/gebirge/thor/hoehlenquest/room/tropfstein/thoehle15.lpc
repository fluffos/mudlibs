// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle15.c
// 1997-05-25

inherit "std/room";

#include "../quest.h"

#include <properties.h>
#include <language.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Du bist hier ein Stueckchen weiter noerdlich vom See. Die Tropfsteine "
    "haengen wie lange, duenne Finger von der Decke herab, die aussehen, "
    "als wuerden sie nach Dir greifen. Dein Licht wird an den feuchten "
    "Waenden gebrochen und laesst die Hoehle in einem merkwuerdigen Schimmern "
    "glaenzen. Rund um Dich sind einige Stalagmiten am Boden, teils "
    "groessere, teils kleinere. Du steigst besser nicht auf die drauf, sonst "
    "rutschst Du ab und tust Dir auch noch weh dabei.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "see",
             "Der See liegt suedlich von Dir. Von hier kannst Du noch ein "
            "wenig Dampf dort aufsteigen sehen.");
  AddDetail( "dampf",
             "Im Sueden beim See siehst Du von hier noch den Dampf "
            "aufsteigen.");
  AddDetail( ({"steine", "tropfsteine", "stalaktiten"}),
             "Die Tropfsteine an der Decke erinnern Dich die langen, duennen "
            "Finger eines Skelettes.");
  AddDetail( ({"finger", "skelett"}),
             "Die Tropfsteine sehen aus, wie die langen, duennen Finger eines "
            "Skelettes, die von oben nach Dir greifen zu scheinen.");
  AddDetail( "licht",
             "Das Licht, das Du bei Dir hast, wird ueberall in der feuchten "
            "Hoehle gebrochen.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Die Hoehle schimmert glaenzend im schwachen Licht, das Du bei "
            "Dir hast.");
  AddDetail( "schimmern",
             "Die Waende der Hoehle schimmern feucht und glaenzend.");
  AddDetail( "stalagmiten",
             "Am Boden wachsen zahlreiche Stalagmiten in die Hoehe. Sie sind "
            "nicht so lang und duenn wie die Stalaktiten an der Decke. Es "
            "sind eher kleine Huegel, die aus dem Boden herausragen.");
  AddDetail( "huegel",
             "Die Stalagmiten sehen aus, wie kleinere Huegel aus Kalkgestein. "
            "Du bleibst allerdings besser am flachen Boden und kletterst "
            "nicht irgendwo herum. Sonst rutscht Du am glitschigen Boden "
            "aus und tust Dir auch noch weh dabei.");
  AddDetail( ({"gestein", "kalkgestein"}),
             "Daraus besteht die ganze Hoehle.");
  AddDetail( "decke",
             "Lange, duenne Tropfsteine haengen von der Decke herunter.");
  AddDetail( "boden",
             "Der Boden ist ganz feucht und glitschig.");
  AddDetail( "waende",
             "Die Waende schimmern feucht und glaenzend.");
  AddDetail( ({"wasser", "tropfen", "wassertropfen"}),
             "Ein wenig Wasser tropft manchmal von der Decke herab.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst manchmal einen Wassertropfen von der Decke heruntertropfen.");
  AddSound( ({"tropfen", "wasser", "wassertropfen"}),
    "*tropf* *tropf* *tropf*");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und feucht.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Du atmest einmal tief die kuehle Hoehlenluft ein.");

  AddCmd( ({"steig", "steige", "kletter", "klettere"}), "huegel");

  AddItem( NPC("fmaus2"), REFRESH_DESTRUCT);

  AddExit( "sueden", TROPFST("thoehle14"));
  AddExit( "suedwesten", TROPFST("thoehle16"));
}

huegel( string str )
{
  notify_fail( "Wo willst Du hinaufsteigen?\n" );
  if( str == "auf huegel" || str == "auf stalagmit")
  {
    write(BS("Du versuchst, ein Stueck auf einen Stalagmiten hinaufzugehen. "
            "Du bist ganz erfreut, wie Du vorsichtig einen Fuss vor den "
            "anderen setzt. Doch ganz ploetzlich verlierst Du das "
            "Gleichgewicht auf dem rutschigen Boden, schlitterst wieder "
            "hinunter und schlaegst unten hart mit dem Kopf am felsigen "
            "Boden auf. Etwas benommen schuettelst Du den Kopf.\n"));
    say(BS(CAP_TPN+" versucht, vorsichtig ein Stueck einen Stalagmiten "
           "hochzugehen. Nach ein paar Schritten rutscht er jedoch ab, "
           "rutscht nach unten und schlaegt vor Dir hart mit dem Kopf am "
           "Boden auf. "+CAP_TPN+" schuettelt etwas benommen den Kopf.\n"));
    TP->do_damage(10+random(10));
    return 1;
  }
  return 0;
}






