// Thor@SilberLand
// Eine Hoehle - thoehle1.c
// 1997-05-12

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Der Fels in der Hoehle beginnt allmaelich wieder eine normale Farbe "
   +"anzunehmen. Man kann nur mehr eine leichte, graue Faerbung erkennen. "
   +"Die Waende sind wieder etwas breiter auseinander und auch die Decke "
   +"ist etwas hoeher. Der Gang fuehrt Richtung Westen weiter, Richtung "
   +"Nordosten zweigt ein anderer ab.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"fels", "gestein"}),
             "Das Gestein in der Hoehle hat nur noch eine leichte, graue "
            +"Faerbung.");
  AddDetail( ({"faerbung", "farbe"}),
             "Die pechschwarze Farbe des Gesteins ist hier beinahe schon "
            +"voellig verschwunden.");
  AddDetail( "hoehle",
             "Die Hoehle wird wieder etwas groesser.");
  AddDetail( ({"waende", "felswaende"}),
             "Die Felswaende lassen wieder etwas mehr Platz zum Bewegen.");
  AddDetail( "decke",
             "Du hast wieder viel mehr Platz als noch vor kurzem.");
  AddDetail( "platz",
             "Du fuehlst Dich hier wieder wesentlich wohler.");
  AddDetail( "gang", 
             "Dieser Gang hier fuehrt Richtung Westen weiter, ein anderer "
            +"zweigt Richtung Nordosten ab.");
  AddDetail( "boden",
             "Der Boden ist felsig.");
             
  AddSound( DEFAULT_SOUND,
    "Auch hier ist es still.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist erstaunlich frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordosten", TROPFST("gang1"));
  AddExit( "westen", TROPFST("thoehle2"));
  AddExit( "suedosten", TROPFST("khoehle1"));
}

