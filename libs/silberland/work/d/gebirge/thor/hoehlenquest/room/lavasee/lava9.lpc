#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Eine gluehend heisse Hitzewelle schlaegt Dir von Norden her "
    "entgegen. Um ein Haar waerst Du beinahe umgekippt. Wenn Du "
    "nach Norden blickst, siehst Du nichts weiter als eine weite "
    "Flaeche gluehende Lava. Die Lava scheint dort besonders "
    "heiss zu sein, da sie nicht mehr roetlich glueht, sondern "
    "eher schon gelblich und weisslich. Dir ist schon ganz "
    "schwindlich von der hoellischen Hitze und Deine Knie sind "
    "weich wie Gummi.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50]));

  AddDetail( ({"welle", "hitzewelle", "hammer"}),
	     "Die Hitzewelle trifft Dich wie ein Hammer mitten ins "
	     "Gesicht.");
  AddDetail( ({"gesicht", "schweiss"}),
	     "Der Schweiss rinnt Dir ueber das Gesicht.");
  AddDetail( "haar",
	     "Um ein Haar waerst Du beinahe einfach umgekippt. Das "
	     "waere wahrscheinlich Dein Tod gewesen, denn aus einer "
	     "solchen Ohnmacht erwacht wohl niemand mehr.");
  AddDetail( ({"ohnmacht", "tod"}),
	     "Sei froh, dass Du nicht ohnmaechtig geworden bist, "
	     "sonst haettest Du wahrscheinlich Lars besucht.");
  AddDetail( "lars",
	     "Ich bin mir sicher, dass Du den kennst.");
  AddDetail( "flaeche",
	     "Richtung Norden hin erstreckt sich nichts als Lava, "
	     "Lava und nochmals Lava.");
  AddDetail( "lava",
	     "Die Lava im Norden scheint besonders heiss zu sein, "
	     "da sie nicht mehr roetlich sondern schon weisslich "
	     "glueht.");
  AddDetail( "hitze",
	     "Du haeltst die Hitze hier schon beinahe nicht mehr "
	     "aus. Sie setzt Dir arg zu.");
  AddDetail( "knie",
	     "Deine Knie wollen unter Dir nachgeben.");
  AddDetail( "gummi",
	     "Genau so fuehlen sich Deine Knie an. Und Gummi "
	     "wuerde bei dieser Hitze hier wahrscheinlich schmelzen.");
  AddDetail( "boden",
	     "Der Boden brennt heiss unter Deinen Fuessen.");
  AddDetail( "fuesse",
	     "Sie schmerzen furchtbar.");
  AddDetail( ({"decke", "waende", "wand"}),
	     "Decke und Waende bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddItem( NPC("zyklop"), REFRESH_DESTRUCT);

  AddExit( "westen", LAVA("lava8"));
  AddExit( "sueden", LAVA("lava6"));
  AddExit( "suedosten", LAVA("lava7"));

}
