// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle17.c
// 1997-05-27

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "In dem kleinen See neben Dir faellt Dir ploetzlich ein sonderbares, "
   +"roetliches Leuchten auf. Es scheint von sehr tief unten zu kommen "
   +"und laesst das Wasser beinahe wie Blut aussehen. Selbst der Dampf, der "
   +"von der Wasseroberflaeche aufsteigt, scheint hier etwas roetlich zu "
   +"sein. Der See ist ein aeusserst unheimlicher, bizarrer Anblick, und Du "
   +"ueberlegst Dir, ob Du nicht besser wieder in andere Bereiche der Hoehle "
   +"gehen sollst, denn Dir ist schon reichlich mulmig im Magen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "see",
             "Im See ist von tief unten ein sonderbares, roetliches Schimmern "
            +"zu sehen. Du kannst allerdings nicht erkennen, von wo es kommt, "
            +"oder was es ist.");
  AddDetail( ({"schimmern", "leuchten", "licht"}),
             "Ein unheimliches, rotes Leuchten dringt aus den Tiefen des "
            +"unterirdischen Sees.");
  AddDetail( ({"tiefe", "tiefen"}),
             "Es ist nicht festzustellen, wie weit dieser See in die Tiefe "
            +"fuehrt. Trotz des Lichtes von tief unten kannst Du keinen "
            +"Grund erkennen.");
  AddDetail( "grund",
             "Auch wenn Du Dich noch so anstrengst, Du siehst keinen Grund in "
            +"dem See.");
  AddDetail( "wasser",
             "Das rote Leuchten laesst das Wasser des Sees hier fast wie Blut "
            +"aussehen. Es scheint sehr warm zu sein, denn es steigt ziemlich "
            +"viel Dampf davon auf. Du wuerdest gerne hineingreifen, um zu "
            +"sehen, wie warm es wirklich ist.");
  AddDetail( "blut",
             "Das rote Leuchten laesst das Wasser wie Blut aussehen.");
  AddDetail( "dampf",
             "Der Dampf sieht mit dem roetlichen Schimmern geisterhaft aus.");
  AddDetail( ({"oberflaeche", "wasseroberflaeche"}),
             "Von der Wasseroberflaeche steigt etwas Dampf auf.");
  AddDetail( "anblick",
             "Ein wirklich bizarrer Anblick bietet sich Dir hier an diesem "
            +"geisterhaften See.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Du beginnst zu ueberlegen, ob es nicht besser waere, wenn Du "
            +"wieder in nicht ganz so unheimliche Bereiche der Hoehle "
            +"zurueckgehst.");
  AddDetail( ({"magen", "gefuehl"}),
             "In Deinem Magen macht sich ein unangenehmes Gefuehl breit.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig.");
  AddDetail( "waende",
             "An den Waenden rinnt ein wenig Wasser herunter.");
  AddDetail( "decke",
             "Lange, duenne Tropfsteine haengen von der Decke herunter.");
  AddDetail( ({"steine", "tropfsteine"}),
             "Sie haengen hier ueberall von der Decke herab.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers.");
  AddSound( ({"wasser", "tropfen"}),
    "*tropf* *tropf* *tropf*");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "greif", "greife" }), "wasser" );
  AddCmd( ({"springe", "spring"}), "see");

  AddExit( "norden", TROPFST("thoehle16"));
  AddExit( "nordosten", TROPFST("thoehle14"));
  AddExit( "suedosten", TROPFST("thoehle18"));
}

wasser( str )
{
  notify_fail( "Wo willst Du hineingreifen?\n" );
  if( str == "in wasser" || str=="in wasser hinein")
  {
    write(BS("Du greifst vorsichtig mit einem Finger in das Wasser hinein und "
            +"stellst fest, dass es angehem warm ist. Es waere sogar warm "
            +"genug, um hineinzuspringen, Du bist allerdings noch etwas "
            +"unschluessig.\n"));
    say(BS(CAP_TPN+" greift in das Wasser hinein, und bleibt dann etwas "
            +"unentschlossen vor dem Ufer stehen.\n"));
    return 1;
  }
  return 0;
}

see( str )
{
  string rasse;
  rasse=TP->QueryProp(P_RACE);

  notify_fail( "Wo willst Du hineinspringen?\n" );
  if(str=="in wasser"||str=="in wasser hinein"||str=="in see"||str=="in see hinein")
    {
    switch (rasse)
      {
      case "Zwerg":  write(BS("Du stehst etwas unschluessig vor dem See "
                     +"herum und ueberlegst, ob Du da wirklich hineinspringen "
                     +"sollst. Allein bei dem Gedanken, mit Wasser, "
                     +"insbesondere mit einer solch unheimlichen Faerbung, in "
                     +"Beruehrung zu kommen, laesst ein aeusserst "
                     +"unbehagliches Gefuehl in Dir hochkommen. Nach langem "
                     +"hin und her Ueberlegen nimmst Du Dir jedoch ein Herz "
                     +"und springst in das Wasser hinein.\n\n"));
                     say(BS(CAP_TPN+" steht mit einer etwas unliebsamen Miene "
                     +"vor dem See und springt schliesslich in das Wasser "
                     +"hinein.\n"));
                     break;
      case "Hobbit": write(BS("Angstvoll blickst Du in das Wasser hinein. Bei "
                     +"dem Gedanken, da hineinzuhuepfen, straebt sich jedes "
                     +"einzelne Haar an Deinem Koerper und davon hast Du ja "
                     +"schliesslich genung. Nach einem langem Kampf mit Dir "
                     +"selbst ueberwindest Du schliesslich Deine Panik und "
                     +"springst in das Wasser hinein.\n\n"));
                     say(BS(CAP_TPN+" steht mit angstverzerrtem Gesicht vor "
                     +"dem kleinen See und tritt von einem Bein auf das "
                     +"andere. Nach einiger Zeit springt "+TPN+" in den See "
                     +"hinein.\n"));
                     break;
      default:       write(BS("Dir ist zwar etwas mulmig im Bauch, wenn Du "
                     +"das rote Leuchten im Wasser so betrachtest, aber Du "
                     +"zoegerst nicht lange und springst in das Wasser "
                     +"hinein.\n\n"));
      }
    TP->move(TROPFST("wasser1"), M_GO, "", "springt in den kleinen See hinein", "platscht herein");
    return 1;
    }
  return 0;
}  







