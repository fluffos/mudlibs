#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Kristallhaufen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier mitten in den Kristallbrocken. Dein Kopf schmerzt "
   +"von einem Brocken, der Dir genau darauf gefallen ist. Tja, hier steckst "
   +"Du wohl in einem ziemlichen Schlamassel. Du kannst Dich so gut wie "
   +"ueberhaupt nicht ruehren. Es sieht fast so aus, als muesstest Du warten, "
   +"bis irgendjemand kommt, und Dich da rausholt...");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );
 
  AddCmd(({"untersuche", "unt"}), "raum");
}

raum()
{
  write(BS("Hier ist es viel zu eng, als dass Du irgendetwas untersuchen "
          +"koenntest.\n"));
  return 1;
}





