*  Thor@SilberLand          *
*  Ein Lavablock - lava4.c  *
*  1997-08-08               *
****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
	"Du stehst hier am Westende des Lavablocks. Direkt vor Dir "
    "fuehrt eine Bruecke Richtung Nordwesten weiter zu einem "
    "weiteren Block. Gleich neben Dir im Osten erkennst Du eine "
    "Vertiefung mitten im Lavagestein, in der es rot-gelblich "
    "glueht. Von dort scheint auch eine noch enormere Hitze "
    "auszugehen, als sie hier ohnehin schon herrscht. Der "
    "Schweiss rinnt Dir beinahe schon in Baechen die Stirn "
    "herunter und Dein Mund ist trocken wie ein Blatt Papier. "
    "Hier unten ist wahrlich die reinste Hoelle.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"ende", "westende"}),
	     "Wenn Du noch weiter nach Westen gehst, plumpst Du "
	     "in die Lava und bist somit nur noch Rauch und "
	     "Asche.");
  AddDetail( ({"rauch", "asche"}),
	     "Viel mehr wird von Dir wohl nicht uebrig bleiben, "
	     "solltest Du so ungeschickt sein und in die Lava "
	     "fallen.");
  AddDetail( ({"block", "lavablock"}),
	     "Nordwestlich von Dir ist noch ein weiterer "
	     "Lavablock. Eine Bruecke fuehrt dort hin.");
  AddDetail( ({"bruecke", "bruecken"}),
	     "Eine Bruecke Richtung Nordwesten fuehrt zu noch "
	     "einem Lavablock.");
  AddDetail( "vertiefung",
	     "Ein kleines Stueckchen weiter oestlich siehst Du "
	     "eine Vertiefung etwa in der Mitte des Lavablocks. "
	     "Du erkennst eine gelblich-rote Glut darin, "
	     "recht viel mehr ist von hier allerdings nicht zu "
	     "erkennen.");
  AddDetail( "glut",
	     "Du solltest naeher ran gehen, wenn Du genaueres "
	     "wissen moechtst.");
  AddDetail( "hitze",
	     "Eine enorme Hitze geht von der Vertiefung oestlich "
	     "von Dir aus. Du haettest es nicht fuer moeglich "
	     "gehalten, dass es noch heisser werden kann.");
  AddDetail( ({"schweiss", "baeche", "stroeme"}),
	     "Der Schweiss rinnt Dir in Stroemen am Gesicht "
	     "herunter und brennt hoellisch in Deinen Augen.");
  AddDetail( ({"stirn", "gesicht"}),
	     "Du bist von oben bis unten schweissgebadet.");
  AddDetail( "augen",
	     "Deine Augen schmerzen einerseits aufgrund dieser "
	     "hoellischen Hitze hier, andererseits aufgrund des "
	     "Schweisses, der Dir gelegentlich hineinrinnt.");
  AddDetail( "mund",
	     "Dein Mund ist von der Hitze so ausgetrocknet, wie "
	     "ein Blatt Sandpapier.");
  AddDetail( ({"papier", "sandpapier", "blatt"}),
	     "So fuehlt sich Dein Mund an.");
  AddDetail( "hoelle",
	     "Wenn nun ploetzlich eine Gestalt mit Hoernern und "
	     "Pferdefuss auftauchen wuerde, waerst Du nichtmal "
	     "mehr ueberrascht.");
  AddDetail( ({"gestalt", "hoerner", "pferdefuss"}),
	     "Dich wuerde es nichtmal mehr ueberraschen, wenn "
	     "eine Gestalt mit Hoerner und Pferdefuss "
	     "auftauchen wuerde.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( "lava",
	     "Die Lava brodelt etwa zwanzig Meter unter Dir.");
  AddDetail( "hoehle",
	     "Diese Hoehle ist wahrlich die reinste Hoelle.");
  AddDetail( "boden",
	     "Der Boden ist hier nicht ganz so heiss, wie auf den "
	     "Bruecken, aber Dir erscheint immer noch, als "
	     "stuendest Du auf einem Grill.");
  AddDetail( "grill",
	     "Ein paar Minuten noch, dann bist Du gut durch.");
  AddDetail( "decke",
	     "Die Decke besteht aus dunklem Lavagestein.");
  AddDetail( ({"waende", "wand", "hoehlenwaende", "hoehlenwand"}),
	     "An den Waenden der Hoehle erkennst Du geringe "
	     "Spuren von Metall.");
  AddDetail( ({"spuren", "metall"}),
	     "Du erkennst ein paar spaerliche Spuren von Metall "
	     "an den Hoehlenwaenden.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddExit( "nordwesten", LAVA("bruecke6"));
  AddExit( "osten", LAVA("lava3"));
  AddExit( "suedosten", LAVA("lava5"));

}
