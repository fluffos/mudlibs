#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Der Gang, in dem Du stehst, fuehrt weiter Richtung Sueden. Hier haben "
   +"sich nun auch die letzten Felsflecken von Waenden und Decke verzogen, "
   +"und alles ist mit einer dicken, regelmaessigen Kristallschicht "
   +"ueberzogen. Nur am Boden lugt noch manchmal ein Fleckchen Fels hervor, "
   +"aber sonst wird der Kristall auch immer dichter und glatter und Du "
   +"musst bereits Acht geben, dass Du nicht ausrutscht.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "gang",
             "Der Gang fuehrt weiter nach Sueden.");
  AddDetail( "hoehle",
             "Die Hoehle ist von atemberaubender Schoenheit.");
  AddDetail( "schoenheit",
	     "Die Schoenheit der Hoehle raubt Dir den Atem.");
  AddDetail( "atem",
             "Weiteratmen! Das ist doch nur so ein Ausdruck!");
  AddDetail( ({"fleckchen", "flecken", "felsflecken", "fels", "gestein"}),
	     "An den Waenden kannst Du nicht mehr den kleinsten Flecken "
            +"Gestein erkennen, nur am Boden siehst Du noch ein wenig "
            +"grauen Fels.");
  AddDetail( ({"schicht", "kristallschicht"}),
             "An der Decke und den Waenden kannst Du nur noch Kristall "
            +"erkennen. Die Schicht, die alles ueberzieht, ist allerdings "
            +"aeusserst regelmaessig, Du kannst keine groeberen Loecher oder "
            +"Hervorhebungen sehen.");
  AddDetail( ({"loecher", "hervorhebungen", "loch", "hervorhebung"}),
	     "Du siehst nirgends welche.");
  AddDetail( ({"kristall", "kristalle"}),
	     "Der Kristall bricht das Licht in unzaehligen Farben.");
  AddDetail( "farben",
	     "Das gesamte Spektrum ist dabei.");
  AddDetail( ({"spektrum", "licht"}),
	     "Das Licht wird durch die Kristalle in allen Farben des "
	    +"Spektrums gebrochen.");
  AddDetail( "acht",
	     "Pass auf, dass Du auf dem glatten Kristallboden nicht "
            +"ausrutscht!");
  AddDetail( "decke",
	     "Dicke Kristalle haengen von der Decke herunter.");
  AddDetail( ({"waende", "wand"}),
	     "Die Waende sind mit einer dicken Kristallschicht ueberzogen.");
  AddDetail( ({"kristallboden", "boden"}),
	     "Am Boden siehst Du gelegentlich noch einige Felsflecken, aber "
            +"grossteils besteht er aus glattem Kristall.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Du hoerst nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordwesten", TROPFST("khoehle12"));
  AddSpecialExit( "sueden", "sueden");
}

int sueden(string dir)
{
  if(!interactive(TP)) return 0;
  tell_object(TP,BS(
    "Du gehst nach Sueden."));
  tell_room(TO,BS(
    TP->Name()+" geht nach Sueden."),({TP}));
  TP->move(TROPFST("khoehle14:"+getuid(TP)),M_SILENT|M_NOCHECK);
  tell_room(ENV(TP),BS(

    TP->Name()+" kommt herein."),({TP}));
  return 1;


}
