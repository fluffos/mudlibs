// Thor@SilberLand
// Ein Hoehleneingang - hoehle1.c
// 1997-04-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Hoehleneingang" );
  SetProp( P_INT_LONG,
    "Du stehst hier am Eingang einer verschollenen Hoehle. Von draussen "
    "dringen noch einige Sonnenstrahlen durch das Gebuesch am Eingang durch. "
    "Auch hier auf der anderen Seite des Eingang siehst Du die seltsamen Symbole "
    "im Fels eingraviert, ansonsten sind die Waende der Hoehle roh aus dem Fels "
    "herausgeschlagen. Du kannst nur Deine naechste Umgebung erkennen, vor Dir "
    "herrscht nur schwaerzeste Finsternis.");

  SetProp( P_LIGHT, 1 );

  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"eingang", "hoehleneingang"}),
             "Du bist am Eingang einer scheinbar sehr alten Hoehle. In den "
             "Fels am Eingang sind seltsame Symbole eingraviert.");
  AddDetail( "hoehle", 
             "Du stehst hier am Eingang der Hoehle. Du kannst nicht viel "
             "erkennen, ausser den seltsamen Symbolen rund um den "
             "Hoehleneingang, denn vor Dir herrscht nur tiefste Dunkelheit.");
  AddDetail( "fels",
             "Die Waende der Hoehle sind in den Fels hineingeschlagen. Am "
             "Eingang kannst Du seltsame Symbole in den Fels hineingraviert "
             "sehen.");
  AddDetail( "symbole",
             "Du wirst nicht schlau aus den Symbolen, nur hie und da ist ein "
             "Zeichen dabei, das Dir bekannt vorkommt.");
  AddDetail( "zeichen",
             "Einige der Symbole sehen fast aus, wie Werkzeuge. Du glaubst, "
             "einen Hammer und einen Amboss zu erkennen.");
  AddDetail( ({"werkzeug", "hammer", "amboss"}), 
             "Du erkennst einen Hammer und einen Amboss, weisst allerdings "
             "nicht, was sie hier fuer eine Bedeutung haben moegen.");
  AddDetail( "bedeutung",
             "Du kannst keinerlei Bedeutung in den Symbolen erkennen.");
  AddDetail( "waende", 
             "Die Waende der Hoehle sind grob aus dem Fels herausgeschlagen."),
  AddDetail( ({"strahlen", "sonnenstrahlen"}),
             "Einige Sonnenstrahlen dringen noch durch das Gebuesch am Eingang "
             "und erhellen die Hoehle hier ein wenig.");
  AddDetail( ({"gebuesch", "pfad", "gestruepp"}),
             "Hinter Dir ist das verwachsene Gestruepp und der Pfad ausserhalb "
             "der Hoehle.");
  AddDetail( "umgebung",
             "Du kannst nicht viel rund um Dich herum erkennen. Die Waende und "
             "die Decke der Hoehle sind grob aus dem Gestein herausgeschlagen "
             "und am Boden befindet sich noch etwas Erde von draussen.");
  AddDetail( "gestein",
             "Rund um Dich ist alles aus Fels. Nur am Boden liegt etwas Erde, "
             "die noch von draussen kommt.");
  AddDetail( "boden", 
             "Am Boden siehst Du etwas Erde verstreut.");
  AddDetail( "erde",
             "Die Erde ist wahrscheinlich durch den Wind hereingeweht worden.");
  AddDetail( ({"wind", "lueftchen"}),
             "Von draussen weht noch ein sanftes Lueftchen herein.");
  AddDetail( "decke",
             "Auch die Decke ist, wie die Waende, aus dem Fels herausgehauen.");
  AddDetail( ({"finsternis", "dunkelheit"}),
             "Vor Dir kannst Du nichts ausser tiefster Dunkelheit erkennen.");

  AddSound( DEFAULT_SOUND,
             "Von draussen hoerst Du noch das leise Wispern des Windes.");
  AddSound( ({"wispern", "wind"}),
             "Du lauschst dem Wind, den Du noch von draussen hoerst.");
    
  AddSmell( DEFAULT_SMELL,
             "Du spuerst nur die kuehle, frische Luft, die aus dem Inneren " 
             "der Hoehle hervorstroemt.");
  AddSmell( "luft", 
            "Du atmest die angenehme Luft der Hoehle ein.");

  AddExit( "westen", "/d/gebirge/thor/plateau/room/plat18" );
  AddExit( "nordosten", HOEHLE("hoehle2"));
}

