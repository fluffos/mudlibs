// Thor@SilberLand
// Eine verschollene Hoehle - hoehle8.c
// 1997-04-19

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein schmaler Hoehlengang" );
  SetProp( P_INT_LONG,
    "Du bist hier in einem schmalen Gang, der von der Hoehle abgezweigt ist. "
    "Suedwestlich von Dir liegt die Hoehle, der Gang hier fuehrt um eine "
    "Ecke Richtung Norden weiter. Decke, Waende und Boden sind hier nicht "
    "mehr so grob aus dem Fels herausgeschlagen, sondern scheinbar noch "
    "einmal genauer nachbearbeitet worden. Die Waende scheinen beinahe glatt "
    "zu sein. Aus noerdlicher Richtung scheint ein schwacher Lichtschimmer "
    "zu kommen, was Dich sehr verwundert.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "gang",
             "Der Gang fuehrt in nordoestliche Richtung von der Hoehle weg "
             "und geht hier Richtung Norden weiter.");
  AddDetail( "hoehle",
             "Die liegt suedwestlich von Dir.");
  AddDetail( "ecke",
             "Der Gang macht hier einen Knick Richtung Norden. Du kannst von "
             "hier aus nicht erkennen, was sich hinter der Ecke verbirgt.");
  AddDetail( "fels",
             "Decke, Waende und Boden sind hier etwas feiner "
             "herausgearbeitet.");
  AddDetail( "decke",
             "Die Decke ueber Dir ist felsig, scheint aber ziemlich glatt "
             "zu sein.");
  AddDetail( "boden",
             "Der Boden ist ganz blank, es liegt kein Staub und kein Gestein "
             "darauf herum. Es scheint fast, als haette hier jemand "
             "zusammengekehrt.");
  AddDetail( ({"waende", "wand"}),
             "Die Waende sind hier sorgfaeltig aus dem Fels herausgearbeitet. "
             "Hier hat jemand wirklich genaue Arbeit geleistet.");
  AddDetail( "arbeit",
             "Es muss ein langwieriges Unterfangen sein, einen Gang so "
             "sorgsam wie diesen aus dem Fels herauszuarbeiten.");
  AddDetail( ({"schimmer", "lichtschimmer"}),
             "Ein schwacher, gelblicher Lichtschimmer kommt aus noerdlicher "
             "Richtung. Leider kannst Du nicht erkennen, was sich hinter der "
             "Ecke verbirgt, sonst wuesstest Du wohl mehr. Du bist jedoch "
             "sehr verwundert, in dieser bislang absoluten Dunkelheit ein "
             "Licht zu sehen.");
  AddDetail( "dunkelheit",
             "Die Dunkelheit ist hier nicht mehr so erdrueckend, denn Du "
             "siehst ein schwaches Licht im Norden.");
  AddDetail( "licht",
             "Das Licht wirkt angenehm warm. Es ist leider noch zu weit "
             "entfernt, als dass man ohne Fackel etwas in der Hoehle "
             "erkennen kann. Du bist furchtbar neugierig, wo das Licht wohl "
             "herkommen mag.");
  AddDetail( "fackel",
             "Wichtiges Utensil, um im der Dunkelheit sehen zu koennen.");
  AddDetail( "gestein",
             "Das Gestein hier ist wieder stabil und fest. Es weist keinerlei "
             "Brueche oder Risse auf.");
  AddDetail( ({"brueche", "risse"}),
             "Der Fels hier ist sehr kompakt. Die Brueche und Risse, die man "
             "manchmal in der Hoehle gesehen hat, sind hier gaenzlich "
             "verschwunden.");
  AddDetail( "knick",
             "Leider kannst Du nur den Lichtschimmer dahinter erkennen, mehr "
             "siehst Du von hier aus nicht.");
  AddDetail( ({"staub", "staubkorn", "korn"}),
             "Es ist sehr verwunderlich, das am Boden kein einziges Staubkorn "
             "zu entdecken ist.");
  
  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");  
  AddSmell( DEFAULT_SMELL,
    "Du atmest die kuehle Hoehlenluft ein.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Sie ist angenehm erfrischend.");

  AddExit( "norden", HOEHLE("zwerg_wohnung"));
  AddExit( "suedwesten", HOEHLE("hoehle5"));
}

