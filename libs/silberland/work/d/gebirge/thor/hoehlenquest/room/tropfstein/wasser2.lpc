// Thor@SilberLand
// Ein unterirdischer See - wasser1.c
// 1997-05-30

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>
#include "/sys/thing/material.h"


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein unterirdischer See" );
  SetProp( P_INT_LONG, 
    "Du glaubst Deinen Augen nicht zu trauen, wo Du hier angekommen "
    "bist. Du schwimmst hier im Wasser in einer Aushoehlung im Felsgestein. "
    "Mehr als \"Aushoehlung\" kann man das hier wohl nicht nennen. Ueber Dir "
    "sind etwa drei Meter Platz, das Wasser breitet sich jeweils vier Meter "
    "links und rechts von Dir aus. Ein kleines Stueckchen vor Dir hoert das "
    "Wasser auf und ein drei Meter breiter Felsvorsprung beginnt. Das "
    "sonderbarste an diesem Ort, abgesehen davon, wo er sich befindet, "
    "jedoch ist ein pulsierendes, dunkelrotes Leuchten, das von den Felsen "
    "ausgeht, und der Hoehle ein unheimliches Licht verleiht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_UNDERWATER, ENV_TEMPERATURE: 25]) );

  AddDetail( "wasser",
             "Es ist ueberall um Dich herum. Man koennte auch sagen, Du "
             "schwimmst mitten drin.");
  AddDetail( "decke",
             "Die Decke besteht hir aus schroffen Felsen.");
  AddDetail( ({"fels", "felsen", "felsgestein", "gestein"}),
             "Das Felsgestein ist hier wesentlich schroffer als in der "
             "Tropfsteinhoehle. Das sonderbarste jedoch ist das dumpfe, "
             "rote Leuchten, das von den Felsen auszugehen scheint.");
  AddDetail( ({"leuchten", "licht"}),
             "Genausowenig, wie Du Dir vorstellen kannst, wie diese kleine "
             "Hoehle hier entstanden ist, kannst Du Dir vorstellen, wo "
             "dieses Leuchten herkommt. Mit dem geheimnisvollen "
             "Pulsieren wirkt es seltsamerweise unheimlich und beruhigend "
             "zugleich.");
  AddDetail( "hoehle",
             "In Deinen kuehnsten Fantasien haettest Du nicht geglaubt, dass "
             "so ein Ort existiert.");
  AddDetail( "aushoehlung",
             "Es ist mehr oder weniger eine kleine Hoehle.");
  AddDetail( ({"vorsprung", "felsvorsprung"}),
             "Ein Stueckchen vor Dir kannst Du wieder festen Boden sehen. ");
  AddDetail( "waende",
             "Die Waende sind aus schroffem Felsgestein.");
  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  
  AddCmd( ({"tauche", "tauch"}), "raus" );

  AddSpecialExit( "raus", "hoehle");
}

object dive;

init()
{
  ::init();

  if(T_LOAD > (MAX_T_LOAD + 1000))
    {
    call_out("tot", 2);
    call_out("raum", 2);
    }

}

raum()
{
  say(BS(CAP_TPN+" wird von "+((TP->QueryProp(P_GENDER)==FEMALE) ? "ihrer" : "seiner")+
        " schweren Ausruestung unter Wasser gezogen und beginnt, voller Panik "
        " zu strampeln.\n"));
}
string int_long(mixed x, mixed y, int z)

{
  if(T_LOAD < (MAX_T_LOAD + 1000))
    {
    return BS("Du schwimmst im Wasser des kleinen Sees herum. Das merkwuerdige "
         "rote Schimmern tief unten wirkt eine magische Anziehungskraft "
         "auf Dich aus. Du wuerdest gerne mal ein Stueckchen "
         "hinuntertauchen, vielleicht kannst Du ja dann mehr erkennen, was "
        "es mit diesem Leuchten auf sich hat.")+::int_long(x,y,z);
    }
  else
    {
    return BS("Es war vielleicht doch keine so gute Idee, mit soviel Ausruestung "
         "in das Wasser hineinzuspringen. Das Gewicht derselbigen zerrt Dich "
         "naemlich bereits nach unten, tiefer in das Wasser hinein.")+
         ::int_long(x,y,z);
    }
}

varargs int PreventInsert(object ob)
{
  if(ob->QueryMaterialGroup(MATGROUP_SWIMABLE) && !living(ob) &&
      !query_once_interactive(ob))
    call_out("weg", 1, ob);
  return ::PreventInsert(ob);
}

weg(object ob)
{
  if(ob && environment(ob)==this_object())
    {
    write(BS("Langsam sinkt "+((ob->QueryProp(P_GENDER)==FEMALE) ? "Deine" : "Dein")
            +" "+(ob->QueryProp(P_NAME))+" in der Tiefe.\n"));
    say(BS(CAP(this_player()->name(WESSEN, 1))+" "+(ob->QueryProp(P_NAME))+" sinkt "
            "langsam in die Tiefe.\n"));
    ob->move(TROPFST("zeugs"), M_NOCHECK);
  }
}


hoehle()
{

  int hinaus;
  int frei;

  if(dive=present("tauchen", TP))
    {
    write(BS("Du bist schon zu weit gekommen, als das Du jetzt noch umdrehen "
            "koenntest.\n")+"\n");
    return 1;
    }

  hinaus=(T_LOAD/(10*((int)(TP->QueryAttribute(A_STR))+((int)TP->QueryAttribute(A_DEX)))));
  
  if(T_LOAD < (MAX_T_LOAD + 1000))
    {
    TP->move(TROPFST("wasser3"), M_GO, "", "sucht sich wieder festen Boden "
                                  "unter den Fuessen", "kommt aus dem See "
                                  "heraus");
    return 1;
    }
  else
    {
    frei=hinaus+random(hinaus);

    if(frei<(hinaus+10))
      {
      write(BS("Du kannst Dich gerade noch aus dem Wasser herausstrampeln.\n"));
      TP->move(TROPFST("wasser3"), M_GO, "", "strampelt sich mit groesster "
              "Muehe aus wieder aus dem Wasser heraus", "kommt erschoepft "
              "aus dem See heraus");
      return 1;
      }
    else
      {
      write(BS("Voller Panik strampelst Du wild im Wasser herum, kommst "
          "allerdings nicht hoch... Deine Ausruestung ist einfach zu "
          "schwer.\n"));
      return 1;
      }  
    }
}

tot()
{
  object ob;

  TP->do_damage(2);
  if (environment(TP)==TO && T_LOAD> ( MAX_T_LOAD + 1000) &&
      ob=!present("kajuboknospe", TP))
    {
    write("Blubb...\n");
    call_out("tot", 2);
    }
  if(ob=present("kajuboknospe", TP))
    {
    write(BS("Du isst rasch Deine Kajuboknospe und bist sogleich von Deiner "
            "Atemnot befreit. Deine schwere Ausruestung jedoch zieht Dich "
            "weiterhin in die Tiefe.\n"));
    ob->remove();
    }
}


raus( str )
{
  notify_fail("Wohin willst Du tauchen?\n");
  if(str=="hinaus"||str=="raus"||str=="zurueck")
    {
    if(T_LOAD > (MAX_T_LOAD + 1000))
      {
      write(BS("Du ersaeufst doch sowieso gerade!\n"));
      return 1;
      }
    else if(dive=present("tauchen", TP))
      {
      write(BS("Du tauchst ja bereits.\n"));
      return 1;
      }
    else
      {
      write(BS("Du holst einmal tief Luft und beginnst, die lange Strecke "
              "wieder zurueckzutauchen.\n")+"\n");
      say(BS(CAP_TPN+" holt tief Luft und taucht weg.\n"));
      call_out("runter1", 3);
      TP->SetProp(P_PARALYZED, ([
            PARALYZE_TIME: 9,
            PARALYZE_MSG: "Du bist gerade mit Tauchen beschaeftigt!\n",
            PARALYZE_MSG_OTHER: "",
            PARALYZE_END: "",
            PARALYZE_END_OTHER: ""]));
      dive=clone_object(OBJ("tauchen"));
      dive->move(TP, M_NOCHECK);
      return 1;
      }
    }
  else
    return 0;
}

runter1()
{ 
  if(environment(TP)==TO)
    {
    write(BS("Mit kraeftigen Schwimmzuegen tauchst Du rasch durch den Gang "
          "in das tiefe Wasserloch zurueck.\n")+"\n");
    call_out("runter2", 6);
    }
}

runter2()
{
  if(environment(TP)==TO)
    {
    write(BS("Du hast jetzt schon etwas Uebung im Herumtauchen. Du verspuerst "
          "keine Atemnot und das Auftauchen geht auch viel schneller als "
          "das Abtauchen. Du kommst gut voran.\n")+"\n");
    call_out("runter3", 3);
    }
}

runter3()
{ 
  if(environment(TP)==TO)
    {
    write(BS("Schliesslich tauchst Du wieder mit dem Kopf auf und holst tief "
          "Luft.\n")+"\n");
    call_out("bewegen", 3);
    }
}


bewegen()
{
  dive->remove();
  if(environment(TP)==TO)
    TP->move(TROPFST("wasser1"), M_GO, "", "ist verschwunden", 
	     "taucht neben Dir auf");
}
