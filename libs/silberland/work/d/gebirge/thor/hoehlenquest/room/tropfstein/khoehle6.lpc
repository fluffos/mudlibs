*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "In der Hoehle hier siehst Du jetzt bereits etwas mehr als einen "
    "vereinzelten Kristall. Rings um Dich herum siehst Du einige kleinere "
    "Bergkristalle aus den Waenden herausragen. Sie sind nicht so gross, wie "
    "der Kristall von vorhin, dafuer aber zahlreicher. Die Hoehle wird von "
    "den Kristallen in ein schwaches, funkelndes Licht getaucht. Die kleinen "
    "Bergkristalle, die in der Wand verankert sind, erwecken den Anschein, "
    "als wuerden das Funkeln direkt aus den Waenden selbst kommen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Ueberall in der Hoehle siehst Du kleine Bergkristalle.");
  AddDetail( "kristall",
             "Der faustgrosse Kristall befindet sich weiter westlich von "
             "Dir.");
  AddDetail( "kristalle",
             "Es handelt sich um Bergkristalle.");
  AddDetail( "bergkristalle",
             "An den Waenden der Hoehle wachsen zahlreiche, kleinere "
             "Bergkristalle heraus. Sie funkeln bunt im Licht Deiner "
             "Lichtquelle, das sie in zahlreichen Farben brechen.");
  AddDetail( ({"licht", "lichtquelle"}),
             "Die Kristalle brechen und reflektieren das Licht Deiner "
             "Lichtquelle in den verschiedensten Farben.");
  AddDetail( "farben",
             "Die Kristalle tauchen die Hoehle in die verschiedensten "
             "Farben, durch die Brechung des Lichtes.");
  AddDetail( ({"brechung", "brechungsgesetz", "gesetz"}),
             "Na hast Du denn nie aufgepasst in Physik beim Brechungsgesetz? "
             "sin a1 / sin a2 = n2 / n1. Das weiss doch nun wirklich jedes "
             "Kind.");
  AddDetail( "funkeln",
             "Die Kristalle tauchen die Hoehle in ein funkelndes Licht.");
  AddDetail( "anschein",
             "Bei den klitzekleinen Kristallen, die nur als Lichtpunkt zu "
             "erkennen sind, sieht es fast so aus, als wuerde das "
             "Funkeln aus den Waenden selbst kommen.");
  AddDetail( ({"lichtpunkt", "punkt", "lichtpunkte", "punkte"}),
             "Die kleinsten Kristalle sind nur als kleine Lichtpunkte zu "
             "erkennen.");
  AddDetail( ({"wand", "waende"}),
             "Aus den Waenden wachsen ueberall kleine Bergkristalle heraus.");
  AddDetail( "boden",
             "Der Boden besteht aus glattem Fels.");
  AddDetail( ({"fels", "gestein"}),
             "Aus dem grauen Gestein wachsen rings herum zahlreiche "
             "Kristalle heraus.");
  AddDetail( "decke",
             "Auch an der Decke kannst Du einige kleine Kristalle erkennen.");

  AddSound( DEFAULT_SOUND,
    "Du kannst nicht das geringste Geraeusch wahrnehmen.");
  AddSound( "geraeusch",
    "Du kannst nichts hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist seltsamerweise frisch und kuehl.");
  AddSmell( "luft",
    "Es ist sonderbar, so tief unten frische Luft zu atmen.");

  AddExit( "nordosten", TROPFST("khoehle7"));
  AddExit( "suedosten", TROPFST("khoehle9"));
  AddExit( "nordwesten", TROPFST("khoehle4"));
  AddExit( "osten", TROPFST("khoehle8"));
  AddExit( "westen", TROPFST("khoehle5"));

}
