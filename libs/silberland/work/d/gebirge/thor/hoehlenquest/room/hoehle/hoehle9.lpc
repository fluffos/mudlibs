// Thor@SilberLand
// Eine verschollene Hoehle - hoehle9.c
// 1997-04-19

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Du bist hier am oestlichen Ende der Hoehle angekommen. Richtung "
    "Suedosten fuehrt ein schmaler Gang weiter, mehr kannst Du allerdings "
    "nicht erkennen. Der Fels hier scheint sehr hart zu sein. Er ist schroff "
    "und hat einige scharfe Zacken. Das Gestein hat hier auch eine etwas "
    "sonderbare Farbe, es scheint, als waere es ein wenig dunkler.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"ende", "hoehle"}),
             "Du bist hier am oestlichen Ende der Hoehle angekommen, nur noch "
             "Richtung Suedosten fuehrt ein schmaler Gang weiter.");
  AddDetail( "gang",
             "Richtung Suedosten zweigt ein schmaler Gang ab. Genauso wie "
             "hier scheint dort tiefste Finsternis zu herrschen.");
  AddDetail( ({"finsternis", "dunkelheit"}),
             "Langsam gewoehnst Du Dich an die Dunkelheit. Sie macht Dir "
             "nicht mehr so viel aus.");
  AddDetail( ({"fels", "felsen"}),
             "Die Hoehle ist hier noch grober aus dem Fels herausgehauen, "
             "als zu Beginn schon. Der Fels wirkt sehr hart hier, schroffe "
             "Zacken haengen von der Decke herab und die Waende sind "
             "zerklueftet.");
  AddDetail( "decke",
             "Von der Decke haengen einige schroffe Felszacken herab."); 
  AddDetail( ({"zacken", "felszacken"}),
             "Falls so ein Zacken herunterbrechen wuerde, wuerde er Dich "
             "wahrscheinlich aufspiessen.");
  AddDetail( "gestein",
             "Das Gestein hier hat eine sonderbare Farbe.");
  AddDetail( "farbe",
             "Das Gestein hat hier eine dunkle Farbe, fast schon etwas "
             "schwaerzlich.");
  AddDetail( "boden",
             "Der Boden besteht aus dunklen Fels.");
  AddDetail( ({"wand", "waende"}),
             "Die Waende sind aeusserst grob in den Fels hineingehauen und "
             "stark zerklueftet.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist frisch und kuehl.");
  AddSmell( ({"luft", "hoehleluft"}),
    "Du nimmst einen tiefen Zug von der Hoehlenluft und fuehlst Dich sogleich "
    "erfrischt.");

  AddExit( "westen", HOEHLE("hoehle6"));
  AddExit( "nordwesten", HOEHLE("hoehle5"));
  AddExit( "suedwesten", HOEHLE("hoehle7"));
  AddExit( "suedosten", HOEHLE("hoehle10"));
}

