// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle7.c
// 1997-05-15

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einem relativ schmalen Gang in der Hoehle. Die klamme "
    "Feuchtigkeit ist ziemlich unangenehm. Weiter Richtung Norden scheint "
    "sich der Gang wieder ein wenig zu verbreitern, mehr kannst Du allerdings "
    "von hier aus nicht erkennen. Am Boden neben Dir siehst Du einige "
    "abgebrochenen Stalaktiten herumliegen, die anscheinend von der Decke "
    "heruntergebrochen sind.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "gang",
             "Der Gang, in dem Du stehst, ist ziemlich eng und feucht.");
  AddDetail( "hoehle",
             "Wenn Du nach Sueden gehst, kommst Du wieder in die "
             "weitlaeufigeren Teile der Hoehle.");
  AddDetail( "feuchtigkeit",
             "Die Feuchtigkeit hier in der Hoehle ist irgendwie unangenehm.");
  AddDetail( "boden",
             "Am Boden liegen einige abgebrochene Stalaktiten herum.");
  AddDetail( "stalaktiten",
             "Es sind nur ziemlich kleine Stalaktiten, die scheinbar von der "
             "Decke heruntergebrochen sind.");
  AddDetail( "decke",
             "An der Decke kannst Du einige Loecher erkennen, an denen die "
             "Stalaktiten herausgebrochen sind.");
  AddDetail( "loecher",
             "Die Loecher in der Decke weisen wahrscheinlich auf etwas "
             "poroeseres Gestein hin. Hoffentlich faellt Dir nichts auf "
             "den Kopf.");
  AddDetail( ({"fels", "gestein"}),
             "Der Fels scheint hier ein wenig poroes zu sein.");
  AddDetail( "kopf",
             "Du machst Dir ernsthaft um DIESEN Kopf Sorgen?!");
  AddDetail( "waende",
             "An den Waenden troepfelt etwas Wasser herunter.");
  AddDetail( "wasser",
             "Alles hier ist ziemlich feucht.");
                
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers.");
  AddSound( ({"tropfen", "wasser"}),
    "Es wirkt irgenwie beruhigend.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft hier drinnen ist kuehl und feucht.");
  AddSmell( "luft",
    "Die extrem feuchte Luft hier ist irgendwie bedrueckend.");

  AddItem( NPC("fmaus2"), REFRESH_DESTRUCT);

  AddExit( "norden", TROPFST("thoehle8"));
  AddExit( "sueden", TROPFST("thoehle6"));
}
