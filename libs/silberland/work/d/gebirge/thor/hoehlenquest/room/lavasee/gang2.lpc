#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Gang" );
  SetProp( P_INT_LONG,
    "Der Hoehlengang, fuehrt weiterhin nach unten weiter. Das Gestein der "
    "Waende ist hell und schroff. Der Wind, der Dir entgegenweht, ist "
    "jetzt schon beinahe heiss. Du beginnst Dich zu fragen, wo dieser Gang "
    "Dich wohl hinfuehren wird... Der Gang wird hier von einem dumpfen, "
    "roten Lichtschimmer erfuellt, der wohl von weiter unten zu kommen "
    "scheint. Der Gang macht hier direkt vor Dir einen Knick nach Westen. "
    "Von dort scheint auch das rote Leuchten zu kommen. Am Boden und an "
    "der Decke erkennst Du zwei dicke Metallstaebe, von denen ein blaues "
    "Leuchten ausgeht, das in einer durchgehenden Wand vom Boden bis zur "
    "Decke reicht. Du kannst ein seltsames, tiefes Summen davon vernehmen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

  AddDetail( "hoehle",
             "Das hier ist nur ein Hoehlengang, der nach unten "
             "weiterfuehrt.");
  AddDetail( ({"hoehlengang", "gang"}),
             "Der Hoehlengang, in dem Du stehst, fuehrt steil nach unten "
             "weiter. Gleich vor Dir macht er einen Knick nach Westen.");
  AddDetail( "knick",
             "Der Gang biegt hier scharf nach Westen ab.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Die Waende bestehen aus schroffen Felsen.");
  AddDetail( ({"gestein", "fels", "felsen"}),
             "Der Fels ist hier ziemlich schroff und hat eine relativ "
             "helle Farbe.");
  AddDetail( "wind",
             "Ein heisser Wind weht Dir entgegen.");
  AddDetail( ({"schimmer", "lichtschimmer"}),
             "Der Gang ist von einem seltsamen, roten Licht erfuellt.");
  AddDetail( "licht",
             "Es scheint von tiefer unten zu kommen. Bei dem Knick Richtung "
             "Westen scheint es staerker zu werden.");
  AddDetail( "leuchten",
             "Es hat eine sonderbare, rote Farbe.");
  AddDetail( "farbe",
             "Sagte ich schon, dass die Farbe rot ist?");
  AddDetail( "decke",
             "Die Decke besteht aus schroffem Fels. Du siehst einen dicken "
             "Metallstab an der Decke."),
  AddDetail( "boden",
             "Der Boden ist felsig. Du siehst einen dicken Metallstab am "
             "Boden.");
  AddDetail( ({"staebe", "metallstaebe", "stab", "metallstab"}),
	     "Am Boden und an der Decke siehst Du einen dicken Metallstab. "
             "Von oben bis unten spannt sich eine seltsame, blaue Aura "
             "darueber, sodass Du gezwungen bist, durch sie hindurchzugehen.");
  AddDetail( "aura",
	     "Sie wird wohl magisch sein.");
  AddDetail( "leuchten",
	     "Ein blaues Leuchten geht von den Metallstaeben aus.");
  AddDetail( "wand",
	     "Die Aura breitet sich von oben bis unten aus und bildet so ein "
             "blaue, durchsichtige Wand.");
  AddDetail( "summen",
	     "Ein dumpfes Summen geht von den Metallstaeben aus.");
 

  AddSound( DEFAULT_SOUND,
    "Du hoerst das seltsame Summen der Metallstaebe.");
  AddSound( ({"summen"}),
    "Ein tiefes, unangenehmes Geraeusch.");
  AddSound( ({"geraeusch", "klang"}),
    "Das Summen hat einen tiefen, dumpfen Klang.");

  AddSpecialExit( ({"westen", "westunten"}), "runter");
  AddSpecialExit( "oben", "rauf");
  SetProp(P_HIDE_EXITS, ({"westen"}));
}

int runter( string dir )
{
  int i, j;
  object ob, obj, *armours;
  if(!present("magiepanzer", TP))
    {
//    if(armours=TP->QueryProp(P_ARMOURS))
//      {
//      j=sizeof(armours);
//      for(i=0;i<j;i++)
//	if((armours[i]->QueryProp(P_ARMOUR_TYPE))==AT_ARMOUR)
//	  armours[i]->DoUnwear();
//      }
    ob=(clone_object(ARMOUR("hitzepanzer"))->move(TP, M_NOCHECK));
    write(BS("Als Du durch die blaue Aura durchschreitest, bildet sich "
             "ein schuetzender, blauer Panzer ueber Deinen Koerper. Es "
             "ist ploetzlich wesentlich kuehler.\n"));
    say(BS("Als "+TPN+" durch die blaue Aura durchschreitet, bildet sich "
           "ein seltsamer blauer Panzer ueber "
	  +TP->QueryPossPronoun(MALE, WEN, SINGULAR)
	  +" Koerper.\n"));
    TP->command_me("trage magiepanzer");
    TP->move(LAVA("lava1"), M_GO, "nach Westunten");
    return 1;
    }
  else
    TP->move(LAVA("lava1"), M_GO, "nach Westunten");
    return 1;
}

int rauf( string dir )
{
  object ob;
  if(ob=present("magiepanzer", TP))
    {
    write(BS("Als Du wieder durch die magische Aura durchschreitest, "
             "verschwindet der schuetzende blaue Panzer einfach.\n"));
    ob->remove(1);
    TP->move(TROPFST("gang1"), M_GO, "nach Oben");
    return 1;
    }
  else
    TP->move(TROPFST("gang1"), M_GO, "nach Oben");
    return 1;
}  
