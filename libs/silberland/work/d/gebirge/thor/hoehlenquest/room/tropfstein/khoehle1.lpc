#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Die Felswaende scheinen hier etwas heller zu werden. Auch die Hoehle "
   +"scheint sich hier wieder etwas weiter auszudehnen. Die Gaenge werden "
   +"eindeutig hoeher und breiter. Links und rechts von Dir fuehren zwei "
   +"Gaenge weg. Einer fuehrt nach Nordwesten, der andere nach Osten. Gleich "
   +"neben Dir siehst Du eine groessere, runde Erhebung.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"waende", "felswaende"}),
             "Das Gestein der Felswaende wird eindeutig wieder etwas heller. "
            +"Der Fels ist nicht mehr so pechschwarz, er ist nur mehr "
            +"dunkelgrau.");
  AddDetail( ({"gestein", "fels"}),
             "Der Fels wird wieder etwas heller hier. Die Schwarzfaerbung "
            +"ist bei weitem nicht mehr so kraefig, wie sie es schon war.");
  AddDetail( ({"faerbung", "schwarzfaerbung"}),
             "Die Schwarzfaerbung des Gesteins wird merklich schwaecher.");
  AddDetail( "hoehle",
             "Die Hoehle wird wieder etwas weitlaeufiger. Es ist hier "
            +"wesentlich angenehmer als in den beengenden Stollen.");
  AddDetail( "stollen",
             "Die Stollen hinter Dir sind aeusserst eng.");
  AddDetail( "gaenge",
             "Die Gaenge werden hier wieder merklich breiter und hoeher. Du "
            +"siehst zwei Gaenge von Dir wegfuehren. Einen nach Nordwesten, "
            +"den anderen nach Osten.");
  AddDetail( "boden",
             "Der Boden besteht aus Fels.");
  AddDetail( "decke",
             "Du kannst nichts Besonderes daran erkennen.");
  AddDetail( "besonderes",
             "Es ist vielleicht besser, wenn Du die naechsten Sachen hier "
            +"nicht mehr untersuchen wuerdest.");
  AddDetail( "sachen",
             "Wenn ich nicht so faul waere, dann waer das hier jetzt eine "
            +"boese, boese Script-Falle.");
  AddDetail( ({"script-falle", "scriptfalle", "falle"}),
             "Also jetzt reichts dann wirklich! Wird Dir das nicht langsam "
            +"zu bloed?");
  AddDetail( "erhebung",
	     "Die Erhebung hat einen Durchmesser von etwa einem Meter und "
	    +"ist gute zwanzig Zentimeter hoch. Du koenntst Dich ja "
	    +"vielleicht mal draufstellen.");

  AddSound( DEFAULT_SOUND,
    "Es ist immer noch still.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Hoehlenluft hier ist erstaunlich frisch.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Du atmest einmal tief durch.");

  AddCmd( ({"stelle", "stell", "steige", "steig"}), "teleporter");

  AddExit( "nordwesten", TROPFST("thoehle1"));
  AddExit( "osten", TROPFST("khoehle2"));
  AddExit( "sueden", LAB("laby67"));
}

teleporter( str )
{
  int test;
  notify_fail("Wo willst Du Dich draufstellen?\n");
  if(str=="auf erhebung")
    {
    write(BS("Du stellst Dich auf die Erhebung und ploetzlich faengt sie "
	    +"unter Dir golden an zu schimmern. Ploetzlich scheint sich "
	    +"Dein Koerper aufzuloesen und Du verlierst die Orientierung.\n"));
    say(BS(CAP_TPN+" stellt sich auf die Erhebung und beginnt ploetzlich vor "
	  +"Deinen Augen zu verschwimmen.\n"));

    if(member(call_other(TPORTMASTER, "CheckPlayers"), getuid(TP))==0)
      {
      call_other(TPORTMASTER, "AddPlayer", TP);
      call_other(TPORTMASTER, "FindTport", TP, 1);
      }
    if((call_other(TPORTMASTER, "CheckTport", TP))<1)
      {
      write(BS("Unbekannter Fehler! Bitte sofort Magier verstaendigen!\n"));
      return 1;
      }
    TP->move(LAB("laby4"), M_TPORT);
    return 1;
    }
  else
    return 0;
}
