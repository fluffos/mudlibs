#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Du bist hier an der Suedwand der Hoehle angelangt. Rund um Dich siehst "
    "Du ueberall Bueschel von Bergkristallen aus den Waenden wachsen. "
    "Du siehst ein besonders grosses, schoenes Exemplar aus der suedlichen "
    "Wand herausragen. Selbst an den Stellen, wo Waende und Boden "
    "zusammenstossen, spriessen bereits einige kleinere Kristalle hervor. "
    "Die Hoehle wird von all der Pracht in ein funkelndes Lichtermeer "
    "verwandelt.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"wand", "suedwand"}),
             "Weiter nach Sueden geht es nun nicht mehr.");
  AddDetail( "hoehle",
             "Du bist fasziniert von dem funkelnden Anblick der Hoehle.");
  AddDetail( "anblick",
	     "Der Anblick, der sich Dir bietet, ist atemberaubend.");
  AddDetail( ({"bueschel", "kristallbueschel"}),
	     "Ueberall an den Waenden siehst Du groessere und kleinere "
	     "Kristallbueschel.");
  AddDetail( ({"bergkristall", "kristall", "kristalle", "bergkristalle"}),
             "Die Kristalle verleihen der Hoehle ein funkelndes Glitzern.");
  AddDetail( "glitzern",
             "Die Hoehle glitzert in den verschiedensten Farben.");
  AddDetail( ({"farbe", "farben"}),
             "Gelb, gruen, rot, alles dabei.");
  AddDetail( "stellen",
             "Selbst dort, wo Waende und Boden zusammenstossen, siehst Du "
             "bereits einige Kristalle.");
  AddDetail( "waende",
             "Ueberall an den Waenden siehst Du Kristalle, die aus dem grauen "
             "Fels herauswachsen.");
  AddDetail( ({"gestein", "fels"}),
             "Das Gestein sieht fast so aus, als waere es der Naehrboden "
	     "fuer die Kristalle.");
  AddDetail( "decke",
             "Auch von der Decke haengen einige groessere Kristallzacken "
             "herab.");
  AddDetail( ({"zacken", "kristallzacken"}),
             "Du kannst sie leider nicht erreichen.");
  AddDetail( "boden",
             "Lediglich der Boden ist noch frei von Kristallen.");
  AddDetail( "pracht",
             "Die Hoehle strahlt in einer unvorstellbaren Pracht.");
  AddDetail( ({"lichtermeer", "meer"}),
             "Das schwache Licht Deiner Lichtquelle wird tausendfach "
             "gebrochen und verwandelt so die Hoehle in ein schillerndes "
             "Lichtermeer.");
  AddDetail( ({"licht", "lichtquelle"}),
             "Es wird von den Kristallen vielfach gebrochen und daher auch "
             "stark verstaerkt.");
  AddSpecialDetail( "exemplar", "unt_exemplar");
  AddSpecialDetail( "kanten", "unt_kanten");
  AddSpecialDetail( "stelle", "unt_stelle");
  AddSpecialDetail( ({"spitz", "spitze"}), "unt_spitz");


  AddSound( DEFAULT_SOUND,
    "Du kannst nicht das geringste Geraeusch wahrnehmen.");
  AddSound( "geraeusch", 
    "Du hoerst nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm frisch.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({"ruettel", "ruettle"}), "wackeln");
  AddCmd( ({"ziehe", "zieh"}), "kristall");

  AddExit( "norden", TROPFST("khoehle8"));
  AddExit( "nordwesten", TROPFST("khoehle6"));
}

int ruetteln=0;
int kristall=1;

reset()
{
  ::reset();
  ruetteln=0;
  kristall=1;
}

wackeln( str )
{
  notify_fail( "Woran willst Du ruetteln?\n" );
  if( str == "kristall" || str=="an kristall" )
    {
    write(BS("Du ruettelst kraeftig an dem Kristall herum und merkst, wie "
             "er sich zusehends aus dem Gestein lockert. Mit viel Muehe "
             "koenntest Du ihn vielleicht herausziehen.\n"));
    say(BS(CAP_TPN+" ruettelt an irgendetwas in der Wand herum.\n"));
    ruetteln=1;
    return 1;
    }
  return 0;
}

kristall( str )
{
  notify_fail( "Was willst herausziehen?\n");
  if( (str=="kristall raus"||str=="kristall heraus"||
       str=="kristall aus Wand heraus") && ruetteln==1&&kristall==1)
    {
    write(BS("Du ziehst kraeftig an dem Kristall. Mit einem Ruck loest er "
             "sich aus dem Gestein und es haut Dich kraeftig auf Deinen "
             "Allerwertesten. Der Kristall faellt Dir dabei aus der Hand.\n"));
    say(BS(CAP_TPN+" zieht an einem Gegenstand herum, der sich schliesslich "
             "zu loesen scheint. "+CAP_TPN+" faellt dabei mit einem "
	    "kraeftigen BUMMS auf "+((TP->QueryProp(P_GENDER))==FEMALE?"ihren" : "seinen")+" Allerwertesten.\n"));
    clone_object("/obj/gems/bergkristall")->move(TO, M_NOCHECK);
    kristall=0;
    ruetteln=0;
    return 1;
    }
  if( (str=="kristall heraus"||str=="kristall aus Wand heraus")&&ruetteln==0&&kristall==1)
    {
    write(BS("Vielleicht solltest Du zuvor an dem Kristall ruetteln, um ihn "
             "zu lockern.\n"));
    return 1;
    }
  if((str=="kristall heraus"||str=="kristall aus Wand heraus")&&kristall==0)
    {
    write(BS("Es scheint schon vor Dir jemand hier gewesen zu sein.\n"));
    return 1;
    }
  return 0;
}

string unt_exemplar()
{
  if( kristall==1)
    {
    return BS("Ein ziemlich grosser, langer Kristall, der mitten aus der Wand "
              "herausragt, faellt Dir auf. Er ist etwa 20 cm lang und 5 cm "
              "breit. Er hat fuenf Kanten und laeuft vorne regelmaessig zu "
              "einer Spitze zusammen.\n");
    }
  else
    return "Sowas siehst Du hier nicht.\n";
}

string unt_kanten()
{
  if(kristall==1)
    {     
    return BS("Der Kristall hat fuenf gerade, regelmaessige Kanten. An der "
             "Stelle, wo er mit der Wand verbunden ist, kommt er Dir jedoch "
             "ein wenig locker vor.\n");
    }
  else
    return "Sowas siehst Du hier nicht.\n";
}

string unt_stelle()
{
  if(kristall==1)
    {
    return BS("Du koenntest vielleicht einmal versuchen, an dem Kristall zu "
             "ruetteln.\n");
    }
  else
    return "Sowas siehst Du hier nicht.\n";
}

string unt_spitz()
{
  if(kristall==1)
    return BS("Die fuenf Kanten des Kristalls laufen vorne ganz spitz zu.\n");
  else
    return "Sowas siehst Du hier nicht.\n";
}











