// Thor@SilberLand
// Ein Loch in die Tiefe - loch9.c
// 1997-04-30

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Treppe in die Tiefe" );
  SetProp( P_INT_LONG,
    "Falls nicht bald ein Ende dieses Abstieges in Sicht ist, brauchst Du "
    "wohl nicht weitergehen. Die Treppe ist beinahe nicht mehr zu erkennen, "
    "so verfallen sind die Stufen hier schon. Am Rand, wo es in den Abgrund "
    "hinuntergeht, sind immer groessere Ecken herausgebrochen und es wuerde "
    "mehr oder weniger an Selbstmord grenzen, noch viel weiter hier "
    "hinunterzusteigen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "ende",
             "Du hoffst, dass Du bald am Ende dieser Treppe angelangt bist, "
             "denn viel weiter nach unten ist sie wahrscheinlich nicht mehr "
             "begehbar.");
  AddDetail( "abstieg",
             "Der Abstieg wird schon beinahe unmoeglich, so verfallen sind "
             "die Stufen schon.");
  AddDetail( "treppe",
             "Das, woran Du den Abgrund hinuntersteigst, erinnert nur noch "
             "sehr schemenhaft an eine Treppe.");
  AddDetail( "stufen",
             "Die Stufen sind fast schon vollkommen zerbroeckelt und "
             "verfallen. Du musst mit groesster Vorsicht vorangehen, ein "
             "einziger unueberlegter Schritt, und Du wuerdest in den Abgrund "
             "stuerzen.");
  AddDetail( "vorsicht",
             "Du musst mit groesster Vorsicht weitergehen, denn beim "
             "geringsten Fehltritt wuerdest Du wohl in den Abgrund stuerzen.");
  AddDetail( ({"schritt", "fehltritt", "tritt"}),
             "Nur beim geringsten Fehltritt wuerdest Du wohl in die Tiefe "
             "stuerzen.");
  AddDetail( ({"rand", "zacken", "ecken"}),
             "Am Rande der Treppe sind schon grosse Zacken herausgebrochen.");
  AddDetail( ({"abgrund", "tiefe"}),
             "Wenn Du in diesen Abgrund stuerzt, wuerde wahrscheinlich nicht "
             "mehr viel von Dir uebrig bleiben.");
  AddDetail( ({"selbstmord", "mord"}),
             "Es waere wohl der reinste Selbstmord, hier noch viel weiter nach "
             "unten zu steigen.");
  AddDetail( "boden",
             "Der Boden unter Deinen Beinen ist schon aeusserst unsicher.");
  AddDetail( "beine",
             "Du hast schon etwas weiche Beine von dem nervenaufreibenden "
             "Abstieg.");
  AddDetail( "waende",
             "Die Waende bestehen aus schwarzem Fels.");
  AddDetail( ({"fels", "gestein"}),
             "Das Gestein ist pechschwarz gefaerbt.");
  AddDetail( "decke",
             "Die kannst Du schon lange nicht mehr erkennen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "nordwestunten", HOEHLE("loch10"));
  AddExit( "suedwestoben", HOEHLE("loch8"));
  AddExit( "nordwesten", HOEHLE("loch10"));
  AddExit( "suedwesten", HOEHLE("loch8"));
  SetProp (P_HIDE_EXITS, ({"nordwesten", "suedwesten"}) );

}
