// Thor@SilberLand
// Ein Gang nach unten - gang1.c
// 1997-06-09

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Gang" );
  SetProp( P_INT_LONG,
    "Du stehst in einem Hoehlengang, der ziemlich steil nach unten fuehrt. "
    "Das Gestein der Waende ist hell und schroff. Aus dem Gang vor Dir, der "
    "weiter nach unten fuehrt, weht Dir ein warmer Wind entgegen. Seltsam, "
    "denn das war das letzte, was Du hier zu erwarten geglaubt haettest - "
    "ein warmer Luftzug hunderte von Metern tief unter der Erde. Du glaubst "
    "auch einen seltsamen, roetlichen Schimmer an den Hoehlenwaenden weiter "
    "vorne zu erkennen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 12]) );

  AddDetail( "hoehle",
             "Das hier ist nur ein Hoehlengang, der nach unten "
             "weiterfuehrt.");
  AddDetail( ({"hoehlengang", "gang"}),
             "Der Hoehlengang, in dem Du stehst, fuehrt steil nach unten "
             "weiter. Ein Stueckchen weiter kannst Du einen roetlichen "
             "Schimmer an den Felswaenden erkennen.");
  AddDetail( ({"waende", "felswaende", "hoehlenwaende", "felswand", "hoehlenwand"}),
             "Die Waende sind aus schroffen Felsen. Weiter vorne kannst Du "
             "einen roetlichen Schimmer daran erkennen.");
  AddDetail( ({"gestein", "fels", "felsen", "farbe"}),
             "Der Fels ist hier ziemlich schroff und hat eine relativ "
             "helle Farbe.");
  AddDetail( "wind",
             "Es ist eigentlich nicht viel mehr als ein Lufthauch.");
  AddDetail( ({"lufthauch", "hauch", "luftzug", "zug"}),
             "Es ist schon seltsam... ein warmer Luftzug so tief unten.");
  AddDetail( "erde",
             "Ja, Du bist hier ganz bestimmt furchtbar tief unter der Erde. "
             "Es ist vielleicht besser, wenn Du nicht darueber nachdenkst, "
             "wie tief genau.");
  AddDetail( "schimmer",
             "Du erkennst einen roetlichen Schimmer weiter vorne an den "
             "Hoehlenwaenden. Von hier aus kannst Du jedoch noch nichts "
             "genaueres erkennen.");
  AddDetail( "decke",
             "Die Decke besteht aus schroffem Fels."),
  AddDetail( "boden",
             "Der Boden ist felsig."); 

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Ich sagte doch, Du hoerst nichts.");

  AddExit( "unten", LAVA("gang2"));
  AddExit( "suedwesten", TROPFST("thoehle1"));
}


