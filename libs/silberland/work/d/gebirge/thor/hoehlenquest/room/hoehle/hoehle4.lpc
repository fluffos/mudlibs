// Thor@SilberLand
// Eine verschollene Hoehle - hoehle4.c
// 1997-04-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle erstreckt sich vor Dir von Westen nach Osten. Das Wasser, "
   +"das schon zuvor an der suedlichen Wand heruntergetroepfelt ist, ist "
   +"etwas mehr geworden. Der Fels am Boden ist an dieser Stelle ein wenig "
   +"feucht, ansonsten ist alles knochentrocken und teilweise sogar ein "
   +"wenig staubig. Der Fels ist kalt und glitschig, an der Stelle, wo "
   +"das Wasser heruntertroepfelt.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Die Hoehle erstreckt sich in oestliche Richtung. An der "
            +"suedlichen Wand troepfelt etwas Wasser herunter, ansonsten "
            +"kannst Du aber nichts besonderes erkennen.");
  AddDetail( "wasser",
             "An der suedlichen Wand troepfelt von oben etwas Wasser herab. "
            +"Der Fels ganz kalt und glitschig an dieser Stelle. Hier in der "
            +"Naehe scheint irgendwo eine Quelle zu sein.");
  AddDetail( "quelle",
             "Das Wasser an der Felswand laesst auf eine Quelle ganz in der "
            +"Naehe schliessen.");
  AddDetail( "naehe",
             "Du musst Dich schon ein wenig umkucken.");
  AddDetail( "stelle",
             "An der Stelle, wo das Wasser den Fels entlang "
            +"heruntertroepfelt, ist das Gestein ganz kalt und glitschig. "
            +"Du streichst einmal mit der Hand darueber... uaeeeh... fuehlt "
            +"sich das ekelhaft an.");
  AddDetail( ({"fels", "gestein"}),
             "Das Gestein in der Hoehle scheint ueberall schon etwas locker "
            +"zu sein, allerdings wird sie wohl in den naechsten fuenfzig "
            +"Jahren noch nicht zusammenbrechen. Wo das Wasser "
            +"heruntertropft, ist der Fels ekelhaft glitschig und kalt.");
  AddDetail( ({"wand", "felswand"}),
             "An der suedlichen Wand troepfelt etwas Wasser herunter.");
  AddDetail( "waende",
             "Bis auf die suedliche Wand sind die Waende trocken und "
            +"felsig.");
  AddDetail( "boden",
             "Der Boden ist etwas feucht und schluepfrig an der Stelle, wo "
            +"das Wasser heruntertroepfelt, ansonsten ist er nur ein wenig "
            +"mit Staub bedeckt.");
  AddDetail( ({"staub", "staubschicht", "schicht"}),
             "Der Boden ist zum Grossteil mit einer duennen Staubschicht "
            +"bedeckt.");
  AddDetail( "decke",
             "Ueber Dir siehst Du die felsige Decke. Du kannst eigentlich "
            +"nichts besonderes daran erkennen.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Du hoerst absolut NICHTS.");
    
  AddSmell( DEFAULT_SMELL,
    "Du spuerst einen kuehlen Luftzug aus dem Inneren der Hoehle kommen.");
  AddSmell( ({"zug", "luftzug", "luft", "hoehlenluft"}),
    "Du atmest einmal tief die frische Hoehlenluft ein.");


  AddExit( "norden", HOEHLE("hoehle3"));
  AddExit( "osten", HOEHLE("hoehle6"));
  AddExit( "westen", HOEHLE("hoehle2"));
  AddExit( "nordosten", HOEHLE("hoehle5"));
  AddExit( "suedosten", HOEHLE("hoehle7"));
}
