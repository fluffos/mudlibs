// Thor@SilberLand
// Eine verschollene Hoehle - hoehle7.c
// 1997-04-18

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier in einer kleinen Nische der Hoehle. Gleich neben "
    "Dir ist eine kleine Quelle, die aus dem Fels hervorsprudelt. Das Wasser "
    "ist rein und klar und versickert am Boden wieder durch ein kleines Loch. "
    "Links und rechts von der Quelle ist der Fels ein wenig mit Moos "
    "bewachsen. Auch von der Decke tropft Dir von Zeit zu Zeit ein "
    "Wassertropfen auf die Nase.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( "nische",
             "Die Nische ist auf der suedlichen Seite der Hoehle. Gleich "
             "neben Dir sprudelt eine klare Quelle aus dem Fels hervor.");
  AddDetail( ({"hoehle", "hoehle"}),
             "Du bist hier an der suedlichen Seite der Hoehle.");
  AddDetail( ({"quelle", "stelle"}),
             "Neben Dir sprudelt klares, reines Wasser aus einer Quelle in "
             "der Felswand hervor. Wenn Du so ueberlegst, bist Du eigentlich "
             "ziemlich durstig.");
  AddDetail( "wasser",
             "Es ist kuehl, rein und klar. Am Boden versickert es durch ein "
             "Loch gleich wieder im Fels. Du koenntest ja mal einen Schluck "
             "trinken.");
  AddDetail( "boden",
             "Am Boden ist ein kleines Loch, durch das das Wasser wieder "
             "versickert.");
  AddDetail( "loch",
             "Das Loch im Boden fuehrt wahrscheinlich in unergruendbare "
             "Tiefen.");
  AddDetail( "tiefen",
             "Wenn Du schon in irgendwelche Tiefen vordringen willst, dann am "
             "besten in die der Hoehle.");
  AddDetail( "fels",
             "Aus der Felswand neben Dir sprudelt eine Quelle hervor.");
  AddDetail( ({"wand", "felswand"}),
             "In der Wand ist an einer Stelle offen, wo das Wasser "
             "herausfliesst.");
  AddDetail( "decke",
             "Die Decke und auch die Waende hier sind etwas stabiler, als sie "
             "am Anfang der Hoehle waren. Ab und zu tropft Dir ein "
             "Wassertropfen von der Decke auf die Nase herab.");
  AddDetail( ({"tropfen", "wassertropfen"}),
             "Sie tropfen Dir von der Decke auf die Nase. Hihi, das fuehlt "
             "sich lustig an.");
  AddDetail( "nase",
             "Sie ist schon ganz feucht und kalt vom Wasser.");
  AddDetail( "anfang",
             "Der ist westlich von Dir.");
  AddDetail( "waende",
             "Die Waende sind hier etwas stabiler als zuvor.");
  AddDetail( "moos",
             "Links und rechts von der Quelle ist der Fels mit etwas Moos "
             "bewachsen. Es ist kuehl und feucht, und fuehlt sich irgendwie "
             "angenehm an.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise die Quelle plaetschern.");
  AddSound( ({"quelle", "plaetschern"}),
    "Es hoert sich angenehm und beruhigend an.");
  
  AddSmell( DEFAULT_SMELL,
    "Du riechst nur die frische Hoehlenluft.");
  AddSmell( ({"hoehlenluft", "luft"}),
    "Sie ist ein wenig feucht hier, wegen dem Wasser.");

  AddCmd( ({"trink", "trinke"}), "wasser" );

  AddExit( "norden", HOEHLE("hoehle6"));
  AddExit( "nordosten", HOEHLE("hoehle9"));
  AddExit( "nordwesten", HOEHLE("hoehle4"));
}

wasser( str )
{
  notify_fail( "Was willst Du trinken?\n" );
  if( str == "wasser" )
  {
    write(BS("Du nimmst genuesslich einen kraeftigen Schluck von dem reinen, "
             "klaren Wasser. Kuehl laeuft es Deine Kehle hinunter und Du "
             "fuehlst Dich gleich wieder etwas gestaerkt.\n"));
    say(BS(CAP_TPN+" nimmt einen tiefen Schluck von der Quelle und sieht "
             "daraufhin sehr erfrischt aus.\n"));
    return 1;
  }
  return 0;
}
