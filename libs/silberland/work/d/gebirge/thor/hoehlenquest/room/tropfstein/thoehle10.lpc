// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle10.c
// 1997-05-22

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle erstreckt sich weiter Richtung Westen. Die Stalaktiten und "
   +"Stalagmiten werden immer maechtiger. An manchen Stellen sind sie schon "
   +"zu riesigen Saeulen zusammengewachsen, die nun aussehen, als wuerden "
   +"sie die Decke stuetzen. Rund um Dich herum hoerst Du das Wasser von der "
   +"Decke heruntertropfen, und Du hoerst das Echo von den Hoehlenwaenden "
   +"zurueckhallen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Die Hoehle erstreckt sich von Osten nach Westen.");
  AddDetail( ({"stalagmiten", "stalaktiten"}),
             "Die Stalagmiten und Stalaktiten sind an einigen Stellen "
            +"bereits zu riesigen Saeulen zusammengewachsen.");
  AddDetail( "saeulen",
             "Sie sind hell vom Kalkgestein und glaenzen von der "
            +"Feuchtigkeit. In der Mitte, wo Stalagmiten und Stalaktiten "
            +"zusammengewachsen sind, sind die Saeulen etwas duenner.");
  AddDetail( ({"gestein", "kalkgestein"}),
             "Das helle Kalkgestein glaenzt ueberall in der Hoehle von der "
            +"Feuchtigkeit.");
  AddDetail( "feuchtigkeit",
             "Ja, in einer Tropfsteinhoehle ist es meistens ziemlich "
            +"feucht.");
  AddDetail( "wasser",
             "Ueberall tropft das Wasser von der Decke. Ein deutliches Echo "
            +"des Tropfens ist von den Hoehlenwaenden zu hoeren.");
  AddDetail( "echo",
             "Es hoert sich geheimnisvoll an...");
  AddDetail( "decke",
             "Von der Decke tropft das Wasser herunter.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Auch an den Hoehlenwaenden rinnt ein wenig Wasser herab.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Tropfen des Wassers.");
  AddSound( ({"tropfen", "wasser"}),
    "Es ist irgendwie ein beruhigendes Geraeusch.");
  AddSound( "echo",
    "Das Echo des Tropfens klingt geheimnisvoll.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddExit( "osten", TROPFST("thoehle9"));
  AddExit( "sueden", TROPFST("thoehle11"));
  AddExit( "nordwesten", TROPFST("thoehle12"));
}
