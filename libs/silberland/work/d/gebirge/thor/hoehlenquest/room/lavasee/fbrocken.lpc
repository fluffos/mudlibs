*********************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Ein Felsbrocken" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem kleinen Felsbrocken, der mitten aus der Lava "
    "herausragt. Er ist nichtmal zwei Meter breit, also pass besser "
    "auf, wo Du hintrittst, es koennte sonst Dein Tod sein. Hinter Dir ist "
    "der Lavablock, von dem Du heruebergesprungen bist. Wenn Du Dich "
    "so umblickst hier, kommt es alles etwas sonderbar vor. Einige Becher und "
    "Wasserhaeute liegen verstreut herum, alle leer. Eine kleine, schmutzige "
    "Decke liegt ausgebreitet in einer Ecke.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 50]) );

  AddDetail( ({"lavablock", "block"}),
	     "Der ist hinter Dir. Du kannst wieder zurueckspringen.");
  AddDetail( ({"felsbrocken", "brocken"}),
	     "Der Felsbrocken ist nicht allzu gross. Er ist hoechstens zwei "
	     "Meter breit, also pass auf, dass Du nicht runterfaellst.");
  AddDetail( "lava",
	     "Unter Dir brodelt die Lava und weht heisse Schwefelboeen "
	     "zu Dir herauf.");
  AddDetail( ({"schwefelboeen", "boeen"}),
	     "Die Schwefelboeen verschlagen Dir beinahe den Atem. Es scheint "
	     "hier irgendwie besonders heiss zu sein.");
  AddDetail( "atem",
	     "Es faellt Dir immer schwerer in dieser unfreundlichen Umgebung "
	     "zu atmen.");
  AddDetail( "umgebung",
	     "Hier wuerdest Du nicht gerade gerne Urlaub machen.");
  AddDetail( "urlaub",
	     "Da kannst Du Dir viel schoenere Plaetze ausdenken.");
  AddDetail( "plaetze",
	     "Wie waers mit Tijara?");
  AddDetail( "tijara",
	     "Denkst Du nicht, dass Du jetzt schon ein bisschen zu weit "
	     "vom Thema abgeschweift bist?");
  AddDetail( "tod",
	     "Pass auf, wo Du hinsteigst!");
  AddDetail( "becher",
             "Einige leere Blechbecher liegen verstreut herum. Teilweise sind "
	     "sie schon ganz rostig und fuerchterlich verdreckt.");
  AddDetail( ({"blechbecher", "blech"}),
	     "Ja, die Becher bestehen aus Blech.");
  AddDetail( ({"haeute", "wasserhaeute"}),
	     "Voller Hoffnung durchstoeberst Du die Wasserhaeute. Vielleicht "
	     "ist ja irgendwo noch ein Tropfen drinnen. Doch Deine Suche "
	     "ist leider erfolglos. Alles, was Du darin finden kannst, ist "
	     "Staub und heisse Luft.");
  AddDetail( ({"tropfen", "wasser"}),
	     "Kein Tropfen Wasser mehr in den Haeuten zu finden... Naja, es "
	     "waere ja aber auch zu schoen gewesen, um wahr zu sein.");
  AddDetail( "hoffnung",
	     "Scheinbar hast Du sie immer noch nicht aufgegeben.");
  AddDetail( "suche",
	     "Hoer auf zu suchen! Es ist zwecklos.");
  AddDetail( ({"staub", "luft"}),
	     "Nur etwas Staub und heisse Luft stroemt aus den Wasserhaeuten "
	     "heraus.");
  AddDetail( "ecke",
	     "In einer Ecke des Felsbrockens ist eine kleine Decke "
	     "ausgebreitet. Sie sieht fast aus, wie ein kleines Lager.");
  AddDetail( "lager",
	     "Wer koennte hier bloss ein kleines Lager haben? Sonderbar...");
  AddDetail( ({"broeckchen", "klumpen", "dreckklumpen"}),
             "Die Decke ist ueber und ueber mit Dreckklumpen uebersaeht.");
  AddDetail( "stellen",
	     "An manchen Stellen erkennst Du sogar verschmierte "
	     "Exkremente.");
  AddDetail( "exkremente",
	     "Du willst sie lieber nicht naeher untersuchen ... glaube mir.");
  AddDetail( ({"dreck", "haeufchen"}),
	     "Die Decke ist auesserst schmutzig.");
  AddDetail( "boden",
	     "Am Boden liegen einige Blechbecher und Wasserhaeute herum.");
  AddDetail( ({"waende", "wand"}),
	     "Die Hoehlenwaende erkennst Du nur ganz verschwommen.");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddItem( NPC("gnom"), REFRESH_REMOVE);

  AddSpecialDetail( "decke", "unt_decke" );

  AddCmd( ({"springe", "spring"}), "zurueck");
}

string unt_decke()
{
  if(present("gnom", TO))
    {
    return BS("Die Decke ist aeusserst schmutzig. In kleinen Broeckchen "
              "kleben Dreckklumpen an ihr und an einigen Stellen ist sie "
              "sogar mit Exkrementen beschmiert. Auf der Decke hockt ein "
              "kleiner Gnom. Du hast ihn vorhin nur fuer ein Haeufchen "
              "Dreck gehalten, aber da! Tatsaechlich, er bewegt sich.\n");
    }
  else
    {
    return BS("Die Decke ist aeusserst schmutzig. In kleinen Broeckchen "
	      "kleben Dreckklumpen an ihr und an einigen Stellen ist sie "
	      "sogar mit Exkrementen beschmiert.\n");
    }
}

zurueck( str )
{
  notify_fail("Wo willst Du hinspringen?\n");
  if(str=="zurueck"||str=="auf lavablock"||str=="zu lavablock"||
     str=="auf block"||str=="zu block")
    {
    write(BS("Du nimmst wieder kraeftig Anlauf und machst einen gewaltigen "
	     "Satz zum Lavablock zurueck.\n"));
    TP->move(LAVA("lava7"), M_GO, "", "nimmt kraeftig Anlauf und springt auf den "
	   "Lavablock zurueck", "plumpst neben Dir auf den Boden");
    return 1;
    }
  else
    return 0;
}







