// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle14.c
// 1997-05-26

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Suedlich von Dir ist der kleine, dampfende See. Er wirkt wirklich "
   +"fremdartig hier in dieser Hoehle. Der warme Wasserdampf macht die "
   +"Luft hier in der Hoehle nur noch feuchter. Von der Decke ueber Dir "
   +"ragt ein langer, duenner Tropfstein herunter, der beinahe die "
   +"Wasseroberflaeche beruehrt. Manchmal tropft ein Wassertropfen daran "
   +"herunter und platscht mit einem hellen Tropfen in den See hinein.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "see",
             "Gleich neben Dir ist der kleine See mit der sonderbar "
            +"dampfenden Wasseroberflaeche.");
  AddDetail( ({"oberflaeche", "wasseroberflaeche"}),
             "Von der Wasseroberflaeche des Sees steigt Dampf auf. "
            +"Das Wasser scheint um einiges waermer zu sein als Deine "
            +"Umgebung.");
  AddDetail( ({"hoehle", "tropfsteinhoehle", "umgebung"}),
             "Die Tropfsteinhoehle ist wirklich bizarr und sonderbar. Du bist "
            +"immer noch gefesselt von ihrem Anblick.");
  AddDetail( "anblick",
             "Der Anblick der Hoehle fesselt Dich noch immer.");
  AddDetail( ({"dampf", "wasserdampf"}),
             "Der Wasserdampf macht die Luft nur noch feuchter, als sie "
            +"ohnehin schon ist.");
  AddDetail( ({"stein", "tropfstein"}),
             "Ein langer, duenner Tropfstein haengt von der Decke herunter. "
            +"Er beruehrt beinahe die Wasseroberflaeche.");
  AddDetail( ({"wassertropfen", "tropfen"}),
              "Ein Wassertropfen tropft gelegentlich von dem langen "
             +"Tropfstein mit einem hellen *plitsch* in den See.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig. Pass auf, dass Du nicht "
            +"ausrutscht.");
  AddDetail( "wasser",
             "Das Wasser scheint sonderbarer Weise sehr warm zu sein. Du "
            +"wuerdest einmal gerne hineingreifen, um zu sehen, wie warm es "
            +"wirklich ist.");
  AddDetail( "decke",
             "Ein Wald von Stalaktiten haengt von der Decke herunter.");
  AddDetail( "stalaktiten",
             "Lange, duenne Stalaktiten, die an knoecherne Finger erinnern, "
            +"wachsen von der Decke herab.");
  AddDetail( "wald",
             "Die vielen Stalaktiten erinnern Dich an einen steinernen "
            +"Wald.");
  AddDetail( "finger",
             "Die duennen Stalaktiten sehen aus, wie unheimliche, knoecherne "
            +"Finger.");
  AddDetail( "waende",
             "Von den Waenden rinnt ein wenig Wasser herab.");
  AddDetail( "luft",
             "Die Luft ist hier durch den Dampf noch feuchter, als sie es "
            +"ohnehin schon in der ganzen Tropfsteinhoehle ist.");  

  AddSound( DEFAULT_SOUND,
    "Einige Wassertropfen tropfen gelegentlich in den See.");
  AddSound( ({"tropfen", "wassertropfen"}),
    "*tropf* *plitsch* *platsch*");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ausgesprochen feucht hier.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "greif", "greife" }), "wasser" );
  AddCmd( ({"springe", "spring"}), "see");

  AddExit( "norden", TROPFST("thoehle15"));
  AddExit( "westen", TROPFST("thoehle16"));
  AddExit( "suedosten", TROPFST("thoehle13"));
  AddExit( "suedwesten", TROPFST("thoehle17"));
}

wasser( str )
{
  notify_fail( "Wo willst Du hineingreifen?\n" );
  if( str == "in wasser" || str=="in wasser hinein")
  {
    write(BS("Du greifst vorsichtig mit einem Finger in das Wasser hinein und "
            +"stellst fest, dass es angehem warm ist. Es waere sogar warm "
            +"genug, um hineinzuspringen, Du bist allerdings noch etwas "
            +"unschluessig.\n"));
    say(BS(CAP_TPN+" greift in das Wasser hinein, und bleibt dann etwas "
            +"unentschlossen vor dem Ufer stehen.\n"));
    return 1;
  }
  return 0;
}

see( str )
{
  notify_fail( "Wo willst Du hineinspringen?\n" );
  if( str=="in wasser" || str=="in wasser hinein")
    {
    write(BS("Du ueberlegst eine Zeit lang, ob Du da wirklich hineinspringen "
            +"sollst, laesst es dann aber doch besser bleiben.\n"));
    return 1;
    }
  return 0;
}
