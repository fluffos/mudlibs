*  Thor@SilberLand           *
*  Eine Hoehle - khoehle5.c  *
*  1997-06-28                *
*****************************/

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle breitet sich hier weiter Richtung Osten aus. Du findest es "
    "angenehm, wieder etwas mehr Bewegungsfreiheit zu haben. Jetzt siehst Du "
    "auch, was es mit dem Funkeln auf sich gehabt hat. Direkt vor Dir, aus "
    "der Suedwand der Hoehle waechst ein etwa faustgrosser Kristall heraus. "
    "Er reflektiert das Licht Deiner Lichtquelle und scheint es hundertfach "
    "zu brechen. Der Kristall sieht irgendwie sonderbar aus hier, so, als ob "
    "er gar nicht hier her gehoeren wuerde, in diese trostlose Hoehle, wo "
    "ansonsten nur alles aus dumpfen, grauen Gestein besteht.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Die Hoehle fuehrt Richtung Osten weiter.");
  AddDetail( ({"freiheit", "bewegungsfreiheit"}),
             "Du hast nun wieder genuegend Platz, Dich frei zu bewegen.");
  AddDetail( "platz",
             "Manchmal koennen solche Hoehlen schon ziemlich einengend "
             "wirken. Nur gut, dass Du keine Platzangst hast.");
  AddDetail( ({"angst", "platzangst"}),
             "Oder hast Du doch?");
  AddDetail( "funkeln",
             "Das helle Funkeln wurde von einem Kristall verursacht, der "
             "hier an der Suedwand der Hoehle ist.");
  AddDetail( ({"wand", "suedwand"}),
             "Aus der Suedwand der Hoehle waechst ein ziemlich grosser "
             "Kristall heraus.");
  AddDetail( "kristall",
             "Der Kristall wirkt irgendwie ziemlich fremdartig hier. Er "
             "scheint ueberhaupt nicht in diesen Teil der Hoehle zu passen. "
             "Das graue Gestein rings um ihn laesst seine wunderbare "
             "Schoenheit noch beeindruckender erscheinen. Der Kristall "
             "reflektiert das Licht Deiner Lichtquelle in unzaehligen "
             "verschiedenen Farben.");
  AddDetail( ({"licht", "lichtquelle", "quelle"}),
             "Das Licht Deiner Lichtquelle wird vom Kristall reflektiert und "
             "gebrochen. Es verleiht ihn ein farbiges Glaenzen.");
  AddDetail( "glaenzen",
             "Der Kristall glaenzt in allen Farben des Lichtspektrums.");
  AddDetail( "farben",
             "Das Licht, das vom Kristall gebrochen wird, verleiht ihm "
             "die verschiedensten Farben, die sich dauernd aendern und "
             "den Anschein erwecken, dauernd ineinander zu zerfliessen.");
  AddDetail( "anschein",
             "Es scheint, als wuerde der Kristall dauernd seine Farbe "
             "aendern. Du kannst kaum noch Deine Augen von ihm wenden, so "
             "fasziniert bist Du von dem Spiel der Farben und von seiner "
             "atemberaubenden Schoenheit.");
  AddDetail( "augen",
             "Du kannst Deine Augen kaum noch von dem Kristall abwenden.");
  AddDetail( "schoenheit",
             "Der Kristall wirkt unter all diesem grauen, dumpfen Fels noch "
             "schoener, als er ohnehin schon ist.");
  AddDetail( ({"gestein", "fels"}),
             "Das Gestein der Hoehle ist grau und trist.");
  AddDetail( "boden",
             "Der Boden ist ziemlich glatt.");
  AddDetail( ({"waende", "hoehlenwaende"}),
             "Die Hoehlenwaende bestehen aus grauem Gestein, wie die Decke "
             "auch.");
  AddDetail( "decke",
             "Die Decke besteht aus grauem Fels.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nicht das geringste Geraeusch.");
  AddSound( "geraeusch",
    "Ich sagte doch, Du hoerst nichts.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddItem( NPC("hwolf"), REFRESH_DESTRUCT);

  AddExit( "norden", TROPFST("khoehle4"));
  AddExit( "nordwesten", TROPFST("khoehle3"));
  AddExit( "osten", TROPFST("khoehle6"));
}
