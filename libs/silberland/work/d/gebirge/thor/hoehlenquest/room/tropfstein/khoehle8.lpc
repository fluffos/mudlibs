*****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle breitet sich hier weiter aus. Du kannst weiter nach Norden, "
    "Sueden und Osten gehen, im Nordosten siehst Du eine grosse, breite "
    "Kristallsaeule bis zur Decke hinaufragen. Sie macht einen wirklich "
    "beeindruckenden Eindruck. Von der Decke siehst Du ueberall groessere und "
    "kleinere Kristalle herunterragen, selbst vom Boden wachsen bereits "
    "einige Kristallbueschel heraus. Es scheint tatsaechlich schon lange "
    "niemand mehr diese Hoehle betreten zu haben, sonst waeren einige der "
    "Kristalle am Boden bestimmt abgebrochen oder zertreten.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "hoehle",
             "Die Hoehle wurde wahrscheinlich seit Hunderten von Jahren von "
             "keinem Wesen mehr betreten, die Kristalle am Boden sind "
             "unberuehrt.");
  AddDetail( ({"wesen", "fuss", "jahre", "zeiten"}),
             "Seit ewigen Zeiten hat hier kein Wesen mehr seinen Fuss "
             "hereingesetzt.");
  AddDetail( ({"kristallsaeule", "saeule"}),
             "Im Nordosten ragt eine riesige Kristallsaeule vom Boden zur "
             "Decke hinauf. Sie macht Dich sehr neugierig, vielleicht "
             "solltest Du sie Dir mal von der Naehe betrachten.");
  AddDetail( "naehe",
             "Wie waers, wenn Du naeher rangehst?");
  AddDetail( "eindruck",
             "Die Kristallsaeule ist aeusserst beeindruckend. Es sieht "
             "beinahe so aus, als wuerde sie einen Grossteil der Decke "
             "tragen.");
  AddDetail( "kristalle",
             "Die Kristalle sind an vielen Stellen bereits zu "
             "Kristallbueschel zusammengewachsen. Sie reflektieren das Licht "
             "in Hunderten von Farben.");
  AddDetail( ({"bueschel", "kristallbueschel"}),
             "An Waenden, Decke und Boden sieht man ueberall Kristallbueschel "
             "hervorwachsen.");
  AddDetail( "licht",
             "Das Licht wird von den Kristallen gebrochen und in den "
             "verschiedensten Farben reflektiert.");
  AddDetail( "farben",
             "Die ganze Hoehle funkelt in einer Vielzahl von Farben.");
  AddDetail( ({"waende", "decke"}),
             "An Waenden und Decke sind zahlreiche Kristallbueschel "
             "festgewachsen.");
  AddDetail( "boden",
             "Selbst am Boden sieht man bereits einige Kristalle. Pass auf, "
             "dass Du keinen zusammentrittst.");

  AddSound( DEFAULT_SOUND,
    "Du herrscht drueckende Stille.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl.");
  AddSmell("luft",
    "Du atmest einmal tief durch.");

  AddCmd(({"raeume", "raeum"}), "befreiung");

  AddItem( NPC("fmaus2"), REFRESH_DESTRUCT);

  AddExit( "norden", TROPFST("khoehle7"));
  AddExit( "sueden", TROPFST("khoehle9"));
  AddSpecialExit( "osten", "haufen");
  AddExit( "westen", TROPFST("khoehle6"));
}

int haufen()
{
  int schutt;

  schutt=(int)call_other("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc", "verschuettet");
  if(schutt==0)
    return this_player()->move(TROPFST("khoehle10"), M_GO);
  else
    {
    write(BS("Der Weg nach Osten ist durch einen riesigen Kristallhaufen "
             "versperrt. Du glaubst, leise Stimmen daraus hoeren zu "
             "koennen. Vielleicht kannst Du den Weg ja wieder "
             "freiraeumen.\n"));
    return 1;
    }
}

befreiung(str)
{
  object ob, inv;
  int i;
  ob=find_object("/d/gebirge/thor/hoehlenquest/room/tropfstein/khoehle10.lpc");

  notify_fail("Was willst Du freiraeumen?\n");
  if(str=="weg frei"||str=="haufen weg"||str=="kristallhaufen weg")
    {
    if((ob->QueryProp(P_LOST))==0)
      {
      write(BS("Hier gibt es nichts zum wegraeumen.\n"));
      return 1;
      }
    else
      {
      write(BS("Mit all Deinen Kraeften beginnst Du, den grossen Kristallhaufen "
               "wegzuraeumen. Stueck fuer Stueck wird der Haufen kleiner und "
               "schliesslich ist der Weg nach Osten wieder frei.\n"));
      say(BS(CAP_TPN+" raeumt den grossen Kristallhaufen weg, der den Weg nach "
               "Osten versperrt hat.\n"));
      inv=all_inventory(find_object(TROPFST("verschuettet")));
      for (i=0;i<sizeof(inv);i++)
	{
	tell_object(inv[i], "Ploetzlich hoerst Du "
         "Geraeusche von aussen, es sieht fast so aus, als wuerde Dich "
         "jemand befreien. Ja, tatsaechlich! Schnell kletterst Du aus dem Rest "
         "des Haufens heraus.\n"); 
        inv[i]->move(TROPFST("khoehle10"), M_GO|M_SILENT);
        }
      ob->SetProp(P_LOST, 0);
      return 1;
      }
    }
  else
    return 0;
}

