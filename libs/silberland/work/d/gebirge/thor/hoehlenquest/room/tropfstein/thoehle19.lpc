// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle19.c
// 1997-05-25

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "An der suedlichen Wand der Hoehle rinnt ein schmales Baechlein herab. " 
    "Am Boden ist ein Loch im Fels, in das das Wasser hineinlaeuft und ein "
    "Stueckchen weiter plaetschert es dann wieder aus dem Fels heraus in den "
    "See. Das leise Plaetschern ist ein angenehmes Geraeusch, und Du blickst "
    "Dich ganz vertraeumt um Dich und geniesst die fremde, seltsame "
    "Schoenheit der Hoehle, mit dem sonderbar dampfenden See neben Dir.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( "wand",
             "Es rinnt ein schmales Baechlein Wasser daran herunter, das "
             "leise plaetschert.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Du geniesst die sonderbare, faszinierende Atmosphaere der "
             "Tropfsteinhoehle.");
  AddDetail( "atmosphaere",
             "Die Atmosphaere der Hoehle ist wirklich maerchenhaft.");
  AddDetail( ({"bach", "baechlein"}),
             "Von der suedlichen Wand rinnt ein schmales Baechlein herunter. "
             "Es fliesst unter dem Fels durch und plaetschert dann leise in "
             "den See hinein.");
  AddDetail( "loch",
             "Im felsigen Boden ist ein kleines Loch, in das das Baechlein "
             "hineinrinnt. Es scheint dann unter dem Fels, auf dem Du stehst, "
             "durchzufliessen und dann in den See zu plaetschern.");
  AddDetail( "fels",
             "Das Baechlein scheint unter dem Fels durchzufliessen.");
  AddDetail( "see",
             "Der kleine See ist noerdlich von Dir. Leise plaetschert das "
             "kleine Baechlein am Rand hinein.");
  AddDetail( "rand",
             "Das kleine Baechlein plaetschert am Rand des Sees hinein.");
  AddDetail( "wasser",
             "Das Wasser des Sees ist glasklar und es dampft ein wenig.");
  AddDetail( ({"plaetschern", "geraeusch"}),
             "Das Plaetschern des Wassers ist ein beruhigendes, angenehmes "
             "Geraeusch.");
  AddDetail( "schoenheit",
             "Die Schoenheit dieser Hoehle mit ihren sonderbaren "
             "Tropfsteinskulpturen und dem dampfenden See ist schon beinahe "
             "ueberirdisch.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig. Gleich neben Dir ist "
             "ein Loch darin, in das das Wasser hineinfliesst.");
  AddDetail( "waende",
             "An den Waenden rinnt ein wenig Wasser herab. An der suedlichen "
             "Wand plaetschert sogar ein kleines Baechlein herab.");
  AddDetail( "decke",
             "Von der Decke haengen lange Tropfsteine herab.");
  AddDetail( ({"tropfsteine", "steine", "tropfsteinskulpturen", "skulpturen"}),
             "Die Tropfsteine sind an manchen Stellen der Hoehle so "
             "seltsam gewachsen, dass sie an bizarre Skulpturen erinnern.");
  AddDetail( "stellen",
	     "An manchen Stellen erinnern Dich die Tropfsteine an "
	     "bizarre Skulpturen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern des schmalen Baechleins.");
  AddSound( ({"wasser", "plaetschern", "baechlein", "bach", "geraeusch"}),
    "Das Plaetschern ist ein angenehmes, beruhigendes Geraeusch.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Hoehlenluft ist angenehm kuehl und feucht.");
  AddSmell( ({"luft", "hoehlenluft"}),
    "Du atmest einmal tief die frische Luft ein und fuehlst Dich sogleich "
    "ein wenig erfrischter.");

  AddExit( "norden", TROPFST("thoehle13"));
  AddExit( "westen", TROPFST("thoehle18"));
}







