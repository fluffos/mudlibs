// Thor@SilberLand
// Eine verschollene Hoehle - hoehle5.c
// 1997-04-19

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschollene Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle scheint hier nicht mehr ganz so bruechig, wie sie es beim "
    "Eingang gewesen ist. Es liegen kaum noch Gesteinsbrocken am Boden "
    "herum. Diese Tatsache wiegt Dich wieder etwas mehr in Sicherheit. "
    "Richtung Nordosten zweigt ein schmaler Gang von der Hoehle ab.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );

  AddDetail( "hoehle",
             "Die Hoehle scheint hier etwas stabiler zu werden. Richtung "
             "Nordosten zweigt ein schmaler Gang ab.");
  AddDetail( "gang",
             "Richtung Nordosten zweigt ein schmaler Gang ab. Du bist "
             "neugierig, was sich da wohl verbergen mag.");
  AddDetail( "eingang",
             "Das Gestein scheint hier wieder stabiler als beim Eingang zu "
             "sein.");
  AddDetail( "gestein",
             "Die Waende und die Decke scheinen nicht mehr so bruechig zu "
             "sein. Es liegen auch nicht mehr so viele Felsbrocken am Boden "
             "herum.");
  AddDetail( ({"brocken", "felsbrocken", "gesteinsbrocken"}),
             "Nur noch vereinzelt liegen einige Felsbrocken am Boden herum.");
  AddDetail( "sicherheit",
             "Du fuehlst Dich wesentlich sicherer bei dem Gedanken, dass Dir "
             "wahrscheinlich kein Felsbrocken mehr auf den Kopf faellt.");
  AddDetail( "kopf",
             "Du kannst ihn wieder in Sicherheit wiegen.");
  AddDetail( "boden",
             "Der Boden ist felsig. Manchmal sieht man noch einige "
             "Felsbrocken am Boden herumliegen.");
  AddDetail( "decke",
             "Die Decke wirkt wesentlich stabiler als am Eingang.");
  AddDetail( ({"wand", "waende"}),
             "Die Waende sind grob aus dem Fels herausgehauen.");
  AddDetail( "fels",
             "Boden, Decke und Waende bestehen aus grauem Fels.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    " ... ");
    
  AddSmell( DEFAULT_SMELL,
    "Du atmest die kuehle Hoehlenluft ein.");
  AddSmell( ({"hoehlenluft", "luft"}),
    "Sie ist angenehm erfrischend.");

  AddExit( "westen", HOEHLE("hoehle3"));
  AddExit( "sueden", HOEHLE("hoehle6"));
  AddExit( "suedwesten", HOEHLE("hoehle4"));
  AddExit( "suedosten", HOEHLE("hoehle9"));
  AddExit( "nordosten", HOEHLE("hoehle8"));
}
