*  Thor@SilberLand                 *
*  Eine Drachenhoehle - drache2.c  *
*  1997-08-17                      *
***********************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Drachenhoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einer aeussert grossen, breiten Hoehle. Allein der erste "
    "fluechtige Anblick laesst Dich schaudern und jagt Dir eine Gaensehaut "
    "ueber den ganzen Koerper. Ueberall liegen Knochen herum, teils alt und "
    "ausgebleicht, teils abgenagt mit noch etwas Fleisch daran. Am Boden "
    "siehst Du tiefe Spuren, teils Schleifspuren, teils Kampfspuren. An "
    "den Waenden sind auf dem dunklen Gestein teilweise eingetrocknete "
    "Blutspritzer zu erkennen. Zweifellos, dies hier ist wohl das Heim "
    "eines grauenvollen, grausamen Monsters.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 40]) );

  AddDetail( "hoehle",
	     "Die Hoehle ist ziemlich gross.");
  AddDetail( ({"anblick", "szenario"}),
	     "Schon allein der erste Anblick der Hoehle laesst das Grauen in "
	     "Dir aufsteigen und Du wuerdest am liebsten einfach umkehren und "
	     "davonlaufen.");
  AddDetail( "grauen",
	     "Der Anblick der Hoehle ist wahrlich grauenerregend und beginnt "
             "bereits an Deinen Nerven zu nagen.");
  AddDetail( "nerven",
	     "Wenn Du noch lange das entsetzliche Szenario vor Dir anblickst, "
             "werden Dich Deine Nerven wohl bald einmal verlassen.");
  AddDetail( ({"haut", "gaensehaut"}),
	     "Eine grimmige Gaensehaut hat sich ueber Deinen ganzen "
	     "Koerper ausgedehnt.");
  AddDetail( "koerper",
	     "Er ist mit einer Gaensehaut bedeckt.");
  AddDetail( ({"knochen", "gebeine", "zwergenknochen", "menschenknochen", "hobbitknochen", "elfenknochen"}),
	     "Es scheinen so ziemlich alle Knochen dabei zu sein - sturmalte "
             "Zwergen-, Menschen-, Hobbit- und Elfenknochen, aber genauso "
	     "sind auch die Gebeine von anderen Monstern dabei.");
  AddDetail( ({"zwerge", "menschen", "elfen", "hobbit"}),
	     "Alles ist dabei.");
  AddDetail( "fleisch",
	     "An manchen Knochen haengt sogar noch etwas Fleisch daran. "
	     "Das laesst das ganze irgendwie noch schlimmer aussehen, als "
             "es ohnehin schon ist.");
  AddDetail( "spuren",
	     "Du siehst am Boden einige verschiedene Spuren. Teilweise sind "
             "es Schleifspuren, teilweise Spuren eines Kampfes.");
  AddDetail( "schleifspuren",
	     "Dies sind wohl die Spuren von den Opfern des Monsters, wie "
             "es sie herumgeschleift hat.");
  AddDetail( ({"kampf", "kampfspuren", "kaempfe"}),
	     "Hier haben wohl schon unzaehlige, grauenhafte und ebenso "
             "toedliche Kaempfe stattgefunden.");
  AddDetail( ({"decke"}),
	     "Die Decke besteht aus dunklem Lavagestein.");
  AddDetail( ({"wand", "waende"}),
	     "An den dunkeln Waenden sind einige Blutspritzer zu erkennen.");
  AddDetail( "boden",
             "Am Boden siehst Du tiefe Schleifspuren und Spuren, die von "
             "einem heftigem Kampf zeugen.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Alles besteht hier aus dunklem Lavagestein.");
  AddDetail( ({"spritzer", "blutspritzer"}),
	     "Das Monster, das hier haust, scheint seine Opfer ja wahrlich "
             "zu zerfleischen.");
  AddDetail( "opfer",
	     "Die Ueberreste der Opfer kannst Du ja ueberall sehen.");
  AddDetail( ({"ueberreste", "reste"}),
	     "Die sind reichlich vorhanden.");
  AddDetail( "heim",
	     "Verdrueck Dich lieber so schnell Du kannst.");
  AddDetail( "monster",
	     "Du willst eigentlich gar nicht so genau wissen, was das ist.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht eine unheimliche Totenstille.");
  AddSound( ({"stille", "totenstille"}),
    "Es ist wie die Ruhe vor einem Sturm.");
    
  AddSmell( DEFAULT_SMELL,
    "Ein leichter Schwefelgeruch durchzieht die heisse Luft.");
  AddSmell( ({"luft", "geruch", "schwefel", "schwefelgeruch", "hauch"}),
    "Nur ein kleiner Hauch von Schwefel liegt in der Luft.");

  AddItem( NPC("reddragon"), REFRESH_REMOVE);

  AddExit( "suedosten", LAVA("drache1"));
}
