// Thor@SilberLand
// Eine Tropfsteinhoehle - thoehle11.c
// 1997-05-23

#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Tropfsteinhoehle" );
  SetProp( P_INT_LONG,
    "Rund um Dich herum siehst Du Tropfsteine von oben nach unten und von "
   +"unten nach oben wachsen. Es sieht hier beinahe aus, wie in einer alten, "
   +"geheimnisvollen, verschollenen Saeulenhalle. Die Tropfsteine sind "
   +"schon oft zusammengewachsen und bilden so gewaltige Saeulen, die "
   +"scheinen, als wuerden sie die Decke stuetzen, die sonst einstuerzen "
   +"wuerde.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10]) );

  AddDetail( ({"tropfsteine", "steine"}),
             "Sie sind an vielen Stellen bereits zu Saeulen "
            +"zusammengewachsen.");
  AddDetail( ({"halle", "saeulenhalle"}),
             "Dieser Teil der Hoehle hier erinnert Dich an eine Saeulenhalle, "
            +"die schon seit ewigen Jahren keiner mehr betreten hat.");
  AddDetail( ({"hoehle", "tropfsteinhoehle"}),
             "Auch hier ist die Hoehle maerchenhaft schoen.");
  AddDetail( ({"saeulen", "tropfsteinsaeulen"}),
             "Maechtige Saeulen aus Tropfstein ragen vom Boden bis zur Decke "
            +"und sind daran festgewachsen. In der Mitte steht eine besonders "
            +"gewaltige Saeule... Es sieht fast aus, als wuerde sie die "
            +"gesamte Decke der Hoehle tragen.");
  AddDetail( "mitte",
             "In der Mitte siehst Du eine ausserordentlich grosse "
            +"Tropfsteinsaeule.");
  AddSpecialDetail( ({"saeule", "tropfsteinsaeule"}), "unt_saeule");
  AddSpecialDetail( ({"gestein", "stelle"}), "unt_gestein");
  AddDetail( "decke",
             "Es scheint, als wuerde die maechtige Saeule die ganze Decke "
            +"tragen.");
  AddDetail( "boden",
             "Der Boden ist feucht und glitschig.");
  AddDetail( "waende",
             "An den Waenden rinnt ein wenig Wasser herab.");
  AddDetail( "wasser",
             "Ein wenig Wasser tropft von der Decke und auch von den "
            +"Waenden.");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Tropfen des Wassers von der Decke.");
  AddSound( ({"geraeusch", "wasser", "tropfen"}),
    "Ein beruhigendes Geraeusch...");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und feucht.");
  AddSmell( "luft",
    "Du atmest einmal tief durch.");

  AddCmd( ({ "kratze", "kratz" }), "gestein");
  AddCmd( ({"schlage", "schlag"}), "waffe");
  AddExit( "norden", TROPFST("thoehle10"));
  AddExit( "nordosten", TROPFST("thoehle9"));
}

int bandersnatch=1;

gestein ( str )
{
  if( (str!="gestein"&&str!="an gestein"&&str!="an saeule"&&str!="saeule") ||
   bandersnatch==0) 
  {
    write(BS("Daran kannst Du nicht kratzen.\n"));
    return 1;
  }

  write(BS("Du kratzt ein wenig von dem Gestein herab. Allzuviel geht nicht "
          +"herunter, allerdings kannst Du erkennen, dass sich irgendetwas "
          +"dahinter zu verbergen scheint. Vielleicht solltest Du einmal mit "
          +"einer Waffe dagegenschlagen."));
  say(BS(CAP_TPN+" kratzt ein wenig an der grossen Saeule herum."));
  return 1;
}

waffe ( str )
{
  object ob;
  string schwert, ort;

  notify_fail("Wo willst Du womit dagegenschlagen?\n");
  if(!str)
    return 0;
  if(sscanf(str, "mit %s gegen %s", schwert, ort)!=2)
    return 0;

  notify_fail("Da kannst Du nicht dagegenschlagen.\n");
  if(ort!="gestein"&&ort!="saeule")
    return 0;
  if(bandersnatch==0)
    return 0;

  notify_fail("So eine Waffe hast Du ja gar nicht!\n");
  if(ob=present(schwert, TP))
    {
    if(ob->QueryProp(P_WIELDED))
      {
      write(BS("Du schlaegst einmal kraeftig mit "
             +((ob->QueryProp(P_GENDER))==MALE ? "Deinem" : "Deiner") 
             +" "+CAP(schwert)+" gegen die Saeule...\n\nDir scheint, als "
             +"wuerde ploetzlich der Fels sich zu bewegen beginnen. Du "
             +"hoerst ein dumpfes Klopfen aus dem Inneren der Saeule und "
             +"ploetzlich beginnt das Gestein wegzubrechen."));
      say(BS(CAP_TPN+" schlaegt kraeftig mit "+ob->QueryArticle(2, 0)
             +CAP(schwert)+" gegen die Saeule.\n\nUrploetzlich beginnt sich "
             +"das Gestein an der Saeule zu bewegen und es brechen auch "
             +"schon die ersten Brocken heraus."));
      call_out("monster", 5);
      return 1;
      }
    else
      write(BS("Du musst Deine Waffe schon vorher zuecken.\n"));
      return 1;
    }
  else
    return 0;
}

monster()
{
  object ob;

  write(BS("Ein riesiger Bandersnatch, vollkommen aus Stein, scheint aus "
          +"der Tropfsteinsaeule herauszuwachsen. Er richtet sich zu seinen "
          +"vollen drei Meter Groesse auf, und Du ueberlegst, ob es nicht "
          +"besser waere, einfach wegzulaufen."));
  say(BS("Ein riesiger Bandersnatch, vollkommen aus Stein, waechst aus "
          +"der Tropfsteinsaeule heraus und starrt Dich mit wutentbrannten, "
          +"rot gluehenden Augen an. Er richtet sich vor Dir zu "
          +"seinen vollen drei Meter Groesse auf, und Du ueberlegst, ob es "
          +"nicht besser waere, einfach wegzulaufen."));
  (ob=clone_object(NPC("bsnatch")))->move(TO, M_GO);
  ob->Kill(TP);
  bandersnatch=0;
}

string unt_saeule()
{
  if(bandersnatch==1)
    {
    return(BS("Die Saeule erweckt den Eindruck, als wuerde sie die gesamte "
             +"Decke der Hoehle hier in diesem Bereich tragen. Sie ist nicht "
             +"so regelmaessig gewachsen, wie die meisten anderen. An einer "
             +"Stelle kannst Du erkennen, dass das Gestein ein wenig bruechig "
             +"und aufgerauht ist."));
    }
  else
    {
    return(BS("An einer Seite ist die Saeule scheint sich vor kurzem "
             +"irgendwer zu schaffen gemacht haben. Sie ist aeusserst "
             +"ramponiert und das Gestein ist teilweise herausgebrochen."));
    }
}

string unt_gestein()
{
  if(bandersnatch==1)
    {
    return(BS("An einer Stelle ist das Gestein der Saeule ganz bruechig. Du "
            +"kannst ja mal versuchen, daran zu kratzen."));
    }
  else
    {
    return(BS("An einer Stelle der Saeule ist ziemlich viel Gestein "
             +"herausgebrochen. Was hier wohl gewesen sein mag?"));
    }
}

reset()
{
  ::reset();
  bandersnatch=1;
}



