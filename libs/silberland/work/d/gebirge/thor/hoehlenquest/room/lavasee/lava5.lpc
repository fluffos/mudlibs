*  Thor@SilberLand          *
*  Ein Lavablock - lava5.c  *
*  1997-08-08               *
****************************/


#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
	"Du stehst hier am suedlichsten Eck des Lavablocks, auf "
   +"einer kleinen Zunge, koennte man fast sagen. Rund um "
   +"Dich siehst Du nur Lava. Sie umgibt Dich, links, rechts, "
   +"vorne, ueberall. Ein scharfer Schwefeldampf steigt auf "
   +"und macht Dir das Atmen zur Qual. Du gruebelst ueber die "
   +"Metallspuren nach, die Du gelegentlich an den "
   +"Hoehlenwaenden entdecken kannst... Das sie nicht "
   +"schmelzen bei dieser Hitze direkt neben der Lava... "
   +"sonderbar. Es erscheint Dir beinahe so, als haette das "
   +"Metall etwas magisches an sich.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( ({"ecke", "eck"}),
	     "Du bist hier am suedlichsten Eck des "
	    +"Lavablocks. Weiter nach Sueden wirst Du wohl "
	    +"nicht mehr kommen.");
  AddDetail( ({"block", "lavablock"}),
	     "Einer von vielen hier in der Hoehle.");
  AddDetail( "hoehle",
	     "Die Hoehle breitet sich rund um Dich in "
	    +"gluehender Hitze aus.");
  AddDetail( "hitze",
	     "Du bist Dir nicht sicher, ob Du diese enorme "
	    +"Hitze noch lange aushaeltst oder bald "
	    +"einfach zusammenklappst.");
  AddDetail( ({"zunge", "zungen", "landzungen", "landzunge"}),
	     "Das Eck, auf dem Du hier stehst, erinnert Dich "
	    +"fast an schmale Landzungen von Inseln. Nur das "
	    +"dort meistens angenehmes, kuehles Nass in der "
	    +"Naehe ist.");
  AddDetail( ({"insel", "inseln"}),
	     "Davon bist Du weit, weit, seeeehr weit entfernt.");
  AddDetail( ({"nass", "wasser", "schluck"}),
	     "Was gaebest Du jetzt nur fuer einen winzig "
	    +"kleinen Schluck Wasser...");
  AddDetail( ({"lava", "magma", "glut"}),
	     "Die brodelnde Magma scheint ueberall zu sein.");
  AddDetail( ({"dampf", "schwefeldampf", "schwefel"}),
	     "Der viele Schwefel in der Luft laesst Deine "
	    +"Lungen bei jedem Atemzug schmerzen.");
  AddDetail( ({"atmen", "atemzug"}),
	     "Jeder Atemzug wird zur Qual in dieser gluehend "
	    +"heissen, schwefelhaltigen Luft.");
  AddDetail( "luft",
	     "Selbst die Luft scheint zu hier drinnen zu gluehen. "
	    +"Du hast beinahe das Gefuehl, als wuerdest Du Lava "
	    +"atmen.");
  AddDetail( "qual",
	     "Das Atmen entwickelt sich hier drinnen zu einer "
	    +"fuerchterlichen Qual. Du willst nur noch raus hier.");
  AddDetail( ({"lungen", "lunge"}),
	     "Deine Lungen schmerzen bereits ganz fuerchterlich vom "
	    +"scharfen Schwefel in der Luft.");
  AddDetail( ({"spuren", "metallspuren"}),
	     "Die Metallspuren an den Hoehlenwaenden erscheinen Dir "
	    +"irgendwie sonderbar. Normalerweise muessten sie doch "
	    +"so dicht bei dieser hoellischen Glut schmelzen...");
  AddDetail( ({"waende", "hoehlenwaende", "wand", "hoehlenwand"}),
	     "Immer wieder sind an den Hoehlenwaenden geringe "
	    +"Spuren eines Metalls zu sehen.");
  AddDetail( "metall",
	     "Das Metall scheint magisch zu sein, ansonsten wuerde "
	    +"es bei dieser Hitze wohl schmelzen wie Butter.");
  AddDetail( "hitze",
	     "Die Hitze gleich oberhalb der Lava muss wohl einige "
	    +"tausend Grad betragen.");
  AddDetail( ({"magie", "stoff", "spiel"}),
	     "Bei dem Metall ist bestimmt Magie im Spiel... kein "
	    +"Stoff der Welt kann sonst so wiederstandsfaehig "
	    +"sein.");
  AddDetail( "boden",
	     "Der Boden ist gluehend heiss.");
  AddDetail( "decke",
	     "Die Decke besteht aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein... nichts besonderes.");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddExit( "nordwesten", LAVA("lava4"));
  AddExit( "norden", LAVA("lava3"));
  AddExit( "nordosten", LAVA("lava2"));

}
