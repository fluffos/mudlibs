#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Lavablock" );
  SetProp( P_INT_LONG,
    "Du stehst hier in der Mitte des Lavabrockens. Direkt vor Dir ist eine "
    "etwa ein Meter breite, kreisrunde Vertiefung im Lavagestein. Darin "
    "siehst Du fluessiges, gluehendes Metall. Neben dieser Vertiefung "
    "steht ein grosser, rechteckiger Felsblock. Es sieht fast so aus, als "
    "wuerde darauf das gluehende Metall bearbeitet. Von der metallenen "
    "Glut, die sich in der Vertiefung befindet, geht eine noch enormere Hitze "
    "aus als von der Lava ohnehin. Das muss wohl daran liegen, dass Du hier "
    "noch naeher an einer Hitzequelle stehst als an der Lava, zwanzig Meter "
    "unter Dir.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 50]) );

  AddDetail( "mitte",
	     "Du bist hier in der Mitte des Lavabrockens.");
  AddDetail( ({"lavablock", "lavabrocken", "brocken"}),
	     "Er besteht aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
             "Das erstarrte Lavagestein hat eine aeusserst dunkle Faerbung.");
  AddDetail( "faerbung",
             "Diese dunkle Faerbung ist nichts Ungewoehnliches fuer das "
             "Lavagestein.");
  AddDetail( "vertiefung",
             "Direkt vor Dir siehst Du eine Vertiefung in dem "
             "grossen Lavabrocken. Sie ist kreisrund und hat einen "
             "Durchmesser von etwa einem Meter. Sie scheint ziemlich tief "
             "zu sein, denn das fluessige Metall darin schlaegt zeitweise "
             "Blasen.");
  AddDetail( "durchmesser",
             "Der ist etwa einen Meter gross.");
  AddDetail( "metall",
             "Fluessiges Metall befindet sich in der Vertiefung. Du "
             "greifst wohl besser nicht hinein.");
  AddDetail( "blasen",
             "Das fluessige Metall in der Vertiefung schlaegt manchmal grosse "
             "Blasen, die mit einem dumpfen \"BLUBB\" zerplatzen.");
  AddDetail( ({"block", "felsblock"}),
             "Der Felsblock sieht so aus, als wuerde darauf Metall "
	     "bearbeitet. Du siehst grosse, erstarrte Metallspritzer "
             "darauf.");
  AddDetail( ({"spritzer", "metallspritzer"}),
	     "Sie scheinen von fluessigem oder gluehenden Metall zu stammen.");
  AddDetail( "glut",
             "Die metallene Glut direkt neben Dir strahlt eine noch "
             "groessere Hitze aus als die Lava tief unter Dir.");
  AddDetail( "hitze",
             "Die Hitze ist hier beinahe noch unertraeglicher als im Rest der "
             "Hoehle. Du bist nahe daran, einfach umzukippen.");
  AddDetail( ({"hitzequelle", "quelle"}),
             "Das fluessige Metall direkt neben Dir macht die Hitze nochmal "
             "um einiges schlimmer...");
  AddDetail( ({"hoehle", "hoelle"}),
             "Diese Hoehle ist wirklich die Hoelle.");
  AddDetail( "lava",
             "Zwanzig Meter unter Dir brodelt die Lava.");
  AddDetail( "boden",
             "Er ist aeusserst heiss.");
  AddDetail( ({"wand", "waende", "decke"}),
             "Waende und Decke bestehen aus schwarzem Lavagestein.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Blubbern der Lavablasen unter Dir.");
  AddSound( ({"blubbern", "blasen", "lavablasen"}),
    "Blubb... BlubbBlubb... Blubb!");
    
  AddSmell( DEFAULT_SMELL,
    "Ein scharfer Schwefelgeruch steigt Dir in die Nase.");
  AddSmell( ({"schwefel", "geruch", "schwefelgeruch"}),
    "Der Geruch beleidigt Deine Nase.");

  AddCmd( ({"greife", "greif"}), "metal");
  AddCmd( ({"kippe", "kipp"}), "weg");
 
  SetProp (P_KILL_NAME, "Ein unvorsichtiger Griff");
  SetProp (P_KILL_MSG, "Das naechste mal die Finger von den heissen Sachen lassen, %s ;)");

  AddItem( NPC("zyklop2"), REFRESH_REMOVE);

  AddExit( "norden", LAVA("bruecke8"));
  AddExit( "osten", LAVA("lava2"));
  AddExit( "westen", LAVA("lava4"));
  AddExit( "sueden", LAVA("lava5"));
}

init()
{
  ::init();
  call_out("weg2", 20);
}

metal( str )
{
  object ob;

  notify_fail( "Wohin willst Du greifen?\n");
  if(str=="in metall"||str=="in vertiefung"||str=="in glut"||str=="in lava")
    {
    if(ob=TP->QueryProp(P_WEAPON))
      {
      if(ob->QueryMaterial(MAT_MAGIC)>0 || ob->QueryProp(P_MAGIC==1) ||ob->QueryMaterial(MAT_MISC_MAGIC)>0 )
	{
	write(BS("Du greifst mit Deiner Hand in das gluehende Metall. Eine "
               "aeusserst doofe Aktion muss ich schon mal anmerken! Du "
               "verbrennst Dir dabei die Hand ganz fuerchterlich. Du "
               "schreist vor Schmerz laut auf.\n"));
        say(BS(CAP_TPN+" greift  voller Unvorsicht in die Metallglut hinein "
	       "und schreit vor Schmerz laut auf.\n"));
        TP->do_damage(30+random(30));
        return 1;
	}
      else 
	{
	write(BS("Du greifst mit Deiner Hand in das gluehende Metall. Eine "
               "aeusserst doofe Aktion muss ich schon mal anmerken! Du "
               "verbrennst Dir dabei die Hand ganz fuerchterlich und zu "
               "allem Unglueck faellt Dir dabei auch noch "
	      +((ob->QueryProp(P_GENDER))==FEMALE?"Deine":"Dein")+" "
              +ob->QueryProp(P_NAME)+" in die Glut hinein und versinkt...\n"));
        say(BS(CAP_TPN+" greift voller Unvorsicht in die Metallglut hinein "
               "und schreit vor Schmerz laut auf. Zu allem Unglueck "
               "verliert "+((TP->QueryProp(P_GENDER))==MALE?"er":"sie") 
              +"dabei auch noch seine Waffe.\n"));
        TP->do_damage(30+random(30));
        ob->DoUnwield(1);
        ob->remove();
        return 1;
	}
      }
    else
      {
      write(BS("Du greifst mit Deiner Hand in das gluehende Metall. Eine "
               "sonderlich doofe Aktion muss ich schon mal anmerken! Du "
               "verbrennst Dir dabei die Hand ganz fuerchterlich. Du "
               "schreist vor Schmerz laut auf.\n"));
      say(BS(CAP_TPN+" greift  voller Unvorsicht in die Metallglut hinein "
	       "und schreit vor Schmerz laut auf.\n"));
      TP->do_damage(30+random(30));
      return 1;
      }
    }
  else
    return 0;
}

weg( str )
{
  object ob;

  notify_fail("Was willst Du machen?\n");
  if(str=="um"||str=="weg")
    {
    write(BS("Du kippst aufgrund der riesigen Hitze einfach um und bleibst "
             "wie ein Brett liegen.\n"));
    say(BS(CAP_TPN+" kippt vor Deinen Augen einfach weg und bleibt steif "
             "wie ein Brett liegen.\n"));
    (ob=clone_object("/d/ebene/obj/div/ohnmacht"))->move(TP, M_NOCHECK);
    call_out("erwachen", 8, ob);
    return 1;
    }
  else
    return 0;
}

weg2()
{
  object ob;
  if(!TP || TP->id("zyklop") || TP->id("feuergeist"))
    return 1;
  if(environment(TP)==TO)
    {
    write(BS("Du kippst aufgrund der riesigen Hitze einfach um und bleibst "
             "wie ein Brett liegen.\n"));
    say(BS(CAP_TPN+" kippt vor Deinen Augen einfach weg und bleibt steif "
             "wie ein Brett liegen.\n"));
    TP->SetProp(P_PARALYZED,
      ([ PARALYZE_TIME: 4,
         PARALYZE_MSG: "Aber Du bist doch noch ohnmaechtig!\n",
         PARALYZE_MSG_OTHER: "%s versucht sich erfolglos zu bewegen.\n",
         PARALYZE_END: "Ganz langsam kommst Du wieder zu Dir...\n"
          "Schade... ohnmaechtig waers so schoen kuehl gewesen...\n",
         PARALYZE_END_OTHER: BS("%s scheint langsam wieder zu sich zu kommen, "
          "macht allerdings keinen allzu erfreuten Eindruck darueber...") ]) );
    return 1;
    }
  else
    return 1;
}

