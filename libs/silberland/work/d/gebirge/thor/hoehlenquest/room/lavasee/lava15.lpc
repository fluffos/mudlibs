#include "../quest.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein Lavablock");
  SetProp(P_INT_LONG,
    "Richtung Nordwesten geht wieder eine kurze Bruecke weg. "
    "Sie fuehrt zu einem relativ grossem Lavablock. Er scheint "
    "direkt an die Hoehlenwand anzuschliessen, sofern Du es "
    "von hier beurteilen kannst. Unter Dir brodelt die Lava "
    "ruhig dahin und die aufsteigende Hitze schnuert Dir "
    "beinahe die Kehle zu. Du fragst Dich, warum Du Dir "
    "eigentlich eine solche Qual antust.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 50]));

  AddDetail( "bruecke",
	     "Eine kurze Bruecke fuehrt Richtung Nordwesten weg, "
			 "wo auch ein relativ grosser Lavablock ist.");
  AddDetail( ({"block", "lavablock"}),
	     "Der Lavablock im Nordwesten scheint ziemlich gross "
	     "zu sein. Er schliesst direkt an die Hoehlenwand an.");
  AddDetail( ({"wand", "hoehlenwand"}),
	     "Der grosse Lavablock nordwestlich von Dir schliesst "
	     "an die Hoehlenwand an.");
  AddDetail( ({"lava", "magma"}),
	     "Die Magma brodelt gluehend heiss unter Dir. Es steigt "
	     "eine enorme Hitze davon auf.");
  AddDetail( "hitze",
	     "Du fragst Dich, was Dich eigentlich so lange hier "
	     "unten haelt. Es ist wahrscheinlich das beste, wenn "
	     "Du einfach wieder umdrehst.");
  AddDetail( "kehle",
	     "Deine Kehle ist furchtbar ausgetrocknet und schmerzt "
	     "bereits bedenklich. Jeder Atemzug wird zur Qual.");
  AddDetail(({"zug", "atemzug"}),
	    "Bei jedem Atemzug durchfaehrt Deine Kehle und Deine "
	    "Lungen ein stechender Schmerz. Wieso tust Du Dir "
	    "eine solche Qual an? Dreh doch einfach um und leg "
	    "Dich eine Weile zur Erholung in Tijara an den "
	    "Strand.");
  AddDetail( "erholung",
	     "Die braeuchtest Du jetzt dringendst.");
  AddDetail( "tijara",
	     "Hach, der Strand in Tijara... das waere jetzt eine "
	     "feine Sache.");
  AddDetail( "strand",
	     "Ja, da waerst Du jetzt wirklich gerne... An einem "
	     "ruhigen Strand unter schattigen Palmen.");
  AddDetail( ({"palmen", "palme"}),
	     "Na Palmen wirst Du hier wohl kaum finden.");
  AddDetail( ({"lunge", "lungen"}),
	     "Du hast das Gefuehl, als waeren Deine Lungen "
	     "mittlerweile vollkommen mit Schwefel gefuellt.");
  AddDetail( "gefuehl",
	     "Auf jeden Fall kein gutes.");
  AddDetail( "schwefel",
	     "Der Schwefel stinkt erbaermlich.");
  AddDetail( ({"schmerz", "teil", "koerperteil"}),
	     "Dir tut mittlerweile schon so ziemlich jeder "
	     "Koerperteil weh.");
  AddDetail( "qual",
	     "Jetzt quaele Dich doch nicht laenger und kehre um!");
  AddDetail( "boden",
	     "Der Boden ist gluehend heiss.");
  AddDetail( ({"decke", "waende", "hoehlenwaende"}),
	     "Decke und Waende bestehen aus dunklem Lavagestein.");
  AddDetail( ({"gestein", "lavagestein"}),
	     "Dunkelfaerbiges Lavagestein, nichts besonderes.");
  AddDetail( ({"hoehle", "hoelle"}),
	     "Diese Hoehle ist die Hoelle.");


  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Blubbern der kochenden Lava unter Dir.");
  AddSound( ({"blubbern", "lava"}),
	    "Blubb... BlubbBlubb... Blubb!");
  AddSmell( DEFAULT_SMELL,
	    "Ein scharfer Schwefelgeruch sticht Dir in die Nase.");
  AddSmell( ({"geruch", "schwefel", "schwefelgeruch"}),
	    "Atme lieber nicht zu tief ein.");

  AddItem( NPC("zyklop1"), REFRESH_DESTRUCT);

  AddCmd( ({"tauche", "tauch"}), "glut");
  AddCmd( ({"springe", "spring"}), "lava");

  AddExit( "nordwesten", LAVA("bruecke12"));
  AddExit( "sueden", LAVA("lava14"));
  AddExit( "suedwesten", LAVA("lava13"));

}

glut( str )
{
  write("Hier kannst Du nirgends hintauchen, hoechstens springen.\n");
  say(BS(CAP_TPN+" hat scheinbar irgendeinen Bloedsinn vor.\n"));
  return 1;
}

lava( str )
{
  object ob;

  notify_fail("Wohin willst Du springen?\n");
  if(str=="in lava"||str=="in glut")
    {
    write(BS("Du stehst unentschlossen am Rand des Lavablocks... Du "
	     "ueberlegst und ueberlegst, nimmst Dir schliesslich aber "
	     "ein Herz und springst von dem Lavablock weg. Alles "
	     "geschieht wie in Zeitlupe. Es wird heisser und heisser, "
	     "die Lava unter Dir kommt immer naeher, naeher, naeher... \n"));
    say(BS("Du traust Deinen Augen nicht, als "+TPN+" ploetzlich vor Dir "
           "einfach vom Felsblock wegspringt und in die Lava taucht.\n"));
    if(!ob=present("kristallplatte", TP))
      {
      call_out("tod", 5);
      return 1;
      }
    if((ob->QueryProp(P_JUMP))!=5)
      {
      call_out("tod", 5);
      return 1;
      }
    call_out("leben", 5);
    return 1;
    }
  else
    return 0;
}

tod()
{
  write(BS("Es war wohl keine so gute Idee, hier runterzuspringen. Wie kann "
	   "man auch nur so bloed sein, anzunehmen, dass man einen Sprung "
	   "in die Lava ueberleben koennte ... Du spuerst nur noch, wie "
	   "Dein Koerper von ueberwaeltigender Hitze eingeschlossen wird, "
	   "und dann...\n"));
  TP->die();
}

leben()
{
  write(BS("Du hast panische Angst. Die Lava kommt immer naeher und es "
	   "wird immer heisser. Dann taucht Dein Koerper in die Lava ein "
	   "und Du hast das Gefuehl, als wuerdest Du bei lebendigem Leibe "
	   "schmelzen. Ploetzlich jedoch ist unter Dir nur Luft und Du "
	   "faellst noch ein kleines Stueckchen, bis Du einen harten Aufprall "
	   "spuerst.\n"));
  TP->reduce_hit_point(100);
  call_out("move", 5);
}

move()
{
  TP->move(LAVA("mhoehle:"+getuid(TP)), M_GO);
} 
