/*****************************************
*  Thor@SilberLand                       *
*  Ein magischer Panzer - hitzepanzer.c  *
*                                        *
*  Panzer, der gegen extrem heisse       *
*  Temperaturen schuetzt                 *
*  1997-10-09                            *
*****************************************/

inherit "std/armour";

#include "../quest.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId ( ({"panzer", "magiepanzer", "magischer panzer"}) );
  SetProp (P_SHORT, "Ein magischer Panzer");
  SetProp (P_LONG,
      "Der magische Panzer schimmert in einem leicht blaeulichem Licht. "
     +"Er hat keinerlei feste Konsistenz sondern besteht nur aus einer "
     +"seltsamen Aura.");
  SetProp (P_NAME, "Panzer");
  SetProp (P_NAME_ADJ, "magisch");
  SetProp (P_INFO,
      "Der Panzer schuetzt Dich gegen extrem hohe Temperaturen.\n");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, ([MAT_MISC_MAGIC:100]));
 
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:0, T_HEAT_PROT:25 ]) );

  SetProp (P_WEAR_FUNC, ME);
  SetProp (P_REMOVE_FUNC, ME);

}

int WearFunc(object ruest,int silent)
{
  TP->AddPursuer(ME);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemovePursuer(ME);
  return 1;
}

int PreventFollow(object dest)
{
  string fn;
  object ob;

  if (!dest) return 1;
  fn=file_name(dest);
  ob=QueryProp(P_WORN) || environment() || this_player() || this_interactive();
  if (fn[0..40] != "/d/gebirge/thor/hoehlenquest/room/lavasee")
  {
    if (ob)
      tell_object(ob,
          "Der magische Panzer verschwindet ploetzlich wieder.\n");
    remove(1);
    return 2;   // nicht weiter verfolgen... weil nicht mehr existent :)
  }
  return 1;     // weiter verfolgen aber nicht moven...
}

init()
{
  object ob, env;
  string fn;

  ::init();
  if (!is_clone(this_object())) return;
  if (!env=environment(this_object())) return;
  env=all_environment(this_object())[<1];       // aeusserstes env
  fn=file_name(env);
  ob=QueryProp(P_WORN) || environment() || this_player() || this_interactive();
  if (fn[0..40] != "/d/gebirge/thor/hoehlenquest/room/lavasee")
  {
    if (ob)
      tell_object(ob,
          "Der magische Panzer verschwindet ploetzlich wieder.\n");
    call_out("remove", 0, 1);
  }
}
