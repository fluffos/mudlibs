#include "../quest.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Baerenfell");
  SetProp(P_LONG,  
    "Ein dickes, braunes, weiches, kuscheliges Baerenfell.");
  SetProp(P_INFO, BS("Das Fell wird Dich in kalten Zeiten sicher waermen.") );
  SetProp(P_NAME, "Baerenfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "baerenfell", "\nhqbfell", "\nfell_is_gerb_able"}) );
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:4, T_HEAT_PROT:-4 ]) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_FUR:100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);

}
