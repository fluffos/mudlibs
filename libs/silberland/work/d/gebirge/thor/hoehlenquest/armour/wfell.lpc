#include "../quest.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein raeudiges Wolfsfell");
  SetProp(P_LONG,
    "Das raeudige Fell eines Wolfes. Es sieht nicht mehr besonders "
   +"vielversprechend aus.");
  SetProp(P_NAME, "Wolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolfsfell", "\nhqwfell","\nfell_is_gerb_able"}) );
  AddAdjective("raeudiges");

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_FUR:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);


}

