***********************************/

#include "../quest.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kristallpanzer");
  SetProp(P_LONG,
    "Der Kristallpanzer passt sich automatisch der Koerperform des Traegers "
   +"an. Er ist beinahe durchsichtig und funkelt und glaenzt im Licht. Er "
   +"bietet einen guten Schutz, denn der Kristall, aus dem er besteht, "
   +"scheint haerter als Stahl zu sein.");
  SetProp(P_INFO, BS("Der Kristallpanzer besteht aus miteinander "
		    +"verschmolzenen Kristallplatten.") );
  SetProp(P_NAME, "Kristallpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "kristallpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 39);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]) );
  SetProp(P_WEIGHT, 1350);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_QUALITY_DECAY, 80 );
}

int WearFunc(object me)
{
  if((TP->QueryProp(P_ALIGN))<-99)
    {
    write(BS("Der Kristallpanzer wurde immer nur von guten und ehrlichen "
	    +"Helden getragen und darf nicht in boese Haende gelangen. Er "
            +"zerbroeckelt daher einfach an Deinem Koerper.\n"));
    TO->remove();
    return 0;
    }
  else
    return 1;
}

