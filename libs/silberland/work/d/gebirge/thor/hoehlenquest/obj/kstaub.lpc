#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Etwas Kristallstaub");
  SetProp(P_LONG,
    "Ein kleines Haeufchen Kristallstaub.");
  SetProp(P_INFO, "Der Kristallstaub kann nur in einem Beutel aufbehalten "
	         +"werden, sonst rieselt er Dir einfach durch die Finger.");
  SetProp(P_NAME, "Kristallstaub");
  SetProp(P_GENDER, MALE);
  AddId( ({"staub", "kristallstaub"}) );

  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

}

init()
{
  string str;
  object ob;
  ::init();
  ob=environment(ME);
  str=file_name(ob);
  if(str!="/d/gebirge/eros/obj/beutel")
    write(BS("Der Kristallstaub wird vom Winde verweht.\n"));
}


varargs int move(mixed dest, int method)
{
  if (objectp(dest) && interactive(dest) && (method & M_GET))
    {
    if(dest->QueryProp(P_CONTAINER)!=1)
      {
      tell_room(environment(TP), "Der Kristallstaub wird vom Winde "
		                +"verweht.\n");
      TO->remove();
      return 1;
      }
    }
  else return ::move(dest,method);
}

