#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Klumpen Endurium");
  SetProp(P_LONG, 
    "Du haeltst einen grossen, schwarzen Klumpen Endurium in Deinen Haenden. "
   +"Ein blaeuliches Schimmern umgibt das Metall.");
  SetProp(P_INFO, "Endurium ist ein schwarzes Metall mit starken magischen "
         	  +"Faehigkeiten. Es ist schwarz wie die Nacht und haerter "
                  +"als alle anderen bekannten Materialien.");
  SetProp(P_NAME, "Endurium");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"endurium", "metall", "klumpen", "metallklumpen"}) );

  SetProp(P_MATERIAL, MAT_MISC_METAL );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

}
