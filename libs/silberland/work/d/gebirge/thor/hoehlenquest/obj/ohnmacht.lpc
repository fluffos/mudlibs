inherit "std/thing";

#include <properties.h>

object pl;

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp (P_IDS, ({"\nohnmacht"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 33);
  AddCmd ("", "no", 1);
  pl=0;
}

void init()
{
  ::init();
  if (!interactive(pl=environment())) pl=0;
}

int remove()
{
  if (pl)
  return ::remove();
}

int no()
{
  write ("Du bist ausreichend mit klettern beschaeftigt!\n");
  return 1;
}

