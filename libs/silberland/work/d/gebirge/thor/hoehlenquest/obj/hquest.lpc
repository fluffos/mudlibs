// Thor@SilberLand
// Questobjekt fuer die Hoehlenquest
// 1997-05-02

#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "hquest");
  SetProp(P_GENDER, NEUTER);
  AddId("\nhquest");

  SetProp(P_MATERIAL, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);

}
