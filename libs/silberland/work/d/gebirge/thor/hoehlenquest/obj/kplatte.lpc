#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Kristallplatte");
  SetProp(P_LONG,
    "Die Kristallplatte ist viereckig und etwa 30 Zentimeter lang und zwei "
    "Zentimeter dick. Sie ist blank poliert und durchsichtig. Du kannst "
    "allerdings einige Schriftzeichen darauf erkennen.");
  SetProp(P_INFO, "");
  SetProp(P_NAME, "Kristallplatte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"platte", "kristallplatte"}) );

  AddDetail( ({"zeichen", "schriftzeichen"}),
	     "Du kannst sie lesen.");

  AddCmd( ({"lies", "lese"}), "text");

  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

int i=1+random(6);

text( str )
{
  notify_fail("Was willst Du lesen?\n");
  if(str=="zeichen"||str=="schriftzeichen")
    {
    call_out("lesen", 0);
    return 1;
    }
  else
    return 0;
}

lesen()
{
  switch(i)
    {
    case 1: write(
 "   _______________________________________________________________  \n"
 "  /                                                               /|\n"
 " /                                                               / |\n"
 " ---------------------------------------------------------------   |\n"
 "|                                                               |  |\n"
 "|                                                               |  |\n"
 "|    Nun, Du bist also schon so weit gekommen...                |  |\n"
 "|    Beachtlich, beachtlich. Nun denn, so soll Dich Dein Weg    |  |\n"
 "|    jetzt auch weiter fuehren. Weiter, dorthin, wo Du schon    |  |\n"
 "|    einmal bist gewesen. Weiter, in die gluehende Hoelle       |  |\n"
 "|    zurueck. Dorthin, wo Du finden sollst, was Du solange      |  |\n"
 "|    nun schon suchst. Weiter, zu dem magischem Metalle, dem    |  |\n"
 "|    Endurium.                                                  |  |\n"
 "|                                                               |  |\n"
 "|    So steige wieder hinab, zum Anfang des Meeres aus Glut.    |  |\n"
 "|    Wende Dich sogleich nach Nordwesten, weiter, bis Du zum    |  |\n"
 "|    ersten Mal festen Boden betrittst. Dort gehe weiter        |  |\n"
 "|    nach Westen, dann wieder nach Nordwesten, bis den          |  |\n"
 "|    zweiten festen Boden Du betrittst. Dort gehe nochmals      |  |\n"
 "|    nach Westen.                                               |  |\n"
 "|                                                               |  |\n"
 "|    Nimm nun zusammen all Deinen Mut                           |  |\n"
 "|    Und tauche hinab in die feurige Glut                       |  |\n"
 "|    Hast Du alles richtig gemacht                              |  |\n"
 "|    So wird Deine Mueh' mit Lohn nun bedacht.                  |  |\n"
 "|                                                               |  |\n"
 "|                                                               | / \n"
 "|                                                               |/  \n"
 " ---------------------------------------------------------------    \n"
    );
    SetProp(P_JUMP, 1);
    break;

    case 2: write(
 "   _______________________________________________________________  \n"
 "  /                                                               /|\n"
 " /                                                               / |\n"
 " ---------------------------------------------------------------   |\n"
 "|                                                               |  |\n"
 "|                                                               |  |\n"
 "|    Nun, Du bist also schon so weit gekommen...                |  |\n"
 "|    Beachtlich, beachtlich. Nun denn, so soll Dich Dein Weg    |  |\n"
 "|    jetzt auch weiter fuehren. Weiter, dorthin, wo Du schon    |  |\n"
 "|    einmal bist gewesen. Weiter, in die gluehende Hoelle       |  |\n"
