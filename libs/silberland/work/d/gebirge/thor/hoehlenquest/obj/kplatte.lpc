    case 5: write(
 "   ______________________________________________________________  \n"
 "  /                                                              /|\n"
 " /                                                              / |\n"
 " --------------------------------------------------------------   |\n"
 "|                                                              |  |\n"
 "|                                                              |  |\n"
 "|    Nun, Du bist also schon so weit gekommen...               |  |\n"
 "|    Beachtlich, beachtlich. Nun denn, so soll Dich Dein Weg   |  |\n"
 "|    jetzt auch weiter fuehren. Weiter, dorthin, wo Du schon   |  |\n"
 "|    einmal bist gewesen. Weiter, in die gluehende Hoelle      |  |\n"
 "|    zurueck. Dorthin, wo Du finden sollst, was Du solange     |  |\n"
 "|    nun schon suchst. Weiter, zu dem magischem Metalle, dem   |  |\n"
 "|    Endurium.                                                 |  |\n"
 "|                                                              |  |\n"
 "|    So steige wieder hinab, zum Anfang des Meeres aus Glut.   |  |\n"
 "|    Wende Dich sogleich nach Nordwesten. Sobald Du festen     |  |\n"
 "|    Boden erreichtst, gehe eines nach Westen, dann weiter     |  |\n"
 "|    nach Norden. Erreichst Du zum zweiten mal festen          |  |\n"
 "|    Boden, gehe nach Nordosten.                               |  |\n"
 "|                                                              |  |\n"
 "|    Nimm nun zusammen all Deinen Mut                          |  |\n"
 "|    Und tauche hinab in die feurige Glut                      |  |\n"
 "|    Hast Du alles richtig gemacht                             |  |\n"
 "|    So wird Deine Mueh' mit Lohn nun bedacht.                 |  |\n"
 "|                                                              | / \n"
 "|                                                              |/  \n"
 " --------------------------------------------------------------    \n"
    );
    SetProp(P_JUMP, 5);
    break;

    case 6: write(
 "   ______________________________________________________________  \n"
 "  /                                                              /|\n"
 " /                                                              / |\n"
 " --------------------------------------------------------------   |\n"
 "|                                                              |  |\n"
 "|                                                              |  |\n"
 "|    Nun, Du bist also schon so weit gekommen...               |  |\n"
 "|    Beachtlich, beachtlich. Nun denn, so soll Dich Dein Weg   |  |\n"
 "|    jetzt auch weiter fuehren. Weiter, dorthin, wo Du schon   |  |\n"
 "|    einmal bist gewesen. Weiter, in die gluehende Hoelle      |  |\n"
 "|    zurueck. Dorthin, wo Du finden sollst, was Du solange     |  |\n"
 "|    nun schon suchst. Weiter, zu dem magischem Metalle, dem   |  |\n"
 "|    Endurium.                                                 |  |\n"
 "|                                                              |  |\n"
 "|    So steige wieder hinab, zum Anfang des Meeres aus Glut.   |  |\n"
 "|    Wende Dich sogleich nach Nordwesten. Sobald Du festen     |  |\n"
 "|    Boden erreichtst, gehe eines nach Westen, dann weiter     |  |\n"
 "|    nach Norden. Erreichst Du zum zweiten mal festen          |  |\n"
 "|    Boden, halte sogleich inne, denn erreicht hast Du Dein    |  |\n"
