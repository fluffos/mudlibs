#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Feuerperle");
  SetProp(P_LONG,
    "Die Feuerperle ist das Herz eines Feuergeistes. Aus ihr nimmt er all "
   +"die Energie seiner Flammen.");
  SetProp(P_INFO, BS("Die Feuerperle flackert leicht, wenn Du sie zwischen "
	         +"Deinen Fingern hin und her drehst."));
  SetProp(P_NAME, "Feuerperle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"perle", "feuerperle"}) );

  SetProp(P_MATERIAL, ([MAT_PEARL:90, MAT_FIRE:10]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);
}
