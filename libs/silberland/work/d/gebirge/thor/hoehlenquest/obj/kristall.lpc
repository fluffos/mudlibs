#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Bergkristall");
  SetProp(P_LONG,
    "Ein wunderbar funkelnder Bergkristall. Er reflektiert das Licht und "
   +"und scheint dadurch in den verschiedensten Farben zu glaenzen. Du "
   +"kannst kaum den Blick von solcher Schoenheit wenden.");
  SetProp(P_INFO, "Der Bergkristall ist etwa 20 cm lang und 5 cm breit. "
                 +"Seine fuenf Kanten laufen vorne zu einem gleichmaessigen "
                 +"Spitz zusammen.");
  SetProp(P_NAME, "Bergkristall");
  SetProp(P_GENDER, MALE);
  AddId("kristall", "bergkristall");

  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 700);
  SetProp(P_NOBUY, 0);

}
