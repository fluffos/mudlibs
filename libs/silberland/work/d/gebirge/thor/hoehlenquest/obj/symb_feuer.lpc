// Thor@SilberLand
// Das Symbol des Feuers
// 1997-08-03

#include "../quest.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Das Symbol des Feuers");
  SetProp(P_LONG,
    "Du haeltst eine Metallplatte in Deinen Haenden, die etwa 10 cm "
   +"Durchmesser hat. Die Platte ist ca. einen Zentimeter dick. Darauf "
   +"eingepraegt siehst Du eine Flamme.");
  SetProp(P_INFO, "Das Metall, aus dem die Platte gemacht ist, ist Dir "
   +"unbekannt. Du raetselst, wofuer sie wohl zu gebrauchen ist.");
  SetProp(P_NAME, "Symbol des Feuer");
  SetProp(P_GENDER, NEUTER);
  AddId(({"feuer", "flamme",  "platte", "symbol", "feuer-symbol", "feuersymbol", "metallplatte"}));

  SetProp(P_MATERIAL, ([MAT_MISC_METAL:100]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);

}
