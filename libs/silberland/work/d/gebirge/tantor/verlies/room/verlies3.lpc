#include "../files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
status sand_weg;
create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einem duesteren Verlies." );
  SetProp( P_INT_LONG,
    "Hier ist sonderbarerweise kein Wasser mehr.\n"
  + "Die Waende sind stark mit Moos besetzt und die Decke scheint als wuerde " 
  + "sie jeden Moment zusammenstuerzen. Dieses Verlies bereitet Dir Angst. "
  + "Du stehst nun in der Mitte des Verlieses.\n");  
  SetProp( P_LIGHT, 0 );      
  SetProp( P_INDOORS, 1 );  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind dicht mit Moos besetzt. Man sieht kaum noch die Ziegel "
  + "darunter.\n");

  AddDetail( ({ "farbe", "gruen" }),
    "Ein fauliges Gruen.\n");

  AddDetail( ({ "moos" }),
    "Braunens, teilweise verfaultes Moos.\n");

  AddDetail( ({ "ziegel" }),
    "Sehr alte Ziegel. Man kann kaum noch die Farbe erkennen, weil sie bis "
  + "zur Decke mit Moos bewachsen sind.\n");
  
  AddDetail( ({ "decke" }),
    "Die Decke droht jeden Moment einzustuerzen!!!\n");

  AddDetail( ({ "moment" }),
    "Naja gerade jetzt koennte die Decke auf Dich stuerzen.\n");

  AddDetail( ({ "angst", "furcht"}),
    "Du hoffst hier nicht sterben zu muessen!\n");

  AddDetail( ({ "boden"}),
    "Du endeckst ein Siegel am Boden.\n");

  AddSpecialDetail( ({ "siegel"}), "siegelfunc");
 
  AddSpecialDetail( ({ "sand"}), "sandfunc");
 
  AddSpecialDetail( ({"skelett"}), "skelettfunc");  

  AddDetail( ({ "verlies", "stuerme"}),
    "Du befindest Dich darin. Tantor hat es fuer Dich erschaffen.\n");
 
  AddDetail( ({ "tantor" }),
    "Tantor ist ein netter Magier. Vergiss das nie wenn du ihm boese bist!\n");

  AddDetail( ({ "magier" }),
    "Die Magier gestalten das Silberland.\n");

  AddDetail( ({ "silberland" }),
    "Du befindest Dich mitten im Silberland.\n");
  
  AddDetail( ({ "mitte" }),
    "Du bemerkst etwas am Boden."); 

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Wasser plaetschern.");

  AddSound( ({ "wasser" }),
    "Das Wasser klingt sehr dickfluessig.");

  AddSmell( DEFAULT_SMELL,
    "Es richt faulig.");

  AddSmell( ({ "wasser" }),
    "Pfuiiiii!!!!!");

  AddCmd (({"entferne", "entfern"}), "sand_entfernen");

  AddExit( ({"norden"}), ROOM("verlies1.lpc"));
  AddExit( ({"westen"}), ROOM("verlies2.lpc"));
  AddExit( ({"osten"}), ROOM("verlies4.lpc"));
}

string sandfunc(string str)
{
  if (sand_weg)
    return "Der Sand ist schon weg. Du kannst das Siegel sehen.\n";
  else
    return "Bei genauerem Betrachten stellst du fest das der Sand von einem "
      + "altem Skelett stammt. Du willst den Sand schleunigst entfernen.\n";
}

string siegelfunc(string str)
{
  if (sand_weg)
    return "Du endeckst das du eine Art Schluessel "
         + "brauchst um das Siegel zu oeffnen.\n";
  else
    return "Es ist ganz von feinem Sand bedeckt. Du kannst nichts genaues "
         + "erkennen.\n";
}

string skelettfunc(string str)
{
  if (sand_weg)
    return "Nachdem du den Staub im Raum verteilt hast sieht es nicht wie ein "
    +      "Skelett aus.\n";
  else
    return "Das Skelett eines verzweifelnden Abenteurers.\n";
}

sand_entfernen(string str)
{
  notify_fail("Was willst du entfernen?\n");
  if (str == "sand")
  {
    if (sand_weg)
      write("Warum der Sand ist schon weg!\n");
    else
    {    
      write("Du wischt den Sand weg.\n");
      sand_weg=1;
    }
    return 1;
  }
  return 0;
}     
