#include "../files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einem duesteren Verlies." );
  SetProp( P_INT_LONG,
    "Du stehst knoecheltief im Wasser.\n"
  + "Die Waende sind stark mit Moos besetzt und die Decke scheint als wuerde " 
  + "sie jeden Moment zusammenstuerzen. Dieses Verlies bereitet Dir "
  + "Angst.\n");
  SetProp( P_LIGHT, 0 );      
  SetProp( P_INDOORS, 1 );  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wasser" }),
    "Das Wasser hat eine faulig, gruene Farbe.\n");

  AddDetail( ({ "farbe", "gruen" }),
    "Ein fauliges Gruen.\n");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind dicht mit Moos besetzt. Man sieht kaum noch die Ziegel "
  + "darunter.\n");

  AddDetail( ({ "moos" }),
    "Braunens, teilweise verfaultes Moos.\n");

  AddDetail( ({ "ziegel" }),
    "Sehr alte Ziegel. Man kann kaum noch die Farbe erkennen, weil sie bis "
  + "zur Decke mit Moos bewachsen sind.\n");

  AddDetail( ({ "decke" }),
    "Die Decke droht jeden Moment einzustuerzen!!!\n");

  AddDetail( ({ "moment" }),
    "Naja gerade jetzt koennte die Decke auf Dich stuerzen.\n");

  AddDetail( ({ "angst", "furcht"}),
    "Du hoffst hier nicht sterben zu muessen!\n");

  AddDetail( ({ "boden"}),
    "Das faulige Wasser bedeckt den Boden vollkommen. Versuch halt den Boden "
  + "zu ertasten.\n");

  AddDetail( ({ "verlies", "stuerme"}),
    "Du befindest Dich darin. Tantor hat es fuer Dich erschaffen.\n");
 
  AddDetail( ({ "tantor" }),
    "Tantor ist ein netter Magier. Vergiss das nie wenn du ihm boese bist!\n");

  AddDetail( ({ "magier" }),
    "Die Magier gestalten das Silberland.\n");

  AddDetail( ({ "silberland" }),
    "Du befindest Dich mitten im Silberland.\n");
  

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Wasser plaetschern.");

  AddSound( ({ "wasser" }),
    "Das Wasser klingt sehr dickfluessig.");

  AddSmell( DEFAULT_SMELL,
    "Es richt faulig.");

  AddSmell( ({ "wasser" }),
    "Pfuiiiii!!!!!");

  AddCmd( ({ "taste", "tast" }), "tasten" );

  AddExit( ({"suedwesten"}), ROOM("verlies2.lpc"));
  AddExit( ({"sueden"}), ROOM("verlies_.lpc"));
  AddExit( ({"suedosten"}), ROOM("verlies4.lpc"));
}

tasten(string str )
{
  notify_fail( "Was willst ertasten?\n" );
  if( str == "boden" )
  {
    write("Naja da solltest du was bekommen, aber Tantor hat den Item "
    +  "noch nicht geproggt.\n");
    return 1;
  }
  return 0;
}
