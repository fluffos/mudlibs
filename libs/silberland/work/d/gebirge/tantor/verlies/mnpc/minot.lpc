
#include "../files.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein gewaltiger Minotaurus");
  SetProp(P_LONG, 
    break_string("Der Minotaurus hat den Kopf einens Stiers und den Koerper"
  + " eines Menschen.\n"
  
  + "Sein Fell ist schwarz und seine Hoerner schauen aus "
  + "als wollten sie dich sofort zerfleischen.\n"));
  
SetProp(P_NAME, "Minotaurus");
   SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"minotaurus"}));
  set_living_name("Minotaurus");
  SetProp(P_LEVEL, 10);
  SetProp(P_HANDS, ({" mit fuerchterlichen Klauen.\n",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, 120);
  SetProp(P_BODY, 20);
  SetProp(P_XP, 100); // Bonus fuer Spells
  SetProp(P_RACE, "Minotaurus");
  SetProp(P_SIZE, 220);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      2.0, DT_COLD:      0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      2.0, DT_UNHOLY:    0.0, DT_MAGIC:  2.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein.");
  SetProp(P_MSGOUT, "geht.");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke.");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft.");
  SetProp(P_MNPC_AREA, ROOM("") );
  SetProp(P_MNPC_WAIT, ({ 10,30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("verlies1.lpc"));
  SetProp(P_MNPC_FLAGS, MOV_MOVES);

  SetProp(P_DIE_MSG,  " faellt sterbend vor Dir auf den Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste mal bist Du dran!");
  SetProp(P_KILL_NAME, "Ein gewaltiger Minotaurus");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "mag Dir nicht antworten.\n");
  AddInfo("Tantor", "Tantor ist mein Meister!!!","bruellt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "<name> braucht deinen wertlosen Kram nicht." }) );

  SetProp(P_SPELLRATE,40);

  AddSpell(10,20,
    "Der Minotaurus uebertraegt Dir seine unheiligen Gedanken.\n",
    "@WER ueberhaeuft @WEN mit unheiligen Gedanken.\n",
     ({DT_UNHOLY}),([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Ich mag Dich nicht.\n", "Tantor ist ein netter Magier.\n"}) );
  SetAttackChats(10, ({
    "Ich werde dich zerreissen!\n", "Zerreist dich in Stuecke!\n"}) );

//  SUID;
//  CLONEME(WEAPON "" );
//  command("zuecke waffe");
//  CLONEME(ARMOUR "" );
//  command("trage alles");
}
