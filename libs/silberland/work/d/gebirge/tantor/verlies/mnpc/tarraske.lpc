
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>

void create()
{
  int level;

  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(50);
  SetProp(P_SHORT, "Die Tarraske");
  SetProp(P_LONG, 
    break_string("Die legendaere Tarraske, und es gibt gluecklicherweise nur ein bekanntes\n"
  + "solches Wesen, ist das gefuerchtetste Monster des Silberlandes. Das Wesen ist ein\n"   + "geschuppter Zweibeiner mit zwei Hoernern auf seinem Kopf, einem Peitschenschwanz und\n"
  + "einem reflektierenden Panzer.\n"));
  SetProp(P_INFO, "Die Tarraske ist eine Toetungsmaschine!\n");
  SetProp(P_NAME, "Die Tarraske");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:20]));
  AddId(({"tarraske"}));
  set_living_name("Tarraske");
  level=50;
  SetProp(P_LEVEL, level);
  SetProp(P_HANDS, ({" mit maechtigen Klauen.\n",level,DT_BLUDGEON}));
  SetProp(P_MAX_HP, (level*level+100));
  SetProp(P_BODY, (level*3));
  SetProp(P_XP, (level*level*level*100)); // Bonus fuer Spells
  SetProp(P_RACE, "Tarraske");
  SetProp(P_ARTICLE, 1);
  SetProp(P_SIZE, 1500);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,150);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, ("NOWIMPY"));
  SetProp(P_RESISTANCE, ([DT_FIRE,DT_UNHOLY,DT_POISON]));
  SetProp(P_VULNERABILITY, ([DT_HOLY,DT_LIGHT]));
//  SetProp(P_RESISTANCE_STRENGTHS , 
//   ([DT_FIRE:      2.0, DT_COLD:      0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
//    DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
//    DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
//    DT_HOLY:      2.0, DT_UNHOLY:    0.0, DT_MAGIC:  2.0 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "kriecht herein.");
  SetProp(P_MSGOUT, "kriecht davon.");
  SetProp(P_MMSGIN, "matrialisiert.");
  SetProp(P_MMSGOUT, "dematrialisiert.");
  SetProp(P_MNPC_AREA, ("/players/tantor/workroom.lpc") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, "/players/tantor/workroom.lpc");
//  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " verschwindet aus dieser Dimension.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste mal bist Du dran!");
  SetProp(P_KILL_NAME, "Die gefuerchtete Tarraske");
  SetProp(P_KILL_MSG, "Ich bin unsterblich!!!");

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("Tantor", "Tantor ist mein Meister!!!","bruellt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Tarraske faucht laut auf!!!\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(60,40,
    "@WER zerfetzt Dich mit ihren Klauen.\n",
    "@WER zerfetzt @WEN mit ihren Klauen.\n",
     ({DT_TERROR}),([SP_SHOW_DAMAGE:1]));

  AddSpell(50,60,
    "@WER wirft dich mit einem Schwanzhieb zu Boden.\n",
    "@WER wirft @WEN mit einem Schwanzhieb zu Boden.\n",
     ({DT_TERROR}),([SP_SHOW_DAMAGE:1]));

  AddSpell(70,70,
    "@WER reisst Dir mit ihrem Maul fasst den Kopf ab.\n",
    "@WER reisst @WEN mit ihrem Maul fasst den Kopf ab.\n",
     ({DT_TERROR}),([SP_SHOW_DAMAGE:1]));

  AddSpell(40,90,
    "@WER stoesst Dich mit ihren Hoernern zu Boden.\n",
    "@WER stoesst @WEN mit ihren Hoernern zu Boden.\n",
     ({DT_TERROR}),([SP_SHOW_DAMAGE:1]));

  AddSpell(100,100,
    "@WER betet zu Tantor!!\nSie schlaegt Dich mit unheiliger, goettlicher Macht!!\n",
    "@WER schlaegt @WEN mit unheiliger Macht.\n",
     ({DT_UNHOLY}),([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(10, ({
    "Arrrghhhhhhhhh!\n", "Ich zerreise dich in Stuecke!\n"}) );

}
