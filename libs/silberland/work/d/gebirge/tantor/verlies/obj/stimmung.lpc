#include <properties.h>
#include <language.h>
inherit "/std/thing";

create()
{
	::create();
	SetProp(P_SHORT,"Partystimmung");
	SetProp(P_LONG,"Ein wenig Partystimmung als Vorgeschmack!!!\n"
        +       "Man sollte sie gleich verbrauchen.\n");
	AddId("stimmung");
	AddId("party");
	AddId("partystimmung");
	SetProp(P_NAME,"Partystimmung");
	SetProp(P_GENDER, 2);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("verbrauch","verbrauche");
}

verbrauch(str)
{
	if (!str || ( str!="stimmung" && str!="party" && str!="partystimmung"))
        { 
      	write("Du verbrauchst die Partystimmung und freust dich nun mehr auf Donnerstag\n"+
	"PARTY !! PARTY !! PARTY !!\n");
        say(this_player()->name() + " hat nun eine bessere Stimmung.\n");
        this_object()->remove();
	return 1;
        }
 return 0;
}