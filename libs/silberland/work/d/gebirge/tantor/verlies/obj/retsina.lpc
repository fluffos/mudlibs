#include <properties.h>
#include <language.h>
inherit "/std/thing";

int offen;

create()
{
	::create();
	offen=0;
	SetProp(P_SHORT,"Eine Flasche Retsina");
	SetProp(P_LONG,"Eine @@aufzu@@ Flasche Retsina fuer EVE!!!\n");
	AddId("retsina");
	AddId("retsinaflasche");
	AddId("flasche");
	SetProp(P_NAME,"Flasche Retsina");
	SetProp(P_GENDER, 2);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("oeffne","oeffne");
	add_action("schliesse","schliess",1);
	add_action("trinke","trink",1);
}

aufzu()
{
	if (offen) 
		return "offene";
	else 
		return "verschlossene";
}

oeffne(str)
{
	if (!str || ( str!="retsina" && str!="flasche" && str!="retsinaflasche")) 
		return 0;
        if (offen) {
                write("Die Flasche ist bereits offen!\n");
                return 1;
        }
        offen=1;
        write ("Du nagst mit den Zaehnen solange an der Flasche, bis der "
        +      "Korken rausspringt.\n");
        say(this_player()->name() + " macht eine Flasche Retsina auf.\n");
        return 1;
}
 
schliesse(str)
{
	if (!str || ( str!="retsina" && str!="flasche" && str!="retsinaflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist doch zu!\n");
                return 1;
        }
        offen=0;
        write("Du steckst den Korken wieder in die Flasche.\n");
        say(this_player()->name() + " macht die Flasche Retsina wieder zu.\n");
        return 1;
}
 
trinke(str)
{
	if (!str || ( str!="retsina" && str!="flasche" && str!="retsinaflasche")) 
		return 0;
        if (!offen) {
                write("Die Flasche ist aber zu!\n");
                return 1;
        }
	write("Du setzt die Flasche an den Mund und trinkst den Wein in einem\n"+
	"Zug aus.\n");
        say(this_player()->name() + " trinkt die Flasche Retsina.\n");
	this_object()->remove();
	return 1;
}
