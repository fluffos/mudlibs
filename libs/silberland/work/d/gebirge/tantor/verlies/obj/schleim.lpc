
#include "../files.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine handvoll Schleim.");
  SetProp(P_LONG,
    "Eine handvoll gruenem, eckeligem Schleim vom Boden des Verlieses.\n" );
  SetProp(P_INFO, "Vielleicht kann man es essen?");
  SetProp(P_NAME, "Schleim");
  SetProp(P_GENDER, MALE);
  AddId("schleim");

  SetProp(P_MATERIAL, ([MAT_MAGIC:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);

}
