#include <properties.h>
#include <language.h>
inherit "/std/thing";

int offen;

create()
{
	::create();
	offen=0;
	SetProp(P_SHORT,"Ein Fass Vokda");
	SetProp(P_LONG,"Ein @@aufzu@@ Fass VODKA fuer CRAY!!!\n");
	AddId("vodka");
	AddId("vodkafass");
	AddId("fass");
	SetProp(P_NAME,"Fass Vodka");
	SetProp(P_GENDER, 2);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("oeffne","oeffne");
	add_action("schliesse","schliess",1);
	add_action("trinke","trink",1);
}

aufzu()
{
	if (offen) 
		return "offene";
	else 
		return "verschlossene";
}

oeffne(str)
{
	if (!str || ( str!="vodka" && str!="fass" && str!="vodkafass")) 
		return 0;
        if (offen) {
                write("Das Fass ist bereits offen!\n");
                return 1;
        }
        offen=1;
        write ("Du schlaegst ein Loch in das Fass.\n");
        say(this_player()->name() + " macht eine Fass Vodka auf.\n");
        return 1;
}
 
schliesse(str)
{
	if (!str || ( str!="vodka" && str!="fass" && str!="vodkafass")) 
		return 0;
        if (!offen) {
                write("Das Fass ist doch zu!\n");
                return 1;
        }
        offen=0;
        write("Du verstopfst das Loch.\n");
        say(this_player()->name() + " macht die Fass Vodka wieder zu.\n");
        return 1;
}
 
trinke(str)
{
	if (!str || ( str!="vodka" && str!="fass" && str!="vodkafass")) 
		return 0;
        if (!offen) {
                write("Das Fass ist aber zu!\n");
                return 1;
        }
	write("Du setzt das Fass an den Mund und trinkst den Vodka in einem\n"+
	"Zug aus.\n");
        say(this_player()->name() + " trinkt das Fass Vodka.\n");
	this_object()->remove();
	return 1;
}
