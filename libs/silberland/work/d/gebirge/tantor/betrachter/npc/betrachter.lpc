
inherit "std/npc";
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>



void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Phyngar, das Auge der Tiefe");
  SetProp(P_LONG,
    "\nPhyngar, das Auge der Tiefe.\n----------------------------\n"
   +"Der Betrachter, auch Augentyrann oder Kugel der "
   +"vielen Augen gennant, lebt hier in seiner Hoehle.\n"
   +"Der kugelfoermige Koerper des Betrachters haelt sich durch Levitation in der "
   +"Luft und kann sich nach Belieben in jede Richtung bewegen, allerdings nur langsam."
   +"Auf der Kugel befinden sich 10 Augenstiele, waehrend sich in der Mitte der Vorderseite "
   +"ein elftes, das große Zentralauge, befindet, ueber einem grossen, mit spitzen Zaehnen "
   +"gefuelltes Maul.\n");
  
  SetProp(P_NAME, "Phyngar");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:30]));
  
  AddId(({"phyngar", "betrachter"}));
  set_living_name("phyngar");
  create_default_npc(30+random(10));
  
  SetProp(P_HANDS, ( {" mit einem geistigen Schlag",150+random(50),DT_TERROR} ));
  SetProp(P_MAX_HP, 1200+random(200));
  SetProp(P_BODY, 350);
  SetProp(P_XP, QueryProp(P_XP)+35000+random(5)*1000); // Bonus fuer Spells
  SetProp(P_RACE, "betrachter");
  SetProp(P_WEIGHT,500);
  SetProp(P_SIZE, 280+random(20));
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 9);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
   ([DT_FIRE:      -0.3, DT_COLD:      0.3, DT_WATER:  0.0, DT_AIR:    0.0, 
    DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
    DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
    DT_HOLY:      0.3, DT_UNHOLY:    -0.5, DT_MAGIC:  -0.5 ]) );
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,50);
  SetProp(P_MSGIN, "erscheint aus einem Spalt in den Dimensionen");
  SetProp(P_MSGOUT, "dematerialisiert");  
  SetProp(P_MMSGIN, "materialisiert");
  SetProp(P_MMSGOUT, "dematerialisiert");
  SetProp(P_DIE_MSG,  " zerplatzt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Das sag ich meiner Mama!\n");
  SetProp(P_KILL_NAME, "Phyngar");
  SetProp(P_KILL_MSG, "Hahahahaha!!!");

  //Infos
  AddDetail("augen", "Du scheinst eine magische Aura um das grosse Zentralauge zu liegen.\n");
  AddDetail("zentralauge", "Das grosse Zentralauge scheint dein magisches Potential zu schwaechen.\n");
  
  AddInfo("tantor", "Tantor ist mein Meister!\n","bruellt: ");
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
  
  SetProp(P_LOG_INFO, "phyngar");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Aaaaaargh!! Was soll ich damit.\n" }) );
  SetProp(P_SPELLRATE,70);
  
  AddSpell(40,20+random(5),
    "Phyngar stiehlt Dir einen Teil deines Geistes.\n",
    "Phyngar stiehlt " + TP->Name(WER) + " einen Teil seines Geistes.\n",
     DT_MIND,([SP_SHOW_DAMAGE:1]));
     
  AddSpell(30,50+random(10),
    "Phyngar verursacht eine schwere Wunde.\n",
    "Phyngar versucht " + TP->Name(WER) +" eine schwere Wunde.\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(30,100+random(20),
    "Phyngar loest einen Teil deines Koerpers auf.\n",
    "Phyngar loest einen Teil von " + TP->Name(WER) + " auf.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(20,200+random(40),
    "Phyngar wirft einen Todeszauber nach Dir.\n",
    "Phyngar wirft einen Todeszauber nach " + TP->Name(WER) + ".\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));  
  
  
   

  SetChats(2, ({
    "Phyngar reibt sich sein anti-magisches Auge.\n",
    "Phyngar vernichtet Deine magischen Kraefte.\n",
    "Phyngar nimmt Dir Deine magische Kraft.\n",
    "Phyngar schwebt im Kreist.\n"}) );
  SetAttackChats(1, ({
    "Phyngar saugt Dein magisches Potential ab.\n",
    "Phyngar bruellt: Ich werde Dich zerreissen.\n",
    "Phyngar bruellt: Meister gib mir Deine Macht!!\n",
    "Phyngar zerkaut Deine magische Kraft.\n"}) );

  SUID;
  //CLONEME(WEAPON "" );
  //command("zuecke waffe");
  CLONEME("/d/gebirge/tantor/betrachter/obj/phasenruestung");
  command("trage alles");
}

