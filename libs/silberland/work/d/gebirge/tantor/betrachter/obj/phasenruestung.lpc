
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Phasenruestung");
  SetProp(P_LONG, 
    "Die Phasenruestung flimmert vor deinen Augen. Sie scheint zum Teil in einer anderen "
   +"Dimension zu existieren.\n" );
  SetProp(P_INFO, BS("Die Phasenruestung ist eine sehr maechtige Ruestung.") );
  SetProp(P_NAME, "Phasenruestung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ruestung", "phasenruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35+random(5));
  SetProp(P_MATERIAL, ([ MAT_MAGIC:100 ]) );
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 4500);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_PIERCE:1]) );
 // SetProp(P_WEAR_RESTRICTIONS, ([A_IN:15, A_GE:12]) );
}

int WearFunc(object me) {  
  if ((TP->QueryProp(P_LEVEL)) < 25)
  { write(BS("Du bist nicht maechtig genug!\n"));
    TO->remove();
    return 0; }
  
  return 1;
}

int RemoveFunc(object me) {
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  if (member(dam_type, DT_MAGIC) >= 0)
  {
  	write(BS("Die Ruestung wandelt den magischen Angriff um und heilt Dich.\n"));
  	TP->SetProp(P_HP,TP->QueryProp(P_HP)+((member(dam_type, DT_MAGIC))/2));  
  }
  return 0;
}
