
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine geheimer Raum in einer Hoehle." );
  SetProp( P_INT_LONG,
    "Du befindest dich in einem sehr! kleinen Raum."
   +" Du erkennst den Spalt hinter dir und ein Loch im Boden.\n");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  
  AddDetail(({"loch", "boden"}), "Du kannst versuchen nach unten zu klettern.\n");
  AddCmd( ({ "kletter", "klettere" }), "klettern");  
 AddCmd( ({ "zwaenge", "zwaeng" }), "zwaengen");  
  //AddExit( "sueden", "../workroom.lpc" );
 
}

zwaengen(str)
{
  notify_fail("Wo willst du dich durchzwaengen?\n");
  if ((str == "durch spalt") || (str == "spalt"))
  {
    this_player()->move("/d/gebirge/tantor/betrachter/room/eingang1",M_GO,"durch Spalt");   
    return 1;
  }
  return 0;
}


klettern(str)
{
  notify_fail("Wohin willst du klettern?\n");
  if (str == "runter")
  {
    write("Du versuchst nach unten zu klettern und mit einiger Muehe gelingt es Dir auch.\n");
    
    call_out(("fallseq0"),0);
    
    return 1;
  }
  return 0;
}

void fallseq0()
{  
  this_player()->move("/d/gebirge/tantor/betrachter/room/dummy.lpc", M_TPORT|M_SILENT|M_NO_SHOW);
  write("Du beginnst nach unten zu klettern.\n");
  call_out(("fallseq1"),5);
}

void fallseq1()
{
  write("Es wird immer schwieriger sich an den Felswaenden festzuhalten.\n");
  call_out(("fallseq2"),5);
}

void fallseq2()
{
  write("Du kannst Dich kaum noch halten!!\n");
  call_out(("fallseq3"),5);
}

void fallseq3()
{
  write("Du verlierst entgueltig den Halt!!!\n"+"Du stuertzt.......\n");
  call_out(("fallseq4"),10);
}

void fallseq4()
{
  write("Du hast Glueck, du landest in einem Moosbecken kurz oberhalb des Hoehleneingangs.\n");
  this_player()->move("/d/gebirge/tantor/betrachter/room/broom.lpc",M_GO,"kletterst nach unten.\n");
}