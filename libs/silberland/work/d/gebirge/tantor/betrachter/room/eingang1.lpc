
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein Sackgasse in einer Hoehle." );
  SetProp( P_INT_LONG,
    "Du stehst in einer Hoehle aus Stein. Im Osten und Norden befindet sich eine "
  + "kalte Steinmauer, die aber ueberraschenderweise weder feucht noch unheimlich "
  + "sind. Du fuehlst Dich (trotz der Dunkelheit) geborgen und sicher.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  
  AddDetail( ({ "steinmauer", "mauer", "wand" }),
    "Du endeckst einen Spalt.\n");

  AddDetail( ({ "spalt" }),
    "Du kannst dich durch den Spalt zwaengen.\n");

  AddCmd( ({ "zwaenge", "zwaeng" }), "zwaengen");  

  AddExit( "sueden", "/players/tantor/workroom" );
 
}

zwaengen(str)
{
  notify_fail("Wo willst du dich durchzwaengen?\n");
  if ((str == "durch spalt") || (str == "spalt"))
  {
    this_player()->move("/d/gebirge/tantor/betrachter/room/eingang",M_GO,"durch Spalt");   
    return 1;
  }
  return 0;
}