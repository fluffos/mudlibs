

#include "../def.h"

inherit "std/room";



#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Die Hoehle von Phyngar" );
  SetProp( P_INT_LONG,
    "Du stehst im Eingang einer gigantischen Hoehle.\n"
  + "Den Anblick den diese Hoehle bietet ist erschreckend. Ueberall siehst du Knochen von "
  + "Lebewesen *zitter*. " );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "eingang"}),
    "Nach Sueden kannst du den Raum wieder verlassen.\n");
  
  AddDetail( ({ "angst"}),
    "Ja du hast riesige Angst.\n");
  
  AddDetail( ({ "hoehle", "anblick" }),
    "Dir wird uebel wenn du die Ueberreste betrachtest.\n");

    AddSpecialDetail ( ({ "boden", "wand", "waende", "decke", "blut", "etwas" }), "blut");
  
  AddDetail ( ({ "fels" }),
    "Der Fels ist mit Blut beschmiert.\n");

  AddDetail ( ({ "welt", "raum", "silberland" }),
    "Ja du bist im Silberland.\n");
  
  AddDetail ( ({ "loch" }), "Du kannst versuchen nach oben zu klettern");
  
  AddSpecialDetail ( ({ "knochen", "lebewesen", "ueberreste" }), "knochen");
    
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst Etwas von der Decke tropfen.\n");


  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blut\n");


  //AddRoomMessage( 
  //  ({"Du fuerchtest Dich.\n", "Du willst hier wieder raus.\n",
  //    "Du hast schreckliche Angst.\n"}),30,"func");
  
  AddCmd ( ({"klettern", "klettere"}), "klettern");
  
  AddItem("/d/gebirge/tantor/betrachter/npc/betrachter", REFRESH_DESTRUCT);
  //wird entfernt wenn angehaengt!
  //AddExit( "sueden", "/players/tantor/workroom.lpc" ); 

}

klettern(str)
{
	write("Du schaffst es wircklich nach oben zu klettern.\n");
	this_player()->move("/d/gebirge/tantor/betrachter/room/eingang.lpc", M_TPORT|M_SILENT|M_NO_SHOW);
	return 1;
}


string blut()
{ return "Aaaaaaaaaah!!!\n" + "Es ist " + TP->QueryProp(P_RACE) + "enblut!!\n"; }

string knochen()
{ return "Eindeutig " + TP->QueryProp(P_RACE) + "knochen.\n"; }