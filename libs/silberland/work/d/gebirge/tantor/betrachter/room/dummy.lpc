/*
**          Dummyroom fuer die Hoehlen der Stürme
**
**   
*/ 

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

inherit "std/room";

void create()
{
  ::create();
  SetProp (P_LIGHT, -10);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  AddCmd( "","reaktion" ,1);  
}

reaktion()
{
if(query_wiz_level(this_player()) >10)
{
   write("Okay, da Du Magier bist, stehen Dir hier alle Befehle zur Verfuegung.\n");
   return 0;
}
else
{
   write("Du bist am fallen!! Sei mal ganz ehrlich was kannst du jetzt tun?\n");
   return 1;
}
}

