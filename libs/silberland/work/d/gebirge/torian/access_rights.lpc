int access_rights(string name, string file, int readflag, int def)
{
  string *s;
  int n;

  // Lesezugriff regeln.
  if (readflag)
  {
  	s=explode(file,"/");
  	
  	if (name=="delgo" || name=="lilyth")
    	return 1;
    else
       	return 0;
      
    return def;
  }

    name=lower_case(name);
    s=explode(file,"/");

    return 0;
}
