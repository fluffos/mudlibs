#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine riesiger Hirschkaefer");
  SetProp(P_LONG,
    "Der Hirschkaefer hat einen schwarzen Chitinpanzer der ihn vor den "
    "groessten Gefahren schuetzt. Das auffaelligste jedoch ist sein grosses "
    "Geweih, von dem er auch seinen Namen hat. Dieser Hirschkaefer hat noch "
    "eine weitere Aehnlichkeit mit Hirschen, seine immense Groesse."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hirschkaefer");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kaefer", "hirschkaefer"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen Mandibeln"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON, DT_PIERCE})
                    })
  );

  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 200+random(30));
  SetProp(P_WEIGHT, 40000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein riesiger Hirschkaefer");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Details----------------------------------------------------------------
  AddDetail( ({ "chitinpanzer", "panzer" }),
    "Der Chitinpanzer ist sehr hart und schuetzt den Kaefer vor seinen "
    "Gegnern.");

  AddDetail( ({ "gegner", "gefahren", "gefahr" }),
    "Du wuesstest zu gerne welche Gegner solch ein riesiger Kaefer hat.");

  AddDetail( ({ "geweih", "mandibeln", "mandibel", "oberkiefer" }),
    "Dabei handelt es sich um massiv vergroesserte Mandibeln, die Oberkiefer "
    "des Kaefers.");

  AddDetail( ({ "namen" }),
    "Seinem Geweih verdankt er den Namen Hirschkaefer.");

  AddDetail( ({ "groesse", "meter", "hirsche" }),
    "Mit mehr als zwei Metern ist der Hirschkaefer groesser als die meisten "
    "Hirsche.");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,40);
  AddSpell(5,500,
    Name()+" beisst Dich mit seinen riesigen Mandibeln!\n",
    Name()+" beisst @WEN mit seinen riesigen Mandibeln!\n",
     ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" krabbelt umher.\n"
   ,Name(WER, 1)+" hebt drohend sein Geweih.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den NPC.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  switch (gruppe) 
  {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "greift Dich an.",
        "greift "+TP->Name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "tastet Dich mit seinen Mandibeln ab.",
        "tastet "+TP->Name(WEN)+" mit seinen Mandibeln ab.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
