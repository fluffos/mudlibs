#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein riesiger Wasserreiher");
  SetProp(P_LONG,
    "Ein praechtiges Exemplar von einem Reiher steht vor Dir. Sein graues "
    "Gefieder glaenzt in der Sonne. Sein Schnabel hat die Form eines Dolches. "
    "Die Kralle der Mittelzehe traegt eine Saege, die zum Putzen des Gefieders "
    "verwendet wird."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wasserreiher");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"wasserreiher", "reiher"}));
  AddClass( ({CL_ANIMAL, CL_FLYING }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(23);

  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON, DT_PIERCE})
                    })
  );

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 1000);
  SetProp(P_WEIGHT, 400000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 3);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Wasserreiher");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Details----------------------------------------------------------------

  AddDetail( ({ "exemplar" }),
    "Ein wahrlich praechtiges Exemplar.");

  AddDetail( ({ "gefieder", "sonne" }),
    "Das graue Gefieder glaenzt in der Sonne.");

  AddDetail( ({ "schnabel", "dolch", "schwert", "form", "zweihaenderschwert", "zweihaender" }),
    "Der Schnabel eines Reihers ist Dolchfoermig. Bei der Groesse dieses Exemplars, "
    "ist es aber eher ein ausgewachsenes Zweihaenderschwert.");

  AddDetail( ({ "groesse" }),
    "Der Wasserreiher ueberragt Dich bei weitem.");

  AddDetail( ({ "kralle", "mittelzehe", "putzen" }),
    "Die Kralle der Mittelzehe dient dem Putzen des Gefieders. Im Falle eines Angriffs "
    "kann der Reiher sich mit der Saege aber sich auch sehr gut verteidigen.");

  AddDetail( ({ "saege" }),
    "Von dieser Kralle willst Du lieber nicht getroffen werden.");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,40);

  AddSpell(5,500,
    Name()+" hackt mit seinem Schnabel auf Dich ein!\n",
    Name()+" hackt mit seinem Schnabel auf @WEN ein!\n",
     ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));

  AddSpell(3,700,
    Name()+" schlitzt Dich mit seinen Krallen auf!\n",
    Name()+" schlitzt @WEN mit seinen Krallen auf!\n",
     ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1,
    Name()+" schlaegt mit seinen Fluegeln und schleudert Dich fort!\n",
    Name()+" schlaegt mit seinen Fluegeln!\n",
    DT_BLUDGEON, "wegschleudern");

//Sturm mit Fluegeln erzeugen -> Spieler in nachbarraum geweht

//--Chats------------------------------------------------------------------

  SetChats(10,
  ({Name(WER, 1)+" faengt einen grossen Fisch.\n"
   ,Name(WER, 1)+" breitet seine Fluegel aus.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" hakt nach Dir!\n"
   ,Name(WER, 1)+" schreit furchteinfloessend!\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den NPC.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  switch (gruppe) 
  {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "greift Dich an.",
        "greift "+TP->Name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "bemerkt Dich gar nicht.",
        "bemerkt "+TP->Name(WEN)+" gar nicht.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

void wegschleudern(object enemy, int damage, mixed dam_type)
{
  object *rooms;

  if(!enemy || enemy->QueryProps(P_GHOST)) return;

  rooms = m_values(ENV(TO)->QueryProp(P_EXITS));

  if(!sizeof(rooms)) return;

  enemy->move(rooms[random(sizeof(rooms))], M_GO|M_NO_SHOW,
    "vom Wasserreiher fortgeschleudert", "wird",
    "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}
