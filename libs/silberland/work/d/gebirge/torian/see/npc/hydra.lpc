inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

int koepfe, old;

string *strKoepfe;

create()
{ 
  if (!is_clone(this_object())) return;
  ::create();

  old = koepfe = 8;

  strKoepfe =({"kopflose","einkoepfige","zweikoefige","dreikoepfige",
               "vierkoepfige", "fuenfkoepfige", "sechskoepfige",
               "siebenkoepfige", "achtkoepfige"});

  create_default_dragon(0,2,0,10+random(5));

  SetProp(P_SHORT, "Eine achtkoepfige Wasserhydra");
  SetProp(P_NAME, "Wasserhydra");
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_WATER: -1.0]));
  AddId("hydra", "wasserhydra");
  SetProp(P_LONG, "Siehe unten.");
  Set(P_SPELLRATE, 0);
  SetProp(P_MAX_HANDS, koepfe);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_HANDS, ({" mit ihre Koepfen", 200, 
                       ({DT_PIERCE, DT_RIP, DT_SQUEEZE, DT_BLUDGEON}) }) );
  SetProp(P_AGGRESSIVE, 0);


}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Wasserhydra.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Wasserhydra hat "+CAP(getuid(player))+" umgebracht.\n");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{

  koepfe=QueryProp(P_HP)/100;
  
  if(koepfe > 8) koepfe = 8;
  
  ModifySkillAttribute(TO,SA_SPEED,100*koepfe,5);
//  ENV(TO)->Message("Koepfe: "+koepfe+" Speed:"+100*koepfe+"\n"); 

  if(old-koepfe > 1)
  {
    ENV(TO)->Message("\nMehrere Koepfe der Hydra fallen zerschmettert zu Boden.\n\n",
             MSGFLAG_VISUAL);
  }
  else if( koepfe < old )
  {
    ENV(TO)->Message("\nEin Kopf der Hydra faellt zerschmettert zu Boden.\n\n", 
             MSGFLAG_VISUAL);
  }

  old = koepfe;
  SetProp(P_MAX_HANDS, koepfe);

  ::Defend(dam, dam_type, spell, enemy);
}

string _query_short()
{
  return "Eine "+strKoepfe[koepfe]+" Wasserhydra";
}

string _query_long()
{
  return BS("Eine "+strKoepfe[koepfe]+" Wasserhydra raekelt sich vor Dir "
           +"im Wasser. Ihre Haut ist ueber und ueber mit gruen funkelnden "
           +"Schuppen bedeckt. Du hast so eine Ahnung das ausgerechnet die "
           +"Wasserhydra die Quelle fuer die sagenhaften Eigenschaften des "
           +"Wassers ist.");
}

// Kein Drachenatem und keine Spells
void breath_spell() { return; }
int _set_spellrate() { return 0; }