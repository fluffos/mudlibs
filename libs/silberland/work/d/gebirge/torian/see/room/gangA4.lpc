inherit "std/room";

#include "../def.h"

#define ANSCHLUSS "/players/torian/workroom"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "In einem Gang" );
  SetProp( P_INT_LONG,
    "");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", ANSCHLUSS );
  AddExit( "norden", "./seeA3" );

}