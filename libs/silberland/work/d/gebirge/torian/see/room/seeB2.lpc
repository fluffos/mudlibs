inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "An einem See" );
  SetProp( P_INT_LONG,
    "Im Nordwesten schimmert der See ein wenig durch die Blaetter der "
    "Baeume hindurch. Im Osten wird der Wald von einer hohen Felswand umgeben, "
    "die sich bis nach Sueden hin weiterzieht. Weiter in Richtung Norden glaubst "
    "Du einen Hoehleneingang zu erkennen. Direkt vor Dir befindet sich "
    "ein riesiger Pilz.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten schimmert der See durch die riesigen Blaetter der "
    "noch riessigeren Baeume.");
  AddDetail( ({ "see" }),
    "Traumhaft still und ruhig liegt der See im Nordwesten Dir.");
  AddDetail( ({ "blaetter", "aeste" }),
    "Einfach riesig.");
  AddDetail( ({ "baeume" }),
    "Es scheint sich eher um riesige Farne als um echte Baeume zu handeln.");
  AddDetail( ({ "farne", "farn" }), 
    "Wie konnten die Farne nur so riesig werden???");
  AddDetail( ({ "pilz" }),
    "Der Pilz ist groesser als ein Troll. Erstaunt schaust Du zur Pilzkappe "
    "einige Meter ueber Dir hinauf.");
  AddDetail( ({ "troll" }),
       ([ 0: "Der Pilz ist groesser als ein Troll und somit erst recht "
             "groesser als Du!", // Der Defaulttext
         "troll":  // Die Rasse wird klein geschrieben!
             "Der Pilz ist sogar groesser als Du!" ]) );
  AddDetail( ({ "pilzkappe" }),
    "Von unten betrachtet scheint es sich um einen Steinpilz zu handeln. "
    "Der auffallend dicke, weisse, dichtfaserige Stiel und die graugruenlichen "
    "Roehren der unteren Hutseite deuten schwer daraufhin. Wirkliche Gewissheit "
    "koenntest Du nur mit einem Blick von oben erlangen.");
  AddDetail( ({ "meter" }),
    "Der Pilz und alles andere hier sind einfach riesig.");
  AddDetail( ({ "richtung" }),
    "Norden.");
  AddDetail( ({ "norden" }),
    "Im Norden koennte sich ein Hoehleneingang befinden.");
  AddDetail( ({ "hoehleneingang", "eingang" }),
    "Wo der wohl hinfuehrt?");
  AddDetail( ({ "stiel" }),
    "Der Stiel ist sehr kraeftig. Von so nahem betrachtet ist die feine "
    "Netzzeichnung perfekt zu sehen.");
  AddDetail( ({ "netzzeichnung", "zeichnung", "faser", "fasern" }),
    "Die dichten Fasern des Stieles bilden eine feine Netzzeichnung.");
  AddDetail( ({ "roehren", "faerbung" }),
    "Die Roehren der unteren Hutseite sind graugruenlich. Die Roehren des "
    "Gallenroehrlings weisen eine eher roetliche Faerbung auf.");
  AddDetail( ({ "hutseite" }),
    "Die obere Hutseite kannst Du leider nur erahnen.");
  AddDetail( ({ "blick", "gewissheit" }),
    "Der Pilz ist zu gross, als das Du einen Blick von oben auf ihn werfen "
    "koenntest.");
  AddDetail( ({ "steinpilz" }),
    "Man koennte ihn leicht mit einem Gallenroehrling verwechseln.");
  AddDetail( ({ "gallenroehrling" }),
    "Der Gallenroehrling ist ein ungeniessbarer, leicht giftiger Pilz aus "
    "der Familie der Roehrlinge, der aufgrund seines extrem bitteren "
    "Geschmacks schon in geringen Mengen ein komplettes Pilzgericht "
    "verderben kann.");
  AddDetail( ({ "familie", "roehrlinge" }),
    "Zu dieser Familie gehoert auch der Steinpilz.");
  AddDetail( ({ "geschmack", "mengen", "pilzgericht", "gericht" }),
    "Schon geringe Mengen koennen ein komplettes Pilzgericht verderben.");
  AddDetail( ({ "boden", "waldboden" }),
    "Waeren die Aeste und Blaetter die auf ihm liegen nicht viel groesser "
    "als normal, waere es ein fast normaler Waldboden.");
  AddDetail( ({ "himmel", "firmament" }),
    "Die Sonne beherrscht einen absolut wolkenlosen Himmel. Schoeneres "
    "Wetter kann man sich kaum wuenschen.");
  AddDetail( ({ "wetter" }),
    "Perfektes Wetter.");
  AddDetail( ({ "wolken", "wolke" }),
    "Nicht die kleinste Wolke truebt das Blau des Himmels.");
  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt ueber das ganze Firmament.");
  AddDetail( ({ "blau" }),
    "Wunderschoen.");
  AddDetail( ({ "felsen", "felswand", "wand" }),
    "Steile, graue Felsen umgeben den See und den Wald. Maejestaetisch "
    "erheben sich die Berge vor Dir.");
  AddDetail( ({ "berge", "berg" }),
    "Majestaetisch erheben sich die Berge vor Dir und schliessen den See ein. "
    "Weisse Bergkuppen und Spitzen deuten auf die enorme Hoehe hin.");
  AddDetail( ({ "bergkuppe", "bergkuppen", "kuppe", "kuppen",
                "bergspitze", "spitze", "bergspitzen", "spitzen"}),
    "Die Berge reichen bis ueber die Schneegrenze hinaus. Nichteinmal der "
    "geschickteste Zwerg koennte sie ohne weiteres bezwingen.");
  AddDetail( ({ "schneegrenze", "grenze", "schneefallgrenze", "schnee" }),
    "Die Schneefallgrenze liegt sehr hoch.");
  AddDetail( ({ "hoehe" }),
    "Die Berge sind so hoch das auf ihren Spitzen Schnee liegt.");
  AddDetail( ({ "zwerg", "bergsteiger" }),
    "Zwerge gelten als die geschicktesten Bergsteiger im Silberland. Auch wenn "
    "sie sich haeufiger im Berg als auf ihm bewegen.");
  AddDetail( ({ "wald", "farnwald" }),
    "Solch einen Wald hast Du noch nie gesehen. Er scheint ausschliesslich "
    "aus riesigen Farnen zu bestehen. Man koennte fast sagen es handelt sich "
    "um einen Farnwald.");
  AddDetail( ({ "silberland" }),
    "Dort befindest Du Dich gerade.");
  AddDetail( ({ "gebirge" }),
    "Das Gebirge umgibt Dich.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rascheln der Blaetter wenn der Wind durch sie hindurchfaehrt. In "
    "der Ferne kannst Du das Schreien eines grossen Vogels vernehmen.");

  AddSound( ({ "rascheln", "blaetter", "wald", "wind" }),
    "Ab und zu faehrt der Wind durch die Blaetter des Waldes.");
  AddSound( ({ "ferne", "schreien" }),
    "In der Ferne hoerst Du einen Vogel schreien. Was das wohl fuer ein Wesen ist?");
  AddSound( ({ "vogel", "wesen" }),
    "Es koennte fast ein Adler sein.");
  AddSound( ({ "adler", "koenig", "koenige", "luefte" }),
    "Angeblich soll es riesige Adler im Gebirge geben. Die wahren Koenige der Luefte.");

  AddSmell( DEFAULT_SMELL,
    "Der Geruch des Waldes ist einfach herrlich erfrischend.");

  AddSmell( ({ "geruch", "wald" }),
    "Es riecht nach frischen Farnen.");
  AddSmell( ({ "farnen", "farne" }),
    "Der Wald riecht nicht nur wie Farne, er sieht auch wie zu gross geratene Farne aus!");

//--Ausgaenge--------------------------------------------------------------
 
  AddExit( "norden", "./seeB1" );
  AddExit( "westen", "./seeA2" );

//--Npcs-------------------------------------------------------------------

  AddItem( NPC "hirschkaefer", REFRESH_DESTRUCT);

}