
inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "An einem See" );
  SetProp( P_INT_LONG,
    "Fehler");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "westen" }),
    "Ein grosser See breitet sich im Westen vor Dir aus.");

  AddDetail( ({ "oberflaeche", "wasseroberflaeche" }),
    "Die Wasseroberflaeche des Sees glitzert und funkelt an den "
    "Stellen, an denen die Sonne auf das kristallklare Wasser trifft.");

  AddDetail( ({ "stellen", "stelle" }),
    "An einigen Stellen treffen die hellen Strahlen der Sonne auf das "
    "Wasser und lassen es ab und zu aufblitzen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne leuchtet vom wolkenlosen Himmel froehlich auf Dich herab.");

  AddDetail( ({ "strahlen", "sonnenstrahlen" }),
    "Die Sonne schickt ihre hellen Strahlen vom Himmel herab. Sie lassen "
    "das Wasser des Sees herrlich glitzern und funkeln.");

  AddDetail( ({ "wolken", "wolke" }),
    "Es ist keine einzige Wolke zu sehen.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr sauber und kristallklar. Du kannst muehelos bis "
    "auf den Grund des Sees blicken.");

  AddDetail( ({ "grund" }),
    "Du beugst Dich neugierig ueber das Wasser und betrachtest den hellen, "
    "feinkoernigen Sand, der auf dem Grunde des Sees liegt. Ploetzlich "
    "schwimmt ein kleiner, bunter Fisch an Dir vorbei und verschwindet "
    "blitzschnell zwischen ein paar gruenen Wasserpflanzen.");

  AddDetail( ({ "sand" }),
    "Feine, helle Sandkoernchen bildet den Grund des Sees.");

  AddDetail( ({ "sandkoernchen", "koernchen" }),
    "Sie sind winzig klein und sehr fein.");

  AddDetail( ({ "fisch" }),
    "Der ist schon lange wieder auf und davon.");

  AddDetail( ({ "wasserpflanzen", "wasserpflanze" }),
    "Vereinzelt wachsen einige seltsam anmutende Wasserpflanzen auf dem "
    "Grunde des Sees.");

  AddDetail( ({ "see" }),
    "Ein grosser, wunderschoener See liegt ein wenig westlich direkt vor "
    "Dir. Etwa in der Mitte des Sees durchbricht ein grosser Felsen die "
    "glatte Wasseroberflaeche.");

  AddDetail( ({ "mitte" }),
    "Der Felsen liegt fast genau in der Mitte des Sees. Naja, vielleicht "
    "auch ein wenig weiter rechts. Aber nicht sehr viel.");

  AddSpecialDetail( ({ "felsen" }), "strReiher");

  AddDetail( ({ "reiher", "wasserreiher" }),
    "Ein riesiger Wasserreiher dreht ueber dem See seine Kreise.");

  AddDetail( ({ "kreise" }),
    "Der Wasserreiher scheint auf der Suche nach Nahrung zu sein.");

  AddDetail( ({ "suche", "nahrung" }),
    "Du fragst Dich ob Du in das veraenderte Beuteschema passt.");

  AddDetail( ({ "beuteschema", "schema", "beute" }),
    "Pass auf das Du nicht selber zur Beute wirst.");

  AddDetail( ({ "fische", "fische" }),
    "Es gibt sicherlich auch Fische in diesem See.");

  AddDetail( ({ "osten" }),
    "Hohe, steile Felswaende tuermen sich im Osten vor Dir auf. Dort wohl "
    "kein Weg mehr weiter.");

  AddDetail( ({ "weg" }),
    "An diesen Felswaenden kommst Du nicht vorbei.");

  AddDetail( ({ "felswaende" }),
    "Sie scheinen unbezwingbar zu sein. Auch fuer Dich.");

  AddDetail( ({ "norden" }),
    "Noerdlich von Dir ragen riesige Felswaende in den Himmel hinauf. "
    "Mitten in den Felsen kannst Du ein grosses, dunkles Loch sehen, "
    "aus dem ein kleiner Fluss entspringt. Anscheinend hat sich aus diesem "
    "Fluss auch der See gebildet.");

  AddDetail( ({ "loch" }),
    "Eigentlich ist es fast schon eine Hoehle.");

  AddDetail( ({ "hoehle", "ursprung" }),
    "In der Hoehle scheint der Ursprung fuer den See zu sein. Der kleine Fluss "
    "hindert Dich nicht daran sie zu betreten.");

  AddDetail( ({ "fluss" }),
    "Ein kleiner Fluss entspringt aus der Hoehle, die sich in den "
    "Felswaenden im Norden befindet. Sein frisches Wasser faellt mit einem "
    "leisen Plaetschern in den See hinab.");

  AddDetail( ({ "plaetschern" }),
    "Versuchs mal mit lauschen.");

  AddDetail( ({ "wasserfall", "hoehenunterschied" }),
    "Der Hoehenunterschied betraegt nicht einmal einen Meter. Da kann man nur "
    "schwerlich von einem Wasserfall reden.");

  AddDetail( ({ "meter", "hobbit" }),
    "Besser gesagt einen Hobbit gross.");

  AddDetail( ({ "quelle" }),
    "Die Quelle des Flusses und damit auch des Sees scheint sich in der "
    "Hoehle zu befinden.");

  AddDetail( ({ "boden" }),
    "Ueberall auf dem Boden und am Ufer des Sees wachsen riesige Farne, die "
    "groesser sind als Du selbst. Man koennte schon fast von einem Wald "
    "sprechen.");

  AddDetail( ({ "ufer" }),
    "Das Ufer des Sees befindet sich direkt vor Dir.");

  AddDetail( ({ "farne", "farn" }), 
    "Wie konnten die Farne nur so riesig werden???");

  AddDetail( ({ "wald", "seite", "seiten", "farnwald" }),
    "Ein Wald aus riesigen Farnen umgibt Dich von allen Seiten.");

  AddDetail( ({ "himmel", "wetter" }),
    "Die Sonne beherrscht einen absolut wolkenlosen Himmel. Schoeneres "
    "Wetter kann man sich kaum wuenschen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rascheln der Blaetter wenn der Wind durch sie hindurchfaehrt. "
    "Der triumphierende Ruf des Wasserreihers, wenn er Beute gefangen hat, "
    "uebertoent den Wind hin und wieder.");

  AddSound( ({ "rascheln", "blaetter", "wald", "wind" }),
    "Ab und zu faehrt der Wind durch die Blaetter des Waldes.");

  AddSound( ({ "ruf", "wasserreiher", "reiher" }),
    "Hin und wieder erschallt der laute triumphierende Ruf des Wasserreihers.");

  AddSound( ({ "beute"}),
    "Von der Beute ist nichts mehr zu hoeren. Liegt vermutlich daran das "
    "sie tot ist.");

  AddSound( ({ "plaetschern"}),
    "Mit leisem plaetschern faellt das Wasser aus der Hoehle in den See. Man "
    "koennte fast von einem Wasserfall reden, wenn der Hoehenunterschied nicht "
    "so gering waere.");

  AddSmell( DEFAULT_SMELL,
    "Der Geruch des Waldes ist einfach herrlich erfrischend.");

  AddSmell( ({ "geruch", "wald" }),
    "Es riecht nach frischen Farnen.");
  AddSmell( ({ "farnen", "farne" }),
    "Der Wald riecht nicht nur wie Farne, er sieht auch wie zu gross geratene Farne aus!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", "./seeB2" );
  AddExit( "suedwesten", "./seeA2" );

  AddItem( NPC "wasserreiher", REFRESH_DESTRUCT);

  AddCmd(({"betrete", "betret" }), "cmd_betreten");
}

string _query_int_long()
{
  string s;
    s = "Im Westen schimmert die Oberflaeche des Sees. Norden und Osten werden "
       +"von steilen Felswaenden dominiert. Aus einer Hoehle im Norden fliesst "
       +"ein kleiner Fluss in den See. Scheinbar befindet sich dort auch die "
       +"Quelle.";

  if(present("wasserreiher"))
    s +=" Auf einem Felsen im See hockt ein riesiger Wasserreiher.";

  return BS(s);
}

string strReiher(string key)
{
  string s;
  s = "Ein grosser Felsen befindet sich mitten im See. ";

  if(present("wasserreiher"))
    s += "Auf ihm hockt ein riesiger Wasserreiher, der dort Fische zu fangen scheint.";
  else
    s += "Hoch ueber ihm fliegt ein riesiger Wasserreiher.";
  
  return BS(s);
}

int cmd_betreten(string str)
{
  notify_fail ("Was willst Du betreten?\n");
  if (!stringp(str) || str=="") return 0;

  if( !(str=="hoehle" || str == "loch"))  return 0;
  
  write ("Du betrittst die Hoehle.\n");
  Message(BS(TP->name(WER)+" betritt die Hoehle."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->move( ROOM "hoehle", M_GO );

  return 1;
}