
inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "In einem Waldstueck" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einem Waldstueck wieder. Zwischen den "
    "Baeumen kannst Du das Schimmern eines Sees im Norden ausmachen. "
    "Die Felswand im Sueden ist komplett mit Straeuchern und Bueschen "
    "zugewachsen. Den Hoehleneingang kann man kaum erkennen.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "waldstueck" }),
    "Ueberall um Dich herum stehen fremd anmutende Baeume. Irgendetwas "
    "stimmt hier nicht.");
  AddDetail( ({ "wald", "waelder" }),
    "Du siehst den Wald vor lauter Baeumen nicht? :)");
  AddDetail( ({ "baeume", "baeumen" }),
    "Solche Baeume hast Du noch nie gesehen. Ihre Staemme haben keine "
    "gewoehnliche Rinde und auch die Krone hat keine Aehnlichkeit mit "
    "anderen Dir bekannten Baeumen.");
  AddDetail( ({ "staemme" }),
    "Die Staemme haben keine gewoehnliche Rinde. Du hast schon viele "
    "Baeume in Deiner Abenteurerkarriere gesehen, aber noch nie solche "
    "mit so glatter und durchgehend gruener Rinde wie diese hier.");
  AddSpecialDetail( ({ "abenteurerkarriere", "karriere" }), "strkarriere");
  AddDetail( ({ "rinde" }),
    "Die Rinde ist sehr glatt und durchgehend gruen. Die Staemme haben mehr "
    "gemein mit normalen Pflanzenstaengeln als mit Baeumen.");
  AddDetail( ({ "pflanzenstaengel", "staengel" }),
    "Die Staemme der Baeume haben mehr gemein mit Pflanzenstaengeln als mit "
    "normalen Staemmen.");
  AddDetail( ({ "krone" }),
    "Die Kronen der Baeume bestehen nur aus einigen dicken Aesten und "
    "wenigen sehr breiten Blaettern daran. Dennoch lassen sie nur wenig "
    "Sonnenlicht durch.");
  AddDetail( ({ "aesten", "astwerk", "aeste" }),
    "Die Baeume haben nur wenige sehr dicke Aeste. Breite Blaetter gehen "
    "von ihnen aus und verdecken den Himmel teilweise.");
  AddDetail( ({ "blaetter", "blatt" }),
    "Das sind die ungewoehnlichsten Blaetter, die Du jemals gesehen hast. "
    "Du koenntest Dich locker mit einem einzigen Blatt zudecken.");
  AddDetail( ({ "sonnenlicht", "licht", "sonnenstrahlen", "strahlen" }),
    "Ein paar Sonnenstrahlen durchdringen das Blaetterdach. Die Lichtkegel "
    "bilden interessante Muster auf dem Boden.");
  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach verdeckt den Himmel fast vollstaendig. Nur an einigen "
    "Stellen kann das Sonnenlicht bis zum Boden vordringen.");
  AddDetail( ({ "stellen" }),
    "Das Blaetterdach laesst nur wenige Stellen zu.");
  AddDetail( ({ "boden" }),
    "Die Lichtkegel bilden ein interessantes Muster auf dem Boden. Das "
    "in anderen Waeldern uebliche Laub fehlt voellig.");
  AddDetail( ({ "laub" }),
    "Du kannst kein Laub erkennen.");
  AddDetail( ({ "lichtkegel" }),
    "Einige Sonnenstrahlen dringen bis zum Boden vor und verleihen dem "
    "Wald ein traumhaftes Aussehen.");
  AddDetail( ({ "aussehen" }),
    "Einfach traumhaft.");
  AddDetail( ({ "muster" }),
    "Fasziniert betrachtest Du die Muster der Lichtkegel auf dem Boden. "
    "Waeren die Baeume nicht so befremdlich, koennte man die ganze "
    "Szenerie traumhaft nennen.");
  AddDetail( ({ "szenerie", "traeumen" }),
    "Die Muster der Lichtkegel laden zum Traeumen ein. Dennoch bist Du "
    "verunsichert ob dieser Baeume.");
  AddDetail( ({ "aehnlichkeit" }),
    "Die Kronen haben kaum Aehnlichkeit mit Dir bekannten Baeumen. Weder "
    "ueppiges Astwerk noch die fuer Baeume typischen vielen Blaetter "
    "sind vorhanden.");
  AddDetail( ({ "schimmer" }),
    "Durch die Baeume hindurch kannst Du das silberne Schimmern eines "
    "Sees ausmachen. Du scheinst Deinem Ziel endlich naeher zu kommen.");
  AddDetail( ({ "ziel", "aufgabe" }),
    "Warum bist Du hier, wenn Du nicht einmal weisst, was Dein Ziel ist?");
  AddDetail( ({ "see", "norden" }),
    "Im Norden des Waldes scheint sich ein See zu befinden. Um genaueres "
    "erkennen zu koennen, muesstest Du naeher herangehen.");
  AddDetail( ({ "felswand", "sueden" }),
    "Die Felswand im Sueden ist komplett mit Straeuchern und Bueschen "
    "zugewachsen. Du kannst den Hoehleneingang, der zurueck zum Kloster "
    "fuehrt, lediglich erahnen. ");
  AddDetail( ({ "kloster" }),
    "Von dort bist Du gekommen, oder etwa nicht?");
  AddDetail( ({ "straeucher", "straeuchern", "buesche", "bueschen" }),
    "Du kannst nicht erkennen, was das fuer Pflanzen sind. Solch grosse "
    "grasartige Gebilde sind Dir noch nie untergekommen.");
  AddDetail( ({ "pflanzen", "grasbueschel" }),
    "Die Pflanzen sehen mehr wie grosse Grasbueschel aus.");
  AddDetail( ({ "gebilde" }),
    "Du hast wahrlich schon viel gesehen, aber solche Pflanzen sind Dir "
    "noch nicht untergekommen.");
  AddDetail( ({ "himmel" }),
    "Vom Himmel ist nur wenig zu sehen. Das wenige jedoch, das man durch "
    "das Blaetterdach erkennen kann, zeugt von einem strahlendblauen "
    "Himmel. Perfektes Wetter fuer einen Spaziergang im Wald.");
  AddDetail( ({ "wetter", "sonnenschein" }),
    "Strahlendblauer Himmel, Sonnenschein - Was will man mehr?");
  AddDetail( ({ "spaziergang" }),
    "Du wuerdest ja gerne einfach so spazieren gehen, aber wartet da "
    "nicht noch eine Aufgabe auf Dich?");
  AddDetail( ({ "hoehleneingang", "eingang" }),
    "Der Hoehleneingang im Sueden ist nahezu komplett von Bueschen und "
    "Straeuchern verdeckt. Wenn Du nicht genau wuesstest, wo er ist, haettest "
    "Du ihn vielleicht uebersehen.");

  AddSound( DEFAULT_SOUND,
    "Es ist erstaunlich ruhig hier. Kein Vogelgezwitscher oder aehnliches.");

  AddSound( ({ "vogelgezwitscher", "gezwitscher" }),
    "Halt! War da nicht ein leises Zwitschern aus dem Norden?");
  AddSound( ({ "zwitschern", "norden" }),
    "Du bist Dir nicht sicher. Vielleicht waere es besser, hinzugehen und "
    "nachzusehen.");

  AddSmell( DEFAULT_SMELL,
    "Der feuchte Boden verstroehmt einen angenehmen Duft.");

  AddSmell( ({ "duft", "boden", "geruch" }),
    "Du kannst den Geruch des Bodens nicht genau einordnen.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "./seeA2" );
  AddExit( "sueden", "./gangA4" );
  SetProp(P_HIDE_EXITS, ({"sueden"}));
}

string strkarriere(string key)
{
  switch (TP->QueryProp(P_LEVEL))
  {
    case 1..10:
      return BS("Du bist ja noch gruen hinter den Ohren.");
    case 11..20:
      return BS("Ein wenig hast Du schon gesehen von der Welt.");
    case 21..30:
      return BS("Du hast schon ein paar Abenteuer erlebt.");
    case 31..40:
      return BS("Du bist schon ein erfahrener Abenteurer.");
    case 41..50:
      return BS("Du bist ein sehr erfahrener Abenteurer.");
    default:
      return BS("Du bist ein richtiger Profi!");
  }
}

// traeumen