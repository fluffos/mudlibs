inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer grossen Tropfsteinhoehle. Pausenlos "
    "tropft Wasser von der Decke. Im hinteren Teil der Hoehle befindet "
    "sich die Quelle des Flusses und somit auch des Sees draussen. "
    "Erstaunlicherweise sind die Stalagmiten und Stalaktiten sehr viel "
    "kleiner um die Quelle herum.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  AddId(QUELLE);
//--Details----------------------------------------------------------------

  AddDetail( ({ "quelle" }),
    "Im hinteren Teil der Hoehle befindet sich die Quelle des Flusses.");
  AddDetail( ({ "teil" }),
    "Der hintere Teil mit der Quelle ist nur ein Teil der gesamten Hoehle.");
  AddDetail( ({ "hoehle", "tropfsteinhoehle" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "fluss" }),
    "Der Fluss speisst den See vor der Hoehle. Irgendwie muss das Wasser "
    "hier drin seine besondere Wirkung erlangen.");
  AddDetail( ({ "see" }),
    "Der See wird von dem Fluss gespeisst. Seine Quelle liegt im hinteren "
    "Teil der Hoehle.");
  AddDetail( ({ "wasser" }),
    "Das Wasser sieht vollkommen klar und ... natuerlich aus.");
  AddDetail( ({ "wirkung" }),
    "Alle Pflanzen und Tiere die von dem Wasser trinken werden wesentlich "
    "groesser und staerker als normal.");
  AddDetail( ({ "pflanzen", "farne" }),
    "Wie zum Beispiel die Farne, die so riesig wurden das sie hoeher als Baeume sind.");
  AddDetail( ({ "baeume", "wald" }),
    "Die Farne bilden ihren eigenen Wald und dennoch, sind es nur Farne.");
  AddDetail( ({ "tiere" }),
    "Sogar die Tiere sind riesig. Wie gross sie wohl geworden waeren wenn "
    "sie direkt aus der Quelle getrunken haetten?");
  AddDetail( ({ "stalagmiten" }),
    "Das sind Kalkablagerungen die sich auf dem Boden bilden. Um die Quelle herum "
    "sind die Ablagerungen sehr viel kleiner als sonst in der Hoehle.");
  AddDetail( ({ "stalaktiten" }),
    "Stalaktiten entstehen dadurch das kalkhaltiges Wasser von der Decke tropft. "
    "Das Kalk setzt sich ab und bildet den Tropfstein. Das herunterfallende Wasser "
    "beinhaltet noch etwas Kalk wodurch es zur Bildung der Stalagmiten kommt. Um "
    "die Quelle herum sind die Ablagerungen sehr viel kleiner.");
  AddDetail( ({ "kalkablagerungen", "ablagerungen" }),
    "Irgendetwas muss eine Stoerung im Wachstum der Tropfsteine hervorgerufen haben.");
  AddDetail( ({ "tropfstein", "tropfsteine" }),
    "Stalaktiten oder Stalagmiten.");
  AddDetail( ({ "kalk" }),
    "Das Kalk entsteht durch eine Verbindung von Kohlenstoff mit Kalziumcarbonat aus "
    "dem Kalk- oder Gibsgestein.");
  AddDetail( ({ "verbindung" }),
    "Dank dieser Verbindung enstehen Tropfsteine.");
  AddDetail( ({ "kohlenstoff", "co2" }),
    "Auch CO2 genannt.");
  AddDetail( ({ "kalziumcarbonat", "caco3" }),
    "Auch CaCO3 genannt.");
  AddDetail( ({ "kalkgestein", "gibsgestein", "gestein" }),
    "Die Hoehle besteht aus Kalkgestein.");
  AddDetail( ({ "hauptquelle", "oberflaeche" }),
    "Die Hauptquelle des Wassers ist ein kleiner unterirdirscher Fluss der hier an "
    "die Oberflaeche tritt.");
  AddDetail( ({ "beispiel" }),
    "Nur ein Beispiel.");
  AddDetail( ({ "boden" }),
    "Der Boden ist sehr feucht. Spuren oder aehnliches haben keine Moeglichkeit "
    "zu ueberdauern.");
  AddDetail( ({ "moeglichkeit", "spuren" }),
    "Das viele Wasser verhindert Spuren erfolgreich.");
  AddDetail( ({ "wand", "waende" }),
    "Im hinteren Teil der Hoehle tritt ein kleiner unterirdischer Fluss an die "
    "Oberflaeche. Dies ist die Quelle des Sees. Aber ist es auch die Quelle "
    "der unglaublichen Kraft des Wassers?");
  AddDetail( ({ "stoerung", "wachstum" }),
    "Das Wachstum der Tropfsteine kann durch Hoehlenbesucher gestoert werden. "
    "Beruehrt man einen Tropfstein, so setzt sich Fett von der Haut ab und "
    "verhindert an dieser Stelle zukuenftige Kalkablagerungen.");
  AddDetail( ({ "fett", "haut", "stelle" }),
    "Beruehrt man einen Tropfstein verhindert man zukuenftige Kalkablagerungen.");
  AddDetail( ({ "besucher", "hoehlenbesucher", "besuch" }),
    "Der Besucher muss seit langer Zeit regelmaessig vorbeikommen. Andernfalls "
    "waere die Stoerung nicht so gravierend. Wer das wohl war?");
  AddDetail( ({ "zeit", "entwicklung" }),
    "Die Tropfsteine haben sich ueber Jahrhunderte gebildet. Eine Stoerung "
    "haette die Entwicklung um Jahre zurueckgeworfen. Fuer eine so starke "
    "Stoerung jedoch war haeufigerer Besuch von noeten.");
  AddDetail( ({ "bildung" }),
    "Aufgrund des Kalks kommt es zur Bildung der Tropfsteine.");
  AddDetail( ({ "kraft" }),
    "Woher stammt nur die Kraft des Wassers?");
  AddDetail( ({ "jahrhunderte", "jahre" }),
    "So etwas benoetigt etliche Jahre, um zu entstehen.");

  AddSound( DEFAULT_SOUND,
    "Bestaendig hoerst Du das Wasser von der Decke tropfen.");

  AddSound( ({ "wasser" }),
    "Es tropft von der Decke.");
  AddSound( ({ "decke" }),
    "Das Wasser tropft von der Decke. Es ist aber nicht die Hauptquelle "
    "fuer den Fluss.");
  AddSound( ({ "tropfen" }),
    "*tropf*");

  AddSmell( DEFAULT_SMELL,
    "Es riecht kalkig.");

  AddSmell( ({ "kalk", "geruch" }),
    "Der Geruch ist schwer einzuschaetzen, aber er kommt Dir sehr kalkig vor.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", "./seeB1" );
 
  AddCmd(({ "beruehre", "beruehr" }), "cmd_beruehre");
  
   AddItem( NPC "hydra", REFRESH_DESTRUCT);

}

int cmd_beruehre(string str)
{
  notify_fail("Was willst Du beruehren?\n");

  if(!str || str == "") return 0;
  if(member(({"tropfstein", "stalagmit", "stalagmiten", "stalaktit", "stalaktiten",
     "tropfsteine", "ablagerungen", "ablagerung" }), str) == -1) return 0;

  write(BS("Du beruehrst einen Tropfstein mit Deinen fettigen Fingern und "
          +"verhinderst eine weitere Entwicklung an der Stelle."));
  Message(BS(TP->Name()+" beruehrt einen Tropfstein und verhindert mit seinen "
         +"fettigen Fingern eine weitere Entwicklung an der Stelle."), 
         MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
  return 1;
}