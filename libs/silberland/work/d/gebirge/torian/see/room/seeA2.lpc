inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp( P_INT_SHORT, "An einem See" );
  SetProp( P_INT_LONG,
    "Nahezu komplett von Felsen umgeben schimmert die Oberflaeche des Sees "
    "in silbrigem Licht. Der Wald erstreckt sich fast bis zum Ufer. Der "
    "herrliche Anblick des Sees laesst Dein Herz vor Freude springen.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
  
  AddDetail( ({ "felsen" }),
    "Steile, graue Felsen umgeben den See. Maejestaetisch erheben sich "
    "die Berge vor Dir. Kein noch so geschickter Bergsteiger koennte sie "
    "bezwingen.");
  AddDetail( ({ "berge", "berg" }),
    "Majestaetisch erheben sich die Berge vor Dir und schliessen den See ein. "
    "Weisse Bergkuppen und Spitzen deuten auf die enorme Hoehe hin.");
  AddDetail( ({ "bergkuppe", "bergkuppen", "kuppe", "kuppen",
                "bergspitze", "spitze", "bergspitzen", "spitzen"}),
    "Die Berge reichen bis ueber die Schneegrenze hinaus. Nichteinmal der "
    "geschickteste Zwerg koennte sie ohne weiteres bezwingen.");
  AddDetail( ({ "schneegrenze", "grenze", "schneefallgrenze" }),
    "Die Schneefallgrenze liegt etliche tausend Meter hoch.");
  AddDetail( ({ "meter" }),
    "Ungefaehr ein Hobbit gross.");
  AddDetail( ({ "hobbit" }),
    "Ein Hobbit ist ungefaehr ein Meter gross.");
  AddDetail( ({ "hoehe" }),
    "Die Berge sind so hoch das auf ihren Spitzen Schnee liegt. Irgendwie "
    "musst Du bei diesem Anblick an Zucker denken.");
  AddDetail( ({ "schnee" }),
    "Der weisse Schnee erinnert Dich an Zucker. Wie ihn Deine Mama in Deiner "
    "Kindheit immer ueber Kuchen gestreut hat.");
  AddDetail( ({ "mama" }),
    "Hat Deine Mama Dir nie einen Kuchen gebacken?");
  AddDetail( ({ "kuchen" }),
    "Du bekommst Hunger.");
  AddDetail( ({ "hunger" }),
    "So ein kleines Stueckchen Kuchen waer doch jetzt genau das richtige.");
  AddDetail( ({ "stueckchen", "stueck" }),
    "Versuchs mal beim Baecker in Felonia.");
  AddDetail( ({ "baecker" }),
    "Der Baecker in Felonia ist einer der besten im ganzen Silberland.");
  AddDetail( ({ "felonia", "hauptstadt" }),
    "Felonia ist die Hauptstadt der Zwerge.");
  AddDetail( ({ "kindheit" }),
    "Die meisten Leute wollen gar nicht erwachsen werden. Sie fuehlen und  "
    "benehmen sich noch wie kleine Kinder.");
  AddDetail( ({ "kinder", "leute", "kind" }),
    "Fuehlst Du Dich noch wie ein Kind?");
  AddDetail( ({ "anblick", "zucker" }),
    "Der Anblick der schneebedeckten Berge erinnert Dich an Zucker.");
  AddDetail( ({ "zwerg" }),
    "Zwerge gelten als die geschicktesten Bergsteiger im Silberland. Auch wenn "
    "sie sich haeufiger im Berg als auf ihm bewegen.");
  AddDetail( ({ "silberland" }),
    "Du befindest Dich dort.");
  AddDetail( ({ "bergsteiger" }),
    "Nicht einmal der geschickteste Bergsteiger koennte diese Berge bezwingen.");
  AddDetail( ({ "oberflaeche", "wasseroberflaeche" }),
    "Die Oberflaeche des Sees ist glasklar und absolut glatt. Nur ab und zu, "
    "wenn ein Fisch die Oberflaeche durchbricht entstehen kleine Wellen.");
  AddDetail( ({ "fisch", "fische" }),
    "Hin und wieder durchbrechen Fische die Wasseroberflaeche. Hast Du schon "
    "einen gesehen?");
  AddDetail( ({ "wellen" }),
    "Kleine kreisrunde Wellen die immer groessere Bahnen ziehen. Fast so als "
    "wuerde man einen Stein in den See werfen.");
  AddDetail( ({ "bahnen" }),
    "Immer groessere Bahnen ziehen die kleinen kreisrunden Wellen.");
  AddDetail( ({ "stein", "steine" }),
    "Es liegen tatsaechlich ein paar Steine am Ufer.");
  AddDetail( ({ "see" }),
    "Traumhaft still und ruhig liegt der See vor Dir. Er laedt geradzu ein "
    "zu relaxen und sich zu entspannen.");
  AddDetail( ({ "licht", "sonnenlicht", "sonne" }),
    "Die Sonne taucht den See in ein silbriges Licht. Selten hast Du solch "
    "einen friedlichen Anblick erlebt.");
  AddDetail( ({ "wald" }),
    "Vom Ufer aus betrachtet erscheint der Wald in vollkommen neuem Licht. Er "
    "sieht eher aus wie ein paar gigantische Farne.");
  AddDetail( ({ "farne", "farn" }), 
    "Wie konnten die Farne nur so riesig werden???");
  AddDetail( ({ "ufer" }),
    "Der Wald erstreckt sich fast bis zum Ufer. Nur ein kleiner Sandstrand "
    "ist vorhanden.");
  AddDetail( ({ "sandstrand", "strand" }),
    "Du laesst ein wenig Sand zwischen Deinen Fingern hindurch rieseln.");
  AddDetail( ({ "finger" }),
    "Du zaehlst Deine Finger. Tatsaechlich alle da.");
  AddDetail( ({ "sand" }),
    "Der Strand besteht aus feinstem Sand. Hier koennte man sich bestimmt "
    "gut erholen von den Strapazen des Abenteurerdaseins.");
  AddDetail( ({ "strapazen", "abenteurerdaseins", "daseins" }),
    "Entspann Dich doch ein wenig und erhol Dich von den Strapazen.");
  AddDetail( ({ "anblick" }),
    "Der friedliche Anblick des Sees laesst Dein Herz vor Freude springen. "
    "Am liebsten wuerdest Du ewig hierbleiben.");
  AddDetail( ({ "herz", "freude" }),
    "Dein Herz huepft vor Freude.");
  AddDetail( ({ "boden" }),
    "Der pflanzenbedeckte Boden des Waldes geht nahtlos in den Sandstrand "
    "des Ufers ueber.");
  AddDetail( ({ "himmel" }),
    "Die Sonne beherrscht einen absolut wolkenlosen Himmel. Schoeneres "
    "Wetter kann man sich kaum wuenschen.");
  AddDetail( ({ "wetter" }),
    "Perfektes Wetter um sich auszuruhen.");
  AddDetail( ({ "wolken", "wolke" }),
    "Nicht die kleinste Wolke ist am Himmel zu erkennen.");
  AddDetail( ({ "wasser", "verschmutzung" }),
    "Das Wasser des Sees ist absolut klar, frei von jedweder Verschmutzung.");
  AddDetail( ({ "gebirge" }),
    "Dort befindest Du Dich gerade.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rascheln der Blaetter wenn der Wind durch sie hindurchfaehrt. In "
    "der Ferne kannst Du das Schreien eines grossen Vogels vernehmen.");

  AddSound( ({ "rascheln", "blaetter", "wald" }),
    "Ab und zu faehrt der Wind durch die Blaetter des Waldes.");
  AddSound( ({ "ferne", "schreien" }),
    "In der Ferne hoerst Du einen Vogel schreien. Was das wohl fuer ein Wesen ist?");
  AddSound( ({ "vogel", "wesen" }),
    "Es koennte fast ein Adler sein.");
  AddSound( ({ "adler", "koenig", "koenige", "luefte" }),
    "Angeblich soll es riesige Adler im Gebirge geben. Die wahren Koenige der Luefte.");

  AddSmell( DEFAULT_SMELL,
    "Der Wind weht den Geruch des Waldes herueber.");

  AddSmell( ({ "wind" }),
    "Der Wind weht den Geruch des Waldes herueber.");
  AddSmell( ({ "geruch", "wald" }),
    "Du bist Dir nicht sicher, aber Du hast den Eindruck als wenn der Wald nach Farnen "
    "riechen wuerde.");
   AddSmell( ({ "eindruck", "farnen", "farne" }),
    "Der Wald riecht nicht nur wie Farne, er sieht auch wie zu gross geratene Farne aus!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", "./seeA3" );
  AddExit( "osten", "./seeB2" );
  AddExit( "nordosten", "./seeB1" );

  AddRoomMessage( ({ "Ein grosser Fisch springt aus dem Wasser, um gleich "
                     "wieder unterzutauchen.\n",
                     "Das vom See reflektierte Sonnenlicht blendet "
                     "Dich ein wenig.\n"}), 40);

  AddCmd( "relaxe|relax|entspanne|entspann", "cmdentspannen",
          "Willst Du Dich entspannen oder relaxen?" );
  AddCmd( "wirf|werfe|werf&stein&in&wasser", "cmdwerfen",
          "Was willst Du wohin werfen?|Wohin willst Du den Stein werfen?" );


}

// ausruhen/entspannen
int cmdentspannen(string key)
{
  write(BS("Du legst Dich an den Strand und schliesst die Augen. Einfach traumhaft ..."));
  Message(BS(TP->Name()+" legt sich an den Strand und traeumt ein wenig."),MSGFLAG_NO_TP|MSGFLAG_VISUAL);
  return 1;
}
// Stein ins Wasser werfen
int cmdwerfen(string key)
{
  write("Gedankenverloren nimmst Du einen Stein auf und wirfst ihn ins Wasser.\n\n"
       +"*PLATSCH* \n\nDu betrachtest die kreisfoermigen Wellen, die entstanden sind.\n");
  Message(BS(TP->Name()+" wirft gedankenverloren einen Stein ins Wasser."), MSGFLAG_NO_TP|MSGFLAG_VISUAL);
  return 1;
}