inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Feuertroll");
  SetProp(P_LONG,
    "Der Feuertroll hat eine grosse Feuerkeule geschultert. Die uebliche "
    "Schwaeche von Trollen scheint diesen Exemplaren vollkommen zu fehlen.");

  SetProp(P_NAME, "Feuertroll");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));
  AddId(({"feuertroll", "troll", "Keulenmeister"}));

  AddClass(CL_TROLL);

  SetProp(P_GENDER, MALE);

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit seiner Feuerkeule",
                   QueryProp(P_HANDS)[1],({DT_BLUDGEON, DT_FIRE }) }));

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 240);
  SetProp(P_WEIGHT, 140000);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,50);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:      0.5, DT_WATER:       0.5
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.4, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  AddInfo(DEFAULT_INFO, "grinst Dich boese an.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  SetProp(P_SPELLRATE,50);
  AddSpell(5,700,
    Name()+" rammt Dich mit seiner Keule in den Boden!\n",
    Name()+" rammt @WEN mit seiner Keule in den Boden!\n",
     ({ DT_FIRE, DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));
  AddSpell(4,800,
    Name()+" rammt seine Keule in Deinen Magen!!\n",
    Name()+" rammt seine Keule in @WESSEN Magen!!\n",
    ({ DT_FIRE, DT_BLUDGEON }), ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Steckt @WEN ein.\n" }) );

  SetAttackChats(2, ({
    "Der Feuertroll spielt mit seiner Keule.\n",
    "Der Feuertroll bruellt Dich an.\n"}) );

  SUID;

  clone_object(WEAPON "feuerkeule" )->move(TO);
  command("zuecke feuerkeule");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Feuertroll.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Feuertroll hat "+CAP(getuid(player))+" umgebracht.\n");
}

void init()
{
  ::init();
  if(TP && TP->id("feuertroll")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}