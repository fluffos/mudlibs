inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Marmorgargyl");
  SetProp(P_LONG,
    "Ein Gargyl komplett aus Marmor. Seine langen Krallen sehen sehr "
    "gefaehrlich aus. Er kann damit sicher die haertesten Ruestungen "
    "zerschneiden. Seine Augen funkeln Dich wuetend an.");

  SetProp(P_NAME, "Marmorgargyl");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"gargyl", "marmorgargyl"}));

  create_default_npc(18 + random(5));
  SetProp(P_HANDS, ({" mit seinen Marmorkrallen ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_RACE, "Gargyl");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -100 + random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,40);

  SetProp(P_MSGIN, "fliegt auf Dich zu");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt auf Dich zu");
  SetProp(P_MMSGOUT, "fliegt hinfort");

  SetProp(P_DIE_MSG,  " zerbroeselt.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.5, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.4
     , DT_MIND:      0.0, DT_SLASH:    -0.5, DT_BLUDGEON:   -0.5
     , DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.5, DT_WHIP:       -0.5
     , DT_RIP:      -0.5
     ])
  );

  AddDetail("marmor",
    "Der Gargyl besteht komplett aus Marmor.");
  AddDetail("krallen",
    "Die Krallen sehen sehr gefaehrlich aus, der Gargyl kann damit "
    "sicherlich Knochen und Ruestungen zerschmettern.");
  AddDetail("ruestungen",
    "Ruestungen halten den Krallen bestimmt nicht stand.");
  AddDetail("knochen",
    "Die Krallen zerfetzen alles.");
  AddDetail("augen",
    "Seine Augen funkeln Dich wuetend an!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name()+" will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    Name()+" fliegt um Dich herum.\n"}) );
  SetAttackChats(2, ({
    Name()+" fliegt aggressiv um Dich herum.\n",
    Name()+" versucht, nach Dir zu greifen.\n"}) );

  SUID;
  SetProp(P_SPELLRATE,50);
  AddSpell(6,450,
    Name()+" zerkratzt Dir das Gesicht.\n",
    Name()+" zerkratzt @WEN das Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
    Name()+" schleudert einen Marmorbrocken nach Dir.\n",
    Name()+" schleudert einen Marmorbrocken nach @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,750,
    Name()+" zerfetzt Dich und Deine Ruestung!\n",
    Name()+" zerfetzt @WEN und @WESSEN Ruestung!\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Marmorgargyl.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Marmorgargyl hat "+CAP(getuid(player))+" umgebracht.\n");
}