inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine lebende Ritterruestung");
  SetProp(P_LONG,
    "Die Ruestung schwebt etwa einen halben Meter ueber dem Boden. Ihr Helm "
    "mit den dunklen Sehschlitzen wackelt wuetend hin und her. Furchteinfloessend "
    "schwingt sie ihre gepanzerten Arme in Deine Richtung.");

  SetProp(P_NAME, "Ritterruestung");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"ruestung", "ritterruestung"}));

  create_default_npc(18 + random(5));
  SetProp(P_HANDS, ({" mit ihren gepanzertern Faeusten ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_RACE, "Ruestung");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -100 + random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,40);

  SetProp(P_MSGIN, "schwebt auf Dich zu");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt auf Dich zu");
  SetProp(P_MMSGOUT, "schwebt hinfort");

  SetProp(P_DIE_MSG,  " faellt auseinander.\n");
  SetProp(P_NOCORPSE, 1 );

  AddDetail("meter",
    "Die Ruestung schwebt etwa einen halben Meter ueber dem Boden in der Luft.");
  AddDetail("luft",
    "Die Ruestung schwebt vor Dir in der Luft.");
  AddDetail("helm",
    "Der Helm wackelt wuetend hin und her.");
  AddDetail("sehschlitze",
    "Hinter den Sehschlitzen kannst Du nur gaehnende Leere sehen.");
  AddDetail("leere",
    "Es scheint sich niemand in der Ruestung zu befinden. Aber wieso kann sie "
    "sich dann bloss bewegen?!");
  AddDetail("arme",
    "Die gepanzerten Arme recken sich drohend in Deine Richtung.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Ritterruestung will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    "Die Ritterruestung klappert mit ihren Gelenken.\n"}) );
  SetAttackChats(2, ({
    "Die Ritterruestung klappert furchteinfloessend mit ihren Gelenken.\n",
    "Die Ritterruestung schwebt um Dich herum.\n",
    "Die Ritterruestung versucht, nach Dir zu greifen.\n"}) );

  SUID;
  SetProp(P_SPELLRATE,50);
  AddSpell(6,450,
    "Die Ritterruestung schleudert Dich zu Boden.\n",
    "Die Ritterruestung schleudert @WEN zu Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
    "Die Ritterruestung tritt Dir in den Magen.\n",
    "Die Ritterruestung tritt @WEN in den Magen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,750,
    "Die Ritterruestung rammt ihre Faeuste in Dein Gesicht.\n",
    "Die Ritterruestung rammt ihre Faeuste in @WESSEN Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt eine Ritterruestung.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Ritterruestung hat "+CAP(getuid(player))+" umgebracht.\n");
}