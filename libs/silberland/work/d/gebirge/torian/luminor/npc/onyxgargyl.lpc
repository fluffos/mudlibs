inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Onyxgargyl");
  SetProp(P_LONG,
    "Ein Gargyl komplett aus Onyx. Seine langen Krallen sehen sehr "
    "gefaehrlich aus. Er kann damit sicher die haertesten Ruestungen "
    "zerschneiden. Seine Augen funkeln Dich wuetend an.");

  SetProp(P_NAME, "Onyxgargyl");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"gargyl", "onyxgargyl"}));

  create_default_npc(23);
  SetProp(P_HANDS, ({" mit seinen Onyxkrallen ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_RACE, "Gargyl");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 200000);
  SetProp(P_ALIGN, -100 + random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,60);
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "fliegt auf Dich zu");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt auf Dich zu");
  SetProp(P_MMSGOUT, "fliegt hinfort");

  SetProp(P_DIE_MSG,  " zerbroeselt und hinterlaesst ein paar Onyxe.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.4
     , DT_MIND:      0.0, DT_SLASH:    -0.8, DT_BLUDGEON:   -0.8
     , DT_PIERCE:   -0.8, DT_SQUEEZE:  -0.8, DT_WHIP:       -0.8
     , DT_RIP:      -0.8
     ])
  );

  AddDetail("onyx",
    "Der Gargyl besteht komplett aus onyx.");
  AddDetail("krallen",
    "Die Krallen sehen sehr gefaehrlich aus, der Gargyl kann damit "
    "sicherlich Knochen und Ruestungen zerschmettern.");
  AddDetail("ruestungen",
    "Ruestungen halten den Krallen bestimmt nicht stand.");
  AddDetail("knochen",
    "Die Krallen zerfetzen alles.");
  AddDetail("augen",
    "Seine Augen funkeln Dich wuetend an!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name()+" will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    Name()+" fliegt um Dich herum.\n"}) );
  SetAttackChats(2, ({
    Name()+" fliegt aggressiv um Dich herum.\n",
    Name()+" versucht, nach Dir zu greifen.\n"}) );

  SUID;

  // 1-2 Onyxe reinclonen
  "obj/gemmaster"->DistributeGem(1, 0,1, 1,({"onyx"}));
  
  SetProp(P_SPELLRATE,55);
  AddSpell(6,500,
    Name()+" zerfetzt Dir das Gesicht.\n",
    Name()+" zerfetzt @WEN das Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,650,
    Name()+" schleudert einen Onyxsplitter nach Dir.\n",
    Name()+" schleudert einen Onyxsplitter nach @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,850,
    Name()+" zerfetzt Dich und Deine Ruestung!\n",
    Name()+" zerfetzt @WEN und @WESSEN Ruestung!\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Onyxgargyl.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Onyxgargyl hat "+CAP(getuid(player))+" umgebracht.\n");
}

