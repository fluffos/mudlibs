#include "../def.h"
#include "/d/wasser/torian/sumpffieber/quest.h"

inherit "std/npc";
//inherit "std/mnpc";
inherit "/std/npc/spells";

int filter_gender(object ob, int gender);

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Harry, der intelligente Troll");
  SetProp(P_LONG,
    "Vor Dir steht Harry, der intelligente Troll. Trotz seiner Groesse von "
    "mehr als drei Metern sieht er sehr elegant in seinem ordentlichen schwarzen "
    "Anzug aus. Auf seiner Nase sitzt eine grosse Brille. Durch das Studium diverser "
    "Buecher scheint sein Augenlicht ein wenig nachgelassen zu haben."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Harry");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"troll", "harry", "NOWIMPY"}));
  AddClass( ({CL_TROLL }) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen sauberen Trollhaenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 360);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" freut sich ueber Deine Gabe.\n" }) );

  SetProp(P_LOG_INFO, "/torian/sumpf/harry");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     -0.2, DT_BLUDGEON:    -0.2
     , DT_PIERCE:    -0.2, DT_SQUEEZE:   -0.2, DT_WHIP:        -0.2
