     ])
  );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Mein Goooold...");
  SetProp(P_KILL_NAME, "Harry, der intelligente Troll");
  SetProp(P_KILL_MSG, "Deine Ausruestung bringt bestimmt ein huebsches Suemmchen.");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"torian","freund"}),
    "Torian ist mein bester Freund, er bringt mir bei jedem Besuch "
    "etwas mit. Mal etwas Gold mal etwas leckeres zu essen. Ich freu mich "
    "immer wenn er da ist, auch wenn er mal nichts dabei hat. Natuerlich "
    "freu ich mich noch mehr wenn ein wenig Gold dabei rausspringt.",
    "sagt froehlich: ");

  AddInfo( ({"scroll","paladin"}),
    "Man sagt ich scrolle mehr als jeder Paladin. Verstehe ich gar nicht, ich "
    "finde ich rede ganz normal und ueberhaupt nicht zuviel. Ausserdem sind "
    "Paladine doof. Wollen mir nie ein wenig Gold geben da sie immer alles "
    "Dusty, ihrer Goettin, opfern.",
    "sagt leicht veraergert: ");

  AddInfo( ({"gold","goldnugget", "goldnuggets", "nuggets"}),
    "Gold hamstern ist mein Hobby, das kann ich tagein, tagaus machen, ohne muede "
    "zu werden. Am liebsten hab ich dabei die kleinen Goldnuggets aus dem "
    "zwergischen Bergwerk. Leider verscheuchen mich immer die Waechter. Nur weil "
    "ich wie ein Troll aussehe. Ok, zugegebenermassen BIN ich ein Troll, aber "
    "ich bin auch der intelligenteste Troll, der je auf dieser Welt gewandelt ist.",
    "sagt: ");

  AddInfo( ({"harry","troll"}),
    "Richtig erkannt, ich bin Harry der intelligente Troll. Ich bin ziemlich "
    "einzigartig. Ich koennte die Trollherrschaft an mich reissen, wenn mich die "
    "anderen Trolle nicht wegen meiner ueberragenden Intelligenz meiden wuerden. "
    "Diese Ignoranten, was ich alles fuer sie tun koennte - und sie fuer mich. "
    "Stell Dir nurmal vor, eine Armee von Trollen wuerde im Bergwerk nach Gold "
    "schuerfen. Unglaubliche Reichtuemer koennte ich anhaeufen.",
    "sagt: ");

  AddInfo( ({"trollherrschaft","herrschaft"}),
    "Zuerst die Trolle und dann die gesamte Welt!!! Alle werden sich meinem "
    "ueberlegenen Intellekt beugen muessen. Aber zunaechst, Gold sammeln!",
    "sagt irre kichernd: ");

  AddInfo( ({"spezies", "trolle", "ignoranten", "ignorant", "fall"}),
    "Die Spezies Troll besteht an und fuer sich nur aus dummen Ignoranten. In "
    "meinem Fall jedoch hat die launische Hand des Schicksals einen Intellektuellen "
    "entstehen lassen.",
    "sagt: ");

  AddInfo( ({"bergwerk", "zwergenbergwerk"}),
    "Im Zwergenbergwerk gibt es die schoensten Goldnuggets Wenn nur diese "
    "Zwergenwaechter nicht waeren. Ich habe mal versucht mich als Zwerg zu "
    "verkleiden. Die Tarnung war wirklich perfekt, langer Bart, wochenlang "
    "nicht gewaschen und eine Spitzhacke die ich einem Arbeiter abnehmen konnte. "
    "Doch irgendwie haben sie mich sofort erkannt. Wenn ich bloss wuesste "
    "woran das lag.",
    "sagt: ");

  AddInfo( ({"tarnung"}),
    "Meine Tarnung war wirklich perfekt! Ich weiss bis heute nicht warum man mich "
    "erkannt hat. Vielleicht wenn die Gaenge im Zwergenbergwerk hoeher gewesen waeren "
    "und ich mich nicht so tief haette buecken muessen ...",
    "sagt: ");

  AddInfo( ({"zwerg","zwerge", "zwergenwaechter", "waechter", "arbeiter", "zwergenarbeiter"}),
    "Die Zwerge bewachen ihr Bergwerk viel zu gut. Nie darf ich dort in Ruhe "
    "schuerfen. Wenn diese Waechter nicht waeren wuerde ich dort einziehen. So "
    "bleibt mir nur meine kleine Hoehle hier.",
    "sagt: ");

  AddInfo( ({"hoehle", "plaetzchen"}),
    "Hier wohne ich, ist das nicht offensichtlich? Ich habe dieses nette Plaetzchen "
    "entdeckt nachdem man mich aus dem Trolllager vertrieben hatte.",
    "sagt: ");

  AddInfo( ({"lieblingslied","lied", "volksweise", "weise"}),
    "Mein Lieblingslied ist eine alte zwergische Volksweise. Habs bei einem "
    "Zwergenarbeiter aufgeschnappt als er vom Schuerfen zurueckkam. Moechtest "
    "Du nicht mit mir zusammen das Lied singen? Der Text ist ganz einfach.",
    "sagt: ");

  AddInfo( ({"text", "singen"}),
    "Gold, Gold, Gold, Gold, Gold, Gold, Gold ...",
    "singt: ");

  AddInfo( ({"wahrscheinlichkeit"}),
    "Ich habe die Wahrscheinlichkeit berechnet, mit welcher einem Angehoerigen "
    "meiner Spezies es passieren kann als Intellektueller auf die Welt zu kommen, "
    "und sie ist nicht sehr hoch. Um nicht zu sagen, sie ist sehr gering. "
    "Ich duerfte also so ziemlich einzigartig sein.",
    "sagt: ");

  AddInfo( ({"spitzhacke","hacke"}),
    "So eine Spitzhacke sollte jeder haben. Sie ist perfekt dafuer geeignet "
    "nach Gold oder Edelsteinen zu schuerfen. Wobei ich persoenlich Gold "
    "vorziehe. Es glaenzt so schoen im Sonnenlicht.",
    "sagt: ");

  AddInfo( ({"trollring","ring"}),
    "Der Trollring ist eines der letzten Ueberbleibsel meines Lebens "
    "im Trolllager. Ich finde er steht mir sehr gut, auch wenn er leider nicht "
    "aus Gold ist.",
    "sagt: ");

  AddInfo( ({"trolllager","lager"}),
    "Diese dummen Ignoranten haben mich aus ihrem Lager vertrieben. Und das nur "
    "weil ich angeblich zu viel erzaehle und schlimmer scrollen wuerde als ein Paladin. "
    "Dabei stimmt das gar nicht. Sie werden schon sehen was sie davon haben. Ich "
    "werde die Herrschaft an mich reissen und alle zwingen fuer mich nach Gold zu "
    "schuerfen!",
    "sagt erbost: ");

  AddInfo( ({"zylinder","schwarzer zylinder"}),
    "Diesen Zylinder habe ich einmal einer Fee abgenommen. Sie war unvorsichtig "
    "genug in meine Naehe zu kommen. Findet Ihr nicht auch das mir der Zylinder steht?",
    "sagt: ");

  AddInfo( ({"anzug","schwarzer anzug"}),
    "Sowas traegt man als intelligenter Troll von Heute. Trollruestungen sind out, "
    "Anzuege sind in.",
    "sagt bestimmend: ");

  AddInfo( ({"messer","kuechenmesser"}),
    "So ein Kuechenmesser ist schon praktisch. Ohne koennte ich gar nicht "
    "mehr kochen. Deswegen halte ich mein Messer im scharf und rein, ausserdem "
    "sorge ich dafuer das immer eins im Haus ist.",
    "sagt: ");

  AddInfo( ({"turm"}),
    "Der Turm befindet sich weiter im Westen von hier. Ich war nur einmal kurz "
    "unten drin, aber ausser Leichen gab es dort nichts. Also bin ich wieder raus.",
    "sagt: ");

  AddInfo( ({"leiche","leichen"}),
    "Die Leichen waren schon alle gepluendert, da gab es nichts fuer mich zu holen.",
    "sagt: ");

  AddInfo( ({"wolf","woelfe", "lieblingsgericht", "gericht", "waldwolf", "silberwolf"}),
    "Wolf ist mein Lieblingsgericht. Am liebsten hab ich Waldwolf, aber zu einem "
    "Silberwolf sag ich auch nicht nein.",
    "sagt: ");

  AddInfo( ({"kochbuch","buch"}),
    "Das Kochbuch habe ich selbst geschrieben. Da seht ihr mal wie ueberagend "
    "intelligent ich bin. Andere Trolle koennen noch nichtmal lesen!",
    "sagt: ");

  AddInfo( ({"schuerfen"}),
    "Ich wuerde ja zu gerne im Zwergenbergwerk schuerfen. Leider kann ich das nicht "
    "weil mich die Waechter immer wieder vertreiben.",
    "sagt: ");

  AddInfo( ({ "antonius", "heiler", "freund"}),
    "Antonius, der Heiler aus Arwenock, ist mein einziger Freund. Nachdem ich von "
    "den Trollen verstossen wurde, war er der einzige, der bereit war, mit mir zu "
    "reden. Leider ist er zur Zeit unterwegs und nicht in Arwenock anzutreffen.",
    "sagt: ");
    
  AddInfo( ({"arwenock", "pfad"}),
    "Arwenock liegt noerdlich von hier. Halte Dich westlich auf dem Pfad und Du "
    "kannst es nicht verfehlen. Ich bin nur selten dort. Die Waechter Bronawar und "
    "Turanis haben etwas gegen mich.",
    "sagt: ");
    
  AddInfo( ({"bronawar","turanis", "waechter"}),
    "Sie lassen mich nicht nach Arwenock und das alles nur, weil ich angeblich "
    "zuviel rede. Findest Du das auch? Ich eigentlich nicht und Antonius auch nicht.",
    "sagt: ");
    
  AddInfo( ({"phiole"}),
    "Ja, ich besitze welche. Aber einfach so gebe ich sie nicht weg. Du musst mir schon "
    "etwas dafuer geben.",
    "sagt: ");
/*
  AddInfo( ({""}),
    "",
    "sagt: ");

*/
//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,55);

  AddSpell(5,800,
    Name(WER,1) + " wirft einen grossen Felsbrocken nach Dir!\n",
    Name(WER,1) + " wirft einen grossen Felsbrocken nach @WEN!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(6,1000,
    Name(WER,1) + " rammt seine Faust in Dein Gesicht!\n",
    Name(WER,1) + " rammt seine Faust in @WESSEN Gesicht!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,1,
    Name(WER,1) + " wirft Dich aus seiner Hoehle raus!\n",
    Name(WER,1) + " wirft @WEN aus seiner Hoehle raus!\n",
     DT_BLUDGEON, "rauswurf");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sagt: Mein Lieblingslied ist eine alte zwergische Volksweise.\n",
    Name(WER, 1)+" singt: Gold Gold Gold Gold ...\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Finger weg von meinem Gold!\n"
   ,Name(WER, 1)+" sagt: Das hat gar nicht weh getan.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/axe/spitzhacke" );
//  command("zuecke spitzhacke");

  CLONEME("/d/ebene/ronja/feenquest/armour/zylinder" );
  CLONEME("/d/gebirge/speedy/trollager/armour/trollring" );
  CLONEME(ARMOUR "anzug");
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Harry.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }

  call_out("pluendern",0);

}

void pluendern()
{
 command_me("nimm alles aus leiche");
 command_me("iss leiche");
 command_me("sage Das wird mir einen schoenen Batzen Gold einbringen");
}

//--Reactions--------------------------------------------------------------

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt "+TP->name(WEN)+" boese an.");
      break;
    default :
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

void init()
{
  if (!is_clone(TO)) return;

  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if (find_call_out("begruessung") != -1) return;
  
  call_out("begruessung", 0);

}

int filter_lebewesen(object ob)
{
  return interactive(ob) && (!find_netdead(getuid(ob)));
}

int filter_gender(object ob, int gender)
{
  return (ob->QueryProp(P_GENDER) == gender);
}

void begruessung()
{
  object *inhalt, *maennlich, *weiblich;
  string s;
  int i, size;

  inhalt = all_inventory(ENV(TO));
  
  inhalt = filter_array(inhalt, "filter_lebewesen");

  maennlich = filter_array(inhalt, #'filter_gender, MALE);
  weiblich = filter_array(inhalt, #'filter_gender, FEMALE);

  size = sizeof(inhalt);
  switch(size)
  {
    case 0: // keiner da keine Begruessung
      return;
      break;
    case 1:
      inhalt[0]->QueryProp(P_GENDER) == MALE ? s = "Mein Herr" : s = "Meine Dame";
      break;
    default: // mehr als eine Person anwesend

      if(sizeof(maennlich) && sizeof(weiblich))
      {
        s = "Meine Damen und Herren";
      }
      else if(sizeof(maennlich))
      {
        s = "Meine Herren";
      }
      else if(sizeof(weiblich))
      {  
        s = "Meine Damen";
      }

      break;
  }

  ENV(TO)->Message(break_string("He, Ihr da! "+s+"! "
  +"Erlaubt, dass ich mich vorstelle. Ich bin Harry, "
  +"der intelligente Troll. Ja, in meinem Fall hat die launische Hand des "
  +"Schicksals aus einem Ignoranten einen Intellektuellen gemacht. Ich habe "
  +"die Wahrscheinlichkeit berechnet, mit welcher so etwas einem Angehoerigen "
  +"meiner Spezies passiert, und sie ist nicht sehr hoch. Ich bin also "
  +"ziemlich einzigartig, weswegen man mich unbedingt am Leben lassen sollte, "
  +"findet Ihr nicht? Im Moment hamstere ich Gold, und wenn Ihr mich "
  +"entschuldigt, wuerde ich gerne noch mehr davon hamstern.", 78, "Harry sagt: "), MSGFLAG_SOUND);
  return;
}

void give_notify(object was) 
{
  object phiole;
  if (!was->id("goldnugget")) return ::give_notify(was);

  ENV(TO)->Message(BS(Name()+" freut sich und laesst das Gold in seinem Anzug verschwinden."),
  MSGFLAG_VISUAL);
  was->remove();
  
  phiole = clone_object("/d/wasser/torian/sumpffieber/obj/phiole");
  if(!phiole)
  {
    ENV(TO)->Message(break_string("Ich wuerde ja gerne etwas dafuer geben. Besitze "
             +"zur Zeit nur leider nichts.", 78, "Harry sagt: "), MSGFLAG_SOUND);
    return;
  }
  
  if(deep_present(PHIOLE, TP))
  {
    ENV(TO)->Message(break_string("Danke fuer das Gold, nochmal bekommst "
    +"Du aber nichts von mir.", 78, "Harry sagt: "), MSGFLAG_SOUND);
    return;
  }

  if(ME_TOO_HEAVY==phiole->move(TP,M_GET|M_SILENT))
  {
    ENV(TO)->Message(break_string(TP->Name()+", ich wuerde Dir ja gerne "
    +"etwas geben, Du kannst nur nichts mehr tragen.", 78, "Harry sagt: "), 
    MSGFLAG_SOUND);
  }
  else
  {
    ENV(TO)->Message(break_string("Hier, als Dankeschoen.", 78, "Harry sagt: "), MSGFLAG_SOUND);
    ENV(TO)->Message(BS(Name()+" gibt "+TP->Name(WER)+" eine leere Phiole."),
             MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    write(BS(Name()+" gibt Dir eine leere Phiole."));
  } 
  
  return;

}

void rauswurf(object enemy,int damage,string damtype)
{
  object raum;
  call_other (ROOM "wald2", "???", 0);
  raum = find_object(ROOM "wald2");
  if(raum)
  {
    enemy->move(raum, M_NO_SHOW|M_NOCHECK);
  }

  return;
}