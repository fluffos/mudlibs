inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Foltermeister");
  SetProp(P_LONG,
    "Der Foltermeister ist ein grosser und aeusserst kraeftiger Mann. "
    "Seine Arme sind mit vielen Muskeln bepackt und sein Gesicht wird "
    "von einer schwarzen Schandmaske bedeckt. Durch die kleinen "
    "Augenschlitze spuerst Du seinen stechenden Blick auf Dir ruhen. Er "
    "hat eine blutverschmierte Schuerze umgebunden und in seiner linken "
    "Hand haelt er ein grosses Richtschwert.");

  SetProp(P_NAME, "Foltermeister");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"foltermeister", "meister", "Schwertmeister"}));

  AddClass(CL_HUMAN);

  SetProp(P_GENDER, MALE);

  create_default_npc(27);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -250 - random(100));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,40);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder und folter Euch!!!");

  AddDetail("arme",
    "Seine Arme sind mit kraeftigen Muskeln ausgestattet.");
  AddDetail("muskeln",
    "Seine Arme sind sehr muskuloes.");
  AddDetail("gesicht",
    "Du kannst das Gesicht des Foltermeisters nicht sehen, da er eine "
    "schwarze Maske traegt.");
  AddDetail( ({"maske", "schandmaske" }),
    "Eine schwarze Schandmaske bedeckt das Gesicht des Foltermeisters.");
  AddDetail( ({"augenschlitze", "blick" }),
    "Du spuerst seinen stechenden Blick auf Dir ruhen.");
  AddDetail("schuerze",
    "Die Schuerze ist ueber und ueber mit Blut verschmiert.");
  AddDetail("blut",
    "Du siehst sehr viel Blut auf der Schuerze des Foltermeisters.");

  AddInfo(DEFAULT_INFO, "ist zu beschaeftigt mit Foltern.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  SetProp(P_SPELLRATE,50);
  AddSpell(6,550,
    Name()+" hackt mit seinem Schwert auf Dich ein!\n",
    Name()+" hackt mit seinem Schwert auf @WEN ein!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    Name()+" foltert Dich!!\n",
    Name()+" foltert @WEN!!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,900,
    Name()+" versucht Dich zu koepfen!!!\n",
    Name()+" versucht @WEN zu koepfen!!!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Foltermeister will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    "Der Foltermeister unterschreibt ein Todesurteil.\n",
    "Der Foltermeister richtet seinen stechenden Blick auf Dich.\n",
    "Der Foltermeister wartet auf seinen neuen Gefangenen.\n"}) );
  SetAttackChats(2, ({
    "Der Foltermeister unterzeichnet Dein Todesurteil!\n"}) );

  SUID;

  clone_object("/p/armour/boots/lederschuhe" )->move(TO);
  clone_object(ARMOUR "schuerze" )->move(TO);
  clone_object(ARMOUR "schandmaske" )->move(TO);
  command("trage alles");
  clone_object(WEAPON "richtschwert" )->move(TO);
  command("zuecke schwert");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt den Foltermeister.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Foltermeister hat "+CAP(getuid(player))+" umgebracht.\n");
}