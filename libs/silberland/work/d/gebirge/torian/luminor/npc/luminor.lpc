inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int anpassen(object player);
int ImKampf;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  ImKampf = NEIN;

  SetProp(P_SHORT, "Luminor");
  SetProp(P_LONG,
    "Vor Dir steht Luminor. Ein unglaublich maechtiger Feuerdaemon, "
    "sein gesamter Koerper scheint in Flammen zu stehen. Zwei riesige "
    "Hoerner thronen auf seinem Kopf. Mit seinen langen spitzen Krallen "
    "kann er nahezu alles in Sekundenschnelle zerfetzen.");

  SetProp(P_NAME, "Luminor");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));
  AddId(({"luminor", "daemon", "feuerdaemon"}));

  AddClass(CL_DEMON);

  SetProp(P_GENDER, MALE);

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen feuerumhuellten Krallen",
                   QueryProp(P_HANDS)[1], DT_FIRE }));
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 500);
  SetProp(P_WEIGHT, 800000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,60);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich verliere ...");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:      0.2, DT_WATER:       0.2
     , DT_AIR:      -0.5, DT_LIGHTNING:-0.5, DT_EXPLOSION:  -0.5
     , DT_SOUND:    -0.5, DT_LIGHT:    -0.5, DT_ELECTRIC:   -0.5
     , DT_ACID:     -0.5, DT_POISON:   -0.5, DT_TERROR:     -0.5
     , DT_HOLY:      0.1, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.5
     , DT_MIND:     -0.5, DT_SLASH:    -0.5, DT_BLUDGEON:   -0.5
     , DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.5, DT_WHIP:       -0.5
     , DT_RIP:      -0.5
     ])
  );

  AddDetail( ({ "koerper" }),
    "Sein gesamter Koerper scheint in Flammen zu stehen. Seine Haut ist "
    "komplett rot.");
  AddDetail( ({ "haut", "flammenzungen" }),
    "Seine Haut ist komplett rot, ab und zu lecken ein paar Flammenzungen "
    "hervor.");
  AddDetail( ({ "flammen", "gegenteil" }),
    "Als Feuerdaemon machen ihm Flammen nichts aus. Ganz im Gegenteil.");
  AddDetail( ({ "hoerner", "kopf", "zweihaender", "zweihaenderschwert" }),
    "Zwei riesige Hoerner thronen auf seinem Kopf. Sie sind laenger und "
    "spitzer als ein Zweihaenderschwert.");
  AddDetail( ({ "krallen", "sekundenschnelle" }),
    "In Sekundenschnelle kann Luminor nahezu alles mit seinen Krallen "
    "zerfetzen.");

  AddInfo(DEFAULT_INFO, "bruellt Dich an.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  SetProp(P_SPELLRATE,50);
  AddSpell(6,600,
    Name()+" schlitzt Dich mit seinen Krallen auf!\n",
    Name()+" schlitzt @WEN mit seinen Krallen auf!\n",
     ({DT_FIRE,DT_SLASH}),([SP_SHOW_DAMAGE:1]));
  AddSpell(4,900,
    Name()+" huellt Dich in eine Feuerwolke!!\n",
    Name()+" huellt @WEN in eine Feuerwolke!!\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(5,1,DS_FEAR,
    Name()+" jagt Dir fuerchterliche Angst ein!!\n",
    Name()+" jagt @WEN fuerchterliche Angst ein!!\n");
  AddSpell(3,1000,
    Name()+" spiesst Dich auf seinen Hoernern auf!!\n",
    Name()+" spiesst @WEN auf seinen Hoernern auf!!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1300,
    Name()+" reisst Dir Dein Herz raus!!!\n",
    Name()+" reisst @WEN das Herz raus!!!\n",
     ({DT_TERROR,DT_PIERCE}),([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Luminor grinst daemonisch.\n" }) );

  SetAttackChats(2, ({
    "Luminor bruellt Dich an!\n"}) );

  SUID;

//  if(!random(2))
    clone_object(ARMOUR "feuerhandschuhe" )->move(TO);
  
  command("trage alles");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Luminor.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Luminor hat "+CAP(getuid(player))+" umgebracht.\n");
  call_out("pluendern",0);
}

void pluendern()
{
 command_me("nimm alles aus leiche");
 command_me("iss leiche");
}

void init()
{
  if (!is_clone(TO)) return;

  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if (find_call_out("begruessung") != -1) return;
  
  call_out("begruessung", 0);

  anpassen(TP);

}

void begruessung()
{
  if(ENV(TO))
  {
    ENV(TO)->Message(break_string("Zeit zu sterben!", 78, "Luminor lacht: "));
  }
  return;
}

int anpassen(object player)
{
  object obj;
  int level, max_hp, hp;
  call_other (ROOM "secondfloorB1", "???", 0);
  obj = find_object(ROOM "secondfloorB1");

  switch(obj->QueryFlamme())
  {
    case RIESIG:
      SetProp(P_SPELLRATE,85);
      level = 50;
      max_hp = 5000;
      break;
    case SEHRGROSS:
      SetProp(P_SPELLRATE,75);
      level = 48;
      max_hp = 4000;
      break;
    case GROSS:
      SetProp(P_SPELLRATE,65);
      level = 45;
      max_hp = 3000;
      break;
    case MITTEL:
      SetProp(P_SPELLRATE,55);
      level = 42;
      max_hp = 2000;
      break;
    default:
      return -1;
  }

  if(ImKampf == NEIN)
  {
    create_default_npc(level, max_hp);
  }
  else
  {
    // Werte setzen wie in create_default_npc mit Ausnahme von P_HP
    // Kein heilen von Luminor durch verkleinern der Lebenflamme
    SetProp(P_LEVEL, level);
    SetProp(P_BODY, 4*level);
    SetProp(P_HANDS, ({" mit seinen feuerumhuellten Krallen",
            (300+5*(level-30)), DT_FIRE }) );

    SetProp(P_XP, max_hp*(QueryProp(P_HANDS)[1])*5);
    
    hp = QueryProp(P_HP);            // Wieviel hp?
    hp = hp*100/QueryProp(P_MAX_HP); // Wieviel hp in Prozent, gerundet (div)
    hp = (max_hp/100)*hp;            // neue hp mit gleichem verhaeltnis
                                     // (prozent) zu alten hp/maxhp

    SetProp(P_MAX_HP, max_hp);
    SetProp(P_HP, hp);
  }
  return 1;

}

Attack(object enemy) {
  ImKampf=JA;
  return ::Attack(enemy);
}

Defend(int dam, string dtype, int spell, object enemy)
{
  // falls kein Array, eins draus machen
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (member(dtype, DT_FIRE) != -1)
  {
    if(ENV(TO))
    {
      ENV(TO)->Message(BS("Luminor badet in dem Feuer!\n"), MSGFLAG_VISUAL);
    }
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
  return ::Defend(dam,dtype,spell,enemy);        
}