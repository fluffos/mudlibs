
#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include <npc.h>

string farbe;
int weight, size, level, nomagic, spellrate, spellpower;

void create()
{

  if (!is_clone(this_object())) return;

  ::create();
  
  switch(1 + random(16))
  {
    case 1..3:
      level = 20;
      farbe = "rot";
      weight = 70000;
      size = 170;
      nomagic = 10;
      spellrate = 35;
      spellpower = 20;
      AddId( ({"Peitschenkaempfer"}) );
      AddAdjective( ({ "roten", "rotes", "roter" }) );
      break;

    case 4..6:
      level = 21;
      farbe = "gruen";
      weight = 75000;
      size = 175;
      nomagic = 15;
      spellrate = 40;
      spellpower = 40;
      AddId( ({"Peitschenkaempfer"}) );
      AddAdjective( ({ "gruenen", "gruenes", "gruener" }) );
      break;

    case 7..9:
      level = 22;
      farbe = "blau";
      weight = 90000;
      size = 190;
      nomagic = 20;
      spellrate = 45;
      spellpower = 60;
      AddId( ({"Peitschenexperte"}) );
      AddAdjective( ({ "blauen", "blaues", "blauer" }) );
      break;

    case 10..12:
      level = 25;
      farbe = "gelb";
      weight = 95000;
      size = 195;
      nomagic = 25;
      spellrate = 50;
      spellpower = 80;
      AddAdjective( ({ "gelben", "gelbes", "gelber" }) );
      AddId( ({"Peitschenexperte"}) );
      break;

    case 13..15:
      level = 27;
      farbe = "weiss";
      weight = 135000;
      size = 235;
      nomagic = 35;
      spellrate = 55;
      spellpower = 100;
      AddAdjective( ({ "weissen", "weisses", "weisser" }) );
      AddId( ({"Peitschenexperte"}) );
      break;

    default:  // 16
      level = 30;
      farbe = "schwarz";
      weight = 200000;
      size = 300;
      nomagic = 45;
      spellrate = 60;
      spellpower = 150;
      AddAdjective( ({ "schwarzen", "schwares", "schwarzer" }) );
      AddId( ({"Peitschenmeister"}) );
      break;
  }

  SetProp(P_SHORT, "Ein "+farbe+"er Oni");
  SetProp(P_LONG, "Fehler!");
  SetProp(P_NAME, "Oni");
  SetProp(P_NAME_ADJ, ({ farbe }));

  SetProp(P_GENDER, MALE);
  AddId( ({"oni"}) );

  AddClass(CL_DEMON);

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit seinen Krallen ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, -400 - random(600) );
  SetProp(P_RACE, "Oni");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_WEIGHT, weight);
  SetProp(P_SIZE, size);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,nomagic);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "stampft herein");
  SetProp(P_MMSGOUT, "stampft hinfort");

  SetProp(P_DIE_MSG,  " stuerzt zu Boden.\n");
  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");

  AddSpecialDetail( ({ "haut" }), "strhaut");
  AddDetail( ({ "augen", "bewegungen" }),
    "Den drei Augen des Oni entgeht keine Deiner Bewegungen.");
  AddDetail( ({ "mund" }),
    "Der Mund ist sehr gross und zwei spitze Zaehne schauen daraus hervor.");
  AddDetail( ({ "zaehne" }),
    "Die Zaehne sehen aeusserst spitz aus.");
  AddDetail( ({ "hoerner" }),
    "Zwei grosse spitze Hoerner wachsen dem Oni aus dem Kopf.");
  AddDetail( ({ "kopf", "menschen" }),
    "Der Kopf des Onis saehe dem eines Menschen recht aehnlich, "
    "waeren da nicht drei Augen statt zwei und der Mund nicht so riesig.");
  AddDetail( ({ "fuesse", "fuessen" }),
    "Die beiden Fuesse des Onis sind mit scharfen Krallen besetzt.");
  AddDetail( ({ "krallen" }),
    "Scharfe Krallen befinden sich an den Fuessen des Onis. Damit kann "
    "er sich sicherlich gut gegen seine Gegner verteidigen.");
  AddDetail( ({ "gegner" }),
    "Du!");

  SetProp(P_SPELLRATE,spellrate);
  AddSpell(6,500+spellpower,
    Name()+" peitscht Dich aus!\n",
    Name()+" peitscht @WEN aus!\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,650+spellpower,
    Name()+" wirbelt herum und trifft Dich mit seinem Schwanz!\n",
    Name()+" wirbelt herum und trifft @WEN mit seinem Schwanz!\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,800+spellpower,
    Name()+" spiesst Dich auf seinen Hoernern auf!\n",
    Name()+" spiesst @WEN auf seinen Hoernern auf!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Der "+farbe+"e Oni behaelt Deine Sachen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -1.0
     , DT_HOLY:      0.3, DT_UNHOLY:   -1.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SUID;
  
  if(QueryProp(P_LEVEL)>24) 
  {
    clone_object("/d/unterwelt/zaknafein/eheringquest/weapon/peitsche" )->move(TO);
  }
  else 
  {
    clone_object("/p/weapon/whip/bullenpeitsche" )->move(TO);
  }
  command("zuecke peitsche");
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Oni.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Oni hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

string _query_long()
{
  string s;
  
  s = "Vor Dir steht ein ";
  switch(QueryProp(P_SIZE))
  {
  	case 170:
  	case 175:
  	  s += "mittelgrosser wenig gefaehrlich aussehender";
      break;
  	case 190:
  	case 195:
  	  s += "grosser gefaehrlich aussehender";
      break;
  	case 235:
  	  s += "sehr grosser auesserst gefaehrlich aussehender";
      break;  	
  	default: // 300
  	  s += "riessiger furchteinfloessender";
      break;
  }
  s += " Oni. Seine Haut ist komplett "+farbe+". Er hat drei Augen, "
      +"einen grossen Mund und zwei spitze Hoerner auf dem Kopf. Seine "
      +"Fuesse sind mit Krallen besetzt und er hat einen langen Schwanz.";

  return BS(s);
}

string strhaut(string key)
{
  return BS("Seine Haut ist komplett "+farbe+".");
}

void init()
{
  ::init();
  if(TP && TP->id("oni")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "bruellt veraergert und greift Dich an.",
        "bruellt veraergert und greift "+TP->name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "bruellt Dich an!",
        "bruellt "+TP->name(WEN)+"an!");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
