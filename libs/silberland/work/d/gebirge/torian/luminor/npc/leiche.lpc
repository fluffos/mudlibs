inherit "std/npc";
//inherit "std/room";
//inherit "std/room/description";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gepfaehlte Leiche");
  SetProp(P_LONG,
    "Die Leiche wurde auf einen Speer aufgespiesst. Erstaunlicherweise "
    "scheint sie noch am Leben zu sein. Unter ihrer zerfetzten Ruestung "
    "schimmern Haut und Knochen hervor.");

  SetProp(P_NAME, "Leiche");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"leiche", "NOWIMPY"}));

  AddClass(CL_HUMAN);

  SetProp(P_GENDER, FEMALE);

  create_default_npc(1);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 100 - random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  AddDetail( ({"speer" }),
    "Der Speer haelt die Leiche aufrecht.");
  AddDetail( ({"leben" }),
    "Irgendetwas haelt die Leiche am Leben.");
  AddDetail( ({"ruestung" }),
    "Die Ruestung ist vollkommen zerfetzt.");
  AddDetail( ({"haut", "verwesungsprozess", "prozess" }),
    "Die Haut glaenzt gruenlich. Der Verwesungsprozess hat wohl schon "
    "eingesetzt.");
  AddDetail( ({"knochen" }),
    "Ein paar Knochen leuchten weiss unter der Ruestung hervor.");

  SetProp(P_LOG_INFO, "/torian/luminor/leiche");

  AddInfo(DEFAULT_INFO, ({ "kichert irre.\n",
                           "jammert leise vor sich hin.\n",
                           "starrt durch Dich hindurch.\n" }));

  AddInfo("leben", "Luminor erhaelt mich kuenstlich am Leben, damit ich "
                   "alle wagemutigen Abenteurer, die es bis hierher geschaft "
                   "haben, warnen kann.","sagt: ");
  AddInfo(({"luminor", "herrscher", "turm"}),
            "Luminor ist der Herrscher dieses Turmes, ich haette "
            "ihn fast besiegt.", "sagt traurig: ");
  AddInfo("herrscher", "Luminor ist der Herrscher dieses Turmes, er hat "
                       "viele, die ihm dienen. Auch Kart dient ihm.", "sagt: ");
  AddInfo(({"warnen", "warnung"}),
            "Nehmt euch vor Kart in acht! Er hat mich hier gepfaehlt, "
            "aufgespiesst auf diesem Speer muss ich auf Erloesung warten.",
            "sagt wuetend: ");
  AddInfo(({"kart", "scheitern"}),
            "Kart der Pfaehler ist an meinem Scheitern schuld.",
            "jammert: ");
  AddInfo(({"pfaehler"}),
            "Diesen Spitznamen hat er sich wahrlich verdient. Auch mich hat "
            "er gepfaehlt. Als Warnung fuer all die, die mir folgen.",
            "sagt wuetend: ");
  AddInfo(({"erloesung"}),
            "Kannst Du mich nicht erloesen? Ich verrate Dir vorher auch "
            "Luminors Schwachpunkt. Auf dem Weg hierher habe ich ihn entdeckt.",
            "sagt: ");
  AddInfo(({"weg"}),
            "Du bist bereits an Luminors Schwachpunkt vorbeigekommen.",
            "sagt: ");
  AddInfo(({"speer"}),
            "auf den Speer, der ihn aufrecht haelt.",
            "deutet wortlos ");
  AddInfo(({"schwachpunkt"}),
            "Luminor bezieht seine Kraft aus einer magischen Flamme.",
            "sagt: ");
  AddInfo(({"kraft"}),
            "Diese Flamme macht ihn unglaublich stark.",
            "seufzt: ");
  AddInfo(({"flamme", "lebensflamme"}),
            "Ich habe jedoch eine Moeglichkeit gefunden, sie zu schwaechen.",
            "kichert irre: ");
  AddInfo(({"moeglichkeit", "lage"}),
            "Es gibt drei Phiolen mit magischem Eiswasser. Dieses Eiswasser "
            "ist als einziges in der Lage, Luminors Lebensflamme zu schwaechen.",
            "sagt: ");
  AddInfo(({"eiswasser", "phiole", "phiolen"}),
            "Ich habe leider nicht alle gefunden. Es gibt in fast jedem Stockwerk "
            "eine zu finden.",
            "sagt betruebt: ");
  AddInfo(({"stockwerk"}),
            "Hier im dritten Stockwerk habe ich keine gesehen.",
            "sagt: ");


  SetProp(P_SPELLRATE,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Leiche kann Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    Name()+" windet sich auf dem Speer.\n", 
    Name()+" sagt: Buh!\n",
    Name()+" kichert irre.\n"}) );

  SUID;

}