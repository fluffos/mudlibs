inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  create_default_dragon(5,1,0,5);
  SetProp(P_SHORT, "Ein junger roter Drache");
  SetProp(P_NAME, "Drache");
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_FIRE: -1.0]));
  AddId("drache");
  SetProp(P_NAME_ADJ, ({"jung", "rot" }));
  SetProp(P_LONG,
      "Dieser junge rote Drache ist der Beschuetzer von Luminors Flamme. "
      "Nur aufgrund seines geringen Alters konnte Luminor ihn unter seine "
      "Herrschaft zwingen.");
  SetProp(P_SPELLRATE, 40);
  AddSpell(2,1,
    Name()+" ruft einen Feuerdaemon herbei!!!\n",
    Name()+" ruft einen Feuerdaemon herbei!!!\n",
    DT_BLUDGEON, "call_help");
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt den Luminordrachen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Luminordrache hat "+CAP(getuid(player))+" umgebracht.\n");
}

void init()
{
  ::init();
  if(TP && TP->id("feuerdaemon")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void call_help(object enemy,int damage,string damtype)
{
  object feuerdaemon;

  if(present("feuerdaemon", ENV(TO)))
  {
  	return; // nur ein Feuerdaemon
  }

  feuerdaemon=clone_object(NPC "fdaemon");

  if(feuerdaemon && ENV(TO))
  {
    feuerdaemon->move(ENV(TO),M_GO|M_SILENT);
  }
  else
  {
    feuerdaemon->remove();
  }

  return;

}