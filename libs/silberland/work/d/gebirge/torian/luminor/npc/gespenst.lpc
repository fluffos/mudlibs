inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gespenst");
  SetProp(P_LONG,
    "Dies ist ein Geist eines Abenteurers der es bis zu Spitze von "
    "Luminors Turm gebracht hat. Luminor hat ihn unter seine Herrschaft "
    "gezwungen, fortan muss er ihm dienen und weitere uebermuetige "
    "Abenteurer ranschaffen.");

  SetProp(P_NAME, "Gespenst");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"gespenst"}));

  AddClass(CL_UNDEAD);

  SetProp(P_GENDER, NEUTER);

  create_default_npc(25);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -600 - random(400));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,50);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " seufzt erleichtert.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.4, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -1.0
     , DT_HOLY:      0.4, DT_UNHOLY:   -1.0, DT_MAGIC:       0.4
     , DT_MIND:      0.0, DT_SLASH:    -1.0, DT_BLUDGEON:   -1.0
     , DT_PIERCE:   -1.0, DT_SQUEEZE:  -1.0, DT_WHIP:       -1.0
     , DT_RIP:      -1.0
     ])
  );

  AddInfo(DEFAULT_INFO, "grinst Dich boese an.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  SetProp(P_SPELLRATE,50);
  AddSpell(5,700,
    Name()+" greift in Deine Brust - Dein Herz bleibt fast stehen!\n",
    Name()+" greift in @WESSEN Brust!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(4,1, DS_ANTIMAGIC,
    Name()+" verwirrt Dich mit seinem Gesang!!\n",
    Name()+" verwirrt @WEN mit seinem Gesang!!\n");
  AddDefaultSpell(2,1000, DS_MASS_DAMAGE,
    Name()+" kreischt laut! Du wirst fast Wahnsinnig!!\n",
    Name()+" kreischt laut! @WER wird fast Wahnsinnig!!\n",
    DT_SOUND);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Gespenster koennen nichts tragen.\n" }) );

  SetAttackChats(2, ({
    "Das Gespenst kichert irre.\n",
    "Das Gespenst fliegt durch Dich hindurch.\n"}) );

  SUID;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt das Gespenst.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Das Gespenst hat "+CAP(getuid(player))+" umgebracht.\n");
}