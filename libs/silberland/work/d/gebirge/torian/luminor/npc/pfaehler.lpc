inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kart, der Pfaehler");
  SetProp(P_LONG,
    "Kart ist einer der treuesten Diener Luminors. Unzaehlige "
    "Abenteurer sind schon an ihm gescheitert. Nicht umsonst "
    "ist er der Waechter zu Luminors Raum. Huete Dich vor seinem Speer, den "
    "er in seinen kraeftigen Armen haelt! Von ihm hat er seinen Beinamen "
    "\"Der Pfaehler\".");

  SetProp(P_NAME, "Kart");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kart", "pfaehler", "waechter", "Speermeister"}));

  AddClass(CL_HUMAN);

  SetProp(P_GENDER, MALE);

  create_default_npc(30);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,40);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder und pfaehle Dich!!!");

  AddDetail(({"armen", "arme" }),
    "Seine Arme sind mit kraeftigen Muskeln ausgestattet.");
  AddDetail("muskeln",
    "Seine Arme sind sehr muskuloes.");
  AddDetail("speer",
    "Den Speer wird Kart bis zu seinem Tod festhalten.");
  AddDetail("beinamen",
    "Den Beinamen \"Der Pfaehler\" hat Kart sich wahrlich verdient!");

  AddInfo(DEFAULT_INFO, "grinst Dich boese an.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  SetProp(P_SPELLRATE,50);
  AddSpell(6,600,
    Name()+" versucht Dich aufzuspiessen!\n",
    Name()+" versucht @WEN aufzuspiessen!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2,800, DS_MASS_DAMAGE,
    Name()+" wirbelt seinen Speer um sich herum!!\n",
    Name()+" wirbelt seinen Speer um sich herum!!\n",
    DT_PIERCE);
  AddSpell(2,1000,
    Name()+" pfaehlt Dich!!!\n",
    Name()+" pfaehlt @WEN!!!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Kart grinst boese.\n" }) );

  SetAttackChats(2, ({
    "Kart versucht Dich zu pfaehlen!\n"}) );

  SUID;

  clone_object("/p/armour/boots/lederstiefel" )->move(TO);
  clone_object("/p/armour/armour/brustpanzer" )->move(TO);
  clone_object("/p/armour/helm/kampfhelm" )->move(TO);
  command("trage alles");
  clone_object(WEAPON "pfahl" )->move(TO);
  command("zuecke pfahl");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt den Pfaehler.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Pfaehler hat "+CAP(getuid(player))+" umgebracht.\n");
}