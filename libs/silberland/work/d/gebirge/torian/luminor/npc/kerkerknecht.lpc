inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kerkerknecht");
  SetProp(P_LONG,
    "Der Kerkerknecht bewacht den Kerker Luminors und kuemmert sich um das "
    "leibliche Wohl der Gefangenen. Seine Weste verbirgt kaum seinen dicken Bauch. "
    "Schweiss hat sich auf seinem ganzen Koerper gebildet, dadurch glaenzt seine Glatze "
    "im fahlen Licht. Er haelt schwere massive Ketten in seinen Haenden.");

  SetProp(P_NAME, "Kerkerknecht");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kerkerknecht", "knecht", "Kettenmeister"}));

  AddClass(CL_HUMAN);

  SetProp(P_GENDER, MALE);

  create_default_npc(20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -250 - random(100));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddDetail( ({"kerker", "luminor", "luminors" }),
    "Der Kerkerknecht bewacht den Kerker Luminors.");
  AddDetail( ({"wohl", "gefangene", "gefangenen" }),
    "Ob es den Gefangenen wirklich gut geht?");
  AddDetail( ({"bauch" }),
    "Der Kerkerknecht scheint sehr haeufig von seiner Suppe zu kosten, so dick wie er ist.");
  AddDetail( ({"schweiss", "bewegung" }),
    "Schon die kleinste Bewegung laesst den Kerkerknecht in Schweiss ausbrechen.");
  AddDetail( ({"koerper" }),
    "Sein gesamter Koerper ist mit Schweiss ueberdeckt.");
  AddDetail( ({"glatze", "licht" }),
    "Die Glatze glaenzt vor Schweiss im fahlen Licht.");
  AddDetail( ({"ketten", "haenden", "haende" }),
    "In seinen Haenden haelt er schwere massive Ketten.");

  SetProp(P_SMELL,
    "Der gesamte Koerper des Kerkerknechts stinkt nach Monate altem Schweiss.");

  SetProp(P_LOG_INFO, "/torian/luminor/kerkerknecht");

  AddInfo(DEFAULT_INFO, "starrt Dich nur boese an.\n");
  AddInfo("torian", "Mein Meister.","grinst daemonisch: ");
  
  AddInfo(({"kerker"}),
          "In dem Kerker befinden sich unsere Gefangenen.",
          "sagt: ");
  AddInfo(({"gefangenen", "gefangene"}),
          "Alle die wir einfangen und nicht sofort verfuettert werden "
          "landen hier.",
          "sagt: ");
  AddInfo(({"suppe"}),
          "Oh, die Suppe ist natuerlich fuer mich. Die Gefangenen duerfen "
          "heute fasten.",
          "sagt: ");
  AddInfo(({"turm"}),
          "Du befindest Dich in Luminors Turm.",
          "sagt: ");
  AddInfo(({"luminor", "herrscher", "herr"}),
          "Luminor ist der Herrscher dieses Turmes. Mein Herr ist unglaublich maechtig.",
          "sagt: ");

  SetProp(P_SPELLRATE,45);
  AddSpell(6,450,
    Name()+" schlaegt mit seinen Ketten auf Dich ein!\n",
    Name()+" schlaegt mit seinen Ketten auf @WEN ein!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
    Name()+" floesst Dir etwas aus seinem Kochtopf ein!!\n",
    Name()+" floesst @WEM etwas aus seinem Kochtopf ein!!\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kerkerknecht will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    Name()+" ruehrt seine Suppe um.\n"}) );
  SetAttackChats(2, ({
    Name()+" schreit: Willst Du von meiner Suppe kosten?\n"}) );

  SUID;

  clone_object("/p/armour/armour/weste" )->move(TO);
  command("trage alles");
  clone_object(WEAPON "kette" )->move(TO);
  command("zuecke kette");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt den Kerkerknecht.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Kerkerknecht hat "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "haut Dir eine mit seiner Kette runter.",
        "haut "+TP->name(WEN)+" eine mit seiner Kette runter.");
      TP->AddHp(-20);
      break;
    default :
      call_out("reaction", 0, TP,
        "ignoriert Dich voellig.",
        "ignoriert "+TP->name(WEN)+" voellig.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
