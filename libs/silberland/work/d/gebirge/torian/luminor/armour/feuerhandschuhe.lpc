inherit "std/armour";           // Ruestungsobjekt

#include <properties.h>
#include <combat.h>

// Fuer Druidenkrams
#include "/gilden/druidenzirkel/druiden_extern.h"

#include "../def.h"

string hands;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  hands = "";

  SetProp(P_SHORT, "Ein Paar Feuerhandschuhe");
  SetProp(P_LONG, 
    "Diese Handschuhe gehoerten einstmals Luminor dem schrecklichen "
    "Feuerdaemonen. Ehemals normale Lederhandschuhe sind sie "
    "nun vollkommen von seiner magischen Aura durchdrungen, jeder "
    "einzelne Finger ist von Flammenzungen umhuellt. Dennoch wird das "
    "verbliebene Leder nicht vom Feuer verzehrt.");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Die Elemente des Feuers sind sehr stark.");
  SetProp(P_PLURAL, 1);
  SetProp(P_NAME, "ein Paar Feuerhandschuhe");
  SetProp(P_ARTICLE, 0);
  
  AddId (({"handschuhe", "feuerhandschuhe"}));

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 4);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_FIRE:80, MAT_LEATHER:20]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:-5 ]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_MAGIC, 1);

// Druidenbonus
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 10);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, FEUER);

  AddDetail( ({ "luminor", "feuerdaemon", "daemon" }),
    "Diese Handschuhe gehoerten Luminor dem Feuerdaemon.");
  AddDetail( ({ "aura", "kraft" }),
    "Die ueberwaeltigende Aura Luminors hat diese Handschuhe mit magischer "
    "Kraft durchflutet.");
  AddDetail( ({ "finger", "flammenzungen" }),
    "Jeder einzelne Finger ist von Flammenzungen umhuellt.");
  AddDetail( ({ "leder", "feuer", "magie" }),
    "Das Leder wird nicht vom Feuer verzehrt, die Magie die in ihnen wohnt wird "
    "das wohl verhindern.");

}

// Beim anziehen Feuerschaden abkriegen
// Haende der Druiden in Feuerschaden umwandeln
int WearFunc()
{
  tell_object(TO, BS("Du verbrennst Dich leicht!"));
  SetProp(P_KILL_NAME, "Ein Paar Feuerhandschuhe" );
  TP->Defend(20+random(20), DT_FIRE, 1, TO);
  
  // Druidenhaende umsetzen

  if(TP->QueryProp(P_GUILD) == "druidenzirkel")
  {
    tell_object(TO, BS("Du spuerst die Macht der Feuerhandschuhe auf "
                      +"Dich uebergehen!"));
  }

  return 1;
}

// Haende zuruecksetzen
int RemoveFunc()
{

  if(TP->QueryProp(P_GUILD) == "druidenzirkel")
  {
    tell_object(TO, BS("Die Macht des Feuers zieht sich in die Handschuhe "
                      +"zurueck und beraubt Dich eines Teiles Deiner Kraft!!"));

    TP->AddSp(-20-random(30));
  }
  return 1;
}
