inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Schandmaske");
  SetProp(P_LONG,
    "Diese Schandmaske besteht aus geschwaerztem Eisen. Sie weist zwei "
    "schmale Augenschlitze und einen kleinen Schlitz fuer den Mund auf "
    "und bedeckt das Gesicht ansonsten voellig. Nase und Ohren sind uebergross "
    "dargestellt und verleihen der Maske ein laecherliches Aussehen.");

  AddId( ({"maske","schandmaske" }));

  SetProp(P_NAME, "Schandmaske");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10); // aehnlich Titanhelm
  SetProp(P_MATERIAL, ([MAT_IRON:95, MAT_LEATHER:5]));
  SetProp(P_VALUE, 1100);
  SetProp(P_WEIGHT, 1000);   

  AddDetail( ({ "eisen" }),
    "Das Eisen wurde geschwaerzt.");
  AddDetail( ({ "augenschlitze" }),
    "Zwei schmale Schlitze fuer die Augen wurden freigelassen, damit der "
    "Traeger der Maske seine Umgebung erkennen kann.");
  AddDetail( ({ "augen" }),
    "Da die Schlitze sehr schmal sind, kann man die Augen des Traegers "
    "hierdurch kaum sehen.");
  AddDetail( ({ "traeger" }),
    "Du kannst Dir die Maske ja mal aufsetzen.");
  AddDetail( ({ "umgebung" }),
    "Dank der Augenschlitze kann man mit einer solchen Maske seine "
    "Umgebung noch gut erkennen.");
  AddDetail( ({ "schlitz", "mundschlitz" }),
    "Der Schlitz fuer den Mund ist sehr klein und dient nur dazu, unter "
    "der Maske atmen zu koennen.");
  AddDetail( ({ "mund" }),
    "Durch den kleinen Mundschlitz kann man unter der Maske atmen.");
  AddDetail( ({ "gesicht" }),
    "Das Gesicht wird von der Maske voellig verdeckt.");
  AddDetail( ({ "ohren", "nase" }),
    "Nase und Ohren sind uebergross dargestellt.");
  AddDetail( ({ "aussehen" }),
    "Die Schandmaske verleiht dem Traeger ein wirklich laecherliches Aussehen.");

}