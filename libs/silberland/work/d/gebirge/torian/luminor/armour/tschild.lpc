inherit "/std/armour";

#include <combat.h>
#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Turmschild");
  SetProp(P_LONG,  
    "Dieser Schild ist so gross, dass sich sogar ein Troll dahinter verstecken "
    "kann. Der Turmschild besteht komplett aus Stahl. Er zeigt ein rotes "
    "Wappen mit einem Sonnensymbol. Als Zierschild ist er leider nicht so "
    "robust.") ;
  SetProp(P_NAME, "Turmschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "turmschild", "zierschild", SCHILD}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 20); // So Stark wie ein Bronzeschild
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 130);

  AddDetail( ({"stahl", "bau"}),
    "Bester Stahl wurde beim Bau von diesem Schild verwendet.");
  AddDetail( ({ "wappen" }),
    "Auf dem Wappen ist ein Sonnensymbol abgebildet.");
  AddDetail( ({ "sonnensymbol", "symbol" }),
    "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
    "Strahlen rundherum.");
  AddDetail( ({ "kreis" }),
    "Der Kreis mit den wellenfoermigen Strahlen soll die Sonne "
    "darstellen.");
  AddDetail( ({ "strahlen" }),
    "Wellenfoermige Strahlen sind um den Kreis herum abgebildet.");
  AddDetail( ({ "sonne" }),
    "Die Sonne gilt auch als Symbol fuer Feuer.");
 AddDetail( ({"troll"}),
      ([ 0: "Du koenntest Dich leicht hinter dem Schild verstecken.",
         "troll": "Sogar Du koenntest Dich hinterm dem Schild verstecken." ]) );
  AddDetail( ({ "feuer" }),
    "Die Sonne mit ihren gluehenden Strahlen steht fuer das niemals "
    "erloeschende Feuer.");
}