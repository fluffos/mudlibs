inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein schwarzer Anzug");
  SetProp( P_LONG,
     "Ein schwarzer Anzug in Trollgroesse. Er besteht komplett aus Seide. "
     "Man mag es fast nicht glauben, aber Trolle in diesem Anzug sehen "
     "wirklich modisch schick aus.");
  SetProp( P_NAME, "Anzug");
  SetProp( P_GENDER, MALE);
  AddId (({"anzug"}));
  
  SetProp( P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp( P_AC, 10);
  SetProp( P_MATERIAL, ([MAT_SILK:100 ]) );
  SetProp( P_WEIGHT, 150);
  SetProp( P_VALUE, 700 + random(200));
  SetProp( P_QUALITY_DECAY, 80);
  SetProp( P_WEAR_RESTRICTIONS, ([ SR_INCLUDE_RACE: "Troll" ]));
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:0]) );

  AddDetail( ({"seide", "haut", "gefuehl"}),
    "Die weiche Seide schmiegt sich sanft an die Haut an. Ein wundervolles Gefuehl.");
  AddDetail( ({"trolle", "troll", "trollgroesse"}),
    "Dieser Anzug in Trollgroesse macht aus jedem normalen Troll einen gut "
    "gekleideten Troll, den man zu jeder Gelegenheit mitnehmen kann.");
  AddDetail( ({"gelegenheit", "hochzeiten", "beerdigungen"}),
    "Gelegenheiten wie Hochzeiten oder Beerdigungen.");
}
