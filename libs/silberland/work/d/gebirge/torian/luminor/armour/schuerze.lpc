inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine blutverschmierte Schuerze");
  SetProp(P_LONG, 
    "Es ist ein alte, blutverschmierte Schuerze. Du willst gar nicht wissen "
    "wo das ganze Blut herkommt.");
  SetProp(P_NAME, "Schuerze");
  SetProp(P_NAME_ADJ, "blutverschmiert");
  SetProp(P_GENDER, FEMALE);
  AddId("schuerze");
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 75 );

  AddDetail( ({ "blut" }),
   "Du willst es wirklich nicht wissen!");

}

