#include "../def.h"

#include <ansi.h>

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  return;
}

int lvl_sort(object ob1, object ob2) {
  if (query_wiz_level(ob1)<query_wiz_level(ob2)) return 1;
  if (query_wiz_level(ob1)>query_wiz_level(ob2)) return 0;
  if ((ob1->query_real_name())<(ob2->query_real_name())) return 1;
  return 0;
}

// Wer befindet sich alles in Luminors Turm?
int luminorwho () {
  string s,fn;
  object *us;
  object ob,env;
  int i,sz;

  s="";

  sz=strlen(ROOM)-1;

  if (!TP || !IS_WIZARD(TP)) return 0;
  
  us=users();
  us=sort_array(us,"lvl_sort",ME);

  s="-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
   +"\n\n                             "
   +ANSI_BOLD+ANSI_YELLOW+"Luminors Castle"+ANSI_NORMAL+"\n\n";

  s+="Wizlvl\tLevel\t\Name\t\tRoom\n\n";
  for (i=0;i<=sizeof(us)-1;i++) 
  {
    ob=us[i];
    env=environment(ob);

    if (!env) continue;
        
    fn=file_name(env);

    if (fn[0..sz]!= ROOM ) continue;
    fn="~"+fn[sz..];
    s+=extract(sprintf("   %d ",query_wiz_level(ob)),-4,-1)+"\t";
    s+=ob->QueryProp(P_LEVEL)+"\t";
    s+=ANSI_YELLOW+(capitalize(ob->query_real_name())+ANSI_NORMAL" ...........")[0..18];
    s+=(" ["+fn+"]");
    s+="\n";

  }

  s+="\n-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
   +ANSI_NORMAL+"\n\n";
  
  write(s);
  
  return 1;
}

// Von Ronja, an meine Zwecke angepasst
void Msg(string s)
{
  object pl;
  int i;
  string str;

  write_file(LOG "luminor.log",ctime()+": "+s+".\n");

  pl = find_player("torian");

  if(objectp(pl) && interactive(pl) && IS_WIZARD(pl))
  {
    str = BSI(s+".","LUMINOR: ");
    if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
    tell_object(pl,str);
  }
  
}