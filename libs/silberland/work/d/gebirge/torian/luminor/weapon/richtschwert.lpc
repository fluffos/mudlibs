inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Richtschwert");
  SetProp(P_LONG,  
    "Dieses Richtschwert ist eine schwere Hiebwaffe mit einer breiten, "
    "unten leicht abgerundeten Klinge und einem kurzen, mit Leder "
    "umwickelten Griff. An einer Seite der Klinge wurden mit blutroter "
    "Schrift einige Worte eingraviert." );
  SetProp(P_NAME, "Richtschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"richtschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 160 + random(10)); // Aehnlich Breitschwert
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL :95, MAT_LEATHER: 5]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);
  SetProp(P_SIZE, 95);
  SetProp(P_QUALITY_DECAY, 110);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );

  AddDetail( ({ "hiebwaffe" }),
   "Aufgrund der abgerundeten Klinge und dem sehr kurzen Griff kann das "
   "Schwert nur als Hiebwaffe genutzt werden.");
  AddDetail( ({ "klinge" }),
   "Die Klinge ist sehr breit und an der Unterseite leicht abgerundet. "
   "Ein paar Worte wurden in die Klinge eingraviert.");
  AddDetail( ({ "unterseite" }),
   "Die Unterseite der Klinge wurde leicht abgerundet.");
  AddDetail( ({ "worte" }),
   "In blutroter Schrift wurden die Worte \"Cervices Scindo Malorum!\" in "
   "die Klinge eingraviert.");
  AddDetail( ({ "schrift" }),
   "Die Worte stehen in blutroter Schrift auf der Klinge.");
  AddDetail( ({ "griff", "schwertgriff" }),
   "Der Schwertgriff ist extrem kurz und man muss schon recht geschickt "
   "sein, um solch ein Schwert im Kampf gut ausbalancieren zu koennen.");
  AddDetail( ({ "kampf" }),
   "Fuer den Kampf ist dieses Schwert nur als Hiebwaffe geeignet.");
  AddDetail( ({ "leder" }),
   "Der kurze Griff wurde mit schwarzem Leder umwickelt.");
  AddDetail( ({ "seite" }),
   "An einer Seite der Klinge wurden einige Worte eingraviert.");

}