inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Pfahl");
  SetProp(P_LONG,  
    "Dies ist der Pfahl von Kart, dem Pfaehler. Mit ihm wurden schon "
    "unzaehlige unvorsichtige Abenteurer gepfaehlt. Ein Tod, den Du "
    "niemandem wuenschst.");
  SetProp(P_NAME, "Pfahl");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "pfahl"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:15, MAT_IRON:20, MAT_OAK:65]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 1300);
  SetProp(P_SIZE, 160 ); 
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:20]) );  
//  SetProp(P_INFO, "Auch Du kannst mit diesem Pfahl deine Gegner pfaehlen!);

  AddDetail("kart",
    "Mit diesem Pfahl hat sich Kart der Pfaehler seinen Namen verdient.");
  AddDetail("abenteurer",
    "Schon unzaehlige Abenteurer wurden mit diesem Speer gepfaehlt.");
  AddDetail("tod",
    "Solch einem Tod wuenschst Du niemandem.");

// AddCmd( ({ "pfaehle", "pfaehl" }), "cmd_pfaehlen" );


}
