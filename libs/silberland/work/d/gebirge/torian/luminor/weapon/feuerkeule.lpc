inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Feuerkeule");
  SetProp(P_LONG, 
    "Diese Keule ist ein primitive Waffe, die hauptsaechlich aus Knochen und "
    "Feuer besteht. Sie ist krumm und schief, dennoch kann man kraftvolle "
    "Hiebe mit ihr austeilen.");
  SetProp(P_NAME, "Feuerkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "feuerkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_FIRE }));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:60, MAT_FIRE:40]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 330);
  SetProp(P_SIZE, 80);
  SetProp(P_QUALITY_DECAY, 70 );
}

