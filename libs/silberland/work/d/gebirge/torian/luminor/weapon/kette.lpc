inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine lange Kette");
  SetProp(P_LONG,  
    "Diese Kette wird dazu verwendet, widerspenstige Gefangene zu fesseln. Sie besteht "
    "aus massivem Eisen. Mit ein wenig Uebung kann man sie auch als Waffe einsetzen, aehnlich "
    "einem Morgenstern oder Dreschflegel.");
  SetProp(P_NAME, "Kette");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":100, "Kettenmeister":200]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON: 100]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 1000);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 80);
  
  AddDetail( ({"gefangene"}),
    "Schon viele Gefangene wurden mit dieser Kette gefesselt.");
  AddDetail( ({"eisen"}),
    "Massivstes Eisen, niemand kann einfach solche Ketten sprengen.");
  AddDetail( ({"uebung", "waffe"}),
    "Mit ein wenig Uebung kann man die Ketten auch als Waffe einsetzen.");
  AddDetail( ({"morgenstern", "dreschflegel"}),
    "Die Ketten werden aehnlich einem Morgenstern oder Dreschflegel gehandhabt.");

}