
inherit "std/room";

#include "../def.h"

#define N ROOM "secondfloorB2"

int fackel, eiswasser;

create()
{
  ::create();

  fackel = DA;
  eiswasser = DA;

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einem Raum mit hunderten von Augen an den Waenden und der "
    "Decke wieder. Unentwegt beobachten Dich diese Augen. In einer Ecke des Raumes "
    "steht eine kleine Kiste.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_KILL_NAME, "Ein Blitzschlag" );

  AddDetail( ({ "raum" }),
    "Hunderte von Augen beobachten jede Deiner Bewegungen.");
  AddDetail( ({ "bewegungen" }),
    "Keine einzige Bewegung entgeht ihnen.");
  AddDetail( ({ "bewegung" }),
    "Auch nicht die kleinste.");
  AddDetail( ({ "augen" }),
    "Die Augen beobachten Dich!");
  AddDetail( ({ "waende", "wand" }),
    "Hunderte von Augen zieren die Waende in allen Groessen, Farben und Formen. Neben "
    "der Tuer kannst Du zwei Fackelhalter erkennen.");
  AddDetail( ({ "fackelhalter", "halter" }),
    "Neben der Tuer befinden sich zwei Fackelhalter mit jeweils einer Fackel darin. Sie "
    "scheinen aus Eisen zu bestehen.");
  AddSpecialDetail( ({ "fackel", "fackeln" }), "strFackel");
  AddSpecialDetail( ({ "lichtschein", "licht" }), "strLicht");
  AddDetail( ({ "eisen" }),
    "Du bist erstaunt, etwas so Normales wie Eisen hier zu finden.");
  AddDetail( ({ "normales" }),
    "Kein magisches, feuerwiderstehendes Metall.");
  AddDetail( ({ "metall" }),
    "Einfaches Eisen.");
  AddDetail( ({ "groessen" }),
    "Alle erdenklichen Groessen siehst Du. Von ganz kleinen Augen bis zu riesigen mehrere "
    "Handflaechen grossen Augen.");
  AddDetail( ({ "handflaechen", "handflaeche" }),
    "Einige Augen sind mehrere Handflaechen gross.");
  AddDetail( ({ "farben" }),
    "Alle moeglichen Farben sind vorhanden.");
  AddDetail( ({ "formen" }),
    "Von kleinen runden ueber grosse geschlitzte Augen ist alles dabei.");
  AddDetail( ({ "decke" }),
    "Die Augen an der Decke haben den besten Ueberblick. Ihnen entgeht bestimmt nichts.");
  AddDetail( ({ "ueberblick" }),
    "Von der Decke aus hat man den besten Ueberblick ueber den Raum.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke steht eine Kiste.");
  AddDetail( ({ "kiste" }),
    "Die Kiste ist nicht sonderlich gross und weist keine Besonderheiten aus.");
  AddDetail( ({ "besonderheiten" }),
    "Du kannst keine Besonderheiten wie versteckte Fallen oder aehnliche Gemeinheiten "
    "erkennen.");
  AddDetail( ({ "fallen" }),
    "Du bist Dir nicht sicher, ob es nicht doch eine gibt.");
  AddDetail( ({ "falle" }),
    "Du wirst genau beobachtet waehrend Du die Kiste genauer untersuchst.");
  AddDetail( ({ "gemeinheiten" }),
    "Dieser Turm haelt viele Gemeinheiten fuer Dich parat.");
  AddDetail( ({ "luminor", "herrscher" }),
    "Luminor ist der Herrscher dieses Turmes.");
  AddDetail( ({ "turm", "turmes" }),
    "Luminor hat die Herrschaft ueber diesen Turm uebernommen.");
  AddDetail( ({ "herrschaft" }),
    "Luminor herrscht ueber diesen Turm und alle Einwohner.");
  AddDetail( ({ "einwohner" }),
    "Oni, Gespenster, Feuertrolle. Sie alle gehorchen Luminor!");
  AddDetail( ({ "oni", "gespenster", "feuertrolle", "feuertroll" }),
    "Sie alle gehorchen Luminor!");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit Staub uebersaeht. Dieser Raum wird wohl nur sehr selten "
    "betreten.");
  AddDetail( ({ "staub" }),
    "In dem Staub kannst Du lediglich Deine eigenen Spuren erkennen.");
  AddDetail( ({ "spuren" }),
    "Die einzig erkennbaren Spuren stammen von Dir.");
  AddDetail( ({ "obsidian" }),
    "Feuer kann diesem Gestein nichts anhaben.");
  AddDetail( ({ "gestein" }),
    "Obsidian.");
  AddDetail( ({ "feuer" }),
    "Das allgegenwaertige Feuer ist hier nicht vorhanden.");
  AddDetail( ({ "weg" }),
    "Du wirst wohl einen anderen Weg finden muessen.");
  AddDetail( ({ "tuerklinke", "klinke" }),
    "Du suchst die gesamte Tuer ab, kannst aber keine Klinke entdecken.");
  AddDetail( ({ "tuerschloss", "schloss" }),
    "Du tastest die Tuer ab, findest aber kein Schloss.");
  AddDetail( ({ "zentrum" }),
    "Im Zentrum der Tuer befindet sich ein kleines Auge, welches Dich die ganze "
    "Zeit beobachtet.");
  AddDetail( ({ "auge" }),
    "Ob das kleine Auge im Zentrum der Tuer der Schluessel fuer diese ist?");
  AddDetail( ({ "schluessel" }),
    "Nur wie funktioniert dieser Schluessel?");
  AddDetail( ({ "zeit" }),
    "Du wirst die gesamte Zeit ueber beobachtet!");

  AddSound( DEFAULT_SOUND,
    "Es ist erschreckend still hier. Nicht einmal die schon fast vertrauten unheimlichen "
    "Geraeusche sind zu hoeren.");

  AddSound( ({ "still", "stille" }),
    "Dir ist sehr unwohl ob dieser Stille.");
  AddSound( ({ "geraeusche" }),
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Du hast fast erwartet, dass es hier nach Feuer riecht.");

  AddSmell( ({ "feuer" }),
    "Es riecht hier aber nicht nach Feuer.");

  AddRoomMessage( ({ "" }), 30, "Augen");

    NewDoor("norden", N , ({"tuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Tuer.",
      D_LONG, "Die Tuer besteht nahezu komplett aus Obsidian. Lediglich im Zentrum "
              "ist etwas anderes. Du kannst weder Tuerklinke noch Tuerschloss "
              "entdecken.",
      D_NAME,  "Tuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_CLOSETESTFUNC, "tuerschliessen",
      D_RESET_CLOSEMSG,
                  " ist zugefallen!\n"
    })
  );

  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "loesche", "loesch" }), "cmdloeschen" );
  AddCmd( "zuende|zuend|fackel&an", "cmdzuenden",
          "Was willst Du anzuenden?" );
  AddCmd( "oeffne&kiste", "cmdoeffnen",
          "Was willst Du denn oeffnen?" );
  AddCmd( "druecke|drueck&auge", "cmddruecken",
          "Was willst Du druecken?" );

}

// Die Tuer laesst sich nur mit dem Auge oeffnen
int tueroeffnen()
{
  write(BS("Ohne Klinke oder Schloss wird das nichts. Du wirst wohl einen anderen "
          +"Weg finden muessen."));
  return 1;
}

// Die Tuer laesst sich nicht schliessen
int tuerschliessen()
{
  write(BS("Du zerrst an der Tuer herum, schaffst es aber nicht sie zu schliessen!"));
  return 1;
}

string strFackel(string str)
{
  string s;
  if(fackel == AUS)
  {
    s = "Die Fackeln sind erloschen!";
  }
  else
  {
    s = "Die Fackeln brennen und werfen einen flackernden Lichtschein in "
       +"den Raum.";
  }
  return BS(s);
}

string strLicht(string str)
{
  string s;
  if(fackel == AUS)
  {
    s = "Die Fackeln sind erloschen und werfen kein Lichtschein in den Raum.";
  }
  else
  {
    s = "Der flackernde Lichtschein stammt von den Fackeln.";
  }
  return BS(s);
}

// Auge druecken
int cmddruecken(string str )
{
  object dest;
  call_other (N, "???", 0);
  dest = find_object(N);

  if (DOOR_MASTER->QueryDoorStatus(N)==D_STATUS_CLOSED)
  {
    write(BS("Du drueckst das Auge."));
    Message(BS(TP->Name()+" hantiert an der Tuer herum."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    Message(BS("Ploeztlich zieht sich das Auge zurueck und die Tuer oeffnet sich!"), MSGFLAG_VISUAL);
    
    if(dest)
    {
      dest->Message(BS("Die Tuer oeffnet sich ploetzlich."));
    }
    
    DOOR_MASTER->SetDoorStatus(N, D_STATUS_OPEN);
    return 1;
  }
  else 
  {
    write("Aber die Tuer ist doch schon offen?\n");
    return -1;
  }
}
// Staub wischen
int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staub weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt."));
  Message(BS(TP->Name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
            +"legt."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}


// Fackeln ausloeschen
int cmdloeschen(string str )
{
  notify_fail( "Was willst Du ausloeschen?\n" );
  if(-1 == member(({"fackeln aus","fackel aus", "fackeln", "fackel"}),str))
  { return 0; }
  
  if(fackel == AUS)
  {
    write(BS("Die Fackeln sind doch bereits aus?"));
    return -1;
  }
  else
  {
    write(BS("Du loeschst die Fackeln aus."));
    Message(BS(TP->Name()+" loescht die Fackeln aus.\n"),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    fackel = AUS;
    TO->SetProp(P_LIGHT, 0);
    return 1;
  }
}

// Anzuenden der Fackeln in den Halterungen.
int cmdzuenden(string str )
{
  if(fackel == AUS)
  {
    if(this_player()->QueryProp(P_SP) < 5)
    {
      write(BS("Du verfuegst nicht ueber genuegend Magie."));
      return -1;
    }
    write(BS("Mit einem kleinen Feuerball zuendest Du die Fackel an."));
    Message(BS(TP->Name()+" zuendet mit einem kleinen Feuerball die Fackel an."),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    this_player()->AddSp(-5);
    fackel = AN;
    TO->SetProp(P_LIGHT, 1);
    return 1;
  }
  else 
  {
    write("Aber die Fackeln brennen doch schon?\n");
    return -1;
  }
}

reset()
{
  ::reset();
  eiswasser = DA;
  if(fackel == AUS)
  {
    Message(BS("Ploetzlich entzuenden sich die Fackeln."),  
            MSGFLAG_VISUAL);
    fackel = DA;
    TO->SetProp(P_LIGHT, 1);
  }
}

int cmdoeffnen(string str)
{
  object myeiswasser;

  if((TO->QueryProp(P_TOTAL_LIGHT) > 0))
  {
    write(BS("Du versuchst die Kiste zu oeffnen. Ploetzlich schiesst aus einem der Augen "
            +"ein Blitzstrahl auf Dich herab."));
    Message(BS(TP->Name()+" versucht die Kiste zu oeffnen als ploetzlich ein "
            +"Blitzstrahl aus einem der Augen "
            +(PL->QueryProp(P_GENDER) == MALE ? "ihn": "sie")+" trifft."),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    TP->Defend(50+random(50), DT_LIGHTNING, 1, TO);
    return -1;
  }

  if(eiswasser == DA)
  {
    Message(BS(TP->Name()+" hantiert an der Kiste herum."),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    // Eiswasser reinmoven
    myeiswasser=clone_object(OBJ "eiswasser");
    if(ME_TOO_HEAVY==myeiswasser->move(TP,M_GET|M_SILENT))
    {
      write(BS("Du oeffnest die Kiste und entdeckst eine Phiole mit Eiswasser. "
              +"Leider ist sie Dir zu schwer, so dass Du sie in der Kiste laesst."));
      myeiswasser->remove();
      return -1;
    }
    else
    {
      write(BS("Du oeffnest die Kiste und nimmst eine Phiole mit Eiswasser heraus."));
      eiswasser = WEG;
      LUMINORMASTER->Msg(TP->Name()+": Eiswasser@Augen");
      return 1;    
    }

  }
  else
  {
    write(BS("Du oeffnest die Kiste, findest jedoch nichts. "
	        +"Irgendjemand ist Dir wohl zuvor gekommen."));
    Message(BS(TP->Name()+" hantiert an der Kiste herum."),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return -1;
  }
}

int Augen()
{
  string *messages;

  if(TO->QueryProp(P_TOTAL_LIGHT) > 0)
  {
    messages = ({"Du fuehlst Dich beobachtet!\n",
                 "Dir ist unwohl.\n",
                 "Du willst hier nur weg.\n",
                 "Eines der Augen blinzelt.\n",
                 "Ein Auge zwinkert Dir zu!\n",
                 "Die Augen verfolgen jede Deiner Bewegungen!!\n",
                 "Die Augen starren Dich an!\n" });
    TO->Message(messages[random(sizeof(messages)-1)], MSGFLAG_VISUAL);
    return 1;
  }
  else
  {
    messages = ({"Eines der Augen blinzelt verwirrt.\n",
                 "Die Augen starren ins Leere.\n",
                 "Die Augen nehmen Dich nicht wahr.\n",
                 "Ein Auge zwinkert.\n" });
    TO->Message(messages[random(sizeof(messages)-1)], MSGFLAG_VISUAL);
    return 1;
  }
}