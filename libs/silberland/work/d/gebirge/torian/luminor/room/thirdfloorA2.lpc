
inherit "std/room";

#include "../def.h"

#define O ROOM "thirdfloorB2"
#define N ROOM "thirdfloorA1"

int unrat;
int gewicht(string ding, object player);

create()
{
  ::create();

  unrat = DA;

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Turmspitze. Ueberall liegen Skelette und "
    "Leichen herum. Die Sued- und Westwand wurden mit merkwuerdigen "
    "Kritzeleien beschmiert. Im Osten fuehrt der Gang weiter ins "
    "Ungewisse, waehrend er im Norden zu einer Treppe fuehrt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "turmspitze" }),
    "Du hast die Turmspitze errreicht. Luminor, Dein endgueltiges Ziel, "
    "kann nicht mehr weit sein.");
  AddDetail( ({ "luminor" }),
    "Du naeherst Dich Luminor immer mehr.");
  AddDetail( ({ "ziel" }),
    "Oder ist Luminor doch nicht Dein Ziel?");
  AddDetail( ({ "skelette" }),
    "Weiss schimmern Dich die Knochen der Skelette an.");
  AddDetail( ({ "knochen" }),
    "Einige Knochen weisen Bissspuren auf.");
  AddDetail( ({ "bissspuren", "spuren" }),
    "Von einigen Knochen wurde das Fleisch fein saeuberlich abgenagt.");
  AddDetail( ({ "fleisch" }),
    "Du willst gar nicht daran denken ...");
  AddDetail( ({ "leichen" }),
    "Einige Leichen wurden gepfaehlt. Durch die langen Speere im Boden werden "
    "sie weiterhin aufrecht gehalten.");
  AddDetail( ({ "speere" }),
    "Lange Speere wurden im Boden befestigt. Sie werden zum Pfaehlen gefangener "
    "Abenteurer verwendet.");
  AddDetail( ({ "tode", "tod" }),
    "So moechtest Du wahrlich nicht sterben.");
  AddDetail( ({ "pfaehlen" }),
    "Pfaehlen ist einer der grausamsten Tode. Solch einen Tod wuenschst Du "
    "nichtmal Deinem schlimmsten Feind.");
  AddDetail( ({ "boden" }),
    "Einige Speere wurden in den Boden gerammt. Ueberall liegen Leichen, "
    "Knochen und verbeulte Ruestungen.");
  AddDetail( ({ "feind" }),
    "Solch einen Tod wuenschst Du nicht einmal ihm.");
  AddDetail( ({ "abenteurer" }),
    "Nur die mutigsten und staerksten Abenteurer schafften es bis hierher. "
    "Und dennoch endete fuer viele der Weg hier.");
  AddDetail( ({ "weg" }),
    "Dein Weg jedoch fuehrt noch weiter.");
  AddDetail( ({ "ruestungen" }),
    "Zwischen all dem Unrat erkennst Du auch einige verbeulte Ruestungen. "
    "Keine von ihnen scheint noch etwas zu nuetzen.");
  AddDetail( ({ "unrat" }),
    "Jede Menge Unrat liegt auf dem Boden zerstreut. Verbeulte Ruestungen, "
    "zerbrochene Waffen - Vielleicht findest Du ja doch noch etwas Brauchbares?");
  AddDetail( ({ "menge" }),
    "Jede Menge Unrat liegt zwischen den Leichen auf dem Boden.");
  AddDetail( ({ "etwas", "brauchbares" }),
    "Ohne suchen wird das aber nichts.");
  AddDetail( ({ "waffen" }),
    "Zwischen dem ganzen Unrat kannst Du einige zerbrochene Schwerter und "
    "zerrissene Peitschen ausmachen.");
  AddDetail( ({ "schwerter" }),
    "Keines ist ganz geblieben.");
  AddDetail( ({ "peitschen" }),
    "Von den Peitschen und Schwertern - einstmals maechtige Waffen - ist "
    "nicht viel uebrig geblieben.");
  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du denn genau?");
  AddDetail( ({ "ostwand", "osten" }),
    "Im Osten fuehrt der Gang weiter ins Ungewisse.");
  AddDetail( ({ "gang" }),
    "Wenn Du wissen moechtest was dort liegt, dann geh hin!");
  AddDetail( ({ "ungewisse" }),
    "Du wirst es nie erfahren, wenn Du nicht hingehst.");
  AddDetail( ({ "nordwand", "norden" }),
    "Im Norden liegt die Freiheit versprechende Treppe.");
  AddDetail( ({ "freiheit" }),
    "Wenn Du den Turm wieder verlassen moechtest, musst Du die Treppe im Norden "
    "verwenden.");
  AddDetail( ({ "turm" }),
    "Jede Deiner Bewegungen in diesem Turm wird genau ueberwacht.");
  AddDetail( ({ "bewegungen" }),
    "Luminor weiss genau, dass Du kommst.");
  AddDetail( ({ "treppe" }),
    "Die Treppe im Norden fuehrt wieder nach unten.");
  AddDetail( ({ "westwand", "suedwand" }),
    "Die West- und Suedwand sind mit roten Kritzeleien beschmiert.");
  AddDetail( ({ "kritzeleien" }),
    "Du bist Dir sicher, dass es Blut ist.");
  AddDetail( ({ "blut" }),
    "Die Kritzeleien wurden mit Blut an die Wand geschmiert. Mit Sicherheit "
    "war es das Blut der hier Gefallenen.");
  AddDetail( ({ "sicherheit" }),
    "Du bist Dir absolut sicher das es ihr Blut war.");
  AddDetail( ({ "blut" }),
    "Zugegeben, rote Farbe ist schwer zu bekommen.");
  AddDetail( ({ "farbe", "rot" }),
    "Das leuchtendste Rot hat nur Blut.");
  AddDetail( ({ "gefallenen" }),
    "Die Gefallenen haben ihr Blut nicht freiwillig gespendet.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir. Du kannst nicht genau erkennen, "
    "aus welchem Gestein sie besteht.");
  AddDetail( ({ "gestein" }),
    "Du kannst nicht genau bestimmen, welches Gestein es ist. Du bist Dir "
    "lediglich sicher, dass es kein Obsidiangestein ist.");
  AddDetail( ({ "obsidiangestein" }),
    "Nahezu das komplette Stockwerk unter Dir bestand aus Obsidian.");
  AddDetail( ({ "stockwerk" }),
    "Das Stockwerk unter Dir bestand nahezu komplett aus Obsidian.");
  AddDetail( ({ "feuer" }),
    "Du siehst keins.");
  AddDetail( ({ "obsidian" }),
    "Feuer kann diesem Gestein nichts anhaben.");
  AddDetail( ({ "nase" }),
    "Deine Nase muss hier ganz schoen was erdulden.");

  AddReadDetail( ({ "kritzeleien" }),
    "Du bist Dir nicht sicher was dort geschrieben steht. Nur wenige "
    "Teile kannst entziffern.");
  AddReadDetail( ({ "teile" }),
    "\"Deine Seele gehoert mir!\"");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das durchdringende Kreischen von Gespenstern.");

  AddSound( ({ "kreischen" }),
    "Dich schauderts.");
  AddSound( ({ "gespenster" }),
    "Bist Du ihnen schon begegnet?");

  AddSmell( DEFAULT_SMELL,
    "Die verwesenden Leichen verursachen bei Dir einen Brechreiz.");

  AddSmell( ({ "leichen" }),
    "Die Leichen verstroemen einen intensiven Verwesungsgeruch.");
  AddSmell( ({ "brechreiz" }),
    "Du haeltst Dir schnell die Nase zu.");
  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Dir wird schlecht.");

  AddExit( "osten", O );
  AddExit( "norden", N );

  AddItem( NPC "gespenst", REFRESH_DESTRUCT);
  AddItem( NPC "gespenst", REFRESH_DESTRUCT);

  AddCmd( "durchwuehle|wuehle|durchwuehl|wuehl|suche|durchsuche&unrat",
          "cmddurchsuchen",
          "Was willst Du durchwuehlen?" );

}

int cmddurchsuchen(string str)
{
  string s;
  s = "Du durchwuehlst den Unrat und entdeckst ";
  if(unrat == DA)
  {
    switch(random(4))
    {
      case 1: // Fackel
        if(gewicht("fackel", TP))
        {
          write(BS(s+"eine Fackel. Mit haengenden Schultern steckst Du sie ein."));
          break;
        }
      case 2: // Seil
        if(gewicht("seil", TP))
        {
          write(BS(s+"ein Seil. Unvorsichtigerweise steckst Du es ein."));
          break;
        }
      case 3: // Schaufel
        if(gewicht("schaufel", TP))
        {
          write(BS(s+"eine Schaufel. Vorsichtshalber steckst Du sie ein."));
          break;
        }
      case 0: // Etwas Geld
        TP->AddMoney(100);
        write(BS(s+"einen Berg voller Gold! "
              +"Du steckst die 100 Muenzen sofort ein."));
        break;
      default:
        write(BS("Du durchwuehlst den Unrat und findest sogar etwas. Leider "
                +"kannst Du es nicht mehr tragen!"));
        break;
    }
    Message(BS(TP->Name()+" durchwuehlt den Unrat."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    unrat = WEG;
    return 1;
  }
  else
  {
    write(BS("Du durchsuchst den gesamten Unrat, findest aber nichts "
            +"von Wert.")); 
    Message(BS(TP->Name()+" durchwuehlt den Unrat, wendet sich aber "
            +"enttaeuscht ab."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return -1;
  }
}

reset()
{
  ::reset();

  unrat = DA;

}

int gewicht(string ding, object player)
{
  object ob;
  ob=clone_object("/obj/"+ding);

  if(ME_TOO_HEAVY==ob->move(player,M_GET|M_SILENT))
    return 0;

  return 1;
}