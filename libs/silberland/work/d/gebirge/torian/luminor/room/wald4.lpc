#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Vor einem Turm");
  SetProp(P_INT_LONG,
    "Du brichst aus dem Unterholz hervor und schaust Dich schwer atmend um. "
    "Der Wald hat schlagartig aufgehoert und ist einem schaurigen alten "
    "Bauwerk gewichen. Vor Dir erhebt sich ein riesiger Turm, der bis jetzt "
    "scheinbar vom Wald verschluckt wurde. Ein mulmiges Gefuehl macht sich "
    "in Deiner Magengegend breit. Du bist Dir nicht sicher, ob es so klug "
    "war, hierher zu kommen."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "himmel" }),
    "Duester liegen die Wolken ueber Dir und lassen kaum Licht bis auf den "
    "Boden gelangen."
  );
  
  AddDetail( ({ "licht" }),
    "Es bricht gerade noch genug durch die dunklen Wolken, damit Du etwas "
    "sehen kannst."
  );
  
  AddDetail( ({ "wolken", "wolke" }),
    "Sie wirken bedrohlich. Sieht so aus, als wuerdest Du gleich ein Gewitter "
    "erleben."
  );
  
  AddDetail( ({ "gewitter" }),
    "Sie sehen Gewitterwolken wahrlich erstaunlich aehnlich. Sie werden von "
    "Minute zu Minute immer dunkler."
  );
  
  AddDetail( ({ "minute", "minuten" }),
    "Du bekommst zumindest den Eindruck."
  );
  
  AddDetail( ({ "eindruck" }),
    "Du schaust noch einmal hinauf, als ein Wassertropfen Dein Auge nur knapp "
    "verfehlt."
  );
  
  AddDetail( ({ "auge", "augen" }),
    "Das haette auch ins Auge gehen koennen!"
  );
  
  AddDetail( ({ "wassertropfen", "tropfen", "wasser" }),
    "Ein kleiner Schmerz durchzuckt Dein Gesicht, als Du den Wassertropfen "
    "auf Deiner Haut beruehren willst. Das war kein Wassertropfen, sondern "
    "ein Funke!"
  );
  
  AddDetail( ({ "gesicht", "es" }),
    "Du bist Dir sicher: Es ist noch da."
  );
  
  AddDetail( ({ "haut" }),
    "Die Haut schmerzt noch leicht an dieser Stelle, aber es ist nicht weiter "
    "tragisch."
  );
  
  AddDetail( ({ "schmerz" }),
    "Reiss Dich zusammen. Du bist ein Held oder?"
  );
  
  AddDetail( ({ "held" }),
    "Wenn Du keiner bist, solltest Du anfangen zu rennen. In diese Richtung."
  );
  
  
  AddDetail( ({ "richtung" }),
    "Du schaust zurueck in den Wald."
  );
  
  AddDetail( ({ "wald", "waelder" }),
    "Er liegt duester hinter Dir. Jetzt, da es ein wenig heller ist, "
    "scheinst Du im Wald selbst gar nichts mehr zu erkennen."
  );
  
  AddDetail( ({ "stelle" }),
    "Da hat Dich der Funke getroffen."
  );
  
  AddDetail( ({ "funke" }),
    "Ein grosses Feuer wirft Funken, doch Du kannst hier keines entdecken. "
    "Du ueberlegst. Der Funke kam vom Himmel. Sollte sich das Feuer auf dem "
    "Turm befinden?"
  );//Hinweis aufs dach, FP?
  
  AddDetail( ({ "feuer" }),
    "Wo ist es nur? Nicht in Deiner Naehe."
  );
  
  AddDetail( ({ "naehe" }),
    "naehe\nWas willst Du naehen?"
  );
  
  AddDetail( ({ "dach" }),
    "Du machst ein paar Schritte zurueck und schaus angestrengt hoch. Und "
    "tatsaechlich: Das ganze Dach des Turmes scheint in Flammen zu stehen. "
  );
  
  AddDetail( ({ "flammen", "flamme" }),
    "Du fragst Dich warum man das Feuer nicht schon eher gesehen hat. Warum "
    "es dort wohl brennt? Du hast so eine Ahnung ..."
  );
  
  AddDetail( ({ "schritte" }),
    "Fleissig zaehlen!"
  );
  
  AddDetail( ({ "ahnung" }),
    "Vielleicht haust dort oben ein... nein. Unmoeglich. Aber Du hast eine "
    "andere ... wie heisst das noch? Diese Kopfschmerzen mit Bildern?"
  );//idee, eingebung etc...
  
  AddDetail( ({ "kopfschmerzen", "schmerzen", "bilder" }),
    "Wie nennen das die schlauen Leute doch nochmal?"
  );
  
  AddDetail( ({ "leute", "schlaue leute" }),
    "Du willst dazu gehoren. Du ueberlegst."
  );
  
  AddDetail( ({ "idee", "eingebung" }),
    "Das Feuer dort oben scheint schon lange zu brennen, zumindest sagt Dir "
    "das Deine Ahnung. Es scheint keinen natuerlichen Ursprung zu haben."
  );
  
  AddDetail( ({ "ursprung" }),
    "Sonst haette es Doch schon vor Tagen der letzte Regen geloescht. Du "
    "solltest hier verschwinden."
  );
  
  AddDetail( ({ "tagen", "tage" }),
    "Zaehl lieber Schritte!"
  );
  
  AddDetail( ({ "regen" }),
    "Der wird bald kommen."
  );
  
  AddDetail( ({ "gewitterwolken", "gewitterwolke" }),
    "Du schaust sie Dir lieber durch Glas an. Da bleibt man so schoen "
    "trocken."
  );
  
  AddDetail( ({ "glas" }),
    "Ein Fenster waere gut."
  );
  
  AddDetail( ({ "fenster" }),
    "Fenster befinden sich fuer gewoehnlich in Haeusern oder Schloessern. "
    "Genau dort waerst Du jetzt auch gerne. Eigentlich ueberall - nur nicht hier."
  );
  
  AddDetail( ({ "haus", "haeuser", "haeusern" }),
    "In einem Haus waerst Du bei Regen am liebsten, oder in einem Schloss."
  );
  
  AddDetail( ({ "schloss", "schloessern", "schloesser" }),
    "My home is my castle ... oder so."
  );

  AddDetail( ({ "kante", "fensterkante" }),
    "Die Fensterkante."
  );
  
  AddDetail( ({ "boden" }),
    "Der Boden vor Dir besteht aus kniehohem Gras. Es ist noch frisch und "
    "scheint bis jetzt relativ unberuehrt. Du kannst auch keinen Weg "
    "erkennen."
  );
  
  AddDetail( ({ "knie" }),
    "Du schaust auf Deine Knie hinab und entdeckst nichts. Schade."
  );//FP? :-)
  
  AddDetail( ({ "weg" }),
    "Es ist keiner da. Auch das Gras ist nirgendwo plattgedrueckt. Du "
    "findest keine Anzeichen dafuer, dass hier in letzter Zeit Jemand war."
  );
  
  AddDetail( ({ "gras" }),
    "Es ist gruen und scheint hier gut zu wachsen. Sehr viel entdeckst Du "
    "allerdings nicht. Hinter Dir beginnt der Waldboden und einige Meter "
    "vor Dir beginnt der Turm."
  );
  
  AddDetail( ({ "anzeichen" }),
    "Keine da."
  );
  
  AddDetail( ({ "zeit" }),
    "Unwichtig. Wer braucht das schon!"
  );
  
  AddDetail( ({ "jemand" }),
    "Die zaehlen nicht, DIE testen eh nur! :-)"
  );
  
  AddDetail( ({ "die", "engel" }),
    "Die gelben Engel."
  );
  
  AddDetail( ({ "waldboden" }),
    "Du musst den Wald schon betreten, wenn Du ihn ernsthaft untersuchen "
    "willst."
  );
  
  AddDetail( ({ "meter" }),
    "-> - <- Das ist ein Meter. (Und ein ungluecklicher Massstab)."
  );
  
  AddDetail( ({ "massstab", "stab" }),
    "Ein Massstab weint bitterlich."
  );
  
  AddDetail( ({ "baeume", "baum" }),
    "Die Baeume ragen hinter Dir auf. Die wiederstehst dem Verlangen Dich "
    "umzudrehen."
  );
  
  AddDetail( ({ "verlangen" }),
    "Du hast den Wald hinter Dir gelassen. Konzentrier Dich auf den Turm, "
    "und nicht auf die Gefahren des Waldes."
  );
  
  AddDetail( ({ "gefahren", "gefahr" }),
    "Geschichten von Raeubern und anderen Gesindel machen die Runde."
  );
  
  AddDetail( ({ "raeuber", "gesindel" }),
    "Sie behutsam!"
  );
  
  AddDetail( ({ "runde" }),
    "Manchmal auch eine Ovale."
  );
  
  AddDetail( ({ "ovale" }),
    "Meisst aber doch die Runde."
  );
  
  AddDetail( ({ "geschichten", "geschichte" }),
    "Wenn Du selber noch welche erzaehlen willst, musst Du vorsichtig sein."
  );
  
  AddDetail( ({ "unterholz" }),
    "Die Buesche im Wald sind damit gemeint."
  );
  
  AddDetail( ({ "buesche", "busch" }),
    "Du musstest Dir Deinen Weg hierher bahnen. Die Buesche waren nicht "
    "gerade hilfreich gewesen."
  );
  
  AddDetail( ({ "holz" }),
    "Die Baeume bestehen daraus."
  );
  
  AddDetail( ({ "gefuehl" }),
    "Renn weg!"
  );
  
  AddDetail( ({ "magen", "magengegend", "gegend" }),
    "Der hat Dich noch nie im Stich gelassen."
  );
  
  AddDetail( ({ "stich" }),
    "Ausser morgens, mittags und abends ... und in den Pausen dazwischen."
  );
  
  AddDetail( ({ "pause", "pausen" }),
    "Jetzt nicht!"
  );

  AddDetail( ({ "bauwerk", "werk" }),
    "Damit ist der Turm gemeint."
  );  
  
  AddDetail( ({ "turm" }),
    "Er ist alt. Unbeschreiblich alt. Er hat bestimmt eine interessante "
    "Entstehungsgeschichte, wenn man bedenkt, dass er hier so versteckt "
    "im Wald liegt. Seine Waende wirken irgendwie bedrohlich."
  );
  
  AddDetail( ({ "entstehungsgeschichte" }),
    "Du glaubst, Dich an sie zu erinnern. Irgendwo in einer Kneipe hast Du "
    "sie neulich gehoert."
  );
  
  AddDetail( ({ "kneipe" }),
    "Irgendein reicher Zwerg muss ihn frueher erbaut haben."
  );
  
  AddDetail( ({ "zwerg", "zwerge" }),
    "Besser gesagt, erbaut haben lassen. In der Vergangenheit war Sklaverei "
    "noch ueblich (ja, auch bei Zwergen!) und so mussten viele Trolle "
    "fuer dieses wahnsinnige Bauwerk herhalten."
  );
  
  AddDetail( ({ "vergangenheit" }),
    "Die ist vorbei."
  );
  
  AddDetail( ({ "sklaverei", "sklaven", "sklave", "gedanken", "gedanke" }),
    "Du schuettelst den Gedanken ab."
  );
  
  AddDetail( ({ "trolle", "troll" }),
    "Sie mussten die Steinbloecke mit Karren heranfahren und aus ihnen den "
    "Turm, unter der Anleitung des Zwerges, errichten."
  );
  
  AddDetail( ({ "steinbloecke", "steinblock", "bloecke", "block" }),
    "Der Turm besteht heute noch aus ihnen."
  );
  
  AddDetail( ({ "karren" }),
    "Was fuer eine schreckliche Arbeit."
  );
  
  AddDetail( ({ "arbeit" }),
    "Der Zwerg war wirklich grausam. Aber vermutlich wird man so, wenn man "
    "reich ist. Denn nur fuer seine Reichtuemer lies er den Turm errichten."
  );
  
  AddDetail( ({ "anleitung" }),
    "Einfache Arbeit."
  );
  
  AddDetail( ({ "reichtuemer" }),
    "Doch der Turm wurde verflucht, und die Reichtuemer zerfielen. Der Zwerg"
    " verschwand einfach. Doch Du hast auch noch gehoert, der Turm sei "
    "trotzdem nicht unbewohnt..."
  );
  
  AddDetail( ({ "waende", "wand" }),
    "Eigentlich ist es eine Wand, denn der Turm ist rund. Sie sind alt, und "
    "unter dem broeckelnden Putz erkennt man schon die Grundmauern. Dennoch"
    " scheint er bis jetzt zu halten. Du erkennst ein Tor."
  );
  
  AddDetail( ({ "putz", "risse", "riss" }),
    "Viele Risse durchziehen den Putz."
  );
  
  AddDetail( ({ "grundmauern", "mauern", "grundmauer", "mauer" }),
    "Stabil."
  );
  
  AddDetail( ({ "tor" }),
    "Einer der Fluegel steht offen."
  );
  
  AddDetail( ({ "fluegel" }),
    "Du ueberlegst. Du koenntest den Turm betreten."
  );

  AddDetail( ({ "das" , "doch" , "ich", "und",  "was" }),
    "Uebertreibe es nicht."
  );

  AddSound( DEFAULT_SOUND,
    "Unheimliche Geraeusche klingen aus dem Turm heraus."
  );

  AddSound( ({ "geraeusche", "turm" }),
    "Wenn Du wirklich wissen willst woher sie stammen, wirst Du wohl oder "
    "uebel den Turm betreten muessen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ueberall nach Feuer! Hilfe! Lauf, so schnell Du kannst!"
  );

  AddSmell( ({ "feuer" }),
    "Lauf weg!"
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "bahne", "bahn", "betrete", "betritt", "betret" }), "cmd_bahnen" );

//--Ausgaenge--------------------------------------------------------------

//  AddExit( "osten", "nach Osten#" + "./wald3" );
  AddExit( "rein", "in den Turm#" + "./erdgB2" );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_bahnen(string str)
{
  int schaden;
  string s;

  notify_fail("Wodurch willst Du Dir einen Weg bahnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "weg" ||
       str == "weg nach westen" ||
       str == "weg durch buesche" ||
       str == "weg durch busch"   ||
       str == "wald" )) return 0;

  if(IS_LEARNER(TP))
  {
    TP->move(ROOM "wald3", M_NO_SHOW|M_NOCHECK,
       "sich einen Weg durch die Buesche",
       "bahnt",
       "bahnt sich einen Weg herein");
       
    LUMINORMASTER->Msg("Learner "+TP->Name()+" bahnt sich den Weg zum Turm!");
    
    return 1;
  }

  if(!TP->do_exhaust(400+random(300))) 
  { 
  	write(BS("Du bist zu erschoepft, um Dir einen Weg durch die dornigen "
  	        +"Buesche bahnen zu koennen!"));
  	return -1; 
  }

  switch(random(100))
  {
    case 0..65:
      s = "Dabei zerkratzt Du Dir leicht das Gesicht.";
      schaden = 20;
      break;
    case 66..95:
      s = "Leider hast Du einige dicke Dornen uebersehen.";
      schaden = 50;
      break;
    default:
      s = "Ausgerechnet den Busch mit den meisten Dornen suchst Du Dir aus.";
      schaden = 100;
      break;
  }

  SetProp(P_KILL_NAME, "Dornen" );  

  write(BS("Du bahnst Dir einen Weg durch die Buesche. "+s));
  schaden = schaden+random(20);
  TP->do_damage(schaden, TO);
  
  if(!TP->QueryProp(P_GHOST))
  {
    call_other (ROOM "wald3", "???", 0);
    TP->move(ROOM "wald3", M_NO_SHOW|M_NOCHECK,
        "sich einen Weg durch die Buesche",
        "bahnt",
        "bahnt sich einen Weg herein");
  }
  
  LUMINORMASTER->Msg(TP->Name()+" bahnt sich den Weg zurueck! Schaden: "+schaden);
  
  return 1;
}
