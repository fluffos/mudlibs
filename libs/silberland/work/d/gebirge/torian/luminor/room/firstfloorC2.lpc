// Schild ueber den Abgrund gelegt?
string _query_int_long()
{
  string s;

  s = "Auf einem kleinen Marmorpodest steht eine Kiste. Erstaunlich, dass eine solche Kiste "
     +"vollkommen unbewacht sein soll. Im Westen ";

  if(testschild())
    s += "gelangt man sicher, dank dem Turmschild, ueber den Abgrund zurueck.";
  else
    s += "gaehnt ein Abgrund mit vielen angespitzten Holzpfloecken.";

  return BS(s);
}

// falls jemand seine Sachen von unten will
int cmdklettern(string key)
{
  object raum;
  write(BS("Du kletterst in den Abgrund hinunter, rutschst dabei aber leider aus."));
  call_other (ABGRUND, "???", 0);
  raum = find_object(ABGRUND);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "in den Abgrund",
                     "stuerzt", "stuerzt herein");
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
  }
  SetProp(P_KILL_NAME, "Ein Sturz in den Abgrund" );
  TP->do_damage(20+random(20), this_object());

  return 1;
}

//Weg frei?
int exit_test(string dir)
{

  if(!TP)              return 0;
  if(!interactive(TP)) return 0;

  if(!testschild())
  {
    fktabgrund(TP);
    return 0;
  }

  return 1;
}

// Hilfsfunktion fuer den Abgrund
void fktabgrund(object player)
{
  object raum;
  string s;
  int schaden;

  switch(random(4))
  {
    case 0:
      s = "keinen Holzpfloecken aufgespiesst! Du prallst lediglich hart auf, "
         +"Glueck gehabt.";
      schaden = 0;
      break;
    case 1:
      s = "einigen Holzpfloecken aufgespiesst!";
      schaden = 50;
      break;
    case 2:
      s = "vielen Holzpfloecken aufgespiesst!!";
      schaden = 100;
      break;
    default:
      s = "sehr vielen Holzpfloecken aufgespiesst!!!";
      schaden = 150;
      break;
  }
  
  SetProp(P_KILL_NAME, "Ein Sturz in den Abgrund" );  

  write("\nDu stuerzt in die Tiefe und wirst von "+s+"\n\n");
  player->do_damage(schaden+random(50), this_object());

  call_other (ABGRUND, "???", 0);
  raum = find_object(ABGRUND);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "in den Abgrund",
                     "stuerzt", "stuerzt herein");
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
  }
  return;
}


// Hilfsfunktion fuer die Fallen
void fktfalle(object player)
{
  string s,s2,killer,typ;
  int schaden;

  switch(random(3))
  {
    case 0:
      s = "Ploetzlich brechen einige Marmorbrocken aus der Decke!!!";
      s2 = "Ploetzlich brechen einige Marmorbrocken aus der Decke und treffen "
          +player->Name(WEN)+"!";
      killer = "Einige Marmorbrocken";
      schaden = 50;
      typ = DT_BLUDGEON;
      break;
    case 1:
      s = "Aus der Kiste schlaegt ein Blitzschlag in Dich ein!!!";
      s2 = "Aus der Kiste schlaegt ein Blitzschlag in "
          +player->Name(WEN)+" ein!!!";
      killer = "Ein Blitzschlag";
      schaden = 80;
      typ = DT_LIGHTNING;
      break;
    default:
      s = "Aus den Waenden schiessen Speere, die Dich aufspiessen!!!";
      s2 = "Aus den Waenden schiessen Speere, die "
           +player->Name(WEN)+" aufspiessen!!!";
      killer = "Vergiftete Speere";
      schaden = 100;
      typ = DT_PIERCE;
      break;
  }
  
  SetProp(P_KILL_NAME, killer );  
  tell_object(player,BS(s));
  TO->Message(BS(s2), MSGFLAG_NO_TP|MSGFLAG_VISUAL);
  player->Defend(schaden+random(50), typ, 1, TO);

  return;
}

// Ueber den Abgrund springen
int cmdspringen(string str)
{
  object raum;
  string race, s;
  race = TP->QueryProp(P_RACE);
 
  // Wenn das Schild bereits da ist besteht kein Grund noch zu springen
  if(testschild())
  {
     s = "Irgendwer hat ein grosses Turmschild ueber den Abgrund gelegt, es besteht "
        +"kein Grund noch zu springen.";
     write(BS(s));
     return 1;
  }

  switch(race)
  {
    case "Dunkelelf" :
    case "Mensch" :
    case "Elf" :
      if(random(2))
      {
        write(BS("Du schaffst es leider nicht ueber den Abgrund!"));
        fktabgrund(TP); // hilfsfunktion fuers abstuerzen
        return 1;
      }
      else
      {
        write(BS("Du schaffst es gerade so ueber den Abgrund!"));
      }
     break;
    case "Hobbit" :
    case "Zwerg" :
      write("Du koenntest auch einfach in den Abgrund klettern.");
      return 1;
    case "Troll" :
    case "Oger" :
      write(BS("Du springst locker ueber den kleinen Abgrund."));
      break;
    case "Fee" :
      write(BS("Springen? Und was machen Deine Fluegel dabei?"));
      return 1;
    default :
      write(BS("Was fuer eine Rasse bist Du denn? Sollte Torian Deine Rasse "
               +"tatsaechlich uebersehen haben, wende Dich doch bitte kurz an ihn."));
      return 1; 
  }
  // spieler moven
  call_other (W, "???", 0);
  raum = find_object(W);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "ueber den Abgrund",
                     "springt", "springt herein");
    return 1;
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
    return -1;
  }
}

// Ueber den Abgrund fliegen
int cmdfliegen(string str)
{
  object raum;
  string race;

  // Feen koennen
  if(TP->QueryProp(P_RACE)=="Fee")
  {
    write(BS(""));
    // spieler moven
    call_other (W, "???", 0);
    raum = find_object(W);
    if(raum)
    {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "ueber den Abgrund",
                       "fliegt", "fliegt herein");
      return 1;
    }
    else
    {
      write("Fehler! Bitte melde ihn an Torian.\n");
      return -1;
    }
  }
 
  // Rest nicht ...
  // Wenn das Schild bereits da ist ...
  write(BS("Du breitest Deine Arme aus und ..."));
  if(testschild())
  {
     write(BS("... knallst voll auf das Schild!"));
     return 1;
  }
  else
  {
    fktabgrund(TP); // hilfsfunktion fuers abstuerzen
  }
}

int cmdoeffnen(string str)
{
  string s;
  s = "";

  notify_fail( "Was willst Du oeffnen?\n" );
  if((str=="kiste"))
  {
    write(BS("Du versuchst, Die Kiste zu oeffnen."));
    Message(BS(TP->Name(WER)+" macht sich an der Kiste zu schaffen."),
                MSGFLAG_NO_TP) ;
    fktfalle(TP);
    return -1;
  }
  
  switch(correct_symbol)
  {
    case "Feuersymbol":
      s = "... unbezwingbar heiss ...\n\n";
      break;
    case "Onisymbol":
      s = "... gehoernter Schrecken ...\n\n";
      break;
    case "Gargylsymbol":
      s = "... steinerne Unwesen ...\n\n";
      break;
    default: // "Eis"
      s = "... erfrorener Krieger ...\n\n";
      break;
  }

  if((str=="hand"))
  {
    write("Mit Mueh und Not schaffst Du es, die Hand ein wenig "
         +"zu oeffnen. Du entdeckst einen kleinen zerfetzten Zettel. "
         +"Nur Bruchstuecke sind noch zu lesen.\n\n"
         +s
         +"Was das wohl zu bedeuten hat?\n");

    Message(BS(TP->Name(WER)+" macht sich an der Hand zu schaffen."),
                MSGFLAG_NO_TP) ;

    return 1;
  }
  return 0;
}

void setSymbols()
{
  correct_symbol = symbole[random(sizeof(symbole)-1)];
}

reset()
{
  ::reset();

  setSymbols();
  eiswasser = DA;
}

// Hilfsfunktion zum testen ob das Schild ueber dem Abgrund liegt
int testschild()
{
  object obj;
  call_other (W, "???", 0);
  obj = find_object(W);
  if(obj)
  {
    return obj->QuerySchild();
  }
  else
  {
    return WEG; // wenns den raum net gibt kanns auch kein schild geben
  }
}


// Schild ueber den Abgrund legen -> einfach westen gehen danach
int cmdlegen(string str)
{
  object myschild;
  object dest;
  notify_fail( "Was willst Du wohin legen?\n" );
  if(!(str=="schild ueber abgrund") && !(str =="turmschild ueber abgrund")) return 0;
  
  myschild = present(SCHILD, TP);
  if(!myschild)
  {
    write(BS("Du hast gar kein passendes Schild!"));
    return -1;
  }
  
  if(!testschild())
  {
    write(BS("Du legst das Turmschild ueber den Abgrund. Nun kannst Du einfach "
            +"nach Westen gehen."));
    TO->Message(BS(TP->Name()+" hantiert am Abgrund herum."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);          
    myschild->remove();

    call_other (W, "???", 0);
    dest = find_object(W);
    if(dest)
    {
      dest->SetSchild();
      dest->Message("Jemand legt von der anderen Seite ein Schild ueber den Abgrund.\n", MSGFLAG_VISUAL);
    }
    else // sollte nicht vorkommen ...
    {
      TO->Message(BS("Ploetzlich faellt das Schild in den Abgrund."), MSGFLAG_VISUAL);          
    }
  }
  else
  {
    write(BS("Aber dort liegt doch schon ein Schild ueber dem Abgrund?"));
  }

  return 1;
}

string strSchild(string key)
{
  if(testschild())
  return BS("Irgendwer hat ein grosses Turmschild ueber den Abgrund gelegt. Du kannst "
           +"nun einfach noch Westen gehen.");

  return "Sowas siehst Du da nicht!\n";

}

int cmdberuehren(string str)
{
  object myeiswasser;

  notify_fail( "Welches Symbol willst Du beruehren?\n" );
  
  if(!str || str == "") return 0;
  
  if(member(symbole, capitalize(str)) !=-1)
  {

    Message(BS(TP->Name(WER)+" macht sich an der Kiste zu schaffen."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP) ;

    if(capitalize(str) == correct_symbol)
    {
      if(eiswasser == DA)
      {
        // Eiswasser reinmoven
        myeiswasser=clone_object(OBJ "eiswasser");
        if(ME_TOO_HEAVY==myeiswasser->move(TP,M_GET|M_SILENT))
        {
          write(BS("Du beruehrst das "+correct_symbol+". Die Kiste oeffnet sich "
           +"und Du erkennst eine blaeulich schimmernde Phiole auf einem "
           +"Samtkissen. Leider wuerde sie Dir zu schwer werden, daher "
           +"laesst Du die Phiole liegen und schliesst die Kiste wieder."));
          
          myeiswasser->remove();
          return -1;
        
        }
        else
        {
          write(BS("Du beruehrst das "+correct_symbol+". Die Kiste oeffnet sich "
           +"und Du erkennst eine blaeulich schimmernde Phiole auf einem "
           +"Samtkissen. Schnell nimmst Du sie an Dich, bevor sich die "
           +"Kiste wieder schliesst."));
          eiswasser = WEG;
          LUMINORMASTER->Msg(TP->Name()+": Eiswasser@Kiste");
          return 1;    
        }
      }
      else
      {
        write(BS("Du beruehrst das "+correct_symbol+". Die Kiste oeffnet sich "
	 +"und Du erkennst ein leeres Samtkissen. Da war wohl schon jemand "
	 +"vor Dir da."));
        return -1;
      }
    }
    else
    {
      write(BS("Du beruehrst das "+capitalize(str)+"."));
      fktfalle(TP);
      return -1;
    }
  }
  return 0;
}