  AddCmd( "stecke|steck&pfeile|pfeile&in&loecher", "cmdstecken",
          "Was willst Du wohin stecken?|Was willst Du WOHIN stecken?" );

}

//Falls Gargylen nicht zerstoert ...
int exit_test(string dir)
{
    int schaden;
    
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    if(IS_LEARNER(TP)) return 1;

    if(present("marmorgargyl"))
    {
      write(BS("Der Marmorgargyl laesst Dich nicht passieren!"));
      say(BS(TP->Name()+" wird von einem Marmorgargyl aufgehalten!"));
      return 0;
    }
    if(gargyl == DA)
    {
      write(BS("Die Marmorgargylen breiten ihre Schwingen aus und greifen Dich an!"));
      AddItem( NPC "marmorgargyl", REFRESH_NONE);
      AddItem( NPC "marmorgargyl", REFRESH_NONE);
      AddDetail( ({ "haufen", "steine" }),
        "Von den Gargylen ist nicht mehr viel uebrig, lediglich ein Haufen Steine.");

      RemoveDetail( "augen");

      gargyl = WEG;
      return 0;
    }
    
    if(falle == DA)
    {
      write("\nDu loest die Falle aus!!!\nViele Speere schiessen aus dem Boden und "
           +"verletzen Dich!\n\n");
      schaden = 50+random(50);
      TP->do_damage(schaden, this_object());
      LUMINORMASTER->Msg(TP->Name()+" loest die Speerfalle aus! Schaden: "+schaden);
    }
    return 1;
}

// Falle entschaerfen
int cmdentschaerfen(string str )
{
  write(BS("Wie moechtest Du die Falle genau blockieren oder entschaerfen?"));
  return 1;
}

// Falle blockieren
int cmdblockieren(string str )
{
  write(BS("Um die Falle blockieren zu koennen, muesstest Du schon etwas in die "
          +"Loecher stecken."));
  return 1;
}


// Loecher Blockieren - Falle entschaerft (endlich ;)
int cmdstecken(string str )
{
  object pfeile;
  pfeile = present(PFEILE, TP);
  if(!pfeile)
  {
    write(BS("Du hast keine Pfeile!"));
    return -1;
  }
  
  write(BS("Du blockierst die Loecher mit den alten zerbrochenen Pfeilen. Nun "
          +"sollte keine Gefahr mehr von der Falle ausgehen."));
  say(BS(TP->Name()+" hantiert am Boden herum."));
  pfeile->remove();
  LUMINORMASTER->Msg(TP->Name()+": entschaerft die Speere!");
  falle = WEG;
  return 1;

}

// Gargylen mit einer Waffe zerstoeren
int cmdzerstoere(string str)
{
  object waffe;
  string waffentyp, s;
  waffe = TP->QueryProp(P_WEAPON);
  
  if(present("marmorgargyl"))
  {
    write(BS("Die Gargylen weichen Dir geschickt aus."));
    return -1;
  }
  
  if (gargyl == WEG)
  {
  	write(BS("Die Gargylen liegen bereits zertruemmert vor Dir."));
  	return -1;
  }

  if(!waffe)
  {
  	write(BS("Ohne eine gezueckte Waffe wird das nichts!"));
    return -1;
  }
  
  waffentyp = waffe->QueryProp(P_WEAPON_TYPE);

  switch(waffentyp)
  {
  	case WT_AXE:
  	  s = "Du holst weit mit "+waffe->name(WEN)+" aus";
      break;
  	case WT_SWORD:
      s = "Du schwingst "+waffe->name(WEN);
      break;
  	case WT_CLUB:
      s = "Du holst mit "+waffe->name(WEN)+" aus";
      break;
  	case WT_CHAIN:
      s = "Schnell wirbelst Du "+waffe->name(WEN)+" ueber Deinen Kopf";
      break;
    default:
      write(BS("Deine Waffe ist dafuer nicht geeignet!"));
      return -1;
      break;
  }

  // Waffe wird dabei beschaedigt
  waffe->TakeFlaw(100);
  
  write(BS(s+" und zerstoerst die Gargylenreliefs mit einem wuchtigen Schlag. "
            +"Leider wird Deine Waffe dabei beschaedigt."));
  say(BS(TP->Name()+" zerstoert die Gargylenreliefs."));
  gargyl = WEG;
  AddDetail( ({ "haufen", "steine" }),
    "Von den Gargylen ist nicht mehr viel uebrig, lediglich ein Haufen Steine.");

  RemoveDetail( "augen");
  return 1;

}

reset()
{
  ::reset();

  if(gargyl == WEG)
  {
    Message(BS("Die Marmorgargylen setzen sich wieder zusammen!"), MSGFLAG_VISUAL);
    AddDetail( ({ "augen" }),
      "Die Augen scheinen jede Deiner Bewegungen zu verfolgen.");
    RemoveDetail( ({ "haufen", "steine" }) );

    gargyl = DA;
  }

  falle = DA;
}

string strLoecher(string key)
{
  if(falle == DA)
  {
    return BS("In den Loechern stecken viele Speere. Vielleicht findest Du ja einen Weg, "
             +"die Falle unbrauchbar zu machen.");
  }
  else
  {
    return BS("In den Loechern stecken viele Speere. Irgendjemand hat "
             +"die Falle blockiert!");
  }
}

string strGargylen(string key)
{
  if(gargyl == DA)
  {
    return BS("Die Gargylen stehen aufrecht mit zusammengefalteten Fluegeln. "
             +"Fast scheint es so, als wenn ihre kalten Augen jede Deiner "
             +"Bewegungen verfolgen wuerden.");
  }
  else
  {
    return BS("Von den Gargylen ist nur ein kleiner Haufen Steine uebriggeblieben.");
  }
}