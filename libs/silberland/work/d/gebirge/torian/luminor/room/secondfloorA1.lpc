
inherit "std/room";

#include "../def.h"

#define OBEN ROOM "thirdfloorA1"
#define S ROOM "secondfloorA2"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du stehst im zweiten Stockwerk des Turmes. Im Norden befindet sich die Treppe "
    "nach oben, waehrend im Sueden ein Gang wieder hinaus fuehrt. Ueberall um "
    "Dich herum stehen Feuerschalen. Die Waende sind mit vielen merkwuerdigen "
    "Symbolen uebersaeht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_KILL_NAME, "Eine Flammensaeule" );  

  AddDetail( ({ "stockwerk", "2. stockwerk", "zweites stockwerk" }),
    "Du befindest Dich zur Zeit im zweiten Stockwerk.");
  AddDetail( ({ "zeit" }),
    "Zeit ist relativ.");
  AddDetail( ({ "erstes stockwerk", "1. stockwerk" }),
    "Das erste Stockwerk befindet sich logischerweise unter Dir.");
  AddDetail( ({ "drittes stockwerk", "3. stockwerk" }),
    "Im dritten Stockwerk wartet Luminor auf sein neuestes Opfer.");
  AddDetail( ({ "luminor" }),
    "Willst Du sein neuestes Opfer sein?");
  AddDetail( ({ "opfer", "du" }),
    "Luminor hat schon viele unvorsichtige Abenteurer verschlungen.");
  AddDetail( ({ "abenteurer" }),
    "Viele Abenteurer wollten Luminors Herrschaft beenden. Sie sind aber alle "
    "gescheitert!");
  AddDetail( ({ "herrschaft" }),
    "Luminor herrscht ueber diesen Turm und alle Einwohner.");
  AddDetail( ({ "einwohner" }),
    "Oni, Gespenster, Feuertrolle. Sie alle gehorchen Luminor!");
  AddDetail( ({ "gespenster", "feuertrolle" }),
    "Sie alle gehorchen Luminor!");
  AddDetail( ({ "oni" }),
    "Eine unglueckliche Person, die unter tragischen Umstaenden gestorben ist, kehrt "
    "als Oni zurueck, um den Tod seiner Geliebten zu raechen!");
  AddDetail( ({ "person" }),
    "Eine Person, die keine Ruhe findet und als Oni wieder zurueckkehrt.");
  AddDetail( ({ "ruhe" }),
    "Nicht jeder findet die letzte Ruhe.");
  AddDetail( ({ "umstaenden", "mord", "umstaende", "tod" }),
    "Mord.");
  AddDetail( ({ "geliebten", "geliebte", "verwandte" }),
    "Zum Beispiel Verwandte.");
  AddDetail( ({ "beispiel", "frau", "mann" }),
    "Oder der geliebte Mann oder die geliebte Frau.");
  AddDetail( ({ "turm" }),
    "Du befindest Dich in Luminors Turm.");
  AddDetail( ({ "norden" }),
    "Im Norden befindet sich die Treppe nach oben. Sei vorsichtig, wenn Du Dich "
    "Luminor tatsaechlich noch weiter naehern willst!");
  AddDetail( ({ "treppe" }),
    "Diese Treppe fuehrt nach oben.");
  AddDetail( ({ "sueden" }),
    "Im Sueden fuehrt ein Gang wieder aus dem Turm heraus.");
  AddDetail( ({ "gang" }),
    "Der Gang setzt sich im Sueden fort.");
  AddDetail( ({ "feuerschalen" }),
    "Um Dich herum stehen eine Menge Feuerschalen. Sie scheinen mit Kohle gefuellt zu "
    "und bestehen aus nicht brennbarem Material.");
  AddDetail( ({ "menge" }),
    "Um Dich herum stehen eine Menge Feuerschalen.");
  AddDetail( ({ "kohle" }),
    "In den Feuerschalen brennt Kohle.");
  AddDetail( ({ "material" }),
    "Die Feuerschalen scheinen aus Metall zu bestehen.");
  AddDetail( ({ "metall" }),
    "Vorsichtig beruehrst Du das Metall. Absolut kalt. Entweder es ist magisch, oder "
    "eine Dir unbekannte Metalllegierung.");
  AddDetail( ({ "metalllegierung", "legierung" }),
    "Du weisst leider nicht welche.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind mit vielen merkwuerdigen Symbolen uebersaeht.");
  AddDetail( ({ "symbole" }),
    "Neben dem Dir schon bekannten Sonnensymbol kannst Du noch einige weitere Dir "
    "unvertraute Symbole erkennen.");
  AddDetail( ({ "sonnensymbol", "symbol" }),
    "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
    "Strahlen rundherum.");
  AddDetail( ({ "kreis" }),
    "Der Kreis mit den wellenfoermigen Strahlen soll die Sonne "
    "darstellen.");
  AddDetail( ({ "strahlen" }),
    "Wellenfoermige Strahlen sind um den Kreis herum abgebildet.");
  AddDetail( ({ "sonne" }),
    "Die Sonne gilt auch als Symbol fuer Feuer.");
  AddDetail( ({ "feuer" }),
    "Die Sonne mit ihren gluehenden Strahlen steht fuer das niemals "
    "erloeschende Feuer.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit verkohlten und verbrannten Stellen uebersaeht. Ab und zu "
    "zuengelt eine Flamme hoch.");
  AddDetail( ({ "decke" }),
    "Die gesamte Decke scheint zu brennen. Deswegen ist es also so heiss hier. "
    "Nichts destotrotz scheint es so, als wenn das Gestein ueberhaupt nicht angegriffen "
    "wird von den Flammen.");
  AddDetail( ({ "flammen" }),
    "Die Flammen scheinen eher magischer Natur zu sein.");
  AddDetail( ({ "natur", "mutter" }),
    "Mit Mutter Natur hat Magie nur wenig zu tun.");
  AddDetail( ({ "magie" }),
    "Es scheint sich um magische Flammen zu handeln.");
  AddDetail( ({ "stellen" }),
    "Viele verkohlte und verbrannte Stellen uebersaehen den Boden. Eine Stelle "
    "scheint aufschlussreicher zu sein als die anderen.");
  AddDetail( ({ "stelle" }),
    "Bei genauerer Betrachtung stellst Du fest, dass dort etwas Schwarzes, Schmieriges "
    "erhalten geblieben ist.");
  AddDetail( ({ "betrachtung" }),
    "Du betrachtest die Stelle genauer.");
  AddDetail( ({ "schwarzes", "etwas", "schmieriges" }),
    "Es scheint sich um Oel zu handeln. Kein Wunder, dass der Boden bestaendig brennt.");
  AddDetail( ({ "oel" }),
    "Wo das Oel wohl herkommt?");
  AddDetail( ({ "wunder" }),
    "Bei soviel Oel ist das wahrlich kein Wunder.");
  AddDetail( ({ "flamme" }),
    "Ab und zu zuengelt eine Flamme hoch. Es scheint so, als wenn der ganze Boden "
    "brennen moechte.");
  AddDetail( ({ "gestein" }),
    "Du bist Dir fast sicher, dass es sich um Obsidian handelt. Das wuerde auch erklaeren, "
    "warum es nicht von dem Feuer angegriffen wird.");
  AddDetail( ({ "obsidian" }),
    "Obsidian ist ein magisches Gestein mit besonderen Eigenschaften.");
  AddDetail( ({ "eigenschaften" }),
    "Als Magier oder Geologe wuesstest Du sicher mehr darueber.");
  AddDetail( ({ "magier" }),
    "Magier beschaeftigen sich unter anderem auch mit magischen Gesteinen.");
  AddDetail( ({ "geologe" }),
    "Wenn sich ein Geologe nicht mit Steinen auskennt ...");
  AddDetail( ({ "steinen", "steine" }),
    "... dann kennt sich wohl niemand damit aus.");
  AddDetail( ({ "hitze" }),
    "Verdammt heiss hier.");
  AddDetail( ({ "ruecken", "schauer" }),
    "Die Geraeusche jagen Dir einen Schauer ueber den Ruecken.");

  AddSound( DEFAULT_SOUND,
    "Das Feuer in den Schalen knistert ab und zu. Ausserdem hoerst Du unheimliche "
    "Geraeusche von oben.");

  AddSound( ({ "knistern", "feuer", "schalen" }),
    "Das Feuer in den Schalen knistert ab und zu.");
  AddSound( ({ "kreischen" }),
    "Trotz der Hitze laeuft es Dir eiskalt den Ruecken runter.");
  AddSound( ({ "geraeusche" }),
    "Es erinnert Dich an den mythenumwobenen Gesang der Sirenen.");
  AddSound( ({ "sirenen" }),
    "Angeblich kann niemand den Gesang der Sirenen widerstehen.");
  AddSound( ({ "gesang", "gespenster" }),
    "Es koennte auch lediglich das Kreischen von Gespenstern sein.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Feuer.");

  AddSmell( ({ "feuer" }),
    "Verbrannt.");

  AddExit( "sueden", S );
  AddExit( "oben", "die Treppe hinauf#" +  OBEN);

  AddRoomMessage( ({ "Eine Flamme im Boden zuengelt hoch!\n",
                     "Eine Flammensaeule schiesst zur Decke hinauf!\n",
                     "Eine kleine Flamme zischt hoch, erlischt aber sofort wieder.\n"}), 30, "flamme" );
}

int filter_lebewesen(object ob)
{
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1; // alle Spieler
 
  return 0;   // Rest wird aussortiert
}

void flamme(int msg)
{
  object *inhalt; 
  object player;
  int i;
  inhalt = all_inventory(TO); // Wer befindet sich alles im Raum
  inhalt = filter_array(inhalt, "filter_lebewesen"); // nur spieler behalten

  if (msg == 1)
  {
    if(random(2))
    {
      tell_room(TO, BS("Du wirst voll getroffen!")); 
      for (i =0; i<sizeof(inhalt); i++)
      {
        player = inhalt[i];
        if(player)
        {
          player->Defend(50+random(50), DT_FIRE, 1, TO);
        }
      }
    }
    else
    {
      tell_room(TO, BS("Du weichst der Flammensaeule aus!"));
    }
    return;
  }
}