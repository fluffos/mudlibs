
inherit "std/room";

#include "../def.h"

#define N ROOM "uglinksA1"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Kerker" );
  SetProp( P_INT_LONG,
    "Du stehst hier mitten in einem finsteren Kerker. Im Norden siehst "
    "Du die Tuer, durch die Du hereingekommen bist. Neben der Tuer "
    "stehen ein paar Schuesseln und eine Karaffe auf dem Boden. Ueberall "
    "liegen oder sitzen Gefangene herum und starren Dich aus leeren "
    "Augen an. In einer Ecke befindet sich ein Haufen Stroh. "
    "Merkwuerdigerweise halten sich dort jedoch nur sehr wenige "
    "Gefangene auf.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "kerker" }),
    "Das hier ist der finstere Kerker Luminors.");
  AddDetail( ({ "luminor", "luminors" }),
    "Luminor ist der Besitzer dieses Turms.");
  AddDetail( ({ "turm", "turms" }),
    "Solltest Du es noch nicht bemerkt haben: Du befindest Dich in Luminors Turm.");
  AddDetail( ({ "besitzer" }),
    "Der jetzige Besitzer ist Luminor. Man munkelt aber, dass er seinen Vorgaenger noch "
    "immer hier irgendwo gefangenhaelt.");
  AddDetail( ({ "vorgaenger" }),
    "Der Kerker hatte in den Haenden seines Vorgaengers nur wenige Gaeste.");
  AddDetail( ({ "haende" }),
    "Mit ein wenig Glueck - Pech? - findest Du die Haende hier sogar. Luminor ist "
    "bekannt fuer seine Grausamkeit.");
  AddDetail( ({ "glueck" }),
    "Oder doch eher Pech?");
  AddDetail( ({ "pech" }),
    "Dass Du Dich hierhin verirrt hast, zeigt, dass Du tatsaechlich vom Pech verfolgt wirst.");
  AddDetail( ({ "gaeste" }),
    "Andere wuerden zu ihnen auch Gefangene oder verlorene Seelen sagen.");
  AddDetail( ({ "seelen", "seele" }),
    "Wer hier als Gefangener endet, muss um seine Seele fuerchten.");
  AddDetail( ({ "grausamkeit" }),
    "Luminor ist bekannt fuer seine Grausamkeit.");
  AddDetail( ({ "norden" }),
    "Im Norden befindet sich die Kerkertuer.");
  AddDetail( ({ "freiheit" }),
    "Die Gefangenen haben noch immer Hoffnung auf Freiheit.");
  AddDetail( ({ "weg" }),
    "Der Weg in die Freiheit ist Dir versperrt.");
  AddDetail( ({ "hoffnung" }),
    "Die Hoffnung stirbt zuletzt.");
  AddDetail( ({ "schuesseln", "schuessel" }),
    "Diese Schuesseln sehen so aus, als ob einmal Suppe darin gewesen waere. Sogar ein "
    "paar Brotkruemel kannst Du erkennen.");
  AddDetail( ({ "suppe" }),
    "In den Schuesseln befand sich einmal Suppe. Sie wurde komplett aufgegessen. Nur ein "
    "paar Essensreste und Brotkruemel deuten noch auf sie hin.");
  AddDetail( ({ "essensreste", "reste" }),
    "Viel ist nicht davon zu sehen. Die Schuesseln wurden sehr gruendlich leer gegessen.");
  AddDetail( ({ "brotkruemel" }),
    "Zusammen mit dem Wasser aus der Karaffe deuten die Brotkruemel auf ein klassisches "
    "Gefangenenmahl hin. Nur die Suppe stoert ein wenig das Bild.");
  AddDetail( ({ "karaffe" }),
    "In der Karaffe befindet sich noch ein letzter Schluck Wasser.");
  AddDetail( ({ "wasser" }),
    "Ein letzter Schluck Wasser ist in der Karaffe. Wer weiss, wann es neues gibt?");
  AddDetail( ({ "schluck", "tropfen" }),
    "Nur ein kleiner Tropfen Wasser ist uebrig.");
  AddDetail( ({ "gefangenenmahl", "mahl" }),
    "Wasser und Brot.");
  AddDetail( ({ "brot" }),
    "Sogar Brot hatten die Gefangenen.");
  AddDetail( ({ "bild" }),
    "Die Suppe stoert ein wenig das Bild.");
  AddDetail( ({ "gefangene", "gefangener", "gefangenen" }),
    "Die Gefangenen starren Dich aus leeren Augen an. Sie scheinen schon sehr viel Leid "
    "erlebt zu haben.");
  AddDetail( ({ "augen" }),
    "Leere ausdruckslose Augen.");
  AddDetail( ({ "leid" }),
    "Du moechtest nicht wissen, wieviel Leid diese Augen schon sehen mussten.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke befindet sich ein Haufen Stroh.");
  AddDetail( ({ "haufen" }),
    "Der Haufen Stroh ist nicht sonderlich gross, bietet aber dennoch genug Platz fuer "
    "mehrere Gefangene.");
  AddDetail( ({ "platz" }),
    "Mehr Platz, als zur Zeit verwendet wird.");
  AddDetail( ({ "zeit" }),
    "Jetzt.");
  AddDetail( ({ "stroh" }),
    "Das Stroh sieht schon sehr alt und vergammelt aus. Dennoch ist es besser als der "
    "nackte Felsboden.");
  AddDetail( ({ "felsboden", "boden" }),
    "Der Boden besteht komplett aus Felsgestein.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind ziemlich kahl. Man erkennt deutlich die grossen rechteckigen "
    "Felsbrocken, aus denen der Kerker errichtet wurde.");
  AddDetail( ({ "felsbrocken" }),
    "Grosse rechteckige Felsbrocken, aus denen der Kerker errichtet wurde. Verschiedene "
    "Zeichen, Symbole und sogar ein paar Worte wurden in sie hineingeritzt.");
  AddDetail( ({ "zeichen" }),
    "Jede Menge gerader Striche, angeordnet in Siebenergruppen.");
  AddDetail( ({ "strich" }),
    "Es sind fast zu viele Striche da, um sie zaehlen zu koennen.");
  AddDetail( ({ "striche" }),
    "Ein Strich stellt sicher einen Tag dar.");
  AddDetail( ({ "gruppen", "siebenergruppen" }),
    "Eine Gruppe steht bestimmt fuer eine Woche.");
  AddDetail( ({ "Woche" }),
    "Eine Woche besteht aus sieben Tagen.");
  AddDetail( ({ "tagen", "tag", "tage", "strich" }),
    "Ein Strich stellt einen Tag dar.");
  AddDetail( ({ "symbole", "idee" }),
    "Du hast keine Idee, was diese Symbole bedeuten koennten.");
  AddDetail( ({ "worte", "wort" }),
    "Versuchs mal mit lesen.");
  AddDetail( ({ "felsgestein", "gestein" }),
    "Der gesamte Kerker besteht aus altem, rauhen Felsgestein. Keine Chance, einen Tunnel "
    "zu graben.");
  AddDetail( ({ "chance" }),
    "Die Chance, hier einen Tunnel graben zu koennen, ist bestenfalls minimal.");
  AddDetail( ({ "tunnel" }),
    "Du kannst hier keinen Tunnel graben.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht ebenso wie Waende und Boden aus rauhem Felsgestein.");
  AddDetail( ({ "eisen" }),
    "Die Kerkertuer besteht aus massivem Eisen.");
  AddDetail( ({ "fenster" }),
    "Das Fenster ist viel zu klein, um genaueres erkennen zu koennen.");
  AddDetail( ({ "gitter", "gitterstaeben", "gitterstaebe" }),
    "Die einzelnen Gitterstaebe sind sehr verrostet und erlauben nur einen kleinen "
    "Blick nach draussen.");
  AddDetail( ({ "blick" }),
    "Es ist nur sehr wenig zu erkennen.");
  AddDetail( ({ "rost" }),
    "Der Rost deutet auf ein sehr hohes Alter der Tuer hin.");
  AddDetail( ({ "alter" }),
    "Die Kerkertuer scheint, genauso wie der restliche Kerker, schon sehr alt zu sein.");
  AddDetail( ({ "bereich" }),
    "Im unteren Bereich befindet sich eine unscheinbare Luke.");
  AddDetail( ({ "luke", "mahlzeiten" }),
    "Durch diese Luke erhalten die Gefangenen ihre Mahlzeiten.");
  AddDetail( ({ "oeffnungsmechanismus", "mechanismus" }),
    "Du kannst keinen Mechanismus erkennen, er muss sich wohl auf der anderen Seite der Tuer befinden.");
  AddDetail( ({ "seite" }),
    "Die Tuer laesst sich nur von der anderen Seite her aus oeffnen.");
  AddDetail( ({ "strohlager" }),
    "Diesen Gefangenen geht es am schlechtesten. Dir ist nun klar, warum sie als einzige "
    "auf dem Strohlager liegen.");

  AddReadDetail( ({ "worte", "wort" }),
    "Du liest: \"Luminor ist doof und stinkt!\"");

  AddSound( DEFAULT_SOUND,
    "Die Gefangenen auf dem Strohlager stoehnen laut.");

  AddSound( ({ "gefangenen" }),
    "Die Gefangenen stoehnen gequaelt auf. Ihnen scheint es nicht besonders gut zu gehen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach vergammeltem Stroh und vielen ungewaschenen Koerpern.");

  AddSmell( ({ "stroh" }),
    "Das Stroh riecht nicht gerade frisch.");
  AddSmell( ({ "koerper", "gefangenen" }),
    "Du willst gar nicht so genau wissen, wie die Gefangenen alle riechen ...");

  NewDoor("norden", N , ({"tuer", "kerkertuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Kerkertuer.",
      D_LONG, "Die verrostete Kerkertuer besteht aus massivem Eisen mit einem kleinen "
              "Fenster aus Gitterstaeben. Im unteren Bereich der Tuer ist eine unscheinbare "
              "Luke zu erkennen. Du kannst keinen Oeffnungsmechanismus sehen, der Dir den "
              "Weg in die Freiheit bahnen koennte.",
      D_NAME,  "Kerkertuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_OPENMSG, ({"Du oeffnest die Kerkertuer.",
                   "%s oeffnet die Kerkertuer.",
                   " wird von der anderen Seite geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Kerkertuer.",
                   "%s schliesst die Kerkertuer.",
                   " wird von der anderen Seite geschlossen."}),
      D_RESET_CLOSEMSG,
                  " im Norden ist zugefallen!\n"
    })
  );

  AddRoomMessage( 
    ({"Die Gefangen stoehnen.\n",
      "Einige Gefangene waelzen sich unruhig hin und her.\n",
      "Ein Gefangener hustet laut.\n"}),70);

  AddItem( NPC "heilerin", REFRESH_DESTRUCT);
  
  AddCmd( "zaehle|zaehl&striche", "cmdzaehlen",
          "Was willst Du zaehlen?" );
  AddCmd( "grabe|grab&tunnel", "cmdgraben",
          "Was willst Du graben?" );

}

// Die Tuer laesst sich nicht von hier oeffnen
int tueroeffnen()
{
  write(BS("Der Riegel befindet sich auf der anderen Seite der Tuer. Ohne Hilfe "
          +"von ausserhalb wirst Du hier nicht rauskommen."));
  return 1;
}

int cmdzaehlen(string str)
{
  write(BS("Du zaehlst "+((time()-950903236)/86400)+" Striche an der Wand."));
  say(BS(TP->Name()+" scheint die Striche an der Wand zu zaehlen."));
  return 1;
}

int cmdgraben(string str)
{
  write(BS("Keine Chance!"));
  return 1;
}