
inherit "std/room";

#include "../def.h"

#define S ROOM "erdgB2"
#define OBEN ROOM "firstfloorA1"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Direkt vor Dir fuehrt eine breite, leicht geschwungene Treppe nach "
    "oben. Auf einer der Stufen liegt ein zusammengesunkenes, "
    "merkwuerdig fremd aussehendes Lebewesen, daneben siehst Du eine "
    "grosse Blutlache. Auch die Waende sind mit Blut verschmiert.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "treppe" }),
    "Die breite Treppe fuellt fast die gesamte Wand im Norden aus. Sie "
    "besteht aus schwarzem Marmor und fuehrt weit nach oben. Was mag "
    "Dich dort wohl erwarten?");
  AddDetail( ({ "wand", "nordwand" }),
    "Fast die gesamte Nordwand wird von der breiten Treppe ausgefuellt, "
    "die sich dort nach oben hin erstreckt.");
  AddDetail( ({ "norden" }),
    "Im Norden fuehrt eine breite Treppe nach oben.");
  AddDetail( ({ "marmor" }),
    "Der Marmor ist grauschwarz gefaerbt und hat eine sehr glatte Oberflaeche.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Marmorstufen ist sehr glatt und man muss "
    "aufpassen, dass man beim Hinaufgehen nicht ausrutscht.");
  AddDetail( ({  "marmorstufen" }),
    "Die Treppenstufen bestehen aus schwarzem Marmor.");
  AddDetail( ({ "stufen", "treppenstufen", "treppenstufe" }),
    "Die Stufen der Treppe sind sehr flach und sehr breit. Auf einer der "
    "Stufen liegt ein zusammengesunkenes, fremdartiges Wesen neben einer "
    "grossen Blutlache.");
  AddDetail( ({ "wesen", "lebewesen" }),
    "Du hast noch nie ein Wesen wie dieses gesehen. Es hat drei Augen, "
    "einen grossen Mund und zwei spitze Hoerner auf dem Kopf. Seine "
    "Fuesse sind mit Krallen besetzt und es hat einen langen Schwanz. "
    "Dieses hier scheint schon eine ganze Weile hier zu liegen. Eine "
    "grosse Blutlache hat sich neben ihm gebildet und es regt sich nicht "
    "mehr.");
  AddDetail( ({ "augen" }),
    "Die drei Augen dieses sonderbaren Wesens sind geschlossen.");
  AddDetail( ({ "mund" }),
    "Der Mund ist sehr gross und zwei spitze Zaehne schauen daraus hervor.");
  AddDetail( ({ "zaehne" }),
    "Die Zaehne sehen aeusserst spitz aus.");
  AddDetail( ({ "hoerner" }),
    "Zwei grosse spitze Hoerner wachsen dem Wesen aus dem Kopf.");
  AddDetail( ({ "kopf", "menschen" }),
    "Der Kopf dieses Wesens saehe dem eines Menschen recht aehnlich, "
    "waeren da nicht drei Augen statt zwei und der Mund nicht so gross.");
  AddDetail( ({ "fuesse" }),
    "Die beiden Fuesse des Wesens sind mit scharfen Krallen besetzt.");
  AddDetail( ({ "krallen" }),
    "Scharfe Krallen befinden sich an den Fuessen des Wesens. Damit kann "
    "es sich sicherlich gut gegen seine Gegner verteidigen.");
  AddDetail( ({ "gegner" }),
    "Dieses Mal war das Wesen seinem Gegner wohl unterlegen. Einige "
    "blutige Pfeile stecken in seinem Koerper.");
  AddDetail( ({ "mal" }),
    "Du fragst Dich, gegen wen dieses Wesen wohl gekaempft hat.");
  AddDetail( ({ "pfeile", "pfeil" }),
    "Die Pfeile sind mit Blut verschmiert.");
  AddDetail( ({ "blut" }),
    "Neben dem Wesen auf der Treppe hat sich eine grosse Blutlache "
    "gebildet. Auch die Waende sind blutverschmiert.");
  AddDetail( ({ "blutlache" }),
    "Eine grosse, dunkle Blutlache hat sich neben dem Wesen auf der "
    "Treppenstufe gebildet.");
  AddDetail( ({ "waende", "wand" }),
    "Im Norden wird fast die gesamte Wand von einer breiten Treppe "
    "eingenommen, die weiter hinauf fuehrt. In der Suedwand befindet "
    "sich eine kleine Holztuer. Alle Waende sind ueber und ueber mit "
    "Blut verschmiert. An der Ostwand scheint etwas geschrieben zu "
    "stehen.");
  AddDetail( ({ "suedwand" }),
    "Suedlich von Dir befindet sich eine kleine Holztuer.");
  AddDetail( ({ "zedernholz", "holz" }),
    "Das Zedernholz hat eine roetliche Faerbung.");
  AddDetail( ({ "faerbung" }),
    "Das Holz ist rot gefaerbt.");
  AddDetail( ({ "pfeilspitzen" }),
    "Einige Pfeilspitzen schauen aus der Tuer heraus. Sie scheinen von "
    "der Rueckseite her in die Tuer geschossen worden zu sein.");
  AddDetail( ({ "rueckseite" }),
    "Die Rueckseite der Tuer kannst Du von hier nicht sehen.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Tuer befindet sich ein kleiner Tuergriff.");
  AddDetail( ({ "tuergriff" }),
    "Auch der Tuergriff besteht aus Zedernholz.");
  AddDetail( ({ "ostwand" }),
    "Auf die Ostwand hat jemand mit blutroten Farbe ein paar Worte "
    "geschrieben.");
  AddDetail( ({ "farbe" }),
    "Die Worte sind mit Blut geschrieben.");
  AddDetail( ({ "worte" }),
    "Du solltest versuchen, die Worte zu lesen.");
  AddReadDetail( ({ "worte" }),
    "Du wirst ein wenig blass um die Nase, als Du liest: \"Kehre um, "
    "bevor es zu spae...\" Am Ende des letzten Wortes hoert die Schrift "
    "ganz ploetzlich auf und ein langer Blutstreifen zieht sich die Wand "
    "herunter bis zum Boden.");
  AddDetail( ({ "nase" }),
    "Bei dem Gedanken daran, was Dir hier noch so alles zustossen "
    "koennte, wirst Du ein wenig blass um die Nase.");
  AddDetail( ({ "gedanken" }),
    "Du wagst gar nicht, laenger darueber nachzudenken.");
  AddDetail( ({ "ende" }),
    "Die Schrift hoert ganz ploetzlich auf, als ob jemand mitten beim "
    "Schreiben unterbrochen wurde.");
  AddDetail( ({ "schrift" }),
    "Die Worte sind mit Blut geschrieben.");
  AddDetail( ({ "schreiben" }),
    "Wer auch immer diese Worte geschrieben hat, er scheint danach nicht "
    "mehr lange gelebt zu haben.");
  AddDetail( ({ "blutstreifen" }),
    "Ein langer verschmierter Blutstreifen zieht sich an der Wand "
    "herunter. Kurz ueber dem Boden hoert er abrupt auf und ein blutiger "
    "Handabdruck findet sich dort.");
  AddDetail( ({ "boden" }),
    "Unter dem vielen Blut, dass den Boden hier ueberdeckt, kannst Du "
    "kaum noch erkennen, dass er aus rotem Sandstein besteht.");
  AddDetail( ({ "sandstein" }),
    "Der Boden und die Waende bestehen aus rotem Sandstein.");
  AddDetail( ({ "handabdruck", "abdruck" }),
    "Kurz ueber dem Boden siehst Du einen blutverschmierten "
    "Haendeabdruck an der Wand.");
  AddDetail( ({ "koerper", "haut" }),
    "Das Wesen wurde toedlich verwundet. Einige blutige Pfeile stecken in "
    "seinem Koerper.");
  AddDetail( ({ "schwanz" }),
    "Der lange Schwanz des Wesens liegt in einer grossen Blutlache. Er "
    "wurde von einem Pfeil getroffen, der nun tief in seiner Haut "
    "steckt.");
  AddDetail( ({ "weile" }),
    "Das Wesen scheint eine ganze Weile tot zu sein.");
  AddDetail( ({ "hinaufgehen" }),
    "Die Treppe fuehrt nach oben.");
  AddDetail( ({ "stufe" }),
    "Auf einer der Stufen liegt ein zusammengesunkenes, fremdartiges Wesen "
    "neben einer grossen Blutlache.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus rotem Sandstein.");

  AddSound( DEFAULT_SOUND,
    "Lautes Gebruell und Gestampfe dringt von oben herab.");

  AddSound( ({ "gebruell" }),
    "Das Gebruell wird immer lauter, je mehr Du Dich der Treppe naeherst.");
  AddSound( ({ "treppe" }),
    "Das Gebruell kommt von oben.");
  AddSound( ({ "gestampfe" }),
    "Das laute Gestampfe klingt wirklich furchterregend.");

  AddSmell( DEFAULT_SMELL,
    "Ein widerlicher Geruch zieht von dem Wesen auf der Treppe herueber.");

  AddSmell( ({ "geruch" }),
    "Es stinkt fuerchterlich.");
  AddSmell( ({ "wesen" }),
    "Das Wesen verstroemt einen uebelkeiterregenden verwesten Geruch.");
  AddSmell( ({ "treppe" }),
    "Der Geruch kommt von der Treppe.");

  AddExit( "norden", "die Treppe hinauf#" +  OBEN );
  AddExit( "nordoben", "die Treppe hinauf#" +  OBEN );
  
  SetProp(P_HIDE_EXITS, ({ "norden" }));


  NewDoor("sueden", S , ({"holztuer", "tuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer besteht aus roetlichem Zedernholz und Du siehst einige "
             +"Pfeilspitzen aus ihr herausragen. In der Mitte der Tuer befindet "
             +"sich ein schmaler Tuergriff.",
      D_NAME,  "Tuer",
      D_GENDER,FEMALE,
      D_OPENMSG, ({"Du oeffnest die Holztuer.",
                   "%s oeffnet die Holztuer.",
                   " wird von der anderen Seite geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Holztuer.",
                   "%s schliesst die Holztuer.",
                   " wird von der anderen Seite geschlossen."}),
      D_RESET_CLOSEMSG,
                  " im Sueden ist zugefallen!\n"
    })
  );

}