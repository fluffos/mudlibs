#include "../def.h"
#include <verben.h>

inherit "std/room";
string *spieler;
int messer;

void create()
{
  ::create();

  spieler = ({ });
  messer = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine gemuetliche Hoehle");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer kleinen, gemuetlich aussehenden "
    "Hoehle. Einige hohe, steinerne Stufen fuehren vom Hoehleneingang "
    "herab in den recht spaerlich, dennoch aber wohnlich "
    "eingerichteten Raum. Durch ein Loch in der Decke dringt helles Tageslicht "
    "herein, so dass Du die wenigen Einrichtungsgegenstaende gut erkennen "
    "kannst. Mitten in der Hoehle steht ein kleiner runder Tisch mit "
    "einem Holzstuhl davor. An der Dir gegenueberliegenden Wand siehst "
    "Du eine kaminartige Einbuchtung, in der ein grosser Kessel steht. "
    "Neben dem Eingang befindet sich ein hohes Buecherregal, das mit "
    "zahlreichen Werken gefuellt ist. Direkt daneben lehnt eine leicht "
    "verrostete Spitzhacke an der Wand."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle" }),
    "Ein kleine, gemuetlich aussehende Hoehle."
  );

  AddDetail( ({ "stufen" }),
   "Einige hohe, steinerne Stufen fuehren in die Hoehle. "
   "Ihre Hoehe deutet darauf hin, dass sie fuer Trolle ausgelegt sind."
  );
  AddDetail( ({ "hoehe" }),
   "Ihre Hoehe deutet darauf hin, dass sie fuer Trolle ausgelegt sind."
  );
  AddDetail( ({ "trolle", "troll" }),
    "Das liegt bestimmt daran, dass der Besitzer ein Troll ist."
  );
  AddDetail( ({ "besitzer", "harry" }),
    "Diese Hoehle gehoert Harry, ist er denn zur Zeit nicht da?"
  );
  AddDetail( ({ "zeit" }),
    "Dann musst Du wohl spaeter wiederkommen."
  );
  AddDetail( ({ "hoehleneingang", "eingang" }),
    "Durch den Hoehleneingang hast Du diese erstaunlich gemuetliche Hoehle "
    "betreten."
  );
  AddDetail( ({ "raum" }),
    "Die Hoehle ist sehr gemuetlich eingerichtet worden."
  );
  AddDetail( ({ "tageslicht", "sonnenstrahlen", "strahlen", "licht" }),
    ([ 0: "Du geniesst die hellen Sonnenstrahlen.",
       "dunkelelf": "Angewidert wendest Du Dich ab." ])
  );
  AddDetail( ({ "einrichtungsgegenstaende", "gegenstaende" }),
    "Viele sind es nicht. Ein Tisch, ein Stuhl, ein Buecherregal, "
    "eine Kochstelle und die Spitzhacke."
  );
  AddDetail( ({ "kochstelle", "stelle" }),
    "Die kaminartige Einbuchtung mit dem Kessel dient Harry als Kochstelle."
  );

  AddSpecialDetail( ({ "tisch", "holztisch" }), "strTisch"  );
  AddDetail( ({ "kochbuch", "buch" }),
    "Ein trollisches Kochbuch mit Dir unbekannten Schriftzeichen. Ausser "
    "Harry kann das vermutlich keiner lesen. Neben dem Kochrezept ist eine "
    "Illustration abgebildet."
  );

  AddDetail( ({ "schriftzeichen", "zeichen" }),
    "Die Schriftzeichen sind Dir alle auf den ersten Blick unbekannt. "
    "Vielleicht kannst Du sie ja dennoch entziffern?"
  );

  AddDetail( ({ "kochrezept", "rezept" }),
    "Du koenntest versuchen, es zu lesen."
  );

  AddDetail( ({ "illustration" }),
    "Sie zeigt einen Wolf von der Seite. Mehrere Pfeile deuten auf "
    "verschiedenste Koerperteile."
  );
  AddDetail( ({ "wolf" }),
    "Schmeckt so aehnlich wie Hund."
  );
  AddDetail( ({ "hund", "wasser", "mund" }),
    ([ 0: "Dir wird schlecht.",
      "oger": "Dir laeuft das Wasser im Mund zusammen." ])
  );
  AddDetail( ({ "seite" }),
    "Der Wolf ist von der Seite abgebildet."
  );
  AddDetail( ({ "pfeile", "koerperteile", "teile" }),
    "So genau wolltest Du es Dir doch nicht ansehen."
  );
  AddSpecialDetail( ({ "kuechenmesser", "messer" }), "strMesser" );
  AddDetail( ({ "holzstuhl", "stuhl" }),
    "Der Stuhl hat Trollgroesse."
  );
  AddDetail( ({ "trollgroesse" }),
    "Offensichtlich ist er fuer Trolle ausgelegt."
  );
  AddDetail( ({ "wand" }),
    "Eine kaminartige Einbuchtung ist in der Wand zu erkennen."
  );
  AddDetail( ({ "einbuchtung", "kamin" }),
    "In dem Kessel im Kamin bereitet Harry seine Mahlzeiten zu."
  );
  AddDetail( ({ "kessel" }),
    "Zur Zeit befindet sich nichts im Kessel ausser einem grossen Suppenloeffel."
  );
  AddDetail( ({ "suppenloeffel", "loeffel", "suppen", "suppe" }),
    "Mit ihm ruehrt Harry seine Suppen um."
  );
  AddDetail( ({ "mahlzeiten", "mahlzeit", "hunger" }),
    "Allmaehlich bekommst Du Hunger."
  );
  AddDetail( ({ "buecherregal", "regal" }),
    "Neben dem Eingang befindet sich ein hohes Buecherregal. Zahlreiche Werke "
    "stapeln sich in ihm."
  );
  AddDetail( ({ "werken", "werke", "blick", "buecher" }),
    "Du wirfst einen genaueren Blick auf die Werke. Einige wenige Titel kannst "
    "Du sogar erkennen."
  );
  AddDetail( ({ "titel" }),
    "\"Goldschuerfen leicht gemacht\", \"Trollhoehlen von Heute und Gestern\", "
    "\"Menschen richtig zubereitet\" ..."
  );
  AddDetail( ({ "spitzhacke" }),
    "Eine leicht verrostete Spitzhacke lehnt an der Wand. Wozu Harry die wohl "
    "benoetigt?"
  );
  AddDetail( ({ "waende" }),
    "Die spaerlichen Waende geben nicht viel her. Neben dem Eingang befindet sich "
    "ein hohes Buecherregal. Direkt daneben lehnt eine Spitzhacke an der Wand. "
    "Ausserdem erkennst Du eine kaminartige Einbuchtung, in der ein grosser Kessel "
    "steht."
  );
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich, wie nicht anders zu erwarten, ueber Dir. Sie ist "
    "ziemlich trist und eintoenig, lediglich ein grosses rundes Loch, durch das "
    "das Tageslicht einfaellt, ist zu erkennen."
  );

  AddDetail( ({ "loch" }),
    "Gross und rund. Die Raender sind fein saeuberlich geschliffen worden."
  );

  AddDetail( ({ "raender", "beweis" }),
    "Die Raender sind ein eindeutiger Beweis dafuer, dass das Loch erst "
    "nachtraeglich geschaffen wurde."
  );

  AddDetail( ({ "boden", "felsboden" }),
    "Der harte Felsboden ist vollkommen sauber. Kein Staubkorn, kein Dreck, "
    "kein gar nichts ..."
  );
  AddDetail( ({ "staubkorn", "korn", "dreck" }),
    "Du suchst den Boden penibelst ab, findest aber nichts dergleichen."
  );
  AddDetail( ({ "zwerge" }),
    "Zwerge haben die schoensten Spitzhacken."
  );
  AddDetail( ({ "trollkoeche", "koeche", "koch", "trollkueche" }),
    ([ 0: "Die Trollkueche ist nicht so Dein Fall.",
      "troll": "Auch wenn Du die Trollkueche liebst, Koch werden willst "
               "Du dennoch nicht." ])
  );

  AddDetail( ({ "wille", "weg" }),
    "Wo ein Wille ist, ist auch ein Weg."
  );

  AddSound( DEFAULT_SOUND,
    "In der Hoehle ist es sehr ruhig, lediglich von draussen dringt "
    "Vogelgezwitscher an Dein Ohr."
  );

  AddSound( ({ "ruhe", "stille" }),
    "Es ist sehr still hier.");

  AddSound( ({ "vogelgezwitscher", "gezwitscher", "ohr" }),
    "Das Vogelgezwitscher dringt von draussen an Dein Ohr.");

  AddSmell( DEFAULT_SMELL,
    "Frische Waldluft weht durch den Eingang herein."
  );

  AddSmell( ({ "waldluft", "luft", "eingang" }),
    "Die Luft riecht frisch und rein."
  );

  AddReadDetail( ({ "kochbuch", "buch", "kochrezept", "rezept" }),
    "Du verstehst die Schriftzeichen beim besten Willen nicht. Vielleicht "
    "kannst Du ja doch das eine oder andere entziffern?"
  );
  AddReadDetail( ({ "buecher", "werk", "werke" }),
    "Du kannst Dich gar nicht entscheiden wo Du anfangen sollst. Deswegen "
    "laesst Du es gleich ganz bleiben."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", "raus#" + "./wald2" );

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
  AddCmd( ({ "suche", "such" }), "cmd_suchen" );
  AddCmd("entziffer|entziffere&schriftzeichen|zeichen",
         "cmd_entziffern",
         "Was willst Du entziffern?");

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "harry" , REFRESH_DESTRUCT);
}

int cmd_nehmen(string str)
{
  object mymesser;
  object ob;

  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  ob = present("harry", TO);

  switch (str)
  {
  	case "messer":
  	case "kuechenmesser":
      if(messer == WEG)
      {
        write("Aber da liegt gar kein Messer!");
        return -1;
      }

      if(member(spieler, getuuid(TP)) != -1) 
      {
        if(ob)
        {
          ob->command_me("sag Was willst Du mit noch einem Messer, "+TP->Name(WER, 1)+"?");
          return -1;
        }
        else
        {
          write("Ein Messer reicht Dir ja eigentlich ...");
        }
      }
     
      mymesser=clone_object("/p/weapon/knife/kuechenmesser");

      if(ME_TOO_HEAVY==mymesser->move(TP,M_GET|M_SILENT))
      {
        write("Du kannst das Messer nicht mehr tragen.\n");
        mymesser->remove();
        return -1;
      }
      else
      {
        write(BS("Du nimmst das Kuechenmesser."));
        TO->Message(BS(TP->Name(WER, 1)+" nimmt das Kuechenmesser."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        spieler += ({ getuuid(TP) });

        if(ob)
        {
          ob->command_me("sag Nimm ruhig, ich hab noch genug davon.");
          TO->Message(BS("Harry legt ein weiteres Kuechenmesser auf den Tisch."),
              MSGFLAG_VISUAL);
        }
        else
        {
          messer = WEG;
        }

        return 1;
      }
      return -1;
    case "kochbuch":
    case "buch":
      write(BS("Du ueberlegst Dir ob Du wirklich unter die Trollkoeche gehen willst "
              +"und laesst das Kochbuch liegen."));
      return -1;
    case "spitzhacke":
    case "hacke":
      write(BS("So eine verrostete Spitzhacke willst Du gar nicht. Bei den "
              +"Zwergen gibt es viel schoenere."));
      return -1;
    case "suppenloeffel":
    case "loeffel":
      write(BS("Was willst Du denn damit???"));
      return -1;
    default:
      return 0;
  }
}

int cmd_suchen(string str)
{
  notify_fail("Was willst Du suchen?\n");

  if(!str || str == "") return 0;

  if(!(str == "versteck" ||
       str == "schatz"   ||
       str == "gold"     ||
       str == "schaetze" )) return 0;

  write(BS("Du suchst alles gruendlich ab, findest aber keinen Schatz."));
  TO->Message(TP->Name(WER, 1)+" sucht alles gruendlich ab.\n",
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int cmd_entziffern(string str)
{

  write(BS("Das eine Zeichen sieht aus wie ... oder ... und das andere ..."));
  Message(TP->Name(WER, 1)+" gruebelt ueber ein Kochrezept.\n",
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->command_me("rauf");
  return 1;

}

reset()
{
  ::reset();

  if(messer == WEG)
  {
    if(present("harry", TO)) 
    {
      TO->Message(BS("Harry legt ein Kuechenmesser auf den Tisch."),
              MSGFLAG_VISUAL);
      messer = DA;
    }
  }

  spieler = ({ });
}

string strTisch(string key)
{
  string s;
  
  s = "Ein kleiner runder Holztisch steht mitten in der Hoehle. Auf ihm "
     +"befindet sich ein aufgeschlagenes Kochbuch";
  
  if(messer == DA)
  {
    s += ", direkt daneben liegt ein altes Kuechenmesser.";
  }
  else
  {
    s += ".";
  }
  return BS(s);
}

string strMesser(string key)
{
  string s;

  if(messer == DA)
  {
    s = "Ein altes Kuechenmesser, dennoch bist Du Dir sicher das es sehr scharf ist.";
  }
  else
  {
    s = "Sowas siehst Du da nicht!";
  }
  
  return BS(s);
}