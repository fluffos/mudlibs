  AddDetail( ({ "oeffnen" }),
    "Wie bekommt man das Portal bloss auf?");
  AddDetail( ({ "weg" }),
    "Du wirst wohl einen anderen Weg finden muessen.");
  AddDetail( ({ "suedwand" }),
    "Ein grosses Portal fuellt die Suedwand aus.");
  AddDetail( ({ "natur" }),
