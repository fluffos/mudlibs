// Das Portal laesst sich nur mit Feuer oeffnen
int portaloeffnen()
{
  write(BS("Du stemmst Dich gegen das Portal. Es ruehrt sich aber kein "
          +"Stueck von der Stelle!"));
  return 1;
}

// Das Portal laesst sich nicht schliessen
int portalschliessen()
{
  write(BS("So ein schweres Portal kannst Du unmoeglich wieder schliessen!"));
  return 1;
}

// Anzuenden des Portals
int cmdzuenden(string str )
{
  object dest, fackel;
  call_other (S, "???", 0);
  dest = find_object(S);

  fackel = present("fackel",TP);
  if( !fackel )
  {
    write(BS("Du hast gar keine Fackel!"));
    return -1;
  } 

  if(!(fackel->_query_lighted()))
  {
    write(BS("Wie waers mit einer angezuendeten Fackel?"));
    return -1;
  }

  if (DOOR_MASTER->QueryDoorStatus(S)==D_STATUS_CLOSED)
  {
    
    write(BS("Du zuendest das Portal an!"));
    Message(BS(TP->Name()+" zuendet das Portal an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    Message(BS("Langsam oeffnet sich das Portal."), MSGFLAG_VISUAL);
    
    if(dest)
    {
      dest->Message(BS("Das Portal faengt ploetzlich an zu brennen und oeffnet sich."));
    }
    
    DOOR_MASTER->SetDoorStatus(S, D_STATUS_OPEN);
    return 1;
  }
  else 
  {
    write("Aber das Portal brennt doch schon?\n");
    return -1;
  }
}

string _query_int_long()
{
  string s;

  s = "Der gesamte Raum wird von einer ";
  
  switch(flamme)
  {
    case RIESIG:
      s += "riesigen Flamme eingenommen. Sie huellt die Decke nahezu "
          +"komplett ein. ";
      break;
    case SEHRGROSS:
      s += "sehr grossen Flamme eingenommen. Sie reicht bis zur Decke "
          +"hinauf. ";
      break;
    case GROSS:
      s += "grossen Flamme eingenommen. Sie reicht fast bis zur Decke "
          +"hinauf. ";
      break;
    case MITTEL:
      s += "mittelgrossen Flamme eingenommen. Sie erreicht nicht annaehernd "
          +"die Decke. ";
      break;
    default:
      s += "einer Flamme eingenommen.";
      DB("Fehler beim Anzeigen der Flamme! (Luminor-_query_int_long) Secondfloor");
      break;
  }
    
  s += "Auch auf dem Boden zuengeln immer wieder kleinere Flammen auf. Sogar die "
      +"Waende scheinen in Flammen zu stehen. Ein grosses Portal fuellt die "
      +"Suedwand aus.";

  return BS(s);
}

string strFlamme(string key)
{
  string s;

  s = "Solch eine Flamme hast Du noch nie gesehen. ";
  
  switch(flamme)
  {
    case RIESIG:
      s += "Sie huellt die Decke nahezu komplett ein. ";
      break;
    case SEHRGROSS:
      s += "Sie reicht bis zur Decke hinauf. ";
      break;
    case GROSS:
      s += "Sie reicht fast bis zur Decke hinauf. ";
      break;
    case MITTEL:
      s += "Sie erreicht nicht annaehernd die Decke. ";
      break;
    default:
      s += "Sie reicht bis zur Decke hinauf.";
      DB("Fehler beim Anzeigen der Flamme! (Luminor-strFlamme)");
      break;
  }
    
  s += "Du kannst die magische Aura der Flamme fast koerperlich spueren.";

  return BS(s);
}

string strDecke(string key)
{
  string s;

  switch(flamme)
  {
    case RIESIG:
      s = "Die riesige Flamme huellt die Decke nahezu "
          +"komplett ein. ";
      break;
    case SEHRGROSS:
      s = "Die sehr grosse Flamme reicht bis zur Decke "
          +"hinauf. ";
      break;
    case GROSS:
      s = "Die grosse Flamme reicht fast bis zur Decke "
          +"hinauf. ";
      break;
    case MITTEL:
      s = "Die mittelgrosse Flamme erreicht nicht annaehernd "
          +"die Decke. ";
      break;
    default:
      s = "Die Flamme erreicht die Decke.";
      DB("Fehler beim Anzeigen der Flamme! (Luminor)");
      break;
  }
    
  s += "Ebenso wie Boden und Waende besteht die Decke aus Obsidiangestein.";

  return BS(s);
}

// Testzwecke
void SetFlamme(int zustand)
{
  flamme = zustand;
}

// Fuer Luminor und den Master
int QueryFlamme()
{
  return flamme;
}

// verkleinern der Lebensflamme durch das Eiswasser
int cmdschuetten(string str)
{
  object phiole;

  phiole = present(EISWASSER,TP);

  if( !phiole )
  {
    write(BS("Du hast gar kein Eiswasser!"));
    return -1;
  } 

  if (find_call_out("fktFlamme") != -1)
  {
    write(BS("Irgendetwas passiert gerade mit dem Maul!"));
    return -1;
  }

  if(eiswasser < MAX_ICE)
  {
    write(BS("Du schuettest den kompletten Inhalt der Phiole in das Maul. "
            +"Ihres magischen Inhalts beraubt zerbricht die Phiole."));
    Message(BS(TP->Name()+" schuettet ein wenig Eiswasser in das Maul. "
              +"Ihres magischen Inhalts beraubt zerbricht die Phiole."), 
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    call_out("fktFlamme", 2, TP);
    LUMINORMASTER->Msg(TP->Name()+" verkleinert die Flamme.");

    phiole->remove();
    return 1;
  }
  else
  {
    write(BS("Du versuchst das Eiswasser in das Maul zu schuetten. "
            +"Leider fliesst alles daneben!"));
    Message(BS(TP->Name()+" versucht das Eiswasser in das Maul zu schuetten. "
              +"Leider fliesst alles daneben!"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    phiole->remove();
    return -1;
  }  

}

void fktFlamme()
{
  eiswasser++;

  if(flamme < MITTEL)
  flamme++;
  
  Message(BS("Erstaunt siehst Du ein blaues Leuchten vom Maul ausgehen, welches "
            +"die Flamme komplett einhuellt. Als es wieder verblasst erkennst "
            +"Du das die Flamme irgendwie kleiner geworden ist."), MSGFLAG_VISUAL);


  return;
}

reset()
{
  ::reset();

  eiswasser = 0;
  flamme = RIESIG;

}