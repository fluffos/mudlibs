
inherit "std/room";

#include "../def.h"

#define W ROOM "thirdfloorA2"
#define N ROOM "thirdfloorB1"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Turmspitze. Ueberall liegen Skelette und "
    "Leichen herum. Die Sued- und Ostwand wurden mit merkwuerdigen "
    "Kritzeleien beschmiert. Im Westen fuehrt der Gang wieder aus dem "
    "Turm heraus. Im Norden befindet sich eine einfache Tuer mit einem "
    "Dir fast schon vertrauten Symbol.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "turmspitze" }),
    "Du hast die Turmspitze errreicht. Luminor, Dein endgueltiges Ziel, "
    "befindet sich im Norden.");
  AddDetail( ({ "luminor" }),
    "Du naeherst Dich Luminor immer mehr.");
  AddDetail( ({ "ziel" }),
    "Du hast es fast geschafft.");
  AddDetail( ({ "skelette" }),
    "Die Skelette sind schon etwas aelter als die uebrigen Leichen. Haut und "
    "Fleisch sind schon komplett zerfallen.");
  AddDetail( ({ "haut" }),
    "Die Skelette haben keine Haut mehr.");
  AddDetail( ({ "fleisch" }),
    "Das Fleisch ist schon komplett zerfallen. Nur noch Knochen sind uebrig.");
  AddDetail( ({ "knochen" }),
    "Einige Knochen weisen Bissspuren auf.");
  AddDetail( ({ "bissspuren", "spuren" }),
    "Du scheinst Dich getaeuscht zu haben. Das Fleisch hatte gar keine Zeit, "
    "zu zerfallen ...");
  AddSpecialDetail( ({ "zeit" }), "strZeit");
  AddDetail( ({ "leichen" }),
    "Einige Leichen wurden gepfaehlt. Durch die langen Speere im Boden werden "
    "sie weiterhin aufrecht gehalten. Gepfaehlt zu werden ist einer der "
    "grausamsten Tode, die Du Dir vorstellen kannst.");
  AddDetail( ({ "speere" }),
    "Lange Speere wurden im Boden befestigt. Sie werden zum Pfaehlen gefangener "
    "Abenteurer verwendet.");
  AddDetail( ({ "tode", "tod" }),
    "So moechtest Du wahrlich nicht sterben.");
  AddDetail( ({ "pfaehlen" }),
    "Das moechtest Du gar nicht so genau wissen.");
  AddDetail( ({ "abenteurer" }),
    "Nur die mutigsten und staerksten Abenteurer schafften es bis hierher. "
    "Und dennoch endete fuer viele der Weg hier.");
  AddDetail( ({ "weg" }),
    "Dein Weg jedoch fuehrt noch weiter.");
  AddDetail( ({ "boden" }),
    "Einige Speere wurden in den Boden gerammt. Ueberall liegen Leichen, "
    "Knochen und verbeulte Ruestungen.");
  AddDetail( ({ "ruestungen" }),
    "Zwischen all dem Unrat erkennst Du auch einige verbeulte Ruestungen. "
    "Keine von ihnen scheint noch etwas zu nuetzen.");
  AddDetail( ({ "unrat" }),
    "Jede Menge Unrat liegt auf dem Boden zerstreut. Verbeulte Ruestungen, "
    "zerbrochene Waffen - Vielleicht findest Du ja doch noch etwas Brauchbares?");
  AddDetail( ({ "menge" }),
    "Jede Menge Unrat liegt zwischen den Leichen auf dem Boden.");
  AddDetail( ({ "etwas", "brauchbares" }),
    "Ohne suchen wird das aber nichts.");
  AddDetail( ({ "waffen" }),
    "Zwischen dem ganzen Unrat kannst Du einige zerbrochene Schwerter und "
    "zerrissene Peitschen ausmachen.");
  AddDetail( ({ "schwerter" }),
    "Keines ist ganz geblieben.");
  AddDetail( ({ "peitschen" }),
    "Von den Peitschen und Schwertern - einstmals maechtige Waffen - ist "
    "nicht viel uebrig geblieben.");
  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du denn genau?");
  AddDetail( ({ "westwand", "westen" }),
    "Im Westen fuehrt der Gang wieder hinaus.");
  AddDetail( ({ "gang" }),
    "Folge ihm in die Freiheit, wenn Du willst.");
  AddDetail( ({ "nordwand", "norden" }),
    "Im Norden befindet sich eine einfache Tuer mit einem "
    "Dir fast schon vertrauten Symbol.");
  AddDetail( ({ "freiheit" }),
    "Wenn Du den Turm wieder verlassen willst, folge einfach dem Gang im Westen.");
  AddDetail( ({ "ostwand", "suedwand" }),
    "Die Sued- und Ostwand sind mit roten Kritzeleien beschmiert.");
  AddDetail( ({ "kritzeleien" }),
    "Du bist Dir sicher, dass es Blut ist.");
  AddDetail( ({ "blut" }),
    "Die Kritzeleien wurden mit Blut an die Wand geschmiert. Mit Sicherheit "
    "war es das Blut der hier Gefallenen.");
  AddDetail( ({ "sicherheit" }),
    "Du bist Dir absolut sicher das es ihr Blut war.");
  AddDetail( ({ "blut" }),
    "Zugegeben, rote Farbe ist schwer zu bekommen.");
  AddDetail( ({ "farbe", "rot" }),
    "Das leuchtendste Rot hat nur Blut.");
  AddDetail( ({ "gefallenen" }),
    "Die Gefallenen haben ihr Blut nicht freiwillig gespendet.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir. Du kannst nicht genau erkennen, "
    "aus welchem Gestein sie besteht.");
  AddDetail( ({ "gestein" }),
    "Du kannst nicht genau bestimmen, welches Gestein es ist. Du bist Dir "
    "lediglich sicher, dass es kein Obsidiangestein ist.");
  AddDetail( ({ "obsidiangestein", "obsidian" }),
    "Nahezu das komplette Stockwerk unter Dir bestand aus Obsidian.");
  AddDetail( ({ "stockwerk" }),
    "Das Stockwerk unter Dir bestand nahezu komplett aus Obsidian.");
  AddDetail( ({ "turm" }),
    "Jede Deiner Bewegungen in diesem Turm wird genau ueberwacht.");
  AddDetail( ({ "bewegungen" }),
    "Luminor weiss genau, dass Du kommst.");
  AddDetail( ({ "sonnensymbol", "symbol" }),
    "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
    "Strahlen rundherum.");
  AddDetail( ({ "kreis" }),
    "Der Kreis mit den wellenfoermigen Strahlen soll die Sonne "
    "darstellen.");
  AddDetail( ({ "strahlen" }),
    "Wellenfoermige Strahlen sind um den Kreis herum abgebildet.");
  AddDetail( ({ "sonne" }),
    "Die Sonne gilt auch als Symbol fuer Feuer.");
  AddDetail( ({ "feuer" }),
    "Die Sonne mit ihren gluehenden Strahlen steht fuer das niemals "
    "erloeschende Feuer.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Tuer befindet sich ein Sonnensymbol, wie Du es schon "
    "haeufiger in diesem Turm gesehen hast.");
  AddDetail( ({ "nase" }),
    "Deine Nase muss hier ganz schoen was erdulden.");

  AddReadDetail( ({ "kritzeleien" }),
    "Du bist Dir nicht sicher was dort geschrieben steht.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das durchdringende Kreischen von Gespenstern.");

  AddSound( ({ "kreischen" }),
    "Dich schauderts.");
  AddSound( ({ "gespenster" }),
    "Bist Du ihnen schon begegnet?");

  AddSmell( DEFAULT_SMELL,
    "Die verwesenden Leichen verursachen bei Dir einen Brechreiz.");

  AddSmell( ({ "leichen" }),
    "Die Leichen verstroemen einen intensiven Verwesungsgeruch.");
  AddSmell( ({ "brechreiz" }),
    "Du haeltst Dir schnell die Nase zu.");
  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Dir wird schlecht.");

  AddExit( "westen", W );

  NewDoor("norden", N , ({"tuer"}) ,
  ({  DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Tuer.",
      D_LONG, "Eine einfache Tuer mit einem, Dir schon vertraut vorkommendem "
              "Symbol in der Mitte.",
      D_NAME,  "Tuer",
      D_GENDER,FEMALE,
      D_RESET_CLOSEMSG,
                  " im Sueden ist zugefallen!\n"
    })
  );

  AddItem( NPC "gespenst", REFRESH_DESTRUCT);
  AddItem( NPC "gespenst", REFRESH_DESTRUCT);
  AddItem( NPC "pfaehler", REFRESH_DESTRUCT);


}

string strZeit(string key)
{
  return TP->command_me("zeit");
}