  AddCmd( "taste|tast&auge|auge&ab", "cmdtasten",
          "Was willst Du abtasten?|Was willst Du ABtasten?" );
  AddCmd( "druecke|drueck&auge", "cmddruecken",
          "Was willst Du druecken?" );

}

int filter_lebewesen(object ob)
{
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1; // alle Spieler
 
  return 0;   // Rest wird aussortiert
}

void flamme(int msg)
{
  object *inhalt; 
  object player;
  int i;
  inhalt = all_inventory(TO); // Wer befindet sich alles im Raum
  inhalt = filter_array(inhalt, "filter_lebewesen"); // nur spieler behalten

  if (msg < 2)
  {
    if(random(2))
    {
      tell_room(TO, BS("Du wirst voll getroffen!")); 
      for (i =0; i<sizeof(inhalt); i++)
      {
        player = inhalt[i];
        if(player)
        {
          player->Defend(50+random(50), DT_FIRE, 1, TO);
        }
      }
    }
    else
    {
      tell_room(TO, BS("Du weichst der Flammensaeule aus!"));
    }
    return;
  }
}

// Die Tuer laesst sich nur mit dem Auge oeffnen
int tueroeffnen()
{
  write(BS("Ohne Klinke oder Schloss wird das nichts. Du wirst wohl einen anderen "
          +"Weg finden muessen."));
  return 1;
}

// Die Tuer laesst sich nicht schliessen
int tuerschliessen()
{
  write(BS("Du zerrst an der Tuer herum, schaffst es aber nicht sie zu schliessen!"));
  return 1;
}

// Das Portal laesst sich nur mit Feuer oeffnen
int portaloeffnen()
{
  write(BS("Du stemmst Dich gegen das Portal. Es ruehrt sich aber kein Stueck von der "
          +"Stelle!"));
  return 1;
}

// Das Portal laesst sich nicht schliessen
int portalschliessen()
{
  write(BS("So ein schweres Portal kannst Du unmoeglich wieder schliessen!"));
  return 1;
}

// Anzuenden des Portals
int cmdzuenden(string str )
{
  object dest, fackel;
  call_other (N, "???", 0);
  dest = find_object(N);

  fackel = present("fackel",TP);
  if( !fackel )
  {
    write(BS("Du hast gar keine Fackel!"));
    return -1;
  } 

  if(!(fackel->_query_lighted()))
  {
    write(BS("Wie waers mit einer angezuendeten Fackel?"));
    return -1;
  }

  if (DOOR_MASTER->QueryDoorStatus(N)==D_STATUS_CLOSED)
  {
    
    write(BS("Du zuendest das Portal an!"));
    Message(BS(TP->Name()+" zuendet das Portal an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    Message(BS("Langsam oeffnet sich das Portal."), MSGFLAG_VISUAL);
    
    if(dest)
    {
      dest->Message(BS("Das Portal faengt ploetzlich an zu brennen und oeffnet sich."));
    }
    
    DOOR_MASTER->SetDoorStatus(N, D_STATUS_OPEN);
    return 1;
  }
  else 
  {
    write("Aber das Portal brennt doch schon?\n");
    return -1;
  }
}

// Auge abtasten
int cmdtasten(string str )
{
  write(BS("Als Du das Auge abtastest schliesst es sich ploetzlich. Es scheint keine "
          +"Beruehrungen zu moegen."));
  return 1;
}

// Auge druecken
int cmddruecken(string str )
{
  object dest;
  call_other (S, "???", 0);
  dest = find_object(S);

  if (DOOR_MASTER->QueryDoorStatus(S)==D_STATUS_CLOSED)
  {
    write(BS("Du drueckst das Auge."));
    Message(BS(TP->Name()+" hantiert an der Tuer herum."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    Message(BS("Ploeztlich zieht sich das Auge zurueck und die Tuer oeffnet sich!"), MSGFLAG_VISUAL);
    
    if(dest)
    {
      dest->Message(BS("Die Tuer oeffnet sich ploetzlich."));
    }
    
    DOOR_MASTER->SetDoorStatus(S, D_STATUS_OPEN);
    return 1;
  }
  else 
  {
    write("Aber die Tuer ist doch schon offen?\n");
    return -1;
  }
}