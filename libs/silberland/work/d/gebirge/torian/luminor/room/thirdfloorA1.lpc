
inherit "std/room";

#include "../def.h"

#define UNTEN ROOM "secondfloorA1"
#define S ROOM "thirdfloorA2"

int gargyl;

create()
{
  ::create();

  gargyl = DA;

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Turmspitze. Ueberall liegen Skelette und "
    "Leichen herum. Die Ost- und Westwand werden von zwei Gargylen dominiert. "
    "Im Sueden fuehrt der Gang weiter ins Ungewisse.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "turmspitze" }),
    "Endlich hast Du die Turmspitze errreicht. Luminor kann nicht mehr "
    "weit sein.");
  AddDetail( ({ "luminor" }),
    "Du naeherst Dich Luminor immer mehr.");
  AddDetail( ({ "skelette" }),
    "Die Skelette sind schon etwas aelter als die uebrigen Leichen. Haut und "
    "Fleisch sind schon komplett zerfallen.");
  AddDetail( ({ "haut" }),
    "Die Skelette haben keine Haut mehr.");
  AddDetail( ({ "fleisch" }),
    "Das Fleisch ist schon komplett zerfallen. Nur noch Knochen sind uebrig.");
  AddDetail( ({ "knochen" }),
    "Einige Knochen weisen Bissspuren auf.");
  AddDetail( ({ "bissspuren", "spuren" }),
    "Du scheinst Dich getaeuscht zu haben. Das Fleisch hatte gar keine Zeit, "
    "zu zerfallen ...");
  AddDetail( ({ "zeit" }),
    "Wieviel Zeit bleibt Dir noch?");
  AddDetail( ({ "leichen" }),
    "Einige Leichen wurden gepfaehlt. Durch die langen Speere im Boden werden "
    "sie weiterhin aufrecht gehalten. Gepfaehlt zu werden ist einer der "
    "grausamsten Tode, die Du Dir vorstellen kannst.");
  AddDetail( ({ "speere" }),
    "Lange Speere wurden im Boden befestigt. Sie werden zum Pfaehlen gefangener "
    "Abenteurer verwendet.");
  AddDetail( ({ "tode", "tod" }),
    "So moechtest Du wahrlich nicht sterben.");
  AddDetail( ({ "pfaehlen" }),
    "Das moechtest Du gar nicht so genau wissen.");
  AddDetail( ({ "abenteurer" }),
    "Nur die mutigsten und staerksten Abenteurer schafften es bis hierher. "
    "Und dennoch endete fuer viele der Weg hier.");
  AddDetail( ({ "weg" }),
    "Dein Weg jedoch fuehrt noch weiter.");
  AddDetail( ({ "ostwand", "westwand" }),
    "Die Ost- und Westwand werden von zwei riesigen Gargylen eingenommen.");
  AddSpecialDetail( ({ "gargylen", "onyxgargylen" }), "strGargylen");
  AddDetail( ({ "onyx" }),
    "Die Gargylen bestehen komplett aus Onyx. Du wunderst Dich, wer auf die "
    "Idee kommen koennte, Gargylen aus Onyx zu fertigen.");
  AddDetail( ({ "idee" }),
    "Der Bildhauer hat nicht nur die Augen aus Onyx gefertigt, sondern auch "
    "die gesamte Statue.");
  AddDetail( ({ "bildhauer" }),
    "Wer das wohl war?");
  AddDetail( ({ "statue" }),
    "Die Onyxgargylen sehen sehr lebensecht aus.");
  AddDetail( ({ "augen" }),
    "Du hast das Gefuehl, als wuerden Dich die Augen die gesamte Zeit ueber "
    "beobachten.");
  AddDetail( ({ "gefuehl" }),
    "Kein neues Gefuehl in diesem Turm.");
  AddDetail( ({ "turm" }),
    "Jede Deiner Bewegungen in diesem Turm wird genau ueberwacht.");
  AddDetail( ({ "bewegungen" }),
    "Luminor weiss genau, dass Du kommst.");
  AddDetail( ({ "fluegel" }),
    "Die Fluegel sind eng an den Koerper geschmiegt.");
  AddDetail( ({ "koerper" }),
    "Der Koerper scheint sehr widerstandsfaehig zu sein.");
  AddDetail( ({ "krallen" }),
    "Die Krallen sind tief in die Steinsaeulen eingegraben.");
  AddDetail( ({ "saeulen", "steinsaeulen" }),
    "Die Steinsaeulen sehen sehr stabil aus. Dennoch sind die Krallen tief "
    "in sie eingegraben.");
  AddDetail( ({ "sueden" }),
    "Im Sueden fuehrt der Gang weiter ins Ungewisse.");
  AddDetail( ({ "gang" }),
    "Wenn Du wissen moechtest was dort liegt, dann geh hin!");
  AddDetail( ({ "ungewisse" }),
    "Nichts genaues weiss man nicht.");
  AddDetail( ({ "boden" }),
    "Einige Speere wurden in den Boden gerammt. Ueberall liegen Leichen, "
    "Knochen und verbeulte Ruestungen.");
  AddDetail( ({ "ruestungen", "ruestung" }),
    "Die Ruestungen gehoerten wohl einstmals maechtigen Abenteurern. "
    "Jede einzelne von ihnen wurde schwer beschaedigt oder zerfetzt.");
  AddDetail( ({ "waende", "wand" }),
    "Welche Wand meinst Du genau?");
  AddDetail( ({ "suedwand" }),
    "Im Sueden befindet sich keine Wand.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir. Du kannst nicht genau erkennen, "
    "aus welchem Gestein sie besteht.");
  AddDetail( ({ "gestein" }),
    "Du kannst nicht genau bestimmen, welches Gestein es ist. Du bist Dir "
    "lediglich sicher, dass es kein Obsidiangestein ist.");
  AddDetail( ({ "obsidiangestein" }),
    "Nahezu das komplette Stockwerk unter Dir bestand aus Obsidian.");
  AddDetail( ({ "stockwerk" }),
    "Das Stockwerk unter Dir bestand nahezu komplett aus Obsidian.");
  AddDetail( ({ "feuer" }),
    "Du siehst keins.");
  AddDetail( ({ "obsidian" }),
    "Feuer kann diesem Gestein nichts anhaben.");
  AddDetail( ({ "nordwand" }),
    "Im Norden fuehrt die Treppe wieder nach unten.");
  AddDetail( ({ "treppe" }),
    "Die Treppe im Norden fuehrt wieder nach unten.");
  AddDetail( ({ "nase" }),
    "Deine Nase muss hier ganz schoen was erdulden.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das durchdringende Kreischen von Gespenstern.");

  AddSound( ({ "kreischen" }),
    "Dich schauderts.");
  AddSound( ({ "gespenster" }),
    "Ihnen wirst Du wohl bald begegnen.");

  AddSmell( DEFAULT_SMELL,
    "Die verwesenden Leichen verursachen bei Dir einen Brechreiz.");

  AddSmell( ({ "leichen" }),
    "Die Leichen verstroemen einen intensiven Verwesungsgeruch.");
  AddSmell( ({ "brechreiz" }),
    "Du haeltst Dir schnell die Nase zu.");
  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Dir wird schlecht.");

  AddExit( "unten", "die Treppe hinunter#" +  UNTEN);
  AddExit ("sueden", ([ EX_DEST:     S,
                         EX_TESTFUNC: "exit_test" ]) );

  AddItem( NPC "leiche", REFRESH_DESTRUCT);
  AddCmd( "zerstoer|zerstoere&gargyl|gargylen", "cmdzerstoere",
          "Was willst Du zerstoeren?" );

}

//Falls Gargylen nicht zerstoert ...
int exit_test(string dir)
{

    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    if(IS_LEARNER(TP)) return 1;

    if(present("onyxgargyl"))
    {
      write(BS("Der Onyxgargyl laesst Dich nicht passieren!"));
      say(BS(TP->Name()+" wird von einem Onyxgargyl aufgehalten!"));
      return 0;
    }
    if(gargyl == DA)
    {
      write(BS("Die Onyxgargylen breiten ihre Schwingen aus und greifen Dich an!"));
      AddItem( NPC "onyxgargyl", REFRESH_NONE);
      AddItem( NPC "onyxgargyl", REFRESH_NONE);

      RemoveDetail( "augen");

      gargyl = WEG;
      return 0;
    }
    
    return 1;
}

// Gargylen mit einer Waffe zerstoeren
int cmdzerstoere(string str)
{
  object waffe;
  string waffentyp, s;
  waffe = TP->QueryProp(P_WEAPON);
  
  if(present("onyxgargyl"))
  {
    write(BS("Die Gargylen weichen Dir geschickt aus."));
    return -1;
  }
  
  if (gargyl == WEG)
  {
  	write(BS("Die Gargylen liegen bereits zertruemmert vor Dir."));
  	return -1;
  }

  if(!waffe)
  {
  	write(BS("Ohne eine gezueckte Waffe wird das nichts!"));
    return -1;
  }
  
  waffentyp = waffe->QueryProp(P_WEAPON_TYPE);

  if(-1 == member(({WT_AXE,WT_SWORD,WT_CLUB,WT_CHAIN}),waffentyp))
  {
      write(BS("Deine Waffe ist dafuer nicht geeignet!"));
      return -1;
  }

  // Waffe wird dabei beschaedigt
  waffe->TakeFlaw(100);
  
  write(BS("Du versuchst die Gargylen zu zerstoeren, beschaedigst aber "
            +"lediglich Deine Waffe."));
  Message(BS(TP->Name()+" versucht die Gargylen zu zerstoeren, beschaedigt aber "
           +"nur seine Waffe dabei."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;

}

reset()
{
  ::reset();

  if(gargyl == WEG)
  {
    Message(BS("Die Onyxgargylen setzen sich wieder zusammen!"), MSGFLAG_VISUAL);

    gargyl = DA;
  }

}

string strGargylen(string key)
{
  if(gargyl == DA)
  {

    return BS("Die Gargylen bestehen komplett aus Onyx. Ihre Fluegel sind "
             +"eingeklappt. Die Krallen sind tief in die Saeulen, auf denen sie "
             +"hocken, eingegraben.");
  }
  else
  {
    return BS("Von den Gargylen ist nicht viel uebriggeblieben.");
  }
}