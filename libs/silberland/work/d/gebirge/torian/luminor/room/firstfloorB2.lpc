// Schild ueber den Abgrund gelegt?
string _query_int_long()
{
  string s;
  s =  "In der Mitte des Raumes befindet sich eine Feuerstelle. Ausserdem stehen einige "
      +"Faesser in der Ecke gefuellt mit uebelriechendem Gebraeu. Offensichtlich ist das "
      +"hier der Hauptaufenthaltsort der Oniwachen. Im Osten versperrt ein Abgrund den "
      +"weiteren Weg";
  if(schild == DA)
     s += ", irgendwer hat ein grosses Turmschild darueber gelegt.";
  else
    s += ".";

  return BS(s);
}

string strTiefe(string key)
{
  return BS("Du schaetzt ungefaehr "+random(5)+5+" Meter.");
}

string strSound(string key)
{
  string s;
  if(present("oni"))
  {
    s = "Aufgrund der laut grunzenden Onis kannst Du fast das Knistern des Feuers "
       +"nicht hoeren.";
  }
  else
  {
    s = "Du hoerst das Knistern des Feuers.";
  }
  return BS(s);
}

string strOni(string key)
{
  string s;
  if(present("oni"))
  {
    s = "Die Onis grunzen laut.";
  }
  else
  {
    s = "Es sind doch gar keine Onis da?";
  }
  return BS(s);
}

string strGestank(string key)
{
  TP->command_me("wuerge");
  return "";
}

// ueberlegen wie man ueber den abgrund kommen kann ...
int cmdueberlegen(string str )
{
  string race, s;
  race = TP->QueryProp(P_RACE);
 
  // Wenn das Schild bereits da ist besteht kein Grund noch einen Weg zu suchen
  if(schild == DA)
  {
     s = "Irgendwer hat ein grosses Turmschild ueber den Abgrund gelegt, der "
        +"Weg ist nun frei.";
     write(BS(s));
     return 1;
  }

  switch(race)
  {
    case "Dunkelelf" :
    case "Mensch" :
    case "Elf" :
    case "Untoter" :
      s = "Mit ein wenig Glueck koennte ich rueberspringen.";
     break;
    case "Hobbit" :
    case "Zwerg" :
      s = "Zum springen zu weit ... ich muss mir wohl eine Art Bruecke bauen.";
      break;
    case "Troll" :
    case "Oger" :
      s = "Ueber den kleinen Abgrund spring ich doch locker rueber.";
      break;
    case "Fee" :
      s = "Wozu habe ich Fluegel?";
      break;
    default :
      s = "Was fuer eine Rasse bist Du denn? Sollte Torian Deine Rasse "
         +"tatsaechlich uebersehen haben, wende Dich doch bitte kurz an ihn.";
      break;
  }

  write(BS("Du denkst . o O ("+s+")"));
  return 1;
}

// Schild ueber den Abgrund legen -> einfach osten gehen danach
int cmdlegen(string str)
{
  object myschild;
  object dest;
  call_other (O, "???", 0);
  dest = find_object(O);

  notify_fail( "Was willst Du wohin legen?\n" );
  if(!(str=="schild ueber abgrund") && !(str =="turmschild ueber abgrund")) return 0;
  
  myschild = present(SCHILD, TP);
  if(!myschild)
  {
    write(BS("Du hast gar kein passendes Schild!"));
    return -1;
  }
  
  if(schild == WEG)
  {
    write(BS("Du legst das Turmschild ueber den Abgrund. Nun kannst Du einfach "
            +"nach Osten gehen."));
    TO->Message(BS(TP->Name()+" hantiert am Abgrund herum."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);          
    dest->Message("Jemand legt von der anderen Seite ein Schild ueber den Abgrund.\n", MSGFLAG_VISUAL);
    myschild->remove();
    SetSchild();
  }
  else
  {
    write(BS("Aber dort liegt doch schon ein Schild ueber dem Abgrund?"));
  }


  return 1;
}

// falls jemand seine Sachen von unten will
int cmdklettern(string key)
{
  object raum;
  write(BS("Du kletterst in den Abgrund hinunter, rutschst dabei aber leider aus."));
  call_other (ABGRUND, "???", 0);
  raum = find_object(ABGRUND);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "in den Abgrund",
                     "stuerzt", "stuerzt herein");
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
  }

  SetProp(P_KILL_NAME, "Ein Sturz in den Abgrund" );
  TP->do_damage(20+random(20), this_object());

  return 1;
}

// Gebraeu trinken
int cmdtrinken(string str )
{
  if(!TP->drink_alcohol(10))
  {
  	return -1;
  }

  if(countdrink > MAX_DRINK)
  {
    write("Es ist fast nichts mehr da!\n");
    return -1;
  }

  write(BS("Du nimmst einen tiefen Zug und musst Dich fast uebergeben."));
  TO->Message(BS(TP->Name(WER, 1)+" nimmt einen tiefen Zug von dem Gebraeu."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->AddHp(15+random(10));
  PL->AddPoison(1);
  return 1;
}

int cmddrehen(string str)
{
  write(BS("Du drehst den Braten gleichmaessig ueber dem Feuer."));
  TO->Message(BS(TP->Name(WER, 1)+" dreht den Braten gleichmaessig ueber dem Feuer."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

// Braten essen
int cmdessen(string str)
{
  if(!TP->eat_food(5))
  {
  	return -1;
  }

  if(countbraten > MAX_BRATEN)
  {
    write(BS("Es ist fast nichts mehr da von dem leckeren Hobbit!"));
    return -1;
  }
  
  write(BS("Du stellst fest: Hobbit schmeckt gar nicht so schlecht."));
  TO->Message(BS(TP->Name(WER, 1)+" isst ein wenig von dem Braten."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->heal_self(10+random(20));
  countbraten++;
  return 1;

}

reset()
{
  object dest;
  call_other (O, "???", 0);
  dest = find_object(O);

  ::reset();

  countbraten=1;
  countdrink = 1;
  if(schild == DA)
  {
    TO->Message("Ploetzlich faellt das Schild in die Tiefe.\n", MSGFLAG_VISUAL);
    schild = WEG;
    RemoveDetail(({ "schild", "turmschild" }));
  
    if(dest)
    {
      dest->Message("Ploetzlich faellt das Schild in die Tiefe.\n", MSGFLAG_VISUAL);
      dest->RemoveDetail(({ "schild", "turmschild" }));
    }
  }

}

//Weg frei?
int exit_test(string dir)
{

  if(!TP)              return 0;
  if(!interactive(TP)) return 0;

  if(schild == WEG)
  {
    fktabgrund(TP);
    return 0;
  }

  return 1;
}

// Ueber den Abgrund springen
int cmdspringen(string str)
{
  object raum;
  string race, s;
  race = TP->QueryProp(P_RACE);
 
  // Wenn das Schild bereits da ist besteht kein Grund noch zu springen
  if(schild == DA)
  {
     s = "Irgendwer hat ein grosses Turmschild ueber den Abgrund gelegt, es besteht "
        +"kein Grund noch zu springen.";
     write(BS(s));
     return 1;
  }

  switch(race)
  {
    case "Dunkelelf" :
    case "Mensch" :
    case "Elf" :
    case "Untoter" :
      if(random(2))
      {
        write(BS("Du schaffst es leider nicht ueber den Abgrund!"));
        fktabgrund(TP); // hilfsfunktion fuers abstuerzen
        return 1;
      }
      else
      {
        write(BS("Du schaffst es gerade so ueber den Abgrund!"));
      }
     break;
    case "Hobbit" :
    case "Zwerg" :
      write("Bist Du sicher das Du das tun willst???"
           +" \nSyntax: <springe ueber abgrund trotz warnung>");
      return 1;
    case "Troll" :
    case "Oger" :
      write(BS("Du springst locker ueber den kleinen Abgrund."));
      break;
    case "Fee" :
      write(BS("Springen? Und was machen Deine Fluegel dabei?"));
      return 1;
    default :
      write(BS("Was fuer eine Rasse bist Du denn? Sollte Torian Deine Rasse "
               +"tatsaechlich uebersehen haben, wende Dich doch bitte kurz an ihn."));
      return 1; 
  }
  // spieler moven
  call_other (O, "???", 0);
  raum = find_object(O);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "ueber den Abgrund",
                     "springt", "springt herein");
    return 1;
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
    return -1;
  }
}

// Hilfsfunktion fuer den Abgrund
void fktabgrund(object player)
{
  object raum;
  string s;
  int schaden;

  switch(random(4))
  {
    case 0:
      s = "keinen Holzpfloecken aufgespiesst! Du prallst lediglich hart auf, "
         +"Glueck gehabt.";
      schaden = 0;
      break;
    case 1:
      s = "einigen Holzpfloecken aufgespiesst!";
      schaden = 50;
      break;
    case 2:
      s = "vielen Holzpfloecken aufgespiesst!!";
      schaden = 100;
      break;
    default:
      s = "sehr vielen Holzpfloecken aufgespiesst!!!";
      schaden = 150;
      break;
  }
  

  write("\nDu stuerzt in die Tiefe und wirst von "+s+"\n\n");

  call_other (ABGRUND, "???", 0);
  raum = find_object(ABGRUND);
  if(raum)
  {
      TP->move(raum, M_NO_SHOW|M_NOCHECK, "in den Abgrund",
                     "stuerzt", "stuerzt herein");
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
  }

  SetProp(P_KILL_NAME, "Ein Sturz in den Abgrund" );  
  player->do_damage(schaden+random(50), this_object());

  return;
}

int cmdselbstmordspringen(string key)
{
  if(TP->QueryProp(P_RACE)=="Hobbit" || TP->QueryProp(P_RACE)=="Zwerg")
  {
    write(BS("Du schaffst es nichtmal bis zur Mitte des Abgrunds."));
    fktabgrund(TP); // hilfsfunktion fuers abstuerzen
    return 1;  
  }
  else
  {  
    cmdspringen(key);
    return 1;
  }
}


// Ueber den Abgrund fliegen
int cmdfliegen(string str)
{
  object raum;
  string race;

  // Feen koennen
  if(TP->QueryProp(P_RACE)=="Fee")
  {
    write(BS(""));
    // spieler moven
    call_other (O, "???", 0);
    raum = find_object(O);
    if(raum)
    {
        TP->move(raum, M_NO_SHOW|M_NOCHECK, "ueber den Abgrund",
                       "flattert", "flattert herein");
      return 1;
    }
    else
    {
      write("Fehler! Bitte melde ihn an Torian.\n");
      return -1;
    }
  }
 
  // Rest nicht ...
  // Wenn das Schild bereits da ist ...
  write(BS("Du breitest Deine Arme aus und ..."));
  if(schild == DA)
  {
     write(BS("... knallst voll auf das Schild!"));
     return 1;
  }
  else
  {
    fktabgrund(TP); // hilfsfunktion fuers abstuerzen
  }
}

int QuerySchild()
{
  return schild;
}

void SetSchild()
{
  AddDetail( ({ "schild", "turmschild" }),
   "Irgendwer hat ein grosses Turmschild ueber den Abgrund gelegt. Du kannst "
   "nun einfach noch Osten gehen.");

  schild = DA;

  return;
}
