
inherit "std/room";

#include "../def.h"

#define W ROOM "secondfloorB2"
#define N ROOM "secondfloorC1"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Direkt vor Dir befindet sich eine riesige brennende Saeule. An der Ost- und "
    "Suedwand haengen grosse flammenumhuellte Gemaelde. Im Norden gelangst Du zur "
    "Treppe nach unten und im Westen naeherst Du Dich Luminor immer mehr.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "saeule" }),
    "Die riesige Steinsaeule scheint ein Haupttraeger dieses Stockwerkes zu sein. "
    "Merkwuerdigerweise scheint die gesamte Saeule zu brennen. ");
  AddDetail( ({ "steinsaeule" }),
    "Die Saeule besteht aus Obsidian.");
  AddDetail( ({ "feuer" }),
    "Das Feuer ist hier allgegenwaertig.");
  AddDetail( ({ "obsidian" }),
    "Feuer kann diesem Gestein nichts anhaben.");
  AddDetail( ({ "gestein" }),
    "Obsidian.");
  AddDetail( ({ "haupttraeger" }),
    "Die Saeule traegt das dritte Stockwerk ohne Probleme.");
  AddDetail( ({ "probleme" }),
    "So eine dicke Saeule hat damit keine Probleme.");
  AddDetail( ({ "stockwerk", "2. stockwerk", "zweites stockwerk" }),
    "Du befindest Dich zur Zeit im zweiten Stockwerk dieses Turmes.");
  AddDetail( ({ "zeit" }),
    "Nutze Deine Zeit weise. Wer weiss, wieviel Dir davon noch bleibt.");
  AddDetail( ({ "erstes stockwerk", "1. stockwerk" }),
    "Das erste Stockwerk befindet sich logischerweise unter Dir.");
  AddDetail( ({ "drittes stockwerk", "3. stockwerk" }),
    "Im dritten Stockwerk wartet Luminor auf sein neuestes Opfer.");
  AddDetail( ({ "luminor" }),
    "Du bist Luminor naeher, als Du denkst, er lauert schon auf sein neuestes Opfer.");
  AddDetail( ({ "opfer", "du" }),
    "Du!");
  AddDetail( ({ "turm", "turmes" }),
    "Luminor hat die Herrschaft ueber diesen Turm uebernommen.");
  AddDetail( ({ "herrschaft" }),
    "Luminor herrscht ueber diesen Turm und alle Einwohner.");
  AddDetail( ({ "einwohner" }),
    "Oni, Gespenster, Feuertrolle. Sie alle gehorchen Luminor!");
  AddDetail( ({ "oni", "feuertrolle" }),
    "Sie alle gehorchen Luminor!");
  AddDetail( ({ "gespenster" }),
    "Angeblich hausen von Luminor getoetete Abenteurer als Gespenster im "
    "dritten Stockwerk.");
  AddDetail( ({ "abenteurer" }),
    "Sie wurden von Luminor magisch an diese Welt gefesselt, um ihm zu dienen.");
  AddDetail( ({ "welt", "ruhe" }),
    "Die Gespenster finden in dieser Welt keine Ruhe und greifen alles an.");
  AddDetail( ({ "ostwand", "osten", "suedwand", "sueden" }),
    "An der Ost- und Suedwand haengen grosse flammenumhuellte Gemaelde.");
  AddDetail( ({ "gemaelde" }),
    "Der Rahmen der Gemaelde scheint ausschliesslich aus Flammen zu bestehen. "
    "Auf einem der Gemaelde erkennst Du einen riesigen Daemonen auf einem Berg "
    "aus Schaedeln und Knochen.");
  AddDetail( ({ "rahmen" }),
    "Der Rahmen besteht komplett aus Flammen. Er verleiht dem Gemaelde einen noch "
    "unheimlicheren Eindruck. ");
  AddDetail( ({ "eindruck" }),
    "Dich schauderts.");
  AddDetail( ({ "daemon", "daemonen" }),
    "Dieser riesige Daemon ist mit Sicherheit Luminor. Es faellt Dir schwer, Deinen "
    "Blick von seinen Augen abzuwenden.");
  AddDetail( ({ "sicherheit" }),
    "Du bist Dir absolut sicher.");
  AddDetail( ({ "blick" }),
    "Du kannst Deinen Blick kaum von den Augen abwenden.");
  AddDetail( ({ "augen" }),
    "Die Augen mustern Dich durchdringend. Du hast das Gefuehl, dass Luminor "
    "bereits alles ueber Dich weiss.");
  AddDetail( ({ "gefuehl" }),
    "Du fuehlst Dich bei diesem Gedanken sehr unwohl.");
  AddDetail( ({ "gedanken", "gewalt" }),
    "Du zwingst Dich mit Gewalt, an etwas anderes zu denken.");
  AddDetail( ({ "berg" }),
    "Der Daemon sitzt auf einem sehr grossen Berg aus Knochen und Schaedeln.");
  AddDetail( ({ "schaedel" }),
    "Die Schaedel gehoerten wohl den Opfern Luminors. Sie starren Dich anklagend aus "
    "hunderten von leeren Augenhoehlen an.");
  AddDetail( ({ "augenhoehlen" }),
    "Du wendest Dich schnell ab.");
  AddDetail( ({ "knochen" }),
    "Die Knochen sehen angenagt und verbrannt aus.");
  AddDetail( ({ "norden" }),
    "Weiter im Norden befindet sich die Treppe nach unten.");
  AddDetail( ({ "westen" }),
    "Im Westen wird der Gang immer breiter. Du kannst foermlich spueren, wie Du "
    "Luminor immer naeher kommst.");
  AddDetail( ({ "gang" }),
    "Der Gang wird im Westen immer breiter.");
  AddDetail( ({ "treppe" }),
    "Die Treppe nach unten befindet sich weiter im Norden.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit verkohlten und verbrannten Stellen uebersaeht. Ab und zu "
    "zuengelt eine Flamme hoch.");
  AddDetail( ({ "stellen", "stelle" }),
    "Viele verkohlte und verbrannte Stellen uebersaehen den Boden.");
  AddDetail( ({ "waende", "wand" }),
    "An der Ost- und Suedwand haengen grosse flammenumhuellte Gemaelde. Im Norden "
    "gelangst Du zur Treppe nach unten und im Westen naeherst Du Dich Luminor immer "
    "mehr.");
  AddDetail( ({ "decke" }),
    "Die Decke wird von der brennenden Saeule getragen. Auch die Decke ist vollkommen "
    "in Flammen gehuellt.");
  AddDetail( ({ "flammen", "flamme" }),
    "Die Flammen scheinen eher magischer Natur zu sein.");
  AddDetail( ({ "natur", "mutter" }),
    "Mit Mutter Natur hat Magie nur wenig zu tun.");
  AddDetail( ({ "magie" }),
    "Es scheint sich um magische Flammen zu handeln.");
  AddDetail( ({ "hitze" }),
    "Verdammt heiss hier.");
  AddDetail( ({ "ruecken", "schauer" }),
    "Die Geraeusche jagen Dir einen Schauer ueber den Ruecken.");

  AddSound( DEFAULT_SOUND,
    "Das allgegenwaertige Feuer knistert ab und zu. Ausserdem hoerst Du unheimliche "
    "Geraeusche aus dem Westen.");

  AddSound( ({ "knistern", "feuer" }),
    "Das Feuer knistert ab und zu.");
  AddSound( ({ "geraeusche" }),
    "Trotz der Hitze laeuft es Dir eiskalt den Ruecken runter.");
  AddSound( ({ "westen" }),
    "Wenn Du nur wuesstest, wer diese Geraeusche verursacht.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Feuer.");

  AddSmell( ({ "feuer" }),
    "Verbrannt.");

  AddExit( "westen", W );
  AddExit( "norden", N);

  AddRoomMessage( ({ "Eine grosse Flammensaeule schlaegt aus der Saeule!!!\n",
                     "Eine Flammensaeule schiesst zur Decke hinauf!\n",
                     "Eine kleine Flamme zischt hoch, erlischt aber sofort wieder.\n",
                     "Eine Flamme im Boden zuengelt hoch!\n"}), 30, "flamme" );

  AddItem( NPC "ftroll", REFRESH_REMOVE);
  AddItem( NPC "ftroll", REFRESH_REMOVE);

}

int filter_lebewesen(object ob)
{
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1; // alle Spieler
 
  return 0;   // Rest wird aussortiert
}

void flamme(int msg)
{
  object *inhalt; 
  object player;
  int i;
  inhalt = all_inventory(TO); // Wer befindet sich alles im Raum
  inhalt = filter_array(inhalt, "filter_lebewesen"); // nur spieler behalten

  if (msg < 2)
  {
    if(random(2))
    {
      tell_room(TO, BS("Du wirst voll getroffen!")); 
      for (i =0; i<sizeof(inhalt); i++)
      {
        player = inhalt[i];
        if(player)
        {
          player->Defend(50+random(50), DT_FIRE, 1, TO);
        }
      }
    }
    else
    {
      tell_room(TO, BS("Du weichst der Flammensaeule aus!"));
    }
    return;
  }
}