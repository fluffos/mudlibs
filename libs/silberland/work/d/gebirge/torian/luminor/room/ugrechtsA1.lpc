  AddDetail( ({ "sortiment" }),
    "Du zaehlst mindestens sieben verschiedene Groessen.");
  AddDetail( ({ "fingernagelabreisser" }),
    "Die kleinste der Zangen dient dazu, dem Opfer die Fingernaegel "
    "nacheinander abzureissen.");
  AddDetail( ({ "opfer" }),
    "Du fuerchtest Dich.");
  AddDetail( ({ "fingernaegel" }),
    "Blutige Fingernaegel kleben an einer der kleineren Zangen.");
  AddDetail( ({ "saegen" }),
    "Mit diesen speziellen Saegen koennen einzelne Gliedmassen vom "
