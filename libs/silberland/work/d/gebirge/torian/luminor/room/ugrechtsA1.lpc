  AddSound( DEFAULT_SOUND,
    "Das leise Stoehnen des Gefangenen auf der Streckbank zerrt an "
    "Deinen Nerven.");

  AddSound( ({ "stoehnen", "gefangene", "gefangener" }),
    "Der Gefangene stoehnt leise.");
  AddSound( ({ "streckbank" }),
    "Leises, gepeinigtes Stoehnen dringt von der Streckbank herueber.");
  AddSound( ({ "nerven" }),
    "Deine Nerven sind aeusserst angespannt.");

  AddSmell( DEFAULT_SMELL,
    "Ein stechender Geruch nach Tod durchdringt die Kammer.");

  AddSmell( ({ "geruch" }),
    "Es riecht nach Tod und Folter.");
  AddSmell( ({ "tod" }),
    "Der Tod lauert nicht weit von hier.");
  AddSmell( ({ "folter", "lebewesen" }),
