// Gefangenen befreien
int cmdbefreie(string str)
{
  notify_fail( "Wen willst Du befreien?\n" );

  if(-1 == member(({"gefangener","gefangenen"}),str))
  { return 0; }

  if(gefangener == DA)
  {
    write(BS("Wie willst Du den Gefangenen denn von den Fesseln befreien?"));
    return 1;
  }
  return 0;
}

// Gefangenen quaelen ;-)
int cmddrehen(string str)
{
  notify_fail( "Was willst Du drehen?\n" );

  if(!str || !(str == "kurbel")) { return 0; } 

  // Opfer da?
  if(gefangener == WEG)
  {
    write(BS("Es liegt doch gar keiner auf dem Streckbett!"));
    return -1;
  }
  // Opfer teilweise befreit?
  if(handfesseln == WEG)
  {
    write(BS("Du drehst an der Kurbel und der Gefangene wird in Richtung "
            +"Fussende gezogen. Verstoert starrt er Dich an. Loese lieber "
            +"auch die Fussfesseln!"));
    say(BS(TP->Name()+" dreht an der Kurbel und der Gefangene wird in Richtung "
           +"Fussende gezogen."));
    return -1;
  }
  // Opfer teilweise befreit?
  if(fussfesseln == WEG)
  {
    write(BS("Du drehst an der Kurbel und das Seil rollt sich auf dem Rad auf. "
            +"Ohne das das Seil an einem Opfer festgebunden ist bringt das wohl "
            +"nichts!"));
    say(BS(TP->Name()+" dreht an der Kurbel und das Seil rollt sich auf dem "
            +"Rad auf."));
    return -1;
  }
  write(BS("Voll daemonischer Schadenfreude drehst Du an der Kurbel. Der "
          +"Gefangene schreit gequaelt auf!"));
  say(BS(TP->Name()+" dreht voll daemonischer Schadenfreude an der Kurbel! "
          +"Der Gefangene schreit gequaelt auf!"));
  // Gesinnung senken?
  return 1;
}


// Fesseln wieder festmachen
int cmdbinden(string str)
{
  notify_fail( "Was willst Du festbinden, die Fuss- oder Handgelenke?\n" );

  // Handgelenke wieder festbinden
  if(str == "handgelenke fest" || str == "handgelenke")
  {
  	if(handfesseln == DA)
    {
      write(BS("Der Gefangene ist doch schon an den Haenden gefesselt!"));
      return -1;
    }
    else
    {
      write(BS("Du fesselst dem Gefangenen die Handgelenke. Aengstlich "
              +"starrt er Dich dabei an!"));
      say(BS(TP->Name()+" fesselt den Gefangenen die Handgelenke! "
          +"Aengstlich starrt der Gefangene "+TP->QueryPronoun(WEN)
          +" dabei an!"));
      handfesseln = DA;
      return 1;
    }
  }
  // Fussgelenke wieder festbinden
  if(str == "fussgelenke fest" || str == "fussgelenke")
  {
  	if(fussfesseln == DA)
    {
      write(BS("Der Gefangene ist doch schon an den Fuessen gefesselt!"));
      return -1;
    }
    else
    {
      write(BS("Du fesselst dem Gefangenen die Fussgelenke. Aengstlich "
              +"starrt er Dich dabei an!"));
      say(BS(TP->Name()+" fesselt den Gefangenen die Fussgelenke! "
          +"Aengstlich starrt der Gefangene "+TP->QueryPronoun(WEN)
          +" dabei an!"));
      fussfesseln = DA;
      return 1;
    }
  }
  return 0;
}

// Fesseln loesen
int cmdloesen(string str)
{
  string s, s2;

  notify_fail( "Was willst Du loesen?\n" );

  //Gefangener da?
  if(gefangener == WEG)
  {
    write(BS("Aber es ist doch gar kein Gefangener da dessen Fesseln Du "
            +"loesen koenntest!"));
    return -1;
  }

  if(str == "fesseln")
  {
    write(BS("Welche Fesseln meinst Du genau?"));
    return -1;
  }

  // Haende befreien
  if(str == "handfesseln" || str == "handgelenkfesseln" || str == "handgelenksfesseln")
  {
    if(handfesseln == DA)
    {
      s ="Vorsichtig loest Du die Handgelenksfesseln.";
      s2 = TP->name()+" loest vorsichtig die Handgelenksfesseln.";
      handfesseln = WEG;
      // Komplett befreit?
      if(CheckFrei())
      {
        write(BS(s +" Der Gefangene reibt seine wunden Handgelenke und steht "
                 +"komplett auf."));
        befreiungstext();
        say(BS(s2+" Der Gefangene reibt seine wunden Handgelenke und steht "
                +"komplett auf."));
        tell_room(TO, BS("Er deutet eine Verneigung an und verlaesst "
                +"schnell den Raum."));
      }
      else
      {
        write(BS(s +" Der Gefangene richtet sich ein wenig auf und reibt seine "
                 +"wunden Handgelenke."));
        say(BS(s2+" Der Gefangen richtet sich ein wenig auf und reibt seine wunden "
             +"Handgelenke."));
      }
      return 1;
    }
    else
    {
      write(BS("Die Handgelenksfesseln wurden schon geloest!"));
      return -1;
    }
  }

  // Fuesse befreien
  if(str == "fussfesseln" || str == "fussgelenkfesseln" || str == "fussgelenksfesseln")
  {
    if(fussfesseln == DA)
    {
      s = "Vorsichtig loest Du die Fussgelenksfesseln.";
      s2 = TP->name()+" loest vorsichtig die Fussgelenksfesseln.";
      fussfesseln = WEG;
      // Komplett befreit?
      if(CheckFrei())
      {
        write(BS(s +" Der Gefangene steht komplett auf."));
        befreiungstext(); // sieht nur der Befreier
        say(BS(s2+" Der Gefangene steht komplett auf."));
        tell_room(TO, BS("Er deutet eine Verneigung an und verlaesst "
                +"schnell den Raum."));
      }
      else
      {
        write(BS(s +" Der Gefangene sieht Dich erwartungsvoll an."));
        say(BS(s2+" Der Gefangene sieht "+TP->Name(WEN)+" erwartungsvoll an."));
      }
      return 1;
    }
    else
    {
      write(BS("Die Fussgelenksfesseln wurden schon geloest!"));
      return -1;
    }
  }
  return 0;
}

// Hilfsfunktion fuers Befreien
int CheckFrei()
{
  if((fussfesseln == WEG) && (handfesseln == WEG)) { return 1; }
  
  return 0;
}

// Hilfsfunktion fuers Befreien
void befreiungstext()
{    
  write(break_string("Danke, dass Ihr mich befreit habt. Ich weiss nicht, "
   +"ob es von Nutzen fuer Euch ist, aber waehrend meiner Befragung sah ich, "
   +"wie der Foltermeister das Bild Luminors zur Seite klappte. Vielleicht "
   +"befindet sich dort ja etwas Nuetzliches fuer Euch.",78,"Der Gefangene sagt: "));
  gefangener = WEG;
  AddRoomMessage( ({ ""}), 30);

  return;
}

string details_gefangener(string key)
{
  string s, s2;

  s = "";
  s2 = "Sowas siehst Du da nicht!";  
  
  switch(key)
  {
    case "streckbett":
    case "streckbank":
    case "kopfende":
    case "bett":
    case "bettes":
      if (handfesseln == DA)
      {
        s = "Der Gefangene ist mit seinen Handgelenken am Kopfende des Streckbettes "
         +"festgebunden, ";
      }
      else
      {
        s = "Der Gefangene ist von seinen Handgelenksfesseln am Kopfende des Streckbettes "
         +"befreit, ";
      }
      if (fussfesseln == DA)
      {
      	s += "waehrend von seinen Fussgelenken aus Seile bis zu einem "
            +"grossen Rad am Fussende hinueberlaufen.";
      }
      else
      {
     	s += "waehrend am Fussende ein paar Seile bis zu einem "
            +"grossen Rad hinueberlaufen.";
      }
      s2 = "Am Kopfende des Streckbettes befinden sich Handgelenksfesseln. Am "
          +"Fussende laufen ein paar Seile bis zu einem grossen Rad hinueber.";
      break;
    case "gefangener":
    case "gefangenen":
    case "gefangene":
      s = "Der Gefangene liegt lang ausgestreckt auf dem Streckbett und "
         +"stoehnt leise und qualvoll. Sein Koerper ist mit vielen blauen "
         +"Flecken und Bluterguessen uebersaeht. Seine weit geoeffneten Augen "
         +"blicken Dich angsterfuellt an. ";
      break;
    case "flecken": 
    case "blaue flecke":
    case "bluterguesse":
      s = "Der Koerper des Gefangenen ist mit vielen blauen Flecken und "
         +"Bluterguessen uebersaeht.";
      break;
    case "augen":
      s = "Du siehst den Schmerz in seinen Augen.";
      break;
    case "schmerz":
      s = "Der Gefangene stoehnt vor Schmerz.";
      break;
    case "seile":
    case "seil":
      s = "Die Fussgelenke des Gefangenen sind mit Seilen gefesselt, die bis "
         +"zu dem grossen Rad am Fussende des Bettes hinueberlaufen.";
      s2 = "Die Seile laufen bis zu dem grossen Rad am Fussende des Bettes.";
      break;
    default:
      s = s2;
      break;
  }
  if (gefangener == DA)
  {
    return BS(s);
  }
  else
  {
    return BS(s2);
  }
}

reset()
{
  ::reset();

  AddRoomMessage( ({ "Der Gefangene stoehnt leise.\n"}), 30);

  fussfesseln = DA;
  handfesseln = DA;
  gefangener = DA;
}