  AddDetail( ({ "hilfe", "zeitpunkt" }),
    "Spaetestens zu diesem Zeitpunkt ist dem Gefangenen kaum mehr zu helfen.");
  AddDetail( ({ "aushoehlungen" }),
    "Dort werden die Daumen des Opfers positioniert.");
  AddDetail( ({ "daumen" }),
    "Die Daumen werden in die Aushoehlungen des unteren Eisenstueckes gelegt.");
  AddDetail( ({ "schraube" }),
    "Mit einer Schraube werden die beiden Eisenstuecke zusammengeschraubt. "
    "Ueberraschend, oder?");
  AddDetail( ({ "tischplatte" }),
    "Die Daumenschrauben sind an der Tischplatte befestigt.");
  AddDetail( ({ "decke" }),
    "Direkt ueber Dir haengt ein grosser Metallkaefig von der Decke herunter.");
  AddDetail( ({ "metallkaefig", "kaefig" }),
    "Der Kaefig besteht aus rostigen Gitterstaeben und ist voellig leer. "
    "Der letzte Insasse ist wohl vor kurzem verstorben und entsorgt worden.");
  AddDetail( ({ "gitterstaebe" }),
    "Die Gitterstaebe sind blutverschmiert.");
  AddDetail( ({ "insasse" }),
    "Zur Zeit befindet sich niemand im Kaefig.");
  AddDetail( ({ "zeit" }),
    "Hoffentlich bist Du nicht der naechste.");
  AddDetail( ({ "wand" }),
    "An einer Wand steht ein schmales Streckbett mit einem Gefangenen darauf.");
  AddSpecialDetail( ({ "streckbett", "kopfende", "bett", "bettes",
                       "gefangener", "gefangene", "gefangenen",
                       "flecken", "blaue flecke", "bluterguesse",
                       "augen", "schmerz", "seile", "seil", "streckbank" }), 
                       "details_gefangener");
  AddDetail( ({ "rad" }),
    "Das grosse Rad hat eine Kurbel, mit der man es drehen kann.");
  AddDetail( ({ "kurbel" }),
    "Mit der Kurbel kann man das Rad drehen.");
  AddDetail( ({ "fussende" }),
    "Am Fussende des Streckbettes befindet sich ein grosses Rad.");
  AddDetail( ({ "waende" }),
    "An einer Wand steht ein schmales Streckbett, auf dem ein Gefangener "
    "liegt. An einer anderen Wand wurde eine kleine Halterung befestigt, "
    "an der ein abgenutztes Paar Fesseln haengt.");
  AddDetail( ({ "boden" }),
    "Der rauhe Steinboden ist mit vielen Blutflecken uebersaeht.");
  AddDetail( ({ "steinboden" }),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "blutflecken" }),
    "Die meisten der Blutflecken sind schon voellig eingetrocknet, doch "
