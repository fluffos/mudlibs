
inherit "std/room";

#include "../def.h"

#define N ROOM "erdgC2"
#define S ROOM "ugrechtsA2"

int fussfesseln, handfesseln, gefangener;

void befreiungstext();
int CheckFrei();

create()
{
  ::create();

  gefangener = DA;
  fussfesseln = DA;
  handfesseln = DA;

  SetProp( P_INT_SHORT, "In einer Folterkammer" );
  SetProp( P_INT_LONG,
    "Voellig entsetzt bemerkst Du, dass Du in einer kleinen, dunklen "
    "Folterkammer gelandet bist. Mitten in der Kammer steht ein langer "
    "Holztisch, auf dem viele unheimlich aussehende Werkzeuge liegen. "
    "An der Tischplatte sind Daumenschrauben befestigt. An einer Wand "
    "steht ein schmales Streckbett, auf dem ein Gefangener liegt und "
    "leise stoehnt. Von der Decke haengt ein Metallkaefig herunter.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "folterkammer" }),
    "Die Kammer ist sehr eng und dunkel. Ein stechender Geruch nach Tod "
