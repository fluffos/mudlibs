  AddDetail( ({ "handgelenke", "fussgelenke" }),
    "Mit den Fesseln werden die Hand- und Fussgelenke aneinander gefesselt.");
  AddDetail( ({ "halterung", "halterungen" }),
    "Du kannst die hierfuer vorgesehene Halterung an einer der Waende sehen.");
  AddDetail( ({ "position" }),
    "Es muss aeusserst unangenehm sein.");
  AddDetail( ({ "schaedelquetsche" }),
    "Damit wird der Kopf des Opfers zerquetscht.");
  AddDetail( ({ "kopf" }),
    "Du bekommst akute Kopfschmerzen.");
  AddDetail( ({ "kopfschmerzen" }),
    "Dein Kopf fuehlt sich an, als wuerde er gleich zerbersten.");
  AddDetail( ({ "kopfzwinge" }),
    "Die Kopfzwinge wird dem Opfer um den Kopf gelegt und fest "
