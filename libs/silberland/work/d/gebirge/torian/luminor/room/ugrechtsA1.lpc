  AddDetail( ({ "stacheln", "innenseite" }),
    "An der Innenseite der Kopfzwinge befinden sich lange spitze Stacheln.");
  AddDetail( ({ "tischseite", "seite" }),
    "An einer Seite des Holztisches sind Daumenschrauben auf der "
