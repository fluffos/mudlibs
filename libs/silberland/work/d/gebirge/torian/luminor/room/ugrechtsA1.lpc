  AddExit( "sueden", "nach Sueden#" +  S );
  
  SetProp(P_HIDE_EXITS, ({ "norden" }));

  AddCmd( ({ "befreie", "befrei" }), "cmdbefreie" );
  AddCmd( ({ "loese", "loes" }), "cmdloesen" );
