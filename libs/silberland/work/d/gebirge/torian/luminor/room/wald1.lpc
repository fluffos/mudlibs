#include "../def.h"

inherit "std/room";

int aeste;
string *spieler;

void create()
{
  ::create();

  spieler = ({ });
  
//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Wald");
  SetProp(P_INT_LONG, "Unbeeindruckt des schlechten Zustandes des Weges "
    "schreitest Du weiter immer der Nase nach. Das Rauschen des Windes "
    "hat einen beunruhigenden, fast aggressiven Unterton erlangt. "
    "Burg Sturmfels ist nur noch zu erahnen. Ob dieser Bereich des Waldes "
    "noch von den Paladinen beschuetzt wird?");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "zustand" }),
    "Der Weg ist vollkommen ueberwuchert. Schon lange hat niemand diesen Weg "
    "mehr gepflegt."
  );
  AddDetail( ({ "weg" }),
    "Erstaunlich, dass Du ihn zwischen all den Pflanzen ausmachen konntest."
  );
  AddDetail( ({ "pflanzen" }),
    "Der Weg ist kaum auszumachen unter den Pflanzen. Buesche und Unkraut "
    "verbergen ihn nahezu perfekt. Die Aeste der Baeume ueberragen den Weg."
  );
  AddDetail( ({ "buesche" }),
    "Du kannst nicht genau ausmachen, welche Buesche das sind. Dornen scheinen "
    "sie jedenfalls nicht zu haben."
  );
  AddDetail( ({ "dornen" }),
    "Erkennen kannst Du keine. Du muesstest schon die Dornen suchen."
  );
  AddDetail( ({ "unkraut" }),
    "In einem Wald ist es schwer zu sagen, was Unkraut ist und was nicht."
  );
  AddDetail( ({ "aeste" }),
    "Die Aeste ueberragen den Weg, fast scheint es, als wollten sie Dir ins "
    "Gesicht schlagen."
  );
  AddDetail( ({ "gesicht" }),
    "Besorgt schaust Du Dich um, als ein Ast Dich am Hinterkopf erwischt."
  );
  AddDetail( ({ "ast", "gegensatz" }),
    "Im Gegensatz zu den anderen Aesten ist dieser Ast vertrocknet. Der "
    "ganze Baum sieht so aus, als wenn er den naechsten Sturm nicht ueberstehen "
    "wuerde."
  );
  AddDetail( ({ "baum" }),
    "Viele Aeste des Baumes sind bereits abgestorben. Lange wird er nicht mehr "
    "stehen."
  );
  AddDetail( ({ "sturm" }),
    "Der naechste Sturm wird diesen Baum bestimmt faellen und so Platz fuer "
    "einen neuen Baum schaffen."
  );
  AddDetail( ({ "platz", "dinge", "neuem" }),
    "So ist der Lauf der Dinge. Altes wird entfernt, um Neuem Platz zu machen."
  );
  AddDetail( ({ "lauf" }),
    "Vielleicht solltest Du auch langsam weiter laufen."
  );
  AddDetail( ({ "hinterkopf" }),
    "Etwas sauer ueber Deine Unachtsamkeit reibst Du Deinen Hinterkopf."
  );
  AddDetail( ({ "unachtsamkeit" }),
    "Du grummelst."
  );
  AddDetail( ({ "baeume" }),
    "Maechtige Baeume bilden den Wald hier."
  );
  AddDetail( ({ "nase" }),
    "Du folgst Deiner Nase, wohin auch immer sie Dich fuehrt."
  );
  AddDetail( ({ "burg", "sturmfels" }),
    "Burg Sturmfels ist nur noch zu erahnen. Sehen kannst Du die Burg der "
    "Paladine nicht mehr."
  );
  AddDetail( ({ "bereich", "paladine", "paladin" }),
    "Du fragst Dich, ob dieser selten betretene Bereich des Waldes noch von "
    "den Paladinen beschuetzt wird."
  );
  AddDetail( ({ "wald", "seiten" }),
    "Er umgibt Dich von allen Seiten."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist vollkommen ueberwuchert. Nur an einigen Stellen kann man noch "
    "den felsigen Untergrund ausmachen."
  );
  AddDetail( ({ "stellen", "blick" }),
    "Nur wenige Stellen erlauben einen freien Blick auf den Untergrund."
  );
  AddDetail( ({ "untergrund" }),
    "Trotz des felsigen Untergrunds gedeihen die Pflanzen praechtig."
  );
  AddDetail( ({ "himmel", "sicht" }),
    "Durch die dichten Baumkronen ist der Himmel nicht zu erkennen."
  );
  AddDetail( ({ "baumkronen", "kronen", "blaetterwerk" }),
    "Das Blaetterwerk ueber Deinem Kopf versperrt die Sicht auf den Himmel."
  );
  AddDetail( ({ "kopf" }),
    "Pass auf, dass Du ihn nicht verlierst."
  );

  AddSound( DEFAULT_SOUND,
    "Ausser dem Rauschen des Windes kannst Du nichts vernehmen."
  );

  AddSound( ({ "rauschen", "wind", "unterton" }),
    "Das Rauschen des Windes hat einen beunruhigenden, fast aggressiven "
    "Unterton erlangt."
  );

  AddSmell( DEFAULT_SMELL,
    "Tief saugst Du die frische Waldluft ein."
  );
  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft hier riecht frisch und rein."
  );


//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "breche", "brich", "brech" }), "cmd_brechen" );
  AddCmd( ({ "suche", "such" }), "cmd_suchen" );


//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordosten", "nach Nordosten#" + "/d/gebirge/iwo/weg/room/07-01" );
  AddExit( "sueden", "nach Sueden#" + "./wald2" );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_brechen(string str)
{
  object mystock;

  notify_fail("Was willst Du abbrechen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ast ab" ||
       str == "aeste ab"     )) return 0;

  if(member(spieler, getuuid(TP)) != -1) 
  {
    write("Was willst Du mit einem weiteren Ast?\n");
    return -1;
  }
  
  if(aeste > 5)
  {
    write(BS("Wenn noch mehr Aeste von dem Baum abgeborchen werden "
            +"hat er bald gar keine mehr ..."));
    return -1;
  }
  
  mystock = clone_object("/p/weapon/club/holzstock");
  if(ME_TOO_HEAVY==mystock->move(TP,M_GET|M_SILENT))
  {
    write("Du kannst den Holzstock nicht mehr tragen und laesst ihn daher fallen.\n");
    TO->Message(TP->Name(WER, 1)+" bricht einen Ast ab, laesst ihn aber fallen.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    mystock->move(TO,M_PUT);
  }
  else
  {
    write("Du brichst einen Ast ab.\n");
    TO->Message(TP->Name(WER, 1)+" bricht einen Ast ab.\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  
  spieler += ({ getuuid(TP) });
  aeste++;
  return 1;

}

int cmd_suchen(string str)
{
  notify_fail("Was willst Du suchen?\n");

  if(!str || str == "") return 0;

  if(!(str == "dornen" )) return 0;

  write(BS("Gruendlich durchsuchst Du einige der Buesche. Sie besitzen tatsaechlich "
       +"keine Dornen. Was fuer eine Zeitverschwendung."));
  TO->Message(TP->Name(WER, 1)+" durchsucht einige der Buesche.\n",
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

reset()
{
  ::reset();

  aeste = 0; // Aeste wieder da
  spieler = ({ });
}
