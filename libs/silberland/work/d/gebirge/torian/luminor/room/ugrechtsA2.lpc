
inherit "std/room";

#include "../def.h"

#define N ROOM "ugrechtsA1"

int kerze, eiswasser;

create()
{
  ::create();

  kerze = AUS;
  eiswasser = DA;

  SetProp( P_INT_SHORT, "In einer Folterkammer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im Buero des Foltermeisters. Ein grosser "
    "Schreibtisch mit Schreibgeraeten und anderen Utensilien befindet "
    "sich in der Mitte des Raumes. Ein kleines Stueck davor steht ein "
    "schwerer massiver Holzstuhl mit einer hohen Lehne. Hinter dem "
    "Schreibtisch steht ein kleinerer Stuhl, ebenfalls aus Holz. An den "
    "Waenden haengen einige Peitschen, eine grosse Axt sowie eine "
    "hoelzerne Schandgeige.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_KILL_NAME, "Eine Befragungsstuhl" );
  
  AddDetail( ({ "buero" }),
    "Dies ist das Buero des Foltermeisters.");
  AddDetail( ({ "foltermeister" }),
    "Falls er nicht hier sein sollte, ist er sicherlich gerade dabei, "
    "eines seiner armen Opfer mit einem seiner vielen sorgfaeltig "
    "ausgewaehlten Folterinstrumente bekanntzumachen.");
  AddDetail( ({ "opfer" }),
    "Du kannst die verzweifelten Schreie des Opfers bis hierher hoeren.");
  AddDetail( ({ "schreie" }),
    "Die Schreie dringen aus dem Norden hierher.");
  AddDetail( ({ "norden" }),
    "Die Folterkammer liegt im Norden.");
  AddDetail( ({ "folterkammer" }),
    "Die befindet sich noerdlich von hier.");
  AddDetail( ({ "folterinstrumente", "instrumente" }),
    "Der Grossteil der Folterinstrumente befindet sich in der "
    "Folterkammer im Norden, doch auch hier siehst Du einige Geraete, "
    "die sicherlich nicht nur zur Dekoration gedacht sind.");
  AddDetail( ({ "grossteil" }),
    "Die meisten Instrumente befinden sich im Norden.");
  AddDetail( ({ "geraete" }),
    "Auch hier im Buero des Foltermeisters siehst Du einige Geraete, die "
    "Dir nicht ganz geheuer vorkommen.");
  AddDetail( ({ "dekoration" }),
    "Diese Geraete sind nicht nur zur Dekoration gedacht.");
  AddDetail( ({ "schreibtisch", "tisch" }),
    "Auf dem Schreibtisch liegen ein paar Schreibutensilien sowie einige "
    "wichtig aussehende Papiere. Auch ein grosser Kerzenhalter steht auf "
    "dem Tisch.");
  AddDetail( ({ "schreibutensilien", "schreibgeraete", "utensilien" }),
    "Ein dickes, rotes Tintenfass steht auf dem Tisch, daneben liegt eine "
    "ungewoehnlich dicke Schreibfeder, die halb in ein kleines rot gefaerbtes "
    "Tuch eingewickelt ist.");
  AddDetail( ({ "tintenfass" }),
    "In dem Tintenfass schwappt dunkelrote Fluessigkeit traege hin und her.");
  AddDetail( ({ "fluessigkeit" }),
    "Bei der roten Fluessigkeit handelt es sich um Blut.");
  AddDetail( ({ "blut" }),
    "Tiefrotes, zaehfluessiges Blut befindet sich in dem Tintenfass.");
  AddDetail( ({ "schreibfeder", "seite" }),
    "Halb neugierig, halb aengstlich ziehst Du das Tuch ein wenig zur "
    "Seite und legst einen abgetrennten, leicht gekruemmten Zeigefinger "
    "frei, dessen Spitze rotgefaerbt ist und feucht glaenzt. Voellig "
    "entsetzt deckst Du das kleine Tuch wieder zu.");
  AddDetail( ({ "zeigefinger", "finger" }),
    "Der Finger scheint von einem Troll zu stammen, denn er ist sehr "
    "lang und knochig. Seine Spitze ist blutverschmiert.");
  AddDetail( ({ "spitze" }),
    "Die Spitze des Zeigefingers glaenzt blutrot. Er scheint noch vor "
    "kurzem benutzt worden zu sein.");
  AddDetail( ({ "troll" }),
    "Ob dieser Troll wohl noch lebt?");
  AddDetail( ({ "tuch" }),
    "In das kleine Tuch wurde eine Schreibfeder eingewickelt.");
  AddDetail( ({ "papiere" }),
    "Einige mit blutroter Farbe unterzeichnete Todesurteile liegen "
    "ordentlich aufeinandergestapelt auf dem Schreibtisch. Das Papier, "
    "auf dem sie geschrieben sind, fuehlt sich merkwuerdig weich und "
    "nachgiebig an. Eines der Blaetter scheint noch nicht unterschrieben "
    "worden zu sein.");
  AddDetail( ({ "farbe" }),
    "Die Urteile wurden mit blutroter Farbe unterzeichnet.");
  AddDetail( ({ "todesurteile", "urteile" }),
    "Die Todesurteile sind bis auf eines allesamt unterzeichnet.");
  AddDetail( ({ "urteil", "todesurteil", "blatt" }), 
    "Neugierig beugst Du Dich ueber den Schreibtisch und liest, was auf "
    "dem nicht unterzeichneten Todesurteil steht. Keuchend taumelst Du "
    "zurueck und faengst unkontrolliert an zu zittern. Auf dem Urteil "
    "steht DEIN Name!");
  AddSpecialDetail( ({ "name", "DEIN" }), "strname");
  AddDetail( ({ "papier" }),
    "Du befuehlst das Papier und kommst schliesslich zu dem unangenehmen "
    "Schluss, dass es aus Menschenhaut angefertigt wurde.");
  AddDetail( ({ "schluss" }),
    "Aus der besonders weichen und nachgiebigen Konsistenz des Papiers "
    "schliesst Du, dass es aus echter Menschenhaut angefertigt wurde.");
  AddDetail( ({ "konsistenz" }),
    "Das Papier fuehlt sich seidig weich und nachgiebig an.");
  AddDetail( ({ "menschenhaut", "haut" }),
    "Das Papier wurde aus der Haut von Menschen hergestellt.");
  AddDetail( ({ "menschen" }),
    "Ihnen wurde die Haut abgezogen.");
  AddDetail( ({ "blaetter" }),
    "Eines der Blaetter wurde noch nicht unterzeichnet.");
  AddDetail( ({ "kerzenhalter" }),
    "Ein grosser Kerzenhalter steht auf dem Tisch. Er hat die Form einer "
    "menschlichen Hand und eine schwarze Kerze steckt in ihm.");
  AddDetail( ({ "form" }),
    "Der Kerzenhalter ist wie eine halb geoeffnete Hand geformt.");
  AddDetail( ({ "hand" }),
    "Du hast Dich geirrt. Der Kerzenhalter ist nicht wie eine "
    "Hand geformt, er wurde aus einer echten, menschlichen Hand gemacht!");
  AddSpecialDetail( ({ "kerze" }), "strkerze");
  AddDetail( ({ "handinnenflaeche" }),
    "Heisses Wachs wurde auf die Handinnenflaeche getropft und so die Kerze "
    "daran befestigt.");
  AddDetail( ({ "wachs" }),
    "Das Wachs ist inzwischen abgekuehlt, so dass die Kerze sicher darin "
    "stehen kann.");
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein grosser Schreibtisch.");
  AddDetail( ({ "raum" }),
    "Der Schreibtisch steht mitten im Raum.");
  AddDetail( ({ "stueck" }),
    "Ein kleines Stueck vor dem Schreibtisch steht ein massiver Holzstuhl.");
  AddDetail( ({ "holzstuhl" }),
    "Hierbei scheint es sich um den Befragungsstuhl zu handeln. Seine "
    "hohe Lehne sowie die Sitzflaeche sind mit spitzen Stacheln bewehrt. "
    "An den Armlehnen und Stuhlbeinen sind dicke Eisenringe "
    "festgeschraubt.");
  AddDetail( ({ "befragungsstuhl" }),
    "Auf diesem werden die Gefangenen zunaechst befragt, bevor sie in "
    "die eigentliche Folterkammer gebracht werden.");
  AddDetail( ({ "gefangenen", "gefangene" }),
    "In diesem Buero werden die Gefangenen zunaechst vernommen.");
  AddDetail( ({ "lehne" }),
    "Die hohe Lehne des Befragungsstuhls ist mit spitzen Stacheln uebersaeht.");
  AddDetail( ({ "sitzflaeche" }),
    "Die Sitzflaeche des Stuhles besteht aus vielen spitzen Stacheln. Es "
    "tut sicherlich ziemlich weh, darauf zu sitzen. Du kannst es ja mal "
    "ausprobieren, wenn Du magst.");
  AddDetail( ({ "stachel", "stacheln" }),
    "Die Stacheln sind wirklich sehr spitz.");
  AddDetail( ({ "armlehnen" ,"stuhlbeine", "stuhlbeinen", "armlehne"}),
    "Auf die Armlehnen und an die Stuhlbeinen sind dicke Eisenringe geschraubt.");
  AddDetail( ({ "eisenringe" }),
    "Mit diesen Eisenringen werden die Gefangenen auf dem Befragungsstuhl "
    "festgeschraubt.");
  AddDetail( ({ "holz" }),
    "Der Befragungsstuhl ist aus rauhem, dunklem Holz gebaut, waehrend "
    "der kleinere Stuhl hinter dem Schreibtisch etwas heller und feiner "
    "gearbeitet ist.");
  AddDetail( ({ "stuhl" }),
    "Auf dem Stuhl hinter dem Schreibtisch sitzt der Foltermeister "
    "normalerweise, waehrend er seine Gefangenen verhoert.");
  AddDetail( ({ "waende" }),
    "An den Waenden haengen einige lange Peitschen, eine grosse Axt "
    "sowie eine hoelzerne Schandgeige. Hinter dem Schreibtisch befindet "
    "sich ein grosses Bild an der Wand.");
  AddDetail( ({ "peitschen" }),
    "Einige sehr lange Peitschen haengen zusammengerollt an den Waenden.");
  AddDetail( ({ "axt" }),
    "Neben den Peitschen siehst Du eine grosse Axt an der Wand haengen. "
    "Du willst lieber gar nicht so genau wissen, wozu die benutzt wird.");
  AddDetail( ({ "schandgeige" }),
    "Diese hoelzerne Schandgeige besteht aus einem laenglichen Brett mit "
    "einem grossen Loch fuer den Kopf und zwei kleineren Loechern fuer "
    "die Arme.");
  AddDetail( ({ "brett" }),
    "Die Schandgeige wird dem Gefangenen um den Hals gelegt, wobei "
    "die Arme durch die kleineren Oeffnungen gesteckt werden. Diese "
    "Massnahme dient dazu, den Gefangenen zu bestrafen und zu demuetigen.");
  AddDetail( ({ "hals" }),
    "Die Schandgeige wird dem Gefangenen um den Hals gelegt.");
  AddDetail( ({ "arme" }),
    "Die Arme werden durch die beiden kleineren Loecher gesteckt.");
  AddDetail( ({ "loecher", "loch", "oeffnungen" }),
    "Insgesamt befinden sich drei Loecher in dem laenglichen Brett.");
  AddDetail( ({ "kopf" }),
    "Der Kopf wird durch das groessere der drei Loecher gesteckt.");
  AddDetail( ({ "massnahme" }),
    "Die Schandgeige dient dazu, den Gefangenen zu bestrafen und zu demuetigen.");
  AddDetail( ({ "decke" }),
    "Die Decke wurde aus rauhen Steinen gebaut.");
  AddDetail( ({ "bild" }),
    "Ein grosses Bild haengt an der Wand hinter dem Schreibtisch. "
    "Es zeigt einen von vielen Flammen umgebenen Daemon.");
  AddDetail( ({ "flammen" }),
    "Grosse lodernde Flammen umgeben den Daemon von allen Seiten.");
  AddDetail( ({ "daemon" }),
    "Der Daemon wirkt ziemlich furchteinfloessend. Er sieht fast so aus, "
    "als ob er echt waere.");
  AddDetail( ({ "seiten" }),
    "Der Daemon wird von wogenden Flammen umgeben.");
  AddDetail( ({ "boden" }),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "wand" }),
    "An der Wand hinter dem grossen Schreibtisch haengt ein grosses Bild.");
  AddDetail( ({ "steinen", "steine" }),
    "Die Decke wurde aus den gleichen Steinen gebaut wie der "
    "gepflasterte Boden.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Stoehnen aus dem Norden.");

  AddSound( ({ "stoehnen" }),
    "Das Stoehnen klingt sehr verzweifelt.");
  AddSound( ({ "norden" }),
    " Ein leises Stoehnen kommt aus dem Norden.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Kerzenwachs. Ausserdem kannst du "
    "einen schwachen suesslichen Geruch wahrnehmen.");

  AddSmell( ({ "kerzenwachs", "wachsgeruch" }),
    "Der Wachsgeruch kommt von der Kerze auf dem Schreibtisch.");
  AddSmell( ({ "kerze" }),
    "Die Kerze auf dem Schreibtisch verstroemt einen eigenartigen Geruch.");
  AddSmell( ({ "geruch" }),
    "Der leicht suessliche Geruch von Blut liegt in der Luft.");
  AddSmell( ({ "luft", "blut" }),
    "Der schwache Geruch von Blut liegt in der Luft.");
  AddSmell( ({ "schreibtisch" }),
    "Ein Geruch nach Kerzenwachs sowie ein leicht suesslicher Geruch kommen vom Schreibtisch.");
 
  AddExit( "norden", "nach Norden#" +  N );

  AddCmd( "sitz|sitze|setz|setze&auf&stuhl|befragungsstuhl", "cmdsitzen",
          "Auf was willst Du sitzen?" );
  AddCmd( "zuende|zuend|kerze&an", "cmdzuenden",
          "Was willst Du anzuenden?" );
  AddCmd( "blas|blase|kerze&aus", "cmdblase",
          "Was willst Du ausblasen?" );
  AddCmd( "klapp|klappe&bild|bild&beiseite", "cmdklappe",
          "Was willst Du beiseite klappen?|Willst Du das Bild beiseite klappen?" );

  AddItem( NPC "foltermeister", REFRESH_DESTRUCT);

}

string strname(string key)
{
  return BS(TP->Name()+"!");
}

string strkerze(string key)
{
  string s;
  s = "Eine schwarze Kerze wurde mit heissem Wachs auf der Handinnenflaeche "
     +"befestigt. ";
  if(kerze == AUS)
  {
  	return BS(s+"Sie brennt nicht.");
  }
  else
  {
    return BS(s+"Irgendjemand hat sie angezuendet.");
  }
}

// Auf dem Befragungsstuhl sitzen (selbst schuld)
int cmdsitzen(string str )
{
    write(BS("Du setzt Dich auf den Befragungsstuhl und Tausende von Stacheln bohren "
         +"sich in Dein Fleisch. Dir ist sofort klar, warum dies ein "
         +"Befragungsstuhl ist. Mit schmerzverzerrtem Gesicht stehst Du wieder auf."));
    say(BS(TP->name()+" setzt sich auf den Befragungsstuhl, springt aber "
         +"mit schmerzverzerrtem Gesicht wieder auf."));
    TP->do_damage(30+random(30), this_object());
    return 1;
}

// Kerze anzuenden
// Ausbauen
int cmdzuenden(string str )
{
  if(kerze == AUS)
  {
    write(BS("Du zuendest die Kerze an."));
    say(BS(TP->name()+" zuendet die Kerze an."));
    kerze = AN;
    return 1;
  }
  notify_fail(BS("Die Kerze ist bereits angezuendet worden."));
  return 0;
}

// Kerze loeschen
int cmdblase(string str)
{
  if(kerze == AN)
  {
	write(BS("Du blaest die Kerze aus."));
    say(BS(TP->name()+" blaest die Kerze aus."));
    kerze = AUS;
    return 1;
  }
  notify_fail(BS("Die Kerze brennt doch gar nicht?"));
  return 0;
}

reset()
{
  ::reset();

  if(kerze == AN)
  {
    Message(BS("Ein Lufthauch blaest die Kerze aus."), MSGFLAG_VISUAL);
    kerze = AUS;
  }

  eiswasser = DA;

}

// Bild beiseite klappen
int cmdklappe(string str)
{
  
  object myeiswasser;
  
  if(present("foltermeister"))
  {
  	write(BS("Der Foltermeister haut Dir eine runter!"));
  	TP->AddHp(-10 - random(20));
  	say(BS("Der Foltermeister haut "+TP->Name(WEN)+" eine runter!"));
  	return -1;
  }
  
  if(eiswasser == DA)
  {
    Message(BS(TP->Name()+" hantiert an der Wand herum."),  
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    // Eiswasser reinmoven
    myeiswasser=clone_object(OBJ "eiswasser");
    if(ME_TOO_HEAVY==myeiswasser->move(TP,M_GET|M_SILENT))
    {
      write(BS("Du klappst das Bild beiseite und findest eine Phiole mit "
            "Eiswasser, da Du es nicht mehr tragen kannst laesst Du es "
            "liegen. Vorsichtig klappst Du das Bild wieder zurueck."));
      myeiswasser->remove();
      return -1;
    }
    else
    {
      write(BS("Du klappst das Bild beiseite und findest eine Phiole mit "
               "Eiswasser. Vorsichtig klappst Du das Bild wieder zurueck."));
      eiswasser = WEG;
      LUMINORMASTER->Msg(TP->Name()+": Eiswasser@Folterkammer");
      return 1;    
    }

  }
  else
  {
    write(BS("Du klappst das Bild beiseite, findest jedoch nichts. "
	        +"Irgendjemand ist Dir wohl zuvor gekommen."));
    say(BS(TP->name()+" hantiert an der Wand herum."));
    return -1;
  }
}