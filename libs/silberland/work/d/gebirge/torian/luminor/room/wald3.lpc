#include "../def.h"
#include <verben.h>

inherit "std/room";

void ueberfall(object player);
string *spieler;
string *busch;
int oni;

void create()
{
  ::create();

  oni = DA;
  spieler = ({ });
  busch = ({ });

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einer kleinen Lichtung");
  SetProp(P_INT_LONG, "Vor Dir oeffnet sich der Wald und gibt den Blick auf "
   "eine kleine Lichtung frei. Wie ein Titan steht ein riesiger Baum "
   "inmitten der Lichtung. Die Sonne erstrahlt in voller Groesse und gibt der "
   "Lichtung ein traumhaftes Aussehen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "wald" }),
    "Inmitten des Waldes wurde eine kleine Lichtung geschlagen. Verwundert stellst "
    "Du fest, dass ein riesiger Baum inmitten der Lichtung stehen gelassen wurde."
  );
  AddDetail( ({ "blick" }),
    "Du hast einen ungehinderten Blick auf diese traumhafte Lichtung. Die Rodung "
    "muss schon einige Zeit zurueckliegen. Nur wenige Spuren der Baeume sind "
    "noch zu sehen."
  );
  AddDetail( ({ "rodung" }),
    "Die Lichtung ist nicht natuerlichen Ursprungs. Es existieren nur noch wenige "
    "Spuren, die sind dafuer unuebersehbar."
  );
  AddDetail( ({ "ursprung", "ursprungs" }),
    "Die Lichtung ist durch die fleissige Arbeit einiger Holzfaeller entstanden."
  );
  AddDetail( ({ "arbeit" }),
    "Eine Lichtung zu roden ist schon Arbeit."
  );
  AddDetail( ({ "holzfaeller" }),
    "Wer die Holzfaeller waren oder was sie mit den Baeumen vorhatten, bleibt Dir "
    "wohl auf ewig verschlossen."
  );
  AddDetail( ({ "zeit" }),
    "Die Baumstuempfe sind schon lange mit irgendwelchen Pflanzen ueberwachsen. "
    "Die Rodung muss also schon einige Zeit zurueckliegen."
  );
  AddDetail( ({ "spuren" }),
    "Die Baumstuempfe der gefaellten Baeume sind unuebersehbar."
  );
  AddDetail( ({ "baumstuempfe", "stuempfe", "baumstumpf", "stumpf" }),
    "Die Baumstuempfe sind bereits groesstenteils von Pflanzen ueberwachsen. "
    "Dennoch sind sie unuebersehbar."
  );
  AddDetail( ({ "pflanzen" }),
    "Naja, Pflanzen halt - Du kennst auch nicht alle."
  );
  AddDetail( ({ "baeume", "baeumen" }),
    "Maechtige Baeume bilden den Wald um die Lichtung herum."
  );
  AddDetail( ({ "lichtung" }),
    "Obwohl die Lichtung geradezu traumhaft ist, wirst Du das unbestimmte Gefuehl "
    "nicht los, hier nicht sicher zu sein."
  );
  AddDetail( ({ "gefuehl" }),
    "Du weisst nicht, woher diese bedrohliche Atmosphaere kommt. Gefahren siehst Du "
    "keine, dennoch fuehlst Du Dich nicht wohl auf der Lichtung, so ganz ohne Deckung."
  );
  AddDetail( ({ "atmosphaere" }),
    "Irgendwie bedrohlich. Die Sonne kann noch soviel strahlen. Irgendetwas stimmt "
    "hier nicht."
  );
  AddDetail( ({ "gefahren", "gefahr" }),
    "Die Gefahr scheint mehr vom Waldrand auszugehen als von der Lichtung. Sicher bist "
    "Du Dir aber nicht."
  );
  AddDetail( ({ "waldrand", "rand" }),
    "Naeher betrachtet erscheint der Waldrand dunkler und bedrohlicher als noch zuvor. "
    "Vielleicht liegt es aber auch nur an der intensiven Helligkeit auf der Lichtung."
  );
  AddDetail( ({ "helligkeit" }),
    ([ 0: "Du geniesst die hellen Sonnenstrahlen.",
       "dunkelelf": "Angewidert wendest Du Dich ab." ])
  );
  AddDetail( ({ "deckung" }),
    "Deckung findest Du hier keine. Lediglich der grosse Baum inmitten der Lichtung "
    "wuerde sich anbieten. Aber damit wuerde jeder Gegner rechnen ..."
  );
  AddDetail( ({ "gegner" }),
    "Siehst Du denn welche?"
  );
  AddDetail( ({ "titan" }),
    "Wie ein Riese steht der Baum inmitten der Lichtung. Als wuerde er die Lichtung "
    "vor etwas beschuetzen wollen."
  );
  AddDetail( ({ "riese" }),
    "Mit seiner maechtigen Baumkrone sieht er aus wie ein Riese, der mit einem Schild "
    "versucht, die Sonnenstrahlen fernzuhalten. Zwei besonders starke, seitlich "
    "wachsende Aeste sehen aus wie Arme, die den Schild tragen."
  );
  AddDetail( ({ "arme" }),
    "Zwei besonders starke Aeste scheinen die Baumkrone wie Arme zu halten. "
    "Das verleiht dem Baum tatsaechlich eine gewisse Aehnlichkeit mit einem Riesen."
  );
  AddDetail( ({ "aehnlichkeit" }),
    "Der Baum hat eine gewisse Aehnlichkeit mit einem Riesen."
  );
  AddDetail( ({ "baumkrone", "krone" }),
    "Solch eine maechtige Baumkrone bietet viel Platz fuer Leben."
  );
  AddDetail( ({ "platz" }),
    "Baumkronen bieten mehr Platz, als man glaubt."
  );
  AddDetail( ({ "leben" }),
    "Hauptsaechlich fuer Voegel."
  );
  AddDetail( ({ "voegel" }),
    "Sollten welche vorhanden sein kannst Du sie zwischen den Aesten und Blaettern "
    "nicht ausmachen."
  );
  AddDetail( ({ "aeste", "aesten", "blaetter", "blaettern" }),
    "Viele Aeste und Blaetter bilden die Baumkrone."
  );
  AddDetail( ({ "schild" }),
    "Wie ein Schild schuetzt die Baumkrone den Boden unter dem Baum vor dem "
    "Sonnenlicht."
  );
  AddDetail( ({ "baum" }),
    "Als Du den Baum naeher betrachtest, stellst Du fest, dass unter dem Baum in "
    "seinem Schatten etwas weiss schimmerndes liegt."
  );
  AddDetail( ({ "schatten", "etwas", "schimmer", "schimmerndes" }),
    "Im Schatten unter dem Baum scheint ein Skelett zu liegen."
  );
  AddDetail( ({ "skelett" }),
    "Erstaunt erkennst Du, dass das Skelett nicht einfach nur da liegt. Es lehnt "
    "sich foermlich an den Baum an. Ein Arm des Skeletts scheint auf etwas zeigen "
    "zu wollen."
  );
  AddDetail( ({ "arm" }),
    "Der Arm wurde an dem Baum genagelt wie ein grotesker Wegweiser. "
    "Ueberhaupt scheint das ganze Skelett festgemacht worden zu sein."
  );
  AddDetail( ({ "wegweiser" }),
    "Er deutet auf den Waldrand im Westen. Wer kommt nur auf die kranke Idee, "
    "ein Skelett als Wegweiser zu benutzen?"
  );
  AddDetail( ({ "idee" }),
    "Willst Du das wirklich wissen? Oder nicht doch lieber umkehren?"
  );
  AddDetail( ({ "sonne", "sonnenstrahlen", "sonnenlicht", "strahlen" }),
    ([ 0: "Du geniesst die hellen Sonnenstrahlen. Nur unter dem Baum sind ein paar "
          "Schatten zu sehen.",
       "dunkelelf": "Angewidert von der Sonne suchst Du nach ein wenig Schatten." ])
  );
  AddDetail( ({ "groesse" }),
    "Die Sonne erstrahlt in voller Groesse."
  );
  AddDetail( ({ "aussehen" }),
    "Die Sonne verleiht der Lichtung ein traumhaftes Aussehen. Am liebsten wuerdest "
    "Du Dich hinlegen und fuer ein paar Minuten ausruhen."
  );
  AddDetail( ({ "minuten" }),
    "Nur ganz kurz. Wuerde bestimmt keiner bemerken ..."
  );
  AddDetail( ({ "westen" }),
    "Der Waldrand im Westen ist voll mit dornigen Bueschen."
  );
  AddDetail( ({ "busch", "bueschen", "buesche" }),
    "Man muesste sich schon einen Weg bahnen, um dort durchzukommen."
  );
  AddDetail( ({ "weg", "osten" }),
    "Im Osten stehen die Baeume nicht ganz so dicht."
  );
  AddDetail( ({ "himmel" }),
    "Die Sonne strahlt vom blauen Himmel herab. Keine einzige Wolke truebt den Blick "
    "auf sie."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist vollkommen von Pflanzen bedeckt."
  );
  AddDetail( ({ "wolke", "eindruck" }),
    "Keine einzige Wolke truebt den traumhaften Eindruck der Lichtung."
  );

  AddSound( DEFAULT_SOUND,
    "Von irgendwoher erschallt leises Vogelgezwitscher."
  );

  AddSound( ({ "vogelgezwitscher", "gezwitscher", "voegelgezwitscher" }),
    "Du bist Dir nicht sicher, aber es koennte von dem riesigen Baum inmitten der "
    "Lichtung herkommen."
  );

  AddSmell( DEFAULT_SMELL,
    "Tief saugst Du die Waldluft ein. Hier auf der Lichtung erscheint sie noch "
    "frischer und belebender zu sein."
  );
  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft hier riecht frisch und rein."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "ruhe", "ruh" }), "cmd_ruhen" );
  AddCmd( ({ "befreie", "befrei" }), "cmdbefreie" );
  AddCmd( ({ "bahne", "bahn" }), "cmd_bahnen" );
  AddCmd( ({"steh","stehe"}), "cmd_stehen");

//--Ausgaenge--------------------------------------------------------------

  AddExit ("osten", ([ EX_DEST: "./wald2",
                       EX_TESTFUNC: "exit_test" ]) );

  SetProp(P_HIDE_EXITS, ({ "osten" }));
}

//--Funktionen fuer Kommandos----------------------------------------------

// andere Spieler versuchen zu befreien aus dem Netz
int cmdbefreie(string str)
{
  object player, machete;
  string wen;

  notify_fail( "Wen willst Du womit befreien?\n" );
  if (!stringp(str)) { return 0; }

  if(sscanf(str, "%s mit machete",wen) != 1) return 0;

  if(member(busch,getuuid(TP)) != -1 )
  {
    if(wen == "dich" || wen == lower_case(getuuid(TP)))
    {
      write(BS("So wird das nichts. Du brauchst Hilfe! Irgendwer wird kommen "
          +"muessen, um Dich mit einer zu Machete befreien."));
      return -1;
    }
    else 
    {
      write(BS("Du solltest erstmal versuchen Dich selbst zu befreien!"));
      return -1;
    }
  }

  player = find_living(wen);
  if(!player) return 0;
  
  if(member(busch,getuuid(player)) != -1)
  {
    machete = present("machete",TP);
    if( !machete )
    {
      write(BS("Du hast gar keine Machete!"));
      return -1;
    } 
    
    write(BS("Du befreist "+player->Name()+" mit Deiner Machete."));
    
    tell_object(player, BS(TP->Name()+" befreit Dich mit einer Machete."));
    
    Message(BS(TP->Name()+" befreit "+player->Name()+" mit einer Machete."), 
            MSGFLAG_VISUAL|MSGFLAG_NO_TP,([ MSGFLAG_EXCLUDE : ({ player }) ]));
    busch -= ({ getuuid(player) });
    LUMINORMASTER->Msg(TP->Name()+" befreit "+player->Name()+"!");
    return 1;
  }
  
  return 0;
}


int cmd_ruhen(string str)
{
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus" ||
       str == "dich aus" )) return 0;

  if(member(spieler, getuuid(TP)) != -1) 
  {
    write(BS("Aber Du ruhst Dich doch bereits aus!"));
    return -1;
  }

  if(member(busch, getuuid(TP)) != -1)
  {
    tell_object(TP, BS("Hoffnungslos! Irgendwer wird kommen "
          +"muessen, um Dich mit einer zu Machete befreien."));
    return -1;
  }

  switch(TP->QueryProp(P_RACE))
  {
    case "Dunkelelf":
    case "Untoter":
      write(BS("Du suchst Dir ein schoenes schattiges Plaetzchen, legst Dich hin und "
              +"ruhst Dich aus. Ahh, tut das gut."));
      TO->Message(BS(TP->Name(WER, 1)+" sucht sich ein schattiges Plaetzchen und ruht "
              +"sich aus."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    default:
      write(BS("Du suchst Dir ein schoenes sonnenbeschienenes Plaetzchen, legst "
              +"Dich hin und ruhst Dich aus. Ahh, tut das gut."));
      TO->Message(BS(TP->Name(WER, 1)+" sucht sich ein sonniges Plaetzchen und ruht "
              +"sich aus."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
  }

  spieler += ({ getuuid(TP) });

  if((oni == DA) && (find_call_out("ueberfall") == -1))
    call_out("ueberfall", 5+random(5), TP);
  
  write(BS("Du kannst jederzeit wieder aufstehen."));
  
  return 1;

}

int cmd_bahnen(string str)
{
  int schaden;
  string s;

  notify_fail("Wodurch willst Du Dir einen Weg bahnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "weg" ||
       str == "weg nach westen" ||
       str == "weg durch buesche" ||
       str == "weg durch busch"   )) return 0;

  if(member(spieler, getuuid(TP)) != -1) 
  {
    write(BS("Du solltest erstmal aufstehen!"));
    return -1;
  }

  if(member(busch, getuuid(TP)) != -1)
  {
    tell_object(TP, BS("Hoffnungslos! Von diesen Bueschen kannst Du "
                     +"Dich nicht selbst befreien. Irgendwer wird kommen "
                     +"muessen, um Dich mit einer zu Machete befreien."));
    return -1;
  }

  if(IS_LEARNER(TP))
  {
    TP->move(ROOM "wald4", M_NO_SHOW|M_NOCHECK,
       "sich einen Weg durch die Buesche",
       "bahnt",
       "bahnt sich einen Weg herein");
    LUMINORMASTER->Msg("Learner "+TP->Name()+" bahnt sich den Weg zum Turm!");

    return 1;
  }

  if(!TP->do_exhaust(400+random(300))) 
  {
  	write(BS("Du bist zu erschoepft, um Dir einen Weg durch die dornigen "
  	        +"Buesche bahnen zu koennen!"));
  	return -1; 
  }

  if((oni == DA) && !random(5))
  {
    ueberfall(TP);
    return -1;
  }

  if(!random(20))
  {
    write(BS("Du versuchst Dir einen Weg durch die Buesche zu bahnen. "
            +"Leider verhedderst Du Dich hoffnungslos!!"));
    TO->Message(BS(TP->Name()+" verheddert sich in einem Busch!!"),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    busch += ({ getuuid(TP) });
    LUMINORMASTER->Msg(TP->Name()+" bleibt im Busch haengen!");
    return -1;
  }    

  if(present("oni", TO))
  {
    write(BS("Du wirst von einem Oni aufgehalten!"));
    TO->Message(BS(TP->Name()+" wird von einem Oni aufgehalten!"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return -1;
  }

  switch(random(100))
  {
    case 0..65:
      s = "Dabei zerkratzt Du Dir leicht das Gesicht.";
      schaden = 20;
      break;
    case 66..95:
      s = "Leider hast Du einige dicke Dornen uebersehen.";
      schaden = 50;
      break;
    default:
      s = "Ausgerechnet den Busch mit den meisten Dornen suchst Du Dir aus.";
      schaden = 100;
      break;
  }

  SetProp(P_KILL_NAME, "Dornen" );  

  write(BS("Du bahnst Dir einen Weg durch die Buesche. "+s));
  
  schaden = schaden + random(20);
  TP->do_damage(schaden, TO);
  
  if(!TP->QueryProp(P_GHOST))
  {
    call_other (ROOM "wald4", "???", 0);
    TP->move(ROOM "wald4", M_NO_SHOW|M_NOCHECK,
        "sich einen Weg durch die Buesche",
        "bahnt",
        "bahnt sich einen Weg herein");
  }

  LUMINORMASTER->Msg(TP->Name()+" bahnt sich den Weg zum Turm! Schaden: "+schaden);

  return 1;
}

void ueberfall(object player)
{
  int i;
  object myoni;
  TO->Message(BS("Ploetzlich brechen ein paar gehoernte Wesen hervor und greifen "
                +"Dich an!"), MSGFLAG_VISUAL);

  i = 2;
  while(i--)   // 3 Oni ist kein durchkommen mit weniger als 3 Leuten ..
  {
    myoni = clone_object(NPC "oni");
    myoni->SetProp(P_AGGRESSIVE, 1);
    myoni->move(TO,M_GO|M_SILENT);
  }

  oni = WEG;
}

int exit_test(string dir)
{

  if(!TP)              return 1;
  if(!interactive(TP)) return 1;

  if(member(spieler, getuuid(TP)) != -1)
  {
    tell_object(TP, BS("Du solltest erstmal aufstehen!"));
    return 0;
  }
  
  if(member(busch, getuuid(TP)) != -1)
  {
    tell_object(TP, BS("Hoffnungslos! Von diesen Bueschen kannst Du "
                     +"Dich nicht selbst befreien. Irgendwer wird kommen "
                     +"muessen, um Dich mit einer zu Machete befreien."));
    return 0;
  }
  
  return 1;
}


int cmd_stehen(string str)
{
  notify_fail("Moechtest Du AUFstehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf" )) return 0;

  if(member(spieler,getuuid(TP)) == -1)
  {
    tell_object(TP,"Aber Du ruhst Dich doch gar nicht aus?\n");
    return -1;
  }

  spieler -= ({ getuuid(TP) });

  write(BS("Du stehst wieder auf."));
  TO->Message(BS(TP->Name()+" steht wieder auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

reset()
{
  ::reset();

  if(!present("oni", TO))
  {
    oni = DA; 
  }
}