
inherit "std/room";

#include "../def.h"

#define N ROOM "erdgA2"
#define S ROOM "uglinksA2"

#define FERTIG     1
#define UNGEWUERZT 2
#define GESALZEN   3
#define GEPFEFFERT 4

int feuer, suppe, zaehler;

create()
{
  ::create();

  feuer = AUS;
  suppe = UNGEWUERZT;
  zaehler = 3;

  SetProp( P_INT_SHORT, "In einem Kerkervorraum" );
  SetProp( P_INT_LONG,
    "Dies ist eindeutig der Vorraum des Kerkers. Im Norden fuehrt eine "
    "Treppe nach oben, waehrend sich im Sueden eine verrostete Tuer "
    "befindet. Dahinter scheint der eigentliche Kerker zu sein. An der "
    "Westwand siehst Du eine Feuerstelle mit einem riesigen, "
    "uebelriechenden Kochtopf darueber. Im Osten befindet sich ein "
    "grosses Kohlebecken an der Wand.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "vorraum" }),
    "Dies ist eindeutig der Vorraum des Kerkers.");
  AddDetail( ({ "norden" }),
    "Eine Treppe fuehrt im Norden wieder nach oben.");
  AddDetail( ({ "treppe" }),
    "Die Treppe besteht - wie fast alles hier - aus rauhen, alten Steinen. Ihre Stufen "
    "sind in der Mitte leicht gewoelbt.");
  AddDetail( ({ "steinen", "steine" }),
    "Die Steine scheinen schon Jahrhunderte alt zu sein.");
  AddDetail( ({ "jahrhunderte", "jahrhundert" }),
    "Der Kerker scheint schon sehr alt zu sein.");
  AddDetail( ({ "stufen" }),
    "Die Stufen sind in der Mitte leicht gewoelbt. Vor Jahren waren sie sicher einmal "
    "gerade und ohne Abnutzungserscheinungen.");
  AddDetail( ({ "jahren", "jahre" }),
    "Die Treppe muss schon etliche Jahre in Benutzung sein.");
  AddDetail( ({ "benutzung" }),
    "Jahrelange Benutzung hat die Stufen abgerundet und eine leichte Woelbung in ihrer "
    "Mitte entstehen lassen.");
  AddDetail( ({ "woelbung", "treppauf", "treppab" }),
    "Jahrelanges Treppauf und Treppab hat eine leichte Woelbung entstehen lassen.");
  AddDetail( ({ "abnutzungserscheinungen", "abnutzungserscheinung" }),
    "Die Stufen sehen schon sehr abgenutzt aus.");
  AddDetail( ({ "mitte" }),
    "Die Stufen sind in der Mitte leicht gewoelbt. Diese Treppe hat bestimmt schon viele "
    "Fuesse gesehen.");
  AddDetail( ({ "fuesse" }),
    "Auch Deine Fuesse hat die Treppe gesehen.");
  AddDetail( ({ "sueden" }),
    "Im Sueden befindet sich eine verrostete Kerkertuer.");
  AddDetail( ({ "suedwand" }),
    "Eine verrostete Kerkertuer befindet sich in der Suedwand. Im unteren Bereich der "
    "Tuer faellt Dir ploetzlich eine kleine Luke auf.");
  AddDetail( ({ "bereich" }),
    "Im unteren Bereich befindet sich eine unscheinbare Luke.");
  AddDetail( ({ "luke" }),
    "Durch diese Luke erhalten die Gefangenen ihre Mahlzeiten.");
  AddDetail( ({ "nordwand" }),
    "Im Norden fuehrt eine Treppe nach oben.");
  AddDetail( ({ "westwand" }),
    "Eine grosse Feuerstelle befindet sich an der Westwand. Direkt darueber haengt ein "
    "Regal mit Gewuerzen.");
  AddDetail( ({ "regal" }),
    "Ein schaebig aussehendes Regal mit ein paar wenigen Gewuerzen befindet sich ueber "
    "der Feuerstelle.");
  AddDetail( ({ "gewuerze", "gewuerz" }),
    "Viele Gewuerze kannst Du nicht erkennen. Lediglich Salz und Pfeffer kannst Du eindeutig "
    "zuordnen. Der Rest scheint groesstenteils bereits vergammelt und verfault zu sein.");
  AddDetail( ({ "salz" }),
    "Salz ist das wahrscheinlich am haeufigsten verwendete Gewuerz. Es wundert Dich nicht, "
    "dass es selbst hier zu finden ist.");
  AddDetail( ({ "pfeffer" }),
    "Du bist erstaunt, in einem Kerker ein so edles Gewuerz wie Pfeffer zu finden. Sicher "
    "ist es nur fuer die Mahlzeit des Kerkerknechts vorgesehen.");
  AddDetail( ({ "rest" }),
    "Die restlichen Gewuerze sehen sehr vergammelt und verfault aus. Jedes Essen, das damit "
    "gewuerzt wird, verwandelt sich in pures Gift.");
  AddDetail( ({ "essen" }),
    "Du solltest vorsichtig sein bei dem, was Du hier unten zu Dir nimmst.");
  AddDetail( ({ "gift" }),
    "Solche Gewuerze sind pures Gift.");
  AddDetail( ({ "mahlzeiten" }),
    "Die taeglichen Mahlzeiten - sofern es sie taeglich gibt - werden durch die Luke gereicht.");
  AddDetail( ({ "mahlzeit" }),
    "Die Mahlzeit fuer den Kerkerknecht ist mit Sicherheit gut und vor allen Dingen "
    "richtig gewuerzt.");
  AddDetail( ({ "sicherheit" }),
    "Da kannst Du Dir sicher sein.");
  AddDetail( ({ "dingen", "dinge" }),
    "Der Kerkerknecht wird schon auf die richtigen Gewuerze fuer sich achten.");
  AddSpecialDetail( ({ "feuerstelle", "dreibein", "art" }), "strfeuerstelle");
  AddSpecialDetail( ({ "feuer" }), "strfeuer");
  AddDetail( ({ "kochtopf" }),
    "In dem Kochtopf befindet sich etwas Suppe.");
  AddDetail( ({ "suppe" }), 
    "Die Suppe sieht nicht sonderlich appetitlich aus.");
  AddDetail( ({ "waende", "wand" }),
    "Welche Wand meinst Du genau?");
  AddDetail( ({ "decke" }),
    "Die Decke besteht wie der Boden aus rauhen, alten Steinen. Direkt ueber der Feuerstelle "
    "ist ein kleiner Abzug geschaffen worden.");
  AddDetail( ({ "abzug" }),
    "Der Rauch des Feuers kann so ungehindert abziehen.");
  AddDetail( ({ "rauch" }),
    "Feuer verursacht fuer gewoehnlich Rauch.");
  AddDetail( ({ "boden" }),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "gaensehaut" }),
    "Das Stoehnen aus dem Sueden verursacht eine Gaensehaut bei Dir.");
  AddDetail( ({ "gitter", "gitterstaeben", "gitterstaebe" }),
    "Die einzelnen Gitterstaebe sind sehr verrostet und erlauben nur einen kleinen "
    "Einblick in den Kerker.");
  AddDetail( ({ "einblick", "blick" }),
    "Wenn Du einen genaueren Blick in den Kerker werfen willst, musst Du ihn schon "
    "betreten.");
  AddDetail( ({ "kerker" }),
    "Der eigentliche Kerker befindet sich im Sueden hinter der Kerkertuer.");
  AddDetail( ({ "riegel" }),
    "Ein grosser Riegel verschliesst die Tuer.");
  AddDetail( ({ "seite" }),
    "Nur von dieser Seite aus laesst sich die Kerkertuer oeffnen.");
  AddDetail( ({ "rost" }),
    "Der Rost deutet auf ein sehr hohes Alter der Tuer hin.");
  AddDetail( ({ "alter" }),
    "Die Kerkertuer scheint, genauso wie der restliche Kerker, schon sehr alt zu sein.");
  AddDetail( ({ "eisen" }),
    "Die Kerkertuer besteht aus massivem Eisen.");
  AddDetail( ({ "fenster" }),
    "Das Fenster ist viel zu klein, um genaueres im Kerker erkennen zu koennen.");
  AddDetail( ({ "gefangene", "gefangener", "gefangenen" }),
    "Die Gefangenen befinden sich im Kerker.");
  AddDetail( ({ "osten" }),
    "Im Osten befindet sich ein Kohlebecken mit einem gluehenden Brandeisen darin.");
  AddDetail( ({ "koehlebecken", "kohlebecken" }),
    "In dem Kohlebecken befinden sich brennende Kohlestuecke und ein gluehendes "
    "Brandeisen.");
  AddDetail( ({ "koehlestuecken", "kohle", "kohlestuecke" }),
    "In dem Kohlebecken brennt ein wenig Kohle.");
  AddDetail( ({ "brandeisen" }),
    "Das Brandeisen wird dazu verwendet, neu angekommene Gefangene zu markieren. Die "
    "Spitze des Brandeisens scheint eine besondere Form zu haben.");
  AddDetail( ({ "spitze" }),
    "Die Spitze glueht rot.");
  AddDetail( ({ "form" }),
    "Es scheint die Form eines \"L\"'s zu haben.");
  AddDetail( ({ "l" }),
    "Wofuer koennte das L wohl stehen?");
  AddDetail( ({ "luminor" }),
    "Gut geraten.");
  AddDetail( ({ "ostwand" }),
    "An der Ostwand sind ein paar Halterungen fuer Ketten befestigt. Sie werden dazu "
    "verwendet, Gefangene die gebrandmarkt werden, zu fesseln.");
  AddDetail( ({ "halterungen" }),
    "Im Grunde nichts weiter als einfache Metallringe.");
  AddDetail( ({ "metallringe", "ringe", "ringen" }),
    "Einfache Metallringe, durch die man Ketten ziehen kann, um Gefangene "
    "kurzzeitig zu fesseln.");
  AddDetail( ({ "ketten" }),
    "Zur Zeit befinden sich keine Ketten in den Ringen. Ob sie der Kerkerknecht hat?");
  AddDetail( ({ "kerkerknecht", "knecht" }),
    "Der Kerkerknecht scheint gerade nicht da zu sein.");

  AddSound( DEFAULT_SOUND,
    "Leises Stoehnen dringt aus dem Sueden herein.");

  AddSound( ({ "stoehnen", "sueden", "gefangener" }),
    "Das Stoehnen gequaelter Gefangener verursacht eine Gaensehaut bei Dir.");

  AddSmell( DEFAULT_SMELL,
    "Ein durchdringender Geruch kommt von dem Kochtopf her.");

  AddSmell( ({ "geruch" }),
    "Der Geruch scheint vom Kochtopf auszugehen.");
  AddSmell( ({ "kochtopf" }),
    "Du kannst den Geruch nicht eindeutig identifizieren, er scheint aber "
    "unzweifelhaft von der Suppe im Kochtopf auszugehen.");
  AddSmell( ({ "suppe" }),
    "Du kannst nicht genau sagen, wonach die Suppe riecht. Sonderlich gut "
    "riecht sie jedenfalls nicht.");
 
  AddExit( "norden", "die Treppe hinauf#" +  N );
  AddExit( "nordoben", "die Treppe hinauf#" +  N );
  
  SetProp(P_HIDE_EXITS, ({ "norden" }));
  
  NewDoor("sueden", S , ({"tuer", "Kerkertuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Kerkertuer.",
      D_LONG, "Die verrostete Kerkertuer besteht aus massivem Eisen mit einem "
              "kleinen Fenster aus Gitterstaeben. Ein grosser Riegel "
              "verschliesst die Tuer von dieser Seite. Von der anderen Seite "
              "duerfte es nahezu unmoeglich sein, die Tuer zu oeffnen.",
      D_NAME,  "Kerkertuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_OPENMSG, ({"Du oeffnest die Kerkertuer.",
                   "%s oeffnet die Kerkertuer.",
                   " wird von der anderen Seite geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Kerkertuer.",
                   "%s schliesst die Kerkertuer",
                   " wird von der anderen Seite geschlossen."}),
      D_RESET_CLOSEMSG,
                  " im Sueden ist zugefallen!\n"
    })
  );

  AddItem( NPC "kerkerknecht", REFRESH_DESTRUCT);

  AddCmd( "koste|iss|ess|esse&suppe", "cmdkosten",
          "Was willst Du kosten?" );

  AddCmd( "wuerze|wuerz&suppe|suppe&mit&salz", "cmdsalz",
          "Was willst Du wuerzen?|Womit willst Du die Suppe wuerzen?" );

  AddCmd( "wuerze|wuerz&suppe|suppe&mit&pfeffer", "cmdpfeffer",
          "Was willst Du wuerzen?|Womit willst Du die Suppe wuerzen?" );

  AddCmd( "zuende|zuend&feuer&an", "cmdzuenden",
          "Was willst Du anzuenden?" );

}

// Die Tuer laesst sich nur oeffnen wenn der Kerkerknecht weg ist
int tueroeffnen()
{
  if (present("kerkerknecht"))
  {
  	write(BS("Der Kerkerknecht stoesst Dich unsanft von der Tuer weg."));
  	say(BS("Der Kerkerknecht stoesst "+TP->Name()+" unsanft von der Tuer weg."));
    return -1;
  }
  else
  {
    write(BS("Mit aller Kraft stemmst Du Dich gegen den Riegel und schiebst "
             "ihn zur Seite."));
  	say(BS(TP->Name()+" stemmt sich mit aller Kraft gegen den Riegel und "
  	         "schiebt ihn zur Seite."));
    return 0;
  }
}


string strfeuerstelle(string key)
{
  string s;
  s = "Ueber der Feuerstelle haengt ein riesiger uebelriechender Kochtopf an "
     +"einer Art Dreibein. ";
  
  if(feuer == AUS)
  {
     s += "Es brennt kein Feuer unter dem Kochtopf.";
  }
  else
  {
  	s += "Ein loderndes Feuer erhitzt den Kochtopf.";
  }
  return BS(s);
}

string strfeuer(string key)
{
  string s;

  if(feuer == AUS)
  {
     s = "Es brennt kein Feuer unter dem Kochtopf.";
  }
  else
  {
  	s = "Ein loderndes Feuer erhitzt den Kochtopf.";
  }
  return BS(s);
}

// Suppe kosten
int cmdkosten(string str )
{

  if(!(zaehler > 0))
  {
    write(BS("Hier war wohl schon jemand naschen! Da Du den Gefangenen noch etwas "
            +"uebriglassen willst, kostest Du nichts von der Suppe."));
    return -1;
  }

  if(feuer == AUS)
  {
  	write(BS("Kalte Suppe moechtest Du nicht kosten."));
    return -1;
  }

  if(!TP->eat_food(5))
  {
  	return -1;
  }



  if(suppe == UNGEWUERZT)
  {
    write(BS("Du kostest ein wenig von der Suppe. Iigitt, da fehlen ja noch die Gewuerze!"));
  }

  if(suppe == GESALZEN)
  {
    write(BS("Du kostest ein wenig von der Suppe. Baeh, die Suppe ist ja nur "
            +"gesalzen. Fuer eine wirklich gute Suppe fehlt noch etwas!"));
  }

  if(suppe == GEPFEFFERT)
  {
    write(BS("Du kostest ein wenig von der Suppe. Gar nicht schlecht, mit ein wenig "
            +"Salz waere die Suppe perfekt."));
  }

  if(suppe == FERTIG)
  {
    write(BS("Du kostest ein wenig von der Suppe. Ja jetzt ist sie gut gewuerzt."));
    say(BS(TP->name()+" kostet ein wenig von der Suppe und ein Laecheln ueberzieht "
             +(TP->QueryProp(P_GENDER) == FEMALE ? "ihr":"sein")+" Gesicht."));
    TP->heal_self(10 + random(5));
    zaehler--;
    return 1;
  }

  say(BS(TP->name()+" kostet ein wenig von der Suppe und verzieht "
       +(TP->QueryProp(P_GENDER) == FEMALE ? "ihr":"sein")+" Gesicht."));
  return -1;
}

// Suppe wuerzen
int cmdsalz(string str )
{
  if(suppe == GESALZEN)
  {
    write(BS("Jemand hat die Suppe schon gesalzen!"));
    return -1;
  }
  
  if(suppe == GEPFEFFERT)
  {
  	suppe = FERTIG;
  }
  else
  {
    suppe = GESALZEN;
  }
  
  write(BS("Du nimmst ein wenig Salz aus dem Regal und wuerzt die Suppe damit."));
  say(BS(TP->Name()+" hantiert am Kochtopf herum."));
  return 1;
}

// Suppe wuerzen
int cmdpfeffer(string str )
{
  if(suppe == GEPFEFFERT)
  {
    write(BS("Jemand hat in die Suppe schon Pfeffer getan!"));
    return -1;
  }
  
  if(suppe == GESALZEN)
  {
  	suppe = FERTIG;
  }
  else
  {
    suppe = GEPFEFFERT;
  }
  
  write(BS("Du nimmst ein wenig Pfeffer aus dem Regal und wuerzt die Suppe damit."));
  say(BS(TP->Name()+" hantiert am Kochtopf herum."));
  return 1;
}

int cmdzuenden(string str)
{
  if (feuer == AUS)
  {
    write(BS("Vorsichtig zuendest Du mit einem gluehenden Stueck Kohle das Feuer an. "
            +"Jetzt ist die Suppe schoen heiss."));
    say(BS(TP->Name()+" zuendet mit einem gluehenden Stueck Kohle das Feuer an."));
    feuer = AN;
    return 1;
  }
  else
  {
  	write(BS("Das Feuer brennt doch bereits?"));
  	return -1;
  }
}

reset()
{
  ::reset();

  if(feuer == AN)
  {
    Message(BS("Das Feuer unter dem Kochtopf erlischt."), MSGFLAG_VISUAL);
    feuer = AUS;
  }

  suppe = UNGEWUERZT;
  zaehler = 3;

}