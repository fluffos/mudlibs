
inherit "std/room";

#include "../def.h"

#define OBEN ROOM "firstfloorB2"

int seil, seil_befestigt;

create()
{
  ::create();

  seil = DA;
  seil_befestigt = NEIN;

  SetProp( P_INT_SHORT, "In einem Abgrund" );
  SetProp( P_INT_LONG,
    "Ueberall um Dich herum stecken Holzpfloecke im Boden. Auf einigen von ihnen "
    "sind mehr oder weniger verweste Leichen aufgespiesst. Der Verwesungsgeruch "
    "treibt Dir Traenen in die Augen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "holzstaebe", "holzpfloecke", "holzpflock" }),
    "Aehnlich Speeren, nur nicht von so hoher Qualitaet.");
  AddDetail( ({ "speere", "sperr" }),
    "Keine echten Speere, nur einfache angespitzte Holzstaebe.");
  AddDetail( ({ "qualitaet" }),
    "Es hat lediglich jemand ein Ende angespitzt.");
  AddDetail( ({ "ende" }),
    "Pass lieber auf, dass die Speere nicht Dein Ende werden.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit Staub und anderem Unrat uebersaeht.");
  AddDetail( ({ "staub" }),
    "Hier unten war schon lange niemand mehr freiwillig.");
  AddDetail( ({ "unrat" }),
    "Ausruestungsgegenstaende und andere Teile von den Leichen.");
  AddDetail( ({ "ausruestungsgegenstaende", "gegenstaende" }),
    "Zerbeulte Panzer, durchloecherte Hosen und andere Sachen.");
  AddDetail( ({ "panzer" }),
    "Die Panzer sind zu nichts mehr zu gebrauchen.");
  AddDetail( ({ "hosen" }),
    "Solch zerfetzte Hosen zieht niemand freiwillig an.");
  AddDetail( ({ "sachen" }),
    "Alles erdenkliche, vielleicht ist ja doch etwas fuer Dich dabei?");
  AddDetail( ({ "teile" }),
    "Dich schauderts, wenn Du nur daran denkst.");
  AddDetail( ({ "leichen" }),
    "Einige weniger Glueckliche als Du.");
  AddDetail( ({ "glueckliche" }),
    "Gluecklichere Leichen ... aeh, Abenteurer.");
  AddDetail( ({ "abenteurer" }),
    "So einer wie Du.");
  AddDetail( ({ "verwesungsgeruch", "geruch" }),
    "Das ist weniger etwas zum untersuchen als zum riechen.");
  AddDetail( ({ "traenen" }),
    "Der Verwesungsgeruch treibt Dir Traenen in die Augen.");
  AddDetail( ({ "augen" }),
    "Du kannst kaum noch etwas sehen vor lauter Traenen.");
  AddDetail( ({ "waende", "wand" }),
    "Welche Wand meinst Du genau?");
  AddDetail( ({ "suedwand", "nordwand" }),
    "An der Sued- und Nordwand kannst Du nichts Auffaelliges entdecken.");
  AddDetail( ({ "auffaelliges" }),
    "Du starrst einige Zeit auf die Waende. Tatsaechlich, nichts Auffaelliges.");
  AddDetail( ({ "zeit" }),
    "Sehr lange hast Du nicht gestarrt.");
  AddDetail( ({ "ostwand" }),
    "Etliche Meter ueber Dir kannst Du einen Vorsprung ausmachen. Dort scheint "
    "eine Seite des Abgrunds zu sein. Desweiteren erkennst Du ein paar Nischen "
    "und Spalten.");
  AddDetail( ({ "meter" }),
    "Wie lang ein Meter ist, sollte Dir schon klar sein, andernfalls kann man Dir "
    "nur ein Massband empfehlen.");
  AddDetail( ({ "massband" }),
    "Geruechteweise soll es eines in dem Fischerdorf geben.");
  AddDetail( ({ "fischerdorf", "dorf" }),
    "Ein Dorf voller Fische.");
  AddDetail( ({ "fische" }),
    "Aeh, Fischer.");
  AddDetail( ({ "fischer" }),
    "Fischer befinden sich fuer gewoehnlich im Fischerdorf.");
  AddDetail( ({ "vorsprung" }),
    "Dort befindet sich eine Seite vom Abgrund.");
  AddDetail( ({ "seite", "seiten" }),
    "Ein Abgrund hat zwei sich gegenueberliegende Seiten.");
  AddDetail( ({ "abgrund" }),
    "Leider bist Du in ihn gefallen.");
  AddDetail( ({ "nischen", "spalten", "klettern" }),
    "Eventuell helfen diese Spalten und Nischen beim Klettern.");
  AddDetail( ({ "westwand" }),
    "Etliche Meter ueber Dir kannst Du einen Vorsprung erkennen. Direkt darunter "
    "scheint ein kleinerer Felsvorsprung zu sein.");
  AddDetail( ({ "felsvorsprung" }),
    "Ob dieser Felsvorsprung eine Hilfe fuer Dich sein kann?");
  AddDetail( ({ "hilfe" }),
    "Wenn man dort oben nur ein Seil befestigen koennte.");
  AddDetail( ({ "seil" }),
    "Hast Du eins?");
  AddDetail( ({ "ohr" }),
    "Pass bloss auf, dass sie keiner abschneidet.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich viele Meter ueber Dir");
  AddDetail( ({ "spass", "menge" }),
    "Soviel Spass hast Du hier unten zwischen den vielen Leichen leider nicht.");

  AddSound( DEFAULT_SOUND,
    "Du kannst nicht viel hoeren, lediglich das Gegroehle und Gestampfe der Onis oben.");

  AddSound( ({ "gegroehle" }),
    "Die Onis groehlen laut, sie scheinen eine Menge Spass zu haben.");
  AddSound( ({ "gestampfe", "stampfen" }),
    "Die Onis stampfen laut.");
  AddSound( ({ "oni", "onis" }),
    "Lautes gegroehle und gestampfe dringt an Dein Ohr.");
  AddSound( ({ "ohr" }),
    "Wie willst Du an Deinem Ohr lauschen? Untersuchen waere angebrachter.");

  AddSmell( DEFAULT_SMELL,
    "Ein durchdringender Verwesungsgeruch ueberdeckt alles andere.");

  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Der Verwesungsgeruch treibt Dir regelrecht Traenen in die Augen.");

  AddCmd( "wuehle|wuehl|durchsuch|durchsuche|durchwuehle|durchwuehl&sachen", "cmdsuchen",
          "Was willst Du durchwuehlen oder durchsuchen?" );
  AddCmd( ({"kletter", "klettere"}), "cmdkletter");
  AddCmd( "befestige&seil|seil&an&felsvorsprung|vorsprung", "cmdbefestigen",
          "Was willst Du befestigen?|Woran willst Du Dein Seil befestigen?");
  AddCmd( "wirf&seil|seil&nach&felsvorsprung|vorsprung", "cmdwerfen",
          "Was willst Du werfen?|Wonach willst Du Dein Seil werfen?");
  AddCmd( "greif|greife&in&spalte|nische|spalten|nischen", "cmdgreifen",
          "In was willst Du greifen?" );

}

int cmdsuchen(string key)
{
  object myseil;
  myseil = present("seil", TP);
  if(myseil || seil == WEG)
  {
    write(BS("Du durchsuchst die Sachen auf dem Boden gruendlichst, findest aber "
            +"nichts hilfreiches."));
    say(BS(PL->Name()+" durchsucht einige Sachen auf dem Boden."));
    return 1;
  }
  else
  {
    write(BS("Du durchsuchst die Sachen auf dem Boden und findest "
            +"tatsaechlich ein Seil."));
    say(BS(PL->Name()+" durchsucht einige Sachen auf dem Boden und findet "
            +"triumphierend etwas."));
    myseil=clone_object("/obj/seil");

    if(ME_TOO_HEAVY==myseil->move(TP,M_GET|M_SILENT))
    {
      write(BS("Da Du das Seil nicht mehr tragen kannst, laesst Du es fallen."));
      myseil->move(this_object(), M_PUT);
      return 1;
    }

    seil = WEG;
    return 1;
  }
}

int cmdkletter(string str)
{
  object raum;
  
  notify_fail("Wohin willst Du klettern?\n" );

  if((str=="nach oben") || (str =="zum vorsprung") || 
     (str=="hinauf") || (str=="auf vorsprung")) 
  {
    SetProp(P_KILL_NAME, "Ein spitzer Holzpflock" ); 
    switch(random(5))
    {
      case 1:
        write(BS("Du versuchst, mit Hilfe der Nischen und Spalten nach oben zu klettern. "
                +"Kurz vor dem Vorsprung rutschst Du leider wieder nach unten und schaffst "
                +"es nicht, einem Pflock auszuweichen!!"));
        TP->do_damage(30+random(30), this_object());
        break;
      case 2:
        write(BS("Auf halbem Weg broeckeln ein paar Steine ab und Du faellst wieder in "
                +"die Tiefe! Geschickt wie ein Panther weichst Du den Holzpfloecken aus."));
        break;
      case 3:
        write(BS("Auf halbem Weg broeckeln ein paar Steine ab und Du faellst wieder in "
                +"die Tiefe! Geschickt wie ein Elefant weichst Du den Holzpfloecken aus "
                +"und wirst von einigen aufgespiesst!!!"));
        TP->do_damage(50+random(30), this_object());
        break;
      case 4:
        write(BS("Vergeblich versuchst Du, nach oben zu klettern, so wird das wohl nichts."));
        break;
      default:
        write(BS("Schon die erste Nische zerbroeckelt unter Deinem Gewicht."));
        break;
    }
    say(BS(PL->Name()+" versucht vergeblich, an der Ostwand hochzuklettern."));
    return 1;
  }

  if((str=="mit seil nach oben") || (str =="mit seil zum vorsprung") || 
     (str=="mit seil hinauf") || (str=="mit seil auf vorsprung")) 
  {
    if(seil_befestigt == JA)
    {
      write(BS("Mit Hilfe des Seiles ist es kein Problem fuer Dich nach oben zu klettern."));
  
      call_other (OBEN, "???", 0);
      raum = find_object(OBEN);
      if(raum)
      {
          TP->move(raum, M_NO_SHOW|M_NOCHECK, "herauf",
                         "klettert", "klettert herein");
      }
      else
      {
        write("Fehler! Bitte melde ihn an Torian.\n");
      }
      return 1;
    }
    else
    {
      write(BS("Ohne ein befestigtes Seil kommst Du nirgendwohin."));
      return -1;
    }
  }
  return 0;
}
int cmdbefestigen(string key)
{
  if(!present("seil", TP))
  {
    write(BS("Welches Seil meinst Du?"));
    return -1;
  }
  else
  {
    write(BS("Und wie willst Du das Seil nach dort oben bekommen?"));
    return 1;
  }
}

int cmdgreifen(string key)
{
  write(BS("Du greifst in die Nischen und Spalten und findest ... nichts."));
  return 1;
}

int cmdwerfen(string key)
{
  object seil;
  seil = present("seil", TP);
  if(!seil)
  {
    write(BS("Welches Seil meinst Du?"));
    return -1;
  }
  else
  {
    write(BS("Du knotest Dein Seil wie ein Lasso und wirfst es nach oben. Tatsaechlich "
          +"bleibt es an dem Felsvorsprung haengen. Jetzt ist es Dir ein leichtes "
          +"mit dem Seil nach oben zu klettern."));
    seil_befestigt = JA;
    seil->remove();
    return 1;
  }
}

reset()
{
  ::reset();

  if(seil_befestigt == JA)
  {
    write(BS("Das Seil faellt herunter und verschwindet zwischen den Sachen."));
    seil_befestigt = NEIN;
  }
  seil = DA;
  
}
