
inherit "std/room";

#include "../def.h"

#define W ROOM "erdgB2"
#define S ROOM "ugrechtsA1"

int ruestung, schild;

create()
{
  ::create();

  ruestung = DA;
  schild = DA;

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Fehler");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "ende" }),
    "Du befindest Dich am rechten Ende der grossen Halle.");
  AddDetail( ({ "halle" }),
    "Die Halle, in der Du Dich befindest, ist sehr gross und "
    "weitlaeufig. Sie wurde aus rotem Sandstein erbaut.");
  AddDetail( ({ "sandstein" }),
    "Die Halle wurde aus einfachem roten Sandstein erbaut.");
  AddDetail( ({ "durcheinander" }),
    "Ein grosses Durcheinander herrscht hier in der Halle.");
  AddDetail( ({ "kampfesspuren", "kampfspuren" }),
    "Ueberall siehst Du deutliche Spuren eines Kampfes, der hier "
    "stattgefunden hat.");
  AddDetail( ({ "spuren" }),
    "Der Boden ist mit unzaehligen Blutspritzern uebersaeht und es "
    "liegen einige kaputte Pfeile sowie ein alter zerschlissener Umhang "
    "herum.");
  AddDetail( ({ "blutspritzer", "spritzer" }),
    "Viele Blutspritzer uebersaehen den trockenen Sandsteinboden und "
    "faerben ihn dunkelrot.");
  AddDetail( ({ "boden", "sandsteinboden" }),
    "Der rote Sandsteinboden ist mit dunklen Blutspritzern uebersaeht.");
  AddDetail( ({ "pfeile" }),
    "Einige zerbrochene Pfeile liegen auf dem Boden.");
  AddDetail( ({ "umhang" }),
    "Der Umhang ist voellig zerschlissen und von dunklen Blutflecken verfaerbt.");
  AddDetail( ({ "blutflecken" }),
    "Du siehst dunkle Blutflecken in dem zerschlissenen Umhang.");
  AddDetail( ({ "kampfes", "kampf" }),
    "Ein schrecklicher Kampf muss hier getobt haben.");
  AddSpecialDetail( ({ "norden", "schild", "wappen",
                       "sonnensymbol", "symbol", "kreis",
                       "strahlen", "sonne", "feuer", "waende",
                       "wand", "nordwand", "abdruck" }), "details_schild");
  AddDetail( ({ "schwerter" }),
    "Zwei versilberte Zierschwerter liegen auf dem Boden vor der Nordwand.");
  AddDetail( ({ "zierschwerter" }),
    "Diese Schwerter haben stumpfe Klingen und dienen nur zur Zierde.");
  AddDetail( ({ "klingen", "klinge" }),
    "Die Klingen der Schwerter sind abgestumpft, damit sich niemand "
    "daran verletzen kann.");
  AddDetail( ({ "zierde" }),
    "Die Schwerter dienen nur zur Zierde.");
  AddSpecialDetail( ({ "ostwand" }), "strostwand");
  AddSpecialDetail( ({ "ritterruestung", "ruestung" }), "strruestung");
  AddDetail( ({ "sockel" }),
    "Die Ruestung steht auf einem niedrigen Sockel.");
  AddDetail( ({ "helm" }),
    "Der Helm hat nur sehr schmale Sehschlitze.");
  AddDetail( ({ "sehschlitzen", "sehschlitze" }),
    "Durch die Sehschlitze kannst Du nichts erkennen.");
  AddDetail( ({ "harnischkragen", "kragen" }),
    "Der Harnischkragen soll den Hals vor toedlichen Stichen schuetzen.");
  AddDetail( ({ "hals" }),
    "Durch den Kragen wird der Hals gut geschuetzt.");
  AddDetail( ({ "stiche", "stichen" }),
    "Stiche zum Hals hin sind meistens toedlich.");
  AddDetail( ({ "brustharnisch" }),
    "Der Brustharnisch ist durch Lederriemen mit dem Rueckenpanzer verbunden.");
  AddDetail( ({ "lederriemen" }),
    "Die Lederriemen sehen fast wie neu aus.");
  AddDetail( ({ "rueckenpanzer" }),
    "Rueckenpanzer und Brustharnisch sind durch Lederriemen miteinander verbunden.");
  AddDetail( ({ "armschienen","beinschienen" }),
    "Metallene Arm- und Beinschienen sind mit Eisennieten an der Ruestung "
    "befestigt.");
  AddDetail( ({ "eisennieten" }),
    "Mit glaenzenden Eisennieten sind die Arm- und Beinschienen an der "
    "Ruestung befestigt.");
  AddDetail( ({ "panzerhandschuhen", "handschuhen", "handschuhe", "panzerhandschuhe" }),
    "Die Panzerhandschuhe lassen jedem einzelnen Fingerglied voellige "
    "Bewegungsfreiheit.");
  AddDetail( ({ "fingerglied", "bewegungsfreiheit" }),
    "Auch Deine fetten Wurstfinger passen hinein.");
  AddDetail( ({ "wurstfinger", "finger" }),
    "Du betrachtest Deine zwei linken Daumen.");
  AddDetail( ({ "daumen" }),
    "Geschickt wie immer.");
  AddDetail( ({ "kniegelenke", "kniegelenken", "fussgelenke", "fussgelenken", "gelenke"}),
    "Die Knie- und Fussgelenke sorgen dafuer, dass die Gelenke trotz der "
    "Ruestung beweglich bleiben und gut geschuetzt sind.");
  AddDetail( ({ "treppe" }),
    "Die Treppe fuehrt nach unten.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich weit ueber Dir. Sie besteht aus rotem Sandstein.");

  AddSound( DEFAULT_SOUND,
    "Weit ueber Dir hoerst Du lautes Getrampel. Aus dem Sueden dringen "
    "schreckliche Schmerzensschreie.");

  AddSound( ({ "getrampel" }),
    "Das Getrampel kommt von irgendwo weit ueber Dir.");
  AddSound( ({ "sueden" }),
    "Laute Schmerzensschreie kommen aus dem Sueden.");
  AddSound( ({ "schmerzensschreie", "schreie" }),
    "Dir stehen die Haare zu Berge.");
  AddSound( ({ "haare" }),
    "Daran kannst Du nicht lauschen!");
  AddSound( ({ "berge" }),
    "Daran kannst Du auch nicht lauschen!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Tod und Verwesung.");

  AddSmell( ({ "tod" }),
    "Du spuerst, dass in dieser Halle schon viele Lebewesen gestorben sind.");
  AddSmell( ({ "verwesung", "verwesungsgeruch", "geruch" }),
    "Starker Verwesungsgeruch durchdringt die Halle.");
  AddSmell( ({ "halle" }),
    "Die Halle wird von starken Verwesungsgeruch erfuellt.");
  AddSmell( ({ "lebewesen" }),
    "Hier sind schon sehr viele Lebewesen jaemmerlich gestorben.");
 
  AddExit( "westen", "nach Westen#" +  W );

  AddExit ("suedunten", ([ EX_DEST:     S,
                         EX_TESTFUNC: "exit_test",
                         EX_MSG: "die Treppe hinunter" ]) );
  AddExit ("sueden", ([ EX_DEST:     S,
                         EX_TESTFUNC: "exit_test",
                         EX_MSG: "die Treppe hinunter" ]) );
  SetProp(P_HIDE_EXITS, ({ "sueden" }));

  AddCmd( ({ "nimm", "nehme", "nehm" }), "cmdnehmen" );

}

string strruestung(string key)
{
  string s;
  s = "";
  if(ruestung == DA)
  {
    s = "Die Ritterruestung steht an der Ostwand. Sie besteht "
       +"aus einem glaenzenden Helm mit schmalen Sehschlitzen, einem "
       +"Harnischkragen und Brustharnisch, Rueckenpanzer, Arm- und "
       +"Beinschienen, Panzerhandschuhen sowie Knie- und Fussgelenken.";
  }
  else
  {
    s = "Die Ritterruestung liegt vor der Ostwand auf dem Boden. Sie bestand "
       +"aus einem glaenzenden Helm mit schmalen Sehschlitzen, einem "
       +"Harnischkragen und Brustharnisch, Rueckenpanzer, Arm- und "
       +"Beinschienen, Panzerhandschuhen sowie Knie- und Fussgelenken. Die "
       +"Ritterruestung wurde fein saeuberlich auseinander genommen.";
  }
  return BS(s);
}
int cmdnehmen(string str)
{
  object myshield;
  
  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  switch (str)
  {
    case "pfeile":
    case "pfeil":
      write(BS("Mit den zerbrochenen Pfeilen kannst Du nichts anfangen."));
      return -1;
    case "umhang":
      write(BS("Der Umhang ist so mit Blut uebersaeht, dass Du ihn lieber "
              +"liegen laesst."));
      return -1;
    case "schild":
      if(schild == DA)
      {
        myshield=clone_object(ARMOUR "tschild");
        if(ME_TOO_HEAVY==myshield->move(TP,M_GET|M_SILENT))
        {
          write("Du kannst den Schild nicht mehr tragen.\n");
          myshield->remove();
          return -1;
        }
        else
        {
          write(BS("Vorsichtig nimmst Du den Schild von der Wand."));
          say(BS(PL->name()+" nimmt den Schild von der Wand."));
          schild = WEG;
          return 1;
        }
      }
      write(BS("Welchen Schild meinst Du denn?"));
      return -1;
    case "schwert":
    case "schwerter":
      write("Was willst Du mit Zierschwertern?\n");
      return -1;
    case "ruestung":
    case "ritterruestung":
      if(!present("ritterruestung"))
      {
        write("Du beruehrst die Ritterruestung als ploetzlich Leben in sie kommt?!?!\n");
        ruestung = WEG;
        AddItem( NPC "ritterruestung", REFRESH_NONE);
      }
      else
      {
        write(BS("Die lebende Ritterruestung kannst Du nicht nehmen!"));
      }
      return 1;
    default:
      return 0;
  }
}
// Details fuer den Schild an der Wand
string details_schild(string key)
{
  string s, s2;
  s = "";
  s2 = "Sowas siehst Du da nicht!";
  
  switch (key)
  {
    case "norden":
      s = "An der Wand im Norden haengt ein grosser Schild.";
      s2 = "An der Wand im Norden siehst Du den Abdruck eines Schildes";
      break;
    case "abdruck":
      s = s2;
      s2 = "Hier hing wohl vor kurzem noch ein Schild.";
      break;
    case "schild":
      s = "Der Schild zeigt ein rotes Wappen mit einem Sonnensymbol.";
      break;
    case "wappen":
      s = "Auf dem Wappen ist ein Sonnensymbol abgebildet.";
      break;
    case "sonnensymbol":
    case "symbol":
      s = "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
         +"Strahlen rundherum.";
      break;
    case "kreis":
      s = "Der Kreis mit den wellenfoermigen Strahlen soll die Sonne "
         +"darstellen.";
      break;
    case "strahlen":
      s = "Wellenfoermige Strahlen sind um den Kreis herum abgebildet.";
      break;
    case "sonne":
      s = "Die Sonne gilt auch als Symbol fuer Feuer.";
      break;
    case "feuer":
      s = "Die Sonne mit ihren gluehenden Strahlen steht fuer das niemals "
         +"erloeschende Feuer.";
      break;
    case "wand":
    case "nordwand":
      s = "Ein grosser Schild haengt an der Nordwand. Ploetzlich fallen Dir "
         +"zwei Schwerter auf, die direkt an der Wand auf dem Boden liegen. "
         +"Sie scheinen zuvor an dem Schild befestigt gewesen und "
         +"heruntergefallen zu sein.";
      s2 = "Ein grosser Abdruck befindet sich an der Nordwand. Ploetzlich fallen "
         +"Dir zwei Schwerter auf, die direkt an der Wand auf dem Boden liegen. "
         +"Sie scheinen zuvor an dem Schild befestigt gewesen und "
         +"heruntergefallen zu sein.";
      break;
    case "waende":
      s = "An der Wand im Norden haengt ein Schild und an der Ostwand steht "
         +"eine grosse, glaenzende Ritterruestung.";
      s2 = "An der Wand im Norden siehst Du den Abdruck eines Schildes und an "
          +"der Ostwand steht eine grosse, glaenzende Ritterruestung.";
      break;
    default:
      s = s2;
      break;
  }
  if(schild == DA)
  {
    return BS(s);
  }
  else
  {
    return BS(s2);
  }
}

reset()
{
  ::reset();

  if(ruestung == WEG && !present("ritterruestung"))
  {
    tell_room(TO, BS("Erstaunt beobachtest Du wie sich die Ruestung "
                    +"wieder aufbaut."));  
    ruestung = DA;
  }

  schild = DA;

}

string _query_int_long()
{
  string s, s2;
  
  s = "Du stehst am rechten Ende der grossen Halle. Auch hier herrscht ein "
    "voelliges Durcheinander und Du siehst ueberall Kampfspuren. ";

  if (schild == DA)
  {
    s2 = "Im Norden haengt ein Schild an der Wand ";
  }
  else
  {
  	s2 = "Im Norden siehst Du den Abdruck eines Schildes an der Wand ";
  }

  if (ruestung == DA)
  {
    s2 += "und an der Ostwand steht eine grosse, glaenzende Ritterruestung. "
        +"Suedlich von Dir fuehrt eine breite Treppe nach unten.";

  }
  else 
  {
    if(!present("ritterruestung"))
    {
      s2 += "und an der Ostwand liegt eine grosse, glaenzende Ritterruestung auf "
           +"dem Boden. Suedlich von Dir fuehrt eine breite Treppe nach unten.";
    }
    else
    {
      s2 += "und an der Ostwand bewegt sich eine grosse, glaenzende Ritterruestung. "
           +"Suedlich von Dir fuehrt eine breite Treppe nach unten.";
    }
  }
  
  return BS(s+s2);
}


string strostwand(string key)
{
  if (ruestung == DA)
    return BS("An der Ostwand steht eine grosse, glaenzende Ritterruestung.");
  else
  {
  	if(!present("ritterruestung"))
  	{
      return BS("An der Ostwand liegt eine grosse, glaenzende Ritterruestung "
               +"auf dem Boden.");
    }
    else
    {
      return BS("An der Ostwand bewegt sich eine grosse, glaenzende Ritterruestung.");
    }
  }
}

//Falls Ritterruestung vorhanden, aktivieren und kaempfen lassen
int exit_test(string dir)
{

    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    if(IS_LEARNER(TP)) return 1;

    if(present("ritterruestung"))
    {
      write(BS("Die Ritterruestung haelt Dich auf!"));
      say(BS(TP->Name()+" wird von der Ritterruestung aufgehalten!"));
      return 0;
    }
    if(ruestung == DA)
    {
      write(BS("Ploetzlich kommt Bewegung in die Ritterruestung!"));
      AddItem( NPC "ritterruestung", REFRESH_NONE);
      ruestung = WEG;
      return 0;
    }
    return 1;
}