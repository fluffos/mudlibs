
inherit "std/room";

#include "../def.h"

#define S ROOM "thirdfloorB2"
#define UNTEN ROOM "secondfloorB1"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Fehler!");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "zimmer", "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "einrichtungsgegenstaenden", "gegenstaenden", "gegenstand", 
                "einrichtungsgegenstaende" }),
    "Von der Einrichtung ist nicht viel uebrig geblieben. Zwischen den "
    "Truemmern meinst Du vage einen Tisch und ein paar Stuehle auszumachen.");
  AddDetail( ({ "truemmer", "einrichtung" }),
    "Ueberall liegen Truemmer zerstreut. Die Einrichtung ist groesstenteils "
    "verbrannt. Nur bei wenigen Haufen kannst Du noch eine fruehere Bedeutung "
    "erkennen.");
  AddDetail( ({ "haufen" }),
    "Ein Grossteil der Haufen sind nicht mehr zu erkennen. Leidiglich einen "
    "Tisch und ein paar Stuehle kannst Du noch erkennen.");
  AddDetail( ({ "grossteil" }),
    "Einige Haufen Truemmer liegen hier herum.");
  AddDetail( ({ "bedeutung" }),
    "Nur bei einigen Haufen kannst Du den frueheren Verwendungszweck noch "
    "erkennen.");
  AddDetail( ({ "verwendungszweck" }),
    "Einer der Haufen scheint frueher ein Bett gewesen zu sein.");
  AddDetail( ({ "bett" }),
    "Die Truemmer des Bettes weisen merkwuerdige Konturen auf.");
  AddDetail( ({ "konturen" }),
    "Die Konturen scheinen ein Mensch gewesen zu sein.");
  AddDetail( ({ "mensch" }),
    "Er muss im Schlaf verbrannt sein. Ob das der fruehere Besitzer des "
    "Turmes ist?");
  AddDetail( ({ "leichen" }),
    "Einige angenagte Leichen liegen im Zimmer verstreut. Luminor scheint hier "
    "einen Teil seiner Mahlzeiten eingenommen zu haben.");
  AddDetail( ({ "luminor" }),
    "Er scheint nicht hier zu sein.");
  AddDetail( ({ "teil" }),
    "Luminor hat einen Teil seiner Mahlzeiten hier verspeist.");
  AddDetail( ({ "mahlzeiten" }),
    "Seine Mahlzeiten bestanden offensichtlich aus Menschen, Elfen, Hobbits "
    "und anderen Wesen.");
  AddDetail( ({ "menschen", "elfen", "hobbits" }),
    "Dir wird schlecht.");
  AddDetail( ({ "wesen" }),
    "Du drehst Dich angewidert weg. So genau willst Du es gar nicht wissen.");
  AddDetail( ({ "norden" }),
    "Im Norden befindet sich ein Loch im Boden.");
  AddDetail( ({ "boden" }),
    "Der Boden weist deutliche Spuren Luminors Verwuestung vor.");
  AddDetail( ({ "spuren" }),
    "Von Spuren kann man kaum noch reden. Der gesamte Raum wurde von "
    "Luminor zerstoert.");
  AddDetail( ({ "verwuestung" }),
    "Ueberall liegen Truemmer und Leichen herum.");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden befanden sich einstmals grosse Gemaelde. Jetzt sind nur "
    "noch geschwaerzte Rahmen zu sehen.");
  AddDetail( ({ "gemaelde" }),
    "Teilweise vollkommen verbrannt, teilweise haengen noch Fetzen in den "
    "Rahmen. Nichts weist mehr auf die Schoenheit der Bilder hin, die sie "
    "einstmals besessen haben muessen.");
  AddDetail( ({ "fetzen" }),
    "In einigen Rahmen haengen noch ein paar verbrannte Fetzen.");
  AddDetail( ({ "rahmen" }),
    "Die Rahmen muessen aus einem wirklich guten und teuren Holz bestanden "
    "haben. Sie haben das Feuer lediglich angekokelt ueberstanden.");
  AddDetail( ({ "holz" }),
    "Eventuell Eichenholz. Du bist Dir aber nicht sicher.");
  AddDetail( ({ "eichenholz", "hoelzer" }),
    "Eichenholz ist eines der staerksten Hoelzer, die Du kennst.");
  AddDetail( ({ "schoenheit" }),
    "Du schliesst die Augen und versuchst Dir die Schoenheit der Bilder "
    "vorzustellen.");
  AddDetail( ({ "augen" }),
    "Du schaffst es nicht. Zu wenig ist uebriggeblieben.");
  AddDetail( ({ "bilder" }),
    "Die Bilder muessen einstmals wunderschoen gewesen sein.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir. Du kannst nicht genau erkennen, "
    "aus welchem Gestein sie besteht.");
  AddDetail( ({ "gestein" }),
    "Du kannst nicht genau bestimmen, welches Gestein es ist. Du bist Dir "
    "lediglich sicher, dass es kein Obsidiangestein ist.");
  AddDetail( ({ "obsidiangestein", "obsidian" }),
    "Nahezu das komplette Stockwerk unter Dir bestand aus Obsidian.");
  AddDetail( ({ "stockwerk" }),
    "Das Stockwerk unter Dir bestand nahezu komplett aus Obsidian.");
  AddSpecialDetail( ({ "flamme", "loch", "lichtschimmer" }), "strFlamme");
  AddDetail( ({ "feuer" }),
    "Das Feuer hat hier stark gewuetet.");
  AddDetail( ({ "stuehle" }),
    "Ein paar Stuehle kannst Du in den Truemmern erkennen. Sie sehen "
    "nicht gerade stabil aus.");
  AddDetail( ({ "tisch" }),
    "Sogar einen Tisch erkennst Du. Einige Aschehaufen befinden sich darauf.");
  AddDetail( ({ "aschehaufen" }),
    "Du vermutest, dass es frueher Notizen oder andere Schriftstuecke waren.");
  AddDetail( ({ "notizen", "asche" }),
    "Nur noch ein Haufen Asche.");
  AddDetail( ({ "schriftstuecke" }),
    "Du vermutest, dass die Aschehaufen auf dem Tisch frueher Schriftstuecke "
    "oder Notizen waren.");
  AddDetail( ({ "besitzer", "turmes" }),
    "Der fruehere Besitzer ist friedlich im Schlaf gestorben.");
  AddDetail( ({ "schlaf" }),
    "Wenigstens er hatte einen schnellen Tod.");
  AddDetail( ({ "tod" }),
    "Dir wird schlecht bei soviel Leid und Elend.");
  AddDetail( ({ "leid", "elend" }),
    "Soviel Leid und Elend hat Luminor ueber diesen Turm gebracht.");
  AddDetail( ({ "turm" }),
    "Dieser Turm gehoert nun Luminor.");
  AddDetail( ({ "sonnensymbol", "symbol" }),
    "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
    "Strahlen rundherum.");
  AddDetail( ({ "kreis" }),
    "Der Kreis mit den wellenfoermigen Strahlen soll die Sonne "
    "darstellen.");
  AddDetail( ({ "strahlen" }),
    "Wellenfoermige Strahlen sind um den Kreis herum abgebildet.");
  AddDetail( ({ "sonne" }),
    "Die Sonne gilt auch als Symbol fuer Feuer.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Tuer befindet sich ein Sonnensymbol, wie Du es schon "
    "haeufiger in diesem Turm gesehen hast.");
  AddDetail( ({ "nase" }),
    "Deine Nase muss hier ganz schoen was erdulden.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das durchdringende Kreischen von Gespenstern.");

  AddSound( ({ "kreischen" }),
    "Dich schauderts.");
  AddSound( ({ "gespenster" }),
    "Bist Du ihnen schon begegnet?");

  AddSmell( DEFAULT_SMELL,
    "Die verwesenden Leichen verursachen bei Dir einen Brechreiz.");

  AddSmell( ({ "leichen" }),
    "Die Leichen verstroemen einen intensiven Verwesungsgeruch.");
  AddSmell( ({ "brechreiz" }),
    "Du haeltst Dir schnell die Nase zu.");
  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Dir wird schlecht.");

  NewDoor("sueden", S , ({"tuer"}) ,
  ({  DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Tuer.",
      D_LONG, "Eine einfache Tuer mit einem, Dir schon vertraut vorkommendem "
              "Symbol in der Mitte.",
      D_NAME,  "Tuer",
      D_GENDER,FEMALE,
      D_RESET_CLOSEMSG,
                  " im Sueden ist zugefallen!\n"
    })
  );

 AddItem( NPC "luminor", REFRESH_DESTRUCT);

}

string _query_int_long()
{
  string s;
  int flamme;
  object obj;
  call_other (UNTEN, "???", 0);
  obj = find_object(UNTEN);
  
  if(obj)
  {
    flamme = obj->QueryFlamme();
  }
  else
  {
    flamme = RIESIG; 
  }

  s = "Du stehst in Luminors Zimmer. Alles hier drin ist verbrannt. "
     +"Von den einstmals praechtigen Einrichtungsgegenstaenden ist "
     +"nicht mehr viel uebrig geblieben. Ueberall liegen Truemmer und "
     +"angenagte Leichen herum. Im Norden befindet sich ein Loch im "
     +"Boden aus dem ";
  
  switch(obj->QueryFlamme())
  {
    case RIESIG:
      s += "eine riesige Flamme schlaegt.";
      break;
    case SEHRGROSS:
      s += "eine grosse Flamme schlaegt.";
      break;
    case GROSS:
      s += "eine kleine Flamme schlaegt.";
      break;
    case MITTEL:
      s += "keine Flamme schlaegt. Lediglich ein kleiner Lichtschimmer "
          +"aus dem Loch ist zu erkennen.";
      break;
    default:
      s += "eine Flamme schlaegt.";
      DB("Fehler beim Anzeigen der Flamme! (Luminor-_query_int_long) thirdfloor");
      break;
  }
  if (QueryProp(P_DOOR_INFOS))
    return BS(s)+(string)call_other(DOOR_MASTER,"look_doors");

  return BS(s);
}

string strFlamme(string key)
{
  string s;
  int flamme;
  object obj;
  call_other (UNTEN, "???", 0);
  obj = find_object(UNTEN);
  
  if(obj)
  {
    flamme = obj->QueryFlamme();
  }
  else
  {
    flamme = RIESIG; 
  }

  switch(flamme)
  {
    case RIESIG:
      s = "Eine riesige Flamme schlaegt aus dem Boden.";
      break;
    case SEHRGROSS:
      s = "Eine grosse Flamme schlaegt aus dem Boden.";
      break;
    case GROSS:
      s = "Eine kleine Flamme schlaegt aus dem Boden";
      break;
    case MITTEL:
      s = "Keine Flamme schlaegt schlaegt aus dem Boden. Lediglich ein "
         +"kleiner Lichtschimmer aus dem Loch ist zu erkennen.";
      break;
    default:
      s = "Eine Flamme schlaegt aus dem Boden.";
      DB("Fehler beim Anzeigen der Flamme! (Luminor-_query_int_long) thirdfloor");
      break;
  }

  return BS(s);

}