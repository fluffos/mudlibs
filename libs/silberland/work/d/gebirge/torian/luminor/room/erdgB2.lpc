  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "raum" }),
    "Du befindest Dich in einer grossen langgestreckten Halle. Die "
    "Waende wurden ebenso wie der Boden aus rotem Sandstein erbaut.");
  AddDetail( ({ "halle" }),
    "Die Halle ist sehr gross und weitlaeufig. Die Waende wurden aus rotem "
