    "sich zwei grosse Fackelhalter.");
  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus einfachem rotem Sandstein. An der Nordwand "
    "befindet sich eine Tuer, daneben haengen zwei grosse Fackelhalter. "
    "Im Sueden ragt ein grosses Tor empor, durch das Du die Halle wieder "
    "verlassen koenntest.");
  AddDetail( ({ "nordwand", "wand" }),
    "An der Nordwand haengen rechts und links neben der dort "
    "befindlichen Tuer zwei grosse Fackelhalter.");
  AddDetail( ({ "fackelhalter", "halter" }),
    "Die Fackelhalter wurden sorgfaeltig aus den Unterarmknochen von "
    "Zwergen angefertigt. In jedem der beiden Halter steckt eine grosse "
    "Fackel.");
  AddDetail( ({ "unterarmknochen","knochen" }),
    "Die Fackelhalter wurden aus den festen Unterarmknochen von "
    "Zwergen hergestellt. Elle und Speiche wurden am oberen Ende leicht "
    "auseindergezogen und dann mit roten Faeden zusammengewickelt.");
  AddDetail( ({ "zwerge", "zwergen" }),
    "Die Unterarmknochen von Zwergen eignen sich aufgrund ihrer Groesse "
    "und Strapazierfaehigkeit besonders gut fuer Fackelhalter wie diese "
    "hier.");
  AddDetail( ({ "groesse" }),
    "Die Groesse ist genau richtig.");
  AddDetail( ({ "strapazierfaehigkeit" }),
    "Zwerge sind recht zaehe Burschen und ihre Knochen besonders fest "
    "und lange haltbar.");
  AddDetail( ({ "burschen" }),
    "Auch die weiblichen.");
  AddDetail( ({ "elle", "speiche" }),
    "Am oberen Ende wurden Elle und Speiche leicht auseinandergezogen "
    "und anschliessend mit roten Faeden fest umwickelt. In den "
    "entstandenen Zwischenraum wurde eine Fackel hineingesteckt.");
  AddDetail( ({ "ende" }),
    "Am oberen Ende des Fackelhalters ist ein kleiner Zwischenraum "
    "entstanden. Eine Fackel steckt darin.");
  AddDetail( ({ "zwischenraum" }),
    "Der Zwischenraum ist gerade gross genug, um eine Fackel hineinzustecken.");
  AddDetail( ({ "faeden" }),
    "Die Fackelhalter sind mit duennen roten Faeden umwickelt, damit sie "
    "nicht auseinanderfallen koennen. Als Du genauer hinschaust, merkst "
    "Du, dass es gar keine Faeden sind, sondern Haare. Echte rote Haare.");
  AddDetail( ({ "haare" }),
    "Vermutlich handelt es sich um Zwergenhaare.");
  AddDetail( ({ "zwergenhaare" }),
    "Die Haare sind feuerrot.");
  AddSpecialDetail( ({ "fackel", "fackeln"}), "strfackel");
  AddSpecialDetail( ({ "lichtschein", "licht" }), "strLicht");
  AddDetail( ({ "sandstein" }),
    "Diese Halle wurde aus einfachem roten Sandstein erbaut.");
  AddDetail( ({ "zeit" }),
    "Vor nicht allzu langer Zeit fand hier ein harter Kampf statt.");
  AddDetail( ({ "kampf" }),
    "Ein schwerer Kampf muss hier noch vor kurzem getobt haben. Du siehst "
    "ueberall die Ueberreste davon herumliegen.");
  AddDetail( ({ "ueberreste" }),
    "Ueberall liegen abgebrochene Pfeilschaefte, verbeulte Schilde und "
    "sogar zerbrochene Schwerter herum und der Boden ist mit vielen "
    "dunklen Flecken uebersaeht.");
  AddDetail( ({ "pfeilschaefte", "schaefte" }),
    "Die Schaefte liegen ueberall auf dem Boden verstreut. Sie sind alle zerbrochen.");
  AddDetail( ({ "schilde" }),
    "Du siehst ein paar voellig verbeulte Schilde auf dem Boden liegen.");
  AddDetail( ({ "schwerter" }),
    "In all dem Durcheinander findest Du sogar einige alte, mit Blut "
    "verkrustete Schwerter, die allesamt zerbrochen sind.");
  AddDetail( ({ "durcheinander" }),
    "Es herrscht ein schreckliches Durcheinander hier.");
  AddDetail( ({ "blut" }),
    "In dieser Halle ist in der Vergangenheit bereits sehr viel Blut geflossen.");
  AddDetail( ({ "vergangenheit" }),
    "In dieser Halle wurde schon so mancher Kampf ausgetragen.");
  AddDetail( ({ "boden" }),
    "Auf dem Boden liegen ueberall die Ueberreste eines Kampfes herum. "
    "Er ist mit vielen dunklen Flecken uebersaeht.");
  AddDetail( ({ "flecken", "blutflecken" }),
    "Der Boden ist mit dunklen Blutflecken uebersaeht. Schreckliche Kaempfe "
    "muessen hier getobt haben.");
  AddDetail( ({ "kaempfe" }),
    "Kaempfe, bei denen viel Blut geflossen ist.");
  AddDetail( ({ "unordnung" }),
    "Egal, wo Du auch hinschaust, ueberall herrscht grosse "
    "Unordnung in dieser Halle.");
  AddDetail( ({ "gefecht" }),
    "Die Ueberreste dieses Gefechtes siehst Du hier vor Dir im Raum verstreut.");
  AddDetail( ({ "norden" }),
    "Noerdlich von Dir befindet sich eine Tuer.");
  AddDetail( ({ "zedernholz" }),
    "Die Tuer besteht aus festem roetlichen Zedernholz.");
  AddDetail( ({ "pfeile" }),
    "Einige gefiederte Pfeile stecken in der Tuer.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Tuer befindet sich ein kleiner Tuergriff.");
  AddDetail( ({ "tuergriff", "griff" }),
    "Der Tuergriff ist aus dem gleichen Holz geschnitzt wie die Tuer selbst.");
  AddDetail( ({ "holz" }),
    "Roetliches Zedernholz.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich weit ueber Dir. Sie besteht ebenfalls aus rotem "
    "Sandstein.");
  AddDetail( ({ "tor" }),
    "Ein grosses Tor befindet sich suedlich von Dir. Einer der beiden "
    "Torfluegel ist geschlossen, der andere einen kleinen Spalt "
    "geoeffnet.");
  AddDetail( ({ "torfluegel" }),
    "Das Tor hat zwei grosse Torfluegel, von denen der eine einen "
    "kleinen Spalt weit geoeffnet ist.");
  AddDetail( ({ "spalt" }),
    "Durch den Spalt bist Du hier hereingekommen und kannst vermutlich "
    "auch wieder hinausgehen.");
  AddDetail( ({ "sueden" }),
    "Suedlich von Dir ragt ein grosses Tor empor.");

  AddSound( DEFAULT_SOUND,
    "Irgendwo weit ueber Dir hoerst Du lautes Getrampel und Gebruell.");

  AddSound( ({ "getrampel" }),
    "Es hoert sich so an, als ob gleich die Decke einstuerzen wuerde.");
  AddSound( ({ "gebruell" }),
    "Du moechtest lieber gar nicht so genau wissen, wer oder was diese "
    "unmenschlichen Geraeusche von sich gibt.");
  AddSound( ({ "decke" }),
    "Das Getrampel kommt von oben.");
  AddSound( ({ "geraeusche" }),
    "Lautes Gebruell dringt an Dein Ohr.");
  AddSound( ({ "ohr" }),
    "Du lauschst veraengstigt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blut und Verwesung.");

  AddSmell( ({ "blut" }),
    "Ein suesslicher Geruch nach altem Blut durchzieht die Halle.");
  AddSmell( ({ "verwesung" }),
    "Du traust Dich kaum zu atmen, so schlimm stinkt es hier.");
  AddSmell( ({ "geruch" }),
    "Es riecht widerlich.");
  AddSmell( ({ "halle" }),
    "In der ganzen Halle riecht es nach Blut und Verwesung.");

  AddExit( "raus", "nach Sueden#"+ RAUS );
  AddExit( "westen", "nach Westen#"+  W );
  AddExit( "osten", "nach Osten#"+ O );

  NewDoor("norden", N , ({"tuer", "holztuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer wirkt eigentlich viel zu klein fuer diese grosse Halle. "
              "Sie besteht aus roetlichem Zedernholz und einige Pfeile stecken in "
              "ihr. In der Mitte der Tuer befindet sich ein schmaler Tuergriff.",
      D_NAME,  "Holztuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_OPENMSG, ({"Du oeffnest die Holztuer.",
                   "%s oeffnet die Holztuer.",
                   " wird von der anderen Seite geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Holztuer.",
                   "%s schliesst die Holztuer.",
                   " wird von der anderen Seite geschlossen."}),
      D_RESET_CLOSEMSG,
                  " im Norden ist zugefallen! Der entstehende Windhauch hat die Fackel ausgeblasen.\n"
    })
  );
  
  AddCmd( "zuende|zuend&fackel&an", "cmdzuenden",
          "Was willst Du anzuenden?" );
  AddCmd( ({ "nimm", "nehme", "nehm" }), "cmdnehmen" );
}
// Die Tuer laesst sich nur von Innen oeffnen oder ueber Fackelanzuenden
int tueroeffnen()
{
  if (DOOR_MASTER->QueryDoorStatus(N)==D_STATUS_CLOSED && fackel == AN)
  {
    return 0;
  }
  else
  {
    write(BS("Vorsichtig ruettelst Du am Tuergriff, doch die Tuer laesst sich "
            +"nicht oeffnen."));
    return 1;
  }
}

// Anzuenden der Fackeln in den Halterungen.
int cmdzuenden(string str )
{
  object dest;
  call_other (N, "???", 0);
  dest = find_object(N);

  if(fackel == AUS)
  {
    if(this_player()->QueryProp(P_SP) < 5)
    {
      write(BS("Du verfuegst nicht ueber genuegend Magie."));
      return -1;
    }

    write(BS("Mit einem kleinen Feuerball zuendest Du die Fackel an."));
    say( PL->name()+" zuendet mit einem kleinen Feuerball die Fackel an.\n");

    this_player()->AddSp(-5);
    fackel = AN;
    if (DOOR_MASTER->QueryDoorStatus(N)==D_STATUS_CLOSED)
    {
      Message(BS("Die Tuer oeffnet sich mit einem leisen Knarren."), MSGFLAG_VISUAL);
      if(dest)
      {
        tell_room(dest, "Mit einem leisen Knarren oeffnet sich die Tuer.\n");
      }
      DOOR_MASTER->SetDoorStatus(N, D_STATUS_OPEN);
    }
    return 1;
  }
  else 
  {
    write("Aber die Fackeln brennen doch schon?\n");
    return -1;
  }
}

int cmdnehmen(string str)
{
  object myarrows;

  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  switch (str)
  {
  	case "pfeilschaefte":
  	case "schaefte":
  	case "pfeile":
      if(schaefte > 0)
      {
        myarrows=clone_object(OBJ "pfeile");

        if(ME_TOO_HEAVY==myarrows->move(TP,M_GET|M_SILENT))
        {
          write("Du kannst die Pfeilschaefte nicht mehr tragen.\n");
          myarrows->remove();
          return -1;
        }
        else
        {
          write(BS("Du hebst ein paar Pfeilschaefte auf, wer weiss wofuer Du die "
               +"nochmal gebrauchen kannst."));
          say(PL->name()+" hebt ein paar Pfeilschaefte auf.\n");
          schaefte--;
          return 1;
        }
      }
      write(BS("Es sind zuwenige Pfeilschaefte vorhanden um Dir von "
           +"Nutzen zu sein."));
      return -1;
    case "schild":
    case "schilder":
      write("Die Schilder sind zu zerbeult, um interessant fuer Dich zu sein.\n");
      return -1;
    case "schwert":
    case "schwerter":
      write("Mit zerbrochenen Schwertern kannst Du nichts anfangen.\n");
      return -1;
    default:
      return 0;
  }
}

string strfackel(string str)
{
  string s;
  if(fackel == AUS)
  {
    s = "Die rechte Fackel leuchtet, waehrend die linke vor kurzem erloschen "
        "zu sein scheint.";
  }
  else
  {
    s = "Die Fackeln brennen und werfen einen flackernden Lichtschein in "
       +"den Raum.";
  }
  return BS(s);
}

string strLicht(string str)
{
  string s;
  if(fackel == AUS)
  {
    s = "Die rechte Fackel leuchtet, waehrend die linke vor kurzem erloschen "
        "zu sein scheint.";
  }
  else
  {
    s = "Der flackernde Lichtschein stammt von den Fackeln.";
  }
  return BS(s);
}

reset()
{
  ::reset();

  schaefte = 3;
  fackel = AUS;
}