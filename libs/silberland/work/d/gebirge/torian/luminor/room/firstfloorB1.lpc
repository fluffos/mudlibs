  AddDetail( ({ "unterschied" }),
    "An den groesseren Calcitkristallen unterscheidet man Marmor von normalem "
    "Kalkgestein.");
  AddDetail( ({ "calcitkristall", "calcitkristalle" }),
    "Calcitkristalle sind groesser als normales Kalkgestein.");
  AddDetail( ({ "aussehen" }),
    "Calcitkristalle aehneln vergroesserten Zuckerkristallen.");
  AddDetail( ({ "zuckerkristalle" }),
    "Grosse weisse Zuckerkristalle.");
  AddDetail( ({ "kristalle" }),
    "Welche Kristalle meinst Du genau?");
  AddDetail( ({ "norden" }),
    "Im Norden fuellt ein grosses Gemaelde die Wand nahezu aus.");
  AddDetail( ({ "osten" }),
    "Im Osten gelangst Du wieder nach unten.");
  AddDetail( ({ "westen" }),
    "Im Westen gelangst Du weiter nach oben.");
  AddDetail( ({ "gang" }),
    "Der Gang fuehrt im Osten und Westen zu zwei Treppen.");
  AddDetail( ({ "treppen" }),
    "Die Treppen befinden sich im Osten und Westen.");
  AddDetail( ({ "sueden" }),
    "Im Sueden zweigt der Gang in einen groesseren Raum ab.");
  AddDetail( ({ "gang" }),
    "Im Osten und Westen fuehrt der Gang weiter zu zwei Treppen.");
  AddDetail( ({ "raum" }),
    "Der Raum im Sueden scheint groesser zu sein.");
  AddReadDetail( ({ "schriftzug" }),
    "Ganz klein kannst Du lesen \"Die Schatten sind nicht immer das was sie scheinen!\"\n"
    "Merkwuerdig, wer diesen Schriftzug wohl hinterlassen hat?");

  AddSound( DEFAULT_SOUND,
    "Lautes Gebruell und Getrampel herrscht um Dich herum.");

  AddSound( ({ "gebruell", "getrampel" }),
    "Die Oni sind offensichtlich die Quelle des Gebruells und des Getrampels.");
  AddSound( ({ "quelle", "oni" }),
    "Du wirst fast taub.");
  AddSound( ({ "taub" }), #'strtaub);

  AddSmell( DEFAULT_SMELL,
    "Buah, die Oni stinken.");

  AddSmell( ({ "oni" }),
    "Dir wird schlecht.");

  AddExit( "westen", W );
  AddExit( "osten", O );
  AddExit( "sueden", S );

  AddItem( NPC "oni", REFRESH_DESTRUCT);
  AddItem( NPC "oni", REFRESH_DESTRUCT);

}

string getname(object obj)
{
  if(!obj)
    return "";
  
  return obj->name(WEN);
}

int filter_lebewesen(object ob)
{
  return interactive(ob) && (query_once_interactive(ob)
     && !find_netdead(getuid(ob)) || QueryProp(P_FRIEND));
}

string strgemaelde(string key)
{
  string s, s2;
  string *names;
  object *inhalt; 
  
  s = "Du erkennst auf dem Gemaelde ";
  s2 = "Dich, doch irgendetwas stimmt mit Deinen Gesichtszuegen nicht.";

  inhalt = all_inventory(TO) - ({TP}); // Wer befindet sich alles im Raum, 
                                       // ausser this_player
                                       
  inhalt = filter_array(inhalt, "filter_lebewesen");
  
  names = map_array(inhalt, #'getname ); // array von objecten in array von 
                                         // (string) namen umwandeln

  switch(sizeof(inhalt))
  {
    case 0:
      s += s2;
      break;
    case 1:
      s += (names[0])+ " und "+s2;
      break;
    default:
      s += implode(names[0..<2], ", ") + " und " + names[<1]+ ". "
           +"Ausserdem erkennst Du "+s2;
      break; // eigentlich ueberfluessig
   }
   
  return BS(s);
}

string strnordwand(string key)
{
  string s;
  s = "Du betrachtest den Jemand genauer. Irgendwie kommen Dir "
      +(PL->QueryProp(P_GENDER) == MALE ? "seine" : "ihre")+ " Gesichtszuege "
     +"sehr vertraut vor.";
  return BS(s);
}

string strtaub(string key)
{
  if(taub)
  {
    TP->SetProp(P_DEAF,1); 
    return BS("Du hoerst irgendwie ... nichts mehr!");
    taub = 0;
  }
  return BS("Puh, Du hoerst doch noch etwas.");
}

reset()
{
  taub = 1;

  ::reset();
}