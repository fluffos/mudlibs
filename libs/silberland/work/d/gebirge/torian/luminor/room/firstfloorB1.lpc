  AddDetail( ({ "jahrtausende" }),
    "Schon seit Jahrtausenden wird Marmor abgebaut und als Baustein verwendet.");
  AddDetail( ({ "baustein" }),
    "Marmor ist leicht zu bearbeiten und zu polieren, weil er als "
