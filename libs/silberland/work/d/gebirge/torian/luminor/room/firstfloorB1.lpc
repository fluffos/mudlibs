  AddDetail( ({ "schriftzug" }),
    "Wie waere es mit lesen?");
  AddDetail( ({ "politur" }),
    "Erst nach einer gruendlichen Politur treten die Schattierungen im Marmor zutage.");
  AddDetail( ({ "kalkstein", "gestein", "kalkgestein" }),
    "Im Unterschied zu normalem Kalkstein ist der Marmor an groesseren "
