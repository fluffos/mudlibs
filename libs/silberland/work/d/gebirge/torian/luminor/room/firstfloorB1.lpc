  AddDetail( ({ "augenringe" }),
    "Du tastest Dein Gesicht ab. Keine Augenringe da ...");
  AddDetail( ({ "wangen" }),
    "Die Wangenknochen stechen hart hervor.");
  AddDetail( ({ "wangenknochen" }),
    "Was ist das nur fuer ein Spiegelbild???");
  AddDetail( ({ "augen" }),
    "Die Augen blicken gehetzt hin und her, als wenn sie vor etwas grosse Angst haetten. "
