#include "../def.h"
#include <verben.h>

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Wald");
  SetProp(P_INT_LONG, "Der Weg verschwindet vor Deinen Augen. Lediglich im Norden "
   "kannst Du erkennen, dass er weiterfuehrt. Ein umgestuerzter Baum beherrscht "
   "Dein Blickfeld. Die wenigen Sonnenstrahlen, die durch die Baumkronen scheinen, "
   "tauchen den Wald in ein surreales Licht.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "weg" }),
    "Der Weg ist hier so ueberwuchert, dass Du nicht erkennen kannst, wohin er "
    "fuehrt. Lediglich im Norden ist der Weg noch zu erahnen."
  );
  AddDetail( ({ "augen" }),
    "Augen kurz zugemacht und schwups, weg war der Weg."
  );
  AddDetail( ({ "norden" }),
    "Im Norden ist der Weg noch zu erahnen."
  );
  AddDetail( ({ "baum", "baumstamm" }),
    "Der umgestuerzte Baumstamm beherrscht Dein Blickfeld. Er ist vollkommen mit Moos "
    "bewachsen. Neben dem ausgefransten Baumstumpf waechst bereits der naechste "
    "Baum nach."
  );
  AddDetail( ({ "blickfeld" }),
    "Deinem beschraenkten Blickfeld entgeht vieles. Sogar die Buesche mit den Dornen."
  );
  AddDetail( ({ "buesche" }),
    "Du kannst nicht genau ausmachen, welche Buesche das sind. Dornen scheinen "
    "sie jedenfalls nicht zu haben. Im Westen scheinen die Buesche nicht ganz so "
    "dicht zu stehen."
  );
  AddDetail( ({ "westen" }),
    "Ob dort der Weg weiterfuehrt?"
  );
  AddDetail( ({ "dornen" }),
    "Erkennen kannst Du keine. Du muesstest schon die Dornen suchen."
  );
  AddDetail( ({ "moos", "moose" }),
    "Das blaugruen schimmernde Moos ist fest mit dem Baum verwachsen. Es muss "
    "schon laengere Zeit so daliegen."
  );
  AddDetail( ({ "baumstumpf" }),
    "Neben dem zersplitterten Baumstumpf waechst bereits ein neuer Baum, die Luecke "
    "fuellend, nach."
  );
  AddDetail( ({ "luecke", "sturz" }),
    "Der Sturz des Baumes hat eine Luecke fuer neue Baeume geschaffen."
  );
  AddDetail( ({ "baeume" }),
    "Maechtige Baeume bilden den Wald hier."
  );
  AddDetail( ({ "zeit" }),
    "Der Baum ist schon vor langer Zeit umgestuerzt, dafuer bietet er jetzt Raum "
    "fuer neues Leben."
  );
  AddDetail( ({ "raum" }),
    "Der Baum bietet Raum fuer neues Leben. Zum Beispiel fuer Moose, Pilze, "
    "Kaefer und sonstige Tiere."
  );
  AddDetail( ({ "beispiel", "beispiele" }),
    "Nur ein paar Beispiele."
  );
  AddDetail( ({ "leben" }),
    "Der Wald ist voll von Leben."
  );
  AddDetail( ({ "pilze", "pilz" }),
    "Sehen kannst Du keine."
  );
  AddDetail( ({ "kaefer" }),
    "Zwischen dem Moos kannst Du tatsaechlich einen kleinen Kaefer erkennen. Als "
    "Du nach ihm greifen, willst verschwindet er jedoch."
  );
  AddDetail( ({ "tiere" }),
    "In einem Wald leben eine Menge Tiere."
  );
  AddDetail( ({ "menge" }),
    "Es koennte Dir schwer fallen, sie zu zaehlen."
  );
  AddDetail( ({ "sonnenstrahlen", "strahlen" }),
    "Die wenigen Sonnenstrahlen tauchen den Wald in ein surreales Licht."
  );
  AddDetail( ({ "himmel", "sicht" }),
    "Durch die dichten Baumkronen ist der Himmel nicht zu erkennen."
  );
  AddDetail( ({ "baumkronen", "kronen", "blaetterwerk" }),
    "Das Blaetterwerk ueber Deinem Kopf versperrt die Sicht auf den Himmel. "
    "Lediglich ein paar Sonnenstrahlen koennen das Blaetterwerk durchdringen."
  );
  AddDetail( ({ "kopf" }),
    "Pass auf, dass Du ihn nicht verlierst."
  );
  AddDetail( ({ "wald" }),
    "Du siehst den Wald trotz der vielen Baeume."
  );
  AddDetail( ({ "licht", "bild" }),
    "Wenn Du Maler waerst, wuerdest Du dieses traumhafte Bild sofort festhalten wollen."
  );
  AddDetail( ({ "maler" }),
    "Tja, Pech gehabt, Du bist keiner."
  );
  AddDetail( ({ "pech" }),
    "Oder eher Glueck gehabt?"
  );
  AddDetail( ({ "glueck" }),
    "Das kannst nur Du entscheiden."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist vollkommen ueberwuchert. Nur an einigen Stellen kann man noch "
    "den felsigen Untergrund ausmachen."
  );
  AddDetail( ({ "stellen", "blick" }),
    "Nur wenige Stellen erlauben einen freien Blick auf den Untergrund."
  );
  AddDetail( ({ "untergrund" }),
    "Trotz des felsigen Untergrunds gedeihen die Pflanzen praechtig."
  );
  AddDetail( ({ "pflanzen" }),
    "Der Weg ist kaum auszumachen unter den Pflanzen."
  );
  AddDetail( ({ "himmel", "sicht" }),
    "Durch die dichten Baumkronen ist der Himmel nicht zu erkennen."
  );
  AddDetail( ({ "hoehleneingang", "hoehle", "eingang" }),
    "Du kannst von hier aus nicht sagen, was sich in der Hoehle befindet."
  );

  AddSound( DEFAULT_SOUND,
    "Ausser dem Rauschen des Windes kannst Du leise etwas neues vernehmen. "
    "Ausserdem ist Vogelgezwitscher zu hoeren."
  );

  AddSound( ({ "rauschen", "wind", "unterton" }),
    "Das Rauschen des Windes hat einen beunruhigenden, fast aggressiven "
    "Unterton erlangt."
  );

  AddSound( ({ "etwas", "neues" }),
    "Es wird fast komplett vom Rauschen des Windes uebertoent, aber Du "
    "glaubst so etwas wie Gesang zu hoeren.");
  AddSound( ({ "gesang" }),
    "Ganz leise hoerst Du, wie jemand oder etwas 'Gold, Gold, Gold ...' singt.");
  AddSound( ({ "vogelgezwitscher", "gezwitscher", "ohr" }),
    "Das Vogelgezwitscher dringt an Dein Ohr.");

  AddSmell( DEFAULT_SMELL,
    "Tief saugst Du die frische Waldluft ein."
  );
  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft hier riecht frisch und rein."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_BETRETEN, "cmd_betreten" );
  AddCmd( CMD_KLETTERN, "cmd_klettern" );
  AddCmd( ({ "suche", "such" }), "cmd_suchen" );
  AddCmd( ({ "zaehle", "zaehl" }), "cmd_zaehlen" );
  AddCmd( ({ "reisse", "reiss", "pfluecke", "pflueck"}), "cmd_reissen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./wald1" );
  AddExit( "westen", "nach Westen#" + "./wald3" );
  SetProp(P_HIDE_EXITS, ({ "westen" }));
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_betreten(string str)
{
  object ob;
  notify_fail("Was willst Du betreten?\n");

  if(!str || str == "") return 0;

  if(!(str == "hoehle" ||
       str == "hoehleneingang" ||
       str == "eingang" )) return 0;

  call_other (ROOM "hoehle", "???", 0);
  ob = find_object(ROOM "hoehle");
  if(ob)
  {
    write(BS("Vorsichtig betrittst Du die Hoehle."));
    Message(BS(TP->Name()+" betritt vorsichtig die Hoehle."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    TP->move(ob, M_NO_SHOW|M_NOCHECK);
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
  }
  return 1;

}

int cmd_klettern(string str)
{
  object ob;
  notify_fail("Auf was willst Du klettern?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf baumstamm" ||
       str == "auf stamm"     )) return 0;

  if(TP->QueryAttribute(A_DEX) >= 15 + random(15))
  {
    write(BS("Du kletterst auf den Baumstamm, was fuer eine ... miese ... Aussicht. "
            +"Enttaeuscht kletterst Du wieder runter."));
    Message(BS(TP->Name()+" klettert auf den Baumstamm, nur um sofort wieder "
               +"runterzusteigen."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  else
  {
    write(BS("Du versuchst auf den Baumstamm zu klettern. Stellst Dich dabei "
            +"aber so ungeschickt an das Du runterrutschst und auf den Boden "
            +"knallst."));
    Message(BS(TP->Name()+" versucht auf den Baumstamm zu klettern und rutscht dabei "
            +"ab. Du lachst herzhaft."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    TP->do_damage(10+random(20), TO);
    return -1;
  }

}

int cmd_suchen(string str)
{
  notify_fail("Was willst Du suchen?\n");

  if(!str || str == "") return 0;

  if(str == "dornen" )
  {
    write(BS("Gruendlich durchsuchst Du einige der Buesche. Sie besitzen tatsaechlich "
         +"keine Dornen. Aber was ist das? Hinter einem der Buesche kannst Du einen "
         +"Hoehleneingang erkennen."));
    TO->Message(TP->Name(WER, 1)+" durchsucht einige der Buesche.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  
  if(str == "pilze" || str == "pilz")
  {
    write(BS("Du suchst alles nach Pilzen ab. Findest aber keine."));
    TO->Message(TP->Name(WER, 1)+" kriecht auf dem Boden herum.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  return 0;

}

int cmd_zaehlen(string str)
{
  notify_fail("Was willst Du zaehlen?\n");

  if(!str || str == "") return 0;

  if(str == "tiere" )
  {
    write(BS("Eins, Zwei, Drei, Vier, Sechs ... "
            +"verdammt, verzaehlt!"));
    TO->Message(TP->Name(WER, 1)+" starrt in der Gegend herum.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  
  return 0;

}

int cmd_reissen(string str)
{
  notify_fail("Was willst Du ausreissen oder pfluecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "moos aus" || 
       str == "moos"     )) return 0;

  write(BS("Du zerrst und ziehst an dem Moos. Schaffst es aber nicht, es vom Baumstamm "
          +"zu loesen."));
  TO->Message(TP->Name(WER, 1)+" zerrt am Moos herum.\n",
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;

}