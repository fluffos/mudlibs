  AddDetail( ({ "schild" }),
    "Der Schild zeigt ein rotes Wappen mit einem Sonnensymbol.");
  AddDetail( ({ "wappen" }),
    "Auf dem Wappen ist ein Sonnensymbol abgebildet.");
  AddDetail( ({ "sonnensymbol", "symbol" }),
    "Das Sonnensymbol besteht aus einem grossen Kreis mit wellenfoermigen "
