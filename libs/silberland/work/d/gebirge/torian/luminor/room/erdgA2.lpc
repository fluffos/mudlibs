  AddDetail( ({ "fingerglied", "bewegungsfreiheit" }),
    "Jedes Fingerglied kann sich voellig frei bewegen.");
  AddDetail( ({ "kniegelenke", "kniegelenken", "fussgelenke", "fussgelenken", "gelenke"}),
    "Die Knie- und Fussgelenke sorgen dafuer, dass die Gelenke trotz der "
    "Ruestung beweglich bleiben und gut geschuetzt sind.");
  AddDetail( ({ "treppe" }),
    "Die Treppe fuehrt nach unten.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich weit ueber Dir. Sie besteht aus rotem Sandstein.");
  AddDetail( ({ "waende" }),
    "An der Wand im Norden haengt ein Schild mit zwei gekreuzten "
    "Schwertern und an der Westwand steht eine grosse glaenzende "
    "Ritterruestung.");

  AddSound( DEFAULT_SOUND,
    "Weit ueber Dir hoerst Du lautes Getrampel und aus dem Sueden dringt "
    "ein qualvolles Stoehnen.");

  AddSound( ({ "getrampel" }),
    "Das Getrampel kommt von irgendwo weit ueber Dir.");
  AddSound( ({ "stoehnen" }),
    "Dir straeuben sich die Haare zu Berge.");
  AddSound( ({ "sueden" }),
    "Ein qualvolles Stoehnen kommt aus dem Sueden.");
  AddSound( ({ "haare" }),
    "Daran kannst Du nicht lauschen!");
  AddSound( ({ "berge" }),
    "Daran kannst Du auch nicht lauschen!");

  AddSmell( DEFAULT_SMELL,
    "Ein alles ueberlagernder Verwesungsgeruch durchdringt die Halle.");

  AddSmell( ({ "verwesungsgeruch", "geruch" }),
    "Der Geruch zieht von der Leiche herueber.");
  AddSmell( ({ "leiche", "toten" }),
    "Hab doch bitte etwas mehr Respekt vor den Toten!");
  AddSmell( ({ "respekt" }),
    "Daran kannst Du nicht riechen!");
  AddSmell( ({ "halle" }),
    "Die Halle wird von einem starken Verwesungsgeruch erfuellt.");
 
  AddExit( "osten", "nach Osten#" +  O );
  AddExit ("suedunten", ([ EX_DEST:     S,
                         EX_TESTFUNC: "exit_test",
                         EX_MSG: "die Treppe hinunter" ]) );
  AddExit ("sueden", ([ EX_DEST:     S,
                         EX_TESTFUNC: "exit_test",
                         EX_MSG: "die Treppe hinunter" ]) );
  SetProp(P_HIDE_EXITS, ({ "sueden" }));

  AddCmd( ({ "nimm", "nehme", "nehm" }), "cmdnehmen" );

}

int cmdnehmen(string str)
{
  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  switch (str)
  {
  	case "pfeile":
  	case "pfeil":
      write(BS("Mit den zerbrochenen Pfeilen kannst Du nichts anfangen."));
      return -1;
  	case "speer":
  	case "speere":
      write(BS("Du traust Dich nicht die Speere aus der Leiche zu ziehen."));
      return -1;
    case "schild":
      write("Der Schild an der Wand ist nur zur Zierde. Du laesst ihn wo er ist.\n");
      return -1;
    case "schwert":
    case "schwerter":
      write("Was willst Du mit Zierschwertern?\n");
      return -1;
    case "ruestung":
    case "ritterruestung":
      if(!present("ritterruestung"))
      {
        write("Du beruehrst die Ritterruestung als ploetzlich Leben in sie kommt?!?!\n");
        ruestung = WEG;
        AddItem( NPC "ritterruestung", REFRESH_NONE);
      }
      else
      {
        write(BS("Die lebende Ritterruestung kannst Du nicht nehmen!"));
      }
      return 1;
    default:
      return 0;
  }
}

string strruestung(string key)
{
  string s;
  s = "";
  if(ruestung == DA)
  {
    s = "Die Ritterruestung steht auf einem niedrigen Sockel. Sie besteht "
       +"aus einem glaenzenden Helm mit schmalen Sehschlitzen, einem "
       +"Harnischkragen und Brustharnisch, Rueckenpanzer, Arm- und "
       +"Beinschienen, Panzerhandschuhen sowie Knie- und Fussgelenken.";
  }
  else
  {
  	if(!present("ritterruestung"))
  	{
     s = "Die Ruestung bewegt sich auf Dich zu. Sie besteht "
       +"aus einem glaenzenden Helm mit schmalen Sehschlitzen, einem "
       +"Harnischkragen und Brustharnisch, Rueckenpanzer, Arm- und "
       +"Beinschienen, Panzerhandschuhen sowie Knie- und Fussgelenken.";
    }
    else
    {
      s = "Die Ritterruestung liegt vor dem Sockel verstreut. Sie bestand "
         +"aus einem glaenzenden Helm mit schmalen Sehschlitzen, einem "
         +"Harnischkragen und Brustharnisch, Rueckenpanzer, Arm- und "
         +"Beinschienen, Panzerhandschuhen sowie Knie- und Fussgelenken. Die "
         +"Ritterruestung wurde fein saeuberlich auseinander genommen.";
    }
  }
  return BS(s);
}

string strsockel(string key)
{
  if(ruestung == DA)
  {
    return BS("Die Ruestung steht auf einem niedrigen Sockel.");
  }
  else
  {
  	if(!present("ritterruestung"))
  	{
      return BS("Die Ruestung bewegt sich auf Dich zu.");
    }
    else
    {
      return BS("Die Ruestung liegt vor dem Sockel verstreut.");
    }
  }
}

string _query_int_long()
{
  string s, s2;
  
  s = "Du stehst am linken Ende der grossen Halle. Auch hier herrscht ein "
     +"voelliges Durcheinander und Du siehst ueberall Kampfesspuren. Im "
     +"Norden haengen ein Schild und zwei gekreuzten Schwertern an "
     +"der Wand und an der Westwand ";

  if (ruestung == DA)
  {
    s2 = "steht eine grosse glaenzende Ritterruestung. Suedlich von Dir "
        +"fuehrt eine breite Treppe nach unten.";
  }
  else
  {
  	s2 = "liegt eine auseinandergefallene Ritterruestung. Suedlich von Dir "
  	    +"fuehrt eine breite Treppe nach unten.";
  }
  
  return BS(s+s2);
}

//Falls Ritterruestung vorhanden, aktivieren und kaempfen lassen
int exit_test(string dir)
{

    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    if(IS_LEARNER(TP)) return 1;

    if(present("ritterruestung"))
    {
      write(BS("Die Ritterruestung haelt Dich auf!"));
      say(BS(TP->Name()+" wird von der Ritterruestung aufgehalten!"));
      return 0;
    }
    if(ruestung == DA)
    {
      write(BS("Ploetzlich kommt Bewegung in die Ritterruestung!"));
      AddItem( NPC "ritterruestung", REFRESH_NONE);
      ruestung = WEG;
      return 0;
    }
    return 1;
}

reset()
{
  ::reset();

  if(ruestung == WEG && !present("ritterruestung"))
  {
    tell_room(TO, BS("Erstaunt beobachtest Du wie sich die Ruestung "
                    +"wieder aufbaut."));  
    ruestung = DA;
  }

}