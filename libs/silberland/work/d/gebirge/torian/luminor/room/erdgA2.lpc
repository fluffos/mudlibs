  AddDetail( ({ "schwerter" }),
    "Zwei gekreuzte versilberte Zierschwerter sind ueber dem Schild befestigt.");
  AddDetail( ({ "zierschwerter" }),
    "Diese Schwerter haben stumpfe Klingen und dienen nur zur Zierde.");
  AddDetail( ({ "klingen" }),
    "Die Klingen der Schwerter sind abgestumpft, damit sich niemand daran "
    "verletzen kann.");
  AddDetail( ({ "zierde" }),
    "Die Schwerter dienen nur zur Zierde.");
  AddDetail( ({ "wand", "nordwand" }),
    "Ein grosser Schild mit zwei gekreuzten Schwertern darueber haengt "
