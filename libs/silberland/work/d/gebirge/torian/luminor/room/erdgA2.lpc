  AddDetail( ({ "blut" }),
    "Das Blut ist bereits getrocknet.");
  AddDetail( ({ "kampf" }),
    "Ein schrecklicher Kampf muss hier getobt haben.");
  AddDetail( ({ "norden" }),
    "An der Wand im Norden haengt ein grosser Schild mit zwei gekreuzten "
