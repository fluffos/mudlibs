    "Aussehen verleihen.");
  AddDetail( ({ "unterschied" }),
    "An den groesseren Calcitkristallen unterscheidet man Marmor von normalem "
    "Kalkgestein.");
  AddDetail( ({ "calcitkristall", "calcitkristalle" }),
    "Calcitkristalle sind groesser als normales Kalkgestein.");
  AddDetail( ({ "aussehen" }),
    "Calcitkristalle aehneln vergroesserten Zuckerkristallen.");
  AddDetail( ({ "zuckerkristalle" }),
    "Grosse weisse Zuckerkristalle.");
  AddDetail( ({ "kristalle" }),
    "Welche Kristalle meinst Du genau?");
  AddDetail( ({ "waende", "wand" }),
    "Ostwand, Suedwand ...");
  AddDetail( ({ "innenarchitekt" }),
    "Du bezweifelst stark, dass ein Architekt freiwillig rosaroten Marmor verwendet.");
  AddDetail( ({ "architekt" }),
