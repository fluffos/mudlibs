// Pendel schwingt oder schwingt nicht ...
string _query_int_long()
{
  string s;
  if(pendel == DA)
     s = "Im Norden, direkt vor der Treppe, schwingt ein grosses Pendel mit einer "
        +"langen scharfen Klinge hin und her. ";
  else
    s = "Im Norden, direkt vor der Treppe, haengt ein grosses Pendel mit einer "
        +"langen scharfen Klinge. ";

  s += "Unheimliche Geraeusche dringen vom oberen Stockwerk herab. An der "
      +"Sued- und Ostwand wurden Reliefe von Marmorgargylen in fein saeuberlicher "
      +"Handarbeit eingearbeitet.";

  return BS(s);
}

//Falls Gargylen nicht zerstoert ...
int exit_test(string dir)
{
    int schaden;

    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    if(IS_LEARNER(TP)) return 1;

    if(present("marmorgargyl"))
    {
      write(BS("Der Marmorgargyl laesst Dich nicht passieren!"));
      say(BS(TP->Name()+" wird von einem Marmorgargyl aufgehalten!"));
      return 0;
    }
    if(gargyl == DA)
    {
      write(BS("Die Marmorgargylen breiten ihre Schwingen aus und greifen Dich an!"));
      AddItem( NPC "marmorgargyl", REFRESH_NONE);
      AddItem( NPC "marmorgargyl", REFRESH_NONE);
      AddDetail( ({ "haufen", "steine" }),
        "Von den Gargylen ist nicht mehr viel uebrig, lediglich ein Haufen Steine.");

      RemoveDetail( "augen");

      gargyl = WEG;
      return 0;
    }
    
    if(pendel == DA)
    {
      if(random(2))
      {
      	write("\nDu schaffst es leider nicht an dem Pendel unbeschadet "
      	     +"vorbeizukommen!!!\n");
      	schaden = 50+random(50);
        TP->do_damage(schaden, this_object());
        LUMINORMASTER->Msg(TP->Name()+" loest das Pendel aus! Schaden: "+schaden);
      }
      else
      {
        write("\nDu schaffst es unbeschadet an dem Pendel vorbeizukommen!\n");
      }
    }
    return 1;
}

// Gargylen mit einer Waffe zerstoeren
int cmdzerstoere(string str)
{
  object waffe;
  string waffentyp, s;
  waffe = TP->QueryProp(P_WEAPON);
  
  if(present("marmorgargyl"))
  {
    write(BS("Die Gargylen weichen Dir geschickt aus."));
    return -1;
  }
  
  if (gargyl == WEG)
  {
  	write(BS("Die Gargylen liegen bereits zertruemmert vor Dir."));
  	return -1;
  }

  if(!waffe)
  {
  	write(BS("Ohne eine gezueckte Waffe wird das nichts!"));
    return -1;
  }
  
  waffentyp = waffe->QueryProp(P_WEAPON_TYPE);

  switch(waffentyp)
  {
  	case WT_AXE:
  	  s = "Du holst weit mit "+waffe->name(WEN)+" aus";
      break;
  	case WT_SWORD:
      s = "Du schwingst "+waffe->name(WEN);
      break;
  	case WT_CLUB:
      s = "Du holst mit "+waffe->name(WEN)+" aus";
      break;
  	case WT_CHAIN:
      s = "Schnell wirbelst Du "+waffe->name(WEN)+" ueber Deinen Kopf";
      break;
    default:
      write(BS("Deine Waffe ist dafuer nicht geeignet!"));
      return -1;
      break;
  }

  // Waffe wird dabei beschaedigt
  waffe->TakeFlaw(100);  
  
  write(BS(s+" und zerstoerst die Gargylenreliefs mit einem wuchtigen Schlag. "
            +"Leider wird Deine Waffe dabei beschaedigt."));
  say(BS(TP->Name()+" zerstoert die Gargylenreliefs."));
  gargyl = WEG;
  AddDetail( ({ "haufen", "steine" }),
    "Von den Gargylen ist nicht mehr viel uebrig, lediglich ein Haufen Steine.");

  RemoveDetail( "augen");
  return 1;

}


reset()
{
  ::reset();

  if(gargyl == WEG)
  {
    Message(BS("Die Marmorgargylen setzen sich wieder zusammen!"), MSGFLAG_VISUAL);
    AddDetail( ({ "augen" }),
      "Die Augen scheinen jede Deiner Bewegungen zu verfolgen.");
    RemoveDetail( ({ "haufen", "steine" }) );

    gargyl = DA;
  }
  if(pendel == WEG)
  {
    Message(BS("Das Pendel beginnt zu schwingen!"), MSGFLAG_VISUAL);
    pendel = DA;
  }
}

string strPendel(string key)
{
  if(pendel == DA)
  {
    return BS("Das Pendel schwingt mit seiner scharfen Klinge bedrohlich "
             +"hin und her.");
  }
  else
  {
    return BS("Das Pendel haengt harmlos vor der Treppe.");
  }
}

string strNorden(string key)
{
  if(pendel == DA)
  {
    return BS("Vor der Treppe schwingt ein grosses Pendel hin und her.");
  }
  else
  {
    return BS("Vor der Treppe haengt unbeweglich ein Pendel mit einer scharfen Klinge.");
  }
}

string strGargylen(string key)
{
  if(gargyl == DA)
  {
    return BS("Die Gargylen stehen aufrecht mit zusammengefalteten Fluegeln. "
             +"Fast scheint es so, als wenn ihre kalten Augen jede Deiner "
             +"Bewegungen verfolgen wuerden.");
  }
  else
  {
    return BS("Von den Gargylen ist nur ein kleiner Haufen Steine uebriggeblieben.");
  }
}

// Pendel ausschalten
int cmdziehen(string str )
{
  if(pendel == DA)
  {
    write(BS("Du ziehst an dem Hebel und das Pendel hoert auf zu schwingen."));
    TO->Message(BS(TP->Name()+" hantiert an der Wand herum und ploetzlich hoert das "
                  +"Pendel auf zu schwingen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);          
    pendel = WEG;
    LUMINORMASTER->Msg(TP->Name()+" entschaerft das Pendel!");
    return 1;
  }
  else
  {
    write(BS(""));
    TO->Message(BS(TP->Name()+" hantiert an der Wand herum."), 
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);          
    return -1;
  }
}