  AddDetail( ({ "meister" }),
    "Der Kuenstler muss ein wahrer Meister gewesen sein.");
  AddDetail( ({ "fach" }),
    "Steinbearbeitung.");
  AddDetail( ({ "steinbearbeitung" }),
    "Ob der Kuenstler ein Zwerg war?");
  AddDetail( ({ "zwerg" }),
    "Du weisst es nicht.");
  AddDetail( ({ "westwand" }),
    "Im Westen befindet sich keine Wand!");
  AddDetail( ({ "nordwand" }),
    "Im Norden fuehrt eine Treppe ins naechsthoehere Stockwerk.");
  AddDetail( ({ "stockwerk", "1. stockwerk", "erstes stockwerk" }),
    "Du befindest Dich zur Zeit im ersten Stockwerk.");
  AddDetail( ({ "zeit" }),
    "Jetzt.");
  AddDetail( ({ "zweites stockwerk", "2. stockwerk" }),
    "Das zweite Stockwerk befindet sich logischerweise ueber Dir.");
  AddDetail( ({ "drittes stockwerk", "3. stockwerk" }),
    "Im dritten Stockwerk wartet Luminor auf sein neuestes Opfer.");
  AddDetail( ({ "luminor" }),
    "Luminor wartet im dritten Stockwerk.");
  AddDetail( ({ "opfer", "du" }),
    "Du!");
  AddDetail( ({ "marmor" }),
    "Marmor ist seit Jahrtausenden ein beliebter Baustein. Marmor gibt es in "
