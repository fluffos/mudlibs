  AddSound( ({ "quelle", "oni", "onis" }),
    "Die Onis sind die Quelle.");
  AddSound( ({ "westen" }),
    "Im Westen befinden sich scheinbar etliche Onis.");

  AddSmell( DEFAULT_SMELL,
