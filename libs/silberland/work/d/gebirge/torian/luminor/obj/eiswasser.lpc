
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Phiole mit Eiswasser");
  SetProp( P_LONG,
   "Die Phiole ist mit einer blauen Fluessigkeit gefuellt. Du spuerst "
   "die magische Kaelte, die von ihr ausgeht.");

  SetProp( P_NAME, "Phiole");
  AddId( ({"phiole", EISWASSER, "eiswasser"}));
  SetProp( P_INFO, "Das magische Eiswasser ist nicht zum Trinken geeignet.");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 100);
  SetProp( P_VALUE, 500+random(1000));
  SetProp( P_NODROP, "Die Flasche ist viel zu wertvoll, die willst Du nicht weglegen!\n");
  SetProp( P_MATERIAL, ([MAT_GLASS:40, MAT_WATER:60]) );

  AddDetail( ({ "fluessigkeit" }),
    "Die Phiole ist mit einer blauen Fluessigkeit gefuellt.");
  AddDetail( ({ "kaelte" }),
    "Trotz der Kaelte ist die Fluessigkeit nicht gefroren.");

}