
inherit "std/thing";

#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein paar zerbrochene Pfeile");
  SetProp( P_LONG,
   "Ein paar zerbrochene Pfeile. Ob Du damit noch etwas anfangen kannst?");
  SetProp(P_NAME_ADJ, ({ "zerbrochen" }));
  SetProp(P_PLURAL, 1);
//  SetProp(P_ARTICLE, 0);

  SetProp( P_NAME, "Pfeile");
  AddId( ({"pfeile", PFEILE}));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 100);
  SetProp( P_VALUE, 100);
  SetProp( P_MATERIAL, ([MAT_MISC_METAL:10, MAT_MISC_WOOD:90]) );

}