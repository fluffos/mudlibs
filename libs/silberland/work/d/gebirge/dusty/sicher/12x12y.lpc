
inherit "/d/ebene/lamuerte/burg/mauer/mauerraum";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Im Gang.");
  SetProp(P_INT_LONG,break_string(
    "Du stehst inmitten der Burgmauer. Dieser Gang verbindet den Turm im "+
    "Nordosten mit dem Turm im Suedosten. Von hier aus ist es noch ein "+
    "weiter Marsch bis hin zum Turm im Nordosten. Der Suedoestliche liegt "+
    "noch in einiger Entfernung. Im Westen befindet sich ein Tor, welches "+
    "ins Innere der Stadt fuehrt.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));

  AddDetail(({"wassertropfen"}),break_string(
    "Du siehst momentan keinen.",78));

  AddDetail(({"mauer","burg","burgmauer"}),break_string(
    "Die Burgmauer bietet Schutz vor feindlichem Angriff. Ein Gang in dieser "+
    "Mauer ermoeglicht den gesicherten Stellungswechsel von einem Turm zum "+
    "naechsten.",78));

  AddDetail("tor",
    "Das Tor ist im Westen.");

  AddDetail(({"gang"}),break_string(
    "Der Gang fuehrt von Turm zu Turm.",78));
  AddDetail(({"weg"}),break_string(
    "Eigentlich ist es ja kein Weg sondern ein Gang.",78));
  AddDetail(({"turm"}),break_string(
    "Von hier aus ist kein Turm zu sehen.",78));
  AddDetail(({"stein","steine"}),break_string(
    "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert.",78));

  AddSmell(DEFAULT_SMELL,break_string("Die ist stickig hier drinnen.",78));
  AddSound(DEFAULT_SOUND,break_string("Eiserne Stille. Hin und wieder wird "+
    "sie durch Wassertropfen gestoert.",78));

  AddItem(NPC("soldat.lpc"), REFRESH_DESTRUCT);

  AddExit("norden",ROOM("11x12y.lpc"));
  AddExit("sueden",ROOM("13x12y.lpc"));  
  AddExit("westen",BURGWEG("12x11y.lpc"));
}
