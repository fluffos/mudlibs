
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,break_string(
    "Das Ende der Pferdegasse ist erreicht. Die Kreuzung im Sueden ist von "+
    "hier aus gut zu erkennen. Im Westen befindet sich der Eingang zu den "+
    "Stallungen, in denen die Pferde der Stadt untergebracht sind. Durch "+
    "ein Fenster in den Stallungen kann man ins Innere sehen.",78));

AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);

AddSound(DEFAULT_SOUND,break_string("Du hoerst ab und zu ein Pferd wiehern.",78));

SetProp(P_LIGHT,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25]));

AddDetail("ende",
 "Ende, end, fine, finito. Es ist aus!\n");

AddDetail("boden",
 "Es liegt Heu auf dem Boden herum.\n");;
 
AddDetail("heu",
 "Strohgelb. Irgendwie erinnert Dich das an eine Freundin.\n");
 

AddDetail(({"stadt"}),break_string(
  "Sieht eigentlich ganz nett aus.",78));

AddDetail(({"eingang"}),break_string(
  "Der Eingang im Westen fuehrt ins Innere der Stallungen.",78));

AddDetail(({"bauten"}),break_string(
  "Von hier aus ist noch nichts Auffaelliges zu sehen.",78));
  
AddDetail(({"knechte"}),break_string(
  "Die Knechte sind fuer die Pflege der Pferde zustaendig.",78));
  
AddDetail(({"kreuzung"}),break_string(
  "Die Kreuzung befindet sich weiter im Sueden.",78));

AddDetail(({"stallung","stallungen"}),break_string(
  "Du kannst Durch ein Fenster der Stallungen ein Pferd erkennen.",78));
  
AddDetail("fenster",
  "Es ist fast unglaublich, doch das Fenster ist aus echtem Glas!\n");
  
AddDetail("glas",
 "Sauber geputzt. Du siehst hindurch und entdeckst ein Pferd.\n");

AddDetail("pferd",
 "Das Pferd schaut Dich verabscheuend an.\n");
  
AddDetail(({"burgweg"}),break_string(
  "Der Burgweg befindet sich weiter im Sueden.",78));

AddDetail(({"hauptgasse"}),break_string(
  "Die Hauptgasse befindet sich in suedlicher Richtung.",78));

AddDetail(({"pferdegasse","gasse"}),break_string(
  "Die Pferdegasse endet hier, bei den Stallungen. ",78));

AddDetail(({"innere","inneres"}),
 "Du kannst Durch ein Fenster reinsehen.\n");
 
  AddExit("westen",ROOM("6x3y.lpc"));
  AddExit("sueden",ROOM("7x4y.lpc"));

}
