
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,break_string(
    "Du stehst inmitten einer Kreuzung auf der Marktgasse. Im Norden siehst "+
    "Du den Eingang in eine Huette. Ueber der Huette haengt ein Schild, "+
    "welches die Zunft der Bierbrauer zeigt. Im Osten verlaeuft die Gasse in "+
    "Richtung der Burgmauer. Eine kleine Holzplatte an einem Pfosten steht im "+
    "Mittelpunkt der Kreuzung.",78));

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);

  AddDetail(({"halterung","pfosten"}),"Der Pfosten dient als Halterung fuer "+
    "die Holzplatte.\n");
  AddDetail(({"platte","holzplatte"}),
    "Die Holzplatte dient wohl als Wegweiser.\n");

  AddReadDetail(({"platte","holzplatte","wegweiser"}),
"Brauerei\n"+
" <>\n"+
" <>\n"+
" <><><> Burgmauer\n"+
" <>\n"+
" <>\n"+
"Waffenhaendler\n\n");
 
  AddDetail(({"kreuzung"}),
    "Du stehst mitten drinn.\n");

  AddDetail(({"eingang","eingaenge"}),
    "Oeffnungen durch die man ein Haus betreten kann.\n");

  AddDetail(({"haus","haeuser","huette","blockhuette"}),break_string(
    "Die Blockhuette ist aus Holz gebaut. Sie gehoert wohl dem Wirt von "+
    "Kyranda.",78));

  AddDetail("wegweiser",
    "Was soll mit dem schon sein?");

  AddDetail(({"schild","schilder","eisenschilder"}),break_string(
    "Du kannst auf dem Schild im Norden die Zunft der Brauer ausmachen.",78));

  AddDetail(({"himmel"}),break_string(
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.",78));

  AddDetail(({"punkt"}),break_string(
    "Du suchst den wirklich westlichsten Punkt den Du finden kannst.",78));

  AddDetail(({"mauer","burgmauer"}),break_string(
    "Die Burgmauer ist weiter im Osten.",78));

  AddDetail(({"marktgasse","gasse"}),break_string(
    "Du stehst auf der Gasse. Vor Dir befindet sich eine Blockuette.",78));

  AddDetail("wirt",
    "Der Wirt ist in der Holzhuette.\n");

  AddDetail("holz",
    "Echtes Holz! Einmalig!\n");

  AddDetail("kyranda",
    "Schon gut, Du stehst ja inmitten der Stadt.\n");

  AddDetail("boden",
    "Ein stinknormaler, sehr gewoehnlicher Boden.\n");

  AddItem(NPC("betrunkener.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",BURG("shop/brauerei.lpc"));
  AddExit("sueden",ROOM("13x9y.lpc"));
  AddExit("osten",ROOM("12x10y.lpc"));

}
