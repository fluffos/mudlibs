inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"In den Stallungen");
 SetProp(P_INT_LONG,break_string(
  "Du stehst inmitten der Stallungen. Irgendwie riecht es hier komisch. "+
  "Die Pferde, welche hier untergebracht sind, stehen in einzelnen durch "+
  "Holzplatten abgetrennten Koppeln. Der Boden ist ueberall mit Stroh ausgelegt."+
  " Im Osten fuehrt ein Durchgang ins Freie." 
,78));
AddItem(NPC("knecht.lpc"),REFRESH_DESTRUCT);
AddSmell(DEFAULT_SMELL,break_string("Es stinkt furchtbar nach Pferd.",78));
AddSound(DEFAULT_SOUND,break_string("Ab und an wiehert hoerst Du ein Pferd wiehern.",78));
SetProp(P_LIGHT,1);
SetProp(P_INDOORS,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
AddSmell( ({"pferd","pferde"}),
 "Ihhhh... Das riecht aber wirklich pferdig.\n");
 


AddDetail(({"durchgang"}),break_string(
  "Eine Oeffnung in der Wand die ins Freie fuehrt."
,78));


AddDetail("oeffnung",
 "Ein einfacher Durchgang.\n");


AddDetail(({"stroh"}),break_string(
  "Du durchwuehlst das Stroh, findest aber nichts."
,78));


AddDetail(({"boden"}),break_string(
  "Man sieht den Boden vor lauter Stroh nichtmehr."
,78));



AddDetail(({"platten","holzplatten"}),break_string(
  "Die Holzplatten weisen nichts besonderes auf."
,78));



AddDetail(({"abteile", "koppel","koppeln"}),break_string(
  "Die Koppeln sind durch Holzplatten getrennte Abteile, welche Platz fuer ein "+
  "Pferd bieten."
,78));


AddDetail(({"pferd","pferde"}),break_string(
  "Du untersuchst die Pferde und stellst fest, dass sie alle "+
  "kerngesund sind."
,78));


AddDetail(({"stallung","stallungen"}),break_string(
  "Die Stallung ist fuer die Pferde der Buerger und der Durchreisenden "+
  "erbaut worden."
,78));

AddDetail("decke",
 "Die Decke weist keine Besonderheiten auf.\n");

AddDetail(({"wand","waende"}),
 "Die Waende sehen nett aus.\n");


AddCmd("reite","rfunc");
AddExit("osten",ROOM("6x4y.lpc"));

}

rfunc(str)
{string was;
 if (!str)
 {write("Auf was willst Du reiten?\n");
  return 1;
 }
 
 if (!sscanf(str,"auf %s",was))
  {write ("Hmmmm.. So nicht.\n");
   return 1;
  }

 if (was=="pferd")
  {call_out("ride",2);
   write ("Du versuchst auf das Pferd aufzusteigen.\n");
   return 1;
  }
  
  write("Darauf kann man nicht reiten.\n");
  return 1;
}

ride()
{int i;
 i=random(100);
 if(i<90)
  {write("Das Pferd wirft Dich gnadenlos ab.\n");
   return 1;
  }
  
  write("Jehaaaa! Du bezwingst das Pferd! \n Du bist der Held des Tages!\n");
  return 1;
 //HIER MAL STP
 }
 