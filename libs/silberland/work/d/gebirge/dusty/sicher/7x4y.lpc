inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Am Weg");
 SetProp(P_INT_LONG,break_string(
  "Hier kreuzen sich die Pferdegasse und die Hauptgasse. Im Norden kann "+
  "man den Eingang zu den Pferdestallungen erkennen. Im Sueden verlaengert "+
  "sich die Pferdegasse in Richtung Marktgasse. Im Osten beginnt die Hauptgasse,"+
  "welche zur Kirche Kyranda fuehrt. Ein kleiner Wegweiser steht am "+
  "Wegesrand."
  
,78));
AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));
SetProp(P_LIGHT,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

AddReadDetail("wegweiser",
 "+-------------------+\n"+
 "+ Stallungen        +\n"+
 "+ <>                +\n"+
 "+ <>                +\n"+
 "+ <><><> Hauptgasse +\n"+
 "+ <>                +\n"+
 "+ <>                +\n"+
 "+ Marktgasse        +\n"+
 "+-------------------+\n"
  );
 
 


AddDetail(({"pfosten","nagel","brett"}),break_string(
  "Ein Bestandteil des Wegweisers der am Wegesrand steht."
  ,78));

AddDetail(({"wegweiser"}),break_string(
  "Der Wegweiser ist aus einem Pfosten, einem Nagel und einem Brett gebaut."
  ,78));

AddDetail(({"wegesrand"}),break_string(
  "Am Wegesrand steht ein kleiner Wegweiser."
  ,78));


AddDetail(({"bauten"}),break_string(
  "Von hier aus ist noch nichts auffaelliges zu sehen."
  ,78));

AddDetail(({"stallungen"}),break_string(
  "Die Stallungen liegen weit im Norden."
  ,78));
  
AddDetail(({"knechte"}),break_string(
  "Die Knechte sind fuer die Pflege der Pferde zustaendig."
  ,78));

AddDetail(({"kreuzung"}),break_string(
  "Du stehst genau darauf."
  ,78));

AddDetail(({"pferde"}),break_string(
  "Es sind keine Pferde zu sehen."
  ,78));
  
AddDetail(({"burgweg"}),break_string(
  "Der Burgweg befindet sich weiter im Sueden."
  ,78));

AddDetail(({"hauptgasse"}),break_string(
  "Die Hauptgasse verlaengert sich in oestliche Richtung."
  ,78));
  
AddDetail("boden",
 "Als Du den Boden untersuchst, faellt dir ein grosser Haufen Pferdemist\n"+
 "auf. Ihh sieht der ekelerregend aus.\n");
 
AddDetail(({"mist","pferdemist"}),
 "Du bist zwar ein Naturbursch, aber das willst Du einfach nicht untersuchen.\n");

AddDetail(({"pferdegasse","gasse"}),break_string(
  "Die Gasse fuehrt gerade vom Norden in den Sueden. "
  ,78));


 
AddExit("sueden",ROOM("8x4y.lpc"));
AddExit("norden",ROOM("6x4y.lpc"));
AddExit("osten",ROOM("7x5y.lpc"));

}
