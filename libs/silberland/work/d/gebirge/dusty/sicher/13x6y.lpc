
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,break_string(
    "Der Burgweg fuehrt weiter in den Norden zu einer Kreuzung. "+
    "Das Teichufer schlaengelt sich vom Suewesten in Richtung Nordwesten und "+
    "endet in einer dichten Schilfwand. Weit im Sueden kannst Du noch "+
    "das Eingangstor der Burg erkennen.",78));

AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);
AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27]));

AddDetail(({"weg","burgweg","boden"}),break_string(
  "Der Burgweg fuehrt zu den wichtigsten Einrichtungen der Burg. Er ist " +
  "mit Kies ausgelegt. Am Rand sind einige Blumen zu sehen.",78));

  AddDetail(({"wasser","oberflaeche","wasseroberflaeche"}),
    "Du siehst Dir Dein Spiegelbild auf der Wasseroberflaeche an.\n");

  AddDetail(({"bild","spiegelbild"}),
    "Siehst Du heut wieder gut aus!\n");

  AddDetail(({"wand","schilfwand"}),
    "So viel Schilf auf einem Haufen hast Du ja noch nie gesehen!\n");

  AddDetail(({"kreuzung"}),break_string(
    "Die Kreuzung liegt weiter im Norden. Von hier aus ist nicht zu erkennen "+
    "wo sie hinfuehrt.",78));

  AddDetail(({"kies"}),break_string(
    "Der Kies erleichtert das Vorwaertskommen und Deine Schuhe werden auch "+
    "nicht so schmutzig wie in der Erde.\n",78));

  AddDetail(({"blumen"}),break_string(
    "Einige unwichtige Blumen. Nichts aufregendes. Sie verschoenern nur das "+
    " Gesamtbild des Weges.",78));

  AddDetail(({"teich","teichs","ufer","teichufer"}),break_string(
    "Das Ufer des Teichs endet hier im Schilf. Einige Seerosen treiben "+
    "auf der Wasseroeberflaeche herum.",78));

  AddDetail(({"rose","rosen","seerose","seerosen"}),break_string(
    "Grosse weisse Blumen, welche an der Wasseroberflaeche wachsen.",78));
 
  AddDetail("schilf",
    "Du kannst vor lauter Schilf den Teich kaum noch erkennen.\n");
 
  AddDetail(({"burg","mauer","burgmauer"}),break_string(
    "Eine wirklich riesige Mauer mit einem grossen Tor.",78));
 
  AddDetail(({"tor","burgtor"}),
    "Das Burgtor ist zwar von hier aus nicht genau zu erkennen,\n"+
    "aber es sieht dennoch auch von hier imposant aus.\n");

  AddDetail(({"himmel"}),break_string(
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "+
    "Hoffentlich faengt es nicht zu regnen an.",78));
 
  AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78)
 
  AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT); 

  AddExit("norden",ROOM("12x6y.lpc"));
  AddExit("sueden",ROOM("14x6y.lpc"));
}
