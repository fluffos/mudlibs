
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,break_string(
    "Die Pferdegasse muendet im Norden in eine Kreuzung, "+
    "welche auch von hier aus schon zu sehen ist. Auch hier sieht der Boden "+
    "ziemlich niedergetrampelt von den Pferden aus. Weit, weit im Sueden gelangst "+
    "Du von hier aus zum Burgweg. Weit im Norden kann man schon die Stallungen "+
    "von Kyranda ausmachen.",78));

AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);
AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

  AddDetail(({"boden"}),break_string(
    "Am Boden sind die Spuren von Pferden zu sehen.",78));

  AddDetail(({"stallungen"}),break_string(
    "Die Stallungen liegen weit im Norden.",78));
  
  AddDetail(({"knechte"}),break_string(
    "Die Knechte sind fuer die Pflege der Pferde zustaendig.",78));

  AddDetail(({"kreuzung"}),break_string(
    "Die Kreuzung ist ein Stueckchen weiter im Norden.",78));
  
  AddDetail(({"spur","spuren"}),
    "Die Spuren fuehren vom Sueden in den Norden.\n");

  AddDetail(({"pferde","pferd"}),break_string(
    "Es sind keine Pferde zu sehen.",78));
  
  AddDetail(({"burgweg"}),break_string(
    "Der Burgweg befindet sich weiter im Sueden.",78));

  AddDetail(({"hauptgasse"}),break_string(
    "Die Hauptgasse befindet sich weiter im Norden.",78));

  AddDetail(({"pferdegasse","gasse"}),break_string(
    "Die Gasse verbindet den Burgweg mit der Hauptgasse.",78));
 
  AddExit("sueden",ROOM("9x4y.lpc"));
  AddExit("norden",ROOM("7x4y.lpc"));

}
