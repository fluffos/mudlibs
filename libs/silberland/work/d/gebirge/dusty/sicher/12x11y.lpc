
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

int i;

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,break_string(
    "Die Marktgasse endet hier vor der Burgmauer. Weit im Westen ist "+
    "eine Kreuzung zu erkennen, direkt vor Dir im Osten ein Eingang in die "+
    "Burgmauer. Westlich von Dir steht ein kleines Holzhaeuschen, ueber dem "+
    "ein Schild haengt. Suedlich von Dir befindet sich eine Schmiede.",78));

i=0;

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);

  AddDetail(({"kraeuter"}),
    "Die einzigen Kraeuter die Du siehst, sind auf dem kleinen Schild aufgemalt.\n");

  AddDetail(({"kreuzung"}),
    "Die Kreuzung liegt weiter im Westen.\n");

  AddDetail(({"haeuschen","haus","haeuser","huette","blockhoette"}),break_string(
    "Von hier aus kann man nichts genaueres erkennen.",78)); 

  AddDetail(({"schild","schilder","eisenschilder"}),break_string(
    "Von hier aus kann man nicht genau erkennen, was auf dem Schild "+
    "abgebildet ist.",78));
  
  AddDetail(({"himmel"}),break_string(
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.",78));

  AddDetail(({"mauer","burgmauer"}),break_string(
    "Die Burgmauer ist direkt vor Dir. Ein Tor fuehrt ins Innere der Mauer.",78));

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse endet hier.\n");

  AddDetail("boden",
    "Er ist mit Kies bedeckt.\n");

  AddDetail(({"schmied","schmiede"}),
    "Die Schmiede ist allseits bekannt fuer ihre wertvollen Produkte.");
 
  AddDetail(({"produkt","produkte"}),
    "Oh GOTT! (Woody?!) Geh doch einfach mal rein in die Schmiede. =)");

  AddDetail("kies",
    "Du scharbst im Kies, findest aber nichts.\n");  

AddSpecialDetail(({"tuer","eingang","tor","tuere","eingangstor"}),"tfunc");

AddCmd("oeffne","aufunc");

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);

  AddExit("westen",ROOM("12x10y.lpc"));

//AddSpecialExit("sueden", "sueden_sperre");

  AddExit("sueden","/d/ebene/lamuerte/drachen/schmied.lpc");

  AddSpecialExit("osten","ofunc");
}

sueden_sperre()
{
  write("Haegar ist gerade in Urlaub, deshalb ist seine Schmiede geschlossen.\n");
  return 1;
}


tfunc()
 {if (i==0)
   {write("Die Tuer, welche den Eingang zur Burgmauer darstellt, "+
    "ist fest verschlossen.\nMal mit oeffnen versuchen?\n");
    return "";
   }

  if (i!=0)
   {write("Die Tuer zur Burgmauer steht offen.\n");
    return "";
   }
  write ("error in Door, contact WIZARD!!");
  return "";
  }
aufunc(str)
{object ob;


 if (!str)
 {notify_fail("So nicht!\n");
  return 0;
 }
 
 if (str=="tuer" || str == "tor" || str=="eingangstor")
  {if (!ob=present("\ntorkey",this_player()))
    {write ("Du brauchst den richtigen Schluessel um hier durchzukommen.\n");
     return 1;
    }
    
    write("Du steckst den Schuessel ins Schoss, sperrst auf und oeffnest\n"+
          "die Tuer. Durch magische Kraefte verschwindet der Schluessel.\n");
    say(this_player()->QueryProp(P_NAME)+" oeffnet eine Tuer.\n"); 
    ob->remove();
    i=1;
    return 1;
  }
 
  notify_fail("Was willst Du denn oeffnen?\n");
 return 0;
 }
ofunc()
 {if (i==0)
  {
   write("WUMMMS. Du rennst mit voller Wucht gegen das Eingangstor!\n");
   this_player()->reduce_hit_point(20);
   return 1;
   }

   this_player()->move(BURGMAUER("12x12y.lpc"),M_GO,"durch die Tuere");
   return 1;
 }


reset()
{::reset();
 i=0;
}  
