
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,break_string(
    "Geradeaus fuehrt der Weg in Richtung Norden. "+
    "Das Ufer eines Teichs erstreckt sich vom Suedwesten weiter in "+
    "den Nordwesten. Weiter im Sueden fuehrt der Weg aus der Burg. Ueber "+
    "der ganzen Burg ist der strahlend blaue Himmel zu sehen.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27]));

  AddDetail(({"weg","burgweg"}),break_string(
    "Der Burgweg fuehrt zu den wichtigsten Einrichtungen der Burg. Er ist " +
    "mit Kies ausgelegt. Am Rand sind einige Blumen zu sehen.",78));

  AddDetail("einrichtungen",
    "Geh doch weiter, vielleicht findest Du sie noch!\n");

  AddDetail("regen",
    "Sieht nicht so aus als obs heute noch zu regnen beginnen wuerde.\n");
  
  AddDetail(({"blau","himmelblau"}),
    "Ein wirklich ausserordentlich blaues Himmelblau.\n");

  AddDetail("boden",
    "Der Boden ist mit Kies bedeckt.\n");

  AddDetail(({"kies"}),break_string(
    "Der Kies erleichtert das Vorwaertskommen, Deine Schuhe werden auch "+
    "nicht so schmutzig wie in der Erde.\n",78));

  AddDetail("wasser",
    "Das Waser ist hier ziemlich nass.\n");

  AddDetail(({"blumen"}),break_string(
    "Einige unwichtige Blumen. Nichts aufregendes. Sie verschoenern nur das "+
    " Gesamtbild des Weges.",78));

  AddDetail(({"teich","teichs","ufer"}),break_string(
    "Das Ufer des Teichs ist mit Schilf bewachsen. Einige Seerosen treiben "+
    "auf der Wasseroberflaeche herum.",78));

  AddDetail(({"rose","rosen","seerose","seerosen"}),break_string(
    "Grosse weisse Blumen, welche an der Wasseroberflaeche wachsen.",78));
 
  AddDetail(({"schilf"}),break_string(
    "Das Schilf ist braun, hat einen langen Stiel und einen dunkelbraunen " +
    "Kopf.",78));
 
  AddDetail("stiel",
    "Der Stiel ist lang und braun.\n");

  AddDetail("kopf",
    "Der Kopf ist kurz und dunkelbraun.\n");
 
  AddDetail(({"burg","mauer","burgmauer","tor","eingangstor"}),break_string(
    "Du siehst Dir die Burgmauer an. Das Eingangstor sieht gewaltig aus.",78));

  AddDetail(({"himmel"}),break_string(
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "+
    "Hoffentlich faengt es nicht zu regnen an.",78));

  AddSound(DEFAULT_SOUND,break_string("Du hoerst einen Frosch quaken.",78));
  
  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);
 
AddExit("norden",ROOM("13x6y.lpc"));
AddExit("sueden",ROOM("15x6y.lpc"));
}
