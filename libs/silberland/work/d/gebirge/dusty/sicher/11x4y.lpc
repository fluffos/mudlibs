inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Am Weg");
 SetProp(P_INT_LONG,break_string(
  "Hier ist der Beginn der Pferdegasse, welche die Stallungen und die "+
  "Hauptgasse mit dem Burgweg und der Marktgasse verbindet.  Die Pferdegasse "+
  "fuehrt gerade vom Sueden in den Norden und endet dort vor den Stallungen "+
  "der Stadt."
,78));
AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);
AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);
AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));
SetProp(P_LIGHT,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

AddDetail("boden",
 "Der Boden weist keine Besonderheiten auf.\n");

AddDetail("hauptgasse",
 "Du kannst nichts besonderes daran finden.\n");
 
AddDetail("stadt",
 "Du stehst inmitten drinnen.\n");

AddDetail(({"pferdegasse","stallungen","gasse"}),break_string(
  "Die Pferdegasse fuehrt direkt zu den Stallungen, welche von hier aus "+
  "noch nicht zu sehen sind."
  ,78));


AddDetail(({"burgweg","weg","marktgasse"}),break_string(
  "Der Burgweg fuehrt zur Marktgasse, welche eher im suedoestlichen "+
  "Teil der Stadt liegt."
  ,78));

AddDetail(({"himmel"}),break_string(
  "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "+
  "Hoffentlich faengt es nicht zu regnen an."
  ,78));


 
AddExit("osten",ROOM("11x5y.lpc"));
AddExit("norden",ROOM("10x4y.lpc"));

}
