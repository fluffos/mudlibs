
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"In der Kirche");
  SetProp(P_INT_LONG,break_string(
    "Du stehst in der Kirche von Kyranda. Links und rechts von Dir "+
    "befinden sich unzaehlbare Reihen von Kirchenbaenken. Ein roter "+
    "Teppich fuehrt vom Eingang der Kirche vor bis zu den Stufen, ueber welche "+
    "man zum Altar gelangt. Die Decke ist mit Gemaelden uebersaeht.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
    
  AddSmell(DEFAULT_SMELL,break_string("Es riecht nach Kerzenwachs.",78));
  AddSound(DEFAULT_SOUND,break_string("Du hoerst die absolute Stille.",78));

  AddDetail(({"gemaelde"}),break_string(
    "Die Gemaelde zeigen die verschiedensten kirchlichen Abbilder.",78));
 
  AddDetail(({"decke"}),break_string(
    "Die Decke ist zeigt ein Kunstwerk neben dem Anderen.",78));
 
  AddDetail(({"altar"}),break_string(
    "Der Altar sieht sehr einfach aus. Er ist aus Stein gefertigt.",78));

  AddDetail(({"stein"}),break_string(
    "Die Stein fuehlt sich kalt an.",78));

  AddDetail(({"stufen"}),break_string(
    "Die Stufen sind aus Stein gefertigt.",78));

  AddDetail(({"eingang"}),break_string(
    "Der Eingang der Kirche befindet sich im Norden.",78));

  AddDetail(({"teppich"}),break_string(
    "Du untersuchst den Teppich, fuehlst aber nicht einmal seinen Puls. "+
    "Hoffentlich ueberlebt ers.",78));

  AddDetail(({"bank","baenke","kirchenbaenke"}),break_string(
    "Sie sind braun und sehen etwas ungemuetlich aus.",78));

  AddDetail(({"kirche"}),break_string(
    "Du stehst inmitten drinnen. Beeindruckend sind die bunt gesprenkelten "+
    "Fenster.",78));

  AddDetail("fenster",
    "Bunte Hintergrundmalereien. Sie zeigen den Leidensweg Christi.\n");
 
  AddDetail(({"malerei","hintergrundmalerei","hintergrundmalereien","malereien"}),
    "Das Sonnenlicht bricht sich bein durchdringen der Malereien in alle\n"+
    "Spektralfarben.\n");
 
  AddDetail(({"sonnenlicht","licht"}),
    "Es ist hell.\n");
 
  AddDetail(({"farben","spektralfarben"}),
    "Naja, bunt, sehr bunt. Unvorstellbar bunt!\n");

  AddItem(NPC("bettler.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",ROOM("7x6y.lpc"));
}
