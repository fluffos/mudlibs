
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,break_string(
    "Der Burgweg macht hier eine Biegung und stellt weiter im Westen die "+
    "Verbindung zur Pferdegasse dar. Weit im Sueden erkennt man von hier "+
    "aus den grossen Torbogen in der Stadtmauer, welcher aus der Stadt "+
    "fuehrt.",78));
 
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));
  
  AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));

  AddDetail(({"bogen","torbogen"}),break_string(
    "Der Torbogen stellt den Ausgang aus der Stadt dar.",78));
 
  AddDetail("einwohner",
    "Hmm.. Keiner da? Oder doch!\n"); 
 
  AddDetail(({"mauer","stadtmauer"}),break_string(
    "Die Mauer ist aus schwerem Gestein gebaut, um Eindringlinge "+
    "fernzuhalten.",78));

  AddDetail(({"biegung"}),break_string(
    "Die Biegung hat hat einen Neigungswinkel von etwar 90 Grad.",78));

  AddDetail(({"pferdegasse","gasse"}),break_string(
    "Die Pferdegasse hat ihren Beginn weiter im Westen.",78));

  AddDetail(({"kies","kiesweg","weg","burgweg","boden"}),break_string(
    "Der Kiesweg ist ziemlich ausgetreten. Offenbar wird er von vielen "+
    "Einwohnern benutzt.",78));

  AddDetail(({"himmel"}),break_string(
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "+
    "Hoffentlich faengt es nicht zu regnen an.",78));


AddExit("westen",ROOM("11x5y.lpc"));
AddExit("sueden",ROOM("12x6y.lpc"));

}
