
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,break_string(
    "Die Marktgasse verlaeuft hier vom Sueden in den Norden, wo sie in einer "+
    "Kreuzung muendet. Du kannst im Norden der Kreuzung eine Blockhuette "+
    "erkennen, ueber deren Eingang ein eisernes Schild angebracht ist. "+
    "Weiter im Sueden kannst Du, zwar sehr unklar, aber immerhin doch, eine "+
    "Biegung in der Gasse ausmachen. Im Osten geht es in ein kleines Haus.",78));
  
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);

  AddDetail("biegung","Die Marktgasse fuehrt hier in Nordwest Richtung.\n");
  
  AddDetail(({"kreuzung"}),
    "Die Kreuzung befinder sich weiter im Norden.\n");

  AddDetail(({"eingang","eingaenge"}),
    "Oeffnungen durch die man ein Haus betreten kann.\n");

  AddDetail(({"haus","haeuser","huette","blockhoette","lokale","verkaufslokale"}),break_string(
    "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch "+
    "als Unterkunft fuer die Buerger.",78));
  
  AddDetail(({"handel","geschaefte","geschaeft"}),
    "Ueberall wird nur gehandelt.\n");

  AddDetail("boden",
    "Du siehst einen Stein, ueber den Du stolpern koenntest.\n");

  AddSpecialDetail("stein","sfunc");  

  AddDetail("buerger",
    "Da muss doch ein Buerger sein, Du bist Dir sicher! Oder doch nicht?!\n"); 
  
  AddDetail(({"schild","schilder","eisenschilder"}),break_string(
    "Du kannst auf dem Schild im Norden die Zunft der Brauer ausmachen.",78));
  
  AddDetail(({"himmel"}),break_string(
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.",78));
  
  AddDetail(({"punkt"}),break_string(
    "Du suchst den wirklich westlichsten Punkt den Du finden kannst.",78));

  AddDetail(({"mauer","burgmauer"}),break_string(
    "Die Burgmauer fuehrt wohl um ganz Kyranda.",78));

  AddDetail(({"marktgasse","gasse"}),break_string(
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "+
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.",78));

  AddDetail("haus", 
    "Hui, das ist verfallen. Was da wohl drinnen sein mag?");

  AddDetail("osten", 
    "Da steht ein alter Haus.");

  AddItem(NPC("reisender.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",ROOM("12x9y.lpc"));
  AddExit("sueden",ROOM("14x9y.lpc"));
  AddExit("osten", "/gilden/zechpreller");

}


sfunc()
{int i;
 i=random(100);
 if (i<60)
 {this_player()->reduce_hit_point(10+random(20));
  return"AUTSCH! Du stolperst ueber den Stein.\n";
 }
 
 return "Glueck gehabt, Du bist nicht ueber den Stein gestolpert.\n";
} 
