inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Am Weg");
 SetProp(P_INT_LONG,break_string(
  "Du stehst am westlichen Ende der Hauptgasse. Von hier aus kann man schon "+
  "die wundervolle Kirche der Stadt, welche weiter im Osten liegt, "+
  "erblicken. Im Westen befindet sich eine Kreuzung, an der die "+
  "Hauptgasse in die Pferdegasse muendet. "
  ,78));
AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);
AddSound(DEFAULT_SOUND,break_string("Du horchst herum, hoerst aber nichts.",78));
SetProp(P_LIGHT,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));
AddDetail(({"stadt"}),break_string(
  "Du siehst Dich um und stellst fest, dass Du wirklich in der Stadt stehst."
  ,78));

AddDetail ("boden",
 "Der Boden sieht sehr gepflegt aus.\n");
 
AddDetail("ende",
 "Ein jaemmerliches Ende!\n");
 

AddDetail(({"kirche"}),break_string(
  "Die Kirche war das erste Gebaeude, welches in Kyranda erbaut wurde. "+
  "Fuer ihr Alter sieht sie noch verhaeltnissmaessig gut aus."
  ,78));

AddDetail(({"stallungen"}),break_string(
  "Die Stallungen liegen weiter im Westen."
  ,78));
  

AddDetail(({"kreuzung"}),break_string(
  "Um die Kreuzung zu untersuchen, solltest Du weiter Westlich gehen."
  ,78));

  
AddDetail(({"hauptgasse"}),break_string(
  "Die Hauptgasse verlaengert sich in oestliche Richtung."
  ,78));
  

AddDetail(({"pferdegasse","gasse"}),break_string(
  "Die Pferdegasse liegt weiter im Westen."
  ,78));


 
AddExit("westen",ROOM("7x4y.lpc"));
AddExit("osten",ROOM("7x6y.lpc"));

}
