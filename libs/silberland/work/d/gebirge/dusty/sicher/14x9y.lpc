inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Marktgasse");
 SetProp(P_INT_LONG,break_string(
  "Die Marktgasse fuehrt sowohl im Norden als auch im Sueden weiter. "+
  "In einiger Entfernung kannst in noerdlicher Richtung Eisenschilder, welche "+
  "ueber den Eingaengen der Haeuser haengen, sehen. Weiter im Sueden erkennst "+
  "Du eine Biegung, die in den Westen fuehrt."
,78));
SetProp(P_INDOORS,0);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
SetProp(P_LIGHT,1);
AddDetail("boden",
"Du stehst auf der Marktgasse.\n");
AddDetail("biegung","Die Marktgasse fuehrt hier in Nordwest Richtung.\n");
AddDetail(({"eingang","eingaenge"}),
 "Oeffnungen durch die man ein Haus betreten kann.\n");
AddDetail(({"haus","haeuser","lokale","verkaufslokale","unterkunft"}),
break_string(
  "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch "+
  "als Unterkunft fuer die Buerger."
,78));
AddDetail(({"schild","schilder","eisenschilder"}),break_string(
  "Die Schilder zeigen jede einzelne Handelszunft."
,78));
AddDetail("handel"
 "Jaja, handelsfreudig sind sie schon, die Kyrander.\n");

AddDetail(({"kyrander","buerger"}),
 "Keiner da?! Oder doch!\n");

AddDetail("geschaefte",
 "Vielleicht koenntest ja Du auch Geschaefte machen. Verkauf doch was.\n");
 


AddDetail(({"himmel"}),break_string(
  "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag."
,78));
AddDetail(({"punkt"}),break_string(
  "Du suchst den wirklich westlichsten Punkt den Du finden kannst."
,78));
AddDetail(({"mauer","burgmauer"}),break_string(
  "Die Burgmauer fuehrt wohl um ganz Kyranda."
  ,78));
AddDetail(({"marktgasse","gasse"}),break_string(
  "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "+
  "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne."
,78));
AddDetail(({"huetten","huette","blockhuette","blockhuetten"}),
 "Sie sehen gemuetlich aus.\n");
 

AddExit("norden",ROOM("13x9y.lpc"));
AddExit("sueden",ROOM("15x9y.lpc"));
}
