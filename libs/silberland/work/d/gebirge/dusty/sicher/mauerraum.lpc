

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_INDOORS,1);
  AddSmell(DEFAULT_SMELL,break_string("Es ist stickig hier drinnen.",78));
  AddSound(DEFAULT_SOUND,break_string("Eiserne Stille. Hin und wieder wird "+
  	"sie durch Wassertropfen gestoert.",78));

  AddDetail(({"wassertropfen"}),break_string(
    "Du siehst momentan keinen.",78));
  AddDetail(({"mauer","burg","burgmauer"}),break_string(
    "Die Burgmauer bietet Schutz vor feindlichem Angriff. "+
    "Ein Gang in dieser Mauer ermoeglicht den gesicherten Stellungswechsel "+
    "von einem Turm zum naechsten.",78)); 
  AddDetail("schutz",
    "Komisch, Du siehst sowas hier nicht!?\n");
  AddDetail(({"feind","feinde","feindlich"}),
    "Keine Feinde zu sehen, oder doch?!\n");
  AddDetail("angriff",
    "Auf, auf zum froehlichen Toeten!\n");
  AddDetail(({"wechsel","stellung","stllungswechsel"}),
    "Naja, man kann von einem zum naechsten Turm wandern.\n");
  AddDetail(({"gang"}),break_string(
    "Der Gang fuehrt von Turm zu Turm.",78));
  AddDetail(({"weg"}),break_string(
    "Eigentlich ist es ja kein Weg sondern ein Gang.",78));
  AddDetail(({"turm"}),break_string(
    "Von hier aus ist kein Turm zu sehen.",78));
  AddDetail(({"stein","steine"}),break_string(
    "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert.",78));
  AddDetail("boden",
    "Er ist aus Steinen gebaut.\n");
  AddDetail(({"wand","waende"}),
    "Die Waende sind aus Stein gemauert.\n");

}
