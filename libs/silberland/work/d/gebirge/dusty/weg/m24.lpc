inherit "d/gebirge/dusty/weg/bergpfad";

#include "../zwerge/files.h"
#include <properties.h>

int cloned;

create()
{
::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 0);
 SetProp(P_INT_SHORT, "Am Bergweg");
 SetProp(P_INT_LONG, bs ("Der Berg verlaeuft direkt neben diesem kleinen "+
	"Pfad. Es ist alles ziemlich steinig hier, was ja auch einer "+
	"gewissen Logik nicht entbehren kann. Hier wachsen allerdings "+
	"kleine Pflaenzchen zwischen Gesteinsritzen heraus. Im Nordwesten "+
	"gaehnt Dich das grosse Loch, der Schlund, schwarz an, im Norden scheint eine "+
	"Art grosse Nische zu sein."));

  AddDetail( ({ "ritzen", "gesteinsritzen" }), 
                break_string( "Aus den Ritzen wachsen kleine Pflaenzchen "+
                "heraus!", 78 ) );
  AddDetail( ({ "stelle" }), 
                break_string( "Na die Stelle, an der Du stehst!", 78 ) );
  AddDetail( ({ "wunderschoen", "schoen" }), 
                break_string( "Ja, die Steinblumen sind wirklich "+
                "wunderschoen. Sowas gibts nirgends anders als an dieser "+
                "Stelle!", 78 ) );
  AddDetail( ({ "woerter", "wort" }), 
                break_string( "Na komm, so genau brauchst Du auch nicht "+
                "alles zu untersuchen! :-)", 78 ) );
  AddDetail( ({ "aufeinanderfolge", "folge" }), 
                break_string( "Hm, Woerter, die hintereinander stehen, "+
                "bilden eine Folge, in diesem Fall einen Satz.", 78 ) );
  AddDetail( ({ "satz" }), 
                break_string( "Ein Satz ist eine Aufeinanderfolge von "+
                "Woertern, die aus Buchstaben bestehen.", 78 ) );
  AddDetail( ({ "steinblume" }), 
                break_string( "Die Steinblume ist dunkelgrau, im Gegensatz "+
                "zu den anderen hellgrauen. Wunderschoen!!!", 78 ) );
  AddDetail( ({ "steinblumen" }), 
                break_string( "Die Steinblumen sind alle aus Stein, "+
                "logischerweise. Trotzdem sticht eine davon sehr schoen "+
                "hervor.", 78 ) );
  AddDetail( ({ "nische" }), 
                break_string( "Um die Nische genauer untersuchen zu koennen, "+
                "musst Du nach Norden gehen.", 78 ) );
  AddDetail( ({ "veilchen" }), 
                break_string( "Veilchen verwelken auch.", 78 ) );
  AddDetail( ({ "rosen", "tulpen", "nelken" }), 
                break_string( "All diese verwelken.", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Rosen, Tulpen und Nelken verwelken, "+
                "Steinblumen nicht.", 78 ) );
  AddDetail( ({ "pflaenzchen", "pflanzen" }), 
                break_string( "Es sind Steinblumen! Ganz klar! Welche andere "+
                "Art Blumen wuerde hier oben schon wachsen...", 78 ) );
  AddDetail( ({ "schlund", "loch" }), 
                break_string( "Der Schlund schaut bedrohlich "+
                "aus, tiefschwarz und unfreundlich gaehnt er Dich an.", 78 ) );
  AddDetail( ({ "boden", "pfad", "weg" }), 
                break_string( "Der Weg ist ziemlich steinig. Trotzdem "+
	"wachsen kleine Pflaenzchen zwischen Ritzen im Gestein heraus.", 78 ) );
  AddDetail(({"gestein", "steine"}),
		break_string("Zwischen den Steinen und dem Gestein wachsen aus Ritzen "+
	"kleine Pflaenzchen heraus.", 78) );
 
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");

	AddExit("nordwesten", WEG("l23"));
	AddExit("norden", ROOM("nische"));

}
