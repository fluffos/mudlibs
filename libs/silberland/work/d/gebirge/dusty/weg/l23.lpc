inherit "d/gebirge/dusty/weg/bergpfad";

#include "../zwerge/files.h"
#include <properties.h>

int cloned;

create()
{
::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 0);
 SetProp(P_INT_SHORT, "Vor dem Berg");
 SetProp(P_INT_LONG, bs ("Du stehst direkt vor dem Berg. Es fuehrt ein "+
	"kleiner Weg von hier nach Suedosten. Du erblickst einen kleinen "+
	"Wegweiser am Wegesrand. Ausserdem muendet ein schwarzer "+
	"Schlund in das Innere des Berges. Schaudernd stellst Du "+
	"Dir vor, auf welch grausame Art und Weise der Berg Dich vernichten "+
	"koennte. Du weisst, wenn Du es wagst, den Schlund zu betreten, setzt "+
	"Du Dein Leben aufs Spiel! "
	"Und doch ueberfaellt Dich die Sehnsucht, das Geheimnis dieses "+
	"Berges zu lueften...."));


  AddDetail( ({ "schlund" }), 
                break_string( "Der Schlund schaut wirklich bedrohlich "+
                "aus... so schwarz und unfreundlich... Du beginnst Dich zu "+
                "fragen, ob Du wirklich DORT hineinwillst.", 78 ) );
  AddDetail( ({ "boden", "pfad", "weg" }), 
                break_string( "Der Weg, der bis hierher aus Schotter "+
                "bestand, besteht nur noch aus kaltem, altem, grauem Gestein.", 78 ) );
  AddDetail(({"gestein", "steine"}),
		bs("Zwischen den verschieden geformten Steinen kannst du ein "+
      		"kleines Loch entdecken."));
 
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail("loch", bs("Du koenntest hineingreifen."));

  AddDetail ("wegweiser", "Lies ihn doch!\n");
  AddReadDetail ("wegweiser",
    "\n   ,---------------------------------------------------------------.\n"+
      "  /   Norden: Zwergenhoehle - Vorsicht, bevoelkert von Gesetzlosen! \\\n"+
      " /                                                                   \\\n"+
      "(Suedosten: Richtung Felonia, gehet mit Gott und achtet die Hoechsten )\n"+
      " \\                                                                   /\n"+
      "  \\         Nordwesten: Gebirgsweg, Midas (Hauptstadt)              /\n"+
      "   `---------------------------.    ,------------------------------'\n"+
      "                               |    |\n\n");



  AddExit("nordwestoben", WEG("k22"));
  AddExit("nordwesten", WEG("k22"));
  AddExit("norden", ROOM("eingang"));
  AddExit("suedosten", WEG("m24"));

  SetProp (P_HIDE_EXITS, ({"nordwesten"}) );

  AddCmd( ({"greife", "greif"}), "greif");
 
}

greif (str)                                                                     

{                                                                               
 notify_fail("Worein willst Du greifen?\n");                                    
                                                                                
 if (str != "loch" && str !="in loch")
        return 0;                                                               
                                                                                
  if (cloned) 
{                                                                 
      write("Nichts darin. So ein Pech, das waere sicher "+
	"ein schoenes Versteck fuer einen Zaubertrank gewesen.\n");               
                                                                               
	return 1;
}

	write("Du greifst in das Loch und findest eine Fackel.\n");

	clone_object("/obj/fackel")->move(TP);
	TK("Fackel vorm Berg gecloned!\n");
	cloned++;
	return 1;
}

reset()

{
  ::reset();
  cloned=0;
}

