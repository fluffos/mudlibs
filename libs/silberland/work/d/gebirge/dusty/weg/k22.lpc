inherit "/d/gebirge/dusty/weg/bergpfad";

#include <properties.h>
#include <moving.h>
#include "files.h"

create()
{
::create();


  SetProp(P_INT_LONG, BS(QueryProp(P_INT_LONG)+
    "Unter Dir krabbeln riesige Ameisen in einen grossen unterirdischen "
    "Ameisenbau hinein und aus ihm heraus." ));

  AddDetail( ({ "bau", "ameisenbau" }), 
    "Von hier aus sieht man nicht sehr viel davon. Du musst schon dort "
    "hinunterklettern.");
  AddDetail( ({ "ameise", "ameisen" }), 
    "Ueberdimensional grosse Ameisen krabbeln aus dem Bau und in ihn hinein.");

//  AddDetail( ({ "", "" }), 
//    "");


  AddItem ("/d/gebirge/eros/mon/wanderzwerg", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/dusty/weg/mon/ameise", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/dusty/weg/mon/ameise", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/dusty/weg/mon/ameise", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/dusty/weg/mon/ameise", REFRESH_DESTRUCT);

  AddExit("westen", WEG("j22"));
  AddExit("suedostunten", WEG("l23"));
  AddExit("suedosten", WEG("l23"));

  SetProp (P_HIDE_EXITS, ({"suedosten"}) );
//  AddExit("unten", "./bau/room/eingang");
  AddCmd( ({"kletter", "klettere"}), "klettern");
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  if( str=="hinunter" || str=="runter" || str=="in bau" || 
      str=="in ameisenbau")
  {
    if(this_player()->QueryProp(P_LEVEL)<10)
      return write("Du hast noch zuviel Angst vor diesen riesigen Ameisen!\n"),1;
    write("Du kletterst in den Ameisenbau hinunter.\n");
    this_player()->move(WEG("bau/room/eingang"),M_GO,"in den Ameisenbau");
    return 1;
  }
  return 0;
}
