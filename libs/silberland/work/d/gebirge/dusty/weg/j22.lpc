inherit "d/gebirge/dusty/weg/bergpfad";
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/d/gebirge/dusty/weg/files.h"

create() {
  ::create();

  SetProp( P_INT_LONG, BS(
    "Du gehst auf einem ziemlich ausgetrampelt wirkenden Gebirgspfad. "+
    "Schotter und Steine liegen am Weg. Der Berg, den Du erblickst, wirkt "+
    "irgendwie todbringend und unheimlich. Du musst allen Mut aufbringen, "+
    "um ueberhaupt noch voran zu kommen. Des weiteren faellt Dir im Norden eine "+
    "kleine Huette auf.") );

  AddReadDetail ("wegweiser",
    "\n   -------------\n"+
      "  | Zu Saruman |\n"
      "   -----| |-----\n"+
      "        | |\n\n");


  AddDetail( ({ "wegweiser", "weiser" }), 
                break_string( "Der Wegweiser zeigt nach Norden.", 78 ) );
  AddDetail( "huette",
    "Die Huette ist nicht sehr gross, wer da drinnen wohl wohnen mag? ");

  AddExit( "nordwestoben", WEG("i21") );
  AddExit("nordwesten", WEG("i21"));
  AddExit( "osten", WEG("k22") );
  AddExit( "norden", "/d/gebirge/speedy/laby/room/start" );

  SetProp (P_HIDE_EXITS, ({"nordwesten"}) );
}
