/*
**Ameise, fuer den Zwergenweg
** 21. 6. 1996 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "bmeise"}));
  create_default_npc(5);
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Ameise");
  SetProp (P_SHORT, "Eine mit den Augen funkelnde Ameise");
  SetProp (P_LONG, bs("Du siehst eine mit ihren Augen funkelnde Ameise. "+
	"Ihr Vorderteil ist schwarz, ihr Mittelteil rot, ihr Hinterteil weiss. "+
	"Sie krabbelt meistens auf Nahrungssuche herum."));

  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_LEVEL,3);
  SetProp (P_MAX_HP, 40);
  SetProp (P_MAX_SP, 40);
  SetProp (P_XP, 5000);
  SetProp (P_BODY, 30);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Mittelteil", 70, DT_ACID}) );
  SetProp (P_SIZE, 1);
  SetProp (P_RACE, "Insekt");
  set_living_name("ameise");

  SUID;

  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 1);
  ob->move(ME);

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Ameise klettert ueber Deinen kleinen Zeh.\n"}));

  AddSpell(1,50, 
    "Die Ameise beisst Dich in Deinen kleinen Zeh.\n",
    "Die Ameise beisst @WEN in den kleinen Zeh.\n");

  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf ameisisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Ameise laedt sich Deine Gabe auf den Ruecken."}));

  SetProp (P_MNPC_AREA, "/d/gebirge/dusty/weg");     
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));                  
  SetProp (P_MNPC_DEFAULTROOM, "/d/gebirge/dusty/weg/l23");             
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);           

  SetProp(P_MSGIN, "krabbelt herein");      
  SetProp(P_MSGOUT, "krabbelt hinaus");                
                                                           


}
