inherit "d/gebirge/dusty/weg/bergpfad";

#include "files.h"
#include <room.h>
#include <properties.h>

create()
{
::create();

  SetProp(P_INT_LONG, bs("Du gehst auf einem ziemlich ausgetrampelt wirkenden "
	"Gebirgspfad. Schotter und Steine liegen am Weg. Der Berg, den Du "
	"erblickst, wirkt irgendwie todbringend und unheimlich. Du musst "
	"allen Mut aufbringen um ueberhaupt noch voran zu kommen. Nach "
	"Nordosten spaltet sich der Weg, ein Wegweiser steht ratlos herum."));

  AddDetail( ({ "wegweiser" }), 
                break_string( "Er zeigt nach Suedosten.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");

  AddReadDetail ("wegweiser",
    "\n    ______________________\n"
      "   |                      \\ \n"
      "   |  Midas, Hauptstadt    )\n"
      "   |_________     ________/\n"
      "             |   |\n\n");




  AddExit("suedostunten", "/d/ebene/Silberwald/room/room_a01");
  AddExit("suedosten", "/d/ebene/Silberwald/room/room_a01");
  AddExit("westen", WEG("k27"));
  AddExit("nordosten", "/d/gebirge/thor/plateau/room/pfad1");

  SetProp (P_HIDE_EXITS, ({"suedosten"}) );
}
