inherit "std/thing";

#include <properties.h>
#include <language.h>

create()

{

  if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Dollar");
   SetProp(P_LONG, "Hmm, ob jemand Dir den wechseln kann.\n"
   +"Kaufen wirst Du damit wohl nichts koennen.\n");

   SetProp(P_NAME, "Dollar");
   AddId(({"schein", "scheine", "dollar", "dollars"}));
   SetProp(P_GENDER,MALE);
   SetProp(P_WEIGHT, 10);
   SetProp(P_SMELL, break_string("Der Dollar riecht nach einer Mischung "+
	"aus Geldgestank und vergammelter Erde.\n", 78));
   SetProp(P_INFO, "Er wird sicherlich nicht als Waehrung im Silberland akzeptiert.\n"); 
   SetProp(P_MATERIAL, MAT_PAPER);
}
