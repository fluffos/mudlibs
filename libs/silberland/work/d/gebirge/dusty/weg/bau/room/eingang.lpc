inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

int cloned;

create()
{
	::create();

	SetProp( P_INT_SHORT, "Im Ameisenbau");
	SetProp( P_INT_LONG, bs( "Ooohje! Wo bist Du denn hier gelandet? "+
	"Ueberall ist nur Erde, und die Inhabitanten dieses Ameisenbaus "+
	"starren Dich boese an. Es ist hier noch so hell, dass Du ohne "+
	"Fackel sehen kannst."+
	" Nur... was Du siehst, erfreut Dich nicht gerade!\n"));
	SetProp (P_LIGHT, 1 );
	SetProp (P_INDOORS, 1);

  AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Richtig, Du bist im Ameisenbau gelandet! Sehr "+
                "freundlich sind die Bewohner sicher nicht.", 78 ) );
  AddDetail( ({ "inhabitanten", "bewohner" }), 
                break_string( "Hier scheinen hauptsaechlich Ameisen zu "+
                "wohnen! Sei bloss vorsichtig, die sind sicher riesig und "+
                "boese!", 78 ) );
  AddDetail( ({ "grundmaterial", "material", "grund" }), 
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "wand", "decke", "waende" }), 
                break_string( "Hier besteht alles aus Erde, Du bist ja "+
                "schliesslich auch in einem Ameisenbau, und der hat halt mal "+
                "als Grundmaterial Erde.", 78 ) );
  AddDetail( ({ "boden", "erdboden" }), 
                break_string( "Hm. Besteht aus Erde.", 78 ) );
  AddDetail( ({ "fackel" }), 
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
                "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );
  AddDetail( ({ "erde"}), 
                break_string( "Irgendwie ist sie so locker, dass Du "+
		"in ihr buddeln koenntest.", 78 ) );

  AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");


  AddExit("norden", BAU("bau1"));
  AddExit("oben", WEG("k22"));

  AddItem(MON("wameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise"), REFRESH_DESTRUCT);

  AddCmd(({"buddel", "buddle", "grabe", "grab"}), "wuehle");
  cloned=0;

}

wuehle (str)

{
 notify_fail("Wie/Wo/Worin willst Du buddeln?\n");

 if (str !="boden" && str !="in erdboden" && str !="erde" && str !="in erde" 
     && str !="in boden" && str !="erdboden")
	return 0;

 if (cloned) 
{
 write ("Du buddelst erfolglos im Boden herum.\n");
	return 1;
}
 write("Du buddelst im Boden herum und findest - einen DOLLAR?!??\n");

 clone_object("/obj/misc/dollar")->move(TP);

 TK(TPN+" hat einen Dollar gefunden.\n");
	cloned++;
	return 1;
}
reset()
{
 ::reset();
 cloned=0;
}
