inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
	::create();

	SetProp( P_INT_SHORT, "Im Ameisenbau");
	SetProp( P_INT_LONG, bs( "Du stehst mitten im Ameisenbau. Hier "+
	"besteht alles, aber wirklich alles aus Erde. Hier kreuzen sich "+
	"die Gaenge. Bist Du sicher, dass Du nicht auf schnellstem Wege "+
	"hinaus willst?\n"));
	SetProp (P_LIGHT, 1 );
	SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));

  AddDetail( ({ "gang" }), 
                break_string( "Wir haben hier zwei Gaenge. Einen von Norden "+
                "nach Sueden und einen von Westen nach Osten. Oder umgekehrt!", 78 ) );
  AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Du stehst inmitten eines Ameisenbaues. Wie "+
                "mutig!", 78 ) );
	AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({ "grundmaterial", "material", "grund" }),
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "wand", "decke", "waende" }),
                break_string( "Hier besteht alles aus Erde, Du bist ja "+  
                "schliesslich auch in einem Ameisenbau, und der hat halt mal "+
                "als Grundmaterial Erde.", 78 ) );
  AddDetail( ({ "boden" }),
                break_string( "Besteht aus Erde.", 78 ) );
  AddDetail( ({ "fackel" }),   
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
               "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );   
  AddDetail( ({ "erde" }),
                break_string( "Sie ist braun, und ziemlich erdig.", 78 ) );
  AddDetail( ({ "kreuzung", "gaenge", "gang" "norden" "sueden", "osten", 
    "westen"}),
     "Der eine Gang erstreckt sich von Norden nach Sueden, "
     "der andere dagegen von Westen nach Osten. Es handelt sich also "
     "um eine Kreuzung.");


  AddExit("sueden", BAU("bau1"));
  AddExit("westen", BAU("bau3"));
  AddExit("osten", BAU("bau5"));
  AddExit("norden", BAU("bau6"));

  AddItem(MON("ameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise2"), REFRESH_DESTRUCT);

}
