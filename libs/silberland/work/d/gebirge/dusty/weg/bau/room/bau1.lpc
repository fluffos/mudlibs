inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"


create()
{
        ::create();
        
  SetProp( P_INT_SHORT, "Im Ameisenbau");
  SetProp(P_INT_LONG, bs("Du stehst im Gang eines Ameisenbaues. Auch hier "+
	"besteht fast alles aus Erde und erdigen Materialien. Vor Dir kannst "+
	"Du eine Kreuzung erkennen. Aber vielleicht waere es besser, nicht "+
	"weiterzugehen, wer weiss, was da noch auf Dich zukommt!\n"));
 SetProp(P_LIGHT, 0);
 SetProp(P_INDOORS, 1);
 SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
 
 
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst in ihm.", 78 ) );
   AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Du stehst inmitten eines Ameisenbaues. Wie "+
                "mutig!", 78 ) );
   AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({ "grundmaterial", "material", "grund" }),
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "wand", "decke", "waende" }),
                break_string( "Hier besteht alles aus Erde, Du bist ja "+  
                "schliesslich auch in einem Ameisenbau, und der hat halt mal "+
                "als Grundmaterial Erde.", 78 ) );
  AddDetail( ({ "boden" }),
    break_string( "Besteht aus Erde. Darauf liegt eine Staubschicht.", 78 ) );
  AddDetail( ({ "fackel" }),   
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
               "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );   
  AddDetail( ({ "erde", "materialien" }),
                break_string( "Sie ist braun, und ziemlich erdig.", 78 ) );
  AddDetail( ({ "kreuzung" }), 
    "Ein Kreuzzug? Bin auch ich berufen? (c) Otto Waalkes." );
  AddDetail( ({ "otto", "waalkes" }), 
    "Na! Da schreib ich jetzt nix zu." );
  
  AddDetail( ({ "kreuzzug" }), 
    "Fuehrst Du gerade einen Kreuzzug gegen die Ameisen?" );
  
  AddDetail( ({ "gang" "norden" "sueden"}),
     "Der Gang erstreckt sich von Norden nach Sueden.");

 
  AddItem(MON("wameise"), REFRESH_DESTRUCT);
 
 AddExit("sueden", BAU("eingang"));
 AddExit("norden", BAU("bau2"));

}
