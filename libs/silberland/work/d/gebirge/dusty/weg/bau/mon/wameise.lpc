/*
** WachtAmeise, fuer den Bau
** 24. 2. 1998 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <new_skills.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "waechter"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Ameisenwaechter");
  SetProp (P_SHORT, "Ein Ameisenwaechter");
  SetProp (P_LONG, "Vor Dir kauert ein Ameisenwaechter. "
	"Er ist noch groesser als die andern Ameisen, und schaut auch "
	"sehr furchterregend "
	"aus. Er verteidigt den Ameisenbau mit seinem Leben. Wie waere es, "
	"wenn Du von hier nicht doch wieder verschwinden wuerdest?");

  create_default_npc(9);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 200);
  SetProp (P_MAX_HP, 80);
  SetProp (P_MAX_SP, 50);
  SetProp (P_BODY, 80-random(40));
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" Gift verspritzend", 90, ({DT_ACID, DT_BLUDGEON}) }) );
  SetProp (P_SIZE, 100);
  SetProp(P_AGGRESSIVE, 1);

  SUID;

  SetProp(P_SPELLRATE,20);

  AddSpell(1,200, 
    "Der Waechter spritzt eine stinkende Fluessigkeit nach Dir.\n",
    "Der Waechter spritzt eine stinkende Fluessigkeit nach @WEM.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );


  SetProp (P_DIE_MSG, " stirbt.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Der Ameisenwaechter nickt."}));

  SetProp(P_MSGIN, "kommt herein");      

}
