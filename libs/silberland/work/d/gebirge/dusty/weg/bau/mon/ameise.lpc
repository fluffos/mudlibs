/*
**Ameise, fuer den Bau
** 21. 6. 1996 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "bmeise"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Riesenameise");
  SetProp (P_SHORT, "Eine unheimliche Ameise");
  SetProp (P_LONG, "Du siehst eine mit ihren Augen funkelnde Riesenameise. "
	"Sie ist fast einen Meter gross und beaeugt Dich unfreundlich mit ihren "
	"blutunterlaufenen Augen. Vielleicht war es keine gute Idee, in den "
	"Ameisenbau hier einzudringen...... "
	"Ihr Vorderteil ist schwarz, ihr Mittelteil rot, ihr Hinterteil weiss. "
	"Der weisse Teil schaut ziemlich giftig aus.");

  create_default_npc(6);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_LEVEL,5);
  SetProp (P_MAX_HP, 100);
  SetProp (P_MAX_SP, 100);
  SetProp (P_XP, 30000);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Mittelteil", 50, ({DT_ACID, DT_BLUDGEON})}) );
  SetProp (P_SIZE, 60);
  SetProp(P_AGGRESSIVE, 1);

  SUID;

  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Die Ameise beisst Dich.\n"}));

  AddSpell(1,100, 
    "Die Ameise verbeisst sich tief in Dein Fleisch.\n",
    "Die Ameise verbeisst sich tief in @WESSEN Fleisch.\n",
    ({DT_PIERCE, DT_ACID}), ([SP_SHOW_DAMAGE:1]) );

  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf ameisisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), 
     "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Ameise laedt sich Deine Gabe auf den Ruecken."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
