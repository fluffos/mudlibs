inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

int cloned;

create()
{
        ::create();
        
  SetProp( P_INT_SHORT, "Im Ameisenbau");
  SetProp(P_INT_LONG, bs("Du stehst im Gang eines Ameisenbaues. Hier "+
	"gibt es auch nur Erde zu sehen. Der Gang hier wird allerdings "+
	"etwas enger. Wenn Du nicht riskieren willst, eingeklemmt zu werden, "+
	"dann gehst Du wohl besser hier nicht weiter....\n"));
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:25]));
  SetProp(P_KILL_NAME, "Ein enger Gang");
  
  AddDetail( ({ "gang" "norden" "sueden"}),
     "Der Gang erstreckt sich von Norden nach Sueden.");
  AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Du stehst inmitten eines Ameisenbaues. Wie "+
                "mutig!", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({ "grundmaterial", "material", "grund" }),
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "wand", "decke", "waende" }),
                break_string( "Hier besteht alles aus Erde, Du bist ja "+  
                "schliesslich auch in einem Ameisenbau, und der hat halt mal "+
                "als Grundmaterial Erde.", 78 ) );
  AddDetail( ({ "boden" }),
                break_string( "Besteht aus Erde.", 78 ) );
  AddDetail( ({ "fackel" }),   
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
               "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );   
  AddDetail( ({ "erde" }),
                break_string( "Sie ist braun, und ziemlich erdig.", 78 ) );


 
  AddItem(MON("termite"), REFRESH_DESTRUCT);
 
 AddExit("sueden", BAU("bau6"));
 AddSpecialExit("norden", "norden");

}

norden()
{
  write(BS("Du probierst, weiter nach Norden vorzudringen, bleibst aber "
    "im engen Gang stecken. Nur unter Schmerzen kannst Du Dich wieder "
    "befreien."));
  if( interactive(TP) ) 
    TP->do_damage(random(10));  
  return 1;
}

