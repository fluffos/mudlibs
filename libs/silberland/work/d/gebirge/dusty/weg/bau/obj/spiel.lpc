inherit "std/thing";

#include <properties.h>
#include <language.h>

create()

{

  if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein seltsames Ding");
   SetProp(P_LONG, "Das hier ist aeusserst seltsam. Es ist ein kleines "
   +"metallenes nicht ganz viereckiges Ding, hat unten 4 kleine runde "+
   "Scheiben dran, vorne eine kleine Scheibe, wo man durchsehen kann, "+
   "ist innen ausgehoehlt und hat sowas wie einen klitzekleinen Sessel "+
   "in der Hoehlung. Komisch....\n");

   SetProp(P_NAME, "Ding");
   AddId(({"ding", "dings", "seltsames ding"}));
   SetProp(P_GENDER,NEUTER);
   SetProp(P_WEIGHT, 100);
   SetProp(P_INFO, "Es sieht sehr modern aus.\n"); 
   SetProp (P_MATERIAL, ([MAT_METAL:80, MAT_MISC:20]));
   
}
