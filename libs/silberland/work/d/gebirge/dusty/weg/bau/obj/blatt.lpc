inherit "std/thing";

#include <properties.h>
#include <language.h>

create()

{

  if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ahornblatt");
   SetProp(P_LONG, "Ein stinknormales Ahornblatt, schon etwas gelb.\n");

   SetProp(P_NAME, "Ahornblatt");
   AddId(({"ahorn", "ahornblatt", "blatt"}));
   SetProp(P_GENDER,NEUTER);
   SetProp(P_WEIGHT, 10);
   SetProp(P_INFO, "Du kannst nix besonderes erkennen.\n"); 
   SetProp(P_MATERIAL, MAT_PLANT);
}
