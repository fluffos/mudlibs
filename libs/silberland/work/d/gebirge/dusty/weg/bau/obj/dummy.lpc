inherit "std/thing";

#include <properties.h>
#include <language.h>

create()

{

  if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "");
   SetProp(P_LONG, "\n"
   +"\n");

   SetProp(P_NAME, "");
   AddId(({"", "", ""}));
   SetProp(P_GENDER,NEUTER);
   SetProp(P_WEIGHT, 10);
   SetProp(P_INFO, "\n"); 
   SetProp(P_MATERIAL, MAT_);
}
