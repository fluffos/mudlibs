inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
	::create();

	SetProp( P_INT_SHORT, "Im Ameisenbau");
	SetProp( P_INT_LONG, bs( "Du bist in den Tiefen des Ameisenbaues. "+
	"Hier besteht noch immer alles aus Erde. Allerdings ist es hier "+
	"sehr eng. Im Norden sieht die Wand etwas seltsam aus. Irgendwie instabil "+
	"vielleicht?"));
	SetProp (P_LIGHT, 1 );
	SetProp (P_INDOORS, 1);
	 SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:23]));

  AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Hier ist alles aus Erde und ausserdem "+
                "unspektakulaer.", 78 ) );
	AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({ "grundmaterial", "material", "grund" }),
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "decke" }),
                break_string( "Hier besteht alles aus Erde, es gibt hier"+ 
                "absolut nichts interessantes.", 78 ) );
  AddDetail( ({ "boden" }),
                break_string( "Besteht aus Erde.", 78 ) );
  AddDetail( ({ "fackel" }),   
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
               "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );   
  AddDetail( ({ "erde" }),
                break_string( "Sie ist braun, und ziemlich erdig.", 78 ) );
  AddDetail( ({"wand", "waende"}),
    "Die Wand im Norden ist nicht sehr stabil.");
  AddDetail( ({"ausgang"}),
    "Vielleicht findest Du den Ausgang im Sueden.");

  AddCmd( ({"grabe", "grab", "wuehle", "wuehl"}), "graben");
  AddExit("sueden", BAU("bau2"));
  

  AddItem(MON("wameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise"), REFRESH_DESTRUCT);
  AddItem(MON("aameise"), REFRESH_DESTRUCT);

}

void reset()
{
  RemoveExit("norden");
  ::reset();
}
  
int graben(string str)
{
  notify_fail("Du graebst Dir noch Dein eigenes Grab!\n");
  if( member( ({"norden", "wand", "in wand", "nach norden", "in norden"}),str)
      != -1 )
  {
    write("Du graebst den Weg nach Norden frei.\n");
    say(TP->Name(WER)+" graebt den Weg nach Norden frei.\n");
    AddExit("norden", BAU("bau7"));
    return 1;
  }  
  return 0;      
}
  
  
