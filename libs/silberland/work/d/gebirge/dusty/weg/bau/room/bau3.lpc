inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
	::create();

	SetProp( P_INT_SHORT, "Im Ameisenbau");
	SetProp( P_INT_LONG, "Du bist im Ameisenbau. Es ist hell genug, "
	"dass man auch ohne Fackel was sehen kann. Hier besteht alles "
	"aus Erde. Dich ueberlaeuft ein Gefuehl als ob Du von 10000 Augen "
	"betrachtet werden wuerdest. Du willst eigentlich nur raus hier, und "
	"sonst nichts....");
	SetProp (P_LIGHT, 1 );
	SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
 
  AddDetail( ({ "gefuehl" }), 
                break_string( "Du hast es. Anschauen kann man Gefuehle "+
                "nicht.", 78 ) );
  AddDetail( ({ "bau", "ameisenbau" }), 
                break_string( "Hier ist alles aus Erde und ausserdem "+
                "unspektakulaer.", 78 ) );
  AddDetail( ({ "augen", "auge" }), 
                break_string( "Es kommt Dir so vor, als ob Du von 10000 "+
                "Augen angestarrt wirst.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
	"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({ "grundmaterial", "material", "grund" }),
                break_string( "Erde, ganz normale braune Erde.", 78 ) );
  AddDetail( ({ "wand", "decke", "waende" }),
                break_string( "Hier besteht alles aus Erde, Du bist ja "+  
                "schliesslich auch in einem Ameisenbau, und der hat halt mal "+
                "als Grundmaterial Erde.", 78 ) );
  AddDetail( ({ "boden" }),
                break_string( "Besteht aus Erde.", 78 ) );
  AddDetail( ({ "fackel" }),   
                break_string( "Du siehst auch ohne sie. Aber eigentlich "+
               "waere es Dir lieber, Du wuerdest garnichts sehen, weil dann "+
                "wuerden die Ameisen Dich auch nicht sehen.", 78 ) );   
  AddDetail( ({ "erde" }),
                break_string( "Sie ist braun, und ziemlich erdig.", 78 ) );


  AddExit("osten", BAU("bau2"));
  AddExit("sueden", BAU("bau4"));

  AddItem(MON("aameise"), REFRESH_DESTRUCT);
  AddItem(MON("wameise2"), REFRESH_DESTRUCT);
  AddItem(MON("wameise"), REFRESH_DESTRUCT);

}
