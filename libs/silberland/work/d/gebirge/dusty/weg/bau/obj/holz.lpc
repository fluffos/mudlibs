inherit "std/thing";

#include <properties.h>
#include <language.h>

create()

{

  if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Einige Aestchen");
   SetProp(P_LONG, break_string("Kleine Aestchen. Die Ameisen haben sie "+
	"sicher draussen gefunden und mit in ihren Bau genommen. Wozu sie "+
	"die wohl brauchen koennen?\n", 78));
   SetProp(P_VALUE, 0);
   SetProp(P_ARTICLE, 0);
   SetProp(P_NAME, "Aeste");
   AddId(({"aeste", "aestchen", "ast", "\naestchen"}));
   SetProp(P_GENDER,FEMALE);
   SetProp(P_WEIGHT, 10);
   SetProp(P_MATERIAL, MAT_WOOD);
   SetProp(P_INFO, "Es koennte sein, dass die Ameisen damit ihren Bau "+
	"verstaerken.\n");
   SetProp(P_SMELL, "Die Aestchen riechen nach Holz.\n");
}
