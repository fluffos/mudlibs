/*
**WachtAmeise, fuer den Bau
** 24. 6. 1996 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "bmeise"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Riesenameisenwaechter");
  SetProp (P_SHORT, "Ein riesengrosser Ameisenwaechter");
  SetProp (P_LONG, "Du siehst einn Riesenameisenwaechter. "
	"Er ist einen Meter gross und kraeftig. "
	"Alle von seinen drei Gliedern sind weiss, und Du siehst sein Blut "
	"pulsieren. Er schaut ziemlich giftig aus.");

  create_default_npc(8);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HP, 80);
  SetProp (P_MAX_SP, 50);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" Gift verspritzend", 90, ({DT_ACID, DT_BLUDGEON}) }) );
  SetProp (P_SIZE, 100);
  SetProp(P_AGGRESSIVE, 1);

  SUID;

  SetProp(P_SPELLRATE,20);

  AddSpell(1,200, 
    "Der Waechter spritzt Ameisengift nach Dir.\n",
    "Der Waechter spritzt Ameisengift nach @WEM.\n",
    ({DT_POISON, DT_ACID}), ([SP_SHOW_DAMAGE:1]) );

  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "ist sich zu gut, um Dich anzuhoeren.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Der Ameisenwaechter laedt sich Deine Gabe auf den Ruecken."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
