/*
**Termite, fuer den Bau
** 21. 6. 1996 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"termite", "tier", "monster"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Termite");
  SetProp (P_SHORT, "Eine kleine Termite");
  SetProp (P_LONG, 
        "Die Termite schaut Dich freundlich und etwas furchtsam "
        "an. Was sie hier nur verloren haben mag? Und warum ist sie ueberhaupt "
        "noch am Leben, normalerweise killen doch Ameisen Termiten, wenn sie "
        "in ihren Bau eindringen?!?");


  create_default_npc(8);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HP, 50);
  SetProp (P_MAX_SP, 50);
  SetProp (P_BODY, 40);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" boese", 50, ({DT_ACID, DT_BLUDGEON}) }) );
  SetProp (P_SIZE, 50);
  SetProp(P_AGGRESSIVE, 0);

  SUID;

  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Die Termite kratzt Dich am kleinen Zeh.\n"}));

  AddSpell(1,150, 
    "Die Termite terminiert Dich.\n",
    "Die Termite terminiert @WEN.\n",
    ({DT_PIERCE, DT_ACID}), ([SP_SHOW_DAMAGE:1]) );


  SetProp (P_DIE_MSG, " seufzt traurig ein letztes Mal.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf termitisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Termite nimmt Deine Spendenwilligkeit zur Kenntnis und verschluckt deine Gabe."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
