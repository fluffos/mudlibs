/*
**ArbeiterAmeise, fuer den Bau
** 1. 7. 1996 - Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "bmeise", "arbeiterameise"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Arbeiterameise");
  SetProp (P_SHORT, "Eine Arbeiterameise");
  SetProp (P_LONG, "Du hast eine Arbeiterameise vor Dir. Sie wackelt "
	"mit ihren Fuehlern interessiert in der Gegend herum. Allerdings "
	"ist sie leider nur daran interessiert, Dich zu toeten, damit "
	"sie Nahrung fuer die Ameisennachkommen aquiriert.");

  create_default_npc(7);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HP, 50);
  SetProp (P_MAX_SP, 70);
  SetProp (P_BODY, 80+random(20));
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Mittelteil", 70, ({DT_ACID, DT_BLUDGEON}) }) );
  SetProp (P_SIZE, 3);

  SUID;

  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Die Ameise nimmt einen kleinen Brocken Erde.\n"}));

  AddSpell(1,140, 
    "Die Arbeiterin spuckt ihr Gift in Dein Gesicht.\n",
    "Die Arbeiterin spuckt ihr Gift in @WESSEN Gesicht.\n",
    ({DT_POISON, DT_ACID}), ([SP_SHOW_DAMAGE:1]) );


  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf ameisisch.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Arbeiterameise laedt sich Deine Gabe auf den Ruecken."}));

  SetProp (P_MNPC_AREA, BAU("bau"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, BAU("bau4"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  SetProp(P_MSGIN, "krabbelt herein");      

}
