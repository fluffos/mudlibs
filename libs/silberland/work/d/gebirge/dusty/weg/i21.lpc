inherit "d/gebirge/dusty/weg/bergpfad";

#include "files.h"
#include <properties.h>

create() { ::create();  

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"Ausserdem steht da noch ein Wegweiser herum.");  

  AddDetail( ({ "weg" }), 
                break_string( "Der Boden besteht aus Schotter, so wie "+
                "offensichtlich der ganze Pfad, der zu diesem unheimlichen "+
                "Berge vor Dir fuehrt. Ausserdem zweigt hier der Weg in "+
                "Richtung Oben ab.", 78 ) );
  AddDetail( ({ "wegweiser", "weiser" }), 
                break_string( "Wenn Du wissen willst, wie Du wohin kommst, "+
                "wo Du hinwillst, solltest Du lesen, was auf ihm draufsteht.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");

  AddReadDetail ("wegweiser",
    "\n   ,--------------------------------.\n"+
      "  /    /\\                            \\\n"+
      " /     || Hochgebirge, Trollager      \\\n"+
      "/      || VORSICHT, Lebensgefahr!!     \\\n"+
      "\\                                      /\n"+
      " \\   <==Midas                         /\n"+
      "  \\                     ==> Felonia  /\n"+
      "   `___________.        .___________/\n"+
      "               |        |\n\n");


  AddExit("suedwesten", WEG("h22"));
  AddExit("suedostunten", WEG("j22"));
  AddExit("suedosten", WEG("j22"));
  AddExit("rauf", "/d/gebirge/eros/room/berg_i20");
  AddExit("oben", "/d/gebirge/eros/room/berg_i20");

   SetProp (P_HIDE_EXITS, ({"suedosten","rauf"}) );
}
