// /d/gebirge/dusty/zwerge/armour/kettenzeug.c
// zwergisches Kettenzeug 
// 1997-10-24  Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Zwergisches Kettenzeug");
  SetProp(P_LONG, BS( 
    "Das Kettenzeug schuetzt die Unterarme vor Schlaegen und ist die ideale "
    "Ergaenzung zu einem Kettenhemd. Die feinen Eisenglieder sind so "
    "engmaschig, wie es nur ein Zwergenschmied herstellen kann.") );
  SetProp(P_INFO, BS(
    "Das Kettenzeug ist eindeutig fuer zwergische Proportionen angefertigt.")); 
  SetProp(P_NAME, "Kettenzeug");
  SetProp(P_NAME_ADJ, "zwergisch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 5+random(3));
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 700);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Zwerg"})]) );

  AddId( ({"kettenzeug", "zeug", "ketten"}) );
  AddAdjective( ({"zwergisch", "zwergisches", "zwergische"}) );
  
}

