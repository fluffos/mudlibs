//Eine Semmel, fuer die Zwergenbaeckeri
//Dusty@Silberland, Mai 1996

inherit "std/food";

#include "../files.h"
#include <properties.h>
#include <food.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Eine Semmel");
 SetProp(P_LONG, bs("Eine schoene nicht zu knusprige Semmel. Sie verbreitet "+
	"einen geradzu himmlischen Duft, Dir rinnt das Wasser im Mund "+
	"zusammen!\n"));
 SetProp(P_GENDER, FEMALE);
 SetProp(P_WEIGHT, 40);
 SetProp(P_VALUE, 15);
 AddId(({"semmel", "semmerl", "broetchen"}));
 SetProp(P_INFO, "Die Semmel fluestert Dir zu: 'Iss mich, iss mich!'\n");
 SetProp(P_NAME, "Semmel");
 SetProp(P_MATERIAL, MAT_BREAD);

 SetProp(P_SMELL, "Die Semmel duftet frischgebacken. Dir laeuft "+
	"das Wasser im Mund zusammen.\n");

  SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 5}), F_SOAK : 2,
	F_MSG:"Du verzehrst genuesslich die Semmel.\n",
	F_MSG_ROOM:"haelt Dir eine Semmel unter die Nase und frisst sie dann gleich auf.\n"]));

}

