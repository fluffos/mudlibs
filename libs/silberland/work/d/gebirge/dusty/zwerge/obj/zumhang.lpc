//Zwergenumhang
//Dusty@Silberland, April 1997

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"zwergenumhang", "umhang"}));
  SetProp (P_SHORT, "Ein zwergischer Umhang");
  SetProp (P_LONG, bs("Ein einfacher, grauer Zwergenumhang. Ideal fuer "+
	"kalte Tage, oder fuer den Aufenthalt unter der Erde.\n"));
  SetProp (P_NAME, "Zwergenumhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 300);
  SetProp(P_INFO, "Der Umhang ist wirklich bequem!\n");
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3,T_HEAT_PROT:-2]));

  SetProp (P_AC, 5);

}

