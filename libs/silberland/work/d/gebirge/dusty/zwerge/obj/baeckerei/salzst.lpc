/*
** Ein Salzstangerl, fuer die Zwergenbaeckerei
** Dusty@Silberland, Mai 1996
**
**
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Salzstangerl");
  SetProp(P_LONG, 
	  bs("Ein Salzstangerl. Es ist 30 cm lang, besteht aus einer "
	     "seltsamen Art Germteig und hat Salzkristalle obendrauf, "
	     "und von diesen nicht wenige.... hier muss wohl ein "
	     "Salzbergwerk in der Naehe sein!"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 20);
  AddId(({"stangerl", "stange", "salzstangerl", "salzstange"}));
  SetProp(P_INFO, 
	  bs("Ein Salzstangerl - sauer macht lustig!"));
  SetProp(P_NAME, "Salzstangerl");
  SetProp(P_MATERIAL, ([MAT_BREAD:95, MAT_SALT:5]));
  SetProp(P_SMELL, bs("Das Salzstangerl riecht eigentlich nach garnix."));

  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({5, 5}), F_SOAK : 3, F_DRINK: (-3),
	    F_MSG:"Mjammm..... salzig und sauer, das Ding.\n",
	    F_MSG_ROOM:"isst ein Salzstangerl, wo das nur herkommt?\n"]));
  
  Haltbarkeit(15);
}
