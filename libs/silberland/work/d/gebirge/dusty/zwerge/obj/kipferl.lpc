//Ein Kipferl, fuer die Zwergenbaeckerei
//Dusty@Silberland, Mai 1996

inherit "std/food";

#include "../files.h"
#include <properties.h>
#include <food.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Ein Kipferl");
 SetProp(P_LONG, bs("Ein goldblondes Kipferl. Es ist ungefaehr 20 cm lang, "+
	"15 cm breit, so wie ein normalgrosses Kipferl eben sein muss. Es "+
	"duftet frischgebacken.\n"));
 SetProp(P_GENDER, NEUTER);
 SetProp(P_WEIGHT, 40);
 AddId(({"kipferl", "kipf", "hoernchen"}));
 SetProp(P_INFO, "Kipferl wollen gegessen werden.\n");
 SetProp(P_NAME, "Kipferl");
 SetProp(P_MATERIAL, ([MAT_MISC_FOOD]));
 SetProp(P_VALUE, 18);
 SetProp(P_SMELL, "Das Kipferl hat seltsamerweise den Geruch von Kaffee an sich.\n");

 SetProp(P_FOOD_INFO, ([F_HEAL : ({7, 7}), F_SOAK : 6,
        F_MSG:"Das Kipferl erfreut Deinen Gaumen aufs allerhoechste.\n",
        F_MSG_ROOM:"verspeist ein Kipferl, und Du musst neidisch zuschauen...\n"]));

}

