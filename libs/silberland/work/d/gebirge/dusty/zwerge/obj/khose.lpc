//Kurze Zwergenhose
//Dusty@Silberland, Mai 1996

#include <properties.h>
#include <combat.h>
#include "../files.h"
inherit "std/armour";
 
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine kurze Zwergenhose");
  SetProp(P_LONG, bs("Die kurze Hose ist noch ziemlich neu, auch leuchtet "+
	"sie ein wenig in der Finsternis.\n"));
  SetProp(P_NAME, "Hose");
  SetProp(P_NAME_ADJ, "kurz");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 8);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 150);
  AddId(({"hose", "zwergenhose", "kurze hose", "kurz", "hoeschen"}));
  SetProp(P_WEAR_FUNC, TO);

}

int WearFunc()
{
  if( TP->QueryProp(P_RACE)=="Zwerg" )
    return 1;
  if( TP->QueryProp(P_RACE)=="Hobbit" )
  {
    write("Von der Laenge wuerde Dir diese Hose passen, aber Du bist zu duenn.\n");
    return 0;
  }
  write("Diese Hose ist Dir einfach zu kurz.\n");
  return 0;
}
