//Ein volles Bierglas
//Dusty@Silberland, September 1997


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"
#include <moving.h>

int voll,zitrone,fingerprints;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"glas", "bierglas", "bier", "seiterl"}));
  SetProp (P_NAME, "Bierglas");
  SetProp (P_GENDER, 0);
  SetProp (P_NAME_ADJ, "voll");
  SetProp (P_WEIGHT, 50);
  SetProp (P_VALUE, 20);

  SetProp (P_INFO, bs("Zwerge moegen Bier. Oder nicht?\n"));
  SetProp (P_MATERIAL, MAT_GLASS);

  AddDetail("zitrone",
      "Sie schwimmt im Glas drinnen, um den Geschmack zu verbessern.\n");
  AddDetail("schaum", "Gerade genug davon!\n");

  SetProp(P_SMELL, "Das Bier riecht ziemlich bitter.\n");
  seteuid(getuid(this_object()));

  voll = zitrone = 1;
  fingerprints = 0;

  AddCmd(({"trinke", "trink"}), "trink");
  AddCmd(({"fische","fisch"}), "fisch");
}

int trink(string what)
{
  notify_fail("Was moechtest Du trinken?\n");

  if (!what) return 0;
  if (what=="bier" || what=="bier aus glas" ||
      what=="bier aus bierglas" || what=="glas")
  {
    if (!voll) {
      write("Aber da ist doch gar kein Bier mehr im Glas!\n"
          "Oder siehst Du schon Gespenster...? :)");
    }
    else
    {
      write ("Du saeufst das Bier auf einen Sitz aus. Einem Boeszwerg haette\n"
            "es sicher besser geschmeckt.\n");
      PL->SetProp(P_HP, PL->QueryProp(P_HP)+5);
      voll=0;
      if (TP->id("cairn")) {
        fingerprints = 1;
        AddDetail( ({"fingerabdruecke","abdruecke","fingerabdruck"}),
            "Sie scheinen von Cairn zu stammen, dem Boeszwerg.\n");
      }
      RemoveDetail("schaum");
    }
    return 1;
  }
  else return 0;
}

int QueryFingerprints()
{
  return fingerprints;
}

string short()
{
  return "Ein " + (voll ? "voll" : "leer") + "es Bierglas.\n";
}

string long()
{
  string s;
  s="Du hast ein ";
  if (voll)
    s+="volles Bierglas in der Hand, gerade richtig hoher Schaum, "
      "nicht zuviel davon.";
  else
    s+="leeres Bierglas in der Hand, nur noch Schaumreste zeugen "
      "davon, dass sich darin einmal ein leckeres Getraenk befunden hat.";
  if (zitrone)
    s+=" Es "+(voll ? "schwimmt" : "liegt")+" eine Zitrone darin herum.";
  if (fingerprints)
    s+=" Ausserdem kannst Du einige Fingerabdruecke daran erkennen.";
  return bs(s);
}

int fisch (string what)
{
  notify_fail("Was moechtest Du herausfischen?\n");

  if (!what) return 0;
  if (what == "zitrone" || what == "zitrone aus glas" ||
     what == "zitrone aus bierglas" ||
     what == "zitrone aus bierglas heraus" ||
     what == "zitrone aus glas heraus")
  {
    zitrone=0;
    write("Du fischst die Zitrone aus dem Glas raus.\n");
    say(TP->Name()+" fischt eine Zitrone aus einem Bierglas heraus.\n");
    clone_object(OBJ("zitrone"))->move(TP,M_NOCHECK);
    RemoveDetail("zitrone");
    return 1;
  }
  return 0;
}

