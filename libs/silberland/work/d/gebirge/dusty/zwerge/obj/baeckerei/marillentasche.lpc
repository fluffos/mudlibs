/*
** Ein Marillentascherl, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Marillentascherl");
  SetProp(P_LONG, 
	  bs("Ein fruchtigfrisches Marillentascherl mit einer Fuelle aus "
	     "Vanillecreme und frischer Marillenmarmelade *mjam*."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 35);
  AddId(({"tascherl", "marillentascherl","tasche","marillentasche",
	    "SUESSIGKEIT"}));
  SetProp(P_NAME, "Marillentascherl");
  SetProp(P_SMELL, 
	  bs("Das Marillentascherl riecht sehr lecker nach frischer "
	     "Marillenmarmelade!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({9, 4}), F_SOAK : 6,
	    F_MSG:"Du beisst herzhaft in das Marillentascherl und sabberst "
	    "dabei etwas von der Vanillecreme auf den Boden...\n",
	    F_MSG_ROOM:"sabbert an einem Marillentascherl herum...\n"]));

  Haltbarkeit(8);
}
