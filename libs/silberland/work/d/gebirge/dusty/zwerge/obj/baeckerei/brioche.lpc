/*
** Ein Briochekipferl, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Briochekipferl");
  SetProp(P_LONG, 
	  bs("Ein frisches Briochekipferl mit kleinen Zuckerstueckchen "
	     "darauf. Du kannst es kaum erwarten, es aufzuessen."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 20);
  AddId(({"brioche", "briochekipferl","SUESSIGKEIT"}));
  SetProp(P_NAME, "Briochekipferl");
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({8, 4}), F_SOAK : 5,
	    F_MSG:"Der Zucker broeselt etwas ab, als Du Dir das Briochekipferl"
	    " in den Mund steckst, doch das macht Dir nichts aus...\n",
	    F_MSG_ROOM:"isst ein Briochekipferl.\n"]));
  
  AddDetail(({"zucker","zuckerstueck","zuckerstueckchen","stueckchen","stueck"}),
	   "Das Briochekipferl ist mit lauter kleinen Zuckerstueckchen "
	   "uebersaeht, die jedoch bei Beruehrung recht schnell abfallen...");

  Haltbarkeit(10);
}
