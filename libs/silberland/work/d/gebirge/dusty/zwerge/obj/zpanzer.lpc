//Zwergenpanzer
//Dusty@Silberland, Mai 1996

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"zwergenpanzer", "panzer"}));
  SetProp (P_SHORT, "Ein Zwergenpanzer");
  SetProp (P_LONG, bs("Ein dreifach gehaerteter, gegen Rost "+
	"unempfindlicher Zwergenpanzer.\n"));
  SetProp (P_NAME, "Zwergenpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1750);
  SetProp (P_VALUE, 1000);
  SetProp (P_INFO, "Dieser Panzer ist garantiert rostfrei!\n");
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 30);
  SetProp (P_MATERIAL, MAT_IRON);
  SetProp (P_QUALITY_DECAY, 150);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:10, SR_INCLUDE_RACE:"Zwerg"]) );
}
