

//Ein Packerl Kakao fuer die Zwergenbaeckerei
//Dusty@Silberland, Juni 1996

inherit "std/food";

#include "../files.h"
#include <properties.h>
#include <food.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create(({"trink", "trinke"}));

 SetProp(P_SHORT, "Ein Packerl Kakao");
 SetProp(P_LONG, bs("Das Packerl Kakao ist einen halben Liter leicht. "+
	"Es ist braun, vorne drauf ist eine Kuh gezeichnet, die Dir "+
	"strahlend mitteilt, wie umweltfreundlich sie gehalten wird.\n"));


 SetProp(P_GENDER, NEUTER);
 SetProp(P_WEIGHT, 199);
 SetProp(P_VALUE, 7);
 AddId(({"kakao", "packerl", "packel", "packerl kakao", "packel kakao"}));
 SetProp(P_INFO, "Milch ist gesund!\n");
 SetProp(P_NAME, "Packerl Kakao");
 SetProp(P_MATERIAL, MAT_MILK);
 SetProp(P_SMELL, "Der Kakao riecht nach Milch.\n");

 AddDetail("kuh", "Sie strahlt Dich an.\n");

  SetProp(P_FOOD_INFO, ([F_HEAL : ({4,4}), F_DRINK:2,
        F_MSG:"Kakao ist sehr gesund und schmeckt hervorragend.\n",
        F_MSG_ROOM:"leert ein Packerl Kakao.\n"]));

}

