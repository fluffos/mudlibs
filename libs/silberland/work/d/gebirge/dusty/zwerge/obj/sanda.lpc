//Ledersandalen fuer Zwerge
//Dusty@Silberland, Mai 1996


#include <properties.h>
#include <combat.h>
#include "../files.h"
inherit "std/armour";
 
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ledersandalen");
  SetProp(P_LONG, bs("Ledersandalen, die Zwerge benutzen, wenn es fuer "+
	"die schwereren Lederschuhe zu heiss ist.\n"));
  SetProp(P_NAME, "Sandalen");
  SetProp(P_ARTICLE, 0);
  AddId(({"sandalen", "ledersandalen", "tatschkerl"}));
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_AC, 5);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
}
