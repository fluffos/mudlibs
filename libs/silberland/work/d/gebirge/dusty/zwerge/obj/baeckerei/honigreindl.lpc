/*
** Ein Honigreindl, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Honigreindl");
  SetProp(P_LONG, 
	  bs("Ein frisches Honigreindl, voll mit Honig und mit geraspelten "
	     "Nuessen bestreut."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 55);
  SetProp(P_VALUE, 43);
  AddId(({"reindl", "honigreindl","SUESSIGKEIT"}));
  SetProp(P_NAME, "Honigreindl");
  SetProp(P_SMELL, 
	  bs("Das Honigreindl riecht lecker nach Honig und Nuessen."));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({10, 5}), F_SOAK : 8,
	    F_MSG:"Du isst das ganze Honigreindl auf und bekleckerst Dich "
	    "mit Honig...\n",
	    F_MSG_ROOM:"stopft sich ein ganzes Honigreindl rein!\n"]));

  Haltbarkeit(10);
}
