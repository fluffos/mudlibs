/*
** Ein Punschkrapfen, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Punschkrapferl");
  SetProp(P_LONG, 
	  bs("Ein frisches und noch saftiges Punschkrapferl mit einer "
	     "zartrosa Zuckerglasur."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 33);
  AddId(({"krapferl","krapfen","punschkrapferl","punschkrapfen",
	    "SUESSIGKEIT"}));
  SetProp(P_NAME, "Punschkrapferl");
  SetProp(P_SMELL, 
	  bs("Das Punschkrapferl riecht nach Rum!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({8, 6}), F_SOAK : 6, F_ALCOHOL : 2,
	    F_MSG:"Das Punschkrapferl verschwindet einfach so in Deinem "
	    "Mund und uebrig bleibt ein angenehmer Geschmack nach Rum...\n",
	    F_MSG_ROOM:"isst ein kleines Punschkrapferl. *mjam*\n"]));
  
  AddDetail(({"glasur","zucker","zuckerglasur"}),
	    "Das Punschkrapferl ist mit einer dicken, rosafarbenen "
	    "Zuckerglasur ueberzogen. *mjam*");
  
  AddDetail(({"rosa","farbe"}),
	    "Die Zuckerglasur ist rosa.");
  
  Haltbarkeit(12);
}
