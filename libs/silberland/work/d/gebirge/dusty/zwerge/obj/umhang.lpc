//Zwergenumhang
//Dusty@Silberland, Mai 1996


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

object wer;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

//  TK(TPN+" hat einen Umhang gecloned!\n");
  AddId ("umhang");
  SetProp (P_SHORT, "Ein lustiger bunter Umhang");
  SetProp (P_LONG, bs("Du hast einen lustigen bunten Umhang in Deiner "+
	"Hand. Er besteht aus rotem, gruenem, gelbem, grauem, schwarzem, "+
	"silbernem, braunem und ockerfarbenem "+ 
	"Stoff. Sogar ein grosser Herrscher wuerde stehenbleiben und schauen, "+
	"wenn Du ihn traegst. Du wuerdest fuer diesen Umhang sogar einen "+
	"Mord begehen.\n"));
  SetProp (P_NAME, "Umhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME_ADJ, "bunt");
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 1000);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 9);
  SetProp (P_INFO, bs("Der lustige bunte Umhang koennte Dir aus schlimmen "+
	"Situationen helfen!\n"));
  SetProp (P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1,DT_MAGIC:1]) );
  
  SetProp(P_DEFEND_FUNC, ME);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
    if ((member(dam_type, DT_FIRE) != -1) || 
        (member(dam_type, DT_MAGIC) != -1 ))
    {
      if( !random(3) )
        tell_object (QueryProp(P_WORN), 
          "Die lustigen Farben Deines bunten Umhangs leuchten magisch auf.\n");
    }
    return 0;
}

