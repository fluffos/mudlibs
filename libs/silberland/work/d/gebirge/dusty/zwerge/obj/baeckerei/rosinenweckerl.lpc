/*
** Ein Rosinenweckerl, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Rosinenweckerl");
  SetProp(P_LONG, 
	  bs("Ein butterweiches Rosinenweckerl voll mit suessen Rosinen und "
	     "einer hauchduennen Schicht aus Pulverzucker."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 15);
  AddId(({"weckerl", "rosinenweckerl","wecken","rosinenwecken",
	    "SUESSIGKEIT"}));
  SetProp(P_NAME, "Rosinenweckerl");
  SetProp(P_SMELL, 
	  bs("Du schnupperst an dem Rosinenweckerl und ploetzlich hast Du "
	     "etwas von dem Pulverzucker in der Nase.")+
	  bs("Haaaaaa-tschi! Gesundheit!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({6, 3}), F_SOAK : 5,
	    F_MSG:"Du stopfst das Rosinenweckerl in Dich hinein...\nUebrig "
	    "bleibt nur etwas Pulverzucker rund um Deinen Mund.\n",
	    F_MSG_ROOM:"stopft sich ein Roseinenweckerl in den Mund, der "
	    "daraufhin voller Pulverzucker ist...\n"]));
  
  AddDetail(({"zucker","pulverzucker","schicht","zuckerschicht",
		"pulverzuckerschicht"}),
	    "Eine hauchduenne Schicht aus Pulverzucker ziert das "
	    "Rosinenweckerl.");

  Haltbarkeit(14);
}
