/*
** Ein grosses Baguette, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Baguette");
  SetProp(P_LONG, 
	  bs("Ein herrlich duftendes, einen Meter langes Baguette. Worauf "
	     "wartest Du eigentlich noch? Iss es!"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 60);
  AddId(({"baguette", "langbaguette"}));
  SetProp(P_NAME, "Baguette");
  
  SetProp(P_SMELL, 
	  bs("Ein herrlich duftendes Baguette."));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({15, 8}), F_SOAK : 12,
	    F_MSG:"Du futterst das ganze Baguette ohne Pause in Dich rein.\n",
	    F_MSG_ROOM:"stopft ein langes Baguette einfach so in sich rein...\n"]));
  
  Haltbarkeit(13);
}
