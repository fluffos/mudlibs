//Zwergenkampfaxt
//Dusty@Silberland, Mai 1996

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"zwergenaxt", "axt", "kampfaxt"}));
  SetProp(P_SHORT, "Eine zwergische Kampfaxt");
  SetProp(P_LONG, bs("Diese Kampfaxt ist eine der schoensten Aexte "+
	"die Du bisher in Haenden gehabt hast. Liegt wirklich gut "
	"in der Hand, eigentlich viel zu schade, um sie zu verkaufen!\n"));
  SetProp(P_NAME, "Kampfaxt");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 2400);
  SetProp(P_INFO, "Die Axt liegt sehr gut in der Hand.\n");
  SetProp(P_WC, 155);
  SetProp(P_WC_FIX, 40);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS,2);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:40, MAT_OAK:60]));
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15, A_DEX: 13, P_LEVEL: 15]) );
  SetProp(P_WC_BONUS, (["zwerg": 30, "zwergenberserker": 100,
        "Axtkaempfer":30, "Axtexperte":90, "Axtmeister":250]) );
}
