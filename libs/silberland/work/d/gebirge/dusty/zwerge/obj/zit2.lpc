//Dummyzitrone
//Dusty@Silberland, April 1998

inherit "std/thing";

#include "../files.h"
#include <properties.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Eine ausgequetschte Zitronenscheibe");
 SetProp(P_LONG, bs("Du siehst eine ausgequetsche Zitronenscheibe. "
 	"Faengt sicher gleich zu stinken an.\n"));
 SetProp(P_GENDER, FEMALE);
 SetProp(P_WEIGHT, 20);
 AddId(({"zitrone", "scheibe", "zitronenscheibee"}));
 SetProp(P_INFO, "Nix anderes als eine tote Zitronenscheibe.\n");
 SetProp(P_NAME, "Zitronenscheibe");
 SetProp(P_MATERIAL, ([MAT_FRUIT:100]));

 SetProp(P_SMELL, "Die Zitronenscheibe riecht nach Zitrone und Biomuell.\n");

}