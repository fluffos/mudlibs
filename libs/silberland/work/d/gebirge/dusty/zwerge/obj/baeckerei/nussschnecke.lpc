/*
** Eine Nussschnecke, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Eine Nussschnecke");
  SetProp(P_LONG, 
	  bs("Eine grosse, rechteckige Nussschnecke mit einer feinen "
	     "Zimt-Zucker Glasur."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 35);
  SetProp(P_VALUE, 25);
  AddId(({"nussschnecke", "nusschnecke","schnecke", "SUESSIGKEIT"}));
  SetProp(P_NAME, "Nussschnecke");
  SetProp(P_SMELL, 
	  bs("Die Nussschnecke riecht total lecker nach Nuessen und Zimt."));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({7, 7}), F_SOAK : 6,
	    F_MSG:"Du mampfst die Nussschnecke fast auf einmal auf!\nDu "
	    "wischst Dir die Glasur aus dem Gesicht ;)\n",
	    F_MSG_ROOM:"isst eine Nussschnecke und ist danach voll mit der "
	    "Zimt-Zucker Glasur.\n"]));

  AddDetail(({"zimt","zimtglasur","zucker","zuckerglasur","zimtzuckerglasur",
		"zimt-zuckerglasur"}),
	    "Die Nussschnecke ist mit einer feinen Glasur aus Zimt und "
	    "Zucker ueberzogen.\nDu sabberst die Nussschnecke an.");
  
  AddDetail(({"nuss","nuesse","fuellung","nussfuellung"}),
	    "Die Nussschnecke ist mit einer leckeren Nussfuelle gefuellt.");
  
  Haltbarkeit(10);
}
