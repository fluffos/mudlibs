/*
** Ein Croissant, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Buttercroissant");
  SetProp(P_LONG, 
	  bs("Ein knuspriges Buttercroissant. Es broeselt leicht, wenn man "
	     "es drueckt. Wieso hast Du es denn noch nicht aufgegessen?"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 35);
  SetProp(P_VALUE, 25);
  AddId(({"croissant", "buttercroissant","SUESSIGKEIT"}));
  SetProp(P_NAME, "Buttercroissant");
  SetProp(P_SMELL, 
	  bs("Das Buttercroissant riecht sehr lecker!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({7, 4}), F_SOAK : 5,
	    F_MSG:"Das Buttercroissant broeselt etwas ab, aber da ist es auch "
	    "schon weg...\n",
	    F_MSG_ROOM:"isst vor Deinen Augen ein knuspriges Buttercroissant!\n"]));

  Haltbarkeit(10);
}
