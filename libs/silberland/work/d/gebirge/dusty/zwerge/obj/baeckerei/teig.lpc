/*
**  Standardteig fuer Baeckereileckereien
**
**  2002-11-28  PROtheG  Dirty Hack, kein Altern im Lager
*/

inherit "std/food";

#include "../../files.h"
#include <properties.h>
#include <food.h>

#define ALTERSGRENZE 2
#define BAECKEREILADEN ROOM("blager")

nosave int haltbarkeit, alt;

varargs void create(mixed commands)
{
  if(!is_clone(ME)) return; 
  ::create(commands);
  
  SetProp(P_SHORT, "Etwas Teig");
  SetProp(P_LONG, 
	  bs("Zaeher Teig."));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 5);
  AddId(({"BAECKEREI"}));
  SetProp(P_NAME, "Teig");
  SetProp(P_MATERIAL, MAT_BREAD);
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({1, 1}), F_SOAK : 2,
	    F_MSG:"Du schlingst den rohen Teig hinunter.\n",
	    F_MSG_ROOM:"schlingt etwas rohen Teig hinunter.\n"]));

  haltbarkeit=ALTERSGRENZE+1;
  alt=0;
}

public int Haltbarkeit(int i)
{
  if(i > 15) i=15; //Wir wollens mal nicht uebertreiben...
  if(i <  0) i=0;

  haltbarkeit=i;
  
  return haltbarkeit;
}

void reset()
{
  if(!is_clone(ME)) return; 
  ::reset();
  
  if((MENV) && (file_name(MENV)==BAECKEREILADEN)) return;
  
  haltbarkeit--;
  
  if((!alt) && (haltbarkeit <= ALTERSGRENZE))
    {
      SetProp(P_LONG, QueryProp(P_LONG)+
	      bs(CAP(QueryPronoun(WER))+" wirkt nicht mehr so frisch..."));
      
      SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO)+([F_HEAL : ({1, 0})]));

      alt=1;
    }
  
  if(haltbarkeit <= 0) call_out("verrotten", 5);
}

void verrotten(int flag)
{
  if((flag) && (MENV) && (interactive(MENV)))
    tell_object(MENV,
		bs("Dein"+(QueryProp(P_GENDER)==FEMALE ? "e ":" ")+
		   name(WER)+" ist nicht mehr essbar, daher wirfst Du "+
		   QueryPronoun(WEN)+" weg."));
  
  remove();
}

public int QueryHaltbarkeit()
{
  return haltbarkeit;
}

public int QueryAbgelaufen()
{
  return alt;
}
