/*
** Ein Baguette, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Babybaguette");
  SetProp(P_LONG, 
	  bs("Ein fast schon zu kurz geratenes, jedoch herrlich duftendes "
	     "Baguette haelst Du da in Deinen Haenden. Dir rinnt schon "
	     "das Wasser im Mund zusammen bei dem Gedanken, das Baguette "
	     "zu essen..."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 30);
  AddId(({"baguette", "babybaguette"}));
  SetProp(P_NAME, "Babybaguette");
  
  SetProp(P_SMELL, 
	  bs("Ein herrlich duftendes Babybaguette."));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({6, 3}), F_SOAK : 3,
	    F_MSG:"Du beisst genuesslich in das Babybaguette und nochmal und nochmal... Doch da ist es auch schon weg.\n",
	    F_MSG_ROOM:"stopft ein Babybaguette einfach so in sich rein...\n"]));
  
  Haltbarkeit(13);
}
