#include "../files.h"
#include <properties.h>
#include <language.h>

inherit "/std/thing";

#define MY_P_HEAL "rw_pizza_heilung"
#define MY_P_FOOD "rw_pizza_saettigung"

#define TIME_DIFF 300

int zustand;

long() {
  return (QueryProp(P_LONG)+((string)(zustand?"":"Sie ist kalt.\n")));
}

create(){
  if (sizeof(explode(file_name(this_object()),"#"))==1) return;
  ::create();
  SetProp(P_SHORT,"Eine Pizza");
  SetProp(P_LONG,"Eine Pizza.\n");
  AddId("pizza");
  SetProp(P_NAME,"Pizza");
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_WEIGHT,500);
  SetProp(P_VALUE, 50 );
  SetProp(P_NOBUY, 1);
  SetProp(MY_P_HEAL,0);
  SetProp(MY_P_FOOD,100);
  SetProp(P_MATERIAL, MAT_FOOD);

  AddCmd(({"iss","ess","esse","mampf","mampfe","verspeise","verschlinge"}),
			"essen");

  zustand=5;
  call_out("erkalte",2*TIME_DIFF);
}

msg_out(string msg) {
  object env;

  env=environment();
  if (!env) return;
  if (living(env))
	tell_object(env,msg);
  else
	tell_room(env,msg);
}

erkalte() {
  if (zustand>0) {
	zustand--;
	if (zustand>0) { 
	  SetProp(MY_P_HEAL,(QueryProp(MY_P_HEAL)*4)/5);
	  msg_out("Die Pizza kuehlt ab. Du solltest sie schnell essen!\n");
	  call_out("erkalte",TIME_DIFF);
	} else {
	  SetProp(MY_P_HEAL,0);
	  msg_out("Die Pizza ist nun endgueltig kalt geworden.\n");
	  call_out("erkalte",6*TIME_DIFF);
	}
  } else {
	msg_out("Die Pizza ist soeben total vergammelt.\n");
	remove();
  }
}

essen(str) {
  int saett,heil;

  if (!str) return 0;
  if (!id(lower_case(str))) return 0;

  saett=QueryProp(MY_P_FOOD);
  heil=QueryProp(MY_P_HEAL);
  if (heil>(saett/4)) heil=saett/4;
  if (heil>25) heil=25;
  if (saett<25) saett=25;

  notify_fail("Soviel kannst Du momentan nicht essen.\n");
  if (!TP->eat_food(saett)) return 0;

  if (zustand)
	write("Du isst Deine Pizza. Sie schmeckt koestlich!\n");
  else
	write("Du isst Deine kalte Pizza.\n");
  say(TPN+" isst eine Pizza - sie scheint "+TP->QueryPronoun(WEM)+" zu schmecken.\n");
  TP->heal_self(heil);
  remove();
  return 1;
}
