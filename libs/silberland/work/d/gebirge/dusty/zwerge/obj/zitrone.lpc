// Zitrone
// Dusty@Silberland, Mai 1996


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId ("zitrone");
  SetProp (P_SHORT, "Eine gelbe Zitronenscheibe");
  SetProp (P_LONG, bs("Eine knallgelbe Zitronenscheibe, ihr Saft "+
	"ist bestimmt sehr sauer!"));
  SetProp (P_NAME, "Zitronenscheibe");
  AddId( ({"zitronenscheibe", "scheibe", "zitrone"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 30);
  SetProp (P_VALUE, 1);
  SetProp (P_INFO, bs("Vielleicht kann man sie auspressen und den Saft zu "+
  	"etwas verwenden?"));
  SetProp (P_MATERIAL, MAT_FRUIT);

}

int press(string what)
{
  notify_fail("Was moechtest Du auspressen?\n");

  if (!what) return 0;
  if (what=="zitrone" || what=="zitrone aus" ||
      what=="scheibe aus" || what=="zitronenscheibe aus")
  {
	if(present("\nschale", this_player() ))
      write("Du presst die Zitrone aus und fuellst den Saft in Dein "+
	"Schaelchen.\n");
  }
    else
    {
      write ("Du presst den Saft aus und verschuettest ihn im Boden. Schade!\n");
	clone_obj(OBJ("zit2"))->move(TP, M_NOCHECK);
    return 1;
  }
  else return 0;
}
