inherit "std/thing" ;

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <language.h>

int number;
int geschmack;

create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 10);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, NEUTER );
	AddId(({"bonbon","zuckerl"}));
	art();
}

art()
{
	int num;
	num = random (21);
	switch(num)
	{
		case 0 :	
			SetProp(P_SHORT,"Dein Skorpionschwanz-Bonbon");
			SetProp(P_LONG,"Ein Bonbon, das wie ein Skorpionschwanz aussieht, und warscheinlich auch danach schmecken wird ;-).\n");
			SetProp(P_NAME,"Skorpionschwanz-Bonbon");
			AddId(({"skorpionbonbon","skorpionschwanzbonbon"}));
			SetProp(P_SMELL, "Das Skorpionschwanz-Bonbon hat seltsamerweise den Geruch von Kaffee an sich.\n");

		break;
		case 1 :
			SetProp(P_SHORT,"Dein Zwiebel-Bonbon");
			SetProp(P_LONG,"Ein Bonbon, das nach frischen Zwiebeln duftet! *mmmmmhhhmmmmmm*.\n");
			SetProp(P_NAME,"Zwiebel-Bonbon");
			AddId(({"zwiebelbonbon"}));
	                SetProp(P_SMELL, "Das Zwiebel-Bonbon duftet durchdringend nach Zwiebeln!!!\n");

		break;
                case 2 :
			SetProp(P_SHORT,"Dein Knoblauch-Bonbon");
			SetProp(P_LONG,"Ein Knoblauchbonbon, soll sehr gesund sein!\n");
			SetProp(P_NAME,"Knoblauch-Bonbon");
			AddId(({"knoblauchbonbon"}));
	                SetProp(P_SMELL, "Das Knoblauch-Bonbon riecht intensiv nach Zwiebeln?!? War wohl zu nahe beim Zwiebelbonbon gelagert.\n");

		break;
                case 3 :
			SetProp(P_SHORT,"Dein Spinat-Bonbon");
			SetProp(P_LONG,"Spinat macht stark, Spinatbonbons noch staerker.\n");
			SetProp(P_NAME,"Spinat-Bonbon");
			AddId(({"spinatbonbon"}));
                        SetProp(P_SMELL, "Das Spinat-Bonbon riecht gruen.\n");

		break;
                case 4 :
			SetProp(P_SHORT,"Dein Knackwurst-Bonbon");
			SetProp(P_LONG,"Hm, das Knackwurstbonbon knackt schon beim Ansehen!\n");
			SetProp(P_NAME,"Knackwurst-Bonbon");
			AddId(({"knackwurstbonbon","wurstbonbon"}));
                        SetProp(P_SMELL, "Das Knackwurst-Bonbon riecht nach gestampften Wurstresten.\n");
		break;
                case 5 :
			SetProp(P_SHORT,"Dein Sauerkraut-Bonbon");
			SetProp(P_LONG,"Dieses leckere Sauerkrautbonbon scheint sehr gesund zu sein, da es nicht sonderlich appetitlich aussieht.\n");			
			SetProp(P_NAME,"Sauerkraut-Bonbon");
			AddId(({"sauerkrautbonbon", "sauerkraut"}));
                        SetProp(P_SMELL, "Das Sauerkraut-Bonbon macht Gusto auf Wurstknoedel.\n");
		break;
                case 6 :
			SetProp(P_SHORT,"Dein Essiggurkerl-Bonbon");
			SetProp(P_LONG,"Ein Essiggurkerlbonbon, sehr gesund. Du findest, es wuerde in Schokolade getaucht noch besser schmecken.\n");
			SetProp(P_NAME,"Essiggurkerl-Bonbon");
			AddId(({"essiggurkerlbonbon","essigbonbon"}));
                        SetProp(P_SMELL, "Das Essiggurkerl-Bonbon duftet nach Salzlake.\n");
		break;
		case 7 :
			SetProp(P_SHORT,"Dein Brennessel-Bonbon");
			SetProp(P_LONG,"Ein Brennesselbonbon, brennt sicher sehr nesselig!\n");
			SetProp(P_NAME,"Brennessel-Bonbon");
			AddId(({"brennesselbonbon","nesselbonbon"}));
                        SetProp(P_SMELL, "Das Brennessel-Bonbon riecht brennend nach Natur.\n");
		break;
		case 8 :
			SetProp(P_SHORT,"Dein Broccoli-Bonbon");
			SetProp(P_LONG,"Ein Broccolibonbon, ziemlich gruen und wahrscheinlich auch gesund. *baeh*\n");
			SetProp(P_NAME,"Broccoli-Bonbon");
			AddId(({"broccolibonbon","broccbonbon"}));
                        SetProp(P_SMELL, "Das Broccoli-Bonbon riecht aehnlich wie das Spinatbonbon.\n");
		break;
		case 9 :
			SetProp(P_SHORT,"Dein Waldmeister-Bonbon");
			SetProp(P_LONG,"Ein Waldmeisterbonbon, es riecht seltsam nach Aaalkohoool?\n");
			SetProp(P_NAME,"Waldmeister-Bonbon");
			AddId(({"waldmeisterbonbon","meisterbonbon","waldbonbon"}));
                        SetProp(P_SMELL, "Das Waldmeister-Bonbon riecht aber gut!!!\n");
		break;
		case 10:
			SetProp(P_SHORT,"Dein K.Schokobon");
			SetProp(P_LONG,"Ein K.Schokobon, das essen alle Kinder gern, und der Zahnarzt verdient dabei.\n");
			SetProp(P_NAME,"Schokobon");
			AddId(({"kinderbon","bon","schokobon","kinnerbon","kinnerschokobon","kinderschokobon","k.schokobon","k.bon"}));
                        SetProp(P_SMELL, "Das K.Schokobon duftet nach Schokolade.\n");
		break;
		case 11:
			SetProp(P_SHORT,"Dein Emmentaler-Bonbon");
			SetProp(P_LONG,"Ein Emmentaler-Bonbon, schaut kaesig drein!\n");
			SetProp(P_NAME,"Emmentalerbonbon");
			AddId(({"emmentalerbonbon","kaesebonbon"}));
                        SetProp(P_SMELL, "Das Emmentaler-Bonbon riecht eher metallisch.\n");
		break;
		case 12:
			SetProp(P_SHORT,"Dein Soja-Bonbon");
			SetProp(P_LONG,"Ein Soja-Bonbon, schaut von der Konsistenz her irgendwie oelig aus...\n");
			SetProp(P_NAME,"Soja-Bonbon");
			AddId(({"sojabonbon"}));
                        SetProp(P_SMELL, "Das Soja-Bonbon riecht nach chinesischem Restaurant.\n");
		break;
		case 13:
			SetProp(P_SHORT,"Dein Chili-Bonbon");
			SetProp(P_LONG,"Ui, ein Chili-Bonbon! *hauch*\n");
			SetProp(P_NAME,"Chili-Bonbon");
			AddId(({"chili-bonbon","chilibonbon"}));
                        SetProp(P_SMELL, "Das Chili-Bonbon riecht, als ob es morgen noch mal wirkt.\n");
		break;
		case 14:
			SetProp(P_SHORT, "Dein Wildkraut-Bonbon");
			SetProp(P_LONG,"Ein gruenendes Wildkraut-Bonbon, macht Dich sicher wild!\n");
			SetProp(P_NAME,"Wildkraut-Bonbon");
			AddId(({"wildkrautbonbon","wildkraut"}));
                        SetProp(P_SMELL, "Das Wildkraut-Bonbon riecht total wild und unzaehmbar!\n");

                break;
                case 15:
                        SetProp(P_SHORT, "Dein Eukalyptus-Bonbon");
                        SetProp(P_LONG,"Ein Eukalyptus-Bonbon - pass auf, dass Du nicht zum Tier wirst!\n");
                        SetProp(P_NAME,"Eukalyptus-Bonbon");
                        AddId(({"eukalyptusbonbon","eukalyptus"}));
                        SetProp(P_SMELL, "Das Eukalyptus-Bonbon riecht wie ein Koalabaer im Regen.\n");

               break;
                case 16:
                        SetProp(P_SHORT, "Dein Senf-Bonbon");
                        SetProp(P_LONG,"Ein Senf-Bonbon - mild und gleichzeitig senfig wuerzig!\n");
                        SetProp(P_NAME,"Senf-Bonbon");
                        SetProp(P_SMELL, "Das Senf-Bonbon erinnert Dich an ein Paar Wuerstel.\n");
			AddId(({"senfbonbon","senf"}));
              break;
                case 17:
                        SetProp(P_SHORT, "Dein Ketchup-Bonbon");
                        SetProp(P_LONG,"Ein Ketchup-Bonbon. Hat sicherlich viele Paradeiser in sich.\n");
                        SetProp(P_NAME,"Ketchup-Bonbon");
                        SetProp(P_SMELL, "Das Ketchup-Bonbon schmeckt sicher jedem Kind.\n");
			AddId(({"ketchupbonbon","ketchup"}));

             break;
                case 18:
                        SetProp(P_SHORT, "Dein Orchideen-Bonbon");
                        AddId(({"orchideenbonbon"}));
                        SetProp(P_LONG,"Das Orchideen-Bonbon schaut aus wie eine Orchideenbluete und duftet nach Vanille.\n");
                        SetProp(P_NAME,"Orchideen-Bonbon");
                        SetProp(P_SMELL, "Das Orchideen-Bonbon riecht intensiv nach Vanille.\n");
	     break;
		case 19:
			SetProp(P_SHORT, "Dein Edelschimmel-Bonbon");
			AddId(({"schimmelbonbon", "schimmel", "edel", "edelschimmelbonbon"}));
			SetProp(P_LONG, "Das Edelschimmel-Bonbon ist reinweiss und riecht ..... nach PFERD?\n");
			SetProp(P_NAME, "Edelschimmel-Bonbon");
                        SetProp(P_SMELL, "Das Edelschimmel-Bonbon riecht, als ob es gleich wieherte.\n");
	     break;
		case 20:
			SetProp(P_SHORT, "Dein Paprika-Bonbon");
			AddId(({"paprikabonbon", "paprika"}));
			SetProp(P_LONG, "Das Paprika-Bonbon riecht wuerzig. Du bekommst Appetit auf Gulasch.\n");
			SetProp(P_NAME, "Paprika-Bonbon");    
                        SetProp(P_SMELL, "Das Paprika-Bonbon passt sicher gut zu Gulasch, oder?\n");

        break;
                case 21:
                        SetProp(P_SHORT, "Dein Brech-Bonbon");
                        AddId(({"brechbonbon"}));
                        SetProp(P_LONG, "Das Brech-Bonbon neigt zum Abbrechen. Oder zum Erbrechen?\n");
                        SetProp(P_NAME, "Brech-Bonbon");
                        SetProp(P_SMELL, "Das Brech-Bonbon riecht wie eine Spielkarte.\n");
        break;
                case 22:
                        SetProp(P_SHORT, "Dein Camembert-Bonbon");
                        AddId(({"camembertbonbon", "kaesebonbon"}));
                        SetProp(P_LONG, "Das Camembert-Bonbon ist aussen haarig und weiss und innen gelb.\n");
                        SetProp(P_NAME, "Camembert-Bbonbon");
                        SetProp(P_SMELL, "Das Camembert-Bonbon hat einen seltsamen Geruch.\n");
        break;
                case 23:
                        SetProp(P_SHORT, "Dein Pommesfrites-Bonbon");
                        AddId(({"pommesfritesbonbon", "pommesbonbon"}));
                        SetProp(P_LONG, "Das Pommesfritesbonbon riecht nach altem Fett. Yuck.\n");
                        SetProp(P_NAME, "Pommesfrites-Bonbon");
                        SetProp(P_SMELL, "Das Pommesfrites-Bonbon riecht wie 40 Tage altes Fett.\n");
        break;
                case 24:
                        SetProp(P_SHORT, "Dein Gurken-Bonbon");
                        AddId(({"gurkenbonbon"}));
                        SetProp(P_LONG, "Das Gurken-Bonbon riecht waessrig. Das schmeckt sicher fad.\n");
                        SetProp(P_NAME, "Gurken-Bonbon");
                        SetProp(P_SMELL, "Das Gurkenbonbon riecht intensiv nach Salat.\n");
        break;
                case 25:
                        SetProp(P_SHORT, "Dein Rotbull-Bonbon");
                        AddId(({"rotbullbonbon", "bullbonbon"}));
                        SetProp(P_LONG, "Das Rotbull-Bonbon schaut aus wie aus Gelatine und riecht nach Gummibaerli.\n");
                        SetProp(P_NAME, "Rotbull-Bonbon");
                        SetProp(P_SMELL, "Das Rotbull-Bonbon rennt Dich sicher gleich nieder.\n");
        break;
                case 26:
                        SetProp(P_SHORT, "Dein Extrawurst-Bonbon");
                        AddId(({"extrawurstbonbon", "wurstbonbon"}));
                        SetProp(P_LONG, "Das Extrawurst-Bonbon ist rosa. Was da alles drin ist?\n");
                        SetProp(P_NAME, "Extrawurst-Bonbon");
                        SetProp(P_SMELL, "Das Extrawurst-Bonbon riecht nach.... lassen wirs :-)\n ");
        break;
                case 27:
                        SetProp(P_SHORT, "Dein Lavendel-Bonbon");
                        AddId(({"lavendelbonbon"}));
                        SetProp(P_LONG, "Das Lavendel-Bonbon ist lila und duftet intensiv.\n");
                        SetProp(P_NAME, "Lavendel-Bonbon");
                        SetProp(P_SMELL, "Das Lavendel-Bonbon... waerst Du eine Muecke, wuerdest Du fliehen.\n ");

}			
}

init()
{
	::init();
	add_action("essen","esse");
	add_action("essen","iss");
	add_action("essen","lutsche");
}

essen(string str)

{
	notify_fail("Was moechtest Du essen?\n");
	if ( !str || !id(str) )

	return 0;

        number = random (3);
        switch(number)
{
   case 0 :
	write("Du lutschst vorsichtig " + name(WEN,0) + " und stellst fest, "+
		"dass es nicht einmal schlecht schmeckt!\n");
	say( capitalize(PL->name(WER,2)) + " lutscht " + name(WEN,0) + " und schaut "+
		"ueberrascht - wahrscheinlich ob des guten Geschmacks - drein.\n");

	break;
   case 1 :
	write("Du lutscht an " + name(WEM,0) + " und magst noch "+
		"eines. Seltsamer Geschmack.\n");
 	say(capitalize(PL->name(WER,2)) + " lutscht " + name (WEN,0) + ". "+
	"Eigentlich haettest Du auch Gusto auf Bonbons!\n");

	break;
   case 2 :
        write("Du lutscht an " + name(WEM,0) + " und faengst an, zu wuergen. "+
                "Was war denn nur mit diesem Bonbon los? Wer hat denn da herumgepfuscht?!?\n");
        say(capitalize(PL->name(WER,2)) + " lutscht " + name (WEN,0) + " und faengt an zu wuergen. "+
        "Wer hat denn dieses Bonbon hergestellt?\n");

 }
	remove();
	return 1;
}
