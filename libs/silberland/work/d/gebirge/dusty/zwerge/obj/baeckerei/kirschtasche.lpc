/*
** Eine Kirschtasche, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Kirschtascherl");
  SetProp(P_LONG, 
	  bs("Ein saftiges Kirschtascherl mit einem zarten Zuckerguss oben "
	     "drauf."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 35);
  AddId(({"tascherl", "tasche", "kirschtasche", "kirschtascherl",
	    "SUESSIGKEIT"}));
  SetProp(P_NAME, "Kirschtascherl");
  SetProp(P_SMELL, 
	  bs("Das Kirschtascherl riecht sooo lecker nach Kirschen!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({8, 3}), F_SOAK : 5,
	    F_MSG:"Du beisst genuesslich in das Kirschtascherl und beisst "
	    "natuerlich sofort auf einen Kirschenkern. Du spuckst ihn "
	    "jedoch aus und isst weiter, Woodyseidank war da nur ein Kern "
	    "drin...\n",
	    F_MSG_ROOM:"isst ein Kirschtascherl und spuckt dabei Kerne!\n"]));

  Haltbarkeit(8);
}
