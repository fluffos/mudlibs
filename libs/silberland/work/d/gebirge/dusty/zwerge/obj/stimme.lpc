#include <properties.h>                    
#include <language.h>
#include <wizlevels.h>
#include "../files.h"
inherit "/std/thing";

create()
{
  ::create();
  SetProp(P_SHORT,"Eine Stimme");
  SetProp(P_LONG,"Wer mag wohl seine Stimme verloren haben?\n"+
"Jedenfalls kannst Du damit zwei Leuten etwas gleichzeitig mitteilen.\n"+
"Tippe einfach ``teile person1 und person2 mit text''.\n");
  AddId("stimme");
  SetProp(P_ARTICLE,1);
  SetProp(P_NAME,"Stimme");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  SetProp(P_WEIGHT,0);
  SetProp(P_NODROP, 1);
  AddCmd(({"teil","teile"}),"do_teile_mit");
  AddCmd(({"erzaehl","erzaehle"}),"do_erzaehle");
}

int mitteilen (string s1,string s2,string text) {
  object pl1,pl2;
  string pln1,pln2,PLN1,PLN2,*ignore,tid,tpn;

  if (!s1 || !s2 || !text)
    return 0;
  pln1=lower_case(s1);pl1=find_player(pln1);
  pln2=lower_case(s2);pl2=find_player(pln2);
  if (!pl1 || !pl2)
    return 0;
  if (pl1->QueryProp(P_INVIS) || pl2->QueryProp(P_INVIS))
    if (!IS_WIZARD(TP))
      return 0;

  PLN1=capitalize(pl1->name(WER));pln1=pl1->name(WEM);
  PLN2=capitalize(pl2->name(WER));pln2=pl2->name(WEM);
  tid=geteuid(TP);tpn=capitalize(TP->name(WER));

  write("Du teilst "+pln1+" und "+pln2+" mit: "+text+"\n");
  
  if (pointerp(ignore=pl1->QueryProp(P_IGNORE)) && member(ignore,tid)>=0)
    printf("%s ignoriert Dich.\n",PLN1);
  else
    tell_object(pl1,tpn+" teilt "+pln2+" und Dir mit: "+text+"\n");

  if (pointerp(ignore=pl2->QueryProp(P_IGNORE)) && member(ignore,tid)>=0)
    printf("%s ignoriert Dich.\n",PLN2);
  else
    tell_object(pl2,tpn+" teilt "+pln1+" und Dir mit: "+text+"\n");

  return 1;
}

int do_teile_mit (string str) {
  string pln1,pln2,text;

  if (!(str=this_player()->_unparsed_args())) return 0;
  if (sscanf(str,"%s und %s mit %s",pln1,pln2,text)!=3) return 0;
  return mitteilen(pln1,pln2,text);
}

int do_erzaehle (string str) {
  string pln1,pln2,text;

  if (!(str=this_player()->_unparsed_args())) return 0;
  if (sscanf(str,"%s und %s %s",pln1,pln2,text)!=3) return 0;
  return mitteilen(pln1,pln2,text);
}





