/*
** Ein Laugenstangerl, fuer die Zwergenbaeckerei
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Laugenstangerl");
  SetProp(P_LONG, 
	  bs("Ein laengliches Laugenstangerl welches mit Salzstueckchen "
	     "bestreut wurde. Wo bleibt das Bier dazu?"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 25);
  AddId(({"stangerl", "laugenstangerl"}));
  SetProp(P_NAME, "Laugenstangerl");

  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({5, 5}), F_SOAK : 2, F_DRINK: (-2),
	    F_MSG:"Du futterst das Laugenstangerl auf... Jetzt brauchst Du ein Bier!\n",
	    F_MSG_ROOM:"knabbert an einem Laugenstangerl rum... Du bekommst Lust auf ein Bier...\n"]));
  
  AddDetail(({"salz","salzstueck","salzstueckchen","stueck","stueckchen"}),
	    "Viele kleine Salzstueckchen zieren das Laugenstangerl.");
  
  Haltbarkeit(12);
}
