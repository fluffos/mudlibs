/*
** Stock fuer Zwerge
** April 1997 - Dusty
*/

inherit "std/weapon";

#include <properties.h>    
#include <combat.h>        
#include <language.h>       

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stock"}));
  SetProp (P_SHORT, "Ein Stock");
  SetProp (P_LONG, "Ein Stock, wie man ihn auch zum Kaempfen verwenden kann.\n");
  SetProp (P_NAME, "Stock");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 300);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 80);
  SetProp (P_WC_BONUS, (["zwerg": 40]) );
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, MAT_WOOD);
}
