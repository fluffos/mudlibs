#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Kornspitz");
  SetProp(P_LONG, 
	  bs("Ein dunkler Kornspitz mit einer leicht salzigen Kruste oben "
	     "drauf."));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 20);
  AddId(({"kornspitz"}));
  SetProp(P_NAME, "Kornspitz");

  SetProp(P_SMELL,
	  bs("Der Kornspitz riecht sehr lecker!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({7, 3}), F_SOAK : 3,
	    F_MSG:"Du knabberst etwas an dem Kornspitz herum und ploetzlich "
	    "ist er auch schon weg...\n",
	    F_MSG_ROOM:"isst einen leckeren Kornspitz.\n"]));
  
  Haltbarkeit(12);
}
