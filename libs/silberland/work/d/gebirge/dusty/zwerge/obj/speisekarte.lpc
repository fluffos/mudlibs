// speisekarte.c    Eine Speisekarte
// Diese Karte zeigt dem Spieler, wieviel er noch essen und trinken kann
// 1.12.95  - Janice@Anderland -
// Aenderung: 19.12.95    Die Alkoholabfrage kam dazu
// 11.4.96  Woody  Es wird nun nicht mehr in Zahlen angezeigt sondern als Text.
// 22.11.96  Woody  aehm.. alk ist alk und nicht drink :)
// 03.11.97  Feyaria Value gesetzt, man kann die ja umsonst einkaufen!

inherit "std/thing";

#include <properties.h>
#include <language.h>
#define BS(str) break_string(str, 78, "", 1)

int food, drink, max_food, max_drink, alk, max_alk;
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Speisekarte");
  SetProp(P_LONG, BS("Eine kleine nett gestylte Speisekarte, die Dir zeigt, "+
                     "ob Du noch was Essen oder Trinken kannst."));
  SetProp(P_NAME, "Speisekarte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"speisekarte", "karte"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 333);
  AddCmd("lies", "lesen");
  SetProp(P_INFO, BS("Mit 'lies karte' erhaelst Du eine Uebersicht, "+
                     "wie Betrunken, oder Satt Du bist.\n"));
  SetProp(P_NOSELL,1 );

}

lesen(str)
{
 notify_fail("Was willst Du lesen ?\n");
 if (id(str))
 {
  max_food  = this_player()->QueryProp(P_MAX_FOOD);
  food      = this_player()->QueryProp(P_FOOD);
  max_drink = this_player()->QueryProp(P_MAX_DRINK);
  drink     = this_player()->QueryProp(P_DRINK);
  max_alk   = this_player()->QueryProp(P_MAX_ALCOHOL);
  alk       = this_player()->QueryProp(P_ALCOHOL);
/*
  write(BS("Essen: "+food*100/max_food+"% und Trinken: "+drink+" "+
           "(max: "+max_drink+")\n"));
*/
  food=food*100/max_food;
  if (food < 10)      write("Dein Magen knurrt laut.\n");
  else if (food < 20) write("Du fuehlst Dich sehr hungrig.\n");
  else if (food < 40) write("Du koenntest noch ziemlich viel essen.\n");
  else if (food < 60) write("Du koenntest noch einiges verdauen.\n");
  else if (food < 80) write("Du kannst nicht mehr viel essen.\n");
  else if (food < 90) write("Du fuehlst Dich ziemlich satt.\n");
  else                write("Du bringst kaum mehr einen Bissen hinunter.\n");

  drink=drink*100/max_drink;
  if (drink < 10)      write("Du koenntest saufen wie ein Kamel.\n");
  else if (drink < 20) write("Du bist sehr durstig.\n");
  else if (drink < 40) write("Du koenntest noch ziemlich viel trinken.\n");
  else if (drink < 60) write("Du koenntest noch einiges trinken.\n");
  else if (drink < 80) write("Du kannst nicht mehr viel trinken.\n");
  else if (drink < 90) write("Du fuehlst Dich ziemlich voll.\n");
  else                 write("Du kannst so gut wie keinen Tropfen mehr trinken.\n");

  alk=alk*100/max_alk;
  if (alk < 10)      write("Du fuehlst Dich nuechtern wie noch nie.\n");
  else if (alk < 20) write("Du fuehlst Dich relativ nuechtern.\n");
  else if (alk < 40) write("Du spuerst ein wenig Alkohol in Dir.\n");
  else if (alk < 60) write("Du merkst den Alkohol ziemlich stark in Dir.\n");
  else if (alk < 80) write("Der Alkoholgehalt Deines Blutes ist bedenklich.\n");
  else if (alk < 90) write("Du bist ziemlich besoffen.\n");
  else               write("Du bist stockbesoffen.\n");
/*
  write("Du bist zu "+alk+"% betrunken.\n");
*/
  return 1;
  }
  else
    return 0;
}
