/*
** Handaxt fuer Zwerge
** 10. 5. 1996 - Dusty
*/

inherit "std/weapon";

#include <properties.h>    
#include <combat.h>        
#include <language.h>       

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"axt", "handaxt"}));
  SetProp (P_SHORT, "Eine Handaxt");
  SetProp (P_LONG, "Eine praktische Handaxt, gut zu fuehren!\n");
  SetProp (P_NAME, "Handaxt");
  SetProp (P_GENDER, FEMALE);

  SetProp (P_VALUE, 350);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_WEAPON_TYPE, WT_AXE);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 100);
  SetProp (P_WC_BONUS, (["zwerg": 50]) );
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_IRON:40, MAT_FIR:60]) );
  SetProp(P_WC_BONUS, (["zwerg":50]) );
}
