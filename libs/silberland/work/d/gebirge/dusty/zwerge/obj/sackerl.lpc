
inherit "std/thing" ;

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <language.h>
#include "../files.h"

#define MAXFILL 30

int fill;

create()
{
  if (!is_clone(this_object())) return;
  ::create() ;

  fill = MAXFILL;

  SetProp( P_SHORT, "Ein Sackerl, voll mit Bonbons" ) ;
  SetProp( P_LONG, "Ein seltsames Bonbonsackerl.  \n"+
		   "Es enthaelt @@wieviel@@ Bonbons.\n");

  SetProp( P_WEIGHT, 20 + 10*MAXFILL) ;
  SetProp( P_NOBUY, 1) ;
  SetProp( P_NODROP, "Nein, Du willst doch nicht dieses Geschenk weggeben !?\n");
  SetProp( P_NEVERDROP, 1) ;
  SetProp( P_NAME, "Sackerl") ;
  SetProp( P_GENDER, NEUTER ) ;
  AddId( ({ "bonbonsackerl","sackerl", "bonbons" }) ) ;

}

init()
{
	::init();
	add_action("naschen","greife");
	add_action("naschen","greif");
}

naschen (str)
{
  notify_fail("Wohinein moechtest Du greifen ?\n");
  if ( str != "sackerl" && str != "in sackerl" &&
       str != "bonbons" && str != "in bonbonsackerl")
	 return 0;
  write("Du greifst in Dein Sackerl und holst ein Bonbon heraus.\n");
  say( PL->name(WER,2) + " holt ein Bonbon aus einem Sackerl.\n");
  clone_object(OBJ("bonbon"))->move(PL, M_NOCHECK);
  SetProp(P_WEIGHT, QueryProp(P_WEIGHT) - 10);	
  fill--;
  if (!fill)
  {
    write("Oooooooooch.... das war das letzte Bonbon *ohje*\n");
    say(PL->name(WESSEN)+"Bonbonsackerl entschwindet.\n");
    return remove();
  }
  return 1;
}

string wieviel()
{
  return ""+fill+"";
}

