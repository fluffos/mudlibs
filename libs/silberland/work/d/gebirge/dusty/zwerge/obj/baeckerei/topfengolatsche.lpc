/*
** Eine alte Topfengolatsche, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Eine Topfengolatsche");
  SetProp(P_LONG, 
	  bs("Eine weiche, jedoch schon etwas aelter aussehende "
	     "Topfengolatsche, mit seltsamen Tupfen darauf."));

  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 35);
  SetProp(P_VALUE, 35);
  AddId(({"golatsche", "topfengolatsche","SUESSIGKEIT"}));
  SetProp(P_NAME, "Topfengolatsche");
  SetProp(P_SMELL, 
	  bs("Die Topfengolatsche riecht irgendwie sehr seltsam..."));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({-7, 0}), F_SOAK : 6,
	    F_MSG:"Die Topfengolatsche ist doch schon total mit Schimmel bedeckt!\nDir ist das egal und Du isst sie trotzdem *wuerg*...\n",
	    F_MSG_ROOM:"stopft sich eine verschimmelte Topfengolatsche rein!!!\n"]));
  
  AddDetail(({"topfen","tupfen"}),
	    "Topfen mit Tupfen!");
  
  Haltbarkeit(5);
}
