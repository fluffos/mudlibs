//Zwergenhose
//Dusty@Silberland, Mai 1996

#include <properties.h>
#include <combat.h>
#include "../files.h"
inherit "std/armour";
 
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine zwergische Hose");
  SetProp(P_LONG, "Die Hose ist grau und schon etwas abgetragen.\n");
  SetProp(P_NAME, "Zwergenhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_AC, 6);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 200);
  AddId(({"hose", "zwergenhose"}));
}
