/*
** Ein Schokocroissant, Baeckerei Felonia
** PROtheG
**
** 
*/

#include "../../files.h"
#include <properties.h>
#include <food.h>

inherit OBJ("baeckerei/teig");

void create()
{
  if(!is_clone(ME)) return; 
  ::create();
  
  SetProp(P_SHORT, "Ein Schokocroissant");
  SetProp(P_LONG, 
	  bs("Ein knuspriges Schokocroissant mit einem hauchduennen "
	     "Schokonetz als Verzierung. Es wiegt etwas mehr, als ein "
	     "normales Croissant, anscheinend ist es randvoll mit "
	     "Schokocreme!"));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 55);
  SetProp(P_VALUE, 33);
  AddId(({"croissant", "schokocroissant","SUESSIGKEIT"}));
  SetProp(P_NAME, "Schokocroissant");
  SetProp(P_SMELL, 
	  bs("Mjam! Schokolade!"));
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL : ({10, 5}), F_SOAK : 8,
	    F_MSG:"Das Schokocroissant loest sich in Deinem Mund foermlich auf, uebrig bleibt nur die leckere Schokofuelle...\n",
	    F_MSG_ROOM:"isst vor Deinen Augen ein schokogefuelltes Croissant!\n"]));

  Haltbarkeit(10);
}
