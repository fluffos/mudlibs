//Zwergenkapuze
//Dusty@Silberland, Mai 1996
//upgedated April 1997


#define P_KAPFARBE "kapfarbe"

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
inherit "std/armour";
 
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Zwergenkapuze");
  SetProp(P_LONG, bs("Die Kapuze passt sich hervorragend an jede Kopfform "
	"an, ist daher ideal um sich mit jemandem zu pruegeln! Sie ist grau.\n"));
  SetProp(P_NAME, "Kapuze");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 5);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 150);
  AddAdjective(({"graue"}));
  AddId(({"kapuze", "zwergenkapuze", "\nfapuze"}));
  SetProp (P_MATERIAL, ([MAT_COTTON:100]));
}

init()
{
  object ob, other;
  object *k;
  int f, n;

  ::init();
  if (!MENV) return;
  if (!interactive(MENV)) return;
  k = ({ 0, 0, 0, 0, 0, 0, 0, 0});
  n = 0;
  ob = ME;
  k[QueryProp(P_KAPFARBE)] = ME;
  while ((ob=next_inventory(ob)))
  {
    if (ob->id("\nfapuze"))
    {
      f=ob->QueryProp(P_KAPFARBE);
      if (!k[f])
      {
        k[f]=ob;
        n++;
      }
    }
  }
  if (n==7) 
  {
    for(n;n--;n>0)
      if( k[f]!=ME) k[f]->SetProp(P_KAPFARBE,0);
    call_out ("bauen", 0, k, MENV);
  }
  return;
}

bauen(object *k, who)
{
  int i;

  if (!this_object())
    return;             // eine andere kapu.c war schneller...

  tell_object (who, bs("Dir kommt die aeusserst geniale Idee, Dir aus "+
    "Deinen bunten Kapuzen einen lustigen Umhang zu schneidern, "+
    "den Du sofort anziehst."));
  tell_room (ENV(who), who->name()+" schneidert sich einen lustigen, "+
    "bunten Umhang.\n", ({who}));
  clone_object(OBJ("umhang"))->move(who,M_NOCHECK);
  who->command_me("ziehe umhang an");

  for (i=sizeof(k)-1; i>=0; i--)
  {
    if (k[i] != ME && objectp(k[i]))
      k[i]->remove();
  }
  call_out ("remove", 0);
}

string short()
{
  string s;
  switch (QueryProp(P_KAPFARBE))
  {
    case 1: s="gelb"; break;
    case 2: s="gruen"; break;
    case 3: s="rot"; break;
    case 4: s="schwarz"; break;
    case 5: s="braun"; break;
    case 6: s="ockerfarben"; break; 
    case 7: s="silberfarben"; break;
    default: s="grau"; break;
  }
  return "Eine "+s+"e Zwergenkapuze"+
    (QueryWorn() ? " (getragen)" : "") + ".\n";
}
string long()
{
  string s;
  switch (QueryProp(P_KAPFARBE))
  {
    case 1: s="gelb"; break;
    case 2: s="gruen"; break;
    case 3: s="rot"; break;
    case 4: s="schwarz"; break;
    case 5: s="braun"; break;
    case 6: s="ockerfarbene"; break;
    case 7: s="silberfarben"; break;
    default: s="grau"; break;
  }
  return bs("Die Kapuze passt sich hervorragend an jede Kopfform "+
	"an, ist daher ideal um sich mit jemandem zu pruegeln! Sie ist "+
	s+".\n");
}

string extra_look()
{
  string s;
  if (!QueryWorn()) return "";
  switch (QueryProp(P_KAPFARBE))
  {
    case 1: s="sonnenblumengelbe"; break;
    case 2: s="dunkelgruene"; break;
    case 3: s="leuchtendrote"; break;
    case 4: s="tiefschwarze"; break;
    case 5: s="erdbraune"; break;
    case 6: s="ockerfarbene"; break;
    case 7: s="silberfarbene"; break;
    default: s="graue"; break;
  }
  return bs (
    (environment()->QueryProp(P_GENDER)==2 ? "Sie" : "Er")+
    " hat eine zwergische, "+s+" Kapuze auf.\n");
}

int _set_kapfarbe(int x)
{
  string *s;
  switch (x)
  {
    case 1: s=({"gelbe"}); break;
    case 2: s=({"gruene"}); break;
    case 3: s=({"rote"}); break;
    case 4: s=({"schwarze"}); break;
    case 5: s=({"braune"}); break;
    case 6: s=({"ockerfarbene"}); break;
    case 7: s=({"silberfarbene","silberne"}); break;
    default: s=({"grau"}); break;
  }
  SetProp(P_ADJECTIVES, s);
  return Set(P_KAPFARBE, x);
}
