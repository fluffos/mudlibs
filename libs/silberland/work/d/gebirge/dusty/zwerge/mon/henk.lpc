/*
** Ein Wachzwerg namens Henk
** ---
** 10. 5. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

#define P_KAPFARBE "kapfarbe"

#define ZWERGENTOOL "/p/service/protheg/rt/obj/bartspange"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wachzwerg", "zwerg", "monster", "henk"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Henk");
  SetProp (P_SHORT, "Henk, der Wachzwerg");
  SetProp (P_LONG, bs("Das ist Henk, der Wachzwerg. Er ist ungefaehr 1.20 "+
	"gross, hat einen 30 Zentimeter langen Bart und freundliche Augen. "+
	"Sein noch nicht ganz ergrautes Haar hat einen Stich von Braun. In "
	"seiner Jugend hat er sicherlich vielen Frauen den Hof gemacht!"));

  SetProp (P_ALIGN, 500);
  create_default_npc(19);
//  SetProp (P_LEVEL, 13);
//  SetProp (P_MAX_HP, 390);
//  SetProp (P_MAX_SP, 390);
//  SetProp (P_XP, 300000);
  SetProp (P_BODY, 100);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seiner Handaxt ", 200, DT_BLUDGEON}) );
  SetProp (P_SIZE, 120);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_ARTICLE, 0);
  set_living_name("henk");
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("zkaxt"));
  command ("zuecke axt");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 300);
  ob->move(ME);
  CLONEME (OBJ("zhose"));
  ob=CLONEOB (OBJ("kapu"));
  ob->move(ME);
  ob->SetProp (P_KAPFARBE, 1);
  if( !random(4) ) CLONEME ("/p/armour/bracers/kettenzeug");
  switch(random(4))
  {
    case 0: CLONEME( OBJ("zpanzer")); break;
    case 1: CLONEME( "/p/armour/armour/kettenhemd"); break;
    case 2: CLONEME( "/d/gebirge/angrox/obj/kettenhemd"); break;
  }
  command ("ziehe alles an");

  SetProp(P_SPELLRATE,15);

  AddSpell(1,400, 
    "Henk verflucht Dich mit einem zwergischen Unheilsspruch.\n",
    "Henk belegt @WEN mit einem zwergischen Unheilsspruch.\n",
   DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  
  SetChats(3, ({
       "Henks Magen grummelt.\n",
	 "Henk murmelt: Eine Semmel, ein Brot, Irgendwas, hauptsache Essen!\n",
	 "Henk murmelt: Immer das ewige Herumstehen, ich will was essen!\n",
	 "Henk flucht: Dieser Hunger wird mich noch irgendwann umbringen!\n",
	 "Henk sabbert einer Semmel hinterher.\n",
	 "Henks Bauch grummelt.\n"}));
  
  SetAttackChats(4, ({
    "Henk flucht: Verruchter, warum tust Du uns das an?\n",
    "Henk fragt: Hast Du nicht die Gebote gelesen?\n",
    "Henk flucht: Moege die Rache der Hoechsten mit Dir sein!\n"}));

  SetProp (P_DIE_MSG, " stirbt ob dieser ruchlosen Tat.\n");
  SetProp (P_DEFAULT_INFO, "sagt: 'Frage Cairn, der kann Dir sagen, was "+
	"Du wissen willst!\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  AddInfo ("felonia", "erzaehlt Dir: 'Felonia ist die Stadt, welche zu "+
	"verteidigen meine Aufgabe ist, und bisher habe ich sie gut genug "+
	"erfuellt.'\n");

  AddInfo(({"stadt", "zwergenstadt"}), "laechelt: 'Felonia, meine Heimat. "+
	"Geh weiter nach unten und erforsche sie, aber benimm Dich gesittet "+
	"und beachte die Gebote.'\n");

  AddInfo(({"gebot", "gebote"}), "nickt: 'Du findest sie irgendwo in die Wand "+
	"gemeisselt.'\n");

  AddInfo("targ", "laechelt: Targ ist mein Soehnchen, er ist auch Waechter!\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");
  
  AddInfo(({"hilfe","hunger","essen","semmel","brot","irgendwas"}),
	  "Ich habe solchen Hunger, willst Du mir nicht etwas bringen?",
	  "fragt: ");
  
  AddInfo(({"bauch","magen"}),
	  "Der grummelt schon vor Hunger, willst Du mir nicht etwas bringen?",
	  "meint: ");
  
  AddInfo(({"bartspange","spange"}),
	  "Ich weiss leider nicht genau was das ist, ich habe die Bartspange "
	  "irgendwo gefunden.","bedauert: ");
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Danke! Die Hoechsten werden Dir zu Dank verpflichtet sein.\n" }) );
  
  SetProp(P_MSGIN, "trottet verlegen herein");   
  SetProp(P_MSGOUT, "verdrueckt sich");

}

void give_notify(object ob)
{
  if(ob->id("Nahrung"))
    {
      command_me("sage Ah, etwas zu essen!");
      tell_room(MENV, BS(Name()+" isst "+ob->name(WEN)+" auf."));
      
      if(lower_case(TP->QueryProp(P_RACE))=="zwerg")
	if(!present("\nPROtheG_Racetool", TP))
	  {
	    write(BS("Henk bedankt sich bei Dir.")+
		  BS("Henk meint: Nimm dafuer diese Bartspange als Geschenk an."));
	    say(BS("Henk ueberreicht "+TP->name(WEM)+" etwas."), TP);
	    
	    CLONE(ZWERGENTOOL, TP);	    
	  }
      ob->remove(1);
      
      return;
    }
  
  return ::give_notify(ob);
}
