/*
** Der Daemon Zwoelferschlag
** ---
** 13.8.97 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  create_default_npc(13);
  AddId (({"daemon", "professor", "schlag", "zwoelfer", "zwoelferschlag"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Professor Zwoelferschlag");
  SetProp (P_SHORT, "Der Daemon Zwoelferschlag");
  SetProp (P_LONG, bs("Der daemonische Professor Zwoelferschlag sitzt "+
	"erhaben hinter seinem Schreibtisch. Die grosse Brille, die er "+
	"auf der Nase hat, scheint so wackelig zu sein, dass sie jeden "+
	"Moment hinunterfallen koennte. Er hat 2 Hoerner auf dem Kopf und "+
	"sieht nicht allzu freundlich "+
	"aus, also solltest Du besser hoeflich sein, wenn Du etwas von "+
	"ihm haben willst."));

  create_default_npc(2);
  SetProp(P_NOATTACK, 1);
  SetProp (P_RACE, "Daemon");
  SetProp (P_ARTICLE, 0);
  set_living_name("zwoelferschlag");

  SUID;

  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  AddInfo(({"felonia", "stadt", "zwergenstadt"}), "schiebt sich die Brille zurecht und sagt: 'Felonia, die Stadt der Zwerge.. "+
	"Geh und erforsche sie, aber benimm Dich gesittet "+
	"und beachte die Gebote.'\n");

  AddInfo(({"lupe"}), bs("grinst boese: Wenn Du die Lupe von mir haben willst, musst Du "+
	"mir dafuer schon etwas bieten. Vielleicht koenntest Du mir etwas "+
	"bringen, das mich hier von diesem Buerojob ablenkt? Du kennst doch "+
	"die Dinger, die man nur einmal anstupfen muss, damit sie ewig in "+
	"Bewegung bleiben? SOWAS faende ich echt lustig, das waere mir "+
	"den Verlust meiner Lupe wert!\n") );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Danke! Die Hoechsten werden Dir zu Dank verpflichtet sein.\n" }) );

}
