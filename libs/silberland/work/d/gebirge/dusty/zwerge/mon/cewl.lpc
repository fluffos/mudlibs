/*
** Ein Zwergerl namens Cewl
** ---
** 4.4.1997 - Dusty
** fuer die Zwergenhoehle
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "cewl"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Cewl");
  SetProp (P_SHORT, "Cewl, der Boeszwerg");
  SetProp (P_LONG, bs("Das ist Cewl, ein Boeszwerg. Er duerfte erst vor "+
	"kurzem zu dieser Art von Leben verurteilt worden sein. Schwarze "+
	"Ringe unter seinen eigentlich wunderschoenen gruengrauen Augen "
	"zeugen von der Schmach, die er erleiden musste. Er schaut Dich "+
	"etwas unentschlossen an."));

  SetProp (P_ALIGN, 200);
  create_default_npc(15);
//  SetProp (P_LEVEL, 13);
//  SetProp (P_MAX_HP, 250);
//  SetProp (P_MAX_SP, 250);
//  SetProp (P_XP, 250000);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_SIZE, 117);
  SetProp (P_HANDS, ({" mit seiner Handaxt ", 70, DT_BLUDGEON}) );
  SetProp (P_RACE, "Zwerg");
  SetProp (P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  AddDetail( ({ "augen", "auge" }),
                break_string( "Er hat schwarze Ringe unter seinen "
	"gruengrauen Augen. Er schaut Dich unentschlossen an." , 78 ) );

  AddDetail(({"ringe", "ring"}),
	bs("Die Ringe unter seinen Augen sind schwarz. Er duerfte schon "+
	"lange nicht mehr ruhig geschlafen haben."));

  SUID;

  // Ausruestung
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 250+random(100));
  ob->move(ME);
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  ob=CLONEOB (OBJ("kapu"));
  ob->SetProp (P_KAPFARBE, 5);
  ob->move(ME);
  command("ziehe kapuze an");
  SetProp(P_SPELLRATE,15);

  AddSpell(1,120, 
    "Cewl bricht in Traenen aus. Dein Herz spuert einen Stich.\n",
    "Cewl grinst @WEN boese an.\n",
   DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats (4, ({
    "Cewl sagt: Warum greifst Du mich an?\n",
    "Cewl sagt: Hab ich Dir was getan? Lass mich in Ruh!\n",
    "Cewl schimpft leise vor sich hin.\n"}) );

  SetProp (P_DIE_MSG, " stirbt ob Deiner ruchlosen Tat.\n");
  SetProp (P_DEFAULT_INFO, "sagt: 'Geh und frag Cairn, der weiss Bescheid!'\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");
  AddInfo("cairn", "sagt: Das ist der Boeszwerg, der am meisten Wissen besitzt.\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Cewl sagt: Im Moment finde ich zwar leider keine Verwendung dafuer, "
    "aber trotzdem - danke!\n"}) );

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "flaniert weiter");

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle5"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

}
