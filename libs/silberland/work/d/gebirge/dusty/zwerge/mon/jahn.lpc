/*
** Jahn, ein Boeszwerg
** ---
** 10. 5. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "jahn"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Jahn");
  SetProp (P_SHORT, "Jahn, ein Boeszwerg");
  SetProp (P_LONG, bs("Das ist Jahn, ein Boeszwerg. Er lebt, wie alle anderen "+
	"Boeszwerge, hier in der Hoehle. Jahn hat das Vergehen begangen, "+
	"sich gegen das Verbot des Widersprechens gegenueber den Hoechsten "+
	"aufzulehnen, deswegen muss er "+
	"hier, ausserhalb der Zwergenstadt, sein Dasein fristen."));

  SetProp(P_ARTICLE, 0);
  SetProp (P_ALIGN, -200);
  create_default_npc(13);
//  SetProp (P_LEVEL, 15);
//  SetProp (P_MAX_HP, 100);
//  SetProp (P_MAX_SP, 100);
//  SetProp (P_XP, 100000);
//  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit fiesen Tricks", 130, DT_BLUDGEON}) );
  SetProp (P_SIZE, 140);
  SetProp(P_RACE, "Zwerg");
  set_living_name("jahn");  
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  ob=CLONEOB (OBJ("kapu"));
  ob->move(ME);
  command ("ziehe kapuze an");
  ob->SetProp (P_KAPFARBE, 3);

  SetProp(P_SPELLRATE,15);

  AddSpell(1,50,
    "Jahn uebt schlechten Einfluss auf Dich aus.\n",
    "Jahn uebt schlechten Einfluss auf @WEN aus.\n",
   DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "Du kommst von den Hoechsten, Du Verraeter!\n",
    "Jahn flucht: 'Verruchter Spion!\n"}));

  SetChats(1, ({        
	"Jahn tritt Dich.\n",
	"Jahn verflucht Deine gute Laune.\n",
	"Jahn streicht sich ueber seinen Bart.\n"}));

  SetProp (P_DIE_MSG, " hat sein Leben verwirkt.\n");
  SetProp (P_DEFAULT_INFO, "sagt: 'Cairn magst Du ausfragen, Du elender Spion der "+
	"Hoechsten, aber lasse mich in Ruhe!'\n");

  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
     "Jahn meint: 'Obwohl ich Dir nicht vertraue, nehme ich Deine Gabe an.'\n" }) );

  SetProp(P_MSGIN, "kommt finster und grummelnd an");
  SetProp(P_MSGOUT, "geht wortlos weiter");

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle2"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);


}
