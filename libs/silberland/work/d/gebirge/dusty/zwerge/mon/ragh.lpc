/*
** Ragh, ein Boeszwerg
** ---
** 10. 5. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "ragh"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Ragh");
  SetProp (P_SHORT, "Ragh, ein Boeszwerg");
  SetProp (P_LONG, bs("Ragh ist ein ziemlich grosser Boeszwerg, der keinen "+
	"Spass versteht. Er wurde wegen mehrerer koerperlicher Angriffe auf "+
	"friedliebende Bewohner von Felonia hier in diese Hoehle verbannt. "+
	"Sieh Dich vor, ihm ist sicher jeder schmutzige Trick recht, um Dich "+
	"loszuwerden!"));

  create_default_npc(22);
  SetProp (P_ARTICLE, 0);
  SetProp (P_ALIGN, -400);
//  SetProp (P_LEVEL, 19);
//  SetProp (P_MAX_HP, 500);
//  SetProp (P_MAX_SP, 400);
  SetProp(P_SIZE, 120);
  SetProp(P_RACE, "Zwerg");
//  SetProp (P_XP, 500000);
//  SetProp (P_BODY, 200);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit all seiner Wut", 230, DT_BLUDGEON}));
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  ob=CLONEOB (OBJ("kapu"));
  ob->move(ME);
  ob->SetProp (P_KAPFARBE, 4);
  command ("ziehe kapuze an"); 
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 54);
  ob->move(ME);
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");

  SetProp(P_SPELLRATE,15);

  AddSpell(1,300, 
    "Ragh ueberwaeltigt Dich mit einem unglaublichen Hassgefuehl.\n",
    "Ragh ueberwaeltigt @WEN mit einem unglaublichen Hassgefuehl.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "NIE haettest Du mich angreifen sollen!\n",
    "Ragh flucht: 'Wuerdest Du mein elendes Leben kennen, dann....'\n",
    "Ragh mustert misstrauisch die Umgebung.\n"}));

  SetProp (P_DIE_MSG, " beendet sein Leiden.\n");
  SetProp (P_DEFAULT_INFO, "sagt: 'Geh und frag Cairn, der Junge ist klug!\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Hm, vielleicht kann ich noch was brauchen davon.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle6"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
    
  SetProp(P_MSGIN, "stampft wuetend herein");   
  SetProp(P_MSGOUT, "tritt Dich und geht");


}
