/*
** Flark, ein Boeszwerg
** ---
** 10. 5. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "flark"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Flark");
  SetProp (P_SHORT, "Flark, ein Boeszwerg");
  SetProp (P_LONG, bs("Das ist Flark, ein Boeszwerg. Er hat blondes Haar, "+
	"blaue Augen, und einen sanften Blick. Irgendwie erinnert er Dich "+
	"in seiner Art ein wenig an Cairn. Dass er dennoch hier in der "+
	"Hoehle leben muss, scheint eigentlich unerklaerlich."));

  SetProp (P_ALIGN, 200);
  create_default_npc(16);  
//  SetProp (P_LEVEL, 14);
  SetProp (P_MAX_HP, 330);
  SetProp (P_MAX_SP, 300);
  SetProp (P_XP, 250000);
  SetProp(P_SIZE, 115);
  SetProp(P_RACE, "Zwerg");
  SetProp (P_BODY, 120);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit vor Furcht zitternden Haenden", 100, DT_BLUDGEON}) );
  SetProp (P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  CLONEME (OBJ("baeckerei/semmel"));
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  ob=CLONEOB (OBJ("kapu"));
  command ("ziehe kapuze an");
  command("trage alles");
  ob->move(ME);   
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddInfo("cairn", "sagt: 'Cairn ist mein Bruder. Wenn Du irgendetwas wissen "+
	"willst, geh und frage ihn.'\n");

  AddSpell(1,300, 
    "Flark toent: 'Unheil komme ueber Dich!' Prompt durchfaehrt Dich ein fuerchterlicher Schmerz.\n",
    "Flark toent: 'Unheil komme ueber @WEN!' @WER bricht von Schmerzen durchbohrt zusammen.\n",
   DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "Flark bruellt: 'Cairn wird mich raechen!'\n",
    "Flark ruft: 'Bruder, komm und rette mich vor diesem Tyrannen hier!'\n",
    "Der Zwerg heult: 'Tyrann, elendiger!'\n"}));

  SetProp (P_DIE_MSG, " hat sein Leben beendet.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Geh und frag Cairn, der ist klug!\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Flark verbeugt sich und sagt: 'Vielen Dank fuer Eure Gabe.'\n" }) );

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle7"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
    
  SetProp(P_MSGIN, "flaniert herein");   
  SetProp(P_MSGOUT, "schlendert hinaus");

}
