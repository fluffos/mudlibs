/*
** Dummzwerg
** ---
** Oktober 1997 - Dusty
** fuer Felonia
*/

inherit "std/mnpc";
inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"monster", "zwerg"}));
  AddAdjective( ({"spinnender", "spinnenden"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Zwerg");
  SetProp (P_SHORT, "Ein spinnender Zwerg");
  SetProp (P_LONG, bs("Ein durchschnittlicher Zwerg. Er hat "+
	"den ganzen Tag lang nichts anderes zu tun, als durch die "+
	"Zwergenstadt zu streifen und bloed zu schauen und seinen "+
	"Hobbys zu froenen."));

  create_default_npc(12);
  SetProp (P_ALIGN, 100);
  SetProp(P_SIZE, 100+random(25));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_BODY, 60);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seiner Handaxt", 70, DT_SLASH}) );
  SetProp (P_ARTICLE, 1);
  SetProp(P_HEAL, 10);
  SetProp(P_NAME_ADJ, "spinnend");
  SetProp(P_WIMPY, 30);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  CLONEME (OBJ("baeckerei/semmel"));
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  command("trage alles");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 90);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddInfo("haus", "kichert: 'Wwwwir hahaben nnoch eine gahahahanze Menge dahavon....DORT.'\n");
  AddInfo("menge", "nickt: 'Jaaaahha... wirklich viel....'\n");

  AddSpell(1,250, 
    "Der Zwerg rammt Dir den Stiel seiner Axt in den Bauch.\n",
    "Der Zwerg rammt @WEM den Stiel seiner Axt in den Bauch.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
    "Der Zwerg kichert.\n",
    "Der Zwerg grinst irr.\n"}));

  SetProp (P_DIE_MSG, " geht ins Reich der Netztoten.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Wwwwwir hahahahaben nnnnnoch eine "+
	"gagagaaagaaanze Mmmmenge davvvvvon..... hihihinten imm Hauauaus...\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Ooohh Gohhhoott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der spinnende Zwerg behaelt sich alles, was er kriegen kann.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("gang"));
  SetProp (P_MNPC_WAIT, ({ 5, 40, 80 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("baeckerei"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
      
  SetProp(P_MSGIN, "stottert herein");   
  SetProp(P_MSGOUT, "klumpt hinaus");

  AddDetail("", ""); 
}
