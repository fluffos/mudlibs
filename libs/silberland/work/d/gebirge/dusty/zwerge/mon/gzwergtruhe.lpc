/*
** Gartenzwerg
** ---
** April 2002 - Dusty
** fuer den Weg zwischen Midas und Felonia
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"
#include <new_skills.h>
#include <mnpc.h>
#include <new_skills.h>
#include <moving.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"gartenzwerg", "zwerg"}));
  AddAdjective( ({"rothutiger"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Zwerg");
  SetProp (P_SHORT, "Ein Gartenzwerg");
  SetProp (P_LONG, bs("Ein Gartenzwerg. "+
	"Er steht eigentlich nur sinnlos herum und grinst dumm. "+
	"Es ist ueblich, diese Zwerge zur Verzierung irgendwo aufzustellen."+
	"Dieses Exemplar hier schiebt eine Scheibtruhe."));

  create_default_npc(3);
  SetProp (P_ALIGN, 100);
  SetProp(P_SIZE, 40+random(25));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_BODY, 60);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit einem bloeden Grinsen", 70, DT_SLASH}) );
  SetProp (P_ARTICLE, 1);
  SetProp(P_HEAL, 5);
  SetProp(P_WIMPY, 30);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  SetProp(P_SPELLRATE,15);

  AddInfo("cairn", "sagt: 'Cairn is deajenige, der woiss, was Du net woisst.\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  AddSpell(1,100, 
    "Der Zwerg haut Dir eine auf die Ruebe.\n",
    "Der Zwerg schlaegt um sich.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


  SetChats(1, ({
    "Der Zwerg guckt irgendwas bei seiner Scheibtruhe nach.\n",
    "Der Zwerg kruemmt sein rechtes Ohr.\n"}));

  SetProp (P_DIE_MSG, " ist nicht laenger.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Ich und meine Scheibtruhe.\n");

  SetProp (P_REJECT,
          ({ REJECT_KEEP, "Der Zwerg legt das in seine Scheibtruhe.\n" }) );

  SetProp(P_MSGIN, "schiebt sich herein");   
  SetProp(P_MSGOUT, "bewegt sich hinaus");

  AddDetail("ohr", "Der Zwerg kann es kruemmen."+);
  AddDetail(({"scheibtruhe","truhe"}), "Eine bloede Scheibtruhe."+); 
 }
