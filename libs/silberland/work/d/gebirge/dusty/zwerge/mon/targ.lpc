/*
** Ein Wachzwerg namens Targ
** ---
** 14. 6. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"zwerg", "monster", "targ", "waechter", "stadtwaechter"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Targ");
  SetProp (P_SHORT, "Targ, der Stadtwaechter");
  SetProp (P_LONG, bs("Targ, der Stadtwaechter, ist Sohn von Henk. Auch er "+
	"hat die Aufgabe, die Stadt vor boesen Kreaturen zu bewahren. Er "+
	"ist ungefaehr 25 Jahre alt, hat ein reizendes Gesicht und ist mit "+
	"gut ausgebildeter Muskulatur ausgestattet.\n"));

  create_default_npc(21);
  SetProp (P_ALIGN, 500);
//  SetProp (P_LEVEL, 19);
  SetProp (P_SIZE, 130);
  SetProp (P_RACE, "Zwerg"); 
//  SetProp (P_MAX_HP, 500);
//  SetProp (P_MAX_SP, 250);
//  SetProp (P_XP, 500000);
//  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_ARTICLE, 0);
  SetProp (P_HANDS, ({" mit seiner Handaxt ", 170, DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("zkaxt"));
  command ("zuecke axt");
  if( random(2) ) CLONEME ("/p/armour/bracers/kettenzeug");
  switch( random(4) )
  {
    case 0: CLONEME (OBJ("zpanzer")); break;
    case 1: CLONEME( "/p/armour/armour/kettenhemd"); break;
    case 2: CLONEME ("/d/gebirge/angrox/obj/kettenhemd"); break;
  }
  command("trage alles");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 54);
  ob->move(ME);

  SetProp(P_SPELLRATE,30);

  AddSpell(1,300, 
    "Targ verwuenscht Deinen miesen Charakter.\n",
    "Targ verwuenscht @WESSEN Charakter.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "Targ schreit: 'Haaaaaaaaaaaaaaahhhhhhh!!!'\n",
    "Targ grummelt einen Fluch in sich hinein.\n"}));

  SetProp (P_DIE_MSG, " flucht ordinaer und stirbt.\n");
  SetProp (P_DEFAULT_INFO, "sagt: 'Frage Henk, der weiss alles!'\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Targ knickst und laechelt verlegen.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("gang"));                     
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));                  
  SetProp (P_MNPC_DEFAULTROOM, ROOM("gang01"));             
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);           

  SetProp(P_MSGIN, "waechtert herein");      
  SetProp(P_MSGOUT, "wappelt");
}
