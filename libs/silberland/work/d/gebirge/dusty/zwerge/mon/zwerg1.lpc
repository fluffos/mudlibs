/*
** Dummzwerg
** ---
** Oktober 1997 - Dusty
** fuer Felonia
*/

inherit "std/mnpc";
inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"monster", "zwerg"}));
  AddAdjective( ({"gelangweilter", "gelangweilten"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Zwerg");
  SetProp (P_SHORT, "Ein gelangweilter Zwerg");
  SetProp (P_LONG, bs("Das ist ein durchschnittlicher Zwerg. Er hat "+
	"den ganzen Tag lang nichts anderes zu tun, als durch die "+
	"Zwergenstadt zu streifen und bloed zu schauen."));

  create_default_npc(11);
  SetProp (P_ALIGN, 100);
  SetProp(P_SIZE, 100+random(25));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_BODY, 60);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seiner Handaxt", 70, DT_SLASH}) );
  SetProp (P_ARTICLE, 1);
  SetProp(P_HEAL, 10);
  SetProp(P_NAME_ADJ, "gelangweilt");
  SetProp(P_WIMPY, 30);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  command("trage alles");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddInfo("cairn", "sagt: 'Cairn is deajenige, der woiss, was Du net woisst.\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  AddSpell(1,250, 
    "Der Zwerg trifft Dich ziemlich genau zwischen den Augen.\n",
    "Der Zwerg trifft @WEN ziemlich genau zwischen den Augen.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
    "Der Zwerg bohrt in der Nase.\n",
    "Der Zwerg grinst gelangweilt ins Nichts.\n"}));

  SetProp (P_DIE_MSG, " schreit das letzte Mal laut auf.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Frag Cairn, den Boeszwerg, nicht mich.\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Zwerg steckt sich das Ding ein.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("gang"));
  SetProp (P_MNPC_WAIT, ({ 5, 40, 80 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("gang01"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
      
  SetProp(P_MSGIN, "schlonzt herein");   
  SetProp(P_MSGOUT, "kapert hinaus");

 AddDetail("gesicht", "Das Gesicht des Zwerges ist genauso uninteressant "+
	"wie alles andere an ihm.");

}
