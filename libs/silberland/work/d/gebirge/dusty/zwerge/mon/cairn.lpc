/*
** Cairn, ein junger Boeszwerg
** ---
** 10. 5. 1996 - Dusty
** fuer die Zwergenstadt
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "cairn"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Cairn");
  SetProp (P_SHORT, "Cairn, ein junger Boeszwerg");
  SetProp (P_LONG, bs("Cairn, ein noch ziemlich junger Boeszwerg. Er hat die "+
	"Gunst der Hoechsten verspielt, als er versucht hat, wertvolles Erz "+
	"beiseite zu schaffen, um sich daran zu bereichern. Cairn hat jedoch "+
	"ein liebes und ehrliches Gesicht. Vielleicht wird er seine Tat "+
	"bereuen und somit wieder in die Zwergenstadt eingelassen werden."));

  SetProp(P_ARTICLE, 0);
  SetProp (P_ALIGN, -100);
  create_default_npc(17);
//  SetProp (P_LEVEL,17);
//  SetProp (P_MAX_HP, 300);
//  SetProp (P_MAX_SP, 300);
//  SetProp (P_XP, 300000);
  SetProp (P_BODY, 150);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit von schwerer Arbeit gekennzeichneten Haenden", 200, DT_BLUDGEON}) );
  SetProp (P_SIZE, 118);
  SetProp(P_RACE, "Zwerg");
  set_living_name("cairn");
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("handaxt"));
  command ("zuecke handaxt");
  ob=CLONEOB (OBJ("kapu"));
  ob->move(ME);
  ob->SetProp (P_KAPFARBE, 2);
  command ("ziehe kapuze an");
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  CLONEME (OBJ("khose"));
  command ("ziehe hose an");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 200);
  ob->move(ME);

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Cairn seufzt: 'Als ich noch ein kleines Kind war, war das schoen!'\n",
	"Cairn kniet nieder und haelt eine kleine Andacht.\n",
	"Cairn ueberlegt: 'Hm. Wenn ich mich trauen wuerde, zu bereuen....'\n",
	"Cairn mustert Dich und sagt: 'Warum habe ich mich damals dazu verleiten lassen?'\n"}));

  AddInfo (({"reich", "stadt", "felonia", "zwergenstadt"}), "Felonia liegt unter der Hoehle hier. Wenn "+
        "ich doch nur wieder zurueckgehen koennte ohne mich von den Hoechsten "+
	"demuetigen zu lassen...", "sagt: ");

  AddInfo("smirk", "Smirk ist nicht gerade einer der intelligentesten "+
	"Zwerge.", "laechelt: ");

  AddInfo (({"hoechste", "hoechsten", "regent", "regenten"}), "Die Hoechsten sind die Regenten "+
	"dieser Stadt. Sie sind die oberste Gerichtsbarkeit, wer's sich mit "+	
	"Ihnen verschaetzt, riskiert Verbannung aus der Zwergenstadt. Selbst "+
	"habe ich die Hoechsten noch nie erblicken duerfen, sie regieren "+
	"fernab der Welt und lassen keinen in ihre Gemaecher.", "sagt: ");

  AddInfo (({"akt", "demut", "demuetigung", "bereuen", "reue"}), "Um seine Demut zu zeigen, "+
 	"muss man sich den Hoechsten unterwerfen und bereuen. Da keiner noch "+
	"die Hoechsten je erblicket hat, wird dieser Akt der Reue vor der "+
	"grossen Statue, dem Auge der Hoechsten begangen.", "sagt: ");

  AddInfo (({"statue", "auge"}), "Die Statue, das Auge der "+
	"Hoechsten, ist unten in der Zwergenstadt. Sie ist allerdings in einem nur "+
	"fuer uns Boeszwerge betretbarem Raum, was bedeutet, dass Leute wie "+
	"Du sie nie zu Gesicht bekommen werden.", "fluestert: ");

  AddInfo (({"hoehle", "hoehlen"}), "Diese Hoehle hier ist das "+
	"Gebiet der Verbannung fuer uns Boeszwerge.", "murmelt: ");

  AddInfo (({"verbannung", "boeszwerge", "boeszwergen", "bannung"}), "Wir "+
	"Boeszwerge haben allesamt nur eines miteinander: Wir sind Verbannte "+
	"Felonias, denn wir haben ein Verbrechen begangen, dass die Hoechsten "+
	"fuer intolerabel erklaert haben.", "erzaehlt: ");

  AddInfo ("flark", "Flark ist mein Bruder. Der Grund seiner "+
	"Verbannung ist mir nicht bekannt. Aber ich bin mir sicher, es "+
	"kann kein schweres Vergehen gewesen sein, denn er ist sanft "+
	"und friedliebend.", "laechelt: ");

  AddInfo ("henk", "Henk ist der Wachzwerg von Felonia. Er hat "+
	"den Hoechsten lange Jahre treue Dienste geleistet, und freut sich "+
	"auf seine wohlverdiente Pension. Er hat sein Leben lang nur gute "+
	"Taten vollbracht.", "erzaehlt: ");
  
  AddInfo("kral", "Kral ist der aelteste unter uns. Er ist sicher ueber "+
	"hundert Jahre alt. Selten werden die Alten von den Hoechsten "+
	"verstossen.", "sagt: ");

  AddInfo ("cewl", "Cewl ist erst vor kurzem zu uns gestossen. "+
	"Ueber seine Geschichte kann ich Dir nix erzaehlen, weil ich selber "
 	"noch keine Zeit gehabt habe, ihm zuzuhoeren.", "sagt: ");

  AddInfo ("jahn", "Jahn hat gegen das Verbot des Widerspruchs "+
	"den Hoechsten gegenueber verstossen, was die Hoechsten als "+
	"unverzeihlich empfunden haben.", "seufzt: ");

  AddInfo("ragh", "Ragh ist ein boeser "+
	"Kerl, er ist gewalttaetig! Er hat einige Bewohner der Zwergenstadt "+
	"koerperlich angegriffen! Seht Euch vor, wenn er Euch begegnet!'", 
	"beginnt zu zittern und fluestert: ");

  AddInfo(({"leute", "leuten", "zwerg", "zwerge", "zwergen", "einwohner", "einwohnern"}), "Unter Dir liegt Felonia, das "+
	"Reich der Zwerge. Die Einwohner dieser Stadt sind gemuetliche "+
	"Leute, passe Dich ihrem Lebensstil an!", "sagt: ");

  AddInfo(({"stil", "lebensstil"}), "Die Zwerge fuehren einen angenehmen "+
	"Lebensstil.", "sagt: ");

  AddInfo(({"kind", "kinder", "kindern", "kindheit"}), "Damals, als Flark und ich "+
	"noch Kinder waren, das waren schoene Zeiten!", "erinnert sich: ");

  AddInfo(({"erz", "erzen", "erze"}), "Das Erz ist die "+
	"Wurzel alles Ueblen. Waere es nicht so verfuehrerisch gewesen, koennte "+
	"ich in Frieden in Felonia leben.", "sagt betruebt: ");

  AddInfo(({"elfe", "elfen", "elf", "halbzwoelf"}), "Also bitte. DIE "+
	"interessieren mich nun wirklich nicht mit ihrem ewigen Gesinge und "+
	"Gefeiere. Ich hab ganz anderes zu denken.", "sagt erzuernt: ");

  AddInfo(({"lebensunterhalt", "unterhalt", "beschaeftigung", "anderes", "arbeit"}), 
	"Jeder muss "+
	"sich seinen Lebensunterhalt verdienen. Die einen so, die anderen "+
	"anders.", "sagt: ");

  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");
  
  AddSpell(1,500, 
    "Cairn murmelt etwas von 'Felonia' und 'Reue'.\n",
    "Cairn leitet seinen Jammer auf @WEN ab.\n",
   DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "Lass mich in Ruh, siehst Du nicht, dass ich eigene Probleme hab?\n",
    "Cairn wischt sich eine Traene aus dem Augenwinkel.\n"}));

  SetProp (P_DIE_MSG, " stirbt ob dieser ruchlosen Tat.\n");
  SetProp (P_DEFAULT_INFO, "fluestert: 'Tut mir leid, dass weiss ich nicht.'\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
   	"Cairn fluestert Dir zu: \n'Danke, aber ich als Boeszwerg habe Deine "+
	"Guete nicht verdient.'\n"}));

  SetProp (P_MNPC_AREA, ROOM("hoehle"));                     
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));                  
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle4"));             
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);           

  SetProp(P_MSGIN, "trottet verlegen herein");      
  SetProp(P_MSGOUT, "verdrueckt sich");                
                                                           


}
