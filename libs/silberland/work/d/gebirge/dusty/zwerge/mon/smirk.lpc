/*
** Smirk, ein Boeszwerg
** ---
** April 1997 - Dusty
** fuer die Zwergenhoehle
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "smirk"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Smirk");
  SetProp (P_SHORT, "Smirk, ein Boeszwerg");
  SetProp (P_LONG, bs("Das ist Smirk. Er grinst uebers ganze Gesicht "+
	"und schaut Dich mit grossen Glotzaugen eigentlich ziemlich "+
	"bloed an. Dich wundert, dass die Hoechsten, (wer immer "+
	"sie auch sein moegen), einen dermassigen Deppen nicht fuer "+
	"ihre eigenen boesen Zwecke missbraucht haben."));

  create_default_npc(18);
  SetProp (P_ALIGN, 100);
//  SetProp (P_LEVEL, 14);
//  SetProp (P_MAX_HP, 330);
//  SetProp (P_MAX_SP, 300);
//  SetProp (P_XP, 250000);
  SetProp(P_SIZE, 133);
  SetProp(P_RACE, "Zwerg");
//  SetProp (P_BODY, 120);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinem Stock", 170, DT_SLASH}) );
  SetProp (P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("stock"));
  command ("zuecke stock");
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  ob=CLONEOB (OBJ("kapu"));
  ob->SetProp (P_KAPFARBE, 6);
  command ("ziehe kapuze an");
  command("trage alles");
  ob->move(ME);   
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddInfo("cairn", "sagt: 'Cairn is deajenige, der woiss, was Du net woisst.\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  AddSpell(1,300, 
    "Smirk ueberlaesst Dir einen Teil seiner Dummheit.\n",
    "Smirk grinst harmlos.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  SetChats(4, ({
    "Smirk stolpert ueber seine eigenen Fuesse.\n",
    "Smirk springt Dir an den Hals und wuergt Dich.\n",
    "Smirk sagt: 1 und 1 sind doch 3, oder?\n"}));

  SetProp (P_DIE_MSG, " scheidet dahin.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Cairn fragen, nicht mich.\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Smirk ist zu dumm und laesst Deine Gabe auf den Boden fallen.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle9"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
    
  SetProp(P_MSGIN, "kriecht herein");   
  SetProp(P_MSGOUT, "stolpert hinaus");

}
