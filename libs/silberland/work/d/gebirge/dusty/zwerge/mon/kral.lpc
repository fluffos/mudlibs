/*
** Kral, ein Boeszwerg
** ---
** April 1997 - Dusty
** fuer die Zwergenhoehle
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#include <mnpc.h>
#include <new_skills.h>

#define P_KAPFARBE "kapfarbe"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"boeszwerg", "zwerg", "monster", "kral"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Kral");
  SetProp (P_SHORT, "Kral, ein Boeszwerg");
  SetProp (P_LONG, bs("Das ist Kral. Er hat langes braunes Haar, ziemlich "+
	"ungwoehnlich fuer einen Zwerg in seinem Alter, denn er sieht so "+
	"an die 100 Jahre alt aus. Sein Ruecken ist etwas gekruemmt. "+
	"Irgendwie koennte man ihn fuer einen zwergischen Merlin halten."));

 AddDetail(({"haar", "haare"}),
	bs("Seine Haare sind lang und braun. Ungewoehnlich fuer einen Zwerg "+
	"in seinem Alter!"));

 AddDetail(({"alter"}), "Mindestens 100 Jahre alt ist er sicher!");
 
 AddDetail(({"ruecken"}),
	bs("Sein Ruecken ist ziemlich gekruemmt. Er duerfte frueher "
	"schwer gearbeitet haben."));

  create_default_npc(14);
  SetProp (P_ALIGN, 300);
//  SetProp (P_LEVEL, 13);
//  SetProp (P_MAX_HP, 200);
//  SetProp (P_MAX_SP, 150);
//  SetProp (P_XP, 150000);
  SetProp(P_SIZE, 129);
  SetProp(P_RACE, "Zwerg");
  SetProp (P_BODY, 100);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit blossen Haenden", 130, DT_BLUDGEON}) );
  SetProp (P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4,  
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );

  SUID;

  // Ausruestung
  CLONEME (OBJ("sanda"));
  command ("ziehe sandalen an");
  CLONEME (OBJ("zhose"));
  command ("ziehe hose an");
  ob=CLONEOB (OBJ("kapu"));
  ob->SetProp (P_KAPFARBE, 7);
  command ("ziehe kapuze an");
  command("trage alles");
  ob->move(ME);   
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddInfo("merlin", "sagt: 'Ich bin nicht Merlin!!\n");
  AddInfo( ({"zwergenstahl"}),
          "Da fragst Du besser einen Bergwerksarbeiter", "sagt: ");

  AddSpell(1,300, 
    "Kral bewirft Dich mit einem zwergischen Zauber.\n",
    "Kral bewirft @WEN mit einem zwergischen Zauberspruechlein.\n",
   DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(4, ({
    "Kral wachelt mit seinen Haenden in der Luft.\n",
    "Kral verzieht geheimnisvoll sein Gesicht.\n",
    "Kral versinkt tief in Gedanken und beschwoert Unheil herauf.\n"}));

  SetProp (P_DIE_MSG, " bricht tot zusammen.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Bin ich Merlin? Nein, also muss ich solche Sachen auch nicht wissen!\n");
  AddInfo (({"dusty", "woody"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Kral nickt Dir zu und behaelt Dein Geschenk.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("hoehle"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("hoehle8"));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
    
  SetProp(P_MSGIN, "marschiert herein");   
  SetProp(P_MSGOUT, "wandert hinaus");

}
