inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Norden "+
	"scheint einmal ein Lokal gewesen zu sein. Nur ein Schild kannst "+
	"Du noch entdecken. Die Hoehle breitet sich nach Westen, Osten "+
	"und Sueden aus."));

  AddDetail( ({ "eingang" }), 
                break_string( "Ueber dem ehemaligen Eingang haengt ein "+
                "Schild.", 78 ) );
  AddDetail( ({ "stock", "tuerstock", "tuer" }), 
                break_string( "Hier war scheinbar mal ein Eingang.", 78 ) );
  AddDetail( ({ "mauer", "steinmauer", "wand" }), 
                break_string( "Im Norden befindet sich eine Steinmauer. Du "+
                "kannst einen zugemauerten Tuerstock entdecken, hier scheint "+
                "einmal etwas gewesen zu sein.", 78 ) );
  AddDetail( ({ "lokal" }), 
                break_string( "Hier scheint mal ein Lokal gewesen zu sein.", 78 ) );
  AddDetail( ({ "schild" }),
	"Du kannst es lesen.\n");

  AddReadDetail("schild", "Auf dem Schild steht: 'Umgezogen.'\n");

  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               

  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                  
                "Du malst gelangweilt einige Kreise in den Staub.\n"); 

 AddExit("westen", ROOM("hoehle10"));
 AddExit("osten", ROOM("hoehle12"));
 AddExit("sueden", ROOM("hoehle8"));
}
