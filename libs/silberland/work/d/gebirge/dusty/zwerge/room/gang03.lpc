inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem breiten Gang der Zwergenstadt. Es "+
        "scheint, dass die ganze Zwergenstadt in den Berg hineingekarvt "+
        "wurde, was auch typisch fuer die zwergische Natur zu sein "+
        "scheint. Fackeln beleuchten die Waende, und Du fuehlst Dich hier "+
        "richtig daheim, auch wenn das vielleicht auch gar nicht Dein Zuhause ist."));

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "zwergenstadt", "stadt" }), 
                break_string( "Du stehst scheinbar in ihr!", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern", "halter" }),
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }),
                break_string( "Sie lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "boden", "waende", "wand" }),
                break_string( "Besteht aus grauem, uninteressantem Stein, "+
                "an den Waenden erhellen Fackeln die finstere Umgebung.", 78) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail(  ({"kreis", "kreise"}), "Jemand hat Kreise in den Staub gemalt.\n");
  AddDetail( ({ "gang" }),
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
 
 AddItem (NPC("zwerg"), REFRESH_DESTRUCT);

 AddExit("westen", ROOM("gang04"));
 AddExit("osten", ROOM("gang02"));
 AddExit("norden", ROOM("gang08"));
 AddExit("sueden", "/d/kristallwald/chivas/zwergenfeste/room/zwfefelonia");
}
