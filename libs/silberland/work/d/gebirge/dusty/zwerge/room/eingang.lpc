inherit "std/room";

#include  <properties.h>
#include "../files.h"

create()
{
::create();

 SetProp(P_LIGHT, 0);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Im Schlund");
 SetProp(P_INT_LONG, bs ("Du stehst - trotz all Deiner Bedenken - im "+
	"Schlund, der in das Innere des Berges fuehrt. Es ist wirklich "+
	"etwas duester hier, pass bloss auf, dass Du Dir die Nase nicht "+
	"anhaust! Hier scheint so ziemlich alles aus Stein zu sein."));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));

  AddDetail( ({ "lichtquelle", "quelle" }), 
                break_string( "Hm. Koennte eine Fackel sein, koennte auch "+
                "was andres sein.", 78 ) );
  AddDetail( ({ "schemen" }), 
                break_string( "Hier in diesem Halbdunkel laesst sich "+
                "eigentlich alles nur schemenhaft entdecken.", 78 ) );
  AddDetail( ({ "finsternis" }), 
                break_string( "Ziemlich dunkel.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Hmja... du kannst sie in dieser Finsternis "+
                "trotz deiner Lichtquelle nur schemenhaft erkennen.", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Steinwaende. Bestehen alle 2 aus Stein.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Ein Steinboden. Besteht aus Stein.", 78 ) );
  AddDetail( ({ "stein", "felsen" }), 
                break_string( "Der Berg besteht aus Stein, auch Felsen "+
                "genannt.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Der Berg ist finster und wirkt bedrohlich, "+
                "auch von innen.", 78 ) );
  AddDetail( ({ "nase" }), 
                break_string( "Nicht anhauen, hoerst Du?", 78 ) );
  AddDetail( ({ "schlund" }), 
                break_string( "Der Schlund ist stockfinster und unheimlich.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                       
                "Du malst gelangweilt einige Kreise in den Staub.\n");       
                                                                             
 AddRoomMessage ( ({
	"Unheimliches Grollen toent aus der Finsternis.\n",
	"Du glaubst, leichte Erschuetterungen wahrzunehmen.\n"}), 30 );

 AddSmell(DEFAULT_SMELL, bs ("Es riecht nach abgestander Luft und drohendem "+
	"Unheil."));

 AddSmell(({"nackenhaare", "haare"}), bs("Du koenntest Dich ruhig mal wieder "+
	"waschen!"));

 AddSmell(({"luft", "geruch"}), bs("Du waerest froh, wenn es hier besser "+
	"riechen wuerde. Ausserdem riecht es ziemlich nach Unheil."));
 AddSmell(({"unheil", "drohendem unheil"}), bs("Deine Nackenhaare stellen "+
	"sich auf. Ob es gut ist, tiefer in den Berg vorzudringen?")); 

 AddSound(DEFAULT_SOUND, bs("Du hoerst ein grummeliges Grollen aus dem "+
	"Berginneren."));

 AddSound(({"grollen", "grummeln", "geraeusche", "geraeusch"}), bs("Es "+
	"kommt aus dem Berginneren. Du kannst den Ursprung nicht naeher "+
	"bestimmen. Zauberei vielleicht?"));

 AddExit("norden", ROOM("eingang2"));
 AddExit("sueden", WEG("l23"));



}
