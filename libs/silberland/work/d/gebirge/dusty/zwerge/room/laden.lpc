inherit "std/laden";

#include "../files.h"
#include <properties.h>
#include <player.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "In einem Zwergenladen");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im Laden der Zwerge. Wie der Name schon sagt, kannst "
	     "Du hier Sachen kaufen und verkaufen. Du siehst ziemlich viel "
	     "Zeug herumliegen, das der Besitzer irgendwann einmal im "
	     "Sammelwahn gekauft haben muss. Hinter der Budl steht ein "
	     "kleiner Zwerg, der einen weissen Mantel traegt. Wenn Du sehen "
	     "willst, was hier im Angebot ist, gib 'zeige' ein."));
  
  SetStorageRoom(ROOM("lager"));

  AddDetail( ({ "haendler" }), 
                break_string( "Der Haendler ist ein Zwerg. Ueberrascht? :)", 78 ) );
  AddDetail(({"besitzer"}), 
	    "Besitzer scheint hier der Zwerg zu sein. Zumindest glaubst "
	    "Du es, weil warum sollte er Dich denn dann so freundlich "
	    "anlaecheln?");

  AddDetail(({"latten"}), 
	    "Die Holzlatten sind schoen gearbeitet.");

  AddDetail(({"stein"}), 
	    "Die Decke ist aus Stein, zum Beispiel.");

  AddDetail(({"decke"}), 
	    "Die Decke ist aus Stein.");

  AddDetail(({"angebot"}), 
	    "Wenn Du sehen willst, was im Angebot ist, gib 'zeige' ein.");

  AddDetail(({"zeug","zeugs"}), 
	    "Hier liegt entsetzlich viel nutzloses Zeug herum.");

  AddDetail(({"laden"}), 
	    "Du stehst darin.");

  AddDetail(({"sammelwahn"}), 
	    "Der Besitzer scheint ihn zu haben.");

  AddDetail(({"regal","regale"}), 
	    "Die Regale sind im Moment ziemlich leer.");

  AddDetail(({"wand","waende"}), 
	    "An der Wand sind Regale, in denen man Sachen aufbewahren kann. "
	    "Sie sind allerdings im Moment ziemlich leer.");

  AddDetail(({"mantel"}), 
	    "Den hat der Zwerg hinter der Budl an.");

  AddDetail(({"holz","holzlatten"}), 
	    "Die Holzlatten sind schoen gearbeitet.");

  AddDetail(({"boden"}), 
	    "Hier besteht der Boden nicht aus Stein, sondern aus Holzlatten.");

  AddDetail(({"zwerg"}), 
	    "Der Zwerg hat einen weissen Mantel an. Er laechelt Dich hoeflich "
	    "an.");

  AddDetail(({"budl","theke"}), 
	    "Die Budl, auch Theke genannt, ist nur ungefaehr 50 cm hoch, da "
	    "sie ja fuer Zwerge gebaut ist.");

  AddDetail(({"sachen","klump"}), 
	    "Ziemlich viel Klump liegt hier herum.");

  AddDetail(({"staub","staubschicht","schicht"}),
	    "Du malst gelangweilt einige Kreise in den Staub.");

  // entfernt 10.12. von Zordan
  // AddItem("d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);

  AddExit("sueden", ROOM("gang08"));
}
