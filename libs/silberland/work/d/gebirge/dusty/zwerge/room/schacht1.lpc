inherit "std/room";

#include <properties.h>
#include "../files.h"

create()

{

::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Im Schacht");
 SetProp(P_INT_LONG, bs( "Du stehst offensichtlich in einem Verbindungsschacht, "+
	"der allerdings auch nur aus dem Stein herausgehauen zu sein scheint. "+
	"Unter Dir jedoch kannst Du einen hellen Schein entdecken."));

  AddDetail( ({ "spuren" }), 
                break_string( "Lebewesen haben durch diese Klettersprossen "+
                "ihre Spuren hinterlassen, denn von alleine haetten sich die "+
                "Sprossen sicherlich nicht in den Schacht treiben lassen.", 78 ) );
  AddDetail( ({ "zweifel" }), 
                break_string( "Hast Du welche? :)", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden scheint tief unten zu sein.", 78 ) );
  AddDetail( ({ "waende", "wand" }), 
                break_string( "Der Schacht hat eigentlich nur eine einzige "+
                "Wand, die sich im Kreis um Dich herumzieht.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Die Hoehle befindet sich ueber Dir.", 78 ) );
  AddDetail( ({ "durchmesser" }), 
                break_string( "Damit kannst Du sicher nichts schneiden.", 78 ) );
  AddDetail( ({ "schacht", "verbindungsschacht" }), 
                break_string( "Der Schacht hat ungefaehr 2 Meter im "+
                "Durchmesser.", 78 ) );
  AddDetail( ({ "leben", "lebewesen" }), 
                break_string( "Unten am Ende des Schachtes scheint Leben zu "+
                "sein.", 78 ) );
  AddDetail( ({ "klettersprossen", "sprossen" }), 
                break_string( "Sie ziehen sich durch den ganzen Schacht. "+
                "Wie sonst sollte man ihn denn hinauf/hinunter kommen?", 78 ) );
  AddDetail( ({ "schein", "schimmer", "lichtschimmer" }), 
                break_string( "Von unten kommt ein Lichtschimmer, dort ist ohne "+
                "Zweifel Leben!", 78 ) );
  AddDetail( ({ "stein", "wand" }), 
                break_string( "Der runde Schacht, den du gerade "+
                "hinunterkletterst, besteht auch nur aus Stein. Allerdings "+
                "sind hier eindeutige Spuren von Lebewesen zu sehen, denn wo "+
                "sollten sonst die Klettersprossen herkommen?", 78 ) );
   AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");

 AddExit("oben", ROOM("nische"));
 AddExit("unten", ROOM("schacht2"));
}
