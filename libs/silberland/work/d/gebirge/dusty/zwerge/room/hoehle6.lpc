inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Osten "+
 	"befindet sich eine kalte Steinmauer, die aber ueberraschenderweise "+
        "weder feucht noch unheimlich ist. Du fuehlst Dich (trotz der Dunkelheit) "+
        "geborgen und sicher."));

  AddDetail( ({ "wand", "steinwand", "waende", 
                "mauern", "steinmauern", "mauer", 
                "steinmauer", "steinwaende" }), 
                break_string( "Im Osten befindet sich eine Steinmauer, sie "+
                "ist trocken und kuehl.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               

  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddItem(NPC("ragh"), REFRESH_DESTRUCT);

 AddExit("sueden", ROOM("hoehle3"));
 AddExit("norden", ROOM("hoehle9"));
 AddExit("westen", ROOM("hoehle5"));

}
