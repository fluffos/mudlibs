inherit "std/room";

#include <properties.h>
#include "../files.h"
#include <defines.h>
#include <moving.h>

int cloned;

create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Weg in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem weiteren Gang. Hier sind die "+
	"Wohnungen der Zwergenseher. Im Osten ist Krigis Zuhause, im Westen "+
	"liegt Eberharts Wohnung. Auch ein "+
	"Schild kannst Du erkennen, es liegt am Boden.\n"));

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17]));
 
  AddDetail( ({ "fackel" }), 
                break_string( "Hier leuchten Fackeln den Sehern den Weg zu "+
                "ihren Wohnungen.", 78 ) );
  AddDetail( ({ "fackeln" }), 
                break_string( "Hier leuchten Fackeln den Sehern den Weg zu "+
                "ihren Wohnungen.", 78 ) );
  AddDetail( ({ "zuhause" }), 
                break_string( "Im Osten ist Krigi zuhause.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "zwergenseher", "zwerg", "seher" }), 
                break_string( "Wenn Du ein/e Zwergenseher/in bist, bist Du "+
                "hier ganz richtig!", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "An den Waenden erhellen Fackeln die "+
                "Umgebung. Du siehst ein Schild, dass halbvergraben im Staub "+
                "liegt.", 78 ) );
  AddDetail("schild", "Du kannst es lesen.\n");
	
  AddReadDetail("schild",
                break_string( "Auf dem Schild steht: 'Wenn Du Zwerg/in und "+
                "Seher/in bist, und eine eigene Wohnung haben willst, dann "+
                "wende Dich an Dusty.'", 78 ) );
  AddDetail( ({ "wohnung", "wohnungen" }), 
                break_string( "Die sollen hier mal entstehen, sobald sich "+
                "Interessenten bei Dusty melden.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Besteht aus grauem, uninteressantem Stein. "
                  "Auffaellig sind nur zwei Loecher, "+
                "an den Waenden erhellen Fackeln die Umgebung. Auf dem "+
		"Boden liegt ein Schild.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),
                "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );

  AddDetail( ({"loecher", "loch"}),
	"Das westliche Loch sieht verheissungsvoll aus, "+
	"das oestliche Loch scheint uninteressant zu sein - vielleicht.\n");

  AddDetail(({"ostenloch", "oestliches loch"}),
	"Du koenntest mal hineinfassen!\n");

  AddDetail(({"westenloch", "westliches loch"}),
	"Hm. Das Loch ist leer!\n");

  AddExit("norden", ROOM("gang05"));
  AddExit("sueden", ROOM("seher1"));

  AddCmd(({"fasse",  "fass"}), "fass");

cloned = 0;

}

fass (str)
{
  notify_fail("Wohin willst Du fassen??\n");

  if (str != "loch" && str != "in loch")
	return 0;

  if (cloned) {
	write("Es schaut ganz danach aus, als ob vor Dir schon jemand "+
	"zugegriffen haette.\n");
    return 1;
  }
	write("Du fasst voll Zuversicht in das Loch hinein...\n\n..."+
	"und schwupp...\n\n...Du ziehst ein Sackerl aus dem Loch heraus!\n");


 clone_object(OBJ("sackerl"))->move(TP), M_GET;
 TK("Sackerl gecloned!\n");
 cloned++;
 return 1;
      
}  
 
        
reset()
{ 
  ::reset();
  cloned=0;
}
