inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Der Gang fuehrt nach Norden, Osten und Sueden "+
        "weiter. Aus dem Norden riecht es irgendwie nach Kapelle. "
	"An der Westwand sind Fackelhalter angebracht, die mit ihrem Inhalt "+
	"die Umgebung lustig flackernd erhellen."));

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));

  AddDetail( ({ "umgebung" }), 
                break_string( "Sie wird von Fackeln erhellt.", 78 ) );
  AddDetail( ({ "westwand" }), 
                break_string( "An der Westwand sind Fackelhalter angebracht.", 78 ) );
  AddDetail( ({ "inhalt" }), 
                break_string( "Fackeln natuerlich! :)", 78 ) );
  AddDetail( ({ "kapelle" }), 
                break_string( "Es riecht im Norden so, als ob dort eine "+
                "Kapelle waere.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "zwergenstadt", "stadt" }), 
                break_string( "Du stehst scheinbar in ihr.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "gang" }),
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }),
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }),
                break_string( "Sie lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "waende", "wand" }),
                bs("Die Waende aus grauem, uninteressantem Stein."));
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );

  AddDetail("boden", bs("Der Boden besteht aus Stein. Er muss schon "+
	"Jahrhunderte alt sein.\n"));

  AddSmell(DEFAULT_SMELL, bs("Im Norden riechts nach Kapelle.\n"));
  AddSmell("kapelle", bs("Riecht sehr sakral.\n"));

 AddExit("sueden", ROOM("gang05"));
 AddExit("osten", ROOM("gang09"));
 AddExit("norden", ROOM("kapelle"));

}
