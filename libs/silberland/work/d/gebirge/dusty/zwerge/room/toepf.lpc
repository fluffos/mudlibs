#include <properties.h>
#include <moving.h>
#include "../files.h"

#ifndef ROOM
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Die Toepferei");
  SetProp (P_INT_LONG,
    "Du stehst in Felonias Toepferei. Viele kleine Zwerge sind emsig an "+
    "der Arbeit. Du siehst sie auf niedlichen Hockern vor Toepferscheiben "+
    "sitzen. Nach und nach entstehen hier Teller, Toepfe, Vasen und "+
    "aehnliches, die auf einem Tischchen zum Trocknen aufgestellt werden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "decke" }), 
                break_string( "Eine simple Decke, grau.", 78 ) );
  AddDetail( ({ "gegenstaende" }), 
                break_string( "Die Zwerge fertigen Teller, Vasen, Haeferl, "+
                "Tassen und dazu passende Untertassen.", 78 ) );
  AddDetail ( ({"toepferei"}),
    "Aus Ton zaubern hier die fleissigen Zwerge allerlei Gegenstaende.");
  AddDetail ( ({"felonia"}),
    "Felonia ist die Zwergenstadt hier, tief unten im Berg.");
  AddDetail ( ({"berg", "zwergenstadt"}),
    "Hier im Berg haben die Zwerge Felonia angelegt.");
  AddDetail ( ({"arbeit"}),
    "Jaja, wer wuerde sie tun, gebe es nicht die lieben, fleissigen und "+
    "zuverlaessigen Zwerge.");
  AddDetail ( ({"zwerge"}),
    "Die kleinen Zwerge sind aeusserst fleissig.");
  AddDetail ( ({"hocker"}),
    "Auf kleinen, dreibeinigen Hockern sitzen die Zwerge und arbeiten.");
  AddDetail ( ({"scheiben", "toepferscheiben"}),
    "Diese Scheiben dienen den Zwergen dazu, die schoensten Gegenstaende "+
    "zu erstellen. Durch das Treten eines Pedales wird die Scheibe in "+
    "Bewegung gesetzt.");
  AddDetail ( ({"pedal", "pedale"}),
    "Das Pedal wird von den Zwergen staendig getreten, damit die "+
    "Toepferscheibe sich dreht und der Klumpen Ton, der darauf liegt, zu "+
    "einem Kunstwerk werden kann.");
  AddDetail ( ({"ton"}),
    "Er ist das Grundmaterial fuer alle Gegenstaende, die hier erzeugt "+
    "werden.");
  AddDetail ( ({"grundmaterial"}),
    "Das Grundmaterial fuer alles, was hier erzeugt wird, ist Ton.");
  AddDetail ( ({"boden"}),
    "Besteht aus Stein.");
  AddDetail ( ({"stein"}),
    "Hart.");
  AddDetail ( ({"bewegung"}),
    "Immer im Kreis herum.");
  AddDetail ( ({"tischchen"}),
    "Auf dem Tischchen stehen die fertig geformten Werkstuecke, die "+
    "trocknen sollen. Du erblickst auch eine Schale mit Wasser.");
  AddDetail ( ({"stuecke", "werkstuecke"}),
    "Die Werkstuecke sind (bis auf Eines) Kunstwerke.");
  AddDetail ( ({"kunstwerke"}),
    "Richtige Kunstwerke werden hier produziert!");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("gang01"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
