inherit "std/room";

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 0);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Nische");
 SetProp(P_INT_LONG, bs("Du stehst in einer Nische. Sie sieht so aus, als ob "+
	"sie kuenstlich aus dem Berg herausgeschabt wurde. Es fuehrt ein "+
	"nicht gerade kleines Loch in den Boden hinein. Was da unten wohl "+
	"sein mag?"));

  AddDetail( ({ "steine", "stein" }), 
                break_string( "Steinige Steine liegen am Boden. Nichts "+
                "interessantes dabei.", 78 ) );
  AddDetail( ({ "nische" }), 
                break_string( "Du stehst in ihr.", 78 ) );
  AddDetail( ({ "untergrund" }), 
                break_string( "Untergrund ist meistens unten.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden ist steinig. Ausserdem siehst Du "+
                "ein Loch in den Untergrund fuehren.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Der Berg besteht aus Gestein.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Die Decke, falls man das als Decke bezeichnen "+
                "kann, besteht aus Stein.", 78 ) );
  AddDetail( ({ "loch" }), 
                break_string( "Es fuehrt nach unten.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Du stehst in einer Nische im Berg.", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Bestehen aus Stein. Die Nische wurde offenbar "+
                "kuenstlich aus dem Berg herausgeschaelt.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");


 AddItem (NPC("henk"), REFRESH_DESTRUCT);

 AddExit("unten", ROOM("schacht1"));
 AddExit("sueden", WEG("m24"));

}
