inherit "std/room";  

#include "../files.h"
#include <properties.h>
#include <defines.h>


int cloned;

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Westen "+
        "befindet sich eine kalte Steinmauer, die aber "+
	"ueberraschenderweise weder feucht noch unheimlich ist. Du fuehlst "+
	"Dich (trotz der Dunkelheit) geborgen und sicher."));

  AddDetail( ({ "mauer", "steinmauer" }), 
                break_string( "Sie ist im Westen, ausserdem ist sie "+
                "staubtrocken.", 78 ) );
  AddDetail( ({ "mauer" }), 
                break_string( "Im Westen befindet sich eine Steinmauer.", 78 ) );
  AddDetail( ({ "wand" }), 
                break_string( "Im Westen befindet sich eine "+
                "Steinmauer, sie ist trocken und kuehl.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               

  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       


 AddExit("sueden", ROOM("hoehle4"));
 AddExit("osten", ROOM("hoehle8"));
 AddExit("norden", ROOM("hoehle10"));

}
