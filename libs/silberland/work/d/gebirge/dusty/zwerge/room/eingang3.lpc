inherit "std/room";

#include <properties.h>
#include "../files.h"

create()

{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp(P_INT_SHORT, "Im Schlund");
 SetProp(P_INT_LONG, bs ("Du stehst - zu Deinem Entsetzen - noch immer "+
	"im Schlund, doch Du bildest Dir ein, dass direkt vor Dir der Gang "+
	"sich erweitert. Es riecht etwas muffig hier, und Du vermisst die "+
	"frische, gesunde Luft des Gebirges."));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:11]));

  AddDetail( ({ "hoehle" }), 
                break_string( "Hmmm... koennte es sein, dass sich der Gang "+
                "im Norden zu einer Hoehle erweitert?", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Die Decke kannst Du "+
                "kaum noch entdecken.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Du bist im Inneren davon.", 78 ) );
  AddDetail( ({ "entsetzen" }), 
                break_string( "Dein Entsetzen ist ziemlich gross, denn Du "+
                "stehst noch immer hier in diesem abscheulichen Schlund.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Er scheint sich im Norden zu erweitern.", 78 ) );
  AddDetail( ({ "boden", "wand", "waende" }), 
                break_string( "Alles hier besteht aus Stein. Ist das eine "+
                "Kunst hier im Inneren des Gebirges?", 78 ) );
  AddDetail( ({ "schlund" }), 
                break_string( "Der Schlund ist noch immer finster und "+
                "unheimlich. Allerdings scheint er sich im Norden zu einer "+
                "Hoehle zu erweitern.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

 AddSmell(DEFAULT_SMELL, bs("Die Luft hier riecht ziemlich stickig. "+
	"Allerdings scheint aus dem Norden etwas frischerer Geruch "+
	"zu kommen.\n"));

 AddSmell(({"luft", "geruch"}), bs("Die Luft riecht irgendwie muffig. "+
	"Allerdings.... kommt aus dem Norden nicht doch bessere Atemluft?"));

 AddSmell(({"atemluft", "nach norden"}), bs("Ja. Du bist Dir sicher, dass "+
	"es dort besser riecht."));
 
 AddExit("sueden", ROOM("eingang2"));
 AddExit("norden", ROOM("hoehle2"));
}
