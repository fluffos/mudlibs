inherit "/std/pub";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <rooms.h>
#include <properties.h>
#include "../files.h"
#include "/gilden/bardengilde/barden_extern.h"

void create()

{
   ::create();

   SetProp(P_LIGHT, 1);

   SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

   SetProp(P_INT_SHORT,"Bier & Ribs");
   SetProp(P_INT_LONG,"Du bist in 'Bier & Ribs'.\n"+
	"Du stehst in einer netten Gaststube, ein Kellner eilt mit grossen "+
	"Tabletts von Tisch zu Tisch. Da Du im Gang stehst, bekommst Du "+
	"hin und wieder von den Kellnern einen Krug Bier in den Ruecken. "+
	"Es scheint hier eine angenehme Atmosphaere zu herrschen, die Gaeste "+
	"plaudern miteinander und schmausen Spare-Ribs.\n"+
	"Wenn Du wissen willst, was Du hier trinken kannst, tippe: 'menue'.\n");	

  AddExit("norden",ROOM("gang02"));

  AddSmell(DEFAULT_SMELL, bs("Es riecht nach Spare-Ribs, nach Erdaepfeln, "+
	"nach Bier, und nach Rauch.\n"));
  AddSmell(({"spareribs", "spare", "ribs", "ripperl", "rippen", "spare-ribs"}), bs("Die "+
	"Ripperl duften koestlich. Dir laeuft das Wasser im Munde zusammen, "+
	"Du bekommst Hunger und Durst..... Kauf Dir was dagegen!\n"));
  AddSmell(({"erdaepfel", "aepfel", "pommes"}), bs("Du wirst den Geruch "+
	"von diesen einzigartig gut riechenden Erdaepfeln NIE in Deinem "+
	"Leben vergessen koennen.\n"));
  AddSmell(({"bier", "bierchen"}), bs("Du riechst auch den Geruch von Bier "+
	"in der Luft. Dein Gusto steigt langsam ins Unhaltbare.\n"));
  AddSmell(({"rauch", "gestank"}), bs("Der Rauch von den Pfeifen der "+
	"Zwerge steigt Dir in die Augen. Gottseidank gibt es hier wenigstens "+
	"eine Klimaanlage, also kannst Du es gerade noch ertragen.\n"));
  AddSmell(({"pfeife", "pfeifen"}), "Die Pfeifen stinken nach Rauch, komisch, nicht wahr?\n");
  AddSound("gemurmel", "Du hoerst undefinierbares Gemurmel.\n");
  AddSound(DEFAULT_SOUND, "Du hoerst nur Gemurmel, nichts Besonderes.\n");

  AddFood("Kleine Ripperl", ({"kleine", "kleine ripperl", "rippchen", "ripperln"}),
	400,({70,65}),18,
	({"Der Kellner kommt mit einem ziemlich grossen Holzbrett, Du findest darauf die koestlichsten Ripperl, die Du je gegessen hast.",
	"Der Kellner bringt && kleine Ripperl, die allerdings ziemlich gross und vor allem nach viel aussehen."}));

  AddFood("Grosse Ripperl", ({"grosse", "grosse ripperl", "ripperl", "ripperls"}),
	700,({90,80}),21,
	({"Der Kellner schleppt ein ziemlich grosses Holzstueck mit "+
	"offensichtlicher Anstrengung heran. Als Du siehst was darauf "+
	"liegt, bist Du Dir sicher, dass Du von diesem Essen satt werden wirst.",
	"&& wird ein riesiges Holzbrett mit riesig aussehenden Rippchen "+
	"serviert - ob &! das je schaffen wird?"}));

  AddFood("Erdaepfel", ({"aepfel", "erdaepfel", "pommes"}),
	130,({20,10}),5,
	({"Du bekommst eine Portion in Viertel geschnittene Erdaepfel, "+
	"die besser sind, als alle Pommes, die Du bisher gegessen hast.",
	"&& bekommt eine Portion gebratener Erdaepfel, die dampfen und "+
	"einen tollen Geruch verbreiten.\n"}));

  AddDrink("Tipfer Urtyp", ({"tipfer urtyp", "urtyp", "tipfer"}),
	117, 21,2,4, "urtyp_trinken");
    
  AddDrink("Zwickerl Bier", ({"zwickerl", "zwickerl bier", "bier"}),
	58,({21,15,5}),5,3,
	({"Das naturtruebe Bierchen kommt gut, Du!",
	"&& bekommt ein Zwickerl Bier, welches &! mit Haut und Haaren (hat ein Bier sowas?) hinunterstuerzt."}));

  AddDrink("Kaisermischer", ({"mischer", "kaiser", "kaisermischer"}),
	123,({10,33,3}),3,4,
	({"Doppelmalz - zur Haelfte gemischt mit hellem Bier - das zischt!",
	"&& bekommt den Kaisermischer, was &! kraeftig aufzumischen scheint."}));

  AddDrink("Kaiserdopplermalz", ({"kaiser", "kaiserdoppler", "doppler", "dopplermalz", "kaiserdopplermalz", "malz"}),
	222,21,2,2,
	({"Malzig dunkles silberlaendisches Spezialbier. Goettlich!",
	"&& bekommt ein Kaiserdopplermalz, ein dunkles Spezialbier."}));

  AddDrink("Franz-Josef-Bier", ({"franz", "josef", "franzjosefbier", "franzjosef", "franz-josef-bier"}),
	180,({20,23,5}),0,9,
	({"Alkoholfreies Franz-Josef-Bier, DAS macht Dich zum Kaiser!",
	"&& schuettet ein alkoholfreies Bier in sich hinein und ruelpst unanstaendig."}));

  AddDetail( ({ "pfeifen" }), 
                break_string( "Stinkende Pfeifen haben die manche Zwerge im "+
                "Mund. ", 78 ) );
  AddDetail( ({ "sessel", "stuehle" }), 
                break_string( "Die gibts hier auch. Viele Zwerge sitzen "+
                "drauf.", 78 ) );
  AddDetail( ({ "bretter" }), 
                break_string( "Holzstuecke, Bretter. Ja, sowas halt!", 78 ) );
  AddDetail( ({ "berichte", "poster" }), 
                break_string( "Alles ueber den Chef des Lokals.", 78 ) );
  AddDetail( ({ "waende" }), 
                break_string( "Unauffaellige weisse Waende, an einer haengt aber was.", 78 ) );
  AddDetail( ({ "bier" }), 
                break_string( "Viel Bier fliesst hier.", 78 ) );
  AddDetail( ({ "holzstuecke", "holzstueck", "stueck", "stuecke" }), 
                break_string( "Das sind die Bretter, auf denen wohl die "+
                "Spare-Ribs serviert werden.", 78 ) );
  AddDetail( ({ "hand" }), 
                break_string( "Ja, die Hand des Kellners bedient hier die "+
                "Gaeste.", 78 ) );
  AddDetail( ({ "tablett", "tabletts" }), 
                break_string( "Der Kellner hat fast immer eines in der Hand.", 78 ) );
  AddDetail( ({ "chef" }), 
                break_string( "Hm, es schaut so aus, als ob er im Moment "+
                "nicht hier waere.", 78 ) );
  AddDetail( ({ "hunger" }), 
                break_string( "Du hast ihn! Und wie! Eigentlich bist Du ein "+
                "Vielfrass.", 78 ) );
  AddDetail( ({ "magen" }), 
                break_string( "Ja, obwohl Du vielleicht schon was gegessen "+
                "hast, knurrt Dein Magen immer noch. Vielleicht gefaellt ihm "+
                "der Geruch der Spare-Ribs.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst breitbeinig mitten im Gang - und "+
                "damit den Kellnern im Weg.", 78 ) );
  AddDetail( ({ "eiche" }), 
                break_string( "Richtig! Der Boden besteht aus Eichenholz.", 78 ) );
  AddDetail( ({ "holz" }), 
                break_string( "Eiche. Offensichtlich.", 78 ) );
  AddDetail( ({ "hand", "haende" }), 
                break_string( "Die Haende der Kellner schauen ziemlich "+
                "abgearbeitet aus.", 78 ) );
  AddDetail( ({ "krug", "bierkrug" }), 
                break_string( "Die Kellner haben immer volle oder leere "+
                "Bierkruege in Haenden.", 78 ) );
  AddDetail( ({ "ausschnitte", "zeitungsausschnitte" }), 
                break_string( "Viele Berichte ueber den beruehmten Chef des "+
                "Lokals!", 78 ) );
  AddDetail( ({ "wind" }), 
                break_string( "Unsehbar. Nur spuerbar.", 78 ) );
  AddDetail( ({ "klimaanlage", "anlage" }), 
                break_string( "Sie ist nicht zu sehen. Der frische Wind hie "+
                "und da beweist Dir aber, dass es eine geben muss.", 78 ) );
  AddDetail( ({ "zwerge" }), 
                break_string( "Eine Gruppe Zwerge kauert auf einem der "+
                "groesseren Tische herum - die duerften wohl schon laenger "+
                "hier sein....", 78 ) );
  AddDetail( ({ "atmosphaere" }), 
                break_string( "Gedaempft, irgendwie beruhigend. Friedlich. "+
                "Du kriegst Hunger.", 78 ) );
  AddDetail( ({ "kellner" }), 
                break_string( "Die Kellner laufen eilig zwischen den "+
                "Tischen hin und her, selten, dass einer keinen Bierkrug oder "+
                "ein Tablett in der Hand haelt.", 78 ) );
  AddDetail( ({ "gaststube", "stube", "lokal" }), 
                break_string( "Du bist darinnen.", 78 ) );
  AddDetail( ({ "fahrrad", "radl", "rad", "rennrad", 
                "bike" }), 
                break_string( "Ein altes Rennrad, das offensichtlich schon "+
                "viel mitgemacht hat. Naja, kein Wunder, stell Dir doch mal "+
                "das Rad eines Zwerges vor, das etliche Jahre alt ist.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Es haengt ein grosses Fahrrad von der Decke, "+
                "scheinbar ein ausgedientes vom Chef. Er hat mit diesem Rad "+
                "anscheinend einige Rennen gewonnen.", 78 ) );
  AddDetail( ({ "wand" }), 
                break_string( "An der Wand haengen Zeitungsausschnitte und "+
                "Poster von dem Chef der Kneipe, der anscheinend ein "+
                "Radrennfahrer sein (gewesen) muss.", 78 ) );
  AddDetail( ({ "lack" }), 
                break_string( "Der Lack ist sorgfaeltig ueber dem Holz "+
                "verteilt, um es vor der Belastung durch die Fuesse der "+
                "vielen Gaeste zu schuetzen.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Holz, scheint lackiert "+
                "zu sein.", 78 ) );
  AddDetail( ({ "tische", "tischen", "tisch" }), 
                break_string( "Die Tische sind ziemlich gross, damit die "+
                "grossen Holzstuecke, auf denen die Spare-Ribs gebracht "+
                "werden, auch auf einem Tisch Platz finden koennen.", 78 ) );
  AddDetail( ({ "gaeste" }), 
                break_string( "Die Gaeste sitzen an den Tischen und essen "+
                "Spare-Ribs. Fast jeder hier hat auch einen Krug Bier neben "+
                "sich stehen, mehr oder weniger geleert.", 78 ) );
  AddDetail ("staub", "Sowas siehst Du hier nicht. Ehrlich!\n");

  AddRoomMessage (({
	"Ein Kellner stoesst Dich mit einem Tablett in den Ruecken, "+
	"murmelt: 'Tschuldigens....' und eilt an Dir vorbei.\n",
	"Du kriegst Hunger.\n",
	"Du kriegst Durst.\n",
        "Ein frischgezapftes Tipfer Urtyp waere jetzt genau das richtige fuer "
          "Dich!\n",
        "Deine Kehle ist wie ausgedoerrt. Du brauchst jetzt ein Bier!\n",
	"Dein Magen knurrt.\n",
	"Eine Gruppe Zwerge faengt auf einmal an wie irr zu schreien. \n"+
	"Du erschrickst, kommst aber dann dahinter, dass das lediglich "+
	"einen Toast auf den Chef des Lokals bedeuten sollte.\n" }), 35);
 
  AddItem (NPC("zwerg4"), REFRESH_DESTRUCT);
}

public void urtyp_trinken() {
  object task;

  write(BS("Aaaaaaaaaaaahhhh..... ein echtes Tipfer!"));
  say(BS(TPN+" bekommt ein Tipfer Urtyp serviert und strahlt."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(5);
  }
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
