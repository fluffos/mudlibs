inherit "std/room";

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Sueden und "+
	"Westen befindet sich eine kalte Steinmauer, die aber ueberraschenderweise "+
	"weder feucht noch unheimlich ist. Du fuehlst Dich (trotz der Dunkelheit) "+
	"geborgen und sicher."));

  AddDetail( ({ "berg" }), 
                break_string( "Du stehst im Inneren eines Berges. Man nennt "+
                "sowas auch 'Hoehle'.", 78 ) );
  AddDetail( ({ "schlitze", "schlitz" }), 
                break_string( "Die Schlitze sind laenglich. Zwischen ihnen "+
                "stroemt Luft heraus.", 78 ) );
  AddDetail( ({ "kaestchen", "kasten", "kasterl" }), 
                break_string( "Das Kaestchen hat komische graue Schlitze. "+
                "Ausserdem stroemt frische Luft heraus. Ob das der Grund ist, "+
                "dass es hier, obwohl du in einer Hoehle bist, so gute Luft "+
                "hat?", 78 ) );
  AddDetail( ({ "suedwand" }), 
                break_string( "An der Suedwand siehst Du eine Art Kaestchen "+
                "befestigt, mit Schlitzen. Wofuer das nun wieder gut sein "+
                "mag?", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Stein, Stein, Stein, alles Stein im Berg! "+
                "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+
                "erwaermt.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "dunkelheit", "finsternis" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "mauer", "steinmauer", "wand", "waende" }), 
                break_string( "Ziemlich kalt, aber trocken. Hmmm, an "+
		"der Suedwand ist aber was seltsames!", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddSmell(({"luft", "gebirgsluft", "geruch"}), bs("Mhhhmmm... die Luft ist sehr "+
	"sauerstoffreich, also wenn Du mal eine Raucherlunge kriegen solltest, "+
	"komm in Felonias' Hoehle und kurier Dich aus!\n"));

  AddSmell(DEFAULT_SMELL, bs("Die Luft hier riecht einfach frisch, eindeutig "+
	"Gebirgsluft!\n"));
  AddSmell(({"stoff", "sauerstoff"}), bs("Ja, riecht richtig nach reinem "+
	"Sauerstoff hier!\n"));


// DETAILS END'

 AddExit("norden", ROOM("hoehle4"));
 AddExit("osten", ROOM("hoehle2"));
}
