inherit "std/room";

#include <properties.h>
#include "../files.h"
#include <moving.h>

create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du bist in der Zwergenstadt. "+
	"Du stehst in einem doppelt breiten Gang. Der helle "+
	"Glanz, den Du gesehen hast, kommt unweigerlich von den vielen "+
	"Fackeln, die hier an den Waenden angebracht sind. Es herrscht eine "+
	"friedliche Stimmung hier, Du fuehlst Dich willkommen.")); 

//  AddCmd( ({"leck", "lecke", "schleck", "schlecke" }), "lutschen");

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  AddDetail( ({ "umgebung" }), 
                break_string( "Die Umgebung ist finster und wird nur durch "+
                "die Fackeln etwas erhellt.", 78 ) );
  AddDetail( ({ "stimmung" }), 
                break_string( "Die Stimmung hier ist friedlich.", 78 ) );
  AddDetail( ({ "glanz" }), 
                break_string( "Der Glanz, den Du im Schacht erblicken "+
                "konntest, kam offensichtlich von den Fackeln, die hier "+
                "herumstehen.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "stadt", "zwergenstadt" }), 
                break_string( "Du stehst scheinbar in ihr!", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "weite" }), 
                break_string( "Doppelt weit ist dieser grosse Gang, "+
                "unglaublich!", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }), 
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }), 
                break_string( "VIELE VIELE davon lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "boden", "waende", "wand" }), 
                break_string( "Besteht aus grauem, uninteressantem Stein, "+
                "an den Waenden erhellen Fackeln die finstere Umgebung.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");


  AddItem("/d/ebene/obj/waffe/stockautomat", REFRESH_REMOVE);
  AddItem (NPC("zwerg1"), REFRESH_DESTRUCT);


 AddExit("norden", ROOM("gang06"));
 AddExit("westen", ROOM("gang02"));
 AddExit("sueden", ROOM("schacht3"));
//  AddExit("osten", ROOM("toepf"));
}

int lutschen (string str)
{
  notify_fail("Woran willst Du lecken?\n");
  if((str != "an ostwand") && (str != "an wand")) return 0;

  if(this_player()->QueryProp(P_GHOST))
     write("Du leckst an der Wand, doch nichts passiert.\n");
  else
{
     write(
       "Du leckst an der Wand und fuehlst Dich ploetzlich so koerperlos...\n");
  this_player()->SetProp(P_GHOST, 1);
  clone_object(ROOM("entgeister"))->move(this_player(), M_NOCHECK);
 
}

 say(TP->Name()+" schleckt eine der Waende ab.\n");

 return 1;
}
