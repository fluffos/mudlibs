inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Westen "+
	"geht hier ein Stollen ab. Es scheint im Stollen etwas kuehler zu "+
	"sein. Du hast hier in alle Richtungen freien Gehweg, was die Hoehle "+
	"noch groesser erscheinen laesst. Du fuehlst Dich (trotz der "+
	"anhaltenden Dunkelheit) geborgen und sicher."));

  AddDetail( ({ "stollen" }), 
                break_string( "Der Stollen geht nach Westen ab.", 78 ) );
  AddDetail( ({ "mauer", "steinmauer", "wand", "waende" }), 
                break_string( "An einer Kreuzung sind selten Waende.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst ein einer Hoehle, die Dir "+
	"im Moment ziemlich gross erscheint.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78));                                               
  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden", "steinboden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddItem(NPC("cairn"), REFRESH_DESTRUCT);

 AddExit("sueden", ROOM("hoehle1"));
 AddExit("norden", ROOM("hoehle7"));
 AddExit("osten", ROOM("hoehle5"));
 AddExit("westen", ("/d/gebirge/monimor/room/gang3"));
}
