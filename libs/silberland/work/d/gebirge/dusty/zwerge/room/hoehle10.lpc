inherit "std/room";  

#include "../files.h"
#include <properties.h>
#include <defines.h>

#define MAX_BONBONS 5

int cloned, bonbon;


create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Im Westen und "+
        "Norden befindet sich eine kalte Steinmauer, die aber "+
	"ueberraschenderweise weder feucht noch unheimlich ist. Du fuehlst "+
	"Dich (trotz der Dunkelheit) geborgen und sicher."));

  AddDetail( ({ "riss" }), 
                break_string( "Der Riss ist ziemlich klein, allerdings "+
                "koenntest du gerade noch hineingreifen.", 78 ) );
  AddDetail( ({ "wand", "mauer", "steinmauer" }), 
                break_string( "Im Norden und Westen befindet sich eine "+
                "Steinmauer, sie ist trocken und kuehl. Du kannst einen "+
                "kleinen Riss entdecken.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               

  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddItem(NPC("flark"), REFRESH_DESTRUCT);

 AddExit("sueden", ROOM("hoehle7"));
 AddExit("osten", ROOM("hoehle11"));
 SetProp( P_HIDE_EXITS, ({ "hinten" }) );

 AddCmd(({"greif", "greife"}), "greif");
 cloned=0;

}

greif (str)
{          
 notify_fail("Worein willst Du greifen?\n");
 
 if (str != "spalte" && str != "riss" && str != "in spalte" && str != "in riss")
	return 0;

  if (cloned) 
  {
    if(bonbon<MAX_BONBONS)
    {
      write("Hmmmmmmmmmmmm.... Du findest ein Bonbon! *freu*\n");
      clone_object(OBJ("bonbon"))->move(TP);
      bonbon++;
    }
    else
      write("Leider ist die Spalte leer.\n");
    return 1;
  }

	write("Du greifst mit zittrigem Finger in den Riss und ziehst "+
	"eine Fackel heraus.\n");

  clone_object("/obj/fackel")->move(TP);                                     

  TK(TPN+" hat eine Fackel gecloned!\n");
        cloned++;
	return 1;

}                                                                            
  
                                                                             
reset()
{
  ::reset();
  cloned=bonbon=0;
}
