// Ein Beispiel einer Abwandlung der Abenteurer-Gilde.

#include "../files.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

Funktion();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Zwergengilde" );
  SetProp(P_INT_LONG, 
    "Die der Zwergengilde von Felonia. "
    "Eine grosse Uhr zeigt die Zeit an. "
    "Ein kleines Schild zeigt folgendes:"+Funktion());
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN:TT_CAVE]) );

  SetProp(P_DETAILS, ([]) );
  RemoveItem("/p/service/obj/zettel/zettelmaschine");
  RemoveExit("westen");
  AddSpecialDetail("uhr","zeige_reboot");
  AddDetail(({"funktion", "schild"}), #'Funktion);
  AddReadDetail(({"funktion", "schild"}), #'Funktion);
  
  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "zwergengilde");
  
  AddExit( "osten", "./gang10" );
}

string GuildName() 
{
  return "abenteurer";
}

zwergengilde(string str)
{  
  string race;
  if( (race=this_player()->QueryProp(P_RACE))!="Zwerg") 
    return notify_fail("Das ist die Zwergengilde, da hast Du als "+race+
                       " nichts zu suchen.\n"),0;
  switch(query_verb())
  {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }
}

