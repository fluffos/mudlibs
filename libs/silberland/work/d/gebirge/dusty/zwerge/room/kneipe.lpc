inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../files.h"

int gepflegt;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Zur einaeugigen Gerechtigkeit");
  SetProp(P_INT_LONG, bs ("Du stehst in der Zwergenkneipe 'Zur "
        "einaeugigen Gerechtigkeit'. Der Wirt lauert hinter der Theke auf "
        "Kundschaft. Es sieht hier zwergig aufgeraeumt und ordentlich aus. "
        "Scheinbar hat der Wirt den ganzen Tag nichts anderes zu tun, als "
        "zusammenzuraeumen und auf Kunden zu warten. Ein Schild steht "
        "einsam und allein in einer Ecke. "));

  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));

  AddDetail( ({ "waende" }), 
                break_string( "Hellgruen ausgemalt. Passt gut!", 78 ) );
  AddDetail( ({ "bestellung" }), 
      "Wenn Du 'menue' tippst, siehst Du, was Du "
      "hier bestellen kannst." );
  AddDetail( ({ "theke" }), 
      "Der Wirt wartet hinter der Theke auf Deine "
      "Bestellung." );
  AddDetail( ({ "gerechtigkeit" }), 
      "Die herrscht hier!" );
  AddDetail( ({ "unregelmaessigkeit" }), 
      "Ja, die Erhebung schaut schon ziemlich "
      "unregelmaessig unordentlich aus." );
  AddDetail( ({ "erhebung" }), 
      "Eine kleine Unregelmaessigkeit im Boden. "
      "Nicht weiter schlimm, nur schaut es halt etwas ungepflegt "
      "aus." );
  AddDetail( ({ "erdbeben" }), 
      "Noch ist keines geplant. Aber wer weiss?" );
  AddDetail( ({ "tuerstock" }), 
      "Ein kraeftiger Tuerstock, da kann man sich "
      "sicher drunterstellen, wenn mal ein Erdbeben kommt. Direkt "
      "davor faellt Dir eine kleine Erhebung auf." );
  AddDetail( ({ "parkettboden", "boden" }), 
      "Sehr edler Boden, glatt wie frisch gebohnert. "
      "Nur eine kleine Erhebung faellt Dir direkt vor dem Tuerstock "
      "auf." );
  AddDetail( ({ "ecke" }), 
      "Ein Schild lehnt in der Ecke." );
  AddDetail( ({ "kneipe" }), 
      "Du stehst drin." );
  AddDetail( ({ "wirt" }), 
      "Der Wirt lauert hinter der Theke auf "
      "Kundschaft. Er grinst Dich gierig an." );
  AddDetail( ({ "decke", "holzdecke" }), 
      "Eine Holzdecke, gut gearbeitet." );
  AddDetail( ({ "farbe" }), 
      "Hellgruen sind die Waende, braun der Boden "
      "und die Decke." );
  AddDetail( ({ "wand" }), 
      "Hellgruen ausgemalt. Passt gut!" );
  AddDetail( ({ "glanz" }), 
      "Der Boden glaenzt aber schoen!" );
  AddDetail( ({ "schild" }), 
      "Du kannst es lesen." );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                          
      "Du malst gelangweilt einige Kreise in den Staub.\n");         

  AddSmell(DEFAULT_SMELL, bs("Es riecht hier... nach Putzmittel?!?\n"));
  AddSmell( ({"mittel", "putzmittel"}), "Eindeutig. Ziemlich eklig.\n"); 


  AddReadDetail("schild", bs("Selbstbedienung. Fuer die Menuekarte tippe einfach 'menue'.\n"));

  //  tatzelwurmkeule, schinken, haxn, 

  AddDrink("Elfentoeter", ({"toeter", "elfen", "elfentoeter"}),
      150, 70, 5, 20,
      ({"WAMMMMMMMMMMMM!!!! Der Drink koennte Elfen toeten!\n",
       "&& schaut aus, als koennte &! Elfen toeten!\n"}));

  AddDrink("Urbraeu Gold", ({"braeu", "urbraeu", "urbraeu-gold", "gold", "bier"}),
      100, ({20,20,10}), 10, 8,
      ({"Du geniesst Dein schon lange ersehntes Urbraeu Gold. *mmmmmhmm*",
       "&& geniesst etwas, das aussieht, als ob es verdammt gut waere!"}));

  AddDrink("Felotee",  ({"tee", "felotee", "felo"}),
      70, ({20,10,18}),0, 9,
      ({"Du bekommst eine Tasse Felotee, und findest ihn vorzueglich!",
       "&& trinkt mit abgespreiztem kleinen Finger eine Tasse Tee."}));

  AddFood ("Meerrettich", ({"radi", "meerrettich", "rettich"}), 
      100, ({15,30,5}), 7,
      ({"Du bekommst eine Schale voll kunstvoll in Spaeltlein "
       "geschnittenem Meerrettich, auch Radi genannt. Du wirfst "
       "3 Prisen Salz darueber, und machst Dich ueber diese "
       "Koestlichkeit her.\n"
       "Du fuehlst Dich seltsam zufrieden - mit Dir - und der Welt....\n",
       "&& wird Meerrettich serviert. Allein bei dem Gedanken daran beginnt "
       "Dein Magen zu rumoren. Vielleicht solltest Du auch....?\n"}));

  AddFood ("Radieschen", ({"radieschen", "dieschen"}),
      75, 32, 10,
      ({"Schoene, grosse, frische, Radieschen kommen auf Dich zu. Du "
       "oeffnest Deinen Mund, und sie huepfen willig und nett (wie "
       "Radieschen halt mal sind), direkt in Deinen Rachen. Sie "
       "hinterlassen einen wuerzigen Geschmack, der dir Appetit "
       "auf MEHR verschafft.",
       "HUCH.... auf einmal springen Radieschen auf && zu. Ob das geplant "
       "war oder ob sich die Radieschen einfach selbstaendig gemacht haben?\n"}));

  AddFood (
      /* Name  */  "Pumpernickel",
      /* IDs   */  ({"pumper", "nickel", "pumpernickel"}),
      /* Preis */  200,
      /* LPs   */  50,
      /* soak */ 17,
      ({"Mhhhhhmmmmmmmmm...........sehr guut!!! Du geniesst den Pumpernickel "
       "und beschliesst, dass zwergische Kost immer noch die beste ist!",
       "&& geniesst Pumpernickel und macht dabei ein sooooo zufriedenes "
       "Gesicht, dass Du richtig neidisch werden koenntest!"}));

  AddExit("sueden", ROOM("gang09"));

  AddCmd(({"pflege",  "pfleg"}), "pflege");

  gepflegt = 0;
}

int pflege (string str)
{
  notify_fail("Was willst Du denn pflegen?\n");

  if (str != "boden" && str != "parkettboden")
    return 0;
  if (gepflegt) {
    write("Sieht so aus als ob Du hier nichts mehr tun koenntest.\n");
    return 1;
  }

  write("Du pflegst mit Hingabe den Boden wieder glatt.\n");

  TK(TPN+" pflegt den Kneipenboden!\n");

  AddDetail( ({"boden", "parkettboden"}),
      "Der Boden strahlt einen edlen Glanz aus, wie frisch gebohnert.\n");  
  AddDetail( ({ "tuerstock" }), 
      "Ein kraeftiger Tuerstock, da kann man sich "
      "sicher drunterstellen, wenn mal ein Erdbeben kommt.");
  RemoveDetail("erhebung");
  RemoveDetail("unregelmaessigkeit");

  gepflegt++;
  return 1;
}

void reset()  
{  
  ::reset();
  gepflegt=0;
  AddDetail( ({ "parkettboden", "boden" }), 
      "Sehr edler Boden, glatt wie frisch gebohnert. "
      "Nur eine kleine Erhebung faellt Dir direkt vor dem Tuerstock auf." );
  AddDetail( ({ "unregelmaessigkeit" }), 
      "Ja, die Erhebung schaut schon ziemlich "
      "unregelmaessig unordentlich aus." );
  AddDetail( ({ "erhebung" }), 
      "Eine kleine Unregelmaessigkeit im Boden. "
      "Nicht weiter schlimm, nur schaut es halt etwas ungepflegt "
      "aus." );
  AddDetail( ({ "tuerstock" }), 
      "Ein kraeftiger Tuerstock, da kann man sich "
      "sicher drunterstellen, wenn mal ein Erdbeben kommt. Direkt "
      "davor faellt Dir eine kleine Erhebung auf." );
}
