inherit "std/room";

#include <properties.h>
#include "../files.h"
#include <defines.h>

int cloned;

create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Weg in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem zwergischen Gang. Im Westen ist eine "+
	"Eingang zu Buzzoms Hoehle. An der steinernen Wand neben dem Eingang "+
	"leuchtet eine Fackel. Im Osten befindet sich Viviennes Hoehle, wo "+
	"daneben ebenfalls eine Fackel angebracht wurde, damit Vivienne auch was sieht, wenn "+
	"sie todmuede spaet am Abend nachhause kommt.\n"));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17]));
 
  AddDetail( ({ "fackel" }), 
                break_string( "Die Fackel leuchtet hell.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Viviennes Hoehle ist im Osten, Buzzoms im Westen.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "fackeln" }), 
                break_string( "Sie leuchten hell, damit Vivienne und Buzzom was sehen, "+
                "wenn sie heimkommen.", 78 ) );
  AddDetail( ({ "wand", "waende", "westwand", "ostwand"}), 
                break_string( "An den Waenden erhellen Fackeln die "+
                "Umgebung.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Besteht aus grauem, uninteressantem Stein, "+
                "an der Wand erhellt eine Fackel die Umgebung.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),
                "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );

  AddExit("norden", ROOM("seher"));
  AddExit("sueden", ROOM("seher2"));
}
