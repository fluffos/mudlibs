inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem grossen Gang in der "+
	"Zwergenstadt. Du kannst in alle Richtungen gehen. Im Sueden scheint "+
	"sich ein Lokal zu befinden, dessen Name auf einem Schild, das "+
	"ueber der Tuere zu erkennen ist, steht. Fackelhalter stehen in den "+
	"Boden gerammt herum, sie erhellen die Umgebung.")); 

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23]));

  AddDetail( ({ "umgebung" }), 
                break_string( "Die Umgebung wird durch Fackeln erhellt.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "stadt", "zwergenstadt" }), 
                break_string( "Du stehst scheinbar in ihr!", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }), 
     	bs("Da hinein stellt man Fackeln, damit sie nicht umfallen.\n"));
  AddDetail( ({ "fackeln", "fackel" }), 
                break_string( "Sie lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "waende", "wand" }), 
                bs("Hier in Deiner naeheren Umgebung befinden "+
	"sich keine Waende."));
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
   	"Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail("boden", bs("Der Boden besteht aus hartem Stein. Fackelhalter, "+
	"in denen Fackeln die Umgebung erhellen, wurden in den Boden gerammt.\n"));
  AddDetail("schild", "Du kannst es lesen.\n");
  AddReadDetail("schild", "Es steht darauf geschrieben: 'Bier & Ribs'\n");

  AddDetail("lokal", "Im Sueden duerfte ein Lokal sein.\n");

  AddDetail( ({ "gang" }),
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );

  AddDetail(({"tuer", "tuere"}), bs ("Die Tuere scheint in ein Lokal zu fuehren. Du kannst "+
	"ein Schild ueber der Tuere erkennen.\n"));

 AddExit("westen", ROOM("gang03"));
 AddExit("norden", ROOM("gang07"));
 AddExit("osten", ROOM("gang01"));
 AddExit("sueden", ROOM("bierribs"));
}
