inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst inmitten dieser Hoehle aus Stein. Du "+
	"beschliesst, dass sie gar nicht von Natur aus entstanden "+
	"sein kann. Die reizende Einfachheit erinnert Dich an Deine "+
	"Kindheit. Waren das noch Zeiten!"));

  AddDetail(({"zeichen", "schriftzeichen"}), bs("Du kannst sie lesen.\n"));

  AddDetail( ({ "kindheit" }), 
                break_string( "Du denkst . o O (damals.....)", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle, genau in "+
                "der Mitte!", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               

 AddRoomMessage ( ( {
	"Du spuerst, wie Dir ein Wassertropfen auf den Kopf faellt... "+
	"Komisch, die Hoehle ist doch ueberall sonst total trocken???!?\n"}), 60);

  AddDetail( ({ "dunkelheit", "finsternis" }), 
                break_string( "Gerade genug Licht zum Sehen.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Auch hier ist der Boden aus Stein.", 78 ) );
  AddReadDetail( ({ "schriftzeichen", "zeichen" }), 
        "Du entzifferst:\n'Willkommen, o edler "+
        "Wandersmann,\nedler Botschafter des Friedens.\nRuhe "+
	"Dich aus im Reiche des Koenigs,\nund ehre die Macht der "+
	"Koenigin.\nHalte ein die Gebote, die von Weisen bestimmt.'\n");
  AddDetail( ({ "decke" }), 
                break_string( "Du kannst Schriftzeichen an der Decke "+
                "erkennen.", 78 ) );
  AddDetail( ({ "tropfen", "wassertropfen" }), 
                break_string( "Er schien von der Decke zu kommen?!?", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
                "Du malst gelangweilt einige Kreise in den Staub.\n");
 AddItem ("/obj/sehertor", REFRESH_REMOVE);

 AddExit("norden", ROOM("hoehle8"));
 AddExit("westen", ROOM("hoehle4"));
 AddExit("osten", ROOM("hoehle6"));
 AddExit("sueden", ROOM("hoehle2"));
}

int _query_tport_cost_in()
{
  if( TP && TP->QueryProp(P_RACE) == "Zwerg" )
    return -2;
  return 0;
}

int _query_tport_cost_out()
{
  if( TP && TP->QueryProp(P_RACE) == "Zwerg" )
    return -2;
  return 0;
}
