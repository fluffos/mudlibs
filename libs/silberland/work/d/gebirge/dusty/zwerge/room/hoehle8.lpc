inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst hier fast inmitten einer Hoehle aus "
	"Stein. Du kannst hier in alle Richtungen gehen. Eigentlich ist "
	"diese Hoehle gar nicht so klein wie du bisher gemeint hast! "
	"Obwohl es hier ziemlich dunkel ist, fuehlst Du Dich wie daheim."));

  AddDetail( ({ "mauer", "steinmauer", "wand" }), 
                break_string( "Hier ist doch gar keine!", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                      
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+       
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+    
              "erwaermt.", 78 ));                                               
  AddDetail( ({ "finsternis", "dunkelheit" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                  
                "Du malst gelangweilt einige Kreise in den Staub.\n"); 

 AddItem(NPC("kral"), REFRESH_DESTRUCT);

 AddExit("westen", ROOM("hoehle7"));
 AddExit("osten", ROOM("hoehle9"));
 AddExit("sueden", ROOM("hoehle5"));
AddExit("norden", ROOM("hoehle11"));
}
