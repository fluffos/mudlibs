inherit "std/room";

#include <properties.h>
#include "../files.h"
#include <defines.h>

int cloned;

create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Weg in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem zwergischen Gang. Im Osten und "+
	"im Westen liegen allem Anschein nach Sengir bzw. Ironboots Hoehlen. "+
	"Ansonsten ist dieser Gang ein ganz gewoehnlicher, wenn auch hier "+
	"seltsamerweise ein Teppich statt den normalen grauen Stein den Boden "+
	"bedeckt.\n"));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17]));
 
  AddDetail( ({ "hoehle" }), 
                break_string( "Die Hoehle von Sengir scheint im Westen zu liegen, "+
                "die von Ironboot im Osten.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "fackel" }), 
                break_string( "Sie leuchtet normalerweise, damit die Anrainer ohne "+
                "Stolpern in die Wohnungen finden.", 78 ) );
  AddDetail( ({ "wand", "waende", "ostwand"}), 
                break_string( "An der Ostwand neben Sengirs Hoehle ist zwecks Beleuchtung eine "+
                "Fackel angebracht.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Am Boden liegt ein nicht mehr ganz neuer, aber "+
                "gut erhaltener, mittelmaessig teuer aussehender Teppich.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),
                "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein", "felsen", "fels" }),
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail( ({ "teppich"}),
  		break_string("Der Teppich bedeckt den Steinboden darunter, "
  		"es steht sich wirklich angenehm.", 78 ));
  		
  AddExit("norden", ROOM("seher1"));
  AddExit("sueden", ROOM("seher3"));
  
}
