inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Hier scheint der Gang zu Ende zu sein. Du kannst noch "+
	"immer in alle Richtungen gehen, jedoch siehst Du im Westen eine Poststation und "+
        "im Sueden geht ein weiterer Gang ab. Nach Norden und Osten geht der "+
	"Gang weiter. Fackelhalter stehen in den Boden gerammt herum."));

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));

  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "zwergenstadt", "stadt" }), 
                break_string( "Du stehst scheinbar in ihr!", 78 ) );
  AddDetail(({"post","poststation","station"}), bs("Direkt westlich von Dir "+
	"siehst Du die Poststation der Zwergenstadt.\n"));
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "gang" }),
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }),
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }),
                break_string( "Sie lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "waende", "wand" }),
                break_string( "Du siehst keine Waende in Deiner unmittelbaren "+
                "Umgebung.", 78));
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );

  AddDetail("boden", "In den Boden gerammt stehen Fackelhalter herum, die die "+
	"Umgebung mit ihren Fackeln beleuchten.\n");

  AddDetail("umgebung", "Romantisch, einfach romantisch!\n");

  AddItem(("/d/gebirge/dusty/zwerge/mon/targ"), REFRESH_DESTRUCT);

 AddExit("norden", ROOM("gang10"));
 AddExit("osten", ROOM("gang04"));
 AddExit("westen", ROOM("post"));
 AddExit("sueden", ROOM("seher"));
}
