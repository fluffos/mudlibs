inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Bei den Hoechsten");
 SetProp(P_INT_LONG, bs("Du stehst in einer Art Vorraum. An einem "+
	"Schreibtisch sitzt ein Beamter, ein Daemon namens 'Professor "+
	"Zwoelferschlag'. Sonst ist der Raum ziemlich kaerglich ausgestattet, "+
	"vor des Daemons Tisch steht ein Sessel, ein undefinierbarer "+
	"Teppich bedeckt den Boden. "+
	"Die Anwesenheit des Daemonen hat leider den betreffenden Magier, "+
	"der hier Details einfuegen sollte, bis jetzt erfolgreich daran "+
	"gehindert.\n"));

 AddItem (NPC("daemon"), REFRESH_DESTRUCT);

  AddExit ("sueden", ROOM("gang07"));
  // EXITS END
	}
