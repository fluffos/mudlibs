inherit "std/thing";
#include <properties.h>
#include "../files.h"

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  call_out("remove", 10);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_NEVERDROP, 1);
  AddId("\bentgeister");

}

remove()
{
  object env;
  if ((env=environment()) && (living(env)))
  {
    tell_object(env, "Ploetzlich spuerst Du, wie Du wieder feste, koerperliche"+
          " Form annimmst.\n");
    env->SetProp(P_GHOST, 0);
  }
  return ::remove();
}
