inherit "std/room";

#include <properties.h>
#include "../files.h"

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp(P_INT_SHORT, "Im Schlund");
 SetProp(P_INT_LONG, bs ("Der Schlund scheint total schwarz zu sein. Du "+
	"bist froh, dass Du wenigstens erkennen kannst, dass nach Norden "+
	"der Weg weitergeht. Die Waende und alles andere scheinen aus "+
	"dem Stein herausgeschlagen worden zu sein.\n"));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:13]));

  AddDetail( ({ "zeichen" }), 
                break_string( "Wie Du dieses Zeichen deutest, das bleibt "+
                "wohl Dir selber ueberlassen.", 78 ) );
  AddDetail( ({ "fe" }), 
                break_string( "Fe ist das chemische Zeichen fuer Eisen.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Die Decke kannst Du "+
                "kaum noch entdecken.", 78 ) );
  AddDetail( ({ "eisen" }), 
                break_string( "Eisen. Fe.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Hart wie Eisen. Fast.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht auch aus Stein, so wie "+
                "alles hier ausser Dir.", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Steinerne Waende. Bestehen aus Stein.", 78 ) );
  AddDetail( ({ "weg" }), 
                break_string( "Er scheint nach Norden weiterzugehen, denn "+
                "rechts und links von Dir befinden sich steinerne Waende.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddDetail( ({ "schlund" }), break_string( "Der Schlund ist finster "+
	"und unheimlich.", 78));

 AddExit("sueden", ROOM("eingang"));
 AddExit("norden", ROOM("eingang3"));
}
