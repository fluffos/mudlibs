inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Der Gang geht hier nach Westen, Osten und Sueden "+
        "weiter. Im Norden dagegen scheint etwas Anderes zu sein, vielleicht "+
	"solltest Du mal nachsehen? Wie auch immer, auch hier sind Fackelhalter "+
	"in den Boden gesteckt, um die Umgebung zu erhellen.\n"));

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));

  AddDetail( ({ "berg" }), 
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddDetail( ({ "zwergenstadt", "stadt" }), 
                break_string( "Du stehst scheinbar in ihr.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "umgebung" }), 
                break_string( "Um sie zu erhellen, wurden Fackelhalter in "+
                "den Boden gesteckt.", 78 ) );
  AddDetail( ({ "gang" }),
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }),
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }),
                break_string( "Sie lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "waende", "wand" }), bs(
      	"Da Du in alle 4 Richtungen weitergehen kannst "+
        "ist es eigentlich logisch, dass Du keine Waende jedwegiger"+
	" Art erkennst.\n"));

  AddDetail(({"boden", "steinboden"}),
	"Fackelhalter sind in den Steinboden gerammt.\n");

  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein" }),
                break_string( "Steinhart, der Stein.", 78 ) );


 AddExit("westen", ROOM("gang09"));
 AddExit("osten", ROOM("gang07"));
 AddExit("sueden", ROOM("gang03"));
 AddExit("norden", ROOM("laden"));
}
