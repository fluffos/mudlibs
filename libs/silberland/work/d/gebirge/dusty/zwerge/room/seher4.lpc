inherit "std/room";

#include <properties.h>
#include "../files.h"
#include <defines.h>

int cloned;

create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Weg in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Du stehst in einem zwergischen Gang. Im Osten "+
	"wohnt Timo, im Westen logiert Torgrimm. "+
	"Ansonsten ist dieser Gang ein ganz gewoehnlicher, wenn auch hier "+
	"seltsamerweise ein Teppich statt den normalen grauen Stein den Boden "+
	"bedeckt.\n"));
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17]));
 
  AddDetail( ({ "steinboden" }), 
                break_string( "Der wird von einem Teppich bedeckt.", 78 ) );
  AddDetail( ({ "beleuchtung" }), 
                break_string( "In diesem Fall eine Fackel.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Sie besteht aus Stein.", 78 ) );
  AddDetail( ({ "fackel" }), 
                break_string( "Sie erhellt den Raum, sonst finden Timo und "+
                "Torgrimm vermutlich nicht nachhause.", 78 ) );
  AddDetail( ({ "wand", "waende"}), 
                break_string( "An der Westwand neben dem Eingang ist zwecks Beleuchtung eine "+
                "Fackel angebracht.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Am Boden liegt ein nicht mehr ganz neuer, aber "+
                "gut erhaltener, mittelmaessig teuer aussehender Teppich.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),
                "Du malst gelangweilt einige Kreise in den Staub.\n");
  AddDetail( ({ "stein", "felsen", "fels" }),
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail( ({ "teppich"}),
  		break_string("Der Teppich bedeckt den Steinboden darunter, "
  		"es steht sich wirklich angenehm.", 78 ));
  		
  AddExit("norden", ROOM("seher3"));
  
}
