inherit "std/room";

#include <properties.h>
#include "../files.h"

create()
{
::create();

 SetProp(P_LIGHT, 0);
 SetProp(P_INDOORS, 1);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du hattest Recht, auf einmal stehst Du in einer kleinen "+
	"Hoehle. Auch sie besteht scheinbar nur aus Stein, jedoch hat es hier "+
	"einen angenehmeren Geruch als im Schlund. Du fuehlst Dich wohl hier. "+
	"Irgendwie hat die Hoehle einen vertrauenserweckenden Eindruck auf "+
	"Dein gestresstes Gewissen."));

  AddDetail( ({ "gewissen" }), 
                break_string( "Ziemlich gestresst, nicht wahr?", 78 ) );
 AddDetail( ({ "stein" }),                                                     
               break_string( "Stein, Stein, Stein, alles Stein im Berg! "+     
               "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+  
               "erwaermt.", 78 ));                                            

  AddDetail( ({ "dunkelheit", "finsternis" }), 
                break_string( "Gerade genug Licht zum Sehen hier.", 78 ) );
  AddDetail( ({ "wand" }), 
                break_string( "Keine in Deinem Umfeld.", 78 ) );
  AddDetail( ({ "decke", "steindecke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "schlund" }), 
                break_string( "Du bist froh, endlich dem Schlund entkommen "+
                "zu sein.", 78 ) );
  AddDetail( ({ "boden", "steinboden" }), 
                break_string( "Der Boden besteht zwar nur aus Stein, aber "+
                "er scheint waermer zu sein als der Boden im Schlund.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

 AddSmell(DEFAULT_SMELL, bs("Gute Luft hier. Besser als im Schlund. "+
	"Vielleicht gibts hier sogar Ventilation?"));

 AddSmell(({"luft", "geruch"}), bs("Hm. Ziemlich sauerstoffreich, die "+
	"Luft. Riecht gut, vor allem."));

 AddSmell(({"schlund", "in Schlund"}), bs("Dort stinkts, eigentlich."));

 AddItem (NPC("jahn"), REFRESH_DESTRUCT);

 AddExit("sueden", ROOM("eingang3"));
 AddExit("westen", ROOM("hoehle1"));
 AddExit("osten", ROOM("hoehle3"));
 AddExit("norden", ROOM("hoehle5"));
}
