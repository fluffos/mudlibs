inherit "std/room";

#include <properties.h>
#include "../files.h"

create()

{

::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Schacht");
 SetProp(P_INT_LONG, bs( "Du stehst am Ende oder Anfang eines Schachtes. "
 "Aus dem Norden "+
 "dringt genuegend Licht, um Dir freie Sicht zu gestatten. Es scheint, als ob "+
 "Du im Norden auf eine Art Platz oder breiten Weg kommen wuerdest. Nach "
 "Oben geht es in die Finsternis. Von unten dringt leises Plaetschern an "
 "Dein Ohr."));

  AddDetail( ({ "waende", "wand" }), 
                break_string( "Die Waende - aeh - die Wand ist rund und "+
                "zieht sich um Dich herum.", 78 ) );
  AddDetail( ({ "licht" }), 
                break_string( "Das Licht dringt aus dem Norden zu Dir. Du "+
                "kannst wieder sehen!", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Der Schacht besteht aus Stein.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Die kannst Du ueber Dir nicht erkennen.", 78 ) );
  AddDetail( ({ "wand" }), 
                break_string( "Auf der steinernen Wand sind erneut "+
                "Schriftzeichen zu sehen.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden ist aus Stein, er ist allerdings "+
                "angenehm beheizt.", 78 ) );
  AddDetail( ({ "sicht" }), 
                break_string( "Frei!", 78 ) );
  AddDetail( ({ "platz", "weg" }), 
                break_string( "Der Weg oder Platz im Norden ist ziemlich "+
                "hell erleuchtet.", 78 ) );
  AddDetail( ({ "schacht" }), 
                break_string( "Du stehst im untersten Teil eines Schachtes.", 78 ) );
  AddDetail( ({ "klettersprossen", "sprossen" }),
                break_string( "Sie ziehen sich durch den ganzen Schacht. "+
                "Wie sonst sollte man ihn denn hinauf/hinunter kommen?", 78 ) );
  
  AddDetail( ({"plaetschern"}), 
      "Du solltest lauschen, nicht schauen.");

  AddReadDetail(({"schriftzeichen", "zeichen", "schrift"}),
	"Du erkennst:\n 'Nie sollst Du in Unehren halten die Herrscher "+
	"von Felonia,\n die Hoechsten dieser Stadt, die so guetig sind in "+
	"ihrem Tun.'\n");

  AddDetail(({"schriftzeichen", "zeichen", "schrift"}), bs("Du kannst sie lesen.\n"));

  AddSound(DEFAULT_SOUND, 
      "Von unten dringt ein leises Plaetschern an Dein Ohr.");
  AddSound( ({"plaetschern"}),
      "Hmm, von unten dringt ein Plaetschern an Dein Ohr. Vielleicht solltest "
      "Du mal nach unten schauen?");
 AddExit("oben", ROOM("schacht2"));
 AddExit("norden", ROOM("gang01"));
 AddExit("unten", "../../../orw/grotte/room/steg");
}
