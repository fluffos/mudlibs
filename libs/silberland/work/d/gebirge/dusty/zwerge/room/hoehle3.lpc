inherit "std/room";  

#include "../files.h"
#include <properties.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 0);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
 SetProp(P_INT_SHORT, "Hoehle");
 SetProp(P_INT_LONG, bs ("Du stehst in einer Hoehle aus Stein. Es ist "+
	"ziemlich finster hier, aber im Osten "+
	"geht ein noch finsterer Gang ab. Kalte Luft stroemt heraus. Was "+
	"dort wohl liegen mag?\n"));

  AddDetail( ({ "luft" }), 
                break_string( "Die kalte Luft scheint aus dem Osten zu "+
                "kommen.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Der Gang wirkt finster und bedrohlich.", 78 ) );
  AddDetail( ({ "wand", "waende", "steinwand", 
                "steinwaende", "steinmauern", "steinmauer", 
                "mauer", "mauern" }), 
                break_string( "Im Sueden befindet sich eine "+
                "Steinmauer. Sie ist trocken und kuehl.", 78 ) );
  AddDetail( ({ "hoehle" }), 
                break_string( "Du stehst in einer kleinen Hoehle.", 78 ) );
 AddDetail( ({ "stein" }),                                                    
              break_string( "Stein, Stein, Stein, alles Stein im Berg! "+    
              "Und..... der Steinboden unter deinen Fuessen ist scheinbar "+ 
              "erwaermt.", 78 ));                                            

  AddDetail( ({ "dunkelheit", "finsternis" }), 
                break_string( "Ziemlich finster hier.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden besteht aus Stein, der scheinbar "+
                "irgendwie erwaermt wird.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Graue Steindecke.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht"}),                        
                "Du malst gelangweilt einige Kreise in den Staub.\n");       

  AddSmell(DEFAULT_SMELL, bs("Gut riecht die Luft hier nicht."));

  AddSmell("luft", bs("Die Luft riecht irgendwie nach Bergwerk.\n"));

// DETAILS END

 AddExit("westen", ROOM("hoehle2"));
 AddExit("norden", ROOM("hoehle6"));
 AddExit("osten", "/d/gebirge/angrox/room/gang1");
}
