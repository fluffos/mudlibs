inherit "std/room";

#include <properties.h>
#include "../files.h"
create()

{

::create();

 SetProp(P_LIGHT, 1);
 SetProp(P_NOMAGIC, 1);
 SetProp(P_INDOORS, 1);
 SetProp(P_INT_SHORT, "Ein Gang in der Zwergenstadt");
 SetProp(P_INT_LONG, bs("Jetzt erst erkennst Du, wo Du hier eigentlich bist! "+
	"Die Zwergenstadt! Du stehst in einem doppelt breiten Gang. Der helle "+
	"Glanz, den Du gesehen hast, kommt unweigerlich von den vielen "+
	"Fackeln, die hier an den Waenden angebracht sind. Es herrscht eine "+
	"friedliche Stimmung hier, Du fuehlst Dich willkommen.")); 

 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));

  AddDetail( ({ "weite" }), 
                break_string( "Doppelt weit ist dieser grosse Gang, "+
                "unglaublich!", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Der Gang ist ziemlich breit, ungefaehr die "+
                "doppelte Weite eines normalen Durchschnittganges.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Steinhart, der Stein.", 78 ) );
  AddDetail( ({ "fackelhalter", "fackelhaltern" }), 
                break_string( "Da hinein stellt man Fackeln, damit sie "+
                "nicht umfallen.", 78 ) );
  AddDetail( ({ "fackeln", "fackel" }), 
                break_string( "VIELE VIELE davon lodern in den Fackelhaltern.", 78 ) );
  AddDetail( ({ "boden", "waende", "wand" }), 
                break_string( "Besteht aus grauem, uninteressantem Stein, "+
                "an den Waenden erhellen Fackeln die finstere Umgebung.", 78 ) );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");

}
