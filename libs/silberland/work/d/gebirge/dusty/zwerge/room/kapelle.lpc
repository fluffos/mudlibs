inherit "std/room";

#include <properties.h>
#include "../files.h"

string tafel();

create()

{

::create();

 NewDoor( "norden", "/d/gebirge/dusty/hoch/room/vorr",({"vorhang"}),
  	({ D_NAME,"Vorhang",
  	   D_GENDER, MALE,
  	   D_FLAGS, (DOOR_RESET_CL|DOOR_CLOSED),
 	   D_MSGS,({"", "geht durch den Vorhang","kommt durch den Vorhang herein"}),
  	   D_SHORT,"Der Vorhang im Norden ist %s. ",
  	   D_FUNC2, "vorhangzu",
  	   D_LONG,
 	   	"Der Vorhang hindert den Raum im Norden, Licht in die Kapelle zu lassen."
  	   	})); 

 SetProp(P_LIGHT, 1);
 SetProp(P_INDOORS, 1);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
 SetProp(P_INT_SHORT, "Die Zwergenkapelle");
 SetProp(P_INT_LONG, bs("Du stehst in der Zwergenkapelle. Ein "+
	"Lichtermeer von Fackeln umgibt dich hier drinnen. Zwischen "+
	"den Fackeln erblickst du einen wunderschoenen Hochaltar. "+
	"Einige Statuen, geschnitzt von kundiger Zwergenhand, stehen in den "+
	"Ecken und geben mit den Fackeln dieser wunderschoenen Kapelle hier "+
	"inmitten des Berges ein eigentuemliches Flair. Auch der eigentuemliche "+
	"Duft hier fasziniert Dich. Neben dem Altar haengt eine Heldentafel."));

  AddDetail( ({ "typo" }), 
                break_string( "Gibts das hier noch? *staun* :-)", 78 ) );
  AddDetail( ({ "kapitel" }), 
                break_string( "Das werden wir ein anderes mal behandeln :-)", 78 ) );
  AddDetail( ({ "axt" }), 
                break_string( "Die Axt schaut ziemlich furchterregend aus.", 78 ) );
  AddDetail( ({ "nackte zwerge"}),
		break_string( "Nackte Zwerge sind ein Kapitel fuer sich.", 78) );
  AddDetail( ({ "nase" }), 
                break_string( "Diese Nase ist die schoenste Nase, die Du je "+
                "an einer Zwergin gesehen hast.", 78 ) );
  AddDetail( ({ "schoenheit" }), 
                break_string( "Diese Nase........", 78 ) );
  AddDetail( ({ "tippfehler", "fehler" }), 
                break_string( "Ein Tippfehler wird auch Typo genannt. Wenn "+
                "Du einen findest, setz ihn bitte ab.", 78 ) );
  AddDetail( ({ "elfe" }), 
                break_string( "Bitte - keine so ungustioesen Themen hier in "+
                "der Geburtsstaette der Zwerge *grins*", 78 ) );
  AddDetail( ({ "duft" }), 
                break_string( "Hmm... rieche doch einfach mal!", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Steinharter Stein!", 78 ) );
  AddDetail( ({ "ecke" }), 
                break_string( "In einer steht eine Statue, die besonders gut "+
                "gelungen ist.", 78 ) );
  AddDetail( ({ "worte", "wort" }), 
                break_string( "Worte, die normalerweise ausgesprochen "+
                "werden. Oder zumindest aufgeschrieben werden.", 78 ) );
  AddDetail( ({ "wesen" }), 
                break_string( "Naja, lebende Wesen halt. ", 78 ) );
  AddDetail( ({ "kultur" }), 
                break_string( "Die zwergische Kultur ist schon sehr alt! Nur "+
                "hat es bis jetzt kein lebendes Wesen geschafft, zwergische "+
                "Kultur in Worte zu fassen.", 78 ) );
  AddDetail( ({ "goetter" }), 
                break_string( "Dusty und Woody sind die Goetter hier im "+
                "SilberLand, Du solltest sie achten und ehren!", 78 ) );
  AddDetail( ({ "gott" }), 
                break_string( "Sei immer fromm und hoeflich Deinen Goettern "+
                "gegenueber, sonst koennten Deine Tage gezaehlt sein!", 78 ) );
  AddDetail( ({ "dusty" }), 
                break_string( "Dies ist die Goettin des SilberLandes, die, "+
                "die den Zwergen half, Felonia zu erschaffen.", 78 ) );
  AddDetail( ({ "statuen", "zwergenstatuen" }), 
                break_string( "In jeder der 4 Ecken steht eine Statue. "+
                "Besonders die in der linken Ecke ist den Zwergen sehr sehr "+
                "schoen gelungen.", 78 ) );
  AddDetail( ({ "linke ecke"}),
		break_string("In der linken Ecke steht eine Statue, die Dusty"+
		" darstellen soll.", 78 ));
  AddDetail( ({ "deckenmalerei", "malerei", "deckenmalereien", 
                "malereien" }), 
                break_string( "Etliche Szenen aus der zwergischen Kultur. "+
                "Schoen, aber nicht interessant anzuschauen. Ausser man mag "+
                "maennliche nackte Zwerge.", 78 ) );
  AddDetail( ({ "kontrolle" }), 
                break_string( "Ich weiss nicht, ob Du Dich unter ihr hast. "+
                ":-) Zwerginnen haben Zwerge aber immer unter Kontrolle.", 78 ) );
  AddDetail( ({ "zwerginnen" }), 
                break_string( "Zwerginnen sind meist resolute, ihre Maenner "+
                "unter Kontrolle habende Wesen.", 78 ) );
  AddDetail( ({ "zwerge" }), 
                break_string( "Maennliche nackte Zwerge sind manchmal sogar "+
                "resoluten weiblichen Zwerginnen unheimlich.", 78 ) );
  AddDetail( ({ "szenen", "szene" }), 
                break_string( "Glaub mir, naeher willst Du sie Dir nicht "+
                "ansehen.", 78 ) );
  AddDetail( ({ "deckenmalerei", "malerei" }), 
                break_string( "Etliche Szenen aus der zwergischen Kultur. "+
                "Schoen, aber nicht interessant anzuschauen. Ausser man mag "+
                "maennliche nackte Zwerge.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Wunderschoene Deckenmalereien sind auf der "+
                "Decke. Sie wuerden ja auch nicht auf Waende passen.", 78 ) );
  AddDetail( ({ "felonia" }), 
                break_string( "Felonia ist die Stadt, in der Du Dich gerade "+
                "befindest, die Zwergenstadt.", 78 ) );
  AddDetail( ({ "daemonstration" }), 
                break_string( "Daemonisch, daemonisch.", 78 ) );
  AddDetail( ({ "lichtermeer", "meer" }), 
                break_string( "Die Fackeln bilden fast ein Lichtermeer. "+
                "Schaut fast so hell aus, wie bei der Daemonstration, bei der "+
                "Du das letzte Mal warst.", 78 ) );
  AddDetail( ({ "licht" }), 
                break_string( "Hell ist es hier herinnen.", 78 ) );
  AddDetail( ({ "lebenslicht" }), 
                break_string( "Das Lebenslicht brennt ewig. Wenn es einmal "+
                "verloescht, werden alle Zwerge dieser Welt elendiglich "+
                "zugrunde gehen. Aber das wird noch lange nicht passieren, "+
                "das Licht flackert lustig vor sich hin.", 78 ) );
  AddDetail( ({ "welt" }), 
                break_string( "Die Welt ist flach, das wissen alle Zwerge.", 78 ) );
  AddDetail( ({ "flair" }), 
                break_string( "Eigentuemlich. Ein seltsames Flair. So, als "+
                "ob Du gar nicht auf dieser Welt, sondern schon in der "+
                "naechsten waerst.", 78 ) );
  AddDetail( ({ "perfektionsarbeit" }), 
                break_string( "Perfekte Arbeit. Wie alles halt perfekt ist "+
                "von Zwergen.", 78 ) );
  AddDetail( ({ "kleber" }), 
                break_string( "Du kannst keinen sehen, das Kreuz ist "+
                "Perfektionsarbeit.", 78 ) );
  AddDetail( ({ "latten" }), 
                break_string( "Sie sind irgendwie zusammengeklebt, mit "+
                "Kleber wahrscheinlich.", 78 ) );
  AddDetail( ({ "kreuz" }), 
                break_string( "Ein Kreuz besteht aus 2 Latten, einer "+
                "horizontalen und einer vertikalen, die irgendwie "+
                "zusammengefuegt sind.", 78 ) );
  AddDetail( ({ "wand" }), 
                break_string( "An der hinteren Wand ist der Altar, daneben siehst Du einen Vorhang.", 78 ) );
  AddDetail( ({ "kerzenhalter" }), 
                break_string( "Sie halten die Kerzen.", 78 ) );
  AddDetail( ({ "kerzen" }), 
                break_string( "Sie sind angezuendet und werden sich nicht "+
                "durch Dich verloeschen lassen.", 78 ) );
  AddDetail( ({ "altar", "hochaltar" }), 
                break_string( "Auf dem Altar steht ein grosses Kreuz, "+
	"ein Lebenslicht und 7 Kerzenhalter mit jeweils 3 Kerzen darauf."+
	" Er ist aus Stein.", 78 ) );
  AddDetail( ({ "zwergenhand", "hand" }), 
                break_string( "Die Zwergenhand, die die Statuen geschnitzt "+
                "hat, muss sehr schnitzkundig gewesen sein. Besonders eine "+
                "Statue ist sehr schoen geworden.", 78 ) );
  AddDetail( ({ "inschrift" }), 
                break_string( "Du koenntest Sie lesen.", 78 ) );
  AddDetail( ({ "schnoerkel" }), 
                break_string( "Sehr schnoerkelig, die Kreise. Passen gut zu "+
                "dieser Kapelle.", 78 ) );
  AddDetail( ({ "kreise" }), 
                break_string( "Sehr kreisig, die Schnoerkel. Passt aber gut "+
                "zu dieser Kapelle.", 78 ) );
  AddDetail( ({ "verzierungen" }), 
                break_string( "Kreise, Schnoerkel. Und eine goldene "+
                "Inschrift.", 78 ) );
  AddDetail( ({ "tand" }), 
                break_string( "Der uebliche Tand, wie er in Kapellen zu "+
                "finden ist. Goldene Verzierungen und sowas.", 78 ) );
  AddDetail( ({ "waende" }), 
                break_string( "Fackeln sind an den Waenden. Und natuerlich "+
                "sind die Waende mit allerlei goldenem Tand ausgestattet.", 78 ) );
  AddDetail( ({ "teppich" }), 
                break_string( "Der Teppich ist rot. Schaut edel aus, der war "+
                "sicher teuer!", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden ist mit rotem Teppich ausgelegt.", 78 ) );
  AddDetail( ({ "statue" }), 
                break_string( "Das ist Dusty in ihrer steinernen Schoenheit. "+
                "Sie hat eine riesengrosse Axt in ihrer linken Hand.", 78 ) );
  AddDetail( ({ "ecken" }), 
                break_string( "Statuen stehen in den Ecken, je eine in jeder "+
                "Ecke. Eine davon sticht etwas heraus.", 78 ) );
  AddDetail( ({ "zwergentum" }), 
                break_string( "Das Zwergentum ist edel, hilfreich und gut.", 78 ) );
  AddDetail( ({ "staette" }), 
                break_string( "Du stehst hier an der Geburtsstaette des "+
                "Zwergentums.", 78 ) );
  AddDetail( ({ "franzoesischlektion", "lektion" }), 
                break_string( "Nein, hier kriegst du keine.", 78 ) );
  AddDetail( ({ "franzoesisches", "franzoesisch" }), 
                break_string( "Du willst hier wohl keine Franzoesischlektion "+
                "kriegen wollen, an so einer andachtsvollen Staette?", 78 ) );
  AddDetail( ({ "unterarm" }), 
                break_string( "Dein Unterarm schaut ganz normal aus.", 78 ) );
  AddDetail( ({ "elle" }), 
                break_string( "Naja, eine Elle ist entweder die Laenge "+
                "Deines Unterarms bis zum Handballen - oder was "+
                "franzoesisches - oder eine Elfe mit Tippfehler.", 78 ) );
  AddDetail( ({ "abstaende", "abstand" }), 
                break_string( "Die Abstaende zwischen den Fackeln sind sehr "+
                "gering. Vielleicht 1 Elle?", 78 ) );
  AddDetail( ({ "fackel", "fackeln" }), 
                break_string( "Sie bilden ein wahres Lichtermeer. Ueberall "+
                "an den Waenden sind sie mit kleinen Abstaenden verteilt.", 78 ) );
  AddDetail( ({ "kapelle", "zwergenkapelle" }), 
                break_string( "Sie ist wirklich wunderschoen. "+
                "Gottesfuerchtig wie Du nun einmal bist, laesst Du Dich "+
                "nieder, um zu beten.", 78 ) );
  AddDetail( ({ "berg" }),
                break_string( "Felonia ist offensichtlich in den Berg "+
                "hineingehauen worden.", 78 ) );
  AddReadDetail("inschrift", "Sie besagt: 'Von Gott gegeben, von Gott genommen'.\n");

  AddDetail( ({"tafel", "heldentafel"}),
    "Die Heldentafel haengt neben dem Altar. Auf ihr sind die groessten "
    "Helden der Zwerge eingetragen. Du kannst sie lesen.");
  AddReadDetail( ({"heldentafel", "tafel"}), #'tafel);

  AddSmell(DEFAULT_SMELL, bs("Es riecht nach Weihrauch, nach Kapelle.\n"));

  AddSmell(({"weihrauch", "rauch"}), bs("Der Weihrauch riecht unglaublich "+
        "beruhigend, was er ja auch soll.\n"));
  AddSmell(({"kapelle", "kirche"}), bs("Hier riecht es nach Weihrauch.\n"));
  AddSmell("duft", "Es riecht irrsinnig gut nach Weihrauch hier herinnen.\n");


  AddSound(DEFAULT_SOUND, bs("Du bildest Dir ein, sphaerische Klaenge ertoenen zu hoeren.\n"));

  AddSound(({"klaenge", "sphaerische klaenge"}), bs("Hmm... jetzt wo Du "+
	"genau hinhoeren willst, kannst Du sie gar nicht mehr hoeren?\n"));

  AddCmd ("bete","bete");

 AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
 AddItem("/obj/zeitungsautomat", REFRESH_REMOVE);
 AddItem (NPC("zwerg2"), REFRESH_DESTRUCT);

 AddExit("sueden", ROOM("gang10"));

}
bete() {
  write ("Du kniest nieder und haeltst eine kurze Andacht.\n");
  if (this_player()->QueryProp(P_GHOST))
  {
    say ("Der Geist von "+this_player()->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say (this_player()->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    this_player()->SetProp(P_GHOST,0);
  }
  else
    say (this_player()->name()+" kniet nieder und haelt eine kurze Andacht.\n");
  return 1;
}

string tafel()
{
  TP->more("/etc/topzwerge.read",1);
  return "";
}

vorhangzu() {
  call_other(DOOR_MASTER, "SetDoorStatus", "/d/gebirge/dusty/hoch/room/vorr", -1);
  write("Der Vorhang verschliesst sich von selbst wieder.\n");
  say("Die Vorhang verschliesst sich, nachdem "+TPN+" durchgegangen ist, von selbst wieder.\n");

}
