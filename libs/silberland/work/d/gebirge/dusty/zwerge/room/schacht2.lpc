inherit "std/room";

#include <properties.h>
#include "../files.h"

create()

{

::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Im Schacht");
 SetProp(P_INT_LONG, bs ("Du stehst in einem engen Schacht. "+
	"Licht ist jedoch noch gerade genug hier, dass du ohne Fackel "+
	"sehen kannst. Du kannst das Ende dieses eigentlich doch ziemlich "+
	"kurzen Schachtes schon problemlos erkennen."));

  AddDetail( ({ "wand" }), 
                break_string( "Die Wand ist ca. 1 Meter von Dir entfernt. "+
                "Das macht etwa 2 Meter Durchmesser vom Schacht.", 78 ) );
  AddDetail( ({ "ende" }), 
                break_string( "Aus Maus Paus.", 78 ) );
  AddDetail( ({ "licht" }), 
                break_string( "Noch nicht genug da, um gut zu sehen.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Direkt unter Dir ist noch keiner, aber "+
                "tiefer unten kannst Du ihn schon erkennen.", 78 ) );
  AddDetail( ({ "schacht", "verbindungsschacht" }), 
                break_string( "Der Schacht hat ungefaehr 2 Meter "+
                "Durchmesser. Du stehst schon knapp ueber dem Boden, also "+
                "quasi dem Ende (oder dem Anfang?) des Schachtes.", 78 ) );
  AddDetail( ({ "klettersprossen", "sprossen" }),
                break_string( "Sie ziehen sich durch den ganzen Schacht. "+
                "Wie sonst sollte man ihn denn hinauf/hinunter kommen?", 78 ) );

 AddExit("oben", ROOM("schacht1"));
 AddExit("unten", ROOM("schacht3"));
}
