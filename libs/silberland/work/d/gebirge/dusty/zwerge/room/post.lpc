inherit "/std/post";
#include "../files.h"
#include "properties.h"

create ()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Zwergenpost");
 SetProp(P_INT_LONG, bs("Du stehst im Postgebaeude der Zwerge. ALLES was du "+
	"siehst, ist gelb, gelb und nochmal gelb. Gibt es denn keine Post, "+
	"die etwas variiert in ihrem Aussehen? Wie auch immer, wenn Du "+
	"Post erledigen willst, dann tu es einfach hier - mit 'post'. "+
	"Wenn Du privat Post schreiben willst, dann geh einfach in die "+
	"Schreibkabinen."));

  AddDetail( ({ "post" }), 
                break_string( "Du stehst hier in der Post.", 78 ) );
  AddDetail( ({ "forscherpunkt", "forscherpunktesucher" }), 
                break_string( "Also fuer dieses Detail kriegst Du sicher "+
                "keinen!", 78 ) );
  AddDetail( ({ "detail", "details" }), 
                break_string( "Nein, aufhoeren! *argl* Immer diese laestigen "+
                "Forscherpunktesucher...", 78 ) );
  AddDetail( ({ "geldgier", "magierzwerg", "typo" }), 
                break_string( "Wir wollen mal keine unnuetzen Details "+
                "untersuchen, hm? ;)", 78 ) );
  AddDetail( ({ "geld" }), 
                break_string( "Das war die Geldgier eines Magierzwerges, der "+
                "diesen Typo gemacht hat. :)", 78 ) );
  AddDetail( ({ "gelb" }), 
                break_string( "GELB GELB GELD GELB GELB GELB...", 78 ) );
  AddDetail( ({ "kabine", "schreibkabine", "schreibkabinen", 
                "postkabine", "postkabinen", "kabinen" }), 
                break_string( "Die Schreibkabinen, in denen Du ungestoert "+
                "Briefe schreiben kannst.", 78 ) );
  AddDetail( ({ "boden", "decke", "wand", 
                "waende" }), 
                break_string( "Gelb.", 78 ) );
       AddDetail( ({ "staub", "staubschicht", "schicht" }),
               "Du malst gelangweilt einige Kreise in den Staub.\n");

	AddItem("/std/postschalter");
	AddExit("osten", ROOM("gang05"));
}
