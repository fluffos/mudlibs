//Eine Himbeere, Kapellgarten
//Dusty@Silberland, Maerz 1998

inherit "std/food";

#include "../files.h"
#include <properties.h>
#include <food.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Eine Himbeere");
 SetProp(P_LONG, bs("Du haeltst eine wunderschoene, saftige und dunkelrote "+
	"Himbeere in den Haenden, die mit ihrem ganzen wunderbaren Koerper"+
	"bau ja foermlich danach verlangt, vernascht zu werden.\n"));
 SetProp(P_GENDER, FEMALE);
 SetProp(P_WEIGHT, 10);
 SetProp(P_VALUE, 15);
 AddId(({"beere", "himbeere"}));
 SetProp(P_INFO, "Die Himbeere kann man essen!\n");
 SetProp(P_NAME, "Himbeere");
 SetProp(P_MATERIAL, MAT_FRUIT);

 AddDetail(({"bau", "koerperbau"}), "Sie ist wunderschoen.\n");

 SetProp(P_SMELL, "Die Himbeere riecht eigentlich nach garnix.\n");

  SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 5}), F_SOAK : 2,
	F_MSG:"Du vernascht genuesslich die Himbeere.\n",
	F_MSG_ROOM:"verspeist verzueckt eine Himbeere.\n"]));

}

