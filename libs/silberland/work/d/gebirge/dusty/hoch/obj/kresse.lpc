//Ein zartes Kressepflaenzchen, Kapellgarten
//Dusty@Silberland, Maerz 1998

inherit "std/food";

#include "../files.h"
#include <properties.h>
#include <food.h>

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Kresse");
 SetProp(P_LONG, bs("Eine zartes Kressepflaenzchen, jung und kraeftig. "+
	"Sein kleines Wurzelchen ist sicher leicht verdaulich.\n"));
 SetProp(P_GENDER, NEUTER);
 SetProp(P_WEIGHT, 100);
 SetProp(P_VALUE, 15);
 AddId(({"pflaenzchen", "kresse", "kressepflaenzchen"}));
 SetProp(P_INFO, "Das Pflaenzchen ist sicher gesund!\n");
 SetProp(P_NAME, "Kressepflaenzchen");
 SetProp(P_MATERIAL, MAT_MISC_PLANT);

 AddDetail(({"wurzel", "wurzelchen"}), "Das bisschen Erde, das da noch oben ist, kannst Du leicht verdauen.\n");
 AddDetail("erde", "Es ist nur eine kleine Spur davon auf der Wurzel, das macht Dir sicher nichts!\n");

 SetProp(P_SMELL, "Das Kressepflaenzchen riecht nach Kraeutern.");

  SetProp(P_FOOD_INFO, ([F_HEAL : ({3, 8}), F_SOAK : 2,
	F_MSG:"Du knusperst das zarte Pflaenzchen.\n",
	F_MSG_ROOM:"knuspert ein zartes Pflaenzchen Kresse.\n"]));

}

