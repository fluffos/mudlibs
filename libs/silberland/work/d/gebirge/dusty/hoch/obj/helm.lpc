//Ameisenhelmchen
//Dusty@Silberland, Jaenner 1998

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"
#include <armour.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"helm", "helmchen", "ameisenhelm", "ameisenhelmchen"}));
  SetProp (P_SHORT, "Ein Ameisenhelmchen");
  SetProp (P_LONG, bs("Das kleine Helmchen einer kleinen Ameise, die "+
	"sicherlich auf Futtersuche war, als sie jemand umgebracht hat.\n"));
  SetProp (P_NAME, "Helmchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 50);
  SetProp (P_VALUE, 50);
  SetProp(P_INFO, "Das Helmchen einer kleinen Ameise.\n");
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 2);
  SetProp (P_MATERIAL, ([MAT_CORK:100])); 
  SetProp (P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:"Ameise"]) );
}
