//Fellchen
//Dusty@Silberland, Juli 1997

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"fellchen", "fell","wuslerfell","\nfell_is_gerb_able"}));
  SetProp (P_SHORT, "Ein kleines Fellchen");
  SetProp (P_LONG, bs("Ein Fellchen, das wohl mal einem Wusler gehoert hat, "+
	"nun aber offensichtlich in Deine Haende gekommen ist.\n"));
  SetProp (P_NAME, "Fellchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 50);
  SetProp(P_INFO, "Das Fellchen kann man anziehen!\n");
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 2);
  SetProp (P_MATERIAL, ([MAT_PELT:100]));
}
