//Dusty@Silberland, Jaenner 1998

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"steinchen", "stein"}));
  SetProp (P_SHORT, "Ein Steinchen");
  SetProp (P_LONG, bs("Du siehst ein kleines Steinchen. Allerdings schaut "+
	"dieses Steinchen keineswegs gewoehnlich aus, nein! Es scheint, "+
	"als ob da kleine Einschlaege von Gold darinnen waeren. Sicherlich "+
	"kann man dieses Steinchen gut verkaufen!\n"));
  SetProp (P_NAME, "Steinchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 150);
  SetProp(P_INFO, "Das Steinchen ist sicher was wert!\n");
  SetProp (P_MATERIAL, ([MAT_STONE:95,MAT_GOLD:5]));
}
