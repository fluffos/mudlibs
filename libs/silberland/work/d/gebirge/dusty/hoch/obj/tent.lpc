//Tentakel
//Dusty@Silberland, Juli 1997

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"tentakel", "tent", "tentakeln"}));
  SetProp (P_SHORT, "Ein Paar Tentakel");
  SetProp (P_LONG, bs("Hmm, es sieht so aus, als ob Du die Tentakel des "+
	"Steingreifers als Waffe benutzen koenntest! Versuch mal, sie "+
	"zu zuecken!\n"));
  SetProp(P_ARTICLE, 0);
  SetProp (P_NAME, "Tentakel");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 50);
  SetProp(P_INFO, "Die Tentakel kann man zuecken!\n");
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp (P_WC, 30);

}
