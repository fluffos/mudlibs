/*
** Ein Wusler, HE
** 1997 - Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wusel", "wusler"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Wusler");
  SetProp (P_SHORT, "Ein Wusler");
  SetProp (P_LONG, bs("Der Wusler kuckt Dich lieb an. Er hat zwei winzige "+
	"Aeuglein, die etwas aus seinem Koepfchen hervortreten. Am ganzen "+
	"Koerper bedeckt ihn ein weiches Fellchen, weshalb er auch so wuselig "+
	"erscheint."));

 create_default_npc(1);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 40);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit wuseligen Pfoetchen", 40, DT_BLUDGEON}) );
  SetProp (P_SIZE, 10);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Wusler");
  
  SUID;


  CLONEME (OBJ("fell"));
  command ("ziehe fell an");

  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Der Wusler wuselt wuselig um Dich herum.\n",
	"Der Wusler niest kraeftig.\n",
	"Der Wusler stolpert ueber sich selbst.\n"}));

  AddSpell(1,20, 
    "Der Wusler zwickt Dich kichernd ins Hinterteil.\n",
    "Der Wusler zwickt @WEN wohin.\n");

  SetProp (P_DIE_MSG, " haucht sein Leben aus.\n");
  SetProp (P_DEFAULT_INFO, "wuselt ratlos um Dich herum.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Der Wusler wuselt Dir dankbar um die Fuesse."}));

  SetProp(P_MSGIN, "wuselt herein");      

}
