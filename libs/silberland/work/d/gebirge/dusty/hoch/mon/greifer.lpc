/*
** Ein Steingreifer, HE
** 1997 - Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"steiner", "steingreifer", "greifer"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Steingreifer");
  SetProp (P_SHORT, "Ein kleiner Steingreifer");
  SetProp (P_LONG, bs("Das ist ein kleiner Steingreifer. Seinen Namen hat "+
	"er nicht zu unrecht, denn er baut seine Nester aus Steinchen. "+
	"Er hat zwei haessliche Tentakel am Kopf und ziemlich starke "+
	"Vorderbeine, die er dazu benuetzt, die Steinchen wegzurollen.\n"));

 create_default_npc(1);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 40);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen Tentakel", 50, DT_WHIP}) );
  SetProp (P_SIZE, 3);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Steingreifer");
  
  SUID;

  CLONEME (OBJ("tent"));

  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Der Steingreifer zieht Dir mit den Tentakel eins ueber.\n"}));

  AddSpell(1,20, 
    "Der Steingreifer versetzt Dir einen Hieb.\n",
    "Der Steingreifer versetzt @WEM einen Hieb.\n");

  SetProp (P_DIE_MSG, " haucht sein Leben aus.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf steingreifisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Der Steingreifer schnappt nach Dir."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
