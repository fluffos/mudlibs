inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"", "tier", "monster", ""}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "");
  SetProp (P_SHORT, "");
  SetProp (P_LONG, bs(""+
	"\n"));

 create_default_npc(2);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihren Fuehlern ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1);

  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"\n"}));

  AddSpell(1,30, 
    "\n",
    "\n");

  SetProp (P_DIE_MSG, " \n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	""}));

  SetProp(P_MSGIN, "");      

}
