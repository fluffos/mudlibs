/*
**Assel, HE
** 1997- Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"assel", "tier", "monster", "assl"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Assel");
  SetProp (P_SHORT, "Eine Assel");
  SetProp (P_LONG, bs("Die Assel windet sich vor Dir auf dem Boden herum. "+
	"Sie ist weisslichrosa, und eigentlich ziemlich ekelhaft.\n"));

 create_default_npc(1);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Leib", 30, DT_BLUDGEON}) );
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_SIZE, 1);
  SetProp(P_RACE, "Assel");

  SUID;

  SetChats(1, ({
	"Die Assel windet sich.\n",
	"Die Assel ekelt Dich an.\n",
	"Die Assel kriecht am Boden herum.\n"}));

  SetProp (P_DIE_MSG, " stirbt.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
   	"Die Assel interessiert sich nicht fuer solche Dinge."}));

  SetProp(P_MSGIN, "kriecht herein");      

}
