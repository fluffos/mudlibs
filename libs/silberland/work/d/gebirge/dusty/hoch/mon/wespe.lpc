/*
** Wespe, HE
** 1997- Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"
#include <mnpc.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wespe", "tier", "monster", ""}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Wespe");
  SetProp (P_SHORT, "Eine Wespe");
  SetProp (P_LONG, bs("Diese Wespe ist auch nicht gerade das freundlichste "+
	"Geschoepf, das Du je getroffen hast. Oder wenn sie freundlich ist - "+
	"Warum poliert sie dann ihren Stachel und grinst Dich hinterhaeltig "+
	"und gemein an?\n"));

 create_default_npc(2);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Stachel", 30, DT_POISON}) );
  SetProp (P_SIZE, 3);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_RACE, "Wespe");
  
  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Wespe summt Dir um den Kopf herum.\n",
	"Die Wespe hat bestimmt nichts Gutes im Sinn.\n"}));

  AddSpell(1,30, ({
    "Die Wespe piekst Dich.\n",
    "Die Wespe grinst Dich an.\n"}));

  SetProp (P_DIE_MSG, " summt ins Reich der verstorbenen Wespen.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Wespe kassiert deine Gabe.\n"}));

  SetProp(P_MSGIN, "kommt angeflogen");      
  SetProp(P_MSGOUT, "fliegt");

 SetProp (P_MNPC_AREA, ROOM("garten"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("garten5"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

}
