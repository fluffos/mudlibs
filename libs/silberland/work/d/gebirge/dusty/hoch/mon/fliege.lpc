inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"
#include <mnpc.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"fliege", "tier", "monster", "schnake"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Fliege");
  SetProp (P_SHORT, "Eine normale Fliege");
  SetProp (P_LONG, bs("Die Fliege surrt um Dich herum, um Dich zu aergern. "+
	"Da das in der Natur der Fliegen liegt, ist dies auch nicht weiter "+
	"verwunderlich. Ausserdem hat sie sechs Beine, zwei Fluegel und einen "+
	"ekeligen Saugruessel.\n"));

 create_default_npc(2);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, -100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihren Fluegeln", 30, DT_AIR}) );
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_SIZE, 1);

  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Fliege legt ein Ei auf Dir ab.\n",
	"Die Fliege surrt bedrohlich.\n",
	"Die Fliege ahmt einen Staubsauger nach.\n",
	"Die Fliege kitzelt Dich am Oberarm.\n"}));

  AddSpell(1,30, 
    "Die Fliege fliegt Dir mitten ins Gesicht, ekelhaft!\n",
    "@WEM fliegt eine Fliege mitten ins Gesicht. \n@WER sieht gruen und gelb um den Mund aus.\n");

  AddDetail(({"ruessel","saugruessel"}),
	"Er ist wirklich eklig....\n");

  SetProp (P_DIE_MSG, " fliegt ins Jenseits.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo (({"dusty", "woody", "gott"}), "summt: 'Sssssssummmmm'\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
   	"Die Fliege ist zu klein, um etwas zu tragen.\n"}));

  SetProp(P_MSGIN, "fliegt herein");      
  SetProp(P_MSGOUT, "fliegt hinaus");

  SetProp (P_MNPC_AREA, ROOM("garten"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("garten6"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

}
