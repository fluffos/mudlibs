/*
** Wurm, HE
** 1997- Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wurm", "tier", "monster", ""}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Wurm");
  SetProp (P_SHORT, "Ein Wurm");
  SetProp (P_LONG, bs("Der Wurm hat kein erkennbares Gesicht oder Hinterteil. "+
	"Er ist etwa 5 Zentimeter lang und rosa. Er windet sich, um sich "+
	"fortzubewegen.\n"));

 create_default_npc(3);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit seinem ganzen Koerper", 30, DT_BLUDGEON}) );
  SetProp (P_SIZE, 5);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_RACE, "Wurm");
  
  SUID;


  SetChats(1, ({
	"Der Wurm windet sich nach links.\n",
	"Der Wurm windet sich nach rechts.\n",
	"Der Wurm windet sich vorwaerts. \n"
	"Der Wurm windet sich rueckwaerts.\n"}));

  SetProp (P_DIE_MSG, " hat sein Leben ausgelebt.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
   	"Den Wurm wurmt es, dass er Dein Geschenk nicht tragen kann."}));

  SetProp(P_MSGIN, "wurmt herein");      

}
