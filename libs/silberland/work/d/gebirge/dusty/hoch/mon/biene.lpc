/*
** Biene, HE
** 1997- Dusty
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"
#include <mnpc.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"biene", "tier", "monster", "maja"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Biene");
  SetProp (P_SHORT, "Eine Biene");
  SetProp (P_LONG, bs("Die Biene ist scheinbar grade auf der Suche nach "+
	"Nektar, um ihre Nachkommen zu versorgen. Zu Schade, dass die "+
	"Imker ihr wahrscheinlich alles wegnehmen werden.\n"));

 create_default_npc(3);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit lautem Summen", 30, DT_SOUND}) );
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_SIZE, 2);
  SetProp(P_RACE, "Biene");

  SUID;

  SetProp(P_SPELLRATE,20);

  AddSpell(1, 30,({
	"Die Biene sticht Dich mit ihrem Stachel und stirbt nicht dabei.\n",
	"Die Biene sticht @WEN.\n"}));	
  AddSpell(1, 25,({
 	"Die Biene attackiert Dich und trifft Dich am Kopf.\n",
	"Die Biene attackiert @WEN und trifft auch.\n"}));

  SetChats(1 , ({
    "Die Biene summt summt summt immer im Kreis herum.\n",
    "Die Biene versucht, aus Deinem Schienbein Nektar zu gewinnen.\n"}));

  SetProp (P_DIE_MSG, " summt ein letztes Mal.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Biene sammelt alles auf."}));

 SetProp (P_MNPC_AREA, ROOM("garten"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("garten4"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

  SetProp(P_MSGIN, "summt herein");      
  SetProp(P_MSGOUT, "summt hinaus");
}
