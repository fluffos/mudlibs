/*
** Steinhuepfer
** 1997 - Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"huepfer", "steinhuepfer", "steiner", "hupfer"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Steinhuepfer");
  SetProp (P_SHORT, "Ein kleiner Steinhuepfer");
  SetProp (P_LONG, bs("Joeeee! Ein kleiner Steinhuepfer! Ist der aber "+
	"niedlich! Er huepft von Steinchen zu Steinchen, und ist staendig "+
	"auf der Suche nach Nahrung. Ob er sich von klitzekleinen Steinchen "+
	"ernaehrt? Oder vielleicht doch nur von langweiligen Insekten? "+
	"Pass auf, sonst huepft er Dir gleich wieder davon!\n"));

 create_default_npc(3);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen Sprungfluegeln", 30, DT_BLUDGEON}) );
  SetProp (P_SIZE, 3);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Huepfer");
  
  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Der Huepfer huepft herum.\n"}));

  AddSpell(1,30, 
    "Der Steinhuepfer zieht Dir eine ueber.\n",
    "Der Steinhuepfer zieht @WEM eine ueber.\n");

  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf huepfisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  CLONEME(OBJ("stein"));

  SetProp( P_REJECT, ({ REJECT_DROP,
   	"Der Steinhuepfer ist zu schwach, um sich mit diesem Ding zu beladen."}));

  SetProp(P_MSGIN, "huepft herein");      

}
