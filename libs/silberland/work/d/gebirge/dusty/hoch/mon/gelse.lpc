/*
** Gelse, HE
** 1997- Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"gelse", "tier", "monster", "goessn", "schnake"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Gelse");
  SetProp (P_SHORT, "Eine Gelse");
  SetProp (P_LONG, bs("Eine blutgierige Gelse schaut Dich an. Du schauderst. "+
	"Hat sie sich jetzt wirklich die Lippen geleckt oder war das "+
	"doch nur Deine Einbildung?\n"));

 create_default_npc(4);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Stechstachel", 30, DT_POISON}) );
  SetProp (P_SIZE, 1);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Gelse");
  
  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Gelse reinigt sich ihren Stachel, um besser zubeissen zu koennen.\n",
	"Die Gelse macht *mieeeeeeee*\nDu erschauderst.\n",
	"Die Gelse grinst boese.\n"}));

  AddSpell(1,30, 
    "Die Gelse saugt Blut aus Deinem Koerper.\n",
    "Die Gelse saugt Blut aus @WESSEN Koerper.\n");

  SetProp (P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp (P_DEFAULT_INFO, "sagt: *mieeeeeee*.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
   	"Die Gelse hat zuwenig Kapazitaet um Dinge mitzunehmen."}));

  SetProp(P_MSGIN, "surrt herein");      

}
