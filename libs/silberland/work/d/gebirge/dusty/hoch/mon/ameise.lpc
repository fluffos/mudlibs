/*
**Ameise, HE
** 1997- Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"ameise", "tier", "monster", "bmeise"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Ameise");
  SetProp (P_SHORT, "Eine kleine Ameise");
  SetProp (P_LONG, bs("Du siehst eine klitzekleine Ameise, sei vorsichtig, "+
	"damit Du sie nicht zertrittst! Sie ist wohl grad auf Futtersuche "+
	"unterwegs. Sei aber vorsichtig, mit ihren groesseren Verwandten "+
	"solltest Du Dich besser nicht anlegen!\n"));

 create_default_npc(2);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihrem Koerper", 30, DT_BLUDGEON}) );
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_SIZE, 1);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Ameise");

  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Ameise wackelt mit dem Kopf.\n"}));

  AddSpell(1,30, 
    "Die Ameise wuselt um Dich herum und beisst Dich in den Zeh.\n",
    "Die Ameise beisst @WEN in den kleinen Zeh.\n");

  SetProp (P_DIE_MSG, " stirbt jaemmerlich.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf ameisisch.\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Die Ameise laedt sich Deine Gabe auf den Ruecken."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
