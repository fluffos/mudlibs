/*
** Hornisse, HE
** 1997- Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"
#include <mnpc.h>

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"hornisse", "tier", "monster", ""}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Hornisse");
  SetProp (P_SHORT, "Eine boese Hornisse");
  SetProp (P_LONG, bs("Die Hornisse brummt Dich zornig an. Sie hat bestimmt "+
	"Hunger, und Lust darauf, lieben Bienen ihren Honig wegzunehmen, um "+
	"ihn selber zu verspeisen. Sie ist bestimmt kein guter Zeitgenosse.\n"));

 create_default_npc(2);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, -100);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit gefaehrlichem Brummen", 30, DT_SOUND}) );
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_SIZE, 3);
  SetProp(P_RACE, "Hornisse");
  
  SUID;

  SetProp(P_SPELLRATE,20);

  SetChats(1, ({
	"Die Hornisse brummt zornig herum.\n",
	"Die Hornisse ueberlegt, ob sie Dich jetzt oder spaeter stechen soll.\n",
	"Die Hornisse summt was von: 'Faulem Willi'.\n"}));

  SetProp (P_DIE_MSG, " brummt was unverstaendliches und stirbt.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Gierig nimmt die Hornisse alles an sich.\n"}));

  SetProp(P_MSGIN, "fliegt herein");      

 SetProp (P_MNPC_AREA, ROOM("garten"));
  SetProp (P_MNPC_WAIT, ({ 10, 50, 100 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("garten6"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

}
