/*
** Ein Maulwurf, HE
** 1997 - Dusty
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../room/files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wurf", "maulwurf"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Maulwurf");
  SetProp (P_SHORT, "Ein kleiner Maulwurf");
  SetProp (P_LONG, bs("Der kleine Maulwurf hat sich wohl hier an die  "+
	"Oberflaeche verirrt. Er ist voellig blind hier, und scheinbar "+
	"auch ziemlich orientierungslos.\n"));

 create_default_npc(5);
  SetProp(P_ARTICLE, 1);
  SetProp (P_ALIGN, 40);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen Fuesschen", 50, DT_BLUDGEON}) );
  SetProp (P_SIZE, 10);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RACE, "Maulwurf");
  
  SetProp(P_SPELLRATE,10);

  SetChats(1, ({
	"Der Maulwurf probiert, sich ein Loch zu graben.\n",
	"Der Maulwurf fuerchtet sich vor Dir.\n",
	"Der Maulwurf zittert ein wenig.\n"}));

  SetProp (P_DIE_MSG, " haucht sein Leben aus.\n");
  SetProp (P_DEFAULT_INFO, "antwortet Dir etwas auf wuerfisch\n");
  AddInfo (({"dusty", "woody", "gott"}), "faellt auf die Knie und sagt: 'Oh Gott!'\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
   	"Der Maulwurf ist verwirrt, nimmt es sich aber trotzdem alles."}));

  SetProp(P_MSGIN, "krabbelt herein");      

}
