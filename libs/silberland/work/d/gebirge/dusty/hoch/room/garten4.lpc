#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Kapellgarten");
  SetProp (P_INT_LONG,
    "Du bist im Kapellgarten. Rundum hindern die Gebirgswaende "+
    "Deine Sicht. Gras bedeckt den Boden, Blumen wachsen hier in "+ 
    "Huelle und Fuelle, denn die Berge lassen gnaedigerweise die Sonne hier "
    "den ganzen Tag hereinscheinen.");

  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "berg" }), 
                break_string( "Die Berge begrenzen den Garten hier im Norden "+
                "und Westen.", 78 ) );
  AddDetail( ({ "nacht" }), 
                break_string( "In der Nacht ist es finster, da die Sonne "+
                "auch mal schlafen muss.", 78 ) );
  AddDetail( ({ "tag" }), 
                break_string( "Im Gegensatz zur Nacht ist im Moment Tag.", 78 ) );
  AddDetail( ({ "huelle", "fuelle" }), 
                break_string( "Ja, Blumen gibt es hier in Huelle, und auch "+
                "in Fuelle.", 78 ) );
  AddDetail( ({ "teufel" }), 
                break_string( "Du hoffst instaendig, dass Du ihm nie "+
                "begegnest.", 78 ) );
  AddDetail( ({ "rot" }), 
                break_string( "Rot, so rot wie der Teufel.", 78 ) );
  AddDetail( ({ "gruen" }), 
                break_string( "Gruen wie das Gras, nur leuchtender.", 78 ) );
  AddDetail( ({ "blau" }), 
                break_string( "Schoenes, leuchtendes Blau.", 78 ) );
  AddDetail( ({ "farben" }), 
                break_string( "Blau, Gruen, Rot, Gelb, Lila, Orange, "+
                "Zitron... huch?", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Viele viele verschiedene Blumen in vielen "+
                "verschiedenen Farben.", 78 ) );
  AddDetail( ({ "sinne" }), 
                break_string( "Ich hoff, Du hast noch alle beisammen.", 78 ) );
  AddDetail( ({ "sicht" }), 
                break_string( "Du hast keine, denn die Aussicht wird dir "+
                "versperrt.", 78 ) );
  AddDetail( ({ "silberland" }), 
                break_string( "Diese Welt hier ist das SilberLand.", 78 ) );
  AddDetail( ({ "aussicht" }), 
                break_string( "Die Berge versperren sie Dir.", 78 ) );
  AddDetail( ({ "gebirgswaende" }), 
                break_string( "Sie versperren Dir die Aussicht, die man "+
                "normalerweise von hier aus auf das SilberLand haette.", 78 ) );
  AddDetail( ({ "waende" }), 
                break_string( "Im eigentlichen Sinne gibt es hier keine "+
                "Waende, sondern nur Gebirgswaende.", 78 ) );
  AddDetail( ({ "launen" }), 
                break_string( "Gute Launen, schlechte Launen...", 78 ) );
  AddDetail( ({ "laune" }), 
                break_string( "Jeder von uns hat so seine Launen, nicht "+
                "wahr?", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne ist heute guter Laune, sie laechelt "+
                "Dir zu.", 78 ) );
  AddDetail( ({ "himmel" }), 
                break_string( "Die Sonne laechelt vom Himmel herab.", 78 ) );
  AddDetail( ({ "garten", "kapellgarten" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail( ({ "berge" }), 
                break_string( "Die Berge begrenzen den Garten hier im Norden "+
                "und Westen.", 78 ) );
  AddDetail( ({ "gebirge" }), 
                break_string( "Hoch!", 78 ) );
  AddDetail( ({ "gras" }), 
                break_string( "Das Gras ist grasgruen!", 78 ) );
  AddDetail( ({ "latschen" }), 
                break_string( "Diese Latschen stehen einsam und allein auf "+
                "der Ebene herum.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
    "Der Boden ist gruen. Das kommt vielleicht vom Gras?");

  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));
  AddSmell( ({"blumen"}), "Himmlisch!\n");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("garten1"));
  AddExit ("osten", ROOM("garten5"));

  // EXITS END

  // ITEMS START
  AddItem(NPC("huepfer"), REFRESH_DESTRUCT);
  AddItem(NPC("biene"), REFRESH_DESTRUCT);
  // ITEMS END

}
