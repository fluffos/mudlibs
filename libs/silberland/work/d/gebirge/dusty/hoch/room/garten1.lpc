#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Der Kapellgarten");
  SetProp (P_INT_LONG,
	"Du stehst im Kapellgarten, der sich im Norden der Kapelle befindet. "+
	"Nach Norden und Osten kannst Du weitergehen, um im Freien ueber "
 	"den Sinn des Lebens nachzudenken - oder auch um hier ein paar "
	"kleineren Tierchen zu begegnen, die auch jemand, der noch nicht "
	"so stark ist, erledigen kann. Der Boden hier ist zart begruent.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "nadelbaum", "nadelbaeume" }), 
                break_string( "Die haben keine Blaetter, nein.", 78 ) );
  AddDetail( ({ "blaetter", "blatt" }), 
                break_string( "Blaetter haben Baeume auch, vorausgesetzt es "+
                "sind keine Nadelbaeume.", 78 ) );
  AddDetail( ({ "stamm" }), 
                break_string( "Der Stamm eines Baumes ist meistens braun, "+
                "ausser es handelt sich um einen hellen Baum.", 78 ) );
  AddDetail( ({ "baeume" }), 
                break_string( "Baeume stehen fuer gewoehnlich in Waeldern "+
                "oder so herum... sie koennen aber auch ganz wo anders "+
                "stehen, wo sie ueberhaupt nicht hinpassen.", 78 ) );
  AddDetail( ({ "wald" }), 
                break_string( "Du siehst den Wald manchmal vor lauter "+
                "Baeumen nicht, hm?", 78 ) );
  AddDetail( ({ "trichter" }), 
                break_string( "Du weisst doch wohl, wie ein Trichter "+
                "aussieht?", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne scheint hier freundlich.", 78 ) );
  AddDetail( ({ "enzian" }), 
                break_string( "Enzian siehst Du hier nicht.", 78 ) );
  AddDetail( ({ "blau" }), 
                break_string( "Blau, so blau wie der Enzian...", 78 ) );
  AddDetail( ({ "kapelle" }), 
                break_string( "Die Kapelle befindet sich im Sueden.", 78 ) );
  AddDetail( ({ "baum", "baeume" }), 
                break_string( "Stamm braun, Blaetter gruen, elfenfreundlich.", 78 ) );
  AddDetail( ({ "lichtung" }), 
                break_string( "Eine Lichtung ist ein Teil eines Waldes, wo "+
                "sich Baeume nicht mehr zu wachsen trauen, weil sie sonst den "+
                "Elfen im Weg stehen wuerden.", 78 ) );
  AddDetail( ({ "elfen" }), 
                break_string( "Wenn Du wirklich wissen willst, was Elfen "+
                "sind, dann gib einfach mal: 'hilfe elfen' ein. Aber nur, "+
                "wenn Du Dir das echt antun willst.", 78 ) );
  AddDetail( ({ "licht", "sonnenlicht" }), 
                break_string( "Sonnenlicht stroemt hier fast den ganzen Tag "+
                "herein.", 78 ) );
  AddDetail( ({ "gebirge" }), 
                break_string( "Das Gebirge umgibt den Kapellgarten voellig. "+
                "Es kommt jedoch genug Sonnenlicht herein, damit Gras wachsen "+
                "kann, denn das Gebirge ist aehnlich geformt wie ein "+
                "Trichter.", 78 ) );
  AddDetail( ({ "meer" }), 
                break_string( "Das Meer selber siehst Du hier nicht, aber "+
                "der Himmel hat ein aehnliches Blau.", 78 ) );
  AddDetail( ({ "himmel" }), 
                break_string( "Der Himmel ist blau, so blau wie das Meer.", 78 ) );
  AddDetail( ({ "gebirgsgras" }), 
                break_string( "Gebirgsgras ist robuster als das "+
                "verweichlichte Gras, das zum Beispiel bei den Elfen auf "+
                "einer Lichtung waechst. Darum haelt es auch die Hoehe besser "+
                "aus.", 78 ) );
  AddDetail( ({ "flecken" }), 
                break_string( "Braune Flecken kannst Du hier nicht erkennen. "+
                "Nur schoenes, gruenes, gesundes Gras.", 78 ) );
  AddDetail( ({ "ende" }), 
                break_string( "Dann ist das Leben aus, wenn es zu Ende ist.", 78 ) );
  AddDetail( ({ "tod" }), 
                break_string( "Der Tod ist das Ende des Lebens.", 78 ) );
  AddDetail( ({ "tierchen" }), 
                break_string( "Alles Tierchen, die man auch als Anfaenger "+
                "hier noch zu toeten vermag. Obwohl das Kapitel Tod "+
                "eigentlich in so einem schoenen Garten gar nichts zu suchen "+
                "haette.", 78 ) );
  AddDetail( ({ "leben", "sinn" }), 
                break_string( "Du gruebelst ueber den Sinn des Lebens nach, "+
                "kommst aber nicht dahinter, und beschliesst, das Leben "+
                "einfach nur zu geniessen.", 78 ) );
  AddDetail( ({ "frei", "freien" }), 
                break_string( "Hier im Freien ist die Luft so klar, der "+
                "Himmel so blau....", 78 ) );
  AddDetail( ({ "kapellgarten", "garten" }), 
                break_string( "Du stehst im Moment im Kapellgarten, das stimmt.", 78 ) );
  AddDetail( ({ "hoehe" }), 
                break_string( "Auf dieser Hoehe ist es nicht mehr "+
                "selbstverstaendlich, dass Gras so schoen gruen waechst. "+
                "Schliesslich sind wir ja hier trotz allem im Gebirge.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
    "Der Boden ist gruen. Das kommt vielleicht vom Gras?");
  AddDetail ( ({"gras"}),
    "Das Gras ist gruen, sogar grasgruen. Es ist nicht sehr hoch, es scheint "+
    "gut gepflegt zu sein, da es auch auf dieser Hoehe ohne braune Flecken "
    "wachsen kann. Vermutlich ist es Gebirgsgras.");
  AddDetail ( ({"zwerg", "zwerge"}),
    "Das sind die Bewohner des Berges, sehr edle Lebewesen.");
  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));
  AddSmell( ({"blumen"}), "Betoerend!\n"); 
   // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("garten4"));
  AddExit ("osten", ROOM("garten2"));

  // EXITS END

NewDoor( "sueden", 
"/d/gebirge/dusty/hoch/room/vorr",({"portal","holzportal"}),
        ({ D_NAME,"Holzportal",
           D_GENDER, NEUTER,
           D_FLAGS, (DOOR_RESET_CL|DOOR_CLOSED),
           D_MSGS,({"durch das Holzportal", "geht durch das Holzportal", 
                     "kommt durch das Holzportal herein"}),
           D_SHORT,"Das Holzportal im Sueden ist %s. ",
           D_LONG, "Das Holzportal fuehrt in den Vorraum des Gartens." 
                         
                                   }));  
                                                                                          

  // ITEMS START
  AddItem( ({ (NPC("wusler")), (NPC("assel")) }), REFRESH_DESTRUCT);
 
  // ITEMS END

}
