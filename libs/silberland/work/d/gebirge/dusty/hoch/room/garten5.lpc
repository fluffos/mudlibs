#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Kapellgarten");
  SetProp (P_INT_LONG,
    "Im Kapellgarten. Du kommst Dir total frei und "+
    "ungezwungen vor. Und das, obwohl im Norden die Gebirgswand Dich daran "
    "hindert, den Kapellgarten zu verlassen... naja, schliesslich willst "
    "Du ja auch gar nicht von hier weg. Wie auch sonst im Kapellgarten ist "
    "der Boden hier begruent, Blumen aller Arten und Formen wachsen hier. "
    "Ausserdem faellt Dir auf, dass der Berg eigentlich einen grossen "
    "Trichter um den Kapellgarten gebildet hat, der den Garten vor "
    "Eindringlingen schuetzt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "himmel" }), 
                break_string( "Die Sonne laechelt vom Himmel herab.", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne ist heute guter Laune, sie laechelt "+
                "Dir zu.", 78 ) );
  AddDetail( ({ "maechte" }), 
                break_string( "Gute Maechte, boese Maechte.", 78 ) );
  AddDetail( ({ "eindringling", "eindringlinge" }), 
                break_string( "Hier kommt sicher kein Eindringling rein, "+
                "dafuer sorgen die guten Maechte des Berges.", 78 ) );
  AddDetail( ({ "zwerge" }), 
                break_string( "Die Bewohner von Felonia sind Zwerge.", 78 ) );
  AddDetail( ({ "hobbitdorf", "dorf" }), 
                break_string( "Dort gibt es viele Hobbits. Im Gegensatz zu "+
                "hier, hier sind eher kleine Zwerge oefter vertreten.", 78 ) );
  AddDetail( ({ "kuh" }), 
                break_string( "Eine Kuh kannst Du vermutlich eher in der "+
                "Naehe des Hobbitdorfes finden.", 78 ) );
  AddDetail( ({ "gebirge" }), 
                break_string( "Das Gebirge ist wirklich gewaltig.", 78 ) );
  AddDetail( ({ "trichter" }), 
                break_string( "Wie ein Trichter legt sich das Gebirge um den "+
                "Kapellgarten.", 78 ) );
  AddDetail( ({ "berg" }), 
                break_string( "Um Dich herum ist weit und breit nur Berg.", 78 ) );
  AddDetail( ({ "muehe" }), 
                break_string( "Ja, sehr muehsam waere das.", 78 ) );
  AddDetail( ({ "arten"}),
                break_string( "Viele verschiedene Arten, die Muehe, die das "+
                "machen wuerde, die alle zu untersuchen, magst Du Dir "+
                "gar nicht erst machen, glaube mir.", 78 ) );
  AddDetail( ({ "formen"}),
                break_string( "Viele verschiedene Formen, die Muehe, die das "+
                "machen wuerde, die alle zu untersuchen, magst Du Dir "+
                "gar nicht erst machen, glaube mir.", 78 ) );
                                                  
  AddDetail( ({ "blumen" }), 
                break_string( "Viele viele verschiedene Blumen leuchten Dir "+
                "entgegen.", 78 ) );
  AddDetail( ({ "triebe" }), 
                break_string( "Junge, zarte Triebe, die sicher froh sind, "+
                "dass es hier keine Kuh gibt.", 78 ) );
  AddDetail( ({ "gebirgsgras" }), 
                break_string( "Gebirgsgras ist genauso wie Gras, aber nicht "+
                "so empfindlich. Deswegen kann Gebirgsgras auch in hohen "+
                "Hoehen wachsen.", 78 ) );
  AddDetail( ({ "gras" }), 
                break_string( "Zartes Gebirgsgras entwickelt junge Triebe.", 78 ) );
  AddDetail( ({ "wand", "gebirgswand" }), 
                break_string( "Sie ist im Norden.", 78 ) );
  AddDetail( ({ "garten", "kapellgarten" }), 
                break_string( "Ja, Du stehst im Kapellgarten.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
      "Der Boden ist gruen. Daran ist hauptsaechlich das Gras schuld. Ausserdem "
          "stehen hier eine Menge Blumen herum.");  // DETAILS END

  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));
  AddSmell( ({"blumen"}), "Suess!\n");
  // EXITS START
  AddExit ("westen", ROOM("garten4"));
  AddExit ("sueden", ROOM("garten2"));
  AddExit ("osten", ROOM("garten6"));

  // EXITS END

  // ITEMS START
  AddItem(NPC("wespe"), REFRESH_DESTRUCT);
  AddItem(NPC("greifer"), REFRESH_DESTRUCT);
  // ITEMS END

}
