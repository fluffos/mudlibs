#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Vorraum");
  SetProp (P_INT_LONG,
	"Du stehst im Vorraum des Kapellgartens. Hier stehen einige "+
	"alte Gartenmoebel sowie ein Tischchen, ansonsten ist der Raum "
 	"bis auf ein paar Regale an der Wand ziemlich kahl. "
	"Trotz allem sieht es hier nicht unordentlich aus, ausserdem "
	"riecht es hier betoerend gut.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "weiss" }), 
                break_string( "Eine grauweisses Weiss.", 78 ) );
  AddDetail( ({ "tupfen" }), 
                break_string( "Gruene und braune!", 78 ) );
  AddDetail( ({ "prachtstueck", "stueck" }), 
                break_string( "Der Blumentopf war frueher einmal ein "+
                "Prachtstueck, jetzt ist er eigentlich ziemlich unansehnlich.", 78 ) );
  AddDetail( ({ "punkte", "punkt" }), 
                break_string( "Viele Punkte sind auf diesem Blumentopf.", 78 ) );
  AddDetail( ({ "braun" }), 
                break_string( "Unschoenes Braun. Yuck!", 78 ) );
  AddDetail( ({ "gruen" }), 
                break_string( "Gruene Punkte.", 78 ) );
  AddDetail( ({ "farbe" }), 
                break_string( "Der Blumentopf ist gruen und braun getupft.", 78 ) );
  AddDetail( ({ "nichts" }), 
                break_string( "Gar nichts!", 78 ) );
  AddDetail( ({ "holz" }), 
                break_string( "Das Portal ist aus Holz.", 78 ) );
  AddDetail( ({ "regal" }), 
                break_string( "Regale an den Waenden.", 78 ) );
  AddDetail( ({ "blumentoepfe", "toepfe" }), 
                break_string( "Ziemlich alt und nicht richtig sauber.", 78 ) );
  AddDetail( ({ "verzierungen", "verzierung" }), 
                break_string( "Zuviel gesagt. Einfache Steinchen, weiss. ", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Weiss und uninteressant.", 78 ) );
  AddDetail( ({ "erde" }), 
                break_string( "Erdig. Braun und dreckig.", 78 ) );
  AddDetail( ({ "steine", "stein", "steinchen" }), 
                break_string( "Weisse Steinchen. Schoen anzusehen!", 78 ) );
  AddDetail( ({ "blumentriebe", "triebe" }), 
                break_string( "Sie heissen auch Setzlinge.", 78 ) );
  AddDetail( ({ "setzlinge", "ableger" }), 
                break_string( "Das sind kleine Blumentriebe.", 78 ) );
  AddDetail( ({ "kaesten" }), 
                break_string( "Alte Kaesten zum Zuechten von Setzlingen, "+
                "Ablegern u.ae.", 78 ) );
  AddDetail( ({ "besonderes" }), 
                break_string( "Nichts!", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Die Waende sind ziemlich kahl, ausser Regalen "+
                "an den Waenden faellt Dir nichts Besonderes auf.", 78 ) );
  AddDetail( ({ "zeiten" }), 
                break_string( "Frueher waren die Zeiten besser (fuer die "+
                "Hocker).", 78 ) );
  AddDetail( ({ "hocker" }), 
                break_string( "Die Hocker sind schwer und haben schon mal "+
                "bessere Zeiten gesehen.", 78 ) );
  AddDetail( ({ "tisch", "tischchen", "gartentisch" }), 
                break_string( "Ein Gartentisch, der sicher schon viel "+
                "gesehen hat. Ausser einem Blumentopf, der mitten "+
                "auf dem Tisch steht, bemerkst nichts Besonderes daran.", 78 ) );
  AddDetail( ({ "stein" }), 
                break_string( "Steinhart, der Stein!", 78 ) );
  AddDetail( ({ "seiten" }), 
                break_string( "An den Seiten ist der Blumentopf schon etwas "+
                "abgeschlagen.", 78 ) );
  AddDetail( ({ "blumentopf", "topf" }), 
                break_string( "Der Blumentopf muss mal ein Prachtstueck "+
                "gewesen sein, jetzt ist er an den Seiten angeschlagen, auch "+
                "die Farbe ist groesstenteils schon herunten.", 78 ) );
  AddDetail( ({ "geschirr", "gartengeschirr" }), 
                break_string( "Alte Blumentoepfe, viereckige Kaesten zum "+
                "Zuechten von Setzlingen.... ziemlich uninteressant.", 78 ) );
  AddDetail( ({ "regale" }), 
                break_string( "In den Regalen findest Du altes "+
                "Gartengeschirr.", 78 ) );
  AddDetail( ({ "sessel", "gartensessel" }), 
                break_string( "Gartensessel aus Stein, sie sehen schon "+
                "ziemlich verwittert aus.", 78 ) );
  AddDetail( ({ "moebel", "gartenmoebel" }), 
                break_string( "Ziemlich antik aussehende, aus Stein "+
                "bestehende Sessel, ein Tischchen und zwei Hocker.", 78 ) );
  AddDetail( ({ "vorraum", "raum" }), 
                break_string( "Du bist im Vorraum des Kapellgartens.", 78 ) );
  AddDetail( ({ "kapelle" }), 
                break_string( "Die Kapelle befindet sich im Sueden.", 78 ) );
  AddDetail( ({ "licht", "sonnenlicht" }), 
                break_string( "Sonnenlicht stroemt hier nur herein, wenn jemand "+
                "das Portal zum Garten offengelassen hat.", 78 ) );
  AddDetail( ({ "kapellgarten", "garten" }), 
                break_string( "Der Kapellgarten ist im Norden, da bist Du Dir "
                "sicher.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
    "Der Boden ist teilweise mit Erde bedeckt, teilweise mit Steinchen verziert.");
  AddDetail ( ({"zwerg", "zwerge"}),
    "Das sind die Bewohner des Berges, sehr edle Lebewesen.");
  AddSmell(DEFAULT_SMELL, bs("Es riecht hier betoerend nach Blumen und Weihrauch.\n"));
  AddSmell( ({"blumen"}), "Es riecht hier wirklich intensiv nach Blumen.\n"); 
  AddSmell( ({"weihrauch","rauch"}), "Der Duft des Weihrauchs kommt wohl aus der Kapelle.\n"); 
   // DETAILS END

  // EXITS START

NewDoor( "sueden",
    "/d/gebirge/dusty/zwerge/room/kapelle",({"vorhang","schwerer vorhang"}),
        ({ D_NAME,   "Vorhang",
           D_GENDER, MALE,
           D_FLAGS,  (DOOR_RESET_CL|DOOR_CLOSED),
           D_MSGS,   ({"durch den Vorhang",
                    "geht durch den Vorhang, kommt durch den Vorhang herein"}),
           D_SHORT,  "Im Sueden siehst Du einen %sen Vorhang.",
           D_FUNC2,  "vorhangzu",
           D_LONG,   "Der Vorhang verhindert, "+
                     "dass Licht von hier in die Kapelle dringt."
                   }));

 NewDoor( "norden",
     "/d/gebirge/dusty/hoch/room/garten1",({"portal","holzportal"}),
       ({ D_NAME,   "Holzportal",
          D_GENDER, NEUTER,
          D_FLAGS,  (DOOR_RESET_CL|DOOR_CLOSED),
          D_MSGS,   ({"durch das Holzportal",
                  "geht durch das Portal, kommt durch das Holzportal herein"}),
          D_SHORT,  "Noerdlich von Dir befindet sich ein %ses Holzportal.",
          D_LONG,   "Das Holzportal fuehrt in den Kapellgarten." 
          }));

  // EXITS END

  // ITEMS START
  // ITEMS END

}

vorhangzu() 
{
  DOOR_MASTER->SetDoorStatus("/d/gebirge/dusty/zwerge/room/kapelle", -1);
  write("Der Vorhang verhuellt den dahinterliegenden Raum wieder.\n");
  say("Die Vorhang schliesst sich, nachdem "+TPN+" durchgegangen ist.\n");
}
