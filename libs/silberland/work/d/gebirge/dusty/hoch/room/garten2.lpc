#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Kapellgarten");
  SetProp (P_INT_LONG,
    "Der Kapellgarten ist wirklich wunderwunderschoen. "
    "Der Boden ist hier begruent, es wachsen auch einige Blumen, "+
    "sogar Insekten gibt es hier. Felonias Einwohner haben sich wirklich "
    "Muehe gegeben, diesen vermutlich einst oeden Platz, der ganz von Bergen "
    "umgeben ist, zu begruenen und Lebensraum fuer Tiere und Pflanzen zu "
    "schaffen, der noch dazu fuer alle Einwohner der Stadt als "
    "Erholungsgebiet zur Verfuegung steht.");

  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "ferien" }), 
                break_string( "JUHU! ", 78 ) );
  AddDetail( ({ "kinder" }), 
                break_string( "Kinder sind im Sommer gluecklich, weil sie "+
                "Ferien haben.", 78 ) );
  AddDetail( ({ "verfuegung" }), 
                break_string( "Der Kapellgarten steht allen zu selbiger.", 78 ) );
  AddDetail( ({ "felonia" }), 
                break_string( "Das ist die Stadt der Zwerge.", 78 ) );
  AddDetail( ({ "muehe" }), 
                break_string( "Viel muehe haben sich die Einwohner von "+
                "Felonia da gegeben, wirklich!", 78 ) );
  AddDetail( ({ "himmel" }), 
                break_string( "Der Himmel ist blau, die Sonne lacht.", 78 ) );
  AddDetail( ({ "hobbits", "hobbit", "elfen", "elf","dunkelelf", "dunkelelfen", "troll", "trolle", "oger", "fee", "feen" }), 
                break_string( "Die wirst Du noch kennenlernen.", 78 ) );
  AddDetail( ({ "mensch" }), 
                break_string( "Korrigiere. Mensch, Hobbit, Zwerg, Fee, Troll, Oger. Jaaa, und "+
                "auch Dunkelelf und normaler Elf.", 78 ) );
  AddDetail( ({ "erholungsgebiet" }), 
                break_string( "Dieser Garten hier dient als Erholungsgebiet "+
                "fuer Mensch und Tier.", 78 ) );
  AddDetail( ({ "stadt" }), 
                break_string( "Felonia natuerlich, welche Stadt denn sonst?", 78 ) );
  AddDetail( ({ "einwohner", "bewohner" }), 
                break_string( "Zwerge sind die Einwohner Felonias.", 78 ) );
  AddDetail( ({ "veilchen" }), 
                break_string( "Violette Veilchen.", 78 ) );
  AddDetail( ({ "lebensraum" }), 
                break_string( "Dieser Garten hier ist Lebensraum fuer Tier "+
                "und Pflanze.", 78 ) );
  AddDetail( ({ "felswand", "wand" }), 
                break_string( "Die Wand ist glatt, je hoeher sie wird, desto "+
                "mehr lehnt sie sich zurueck.", 78 ) );
  AddDetail( ({ "berge" }), 
                break_string( "Im Sueden ist eine Felswand, das Gebirge "+
                "tuermt sich weiter im Norden auf.", 78 ) );
  AddDetail( ({ "hirn" }), 
                break_string( "Der Inhalt des Kopfes.", 78 ) );
          
  AddDetail( ({ "kopf" }), 
                break_string( "Auf Deinem Hals. Hoffentlich.", 78 ) );
  AddDetail( ({ "spinat" }), 
                break_string( "WAS? Spinat? Wie ist denn der zwischen diese "+
                "Blumen gekommen? Du schuettelst den Kopf. Manchmal haben "+
                "Zwerge doch ein ziemlich eigenwilliges Hirn.", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne scheint hier freundlich.", 78 ) );
  AddDetail( ({ "freibad" }), 
                break_string( "In ein Freibad geht man, wenn einem sehr "+
                "heiss ist, und die Sonne scheint. Meistens im Sommer.", 78 ) );
  AddDetail( ({ "sommer" }), 
                break_string( "Die Jahreszeit des Freibads, der gluecklichen "+
                "Kinder, der (ver)bluehenden Blumen und der waermenden Sonne.", 78 ) );
  AddDetail( ({ "schnee" }), 
                break_string( "Schnee liegt hier keiner.", 78 ) );
  AddDetail( ({ "winter" }), 
                break_string( "Die Jahreszeit des Schnees.", 78 ) );
  AddDetail( ({ "fruehling" }), 
                break_string( "Das ist die Jahreszeit nach dem Winter, also "+
                "vor dem Sommer.", 78 ) );
  AddDetail( ({ "schneegloeckchen" }), 
                break_string( "Die gibt es hier nur im Fruehling.", 78 ) );
  AddDetail( ({ "wildgloeckchen" }), 
                break_string( "Wildgloeckchen sind die engsten Verwandten "+
                "der Schneegloeckchen, allerdings gibt es Wildgloeckchen das "+
                "ganze Jahr ueber.", 78 ) );
  AddDetail( ({ "raender" }), 
                break_string( "Die Raender sind richtig ausgefranst. "+
                "Ausgefraest?", 78 ) );
  AddDetail( ({ "fransen" }), 
                break_string( "Die Raender der Fraesien sind ausgefranst.", 78 ) );
  AddDetail( ({ "fraesien" }), 
                break_string( "Als Du die Fraesien naeher begutachtest, "+
                "bemerkst Du, dass ihre Raender ganz ausgefranst sind.", 78 ) );
  AddDetail( ({ "rosenstengel" }), 
                break_string( "Die Rosenstaengel sind braun.", 78 ) );
  AddDetail( ({ "rosen", "tulpen", "nelken" }), 
                break_string( "Rosen, Tulpen, Nelken. All die verwelken nicht, im "+
                "Gegensatz zu dem allbekannten Sprichwort. Zumindest nicht, "+
                "solange man sie nicht ausreisst.", 78 ) );
  AddDetail( ({ "sprichwort", "wort" }), 
                break_string( "Naja, Rosen, Tulpen, Nelken... aeh, Du weisst schon. ", 78 ) );
                
  AddDetail( ({ "stengel" }), 
                break_string( "Die Stengel aller Blumen hier sind gruen, bis "+
                "auf die der Rosen.", 78 ) );
  AddDetail( ({ "innenleben" }), 
                break_string( "Das Gaensebluemchen hat ein gelbes "+
                "Innenleben.", 78 ) );
  AddDetail( ({ "blaetter" }), 
                break_string( "Blumen haben Blaetter.", 78 ) );
  AddDetail( ({ "gaensebluemchen" }), 
                break_string( "Die Gaensebluemchen haben weisse kleine "+
                "Blaetter und ein gelbes Innenleben. Die Stengel sind gruen.", 78 ) );
  AddDetail( ({ "blumen", "pflanze", "pflanzen" }), 
                break_string( "Du siehst Gaensebluemchen, Rosen, Spinat, "+
                "Tulpen, Nelken, Fraesien, Wildgloeckchen und Veilchen.", 78 ) );
  AddDetail( ({ "kapellgarten", "garten" }), 
                break_string( "Du stehst mitten im Kapellgarten.", 78 ) );
  AddDetail( ({ "gebirge" }), 
                break_string( "Das Gebirge begrenzt diesen Garten.", 78 ) );
  AddDetail( ({ "zwerg", "zwerge" }), 
                break_string( "Die Zwerge sind die Bewohner des Gebirges, "+
                "gleich im Suedwesten!", 78 ) );
  AddDetail( ({ "insekten" }), 
                break_string( "Du siehst zwar im Moment keine, aber hoeren "+
                "kannst Du sie!", 78 ) );
  AddDetail( ({ "gebirgsgras" }), 
                break_string( "Gebirgsgras ist widerstandsfaehiger als "+
                "normales Gras. Muss es auch sein, denn sonst koennte es in "+
                "dieser doch eher rauhen Gegend nicht gedeihen.", 78 ) );
  AddDetail( ({ "gras" }), 
                break_string( "Gras spriesst hier in Huelle und Fuelle. Es "+
                "scheint Gebirgsgras zu sein.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
    "Der Boden ist gruen. Daran ist hauptsaechlich das Gras schuld. Ausserdem "+
    "stehen hier eine Menge Blumen herum.");

  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));
  AddSmell( ({"blumen"}), "Bezaubernd!\n");
  
  AddSound(DEFAULT_SOUND, bs("Du hoerst Insekten brummen.\n"));

 
  
  // DETAILS END

  // EXITS START
  AddExit ("osten", ROOM("garten3"));
  AddExit ("norden", ROOM("garten5"));
  AddExit ("westen", ROOM("garten1"));

  // EXITS END

  // ITEMS START
  AddItem( ({ (NPC("gelse")), (NPC("wurm")) }), REFRESH_DESTRUCT);
  // ITEMS END

}
