#include <properties.h>
#include <moving.h>

#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Kapellgarten");
  SetProp (P_INT_LONG,
   "Der Kapellgarten ist hier im Osten und Sueden durch Berge begrenzt. Davon "
   "unbeeindruckt zeigen sich alle Lebewesen hier, denn hier gruent und "
   "blueht und lebt alles, was man sich nur vorstellen kann. Man kann "
   "hier so richtig mit der Seele baumeln... Dass Zwerge so einen Garten "
   "erschaffen koennen, zeugt von handwerklicher Faehigkeit und Liebe "
   "zum Leben." );
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "himmel" }), 
                break_string( "Die Sonne steht am Himmel.", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne laechelt vom Himmel herab.", 78 ) );
  AddDetail( ({ "gegend" }), 
                break_string( "Mit der Gegend kann man hier.. achnein, mit "+
                "der Seele kann man in der Gegend... baumeln. Ach lassen wir "+
                "das...", 78 ) );
  AddDetail( ({ "redensart" }), 
                break_string( "Das hier ist auch kein Forscherpunkt.", 78 ) );
  AddDetail( ({ "huelle", "fuelle" }), 
                break_string( "Argh, das ist doch nur eine Redensart!", 78 ) );
  AddDetail( ({ "leben" }), 
                break_string( "Leben gibt es hier in Huelle und Fuelle!", 78 ) );
  AddDetail( ({ "liebe" }), 
                break_string( "Liebe ist..... schoen?", 78 ) );
  AddDetail( ({ "faehigkeit" }), 
                break_string( "Zwerge sind handwerklich sehr begabt. "+
                "Ueberhaupt sind Zwerge eigentlich toll!", 78 ) );
  AddDetail( ({ "bewohner" }), 
                break_string( "Bewohner sind Leute, die wohnen. Das ist aber "+
                "schon logisch?!?", 78 ) );
  AddDetail( ({ "du" }), 
                break_string( "Also Du muesstest schon wissen, wer/was Du "+
                "bist!", 78 ) );
  AddDetail( ({ "zwerge" }), 
                break_string( "Das sind die Bewohner des Berges, sehr edle "+
                "Lebewesen.", 78 ) );
  AddDetail( ({ "seele" }), 
                break_string( "Deine Seele kann hier richtig gut "+
                "baumeln.",  78 ) );
  AddDetail( ({ "wildkraut" }), 
                break_string( "Wildkraut waechst so wie es will und wo es "+
                "will.", 78 ) );
  AddDetail( ({ "unkraut" }), 
                break_string( "Oh. Natuerlich nicht Unkraut, sondern "+
                "Wildkraut.", 78 ) );
  AddDetail( ({ "aehnliches" }), 
                break_string( "Hmm... naja, anderes Unkraut halt.", 78 ) );
  AddDetail( ({ "pflanzen" }), 
                break_string( "Blumen, Gras und aehnliches.", 78 ) );
  AddDetail( ({ "forscherpunkt" }), 
                break_string( "Nein, es war keiner!", 78 ) );
  AddDetail( ({ "stueck" }), 
                break_string( "Nein, das hier war jetzt kein Forscherpunkt.", 78 ) );
  AddDetail( ({ "blumenarten","arten" }), 
                break_string( "Viele verschiedene, mindestens 28,5 Stueck!", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Du siehst viele verschieden Blumenarten, die "+
                "Du aber alle nicht naeher kennst.", 78 ) );
  AddDetail( ({ "gras" }), 
                break_string( "Gras macht den Boden hier grasgruen. "+
                "(Ueberrascht?)", 78 ) );
  AddDetail( ({ "tier" }), 
                break_string( "Im Moment siehst du gerade keins, aber weiter "+
                "im Westen sicher!", 78 ) );
  AddDetail( ({ "getier" }), 
                break_string( "Hauptsaechlich kleine Tiere gibt es hier in "+
                "diesem Garten, aber die hast Du sicher schon gesehen!", 78 ) );
  AddDetail( ({ "wasser" }), 
                break_string( "Gibt es hier scheinbar auch, weil sonst "+
                "koennte hier nicht soviel Leben gedeihen.", 78 ) );
  AddDetail( ({ "insel" }), 
                break_string( "Nicht die normale Insel mit Wasser drumherum, "+
                "sondern eine Insel im poetischen Sinne!", 78 ) );
  AddDetail( ({ "oase" }), 
                break_string( "Eine Insel an Freude, Entspannung, Ruhe und "+
                "Erholung.", 78 ) );
  AddDetail( ({ "paradies" }), 
                break_string( "Eine wahre Oase inmitten der kargen "+
                "Gebirgslandschaft ist das hier.", 78 ) );
  AddDetail( ({ "ameisen", "ameise" }), 
                break_string( "Sie scheinen sich recht wohl zu fuehlen, hier "+
                "in diesem Paradies.", 78 ) );
  AddDetail( ({ "wesen", "lebewesen" }), 
                break_string( "Zwerge, Ameisen, andere Insekten, Getier, Pflanzen, "+
                "Du.....", 78 ) );
  AddDetail( ({ "berge" }), 
                break_string( "Die Berge begrenzen diesen kleinen Garten im "+
                "Osten und Sueden.", 78 ) );
  AddDetail( ({ "kapellgarten", "garten" }), 
                break_string( "Du stehst darin.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
      "Der Boden ist gruen. Daran ist hauptsaechlich das Gras schuld. Ausserdem "
          "stehen hier eine Menge Blumen herum.");  
  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));  
  AddSmell( ({"blumen"}), "Hinreissend!\n");  
  AddCmd(({"baumel", "baumle"}), "baumel");


 // DETAILS END




  // EXITS START
  AddExit ("westen", ROOM("garten2"));
  AddExit("norden", ROOM("garten6"));

  // EXITS END

  // ITEMS START
  AddItem(NPC("ameise"), REFRESH_DESTRUCT);
  AddItem(NPC("fliege"), REFRESH_DESTRUCT);

  // ITEMS END

}
baumel (str)
 {
 notify_fail("Womit willst Du baumeln?\n");
 
 if (str != "seele" && str != "mit seele")
 	return 0;
 	
 	else
 	
 	write("Du baumelst ein wenig mit der Seele in der Gegend herum.\n");
 	return 1;
 	
 }
