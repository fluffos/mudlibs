// Dusty, Maerz 98

#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

int cloned;
int cloned2;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Im Kapellgarten");
  SetProp (P_INT_LONG,
    "Du stehst im Nordosteck des Kapellgartens. Hier ist ein kleines "
    "Beet angelegt, in dem kleine gruene Pflaenzchen versuchen, zu wachsen. "
    "Allem Anschein nach will hier jemand sich selbst mit Gemuese versorgen "
    "und hat sich diesen Teil des Gartens dazu umfunktioniert. Im Norden "
    "und Osten siehst Du die glatte Felswand, die sich immer weiter "
    "zurueckzieht, je hoeher sie wird. Dadurch entsteht ein Trichter, der "
    "den Kapellgarten vor neugierigen Blicken, wenn auch nicht von oben, "
    "aber doch immerhin von aussen bewahrt.");

  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "kraut" }), 
                break_string( "Kraut, Gemuese, was auch immer. Xund isses "+
                "halt! :-)", 78 ) );
  AddDetail( ({ "pracht" }), 
                break_string( "Praechtig!", 78 ) );
  AddDetail( ({ "blicke" }), 
                break_string( "Von aussen blickt hier niemand herein, ausser "+
                "der/die/dasjenige fliegt!", 78 ) );
  AddDetail( ({ "gaertner" }), 
                break_string( "Der hat hier allerhand angebaut.", 78 ) );
  AddDetail( ({ "fan" }), 
                break_string( "Na, der Gaertner hier war keiner. Zumindest "+
                "nicht von Gemuese. ", 78 ) );
  AddDetail( ({ "himbeere" }), 
                break_string( "Eine kleine rote Beere, die irrsinnig "+
                "appetitlich aussieht.", 78 ) );
  AddDetail( ({ "felswaende" }), 
                break_string( "Hier rund um den Kapellgarten herum sind "+
                "Felswaende.", 78 ) );
  AddDetail( ({ "himmel" }), 
                break_string( "Die Sonne steht am Himmel.", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Die Sonne laechelt vom Himmel herab.", 78 ) );
  AddDetail( ({ "gras" }), 
                break_string( "Das Gras macht den Boden gruen.", 78 ) );
  AddDetail( ({ "ausmasse" }), 
                break_string( "Gewaltig!", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Blumen in gewaltigen Ausmassen. Du bist "+
                "ueberwaeltigt.", 78 ) );
  AddDetail( ({ "felswand", "wand" }), 
                break_string( "Die Felswand weicht immer weiter zurueck, je "+
                "hoeher sie wird.", 78 ) );
  AddDetail( ({ "trichter" }), 
                break_string( "Der Garten ist durch das Gebirge, das den "+
                "Garten umgibt, vor allen Blicken von aussen (ausser von "+
                "oben) geschuetzt.", 78 ) );
  AddDetail( ({ "anschein" }), 
                break_string( "Anscheinend hat es den Anschein, als ob alles "+
                "nicht so ist, wie es scheint... scheinbar.", 78 ) );
  AddDetail( ({ "garten", "kapellgarten" }), 
                break_string( "Du stehst hier im Nordosteck des Gartens.", 78 ) );
  AddDetail( ({ "himbeeren" }), 
                break_string( "Hmm... die sehen aber gut aus! Vielleicht "+
                "kannst Du ja eine pfluecken?", 78 ) );
  AddDetail( ({ "fisolen" }), 
                break_string( "Fisolen gedeihen hier auch praechtig.", 78 ) );
  AddDetail( ({ "stange" }), 
                break_string( "Die Stange dient der Bohnenstange zum "+
                "Entlangschlaengeln.", 78 ) );
  AddDetail( ({ "bohnen", "bohnenstange" }), 
                break_string( "Die Bohnenstange waechst eine Stange entlang, "+
                "die eigens dafuer aufgestellt worden ist, um der "+
                "Bohnenstange was zum Schlaengeln zu geben.", 78 ) );
  AddDetail( ({ "gemuese" }), 
                break_string( "Ausser der Kresse, die ja eigentlich eher ein "+
                "Kraut als Gemuese ist, wachsen hier noch Bohnen, Fisolen und "+
                "Himbeeren. Scheinbar ist derjenige, der das hier gepflanzt "+
                "hat, doch kein so grosser Fan von Gemuese :-)", 78 ) );
  AddDetail( ({ "kresse" }), 
                break_string( "Kresse ist sehr gesund. Eventuell koenntest "+
                "Du ja eines der kleinen Pflaenzchen zum Kosten auszupfen?", 78 ) );
  AddDetail( ({ "beet" }), 
                break_string( "In dem Beet versuchen kleine Pflaenzchen, die "+
                "so aussehen, als wuerden sie mal zu Kresse werden, zu "+
                "wachsen.", 78 ) );
  AddDetail( ({ "pflaenzchen" }), 
                break_string( "Die Pflaenzchen versuchen zu wachsen.", 78 ) );
  AddDetail( ({ "eck", "nordosteck" }), 
                break_string( "Ja, hier im Nordosten siehst Du das "+
                "Nordosteck des Gartens.", 78 ) );
  AddDetail ( ({"boden", "grund"}),
      "Der Boden ist gruen. Daran ist hauptsaechlich das Gras schuld. Ausserdem "
          "stehen hier eine Menge Blumen herum.");  // DETAILS END

  AddSmell(DEFAULT_SMELL, bs("Es riecht hier hauptsaechlich nach Blumen.\n"));
  AddSmell( ({"blumen"}), "Beeindruckend voll im Geruch!\n");
  AddCmd( ({"pflueck", "pfluecke"}), "pflueck");
  cloned2=0;
  AddCmd( ({"zupf", "zupfe"}), "zupf");
  cloned=0;
  
  // EXITS START
  AddExit ("norden", "/d/gebirge/rage/quest/room/garten7");
  AddExit ("sueden", ROOM("garten3"));
  AddExit("westen", ROOM("garten5"));
  // EXITS END

  // ITEMS START
  AddItem(NPC("hornisse"), REFRESH_DESTRUCT);
  AddItem(NPC("wurf"), REFRESH_DESTRUCT);
  // ITEMS END

}

pflueck (str)
{
 notify_fail("Was willst Du denn pfluecken?\n");

  if (str != "beere" && str !="himbeere")
	return 0;
	
	if (cloned2)
	{
	write("Du willst die restlichen Himbeeren in Ruhe vor sich hin wachsen lassen.\n");
	return 1;
		}
	else
		write("Du pflueckst eine toll aussehende Himbeere.\n");
		clone_object(OBJ("himbeere"))->move(TP), M_GET;
		TK(TPN+" Himbeere!\n");
		cloned2++;	
	return 1;
	
	}
	
zupf (str)
{
 notify_fail("Was willst Du auszupfen?\n");
 
  if (str != "kresse" && str != "kresse aus" && str != "pflaenzchen" && str != "pflaenzchen aus")
          return 0;
          
      if (cloned)
              {
          write("Du laesst die Pflaenzchen doch lieber stehen.\n");
	return 1;
	      }
    else                  
    
          write("Du zupfst ein zartes Pflaenzchen Kresse aus.\n");
                 clone_object(OBJ("kresse"))->move(TP), M_GET;
		TK(TPN+" Kresse!\n");     
		cloned++;
     return 1;
}                                                                     
reset()
{
  ::reset();
  cloned=0;
  cloned2=0;
  }
