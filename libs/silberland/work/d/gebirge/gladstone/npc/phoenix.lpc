// Phoenix der Feuervogel (Konzept)

inherit "std/npc";

#include <properties.h>
#include "files.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <language.h>
#include <mnpc.h>
#include <moredef.h>
#ifndef AddProp
#define AddProp(x,y) SetProp(x, QueryProp(x)+y)
#endif

int breathdamage;


create()
{
   
   if (!is_clone(this_object())) return;
   
   ::create();

SetProp( P_SHORT, "Phoenix der Feuervogel" );
SetProp( P_LONG, BS(
	"Du siehst einen Riesenvogel namens Phoenix. Viele "
	"Geschichten hast du schon ueber dieses wundersame "
        "Wesen gehoert und gelesen, aber hier steht er nun "
        "wahrhaftig in seiner maechtigen Gestalt vor dir und "
        "laesst dich ganz mickrig wirken. Lange brauchst Du "
        "nicht ueberlegen, ob du dich mit ihm ueberhaupt anlegen "
        "willst, das tut er schon von alleine .......... "));
SetProp( P_NAME, "Phoenix" );
SetProp( P_INFO, BS("Der Phoenix ist umgeben von einer magischen "
	"Schutzhuelle, die ihn gegen fast alle denkbaren Angriffe "
        "unverwundbar macht. "));
SetProp( P_ARTICLE, 0);
SetProp( P_GENDER, MALE);
AddId(( {"vogel" , "feuervogel" , "riesenvogel" , "phoenix" }));
set_living_name( "phoenix" );
SetProp( P_SMELL, "Der Phoenix riecht nach Asche und Vernichtung.\n");
SetProp(P_MAX_HANDS, 2);
SetProp(P_HANDS, ({" mit seinen scharfen Krallen",500+random(50),
                 ({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));

create_default_npc (60);

SetProp( P_ATTRIBUTES, ([A_INT:100, A_DEX:70, A_STR:60, A_CON:60 ]) );
SetProp( P_BODY, 500 +random(100));
SetProp( P_NOMAGIC, 50);
SetProp( P_ALIGN, 0);
SetProp( P_HEAL, 0);

SetProp(P_MAX_HANDS, 2);
SetProp( P_AGGRESSIVE, 0);
SetProp( P_FOOD, 0);
SetProp( P_RACE, "Vogel");
SetProp( P_SIZE, 1000);
SetProp( P_MAX_HP, 2000);
SetProp( P_MAX_SP, 7000);
SetProp( P_NOCORPSE, 1);
SetProp( P_NOATTACK, 1);
SetProp( P_DIE_MSG, 
	 " verbrennt sich selbst in einer gewaltigen Feuerbrunst.\n");
SetProp( P_MURDER_MSG, 
	 "Du Feigling, ich bin ja nur ein Testi!!\n");
SetProp( P_KILL_NAME, "Phoenix" );

SetProp( P_REJECT, ({REJECT_DROP,
         "Du wirst doch sicher anderes im Sinn haben, als dem\n"
	+ "Phoenix deinen Krempel andrehen zu wollen!?\n" }) );

AddInfo( DEFAULT_INFO, "faucht nur etwas wie:\n"
	+ "GCHCHLLAEAEDSCHDOOOOONNN!!!\n" ); 

SetProp( P_RESISTANCE_STRENGTHS, ([DT_FIRE:-1.0, DT_POISON:-0.5,
	DT_MAGIC:-0.5, DT_SOUND:-0.5, DT_BLUDGEON:-0.5, DT_SLASH:-1.0,
	DT_RIP:-0.5, DT_TERROR:-0.5, DT_ACID:-0.5, DT_HOLY:-0.5,
	DT_COLD:0.5]));



SetProp( P_SPELLRATE, 90);

/*AddSpell( 2, 1000,
	"Der Phoenix schlitzt Dich mit seinem scharfen Schnabel auf.\n",
	"Der Phoenix schlitzt @WEN mit seinem scharfen Schnabel auf.\n",
	 DT_RIP,([SP_SHOW_DAMAGE:1]));

AddSpell( 3, 1000,
    "Der Phoenix versucht Dich mit seinen kraeftigen Beinen zu zerstampfen.\n",
    "Der Phoenix versucht @WEN mit seinen kraeftigen Beinen zu zerstampfen.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

AddSpell( 1, 400,
	"Der Phoenix versucht Dich wegzuschleudern.\n",
	"Der Phoenix versucht @WEN wegzuschleudern.\n",
	 DT_TERROR, "spell_away" );*/

AddSpell(1,150,
    "Der Phoenix paralysiert Dich.\n",
    "Der Phoenix paralysiert @WEN.\n",
     DT_BLUDGEON, "spell_sleep" );

breathdamage=(800 +random(200));
  AddSpell(1,1,
   "Der Phoenix laesst ueber alle einen Feuersturm los.\n",
   "Der Phoenix laesst ueber alle einen Feuersturm los.\n",
    ({DT_FIRE}),"breath_spell");

SetAttackChats(10, ({
  "Der Phoenix faucht Dich an.\n",
  "Die Erde bebt!!\n",
  "Der Phoenix fuehrt seltsame Bewegungen mit seinen Fluegeln aus.\n",
  "Du stehst im Angesicht des Todes.\n",
  "Deine Herzfrequenz ist auf einer bedenklichen Hoehe.\n",
  "Schweissgebadet stehst du dem Phoenix gegenueber.\n",
  "Der Phoenix hebt seinen Kopf und .................\n",
  "Flucht waere jetzt das beste .............\n",
  "Die Augen des Phoenix leuchten auf.\n",
  "Du ueberlegst nicht doch Magier zu werden ........\n",
  "Die scharfen Krallen des Phoenix kommen Dir gefaehrlich nah.\n"}) );

}


void breath_spell(object enemy,int damage, mixed dam_type)
{
  int i,j;
  object *inv; 
  object *armours;
  
  inv=filter_array(all_inventory(environment(this_object())), #'living );
  for(i=sizeof(inv)-1;i>=0;i--) 

  
    {
      inv[i]->Defend(random(breathdamage), dam_type, 
       ([SP_SHOW_DAMAGE:1,SP_NAME:"Dragonbreath"]), this_object());
      armours=inv[i]->QueryProp(P_ARMOURS); 
      for(j=0;j<sizeof(armours);j++)
      {
        if( !random(3) && armours[i]->QueryProp(P_AC) && 
            !armours[i]->id("drachenruestung"))
        {
          armours[i]->SetProp(P_AC, armours[i]->QueryProp(P_AC)-1);
          armours[i]->SetProp(P_DAMAGED, armours[i]->QueryProp(P_DAMAGED)+1);
        }
      }
    }
  return;
}






void spell_away( object enemy, int damage, mixed dam_type )
{
switch (random (100))
{
case 0 .. 50:
enemy->do_damage(10);
enemy->move("/players/joscherl/workroom.lpc", M_NO_SHOW + M_TPORT);
tell_object (enemy, "Der Phoenix schafft es Dich wegzuschleudern.\n");

break;

case 51 .. 99:
enemy->do_damage(10);
tell_object( enemy, "Der Phoenix schafft es nicht Dich wegzuschleudern.\n");

default: write ("BUG!\n");
}
}
void spell_sleep(object enemy, int damage, mixed dam_type)
  {
  switch(random(100))
  {
  case 0 .. 30:
  enemy->SetProp(P_PARALYZED, ([PARALYZE_TIME: random(4), 
                                PARALYZE_MSG: "Aber Du bist doch bewusstlos!\n",
                                PARALYZE_MSG_OTHER: "",
                                PARALYZE_END: "Du erwachst wieder aus Deiner "
                                             +"Bewusstlosigkeit.\n",
                                PARALYZE_END_OTHER: "%s erwacht wieder aus "
                                             +TP->QueryPossPronoun(FEMALE, WEN,
                                             SINGULAR)
                                             +" Bewusstlosigkeit.\n"]));
  break;
  
  case 31 .. 99:
  enemy->do_damage(5);
  tell_object(enemy,
  "Du taumelst umher, wirst aber nicht ohnmaechtig.\n");
  }
  
  }

void init()
{
::init();

if(interactive(TP))call_out("hallo", 0);
}

void hallo()
{
tell_room(environment(), "Der Phoenix pfaucht "+CAP_TPN+" an.\n");
}

