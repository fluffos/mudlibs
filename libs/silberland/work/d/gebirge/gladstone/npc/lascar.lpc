// Dec1998 Gladstone@SilberLand
//Lascar der Vulkanforscher
// /d/gebirge/gladstone/npc/lascar.c


inherit "std/mnpc";

#include <properties.h>
#include "files.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <language.h>
#include <mnpc.h>
#include <moredef.h>

create()
{

if(!is_clone(this_object())) return;

	::create();

SetProp( P_SHORT, "Lascar der Vulkanforscher" );
SetProp( P_LONG, BS(
	"Lascar ist ein kleiner Hobbit, der sich sein ganzes Leben schon "
	"mit Vulkanen beschaeftigt hat. Er hat durch seine zahlreichen "
	"Forschungsarbeiten zahlreiche Abenteuer erlebt und sich Wissen "
	"ueber dieses Gebiet erarbeitet, dass ihm keiner Paroli bieten kann. " ) );
SetProp( P_ARTICLE, 0);
SetProp( P_NAME, "Lascar" );
SetProp( P_GENDER, MALE );
SetProp( P_RACE, "Hobbit" );
AddId(( { "lascar" , "vulkanforscher" , "forscher" } ));
SetProp( P_INFO, ( "Lascar weiss sehr viel ueber das Vulkangebiet.\n" ));
SetProp( P_NOATTACK, "Lass das lieber, Du wirst auf seine Hilfe noch angewiesen sein!\n" );
SetProp( P_REJECT, ({REJECT_DROP, "Lascar sagt aergerlich: Ich brauche keine Almosen!\n" } ));
SetProp( P_SIZE, 110 );
SetProp( P_ALIGN, 500 );
SetProp( P_MSGIN, "stapft herein" );
SetProp( P_MSGOUT, "stapft weiter" );
SetProp( P_MNPC_AREA, ( "/d/gebirge/gladstone/room" ) );
SetProp( P_MNPC_DEFAULTROOM, ( "/d/gebirge/gladstone/room/weg1.lpc" ) );
SetProp( P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS );
SetProp( P_MNPC_WAIT, ({ 1 , 20 , 10 }) );
SetProp( P_TEMPERATURE_RANGE, ([ 0:10 , 1:60 ]));
SetProp( P_MAX_HANDS, 2 );
SetProp(P_HANDS, ({" mit seinen Haenden",30,DT_BLUDGEON }));
create_default_npc (20);
set_living_name ( "lascar" );

AddInfo( DEFAULT_INFO, ({
"sagt: Keine Ahnung.\n",
"seufz: Fallen Dir keine besseren Fragen ein?\n",
"ueberlegt kurz und antwortet: Kenne ich nicht.\n",
"sagt: Davon steht nichts in meinen Buechern geschrieben.\n",
"antwortet: Also Du kannst vielleicht Fragen stellen!\n",
"wundert sich ueber deine Fragen.\n",
"arglt ein wenig herum.\n" } ) );
}