/* /d/gebirge/gladstone/room/vweg9.c */

/* Gladstone@SilberLand */

inherit "/d/gebirge/gladstone/room/stdvulkweg.lpc";
#include <properties.h>
#include <moving.h>
#include "files.h"

create()
{
	::create();

	SetProp( P_INT_LONG, BS(
		"Du stehst auf seltsamen Untergrund, umgeben von den bizarrsten Formen, "
		"die die Natur hervorzubringen vermag. Einen Weg kannst Du auf diesen "
		"Boden nicht ausmachen, jedoch siehst Du ein paar Spuren, die in drei "
		"Richtungen weiterfuehren. " ) );
	
	
	AddExit( "suedosten" , "/d/gebirge/gladstone/room/vweg10.lpc" );
	AddExit( "nordwesten" , "/d/gebirge/gladstone/room/vweg8.lpc" );

	AddCmd( ({"wag", "wage"}), "wagen" );

}

int wagen(string str)
{
  notify_fail("Wohin willst Du dich wagen?\n");
  
  if( str=="feld" || str=="in feld" || str=="felder" || str=="in felder")
  {
    write("Du stapfst mutig in die Phlegraischen Felder hinein.\n");
    TP->move( "/d/gebirge/gladstone/room/feld1.lpc" , M_GO, "auf die Phlegraeischen Felder", 
	"wagt sich", "wagt sich herein");
    return 1;
  }
  return 0;
}
