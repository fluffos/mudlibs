/* /d/gebirge/gladstone/room/vweg15.c */

/* Gladstone@SilberLand */

inherit "/d/gebirge/gladstone/room/stdvulkweg.lpc";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "files.h"

create()
{
	::create();

	SetProp( P_INT_LONG, BS(
		"Du stehst auf seltsamen Untergrund, umgeben von den bizarrsten Formen, "
		"die die Natur hervorzubringen vermag. Noerdlich von Dir ragt ein riesiger "
		"Vulkan in den Himmel, aus dessen Krater Rauch emporsteigt,  und im Sueden "
		"liegt das Gebirge. Ueberall entweichen dem von Asche ueberzogenen Boden "
		"kleine Dampfwoelkchen, kannst Du das Blubbern heisser Quellen vernehmen "
		"und zusammen mit dem finsteren Himmel ergibt das eine schon eigenartige "
		"Atmosphaere. Einen Weg gibt es hier nicht, doch erkennst Du ein paar Spuren, "
		"die in zwei Richtungen weiterfuehren." ) );
	

	AddExit( "osten" , "/d/gebirge/gladstone/room/vweg14.lpc" );

	AddExit( "westen" , "/d/gebirge/gladstone/room/anschluss2.lpc" );
	AddExit( "nordostoben" , "/d/gebirge/gladstone/room/vsteig1.lpc" );	
}