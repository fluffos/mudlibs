/* /d/gebirge/gladstone/room/fels.c */
/* Gladstone@SilberLand */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "files.h"



create()
{
	::create();

	SetProp( P_INT_SHORT, "Ein Felsvorsprung" );
	SetProp( P_INT_LONG, BS(
		"Du befindest dich auf einem Felsvorsprung und geniesst die herrliche "

		"Aussicht ueber das Silberland. Vor dir befindet sich in einer maechtigen " 
		"Felswand eine riesige Oeffnung, durch die du weiter in das Gebirgsmassiv "

		"vordringen kannst. Doch sollte Dir klar sein, dass dort einige Gefahren auf "

		"Dich lauern. ") );         
	

            SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]));
	



	AddDetail( ({ "vorsprung" , "felsvorsprung" }),
		"Du stehst darauf und geniesst die Aussicht.\n" );
	

	AddDetail( ({ "wand" , "fels" , "felswand" , "felsen" , "hoehe" }), BS(

		"Dein Blick wendet sich auf die steil nach oben fuehrende "

		"Felswand, deren Ende Du kaum ausmachen kannst. " ) );

	

	AddDetail ( ({ "ende" , "rand" }), BS(

		"Du blickst nochmals hinauf und kannst sehr wohl in schwindelnder "

		"Hoehe den Rand der Felswand sehen. " ) );



	AddDetail( ({ "aussicht" , "anblick" , "sicht" }), BS(

		"Du blickst hinunter in das weite Silberland und dir wird ganz "

                        "warm ums Herz bei diesem schoenen Anblick. Die hohen Berge "
	            "und die angenehme Ruhe wuerden dich hier so richtig entspannen "

	            "lassen, waere da nicht dieses ungute Gefuehl." ) );

 	

	AddDetail( ({ "silberland" , "land" }), BS(

		"Soll ich Dir jetzt wirklich die Geschichte vom Silberland erzaehlen "

		"oder willst Du dich nicht lieber mit anderen Dingen beschaeftigen?!" ) );

	

	AddDetail( ({ "geschichte", "geschichten" }), BS(

		"Denkste, geh lieber woanders hin, wenn du auf Geschichten aus "

		"bist!" ) );



	AddDetail( ({ "berg" , "berge" ,  "gipfel" , "schnee"}), BS(

		"Wunderbare Aussicht! Du blickst auf die Berge, deren Gipfel mit "

		"glaenzend weissem Schnee bedeckt sind und willst viel "

		"lieber zu ihnen, anstatt dich hier mit der Frage zu beschaeftigen, "

		"ob Du weitergehen sollst oder nicht. Dein Gefuehl sagt: NEIN !" ) );


	AddDetail( ({ "gefuehl" , "gefuehle" }), BS(

		"Seit wann kann man Gefuehle sehen ?!" ) );



	AddDetail( ({ "herz" ,  "herzschrittmacher" , "schrittmacher" }), BS(

		"Auf dein armes Herz solltest Du schon aufpassen, vorallem wenn Du "

		"dich weiterwagen solltest, wirst du einen Herzschrittmacher brauchen "

		"koennen." ) );

	

	AddDetail( "oeffnung", BS(

		"Durch diese Oeffnung kannst du weiter nach Norden vordringen. Aber "

		"sei gewarnt: Viele Gefahren werden dort auf dich lauern und es besteht "

		"keine Garantie, dass Du da wieder heil rauskommst. " ) );

	

	AddDetail( ({ "gefahr" , "gefahren" , "nerv" , "zeug" , "zeugs" , "tiere" ,

		  "tier" , "fallen" , "falle"  }), BS(

		"Tja, also da waeren mal viele wilde Tiere oder vielleicht mal die eine oder andere "

		"Falle, oder ueberhaupt Zeugs, dass dir den letzten Nerv ziehen wird. Sei darauf "

		"gefasst! " ) );

	

	AddDetail( ({ "garantie" , "garantien" }), BS(

		"Garantiert gefaehrlich!!!!" ) );



	

	AddExit( "muell", "/players/gladstone/workroom.lpc" );

	

	AddExit ("norden", "/d/gebirge/gladstone/room/weg1.lpc" );

            SetProp (P_HIDE_EXITS, ({"norden"}) );

	

	AddCmd( ({ "geh" , "gehe" }), "gehe_etwas" );

	AddCmd( ({ "fuehle" , "fuehl" }), "fuehle_etwas" );

}

gehe_etwas( str )
{
	notify_fail( "DURCH was  willst Du denn gehen ?" );
	if( str == "oeffnung" )
	{
		write( "Das ist doch wirklich keine schoene Sprache!\n" );
		return 1;
	}
	if ( str == "durch die Oeffnung" || str == "durch Oeffnung" )
	{
		write( "Das kannst Du im Moment leider noch nicht machen.\n");

	}

	

	{

		say(

			this_player()->name(WER,2)+" versucht etwas.\n"

		);

		return 1;

	}

	return 0;

}


