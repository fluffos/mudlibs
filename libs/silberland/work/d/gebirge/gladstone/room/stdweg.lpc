/* /d/gebirge/gladstone/room/stdweg.c */

/* Gladstone@SilberLand */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "files.h"




create()
{
	::create();

//* PROPERTIES *//



	SetProp( P_INT_SHORT, "Ein Weg durch eine Schlucht" );
	SetProp( P_INT_LONG, BS(
		"Du befindest dich auf einem schmalen Weg durch eine tiefe und duestere Schlucht "
		"und bist auf beiden Seiten von hohen Felswaenden eingeschlossen. Der finstere "
		"Himmel und die unheimlichen Geraeusche tragen nicht unbedingt zu einer froehlichern "
		"Stimmung bei. Du ueberlegst dir, ob Du dich nach Norden weiterwagen sollst, oder "
		"doch lieber den Rueckweg in suedlicher Richtung antrittst." ) );
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]));

 



//* SOUNDS *//

	

	AddSound (({DEFAULT_SOUND,"geraeusche"}), BS(

		"Du vernimmst ein leises Rauschen, das wohl der Wind erzeugt." ) );

 	

	AddSound ("geraeusch", BS(

		"Du vernimmst ein leises Rauschen, das wohl der Wind erzeugt." ) );

 	

	AddSound ("rauschen", BS(

		"Klingt das Rauschen nicht doch eher wie ein Pfauchen ? " ) );

 	

	AddSound ("pfauchen", BS(

		"Klingt das Pfauchen nicht doch eher wie ein Zischen ?." ) );



	AddSound ("zischen", BS(

		"Auch bei diesem unheimlichen Zischen bist Du dir nicht sicher, "
		"ob es tatsaechlich ein Zischen ist und hoerst schliesslich auf, hier "
		"nach anderen Geraeuschen zu lauschen." ) );



   



//* DETAILS *//

	AddDetail( "richtung", BS(
		"Du kannst entweder die Richtung Rueckweg oder die "
		"mutigere Variante Richtung Norden waehlen." ) );
	AddDetail( "stimmung", BS(
		"Na beim Max kommt man schon leichter in froehliche "
		"Stimmung! " ) );
	AddDetail( "max", BS(
		"Solltest Du kennen!" ) );
	AddDetail( ({ "seiten" , "seite" }), BS(
		"Links und Rechts." ) );
	AddDetail( "norden", BS(
		"Im Norden, ja da ................................. " ) );
	AddDetail( ({ "weg", "boden" }), BS(
		"Der Weg ist schmal und steinig, dein Knie tun Dir schon "
	      	"vom vielen herumtreten weh, Du willst eigentlich lieber den "
		"Rueckweg antreten. " ) );
	AddDetail( "rueckweg", BS(
		"Wahrscheinlich die beste Entscheidung! ") );
	AddDetail( "entscheidung", BS(
		"Sterben oder nicht sterben, dass ist hier die Frage!" ) );
	AddDetail( ({ "frage" , "fragen" }), BS(
		"Keine weiteren Fragen mehr, wenn ich bitten darf?! ;)" ) );
	AddDetail( "knie", BS(

		"Deine Knie schmerzen hoellisch, es wird nicht mehr lange "
		"dauern und du liegst in Prothegs Krankenhaus bei der naechsten "
		"Meniskusoperation. " ) );

	AddDetail( ({ "meniskusoperation" , "meniskus" , "operation" }), BS(

		"Frag doch Dante wie sowas ablaeuft, und kuemmere dich hier "
		"lieber um andere Details. " ) );

	

	AddDetail(  ({"dante", "dschungel" }), BS(

		"Na also wenn Du Dante nicht kennst, dann solltest Du dir lieber "

		"mal den Dschungel anschauen, bevor Du dich hier weiterwagst! " ) );

	

	AddDetail( ({ "detail" , "details" }), BS(

		"GRRRMMMPFFFF, doch nicht solche!!!!!!!!!" ) );



	AddDetail( ({ "fels" , "felswand" , "felswaende" , "waende" }), BS(
		"Links und recht ragen sie wie maechtige Mauern empor. "
	            "An dieser Stelle hochzuklettern faellt dir nichteinmal im Traume ein." ) );
	
	
	AddDetail( "schlucht" ,  BS(
		"Die Schlucht laed nicht gerade zum Verweilen ein. "
		"Eigentlich moechtest Du wieder nach Hause. " ) );
	

	AddDetail( ({"verweilen" , "weilen" }), BS(
		"Verweilen ist wohl die schlechteste Idee." ) );
	
	AddDetail( "idee" , BS(
		"Hab eine andere!" ) );
	
	AddDetail( "himmel", BS(

		"Dein Blick wendet sich dem Himmel zu, der alles andere "

		"als freundlich auf dein Gemuet wirkt. Dunkle Wolken "

		"ziehen vorbei und hie und da vermutest Du auch sowas "

		"wie Rauchschwaden. " ) );

	

	AddDetail( ({ "rauchschwaden" , "schwaden" , "rauch"}), BS(

		"Jaja, Du hast schon recht. Es handelt sich wirklich um "

		"Rauch, der da oben vorbeizieht. Woher der nur kommen mag?" ) );

	

	AddDetail( ({ "wolken" , "wolke"}), BS(

		"Die Wolken machen weder Schlucht noch dich heller, sondern "

		"haben eher depressiven Einfluss auf dein Gemuet." ) );

	

	AddDetail( ({ "einfluss" , "gemuet" , "stimme"}), BS(

		"In deinem Kopf schreit ein Stimme: UMKEHREN !!!!" ) );


}