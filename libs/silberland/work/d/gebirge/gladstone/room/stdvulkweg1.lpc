/* /d/gebirge/gladstone/room/stdvulkweg.c */

/* Gladstone@SilberLand */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "files.h"




create()
{
	::create();

//* PROPERTIES *//



	SetProp( P_INT_SHORT, "Vulkanweg" );
	SetProp( P_INT_LONG, BS(
		"Du stehst auf seltsamen Untergrund, umgeben von den bizarrsten Formen, "
		"die die Natur hervorzubringen vermag. Noerdlich von Dir ragt ein riesiger "
		"Vulkan in den Himmel, aus dessen Krater Rauch emporsteigt,  und im Sueden "
		"liegt das Gebirge. Ueberall entweichen dem von Asche ueberzogenen Boden "
		"kleine Dampfwoelkchen, kannst Du das Blubbern heisser Quellen vernehmen "
		"und zusammen mit dem finsteren Himmel ergibt das eine schon eigenartige "
		"Atmosphaere. Einen Weg gibt es hier nicht, doch erkennst Du ein paar Spuren, "
		"die in zwei Richtungen weiterfuehren." ) );
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_MOUNTAIN]));

 



//* SOUNDS *//

	

	AddSound (({DEFAULT_SOUND,"geraeusche"}), BS(

		"Blubbern, Zischen, Pochen, Pfauchen, Rauschen, ........." ) );

 	

	AddSound ("geraeusch", BS(

		"Du vernimmst ein leises Rauschen, das wohl der Wind erzeugt." ) );

 	

	AddSound ("rauschen", BS(

		"Ja, Du hoerst den Wind ueber die Baeume rauschen. " ) );

 	

	AddSound ("wind", BS(

		"Er scheint Dir Geschichten von mutigen Abenteurern zu erzaehlen." ) );

//* DETAILS *//

	AddDetail( ({ "spuren" , "spur" }), BS(
		"Auf den von Asche ueberzogenen Boden kannst Du Spuren erkennen, "
		"die in zwei verschiedene Richtungen fuehren. Anscheinend ist hier "
		"schon jemand mal gegangen .......... " ) );
	AddDetail( "weg", BS(
		"Einen Weg kannst Du eigentlich nicht erkennen, denn wer sollte schon "
		"auf die Idee kommen, in dieser Gegend einen Weg anzulegen. Aber Du "
		"findest Spuren, die offensichtlich um den Vulkan herumfuehren und musst "
		"Dir eingestehen, dass Du nicht der erste hier warst. " ) );
	AddDetail( ({ "boden" , "untergrund" , "grund" }), BS(
		"Der Boden besteht aus erstarrter Lavamasse und weist ueberall Risse und "
		"Spalten auf, was dir das Weiterkommen erheblich erschwert. Ausserdem "
		"erinnert dich sein Aussehen an eine alte Drachenhaut und dich ueberkommt "
		"wieder die Abenteuerlust. " ) );
	AddDetail( ({ "weiterkommen" , "kommen" }), BS(
		"Der unregelmaessige Untergrund und die Hitze machen dir ganz schoen "
		"zu schaffen. Du solltest sparsam mit deiner Energie umgehen, ansonsten "
		"werden dich noch die Schnecken ueberholen. " ) );
 	AddDetail( ({ "schnecken" , "schnecke" }), BS(
		"Keine Sorge, diese Tierchen wirst Du hier schon nicht finden! " ) );
	AddDetail(({ "lava" , "lavamasse" }), BS(
		"Die Lava kam und kommt aus dem Vulkan." ) );
	
	AddDetail(({ "vulkan" , "vulkane" }), BS(
		"Der Vulkan, ein feuerspeiender Berg, der schon dem einen oder andern "
		"Besucher hier das Leben gekostet hat. Dieser hier traegt den Namen Tambora und "
		"ist ein besonders grosser und aktiver, also sei auf der Hut. " ) );




	AddDetail( ({ "detail" , "details" }), BS(

		"GRRRMMMPFFFF, doch nicht solche!!!!!!!!!" ) );
}
