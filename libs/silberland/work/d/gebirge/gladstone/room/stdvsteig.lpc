/* /d/gebirge/gladstone/room/stdvsteig.c */

/* Gladstone@SilberLand */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "files.h"




create()
{
	::create();

//* PROPERTIES *//



	SetProp( P_INT_SHORT, "Auf einem Vulkansteig" );
	SetProp( P_INT_LONG, BS(
		"Du befindest dich auf einem steilen Steig, der zum Krater des Vulkans "
		"fuehrt. Der Anstieg bereitet dir grosse Muehe, vorallem die Temperatur, "
		"die stetig steigt, je mehr Du dich dem Gipfel naeherst. " ) );
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0 );
	

 



//* SOUNDS *//

	

	AddSound (({DEFAULT_SOUND,"geraeusche"}), BS(

		"Grollen, Zischen, und ein unheimliches Pochen macht dich nervoes. " ) );

 	

	AddSound ("grollen", BS(

		"Das Grollen kommt aus dem Inneren des Vulkans."  ) );

 	

	AddSound ("pochen", BS(

		"Das Pochen kann wohl nur dein eigenes Herz sein, das wohl mit deiner "
		"Nervositaet ordentlich beschaeftigt ist. " ) );

 	

	AddSound ("zischen", BS(

		"Das Zischen duerfte von weiter oben kommen ................" ) );

//* DETAILS *//


	AddDetail( ({ "weg", "boden" }), BS(
		"Der Boden besteht aus harter Lavamasse, in die sich durch "
		"die unzaehligen Wanderer und Abenteuerer mit der Zeit ein "
		"natuerlicher Pfad gebildet hat, an den ich mich an deiner Stelle auch "
		"halten wuerde, es sei denn, Du hast unbedingte Lust, in einen der "
		"heissen Lavastroemen baden zu gehen." ) );
	
	AddDetail(({ "lava" , "lavamasse" }), BS(
		"Die Lava kam und kommt aus dem Vulkan." ) );
	
	AddDetail(({ "vulkan" , "vulkane" }), BS(
		"Der Vulkan. Eines der grossartisten Phaenomene, die "
		"uns unsere Welt zu bieten hat. Dieser hier ist eins der schoensten "
		"Exemplare, obwohl nicht ganz ungefaehrlich ............." ) );




	AddDetail( ({ "detail" , "details" }), BS(

		"GRRRMMMPFFFF, doch nicht solche!!!!!!!!!" ) );
}

init()
{	
	::init();
	{		
		if(TP->QueryAttributes(A_DEX)<15 && random(15)==1)
			call_out("runter",1);
		else
			if(random(25)==1)
				call_out("runter",1);	
	}

}
                                                                         
    runter()
    {
    tell_room(TO, BS(TPN+" bist unvorsichtig, verliert das Gleichgewicht und stuerzst"
    +"nach unten in den Abgrund."), ({TP}) );
                                                                          
    tell_object(TP, "Du bist auf diesem Weg zu unvorsichtig, "
    +"verlierst das Gleichgewicht..."
    +"und stuerzst in den Abgrund hinunter!\n"
    +">>\n"
    +"\n"
    +"	>>\n"
    +"\n"
    +"		>>\n"
    +"\n"
    +"			>>\n"
    +"\n"
    +"				>>\n"
    +"\n"
    +"			>>\n"
    +"\n"
    +"		>>\n"
    +"\n"
    +"	>>\n"
    +"\n"
    +"		>>\n"
    +"\n"
    +"			>>\n"
    +"\n"
    +"				>>\n"
    +"\n"
    +"			PLATSCH !!!!!!!\n");
    TP->move("/d/gebirge/gladstone/room/vweg15.lpc",M_GO,
             "in den Abgrund", "stuerzt","stuerzt von oben herunter");
    TP->restore_hit_points(-50);
    }
