
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Ast");
  SetProp(P_LONG,
    "Das ist ein kleiner Ast. Er ist besonders gerade und an ihm wurde "
    "herumgeschnitzt." );
  SetProp(P_NAME, "Ast");
  SetProp(P_GENDER, MALE);
  AddId( ({ "QUESTOBJ",QUESTAST,"ast" }) );

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Der Ast ist absolut nichts wert.\n");
  SetProp(P_NODROP, "Du glaubst, dass der Ast noch fuer irgendetwas wichtig "
                    "sein koennte.\n");
  SetProp(P_NEVERDROP, 1);
}
