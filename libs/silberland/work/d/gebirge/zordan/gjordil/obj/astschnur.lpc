
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Ast mit Schnur");
  SetProp(P_LONG,
    "Du erkennst einen kleinen Ast mit einer kleinen Schnur daran. "
    "An die richtige Stelle koennte man beides sicher prima befestigen." );
  SetProp(P_NAME, "Ast");
  SetProp(P_GENDER, MALE);
  AddId( ({ "QUESTOBJ",QUESTFALLE,"ast","schnur" }) );

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:50, MAT_WOOL:50 ]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Der Ast mit der Schnur ist absolut nichts wert.\n");
  SetProp(P_NODROP, "Du glaubst der Ast mit der Schnur ist noch fuer "
                    "irgendetwas wichtig.\n");
  SetProp(P_NEVERDROP, 1);
}
