
/*

 Das Questitem fuer die Gjordil-Quest Zordan@SL

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int frage,funkel,falle,gebaut,quest,frei;

create() {
  if (!is_clone(TO)) return;
  ::create();

  frage=0;
  funkel=0;
  falle=0;
  gebaut=0;
  quest=0;
  frei=0;

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, "Ich bin nur ein Questitem ;)");
  SetProp(P_GENDER, NEUTER);
  AddId( QUESTITEM );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

gefragt() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/npc/trolljunge") return;
  frage=1;
  return;
}

int checkgefragt() {
  return frage;
}

funkeln() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/room/baum") return;
  if (!frage) return;
  funkel=1;
  return;
}

int checkfunkeln() {
  return funkel;
}

falle() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/room/versteck") return;
  if (!frage) return;
  if (!funkel) return;
  falle=1;
  return;
}

int checkfalle() {
  return falle;
}

gebaut() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/room/versteck") return;
  if (!frage) return;
  if (!funkel) return;
  if (!falle) return;
  gebaut=1;
  return;
}

checkgebaut() {
  return gebaut;
}

quest() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/room/versteck") return;
  if (!frage) return;
  if (!funkel) return;
  if (!falle) return;
  if (!gebaut) return;
  quest=1;
  return;
}

checkquest() {
  return quest;
}

frei() {
  if (explode(file_name(previous_object()), "#")[0] 
        != "/d/gebirge/speedy/trollager/room/versteck") return;
  frei=1;
  return;
}

checkfrei() {
  return frei;
}
