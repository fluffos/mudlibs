
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Griff");
  SetProp(P_LONG,
    "Dieser kleine Griff besteht komplett aus Diamant. Er strahlt in der "
    "Sonne und er fuehlt sich unglaublich gut in der Hand an. Er ist auch "
    "sicher einiges wert. Allerdings sollte man sich es gut ueberlegen, ob "
    "man ein solch seltenes Stueck einfach so verkauft." );
  SetProp(P_INFO, "Der Griff hat genau die richtige Groesse fuer eine "
                  "Trollhand.\n");
  SetProp(P_NAME, "Griff");
  SetProp(P_GENDER, MALE);
  AddId( ({ "QUESTOBJ","griff", QUESTGRIFF }) );

  SetProp(P_MATERIAL, MAT_DIAMOND );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
