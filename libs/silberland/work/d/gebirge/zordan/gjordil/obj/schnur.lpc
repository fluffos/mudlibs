
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schnur");
  SetProp(P_LONG,
    "Das ist eine kleine, weisse Schnur. Man koennte sie vielleicht an "
    "etwas kleines anbinden." );
  SetProp(P_NAME, "Schnur");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "QUESTOBJ",QUESTSCHNUR,"schnur" }) );

  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Die Schnur ist absolut nichts wert.\n");
  SetProp(P_NODROP, "Du glaubst die Schnur ist noch fuer irgendetwas wichtig.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({ "binde","bind" }), "bindefkt" );
}

int bindefkt(string str) {
  object ob;
  if(!present(QUESTITEM,TP)) {
    if(ob=present(QUESTAST,TP)) {
      write(BS("Bei Deinem Versuch gehen leider Ast und Schnur kaputt."));
      ob->remove();
      call_out("remove",0);
      return 1;
    }
    write(BS("Deine Schnur loest sich auf einmal in Nichts auf."));
    call_out("remove",0);
    return 1;
  }
  notify_fail("An was moechtest Du die Schnur binden?\n");
  if(!str) return 0;
  if(str != "schnur an ast" && str != "ast an schnur" &&
     str != "schnur an ast fest" && str != "ast an schnur fest") {
    write(BS(
      "Daran kannst Du die Schnur nicht festbinden."));
    return 1;
  }
  if(!ob=present(QUESTAST,TP)) {
    write(BS(
      "Du hast keinen Ast bei Dir, an den sich das festbinden "
      "lohnen wuerde."));
    return 1;
  }
  write(BS("Du bindest die Schnur an dem Ast fest."));
  ob->remove();
  ob=clone_object("/d/gebirge/zordan/gjordil/obj/astschnur");
  ob->move(TP, M_SILENT | M_NOCHECK);
  call_out("remove",0);
  return 1;
}
