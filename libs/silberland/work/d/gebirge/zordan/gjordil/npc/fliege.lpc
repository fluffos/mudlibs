
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine laestige Fleischfliege");
  SetProp(P_LONG,
    "Diese kleine Fliege ernaehrt sich von altem, vergammeltem Fleisch. "
    "Sie fuehlt sich in dieser Umgebung ur wohl und findet den Gestank "
    "sehr anziehend.");
  SetProp(P_NAME, "Fleischfliege");
  SetProp(P_GENDER, FEMALE);
  AddId(({"fleischfliege", "fliege"}));

  create_default_npc(4);
  SetProp(P_HANDS, ({" mit ihren kleinen Fluegeln",
    QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Fliege");
  SetProp(P_SIZE, 1+random(2));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt zu Boden und fliegt nie mehr.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fleischfliege kann @WEN nicht tragen.\n" }) );

  SUID;
}
