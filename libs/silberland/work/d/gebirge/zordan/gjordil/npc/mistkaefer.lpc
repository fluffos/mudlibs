
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Mistkaefer");
  SetProp(P_LONG,
    "Dieser kleine Mistkaefer ist gerade dabei eine kleine Kugel ueber den "
    "Boden zu rollen. Da er sich gestoert fuehlt, greift er meistens "
    "alles gleich an.");
  SetProp(P_NAME, "Mistkaefer");
  SetProp(P_GENDER, MALE);
  AddId(({"mistkaefer", "kaefer"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit kleinen Beinchen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 2+random(2));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Mistkaefer kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,50,
    "Der Mistkaefer zwickt Dich ins Bein.\n",
    "Der Mistkaefer zwickt @WEM ins Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SUID;
}
