
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/paladine/paladin.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Brueckenwaechter");
  SetProp(P_LONG,
		"Vor Dir steht ein grosser Waechter, der ungewuenschte Besucher davon\n"
	+	"abhaelt, die Burg zu betreten.\n"
	+	"Du solltest es Dir sehr gut ueberlegen, ob Du ihn angreifst !\n");

  SetProp(P_NAME, "Brueckenwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_HANDS, ({" mit seinen Haenden",30,DT_HOLY }));
  
  AddId( ({"brueckenwaechter","waechter"}) );
  
  

  create_default_npc(20+random(5));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 500+random(200));
  SetProp(P_MAX_HANDS, 2);

  SetProp (P_GUILD, "paladine");
  SetProp (P_GUILD_LEVEL, 8+random(3));

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      -0.2, DT_WATER:  -0.2, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  -0.2, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: -0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.2 ]) );

  SetProp(P_DIE_MSG,  " faellt toedlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "verrichtet seine Wache und antwortet Dir nicht.\n");


  SetProp(P_SPELLRATE,20);

  AddSpell(3,150,
    "Der Burgwaechter macht eine raffinierte Finte.\n",
    "Der Burgwaechter macht eine raffinierte Finte.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,200,
    "Der Burgwaechter fleht Dusty um Hilfe an.\n",
    "Der Burgwaechter fleht Dusty um Hilfe an.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Der Burgwaechter reisst Dir das Fleisch auf.\n",
    "Der Burgwaechter reisst @WEM das Fleisch auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Der Burgwaechter greift Dich mit der heiligen Macht an.\n",
    "Der Burgwaechter greift @WEN mit der heiligen Macht an.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));


  SUID;
  CLONEME( "/doc/beispiele/bspwaffe1" );
  command("zuecke knueppel");

}