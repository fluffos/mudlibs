/* Steinbock
   by Impulz@SL
*/

inherit "/gilden/paladine/master/sequencer";
inherit "std/npc";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include <config.h>
#include <living.h>
#include <defines.h>
varargs absturz2(object pl);

create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT,"Ein Steinbock");
  SetProp(P_LONG,
    "Mit gesenkten Hoernern steht der Steinbock direkt vor Dir. "
    "Er wirkt sehr kraeftig und kann Dich mit seinen Hoernern sicherlich "
    "kinderleicht den Abgrund herunterstossen, wenn Du nicht mehr kraeftig "
    "genug bist, um Dich zu retten. Du solltest ihn keineswegs "
    "unterschaetzen.");

  SetProp(P_NAME,"Steinbock");
  SetProp(P_GENDER,MALE);
  AddId("bock");
  AddId("steinbock");
  AddId("\nsteinbock"); // vielleicht brauch ichs ja nochmal..
  
  create_default_npc(15);
  SetProp(P_HANDS,({" mit seinen Hoernern",130})); // etwas weniger WC
  SetProp(P_ALIGN,-300);
  SetProp(P_RACE,"Steinboecke");
  SetProp(P_MAX_HP,300);   // dafuer mehr HP
  SetProp(P_SPELLRATE,80);

/*  AddSpell(50,200,
    "Der Steinbock rammt seine Hoerner in Deinen Bauch.\n",
    "Der Steinbock rammt seine Hoerner in @WESSEN Bauch.\n");
  AddSpell(50,300,
    "Der Steinbock tritt Dich mit seinen Hinterbeinen.\n",
    "Der Steinbock tritt @WEN mit seinen Hinterbeinen.\n");
*/
  AddSpell(1,1,
    "Der Steinbock nimmt Anlauf und rammt Dich unglaublich feste.\n",
    "Der Steinbock nimmt Anlauf und rammt @WEN unglaublich feste.\n",
     DT_BLUDGEON,"absturz");
}


int absturz(object enemy, int damage, mixed dam_type) 
{
  enemy->StopHuntFor(TO,1); // Sonst stirbt der Spieler evtl. sofort nach dem
  TO->StopHuntFor(enemy,1); // Hochklettern, wenn er angegriffen wird.

  enemy->move("/d/gebirge/impulz/paladinweg/room/platform",
              M_NO_SHOW | M_NOCHECK,"",
              "faellt den Abgrund hinunter",
              "kommt herein gefallen");
  enemy->SetProp(P_PARALYZED, 
   ([PARALYZE_TIME:100, // vorsichtshalber nicht -1, falls was schiefgeht
     PARALYZE_MSG:"",
     PARALYZE_MSG_OTHER:"",
     PARALYZE_END:"",
     PARALYZE_END_OTHER:""]));
LoadSequenz("/d/gebirge/impulz/paladinweg/npc/absturz.seq", enemy,#'absturz2);
  return 1;

}

int absturz2(object player)
{ 
  player->reduce_hit_point(100);
  player->SetProp(P_MV,0); // total hinueber nach dem sturz
  player->SetProp(P_PARALYZED, 
   ([PARALYZE_TIME:10,  // noch 10 Sek. nach Ende der Sequenz.
     PARALYZE_MSG:"Dir tut noch alles hoellisch weh. Warte lieber noch etwas "
                  "bis Du Dich bewegst.\n", 
     PARALYZE_MSG_OTHER:"%s kann sich vor Schmerzen noch nicht bewegen.\n",
     PARALYZE_END:"Langsam lassen die Schmerzen ein wenig nach und Du kannst "
                  "Dich wieder bewegen.\n",
     PARALYZE_END_OTHER:"%s scheint sich etwas besser zu fuehlen"
                        "und kann sich wieder bewegen.\n"]));

  return 1;  
}
