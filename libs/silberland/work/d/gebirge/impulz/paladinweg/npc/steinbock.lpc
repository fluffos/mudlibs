/* Steinbock
   by Impulz@SL
*/


inherit "std/npc";
#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include <config.h>
#include <living.h>
#include <defines.h>
#include <new_skills.h>


create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT,"Ein Steinbock");
  SetProp(P_LONG,
    "Mit gesenkten Hoernern steht der Steinbock direkt vor Dir. "
    "Er wirkt sehr kraeftig und kann Dich mit seinen Hoernern sicherlich "
    "kinderleicht den Abgrund herunterstossen, wenn Du nicht mehr kraeftig "
    "genug bist, um Dich zu retten. Du solltest ihn keineswegs "
    "unterschaetzen.");

  SetProp(P_NAME,"Steinbock");
  SetProp(P_GENDER,MALE);
  AddId("bock");
  AddId("steinbock");
  AddId("\nsteinbock"); // vielleicht brauch ichs ja nochmal..
  
  create_default_npc(15);
  SetProp(P_HANDS,({" mit seinen Hoernern",130})); // etwas weniger WC
  SetProp(P_ALIGN,-300);
  SetProp(P_RACE,"Steinboecke");
  SetProp(P_MAX_HP,300);   // dafuer mehr HP
  SetProp(P_SPELLRATE,10);

  AddSpell(1,200,
    "Der Steinbock rammt seine Hoerner in Deinen Bauch.\n",
    "Der Steinbock rammt seine Hoerner in @WESSEN Bauch.\n");
  AddSpell(1,250,
    "Der Steinbock tritt Dich mit seinen Hinterbeinen.\n",
    "Der Steinbock tritt @WEN mit seinen Hinterbeinen.\n");
}


stirb(object enemy)
{  tell_object(enemy,
    "Du faellst ...\n"
    "und faellst ...\n"
    "und faellst ...\n");
      SetProp(P_KILL_NAME, "Ein tiefer Fall");
      enemy->die();
      return;
}


Attack(object enemy)
{
   if (enemy->QueryProp(P_HP)<25) // Der Spieler wuerde eh max. noch 2 
                                  // schlaege aushalten
    {
      TO->StopHuntingFor(enemy,1);
      enemy->StopHuntingFor(TO,1);
      tell_object(enemy,
"Ploetzlich rennt der Steinbock von Dir weg, aber gerade als Du aufatmen \n"
"willst, haelt der Steinbock an und dreht sich zu Dir um. Als er auf einmal\n"
"auf Dich zugerannt kommt, bleibt Dir fast das Herz stehen. Er senkt \n"
"seinen Kopf und rammt Dich unglaublich feste in den Magen.\n");
     tell_object(enemy,
"Du wirst einige Meter weit weggeschleudert und merkst, wie Du in den\n"
"Abgrund faellst.\n");
  tell_object(enemy,
    "Du faellst ...\n"
    "und faellst ...\n"
    "und faellst ...\n");
      SetProp(P_KILL_NAME, "Ein tiefer Fall");
      enemy->die();
      return 1;
    }
   ::Attack(enemy);
   return 1;
}       