/* Nachteule
   by Impulz@SL
*/

inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>


create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Nachteule");

  SetProp(P_LONG, 
		"Die Nachteule schaut Dich mit finsteren Augen an.\n"
	+	"Sie sitzt am liebsten ungestoert auf einem Ast in einer dunklen Baumkrone\n"
	+	"und beobachtet das Geschehen um sich herum. Aber ihr traeges Aussehen\n"
	+	"kann taeuschen. Wie die meisten Tiere hat auch die Nachteule einen\n"
	+	"Schwachpunkt aber auch eine besondere Staerke.\n");

  AddDetail("schwachpunkt",
		"Nachteulen sind, wie der Name schon sagt, Nachttiere und scheuen\n"
	+	"helles Licht, bei dem sie aufgrund ihrer sehr empfindlichen Augen\n"
	+	"geblendet werden.\n");
  AddDetail("staerke","Die Nachteule kann problemlos in der Dunkelheit sehen und ist\nden meisten Lebewesen gegenueber dann im Vorteil.\n");


  SetProp(P_NAME, "Nachteule");

  SetProp(P_GENDER, FEMALE);

  AddId("eule");
  AddId("nachteule");

  create_default_npc( 10 );

  
  SetProp(P_HANDS, ({" mit scharfen Krallen", 90}));
  SetProp(P_ALIGN, -600);
  SetProp(P_RACE, "Vogel");
//  SetProp(P_XP, 100000+random(30000)); gibt viel zu viele XP, Feyaria
  SetProp(P_VULNERABILITY,({ DT_LIGHT,DT_HOLY })); //Nachtlebewesen sind i.d.R. gegen 
//Licht empfindl.

  SetProp(P_SPELLRATE,10);

  AddSpell(2,120,"Die Eule versetzt Dir einen tiefen Kratzer.\n","Die Eule versetzt @WEM einen tiefen Kratzer.\n");
  AddSpell(3,90,"Die Eule versetzt Dir einen Kratzer.\n","Die Eule versetzt @WEM einen Kratzer.\n");
  AddSpell(1,60,"Die Eule versetzt Dir einen leichten Kratzer.\n","Die Eule versetzt @WEM einen leichten Kratzer.\n");


}


// Dunkel=2x Attacke, Sehr Hell= 60% wahrscheinlichkeit
Attack (object enemy)
{ int lightlevel;
  lightlevel=environment(this_object())->_query_total_light();
  
  if (lightlevel<1) ModifySkillAttribute(this_object(),SA_SPEED,200,2);
  if (lightlevel>2) ModifySkillAttribute(this_object(),SA_SPEED,50,2);

  ::Attack(enemy);
}


