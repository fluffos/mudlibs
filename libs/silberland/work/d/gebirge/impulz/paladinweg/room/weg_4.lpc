inherit "std/room";
#include <properties.h>
#include <moving.h>
#include <moredef.h>
#include <wizlevels.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

#define ANSCHLUSS "/d/gebirge/dante/friedhof/room/pfad1"

#include "/d/gebirge/iwo/weg/def.h"

int found,found2;

sign();
no_west();

create()
{  ::create();
  found=0; 
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:10,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG, BS(
    "Obwohl Du schon etliche Meter hinter Dir hast, scheint der Weg "
    "kein Ende nehmen zu wollen. Zu allem Ueberfluss wird der Weg nach "
    "Norden hin viel viel schmaler, so dass Du wirklich aufpassen musst, "
    "nicht in den Abgrund abzurutschen. Das waere sicherlich fatal. "
    "Die Umgebung hier hat kaum Besonderheiten und wirkt sowieso ziemlich "
    "langweilig, aber was erwartest Du auch, wenn Du nur von Felsen umgeben "
    "bist. Im Osten faellt Dir ein massiver, gigantischer Gesteinsbrocken auf, "
    "durch den eine grosse toraehnliche Oeffnung zu fuehren scheint. "
    "Ein Wegweiser steht einsam und verlassen in der Gegend herum."));
    
    
    //details by dante eingefuegt
    
    AddDetail("osten",
    "Es scheint als koenne man nach Osten gehen! Was dort aber ist, kannst "
    "Du leider nicht erkennen.");
    AddDetail(({"gesteinsbrocken","brocken","gestein"}),
    "Der Brocken wirkt unheimlich und bedrohlich. Eine grosse Oeffnung "
    "fuehrt wie ein Tor hindurch!");
    AddDetail("tor",
    "Die Oeffnung ist natuerlichen Ursprungs, sieht aber wie ein Tor aus.");
    AddDetail("oeffnung",
    "Du kannst durch sie hindurch nach Osten gehen!");
    AddDetail("ursprung",
    "Vielleicht kannst Du ja noch erfahren, wie sie entstanden ist.");
   
   //details dante ende
    
    
    
    
  AddDetail("meter","Du hast schon etliche davon hinter Dir.");
  AddDetail("stueck","Du hast ja schon ein gutes Stueck hinter Dir.");
  AddDetail("weg",
    "Der Weg fuehrt auf einem schmalen Pfad von Suedosten nach Norden.");
  AddDetail("norden","Nach Norden hin steigt der Pfad stetig an.");
  AddDetail("Suedosten","Nach Suedosten gelangst wieder hinunter.");
  AddDetail("ende","Der Tod fluestert Dir zu: Du weisst schon was das ist.");
  AddDetail("tod","Der erwartet Dich, wenn Du den Abgrund hinunter faellst.");
  AddDetail("abgrund","Es ist sicherlich unangenehm da runter zu fallen.");
  AddDetail("pfad","Der Pfad besteht nur aus Kieseln.");
  AddDetail(({"kiesel"}),
    "Ganz normale Kiesel halt. Aber halt, ein Kieselstein faellt Dir auf.");
  AddDetail(({"stein","kieselstein"}),
    "Der Stein glaenzt viel staerker im Sonnenlicht, als die anderen "
    "Steine. Man koennte meinen es ist ein Edelstein.");
  AddDetail(({"licht","sonnenlicht"}),
    "Der Kieselstein funkelt richtig hell im Sonnenlicht.");
  AddDetail("steine","Die anderen Steine interessieren Dich nicht.");
  AddDetail("edelstein",
    "Bei genauerem Betrachten, faellt Dir auf, dass es doch kein Edelstein "
    "ist sondern nur ein Stueck wertloses Glas, so dass Du es enttaeuscht "
    "liegen laesst.");
  AddDetail("betrachten",
    "Das hast Du schon gemacht und bist zu dem Schluss gekommen, dass der "
    "Stein nur Glas ist.");
  AddDetail("glas","Glas ist leider ziemlich wertlos.");
  AddDetail("stueck","Du kannst mit dem Stueck Glas nix anfangen.");
  AddDetail("schluss","Jaja, hier haste ja deinen FP (oder auch net :) ).");
  AddDetail("fp","Forscherpunkt halt.");
  AddDetail("umgebung","Die Umgebung ist wirklich nicht sehr interessant.");
  AddDetail("ueberfluss",
    "Zu allem Ueberfluss wird der Weg nach Norden schmaler.");
  AddDetail("himmel",
    "Du hast das Gefuehl, der Himmel ist Dir gleich zum Greifen nahe, aber "
    "das taeuscht wahrscheinlich.");
  AddDetail("gefuehl","Gefuehle koennen taeuschen.");
  AddDetail("greifen","Du kannst ja mal probieren in den Himmel zu greifen.");
  AddDetail("besonderheiten",
    "Ausser ein paar Kieseln gibts hier nix zu sehen. Und ob Kiesel etwas "
    "besonderes sind, ist doch mehr als fraglich.");
  AddDetail("boden",
    "Der Boden besteht aus Fels und einigen Kieseln.");
  AddDetail("fels",
    "Der Fels ist sehr hart und hat nur wenige Risse und Spalten.");
  AddDetail("risse",
    "Es gibt hier kaum Risse.");
  AddDetail("spalten",
    "Die Spalten sind so winzig klein, dass dort hoechstens Spinnen und "
    "andere ekelige Krabbeltiere reinkriechen koennen. Aber Du kannst ja "
    "versuchen da drin rumzustochern, wenn du Lust hast.");
  AddDetail(({"spinnen","krabbeltiere"}),
    "Igitt !!!");
  AddDetail("lust",
    "Wenn Du Lust hast, kannst Du ja mal in den Spalten herumstochern.");
  AddDetail("felsen",
    "Felsen gibts hier mehr als genug. Du hast echt keine Lust mehr noch "
    "mehr Felsen zu untersuchen.");

  AddDetail( ({"wegweiser", "weiser"}), #'sign);
  AddReadDetail( ({"wegweiser", "weiser"}), #'sign);

  AddCmd(({"greife","greif"}),"greiffkt");
  AddCmd(({"stochere","stocher"}),"stocherfkt");
  AddExit("suedostunten","./weg_5");
  AddExit("nordoben","./weg_2");
  AddExit("suedosten","./weg_5");
  AddExit("norden","./weg_2");
  SetProp(P_HIDE_EXITS,({"norden","suedosten"}));

  if (WEG_FREI)
    AddExit("westen", BASE "10-00");
  else
    {
      AddSpecialExit("westen", #'no_west); //'
      SetProp(P_HIDE_EXITS, QueryProp(P_HIDE_EXITS) + ({ "westen" }));
    }


  AddExit("osten", ANSCHLUSS);


}

public void init() {
  object ob;

  ::init();

  if(objectp(ob=present(RANGER_TASK_PALA_KILLER, TP)) && ob->QueryStage() == 0) {
    ob->InformStart();
  }

  return;
}

reset(arg)
{ ::reset(arg);
  found=0;
  return 1;
}

greiffkt(string abc)
{ 
  notify_fail("Wohin willst Du greifen ?\n");
  if (!abc) return 0;
  if (!sscanf(abc,"%s himmel",abc)) return 0;
  if (found)
   {  
    write("Du greifst in den Himmel, findest aber nichts.\n");
    return 1;
   }
  write("Du greifst in den Himmel und ergatterst tatsaechlich etwas.\n");
  write("Bei naeherem Hinsehen erkennst Du, dass es ein Muesliriegel ist.\n");   
  CLONE("/d/gebirge/impulz/paladinweg/misc/essen",TP);
  found=1;
  return 1;
}

stocherfkt(string abc)
{ notify_fail("Wo willst Du stochern ?\n");
  if (member(({"in spalte","spalte","spalten","in spalten"}),abc)==-1)
     return 0;

//
  {
    write("Du stocherst herum, aber nichts passiert.\n");
    return 1;
  }
 
  write(break_string(
"Du stocherst in einer Spalte herum und entdeckst dabei einen kleinen "
"Hebel."));
  AddDetail("hebel",
    "Wenn Du mutig genug bist, kannst Du ja mal dran ziehen.");
  AddCmd(({"ziehe","zieh"}),"ziehfkt");
  return 1;
}

ziehfkt(string ob)
{ if (!IS_LEARNER(this_player())) return 0; // TESTPHASE
  if (member(({"an hebel","hebel"}),ob)==-1) return 0;
  write(break_string(
"Du ziehst an dem Hebel und ploetzlich oeffnet sich genau unter Deinen "
"Fuessen eine grosse Spalte, in die Du hineinfaellst."
"Du bereitest Dich innerlich auf einen harten Aufprall vor, landest aber "
"unerwartet weich auf einem Heuhaufen.")+"\n");
  this_player()->move("/d/gebirge/impulz/paladinweg/hoehle/tunnel_1",M_GO,
    "Spalte","verschwindet in einer","faellt aus einer ");
  return 1;
}

sign()
{
  if (WEG_FREI)
    {
      tell_object(TP,
        "                    ^                                \n"
	"         Arwenock   | Sturmfels                      \n"
	"                 < -o                                \n"
	"                     \\                               \n"
        "                      Silberwald                     \n"
	"                        Trollager                    \n");	

    }
  else
    {
     tell_object(TP,
        "                    ^ Sturmfels                      \n"
	"         ########   |                                \n"
	"                 < -o- > Friedhof                    \n"
	"                     \\                               \n"
        "                      Silberwald                     \n"
	"                        Trollager                    \n\n"
	"Ein Teil des Wegweisers ist ueberklebt.\n");	
    }

  return 1;
}


no_west()
{
  if (!IS_LEARNER(TP) && interactive(TP)) return 0;
  else TP->move(BASE "10-00", M_GO);
  return 1;
}
