inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INT_LONG,
    "Der Gebirgspfad, der am Berg entlang fuehrt, wird im Osten wesentlich. "
    "schmaler und ist nur noch wenige Zentimeter breit. Der Boden besteht "
    "nur noch aus Fels und ein paar kleinen Steinchen, die durch Erosion "
    "entstanden sind. In der Felswand ist sind einige Kratzer zu sehen, "
    "die wohl mit einen scharfen Gegenstand reingeritzt worden sind. "
    "Im Osten liegen einige Steine auf dem Pfad, die durch einen "
    "Steinschlag verursacht worden sein koennten. Vorsicht ist auf jedenfall "
    "angebracht.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail(({"pfad","gebirgspfad"}),
    "Der Pfad fuehrt von Nordwesten nach Osten (oder andersrum) und wird "
    "dort sehr viel schmaler, so dass man sehr vorsichtig sein muss, wenn "
    "man dort hergeht.\n");
  AddDetail(({"berg","sturmspitze"}),
    "Du bist auf einem Pfad der in noerdlicher Richtung immer weiter den "
    "Berg hinauf fuehrt.");
  AddDetail("zentimeter",
    "Der Pfad ist im Osten wirklich nur noch wenige Zentimeter breit.");
  AddDetail("boden","Der Boden besteht aus Fels und Steinen.");
  AddDetail("fels","Hier ist so ziemlich alles felsig.");
  AddDetail(({"steinchen","gesteinsmaterial"}),
    "Die Steinchen sind durch die Erosion entstanden und liegen einfach nur "
    "rum.");
  AddDetail("erosion",
    "Erosion nennt man die Abtragung von Gesteinsmaterial durch Wind und "
    "Wasser.");
  AddDetail("felswand","In der Felswand sind einige Kratzer.");
  AddDetail("kratzer",
    "Erst bei genauerem Hinsehen faellt Dir auf, dass es gar keine Kratzer "
    "sind. Es scheint eher eine Zeichnung zu sein, die jemand "
    "eingeritzt hat.");
  AddDetail("gegenstand",
    "So ein Gegenstand koennte z.B. eins der Steinchen gewesen sein.");
  AddDetail("zeichnung",
    "Die Zeichnung stellt eine weibliche, menschliche Person dar, die vor "
    "einem Altar kniet und dabei ihr Schwert gen Himmel richtet. Vielleicht "
    "wird Dir die Bedeutung klar wenn Du nach Nordosten weitergehst.");
  AddDetail("person",
    "Die Zeichnung ist nicht deutlich genug, um eine bestimmte Person zu "
    "erkennen.");
  AddDetail("schwert",
    "Das Schwert ist nicht genau zu erkennen, ist aber ein Einhaender.");
  AddDetail("himmel","Die Person scheint jemanden im Himmel zu ehren.");
  AddDetail("altar",
    "Die Person kniet vor dem Altar, als ob sie jemanden anbetet.");
  AddDetail("steine",
    "Die Steine stammen wohl von einem Steinschlag der im Osten wohl des "
    "oefteren vorkommt. Sei bloss vorsichtig.");
  AddDetail("steinschlag",
    "Im Osten sind viele lockere Steine in der Felswand, die sicherlich "
    "schnell runterfallen koennen.");
  AddDetail("vorsicht",
    "Vorsicht ist immer gut, aber hier ganz sicher angebracht.");
  AddSound(DEFAULT_SOUND,"Du hoerst nur den Wind pfeifen.");
  AddSound("wind","Der Wind pfeift durch die Felsen.");
  AddExit("suedunten","./weg_4");
  AddExit("sueden","./weg_4");
  AddExit("nordwestoben","./weg_1");
  AddExit("nordwesten","./weg_1");
  SetProp(P_HIDE_EXITS,({"nordwesten","sueden"}));
}

