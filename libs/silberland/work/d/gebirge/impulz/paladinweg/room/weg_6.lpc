    ->Gebirge (/d/gebirge/eros/room/berg_v13.c)
    * Raum 6 *
    by Impulz@SL
*/

inherit "std/room";
#include <properties.h>


create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:10,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Hier stehen nur noch wenige ausgetrocknete Baeume, die auf dem harten "
    "Boden nicht genug Wasser kriegen. Waehrend der Pfad nach Suedosten in "
    "Richtung Wald abfaellt, scheint er im Norden unaufhoerlich anzusteigen. "
    "Du scheinst fast die Baumgrenze erreicht zu haben und siehst vor Dir "
    "nur noch ein paar Steinbrocken rumliegen, waehrend der Pfad am Berg "
    "entlangfuehrt. Direkt neben Dir befindet sich ein tiefer Abgrund. "
    "Ein Wegweiser steht neben dem Pfad.");

  AddDetail(({"baum","baeume"}),
    "Die wenigen Baeume sehen ziemlich trocken aus, da sie auf dem steinigen "
    "Boden kaum Wasser bekommen. Die ganze Umgebung scheint immer "
    "trockener und felsiger zu werden, je weiter man nach Norden kommt.");
  AddDetail("boden",
    "Der Boden besteht aus trockener Erde, auf der kaum Pflanzen wachsen.");
  AddDetail("erde",
    "Die Erde beeinhaltet hier nur noch sehr wenig Feuchtigkeit, da die "
    "Erdschicht nur noch sehr duenn ist und direkt darunter harter Fels "
    "ist.");
  AddDetail("feuchtigkeit",
     "Die Pflanzen brauchen Feuchtigkeit um wachsen zu koennen.");
  AddDetail("pflanzen",
     "Hier sind nur noch spaerlich Pflanzen zu sehen. Nur noch einige "
     "Disteln und Moose koennen hier wachsen.");
  AddDetail(({"distel","disteln","moos","moose"}),
     "Disteln und Moose sind die einzigen Pflanzen, die hier "
     "ueberleben.");
  AddDetail("norden","Nach Norden geht es stetig bergauf.");
  AddDetail("wasser","Wasser wirst Du hier wohl kaum noch finden.");
  AddDetail("umgebung","Die Umgebung sieht ziemlich trocken aus.");
  AddDetail("fels",
     "Der harte Fels macht es den meisten Pflanzen unmoeglich hier zu "
     "wachsen.");
  AddDetail(({"erdschicht","zentimeter"}),
     "Die Erdschicht ist nur noch wenige Zentimeter dick.");
  AddDetail("pfad",
     "Der Pfad fuehrt immer hoeher den Berg hinauf. Im Suedosten kannst "
     "Du noch den Beginn eines Waldes sehen, waehrend im Norden nur noch "
     "Steine und Fels zu sehen sind.");
  AddDetail("steine",
     "Die Steine scheinen aus der Felswand herausgebrochen zu sein.");
  AddDetail(({"wand","felswand"}),
     "Die Felswand verhindert das Verlassen des Pfades auf der einen Seite, "
     "waehrend der Abgrund das gleiche auf der anderen Seite tut. Dir bleibt "
     "nicht viel anderes uebrig, als den Pfad nach Suedosten oder Norden "
     "weiterzugehen.");
  AddDetail("abgrund",
     "Der Abgrund auf der einen Seite ist sehr tief. Du solltest zusehen, "
     "dass Du dort nicht hinunterfaellst.");
  AddDetail("seite",
     "Auf der einen Seite ist die Felswand, auf der anderen der Abgrund.");
  AddDetail("beginn","Der Wald beginnt weiter im Sueden.");
  AddDetail(({"baumgrenze","grenze"}),
     "An der Baumgrenze hoeren die Baeume auf zu wachsen.");
  AddDetail(({"berg","stueck"}),
     "Der Berg ist ziemlich hoch und Du hast noch ein gutes Stueck vor Dir. "
     "Dem Wegweiser zufolge hat der Berg den Namen Sturmspitze.");
  AddDetail("sturmspitze","Sturmspitze ist der Name des Berges.");
  AddDetail("name","Der Berg heisst Sturmspitze.");
  AddDetail("wegweiser",
     "Der Wegweiser zeigt nach Norden Richtung Sturmspitze und nach "
     "Suedwesten zum Wald.");
  AddDetail("richtung","Es geht hier Richtung Norden und Suedwesten.");
  AddDetail("suedosten","Im Suedosten faellt der Pfad ab.");
  AddDetail("wald","Der Wald ist weiter im Suedosten.");
  AddDetail("verlassen","Du kannst den Pfad hier unmoeglich verlassen.");
  AddDetail("himmel","Am Himmel siehst Du ein paar Voegel fliegen.");
  AddDetail("voegel",
     "Du kannst von hier aus nicht sagen, was fuer Voegel das sind.");
  AddDetail(({"steinbrocken","brocken"}),
     "Ein paar Steinbrocken liegen hier rum.");
  AddDetail("sturmfels",
     "Du weisst nicht genau, was der Name zu bedeuten hat, aber wenn Du "
     "weitergehst, wirst Du es moeglicherweise herausfinden.");
  AddSmell(DEFAULT_SMELL,"Die Luft hier oben ist viel besser als unten.");
  AddSmell("luft","Die Luft hier oben ist wirklich gut.");
  AddSound(DEFAULT_SOUND,"Du hoerst nur das Rauschen des Windes.");
  AddSound(({"rauschen","wind"}),"Der Wind rauscht durch die Felsen.");
   
  AddExit("nordoben","./weg_5");
  AddExit("suedostunten","./weg_7");
  AddExit("norden","./weg_5");
  AddExit("suedosten","./weg_7");
  SetProp(P_HIDE_EXITS,({"norden","suedosten"}));

}