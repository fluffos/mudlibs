inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INT_LONG,
		"Hier liegen auffaellig viele Steine auf dem Weg herum, die von oben\n"
	+	"heruntergefallen sein muessen. Nicht auszudenken was passieren wuerde, wenn\n"
	+	"Dir so ein Stein auf den Kopf fallen wuerde. Als Du die Felswand hinauf\n"
	+	"schaust, siehst Du viele lockere Steine, die jeden Moment losbrechen und\n"
	+	"einen Steinschlag ausloesen koennten. Du solltest hier ganz schnell weiter-\n"
	+	"gehen, sonst koenntest Du sterben. Die Aussicht von hier ist wunderschoen und\n"
	+	"Du siehst weit unter Dir einige Woelfe und Zwerge. Ganz weit im Suedosten\n"
	+	"kannst Du sogar den Kirchturm von Midas erkennen.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  
  AddExit("westen","./weg_2");
  AddExit("suedunten","./weg_4");
  
  AddDetail("steine","Die Steine stammen von einem Steinschlag der nicht lange zuvor stattgefunden haben muss\n");
}
