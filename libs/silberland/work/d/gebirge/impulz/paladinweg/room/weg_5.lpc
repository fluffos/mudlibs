    ->Gebirge (/d/gebirge/eros/room/berg_v13.c)
    * Raum 5 *
    by Impulz@SL
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
int found;

create()
{  ::create();
  found=0;
  SetProp(P_INT_SHORT,"Ein Gebirgspfad");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:10,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Nachdem Du jetzt auch die letzten Anzeichen natuerlichen Lebens hinter "
    "Dir gelassen hast, ueberkommt Dich ein gewisses Gefuehl der Einsamkeit. "
    "Du weisst nur noch nicht, ob Du Dich davor fuerchten oder darueber "
    "freuen sollst. Schliesslich weiss man nie welche Tiere hier lauern "
    "koennten. Hinter Dir im Sueden befindet sich der Pfad auf dem Du hier "
    "hin gekommen bist. Nach Nordosten geht es weiter bergauf.");
  AddDetail("anzeichen",
    "Du findest hier nicht die geringsten Anzeichen von Leben. Selbst die "
    "wenigen Moose, die Du weiter suedlich noch gefunden hast, sind "
    "verschwunden.");
  AddDetail("leben",
    "Du scheinst das einzige Lebewesen weit und breit zu sein.");
  AddDetail("lebewesen",
    "Du bist scheinbar das einzige anwesende Lebewesen. Nichtmal ein Tier "
    "kannst Du entdecken.");
  AddDetail("moose","Die findest Du nur noch weiter unten.");
  AddDetail(({"tier","tiere"}),
    "Du kannst von hier kein Tier entdecken, was aber nicht heissen muss, "
    "dass es hier keine gibt. Durch Rufen oder lautes Sprechen kann es "
    "passieren, dass ein Tier, das sich bisher versteckt hat, auf Dich "
    "stuerzt.");
  AddDetail(({"rufen","sprechen"}),
    "Wenn du nicht von versteckten Tieren angegriffen werden willst, wuerde "
    "ich an Deiner Stelle moeglichst leise sein.");
  AddDetail("stelle",
    "Wenn Ich Du waere, wuerde ich nicht laut sprechen oder rufen.");
  AddDetail("boden",
    "Der Boden besteht nur noch aus kleinen Steinen. Von Pflanzen ist nichts "
    "mehr zu sehen.");
  AddDetail("steine",
    "Hier besteht fast alles aus Steinen.");
  AddDetail("pflanzen",
    "Pflanzen kannst Du suchen, bis Du rot-gruen-gepunktet bist. Hier gibts "
    "naemlich keine.");
  AddDetail("einsamkeit",
    "Manchmal ist gar nicht so schlimm alleine zu sein. Zumindest ist das "
    "weit weniger gefaehrlich :). Solltest Du allerdings auf die Idee kommen "
    "hier laut zu sprechen oder zu rufen, koennte es sein, dass Du diese "
    "Einsamkeit nicht mehr lange verspuerst.");
  AddDetail("gefuehl",
    "Du hast das Gefuehl hier ziemlich allein zu sein, aber das Gefuehl kann "
    "auch taeuschen.");
  AddDetail("himmel",
    "Der Himmel kommt Dir immer naeher, je hoeher Du gehst. Kein Woelkchen "
    "truebt das leuchtende Himmelsblau.");
  AddDetail(({"blau","himmelsblau"}),
    "Das Blau sieht wunderschoen aus.");
  AddDetail(({"idee","folge"}),
    "Die Idee hier laut zu sprechen oder zu rufen, koennte zur Folge haben, "
    "dass Du unangenehme Gesellschaft bekommst.");
  AddDetail("pfad",
    "Der Pfad fuehrt von suedunten hierauf und geht nach nordostoben "
    "weiter.");
  AddDetail("gesellschaft",
    "So sehr Du Dir auch Gesellschaft hier oben wuenscht, koennte falsches "
    "Verhalten unangenehme Lebewesen anlocken.");
  AddDetail("verhalten",
    "Wie Du Dich hieroben zu verhalten hast, musst Du selbst entscheiden. "
    "Es koennte nur u.U. unangenehme Konsequenzen haben.");
  AddDetail("konsequenzen",
    "Du musst die Konsequenzen schon selbst tragen.");
  AddDetail("woelkchen",
    "Du siehst kein einziges Woelkchen am Himmel.");
  AddCmd("ruf","clonefkt");
  AddCmd("rufe","clonefkt");
  AddCmd("sage","clonefkt");
  AddCmd("sag","clonefkt");
  AddExit("suedunten","./weg_6");
  AddExit("nordwestoben","./weg_4");
  AddExit("sueden","./weg_6");
  AddExit("nordwesten","./weg_4");
  SetProp(P_HIDE_EXITS,({"sueden","nordwesten"}));
  
}

reset(arg)
{
 ::reset(arg);
  found=0;
  return 1;
}


gegner()
{ object ob;
  found=1;

  return; // woody - aus balancegruenden voruebergehend abgehaengt.

  write("Auf einmal hoerst Du hinter Dir ein Trampeln.\n");
  write(
    "Erschrocken drehst Du Dich um und siehst einen Steinbock mit "
    "gesenkten Hoerner \nvor Dir stehen.\n");
  write("Vielleicht haettest Du doch keinen Laerm machen sollen...\n");
  ob=clone_object("/d/gebirge/impulz/paladinweg/npc/steinbock");
  ob->move(this_object(),M_GO);
//  ob->Kill(this_player());  Is vielleicht doch etwas gemein, da der
// Steinbock grausam is (siehe Abgrund runterstossen)

}

clonefkt()
{
  if (!found) call_out("gegner",1);
  return 0;
}
