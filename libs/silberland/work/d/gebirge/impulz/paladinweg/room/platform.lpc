/* Zielraum beim Absturz
 * by Impulz@SL
 */

inherit "std/room";

#include <properties.h>
#include <moving.h>


// machen wirs einfach zum testen
create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein winziges Plateau");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_INT_LONG,
    "Du stehst auf einem winziges Plateau aus rohem Stein.");

  AddExit("oben","/d/gebirge/impulz/paladinweg/room/weg_5");
}