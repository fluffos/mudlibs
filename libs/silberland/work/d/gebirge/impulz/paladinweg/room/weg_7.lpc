/*  Paladinweg Burg(/gilden/paladine/room/burg_c3.c)
    ->Gebirge (/d/gebirge/eros/room/berg_v13.c)
    * Raum 7 * (Anschluss ans Gebirge)
    by Impulz@SL
*/

inherit "std/room";
#include <properties.h>

create()
{ ::create();
  SetProp(P_INT_SHORT,"Vor einem Berg");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:10,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Du stehst auf einer kleinen Wiese vor einem grossen Berg. Ein paar "
    "Baeume stehen am Wiesenrand und bewegen sich im Wind. Am Ende der Wiese "
    "siehst Du einen Pfad, der den Berg hinauf fuehrt, steil ansteigen. "
    "Aus dem Wald im Suedosten ist Vogelgezwitscher zu hoeren.");
  
  AddDetail("wiese",
    "Die Wiese hat schon einen leichten Gelbton, der darauf hinweist, dass "
    "es an Wasser mangelt. Darum eignet sie sich auch nicht als Tierweide.");
  AddDetail("gelbton","Das Gras ist schon leicht gelblich gefaerbt.");
  AddDetail("gras","Das Gras ist laengst nicht so saftig wie in der Ebene.");
  AddDetail("ebene","Die Ebene ist viel weiter suedlich.");
  AddDetail("wasser",
    "Leider gibt es hier nicht soviel Wasser, so dass die Wiese schon "
    "ziemlich trocken ist.");
  AddDetail(({"tierweide","weide"}),
    "Als Tierweide ist diese Wiese denkbar ungeeingnet. Darum sind die "
    "Schaefer auch schon vor langer Zeit in die Ebene gezogen.");
  AddDetail("zeit","Es ist schon lange her, dass hier Schaefer waren.");
  AddDetail("schaefer",
    "Schaefer hat diese Gegend schon lange nich mehr gesehen.");
  AddDetail("gegend","Die Gegend sieht ziemlich felsig aus.");
  AddDetail("berg",
    "Der Berg sieht von hier unten riesig aus. Oben auf dem Berg siehst Du "
    "ein sehr grosses Gebaeude. Ein kleines Schild am Pfadbeginn zeigt "
    "den Namen des Bergs.");
  AddDetail("gebaeude",
    "Du kannst von hier unten nicht erkennen um was es sich dabei handelt.");
  AddDetail("schild","Auf dem Schild steht 'Sturmspitze'.");
  AddDetail("sturmspitze","Das ist der Name des Bergs.");
  AddDetail("name","Der Berg heisst Sturmspitze.");
  AddDetail(({"pfadbeginn","beginn","pfad"}),
    "Der Pfad beginnt am Ende der Wiese und fuehrt weit hinauf nach "
    "Nordwesten auf den Berg. Ein kleines Schild steht neben dem Pfad.");
  AddDetail("nordwesten","Im Nordwesten gelangst Du auf den Berg.");
  AddDetail("ende","Alles hat ein Ende, auch die Wiese.");
  AddDetail("baeume",
    "Die Baeume sind nur Laubbaeume und stehen aus irgendeinem Grund "
    "am Rande der Wiese.");
  AddDetail("grund",
    "Den wuesstest Du gerne, wirst ihn aber wohl nie erfahren.");
  AddDetail("laubbaeume","Laubbaeume sind fast die einzigen Baeume hier.");
  AddDetail("boden",
    "Der Boden ist hier von Gras ueberdeckt. Nur am Ende der Wiese beginnt "
    "ein Pfad, der mit Schotter befestigt wurde.");
  AddDetail("schotter","Damit wurde der Pfad befestigt.");
  AddDetail("himmel",
    "Der Himmel ist hellblau und die Sonne strahlt Dir entgegen.");
  AddDetail("sonne",
    "Die Sonne waermt deine Haut und Du fuehlst Dich richtig wohl.");
  AddDetail("haut","Deine Haut wird von der Sonne gewaermt.");
  AddDetail(({"rand","wiesenrand"}),
    "Am Rand der Wiese stehen einige Baeume.");
  AddDetail(({"gezwitscher","vogelgezwitscher"}),
    "Du koenntest ihm mal lauschen.");
  AddDetail("wald","Der Wald beginnt im Suedosten.");
  AddDetail("wind",
    "Der Wind rauscht in den Baeumen und Du spuerst ihn auf deiner Haut.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst den Wind in den Baeumen rauschen und Vogelgezwitscher aus dem "
    "Wald.");
  AddSound("wind","Der Wind rauscht in den Baeumen.");
  AddSound(({"gezwitscher","vogelgezwitscher"}),
    "Du lauscht gespannt den Voegel und fuehlst Dich gleich etwas freier und "
    "ruhiger.");
  AddSound("voegel","Die Voegel zwitschern vor sich hin.");
  AddSmell(DEFAULT_SMELL,
    "Du atmest die frische Luft tief in Dich ein.");
  AddSmell("luft","Die Luft ist wirklich erfrischend.");
  AddExit("suedosten","+gebirge/eros/room/berg_v13");
  AddExit("nordwestoben","./weg_6");
  AddExit("nordwesten","./weg_6");
  SetProp(P_HIDE_EXITS, ({"nordwesten"}));
  AddItem("/d/gebirge/impulz/paladinweg/npc/eule",REFRESH_DESTRUCT);
}
