/*  Paladinweg Burg(/gilden/paladine/room/burg_c3.c)
    ->Gebirge (/d/gebirge/eros/room/berg_v13.c)
    * Raum 1 (Anschluss an Burg) *
    by Impulz@SL
*/


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

string chkalign()
{ int align;
  align=this_player()->QueryProp(P_ALIGN);
  if (align<0)
    { return "Der Waechter laesst Dich nicht passieren, da Du zu boese"    
             " bist.\n";}
  write("Der Waechter laesst Dich passieren.\n");
  this_player()->move("/gilden/paladine/room/burg_c4",M_GO,
                      "die Bruecke","betritt","kommt auf die Bruecke");
  return "";
}


create() 
{
  ::create();
  SetProp(P_INT_SHORT,"Vor einer Bruecke");
  SetProp(P_INT_LONG,
		"Du stehst direkt vor einer grossen Haengebruecke aus Holz, " 
		"die ueber den Burggraben hinweg nach Norden in den Burghof "	
		"fuehrt. Die Burg, die von den Ortskundigen ehrfurchtvoll " 
		"Sturmfels genannt wird, liegt jetzt vor Dir. Voller Staunen " 
		"blickst Du auf das grosse Wappen, das ueber dem Eingang "
		"haengt. Fast nebenbei bemerkst Du, dass die Burg den "
		"hoechsten Punkt auf dem Berg Sturmspitze bildet.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail(({"bruecke","haengebruecke"}),
	"Die Bruecke hat einen grossen Bogen am Anfang, in dem dasselbe "
	"Wappen, das auch ueber dem Eingangstor haengt, abgebildet ist. "
	"Die Bruecke fuehrt ueber den mit Wasser gefuellten Burggraben ins "
	"Innere der Burg Sturmfels.");

  AddDetail(({"bogen","anfang"}),
	"Ein grosser Bogen bildet den Anfang der Bruecke.\n");
  AddDetail(({"burg","sturmfels","bild","ort"}),
	"Die Burg Sturmfels sieht von hier aus wirklich beeindruckend aus. "
	"Wenn Du mutig genug bist, kannst Du ueber die Bruecke in die Burg "
	"hineingehen.\n");
  AddDetail( ({ "graben","burggraben" }),
    "Der Graben fuehrt wohl rund um die Burg. Kleine Enten schwimmen darin.");

  AddDetail( ({ "enten","ente" }),
    "Grosse und kleine Enten schwimmen in dem Graben und suchen vor allem "
    "nach Futter.");

  AddDetail( ({ "futter" }),
    "Die Enten suchen, finden aber anscheinend nichts.");

  AddDetail("ortskundige",
	"Das sind die wenigen, die diesen heiligen Ort schon gesehen haben.");
  AddDetail("staunen",
	"Vor Staunen steht dein Mund weit offen und deine Augen fallen fast "
	"aus deinem Kopf. Waere da nicht dieses beeindruckende Bild der Burg," 
	" wuerde man Dich wahrscheinlich fuer einen Idioten halten.");
  AddDetail(({"eingang","tor","eingangstor"}),
	"Das Eingangstor liegt hinter der Bruecke.");
  AddDetail("wappen",
	"Das Wappen sieht wirklich imposant aus. Es stellt eine Rose inmitten"
	" von zwei gekreuzten Schwertern dar. Du hoffst, dass Dir die "
	"Bedeutung im Inneren der Burg klarer wird.");
  AddDetail(({"Mund","Augen","Kopf"}),
	"Kommst Du Dir nicht irgendwie bloed vor?");
  AddDetail("idiot","Na hoffentlich bist Du keiner.");
  AddDetail(({"sturm","wind"}),
	"Der Wind blaest hier oben viel staerker als Du dachtest.");
  AddDetail( ({ "wasser" }),
	"Das Wasser fliesst ganz langsam in einem kleinen Graben um die Burg "
	"herum.");
  AddDetail("holz","Die Bruecke besteht aus sehr soliden Planken.");
  AddDetail("planken",
	"Du musst schon auf die Bruecke gehen, um genaueres zu sehen.");
  AddDetail(({"burghof","hof"}),
	"Von hier aus kannst Du leider nicht in den Burghof hineinsehen.");
  AddDetail(({"burg","sturmfels"}),
	"Die Burg Sturmfels liegt in ihrer gesamten beeindruckenden Pracht "
	"vor dir. Die Bewohner der umliegenden Siedlungen sprechen den Namen "
	"der Burg nur mit grosser Ehrfurcht und Bewunderung aus. Die Burg "
	"steht wie ein Fels in der Brandung im starken Wind und scheint "
	"fast von einer goettlichen Aura umgeben zu sein. Du bist Dir sicher,"
	"dass sich hinter den Burgtoren etwas ganz Besonderes befinden "
	"muss.");
  AddDetail("besonderes",
        "Du bist Dir sicher, dass sich hinter den Burgtoren etwas ganz "
        "Besonderes befinden muss.");
  
  AddDetail(({"sturmspitze","berg"}),
	"Der Berg heisst wohl Sturmspitze, weil er wie eine Spitze in den "
	"Wind ragt. Auf ihm befindet sich die Burg Sturmfels.");

  AddDetail(({"punkt","spitze"}),
	"Du steht am hoechsten Punkt des Berges vor der Burg Sturmfels.\n");
  AddDetail("aura","Eine heilige Aura scheint die Burg zu umgeben.\n");
  AddDetail("bedeutung",
	"Um die Bedeutung herauszufinden solltest Du die Burg betreten.");
  AddDetail(({"bewohner","siedlungen"}),
	"Es gibt hier nur wenige bewohnte Siedlungen.");
  AddDetail(({"bewunderung","ehrfurcht"}),
	"Bewunderung und Ehrfurcht ist hier durchaus angebracht.");
  AddDetail("boden","Der Boden besteht nur aus Fels.");
  AddDetail("brandung",
	"Angesichts der Burg kommst Du auf diesen Vergleich.");
  AddDetail("vergleich","'wie ein Fels in der Brandung' ist ein Vergleich.");
  AddDetail(({"tore","burgtore"}),
	"Du wuerdest schon gerne wissen was sich dahinter befindet.");
  AddDetail("ebene","Die Ebene liegt sehr tief unter Dir.");
  AddDetail(({"fels","felsen"}), "Hier besteht fast alles aus Fels.");
  AddDetail(({"himmel","gefuehl"}),
	"Du hast das Gefuehl dem Himmel schon viel naeher gekommen zu sein."
	"Fragt sich nur in welcher Hinsicht :).");
  AddDetail("hinsicht","Du untersuchst auch jeden ******, oder ?");
  AddDetail(({"inneres","inneren"}),
	"Um heraus zu finden, was in der Burg ist, musst Du wohl rein.");
  AddDetail(({"name","namen"}),"Die Burg heisst Sturmfels.");
  AddDetail("pracht","Die Burg ist wirklich beeindruckend.");
  AddDetail("rose","Eine rote Rose halt.");
  AddDetail("schwerter",
	"Die beiden Schwerter sind gekreuzt und bilden zusammen mit der "
	"Rose das Wappen.");
  
  AddSound(DEFAULT_SOUND,"Du hoerst den Wind pfeifen.\n");
  AddSound("wind","Der Wind pfeift durch die Felsen.\n");
  AddSmell(DEFAULT_SMELL,"Die frische Luft hier oben tut richtig gut.\n");
  AddSmell("luft","Die Luft ist hier viel besser als unten in der Ebene.\n");
 
  AddExit("suedostunten","./weg_2");
  AddExit("suedosten","./weg_2");
  SetProp(P_HIDE_EXITS,({"suedosten"}));  
  AddItem("/d/gebirge/impulz/paladinweg/npc/waechter",REFRESH_DESTRUCT);      
  AddItem("/d/gebirge/impulz/paladinweg/npc/waechter",REFRESH_DESTRUCT);      

AddGuardedExit("nordosten","/gilden/paladine/room/burg_c4","brueckenwaechter",#'chkalign);

}

