#include <properties.h>
#include <moving.h>

string prefix;
string *seq;
int cur;
object player;
closure fkt;


tell_impulz(string bla)
{
  tell_object(find_player("impulz"),bla);
  return;
}

int LoadSequenz(string filename, object ob, closure cl) {
  if (find_call_out("AbsturzStep") != -1) return -1;
  if (filename[0] != '/') {
    filename="/d/gebirge/impulz/paladinweg/"+filename;
  }
  seq=explode(read_file(filename), "\n");
  if (sizeof(seq) < 1) return -1;
  cur=0;
  player=ob;
  fkt=cl;
  call_out("AbsturzStep", 0);
  return 1;
}

void AbsturzStep() {
  string s,cmd,arg;

  while (cur < sizeof(seq)) {
    s=seq[cur++];
    if (s[0]=='#') continue;
    cmd=0;
    sscanf(s,"%s %s", cmd, arg);
    if (!cmd) cmd=s;
    switch (cmd) {
      case "pause":
        call_out("AbsturzStep", to_int(arg));
        return;
      case "--":
        while ((s=seq[cur++]) != "--" ) {
          tell_object(player, break_string(s));
          }
        break;
      case "stop":
        if (fkt != 0 && closurep(fkt)) {
          funcall(fkt,player);
         }
        return;
      default:
        tell_impulz("PARSE ERROR IN ABSTURZ-SEQUENCER AT LINE #"+cur+" !!\n");
    }
  }
}
