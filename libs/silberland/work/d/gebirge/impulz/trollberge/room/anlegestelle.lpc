/* Anlegestelle am Trollgebirge
 * by Impulz@SL
 */

inherit "std/room";
#include <properties.h>
#include <moredef.h>

create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_PLAIN,ENV_TEMPERATURE:15]));
  SetProp(P_INT_SHORT,"Auf einem stabilen Holzsteg");
  SetProp(P_INT_LONG,
    "Du stehst auf einem ziemlich stabil aussehenden Holzsteg. "
    "Er wurde scheinbar extra verstaerkt, um auch schwere Lasten "
    "tragen zu koennen. Im Sueden fuehrt ein Weg an das Festland. "
    "In allen anderen Richtungen siehst Du Wasser soweit Du schaust. "
    "Ein kalter Wind blaest Dir ins Gesicht.");
  AddDetail(({"steg","holzsteg"}),
    "Der Steg sieht sehr stabil aus und traegt Dich problemlos.");
  AddDetail("lasten",
    "Also Dich wird der Steg wohl mit Leichtigkeit aushalten.");
  AddDetail("weg",
    "Der Weg fuehrt nach Sueden in das Landesinnere.");
  AddDetail("festland",
    "Ein paar Schritte noch und Du hast wieder festen Boden unter deinen "
    "Fuessen.");
  AddDetail("richtungen",
    "Im Norden, Westen und Osten ist nur Wasser, wie aufregend *gaehn*.");
  AddDetail("wasser",
    "Das Wasser ist sicher eiskalt und hier zu baden ist wahrscheinlich "
    "keine so tolle Idee.");
  AddCmd("bade","badefkt");
  AddDetail("wind",
    "Der Wind peitscht Dir geradezu ins Gesicht und Du spuerst wie es sich "
    "langsam roetet.");
  AddDetail("gesicht",
    "Dein Gesicht ist fast wie eingefroren von dem kalten Wind.");
  AddDetail("boden",
    "Der Boden liegt weit unter Dir. Du stehst auf einem stabilen Holzsteg "
    "rund einen Meter ueber dem Meeresspiegel.");
  AddDetail("fuesse",
    "Auch wenn der Steg stabil aussieht, wuerdest Du Dich auf festem "
    "Untergrund sicherer fuehlen.");
  AddDetail("himmel",
    "Der Himmel ist von Wolken bedeckt und daher fast ganz grau.");
  AddDetail("idee",
    "Irgendwas in deinem Gehirn sagt Dir dass Du lieber nicht im eiskalten "
    "Wasser baden solltest.");
  AddDetail(({"landesinnere","innere","inneres","ladeninneres"}),
    "Nach Sueden hin, kommst Du von der Kueste zum Landesinneren.");
  AddDetail("leichtigkeit",
    "Du brauchst keine Angst zu haben, ploetzlich einen Meter tiefer im "
    "Wasser zu schimmen.");
  AddDetail("schritte",
    "Ein paar Schritte nach Sueden und Du bist vom Steg runter.");
  AddDetail("gehirn",
    "Das kannst Du nicht sehen, ob Du vielleicht gar keins hast ? ;)");
  AddDetail("kueste",
    "Lateinisch 'ora', falls es interessiert. Ansonsten heisst so "
    "der Bereich der am Meer liegt.");
  AddDetail("bereich",
    "Auch Kueste genannt.");
  AddDetail("meeresspiegel",
    "Der Meeresspiegel ist ca. einen Meter unter Dir.");
  AddDetail("untergrund",
    "Der Untergrund besteht hier aus ein paar Holzplanken.");
  AddDetail(({"holzplanken","planken"}),
    "Sie sind zwar nicht mehr die neusten, sehen aber noch stabil aus.");
  AddDetail("wolken",
    "Wolken soweit Du sehen kannst.");
  AddDetail("meer",
    "Davon hats hier genug.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Meer.");
  AddSmell("meer",
    "Etwas salzig, so wie Meer nunmal riecht.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nur das Platschen der Wellen gegen den Steg.");
  AddSound("platschen",
    "*platsch*");
  AddSound("wellen",
    "Die Wellen rauschen so vor sich hin.");
  AddExit("sueden","./ebene1");
}

int badefkt()
{
  write(BS("Dein bischen Verstand haelt Dich davon ab."));
  say(BS(TPN+" will erst ins Wasser springen, ueberlegt es sich dann "
             "aber doch anders."));
  return 1;
}