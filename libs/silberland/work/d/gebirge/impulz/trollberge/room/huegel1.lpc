inherit "std/room";
#include <properties.h>
#include <moredef.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Auf einem steilen Pfad");
  SetProp(P_INT_LONG,
    "Du quaehlst Dich einen steil ansteigenden Pfad entlang. "
    "Die oede Landschaft um Dich herum, macht dieses Unternehmen "
    "auch nicht gerade attraktiver. In der Ferne erkennst Du die "
    "ersten Bergspitzen, die aber kaum durch den Nebel zu erkennen "
    "sind. Du verfluchst den Umstand, der Dich hierher gefuehrt hat.");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:15]));


  AddDetail("pfad",
    "Nicht mehr viel und Du musst den Pfad 'hochklettern'.");
  AddDetail("landschaft",
    "Wenn Du dachtest auf dem Schiff waere es mit all dem Meer langweilig "
    "gewesen, scheinst Du Dich geirrt zu haben. Die Tiere die hier mal waren "
    "haben sich scheinbar zu Tode gelangweilt.");
  AddDetail("unternehmen",
    "Hoffentlich lohnt sich die Muehe.");
  AddDetail("ferne",
    "Gerade als Du beginnst zu traeumen, wie schoen und einfach es doch "
    "waere, hier mit einem Hubschrauber hochzufliegen, faellt Dir ein dass "
    "der ja noch gar nicht erfunden wurde. Mist!");
  AddDetail(({"spitzen","bergspitzen"}),
    "Du siehst nur den unteren Teil der Spitzen, da der obere in den Wolken "
    "verschwindet.");
  AddDetail("nebel",
    "Der Nebel ist zwar nicht so dicht, aber auf die Entfernung, siehst Du "
    "trotzdem so gut wie nichts.");
  AddDetail("umstand",
    "Grrrrrrr...");
  AddDetail("boden",
    "Der Boden besteht aus festgetretener Erde und ist ziemlich hart.");
  AddDetail("erde",
    "Trockene, festgetretene Erde.");
  AddDetail("entfernung",
    "Viel zu weit, deiner Ansicht nach.");
  AddDetail("himmel",
    "Der Himmel ist voller Wolken und kann bezueglich Langeweile mit der "
    "Landschaft konkurrieren.");
  AddDetail("hubschrauber",
    "Sowas siehst Du hier nicht. Vielleicht weils den noch net gibt ?");
  AddDetail("meer",
    "Meer? Wo? Hier is weit und breit keins.");
  AddDetail("muehe",
    "*aechtz*, *keuch*, *stoehn*, *seufz*, ...");
  AddDetail("schiff",
    "Das Meer war interessanter als das hier.");
  AddDetail("teil",
    "Ein Teil der Bergspitzen ist sichtbar.");
  AddDetail("tiere",
    "Wenns hier mal Tiere gab haben sie sich laengst totgelangweilt.");
  AddDetail(({"tode","tod"}),
    "Der Tod fluestert Dir zu: Ich denke Du weisst schon Bescheid.");
  AddDetail("wolken",
    "Dicke, graue Wolken. Ausserdem haengen sie am Himmel.");
  AddDetail("langeweile",
    "Du gaehnst.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nichts ausser dem Wind und deinen Schritten.");
  AddSound("wind",
    "Der Wind rauscht ueber die oede Landschaft.");
  AddSound("schritte",
    "*trampel*");
  AddSmell(DEFAULT_SMELL,
    "Du riechst... nichts.");
  AddExit("suedoben","./huegel2");
  AddExit("nordunten","./ebene1");
  AddExit("sueden","./huegel2");
  AddExit("norden","./ebene1");
  SetProp(P_HIDE_EXITS,({"norden","sueden"}));
  AddCmd("kletter","kletterfkt");
  AddCmd("klettere","kletterfkt");

} 

int kletterfkt(string str)
{
  write("Ganz so schlimm isses doch noch nicht.\n");
  return 1;
}