#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
#include <moving.h>
inherit ROOM("insel/insel_inh");
int hase=0;

create()
{
  ::create();
  AddExit("osten","./insel_d3");
  AddExit("suedwesten","./insel_e1");
  SetProp(P_INT_LONG,
    "Vor Dir siehst Du einen breiten Sandstrand. Pflanzen wirst Du hier "
    "vergeblich suchen. Links von Dir befindet sich ein mittelgrosses Loch "
    "im Sand. Nach Suedwesten hin kommst Du ans Wasser.");
  AddDetail(({"sandstrand","strand"}),
    "Der Sandstrand ist beeindruckend sauber. Leider sind haufenweise "
    "Steine im Sand, so dass man sich nicht so gut hinlegen kann. Zu "
    "schade, dass es so kalt ist und die Sonne nicht durch die dichten "
    "Wolken kommt, sonst waer es hier sicher ein ganz netter Badeort.");
  AddDetail("pflanzen",
    "Hier gibt es scheinbar nur noch Sand und nichtmal Moose koennen hier "
    "wachsen.");
  AddDetail("loch",
    "Das Loch fuehrt etwas schraeg in den Sand hinein. Was da wohl drin sein "
    "mag ? Wenn Du mutig genug bist, kannste ja mal reingreifen.");
  AddCmd("greife","greifefkt");
  AddDetail("sand",
    "Der Sand ist relativ fein, aber leider mit Steinen vermischt. Du kannst "
    "unmoeglich abschaetzen, wie tief der Sand ist.");
  AddDetail("wasser",
    "Das Wasser ist wahrscheinlich eiskalt und eignet sich daher nicht so "
    "toll zum Baden. Trotzdem koennte es sich lohnen einen Blick nach "
    "Suedwesten zu riskieren.");
  AddDetail("steine",
    "Kleine und mittlere Steine liegen im Sand und stoeren etwas den Anblick.");
  AddDetail("sonne",
    "Die Sonne kommt kaum durch die dichten Wolken hindurch.");
  AddDetail("wolken",
    "Die Wolken am Himmel verhindern, dass warme Sonnenstrahlen den Sandstrand "
    "aufwaermen und verursachen eine etwas niederschlagende Stimmung, trotz des "
    "Strandes und dem tollen Ausblick aufs Meer.");
  AddDetail("anblick",
    "Der an sich schoene Anblick des Strandes wird durch etliche groebere Steine "
    "getruebt.");
  AddDetail("ausblick",
    "Der Ausblick ueber den Sandstrand hinweg auf das Meer ist atemberaubend.");
  AddDetail("baden",
    "In dem kalten Wasser wuerdest Du Dir sicherlich eine Erkaeltung holen.");
  AddDetail("badeort",
    "Meer, sauberes Wasser, sauberer Strand, alles wunderschoen, nur leider "
    "fehlt die Sonne.");
  AddDetail("blick",
    "Du solltest ruhig mal nach Suedwesten schaun, wenn Du es noch nicht getan "
    "hast.");
  AddDetail("boden",
    "Der Boden besteht nur noch aus Sand und Steinen.");
  AddDetail("himmel",
    "Am Himmel sind tausend Wolken, die den Himmel komplett bedecken.");
  AddDetail("meer",
    "Das Meer ist noch ein kleines Stueck suedlich von Dir, aber Du hoerst und "
    "riechst es schon.");
  AddDetail(({"strahlen","sonnenstrahlen"}),
    "Die Sonnenstrahlen dringen kaum durch die Wolken. Das ist wahrscheinlich "
    "auch ein Grund dafuer, dass es hier so kuehl ist.");
  AddDetail("stimmung",
    "Das kalte Klima und die Wolken druecken die Stimmung.");
  AddDetail("erkaeltung",
    "'Nee danke, nicht schon wieder' denkst Du nur.");
  AddDetail("grund",
    "Einen grund gibt es immer.");
  AddDetail("klima",
    "Das Klima hier ist saukalt.");
  AddDetail("stueck",
    "Ein klein wenig ist das Meer noch entfernt.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst das Meer rauschen.");
  AddSound("meer",
    "Das Geraeusch beruhigt irgendwie.");
  AddSound("geraeusch",
    "Na das Meer halt.");
  AddSmell(DEFAULT_SMELL,
    "Der Salzgeruch des Meeres schwebt in der Luft.");
  AddSmell(({"geruch","salzgeruch"}),
    "Du riechst das Meer und atmest einmal tief durch.");
  AddSmell("meer",
    "Der Geruch des Meeres ist einfach fantastisch.");
  AddSmell("luft",
    "In der Luft liegt ein Salzgeruch.");

}

reset()
{ 
  hase=0;
  ::reset();
}

greifefkt(string str)
{
  notify_fail("Wo willst Du hineingreifen ?\n");
  if (!str) return 0;
  if (member(({"in loch","ins loch","in loch hinein","ins loch hinein"}),
       lower_case(str))==-1) return 0;
  if (hase)
   { write("Du greifst in das Loch, kannst aber nichts entdecken.\n");
     return 1;
   }
  write(break_string(
    "Du greifst in das Loch und zuckst zusammen als Du etwas weiches "
    "ertastest. Schnell ziehst Du deine Hand zurueck."));
  hase=1;
  clone_object(NPC("sandhase"))->move(TO,M_GO);
  return 1;
}
