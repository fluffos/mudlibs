// Tunneleingang, 2. Stockwerk
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einer Raum tief unter der Erde");
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:17]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Du stehst wieder in einer kleinen Hoehle, die aber nur sehr schwach "
    "von einer flackernden Fackel ausgeleuchtet wird. Bis auf das Loch "
    "oben in der Decke mit der Leiter und dem fehlenden Stroh gleicht sie "
    "der oberen. Ein weiteres Loch im Boden mit einer Leiter fuehrt tiefer "
    "hinab.");
  AddDetail("hoehle",
    "Die Hoehle ist ziemlich klein und eng und kein Ort, der Dich verleiten "
    "koennte, laenger hier zu bleiben.");
  AddDetail("boden",
    "Der Boden ist ziemlich eben und hat nur ein Loch aus dem eine Leiter "
    "emporragt.");
  AddDetail("decke",
    "Die Decke ist ein wenig gewoelbt und ueber deinem Kopf befindet sich "
    "ein Loch mit einer Leiter, an der Du wieder noch oben kannst.");
  AddDetail("fackel",
    "Eine flackernde Fackel erhellt den Raum ein wenig.");
  AddDetail("leiter",
    "Eine Leiter fuehrt nach oben durch das Loch und eine durch das Loch im "
    "Boden nach unten.");
  AddDetail("loch",
    "Sowohl in der Decke, als auch im Boden befindet sich je ein ungefaehr "
    "gleich grosses Loch mit einer Leiter.");
  AddDetail("ort",
    "Du fuehlst Dich hier nicht sonderlich wohl, was wahrscheinlich auch "
    "daran liegt, dass die Luft ziemlich abgestanden ist.");
  AddDetail("stroh",
    "Hier gibt es keins mehr.");
  AddDetail("waende",
    "Die Waende sind wie nicht anders zu erwarten aus Fels, Dir faellt "
    "allerdings etwas an der Nordwand auf.");
  AddDetail(({"wand","nordwand"}),
    "Jemand hat dort scheinbar etwas eingeritzt, was Du aber nicht genau "
    "entziffern kannst. 'B.W.' ist alles was Du erkennst. Das davor koennte "
    "mit _viel_ Fantasie ein Herz sein.");
  AddDetail("fantasie",
    "Wie gut dass Du ein wenig Fantasie hast.");
  AddDetail("fels",
    "Er gleicht dem Fels in der oberen Hoehle.");
  AddDetail("herz",
    "'Wie suess' denkst Du.");
  AddDetail("kopf",
    "Ueber deinem Kopf ist ein Loch in der Decke.");
  AddDetail("luft",
    "Hier wird wohl nicht sehr oft gelueftet.");
  AddDetail("raum",
    "Du stehst drin.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach abgestandener Luft.");
  AddSmell("luft",
    "Irgendwie abgestanden.");
  AddSound(DEFAULT_SMELL,
    "Du hoerst dein Atmen von den Waenden wiederhallen.");
  AddSound("atmen",
    "Du hoerst dein Atmen.");
  AddExit("oben",ROOM("tunnel_c3_1"));
  AddExit("unten",ROOM("tunnel_c3_3"));

}