// Tunneleingang, erstes Stockwerk
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einer Raum unter der Erde");
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:17]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Du stehst in einer kleinen Hoehle. Auf dem Boden ist viel Stroh "
    "verteilt und in der Mitte etwas aufgehaeuft. In einer Ecke siehst "
    "Du ein Loch im Boden, aus dem eine Leiter ragt. Die Waende sind fast "
    "alle gleich monoton.");
  AddDetail("hoehle",
    "Sie scheint natuerlichen Ursprungs zu sein. Mehr kannst Du leider nicht "
    "erkennen.");
  AddDetail("boden",
    "Der Boden ist verstaendlicherweise aus Fels und mit ziemlich viel Stroh "
    "bedeckt, wahrscheinlich um den Sturz abzufangen.");
  AddDetail("stroh",
    "Das Stroh scheint schon aelter zu sein, aber trotzdem erfuellt ein "
    "schwacher Geruch von frischen Stroh den Raum. Wahrscheinlich wird das "
    "Stroh ab und zu erneuert.");
  AddDetail("ecke",
    "In einer Ecke befindet sich ein Loch von zirka einem Meter Durchmesser "
    "aus dem eine Leiter emporragt.");
  AddDetail("fels",
    "Der Fels ist ebenso kalt und hart wie ueberall auch.");
  AddDetail("geruch",
    "Sowas kannst Du doch nicht sehen.");
  AddDetail("decke",
    "An der Decke kannst Du nichts erkennen, die Luke, durch die Du herunter "
    "gefallen bist, scheint sich schon wieder geschlossen zu haben.");
  AddDetail("leiter",
    "Die Leiter ist wohl kaum natuerlichem Ursprung, genauso wie das Loch im "
    "Boden.");
  AddDetail("loch",
    "Das Loch scheint einige Meter tief zu sein und die leiter fuehrt daran "
    "herunter.");
  AddDetail("mitte",
    "In der Mitte liegt mehr Stroh als im Rest des Raumes. Das hat Dich wohl "
    "auch vor einigen Bruechen bewahrt.");
  AddDetail("raum",
    "Du stehst drin.");
  AddDetail("sturz",
    "Die Schmerzen ein deinen Knochen erinnern Dich deutlich genug daran.");
  AddDetail("ursprung",
    "Du hast keine Ahnung wie die Hoehle entstanden ist, aber es sie ist "
    "wahrscheinlich natuerlichen Ursprungs.");
  AddDetail("ahnung",
    "Du weisst es nicht und es interessiert Dich auch nicht besonders.");
  AddDetail("brueche",
    "Dir tut zwar alles weh, aber gebrochen hast Du Dir scheinbar nichts.");
  AddDetail("durchmesser",
    "Sollte genug sein, um nicht drin stecken zu bleiben, was sicherlich "
    "fatale Folgen haette.");
  AddDetail("knochen",
    "Sie tun zwar weh, sind aber noch alle heile.");
  AddDetail("luke",
    "Wenn dort eine ist, ist sie jetzt nicht zu sehen.");
  AddDetail("meter",
    "Einen ganzen Meter Durchmesser hat das Loch.");
  AddDetail("rest",
    "Ueberall liegt ein wenig Stroh herum.");
  AddDetail("schmerzen",
    "Du schwelgst eine Runde in Selbstmitleid.");
  AddDetail("waende",
    "An den vier Waenden haengt je eine Fackel, die den Raum ein wenig "
    "beleuchten. An einer Wand scheint allerdings jemand etwas in den "
    "Fels eingeritzt zu haben.");
  AddDetail("wand",
    "Dort steht: 'Ich hoffe sie hatten einen guten Sturz, und sie "
    "fliegen bald wieder mit uns.'. Sehr witzig! grr...");
  AddDetail("fackel",
    "Die sind zu stark befestigt, um eine mitnehmen zu koennen.");
  AddDetail("folgen",
    "Du moechtest gar nicht dran denken.");
  AddDetail(({"runde","selbstmitleid"}),
    "Eine Stimme fluestert Dir zu: Seicherl!!!");
  AddDetail("stimme",
    "Du siehst niemanden, dem die Stimme gehoert haben koennte.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Stroh und den Fackeln.");
  AddSmell("stroh",
    "Frisches Stroh riecht einfach toll.");
  AddSmell("fackel",
    "Die Fackeln riechen halt etwas verbrannt.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nur das Knistern der Fackeln.");
  AddSound("knistern",
    "Es ist nur ganz leise.");
  AddExit("unten",ROOM("tunnel_c3_2"));
  
}