inherit "std/room";

#include <properties.h>
#include <moredef.h>

create()
{  ::create();
   SetProp(P_INT_SHORT,"In einer Anstalt");
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,1);
   SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE,ENV_TEMPERATURE:20]));
   SetProp(P_INT_LONG,
     "Du stehst in einem grossen Raum mit ziemlich fertig aussehenden "
     "Gestalten, die sinnloses Zeug brabbeln. Ueber dem Eingang "
     "haengt ein altes Holzschild. Die kleine Tuer an der gegenueber "
     "liegenden Wand traegt die Aufschrift 'Nicht betreten!'.");
   
   AddDetail("raum",QueryProp(P_INT_LONG));
   AddDetail("gestalten",
     "Die Gestalten sind schwach und abgemagert, so dass Du zuerst den "
     "Eindruck hast, das hier waere ein Gefaengnis. Da aber keinerlei "
     "Wachen zu sehen sind, scheint das ein Fehlschluss zu sein. So "
     "ziemlich alle Rassen sind hier vertreten, von Elfen ueber Zwerge "
     "bis hin zu Ogern und etlichen Trollen.");
   AddDetail("eindruck",
     "Der Eindruck, dies sei ein Gefaengnis ist wohl eher ein Irrtum.");
   AddDetail("gefaengnis",
     "Wie in einem Gefaengnis sieht es hier nicht gerade aus.");
   AddDetail("wachen",
     "Hier gibts scheinbar keine Wachen.");
   AddDetail("irrtum",
     "Irren ist menschlich !?!");
   AddDetail("fehlschluss",
     "Sowas kann vorkommen.");
   AddDetail("rassen",
     "Es gibt massig Rassen im Silberland.");
   AddDetail("silberland","Du stehst mitten drin.");
   AddDetail("elfen",
     "Die Elfen lungern in einer Ecke rum und versuchen sich so weit wie "
     "moeglich von den Zwergen entfernt zu halten.");
   AddDetail("ecke",
     "In einer Ecke sitzen einige Elfen.");
   AddDetail("zwerge",
     "Die Zwerge laufen hintereinander in einem Kreis rum. Irgendwie "
     "ueberkommt Dich das Gefuehl, dass die auch nicht mehr alle Tassen "
     "im Schrank haben.");
   AddDetail(({"gefuehle","gefuehl"}),
     "Du fuehlst Dich hier nicht gerade wohl.");
   AddDetail(({"tassen","schrank"}),
     "Die Zwerge scheinen nicht mehr alle Tassen im Schrank zu haben.");
   AddDetail("oger",
     "Die sonst so grausamen Oger sehen total harmlos, ja sogar fast "
     "liebenswuerdig aus. Einer sitzt auf dem Boden und hat eine Blume "
     "in der Hand.");
   AddDetail("blume",
     "An der Blume fehlen schon einige Bluetenblaetter, die auf dem Boden "
     "liegen.");
   AddDetail(({"bluetenblaetter","blaetter"}),
     "Die Bluetenblaetter hat der Oger rausgezupft wobei er etwas murmelt. "
     "Vielleicht verstehst Du ihn wenn Du ihm lauscht.");
   AddSound("oger",
     "Du hoerst den Oger fluestern: 'Sie liebt mich. Sie liebt mich nicht. "
     "Sie liebt mich ...'. Unglaeubig schliesst Du Deine Augen und oeffnest "
     "sie wieder, aber der Oger sitzt wirklich dort.");
   AddDetail("aufschrift",
     "An der kleinen Tuer steht 'Nicht betreten'.");
   AddDetail("augen",
     "Du hast ganze zwei davon.");
   AddDetail("boden",
     "Der Boden besteht aus Stein und ist alles andere als sauber.");
   AddDetail("decke",
     "An der Decke gibt es absolut nichts interessantes.");
   AddDetail("eingang",
     "Der Eingang ist zugesperrt und die einzige Moeglichkeit hier heraus "
     "zu kommen scheint die kleine Tuer zu sein.");
   AddDetail("moeglichkeit",
     "Alzuviele Moeglichkeiten gibt es hier nicht.");
   AddDetail(({"schild","holzschild"}),
     "Auf dem Schild steht das Motto der Anstalt: 'Haben Sie heute schon "
     "gelitten ? Nein ? Dann wird es aber hoechste Zeit !'.");
   

                          
}