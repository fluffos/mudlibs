// Insel Raum B3 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("suedwesten","./insel_c2");
  AddExit("osten","./insel_b4");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem Weg der nebem dem Sumpf entlangfuehrt. "
    "Tausend kleine Muecken fliegen in Schwaermen umher und sind staendig in "
    "Bewegung. "
    "Im Suedwesten befindet sich die Weggabelung von der aus Du hier her "
    "gelangt bist. Nach Osten hin, kannst Du den Sumpf hinter Dir lassen.");
  AddDetail("weg",
    "Der Weg ist auf der suedlichen Seite von Sumpfgraesern begrenzt und "
    "fuehrt von hier aus weiter nach Osten. Wenn Du nach Suedwesten "
    "weitergehst, kommst Du wieder zurueck zur Weggabelung.");
  AddDetail("sumpf",
    "Es ist nur ein sehr kleiner Sumpf mit einigen Sumpfgraesern und dem "
    "ueblichen gefluegelten Kleinvieh namens Insekten, dass in solchen "
    "Gegenden anzutreffen ist.");
  AddDetail("muecken",
    "Die Muecken sind scheinbar reichlich agressiv, zum Glueck geht von "
    "ihnen aber keine grosse Gefahr fuer deine Gesundheit aus.");
  AddDetail(({"schwaerme","mueckenschwaerme"}),
    "Hunderte von Muecken tummeln sich in Schwaermen ueber dem Sumpf und "
    "an dessen Rand. Das ganze sieht fast aus wie eine dunkle Wolke.");
  AddDetail("hunderte","Es sind unzaehlbar viele.");
  AddDetail("boden",
    "Der Boden besteht aus einer duennen Erdschicht, die es den Graesern "
    "ermoeglicht hier zu wachsen. Unter deinen Fuessen befinden sich "
    "platt getrampelte Grashalme.");
  AddDetail("gefahr",
    "Mueckenstiche vergehen zum Glueck wieder relativ schnell. Sei froh, "
    "dass hier keine Moskitos rumschwirren.");
  AddDetail("gegenden",
    "In Feuchtbiotopen wie diesem Sumpf gibt es meistens unglaublich viele "
    "Insekten.");
  AddDetail("gesundheit",
    "Du bist Dir ziemlich sicher, dass Dir die Muecken nicht alzu "
    "gefaehrlich fuer Dich werden koennen.");
  AddDetail("bewegung",
    "Die Muecken schwirren scheinbar pausenlos auf der Suche nach frischen "
    "Blut umher.");
  AddDetail(({"schicht","erdschicht"}),
    "Eine nur wenige cm dicke Erdschichte ermoeglicht es den wenigen "
    "Graesern hier zu wachsen. Die Erde ist wohl durch jahrtausendlange "
    "Abtragung des Gesteins entstanden und darum auch nicht sehr fruchtbar.");
  AddDetail(({"biotope","feuchtbiotope"}),
    "Feuchtbiotope nennt man die Lebensraeume fuer Tiere und Pflanzen in "
    "feuchten Wiesen, Suempfen und Mooren.");
  AddDetail("abtragung",
    "Die Abtragung von Gestein durch Wind, Wasser und Reibung nennt man auch "
    "Erosion.");
  AddDetail("blut",
    "Hoffentlich bist Du nicht der naechste den sich die Muecken aussuchen " 
    "ihren Blutdurst zu stillen.");
  AddDetail("erde",
    "Die Erde ist ziemlich trocken und unfruchtbar.");
  AddDetail("fuesse",
    "Mit deinen Fuessen hast Du ein paar Grashalme umgeknickt. Wie "
    "ungeschickt.");
  AddDetail("gestein",
    "Unter der duennen Erdschicht wird sich aller Wahrscheinlichkeit nach "
    "Gestein befinden.");
  AddDetail("glueck",
    "Nun bist Du aber echt gluecklich.");
  AddDetail(({"graeser","sumpfgraeser"}),
    "Die Graeser wachsen rund um den Sumpf herum um moeglichst viel "
    "Feuchtigkeit abzubekommen.");
  AddDetail("himmel",
    "Der Himmel wird von grauen Wolken komplett bedeckt.");
  AddDetail("blutdurst",
    "Muecken scheinen einen gar unstillbaren Blutdurst zu verspueren.");
  AddDetail("erosion",
    "Siehe 'Abtragung'. :)");
  AddDetail("feuchtigkeit",
    "Die Graeser wachsen dank der Feuchtigkeit des Sumpfes hier "
    "reichhaltig.");
  AddDetail(({"halme","grashalme"}),
    "Einige Grashalme liegen umgeknickt auf dem Boden, nachdem Du "
    "draufgetrampelt bist.");
  AddDetail("insekten",
    "Insekten gibt es hier scheinbar endlos viele. Der groesste Teil davon "
    "sind allerdings Muecken, wie es den Anschein hat.");
  AddDetail(({"vieh","kleinvieh"}),
    "Ueberall siehst Du kleine Insekten umherschwirren.");
  AddDetail("lebensraeume",
    "Die Lebensraeume fuer Tiere und Pflanzen in feuchten Gebieten nennt "
    "man Feuchtbiotope.");
  AddDetail("moore",
    "Moore siehst oder riechst Du hier weit und breit nicht.");
  AddDetail("moskitos",
    "Du kannst hier keinerlei Moskitos entdecken und atmest erleichtert "
    "auf.");
  AddDetail("pflanzen",
    "Pflanzen gibt es hier nur wenig verschiedene. Das meiste bilden "
    "die Sumpfgraeser.");
  AddDetail("rand",
    "Am Rand des Sumpfes befinden sich auch etliche Mueckenschwaerme.");
  AddDetail("anschein",
    "So wie es aussieht sind hier weit mehr Muecken als alle anderen "
    "Insekten zusammen.");
  AddDetail("gebiete",
    "Das hier ein Gebiet zu nennen mag etwas uebertrieben sein, da es "
    "viel eher ein Fleckchen ist.");
  AddDetail("fleckchen",
    "Der Begriff passt besser als Gebiete.");
  AddDetail("begriff",
    "Ich hoffe, Du bist nicht begriffsstutzig.");
  AddDetail("reibung",
    "Reibung kann ausser durch Wind und Wasser auch dadurch entstehen, "
    "dass Leute wie Du hier staendig hin und her rennen.");
  AddDetail("seite",
    "Auf der suedlichen Seite wird der Weg durch Sumpfgraeser begrenzt.");
  AddDetail("suche",
    "Du hoffst, dass die Muecken nicht bei Dir suchen, da Du sonst "
    "nacher aussiehst wie nen Streuselkuchen.");
  AddDetail("suempfe",
    "Hier gibt es scheinbar auf der ganzen Insel nur den einen kleinen "
    "Sumpf hier.");
  AddDetail("teil",
    "Den groessten Teil der Insekten machen die Muecken aus.");
  AddDetail("tiere",
    "An Tieren siehst Du hier derzeit nur Insekten.");
  AddDetail("wahrscheinlichkeit",
    "Es ist ziemlich wahrscheinlich, dass sich unter der Erdschicht "
    "Gestein befindet.");
  AddDetail("wasser",
    "Wasser gibt es hier nicht sonderlich viel.");
  AddDetail(({"gabelung","weggabelung"}),
    "Der Weg gabelt sich im Suedwesten.");
  AddDetail("wiesen",
    "Auch feuchte Wiesen sind Feuchtbiotope.");
  AddDetail("insel",
    "Du stehst drauf.");
  AddDetail("leute",
    "Leute wie Du und ich.");
  AddDetail(({"kuchen","streuselkuchen"}),
    "Es reizt Dich nicht sonderlich wie ein Streuselkuchen auszusehen "
    "und darum versuchst Du Dich moeglichst weit von den Muecken entfernt "
    "aufzuhalten.");
  AddDetail("wind",
    "Der Wind blaest Dir ins Gesicht.");
  AddDetail("gesicht",
    "Du verziehst Gesicht als der Wind Staub in deine Augen weht.");
  AddDetail("augen",
    "Der Staub brennt ein wenig in deinen Augen.");
  AddDetail("staub",
    "Der Wind hat ein wenig Staub in deine Augen geweht.");
  AddDetail("wolke",
    "So ein Mueckenschwarm sieht aus wie eine dunkle Wolke, die zu tief "
    "schwebt.");
  AddDetail("wolken",
    "Dicke, graue Wolken bedecken den Himmel.");
  AddDetail(({"mueckenschwarm","schwarm"}),
    "Es gibt hier etliche Mueckenschwaerme und jeder sieht aus wie eine "
    "schwarze Wolke.");

  AddSmell(DEFAULT_SMELL,
    "Du schliesst die Augen und atmest tief durch. Ein Berg von Geruechen "
    "ueberwaeltigt Dich fast. Du riechst das Meer, den etwas vermoderten "
    "Geruch des Sumpfes, die Graeser und ... Kot !?!");
  AddSmell("gerueche",
    "Du kannst das Meer, den Sumpf und die Graeser riechen. Ausserdem steigt "
    "Dir der etwas unangenehme Geruch von Kot in die Nase.");
  AddSmell("meer",
    "Der Salzgeruch des Meeres wirkt auch Dich beruhigend und befreiend "
    "zugleich.");
  AddSmell("salzgeruch",
    "Das Meer reicht etwas nach Salz.");
  AddSmell("geruch",
    "Welchen Geruch meinst Du denn ? Den Salzgeruch oder den Sumpf ?");
  AddSmell(({"sumpf","sumpfgeruch"}),
    "Der Sumpf riecht etwas vermodert und feucht.");
  AddSmell("graeser",
    "Du taetigst nochmal einen tiefen Atemzug um den natuerlichen Duft "
    "der Graeser einzuatmen und bekommst dabei einige Pollen in die "
    "Nase. Iiiig, das kitzelt.");
  AddSmell("duft",
    "Die Graeser duften gut und aehnlich wie Getreide.");
  AddSmell("pollen",
    "Die kannst Du zwar nicht direkt riechen, dafuer kitzeln sie aber "
    "in deiner Nase.");
  AddSmell("getreide",
    "Frisch geerntetes Getreide riecht auch gut.");
  AddSmell("nase","Wie soll das denn gehen ?");
  AddSmell("kot",
    "Entsetzt schaust Du genauer auf den Boden und entdeckst, dass Du "
    "eben in einen Haufen tierischer Exkremente getreten sein musst. "
    "Wie das stinkt.");
  AddSmell("exkremente",
    "Das stinkt zum Himmel. Im wahrsten Sinne des Wortes.");
  AddSmell("salz",
    "Das Meer riecht nach Salz.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst das Summen der Muecken und den Wind.");
  AddSound("summen",
    "Tausende von Muecken summen durch die kuehle Luft und erzeugen "
    "ein permanenten Summton.");
  AddSound("summton",
    "Der wird von den Muecken beim Summen erzeugt. Irgendwie logisch oder ?");
  AddSound("wind",
    "Der Wind pfeift ueber die Graeser und den Sumpf.");
  AddSmell(({"atemzug","berg","haufen","sinn","wort"}),
    "Woran moechtest Du riechen ?");
  AddSound("luft",
    "Die Luft verteilt das Summen der Muecken.");

}
  
  
