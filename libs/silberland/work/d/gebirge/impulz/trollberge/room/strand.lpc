// Strand mit Partyhaus
// (c)Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include <moving.h>
#include "../trolldefs.h"
string alkdesc();

create()
{
  ::create();
  SetProp(P_INT_SHORT,"An einem Strand");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_HILL]));
  SetProp(P_INDOORS,0);
  SetProp(P_INT_LONG,
    "Abgesehen von einigen kleinere Woelkchen ist der Himmel hier strahlend "
    ".. grau. Ein paar Moewen fliegen kreischend ueber dem Wasser und der "
    "kuehle Wind weht Dir winzige Sandkoerner ins Gesicht. Aus einem auf "
    "Pfeiler stehenden Holzhaus dringt Musik, der Geruch von Alkohol und "
    "einige Stimmen.");
  AddCmd(({"betrete","betret","betritt"}),"hausfkt");
  AddCmd("","AllesFkt",1);
  AddDetail("woelkchen",
    "Nur ein paar kleine weisse Woelkchen werden vom Wind den Himmel entlang "
    "geweht.");
  AddDetail("himmel",
    "Der Himmel ist zwar fast wolkenfrei aber dennoch grau und ungemuetlich."
    );
  AddDetail("wind",
    "Der kuehle Wind kommt vom Meer her und weht unerbittlich feinsten Sand "
    "in dein Gesicht und deine Augen.");
  AddDetail("alkohol",#'alkdesc);
  AddDetail("augen",
    "Der Sand brennt fuerchterlich in deinen Augen und Du siehst alles ein "
    "wenig verschwommen.");
  AddDetail("boden",
    "Der Boden besteht vollstaendig aus Sand und vielen groeberen Kieseln "
    "und Steinen mit bis zu zehn Zentimeter Durchmesser.");
  AddDetail("geruch",
    "Das Zauberwort heisst RIECHEN.");
  AddDetail("gesicht",
    "Der Sand peitscht gegen dein Gesicht, welches sich langsam roetet.");
  AddDetail(({"haus","holzhaus"}),
    "Das Holzhaus steht auf Pfeiler, damit das Meerwasser das Holz nicht "
    "langsam verfaulen laesst. Dort drinnen scheint ne riesige Party am "
    "Laufen zu sein. Wenn Du willst kannst Du das Haus betreten.");
  AddDetail("kiesel",
    "Sand, Kiesel und Steine sind alles was Du hier am Boden siehst.");
  AddDetail("meer",
    "Rund 20 Meter entfernt rauscht das Meer und die Wellen laufen "
    "langsam aus. Das Meer reicht nicht ganz bis zum Haus, so dass "
    "Du ohne nass zu werden zum Haus gelangen kannst.");
  AddDetail("holz",
    "Das Holz ist ein ewnig mit Moos bewachsen, was wohl an der "
    "Feuchtigkeit liegt. Sonst faellt Dir daran nichts Besonderes "
    "auf.");
  AddDetail("besonderes",
    "Du siehst nichts Besonderes an dem Holz und einen Forscherpunkt "
    "gibts hierfuer auch nicht.");
  AddDetail(({"wasser","meerwasser"}),
    "Das salzige Meerwasser wuerde wohl langsam aber sicher dass Holz "
    "zersetzen.");
  AddDetail("moewen",
    "Die Moewen ziehen kreischend ihre Runden auf der Suche nach Nahrung.");
  AddDetail("musik",
    "Du kannst nicht erkennen, was fuer Musik gerade laeuft, aber wenn Du "
    "sie sogar hier hoeren kannst, muss sie in dem haus verdammt laut sein.");
  AddDetail("party",
    "Es scheint eine private Party zu sein, und Du hast keine Ahnung "
    "weshalb sie stattfindet. Vielleicht kannst Du es ja drinnen erfahren.");
  AddDetail("durchmesser",
    "Der Durchmesser betraegt bis zu zehn Zentimeter.");
  AddDetail("feuchtigkeit",
    "Am Meer ist die Luft meistens feucht.");
  AddDetail("luft",
    "Die gibts hier auch.");
  AddDetail("moos",
    "Ein wenig davon waechst an den Waenden des Holzhauses.");
  AddDetail(({"nahrung","hauptnahrung"}),
    "Die Hauptnahrung der Moewen sind wohl Fische.");
  AddDetail("fische",
    "Du siehst hier keine Fische.");
  AddDetail(({"sand","sandkoerner"}),
    "Ueberall liegt Sand. Ist wohl meistens so, wenn man an einem Strand "
    "steht.");
  AddDetail("steine",
    "Im Sand liegen hin und wieder einige Steine.");
  AddDetail("pfeiler",
    "Das Haus steht auf Pfeiler, damit kein Meerwasser das Holz zerfrisst.");
  AddDetail("stimmen",
    "Die kannst Du nicht sehen.");
  AddDetail("wellen",
    "Die Wellen laufen einige Meter weit entfernt von Dir am Strand aus.");
  AddDetail("strand",
    "Du steht an einem.");
  AddDetail("waende",
    "An den Waenden des Holzhauses waechst ein wenig Moos.");
  AddDetail("fenster",
    "Aus den Fenster dringt Alkoholgeruch und laute Musik.");
  AddDetail(({"ahnung","laufen","meter","riechen","runden","suche","wort",
              "zauberwort","zentimeter","detail","beschreibung"}),
    "Dieses Detail ist so unwichtig, dass es keine Beschreibung hat.");
  AddSmell(DEFAULT_SMELL,
    "Der starke Alkoholgeruch ueberlagert den Salzgeruch des Meeres.");
  AddSmell("alkoholgeruch",
    "Er dringt aus den offenen Fenstern des Hauses.");
  AddSmell("salzgeruch",
    "So riecht das Meer nunmal.");
  AddSmell("meer",
    "Es riecht salzig.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst laute Musik und einige Stimmen.");
  AddSound("musik",
    "Die Musik kommt aus dem Haus und ist verhaeltnismaessig laut.");
  AddSound("stimmen",
    "Du kannst die Stimmen zwar grad noch wahrnehmen, die aber nicht "
    "verstehen.");
  AddItem(NPC("bes_str"),REFRESH_DESTRUCT);
  AddExit("suedosten","./ebene1");
}


int AllesFkt(string str) {
   if (!random(20))
     write(BS("Dir weht ein wenig Sand in die Augen und Du siehst fuer "
           "einen Augenblick nichts mehr."));
}


string alkdesc()
{ 
  string retstring;
  retstring="Aus den offenen Fenster dringt ein starker Alkoholgeruch bis zu "
           "Dir. ";
  if (TP->QueryProp(P_GUILD)=="zechpreller")
    retstring+="Eine magische Kraft zieht Dich foermlich zu dem Haus hin "
       "und Du beginnst schon zu stammeln 'Alkohol, Allohol, Allhol, HIN DA.";
  else
    retstring+="Ein Zechpreller koennte sich wahrscheinlich kaum halten und "
               "sofort zum Haus rennen.";
  return BS(retstring);
  
}

int hausfkt(string str)
{
  str=lower_case(str);
  if ((str!="haus") && (str!="holzhaus")) return 0;
  tell_object(TP,"Du gehst zur Eingangstuer und betrittst das Haus.\n");
  say(TP->name()+ " betritt das Haus.\n");
  TP->move(ROOM("haus"),M_NOCHECK | M_SILENT);
  return 1;
}
  