/* Anlegestelle fuer Kahn auf der Insel vor den Trollbergen
 * by Impulz@SL
 */
 

#include <properties.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  SetProp(P_INT_LONG,
     "Du stehst vor einem kleinen Abgrund und blickst auf das weite Meer "
     "hinaus. Ein kuehler Wind streicht Dir sanft ueber die Haut und Du "
     "beginnst leicht zu froesteln. Nach Sueden fuehrt ein Trampelpfad ins "
     "Inselinnere. Fusspuren fuehren direkt bis zum Abgrund.");
  AddDetail(({"spuren","fusspuren","fussspuren"}), // neue rextshraipräfoam
     "Die Spuren fuehren direkt bis zum Abgrund, als ob hier jemand "
     "an Land gegangen waere. Wahrscheinlich stammt dieser jemand von einem "
     "Schiff das hier ab und zu anlegt.");
  AddDetail("land",
     "Du stehst drauf.");
  AddDetail(({"schiff","schiffe"}),
     "So ein Ding aus Holz, dass auf dem Wasser schwimmen soll.");
  AddDetail("holz",
     "U.a. kann man daraus Schiffe machen.");
  AddDetail("wasser",
     "Du kannst das Wasser von hier zwar nicht direkt erreichen, es scheint "
     "aber eiskalt zu sein.");
  AddDetail("abgrund",
     "Der Abgrund ist nur knapp 5 m tief. Unten schlagen die Wellen gegen "
     "den mit Moos und Muscheln bewachsenen Fels.");
  AddDetail("wellen",
     "Die Wellen schlagen laut gegen den Fels.");
  AddDetail("fels",
     "Der Fels selber ist unter den Unmengen an Moos und kleinen Muscheln "
     "kaum noch zu sehen.");
  AddDetail("unmengen",
     "Muscheln und Moos gibts an dem Felsen wirklich viel.");
  AddDetail("moos",
     "Das Moos befindet sich eher ueber dem Meeresspiegel, da es dort nicht "
     "so nass ist.");
  AddDetail("muscheln",
     "Die Muscheln kleben unglaublich feste an dem Felsen. Eine besonders "
     "schoene Muschelschale springt Dir geradezu ins Auge.");
  AddDetail("auge", "Du hast zwei davon.");
  AddDetail("meeresspiegel",
     "Der Meeresspiegel liegt rund 5 m unter Dir.");
  AddDetail(({"muschelschale","schale"}),
     "Als Du die Muschel benauer betrachtest faellt Dir auf, dass sie sich "
     "bewegt. Am Rand der Muschel tauchen ploetzlich kleine Scherenbeinchen "
     "auf.");
  AddDetail("rand",
     "Am Rand der Muschel sind kleine Scherenbeinchen zu sehen.");
  AddDetail(({"beinchen","scherenbeinchen"}),
     "Die Beinchen erinnern Dich an einen Krebs. Na klar, das ist gar keine "
     "normale Muschel sondern ein Einsiedlerkrebs der sich die Muschel als "
     "Rueckzugsort ausgesucht hat.");
  AddDetail(({"krebs","einsiedlerkrebs","einsiedlerkrebse","krebse"}),
     "Einsiedlerkrebse suchen sich verlassene Muscheln und kriechen dort "
     "hinein.");
  AddDetail(({"rueckzugsort","ort"}),
     "Jeder brauch so einen Ort.");
  AddDetail("boden",
     "Der Boden besteht aus trockener feiner Erde, die durch den Wind ueber "
     "den darunter liegenden Fels geweht wird.");
  AddDetail("erde",
     "Die Erde ist noch feiner als Sand und laesst sich so leicht vom Wind "
     "davontragen.");
  AddDetail("sand",
     "Sand siehst Du hier noch nicht.");
  AddDetail("fels",
     "Du kannst den Fels nicht direkt sehen, spuerst aber dass der Boden "
     "ziemlich hart ist und vermutest deshalb, dass es sich darunter um "
     "Stein handeln muss.");
  AddDetail("stein",
     "Vermutlich ist unter dem Staub und der Erde Stein.");
  AddDetail("wind",
     "Der kuehle Wind streicht Dir ueber die Haut und eine leichte "
     "Gaensehaut ueberkommt Dich.");
  AddDetail("gaensehaut",
     "Du weisst schon was das ist.");
  AddDetail("haut",
     "Du spuerst den kuehlen Wind auf deiner Haut.");
  AddDetail("himmel",
     "Der Himmel ist voll von grauen Wolken, die Du durch den Nebel gerade "
     "noch erkennen kannst.");
  AddDetail("nebel",
     "Der Nebel ist nicht sehr dicht, aber sonderlich weit sehen kannst Du "
     "auch nicht.");
  AddDetail(({"innere","inneres","inselinnere","inselinneres"}),
     "Nach Sueden kommst Du ins Inselinnere.");
  AddDetail("meer",
     "Das Meer scheint nach Norden hin unbegrenzt zu sein, auch wenn Du "
     "aufgrund des Nebels nicht alzu weit blicken kannst.");
  AddDetail("staub",
     "Staub und trockene feine Erde bedecken den Boden.");
  AddDetail(({"pfad","trampelpfad"}),
     "Ein schmaler Trampelpfad fahrt nach Sueden weiter.");
  AddDetail("wolken",
     "Die grauen Wolken bedecken den ganzen Himmel und lassen nur wenig "
     "Sonnenstrahlen durch.");
  AddDetail(({"strahlen","sonnenstrahlen"}),
     "Nur wenig Sonnenstrahlen durchdringen die dichten grauen Wolken am "
     "Himmel.");
  AddSound(DEFAULT_SOUND,"Du hoerst die Wellen gegen die Felsen schlagen.");
  AddSound("wellen",
     "Die Wellen schlagen fast gleichmaessig gegen die Felsen.");
  AddSmell(DEFAULT_SMELL,
     "Der Wind traegt einen leichten Salzgeruch vom Meer heran.");
  AddSmell("salzgeruch",
     "So riecht das Meer.");
  AddExit("sueden","./insel_b1");
  // Wenn man den Raum mit der lupe neu geladen hat, wurde immer eine neue 
  // kogge geclont, obwohl die alte noch herumschipperte.
  // Das ist zu gefaehrlich falls man den raum aus irgendeinem grund mal
  // neu laden muss. Falls man die kogge also neu haben will, bitte
  // erst die kogge destructen und dann den raum neu laden.
  if (!find_object(OBJ("kogge")))
    AddItem(OBJ("kogge"),REFRESH_DESTRUCT);
}
