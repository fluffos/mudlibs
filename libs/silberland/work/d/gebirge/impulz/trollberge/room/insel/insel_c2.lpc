// Insel Raum C2 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

string ruecken()
{ return BS("Als "+TP->QueryProp(P_RACE)+" solltest Du eigentlich einen "
            "Ruecken haben. Also weisst Du doch was das ist.");
}

string zeit()
{ write("Du hast das Gefuehl, dass es \n");
  this_player()->command_me("zeit");       //Ich weiss, ich bin faul
  return BS("ist.");
}

create()
{
  ::create();
  AddExit("nordwesten","./insel_b1");
  AddExit("nordosten","./insel_b3");
  AddExit("suedosten","./insel_d3");
  SetProp(P_INT_LONG,
    "Du stehst vor einem kleinen Sumpf um desses Rand Sumpfgraeser vom Wind "
    "hin und her gewiegt werden. Der Weg teilt sich auf fuehrt an den beiden "
    "Seiten des Sumpfes her. Ein ziemlich vergammelter und halb verwester "
    "Wegweiser liegt am Boden herum.");
  AddDetail("sumpf",
    "Der Sumpf liegt vor Dir, umgeben von Sumpfgraesern.");
  AddDetail("rand",
    "Am Rand des Sumpfes wachsen verschiede Graeser.");
  AddDetail(({"graeser","sumpfgraeser"}),
    "Die Graeser werden vom Wind sanft hin und her gedrueckt, so dass der "
    "Sumpf sich zu bewegen scheint.");
  AddDetail("wind",
    "Der Wind ist immernoch ziemlich kuehl und streicht sanft ueber deine "
    "Haut. Das wird sich wohl auch nicht aendern, solange Du hier auf der "
    "Insel bist.");
  AddDetail("weg",
    "Von hier aus kannst Du in drei Richtungen gehen. Der entsprechende "
    "Wegweiser liegt halb verfault am Boden.");
  AddDetail("seiten",
    "An den Seiten des Sumpfes fuehren zwei Wege in verschiede Richtungen.");
  AddDetail("richtungen",
    "Nach Nordwesten, Nordosten und Suedosten fuehrt jeweils ein Weg.");
  AddDetail("haut",
    "Der Wind streicht ueber deine Haut und verursacht eine leichte "
    "Gaensehaut.");
  AddDetail("gaensehaut",
    "Als der Wind Dir besonders kuehl ueber die Haut streicht spuerst Du "
    "wie ein Schauer deinen Ruecken runterlaeuft.");
  AddDetail("schauer",
    "Ein Schauer laeuft Dir den Ruecken hinunter als der Wind Dir ueber "
    "die haut streicht.");
  AddDetail("ruecken",#'ruecken);
  AddDetail("boden",
    "Ueber den felsigen Boden weht feiner Staub und Sand.");
  AddDetail("staub",
    "Staub gibt es hier en mass und er weht ueber den Boden.");
  AddDetail("sand",
    "Ein wenig Sand weht zusammen mit dem Staub ueber den Boden. Scheinbar "
    "gibt es irgendwo in der Naehe einen Strand.");
  AddDetail("naehe",
    "Alzuweit kann der Strand nicht entfernt sein, wenn hier schon Sand "
    "rumliegt.");
  AddDetail("strand",
    "Ganz in der Naehe befindet sich wohl ein Strand, zumindest ist das "
    "die einzige Erklaerung fuer den Sand hier.");
  AddDetail("erklaerung",
    "Du kannst Dir den Sand hier nur dadurch erklaeren, dass in der Naehe "
    "ein Strand ist.");
  AddDetail("himmel",
    "Der Nebel der in Kuestennaehe zu sehen war ist fast verschwunden, "
    "was aber nichts an der Tatsache aendert, dass der Himmel voller "
    "grauer Wolken ist, die kaum Sonne durchlassen.");
  AddDetail("nebel",
    "Nebel siehst Du hier kaum noch.");
  AddDetail(({"naehe","kuestennaehe"}),
    "In Kuestennaehe ist weitaus mehr Nebel zu sehen als hier.");
  AddDetail("tatsache",
    "Der Himmel ist tatsaechlich voller Wolken.");
  AddDetail("wolken",
    "Die grauen Wolken werden vom Wind rasch weggeweht, aber es kommen "
    "scheinbar endlos viele nach. Du fragst Dich ob es hier wohl jemals "
    "sonnig ist. Wahrscheinlich nicht.");
  AddDetail("insel",
    "Du befindest Dich hier auf Insel.");
  AddDetail("sonne",
    "Die Sonne kann kaum durch die dichten grauen Wolken dringen, so dass "
    "die ganze Gegend irgendwie bedrueckend wirkt.");
  AddDetail("gegend",
    "Die Gegend hier wirkt ziemlich bedrueckend.");
  AddDetail("wegweiser",
    "Der Wegweiser stand wohl vor einiger Zeit mal am Weg. Mitlerweile "
    "liegt er aber nur noch halb verottet am Boden. Du kannst ihn zwar "
    "noch lesen, aber viel nuetzen wird Dir das wohl kaum, da die "
    "Ausrichtung wohl hinueber ist.");
  AddReadDetail("wegweiser",
    "Du kannst gerade noch die drei Richtungen 'Faehre', 'Grab' und "
    "'Anlegeplatz' lesen, siehst aber keinen Hinweis darauf in welcher "
    "Richtung sich nun was befindet.");
  AddDetail("ausrichtung",
    "Wenn Du wuesstest wie der Wegweiser einmal ausgerichtet war, waerst "
    "schon um einiges schlauer, aber das wirst Du so schnell nicht "
    "herausfinden.");
  AddDetail("orte",
    "Es gibt viele Orte.");
  AddDetail("zeit",#'zeit);
  AddSmell(DEFAULT_SMELL,
    "Die Luft hier ist wirklich klar und kuehl.");
  AddSmell("luft",
    "Die Luft ist hier so klar wie an wenigen Orten.");
  AddSound(DEFAULT_SOUND,
    "Du vermagst nur ein leises Rauschen des Windes in den Sumpfgraesern "
    "zu vernehmen.");
  AddSound("rauschen",
    "Das Rauschen ist ziemlich leise.");
}