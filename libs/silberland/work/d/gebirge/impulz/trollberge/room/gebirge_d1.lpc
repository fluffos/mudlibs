// Trollberge, Gebirgskarte D1
// by Impulz@SL

inherit "std/room";
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include "../trolldefs.h"

string mahl()
{
  return BS("Hmm lecker.. Gebratene"+(TP->QueryProp(P_RACE)!="Fee"?"r " :" ")+
         capitalize(TP->QueryProp(P_RACE))+".");
}
create()
{
  ::create();
  SetProp(P_INT_SHORT,"Vor einem Abgrund");
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:15]));
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Du stehst vor einem kleinen Abgrund im Norden, wo es wohl so an "
    "die fuenf Meter runtergehen mag. Unten kannst Du einen Pfad erkennnen "
    "der nach Norden fuehrt. Weiter suedlich teilt sich der Pfad, auf dem Du "
    "dich gerade befindest.");
  AddDetail("abgrund",
    "Es ist eigentlich kein richtiger Abgrund, es geht ja auch nur fuenf "
    "Meter hinab. Wenn Du genug Mut besitzt koenntest Du dort runterspringen."
    );
  AddDetail("mut",
    "Mit genug Mut kannst Du hier runterspringen, auch wenn Dir eine andere "
    "Moeglichkeit lieber waere.");
  AddDetail("moeglichkeit",
    "Hmm.. vielleicht koennte man auch ohne das Risiko, sich das Genick zu "
    "brechen herunterkommen.");
  AddDetail("risiko",
    "Als weniger risikofreudiger Spieler kannst Du probieren hier hinab "
    "zu gleiten.");
  AddCmd(({"spring","springe"}),"springefkt");
  AddCmd(({"gleit","gleite"}),"gleitefkt");
  AddDetail("boden",
    "Du stehst auf steinhartem Fels.");
  AddDetail("fels",
    "Absolut unnachgiebig und sicherlich schmerzhaft wenn man stuerzt.");
  AddDetail("genick",
    "Irgendwie wuerdest Du schon ganz gerne noch ein wenig weiterleben.");
  AddDetail("himmel",
    "Der Himmel ist voll von grauen Wolken. Immerhin regnet es nicht.");
  AddDetail("wolken",
    "Na hoffentlich geraest Du nicht mitten in ein Gewitter, die Wolken "
    "sehen allerdings schon so aus.");
  AddDetail("gewitter",
    "Gerade in diesem Moment schlaegt ein Blitz einige Meter neben Dir ein. "
    "Du kannst wieder aufatmen.");
  AddDetail("blitz",
    "Wenn Dich einer braet freuen sich die Trolle sicher ueber ein Festmahl. "
    "Also sieh zu, dass das nicht geschieht.");
  AddDetail("festmahl",#'mahl);
  AddDetail("pfad",
    "Der Pfad fuehrt nach Norden. Mehr kannst Du von hier nicht erkennen.");
  AddDetail("trolle",
    "Die fressen fast alles.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst so gut wie gar nichts.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht ein wenig merkwuerdig, allerdings kannst Du den Geruch nicht "
    "identifizieren.");
  AddSmell("geruch",
    "Es riecht.. merkwuerdig.");
  AddExit("sueden",ROOM("gebirge_d2"));
}

int springefkt(string str)
{
  if (str!="runter") return 0;
  write(BS("Mutig springst Du hinunter und landest allerdings alles andere "
           "als sanft. Du gibst zu, dass es eine ziemlich bescheidene Idee "
           "war."));
  TP->AddHp(-20);
  TP->move(ROOM("huegel3"),M_NOCHECK,"",
           "springt todesmutig herunter","kommt herein gesprungen");
  return 1;
}

int gleitefkt(string str)
{
  if (str!="hinab") return 0;
  write(BS("Geschickt laesst Du Dich heruntergleiten."));
  TP->move(ROOM("huegel3"),M_NOCHECK,"",
           "laesst sich runtergleiten","kommt an");
  return 1;
}
  