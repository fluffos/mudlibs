// Tunneleingang, 3. Stockwerk, Rutsche nach c4
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include <moving.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einer Raum sehr tief unter der Erde");
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:17]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
    "Nach laengerem Hinabsteigen hast Du eine weitere Hoehle erreicht. "
    "Sie ist nicht bedeutend groesser als die anderen beiden Hoehlen, "
    "sieht aber anders aus. Dort wo sonst das Loch mit der Leiter im Boden "
    "war, ist jetzt ein schraeger runder Schacht, der tiefer in den Boden "
    "hineinfuehrt. Zwei Fackeln an den Waenden erhellen den Raum ein wenig. "
    "Die Leiter an der heruntergekommen bist, endet hier und der Schacht "
    "scheint die einzige Moeglichkeit zu sein weiter hinab zu kommen.");
  AddDetail("hoehle",
    "Es ist zwar etwas geraeumiger hier, als in der Hoehle ueber Dir, aber "
    "trotzdem nicht gerade der Platz, wo Du den Rest deines Lebens "
    "verbringen willst.");
  AddDetail("hoehlen",
    "Mit dieser Hoehle, sind es schon drei.");
  AddDetail("loch",
    "In der Decke ist das bekannte Loch mit der Leiter, an der Du wieder "
    "hinaufgelangen kannst.");
  AddDetail("leiter",
    "Die Leiter, die von oben hereinfuehrt endet hier endgueltig.");
  AddDetail("boden",
    "Im Boden ist ein Schacht der nach schraegunten fuehrt.");
  AddDetail("schacht",
    "Der Schacht erinnert Dich an eine Rutsche, nur dass sie aus Stein ist "
    "und Du deren Verlauf nicht kennst. Wenn Du willst, kannst Du natuerlich "
    "herunter rutschen.");
  AddDetail("decke",
    "In der Decke ist ein Loch mit einer Leiter, so wie in der Hoehle "
    "darueber.");
  AddDetail("fackeln",
    "Die Fackeln an den Waenden spenden ein wenig Licht.");
  AddDetail("leben",
    "Es gibt wahrhaft schoenere Plaetze um dort den Rest seines Lebens zu "
    "verbringen.");
  AddDetail("moeglichkeit",
    "Du musst wohl oder uebel da runter.");
  AddDetail("raum",
    "Du befindest Dich in einem.");
  AddDetail("rest",
    "Wer weiss wie lange dein Leben noch dauern wird.");
  AddDetail("rutsche",
    "Ui, das hat immer Spass gemacht..");
  AddDetail("stein",
    "Ziemlich kalt und hart, aber Du bist ja kein Weichei, oder ?");
  AddDetail("verlauf",
    "Die Rutsche fuehrt ins Ungewisse.");
  AddDetail("waende",
    "An den Waenden haengen zwei Fackeln und wie sollte es anders sein, ist "
    "in einer Wand etwas eingeritzt.");
  AddDetail("wand",
    "Dort steht: 'Das ist nicht tot, das ewig liegt, bis dass der Tod die "
    "Zeit besiegt.'");
  AddDetail("licht",
    "Ein wenig Licht gibt es durch die Fackeln.");
  AddDetail("hinabsteigen",
    "Aechtz, keuch, stoehn, seufz...");
  AddDetail("plaetze",
    "Dir fiele das schon was ein, aber es gibt jetzt wichtigere Dinge zu "
    "tun.");
  AddDetail("platz",
    "Ungemuetlicher Platz hier.");
  AddDetail("spass",
    "Da kommt das Kind in Dir ans Licht.");
  AddDetail("tod",
    "Der erwartet Dich auch noch.");
  AddDetail("ungewisse",
    "Wer weiss, was Dich dort erwartet.");
  AddDetail("weichei",
    "Sowas siehst Du hier nicht. Oder doch ? *in den Spiegel guck*");
  AddDetail("kind",
    "Du warst auch mal eins.");
  AddDetail("dinge",
    "Du koenntest zum Beispiel probieren, ob Du es endlich schaffst, den "
    "Fraggle zu toeten.");
  AddDetail("fraggle",
    "Geruechten zufolge ist der Fraggle eins der hinterlistigsten Wesen im "
    "Silberland.");
  AddDetail("silberland",
    "Du weisst doch wohl was das ist.");
  AddDetail("wesen",
    "Es gibt tausende Wesen.");
  AddDetail("beispiel",
    "Uninteressant.");
  AddDetail("zeit",
    "Oh je, wie die Zeit vergeht.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht etwas abgestanden.");
  AddCmd(({"rutsch","rutsche"}),"rutschefkt");
  AddExit("oben",ROOM("tunnel_c3_2"));
} 

int rutschefkt(string str)
{ object ob;
  if (!str) return 0;
  write("Du setzt Dich an den Rand des Schachtes und stoesst Dich ab.\n");
  ob=clone_object("/players/impulz/obj/sequenzer");
  ob->move(TP,M_NOCHECK|M_SILENT);
  ob->start("/d/gebirge/impulz/trollberge/obj/rutsche.seq");
  return 1;
}