/*
 * Inherit-File fuer den Pfad der zu den Trollbergen rauffuehrt
 * by Impulz@SL
 */

inherit "std/room";

#include <properties.h>
#include <moredef.h>
#include "../trolldefs.h"


string zirpfkt()
{
  string retstring;

  retstring="Du solltest wissen, ";
  if (TP->id("menschenspieler"))
    retstring="Als halbwegs kluger Mensch solltest Du wissen, ";
  if (TP->id("trollspieler"))
    retstring="Naja, als Troll weisst Du vielleicht nicht, ";
  if (TP->id("zwergenspieler"))
    retstring="Auch Zwerge wie Du sollten wissen, ";
  if (TP->id("elfenspieler"))
    retstring="Als intelligenter Elf muesstest Du wissen, ";
  if (TP->id("dunkelelfenspieler"))
    retstring="Als Dunkelelf muesstest Du wissen, ";
  if (TP->id("feenspieler"))
    retstring="Kluge Feen muessten wissen, ";
  if (TP->id("ogerspieler"))
    retstring="Sogar als Oger solltest Du wissen, ";
  if (TP->id("hobbitspieler"))
    retstring="Du wirst als Hobbit sicher einsehen, ";

  return break_string(retstring+"dass man das Zirpen nur hoeren kann.");
}


create()
{
  ::create();
  SetProp(P_INT_SHORT,"Auf einem steilen Pfad");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,
    ([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:14]));
  SetProp(P_INT_LONG,
    "Du laeufst einen steil nach oben fuehrenden Pfad entlang. "
    "Ab und zu ertoent das Kreischen eines Raubvogels oder das Zirpen "
    "einiger versteckter Grillen. Ein Gefuehl der Einsamkeit ueberkommt "
    "Dich, wenn Du um Dich schaust. Abgesehen von endlos vielen Felsen "
    "und einigen trockenen Bueschen siehst Du ");  // Ergaenzung in den 
                                                   // speziellen Raeumen
  AddDetail("pfad",
    "Der Pfad fuehrt von der Kueste aus hinauf ins Gebirge.");
  AddDetail("kueste",
    "Die Kueste ist noch ein Stueck entfernt, aber wenn Du genau hinschaust "
    "kannst Du das Meer erkennen.");
  AddDetail("gebirge",
    "Je hoeher Du steigst desto weiter kommst Du ins Gebirge. Was Dich dort "
    "wohl erwarten mag ?");
  AddDetail("stueck",
    "Die Kueste ist zwar nicht unerreichbar weit weg, aber wenn Du deine "
    "Fuesse im Wasser abkuehlen willst, musst Du noch ein wenig weiter "
    "bergab gehen.");
  AddDetail("meer",
    "Weiter im Norden siehst Du das Meer und die Wellen, die am Strand "
    "auslaufen.");
  AddDetail("fuesse",
    "Deine Fuesse schmerzen vom vielen Gehen und koennten etwas Abkuehlung "
    "gebrauchen. Ausserdem verbreiten sie einen ziemlich ekeligen Gestank.");
  AddDetail(({"wasser","meerwasser"}),
    "Das Meerwasser kuehlt sicher gut.");
  AddDetail("gehen",
    "Du bist in den letzten Tagen sicher schon meilenweit gelaufen.");
  AddDetail(({"tage","zeit"}),
    "Jaja, wie die Zeit vergeht.");
  AddDetail("abkuehlung",
    "Ach wie gern wuerdest Du deine Fuesse im kuehlen Meerwasser baden.");
  AddDetail("gestank",
    "Dir wird fast uebel.");
  AddDetail("kreischen",
    "Das Kreischen kannst Du schlecht sehen.");
  AddDetail("raubvogel",
    "Ab und zu fliegt ein Raubvogel hoch ueber deinem Kopf hinweg.");
  AddDetail("zirpen",#'zirpfkt);
  AddDetail("grillen",
    "Du kannst die Grillen nirgends entdecken. Nur ihr Zirpen verschafft Dir "
    "Gewissheit darueber, dass hier welche sind.");
  AddDetail("gewissheit",
    "Man kann sich leider nur weniger Dinge gewiss sein.");
  AddDetail("dinge",
    "Es gibt so viele Dinge bei denen man sich nie sicher sein kann.");
  AddDetail("gefuehl",
    "Du bemerkst, dass Du hier wahrscheinlich ziemlich allein bist.");
  AddDetail("einsamkeit",
    "Einsamkeit ist zwar manchmal ganz angenehm, hier wirkt sie aber eher "
    "bedrueckend.");
  AddDetail("felsen",
    "Wohin Du auch schaust siehst Du Felsen.");
  AddDetail(({"buesche","busch"}),
    "Ab und zu steht mal ein kahler, vertrockneter Busch in der Landschaft.");
  AddDetail("landschaft",
    "Die Landschaft ist mit ihren paar Bueschen und Felsen alles andere als "
    "aufregend.");
  AddDetail("kopf",
    "Hoch ueber deinem Kopf fliegt ab und zu ein Raubvogel vorbei.");
  AddDetail("strand",
    "Bis zum Strand musst Du noch ein ganzes Stueck gehen.");
  AddDetail("wellen",
    "Die Wellen laufen am Strand aus.");
  AddDetail("boden",
    "Der Boden ist von kleinen Steinen uebersaet.");
  AddDetail(({"steine","steinchen"}),
    "Tausende kleiner Steinchen liegen am Boden.");
  AddDetail("tausende",
    "Wenn nicht gar Millionen davon.");
  AddDetail("millionen",
    "Millionen ist vielleicht doch etwas uebertrieben.");
  AddDetail("himmel",
    "Der Himmel ist fast wolkenfrei, nur ein paar kleine Woelkchen "
    "lassen sich vom Wind treiben.");
  AddDetail("woelkchen",
    "Es sind nur ganz wenige.");
  AddDetail("wind",
    "Der Wind treibt die Woelkchen am Himmel entlang.");
}