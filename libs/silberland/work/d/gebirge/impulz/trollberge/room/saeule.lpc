/* Ein kleiner Raum um eine meiner Ideen festzuhalten.
 * by Impulz
 */

inherit "std/room";
#include <properties.h>
#include <ansi.h>

string umgestossen="";

string steindesc()
{
  if (umgestossen=="")
    return break_string(
     "Scheinbar hat jemand die Steine so aufeinander gestapelt, dass sie "
     "eine relativ hohe Saeule bilden.");
  return break_string(
     "Die Steine liegen am Boden herum, es sieht allerdings so aus als ob "
     "sie vor kurzer Zeit mal eine Saeule dargestellt haben.");
}

string saeulendesc()
{
  if (umgestossen=="")
    return break_string(
     "Die Saeule sieht ziemlich stabil aus und Du koenntest Dich daran "
     "anlehnen.");
  return break_string(
     "Tja, die Steine waren wohl mal eine Saeule, aber irgendetwas sagt Dir,"+
     " dass "+ANSI_BOLD+umgestossen+ANSI_NORMAL+
     " daran Schuld ist, dass sie umgekippt sind. Schade...");
}

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein kleiner huebscher Testraum");
  SetProp(P_INT_LONG,
     "Da der Raum hier laengst nicht fertig ist und nur dazu erstellt wurde "
     "etwas zu testen, siehst Du hier nichts ausser ein paar Steinen.");
  AddDetail("raum",QueryProp(P_INT_LONG));
  AddDetail("steine",#'steindesc);
  AddDetail("saeule",#'saeulendesc);
  AddCmd("lehne","lehnefkt");
  AddCmd("lehn","lehnefkt");
}

int lehnefkt(string str)
{ notify_fail("Als Geist kannst Du sowas nicht.\n");
  if (this_player()->QueryProp(P_GHOST)) return 0;
  notify_fail("Als Frosch kannst Du sowas nicht.\n");
  if (this_player()->QueryProp(P_FROG)) return 0;
  notify_fail("An was willst Du Dich anlehnen ?\n");
  if ((!member(({"an saeule","an saeule an","saeule"}),lower_case(str)))
      || (umgestossen!=""))
    return 0;
  if ((this_player()->QueryProp(P_INVIS)) || (random(5)))
    {
     write("Du lehnst Dich an die Saeule und kommst Dir echt cool vor.\n");
     say(this_player()->name()+" lehnt sich cool an die Saeule.\n");
     return 1;
    }
  umgestossen=capitalize(getuid(this_player()));
  write(break_string(
        "Du lehnst Dich an die Saeule und willst gerade die Augen schliessen "
        "als Du merkst, dass die Saeule nachgibt."));
  write("Schnell stellst Du Dich wieder hin, aber es ist zu spaet.\n");
  write(break_string(
        "Mit lautem Rumpeln kippt die Saeule um und die Steine liegen nun "
        "alle auf dem Boden. Hoffentlich hat Dich keiner gesehn."));
  say(break_string(
      this_player()->name()+" lehnt sich gegen eine Saeule, worauf diese "
      "mit lautem Gerumpel umkippt. Knallrot schaut er sich verlegen um."));
  return 1;
}

reset()
{  ::reset();
   if (!random(10)) umgestossen="";   // Mit 10%iger Wahrscheinlichkeit beim
                                      // Raumreset wieder aufrichten.
}  
