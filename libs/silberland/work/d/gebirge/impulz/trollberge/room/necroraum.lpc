// Dunkler Raum, wo das Necronomicon aufbewahrt wird
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include <moving.h>

string sockelfkt()
{
  if (present("\necrobuch"))
   return BS("Der Sockel ist fast weiss und steht so in starkem Kontrast zum "
    "Rest des Raumes. Auf dem Sockel liegt ein Buch.");
  else
   return BS("Der Sockel ist fast weiss und steht so in starkem Kontrast zum "
    "Rest des Raumes. Der Sockel ist leer.");
}


create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einem duesteren Raum");
  SetProp(P_INT_LONG,
    "Du stehst inmitten eines ziemlich duesteren Raums. "
    "Selbst die Waende scheinen tiefschwarz zu sein. In der Mitte "
    "steht, von einigen Kerzenstaendern umrundet und beleuchtet ein "
    "Sockel.");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:10]));

  AddDetail("raum",
    "Waeren die Kerzenstaender nicht da, waere es stockfinster.");
  AddDetail("waende",
    "Die Waende sind tatsaechlich tiefschwarz und kuehl.");
  AddDetail("mitte",
    "In der Mitte des Raumes steht ein Sockel.");
  AddDetail(({"staender","kerzenstaender"}),
    "Insgesamt sind es sechs Kerzenstaender, die den Sockel umringen "
    "und ein wenig Licht spenden.");
  AddDetail("sockel",#'sockelfkt);
  AddDetail("kontrast",
    "Der Kontrast koennte kaum staerker sein.");
  AddDetail("rest",
    "Bis auf den Sockel ist alles in schwarz gehalten.");
  AddDetail("buch",
    "Du musst das Buch schon nehmen bevor Du genaueres erkennen kannst.");
  AddDetail("licht",
    "Das einzige Licht kommt von den Kerzenstaendern. Allerdings hat das "
    "Licht keinen 'natuerlichen' Ursprung, da egal was Du machst, es immer "
    "gleich hell bleibt.");
  AddDetail("ursprung",
    "Unglaublich grosse Macht muss diesen Raum erschaffen haben.");
  AddDetail("macht",
    "Du erzitterst.");
  AddItem("/players/impulz/buch/testbuch",REFRESH_DESTRUCT);
  AddSpecialExit("raus","ausgangsfkt");
  AddDetail("wand","Alle Waende sehen gleich schwarz aus.");
  AddDetail("boden",
    "Selbst der Boden ist schwarz.");
  AddDetail("decke",
    "Wie alles andere ist auch die Decke tiefschwarz.");
}

int ausgangsfkt()
{
  if (deep_present("\necrobuch",TP))
   tell_object(TP,BS(
    "Magische Kraefte halten Dich davon ab, das Necronomicon von diesem "
    "Ort zu entfernen."));
  else
   TP->move("/gilden/abenteurer",M_GO,"","kommt ehrfuerchtig herein",
            "verlaesst diesen Ort");
  return 1;
}

int _query_total_light()
{
  return QueryProp(P_LIGHT);
}

int _query_light()
{
  return 1;
}