// Beginn des Tunnels
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include <moving.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einer Sackgasse");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_INT_LONG,
    "Enttaeuscht stellt Du fest, dass Du hier scheinbar nicht weiterkommst. "
    "Du stehst auf einem Felsvorsprung und nach Westen, Sueden und Osten "
    "geht es nur unendlich weit runter, so dass Du den Boden kaum noch "
    "erkennen kannst. Ein kleines schon ziemlich heruntergekommenes "
    "Holzkreuz steht unauffaellig herum.");
  AddDetail(({"vorsprung","felsvorsprung"}),
    "In drei Himmelsrichtungen geht es steil bergab, kein besonders "
    "ermutigender Anblick.");
  AddDetail("anblick",
    "Es gibt ganz gewiss bessere Wege um vorzeitig abzutreten.");
  AddDetail("wege",
    "Dir fielen da schon einige ein.");
  AddDetail("boden",
    "Der Boden unter deinen Fuessen besteht aus Fels, was dort unten "
    "ist, kannst Du von hier ziemlich schlecht beurteilen, was aber kein "
    "Grund fuer Dich sein sollte, nachzusehen.");
  AddDetail("himmel",
    "Grau und langweilig. Mehr gibts dazu nicht zu sagen.");
  AddDetail("fuesse",
    "Die stinken ja zum Himmel. Igitt..");
  AddDetail("fels",
    "Hart, grau und kalt, wie Fels nunmal so ist.");
  AddDetail("grund",
    "Hey, Vorsicht! Da gehts runter, da gehts ziemlich steil runter.");
  AddDetail("vorsicht",
    "Pass bloss auf.");
  AddDetail(({"richtungen","himmelsrichtungen"}),
    "In drei der vier Himmelsrichtungen geht es steil runter.");
  AddDetail(({"kreuz","holzkreuz"}),
    "Das Holzkreuz ist schon ziemlich verwittert und sieht nicht mehr so "
    "toll aus. Erst jetzt bemerkst Du ein kleines verrostetes "
    "Schild an dem Kreuz. Das Kreuz steckt auch nicht besonders feste im "
    "Boden, so als ob jemand mutwillig daran rumgeruettelt haette. 'Bloede "
    "Randalierer' denkst Du Dir.");
  AddCmd(({"ruettel","ruettle"}),"tunnelfkt");
  AddDetail("schild",
    "Die Buchstaben auf dem Schild nur noch schwer zu entziffern, aber "
    "scheinbar soll das Kreuz an jemanden erinnern, der hier herunter "
    "gestuerzt ist.");
  AddDetail("buchstaben",
    "Sie sind teilweise von Moos ueberwachsen oder verwischt.");
  AddDetail("moos",
    "Das Kreuz muss hier schon wirklich lange stehen.");
  AddDetail("randalierer",
    "Das grenzt schon an Grabschaendung.");
  AddDetail("grabschaendung",
    "Sowas wuerdest Du nichtmal tun, wenn Du wuesstest, dass sich darunter "
    "ein Schatz befaende. Naja, Du bist Dir fast sicher, dass Du es nicht "
    "tun wuerdest. Vielleicht ein klitzekleines bischen, aber nicht viel. "
    "Zumindest wuerdest Du es nacher wieder herrichten, versuchst Du Dir "
    "einzureden. Ach scheiss drauf. :)");
  AddDetail("schatz",
    "Ob hier wohl ein Schatz liegt? 'Quatsch', denkst Du Dir, wie soll man "
    "den denn hier vergraben haben. Andererseits, so ein bischen ruetteln "
    "kann ja eigentlich nicht schaden.");
  AddSound("Du hoerst nur den Wind gegen Felswand peitschen.");
  AddSmell("Du kannst nichts auffaelligen riechen.");
  AddExit("norden",ROOM("gebirge_d2"));
}

int tunnelfkt(string str)
{
  notify_fail("Ruettle an was ?\n");
  if (!str) return 0;
  if (member_array(lower_case(str),({"kreuz","an kreuz"}))==-1) return 0;
  write(BS("Du ruettelst vorsichtig an dem Holzkreuz und passt auf, dass "
           "Dich keiner sieht."));
  write(BS("Ploetzlich verlierst Du den Halt unter den Fuessen und merkst "
           "gar nicht wie Dir geschaht als Du nach einigen Sekunden freien "
           "Falls auf einem mit Stroh bedecktem Boden aufschlaegst."));
  TP->move(ROOM("tunnel_c3_1"),M_NOCHECK,"",
       "ist ploetzlich wie vom Boden verschluckt","plumpst herein");
  return 1;
}