// blaa... by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include <moving.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Vor einer Felswand");
  SetProp(P_INT_LONG,
    "Der Pfad, den Du bisher tapfer hochgestiegen bist, endet hier abrupt "
    "vor einer rund fuenf Meter hohen Felswand, die sich noch weit bis "
    "Osten und Westen erstreckt. Wenn Du hier weiter nach Sueden willst, "
    "bleibt Dir wohl nicht viel anderes uebrig, als irgendwie dort hoch "
    "zu gelangen.");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:15]));
  AddDetail("pfad",
    "Der Pfad endet hier abrupt vor einer Felswand. Dir bleibt wohl nichts "
    "erspart.");
  AddDetail("meter",
    "Die Felswand ist sicherlich so an die fuenf Meter hoch.");
  AddDetail(({"wand","felswand"}),
    "Die Felswand besteht aus rohem Fels und hat leider weder Vorspruenge "
    "noch Spalten. Es gibt auch keine Erhebungen, die Du ertasten koenntest "
    "und eine optische Taeuschung, durch die Du einfach hindurchgehen "
    "kannst, ist das mit Sicherheit auch nicht. Du bist Dir fast gewiss, "
    "dass die Antwort ganz einfach ist, nur kommst Du nicht drauf. Langsam "
    "faengst Du allerdings doch an daran zu zweifeln, dass die Wand fuer "
    "viel mehr nuetzlich ist, als sich daran anzulehnen oder um als Zwerg "
    "von oben Selbstmord zu begehen.");
  AddCmd("lehne","lehnefkt");
  AddDetail("antwort",
    "Wenn Du sie doch bloss wuesstest.");
  AddDetail("boden",
    "Der Boden zeigt keine auffaelligen Merkmale und besteht auch Erde und "
    "ein paar Grasbuescheln.");
  AddDetail(({"erhebungen","spalten","taeuschung","vorspruenge"}),
    "Nix da. :(");
  AddDetail("erde",
    "Die Erde ist festgetreten und steinhart.");
  AddDetail("fels",
    "Harter, roher, kalter Fels.");
  AddDetail(({"bueschel","grasbueschel"}),
    "Nur ein paar schon fast vertrocknete Grasbueschel sind am Boden zu "
    "sehen.");
  AddDetail("himmel",
    "Der Himmel ist wolkenbedeckt.");
  AddDetail("wolken",
    "Viele graue Wolken.");
  AddDetail("merkmale",
    "Nichts besonderes zu sehn.");
  AddDetail(({"selbstmord","loesung"}),
    "Selbstmord ist keine Loesung... oder so.");
  AddDetail("sicherheit",
    "Du bist dessen ziemlich sicher.");
  AddDetail("zwerg",
    "Kleine Lebewesen, die vorwiegend in Bergwerken leben und nichts mehr "
    "als Elfen hassen.");
  AddDetail("elfen",
    "Grosse, duenne Gestalten, die in den Baeumen leben.");
  AddDetail(({"baeume","rest","lebewesen","gestalten","bergwerke"}),
    "Lies Dir den Rest irgendwo anders durch.");
  AddExit("nordunten",ROOM("huegel2"));
  AddExit("norden",ROOM("huegel2"));
  SetProp(P_HIDE_EXITS,({"norden"}));

}

int lehnefkt(string str)
{
  notify_fail("Lehne wo an ?\n");
  if (!str) return 0;
  write(BS("Du lehnst Dich erschoepft und deprimiert an die Felswand "
           "an, als ploetzlich der Boden unter Dir zu vibrieren beginnt. "
           "Noch bevor Du erschrocken wegspringen kannst, wirst Du etliche "
           "Meter hochgeschleudert und weisst nicht mehr, was mit Dir "
           "geschieht. Als Du endlich ziemlich unsanft auf dem Boden "
           "aufschlaegst, merkst Du, dass Du Dich oben auf der Felswand "
           "befindest."));
 TP->move(ROOM("gebirge_d1"),
        M_NOCHECK,"","wird weggeschleudert","fliegt herein");
  return 1;
}
  