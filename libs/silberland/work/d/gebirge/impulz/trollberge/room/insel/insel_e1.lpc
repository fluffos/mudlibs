// Insel Raum E1 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("nordosten","./insel_d2");
  SetProp(P_INT_SHORT,"An einem Strand");
  SetProp(P_INT_LONG,
    "Vor Dir erstreckt sich das Meer, wenn auch nicht gerade weit. "
    "Denn Du kannst gerade noch die Umrisse eines Gebirges auf der "
    "gegenueber liegenden Seite sehen. Wie gerne wuerdest Du wissen "
    "was sich dort befindet. Eine kaputte Faehre liegt am Strand und "
    "ein alter, ziemlich traurig aussehender Mann sitzt daneben.");
  AddDetail("meer",
    "Das kleine Stueckchen Meer hier trennt scheinbar die Insel vom "
    "Festland ab.");
  AddDetail("stueckchen",
    "Bis zum Festland sind es gerade mal wenige Kilometer.");
  AddDetail("umrisse",
    "Der Nebel ueber dem Meer verhindert, dass Du Feinheiten entdecken "
    "kannst.");
  AddDetail("gebirge",
    "Das Festland besteht hier scheinbar nur aus hohen und schwer "
    "ueberwindbaren Bergen.");
  AddDetail("seite",
    "Vielleicht kann Dir der Faehrmann helfen dort hinueber zu kommen.");
  AddDetail("faehre",
    "Die Faehre hat an ihrer Backbordseite ein Loch und kann so "
    "unmoeglich schwimmen.");
  AddDetail(({"strand","sandstrand"}),
    "Der Sandstrand erstreckt sich noch etliche hundert Meter nach links "
    "und rechts.");
  AddDetail(({"mann","faehrmann"}),
    "Der alte Faehrmann sieht sehr sehr traurig aus und stuetzt den Kopf "
    "auf seine Haende.");
  AddDetail("backbordseite",
    "Auf der Backbordseite der Faehre ist ein Loch in den Rumpf gerissen "
    "worden. Ob das der Grund dafuer ist, dass der Faehrmann so traurig "
    "ist ?");
  AddDetail("berge",
    "Genaueres wirst Du erst erkennen koennen, wenn Du auf der anderen "
    "Seite bist.");
  AddDetail(({"boden","sand"}),
    "Der Boden besteht teilweise aus feuchtem Sand und weiter vorne aus "
    "trockenem.");
  AddDetail("feinheiten",
    "Die kannst Du von hier aus hoechtens erraten.");
  AddDetail("festland",
    "Auf der anderen Seite der Meerenge ist das Festland zu sehen.");
  AddDetail("haende",
    "Der alte Mann stuetzt seinen Kopf auf seine Haende.");
  AddDetail("himmel",
    "Der Himmel is voll von grauen, dichten Wolken.");
  AddDetail("insel",
    "Du stehst drauf.");
  AddDetail(({"kilometer","meter"}),
    "Eine Einheit.");
  AddDetail("einheit",
    "Ein Kilometer ist eine Einheit.");
  AddDetail("kopf",
    "Der Mann stuetzt seinen Kopf geistesabwesend auf seine Haende. Wie "
    "lange er hier wohl schon sitzt ?");
  AddDetail("loch",
    "Das Loch im Rumpf der Faehre ist zu gross, als dass man es eben so "
    "reparieren koennte.");
  AddDetail("nebel",
    "Ueber dem Meer schwebt Nebel und versperrt Dir die Sicht.");
  AddDetail("sicht",
    "Aufgrund des Nebels kannst Du hier nicht sonderlich weit sehen.");
  AddDetail("grund",
    "Den Grund wirst Du wohl nur erfahren, wenn Du ihn danach fragst.");
  AddDetail(({"meerenge","enge"}),
    "Das Meer ist hier nur noch wenige Kilometer breit.");
  AddDetail("rumpf",
    "Im Rumpf der Faehre befindet sich ein ziemlich grosses Leck.");
  AddDetail("leck",
    "Das Leck ist wirklich uebel. Bevor das nicht repariert ist, wird "
    "die Faehre wohl nicht wieder fahren koennen.");
  AddDetail("wolken",
    "Die dichten Wolken verdunkeln den Himmel und die Umgebung.");
  AddDetail("umgebung",
    "Die Umgebung sieht irgendwie ungemuetlich aus.");
  AddSmell(DEFAULT_SMELL,
    "Der salzige Meeresgeruch liegt hier besonders intensiv in der Luft.");
  AddSmell(({"geruch","meeresgeruch"}),
    "Das Meer riecht so erfrischend, dass Du tief durchatmest.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nur das Rauschen der Wellen und das leise Schluchtzen des "
    "alten Mannes.");
  AddSound(({"wellen","rauschen"}),
    "Die Wellen rauschen ziemlich eintoenig.");
  AddSound("schluchtzen",
    "Du bekommst richtig Mitleid mit dem armen Mann.");
  AddItem(NPC("mann"),REFRESH_DESTRUCT);
  AddItem(OBJ("wrack"),REFRESH_DESTRUCT);
  

}