// PartyHaus
// by Impulz@SL

inherit "std/pub";
#include <rooms.h>
#include <properties.h>
#include <moredef.h>
#include <pub.h>
#include <moving.h>
#include "../trolldefs.h"
string zmenue();

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In einem Haus");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_LIGHT,1);
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_NAME,"Thea");
  SetProp(P_PUBKEEPER_ID,"\nthea");
  SetProp(P_PUBKEEPER_GENDER,FEMALE);
  SetProp(P_ENEMYLIST,({}));
  SetProp(P_INT_LONG,
    "Du stehst nun inmitten der Party und bist von besoffenen, lallenden, "
    "ueber dein Aussehen komische Bemerkungen machende, bekifften, "
    "wankenden, schunkelnden, singenden, tanzenden, sich raufenden, "
    "kuessenden, taumelnden, sitzenden, liegenden, halbtoten, kotzenden, "
    "geistig weggetretenen, laut bruellenden, sich unterhaltenden, schlecht "
    "gelaunten, rauchenden und sogar ein oder zwei fast nuechternen Leuten "
    "umgeben. Der laengsgezogene Haufen von sich gegenseitig wegdraengenden "
    "Personen scheint eine Theke zu verbergen, an der es Getraenke gibt. "
    "Mit 'menue' bekommst Du eine Liste der Getraenke die Du kaufen kannst.");
  AddDetail("party",
    "Die Party ist in vollem Gange und Du verstehst bei all dem Laerm dein "
    "eigenes Wort nicht mehr.");
  AddDetail(({"gang","gange"}),
    "Die Party ist in vollem Gange.");
  AddDetail("laerm",
    "Am schlimmsten is sicherlich die laute Musik.");
  AddDetail("musik",
    "Du kennst das Lied nicht und bist ueberzeugt, dass sich das auch nicht "
    "aendern muss.");
  AddDetail("lied",
    "Nicht so ganz dein Geschmack.");
  AddDetail("aussehen",
    "Du weisst zwar nicht was die Leute an Dir so komisch finden, aber es "
    "muss schon wahnsinnig komisch sein, um die Reaktionen der Leute zu "
    "erklaeren.");
  AddDetail("bemerkungen",
    "Das uebliche halt, wie 'Guck mal der da.' oder 'Wie sieht der denn aus.'"
    " Du beschliesst es einfach zu ignorieren, schliesslich sind das nur "
    "nur alte Saeufer.");
  AddDetail("leute",
    "Die Leute scheinen hier schon etwas laenger zu feiern, so wie sie "
    "sich auffuehren und aussehen.");
  AddDetail("haufen",
    "Hinter dem Haufen scheint die Theke zu sein. Zum Glueck haengt an der "
    "Wand eine Liste mit Getraenken die Du einfach lesen kannst, indem Du "
    "'menue' eingibst.");
  AddDetail("personen",
    "Leute gibts, die gibts nicht.");
  AddDetail("blut",
    "Zufrieden ?");
  AddDetail("theke",
    "Bei genauerem Hinsehen kannst Du die Barkeeperin umhereilen sehen.");
  AddDetail("barkeeperin",
    "Die Barkeeperin heisst Thea, wie Du an einem Schild ueber der Theke "
    "erkennen kannst.");
  AddDetail("schild",
    "Auf dem Schild steht =(Thea's Tanke)=.");
  AddDetail("tanke",
    "So nennt Thea scheinbar ihre Theke.");
  AddDetail("boden",
    "Der Boden ist uebersaet mit leeren Bierdosen, Zigarettenstummeln, "
    "und verschuettetem Bier.");
  AddDetail("decke",
    "An der Decke haengt ein alter Kronleuchter.");
  AddDetail(({"geschmack","musikgeschmack"}),
    "Deinen Musikgeschmack trifft die Musik hier nicht gerade.");
  AddDetail("bier",
    "Der Boden ist mit einer duennen Bierschicht ueberzogen und "
    "es beginnt hier langsam etwas rutschig zu werden.");
  AddDetail(({"bierdosen","dosen"}),
    "Etliche Bierdosen, meistens Opfer einer versuchten Kraftdemonstration "
    "und darum leicht verbeult, liegen am Boden herum.");
  AddDetail(({"schicht","bierschicht"}),
    "Hoffentlich faellst Du nicht hin.");
  AddDetail("getraenke",
    "An der Wand haengt eine Liste mit Getraenken, die Du mit 'menue' lesen "
    "kannst.");
  AddDetail("glueck",
    "Erleichtert atmest Du auf. Du musst Dich doch nicht bis vorne "
    "durchschlagen, um zu sehen was man bestellen kann.");
  AddDetail("hinsehen",
    "Man sollte immer genau hinsehen.");
  AddDetail(({"demonstration","kraftdemonstration"}),
    "Die meisten Bierdosen sind eingebeult.");
  AddDetail(({"leuchter","kronleuchter"}),
    "Der Kronleuchter haengt hoch genug, um zu verhindern, dass besoffene "
    "Leute ihn beschaedigen.");
  AddDetail("liste",
    "Dort sind Getraenke aufgefuehrt.");
  AddReadDetail("liste",
    "Gib einfach 'menue' ein.");
  AddDetail("opfer",
    "Die armen Bierdosen...");
  AddDetail("reaktionen",
    "Staendig zeigen irgendwelche Finger auf Dich und es wird getuschelt.");
  AddDetail("finger",
    "Du hast auch zehn davon.");
  AddDetail("saeufer",
    "Die werden morgen wohl einen richtig schoenen Kater haben.");
  AddDetail("kater",
    "Du moechtest sicherlich nicht mit denen tauschen.");
  AddDetail("waende",
    "Vier Waende gibts hier, an einer haengt sogar eine Liste.");
  AddDetail("wand",
    "An einer Wand haengt eine Liste mit Getraenken.");
  AddDetail("wort",
    "Was hast Du gesagt ?");
  AddDetail(({"stummel","zigarettenstummel"}),
    "Ueberall liegen Zigarettenstummel rum. Du moechtest hier sicherlich "
    "nicht aufraeumen muessen.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Alkohol.");
  AddSmell("alkohol",
    "Nach *viel* Alkohol.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst laute Musik, groehlende Leute und Ruelpsen.");
  AddSound("musik",
    "Boah, ist die laut man.");
  AddSound("leute",
    "Wenn Du es nicht besser wuesstest, wuerdest Du sagen, dass hier das "
    "Jahrestreffen der Zechpreller stattfindet.");
  AddSound("ruelpsen",
    "Wie ekelig.");
  AddDetail("zechpreller",
    "Naja, Zechpreller wuerden wahrscheinlich mehr Alkohol vertragen.");
  AddDetail("jahrestreffen",
    "Da wird es sicherlich genauso zugehen.");
  AddExit("raus","./strand");
  
  AddDrink("Ein Glas Loca",({"loca","glas loca"}),50,({10,10,2}),0,5,
           ({"Thea gibt Dir ein Glas Loca, das Du rasch austrinkst.\n"+
             "Als die anderen Gaeste das sehen beginnen sie zu kichern.\n",
             "&& bekommt ein Glas Loca. Die anderen Gaeste beginnen zu "
             "kichern.\n"}));
  AddDrink("Ein Paberdorner Pils",({"pils","paberdorner","paberdorner pils"}),
           150,({30,25,0}),7,4,
           ({"Du bekommst ein frisch gezapftest Paberdorner Pils."+
             "Das erfrischt.",
             "&& bekommt ein frisches Paberdorner Pils und trinkt es rasch "+
             "aus"}));
  AddDrink("Thea's Special",({"special","theas special"}),250,({45,45,5}),13,
           9,({BS("Begierig stuerzt Du Dich auf das bunte Getraenk. Eine Ruck"
               " geht durch deinen Koerper und Du fuehlst Dich deutlich "
               "besser.")+"Du singst: Das ist THEA, hier tanken wir auf.\n",
             ("&& stuerzt sich begierig auf Thea's Special und beginnt zu "
             "singen: Das ist THEA, hier tanken wir auf.\n")}));
  AddDrink("Ein Glas Kroxasu",({"kroxasu","glas kroxasu"}),200,25,20,2,
           ({"Du bekommst ein Glas Kroxasu, was auch immer das sein mag.\n",
             "&& kauft ein Glas Kroxasu, ohne zu wissen was das ist. Mutig.\n"
           }));
  AddItem(NPC("thea"),REFRESH_DESTRUCT);           
  RemoveItem("/obj/topliste");
  AddItem(NPC("tuersteher"),REFRESH_DESTRUCT);
}


init()
{
  ::init();
  if (member(QueryProp(P_ENEMYLIST),TP)!=-1)
    {
     tell_object(TP,
       "Der Tuersteher sagt: 'Du bist hier nicht mehr erwuenscht.'\n");
     tell_object(TP,
       "Du fliegst in hohem Bogen wieder raus.\n");
     
     TP->move(ROOM("strand"),M_NOCHECK | M_SILENT | M_NO_SHOW,"",
                    "fliegt in hohem Bogen hinaus.",
                    "kommt in hohem Bogen angeflogen.");
    }
}

reset()
{
  SetProp(P_ENEMYLIST,({}));
  ::reset();
}
