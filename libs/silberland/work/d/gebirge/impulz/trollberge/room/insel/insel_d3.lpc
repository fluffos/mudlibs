// Insel Raum D3 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("nordwesten","./insel_c2");
  AddExit("westen","./insel_d2");
  SetProp(P_INT_LONG,
    "Der Weg wird immer sandiger je weiter Du nach Sueden gehst. "
    "Im Nordwesten erkennst Du eine Weggabelung waehrend Du im "
    "Suedwesten die ersten Anzeichen eines Strandes ausmachen "
    "kannst. Der Wind blaest zwar immernoch relativ stark, is aber laengst "
    "nicht mehr so intensiv wie weiter noerdlich. Durch den Sand ist der "
    "Boden hier sehr trocken, so dass Du kaum noch Pflanzen entdeckst. "
    "Ab und zu huscht ein kleines Insekt ueber den Sandboden, aber sonst "
    "ist hier kein Lebewesen zu sehn.");
  AddDetail("weg",
    "Der Weg wird immer sandiger je weiter Du nach Sueden gelangst.");
  AddDetail(({"gabelung","weggabelung"}),
    "Die Weggabelung ist noch ein Stueck entfernt und so kannst Du von hier "
    "nichts auffaelliges entdecken.");
  AddDetail("stueck",
    "Du bist noch ein ganzes Stueck von der Weggabelung entfernt.");
  AddDetail(({"anzeichen","zeichen"}),
    "Ein Anzeichen waere der sandige Boden, aber auch der staerker werdende "
    "Geruch nach Meer ist ein Zeichen dafuer, dass Du in der Naehe eines "
    "Strandes bist.");
  AddDetail("strand",
    "Alzuweit kann der Strand nicht entfernt sein. Du kannst sogar schon "
    "die ersten Anzeichen davon ausmachen.");
  AddDetail("boden",
    "Eine rund 2 cm dicke Sandschicht bedeckt den harten Fels.");
  AddDetail("geruch",
    "Wie willst Du sowas denn untersuchen ? Die meisten Leute koennen ihn "
    "nur riechen.");
  AddDetail("himmel",
    "Der Himmel ist, wie sollte es anders sein, mit dichten grauen Wolken "
    "bedeckt. Doch halt, Du wagst deinen Augen kaum zu trauen, aber es "
    "gibt doch einen Unterschied. Ein grosser Adler fliegt seine Runden "
    "und haelt Ausschau nach Beute.");
  AddDetail("adler",
    "Der Adler schwebt majestaetisch durch die Luefte.");
  AddDetail("ausschau",
    "Der Adler sucht wohl Beute, aber ob er damit auf dieser kahlen Insel "
    "viel Erfolg haben wird ? Schliesslich gibt es hier so gut wie keine "
    "Lebewesen.. ausser.. DIR ! Du spuerst ploetzlich eine gewisse Unruhe "
    "in Dir.");
  AddDetail("augen",
    "Wenn Du weiter so glotzt, fallen sie Dir sicher bald heraus :).");
  AddDetail("beute",
    "Du betest instaendig, dass der Adler nicht in Dir seine Beute sieht.");
  AddDetail("erfolg",
    "Du koenntest der bisher groesste Erfolg des Adlers werden, wenn Du "
    "nicht aufpasst.");
  AddDetail("fels",
    "Steinharter Fels verbirgt sich unter der Sandschicht.");
  AddDetail("insekt",
    "Ab und zu huscht ein kleines Insekt, dass Du nicht "
    "kennst, ueber den Boden um dann wieder zu verschwinden.");
  AddDetail("insel",
    "Du befindest Dich auf ihr.");
  AddDetail("lebewesen",
    "Du bist wohl mit Abstand das groesste Lebewesen auf dieser Insel.");
  AddDetail("leute",
    "Leute wie Du und ich.");
  AddDetail("luefte",
    "Der Adler schwebt mit beeindruckender Leichtigkeit durch die Luefte.");
  AddDetail("leichtigkeit",
    "So wuerdest Du auch mal gerne durch die Luefte segeln.");
  AddDetail("meer",
    "Auch wenn das Meer noch ein Stueckchen entfernt ist, kannst Du schon "
    "den markanten Geruch wahrnehmen.");
  AddDetail("naehe",
    "In der Naehe liegt wohl ein Strand.");
  AddDetail("abstand",
    "Du bist sicherlich das groesste Lebewesen auf der Insel und ziehst"
    "schnell die Aufmerksamkeit des Adlers auf Dich.");
  AddDetail("aufmerksamkeit",
    "Der Adler ist wohl schnell auf Dich aufmerksam geworden. Hoffentlich "
    "greift er Dich nicht an.");
  AddDetail("lebewesen",
    "Ob es ausser Dir, den paar Insekten und dem Adler noch mehr Lebewesen "
    "auf der Insel gibt ?");
  AddDetail("pflanzen",
    "Auf dem sandigen Boden wachsen kaum Pflanzen.");
  AddDetail("runden",
    "Der Adler dreht in aller Ruhe seine Runden.");
  AddDetail("ruhe",
    "Die Ruhe des Adlers kann taeuschen.");
  AddDetail("sand",
    "Hier liegt schon relativ viel Sand rum.");
  AddDetail(({"sandboden","teil"}),
    "Der Boden besteht zum groessten Teil aus Sand.");
  AddDetail("sandschicht",
    "Ca. 2 cm Sand bedecken den Felsboden.");
  AddDetail(({"stueckchen","stueckerl"}),
    "Ein Stueckerl musst halt noch gehen.");
  AddDetail("unruhe",
    "Eine Unruhe macht sich in deinem Koerper breit, bei dem Gedanken daran, "
    "dass der Adler es vielleicht auf Dich abgesehen hat.");
  AddDetail("unterschied",
    "Der Himmel hier hat eine kleine Besonderheit.");
  AddDetail("besonderheit",
    "Hier fliegt ein Adler umher.");
  AddDetail("wind",
    "Der Wind ist ziemlich kuehl und weht den Sand umher.");
  AddDetail("wolken",
    "Die Wolken bedecken so ziemlich den gesamten Himmel.");
  AddDetail("koerper",
    "Ein ungutes Gefuehl erfuellt deinen Koerper beim Gedanken "
    "daran, dass der Adler es auf Dich abgesehen haben koennte.");
  AddDetail("felsboden",
    "Unter der Sandschicht verbirgt sich ziemlich harter Fels, durch "
    "den nur wenige Pflanzen dringen koennen.");
  AddDetail("gedanken",
    "Du moechtest gar nicht dran denken, was passieren koennte.");
  AddDetail("gefuehl",
    "Du fuehlst Dich bei dem Gedanken nicht gerade wohl.");
  AddSmell(DEFAULT_SMELL,
    "Der Geruch des Meers ist schon schwach wahrzunehmen.");
  AddSmell("geruch",
    "Der Geruch erfrischt ein wenig.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst das Rauschen des Windes, und wenn Du Dich nicht taeuscht "
    "sogar schon die Wellen.");
  AddSound(({"rauschen","wind"}),
    "Der Wind rauscht durch die wenigen Pflanzen.");
  AddSound("wellen",
    "Die Wellen sind kaum wahrnehmbar.");

}
