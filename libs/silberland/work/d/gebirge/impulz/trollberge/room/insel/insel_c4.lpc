// Insel Raum C4 (grab) (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("norden","./insel_b4");
  SetProp(P_INT_LONG,
    "Der Trampelpfad endet hier vor einem grossen Baum, dessen Blaetter "
    "im Wind rascheln. Am Fuss des Baumes wurde eine Holzkreuz aufgestellt "
    "und der Boden darunter scheint umgegraben wurden zu sein. Eine "
    "andaechtige Stille laesst Ehrfurcht in Dir aufkommen. Diese Staette "
    "scheint ein altes Grab zu sein und Du solltest dein Verhalten "
    "dementsprechend anpassen. Nach Norden kannst Du diesen Ort wieder "
    "verlassen.");
  AddDetail(({"pfad","trampelpfad"}),
    "Der Pfad endet an diesem ruhigen Ort vor einem grossen Baum und "
    "verlaeuft im Gras, das rund um den Baum waechst und nur durch "
    "das Holzkreuz und den umgegrabenen Boden darunter unterbrochen wird.");
  AddDetail("baum",
    "Du siehst deine Vermutung, dass es sich um eine Eiche handelt, "
    "bestaetigt. Ihre gruenen, wenn auch etwas trockenen Blaetter, rascheln "
    "im Wind und verleihen dem Ort etwas gespentisches, da Du kein anderes "
    "Geraeusch wahrnehmen kannst.");
  AddDetail(({"blaetter","eichenblaetter"}),
    "Die Eichenblaetter rascheln im Wind und erzeugen so eine unheimliche "
    "Stimmung. Der bewoelkte Himmel und die Stille, die sonst hier herrscht "
    "tun ihr uebriges.");
  AddDetail("wind",
    "Der Wind pfeift geheimnisvoll durch die Blaetter der Eiche und bringt "
    "diese zum Rascheln. Ein Schauer laeuft Dir ueber den Ruecken.");
  AddDetail("fuss",
    "Am Fuss des Baumes befindet sich das erwaehnte Holzkreuz, als ob es "
    "durch den maechtigen Baum beschuetzt werden soll.");
  AddDetail(({"kreuz","holzkreuz"}),
    "Das Holzkreuz wurde scheinbar mit eher bescheidenen Mitteln "
    "zusammengebaut und ist darum ein ewnig schief. In das Kreuz ist eine "
    "Inschrift eingebrannt worden. Unter dem Holzkreuz ist der Boden etwas "
    "erhoeht, so als ob jemand dort einen grossen Gegenstand eingegraben "
    "haette.");
  AddDetail("inschrift","Lies sie doch einfach.");
  AddReadDetail("inschrift",
    "Hier ruht der Entdecker Skordil. Er wird uns durch seinen Mut stets in "
    "Erinnerung bleiben. Er hat uns vor dem Tod durch die Trolle bewahrt "
    "indem er sich ihnen entgegen stellte und sie von uns ablenkte. Leider "
    "kostete dies ihn sein Leben, aber wir werden ihm dafuer ewig dankbar "
    "sein.");
  AddDetail("gegenstand",
    "Dort wird wohl der Tote begraben sein.");
  AddDetail("boden",
    "Der Boden ist unter der Eiche etwas erhoeht und umgegraben.");
  AddDetail("ehrfurcht",
    "Voller Ehrfurcht bist Du wie versteinert. Dieser Ort strahlt etwas "
    "unheimliches und zugleich heiliges aus.");
  AddDetail("eiche",
    "Die Eiche ist sicher schon viele Jahre alt und Du ueberlegst, ob "
    "es die Eiche schon vor dem Grab gab oder ob sie gleichzeitig "
    "gepflanzt wurde. Ihre Blaetter rascheln leise im Wind.");
  AddDetail("geraeusch",
    "Du hoerst nur das Rascheln der Blaetter im Wind.");
  AddDetail("grab",
    "Das Grab ist wohl schon sehr alt, trotzdem fuehlst Du Dich seltsam "
    "unwohl. Ein ploetzlicher Drang zu beten erfuellt Dich.");
  AddCmd("bete","betefkt");
  AddDetail("drang",
    "Dich ueberkommt ein unheimlicher Drang zu beten.");
  AddDetail("gras",
    "Der Baum wird von Gras umgeben und wird so noch weiter hervorgehoben.");
  AddDetail("himmel",
    "Du glaubst nicht was Du siehst. Waehrend der Himmel auf dem ganzen "
    "Rest der Insel von einer dichten Wolkenschicht bedeckt wird, ist "
    "hier ein Loch in der Wolkendecke und es dringen sogar Sonnenstrahlen "
    "hinab und erleuten den Baum, als ob dieser Ort wirklich gesegnet sei.");
  AddDetail("insel",
    "Du befindest Dich auf einer Insel.");
  AddDetail("jahre",
    "Wer weiss wieviele Jahre dieser Baum schon ueberstanden hat. Er ist "
    "sicherlich weitaus aelter als Du.");
  AddDetail("loch",
    "Ein grosses Loch scheint in die Wolkendecke gerissen worden zu sein.");
  AddDetail("mittel",
    "Entweder hatten die Entdecker keine vernuenftigen Werkzeuge oder "
    "sie hatten es wirklich eilig von hier weg zu kommen. Aber warum ?");
  AddDetail("ort",
    "Der Ort hat scheinbar eine maechtige Aura.");
  AddDetail("rascheln",
    "Das kannst Du hoechtens hoeren.");
  AddDetail("rest",
    "Der ganze Rest der Insel ist durch eine dichte Wolkendecke verdunkelt.");
  AddDetail("ruecken",
    "Ein Schauer laeuft Dir dabei ueber den Ruecken.");
  AddDetail("schauer",
    "Das Rascheln der Blaetter laesst Dir einen Schauer ueber den Ruecken "
    "laufen.");
  AddDetail(({"strahlen","sonnenstrahlen"}),
    "Sonnenstrahlen dringen durch das Loch in der Wolkendecke und erhellen "
    "den Ort. Ehrfuerchtig blickst Du nach oben.");
  AddDetail("staette",
    "Du weisst hoffentlich wie Du Dich an einem Grab zu benehmen hast.");
  AddDetail("verhalten",
    "Lautes Sprechen und Rufen ist an einem Grab ganz sicher nicht "
    "angebracht, ja geradezu verpoent.");
  AddDetail("sprechen",
    "Du solltest Dich zurueckhalten.");
  AddDetail("rufen",
    "Hier laut zu rufen waer eine wirklich bescheidene Idee.");
  AddDetail("aura",
    "Eine geheimnisvolle heilige Aura umgibt diesen Ort.");
  AddDetail("entdecker",
    "Anscheinend haben vor langer Zeit einige Entdecker diesen Ort gefunden "
    "und sind hier gelandet, aber kurz darauf wieder verschwunden.");
  AddDetail("idee",
    "Komm ja nicht auf die Idee hier zu rufen.");
  AddDetail("stille",
    "Bis auf das Rascheln der Blaetter ist hier kein Laut zu hoeren.");
  AddDetail("stimmung",
    "Die Stimmung hier ist wirklich einmalig. Du scheint Dich an einem "
    "gesegneten Ort zu befinden.");
  AddDetail("tote",
    "Der Entdecker Skordil ist hier vor langer Zeit gestorben, wie Du "
    "an der Inschrift des Holzkreuzes erkennen kannst.");
  AddDetail("vermutung",
    "Deine Vermutung, dass es sich bei dem Baum um eine Eiche handelt, "
    "hat sich bestaetigt.");
  AddDetail("werkzeuge",
    "Dem Kreuz nach zu urteilen, waren die Werkzeuge ziemlich schlecht.");
  AddDetail(({"wolkendecke","decke","schicht","wolkenschicht"}),
    "Die Wolkendecke ist hier unterbrochen, so dass Sonnenstrahlen die "
    "feuchte Luft durchdringen koennen und den Ort hier erhellen.");
  AddDetail("laut",
    "Es ist fast absolute Stille.");
  AddDetail("luft",
    "Die Luft ist ziemlich feucht.");
  AddDetail("skordil",
    "So heisst der verstorbene Entdecker.");
  AddDetail("zeit",
    "Die Zeit vergeht rasend schnell und Du bist immernoch am mudden :).");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nur das Rascheln der Blaetter.");
  AddSound("rascheln",
    "Die Blaetter rascheln geheimnisvoll im Wind.");
  AddSmell(DEFAULT_SMELL,
    "Du bist viel zu fasziniert, als dass Du Dich auf die Gerueche "
    "konzentrieren koenntest.");
  AddSmell("gerueche",
    "Du riechst frische Luft, sonst faellt Dir nichts auf.");
  AddSmell("luft",
    "Die Luft ist wirklich erfrischend.");
  AddCmd(({"sag","sage"}),"sagefkt");
  AddCmd(({"ruf","rufe"}),"rufefkt");
}

int betefkt(string str)
{
  write(break_string(
    "Du sinkst auf die Knie und faltest deine Haende zum Gebet. Du beginnst "
    "ein Gebet leise vor Dich hin zu murmeln und wirst dabei ganz ruhig."));
  say(this_player()->name()+" faellt auf die Knie und beginnt zu beten.\n");
  this_player()->SetProp(P_PARALYZED,
    ([PARALYZE_TIME:10,
      PARALYZE_MSG:"Du kannst Dich nicht bewegen waehrend Du betest.\n",
      PARALYZE_END:"Du beendest dein Gebet und erhebst Dich langsam.\n",
      PARALYZE_END_OTHER:"%s beendet sein Gebet und steht auf.\n"]));
  return 1;
}

int sagefkt(string str)
{
  if (!str)
    { write("Du solltest nichtmal dran denken hier laut zu sprechen.");
      return 1;
    }
  write(break_string(
    "Du willst gerade losplappern, als Dir einfaellt, dass es sicher "
    "unpassend waere in Anbetracht dieses Ortes laut zu reden."));
  say(this_player()->name()+
    " will grad was sagen, verkneift es sich dann aber doch.\n");
  return 1;
}
 
int rufefkt(string str)
{
  int hp;
  if (!str)
    { write("Du solltest nichtmal dran denken hier laut zu rufen.");
      return 1;
    }
  write(break_string(
    "Du willst gerade laut losbruellen, als ein Strahl aus dem Baum "
    "schiesst und Dich schmerzvoll trifft. Das sollte Dir eine "
    "Warnung sein."));
  say(break_string(
    this_player()->name()+" will gerade rufen, als ihn ein Strahl "
    "trifft. Er zuckt voller Schmerz zusammen. Das war ihm sicher "
    "eine Warnung."));
  hp=this_player()->QueryProp(P_HP);
  if (hp>20)
     this_player()->SetProp(P_HP,hp-20);
  else
     this_player()->SetProp(P_HP,0);
  write_file("/players/impulz/log/grab.log",this_player()->name()+
             " "+ctime()+"\n");
  return 1;
}