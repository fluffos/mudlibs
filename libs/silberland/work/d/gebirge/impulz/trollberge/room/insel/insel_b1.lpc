// Insel Raum B1 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("norden","./insel_a1");
  AddExit("suedosten","./insel_c2");
  SetProp(P_INT_LONG,
    "Du stehst auf einem kleinen Trampelpfad der nach Norden und nach "
    "Suedosten weiterfuehrt. Auf beiden Seiten des Pfads wachsen trockene "
    "Graeser und Moose. Der Nebel verhindert, dass Du weiter gucken kannst, "
    "so dass Du gerade noch die Weggabelung im Suedosten erkennst. "
    "Ein kuehler Wind vom Meer her weht durch deine Haare.");
  AddDetail(({"pfad","trampelpfad"}),
    "Der schmale Trampelpfad fuehrt nach Norden und nach Suedosten zu einer "
    "Weggabelung. Links und rechts von ihm wachsen verschiedene Graeser und "
    "Moose.");
  AddDetail("seiten",
    "Auf beiden Seiten des Pfads wachsen trockene Graeser und Moose.");
  AddDetail("graeser",
    "Die Graeser scheinen den Naturgewalten Wind und Kaelte zu trotzen. "
    "Trotzdem sehen sie sehr trocken aus, da sie auf dem felsigen Boden "
    "kaum Wasser bekommen.");
  AddDetail("moose",
    "Moose wachsen fast ueberall, sogar auf einem so harten Untergrund wie "
    "hier.");
  AddDetail("nebel",
    "Der leichte Nebel hier auf der Insel verhindert einen weiten Ausblick.");
  AddDetail("ausblick",
    "Der Nebel verhindert, dass Du Dir von hier aus einen Ueberblick ueber "
    "die Insel verschaffen kannst.");
  AddDetail("ueberblick",
    "Der fehlt Dir hier irgendwie.");
  AddDetail("insel",
    "Du vermutest einfach mal, dass Du hier auf einer Insel bist.");
  AddDetail("haare",
    "Der Wind weht durch deine Haare und fuehlt sich auf deiner Haut "
    "ziemlich kuehl an.");
  AddDetail("haut",
    "Ueber deine Haut streift der kuehle Wind.");
  AddDetail("kaelte",
    "Im Vergleich zu den suedlicheren Teilen des Silberlandes, wie Midas "
    "oder gar Tijara ist es hier echt kalt. Du waerst sicherlich nichtmal "
    "sonderlich erstaunt, wenn Dir gleich ein Eisbaer ueber den Weg laufen "
    "wuerde.");
  AddDetail(({"vergleiche","vergleich"}),
    "Vergleiche sind immer gut :).");
  AddDetail("teile",
    "Wenn Du Dich hier so umschaust waerst Du irgendwie doch lieber wieder "
    "in einem waermeren Teil des Silberlandes.");
  AddDetail("silberland",
    "Auch wenn Du es kaum glauben wirst, Du befindest Dich gerade in ihm.");
  AddDetail("midas",
    "Midas ist die Hauptstadt des Silberlandes und die Heimat der Menschen.");
  AddDetail("tijara",
    "Tijara liegt suedlich vom Hauptkontinent und beherbergt viel "
    "Dschungel.");
  AddDetail("dschungel",
    "Dschungel wirst Du nur in einem tropischen Gebiet finden, hier ganz "
    "nicht.");
  AddDetail("gebiet",
    "Das Gebiet gehoert eher zur Tundra.");
  AddDetail("tundra",
    "So koennte man das hier wohl bezeichnen.");
  AddDetail("eisbaer",
    "Hier einen Eisbaer vorzufinden waer zwar lustig, aber nicht sonderlich "
    "verwunderlich.");
  AddDetail(({"kontinent","hauptkontinent"}),
    "Der Hauptkontinent ist echt riesig.");
  AddDetail("hauptstadt",
    "Von den meisten wird Midas als die Hauptstadt des Silberlandes "
    "angesehen.");
  AddDetail("heimat",
    "In Midas sind die Menschen beheimatet.");
  AddDetail("meer",
    "Du kannst das Meer gerade noch von hier aus im Norden erkenne.");
  AddDetail("menschen",
    "Die Menschen leben in Midas und sind eine von vielen Rassen im "
    "Silberland.");
  AddDetail(({"gewalten","naturgewalten"}),
    "Die Graeser scheinen den Naturgewalten zu trotzen.");
  AddDetail("rassen",
    "Es gibt hier etliche Rassen. Mach doch einfach 'hilfe rassen' um mehr "
    "zu erfahren.");
  AddDetail("untergrund",
    "Der Untergrund hier besteht scheinbar aus purem Fels.");
  AddDetail("fels",
    "Steinharter Fels halt.");
  AddDetail("wasser",
    "Du siehst hier weit und breit kein Wasser. Im Norden ist das Meer "
    "aber sonst isses hier wohl ziemlich trocken.");
  AddDetail("weg",
    "Du befindest Dich auf einem Trampelpfad, falls man das als Weg "
    "bezeichnen mag.");
  AddDetail(({"gabelung","weggabelung"}),
    "Der Weg gabelt sich im Suedosten.");
  AddDetail("wind",
    "Ein kuehler Wind weht Dir durch die Haare und ueber die Haut.");
  AddDetail("himmel",
     "Der Himmel ist voll von grauen Wolken, die Du durch den Nebel gerade "
     "noch erkennen kannst.");
  AddDetail("wolken",
     "Die grauen Wolken bedecken den ganzen Himmel und lassen nur wenig "
     "Sonnenstrahlen durch.");
  AddDetail(({"strahlen","sonnenstrahlen"}),
     "Nur wenig Sonnenstrahlen durchdringen die dichten grauen Wolken am "
     "Himmel.");
  AddDetail("boden",
     "Der Boden ist ziemlich hart.");
  AddSound(DEFAULT_SOUND,
     "Du hoerst den Wind durch die Graeser rauschen.");
  AddSound("wind",
     "Der Wind rauscht leise durch die Graeser.");
  AddSmell(DEFAULT_SMELL,
     "Es riecht ein wenig nach Salz.");
  AddSmell("salz",
     "Das ist halt der Meeresgeruch.");
  AddSmell("meeresgeruch",
     "Meeresluft soll ja gesund sein.");
  AddSmell("meeresluft",
     "Davon gibts hier genug.");
}
