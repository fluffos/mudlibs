inherit "std/room";
#include <properties.h>
#include "../../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Eine kleine Insel");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:12])); //kuehl
  SetProp(P_INDOORS,0);
}
