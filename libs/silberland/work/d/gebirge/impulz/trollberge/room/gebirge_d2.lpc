// Gebirgsweg (Trollberge) D2
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>
#include "../trolldefs.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"An einer Weggabelung");
  SetProp(P_INT_LONG,
    "Du steht an einer Weggabelung, soweit man hier von Weg sprechen kann. "
    "Vielmehr ist der Boden nur blanker Fels und ein Weg ist nicht zu "
    "erkennen. Im Sueden wird dieses Plateau von einem Tal unterbrochen, so "
    "dass Du nur nach Suedosten oder Suedwesten weiterkommst. Nach Norden "
    "kommst Du an den Rand des Plateau.");
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_MOUNTAIN,ENV_TEMPERATURE:15]));
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  AddDetail(({"gabelung","weggabelung"}),
    "Da sich im Sueden ein grosses Tal befindet, bleibt Dir wohl nicht "
    "viel weiter uebrig, als drum herum zu gehen, wenn Du weiter nach "
    "Sueden willst.");
  AddDetail("boden",
    "Der Boden besteht aus purem, kaltem, leblosem und feindlichem Fels.");
  AddDetail("fels",
    "Der Fels ist relativ eben und erleichtert das Vorankommen deutlich.");
  AddDetail("himmel",
    "Der Himmel ist immernoch so grau wie zuvor.");
  AddDetail("plateau",
    "Du stehst mitten drauf.");
  AddDetail("rand",
    "Der Rand ist von hier noch ein Stueck entfernt.");
  AddDetail("stueck",
    "Naja, so einen Raum zirka.");
  AddDetail("raum",
    "Ein Stueck halt. :)");
  AddDetail("tal",
    "Das Tal liegt etliche Meter unter Dir und es gibt von hier aus wohl "
    "keine Moeglichkeit es zu erreichen. Dort unten siehst Du gruene Wiesen, "
    "Baeume, einen Bach und einige Tiere. Der Kontrast zu hier oben koennte "
    "kaum groesser sein.");
  AddDetail("bach",
    "Der Bach ist kaum zu erkennen, sieht aber ziemlich klar aus.");
  AddDetail("baeume",
    "Die Baeume sind gruen und riesig gross und scheinen schon seit "
    "Generationen dort zu wachsen.");
  AddDetail("kontrast",
   "Dort unten ist es im Vergleich zu hier geradezu unverschaemt fruchtbar.");
  AddDetail("meter",
    "Runterspringen geht schonmal nicht, falls man lebend ankommen moechte.");
  AddDetail("moeglichkeit",
    "Nach genauerem Betrachten siehst Du ein, dass Du von hier niemals dort "
    "hinunter kommen wirst.");
  AddDetail("tiere",
    "Du kannst nicht genau erkennen, was fuer Tiere sind dort unten "
    "rumtreiben, aber es scheinen viele zu sein. Wie es aussieht sind alle "
    "Tiere de einmal hier gelebt haben dorthin gewandert.");
  AddDetail("vorankommen",
    "Auf dem felsigem Boden kommt man ziemlich leicht voran.");
  AddDetail("weg",
    "Weg? Sowas siehst Du hier nicht.");
  AddDetail("wiesen",
    "Gruene saftige Wiesen.");
  AddDetail(({"betrachten","schluss"}),
    "Du kommt immer wieder zu dem selben Schluss.");
  AddDetail("generationen",
    "Die Baeume sind sicherlich weitaus aelter als Du.");
  AddDetail("vergleich",
    "Wie gerne wuerdest Du dort unten sein.");
  AddSmell(DEFAULT_SMELL,
    "Du kannst leider keinen auffaelligen Geruch ausmachen.");
  AddSmell("geruch",
    "Du riechst keinen.");
  AddSound(DEFAULT_SMELL,
    "Ganz leise dringen die Geraeusche der Tiere unten im Tal an dein Ohr.");
  AddSound(({"geraeusche","tiere"}),
    "Du glaubst ein Bloeken zu erkennen.");
  AddSound("bloeken",
    "Scheint eine Ziege zu sein.");
  AddSound("ziege",
    "Ja, du hoerst eine Ziege bloeken, oder was auch immer die fuer "
    "Geraeusche machen.");
  AddExit("norden",ROOM("gebirge_d1"));
  AddExit("suedosten",ROOM("gebirge_e3"));
  AddExit("suedwesten",ROOM("gebirge_c3"));
  
 

}