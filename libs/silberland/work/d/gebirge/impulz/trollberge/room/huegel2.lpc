inherit "std/room";
#include <properties.h>
#include <moredef.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Auf einem steilen Pfad");
  SetProp(P_INT_LONG,
    "Du quaehlst Dich immernoch einen steil ansteigenden Pfad entlang. "
    "Die oede Landschaft um Dich herum, hat sich auch noch nicht gravierend. "
    "veraendert, so dass Du mit einem gewissen Desinteresse durch die Gegend "
    "wandelst. Die Bergspitzen sind schon ein wenig naeher gekommen, aber "
    "nicht weit genug, als dass Du erleichtert aufatmen wuerdest.");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:15]));


  AddDetail("pfad",
    "Nicht mehr viel und Du musst den Pfad 'hochklettern'.");
  AddDetail("landschaft",
    "Wenn Du dachtest auf dem Schiff waere es mit all dem Meer langweilig "
    "gewesen, scheinst Du Dich geirrt zu haben. Die Tiere die hier mal waren "
    "haben sich scheinbar zu Tode gelangweilt.");
  AddDetail(({"spitzen","bergspitzen"}),
    "Du siehst nur den unteren Teil der Spitzen, da der obere in den Wolken "
    "verschwindet.");
  AddDetail("boden",
    "Der Boden besteht aus festgetretener Erde und ist ziemlich hart.");
  AddDetail("erde",
    "Trockene, festgetretene Erde.");
  AddDetail("himmel",
    "Der Himmel ist voller Wolken und kann bezueglich Langeweile mit der "
    "Landschaft konkurrieren.");
  AddDetail("meer",
    "Meer? Wo? Hier is weit und breit keins.");
  AddDetail("schiff",
    "Das Meer war interessanter als das hier.");
  AddDetail("teil",
    "Ein Teil der Bergspitzen ist sichtbar.");
  AddDetail("tiere",
    "Wenns hier mal Tiere gab haben sie sich laengst totgelangweilt.");
  AddDetail(({"tode","tod"}),
    "Der Tod fluestert Dir zu: Ich denke Du weisst schon Bescheid.");
  AddDetail("wolken",
    "Dicke, graue Wolken. Ausserdem haengen sie am Himmel.");
  AddDetail("langeweile",
    "Du gaehnst.");
  AddSound(DEFAULT_SOUND,
    "Du hoerst nichts ausser dem Wind und deinen Schritten.");
  AddSound("wind",
    "Der Wind rauscht ueber die oede Landschaft.");
  AddSound("schritte",
    "*trampel*");
  AddSmell(DEFAULT_SMELL,
    "Du riechst... nichts.");
  AddDetail("desinteresse",
    "Du nimmst deine Umgebung kaum noch war, so langweilig ist sie. "
    "Wie schoen waere jetzt jemand, mit dem man sich beim Auf-/Abstieg "
    "unterhalten koennte.");
  AddDetail("aufstieg",
    "Wenn Du von Norden kommst, bist Du wohl gerade am Aufstieg.");
  AddDetail("abstieg",
    "Falls Du von Sueden kommst, bist grad am Abstieg.");
  AddDetail("gegend",
    "Sowas was langweilig..");
  AddDetail("umgebung",
    "Siehe Gegend.");

  AddExit("suedoben","./huegel3");  
  AddExit("sueden","./huegel3");
  AddExit("norden","./huegel1");
  AddExit("nordunten","./huegel1");
  SetProp(P_HIDE_EXITS,({"sueden","norden"}));


} 