// Insel Raum B4 (s. +gebirge/impulz/trollberge/doc/insel.karte)
// by Impulz@SL fuers SL

#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
inherit ROOM("insel/insel_inh");

create()
{
  ::create();
  AddExit("westen","./insel_b3");
  AddExit("sueden","./insel_c4");
  SetProp(P_INT_LONG,
    "Der Trampelpfad auf dem Du umherwanderst, macht hier einen scharfen "
    "Knick nach Sueden und hoerst dort scheinbar auch schon auf. Nach Westen "
    "kommst Du wieder zum Sumpf und der Weggabelung von der aus Du hierher "
    "gekommen bist. Ein groesserer Stein liegt neben dem Weg.");
  AddDetail(({"pfad","trampelpfad","weg"}),
    "Der Trampelpfad macht an dieser Stelle einen Knick und fuehrt noch ein "
    "ein kleines Stueck weiter nach Sueden bevor er an einem grossen Baum "
    "endet. Unter dem Baum schaint sich eine kleine Konstruktion zu befinden "
    "die Du von hier aus aber leider nicht genauer erkennen kannst.");
  AddDetail("knick",
    "Der Trampelpfad wechselt an dieser Stelle seine Richtung und fuehrt nun "
    "nach Sueden weiter.");
  AddDetail("richtung",
    "Der Weg fuehrt nach Sueden weiter.");
  AddDetail("sumpf",
    "Der Sumpf befindet sich westlich von Dir und Du kannst schon die ersten "
    "Mueckenschwaerme entdecken. Noch weiter westlich scheint eine "
    "Weggabelung zu sein.");
  AddDetail("baum",
    "Der Baum ist der einzige auf der ganzen Insel und scheint eine "
    "besondere Stelle zu markieren. Von hier aus kannst Du nicht mit "
    "Sicherheit sagen, was fuer ein Baum das ist, aber Du vermutest, dass es "
    "eine Eiche ist.");
  AddDetail("boden",
    "Der Boden besteht aus einer duennen Erd- und Staubschicht. Ein paar "
    "Grasbueschel stehen neben dem Weg und trotzen dem Wind.");
  AddDetail("eiche",
    "Du wuerdest nicht drauf wetten, aber von hier aus sieht der Baum aus "
    "wie eine Eiche.");
  AddDetail("himmel",
    "Der Himmel ist mit grauen dunklen Wolken behangen und es sieht fast so "
    "aus als ob es gleich anfangen koennte zu regnen.");
  AddDetail("insel",
    "Diese Insel scheint dem Festland vorgelagert zu sein, denn Du kannst "
    "weit im Sueden schon die ersten Gebirgszuege konturenhaft erkennen.");
  AddDetail("konstruktion",
    "Was das fuer eine Konstruktion ist, wirst Du wohl erst herausfinden, "
    "wenn Du naeher rangehst.");
  AddDetail(({"schwaerme","mueckenschwaerme"}),
    "Im Westen erwarten Dich riesige Mueckenschwaerme, die bedrohlich "
    "umherfliegen.");
  AddDetail("sicherheit",
    "Du bist Dir nicht sicher, ob der Baum im Sueden eine Eiche ist, "
    "vermutest es aber.");
  AddDetail("stein",
    "Der Stein liegt auffaellig auf dem Weg herum. Bei genauerem "
    "Hinsehen erkennt Du eine Inschrift.");
  AddDetail("inschrift",
    "Lies sie am besten.");
  AddReadDetail("inschrift",
    "'BITTE UMDREHEN!' steht auf dem Stein.");
  AddCmd("drehe","drehfkt");
  AddCmd("dreh","drehfkt");
  AddDetail(({"erdschicht","schicht","staubschicht"}),
    "Eine Schicht aus Erde und Staub bedeckt den Boden.");
  AddDetail("erde",
    "Die Erde ist ziemlich trocken.");
  AddDetail("staub",
    "Der Staub setzt sich ueberall fest und Du kriegst ihn sicherlich nie "
    "wieder von deinen Kleidern runter.");
  AddDetail("kleider",
    "Deine Kleider sind voll von Staub, aber was solls.");
  AddDetail("festland",
    "Das Festland kann nicht alzu weit weg sein, da Du schon die ersten "
    "Umrisse eines Gebirges entdecken kannst.");
  AddDetail("umrisse",
    "Von hier kannst Du leider nur schwache Umrisse entdecken.");
  AddDetail(({"gebirge","gebirgszuege"}),
    "Das Gebirge scheint ziemlich hoch und gewaltig zu sein. Wer weiss "
    "was sich darin oder dahinter verbirgt.");
  AddDetail(({"bueschel","grasbueschel"}),
    "Ab und zu waechst ein kleiner Grasbueschel am Wegrand.");
  AddDetail("wegrand",
    "Am Wegrand waechst ab und zu ein kleiner Grasbueschel.");
  AddDetail("hinsehen",
    "Ja, man sollte immer genauer hinsehen. Wer weiss man man so entdecken "
    "kann.");
  AddDetail("stelle",
    "Der Trampelpfad macht hier einen Knick nach Sueden.");
  AddDetail("stueck",
    "Noch ein kleines Stueck weiter suedlich befindet sich ein Baum.");
  AddDetail(({"gabelung","weggabelung"}),
    "Weit weit im Westen befindet sich die Weggabelung von der aus Du "
    "hierher gelangt bist.");
  AddDetail("wind",
    "Der Wind blaest Dir kalt ins Gesicht.");
  AddDetail("gesicht",
    "Durch den kalten Wind sind deine Gesichtszuege fast gefroren.");
  AddDetail("gesichtszuege",
    "Der Wind kuehlt deine Haut so stark ab, dass sie fast gefroren "
    "scheint.");
  AddDetail("haut",
    "Deine Haut ist eiskalt, als ob Du tot waerst.");
  AddDetail("wolken",
    "Die grauen Wolken bedecken den ganzen Himmel.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst nur den Wind rauschen.");
  AddSound("wind",
    "Der Wind rauscht durch das Gras und hoert sich in der Stille die "
    "hier herrscht fast gespenstisch an.");
  AddSound("stille",
    "Stille kann man nicht hoeren, da Du bei Stille gerade nichts hoerst.");
  AddSound("gras",
    "Der Wind rauscht durch das Gras.");
  AddSmell(DEFAULT_SMELL,
    "Du riechst ganz schwach den Geruch des Meeres.");
  AddSmell("geruch",
    "Das Meer riecht etwas salzig.");
  AddSmell("meer",
    "Du kannst das Meer kaum riechen, woraus Du schliesst, dass Du Dich "
    "wohl ziemlich weit im Inselinneren befindest.");
  AddItem(NPC("austroll"),REFRESH_DESTRUCT);
}


int drehfkt(string str)
{
  if (!str) return 0;
  if ((lower_case(str)=="stein") || (lower_case(str)=="stein um"))
   {
    write("Du drehst den Stein um und siehst die andere Inschrift.\n");
    return 1;
   }
  return 0;
}