// Weg ins Gebirge, Abschnitt Ebene, Raum 1
// by Impulz@SL

inherit "std/room";
#include <properties.h>
#include <moredef.h>

create()
{
  ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_PLAIN,ENV_TEMPERATURE:15]));
  SetProp(P_INT_SHORT,"An einer Weggabelung.");
  SetProp(P_INT_LONG,
    "Du stehst an einer Weggabelung, von wo aus es in drei Richtungen "
    "geht. Im Norden erkennst Du einen kleinen Steg. Nach Sueden geht es "
    "dein Weg weiter entlang der immer weiter anzusteigen scheint. "
    "Im Nordwesten scheint eine kleine Huette zu stehen.");
  AddDetail(({"gabelung","weggabelung"}),
    "Du stehst mitten an einer Weggabelung.");
  AddDetail("richtungen",
    "Norden, Nordwesten und Sueden um genau zu sein.");
  AddDetail(({"steg","huette"}),
    "Von hier aus erkennst Du leider nichts genaues. Du musst wohl oder "
    "uebel naeher ran gehen.");
  AddDetail("weg",
    "Du befindest Dich auf dem Weg. Im Norden endet er an dem besagten Steg "
    "und nach Sueden fuehrt er noch ein ganzes Stueck hinauf.");
  AddDetail("stueck",
    "Es sind sicherlich noch einige Kilometer.");
  AddDetail("kilometer",
    "Du beginnst zu stoehnen, wenn Du daran denkst, dass Du den Weg "
    "hinauf zu gehen.");
  AddDetail("boden",
    "Der Boden ist mit einer duennen Grasdecke ueberzogen und es laesst "
    "sich relativ angenehm darauf gehen.");
  AddDetail("grasdecke",
    "Es ist fast so, als ob Du auf einem Teppich gehst.");
  AddDetail("teppich",
    "Man koennte die Grasdecke als eine Art natuerlichen Teppich betrachten."
           );
  AddDetail("art",
    "Auf die eine oder andere Art.");
  AddDetail("himmel",
    "Der Himmel ist von grauen Wolken bedeckt.");
  AddDetail("wolken",
    "Du verspuerst eine gewisse Wut auf die Wolken, da sie alles etwas "
    "verdunkeln und eine trostlose Atmospaehre entsteht.");
  AddDetail("wut",
    "Das kannst Du doch nicht sehen!");
  AddDetail("atmospaehre",
    "Irgendwie.. trostlos.");
  AddSound(DEFAULT_SOUND,
    "Es ist fast unnatuerlich still. Nur aus dem Nordwesten kommen einige "
    "Geraeusche.");
  AddSound("geraeusche",
    "Du kannst sie von hier aus unmoeglich identifizieren.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht noch ein wenig nach Meer.");
  AddSmell("meer",
    "Der Geruch scheint aus dem Norden zu kommen.");
  AddSmell("geruch",
    "Es riecht salzig.");
  AddExit("norden","anlegestelle");
  AddExit("sueden","./huegel1");
  AddExit("suedoben","./huegel1");
  AddExit("nordwesten","./strand");
  SetProp(P_HIDE_EXITS,({"sueden"}));
}