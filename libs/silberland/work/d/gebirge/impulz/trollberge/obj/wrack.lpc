// Wrack-Objekt by Impulz

inherit "std/thing";
#include <thing/properties.h>
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return 0;
  ::create();
  SetProp(P_SHORT,"Eine kaputte Faehre");
  SetProp(P_NAME,"Faehre");
  SetProp(P_LONG,
    "Die Faehre koennte Dich wahrscheinlich sicher ans andere Ufer bringen "
    "waere da nicht dieses grosse Loch an der Backbordseite.");
  SetProp(P_NOGET,1);
  SetProp(P_WEIGHT,1000000);
  AddId("faehre");
  AddCmd("betrete","betretefkt");

}

betretefkt(string str)
{
  if (lower_case(str)!="faehre") return 0;
  write(break_string(
   "Die Faehre is zu beschaedigt um damit fahren zu koennen, also sparst "
   "Du Dir die Muehe sie zu betreten."));
  return 1;
}