// Faehrmann (wrack) by Impulz

inherit "std/npc";
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return 0;
  ::create();
  SetProp(P_SHORT,"Ein alter Faehrmann");
  SetProp(P_NAME,"Faehrmann");
  SetProp(P_LONG,
    "Der alte Mann sieht ziemlich traurig aus und jammert die ganze "
    "Zeit vor sich hin.");
  AddId("faehrmann");
  AddId("mann");
  SetProp(P_NOATTACK,"Das koenntest Du NIEMALS tun.");
  SetProp(P_GENDER,MALE);
  create_default_npc(5);
  AddInfo(DEFAULT_INFO,
    "Meine Faehre, meine schoene Faehre, ...","jammert nur: ");
  AddInfo(({"grund","hilfe","problem","faehre"}),
    "Meine schoene Faehre ist auf ein Riff gefahren. Jetzt bin ich "
    "arbeitslos bis die bestellten Handwerker kommen, aber das kann "
    "noch einige Zeit dauern.","sagt: ");
  AddInfo("zeit",
    "In den naechsten Tagen wird hier wohl keiner rueberkommen.","sagt: ");
  SetChats(5,
    ({"Der Faehrmann jammert: Meine schoene, schoene Faehre ...\n",
      "Dem Faehrmann rinnen ein paar Traenen ueber die Wange.\n",
      "Der Faehrmann sieht fuer einen kurzen Augenblick noch "
      "ungluecklicher aus.\n"}));
}