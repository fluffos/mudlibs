// Tuersteher
// by Impulz@SL

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <moving.h>
#include "../trolldefs.h"
object *enemylist;

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Der Tuersteher");
  SetProp(P_NAME,"Tuersteher");
  SetProp(P_LONG,
    "Der Tuersteher passt auf, dass hier niemand ausflippt. Sollte es "
    "jemand wagen, wird er wohl sofort rausgeschmissen. Der Tuersteher "
    "sieht ziemlich kraeftig aus und ist sicher kein Gegner mit dem man "
    "sich leichtfertig anlegen sollte.");
  create_default_npc(30);
  AddId("tuersteher");
  AddId("\ntuersteher");
  SetProp(P_SIZE,200);
  SetProp(P_ALIGN,200);
  SetProp(P_SPELLRATE,50);
  SetProp(P_GENDER,MALE);
  enemylist=({});
}

void Attack(object enemy)
{ if (!random(5))
   {
     enemy->StopHuntFor(TO,1);
     TO->StopHuntFor(enemy,1);
     tell_object(enemy,
      "Der Tuersteher packt Dich und wirft Dich in hohem Bogen raus.\n");
     enemy->move(ROOM("strand"),M_NOCHECK | M_SILENT,"",
                    "fliegt in hohem Bogen hinaus.",
                    "kommt in hohem Bogen angeflogen.");
     ENV(TO)->SetProp(P_ENEMYLIST,ENV(TO)->QueryProp(P_ENEMYLIST)+({enemy}));
     tell_object(enemy,
      "Der Tuersteher bruellt Dir hinterher: 'Komm ja nie wieder !'\n");
     say(enemy->name()+" wird vom Tuersteher in hohem Bogen rausgeworfen.\n");
    }
  else
    ::Attack(enemy);

}

