// Thea - Berkeeperin im Partyhaus
// by Impulz@SL

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#include <moving.h>
#include "../trolldefs.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(25);
  SetProp(P_SHORT,"Thea");
  SetProp(P_NAME,"Thea");
  SetProp(P_ARTICLE,0);
  SetProp(P_LONG,
    "Thea ist die Barkeeperin hier. Sie eilt an der Theke entlang und "
    "bedient ihre Gaeste fleissig. Sie ist eine Frau mittleren Alters und "
    "scheint schon laenger hier zu arbeiten. Sie ist zwar nicht umwerfend "
    "huebsch, aber trotzdem bei den Maennern beliebt.");
  AddId("thea");
  AddId("\nthea"); // fuer die kneipe
  SetProp(P_NOATTACK,"");
  SetProp(P_RACE,"Mensch");
  SetProp(P_SIZE,175);
}


mixed _query_noattack()
{ string txt;
  switch(random(3))
  {
   case 0: txt="schimpft: Lass das, ich hass das.";break;
   case 1: txt="sagt: Ich hab keine Zeit fuer solche Kindereien.";
           break;
   case 2: txt="ruft einige Gaeste zu Hilfe, die Dich davon abhalten.";break;
  }
  if (!random(5))
     if (present("\ntuersteher",ENV(TO)))
        { write(BS(
           "Thea gibt dem Tuersteher ein Zeichen, worauf Dich dieser "
           "in hohem Bogen rauswirft."));
          TP->move(ROOM("strand"),M_NOCHECK | M_SILENT,"",
                    "fliegt in hohem Bogen hinaus.",
                    "kommt in hohem Bogen angeflogen.");
          return "winkt Dir grinsed aus einem Fenster zu.";
        };
  return txt;
} 
        
  