/* Nasenbaer
 * by Impulz@SL
 */

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#define level 5

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Nasenbaer");
  SetProp(P_NAME,"Nasenbaer");
  SetProp(P_GENDER,MALE);
  SetProp(P_LONG,
    "Der Nasenbaer hat eine auffaellig grosse Nase, wodurch er wohl seinen "
    "Namen hat. Er sieht eigentlich recht friedfertig aus, zumindest solange "
    "man ihn nicht stoert. Mit wachen Augen beobachtet er jeden deiner "
    "Schritte. Alzu gefaehrlich sieht er aber nicht aus.");
  create_default_npc(level);
  SetProp(P_SIZE,50);
  SetProp(P_ALIGN,100);
  SetProp(P_HANDS,({" mit seiner Nase",QueryProp(P_HANDS)[1]}));
  AddId("baer");
  AddId("nasenbaer");
}