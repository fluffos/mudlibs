// Besoffener am Strand
// by Impulz@SL
inherit "std/npc";

#include <properties.h>
#include <moredef.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(10);
  SetProp(P_SHORT,"Eine Schnapsleiche");
  SetProp(P_NAME,"Schnapsleiche");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_LONG,
    "Der Jugendliche scheint wohl etwas zuviel Alkohol getrunken "
    "zu haben, da er ziemlich blass aussieht und sich das Essen "
    "scheinbar nochmal hat durch den Kopf gehen lassen. Er lallt "
    "irgendein sinnloses Zeugs.");
  SetProp(P_HANDS,({" mit einer leeren Flasche",QueryProp(P_HANDS)[1],
                   DT_BLUDGEON}));
  SetProp(P_MAX_HANDS,2);
  SetProp(P_RACE,"Mensch");
  SetProp(P_SIZE,180);
  SetProp(P_ALIGN,-500+random(1000));
  SetProp(P_MAX_ALCOHOL,150);
  SetProp(P_ALCOHOL,150);
  AddId("schnapsleiche");
  AddId("jugendlicher");
  AddInfo(DEFAULT_INFO,"lallt irgendwas unverstaendliches.\n");
}

name()
{
  SetProp(P_ALCOHOL,150);
  return ::name();
}