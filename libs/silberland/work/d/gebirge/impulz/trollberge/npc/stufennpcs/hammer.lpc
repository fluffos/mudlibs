/* Hammer vom Trollarbeiter, nicht als Waffe verwendbar
 * by Impulz@SL
 */

inherit "std/thing";
#include <properties.h>
#include <thing/properties.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Trollhammer");
  SetProp(P_NAME,"Trollhammer");
  SetProp(P_GENDER,MALE);
  SetProp(P_LONG,
    "Der Hammer ist extrem schwer und Du musst ihn fast hinter Dir "
    "herziehen. Leider ist er ziemlich nutzlos.");
  SetProp(P_WEIGHT,10000);
  SetProp(P_VALUE,1500);
  SetProp(P_MATERIAL,([MAT_WOOD:70,MAT_STEEL:30]));
  AddId("hammer");
  AddId("trollhammer");
}