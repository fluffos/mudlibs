/* Ein Hirsch
 * by Impulz@SL
 */

inherit "std/npc";
inherit "std/npc/spells";
#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include "../../trolldefs.h"
#define level 16

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein kraeftiger Hirsch");
  SetProp(P_NAME,"Hirsch");
  SetProp(P_LONG,
    "Der Hirsch hat aeussert kraeftige Beine und ein spitzes Geweih. "
    "Ueberleg es Dir gut, ob Du Dich leichtfertig mit ihm anlegen sollst, "
    "denn wenn Du ihn angreifst, koennte das dein Ende bedeuten, denn er "
    "gibt sicher nicht eher Ruhe, als bis einer von euch tot ist.");
  SetProp(P_GENDER,MALE);
  create_default_npc(level);
  SetProp(P_SIZE,180);
  SetProp(P_HANDS,({" mit seinem Geweih",QueryProp(P_HANDS)[1]}));
  SetProp(P_ALIGN,0);
  SetProp(P_SPELLRATE,20);
  AddDefaultSpell(1,100,DS_DISARM,
        "Der Hirscht rammt Dich so stark in den Bauch, dass Du deine Waffe "
        "verlierst.\n",
        "Der Hirsch rammt @WEN in den Bauch, worauf diesem seine Waffe "
        "entgleitet.\n");
  AddSpell(5,QueryProp(P_HANDS)[1]*(random(3)+1),
           "Der Hirsch trifft Dich mit seinen kraeftigen Hinterbeinen.\n",
           "Der Hirsch trifft @WEN mit seinen Hinterbeinen.\n",DT_BLUDGEON,
           ([SP_SHOW_DAMAGE:1]));
  AddId("hirsch");
  AddId("\nHirsch"); // fuer den WC_BONUS der waffe
  seteuid(getuid(TO));
  CLONEME(NPC("stufennpcs/hirschgeweih"));
  command_me("zuecke geweih");
  
}            
