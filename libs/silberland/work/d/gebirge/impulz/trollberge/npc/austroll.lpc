// Ein ausgestossener Troll
// by Impulz@SL

inherit "std/npc";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return 0;
  ::create();
  SetProp(P_SHORT,"Ein ausgestossener Troll");
  SetProp(P_NAME,"Troll");
  SetProp(P_NAME_ADJ,"ausgestossen");
  AddId("troll");
  AddAdjective("ausgestossen");
  create_default_npc(15);
  SetProp(P_RACE,"Troll");
  SetProp(P_GENDER,MALE);
  SetProp(P_HANDS,({" mit Trollklauen",120,DT_BLUDGEON}));
  SetProp(P_WIMPY,20);
  SetProp(P_MURDER_MSG,
    "Scheisse passiert. Man gewinnt oder stirbt.");
  AddSpell(2,150,"  Der Troll tritt Dir in den Magen.\n",
           "  Der Troll tritt @WEN in den Magen.\n",DT_BLUDGEON,
           ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,"  Der Troll versetzt Dir einen maechtigen Schlag.\n",
           "  Der Troll versetzt @WEM einen maechtigen Schlag.\n",DT_BLUDGEON,
           ([SP_SHOW_DAMAGE:1]));
  SetProp(P_SPELLRATE,15);
  SetProp(P_WEIGHT,400000);
  SetProp(P_SIZE,220);
         
}