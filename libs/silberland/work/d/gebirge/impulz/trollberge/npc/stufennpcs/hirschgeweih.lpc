/* Hirschgeweih
 * by Impulz@SL
 */

inherit "std/weapon";
#include <moredef.h>
#include <properties.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Hirschgeweih");
  SetProp(P_NAME,"Hirschgeweih");
  SetProp(P_LONG,
    "Das Hirschgeweih stammt von einem ziemlich grossen Hirsch "
    "und kann mit seinen spitzen Hoernern den Gegner stark verletzen.");
  SetProp(P_WC_FIXFACTOR,0.15); // unhandlich so ein ding :)
  SetProp(P_WC,120); // Dafuer etwas staerker
  SetProp(P_WC_BONUS,(["\nHirsch":80]));
  SetProp(P_GENDER,NEUTER);
  SetProp(P_NR_HANDS,2);
  SetProp(P_MATERIAL,([MAT_HORN:100]));
  SetProp(P_WEIGHT,7000); 
  SetProp(P_VALUE,900);
  AddId("geweih");
  AddId("hirschgeweih");
}