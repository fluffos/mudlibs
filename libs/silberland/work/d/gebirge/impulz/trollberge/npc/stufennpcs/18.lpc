/* Ein Trollarbeiter
 * by Impulz@SL
 */

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include "../../trolldefs.h"
#define level 18

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Trollarbeiter");
  SetProp(P_LONG,
    "Der Trollarbeiter ist schwer damit beschaeftigt, den vorhandenen Weg "
    "auszubauen und schlaegt monoton mit seinem Hammer auf Pfaehler, die "
    "wohl spaeter einmal einen Zaun bilden sollen. Er ist zwar sehr "
    "kraeftig, aber doch ein klein bisserl ungeschickt, so dass ein dicker "
    "Verband seine linke Hand ziert.");
  SetProp(P_NAME,"Trollarbeiter");
  SetProp(P_GENDER,MALE);
  create_default_npc(level);
  SetProp(P_SIZE,320+random(20));
  SetProp(P_ALIGN,-333);
  SetProp(P_HANDS,({" mit seinem Hammer",QueryProp(P_HANDS)[1]}));
  SetProp(P_WEIGHT,350000);
  SetProp(P_RACE,"Troll");
  SetProp(P_VULNERABILITY,({DT_LIGHT,DT_FIRE}));
  SetProp(P_RESISTANCE,({DT_AIR,DT_TERROR}));
  AddId("arbeiter");
  AddId("trollarbeiter");
  seteuid(getuid(TO));
  CLONEME(NPC("stufennpcs/hammer"));
  SetProp(P_SPELLRATE,10);
  AddSpell(1,QueryProp(P_HANDS)[1]*3/2,
     BS("Der Arbeiter verpasst Dir einen maechtigen Hammerschlag auf die "
        "Stirn. Das gibt ne wahnsinnige Beule. :("),
     BS("Der Arbeiter zieht @WEM mit dem Hammer eins ueber. Das gibt ne "
        "Beule."),DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

InformDefend(object enemy)
{
  kill(enemy);
  return 1;
}