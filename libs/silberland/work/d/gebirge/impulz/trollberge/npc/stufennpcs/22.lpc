/* Ein Trollaufseher
 * by Impulz@SL
 */

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include "../../trolldefs.h"
#define level 22

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Trollaufseher");
  SetProp(P_LONG,
    "Der Aufseher passt auf, dass die Arbeiter auch ordentlich ihre Arbeit "
    "tun. Trotzdem laeuft er ein wenig planlos durch die Gegend und scheint "
    "nicht so recht den Ueberblick zu haben. Er hat den Job wohl nur "
    "bekommen, weil er staerker als die anderen Arbeiter ist. Er traegt "
    "eine Peitsche in seiner rechten Hand und schwingt sie bedrohlich auf "
    "und ab.");
  SetProp(P_NAME,"Trollaufseher");
  SetProp(P_GENDER,MALE);
  create_default_npc(level);
  SetProp(P_SIZE,340+random(20));
  SetProp(P_ALIGN,-333);
  SetProp(P_HANDS,({" mit seiner Peitsche",QueryProp(P_HANDS)[1],DT_WHIP}));
  SetProp(P_WEIGHT,400000);
  SetProp(P_RACE,"Troll");
  SetProp(P_VULNERABILITY,({DT_LIGHT,DT_FIRE}));
  SetProp(P_RESISTANCE,({DT_AIR,DT_TERROR}));
  AddId("aufseher");
  AddId("trollaufseher");
  
}