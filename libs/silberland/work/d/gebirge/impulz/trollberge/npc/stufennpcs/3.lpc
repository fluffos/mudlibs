/* Ein schwacher Elf
 * by Impulz@SL
 * 12.11.98
 */

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#include "../../trolldefs.h"
#define level 3

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein schwaechlicher Elf");
  SetProp(P_LONG,
    "Der Elf war wohl lange in Gefangenschaft, denn er sieht richtig "
    "abgemagert aus. Seine Augen sind blutunterlaufen und er hinkt "
    "etwas. Er beachtet Dich kaum.");
  create_default_npc(level);
  SetProp(P_HP,QueryProp(P_MAX_HP)/2); // mitgenommen
  SetProp(P_XP,QueryProp(P_XP)*2/3);   // XP dafuer auch runter
  SetProp(P_NAME,"Elf");
  AddId("elf");
  SetProp(P_RACE,"Elf");
  SetProp(P_HANDS,({" mit knoechrigen Haenden",QueryProp(P_HANDS)[1]}));
  SetProp(P_GENDER,MALE);
  SetProp(P_ALIGN,200);
  SetProp(P_SIZE,220);
}