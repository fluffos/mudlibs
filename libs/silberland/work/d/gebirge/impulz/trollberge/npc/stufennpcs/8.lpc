/* Eine gestreifte Katze
 * by Impulz@SL
 */

inherit "std/npc";
#include <properties.h>
#include <moredef.h>
#define level 8

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Eine gestreifte Katze");
  SetProp(P_LONG,
    "Die Katze hat ein hellgrau-schwarz gestreiftes rauhes Fell. "
    "Ihre gelben Augen scheinen Dich zu durchdringen. Ihre messerscharfen "
    "Krallen hat sie bereits ausgefahren und hockt sprungbereit ein paar "
    "Meter vor Dir.");
  SetProp(P_NAME,"Katze");
  SetProp(P_GENDER,FEMALE);
  create_default_npc(level);
  SetProp(P_SIZE,30);
  SetProp(P_HANDS,({" mit ihren scharfen Krallen",QueryProp(P_HANDS)[1]}));
  SetProp(P_ALIGN,-300);
  AddId("katze");
}
