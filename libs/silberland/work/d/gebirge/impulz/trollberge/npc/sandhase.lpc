// sandhase by Impulz@SL
inherit "std/npc";
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return 0;
  ::create();
  SetProp(P_SHORT,"Ein agressiver Sandhase");
  SetProp(P_NAME,"Sandhase");
  SetProp(P_LONG,
    "Der Sandhase siehst ziemlich angriffslustig aus. Wahrscheinlich wurde "
    "er irgendwobei gestoert.");
  create_default_npc(7);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_HANDS,({" mit seinen Hasenpfoten",50,DT_RIP}));
  SetProp(P_GENDER,MALE);
  SetProp(P_ALIGN,-500);
  AddId("hase");
  AddId("sandhase");
}