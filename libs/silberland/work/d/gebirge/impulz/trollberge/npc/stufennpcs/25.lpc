/* Ein Trollkaempfer names Argos, dessen short sich dem spieler anpasst
 * by Impulz@SL
 */

inherit "std/npc";
inherit "std/npc/spells";
#include <properties.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include "../../trolldefs.h"
#define level 25

int kopfstoss(object enemy,int dt,int damage)
{
  if (!enemy->QueryProp(P_BLIND)) enemy->SetProp(P_BLIND,random(10));
  return 1;
}



create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Shit, das Leben ist scheisse !");
  create_default_npc(level);
  SetProp(P_GENDER,MALE);
  SetProp(P_SIZE,360+random(10));
  SetProp(P_NAME,"Argos");
  AddId("argos");
  SetProp(P_ALIGN,0);
  SetProp(P_WEIGHT,500000);
  SetProp(P_RACE,"Troll");
  SetProp(P_HANDS,({" mit seiner Axt",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE,"Troll");
  SetProp(P_VULNERABILITY,({DT_LIGHT,DT_FIRE}));
  SetProp(P_RESISTANCE,({DT_AIR,DT_TERROR}));
  SetProp(P_ARTICLE,0);
  SetProp(P_HEAL,5);
  SetProp(P_SPELLRATE,30);
  AddSpell(7,200,BS(
    "Argos packt deine Beine und dreht sich ploetzlich mehrmals um sich "
    "selbst, so dass Du nur so durch die Luft fliegst. Dir "
    "wird speiuebel."),BS(
    "Argos packt @WESSEN Beine und spielt mit ihm Hammerwerfen."));
  AddSpell(5,300,
    "Argos holt weit mit seiner Axt aus und schlaegt so feste er kann zu.\n",
    "Argos holt extra weit aus und macht aus @WEM Gehacktes.\n",DT_MAGIC,
    ([SP_SHOW_DAMAGE:1]));
  AddSpell(5,50,BS(
    "Argos schlaegt Dir mit seiner geballten Faust auf den Kopf, worauf Dir "
    "schwarz vor Augen wird."),
    "Argos verpasst @WEM einen starken Schlag auf den Kopf.",
    DT_BLUDGEON,"kopfstoss");
  AddDefaultSpell(1,150,DS_DISARM,BS(
    "Argos steckt seine Axt weg, packt Dich und schuettelt Dich solange durch"
    " bis Dir deine Waffe aus der Hand faellt."),
    "Argos schuettelt @WEN solange durch, bis dieser seine Waffe verliert.\n"
    );
  AddSpell(7,150,
   "Argos rammt Dir sein Knie in den Magen.\n",
   "@WER bekommt Argos Knie in den Magen.\n",
   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddInfo(DEFAULT_INFO,"schaut Dich nur boese an.\n");
  AddInfo("pumuckl",
    "flippt total aus und singt: Hurra, hurra der Pumuckl is da."); // :)
  AddInfo("impulz",
    "sagt: Ah.. den kenn ich.. das is nen ganz schlimmer.");
  AddInfo("phelia",
    "schimpft: Erwaehne nie wieder diesen Namen in meiner Naehe.");

  seteuid(getuid(TO));
}

string _query_noattack()
{
  if (TP->QueryProp(P_LEVEL)<15)
    return "sagt: Komm wieder, wenn Du ein bischen besser bist..";
  else return 0;
}

string _query_short()
{
  if (query_once_interactive(TI))
  switch(lower_case(TI->QueryProp(P_RACE)))
  {
    case "elf"      : return "Argos der Elfentoeter";break;
    case "troll"    : return "Argos der Trollkaempfer";break;
    case "mensch"   : return "Argos der Menschentoeter";break;
    case "hobbit"   : return "Argos der Hobbittoeter";break;
    case "zwerg"    : return "Argos der Zwergentoeter";break;
    case "dunkelelf": return "Argos der Dunkelelfentoeter";break;
    case "oger"     : return "Argos der Ogertoeter";break;
    case "fee"      : return "Argos der Feentoeter";break;
    case "goblin"   : return "Argos der Goblintoeter";break;
    default         : return "Argos der "+capitalize(TI->QueryProp(P_RACE))
                               +"toeter";
  }
  return "Argos"; // Falls es kein Spieler is.. vorsichtshalber..
}
  