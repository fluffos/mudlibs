/* Ein Grauwolf
 * by Impulz@SL
 */

inherit "std/npc";
inherit "std/npc/spells";
#include <properties.h>
#include <moredef.h>
#define level 13

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Ein Grauwolf");
  SetProp(P_LONG,
    "Der Grauwolf hat ein auffallend helles graues Fell, was ihm eine "
    "Art von Wuerde und Weisheit verleiht. Allerdings kann er sich "
    "scheinbar blitzschnell bewegen und fuerchtet sich vor nichts und "
    "niemandem.");
  SetProp(P_NAME,"Grauwolf");
  create_default_npc(level);
  SetProp(P_GENDER,MALE);
  SetProp(P_SIZE,80+random(20));
  SetProp(P_HANDS,({" mit seinen Klauen",QueryProp(P_HANDS)[1]}));
  SetProp(P_ALIGN,-500);
  AddId("grauwolf");
  AddId("wolf");
  SetProp(P_SPELLRATE,10);

  AddDefaultSpell(1,QueryProp(P_HANDS)[1]*2,DS_REDUCE_AC,
                  "Der Grauwolf beisst sich in deiner Ruestung fest.\n",
                  "Der Grauwolf beisst sich in @WESSEN Ruestung fest.\n");
}