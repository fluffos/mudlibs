inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Rune");
  SetProp(P_LONG, 
    "Dieses kurze Holzschwert wurde von Sennah in jungen Jahren geschnitzt. "
    "Schon frueh uebte er sich im Schwertkampf, um als Paladinschueler "
    "aufgenommen zu werden." );
  
  SetProp(P_NAME, "Rune");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"rune", "holzrune", "ademion", "\nHEIMDALLSRUNE"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, -1);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":0, "Schwertexperte":0, "Schwertmeister":0]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_TROPICAL_WOOD:100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1);
  SetProp(P_SIZE, 75);
  SetProp(P_QUALITY_DECAY, 75);
 
  AddDetail( ({"holz", "maserung"}),
    "Das Holz ist sehr hart und schaut sehr exotisch aus. Die dunkle "
    "Maserung verlaeuft genau parallel zur Schneide.");
}

