//buzzoms special seil
#include "../def.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <verben.h>
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"seil","buzseil"}));
 SetProp(P_NAME,"Seil" );
 SetProp(P_NAME_ADJ, "lang");
 SetProp(P_GENDER, NEUTER);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein langes Seil" );
 SetProp(P_LONG,BS(
"Dieses Seil ist besonders lang und stark. Ideal zum klettern..."));
 SetProp(P_VALUE,10);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_COTTON: 100]));
 SP(P_NOBUY, 1);

}