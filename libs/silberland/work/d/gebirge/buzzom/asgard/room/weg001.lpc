inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Gebirgspfad" );
  SetProp( P_INT_LONG,
   "Du befindest Dich auf einem schmalen, steinigen Gebirgspfad. Rings um "
   "Dich tuermen sich die riesigen Felsmassen des Gebirges auf. Die Landschaft "
   "hier ist karg, felsig und unfreundlich. Links und rechts von Dir wachsen "
   "einige verkrueppelte Baeume und Straeucher aus dem Felsboden heraus. Es "
   "liegen einige Felsbrocken am Weg, die das Vorankommen erschweren. Der Boden "
   "ist noch spaerlich mit etwas Gras bewachsen und es blaehst ein kuehler Wind "
   "um Deine Ohren. "
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN: TT_MOUNTAIN]) );
  
  
  AddDetail( "fels",
             "In dieser Gegend hier ist so ziemlich alles aus Fels.");
  AddDetail( "weg",
             "Der Weg ist sehr steinig und das Vorankommen ist gar nicht so einfach.");
  AddDetail( "vorankommen",
             "Es ist ziemlich muehselig, sich zwischen den Felsbrocken durchzukaempfen.");
  AddDetail( ({"felsbrocken", "brocken"}),
             "Rings um Dich liegen einige grosse Felsbrocken herum, die Dir das "
            +"Vorankommen erschweren.");
  AddDetail( "wind",
             "Dir blaest ein kuehler Wind um die Ohren.");
  AddDetail( "ohren",
             "Deine Ohren sind schon ganz rot vom Wind.");
  AddDetail( ({"felslandschaft", "landschaft"}),
             "Die Landschaft hier ist nur spaerlich bewachsen. Links und rechts von Dir "
            +"siehst Du ein paar verkrueppelte Baeume und Straeucher.");
  AddDetail( ({"baum", "baeume"}),
             "Den Weg entlang siehst Du noch einige Baeume. Irgendwie sehen sie "
            +"unheimlich aus mit ihren verkrueppelten Aesten.");
  AddDetail( ({"aeste", "aesten"}),
             "Die verkrueppelten Aeste erwecken fast den Eindruck, als wuerden sie "
            +"nach Dir greifen.");
  AddDetail( ({"graeser", "gras"}),
             "Der Boden ist nur mehr spaerlich mit etwas Gras bewachsen.");
  AddDetail( ({"straeucher", "buesche"}),     //wichtiges detail fuer quest
             "Einige verdoerrte Buesche stehen noch vereinzelt herum. "
            +"Ein etwas groesserer Busch faellt Dir besonders auf.");
  AddDetail( ({"busch", "grossen busch"}),     //wichtiges detail fuer quest
             "Der Busch steht genau vor einer Felswand. Vielleicht kann man "
            +"den Busch beiseite treten.");
  AddDetail( ({"wand", "felswand"}),     
             "Da der Busch genau davor steht, kannst Du noch nicht viel erkennen. ");
  AddDetail( ({"massen", "felsmassen"}),
             "Die riesigen Felsmassen des Gebirges lassen Dich ehrfuerchtig die "
            +"wilde Natur hier bewundern.");
  AddDetail( "gebirge",
             "Da befindest Du Dich gerade.");
  AddDetail( ({"natur", "naturgewalten", "gewalten"}),
             "Die Naturgewalten hier sind beinahe schon furchteinfloessend.");
  AddDetail( ({"boden", "felsboden"}),
             "Der Boden ist steinig und felsig. Nur selten sieht man etwas Gras "
            +"hervorspriessen.");
  AddDetail( "himmel",
             "Abgesehen von vereinzelten Wolken ist der Himmel recht blau.");
  AddDetail( ({ "wolke", "wolken", "tiere" }),
   "Die Wolken ziehen langsam nach WestenIn deiner Fantasie sehen die Wolken aus wie Tiere."
   );
  
   AddExit( "nordwesten", "./room001" );

   AddCmd(({"trete", "tritt"}), "treten");
}

int treten(string str)
{
  notify_fail("Was willst Du beiseite treten?\n");
  if(!str) return 0;
  if(str!="busch beiseite") return 0;
  write("Du trittst den Busch beiseite und entdeckst dahinter eine kleine\n"
        "Hoehle in die Du hinein kriechst.\n");
  TP->move("/d/gebirge/buzzom/asgard/room/hoehle.lpc", M_GO, "in eine Hoehle", "kriecht",
     "kommt herein gekrochen");
  return 1;
}