/* Felsvorsprung by Buzzom@Silberland '2000 */
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung" );
  SetProp( P_INT_LONG,
   "Du stehst hier auf einem kleinem Felsvorsprung. Ein falscher Schritt und "
   "Du faellst in die Tiefe der Schlucht. Ausser ein paar Felsbrocken hast Du "
   "nichts, woran Du Dich festhalten koenntest. Auch von hier aus kannst du "
   "nicht das Ende der Schlucht erkennen."
   );
	
   SetProp(P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN: TT_MOUNTAIN]) );	
   AddDetail( ({ "felsvorsprung", "vorsprung" }),
   "Dieser Vorsprung ragt mitten in die Schlucht. Ausser ein paar Felsbrocken ist hier "
   "nicht viel zu erkennen."
   );
   AddDetail( ({ "felsbrocken", "fels", "brocken", "felsen" }),
   "Auch diese Felsen sind aus Granit und Basalt. Viele Risse und Spalten zeugen von "
   "einer starken Verwitterung."
   );
   AddDetail( ({ "spalten", "spalte" }),
   "Hmmm, vielleicht ist die Rune dort hineingefallen."
   );
   AddDetail( ({ "risse", "riss" }),
   "Diese Risse sind wahrscheinlich durch starke Erosionen entstanden. "
   );
   AddDetail( ({ "erosionen", "erosion" }),
   "Manchmal kommt es hier zu starken Erdbeben. Hoffentlich wirst du nicht Zeuge "
   "dieses Naturereignisses."
   );
   AddDetail( "bruecke",
   "Man kann die Bruecke in gut erkennen. Sie spannt sich ueber die riesige Schlucht."
   );
   AddDetail( ({ "schlucht", "gebirgsschlucht", "tiefe" }),
   "Anscheinend hat diese Schlucht kein Ende. Du willst es aber auch nicht unbedingt "
   "herausfinden."
   );
   AddDetail( "ende",
   "Du siehst immer noch keines."
   );
   AddDetail( "seil",
   "Das Seil haengt am Rand der Schlucht herab. Es ist die einzige Moeglichkeit "
   "hier wieder wegzukommen."
   );
   AddDetail( "rand",
   "Da haengt das Seil, was Du vorhin hinunter geworfen hast."
   );
   AddDetail( "boden",
   "Am Boden liegen nur einige Felsen. "
   );
   AddDetail( "himmel",
   "Abgesehen von vereinzelten Wolken ist der Himmel recht klar."
   );
   AddDetail( ({ "wolke", "wolken", "tiere" }),
   "In deiner Fantasie sehen die Wolken aus wie Tiere."
   );
   
   AddCmd( ({"greif","greife"})        , "greifen");
   AddCmd(({"kletter", "klettere"}), "schluchtkletter");
  
}


int greifen(string str)
{
  object rune;

  notify_fail("Wo rein willst greifen?\n");

  if(-1 == member(({"in spalte"}),str))
  {
    return 0;
  }
  
  
  if(deep_present("\nHEIMDALLSRUNE", TP)) 
  {
  TELLPLAYER("Ausser kleine Steine findest Du nichts.\n");
  return 1;
  }
  
  
  TELLPLAYER(BS("Du greifst in die Spalte und findest tatsaechlich "
                "eine hoelzerne Rune."));
  {
   if(!rune=clone_object("/d/gebirge/buzzom/asgard/obj/rune.lpc"))
    {
      TELLPLAYER("Es bugt!!! Magier Buzzom verstaendigen\n");
      return 0;
    }

    {
      TELLPLAYER("Du steckst sie gleich ein, bevor sie wieder verloren geht.\n");
    }
    {
    	 rune->move(this_player(), M_NOCHECK);
    }
  }
  
  return 1;
}

int schluchtkletter(string str)
{
  notify_fail("Woran moechtest Du hinauf klettern?\n");
  if(!str) return 0;
  if(str!="an seil hinauf" && str!="an seil rauf") return 0;
  write("Du nimmst das Seil und kletterst wieder an der Schlucht hinauf.\n");
  TP->move("/d/gebirge/buzzom/asgard/room/room001.lpc", M_GO, "am Seil hinauf", "klettert",
     "kommt am Rand der Schlucht hochgeklettert");
  return 1;
}