inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

int seil_unten=0;    //das hier sind die variablen die wir wenn seil da usw auf 1 setzen!!!
int seil_angebunden=0;//und dann in der kletterfunkt usw brauchen...!!!
string wer="";



init()   {
     ::init();
     if(interactive(TP))  {
     call_out("check_seil", 1+random(2));
                           }
          }


       
       check_seil()   {
               int i;
               object *inv;
               inv=all_inventory(TP);
          
       if(TO!=environment(TP)) return;

  if(!sizeof(inv))  return;
    for(i=0;i<sizeof(inv); i++)  {

   if(inv[i]->id("seil") && !inv[i]->id("buzseil") )  {
   inv[i]->remove();
   write(BS(
   "Ein grosser, schwarze Geier taucht wie aus dem Nichts auf und "
   "stuerzt sich ploetzlich auf Dich! "
   "Du versuchst Ihn abzuwehren und fuchtelst dabei wild mit den "
   "Armen in der Luft herum. Gerade als der Geier zuschnappen will, "
   "steckst Du ihm Dein Seil in den Rachen und versteckst Dich "
   "schnell hinter einem Felsen. "
   "Nach einer Weile traust Du Dich erst wieder hervor..." ));
               }      
           }
      }
           




create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer Bruecke" );
  SetProp( P_INT_LONG,
   "Hier endet der Gebirgspfad. Im Norden erkennst Du, wie sich eine gigantische "
   "Bruecke ueber eine Schlucht spannt. Am Rand der Schlucht entdeckst Du eine alte "
   "Eiche. Links und Rechts von Dir erheben sich noch immer gewaltige Gebirgsmassive, "
   "die unueberwindlich zu sein scheinen. Der Wind weht hier so stark, dass du "
   "aufpassen musst nicht in die Schlucht zu fallen. " 
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN: TT_MOUNTAIN]) );
  
  	
   AddDetail( ({ "gebirgspfad", "pfad", "weg" }),
   "Ein ganz gewoehnlicher Gebirgspfad aus Granit und Basalt."
   );
   AddDetail( ({ "granit", "basalt", "brocken", "felsen" }),
   "Diese Granit und Basalt Brocken geben dem Gebirge eine gewalte Erscheinung."
   );
   AddDetail( ({ "eiche", "baum" }),
   "Diese alte Eiche waechst unmittelbar neben der Schlucht. Durch die wenigen "
   "Blaetter wirkt sie recht kahl. Vielleicht kann Heimdall Dir was ueber die "
   "alte Eiche erzaehlen. "
   );
   AddDetail( ({ "blatt", "blaetter" }),
   "Ein paar typische Eichenblaetter schmuecken den Baum. Die meisten sind aber "
   "durch das raue Gebirgsklima abgestorben."
   );
   AddDetail( ({ "klima", "gebirgsklima" }),
   "Das Klime im Gebirge ist rau und hart. Dadurch haben besonders Pflanzen "
   "Nachteile im Wachstum."
   );
   AddDetail( ({ "wind", "boehe" }),
   "Du musst aufpassen, dass du nicht von einer Boehe mitgerissen wirst."
   );
   AddDetail( ({ "pflanze", "pflanzen" }),
   "Ausser einer Eiche erkennst du nur ein paar Graeser und Moose die den Weg saeumen."
   );
   AddDetail( ({ "gras", "graeser", "moos", "moose" }),
   "Diese Graeser und Moose saeumen den ansonsten kahlen Gebirgspfad. "
   "Du kannst aber nichts wichtiges daran erkennen."
   );
   AddDetail( "erscheinung",
   "Solch eine imposante Erscheinung findet man nur im Gebirge."
   );
   AddDetail( "bruecke",
   "Es ist eine riesige hoelzerne Bruecke, die ueber eine gewaltige "
   "Gebirgsschlucht fuehrt."
   );
   AddDetail( ({ "schlucht", "gebirgsschlucht" }),
   "Du gehst vorsichtig an den Rand der Schlucht, kannst aber kein Ende in der "
   "Tiefe erkennen."
   );
   AddDetail( "ende",
   "Du siehst keins."
   );
   AddDetail( "rand",
   "Du solltest besser vorsichtig sein!"
   );
   AddDetail( "tiefe",
   "Du wirfst einen Stein hinab und wartest auf ein Geraeusch."
   );
   AddDetail( ({ "stein", "steine" }),
   "Viele verschiedene Steine saeumen den Pfad."
   );
   AddDetail( ({ "links", "rechts" }),
   "Links und Rechts des Pfades steigen steile Gebirgsmassive an."
   );
   AddDetail( ({ "gebirgsmassiv", "massiv", "gebirgsmassive", "massive" }),
   "Das ganze Gebirge ist ein einziges Massiv. Zum Glueck gibt es viele Pfade, "
   "die das Durchwandern erleichtern."
   );
   AddDetail( "boden",
   "Du siehst einen steinigen Gebirgspfad."
   );
   AddDetail( "gebirge",
   "Du bist hier mitten im Gebirge."
   );
   AddDetail( "himmel",
   "Abgesehen von vereinzelten Wolken ist der Himmel recht klar."
   );
   AddDetail( ({ "wolke", "wolken", "tiere" }),
   "In deiner Fantasie sehen die Wolken aus wie Tiere."
   );

   AddItem("/d/gebirge/buzzom/asgard/npc/heimdall" , REFRESH_DESTRUCT);

   //AddItem("/players/buzzom/asgard/obj/eiche" , REFRESH_REMOVE);
    //eiche brauchen wir nicht..kostet speicher ein eigenes objekt!
       
   AddExit( "norden", "./room002" );
   AddExit( "suedosten", "./weg001" );
   
   AddCmd( ({ "kletter","klettere" }) , "kletterfkt" );
   AddCmd( ({ "wirf","werfe","werf" }) , "wirffkt" );
   
   AddCmd(({"binde"}), "bindefkt"); //anbinden bzw abbinden!!!
   
   
AddSpecialDetail("eiche", "eiche_det");
AddSpecialDetail("baum", "eiche_det");
AddSpecialDetail("seil", "seil_det");
}

int bindefkt(string str)  {
     object seil, neues_seil;
     
     seil=present("buzseil", TP);
     NF("Was willst Du wo anbinden! Oder abbinden?\n");
     
     if(str=="seil an eiche" || str=="seil an baum")  {
  
     
     if(!present("seil", TP))  {
       write(BS(
          "Du hast gar kein Seil!"));
           return 1; }
      
      
          if(!present("buzseil", TP))  {
             write(BS(
           "Du hast zwar ein Seil, aber Du brauchst ein ganz spezielles dafuer!"));
           return 1; }
          
           
          if(seil_angebunden)  {
          write(BS(
          "Da ist bereits ein Seil an der Eiche angebunden!"));
          return 1; }
          
         
          
         if(!seil_angebunden)  {
          
          write(BS(
          "Du bindest das Seil an der Eiche fest!"));
          seil->remove();
          seil_angebunden=1;
          wer=CAP(getuid(TP));
          return 1; }
          
         return 0; }
         
    //abbinden!!
    
    if(str=="seil ab" || str=="seil vom baum" || str=="seil von eiche")  {
    
     if(!seil_angebunden)  {
      write(BS(
      "Da ist kein Seil zum abbinden!"));
      return 1; }
      
      if(seil_angebunden)  { //hier wuerds ein else oder auch gar nix auch tun...
           seil_angebunden=0;
          seil_unten=0;
           write(BS(
           "Du bindest das Seil von der Eiche ab!"));
           neues_seil=clone_object("/d/gebirge/buzzom/asgard/obj/buzseil");
           neues_seil->move(TP, M_NOCHECK);
                  
                  return 1; }
     
             return 0; }
           
         
       return 0; }
          
           
           

string seil_det()  {

     if(!seil_angebunden)  {
     return BS(
     "Da ist kein Seil an der Eiche!");  }
     
     if(seil_angebunden)  {
      
       if(!seil_unten)  {
        return BS(
        "Da wurde von "+wer+" ein Seil an der Eiche angebunden.");  }
        
        if(seil_unten)  {
        return BS(
        "Das Seil, das "+wer+" an die Eiche angebunden hat, haengt nach unten in die Schlucht!"); }
        
        }
   return "";
       }
        


string eiche_det()  {
 
 if( seil_angebunden)  {
  
  if(seil_unten)  {
  
    return BS(
     "Das ist eine Eiche. Da ist ein Seil angebunden. Das andere "
     "Ende des Seils wurde in die Schlucht geworfen. Man kann damit "
     "runter klettern. Das Seil wurde von "+wer+" angebunden!");    
       }
       
       
if(!seil_unten)  {
  
     return BS(
     "Das ist eine Eiche. Da wurde von "+wer+" ein Seil angebunden.");  }   
          }

 if(!seil_angebunden)  {
  return BS(
   "Diese alte Eiche waechst unmittelbar neben der Schlucht. Durch die wenigen "
   "Blaetter wirkt sie recht kahl. Vielleicht kann Heimdall Dir was ueber die "
   "alte Eiche erzaehlen. "); 
  } 
return "";

   }
  
  
  
  reset()  {
       ::reset();
      
      
       if(seil_angebunden)  {
       tell_room("/d/gebirge/buzzom/asgard/room/room001",
        BS(
       "Ein starker Windstoss reisst heftig am Baum und das Seil fliegt davon."));
       seil_unten=0;
       seil_angebunden=0;  
       }
     } 
      
      //das hat den sinn, dass das seil nicht ewig da ist sondern eben jeden reset
      //weg ist
  
  


int wirffkt(string str)  {
    object seil, fseil;
    
    seil=present("buzseil", TP);
    fseil=present("seil", TP);
    
    NF("Was willst Du in die Schlucht werfen?!\n");
    
    if (str=="seil in schlucht" || str=="seil nach unten" || str=="seil in schlucht hinab" || str=="seil in schlucht hinunter")  {
    
    
    if( (!present("seil", TP))&&(!seil_angebunden))  {

    //d.h.: der pl hat kein seil und es ist auch keines angebunden!!!
    write(BS(
    "Du hast gar kein Seil und auch am Baum ist keines angebunden!"));
    return 1; }
    
    
    if( !seil_angebunden)  {

//d.h.: er besitzt ein seil, aber das ist nicht angebunden und ergo wirft
//er es in die schlucht runter!!!

    write(BS(
   "Du Narr wirfst das Seil in die Schlucht runter!"));
   seil->move("/d/gebirge/buzzom/asgard/room/vorsprung", M_NOCHECK);
   say(BS(
   CAP_TPN+" wirft ein Seil in den Abgrund hinunter!"));
   //wir moven also das seil echt nach unten!!!
   
    return 1;  }   

  if( (seil) && (seil_angebunden) )   {
  // er hat eines angebunden besitzt aber ein zweites!!! nur ne theorie:-))
  
  write(BS(
  "Du wirfst das angebundene Seil nach unten!"));
  seil_unten=1;
   }
  
  
   
   if(seil_angebunden)  {

    if(seil_unten)  {
    write(BS(
    "Das Seil wurde bereits nach unten geworfen!"));
    return 1; }
    
    if(!seil_unten)  {
   
   write(BS(
   "Du wirfst das Seil nach unten! "
   "Schlau wie Du bist hast Du es vorher um die Eiche gebunden!"));
   seil_unten=1; 
   //rauf setzen weil ja nun das seil runtergeworfen wurde!!!
   return 1;            }
   
           return 0;
         }
      return 0;
  }
return 0; }
  
   


int kletterfkt(string str) {

  object seil;
  seil=present("buzseil", TP);
  notify_fail("Woran moechtest Du hinunter klettern?\n");
  if(!str) return 0;

if(str=="an seil hinab" || str=="an seil hinunter" || str=="an seil runter")  { // && heisst und   || ist oder!!!!!!!





if( ( seil ) &&(!seil_angebunden)) {
   write(BS(
   "Vielleicht solltest Du Dein Seil erst irgendwo anbinden!"));
   return 1; }
   
  if(!seil_angebunden) {
    write(BS(
    "Du kannst so einfach nicht nach unten klettern! Hmm ein Seil waere gut!"));
    return 1;
  }
  
   
if(seil_angebunden)  {

     if(seil_unten)  {

  write(BS(
    "Vorsichtig und mit grosser Angst kletterst Du in die Schlucht hinab."));
  TP->move("/d/gebirge/buzzom/asgard/room/vorsprung.lpc" , M_GO,  
    "klettert in die Schlucht hinab",
    "kommt am Seil herunter geklettert");
  return 1;
       }
 
 
 if(!seil_unten)  {
 
 
  write(BS(
    "Vielleicht solltest Du erstmal das Seil in die Schlucht hinab werfen!"));
          return 1;
          }
   
     return 0;  }
     
   return 0; }
     
return 0; }
