inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer riesigen Bruecke" );
  SetProp( P_INT_LONG,
   "Du stehst jetzt mitten auf einer riesigen Bruecke. Zum Glueck gibt es ein "
   "Gelaender, dass Dich vor einem Fehltritt bewahren koennte. Dennoch ist Dir "
   "etwas mulmig im Bauch, denn durch den starken Wind vibriert die Bruecke ein "
   "wenig. Noerdlich der Bruecke kannst Du einen dichten Nadelwald erkennen, der "
   "durch seine riesigen Tannen schon von hier sichtbar ist." 
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN: TT_MOUNTAIN]) );
	
   AddDetail( "bruecke",
   "Die Bruecke wurde vor Aeonen aus solidem Dir unbekannten Holz erbaut. Es gibt "
   "aber keine sichtbaren Hinweise auf die Erbauer dieser einzigartigen Konstruktion."
   );
   AddDetail( "holz",
   "Dieses Holz ist sehr stabil. Es eignet sich besonders zum Bau von grossen Konstruktionen."
   );
   AddDetail( ({ "hinweis", "hinweise", "erbauer" }),
   "Vielleicht kann Heimdall dir mehr ueber die Erbauer dieser Bruecke erzaehlen."
   );
   AddDetail( ({ "wald", "nadelwald", "tannen" }),
   "Ausser ein paar hochragenden Tannen kannst Du noch nicht viel erkennen."
   );
   AddDetail( "konstruktion",
   "Du bist beeindruckt von der Konstruktion dieser Bruecke."
   );
   AddDetail( "glueck",
   "Hoffentlich hast Du Glueck und stuerzt nicht in die Tiefe."
   );
   AddDetail( "gelaender",
   "Das Gelaender sieht recht stabil aus. Hoffentlich haelt es im Notfall."
   );
   AddDetail( "fehltritt",
   "Sowas geht schneller als man glaubt."
   );
   AddDetail( "bauch",
   "Du solltest nicht soviel Bier trinken, denn dann kannst Du bald den Boden nicht mehr "
   "erkennen."
   );
   AddDetail( "wind",
   "Es ist recht stuermisch hier. Sei besser vorsichtig beim Ueberqueren der Bruecke."
   );
   AddDetail( ({ "schlucht", "gebirgsschlucht" }),
   "Du befindest Dich direkt ueber ihr. Ohne diese Bruecke koennte man nie das andere "
   "Ende erreichen."
   );
   AddDetail( "ende",
   "Du kannst das andere Ende der Bruecke schon ein wenig erkennen."
   );
   AddDetail( "rand",
   "Du solltest besser vorsichtig sein!\n"
   );
   AddDetail( "tiefe",
   "Bei einem Sturz in die Tiefe bist Du mit Sicherheit tot."
   );
   AddDetail( ({ "links", "rechts" }),
   "Links und Rechts siehst Du nichts, ausser diese gigantische Schlucht."
   );
   AddDetail( ({ "boden", "weg", "pfad" }),
   "Der Boden der Bruecke besteht aus vielen Bohlen, die das Ueberqueren erst moeglich "
   "machen."
   );
   AddDetail( ({ "bohlen", "bohle" }),
   "Diese Bohlen sind sehr massiv und sind mit der Bruecke geschickt verbunden."
   );
   AddDetail( "gebirge",
   "Das Gebirge liegt nun hinter Dir."
   );
   AddDetail( "himmel",
   "Abgesehen von vereinzelten Wolken ist der Himmel recht klar.\n"
   );
   AddDetail( ({ "wolke", "wolken" }),
   "Manche sind grau, andere wiederum weiss."
   );
   AddExit( "norden", "./room003" );
   AddExit( "sueden", "./room001" );
}