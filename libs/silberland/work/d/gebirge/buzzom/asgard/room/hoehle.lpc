inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine kleine Hoehle" );
  SetProp( P_INT_LONG,
   "Jetzt stehst Du in einer kleinen Hoehle, die durch den Busch von aussen so "
   "gar nicht sichtbar war. Deine Fackel erhellt den Raum ein weing. Ausser den "
   "zerklueffteten Felswaenden und den schroffen Granitboden gibt es hier nicht "
   "viel zu sehen. In einer Ecke entdeckst Du Ueberreste einer Leiche, die "
   "wohl schon seit einigen Jahren hier zu liegen scheint. "
   );
	
   SetProp(P_LIGHT, 0 );
   SetProp(P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:8, ENV_TERRAIN: TT_MOUNTAIN]) );
 
   
   AddDetail( ({ "raum", "hoehle", "ort" }), 
    "Du bist richtig stolz auf Dich, diese Hoehle entdeckt zu haben. " 
    "Ausser den Ueberresten einer Leiche kannst Du aber nicht viel entdecken." );
    
   AddDetail( ({ "reste", "ueberreste", "leiche" }), 
    "Diese Leiche vermodert hier anscheinend schon seit einigen Jahren. "
    "Wahrscheinlich war dies der Kraxelzwerg von dem Heimdall gesprochen hat."
    "Eventuell hat sie ja noch diverse Gegenstaende bei sich. " );
   
   AddDetail( ({ "busch", "eingang" }), 
    "Der Busch steht genau vor dem Eingang der Hoehle. Dadurch ist diese Hoehle "
    "ein gutes Versteck fuer jeden Wanderer und Abenteurer. " );
    
   AddDetail( ({ "wand", "waende", "felswand", "felswaende" }), 
    "Die Waende der Hoehle sind stark zerkluefftet. Ein paar Moose wachsen in der "
    "Naehe des Einganges. Ansonsten oeden Dich die Waende durch ihre Monotonie an. ");
    
   AddDetail( ({ "boden" }), 
    "Der Boden besteht wie die Waende aus Granit. Auch hier wachsen einige Moose in "
    "der Naehe des Einganges. Du glaubst hier nicht interessantes zu finden. ");
    
   AddDetail( ({ "ecke" }), 
    "Hier liegen die Ueberreste der Leiche. Du glaubst sie naeher untersuchen zu "
    "muessen. " );
   
   AddDetail( ({ "decke" }), 
    "Die Decke laed zur gleichen rauen Monotonie ein, wie die Waende dieser Hoehle.");
   
   AddDetail( ({ "gegenstand", "gegenstaende" }), 
    "So kannst Du keine erkennen. Ob man die Leiche einfach mal durchwuehlen sollte? ");
   
   AddDetail( ({ "granit" }), 
    "Granit ist einer der haertesten Materialien im Gebirge.");
    
   AddCmd( ({"durchwuehle"})        , "wuehlen"); 
    
   AddExit( "raus", "./weg001" );
    
  
}


int wuehlen(string str)
{
  object buzseil;

  notify_fail("Was willst Du durchwuehlen?\n");

  if(-1 == member(({"leiche"}),str))
  {
    return 0;
  }
  
  
  if(deep_present("buzseil", TP)) 
  {
  TELLPLAYER("Da scheint wohl doch nichts mehr zu finden sein.\n");
  return 1;
  }
  
  
  TELLPLAYER(BS("Du wuehlst in der Leiche und findest ein langes Kletterseil, "
                "welches Du zu Deinen anderen Sachen legst."));
  {
   if(!buzseil=clone_object("/d/gebirge/buzzom/asgard/obj/buzseil.lpc"))
    {
      TELLPLAYER("Es bugt!!! Magier Buzzom verstaendigen\n");
      return 0;
    }
    
    
    {
    	 buzseil->move(this_player(), M_NOCHECK);
    }
  }
  
  return 1;
}