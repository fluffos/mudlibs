
inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP

create()
{
/* Das naechste Konstrukt verhindert eine Konfiguration der Blueprint 
     --> man spart Speicher */
  if (!is_clone(this_object())) return;

  ::create();       /* WICHTIG!!! */
  
/* Standard-Knofiguration (Erlaeuterungen siehe bspmon1.c): */
  SetProp(P_SHORT, "Brueckenwaechter Heimdall");
  SetProp(P_LONG, "Heimdall ist der Waechter der Bruecke. Er ist einer der mutigsten "
  		  "und tugendhaftesten Paladine des Asenreiches. Viele Orden schmuecken "
  		  "seine Ruestung und deuten darauf hin, dass er von seinen Vorgesetzten "
  		  "schon oft fuer seine Leistung ausgezeichnet wurde."
  );
  SetProp(P_NAME, "Brueckenwaechter");
  SetProp(P_KILL_NAME "Heimdall");
  SetProp(P_GENDER, MALE);
  AddId(({"brueckenwache", "wache", "ase", "brueckenwaechter",
          "waechter", "heimdall", "paladin"}));
  create_default_npc(35);
  SetProp(P_ALIGN, 1000);   /* er hat einen heiligen charakter*/
  SetProp(P_BODY, 125);
  SetProp(P_RACE, "Ase");
  SetProp(P_XP,800000);
  SetProp(P_SIZE, 250+random(40));
  SetProp(P_HANDS, ({" mit seinen starken Haenden", 300}) );
  SetProp(P_MAX_HANDS, 2);  /* Anzahl der Haende (default ist 2) */
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.7, 
      DT_LIGHTNING: -0.8, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.7, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:      -0.9, DT_UNHOLY:    -0.9, DT_MAGIC:  -0.9 ]) );
  SetProp(P_NOMAGIC,20);
  
  set_living_name("heimdall");

  SetProp(P_MSGIN, "kommt an und beginnt seine Wache");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " verflucht Dich und stirbt.");

/* Ein Objekt kann nur andere Objekte clonen, wenn es eine euid != 0 hat. */
/* Deshalb wird die euid auf die uid gesetzt (normalerweise, der Name     */
/* des wizards, aus dessen directory das Objekt stammt.                   */
  seteuid(getuid(this_object()));

/* Nun clonen wir eine Waffe, bewegen sie ins inventory  und zuecken sie */
  clone_object("/d/gebirge/buzzom/asgard/weapon/kriegshammer")->move(this_object());
  command("zuecke hammer");

/* Das selbe Spielchen mit einer Ruestung */
  clone_object("/d/gebirge/buzzom/asgard/armour/mithrilpanzer")->move(this_object());
  command("trage panzer");
/* Details des Waechters */

AddDetail( "orden",
   "Viele goldene Orden sind an der Ruestung befestigt. Heimdall ist sehr stolz darauf."
   );
AddDetail( "ruestung",
   "detail wird erst fertig wenn spezielle ruestung fertig."
   );
/* Reden kann der Zauberer auch von alleine, hier kommen die chats:     */

/* Das erste Argument ist die Wahrscheinlichkeit, mit der das Monster   */
/* einen Spruch bringt. Das zweite Argument ist die Liste der Sprueche  */
/* (oder Aktionen).                                                     */

  SetChats(10, ({
  "Der Brueckenwaechter patrouilliert entlang der Bruecke.\n",
  "Der Brueckenwaechter mustert Dich.\n",
  "Der Brueckenwaechter sagt: Heh Du! Was machst Du da?\n",
  "Der Brueckenwaechter ueberprueft seine Ausruestung.\n",
  "Der Brueckenwaechter fragt: Hast du meine Schutzrune gesehen?\n",
  "Der Brueckenwaechter sagt: Nur mutige Krieger und Seher lasse ich durch.\n",
   }) );

/* Das selbe fuer Sprueche die waehrend eines Kampfes kommen sollen    */

  SetAttackChats(30, ({
  "Der Brueckenwaechter fragt: Du glaubst doch nicht im ernst, mich besiegen zu koennen?\n",
  "Der Brueckenwaechter lacht ueber Deine Kampfkunst.\n",
  "Der Brueckenwaechter sagt: Du bist ein Wurm!\n",
  "Der Brueckenwaechter findet Diesen Kampf langweilig.\n",
  "Der Brueckenwaechter sagt: Du bist keine Herausforderung fuer mich.\n",
  }) );

 
/* Nun wollen wir den Zauberer noch auf ein paar Fragen antworten lassen  */
/* SetProp(P_DEFAULT_INFO,) setzt die Antwort auf alle Fragen, wo der Schluessel  */
/* nicht bekannt ist. Der Name des Zauberers wird immer vor den String    */
/* gesetzt.                                                               */
  SetProp(P_DEFAULT_INFO,"sagt: Keine Ahnung, von was Du redest.");

/* Die bekannten Schluessel werden mit AddInfo dazugefuegt, das erste       */
/* Argument ist das Wort (oder die Liste von Woertern), zu der der Zauberer */
/* befragt werden kann, das zweite Argument ist die entsprechende Antwort.  */
  AddInfo("bruecke",
  "sagt: Diese Bruecke fuehrt ins Asenreich.");
  
  AddInfo("seil",
  "Ich habe kein Seil. Du musst Dir schon selber "
  +"eines besorgen. ", "sagt: ");
  
  AddInfo(({"kletterseil", "kraxelseil"}),
  "Da musst Du schon den Kraxelzwerg finden! ", "sagt: ");
  
  AddInfo("gebirge",
  "Das Gebirge ist hier rings um uns herum. Es birgt viele "
  +"Geheimnisse in sich. ", "sagt: ");
  
  AddInfo(({"geier", "vogel"}),
  "Da hast Du ja nochmal Glueck gehabt! Das Seil bist Du "
  +"ja leider nun los! Ich erinerre mich aber, dass hier ein "
  +"Kraxelzwerg vor etlichen Jahren lebte. Vielleicht kannst "
  +"Du ja ein Kletterseil von ihm bekommen. ", "sagt: ");
  
  AddInfo(({"zwerg", "kraxelzwerg"}),
  "Ab und zu kommen hier mal Kraxelzwerge vorbei. Die lass ich "
  +"aber nicht durch und schicke sie deshalb immer wieder "
  +"zurueck. Einer lebt hier aber noch ganz in der Naehe glaube "
  +"ich. ", "sagt: ");
  
  AddInfo(({"geheimnis", "geheimnisse"}),
  "Die werde ich Dir sicher nicht erzaehlen. Ausserdem "
  +"kenne ich auch nicht alle. ", "sagt: ");
  
  AddInfo(({"tugend", "tugenden"}),
  "Mut, Ehre und Loyalitaet sind die drei Grund "
  +"Tugenden von uns Asen. Sie bilden das Fundament "
  +"unserer Gemeinschaft. ", "sagt: ");
  
  AddInfo(({"asen", "ase"}),
  "Das sind wir, die Ritter der Tugenden. ", "sagt: ");
  
  AddInfo("schlucht",
  "Die Schlucht trennt Asgard vom Rest der Welt. Nur "
  +"durch sie koennen wir Asen ungestoert von fremden "
  +"Einfluessen leben. Leider habe ich dort aber auch "
  +"meine Schutzrune verloren. Vielleicht kannst Du "
  +"mir helfen!?", "sagt: ");
  
  AddInfo("tiefe",
  "Soweit ich weiss, gibt es kein Ende. Aber ich weiss "
  +"das auch nicht so genau.", "sagt: ");
  
  AddInfo("klettern",
  "Versuch in die Schlucht hinab zu klettern. Sicher wirst "
  +"Du dort die Rune finden!", "sagt: ");
  
  AddInfo(({"baum", "eiche"}),
  "Vielleicht kann man an ihr ein Seil befestigen, um in die Schlucht "
  +"hinunter klettern zu koennen?! Aber darauf bist Du sicher schon "
  +"allein gekommen! ", "sagt: ");
  
  AddInfo("orden",
  "Sind es nicht prachtvolle Stuecke? Ich bin so stolz darauf.", "sagt: ");
  
  AddInfo("erbauer",
  "sagt: Unsere Vorfahren haben diese Bruecke erbaut.");
  
  AddInfo("buzzom",
  "sagt: Buzzom ist der Profos des Asgard Gebietes. Er ist fuer die Balance dort zustaendig.");
  
  AddInfo(({"asenreich", "reich",  "asgard"}),
  "Asgard ist das Reich Odgords. Nur mutige Krieger und "
  +"Seher sind dort willkommen. ", "sagt: ");
  
  AddInfo("odgord",
  "sagt: Odgord ist der Herrscher unseres Reiches. Er besitzt heilige Tugenden.");
  
  AddInfo("tugenden", "Wir Asen besitzen heilige Tugenden, die uns zu Reichtum und Wohlstand "
  	     +"gebracht haben. ", "sagt: ");
  	     
  AddInfo(({"rune", "schutzrune", "mut", "hilfe"}), "Meine Schutzrune ist verschwunden. Ich habe sie vorhin bei der "
             +"Schlucht verloren. Ehe ich mich versah viel sie hinab in die Tiefe. "
             +"Ohne sie bin ich nicht mehr so mutig. Du kannst mir aber Deinen Mut "
             +"beweisen und sie mir wieder herauf holen. ", "sagt: ");
             
             
             

/* Normalerweile nehmen Monster alles was man ihnen gibt, ohne einen Ton */
/* zu sagen. Will man dort ein anderes Verhalten, so tut man das so:     */
/* Moeglich sind auch REJECT_GIVE (= zurueckgeben) REJECT_DROP (=fallen  */
/* lassen. */
  SetProp( P_REJECT, ({ REJECT_KEEP, "Der Brueckenwaechter sagt: Dankeschoen.\n" }) );

/* Mit RegisterGive kann Aktionsreihen in das Monster einbauen.      */
/* Wenn dem Monster ein Objekt gegeben wird, und die Funktion        */
/* "stabbekommen" mit diesem Objekt als Argument eine 1 zurueckgibt, */
/* so fuehre die Befehle aus. Die Zahlen sind Zeitabstaende.         */
  RegisterGive( "stabbekommen", ({
     ({ "sage Oh, ich liebe Zauberstaebe!!!!", 5 }),
     ({ "emote fuchtelt wie wild mit seinem neuen Zauberstab herum.", 5 }),
     ({ "bohreinnase", 1 })
  }) );

/* Der Zauberer kann auch zusaetzliche Verben haben (fuer sich allein sogar) */
/* Verben, die Spieler in Gegenwart des Zauberers koennen sollen, werden     */
/* mit AddCmd angemeldet. */
  add_action("nasebohren", "bohreinnase");

}

stabbekommen( obj )
{
   return obj->id("zauberstab");
}

nasebohren( str ) // str ist das, was hinter dem verb eingegeben wurde.
{
   say( "Der Zauberer bohrt mit dem Stab in seiner Nase.\n" );
   return 1; // Verb war erfolgreich.
}

catch_tell(str)
{
  sequencer::catch_tell(str);
  npc::catch_tell(str);
}

give_notify(ob)
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}
