inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"panzer","mithrilpanzer"}));
  SetProp (P_SHORT, "Ein Mithrilpanzer");
  SetProp (P_LONG,
      "Es ist ein extrem widerstandsfaehiger Panzer aus Mithril.\n");
  SetProp (P_NAME, "Mithrilpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1500);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 39);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  SetProp (P_VALUE, 4500);
  SetProp (P_QUALITY_DECAY, 250);
}
