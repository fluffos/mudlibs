int access_rights(string name, string file, int readflag, int def)
{
  string s1,s2,s3;

  if (readflag) return def;

  name=lower_case(name);
  if (file=="access_rights.lpc") return 0;
  if (sscanf(file,"%s/%s/%s",s1,s2,s3)<3) return 0;
  // tell_object(find_player("woody"), "name: "+name+", file: "+file+"\n");
  // Eros darf in Dustys Zwergen rumpfuschen ;)
  if ((name=="eros" && s1=="dusty" && s2=="zwerge") ||
     (name=="debugger" && s1=="dusty" && s2=="zwerge"))
    return 1;
}
