inherit "std/room";

include "../files.h"
include <properties.h>
include <language.h>

create()
{
  ::create();
  SetProp(P_INT_LONG, BS( 
    "Ein heller, luftiger Raum - fast leer, bis auf einen Altar an der"
   +" Nordwand. Goldenes Sonnenlicht faellt durch die offene Suedwand"
   +" auf den weissen Marmorboden unter Deinen Fuessen. Reliefe und Fresken"
   +" zieren die Waende, Darstellungen von seltsamen Wesen." ));
   
  SetProp(P_INT_SHORT, "Im weissen Raum");   
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  AddDetail(({"zaun"}),BS(
     ));
  AddDetail(({"sonne"}),BS(
    "Die Sonne strahlt golden am blauen Firmament, sie steht schon etwas tief,"
    " bald wird sie hinter dem Dach des weissen Hauses verschwinden." 
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
 
/*  
     AddSound(({}),BS(
    "Vogelgezwitscher erfuellt die sommerlich warme Luft, es klingt wie Musik"
    " in deinen Ohren."
     ));
*/
  AddExit( "sueden", ROOM("white3") );
}
