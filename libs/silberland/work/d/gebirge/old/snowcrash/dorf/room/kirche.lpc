inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Eine Kirche " );
   SetProp( P_INT_LONG,BS(
      "" ));
   AddDetail( "buch", BS(
     "Ein schwerer Waelzer, hunderte Seiten vergilbten Papiers in schwarzes"
    +" Leder gebunden." );  
   AddReadDetail( "buch", "ReadBook" );
}

string ReadBook(void)
{
return read_file(TEXT("book.txt"));
}
