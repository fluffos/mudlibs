inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Im Wald von " );
  SetProp( P_INT_LONG,BS(
    "Ganz leichter Nebel zieht ueber den weichen braunen, von abgefallenen "+
    "Tannennadeln bedecken Waldboden, zwischen den Tannen herabfallenden "+
    "Sonnenstrahlen treffen auf Deine Haut, zu schwach sind sie aber um Dich "+
    "wirklich zu waermen. Die Luft ist frisch und duftet.\n"+
    "Auf dem Weg direkt vor Dir aber, nimmst Du etwas seltsames wahr, "+
    "gaehnende, schwarze Leere, wie ein klaffendes, in die Landschaft "+
    "gerissenes Loch. Vielleicht solltest Du Dir das Mal naeher ansehen." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );

//   AddExit( "norden", ROOM( "bergX") );
//   AddExit( "sueden", ROOM( "gwald1") );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddItem(MON(""),REFRESH_DESTRUCT);
}

