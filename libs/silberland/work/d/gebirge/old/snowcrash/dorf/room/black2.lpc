inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "" );
   SetProp( P_INT_LONG,BS(
      "Rote Vorhaenge umgeben Dich von allen Seiten und schliessen Dich in"
     +" einem nahezu quadratischen Raum ein, der die gleichen"
     +" charakteristischen Merkmale aufweist, wie der Raum, aus dem Du"
     +" gerade hereingetreten bist - nur hier befindet sich eine Sitzbank"
     +" und mehrere Beleuchtungskoerper, die den Raum nicht ganz so duester"
     +" erscheinen lassen, wie den anderen. Ein kleiner Mann in einem roten"
     +" Anzug bewegt sich taenzelnd und ein wenig verzerrt wirkend durch den"
     +" Raum."
      ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON("lmfap"),REFRESH_DESTRUCT);
}

