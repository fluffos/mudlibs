inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

// hier wird die druiden gilde draus
//
 
create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im Baum der Druiden" );
   SetProp( P_INT_LONG,BS(
     "Ein Geflecht von Aesten, Zweigen und gruenen Blaettern umgibt Dich, Du"
    +" hast weniger das Gefuehl in einem toten Gebaeude zu sein als vielmehr"
    +" in einem lebendigen Wesen. Sonnenlicht durchdringt die transparenten"
    +" organischen Formen und taucht das Innere des Raumes in leuchtendes"
    +" Gruen. Ein aufdringlicher, wenn auch nicht unangenehmer Geruch steigt"
    +" Dir in die Nase, der an frisch geschnittenes Gras erinnert, nicht das"
    +" leiseste Geraeusch vermag  die Stille dieses geheiligten Ortes zu"
    +" trueben." ));

   SetProp( P_LIGHT,   1 );
   SetProp( P_INDOORS, 1 );

   AddDetail( ({ "licht"}) , BS(
      ""
     )) ;
   AddDetail( ({ "blaetter", "blattwerk" }), BS( "" ));
   AddDetail( ({ "oberflaeche"}), BS( "" ));
   AddDetail( ({ "aederchen", "strukturen }), BS( 
     "Deutlich kannst Du die Musterung duenner Aederchen in den Blaettern "+
     "erkennen, wie sie die Blattwerk durchziehen und mit Leben versorgen. "+
     "Du bildest Dir ein, in ihnen eine Fluessigkeit pulsieren zu sehen." ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   AddDetail( ({ "" }), BS( "" ));
   
//   AddSound( ({ "" }), BS( "" ));
//   AddSmell( ({ "" }), BS( "" ));

   AddExit( "unten", "hinaus aus dem Baum#"+ROOM("undertre.lpc"));
//   AddItem(MON( "alija", REFRESH_DESTRUCT);
}

