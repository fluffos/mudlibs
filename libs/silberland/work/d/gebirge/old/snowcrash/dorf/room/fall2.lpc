inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Am Wasserfall" );
   SetProp( P_INT_LONG,BS(
     "Die Luft ist erfuellt von kleinen Tropfen, die der unter Dir in die Tiefe"
    +" stuerzende Wasserfall versprueht. Du blickst hinab auf die riesigen"
    +" Mengen schnellen, weiss schaeumenden Wassers, das mit tosendem Geraeusch"
    +" hinabfaellt und sich unten in einem See sammelt. Rund um den See"
    +" gedeihen die verschiedensten Pflanzen, alle leuchten in einem saftigen"
    +" Gruen. Hier oben kannst Du auf der anderen Seite des Flusses ein grosses"
    +" hoelzernes Gebaeude erkennen." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON(""),REFRESH_DESTRUCT);
}

      "Unmengen von Wasser stuerzen nur wenige Meter vor Deinen Augen mit"
     +" berauschender Geschwindigkeit in die Tiefe. Ein nahezu einzigartig"
     +" schoenes Naturschauspiel, doch der  ohrenbetaeubende Laerm, den die"
     +" weissen rauschenden"
     +" Wassermassen verursachen, ist kaum auszuhalten.\n " ));
