inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Unten im See" );
   SetProp( P_INT_LONG,BS(
     "Tiefer, immer tiefer zieht es Dich in die eisige Kaelte des Sees hinab, "+
     "der Lichteinfall von der Seeoberflaeche wird immer schwaecher, "+
     "verblasst allmaehlich. Zuweilen treiben Stuecke Dir unbekannter "+
     "Pflanzen und seltsame wurmartige Tiere, denen es noch nie erlaubt war "
     "das Tageslicht zu sehen - blinde Kreaturen mitten in der schier "+
     "endlosen Dunkelheit." ));
     
   SetProp( P_LIGHT, 0 );
   SetProp( P_INDOORS, 1 );

//   AddExit( "", ROOM("") );

   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
//   AddSound( ({ "", "" }), BS( "" ));
//   AddSmell( ({ "", "" }), BS( "" ));
}
