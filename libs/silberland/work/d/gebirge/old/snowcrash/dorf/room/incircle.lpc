inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
//  replace_program( "/std/room" );
  ::create();

  SetProp( P_INT_SHORT, "In einem Steinkreis" );
  SetProp( P_INT_LONG,BS(
    "Ein Kreis hoher Monolithen um gibt Dich, teilweise liegen noch andere"
   +" Steinbloecke horizontal oben auf den stehenden, werfen seltsame Schatten"
   +" auf die Szenerie.  Vor Dir befindet sich ein steinerner Altar, seine"
   +" Oberflaeche ist mit merkwuerdigen Runen verziert und vom Wetter" 
   +" mitgenommen, abgeschliffen durch die Jahre wie die Stiegen vor einem" 
   +" vielbesuchten Gebaeude." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "steinbloecke", "monolithen" }),
    BS( "" ));
  AddDetail( ({ "altar" }),
    BS( "" ));
  AddDetail( ({ "oberflaeche" }), BS( "" ));
  AddDetail( ({ "glaette" }), BS( "" ));
  AddDetail( ({ "schatten" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "", "aus dem Kreis#" + ROOM( "" ) );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}

