// written by PtEPPiC 1995

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"
#define LITE_CHECK (set_light(0)<2)               
create()
{
   ::create();
   SetProp( P_INT_SHORT, "In der Eulenhoehle" );
   SetProp( P_INT_LONG,BS(
     "Von Sueden geht es Richtung Osten immer tiefer ins Innere der Hoehle, Du"
    +" kannst kaum noch etwas erkennen ohne Lichtquelle, das Tageslicht"
    +" wirf nur einen schwaechlichen Schein auf die Felswaende, hinter die"
    +" Biegung im Osten vermag es gar nicht mehr vorzudringen. Auf der feuchten"
    +" Wand direkt vor Dir siehst Du undeutlich eine Felszeichnung." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );

   AddDetail( ({ "waende","felswaende" }) , BS(
     "An der Nordwand dieses Ganges kannst Du etwas erkennen, das wie eine"
    +" primitive Hoehlenmalerei aussieht, vielleicht ist es auch nur ein"
    +" Schatten."
      )) ;
   AddDetail( ({ "insekten","" }) , BS(
     "Kleines, lichtscheues Getier, das sich an den feuchten Felswaenden"
    +" tummelt, die Dunkelheit der Schatten in den tiefen Ritzen suchend."
      ));
   AddDetail( ({ "ritzen","spalten" }) , BS(
     "Keine der Waende hier ist glatt, alle sind von schwarzen Ritzen und"
    +" Unebenheiten durchzogen, in denen Insekten herumkriechen, die den Eulen"
    +" als Futter dienen muessen." 
      ));
 /*  AddDetail( ({ "tropfstein", "stalaktit" }) , BS(""+"" ) );
   AddDetail( ({ "wasser","" }) , BS(""+"" ) );*/
   AddDetail( ({ "wand","felswand","nordwand" }) , BS(
     "Eine Zeichnung bedeckt die noerdliche Wand der Hoehle, ein Wunder,"
    +" das sie sich dort bei der hier herrschenden Feuchtigkeit halten kann."
      ));
   AddSpecialDetail( ({ "zeichnung","malerei","hoehlenmalerei" }), "Malerei" );
   AddDetail( "schatten", BS(
     "Ueberall werfen die Unebenheiten in den Waenden kleine, schwarze Schatten"
    +", aber das Dunkle an der Nordwand ist keiner, Du solltest Dir diese"
    +" Malerei vielleicht genauer ansehen."
      ));
   AddDetail( ({ "pfuetzen","lacken","wasserpfuetzen","wasserlacken" }) , BS(
     ""+"" ) );
   AddCmd( ({"lies", "lese" }), "inschrift" );
  /* AddSound( ({ "tropfen","tropfsteine","wasser"}), BS(
     "Leise aber unentwaegt hoerst Du die kleine Wassertropfen von den"
    +" Tropfsteinen in die Lacken auf dem Hoehlenboden fallen." 
      ));
   AddSound( ({ "flattern", "eulen" }), BS(
     "Eindeutig kannst Du das Flattern von Fluegeln vernehmen, wenn auch nur"
    +" leise, tiefer aus dem Inneren der Hoehle. Es werden wohl die Eulen sein,"
    +" denen der Ort hier seinen Namen verdankt. Von Zeit zu Zeit hoerst Du"
    +" leise Rufe, die Deiner Annahme rechtgeben."
      ));
   AddSound( ({ "rufe","heulen" }), BS(
     "Diese Gerauesche koennen einem ganz schoen Angst machen, aber was soll's,"
    +" sind doch schliesslich nur kleine Eulen."
      ));   
   AddSound( BS(
     "In der Hoehle ist es nicht so still, wie man meinen koennte, das"
    +" bestaendige Tropfen des Wassers und ein Gerauesch aus dem Hoehleninneren"
    +", das nach dem Flattern von Fluegeln klingt, sorgen fuer eine"
    +" beunruhigende Klangkulisse."
      ));  */
   AddExit( "sueden", ROOM("cave2.lpc") );
   AddExit( "osten", ROOM("cave4.lpc") );
}

string Malerei()
{
  return ( LITE_CHECK ?  "Du brauchst eine zusaetzliche Lichtquelle, um"
                        +" genaueres zu erkennen.\n" : 
     BS("Du erkennst, dass es sich nicht um eine Zeichnung handelt, sondern" 
       +" vielmehr um einen verschmierten, gekritzelten Schriftzug." )); 
}

int inschrift(string str)
{ 
  if ( str == "inschrift" || str =="schrift" || str =="schriftzug" )
    {
      write ( LITE_CHECK ?    "Du brauchst eine zusaetzliche Lichtquelle, um"
                             +" genaueres zu erkennen.\n" : 
                              "'Die Eulen sind nicht was sie scheinen.'\n" );
      return 1; 
    }
  return 0;
}
