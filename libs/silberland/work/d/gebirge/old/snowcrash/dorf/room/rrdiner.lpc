inherit "/std/pub";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

/*
 * Details (auch Essen und Drinks als Details)
 *
 */

create()
{
  replace_program( "std/pub" );
  ::create();

  SetProp( P_INT_SHORT, "In der Double-R-Diner Taverne" );
  SetProp( P_INT_LONG,BS(
    "Das Double-R-Diner ist eine kleine Taverne, die den mueden Wanderer"+
    "mit lokalen Spezialitaeten versorgt, einfachem aber gutem Essen,"+
    "und ausserdem ein gemuetliches wenn auch nicht gerade vornehmes Ambiente"+
    "bietet. Ein grosser Teil des Raumes wird von der Theke eingenommen,"+
    "seitlich stehen ein paar Tische mit karierten Decken und rustikalen,"+
    "bequem aussehenden Sitzbaenken. In der Ecke sitzt ein Musikant der "+
    "Wuensche der Gaeste erfuellt." ));
  AddDetail( ({ "tische", "tisch"}) , BS(
    "" ));
  AddDetail( ({ "", ""}) , BS(
  AddDetail( "boden", BS(""));
  AddDetail( ({ "wand","waende"}), BS(""));
  AddDetail( ({ "theke" }), BS(""));

  AddDetail( ({ "bank", "baenke"}) , BS(
  AddDetail( ({ "decken", "tischdecken" }) , BS(
  AddDetail( ({ "gaeste" }) , BS(

  AddDetail( ({ "donuts", "donut", "doughnuts", "doughnut" }), BS( "" ));
  AddDetail( ({ "cola", "coke" }), BS( "" ));
  AddDetail( ({ "kuchen", "kirschkuchen", "heidelbeerkuchen" }), BS( "" ));
  AddDetail( ({ "kaffee", BS( "" ));

//  AddSound( ({}), "" ); musik
//  AddSmell( ({}), "" ); kaffee und so

  AddExit( "", ROOM("") );

//*** Drinks ****//

  AddDrink("kaffee",({"kaffee"}),100,20,0,100,
    ({"Das ist der - entschuldigung - _verdammt_ beste Kaffee den Du je"
     +" getrunken hast.",
      "&& sagt zur Kellnerin, das er noch nie so einen guten Kaffee"
     +" getrunken hat"}));
  AddDrink("milch",({"milch"}),100,20,0,100,
    ({"Du trinkst ein grosses Glas Milch.",
     "&& schuettet sich irgendein weisses Zeug rein - muss ganz was hartes"
     +" sein"}));
  AddDrink("cola",({"cola"},{"coke"},{"pepsi"}),100,20,0,100,
    ({"So bist Du noch nie erfrischt worden - You can't beat the feeling.",
      "&& zieht sich eine Cola rein."}));

//*** Food ****//

  AddFood("kirschkuchen",
    ({ "kirschkuchen", "kirsch", "cherrypie" }),,,
    ({ "Der verdammt beste Kuchen, den du je gegessen hast.",
       "&& scheint vom Geschmack des Kirschkuchens ueberwaeltigt zu sein." }));
    ({ "Noch nie hast Du so etwas gutes gegessen, wie die Heidelbeeren auf der"
      +" Zunge zerrinnen",
       "&& murmelt etwas von Heidelbeerkuchen und Diane." }));
  AddFood("stachelbeerkuchen",
    ({ "stachelbeerkuchen", "stachelbeer" }),,,
    ({ "Der Kuchen zwingt Dich dazu, noch ein Stueck zu bestellen.",
       "&& kniet vor dem Stachelbeerkuchen nieder." }));
  AddFood("burger",
    ({ "burger", "hamburger" }),,,
    ({ "Du verschlingst einen Burger.",
       "&& schiebt sich einen Burger in den Mund." }));
  AddFood("eis",
    ({ "" }),,,
    ({ "Du loeffelst ein gemischtes Eis mit warmer Heidelbeersosse.",
       "&& verschlingt ein paar Kugeln Eis mit warmer Heidelbeersosse." }));
  AddFood( "Donuts", 
    ({ "donuts", "doughnuts" }),
    ({ "Du stopfst ein paar verschiedene Donuts in Dich rein, mit Zuckerguss, "+
       "Schokoladeglassur und ganz einfache.",
       "&& mapft ein paar Donuts." }));

//*** Waitresses ***//

  AddItem(MON("kellnerin"),REFRESH_DESTRUCT);
  if ( !random(2) ) AddItem(MON("kellnerin"),REFRESH_DESTRUCT);
  if ( !random(4) ) AddItem(MON("kellnerin"),REFRESH_DESTRUCT);

  AddItem(MON("jukebox"),REFRESH_DESTRUCT);
// Set Names, Ids, Shorts & kinda shit
}
