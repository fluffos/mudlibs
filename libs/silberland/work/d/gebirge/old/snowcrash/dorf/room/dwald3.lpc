inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "In den Waeldern der ewigen Dunkelheit" );
  SetProp( P_INT_LONG,BS(
    "Leise hoerst Du die Tannenbaeume sich im leichten, kuehlen durch die "+
    "Dunkelheit der Nacht bewegen. Zwischen den Wipfeln kannst Du zeiweise "+   
    "den bleichen, vollrn Mond erkennen. Der Weg macht hier eine scharfe "+
    "Kunrve von XXXXen nach XXXXen." ));  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  AddExit( "", ROOM("") );
  AddItem(MON(""),REFRESH_DESTRUCT);
}
