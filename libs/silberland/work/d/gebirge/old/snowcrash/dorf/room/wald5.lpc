inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Im Wald von " );
  SetProp( P_INT_LONG,BS(
    "Du wanderst entlang eines leise vor sich hin gurgelnden Baches, aus dem "+
    "die verschiedensten Pflanzen emporranken in die herbstlich neblige "+
    "Kuehle des Mischwaldes. Ab und zu bildest Du Dir ein, ein Geraeusch "+
    "gehoert zu haben, aber vielleicht war es nur der Hall deines eigenen "+
    "Stapfens durch das roetlich braune Laub, das ueberall den Boden bedeckt."
    ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

//   AddExit( "norden", ROOM( "bergX") );
//   AddExit( "sueden", ROOM( "gwald1") );

//  AddAction( ({"pluecke", "pflueck"}), #'pfluecken );

   AddDetail( ({ "nebel"}) , BS(
     "Er ist hier nicht besonders stark, du kannst vielleicht 50 Meter weit "+
     "sehen, wenn auch nicht besonders deutlich."
     )) ;
   AddDetail( ({"bach"}), BS( 
     "Der Bach fliesst in sanften Kurven von XXXXXX nach XXXXXX, manchmal "+
     "bilden sich kleine stufenfoermige Wasserfaelle in seinem verlauf, die "+
     "murmelnde Geraeusche erzeugen." ));
   AddDetail( ({"wasserfall", "wasserfaelle", "stufen", "treppen"}), BS( 
     "Die kleine Wasserfaelle wirken wie, Treppen im Bachbett. Das Wasser "+
     "schaeumt bei ihnen ein wenig auf und gibt ein leises Rauschen von sich."
     ));
   AddDetail( ({"wasser"}), BS( 
     "Das Wasser des Baches ist klar, du kannst bunte Steinchen in den "+
     "verschiedensten Farben auf seinem Grund erkennen, abgerundet durch den "+
     "fortwaehrenden Fluss des Wassers." ));
   AddDetail( ({"steine","steinchen"}), BS( 
     "Sie sind klein, abgerundet und liegen am Grund des Bachbettes. Ihre "+
     "Faerbungen rangieren von strahlendem Rot bis zu dunklem Gruen." ));
//   AddDetail( ({""}), BS( "" ));
   AddDetail( ({"pflanzen"}), BS( 
     "Farne und Graeser in den verschiedentsten Variationen wachsen aus dem "+
     "Bach und dem feuchten Boden entlang des Baches, manchmal bis auf den "+
     "Weg heraus, sodass sie Dir ein Hindernis beim Wandern sind." ));
   AddDetail( ({"farne","farn"}), BS( "" ));
   AddDetail( ({"graeser","gras"}), BS( "" ));
   AddDetail( ({"laub","blaetter"}), BS( 
     "Lautes Raschel begleitet Dich, als Du durch das rot bis braun durch den "+
     "Nebel leuchtende Laub stapfst, das hier zuweilen fast kniehoch liegt. "+
     "Weiter vor Dir faellt Dir eine kleine, fast unscheinbare Stelle auf, "+
     "an der im Nebel fast unscheinbarer Rauch aus dem Boden aufzusteigen "+
     "scheint." ));
   AddDetail( ({"stelle"}), BS( 
     "An der Stelle, von der der Rauch aus dem Boden aufsteigt, erkennst "+
     "Du ein kleine Oeffnung im Boden zwischen dem Laub, aus der der Qualm "+
     "entweicht." ));
   AddDetail( ({"loch", "oeffnung"}), BS( 
     "Du siehst, dass das kleine, etwa 20 Zentimeter breite Loch durch eine "+
     "felsige Bodenschicht weiter hinabfuehrt, kannst aber durch den Rauch "+
     "nichts weiter erkennen. Ob es sich hierbei um ein natuerliches "+
     "Phaenomen handelt?" ));
   AddDetail( ({"bodenschicht","felsschicht","fels"}), BS( 
     "Das Loch geht durch eine weissgraue Felsschicht." ));
   AddDetail( ({"rauch", "qualm"}), BS( 
     "Der Rauch steigt in Form einer duennen Saeule nach oben, er  "+
     "unterscheidet von der Faerbung her fast nicht vom Nebel, nur ein wenig "+
     "grauer ist er." ));
   AddDetail( ({"wald","mischwald"}), BS( "" ));
   AddDetail( ({"baeume"}), BS( 
     "Hauptsaechlich stehen hier hohe, knorrige Laubbaeume, du vermagst nicht "+
     "zu bestimmen welche, sie aehneln Kastanien, aber du hast noch nie "+
     "solche Gewaechse gesehen, dazwischen wachsen auch ab und zu ein paar "+
     "dunkle, dichte Tannenbaeume." ));
   AddDetail( ({"kronen","wipfel"}), BS( 
     "Hoch ueber dir siehst Du die breiten Kronen der Laubbaeume, die zwar "+
     "nur wenig Laub tragen aber dafuer etwas gelbliches, das aussieht wie "+
     "Fruechte, und die Wipfel der kerzengeraden, immergruenen Tannen." )); 
//   AddDetail( ({""}), BS( "" ));
   AddDetail( ({"laubbaeume"}), BS( 
     "Von der Blattform her erinnen sie an Kastanienbaeume, du merkst, dass "+
     "sie trotz ihres herbstlichen Zustands birnenfoermige Fruechte tragen."));
   AddDetail( ({"fruechte","birnen"}), BS(
     "Sie wachsen zahlreich auf den herbstlichen, fast blattlosen Baeumen, "+
     "ein seltsames Phaenomen." )); 
   AddDetail( ({"tannenbaeume", "nadelbaeume", "tannen"}), BS( 
     "Hohe Tannen, wie sie hier ueberall wachsen. In diesem Teil des Waldes "+
     "stehen sie nur vereinzelt zwischen den eindrucksvolleren Kronen der "+
     "maechtigen Laubbaeume." ));
   AddDetail( ({"weg"}), BS( 
     "Groesstenteils verdeckt zwar das Laub den Weg, aber Du kannst noch "+
     "erkennen, dass er in sanften Biegungen von XXXXXXX nach XXXXX fuehrt." ));
   AddDetail( ({"boden","waldboden"}), BS( 
     "Rotbraun leuchtendes Laub bedeckt den meisten Teil des Waldbodens." ));
   AddDetail( ({"himmel"}), BS( 
     "Durch den Nebel kannst Du nicht besonders viel von ihm erkennen, nur "+
     "ein blaeuliches Grau zwischen den Wipfeln und Kronen der hohe Baeume." ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

}

pfluecken( str )
{
int b;

  notify_fail( "Was willst Du pfluecken?\n" );
  if (! ( str=="birnen" || str=="birne" || str=="frucht" ||  str=="fruechte" ))
    return 0;
  say( TPN+ " pflueckt eine niedrighaengende Frucht von einem der Laubaueme.\n");
  write( BS(
    "Du pflueckst eine Frucht vom Baum und zuckst einwenig zusammen, als der "+
    "knorrige Baum leise zu aechzen scheint." ));
  clone_object( OBJ("birne"))->move( TP );
  if (b=birnen[TPN]) birnen[TPN]=++b else birnen[TPN]=1; 
  if (b>2) {
    write( BS(
    "Aechzenend bewegt sich der Ast des Baumes und trifft Dich mit einem "+
    "unerwarteten Schlag in die Magengegend." ));
    TP->do_damage( random( 20 )+10 );
    clone_object( MON("birnbaum"))->move( TO );
  }
}
