// MorgenGrauen MudLib
// /d/wald/pteppic/room/lichtung.c
// written by PtEPPiC 1995

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"
#include <moving.h>

int stuff;

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Am Rande einer Lichtung" );
   SetProp( P_INT_LONG,BS(
     "Du stehst am suedlichen Rand einer kleinen Lichtung mitten im Geisterwald"
    +", ein trostloser Fleck: das Gras ist verdorrt, ein Kreis verkuemmerter"
    +" Baeume steht um eine schwarze, spiegelnde Lacke im Zentrum der Lichtung."
    +" Ein aufdringlich oeliger Geruch steigt Dir in die Nase, als eine sanfte"
    +" Brise ueber den leicht sandigen Boden der Lichtung weht. Der Tod scheint"
    +" hier allgegenwaertig, Du kannst ausser dem leisen Wind nicht das"
    +" geringste Geraeusch vernehmen." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "lacke", "pfuetze" }), BS( 
     "Schwarz glitzert die Pfuetze im schwachen Licht des Mondscheins, die "+
     "Fluessigkeit duerfte Oel oder etwas aehnliches sein, wie dich auch der "+
     "aufdringliche Geuch vermuten laesst. Der Boden rings um die Lacke "+
     " scheint verkohlt zu sein." ));
   AddDetail( ({ "boden", "sandboden" }), BS(
     "Der Boden hier auf der Lichtung ist im vergleich zum Rest des Waldes "+
     "erstaunlich sandig, fast wie in einer Wueste oder am Strand eines "
     "Ozeans. Keine Pflanze waechst hier, nicht einmal der kleinste Grashalm, "+
     "abgesehen von den verdorrten Baeumen die einen Kreis um die Lacke "+
     "bilden." ));
   AddDetail( ({ "oel", "fluessigkeit" }), BS( 
     "Die Fluessigkeit spiegelt schwarz, ihre Oberflaeche wird vom leichten "+
     "Wind kaum bewegt und ist fast spiegelglatt." ));
   AddDetail( ({ "gras" }), BS( 
     "Am Rande der Lichtung waechst noch verdorrtes, braeunliches Gras, zur "+
     "Mitte hin verschwindet es immer mehr bis nur noch reiner Sand den Boden "+
     "bedeckt. Dort am Rand scheinst Du zwischen den verdorrten Halmen etwas "+
     "Weisses erkennen zu koennen." ));
   AddDetail( ({ "rand", "rande" }), BS( 
     "Die Lichtung scheint kreisrund zu sein und wirkt irgendwie nicht "+
     "natuerlich sondern kuenstlich geschaffen. Zu abrupt scheint der "+
     "Uebergang von den dichten Baeumen zum verdorrten Gras und sandigen"+
     "Boden." ));
   AddDetail( ({ "baeume" }), BS( 
     "Die Baeume, die in der Mitte der Lichtung einen exakten Kreis bilden "+
     "sind abgestorben und verdorrt, ein trauriger Anblick. Ausserdem "+
     "scheinen sie im Unterschied zu den hohen, beeindruckenden, dunklen "+
     "Tannen, die rund um die Lichtung gedeihen, Laubbaeume zu sein, Platanen "+
     "scheinbar." ));
   AddDetail( ({ "kreis" }), BS( 
     "Zwoelf tote Platanen, kein einziges Blatt mehr an den Zweigen, bilden "+
     "den exaten Kreis um die oelige Lacke, fast wie eine Art Zaun oder "
     "Schutzwall." ));
   AddDetail( ({ "tod" }), BS( 
     "Der Tod scheint hier allgegenwaertig zu sein.\n"+
     "Der Tod sagt: KOMM MIT MIR!\n"+
     "... nein, war nur ein Scherz, aber ein Gefuehl sagt Dir mit grosser "+
     "Gewissheit, dass es nicht mehr lange dauern kann." ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

//   AddSound( ({ "" }), BS( "" ));
//   AddSmell( ({ "" }), BS( "" ));

   AddSpecialExit( "sueden", "EnterLodge" );
   AddExit( "nordosten", ROOM("wwx") );
   AddExit( "suedwesten", ROOM("wwy") );

}
 
int EnterLodge()
{
  if ( TP != TI ) 
    {
      if ( TI )
        {
          tell_object( TI, 
            "Hier wird niemand gezwungen, liebe(r) Magier(in). :)" );
          return 1;
        }
      say( BS(
        TPN+" laeuft in die Mitte des Platanenkreises und"
       +" verschwindet einfach hinter einem ploetzlich erscheinenden roten"
       +" Vorhang der so wie er aufgetaucht ist, wieder desintegriert." ));
      write( BS(
        "Du laeufst, von der Angst getrieben, mit in den Kreis aus"
       +" Platanen, ploetzlich erscheint vor Dir ein dunkelroter Vorhang und"
       +" Du schiebst ihn zur Seite, trittst hindurch und befindest Dich"
       +" ploetzlich in einer anderen Welt." )); 
      TP->move( ROOM("black1"), M_TPORT | M_SILENT );
      return 1;
    }
  TP->move( ROOM("wwx"), M_GO );
  return 1; 
}
