inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG, BS( 
    "Du stehst mitten in einer schier endlosen Eiswueste, wehender Schnee "+
    "zeichnet schematisch die Konturen des Sturms in die Dich umgebende "+
    "Schwaerze. Der Boden ist eben und weiss, obwohl er sich schon nach "+
    "ein paar Metern in der Dunkelheit verliert. Du fragst Dich, woher "+
    "das wenige Licht stammt, das Dich umgibt." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_TRANSPARENT, 1 );
  AddDetail( ({"dunkelheit"}), BS( "" ));
  AddDetail( ({"kaelte"}), BS( "" ));
  AddDetail( ({"eis"}), BS( "" ));
  AddDetail( ({"eiswueste"}), BS( "" ));
  AddDetail( ({"schnee"}), BS( "" );
  AddDetail( ({"wind","sturm","konturen"}), BS( "" );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
//  AddSound( ({"schnee"}), BS( "" ));
//  AddSmell( ({"boden"}), BS( "" ));
  
  AddExit( "", ROOM("") );
}
