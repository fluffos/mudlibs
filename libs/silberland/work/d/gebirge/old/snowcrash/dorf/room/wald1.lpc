inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Am Fusse des Berges __HUHU__" );
   SetProp( P_INT_LONG,break_string(
     "Dichte Nebelschwaden streifen ueber die mit dunkeln, maechtigen "+
     "Tannenbaeumen bewachsenen, steilen Berghaenge. Eine angenehm kuehle "+
     "Brise weht Dir durchs Haar, Du riechst den frischen Duft des Waldes. "+
     "Durch den Hochnebel kannst Du kaum die Sonne erkennen, der Himmel "+
     "scheint in ein einheitliches Grau getaucht zu sein. Du kannst "+
     "Richtung Sueden den Berg nach oben gehen, oder nach Norden jenem "+
     "schmalen, unscheinbaren Pfad, der sich zwischen den Baeumen "+
     "hindurchschlaengelt, weiter ins Tal folgen."
     ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );

   AddExit( "norden", ROOM( "bergX") );
   AddExit( "sueden", ROOM( "gwald1") );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddItem(MON(""),REFRESH_DESTRUCT);
}

