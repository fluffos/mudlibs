create()
{
  ::create();
  SetProp( P_INT_SHORT, "????????" );
  SetProp( P_INT_LONG, BS(
    "Du wanderst ein nach Osten leicht ansteigendes Stueck durch den hier "+
    "ziemlich lichten Wald. Leichter Wind bewegt die Aeste der dunklen "+
    "Nadelbaeume. Der Himmel ueber Dir hat eine vom zarten Orange ueber "+
    "violett bis ins blasse Blau uebergehende Faerbung, nur manchmal schaut "+
    "die recht tiefstehende Sonne zwischen den sie verdeckenden Wolken hervor "+
    "und laesst Dich ihre Waerme in Deinem Gesicht spueren.\n"+ 
    "Der Weg beschreibt hier eine sanfte Biegung nach Suedosten hin." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

//  AddExit( "norden", ROOM( "bergX") );
//  AddExit( "sueden", ROOM( "gwald1") );

  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  AddItem(MON(""),REFRESH_DESTRUCT);
}

