#inherit "std/room";
include <propeties.h>
include <language.h>
include "./files.h"

// TODO:
// SpecialDetails fuer Spinnennetze machen!
// Hinweis auf verbrennen einbauen!
// Silvana fragen ob ich die Hand einbaun kann!
// wenn ja eine nimm funktion schreiben - bei verbrennung hand mit zerstoeren

int netz;

create()
{
  ::create();

  SetProp(P_INT_LONG, BS(
    "Vor Dir tut sich eine dunkle Oeffnung mit etwa zwei Meter Durchmesser "+
    "in der Felswand auf, wie ein gewaltiger Schlund, der Dich zu "+
    "verschlingen droht. Grosse Spinnweben versperren Dir regelrecht den Weg "+
    "ins Innere der Hoehle. Die felsigen Waende sind von dunkelgruenem Moos "+
    "bewachsen, Schlingpflanzen haengen ueber dem Eingang herab, an denen "+
    "Wasser entlang fliesst und langsam zu Boden tropft." ));
  SetProp(P_INT_SHORT, "Der Eingang zur Eulenhoehle" );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

//  AddExit( "norden", ROOM( "cave2.lpc" ) );
  AddExit( "sueden", ROOM( "waldXXX.lpc" ) );
 
  AddCmd( ({ "zerstoere", "entferne" }), "destroy_web" );
  AddCmd( ({ "verbrenne" }), "burn_web" );
  
  netz = 1;

  AddDetail( ({ "oeffnung", "eingang", "hoehleneingang" }), BS( 
    "Der Eingang fuehr Dich hinein ins Dunkle der Hoehle, er ist uebersaet "+
    "von Moosen, Flechten, herabhaengenden Pflanzen, wie Farnen und Efeu, "+
    "und einigen grossen Spinnweben. Nur an wenigen Stellen schimmert noch der"+
    "blanke Fels durch." ));
  AddDetail( ({ "pflanzen","schlingpflanzen" }), BS( 
    "Gruene Faeden scheinen sich vom Eingang herab in Richtung boden zu "+ 
    "lassen, an ihnen entlang fliessen ein paar Wassertropfen herab, die "+
    "stetig, aber geraeuschlos auf den weichen Boden fallen." ));
  AddDetail( ({ "wasser", "tropfen" }), BS(
    "An den feuchten Pflanzen die ueber dem Eingang an der Felswand "+
    "herabhaengen laeuft Wasser herab das an den Spitzen der Pflanzen Tropfen "+
    "bildet und dann zu Boden tropft." ));
  AddDetail( ({ "moos" }), BS(
    "Du spuerst wie das weiche Moos den Boden unter Dir polstert, saftig "+
    "gruen bedeckt es die unteren Teil der Felswand hier am Hoehleneingang." ));
  AddDetail( ({ "efeu" }), BS( 
    "Er bedeckt mit seinen dunkelgruenen Blaettern grosse Teile des "+
    "Hoehleneingangs." ));
  AddDetail( ({ "farne", "farn" }), BS( 
    "Ein paar dieser aeussert zarten Pflanzen mit ihren feinen Blattstrukturen"+
    "wachsen hier am Boden rund um den Eingang zur Eulenhoehle." ));
  AddDetail( ({ "flechten" }), BS(
    "Gruengelblich bis rotbraun bedecken sie die Felswaende. Ein paar kleine "+
    "Insekten kriechen auf ihnen herum." );
  AddDetail( ({ "insekten" }), BS( 
    "Winzig kleine schwarze Kaefer bevoelkern die Moose und Flechten hier an "+
    "der Felswand, sie scheinen die Waerme, die der Stein speichert zu moegen "+
    "und sich hier aeusserst wohl zu fuehlen." ));
  AddSpecialDetail( ({ "spinnennetz", "spinnweben" }), "web" ); 
  AddDetail( ({ "spinnen", "spinne" }), BS( 
    "Die Spinnen sind nicht besonders beeindruckend, ganz klein und "+
    "pechschwarz. Du bemerkst, dass sie einige Kokons gesponnen haben, in "+
    "denen sich wohl ihre Beute befindet." ));
  AddDetail( ({ "kokons" }), BS(
    "Angesichts der Winzigkeit der Spinne sind die Kokons von unglaublicher "+
    "Groesse, manchenm waeren gross genug um ein kleines Nagetier oder "+
    "aehnliches zu beinhalten. Eines der Kokons schein leicht geoeffnet zu "+
    "sein, sodass Du vielleicht hineinsehen koenntest." ));
  AddDetail( ({ "kokon" }), BS(
    "Vorsichtig schiebst Du mit den Fingern den Riss im Kokon weiter aus "+
    "einander und spaehst hinein - Du kannst kaum glauben, was Du darin "+
    "erkennen kannst - es ist tatsaechlich eine abgetrennte menschliche Hand. "+
    "Du fragst Dich wie diese kleine Spinnen das geschafft haben - Du "+
    "jedenfalls bist ihnen gegenueber jetzt umso vorsichtiger." ));

//  AddSmell();
//  AddSound();
}

int destroy_web( str ) 
{
int i;

  if ( !netz ) return 0;

  if ( str == "spinnenetz" || str == "netz" || str == "spinnenweben" || str ==
       "weben" ) 
    {
      netz = 0; 
      seteuid(getuid( TO ));
      i=random(6)+3;
      write( BS(
        "Kleine Spinnen fallen aus den Netzen auf Dich herab und beginnen "+
        "sofort Dich zu attackieren, da Du ihren Lebensraum zerstoert hast." ));
      say( BS( 
        TPN +" entfernt die Netze vor dem Hoehleneingang und wird dafuer von "+
        "winzigen Spinnen angefallen, die ueberall auf ihm herumkrabblen."),TP);
      while ( i-- ) clone_object(OBJ( "spider" ))->move( TO ); 
      return 1;
    }   
  notify_fail( "WAS willst Du zerstoeren?" );   
}        

int burn_web( str )
{
  netz=0;
  notify_fail( "SYNTAX: verbrenne WAS\n" );
  if (!( str== "netz" || str=="spinnennetz" || str=="weben" ||
     str=="spinnenweben" ) return 0;
  say( BS( 
    TPN + "zuendet die Spinnennetze vor dem Eingang an und sie fallen "+
    "in Sekundenschnelle dem Feuer zum Opfer." ), TP );
  write( BS(
    "Die Spinnennetze gehen in Flammen auf und der Eingang in die Hoehle "+
    "ist frei." ));
}

web()
{
  if ( netz ) return BS(
    "Grosse Spinnweben verhaengen fast den gesamten Eingang zur Hoehle, ein "+
    "paar kleine Spinnen haengen bewegungslos in den Netzen und harren ihrer "+ 
    "Beute, die wohl aus kleinen Insekten bestehen duerfte." );
  return BS(
    "Fetzen von Spinnweben haengen neben dem Eingang zur Eulenhoehle an den "+
    "Waenden herab, jemand hat die Netze wohl vernichtet. Ein paar kleine "+
    "Spinnen krabbel noch in den Weben herum." );
}

reset()
{
  netz = 1;
  ::reset();
}
