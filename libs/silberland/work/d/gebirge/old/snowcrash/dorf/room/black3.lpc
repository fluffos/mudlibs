inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "" );
   SetProp( P_INT_LONG,BS(
      "Du bist umgeben von Feuersbruensten, geraeuschvollen Explosionen,"
     +" Flammen die Dich verschlingen wollen, zuengelnd nach Dir draengen."
     +" Hitze verbrennt Deine Haut versengt Dir die Haare und Augenbrauen,"
     +" alles wirkt so unnatuerlich - wie eine Illusion." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );

   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
//   AddItem(MON(""),REFRESH_DESTRUCT);
}
