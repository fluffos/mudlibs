inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Auf einem schneebedeckten Gipfel" );
   SetProp( P_INT_LONG,BS(
     "Du hast den hoechsten Punkt des Berges erreicht, stellenweise scheint"
    +" der graue Fels durch die von der Sonne geschmolzene Schneedecke. Ein"
    +" kuehler Wind aus dem Norden blaest Dir durchs Haar, als Du hinab schaust"
    +" ins groestenteils durch den Hochnebel verdeckte Tal. Im Norden kannst Du"
    +" die dunklen Waelder und das ewige Eis der Polarregion erkennen, in allen"
    +" anderen Richtungen umgibt Dich der Wald." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

/*   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
*/
   AddExit( ({"sueden","unten"}), ROOM("berg2") );
}
