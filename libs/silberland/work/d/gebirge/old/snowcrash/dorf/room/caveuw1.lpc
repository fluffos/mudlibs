inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Unten im See" );
   SetProp( P_INT_LONG,BS(
     "Du tauchst im eiskaltem Wasser des Sees in der Eulenhoehle, von oben "+
     "scheint noch etwas Licht herab, das von den leichten Wellen des Wassers "+
     "gebrochen wird und taenzelnde Schattenspiele hier unter erzeugt. Den "+
     "Grund des Sees kannst Du noch nicht erkennen, in alle Richtungen, "+
     "abgesehen von oben, gaehnt endlose Schwaerze. Es froestelt Dich, Dir "+
     "waer lieber Du wuerdest schleunigst hier rauskommen." ));

   SetProp( P_LIGHT, 0 );
   SetProp( P_INDOORS, 1 );

//   AddExit( "", ROOM("") );

   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
   AddDetail( ({ "", "" }), BS( "" ));
//   AddSound( ({ "", "" }), BS( "" ));
//   AddSmell( ({ "", "" }), BS( "" ));
}
