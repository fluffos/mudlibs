inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "In den Waeldern der ewigen Dunkelheit" );
  SetProp( P_INT_LONG,BS(
    "Gerade eben war es noch hell, doch hier herrscht dunkle Nacht, allein "+
    "der volle Mond strahlt blasses Licht aus, das aber nur selten vermag, "+
    "durch die dicht beieinander wachsenden Tannen zu dringen. Unheimliche "+
    "Geraeusche, wahrscheinlich nur Eulen, durchzucken die Dunkelheit und "+
    "machen Dir Angst, die Du versuchst von Dir zu weisen." ));      
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 0 );

  AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  AddExit( "", ROOM("") );
  AddItem(MON(""),REFRESH_DESTRUCT);
}
