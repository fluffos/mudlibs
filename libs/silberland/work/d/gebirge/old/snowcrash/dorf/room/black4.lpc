inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,BS(
    "Jeglicher Begriff von Raum ist verschwunden, Dunkelheit umringt Dich von "+
    "allen Seiten, doch direkt vor Dir leuchtet ein Wuerfel, in dem sich "+
    "blau-weisslich leuchtetende Strukturen bewegen, fast wie Wellen in einer "+
    "Fluessigkeit oder Wolken am Firmament. Das Licht, das dieser Kubus "+
    "ausstrahlt, blendet Deine Augen, laesst die unendliche Dunkelheit noch "+
    "schwaerzer erscheinen." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  
  AddSound( ({""}), BS( "" ));
  AddSmell( ({""}), BS( "" ));

  AddExit( "", ROOM("") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}
