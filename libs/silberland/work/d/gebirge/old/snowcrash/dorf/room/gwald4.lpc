inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

// TODO : S bei nach sueden gehen notwendig??

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer kleinen Huette im Geisterwald" );
  SetProp( P_INT_LONG,BS( 
    "Du stehst vor einem kleine Haeuschen, einer alten Holzhuette, die "+
    "nicht besonders gut erhalten ist. Das schwarze Holz ist ziemlich "+
    "vernachlaessigt worden, stellenweise von Moos uebezogen und vermodert."+
    "Die Fenster sind zugenagelt und die Tuer ist verschlossen. Aber aus "+
    "dem Schornstein scheint etwas Rauch zu kommen, oder ist das nur Nebel?"+
    "Du fragst Dich jedenfalls, warum der Nebel hier nicht so dicht ist wie "+
    "im Rest des Waldes." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "haus", "huette", "haeuschen", "holzhuette" }), BS( "" ));
  AddDetail( ({ "nebel" }), BS( "" ));
  AddDetail( ({ "rauch" }), BS( "" ));
  AddDetail( ({ "schornstein" }), BS( "" ));
  AddDetail( ({ "fenster" }), BS( "" ));
  AddDetail( ({ "tuer" }), BS( "" ));
  AddDetail( ({ "moos" }), BS( "" ));
  AddDetail( ({ "moder" }), BS( "" ));
  AddDetail( ({ "holz" }), BS( "" ));
  AddDetail( ({ "boden" }), BS( "" ));
  AddDetail( ({ "himmel" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "nordwesten", "#" + ROOM("gwald5") );
  AddExit( "sueden", "#" + ROOM("gwald3") );
//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}
