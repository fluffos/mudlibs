// MorgenGrauen-MudLib
//
// written by PtEPPiC 1995

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
   replace_program("/std/room");
   ::create();

   SetProp( P_INT_SHORT, "Ganz oben auf dem Gipfel" );
   SetProp( P_INT_LONG,BS(
      "Der kuehle Wind ist auf so einem exponierten Platz wie diesem Gipfel"
     +" besonders stark zu spueren, Du siehst zu wie er die Wolken mit hoher"
     +" Geschwindigkeit vor der Sonne vorbeitreibt, wodurch sich dauernd die"
     +" Lichtverhaltnisse aendern.\n"
     +"Unter Dir erstreckt sich das Tal, doch dichter Hochnebel entzieht es"
     +" fast gaenzlich Deinen Blicken, Du kannst gerade noch die Baumgrenze"
     +" ausmachen, undeutlich siehst Du auch die Lichter des Dorfes durch"
     +" die milchig weisse Suppe leuchten."  ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "nebel", "hochnebel", "nebelsuppe", "nebel" }) , BS(
      "Dichte Nebelschwaden huellen die tiefer gelegene Umgebung in"
     +" undurchsichtiges Weiss und Grau, als haette man eine Decke ueber"
     +" das ganze Tal gelegt." ));
   AddDetail( ({"nebelschwaden","nebelfetzen"}), BS( 
      "Sieh ziehen, vom Wind angetrieben, vor Deinem Auge vorbei, manchmal"
     +" kannst Du zwischen den Nebelfetzen Details des Tals erkennen." ));
   AddDetail( ({"dorf"}), BS(
      "Du siehst ein paar Lichter von den Haeuser im Dorf durch die Nebeldecke"
     +" leuchten, doch Du kannst nichts konkretes erkennen." ));
   AddDetail( ({"lichter"}), BS( 
      "Schwach nur scheinen sie durch den Nebel, gelb und warm, erzeugen sie"
     +" in dir ein Gefuehl der Sehnuscht nach Geborgenheit." ));
   AddDetail( ({"lichtverhaeltnisse"}), BS( 
      "Es wird immer nur kurz hell, als die Wolken das Licht der Sonne"
     +" ungehindert durchdringen lassen, dann trueben die vom Wind"
     +" vorangetriebenen Wolken wieder die Helligkeit." ));
   AddDetail( ({"himmel"}), BS( 
      "Der Himmel ist von einem hellen Blau-Grau, Wolken werden mit enormer"
     +" Geschwindigkeit ueber ihn hinweggeweht." ));
   AddDetail( ({"sonne"}), BS( 
      "Die Kraft der Sonne ist durch die Wolken geschwaecht, doch trotz der"
     +" kuehlen Brise kann man nicht wirklich behaupten, dass es kalt ist." ));
   AddDetail( ({"wind","brise"}), BS(
      "Der Wind faehrt Dir angenehm kuehl durchs Haar, hetzt graue Wolken ueber"
     +" den Himmel und bewegt sanft die Wipfel der hohen dunklen Tannnen unter"
     +" Dir." ));
   AddDetail( ({"baumgrenze"}), BS( 
      "Sie liegt ein ganzes Stueck unter Deinem Standpunkt: abrupt endet"
     +" der oede, von Moosen und Flechten bedeckte, Teil des Berges und geht"
     +" in einen dichten Nadelwald aus dunklen Tannen ueber."  ));
   AddDetail( ({"tannenbaeume","baum","baeume","tannen","tanne"}), BS(
      "Hochgewachsene, alte Baeume, der Wind weht Dir den frischen Duft dieser"
     +" Douglas-Tannen entgegen." ));
   AddDetail( ({"wald"}),BS(
      "Unterhalb der Baumgrenze stehen die Tannenbaeume dicht aneinander,"
     +" ein reiner Nadelwald." ));
   AddDetail( ({"flechten"}),BS( 
      "In verschiedensten Farbtoenen, von leuchtendem Gruen bis zu feurig"
     +" rotem Braun, ueberziehen sie den felsigen Boden und einzelne grosse"
     +" Steinbloecke." ));
   AddDetail( ({"moose","moos"}),BS( 
      "Dunkelgruenes Moos bedeckt stellenweise den Boden." ));
   AddDetail( ({""}),BS( "" ));
//  AddSmell( wind - tannen -
//  AddSound( rauschen des windes

   AddExit( "unten", ROOM("berga10.lpc") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}
