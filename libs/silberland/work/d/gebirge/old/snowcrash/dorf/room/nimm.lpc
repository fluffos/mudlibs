inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG, BS( 
    ""
    ""
    ""
    ""
    "" )); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
//  AddSound( ({""}), BS( "" ));
//  AddSmell( ({""}), BS( "" ));

  
  AddExit( "", ROOM("") );
}

start_nimm() {
  write(
  "Krnok sagt: \"Wenn Du hier durchwillst, musst Du erst einmal ein kleines "+
  "Spiel gegen mich gewinnen.\n\" Dann grinst er haemisch und nimmt aus "+
  "einer Tasche seines Leinengewandes einen ledernen Becher, den er oeffnet "+
  "und dessen Inhalt er ueber den Tisch verstreut. " ); 
}        

frage() {
  "Krnok antwortet: "Sag einfach aus welcher Reihe Du welches oder welche "+
  "Staebchen nehmen willst. Zum Bleistift: 'Reihe 3 Staebchen 1 2' oder kurz "+
  "'3 1 2' fuer das erste und zweite Staebchen aus der Reihe drei."
 
  "Krn'ok fragt: Soll ich mit dem Spiel beginnen?\n" 
  "Krn'ok kichert ein wenig.\n" 
  
  "Krn'ok bemerkt: Wieder verloren. Hehe."
  "Krn'ok lacht lauthals."
  "Krn'ok sagt: Deine Wahl... "
  "Krn'ok grinst wie ein Totenschaedel."
  "Krn'ok sagt: Der Steinscheisser Karl!" 
}

varargs nimm(int row, int stabi, int stabii) { 

  if (!stabi) return 0;
  if (stabi-stabii!=1) return 0;       

  stabis[row][stabi];  

}
