inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "" );
   SetProp( P_INT_LONG,BS(
      "Der duestere Gang, indem Du Dich befindest, ist rundum von"
     +" dunkelroten Samtvorhaengen umgeben und bis auf eine antike, weisse"
     +" Statue, die Darstellung einer unbekleideten Frau, voellig leer."
     +" Der Fussboden ist schwarz-weiss gemustert, stroboskopartige"
     +" Lichtblitze durchzucken gespenstisch die Dunkelheit des Raumes."
     +" - Du bist von einer Atmosphaere des Boesen umgeben - " ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON(""),REFRESH_DESTRUCT);
}

