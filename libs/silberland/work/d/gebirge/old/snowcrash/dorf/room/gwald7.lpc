inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Geisterwald" );
  SetProp( P_INT_LONG,BS( 
    "Du tappst weiterhin durch den Nebel, unbeholfen wie in stockdunkler "+
    "Nacht. Ein zunehmend lauteres Rauschen scheint genau aus dem Norden "+
    "zu kommen, sehen kannst Du die Quelle des Geraeusches aber nicht.\n"+
    "Der Boden unter Deinen Fuessen wird zunehmend schlammiger, beim Gehen "+
    "begleiten Dich die schmatzende Geraeusche des Morasts." ));
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );
 
  AddExit( "norden", ROOM("gwald8") );

  AddDetail( ({ "nebel" }), BS( "" ));
  AddDetail( ({ "moos" }), BS( "" ));
  AddDetail( ({ "boden" }), BS( "" ));
  AddDetail( ({ "himmel" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "tannen" }), BS( "" ));
  AddDetail( ({ "baeume" }), BS( "" ));
  AddDetail( ({ "silhouetten" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}
